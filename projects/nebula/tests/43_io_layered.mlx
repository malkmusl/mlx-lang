// nebula's layered file formats (io/kra.mlx, io/ora.mlx, io/psd.mlx) and
// GIF, TIFF and LZF (io/gif.mlx, io/tiff.mlx, io/lzf.mlx), and their rows
// in io/formats.mlx. A document of a pass-through group, three paint
// layers (one moved to negative places across tile borders, one half
// transparent at 50% in Multiply with its alpha locked, one hidden and
// locked), a transparency mask, a filter layer (invert, with a mask), a
// fill layer and a clone, saved as KRA and read back: the same tree
// (kinds, names, flags, opacity, modes, places, the filter's and the
// fill's numbers, what the clone shows) and the same pixels in every
// device bit for bit, the same composite. LZF: random and repetitive
// data round trip, a hand-made stream with overlapping references read
// as it says, references before the start, streams cut short and output
// too small refused. ORA: the same document round trip with the same
// composite and the lossy flag set (and not for a document of paint
// layers and groups only, which comes back whole); a stack.xml written
// here (svg: modes, a hidden stack, a nested pass-through one, a layer
// outside the canvas, one whose picture is missing, an element not known)
// read as it says. PSD: a document of groups (pass-through and not),
// modes PSD has, a clipped and alpha-locked layer, a hidden one, a name
// outside ASCII, round trip; its merged image read alone; a PSD of one
// PackBits layer made by hand. GIF: four colours exact, a gradient within
// the dithering's error, transparency kept, an interlaced GIF made by
// hand, two frames as two layers. TIFF: every compression in both byte
// orders, strips and tiles, with and without predictor, exact; a grey
// TIFF made by hand. Every reader with 1000 random byte flips and every
// truncation of a small file (the entries of the archives too) never
// traps and gives the same answer whatever lies behind its bytes; the
// fuzzing takes nothing of the value arena; formats.load() tells each
// format by its content and formats.save() writes each; the heap is where
// it was after each image is destroyed. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const random = @import("std.random")
const turns = @import("std.turns")
const zip = @import("../io/zip.mlx")
const png = @import("../io/png.mlx")
const text = @import("../io/text.mlx")
const lzf = @import("../io/lzf.mlx")
const ora = @import("../io/ora.mlx")
const kra = @import("../io/kra.mlx")
const psd = @import("../io/psd.mlx")
const gif = @import("../io/gif.mlx")
const tiff = @import("../io/tiff.mlx")
const formats = @import("../io/formats.mlx")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const node = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")
const blend = @import("../core/blend.mlx")
const filters = @import("../filters/registry.mlx")
const generators = @import("../generators/registry.mlx")
const scratch = @import("../core/scratch.mlx")

const Bytes = std.ArrayList(u8)
const Allocator = std.allocator.Allocator
const Image = image_module.Image
const Node = node.Node

const FOLDER = "nebula_test_43"

// ---------------------------------------------------------------------------
// Documents

fn writePattern(layer: *Node, area: geom.Rect, seed: u32) -> void {
    var y = area.y
    while y < geom.bottom(area) {
        var x = area.x
        while x < geom.right(area) {
            const u = @bitCast(u32, x) *% 7 +% seed
            const v = @bitCast(u32, y) *% 5 +% seed
            var a: u32 = 255
            // Alpha at its edges and between, colour kept under it.
            if (u +% v) % 11 == 0 { a = 1 } else if (u +% v) % 13 == 0 { a = 254 } else if (u +% v) % 17 == 0 { a = 128 }
            device.setPixel(layer.*.device.?, x, y, pixel.pack(a, u & 255, v & 255, (u ^ v) & 255))
            x += 1
        }
        y += 1
    }
}

fn fillRect(layer: *Node, area: geom.Rect, value: u32) -> void {
    _ = device.fill(layer.*.device.?, area, value)
}

fn addNode(image: *Image, kind: u8, name: []const u8, parent: *Node) -> *Node {
    const made = node.create(image.*.allocator, kind, image_module.newId(image), name).?
    _ = ops.add(image, made, parent, node.childCount(parent), "Add")
    return made
}

// The document of the header: `big` makes the layers' pictures larger
// (the round trips), small for the fuzzing.
fn makeDocument(allocator: Allocator, big: bool) -> *Image {
    const width: i32 = if big { 200 } else { 24 }
    const height: i32 = if big { 150 } else { 20 }
    const image = image_module.create(allocator, width, height, 300.0).?
    const root = image.*.root
    const background = addNode(image, node.PAINT, "Background", root)
    var y: i32 = 0
    while y < height {
        var x: i32 = 0
        while x < width {
            device.setPixel(background.*.device.?, x, y, pixel.rgb(@intCast(u32, x & 255), @intCast(u32, y & 255), @intCast(u32, (x + y) & 255)))
            x += 1
        }
        y += 1
    }
    const group = addNode(image, node.GROUP, "Group", root)
    group.*.passThrough = true
    group.*.collapsed = true
    group.*.label = 3
    const moved = addNode(image, node.PAINT, "Moved \u{E4}\u{20AC}", group)
    device.moveTo(moved.*.device.?, -37, -21)
    writePattern(moved, if big { geom.rect(-30, -15, 130, 90) } else { geom.rect(-5, -4, 12, 10) }, 3)
    const transparency = addNode(image, node.TRANSPARENCY_MASK, "Transparency Mask", moved)
    device.moveTo(transparency.*.device.?, 3, -2)
    var my: i32 = -10
    while my < (if big { 60 } else { 8 }) {
        var mx: i32 = -20
        while mx < (if big { 70 } else { 10 }) {
            device.setPixel(transparency.*.device.?, mx, my, pixel.gray(@bitCast(u32, mx * 3 + my) & 255))
            mx += 1
        }
        my += 1
    }
    const half = addNode(image, node.PAINT, "Half", group)
    fillRect(half, if big { geom.rect(40, 30, 100, 70) } else { geom.rect(4, 3, 10, 9) }, 0x80FF8040)
    half.*.opacity = 128
    half.*.blend = blend.MULTIPLY
    half.*.alphaLocked = true
    const hidden = addNode(image, node.PAINT, "Hidden", group)
    fillRect(hidden, geom.rect(10, 10, 20, 20), 0xFF00FF00)
    hidden.*.visible = false
    hidden.*.locked = true
    const invert = addNode(image, node.FILTER, "Invert", root)
    filters.defaults(filters.INVERT, &invert.*.params)
    _ = device.fill(invert.*.device.?, geom.rect(0, 0, if big { 50 } else { 6 }, if big { 40 } else { 5 }), pixel.gray(90))
    const fill = addNode(image, node.FILL, "Fill", root)
    generators.defaults(generators.COLOR, &fill.*.params)
    fill.*.params.values[0] = 10.0
    fill.*.params.values[1] = 200.0
    fill.*.params.values[2] = 30.0
    fill.*.params.values[3] = 255.0
    fill.*.opacity = 100
    fill.*.blend = blend.SCREEN
    const clone = addNode(image, node.CLONE, "Clone", root)
    clone.*.cloneOf = half.*.id
    device.moveTo(clone.*.device.?, 5, 7)
    clone.*.opacity = 200
    clone.*.label = 5
    image.*.active = half
    history.clear(image.*.history)
    // (The pixels were written straight into the devices.)
    image_module.damageAll(image)
    return image
}

// A document of paint layers and groups only, with modes PSD has, a
// clipped layer and a name outside ASCII (PSD and ORA keep it whole).
fn makePlain(allocator: Allocator) -> *Image {
    const image = image_module.create(allocator, 90, 70, 150.0).?
    const root = image.*.root
    const background = addNode(image, node.PAINT, "Background", root)
    fillRect(background, geom.rect(0, 0, 90, 70), 0xFF336699)
    const through = addNode(image, node.GROUP, "Through", root)
    through.*.passThrough = true
    const multiply = addNode(image, node.PAINT, "Multiply", through)
    writePattern(multiply, geom.rect(-20, -10, 80, 70), 9)
    multiply.*.opacity = 128
    multiply.*.blend = blend.MULTIPLY
    const quiet = addNode(image, node.PAINT, "Quiet", through)
    fillRect(quiet, geom.rect(70, 50, 40, 40), 0xC0102030)
    quiet.*.visible = false
    const isolated = addNode(image, node.GROUP, "Ebene \u{E4}\u{20AC}\u{1F600}", root)
    isolated.*.blend = blend.SCREEN
    isolated.*.opacity = 200
    isolated.*.collapsed = true
    const base = addNode(image, node.PAINT, "Base", isolated)
    fillRect(base, geom.rect(30, 20, 40, 30), 0xFFFFFFFF)
    const clipped = addNode(image, node.PAINT, "Clipped", isolated)
    writePattern(clipped, geom.rect(25, 15, 60, 50), 21)
    clipped.*.inheritAlpha = true
    clipped.*.alphaLocked = true
    const empty = addNode(image, node.PAINT, "Empty", root)
    empty.*.blend = blend.DIFFERENCE
    image.*.active = base
    history.clear(image.*.history)
    image_module.damageAll(image)
    return image
}

// ---------------------------------------------------------------------------
// Comparing

fn samePixels(a: *device.Device, b: *device.Device) -> bool {
    if a.*.defaultPixel != b.*.defaultPixel { return false }
    const area = geom.unite(device.extent(a), device.extent(b))
    var y = area.y
    while y < geom.bottom(area) {
        var x = area.x
        while x < geom.right(area) {
            if device.pixel(a, x, y) != device.pixel(b, x, y) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// Whether the canvases show the same.
fn sameComposite(a: *Image, b: *Image) -> bool {
    if a.*.width != b.*.width || a.*.height != b.*.height { return false }
    image_module.damageAll(a)
    image_module.damageAll(b)
    _ = render.update(a)
    _ = render.update(b)
    var y: i32 = 0
    while y < a.*.height {
        var x: i32 = 0
        while x < a.*.width {
            if device.pixel(a.*.projection, x, y) != device.pixel(b.*.projection, x, y) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

fn sameParams(a: *const node.Params, b: *const node.Params) -> bool {
    if a.*.id != b.*.id || !std.text.same(node.paramsText(a), node.paramsText(b)) { return false }
    var index: usize = 0
    while index < node.VALUES {
        if a.*.values[index] != b.*.values[index] { return false }
        index += 1
    }
    return true
}

// The first way two trees differ (0: none): 1 kind, 2 name, 3 flags, 4
// opacity, 5 mode, 6 numbers, 7 a device on one only, 8 a device's
// place (`places`), 9 pixels, 10 children, 11 what a clone shows.
fn treeDifference(a: *Node, b: *Node, ia: *Image, ib: *Image, places: bool) -> u8 {
    if a.*.kind != b.*.kind { return 1 }
    if !std.text.same(node.nameOf(a), node.nameOf(b)) { return 2 }
    if a.*.visible != b.*.visible || a.*.locked != b.*.locked || a.*.alphaLocked != b.*.alphaLocked || a.*.inheritAlpha != b.*.inheritAlpha { return 3 }
    if a.*.passThrough != b.*.passThrough || a.*.collapsed != b.*.collapsed || a.*.label != b.*.label || a.*.channels != b.*.channels { return 3 }
    if a.*.opacity != b.*.opacity { return 4 }
    if a.*.blend != b.*.blend { return 5 }
    if !sameParams(&a.*.params, &b.*.params) { return 6 }
    if (a.*.device == null) != (b.*.device == null) { return 7 }
    if a.*.device != null {
        if places && (a.*.device.?.*.x != b.*.device.?.*.x || a.*.device.?.*.y != b.*.device.?.*.y) { return 8 }
        if !samePixels(a.*.device.?, b.*.device.?) { return 9 }
    }
    if a.*.kind == node.CLONE {
        const shown_a = image_module.find(ia, a.*.cloneOf)
        const shown_b = image_module.find(ib, b.*.cloneOf)
        if shown_a == null || shown_b == null || !std.text.same(node.nameOf(shown_a.?), node.nameOf(shown_b.?)) { return 11 }
    }
    if node.childCount(a) != node.childCount(b) { return 10 }
    var index: usize = 0
    while index < node.childCount(a) {
        const inner = treeDifference(node.childAt(a, index), node.childAt(b, index), ia, ib, places)
        if inner != 0 { return inner }
        index += 1
    }
    return 0
}

fn activeName(image: *Image) -> []const u8 {
    if image.*.active == null { return "" }
    return node.nameOf(image.*.active.?)
}

// ---------------------------------------------------------------------------
// Readers by number, for the fuzzing: what reading `bytes` came to, as a
// number (the status; for what was read, also what it holds).

const KRA: u8 = 0
const ORA: u8 = 1
const PSD: u8 = 2
const GIF: u8 = 3
const TIFF: u8 = 4
const LZF: u8 = 5

fn layered(status: formats.Status, result: *formats.LoadResult) -> u64 {
    var answer = @intCast(u64, @intFromEnum(status))
    if status == formats.Status.ok {
        const image = result.*.image.?
        answer += 256 * @intCast(u64, image_module.nodeCount(image) + 1) + 65536 * @intCast(u64, @bitCast(u32, image.*.width))
        image_module.destroy(image)
    }
    return answer
}

fn picture(status: png.Status, read: *png.Picture) -> u64 {
    var answer = @intCast(u64, @intFromEnum(status))
    if status == png.Status.ok {
        var sum: u64 = 0
        var index: usize = 0
        while index < read.*.width * read.*.height {
            sum = sum *% 31 +% @intCast(u64, read.*.pixels[index])
            index += 1
        }
        answer += 256 * (sum & 0xFFFFFFFF)
        png.free(read)
    }
    return answer
}

fn outcome(which: u8, bytes: []const u8, allocator: Allocator, room: [*]u8) -> u64 {
    var result: formats.LoadResult = undefined
    var report: ora.Report = undefined
    if which == KRA { return layered(kra.read(allocator, bytes, &result, &report), &result) }
    if which == ORA { return layered(ora.read(allocator, bytes, &result, &report), &result) }
    if which == PSD { return layered(psd.read(allocator, bytes, &result, &report), &result) }
    var read: png.Picture = undefined
    if which == GIF { return picture(gif.decode(bytes, allocator, &read), &read) }
    if which == TIFF { return picture(tiff.decode(bytes, allocator, &read), &read) }
    var produced: usize = 0
    const done = lzf.decompress(bytes, room, 8192, &produced)
    return @intCast(u64, produced) * 2 + (if done { 1 } else { 0 })
}

// `length` bytes of `bytes` read twice, once with zeros behind them and
// once with 0xFF: the same answer (nothing behind them was read).
fn sameBehind(which: u8, bytes: []const u8, length: usize, allocator: Allocator, one: [*]u8, two: [*]u8, room: [*]u8) -> bool {
    std.mem.copy(one, bytes.pointer, length)
    std.mem.copy(two, bytes.pointer, length)
    std.mem.set(one + length, 0, 64)
    std.mem.set(two + length, 255, 64)
    return outcome(which, one[0..length], allocator, room) == outcome(which, two[0..length], allocator, room)
}

const ROOM: usize = 262144

// Every truncation and 1000 random flips of 1 to 4 bytes of `bytes`.
fn fuzz(which: u8, bytes: []const u8, allocator: Allocator, generator: *random.Xoshiro256, one: [*]u8, two: [*]u8, room: [*]u8) -> bool {
    if bytes.length + 64 > ROOM / 2 { return false }
    var length: usize = 0
    while length < bytes.length {
        if !sameBehind(which, bytes, length, allocator, one, two, room) { return false }
        length += 1
    }
    var round: usize = 0
    while round < 1000 {
        const scratch_bytes = one + ROOM / 2
        std.mem.copy(scratch_bytes, bytes.pointer, bytes.length)
        var flips = 1 + random.below(generator, 4)
        while flips > 0 {
            const at = @intCast(usize, random.below(generator, @intCast(u64, bytes.length)))
            scratch_bytes[at] = @intCast(u8, random.below(generator, 256))
            flips -= 1
        }
        if !sameBehind(which, scratch_bytes[0..bytes.length], bytes.length, allocator, one, two, room) { return false }
        round += 1
    }
    return true
}

// The archive `original` again (all stored) with entry `name` replaced
// by `data`, into `into`.
fn rezip(original: []const u8, name: []const u8, data: []const u8, allocator: Allocator, into: *Bytes) -> bool {
    into.*.clearRetainingCapacity()
    var reader: zip.Reader = undefined
    if !zip.open(&reader, original, allocator) { return false }
    var writer: zip.Writer = undefined
    zip.begin(&writer, into, allocator)
    var ok = true
    var index: usize = 0
    while ok && index < zip.count(&reader) {
        const entry_name = zip.name(&reader, index)
        if std.text.same(entry_name, name) {
            ok = zip.add(&writer, entry_name, data, zip.STORED, 0)
        } else {
            const size = zip.size(&reader, index)
            const block = zip.read(&reader, index, allocator)
            ok = block != null && zip.add(&writer, entry_name, block.?[0..size], zip.STORED, 0)
            if block != null { zip.free(allocator, block.?, size) }
        }
        index += 1
    }
    zip.close(&reader)
    return ok && zip.finish(&writer)
}

// Entry `name` of the archive into `into`.
fn entryOf(archive: []const u8, name: []const u8, allocator: Allocator, into: *Bytes) -> bool {
    into.*.clearRetainingCapacity()
    var reader: zip.Reader = undefined
    if !zip.open(&reader, archive, allocator) { return false }
    const index = zip.find(&reader, name)
    var ok = index != null
    if ok {
        const size = zip.size(&reader, index.?)
        const block = zip.read(&reader, index.?, allocator)
        ok = block != null && into.*.appendSlice(block.?[0..size])
        if block != null { zip.free(allocator, block.?, size) }
    }
    zip.close(&reader)
    return ok
}

// An archive's entry fuzzed: every truncation and 300 random flips of
// it, each archive made again and read (never a trap).
fn fuzzEntry(which: u8, archive: []const u8, name: []const u8, allocator: Allocator, generator: *random.Xoshiro256, room: [*]u8) -> bool {
    var entry = Bytes.init(allocator)
    var made = Bytes.init(allocator)
    var changed = Bytes.init(allocator)
    defer entry.deinit()
    defer made.deinit()
    defer changed.deinit()
    if !entryOf(archive, name, allocator, &entry) { return false }
    var length: usize = 0
    while length < entry.count() {
        if !rezip(archive, name, entry.items()[0..length], allocator, &made) { return false }
        _ = outcome(which, made.items(), allocator, room)
        length += 1
    }
    var round: usize = 0
    while round < 300 {
        changed.clearRetainingCapacity()
        if !changed.appendSlice(entry.items()) { return false }
        var flips = 1 + random.below(generator, 4)
        while flips > 0 {
            const at = @intCast(usize, random.below(generator, @intCast(u64, entry.count())))
            changed.items()[at] = @intCast(u8, random.below(generator, 256))
            flips -= 1
        }
        if !rezip(archive, name, changed.items(), allocator, &made) { return false }
        _ = outcome(which, made.items(), allocator, room)
        round += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// LZF

fn lzfRoundTrip(table: *lzf.Table, from: [*]const u8, length: usize, squeezed: [*]u8, back: [*]u8, smaller_than: usize) -> bool {
    const made = lzf.compress(table, from, length, squeezed, lzf.bound(length) + 16)
    if length == 0 { return made == 0 }
    if made == 0 || made > lzf.bound(length) || made >= smaller_than { return false }
    var produced: usize = 0
    if !lzf.decompress(squeezed[0..made], back, length, &produced) || produced != length { return false }
    return std.mem.eql(from, back, length)
}

fn testLzf(allocator: Allocator, generator: *random.Xoshiro256) -> u8 {
    const size: usize = 70000
    const from = allocator.alloc(size, 16).?
    const squeezed = allocator.alloc(lzf.bound(size) + 16, 16).?
    const back = allocator.alloc(size, 16).?
    const slots = allocator.alloc(lzf.SLOTS * 4, 16).?
    var table: lzf.Table = undefined
    lzf.begin(&table, unsafe { @ptrCast([*]u32, slots) })
    var result: u8 = 0
    // Random bytes: no smaller, but whole again.
    var index: usize = 0
    while index < size {
        from[index] = @intCast(u8, random.next(generator) & 255)
        index += 1
    }
    const lengths = [8]usize{ 0, 1, 2, 3, 4, 100, 16384, 70000 }
    var which: usize = 0
    while which < 8 && result == 0 {
        if !lzfRoundTrip(&table, from, lengths[which], squeezed, back, lzf.bound(lengths[which]) + 1) { result = 1 }
        which += 1
    }
    // Repetitive: 50 random bytes over and over, runs of one byte.
    index = 50
    while index < size {
        from[index] = from[index - 50]
        if index % 1000 < 300 { from[index] = 42 }
        index += 1
    }
    if result == 0 && !lzfRoundTrip(&table, from, size, squeezed, back, size / 10) { result = 2 }
    if result == 0 && !lzfRoundTrip(&table, from, 16384, squeezed, back, 16384 / 10) { result = 2 }
    // A stream made by hand: "abc", a reference of 6 three back
    // (overlapping: "abcabc"), one of 12 one back (its length in an
    // extra byte: "c" twelve times), a literal "Z".
    const hand = "\x02abc\x80\x02\xE0\x03\x00\x00Z"
    var produced: usize = 0
    if result == 0 && (!lzf.decompress(hand, back, 64, &produced) || produced != 22 || !std.mem.eql(back, "abcabcabcccccccccccccZ".pointer, 22)) { result = 3 }
    // Refused: a reference before the start, streams cut short, too
    // little room.
    if result == 0 && lzf.decompress("\x00a\x20\x05", back, 64, &produced) { result = 4 }
    if result == 0 && (lzf.decompress("\x05ab", back, 64, &produced) || lzf.decompress("\x20", back, 64, &produced) || lzf.decompress("\xE0\x01", back, 64, &produced)) { result = 5 }
    if result == 0 && (lzf.decompress(hand, back, 21, &produced) || lzf.decompress("\x02abc", back, 2, &produced)) { result = 6 }
    if result == 0 && (!lzf.decompress("", back, 0, &produced) || produced != 0) { result = 7 }
    // The same input, the same bytes (the table is as empty each time).
    if result == 0 {
        const first = lzf.compress(&table, from, 5000, squeezed, lzf.bound(5000))
        const second = lzf.compress(&table, from, 5000, back, lzf.bound(5000))
        if first == 0 || first != second || !std.mem.eql(squeezed, back, first) { result = 8 }
    }
    allocator.free(from, size, 16)
    allocator.free(squeezed, lzf.bound(size) + 16, 16)
    allocator.free(back, size, 16)
    allocator.free(slots, lzf.SLOTS * 4, 16)
    return result
}

// ---------------------------------------------------------------------------
// KRA and ORA

fn testKra(allocator: Allocator) -> u8 {
    const image = makeDocument(allocator, true)
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    var report: ora.Report = undefined
    const options = formats.saveOptions()
    if kra.write(image, &options, &bytes, &report) != formats.Status.ok || report.lossy { return 20 }
    // The mimetype first, stored: a Krita document by its content.
    const kind = formats.sniff(bytes.items())
    if kind == null || kind.?.*.id != formats.KRA || !std.mem.eql(bytes.items().pointer + 30, "mimetypeapplication/x-krita".pointer, 27) { return 21 }
    var result: formats.LoadResult = undefined
    if kra.read(allocator, bytes.items(), &result, &report) != formats.Status.ok || report.skipped { return 22 }
    const back = result.image.?
    if back.*.width != 200 || back.*.height != 150 || back.*.resolution != 300.0 || back.*.modified { return 23 }
    const difference = treeDifference(image.*.root, back.*.root, image, back, true)
    if difference != 0 { return 23 + difference }
    if !std.text.same(activeName(back), "Half") { return 35 }
    if !sameComposite(image, back) { return 36 }
    // What a moved layer's file says: its place, its tiles from there.
    var entry = Bytes.init(allocator)
    defer entry.deinit()
    var main = Bytes.init(allocator)
    defer main.deinit()
    if !entryOf(bytes.items(), "maindoc.xml", allocator, &main) || !std.text.contains(main.items(), "x=\"-37\" y=\"-21\"") || !std.text.contains(main.items(), "nodetype=\"adjustmentlayer\"") { return 37 }
    if !std.text.contains(main.items(), "filtername=\"invert\"") || !std.text.contains(main.items(), "generatorname=\"color\"") || !std.text.contains(main.items(), "passthrough=\"1\"") || !std.text.contains(main.items(), "channellockflags=\"1110\"") { return 38 }
    if !entryOf(bytes.items(), "image/layers/layer7", allocator, &entry) || !std.text.startsWith(entry.items(), "VERSION 2\nTILEWIDTH 64\nTILEHEIGHT 64\nPIXELSIZE 4\nDATA ") { return 39 }
    if !entryOf(bytes.items(), "image/layers/mask8.pixelselection", allocator, &entry) || !std.text.startsWith(entry.items(), "VERSION 2\nTILEWIDTH 64\nTILEHEIGHT 64\nPIXELSIZE 1\n") { return 40 }
    if !entryOf(bytes.items(), "image/layers/layer2.filterconfig", allocator, &entry) || !std.text.contains(entry.items(), "<param name=\"green\">200</param>") { return 41 }
    if !entryOf(bytes.items(), "mergedimage.png", allocator, &entry) || !entryOf(bytes.items(), "preview.png", allocator, &main) { return 42 }
    // The merged image is the composite.
    var merged: png.Picture = undefined
    if png.decode(entry.items(), allocator, &merged) != png.Status.ok || merged.width != 200 || merged.height != 150 { return 43 }
    if merged.pixels[75 * 200 + 120] != device.pixel(image.*.projection, 120, 75) { return 44 }
    png.free(&merged)
    // Another colour space is refused, by name.
    var other = Bytes.init(allocator)
    defer other.deinit()
    if !entryOf(bytes.items(), "maindoc.xml", allocator, &main) { return 45 }
    const at = text.attributeOf(main.items(), std.text.find(main.items(), "<IMAGE"), "colorspacename")
    if at == null { return 45 }
    const place = @intFromPtr(at.?.pointer) - @intFromPtr(main.items().pointer)
    if !other.appendSlice(main.items()[0..place]) || !other.appendSlice("CMYKA") || !other.appendSlice(main.items()[place + 4..]) { return 45 }
    var changed = Bytes.init(allocator)
    defer changed.deinit()
    if !rezip(bytes.items(), "maindoc.xml", other.items(), allocator, &changed) { return 46 }
    if kra.read(allocator, changed.items(), &result, &report) != formats.Status.unsupported || !std.text.same(ora.spaceOf(&report), "CMYKA") || result.image != null { return 47 }
    image_module.destroy(back)
    image_module.destroy(image)
    return 0
}

fn testOra(allocator: Allocator) -> u8 {
    const image = makeDocument(allocator, true)
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    var report: ora.Report = undefined
    const options = formats.saveOptions()
    if !ora.lossOf(image) { return 50 }
    if ora.write(image, &options, &bytes, &report) != formats.Status.ok || !report.lossy { return 51 }
    const kind = formats.sniff(bytes.items())
    if kind == null || kind.?.*.id != formats.ORA { return 52 }
    var result: formats.LoadResult = undefined
    if ora.read(allocator, bytes.items(), &result, &report) != formats.Status.ok || report.skipped { return 53 }
    const back = result.image.?
    if back.*.width != 200 || back.*.height != 150 || back.*.resolution != 300.0 { return 54 }
    // The filter, fill and clone layers are pixels now; the composite
    // stays.
    if !sameComposite(image, back) { return 55 }
    const root = back.*.root
    if node.childCount(root) != 5 || node.childAt(root, 2).*.kind != node.PAINT || node.childAt(root, 2).*.blend != blend.COPY || node.childAt(root, 2).*.opacity != 255 { return 56 }
    const group = node.childAt(root, 1)
    if group.*.kind != node.GROUP || !group.*.passThrough || node.childCount(group) != 3 || !std.text.same(node.nameOf(group), "Group") { return 57 }
    const half = node.childAt(group, 1)
    if half.*.opacity != 128 || half.*.blend != blend.MULTIPLY || !half.*.alphaLocked || !std.text.same(activeName(back), "Half") { return 58 }
    if !samePixels(half.*.device.?, image.*.active.?.*.device.?) { return 59 }
    const hidden = node.childAt(group, 2)
    if hidden.*.visible || !hidden.*.locked || !std.text.same(node.nameOf(node.childAt(group, 0)), "Moved \u{E4}\u{20AC}") { return 60 }
    // The thumbnail: at most 256 on its longer side, the mean of what it
    // stands for (one colour: that colour; transparent: transparent).
    const wide = image_module.create(allocator, 600, 301, 72.0).?
    const paint = addNode(wide, node.PAINT, "Paint", wide.*.root)
    fillRect(paint, geom.rect(0, 0, 600, 150), 0xFF208040)
    image_module.damageAll(wide)
    bytes.clearRetainingCapacity()
    var thumbnail: png.Picture = undefined
    if ora.write(wide, &options, &bytes, &report) != formats.Status.ok || report.lossy { return 76 }
    var entry = Bytes.init(allocator)
    defer entry.deinit()
    if !entryOf(bytes.items(), "Thumbnails/thumbnail.png", allocator, &entry) || png.decode(entry.items(), allocator, &thumbnail) != png.Status.ok { return 77 }
    if thumbnail.width != 256 || thumbnail.height != 128 || thumbnail.pixels[0] != 0xFF208040 || thumbnail.pixels[127 * 256 + 255] != 0 { return 78 }
    png.free(&thumbnail)
    image_module.destroy(wide)
    // A document of paint layers and groups comes back whole.
    const plain = makePlain(allocator)
    if ora.lossOf(plain) { return 61 }
    bytes.clearRetainingCapacity()
    if ora.write(plain, &options, &bytes, &report) != formats.Status.ok || report.lossy { return 62 }
    var again: formats.LoadResult = undefined
    if ora.read(allocator, bytes.items(), &again, &report) != formats.Status.ok { return 63 }
    // (Placed where their pixels are: the places differ, the pixels not.
    // A clipped layer is in Source Atop, which mixes the same; folding is
    // not kept.)
    const plain_back = again.image.?
    const clipped = node.childAt(node.childAt(plain_back.*.root, 2), 1)
    if clipped.*.blend != blend.SOURCE_ATOP || clipped.*.inheritAlpha { return 63 }
    if !sameComposite(plain, plain_back) { return 75 }
    clipped.*.inheritAlpha = true
    clipped.*.blend = blend.NORMAL
    node.childAt(plain_back.*.root, 2).*.collapsed = true
    const difference = treeDifference(plain.*.root, plain_back.*.root, plain, plain_back, false)
    if difference != 0 { return 63 + difference }
    image_module.destroy(plain_back)
    image_module.destroy(plain)
    image_module.destroy(back)
    image_module.destroy(image)
    return 0
}

fn addPng(writer: *zip.Writer, name: []const u8, pixels: [*]const u32, width: usize, height: usize, allocator: Allocator) -> bool {
    var list = Bytes.init(allocator)
    defer list.deinit()
    return png.encode(pixels, width, height, width, true, &list) && zip.add(writer, name, list.items(), zip.STORED, 0)
}

// A stack.xml written by hand.
fn testStack(allocator: Allocator) -> u8 {
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    var writer: zip.Writer = undefined
    zip.begin(&writer, &bytes, allocator)
    const stack = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<image version=\"0.0.3\" w=\"64\" h=\"48\" xres=\"150\">\n <stack>\n  <unknown-thing foo=\"bar\"><layer-ish/></unknown-thing>\n  <layer name=\"Top &amp; more\" src=\"data/a.png\" x=\"-10\" y=\"5\" opacity=\"0.5\" composite-op=\"svg:screen\" selected=\"true\"/>\n  <stack name=\"Outer\" isolation=\"isolate\" composite-op=\"svg:multiply\" opacity=\"0.25\">\n   <stack name=\"Inner\" isolation=\"auto\" visibility=\"hidden\">\n    <layer name=\"Deep\" src=\"data/b.png\" x=\"100\" y=\"100\" composite-op=\"svg:color-dodge\"/>\n   </stack>\n   <layer name=\"Plain\" src=\"data/c.png\"/>\n  </stack>\n  <layer name=\"Missing\" src=\"data/none.png\" visibility=\"hidden\" edit-locked=\"true\"/>\n </stack>\n</image>\n"
    const colours = [4]u32{ 0xFF112233, 0x80445566, 0x01778899, 0xFFAABBCC }
    if !zip.add(&writer, "mimetype", "image/openraster", zip.STORED, 0) || !zip.add(&writer, "stack.xml", stack, zip.DEFLATED, 6) { return 80 }
    if !addPng(&writer, "data/a.png", &colours, 2, 2, allocator) || !addPng(&writer, "data/b.png", &colours, 4, 1, allocator) || !addPng(&writer, "data/c.png", &colours, 1, 4, allocator) || !zip.finish(&writer) { return 80 }
    var result: formats.LoadResult = undefined
    var report: ora.Report = undefined
    if ora.read(allocator, bytes.items(), &result, &report) != formats.Status.ok || !report.skipped { return 81 }
    const image = result.image.?
    const root = image.*.root
    if image.*.width != 64 || image.*.height != 48 || image.*.resolution != 150.0 || node.childCount(root) != 3 { return 82 }
    const missing = node.childAt(root, 0)
    const outer = node.childAt(root, 1)
    const top = node.childAt(root, 2)
    if !std.text.same(node.nameOf(missing), "Missing") || missing.*.visible || !missing.*.locked || device.tileCount(missing.*.device.?) != 0 { return 83 }
    if !std.text.same(node.nameOf(top), "Top & more") || top.*.opacity != 128 || top.*.blend != blend.SCREEN || !std.text.same(activeName(image), "Top & more") { return 84 }
    if device.pixel(top.*.device.?, -10, 5) != 0xFF112233 || device.pixel(top.*.device.?, -9, 6) != 0xFFAABBCC || device.pixel(top.*.device.?, -11, 5) != 0 { return 85 }
    if outer.*.kind != node.GROUP || outer.*.passThrough || outer.*.blend != blend.MULTIPLY || outer.*.opacity != 64 || node.childCount(outer) != 2 { return 86 }
    const plain = node.childAt(outer, 0)
    const inner = node.childAt(outer, 1)
    if !std.text.same(node.nameOf(plain), "Plain") || plain.*.blend != blend.NORMAL || plain.*.opacity != 255 || !plain.*.visible || device.pixel(plain.*.device.?, 0, 3) != 0xFFAABBCC { return 87 }
    if !std.text.same(node.nameOf(inner), "Inner") || !inner.*.passThrough || inner.*.visible || node.childCount(inner) != 1 { return 88 }
    const deep = node.childAt(inner, 0)
    if deep.*.blend != blend.DODGE || device.pixel(deep.*.device.?, 101, 100) != 0x80445566 || device.pixel(deep.*.device.?, 102, 100) != 0x01778899 { return 89 }
    image_module.destroy(image)
    // No size, no stack: damaged; not a ZIP: not this format.
    bytes.clearRetainingCapacity()
    zip.begin(&writer, &bytes, allocator)
    if !zip.add(&writer, "mimetype", "image/openraster", zip.STORED, 0) || !zip.add(&writer, "stack.xml", "<image><stack/></image>", zip.STORED, 0) || !zip.finish(&writer) { return 90 }
    if ora.read(allocator, bytes.items(), &result, &report) != formats.Status.damaged || ora.read(allocator, "not a zip", &result, &report) != formats.Status.unknownFormat { return 91 }
    return 0
}

// ---------------------------------------------------------------------------
// PSD

fn put16(out: *Bytes, value: usize) -> void {
    _ = out.*.append(@intCast(u8, (value >> 8) & 255))
    _ = out.*.append(@intCast(u8, value & 255))
}

fn put32(out: *Bytes, value: usize) -> void {
    put16(out, (value >> 16) & 65535)
    put16(out, value & 65535)
}

// A PSD of 4 x 2 RGB with one layer "Hello" of 4 x 2 at (2, 1), its
// channels PackBits, and a merged image (raw).
fn handPsd(out: *Bytes) -> void {
    _ = out.*.appendSlice("8BPS")
    put16(out, 1)
    put32(out, 0)
    put16(out, 0)
    put16(out, 3)
    put32(out, 2)
    put32(out, 4)
    put16(out, 8)
    put16(out, 3)
    put32(out, 0)
    put32(out, 0)
    // Channel data: alpha 255 255 255 255 / 0 0 128 128; red 10 20 30 40
    // twice; green 7 x 4 twice; blue 1 2 3 4 / 9 9 9 9.
    var channels = Bytes.init(out.*.allocator)
    defer channels.deinit()
    // alpha: rows "FD FF" (4 x 255) and "01 00 00 FF 80" (00 00, then 2 x 128)
    put16(&channels, 1)
    put16(&channels, 2)
    put16(&channels, 5)
    _ = channels.appendSlice("\xFD\xFF\x01\x00\x00\xFF\x80")
    const alpha_length = channels.count()
    put16(&channels, 1)
    put16(&channels, 5)
    put16(&channels, 5)
    _ = channels.appendSlice("\x03\x0A\x14\x1E\x28\x03\x0A\x14\x1E\x28")
    const red_length = channels.count() - alpha_length
    put16(&channels, 1)
    put16(&channels, 2)
    put16(&channels, 2)
    _ = channels.appendSlice("\xFD\x07\xFD\x07")
    const green_length = channels.count() - alpha_length - red_length
    // Blue raw.
    put16(&channels, 0)
    _ = channels.appendSlice("\x01\x02\x03\x04\x09\x09\x09\x09")
    const blue_length = channels.count() - alpha_length - red_length - green_length
    var record = Bytes.init(out.*.allocator)
    defer record.deinit()
    put32(&record, 1)
    put32(&record, 2)
    put32(&record, 3)
    put32(&record, 6)
    put16(&record, 4)
    put16(&record, 0xFFFF)
    put32(&record, alpha_length)
    put16(&record, 0)
    put32(&record, red_length)
    put16(&record, 1)
    put32(&record, green_length)
    put16(&record, 2)
    put32(&record, blue_length)
    _ = record.appendSlice("8BIMnorm")
    _ = record.appendSlice("\xC8\x00\x00\x00")
    put32(&record, 4 + 4 + 8)
    put32(&record, 0)
    put32(&record, 0)
    _ = record.appendSlice("\x05Hello\x00\x00")
    const info = 2 + record.count() + channels.count()
    put32(out, info + 4 + (info % 2) + 4)
    put32(out, info + (info % 2))
    put16(out, 1)
    _ = out.*.appendSlice(record.items())
    _ = out.*.appendSlice(channels.items())
    if info % 2 != 0 { _ = out.*.append(0) }
    put32(out, 0)
    // The merged image, raw, three channels of 4 x 2.
    put16(out, 0)
    _ = out.*.appendNTimes(77, 24)
}

fn testPsd(allocator: Allocator) -> u8 {
    const image = makePlain(allocator)
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    var report: ora.Report = undefined
    const options = formats.saveOptions()
    if psd.write(image, &options, &bytes, &report) != formats.Status.ok || report.lossy { return 100 }
    const kind = formats.sniff(bytes.items())
    if kind == null || kind.?.*.id != formats.PSD { return 101 }
    var result: formats.LoadResult = undefined
    if psd.read(allocator, bytes.items(), &result, &report) != formats.Status.ok || report.skipped { return 102 }
    const back = result.image.?
    if back.*.width != 90 || back.*.height != 70 || back.*.resolution != 150.0 { return 103 }
    const difference = treeDifference(image.*.root, back.*.root, image, back, false)
    if difference != 0 { return 103 + difference }
    if !sameComposite(image, back) { return 115 }
    // The merged image alone (the layers taken out): the composite.
    const bytes_list = bytes.items()
    var at: usize = 26
    at += 4 + @intCast(usize, std.mem.readU32Big(bytes_list.pointer, at))
    at += 4 + @intCast(usize, std.mem.readU32Big(bytes_list.pointer, at))
    const layers = @intCast(usize, std.mem.readU32Big(bytes_list.pointer, at))
    var alone = Bytes.init(allocator)
    defer alone.deinit()
    if !alone.appendSlice(bytes_list[0..at]) || !alone.appendSlice("\x00\x00\x00\x00") || !alone.appendSlice(bytes_list[at + 4 + layers..]) { return 116 }
    var merged: formats.LoadResult = undefined
    if psd.read(allocator, alone.items(), &merged, &report) != formats.Status.ok { return 117 }
    const flat = merged.image.?
    if node.childCount(flat.*.root) != 1 || !std.text.same(node.nameOf(node.childAt(flat.*.root, 0)), "Background") { return 118 }
    var y: i32 = 0
    while y < 70 {
        var x: i32 = 0
        while x < 90 {
            if device.pixel(node.childAt(flat.*.root, 0).*.device.?, x, y) != device.pixel(image.*.projection, x, y) { return 119 }
            x += 1
        }
        y += 1
    }
    image_module.destroy(flat)
    // One made by hand.
    alone.clearRetainingCapacity()
    handPsd(&alone)
    if psd.read(allocator, alone.items(), &merged, &report) != formats.Status.ok { return 120 }
    const hand = merged.image.?
    if hand.*.width != 4 || hand.*.height != 2 || node.childCount(hand.*.root) != 1 { return 121 }
    const hello = node.childAt(hand.*.root, 0)
    if !std.text.same(node.nameOf(hello), "Hello") || hello.*.opacity != 200 || hello.*.blend != blend.NORMAL { return 122 }
    const shown = hello.*.device.?
    if device.pixel(shown, 2, 1) != 0xFF0A0701 || device.pixel(shown, 5, 1) != 0xFF280704 || device.pixel(shown, 3, 2) != 0x00140709 || device.pixel(shown, 5, 2) != 0x80280709 || device.pixel(shown, 1, 1) != 0 { return 123 }
    image_module.destroy(hand)
    // Another colour mode, PSB, cut short.
    std.mem.writeU16Big(alone.items().pointer, 24, 4)
    if psd.read(allocator, alone.items(), &merged, &report) != formats.Status.unsupported || !std.text.same(ora.spaceOf(&report), "CMYK") { return 124 }
    std.mem.writeU16Big(alone.items().pointer, 24, 3)
    std.mem.writeU16Big(alone.items().pointer, 4, 2)
    if psd.read(allocator, alone.items(), &merged, &report) != formats.Status.unsupported { return 125 }
    std.mem.writeU16Big(alone.items().pointer, 4, 1)
    if psd.read(allocator, alone.items()[0..80], &merged, &report) != formats.Status.damaged { return 126 }
    // The document of every kind: lossy, the composite where what is
    // below the filter is opaque.
    const document = makeDocument(allocator, true)
    bytes.clearRetainingCapacity()
    if psd.write(document, &options, &bytes, &report) != formats.Status.ok || !report.lossy { return 127 }
    if psd.read(allocator, bytes.items(), &merged, &report) != formats.Status.ok { return 128 }
    if !sameComposite(document, merged.image.?) { return 129 }
    image_module.destroy(merged.image.?)
    image_module.destroy(document)
    image_module.destroy(back)
    image_module.destroy(image)
    return 0
}

// ---------------------------------------------------------------------------
// GIF

fn makePicture(allocator: Allocator, width: usize, height: usize, kind: u8) -> png.Picture {
    var made: png.Picture = undefined
    _ = png.makePicture(&made, width, height, allocator)
    const colours = [4]u32{ 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, 0xFFFFFFFF }
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            var value: u32 = 0
            if kind == 0 {
                value = colours[(x / 3 + y / 2) % 4]
            } else if kind == 1 {
                value = pixel.rgb(@intCast(u32, x * 4), @intCast(u32, y * 16), @intCast(u32, (x + y) * 2))
            } else if kind == 2 {
                value = colours[(x + y) % 4]
                if (x * 7 + y) % 5 == 0 { value = 0 }
            } else {
                value = pixel.pack(@intCast(u32, (x * 37 + y * 11) & 255), @intCast(u32, (x * 5) & 255), @intCast(u32, (y * 9) & 255), @intCast(u32, (x ^ y) & 255))
                if (x + y) % 9 == 0 { value = value | 0xFF000000 }
            }
            made.pixels[y * width + x] = value
            x += 1
        }
        y += 1
    }
    made.resolution = 300.0
    return made
}

fn samePicture(a: *const png.Picture, b: *const png.Picture) -> bool {
    if a.*.width != b.*.width || a.*.height != b.*.height { return false }
    return std.mem.eql(unsafe { @ptrCast([*]const u8, a.*.pixels) }, unsafe { @ptrCast([*]const u8, b.*.pixels) }, a.*.width * a.*.height * 4)
}

fn channelError(a: u32, b: u32) -> u32 {
    return if a > b { a - b } else { b - a }
}

// A GIF made by hand: 3 x 5, four colours, interlaced (the rows stored
// 0, 4, 2, 1, 3).
fn handGif(out: *Bytes, allocator: Allocator) -> bool {
    _ = out.*.appendSlice("GIF87a\x03\x00\x05\x00\x81\x00\x00")
    _ = out.*.appendSlice("\x00\x00\x00\xFF\x00\x00\x00\xFF\x00\x00\x00\xFF")
    _ = out.*.appendSlice("\x2C\x00\x00\x00\x00\x03\x00\x05\x00\x40\x02")
    // Row y holds colour y % 4 everywhere; stored in interlace order.
    const stored = "\x00\x00\x00\x00\x00\x00\x02\x02\x02\x01\x01\x01\x03\x03\x03"
    var codes = Bytes.init(allocator)
    defer codes.deinit()
    if !gif.lzwEncode(stored.pointer, 15, 2, gif.GIF_FORM, &codes) { return false }
    _ = out.*.append(@intCast(u8, codes.count()))
    _ = out.*.appendSlice(codes.items())
    _ = out.*.appendSlice("\x00\x3B")
    return true
}

fn testGif(allocator: Allocator) -> u8 {
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    const options = formats.saveOptions()
    var four = makePicture(allocator, 37, 23, 0)
    var back: png.Picture = undefined
    if !gif.encode(&four, &options, &bytes) || !gif.isGif(bytes.items()) { return 130 }
    if gif.decode(bytes.items(), allocator, &back) != png.Status.ok || !samePicture(&four, &back) { return 131 }
    png.free(&back)
    // A gradient of many colours: near, on the whole very near.
    var smooth = makePicture(allocator, 64, 16, 1)
    bytes.clearRetainingCapacity()
    if !gif.encode(&smooth, &options, &bytes) || gif.decode(bytes.items(), allocator, &back) != png.Status.ok { return 132 }
    var worst: u32 = 0
    var total: u64 = 0
    var index: usize = 0
    while index < 64 * 16 {
        const a = smooth.pixels[index]
        const b = back.pixels[index]
        if b >> 24 != 255 { return 133 }
        const errors = [3]u32{ channelError(pixel.red(a), pixel.red(b)), channelError(pixel.green(a), pixel.green(b)), channelError(pixel.blue(a), pixel.blue(b)) }
        for value in errors {
            if value > worst { worst = value }
            total += @intCast(u64, value)
        }
        index += 1
    }
    if worst > 40 || total > 64 * 16 * 3 * 6 { return 134 }
    png.free(&back)
    // Transparency.
    var holes = makePicture(allocator, 19, 11, 2)
    bytes.clearRetainingCapacity()
    if !gif.encode(&holes, &options, &bytes) || gif.decode(bytes.items(), allocator, &back) != png.Status.ok || !samePicture(&holes, &back) { return 135 }
    png.free(&back)
    // Interlaced, by hand.
    bytes.clearRetainingCapacity()
    if !handGif(&bytes, allocator) || gif.decode(bytes.items(), allocator, &back) != png.Status.ok || back.width != 3 || back.height != 5 { return 136 }
    const rows = [5]u32{ 0xFF000000, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, 0xFF000000 }
    var row: usize = 0
    while row < 5 {
        if back.pixels[row * 3] != rows[row] || back.pixels[row * 3 + 2] != rows[row] { return 137 }
        row += 1
    }
    png.free(&back)
    // Two frames: the encoded frame twice, the second at (2, 1).
    bytes.clearRetainingCapacity()
    var small = makePicture(allocator, 4, 4, 0)
    if !gif.encode(&small, &options, &bytes) { return 138 }
    var twice = Bytes.init(allocator)
    defer twice.deinit()
    const all = bytes.items()
    const frame_at = std.text.find(all, "\x2C\x00\x00\x00\x00\x04\x00")
    if frame_at >= all.length { return 138 }
    _ = twice.appendSlice(all[0..all.length - 1])
    _ = twice.appendSlice(all[frame_at..all.length - 1])
    _ = twice.append(0x3B)
    std.mem.writeU16Little(twice.items().pointer, all.length - 1 + 1, 2)
    std.mem.writeU16Little(twice.items().pointer, all.length - 1 + 3, 1)
    var result: formats.LoadResult = undefined
    var report: ora.Report = undefined
    const frames = gif.LoadOptions.{ .frames = true }
    if gif.read(allocator, twice.items(), &frames, &result, &report) != formats.Status.ok { return 139 }
    const image = result.image.?
    if node.childCount(image.*.root) != 2 || !std.text.same(node.nameOf(node.childAt(image.*.root, 1)), "Frame 2") { return 140 }
    if device.pixel(node.childAt(image.*.root, 1).*.device.?, 2, 1) != small.pixels[0] || device.pixel(node.childAt(image.*.root, 1).*.device.?, 5, 4) != small.pixels[15] { return 141 }
    if device.pixel(node.childAt(image.*.root, 0).*.device.?, 3, 3) != small.pixels[15] { return 141 }
    image_module.destroy(image)
    const first = gif.LoadOptions.{ .frames = false }
    if gif.read(allocator, twice.items(), &first, &result, &report) != formats.Status.ok || node.childCount(result.image.?.*.root) != 1 { return 142 }
    image_module.destroy(result.image.?)
    png.free(&four)
    png.free(&smooth)
    png.free(&holes)
    png.free(&small)
    return 0
}

// ---------------------------------------------------------------------------
// TIFF

fn testTiff(allocator: Allocator) -> u8 {
    var source = makePicture(allocator, 70, 67, 3)
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    var back: png.Picture = undefined
    const compressions = [5]u16{ tiff.NONE, tiff.PACKBITS, tiff.LZW, tiff.DEFLATE, tiff.DEFLATE_OLD }
    var variant: usize = 0
    while variant < 5 * 8 {
        const settings = tiff.Settings.{ .compression = compressions[variant / 8], .bigEndian = variant % 2 == 1, .predictor = (variant / 2) % 2 == 1, .tiled = (variant / 4) % 2 == 1 }
        bytes.clearRetainingCapacity()
        if !tiff.encodeWith(&source, &settings, &bytes) || !tiff.isTiff(bytes.items()) { return 150 }
        if tiff.decode(bytes.items(), allocator, &back) != png.Status.ok { return 151 }
        if !samePicture(&source, &back) || back.resolution != 300.0 { return 152 }
        png.free(&back)
        variant += 1
    }
    const options = formats.saveOptions()
    bytes.clearRetainingCapacity()
    if !tiff.encode(&source, &options, &bytes) || tiff.decode(bytes.items(), allocator, &back) != png.Status.ok || !samePicture(&source, &back) { return 153 }
    png.free(&back)
    // Grey, white is zero, 3 x 1, big-endian, by hand.
    bytes.clearRetainingCapacity()
    _ = bytes.appendSlice("MM\x00\x2A\x00\x00\x00\x08")
    put16(&bytes, 6)
    _ = bytes.appendSlice("\x01\x00\x00\x03\x00\x00\x00\x01\x00\x03\x00\x00")
    _ = bytes.appendSlice("\x01\x01\x00\x03\x00\x00\x00\x01\x00\x01\x00\x00")
    _ = bytes.appendSlice("\x01\x02\x00\x03\x00\x00\x00\x01\x00\x08\x00\x00")
    _ = bytes.appendSlice("\x01\x06\x00\x03\x00\x00\x00\x01\x00\x00\x00\x00")
    _ = bytes.appendSlice("\x01\x11\x00\x04\x00\x00\x00\x01\x00\x00\x00\x56")
    _ = bytes.appendSlice("\x01\x17\x00\x04\x00\x00\x00\x01\x00\x00\x00\x03")
    put32(&bytes, 0)
    _ = bytes.appendSlice("\x00\x80\xFF")
    if tiff.decode(bytes.items(), allocator, &back) != png.Status.ok || back.width != 3 || back.height != 1 { return 154 }
    if back.pixels[0] != 0xFFFFFFFF || back.pixels[1] != 0xFF7F7F7F || back.pixels[2] != 0xFF000000 { return 155 }
    png.free(&back)
    // 16 bits a sample: not read here.
    std.mem.writeU16Big(bytes.items().pointer, 10 + 24 + 8, 16)
    if tiff.decode(bytes.items(), allocator, &back) != png.Status.unsupported { return 156 }
    png.free(&source)
    return 0
}

// ---------------------------------------------------------------------------
// Through files

fn pathOf(name: []const u8, room: [*]u8) -> []const u8 {
    const length = text.join(FOLDER, name, room, 128)
    return room[0..length]
}

// Each format saved by formats.save(), then the file renamed so that its
// extension lies, and loaded: told by its content.
fn testFiles(allocator: Allocator) -> u8 {
    if !std.fs.makeDirectories(FOLDER, 493) { return 160 }
    const image = makeDocument(allocator, false)
    const ids = [5]u16{ formats.KRA, formats.ORA, formats.PSD, formats.GIF, formats.TIFF }
    const names = [5][]const u8{ "doc.kra", "doc.ora", "doc.psd", "doc.gif", "doc.tif" }
    const lies = [5][]const u8{ "doc_kra.png", "doc_ora.jpg", "doc_psd.bmp", "doc_gif.tga", "doc_tif.qoi" }
    var room: [128]u8 = undefined
    var other: [128]u8 = undefined
    var contents: text.Contents = undefined
    const options = formats.saveOptions()
    var which: usize = 0
    while which < 5 {
        const info = formats.find(ids[which])
        if info == null || !info.?.*.canRead || !info.?.*.canWrite || info.?.*.layers != (which < 3) { return 161 }
        if formats.save(image, pathOf(names[which], &room), ids[which], &options) != formats.Status.ok { return 162 }
        if text.readFile(allocator, pathOf(names[which], &room), &contents) != text.FileStatus.ok { return 163 }
        const written = text.writeFile(allocator, pathOf(lies[which], &other), contents.bytes[0..contents.length])
        text.freeFile(&contents)
        if !written { return 163 }
        var result: formats.LoadResult = undefined
        if formats.load(allocator, pathOf(lies[which], &other), &result) != formats.Status.ok || result.format != ids[which] { return 164 }
        const loaded = result.image.?
        if loaded.*.width != 24 || loaded.*.height != 20 { return 165 }
        // The layered ones keep the tree; the flat ones the composite.
        if which < 3 && node.childCount(loaded.*.root) != 5 { return 166 }
        if which >= 3 && node.childCount(loaded.*.root) != 1 { return 167 }
        if which == 4 && !sameComposite(image, loaded) { return 168 }
        image_module.destroy(loaded)
        which += 1
    }
    image_module.destroy(image)
    return 0
}

// ---------------------------------------------------------------------------

// Every reader fuzzed (see fuzz()), the archives' entries too; the
// value arena not touched.
fn testFuzz(allocator: Allocator, generator: *random.Xoshiro256) -> u8 {
    const one = allocator.alloc(ROOM, 16).?
    const two = allocator.alloc(ROOM, 16).?
    const room = allocator.alloc(8192, 16).?
    const image = makeDocument(allocator, false)
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    var report: ora.Report = undefined
    var options = formats.saveOptions()
    options.level = 1
    const arena = turns.locate()
    const before = turns.used(arena)
    var result: u8 = 0
    if kra.write(image, &options, &bytes, &report) != formats.Status.ok || !fuzz(KRA, bytes.items(), allocator, generator, one, two, room) { result = 170 }
    if result == 0 && (!fuzzEntry(KRA, bytes.items(), "maindoc.xml", allocator, generator, room) || !fuzzEntry(KRA, bytes.items(), "image/layers/layer7", allocator, generator, room)) { result = 171 }
    if result == 0 && (!fuzzEntry(KRA, bytes.items(), "image/layers/mask8.pixelselection", allocator, generator, room) || !fuzzEntry(KRA, bytes.items(), "image/layers/layer2.filterconfig", allocator, generator, room)) { result = 172 }
    bytes.clearRetainingCapacity()
    if result == 0 && (ora.write(image, &options, &bytes, &report) != formats.Status.ok || !fuzz(ORA, bytes.items(), allocator, generator, one, two, room) || !fuzzEntry(ORA, bytes.items(), "stack.xml", allocator, generator, room)) { result = 173 }
    bytes.clearRetainingCapacity()
    if result == 0 && (psd.write(image, &options, &bytes, &report) != formats.Status.ok || !fuzz(PSD, bytes.items(), allocator, generator, one, two, room)) { result = 174 }
    var small = makePicture(allocator, 13, 9, 2)
    bytes.clearRetainingCapacity()
    if result == 0 && (!gif.encode(&small, &options, &bytes) || !fuzz(GIF, bytes.items(), allocator, generator, one, two, room)) { result = 175 }
    var shades = makePicture(allocator, 13, 9, 3)
    const compressions = [4]u16{ tiff.NONE, tiff.PACKBITS, tiff.LZW, tiff.DEFLATE }
    var which: usize = 0
    while result == 0 && which < 4 {
        const settings = tiff.Settings.{ .compression = compressions[which], .bigEndian = which % 2 == 1, .predictor = which >= 2, .tiled = which == 3 }
        bytes.clearRetainingCapacity()
        if !tiff.encodeWith(&shades, &settings, &bytes) || !fuzz(TIFF, bytes.items(), allocator, generator, one, two, room) { result = 176 }
        which += 1
    }
    // LZF: a tile's worth compressed.
    bytes.clearRetainingCapacity()
    var stream = Bytes.init(allocator)
    defer stream.deinit()
    if result == 0 {
        _ = stream.appendNTimes(0, 600)
        var index: usize = 0
        while index < 600 {
            stream.items()[index] = @intCast(u8, (index * index / 7) & 255)
            index += 1
        }
        _ = bytes.appendNTimes(0, lzf.bound(600))
        const slots = allocator.alloc(lzf.SLOTS * 4, 16).?
        var table: lzf.Table = undefined
        lzf.begin(&table, unsafe { @ptrCast([*]u32, slots) })
        const made = lzf.compress(&table, stream.items().pointer, 600, bytes.items().pointer, lzf.bound(600))
        allocator.free(slots, lzf.SLOTS * 4, 16)
        if made == 0 || !fuzz(LZF, bytes.items()[0..made], allocator, generator, one, two, room) { result = 177 }
    }
    const grown = turns.used(arena) - before
    if result == 0 && grown > 65536 {
        _ = std.io.eprint("arena grown by ")
        _ = std.io.writeUnsigned(std.io.stderr(), grown)
        _ = std.io.eprintln("")
        result = 178
    }
    png.free(&small)
    png.free(&shades)
    image_module.destroy(image)
    allocator.free(one, ROOM, 16)
    allocator.free(two, ROOM, 16)
    allocator.free(room, 8192, 16)
    return result
}

// A document written and read in each layered format, destroyed: the
// heap where it was.
fn heapRound(allocator: Allocator) -> bool {
    const image = makeDocument(allocator, true)
    var bytes = Bytes.init(allocator)
    defer bytes.deinit()
    var report: ora.Report = undefined
    const options = formats.saveOptions()
    var result: formats.LoadResult = undefined
    var ok = kra.write(image, &options, &bytes, &report) == formats.Status.ok && kra.read(allocator, bytes.items(), &result, &report) == formats.Status.ok
    if ok { image_module.destroy(result.image.?) }
    bytes.clearRetainingCapacity()
    ok = ok && ora.write(image, &options, &bytes, &report) == formats.Status.ok && ora.read(allocator, bytes.items(), &result, &report) == formats.Status.ok
    if ok { image_module.destroy(result.image.?) }
    bytes.clearRetainingCapacity()
    ok = ok && psd.write(image, &options, &bytes, &report) == formats.Status.ok && psd.read(allocator, bytes.items(), &result, &report) == formats.Status.ok
    if ok { image_module.destroy(result.image.?) }
    image_module.destroy(image)
    return ok
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var generator: random.Xoshiro256 = undefined
    random.seed(&generator, 43)
    var failed = testLzf(allocator, &generator)
    if failed != 0 { return failed }
    failed = testKra(allocator)
    if failed != 0 { return failed }
    failed = testOra(allocator)
    if failed != 0 { return failed }
    failed = testStack(allocator)
    if failed != 0 { return failed }
    failed = testPsd(allocator)
    if failed != 0 { return failed }
    failed = testGif(allocator)
    if failed != 0 { return failed }
    failed = testTiff(allocator)
    if failed != 0 { return failed }
    failed = testFiles(allocator)
    if failed != 0 { return failed }
    if !std.fs.removeTree(FOLDER.pointer) { return 169 }
    // The heap: once to fill what stays (tables, scratch blocks), then
    // where it was after each round.
    // (The scratch blocks given back each time: what they keep is theirs.)
    if !heapRound(allocator) { return 190 }
    scratch.trim(scratch.common())
    const live = std.heap.liveBytes()
    if !heapRound(allocator) { return 191 }
    scratch.trim(scratch.common())
    if std.heap.liveBytes() != live { return 191 }
    failed = testFuzz(allocator, &generator)
    if failed != 0 { return failed }
    if !heapRound(allocator) { return 192 }
    scratch.trim(scratch.common())
    if std.heap.liveBytes() != live { return 192 }
    return 13
}
