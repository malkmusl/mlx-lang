// nebula test 07: core/table.mlx. A constant table whose rows name other
// constant tables is, with a compiler that builds it at every read, built
// in the value arena when it is sliced at run time, the tables it names
// beside it (a compiler that keeps one image of it in the program's data,
// tests/483_constant_table_addresses_runtime.mlx, builds nothing); keep()
// copies the rows alone, a deep keep (filters/types.mlx's keepList) the
// tables they name too, and what both hand out stays where it is through
// the loop's turns either way.
//
// Exit 13: all well; otherwise the number of the first check that failed
// (counted from the top, 13 skipped).
const std = @import("std")
const turns = @import("std.turns")
const table = @import("../core/table.mlx")
const types = @import("../filters/types.mlx")
const registry = @import("../filters/registry.mlx")
const generators = @import("../generators/registry.mlx")
const scratch = @import("../core/scratch.mlx")

const Row = struct {
    name: []const u8
    values: []const u32
}

const FIRST = [3]u32{ 11, 12, 13 }
const SECOND = [2]u32{ 21, 22 }
const ROWS = [2]Row{
    Row.{ .name = "first", .values = FIRST[0..] },
    Row.{ .name = "second", .values = SECOND[0..] },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }
var keptDeep: table.Kept = table.Kept.{ .address = 0, .length = 0 }

fn deep(list: []const Row) -> []const Row {
    var bytes = table.room(Row, list.length)
    var index: usize = 0
    while index < list.length {
        bytes += table.room(u32, list[index].values.length)
        index += 1
    }
    var block = table.Block.{ .at = 0, .end = 0 }
    if !table.open(&block, bytes) { return list }
    const rows = table.put(Row, &block, list)
    index = 0
    while index < list.length {
        rows[index].values = table.put(u32, &block, list[index].values)[0..list[index].values.length]
        index += 1
    }
    return table.note(Row, &keptDeep, rows, list.length)
}

fn inside(address: usize, low: usize, high: usize) -> bool {
    return address >= low && address < high
}

pub fn main() -> u8 {
    // Everything below is first asked for inside a turn of a loop, as the
    // window's loop asks; what the turn releases is written over
    // (poison), so a value wrongly kept reads wrong.
    var loop: turns.Turns = undefined
    turns.begin(&loop, true, true)
    if loop.base == 0 { return 1 }
    const arena_end = turns.end(loop.base)

    // The tables a row names are where the rows are, side by side (both
    // in the arena, or both images in the program's data); the strings are
    // in the program's data.
    const sliced = ROWS[0..]
    const rows_at = @intFromPtr(&sliced[0])
    const values_at = @intFromPtr(&sliced[0].values[0])
    const apart = if values_at > rows_at { values_at - rows_at } else { rows_at - values_at }
    if apart > 4096 { return 2 }
    const name_at = @intFromPtr(&sliced[0].name[0])
    if inside(name_at, loop.base, arena_end) { return 3 }
    if inside(rows_at, loop.base, arena_end) != inside(values_at, loop.base, arena_end) { return 4 }

    // keep() copies the rows out of the arena; the tables they name stay
    // where the slicing for the call put them.
    const shallow = table.keep(Row, &kept, ROWS[0..])
    if kept.address == 0 || shallow.length != 2 { return 5 }
    if @intFromPtr(&shallow[0]) != kept.address || inside(kept.address, loop.base, arena_end) { return 6 }
    if shallow[1].values[1] != 22 { return 7 }

    // The deep keep puts the tables in its own block, right after the
    // rows, with the same numbers.
    const copied = deep(ROWS[0..])
    if keptDeep.address == 0 || copied.length != 2 { return 8 }
    const block_low = keptDeep.address
    const block_high = block_low + table.room(Row, 2) + table.room(u32, 3) + table.room(u32, 2)
    if !inside(@intFromPtr(&copied[0].values[0]), block_low, block_high) { return 9 }
    if !inside(@intFromPtr(&copied[1].values[1]), block_low, block_high) { return 10 }
    if inside(block_low, loop.base, arena_end) { return 11 }
    if copied[0].values[2] != 13 || copied[1].values[0] != 21 || copied[1].values.length != 2 { return 12 }

    // room() keeps every piece aligned to 16 bytes.
    if table.room(u32, 3) != 16 || table.room(u32, 5) != 32 || table.room(u8, 0) != 0 { return 14 }
    if @intFromPtr(&copied[1].values[0]) % 16 != 0 { return 15 }

    // Through several turns of the loop (the arena given back each
    // time, and written over by what the next turn builds), the deep copy
    // and every filter's and generator's list of numbers still read the
    // same.
    const filters = registry.count()
    if filters == 0 { return 16 }
    var before: f64 = 0.0
    var index: usize = 0
    while index < filters {
        const info = registry.at(index).?
        var at: usize = 0
        while at < info.*.params.length {
            before += info.*.params[at].initial + info.*.params[at].high
            at += 1
        }
        index += 1
    }
    var generated: f64 = 0.0
    const made = generators.list()
    index = 0
    while index < made.length {
        var at: usize = 0
        while at < made[index].params.length {
            generated += made[index].params[at].initial + made[index].params[at].high
            at += 1
        }
        index += 1
    }
    var turn: usize = 0
    while turn < 3 {
        turns.turn(&loop)
        // Something new in the arena where the old copies were.
        const again = ROWS[0..]
        if again[0].values[0] != 11 { return 17 }
        turn += 1
    }
    if copied[0].values[0] != 11 || copied[1].values[1] != 22 { return 18 }
    var after: f64 = 0.0
    index = 0
    while index < filters {
        const info = registry.at(index).?
        var at: usize = 0
        while at < info.*.params.length {
            after += info.*.params[at].initial + info.*.params[at].high
            at += 1
        }
        index += 1
    }
    if after != before { return 19 }
    var generated_after: f64 = 0.0
    const made_again = generators.list()
    index = 0
    while index < made_again.length {
        var at: usize = 0
        while at < made_again[index].params.length {
            generated_after += made_again[index].params[at].initial + made_again[index].params[at].high
            at += 1
        }
        index += 1
    }
    if generated_after != generated || @intFromPtr(&made_again[0]) != @intFromPtr(&made[0]) { return 20 }

    // scratch.common() is always a pool, the same one each time.
    const pool = scratch.common()
    if @intFromPtr(pool) != @intFromPtr(scratch.common()) { return 21 }
    return 13
}
