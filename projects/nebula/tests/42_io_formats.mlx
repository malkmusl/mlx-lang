// placeholder while writing
const std = @import("std")
const png = @import("../io/png.mlx")

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    var list = std.ArrayList(u8).init(allocator)
    defer list.deinit()
    var pixels: [6]u32 = [6]u32{ 0xFF102030, 0x01FF0000, 0xFE00FF00, 0, 0x80123456, 0xFFFFFFFF }
    if !png.encode(&pixels, 3, 2, 3, true, &list) { return 1 }
    var picture: png.Picture = undefined
    if png.decode(list.items(), allocator, &picture) != png.Status.ok { return 2 }
    if picture.width != 3 || picture.height != 2 { return 3 }
    var i: usize = 0
    while i < 6 {
        if picture.pixels[i] != pixels[i] { return 4 }
        i += 1
    }
    png.free(&picture)
    return 13
}
