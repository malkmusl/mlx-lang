// nebula's shape tools (tools/shapes.mlx) on a headless App at 1024 x 768,
// driven by scripts in the window's pixels: the seven tools are listed;
// the options' defaults come from the brush; a rectangle dragged without
// anti-aliasing fills exactly the pixels from the one pressed to the one
// let go (across tile borders), in the foreground colour; an outline alone
// is a frame of its width inside them; Shift makes a square, Alt grows it
// from the middle; a drag that starts outside the image paints only the
// image's part, a click paints nothing; an ellipse covers pi a b (counted
// without anti-aliasing, summed with it); a polygon by clicks and Enter,
// by a double click, and with Backspace taking a corner back; a polyline
// is not closed (inside its triangle the layer stays empty); a Bézier
// curve passes through its anchors and bends by a dragged handle; a star
// of 5 tips (its tips, its inner corners, its area); a freehand path
// closed and filled, and open, and its jitter smoothed away by the option
// (by the way gone, not by the points); every shape is one step of the
// history with its name, undo puts the layer back exactly and redo again;
// Escape while dragging or with a polygon half made leaves nothing; the
// outline shown while dragging is in the window's pixels and gone
// afterwards; a selection clips the shape; a locked layer is not painted;
// opacity; the brush's outline is soft, and led only where the image is
// when the shape begins a hundred thousand pixels away; the options kept
// in the settings and read back; the options panel at 1024 x 768 in
// English and German, dark and light, a click on it changing an option; no
// growth of the value arena over many shapes. Then the edges, on a new
// image: Shift or Alt let go before a drag does not count for it; Space
// moves a shape being dragged; Shift holds a polygon's side level, and the
// preview's line to the pointer with it; Escape mid freehand path and mid
// curve handle; too little of a shape (a double click, one anchor, every
// corner taken back, corners on one line) paints nothing; a closed curve;
// a gesture on one image neither shows on another nor keeps it busy;
// shapes one pixel wide and high, the same drag twice, a layer whose
// device was moved, a change already open, a drag all outside the image,
// a billion pixels each way (and the size shown of it), tips out of range,
// Shift on a star's angle, a foreground of alpha 0 and of half alpha,
// opacity 0 (no step); undo and redo exact over the layer's own pixels
// (multiplied, dashed, by the brush); a selection of half strength, one
// of everything but a hole, a locked alpha; the eraser's mode; a zoomed
// and a mirrored view; a rectangle's fill inside an outline's round or
// bevelled corners; the area of round corners, of an outline along an
// ellipse, of dashes and dots; a freehand path of more motions than it
// keeps points (the arena as it was); options read from a tampered text;
// the panel in a layout pass, too narrow, at twice the scale, its width
// settable where an open shape is drawn by its outline; heap memory given
// back. Pictures: shapes.png (and others) here and, when NEBULA_SHOTS
// names a directory, there too. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const png = @import("std.png")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const settings = @import("../app/settings.mlx")
const brushes = @import("../app/brushes.mlx")
const shapes = @import("../tools/shapes.mlx")
const tools = @import("../tools/registry.mlx")
const kit_module = @import("../ui/kit.mlx")
const viewport = @import("../ui/viewport.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const raster = @import("../core/raster.mlx")
const ops = @import("../core/ops.mlx")
const blend = @import("../core/blend.mlx")
const image_module = @import("../core/image.mlx")

const App = state.App
const Canvas = canvas_module.Canvas

const ROOM: usize = 8192
const BLUE: u32 = 0xFF2040C0

// Where pictures go besides the current directory ("": nowhere).
var shotDir: [512]u8 = undefined
var shotDirLength: usize = 0

// A script being written: bytes in heap memory.
const Builder = struct {
    bytes: [*]u8
    length: usize
}

fn put(b: *Builder, text: []const u8) -> void {
    b.*.length = std.text.append(b.*.bytes, b.*.length, ROOM, text)
}

fn number(b: *Builder, value: i32) -> void {
    b.*.length = std.text.appendSigned(b.*.bytes, b.*.length, ROOM, @intCast(isize, value))
}

// The window pixel whose middle lies in image pixel (x, y).
fn windowOf(app: *App, x: i32, y: i32, wx: *i32, wy: *i32) -> void {
    const doc = api.document(app).?
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    viewport.toWindow(&doc.*.view, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &fx, &fy)
    wx.* = @intFromFloat(i32, @floor(fx))
    wy.* = @intFromFloat(i32, @floor(fy))
    var ix: f64 = 0.0
    var iy: f64 = 0.0
    viewport.toImage(&doc.*.view, @floatFromInt(f64, wx.*) + 0.5, @floatFromInt(f64, wy.*) + 0.5, &ix, &iy)
    if @floor(ix) != @floatFromInt(f64, x) { wx.* -= 1 }
    if @floor(iy) != @floatFromInt(f64, y) { wy.* -= 1 }
}

// " WX WY" of image pixel (x, y).
fn place(b: *Builder, app: *App, x: i32, y: i32) -> void {
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, x, y, &wx, &wy)
    put(b, " ")
    number(b, wx)
    put(b, " ")
    number(b, wy)
}

fn play(app: *App, b: *Builder) -> bool {
    const done = script.run(app, b.*.bytes[0..b.*.length])
    b.*.length = 0
    return done
}

fn drag(app: *App, b: *Builder, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    put(b, "drag")
    place(b, app, x0, y0)
    place(b, app, x1, y1)
    put(b, " 8\n")
    return play(app, b)
}

fn click(app: *App, b: *Builder, x: i32, y: i32) -> bool {
    put(b, "click")
    place(b, app, x, y)
    put(b, "\n")
    return play(app, b)
}

fn pointer(b: *Builder, app: *App, x: i32, y: i32) -> void {
    put(b, "pointer")
    place(b, app, x, y)
    put(b, "\n")
}

fn layer(app: *App) -> *device.Device {
    return api.activeNode(app).?.*.device.?
}

fn at(app: *App, x: i32, y: i32) -> u32 {
    return device.pixel(layer(app), x, y)
}

fn painted(app: *App, x: i32, y: i32) -> bool { return at(app, x, y) >> 24 != 0 }

// How many pixels of `area` of the layer hold something, and their alpha
// together.
fn count(app: *App, area: geom.Rect) -> usize {
    var total: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if painted(app, x, y) { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

fn alphaSum(app: *App, area: geom.Rect) -> usize {
    var total: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            total += @intCast(usize, at(app, x, y) >> 24)
            x += 1
        }
        y += 1
    }
    return total
}

fn wholeImage() -> geom.Rect { return geom.rect(-20, -20, 440, 340) }

fn historyOf(app: *App) -> *history.History { return api.image(app).?.*.history }

fn steps(app: *App) -> usize { return history.stepsDone(historyOf(app)) }

fn lastStep(app: *App, name: []const u8) -> bool { return std.text.same(history.undoName(historyOf(app)), name) }

fn busy(app: *App) -> bool { return api.toolBusy(app) }

fn undo(app: *App) -> bool { return script.run(app, "key Ctrl+Z\n") }

fn useTool(app: *App, key: []const u8) -> bool {
    const tool = tools.byKey(key)
    if tool == null { return false }
    api.setTool(app, tool.?.*.id)
    return app.*.tool == tool.?.*.id
}

// Not white in the frame's pixels of `area` (window pixels): the marks
// drawn over the white image.
fn marked(app: *App, area: ui.Rect) -> usize {
    const frame = script.frameOf(app).?
    var total: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)] | 0xFF000000 != 0xFFFFFFFF { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

// The window's rectangle over image pixels (x, y) to (x + width, y + height).
fn windowArea(app: *App, x: i32, y: i32, width: i32, height: i32) -> ui.Rect {
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, x, y, &wx, &wy)
    return ui.rect(wx, wy, width, height)
}

// A picture saved by a script step in the current directory and in
// NEBULA_SHOTS.
fn shoot(app: *App, b: *Builder, name: []const u8) -> bool {
    put(b, "shot ")
    put(b, name)
    put(b, "\n")
    if shotDirLength > 0 {
        const dir: [*]const u8 = &shotDir
        put(b, "shot ")
        put(b, dir[0..shotDirLength])
        put(b, "/")
        put(b, name)
        put(b, "\n")
    }
    return play(app, b)
}

fn savePicture(canvas: *Canvas, name: []const u8, allocator: std.allocator.Allocator) -> bool {
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 600, name)
    if !png.saveFile(std.text.zeroTerminated(bytes, 600, bytes[0..length]), canvas.*.pixels, canvas.*.width, canvas.*.height, canvas.*.stride, false, allocator) { return false }
    if shotDirLength == 0 { return true }
    const dir: [*]const u8 = &shotDir
    length = std.text.append(bytes, 0, 600, dir[0..shotDirLength])
    length = std.text.append(bytes, length, 600, "/")
    length = std.text.append(bytes, length, 600, name)
    return png.saveFile(std.text.zeroTerminated(bytes, 600, bytes[0..length]), canvas.*.pixels, canvas.*.width, canvas.*.height, canvas.*.stride, false, allocator)
}

// One frame of the options panels of three tools side by side on
// `canvas`, in docker-sized areas (what the Tool Options docker hands
// them). The tallest panel's height.
fn panels(app: *App, canvas: *Canvas, first: u8, second: u8, third: u8) -> i32 {
    const widgets = state.uiOf(app)
    const kit = api.kit(app)
    const theme = state.themeOf(app)
    canvas_module.clear(canvas, theme.*.background)
    view.begin(widgets, canvas)
    kit_module.resize(kit, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height))
    kit_module.begin(kit, widgets, canvas, theme, state.bodyOf(app), state.smallOf(app), state.monoOf(app), 5000, app.*.german)
    const before = app.*.tool
    var tallest: i32 = 0
    var index: usize = 0
    while index < 3 {
        app.*.tool = if index == 0 { first } else if index == 1 { second } else { third }
        const area = ui.rect(24 + @intCast(i32, index) * 330, 40, 280, 640)
        canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, theme.*.panel)
        const tool = tools.find(app.*.tool).?
        const height = tool.*.options.?(app, area)
        if height > tallest { tallest = height }
        index += 1
    }
    app.*.tool = before
    _ = kit_module.end(kit)
    _ = view.end(widgets)
    return tallest
}

// One frame of one tool's options panel at (24, 40), 280 x 640 (the
// panels side by side share their widgets' ids: a drag on one would move
// the others' too).
fn onePanel(app: *App, canvas: *Canvas, id: u8) -> void {
    const widgets = state.uiOf(app)
    const kit = api.kit(app)
    const theme = state.themeOf(app)
    canvas_module.clear(canvas, theme.*.background)
    view.begin(widgets, canvas)
    kit_module.resize(kit, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height))
    kit_module.begin(kit, widgets, canvas, theme, state.bodyOf(app), state.smallOf(app), state.monoOf(app), 5000, app.*.german)
    const before = app.*.tool
    app.*.tool = id
    _ = tools.find(id).?.*.options.?(app, ui.rect(24, 40, 280, 640))
    app.*.tool = before
    _ = kit_module.end(kit)
    _ = view.end(widgets)
}

// What differs from the panel's colour in a panel's area: what it drew.
fn drawnIn(canvas: *Canvas, area: ui.Rect, ground: u32) -> usize {
    var total: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)] != ground { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

fn inputAt(app: *App, x: f64, y: f64, button: u32, into: *state.Input) -> void {
    into.*.x = x
    into.*.y = y
    into.*.windowX = 0
    into.*.windowY = 0
    into.*.pressure = 1.0
    into.*.tiltX = 0.0
    into.*.tiltY = 0.0
    into.*.rotation = 0.0
    into.*.time = 0.0
    into.*.button = button
    into.*.buttons = if button != 0 { state.BUTTONS_LEFT } else { 0 }
    into.*.modifiers = 0
    into.*.clicks = 1
}

// Shapes made by calling the tools themselves (no script around them):
// `rounds` rectangles with a brush's outline, ellipses, stars, polygons
// and freehand paths, each undone again.
fn many(app: *App, rounds: usize) -> bool {
    var input: state.Input = undefined
    var round: usize = 0
    while round < rounds {
        var which: usize = 0
        while which < 5 {
            const id = if which == 0 { shapes.RECTANGLE } else if which == 1 { shapes.ELLIPSE } else if which == 2 { shapes.STAR } else if which == 3 { shapes.POLYGON } else { shapes.FREEHAND_PATH }
            api.setTool(app, id)
            const tool = tools.find(id).?
            const before = steps(app)
            inputAt(app, 60.5, 70.5, ui_app.BUTTON_LEFT, &input)
            tool.*.press.?(app, &input)
            inputAt(app, 120.5, 90.5, 0, &input)
            tool.*.move.?(app, &input)
            inputAt(app, 160.5, 150.5, 0, &input)
            tool.*.move.?(app, &input)
            inputAt(app, 160.5, 150.5, ui_app.BUTTON_LEFT, &input)
            tool.*.release.?(app, &input)
            if id == shapes.POLYGON {
                // (The press dragged placed the first corner where it
                // was let go; two more clicks, then Enter.)
                inputAt(app, 200.5, 60.5, ui_app.BUTTON_LEFT, &input)
                tool.*.press.?(app, &input)
                tool.*.release.?(app, &input)
                inputAt(app, 90.5, 200.5, ui_app.BUTTON_LEFT, &input)
                tool.*.press.?(app, &input)
                tool.*.release.?(app, &input)
                tool.*.finish.?(app)
            }
            if steps(app) != before + 1 { return false }
            api.undo(app)
            which += 1
        }
        round += 1
    }
    return true
}

// A freehand path along a zigzag (8 pixels high, 2 pixels a step) drawn
// by the tool's own functions, smoothed by `smoothing`: how many pixels
// of its middle part lie 3 or more pixels off the zigzag's middle line.
fn zigzag(app: *App, smoothing: f64) -> usize {
    const o = shapes.optionsOf(app).?
    o.*.smoothing = smoothing
    api.setTool(app, shapes.FREEHAND_PATH)
    const tool = tools.find(shapes.FREEHAND_PATH).?
    var input: state.Input = undefined
    inputAt(app, 100.5, 146.5, ui_app.BUTTON_LEFT, &input)
    tool.*.press.?(app, &input)
    var step: usize = 1
    while step <= 100 {
        inputAt(app, 100.5 + @floatFromInt(f64, step) * 2.0, if step & 1 == 1 { 154.5 } else { 146.5 }, 0, &input)
        tool.*.move.?(app, &input)
        step += 1
    }
    input.button = ui_app.BUTTON_LEFT
    tool.*.release.?(app, &input)
    return count(app, geom.rect(140, 140, 120, 8)) + count(app, geom.rect(140, 153, 120, 8))
}

// A rectangle from far outside the image (a hundred thousand pixels up
// and left) to (200, 150), made by the tool's own functions.
fn farRectangle(app: *App) -> bool {
    api.setTool(app, shapes.RECTANGLE)
    const tool = tools.find(shapes.RECTANGLE).?
    var input: state.Input = undefined
    inputAt(app, -100000.5, -100000.5, ui_app.BUTTON_LEFT, &input)
    tool.*.press.?(app, &input)
    inputAt(app, 200.5, 150.5, ui_app.BUTTON_LEFT, &input)
    tool.*.release.?(app, &input)
    return !api.toolBusy(app)
}

// ---------------------------------------------------------------------------
// The edges: each check's number is what main returns when it fails.

// The layer's pixels of `area` folded into one number (each times its
// place, wrapping): two sums differ when the pixels do, but by chance.
fn checksum(app: *App, area: geom.Rect) -> u64 {
    var total: u64 = 0
    var weight: u64 = 1
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            total = total +% @intCast(u64, at(app, x, y)) *% weight
            weight += 1
            x += 1
        }
        y += 1
    }
    return total
}

// Pixels of `area` of the layer that are exactly `color`.
fn exactly(app: *App, area: geom.Rect, color: u32) -> usize {
    var total: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if at(app, x, y) == color { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

// The options of a plain shape: filled in the foreground colour, no
// outline, hard edges, at full strength.
fn plain(o: *shapes.Options) -> void {
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_NONE
    o.*.width = 4.0
    o.*.join = @intCast(usize, raster.JOIN_MITER)
    o.*.cap = @intCast(usize, raster.CAP_BUTT)
    o.*.dashes = shapes.DASH_SOLID
    o.*.useBrush = false
    o.*.antialias = false
    o.*.opacity = 100.0
    o.*.mode = blend.NORMAL
    o.*.radius = 0.0
    o.*.tips = 5.0
    o.*.ratio = 50.0
    o.*.smoothing = 30.0
}

// The tool in use pressed, moved and let go at image places, called
// directly (no window around it).
fn pressAt(app: *App, x: f64, y: f64) -> void {
    var input: state.Input = undefined
    inputAt(app, x, y, ui_app.BUTTON_LEFT, &input)
    api.tool(app).?.*.press.?(app, &input)
}

fn moveAt(app: *App, x: f64, y: f64) -> void {
    var input: state.Input = undefined
    inputAt(app, x, y, 0, &input)
    api.tool(app).?.*.move.?(app, &input)
}

fn releaseAt(app: *App, x: f64, y: f64) -> void {
    var input: state.Input = undefined
    inputAt(app, x, y, ui_app.BUTTON_LEFT, &input)
    api.tool(app).?.*.release.?(app, &input)
}

// A freehand path round and round a circle of radius 100 about
// (200.5, 150.5), a pixel a motion, `motions` of them.
// (One Input for all: a record whose address is handed on is taken from
// the value arena at every call.)
fn circling(app: *App, motions: usize) -> void {
    api.setTool(app, shapes.FREEHAND_PATH)
    const tool = tools.find(shapes.FREEHAND_PATH).?
    var input: state.Input = undefined
    inputAt(app, 300.5, 150.5, ui_app.BUTTON_LEFT, &input)
    tool.*.press.?(app, &input)
    input.button = 0
    var step: usize = 1
    while step <= motions {
        const angle = @floatFromInt(f64, step) * 0.0101
        input.x = 200.5 + 100.0 * math.cos(angle)
        input.y = 150.5 + 100.0 * math.sin(angle)
        tool.*.move.?(app, &input)
        step += 1
    }
    input.button = ui_app.BUTTON_LEFT
    tool.*.release.?(app, &input)
}

// What the pointer and the keys do between and during gestures.
fn gestures(app: *App, b: *Builder, o: *shapes.Options) -> u8 {
    if !script.run(app, "new 400 300 FFFFFF\ncolor 2040C0\nbackground F2C14E\n") { return 130 }
    plain(o)
    if !useTool(app, "rectangle") || steps(app) != 0 || count(app, wholeImage()) != 0 { return 131 }

    // Shift let go after one drag: the next is no square (the window's
    // loop keeps a modifier's bit after the key's release until another
    // key comes).
    if !script.run(app, "down Shift\n") || !drag(app, b, 60, 60, 100, 80) || !script.run(app, "up Shift\n") || count(app, wholeImage()) != 41 * 41 { return 132 }
    if !drag(app, b, 200, 60, 240, 80) || count(app, geom.rect(190, 50, 70, 70)) != 41 * 21 || painted(app, 220, 90) { return 133 }
    if !undo(app) || !undo(app) || count(app, wholeImage()) != 0 { return 134 }
    // The same for Alt.
    if !script.run(app, "down Alt\n") || !drag(app, b, 100, 100, 110, 105) || !script.run(app, "up Alt\n") || count(app, wholeImage()) != 21 * 11 { return 135 }
    if !script.run(app, "key Escape\n") || !drag(app, b, 200, 100, 210, 105) || count(app, geom.rect(180, 90, 50, 30)) != 11 * 6 || painted(app, 199, 100) { return 136 }
    if !undo(app) || !undo(app) || count(app, wholeImage()) != 0 { return 137 }

    // Space held while dragging moves the shape: pressed at (50, 40),
    // dragged to (100, 80), then moved by (30, 10) with Space down and
    // let go there: (80, 50) to (130, 90).
    put(b, "pointer")
    place(b, app, 50, 40)
    put(b, "\npress\n")
    pointer(b, app, 100, 80)
    put(b, "down Space\n")
    pointer(b, app, 115, 85)
    pointer(b, app, 130, 90)
    put(b, "up Space\nrelease\n")
    if !play(app, b) || steps(app) != 1 || busy(app) { return 138 }
    if count(app, wholeImage()) != 51 * 41 || !painted(app, 80, 50) || painted(app, 79, 50) || painted(app, 80, 49) || !painted(app, 130, 90) || painted(app, 131, 90) || painted(app, 130, 91) { return 139 }
    if !undo(app) { return 140 }

    // A polygon's side placed with Shift held goes level: from (100, 100)
    // towards (200, 108) is along the row (the corner at (200, 100)).
    if !useTool(app, "polygon") || !click(app, b, 100, 100) || !script.run(app, "down Shift\n") || !click(app, b, 200, 108) || !script.run(app, "up Shift\n") { return 141 }
    // (The line on to the pointer shows where a click with Shift would
    // put the corner: level from the last one.)
    if !click(app, b, 150, 200) || !script.run(app, "key Enter\n") || steps(app) != 1 || busy(app) { return 142 }
    if !painted(app, 180, 102) || !painted(app, 120, 101) || painted(app, 180, 99) || !undo(app) { return 143 }
    if !click(app, b, 100, 100) || !click(app, b, 200, 100) { return 144 }
    put(b, "down Shift\n")
    pointer(b, app, 260, 104)
    put(b, "shot shapes-snapped.png\n")
    if !play(app, b) { return 145 }
    // The preview's line to the pointer lies on row 100 (snapped), not on
    // the way to (260, 104) (the pointer's own cross is right of 248).
    if marked(app, windowArea(app, 228, 102, 18, 3)) != 0 || marked(app, windowArea(app, 228, 99, 18, 3)) < 18 { return 146 }
    if !script.run(app, "up Shift\nkey Escape\n") || busy(app) || steps(app) != 0 { return 147 }

    // Escape in the middle of a freehand path and of a curve's handle:
    // nothing.
    if !useTool(app, "freehandpath") { return 148 }
    put(b, "pointer")
    place(b, app, 100, 100)
    put(b, "\npress\n")
    pointer(b, app, 150, 90)
    pointer(b, app, 200, 150)
    put(b, "key Escape\n")
    pointer(b, app, 150, 200)
    put(b, "release\n")
    if !play(app, b) || busy(app) || steps(app) != 0 || count(app, wholeImage()) != 0 { return 149 }
    if !useTool(app, "bezier") || !click(app, b, 50, 200) { return 150 }
    put(b, "pointer")
    place(b, app, 200, 80)
    put(b, "\npress\n")
    pointer(b, app, 260, 80)
    put(b, "key Escape\nrelease\n")
    if !play(app, b) || busy(app) || steps(app) != 0 || count(app, wholeImage()) != 0 { return 151 }

    // Too little of a shape: a polygon by a double click on its first
    // corner, a curve of one anchor, a polygon whose corners were all
    // taken back (Backspace twice: the second ends it); none paints.
    if !useTool(app, "polygon") || !click(app, b, 50, 50) || !click(app, b, 50, 50) || busy(app) || steps(app) != 0 { return 152 }
    if !useTool(app, "bezier") || !click(app, b, 50, 50) || !script.run(app, "key Enter\n") || busy(app) || steps(app) != 0 { return 153 }
    if !useTool(app, "polygon") || !click(app, b, 50, 50) || !click(app, b, 150, 60) || !script.run(app, "key Backspace\nkey Backspace\n") || busy(app) || steps(app) != 0 || count(app, wholeImage()) != 0 { return 154 }
    // Corners on one line: no inside, nothing filled and no step; with an
    // outline, its line.
    if !click(app, b, 50, 50) || !click(app, b, 150, 50) || !click(app, b, 250, 50) || !script.run(app, "key Enter\n") || busy(app) || steps(app) != 0 || count(app, wholeImage()) != 0 { return 155 }
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 3.0
    if !click(app, b, 50, 50) || !click(app, b, 150, 50) || !click(app, b, 250, 50) || !script.run(app, "key Enter\n") || steps(app) != 1 || !painted(app, 100, 50) || painted(app, 100, 54) || !undo(app) { return 156 }
    plain(o)

    // A curve closed by a click on its first anchor (all clicks: straight
    // sides) is the triangle filled: 9000 pixels, its middle painted.
    if !useTool(app, "bezier") || !click(app, b, 100, 100) || !click(app, b, 250, 100) || !click(app, b, 175, 220) || !click(app, b, 100, 100) || busy(app) || steps(app) != 1 { return 157 }
    const triangle = @floatFromInt(f64, count(app, wholeImage()))
    if triangle < 9000.0 * 0.98 || triangle > 9000.0 * 1.02 || !painted(app, 175, 140) || !undo(app) { return 158 }

    // A gesture on one document does not show on another, nor keep it
    // busy; a press there starts afresh.
    if !useTool(app, "polygon") || !click(app, b, 50, 50) || !click(app, b, 250, 60) || !busy(app) { return 159 }
    if !script.run(app, "new 400 300 FFFFFF\n") || !shoot(app, b, "shapes-other-document.png") { return 160 }
    if marked(app, windowArea(app, 60, 50, 180, 14)) != 0 || busy(app) || steps(app) != 0 { return 161 }
    if !click(app, b, 50, 150) || !click(app, b, 250, 160) || !click(app, b, 150, 250) || !script.run(app, "key Enter\n") || steps(app) != 1 || !painted(app, 150, 180) || painted(app, 150, 60) || !undo(app) { return 162 }
    return 0
}

// Sizes, places and colours at their edges.
fn edges(app: *App, b: *Builder, o: *shapes.Options) -> u8 {
    plain(o)
    if !useTool(app, "rectangle") || steps(app) != 0 { return 170 }
    // One pixel wide, one pixel high; an outline wider than that fills it.
    if !drag(app, b, 70, 40, 70, 99) || count(app, wholeImage()) != 60 || !painted(app, 70, 40) || !painted(app, 70, 99) || painted(app, 71, 50) || painted(app, 69, 50) || !undo(app) { return 171 }
    if !drag(app, b, 50, 70, 149, 70) || count(app, wholeImage()) != 100 || painted(app, 100, 69) || painted(app, 100, 71) || !undo(app) { return 172 }
    o.*.fill = shapes.PAINT_NONE
    o.*.outline = shapes.PAINT_FOREGROUND
    if !drag(app, b, 70, 40, 70, 99) || count(app, wholeImage()) != 60 || !undo(app) { return 173 }
    plain(o)
    if !useTool(app, "ellipse") || !drag(app, b, 70, 40, 70, 99) || count(app, wholeImage()) < 58 || count(app, wholeImage()) > 60 || painted(app, 71, 70) || !undo(app) { return 174 }

    // The same drag twice: two steps, undone one by one.
    if !useTool(app, "rectangle") || !drag(app, b, 50, 40, 149, 99) || !drag(app, b, 50, 40, 149, 99) || steps(app) != 2 || count(app, wholeImage()) != 6000 { return 175 }
    if !undo(app) || count(app, wholeImage()) != 6000 || !undo(app) || count(app, wholeImage()) != 0 { return 176 }

    // A layer whose pixels were moved (its device not at the origin): the
    // shape lands where the image's pixels are, over tile borders.
    device.moveTo(layer(app), -37, 23)
    if !drag(app, b, 60, 60, 130, 70) || count(app, wholeImage()) != 71 * 11 || !painted(app, 60, 60) || !painted(app, 64, 64) || !painted(app, 128, 70) || painted(app, 59, 60) || painted(app, 131, 70) || painted(app, 100, 71) { return 177 }
    if !undo(app) || count(app, wholeImage()) != 0 { return 178 }
    device.moveTo(layer(app), 0, 0)

    // A change of the layer already open: the shape still is one step.
    device.begin(layer(app))
    if !drag(app, b, 50, 40, 149, 99) || steps(app) != 1 || count(app, wholeImage()) != 6000 || !undo(app) || count(app, wholeImage()) != 0 { return 179 }

    // All outside the image: nothing, no step.
    if !drag(app, b, -50, -50, -10, -10) || steps(app) != 0 || count(app, geom.rect(-64, -64, 528, 428)) != 0 || busy(app) || api.activeNode(app).?.*.overlay != null { return 180 }

    // A billion pixels each way: the image filled, nothing made outside
    // it; its outline alone lies outside: nothing, no step.
    api.setTool(app, shapes.RECTANGLE)
    pressAt(app, -1.0e9, -1.0e9)
    moveAt(app, 1.0e9, 1.0e9)
    if !shoot(app, b, "shapes-huge.png") || !busy(app) { return 181 }
    releaseAt(app, 1.0e9, 1.0e9)
    if steps(app) != 1 || busy(app) || count(app, geom.rect(-64, -64, 528, 428)) != 400 * 300 { return 182 }
    const reached = device.extent(layer(app))
    if reached.x < 0 || reached.y < 0 || reached.x + reached.width > 448 || reached.y + reached.height > 320 || !undo(app) { return 183 }
    api.setTool(app, shapes.ELLIPSE)
    pressAt(app, -1.0e9, -1.0e9)
    releaseAt(app, 1.0e9, 1.0e9)
    if steps(app) != 1 || count(app, geom.rect(-64, -64, 528, 428)) != 400 * 300 || !undo(app) { return 184 }
    api.setTool(app, shapes.STAR)
    pressAt(app, 200.5, 150.5)
    releaseAt(app, 200.5, -1.0e9)
    if steps(app) != 1 || count(app, geom.rect(-64, -64, 528, 428)) != 400 * 300 || !undo(app) { return 185 }
    o.*.fill = shapes.PAINT_NONE
    o.*.outline = shapes.PAINT_FOREGROUND
    api.setTool(app, shapes.RECTANGLE)
    pressAt(app, -1.0e9, -1.0e9)
    releaseAt(app, 1.0e9, 1.0e9)
    if steps(app) != 0 || busy(app) || count(app, wholeImage()) != 0 { return 186 }
    plain(o)

    // Tips out of range are held to 3..20: a star of 20 (tips set to a
    // trillion) covers 20 R r sin(9 degrees), one of 3 (tips not a
    // number... below 3) 3 R r sin(60 degrees).
    if !useTool(app, "star") { return 187 }
    o.*.tips = 1.0e12
    if !drag(app, b, 200, 150, 200, 90) { return 188 }
    var pixels = @floatFromInt(f64, count(app, wholeImage()))
    const twenty = 20.0 * 60.0 * 30.0 * math.sin(math.pi / 20.0)
    if pixels < twenty * 0.97 || pixels > twenty * 1.03 || !undo(app) { return 189 }
    o.*.tips = -7.0
    o.*.ratio = 20.0
    if !drag(app, b, 200, 150, 200, 90) { return 190 }
    pixels = @floatFromInt(f64, count(app, wholeImage()))
    const three = 3.0 * 60.0 * 12.0 * math.sin(math.pi / 3.0)
    if pixels < three * 0.96 || pixels > three * 1.04 || !undo(app) { return 191 }
    plain(o)
    // Shift turns the first tip in steps of 15 degrees: dragged to
    // (260, 140) its tip points 15 degrees above the row (not 9.5).
    if !script.run(app, "down Shift\n") || !drag(app, b, 200, 150, 260, 140) || !script.run(app, "up Shift\nkey Escape\n") { return 192 }
    if !painted(app, 253, 136) || painted(app, 254, 141) || !undo(app) { return 193 }
    if !drag(app, b, 200, 150, 260, 140) || painted(app, 253, 136) || !painted(app, 254, 141) || !undo(app) { return 194 }

    // A foreground of alpha 0 paints nothing (and makes no step); filled
    // with it and outlined in the background colour, only the frame.
    if !useTool(app, "rectangle") { return 195 }
    const foreground = app.*.foreground
    app.*.foreground = 0x00102030
    if !drag(app, b, 50, 40, 149, 99) || steps(app) != 0 || count(app, wholeImage()) != 0 { return 196 }
    o.*.outline = shapes.PAINT_BACKGROUND
    if !drag(app, b, 50, 40, 149, 99) || steps(app) != 1 || count(app, wholeImage()) != 6000 - 92 * 52 || exactly(app, wholeImage(), 0xFFF2C14E) != 6000 - 92 * 52 || !undo(app) { return 197 }
    // Half alpha at full opacity: the colour as it is.
    app.*.foreground = 0x80FF0000
    o.*.outline = shapes.PAINT_NONE
    if !drag(app, b, 50, 40, 149, 99) || exactly(app, wholeImage(), 0x80FF0000) != 6000 || !undo(app) { return 198 }
    app.*.foreground = foreground
    // Opacity 0: nothing to see.
    o.*.opacity = 0.0
    if !drag(app, b, 50, 40, 149, 99) || count(app, wholeImage()) != 0 { return 199 }
    if steps(app) != 0 { return 200 }
    plain(o)
    return 0
}

// What the shape is painted over and through: the layer's own pixels,
// a soft selection, a locked alpha.
fn over(app: *App, b: *Builder, o: *shapes.Options) -> u8 {
    plain(o)
    if !useTool(app, "rectangle") || steps(app) != 0 { return 201 }
    // Undo puts back exactly what was there, redo exactly the shape: an
    // ellipse with a dashed outline multiplied at 60 % over a rectangle;
    // a polygon outlined by the brush.
    if !drag(app, b, 30, 30, 229, 169) || steps(app) != 1 { return 202 }
    const whole = geom.rect(-16, -16, 432, 332)
    const plainSum = checksum(app, whole)
    o.*.antialias = true
    o.*.fill = shapes.PAINT_BACKGROUND
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 5.0
    o.*.dashes = shapes.DASH_DASH_DOT
    o.*.opacity = 60.0
    o.*.mode = blend.MULTIPLY
    if !script.run(app, "color B23A48\n") || !useTool(app, "ellipse") || !drag(app, b, 120, 80, 319, 239) || steps(app) != 2 || !lastStep(app, "Ellipse") { return 203 }
    const drawnSum = checksum(app, whole)
    if drawnSum == plainSum || !undo(app) || checksum(app, whole) != plainSum { return 204 }
    if !script.run(app, "key Ctrl+Shift+Z\n") || checksum(app, whole) != drawnSum || steps(app) != 2 || !undo(app) { return 205 }
    o.*.mode = blend.NORMAL
    o.*.opacity = 100.0
    o.*.useBrush = true
    if !useTool(app, "polygon") || !click(app, b, 150, 20) || !click(app, b, 380, 150) || !click(app, b, 100, 280) || !script.run(app, "key Enter\n") || steps(app) != 2 { return 206 }
    const brushSum = checksum(app, whole)
    if brushSum == plainSum || !undo(app) || checksum(app, whole) != plainSum || !script.run(app, "key Ctrl+Shift+Z\n") || checksum(app, whole) != brushSum { return 207 }
    if !undo(app) || !undo(app) || steps(app) != 0 || count(app, wholeImage()) != 0 { return 208 }
    plain(o)
    if !script.run(app, "color 2040C0\n") || !useTool(app, "rectangle") { return 209 }

    // A selection of half strength on the image's left half: the shape at
    // half alpha there, nothing right of it.
    const image = api.image(app).?
    ops.beginSelection(image)
    const chosen = raster.create(std.heap.allocator()).?
    raster.rect(chosen, 0.0, 0.0, 200.0, 300.0)
    _ = raster.fillMask(image.*.selection, chosen, raster.NONZERO, false, image_module.bounds(image), 128, raster.REPLACE)
    ops.endSelection(image, true, "Select")
    raster.destroy(chosen)
    if !image.*.selected || steps(app) != 1 { return 210 }
    if !drag(app, b, 150, 50, 249, 99) || painted(app, 200, 60) || count(app, wholeImage()) != 2500 { return 211 }
    const halfway = at(app, 170, 60)
    if halfway & 0x00FFFFFF != BLUE & 0x00FFFFFF || halfway >> 24 < 126 || halfway >> 24 > 130 { return 212 }
    if !undo(app) || !undo(app) || image.*.selected || steps(app) != 0 { return 213 }

    // The layer's alpha locked: the shape only where it has pixels.
    if !script.run(app, "color B23A48\n") || !drag(app, b, 100, 100, 149, 149) || !script.run(app, "color 2040C0\n") { return 214 }
    api.activeNode(app).?.*.alphaLocked = true
    if !drag(app, b, 120, 120, 179, 139) || steps(app) != 2 { return 215 }
    api.activeNode(app).?.*.alphaLocked = false
    if at(app, 130, 130) != BLUE || at(app, 160, 130) != 0 || at(app, 110, 110) != 0xFFB23A48 || count(app, wholeImage()) != 2500 || exactly(app, wholeImage(), BLUE) != 30 * 20 { return 216 }
    if !undo(app) || !undo(app) || steps(app) != 0 { return 217 }
    return 0
}

// How much is covered: by the round corners, by an outline along an
// ellipse, by dashes; the long freehand path; the panel in a layout pass,
// narrow and at twice the scale; memory.
fn amounts(app: *App, b: *Builder, o: *shapes.Options) -> u8 {
    plain(o)
    if !useTool(app, "rectangle") || steps(app) != 0 { return 218 }
    // A rounded rectangle of 100 x 60 with corners of 20: W H - (4 - pi)
    // r r; its outline of 4 alone: that less the rounded rectangle 8
    // smaller with corners of 16 (alpha summed, anti-aliased).
    o.*.radius = 20.0
    if !drag(app, b, 50, 40, 149, 99) || !lastStep(app, "Rounded rectangle") || painted(app, 50, 40) || painted(app, 52, 42) || !painted(app, 70, 40) || !painted(app, 50, 60) { return 219 }
    const rounded = 6000.0 - (4.0 - math.pi) * 400.0
    var pixels = @floatFromInt(f64, count(app, wholeImage()))
    if pixels < rounded * 0.99 || pixels > rounded * 1.01 || !undo(app) { return 220 }
    o.*.antialias = true
    o.*.fill = shapes.PAINT_NONE
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 4.0
    if !drag(app, b, 50, 40, 149, 99) { return 221 }
    const frame = rounded - (92.0 * 52.0 - (4.0 - math.pi) * 256.0)
    pixels = @floatFromInt(f64, alphaSum(app, wholeImage())) / 255.0
    if pixels < frame * 0.99 || pixels > frame * 1.01 || painted(app, 100, 70) || !undo(app) { return 222 }
    o.*.radius = 0.0
    // Filled and outlined 10 wide with round corners: the fill does not
    // reach past the outline's round outer corners (radius 5: 6000 less
    // 4 (1 - pi / 4) 25 pixels), nor past bevelled ones (corners of 5 cut
    // off: 6000 less 50).
    o.*.antialias = false
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_BACKGROUND
    o.*.width = 10.0
    o.*.join = @intCast(usize, raster.JOIN_ROUND)
    if !drag(app, b, 50, 40, 149, 99) || painted(app, 50, 40) || painted(app, 149, 99) || at(app, 52, 42) != 0xFFF2C14E || exactly(app, geom.rect(50, 40, 5, 5), BLUE) != 0 || exactly(app, geom.rect(145, 95, 5, 5), BLUE) != 0 { return 248 }
    pixels = @floatFromInt(f64, count(app, wholeImage()))
    if pixels < 6000.0 - 25.0 || pixels > 6000.0 - 18.0 || at(app, 100, 70) != BLUE || !undo(app) { return 249 }
    o.*.join = @intCast(usize, raster.JOIN_BEVEL)
    if !drag(app, b, 50, 40, 149, 99) || painted(app, 50, 40) || painted(app, 51, 40) || at(app, 53, 43) != 0xFFF2C14E || exactly(app, geom.rect(50, 40, 5, 5), BLUE) != 0 || exactly(app, geom.rect(145, 95, 5, 5), BLUE) != 0 { return 250 }
    pixels = @floatFromInt(f64, count(app, wholeImage()))
    if pixels < 6000.0 - 56.0 || pixels > 6000.0 - 44.0 || !undo(app) { return 251 }
    o.*.join = @intCast(usize, raster.JOIN_MITER)
    o.*.antialias = true
    o.*.fill = shapes.PAINT_NONE
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 4.0
    // An ellipse of 50 by 30 outlined 4 wide inside: the band along the
    // ellipse of 48 by 28, 4 times its length (Ramanujan's).
    if !useTool(app, "ellipse") || !drag(app, b, 100, 100, 199, 159) { return 223 }
    const around = math.pi * (3.0 * 76.0 - @sqrt((3.0 * 48.0 + 28.0) * (48.0 + 3.0 * 28.0)))
    pixels = @floatFromInt(f64, alphaSum(app, wholeImage())) / 255.0
    if pixels < 4.0 * around * 0.985 || pixels > 4.0 * around * 1.015 || painted(app, 150, 130) || !undo(app) { return 224 }
    // Dashes of 3 widths and gaps of 2 cover about 3/5 of a solid
    // outline, dots of one and one half of it.
    if !useTool(app, "rectangle") { return 225 }
    o.*.width = 2.0
    if !drag(app, b, 50, 40, 149, 99) { return 226 }
    const solid = @floatFromInt(f64, alphaSum(app, wholeImage()))
    if !undo(app) { return 227 }
    o.*.dashes = shapes.DASH_DASHED
    if !drag(app, b, 50, 40, 149, 99) { return 228 }
    const dashed = @floatFromInt(f64, alphaSum(app, wholeImage())) / solid
    if !undo(app) { return 229 }
    o.*.dashes = shapes.DASH_DOTTED
    if !drag(app, b, 50, 40, 149, 99) { return 230 }
    const dotted = @floatFromInt(f64, alphaSum(app, wholeImage())) / solid
    if !undo(app) || dashed < 0.53 || dashed > 0.67 || dotted < 0.43 || dotted > 0.57 { return 231 }
    // A polyline with neither fill nor outline is drawn all the same, in
    // the foreground colour.
    plain(o)
    o.*.fill = shapes.PAINT_NONE
    if !useTool(app, "polyline") || !click(app, b, 50, 50) || !click(app, b, 250, 60) || !script.run(app, "key Enter\n") || steps(app) != 1 || at(app, 150, 55) != BLUE || !undo(app) { return 232 }
    plain(o)

    // A freehand path of more motions than it keeps points (round and
    // round a circle of 100): filled, the disc; one step; the value arena
    // as it was.
    const arena = turns.locate()
    const arenaBefore = turns.used(arena)
    circling(app, 210000)
    const arenaAfter = turns.used(arena)
    if busy(app) || steps(app) != 1 || !lastStep(app, "Freehand path") { return 233 }
    pixels = @floatFromInt(f64, count(app, wholeImage()))
    if pixels < math.pi * 10000.0 * 0.98 || pixels > math.pi * 10000.0 * 1.01 || !painted(app, 200, 150) || painted(app, 200, 40) { return 234 }
    if arenaAfter > arenaBefore && arenaAfter - arenaBefore > 65536 { return 235 }
    if !undo(app) { return 236 }
    return 0
}

// The options read from a text that was tampered with: all held to what
// they may be, words that are no numbers passed over.
fn tampered(app: *App, o: *shapes.Options) -> u8 {
    plain(o)
    o.*.width = 6.0
    o.*.tips = 9.0
    o.*.smoothing = 40.0
    if !settings.setText(app, "tool.shapes", "fill=99999999999 width=abc tips=-5 opacity=100000000 blend=nonsense ratio= =5 smoothing=12.5 radius=9999999999999 join=7 cap=2 dashes=3 brush=5 smooth=0 outline") { return 237 }
    shapes.loadOptions(app)
    if o.*.fill != shapes.PAINT_NONE || o.*.width != 6.0 || o.*.tips != 9.0 || o.*.opacity != 100.0 || o.*.ratio != 50.0 || o.*.smoothing != 40.0 || o.*.radius != 0.0 { return 238 }
    if o.*.join != @intCast(usize, raster.JOIN_MITER) || o.*.cap != @intCast(usize, raster.CAP_SQUARE) || o.*.dashes != shapes.DASH_DASH_DOT || !o.*.useBrush || o.*.antialias || o.*.mode != blend.NORMAL { return 239 }
    if !settings.setText(app, "tool.shapes", "") { return 240 }
    plain(o)
    return 0
}

// The panel in a layout pass (a canvas of no pixels: as tall, nothing
// drawn), too narrow (nothing), at twice the scale (twice as tall); and
// the marks over a canvas of no pixels.
fn panelEdges(app: *App, canvas: *Canvas, o: *shapes.Options) -> u8 {
    plain(o)
    const tallest = panels(app, canvas, shapes.RECTANGLE, shapes.STAR, shapes.POLYLINE)
    var empty = Canvas.{ .pixels = canvas.*.pixels, .width = 0, .height = 0, .stride = 0, .swapRedBlue = false, .device = 0, .opacity = 255 }
    if panels(app, &empty, shapes.RECTANGLE, shapes.STAR, shapes.POLYLINE) != tallest { return 241 }
    const tool = tools.find(shapes.RECTANGLE).?
    if tool.*.options.?(app, ui.rect(0, 0, 40, 600)) != 0 { return 242 }
    const scale = app.*.scale
    const theme = app.*.theme
    app.*.scale = 2
    app.*.theme = theme_module.scaled(theme_module.dark(), 2)
    const doubled = panels(app, canvas, shapes.RECTANGLE, shapes.STAR, shapes.POLYLINE)
    app.*.scale = scale
    app.*.theme = theme
    if doubled < tallest * 2 - 8 || doubled > tallest * 2 + 8 { return 243 }
    // A freehand path without fill or outline is still drawn by its
    // outline: its width can be set (a press on the width's bar, the
    // third row of the panel in the middle).
    o.*.fill = shapes.PAINT_NONE
    o.*.width = 4.0
    const widgets = state.uiOf(app)
    onePanel(app, canvas, shapes.FREEHAND_PATH)
    _ = view.pointerMove(widgets, 24 + 8 + 200, 40 + 8 + 2 * 28 + 12)
    _ = view.pointerButton(widgets, true)
    onePanel(app, canvas, shapes.FREEHAND_PATH)
    _ = view.pointerButton(widgets, false)
    onePanel(app, canvas, shapes.FREEHAND_PATH)
    if !(o.*.width > 4.0) { return 252 }
    plain(o)
    api.setTool(app, shapes.POLYGON)
    pressAt(app, 50.5, 50.5)
    releaseAt(app, 50.5, 50.5)
    moveAt(app, 150.5, 80.5)
    tools.find(shapes.POLYGON).?.*.overlay.?(app, &empty)
    tools.find(shapes.POLYGON).?.*.cancel.?(app)
    if busy(app) { return 244 }
    return 0
}

// The view zoomed in and mirrored (the same pixels from the same image
// places), the eraser's blend mode, a selection of everything but a hole
// (its mask's default ALL), a curve's anchor taken back.
fn views(app: *App, b: *Builder, o: *shapes.Options) -> u8 {
    plain(o)
    if !useTool(app, "rectangle") || steps(app) != 0 { return 122 }
    const doc = api.document(app).?
    const middleX = @floatFromInt(f64, app.*.canvasArea.x) + @floatFromInt(f64, app.*.canvasArea.width) * 0.5
    const middleY = @floatFromInt(f64, app.*.canvasArea.y) + @floatFromInt(f64, app.*.canvasArea.height) * 0.5
    viewport.zoomAt(&doc.*.view, middleX, middleY, 4.0)
    const zoomed = drag(app, b, 180, 140, 190, 145) && count(app, wholeImage()) == 11 * 6 && painted(app, 180, 140) && painted(app, 190, 145) && !painted(app, 191, 145) && !painted(app, 180, 139)
    viewport.zoomAt(&doc.*.view, middleX, middleY, 1.0)
    if !zoomed || !undo(app) { return 123 }
    doc.*.view.mirror = true
    const mirrored = drag(app, b, 50, 40, 149, 99) && count(app, wholeImage()) == 6000 && painted(app, 50, 40) && painted(app, 149, 99) && !painted(app, 150, 99)
    doc.*.view.mirror = false
    if !mirrored { return 124 }
    // Erasing: a hole of 20 x 10 in the rectangle.
    o.*.mode = blend.ERASE
    if !drag(app, b, 80, 60, 99, 69) || steps(app) != 2 || count(app, wholeImage()) != 6000 - 200 || painted(app, 90, 65) || !painted(app, 79, 65) || !undo(app) || !undo(app) { return 125 }
    plain(o)
    // Everything selected but a hole of 20 x 20: the rectangle without it.
    const image = api.image(app).?
    ops.beginSelection(image)
    device.setDefault(image.*.selection, 0xFFFFFFFF)
    const hole = raster.create(std.heap.allocator()).?
    raster.rect(hole, 100.0, 50.0, 20.0, 20.0)
    _ = raster.fillMask(image.*.selection, hole, raster.NONZERO, false, image_module.bounds(image), 255, raster.SUBTRACT)
    ops.endSelection(image, true, "Select")
    raster.destroy(hole)
    if !image.*.selected || steps(app) != 1 { return 126 }
    if !drag(app, b, 50, 40, 149, 99) || count(app, wholeImage()) != 6000 - 400 || painted(app, 110, 60) || !painted(app, 99, 60) || !painted(app, 120, 60) || !undo(app) || !undo(app) || image.*.selected { return 127 }
    // A curve through three anchors with the last taken back: through the
    // first two only.
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 3.0
    if !useTool(app, "bezier") || !click(app, b, 50, 200) || !click(app, b, 200, 80) || !click(app, b, 350, 200) || !script.run(app, "key Backspace\nkey Enter\n") || steps(app) != 1 { return 128 }
    if !painted(app, 125, 140) || !painted(app, 199, 81) || painted(app, 275, 140) || painted(app, 349, 199) || !undo(app) || steps(app) != 0 { return 129 }
    plain(o)
    return 0
}

// Heap memory: shapes made and undone give back all they took.
fn heapKept(app: *App, o: *shapes.Options) -> u8 {
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.useBrush = true
    o.*.width = 3.0
    if !many(app, 2) { return 245 }
    const before = std.heap.liveBytes()
    if !many(app, 4) { return 246 }
    const after = std.heap.liveBytes()
    plain(o)
    if after > before + 1024 { return 247 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const found_dir = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if found_dir != null {
        const dir = std.string.asSlice(found_dir.?)
        if dir.length > 0 && dir.length < 500 {
            var index: usize = 0
            while index < dir.length {
                shotDir[index] = dir[index]
                index += 1
            }
            shotDirLength = dir.length
            // (No slash twice.)
            if shotDir[shotDirLength - 1] == 47 { shotDirLength -= 1 }
        }
    }
    const room = allocator.alloc(ROOM, 16)
    if room == null { return 1 }
    var b = Builder.{ .bytes = room.?, .length = 0 }
    const made = script.headless(allocator)
    if made == null { return 2 }
    const app = made.?
    if !script.run(app, "size 1024 768\nnew 400 300 FFFFFF\ncolor 2040C0\n") { return 3 }

    // The seven tools, in the shapes' group, found by key and by id.
    if shapes.list().length != 7 { return 4 }
    const keys_of = [7][]const u8{ "rectangle", "ellipse", "polygon", "polyline", "bezier", "freehandpath", "star" }
    var index: usize = 0
    while index < 7 {
        const tool = tools.byKey(keys_of[index])
        if tool == null || tool.?.*.id != shapes.RECTANGLE + @intCast(u8, index) || tool.?.*.group != state.GROUP_SHAPE { return 5 }
        api.setTool(app, tool.?.*.id)
        if shapes.hint(app).length < 20 { return 6 }
        if tools.find(tool.?.*.id) == null || tool.?.*.options == null || tool.?.*.overlay == null || tool.?.*.busy == null { return 7 }
        index += 1
    }

    // The options' defaults: filled with the foreground, no outline, the
    // brush's size, opacity and blend mode.
    const o = shapes.optionsOf(app).?
    const brush = brushes.current(app)
    if o.*.fill != shapes.PAINT_FOREGROUND || o.*.outline != shapes.PAINT_NONE || o.*.width != brush.*.size || o.*.opacity != 100.0 || o.*.mode != brush.*.blend || !o.*.antialias { return 8 }
    o.*.antialias = false

    // A rectangle: exactly the pixels from the one pressed to the one let
    // go (over the tile borders at 64 and 128), one step, undone exactly.
    if !useTool(app, "rectangle") { return 9 }
    if !drag(app, &b, 50, 40, 149, 99) { return 10 }
    if at(app, 50, 40) != BLUE || at(app, 149, 99) != BLUE || at(app, 64, 64) != BLUE || at(app, 128, 70) != BLUE { return 11 }
    if painted(app, 49, 40) || painted(app, 50, 39) || painted(app, 150, 99) || painted(app, 149, 100) { return 12 }
    if count(app, wholeImage()) != 6000 { return 14 }
    if steps(app) != 1 || !lastStep(app, "Rectangle") || busy(app) { return 15 }
    if api.activeNode(app).?.*.overlay != null { return 16 }
    if !undo(app) || count(app, wholeImage()) != 0 || steps(app) != 0 { return 17 }
    if !script.run(app, "key Ctrl+Shift+Z\n") || count(app, wholeImage()) != 6000 || at(app, 100, 70) != BLUE { return 18 }
    if !undo(app) { return 19 }

    // Dragged the other way round: the same pixels.
    if !drag(app, &b, 149, 99, 50, 40) || count(app, wholeImage()) != 6000 || at(app, 50, 40) != BLUE || !undo(app) { return 20 }

    // The outline alone: a frame of 4 pixels inside the pixels dragged.
    o.*.fill = shapes.PAINT_NONE
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 4.0
    if !drag(app, &b, 100, 100, 199, 159) { return 21 }
    if at(app, 100, 130) != BLUE || at(app, 103, 130) != BLUE || painted(app, 104, 130) || painted(app, 99, 130) { return 22 }
    if at(app, 150, 100) != BLUE || at(app, 150, 103) != BLUE || painted(app, 150, 104) || at(app, 199, 159) != BLUE || at(app, 196, 130) != BLUE || painted(app, 195, 130) { return 23 }
    if count(app, wholeImage()) != 6000 - 92 * 52 || steps(app) != 1 || !undo(app) { return 24 }
    // Wider than the rectangle is high: all of it in the outline's colour.
    o.*.width = 30.0
    if !drag(app, &b, 100, 100, 199, 119) || count(app, wholeImage()) != 2000 || !undo(app) { return 25 }
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_NONE

    // Shift: a square of the larger side; Alt: around the pixel pressed.
    if !script.run(app, "down Shift\n") || !drag(app, &b, 60, 60, 100, 80) || !script.run(app, "up Shift\n") { return 26 }
    if count(app, wholeImage()) != 41 * 41 || !painted(app, 100, 100) || painted(app, 101, 100) || painted(app, 100, 101) || !undo(app) { return 27 }
    if !script.run(app, "down Alt\n") || !drag(app, &b, 200, 150, 210, 155) || !script.run(app, "up Alt\n") { return 28 }
    if count(app, wholeImage()) != 21 * 11 || !painted(app, 190, 145) || painted(app, 189, 145) || !painted(app, 210, 155) || painted(app, 211, 155) || !undo(app) { return 29 }
    // Shift pressed while dragging counts from then on.
    put(&b, "pointer")
    place(&b, app, 60, 60)
    put(&b, "\npress\n")
    pointer(&b, app, 100, 80)
    put(&b, "down Shift\nrelease\nup Shift\n")
    if !play(app, &b) || count(app, wholeImage()) != 41 * 41 || !undo(app) { return 30 }

    // Begun outside the image: only its part; a click: nothing.
    if !drag(app, &b, -20, -15, 9, 9) || count(app, wholeImage()) != 100 || !painted(app, 0, 0) || painted(app, -1, 0) || !undo(app) { return 31 }
    if !click(app, &b, 120, 120) || count(app, wholeImage()) != 0 || steps(app) != 0 || busy(app) { return 32 }

    // While dragging the outline shows over the image (in the window's
    // pixels) and nothing is painted yet; Escape drops it: no trace.
    put(&b, "pointer")
    place(&b, app, 100, 100)
    put(&b, "\npress\n")
    pointer(&b, app, 160, 130)
    pointer(&b, app, 199, 159)
    if !play(app, &b) || !busy(app) || count(app, wholeImage()) != 0 { return 33 }
    const edge = windowArea(app, 110, 98, 70, 5)
    if marked(app, edge) < 60 { return 34 }
    if !script.run(app, "key Escape\nrelease\n") || busy(app) || count(app, wholeImage()) != 0 || steps(app) != 0 { return 35 }
    if !shoot(app, &b, "shapes-escaped.png") || marked(app, edge) != 0 { return 36 }
    // A shape made: the marks are gone, the window shows the paint.
    if !drag(app, &b, 100, 100, 199, 159) || !shoot(app, &b, "shapes-one.png") { return 37 }
    if marked(app, windowArea(app, 110, 95, 70, 5)) != 0 { return 38 }
    const frame = script.frameOf(app).?
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, 140, 101, &wx, &wy)
    if frame.*.pixels[@intCast(usize, wy) * frame.*.stride + @intCast(usize, wx)] | 0xFF000000 != BLUE { return 39 }
    if !undo(app) { return 40 }

    // An ellipse: pi a b pixels without anti-aliasing (a = 50, b = 30),
    // and as much alpha with it.
    if !useTool(app, "ellipse") || !drag(app, &b, 100, 100, 199, 159) { return 41 }
    const area = math.pi * 50.0 * 30.0
    var pixels = @floatFromInt(f64, count(app, wholeImage()))
    if pixels < area * 0.985 || pixels > area * 1.015 || !painted(app, 150, 130) || painted(app, 100, 100) || painted(app, 199, 159) { return 42 }
    if !lastStep(app, "Ellipse") || steps(app) != 1 || !undo(app) || count(app, wholeImage()) != 0 { return 43 }
    o.*.antialias = true
    if !drag(app, &b, 100, 100, 199, 159) { return 44 }
    pixels = @floatFromInt(f64, alphaSum(app, wholeImage())) / 255.0
    if pixels < area * 0.997 || pixels > area * 1.003 || !undo(app) { return 45 }
    o.*.antialias = false

    // A polygon: corners by clicks, Enter ends it.
    if !useTool(app, "polygon") { return 46 }
    if !click(app, &b, 50, 50) || !click(app, &b, 250, 60) || !click(app, &b, 120, 200) || !busy(app) || count(app, wholeImage()) != 0 { return 47 }
    if !shoot(app, &b, "shapes-polygon.png") { return 48 }
    if !script.run(app, "key Enter\n") || busy(app) || !lastStep(app, "Polygon") || steps(app) != 1 { return 49 }
    if !painted(app, 140, 103) || painted(app, 40, 40) || painted(app, 250, 200) || painted(app, 85, 140) { return 50 }
    if !undo(app) { return 51 }
    // Ended by a double click; Backspace takes the last corner back.
    if !click(app, &b, 50, 50) || !click(app, &b, 250, 60) || !click(app, &b, 120, 200) || !click(app, &b, 120, 200) || busy(app) || steps(app) != 1 || !undo(app) { return 52 }
    if !click(app, &b, 50, 50) || !click(app, &b, 250, 60) || !click(app, &b, 250, 250) || !click(app, &b, 50, 250) { return 53 }
    if !script.run(app, "key Backspace\nkey Enter\n") || steps(app) != 1 || !painted(app, 200, 100) || painted(app, 80, 230) || !undo(app) { return 54 }
    // A click on the first corner closes it.
    if !click(app, &b, 50, 50) || !click(app, &b, 250, 60) || !click(app, &b, 120, 200) || !click(app, &b, 51, 51) || busy(app) || steps(app) != 1 || !painted(app, 140, 103) || !undo(app) { return 55 }
    // Escape with a polygon half made: nothing.
    if !click(app, &b, 50, 50) || !click(app, &b, 250, 60) || !script.run(app, "key Escape\n") || busy(app) || steps(app) != 0 || count(app, wholeImage()) != 0 { return 56 }
    // Enter with too few corners: nothing either.
    if !click(app, &b, 50, 50) || !click(app, &b, 250, 60) || !script.run(app, "key Enter\n") || busy(app) || steps(app) != 0 { return 57 }

    // A polyline is not closed: inside its triangle the layer stays
    // empty; its lines are there, the one back to the start is not.
    if !useTool(app, "polyline") { return 58 }
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 3.0
    if !click(app, &b, 50, 50) || !click(app, &b, 250, 60) || !click(app, &b, 120, 200) || !script.run(app, "key Enter\n") { return 59 }
    if !lastStep(app, "Polyline") || steps(app) != 1 || painted(app, 140, 103) || !painted(app, 150, 55) || !painted(app, 185, 130) || painted(app, 85, 125) { return 60 }
    if !undo(app) { return 61 }

    // A Bézier curve through its anchors: the middle one's handle dragged
    // out level, so the curve passes it level (above the straight lines
    // to the other two).
    if !useTool(app, "bezier") { return 62 }
    o.*.width = 5.0
    if !click(app, &b, 50, 200) || !drag(app, &b, 200, 80, 260, 80) || !click(app, &b, 350, 200) || !script.run(app, "key Enter\n") { return 63 }
    if !lastStep(app, "B\xC3\xA9zier curve") || steps(app) != 1 || busy(app) { return 64 }
    if !painted(app, 51, 199) || !painted(app, 200, 80) || !painted(app, 349, 199) || !painted(app, 210, 80) || !painted(app, 190, 80) || painted(app, 200, 90) || painted(app, 200, 140) { return 65 }
    if !undo(app) { return 66 }

    // A star of 5 tips dragged from its middle straight up: its top tip,
    // no paint between two tips, about 5 R r sin(36 degrees) pixels.
    if !useTool(app, "star") { return 67 }
    o.*.outline = shapes.PAINT_NONE
    o.*.tips = 5.0
    o.*.ratio = 50.0
    if !drag(app, &b, 200, 150, 200, 90) || !lastStep(app, "Star") || steps(app) != 1 { return 68 }
    if !painted(app, 200, 150) || !painted(app, 200, 95) || painted(app, 200, 85) || painted(app, 233, 106) || !painted(app, 248, 135) { return 69 }
    const star = 5.0 * 60.5 * 30.25 * math.sin(math.pi / 5.0)
    pixels = @floatFromInt(f64, count(app, wholeImage()))
    if pixels < star * 0.97 || pixels > star * 1.03 || !undo(app) { return 70 }

    // A freehand path: filled it is closed; without a fill it is a line.
    if !useTool(app, "freehandpath") { return 71 }
    put(&b, "pointer")
    place(&b, app, 100, 100)
    put(&b, "\npress\n")
    pointer(&b, app, 160, 90)
    pointer(&b, app, 220, 100)
    pointer(&b, app, 230, 160)
    pointer(&b, app, 160, 200)
    pointer(&b, app, 100, 160)
    pointer(&b, app, 98, 110)
    put(&b, "release\n")
    if !play(app, &b) || !lastStep(app, "Freehand path") || steps(app) != 1 || !painted(app, 160, 140) || painted(app, 60, 60) || !undo(app) { return 72 }
    // (Not smoothed: the corner stays where it was.)
    o.*.fill = shapes.PAINT_NONE
    o.*.smoothing = 0.0
    put(&b, "pointer")
    place(&b, app, 100, 100)
    put(&b, "\npress\n")
    pointer(&b, app, 160, 90)
    pointer(&b, app, 220, 100)
    pointer(&b, app, 230, 160)
    pointer(&b, app, 160, 200)
    put(&b, "release\n")
    if !play(app, &b) || steps(app) != 1 || painted(app, 160, 140) || !painted(app, 220, 100) || !undo(app) { return 73 }
    // Smoothing takes the jitter out (by the way gone, not by the points).
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 2.0
    if zigzag(app, 0.0) < 100 || steps(app) != 1 || !undo(app) { return 74 }
    if zigzag(app, 100.0) != 0 || steps(app) != 1 || !painted(app, 200, 150) || !undo(app) { return 75 }
    o.*.outline = shapes.PAINT_NONE
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.smoothing = 30.0

    // A selection clips the shape: only its left half of the image.
    if !useTool(app, "rectangle") { return 76 }
    const image = api.image(app).?
    ops.beginSelection(image)
    const chosen = raster.create(allocator).?
    raster.rect(chosen, 0.0, 0.0, 200.0, 300.0)
    _ = raster.fillMask(image.*.selection, chosen, raster.NONZERO, false, image_module.bounds(image), 255, raster.REPLACE)
    ops.endSelection(image, true, "Select")
    raster.destroy(chosen)
    if !image.*.selected || steps(app) != 1 { return 77 }
    if !drag(app, &b, 150, 50, 249, 99) || !painted(app, 199, 60) || painted(app, 200, 60) || count(app, wholeImage()) != 2500 { return 78 }
    if !undo(app) || !undo(app) || image.*.selected || steps(app) != 0 { return 79 }

    // A locked layer is not painted, and the status bar says why.
    api.activeNode(app).?.*.locked = true
    if !drag(app, &b, 50, 40, 149, 99) || count(app, wholeImage()) != 0 || steps(app) != 0 || busy(app) { return 80 }
    if !script.run(app, "expect-note locked\n") { return 81 }
    api.activeNode(app).?.*.locked = false

    // Half the opacity: half the alpha, the colour as it is.
    o.*.opacity = 50.0
    if !drag(app, &b, 50, 40, 149, 99) { return 82 }
    const half = at(app, 100, 70)
    if half & 0x00FFFFFF != BLUE & 0x00FFFFFF || half >> 24 < 127 || half >> 24 > 128 || !undo(app) { return 83 }
    o.*.opacity = 100.0

    // The brush's outline (a soft brush of 8 pixels): soft (between
    // nothing and all at its rim), in the outline's place, nothing in the
    // middle.
    o.*.fill = shapes.PAINT_NONE
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.useBrush = true
    o.*.antialias = true
    brush.*.size = 8.0
    brush.*.tip.horizontalFade = 0.3
    brush.*.tip.verticalFade = 0.3
    if !drag(app, &b, 100, 100, 199, 159) || steps(app) != 1 || !lastStep(app, "Rectangle") { return 84 }
    if painted(app, 150, 130) || at(app, 104, 130) >> 24 < 160 || at(app, 104, 130) & 0x00FFFFFF != BLUE & 0x00FFFFFF { return 85 }
    var soft: usize = 0
    var x: i32 = 96
    while x < 114 {
        const alpha = at(app, x, 130) >> 24
        if alpha > 0 && alpha < 200 { soft += 1 }
        x += 1
    }
    if soft < 2 { return 86 }
    if !shoot(app, &b, "shapes-brush.png") || !undo(app) { return 87 }
    // From far outside: the brush is led only where the image is (and as
    // far around it as the brush reaches).
    if !farRectangle(app) || steps(app) != 1 { return 88 }
    const reached = device.extent(layer(app))
    if reached.x < -128 || reached.y < -128 || reached.x + reached.width > 528 || reached.y + reached.height > 428 { return 89 }
    if !painted(app, 198, 100) || !painted(app, 100, 148) || painted(app, 150, 100) || !undo(app) { return 90 }
    o.*.useBrush = false

    // The options kept in the settings and read back.
    o.*.width = 7.5
    o.*.mode = blend.MULTIPLY
    o.*.dashes = shapes.DASH_DOTTED
    o.*.tips = 7.0
    shapes.saveOptions(app)
    const kept = settings.text(app, "tool.shapes")
    if !std.text.contains(kept, "width=750") || !std.text.contains(kept, "blend=multiply") || !std.text.contains(kept, "tips=700") { return 91 }
    o.*.width = 1.0
    o.*.mode = blend.NORMAL
    o.*.dashes = shapes.DASH_SOLID
    o.*.tips = 3.0
    o.*.fill = 99
    shapes.loadOptions(app)
    if o.*.width != 7.5 || o.*.mode != blend.MULTIPLY || o.*.dashes != shapes.DASH_DOTTED || o.*.tips != 7.0 || o.*.fill != shapes.PAINT_NONE { return 92 }
    o.*.mode = blend.NORMAL

    // The options panels at 1024 x 768: drawn, of a height that fits;
    // dark and light, English and German.
    const memory = allocator.alloc(1024 * 768 * 4, 16)
    if memory == null { return 93 }
    const window_pixels: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    var canvas = Canvas.{ .pixels = window_pixels, .width = 1024, .height = 768, .stride = 1024, .swapRedBlue = false, .device = 0, .opacity = 255 }
    const tallest = panels(app, &canvas, shapes.RECTANGLE, shapes.STAR, shapes.POLYLINE)
    if tallest < 200 || tallest > 600 { return 94 }
    const ground = state.themeOf(app).*.panel
    if drawnIn(&canvas, ui.rect(24, 40, 280, 640), ground) < 2000 || drawnIn(&canvas, ui.rect(354, 40, 280, 640), ground) < 2000 || drawnIn(&canvas, ui.rect(684, 40, 280, 640), ground) < 2000 { return 95 }
    if !savePicture(&canvas, "shapes-options.png", allocator) { return 96 }
    const dark = app.*.theme
    app.*.theme = theme_module.scaled(theme_module.light(), 1)
    app.*.german = true
    if panels(app, &canvas, shapes.ELLIPSE, shapes.FREEHAND_PATH, shapes.BEZIER) < 200 { return 97 }
    if !savePicture(&canvas, "shapes-options-light-de.png", allocator) { return 98 }
    app.*.theme = dark
    app.*.german = false
    // A click on "Smooth edges" (its row is the eleventh, after a gap):
    // one frame names the regions, the click lands, the next takes it.
    const smooth_before = o.*.antialias
    _ = panels(app, &canvas, shapes.RECTANGLE, shapes.STAR, shapes.POLYLINE)
    const widgets = state.uiOf(app)
    _ = view.pointerMove(widgets, 24 + 8 + 40, 40 + 8 + 7 * 28 + 8 + 2 * 28 + 12)
    _ = view.pointerButton(widgets, true)
    _ = view.pointerButton(widgets, false)
    _ = panels(app, &canvas, shapes.RECTANGLE, shapes.STAR, shapes.POLYLINE)
    if o.*.antialias == smooth_before { return 99 }
    if !std.text.contains(settings.text(app, "tool.shapes"), if o.*.antialias { "smooth=1" } else { "smooth=0" }) { return 100 }
    o.*.antialias = false

    // The value arena stays as it is over many shapes (made by the tools'
    // own functions, no script turning it back between them).
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.useBrush = true
    o.*.width = 3.0
    if !many(app, 1) { return 101 }
    const arena = turns.locate()
    const before = turns.used(arena)
    if !many(app, 6) { return 102 }
    const after = turns.used(arena)
    if after > before && after - before > 65536 { return 103 }
    o.*.useBrush = false
    o.*.dashes = shapes.DASH_SOLID

    // The picture: shapes of every kind on the image.
    if steps(app) != 0 { return 104 }
    if !script.run(app, "color 2E5C9A\nbackground F2C14E\n") || !useTool(app, "rectangle") { return 105 }
    o.*.antialias = true
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_BACKGROUND
    o.*.width = 4.0
    o.*.radius = 0.0
    if !drag(app, &b, 20, 20, 119, 89) { return 106 }
    o.*.radius = 18.0
    o.*.fill = shapes.PAINT_BACKGROUND
    o.*.outline = shapes.PAINT_FOREGROUND
    if !drag(app, &b, 140, 20, 249, 89) { return 107 }
    o.*.radius = 0.0
    if !useTool(app, "ellipse") { return 108 }
    o.*.fill = shapes.PAINT_NONE
    o.*.dashes = shapes.DASH_DASHED
    o.*.width = 3.0
    if !drag(app, &b, 270, 20, 379, 89) { return 109 }
    o.*.dashes = shapes.DASH_SOLID
    if !script.run(app, "color B23A48\n") || !useTool(app, "star") { return 110 }
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_NONE
    if !drag(app, &b, 70, 170, 70, 120) { return 111 }
    if !useTool(app, "polygon") || !script.run(app, "color 3C8D5A\n") { return 112 }
    o.*.outline = shapes.PAINT_BACKGROUND
    o.*.width = 2.0
    o.*.join = @intCast(usize, raster.JOIN_ROUND)
    if !click(app, &b, 150, 120) || !click(app, &b, 240, 135) || !click(app, &b, 215, 200) || !click(app, &b, 160, 190) || !script.run(app, "key Enter\n") { return 113 }
    if !useTool(app, "polyline") || !script.run(app, "color 222222\n") { return 114 }
    o.*.outline = shapes.PAINT_FOREGROUND
    o.*.width = 3.0
    o.*.cap = @intCast(usize, raster.CAP_ROUND)
    if !click(app, &b, 270, 200) || !click(app, &b, 300, 120) || !click(app, &b, 330, 200) || !click(app, &b, 360, 120) || !script.run(app, "key Enter\n") { return 115 }
    if !useTool(app, "bezier") || !script.run(app, "color 7A4FB5\n") { return 116 }
    o.*.width = 4.0
    if !click(app, &b, 20, 280) || !drag(app, &b, 120, 230, 170, 230) || !drag(app, &b, 220, 280, 270, 280) || !script.run(app, "key Enter\n") { return 117 }
    if !useTool(app, "freehandpath") || !script.run(app, "color D9822B\n") { return 118 }
    o.*.fill = shapes.PAINT_FOREGROUND
    o.*.outline = shapes.PAINT_NONE
    put(&b, "pointer")
    place(&b, app, 300, 230)
    put(&b, "\npress\n")
    pointer(&b, app, 330, 222)
    pointer(&b, app, 365, 232)
    pointer(&b, app, 380, 260)
    pointer(&b, app, 350, 285)
    pointer(&b, app, 310, 280)
    pointer(&b, app, 296, 255)
    put(&b, "release\n")
    if !play(app, &b) || steps(app) != 8 { return 119 }
    // And a rectangle being dragged over it all.
    if !useTool(app, "rectangle") { return 120 }
    put(&b, "pointer")
    place(&b, app, 250, 150)
    put(&b, "\npress\n")
    pointer(&b, app, 330, 190)
    pointer(&b, app, 380, 215)
    if !play(app, &b) || !shoot(app, &b, "shapes.png") || !script.run(app, "key Escape\nrelease\n") || steps(app) != 8 { return 121 }

    // The edges, on a new image.
    var failed = gestures(app, &b, o)
    if failed == 0 { failed = edges(app, &b, o) }
    if failed == 0 { failed = over(app, &b, o) }
    if failed == 0 { failed = amounts(app, &b, o) }
    if failed == 0 { failed = tampered(app, o) }
    if failed == 0 { failed = views(app, &b, o) }
    if failed == 0 { failed = panelEdges(app, &canvas, o) }
    if failed == 0 { failed = heapKept(app, o) }
    if failed != 0 { return failed }
    return 13
}
