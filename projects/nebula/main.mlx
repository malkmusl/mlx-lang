// nebula: a painting program: layers, brushes, selections, filters, on
// Linux and on brixOS from one source (README.md). This file starts it:
// the window (std.ui.host, drawing on the CPU: the canvas is the
// program's own pixels) or, with --script, a run without a window that a
// script plays (app/script.mlx).
//
//     nebula [FILE...]
//     nebula --script FILE
const std = @import("std")
const crash = @import("std.crash")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const host_module = @import("std.ui.host")
const state = @import("./app/state.mlx")
const api = @import("./app/api.mlx")
const loop = @import("./app/loop.mlx")
const script = @import("./app/script.mlx")
const documents = @import("./app/documents.mlx")
const shell_module = @import("./app/shell.mlx")

const App = state.App
const Canvas = state.Canvas

const Failure = error { ScriptFailed, NoMemory }

// (An error of the program's own leaves main through a function of its
// set: a bare error value is no `!void`.)
fn scriptFailed() -> Failure!void { return Failure.ScriptFailed }
fn noMemory() -> Failure!void { return Failure.NoMemory }

fn stateOf(context: *anyopaque) -> *App { unsafe { return @ptrCast(*App, context) } }

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const app = stateOf(context)
    if !app.*.ready { return }
    if canvas.*.device != 0 {
        // The GPU draws by commands, not into pixels: not this program's way.
        canvas_module.clear(canvas, 0xFF202020)
        return
    }
    loop.frame(app, canvas)
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    loop.event(stateOf(context), kind, a, b)
}

// The arguments with MLX_CANVAS=cpu first in the environment after them:
// std.ui then draws into memory the program can write itself (the canvas
// is composed here, pixel by pixel), on Linux as on brixOS.
fn withCpuCanvas(arguments: [][*]const u8, allocator: std.allocator.Allocator) -> [][*]const u8 {
    const environment = std.process.environmentEntries(arguments)
    var entries: usize = 0
    while @intFromPtr(environment[entries]) != 0 { entries += 1 }
    const count = arguments.length + 1 + entries + 2
    const memory = allocator.alloc(count * @sizeOf(usize), 16)
    if memory == null { return arguments }
    const vector: [*]usize = unsafe { @ptrCast([*]usize, memory.?) }
    var at: usize = 0
    for argument in arguments {
        vector[at] = @intFromPtr(argument)
        at += 1
    }
    vector[at] = 0
    at += 1
    vector[at] = @intFromPtr("MLX_CANVAS=cpu\x00".pointer)
    at += 1
    var index: usize = 0
    while index < entries {
        vector[at] = @intFromPtr(environment[index])
        at += 1
        index += 1
    }
    vector[at] = 0
    const pointers: [*][*]const u8 = unsafe { @ptrCast([*][*]const u8, vector) }
    return pointers[0..arguments.length]
}

fn germanLocale(app: *App) -> bool {
    var value = shell_module.environmentValue(app.*.shell, "LC_ALL")
    if value.length == 0 { value = shell_module.environmentValue(app.*.shell, "LC_MESSAGES") }
    if value.length == 0 { value = shell_module.environmentValue(app.*.shell, "LANG") }
    return value.length >= 2 && value[0] == 100 && value[1] == 101
}

pub fn main(arguments: [][*]const u8) -> !void {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const shell_memory = allocator.alloc(@sizeOf(shell_module.Shell), 16)
    if shell_memory == null { return noMemory() }
    const shell: *shell_module.Shell = unsafe { @ptrCast(*shell_module.Shell, shell_memory.?) }
    shell_module.init(shell, allocator)
    shell.*.environment = std.process.environmentEntries(arguments)
    const made = state.create(allocator, shell)
    if made == null { return noMemory() }
    const app = made.?
    app.*.german = germanLocale(app)

    // What the arguments ask for.
    var script_path: []const u8 = ""
    var index: usize = 1
    while index < arguments.length {
        const argument = std.text.cString(arguments[index])
        if std.text.same(argument, "--script") && index + 1 < arguments.length {
            script_path = std.text.cString(arguments[index + 1])
            index += 1
        }
        index += 1
    }

    if script_path.length > 0 {
        var path: [1024]u8 = undefined
        const loaded = std.fs.readFileAlloc(std.text.zeroTerminated(&path, 1024, script_path), allocator)
        if loaded == null {
            _ = std.io.eprintln("nebula: the script could not be read")
            return scriptFailed()
        }
        app.*.ready = true
        if !script.run(app, loaded.?.items[0..loaded.?.length]) { return scriptFailed() }
        return
    }

    const host = host_module.create(host_module.Options.{ .title = "Nebula", .appId = "org.mlx.nebula", .width = 1280, .height = 800, .minWidth = 720, .minHeight = 480 }, app, draw, onEvent)
    if host == null { return noMemory() }
    shell.*.host = host
    try host_module.open(host.?, withCpuCanvas(arguments, allocator))
    host_module.report(host.?, "nebula")
    app.*.ready = true
    // Something to paint on from the start.
    _ = documents.create(app, 1600, 1200, 72.0, 0xFFFFFFFF)
    api.redraw(app)
    try host_module.run(host.?)
}
