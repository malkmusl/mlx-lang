// nebula tools: the selection tools (ids 40-47): the rectangle, the
// ellipse, the polygon, the freehand outline (lasso), the contiguous
// selection (magic wand), the similar colour selection, the bezier curve
// and the magnetic outline. Each makes a shape (a mask, core/mask.mlx)
// and joins it with the image's selection (core/selection.mlx's combine)
// as ONE step of the history (core/ops.mlx's beginSelection ..
// endSelection), named after how it joins:
//
//   Replace               the shape is the selection now ("Select")
//   Add                   Shift held at the press ("Add to Selection")
//   Subtract              Alt held at the press
//   Intersect             Shift and Alt held at the press
//   Symmetric difference  chosen in the options only
//
// The options (options(): the Tool Options docker draws them) choose the
// mode a press without a key takes, anti-aliasing, a feather radius, and
// for the wand and the similar colour selection the threshold, the
// softness, what is sampled (the active layer or what the image shows),
// diagonal neighbours (wand) and growing or shrinking what was found; for
// the magnetic outline what is sampled and how far from the straight line
// it searches. Each tool has its own; they are kept between runs as one
// text of app/settings.mlx each ("tool.selectrect" = "mode=0 aa=0
// feather=0 ..."), written when a change is complete.
//
// How each is used:
//
//   rectangle, ellipse   a drag spans the box (Shift pressed during the
//                        drag: a square or a circle; Alt: from the middle
//                        out). A drag that starts inside the selection
//                        with no key held moves the selection's outline
//                        (device.moveBy on the mask, in the step). A
//                        click deselects.
//   polygon              a click a corner; a double click, a click on the
//                        first corner or Enter closes it.
//   freehand             a drag goes round; letting go closes the
//                        outline. A click deselects.
//   wand, similar        a click selects the colour clicked: as far as it
//                        reaches connected / wherever it is in the image.
//   bezier               a click an anchor, dragging on pulls its handle
//                        out (mirrored on the other side); closes as the
//                        polygon does.
//   magnetic             a click an anchor, snapped to the strongest edge
//                        within SNAP pixels. From anchor to anchor the
//                        outline follows the strongest edges: the
//                        cheapest way over the corners of the pixel grid
//                        (Dijkstra, a step along a strong edge costs
//                        little), searched within the search radius of
//                        the straight line between the two; the way to
//                        the pointer shows while it moves. Closes as the
//                        polygon does, along the edges back to the first.
//
// Escape (or another tool chosen) drops what is unfinished and puts a
// moved outline back, Backspace takes the last corner or anchor back, and
// a click in Replace mode that makes no shape deselects. While a shape is
// drawn it shows as a dashed outline over the canvas (overlay(); the
// magnetic outline, which lies on the edges it follows, where dashes of
// black and white would vanish, as a light line with a dark one beside
// it); what is selected shows as marching ants (the canvas view's own).
// With a key held for a mode, a sign at the pointer (or in the size of
// the box being dragged) says which. What was begun on one image is not
// shown over another put in front, and is dropped there by the next press
// or motion over the canvas.
//
// The functions of all eight rows are the same ones: they serve the tool
// in use (app.tool), the only one the program hands its events to. Each
// tool keeps its options and what it is doing in its slot
// (state.SLOT_TOOL + its id); the corners of an outline in a heap block
// that grows (given back when it was large).
//
// Others (a test, a tour) reach a tool's options as its panel does:
//
//     const options = selections.optionsOf(app, selections.CONTIGUOUS).?
//     options.*.threshold = 0
//     selections.keepOptions(app, selections.CONTIGUOUS)     // kept for the next run
//
// Not done: the magnetic outline searches no more than MOST_CORNERS
// corners between two anchors (anchors farther apart are joined by a
// straight line, and the status bar says so), and does not set anchors
// by itself while the pointer moves on; no tool shows a handle to change
// a finished shape (the selection is a mask once made).
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const settings = @import("../app/settings.mlx")
const shell_module = @import("../app/shell.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const overlay = @import("../ui/overlay.mlx")
const viewport = @import("../ui/viewport.mlx")
const device_module = @import("../core/device.mlx")
const mask_module = @import("../core/mask.mlx")
const image_module = @import("../core/image.mlx")
const selection = @import("../core/selection.mlx")
const raster = @import("../core/raster.mlx")
const fill = @import("../core/fill.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")

pub const App = state.App
pub const Input = state.Input
pub const Canvas = state.Canvas
pub const Image = image_module.Image
pub const Device = device_module.Device

pub const RECTANGLE: u8 = 40
pub const ELLIPSE: u8 = 41
pub const POLYGON: u8 = 42
pub const FREEHAND: u8 = 43
pub const CONTIGUOUS: u8 = 44
pub const SIMILAR: u8 = 45
pub const BEZIER: u8 = 46
pub const MAGNETIC: u8 = 47

// What the wand, the similar colour selection and the magnetic outline
// look at: the active layer's pixels, or what all layers show together.
pub const SAMPLE_LAYER: u8 = 0
pub const SAMPLE_IMAGE: u8 = 1

// How far an anchor of the magnetic outline goes to an edge (pixels), and
// the most corners one search between two anchors looks at (about 80 ms
// where nothing is to be followed and the search fills its whole band).
// The way shown to the pointer, worked out at every motion, searches no
// more than MOST_SHOWN (about 12 ms so; beyond, a straight line shows).
pub const SNAP: i32 = 8
pub const MOST_CORNERS: usize = 262144
const MOST_SHOWN: usize = 40000

// The ranges of the options.
pub const MOST_FEATHER: i32 = 100
pub const MOST_GROW: i32 = 100
const LEAST_RADIUS: i32 = 4
const MOST_RADIUS: i32 = 64

// A tool's options (see the header).
pub const Options = struct {
    // How a press with no key held joins (selection.REPLACE ...
    // SYMMETRIC_DIFFERENCE).
    mode: u8
    antialias: bool
    // Pixels the shape's edge is softened over (0: not).
    feather: i32
    // How far a colour may be from the one clicked, 0-255, and how much of
    // that is a soft edge, 0-100 (0: hard).
    threshold: i32
    softness: i32
    sample: u8
    diagonal: bool
    // Pixels what was found grows by (below 0: shrinks).
    grow: i32
    // How far from the straight line between two anchors the magnetic
    // outline looks for edges.
    radius: i32
}

// What a tool is doing.
const IDLE: u8 = 0
// The button is down: a box or a freehand outline is dragged out.
const DRAGGING: u8 = 1
// The button is down: the selection's outline is being moved.
const MOVING: u8 = 2
// Corners or anchors are being placed, a click each.
const PLACING: u8 = 3

// A press and a release closer than this (window pixels) are a click; a
// click this near the first corner closes the outline.
const CLICK_REACH: i32 = 3
const CLOSE_REACH: i32 = 6
// The freehand outline takes a point when the pointer went this far on
// (window pixels).
const LASSO_STEP: f64 = 2.0
// A dash of the outline being drawn (window pixels, as ui/overlay.mlx's).
const DASH: i32 = 4
// An edge weaker than this does not pull an anchor (0-255).
const SNAP_LEAST: u32 = 40
// The most points an outline holds, the most anchors of the magnetic one.
const MOST_POINTS: usize = 1048576
const MOST_ANCHORS: usize = 512
// A block of points larger than this is given back after the outline.
const KEPT_BYTES: usize = 32768
// Not reached: a distance in the search, a corner not in the heap, one
// done.
const FAR: u32 = 4294967295
const OUTSIDE: u32 = 4294967295
const SETTLED: u32 = 4294967294

const WHITE: u32 = 0xFFFFFFFF
const BLACK: u32 = 0xFF000000

// Points of an outline, x and y of each in turn, in a heap block.
const Points = struct {
    address: usize
    capacity: usize
    count: usize
}

// What a tool keeps in its slot.
const Work = struct {
    ready: bool
    options: Options
    phase: u8
    // The mode of what is under way, the keys held at its press, the keys
    // held now (Shift and Alt pressed later shape the box).
    mode: u8
    held: u32
    keysNow: u32
    // The image it is done on: its address and its number (another image
    // made after this one was closed may sit at the same address).
    image: usize
    imageNumber: u64
    // Where the press was and where the pointer is, by the image; the
    // window's place of the press.
    startX: f64
    startY: f64
    nowX: f64
    nowY: f64
    pressX: i32
    pressY: i32
    // The pointer went farther than a click.
    dragged: bool
    // The pointer's last place over the canvas, by the image and the
    // window.
    pointerX: f64
    pointerY: f64
    pointerWindowX: i32
    pointerWindowY: i32
    pointerSeen: bool
    // How far the selection's outline was moved.
    movedX: i32
    movedY: i32
    // The bezier tool: the newest anchor's handle follows the pointer.
    pulling: bool
    // The outline's points (the bezier tool's: an anchor and its handle
    // in turn).
    points: Points
    // The magnetic outline: the point each anchor is, and the way from
    // the last anchor to the corner `wireX`, `wireY` (the pointer's).
    anchors: [512]u32
    anchorCount: usize
    wire: Points
    wireX: i32
    wireY: i32
    wireValid: bool
    // A path to build shapes in (raster.Path; 0: not made yet).
    path: usize
    // What the colour tools hand core/fill.mlx, and the text of the box's
    // size: here, not in the frame, as the frame's would be taken of the
    // value arena at every click and every frame (their addresses are
    // handed on).
    fillOptions: fill.Options
    label: [40]u8
}

// ---------------------------------------------------------------------------
// The tools' records

fn isOurs(id: u8) -> bool { return id >= RECTANGLE && id <= MAGNETIC }

fn defaults(id: u8) -> Options {
    return Options.{
        .mode = selection.REPLACE,
        .antialias = id != RECTANGLE,
        .feather = 0,
        .threshold = 20,
        .softness = 0,
        .sample = if id == MAGNETIC { SAMPLE_IMAGE } else { SAMPLE_LAYER },
        .diagonal = false,
        .grow = 0,
        .radius = 20,
    }
}

fn keyOf(id: u8) -> []const u8 {
    if id == RECTANGLE { return "selectrect" }
    if id == ELLIPSE { return "selectellipse" }
    if id == POLYGON { return "selectpolygon" }
    if id == FREEHAND { return "selectfreehand" }
    if id == CONTIGUOUS { return "selectcontiguous" }
    if id == SIMILAR { return "selectsimilar" }
    if id == BEZIER { return "selectbezier" }
    return "selectmagnetic"
}

// The settings' name of a tool's options text ("tool.selectrect") into
// `into` (40 bytes); its length.
fn settingName(id: u8, into: [*]u8) -> usize {
    return std.text.append(into, std.text.append(into, 0, 40, "tool."), 40, keyOf(id))
}

fn held(value: i32, low: i32, high: i32) -> i32 {
    return if value < low { low } else if value > high { high } else { value }
}

// The options held to their ranges.
fn tidy(options: *Options) -> void {
    if options.*.mode > selection.SYMMETRIC_DIFFERENCE { options.*.mode = selection.REPLACE }
    if options.*.sample > SAMPLE_IMAGE { options.*.sample = SAMPLE_LAYER }
    options.*.feather = held(options.*.feather, 0, MOST_FEATHER)
    options.*.threshold = held(options.*.threshold, 0, 255)
    options.*.softness = held(options.*.softness, 0, 100)
    options.*.grow = held(options.*.grow, -MOST_GROW, MOST_GROW)
    options.*.radius = held(options.*.radius, LEAST_RADIUS, MOST_RADIUS)
}

// A whole number in `text` (an optional minus first); false when it is
// none or too long to be one of the options.
fn number(text: []const u8, into: *i32) -> bool {
    if text.length == 0 || text.length > 6 { return false }
    var index: usize = 0
    var negative = false
    if text[0] == 45 {
        negative = true
        index = 1
    }
    if index >= text.length { return false }
    var value: i32 = 0
    while index < text.length {
        if text[index] < 48 || text[index] > 57 { return false }
        value = value * 10 + @intCast(i32, text[index] - 48)
        index += 1
    }
    into.* = if negative { -value } else { value }
    return true
}

// One "name=value" of the options' text taken in (what is not known is
// passed over).
fn takeWord(options: *Options, word: []const u8) -> void {
    var split: usize = 0
    while split < word.length && word[split] != 61 { split += 1 }
    if split + 1 >= word.length { return }
    const name = word[0..split]
    var value: i32 = 0
    if !number(word[split + 1..word.length], &value) { return }
    if std.text.same(name, "mode") && value >= 0 && value <= 4 { options.*.mode = @intCast(u8, value) }
    if std.text.same(name, "aa") { options.*.antialias = value != 0 }
    if std.text.same(name, "feather") { options.*.feather = value }
    if std.text.same(name, "threshold") { options.*.threshold = value }
    if std.text.same(name, "softness") { options.*.softness = value }
    if std.text.same(name, "sample") && value >= 0 && value <= 1 { options.*.sample = @intCast(u8, value) }
    if std.text.same(name, "diagonal") { options.*.diagonal = value != 0 }
    if std.text.same(name, "grow") { options.*.grow = value }
    if std.text.same(name, "radius") { options.*.radius = value }
}

// The options as the settings keep them (the defaults where they say
// nothing readable).
fn loadOptions(app: *App, id: u8, options: *Options) -> void {
    options.* = defaults(id)
    var name: [40]u8 = undefined
    const bytes: [*]u8 = &name
    const length = settingName(id, bytes)
    const text = settings.text(app, bytes[0..length])
    var at: usize = 0
    while at < text.length {
        while at < text.length && text[at] == 32 { at += 1 }
        var end = at
        while end < text.length && text[end] != 32 { end += 1 }
        if end > at { takeWord(options, text[at..end]) }
        at = end
    }
    tidy(options)
}

fn appendPair(into: [*]u8, at: usize, name: []const u8, value: i32) -> usize {
    var length = at
    if length > 0 { length = std.text.appendByte(into, length, 160, 32) }
    length = std.text.append(into, length, 160, name)
    length = std.text.appendByte(into, length, 160, 61)
    return std.text.appendSigned(into, length, 160, @intCast(isize, value))
}

fn flag(value: bool) -> i32 { return if value { 1 } else { 0 } }

// The options of tool `id` kept in the settings (written at once).
fn saveOptions(app: *App, id: u8, options: *const Options) -> void {
    var text: [160]u8 = undefined
    const bytes: [*]u8 = &text
    var length = appendPair(bytes, 0, "mode", @intCast(i32, options.*.mode))
    length = appendPair(bytes, length, "aa", flag(options.*.antialias))
    length = appendPair(bytes, length, "feather", options.*.feather)
    length = appendPair(bytes, length, "threshold", options.*.threshold)
    length = appendPair(bytes, length, "softness", options.*.softness)
    length = appendPair(bytes, length, "sample", @intCast(i32, options.*.sample))
    length = appendPair(bytes, length, "diagonal", flag(options.*.diagonal))
    length = appendPair(bytes, length, "grow", options.*.grow)
    length = appendPair(bytes, length, "radius", options.*.radius)
    var name: [40]u8 = undefined
    const name_bytes: [*]u8 = &name
    const name_length = settingName(id, name_bytes)
    _ = settings.setText(app, name_bytes[0..name_length], bytes[0..length])
}

// The record of tool `id` (null: not one of these, or no memory).
fn workOf(app: *App, id: u8) -> ?*Work {
    if !isOurs(id) { return null }
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, id), @sizeOf(Work))
    if memory == null { return null }
    const work: *Work = unsafe { @ptrCast(*Work, memory.?) }
    if !work.*.ready {
        loadOptions(app, id, &work.*.options)
        work.*.phase = IDLE
        work.*.ready = true
    }
    return work
}

// The record of the tool in use when it is one of these.
fn active(app: *App) -> ?*Work {
    return workOf(app, app.*.tool)
}

// The options of selection tool `id` as its options panel shows them
// (null: `id` is none of them, or no memory). Who changes them says
// keepOptions() afterwards.
pub fn optionsOf(app: *App, id: u8) -> ?*Options {
    const work = workOf(app, id)
    if work == null { return null }
    return &work.?.*.options
}

// The options of tool `id` are held to their ranges and kept in the
// settings.
pub fn keepOptions(app: *App, id: u8) -> void {
    const work = workOf(app, id)
    if work == null { return }
    tidy(&work.?.*.options)
    saveOptions(app, id, &work.?.*.options)
}

// ---------------------------------------------------------------------------
// Points

fn valuesOf(list: *Points) -> [*]f64 {
    unsafe { return @ptrFromInt([*]f64, list.*.address) }
}

// (x, y) after the points; false when there is no room (no memory, or
// MOST_POINTS of them).
fn push(app: *App, list: *Points, x: f64, y: f64) -> bool {
    if list.*.count >= list.*.capacity {
        if list.*.capacity >= MOST_POINTS { return false }
        var more: usize = 256
        if list.*.capacity > 0 { more = list.*.capacity * 2 }
        if more > MOST_POINTS { more = MOST_POINTS }
        var memory: ?[*]u8 = null
        if list.*.capacity == 0 {
            memory = app.*.allocator.alloc(more * 16, 16)
        } else {
            const old: [*]u8 = unsafe { @ptrFromInt([*]u8, list.*.address) }
            memory = app.*.allocator.resize(old, list.*.capacity * 16, more * 16, 16)
        }
        if memory == null { return false }
        list.*.address = @intFromPtr(memory.?)
        list.*.capacity = more
    }
    const values = valuesOf(list)
    values[list.*.count * 2] = x
    values[list.*.count * 2 + 1] = y
    list.*.count += 1
    return true
}

fn pointX(list: *Points, index: usize) -> f64 { return valuesOf(list)[index * 2] }
fn pointY(list: *Points, index: usize) -> f64 { return valuesOf(list)[index * 2 + 1] }

// No points; a large block is given back (brixOS counts every block
// above 32 KiB as one of a process's few memory regions).
fn emptied(app: *App, list: *Points) -> void {
    list.*.count = 0
    if list.*.capacity * 16 > KEPT_BYTES {
        const old: [*]u8 = unsafe { @ptrFromInt([*]u8, list.*.address) }
        app.*.allocator.free(old, list.*.capacity * 16, 16)
        list.*.address = 0
        list.*.capacity = 0
    }
}

// The work's path given back when it held a long outline (its points
// are a block of their own that would stay that large).
fn trimPath(work: *Work) -> void {
    if work.*.path == 0 { return }
    const path: *raster.Path = unsafe { @ptrFromInt(*raster.Path, work.*.path) }
    if raster.pointCount(path) <= KEPT_BYTES / 16 { return }
    raster.destroy(path)
    work.*.path = 0
}

// The work's path, made at the first asking and emptied (null without
// memory).
fn freshPath(app: *App, work: *Work) -> ?*raster.Path {
    if work.*.path == 0 {
        const made = raster.create(app.*.allocator)
        if made == null { return null }
        work.*.path = @intFromPtr(made.?)
    }
    const path: *raster.Path = unsafe { @ptrFromInt(*raster.Path, work.*.path) }
    raster.clear(path)
    return path
}

// ---------------------------------------------------------------------------
// Modes and names

// The keys held now, as the window says. (Not the press's
// input.modifiers: app/loop.mlx takes those from a key's event, and the
// event of a modifier let go comes before the window drops its bit, so
// they still hold Shift after it went up, until another key comes.)
fn keysHeld(app: *App) -> u32 {
    return shell_module.modifiers(app.*.shell)
}

// The mode a press with `modifiers` held takes.
fn modeOf(work: *Work, modifiers: u32) -> u8 {
    const shift = modifiers & keys.SHIFT != 0
    const alt = modifiers & keys.ALT != 0
    if shift && alt { return selection.INTERSECT }
    if shift { return selection.ADD }
    if alt { return selection.SUBTRACT }
    // (Options changed through optionsOf() may not be tidied yet.)
    if work.*.options.mode > selection.SYMMETRIC_DIFFERENCE { return selection.REPLACE }
    return work.*.options.mode
}

// What people read for a mode (short: it stands beside the mode's
// buttons).
fn modeName(app: *App, mode: u8) -> []const u8 {
    if mode == selection.ADD { return state.tr(app, "Add", "Hinzufügen") }
    if mode == selection.SUBTRACT { return state.tr(app, "Subtract", "Abziehen") }
    if mode == selection.INTERSECT { return state.tr(app, "Intersect", "Schnittmenge") }
    if mode == selection.SYMMETRIC_DIFFERENCE { return state.tr(app, "Difference", "Differenz") }
    return state.tr(app, "Replace", "Ersetzen")
}

// What a mode's button says when the pointer rests on it: what it does
// and the keys that choose it for one press.
fn modeTip(app: *App, mode: u8) -> []const u8 {
    if mode == selection.ADD { return state.tr(app, "Add to the selection (Shift)", "Zur Auswahl hinzufügen (Umschalt)") }
    if mode == selection.SUBTRACT { return state.tr(app, "Subtract from the selection (Alt)", "Von der Auswahl abziehen (Alt)") }
    if mode == selection.INTERSECT { return state.tr(app, "Keep only where both are (Shift+Alt)", "Nur wo beide sind (Umschalt+Alt)") }
    if mode == selection.SYMMETRIC_DIFFERENCE { return state.tr(app, "Where one of the two is, not both", "Wo eines der beiden ist, nicht beide") }
    return state.tr(app, "Replace the selection", "Auswahl ersetzen")
}

// The history's name of a step made in `mode`.
fn stepName(app: *App, mode: u8) -> []const u8 {
    if mode == selection.ADD { return state.tr(app, "Add to Selection", "Zur Auswahl hinzufügen") }
    if mode == selection.SUBTRACT { return state.tr(app, "Subtract from Selection", "Von der Auswahl abziehen") }
    if mode == selection.INTERSECT { return state.tr(app, "Intersect Selection", "Auswahl schneiden") }
    if mode == selection.SYMMETRIC_DIFFERENCE { return state.tr(app, "Symmetric Difference", "Symmetrische Differenz") }
    return state.tr(app, "Select", "Auswählen")
}

// The sign shown at the pointer for a mode ("": none for Replace).
fn modeSign(mode: u8) -> []const u8 {
    if mode == selection.ADD { return "+" }
    if mode == selection.SUBTRACT { return "\u{2212}" }
    if mode == selection.INTERSECT { return "\u{2229}" }
    if mode == selection.SYMMETRIC_DIFFERENCE { return "\u{2295}" }
    return ""
}

fn noMemory(app: *App) -> void {
    api.say(app, state.tr(app, "There is not enough memory for the selection", "Für die Auswahl ist nicht genug Speicher da"), true)
}

// ---------------------------------------------------------------------------
// Places

// A coordinate as a whole pixel (held far inside an i32: what comes from
// the view may be anything).
fn whole(value: f64) -> i32 {
    if !(value > -100000000.0) { return -100000000 }
    if value > 100000000.0 { return 100000000 }
    return @intFromFloat(i32, @floor(value))
}

// The corner of the pixel grid nearest to a coordinate (from a half on
// the one before: a pointer on a pixel's middle at zoom 1 takes that
// pixel's own corner).
fn corner(value: f64) -> i32 {
    if !(value > -100000000.0) { return -100000000 }
    if value > 100000000.0 { return 100000000 }
    return @intFromFloat(i32, @ceil(value - 0.5))
}

fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }
fn distance(a: i32, b: i32) -> i32 { return if a > b { a - b } else { b - a } }

// A box of corners of the pixel grid (x0 <= x1, y0 <= y1).
const Box = struct {
    x0: i32
    y0: i32
    x1: i32
    y1: i32
}

// The box the drag spans: from the press to the pointer, a square when
// Shift went down after the press, around the press when Alt did.
fn boxOf(work: *Work) -> Box {
    var sx = corner(work.*.startX)
    var sy = corner(work.*.startY)
    var ex = corner(work.*.nowX)
    var ey = corner(work.*.nowY)
    const late = work.*.keysNow & ~work.*.held
    if late & keys.SHIFT != 0 {
        const side = larger(distance(ex, sx), distance(ey, sy))
        ex = if ex < sx { sx - side } else { sx + side }
        ey = if ey < sy { sy - side } else { sy + side }
    }
    if late & keys.ALT != 0 {
        sx = sx - (ex - sx)
        sy = sy - (ey - sy)
    }
    return Box.{ .x0 = smaller(sx, ex), .y0 = smaller(sy, ey), .x1 = larger(sx, ex), .y1 = larger(sy, ey) }
}

// The image's rectangle a shape is kept to: the image and as far around
// it as a feather reaches in (so that the edge fades as if the shape went
// on).
fn reachOf(image: *Image, feather: i32) -> geom.Rect {
    return geom.grown(image_module.bounds(image), feather + 1)
}

// Whether `image` is the one the work under way was begun on.
fn isWorkImage(work: *Work, image: *Image) -> bool {
    return @intFromPtr(image) == work.*.image && image.*.number == work.*.imageNumber
}

// Whether the image in front is the one the work under way was begun on.
fn inFront(app: *App, work: *Work) -> bool {
    const image = api.image(app)
    return image != null && isWorkImage(work, image.?)
}

// The open image the work under way was begun on (null: it was closed).
fn openImage(app: *App, work: *Work) -> ?*Image {
    var found: ?*Image = null
    var index: usize = 0
    while index < app.*.count {
        const doc = app.*.documents[index]
        if doc != null && isWorkImage(work, doc.?.*.image) { found = doc.?.*.image }
        index += 1
    }
    return found
}

// What is under way is dropped: a moved outline goes back on its image
// (when that is still open).
fn drop(app: *App, work: *Work) -> void {
    if work.*.phase == MOVING {
        const image = openImage(app, work)
        if image != null { ops.cancelSelection(image.?) }
    }
    work.*.phase = IDLE
    work.*.pulling = false
    work.*.points.count = 0
    work.*.wireValid = false
}

// The image the tool's action is on, when it is still the one in front
// (null: it is not, and what was under way is dropped, not finished).
fn imageOf(app: *App, work: *Work) -> ?*Image {
    if !inFront(app, work) {
        drop(app, work)
        return null
    }
    return api.image(app)
}

// The feather radius of the options, held to its range.
fn featherOf(work: *Work) -> i32 {
    return held(work.*.options.feather, 0, MOST_FEATHER)
}

// The magnetic outline's search radius, held to its range (the search's
// box is laid out by it: below LEAST_RADIUS its corners would not reach
// the two ends).
fn radiusOf(work: *Work) -> i32 {
    return held(work.*.options.radius, LEAST_RADIUS, MOST_RADIUS)
}

// The window's distance (in pixels at the theme's scale) of the pointer
// from the press is more than a click's.
fn farFromPress(app: *App, work: *Work, input: *const Input) -> bool {
    const reach = state.px(app, CLICK_REACH)
    return distance(input.*.windowX, work.*.pressX) > reach || distance(input.*.windowY, work.*.pressY) > reach
}

// Whether the pointer is within CLOSE_REACH window pixels of image point
// (x, y).
fn nearPoint(app: *App, input_x: i32, input_y: i32, x: f64, y: f64) -> bool {
    const doc = api.document(app)
    if doc == null { return false }
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(&doc.?.*.view, x, y, &wx, &wy)
    const reach = @floatFromInt(f64, state.px(app, CLOSE_REACH))
    const dx = wx - (@floatFromInt(f64, input_x) + 0.5)
    const dy = wy - (@floatFromInt(f64, input_y) + 0.5)
    return dx * dx + dy * dy <= reach * reach
}

// What the colour tools and the magnetic outline look at.
fn sampleOf(image: *Image, sample: u8) -> *Device {
    if sample == SAMPLE_LAYER && image.*.active != null && image.*.active.?.*.device != null { return image.*.active.?.*.device.? }
    _ = render.update(image)
    return image.*.projection
}

// ---------------------------------------------------------------------------
// Making the selection

// The shape (a mask the caller made and ends) joined with the image's
// selection in the mode of the action, its edge softened by `feather`
// pixels first: one step of the history. Nothing changes without memory
// (the status bar says so).
fn commit(app: *App, work: *Work, image: *Image, shape: *Device, feather: i32) -> void {
    var done = true
    if feather > 0 { done = selection.feather(shape, @floatFromInt(f64, feather)) }
    ops.beginSelection(image)
    if done { done = selection.combine(image.*.selection, shape, work.*.mode) }
    if done { done = selection.clip(image.*.selection, image_module.bounds(image)) }
    if !done {
        ops.cancelSelection(image)
        noMemory(app)
        return
    }
    ops.endSelection(image, true, stepName(app, work.*.mode))
    api.redraw(app)
}

// A press that made no shape: in Replace mode the selection goes (one
// step, when there was one); in the other modes nothing happens.
fn clickedAside(app: *App, work: *Work, image: *Image) -> void {
    if work.*.mode != selection.REPLACE || !image.*.selected { return }
    ops.beginSelection(image)
    ops.endSelection(image, false, state.tr(app, "Deselect", "Auswahl aufheben"))
    api.redraw(app)
}

// The box joined with the selection.
fn selectBox(app: *App, work: *Work, image: *Image, box: Box) -> void {
    if box.x1 <= box.x0 || box.y1 <= box.y0 {
        clickedAside(app, work, image)
        return
    }
    const shape = mask_module.create(app.*.allocator, false)
    if shape == null {
        noMemory(app)
        return
    }
    const area = geom.intersect(geom.rect(box.x0, box.y0, box.x1 - box.x0, box.y1 - box.y0), reachOf(image, featherOf(work)))
    if device_module.fill(shape.?, area, mask_module.ALL) {
        commit(app, work, image, shape.?, featherOf(work))
    } else {
        noMemory(app)
    }
    device_module.destroy(shape.?)
}

// What the path encloses (any winding) joined with the selection.
fn selectPath(app: *App, work: *Work, image: *Image, path: *raster.Path) -> void {
    if raster.failed(path) {
        noMemory(app)
        return
    }
    const shape = mask_module.create(app.*.allocator, false)
    if shape == null {
        noMemory(app)
        return
    }
    const covered = raster.fillMask(shape.?, path, raster.NONZERO, work.*.options.antialias, reachOf(image, featherOf(work)), 255, raster.REPLACE)
    if geom.isEmpty(covered) {
        clickedAside(app, work, image)
    } else {
        commit(app, work, image, shape.?, featherOf(work))
    }
    device_module.destroy(shape.?)
}

// The colour at image point (x, y) of what is sampled, joined with the
// selection: the region it is part of (CONTIGUOUS) or every pixel like it
// (SIMILAR), grown and feathered as the options say.
fn selectColor(app: *App, work: *Work, image: *Image, id: u8, x: f64, y: f64) -> void {
    const px = whole(x)
    const py = whole(y)
    const area = image_module.bounds(image)
    if !geom.contains(area, px, py) {
        clickedAside(app, work, image)
        return
    }
    const sample = sampleOf(image, work.*.options.sample)
    const shape = mask_module.create(app.*.allocator, false)
    if shape == null {
        noMemory(app)
        return
    }
    // (fill's softness is the part of the threshold taken whole.)
    const options = &work.*.fillOptions
    options.* = fill.defaults()
    options.*.threshold = @intCast(u32, held(work.*.options.threshold, 0, 255))
    options.*.softness = @intCast(u32, 100 - held(work.*.options.softness, 0, 100))
    options.*.contiguous = id == CONTIGUOUS
    options.*.diagonal = work.*.options.diagonal
    options.*.grow = held(work.*.options.grow, -MOST_GROW, MOST_GROW)
    options.*.feather = @floatFromInt(f64, featherOf(work))
    options.*.stopAtImageEdge = false
    var found = geom.empty()
    if id == CONTIGUOUS {
        found = fill.region(sample, px, py, area, options, shape.?)
    } else {
        found = fill.similar(sample, device_module.pixel(sample, px, py), area, options, shape.?)
    }
    // (What was clicked is always found; nothing found is no memory, or
    // all of it shrunk away.)
    if geom.isEmpty(found) && work.*.options.grow >= 0 {
        noMemory(app)
    } else {
        commit(app, work, image, shape.?, 0)
    }
    device_module.destroy(shape.?)
}

// ---------------------------------------------------------------------------
// The magnetic outline: edges between the pixels, ways along them

// The tone of a pixel edges are found in: its lightness, over a middle
// grey as far as it is transparent (a black line on nothing is an edge
// as much as one on white).
inline fn tone(value: u32) -> u32 {
    return pixel.lerp(128, pixel.luma(value), value >> 24)
}

// How strong an edge passes through a corner of the pixel grid, 0-255,
// from the tones of the four pixels around it (above left, above right,
// below left, below right): a step from black to white is 255 along a
// straight edge and at its corners.
inline fn strength(a: u32, b: u32, c: u32, d: u32) -> u32 {
    const right = b + d
    const left = a + c
    const below = c + d
    const above = a + b
    const across = if right > left { right - left } else { left - right }
    const down = if below > above { below - above } else { above - below }
    const sum = (across + down) / 2
    return if sum > 255 { 255 } else { sum }
}

// The pixels of `area` of `sample` as tones, into `into` (`area.width`
// words a row).
fn readTones(sample: *Device, area: geom.Rect, into: [*]u32) -> void {
    device_module.readRect(sample, area, into, @intCast(usize, area.width))
    const count = @intCast(usize, area.width) * @intCast(usize, area.height)
    var index: usize = 0
    while index < count {
        into[index] = tone(into[index])
        index += 1
    }
}

// The corner of the pixel grid within `reach` of image point (x, y) on
// the strongest edge of `sample` (of the strongest the nearest), into
// `into_x`, `into_y`; the nearest corner when no edge there is worth it
// (or without memory).
fn snap(sample: *Device, x: f64, y: f64, reach: i32, into_x: *i32, into_y: *i32) -> void {
    const cx = corner(x)
    const cy = corner(y)
    into_x.* = cx
    into_y.* = cy
    if reach <= 0 { return }
    const side = reach * 2 + 2
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const tones = scratch.words(pool, @intCast(usize, side * side))
    if tones == null {
        scratch.release(pool, mark)
        return
    }
    readTones(sample, geom.rect(cx - reach - 1, cy - reach - 1, side, side), tones.?)
    const stride = @intCast(usize, side)
    var found = false
    var best: u32 = 0
    var nearest: i32 = 0
    var j = -reach
    while j <= reach {
        var i = -reach
        while i <= reach {
            const away = i * i + j * j
            if away <= reach * reach {
                const at = @intCast(usize, j + reach) * stride + @intCast(usize, i + reach)
                const g = strength(tones.?[at], tones.?[at + 1], tones.?[at + stride], tones.?[at + stride + 1])
                if g >= SNAP_LEAST && (!found || g > best || (g == best && away < nearest)) {
                    found = true
                    best = g
                    nearest = away
                    into_x.* = cx + i
                    into_y.* = cy + j
                }
            }
            i += 1
        }
        j += 1
    }
    scratch.release(pool, mark)
}

// The binary heap of the search: corner numbers, the nearest first;
// `place` says where each is in it.
fn heapUp(heap: [*]u32, place: [*]u32, reached: [*]const u32, at: usize) -> void {
    var k = at
    const node = heap[k]
    const key = reached[node]
    while k > 0 {
        const parent = (k - 1) / 2
        const other = heap[parent]
        if reached[other] <= key { break }
        heap[k] = other
        place[other] = @intCast(u32, k)
        k = parent
    }
    heap[k] = node
    place[node] = @intCast(u32, k)
}

fn heapDown(heap: [*]u32, place: [*]u32, reached: [*]const u32, size: usize) -> void {
    var k: usize = 0
    const node = heap[0]
    const key = reached[node]
    while true {
        const first = k * 2 + 1
        if first >= size { break }
        var child = first
        if first + 1 < size && reached[heap[first + 1]] < reached[heap[first]] { child = first + 1 }
        if reached[heap[child]] >= key { break }
        heap[k] = heap[child]
        place[heap[k]] = @intCast(u32, k)
        k = child
    }
    heap[k] = node
    place[node] = @intCast(u32, k)
}

// The step to neighbour `direction` (0-7 round the corner row by row,
// the corner itself left out) across and down, and its length (5
// straight, 7 diagonal: about 1.4 straight ones). Tables of numbers: the
// search reads them for every neighbour of every corner it settles.
const STEP_X = [8]i32{ -1, 0, 1, -1, 1, -1, 0, 1 }
const STEP_Y = [8]i32{ -1, -1, -1, 0, 0, 1, 1, 1 }
const STEP_LENGTH = [8]u32{ 7, 5, 7, 5, 5, 7, 5, 7 }

// The working memory of one search over `count` corners.
const Search = struct {
    tones: [*]u32
    weight: [*]u32
    reached: [*]u32
    came: [*]u8
    place: [*]u32
    heap: [*]u32
}

fn searchMemory(pool: *scratch.Pool, count: usize, tones: usize, into: *Search) -> bool {
    const a = scratch.words(pool, tones)
    const b = scratch.words(pool, count)
    const c = scratch.words(pool, count)
    const d = scratch.bytes(pool, count)
    const e = scratch.words(pool, count)
    const f = scratch.words(pool, count)
    if a == null || b == null || c == null || d == null || e == null || f == null { return false }
    into.*.tones = a.?
    into.*.weight = b.?
    into.*.reached = c.?
    into.*.came = d.?
    into.*.place = e.?
    into.*.heap = f.?
    return true
}

// What a step onto each corner of the box costs: 1 on the strongest edge
// up to 256 where there is none; 0 (no way) farther than `reach` from the
// line between the two ends (sx, sy) and (ex, ey) (box corners).
fn weigh(s: *Search, wide: usize, high: usize, sx: f64, sy: f64, ex: f64, ey: f64, reach: i32) -> void {
    const dx = ex - sx
    const dy = ey - sy
    const length2 = dx * dx + dy * dy
    const limit = @floatFromInt(f64, reach * reach)
    const stride = wide + 1
    var j: usize = 0
    while j < high {
        var i: usize = 0
        while i < wide {
            const px = @floatFromInt(f64, i) - sx
            const py = @floatFromInt(f64, j) - sy
            var t = (px * dx + py * dy) / length2
            if t < 0.0 { t = 0.0 }
            if t > 1.0 { t = 1.0 }
            const qx = px - t * dx
            const qy = py - t * dy
            const node = j * wide + i
            if qx * qx + qy * qy <= limit {
                const at = j * stride + i
                const g = strength(s.*.tones[at], s.*.tones[at + 1], s.*.tones[at + stride], s.*.tones[at + stride + 1])
                s.*.weight[node] = 256 - g
            } else {
                s.*.weight[node] = 0
            }
            s.*.reached[node] = FAR
            s.*.place[node] = OUTSIDE
            i += 1
        }
        j += 1
    }
}

// Dijkstra's search from corner `source` to corner `target` of a box
// `wide` corners across: true when it got there (`came` then leads back).
fn search(s: *Search, wide: usize, high: usize, source: usize, target: usize) -> bool {
    s.*.reached[source] = 0
    s.*.heap[0] = @intCast(u32, source)
    s.*.place[source] = 0
    var size: usize = 1
    while size > 0 {
        const node = @intCast(usize, s.*.heap[0])
        size -= 1
        if size > 0 {
            s.*.heap[0] = s.*.heap[size]
            s.*.place[s.*.heap[0]] = 0
            heapDown(s.*.heap, s.*.place, s.*.reached, size)
        }
        s.*.place[node] = SETTLED
        if node == target { return true }
        const x = @intCast(i32, node % wide)
        const y = @intCast(i32, node / wide)
        const columns = @intCast(i32, wide)
        const rows = @intCast(i32, high)
        const here = s.*.weight[node]
        var direction: usize = 0
        while direction < 8 {
            const nx = x + STEP_X[direction]
            const ny = y + STEP_Y[direction]
            if nx >= 0 && ny >= 0 && nx < columns && ny < rows {
                const next = @intCast(usize, ny) * wide + @intCast(usize, nx)
                const there = s.*.weight[next]
                if there != 0 && s.*.place[next] != SETTLED {
                    // (No sum overflows: a way is the shortest, so it
                    // crosses each of the at most MOST_CORNERS corners
                    // once, at most 512 * 7 a step.)
                    const way = s.*.reached[node] + (here + there) * STEP_LENGTH[direction]
                    if way < s.*.reached[next] {
                        s.*.reached[next] = way
                        s.*.came[next] = @intCast(u8, direction)
                        if s.*.place[next] == OUTSIDE {
                            s.*.heap[size] = @intCast(u32, next)
                            size += 1
                            heapUp(s.*.heap, s.*.place, s.*.reached, size - 1)
                        } else {
                            heapUp(s.*.heap, s.*.place, s.*.reached, @intCast(usize, s.*.place[next]))
                        }
                    }
                }
            }
            direction += 1
        }
    }
    return false
}

// Adds to `into` the way from corner (fx, fy) to corner (tx, ty) along the
// strongest edges of `sample` within `reach` of the straight line between
// them: its corners after (fx, fy) up to (tx, ty), a straight run as its
// two ends. A box of more than `most` corners (or no working memory) is
// not searched: the way is then the straight line. Returns whether the
// edges were followed; `into` may lack points when memory ran out.
fn edgeWay(app: *App, sample: *Device, fx: i32, fy: i32, tx: i32, ty: i32, reach: i32, most: usize, into: *Points) -> bool {
    if fx == tx && fy == ty { return true }
    const left = smaller(fx, tx) - reach
    const top = smaller(fy, ty) - reach
    const wide = @intCast(usize, larger(fx, tx) + reach - left + 1)
    const high = @intCast(usize, larger(fy, ty) + reach - top + 1)
    if wide > most || high > most || wide * high > most {
        _ = push(app, into, @floatFromInt(f64, tx), @floatFromInt(f64, ty))
        return false
    }
    const count = wide * high
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    var s: Search = undefined
    if !searchMemory(pool, count, (wide + 1) * (high + 1), &s) {
        scratch.release(pool, mark)
        _ = push(app, into, @floatFromInt(f64, tx), @floatFromInt(f64, ty))
        return false
    }
    readTones(sample, geom.rect(left - 1, top - 1, @intCast(i32, wide + 1), @intCast(i32, high + 1)), s.tones)
    weigh(&s, wide, high, @floatFromInt(f64, fx - left), @floatFromInt(f64, fy - top), @floatFromInt(f64, tx - left), @floatFromInt(f64, ty - top), reach)
    const source = @intCast(usize, fy - top) * wide + @intCast(usize, fx - left)
    const target = @intCast(usize, ty - top) * wide + @intCast(usize, tx - left)
    if !search(&s, wide, high, source, target) {
        scratch.release(pool, mark)
        _ = push(app, into, @floatFromInt(f64, tx), @floatFromInt(f64, ty))
        return false
    }
    // Back from the target (into the heap's memory, done with), then out
    // in order: a corner only where the way turns, and the last.
    var length: usize = 0
    var node = target
    while node != source && length < count {
        s.heap[length] = @intCast(u32, node)
        length += 1
        const direction = @intCast(usize, s.came[node])
        const x = @intCast(i32, node % wide) - STEP_X[direction]
        const y = @intCast(i32, node / wide) - STEP_Y[direction]
        node = @intCast(usize, y) * wide + @intCast(usize, x)
    }
    var k = length
    while k > 0 {
        k -= 1
        const at = @intCast(usize, s.heap[k])
        if k == 0 || s.came[@intCast(usize, s.heap[k - 1])] != s.came[at] {
            _ = push(app, into, @floatFromInt(f64, @intCast(i32, at % wide) + left), @floatFromInt(f64, @intCast(i32, at / wide) + top))
        }
    }
    scratch.release(pool, mark)
    return true
}

// The magnetic outline's way from its last anchor to where the pointer
// would set the next, to be shown (worked out again when the pointer
// came to another corner).
fn updateWire(app: *App, work: *Work, image: *Image) -> void {
    if work.*.points.count == 0 || !work.*.pointerSeen { return }
    const sample = sampleOf(image, work.*.options.sample)
    var cx: i32 = 0
    var cy: i32 = 0
    snap(sample, work.*.pointerX, work.*.pointerY, SNAP, &cx, &cy)
    if work.*.wireValid && cx == work.*.wireX && cy == work.*.wireY { return }
    work.*.wire.count = 0
    const last = work.*.points.count - 1
    _ = edgeWay(app, sample, whole(pointX(&work.*.points, last)), whole(pointY(&work.*.points, last)), cx, cy, radiusOf(work), MOST_SHOWN, &work.*.wire)
    work.*.wireX = cx
    work.*.wireY = cy
    work.*.wireValid = true
}

// The way from the magnetic outline's last point to corner (cx, cy) added
// to it.
fn followTo(app: *App, work: *Work, image: *Image, cx: i32, cy: i32) -> void {
    const last = work.*.points.count - 1
    const sample = sampleOf(image, work.*.options.sample)
    if !edgeWay(app, sample, whole(pointX(&work.*.points, last)), whole(pointY(&work.*.points, last)), cx, cy, radiusOf(work), MOST_CORNERS, &work.*.points) {
        api.say(app, state.tr(app, "Too far apart to follow the edges: joined by a straight line", "Zu weit auseinander, um den Kanten zu folgen: gerade verbunden"), false)
    }
    work.*.wireValid = false
}

// ---------------------------------------------------------------------------
// Outlines placed a click at a time

// The bezier outline's path: from anchor to anchor a curve whose first
// control point is the one anchor's handle and whose second is the other's
// handle mirrored about it; `closed`: back to the first likewise.
fn bezierPath(work: *Work, path: *raster.Path, closed: bool) -> void {
    const list = &work.*.points
    const anchors = list.*.count / 2
    if anchors == 0 { return }
    raster.moveTo(path, pointX(list, 0), pointY(list, 0))
    var k: usize = 1
    while k <= anchors {
        if k == anchors && !closed { break }
        const at = (k % anchors) * 2
        const before = (k - 1) * 2
        const ax = pointX(list, at)
        const ay = pointY(list, at)
        raster.cubicTo(path, pointX(list, before + 1), pointY(list, before + 1), ax * 2.0 - pointX(list, at + 1), ay * 2.0 - pointY(list, at + 1), ax, ay)
        k += 1
    }
    if closed { raster.close(path) }
}

// The points as one closed polygon.
fn polygonPath(list: *Points, path: *raster.Path) -> void {
    var index: usize = 0
    while index < list.*.count {
        if index == 0 {
            raster.moveTo(path, pointX(list, 0), pointY(list, 0))
        } else {
            raster.lineTo(path, pointX(list, index), pointY(list, index))
        }
        index += 1
    }
    raster.close(path)
}

// How many corners or anchors the outline has.
fn placed(work: *Work, id: u8) -> usize {
    if id == BEZIER { return work.*.points.count / 2 }
    if id == MAGNETIC { return work.*.anchorCount }
    return work.*.points.count
}

// Whether it has enough of them to enclose something.
fn enough(work: *Work, id: u8) -> bool {
    return placed(work, id) >= (if id == POLYGON { 3 } else { 2 })
}

// Nothing under way; large blocks of points given back.
fn forget(app: *App, work: *Work) -> void {
    work.*.phase = IDLE
    work.*.pulling = false
    work.*.anchorCount = 0
    work.*.wireValid = false
    emptied(app, &work.*.points)
    emptied(app, &work.*.wire)
    trimPath(work)
}

// The outline placed so far, closed, joined with the selection.
fn close(app: *App, work: *Work, image: *Image, id: u8) -> void {
    if !enough(work, id) {
        forget(app, work)
        api.canvasChanged(app)
        return
    }
    if id == MAGNETIC { followTo(app, work, image, whole(pointX(&work.*.points, 0)), whole(pointY(&work.*.points, 0))) }
    const path = freshPath(app, work)
    if path == null {
        noMemory(app)
    } else {
        if id == BEZIER { bezierPath(work, path.?, true) } else { polygonPath(&work.*.points, path.?) }
        selectPath(app, work, image, path.?)
    }
    forget(app, work)
    api.canvasChanged(app)
}

// The press of a corner, an anchor, or what closes the outline. (An
// outline begun on another image is dropped: this press begins one.)
fn pressPoint(app: *App, work: *Work, image: *Image, input: *const Input, id: u8) -> void {
    if work.*.phase == PLACING && !isWorkImage(work, image) { drop(app, work) }
    if work.*.phase == PLACING {
        const near_first = work.*.points.count > 0 && nearPoint(app, input.*.windowX, input.*.windowY, pointX(&work.*.points, 0), pointY(&work.*.points, 0))
        if input.*.clicks == 2 || near_first {
            if enough(work, id) { close(app, work, image, id) }
            return
        }
    } else {
        if work.*.phase != IDLE { return }
        begin(work, image, input, keysHeld(app))
        work.*.phase = PLACING
        work.*.anchorCount = 0
        work.*.points.count = 0
    }
    const x = input.*.x
    const y = input.*.y
    if id == MAGNETIC {
        if work.*.anchorCount >= MOST_ANCHORS {
            api.say(app, state.tr(app, "The outline has as many anchors as it can take: close it", "Der Umriss hat so viele Anker, wie er fassen kann: schließen Sie ihn"), true)
            return
        }
        var cx: i32 = 0
        var cy: i32 = 0
        snap(sampleOf(image, work.*.options.sample), x, y, SNAP, &cx, &cy)
        const count = work.*.points.count
        if count == 0 {
            if !push(app, &work.*.points, @floatFromInt(f64, cx), @floatFromInt(f64, cy)) { noMemory(app) }
        } else if whole(pointX(&work.*.points, count - 1)) == cx && whole(pointY(&work.*.points, count - 1)) == cy {
            // (An anchor on the last one adds nothing.)
            return
        } else {
            followTo(app, work, image, cx, cy)
        }
        if work.*.points.count == 0 {
            forget(app, work)
            return
        }
        work.*.anchors[work.*.anchorCount] = @intCast(u32, work.*.points.count - 1)
        work.*.anchorCount += 1
    } else if id == BEZIER {
        if !push(app, &work.*.points, x, y) || !push(app, &work.*.points, x, y) {
            noMemory(app)
            if work.*.points.count % 2 == 1 { work.*.points.count -= 1 }
        } else {
            work.*.pulling = true
        }
    } else {
        // (A corner on the last one adds nothing.)
        const count = work.*.points.count
        if count > 0 && pointX(&work.*.points, count - 1) == x && pointY(&work.*.points, count - 1) == y { return }
        if !push(app, &work.*.points, x, y) { noMemory(app) }
    }
    if work.*.points.count == 0 { forget(app, work) }
    api.canvasChanged(app)
}

// The last corner or anchor taken back (the whole outline when it was the
// only one).
fn takeBack(app: *App, work: *Work, id: u8) -> void {
    if id == MAGNETIC {
        if work.*.anchorCount <= 1 {
            forget(app, work)
            return
        }
        work.*.anchorCount -= 1
        work.*.points.count = @intCast(usize, work.*.anchors[work.*.anchorCount - 1]) + 1
        work.*.wireValid = false
        return
    }
    const step: usize = if id == BEZIER { 2 } else { 1 }
    if work.*.points.count <= step {
        forget(app, work)
        return
    }
    work.*.points.count -= step
    work.*.pulling = false
}

// ---------------------------------------------------------------------------
// The tool's events

// The start of an action: its mode, keys, image and places.
fn begin(work: *Work, image: *Image, input: *const Input, modifiers: u32) -> void {
    work.*.mode = modeOf(work, modifiers)
    work.*.held = modifiers & (keys.SHIFT | keys.ALT)
    work.*.keysNow = modifiers
    work.*.image = @intFromPtr(image)
    work.*.imageNumber = image.*.number
    work.*.startX = input.*.x
    work.*.startY = input.*.y
    work.*.nowX = input.*.x
    work.*.nowY = input.*.y
    work.*.pressX = input.*.windowX
    work.*.pressY = input.*.windowY
    work.*.dragged = false
    work.*.movedX = 0
    work.*.movedY = 0
    work.*.pulling = false
    work.*.wireValid = false
}

fn seen(app: *App, work: *Work, input: *const Input) -> void {
    work.*.pointerX = input.*.x
    work.*.pointerY = input.*.y
    work.*.pointerWindowX = input.*.windowX
    work.*.pointerWindowY = input.*.windowY
    work.*.pointerSeen = true
    work.*.keysNow = keysHeld(app)
}

fn press(app: *App, input: *const Input) -> void {
    const found = active(app)
    if found == null || input.*.button != ui_app.BUTTON_LEFT { return }
    const work = found.?
    const image = api.image(app)
    if image == null { return }
    const id = app.*.tool
    seen(app, work, input)
    if id == POLYGON || id == BEZIER || id == MAGNETIC {
        pressPoint(app, work, image.?, input, id)
        return
    }
    if work.*.phase != IDLE { return }
    begin(work, image.?, input, keysHeld(app))
    if id == CONTIGUOUS || id == SIMILAR {
        selectColor(app, work, image.?, id, input.*.x, input.*.y)
        return
    }
    work.*.phase = DRAGGING
    work.*.points.count = 0
    if id == FREEHAND && !push(app, &work.*.points, input.*.x, input.*.y) {
        noMemory(app)
        work.*.phase = IDLE
        return
    }
    // A drag from inside the selection with no key held moves its outline.
    if (id == RECTANGLE || id == ELLIPSE) && work.*.mode == selection.REPLACE && work.*.held == 0 && image.?.*.selected && image_module.selectedAt(image.?, whole(input.*.x), whole(input.*.y)) >= 128 {
        work.*.phase = MOVING
        ops.beginSelection(image.?)
    }
    api.canvasChanged(app)
}

fn move(app: *App, input: *const Input) -> void {
    const found = active(app)
    if found == null { return }
    const work = found.?
    const id = app.*.tool
    seen(app, work, input)
    if work.*.phase == IDLE { return }
    const image = imageOf(app, work)
    if image == null { return }
    if work.*.phase == DRAGGING {
        work.*.nowX = input.*.x
        work.*.nowY = input.*.y
        if !work.*.dragged && farFromPress(app, work, input) { work.*.dragged = true }
        if id == FREEHAND && work.*.points.count > 0 {
            const last = work.*.points.count - 1
            const dx = input.*.x - pointX(&work.*.points, last)
            const dy = input.*.y - pointY(&work.*.points, last)
            const doc = api.document(app)
            const zoom = if doc != null { doc.?.*.view.zoom } else { 1.0 }
            // (Out of room the outline goes on from its last point.)
            if @sqrt(dx * dx + dy * dy) * zoom >= LASSO_STEP { _ = push(app, &work.*.points, input.*.x, input.*.y) }
        }
    } else if work.*.phase == MOVING {
        if !work.*.dragged && !farFromPress(app, work, input) { return }
        work.*.dragged = true
        const dx = whole(math.round(input.*.x - work.*.startX))
        const dy = whole(math.round(input.*.y - work.*.startY))
        if dx != work.*.movedX || dy != work.*.movedY {
            device_module.moveBy(image.?.*.selection, dx - work.*.movedX, dy - work.*.movedY)
            work.*.movedX = dx
            work.*.movedY = dy
            image_module.selectionChanged(image.?)
        }
    } else if work.*.phase == PLACING {
        if id == BEZIER && work.*.pulling && work.*.points.count >= 2 {
            const values = valuesOf(&work.*.points)
            values[(work.*.points.count - 1) * 2] = input.*.x
            values[(work.*.points.count - 1) * 2 + 1] = input.*.y
        }
        if id == MAGNETIC { updateWire(app, work, image.?) }
    }
    api.canvasChanged(app)
}

fn release(app: *App, input: *const Input) -> void {
    const found = active(app)
    if found == null || input.*.button != ui_app.BUTTON_LEFT { return }
    const work = found.?
    const id = app.*.tool
    seen(app, work, input)
    if work.*.phase == PLACING {
        work.*.pulling = false
        return
    }
    if work.*.phase != DRAGGING && work.*.phase != MOVING { return }
    const image = imageOf(app, work)
    if image == null { return }
    if work.*.phase == MOVING {
        work.*.phase = IDLE
        if !work.*.dragged {
            // A click inside the selection: it goes, as anywhere else.
            ops.endSelection(image.?, false, state.tr(app, "Deselect", "Auswahl aufheben"))
        } else if selection.clip(image.?.*.selection, image_module.bounds(image.?)) {
            ops.endSelection(image.?, true, state.tr(app, "Move Selection", "Auswahl verschieben"))
        } else {
            ops.cancelSelection(image.?)
            noMemory(app)
        }
        api.redraw(app)
        return
    }
    work.*.nowX = input.*.x
    work.*.nowY = input.*.y
    work.*.phase = IDLE
    if !work.*.dragged {
        work.*.points.count = 0
        clickedAside(app, work, image.?)
        api.canvasChanged(app)
        return
    }
    if id == FREEHAND {
        _ = push(app, &work.*.points, input.*.x, input.*.y)
        const path = freshPath(app, work)
        if path == null {
            noMemory(app)
        } else {
            polygonPath(&work.*.points, path.?)
            selectPath(app, work, image.?, path.?)
        }
        forget(app, work)
    } else if id == ELLIPSE {
        const box = boxOf(work)
        const path = freshPath(app, work)
        if box.x1 <= box.x0 || box.y1 <= box.y0 {
            clickedAside(app, work, image.?)
        } else if path == null {
            noMemory(app)
        } else {
            const rx = @floatFromInt(f64, box.x1 - box.x0) / 2.0
            const ry = @floatFromInt(f64, box.y1 - box.y0) / 2.0
            raster.ellipse(path.?, @floatFromInt(f64, box.x0) + rx, @floatFromInt(f64, box.y0) + ry, rx, ry)
            selectPath(app, work, image.?, path.?)
        }
    } else {
        selectBox(app, work, image.?, boxOf(work))
    }
    api.canvasChanged(app)
}

// Escape: what is under way goes, a moved outline goes back.
fn cancel(app: *App) -> void {
    const found = active(app)
    if found == null { return }
    drop(app, found.?)
    forget(app, found.?)
    api.canvasChanged(app)
}

// Enter: the outline placed so far is closed.
fn finish(app: *App) -> void {
    const found = active(app)
    if found == null || found.?.*.phase != PLACING { return }
    const work = found.?
    const image = imageOf(app, work)
    if image == null { return }
    close(app, work, image.?, app.*.tool)
}

// Something is under way on the image in front. (What was begun on
// another one is dropped by the next event: undo here need not wait.)
fn busy(app: *App) -> bool {
    const found = active(app)
    return found != null && found.?.*.phase != IDLE && inFront(app, found.?)
}

fn keyPress(app: *App, code: u32, modifiers: u32, down: bool) -> bool {
    const found = active(app)
    if found == null { return false }
    const work = found.?
    // (A modifier let go is still among `modifiers`.)
    work.*.keysNow = if down { modifiers } else { modifiers & ~keys.modifierOf(code) }
    // Shift and Alt change the box being dragged and the sign at the
    // pointer; they are not used up.
    if keys.isModifier(code) {
        api.canvasChanged(app)
        return false
    }
    if !down || code != keys.BACKSPACE || work.*.phase != PLACING || !inFront(app, work) { return false }
    takeBack(app, work, app.*.tool)
    api.canvasChanged(app)
    return true
}

// ---------------------------------------------------------------------------
// The marks over the canvas

// Where image point (x, y) is on the painter's canvas (as the painter
// itself places its marks).
fn placeOf(marks: *const overlay.Painter, x: f64, y: f64, wx: *f64, wy: *f64) -> void {
    const dx = (x - marks.*.centerX) * marks.*.side
    const dy = y - marks.*.centerY
    wx.* = (dx * marks.*.cos - dy * marks.*.sin) * marks.*.zoom + marks.*.middleX
    wy.* = (dx * marks.*.sin + dy * marks.*.cos) * marks.*.zoom + marks.*.middleY
}

// Liang and Barsky's step: the part of a line kept, from `low.*` to
// `high.*` of its length, narrowed to the inner side of one edge of a
// rectangle (`p`: how the line runs across the edge, `q`: how far inside
// it the line starts). False when nothing is left.
fn narrow(p: f64, q: f64, low: *f64, high: *f64) -> bool {
    if p == 0.0 { return q >= 0.0 }
    const r = q / p
    if p < 0.0 {
        if r > high.* { return false }
        if r > low.* { low.* = r }
    } else {
        if r < low.* { return false }
        if r < high.* { high.* = r }
    }
    return true
}

// The part of the line between image points (x0, y0) and (x1, y1) that
// lies on what the painter draws on (and two pixels around it): from
// `low.*` to `high.*` of its length (0 to 1). False when no part does
// (or the line is beyond any canvas).
fn onCanvas(marks: *const overlay.Painter, x0: f64, y0: f64, x1: f64, y1: f64, low: *f64, high: *f64) -> bool {
    var ax: f64 = 0.0
    var ay: f64 = 0.0
    var bx: f64 = 0.0
    var by: f64 = 0.0
    placeOf(marks, x0, y0, &ax, &ay)
    placeOf(marks, x1, y1, &bx, &by)
    if !(math.abs(ax) < 1.0e12 && math.abs(ay) < 1.0e12 && math.abs(bx) < 1.0e12 && math.abs(by) < 1.0e12) { return false }
    const left = @floatFromInt(f64, marks.*.left) - 2.0
    const top = @floatFromInt(f64, marks.*.top) - 2.0
    const right = @floatFromInt(f64, marks.*.right) + 2.0
    const bottom = @floatFromInt(f64, marks.*.bottom) + 2.0
    low.* = 0.0
    high.* = 1.0
    const dx = bx - ax
    const dy = by - ay
    return narrow(-dx, ax - left, low, high) && narrow(dx, right - ax, low, high) && narrow(-dy, ay - top, low, high) && narrow(dy, bottom - ay, low, high)
}

// A piece of a dashed outline from image point (x0, y0) to (x1, y1),
// `start` along the dashes (0 up to two dashes); where it ends along them.
// Only its part on the canvas is drawn: at a high zoom a piece may be
// many thousand dashes long.
fn dashedPiece(marks: *const overlay.Painter, x0: f64, y0: f64, x1: f64, y1: f64, start: f64, dash: f64) -> f64 {
    const period = dash * 2.0
    const dx = x1 - x0
    const dy = y1 - y0
    const length = @sqrt(dx * dx + dy * dy)
    if !(length > 0.0) || length > 1.0e9 { return start }
    const gone = start + length
    const ending = gone - @floor(gone / period) * period
    var low: f64 = 0.0
    var high: f64 = 1.0
    if !onCanvas(marks, x0, y0, x1, y1, &low, &high) { return ending }
    var t = low * length
    const end = high * length
    // Where the dashes are where the part on the canvas begins.
    const ahead = start + t
    var along = ahead - @floor(ahead / period) * period
    if !(along >= 0.0 && along < period) { along = 0.0 }
    // (The part on the canvas is no more dashes long than the canvas is
    // across: the count is only a guard.)
    var pieces: usize = 0
    while t < end && pieces < 65536 {
        const left = if along < dash { dash - along } else { period - along }
        var step = end - t
        if left < step { step = left }
        if !(step > 0.0) { break }
        overlay.plainLine(marks, x0 + dx * t / length, y0 + dy * t / length, x0 + dx * (t + step) / length, y0 + dy * (t + step) / length, if along < dash { BLACK } else { WHITE })
        t += step
        along += step
        if along >= period { along -= period }
        pieces += 1
    }
    return ending
}

// The contours of `path` in black and white dashes of DASH window pixels,
// counted on from piece to piece, so that they go round corners and
// curves as evenly as along a straight line.
fn dashedPath(marks: *const overlay.Painter, path: *raster.Path) -> void {
    const zoom = marks.*.zoom
    if !(zoom > 0.0) { return }
    const dash = @floatFromInt(f64, DASH * marks.*.scale) / zoom
    const contours = raster.contourCount(path)
    var number: usize = 0
    while number < contours {
        const contour = raster.contourAt(path, number)
        if contour.count >= 2 {
            var along: f64 = 0.0
            const pieces = if contour.closed { contour.count } else { contour.count - 1 }
            var index: usize = 0
            while index < pieces {
                const a = raster.vertex(path, contour.first + index)
                const b = raster.vertex(path, contour.first + (index + 1) % contour.count)
                along = dashedPiece(marks, a.x, a.y, b.x, b.y, along, dash)
                index += 1
            }
        }
        number += 1
    }
}

// The contours of `path` as light lines with a dark one beside each
// (overlay.line's), which show on any picture.
fn solidPath(marks: *const overlay.Painter, path: *raster.Path) -> void {
    const contours = raster.contourCount(path)
    var number: usize = 0
    while number < contours {
        const contour = raster.contourAt(path, number)
        if contour.count >= 2 {
            const pieces = if contour.closed { contour.count } else { contour.count - 1 }
            var index: usize = 0
            while index < pieces {
                const a = raster.vertex(path, contour.first + index)
                const b = raster.vertex(path, contour.first + (index + 1) % contour.count)
                var low: f64 = 0.0
                var high: f64 = 1.0
                if onCanvas(marks, a.x, a.y, b.x, b.y, &low, &high) { overlay.line(marks, a.x, a.y, b.x, b.y) }
                index += 1
            }
        }
        number += 1
    }
}

// "W × H" of the box beside its lower right corner, after the sign of
// the mode when it is not Replace.
fn sizeLabel(work: *Work, marks: *const overlay.Painter, box: Box, mode: u8) -> void {
    const bytes: [*]u8 = &work.*.label
    var length: usize = 0
    const sign = modeSign(mode)
    if sign.length > 0 { length = std.text.append(bytes, std.text.append(bytes, 0, 40, sign), 40, "  ") }
    length = std.text.appendUnsigned(bytes, length, 40, @intCast(usize, box.x1 - box.x0))
    length = std.text.append(bytes, length, 40, " \u{00D7} ")
    length = std.text.appendUnsigned(bytes, length, 40, @intCast(usize, box.y1 - box.y0))
    overlay.label(marks, @floatFromInt(f64, box.x1), @floatFromInt(f64, box.y1), bytes[0..length])
}

// The outline being dragged out or placed.
fn drawShape(app: *App, work: *Work, marks: *const overlay.Painter, id: u8) -> void {
    if work.*.phase == DRAGGING && (id == RECTANGLE || id == ELLIPSE) {
        if !work.*.dragged { return }
        const box = boxOf(work)
        if id == RECTANGLE {
            overlay.dashedRect(marks, @floatFromInt(f64, box.x0), @floatFromInt(f64, box.y0), @floatFromInt(f64, box.x1 - box.x0), @floatFromInt(f64, box.y1 - box.y0))
        } else {
            const path = freshPath(app, work)
            if path == null { return }
            const rx = @floatFromInt(f64, box.x1 - box.x0) / 2.0
            const ry = @floatFromInt(f64, box.y1 - box.y0) / 2.0
            if rx > 0.0 && ry > 0.0 {
                raster.ellipse(path.?, @floatFromInt(f64, box.x0) + rx, @floatFromInt(f64, box.y0) + ry, rx, ry)
                dashedPath(marks, path.?)
            }
        }
        sizeLabel(work, marks, box, work.*.mode)
        return
    }
    if work.*.points.count == 0 || (work.*.phase != DRAGGING && work.*.phase != PLACING) { return }
    const path = freshPath(app, work)
    if path == null { return }
    const list = &work.*.points
    if id == BEZIER {
        bezierPath(work, path.?, false)
        // The curve the next anchor would make, to the pointer.
        if !work.*.pulling && work.*.pointerSeen {
            const last = list.*.count - 2
            raster.cubicTo(path.?, pointX(list, last + 1), pointY(list, last + 1), work.*.pointerX, work.*.pointerY, work.*.pointerX, work.*.pointerY)
        }
        dashedPath(marks, path.?)
        var k: usize = 0
        while k < list.*.count {
            overlay.handle(marks, pointX(list, k), pointY(list, k), overlay.SQUARE, k == 0 && nearPoint(app, work.*.pointerWindowX, work.*.pointerWindowY, pointX(list, 0), pointY(list, 0)))
            k += 2
        }
        // The newest anchor's handles.
        const at = list.*.count - 2
        const ax = pointX(list, at)
        const ay = pointY(list, at)
        const hx = pointX(list, at + 1)
        const hy = pointY(list, at + 1)
        if hx != ax || hy != ay {
            overlay.line(marks, ax * 2.0 - hx, ay * 2.0 - hy, hx, hy)
            overlay.handle(marks, hx, hy, overlay.ROUND, work.*.pulling)
            overlay.handle(marks, ax * 2.0 - hx, ay * 2.0 - hy, overlay.ROUND, false)
        }
        return
    }
    var index: usize = 0
    while index < list.*.count {
        if index == 0 { raster.moveTo(path.?, pointX(list, 0), pointY(list, 0)) } else { raster.lineTo(path.?, pointX(list, index), pointY(list, index)) }
        index += 1
    }
    if id == FREEHAND {
        raster.close(path.?)
    } else if id == MAGNETIC && work.*.wireValid {
        index = 0
        while index < work.*.wire.count {
            raster.lineTo(path.?, pointX(&work.*.wire, index), pointY(&work.*.wire, index))
            index += 1
        }
    } else if work.*.pointerSeen {
        raster.lineTo(path.?, work.*.pointerX, work.*.pointerY)
    }
    // The magnetic outline lies on the edges it follows, where dashes of
    // black and white vanish on the side of their own colour: it is drawn
    // as a light line with a dark one beside it instead.
    if id == MAGNETIC { solidPath(marks, path.?) } else { dashedPath(marks, path.?) }
    if id == MAGNETIC {
        var k: usize = 0
        while k < work.*.anchorCount {
            const at = @intCast(usize, work.*.anchors[k])
            overlay.handle(marks, pointX(list, at), pointY(list, at), overlay.SQUARE, k == 0 && nearPoint(app, work.*.pointerWindowX, work.*.pointerWindowY, pointX(list, 0), pointY(list, 0)))
            k += 1
        }
    } else if id == POLYGON {
        overlay.handle(marks, pointX(list, 0), pointY(list, 0), overlay.ROUND, nearPoint(app, work.*.pointerWindowX, work.*.pointerWindowY, pointX(list, 0), pointY(list, 0)))
    }
}

// The sign of the mode a press would take now, beside the pointer, when
// it is not Replace.
fn drawSign(app: *App, work: *Work, marks: *const overlay.Painter, id: u8) -> void {
    const phase = if inFront(app, work) { work.*.phase } else { IDLE }
    if phase == MOVING || !app.*.pointerInside { return }
    // (A box being dragged says it in its size's label.)
    if phase == DRAGGING && work.*.dragged && (id == RECTANGLE || id == ELLIPSE) { return }
    const doc = api.document(app)
    if doc == null || !geom.contains(doc.?.*.view.area, app.*.pointerX, app.*.pointerY) { return }
    const mode = if phase == IDLE { modeOf(work, keysHeld(app)) } else { work.*.mode }
    const sign = modeSign(mode)
    if sign.length == 0 { return }
    // Below and right of the pointer's cross.
    const away = @floatFromInt(f64, state.px(app, 12))
    var x: f64 = 0.0
    var y: f64 = 0.0
    viewport.toImage(&doc.?.*.view, @floatFromInt(f64, app.*.pointerX) + away, @floatFromInt(f64, app.*.pointerY) + away, &x, &y)
    overlay.label(marks, x, y, sign)
}

fn drawOverlay(app: *App, canvas: *Canvas) -> void {
    const found = active(app)
    if found == null { return }
    const marks = overlay.begin(app, canvas)
    if !marks.live { return }
    // (An outline begun on another image is not this one's.)
    if inFront(app, found.?) { drawShape(app, found.?, &marks, app.*.tool) }
    drawSign(app, found.?, &marks, app.*.tool)
}

// ---------------------------------------------------------------------------
// The options

// The ids of the options' widgets.
const PART_MODE: usize = 0
const PART_ANTIALIAS: usize = 8
const PART_FEATHER: usize = 9
const PART_THRESHOLD: usize = 10
const PART_SOFTNESS: usize = 11
const PART_GROW: usize = 12
const PART_SAMPLE: usize = 13
const PART_DIAGONAL: usize = 14
const PART_RADIUS: usize = 15

fn partId(part: usize) -> u64 {
    return view.idOf(view.id("nebula.tools.select"), part)
}

// The id of the options' button for `mode` (tests press it).
pub fn modeButton(mode: u8) -> u64 {
    return partId(PART_MODE + @intCast(usize, mode))
}

fn sampleName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == @intCast(usize, SAMPLE_IMAGE) { return state.tr(app, "Image", "Bild") }
    return state.tr(app, "Active layer", "Aktive Ebene")
}

// A slider for a whole number of the options; true when its change is
// complete (the options are kept then).
fn wholeSlider(kit: *kit_module.Kit, part: usize, area: ui.Rect, text: []const u8, value: *i32, low: i32, high: i32, suffix: []const u8) -> bool {
    var options = kit_module.sliderOptions(@floatFromInt(f64, low), @floatFromInt(f64, high), 1.0, 0)
    options.suffix = suffix
    var shown = @floatFromInt(f64, value.*)
    const id = partId(part)
    if kit_module.slider(kit, id, area, text, &shown, &options) && shown == shown {
        value.* = held(@intFromFloat(i32, math.clamp(math.round(shown), @floatFromInt(f64, low), @floatFromInt(f64, high))), low, high)
    }
    return kit_module.released(kit, id)
}

// The icon of the button for `mode` (Replace: the tool's own picture).
fn modeIcon(id: u8, mode: u8) -> u16 {
    if mode == selection.ADD { return icons.SELECT_ADD }
    if mode == selection.SUBTRACT { return icons.SELECT_SUBTRACT }
    if mode == selection.INTERSECT { return icons.SELECT_INTERSECT }
    if mode == selection.SYMMETRIC_DIFFERENCE { return icons.SELECT_SYMMETRIC }
    return iconOf(id)
}

fn iconOf(id: u8) -> u16 {
    if id == RECTANGLE { return icons.SELECT_RECTANGLE }
    if id == ELLIPSE { return icons.SELECT_ELLIPSE }
    if id == POLYGON { return icons.SELECT_POLYGON }
    if id == FREEHAND { return icons.SELECT_FREEHAND }
    if id == CONTIGUOUS { return icons.SELECT_CONTIGUOUS }
    if id == SIMILAR { return icons.SELECT_SIMILAR }
    if id == BEZIER { return icons.SELECT_BEZIER }
    return icons.SELECT_MAGNETIC
}

// A label at the left of a row and the rest of the row for its widget.
fn labelled(app: *App, kit: *kit_module.Kit, row: ui.Rect, text: []const u8) -> ui.Rect {
    const width = state.px(app, 64)
    kit_module.label(kit, ui.rect(row.x, row.y, width, row.height), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    return ui.rect(row.x + width, row.y, row.width - width, row.height)
}

fn options(app: *App, area: ui.Rect) -> i32 {
    const found = active(app)
    if found == null { return 0 }
    const work = found.?
    const id = app.*.tool
    const kit = api.kit(app)
    const choices = &work.*.options
    const height = state.px(app, kit_module.ROW)
    const pitch = height + state.px(app, 4)
    var keep = false
    var y = area.y

    // How a press with no key joins: a button each, the name of the one
    // chosen beside them.
    var mode: u8 = 0
    var x = area.x
    while mode <= selection.SYMMETRIC_DIFFERENCE {
        const icon = @intCast(usize, modeIcon(id, mode))
        if kit_module.toolButton(kit, modeButton(mode), ui.rect(x, y, height, height), icons.drawFor, icon, choices.*.mode == mode, modeTip(app, mode)) {
            choices.*.mode = mode
            keep = true
        }
        x += height + state.px(app, 2)
        mode += 1
    }
    const rest = ui.rect(x + state.px(app, 6), y, area.x + area.width - x - state.px(app, 6), height)
    if rest.width >= state.px(app, 40) { kit_module.label(kit, rest, modeName(app, choices.*.mode), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT) }
    y += pitch

    if id != RECTANGLE && id != CONTIGUOUS && id != SIMILAR {
        if kit_module.checkBox(kit, partId(PART_ANTIALIAS), ui.rect(area.x, y, area.width, height), state.tr(app, "Anti-aliasing", "Kantenglättung"), &choices.*.antialias) { keep = true }
        y += pitch
    }
    if wholeSlider(kit, PART_FEATHER, ui.rect(area.x, y, area.width, height), state.tr(app, "Feather", "Weiche Kante"), &choices.*.feather, 0, MOST_FEATHER, " px") { keep = true }
    y += pitch

    if id == CONTIGUOUS || id == SIMILAR {
        if wholeSlider(kit, PART_THRESHOLD, ui.rect(area.x, y, area.width, height), state.tr(app, "Threshold", "Schwellwert"), &choices.*.threshold, 0, 255, "") { keep = true }
        y += pitch
        if wholeSlider(kit, PART_SOFTNESS, ui.rect(area.x, y, area.width, height), state.tr(app, "Softness", "Weichheit"), &choices.*.softness, 0, 100, " %") { keep = true }
        y += pitch
        if wholeSlider(kit, PART_GROW, ui.rect(area.x, y, area.width, height), state.tr(app, "Grow / shrink", "Vergrößern / verkleinern"), &choices.*.grow, -MOST_GROW, MOST_GROW, " px") { keep = true }
        y += pitch
    }
    if id == MAGNETIC {
        if wholeSlider(kit, PART_RADIUS, ui.rect(area.x, y, area.width, height), state.tr(app, "Search radius", "Suchradius"), &choices.*.radius, LEAST_RADIUS, MOST_RADIUS, " px") { keep = true }
        y += pitch
    }
    if id == CONTIGUOUS || id == SIMILAR || id == MAGNETIC {
        const box = labelled(app, kit, ui.rect(area.x, y, area.width, height), state.tr(app, "Sample", "Quelle"))
        var chosen = @intCast(usize, choices.*.sample)
        if kit_module.comboBoxWith(kit, partId(PART_SAMPLE), box, 2, sampleName, @intFromPtr(app), &chosen) {
            choices.*.sample = if chosen == 1 { SAMPLE_IMAGE } else { SAMPLE_LAYER }
            keep = true
        }
        y += pitch
    }
    if id == CONTIGUOUS {
        if kit_module.checkBox(kit, partId(PART_DIAGONAL), ui.rect(area.x, y, area.width, height), state.tr(app, "Diagonal neighbours", "Diagonale Nachbarn"), &choices.*.diagonal) { keep = true }
        y += pitch
    }

    // What the keys do.
    const line = state.px(app, 18)
    y += state.px(app, 2)
    kit_module.label(kit, ui.rect(area.x, y, area.width, line), state.tr(app, "Shift: add, Alt: subtract", "Umschalt: hinzu, Alt: abziehen"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    y += line
    kit_module.label(kit, ui.rect(area.x, y, area.width, line), state.tr(app, "Shift+Alt: intersect", "Umschalt+Alt: Schnittmenge"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    y += line
    var more: []const u8 = ""
    if id == RECTANGLE || id == ELLIPSE { more = state.tr(app, "Drag inside: move the outline", "Innen ziehen: Umriss verschieben") }
    if id == POLYGON || id == BEZIER || id == MAGNETIC { more = state.tr(app, "Enter or double-click: close", "Eingabe oder Doppelklick: schließen") }
    if more.length > 0 {
        kit_module.label(kit, ui.rect(area.x, y, area.width, line), more, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        y += line
    }
    if keep {
        tidy(choices)
        saveOptions(app, id, choices)
    }
    return y - area.y
}

// ---------------------------------------------------------------------------
// The table

const TOOLS = [8]state.Tool{
    state.Tool.{ .id = RECTANGLE, .key = "selectrect", .name = "Rectangular Selection", .german = "Rechteckige Auswahl", .shortcut = "Ctrl+R", .icon = icons.SELECT_RECTANGLE, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = ELLIPSE, .key = "selectellipse", .name = "Elliptical Selection", .german = "Elliptische Auswahl", .shortcut = "J", .icon = icons.SELECT_ELLIPSE, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = POLYGON, .key = "selectpolygon", .name = "Polygonal Selection", .german = "Polygonauswahl", .shortcut = "", .icon = icons.SELECT_POLYGON, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = FREEHAND, .key = "selectfreehand", .name = "Freehand Selection", .german = "Freihandauswahl", .shortcut = "", .icon = icons.SELECT_FREEHAND, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = CONTIGUOUS, .key = "selectcontiguous", .name = "Contiguous Selection", .german = "Zusammenhängende Auswahl", .shortcut = "", .icon = icons.SELECT_CONTIGUOUS, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = SIMILAR, .key = "selectsimilar", .name = "Similar Colour Selection", .german = "Auswahl ähnlicher Farben", .shortcut = "", .icon = icons.SELECT_SIMILAR, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = BEZIER, .key = "selectbezier", .name = "Bezier Curve Selection", .german = "Bézierkurven-Auswahl", .shortcut = "", .icon = icons.SELECT_BEZIER, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = MAGNETIC, .key = "selectmagnetic", .name = "Magnetic Selection", .german = "Magnetische Auswahl", .shortcut = "", .icon = icons.SELECT_MAGNETIC, .group = state.GROUP_SELECT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = finish, .busy = busy },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Tool {
    if kept.address != 0 { return table.rows(state.Tool, &kept) }
    return table.keep(state.Tool, &kept, TOOLS[0..])
}
