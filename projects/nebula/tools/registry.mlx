// nebula tools: the list of what the pointer can do on the canvas. Each
// module has a table of state.Tool, one for each of its tools, and hands
// it out with list(); here they are put together. The toolbox shows them
// by group, in this order. Ids: paint 0-9, shapes 10-19, transforms
// 20-29, fills 30-39, selections 40-49, views 50-59, text and others
// 60-63.
const state = @import("../app/state.mlx")
const paint_module = @import("./paint.mlx")
const shapes_module = @import("./shapes.mlx")
const transforms_module = @import("./transforms.mlx")
const fills_module = @import("./fills.mlx")
const selections_module = @import("./selections.mlx")
const views_module = @import("./views.mlx")
const text_module = @import("./text.mlx")

pub const Tool = state.Tool

const MODULES: usize = 7

fn listOf(module: usize) -> []const Tool {
    if module == 0 { return paint_module.list() }
    if module == 1 { return shapes_module.list() }
    if module == 2 { return transforms_module.list() }
    if module == 3 { return fills_module.list() }
    if module == 4 { return selections_module.list() }
    if module == 5 { return views_module.list() }
    return text_module.list()
}

// How many there are, and the one at a place in the list (in the modules'
// order).
pub fn count() -> usize {
    var total: usize = 0
    var module: usize = 0
    while module < MODULES {
        total += listOf(module).length
        module += 1
    }
    return total
}

pub fn at(index: usize) -> ?*const Tool {
    var left = index
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        if left < list.length { return &list[left] }
        left -= list.length
        module += 1
    }
    return null
}

fn sameText(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if left[index] != right[index] { return false }
        index += 1
    }
    return true
}

// The one named `key` (null: there is none).
pub fn byKey(key: []const u8) -> ?*const Tool {
    const all = count()
    var index: usize = 0
    while index < all {
        const found = at(index)
        if found != null && sameText(found.?.*.key, key) { return found }
        index += 1
    }
    return null
}

// The one numbered `id` (null: there is none).
pub fn find(id: u8) -> ?*const Tool {
    const all = count()
    var index: usize = 0
    while index < all {
        const found = at(index)
        if found != null && found.?.*.id == id { return found }
        index += 1
    }
    return null
}
