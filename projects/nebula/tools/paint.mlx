// nebula tools: painting by hand, on the brush engine (brush/): the
// tools of the toolbox's first group.
//
//   Freehand Brush (B)   the pointer's way, smoothed, becomes a stroke of
//                        the brush in use (app/brushes.mlx)
//   Line (V)             a straight stroke from the press to the release;
//                        Shift turns it in steps of 15 degrees, Alt moves
//                        it while it is dragged
//   Dynamic Brush        the stroke follows the pointer as a pen with mass
//                        on a spring would, held back by drag
//   Multibrush (Q)       every stroke again N times turned about a centre
//                        (and mirrored); Ctrl+click puts the centre
//   Colour Sampler (P)   the colour under the pointer becomes the
//                        foreground's (Ctrl: the background's)
//   Smart Patch          what is painted over is filled again from what
//                        lies around it
//
// One stroke at a time is being painted, whichever tool paints it: what
// it needs (the strokes of the brush engine, the smoother between the
// pointer and them, a copy of the brush as it paints) is kept in the
// brush's slot (state.SLOT_TOOL + BRUSH) and made at the first stroke; a
// tool's options are kept in its own slot. A stroke goes where the brush
// says (brush/stroke.mlx's header): in wash mode onto an overlay of the
// active layer, merged at the release with ops.mergeOverlay; in build-up
// mode onto the layer itself between ops.beginPixels and endPixels.
// Either way the stroke becomes ONE step of the history ("Brush stroke",
// "Erase", "Line", "Smart patch"), Escape during it leaves no trace, and
// what applies to every stroke applies: the eraser (app.eraser), mirror
// left-right and top-bottom about the image's middle (app.mirrorX,
// app.mirrorY), wrap-around (app.wrapAround), the selection and the
// layer's alpha lock. On a mask (and on what a filter layer filters) the
// colours paint their greys and the eraser paints black, so that it stays
// a mask of opaque greys. A layer with a change of another part open
// (core/device.mlx's begin) is not painted on.
//
//     tools/registry.mlx lists them: paint.list()
//     paint.brushKeys(app, code, modifiers, down)   the keys every
//                        painting tool takes: [ and ] the size, I and O
//                        (or Ctrl+[ and Ctrl+]) the opacity
//
// The freehand tools (brush, multibrush, smart patch) send the pointer
// through brush/smoothing.mlx: its mode and distance and whether a
// mouse's speed stands in for pressure are the Painting settings
// (app/settings.mlx), which the brush's options change. Shift held at the
// press and a drag to the side changes the size instead (the outline
// grows from the press point). Holding Ctrl in a painting tool takes the
// colour sampler until Ctrl is let go (in the multibrush Ctrl+click puts
// the centre instead); a click of the sampler taken so goes to the
// background colour with Shift.
//
// The tools' own options (the line's pressure ramp, the dynamic brush's
// mass and drag, the multibrush's copies, mirror and angle, the sampler's
// source, radius and blend, the patch's size) are kept between runs in
// the settings' texts ("tool.multibrush.count", ...).
//
// How the smart patch fills: the painted mask (its coverage) is taken
// away from the layer's pixels and filled from the edge inward, each
// pixel the mean of its neighbours already known (nearer ones weighing
// more), then evened out by repeated averaging; the result is mixed in by
// the mask's coverage. That removes a blemish on a calm ground; it does
// not continue a texture or a line through the patch (no exemplar
// search).
//
// Not done: the multibrush's translate and snowflake modes, a line drawn
// as a series of segments, the brush's own airbrush rate in the options
// (the brush editor has it).
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const shell_module = @import("../app/shell.mlx")
const settings = @import("../app/settings.mlx")
const brushes = @import("../app/brushes.mlx")
const kit_module = @import("../ui/kit.mlx")
const overlay = @import("../ui/overlay.mlx")
const viewport = @import("../ui/viewport.mlx")
const icons = @import("../ui/icons.mlx")
const types = @import("../brush/types.mlx")
const stroke_module = @import("../brush/stroke.mlx")
const smoothing = @import("../brush/smoothing.mlx")
const point_module = @import("../brush/point.mlx")
const tip_module = @import("../brush/tip.mlx")
const device_module = @import("../core/device.mlx")
const mask_module = @import("../core/mask.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")
const scratch = @import("../core/scratch.mlx")
const render = @import("../core/render.mlx")
const table = @import("../core/table.mlx")

pub const App = state.App
pub const Input = state.Input
pub const Canvas = state.Canvas
const Point = types.Point
const Settings = types.Settings
const Stroke = types.Stroke
const Image = image_module.Image
const Node = node_module.Node
const Rect = geom.Rect

pub const BRUSH: u8 = 0
pub const LINE: u8 = 1
pub const DYNAMIC: u8 = 2
pub const MULTIBRUSH: u8 = 3
pub const SAMPLER: u8 = 4
pub const PATCH: u8 = 5

// The multibrush's copies: turned 2 to 16 times, each mirrored too.
pub const LEAST_COPIES: usize = 2
pub const MOST_COPIES: usize = 16
const MOST_STROKES: usize = 32

// The sampler's sources.
pub const FROM_IMAGE: usize = 0
pub const FROM_LAYER: usize = 1
// The largest radius it averages over, in pixels.
pub const MOST_RADIUS: f64 = 10.0

// Points the smoother hands out at a time.
const OUT: usize = 128
// Room for a tip's outline (brush/tip.mlx: 720 points at most and the
// first again, x and y each).
const OUTLINE_ROOM: usize = 1444
// Below this many window pixels across (times the theme's scale) the
// outline is a cross.
const SMALLEST_OUTLINE: f64 = 6.0
// The line's pressure where it starts when it ramps up.
const RAMP_LOW: f64 = 0.15
// The dynamic brush moves its pen in steps of this many milliseconds, at
// most so many steps for one motion (a pointer silent for long does not
// make the pen run on and on at once).
const DYNAMIC_STEP: f64 = 4.0
const DYNAMIC_STEPS: usize = 64
// The smart patch: how its mask shows while it is painted (straight; the
// overlay's opacity), the most pixels it fills, how far around the mask
// it looks, how often it evens out.
const PATCH_COLOR: u32 = 0xFFE8475F
const PATCH_SHOWN: u8 = 150
const PATCH_LARGEST: usize = 1048576
const PATCH_MARGIN: i32 = 3
const PATCH_ROUNDS: usize = 24
const PATCH_SIZE: f64 = 24.0
// What a stroke of the smoother may still owe after the release: drains
// of nothing in a row before it counts as done, drains at most.
const IDLE_DRAINS: usize = 4
const MOST_DRAINS: usize = 65536

// ---------------------------------------------------------------------------
// What the painting tools share: the stroke being painted (in the
// brush's slot)

const Painting = struct {
    ready: bool
    // A stroke is being painted, by `owner` (a tool's id), on node `node`
    // of the image numbered `image` (image.number: an address may be
    // another image's later).
    painting: bool
    owner: u8
    image: u64
    node: u32
    // On an overlay (wash), else on the layer; the brush erases (its step
    // is named so, also on a mask, where it paints black).
    wash: bool
    erasing: bool
    // The smoother stands between the pointer and the strokes; ticks
    // were asked for; the strokes began (with the first point).
    smooth: bool
    ticks: bool
    begun: bool
    // The strokes of the engine, made at the first need and kept (each
    // has a block of 100 KiB for its curves); how many paint now.
    strokes: [32]usize
    copies: usize
    smoother: usize
    out: usize
    // The brush as this stroke paints (a copy: the brush in use may
    // change meanwhile).
    brush: usize
    target: types.Target
    // The copies: copy k < turns is turned by the angle whose cosine and
    // sine are cosines[k], sines[k] about (centerX, centerY); from turns
    // on they are mirror images first, about the line through the centre
    // whose doubled angle has cosine mirrorCos and sine mirrorSin.
    centerX: f64
    centerY: f64
    turns: usize
    cosines: [16]f64
    sines: [16]f64
    mirrorCos: f64
    mirrorSin: f64
    // The point being handed to a stroke, the press's, the last one in.
    point: Point
    first: Point
    last: Point
    // What changed since the canvas was told.
    area: Rect
    seed: u64
    // Shift held at the press: the drag sets the size of tool `sizeTool`
    // (it was `sizeFrom`; the press was at window column `sizeX`, at
    // (sizeAtX, sizeAtY) of the image).
    sizing: bool
    sizeTool: u8
    sizeFrom: f64
    sizeX: i32
    sizeAtX: f64
    sizeAtY: f64
    // How the options' sliders count.
    sizeOptions: kit_module.SliderOptions
    percentOptions: kit_module.SliderOptions
    distanceOptions: kit_module.SliderOptions
}

fn slotOf(app: *App, id: u8, bytes: usize) -> ?[*]u8 {
    return state.slot(app, state.SLOT_TOOL + @intCast(usize, id), bytes)
}

fn strokeOf(p: *Painting, index: usize) -> *Stroke {
    unsafe { return @ptrFromInt(*Stroke, p.*.strokes[index]) }
}

fn smootherOf(p: *Painting) -> *smoothing.Smoother {
    unsafe { return @ptrFromInt(*smoothing.Smoother, p.*.smoother) }
}

fn outOf(p: *Painting) -> [*]Point {
    unsafe { return @ptrFromInt([*]Point, p.*.out) }
}

fn brushOf(p: *Painting) -> *Settings {
    unsafe { return @ptrFromInt(*Settings, p.*.brush) }
}

// The shared record, its memory made at the first asking (null without
// memory: then nothing is painted).
fn paintingOf(app: *App) -> ?*Painting {
    const memory = slotOf(app, BRUSH, @sizeOf(Painting))
    if memory == null { return null }
    const p: *Painting = unsafe { @ptrCast(*Painting, memory.?) }
    if p.*.ready { return p }
    const allocator = app.*.allocator
    if p.*.smoother == 0 {
        const options = smoothing.defaults()
        const made = smoothing.create(allocator, &options)
        if made == null { return null }
        p.*.smoother = @intFromPtr(made.?)
    }
    if p.*.out == 0 {
        const made = allocator.alloc(OUT * @sizeOf(Point), 16)
        if made == null { return null }
        p.*.out = @intFromPtr(made.?)
    }
    if p.*.brush == 0 {
        const made = allocator.alloc(@sizeOf(Settings), 16)
        if made == null { return null }
        p.*.brush = @intFromPtr(made.?)
        types.defaults(brushOf(p))
    }
    p.*.sizeOptions = kit_module.sliderOptions(1.0, types.LARGEST_SIZE, 1.0, 1)
    p.*.sizeOptions.exponent = 3.0
    p.*.sizeOptions.suffix = " px"
    p.*.sizeOptions.softLow = 1.0
    p.*.sizeOptions.softHigh = 1000.0
    p.*.percentOptions = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    p.*.percentOptions.suffix = " %"
    p.*.distanceOptions = kit_module.sliderOptions(1.0, 1000.0, 1.0, 0)
    p.*.distanceOptions.exponent = 2.0
    p.*.distanceOptions.suffix = " px"
    p.*.distanceOptions.softHigh = 100.0
    p.*.distanceOptions.softLow = 1.0
    p.*.ready = true
    return p
}

// Stroke number `index`, made when there is none yet (null without
// memory).
fn strokeAt(app: *App, p: *Painting, index: usize) -> ?*Stroke {
    var found: ?*Stroke = null
    if index >= MOST_STROKES { return found }
    if p.*.strokes[index] == 0 {
        const made = stroke_module.create(app.*.allocator)
        if made == null { return found }
        p.*.strokes[index] = @intFromPtr(made.?)
    }
    found = strokeOf(p, index)
    return found
}

// The strokes past the first are given back (the multibrush is put
// away: each holds a large block).
fn dropCopies(p: *Painting) -> void {
    if p.*.painting { return }
    var index: usize = 1
    while index < MOST_STROKES {
        if p.*.strokes[index] != 0 {
            stroke_module.destroy(strokeOf(p, index))
            p.*.strokes[index] = 0
        }
        index += 1
    }
}

// The open image numbered `number` (null: it was closed).
fn imageNumbered(app: *App, number: u64) -> ?*Image {
    var found: ?*Image = null
    var index: usize = 0
    while index < app.*.count && index < state.DOCUMENTS {
        const doc = app.*.documents[index]
        if doc != null && doc.?.*.image.*.number == number {
            found = doc.?.*.image
            return found
        }
        index += 1
    }
    return found
}

// Whether a node's pixels are amounts, opaque greys (core/mask.mlx): a
// mask's, a filter layer's.
fn holdsAmounts(node: *Node) -> bool {
    return node_module.isMask(node.*.kind) || node.*.kind == node_module.FILTER
}

// A colour as the grey of an amount, at its own alpha.
fn greyOf(color: u32) -> u32 {
    return pixel.withAlpha(pixel.gray(pixel.luma(color)), color >> 24)
}

// The pen of `input` (tilt, turn) on a point made from its place.
fn takePen(point: *Point, input: *const Input) -> void {
    point.*.tiltX = input.*.tiltX
    point.*.tiltY = input.*.tiltY
    point.*.rotation = input.*.rotation
}

// A place to paint at: no NaN, nothing beyond what any image reaches.
fn usable(value: f64) -> bool { return value > -1.0e9 && value < 1.0e9 }

// The modifiers held now. (Input.modifiers is the loop's app.modifiers,
// set when a key goes down or up from what was held before that key: a
// modifier let go still counts as held until the next key.)
fn heldNow(app: *App) -> u32 {
    return shell_module.modifiers(app.*.shell)
}

fn nowOf(app: *App) -> f64 {
    return @floatFromInt(f64, shell_module.now(app.*.shell))
}

fn zoomOf(app: *App) -> f64 {
    const doc = api.document(app)
    if doc == null || !(doc.?.*.view.zoom > 0.0) { return 1.0 }
    return doc.?.*.view.zoom
}

// The smoother set up for a new stroke: the Painting settings, the
// lengths meant on the screen made the image's at the zoom now.
fn startSmoother(app: *App, p: *Painting) -> void {
    const prefs = settings.get(app)
    var options = smoothing.defaults()
    options.mode = if prefs.*.smoothing > smoothing.PIXEL { smoothing.BASIC } else { prefs.*.smoothing }
    options.distance = @floatFromInt(f64, prefs.*.smoothingDistance)
    // The stabilizer averages as many samples as the distance says.
    var samples = prefs.*.smoothingDistance
    if samples < 1 { samples = 1 }
    if samples > @intCast(u32, smoothing.SAMPLES) { samples = @intCast(u32, smoothing.SAMPLES) }
    options.sampleCount = samples
    options.simulatePressure = if prefs.*.simulatePressure { smoothing.PRESSURE_BY_SPEED } else { smoothing.PRESSURE_GIVEN }
    const scaled = smoothing.forZoom(&options, zoomOf(app))
    smoothing.init(smootherOf(p), &scaled)
}

// The copies of a multibrush stroke: turned `count` times about the
// centre, mirrored too when the options say so.
fn setCopies(app: *App, p: *Painting, image: *Image) -> void {
    const own = multiOf(app)
    var count = LEAST_COPIES
    var mirrored = false
    var angle: f64 = 0.0
    p.*.centerX = @floatFromInt(f64, image.*.width) / 2.0
    p.*.centerY = @floatFromInt(f64, image.*.height) / 2.0
    if own != null {
        count = copiesOf(own.?)
        mirrored = own.?.*.mirror
        angle = own.?.*.angle * math.pi / 180.0
        if own.?.*.centerSet && own.?.*.image == image.*.number {
            p.*.centerX = own.?.*.centerX
            p.*.centerY = own.?.*.centerY
        }
    }
    p.*.turns = count
    var index: usize = 0
    while index < count {
        const turn = math.tau * @floatFromInt(f64, index) / @floatFromInt(f64, count)
        p.*.cosines[index] = math.cos(turn)
        p.*.sines[index] = math.sin(turn)
        index += 1
    }
    // The mirror's line is upright, turned by the angle: reflecting about
    // a line at phi is (x, y) -> (x cos 2phi + y sin 2phi, x sin 2phi -
    // y cos 2phi).
    const phi = math.pi / 2.0 + angle
    p.*.mirrorCos = math.cos(phi * 2.0)
    p.*.mirrorSin = math.sin(phi * 2.0)
    p.*.copies = if mirrored { count * 2 } else { count }
}

// Starts a stroke of tool `owner` on the active layer at (x, y): checks
// that it can be painted on (the status bar says why not), takes the
// brush as it is now and makes the strokes for every copy. Null when
// nothing can be painted; the stroke has no point yet then.
fn begin(app: *App, owner: u8, x: f64, y: f64, pressure: f64, time: f64) -> ?*Painting {
    var result: ?*Painting = null
    const found = paintingOf(app)
    if found == null { return result }
    const p = found.?
    if p.*.painting { finish(app, p, true) }
    const picked = api.paintable(app)
    if picked == null { return result }
    const node = picked.?
    const image = api.image(app).?
    // A layer showing something unfinished of another part (or with a
    // change of its pixels open: the stroke's step would take it in) is
    // left to it.
    if node.*.overlay != null || node.*.substitute != null || device_module.isRecording(node.*.device.?) {
        api.say(app, state.tr(app, "The layer shows something unfinished", "Die Ebene zeigt etwas Unfertiges"), true)
        return result
    }
    const brush = brushOf(p)
    unsafe { std.mem.copy(@ptrCast([*]u8, brush), @ptrCast([*]const u8, brushes.current(app)), @sizeOf(Settings)) }
    if app.*.eraser { brush.*.eraser = true }
    var foreground = app.*.foreground
    var background = app.*.background
    p.*.erasing = stroke_module.mergeBlend(brush) == blend.ERASE
    if holdsAmounts(node) && owner != PATCH {
        // A mask (or what a filter layer filters) is opaque greys: the
        // colours paint their greys, and the eraser hides (paints black)
        // instead of taking the alpha away.
        foreground = greyOf(foreground)
        background = greyOf(background)
        if p.*.erasing {
            foreground = pixel.withAlpha(pixel.gray(0), app.*.foreground >> 24)
            brush.*.eraser = false
            if brush.*.engine == types.ENGINE_ERASER { brush.*.engine = types.ENGINE_PAINTBRUSH }
            if brush.*.blend == blend.ERASE { brush.*.blend = blend.NORMAL }
        }
    }
    if owner == PATCH {
        // The patch paints its mask: plain, opaque, on an overlay.
        brush.*.size = patchSize(app)
        brush.*.engine = types.ENGINE_PAINTBRUSH
        brush.*.opacity = 1.0
        brush.*.flow = 1.0
        brush.*.eraser = false
        brush.*.blend = blend.NORMAL
        brush.*.paintMode = types.MODE_WASH
        brush.*.airbrush = false
        brush.*.colorSource = types.COLOR_PLAIN
        foreground = PATCH_COLOR
        p.*.erasing = false
    }
    p.*.copies = 1
    p.*.turns = 1
    p.*.cosines[0] = 1.0
    p.*.sines[0] = 0.0
    if owner == MULTIBRUSH { setCopies(app, p, image) }
    var index: usize = 0
    while index < p.*.copies {
        if strokeAt(app, p, index) == null {
            if index == 0 {
                api.say(app, state.tr(app, "There is no memory for the stroke", "Für den Strich ist kein Speicher frei"), true)
                return result
            }
            p.*.copies = index
            break
        }
        index += 1
    }
    p.*.wash = owner == PATCH || stroke_module.paintsIndirectly(brush)
    p.*.target.image = image
    p.*.target.node = node
    p.*.target.foreground = foreground
    p.*.target.background = background
    p.*.target.selection = null
    p.*.target.alphaLock = false
    p.*.target.mirrorHorizontal = app.*.mirrorX
    p.*.target.axisX = @floatFromInt(f64, image.*.width) / 2.0
    p.*.target.mirrorVertical = app.*.mirrorY
    p.*.target.axisY = @floatFromInt(f64, image.*.height) / 2.0
    p.*.target.wrap = app.*.wrapAround
    p.*.target.sample = null
    if p.*.wash {
        const made = device_module.create(app.*.allocator, 0)
        if made == null {
            api.say(app, state.tr(app, "There is no memory for the stroke", "Für den Strich ist kein Speicher frei"), true)
            return result
        }
        node.*.overlay = made
        node.*.overlayOpacity = if owner == PATCH { PATCH_SHOWN } else { 255 }
        node.*.overlayBlend = if owner == PATCH { blend.NORMAL } else { stroke_module.mergeBlend(brush) }
        node.*.overlayMasked = image.*.selected
        p.*.target.device = made.?
        p.*.target.direct = false
    } else {
        if !ops.beginPixels(image, node) { return result }
        p.*.target.device = node.*.device.?
        p.*.target.direct = true
        if image.*.selected { p.*.target.selection = image.*.selection }
        p.*.target.alphaLock = node.*.alphaLocked
    }
    p.*.seed = p.*.seed *% 6364136223846793005 +% @intCast(u64, shell_module.now(app.*.shell)) +% 1442695040888963407
    p.*.smooth = owner == BRUSH || owner == MULTIBRUSH || owner == PATCH
    if p.*.smooth { startSmoother(app, p) }
    p.*.painting = true
    p.*.owner = owner
    p.*.image = image.*.number
    p.*.node = node.*.id
    p.*.begun = false
    p.*.area = geom.empty()
    p.*.first = point_module.at(x, y, pressure, time)
    p.*.last = p.*.first
    // Time is wanted: the smoother closes up to a resting pen, an
    // airbrush sprays, the dynamic pen moves on.
    p.*.ticks = p.*.smooth || brush.*.airbrush || owner == DYNAMIC
    if p.*.ticks { api.wantTicks(app, true) }
    result = p
    return result
}

// The copy `copy` of `from` into p.point.
fn placeCopy(p: *Painting, copy: usize, from: *const Point) -> void {
    p.*.point = from.*
    if p.*.copies <= 1 { return }
    var dx = from.*.x - p.*.centerX
    var dy = from.*.y - p.*.centerY
    var turn = copy
    if copy >= p.*.turns {
        turn = copy - p.*.turns
        const mirrored = dx * p.*.mirrorCos + dy * p.*.mirrorSin
        dy = dx * p.*.mirrorSin - dy * p.*.mirrorCos
        dx = mirrored
    }
    if turn >= MOST_COPIES { return }
    const c = p.*.cosines[turn]
    const s = p.*.sines[turn]
    p.*.point.x = p.*.centerX + dx * c - dy * s
    p.*.point.y = p.*.centerY + dx * s + dy * c
}

// Hands `point` to every copy's stroke (the first point begins them);
// what they changed is kept in p.area.
fn paintPoint(p: *Painting, point: *const Point) -> void {
    var copy: usize = 0
    while copy < p.*.copies {
        paintCopy(p, copy, point)
        copy += 1
    }
    p.*.begun = true
}

// (The loops over the copies call a function for each: a rectangle made
// inside a loop's body is taken from the value arena every time round.)
fn paintCopy(p: *Painting, copy: usize, point: *const Point) -> void {
    const stroke = strokeOf(p, copy)
    placeCopy(p, copy, point)
    if p.*.begun {
        p.*.area = geom.unite(p.*.area, stroke_module.to(stroke, &p.*.point))
        return
    }
    p.*.target.seed = p.*.seed +% @intCast(u64, copy)
    p.*.area = geom.unite(p.*.area, stroke_module.begin(stroke, &p.*.target, brushOf(p), &p.*.point))
}

fn endCopy(p: *Painting, copy: usize, keep: bool) -> void {
    if keep {
        p.*.area = geom.unite(p.*.area, stroke_module.end(strokeOf(p, copy)))
    } else {
        stroke_module.cancel(strokeOf(p, copy))
    }
}

fn tickCopy(p: *Painting, copy: usize, time: f64) -> void {
    p.*.area = geom.unite(p.*.area, stroke_module.tick(strokeOf(p, copy), time))
}

fn paintOut(p: *Painting, count: usize) -> void {
    const out = outOf(p)
    var index: usize = 0
    while index < count {
        paintPoint(p, &out[index])
        index += 1
    }
}

// A raw point of the pointer (p.last) through the smoother into the
// strokes.
fn smoothLast(p: *Painting) -> void {
    const smoother = smootherOf(p)
    var count = smoothing.push(smoother, &p.*.last, outOf(p), OUT)
    paintOut(p, count)
    while count == OUT {
        count = smoothing.drain(smoother, outOf(p), OUT)
        paintOut(p, count)
    }
}

// The pointer was let go: what the smoother still owes (until when the
// pen rested, then the end and its taper).
fn closeSmoother(app: *App, p: *Painting, time: f64) -> void {
    const smoother = smootherOf(p)
    var count = smoothing.tick(smoother, time, outOf(p), OUT)
    paintOut(p, count)
    while count == OUT {
        count = smoothing.drain(smoother, outOf(p), OUT)
        paintOut(p, count)
    }
    count = smoothing.finish(smoother, outOf(p), OUT)
    paintOut(p, count)
    var idle: usize = 0
    var rounds: usize = 0
    while smoothing.busy(smoother) && idle < IDLE_DRAINS && rounds < MOST_DRAINS {
        count = smoothing.drain(smoother, outOf(p), OUT)
        paintOut(p, count)
        idle = if count == 0 { idle + 1 } else { 0 }
        rounds += 1
    }
}

// Tells the canvas what changed since it was told last.
fn report(app: *App, p: *Painting) -> void {
    if geom.isEmpty(p.*.area) { return }
    api.imageChanged(app, p.*.area)
    p.*.area = geom.empty()
}

fn stepName(app: *App, p: *Painting) -> []const u8 {
    if p.*.owner == PATCH { return state.tr(app, "Smart patch", "Intelligenter Flicken") }
    if p.*.erasing { return state.tr(app, "Erase", "Radieren") }
    if p.*.owner == LINE { return state.tr(app, "Line", "Linie") }
    return state.tr(app, "Brush stroke", "Pinselstrich")
}

// Ends the stroke being painted: kept (`keep`: one step of the history)
// or given up without a trace.
fn finish(app: *App, p: *Painting, keep: bool) -> void {
    if !p.*.painting { return }
    p.*.painting = false
    if p.*.ticks {
        api.wantTicks(app, false)
        p.*.ticks = false
    }
    // (An image closed meanwhile took the overlay and the layer with it:
    // nothing more is painted then.)
    const found = imageNumbered(app, p.*.image)
    const kept = keep && found != null
    const time = nowOf(app)
    if kept && p.*.smooth { closeSmoother(app, p, if time > p.*.last.time { time } else { p.*.last.time }) }
    if kept && !p.*.begun { paintPoint(p, &p.*.first) }
    var copy: usize = 0
    while copy < p.*.copies {
        endCopy(p, copy, kept)
        copy += 1
    }
    if found == null { return }
    const image = found.?
    const node = node_module.find(image.*.root, p.*.node)
    if node == null { return }
    var area = p.*.area
    p.*.area = geom.empty()
    if p.*.owner == PATCH {
        if keep && node.?.*.overlay != null {
            area = geom.unite(area, patchFrom(app, image, node.?))
        } else {
            area = geom.unite(area, ops.dropOverlay(image, node.?))
        }
    } else if p.*.wash {
        if keep {
            area = geom.unite(area, ops.mergeOverlay(image, node.?, stepName(app, p)))
        } else {
            area = geom.unite(area, ops.dropOverlay(image, node.?))
        }
    } else if keep {
        area = geom.unite(area, ops.endPixels(image, node.?, stepName(app, p)))
    } else {
        area = geom.unite(area, ops.cancelPixels(image, node.?))
    }
    image_module.damage(image, area)
    // (The history's docker and the title show the new step.)
    api.redraw(app)
}

// Time passed while a stroke is painted: the smoother closes up to a
// resting pen, an airbrush sprays, the dynamic pen moves on.
fn paintTick(app: *App) -> void {
    const found = paintingOf(app)
    if found == null || !found.?.*.painting { return }
    const p = found.?
    const time = nowOf(app)
    if p.*.owner == DYNAMIC { dynamicStep(app, p, time, false) }
    if p.*.smooth {
        const smoother = smootherOf(p)
        var count = smoothing.tick(smoother, time, outOf(p), OUT)
        paintOut(p, count)
        while count == OUT {
            count = smoothing.drain(smoother, outOf(p), OUT)
            paintOut(p, count)
        }
    }
    if p.*.begun && brushOf(p).*.airbrush {
        var copy: usize = 0
        while copy < p.*.copies {
            tickCopy(p, copy, time)
            copy += 1
        }
    }
    report(app, p)
}

// ---------------------------------------------------------------------------
// Size: what a tool paints with, by Shift and a drag or by the keys

// The size tool `id` paints with: the patch's own, the brush's for the
// others.
fn toolSize(app: *App, id: u8) -> f64 {
    if id == PATCH { return patchSize(app) }
    return brushes.current(app).*.size
}

fn setToolSize(app: *App, id: u8, size: f64) -> void {
    if id == PATCH {
        const own = patchOf(app)
        if own == null { return }
        own.?.*.size = if !(size >= 1.0) { 1.0 } else if size > 1000.0 { 1000.0 } else { size }
        api.redraw(app)
        return
    }
    brushes.setSize(app, size)
}

fn startSizing(app: *App, id: u8, input: *const Input) -> void {
    const found = paintingOf(app)
    if found == null || found.?.*.painting { return }
    const p = found.?
    p.*.sizing = true
    p.*.sizeTool = id
    p.*.sizeFrom = toolSize(app, id)
    p.*.sizeX = input.*.windowX
    p.*.sizeAtX = input.*.x
    p.*.sizeAtY = input.*.y
}

// The outline's edge follows the pointer: the radius grows by the
// pointer's way to the side, in window pixels. A drag to the left stops
// at a pixel (a smaller size set by hand stays as it is).
fn sizeTo(app: *App, p: *Painting, input: *const Input) -> void {
    const moved = @floatFromInt(f64, input.*.windowX - p.*.sizeX)
    var size = p.*.sizeFrom + moved * 2.0 / zoomOf(app)
    const least = if p.*.sizeFrom < 1.0 { p.*.sizeFrom } else { 1.0 }
    if !(size >= least) { size = least }
    setToolSize(app, p.*.sizeTool, size)
    api.canvasChanged(app)
}

fn endSizing(app: *App, p: *Painting, keep: bool) -> void {
    if !p.*.sizing { return }
    p.*.sizing = false
    if !keep { setToolSize(app, p.*.sizeTool, p.*.sizeFrom) }
    // (The toolbar's slider shows the size.)
    api.redraw(app)
}

// The keys every painting tool takes (each one's keyPress hands them
// here): [ and ] make what it paints with a step smaller and larger (a
// tenth, at least a pixel, never below a pixel on the way down), I and O
// and Ctrl+[ and Ctrl+] the brush a tenth less and more opaque. True when
// the key was one of them (only presses count, `down`); false for any
// other key and for a key let go.
pub fn brushKeys(app: *App, code: u32, modifiers: u32, down: bool) -> bool {
    if !down { return false }
    const plain = shell_module.plainTyped(app.*.shell)
    if keys.matches(keys.parse("Ctrl+]"), code, modifiers, plain) || keys.matches(keys.parse("O"), code, modifiers, plain) {
        brushes.fade(app, true)
        return true
    }
    if keys.matches(keys.parse("Ctrl+["), code, modifiers, plain) || keys.matches(keys.parse("I"), code, modifiers, plain) {
        brushes.fade(app, false)
        return true
    }
    const larger = keys.matches(keys.parse("]"), code, modifiers, plain)
    if larger || keys.matches(keys.parse("["), code, modifiers, plain) {
        // (The tool that holds the sampler, while it is held.)
        const id = if samplerHeld(app) { app.*.toolBefore } else { app.*.tool }
        if id == PATCH {
            const size = patchSize(app)
            var step = size / 10.0
            if step < 1.0 { step = 1.0 }
            setToolSize(app, id, if larger { size + step } else { size - step })
        } else {
            brushes.grow(app, larger)
        }
        api.canvasChanged(app)
        return true
    }
    return false
}

fn isControl(code: u32) -> bool { return code == keys.LEFT_CONTROL || code == keys.RIGHT_CONTROL }

// A painting tool's keys: Control held takes the colour sampler (not in
// the multibrush, whose Ctrl+click puts the centre), the brush's keys.
fn paintKey(app: *App, code: u32, modifiers: u32, down: bool) -> bool {
    if isControl(code) {
        if down && app.*.tool != MULTIBRUSH { api.holdTool(app, SAMPLER) }
        return false
    }
    return brushKeys(app, code, modifiers, down)
}

// ---------------------------------------------------------------------------
// The freehand tools: brush, multibrush, smart patch

fn freehandPress(app: *App, input: *const Input, owner: u8) -> void {
    if input.*.button != ui_app.BUTTON_LEFT { return }
    if heldNow(app) & keys.SHIFT != 0 {
        startSizing(app, owner, input)
        return
    }
    const p = begin(app, owner, input.*.x, input.*.y, input.*.pressure, input.*.time)
    if p == null { return }
    takePen(&p.?.*.first, input)
    p.?.*.last = p.?.*.first
    smoothLast(p.?)
    report(app, p.?)
}

fn brushPress(app: *App, input: *const Input) -> void {
    freehandPress(app, input, BRUSH)
}

fn freehandMove(app: *App, input: *const Input) -> void {
    const found = paintingOf(app)
    if found == null { return }
    const p = found.?
    if p.*.sizing {
        sizeTo(app, p, input)
        return
    }
    if !p.*.painting || !p.*.smooth { return }
    p.*.last = point_module.at(input.*.x, input.*.y, input.*.pressure, input.*.time)
    takePen(&p.*.last, input)
    smoothLast(p)
    report(app, p)
}

fn freehandRelease(app: *App, input: *const Input) -> void {
    const found = paintingOf(app)
    if found == null { return }
    const p = found.?
    if p.*.sizing {
        endSizing(app, p, true)
        return
    }
    if !p.*.painting { return }
    // The release's place is the line's last (a pointer that moved after
    // its last motion event).
    p.*.last = point_module.at(input.*.x, input.*.y, input.*.pressure, input.*.time)
    takePen(&p.*.last, input)
    if p.*.smooth { smoothLast(p) }
    finish(app, p, true)
}

fn paintCancel(app: *App) -> void {
    const found = paintingOf(app)
    if found == null { return }
    endSizing(app, found.?, false)
    finish(app, found.?, false)
}

// The tool is put away: a stroke in progress is kept as it is.
fn paintStop(app: *App) -> void {
    const found = paintingOf(app)
    if found == null { return }
    endSizing(app, found.?, true)
    finish(app, found.?, true)
}

fn paintBusy(app: *App) -> bool {
    if !state.hasSlot(app, state.SLOT_TOOL + @intCast(usize, BRUSH)) { return false }
    const found = paintingOf(app)
    return found != null && (found.?.*.painting || found.?.*.sizing)
}

// ---------------------------------------------------------------------------
// Line

const LineState = struct {
    ready: bool
    // Pressure rises from RAMP_LOW at the start to full at the end.
    ramp: bool
    // A line is being dragged from (x0, y0) to (x1, y1); the pointer was
    // at (lastX, lastY) of the image.
    active: bool
    x0: f64
    y0: f64
    x1: f64
    y1: f64
    lastX: f64
    lastY: f64
}

fn lineOf(app: *App) -> ?*LineState {
    const memory = slotOf(app, LINE, @sizeOf(LineState))
    if memory == null { return null }
    const own: *LineState = unsafe { @ptrCast(*LineState, memory.?) }
    if !own.*.ready {
        own.*.ramp = keptNumber(app, "tool.line.ramp", 0, 0, 1) == 1
        own.*.ready = true
    }
    return own
}

fn linePress(app: *App, input: *const Input) -> void {
    const own = lineOf(app)
    if own == null || input.*.button != ui_app.BUTTON_LEFT || !usable(input.*.x) || !usable(input.*.y) { return }
    if api.paintable(app) == null { return }
    own.?.*.active = true
    own.?.*.x0 = input.*.x
    own.?.*.y0 = input.*.y
    own.?.*.x1 = input.*.x
    own.?.*.y1 = input.*.y
    own.?.*.lastX = input.*.x
    own.?.*.lastY = input.*.y
}

// The line's end to where the pointer is: turned in steps of 15 degrees
// with Shift, the whole line moved with Alt. (A pointer at no place
// leaves it as it is.)
fn lineTo(own: *LineState, input: *const Input, modifiers: u32) -> void {
    if !usable(input.*.x) || !usable(input.*.y) { return }
    if modifiers & keys.ALT != 0 {
        const dx = input.*.x - own.*.lastX
        const dy = input.*.y - own.*.lastY
        own.*.x0 += dx
        own.*.y0 += dy
        own.*.x1 += dx
        own.*.y1 += dy
    } else if modifiers & keys.SHIFT != 0 {
        const dx = input.*.x - own.*.x0
        const dy = input.*.y - own.*.y0
        const length = math.hypot(dx, dy)
        const step = math.pi / 12.0
        const angle = math.round(math.atan2(dy, dx) / step) * step
        own.*.x1 = own.*.x0 + length * math.cos(angle)
        own.*.y1 = own.*.y0 + length * math.sin(angle)
    } else {
        own.*.x1 = input.*.x
        own.*.y1 = input.*.y
    }
    own.*.lastX = input.*.x
    own.*.lastY = input.*.y
}

fn lineMove(app: *App, input: *const Input) -> void {
    const own = lineOf(app)
    if own == null || !own.?.*.active { return }
    lineTo(own.?, input, heldNow(app))
    api.canvasChanged(app)
}

// Paints the line as one stroke, at full pressure or rising along it.
fn lineRelease(app: *App, input: *const Input) -> void {
    const own = lineOf(app)
    if own == null || !own.?.*.active { return }
    lineTo(own.?, input, heldNow(app))
    own.?.*.active = false
    api.canvasChanged(app)
    const length = math.hypot(own.?.*.x1 - own.?.*.x0, own.?.*.y1 - own.?.*.y0)
    // A click is no line.
    if !(length >= 0.5) { return }
    const start = if own.?.*.ramp { RAMP_LOW } else { 1.0 }
    const found = begin(app, LINE, own.?.*.x0, own.?.*.y0, start, input.*.time)
    if found == null { return }
    const p = found.?
    paintPoint(p, &p.*.first)
    // (The pen as if it went a pixel a millisecond.)
    p.*.last = point_module.at(own.?.*.x1, own.?.*.y1, 1.0, input.*.time + length)
    paintPoint(p, &p.*.last)
    finish(app, p, true)
}

fn lineCancel(app: *App) -> void {
    const own = lineOf(app)
    if own == null || !own.?.*.active { return }
    own.?.*.active = false
    api.canvasChanged(app)
}

fn lineBusy(app: *App) -> bool {
    if !state.hasSlot(app, state.SLOT_TOOL + @intCast(usize, LINE)) { return false }
    const own = lineOf(app)
    return own != null && own.?.*.active
}

// ---------------------------------------------------------------------------
// Dynamic brush: a pen with mass on a spring to the pointer, slowed by
// drag. Each step of DYNAMIC_STEP milliseconds the spring pulls the pen
// by its distance to the pointer over the mass (1 to 160 as `mass` goes
// from 0 to 1), the speed loses its `drag` part (0 to a half, as the
// square of `drag`), and the pen moves on by its speed.

const DynamicState = struct {
    ready: bool
    // 0..1 each.
    mass: f64
    drag: f64
    // The pen, its speed (pixels a step), where the pointer is, and the
    // time up to which the pen has moved.
    penX: f64
    penY: f64
    speedX: f64
    speedY: f64
    aimX: f64
    aimY: f64
    time: f64
}

fn dynamicOf(app: *App) -> ?*DynamicState {
    const memory = slotOf(app, DYNAMIC, @sizeOf(DynamicState))
    if memory == null { return null }
    const own: *DynamicState = unsafe { @ptrCast(*DynamicState, memory.?) }
    if !own.*.ready {
        own.*.mass = @floatFromInt(f64, keptNumber(app, "tool.dynamic.mass", 25, 0, 100)) / 100.0
        own.*.drag = @floatFromInt(f64, keptNumber(app, "tool.dynamic.drag", 50, 0, 100)) / 100.0
        own.*.ready = true
    }
    return own
}

fn dynamicPress(app: *App, input: *const Input) -> void {
    if input.*.button != ui_app.BUTTON_LEFT { return }
    if heldNow(app) & keys.SHIFT != 0 {
        startSizing(app, DYNAMIC, input)
        return
    }
    const own = dynamicOf(app)
    if own == null { return }
    const found = begin(app, DYNAMIC, input.*.x, input.*.y, input.*.pressure, input.*.time)
    if found == null { return }
    own.?.*.penX = input.*.x
    own.?.*.penY = input.*.y
    own.?.*.speedX = 0.0
    own.?.*.speedY = 0.0
    own.?.*.aimX = input.*.x
    own.?.*.aimY = input.*.y
    own.?.*.time = input.*.time
    takePen(&found.?.*.first, input)
    paintPoint(found.?, &found.?.*.first)
    report(app, found.?)
}

// The pen's steps up to `time`, the pointer having gone from where it
// was to (aimX, aimY) meanwhile (`moved`: it did; else it rests).
fn dynamicStep(app: *App, p: *Painting, time: f64, moved: bool) -> void {
    const found = dynamicOf(app)
    if found == null { return }
    const own = found.?
    const elapsed = time - own.*.time
    if !(elapsed >= DYNAMIC_STEP) { return }
    var steps: usize = DYNAMIC_STEPS
    if elapsed / DYNAMIC_STEP < @floatFromInt(f64, DYNAMIC_STEPS) { steps = @intFromFloat(usize, elapsed / DYNAMIC_STEP) }
    const mass = 1.0 + 159.0 * own.*.mass
    const keep = 1.0 - 0.5 * own.*.drag * own.*.drag
    const fromX = p.*.last.x
    const fromY = p.*.last.y
    var index: usize = 1
    while index <= steps {
        // The pointer's place at this step, on its way from the last one.
        const along = @floatFromInt(f64, index) / @floatFromInt(f64, steps)
        const aimX = if moved { fromX + (own.*.aimX - fromX) * along } else { own.*.aimX }
        const aimY = if moved { fromY + (own.*.aimY - fromY) * along } else { own.*.aimY }
        own.*.speedX = (own.*.speedX + (aimX - own.*.penX) / mass) * keep
        own.*.speedY = (own.*.speedY + (aimY - own.*.penY) / mass) * keep
        own.*.penX += own.*.speedX
        own.*.penY += own.*.speedY
        penPoint(p, own.*.penX, own.*.penY, own.*.time + @floatFromInt(f64, index) * DYNAMIC_STEP)
        index += 1
    }
    own.*.time = if steps == DYNAMIC_STEPS { time } else { own.*.time + @floatFromInt(f64, steps) * DYNAMIC_STEP }
    p.*.last.x = own.*.aimX
    p.*.last.y = own.*.aimY
}

// The pen at (x, y) to the strokes. (A function of its own, for the
// point made in dynamicStep's loop; it goes in p.first, as paintPoint
// places the copies into p.point itself.)
fn penPoint(p: *Painting, x: f64, y: f64, time: f64) -> void {
    p.*.first = point_module.at(x, y, 1.0, time)
    paintPoint(p, &p.*.first)
}

fn dynamicMove(app: *App, input: *const Input) -> void {
    const found = paintingOf(app)
    if found == null { return }
    const p = found.?
    if p.*.sizing {
        sizeTo(app, p, input)
        return
    }
    if !p.*.painting || p.*.owner != DYNAMIC { return }
    const own = dynamicOf(app)
    if own == null { return }
    own.?.*.aimX = input.*.x
    own.?.*.aimY = input.*.y
    dynamicStep(app, p, input.*.time, true)
    report(app, p)
}

fn dynamicRelease(app: *App, input: *const Input) -> void {
    const found = paintingOf(app)
    if found == null { return }
    const p = found.?
    if p.*.sizing {
        endSizing(app, p, true)
        return
    }
    if !p.*.painting { return }
    finish(app, p, true)
}

// ---------------------------------------------------------------------------
// Multibrush

const MultiState = struct {
    ready: bool
    // How many times a stroke is there, turned (LEAST_COPIES to
    // MOST_COPIES; a slider's number); each mirrored too; the angle of
    // the mirror's line and of the axes shown, degrees.
    count: f64
    mirror: bool
    angle: f64
    // The centre Ctrl+click put, on the image numbered `image` (another
    // image's: its middle).
    centerSet: bool
    image: u64
    centerX: f64
    centerY: f64
    countOptions: kit_module.SliderOptions
    angleOptions: kit_module.SliderOptions
}

fn multiOf(app: *App) -> ?*MultiState {
    const memory = slotOf(app, MULTIBRUSH, @sizeOf(MultiState))
    if memory == null { return null }
    const own: *MultiState = unsafe { @ptrCast(*MultiState, memory.?) }
    if !own.*.ready {
        own.*.count = @floatFromInt(f64, keptNumber(app, "tool.multibrush.count", 6, @intCast(i64, LEAST_COPIES), @intCast(i64, MOST_COPIES)))
        own.*.mirror = keptNumber(app, "tool.multibrush.mirror", 0, 0, 1) == 1
        own.*.angle = @floatFromInt(f64, keptNumber(app, "tool.multibrush.angle", 0, 0, 360))
        own.*.countOptions = kit_module.sliderOptions(@floatFromInt(f64, LEAST_COPIES), @floatFromInt(f64, MOST_COPIES), 1.0, 0)
        own.*.angleOptions = kit_module.sliderOptions(0.0, 360.0, 1.0, 0)
        own.*.angleOptions.suffix = "°"
        own.*.ready = true
    }
    return own
}

fn copiesOf(own: *MultiState) -> usize {
    const count = math.round(own.*.count)
    if !(count >= @floatFromInt(f64, LEAST_COPIES)) { return LEAST_COPIES }
    if count >= @floatFromInt(f64, MOST_COPIES) { return MOST_COPIES }
    return @intFromFloat(usize, count)
}

// Where the copies turn about on the image in front (its middle unless
// Ctrl+click put the centre there).
fn multiCenter(app: *App, x: *f64, y: *f64) -> void {
    const image = api.image(app)
    x.* = 0.0
    y.* = 0.0
    if image == null { return }
    x.* = @floatFromInt(f64, image.?.*.width) / 2.0
    y.* = @floatFromInt(f64, image.?.*.height) / 2.0
    const own = multiOf(app)
    if own != null && own.?.*.centerSet && own.?.*.image == image.?.*.number {
        x.* = own.?.*.centerX
        y.* = own.?.*.centerY
    }
}

// Puts the centre at the image's middle again.
fn centerMiddle(app: *App) -> void {
    const own = multiOf(app)
    if own == null { return }
    own.?.*.centerSet = false
    api.canvasChanged(app)
}

fn multiPress(app: *App, input: *const Input) -> void {
    if input.*.button != ui_app.BUTTON_LEFT { return }
    if heldNow(app) & keys.CONTROL != 0 {
        const own = multiOf(app)
        const image = api.image(app)
        if own == null || image == null { return }
        own.?.*.centerSet = true
        own.?.*.image = image.?.*.number
        own.?.*.centerX = input.*.x
        own.?.*.centerY = input.*.y
        api.canvasChanged(app)
        return
    }
    freehandPress(app, input, MULTIBRUSH)
}

// The multibrush is put away: its strokes past the first go too.
fn multiStop(app: *App) -> void {
    paintStop(app)
    const found = paintingOf(app)
    if found != null { dropCopies(found.?) }
}

// ---------------------------------------------------------------------------
// Colour sampler

const SamplerState = struct {
    ready: bool
    // FROM_IMAGE or FROM_LAYER; the radius averaged over (pixels); how
    // much of the colour found goes into the colour there is (percent).
    source: usize
    radius: f64
    blend: f64
    // A press samples until its release, into the background colour (else
    // the foreground's), which was `before` at the press.
    active: bool
    background: bool
    before: u32
    radiusOptions: kit_module.SliderOptions
}

fn samplerOf(app: *App) -> ?*SamplerState {
    const memory = slotOf(app, SAMPLER, @sizeOf(SamplerState))
    if memory == null { return null }
    const own: *SamplerState = unsafe { @ptrCast(*SamplerState, memory.?) }
    if !own.*.ready {
        own.*.source = @intCast(usize, keptNumber(app, "tool.sampler.source", 0, 0, 1))
        own.*.radius = @floatFromInt(f64, keptNumber(app, "tool.sampler.radius", 0, 0, 10))
        own.*.blend = @floatFromInt(f64, keptNumber(app, "tool.sampler.blend", 100, 0, 100))
        own.*.radiusOptions = kit_module.sliderOptions(0.0, MOST_RADIUS, 1.0, 0)
        own.*.radiusOptions.suffix = " px"
        own.*.ready = true
    }
    return own
}

fn radiusOf(own: *SamplerState) -> i32 {
    const radius = math.round(own.*.radius)
    if !(radius > 0.0) { return 0 }
    if radius >= MOST_RADIUS { return @intFromFloat(i32, MOST_RADIUS) }
    return @intFromFloat(i32, radius)
}

// The colour at (x, y) of the image (or the active layer), averaged over
// the radius by how opaque each pixel is, made opaque, mixed into the
// colour there was by the blend. False where there is nothing to take
// (all transparent, or no layer).
fn sample(app: *App, own: *SamplerState, x: f64, y: f64, into: *u32) -> bool {
    const image = api.image(app)
    if image == null || !(x > -1.0e8 && x < 1.0e8 && y > -1.0e8 && y < 1.0e8) { return false }
    const radius = radiusOf(own)
    const side = radius * 2 + 1
    const area = geom.rect(@intFromFloat(i32, @floor(x)) - radius, @intFromFloat(i32, @floor(y)) - radius, side, side)
    const count = @intCast(usize, side * side)
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const buffer = scratch.words(pool, count)
    if buffer == null {
        scratch.release(pool, mark)
        return false
    }
    if own.*.source == FROM_LAYER {
        const node = api.activeNode(app)
        if node == null || node.?.*.device == null {
            scratch.release(pool, mark)
            api.say(app, state.tr(app, "There is no layer to take a colour from", "Es gibt keine Ebene, aus der eine Farbe genommen werden kann"), true)
            return false
        }
        device_module.readRect(node.?.*.device.?, area, buffer.?, @intCast(usize, side))
    } else {
        render.read(image.?, area, buffer.?, @intCast(usize, side))
    }
    // Inside the circle (a pixel's middle within the radius and a half).
    const reach = radius * radius + radius
    var alpha: u32 = 0
    var red: u32 = 0
    var green: u32 = 0
    var blue: u32 = 0
    var row: i32 = 0
    while row < side {
        var column: i32 = 0
        while column < side {
            const dx = column - radius
            const dy = row - radius
            if dx * dx + dy * dy <= reach {
                const found = buffer.?[@intCast(usize, row * side + column)]
                const a = found >> 24
                alpha += a
                red += ((found >> 16) & 255) * a
                green += ((found >> 8) & 255) * a
                blue += (found & 255) * a
            }
            column += 1
        }
        row += 1
    }
    scratch.release(pool, mark)
    if alpha == 0 { return false }
    const half = alpha / 2
    const taken = pixel.rgb((red + half) / alpha, (green + half) / alpha, (blue + half) / alpha)
    var amount: u32 = 255
    if own.*.blend < 100.0 { amount = if own.*.blend > 0.0 { @intFromFloat(u32, own.*.blend * 255.0 / 100.0 + 0.5) } else { 0 } }
    const before = own.*.before
    into.* = pixel.rgb(pixel.lerp(pixel.red(before), pixel.red(taken), amount), pixel.lerp(pixel.green(before), pixel.green(taken), amount), pixel.lerp(pixel.blue(before), pixel.blue(taken), amount))
    return true
}

fn sampleTo(app: *App, own: *SamplerState, x: f64, y: f64) -> void {
    var color: u32 = 0
    if !sample(app, own, x, y, &color) { return }
    if own.*.background { api.setBackground(app, color) } else { api.setForeground(app, color) }
}

// Whether the sampler is held (Control in a painting tool), not chosen.
fn samplerHeld(app: *App) -> bool {
    return app.*.tool == SAMPLER && app.*.toolBefore != state.NO_TOOL
}

fn samplerPress(app: *App, input: *const Input) -> void {
    const own = samplerOf(app)
    if own == null || input.*.button != ui_app.BUTTON_LEFT || api.image(app) == null { return }
    own.?.*.active = true
    // Held by Control, Shift says background; chosen, Control does.
    const modifiers = heldNow(app)
    own.?.*.background = if samplerHeld(app) { modifiers & keys.SHIFT != 0 } else { modifiers & keys.CONTROL != 0 }
    own.?.*.before = if own.?.*.background { app.*.background } else { app.*.foreground }
    sampleTo(app, own.?, input.*.x, input.*.y)
    api.canvasChanged(app)
}

fn samplerMove(app: *App, input: *const Input) -> void {
    const own = samplerOf(app)
    if own == null || !own.?.*.active { return }
    sampleTo(app, own.?, input.*.x, input.*.y)
    api.canvasChanged(app)
}

fn samplerRelease(app: *App, input: *const Input) -> void {
    const own = samplerOf(app)
    if own == null || !own.?.*.active { return }
    own.?.*.active = false
    api.canvasChanged(app)
}

// Escape during a drag: the colour there was.
fn samplerCancel(app: *App) -> void {
    const own = samplerOf(app)
    if own == null || !own.?.*.active { return }
    own.?.*.active = false
    if own.?.*.background { api.setBackground(app, own.?.*.before) } else { api.setForeground(app, own.?.*.before) }
}

fn samplerStop(app: *App) -> void {
    const own = samplerOf(app)
    if own == null { return }
    own.?.*.active = false
}

fn samplerBusy(app: *App) -> bool {
    if !state.hasSlot(app, state.SLOT_TOOL + @intCast(usize, SAMPLER)) { return false }
    const own = samplerOf(app)
    return own != null && own.?.*.active
}

// Control let go: back to the tool that held the sampler. Held, the
// sampler takes the brush's keys as that tool would (with Control down
// those are Ctrl+[ and Ctrl+], the opacity).
fn samplerKey(app: *App, code: u32, modifiers: u32, down: bool) -> bool {
    if !samplerHeld(app) { return false }
    if isControl(code) {
        if !down {
            samplerStop(app)
            api.releaseTool(app)
        }
        return false
    }
    return brushKeys(app, code, modifiers, down)
}

// ---------------------------------------------------------------------------
// Smart patch

const PatchState = struct {
    ready: bool
    // The size of the brush the mask is painted with.
    size: f64
}

fn patchOf(app: *App) -> ?*PatchState {
    const memory = slotOf(app, PATCH, @sizeOf(PatchState))
    if memory == null { return null }
    const own: *PatchState = unsafe { @ptrCast(*PatchState, memory.?) }
    if !own.*.ready {
        own.*.size = @floatFromInt(f64, keptNumber(app, "tool.patch.size", 24, 1, 1000))
        own.*.ready = true
    }
    return own
}

fn patchSize(app: *App) -> f64 {
    const own = patchOf(app)
    if own == null { return PATCH_SIZE }
    return own.?.*.size
}

fn patchPress(app: *App, input: *const Input) -> void {
    freehandPress(app, input, PATCH)
}

// One pixel of `color` (premultiplied) added `weight` times to the sums.
inline fn gather(color: u32, weight: u32, sums: [*]u32) -> void {
    sums[0] += (color >> 24) * weight
    sums[1] += ((color >> 16) & 255) * weight
    sums[2] += ((color >> 8) & 255) * weight
    sums[3] += (color & 255) * weight
    sums[4] += weight
}

inline fn mean(sums: [*]const u32) -> u32 {
    const weight = sums[4]
    if weight == 0 { return 0 }
    const half = weight / 2
    return pixel.pack((sums[0] + half) / weight, (sums[1] + half) / weight, (sums[2] + half) / weight, (sums[3] + half) / weight)
}

// The layer's pixels under the mask painted on its overlay, filled from
// around it as the header says; the overlay goes. One step of the
// history. The image's rectangle that changed.
fn patchFrom(app: *App, image: *Image, node: *Node) -> Rect {
    // The overlay comes off the node (the canvas shows the layer alone
    // again) and is ended here once its coverage is read.
    const mask = node.*.overlay.?
    node.*.overlay = null
    var changed = device_module.extent(mask)
    image_module.damage(image, changed)
    const bounds = device_module.exactBounds(mask)
    if geom.isEmpty(bounds) || node.*.device == null {
        device_module.destroy(mask)
        return changed
    }
    const area = geom.grown(bounds, PATCH_MARGIN)
    const width = @intCast(usize, area.width)
    const height = @intCast(usize, area.height)
    if width * height > PATCH_LARGEST {
        device_module.destroy(mask)
        api.say(app, state.tr(app, "The patch is too large", "Der Flicken ist zu groß"), true)
        return changed
    }
    const count = width * height
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const original = scratch.words(pool, count)
    const filled = scratch.words(pool, count)
    const amount = scratch.bytes(pool, count)
    const known = scratch.bytes(pool, count)
    const queue = scratch.ints(pool, count)
    const sums_memory = scratch.words(pool, 8)
    if original == null || filled == null || amount == null || known == null || queue == null || sums_memory == null {
        scratch.release(pool, mark)
        device_module.destroy(mask)
        api.say(app, state.tr(app, "There is no memory for the patch", "Für den Flicken ist kein Speicher frei"), true)
        return changed
    }
    const sums = sums_memory.?
    // The mask's coverage (the overlay's alpha), within the selection.
    device_module.readRect(mask, area, filled.?, width)
    var index: usize = 0
    while index < count {
        amount.?[index] = @intCast(u8, filled.?[index] >> 24)
        index += 1
    }
    device_module.destroy(mask)
    if image.*.selected {
        mask_module.readBytes(image.*.selection, area, known.?, width)
        index = 0
        while index < count {
            amount.?[index] = @intCast(u8, pixel.mul(@intCast(u32, amount.?[index]), @intCast(u32, known.?[index])))
            index += 1
        }
    }
    device_module.readRect(node.*.device.?, area, original.?, width)
    // Known (1) where the mask is not, queued (2) once a neighbour is
    // known, to fill (0).
    var anyKnown = false
    index = 0
    while index < count {
        if amount.?[index] == 0 {
            known.?[index] = 1
            filled.?[index] = pixel.premultiplied(original.?[index])
            anyKnown = true
        } else {
            known.?[index] = 0
            filled.?[index] = 0
        }
        index += 1
    }
    if !anyKnown {
        scratch.release(pool, mark)
        return changed
    }
    // The first ring: what is to fill and touches what is known.
    var tail: usize = 0
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const at = y * width + x
            if known.?[at] == 0 && touchesKnown(known.?, width, height, x, y) {
                known.?[at] = 2
                queue.?[tail] = @intCast(i32, at)
                tail += 1
            }
            x += 1
        }
        y += 1
    }
    // Ring by ring inward: each pixel the mean of its neighbours filled
    // before it (the four beside it count twice, the corners once), then
    // its own neighbours to fill are queued.
    var head: usize = 0
    while head < tail {
        const at = @intCast(usize, queue.?[head])
        head += 1
        const x = at % width
        const y_at = at / width
        sums[0] = 0
        sums[1] = 0
        sums[2] = 0
        sums[3] = 0
        sums[4] = 0
        var dy: i32 = -1
        while dy <= 1 {
            var dx: i32 = -1
            while dx <= 1 {
                const nx = @intCast(i32, x) + dx
                const ny = @intCast(i32, y_at) + dy
                if (dx != 0 || dy != 0) && nx >= 0 && ny >= 0 && nx < @intCast(i32, width) && ny < @intCast(i32, height) {
                    const near = @intCast(usize, ny) * width + @intCast(usize, nx)
                    if known.?[near] == 1 { gather(filled.?[near], if dx == 0 || dy == 0 { 2 } else { 1 }, sums) }
                }
                dx += 1
            }
            dy += 1
        }
        filled.?[at] = mean(sums)
        known.?[at] = 1
        dy = -1
        while dy <= 1 {
            var dx: i32 = -1
            while dx <= 1 {
                const nx = @intCast(i32, x) + dx
                const ny = @intCast(i32, y_at) + dy
                if nx >= 0 && ny >= 0 && nx < @intCast(i32, width) && ny < @intCast(i32, height) {
                    const near = @intCast(usize, ny) * width + @intCast(usize, nx)
                    if known.?[near] == 0 && tail < count {
                        known.?[near] = 2
                        queue.?[tail] = @intCast(i32, near)
                        tail += 1
                    }
                }
                dx += 1
            }
            dy += 1
        }
    }
    // Evened out: every filled pixel the mean of the four beside it, in
    // turn from both ends (the rings' order leaves streaks otherwise).
    var round: usize = 0
    while round < PATCH_ROUNDS {
        var step: usize = 0
        while step < tail {
            const at = @intCast(usize, queue.?[if round % 2 == 0 { step } else { tail - 1 - step }])
            const x = at % width
            const y_at = at / width
            sums[0] = 0
            sums[1] = 0
            sums[2] = 0
            sums[3] = 0
            sums[4] = 0
            if x > 0 { gather(filled.?[at - 1], 1, sums) }
            if x + 1 < width { gather(filled.?[at + 1], 1, sums) }
            if y_at > 0 { gather(filled.?[at - width], 1, sums) }
            if y_at + 1 < height { gather(filled.?[at + width], 1, sums) }
            filled.?[at] = mean(sums)
            step += 1
        }
        round += 1
    }
    // Mixed in by the mask's coverage; a layer whose alpha is locked keeps
    // its alpha.
    index = 0
    while index < count {
        const cover = @intCast(u32, amount.?[index])
        if cover != 0 {
            const before = original.?[index]
            const under = pixel.premultiplied(before)
            const over = filled.?[index]
            var mixed = pixel.straight(pixel.pack(pixel.lerp(under >> 24, over >> 24, cover), pixel.lerp((under >> 16) & 255, (over >> 16) & 255, cover), pixel.lerp((under >> 8) & 255, (over >> 8) & 255, cover), pixel.lerp(under & 255, over & 255, cover)))
            if node.*.alphaLocked { mixed = pixel.withAlpha(if mixed >> 24 == 0 { before } else { mixed }, before >> 24) }
            original.?[index] = mixed
        }
        index += 1
    }
    if ops.beginPixels(image, node) {
        _ = device_module.writeRect(node.*.device.?, area, original.?, width)
        changed = geom.unite(changed, ops.endPixels(image, node, state.tr(app, "Smart patch", "Intelligenter Flicken")))
    }
    scratch.release(pool, mark)
    return changed
}

// Whether a pixel of the grid has a known neighbour (of the eight).
fn touchesKnown(known: [*]const u8, width: usize, height: usize, x: usize, y: usize) -> bool {
    var dy: i32 = -1
    while dy <= 1 {
        var dx: i32 = -1
        while dx <= 1 {
            const nx = @intCast(i32, x) + dx
            const ny = @intCast(i32, y) + dy
            if (dx != 0 || dy != 0) && nx >= 0 && ny >= 0 && nx < @intCast(i32, width) && ny < @intCast(i32, height) {
                if known[@intCast(usize, ny) * width + @intCast(usize, nx)] == 1 { return true }
            }
            dx += 1
        }
        dy += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Options kept between runs (the settings' texts: whole numbers)

// The number kept as `key`, held to low..high; `otherwise` when none is
// kept or it is no number.
fn keptNumber(app: *App, key: []const u8, otherwise: i64, low: i64, high: i64) -> i64 {
    const text = settings.text(app, key)
    if text.length == 0 || text.length > 18 { return otherwise }
    var index: usize = 0
    var negative = false
    if text[0] == 45 {
        negative = true
        index = 1
    }
    if index >= text.length { return otherwise }
    var value: i64 = 0
    while index < text.length {
        const byte = text[index]
        if byte < 48 || byte > 57 { return otherwise }
        value = value * 10 + @intCast(i64, byte - 48)
        index += 1
    }
    if negative { value = 0 - value }
    if value < low { return low }
    if value > high { return high }
    return value
}

fn keepNumber(app: *App, key: []const u8, value: f64) -> void {
    var text: [24]u8 = undefined
    const bytes: [*]u8 = &text
    const whole = if value == value { math.round(math.clamp(value, -1.0e9, 1.0e9)) } else { 0.0 }
    const length = std.text.appendSigned(bytes, 0, 24, @intFromFloat(isize, whole))
    _ = settings.setText(app, key, bytes[0..length])
}

// ---------------------------------------------------------------------------
// Marks over the canvas

// Whether the pointer is on the canvas with nothing over it (a menu, a
// docker, a dialog), and not holding the hand.
fn pointerOnCanvas(app: *App) -> bool {
    const doc = api.document(app)
    if doc == null || !app.*.pointerInside || app.*.dialogCount > 0 || app.*.spaceHeld { return false }
    if !ui.contains(doc.?.*.view.area, app.*.pointerX, app.*.pointerY) { return false }
    if app.*.canvasGrab { return app.*.grabButton == ui_app.BUTTON_LEFT }
    return state.uiOf(app).*.hover == view.id("nebula.canvas")
}

// The image's place under the pointer.
fn pointerPlace(app: *App, x: *f64, y: *f64) -> void {
    x.* = 0.0
    y.* = 0.0
    const doc = api.document(app)
    if doc == null { return }
    viewport.toImage(&doc.?.*.view, @floatFromInt(f64, app.*.pointerX) + 0.5, @floatFromInt(f64, app.*.pointerY) + 0.5, x, y)
}

// The brush's tip as its outline at (x, y) of the image, `size` across
// (scaled by the view's zoom), or a small cross where that would be
// smaller than SMALLEST_OUTLINE window pixels (and as the settings ask).
fn drawCursor(app: *App, marks: *const overlay.Painter, x: f64, y: f64, size: f64) -> void {
    if !marks.*.live { return }
    const prefs = settings.get(app)
    if !(size * marks.*.zoom >= SMALLEST_OUTLINE * @floatFromInt(f64, marks.*.scale)) || !prefs.*.cursorOutline {
        overlay.cross(marks, x, y)
        return
    }
    const brush = brushes.current(app)
    const shape = &brush.*.tip
    if shape.*.kind == types.TIP_AUTO && shape.*.shape == types.SHAPE_CIRCLE && shape.*.ratio >= 0.999 && shape.*.spikes <= 2 {
        // A round tip: the ring, which has no seams where a polygon's
        // edges turn past the diagonal.
        overlay.circle(marks, x, y, size / 2.0)
        if prefs.*.cursorCross { overlay.cross(marks, x, y) }
        return
    }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const points = scratch.doubles(pool, OUTLINE_ROOM)
    if points != null {
        const count = tip_module.outline(&brush.*.tip, size, brush.*.tip.ratio, brush.*.tip.angle * math.pi / 180.0, points.?, OUTLINE_ROOM)
        overlay.outline(marks, x, y, points.?, count)
    }
    scratch.release(pool, mark)
    if prefs.*.cursorCross { overlay.cross(marks, x, y) }
}

// "24 px" beside the outline while the size is dragged.
fn sizeLabel(app: *App, marks: *const overlay.Painter, x: f64, y: f64, size: f64) -> void {
    var text: [32]u8 = undefined
    const bytes: [*]u8 = &text
    const whole = if !(size > 0.0) { 0.0 } else if size > 100000.0 { 100000.0 } else { size }
    var length = std.text.appendUnsigned(bytes, 0, 32, @intFromFloat(usize, whole + 0.5))
    length = std.text.append(bytes, length, 32, " px")
    overlay.label(marks, x, y, bytes[0..length])
}

// The outline at the pointer (or at the press while Shift drags the
// size): the brush's, the patch's.
fn brushOverlay(app: *App, canvas: *Canvas) -> void {
    const marks = overlay.begin(app, canvas)
    if !marks.live { return }
    const found = paintingOf(app)
    if found != null && found.?.*.sizing {
        const p = found.?
        const size = toolSize(app, p.*.sizeTool)
        drawCursor(app, &marks, p.*.sizeAtX, p.*.sizeAtY, size)
        sizeLabel(app, &marks, p.*.sizeAtX + size / 2.0, p.*.sizeAtY, size)
        return
    }
    if !pointerOnCanvas(app) { return }
    var x: f64 = 0.0
    var y: f64 = 0.0
    pointerPlace(app, &x, &y)
    drawCursor(app, &marks, x, y, toolSize(app, app.*.tool))
}

// The line being dragged, its ends, its length and angle.
fn lineOverlay(app: *App, canvas: *Canvas) -> void {
    brushOverlay(app, canvas)
    const own = lineOf(app)
    if own == null || !own.?.*.active { return }
    const marks = overlay.begin(app, canvas)
    if !marks.live { return }
    const line = own.?
    overlay.line(&marks, line.*.x0, line.*.y0, line.*.x1, line.*.y1)
    overlay.handle(&marks, line.*.x0, line.*.y0, overlay.ROUND, false)
    overlay.handle(&marks, line.*.x1, line.*.y1, overlay.ROUND, true)
    const dx = line.*.x1 - line.*.x0
    const dy = line.*.y1 - line.*.y0
    // Degrees up from the right, as on paper: -180 to 180.
    const degrees = math.round(math.atan2(0.0 - dy, dx) * 180.0 / math.pi)
    var text: [48]u8 = undefined
    const bytes: [*]u8 = &text
    const length = math.hypot(dx, dy)
    var written = std.text.appendUnsigned(bytes, 0, 48, @intFromFloat(usize, (if length > 1.0e9 { 1.0e9 } else { length }) + 0.5))
    written = std.text.append(bytes, written, 48, " px  ")
    written = std.text.appendSigned(bytes, written, 48, @intFromFloat(isize, if degrees == -180.0 { 180.0 } else { degrees }))
    written = std.text.append(bytes, written, 48, "°")
    overlay.label(&marks, line.*.x1, line.*.y1, bytes[0..written])
}

// The pen of the dynamic brush and its rope to the pointer.
fn dynamicOverlay(app: *App, canvas: *Canvas) -> void {
    brushOverlay(app, canvas)
    const found = paintingOf(app)
    const own = dynamicOf(app)
    if found == null || own == null || !found.?.*.painting || found.?.*.owner != DYNAMIC { return }
    const marks = overlay.begin(app, canvas)
    if !marks.live { return }
    overlay.dashedLine(&marks, own.?.*.penX, own.?.*.penY, own.?.*.aimX, own.?.*.aimY)
    overlay.cross(&marks, own.?.*.penX, own.?.*.penY)
}

// The centre, the axes of the copies, and the brush's outline at every
// copy of the pointer's place.
fn multiOverlay(app: *App, canvas: *Canvas) -> void {
    const marks = overlay.begin(app, canvas)
    const own = multiOf(app)
    const image = api.image(app)
    if !marks.live || own == null || image == null { return }
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    multiCenter(app, &cx, &cy)
    const count = copiesOf(own.?)
    const reach = @floatFromInt(f64, image.?.*.width + image.?.*.height)
    const angle = own.?.*.angle * math.pi / 180.0
    var index: usize = 0
    while index < count {
        // Upright (up from the centre) turned by the angle and the copy's
        // share of the turn.
        const turn = angle + math.tau * @floatFromInt(f64, index) / @floatFromInt(f64, count)
        overlay.dashedLine(&marks, cx, cy, cx + reach * math.sin(turn), cy - reach * math.cos(turn))
        index += 1
    }
    overlay.cross(&marks, cx, cy)
    const found = paintingOf(app)
    if found != null && found.?.*.sizing {
        brushOverlay(app, canvas)
        return
    }
    if !pointerOnCanvas(app) { return }
    var x: f64 = 0.0
    var y: f64 = 0.0
    pointerPlace(app, &x, &y)
    const size = brushes.current(app).*.size
    const mirrored = own.?.*.mirror
    const phi = math.pi / 2.0 + angle
    const mirror_cos = math.cos(phi * 2.0)
    const mirror_sin = math.sin(phi * 2.0)
    var copy: usize = 0
    const copies = if mirrored { count * 2 } else { count }
    while copy < copies {
        var dx = x - cx
        var dy = y - cy
        var turn = copy
        if copy >= count {
            turn = copy - count
            const reflected = dx * mirror_cos + dy * mirror_sin
            dy = dx * mirror_sin - dy * mirror_cos
            dx = reflected
        }
        const by = math.tau * @floatFromInt(f64, turn) / @floatFromInt(f64, count)
        const c = math.cos(by)
        const s = math.sin(by)
        drawCursor(app, &marks, cx + dx * c - dy * s, cy + dx * s + dy * c, size)
        copy += 1
    }
}

// A square of `color` (straight) in the window, inside the canvas's part
// the marks keep to, counted with the marks (the canvas view paints over
// it again when they move).
fn windowSquare(app: *App, canvas: *Canvas, area: ui.Rect, color: u32) -> void {
    const share = overlay.shared(app)
    if share == null || canvas.*.width == 0 || canvas.*.device != 0 { return }
    const kept = ui.intersect(area, share.?.*.clip)
    if ui.isEmpty(kept) { return }
    canvas_module.fillRect(canvas, kept.x, kept.y, kept.width, kept.height, pixel.premultiplied(color))
    share.?.*.bounds = geom.unite(share.?.*.bounds, kept)
}

// The circle sampled from; while a press samples, the colour taken over
// the one there was, beside the pointer.
fn samplerOverlay(app: *App, canvas: *Canvas) -> void {
    const own = samplerOf(app)
    if own == null || !pointerOnCanvas(app) { return }
    const marks = overlay.begin(app, canvas)
    if !marks.live { return }
    var x: f64 = 0.0
    var y: f64 = 0.0
    pointerPlace(app, &x, &y)
    const radius = radiusOf(own.?)
    if radius > 0 { overlay.circle(&marks, @floor(x) + 0.5, @floor(y) + 0.5, @floatFromInt(f64, radius) + 0.5) }
    if !own.?.*.active { return }
    // The colour taken above the one there was, framed light inside dark
    // so that it reads on any picture.
    const s = state.px(app, 1)
    const side = 20 * s
    const left = app.*.pointerX + 16 * s
    const top = app.*.pointerY + 16 * s
    const now = if own.?.*.background { app.*.background } else { app.*.foreground }
    windowSquare(app, canvas, ui.rect(left, top, side + 4 * s, side * 2 + 5 * s), 0xFF101114)
    windowSquare(app, canvas, ui.rect(left + s, top + s, side + 2 * s, side * 2 + 3 * s), 0xFFF2F3F5)
    windowSquare(app, canvas, ui.rect(left + 2 * s, top + 2 * s, side, side), now | 0xFF000000)
    windowSquare(app, canvas, ui.rect(left + 2 * s, top + 3 * s + side, side, side), own.?.*.before | 0xFF000000)
}

// ---------------------------------------------------------------------------
// Options (the Tool Options docker)

// Rows of the panel, one below the other: `row` high, `gap` apart, inside
// `pad` of the area.
const Rows = struct {
    x: i32
    y: i32
    width: i32
    row: i32
    gap: i32
    pad: i32
    top: i32
    s: i32
}

fn rowsIn(app: *App, area: ui.Rect) -> Rows {
    const s = state.px(app, 1)
    return Rows.{ .x = area.x + 8 * s, .y = area.y + 8 * s, .width = area.width - 16 * s, .row = kit_module.ROW * s, .gap = 2 * s, .pad = 8 * s, .top = area.y, .s = s }
}

fn nextRow(rows: *Rows) -> ui.Rect {
    const made = ui.rect(rows.*.x, rows.*.y, rows.*.width, rows.*.row)
    rows.*.y += rows.*.row + rows.*.gap
    return made
}

// A little more room between groups of rows.
fn space(rows: *Rows) -> void {
    rows.*.y += 6 * rows.*.s
}

fn heightOf(rows: *const Rows) -> i32 {
    return rows.*.y - rows.*.gap + rows.*.pad - rows.*.top
}

// The parts of a row with a label: the label's two fifths, the control's
// rest.
fn labelPart(row: ui.Rect) -> ui.Rect {
    return ui.rect(row.x, row.y, row.width * 2 / 5, row.height)
}

fn controlPart(row: ui.Rect) -> ui.Rect {
    const left = row.width * 2 / 5
    return ui.rect(row.x + left, row.y, row.width - left, row.height)
}

fn hint(app: *App, rows: *Rows, text: []const u8) -> void {
    kit_module.label(api.kit(app), nextRow(rows), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
}

// The brush's size (and opacity and flow when asked), as the toolbar
// has them.
fn brushSliders(app: *App, p: *Painting, rows: *Rows, opacity: bool, flow: bool) -> void {
    const k = api.kit(app)
    const brush = brushes.current(app)
    var size = brush.*.size
    if kit_module.slider(k, view.id("nebula.paint.size"), nextRow(rows), state.tr(app, "Size", "Größe"), &size, &p.*.sizeOptions) { brushes.setSize(app, size) }
    if opacity {
        var value = brush.*.opacity * 100.0
        if kit_module.slider(k, view.id("nebula.paint.opacity"), nextRow(rows), state.tr(app, "Opacity", "Deckkraft"), &value, &p.*.percentOptions) { brushes.setOpacity(app, value / 100.0) }
    }
    if flow {
        var value = brush.*.flow * 100.0
        if kit_module.slider(k, view.id("nebula.paint.flow"), nextRow(rows), state.tr(app, "Flow", "Fluss"), &value, &p.*.percentOptions) { brushes.setFlow(app, value / 100.0) }
    }
}

fn smoothingName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    return smoothing.title(@intCast(u8, index), app.*.german)
}

// The brush's size, opacity and flow; the smoothing (the Painting
// settings, kept by app/settings.mlx).
fn brushOptions(app: *App, area: ui.Rect) -> i32 {
    var rows = rowsIn(app, area)
    const found = paintingOf(app)
    if found == null { return heightOf(&rows) }
    const p = found.?
    const k = api.kit(app)
    brushSliders(app, p, &rows, true, true)
    space(&rows)
    const prefs = settings.get(app)
    const row = nextRow(&rows)
    kit_module.label(k, labelPart(row), state.tr(app, "Smoothing", "Glättung"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    var mode = @intCast(usize, prefs.*.smoothing)
    if kit_module.comboBoxWith(k, view.id("nebula.paint.smoothing"), controlPart(row), smoothing.MODES, smoothingName, @intFromPtr(app), &mode) {
        prefs.*.smoothing = @intCast(u8, mode)
        _ = settings.changed(app)
    }
    // The distance is what the weighted mode and the stabilizer go by.
    const distance_id = view.id("nebula.paint.distance")
    var distance = @floatFromInt(f64, prefs.*.smoothingDistance)
    p.*.distanceOptions.disabled = prefs.*.smoothing != smoothing.WEIGHTED && prefs.*.smoothing != smoothing.STABILIZER
    if kit_module.slider(k, distance_id, nextRow(&rows), state.tr(app, "Distance", "Abstand"), &distance, &p.*.distanceOptions) && distance == distance {
        prefs.*.smoothingDistance = @intFromFloat(u32, math.clamp(distance, 1.0, 1000.0) + 0.5)
    }
    if kit_module.released(k, distance_id) { _ = settings.changed(app) }
    var simulate = prefs.*.simulatePressure
    if kit_module.checkBox(k, view.id("nebula.paint.speed"), nextRow(&rows), state.tr(app, "Pressure from speed", "Druck aus Geschwindigkeit"), &simulate) {
        prefs.*.simulatePressure = simulate
        _ = settings.changed(app)
    }
    return heightOf(&rows)
}

fn lineOptions(app: *App, area: ui.Rect) -> i32 {
    var rows = rowsIn(app, area)
    const found = paintingOf(app)
    const own = lineOf(app)
    if found == null || own == null { return heightOf(&rows) }
    brushSliders(app, found.?, &rows, true, false)
    space(&rows)
    if kit_module.checkBox(api.kit(app), view.id("nebula.paint.ramp"), nextRow(&rows), state.tr(app, "Pressure ramp", "Druck ansteigend"), &own.?.*.ramp) {
        keepNumber(app, "tool.line.ramp", if own.?.*.ramp { 1.0 } else { 0.0 })
    }
    space(&rows)
    hint(app, &rows, state.tr(app, "Shift: angle in steps of 15°", "Umschalt: Winkel in 15°-Schritten"))
    hint(app, &rows, state.tr(app, "Alt: move the line", "Alt: Linie verschieben"))
    return heightOf(&rows)
}

fn dynamicOptions(app: *App, area: ui.Rect) -> i32 {
    var rows = rowsIn(app, area)
    const found = paintingOf(app)
    const own = dynamicOf(app)
    if found == null || own == null { return heightOf(&rows) }
    const p = found.?
    const k = api.kit(app)
    brushSliders(app, p, &rows, true, false)
    space(&rows)
    const mass_id = view.id("nebula.paint.mass")
    var mass = own.?.*.mass * 100.0
    if kit_module.slider(k, mass_id, nextRow(&rows), state.tr(app, "Mass", "Masse"), &mass, &p.*.percentOptions) { own.?.*.mass = mass / 100.0 }
    if kit_module.released(k, mass_id) { keepNumber(app, "tool.dynamic.mass", own.?.*.mass * 100.0) }
    const drag_id = view.id("nebula.paint.drag")
    var drag = own.?.*.drag * 100.0
    if kit_module.slider(k, drag_id, nextRow(&rows), state.tr(app, "Drag", "Widerstand"), &drag, &p.*.percentOptions) { own.?.*.drag = drag / 100.0 }
    if kit_module.released(k, drag_id) { keepNumber(app, "tool.dynamic.drag", own.?.*.drag * 100.0) }
    return heightOf(&rows)
}

fn multiOptions(app: *App, area: ui.Rect) -> i32 {
    var rows = rowsIn(app, area)
    const found = paintingOf(app)
    const own = multiOf(app)
    if found == null || own == null { return heightOf(&rows) }
    const k = api.kit(app)
    brushSliders(app, found.?, &rows, true, false)
    space(&rows)
    const count_id = view.id("nebula.paint.copies")
    if kit_module.slider(k, count_id, nextRow(&rows), state.tr(app, "Copies", "Kopien"), &own.?.*.count, &own.?.*.countOptions) { api.canvasChanged(app) }
    if kit_module.released(k, count_id) { keepNumber(app, "tool.multibrush.count", own.?.*.count) }
    const angle_id = view.id("nebula.paint.angle")
    if kit_module.slider(k, angle_id, nextRow(&rows), state.tr(app, "Angle", "Winkel"), &own.?.*.angle, &own.?.*.angleOptions) { api.canvasChanged(app) }
    if kit_module.released(k, angle_id) { keepNumber(app, "tool.multibrush.angle", own.?.*.angle) }
    if kit_module.checkBox(k, view.id("nebula.paint.mirror"), nextRow(&rows), state.tr(app, "Mirrored too", "Auch gespiegelt"), &own.?.*.mirror) {
        keepNumber(app, "tool.multibrush.mirror", if own.?.*.mirror { 1.0 } else { 0.0 })
        api.canvasChanged(app)
    }
    space(&rows)
    if kit_module.button(k, view.id("nebula.paint.center"), nextRow(&rows), state.tr(app, "Centre in the middle", "Zentrum in die Mitte"), kit_module.BUTTON_NORMAL) { centerMiddle(app) }
    hint(app, &rows, state.tr(app, "Ctrl+click: put the centre", "Strg+Klick: Zentrum setzen"))
    return heightOf(&rows)
}

fn sourceName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == FROM_LAYER { return state.tr(app, "Active layer", "Aktive Ebene") }
    return state.tr(app, "Image", "Bild")
}

fn samplerOptions(app: *App, area: ui.Rect) -> i32 {
    var rows = rowsIn(app, area)
    const found = paintingOf(app)
    const own = samplerOf(app)
    if found == null || own == null { return heightOf(&rows) }
    const k = api.kit(app)
    const row = nextRow(&rows)
    kit_module.label(k, labelPart(row), state.tr(app, "Sample", "Quelle"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    if kit_module.comboBoxWith(k, view.id("nebula.paint.source"), controlPart(row), 2, sourceName, @intFromPtr(app), &own.?.*.source) {
        keepNumber(app, "tool.sampler.source", @floatFromInt(f64, own.?.*.source))
    }
    const radius_id = view.id("nebula.paint.radius")
    _ = kit_module.slider(k, radius_id, nextRow(&rows), state.tr(app, "Radius", "Radius"), &own.?.*.radius, &own.?.*.radiusOptions)
    if kit_module.released(k, radius_id) { keepNumber(app, "tool.sampler.radius", own.?.*.radius) }
    const blend_id = view.id("nebula.paint.blend")
    _ = kit_module.slider(k, blend_id, nextRow(&rows), state.tr(app, "Blend", "Mischen"), &own.?.*.blend, &found.?.*.percentOptions)
    if kit_module.released(k, blend_id) { keepNumber(app, "tool.sampler.blend", own.?.*.blend) }
    space(&rows)
    hint(app, &rows, state.tr(app, "Ctrl+click: background colour", "Strg+Klick: Hintergrundfarbe"))
    return heightOf(&rows)
}

fn patchOptions(app: *App, area: ui.Rect) -> i32 {
    var rows = rowsIn(app, area)
    const found = paintingOf(app)
    const own = patchOf(app)
    if found == null || own == null { return heightOf(&rows) }
    const k = api.kit(app)
    const size_id = view.id("nebula.paint.patch")
    if kit_module.slider(k, size_id, nextRow(&rows), state.tr(app, "Size", "Größe"), &own.?.*.size, &found.?.*.sizeOptions) {
        setToolSize(app, PATCH, own.?.*.size)
    }
    if kit_module.released(k, size_id) { keepNumber(app, "tool.patch.size", own.?.*.size) }
    space(&rows)
    hint(app, &rows, state.tr(app, "Paint over what is to go", "Übermalen, was weg soll"))
    return heightOf(&rows)
}

// ---------------------------------------------------------------------------
// The tools

const TOOLS = [6]state.Tool{
    state.Tool.{ .id = BRUSH, .key = "brush", .name = "Freehand Brush", .german = "Freihandpinsel", .shortcut = "B", .icon = icons.TOOL_BRUSH, .group = state.GROUP_PAINT, .cursor = state.CURSOR_BRUSH, .activate = null, .deactivate = paintStop, .press = brushPress, .move = freehandMove, .release = freehandRelease, .keyPress = paintKey, .tick = paintTick, .overlay = brushOverlay, .options = brushOptions, .cancel = paintCancel, .finish = null, .busy = paintBusy },
    state.Tool.{ .id = LINE, .key = "line", .name = "Line", .german = "Linie", .shortcut = "V", .icon = icons.TOOL_LINE, .group = state.GROUP_PAINT, .cursor = state.CURSOR_BRUSH, .activate = null, .deactivate = lineCancel, .press = linePress, .move = lineMove, .release = lineRelease, .keyPress = paintKey, .tick = null, .overlay = lineOverlay, .options = lineOptions, .cancel = lineCancel, .finish = null, .busy = lineBusy },
    state.Tool.{ .id = DYNAMIC, .key = "dynamicbrush", .name = "Dynamic Brush", .german = "Dynamischer Pinsel", .shortcut = "", .icon = icons.TOOL_DYNAMIC_BRUSH, .group = state.GROUP_PAINT, .cursor = state.CURSOR_BRUSH, .activate = null, .deactivate = paintStop, .press = dynamicPress, .move = dynamicMove, .release = dynamicRelease, .keyPress = paintKey, .tick = paintTick, .overlay = dynamicOverlay, .options = dynamicOptions, .cancel = paintCancel, .finish = null, .busy = paintBusy },
    state.Tool.{ .id = MULTIBRUSH, .key = "multibrush", .name = "Multibrush", .german = "Multipinsel", .shortcut = "Q", .icon = icons.TOOL_MULTIBRUSH, .group = state.GROUP_PAINT, .cursor = state.CURSOR_BRUSH, .activate = null, .deactivate = multiStop, .press = multiPress, .move = freehandMove, .release = freehandRelease, .keyPress = paintKey, .tick = paintTick, .overlay = multiOverlay, .options = multiOptions, .cancel = paintCancel, .finish = null, .busy = paintBusy },
    state.Tool.{ .id = SAMPLER, .key = "colorsampler", .name = "Colour Sampler", .german = "Farbpipette", .shortcut = "P", .icon = icons.TOOL_COLOR_SAMPLER, .group = state.GROUP_PAINT, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = samplerStop, .press = samplerPress, .move = samplerMove, .release = samplerRelease, .keyPress = samplerKey, .tick = null, .overlay = samplerOverlay, .options = samplerOptions, .cancel = samplerCancel, .finish = null, .busy = samplerBusy },
    state.Tool.{ .id = PATCH, .key = "smartpatch", .name = "Smart Patch", .german = "Intelligenter Flicken", .shortcut = "", .icon = icons.TOOL_SMART_PATCH, .group = state.GROUP_PAINT, .cursor = state.CURSOR_BRUSH, .activate = null, .deactivate = paintStop, .press = patchPress, .move = freehandMove, .release = freehandRelease, .keyPress = paintKey, .tick = paintTick, .overlay = brushOverlay, .options = patchOptions, .cancel = paintCancel, .finish = null, .busy = paintBusy },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The six tools of this module, ids BRUSH to PATCH, for
// tools/registry.mlx: the table kept in heap memory at the first call,
// the same rows every call after.
pub fn list() -> []const state.Tool {
    if kept.address != 0 { return table.rows(state.Tool, &kept) }
    return table.keep(state.Tool, &kept, TOOLS[0..])
}
