// nebula tools: painting by hand. For now one plain brush that stamps
// round soft dabs along the pointer's way (the brush engines of brush/
// take its place): it shows how a painting tool is built: the stroke
// goes into an overlay on the active layer (core/node.mlx), which the
// canvas shows at once, and becomes the layer's own pixels as one step
// of its history when the button comes up (core/ops.mlx's mergeOverlay).
const std = @import("std")
const ui_app = @import("std.ui.app")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")

pub const App = state.App
pub const Input = state.Input

pub const BRUSH: u8 = 0

// What the brush keeps while it is the tool in use.
const Brush = struct {
    painting: bool
    // The layer painted on (its id: it may be gone when the stroke ends).
    node: u32
    lastX: f64
    lastY: f64
    // Pixels left to go before the next dab.
    owed: f64
    size: f64
}

fn brushOf(app: *App) -> ?*Brush {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, BRUSH), @sizeOf(Brush))
    if memory == null { return null }
    const brush: *Brush = unsafe { @ptrCast(*Brush, memory.?) }
    if brush.*.size == 0.0 { brush.*.size = 24.0 }
    return brush
}

// One dab: a disc of `size` across at (x, y), soft at its rim, in
// `color`, into `target`. The image's rectangle it touched.
fn dab(target: *device_module.Device, x: f64, y: f64, size: f64, color: u32) -> geom.Rect {
    const radius = size / 2.0
    const area = geom.fromBounds(x - radius - 1.0, y - radius - 1.0, x + radius + 1.0, y + radius + 1.0)
    if geom.isEmpty(area) || area.width > 4096 { return geom.empty() }
    const width = @intCast(usize, area.width)
    const height = @intCast(usize, area.height)
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const rows = scratch.words(pool, width * height)
    const cover = scratch.bytes(pool, width)
    if rows == null || cover == null {
        scratch.release(pool, mark)
        return geom.empty()
    }
    device_module.readRect(target, area, rows.?, width)
    var row: usize = 0
    while row < height {
        const dy = @floatFromInt(f64, area.y + @intCast(i32, row)) + 0.5 - y
        var column: usize = 0
        while column < width {
            const dx = @floatFromInt(f64, area.x + @intCast(i32, column)) + 0.5 - x
            const distance = @sqrt(dx * dx + dy * dy)
            // Full inside, fading over the last pixel and a half.
            var amount = (radius - distance) / 1.5 + 0.5
            if amount < 0.0 { amount = 0.0 }
            if amount > 1.0 { amount = 1.0 }
            cover.?[column] = @intCast(u8, @intFromFloat(u32, amount * 255.0 + 0.5))
            column += 1
        }
        // A stroke's dabs do not add up beyond full: the larger covers.
        const line = rows.? + row * width
        column = 0
        while column < width {
            const amount = @intCast(u32, cover.?[column])
            if amount > line[column] >> 24 { line[column] = pixel.withAlpha(color, amount) }
            column += 1
        }
        row += 1
    }
    _ = device_module.writeRect(target, area, rows.?, width)
    scratch.release(pool, mark)
    return area
}

fn press(app: *App, input: *const Input) -> void {
    const brush = brushOf(app)
    if brush == null || input.*.button != ui_app.BUTTON_LEFT { return }
    const node = api.paintable(app)
    const image = api.image(app)
    if node == null || image == null { return }
    const overlay = device_module.create(app.*.allocator, 0)
    if overlay == null { return }
    node.?.*.overlay = overlay
    node.?.*.overlayOpacity = 255
    node.?.*.overlayBlend = if app.*.eraser { blend.ERASE } else { blend.NORMAL }
    node.?.*.overlayMasked = true
    brush.?.*.painting = true
    brush.?.*.node = node.?.*.id
    brush.?.*.lastX = input.*.x
    brush.?.*.lastY = input.*.y
    brush.?.*.owed = 0.0
    api.imageChanged(app, dab(overlay.?, input.*.x, input.*.y, brush.?.*.size, app.*.foreground))
}

fn move(app: *App, input: *const Input) -> void {
    const brush = brushOf(app)
    if brush == null || !brush.?.*.painting { return }
    const image = api.image(app)
    if image == null { return }
    const node = node_module.find(image.?.*.root, brush.?.*.node)
    if node == null || node.?.*.overlay == null { return }
    // A dab every quarter of the brush's size along the way.
    const step = if brush.?.*.size / 4.0 < 1.0 { 1.0 } else { brush.?.*.size / 4.0 }
    const dx = input.*.x - brush.?.*.lastX
    const dy = input.*.y - brush.?.*.lastY
    const length = @sqrt(dx * dx + dy * dy)
    var area = geom.empty()
    var along = step - brush.?.*.owed
    while along <= length {
        const t = along / length
        area = geom.unite(area, dab(node.?.*.overlay.?, brush.?.*.lastX + dx * t, brush.?.*.lastY + dy * t, brush.?.*.size, app.*.foreground))
        along += step
    }
    brush.?.*.owed = length - (along - step)
    brush.?.*.lastX = input.*.x
    brush.?.*.lastY = input.*.y
    api.imageChanged(app, area)
}

fn finishStroke(app: *App, keep: bool) -> void {
    const brush = brushOf(app)
    if brush == null || !brush.?.*.painting { return }
    brush.?.*.painting = false
    const image = api.image(app)
    if image == null { return }
    const node = node_module.find(image.?.*.root, brush.?.*.node)
    if node == null { return }
    if keep {
        _ = ops.mergeOverlay(image.?, node.?, if app.*.eraser { state.tr(app, "Erase", "Radieren") } else { state.tr(app, "Brush stroke", "Pinselstrich") })
    } else {
        _ = ops.dropOverlay(image.?, node.?)
    }
    api.redraw(app)
}

fn release(app: *App, input: *const Input) -> void {
    finishStroke(app, true)
}

fn cancel(app: *App) -> void {
    finishStroke(app, false)
}

fn busy(app: *App) -> bool {
    const brush = brushOf(app)
    return brush != null && brush.?.*.painting
}

const TOOLS = [1]state.Tool{
    state.Tool.{ .id = BRUSH, .key = "brush", .name = "Freehand Brush", .german = "Freihandpinsel", .shortcut = "B", .icon = 0, .group = state.GROUP_PAINT, .cursor = state.CURSOR_BRUSH, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = null, .tick = null, .overlay = null, .options = null, .cancel = cancel, .finish = null, .busy = busy },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Tool {
    if kept.address != 0 { return table.rows(state.Tool, &kept) }
    return table.keep(state.Tool, &kept, TOOLS[0..])
}
