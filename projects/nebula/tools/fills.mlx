// nebula tools: filling. Three tools of the toolbox's fill group:
//
//   Fill (F)            a click fills the region under the pointer: the
//                       pixels of about the colour clicked that hang
//                       together with it (core/fill.mlx's region), or
//                       every pixel of about that colour, or the whole
//                       selection whatever its colours
//   Gradient (G)        a drag lays a gradient (core/gradient.mlx) from
//                       where it started to where it ends
//   Enclose and Fill    a rectangle, an ellipse or a lasso drawn around
//                       regions fills those that lie wholly inside it
//                       (core/fill.mlx's enclosed)
//
// Each completed action is one step of the image's history ("Fill",
// "Gradient", "Enclose and Fill"), and always only where the selection
// is, when there is one. A fill is done with the foreground colour, the
// background colour or a built-in pattern (generators/patterns.mlx), in
// a blend mode at an opacity; the region is found in the active layer or
// in what all layers show together ("sample all layers"), within a
// threshold of the colour clicked, then grown or shrunk and feathered.
// Into a mask (or what a filter layer filters), whose pixels are amounts,
// every colour goes as its grey, and erasing paints black (hides). A
// layer that shows something unfinished of another part (an overlay, a
// preview in its place, a change of its pixels open) is not filled.
//
// While a gradient is dragged its preview is the active layer's overlay
// (core/node.mlx): the gradient rendered without anti-aliasing (the
// reduced cost) over the part of the image the canvas shows, in the
// chosen blend mode and opacity, under the selection. When that part is
// more than PREVIEW_MOST pixels (a large image seen whole) there is no
// such preview: the line from the start to the end with its two markers
// is all that shows (it shows in any case). On release the overlay goes
// and the gradient is laid into the layer at full quality. Shift (as
// the window says it is held, at each motion) holds the drag's angle to
// steps of 15 degrees, and makes the enclosing rectangle a square and the
// ellipse a circle. Escape gives up a drag in progress without a trace,
// and so does another image coming in front: a drag belongs to its image
// and layer.
//
// The options are drawn by options() for the Tool Options docker; what
// people set is kept between runs in app/settings.mlx's text store, one
// text a tool ("tool.fill", "tool.gradient", "tool.enclosefill", the
// options as "name=number" parted by ';'), written when a change is
// complete. fillOptions(), gradientOptions() and encloseOptions() hand
// out a tool's options record (for a script or a test that sets them):
//
//     const bucket = tools.byKey("fill").?           // tools/registry.mlx
//     fills.fillOptions(app).?.*.common.threshold = 40.0
//     bucket.*.press.?(app, &input)                  // one step "Fill"
//
// Not done: Krita's colour-labelled layers as the reference and "stop
// growing at the darkest pixels" (core/fill.mlx has neither), a drag of
// the fill tool that goes on filling the regions it passes, the shaped
// gradient (core/gradient.mlx renders SHAPED as linear, so it is not
// offered), gradients other than the built-in ones (no editor yet), a
// polygon (click by click) and a brush as enclosing shapes, Krita's
// "everything except ..." region methods (enclose-and-fill offers the
// four of core/fill.mlx's enclosed), a reference colour of enclose-and-
// fill other than the foreground taken over, and the pattern's scale
// and turn (a pattern lies from the image's corner at its own size).
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const shell_module = @import("../app/shell.mlx")
const keys = @import("../app/keys.mlx")
const settings = @import("../app/settings.mlx")
const kit_module = @import("../ui/kit.mlx")
const overlay = @import("../ui/overlay.mlx")
const viewport = @import("../ui/viewport.mlx")
const icons = @import("../ui/icons.mlx")
const device_module = @import("../core/device.mlx")
const mask_module = @import("../core/mask.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")
const scratch = @import("../core/scratch.mlx")
const render = @import("../core/render.mlx")
const raster = @import("../core/raster.mlx")
const fill = @import("../core/fill.mlx")
const gradient = @import("../core/gradient.mlx")
const patterns = @import("../generators/patterns.mlx")
const table = @import("../core/table.mlx")

pub const App = state.App
pub const Input = state.Input
pub const Rect = geom.Rect

// The tools' ids.
pub const FILL: u8 = 30
pub const GRADIENT: u8 = 31
pub const ENCLOSE: u8 = 32

// What the fill tool fills (FillOptions.target).
pub const TARGET_REGION: usize = 0
pub const TARGET_SIMILAR: usize = 1
pub const TARGET_SELECTION: usize = 2
const TARGETS: usize = 3

// What is filled with (Common.source).
pub const SOURCE_FOREGROUND: usize = 0
pub const SOURCE_BACKGROUND: usize = 1
pub const SOURCE_PATTERN: usize = 2
const SOURCES: usize = 3

// The enclosing shapes (EncloseOptions.shape).
pub const ENCLOSE_RECTANGLE: usize = 0
pub const ENCLOSE_ELLIPSE: usize = 1
pub const ENCLOSE_LASSO: usize = 2
const ENCLOSINGS: usize = 3

// The gradient shapes offered: core/gradient.mlx's LINEAR to
// REVERSE_SPIRAL (not SHAPED, which it does not do yet).
const SHAPES_OFFERED: usize = 8
const REPEATS_OFFERED: usize = 3

// A gradient's preview is rendered while the part of the image the
// canvas shows has at most this many pixels.
pub const PREVIEW_MOST: i64 = 1048576

// The most points a lasso keeps (when it has as many, every second one
// goes and new ones come at twice the distance).
const LASSO_POINTS: usize = 1024
// A lasso's next point is this many window pixels from the last at
// least (times the spacing's doubling).
const LASSO_STEP: f64 = 2.0

// A drag shorter than this many window pixels is a click: the gradient
// and the enclosing shape take nothing from it.
const LEAST_DRAG: i32 = 3

// The blend modes' list (a heading before each category: blend.mlx's
// 130 modes and 13 categories, with room to spare).
const BLEND_ROWS: usize = 160
const ROW_HEADING: u16 = 32768

// The text store's keys and the most bytes of a tool's text.
const KEY_FILL: []const u8 = "tool.fill"
const KEY_GRADIENT: []const u8 = "tool.gradient"
const KEY_ENCLOSE: []const u8 = "tool.enclosefill"
const TEXT_ROOM: usize = 400

// ---------------------------------------------------------------------------
// The options

// What the fill tool and enclose-and-fill have alike: what is filled
// with, how the region is found and how it is mixed in. Numbers are
// f64 and choices usize because the kit's sliders and lists take them
// so.
pub const Common = struct {
    // SOURCE_*, and the built-in pattern for SOURCE_PATTERN.
    source: usize
    pattern: usize
    // 0-255: how far from the reference a colour may be.
    threshold: f64
    // 0-100 %: the part of the threshold within which a pixel is taken
    // whole (100: a hard edge).
    spread: f64
    // Pixels the region is grown by (below 0: shrunk).
    grow: f64
    // Pixels its edge is softened over.
    feather: f64
    // The region is found in what all layers show, not in the layer.
    merged: bool
    // Pixels that touch at a corner hang together.
    corners: bool
    mode: u16
    // 0-100 %.
    opacity: f64
}

pub const FillOptions = struct {
    // TARGET_*.
    target: usize
    common: Common
}

pub const GradientOptions = struct {
    // A built-in gradient's index (core/gradient.mlx).
    gradient: usize
    // core/gradient.mlx's LINEAR ... REVERSE_SPIRAL and NONE, FORWARDS,
    // ALTERNATING.
    shape: usize
    repeat: usize
    reverse: bool
    dither: bool
    // 0-100 %: how much of the edges is smoothed (100: every pixel that
    // differs from a neighbour at all is made of 16 samples; 0: none).
    smoothing: f64
    mode: u16
    opacity: f64
}

pub const EncloseOptions = struct {
    // ENCLOSE_*.
    shape: usize
    // core/fill.mlx's ALL_REGIONS ... REGIONS_SURROUNDED_BY.
    method: usize
    // The colour REGIONS_OF_COLOR and REGIONS_SURROUNDED_BY go by
    // (straight).
    reference: u32
    common: Common
}

fn commonDefaults(common: *Common) -> void {
    common.*.source = SOURCE_FOREGROUND
    common.*.pattern = 0
    common.*.threshold = 20.0
    common.*.spread = 100.0
    common.*.grow = 0.0
    common.*.feather = 0.0
    common.*.merged = false
    common.*.corners = false
    common.*.mode = blend.NORMAL
    common.*.opacity = 100.0
}

// The sliders' ranges and how they show their numbers (made once in a
// tool's record: a SliderOptions made in a frame would be a temporary of
// its own each time).
const Sliders = struct {
    threshold: kit_module.SliderOptions
    spread: kit_module.SliderOptions
    grow: kit_module.SliderOptions
    feather: kit_module.SliderOptions
    opacity: kit_module.SliderOptions
    smoothing: kit_module.SliderOptions
}

fn prepareSliders(sliders: *Sliders) -> void {
    sliders.*.threshold = kit_module.sliderOptions(0.0, 255.0, 1.0, 0)
    sliders.*.spread = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    sliders.*.spread.suffix = " %"
    sliders.*.grow = kit_module.sliderOptions(@floatFromInt(f64, -fill.MOST_GROW), @floatFromInt(f64, fill.MOST_GROW), 1.0, 0)
    sliders.*.grow.suffix = " px"
    // The bar shows the sizes that are usual; up to the most typed.
    sliders.*.grow.softLow = -40.0
    sliders.*.grow.softHigh = 40.0
    sliders.*.feather = kit_module.sliderOptions(0.0, fill.MOST_FEATHER, 1.0, 0)
    sliders.*.feather.suffix = " px"
    sliders.*.feather.softLow = 0.0
    sliders.*.feather.softHigh = 100.0
    sliders.*.opacity = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    sliders.*.opacity.suffix = " %"
    sliders.*.smoothing = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    sliders.*.smoothing.suffix = " %"
}

// ---------------------------------------------------------------------------
// What each tool keeps (its slot)

const FillTool = struct {
    ready: bool
    options: FillOptions
    sliders: Sliders
}

const GradientTool = struct {
    ready: bool
    options: GradientOptions
    sliders: Sliders
    // A drag in progress: on which image (its number) and layer (its
    // id), from where to where (the image's coordinates), where it went
    // down in the window.
    dragging: bool
    image: u64
    node: u32
    x0: f64
    y0: f64
    x1: f64
    y1: f64
    pressX: i32
    pressY: i32
    // The part of the image the preview overlay holds (empty: none).
    previewX: i32
    previewY: i32
    previewWidth: i32
    previewHeight: i32
}

const EncloseTool = struct {
    ready: bool
    options: EncloseOptions
    sliders: Sliders
    dragging: bool
    image: u64
    node: u32
    x0: f64
    y0: f64
    x1: f64
    y1: f64
    pressX: i32
    pressY: i32
    // The lasso's points (x and y in turn) and the least distance
    // between two of them, in image pixels.
    count: usize
    spacing: f64
    points: [2048]f64
}

fn fillToolOf(app: *App) -> ?*FillTool {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, FILL), @sizeOf(FillTool))
    if memory == null { return null }
    const tool: *FillTool = unsafe { @ptrCast(*FillTool, memory.?) }
    if !tool.*.ready {
        tool.*.options.target = TARGET_REGION
        commonDefaults(&tool.*.options.common)
        prepareSliders(&tool.*.sliders)
        readFill(app, &tool.*.options)
        tool.*.ready = true
    }
    return tool
}

fn gradientToolOf(app: *App) -> ?*GradientTool {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, GRADIENT), @sizeOf(GradientTool))
    if memory == null { return null }
    const tool: *GradientTool = unsafe { @ptrCast(*GradientTool, memory.?) }
    if !tool.*.ready {
        const options = &tool.*.options
        options.*.gradient = gradient.FOREGROUND_TO_BACKGROUND
        options.*.shape = @intCast(usize, gradient.LINEAR)
        options.*.repeat = @intCast(usize, gradient.NONE)
        options.*.reverse = false
        options.*.dither = false
        options.*.smoothing = 80.0
        options.*.mode = blend.NORMAL
        options.*.opacity = 100.0
        prepareSliders(&tool.*.sliders)
        readGradient(app, options)
        tool.*.dragging = false
        tool.*.ready = true
    }
    return tool
}

fn encloseToolOf(app: *App) -> ?*EncloseTool {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, ENCLOSE), @sizeOf(EncloseTool))
    if memory == null { return null }
    const tool: *EncloseTool = unsafe { @ptrCast(*EncloseTool, memory.?) }
    if !tool.*.ready {
        const options = &tool.*.options
        options.*.shape = ENCLOSE_RECTANGLE
        options.*.method = @intCast(usize, fill.ALL_REGIONS)
        options.*.reference = pixel.BLACK
        commonDefaults(&options.*.common)
        prepareSliders(&tool.*.sliders)
        readEnclose(app, options)
        tool.*.dragging = false
        tool.*.count = 0
        tool.*.ready = true
    }
    return tool
}

// The fill tool's options as they are now, read from the settings at the
// first asking (null without memory). A change to them counts from the
// next click; it is kept between runs when the options panel makes it.
pub fn fillOptions(app: *App) -> ?*FillOptions {
    const tool = fillToolOf(app)
    if tool == null { return null }
    return &tool.?.*.options
}

// The gradient tool's options (as fillOptions).
pub fn gradientOptions(app: *App) -> ?*GradientOptions {
    const tool = gradientToolOf(app)
    if tool == null { return null }
    return &tool.?.*.options
}

// Enclose-and-fill's options (as fillOptions).
pub fn encloseOptions(app: *App) -> ?*EncloseOptions {
    const tool = encloseToolOf(app)
    if tool == null { return null }
    return &tool.?.*.options
}

// ---------------------------------------------------------------------------
// Kept between runs: "name=number;name=number" in the settings' texts

fn appendPair(into: [*]u8, at: usize, name: []const u8, value: i64) -> usize {
    var length = at
    if length > 0 { length = std.text.appendByte(into, length, TEXT_ROOM, 59) }
    length = std.text.append(into, length, TEXT_ROOM, name)
    length = std.text.appendByte(into, length, TEXT_ROOM, 61)
    return std.text.appendSigned(into, length, TEXT_ROOM, @intCast(isize, value))
}

// The number `name` has in `text` into `into`; false when it has none
// (or one that is no whole number of at most 12 digits).
fn valueIn(text: []const u8, name: []const u8, into: *i64) -> bool {
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 59 { end += 1 }
        const pair = text[at..end]
        if pair.length > name.length + 1 && pair[name.length] == 61 && std.text.same(pair[0..name.length], name) {
            const digits = pair[name.length + 1..]
            var index: usize = 0
            var negative = false
            if digits[0] == 45 {
                negative = true
                index = 1
            }
            if index >= digits.length || digits.length - index > 12 { return false }
            var value: i64 = 0
            while index < digits.length {
                const byte = digits[index]
                if byte < 48 || byte > 57 { return false }
                value = value * 10 + @intCast(i64, byte - 48)
                index += 1
            }
            into.* = if negative { -value } else { value }
            return true
        }
        at = end + 1
    }
    return false
}

// A number of the text held to low..high, or `fallback` when the text
// has none.
fn numberIn(text: []const u8, name: []const u8, low: i64, high: i64, fallback: f64) -> f64 {
    var value: i64 = 0
    if !valueIn(text, name, &value) { return fallback }
    if value < low { value = low }
    if value > high { value = high }
    return @floatFromInt(f64, value)
}

fn choiceIn(text: []const u8, name: []const u8, count: usize, fallback: usize) -> usize {
    var value: i64 = 0
    if !valueIn(text, name, &value) || value < 0 || value >= @intCast(i64, count) { return fallback }
    return @intCast(usize, value)
}

fn switchIn(text: []const u8, name: []const u8, fallback: bool) -> bool {
    var value: i64 = 0
    if !valueIn(text, name, &value) { return fallback }
    return value != 0
}

fn modeIn(text: []const u8, fallback: u16) -> u16 {
    var value: i64 = 0
    if !valueIn(text, "mode", &value) || value < 0 || value >= @intCast(i64, blend.listedCount()) { return fallback }
    return @intCast(u16, value)
}

fn whole(value: f64) -> i64 {
    return @intFromFloat(i64, math.round(held(value, -1000000.0, 1000000.0)))
}

fn bit(value: bool) -> i64 { return if value { 1 } else { 0 } }

fn writeCommon(common: *const Common, into: [*]u8, at: usize) -> usize {
    var length = appendPair(into, at, "source", @intCast(i64, chosen(common.*.source, SOURCES, SOURCE_FOREGROUND)))
    length = appendPair(into, length, "pattern", @intCast(i64, chosen(common.*.pattern, patterns.count(), 0)))
    length = appendPair(into, length, "threshold", whole(common.*.threshold))
    length = appendPair(into, length, "spread", whole(common.*.spread))
    length = appendPair(into, length, "grow", whole(common.*.grow))
    length = appendPair(into, length, "feather", whole(common.*.feather))
    length = appendPair(into, length, "merged", bit(common.*.merged))
    length = appendPair(into, length, "corners", bit(common.*.corners))
    length = appendPair(into, length, "mode", @intCast(i64, common.*.mode))
    return appendPair(into, length, "opacity", whole(common.*.opacity))
}

fn readCommon(text: []const u8, common: *Common) -> void {
    common.*.source = choiceIn(text, "source", SOURCES, common.*.source)
    common.*.pattern = choiceIn(text, "pattern", patterns.count(), common.*.pattern)
    common.*.threshold = numberIn(text, "threshold", 0, 255, common.*.threshold)
    common.*.spread = numberIn(text, "spread", 0, 100, common.*.spread)
    common.*.grow = numberIn(text, "grow", @intCast(i64, -fill.MOST_GROW), @intCast(i64, fill.MOST_GROW), common.*.grow)
    common.*.feather = numberIn(text, "feather", 0, whole(fill.MOST_FEATHER), common.*.feather)
    common.*.merged = switchIn(text, "merged", common.*.merged)
    common.*.corners = switchIn(text, "corners", common.*.corners)
    common.*.mode = modeIn(text, common.*.mode)
    common.*.opacity = numberIn(text, "opacity", 0, 100, common.*.opacity)
}

fn readFill(app: *App, options: *FillOptions) -> void {
    const text = settings.text(app, KEY_FILL)
    if text.length == 0 { return }
    options.*.target = choiceIn(text, "target", TARGETS, options.*.target)
    readCommon(text, &options.*.common)
}

fn readGradient(app: *App, options: *GradientOptions) -> void {
    const text = settings.text(app, KEY_GRADIENT)
    if text.length == 0 { return }
    options.*.gradient = choiceIn(text, "gradient", gradient.builtinCount(), options.*.gradient)
    options.*.shape = choiceIn(text, "shape", SHAPES_OFFERED, options.*.shape)
    options.*.repeat = choiceIn(text, "repeat", REPEATS_OFFERED, options.*.repeat)
    options.*.reverse = switchIn(text, "reverse", options.*.reverse)
    options.*.dither = switchIn(text, "dither", options.*.dither)
    options.*.smoothing = numberIn(text, "smoothing", 0, 100, options.*.smoothing)
    options.*.mode = modeIn(text, options.*.mode)
    options.*.opacity = numberIn(text, "opacity", 0, 100, options.*.opacity)
}

fn readEnclose(app: *App, options: *EncloseOptions) -> void {
    const text = settings.text(app, KEY_ENCLOSE)
    if text.length == 0 { return }
    options.*.shape = choiceIn(text, "shape", ENCLOSINGS, options.*.shape)
    options.*.method = choiceIn(text, "method", @intCast(usize, fill.METHODS), options.*.method)
    var value: i64 = 0
    if valueIn(text, "reference", &value) && value >= 0 && value <= 4294967295 { options.*.reference = @intCast(u32, value) }
    readCommon(text, &options.*.common)
}

// The tool's options into the settings' texts (written to the file at
// once: called when a change is complete, not while a slider moves).
fn keep(app: *App, id: u8) -> void {
    var text: [400]u8 = undefined
    const bytes: [*]u8 = &text
    var length: usize = 0
    if id == FILL {
        const tool = fillToolOf(app)
        if tool == null { return }
        length = appendPair(bytes, 0, "target", @intCast(i64, chosen(tool.?.*.options.target, TARGETS, TARGET_REGION)))
        length = writeCommon(&tool.?.*.options.common, bytes, length)
        _ = settings.setText(app, KEY_FILL, bytes[0..length])
    } else if id == GRADIENT {
        const tool = gradientToolOf(app)
        if tool == null { return }
        const options = &tool.?.*.options
        length = appendPair(bytes, 0, "gradient", @intCast(i64, chosen(options.*.gradient, gradient.builtinCount(), gradient.FOREGROUND_TO_BACKGROUND)))
        length = appendPair(bytes, length, "shape", @intCast(i64, shapeOf(options)))
        length = appendPair(bytes, length, "repeat", @intCast(i64, repeatOf(options)))
        length = appendPair(bytes, length, "reverse", bit(options.*.reverse))
        length = appendPair(bytes, length, "dither", bit(options.*.dither))
        length = appendPair(bytes, length, "smoothing", whole(options.*.smoothing))
        length = appendPair(bytes, length, "mode", @intCast(i64, options.*.mode))
        length = appendPair(bytes, length, "opacity", whole(options.*.opacity))
        _ = settings.setText(app, KEY_GRADIENT, bytes[0..length])
    } else if id == ENCLOSE {
        const tool = encloseToolOf(app)
        if tool == null { return }
        const options = &tool.?.*.options
        length = appendPair(bytes, 0, "shape", @intCast(i64, chosen(options.*.shape, ENCLOSINGS, ENCLOSE_RECTANGLE)))
        length = appendPair(bytes, length, "method", @intCast(i64, chosen(options.*.method, @intCast(usize, fill.METHODS), @intCast(usize, fill.ALL_REGIONS))))
        length = appendPair(bytes, length, "reference", @intCast(i64, options.*.reference))
        length = writeCommon(&options.*.common, bytes, length)
        _ = settings.setText(app, KEY_ENCLOSE, bytes[0..length])
    }
}

// ---------------------------------------------------------------------------
// Shared by the tools

fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }

// `value` within low..high; what is no number is `low` (an option set
// by a script may be anything, and a float out of range is no integer).
fn held(value: f64, low: f64, high: f64) -> f64 {
    return if !(value > low) { low } else if value > high { high } else { value }
}

// A percentage as an opacity of 0-255.
fn opacityOf(percent: f64) -> u32 {
    return @intFromFloat(u32, held(percent, 0.0, 100.0) * 2.55 + 0.5)
}

// An image coordinate as the pixel it lies in, held far inside an i32.
fn pixelOf(value: f64) -> i32 {
    if !(value > -1000000000.0) { return -1000000000 }
    if value > 1000000000.0 { return 1000000000 }
    return @intFromFloat(i32, @floor(value))
}

fn flagsOf(node: *node_module.Node) -> u32 {
    return if node.*.alphaLocked { blend.FLAG_ALPHA_LOCK } else { 0 }
}

// Whether a node's pixels are amounts, opaque greys (core/mask.mlx): a
// mask's, a filter layer's. What goes into one is the grey of a colour.
fn holdsAmounts(node: *node_module.Node) -> bool {
    return node_module.isMask(node.*.kind) || node.*.kind == node_module.FILTER
}

// A colour as it goes into `node` in blend mode `mode`: itself; in a node
// of amounts its grey at its own alpha, black when erasing (an amount is
// hidden, not made transparent: see modeFor).
fn colorFor(node: *node_module.Node, color: u32, mode: u16) -> u32 {
    if !holdsAmounts(node) { return color }
    const grey = if mode == blend.ERASE { 0 } else { pixel.luma(color) }
    return pixel.withAlpha(pixel.gray(grey), color >> 24)
}

// The blend mode a fill goes into `node` with: Normal for erasing in a
// node of amounts (which paints black there, colorFor).
fn modeFor(node: *node_module.Node, mode: u16) -> u16 {
    return if holdsAmounts(node) && mode == blend.ERASE { blend.NORMAL } else { mode }
}

// The active layer when it can be filled now: api.paintable's, and not
// showing something unfinished of another part (an overlay, a preview
// standing in for it, a change of its pixels open, which a step of ours
// would take in). Null otherwise; the status bar says why.
fn fillable(app: *App) -> ?*node_module.Node {
    const node = api.paintable(app)
    if node == null { return null }
    if node.?.*.overlay != null || node.?.*.substitute != null || device_module.isRecording(node.?.*.device.?) {
        api.say(app, state.tr(app, "The layer shows something unfinished", "Die Ebene zeigt etwas Unfertiges"), true)
        return null
    }
    return node
}

// The selection a change keeps to: the image's when there is one.
fn selectionOf(image: *image_module.Image) -> ?*device_module.Device {
    var found: ?*device_module.Device = null
    if image.*.selected { found = image.*.selection }
    return found
}

// The part of `area` the selection can let anything through. (A
// function of its own: a Rect variable changed afterwards, or an if
// choosing between two, would be a temporary of the value arena.)
fn selectedPart(image: *image_module.Image, area: Rect) -> Rect {
    if mask_module.reachesEverywhere(image.*.selection) { return area }
    return geom.intersect(area, mask_module.bounds(image.*.selection))
}

// A choice held to the `count` there are: `fallback` past them (an option
// set from outside may be anything; the numbers are u8 where they go).
fn chosen(value: usize, count: usize, fallback: usize) -> usize {
    return if value < count { value } else { fallback }
}

// The modifiers held now, as the window says. (Not an input's modifiers:
// app/loop.mlx takes those from the last key's event, and that of Shift
// let go still carries Shift, until another key comes.)
fn keysHeld(app: *App) -> u32 {
    return shell_module.modifiers(app.*.shell)
}

// The open image numbered `number` (null: it was closed).
fn imageNumbered(app: *App, number: u64) -> ?*image_module.Image {
    var found: ?*image_module.Image = null
    var index: usize = 0
    while index < app.*.count && index < state.DOCUMENTS {
        const doc = app.*.documents[index]
        if doc != null && doc.?.*.image.*.number == number {
            found = doc.?.*.image
            return found
        }
        index += 1
    }
    return found
}

// The layer a drag goes on: layer `id` of image `number` while that image
// is the one in front and the layer is in it; null when not (another
// image came in front, the layer went: the drag is over then).
fn dragNode(app: *App, number: u64, id: u32) -> ?*node_module.Node {
    const image = api.image(app)
    if image == null || image.?.*.number != number { return null }
    return node_module.find(image.?.*.root, id)
}

// How a region is looked for, by the options.
fn searchOf(common: *const Common) -> fill.Options {
    var options = fill.defaults()
    options.threshold = @intFromFloat(u32, held(common.*.threshold, 0.0, 255.0) + 0.5)
    options.softness = @intFromFloat(u32, held(common.*.spread, 0.0, 100.0) + 0.5)
    options.diagonal = common.*.corners
    const most = @floatFromInt(f64, fill.MOST_GROW)
    options.grow = @intFromFloat(i32, math.round(held(common.*.grow, -most, most)))
    options.feather = held(common.*.feather, 0.0, fill.MOST_FEATHER)
    return options
}

// What a region is found in: the layer, or what the image shows, brought
// up to date first.
fn sampleOf(image: *image_module.Image, node: *node_module.Node, merged: bool) -> *device_module.Device {
    if merged {
        _ = render.update(image)
        return image.*.projection
    }
    return node.*.device.?
}

// Mixes what the options fill with into the layer within `bounds`, as
// much as `region_mask` says there (times `selection`'s). False when
// there was no memory for the pattern (nothing was written then).
fn paintRegion(app: *App, node: *node_module.Node, region_mask: *device_module.Device, bounds: Rect, selection: ?*device_module.Device, common: *const Common) -> bool {
    const target = node.*.device.?
    const strength = opacityOf(common.*.opacity)
    const mode = modeFor(node, common.*.mode)
    if common.*.source != SOURCE_PATTERN {
        const color = if common.*.source == SOURCE_BACKGROUND { app.*.background } else { app.*.foreground }
        _ = fill.paint(target, region_mask, bounds, colorFor(node, color, common.*.mode), mode, strength, flagsOf(node), selection)
        return true
    }
    var width: usize = 0
    var height: usize = 0
    const tile = patterns.pattern(chosen(common.*.pattern, patterns.count(), 0), &width, &height)
    if tile == null { return false }
    if !holdsAmounts(node) {
        _ = fill.paintPattern(target, region_mask, bounds, tile.?, @intCast(i32, width), @intCast(i32, height), 0, 0, mode, strength, flagsOf(node), selection)
        return true
    }
    // Into amounts: the pattern's greys (a copy for the call).
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const greys = scratch.words(pool, width * height)
    if greys != null {
        var index: usize = 0
        while index < width * height {
            greys.?[index] = colorFor(node, tile.?[index], common.*.mode)
            index += 1
        }
        _ = fill.paintPattern(target, region_mask, bounds, greys.?, @intCast(i32, width), @intCast(i32, height), 0, 0, mode, strength, flagsOf(node), selection)
    }
    scratch.release(pool, mark)
    return greys != null
}

// Fills the layer where `region_mask` says within `bounds` as one step
// `name` of the history, and shows it (nothing without memory for it).
fn commitRegion(app: *App, image: *image_module.Image, node: *node_module.Node, region_mask: *device_module.Device, bounds: Rect, selection: ?*device_module.Device, common: *const Common, name: []const u8) -> void {
    if !ops.beginPixels(image, node) { return }
    if !paintRegion(app, node, region_mask, bounds, selection, common) {
        api.imageChanged(app, ops.cancelPixels(image, node))
        noMemory(app)
        return
    }
    api.imageChanged(app, ops.endPixels(image, node, name))
}

fn noMemory(app: *App) -> void {
    api.say(app, state.tr(app, "There is not enough memory for that", "Dafür reicht der Speicher nicht"), true)
}

// Whether image `number` is the one in front (a drag's marks show only
// over the image it is on).
fn inFront(app: *App, number: u64) -> bool {
    const image = api.image(app)
    return image != null && image.?.*.number == number
}

// Whether the pointer went farther than a click's wobble from where it
// went down.
fn dragged(press_x: i32, press_y: i32, input: *const Input) -> bool {
    const dx = input.*.windowX - press_x
    const dy = input.*.windowY - press_y
    return dx >= LEAST_DRAG || dx <= -LEAST_DRAG || dy >= LEAST_DRAG || dy <= -LEAST_DRAG
}

// ---------------------------------------------------------------------------
// Fill

fn fillPress(app: *App, input: *const Input) -> void {
    if input.*.button != ui_app.BUTTON_LEFT { return }
    const tool = fillToolOf(app)
    const image = api.image(app)
    if tool == null || image == null { return }
    const node = fillable(app)
    if node == null { return }
    const options = &tool.?.*.options
    const common = &options.*.common
    const area = image_module.bounds(image.?)
    const name = state.tr(app, "Fill", "Füllen")
    const target = chosen(options.*.target, TARGETS, TARGET_REGION)
    if target == TARGET_SELECTION {
        // The selection is the region (the whole image without one).
        if image.?.*.selected {
            const bounds = selectedPart(image.?, area)
            if !geom.isEmpty(bounds) { commitRegion(app, image.?, node.?, image.?.*.selection, bounds, null, common, name) }
            return
        }
        const everything = mask_module.create(app.*.allocator, true)
        if everything == null {
            noMemory(app)
            return
        }
        commitRegion(app, image.?, node.?, everything.?, area, null, common, name)
        device_module.destroy(everything.?)
        return
    }
    const x = pixelOf(input.*.x)
    const y = pixelOf(input.*.y)
    if !geom.contains(area, x, y) { return }
    const found = mask_module.create(app.*.allocator, false)
    if found == null {
        noMemory(app)
        return
    }
    var search = searchOf(common)
    search.contiguous = target == TARGET_REGION
    const bounds = fill.region(sampleOf(image.?, node.?, common.*.merged), x, y, area, &search, found.?)
    if !geom.isEmpty(bounds) { commitRegion(app, image.?, node.?, found.?, bounds, selectionOf(image.?), common, name) }
    device_module.destroy(found.?)
}

// ---------------------------------------------------------------------------
// Gradient

// The shape and the repeat chosen (linear and none for a number that is
// none of those offered).
fn shapeOf(options: *const GradientOptions) -> u8 {
    return @intCast(u8, chosen(options.*.shape, SHAPES_OFFERED, @intCast(usize, gradient.LINEAR)))
}

fn repeatOf(options: *const GradientOptions) -> u8 {
    return @intCast(u8, chosen(options.*.repeat, REPEATS_OFFERED, @intCast(usize, gradient.NONE)))
}

// The gradient chosen (black to white for a number that is none).
fn chosenGradient(options: *const GradientOptions, into: *gradient.Gradient) -> void {
    if !gradient.builtin(options.*.gradient, into) { gradient.init(into, pixel.BLACK, pixel.WHITE) }
}

// The gradient chosen as it goes into `node`: into amounts each stop the
// grey of what it stands for with the colours as they are now (colorFor).
fn gradientOf(app: *App, options: *const GradientOptions, node: *node_module.Node, into: *gradient.Gradient) -> void {
    chosenGradient(options, into)
    if !holdsAmounts(node) { return }
    var index: usize = 0
    while index < into.*.count && index < gradient.MAX_STOPS {
        const color = gradient.resolved(&into.*.stops[index], app.*.foreground, app.*.background)
        gradient.setColor(into, index, colorFor(node, color, options.*.mode))
        index += 1
    }
}

// The drag's end at the pointer: with Shift held its angle goes in steps
// of 15 degrees, its length kept.
fn gradientEnd(app: *App, tool: *GradientTool, input: *const Input) -> void {
    tool.*.x1 = input.*.x
    tool.*.y1 = input.*.y
    if keysHeld(app) & keys.SHIFT == 0 { return }
    const dx = input.*.x - tool.*.x0
    const dy = input.*.y - tool.*.y0
    const length = @sqrt(dx * dx + dy * dy)
    if !(length > 0.0) { return }
    const step = math.pi / 12.0
    const angle = math.round(math.atan2(dy, dx) / step) * step
    tool.*.x1 = tool.*.x0 + length * math.cos(angle)
    tool.*.y1 = tool.*.y0 + length * math.sin(angle)
}

fn previewArea(tool: *GradientTool) -> Rect {
    return geom.rect(tool.*.previewX, tool.*.previewY, tool.*.previewWidth, tool.*.previewHeight)
}

fn setPreviewArea(tool: *GradientTool, area: Rect) -> void {
    tool.*.previewX = area.x
    tool.*.previewY = area.y
    tool.*.previewWidth = area.width
    tool.*.previewHeight = area.height
}

// The preview goes from `node` of `image` (which need not be the image
// in front): the layer shows its own pixels again.
fn dropPreview(app: *App, tool: *GradientTool, image: *image_module.Image, node: *node_module.Node) -> void {
    if node.*.overlay != null {
        // (It damages the image where the overlay was.)
        _ = ops.dropOverlay(image, node)
        api.canvasChanged(app)
    }
    setPreviewArea(tool, geom.empty())
}

// The drag ends without a trace: no more busy, the preview gone from the
// layer it was on, wherever that is now (an image behind another; with
// the layer gone from its image there is nothing to take it from).
fn endGradient(app: *App, tool: *GradientTool) -> void {
    tool.*.dragging = false
    const image = imageNumbered(app, tool.*.image)
    if image != null {
        const node = node_module.find(image.?.*.root, tool.*.node)
        if node != null { dropPreview(app, tool, image.?, node.?) }
    }
    setPreviewArea(tool, geom.empty())
    api.canvasChanged(app)
}

// The part of the image the preview covers now: what the canvas shows of
// it, where the selection can let anything through.
fn previewPart(app: *App, image: *image_module.Image) -> Rect {
    const doc = api.document(app)
    if doc == null { return geom.empty() }
    const shown = geom.intersect(viewport.imageRectOf(&doc.?.*.view, app.*.canvasArea), image_module.bounds(image))
    if !image.*.selected { return shown }
    return selectedPart(image, shown)
}

// Renders the gradient as it would be laid now into the layer's overlay,
// over the part of the image the canvas shows (none when that is more
// than PREVIEW_MOST pixels: then the line alone shows the drag).
fn preview(app: *App, tool: *GradientTool, node: *node_module.Node) -> void {
    const image = api.image(app)
    if image == null { return }
    const part = previewPart(app, image.?)
    if geom.isEmpty(part) || @intCast(i64, part.width) * @intCast(i64, part.height) > PREVIEW_MOST {
        dropPreview(app, tool, image.?, node)
        return
    }
    const before = previewArea(tool)
    if node.*.overlay == null {
        const made = device_module.create(app.*.allocator, 0)
        if made == null { return }
        node.*.overlay = made
    } else if !geom.same(before, part) {
        device_module.clear(node.*.overlay.?)
    }
    const options = &tool.*.options
    node.*.overlayOpacity = @intCast(u8, opacityOf(options.*.opacity))
    node.*.overlayBlend = modeFor(node, options.*.mode)
    node.*.overlayMasked = true
    setPreviewArea(tool, part)
    var colors: gradient.Gradient = undefined
    gradientOf(app, options, node, &colors)
    const target = node.*.overlay.?
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const memory = scratch.bytes(pool, gradient.FINE_ENTRIES * 8)
    if memory != null {
        const fine: [*]u64 = unsafe { @ptrCast([*]u64, memory.?) }
        gradient.bakeFine(&colors, fine, app.*.foreground, app.*.background)
        const shape = shapeOf(options)
        const repeat = repeatOf(options)
        // Tile by tile of the overlay, written where it lies.
        const left = part.x - target.*.x
        const top = part.y - target.*.y
        const right = left + part.width
        const bottom = top + part.height
        // (Without memory for a tile the rest is left out.)
        var complete = true
        var ty = top >> 6
        while ty <= (bottom - 1) >> 6 && complete {
            const row0 = larger(top, ty * 64)
            const row1 = smaller(bottom, ty * 64 + 64)
            var tx = left >> 6
            while tx <= (right - 1) >> 6 {
                const col0 = larger(left, tx * 64)
                const col1 = smaller(right, tx * 64 + 64)
                const words = device_module.tileWrite(target, tx, ty)
                if words == null {
                    complete = false
                    break
                }
                const piece = geom.rect(col0 + target.*.x, row0 + target.*.y, col1 - col0, row1 - row0)
                gradient.renderBaked(fine, shape, repeat, options.*.reverse, options.*.dither, tool.*.x0, tool.*.y0, tool.*.x1, tool.*.y1, piece, words.? + @intCast(usize, ((row0 & 63) << 6) | (col0 & 63)), 64, 1.0)
                tx += 1
            }
            ty += 1
        }
    }
    scratch.release(pool, mark)
    api.imageChanged(app, geom.unite(before, part))
}

fn gradientPress(app: *App, input: *const Input) -> void {
    if input.*.button != ui_app.BUTTON_LEFT { return }
    const tool = gradientToolOf(app)
    if tool == null || tool.?.*.dragging { return }
    const node = fillable(app)
    if node == null { return }
    tool.?.*.dragging = true
    tool.?.*.image = api.image(app).?.*.number
    tool.?.*.node = node.?.*.id
    tool.?.*.x0 = input.*.x
    tool.?.*.y0 = input.*.y
    tool.?.*.x1 = input.*.x
    tool.?.*.y1 = input.*.y
    tool.?.*.pressX = input.*.windowX
    tool.?.*.pressY = input.*.windowY
    setPreviewArea(tool.?, geom.empty())
    api.canvasChanged(app)
}

fn gradientMove(app: *App, input: *const Input) -> void {
    const tool = gradientToolOf(app)
    if tool == null || !tool.?.*.dragging { return }
    const node = dragNode(app, tool.?.*.image, tool.?.*.node)
    if node == null {
        endGradient(app, tool.?)
        return
    }
    gradientEnd(app, tool.?, input)
    if dragged(tool.?.*.pressX, tool.?.*.pressY, input) { preview(app, tool.?, node.?) }
    api.canvasChanged(app)
}

fn gradientRelease(app: *App, input: *const Input) -> void {
    const tool = gradientToolOf(app)
    if tool == null || !tool.?.*.dragging { return }
    const node = dragNode(app, tool.?.*.image, tool.?.*.node)
    if node == null {
        endGradient(app, tool.?)
        return
    }
    tool.?.*.dragging = false
    gradientEnd(app, tool.?, input)
    const image = api.image(app).?
    dropPreview(app, tool.?, image, node.?)
    if !dragged(tool.?.*.pressX, tool.?.*.pressY, input) || node.?.*.device == null {
        api.canvasChanged(app)
        return
    }
    const options = &tool.?.*.options
    var colors: gradient.Gradient = undefined
    gradientOf(app, options, node.?, &colors)
    if !ops.beginPixels(image, node.?) { return }
    const smoothing = held(options.*.smoothing, 0.0, 100.0)
    const done = gradient.fillDevice(node.?.*.device.?, selectionOf(image), image_module.bounds(image), &colors, shapeOf(options), repeatOf(options), options.*.reverse, options.*.dither, tool.?.*.x0, tool.?.*.y0, tool.?.*.x1, tool.?.*.y1, app.*.foreground, app.*.background, 1.0 - smoothing / 100.0, modeFor(node.?, options.*.mode), opacityOf(options.*.opacity), flagsOf(node.?))
    if !done {
        // Not half a gradient: the layer is put back as it was.
        api.imageChanged(app, ops.cancelPixels(image, node.?))
        noMemory(app)
        return
    }
    api.imageChanged(app, ops.endPixels(image, node.?, state.tr(app, "Gradient", "Farbverlauf")))
}

fn gradientCancel(app: *App) -> void {
    const tool = gradientToolOf(app)
    if tool == null || !tool.?.*.dragging { return }
    endGradient(app, tool.?)
}

fn gradientBusy(app: *App) -> bool {
    const tool = gradientToolOf(app)
    return tool != null && tool.?.*.dragging
}

// The drag: a line from the start to the end, a round marker at the
// start, a square one at the end, and the angle beside the end.
fn gradientOverlay(app: *App, canvas: *state.Canvas) -> void {
    const tool = gradientToolOf(app)
    if tool == null || !tool.?.*.dragging || !inFront(app, tool.?.*.image) { return }
    const marks = overlay.begin(app, canvas)
    const t = tool.?
    overlay.line(&marks, t.*.x0, t.*.y0, t.*.x1, t.*.y1)
    overlay.handle(&marks, t.*.x0, t.*.y0, overlay.ROUND, false)
    overlay.handle(&marks, t.*.x1, t.*.y1, overlay.SQUARE, true)
    const dx = t.*.x1 - t.*.x0
    const dy = t.*.y1 - t.*.y0
    if dx * dx + dy * dy > 0.0 {
        // Counted counter-clockwise from the right, as people read
        // angles, from -180 to 180 (a drag a little below level is -2°).
        const degrees = math.round(math.atan2(-dy, dx) * 180.0 / math.pi)
        var text: [16]u8 = undefined
        const bytes: [*]u8 = &text
        var length = std.text.appendSigned(bytes, 0, 16, @intFromFloat(isize, held(degrees, -180.0, 180.0)))
        length = std.text.append(bytes, length, 16, "\xC2\xB0")
        overlay.label(&marks, t.*.x1, t.*.y1, bytes[0..length])
    }
}

// ---------------------------------------------------------------------------
// Enclose and Fill

// The rectangle's (the ellipse's box's) far corner at the pointer: with
// Shift held, a square's.
fn encloseEnd(app: *App, tool: *EncloseTool, input: *const Input) -> void {
    tool.*.x1 = input.*.x
    tool.*.y1 = input.*.y
    if keysHeld(app) & keys.SHIFT == 0 || tool.*.options.shape == ENCLOSE_LASSO { return }
    const dx = input.*.x - tool.*.x0
    const dy = input.*.y - tool.*.y0
    const ax = if dx < 0.0 { -dx } else { dx }
    const ay = if dy < 0.0 { -dy } else { dy }
    const side = if ax > ay { ax } else { ay }
    tool.*.x1 = tool.*.x0 + (if dx < 0.0 { -side } else { side })
    tool.*.y1 = tool.*.y0 + (if dy < 0.0 { -side } else { side })
}

// The lasso goes on to (x, y) when that is far enough from its last
// point; a full lasso keeps every second point and spaces the next ones
// twice as far.
fn addPoint(tool: *EncloseTool, x: f64, y: f64) -> void {
    if tool.*.count > 0 {
        const last = (tool.*.count - 1) * 2
        const dx = x - tool.*.points[last]
        const dy = y - tool.*.points[last + 1]
        if dx * dx + dy * dy < tool.*.spacing * tool.*.spacing { return }
    }
    if tool.*.count >= LASSO_POINTS {
        var from: usize = 0
        var into: usize = 0
        while from < tool.*.count {
            tool.*.points[into * 2] = tool.*.points[from * 2]
            tool.*.points[into * 2 + 1] = tool.*.points[from * 2 + 1]
            into += 1
            from += 2
        }
        tool.*.count = into
        tool.*.spacing *= 2.0
    }
    tool.*.points[tool.*.count * 2] = x
    tool.*.points[tool.*.count * 2 + 1] = y
    tool.*.count += 1
}

fn enclosePress(app: *App, input: *const Input) -> void {
    if input.*.button != ui_app.BUTTON_LEFT { return }
    const tool = encloseToolOf(app)
    if tool == null || tool.?.*.dragging { return }
    const node = fillable(app)
    const doc = api.document(app)
    if node == null || doc == null { return }
    const t = tool.?
    t.*.dragging = true
    t.*.image = api.image(app).?.*.number
    t.*.node = node.?.*.id
    t.*.x0 = input.*.x
    t.*.y0 = input.*.y
    t.*.x1 = input.*.x
    t.*.y1 = input.*.y
    t.*.pressX = input.*.windowX
    t.*.pressY = input.*.windowY
    t.*.count = 0
    // A lasso's points lie a couple of window pixels apart at any zoom.
    const zoom = doc.?.*.view.zoom
    t.*.spacing = if zoom > 0.0 { LASSO_STEP / zoom } else { LASSO_STEP }
    addPoint(t, input.*.x, input.*.y)
    api.canvasChanged(app)
}

fn encloseMove(app: *App, input: *const Input) -> void {
    const tool = encloseToolOf(app)
    if tool == null || !tool.?.*.dragging { return }
    if dragNode(app, tool.?.*.image, tool.?.*.node) == null {
        encloseCancel(app)
        return
    }
    encloseEnd(app, tool.?, input)
    if tool.?.*.options.shape == ENCLOSE_LASSO { addPoint(tool.?, input.*.x, input.*.y) }
    api.canvasChanged(app)
}

// The shape drawn, as a path (null without memory).
fn enclosingPath(app: *App, tool: *EncloseTool) -> ?*raster.Path {
    const made = raster.create(app.*.allocator)
    if made == null { return null }
    const path = made.?
    const left = if tool.*.x0 < tool.*.x1 { tool.*.x0 } else { tool.*.x1 }
    const top = if tool.*.y0 < tool.*.y1 { tool.*.y0 } else { tool.*.y1 }
    const width = if tool.*.x0 < tool.*.x1 { tool.*.x1 - tool.*.x0 } else { tool.*.x0 - tool.*.x1 }
    const height = if tool.*.y0 < tool.*.y1 { tool.*.y1 - tool.*.y0 } else { tool.*.y0 - tool.*.y1 }
    if tool.*.options.shape == ENCLOSE_ELLIPSE {
        raster.ellipse(path, left + width / 2.0, top + height / 2.0, width / 2.0, height / 2.0)
    } else if tool.*.options.shape == ENCLOSE_LASSO {
        raster.moveTo(path, tool.*.points[0], tool.*.points[1])
        var index: usize = 1
        while index < tool.*.count {
            raster.lineTo(path, tool.*.points[index * 2], tool.*.points[index * 2 + 1])
            index += 1
        }
        raster.close(path)
    } else {
        raster.rect(path, left, top, width, height)
    }
    if raster.failed(path) {
        raster.destroy(path)
        return null
    }
    return path
}

// Fills the regions inside the shape drawn: one step.
fn encloseFill(app: *App, tool: *EncloseTool, image: *image_module.Image, node: *node_module.Node) -> void {
    const area = image_module.bounds(image)
    const path = enclosingPath(app, tool)
    const shape = mask_module.create(app.*.allocator, false)
    const found = mask_module.create(app.*.allocator, false)
    if path != null && shape != null && found != null {
        _ = raster.fillMask(shape.?, path.?, raster.NONZERO, false, area, 255, raster.ADD)
        const common = &tool.*.options.common
        var search = searchOf(common)
        search.boundary = tool.*.options.reference
        const method = chosen(tool.*.options.method, @intCast(usize, fill.METHODS), @intCast(usize, fill.ALL_REGIONS))
        const bounds = fill.enclosed(sampleOf(image, node, common.*.merged), shape.?, area, &search, found.?, @intCast(u8, method))
        if geom.isEmpty(bounds) {
            api.say(app, state.tr(app, "No region lies wholly inside the shape", "Kein Bereich liegt ganz in der Form"), false)
        } else {
            commitRegion(app, image, node, found.?, bounds, selectionOf(image), common, state.tr(app, "Enclose and Fill", "Umschließen und füllen"))
        }
    } else {
        noMemory(app)
    }
    if path != null { raster.destroy(path.?) }
    if shape != null { device_module.destroy(shape.?) }
    if found != null { device_module.destroy(found.?) }
}

fn encloseRelease(app: *App, input: *const Input) -> void {
    const tool = encloseToolOf(app)
    if tool == null || !tool.?.*.dragging { return }
    const t = tool.?
    t.*.dragging = false
    api.canvasChanged(app)
    const node = dragNode(app, t.*.image, t.*.node)
    if node == null || node.?.*.device == null { return }
    encloseEnd(app, t, input)
    if t.*.options.shape == ENCLOSE_LASSO { addPoint(t, input.*.x, input.*.y) }
    // A lasso is a shape once it has three points; the other two once
    // they were dragged.
    if t.*.options.shape == ENCLOSE_LASSO {
        if t.*.count < 3 { return }
    } else if !dragged(t.*.pressX, t.*.pressY, input) {
        return
    }
    encloseFill(app, t, api.image(app).?, node.?)
}

fn encloseCancel(app: *App) -> void {
    const tool = encloseToolOf(app)
    if tool == null || !tool.?.*.dragging { return }
    tool.?.*.dragging = false
    api.canvasChanged(app)
}

fn encloseBusy(app: *App) -> bool {
    const tool = encloseToolOf(app)
    return tool != null && tool.?.*.dragging
}

// The shape being drawn: the rectangle dashed, the ellipse, the lasso
// with a dashed line from its last point back to its first.
fn encloseOverlay(app: *App, canvas: *state.Canvas) -> void {
    const tool = encloseToolOf(app)
    if tool == null || !tool.?.*.dragging || !inFront(app, tool.?.*.image) { return }
    const t = tool.?
    const marks = overlay.begin(app, canvas)
    if t.*.options.shape == ENCLOSE_LASSO {
        if t.*.count >= 2 {
            overlay.polyline(&marks, &t.*.points, t.*.count, false)
            const last = (t.*.count - 1) * 2
            overlay.dashedLine(&marks, t.*.points[last], t.*.points[last + 1], t.*.points[0], t.*.points[1])
        }
        return
    }
    const left = if t.*.x0 < t.*.x1 { t.*.x0 } else { t.*.x1 }
    const top = if t.*.y0 < t.*.y1 { t.*.y0 } else { t.*.y1 }
    const width = if t.*.x0 < t.*.x1 { t.*.x1 - t.*.x0 } else { t.*.x0 - t.*.x1 }
    const height = if t.*.y0 < t.*.y1 { t.*.y1 - t.*.y0 } else { t.*.y0 - t.*.y1 }
    if t.*.options.shape == ENCLOSE_ELLIPSE {
        overlay.ellipse(&marks, left + width / 2.0, top + height / 2.0, width / 2.0, height / 2.0)
    } else {
        overlay.dashedRect(&marks, left, top, width, height)
    }
}

// ---------------------------------------------------------------------------
// The options panels

// A row's height and the room between rows, the height of the line
// between groups of rows, of a label's own row (in a narrow panel; the
// label in its lower part) and of the row of the gradient's picture
// under its list, the picture itself, and the width under which a panel
// is narrow (times the theme's scale).
const ROW: i32 = kit_module.ROW
const GAP: i32 = 2
const GROUP_GAP: i32 = 9
const LABEL: i32 = 20
const LABEL_ROOM: i32 = 4
const STRIP_ROW: i32 = 12
const STRIP: i32 = 8
const NARROW: i32 = 220

// The blend modes in the menu's order, a heading before each category
// (made at the first asking; the same for every tool).
var blendRows: [160]u16 = undefined
var blendRowCount: usize = 0

fn prepareBlendRows() -> void {
    if blendRowCount > 0 { return }
    var count: usize = 0
    var category: u8 = 255
    var index: usize = 0
    while index < blend.listedCount() && count + 2 <= BLEND_ROWS {
        const mode = blend.listed(index)
        const of = blend.category(mode)
        if of != category {
            blendRows[count] = ROW_HEADING | @intCast(u16, of)
            count += 1
            category = of
        }
        blendRows[count] = mode
        count += 1
        index += 1
    }
    blendRowCount = count
}

fn appOf(context: usize) -> *App { return unsafe { @ptrFromInt(*App, context) } }

fn blendName(context: usize, index: usize) -> []const u8 {
    const german = appOf(context).*.german
    if index >= blendRowCount { return "" }
    const row = blendRows[index]
    if row & ROW_HEADING != 0 { return blend.categoryTitle(@intCast(u8, row & 255), german) }
    return blend.title(row, german)
}

fn blendKind(context: usize, index: usize) -> u8 {
    if index < blendRowCount && blendRows[index] & ROW_HEADING != 0 { return kit_module.LIST_HEADING }
    return kit_module.LIST_ITEM
}

fn rowOfMode(mode: u16) -> usize {
    var index: usize = 0
    while index < blendRowCount {
        if blendRows[index] == mode { return index }
        index += 1
    }
    return 0
}

fn targetName(context: usize, index: usize) -> []const u8 {
    const app = appOf(context)
    if index == TARGET_SIMILAR { return state.tr(app, "Similar colours", "Ähnliche Farben") }
    if index == TARGET_SELECTION { return state.tr(app, "The selection", "Die Auswahl") }
    // (Short enough for the docker's usual width in German too.)
    return state.tr(app, "Contiguous region", "Zusammenhängend")
}

fn sourceName(context: usize, index: usize) -> []const u8 {
    const app = appOf(context)
    if index == SOURCE_BACKGROUND { return state.tr(app, "Background colour", "Hintergrundfarbe") }
    if index == SOURCE_PATTERN { return state.tr(app, "Pattern", "Muster") }
    return state.tr(app, "Foreground colour", "Vordergrundfarbe")
}

fn patternName(context: usize, index: usize) -> []const u8 {
    return patterns.name(index, appOf(context).*.german)
}

fn gradientName(context: usize, index: usize) -> []const u8 {
    return gradient.builtinName(index, appOf(context).*.german)
}

fn shapeName(context: usize, index: usize) -> []const u8 {
    const app = appOf(context)
    const shape = @intCast(u8, index & 255)
    if shape == gradient.BILINEAR { return state.tr(app, "Bilinear", "Bilinear") }
    if shape == gradient.RADIAL { return state.tr(app, "Radial", "Radial") }
    if shape == gradient.SQUARE { return state.tr(app, "Square", "Quadratisch") }
    if shape == gradient.CONICAL { return state.tr(app, "Conical", "Konisch") }
    if shape == gradient.CONICAL_SYMMETRIC { return state.tr(app, "Conical symmetric", "Konisch symmetrisch") }
    if shape == gradient.SPIRAL { return state.tr(app, "Spiral", "Spirale") }
    if shape == gradient.REVERSE_SPIRAL { return state.tr(app, "Reverse spiral", "Umgekehrte Spirale") }
    return state.tr(app, "Linear", "Linear")
}

fn repeatName(context: usize, index: usize) -> []const u8 {
    const app = appOf(context)
    if index == @intCast(usize, gradient.FORWARDS) { return state.tr(app, "Forwards", "Vorwärts") }
    if index == @intCast(usize, gradient.ALTERNATING) { return state.tr(app, "Alternating", "Abwechselnd") }
    return state.tr(app, "None", "Keine")
}

fn enclosingName(context: usize, index: usize) -> []const u8 {
    const app = appOf(context)
    if index == ENCLOSE_ELLIPSE { return state.tr(app, "Ellipse", "Ellipse") }
    if index == ENCLOSE_LASSO { return state.tr(app, "Lasso", "Lasso") }
    return state.tr(app, "Rectangle", "Rechteck")
}

fn methodName(context: usize, index: usize) -> []const u8 {
    return fill.methodTitle(@intCast(u8, index & 255), appOf(context).*.german)
}

// The ids of a tool's widgets: idOf(base, ITEM_*).
const ITEM_TARGET: usize = 0
const ITEM_SOURCE: usize = 1
const ITEM_PATTERN: usize = 2
const ITEM_THRESHOLD: usize = 3
const ITEM_SPREAD: usize = 4
const ITEM_GROW: usize = 5
const ITEM_FEATHER: usize = 6
const ITEM_MERGED: usize = 7
const ITEM_CORNERS: usize = 8
const ITEM_BLEND: usize = 9
const ITEM_OPACITY: usize = 10
const ITEM_GRADIENT: usize = 11
const ITEM_SHAPE: usize = 12
const ITEM_REPEAT: usize = 13
const ITEM_REVERSE: usize = 14
const ITEM_DITHER: usize = 15
const ITEM_SMOOTHING: usize = 16
const ITEM_ENCLOSING: usize = 17
const ITEM_METHOD: usize = 18
const ITEM_REFERENCE: usize = 19
const ITEM_TAKE: usize = 20

fn idOf(tool: u8, item: usize) -> u64 {
    return view.idOf(view.idOf(view.id("nebula.tools.fills"), @intCast(usize, tool)), item)
}

// Where a panel's rows go: its left edge and width, the next row's top.
const Rows = struct {
    x: i32
    y: i32
    width: i32
    // The labels' column at the left of a list's row (0: a label has a
    // row of its own above what it names, in a narrow panel).
    label: i32
    scale: i32
}

fn rowsIn(app: *App, area: ui.Rect) -> Rows {
    const s = if app.*.theme.scale > 0 { app.*.theme.scale } else { 1 }
    // (In i64: a width times 34 need not be an i32.)
    var label = @intCast(i32, @intCast(i64, area.width) * 34 / 100)
    if label < 64 * s { label = 64 * s }
    // Narrower than this a list beside its label would show only the
    // first letters of its choice.
    if area.width < NARROW * s { label = 0 }
    return Rows.{ .x = area.x, .y = area.y, .width = area.width, .label = label, .scale = s }
}

// The next row's rectangle (`height` times the scale, the room after it
// counted).
fn take(rows: *Rows, height: i32) -> ui.Rect {
    const made = ui.rect(rows.*.x, rows.*.y, rows.*.width, height * rows.*.scale)
    rows.*.y += (height + GAP) * rows.*.scale
    return made
}

// A line between two groups of rows.
fn parting(kit: *kit_module.Kit, rows: *Rows) -> void {
    kit_module.separator(kit, ui.rect(rows.*.x, rows.*.y, rows.*.width, GROUP_GAP * rows.*.scale))
    rows.*.y += (GROUP_GAP + GAP) * rows.*.scale
}

// A label at the row's left and what it names right of it (in a narrow
// panel: a row of its own, and what it names under it): the rectangle
// for that.
fn labelled(kit: *kit_module.Kit, rows: *Rows, text: []const u8) -> ui.Rect {
    if rows.*.label == 0 {
        // (Farther from the row above than from its own.)
        const over = take(rows, LABEL)
        const room = LABEL_ROOM * rows.*.scale
        kit_module.label(kit, ui.rect(over.x, over.y + room, over.width, over.height - room), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        return take(rows, ROW)
    }
    const row = take(rows, ROW)
    kit_module.label(kit, ui.rect(row.x, row.y, rows.*.label - 6 * rows.*.scale, row.height), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    return ui.rect(row.x + rows.*.label, row.y, row.width - rows.*.label, row.height)
}

// A row with a label and a list to choose from; true when the choice
// changed.
fn choice(app: *App, kit: *kit_module.Kit, rows: *Rows, id: u64, text: []const u8, count: usize, name: kit_module.ListName, chosen: *usize) -> bool {
    return kit_module.comboBoxWith(kit, id, labelled(kit, rows, text), count, name, @intFromPtr(app), chosen)
}

// The blend mode's row; true when it changed.
fn blendChoice(app: *App, kit: *kit_module.Kit, rows: *Rows, id: u64, mode: *u16) -> bool {
    prepareBlendRows()
    var chosen = rowOfMode(mode.*)
    const area = labelled(kit, rows, state.tr(app, "Blending", "Mischmodus"))
    if !kit_module.comboBoxKinds(kit, id, area, blendRowCount, blendName, blendKind, @intFromPtr(app), &chosen) { return false }
    if chosen >= blendRowCount || blendRows[chosen] & ROW_HEADING != 0 { return false }
    mode.* = blendRows[chosen]
    return true
}

// A slider of its own row; true in the frame its change is complete
// (then it is kept).
fn number(kit: *kit_module.Kit, rows: *Rows, id: u64, text: []const u8, value: *f64, options: *const kit_module.SliderOptions) -> bool {
    _ = kit_module.slider(kit, id, take(rows, ROW), text, value, options)
    return kit_module.released(kit, id)
}

// The gradient's colours as a strip (over the checker where they are
// translucent), as they are for the colours chosen now.
fn gradientStrip(app: *App, kit: *kit_module.Kit, area: ui.Rect, options: *const GradientOptions) -> void {
    const canvas = kit_module.canvasOf(kit)
    if canvas.*.device != 0 || canvas.*.width == 0 || area.width <= 2 || area.height <= 2 { return }
    const inner = ui.rect(area.x + 1, area.y + 1, area.width - 2, area.height - 2)
    kit_module.checker(canvas, inner, 4 * app.*.theme.scale)
    var colors: gradient.Gradient = undefined
    chosenGradient(options, &colors)
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const width = @intCast(usize, inner.width)
    const line = scratch.words(pool, width)
    if line != null {
        gradient.render(&colors, gradient.LINEAR, gradient.NONE, options.*.reverse, false, @floatFromInt(f64, inner.x), 0.5, @floatFromInt(f64, inner.x + inner.width), 0.5, geom.rect(inner.x, 0, inner.width, 1), line.?, width, app.*.foreground, app.*.background, 1.0)
        var column: usize = 0
        while column < width {
            kit_module.fillStraight(canvas, ui.rect(inner.x + @intCast(i32, column), inner.y, 1, inner.height), line.?[column])
            column += 1
        }
    }
    scratch.release(pool, mark)
    kit_module.frame(canvas, area, app.*.theme.border)
}

// What the fill tool and enclose-and-fill have alike: what is filled
// with, how the region is found (shown disabled when `searching` is
// false), how it is mixed in. True when something changed for good.
fn commonOptions(app: *App, kit: *kit_module.Kit, rows: *Rows, tool: u8, common: *Common, sliders: *const Sliders, searching: bool) -> bool {
    var changed = false
    if choice(app, kit, rows, idOf(tool, ITEM_SOURCE), state.tr(app, "Fill with", "Füllen mit"), SOURCES, sourceName, &common.*.source) { changed = true }
    const plain = common.*.source != SOURCE_PATTERN
    if plain { kit_module.disabledBegin(kit) }
    if choice(app, kit, rows, idOf(tool, ITEM_PATTERN), state.tr(app, "Pattern", "Muster"), patterns.count(), patternName, &common.*.pattern) { changed = true }
    if plain { kit_module.disabledEnd(kit) }
    parting(kit, rows)
    if !searching { kit_module.disabledBegin(kit) }
    if number(kit, rows, idOf(tool, ITEM_THRESHOLD), state.tr(app, "Threshold", "Schwelle"), &common.*.threshold, &sliders.*.threshold) { changed = true }
    if number(kit, rows, idOf(tool, ITEM_SPREAD), state.tr(app, "Spread", "Ausbreitung"), &common.*.spread, &sliders.*.spread) { changed = true }
    if number(kit, rows, idOf(tool, ITEM_GROW), state.tr(app, "Grow", "Vergrößern"), &common.*.grow, &sliders.*.grow) { changed = true }
    if number(kit, rows, idOf(tool, ITEM_FEATHER), state.tr(app, "Feather", "Weiche Kante"), &common.*.feather, &sliders.*.feather) { changed = true }
    if kit_module.checkBox(kit, idOf(tool, ITEM_MERGED), take(rows, ROW), state.tr(app, "Sample all layers", "Alle Ebenen abtasten"), &common.*.merged) { changed = true }
    if kit_module.checkBox(kit, idOf(tool, ITEM_CORNERS), take(rows, ROW), state.tr(app, "Corners connect", "Ecken verbinden"), &common.*.corners) { changed = true }
    if !searching { kit_module.disabledEnd(kit) }
    parting(kit, rows)
    if blendChoice(app, kit, rows, idOf(tool, ITEM_BLEND), &common.*.mode) { changed = true }
    if number(kit, rows, idOf(tool, ITEM_OPACITY), state.tr(app, "Opacity", "Deckkraft"), &common.*.opacity, &sliders.*.opacity) { changed = true }
    return changed
}

fn fillOptionsPanel(app: *App, area: ui.Rect) -> i32 {
    const tool = fillToolOf(app)
    if tool == null { return 0 }
    const kit = api.kit(app)
    var rows = rowsIn(app, area)
    const options = &tool.?.*.options
    var changed = choice(app, kit, &rows, idOf(FILL, ITEM_TARGET), state.tr(app, "Fill", "Füllen"), TARGETS, targetName, &options.*.target)
    if commonOptions(app, kit, &rows, FILL, &options.*.common, &tool.?.*.sliders, options.*.target != TARGET_SELECTION) { changed = true }
    if changed { keep(app, FILL) }
    return rows.y - area.y
}

fn gradientOptionsPanel(app: *App, area: ui.Rect) -> i32 {
    const tool = gradientToolOf(app)
    if tool == null { return 0 }
    const kit = api.kit(app)
    var rows = rowsIn(app, area)
    const options = &tool.?.*.options
    const sliders = &tool.?.*.sliders
    const id = GRADIENT
    var changed = choice(app, kit, &rows, idOf(id, ITEM_GRADIENT), state.tr(app, "Gradient", "Verlauf"), gradient.builtinCount(), gradientName, &options.*.gradient)
    // The strip lies under the list, as wide as it is.
    const strip = take(&rows, STRIP_ROW)
    gradientStrip(app, kit, ui.rect(strip.x + rows.label, strip.y + (STRIP_ROW - STRIP) * rows.scale / 2, strip.width - rows.label, STRIP * rows.scale), options)
    if choice(app, kit, &rows, idOf(id, ITEM_SHAPE), state.tr(app, "Shape", "Form"), SHAPES_OFFERED, shapeName, &options.*.shape) { changed = true }
    if choice(app, kit, &rows, idOf(id, ITEM_REPEAT), state.tr(app, "Repeat", "Wiederholen"), REPEATS_OFFERED, repeatName, &options.*.repeat) { changed = true }
    // Reverse and Dither side by side (one under the other when narrow).
    // (Numbers, not Rects changed afterwards: those would be temporaries
    // of the value arena.)
    const pair = take(&rows, ROW)
    var first_width = pair.width / 2
    var second_x = pair.x + first_width
    var second_y = pair.y
    if rows.label == 0 {
        first_width = pair.width
        second_x = pair.x
        second_y = take(&rows, ROW).y
    }
    if kit_module.checkBox(kit, idOf(id, ITEM_REVERSE), ui.rect(pair.x, pair.y, first_width, pair.height), state.tr(app, "Reverse", "Umkehren"), &options.*.reverse) { changed = true }
    if kit_module.checkBox(kit, idOf(id, ITEM_DITHER), ui.rect(second_x, second_y, pair.x + pair.width - second_x, pair.height), state.tr(app, "Dither", "Dithern"), &options.*.dither) { changed = true }
    if number(kit, &rows, idOf(id, ITEM_SMOOTHING), state.tr(app, "Smooth edges", "Kanten glätten"), &options.*.smoothing, &sliders.*.smoothing) { changed = true }
    parting(kit, &rows)
    if blendChoice(app, kit, &rows, idOf(id, ITEM_BLEND), &options.*.mode) { changed = true }
    if number(kit, &rows, idOf(id, ITEM_OPACITY), state.tr(app, "Opacity", "Deckkraft"), &options.*.opacity, &sliders.*.opacity) { changed = true }
    if changed { keep(app, GRADIENT) }
    return rows.y - area.y
}

fn encloseOptionsPanel(app: *App, area: ui.Rect) -> i32 {
    const tool = encloseToolOf(app)
    if tool == null { return 0 }
    const kit = api.kit(app)
    var rows = rowsIn(app, area)
    const options = &tool.?.*.options
    const id = ENCLOSE
    var changed = choice(app, kit, &rows, idOf(id, ITEM_ENCLOSING), state.tr(app, "Shape", "Form"), ENCLOSINGS, enclosingName, &options.*.shape)
    if choice(app, kit, &rows, idOf(id, ITEM_METHOD), state.tr(app, "Regions", "Bereiche"), @intCast(usize, fill.METHODS), methodName, &options.*.method) { changed = true }
    // The colour the regions go by: a swatch, and a button that makes it
    // the foreground colour.
    const method = @intCast(u8, options.*.method & 255)
    const colored = method == fill.REGIONS_OF_COLOR || method == fill.REGIONS_SURROUNDED_BY
    if !colored { kit_module.disabledBegin(kit) }
    const place = labelled(kit, &rows, state.tr(app, "Colour", "Farbe"))
    const swatch = ROW * rows.scale
    _ = kit_module.colorSwatch(kit, idOf(id, ITEM_REFERENCE), ui.rect(place.x, place.y, swatch, place.height), options.*.reference, false)
    if kit_module.button(kit, idOf(id, ITEM_TAKE), ui.rect(place.x + swatch + 4 * rows.scale, place.y, place.width - swatch - 4 * rows.scale, place.height), state.tr(app, "Use foreground", "Vordergrund nehmen"), kit_module.BUTTON_NORMAL) {
        options.*.reference = app.*.foreground
        changed = true
    }
    if !colored { kit_module.disabledEnd(kit) }
    parting(kit, &rows)
    if commonOptions(app, kit, &rows, id, &options.*.common, &tool.?.*.sliders, true) { changed = true }
    if changed { keep(app, ENCLOSE) }
    return rows.y - area.y
}

// ---------------------------------------------------------------------------
// The tools

fn deactivateGradient(app: *App) -> void { gradientCancel(app) }
fn deactivateEnclose(app: *App) -> void { encloseCancel(app) }

const TOOLS = [3]state.Tool{
    state.Tool.{ .id = FILL, .key = "fill", .name = "Fill", .german = "Füllen", .shortcut = "F", .icon = icons.TOOL_FILL, .group = state.GROUP_FILL, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = null, .press = fillPress, .move = null, .release = null, .keyPress = null, .tick = null, .overlay = null, .options = fillOptionsPanel, .cancel = null, .finish = null, .busy = null },
    state.Tool.{ .id = GRADIENT, .key = "gradient", .name = "Gradient", .german = "Farbverlauf", .shortcut = "G", .icon = icons.TOOL_GRADIENT, .group = state.GROUP_FILL, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = deactivateGradient, .press = gradientPress, .move = gradientMove, .release = gradientRelease, .keyPress = null, .tick = null, .overlay = gradientOverlay, .options = gradientOptionsPanel, .cancel = gradientCancel, .finish = null, .busy = gradientBusy },
    state.Tool.{ .id = ENCLOSE, .key = "enclosefill", .name = "Enclose and Fill", .german = "Umschließen und füllen", .shortcut = "", .icon = icons.TOOL_ENCLOSE_FILL, .group = state.GROUP_FILL, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = deactivateEnclose, .press = enclosePress, .move = encloseMove, .release = encloseRelease, .keyPress = null, .tick = null, .overlay = encloseOverlay, .options = encloseOptionsPanel, .cancel = encloseCancel, .finish = null, .busy = encloseBusy },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The three tools (FILL, GRADIENT, ENCLOSE), copied out of their constant
// table into the heap once (core/table.mlx); without memory for the copy
// the table as the compiler builds it, good until the window's loop turns
// (the next asking copies again).
pub fn list() -> []const state.Tool {
    if kept.address != 0 { return table.rows(state.Tool, &kept) }
    return table.keep(state.Tool, &kept, TOOLS[0..])
}
