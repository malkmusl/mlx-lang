// nebula tools: the Assistant tool, and where the painting assistants of
// the open documents (core/assistants.mlx) are kept and asked.
//
// With the tool: the options choose the kind of the next assistant;
// clicks on the canvas place its handles one by one (a ruler's two also
// by one drag), its guide following the pointer until the last is
// placed; a handle is dragged to move it; the small cross beside an
// assistant's first handle removes it, so does Delete for the chosen one
// (the one whose handle was touched last); Escape gives up what is being
// placed or dragged. Every edit is a step of the image's history. The
// options also say whether the assistants are shown, whether strokes
// snap to them, "snap single" and the magnetism (they are the document's
// and saved with it), and the chosen assistant's snapping and colour.
//
// The painting tools hand their strokes over, their points in the image's
// coordinates as they come (before the smoothing, which then follows the
// snapped points):
//
//     assist.beginStroke(app, x, y)                       // pen down
//     _ = assist.adjust(app, x, y, &into_x, &into_y)      // every point
//
// and the canvas view (or a painting tool's overlay) shows the guides
// while another tool is in use: assist.drawMarks(app, canvas).
//
// The sets are kept in the tool's slot, a table by document; the set of
// a closed document is let go at the next asking, or at once by forget()
// (which the closing should call: the memory of a closed document and
// its image may be the next one's, and only the history's count of
// steps, which never goes back, tells them apart then; one whose count
// has not fallen below the old one's is taken for it). writeOf() and
// readInto() are the text that goes with the document's file.
//
// Not done: moving a whole assistant by one handle of its own, a set of
// assistants saved to and loaded from a file of its own, choosing a
// colour other than the eight offered.
const std = @import("std")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const view = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const overlay = @import("../ui/overlay.mlx")
const viewport = @import("../ui/viewport.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const history_module = @import("../core/history.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")
const assistants = @import("../core/assistants.mlx")

pub const App = state.App
pub const Input = state.Input
pub const Document = state.Document
pub const Canvas = state.Canvas
pub const Set = assistants.Set
pub const Assistant = assistants.Assistant

// The tool's number (tools/registry.mlx).
pub const ID: u8 = 62

const NONE: usize = assistants.NONE

// A handle and a removing cross are taken within this many window pixels
// (times the scale); the cross sits this far right of and above the
// first handle; a press moved this far before its release is a drag.
const GRAB: f64 = 7.0
const CROSS_OFFSET: f64 = 16.0
const CROSS_ARM: f64 = 4.0
const DRAG: i32 = 4

// The colours offered for an assistant (straight).
const COLORS: usize = 8
const PALETTE = [8]u32{ 0xE03C8CFF, 0xE0FF5050, 0xE040C060, 0xE0FFB020, 0xE0B060FF, 0xE000C8C8, 0xE0FFFFFF, 0xE0202020 }

const TOOLS = [1]state.Tool{
    state.Tool.{ .id = ID, .key = "assistant", .name = "Assistant Tool", .german = "Malassistenten-Werkzeug", .shortcut = "", .icon = icons.TOOL_ASSISTANT, .group = state.GROUP_OTHER, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawOverlay, .options = options, .cancel = cancel, .finish = null, .busy = busy },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Tool {
    if kept.address != 0 { return table.rows(state.Tool, &kept) }
    return table.keep(state.Tool, &kept, TOOLS[0..])
}

// ---------------------------------------------------------------------------
// The sets of the documents

// What the tool keeps (its slot, zeroed at first).
const Keep = struct {
    ready: bool
    // The sets (Set addresses), the document and image each is of, and
    // the image's history's count of steps when it was seen last.
    documents: [state.DOCUMENTS]usize
    images: [state.DOCUMENTS]usize
    serials: [state.DOCUMENTS]u64
    sets: [state.DOCUMENTS]usize
    // The kind and colour of the next assistant.
    kind: usize
    color: u32
    // The chosen assistant (NONE: none) and its set.
    chosen: usize
    chosenSet: usize
    // Placing the handles of `pending` into set `working`; where the
    // pointer is (for the next handle) and where the first press was.
    placing: bool
    pending: Assistant
    pointerX: f64
    pointerY: f64
    pressX: i32
    pressY: i32
    // Dragging handle `handle` of assistant `dragged` of set `working`,
    // which was `before`.
    dragging: bool
    moved: bool
    dragged: usize
    handle: usize
    before: Assistant
    working: usize
    // The density slider is being moved: assistant `adjusted` of set
    // `adjustedSet` was `unadjusted` before.
    adjusting: bool
    adjusted: usize
    adjustedSet: usize
    unadjusted: Assistant
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        keep.*.kind = @intCast(usize, assistants.RULER)
        keep.*.color = assistants.COLOR
        keep.*.chosen = NONE
        keep.*.ready = true
    }
    return keep
}

fn setAt(address: usize) -> *Set {
    unsafe { return @ptrFromInt(*Set, address) }
}

// Whether entry `entry` of the table is of a document that is open: the
// same memory, and a history that did not start again.
fn isOpen(app: *App, keep: *Keep, entry: usize) -> bool {
    var index: usize = 0
    while index < app.*.count && index < state.DOCUMENTS {
        const doc = app.*.documents[index]
        if doc != null && @intFromPtr(doc.?) == keep.*.documents[entry] && @intFromPtr(doc.?.*.image) == keep.*.images[entry] {
            const serial = doc.?.*.image.*.history.*.serial
            if serial < keep.*.serials[entry] { return false }
            keep.*.serials[entry] = serial
            return true
        }
        index += 1
    }
    return false
}

// Whether `doc` is one of the documents open.
fn isListed(app: *App, doc: *Document) -> bool {
    var index: usize = 0
    while index < app.*.count && index < state.DOCUMENTS {
        const open = app.*.documents[index]
        if open != null && @intFromPtr(open.?) == @intFromPtr(doc) { return true }
        index += 1
    }
    return false
}

// Lets go of entry `index` of the table: what the tool was doing in its
// set ends.
fn drop(keep: *Keep, index: usize) -> void {
    const address = keep.*.sets[index]
    if keep.*.working == address {
        keep.*.placing = false
        keep.*.dragging = false
        keep.*.working = 0
    }
    if keep.*.adjustedSet == address {
        keep.*.adjusting = false
        keep.*.adjustedSet = 0
    }
    if keep.*.chosenSet == address {
        keep.*.chosen = NONE
        keep.*.chosenSet = 0
    }
    if address != 0 { assistants.destroy(setAt(address)) }
    keep.*.documents[index] = 0
    keep.*.images[index] = 0
    keep.*.serials[index] = 0
    keep.*.sets[index] = 0
}

// The sets of documents that are no longer open are let go.
fn prune(app: *App, keep: *Keep) -> void {
    var index: usize = 0
    while index < state.DOCUMENTS {
        if keep.*.documents[index] != 0 && !isOpen(app, keep, index) { drop(keep, index) }
        index += 1
    }
}

// The set of `doc`; made when `make` and it has none. Null: none, or no
// memory.
fn setFor(app: *App, keep: *Keep, doc: *Document, make: bool) -> ?*Set {
    prune(app, keep)
    const document = @intFromPtr(doc)
    const image = @intFromPtr(doc.*.image)
    var free = NONE
    var index: usize = 0
    while index < state.DOCUMENTS {
        if keep.*.documents[index] == document && keep.*.images[index] == image { return setAt(keep.*.sets[index]) }
        if keep.*.documents[index] == 0 && free == NONE { free = index }
        index += 1
    }
    if !make || free == NONE { return null }
    const made = assistants.create(app.*.allocator)
    if made == null { return null }
    keep.*.documents[free] = document
    keep.*.images[free] = image
    keep.*.serials[free] = doc.*.image.*.history.*.serial
    keep.*.sets[free] = @intFromPtr(made.?)
    return made
}

fn frontSet(app: *App, make: bool) -> ?*Set {
    const keep = keepOf(app)
    const doc = api.document(app)
    if keep == null || doc == null { return null }
    return setFor(app, keep.?, doc.?, make)
}

// The assistants of the document in front (null: it has none, or no
// document is open).
pub fn setOf(app: *App) -> ?*Set {
    return frontSet(app, false)
}

// A stroke of a painting tool begins at image point (x, y).
pub fn beginStroke(app: *App, x: f64, y: f64) -> void {
    const set = frontSet(app, false)
    if set != null { assistants.begin(set.?, x, y) }
}

// Where the stroke's point (x, y) goes (assistants.project): into
// (into_x, into_y), (x, y) itself when no assistant takes it. True when
// one did.
pub fn adjust(app: *App, x: f64, y: f64, into_x: *f64, into_y: *f64) -> bool {
    const set = frontSet(app, false)
    if set == null {
        into_x.* = x
        into_y.* = y
        return false
    }
    return assistants.project(set.?, x, y, into_x, into_y)
}

// Document `doc` is closing: its assistants are let go now. (Only then:
// the steps of its history name them.)
pub fn forget(app: *App, doc: *Document) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    var index: usize = 0
    while index < state.DOCUMENTS {
        if keep.?.*.documents[index] == @intFromPtr(doc) { drop(keep.?, index) }
        index += 1
    }
}

// The text of `doc`'s assistants (core/assistants.mlx's write) appended
// to `into`; nothing when it has none. False without memory.
pub fn writeOf(app: *App, doc: *Document, into: *std.ArrayList(u8)) -> bool {
    const keep = keepOf(app)
    if keep == null { return true }
    const set = setFor(app, keep.?, doc, false)
    if set == null || set.?.*.count == 0 { return true }
    return assistants.write(set.?, into)
}

// `doc`'s assistants become what `text` says (a document's file read).
// False when it is no such text, `doc` is not one of the open documents
// (a set kept for it would be let go at the next asking) or without
// memory (they stay as they were then).
pub fn readInto(app: *App, doc: *Document, text: []const u8) -> bool {
    const keep = keepOf(app)
    if keep == null || !isListed(app, doc) { return false }
    const set = setFor(app, keep.?, doc, true)
    if set == null { return false }
    return assistants.read(set.?, text)
}

// ---------------------------------------------------------------------------
// Drawing

// The segment from (x0, y0) to (x1, y1) cut to the rectangle (left, top)
// to (right, bottom) (Liang and Barsky): false when nothing of it is
// inside. (Lines without end are long: drawn uncut, their far ends would
// be beyond what the overlay's arithmetic holds.)
fn clipSegment(x0: f64, y0: f64, x1: f64, y1: f64, box: *const [4]f64, into: *[4]f64) -> bool {
    const dx = x1 - x0
    const dy = y1 - y0
    var low: f64 = 0.0
    var high: f64 = 1.0
    var side: usize = 0
    while side < 4 {
        var p: f64 = 0.0
        var q: f64 = 0.0
        if side == 0 {
            p = -dx
            q = x0 - box.*[0]
        } else if side == 1 {
            p = dx
            q = box.*[2] - x0
        } else if side == 2 {
            p = -dy
            q = y0 - box.*[1]
        } else {
            p = dy
            q = box.*[3] - y0
        }
        if p == 0.0 {
            if q < 0.0 { return false }
        } else {
            const t = q / p
            if p < 0.0 {
                if t > high { return false }
                if t > low { low = t }
            } else {
                if t < low { return false }
                if t < high { high = t }
            }
        }
        side += 1
    }
    if !(low <= high) { return false }
    into.*[0] = x0 + dx * low
    into.*[1] = y0 + dy * low
    into.*[2] = x0 + dx * high
    into.*[3] = y0 + dy * high
    return true
}

// The image's rectangle `shown` shows, grown a little: what is drawn is
// cut to it.
fn boxOf(shown: *const viewport.View, box: *[4]f64) -> void {
    const area = viewport.imageRectOf(shown, shown.*.area)
    box.*[0] = @floatFromInt(f64, area.x) - 8.0
    box.*[1] = @floatFromInt(f64, area.y) - 8.0
    box.*[2] = @floatFromInt(f64, area.x) + @floatFromInt(f64, area.width) + 8.0
    box.*[3] = @floatFromInt(f64, area.y) + @floatFromInt(f64, area.height) + 8.0
}

// Lines without end reach this far (they are cut to what is shown).
const REACH: f64 = 100000000.0

// The guides of one assistant in its colour (fainter when it does not
// snap).
fn drawOne(marks: *const overlay.Painter, box: *const [4]f64, assistant: *const Assistant) -> void {
    var room: usize = 0
    var run_room: usize = 0
    assistants.previewRoom(assistant.*.density, &room, &run_room)
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const points = scratch.doubles(pool, room * 2)
    const runs = scratch.words(pool, run_room)
    if points == null || runs == null {
        scratch.release(pool, mark)
        return
    }
    var lines = assistants.linesInto(points.?, room, runs.?, run_room)
    _ = assistants.preview(assistant, REACH, &lines)
    var color = assistant.*.color
    if !assistant.*.snap { color = pixel.withAlpha(color, (color >> 24) / 2) }
    const ink = pixel.premultiplied(color)
    var cut: [4]f64 = undefined
    var first: usize = 0
    var run: usize = 0
    while run < lines.runCount {
        const count = @intCast(usize, lines.runs[run])
        var at: usize = 1
        while at < count {
            const a = (first + at - 1) * 2
            const b = (first + at) * 2
            if clipSegment(lines.points[a], lines.points[a + 1], lines.points[b], lines.points[b + 1], box, &cut) {
                overlay.plainLine(marks, cut[0], cut[1], cut[2], cut[3], ink)
            }
            at += 1
        }
        first += count
        run += 1
    }
    scratch.release(pool, mark)
}

// The guides of all assistants of `set` as `shown` shows the image, with
// the painter `marks` (a tool's overlay, a test's canvas).
pub fn draw(marks: *const overlay.Painter, shown: *const viewport.View, set: *const Set) -> void {
    var box: [4]f64 = undefined
    boxOf(shown, &box)
    var index: usize = 0
    while index < set.*.count {
        drawOne(marks, &box, &set.*.items[index])
        index += 1
    }
}

// Where the removing cross of an assistant whose first handle is at
// window place (x, y) is.
fn crossPlace(app: *App, x: f64, y: f64, cx: *f64, cy: *f64) -> void {
    const s = @floatFromInt(f64, if app.*.scale > 0 { app.*.scale } else { 1 })
    cx.* = x + CROSS_OFFSET * s
    cy.* = y - CROSS_OFFSET * s
}

// The handles and the removing crosses over the guides.
fn drawEditing(app: *App, marks: *const overlay.Painter, doc: *Document, keep: *Keep, set: *Set) -> void {
    const s = @floatFromInt(f64, if app.*.scale > 0 { app.*.scale } else { 1 })
    const own = keep.*.chosenSet == @intFromPtr(set)
    var index: usize = 0
    while index < set.*.count {
        const assistant = &set.*.items[index]
        const chosen = own && keep.*.chosen == index
        var handle: usize = 0
        while handle < @intCast(usize, assistant.*.count) {
            const active = chosen && keep.*.dragging && keep.*.handle == handle
            overlay.handle(marks, assistant.*.x[handle], assistant.*.y[handle], if chosen { overlay.SQUARE } else { overlay.ROUND }, active)
            handle += 1
        }
        var wx: f64 = 0.0
        var wy: f64 = 0.0
        viewport.toWindow(&doc.*.view, assistant.*.x[0], assistant.*.y[0], &wx, &wy)
        var cx: f64 = 0.0
        var cy: f64 = 0.0
        crossPlace(app, wx, wy, &cx, &cy)
        const arm = CROSS_ARM * s
        overlay.windowLine(marks, cx - arm, cy - arm, cx + arm, cy + arm)
        overlay.windowLine(marks, cx - arm, cy + arm, cx + arm, cy - arm)
        index += 1
    }
}

// What is being placed, the pointer standing in for its next handle.
fn drawPending(marks: *const overlay.Painter, box: *const [4]f64, keep: *Keep) -> void {
    var shown = keep.*.pending
    _ = assistants.setHandle(&shown, @intCast(usize, shown.count), keep.*.pointerX, keep.*.pointerY)
    drawOne(marks, box, &shown)
    var handle: usize = 0
    while handle < @intCast(usize, keep.*.pending.count) {
        overlay.handle(marks, keep.*.pending.x[handle], keep.*.pending.y[handle], overlay.SQUARE, false)
        handle += 1
    }
}

// The tool's marks: every assistant (shown or not), its handles and
// cross, what is being placed.
fn drawOverlay(app: *App, canvas: *Canvas) -> void {
    const keep = keepOf(app)
    const doc = api.document(app)
    if keep == null || doc == null { return }
    const marks = overlay.begin(app, canvas)
    const set = setFor(app, keep.?, doc.?, false)
    if set != null {
        draw(&marks, &doc.?.*.view, set.?)
        drawEditing(app, &marks, doc.?, keep.?, set.?)
    }
    if keep.?.*.placing && set != null && keep.?.*.working == @intFromPtr(set.?) {
        var box: [4]f64 = undefined
        boxOf(&doc.?.*.view, &box)
        drawPending(&marks, &box, keep.?)
    }
}

// The guides of the document in front when they are shown: for the
// canvas view (or a painting tool's overlay) while another tool is in
// use.
pub fn drawMarks(app: *App, canvas: *Canvas) -> void {
    const doc = api.document(app)
    const set = frontSet(app, false)
    if doc == null || set == null || !set.?.*.show || set.?.*.count == 0 { return }
    const marks = overlay.begin(app, canvas)
    draw(&marks, &doc.?.*.view, set.?)
}

// ---------------------------------------------------------------------------
// Editing

fn history(app: *App) -> ?*history_module.History {
    const image = api.image(app)
    if image == null { return null }
    return image.?.*.history
}

// The window pixels between window place (x, y) and the pointer's.
fn near(app: *App, input: *const Input, x: f64, y: f64) -> bool {
    const s = @floatFromInt(f64, if app.*.scale > 0 { app.*.scale } else { 1 })
    const dx = x - (@floatFromInt(f64, input.*.windowX) + 0.5)
    const dy = y - (@floatFromInt(f64, input.*.windowY) + 0.5)
    return dx * dx + dy * dy <= GRAB * GRAB * s * s
}

// The assistant whose removing cross is under the pointer (NONE: none).
fn crossAt(app: *App, doc: *Document, set: *Set, input: *const Input) -> usize {
    var index = set.*.count
    while index > 0 {
        index -= 1
        var wx: f64 = 0.0
        var wy: f64 = 0.0
        viewport.toWindow(&doc.*.view, set.*.items[index].x[0], set.*.items[index].y[0], &wx, &wy)
        var cx: f64 = 0.0
        var cy: f64 = 0.0
        crossPlace(app, wx, wy, &cx, &cy)
        if near(app, input, cx, cy) { return index }
    }
    return NONE
}

// The handle under the pointer: its assistant (NONE: none) and which.
fn handleAt(app: *App, doc: *Document, set: *Set, input: *const Input, which: *usize) -> usize {
    // The last drawn is on top.
    var index = set.*.count
    while index > 0 {
        index -= 1
        const assistant = &set.*.items[index]
        var handle = @intCast(usize, assistant.*.count)
        while handle > 0 {
            handle -= 1
            var wx: f64 = 0.0
            var wy: f64 = 0.0
            viewport.toWindow(&doc.*.view, assistant.*.x[handle], assistant.*.y[handle], &wx, &wy)
            if near(app, input, wx, wy) {
                which.* = handle
                return index
            }
        }
    }
    return NONE
}

fn choose(keep: *Keep, set: *Set, index: usize) -> void {
    keep.*.chosen = index
    keep.*.chosenSet = @intFromPtr(set)
}

// The chosen assistant of `set` (NONE: none chosen there).
fn chosenIn(keep: *Keep, set: *Set) -> usize {
    if keep.*.chosenSet != @intFromPtr(set) || keep.*.chosen >= set.*.count { return NONE }
    return keep.*.chosen
}

// Assistant `index` taken out, one step.
fn removeOne(app: *App, keep: *Keep, set: *Set, index: usize) -> void {
    if index >= set.*.count { return }
    const removed = set.*.items[index]
    if !assistants.remove(set, index) { return }
    const steps = history(app)
    if steps != null { _ = assistants.recordRemoved(steps.?, set, index, &removed, state.tr(app, "Remove assistant", "Malassistent entfernt")) }
    if keep.*.chosenSet == @intFromPtr(set) { keep.*.chosen = NONE }
    api.canvasChanged(app)
}

// All assistants taken out, one step.
fn removeAll(app: *App, keep: *Keep, set: *Set) -> void {
    if set.*.count == 0 { return }
    const steps = history(app)
    if steps != null { history_module.begin(steps.?, state.tr(app, "Remove all assistants", "Alle Malassistenten entfernt")) }
    // From the last: undone, they come back from the first.
    while set.*.count > 0 {
        const index = set.*.count - 1
        const removed = set.*.items[index]
        _ = assistants.remove(set, index)
        if steps != null { _ = assistants.recordRemoved(steps.?, set, index, &removed, "") }
    }
    if steps != null { history_module.end(steps.?) }
    if keep.*.chosenSet == @intFromPtr(set) { keep.*.chosen = NONE }
    api.canvasChanged(app)
}

// The pending assistant gets its next handle at (x, y); complete, it is
// added to the set as one step.
fn placeHandle(app: *App, keep: *Keep, set: *Set, x: f64, y: f64) -> void {
    _ = assistants.setHandle(&keep.*.pending, @intCast(usize, keep.*.pending.count), x, y)
    api.canvasChanged(app)
    if !assistants.isComplete(&keep.*.pending) { return }
    keep.*.placing = false
    keep.*.working = 0
    const index = assistants.add(set, &keep.*.pending)
    if index == null {
        api.say(app, state.tr(app, "There are as many assistants as there can be", "Es gibt schon so viele Malassistenten wie möglich"), true)
        return
    }
    const steps = history(app)
    if steps != null { _ = assistants.recordAdded(steps.?, set, index.?, state.tr(app, "Add assistant", "Malassistent hinzugefügt")) }
    choose(keep, set, index.?)
}

fn press(app: *App, input: *const Input) -> void {
    const keep = keepOf(app)
    const doc = api.document(app)
    if keep == null || doc == null || input.*.button != ui_app.BUTTON_LEFT { return }
    const set = setFor(app, keep.?, doc.?, true)
    if set == null { return }
    keep.?.*.pointerX = input.*.x
    keep.?.*.pointerY = input.*.y
    if keep.?.*.placing && keep.?.*.working == @intFromPtr(set.?) {
        placeHandle(app, keep.?, set.?, input.*.x, input.*.y)
        return
    }
    keep.?.*.placing = false
    const crossed = crossAt(app, doc.?, set.?, input)
    if crossed != NONE {
        removeOne(app, keep.?, set.?, crossed)
        return
    }
    var handle: usize = 0
    const touched = handleAt(app, doc.?, set.?, input, &handle)
    if touched != NONE {
        choose(keep.?, set.?, touched)
        keep.?.*.dragging = true
        keep.?.*.moved = false
        keep.?.*.dragged = touched
        keep.?.*.handle = handle
        keep.?.*.before = set.?.*.items[touched]
        keep.?.*.working = @intFromPtr(set.?)
        api.canvasChanged(app)
        return
    }
    // A new assistant begins here.
    keep.?.*.pending = assistants.blank(@intCast(u8, keep.?.*.kind), keep.?.*.color)
    keep.?.*.placing = true
    keep.?.*.working = @intFromPtr(set.?)
    keep.?.*.pressX = input.*.windowX
    keep.?.*.pressY = input.*.windowY
    placeHandle(app, keep.?, set.?, input.*.x, input.*.y)
}

fn move(app: *App, input: *const Input) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    keep.?.*.pointerX = input.*.x
    keep.?.*.pointerY = input.*.y
    if keep.?.*.dragging {
        const set = frontSet(app, false)
        if set == null || @intFromPtr(set.?) != keep.?.*.working || keep.?.*.dragged >= set.?.*.count { return }
        if assistants.setHandle(&set.?.*.items[keep.?.*.dragged], keep.?.*.handle, input.*.x, input.*.y) {
            keep.?.*.moved = true
            api.canvasChanged(app)
        }
        return
    }
    if keep.?.*.placing { api.canvasChanged(app) }
}

// The handle being dragged goes back to where the drag began (a set
// still noted in `working` is alive: drop() forgets it with its set).
fn putBack(keep: *Keep) -> void {
    if !keep.*.dragging || keep.*.working == 0 { return }
    const set = setAt(keep.*.working)
    if keep.*.dragged < set.*.count { set.*.items[keep.*.dragged] = keep.*.before }
}

fn release(app: *App, input: *const Input) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    const set = frontSet(app, false)
    if set == null || @intFromPtr(set.?) != keep.?.*.working {
        // Another document came in front during the drag: no step of its
        // history can take the change.
        putBack(keep.?)
        keep.?.*.dragging = false
        return
    }
    if keep.?.*.dragging {
        keep.?.*.dragging = false
        keep.?.*.working = 0
        const steps = history(app)
        if keep.?.*.moved && keep.?.*.dragged < set.?.*.count && steps != null {
            _ = assistants.recordChanged(steps.?, set.?, keep.?.*.dragged, &keep.?.*.before, state.tr(app, "Move assistant handle", "Griff eines Malassistenten verschoben"))
        }
        api.canvasChanged(app)
        return
    }
    // The first handle dragged out: the second where the drag ends.
    if keep.?.*.placing && keep.?.*.pending.count == 1 {
        const dx = input.*.windowX - keep.?.*.pressX
        const dy = input.*.windowY - keep.?.*.pressY
        const reach = DRAG * (if app.*.scale > 0 { app.*.scale } else { 1 })
        if dx > reach || dx < -reach || dy > reach || dy < -reach { placeHandle(app, keep.?, set.?, input.*.x, input.*.y) }
    }
}

fn cancel(app: *App) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    putBack(keep.?)
    keep.?.*.dragging = false
    keep.?.*.placing = false
    keep.?.*.working = 0
    api.canvasChanged(app)
}

fn busy(app: *App) -> bool {
    const keep = keepOf(app)
    return keep != null && (keep.?.*.placing || keep.?.*.dragging)
}

fn keyPress(app: *App, code: u32, modifiers: u32, down: bool) -> bool {
    if !down || modifiers != 0 || (code != keys.DELETE && code != keys.BACKSPACE) { return false }
    const keep = keepOf(app)
    const set = frontSet(app, false)
    if keep == null || set == null || keep.?.*.placing || keep.?.*.dragging { return false }
    const chosen = chosenIn(keep.?, set.?)
    if chosen == NONE { return false }
    removeOne(app, keep.?, set.?, chosen)
    return true
}

// ---------------------------------------------------------------------------
// Options

fn kindName(context: usize, index: usize) -> []const u8 {
    return assistants.title(@intCast(u8, index), context != 0)
}

fn optionId(name: []const u8, index: usize) -> u64 {
    return view.idOf(view.id(name), index)
}

// The chosen assistant of `set` changed from `before`: one step.
fn changed(app: *App, set: *Set, index: usize, before: *const Assistant, name: []const u8) -> void {
    const steps = history(app)
    if steps != null { _ = assistants.recordChanged(steps.?, set, index, before, name) }
    api.canvasChanged(app)
}

// Whether the kind's preview has a density to choose.
fn usesDensity(kind: u8) -> bool {
    return kind == assistants.VANISHING_POINT || kind == assistants.CONCENTRIC_ELLIPSE || kind == assistants.FISHEYE || kind == assistants.PERSPECTIVE || kind == assistants.TWO_POINT_PERSPECTIVE
}

// The chosen assistant's density: changed as the slider moves, one step
// when the change is complete.
fn densityRow(app: *App, keep: *Keep, set: *Set, chosen: usize, area: ui.Rect) -> void {
    const k = api.kit(app)
    const id = view.id("nebula.assist.density")
    var density = @floatFromInt(f64, set.*.items[chosen].density)
    const span = kit_module.sliderOptions(1.0, @floatFromInt(f64, assistants.DENSITY), 1.0, 0)
    if kit_module.slider(k, id, area, state.tr(app, "Density", "Dichte"), &density, &span) {
        if !keep.*.adjusting || keep.*.adjusted != chosen || keep.*.adjustedSet != @intFromPtr(set) {
            keep.*.adjusting = true
            keep.*.adjusted = chosen
            keep.*.adjustedSet = @intFromPtr(set)
            keep.*.unadjusted = set.*.items[chosen]
        }
        const held = if !(density >= 1.0) { 1.0 } else if density > @floatFromInt(f64, assistants.DENSITY) { @floatFromInt(f64, assistants.DENSITY) } else { density }
        set.*.items[chosen].density = @intFromFloat(u32, held + 0.5)
        api.canvasChanged(app)
    }
    if kit_module.released(k, id) && keep.*.adjusting && keep.*.adjusted == chosen && keep.*.adjustedSet == @intFromPtr(set) {
        keep.*.adjusting = false
        if keep.*.unadjusted.density != set.*.items[chosen].density { changed(app, set, chosen, &keep.*.unadjusted, state.tr(app, "Assistant density", "Dichte eines Malassistenten")) }
    }
}

fn options(app: *App, area: ui.Rect) -> i32 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    const k = api.kit(app)
    const row = state.px(app, kit_module.ROW)
    const gap = state.px(app, 4)
    const left = area.x + gap
    const width = area.width - gap * 2
    const label_width = width / 3
    var y = area.y + gap
    kit_module.label(k, ui.rect(left, y, label_width, row), state.tr(app, "Kind", "Art"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    var kind = keep.?.*.kind
    if kit_module.comboBoxWith(k, view.id("nebula.assist.kind"), ui.rect(left + label_width, y, width - label_width, row), assistants.KINDS, kindName, if app.*.german { 1 } else { 0 }, &kind) {
        if kind < assistants.KINDS { keep.?.*.kind = kind }
        // What was being placed was of the other kind.
        if keep.?.*.placing { cancel(app) }
    }
    y += row + gap
    const set = frontSet(app, true)
    if set == null {
        kit_module.label(k, ui.rect(left, y, width, row), state.tr(app, "No image is open", "Kein Bild ist offen"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        return y + row + gap - area.y
    }
    if kit_module.checkBox(k, view.id("nebula.assist.show"), ui.rect(left, y, width, row), state.tr(app, "Show assistants", "Malassistenten zeigen"), &set.?.*.show) { api.canvasChanged(app) }
    y += row
    _ = kit_module.checkBox(k, view.id("nebula.assist.snap"), ui.rect(left, y, width, row), state.tr(app, "Snap to assistants", "An Malassistenten einrasten"), &set.?.*.snap)
    y += row
    _ = kit_module.checkBox(k, view.id("nebula.assist.single"), ui.rect(left, y, width, row), state.tr(app, "Snap single", "Nur an einem einrasten"), &set.?.*.single)
    y += row + gap
    var percent = set.?.*.magnetism * 100.0
    var range = kit_module.sliderOptions(0.0, 100.0, 5.0, 0)
    range.suffix = " %"
    if kit_module.slider(k, view.id("nebula.assist.magnetism"), ui.rect(left, y, width, row), state.tr(app, "Magnetism", "Magnetismus"), &percent, &range) {
        set.?.*.magnetism = if !(percent >= 0.0) { 0.0 } else if percent > 100.0 { 1.0 } else { percent / 100.0 }
    }
    y += row + gap * 2
    kit_module.separator(k, ui.rect(left, y, width, gap))
    y += gap * 2
    // The chosen assistant: its snapping, its colour, removing it.
    const chosen = chosenIn(keep.?, set.?)
    const swatch = row
    if chosen != NONE {
        kit_module.label(k, ui.rect(left, y, width, row), assistants.title(set.?.*.items[chosen].kind, app.*.german), kit_module.TEXT_ACCENT, kit_module.ALIGN_LEFT)
        y += row
        const before = set.?.*.items[chosen]
        if kit_module.checkBox(k, view.id("nebula.assist.own-snap"), ui.rect(left, y, width, row), state.tr(app, "This one snaps", "Dieser rastet ein"), &set.?.*.items[chosen].snap) {
            changed(app, set.?, chosen, &before, state.tr(app, "Assistant snapping", "Einrasten eines Malassistenten"))
        }
        y += row + gap
        if usesDensity(set.?.*.items[chosen].kind) {
            densityRow(app, keep.?, set.?, chosen, ui.rect(left, y, width, row))
            y += row + gap
        }
    } else {
        kit_module.label(k, ui.rect(left, y, width, row), state.tr(app, "Colour of new assistants", "Farbe neuer Malassistenten"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        y += row
    }
    // As many swatches a row as fit.
    const fitting = (width + gap) / (swatch + gap)
    const per_row: usize = if fitting < 1 { 1 } else { @intCast(usize, fitting) }
    var index: usize = 0
    while index < COLORS {
        const color = PALETTE[index]
        const place = ui.rect(left + @intCast(i32, index % per_row) * (swatch + gap), y + @intCast(i32, index / per_row) * (swatch + gap), swatch, swatch)
        const current = if chosen != NONE { set.?.*.items[chosen].color } else { keep.?.*.color }
        if kit_module.colorSwatch(k, optionId("nebula.assist.color", index), place, color, current == color) {
            keep.?.*.color = color
            if chosen != NONE && set.?.*.items[chosen].color != color {
                const before = set.?.*.items[chosen]
                set.?.*.items[chosen].color = color
                changed(app, set.?, chosen, &before, state.tr(app, "Assistant colour", "Farbe eines Malassistenten"))
            }
        }
        index += 1
    }
    y += @intCast(i32, (COLORS + per_row - 1) / per_row) * (swatch + gap) + gap
    const half = (width - gap) / 2
    if chosen != NONE && kit_module.button(k, view.id("nebula.assist.remove"), ui.rect(left, y, half, row), state.tr(app, "Remove", "Entfernen"), kit_module.BUTTON_NORMAL) {
        removeOne(app, keep.?, set.?, chosen)
    }
    if set.?.*.count > 0 && kit_module.button(k, view.id("nebula.assist.clear"), ui.rect(left + half + gap, y, half, row), state.tr(app, "Remove all", "Alle entfernen"), kit_module.BUTTON_NORMAL) {
        removeAll(app, keep.?, set.?)
    }
    y += row + gap
    return y - area.y
}
