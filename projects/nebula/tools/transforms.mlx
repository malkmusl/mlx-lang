// nebula tools: moving and transforming: the Move tool (T), the free
// Transform tool (Ctrl+T) and the Crop tool (C). Each keeps what it is
// doing in its slot (state.SLOT_TOOL + its id), shows its marks through
// ui/overlay.mlx and its options with the kit (ui/kit.mlx); every action
// it completes is one step of the image's history.
//
// Move: a drag moves the active node by whole pixels: a layer with its
// masks, a group with everything in it (each device's place changes, no
// pixel does: one step "Move layer"). With a selection the selected
// pixels of the layer are cut out and float over it as its overlay
// (core/node.mlx), following the pointer with the selection; the button's
// release puts them down: one step "Move selection" for the pixels and
// the selection together. The arrow keys move by one pixel, with Shift by
// ten, a step a key. Ctrl and a press (or the option "the layer under the
// pointer") first makes the topmost layer that shows a pixel there the
// active one.
//
// Transform: the first press (or a number typed in its options) lifts
// the active paint layer's pixels, or what of them is selected, into a
// working copy; the layer itself does not change until Enter. Its box
// has eight handles and one to turn it by, outside the top edge, and a
// pivot (a cross) that can be dragged. Handles scale, the opposite side
// staying where it is (Shift: in proportion); a drag outside the box
// turns it about the pivot (Shift: in steps of 15 degrees); a drag inside
// moves it; Ctrl and a corner handle turns the transform into a
// perspective one, corner by corner (core/transform.mlx's quads). The
// modes: free; perspective (four corners); warp (a grid of 4 x 4 points,
// each dragged on its own: every cell of the grid is a bilinear patch,
// its pixels found by inverting it, warpInto() below). While it is open
// the layer shows a substitute (core/node.mlx), made again at every
// motion with the bilinear filter (the nearest pixel, and only where the
// window shows, when it is large) and in full at the release; Enter makes
// it the layer's own with the filter chosen in the options (nearest,
// bilinear, bicubic, Lanczos): one step "Transform", the selection
// transformed with it. Escape drops it all: nothing was recorded.
// Switching to another tool applies a transform that changed something.
//
// Crop: a drag makes a rectangle (fixed in its ratio or its size when the
// options say so), with handles at its corners and edges; a drag inside
// moves it. Enter crops the image to it: its size changes and every
// layer, mask and the selection move so that what was at the rectangle's
// corner is at the image's (one step "Crop"; undo gives size and places
// back). The options can let the rectangle reach beyond the image (the
// canvas grows) or crop only the active layer (what lies outside the
// rectangle is cleared). Escape forgets the rectangle.
//
// The options that last between runs are kept by app/settings.mlx as
// texts: tool.move.under, tool.transform.mode, tool.transform.filter,
// tool.crop.ratio, tool.crop.ratio.width, tool.crop.ratio.height,
// tool.crop.size, tool.crop.size.width, tool.crop.size.height,
// tool.crop.grow, tool.crop.layer. They are read when a tool becomes the
// one in use. The options' widgets are named optionId(tool, ITEM_...).
//
//     const tool = tools.byKey("transform")         // tools/registry.mlx
//     api.setTool(app, tool.?.*.id)
//
// Not done here: liquify and cage transforms; warping with the bicubic
// and Lanczos filters (a warp takes the bilinear one for both); a layer's
// masks transformed with it (they are moved with it by the Move tool, not
// scaled or turned by the Transform tool); transforming a group, a
// vector or a file layer as one; the guides moved by a crop.
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const settings = @import("../app/settings.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const overlay = @import("../ui/overlay.mlx")
const viewport = @import("../ui/viewport.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history_module = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const selection_module = @import("../core/selection.mlx")
const transform = @import("../core/transform.mlx")
const table = @import("../core/table.mlx")

pub const App = state.App
pub const Input = state.Input
pub const Canvas = state.Canvas
const Rect = geom.Rect
const Device = device_module.Device
const Node = node_module.Node
const Image = image_module.Image
const Matrix = transform.Matrix
const Kit = kit_module.Kit

pub const MOVE: u8 = 20
pub const TRANSFORM: u8 = 21
pub const CROP: u8 = 22

// The Transform tool's modes.
pub const MODE_FREE: u8 = 0
pub const MODE_PERSPECTIVE: u8 = 1
pub const MODE_WARP: u8 = 2
const MODES: usize = 3

// The widgets of the options, for optionId(): the modes' buttons are
// ITEM_MODE + MODE_*.
pub const ITEM_UNDER: usize = 1
pub const ITEM_MODE: usize = 2
pub const ITEM_X: usize = 8
pub const ITEM_Y: usize = 9
pub const ITEM_WIDTH: usize = 10
pub const ITEM_HEIGHT: usize = 11
pub const ITEM_ANGLE: usize = 12
pub const ITEM_SKEW: usize = 13
pub const ITEM_FILTER: usize = 14
pub const ITEM_APPLY: usize = 15
pub const ITEM_CANCEL: usize = 16
pub const ITEM_RATIO: usize = 17
pub const ITEM_RATIO_WIDTH: usize = 18
pub const ITEM_RATIO_HEIGHT: usize = 19
pub const ITEM_SIZE: usize = 20
pub const ITEM_SIZE_WIDTH: usize = 21
pub const ITEM_SIZE_HEIGHT: usize = 22
pub const ITEM_GROW: usize = 23
pub const ITEM_LAYER: usize = 24

// What a press took hold of: the box (to move it), the turn's handle or
// what lies outside the box (to turn it), the pivot, a scaling handle
// (`index` 0 the top left one, clockwise: 0, 2, 4, 6 the corners), a
// perspective corner (`index` 0 the top left, clockwise), a point of the
// warp's grid (`index` row after row), a crop rectangle being made.
const PART_NONE: u8 = 0
const PART_MOVE: u8 = 1
const PART_ROTATE: u8 = 2
const PART_PIVOT: u8 = 3
const PART_SCALE: u8 = 4
const PART_CORNER: u8 = 5
const PART_POINT: u8 = 6
const PART_NEW: u8 = 7

// Where the eight handles sit on a box, as parts of its width and height.
const HANDLE_U = [8]f64{ 0.0, 0.5, 1.0, 1.0, 1.0, 0.5, 0.0, 0.0 }
const HANDLE_V = [8]f64{ 0.0, 0.0, 0.0, 0.5, 1.0, 1.0, 1.0, 0.5 }

// The warp's grid: points a side, and its cells a side.
const GRID: usize = 4
const CELLS: usize = 3
const POINTS: usize = 16

// A handle is taken within this many window pixels of its middle (times
// the scale); the turning handle sits this far outside the top edge.
const GRAB: f64 = 7.0
const TURN_REACH: f64 = 22.0
// Shift turns in steps of this (15 degrees).
const TURN_STEP: f64 = 0.2617993877991494
// While dragging, a preview of more pixels than this is made with the
// nearest pixel, and only of what the window shows.
const QUICK_PIXELS: i64 = 1048576
// Places, scales and sizes are held to these (beyond, the arithmetic of
// pixels would leave an i32).
const FAR: f64 = 100000000.0
const LARGEST_SCALE: f64 = 10000.0
// The darkening outside a crop rectangle (premultiplied black).
const CROP_SHADE: u32 = 0x78000000

// The settings' keys.
const KEY_MOVE_UNDER: []const u8 = "tool.move.under"
const KEY_TRANSFORM_MODE: []const u8 = "tool.transform.mode"
const KEY_TRANSFORM_FILTER: []const u8 = "tool.transform.filter"
const KEY_CROP_RATIO: []const u8 = "tool.crop.ratio"
const KEY_CROP_RATIO_WIDTH: []const u8 = "tool.crop.ratio.width"
const KEY_CROP_RATIO_HEIGHT: []const u8 = "tool.crop.ratio.height"
const KEY_CROP_SIZE: []const u8 = "tool.crop.size"
const KEY_CROP_SIZE_WIDTH: []const u8 = "tool.crop.size.width"
const KEY_CROP_SIZE_HEIGHT: []const u8 = "tool.crop.size.height"
const KEY_CROP_GROW: []const u8 = "tool.crop.grow"
const KEY_CROP_LAYER: []const u8 = "tool.crop.layer"

// ---------------------------------------------------------------------------
// Shared

fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }
fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }

fn held(value: f64, low: f64, high: f64) -> f64 {
    if !(value == value) { return 0.0 }
    return if value < low { low } else if value > high { high } else { value }
}

// The nearest whole number, held where an i32 has room for arithmetic on
// it.
fn whole(value: f64) -> i32 {
    return @intFromFloat(i32, math.round(held(value, -FAR, FAR)))
}

fn wholeFloor(value: f64) -> i32 {
    return @intFromFloat(i32, @floor(held(value, -FAR, FAR)))
}

fn float(value: i32) -> f64 { return @floatFromInt(f64, value) }

fn pixels(area: Rect) -> i64 {
    if geom.isEmpty(area) { return 0 }
    return @intCast(i64, area.width) * @intCast(i64, area.height)
}

// The widget `item` of `tool`'s options.
pub fn optionId(tool: u8, item: usize) -> u64 {
    const base = if tool == MOVE { view.id("nebula.tool.move") } else if tool == TRANSFORM { view.id("nebula.tool.transform") } else { view.id("nebula.tool.crop") }
    return view.idOf(base, item)
}

fn settingOn(app: *App, key: []const u8, fallback: bool) -> bool {
    const text = settings.text(app, key)
    if text.length == 0 { return fallback }
    return text[0] == 49
}

fn settingNumber(app: *App, key: []const u8, fallback: f64, low: f64, high: f64) -> f64 {
    var value: f64 = 0.0
    if !kit_module.parseNumber(settings.text(app, key), &value) { return fallback }
    return held(value, low, high)
}

fn keepOn(app: *App, key: []const u8, on: bool) -> void {
    _ = settings.setText(app, key, if on { "1" } else { "0" })
}

fn keepNumber(app: *App, key: []const u8, value: f64) -> void {
    var text: [32]u8 = undefined
    const bytes: [*]u8 = &text
    const length = kit_module.formatNumber(value, 3, bytes)
    _ = settings.setText(app, key, bytes[0..length])
}

// Whether `image` is still one of the open documents' (a document closed
// while a tool held on to its image).
fn isOpen(app: *App, image: usize) -> bool {
    var index: usize = 0
    while index < app.*.count {
        const doc = app.*.documents[index]
        if doc != null && @intFromPtr(doc.?.*.image) == image { return true }
        index += 1
    }
    return false
}

fn imageAt(address: usize) -> *Image { unsafe { return @ptrFromInt(*Image, address) } }
fn deviceAt(address: usize) -> *Device { unsafe { return @ptrFromInt(*Device, address) } }

// The image in front when it is the one at `address`.
fn frontImage(app: *App, address: usize) -> ?*Image {
    const image = api.image(app)
    if image == null || @intFromPtr(image.?) != address { return null }
    return image
}

// The window place of image point (x, y) in the document in front.
fn windowOf(app: *App, x: f64, y: f64, wx: *f64, wy: *f64) -> void {
    const doc = api.document(app)
    wx.* = x
    wy.* = y
    if doc == null { return }
    viewport.toWindow(&doc.?.*.view, x, y, wx, wy)
}

// How far from the pointer's window place image point (x, y) is shown, in
// window pixels.
fn reach(app: *App, input: *const Input, x: f64, y: f64) -> f64 {
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    windowOf(app, x, y, &wx, &wy)
    const dx = wx - (float(input.*.windowX) + 0.5)
    const dy = wy - (float(input.*.windowY) + 0.5)
    return @sqrt(dx * dx + dy * dy)
}

fn grab(app: *App) -> f64 {
    return GRAB * float(if app.*.scale > 0 { app.*.scale } else { 1 })
}

// Whether point (x, y) lies inside the polygon of `count` points
// (`points`: x and y of each in turn), by the crossings of a ray to the
// right.
fn insidePolygon(points: [*]const f64, count: usize, x: f64, y: f64) -> bool {
    var inside = false
    var index: usize = 0
    var last = count - 1
    while index < count {
        const xi = points[index * 2]
        const yi = points[index * 2 + 1]
        const xj = points[last * 2]
        const yj = points[last * 2 + 1]
        if (yi > y) != (yj > y) {
            const crossing = xi + (y - yi) * (xj - xi) / (yj - yi)
            if x < crossing { inside = !inside }
        }
        last = index
        index += 1
    }
    return inside
}

// `piece`'s pixels put over those of `target` where they lie (normal
// mixing at full opacity), tile by tile of the piece. False when memory
// ran out.
fn compositeOver(target: *Device, piece: *Device) -> bool {
    var list = std.ArrayList(u64).init(piece.*.allocator)
    defer list.deinit()
    if !device_module.keys(piece, &list) { return false }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const rows = scratch.words(pool, device_module.TILE_PIXELS)
    if rows == null {
        scratch.release(pool, mark)
        return false
    }
    var whole_write = true
    for key in list.items() {
        const tx = device_module.keyX(key)
        const ty = device_module.keyY(key)
        const source = device_module.tileRead(piece, tx, ty)
        if source == null { continue }
        // A tile of nothing changes nothing (and makes no tile).
        var any = false
        var index: usize = 0
        while index < device_module.TILE_PIXELS {
            if source.?[index] >> 24 != 0 {
                any = true
                break
            }
            index += 1
        }
        if !any { continue }
        const area = device_module.tileArea(piece, tx, ty)
        device_module.readRect(target, area, rows.?, 64)
        var row: usize = 0
        while row < 64 {
            pixel.overSpan(rows.? + row * 64, source.? + row * 64, 64, 255)
            row += 1
        }
        if !device_module.writeRect(target, area, rows.?, 64) { whole_write = false }
    }
    scratch.release(pool, mark)
    return whole_write
}

fn noMemory(app: *App) -> void {
    api.say(app, state.tr(app, "There is not enough memory for that", "Dafür reicht der Speicher nicht"), true)
}

// "+12, -3 px" into `into` (48 bytes); its length.
fn offsetText(dx: i32, dy: i32, into: [*]u8) -> usize {
    var length: usize = 0
    if dx > 0 { length = std.text.appendByte(into, length, 48, 43) }
    length = std.text.appendSigned(into, length, 48, @intCast(isize, dx))
    length = std.text.append(into, length, 48, ", ")
    if dy > 0 { length = std.text.appendByte(into, length, 48, 43) }
    length = std.text.appendSigned(into, length, 48, @intCast(isize, dy))
    return std.text.append(into, length, 48, " px")
}

// "120 × 80" into `into` (48 bytes); its length.
fn sizeText(width: i32, height: i32, into: [*]u8) -> usize {
    var length = std.text.appendSigned(into, 0, 48, @intCast(isize, width))
    length = std.text.append(into, length, 48, " \xC3\x97 ")
    return std.text.appendSigned(into, length, 48, @intCast(isize, height))
}

// A panel's rows, laid out from the top of `area` down.
const Rows = struct {
    x: i32
    y: i32
    width: i32
    row: i32
    gap: i32
    top: i32
}

fn rowsIn(app: *App, area: ui.Rect) -> Rows {
    const s = if app.*.scale > 0 { app.*.scale } else { 1 }
    return Rows.{ .x = area.x, .y = area.y, .width = area.width, .row = kit_module.ROW * s, .gap = 4 * s, .top = area.y }
}

// The next row, `height` tall.
fn nextRow(rows: *Rows, height: i32) -> ui.Rect {
    const made = ui.rect(rows.*.x, rows.*.y, rows.*.width, height)
    rows.*.y += height + rows.*.gap
    return made
}

// A line of help in the small font, dim.
fn note(rows: *Rows, kit: *Kit, text: []const u8) -> void {
    kit_module.label(kit, nextRow(rows, rows.*.row * 3 / 4), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
}

// A line between groups of rows.
fn divide(rows: *Rows, kit: *Kit) -> void {
    kit_module.separator(kit, nextRow(rows, rows.*.gap * 2 + 1))
}

fn usedHeight(rows: *const Rows) -> i32 {
    return if rows.*.y > rows.*.top { rows.*.y - rows.*.top - rows.*.gap } else { 0 }
}

// A label at the left of `area` in `label_width`, the rest for a widget:
// the widget's rectangle.
fn labelled(app: *App, kit: *Kit, area: ui.Rect, text: []const u8, label_width: i32) -> ui.Rect {
    kit_module.label(kit, ui.rect(area.x, area.y, label_width, area.height), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    return ui.rect(area.x + label_width, area.y, area.width - label_width, area.height)
}

// How wide the widest of the labels is in the small font, and a little
// room after it.
fn labelWidth(app: *App, a: []const u8, b: []const u8, c: []const u8) -> i32 {
    const font = state.smallOf(app)
    var most = text_module.measure(font, a)
    most = larger(most, text_module.measure(font, b))
    most = larger(most, text_module.measure(font, c))
    const s = if app.*.scale > 0 { app.*.scale } else { 1 }
    // Without fonts nothing is measured: room for a few letters.
    if most == 0 { most = 40 * s }
    return most + 10 * s
}

// ---------------------------------------------------------------------------
// Move

const Mover = struct {
    loaded: bool
    // The option: a press moves the layer under the pointer.
    underPointer: bool
    dragging: bool
    // The image and the node moved (by its id).
    image: usize
    node: u32
    // The selection's pixels float as the node's overlay (`piece`).
    floating: bool
    piece: usize
    startX: f64
    startY: f64
    // How far it is moved now.
    dx: i32
    dy: i32
    // Around what moves, as it was at the start.
    bounds: Rect
}

fn moverOf(app: *App) -> ?*Mover {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, MOVE), @sizeOf(Mover))
    if memory == null { return null }
    const mover: *Mover = unsafe { @ptrCast(*Mover, memory.?) }
    if !mover.*.loaded {
        mover.*.loaded = true
        mover.*.underPointer = settingOn(app, KEY_MOVE_UNDER, false)
    }
    return mover
}

fn moveActivate(app: *App) -> void {
    const mover = moverOf(app)
    if mover == null { return }
    mover.?.*.underPointer = settingOn(app, KEY_MOVE_UNDER, mover.?.*.underPointer)
}

// The topmost layer under `group` that shows a pixel at (x, y): one that
// is shown, holds pixels of its own (not a group, a mask, a filter or a
// clone) and has alpha there.
fn layerAt(group: *Node, x: i32, y: i32) -> ?*Node {
    var found: ?*Node = null
    var index = node_module.childCount(group)
    while index > 0 {
        index -= 1
        const child = node_module.childAt(group, index)
        const kind = child.*.kind
        if node_module.isMask(kind) || !child.*.visible || kind == node_module.FILTER || kind == node_module.CLONE { continue }
        if kind == node_module.GROUP {
            found = layerAt(child, x, y)
            if found != null { return found }
            continue
        }
        if child.*.device != null && device_module.pixel(child.*.device.?, x, y) >> 24 != 0 { return child }
    }
    return found
}

// Every device a move takes along: the node's own and those of all under
// it (a group's layers, a layer's masks).
fn beginAll(image: *Image, node: *Node) -> void {
    _ = ops.beginPixels(image, node)
    for child in node.*.children.items() {
        beginAll(image, child)
    }
}

fn shiftAll(node: *Node, dx: i32, dy: i32) -> void {
    if node.*.device != null { device_module.moveBy(node.*.device.?, dx, dy) }
    for child in node.*.children.items() {
        shiftAll(child, dx, dy)
    }
}

// Whether every device under `node` stays within 2^30 of the origin when
// moved by (dx, dy) (the room core/device.mlx's arithmetic has).
fn canShift(node: *Node, dx: i32, dy: i32) -> bool {
    if node.*.device != null {
        const x = @intCast(i64, node.*.device.?.*.x) + @intCast(i64, dx)
        const y = @intCast(i64, node.*.device.?.*.y) + @intCast(i64, dy)
        if x < -1073741824 || x > 1073741824 || y < -1073741824 || y > 1073741824 { return false }
    }
    for child in node.*.children.items() {
        if !canShift(child, dx, dy) { return false }
    }
    return true
}

fn endAll(image: *Image, node: *Node, name: []const u8) -> Rect {
    var area = ops.endPixels(image, node, name)
    for child in node.*.children.items() {
        area = geom.unite(area, endAll(image, child, name))
    }
    return area
}

fn cancelAll(image: *Image, node: *Node) -> Rect {
    var area = ops.cancelPixels(image, node)
    for child in node.*.children.items() {
        area = geom.unite(area, cancelAll(image, child))
    }
    return area
}

// The rectangle around the pixels of everything under `node` that holds
// any (the layers', not the masks': those cover everything).
fn contentBounds(node: *Node) -> Rect {
    var area = geom.empty()
    if node.*.device != null && !node_module.isMask(node.*.kind) && node.*.kind != node_module.FILTER && node.*.kind != node_module.CLONE {
        area = device_module.exactBounds(node.*.device.?)
    }
    for child in node.*.children.items() {
        area = geom.unite(area, contentBounds(child))
    }
    return area
}

// The node a move takes, and whether it can be moved (the status bar
// says why not).
fn movable(app: *App, image: *Image) -> ?*Node {
    const node = image.*.active
    if node == null {
        api.say(app, state.tr(app, "There is no layer to move", "Es gibt keine Ebene zum Verschieben"), true)
        return null
    }
    if node.?.*.locked {
        api.say(app, state.tr(app, "The layer is locked", "Die Ebene ist gesperrt"), true)
        return null
    }
    if !node_module.isShown(node.?) {
        api.say(app, state.tr(app, "The layer is hidden", "Die Ebene ist ausgeblendet"), true)
        return null
    }
    return node
}

// Whether the selection's pixels of `node` can be cut out and moved: a
// paint layer's (a group, a mask has none of its own to cut).
fn floatable(node: *Node) -> bool {
    return node.*.kind == node_module.PAINT && node.*.device != null && node.*.device.?.*.defaultPixel >> 24 == 0
}

// Starts moving `node` from image point (x, y): the selected pixels cut
// out and floating when there is a selection, else every device under it
// recording. False (and nothing started) without memory.
fn startMove(app: *App, mover: *Mover, image: *Image, node: *Node, x: f64, y: f64) -> bool {
    mover.*.image = @intFromPtr(image)
    mover.*.node = node.*.id
    mover.*.startX = x
    mover.*.startY = y
    mover.*.dx = 0
    mover.*.dy = 0
    mover.*.floating = false
    mover.*.piece = 0
    if image.*.selected && floatable(node) {
        const area = selection_module.bounds(image.*.selection)
        const piece = selection_module.copySelected(node.*.device.?, image.*.selection, area)
        if piece == null {
            noMemory(app)
            return false
        }
        _ = ops.beginPixels(image, node)
        if !selection_module.clearSelected(node.*.device.?, image.*.selection, area) {
            _ = ops.cancelPixels(image, node)
            device_module.destroy(piece.?)
            noMemory(app)
            return false
        }
        ops.beginSelection(image)
        node.*.overlay = piece
        node.*.overlayOpacity = 255
        node.*.overlayBlend = 0
        node.*.overlayMasked = false
        mover.*.floating = true
        mover.*.piece = @intFromPtr(piece.?)
        mover.*.bounds = device_module.exactBounds(piece.?)
        image_module.damage(image, area)
        return true
    }
    beginAll(image, node)
    mover.*.bounds = contentBounds(node)
    return true
}

// Moves what startMove took to (dx, dy) from where it was.
fn shiftMove(app: *App, mover: *Mover, dx: i32, dy: i32) -> void {
    const image = frontImage(app, mover.*.image)
    if image == null { return }
    const node = image_module.find(image.?, mover.*.node)
    if node == null { return }
    const step_x = dx - mover.*.dx
    const step_y = dy - mover.*.dy
    if step_x == 0 && step_y == 0 { return }
    if mover.*.floating {
        const piece = deviceAt(mover.*.piece)
        const x = @intCast(i64, piece.*.x) + @intCast(i64, step_x)
        const y = @intCast(i64, piece.*.y) + @intCast(i64, step_y)
        if x < -1073741824 || x > 1073741824 || y < -1073741824 || y > 1073741824 { return }
        const before = device_module.extent(piece)
        device_module.moveBy(piece, step_x, step_y)
        device_module.moveBy(image.?.*.selection, step_x, step_y)
        image_module.selectionChanged(image.?)
        api.imageChanged(app, geom.unite(before, device_module.extent(piece)))
    } else {
        if !canShift(node.?, step_x, step_y) { return }
        const before = history_module.footprint(image.?, node.?)
        shiftAll(node.?, step_x, step_y)
        api.imageChanged(app, geom.unite(before, history_module.footprint(image.?, node.?)))
    }
    mover.*.dx = dx
    mover.*.dy = dy
}

// Ends the move: kept as one step (`keep`) or put back.
fn endMove(app: *App, mover: *Mover, keep: bool) -> void {
    mover.*.dragging = false
    if !isOpen(app, mover.*.image) {
        // The document went: so did what was moved, but the piece is ours.
        if mover.*.floating { device_module.destroy(deviceAt(mover.*.piece)) }
        mover.*.floating = false
        mover.*.piece = 0
        return
    }
    const image = imageAt(mover.*.image)
    const node = image_module.find(image, mover.*.node)
    const moved = mover.*.dx != 0 || mover.*.dy != 0
    var area = geom.empty()
    if mover.*.floating {
        const piece = deviceAt(mover.*.piece)
        area = device_module.extent(piece)
        const name = state.tr(app, "Move selection", "Auswahl verschieben")
        if node != null && @intFromPtr(node.?.*.overlay) == mover.*.piece { node.?.*.overlay = null }
        if node != null && keep && moved && compositeOver(node.?.*.device.?, piece) {
            history_module.begin(image.*.history, name)
            area = geom.unite(area, ops.endPixels(image, node.?, name))
            _ = selection_module.clip(image.*.selection, image_module.bounds(image))
            ops.endSelection(image, true, name)
            history_module.end(image.*.history)
        } else {
            if node != null { area = geom.unite(area, ops.cancelPixels(image, node.?)) }
            ops.cancelSelection(image)
        }
        area = geom.unite(area, geom.moved(area, -mover.*.dx, -mover.*.dy))
        device_module.destroy(piece)
        mover.*.floating = false
        mover.*.piece = 0
    } else if node != null {
        if keep && moved {
            const name = state.tr(app, "Move layer", "Ebene verschieben")
            history_module.begin(image.*.history, name)
            area = endAll(image, node.?, name)
            history_module.end(image.*.history)
        } else {
            area = cancelAll(image, node.?)
        }
    }
    image_module.damage(image, area)
    api.redraw(app)
}

fn movePress(app: *App, input: *const Input) -> void {
    const mover = moverOf(app)
    const image = api.image(app)
    if mover == null || image == null || input.*.button != ui_app.BUTTON_LEFT || mover.?.*.dragging { return }
    if input.*.modifiers & keys.CONTROL != 0 || mover.?.*.underPointer {
        const under = layerAt(image.?.*.root, wholeFloor(input.*.x), wholeFloor(input.*.y))
        if under != null && (image.?.*.active == null || @intFromPtr(image.?.*.active.?) != @intFromPtr(under.?)) {
            image.?.*.active = under
            api.layersChanged(app)
        }
    }
    const node = movable(app, image.?)
    if node == null { return }
    if startMove(app, mover.?, image.?, node.?, input.*.x, input.*.y) { mover.?.*.dragging = true }
}

fn moveMotion(app: *App, input: *const Input) -> void {
    const mover = moverOf(app)
    if mover == null || !mover.?.*.dragging { return }
    shiftMove(app, mover.?, whole(input.*.x - mover.?.*.startX), whole(input.*.y - mover.?.*.startY))
}

fn moveRelease(app: *App, input: *const Input) -> void {
    const mover = moverOf(app)
    if mover == null || !mover.?.*.dragging { return }
    endMove(app, mover.?, true)
}

fn moveCancel(app: *App) -> void {
    const mover = moverOf(app)
    if mover == null || !mover.?.*.dragging { return }
    endMove(app, mover.?, false)
}

fn moveBusy(app: *App) -> bool {
    const mover = moverOf(app)
    return mover != null && mover.?.*.dragging
}

// The arrow keys: a pixel a press (ten with Shift), one step each.
fn moveKey(app: *App, code: u32, modifiers: u32, down: bool) -> bool {
    if code != keys.LEFT && code != keys.RIGHT && code != keys.UP && code != keys.DOWN { return false }
    if modifiers & ~keys.SHIFT != 0 { return false }
    const mover = moverOf(app)
    const image = api.image(app)
    if mover == null || image == null { return false }
    if !down || mover.?.*.dragging { return true }
    const step: i32 = if modifiers & keys.SHIFT != 0 { 10 } else { 1 }
    var dx: i32 = 0
    var dy: i32 = 0
    if code == keys.LEFT { dx = -step }
    if code == keys.RIGHT { dx = step }
    if code == keys.UP { dy = -step }
    if code == keys.DOWN { dy = step }
    const node = movable(app, image.?)
    if node == null { return true }
    if !startMove(app, mover.?, image.?, node.?, 0.0, 0.0) { return true }
    shiftMove(app, mover.?, dx, dy)
    endMove(app, mover.?, true)
    return true
}

fn moveOverlay(app: *App, canvas: *Canvas) -> void {
    const mover = moverOf(app)
    if mover == null || !mover.?.*.dragging || frontImage(app, mover.?.*.image) == null { return }
    const bounds = mover.?.*.bounds
    if geom.isEmpty(bounds) { return }
    const marks = overlay.begin(app, canvas)
    const x = float(bounds.x + mover.?.*.dx)
    const y = float(bounds.y + mover.?.*.dy)
    overlay.dashedRect(&marks, x, y, float(bounds.width), float(bounds.height))
    var text: [48]u8 = undefined
    const bytes: [*]u8 = &text
    const length = offsetText(mover.?.*.dx, mover.?.*.dy, bytes)
    overlay.label(&marks, x + float(bounds.width), y + float(bounds.height), bytes[0..length])
}

fn moveOptions(app: *App, area: ui.Rect) -> i32 {
    const mover = moverOf(app)
    if mover == null { return 0 }
    const kit = api.kit(app)
    var rows = rowsIn(app, area)
    if kit_module.checkBox(kit, optionId(MOVE, ITEM_UNDER), nextRow(&rows, rows.row), state.tr(app, "Move the layer under the pointer", "Ebene unter dem Zeiger verschieben"), &mover.?.*.underPointer) {
        keepOn(app, KEY_MOVE_UNDER, mover.?.*.underPointer)
    }
    note(&rows, kit, state.tr(app, "Ctrl+click picks the layer under the pointer", "Strg+Klick wählt die Ebene unter dem Zeiger"))
    note(&rows, kit, state.tr(app, "Arrow keys: 1 px, with Shift 10 px", "Pfeiltasten: 1 px, mit Umschalt 10 px"))
    return usedHeight(&rows)
}

// ---------------------------------------------------------------------------
// Transform

const Transformer = struct {
    loaded: bool
    mode: u8
    // The mode to go back to when this transform ends (Control and a
    // corner turned a free one into a perspective one for a while).
    modeBefore: u8
    temporary: bool
    // The filter Enter makes the result with (core/transform.mlx's).
    filter: u8
    // A transform is open: the pixels are lifted, the layer shows the
    // preview; and whether anything was changed since.
    lifted: bool
    changed: bool
    image: usize
    node: u32
    fromSelection: bool
    // What is transformed; the layer without it (from a selection: what
    // stays where it is); the selection as it was (transformed with the
    // pixels); the preview, the node's substitute (0: none yet).
    source: usize
    base: usize
    mask: usize
    preview: usize
    // The image's rectangle the preview differs from the layer in (what
    // is drawn again when it changes or goes).
    shown: Rect
    // Around the pixels transformed, where they were.
    origin: Rect
    // Free: a place p of the source goes to (tx, ty) + R S Sh (p - c),
    // c the middle of `origin`: R turns by `rotation` (radians,
    // clockwise), S scales by (sx, sy), Sh pushes x by `shear` times y.
    tx: f64
    ty: f64
    rotation: f64
    sx: f64
    sy: f64
    shear: f64
    // The place it turns about, in the source's coordinates.
    pivotX: f64
    pivotY: f64
    // Perspective: where the corners of `origin` go, x and y of each,
    // clockwise from the top left.
    quad: [8]f64
    // Warp: where the grid's points go (they lie evenly over `origin`),
    // row after row, x and y of each.
    grid: [32]f64
    // A drag: what it holds (PART_*, `index`), where it began, and what
    // was there then.
    dragging: bool
    part: u8
    index: usize
    pressX: f64
    pressY: f64
    startTx: f64
    startTy: f64
    startRotation: f64
    startSx: f64
    startSy: f64
    startPoints: [32]f64
    // A scaling's fixed point or the pivot a turn is about, and the handle
    // dragged (image places), the pointer's angle at the press.
    anchorX: f64
    anchorY: f64
    handleX: f64
    handleY: f64
    startAngle: f64
    // What is under the pointer (lit).
    hover: u8
    hoverIndex: usize
    // Before anything is lifted the box shows around the active layer's
    // pixels, worked out once for this image, node, history and selection.
    idleImage: usize
    idleNode: u32
    idleSerial: u64
    idleSelection: u64
    // The numbers the options show: x, y, width, height, angle, skew.
    fields: [6]f64
}

fn modeKey(mode: u8) -> []const u8 {
    if mode == MODE_PERSPECTIVE { return "perspective" }
    if mode == MODE_WARP { return "warp" }
    return "free"
}

fn modeOf(text: []const u8, fallback: u8) -> u8 {
    if std.text.same(text, "free") { return MODE_FREE }
    if std.text.same(text, "perspective") { return MODE_PERSPECTIVE }
    if std.text.same(text, "warp") { return MODE_WARP }
    return fallback
}

fn filterKey(filter: u8) -> []const u8 {
    if filter == transform.NEAREST { return "nearest" }
    if filter == transform.BILINEAR { return "bilinear" }
    if filter == transform.LANCZOS3 { return "lanczos" }
    return "bicubic"
}

fn filterOf(text: []const u8, fallback: u8) -> u8 {
    if std.text.same(text, "nearest") { return transform.NEAREST }
    if std.text.same(text, "bilinear") { return transform.BILINEAR }
    if std.text.same(text, "bicubic") { return transform.BICUBIC }
    if std.text.same(text, "lanczos") { return transform.LANCZOS3 }
    return fallback
}

fn transformerOf(app: *App) -> ?*Transformer {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, TRANSFORM), @sizeOf(Transformer))
    if memory == null { return null }
    const t: *Transformer = unsafe { @ptrCast(*Transformer, memory.?) }
    if !t.*.loaded {
        t.*.loaded = true
        t.*.mode = modeOf(settings.text(app, KEY_TRANSFORM_MODE), MODE_FREE)
        t.*.filter = filterOf(settings.text(app, KEY_TRANSFORM_FILTER), transform.BICUBIC)
        t.*.sx = 1.0
        t.*.sy = 1.0
    }
    return t
}

// A cosine or sine a hair from 0 or 1 is that: quarter turns come out
// exact, as core/transform.mlx's rotation() makes them.
fn snapUnit(value: f64) -> f64 {
    if math.abs(value) < 1.0e-12 { return 0.0 }
    if math.abs(value - 1.0) < 1.0e-12 { return 1.0 }
    if math.abs(value + 1.0) < 1.0e-12 { return -1.0 }
    return value
}

fn middleX(t: *const Transformer) -> f64 { return float(t.*.origin.x) + float(t.*.origin.width) / 2.0 }
fn middleY(t: *const Transformer) -> f64 { return float(t.*.origin.y) + float(t.*.origin.height) / 2.0 }

// The free transform's matrix.
fn freeMatrix(t: *const Transformer) -> Matrix {
    const cosine = snapUnit(math.cos(t.*.rotation))
    const sine = snapUnit(math.sin(t.*.rotation))
    const a = cosine * t.*.sx
    const b = cosine * t.*.sx * t.*.shear - sine * t.*.sy
    const d = sine * t.*.sx
    const e = sine * t.*.sx * t.*.shear + cosine * t.*.sy
    const cx = middleX(t)
    const cy = middleY(t)
    return Matrix.{ .a = a, .b = b, .c = t.*.tx - a * cx - b * cy, .d = d, .e = e, .f = t.*.ty - d * cx - e * cy, .g = 0.0, .h = 0.0, .i = 1.0 }
}

fn quadOf(t: *const Transformer) -> transform.Quad {
    return transform.Quad.{ .x0 = t.*.quad[0], .y0 = t.*.quad[1], .x1 = t.*.quad[2], .y1 = t.*.quad[3], .x2 = t.*.quad[4], .y2 = t.*.quad[5], .x3 = t.*.quad[6], .y3 = t.*.quad[7] }
}

// The matrix of the free or the perspective transform into `into`. False
// for a quad no perspective makes (not convex).
fn currentMatrix(t: *const Transformer, into: *Matrix) -> bool {
    if t.*.mode == MODE_PERSPECTIVE {
        const quad = quadOf(t)
        return transform.toQuad(t.*.origin, &quad, into)
    }
    into.* = freeMatrix(t)
    return true
}

// The place of the warp's grid point `index` in the source.
fn gridSource(t: *const Transformer, index: usize, u: *f64, v: *f64) -> void {
    const column = @floatFromInt(f64, index % GRID)
    const row = @floatFromInt(f64, index / GRID)
    u.* = float(t.*.origin.x) + float(t.*.origin.width) * column / 3.0
    v.* = float(t.*.origin.y) + float(t.*.origin.height) * row / 3.0
}

// Nothing transformed yet: the box is `origin`, the pivot its middle, the
// corners and the grid's points where they lie.
fn resetGeometry(t: *Transformer, origin: Rect) -> void {
    t.*.origin = origin
    t.*.tx = middleX(t)
    t.*.ty = middleY(t)
    t.*.rotation = 0.0
    t.*.sx = 1.0
    t.*.sy = 1.0
    t.*.shear = 0.0
    t.*.pivotX = t.*.tx
    t.*.pivotY = t.*.ty
    const left = float(origin.x)
    const top = float(origin.y)
    const right = left + float(origin.width)
    const bottom = top + float(origin.height)
    t.*.quad[0] = left
    t.*.quad[1] = top
    t.*.quad[2] = right
    t.*.quad[3] = top
    t.*.quad[4] = right
    t.*.quad[5] = bottom
    t.*.quad[6] = left
    t.*.quad[7] = bottom
    var index: usize = 0
    while index < POINTS {
        gridSource(t, index, &t.*.grid[index * 2], &t.*.grid[index * 2 + 1])
        index += 1
    }
}

// The move that brings source place (u, v) to image place (x, y) under
// the turn, scale and shear there are now.
fn placeFixed(t: *Transformer, u: f64, v: f64, x: f64, y: f64) -> void {
    t.*.tx = 0.0
    t.*.ty = 0.0
    const m = freeMatrix(t)
    const now = transform.apply(&m, u, v)
    t.*.tx = held(x - now.x, -FAR, FAR)
    t.*.ty = held(y - now.y, -FAR, FAR)
}

// A scale that keeps at least a pixel of a side `length` long, and no
// more than LARGEST_SCALE.
fn usableScale(value: f64, length: i32) -> f64 {
    const least = 1.0 / float(larger(length, 1))
    if !(value == value) { return 1.0 }
    if math.abs(value) < least { return if value < 0.0 { -least } else { least } }
    return held(value, -LARGEST_SCALE, LARGEST_SCALE)
}

// Where the source place (u, v) of the box's handle `index` lies.
fn handleSource(t: *const Transformer, index: usize, u: *f64, v: *f64) -> void {
    u.* = float(t.*.origin.x) + float(t.*.origin.width) * HANDLE_U[index]
    v.* = float(t.*.origin.y) + float(t.*.origin.height) * HANDLE_V[index]
}

// Handle `index` dragged to image place (x, y): the scales that bring it
// there with the opposite handle (anchorX, anchorY) where it was;
// `keep`: both scaled alike.
fn scaleTo(t: *Transformer, x: f64, y: f64, keep: bool) -> void {
    const index = t.*.index
    const opposite = (index + 4) % 8
    const across = (HANDLE_U[index] - HANDLE_U[opposite]) * float(t.*.origin.width)
    const down = (HANDLE_V[index] - HANDLE_V[opposite]) * float(t.*.origin.height)
    // In the box's own directions (turned back): the scales times the
    // sheared distance between the two handles.
    const cosine = snapUnit(math.cos(t.*.startRotation))
    const sine = snapUnit(math.sin(t.*.startRotation))
    const rx = x - t.*.anchorX
    const ry = y - t.*.anchorY
    const lx = cosine * rx + sine * ry
    const ly = cosine * ry - sine * rx
    const sheared = across + t.*.shear * down
    var sx = t.*.startSx
    var sy = t.*.startSy
    if keep {
        const ex = t.*.startSx * sheared
        const ey = t.*.startSy * down
        const length = ex * ex + ey * ey
        if length > 0.0 {
            const factor = (lx * ex + ly * ey) / length
            sx = t.*.startSx * factor
            sy = t.*.startSy * factor
        }
    } else {
        if HANDLE_U[index] != 0.5 && sheared != 0.0 { sx = lx / sheared }
        if HANDLE_V[index] != 0.5 && down != 0.0 { sy = ly / down }
    }
    t.*.sx = usableScale(sx, t.*.origin.width)
    t.*.sy = usableScale(sy, t.*.origin.height)
    t.*.rotation = t.*.startRotation
    var u: f64 = 0.0
    var v: f64 = 0.0
    handleSource(t, opposite, &u, &v)
    placeFixed(t, u, v, t.*.anchorX, t.*.anchorY)
}

// An angle in (-pi, pi].
fn normalAngle(angle: f64) -> f64 {
    var result = held(angle, -100.0, 100.0)
    while result > math.pi { result -= math.tau }
    while result <= -math.pi { result += math.tau }
    return result
}

// Lifts the active layer's pixels (what of them is selected) into the
// working copy. False, with the status bar saying why, when there is
// nothing to lift.
fn lift(app: *App, t: *Transformer) -> bool {
    if t.*.lifted { return true }
    const image = api.image(app)
    if image == null { return false }
    const node = api.paintable(app)
    if node == null { return false }
    if node.?.*.kind != node_module.PAINT {
        api.say(app, state.tr(app, "Only a paint layer can be transformed", "Nur eine Malebene kann transformiert werden"), true)
        return false
    }
    const layer = node.?.*.device.?
    var source: ?*Device = null
    var base: ?*Device = null
    var mask: ?*Device = null
    var made = true
    if image.?.*.selected {
        const area = selection_module.bounds(image.?.*.selection)
        source = selection_module.copySelected(layer, image.?.*.selection, area)
        base = device_module.copy(layer)
        mask = device_module.copy(image.?.*.selection)
        made = source != null && base != null && mask != null && selection_module.clearSelected(base.?, image.?.*.selection, area)
    } else {
        source = device_module.copy(layer)
        made = source != null
    }
    var origin = geom.empty()
    if made { origin = device_module.exactBounds(source.?) }
    if !made || geom.isEmpty(origin) {
        if source != null { device_module.destroy(source.?) }
        if base != null { device_module.destroy(base.?) }
        if mask != null { device_module.destroy(mask.?) }
        if made {
            api.say(app, state.tr(app, "There is nothing here to transform", "Hier gibt es nichts zu transformieren"), true)
        } else {
            noMemory(app)
        }
        return false
    }
    t.*.image = @intFromPtr(image.?)
    t.*.node = node.?.*.id
    t.*.fromSelection = image.?.*.selected
    t.*.source = @intFromPtr(source.?)
    t.*.base = if base != null { @intFromPtr(base.?) } else { 0 }
    t.*.mask = if mask != null { @intFromPtr(mask.?) } else { 0 }
    t.*.preview = 0
    t.*.shown = origin
    t.*.lifted = true
    t.*.changed = false
    t.*.dragging = false
    resetGeometry(t, origin)
    return true
}

// Ends an open transform without applying it: the layer shows its own
// pixels again, nothing was recorded.
fn drop(app: *App, t: *Transformer) -> void {
    t.*.dragging = false
    t.*.idleImage = 0
    if !t.*.lifted { return }
    if isOpen(app, t.*.image) {
        const image = imageAt(t.*.image)
        const node = image_module.find(image, t.*.node)
        if node != null && t.*.preview != 0 && @intFromPtr(node.?.*.substitute) == t.*.preview { node.?.*.substitute = null }
        image_module.damage(image, t.*.shown)
    }
    if t.*.preview != 0 { device_module.destroy(deviceAt(t.*.preview)) }
    if t.*.source != 0 { device_module.destroy(deviceAt(t.*.source)) }
    if t.*.base != 0 { device_module.destroy(deviceAt(t.*.base)) }
    if t.*.mask != 0 { device_module.destroy(deviceAt(t.*.mask)) }
    t.*.preview = 0
    t.*.source = 0
    t.*.base = 0
    t.*.mask = 0
    t.*.lifted = false
    t.*.changed = false
    if t.*.temporary {
        t.*.mode = t.*.modeBefore
        t.*.temporary = false
    }
    api.redraw(app)
}

// A transform of a document not in front (or of a layer gone) is
// dropped.
fn settleTransform(app: *App, t: *Transformer) -> void {
    if !t.*.lifted { return }
    const image = frontImage(app, t.*.image)
    if image == null || image_module.find(image.?, t.*.node) == null { drop(app, t) }
}

// Shows the box around the active layer's pixels while nothing is
// lifted. False when there is nothing to show it around.
fn idle(app: *App, t: *Transformer) -> bool {
    const image = api.image(app)
    if image == null || image.?.*.active == null { return false }
    const node = image.?.*.active.?
    if node.*.kind != node_module.PAINT || node.*.device == null { return false }
    const serial = image.?.*.history.*.serial
    if t.*.idleImage == @intFromPtr(image.?) && t.*.idleNode == node.*.id && t.*.idleSerial == serial && t.*.idleSelection == image.?.*.selectionSerial {
        return !geom.isEmpty(t.*.origin)
    }
    var bounds = device_module.exactBounds(node.*.device.?)
    if image.?.*.selected { bounds = geom.intersect(bounds, selection_module.bounds(image.?.*.selection)) }
    resetGeometry(t, bounds)
    t.*.idleImage = @intFromPtr(image.?)
    t.*.idleNode = node.*.id
    t.*.idleSerial = serial
    t.*.idleSelection = image.?.*.selectionSerial
    return !geom.isEmpty(bounds)
}

// The box the tool shows now (lifted, or around the active layer): false
// when there is none.
fn showing(app: *App, t: *Transformer) -> bool {
    settleTransform(app, t)
    if t.*.lifted { return true }
    return idle(app, t)
}

// Changes the mode; what is open goes over into it as it looks
// (perspective from the free box's corners, a warp's grid from where the
// matrix brings its points; back to free: the free box as it was).
fn setMode(app: *App, t: *Transformer, mode: u8, keep: bool) -> void {
    if mode >= @intCast(u8, MODES) { return }
    if t.*.mode == mode {
        if keep && t.*.temporary {
            t.*.temporary = false
            _ = settings.setText(app, KEY_TRANSFORM_MODE, modeKey(mode))
        }
        return
    }
    if t.*.lifted {
        var m = freeMatrix(t)
        if t.*.mode == MODE_PERSPECTIVE {
            var made: Matrix = undefined
            if currentMatrix(t, &made) { m = made }
        }
        if mode == MODE_PERSPECTIVE {
            if t.*.mode == MODE_WARP {
                // The grid's corners.
                t.*.quad[0] = t.*.grid[0]
                t.*.quad[1] = t.*.grid[1]
                t.*.quad[2] = t.*.grid[6]
                t.*.quad[3] = t.*.grid[7]
                t.*.quad[4] = t.*.grid[30]
                t.*.quad[5] = t.*.grid[31]
                t.*.quad[6] = t.*.grid[24]
                t.*.quad[7] = t.*.grid[25]
            } else {
                const corners = transform.quadOf(t.*.origin)
                const mapped = transform.mapQuad(&m, &corners)
                t.*.quad[0] = mapped.x0
                t.*.quad[1] = mapped.y0
                t.*.quad[2] = mapped.x1
                t.*.quad[3] = mapped.y1
                t.*.quad[4] = mapped.x2
                t.*.quad[5] = mapped.y2
                t.*.quad[6] = mapped.x3
                t.*.quad[7] = mapped.y3
            }
            var check: Matrix = undefined
            const quad = quadOf(t)
            if !transform.toQuad(t.*.origin, &quad, &check) {
                const plain = transform.quadOf(t.*.origin)
                t.*.quad[0] = plain.x0
                t.*.quad[1] = plain.y0
                t.*.quad[2] = plain.x1
                t.*.quad[3] = plain.y1
                t.*.quad[4] = plain.x2
                t.*.quad[5] = plain.y2
                t.*.quad[6] = plain.x3
                t.*.quad[7] = plain.y3
            }
        } else if mode == MODE_WARP {
            var index: usize = 0
            while index < POINTS {
                var u: f64 = 0.0
                var v: f64 = 0.0
                gridSource(t, index, &u, &v)
                const at = transform.apply(&m, u, v)
                t.*.grid[index * 2] = held(at.x, -FAR, FAR)
                t.*.grid[index * 2 + 1] = held(at.y, -FAR, FAR)
                index += 1
            }
        }
        t.*.mode = mode
        render(app, t, false)
    } else {
        t.*.mode = mode
    }
    if keep {
        // Chosen in the options: it stays when this transform ends.
        t.*.temporary = false
        _ = settings.setText(app, KEY_TRANSFORM_MODE, modeKey(mode))
    }
    api.redraw(app)
}

// Where the result lies now: where the source's pixels land and as far
// around as `filter` spreads them.
fn resultArea(t: *const Transformer, filter: u8) -> Rect {
    if t.*.mode == MODE_WARP {
        var x0 = t.*.grid[0]
        var y0 = t.*.grid[1]
        var x1 = x0
        var y1 = y0
        var index: usize = 1
        while index < POINTS {
            x0 = math.min(x0, t.*.grid[index * 2])
            x1 = math.max(x1, t.*.grid[index * 2])
            y0 = math.min(y0, t.*.grid[index * 2 + 1])
            y1 = math.max(y1, t.*.grid[index * 2 + 1])
            index += 1
        }
        return geom.grown(geom.fromBounds(held(x0, -FAR, FAR), held(y0, -FAR, FAR), held(x1, -FAR, FAR), held(y1, -FAR, FAR)), 2)
    }
    var m: Matrix = undefined
    if !currentMatrix(t, &m) { return geom.empty() }
    return transform.coverage(t.*.origin, &m, filter)
}

// The source's pixels as the transform has them, into `into` within
// `area`. False without memory (or for a matrix with no inverse).
fn renderInto(t: *const Transformer, source: *Device, into: *Device, filter: u8, area: Rect) -> bool {
    if t.*.mode == MODE_WARP { return warpInto(source, into, t, filter, area) }
    var m: Matrix = undefined
    if !currentMatrix(t, &m) { return false }
    return transform.resample(source, into, &m, filter, area)
}

// What the window shows of the image in front, a little more.
fn visiblePart(app: *App) -> Rect {
    const doc = api.document(app)
    if doc == null { return geom.empty() }
    return geom.grown(viewport.imageRectOf(&doc.?.*.view, doc.?.*.view.area), 4)
}

// The preview made again (`quick`: while dragging, cheaper when large)
// and shown as the layer's substitute.
fn render(app: *App, t: *Transformer, quick: bool) -> void {
    const image = frontImage(app, t.*.image)
    if image == null { return }
    const node = image_module.find(image.?, t.*.node)
    if node == null { return }
    var filter = transform.BILINEAR
    var area = resultArea(t, filter)
    if quick && pixels(area) > QUICK_PIXELS {
        filter = transform.NEAREST
        area = geom.intersect(area, visiblePart(app))
    }
    // A result far larger than the image (a perspective whose horizon
    // runs close by) is shown where it can be seen.
    if pixels(area) > QUICK_PIXELS * 16 { area = geom.intersect(area, geom.unite(visiblePart(app), image_module.bounds(image.?))) }
    const source = deviceAt(t.*.source)
    var made: ?*Device = null
    if t.*.fromSelection {
        made = device_module.copy(deviceAt(t.*.base))
    } else {
        made = device_module.create(app.*.allocator, 0)
    }
    if made == null {
        noMemory(app)
        return
    }
    var done = true
    if t.*.fromSelection {
        const moved = device_module.create(app.*.allocator, 0)
        done = moved != null && renderInto(t, source, moved.?, filter, area) && compositeOver(made.?, moved.?)
        if moved != null { device_module.destroy(moved.?) }
    } else {
        done = renderInto(t, source, made.?, filter, area)
    }
    if !done {
        device_module.destroy(made.?)
        noMemory(app)
        return
    }
    node.?.*.substitute = made
    if t.*.preview != 0 { device_module.destroy(deviceAt(t.*.preview)) }
    t.*.preview = @intFromPtr(made.?)
    const damaged = geom.unite(t.*.shown, area)
    t.*.shown = geom.unite(t.*.origin, area)
    api.imageChanged(app, damaged)
}

// Makes the transform the layer's own (with the selection transformed
// alike): one step. It stays open when that cannot be done.
fn apply(app: *App, t: *Transformer) -> void {
    settleTransform(app, t)
    if !t.*.lifted { return }
    if !t.*.changed {
        drop(app, t)
        return
    }
    const image = imageAt(t.*.image)
    const node = image_module.find(image, t.*.node).?
    const source = deviceAt(t.*.source)
    const area = resultArea(t, t.*.filter)
    if pixels(area) > 268435456 {
        api.say(app, state.tr(app, "The result would be too large", "Das Ergebnis wäre zu groß"), true)
        return
    }
    const name = state.tr(app, "Transform", "Transformieren")
    const layer = node.*.device.?
    history_module.begin(image.*.history, name)
    _ = ops.beginPixels(image, node)
    var done = true
    if t.*.fromSelection {
        const mask = deviceAt(t.*.mask)
        done = selection_module.clearSelected(layer, mask, selection_module.bounds(mask))
        const moved = device_module.create(app.*.allocator, 0)
        done = done && moved != null && renderInto(t, source, moved.?, t.*.filter, area) && compositeOver(layer, moved.?)
        if moved != null { device_module.destroy(moved.?) }
    } else {
        device_module.clear(layer)
        done = renderInto(t, source, layer, t.*.filter, area)
    }
    if !done {
        image_module.damage(image, ops.cancelPixels(image, node))
        history_module.end(image.*.history)
        noMemory(app)
        return
    }
    var changed = ops.endPixels(image, node, name)
    if t.*.fromSelection {
        ops.beginSelection(image)
        device_module.clear(image.*.selection)
        const mask = deviceAt(t.*.mask)
        if renderInto(t, mask, image.*.selection, transform.BILINEAR, resultArea(t, transform.BILINEAR)) && selection_module.clip(image.*.selection, image_module.bounds(image)) {
            ops.endSelection(image, true, name)
        } else {
            ops.cancelSelection(image)
        }
    }
    history_module.end(image.*.history)
    changed = geom.unite(changed, t.*.shown)
    drop(app, t)
    api.imageChanged(app, changed)
}

// ---------------------------------------------------------------------------
// Warping: each cell of the grid is a bilinear patch over its piece of
// the source. A pixel of the result is found in the patch it lies in by
// inverting the patch (a quadratic in one of its two parameters), and is
// the source's colour there, bilinear (or the nearest pixel).

// Where the source is read for warping: the tile looked up last.
const Taps = struct {
    device: *Device
    tx: i32
    ty: i32
    tile: usize
    known: bool
}

fn tap(taps: *Taps, x: i32, y: i32) -> u32 {
    const device = taps.*.device
    const lx = x - device.*.x
    const ly = y - device.*.y
    const tx = lx >> 6
    const ty = ly >> 6
    if !taps.*.known || tx != taps.*.tx || ty != taps.*.ty {
        const found = device_module.tileRead(device, tx, ty)
        taps.*.tile = 0
        if found != null { taps.*.tile = @intFromPtr(found.?) }
        taps.*.tx = tx
        taps.*.ty = ty
        taps.*.known = true
    }
    if taps.*.tile == 0 { return device.*.defaultPixel }
    const words: [*]const u32 = unsafe { @ptrFromInt([*]const u32, taps.*.tile) }
    return words[@intCast(usize, ((ly & 63) << 6) | (lx & 63))]
}

// The source's colour at place (u, v): the nearest pixel, or the four
// around weighed by how near each is (in 256ths of a pixel), the colours
// weighed by their alpha so that transparent ones count for nothing.
fn sample(taps: *Taps, u: f64, v: f64, filter: u8) -> u32 {
    if filter == transform.NEAREST { return tap(taps, wholeFloor(u), wholeFloor(v)) }
    const px = u - 0.5
    const py = v - 0.5
    var x0 = wholeFloor(px)
    var y0 = wholeFloor(py)
    var fx = @intFromFloat(u32, (px - @floor(px)) * 256.0 + 0.5)
    var fy = @intFromFloat(u32, (py - @floor(py)) * 256.0 + 0.5)
    if fx >= 256 {
        fx = 0
        x0 += 1
    }
    if fy >= 256 {
        fy = 0
        y0 += 1
    }
    if fx == 0 && fy == 0 { return tap(taps, x0, y0) }
    const p00 = tap(taps, x0, y0)
    const p10 = tap(taps, x0 + 1, y0)
    const p01 = tap(taps, x0, y0 + 1)
    const p11 = tap(taps, x0 + 1, y0 + 1)
    const w00 = @intCast(u64, (256 - fx) * (256 - fy))
    const w10 = @intCast(u64, fx * (256 - fy))
    const w01 = @intCast(u64, (256 - fx) * fy)
    const w11 = @intCast(u64, fx * fy)
    const a00 = w00 * @intCast(u64, p00 >> 24)
    const a10 = w10 * @intCast(u64, p10 >> 24)
    const a01 = w01 * @intCast(u64, p01 >> 24)
    const a11 = w11 * @intCast(u64, p11 >> 24)
    const total = a00 + a10 + a01 + a11
    const alpha = (total + 32768) >> 16
    if alpha == 0 || total == 0 { return 0 }
    const half = total / 2
    const r = (a00 * @intCast(u64, pixel.red(p00)) + a10 * @intCast(u64, pixel.red(p10)) + a01 * @intCast(u64, pixel.red(p01)) + a11 * @intCast(u64, pixel.red(p11)) + half) / total
    const g = (a00 * @intCast(u64, pixel.green(p00)) + a10 * @intCast(u64, pixel.green(p10)) + a01 * @intCast(u64, pixel.green(p01)) + a11 * @intCast(u64, pixel.green(p11)) + half) / total
    const b = (a00 * @intCast(u64, pixel.blue(p00)) + a10 * @intCast(u64, pixel.blue(p10)) + a01 * @intCast(u64, pixel.blue(p01)) + a11 * @intCast(u64, pixel.blue(p11)) + half) / total
    return pixel.pack(@intCast(u32, if alpha > 255 { 255 } else { alpha }), @intCast(u32, r), @intCast(u32, g), @intCast(u32, b))
}

// The rows a band of the result has, for a box `width` wide: about a
// million pixels at a time.
fn bandRows(width: i32) -> i32 {
    const rows = 1048576 / larger(width, 1)
    return if rows < 1 { 1 } else if rows > 256 { 256 } else { rows }
}

// The source warped by the grid into `into`, within `area`: every pixel
// of a cell's patch made; pixels outside every patch stay as they are.
// False without memory.
fn warpInto(source: *Device, into: *Device, t: *const Transformer, filter: u8, area: Rect) -> bool {
    var taps = Taps.{ .device = source, .tx = 0, .ty = 0, .tile = 0, .known = false }
    var row: usize = 0
    while row < CELLS {
        var column: usize = 0
        while column < CELLS {
            if !warpCell(&taps, into, t, column, row, filter, area) { return false }
            column += 1
        }
        row += 1
    }
    return true
}

fn warpCell(taps: *Taps, into: *Device, t: *const Transformer, column: usize, row: usize, filter: u8, area: Rect) -> bool {
    const first = row * GRID + column
    // The patch's corners: a at the cell's top left, b its top right, c
    // its bottom right, d its bottom left.
    const ax = t.*.grid[first * 2]
    const ay = t.*.grid[first * 2 + 1]
    const bx = t.*.grid[(first + 1) * 2]
    const by = t.*.grid[(first + 1) * 2 + 1]
    const cx = t.*.grid[(first + GRID + 1) * 2]
    const cy = t.*.grid[(first + GRID + 1) * 2 + 1]
    const dx = t.*.grid[(first + GRID) * 2]
    const dy = t.*.grid[(first + GRID) * 2 + 1]
    // The cell's piece of the source.
    var u0: f64 = 0.0
    var v0: f64 = 0.0
    var u1: f64 = 0.0
    var v1: f64 = 0.0
    gridSource(t, first, &u0, &v0)
    gridSource(t, first + GRID + 1, &u1, &v1)
    const box = geom.intersect(geom.fromBounds(math.min(math.min(ax, bx), math.min(cx, dx)), math.min(math.min(ay, by), math.min(cy, dy)), math.max(math.max(ax, bx), math.max(cx, dx)), math.max(math.max(ay, by), math.max(cy, dy))), area)
    if geom.isEmpty(box) { return true }
    // p = a + e s + f r + g s r: s across the cell, r down it.
    const ex = bx - ax
    const ey = by - ay
    const fx = dx - ax
    const fy = dy - ay
    const gx = ax - bx + cx - dx
    const gy = ay - by + cy - dy
    const k2 = gx * fy - gy * fx
    const cross_ef = ex * fy - ey * fx
    const width = @intCast(usize, box.width)
    const band = bandRows(box.width)
    const pool = scratch.common()
    var top = box.y
    while top < geom.bottom(box) {
        const height = smaller(band, geom.bottom(box) - top)
        const strip = geom.rect(box.x, top, box.width, height)
        const mark = scratch.mark(pool)
        const words = scratch.words(pool, width * @intCast(usize, height))
        if words == null {
            scratch.release(pool, mark)
            return false
        }
        device_module.readRect(into, strip, words.?, width)
        var y: i32 = 0
        while y < height {
            const qy = float(top + y) + 0.5
            const line = words.? + @intCast(usize, y) * width
            var x: usize = 0
            while x < width {
                const qx = float(box.x + @intCast(i32, x)) + 0.5
                const hx = qx - ax
                const hy = qy - ay
                const k1 = cross_ef + hx * gy - hy * gx
                const k0 = hx * ey - hy * ex
                // k2 r^2 + k1 r + k0 = 0, solved without the loss of
                // digits the plain formula has when k2 is small (a cell
                // that is all but a parallelogram).
                var square = k1 * k1 - 4.0 * k0 * k2
                if square < 0.0 && square > -1.0e-9 * k1 * k1 { square = 0.0 }
                if square >= 0.0 {
                    const root = @sqrt(square)
                    const q = if k1 >= 0.0 { -0.5 * (k1 + root) } else { -0.5 * (k1 - root) }
                    var found = false
                    var s: f64 = 0.0
                    var r: f64 = 0.0
                    var attempt: usize = 0
                    while attempt < 2 && !found {
                        var candidate: f64 = -1.0
                        var usable = false
                        if attempt == 0 && q != 0.0 {
                            candidate = k0 / q
                            usable = true
                        } else if attempt == 1 && k2 != 0.0 {
                            candidate = q / k2
                            usable = true
                        }
                        if usable && candidate >= -0.000001 && candidate <= 1.000001 {
                            const across_x = ex + gx * candidate
                            const across_y = ey + gy * candidate
                            var along: f64 = -1.0
                            if math.abs(across_x) >= math.abs(across_y) {
                                if across_x != 0.0 { along = (hx - fx * candidate) / across_x }
                            } else {
                                along = (hy - fy * candidate) / across_y
                            }
                            if along >= -0.000001 && along <= 1.000001 {
                                found = true
                                s = held(along, 0.0, 1.0)
                                r = held(candidate, 0.0, 1.0)
                            }
                        }
                        attempt += 1
                    }
                    if found { line[x] = sample(taps, u0 + s * (u1 - u0), v0 + r * (v1 - v0), filter) }
                }
                x += 1
            }
            y += 1
        }
        const written = device_module.writeRect(into, strip, words.?, width)
        scratch.release(pool, mark)
        if !written { return false }
        top += height
    }
    return true
}

// ---------------------------------------------------------------------------
// The transform's handles

// Where image place (x, y) is shown: the turning handle, at TURN_REACH
// window pixels outside the middle of the box's top edge.
fn turnHandle(app: *App, t: *const Transformer, m: *const Matrix, x: *f64, y: *f64) -> void {
    var u: f64 = 0.0
    var v: f64 = 0.0
    handleSource(t, 1, &u, &v)
    const top = transform.apply(m, u, v)
    handleSource(t, 5, &u, &v)
    const foot = transform.apply(m, u, v)
    var tx: f64 = 0.0
    var ty: f64 = 0.0
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    windowOf(app, top.x, top.y, &tx, &ty)
    windowOf(app, foot.x, foot.y, &fx, &fy)
    var ux = tx - fx
    var uy = ty - fy
    const length = @sqrt(ux * ux + uy * uy)
    if length > 0.000001 {
        ux /= length
        uy /= length
    } else {
        ux = 0.0
        uy = -1.0
    }
    const reach_out = TURN_REACH * float(if app.*.scale > 0 { app.*.scale } else { 1 })
    x.* = tx + ux * reach_out
    y.* = ty + uy * reach_out
    const doc = api.document(app)
    if doc != null { viewport.toImage(&doc.?.*.view, x.*, y.*, x, y) }
}

// The outline of what is transformed, as a polygon of image places into
// `points` (24 doubles at least); how many points.
fn outlineOf(t: *const Transformer, points: [*]f64) -> usize {
    if t.*.mode == MODE_WARP {
        const order = [12]usize{ 0, 1, 2, 3, 7, 11, 15, 14, 13, 12, 8, 4 }
        var index: usize = 0
        while index < 12 {
            points[index * 2] = t.*.grid[order[index] * 2]
            points[index * 2 + 1] = t.*.grid[order[index] * 2 + 1]
            index += 1
        }
        return 12
    }
    if t.*.mode == MODE_PERSPECTIVE {
        var index: usize = 0
        while index < 8 {
            points[index] = t.*.quad[index]
            index += 1
        }
        return 4
    }
    const m = freeMatrix(t)
    var corner: usize = 0
    while corner < 4 {
        var u: f64 = 0.0
        var v: f64 = 0.0
        handleSource(t, corner * 2, &u, &v)
        const at = transform.apply(&m, u, v)
        points[corner * 2] = at.x
        points[corner * 2 + 1] = at.y
        corner += 1
    }
    return 4
}

// What a press at `input` takes hold of (PART_*), and which (`index`).
fn partAt(app: *App, t: *const Transformer, input: *const Input, index: *usize) -> u8 {
    const near_enough = grab(app)
    index.* = 0
    var best = near_enough
    var part = PART_NONE
    if t.*.mode == MODE_FREE {
        const m = freeMatrix(t)
        var handle: usize = 0
        while handle < 8 {
            var u: f64 = 0.0
            var v: f64 = 0.0
            handleSource(t, handle, &u, &v)
            const at = transform.apply(&m, u, v)
            const distance = reach(app, input, at.x, at.y)
            if distance <= best {
                best = distance
                part = PART_SCALE
                index.* = handle
            }
            handle += 1
        }
        if part != PART_NONE { return part }
        var x: f64 = 0.0
        var y: f64 = 0.0
        turnHandle(app, t, &m, &x, &y)
        if reach(app, input, x, y) <= near_enough { return PART_ROTATE }
        const pivot = transform.apply(&m, t.*.pivotX, t.*.pivotY)
        if reach(app, input, pivot.x, pivot.y) <= near_enough { return PART_PIVOT }
    } else if t.*.mode == MODE_PERSPECTIVE {
        var corner: usize = 0
        while corner < 4 {
            const distance = reach(app, input, t.*.quad[corner * 2], t.*.quad[corner * 2 + 1])
            if distance <= best {
                best = distance
                part = PART_CORNER
                index.* = corner
            }
            corner += 1
        }
        if part != PART_NONE { return part }
    } else {
        var point: usize = 0
        while point < POINTS {
            const distance = reach(app, input, t.*.grid[point * 2], t.*.grid[point * 2 + 1])
            if distance <= best {
                best = distance
                part = PART_POINT
                index.* = point
            }
            point += 1
        }
        if part != PART_NONE { return part }
    }
    var points: [24]f64 = undefined
    const count = outlineOf(t, &points)
    if insidePolygon(&points, count, input.*.x, input.*.y) { return PART_MOVE }
    return if t.*.mode == MODE_FREE { PART_ROTATE } else { PART_NONE }
}

fn transformActivate(app: *App) -> void {
    const t = transformerOf(app)
    if t == null { return }
    t.?.*.mode = modeOf(settings.text(app, KEY_TRANSFORM_MODE), t.?.*.mode)
    t.?.*.filter = filterOf(settings.text(app, KEY_TRANSFORM_FILTER), t.?.*.filter)
    t.?.*.idleImage = 0
}

// Another tool is chosen: what changed is applied, what did not is
// dropped.
fn transformDeactivate(app: *App) -> void {
    const t = transformerOf(app)
    if t == null { return }
    if t.?.*.lifted && t.?.*.changed {
        apply(app, t.?)
    } else {
        drop(app, t.?)
    }
}

fn transformPress(app: *App, input: *const Input) -> void {
    const t = transformerOf(app)
    if t == null || input.*.button != ui_app.BUTTON_LEFT || t.?.*.dragging { return }
    settleTransform(app, t.?)
    if !lift(app, t.?) { return }
    var index: usize = 0
    var part = partAt(app, t.?, input, &index)
    // Control on a corner: that corner alone, in perspective.
    if part == PART_SCALE && index % 2 == 0 && input.*.modifiers & keys.CONTROL != 0 {
        if !t.?.*.temporary {
            t.?.*.modeBefore = t.?.*.mode
            t.?.*.temporary = true
        }
        setMode(app, t.?, MODE_PERSPECTIVE, false)
        part = PART_CORNER
        index = index / 2
    }
    if part == PART_NONE { return }
    t.?.*.part = part
    t.?.*.index = index
    t.?.*.pressX = input.*.x
    t.?.*.pressY = input.*.y
    t.?.*.startTx = t.?.*.tx
    t.?.*.startTy = t.?.*.ty
    t.?.*.startRotation = t.?.*.rotation
    t.?.*.startSx = t.?.*.sx
    t.?.*.startSy = t.?.*.sy
    var copied: usize = 0
    while copied < 32 {
        t.?.*.startPoints[copied] = if t.?.*.mode == MODE_PERSPECTIVE && copied < 8 { t.?.*.quad[copied] } else { t.?.*.grid[copied] }
        copied += 1
    }
    const m = freeMatrix(t.?)
    if part == PART_SCALE {
        var u: f64 = 0.0
        var v: f64 = 0.0
        handleSource(t.?, (index + 4) % 8, &u, &v)
        const anchor = transform.apply(&m, u, v)
        handleSource(t.?, index, &u, &v)
        const handle = transform.apply(&m, u, v)
        t.?.*.anchorX = anchor.x
        t.?.*.anchorY = anchor.y
        t.?.*.handleX = handle.x
        t.?.*.handleY = handle.y
    } else if part == PART_ROTATE || part == PART_PIVOT {
        const pivot = transform.apply(&m, t.?.*.pivotX, t.?.*.pivotY)
        t.?.*.anchorX = pivot.x
        t.?.*.anchorY = pivot.y
        t.?.*.handleX = pivot.x
        t.?.*.handleY = pivot.y
        t.?.*.startAngle = math.atan2(input.*.y - pivot.y, input.*.x - pivot.x)
    }
    t.?.*.dragging = true
}

fn transformMotion(app: *App, input: *const Input) -> void {
    const t = transformerOf(app)
    if t == null { return }
    if !t.?.*.dragging {
        // What would be taken is lit.
        var index: usize = 0
        var part = PART_NONE
        if showing(app, t.?) { part = partAt(app, t.?, input, &index) }
        t.?.*.hover = part
        t.?.*.hoverIndex = index
        return
    }
    if frontImage(app, t.?.*.image) == null { return }
    const dx = input.*.x - t.?.*.pressX
    const dy = input.*.y - t.?.*.pressY
    const part = t.?.*.part
    const index = t.?.*.index
    const keep = input.*.modifiers & keys.SHIFT != 0
    if part == PART_MOVE {
        if t.?.*.mode == MODE_FREE {
            t.?.*.tx = held(t.?.*.startTx + dx, -FAR, FAR)
            t.?.*.ty = held(t.?.*.startTy + dy, -FAR, FAR)
        } else {
            const count: usize = if t.?.*.mode == MODE_PERSPECTIVE { 4 } else { POINTS }
            var point: usize = 0
            while point < count {
                const x = held(t.?.*.startPoints[point * 2] + dx, -FAR, FAR)
                const y = held(t.?.*.startPoints[point * 2 + 1] + dy, -FAR, FAR)
                if t.?.*.mode == MODE_PERSPECTIVE {
                    t.?.*.quad[point * 2] = x
                    t.?.*.quad[point * 2 + 1] = y
                } else {
                    t.?.*.grid[point * 2] = x
                    t.?.*.grid[point * 2 + 1] = y
                }
                point += 1
            }
        }
    } else if part == PART_SCALE {
        scaleTo(t.?, t.?.*.handleX + dx, t.?.*.handleY + dy, keep)
    } else if part == PART_ROTATE {
        const angle = math.atan2(input.*.y - t.?.*.anchorY, input.*.x - t.?.*.anchorX)
        var turned = t.?.*.startRotation + angle - t.?.*.startAngle
        if keep { turned = math.round(turned / TURN_STEP) * TURN_STEP }
        t.?.*.rotation = normalAngle(turned)
        placeFixed(t.?, t.?.*.pivotX, t.?.*.pivotY, t.?.*.anchorX, t.?.*.anchorY)
    } else if part == PART_PIVOT {
        // Only the place it turns about moves: nothing to make again.
        const m = freeMatrix(t.?)
        var back: Matrix = undefined
        if transform.invert(&m, &back) {
            const at = transform.apply(&back, t.?.*.handleX + dx, t.?.*.handleY + dy)
            t.?.*.pivotX = held(at.x, -FAR, FAR)
            t.?.*.pivotY = held(at.y, -FAR, FAR)
        }
        api.canvasChanged(app)
        return
    } else if part == PART_CORNER {
        const was_x = t.?.*.quad[index * 2]
        const was_y = t.?.*.quad[index * 2 + 1]
        t.?.*.quad[index * 2] = held(t.?.*.startPoints[index * 2] + dx, -FAR, FAR)
        t.?.*.quad[index * 2 + 1] = held(t.?.*.startPoints[index * 2 + 1] + dy, -FAR, FAR)
        // A corner may not go where no perspective brings it (a quad that
        // is not convex): it stays at the last place that was.
        var check: Matrix = undefined
        const quad = quadOf(t.?)
        if !transform.toQuad(t.?.*.origin, &quad, &check) {
            t.?.*.quad[index * 2] = was_x
            t.?.*.quad[index * 2 + 1] = was_y
            return
        }
    } else if part == PART_POINT {
        t.?.*.grid[index * 2] = held(t.?.*.startPoints[index * 2] + dx, -FAR, FAR)
        t.?.*.grid[index * 2 + 1] = held(t.?.*.startPoints[index * 2 + 1] + dy, -FAR, FAR)
    }
    t.?.*.changed = true
    render(app, t.?, true)
}

fn transformRelease(app: *App, input: *const Input) -> void {
    const t = transformerOf(app)
    if t == null || !t.?.*.dragging { return }
    t.?.*.dragging = false
    if t.?.*.part != PART_PIVOT && t.?.*.changed { render(app, t.?, false) }
    api.redraw(app)
}

fn transformFinish(app: *App) -> void {
    const t = transformerOf(app)
    if t == null { return }
    apply(app, t.?)
}

fn transformCancel(app: *App) -> void {
    const t = transformerOf(app)
    if t == null { return }
    drop(app, t.?)
}

fn transformBusy(app: *App) -> bool {
    const t = transformerOf(app)
    return t != null && t.?.*.lifted
}

fn lit(t: *const Transformer, part: u8, index: usize) -> bool {
    if t.*.dragging { return t.*.part == part && t.*.index == index }
    return t.*.hover == part && t.*.hoverIndex == index
}

fn transformOverlay(app: *App, canvas: *Canvas) -> void {
    const t = transformerOf(app)
    if t == null || !showing(app, t.?) { return }
    const marks = overlay.begin(app, canvas)
    var points: [32]f64 = undefined
    if t.?.*.mode == MODE_WARP {
        // The grid's rows and columns.
        var line: usize = 0
        while line < GRID {
            var at: usize = 0
            while at < GRID {
                points[at * 2] = t.?.*.grid[(line * GRID + at) * 2]
                points[at * 2 + 1] = t.?.*.grid[(line * GRID + at) * 2 + 1]
                points[8 + at * 2] = t.?.*.grid[(at * GRID + line) * 2]
                points[8 + at * 2 + 1] = t.?.*.grid[(at * GRID + line) * 2 + 1]
                at += 1
            }
            overlay.polyline(&marks, &points, GRID, false)
            const column: [*]const f64 = &points
            overlay.polyline(&marks, column + 8, GRID, false)
            line += 1
        }
        var point: usize = 0
        while point < POINTS {
            overlay.handle(&marks, t.?.*.grid[point * 2], t.?.*.grid[point * 2 + 1], overlay.ROUND, lit(t.?, PART_POINT, point))
            point += 1
        }
        return
    }
    const count = outlineOf(t.?, &points)
    overlay.polyline(&marks, &points, count, true)
    if t.?.*.mode == MODE_PERSPECTIVE {
        var corner: usize = 0
        while corner < 4 {
            overlay.handle(&marks, t.?.*.quad[corner * 2], t.?.*.quad[corner * 2 + 1], overlay.DIAMOND, lit(t.?, PART_CORNER, corner))
            corner += 1
        }
        return
    }
    const m = freeMatrix(t.?)
    var u: f64 = 0.0
    var v: f64 = 0.0
    handleSource(t.?, 1, &u, &v)
    const top = transform.apply(&m, u, v)
    var x: f64 = 0.0
    var y: f64 = 0.0
    turnHandle(app, t.?, &m, &x, &y)
    overlay.line(&marks, top.x, top.y, x, y)
    overlay.handle(&marks, x, y, overlay.ROUND, lit(t.?, PART_ROTATE, 0))
    var handle: usize = 0
    while handle < 8 {
        handleSource(t.?, handle, &u, &v)
        const at = transform.apply(&m, u, v)
        overlay.handle(&marks, at.x, at.y, overlay.SQUARE, lit(t.?, PART_SCALE, handle))
        handle += 1
    }
    const pivot = transform.apply(&m, t.?.*.pivotX, t.?.*.pivotY)
    overlay.cross(&marks, pivot.x, pivot.y)
    // While it is dragged: its size, or its angle.
    if t.?.*.dragging && (t.?.*.part == PART_SCALE || t.?.*.part == PART_ROTATE) {
        var text: [48]u8 = undefined
        const bytes: [*]u8 = &text
        var length: usize = 0
        if t.?.*.part == PART_SCALE {
            length = sizeText(whole(t.?.*.sx * float(t.?.*.origin.width)), whole(t.?.*.sy * float(t.?.*.origin.height)), bytes)
        } else {
            length = kit_module.formatNumber(t.?.*.rotation * 180.0 / math.pi, 1, bytes)
            length = std.text.append(bytes, length, 48, "\xC2\xB0")
        }
        overlay.label(&marks, points[4], points[5], bytes[0..length])
    }
}

// The options' numbers from the transform as it is.
fn refreshFields(t: *Transformer) -> void {
    const m = freeMatrix(t)
    const corner = transform.apply(&m, float(t.*.origin.x), float(t.*.origin.y))
    t.*.fields[0] = corner.x
    t.*.fields[1] = corner.y
    t.*.fields[2] = t.*.sx * float(t.*.origin.width)
    t.*.fields[3] = t.*.sy * float(t.*.origin.height)
    t.*.fields[4] = t.*.rotation * 180.0 / math.pi
    t.*.fields[5] = math.atan(t.*.shear) * 180.0 / math.pi
}

// A number of the options typed or stepped: field `which` is `value` now.
fn applyField(app: *App, t: *Transformer, which: usize, value: f64) -> void {
    if !lift(app, t) || t.*.mode != MODE_FREE { return }
    const m = freeMatrix(t)
    const corner = transform.apply(&m, float(t.*.origin.x), float(t.*.origin.y))
    const pivot = transform.apply(&m, t.*.pivotX, t.*.pivotY)
    if which == 0 {
        t.*.tx = held(t.*.tx + value - corner.x, -FAR, FAR)
    } else if which == 1 {
        t.*.ty = held(t.*.ty + value - corner.y, -FAR, FAR)
    } else if which == 2 || which == 3 {
        // The top left corner stays.
        if which == 2 { t.*.sx = usableScale(value / float(t.*.origin.width), t.*.origin.width) }
        if which == 3 { t.*.sy = usableScale(value / float(t.*.origin.height), t.*.origin.height) }
        placeFixed(t, float(t.*.origin.x), float(t.*.origin.y), corner.x, corner.y)
    } else {
        // Turns and shears keep the pivot where it is.
        if which == 4 { t.*.rotation = normalAngle(held(value, -360.0, 360.0) * math.pi / 180.0) }
        if which == 5 { t.*.shear = math.tan(held(value, -80.0, 80.0) * math.pi / 180.0) }
        placeFixed(t, t.*.pivotX, t.*.pivotY, pivot.x, pivot.y)
    }
    t.*.changed = true
    render(app, t, false)
}

fn modeIcon(mode: u8) -> u16 {
    if mode == MODE_PERSPECTIVE { return icons.PERSPECTIVE }
    if mode == MODE_WARP { return icons.WARP }
    return icons.FREE_TRANSFORM
}

fn modeTitle(app: *App, mode: u8) -> []const u8 {
    if mode == MODE_PERSPECTIVE { return state.tr(app, "Perspective", "Perspektive") }
    if mode == MODE_WARP { return state.tr(app, "Warp", "Verzerren") }
    return state.tr(app, "Free", "Frei")
}

// The filters the options offer (all but the box, which is for
// shrinking).
fn filterName(context: usize, index: usize) -> []const u8 {
    return transform.filterTitle(@intCast(u8, if index < 4 { index } else { 1 }), context != 0)
}

fn transformOptions(app: *App, area: ui.Rect) -> i32 {
    const t = transformerOf(app)
    if t == null { return 0 }
    const kit = api.kit(app)
    const s = if app.*.scale > 0 { app.*.scale } else { 1 }
    var rows = rowsIn(app, area)
    const there = showing(app, t.?)
    // The modes.
    const buttons = nextRow(&rows, rows.row + 4 * s)
    var mode: u8 = 0
    while mode < @intCast(u8, MODES) {
        const button = ui.rect(buttons.x + @intCast(i32, mode) * (buttons.height + 4 * s), buttons.y, buttons.height, buttons.height)
        if kit_module.toolButton(kit, optionId(TRANSFORM, ITEM_MODE + @intCast(usize, mode)), button, icons.drawFor, @intCast(usize, modeIcon(mode)), t.?.*.mode == mode, modeTitle(app, mode)) {
            setMode(app, t.?, mode, true)
        }
        mode += 1
    }
    const after = buttons.x + 3 * (buttons.height + 4 * s) + 4 * s
    kit_module.label(kit, ui.rect(after, buttons.y, ui.right(buttons) - after, buttons.height), modeTitle(app, t.?.*.mode), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    divide(&rows, kit)
    // The numbers: in two columns where there is room.
    if there { refreshFields(t.?) } else {
        var clear: usize = 0
        while clear < 6 {
            t.?.*.fields[clear] = 0.0
            clear += 1
        }
    }
    const disabled = !there || t.?.*.mode != MODE_FREE
    var place = kit_module.sliderOptions(-FAR, FAR, 1.0, 1)
    place.suffix = " px"
    place.disabled = disabled
    var angle = kit_module.sliderOptions(-360.0, 360.0, 1.0, 2)
    angle.suffix = "\xC2\xB0"
    angle.disabled = disabled
    var skew = kit_module.sliderOptions(-80.0, 80.0, 1.0, 2)
    skew.suffix = "\xC2\xB0"
    skew.disabled = disabled
    const two = area.width >= 300 * s
    const gap = 8 * s
    const column = if two { (area.width - gap) / 2 } else { area.width }
    const label_width = labelWidth(app, state.tr(app, "Angle", "Winkel"), state.tr(app, "Skew", "Scherung"), "W")
    var field: usize = 0
    var line = ui.rect(0, 0, 0, 0)
    while field < 6 {
        if !two || field % 2 == 0 { line = nextRow(&rows, rows.row) }
        const left = if two && field % 2 == 1 { line.x + column + gap } else { line.x }
        const cell = ui.rect(left, line.y, column, line.height)
        var text: []const u8 = "X"
        if field == 1 { text = "Y" }
        if field == 2 { text = state.tr(app, "W", "B") }
        if field == 3 { text = "H" }
        if field == 4 { text = state.tr(app, "Angle", "Winkel") }
        if field == 5 { text = state.tr(app, "Skew", "Scherung") }
        const box = labelled(app, kit, cell, text, label_width)
        const options = if field == 4 { &angle } else if field == 5 { &skew } else { &place }
        if kit_module.spinBox(kit, optionId(TRANSFORM, ITEM_X + field), box, &t.?.*.fields[field], options) {
            applyField(app, t.?, field, t.?.*.fields[field])
        }
        field += 1
    }
    // The filter Enter applies with.
    const filter_row = labelled(app, kit, nextRow(&rows, rows.row), state.tr(app, "Filter", "Filter"), label_width)
    var chosen: usize = @intCast(usize, if t.?.*.filter < 4 { t.?.*.filter } else { transform.BICUBIC })
    if kit_module.comboBoxWith(kit, optionId(TRANSFORM, ITEM_FILTER), filter_row, 4, filterName, if app.*.german { 1 } else { 0 }, &chosen) {
        t.?.*.filter = @intCast(u8, chosen)
        _ = settings.setText(app, KEY_TRANSFORM_FILTER, filterKey(t.?.*.filter))
    }
    // Apply and cancel.
    divide(&rows, kit)
    const actions = nextRow(&rows, rows.row)
    const half = (actions.width - gap) / 2
    const off: u8 = if t.?.*.lifted { 0 } else { kit_module.BUTTON_DISABLED }
    if kit_module.button(kit, optionId(TRANSFORM, ITEM_APPLY), ui.rect(actions.x, actions.y, half, actions.height), state.tr(app, "Apply", "Anwenden"), kit_module.BUTTON_PRIMARY | off) { apply(app, t.?) }
    if kit_module.button(kit, optionId(TRANSFORM, ITEM_CANCEL), ui.rect(actions.x + half + gap, actions.y, actions.width - half - gap, actions.height), state.tr(app, "Cancel", "Abbrechen"), kit_module.BUTTON_NORMAL | off) { drop(app, t.?) }
    rows.y += rows.gap
    note(&rows, kit, state.tr(app, "Shift: in proportion, or in 15\xC2\xB0 steps", "Umschalt: proportional, oder in 15\xC2\xB0-Schritten"))
    note(&rows, kit, state.tr(app, "Ctrl+drag a corner: perspective", "Strg+Ecke ziehen: Perspektive"))
    return usedHeight(&rows)
}

// ---------------------------------------------------------------------------
// Crop

const Cropper = struct {
    loaded: bool
    // A rectangle is there (Enter crops to it), on this image.
    has: bool
    image: usize
    rect: Rect
    // A drag: what it holds (PART_NEW, PART_MOVE, PART_SCALE and the
    // handle), where it began, the rectangle then.
    dragging: bool
    part: u8
    index: usize
    pressX: f64
    pressY: f64
    start: Rect
    hover: u8
    hoverIndex: usize
    // The options: a fixed ratio of width to height, a fixed size, the
    // rectangle may reach beyond the image, only the active layer is
    // cropped.
    ratio: bool
    ratioWidth: f64
    ratioHeight: f64
    fixed: bool
    fixedWidth: f64
    fixedHeight: f64
    grow: bool
    layerOnly: bool
    // The rectangle's numbers as the options show them.
    fields: [4]f64
}

fn readCropSettings(app: *App, c: *Cropper) -> void {
    c.*.ratio = settingOn(app, KEY_CROP_RATIO, c.*.ratio)
    c.*.ratioWidth = settingNumber(app, KEY_CROP_RATIO_WIDTH, c.*.ratioWidth, 0.01, 10000.0)
    c.*.ratioHeight = settingNumber(app, KEY_CROP_RATIO_HEIGHT, c.*.ratioHeight, 0.01, 10000.0)
    c.*.fixed = settingOn(app, KEY_CROP_SIZE, c.*.fixed)
    c.*.fixedWidth = settingNumber(app, KEY_CROP_SIZE_WIDTH, c.*.fixedWidth, 1.0, 32768.0)
    c.*.fixedHeight = settingNumber(app, KEY_CROP_SIZE_HEIGHT, c.*.fixedHeight, 1.0, 32768.0)
    c.*.grow = settingOn(app, KEY_CROP_GROW, c.*.grow)
    c.*.layerOnly = settingOn(app, KEY_CROP_LAYER, c.*.layerOnly)
}

fn cropperOf(app: *App) -> ?*Cropper {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, CROP), @sizeOf(Cropper))
    if memory == null { return null }
    const c: *Cropper = unsafe { @ptrCast(*Cropper, memory.?) }
    if !c.*.loaded {
        c.*.loaded = true
        c.*.ratioWidth = 3.0
        c.*.ratioHeight = 2.0
        c.*.fixedWidth = 640.0
        c.*.fixedHeight = 480.0
        readCropSettings(app, c)
    }
    return c
}

// A rectangle of the other document, or of an image no longer open, is
// forgotten.
fn settleCrop(app: *App, c: *Cropper) -> ?*Image {
    const image = frontImage(app, c.*.image)
    if image == null {
        c.*.has = false
        c.*.dragging = false
    }
    return image
}

// The rectangle between edges left .. right and top .. bottom (in any
// order), at least a pixel each way, held to the image (unless it may
// grow beyond) and to the largest image there may be.
fn cropRect(c: *const Cropper, image: *Image, left: i32, top: i32, right: i32, bottom: i32) -> Rect {
    var x0 = smaller(left, right)
    var x1 = larger(left, right)
    var y0 = smaller(top, bottom)
    var y1 = larger(top, bottom)
    if !c.*.grow {
        x0 = geom.clampInt(x0, 0, image.*.width - 1)
        y0 = geom.clampInt(y0, 0, image.*.height - 1)
        x1 = geom.clampInt(x1, x0 + 1, image.*.width)
        y1 = geom.clampInt(y1, y0 + 1, image.*.height)
    }
    if x1 <= x0 { x1 = x0 + 1 }
    if y1 <= y0 { y1 = y0 + 1 }
    if x1 - x0 > image_module.LARGEST { x1 = x0 + image_module.LARGEST }
    if y1 - y0 > image_module.LARGEST { y1 = y0 + image_module.LARGEST }
    return geom.rect(x0, y0, x1 - x0, y1 - y0)
}

// `area` moved (not resized) to lie inside the image as far as it can.
fn keptInside(c: *const Cropper, image: *Image, area: Rect) -> Rect {
    if c.*.grow { return area }
    const x = geom.clampInt(area.x, 0, larger(image.*.width - area.width, 0))
    const y = geom.clampInt(area.y, 0, larger(image.*.height - area.height, 0))
    return cropRect(c, image, x, y, x + area.width, y + area.height)
}

// The height a width has in the fixed ratio.
fn ratioHeightOf(c: *const Cropper, width: i32) -> i32 {
    return larger(whole(float(width) * c.*.ratioHeight / c.*.ratioWidth), 1)
}

fn ratioWidthOf(c: *const Cropper, height: i32) -> i32 {
    return larger(whole(float(height) * c.*.ratioWidth / c.*.ratioHeight), 1)
}

// What a press at `input` takes hold of: a handle, the rectangle (to
// move it), or nothing (a new one is made).
fn cropPartAt(app: *App, c: *const Cropper, input: *const Input, index: *usize) -> u8 {
    index.* = 0
    if !c.*.has { return PART_NEW }
    var best = grab(app)
    var part = PART_NEW
    var handle: usize = 0
    while handle < 8 {
        const x = float(c.*.rect.x) + float(c.*.rect.width) * HANDLE_U[handle]
        const y = float(c.*.rect.y) + float(c.*.rect.height) * HANDLE_V[handle]
        const distance = reach(app, input, x, y)
        if distance <= best {
            best = distance
            part = PART_SCALE
            index.* = handle
        }
        handle += 1
    }
    if part != PART_NEW { return part }
    if geom.contains(c.*.rect, wholeFloor(input.*.x), wholeFloor(input.*.y)) { return PART_MOVE }
    return PART_NEW
}

fn cropActivate(app: *App) -> void {
    const c = cropperOf(app)
    if c == null { return }
    readCropSettings(app, c.?)
}

fn cropForget(app: *App) -> void {
    const c = cropperOf(app)
    if c == null { return }
    c.?.*.has = false
    c.?.*.dragging = false
    api.canvasChanged(app)
}

fn cropPress(app: *App, input: *const Input) -> void {
    const c = cropperOf(app)
    const image = api.image(app)
    if c == null || image == null || input.*.button != ui_app.BUTTON_LEFT || c.?.*.dragging { return }
    if settleCrop(app, c.?) == null { c.?.*.image = @intFromPtr(image.?) }
    var index: usize = 0
    var part = cropPartAt(app, c.?, input, &index)
    const x = wholeFloor(input.*.x)
    const y = wholeFloor(input.*.y)
    if part == PART_NEW {
        c.?.*.image = @intFromPtr(image.?)
        if c.?.*.fixed {
            // A rectangle of the fixed size at the press, moved by the drag.
            c.?.*.rect = keptInside(c.?, image.?, cropRect(c.?, image.?, x, y, x + whole(c.?.*.fixedWidth), y + whole(c.?.*.fixedHeight)))
            part = PART_MOVE
        } else {
            c.?.*.rect = cropRect(c.?, image.?, x, y, x + 1, y + 1)
        }
        c.?.*.has = true
    }
    c.?.*.part = part
    c.?.*.index = index
    c.?.*.pressX = input.*.x
    c.?.*.pressY = input.*.y
    c.?.*.start = c.?.*.rect
    c.?.*.dragging = true
}

fn cropMotion(app: *App, input: *const Input) -> void {
    const c = cropperOf(app)
    if c == null { return }
    const image = settleCrop(app, c.?)
    if !c.?.*.dragging {
        var index: usize = 0
        var part = PART_NONE
        if image != null && c.?.*.has { part = cropPartAt(app, c.?, input, &index) }
        c.?.*.hover = part
        c.?.*.hoverIndex = index
        return
    }
    if image == null { return }
    const start = c.?.*.start
    const dx = whole(input.*.x - c.?.*.pressX)
    const dy = whole(input.*.y - c.?.*.pressY)
    if c.?.*.part == PART_NEW {
        // From the pixel pressed to the one under the pointer, both in.
        const x0 = wholeFloor(c.?.*.pressX)
        const y0 = wholeFloor(c.?.*.pressY)
        var x1 = wholeFloor(input.*.x)
        var y1 = wholeFloor(input.*.y)
        x1 = if x1 >= x0 { x1 + 1 } else { x1 }
        y1 = if y1 >= y0 { y1 + 1 } else { y1 }
        if c.?.*.ratio {
            const height = ratioHeightOf(c.?, if x1 > x0 { x1 - x0 } else { x0 + 1 - x1 })
            y1 = if y1 > y0 { y0 + height } else { y0 + 1 - height }
            c.?.*.rect = cropRect(c.?, image.?, if x1 > x0 { x0 } else { x0 + 1 }, if y1 > y0 { y0 } else { y0 + 1 }, x1, y1)
        } else {
            c.?.*.rect = cropRect(c.?, image.?, if x1 > x0 { x0 } else { x0 + 1 }, if y1 > y0 { y0 } else { y0 + 1 }, x1, y1)
        }
    } else if c.?.*.part == PART_MOVE {
        c.?.*.rect = keptInside(c.?, image.?, geom.moved(start, dx, dy))
    } else if c.?.*.part == PART_SCALE {
        const handle = c.?.*.index
        var left = start.x
        var top = start.y
        var right = geom.right(start)
        var bottom = geom.bottom(start)
        if HANDLE_U[handle] == 0.0 { left += dx }
        if HANDLE_U[handle] == 1.0 { right += dx }
        if HANDLE_V[handle] == 0.0 { top += dy }
        if HANDLE_V[handle] == 1.0 { bottom += dy }
        if c.?.*.ratio {
            // The side dragged decides, the other follows from the
            // opposite edge (or, for a middle handle, about the middle).
            if HANDLE_U[handle] != 0.5 {
                const height = ratioHeightOf(c.?, if right > left { right - left } else { left - right })
                if HANDLE_V[handle] == 0.0 { top = bottom - height } else if HANDLE_V[handle] == 1.0 { bottom = top + height } else {
                    top = start.y + start.height / 2 - height / 2
                    bottom = top + height
                }
            } else {
                const width = ratioWidthOf(c.?, if bottom > top { bottom - top } else { top - bottom })
                left = start.x + start.width / 2 - width / 2
                right = left + width
            }
        }
        if c.?.*.fixed {
            c.?.*.rect = keptInside(c.?, image.?, geom.moved(start, dx, dy))
        } else {
            c.?.*.rect = cropRect(c.?, image.?, left, top, right, bottom)
        }
    }
    api.canvasChanged(app)
}

fn cropRelease(app: *App, input: *const Input) -> void {
    const c = cropperOf(app)
    if c == null || !c.?.*.dragging { return }
    c.?.*.dragging = false
    // A click that made no rectangle makes none.
    if c.?.*.part == PART_NEW && wholeFloor(input.*.x) == wholeFloor(c.?.*.pressX) && wholeFloor(input.*.y) == wholeFloor(c.?.*.pressY) { c.?.*.has = false }
    api.redraw(app)
}

fn cropBusy(app: *App) -> bool {
    const c = cropperOf(app)
    return c != null && c.?.*.has
}

// Every device of the tree under `node` (not a clone's: that is the
// place of what it shows against its source, which moves itself) moved
// by (dx, dy), each a part of the step that is open.
fn shiftForCrop(image: *Image, node: *Node, dx: i32, dy: i32, name: []const u8) -> void {
    if node.*.device != null && node.*.kind != node_module.CLONE && ops.beginPixels(image, node) {
        device_module.moveBy(node.*.device.?, dx, dy)
        _ = ops.endPixels(image, node, name)
    }
    for child in node.*.children.items() {
        shiftForCrop(image, child, dx, dy, name)
    }
}

// The image cropped to `area`: its size, every layer's place and the
// selection's, as one step.
fn cropImage(app: *App, image: *Image, area: Rect) -> void {
    const name = state.tr(app, "Crop", "Zuschneiden")
    const history = image.*.history
    history_module.begin(history, name)
    shiftForCrop(image, image.*.root, -area.x, -area.y, name)
    if image.*.selected {
        ops.beginSelection(image)
        device_module.moveBy(image.*.selection, -area.x, -area.y)
        _ = selection_module.clip(image.*.selection, geom.rect(0, 0, area.width, area.height))
        ops.endSelection(image, true, name)
    }
    history_module.geometry(history, name, image.*.width, image.*.height, image.*.resolution, area.width, area.height, image.*.resolution)
    history_module.end(history)
    // As the history's own undo and redo do it: the projection starts
    // over, and so does whoever shows it.
    image.*.width = area.width
    image.*.height = area.height
    device_module.clear(image.*.projection)
    image_module.damageAll(image)
    image.*.updateSerial += 17
    image_module.touch(image)
    // What was at the rectangle stays where it is in the window.
    const doc = api.document(app)
    if doc != null && @intFromPtr(doc.?.*.image) == @intFromPtr(image) {
        doc.?.*.view.centerX -= float(area.x)
        doc.?.*.view.centerY -= float(area.y)
    }
}

// The active layer cleared outside `area`: one step.
fn cropLayer(app: *App, image: *Image, area: Rect) -> void {
    const node = api.paintable(app)
    if node == null { return }
    const layer = node.?.*.device.?
    const extent = device_module.extent(layer)
    if !ops.beginPixels(image, node.?) { return }
    device_module.clearRect(layer, geom.rect(extent.x, extent.y, extent.width, area.y - extent.y))
    device_module.clearRect(layer, geom.rect(extent.x, geom.bottom(area), extent.width, geom.bottom(extent) - geom.bottom(area)))
    device_module.clearRect(layer, geom.rect(extent.x, area.y, area.x - extent.x, area.height))
    device_module.clearRect(layer, geom.rect(geom.right(area), area.y, geom.right(extent) - geom.right(area), area.height))
    api.imageChanged(app, ops.endPixels(image, node.?, state.tr(app, "Crop layer", "Ebene zuschneiden")))
}

fn cropFinish(app: *App) -> void {
    const c = cropperOf(app)
    if c == null { return }
    const image = settleCrop(app, c.?)
    if image == null || !c.?.*.has { return }
    var area = c.?.*.rect
    if !c.?.*.grow { area = geom.intersect(area, image_module.bounds(image.?)) }
    c.?.*.has = false
    c.?.*.dragging = false
    if geom.isEmpty(area) { return }
    if c.?.*.layerOnly {
        cropLayer(app, image.?, area)
    } else if !geom.same(area, image_module.bounds(image.?)) {
        cropImage(app, image.?, area)
    }
    api.layersChanged(app)
}

fn cropOverlay(app: *App, canvas: *Canvas) -> void {
    const c = cropperOf(app)
    if c == null || settleCrop(app, c.?) == null || !c.?.*.has { return }
    const doc = api.document(app)
    if doc == null { return }
    const area = c.?.*.rect
    const share = overlay.shared(app)
    // Outside the rectangle the picture is darker (an upright view only:
    // a turned one has no rectangles of the window to darken).
    if share != null && canvas.*.device == 0 && canvas.*.width > 0 && viewport.isUpright(&doc.?.*.view) {
        const clip = share.?.*.clip
        var x0: f64 = 0.0
        var y0: f64 = 0.0
        var x1: f64 = 0.0
        var y1: f64 = 0.0
        viewport.toWindow(&doc.?.*.view, float(area.x), float(area.y), &x0, &y0)
        viewport.toWindow(&doc.?.*.view, float(geom.right(area)), float(geom.bottom(area)), &x1, &y1)
        const left = wholeFloor(x0 + 0.5)
        const top = wholeFloor(y0 + 0.5)
        const right = wholeFloor(x1 + 0.5)
        const bottom = wholeFloor(y1 + 0.5)
        const pieces = [4]Rect{
            geom.rect(clip.x, clip.y, clip.width, top - clip.y),
            geom.rect(clip.x, bottom, clip.width, geom.bottom(clip) - bottom),
            geom.rect(clip.x, top, left - clip.x, bottom - top),
            geom.rect(right, top, geom.right(clip) - right, bottom - top),
        }
        var piece: usize = 0
        while piece < 4 {
            const shade = geom.intersect(pieces[piece], clip)
            if !geom.isEmpty(shade) {
                canvas_module.fillRect(canvas, shade.x, shade.y, shade.width, shade.height, CROP_SHADE)
                share.?.*.bounds = geom.unite(share.?.*.bounds, shade)
            }
            piece += 1
        }
    }
    const marks = overlay.begin(app, canvas)
    const x = float(area.x)
    const y = float(area.y)
    const width = float(area.width)
    const height = float(area.height)
    // The thirds, faint: a grey half seen through, on light and dark
    // pictures alike.
    const thirds = canvas_module.color(110, 128, 128, 128)
    var third: usize = 1
    while third < 3 {
        const part = float(@intCast(i32, third)) / 3.0
        overlay.plainLine(&marks, x + width * part, y, x + width * part, y + height, thirds)
        overlay.plainLine(&marks, x, y + height * part, x + width, y + height * part, thirds)
        third += 1
    }
    overlay.rect(&marks, x, y, width, height)
    var handle: usize = 0
    while handle < 8 {
        const active = if c.?.*.dragging { c.?.*.part == PART_SCALE && c.?.*.index == handle } else { c.?.*.hover == PART_SCALE && c.?.*.hoverIndex == handle }
        overlay.handle(&marks, x + width * HANDLE_U[handle], y + height * HANDLE_V[handle], overlay.SQUARE, active)
        handle += 1
    }
    var text: [48]u8 = undefined
    const bytes: [*]u8 = &text
    const length = sizeText(area.width, area.height, bytes)
    overlay.label(&marks, x + width, y + height, bytes[0..length])
}

fn cropOptions(app: *App, area: ui.Rect) -> i32 {
    const c = cropperOf(app)
    if c == null { return 0 }
    const kit = api.kit(app)
    const s = if app.*.scale > 0 { app.*.scale } else { 1 }
    const image = settleCrop(app, c.?)
    var rows = rowsIn(app, area)
    const gap = 8 * s
    const middle = 14 * s
    const half = (area.width - middle) / 2
    // A ratio, or a size: one or the other.
    if kit_module.checkBox(kit, optionId(CROP, ITEM_RATIO), nextRow(&rows, rows.row), state.tr(app, "Fixed ratio", "Festes Seitenverhältnis"), &c.?.*.ratio) {
        if c.?.*.ratio && c.?.*.fixed {
            c.?.*.fixed = false
            keepOn(app, KEY_CROP_SIZE, false)
        }
        if c.?.*.ratio && c.?.*.has && image != null { c.?.*.rect = cropRect(c.?, image.?, c.?.*.rect.x, c.?.*.rect.y, geom.right(c.?.*.rect), c.?.*.rect.y + ratioHeightOf(c.?, c.?.*.rect.width)) }
        keepOn(app, KEY_CROP_RATIO, c.?.*.ratio)
    }
    var ratio_options = kit_module.sliderOptions(0.01, 10000.0, 1.0, 2)
    ratio_options.disabled = !c.?.*.ratio
    var line = nextRow(&rows, rows.row)
    if kit_module.spinBox(kit, optionId(CROP, ITEM_RATIO_WIDTH), ui.rect(line.x, line.y, half, line.height), &c.?.*.ratioWidth, &ratio_options) { keepNumber(app, KEY_CROP_RATIO_WIDTH, c.?.*.ratioWidth) }
    kit_module.label(kit, ui.rect(line.x + half, line.y, middle, line.height), ":", kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
    if kit_module.spinBox(kit, optionId(CROP, ITEM_RATIO_HEIGHT), ui.rect(line.x + half + middle, line.y, line.width - half - middle, line.height), &c.?.*.ratioHeight, &ratio_options) { keepNumber(app, KEY_CROP_RATIO_HEIGHT, c.?.*.ratioHeight) }
    if kit_module.checkBox(kit, optionId(CROP, ITEM_SIZE), nextRow(&rows, rows.row), state.tr(app, "Fixed size", "Feste Größe"), &c.?.*.fixed) {
        if c.?.*.fixed && c.?.*.ratio {
            c.?.*.ratio = false
            keepOn(app, KEY_CROP_RATIO, false)
        }
        if c.?.*.fixed && c.?.*.has && image != null { c.?.*.rect = keptInside(c.?, image.?, cropRect(c.?, image.?, c.?.*.rect.x, c.?.*.rect.y, c.?.*.rect.x + whole(c.?.*.fixedWidth), c.?.*.rect.y + whole(c.?.*.fixedHeight))) }
        keepOn(app, KEY_CROP_SIZE, c.?.*.fixed)
    }
    var size_options = kit_module.sliderOptions(1.0, 32768.0, 1.0, 0)
    size_options.suffix = " px"
    size_options.disabled = !c.?.*.fixed
    line = nextRow(&rows, rows.row)
    if kit_module.spinBox(kit, optionId(CROP, ITEM_SIZE_WIDTH), ui.rect(line.x, line.y, half, line.height), &c.?.*.fixedWidth, &size_options) { keepNumber(app, KEY_CROP_SIZE_WIDTH, c.?.*.fixedWidth) }
    kit_module.label(kit, ui.rect(line.x + half, line.y, middle, line.height), "\xC3\x97", kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
    if kit_module.spinBox(kit, optionId(CROP, ITEM_SIZE_HEIGHT), ui.rect(line.x + half + middle, line.y, line.width - half - middle, line.height), &c.?.*.fixedHeight, &size_options) { keepNumber(app, KEY_CROP_SIZE_HEIGHT, c.?.*.fixedHeight) }
    divide(&rows, kit)
    if kit_module.checkBox(kit, optionId(CROP, ITEM_GROW), nextRow(&rows, rows.row), state.tr(app, "Grow the canvas if needed", "Leinwand bei Bedarf vergrößern"), &c.?.*.grow) { keepOn(app, KEY_CROP_GROW, c.?.*.grow) }
    if kit_module.checkBox(kit, optionId(CROP, ITEM_LAYER), nextRow(&rows, rows.row), state.tr(app, "Crop only the active layer", "Nur die aktive Ebene zuschneiden"), &c.?.*.layerOnly) { keepOn(app, KEY_CROP_LAYER, c.?.*.layerOnly) }
    // The rectangle's numbers.
    divide(&rows, kit)
    const there = c.?.*.has && image != null
    c.?.*.fields[0] = if there { float(c.?.*.rect.x) } else { 0.0 }
    c.?.*.fields[1] = if there { float(c.?.*.rect.y) } else { 0.0 }
    c.?.*.fields[2] = if there { float(c.?.*.rect.width) } else { 0.0 }
    c.?.*.fields[3] = if there { float(c.?.*.rect.height) } else { 0.0 }
    var place = kit_module.sliderOptions(-1000000.0, 1000000.0, 1.0, 0)
    place.suffix = " px"
    place.disabled = !there
    const two = area.width >= 220 * s
    const column = if two { (area.width - gap) / 2 } else { area.width }
    const label_width = labelWidth(app, "X", "Y", state.tr(app, "W", "B"))
    var field: usize = 0
    while field < 4 {
        if !two || field % 2 == 0 { line = nextRow(&rows, rows.row) }
        const left = if two && field % 2 == 1 { line.x + column + gap } else { line.x }
        var text: []const u8 = "X"
        if field == 1 { text = "Y" }
        if field == 2 { text = state.tr(app, "W", "B") }
        if field == 3 { text = "H" }
        const box = labelled(app, kit, ui.rect(left, line.y, column, line.height), text, label_width)
        if kit_module.spinBox(kit, optionId(CROP, ITEM_X + field), box, &c.?.*.fields[field], &place) && there {
            const value = whole(c.?.*.fields[field])
            const now = c.?.*.rect
            if field == 0 { c.?.*.rect = keptInside(c.?, image.?, geom.rect(value, now.y, now.width, now.height)) }
            if field == 1 { c.?.*.rect = keptInside(c.?, image.?, geom.rect(now.x, value, now.width, now.height)) }
            if field == 2 { c.?.*.rect = cropRect(c.?, image.?, now.x, now.y, now.x + value, geom.bottom(now)) }
            if field == 3 { c.?.*.rect = cropRect(c.?, image.?, now.x, now.y, geom.right(now), now.y + value) }
            api.canvasChanged(app)
        }
        field += 1
    }
    const actions = nextRow(&rows, rows.row)
    const button = (actions.width - gap) / 2
    const off: u8 = if there { 0 } else { kit_module.BUTTON_DISABLED }
    if kit_module.button(kit, optionId(CROP, ITEM_APPLY), ui.rect(actions.x, actions.y, button, actions.height), state.tr(app, "Crop", "Zuschneiden"), kit_module.BUTTON_PRIMARY | off) { cropFinish(app) }
    if kit_module.button(kit, optionId(CROP, ITEM_CANCEL), ui.rect(actions.x + button + gap, actions.y, actions.width - button - gap, actions.height), state.tr(app, "Cancel", "Abbrechen"), kit_module.BUTTON_NORMAL | off) { cropForget(app) }
    return usedHeight(&rows)
}

// ---------------------------------------------------------------------------
// The tools

const TOOLS = [3]state.Tool{
    state.Tool.{ .id = MOVE, .key = "move", .name = "Move", .german = "Verschieben", .shortcut = "T", .icon = icons.TOOL_MOVE, .group = state.GROUP_TRANSFORM, .cursor = state.CURSOR_ARROW, .activate = moveActivate, .deactivate = moveCancel, .press = movePress, .move = moveMotion, .release = moveRelease, .keyPress = moveKey, .tick = null, .overlay = moveOverlay, .options = moveOptions, .cancel = moveCancel, .finish = null, .busy = moveBusy },
    state.Tool.{ .id = TRANSFORM, .key = "transform", .name = "Transform", .german = "Transformieren", .shortcut = "Ctrl+T", .icon = icons.TOOL_TRANSFORM, .group = state.GROUP_TRANSFORM, .cursor = state.CURSOR_ARROW, .activate = transformActivate, .deactivate = transformDeactivate, .press = transformPress, .move = transformMotion, .release = transformRelease, .keyPress = null, .tick = null, .overlay = transformOverlay, .options = transformOptions, .cancel = transformCancel, .finish = transformFinish, .busy = transformBusy },
    state.Tool.{ .id = CROP, .key = "crop", .name = "Crop", .german = "Zuschneiden", .shortcut = "C", .icon = icons.TOOL_CROP, .group = state.GROUP_TRANSFORM, .cursor = state.CURSOR_CROSS, .activate = cropActivate, .deactivate = cropForget, .press = cropPress, .move = cropMotion, .release = cropRelease, .keyPress = null, .tick = null, .overlay = cropOverlay, .options = cropOptions, .cancel = cropForget, .finish = cropFinish, .busy = cropBusy },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Tool {
    if kept.address != 0 { return table.rows(state.Tool, &kept) }
    return table.keep(state.Tool, &kept, TOOLS[0..])
}
