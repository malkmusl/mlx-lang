// nebula tools: shapes painted onto the active layer: Rectangle (with
// round corners by an option), Ellipse, Polygon, Polyline, Bézier Curve,
// Freehand Path and Star.
//
// How each is made:
//
//   Rectangle, Ellipse  dragged from corner to corner. The rectangle is
//                       one of whole pixels: from the pixel pressed to
//                       the pixel let go, both in it (the ellipse lies
//                       in it). Shift makes a square or a circle (as
//                       large as the larger side), Alt grows it around
//                       the pixel pressed. A click without a drag paints
//                       nothing.
//   Star                dragged from its middle: the pointer's distance
//                       is the tips' radius, its direction that of the
//                       first tip (Shift: in steps of 15 degrees).
//   Polygon, Polyline   a click (or a press, dragged to where it goes) is
//                       a corner; Enter or a double click ends the shape,
//                       a click on the first corner closes a polygon;
//                       Backspace takes the last corner back. Shift holds
//                       a line to steps of 45 degrees.
//   Bézier Curve        a click is an anchor; pressing and dragging pulls
//                       its handles out (the one behind mirrors the one
//                       ahead); Enter or a double click ends the curve,
//                       a click on the first anchor closes it.
//   Freehand Path       the pointer's way while the button is down,
//                       smoothed (the Smoothing option); closed when it
//                       is filled.
//
// For all of them Space held while the button is down moves the shape,
// Escape (and choosing another tool) drops it, and the shape shows as an
// outline over the canvas
// (ui/overlay.mlx) until it is done. Then it is painted: filled and
// outlined, at full strength, onto a plane of its own that becomes the
// layer's overlay (core/node.mlx) and is merged into the layer with the
// options' opacity and blend mode through ops.mergeOverlay: ONE step of
// the history, named after the shape ("Rectangle" / "Rechteck"), only
// where the selection lets it, keeping alpha where the layer's alpha is
// locked. What lies outside the image is not painted (it would not be
// seen, and a shape dragged far out at a small zoom could be vast).
//
// The options (one set for all shape tools, kept between runs as the text
// "tool.shapes" of app/settings.mlx; at the very first run the brush's
// size, opacity and blend mode are the defaults):
//
//   Fill          none, the foreground or the background colour
//   Outline       none, the foreground or the background colour; its
//                 width, corners (core/raster.mlx's joins), ends (caps)
//                 and dashes; or painted as a stroke of the brush in use
//                 (brush/stroke.mlx along the outline)
//   Opacity, blending, smooth edges (anti-aliasing)
//   Corner radius (Rectangle), tips and inner radius (Star), smoothing
//   (Freehand Path)
//
// A rectangle's and an ellipse's outline lies inside the shape (its outer
// edge is the shape's edge: a frame of the width set in the pixels
// dragged); the outline of the others is centred on their lines. An open
// shape (a polyline, a curve not closed, a freehand path not filled) has
// no inside: it is drawn by its outline, in the fill's colour or else the
// foreground's when the outline is set to none.
//
// The tools keep what they share in the slot of the Rectangle
// (state.SLOT_TOOL + RECTANGLE): the options, the gesture in progress and
// the paths it is built into. Others reach the options so:
//
//     const options = shapes.optionsOf(app).?
//     options.*.outline = shapes.PAINT_FOREGROUND
//     options.*.width = 3.0
//     shapes.saveOptions(app)              // kept between runs
//
// Not done: filling with a pattern; options of each tool's own (one set
// serves all); shapes stay pixels (no vector layer keeps them to be
// edited later); a polygon's or curve's points cannot be dragged once
// placed; a new shape's fill is not shown before it is painted (only its
// outline).
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const brushes = @import("../app/brushes.mlx")
const settings = @import("../app/settings.mlx")
const kit_module = @import("../ui/kit.mlx")
const overlay = @import("../ui/overlay.mlx")
const viewport = @import("../ui/viewport.mlx")
const icons = @import("../ui/icons.mlx")
const raster = @import("../core/raster.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const ops = @import("../core/ops.mlx")
const blend = @import("../core/blend.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")
const stroke_module = @import("../brush/stroke.mlx")

pub const App = state.App
pub const Input = state.Input
pub const Canvas = state.Canvas

// The tools' ids (shapes have 10-19).
pub const RECTANGLE: u8 = 10
pub const ELLIPSE: u8 = 11
pub const POLYGON: u8 = 12
pub const POLYLINE: u8 = 13
pub const BEZIER: u8 = 14
pub const FREEHAND_PATH: u8 = 15
pub const STAR: u8 = 16

// What fills a shape and what draws its outline (Options.fill, .outline).
pub const PAINT_NONE: usize = 0
pub const PAINT_FOREGROUND: usize = 1
pub const PAINT_BACKGROUND: usize = 2
const PAINTS: usize = 3

// An outline's dashes (Options.dashes); their lengths go with its width.
pub const DASH_SOLID: usize = 0
pub const DASH_DASHED: usize = 1
pub const DASH_DOTTED: usize = 2
pub const DASH_DASH_DOT: usize = 3
const DASH_KINDS: usize = 4

// The ranges of the options.
pub const THINNEST: f64 = 0.1
pub const WIDEST: f64 = 1000.0
pub const FEWEST_TIPS: f64 = 3.0
pub const MOST_TIPS: f64 = 20.0
const LARGEST_RADIUS: f64 = 10000.0

// The settings' text the options are kept in.
const KEPT: []const u8 = "tool.shapes"

// A freehand path keeps no more points than this (one each pixel of the
// way at most), and is smoothed over at most this many pixels of its way
// on either side of a point.
const MOST_POINTS: usize = 200000
const SMOOTHEST: f64 = 25.0
// The brush is led along an outline in steps of this many pixels (it
// spaces its dabs itself), and the points are this many milliseconds a
// pixel apart (an even speed for brushes that listen to it).
const BRUSH_STEP: f64 = 2.0
const BRUSH_PACE: f64 = 2.0
// A click this close (window pixels) to a polygon's first corner closes
// it.
const CLOSE_REACH: f64 = 6.0
const HALF_PI: f64 = 1.5707963267948966
const DEGREES_15: f64 = 0.2617993877991494
const DEGREES_45: f64 = 0.7853981633974483

// Rows of the list of blend modes (the menu's order, a heading before
// each category: ROW_HEADING with the category's number).
const ROWS: usize = 160
const ROW_HEADING: u16 = 0x8000

// The parts of the options panel (their ids are view.idOf of the panel's,
// view.id("nebula.shapes.options"), and PART_*).
const PART_FILL: usize = 1
const PART_OUTLINE: usize = 2
const PART_WIDTH: usize = 3
const PART_JOIN: usize = 4
const PART_CAP: usize = 5
const PART_DASHES: usize = 6
const PART_BRUSH: usize = 7
const PART_OPACITY: usize = 8
const PART_BLEND: usize = 9
const PART_SMOOTH: usize = 10
const PART_RADIUS: usize = 11
const PART_TIPS: usize = 12
const PART_RATIO: usize = 13
const PART_SMOOTHING: usize = 14

// What the shape tools paint with: what the options panel shows.
pub const Options = struct {
    fill: usize
    outline: usize
    // The outline's width in pixels, its corners (raster.JOIN_*), its
    // open ends (raster.CAP_*), its dashes (DASH_*).
    width: f64
    join: usize
    cap: usize
    dashes: usize
    // The outline is a stroke of the brush in use (its width is the
    // brush's then).
    useBrush: bool
    antialias: bool
    // 0-100, and core/blend.mlx's mode.
    opacity: f64
    mode: u16
    // The rectangle's corner radius in pixels (0: square corners).
    radius: f64
    // The star's tips, and how far its inner corners are from its middle
    // (a percentage of the tips' distance).
    tips: f64
    ratio: f64
    // How much a freehand path is smoothed, 0-100.
    smoothing: f64
}

// The shared record (state.SLOT_TOOL + RECTANGLE).
const Shapes = struct {
    ready: bool
    options: Options
    // The panel's sliders, and its list of blend modes.
    widthRange: kit_module.SliderOptions
    opacityRange: kit_module.SliderOptions
    radiusRange: kit_module.SliderOptions
    tipsRange: kit_module.SliderOptions
    ratioRange: kit_module.SliderOptions
    smoothingRange: kit_module.SliderOptions
    rows: [160]u16
    rowCount: usize
    german: bool
    // The gesture in progress: of which tool, on which image, whether the
    // button is down (`dragging`) and whether Space moves the shape.
    tool: u8
    active: bool
    dragging: bool
    moving: bool
    image: usize
    // Shift and Alt as they are held now.
    modifiers: u32
    // A drag's first and last place (image coordinates).
    startX: f64
    startY: f64
    endX: f64
    endY: f64
    // Where the pointer is (the line to the next corner goes there), on
    // the image and in the window.
    pointerX: f64
    pointerY: f64
    pointerWindowX: i32
    pointerWindowY: i32
    // A polygon's corners (x and y in turn), a curve's anchors (x, y and
    // the handle ahead: four numbers each), a freehand path's points.
    points: std.ArrayList(f64)
    // A curve closed by a click on its first anchor.
    closedCurve: bool
    // The paths a shape and its outline are built into (raster.Path, made
    // at the first asking), and the brush's stroke (brush/stroke.mlx).
    path: usize
    outlinePath: usize
    stroke: usize
}

// ---------------------------------------------------------------------------
// The record

fn shapesOf(app: *App) -> ?*Shapes {
    const memory = state.slot(app, state.SLOT_TOOL + @intCast(usize, RECTANGLE), @sizeOf(Shapes))
    if memory == null { return null }
    const s: *Shapes = unsafe { @ptrCast(*Shapes, memory.?) }
    if !s.*.ready { prepare(app, s) }
    return s
}

fn prepare(app: *App, s: *Shapes) -> void {
    s.*.points = std.ArrayList(f64).init(app.*.allocator)
    s.*.path = 0
    s.*.outlinePath = 0
    s.*.stroke = 0
    s.*.active = false
    s.*.dragging = false
    s.*.moving = false
    s.*.closedCurve = false
    defaults(app, &s.*.options)
    load(app, &s.*.options)
    s.*.widthRange = kit_module.sliderOptions(THINNEST, WIDEST, 1.0, 1)
    s.*.widthRange.exponent = 3.0
    s.*.widthRange.softLow = THINNEST
    s.*.widthRange.softHigh = 200.0
    s.*.widthRange.suffix = " px"
    s.*.opacityRange = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    s.*.opacityRange.suffix = " %"
    s.*.radiusRange = kit_module.sliderOptions(0.0, LARGEST_RADIUS, 1.0, 0)
    s.*.radiusRange.exponent = 3.0
    s.*.radiusRange.softLow = 0.0
    s.*.radiusRange.softHigh = 500.0
    s.*.radiusRange.suffix = " px"
    s.*.tipsRange = kit_module.sliderOptions(FEWEST_TIPS, MOST_TIPS, 1.0, 0)
    s.*.ratioRange = kit_module.sliderOptions(5.0, 95.0, 1.0, 0)
    s.*.ratioRange.suffix = " %"
    s.*.smoothingRange = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    s.*.smoothingRange.suffix = " %"
    // The modes in the menu's order, a heading before each category.
    var count: usize = 0
    var category: u8 = 255
    var index: usize = 0
    while index < blend.listedCount() && count + 2 <= ROWS {
        const mode = blend.listed(index)
        const of = blend.category(mode)
        if of != category {
            s.*.rows[count] = ROW_HEADING | @intCast(u16, of)
            count += 1
            category = of
        }
        s.*.rows[count] = mode
        count += 1
        index += 1
    }
    s.*.rowCount = count
    s.*.ready = true
}

// The options as at the very first run: a shape filled with the
// foreground colour, no outline, the brush's size, opacity and blend mode.
fn defaults(app: *App, into: *Options) -> void {
    const brush = brushes.current(app)
    into.*.fill = PAINT_FOREGROUND
    into.*.outline = PAINT_NONE
    into.*.width = held(brush.*.size, THINNEST, WIDEST, 4.0)
    into.*.join = @intCast(usize, raster.JOIN_MITER)
    into.*.cap = @intCast(usize, raster.CAP_BUTT)
    into.*.dashes = DASH_SOLID
    into.*.useBrush = false
    into.*.antialias = true
    into.*.opacity = held(brush.*.opacity * 100.0, 0.0, 100.0, 100.0)
    into.*.mode = brush.*.blend
    into.*.radius = 0.0
    into.*.tips = 5.0
    into.*.ratio = 50.0
    into.*.smoothing = 30.0
}

// `value` held to low..high; `otherwise` for what is no number.
fn held(value: f64, low: f64, high: f64, otherwise: f64) -> f64 {
    if !(value == value) { return otherwise }
    if value < low { return low }
    if value > high { return high }
    return value
}

fn heldChoice(value: usize, count: usize) -> usize {
    return if value < count { value } else { 0 }
}

// Every option held to what it may be.
fn settle(into: *Options) -> void {
    into.*.fill = heldChoice(into.*.fill, PAINTS)
    into.*.outline = heldChoice(into.*.outline, PAINTS)
    into.*.width = held(into.*.width, THINNEST, WIDEST, 4.0)
    into.*.join = heldChoice(into.*.join, 3)
    into.*.cap = heldChoice(into.*.cap, 3)
    into.*.dashes = heldChoice(into.*.dashes, DASH_KINDS)
    into.*.opacity = held(into.*.opacity, 0.0, 100.0, 100.0)
    into.*.radius = held(into.*.radius, 0.0, LARGEST_RADIUS, 0.0)
    into.*.tips = held(math.round(into.*.tips), FEWEST_TIPS, MOST_TIPS, 5.0)
    into.*.ratio = held(into.*.ratio, 5.0, 95.0, 50.0)
    into.*.smoothing = held(into.*.smoothing, 0.0, 100.0, 30.0)
}

// ---------------------------------------------------------------------------
// The options kept between runs: "fill=1 outline=0 width=400 ... blend=normal",
// the numbers in hundredths.

fn appendPair(into: [*]u8, at: usize, capacity: usize, key: []const u8, value: usize) -> usize {
    var length = at
    if length > 0 { length = std.text.appendByte(into, length, capacity, 32) }
    length = std.text.append(into, length, capacity, key)
    length = std.text.appendByte(into, length, capacity, 61)
    return std.text.appendUnsigned(into, length, capacity, value)
}

fn hundredths(value: f64) -> usize {
    return @intFromFloat(usize, held(value, 0.0, 10000000.0, 0.0) * 100.0 + 0.5)
}

// The options of the shape tools: read from the settings at the first
// asking (null without memory). Whoever changes them says saveOptions().
pub fn optionsOf(app: *App) -> ?*Options {
    const s = shapesOf(app)
    if s == null { return null }
    return &s.?.*.options
}

// The options are kept in the settings (written at once), held to their
// ranges first.
pub fn saveOptions(app: *App) -> void {
    const s = shapesOf(app)
    if s == null { return }
    const o = &s.?.*.options
    settle(o)
    var text: [400]u8 = undefined
    const bytes: [*]u8 = &text
    var length = appendPair(bytes, 0, 400, "fill", o.*.fill)
    length = appendPair(bytes, length, 400, "outline", o.*.outline)
    length = appendPair(bytes, length, 400, "width", hundredths(o.*.width))
    length = appendPair(bytes, length, 400, "join", o.*.join)
    length = appendPair(bytes, length, 400, "cap", o.*.cap)
    length = appendPair(bytes, length, 400, "dashes", o.*.dashes)
    length = appendPair(bytes, length, 400, "brush", if o.*.useBrush { 1 } else { 0 })
    length = appendPair(bytes, length, 400, "smooth", if o.*.antialias { 1 } else { 0 })
    length = appendPair(bytes, length, 400, "opacity", hundredths(o.*.opacity))
    length = appendPair(bytes, length, 400, "radius", hundredths(o.*.radius))
    length = appendPair(bytes, length, 400, "tips", hundredths(o.*.tips))
    length = appendPair(bytes, length, 400, "ratio", hundredths(o.*.ratio))
    length = appendPair(bytes, length, 400, "smoothing", hundredths(o.*.smoothing))
    length = std.text.append(bytes, length, 400, " blend=")
    length = std.text.append(bytes, length, 400, blend.name(o.*.mode))
    _ = settings.setText(app, KEPT, bytes[0..length])
}

// The options read back from the settings (those the text does not name
// stay as they are).
pub fn loadOptions(app: *App) -> void {
    const s = shapesOf(app)
    if s == null { return }
    load(app, &s.?.*.options)
}

fn wholeNumber(text: []const u8, into: *usize) -> bool {
    if text.length == 0 || text.length > 12 { return false }
    var value: usize = 0
    for byte in text {
        if byte < 48 || byte > 57 { return false }
        value = value * 10 + @intCast(usize, byte - 48)
    }
    into.* = value
    return true
}

fn load(app: *App, into: *Options) -> void {
    const text = settings.text(app, KEPT)
    var at: usize = 0
    while at < text.length {
        while at < text.length && text[at] == 32 { at += 1 }
        var end = at
        while end < text.length && text[end] != 32 { end += 1 }
        const pair = text[at..end]
        at = end
        const equal = std.text.find(pair, "=")
        if equal >= pair.length { continue }
        const key = pair[0..equal]
        const value = pair[equal + 1..]
        if std.text.same(key, "blend") {
            into.*.mode = blend.byName(value)
            continue
        }
        var number: usize = 0
        if !wholeNumber(value, &number) { continue }
        const amount = @floatFromInt(f64, number) / 100.0
        if std.text.same(key, "fill") { into.*.fill = number }
        if std.text.same(key, "outline") { into.*.outline = number }
        if std.text.same(key, "width") { into.*.width = amount }
        if std.text.same(key, "join") { into.*.join = number }
        if std.text.same(key, "cap") { into.*.cap = number }
        if std.text.same(key, "dashes") { into.*.dashes = number }
        if std.text.same(key, "brush") { into.*.useBrush = number != 0 }
        if std.text.same(key, "smooth") { into.*.antialias = number != 0 }
        if std.text.same(key, "opacity") { into.*.opacity = amount }
        if std.text.same(key, "radius") { into.*.radius = amount }
        if std.text.same(key, "tips") { into.*.tips = amount }
        if std.text.same(key, "ratio") { into.*.ratio = amount }
        if std.text.same(key, "smoothing") { into.*.smoothing = amount }
    }
    settle(into)
}

// ---------------------------------------------------------------------------
// The gesture

fn pathOf(app: *App, s: *Shapes) -> ?*raster.Path {
    if s.*.path == 0 {
        const made = raster.create(app.*.allocator)
        if made == null { return null }
        s.*.path = @intFromPtr(made.?)
    }
    const path: *raster.Path = unsafe { @ptrFromInt(*raster.Path, s.*.path) }
    raster.clear(path)
    return path
}

fn outlinePathOf(app: *App, s: *Shapes) -> ?*raster.Path {
    if s.*.outlinePath == 0 {
        const made = raster.create(app.*.allocator)
        if made == null { return null }
        s.*.outlinePath = @intFromPtr(made.?)
    }
    const path: *raster.Path = unsafe { @ptrFromInt(*raster.Path, s.*.outlinePath) }
    raster.clear(path)
    return path
}

fn isDragShape(tool: u8) -> bool {
    return tool == RECTANGLE || tool == ELLIPSE || tool == STAR || tool == FREEHAND_PATH
}

fn isCornered(tool: u8) -> bool { return tool == POLYGON || tool == POLYLINE }

// How many numbers a placed point takes in `points`.
fn stride(tool: u8) -> usize { return if tool == BEZIER { 4 } else { 2 } }

fn placedCount(s: *Shapes) -> usize { return s.*.points.length / stride(s.*.tool) }

// The gesture is over: nothing is kept of it (a long freehand path's
// memory goes back).
fn reset(s: *Shapes) -> void {
    s.*.active = false
    s.*.dragging = false
    s.*.moving = false
    s.*.closedCurve = false
    if s.*.points.capacity > 16384 { s.*.points.clearAndFree() } else { s.*.points.clearRetainingCapacity() }
}

fn sameImage(app: *App, s: *Shapes) -> bool {
    const image = api.image(app)
    return image != null && @intFromPtr(image.?) == s.*.image
}

fn addPoint(s: *Shapes, x: f64, y: f64) -> bool {
    if !s.*.points.ensureUnusedCapacity(4) { return false }
    _ = s.*.points.append(x)
    _ = s.*.points.append(y)
    if s.*.tool == BEZIER {
        _ = s.*.points.append(x)
        _ = s.*.points.append(y)
    }
    return true
}

// A gesture of the tool in use starts at the pointer: false when the
// layer cannot be painted on (the status bar says why) or without memory.
fn start(app: *App, s: *Shapes, input: *const Input) -> bool {
    const image = api.image(app)
    if image == null || api.paintable(app) == null { return false }
    reset(s)
    s.*.tool = app.*.tool
    s.*.image = @intFromPtr(image.?)
    s.*.modifiers = input.*.modifiers & (keys.SHIFT | keys.ALT)
    s.*.startX = input.*.x
    s.*.startY = input.*.y
    s.*.endX = input.*.x
    s.*.endY = input.*.y
    s.*.pointerX = input.*.x
    s.*.pointerY = input.*.y
    s.*.pointerWindowX = input.*.windowX
    s.*.pointerWindowY = input.*.windowY
    if s.*.tool == STAR {
        // (Its middle in the middle of the pixel pressed: whole tips.)
        s.*.startX = @floor(input.*.x) + 0.5
        s.*.startY = @floor(input.*.y) + 0.5
    }
    s.*.active = true
    return true
}

// Whether (x, y) of the image is within CLOSE_REACH window pixels of the
// window place (wx, wy).
fn nearInWindow(app: *App, x: f64, y: f64, wx: i32, wy: i32) -> bool {
    const doc = api.document(app)
    if doc == null { return false }
    var px: f64 = 0.0
    var py: f64 = 0.0
    viewport.toWindow(&doc.?.*.view, x, y, &px, &py)
    const dx = px - (@floatFromInt(f64, wx) + 0.5)
    const dy = py - (@floatFromInt(f64, wy) + 0.5)
    const reach = CLOSE_REACH * @floatFromInt(f64, state.px(app, 1))
    return dx * dx + dy * dy <= reach * reach
}

fn press(app: *App, input: *const Input) -> void {
    const found = shapesOf(app)
    if found == null || input.*.button != ui_app.BUTTON_LEFT { return }
    const s = found.?
    if s.*.active && (s.*.tool != app.*.tool || !sameImage(app, s)) { reset(s) }
    s.*.pointerX = input.*.x
    s.*.pointerY = input.*.y
    s.*.pointerWindowX = input.*.windowX
    s.*.pointerWindowY = input.*.windowY
    if !s.*.active {
        if !start(app, s, input) { return }
        s.*.dragging = true
        if !isDragShape(s.*.tool) || s.*.tool == FREEHAND_PATH { _ = addPoint(s, input.*.x, input.*.y) }
        api.canvasChanged(app)
        return
    }
    if isDragShape(s.*.tool) { return }
    // A polygon, polyline or curve going on: a double click ends it, a
    // click on its first point closes it, any other click adds one.
    const count = placedCount(s)
    if input.*.clicks == 2 {
        finish(app)
        return
    }
    if count >= 2 && s.*.tool != POLYLINE && nearInWindow(app, s.*.points.pointer[0], s.*.points.pointer[1], input.*.windowX, input.*.windowY) {
        if s.*.tool == BEZIER { s.*.closedCurve = true }
        if s.*.tool == BEZIER || count >= 3 {
            finish(app)
            return
        }
    }
    var x = input.*.x
    var y = input.*.y
    if isCornered(s.*.tool) { snapped(s, &x, &y) }
    if !addPoint(s, x, y) { return }
    s.*.dragging = true
    api.canvasChanged(app)
}

// With Shift a corner goes from the one before it at a multiple of 45
// degrees, as far as the pointer is along that way.
fn snapped(s: *Shapes, x: *f64, y: *f64) -> void {
    if s.*.modifiers & keys.SHIFT == 0 { return }
    const count = s.*.points.length / 2
    if count == 0 { return }
    // (The corner being placed is the last one while the button is down.)
    const before = if s.*.dragging { count - 1 } else { count }
    if before == 0 { return }
    const fromX = s.*.points.pointer[(before - 1) * 2]
    const fromY = s.*.points.pointer[(before - 1) * 2 + 1]
    const dx = x.* - fromX
    const dy = y.* - fromY
    const length = @sqrt(dx * dx + dy * dy)
    if !(length > 0.0) { return }
    const angle = math.round(math.atan2(dy, dx) / DEGREES_45) * DEGREES_45
    const along = dx * math.cos(angle) + dy * math.sin(angle)
    x.* = fromX + along * math.cos(angle)
    y.* = fromY + along * math.sin(angle)
}

// Everything placed moves by (dx, dy).
fn shift(s: *Shapes, dx: f64, dy: f64) -> void {
    s.*.startX += dx
    s.*.startY += dy
    s.*.endX += dx
    s.*.endY += dy
    var index: usize = 0
    while index + 1 < s.*.points.length {
        s.*.points.pointer[index] += dx
        s.*.points.pointer[index + 1] += dy
        index += 2
    }
}

fn move(app: *App, input: *const Input) -> void {
    const found = shapesOf(app)
    if found == null { return }
    const s = found.?
    const dx = input.*.x - s.*.pointerX
    const dy = input.*.y - s.*.pointerY
    s.*.pointerX = input.*.x
    s.*.pointerY = input.*.y
    s.*.pointerWindowX = input.*.windowX
    s.*.pointerWindowY = input.*.windowY
    if !s.*.active || !s.*.dragging { return }
    if s.*.moving {
        shift(s, dx, dy)
        return
    }
    const tool = s.*.tool
    if tool == RECTANGLE || tool == ELLIPSE || tool == STAR {
        s.*.endX = input.*.x
        s.*.endY = input.*.y
    } else if tool == FREEHAND_PATH {
        const count = s.*.points.length
        if count >= 2 && count / 2 < MOST_POINTS {
            const lx = s.*.points.pointer[count - 2]
            const ly = s.*.points.pointer[count - 1]
            const ax = input.*.x - lx
            const ay = input.*.y - ly
            // (A point a pixel or more from the one before: the way at
            // the image's resolution.)
            if ax * ax + ay * ay >= 1.0 { _ = addPoint(s, input.*.x, input.*.y) }
        }
    } else if isCornered(tool) && s.*.points.length >= 2 {
        var x = input.*.x
        var y = input.*.y
        snapped(s, &x, &y)
        s.*.points.pointer[s.*.points.length - 2] = x
        s.*.points.pointer[s.*.points.length - 1] = y
    } else if tool == BEZIER && s.*.points.length >= 4 {
        s.*.points.pointer[s.*.points.length - 2] = input.*.x
        s.*.points.pointer[s.*.points.length - 1] = input.*.y
    }
}

fn release(app: *App, input: *const Input) -> void {
    const found = shapesOf(app)
    if found == null || input.*.button != ui_app.BUTTON_LEFT { return }
    const s = found.?
    if !s.*.active || !s.*.dragging { return }
    move(app, input)
    s.*.dragging = false
    s.*.moving = false
    if isDragShape(s.*.tool) { commit(app, s) }
}

fn keyPress(app: *App, code: u32, modifiers: u32, down: bool) -> bool {
    const found = shapesOf(app)
    if found == null || !found.?.*.active { return false }
    const s = found.?
    var bit: u32 = 0
    if code == keys.LEFT_SHIFT || code == keys.RIGHT_SHIFT { bit = keys.SHIFT }
    if code == keys.LEFT_ALT || code == keys.RIGHT_ALT { bit = keys.ALT }
    if bit != 0 {
        if down { s.*.modifiers |= bit } else { s.*.modifiers &= ~bit }
        api.canvasChanged(app)
        return true
    }
    if code == keys.SPACE && s.*.dragging {
        s.*.moving = down
        return true
    }
    if !down { return false }
    if code == keys.BACKSPACE && !s.*.dragging && !isDragShape(s.*.tool) {
        // The last point goes; with it the first, the gesture.
        const take = stride(s.*.tool)
        if s.*.points.length > take {
            s.*.points.length -= take
        } else {
            reset(s)
        }
        api.canvasChanged(app)
        return true
    }
    return false
}

fn cancel(app: *App) -> void {
    const found = shapesOf(app)
    if found == null || !found.?.*.active { return }
    reset(found.?)
    api.canvasChanged(app)
}

fn finish(app: *App) -> void {
    const found = shapesOf(app)
    if found == null || !found.?.*.active { return }
    commit(app, found.?)
}

fn busy(app: *App) -> bool {
    if !state.hasSlot(app, state.SLOT_TOOL + @intCast(usize, RECTANGLE)) { return false }
    const found = shapesOf(app)
    return found != null && found.?.*.active
}

// ---------------------------------------------------------------------------
// The shape as a path

// The rectangle a drag spans in whole pixels: from the pixel pressed to
// the one the pointer is on, both in it (Shift: a square of the larger
// side; Alt: around the pixel pressed). Its edges: right and bottom lie
// past the last pixel.
const Box = struct {
    left: f64
    top: f64
    right: f64
    bottom: f64
}

fn boxOf(s: *Shapes) -> Box {
    const x0 = @floor(s.*.startX)
    const y0 = @floor(s.*.startY)
    const x1 = @floor(s.*.endX)
    const y1 = @floor(s.*.endY)
    var wide = math.abs(x1 - x0)
    var high = math.abs(y1 - y0)
    if s.*.modifiers & keys.SHIFT != 0 {
        wide = math.max(wide, high)
        high = wide
    }
    if s.*.modifiers & keys.ALT != 0 {
        return Box.{ .left = x0 - wide, .top = y0 - high, .right = x0 + wide + 1.0, .bottom = y0 + high + 1.0 }
    }
    const left = if x1 < x0 { x0 - wide } else { x0 }
    const top = if y1 < y0 { y0 - high } else { y0 }
    return Box.{ .left = left, .top = top, .right = left + wide + 1.0, .bottom = top + high + 1.0 }
}

// A rectangle's corner radius as it is drawn: the option's, held to half
// the rectangle, and never under half an outline drawn inside it (whose
// outer corners are that round).
fn cornerRadius(s: *Shapes, box: Box, inset: f64) -> f64 {
    var radius = s.*.options.radius
    const most = math.min(box.right - box.left, box.bottom - box.top) * 0.5
    if radius > most { radius = most }
    if radius > 0.0 && radius < inset { radius = inset }
    return radius
}

// How far inside a rectangle or an ellipse its outline lies: half its
// width (the brush's size for a brush's outline). 0: no outline.
fn insetOf(app: *App, s: *Shapes, closed: bool) -> f64 {
    if !hasOutline(s, closed) { return 0.0 }
    if s.*.options.useBrush { return held(brushes.current(app).*.size, 0.0, WIDEST, 1.0) * 0.5 }
    return s.*.options.width * 0.5
}

fn hasOutline(s: *Shapes, closed: bool) -> bool {
    return s.*.options.outline != PAINT_NONE || !closed
}

// A freehand path's points smoothed into `into` (as many): each the mean
// of the points within a reach along the way (the Smoothing option's
// share of SMOOTHEST pixels), so that the smoothing does not depend on
// how often the pointer reported; the first and the last stay where they
// are. `along` (a number a point) and `sums` (two a point and two more)
// are working memory.
fn smoothed(s: *Shapes, into: [*]f64, along: [*]f64, sums: [*]f64) -> void {
    const points = s.*.points.pointer
    const count = s.*.points.length / 2
    if count == 0 { return }
    const reach = held(s.*.options.smoothing, 0.0, 100.0, 0.0) / 100.0 * SMOOTHEST
    // How far along the way each point is, and the sums of the points
    // before each (a stretch's sum is the difference of two).
    along[0] = 0.0
    sums[0] = 0.0
    sums[1] = 0.0
    var index: usize = 0
    while index < count {
        if index > 0 {
            const dx = points[index * 2] - points[index * 2 - 2]
            const dy = points[index * 2 + 1] - points[index * 2 - 1]
            along[index] = along[index - 1] + @sqrt(dx * dx + dy * dy)
        }
        sums[index * 2 + 2] = sums[index * 2] + points[index * 2]
        sums[index * 2 + 3] = sums[index * 2 + 1] + points[index * 2 + 1]
        index += 1
    }
    // The points from `low` to before `high` are within reach.
    var low: usize = 0
    var high: usize = 0
    index = 0
    while index < count {
        while along[low] < along[index] - reach { low += 1 }
        if high <= index { high = index + 1 }
        while high < count && along[high] <= along[index] + reach { high += 1 }
        const many = @floatFromInt(f64, high - low)
        into[index * 2] = (sums[high * 2] - sums[low * 2]) / many
        into[index * 2 + 1] = (sums[high * 2 + 1] - sums[low * 2 + 1]) / many
        index += 1
    }
    into[0] = points[0]
    into[1] = points[1]
    into[count * 2 - 2] = points[count * 2 - 2]
    into[count * 2 - 1] = points[count * 2 - 1]
}

// The star's tips as the options and the drag say into `path`; false
// for a drag shorter than a pixel.
fn starInto(s: *Shapes, path: *raster.Path) -> bool {
    const dx = s.*.endX - s.*.startX
    const dy = s.*.endY - s.*.startY
    const outer = @sqrt(dx * dx + dy * dy)
    if !(outer >= 1.0) { return false }
    // The first tip points at the pointer.
    var turn = math.atan2(dy, dx) + HALF_PI
    if s.*.modifiers & keys.SHIFT != 0 { turn = math.round(turn / DEGREES_15) * DEGREES_15 }
    const tips = @intFromFloat(usize, held(math.round(s.*.options.tips), FEWEST_TIPS, MOST_TIPS, 5.0))
    raster.star(path, s.*.startX, s.*.startY, tips, outer * held(s.*.options.ratio, 5.0, 95.0, 50.0) / 100.0, outer, turn)
    return true
}

// A curve's anchors as cubic pieces into `path` (from the pen at the
// first); `to_pointer`: and a piece on to the pointer.
fn curveInto(s: *Shapes, path: *raster.Path, to_pointer: bool) -> void {
    const points = s.*.points.pointer
    const count = s.*.points.length / 4
    if count == 0 { return }
    raster.moveTo(path, points[0], points[1])
    var index: usize = 1
    while index < count {
        const at = index * 4
        const before = at - 4
        // The handle behind an anchor mirrors the one ahead.
        raster.cubicTo(path, points[before + 2], points[before + 3], points[at] * 2.0 - points[at + 2], points[at + 1] * 2.0 - points[at + 3], points[at], points[at + 1])
        index += 1
    }
    const last = (count - 1) * 4
    if s.*.closedCurve && count > 1 {
        raster.cubicTo(path, points[last + 2], points[last + 3], points[0] * 2.0 - points[2], points[1] * 2.0 - points[3], points[0], points[1])
        raster.close(path)
    } else if to_pointer {
        raster.cubicTo(path, points[last + 2], points[last + 3], s.*.pointerX, s.*.pointerY, s.*.pointerX, s.*.pointerY)
    }
}

// The shape as it stands into `path` (`preview`: as the overlay shows it:
// with the line on to the pointer where a click would add a point, and a
// freehand path not yet smoothed). Whether it has an inside goes to
// `closed`. False: there is nothing to draw (yet), or no memory.
fn build(app: *App, s: *Shapes, path: *raster.Path, preview: bool, closed: *bool) -> bool {
    const tool = s.*.tool
    closed.* = true
    if tool == RECTANGLE || tool == ELLIPSE {
        const box = boxOf(s)
        if tool == ELLIPSE {
            raster.ellipse(path, (box.left + box.right) * 0.5, (box.top + box.bottom) * 0.5, (box.right - box.left) * 0.5, (box.bottom - box.top) * 0.5)
        } else {
            const radius = cornerRadius(s, box, insetOf(app, s, true))
            raster.roundedRect(path, box.left, box.top, box.right - box.left, box.bottom - box.top, radius, radius)
        }
    } else if tool == STAR {
        if !starInto(s, path) { return false }
    } else if isCornered(tool) {
        closed.* = tool == POLYGON
        const points = s.*.points.pointer
        const count = s.*.points.length / 2
        if count == 0 { return false }
        raster.moveTo(path, points[0], points[1])
        var index: usize = 1
        while index < count {
            raster.lineTo(path, points[index * 2], points[index * 2 + 1])
            index += 1
        }
        if preview && !s.*.dragging { raster.lineTo(path, s.*.pointerX, s.*.pointerY) }
        if closed.* { raster.close(path) }
    } else if tool == BEZIER {
        closed.* = s.*.closedCurve
        curveInto(s, path, preview && !s.*.dragging)
    } else {
        closed.* = s.*.options.fill != PAINT_NONE
        const count = s.*.points.length / 2
        if count == 0 { return false }
        if preview {
            raster.polyline(path, s.*.points.items())
        } else {
            const pool = scratch.common()
            const mark = scratch.mark(pool)
            const even = scratch.doubles(pool, count * 2)
            const along = scratch.doubles(pool, count)
            const sums = scratch.doubles(pool, count * 2 + 2)
            if even == null || along == null || sums == null {
                scratch.release(pool, mark)
                return false
            }
            smoothed(s, even.?, along.?, sums.?)
            raster.polyline(path, even.?[0..count * 2])
            scratch.release(pool, mark)
        }
        if closed.* { raster.close(path) }
    }
    return !raster.failed(path) && !raster.isEmpty(path)
}

// Where the outline of a rectangle or an ellipse is drawn: the shape
// `inset` inside its edge, into `into`. False when the outline would fill
// the shape whole (it is too narrow for its inside): the shape itself is
// then painted in the outline's colour.
fn insetInto(s: *Shapes, into: *raster.Path, inset: f64) -> bool {
    const box = boxOf(s)
    const left = box.left + inset
    const top = box.top + inset
    const right = box.right - inset
    const bottom = box.bottom - inset
    if !(right > left) || !(bottom > top) { return false }
    if s.*.tool == ELLIPSE {
        raster.ellipse(into, (left + right) * 0.5, (top + bottom) * 0.5, (right - left) * 0.5, (bottom - top) * 0.5)
    } else {
        // (roundedRect takes a radius's size, whatever its sign.)
        const radius = math.max(cornerRadius(s, box, inset) - inset, 0.0)
        raster.roundedRect(into, left, top, right - left, bottom - top, radius, radius)
    }
    return !raster.failed(into)
}

// The outline's style as the options say (`width` across).
fn styleOf(o: *const Options, width: f64, rounded: bool) -> raster.Stroke {
    var style = raster.solid(width)
    style.join = @intCast(u8, heldChoice(o.*.join, 3))
    if rounded { style.join = raster.JOIN_ROUND }
    style.cap = @intCast(u8, heldChoice(o.*.cap, 3))
    const unit = if width < 1.0 { 1.0 } else { width }
    if o.*.dashes == DASH_DASHED {
        style.dashes[0] = unit * 3.0
        style.dashes[1] = unit * 2.0
        style.dashCount = 2
    } else if o.*.dashes == DASH_DOTTED {
        style.dashes[0] = unit
        style.dashes[1] = unit
        style.dashCount = 2
    } else if o.*.dashes == DASH_DASH_DOT {
        style.dashes[0] = unit * 4.0
        style.dashes[1] = unit * 1.5
        style.dashes[2] = unit
        style.dashes[3] = unit * 1.5
        style.dashCount = 4
    }
    return style
}

// ---------------------------------------------------------------------------
// Painting

fn colorOf(app: *App, paint: usize) -> u32 {
    return if paint == PAINT_BACKGROUND { app.*.background } else { app.*.foreground }
}

fn historyName(app: *App, s: *Shapes) -> []const u8 {
    const tool = s.*.tool
    if tool == RECTANGLE {
        if s.*.options.radius > 0.0 { return state.tr(app, "Rounded rectangle", "Abgerundetes Rechteck") }
        return state.tr(app, "Rectangle", "Rechteck")
    }
    if tool == ELLIPSE { return state.tr(app, "Ellipse", "Ellipse") }
    if tool == POLYGON { return state.tr(app, "Polygon", "Polygon") }
    if tool == POLYLINE { return state.tr(app, "Polyline", "Polylinie") }
    if tool == BEZIER { return state.tr(app, "Bézier curve", "Bézierkurve") }
    if tool == FREEHAND_PATH { return state.tr(app, "Freehand path", "Freihandpfad") }
    return state.tr(app, "Star", "Stern")
}

// The pixels of `source` over those of `target` (normal blending). False
// without memory (nothing or not all of it is there then).
fn mergeInto(app: *App, target: *device_module.Device, source: *device_module.Device) -> bool {
    var tiles = std.ArrayList(u64).init(app.*.allocator)
    defer tiles.deinit()
    if !device_module.keys(source, &tiles) { return false }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const rows = scratch.words(pool, 4096)
    var whole = rows != null
    if rows != null {
        for key in tiles.items() {
            const tx = device_module.keyX(key)
            const ty = device_module.keyY(key)
            const pixels = device_module.tileRead(source, tx, ty)
            if pixels == null { continue }
            const area = device_module.tileArea(source, tx, ty)
            device_module.readRect(target, area, rows.?, 64)
            var row: usize = 0
            while row < 64 {
                blend.compositeSpan(blend.NORMAL, rows.? + row * 64, pixels.? + row * 64, 64, 255, null, 0)
                row += 1
            }
            if !device_module.writeRect(target, area, rows.?, 64) { whole = false }
        }
    }
    scratch.release(pool, mark)
    return whole
}

fn strokeOf(app: *App, s: *Shapes) -> ?*stroke_module.Stroke {
    if s.*.stroke == 0 {
        const made = stroke_module.create(app.*.allocator)
        if made == null { return null }
        s.*.stroke = @intFromPtr(made.?)
    }
    unsafe { return @ptrFromInt(*stroke_module.Stroke, s.*.stroke) }
}

// One side of a clip (Liang and Barsky): the part `from` .. `to` of a
// line that is within it narrowed where the line crosses it; false when
// nothing is left.
fn clipSide(p: f64, q: f64, from: *f64, to: *f64) -> bool {
    if p == 0.0 { return q >= 0.0 }
    const r = q / p
    if p < 0.0 {
        if r > to.* { return false }
        if r > from.* { from.* = r }
    } else {
        if r < from.* { return false }
        if r < to.* { to.* = r }
    }
    return true
}

// The part (`from` to `to`, shares of 0 to 1) of the line from (ax, ay)
// by (dx, dy) that lies in `area`; false: none of it.
fn clipLine(area: Box, ax: f64, ay: f64, dx: f64, dy: f64, from: *f64, to: *f64) -> bool {
    from.* = 0.0
    to.* = 1.0
    return clipSide(0.0 - dx, ax - area.left, from, to) && clipSide(dx, area.right - ax, from, to) && clipSide(0.0 - dy, ay - area.top, from, to) && clipSide(dy, area.bottom - ay, from, to) && to.* > from.*
}

// `line` painted as strokes of the brush in use, in `color`, over what
// `target` holds. The brush is led along the path's own lines a few
// pixels at a time (as raster.pointAt would place it, without walking the
// path from its start for every point), each sub-path a stroke of its
// own, and lifted where the path leaves the image (by more than the
// brush's size): what is outside is not painted, however far the shape
// reaches. False without memory.
fn brushAlong(app: *App, s: *Shapes, image: *image_module.Image, node: *node_module.Node, target: *device_module.Device, line: *raster.Path, color: u32) -> bool {
    const stroke = strokeOf(app, s)
    if stroke == null { return false }
    const plane = device_module.create(app.*.allocator, 0)
    if plane == null { return false }
    const aim = stroke_module.Target.{
        .image = image,
        .node = node,
        .device = plane.?,
        .direct = false,
        .foreground = color,
        .background = app.*.background,
        .selection = null,
        .alphaLock = false,
        .mirrorHorizontal = false,
        .axisX = 0.0,
        .mirrorVertical = false,
        .axisY = 0.0,
        .wrap = false,
        .seed = 1,
        .sample = null,
    }
    const brush = brushes.current(app)
    const margin = held(brush.*.size, 0.0, WIDEST * 10.0, 1.0) + 2.0
    const reach = Box.{ .left = 0.0 - margin, .top = 0.0 - margin, .right = @floatFromInt(f64, image.*.width) + margin, .bottom = @floatFromInt(f64, image.*.height) + margin }
    // One point, its fields set again for every place (not a new record
    // each time).
    var point = stroke_module.Point.{ .x = 0.0, .y = 0.0, .pressure = 1.0, .tiltX = 0.0, .tiltY = 0.0, .rotation = 0.0, .tangentialPressure = 0.0, .time = 0.0 }
    var travelled: f64 = 0.0
    var down = false
    var from: f64 = 0.0
    var to: f64 = 1.0
    const points = line.*.points.pointer
    var index: usize = 0
    while index < raster.contourCount(line) {
        const contour = raster.contourAt(line, index)
        index += 1
        if contour.count == 0 { continue }
        const first = contour.first * 2
        if contour.count == 1 && clipLine(reach, points[first], points[first + 1], 0.0, 0.0, &from, &to) {
            // A dot.
            point.x = points[first]
            point.y = points[first + 1]
            _ = stroke_module.begin(stroke.?, &aim, brush, &point)
            _ = stroke_module.end(stroke.?)
        }
        const ends = if contour.closed { contour.count + 1 } else { contour.count }
        var at: usize = 1
        while at < ends {
            const start = first + (at - 1) * 2
            const finish_at = if at < contour.count { first + at * 2 } else { first }
            const ax = points[start]
            const ay = points[start + 1]
            const dx = points[finish_at] - ax
            const dy = points[finish_at + 1] - ay
            const length = @sqrt(dx * dx + dy * dy)
            at += 1
            if !(length > 0.0) { continue }
            const inside = clipLine(reach, ax, ay, dx, dy, &from, &to)
            // (Coming in from outside: a stroke of its own from there.)
            if down && (!inside || from > 0.0) {
                _ = stroke_module.end(stroke.?)
                down = false
            }
            if inside {
                if !down {
                    point.x = ax + dx * from
                    point.y = ay + dy * from
                    point.time = (travelled + length * from) * BRUSH_PACE
                    _ = stroke_module.begin(stroke.?, &aim, brush, &point)
                    down = true
                }
                const pieces = @ceil(length * (to - from) / BRUSH_STEP)
                var piece: f64 = 1.0
                while piece <= pieces {
                    const t = from + (to - from) * piece / pieces
                    point.x = ax + dx * t
                    point.y = ay + dy * t
                    point.time = (travelled + length * t) * BRUSH_PACE
                    _ = stroke_module.to(stroke.?, &point)
                    piece += 1.0
                }
                // (Going out: lifted there.)
                if to < 1.0 {
                    _ = stroke_module.end(stroke.?)
                    down = false
                }
            }
            travelled += length
        }
        if down {
            _ = stroke_module.end(stroke.?)
            down = false
        }
    }
    const merged = mergeInto(app, target, plane.?)
    device_module.destroy(plane.?)
    return merged
}

// The shape in `path` painted onto `node` as the options say: one step of
// the history.
fn paint(app: *App, s: *Shapes, image: *image_module.Image, node: *node_module.Node, path: *raster.Path, closed: bool) -> void {
    const o = &s.*.options
    const clip = image_module.bounds(image)
    const made = device_module.create(app.*.allocator, 0)
    if made == null {
        api.say(app, state.tr(app, "There is not enough memory for the shape", "Für die Form ist nicht genug Speicher da"), true)
        return
    }
    const plane = made.?
    var whole = true
    if closed && o.*.fill != PAINT_NONE {
        _ = raster.fillDevice(plane, path, raster.NONZERO, o.*.antialias, clip, colorOf(app, o.*.fill), blend.NORMAL, 255, 0, null)
    }
    if hasOutline(s, closed) {
        var outline = o.*.outline
        if outline == PAINT_NONE { outline = if o.*.fill != PAINT_NONE { o.*.fill } else { PAINT_FOREGROUND } }
        const color = colorOf(app, outline)
        var line = path
        var inside = true
        const inset = insetOf(app, s, closed)
        const framed = s.*.tool == RECTANGLE || s.*.tool == ELLIPSE
        if framed {
            const kept = outlinePathOf(app, s)
            whole = kept != null
            if whole {
                line = kept.?
                inside = insetInto(s, line, inset)
            }
        }
        if whole && !inside {
            _ = raster.fillDevice(plane, path, raster.NONZERO, o.*.antialias, clip, color, blend.NORMAL, 255, 0, null)
        } else if whole && o.*.useBrush {
            whole = brushAlong(app, s, image, node, plane, line, color)
        } else if whole {
            const rounded = framed && s.*.tool == RECTANGLE && cornerRadius(s, boxOf(s), inset) > 0.0
            const style = styleOf(o, o.*.width, rounded)
            _ = raster.strokeDevice(plane, line, &style, o.*.antialias, clip, color, blend.NORMAL, 255, 0, null)
        }
    }
    if !whole {
        device_module.destroy(plane)
        api.say(app, state.tr(app, "There is not enough memory for the shape", "Für die Form ist nicht genug Speicher da"), true)
        return
    }
    if node.*.overlay != null { _ = ops.dropOverlay(image, node) }
    node.*.overlay = plane
    node.*.overlayOpacity = @intCast(u8, @intFromFloat(u32, held(o.*.opacity, 0.0, 100.0, 100.0) * 2.55 + 0.5))
    node.*.overlayBlend = o.*.mode
    node.*.overlayMasked = true
    api.imageChanged(app, ops.mergeOverlay(image, node, historyName(app, s)))
}

// The gesture is done: its shape is painted (when there is one and the
// layer in use can take it) and it is over.
fn commit(app: *App, s: *Shapes) -> void {
    const image = api.image(app)
    var worth = image != null && @intFromPtr(image.?) == s.*.image
    const tool = s.*.tool
    // A click is no rectangle, ellipse or star; a polygon needs three
    // corners, a line two points.
    if (tool == RECTANGLE || tool == ELLIPSE) && @floor(s.*.startX) == @floor(s.*.endX) && @floor(s.*.startY) == @floor(s.*.endY) { worth = false }
    if tool == POLYGON && placedCount(s) < 3 { worth = false }
    if (tool == POLYLINE || tool == BEZIER || tool == FREEHAND_PATH) && placedCount(s) < 2 { worth = false }
    if worth {
        const node = api.paintable(app)
        const path = pathOf(app, s)
        var closed = false
        if node != null && path != null && build(app, s, path.?, false, &closed) { paint(app, s, image.?, node.?, path.?, closed) }
    }
    reset(s)
    api.canvasChanged(app)
}

// ---------------------------------------------------------------------------
// What is shown while the shape is made

fn drawMarks(app: *App, canvas: *Canvas) -> void {
    if !busy(app) { return }
    const s = shapesOf(app).?
    const marks = overlay.begin(app, canvas)
    if !marks.live { return }
    const path = pathOf(app, s)
    var closed = false
    if path != null && build(app, s, path.?, true, &closed) {
        const points = path.?.*.points.pointer
        var index: usize = 0
        while index < raster.contourCount(path.?) {
            const contour = raster.contourAt(path.?, index)
            overlay.polyline(&marks, points + contour.first * 2, contour.count, contour.closed)
            index += 1
        }
    }
    const tool = s.*.tool
    const placed = s.*.points.pointer
    if isCornered(tool) {
        const count = s.*.points.length / 2
        var index: usize = 0
        while index < count {
            // The first corner lights up where a click closes the polygon.
            const lit = index == 0 && tool == POLYGON && count >= 3 && !s.*.dragging && pointerNear(app, s, placed[0], placed[1])
            overlay.handle(&marks, placed[index * 2], placed[index * 2 + 1], overlay.SQUARE, lit)
            index += 1
        }
    } else if tool == BEZIER {
        const count = s.*.points.length / 4
        var index: usize = 0
        while index < count {
            const at = index * 4
            // The handles of the last anchor (the one being placed).
            if index + 1 == count && (placed[at + 2] != placed[at] || placed[at + 3] != placed[at + 1]) {
                const backX = placed[at] * 2.0 - placed[at + 2]
                const backY = placed[at + 1] * 2.0 - placed[at + 3]
                overlay.dashedLine(&marks, backX, backY, placed[at + 2], placed[at + 3])
                overlay.handle(&marks, placed[at + 2], placed[at + 3], overlay.ROUND, s.*.dragging)
                overlay.handle(&marks, backX, backY, overlay.ROUND, false)
            }
            const lit = index == 0 && count >= 2 && !s.*.dragging && pointerNear(app, s, placed[0], placed[1])
            overlay.handle(&marks, placed[at], placed[at + 1], overlay.SQUARE, lit)
            index += 1
        }
    } else if tool == STAR {
        overlay.cross(&marks, s.*.startX, s.*.startY)
    } else if tool == RECTANGLE || tool == ELLIPSE {
        // Its size while it is dragged.
        const box = boxOf(s)
        var text: [48]u8 = undefined
        const bytes: [*]u8 = &text
        var length = std.text.appendUnsigned(bytes, 0, 48, @intFromFloat(usize, held(box.right - box.left, 0.0, 1000000000.0, 0.0)))
        length = std.text.append(bytes, length, 48, " \xC3\x97 ")
        length = std.text.appendUnsigned(bytes, length, 48, @intFromFloat(usize, held(box.bottom - box.top, 0.0, 1000000000.0, 0.0)))
        overlay.label(&marks, s.*.endX, s.*.endY, bytes[0..length])
    }
}

// Whether the pointer is close enough to (x, y) for a click to close the
// shape there.
fn pointerNear(app: *App, s: *Shapes, x: f64, y: f64) -> bool {
    return nearInWindow(app, x, y, s.*.pointerWindowX, s.*.pointerWindowY)
}

// ---------------------------------------------------------------------------
// The options panel

fn paintName(context: usize, index: usize) -> []const u8 {
    const german = context != 0
    if index == PAINT_FOREGROUND { return if german { "Vordergrundfarbe" } else { "Foreground colour" } }
    if index == PAINT_BACKGROUND { return if german { "Hintergrundfarbe" } else { "Background colour" } }
    return if german { "Keine" } else { "None" }
}

fn joinName(context: usize, index: usize) -> []const u8 {
    const german = context != 0
    if index == @intCast(usize, raster.JOIN_ROUND) { return if german { "Rund" } else { "Round" } }
    if index == @intCast(usize, raster.JOIN_BEVEL) { return if german { "Abgeschrägt" } else { "Bevelled" } }
    return if german { "Spitz" } else { "Mitred" }
}

fn capName(context: usize, index: usize) -> []const u8 {
    const german = context != 0
    if index == @intCast(usize, raster.CAP_ROUND) { return if german { "Rund" } else { "Round" } }
    if index == @intCast(usize, raster.CAP_SQUARE) { return if german { "Eckig" } else { "Square" } }
    return if german { "Flach" } else { "Flat" }
}

fn dashName(context: usize, index: usize) -> []const u8 {
    const german = context != 0
    if index == DASH_DASHED { return if german { "Gestrichelt" } else { "Dashed" } }
    if index == DASH_DOTTED { return if german { "Gepunktet" } else { "Dotted" } }
    if index == DASH_DASH_DOT { return if german { "Strichpunkt" } else { "Dash and dot" } }
    return if german { "Durchgehend" } else { "Solid" }
}

fn blendName(context: usize, index: usize) -> []const u8 {
    const s: *Shapes = unsafe { @ptrFromInt(*Shapes, context) }
    if index >= s.*.rowCount { return "" }
    const row = s.*.rows[index]
    if row & ROW_HEADING != 0 { return blend.categoryTitle(@intCast(u8, row & 255), s.*.german) }
    return blend.title(row, s.*.german)
}

fn blendKind(context: usize, index: usize) -> u8 {
    const s: *Shapes = unsafe { @ptrFromInt(*Shapes, context) }
    if index < s.*.rowCount && s.*.rows[index] & ROW_HEADING != 0 { return kit_module.LIST_HEADING }
    return kit_module.LIST_ITEM
}

fn rowOfMode(s: *Shapes, mode: u16) -> usize {
    var index: usize = 0
    while index < s.*.rowCount {
        if s.*.rows[index] == mode { return index }
        index += 1
    }
    return 0
}

// Where the panel's next row goes, and what it is drawn with.
const Rows = struct {
    x: i32
    y: i32
    width: i32
    labelWidth: i32
    row: i32
    gap: i32
    base: u64
    german: usize
}

fn nextRow(rows: *Rows) -> ui.Rect {
    const area = ui.rect(rows.*.x, rows.*.y, rows.*.width, rows.*.row)
    rows.*.y += rows.*.row + rows.*.gap
    return area
}

// A row of a name at the left and a drop-down list of `count` choices
// named by `name`; true when the choice changed.
fn choiceRow(k: *kit_module.Kit, rows: *Rows, part: usize, text: []const u8, count: usize, name: kit_module.ListName, value: *usize) -> bool {
    const area = nextRow(rows)
    kit_module.label(k, ui.rect(area.x, area.y, rows.*.labelWidth - rows.*.gap, area.height), text, kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    return kit_module.comboBoxWith(k, view.idOf(rows.*.base, part), ui.rect(area.x + rows.*.labelWidth, area.y, area.width - rows.*.labelWidth, area.height), count, name, rows.*.german, value)
}

// A slider across the row; true when a change of it is complete.
fn sliderRow(k: *kit_module.Kit, rows: *Rows, part: usize, text: []const u8, value: *f64, range: *kit_module.SliderOptions, enabled: bool) -> bool {
    range.*.disabled = !enabled
    const id = view.idOf(rows.*.base, part)
    _ = kit_module.slider(k, id, nextRow(rows), text, value, range)
    return kit_module.released(k, id)
}

fn gapRow(k: *kit_module.Kit, rows: *Rows) -> void {
    kit_module.separator(k, ui.rect(rows.*.x, rows.*.y, rows.*.width, rows.*.gap * 2))
    rows.*.y += rows.*.gap * 2
}

// The options of the tool in use in `area` (the Tool Options docker's);
// the height they took.
fn panel(app: *App, area: ui.Rect) -> i32 {
    const found = shapesOf(app)
    if found == null { return 0 }
    const s = found.?
    const o = &s.*.options
    const k = api.kit(app)
    const scale = state.px(app, 1)
    const pad = 8 * scale
    s.*.german = app.*.german
    if area.width < pad * 2 + 80 * scale { return 0 }
    var rows = Rows.{
        .x = area.x + pad,
        .y = area.y + pad,
        .width = area.width - pad * 2,
        .labelWidth = (area.width - pad * 2) * 2 / 5,
        .row = kit_module.ROW * scale,
        .gap = 4 * scale,
        .base = view.id("nebula.shapes.options"),
        .german = if app.*.german { 1 } else { 0 },
    }
    const tool = app.*.tool
    var changed = false
    // An open shape has no inside: no fill, and always an outline.
    const open = tool == POLYLINE
    if !open {
        if choiceRow(k, &rows, PART_FILL, state.tr(app, "Fill", "Füllung"), PAINTS, paintName, &o.*.fill) { changed = true }
    }
    if choiceRow(k, &rows, PART_OUTLINE, state.tr(app, "Outline", "Umriss"), PAINTS, paintName, &o.*.outline) { changed = true }
    const lined = o.*.outline != PAINT_NONE || open
    if sliderRow(k, &rows, PART_WIDTH, state.tr(app, "Width", "Breite"), &o.*.width, &s.*.widthRange, lined && !o.*.useBrush) { changed = true }
    if !lined || o.*.useBrush { kit_module.disabledBegin(k) }
    if choiceRow(k, &rows, PART_JOIN, state.tr(app, "Corners", "Ecken"), 3, joinName, &o.*.join) { changed = true }
    if choiceRow(k, &rows, PART_CAP, state.tr(app, "Ends", "Enden"), 3, capName, &o.*.cap) { changed = true }
    if choiceRow(k, &rows, PART_DASHES, state.tr(app, "Dashes", "Striche"), DASH_KINDS, dashName, &o.*.dashes) { changed = true }
    if !lined || o.*.useBrush { kit_module.disabledEnd(k) }
    if !lined { kit_module.disabledBegin(k) }
    if kit_module.checkBox(k, view.idOf(rows.base, PART_BRUSH), nextRow(&rows), state.tr(app, "Outline with the brush", "Umriss mit dem Pinsel"), &o.*.useBrush) { changed = true }
    if !lined { kit_module.disabledEnd(k) }
    gapRow(k, &rows)
    if sliderRow(k, &rows, PART_OPACITY, state.tr(app, "Opacity", "Deckkraft"), &o.*.opacity, &s.*.opacityRange, true) { changed = true }
    var chosen = rowOfMode(s, o.*.mode)
    const blendArea = nextRow(&rows)
    kit_module.label(k, ui.rect(blendArea.x, blendArea.y, rows.labelWidth - rows.gap, blendArea.height), state.tr(app, "Blending", "Mischmodus"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    if kit_module.comboBoxKinds(k, view.idOf(rows.base, PART_BLEND), ui.rect(blendArea.x + rows.labelWidth, blendArea.y, blendArea.width - rows.labelWidth, blendArea.height), s.*.rowCount, blendName, blendKind, @intFromPtr(s), &chosen) {
        if chosen < s.*.rowCount && s.*.rows[chosen] & ROW_HEADING == 0 {
            o.*.mode = s.*.rows[chosen]
            changed = true
        }
    }
    if kit_module.checkBox(k, view.idOf(rows.base, PART_SMOOTH), nextRow(&rows), state.tr(app, "Smooth edges", "Kanten glätten"), &o.*.antialias) { changed = true }
    if tool == RECTANGLE {
        gapRow(k, &rows)
        if sliderRow(k, &rows, PART_RADIUS, state.tr(app, "Corner radius", "Eckenradius"), &o.*.radius, &s.*.radiusRange, true) { changed = true }
    } else if tool == STAR {
        gapRow(k, &rows)
        if sliderRow(k, &rows, PART_TIPS, state.tr(app, "Tips", "Zacken"), &o.*.tips, &s.*.tipsRange, true) { changed = true }
        if sliderRow(k, &rows, PART_RATIO, state.tr(app, "Inner radius", "Innenradius"), &o.*.ratio, &s.*.ratioRange, true) { changed = true }
    } else if tool == FREEHAND_PATH {
        gapRow(k, &rows)
        if sliderRow(k, &rows, PART_SMOOTHING, state.tr(app, "Smoothing", "Glättung"), &o.*.smoothing, &s.*.smoothingRange, true) { changed = true }
    }
    if changed {
        saveOptions(app)
        api.canvasChanged(app)
    }
    return rows.y - area.y + pad - rows.gap
}

// ---------------------------------------------------------------------------
// The tools

// How the shape tool in use is used, for the status bar ("" when the tool
// in use is none of them).
pub fn hint(app: *App) -> []const u8 {
    const tool = app.*.tool
    if tool == RECTANGLE { return state.tr(app, "drag from corner to corner \xC2\xB7 Shift: a square \xC2\xB7 Alt: from the middle", "von Ecke zu Ecke ziehen \xC2\xB7 Umschalt: ein Quadrat \xC2\xB7 Alt: von der Mitte aus") }
    if tool == ELLIPSE { return state.tr(app, "drag from corner to corner \xC2\xB7 Shift: a circle \xC2\xB7 Alt: from the middle", "von Ecke zu Ecke ziehen \xC2\xB7 Umschalt: ein Kreis \xC2\xB7 Alt: von der Mitte aus") }
    if tool == POLYGON || tool == POLYLINE { return state.tr(app, "click: a corner \xC2\xB7 Enter or a double click: done \xC2\xB7 Backspace: one back", "Klick: eine Ecke \xC2\xB7 Eingabe oder Doppelklick: fertig \xC2\xB7 R\xC3\xBCcktaste: eine zur\xC3\xBCck") }
    if tool == BEZIER { return state.tr(app, "click: an anchor \xC2\xB7 drag: its handles \xC2\xB7 Enter or a double click: done", "Klick: ein Anker \xC2\xB7 Ziehen: seine Griffe \xC2\xB7 Eingabe oder Doppelklick: fertig") }
    if tool == FREEHAND_PATH { return state.tr(app, "draw with the button down \xC2\xB7 filled, the path closes", "mit gedr\xC3\xBCckter Taste zeichnen \xC2\xB7 gef\xC3\xBCllt schlie\xC3\x9Ft sich der Pfad") }
    if tool == STAR { return state.tr(app, "drag from the middle to a tip \xC2\xB7 Shift: in steps of 15\xC2\xB0", "von der Mitte zu einer Zacke ziehen \xC2\xB7 Umschalt: in 15\xC2\xB0-Schritten") }
    return ""
}

const TOOLS = [7]state.Tool{
    state.Tool.{ .id = RECTANGLE, .key = "rectangle", .name = "Rectangle", .german = "Rechteck", .shortcut = "", .icon = icons.TOOL_RECTANGLE, .group = state.GROUP_SHAPE, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawMarks, .options = panel, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = ELLIPSE, .key = "ellipse", .name = "Ellipse", .german = "Ellipse", .shortcut = "", .icon = icons.TOOL_ELLIPSE, .group = state.GROUP_SHAPE, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawMarks, .options = panel, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = POLYGON, .key = "polygon", .name = "Polygon", .german = "Polygon", .shortcut = "", .icon = icons.TOOL_POLYGON, .group = state.GROUP_SHAPE, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawMarks, .options = panel, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = POLYLINE, .key = "polyline", .name = "Polyline", .german = "Polylinie", .shortcut = "", .icon = icons.TOOL_POLYLINE, .group = state.GROUP_SHAPE, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawMarks, .options = panel, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = BEZIER, .key = "bezier", .name = "Bézier Curve", .german = "Bézierkurve", .shortcut = "", .icon = icons.TOOL_BEZIER, .group = state.GROUP_SHAPE, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawMarks, .options = panel, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = FREEHAND_PATH, .key = "freehandpath", .name = "Freehand Path", .german = "Freihandpfad", .shortcut = "", .icon = icons.TOOL_FREEHAND_PATH, .group = state.GROUP_SHAPE, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawMarks, .options = panel, .cancel = cancel, .finish = finish, .busy = busy },
    state.Tool.{ .id = STAR, .key = "star", .name = "Star", .german = "Stern", .shortcut = "", .icon = icons.STAR, .group = state.GROUP_SHAPE, .cursor = state.CURSOR_CROSS, .activate = null, .deactivate = cancel, .press = press, .move = move, .release = release, .keyPress = keyPress, .tick = null, .overlay = drawMarks, .options = panel, .cancel = cancel, .finish = finish, .busy = busy },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Tool {
    if kept.address != 0 { return table.rows(state.Tool, &kept) }
    return table.keep(state.Tool, &kept, TOOLS[0..])
}
