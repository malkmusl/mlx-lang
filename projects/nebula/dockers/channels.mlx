// nebula dockers: the channels of the active layer: a row each for red,
// green, blue and alpha, with a small picture of the layer's values in
// that channel as greys (a colour channel over the checker where the
// layer is transparent, alpha as it is) and a check box: a channel taken
// out is not shown in the image (Node.channels, bit 0 blue, 1 green, 2
// red, 3 alpha; core/render.mlx takes a hidden channel from what is below
// the layer). Each change is one step of the history; "Show all" in the
// head puts every channel back in one step.
//
// The pictures are made from the layer's pixels (a group's, a fill's and
// a clone's as core/render.mlx makes them) a few samples a picture
// pixel, and kept: made again only for another layer or image, another
// size, when the image's projection was drawn again
// (core/image.mlx's updateSerial: what changed pixels damaged the image)
// or when the docker was not drawn in the frame before.
//
// Not done: locks of channels (Krita's: painting leaves a locked
// channel as it is): the brush engine and the other tools have no such
// mask to honour, so there is nothing for a lock to set.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const render = @import("../core/render.mlx")
const geom = @import("../core/geom.mlx")
const ops = @import("../core/ops.mlx")
const scratch = @import("../core/scratch.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")

pub const App = state.App
pub const Image = image_module.Image
pub const Node = node_module.Node

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 7

// The rows, top to bottom.
pub const RED: usize = 0
pub const GREEN: usize = 1
pub const BLUE: usize = 2
pub const ALPHA: usize = 3
pub const CHANNELS: usize = 4

// All four shown (Node.channels).
pub const ALL: u8 = 15

// Sizes at scale 1: the room around the rows, the head, a row, the box a
// picture is fitted into, the squares under what is transparent.
const PADDING: i32 = 6
const HEAD: i32 = 24
const ROW: i32 = 34
const THUMB_WIDTH: i32 = 44
const THUMB_HEIGHT: i32 = 28
const CHECK: i32 = 4
// The room a channel's name wants beside the disc of its colour.
const NAME_ROOM: i32 = 52
// Samples a picture pixel takes along each side.
const SAMPLES: i32 = 2
// The checker's greys.
const CHECK_LIGHT: u32 = 204
const CHECK_DARK: u32 = 153

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "channels", .name = "Channels", .german = "Kanäle", .icon = icons.DOCKER_CHANNELS, .draw = draw, .keyPress = null, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// What the docker keeps: the four pictures (opaque premultiplied words,
// `width` x `height` each, one after the other in a block of `capacity`
// words), what they show, where the rows were drawn.
const Keep = struct {
    ready: bool
    pixels: usize
    capacity: usize
    width: i32
    height: i32
    image: usize
    node: usize
    nodeId: u32
    serial: u64
    imageWidth: i32
    imageHeight: i32
    made: bool
    refreshes: u64
    // The kit's frame the docker was drawn in, the rows and pictures then.
    frame: u64
    rows: [4]ui.Rect
    thumbs: [4]ui.Rect
    offset: i32
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        keep.*.pixels = 0
        keep.*.capacity = 0
        keep.*.made = false
        keep.*.refreshes = 0
        keep.*.frame = 0
        keep.*.offset = 0
        keep.*.ready = true
    }
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn wordsOf(keep: *Keep) -> [*]u32 { unsafe { return @ptrFromInt([*]u32, keep.*.pixels) } }

fn rowId(channel: usize) -> u64 { return view.idOf(view.id("nebula.channels.row"), channel) }

// The bit of Node.channels that shows row `channel` (RED ...; 0 for
// none).
pub fn bitOf(channel: usize) -> u8 {
    if channel == RED { return 4 }
    if channel == GREEN { return 2 }
    if channel == BLUE { return 1 }
    if channel == ALPHA { return 8 }
    return 0
}

fn nameOf(app: *App, channel: usize) -> []const u8 {
    if channel == RED { return state.tr(app, "Red", "Rot") }
    if channel == GREEN { return state.tr(app, "Green", "Grün") }
    if channel == BLUE { return state.tr(app, "Blue", "Blau") }
    return state.tr(app, "Alpha", "Alpha")
}

// ---------------------------------------------------------------------------
// For tests and other parts

// How often the pictures were made since the program started.
pub fn refreshes(app: *App) -> u64 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.refreshes
}

// Where row `channel` / its picture was drawn in the last frame (empty:
// it was not, or is out of the docker's sight).
pub fn rowArea(app: *App, channel: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || channel >= CHANNELS || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.rows[channel]
}

pub fn thumbArea(app: *App, channel: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || channel >= CHANNELS || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.thumbs[channel]
}

// Shows (or hides) `channel` of the active layer: one step of the
// history. False when there is no active layer, it is so already, or the
// tool in use is in the middle of something.
pub fn setShown(app: *App, channel: usize, shown: bool) -> bool {
    const image = api.image(app)
    const node = api.activeNode(app)
    const bit = bitOf(channel)
    if image == null || node == null || bit == 0 || api.toolBusy(app) { return false }
    const now = node.?.*.channels & bit != 0
    if now == shown { return false }
    const before = node_module.props(node.?)
    node.?.*.channels = if shown { node.?.*.channels | bit } else { node.?.*.channels & ~bit }
    ops.changed(image.?, node.?, &before, if shown { state.tr(app, "Show channel", "Kanal zeigen") } else { state.tr(app, "Hide channel", "Kanal ausblenden") })
    api.layersChanged(app)
    return true
}

// Shows every channel of the active layer again (one step); false when
// all are shown or there is no layer.
pub fn showAll(app: *App) -> bool {
    const image = api.image(app)
    const node = api.activeNode(app)
    if image == null || node == null || api.toolBusy(app) || node.?.*.channels & ALL == ALL { return false }
    const before = node_module.props(node.?)
    node.?.*.channels = node.?.*.channels | ALL
    ops.changed(image.?, node.?, &before, state.tr(app, "Show all channels", "Alle Kanäle zeigen"))
    api.layersChanged(app)
    return true
}

// ---------------------------------------------------------------------------
// The pictures

// Room for `count` words; false without memory.
fn reserve(app: *App, keep: *Keep, count: usize) -> bool {
    if count <= keep.*.capacity { return true }
    const allocator = app.*.allocator
    if keep.*.capacity > 0 { allocator.free(unsafe { @ptrCast([*]u8, wordsOf(keep)) }, keep.*.capacity * 4, 16) }
    keep.*.pixels = 0
    keep.*.capacity = 0
    const memory = allocator.alloc(count * 4, 16)
    if memory == null { return false }
    keep.*.pixels = @intFromPtr(memory.?)
    keep.*.capacity = count
    return true
}

// Whether `node` keeps its pixels in its device (a paint, vector or file
// layer); the others are made by render.
fn ownsPixels(node: *Node) -> bool {
    const kind = node.*.kind
    return node.*.device != null && (kind == node_module.PAINT || kind == node_module.VECTOR || kind == node_module.FILE || node_module.isMask(kind))
}

// The layer's pixels in `area` (one row) into `into`.
fn readLayer(image: *Image, node: *Node, area: geom.Rect, into: [*]u32) -> void {
    if ownsPixels(node) {
        device_module.readRect(node.*.device.?, area, into, @intCast(usize, area.width))
    } else {
        render.readNode(image, node, area, into)
    }
}

fn grey(value: u32) -> u32 { return 0xFF000000 | (value << 16) | (value << 8) | value }

// The four pictures of `node`, `width` x `height` each, made again.
// Each picture pixel takes SAMPLES x SAMPLES samples of the layer
// (alpha-weighted for the colours); the sums stay far below 2^32 (four
// samples of alpha times a channel).
fn make(app: *App, keep: *Keep, image: *Image, node: *Node, width: i32, height: i32) -> bool {
    const columns = @intCast(usize, width)
    if !reserve(app, keep, columns * @intCast(usize, height) * CHANNELS) { return false }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const row = scratch.words(pool, @intCast(usize, image.*.width))
    const sums = scratch.words(pool, columns * 5)
    const places = scratch.ints(pool, columns * @intCast(usize, SAMPLES))
    if row == null || sums == null || places == null {
        scratch.release(pool, mark)
        return false
    }
    const across = @intCast(i64, width) * @intCast(i64, SAMPLES) * 2
    const down = @intCast(i64, height) * @intCast(i64, SAMPLES) * 2
    // Where each picture column's samples are on the image.
    var at: usize = 0
    while at < columns * @intCast(usize, SAMPLES) {
        places.?[at] = @intCast(i32, (@intCast(i64, at) * 2 + 1) * @intCast(i64, image.*.width) / across)
        at += 1
    }
    const target = wordsOf(keep)
    const plane = columns * @intCast(usize, height)
    const check = px(app, CHECK)
    var y: i32 = 0
    while y < height {
        device_module.fillWords(sums.?, columns * 5, 0)
        var sample: i32 = 0
        while sample < SAMPLES {
            const source_y = @intCast(i32, ((@intCast(i64, y) * @intCast(i64, SAMPLES) + @intCast(i64, sample)) * 2 + 1) * @intCast(i64, image.*.height) / down)
            readLayer(image, node, geom.rect(0, source_y, image.*.width, 1), row.?)
            at = 0
            while at < columns * @intCast(usize, SAMPLES) {
                const value = row.?[@intCast(usize, places.?[at])]
                const alpha = value >> 24
                const sum = (at / @intCast(usize, SAMPLES)) * 5
                sums.?[sum] += alpha
                sums.?[sum + 1] += alpha * ((value >> 16) & 255)
                sums.?[sum + 2] += alpha * ((value >> 8) & 255)
                sums.?[sum + 3] += alpha * (value & 255)
                sums.?[sum + 4] += 1
                at += 1
            }
            sample += 1
        }
        var x: i32 = 0
        while x < width {
            const sum = @intCast(usize, x) * 5
            const count = sums.?[sum + 4]
            const alpha = (sums.?[sum] + count / 2) / count
            const under = if ((x / check) + (y / check)) & 1 == 0 { CHECK_LIGHT } else { CHECK_DARK }
            const ground = (under * (255 - alpha) + 127) / 255
            const at_pixel = @intCast(usize, y) * columns + @intCast(usize, x)
            // A colour channel: its premultiplied average over the checker.
            var channel: usize = 0
            while channel < 3 {
                const shown = (sums.?[sum + 1 + channel] + count * 255 / 2) / (count * 255)
                const value = shown + ground
                target[channel * plane + at_pixel] = grey(if value > 255 { 255 } else { value })
                channel += 1
            }
            target[ALPHA * plane + at_pixel] = grey(alpha)
            x += 1
        }
        y += 1
    }
    scratch.release(pool, mark)
    return true
}

// The pictures for `node` at the size that fits the box, made again when
// what they show changed.
fn refresh(app: *App, keep: *Keep, image: *Image, node: *Node) -> void {
    const frame = api.kit(app).*.frame
    const followed = keep.*.frame + 1 == frame
    keep.*.frame = frame
    const box_width = px(app, THUMB_WIDTH)
    const box_height = px(app, THUMB_HEIGHT)
    const scale_x = @floatFromInt(f64, box_width) / @floatFromInt(f64, image.*.width)
    const scale_y = @floatFromInt(f64, box_height) / @floatFromInt(f64, image.*.height)
    const scale = if scale_x < scale_y { scale_x } else { scale_y }
    var width = @intFromFloat(i32, @floatFromInt(f64, image.*.width) * scale + 0.5)
    var height = @intFromFloat(i32, @floatFromInt(f64, image.*.height) * scale + 0.5)
    if width < 1 { width = 1 }
    if height < 1 { height = 1 }
    if width > box_width { width = box_width }
    if height > box_height { height = box_height }
    _ = render.update(image)
    const same = keep.*.made && followed && keep.*.image == @intFromPtr(image) && keep.*.node == @intFromPtr(node) && keep.*.nodeId == node.*.id && keep.*.serial == image.*.updateSerial && keep.*.width == width && keep.*.height == height && keep.*.imageWidth == image.*.width && keep.*.imageHeight == image.*.height
    if same { return }
    keep.*.made = false
    if !make(app, keep, image, node, width, height) { return }
    keep.*.made = true
    keep.*.image = @intFromPtr(image)
    keep.*.node = @intFromPtr(node)
    keep.*.nodeId = node.*.id
    keep.*.serial = image.*.updateSerial
    keep.*.width = width
    keep.*.height = height
    keep.*.imageWidth = image.*.width
    keep.*.imageHeight = image.*.height
    keep.*.refreshes += 1
}

// Picture `channel` onto the canvas at `box` (the part on the canvas).
fn blit(keep: *Keep, canvas: *state.Canvas, box: ui.Rect, channel: usize) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || canvas.*.height == 0 || !keep.*.made { return }
    const clip = ui.intersect(box, ui.rect(0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height)))
    if ui.isEmpty(clip) { return }
    const plane = @intCast(usize, keep.*.width) * @intCast(usize, keep.*.height)
    const source = wordsOf(keep) + channel * plane
    var y = clip.y
    while y < ui.bottom(clip) {
        const from = source + @intCast(usize, (y - box.y) * keep.*.width + (clip.x - box.x))
        const to = canvas.*.pixels + (@intCast(usize, y) * canvas.*.stride + @intCast(usize, clip.x))
        device_module.copyWords(to, from, @intCast(usize, clip.width))
        y += 1
    }
}

// ---------------------------------------------------------------------------
// The docker

// The small disc of a channel's colour beside its name.
fn dotColor(theme: *theme_module.Theme, channel: usize) -> u32 {
    if channel == RED { return canvas_module.color(255, 224, 86, 86) }
    if channel == GREEN { return canvas_module.color(255, 72, 178, 96) }
    if channel == BLUE { return canvas_module.color(255, 84, 140, 236) }
    return theme.*.dim
}

// Row `channel` at `area`; true when it was clicked (its channel changes).
fn drawRow(app: *App, keep: *Keep, node: *Node, channel: usize, area: ui.Rect, sight: ui.Rect) -> bool {
    const k = api.kit(app)
    const theme = state.themeOf(app)
    const s = app.*.scale
    const canvas = kit_module.canvasOf(k)
    const shown = node.*.channels & bitOf(channel) != 0
    const clicked = kit_module.listRow(k, rowId(channel), area, false, false) != kit_module.ROW_NONE
    const box_size = 14 * s
    controls.drawCheckBox(state.uiOf(app), area.x + px(app, 6), area.y + (area.height - box_size) / 2, if shown { controls.CHECK_ON } else { controls.CHECK_OFF }, theme.*.accent)
    // The picture, fitted into its box, with a thin edge.
    const box_x = area.x + px(app, 28)
    const thumb = ui.rect(box_x + (px(app, THUMB_WIDTH) - keep.*.width) / 2, area.y + (area.height - keep.*.height) / 2, keep.*.width, keep.*.height)
    if keep.*.made {
        blit(keep, canvas, thumb, channel)
        kit_module.frame(canvas, ui.rect(thumb.x - s, thumb.y - s, thumb.width + 2 * s, thumb.height + 2 * s), theme.*.divider)
        if !shown {
            // A hidden channel's picture is faded toward the panel.
            const panel = theme.*.panel
            canvas_module.fillRect(canvas, thumb.x, thumb.y, thumb.width, thumb.height, canvas_module.color(160, (panel >> 16) & 255, (panel >> 8) & 255, panel & 255))
        }
    }
    // The disc of the channel's colour, when the name still has room
    // beside it (a narrow docker keeps the name whole instead).
    const dot = px(app, 8)
    const dot_x = box_x + px(app, THUMB_WIDTH) + px(app, 12)
    var name_x = dot_x
    if ui.right(area) - (dot_x + dot + px(app, 8)) >= px(app, NAME_ROOM) {
        canvas_module.fillRoundedRect(canvas, dot_x, area.y + (area.height - dot) / 2, dot, dot, dot / 2, dotColor(theme, channel))
        name_x = dot_x + dot + px(app, 8)
    }
    kit_module.label(k, ui.rect(name_x, area.y, ui.right(area) - name_x - px(app, 6), area.height), nameOf(app, channel), if shown { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_LEFT)
    const tip = if shown { state.tr(app, "Shown in the image: click to take it out", "Im Bild gezeigt: klicken, um ihn auszublenden") } else { state.tr(app, "Not shown in the image: click to show it", "Nicht im Bild gezeigt: klicken, um ihn zu zeigen") }
    kit_module.tooltip(k, rowId(channel), area, tip)
    const seen = ui.intersect(area, sight)
    keep.*.rows[channel] = if seen.height == area.height { area } else { ui.rect(0, 0, 0, 0) }
    keep.*.thumbs[channel] = if seen.height == area.height && keep.*.made { thumb } else { ui.rect(0, 0, 0, 0) }
    return clicked
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    const k = api.kit(app)
    var channel: usize = 0
    while channel < CHANNELS {
        keep.?.*.rows[channel] = ui.rect(0, 0, 0, 0)
        keep.?.*.thumbs[channel] = ui.rect(0, 0, 0, 0)
        channel += 1
    }
    const image = api.image(app)
    if image == null {
        keep.?.*.frame = k.*.frame
        keep.?.*.made = false
        kit_module.label(k, area, state.tr(app, "No image is open", "Kein Bild ist offen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    const node = api.activeNode(app)
    if node == null {
        keep.?.*.frame = k.*.frame
        kit_module.label(k, area, state.tr(app, "There is no active layer", "Es gibt keine aktive Ebene"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    refresh(app, keep.?, image.?, node.?)
    const padding = px(app, PADDING)
    const head = px(app, HEAD)
    const row = px(app, ROW)
    const height = padding * 2 + head + px(app, 4) + row * @intCast(i32, CHANNELS)
    const content = kit_module.scrollBegin(k, view.id("nebula.channels"), area, height, &keep.?.*.offset)
    const x = content.x + padding
    const width = content.width - padding * 2
    var y = content.y + padding
    // The head: the layer's name, and the button that shows all again.
    const button_width = px(app, 72)
    const all_shown = node.?.*.channels & ALL == ALL
    kit_module.label(k, ui.rect(x + px(app, 2), y, width - button_width - px(app, 8), head), node_module.nameOf(node.?), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    var show_all = false
    if kit_module.button(k, view.id("nebula.channels.all"), ui.rect(x + width - button_width, y + (head - px(app, 22)) / 2, button_width, px(app, 22)), state.tr(app, "Show all", "Alle zeigen"), kit_module.BUTTON_PLAIN | (if all_shown { kit_module.BUTTON_DISABLED } else { 0 })) { show_all = true }
    y += head + px(app, 4)
    var clicked: usize = CHANNELS
    channel = 0
    while channel < CHANNELS {
        if drawRow(app, keep.?, node.?, channel, ui.rect(x, y, width, row), area) { clicked = channel }
        y += row
        channel += 1
    }
    kit_module.scrollEnd(k)
    // (Changed after the rows were drawn: what changed shows in the next
    // frame, which the change asks for.)
    if clicked < CHANNELS { _ = setShown(app, clicked, node.?.*.channels & bitOf(clicked) == 0) }
    if show_all { _ = showAll(app) }
}
