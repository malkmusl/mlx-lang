// nebula dockers: the overview: the whole image in front, small, with the
// part the canvas shows outlined; under it the zoom and buttons that turn
// the canvas left, right and back upright.
//
// A press on the picture moves the view there (the outline's middle to
// the pointer when the press is outside the outline), a drag moves it
// along. The small picture is the image's projection averaged area by
// area into memory of the docker's own, over the squares that show what
// is transparent, and kept: it is made again where the image changed
// (core/image.mlx's updatesSince), not in every frame; all of it when it
// is another image, the image's size changed or the docker's.
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const device_module = @import("../core/device.mlx")
const image_module = @import("../core/image.mlx")
const render = @import("../core/render.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const viewport = @import("../ui/viewport.mlx")
const statusbar = @import("../ui/statusbar.mlx")

pub const App = state.App
pub const Image = image_module.Image

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 5

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "overview", .name = "Overview", .german = "Übersicht", .icon = icons.DOCKER_OVERVIEW, .draw = draw, .keyPress = null, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// The row of controls under the picture, the room around it (times the
// scale).
const CONTROLS: i32 = 28
const PADDING: i32 = 6
// A picture pixel averages at most this many image pixels a side: of a
// larger block every so many rows and columns are taken.
const SAMPLES: i32 = 16
// The squares under what is transparent: their side in picture pixels
// and their two greys.
const CHECK: i32 = 6
const CHECK_LIGHT: u32 = 204
const CHECK_DARK: u32 = 153

// The small picture as it is kept.
pub const Thumbnail = struct {
    pixels: [*]const u32
    width: i32
    height: i32
}

const Keep = struct {
    ready: bool
    // The picture: premultiplied opaque words (`capacity` of them), of
    // which image it is, at what sizes, up to which update of its
    // projection.
    pixels: usize
    capacity: usize
    width: i32
    height: i32
    image: usize
    imageWidth: i32
    imageHeight: i32
    serial: u64
    // Where it was drawn this frame and how large an image pixel is in it.
    box: ui.Rect
    scale: f64
    // A press on it being followed: where it went down, the view's middle
    // then.
    dragging: bool
    pressX: i32
    pressY: i32
    startX: f64
    startY: f64
    zoom: kit_module.SliderOptions
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        keep.*.pixels = 0
        keep.*.capacity = 0
        keep.*.width = 0
        keep.*.height = 0
        keep.*.image = 0
        keep.*.dragging = false
        keep.*.zoom = statusbar.zoomOptions()
        keep.*.ready = true
    }
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn wordsOf(keep: *Keep) -> [*]u32 { unsafe { return @ptrFromInt([*]u32, keep.*.pixels) } }

// The picture as it was made last (0 x 0: none yet).
pub fn thumbnail(app: *App) -> Thumbnail {
    const keep = keepOf(app)
    if keep == null || keep.?.*.pixels == 0 { return Thumbnail.{ .pixels = unsafe { @ptrFromInt([*]const u32, 16) }, .width = 0, .height = 0 } }
    return Thumbnail.{ .pixels = wordsOf(keep.?), .width = keep.?.*.width, .height = keep.?.*.height }
}

// Where the picture was drawn this frame (empty: it was not).
pub fn pictureArea(app: *App) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.box
}

// ---------------------------------------------------------------------------
// The picture

// Room for a picture of `count` words; false without memory.
fn reserve(app: *App, keep: *Keep, count: usize) -> bool {
    if count <= keep.*.capacity { return true }
    const allocator = app.*.allocator
    if keep.*.capacity > 0 { allocator.free(unsafe { @ptrCast([*]u8, wordsOf(keep)) }, keep.*.capacity * 4, 16) }
    keep.*.pixels = 0
    keep.*.capacity = 0
    const memory = allocator.alloc(count * 4, 16)
    if memory == null { return false }
    keep.*.pixels = @intFromPtr(memory.?)
    keep.*.capacity = count
    return true
}

// The image's columns (or rows) picture column `at` of `count` averages,
// out of `size`: from .0 up to .1.
fn span(at: i32, count: i32, size: i32) -> (i32, i32) {
    const from = @intCast(i32, @intCast(i64, at) * @intCast(i64, size) / @intCast(i64, count))
    var to = @intCast(i32, (@intCast(i64, at) + 1) * @intCast(i64, size) / @intCast(i64, count))
    if to <= from { to = from + 1 }
    return -> (from, to)
}

fn checkGrey(x: i32, y: i32) -> u32 {
    return if ((x / CHECK) + (y / CHECK)) & 1 == 0 { CHECK_LIGHT } else { CHECK_DARK }
}

// The picture's pixels from (x0, y0) up to (x1, y1) made again from the
// image's projection.
fn renderPart(keep: *Keep, image: *Image, x0: i32, y0: i32, x1: i32, y1: i32) -> void {
    const width = keep.*.width
    const height = keep.*.height
    if x1 <= x0 || y1 <= y0 { return }
    const source_x0 = span(x0, width, image.*.width).0
    const source_x1 = span(x1 - 1, width, image.*.width).1
    const columns = x1 - x0
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const row = scratch.words(pool, @intCast(usize, source_x1 - source_x0))
    const sums = scratch.doubles(pool, @intCast(usize, columns) * 5)
    if row == null || sums == null {
        scratch.release(pool, mark)
        return
    }
    const target = wordsOf(keep)
    var y = y0
    while y < y1 {
        const rows = span(y, height, image.*.height)
        const row_step = if rows.1 - rows.0 > SAMPLES { (rows.1 - rows.0) / SAMPLES } else { 1 }
        var index: usize = 0
        while index < @intCast(usize, columns) * 5 {
            sums.?[index] = 0.0
            index += 1
        }
        var source_y = rows.0
        while source_y < rows.1 {
            device_module.readRect(image.*.projection, geom.rect(source_x0, source_y, source_x1 - source_x0, 1), row.?, @intCast(usize, source_x1 - source_x0))
            var x = x0
            while x < x1 {
                const cells = span(x, width, image.*.width)
                const column_step = if cells.1 - cells.0 > SAMPLES { (cells.1 - cells.0) / SAMPLES } else { 1 }
                const at = @intCast(usize, x - x0) * 5
                var source_x = cells.0
                while source_x < cells.1 {
                    const value = row.?[@intCast(usize, source_x - source_x0)]
                    const alpha = @floatFromInt(f64, value >> 24)
                    sums.?[at] += alpha
                    sums.?[at + 1] += alpha * @floatFromInt(f64, (value >> 16) & 255)
                    sums.?[at + 2] += alpha * @floatFromInt(f64, (value >> 8) & 255)
                    sums.?[at + 3] += alpha * @floatFromInt(f64, value & 255)
                    sums.?[at + 4] += 1.0
                    source_x += column_step
                }
                x += 1
            }
            source_y += row_step
        }
        // Each average over the squares, opaque.
        var x = x0
        while x < x1 {
            const at = @intCast(usize, x - x0) * 5
            const count = sums.?[at + 4]
            if count > 0.0 {
                const alpha = sums.?[at] / count
                const grey = @floatFromInt(f64, checkGrey(x, y)) * (255.0 - alpha) / 255.0
                const red = channel(sums.?[at + 1] / (255.0 * count) + grey)
                const green = channel(sums.?[at + 2] / (255.0 * count) + grey)
                const blue = channel(sums.?[at + 3] / (255.0 * count) + grey)
                target[@intCast(usize, y * width + x)] = 0xFF000000 | (red << 16) | (green << 8) | blue
            }
            x += 1
        }
        y += 1
    }
    scratch.release(pool, mark)
}

fn channel(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 255.0 { return 255 }
    return @intFromFloat(u32, value + 0.5)
}

// The picture for `image` fitted into `box`, made again where it is stale.
fn refresh(app: *App, keep: *Keep, image: *Image, box: ui.Rect) -> void {
    if box.width <= 0 || box.height <= 0 { return }
    const scale_x = @floatFromInt(f64, box.width) / @floatFromInt(f64, image.*.width)
    const scale_y = @floatFromInt(f64, box.height) / @floatFromInt(f64, image.*.height)
    const scale = if scale_x < scale_y { scale_x } else { scale_y }
    var width = @intFromFloat(i32, @floatFromInt(f64, image.*.width) * scale)
    var height = @intFromFloat(i32, @floatFromInt(f64, image.*.height) * scale)
    if width < 1 { width = 1 }
    if height < 1 { height = 1 }
    if width > box.width { width = box.width }
    if height > box.height { height = box.height }
    _ = render.update(image)
    var whole = keep.*.image != @intFromPtr(image) || keep.*.width != width || keep.*.height != height || keep.*.imageWidth != image.*.width || keep.*.imageHeight != image.*.height || keep.*.pixels == 0
    var changed = geom.empty()
    if !whole && !image_module.updatesSince(image, keep.*.serial, &changed) { whole = true }
    keep.*.serial = image.*.updateSerial
    if whole {
        if !reserve(app, keep, @intCast(usize, width) * @intCast(usize, height)) {
            keep.*.image = 0
            return
        }
        keep.*.image = @intFromPtr(image)
        keep.*.width = width
        keep.*.height = height
        keep.*.imageWidth = image.*.width
        keep.*.imageHeight = image.*.height
        renderPart(keep, image, 0, 0, width, height)
        return
    }
    if geom.isEmpty(changed) { return }
    // The picture's pixels the changed rectangle reaches.
    const x0 = @intCast(i32, @intCast(i64, changed.x) * @intCast(i64, width) / @intCast(i64, image.*.width))
    const y0 = @intCast(i32, @intCast(i64, changed.y) * @intCast(i64, height) / @intCast(i64, image.*.height))
    var x1 = @intCast(i32, (@intCast(i64, geom.right(changed)) * @intCast(i64, width) + @intCast(i64, image.*.width) - 1) / @intCast(i64, image.*.width))
    var y1 = @intCast(i32, (@intCast(i64, geom.bottom(changed)) * @intCast(i64, height) + @intCast(i64, image.*.height) - 1) / @intCast(i64, image.*.height))
    if x1 > width { x1 = width }
    if y1 > height { y1 = height }
    renderPart(keep, image, if x0 < 0 { 0 } else { x0 }, if y0 < 0 { 0 } else { y0 }, x1, y1)
}

// The picture's rows onto the canvas at `box` (the part on the canvas).
fn blit(keep: *Keep, canvas: *state.Canvas, box: ui.Rect) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || canvas.*.height == 0 || keep.*.pixels == 0 { return }
    const clip = ui.intersect(box, ui.rect(0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height)))
    if ui.isEmpty(clip) { return }
    const source = wordsOf(keep)
    var y = clip.y
    while y < ui.bottom(clip) {
        const from = source + @intCast(usize, (y - box.y) * keep.*.width + (clip.x - box.x))
        const to = canvas.*.pixels + (@intCast(usize, y) * canvas.*.stride + @intCast(usize, clip.x))
        device_module.copyWords(to, from, @intCast(usize, clip.width))
        y += 1
    }
}

// ---------------------------------------------------------------------------
// The docker

// The view's outline on the picture: the canvas's corners on the image.
fn drawOutline(app: *App, keep: *Keep, doc: *state.Document) -> void {
    const area = doc.*.view.area
    if ui.isEmpty(area) { return }
    const box = keep.*.box
    const scale = keep.*.scale
    var xs: [4]f64 = [4]f64{ 0.0, 0.0, 0.0, 0.0 }
    var ys: [4]f64 = [4]f64{ 0.0, 0.0, 0.0, 0.0 }
    var corner: usize = 0
    while corner < 4 {
        const wx = @floatFromInt(f64, if corner == 1 || corner == 2 { area.x + area.width } else { area.x })
        const wy = @floatFromInt(f64, if corner >= 2 { area.y + area.height } else { area.y })
        var ix: f64 = 0.0
        var iy: f64 = 0.0
        viewport.toImage(&doc.*.view, wx, wy, &ix, &iy)
        xs[corner] = @floatFromInt(f64, box.x) + ix * scale
        ys[corner] = @floatFromInt(f64, box.y) + iy * scale
        corner += 1
    }
    const theme = state.themeOf(app)
    const weight = @floatFromInt(f64, app.*.scale)
    // Only on the picture (and its edge): a view larger than the image
    // has its outline around the picture, not across the panel.
    const k = api.kit(app)
    const s = app.*.scale
    kit_module.clipBegin(k, ui.rect(box.x - 2 * s, box.y - 2 * s, box.width + 4 * s, box.height + 4 * s))
    corner = 0
    while corner < 4 {
        const next = (corner + 1) % 4
        kit_module.line(kit_module.canvasOf(k), xs[corner], ys[corner], xs[next], ys[next], canvas_module.color(150, 0, 0, 0), weight * 3.0)
        corner += 1
    }
    corner = 0
    while corner < 4 {
        const next = (corner + 1) % 4
        kit_module.line(kit_module.canvasOf(k), xs[corner], ys[corner], xs[next], ys[next], theme.*.accent, weight * 1.5)
        corner += 1
    }
    kit_module.clipEnd(k)
}

// A press on the picture moves the view's middle there; a drag along.
fn follow(app: *App, keep: *Keep, doc: *state.Document, id: u64) -> void {
    const widgets = state.uiOf(app)
    const held = view.isPressed(widgets, id) && widgets.*.pointerDown
    if !held {
        keep.*.dragging = false
        return
    }
    const box = keep.*.box
    const scale = keep.*.scale
    if scale <= 0.0 { return }
    const view_record = &doc.*.view
    if !keep.*.dragging || keep.*.pressX != widgets.*.pressX || keep.*.pressY != widgets.*.pressY {
        keep.*.dragging = true
        keep.*.pressX = widgets.*.pressX
        keep.*.pressY = widgets.*.pressY
        keep.*.startX = view_record.*.centerX
        keep.*.startY = view_record.*.centerY
        // Outside the outline: the view goes there first.
        const shown = viewport.imageRectOf(view_record, view_record.*.area)
        const ix = (@floatFromInt(f64, widgets.*.pressX - box.x) + 0.5) / scale
        const iy = (@floatFromInt(f64, widgets.*.pressY - box.y) + 0.5) / scale
        if !geom.contains(shown, @intFromFloat(i32, @floor(ix)), @intFromFloat(i32, @floor(iy))) {
            keep.*.startX = ix
            keep.*.startY = iy
        }
    }
    const x = keep.*.startX + @floatFromInt(f64, widgets.*.pointerX - keep.*.pressX) / scale
    const y = keep.*.startY + @floatFromInt(f64, widgets.*.pointerY - keep.*.pressY) / scale
    // (The image stays in sight: its middle on the image.)
    const held_x = math.clamp(x, 0.0, @floatFromInt(f64, doc.*.image.*.width))
    const held_y = math.clamp(y, 0.0, @floatFromInt(f64, doc.*.image.*.height))
    if held_x != view_record.*.centerX || held_y != view_record.*.centerY {
        view_record.*.centerX = held_x
        view_record.*.centerY = held_y
        api.redraw(app)
    }
}

fn controlId(part: usize) -> u64 { return view.idOf(view.id("nebula.overview.control"), part) }

// Turns the view about the middle of the canvas.
fn turn(app: *App, doc: *state.Document, rotation: f64) -> void {
    const area = doc.*.view.area
    viewport.rotateAt(&doc.*.view, @floatFromInt(f64, area.x) + @floatFromInt(f64, area.width) / 2.0, @floatFromInt(f64, area.y) + @floatFromInt(f64, area.height) / 2.0, rotation)
    api.redraw(app)
}

fn drawControls(app: *App, keep: *Keep, doc: *state.Document, row: ui.Rect) -> void {
    const k = api.kit(app)
    const button = px(app, 24)
    const y = row.y + (row.height - button) / 2
    const notch = math.pi / 12.0
    const left = ui.rect(row.x, y, button, button)
    const upright = ui.rect(row.x + button + px(app, 2), y, button, button)
    const right = ui.rect(row.x + (button + px(app, 2)) * 2, y, button, button)
    if kit_module.iconButton(k, controlId(0), left, icons.drawFor, @intCast(usize, icons.ROTATE_LEFT), state.tr(app, "Turn the canvas left", "Leinwand nach links drehen")) { turn(app, doc, doc.*.view.rotation - notch) }
    if kit_module.iconButton(k, controlId(1), upright, icons.drawFor, @intCast(usize, icons.ROTATE_RESET), state.tr(app, "Canvas upright", "Leinwand gerade")) { turn(app, doc, 0.0) }
    if kit_module.iconButton(k, controlId(2), right, icons.drawFor, @intCast(usize, icons.ROTATE_RIGHT), state.tr(app, "Turn the canvas right", "Leinwand nach rechts drehen")) { turn(app, doc, doc.*.view.rotation + notch) }
    const x = ui.right(right) + px(app, 8)
    const slider = ui.rect(x, row.y + (row.height - px(app, 22)) / 2, ui.right(row) - x, px(app, 22))
    if slider.width < px(app, 40) { return }
    var percent = doc.*.view.zoom * 100.0
    if percent < statusbar.LEAST_ZOOM { percent = statusbar.LEAST_ZOOM }
    if percent > statusbar.MOST_ZOOM { percent = statusbar.MOST_ZOOM }
    if kit_module.slider(k, controlId(3), slider, state.tr(app, "Zoom", "Zoom"), &percent, &keep.*.zoom) {
        const area = doc.*.view.area
        viewport.zoomAt(&doc.*.view, @floatFromInt(f64, area.x) + @floatFromInt(f64, area.width) / 2.0, @floatFromInt(f64, area.y) + @floatFromInt(f64, area.height) / 2.0, percent / 100.0)
        api.redraw(app)
    }
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    keep.?.*.box = ui.rect(0, 0, 0, 0)
    const k = api.kit(app)
    const doc = api.document(app)
    if doc == null {
        kit_module.label(k, area, state.tr(app, "No image is open", "Kein Bild ist offen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    const padding = px(app, PADDING)
    const controls = px(app, CONTROLS)
    const room = ui.rect(area.x + padding, area.y + padding, area.width - padding * 2, area.height - padding * 3 - controls)
    if room.width > 0 && room.height > 0 {
        const image = doc.?.*.image
        refresh(app, keep.?, image, room)
        if keep.?.*.image == @intFromPtr(image) {
            const box = ui.rect(room.x + (room.width - keep.?.*.width) / 2, room.y + (room.height - keep.?.*.height) / 2, keep.?.*.width, keep.?.*.height)
            keep.?.*.box = box
            keep.?.*.scale = @floatFromInt(f64, keep.?.*.width) / @floatFromInt(f64, image.*.width)
            const id = view.id("nebula.overview.picture")
            view.region(state.uiOf(app), id, box)
            follow(app, keep.?, doc.?, id)
            blit(keep.?, kit_module.canvasOf(k), box)
            kit_module.frame(kit_module.canvasOf(k), ui.rect(box.x - app.*.scale, box.y - app.*.scale, box.width + 2 * app.*.scale, box.height + 2 * app.*.scale), state.themeOf(app).*.divider)
            drawOutline(app, keep.?, doc.?)
        }
    }
    drawControls(app, keep.?, doc.?, ui.rect(area.x + padding, ui.bottom(area) - padding - controls, area.width - padding * 2, controls))
}
