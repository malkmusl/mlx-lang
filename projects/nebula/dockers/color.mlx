// nebula dockers: the colour docker: the two colours painted with and the
// selector that sets them (ui/colorpicker.mlx's widgets). From the top:
//
//   the pair of colours (a click on a square chooses which one the docker
//   edits; the arrow swaps them, the small mark sets black on white), the
//   name and value of the one edited, a button that switches the selector
//   between the ring with the triangle and the square with the bar;
//   the selector, as wide as the docker; narrower when the docker is too
//   short for it and all that is below it, down to LEAST_SIDE; in a docker
//   shorter than that it is still seen whole under the pair (down to
//   SMALLEST_SIDE) and what is below it is scrolled to;
//   the sliders, folded under a heading (open: the model's choice and a
//   slider per channel);
//   the colours used last (a click takes one);
//   the hex field.
//
// The left button edits the colour chosen in the pair (the foreground at
// first), the right button dragged on the selector sets the other one.
// Painting tools say which colour a stroke used (noteUsed): the history
// keeps the last 20, newest first, in the docker's slot, as long as the
// program runs. The selector's shape, the sliders' model and whether they
// are open are kept in the settings' texts (app/settings.mlx) as "color"
// ("ring hsv folded", "square hsl open").
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const settings = @import("../app/settings.mlx")
const table = @import("../core/table.mlx")
const color_module = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const colorpicker = @import("../ui/colorpicker.mlx")

pub const App = state.App

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 1

// Sizes, times the scale: the margin, the pair's square, the gaps, a
// row, the shape button, the hex field's label and its widest; the
// selector's least side while all of the docker is seen, and its least
// side at all.
const PAD: i32 = 8
const PAIR: i32 = 44
const GAP: i32 = 8
const ROW: i32 = 24
const TITLE: i32 = 18
const BUTTON: i32 = 26
const HEX_LABEL: i32 = 34
const HEX_MOST: i32 = 120
pub const LEAST_SIDE: i32 = 150
pub const SMALLEST_SIDE: i32 = 96

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "color", .name = "Colour", .german = "Farbe", .icon = icons.DOCKER_COLOR, .draw = draw, .keyPress = null, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// Where the docker's parts were drawn in the last frame (window pixels;
// empty rectangles for what was not drawn).
pub const Layout = struct {
    // The docker's area, and its content (moved up by the scroll; taller
    // than the area when it scrolls).
    view: ui.Rect
    content: ui.Rect
    pair: ui.Rect
    title: ui.Rect
    shape: ui.Rect
    selector: ui.Rect
    // The selector's parts (colorpicker.geometry of the box and the hue).
    geometry: colorpicker.Geometry
    heading: ui.Rect
    sliders: ui.Rect
    recent: ui.Rect
    history: ui.Rect
    hexLabel: ui.Rect
    hex: ui.Rect
}

// What the docker keeps: the colours used last, the selector, how far it
// is scrolled, whether the sliders are open, whether the background is
// the colour edited, this frame's layout.
const Keep = struct {
    history: colorpicker.History
    picker: colorpicker.Picker
    ready: bool
    offset: i32
    slidersOpen: bool
    background: bool
    layout: Layout
    // The edited colour or the choices kept as text (here, not a local:
    // a local whose address is handed on is taken from the value arena
    // each frame).
    text: [24]u8
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        colorpicker.init(&keep.*.picker, app.*.allocator, app.*.foreground)
        keep.*.history.count = 0
        keep.*.offset = 0
        keep.*.slidersOpen = false
        keep.*.background = false
        keep.*.layout = emptyLayout()
        readChoices(app, keep)
        keep.*.ready = true
    }
    return keep
}

// The shape, the model and the sliders' fold as the settings keep them
// (words that are none of them are passed over).
fn readChoices(app: *App, keep: *Keep) -> void {
    const text = settings.text(app, "color")
    var at: usize = 0
    while at < text.length {
        while at < text.length && text[at] == 32 { at += 1 }
        var end = at
        while end < text.length && text[end] != 32 { end += 1 }
        const word = text[at..end]
        if std.text.same(word, "square") { colorpicker.setShape(&keep.*.picker, colorpicker.SHAPE_SQUARE) }
        if std.text.same(word, "ring") { colorpicker.setShape(&keep.*.picker, colorpicker.SHAPE_RING) }
        if std.text.same(word, "solid") { colorpicker.setShape(&keep.*.picker, colorpicker.SHAPE_SOLID) }
        if std.text.same(word, "hsv") { colorpicker.setModel(&keep.*.picker, colorpicker.MODEL_HSV) }
        if std.text.same(word, "hsl") { colorpicker.setModel(&keep.*.picker, colorpicker.MODEL_HSL) }
        if std.text.same(word, "hsy") { colorpicker.setModel(&keep.*.picker, colorpicker.MODEL_HSY) }
        if std.text.same(word, "open") { keep.*.slidersOpen = true }
        if std.text.same(word, "folded") { keep.*.slidersOpen = false }
        at = end
    }
}

// The shape, the model and the sliders' fold into the settings.
fn keepChoices(app: *App, keep: *Keep) -> void {
    const picker = &keep.*.picker
    const shape = if picker.*.shape == colorpicker.SHAPE_SQUARE { "square " } else if picker.*.shape == colorpicker.SHAPE_SOLID { "solid " } else { "ring " }
    const model = if picker.*.model == colorpicker.MODEL_HSL { "hsl " } else if picker.*.model == colorpicker.MODEL_HSY { "hsy " } else { "hsv " }
    const fold = if keep.*.slidersOpen { "open" } else { "folded" }
    const bytes: [*]u8 = &keep.*.text
    const length = std.text.append(bytes, std.text.append(bytes, std.text.append(bytes, 0, 24, shape), 24, model), 24, fold)
    _ = settings.setText(app, "color", bytes[0..length])
}

fn nothing() -> ui.Rect { return ui.rect(0, 0, 0, 0) }

fn emptyLayout() -> Layout {
    const none = nothing()
    return Layout.{ .view = none, .content = none, .pair = none, .title = none, .shape = none, .selector = none, .geometry = colorpicker.geometry(none, colorpicker.SHAPE_RING, 0.0, 1), .heading = none, .sliders = none, .recent = none, .history = none, .hexLabel = none, .hex = none }
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn baseId() -> u64 { return view.id("nebula.color") }
fn partId(part: usize) -> u64 { return view.idOf(baseId(), part) }

const PART_SCROLL: usize = 1
const PART_PAIR: usize = 2
const PART_SHAPE: usize = 3
const PART_SELECTOR: usize = 4
const PART_HEADING: usize = 5
const PART_SLIDERS: usize = 6
const PART_HISTORY: usize = 7
const PART_HEX: usize = 8

// ---------------------------------------------------------------------------
// For the other parts

// Notes that a stroke (or a fill) used `used` (straight): it becomes the
// newest colour of the docker's history. The painting tools call this as
// a stroke begins.
pub fn noteUsed(app: *App, used: u32) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    colorpicker.remember(&keep.?.*.history, used)
}

// The colours used last (null without memory).
pub fn historyOf(app: *App) -> ?*colorpicker.History {
    const keep = keepOf(app)
    if keep == null { return null }
    return &keep.?.*.history
}

// The docker's selector (its shape, its model, its render counter).
pub fn pickerOf(app: *App) -> ?*colorpicker.Picker {
    const keep = keepOf(app)
    if keep == null { return null }
    return &keep.?.*.picker
}

// Where the parts were drawn in the last frame.
pub fn layoutOf(app: *App) -> Layout {
    const keep = keepOf(app)
    if keep == null { return emptyLayout() }
    return keep.?.*.layout
}

// Whether the background is the colour the docker edits.
pub fn editsBackground(app: *App) -> bool {
    const keep = keepOf(app)
    return keep != null && keep.?.*.background
}

// ---------------------------------------------------------------------------
// Drawing

// The selector's width for a content `width` wide and a docker `height`
// tall: the width, or less when the docker is too short for it and the
// rest (with the sliders folded), never below LEAST_SIDE; in a docker
// too short for that, what lets the selector be seen whole under the
// pair (SMALLEST_SIDE to LEAST_SIDE).
fn selectorWidth(app: *App, width: i32, height: i32, shape: u8) -> i32 {
    // (The colour body takes the whole width: the docker scrolls when it
    // is taller than its panel.)
    if shape == colorpicker.SHAPE_SOLID { return width }
    const s = app.*.scale
    const above = px(app, PAD + PAIR + GAP)
    const below = px(app, GAP + ROW + GAP + TITLE) + colorpicker.historyHeight(width, s) + px(app, GAP + ROW + PAD)
    var room = height - above - below
    if room < px(app, LEAST_SIDE) {
        room = height - above - px(app, GAP)
        if room > px(app, LEAST_SIDE) { room = px(app, LEAST_SIDE) }
        if room < px(app, SMALLEST_SIDE) { room = px(app, SMALLEST_SIDE) }
    }
    if colorpicker.selectorHeight(width, shape, s) <= room { return width }
    // (The square's box is its side and the bar beside it.)
    return if shape == colorpicker.SHAPE_SQUARE { room + width - colorpicker.selectorHeight(width, shape, s) } else { room }
}

// How tall the content is for `width`.
fn contentHeight(app: *App, keep: *Keep, width: i32, height: i32) -> i32 {
    const s = app.*.scale
    const shape = keep.*.picker.shape
    var total = px(app, PAD + PAIR + GAP) + colorpicker.selectorHeight(selectorWidth(app, width, height, shape), shape, s) + px(app, GAP + ROW)
    if keep.*.slidersOpen { total += px(app, GAP) + colorpicker.slidersHeight(s) }
    total += px(app, GAP + TITLE) + colorpicker.historyHeight(width, s) + px(app, GAP + ROW + PAD)
    return total
}

// The little picture on the shape button: the other shape (the one a
// click switches to), in the button's colour.
fn drawShapeIcon(context: usize, canvas: *state.Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    const s = if size >= 24 { 2 } else { 1 }
    if context == @intCast(usize, colorpicker.SHAPE_SOLID) {
        // A cube: its front square and the one behind it.
        const side = size / 2
        const shift = size / 6
        const left = x + (size - side - shift) / 2
        const top = y + (size - side - shift) / 2 + shift
        canvas_module.strokeRoundedRect(canvas, left, top, side, side, s, s, color)
        canvas_module.strokeRoundedRect(canvas, left + shift, top - shift, side, side, s, s, color)
        return
    }
    if context == @intCast(usize, colorpicker.SHAPE_SQUARE) {
        const side = size * 2 / 3
        const bar = size / 6
        const top = y + (size - side) / 2
        canvas_module.strokeRoundedRect(canvas, x + size / 12, top, side - bar, side, s + 1, s, color)
        canvas_module.strokeRoundedRect(canvas, x + size / 12 + side - bar + size / 8, top, bar, side, s + 1, s, color)
        return
    }
    const outer = size * 3 / 4
    const left = x + (size - outer) / 2
    const top = y + (size - outer) / 2
    canvas_module.strokeRoundedRect(canvas, left, top, outer, outer, outer / 2, s + 1, color)
    // The triangle inside, as three short strokes.
    const cx = @floatFromInt(f64, left) + @floatFromInt(f64, outer) / 2.0
    const cy = @floatFromInt(f64, top) + @floatFromInt(f64, outer) / 2.0
    const r = @floatFromInt(f64, outer) * 0.28
    const weight = @floatFromInt(f64, s)
    kit_module.line(canvas, cx + r, cy, cx - r * 0.5, cy - r * 0.866, color, weight)
    kit_module.line(canvas, cx - r * 0.5, cy - r * 0.866, cx - r * 0.5, cy + r * 0.866, color, weight)
    kit_module.line(canvas, cx - r * 0.5, cy + r * 0.866, cx + r, cy, color, weight)
}

fn setEdited(app: *App, keep: *Keep, edited: u32) -> void {
    if keep.*.background { api.setBackground(app, edited) } else { api.setForeground(app, edited) }
}

fn setOther(app: *App, keep: *Keep, other: u32) -> void {
    if keep.*.background { api.setForeground(app, other) } else { api.setBackground(app, other) }
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep_found = keepOf(app)
    if keep_found == null { return }
    const keep = keep_found.?
    const k = api.kit(app)
    const s = app.*.scale
    const picker = &keep.*.picker
    // The right button for the selector (std.ui does not see it).
    picker.*.secondaryDown = app.*.buttons & state.BUTTONS_RIGHT != 0
    picker.*.secondaryX = app.*.pressX
    picker.*.secondaryY = app.*.pressY
    // Laid out for the whole width; narrower by the scroll bar when the
    // content is taller than the docker.
    var width = area.width - px(app, PAD * 2)
    var height = contentHeight(app, keep, width, area.height)
    if height > area.height {
        width -= px(app, 8)
        height = contentHeight(app, keep, width, area.height)
    }
    if width < px(app, 40) {
        keep.*.layout = emptyLayout()
        return
    }
    const content = kit_module.scrollBegin(k, partId(PART_SCROLL), area, height, &keep.*.offset)
    const left = content.x + px(app, PAD)
    var y = content.y + px(app, PAD)
    var layout = emptyLayout()
    layout.view = area
    layout.content = content

    // The pair, which one is edited, the shape.
    const pair = ui.rect(left, y, px(app, PAIR), px(app, PAIR))
    layout.pair = pair
    const clicked = kit_module.colorPair(k, partId(PART_PAIR), pair, app.*.foreground, app.*.background)
    if clicked == kit_module.PAIR_FOREGROUND {
        keep.*.background = false
    } else if clicked == kit_module.PAIR_BACKGROUND {
        keep.*.background = true
    } else if clicked == kit_module.PAIR_SWAP {
        api.swapColors(app)
    } else if clicked == kit_module.PAIR_RESET {
        api.resetColors(app)
    }
    var edited = if keep.*.background { app.*.background } else { app.*.foreground }
    const shape_button = ui.rect(left + width - px(app, BUTTON), y + (px(app, PAIR) - px(app, BUTTON)) / 2, px(app, BUTTON), px(app, BUTTON))
    layout.shape = shape_button
    // (In turn: ring and triangle, square and bar, the colour body.)
    const other_shape = if picker.*.shape == colorpicker.SHAPE_RING { colorpicker.SHAPE_SQUARE } else if picker.*.shape == colorpicker.SHAPE_SQUARE { colorpicker.SHAPE_SOLID } else { colorpicker.SHAPE_RING }
    const shape_tip = if other_shape == colorpicker.SHAPE_SQUARE { state.tr(app, "Square and bar", "Quadrat und Balken") } else if other_shape == colorpicker.SHAPE_SOLID { state.tr(app, "Colour body in 3D (OKLab, sRGB)", "Farbkörper in 3D (OKLab, sRGB)") } else { state.tr(app, "Ring and triangle", "Ring und Dreieck") }
    if kit_module.iconButton(k, partId(PART_SHAPE), shape_button, drawShapeIcon, @intCast(usize, other_shape), shape_tip) {
        colorpicker.setShape(picker, other_shape)
        keepChoices(app, keep)
        api.redraw(app)
    }
    const title = ui.rect(pair.x + pair.width + px(app, 10), y + px(app, 4), shape_button.x - pair.x - pair.width - px(app, 16), px(app, TITLE))
    layout.title = ui.rect(title.x, title.y, title.width, px(app, TITLE * 2))
    kit_module.label(k, title, if keep.*.background { state.tr(app, "Background", "Hintergrund") } else { state.tr(app, "Foreground", "Vordergrund") }, kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    const length = color_module.formatHex(edited, &keep.*.text, pixel.alpha(edited) != 255)
    const text: [*]const u8 = &keep.*.text
    kit_module.label(k, ui.rect(title.x, title.y + px(app, TITLE), title.width, px(app, TITLE)), text[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    y += px(app, PAIR + GAP)

    // The selector.
    const shape = picker.*.shape
    const selector_width = selectorWidth(app, width, area.height, shape)
    const box = ui.rect(left + (width - selector_width) / 2, y, selector_width, colorpicker.selectorHeight(selector_width, shape, s))
    layout.selector = box
    const picked = colorpicker.selector(k, picker, partId(PART_SELECTOR), box, &edited)
    layout.geometry = colorpicker.geometry(box, shape, picker.*.hue, s)
    if picked == colorpicker.PICK_SECONDARY { setOther(app, keep, picker.*.secondary) }
    // (A drag of the right button is seen by nobody else: frames while
    // it lasts.)
    if colorpicker.draggingSecondary(picker) { api.redraw(app) }
    y += box.height + px(app, GAP)

    // The sliders.
    const heading = ui.rect(left, y, width, px(app, ROW))
    layout.heading = heading
    const was_open = keep.*.slidersOpen
    const model = picker.*.model
    if kit_module.section(k, partId(PART_HEADING), heading, state.tr(app, "Sliders", "Schieberegler"), &keep.*.slidersOpen) {
        y += px(app, ROW + GAP)
        const rows = ui.rect(left, y, width, colorpicker.slidersHeight(s))
        layout.sliders = rows
        _ = colorpicker.sliders(k, picker, partId(PART_SLIDERS), rows, &edited)
        y += rows.height
    } else {
        y += px(app, ROW)
    }
    if keep.*.slidersOpen != was_open || picker.*.model != model { keepChoices(app, keep) }
    y += px(app, GAP)

    // The colours used last.
    const recent = ui.rect(left, y, width, px(app, TITLE))
    layout.recent = recent
    kit_module.label(k, recent, state.tr(app, "Used last", "Zuletzt verwendet"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    y += px(app, TITLE)
    const history = ui.rect(left, y, width, colorpicker.historyHeight(width, s))
    layout.history = history
    const taken = colorpicker.historyRow(k, partId(PART_HISTORY), history, &keep.*.history)
    if taken != null { edited = taken.? }
    y += history.height + px(app, GAP)

    // The hex field.
    const hex_label = ui.rect(left, y, px(app, HEX_LABEL), px(app, ROW))
    layout.hexLabel = hex_label
    kit_module.label(k, hex_label, "Hex", kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    const field_width = if width - px(app, HEX_LABEL) > px(app, HEX_MOST) { px(app, HEX_MOST) } else { width - px(app, HEX_LABEL) }
    const field = ui.rect(left + px(app, HEX_LABEL), y, field_width, px(app, ROW))
    layout.hex = field
    if colorpicker.hexField(k, picker, partId(PART_HEX), field, &edited) == colorpicker.HEX_WRONG {
        api.say(app, state.tr(app, "That is no colour: write #RRGGBB, #RGB or #AARRGGBB", "Das ist keine Farbe: #RRGGBB, #RGB oder #AARRGGBB schreiben"), true)
    }
    kit_module.scrollEnd(k)
    keep.*.layout = layout
    // What the widgets changed, at once (they drew it already).
    const before = if keep.*.background { app.*.background } else { app.*.foreground }
    if edited != before { setEdited(app, keep, edited) }
}
