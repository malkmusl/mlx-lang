// nebula dockers: the palette docker: a palette's colours as a grid of
// swatches to paint with. From the top: the palette shown, chosen among
// the built-in ones (core/palette.mlx) and the user's own ("My palette");
// its swatches in the palette's columns (scrolled when they do not fit);
// the swatch chosen, its name to edit and its value; buttons to add the
// foreground as a new swatch, to remove the one chosen, to import a
// palette file and to export the one shown.
//
// A click on a swatch makes its colour the foreground, with Control the
// background, and chooses it; a double click edits its colour (the colour
// dialog); its name is edited in the row under the grid (a click on it,
// or F2 over the docker). Over the docker the arrows move the choice,
// Enter makes it the foreground, Delete removes it.
//
// What is changed is kept: a palette edited (a built-in one too: its
// edited copy then takes its place) is written to the settings' texts
// (app/settings.mlx) as a GIMP palette under "palette-user" or
// "palette-N", the palette shown under "palette". A palette whose text is
// longer than a settings text may be (settings.MAX_VALUE) stays as it is
// for the run, and the status bar says to export it. Importing (.gpl,
// .aco, .ase, .kpl or a list of "#RRGGBB" lines) replaces "My palette"
// with the file's colours; exporting writes the palette shown as .gpl.
//
// Not done: groups of a palette are not shown apart (their swatches are
// in the grid in order), swatches are not dragged to new places, a
// built-in palette edited cannot be set back but by removing its text
// from the settings.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const settings = @import("../app/settings.mlx")
const shell_module = @import("../app/shell.mlx")
const table = @import("../core/table.mlx")
const pixel = @import("../core/pixel.mlx")
const color_module = @import("../core/color.mlx")
const palette_module = @import("../core/palette.mlx")
const text_io = @import("../io/text.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const filedialog = @import("../ui/filedialog.mlx")

pub const App = state.App
pub const Palette = palette_module.Palette

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 6

// The palettes to choose from: the built-in ones, then the user's.
pub const USER: usize = palette_module.BUILTINS
pub const CHOICES: usize = palette_module.BUILTINS + 1

// No swatch chosen.
pub const NOTHING: usize = kit_module.NOTHING

// Sizes, times the scale: the margin, a row, the gaps, the buttons, the
// value's width; a swatch's least and largest side.
const PAD: i32 = 8
const ROW: i32 = 24
const GAP: i32 = 6
const BUTTON: i32 = 26
const VALUE: i32 = 64
const LEAST_CELL: i32 = 12
const MOST_CELL: i32 = 36
const SCROLL_BAR: i32 = 8
// The grid's least height before the docker gives up the rest.
const LEAST_GRID: i32 = 40

// Two clicks on one swatch this close are a double click.
const DOUBLE_MS: u64 = 400

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "palette", .name = "Palette", .german = "Palette", .icon = icons.PALETTE, .draw = draw, .keyPress = keyPress, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// Where the docker's parts were drawn in the last frame (window pixels).
pub const Layout = struct {
    view: ui.Rect
    choice: ui.Rect
    grid: ui.Rect
    // A swatch's side, how many there are in a row, and how far the grid
    // is scrolled down (pixels).
    cell: i32
    columns: usize
    offset: i32
    entry: ui.Rect
    name: ui.Rect
    value: ui.Rect
    add: ui.Rect
    remove: ui.Rect
    load: ui.Rect
    save: ui.Rect
}

// What the docker keeps.
const Keep = struct {
    ready: bool
    // The palette shown (heap memory, made once), which one it is, what
    // was loaded into it last (NOTHING: nothing yet) and in which
    // language.
    palette: usize
    which: usize
    loaded: usize
    german: bool
    selected: usize
    offset: i32
    // The last click on a swatch, for double clicks.
    lastClick: usize
    lastClickTime: u64
    // The name of the chosen swatch as it is edited, and which swatch it
    // was taken from.
    name: [32]u8
    nameLength: usize
    nameOf: usize
    // The swatch whose colour the colour dialog edits.
    editing: usize
    value: [16]u8
    layout: Layout
}

fn nothing() -> ui.Rect { return ui.rect(0, 0, 0, 0) }

fn emptyLayout() -> Layout {
    const none = nothing()
    return Layout.{ .view = none, .choice = none, .grid = none, .cell = 0, .columns = 1, .offset = 0, .entry = none, .name = none, .value = none, .add = none, .remove = none, .load = none, .save = none }
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        const made = palette_module.create(app.*.allocator)
        if made == null { return null }
        keep.*.palette = @intFromPtr(made.?)
        keep.*.which = chosenAtStart(app)
        keep.*.loaded = NOTHING
        keep.*.german = false
        keep.*.selected = NOTHING
        keep.*.offset = 0
        keep.*.lastClick = NOTHING
        keep.*.lastClickTime = 0
        keep.*.nameLength = 0
        keep.*.nameOf = NOTHING
        keep.*.editing = NOTHING
        keep.*.layout = emptyLayout()
        keep.*.ready = true
    }
    return keep
}

fn paletteOf(keep: *Keep) -> *Palette { return unsafe { @ptrFromInt(*Palette, keep.*.palette) } }

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn baseId() -> u64 { return view.id("nebula.palette") }
fn partId(part: usize) -> u64 { return view.idOf(baseId(), part) }

const PART_CHOICE: usize = 1
const PART_GRID: usize = 2
const PART_NAME: usize = 3
const PART_ADD: usize = 4
const PART_REMOVE: usize = 5
const PART_LOAD: usize = 6
const PART_SAVE: usize = 7

// ---------------------------------------------------------------------------
// What is kept in the settings

// The settings' key of palette `which` ("palette-user", "palette-3").
fn keyOf(which: usize, into: *[16]u8) -> []const u8 {
    const bytes: [*]u8 = into
    var length = std.text.append(bytes, 0, 16, "palette-")
    if which >= USER {
        length = std.text.append(bytes, length, 16, "user")
    } else {
        length = std.text.appendUnsigned(bytes, length, 16, which)
    }
    return bytes[0..length]
}

// The palette shown when the program starts: the one shown last.
fn chosenAtStart(app: *App) -> usize {
    const text = settings.text(app, "palette")
    if std.text.same(text, "user") { return USER }
    if text.length == 1 && text[0] >= 48 && text[0] < 48 + @intCast(u8, palette_module.BUILTINS) { return @intCast(usize, text[0] - 48) }
    return palette_module.DEFAULT
}

fn noteChosen(app: *App, which: usize) -> void {
    var digit: [1]u8 = [1]u8{ 48 + @intCast(u8, if which < USER { which } else { 0 }) }
    if which >= USER {
        _ = settings.setText(app, "palette", "user")
    } else {
        _ = settings.setText(app, "palette", digit[0..])
    }
}

// Palette `which` into the docker's palette: its edited text when the
// settings keep one, else the built-in (or, for the user's, an empty one
// named "My palette").
fn load(app: *App, keep: *Keep, which: usize) -> void {
    const shown = paletteOf(keep)
    var key: [16]u8 = undefined
    const text = settings.text(app, keyOf(which, &key))
    var done = false
    if text.length > 0 { done = palette_module.readGpl(shown, text) }
    if !done {
        if which < USER {
            _ = palette_module.make(shown, which, app.*.german)
        } else {
            palette_module.clear(shown)
            palette_module.rename(shown, state.tr(app, "My palette", "Eigene Palette"))
            palette_module.setColumns(shown, 8)
        }
    }
    keep.*.which = which
    keep.*.loaded = which
    keep.*.german = app.*.german
    keep.*.selected = NOTHING
    keep.*.offset = 0
    keep.*.nameOf = NOTHING
}

// Whether palette `which` is as it was built in (no edited text kept).
fn untouched(app: *App, which: usize) -> bool {
    var key: [16]u8 = undefined
    return settings.text(app, keyOf(which, &key)).length == 0
}

// The palette shown was changed: its text is kept in the settings. False
// (and the status bar says why) when it is too long for them or there is
// no memory.
fn keepChanges(app: *App, keep: *Keep) -> bool {
    var text = std.ArrayList(u8).init(app.*.allocator)
    defer text.deinit()
    if !palette_module.writeGpl(paletteOf(keep), &text) {
        api.say(app, state.tr(app, "There was no memory to keep the palette", "Es fehlte Speicher, um die Palette zu behalten"), true)
        return false
    }
    if text.count() > settings.MAX_VALUE {
        api.say(app, state.tr(app, "The palette is too long to be kept: export it", "Die Palette ist zu lang, um sie zu behalten: exportieren Sie sie"), true)
        return false
    }
    var key: [16]u8 = undefined
    return settings.setText(app, keyOf(keep.*.which, &key), text.items())
}

// ---------------------------------------------------------------------------
// For the other parts and for tests

// The palette shown (null without memory), and which it is (USER: the
// user's).
pub fn paletteShown(app: *App) -> ?*Palette {
    const keep = keepOf(app)
    if keep == null { return null }
    if keep.?.*.loaded != keep.?.*.which { load(app, keep.?, keep.?.*.which) }
    return paletteOf(keep.?)
}

pub fn shown(app: *App) -> usize {
    const keep = keepOf(app)
    if keep == null { return palette_module.DEFAULT }
    return keep.?.*.which
}

// Shows palette `which` (a built-in one, or USER).
pub fn choose(app: *App, which: usize) -> void {
    const keep = keepOf(app)
    if keep == null || which >= CHOICES { return }
    load(app, keep.?, which)
    noteChosen(app, which)
    api.redraw(app)
}

// The swatch chosen (NOTHING: none).
pub fn selected(app: *App) -> usize {
    const keep = keepOf(app)
    if keep == null { return NOTHING }
    return keep.?.*.selected
}

// Where the parts were drawn in the last frame.
pub fn layoutOf(app: *App) -> Layout {
    const keep = keepOf(app)
    if keep == null { return emptyLayout() }
    return keep.?.*.layout
}

// Adds `value` as a new swatch at the end of the palette shown, named by
// its value, and chooses it. False beyond palette.MOST and without memory
// (the status bar says so).
pub fn addColor(app: *App, value: u32) -> bool {
    const keep = keepOf(app)
    if keep == null { return false }
    const palette = paletteShown(app).?
    const length = color_module.formatHex(value | 0xFF000000, &keep.?.*.value, false)
    const name: [*]const u8 = &keep.?.*.value
    if !palette_module.add(palette, value, name[0..length], 0) {
        api.say(app, state.tr(app, "The swatch could not be added", "Das Farbfeld konnte nicht hinzugefügt werden"), true)
        return false
    }
    keep.?.*.selected = palette_module.count(palette) - 1
    keep.?.*.nameOf = NOTHING
    // (Scrolled to the end: the grid holds the offset to what there is.)
    keep.?.*.offset = 2147483647
    _ = keepChanges(app, keep.?)
    api.redraw(app)
    return true
}

// Removes the swatch chosen. False when none is.
pub fn removeSelected(app: *App) -> bool {
    const keep = keepOf(app)
    if keep == null { return false }
    const palette = paletteShown(app).?
    if !palette_module.remove(palette, keep.?.*.selected) { return false }
    const count = palette_module.count(palette)
    if count == 0 { keep.?.*.selected = NOTHING } else if keep.?.*.selected >= count { keep.?.*.selected = count - 1 }
    keep.?.*.nameOf = NOTHING
    _ = keepChanges(app, keep.?)
    api.redraw(app)
    return true
}

// Writes the palette shown as a GIMP palette (.gpl) to `path`. False
// (and the status bar says so) when it could not be written.
pub fn exportTo(app: *App, path: []const u8) -> bool {
    const palette = paletteShown(app)
    if palette == null { return false }
    var text = std.ArrayList(u8).init(app.*.allocator)
    defer text.deinit()
    if !palette_module.writeGpl(palette.?, &text) || !text_io.writeFile(app.*.allocator, path, text.items()) {
        api.sayWith(app, state.tr(app, "The palette could not be written: ", "Die Palette konnte nicht geschrieben werden: "), path, true)
        return false
    }
    api.sayWith(app, state.tr(app, "Palette exported: ", "Palette exportiert: "), path, false)
    return true
}

// Reads the palette file at `path` (.gpl, .aco, .ase, .kpl or a list of
// colours) into "My palette", which is shown then. False (and the status
// bar says so) when it cannot be read; "My palette" is as it was then.
pub fn importFrom(app: *App, path: []const u8) -> bool {
    const keep = keepOf(app)
    if keep == null { return false }
    var contents: text_io.Contents = undefined
    if text_io.readFile(app.*.allocator, path, &contents) != text_io.FileStatus.ok {
        api.sayWith(app, state.tr(app, "The file could not be read: ", "Die Datei konnte nicht gelesen werden: "), path, true)
        return false
    }
    const read_into = palette_module.create(app.*.allocator)
    var kind = palette_module.UNKNOWN
    if read_into != null { kind = palette_module.read(read_into.?, contents.bytes[0..contents.length]) }
    text_io.freeFile(&contents)
    if kind == palette_module.UNKNOWN {
        if read_into != null { palette_module.destroy(read_into.?) }
        api.sayWith(app, state.tr(app, "This is no palette nebula can read: ", "Das ist keine Palette, die nebula lesen kann: "), path, true)
        return false
    }
    // A file without a name of its own is named after the file.
    if palette_module.name(read_into.?).length == 0 { palette_module.rename(read_into.?, withoutExtension(text_io.baseName(path))) }
    const copied = palette_module.copy(paletteOf(keep.?), read_into.?)
    palette_module.destroy(read_into.?)
    keep.?.*.which = USER
    keep.?.*.loaded = USER
    keep.?.*.selected = NOTHING
    keep.?.*.offset = 0
    keep.?.*.nameOf = NOTHING
    if !copied {
        // (The palette was cleared: what the settings keep comes back.)
        load(app, keep.?, USER)
        api.say(app, state.tr(app, "There was no memory for the palette", "Es fehlte Speicher für die Palette"), true)
        return false
    }
    _ = keepChanges(app, keep.?)
    noteChosen(app, USER)
    api.sayWith(app, state.tr(app, "Imported into My palette: ", "In Eigene Palette importiert: "), palette_module.name(paletteOf(keep.?)), false)
    return true
}

fn withoutExtension(name: []const u8) -> []const u8 {
    var end = name.length
    while end > 0 && name[end - 1] != 46 { end -= 1 }
    return if end > 1 { name[0..end - 1] } else { name }
}

// ---------------------------------------------------------------------------
// Dialogs

fn filtersOf(app: *App, into: *[3]filedialog.Filter) -> void {
    into.*[0] = filedialog.Filter.{ .name = "Palettes (.gpl, .aco, .ase, .kpl)", .german = "Paletten (.gpl, .aco, .ase, .kpl)", .extensions = "gpl aco ase kpl" }
    into.*[1] = filedialog.Filter.{ .name = "Colour lists (.txt, .hex)", .german = "Farblisten (.txt, .hex)", .extensions = "txt hex" }
    into.*[2] = filedialog.Filter.{ .name = "All files", .german = "Alle Dateien", .extensions = "" }
}

fn imported(app: *App, path: []const u8, filter: usize) -> void {
    _ = importFrom(app, path)
}

fn exported(app: *App, path: []const u8, filter: usize) -> void {
    _ = exportTo(app, path)
}

// Asks for a palette file to import (the file dialog).
pub fn askImport(app: *App) -> bool {
    var filters: [3]filedialog.Filter = undefined
    filtersOf(app, &filters)
    return filedialog.open(app, state.tr(app, "Import a Palette", "Palette importieren"), "", filters[0..], imported)
}

// Asks where to export the palette shown (the file dialog).
pub fn askExport(app: *App) -> bool {
    const palette = paletteShown(app)
    if palette == null { return false }
    var filters: [1]filedialog.Filter = undefined
    filters[0] = filedialog.Filter.{ .name = "GIMP palette (.gpl)", .german = "GIMP-Palette (.gpl)", .extensions = "gpl" }
    var name: [80]u8 = undefined
    const bytes: [*]u8 = &name
    var title = palette_module.name(palette.?)
    if title.length == 0 { title = "palette" }
    const length = std.text.append(bytes, std.text.append(bytes, 0, 80, title[0..(if title.length > 70 { 70 } else { title.length })]), 80, ".gpl")
    return filedialog.save(app, state.tr(app, "Export the Palette", "Palette exportieren"), "", bytes[0..length], filters[0..], exported)
}

fn edited(app: *App, value: u32) -> void {
    const keep = keepOf(app)
    if keep == null || keep.?.*.loaded != keep.?.*.which { return }
    if palette_module.setColor(paletteOf(keep.?), keep.?.*.editing, value) {
        _ = keepChanges(app, keep.?)
        api.redraw(app)
    }
}

// Opens the colour dialog for swatch `index`.
fn editColor(app: *App, keep: *Keep, index: usize) -> void {
    keep.*.editing = index
    _ = dialogs.pickColor(app, state.tr(app, "Swatch Colour", "Farbe des Farbfelds"), palette_module.colorAt(paletteOf(keep), index), edited, false)
}

// ---------------------------------------------------------------------------
// Drawing

fn choiceName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index >= USER { return state.tr(app, "My palette", "Eigene Palette") }
    return palette_module.builtinName(index, app.*.german)
}

// A swatch of the grid: its colour, square, a little in from the cell's
// edges (where the grid draws the chosen one's ring).
fn drawCell(context: usize, index: usize, canvas: *state.Canvas, cell: ui.Rect, lit: bool) -> void {
    const palette: *Palette = unsafe { @ptrFromInt(*Palette, context) }
    const inset = if cell.width >= 20 { 2 } else { 1 }
    canvas_module.fillRoundedRect(canvas, cell.x + inset, cell.y + inset, cell.width - inset * 2, cell.height - inset * 2, inset + 1, pixel.premultiplied(palette_module.colorAt(palette, index)))
}

// The side of a swatch and the columns: the palette's columns across the
// width when they fit at least LEAST_CELL, as many as fit else.
fn cellOf(app: *App, width: i32, columns: u32) -> i32 {
    const wanted = (width - px(app, SCROLL_BAR)) / @intCast(i32, if columns > 0 { columns } else { 1 })
    if wanted < px(app, LEAST_CELL) { return px(app, LEAST_CELL) }
    if wanted > px(app, MOST_CELL) { return px(app, MOST_CELL) }
    return wanted
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep_found = keepOf(app)
    if keep_found == null { return }
    const keep = keep_found.?
    // A built-in palette in the other language, when nobody changed it.
    if keep.*.loaded == keep.*.which && keep.*.german != app.*.german && untouched(app, keep.*.which) { keep.*.loaded = NOTHING }
    if keep.*.loaded != keep.*.which { load(app, keep, keep.*.which) }
    const palette = paletteOf(keep)
    const k = api.kit(app)
    const theme = state.themeOf(app)
    const left = area.x + px(app, PAD)
    const width = area.width - px(app, PAD * 2)
    keep.*.layout = emptyLayout()
    const layout = &keep.*.layout
    layout.*.view = area
    if width < px(app, 60) { return }

    // The palette shown.
    var y = area.y + px(app, PAD)
    const choice = ui.rect(left, y, width, px(app, ROW))
    layout.*.choice = choice
    var which = keep.*.which
    if kit_module.comboBoxWith(k, partId(PART_CHOICE), choice, CHOICES, choiceName, @intFromPtr(app), &which) { choose(app, which) }
    y += px(app, ROW + GAP)
    // (After the choice: another palette may be shown now.)
    const count = palette_module.count(palette)
    if keep.*.selected != NOTHING && keep.*.selected >= count { keep.*.selected = NOTHING }

    // The rows at the foot, from the bottom up: the buttons, the swatch
    // chosen; the grid takes what is between, LEAST_GRID at least (in a
    // docker too short for that what does not fit is cut off at the
    // foot).
    var foot = ui.bottom(area) - px(app, PAD)
    const least_foot = y + px(app, LEAST_GRID + GAP + ROW + GAP + BUTTON)
    if foot < least_foot { foot = least_foot }
    const buttons_y = foot - px(app, BUTTON)
    const entry_y = buttons_y - px(app, GAP) - px(app, ROW)
    const grid_bottom = entry_y - px(app, GAP)
    const cell = cellOf(app, width, palette.*.columns)
    var columns = @intCast(i32, palette.*.columns)
    if columns * cell + px(app, SCROLL_BAR) > width { columns = (width - px(app, SCROLL_BAR)) / cell }
    if columns < 1 { columns = 1 }
    // The swatches in the middle (the scroll bar's room beside them).
    const swatches = columns * cell
    var shift = (width - swatches) / 2
    if shift > width - swatches - px(app, SCROLL_BAR) { shift = width - swatches - px(app, SCROLL_BAR) }
    if shift < 0 { shift = 0 }
    const grid = ui.rect(left + shift, y, swatches + px(app, SCROLL_BAR), grid_bottom - y)
    layout.*.grid = grid
    layout.*.cell = cell
    layout.*.columns = @intCast(usize, columns)
    if count == 0 {
        kit_module.label(k, grid, state.tr(app, "No swatches yet: add the foreground with +", "Noch keine Farbfelder: + fügt die Vordergrundfarbe hinzu"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
    } else {
        const clicked = kit_module.grid(k, partId(PART_GRID), grid, cell, cell, count, keep.*.selected, &keep.*.offset, drawCell, keep.*.palette)
        layout.*.offset = keep.*.offset
        if clicked != null { clickedSwatch(app, keep, clicked.?) }
    }

    // The swatch chosen: its name, its value.
    const entry = ui.rect(left, entry_y, width, px(app, ROW))
    layout.*.entry = entry
    if keep.*.selected != NOTHING {
        drawEntry(app, keep, entry, layout)
    } else if count > 0 {
        kit_module.label(k, entry, state.tr(app, "Click a swatch to paint with it", "Ein Klick auf ein Farbfeld malt mit ihm"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    }

    // The buttons.
    const side = px(app, BUTTON)
    layout.*.add = ui.rect(left, buttons_y, side, side)
    layout.*.remove = ui.rect(left + side + px(app, 4), buttons_y, side, side)
    layout.*.save = ui.rect(left + width - side, buttons_y, side, side)
    layout.*.load = ui.rect(left + width - side * 2 - px(app, 4), buttons_y, side, side)
    if kit_module.iconButton(k, partId(PART_ADD), layout.*.add, icons.drawFor, @intCast(usize, icons.PLUS), state.tr(app, "Add the foreground colour", "Die Vordergrundfarbe hinzufügen")) { _ = addColor(app, app.*.foreground) }
    if keep.*.selected == NOTHING { kit_module.disabledBegin(k) }
    if kit_module.iconButton(k, partId(PART_REMOVE), layout.*.remove, icons.drawFor, @intCast(usize, icons.MINUS), state.tr(app, "Remove the swatch chosen", "Das gewählte Farbfeld entfernen")) { _ = removeSelected(app) }
    if keep.*.selected == NOTHING { kit_module.disabledEnd(k) }
    if kit_module.iconButton(k, partId(PART_LOAD), layout.*.load, icons.drawFor, @intCast(usize, icons.FILE_OPEN), state.tr(app, "Import a palette into My palette", "Eine Palette in Eigene Palette importieren")) { _ = askImport(app) }
    if kit_module.iconButton(k, partId(PART_SAVE), layout.*.save, icons.drawFor, @intCast(usize, icons.FILE_EXPORT), state.tr(app, "Export the palette (.gpl)", "Die Palette exportieren (.gpl)")) { _ = askExport(app) }
    // (A line between the grid and what is under it.)
    canvas_module.fillRect(kit_module.canvasOf(k), left, entry_y - px(app, GAP) / 2 - 1, width, app.*.scale, theme.*.divider)
}

// A click on swatch `index`: its colour becomes the foreground (with
// Control the background); a second click soon after on the same one
// edits its colour.
fn clickedSwatch(app: *App, keep: *Keep, index: usize) -> void {
    const k = api.kit(app)
    const palette = paletteOf(keep)
    const now = k.*.time
    const double = keep.*.lastClick == index && now >= keep.*.lastClickTime && now - keep.*.lastClickTime <= DOUBLE_MS
    keep.*.lastClick = if double { NOTHING } else { index }
    keep.*.lastClickTime = now
    keep.*.selected = index
    const value = palette_module.colorAt(palette, index)
    if shell_module.modifiers(app.*.shell) & keys.CONTROL != 0 {
        api.setBackground(app, value)
    } else {
        api.setForeground(app, value)
    }
    if double { editColor(app, keep, index) }
    api.redraw(app)
}

// The row of the swatch chosen: a small swatch, its name (a text box),
// its value.
fn drawEntry(app: *App, keep: *Keep, entry: ui.Rect, layout: *Layout) -> void {
    const k = api.kit(app)
    const palette = paletteOf(keep)
    const index = keep.*.selected
    const name_id = partId(PART_NAME)
    // The name as the palette has it, unless it is being typed.
    if keep.*.nameOf != index && !kit_module.editing(k, name_id) {
        const name = palette_module.nameAt(palette, index)
        var length: usize = 0
        while length < name.length && length < 31 {
            keep.*.name[length] = name[length]
            length += 1
        }
        keep.*.nameLength = length
        keep.*.nameOf = index
    }
    const value_width = px(app, VALUE)
    const field = ui.rect(entry.x, entry.y, entry.width - value_width - px(app, 6), entry.height)
    layout.*.name = field
    const typed = kit_module.textBox(k, name_id, field, &keep.*.name, &keep.*.nameLength, palette_module.NAME, state.tr(app, "Name", "Name"))
    if typed == kit_module.TEXT_SUBMITTED && keep.*.nameOf < palette_module.count(palette) {
        const bytes: [*]const u8 = &keep.*.name
        if !std.text.same(palette_module.nameAt(palette, keep.*.nameOf), bytes[0..keep.*.nameLength]) {
            _ = palette_module.setName(palette, keep.*.nameOf, bytes[0..keep.*.nameLength])
            _ = keepChanges(app, keep)
        }
    }
    const value = ui.rect(ui.right(entry) - value_width, entry.y, value_width, entry.height)
    layout.*.value = value
    const length = color_module.formatHex(palette_module.colorAt(palette, index), &keep.*.value, false)
    const text: [*]const u8 = &keep.*.value
    kit_module.label(k, value, text[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_RIGHT)
}

// ---------------------------------------------------------------------------
// Keys

fn keyPress(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const keep = keepOf(app)
    if keep == null || modifiers & (keys.CONTROL | keys.ALT | keys.SUPER) != 0 { return false }
    const palette = paletteShown(app).?
    const count = palette_module.count(palette)
    const columns = keep.?.*.layout.columns
    var at = keep.?.*.selected
    if code == keys.LEFT || code == keys.RIGHT || code == keys.UP || code == keys.DOWN {
        if count == 0 { return true }
        if at == NOTHING {
            at = 0
        } else if code == keys.LEFT {
            if at > 0 { at -= 1 }
        } else if code == keys.RIGHT {
            if at + 1 < count { at += 1 }
        } else if code == keys.UP {
            if at >= columns { at -= columns }
        } else if at + columns < count {
            at += columns
        }
        keep.?.*.selected = at
        api.redraw(app)
        return true
    }
    if keys.isEnter(code) && at != NOTHING {
        api.setForeground(app, palette_module.colorAt(palette, at))
        return true
    }
    if code == keys.DELETE && at != NOTHING { return removeSelected(app) }
    if keys.functionKey(code) == 2 && at != NOTHING {
        kit_module.focus(api.kit(app), partId(PART_NAME))
        api.redraw(app)
        return true
    }
    return false
}
