// nebula dockers: the layers: the tree of layers and masks of the image
// in front, a row each, the topmost first (core/node.mlx's listed order:
// a node's children under it, indented, not those of a folded one).
//
// From the top: the active node's blend mode (a list in Krita's
// categories) and opacity (0-100 %); its toggles (alpha locked, inherits
// alpha, locked, a group's pass-through) and what kind of node it is;
// the list; a row of buttons: a new paint layer (and beside it the other
// kinds of layers and masks), duplicate, delete, raise, lower,
// properties.
//
// A row: the eye (the eyes in one column), then, indented by the node's
// depth, the arrow that folds a node with children (a group, a layer with
// masks), a small picture of what the node shows, the kind's icon, the
// name (renamed in place: a double click on it, F2; Enter takes it,
// Escape leaves it), the marks of what is locked (a click takes it off).
// In a narrow docker the icon and then the picture give way to the name,
// and the buttons at the bottom shrink and then go (properties first:
// the menu has it). A click makes the node the active one (masks too); a
// double click beside the name opens its properties; a row dragged goes
// above or below the row it is let go on, into a group let go on the
// middle of the group's row (a line, or the group's outline, shows
// where); the right button opens a menu of what can be done to it. Keys
// while the pointer is over the docker: Up and Down choose the node above
// and below, Page Up and Page Down move the active one, Home and End
// choose the first and the last, Delete removes it, F2 renames it, Insert
// makes a new paint layer.
//
// Every change is one step of the image's history through core/ops.mlx;
// the opacity becomes one when the slider is let go (the canvas follows
// the drag before). The buttons do what is a plain change of the tree
// (new, duplicate, delete, raise, lower) themselves, so they work before
// the layer actions do; the menu's entries that belong to an action
// (merge down, flatten, convert, properties) run it by its key and are
// dim while it is not there.
//
// The small pictures are made from core/render.mlx's readNode, a few rows
// of the image to each row of the picture and their pixels averaged, and
// kept (THUMBS of them, in one block): they are made again only when the
// image's tree, its properties or its history moved (or it is another
// image), at most BUDGET in a frame (the rest in the frames after,
// showing the old picture meanwhile), never in a frame that only lays
// out. thumbnailsMade() counts them.
//
//     docker:  dockers/registry.mlx lists list(); ui/docks.mlx draws it
//     tests:   drawInto(app, area) is what the dock calls; rowArea(),
//              nameArea(), thumbnailArea(), partId() say where things are
//
// Not done: choosing several nodes at once (Control and Shift clicks are
// plain clicks); a colour label is shown, not set here (Properties sets
// it); folding is not a step of the history.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const glyphs = @import("std.ui.glyphs")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const shortcuts = @import("../app/shortcuts.mlx")
const table = @import("../core/table.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history_module = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")
const mask_module = @import("../core/mask.mlx")
const blend = @import("../core/blend.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const filters = @import("../filters/registry.mlx")
const generators = @import("../generators/registry.mlx")
const actions = @import("../actions/registry.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const menus = @import("../ui/menus.mlx")
const dialogs = @import("../ui/dialogs.mlx")

pub const App = state.App
pub const Node = node_module.Node
pub const Image = image_module.Image
const Kit = kit_module.Kit

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 0

// Sizes, times the theme's scale: a row of the list, the indent of a
// level, the box of a row's picture, a row of controls, the room around
// and between them, an icon.
pub const ROW: i32 = 26
const INDENT: i32 = 14
pub const THUMB_WIDTH: i32 = 30
pub const THUMB_HEIGHT: i32 = 20
const BAR: i32 = 24
const GAP: i32 = 4
const PAD: i32 = 6
const ICON: i32 = 16
// The arrow's column, the eye's and the marks' squares.
const EXPANDER: i32 = 14
const PART: i32 = 20
// The narrowest docker that has the blend mode and the opacity side by
// side; the smallest button of the bottom row.
const SIDE_BY_SIDE: i32 = 232
const SMALLEST_BUTTON: i32 = 20

// The parts of the docker (partId): the controls, the list's view and
// its empty part, the buttons, the two menus' owners, the name being
// typed.
pub const PART_BLEND: usize = 1
pub const PART_OPACITY: usize = 2
pub const PART_ALPHA_LOCK: usize = 3
pub const PART_INHERIT: usize = 4
pub const PART_LOCK: usize = 5
pub const PART_PASS: usize = 6
pub const PART_LIST: usize = 7
pub const PART_WELL: usize = 8
pub const PART_NEW: usize = 9
pub const PART_KINDS: usize = 10
pub const PART_DUPLICATE: usize = 11
pub const PART_DELETE: usize = 12
pub const PART_UP: usize = 13
pub const PART_DOWN: usize = 14
pub const PART_PROPERTIES: usize = 15
pub const PART_MENU: usize = 16
pub const PART_KINDS_MENU: usize = 17
pub const PART_RENAME: usize = 18

// What the docker keeps: pictures, rows drawn, menu entries.
const THUMBS: usize = 64
const SHOWN: usize = 256
const BLEND_ROWS: usize = 160
const ENTRIES: usize = 24
// The bytes of a shortcut's text (app/keys.mlx's format), of a new name.
const NOTE: usize = 32
const NAME_ROOM: usize = 128
// Pictures made in one frame at most; image rows and columns averaged
// into one of a picture's pixels at most.
const BUDGET: usize = 8
const SAMPLE_ROWS: i32 = 4
const SAMPLE_COLUMNS: i32 = 16
// The squares under what is transparent in a picture (greys, a side in
// picture pixels before the scale).
const CHECK: i32 = 4
const CHECK_LIGHT: u32 = 204
const CHECK_DARK: u32 = 153
// A blend list's row that is a category's heading: this bit and the
// category.
const HEADING: u16 = 32768

// What is to be done, found while the frame is drawn and done after it
// (the rows drawn must not change under the drawing): one a frame.
const DO_NOTHING: u8 = 0
const DO_ACTIVATE: u8 = 1
const DO_VISIBLE: u8 = 2
const DO_LOCK: u8 = 3
const DO_ALPHA_LOCK: u8 = 4
const DO_INHERIT: u8 = 5
const DO_PASS: u8 = 6
const DO_FOLD: u8 = 7
const DO_MOVE: u8 = 8
// A new layer (value: its kind) and a new mask on the node's layer.
const DO_NEW: u8 = 9
const DO_MASK: u8 = 10
const DO_DUPLICATE: u8 = 11
const DO_DELETE: u8 = 12
const DO_RAISE: u8 = 13
const DO_LOWER: u8 = 14
const DO_PROPERTIES: u8 = 15
const DO_RENAME_START: u8 = 16
const DO_RENAME: u8 = 17
const DO_BLEND: u8 = 18
// The menu of a row (node 0: of the list's empty part), the menu of the
// kinds under the new layer's arrow.
const DO_MENU: u8 = 19
const DO_KINDS: u8 = 20

// Where a dragged row goes against the row it is over.
const DROP_ABOVE: u8 = 0
const DROP_BELOW: u8 = 1
const DROP_INTO: u8 = 2

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "layers", .name = "Layers", .german = "Ebenen", .icon = icons.DOCKER_LAYERS, .draw = drawInto, .keyPress = keyPress, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// A row drawn this frame: its node, where, where its name begins and
// ends, its picture's box (0 wide: none, the docker is too narrow).
const Shown = struct {
    node: u32
    area: ui.Rect
    nameX: i32
    nameRight: i32
    thumb: ui.Rect
}

// A kept picture: whose, made when (the generation; 0: none), drawn
// when last (the kit's frame), and the image's part of its box (the rest
// is left to the row).
const Thumb = struct {
    node: u32
    generation: u64
    used: u64
    x: i32
    y: i32
    width: i32
    height: i32
}

const Keep = struct {
    ready: bool
    // How far the list is scrolled; the active row is to come into view.
    offset: i32
    reveal: bool
    // The nodes as listed (addresses, `rowRoom` of room in a heap block).
    rows: usize
    rowCount: usize
    rowRoom: usize
    // The kit's frame drawn in last; the list's view and the top of its
    // first row this frame; the rows drawn.
    frame: u64
    view: ui.Rect
    contentY: i32
    contentX: i32
    contentWidth: i32
    shown: [SHOWN]Shown
    shownCount: usize
    // What the pictures are of: the document, the image, its tree's and
    // its history's counts, its name's hash. When one of them moves the
    // generation does and every picture is old.
    doc: usize
    image: usize
    revision: u64
    serial: u64
    name: u64
    generation: u64
    thumbs: [THUMBS]Thumb
    // The pictures' block: THUMBS boxes of `thumbWords` words (made
    // again for boxes of another size: another scale).
    thumbPixels: usize
    thumbWords: usize
    made: u64
    madeNow: usize
    // The node whose name is being typed (0: none) and the text.
    renaming: u32
    renameText: [node_module.NAME]u8
    renameLength: usize
    // The opacity slider's value (percent) and its options; a drag of it
    // not yet recorded: on which node of which image, what it was before.
    opacity: f64
    opacityOptions: kit_module.SliderOptions
    pending: bool
    pendingNode: u32
    pendingImage: usize
    before: node_module.Props
    // A node's properties before a toggle (kept here: a local's address
    // handed on would be taken from the value arena).
    saved: node_module.Props
    // The blend list's rows (a mode, or HEADING | a category), the row
    // chosen, the language they are named in.
    blendRows: [BLEND_ROWS]u16
    blendCount: usize
    blendChosen: usize
    german: bool
    // The frame's command.
    command: u8
    commandNode: u32
    commandValue: usize
    commandParent: u32
    // A row dragged (0: none) and where it would go: into which parent,
    // at which index; the line's place, the row outlined (0: none).
    dragNode: u32
    dropOk: bool
    dropParent: u32
    dropIndex: usize
    dropY: i32
    dropX: i32
    dropInto: u32
    // The menu being opened: its entries, what each does and with what,
    // the shortcuts' texts; the node it is for; the kinds' button.
    entries: [ENTRIES]menus.Entry
    entryDo: [ENTRIES]u8
    entryValue: [ENTRIES]u8
    notes: [ENTRIES][NOTE]u8
    entryCount: usize
    menuNode: u32
    kindsButton: ui.Rect
    // A name made for a new node.
    nameRoom: [NAME_ROOM]u8
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        // (The slot comes zeroed: what is not set here starts at 0.)
        keep.*.opacityOptions = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
        keep.*.opacityOptions.suffix = " %"
        keep.*.opacity = 100.0
        buildBlendRows(keep)
        keep.*.ready = true
    }
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn tr(app: *App, english: []const u8, german: []const u8) -> []const u8 { return state.tr(app, english, german) }

fn same(a: *Node, b: *Node) -> bool { return @intFromPtr(a) == @intFromPtr(b) }

// ---------------------------------------------------------------------------
// Ids (for tests, and whoever points at a part of the docker)

pub fn partId(part: usize) -> u64 { return view.idOf(view.id("nebula.layers"), part) }

pub fn rowId(node: u32) -> u64 { return view.idOf(view.id("nebula.layers.row"), @intCast(usize, node)) }

pub fn eyeId(node: u32) -> u64 { return view.idOf(view.id("nebula.layers.eye"), @intCast(usize, node)) }

pub fn expanderId(node: u32) -> u64 { return view.idOf(view.id("nebula.layers.fold"), @intCast(usize, node)) }

// The marks at a row's right: alpha locked, locked, inherits alpha,
// passes through.
pub fn alphaMarkId(node: u32) -> u64 { return view.idOf(view.id("nebula.layers.alpha"), @intCast(usize, node)) }

pub fn lockMarkId(node: u32) -> u64 { return view.idOf(view.id("nebula.layers.lock"), @intCast(usize, node)) }

pub fn inheritMarkId(node: u32) -> u64 { return view.idOf(view.id("nebula.layers.inherit"), @intCast(usize, node)) }

pub fn passMarkId(node: u32) -> u64 { return view.idOf(view.id("nebula.layers.pass"), @intCast(usize, node)) }

// ---------------------------------------------------------------------------
// What was drawn (for tests)

// The pictures made since the program began.
pub fn thumbnailsMade(app: *App) -> u64 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.made
}

// The nodes listed in the last frame, in the list's order: how many, and
// the number (id) of the one at `index` (0 past the end).
pub fn rowCount(app: *App) -> usize {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.rowCount
}

pub fn rowNode(app: *App, index: usize) -> u32 {
    const keep = keepOf(app)
    if keep == null || index >= keep.?.*.rowCount { return 0 }
    return nodeAt(keep.?, index).*.id
}

// How far the list is scrolled (pixels).
pub fn scrollOffset(app: *App) -> i32 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.offset
}

// The node whose name is being typed (0: none).
pub fn renaming(app: *App) -> u32 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.renaming
}

fn shownOf(app: *App, node: u32) -> ?*Shown {
    const keep = keepOf(app)
    if keep == null || keep.?.*.frame != api.kit(app).*.frame { return null }
    var index: usize = 0
    while index < keep.?.*.shownCount {
        if keep.?.*.shown[index].node == node { return &keep.?.*.shown[index] }
        index += 1
    }
    return null
}

// Where node `node`'s row was drawn in the last frame (empty: not in
// view; a row half in view is the part in view).
pub fn rowArea(app: *App, node: u32) -> ui.Rect {
    const shown = shownOf(app, node)
    if shown == null { return ui.rect(0, 0, 0, 0) }
    return ui.intersect(shown.?.*.area, keepOf(app).?.*.view)
}

// Where its name was (a double click there renames it).
pub fn nameArea(app: *App, node: u32) -> ui.Rect {
    const shown = shownOf(app, node)
    if shown == null { return ui.rect(0, 0, 0, 0) }
    const area = shown.?.*.area
    return ui.intersect(ui.rect(shown.?.*.nameX, area.y, shown.?.*.nameRight - shown.?.*.nameX, area.height), keepOf(app).?.*.view)
}

// Where its picture's box was (empty: none was drawn).
pub fn thumbnailArea(app: *App, node: u32) -> ui.Rect {
    const shown = shownOf(app, node)
    if shown == null { return ui.rect(0, 0, 0, 0) }
    return ui.intersect(shown.?.*.thumb, keepOf(app).?.*.view)
}

// ---------------------------------------------------------------------------
// Names

// A kind of node as people read it.
pub fn kindTitle(kind: u8, german: bool) -> []const u8 {
    if kind == node_module.PAINT { return if german { "Malebene" } else { "Paint Layer" } }
    if kind == node_module.GROUP { return if german { "Gruppe" } else { "Group" } }
    if kind == node_module.FILL { return if german { "Füllebene" } else { "Fill Layer" } }
    if kind == node_module.FILTER { return if german { "Filterebene" } else { "Filter Layer" } }
    if kind == node_module.CLONE { return if german { "Klonebene" } else { "Clone Layer" } }
    if kind == node_module.VECTOR { return if german { "Vektorebene" } else { "Vector Layer" } }
    if kind == node_module.FILE { return if german { "Dateiebene" } else { "File Layer" } }
    if kind == node_module.TRANSPARENCY_MASK { return if german { "Transparenzmaske" } else { "Transparency Mask" } }
    if kind == node_module.FILTER_MASK { return if german { "Filtermaske" } else { "Filter Mask" } }
    if kind == node_module.COLORIZE_MASK { return if german { "Einfärbemaske" } else { "Colorize Mask" } }
    if kind == node_module.TRANSFORM_MASK { return if german { "Transformationsmaske" } else { "Transform Mask" } }
    if kind == node_module.SELECTION_MASK { return if german { "Lokale Auswahl" } else { "Local Selection" } }
    return ""
}

// The word a new node of `kind` is named with, a number after it (masks
// have their kind's name alone).
fn kindWord(kind: u8, german: bool) -> []const u8 {
    if kind == node_module.PAINT { return if german { "Ebene" } else { "Layer" } }
    if kind == node_module.GROUP { return if german { "Gruppe" } else { "Group" } }
    if kind == node_module.FILL { return if german { "Füllung" } else { "Fill" } }
    if kind == node_module.FILTER { return "Filter" }
    if kind == node_module.CLONE { return if german { "Klon" } else { "Clone" } }
    if kind == node_module.VECTOR { return if german { "Vektor" } else { "Vector" } }
    if kind == node_module.FILE { return if german { "Datei" } else { "File" } }
    return ""
}

fn kindIcon(kind: u8) -> u16 {
    if kind == node_module.GROUP { return icons.KIND_GROUP }
    if kind == node_module.FILL { return icons.KIND_FILL }
    if kind == node_module.FILTER { return icons.KIND_FILTER }
    if kind == node_module.CLONE { return icons.KIND_CLONE }
    if kind == node_module.VECTOR { return icons.KIND_VECTOR }
    if kind == node_module.FILE { return icons.KIND_FILE }
    if kind == node_module.TRANSPARENCY_MASK { return icons.MASK_TRANSPARENCY }
    if kind == node_module.FILTER_MASK { return icons.MASK_FILTER }
    if kind == node_module.COLORIZE_MASK { return icons.MASK_COLORIZE }
    if kind == node_module.TRANSFORM_MASK { return icons.MASK_TRANSFORM }
    if kind == node_module.SELECTION_MASK { return icons.MASK_SELECTION }
    return icons.KIND_PAINT
}

// The largest n of the names "`word` n" under `node`.
fn largestNumber(node: *Node, word: []const u8) -> u32 {
    var largest: u32 = 0
    for child in node.*.children.items() {
        const name = node_module.nameOf(child)
        if name.length > word.length + 1 && std.text.startsWith(name, word) && name[word.length] == 32 {
            var value: u32 = 0
            var index = word.length + 1
            var digits = true
            while index < name.length && digits {
                const byte = name[index]
                if byte < 48 || byte > 57 || value > 100000000 {
                    digits = false
                } else {
                    value = value * 10 + @intCast(u32, byte - 48)
                }
                index += 1
            }
            if digits && value > largest { largest = value }
        }
        const below = largestNumber(child, word)
        if below > largest { largest = below }
    }
    return largest
}

// The name a new node of `kind` gets (in the keep's room: good until the
// next one is made).
fn newName(app: *App, keep: *Keep, image: *Image, kind: u8) -> []const u8 {
    const room: [*]u8 = &keep.*.nameRoom
    if node_module.isMask(kind) { return kindTitle(kind, app.*.german) }
    const word = kindWord(kind, app.*.german)
    var length = std.text.append(room, 0, NAME_ROOM, word)
    length = std.text.append(room, length, NAME_ROOM, " ")
    length = std.text.appendUnsigned(room, length, NAME_ROOM, @intCast(usize, largestNumber(image.*.root, word)) + 1)
    return room[0..length]
}

// ---------------------------------------------------------------------------
// The blend modes' list

fn buildBlendRows(keep: *Keep) -> void {
    var count: usize = 0
    var last: u8 = 255
    var index: usize = 0
    const modes = blend.listedCount()
    while index < modes && count + 2 <= BLEND_ROWS {
        const mode = blend.listed(index)
        const category = blend.category(mode)
        if category != last {
            keep.*.blendRows[count] = HEADING | @intCast(u16, category)
            count += 1
            last = category
        }
        keep.*.blendRows[count] = mode
        count += 1
        index += 1
    }
    keep.*.blendCount = count
}

fn keepFrom(context: usize) -> *Keep { unsafe { return @ptrFromInt(*Keep, context) } }

fn blendName(context: usize, index: usize) -> []const u8 {
    const keep = keepFrom(context)
    if index >= keep.*.blendCount { return "" }
    const row = keep.*.blendRows[index]
    if row & HEADING != 0 { return blend.categoryTitle(@intCast(u8, row & 255), keep.*.german) }
    return blend.title(row, keep.*.german)
}

fn blendKind(context: usize, index: usize) -> u8 {
    const keep = keepFrom(context)
    if index < keep.*.blendCount && keep.*.blendRows[index] & HEADING != 0 { return kit_module.LIST_HEADING }
    return kit_module.LIST_ITEM
}

fn blendRowOf(keep: *Keep, mode: u16) -> usize {
    var index: usize = 0
    while index < keep.*.blendCount {
        if keep.*.blendRows[index] == mode { return index }
        index += 1
    }
    return 1
}

// ---------------------------------------------------------------------------
// The list

fn rowsOf(keep: *Keep) -> [*]usize { unsafe { return @ptrFromInt([*]usize, keep.*.rows) } }

fn nodeAt(keep: *Keep, index: usize) -> *Node { unsafe { return @ptrFromInt(*Node, rowsOf(keep)[index]) } }

fn gather(keep: *Keep, node: *Node) -> void {
    var index = node_module.childCount(node)
    while index > 0 {
        index -= 1
        if keep.*.rowCount >= keep.*.rowRoom { return }
        const child = node_module.childAt(node, index)
        rowsOf(keep)[keep.*.rowCount] = @intFromPtr(child)
        keep.*.rowCount += 1
        if !child.*.collapsed { gather(keep, child) }
    }
}

// The image's nodes as the list shows them (into the keep's block, made
// larger when the image has more; without memory the list ends early).
fn listRows(app: *App, keep: *Keep, image: *Image) -> void {
    keep.*.rowCount = 0
    const wanted = image_module.nodeCount(image)
    if wanted > keep.*.rowRoom {
        var room = keep.*.rowRoom * 2
        if room < wanted + 64 { room = wanted + 64 }
        const memory = app.*.allocator.alloc(room * 8, 16)
        if memory != null {
            if keep.*.rowRoom > 0 { unsafe { app.*.allocator.free(@ptrFromInt([*]u8, keep.*.rows), keep.*.rowRoom * 8, 16) } }
            keep.*.rows = @intFromPtr(memory.?)
            keep.*.rowRoom = room
        }
    }
    gather(keep, image.*.root)
}

fn indexOf(keep: *Keep, node: *Node) -> ?usize {
    var index: usize = 0
    while index < keep.*.rowCount {
        if rowsOf(keep)[index] == @intFromPtr(node) { return index }
        index += 1
    }
    return null
}

// How many groups and layers are above the node in the tree (the root's
// children: 0).
fn levelOf(node: *Node) -> i32 {
    const depth = node_module.depth(node)
    return if depth > 0 { @intCast(i32, depth - 1) } else { 0 }
}

// The indent of a row `width` wide for `level`: INDENT a level, at most a
// third of the row (the name keeps its room however deep the tree).
fn indentFor(app: *App, level: i32, width: i32) -> i32 {
    const most = if width > 0 { width / 3 } else { 0 }
    const indent = if level < 64 { level * px(app, INDENT) } else { most }
    return if indent > most { most } else { indent }
}

fn indentOf(app: *App, node: *Node, width: i32) -> i32 { return indentFor(app, levelOf(node), width) }

// Where a row's arrow column begins, from the row's left edge.
fn treeX(app: *App) -> i32 { return px(app, 4) + px(app, PART) + px(app, 2) }

// ---------------------------------------------------------------------------
// The frame's command

fn setCommand(keep: *Keep, command: u8, node: u32, value: usize, parent: u32) -> void {
    if keep.*.command != DO_NOTHING { return }
    keep.*.command = command
    keep.*.commandNode = node
    keep.*.commandValue = value
    keep.*.commandParent = parent
}

// Whether the right button went down on `id` (the kit keeps what it was
// pressed on for a slider to open; anything else of the docker's is
// taken here).
fn rightClicked(k: *Kit, id: u64) -> bool {
    if k.*.secondaryId != id || id == view.NONE { return false }
    k.*.secondaryId = view.NONE
    return true
}

// ---------------------------------------------------------------------------
// Pictures

// The pictures' block for boxes of `words` words; false without memory.
fn thumbBlock(app: *App, keep: *Keep, words: usize) -> bool {
    if keep.*.thumbPixels != 0 && keep.*.thumbWords == words { return true }
    if keep.*.thumbPixels != 0 {
        unsafe { app.*.allocator.free(@ptrFromInt([*]u8, keep.*.thumbPixels), THUMBS * keep.*.thumbWords * 4, 16) }
        keep.*.thumbPixels = 0
    }
    var index: usize = 0
    while index < THUMBS {
        keep.*.thumbs[index].generation = 0
        keep.*.thumbs[index].node = 0
        index += 1
    }
    const memory = app.*.allocator.alloc(THUMBS * words * 4, 16)
    if memory == null { return false }
    keep.*.thumbPixels = @intFromPtr(memory.?)
    keep.*.thumbWords = words
    return true
}

fn thumbWords(keep: *Keep, index: usize) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, keep.*.thumbPixels + index * keep.*.thumbWords * 4) }
}

// One row of what `node` shows at image row `y`, `width` pixels: a
// mask's and a filter layer's amounts as greys, anything else as
// render.readNode makes it.
fn readRow(image: *Image, node: *Node, y: i32, width: i32, row: [*]u32, amounts: [*]u8) -> void {
    const count = @intCast(usize, width)
    const kind = node.*.kind
    if node_module.isMask(kind) || kind == node_module.FILTER {
        if node.*.device == null {
            var index: usize = 0
            while index < count {
                row[index] = 0
                index += 1
            }
            return
        }
        mask_module.readBytes(node.*.device.?, ui.rect(0, y, width, 1), amounts, count)
        var index: usize = 0
        while index < count {
            const grey = @intCast(u32, amounts[index])
            row[index] = 0xFF000000 | (grey << 16) | (grey << 8) | grey
            index += 1
        }
        return
    }
    render.readNode(image, node, ui.rect(0, y, width, 1), row)
}

fn channelOf(sum: f64, count: f64, under: u32, alpha: f64) -> u32 {
    // The premultiplied average, over the opaque grey `under`.
    const value = sum / (count * 255.0) + @floatFromInt(f64, under) * (255.0 - alpha) / 255.0 + 0.5
    if !(value > 0.0) { return 0 }
    if value >= 255.0 { return 255 }
    return @intFromFloat(u32, value)
}

// The picture of `node` into `into` (a box `box_width` x `box_height`):
// the image fitted into the box and centred, each pixel the average of
// up to SAMPLE_ROWS x SAMPLE_COLUMNS of the image's, over grey squares,
// opaque; the rest of the box 0. Its place in the box into `thumb`.
fn makeThumbnail(image: *Image, node: *Node, into: [*]u32, box_width: i32, box_height: i32, scale: i32, thumb: *Thumb) -> void {
    var index: usize = 0
    const words = @intCast(usize, box_width) * @intCast(usize, box_height)
    while index < words {
        into[index] = 0
        index += 1
    }
    const width = image.*.width
    const height = image.*.height
    var fit_width = box_width
    var fit_height = box_height
    if @intCast(i64, width) * @intCast(i64, box_height) >= @intCast(i64, height) * @intCast(i64, box_width) {
        fit_height = @intCast(i32, @intCast(i64, height) * @intCast(i64, box_width) / @intCast(i64, width))
        if fit_height < 1 { fit_height = 1 }
    } else {
        fit_width = @intCast(i32, @intCast(i64, width) * @intCast(i64, box_height) / @intCast(i64, height))
        if fit_width < 1 { fit_width = 1 }
    }
    thumb.*.x = (box_width - fit_width) / 2
    thumb.*.y = (box_height - fit_height) / 2
    thumb.*.width = fit_width
    thumb.*.height = fit_height
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const row = scratch.words(pool, @intCast(usize, width))
    const amounts = scratch.bytes(pool, @intCast(usize, width))
    const sums = scratch.doubles(pool, @intCast(usize, fit_width) * 5)
    if row == null || amounts == null || sums == null {
        scratch.release(pool, mark)
        return
    }
    const cell = CHECK * (if scale > 0 { scale } else { 1 })
    var ty: i32 = 0
    while ty < fit_height {
        const y0 = @intCast(i32, @intCast(i64, ty) * @intCast(i64, height) / @intCast(i64, fit_height))
        var y1 = @intCast(i32, @intCast(i64, ty + 1) * @intCast(i64, height) / @intCast(i64, fit_height))
        if y1 <= y0 { y1 = y0 + 1 }
        const span = y1 - y0
        const samples = if span < SAMPLE_ROWS { span } else { SAMPLE_ROWS }
        var at: usize = 0
        while at < @intCast(usize, fit_width) * 5 {
            sums.?[at] = 0.0
            at += 1
        }
        var sample: i32 = 0
        while sample < samples {
            // The rows in the middle of equal parts of the band.
            const y = y0 + @intCast(i32, @intCast(i64, span) * @intCast(i64, 2 * sample + 1) / @intCast(i64, 2 * samples))
            readRow(image, node, y, width, row.?, amounts.?)
            var tx: i32 = 0
            while tx < fit_width {
                const x0 = @intCast(i32, @intCast(i64, tx) * @intCast(i64, width) / @intCast(i64, fit_width))
                var x1 = @intCast(i32, @intCast(i64, tx + 1) * @intCast(i64, width) / @intCast(i64, fit_width))
                if x1 <= x0 { x1 = x0 + 1 }
                var step = (x1 - x0) / SAMPLE_COLUMNS
                if step < 1 { step = 1 }
                const base = @intCast(usize, tx) * 5
                var x = x0
                while x < x1 {
                    const word = row.?[@intCast(usize, x)]
                    const alpha = word >> 24
                    sums.?[base] += @floatFromInt(f64, alpha)
                    sums.?[base + 1] += @floatFromInt(f64, ((word >> 16) & 255) * alpha)
                    sums.?[base + 2] += @floatFromInt(f64, ((word >> 8) & 255) * alpha)
                    sums.?[base + 3] += @floatFromInt(f64, (word & 255) * alpha)
                    sums.?[base + 4] += 1.0
                    x += step
                }
                tx += 1
            }
            sample += 1
        }
        var tx: i32 = 0
        while tx < fit_width {
            const base = @intCast(usize, tx) * 5
            const count = if sums.?[base + 4] > 0.0 { sums.?[base + 4] } else { 1.0 }
            const alpha = sums.?[base] / count
            const odd = ((tx / cell) + (ty / cell)) & 1 == 1
            const under = if odd { CHECK_DARK } else { CHECK_LIGHT }
            const red = channelOf(sums.?[base + 1], count, under, alpha)
            const green = channelOf(sums.?[base + 2], count, under, alpha)
            const blue = channelOf(sums.?[base + 3], count, under, alpha)
            into[@intCast(usize, (thumb.*.y + ty) * box_width + thumb.*.x + tx)] = 0xFF000000 | (red << 16) | (green << 8) | blue
            tx += 1
        }
        ty += 1
    }
    scratch.release(pool, mark)
}

// The kept picture of `node` for boxes of `box_width` x `box_height`:
// made when it is old and the frame's budget allows (the old one, or
// none, otherwise: another frame is asked for). Null: none to show.
fn thumbnailOf(app: *App, keep: *Keep, image: *Image, node: *Node, box_width: i32, box_height: i32) -> ?usize {
    const words = @intCast(usize, box_width) * @intCast(usize, box_height)
    if !thumbBlock(app, keep, words) { return null }
    var found: ?usize = null
    // The place for a new one: an empty one, else the one drawn longest
    // ago.
    var oldest: usize = 0
    var index: usize = 0
    while index < THUMBS {
        const thumb = &keep.*.thumbs[index]
        if thumb.*.generation != 0 && thumb.*.node == node.*.id { found = index }
        const best = &keep.*.thumbs[oldest]
        if best.*.generation != 0 && (thumb.*.generation == 0 || thumb.*.used < best.*.used) { oldest = index }
        index += 1
    }
    const frame = keep.*.frame
    if found != null && keep.*.thumbs[found.?].generation == keep.*.generation {
        keep.*.thumbs[found.?].used = frame
        return found
    }
    if keep.*.madeNow >= BUDGET {
        // The rest in the next frames.
        state.uiOf(app).*.changed = true
        if found != null { keep.*.thumbs[found.?].used = frame }
        return found
    }
    const slot = if found != null { found.? } else { oldest }
    const thumb = &keep.*.thumbs[slot]
    makeThumbnail(image, node, thumbWords(keep, slot), box_width, box_height, app.*.scale, thumb)
    thumb.*.node = node.*.id
    thumb.*.generation = keep.*.generation
    thumb.*.used = frame
    keep.*.made += 1
    keep.*.madeNow += 1
    return slot
}

// The picture of `node` in `box`, framed (nothing on a frame that only
// lays out).
fn drawThumbnail(app: *App, keep: *Keep, k: *Kit, image: *Image, node: *Node, box: ui.Rect) -> void {
    const canvas = kit_module.canvasOf(k)
    if canvas.*.device != 0 || canvas.*.width == 0 || canvas.*.height == 0 { return }
    const theme = state.themeOf(app)
    const edge = theme_module.mix(theme.*.field, theme.*.border, 420)
    const found = thumbnailOf(app, keep, image, node, box.width, box.height)
    if found == null {
        kit_module.checker(canvas, box, px(app, CHECK))
        kit_module.frame(canvas, box, edge)
        return
    }
    const thumb = &keep.*.thumbs[found.?]
    const words = thumbWords(keep, found.?)
    const width = @intCast(i32, canvas.*.width)
    const height = @intCast(i32, canvas.*.height)
    var row = thumb.*.y
    while row < thumb.*.y + thumb.*.height {
        const y = box.y + row
        if y >= 0 && y < height {
            var column = thumb.*.x
            while column < thumb.*.x + thumb.*.width {
                const x = box.x + column
                if x >= 0 && x < width {
                    var word = words[@intCast(usize, row * box.width + column)]
                    if canvas.*.swapRedBlue { word = (word & 0xFF00FF00) | ((word >> 16) & 255) | ((word & 255) << 16) }
                    canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)] = word
                }
                column += 1
            }
        }
        row += 1
    }
    const s = app.*.scale
    kit_module.frame(canvas, ui.rect(box.x + thumb.*.x - s, box.y + thumb.*.y - s, thumb.*.width + 2 * s, thumb.*.height + 2 * s), edge)
}

// ---------------------------------------------------------------------------
// What the pictures are of

fn nameHash(text: []const u8) -> u64 {
    var hash: u64 = 14695981039346656037
    for byte in text { hash = (hash ^ @intCast(u64, byte)) *% 1099511628211 }
    return hash
}

// Another document, image, tree or history step than the pictures were
// made for: they are all old. (The document's name tells apart an image
// made where a closed one was.) Another image starts at the top of its
// list with its active row in view.
fn watch(keep: *Keep, doc: *state.Document, image: *Image) -> void {
    const serial = image.*.history.*.serial
    const bytes: [*]const u8 = &doc.*.name
    const name = nameHash(bytes[0..doc.*.nameLength])
    const other = keep.*.doc != @intFromPtr(doc) || keep.*.image != @intFromPtr(image)
    if !other && keep.*.name == name && keep.*.revision == image.*.revision && keep.*.serial == serial { return }
    keep.*.generation += 1
    keep.*.doc = @intFromPtr(doc)
    keep.*.image = @intFromPtr(image)
    keep.*.name = name
    keep.*.revision = image.*.revision
    keep.*.serial = serial
    if other {
        keep.*.offset = 0
        keep.*.reveal = true
        keep.*.renaming = 0
        keep.*.dragNode = 0
        keep.*.pending = false
    }
}

// ---------------------------------------------------------------------------
// The opacity

fn percentOf(opacity: u8) -> f64 {
    return @floatFromInt(f64, (@intCast(u32, opacity) * 100 + 127) / 255)
}

fn opacityOf(percent: f64) -> u8 {
    var whole: u32 = 0
    if percent >= 100.0 {
        whole = 100
    } else if percent > 0.0 {
        whole = @intFromFloat(u32, percent + 0.5)
    }
    return @intCast(u8, (whole * 255 + 50) / 100)
}

// The slider's drag not yet recorded becomes one step (none when the
// opacity is what it was).
fn commitOpacity(app: *App, keep: *Keep) -> void {
    if !keep.*.pending { return }
    keep.*.pending = false
    const image = api.image(app)
    if image == null || @intFromPtr(image.?) != keep.*.pendingImage { return }
    const node = image_module.find(image.?, keep.*.pendingNode)
    if node == null || node.?.*.opacity == keep.*.before.opacity { return }
    ops.changed(image.?, node.?, &keep.*.before, tr(app, "Layer opacity", "Ebenendeckkraft"))
    api.layersChanged(app)
}

// ---------------------------------------------------------------------------
// Drawing

// A small square part of a row (the eye, a mark): `icon` in `color`, lit
// under the pointer; true when clicked.
fn iconPart(app: *App, k: *Kit, id: u64, area: ui.Rect, icon: u16, color: u32) -> bool {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    view.region(widgets, id, area)
    const lit = view.isHover(widgets, id) || (view.isPressed(widgets, id) && widgets.*.pointerDown)
    const canvas = kit_module.canvasOf(k)
    if lit { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.buttonHover) }
    const size = px(app, ICON)
    icons.draw(canvas, icon, area.x + (area.width - size) / 2, area.y + (area.height - size) / 2, size, if lit { theme.*.text } else { color })
    return view.takeClick(widgets, id)
}

// The blend mode and the opacity of `node` (dim and taking nothing when
// there is none, or it is a mask: a mask is not mixed, it is applied).
fn drawControls(app: *App, keep: *Keep, k: *Kit, image: *Image, node: ?*Node, combo: ui.Rect, bar: ui.Rect) -> void {
    const none = node == null || node_module.isMask(node.?.*.kind)
    keep.*.blendChosen = blendRowOf(keep, if none { blend.NORMAL } else { node.?.*.blend })
    if none { kit_module.disabledBegin(k) }
    if kit_module.comboBoxKinds(k, partId(PART_BLEND), combo, keep.*.blendCount, blendName, blendKind, @intFromPtr(keep), &keep.*.blendChosen) && !none {
        const row = keep.*.blendRows[keep.*.blendChosen]
        if row & HEADING == 0 { setCommand(keep, DO_BLEND, node.?.*.id, @intCast(usize, row), 0) }
    }
    if none { kit_module.disabledEnd(k) }
    // The canvas follows a drag; the step is made when it ends.
    const id = partId(PART_OPACITY)
    keep.*.opacityOptions.disabled = none
    if !keep.*.pending { keep.*.opacity = if none { 100.0 } else { percentOf(node.?.*.opacity) } }
    if kit_module.slider(k, id, bar, tr(app, "Opacity", "Deckkraft"), &keep.*.opacity, &keep.*.opacityOptions) && !none {
        const target = node.?
        if !keep.*.pending {
            keep.*.before = node_module.props(target)
            keep.*.pending = true
            keep.*.pendingNode = target.*.id
            keep.*.pendingImage = @intFromPtr(image)
        }
        const opacity = opacityOf(keep.*.opacity)
        if target.*.opacity != opacity {
            target.*.opacity = opacity
            image_module.damage(image, history_module.footprint(image, target))
            api.canvasChanged(app)
        }
    }
    const widgets = state.uiOf(app)
    const held = view.isPressed(widgets, id) && widgets.*.pointerDown
    if keep.*.pending && (kit_module.released(k, id) || (!held && !kit_module.editing(k, id))) { commitOpacity(app, keep) }
}

fn toggle(k: *Kit, part: usize, area: ui.Rect, icon: u16, on: bool, tip: []const u8) -> bool {
    return kit_module.toolButton(k, partId(part), area, icons.drawFor, @intCast(usize, icon), on, tip)
}

// The toggles of `node` (each dim where it means nothing: alpha lock for
// a group and a mask, inherit alpha for a mask, pass-through for all but
// a group) and, after them, what kind of node it is.
fn drawToggles(app: *App, keep: *Keep, k: *Kit, node: ?*Node, area: ui.Rect) -> void {
    const size = area.height
    const step = size + px(app, 2)
    var x = area.x
    const none = node == null
    var id: u32 = 0
    if !none { id = node.?.*.id }
    const mask = !none && node_module.isMask(node.?.*.kind)
    const can_alpha = !none && !mask && node.?.*.kind != node_module.GROUP
    if none { kit_module.disabledBegin(k) }
    if !can_alpha && !none { kit_module.disabledBegin(k) }
    if toggle(k, PART_ALPHA_LOCK, ui.rect(x, area.y, size, size), icons.ALPHA_LOCKED, can_alpha && node.?.*.alphaLocked, tr(app, "Lock alpha: paint only where there is paint", "Alpha sperren: nur malen, wo schon Farbe ist")) && can_alpha { setCommand(keep, DO_ALPHA_LOCK, id, 0, 0) }
    if !can_alpha && !none { kit_module.disabledEnd(k) }
    x += step
    if mask { kit_module.disabledBegin(k) }
    if toggle(k, PART_INHERIT, ui.rect(x, area.y, size, size), icons.INHERIT_ALPHA, !none && !mask && node.?.*.inheritAlpha, tr(app, "Inherit alpha: show only over the layers below in the group", "Alpha erben: nur über den Ebenen darunter in der Gruppe zeigen")) && !none && !mask { setCommand(keep, DO_INHERIT, id, 0, 0) }
    if mask { kit_module.disabledEnd(k) }
    x += step
    if toggle(k, PART_LOCK, ui.rect(x, area.y, size, size), icons.LOCKED, !none && node.?.*.locked, tr(app, "Lock the layer", "Ebene sperren")) && !none { setCommand(keep, DO_LOCK, id, 0, 0) }
    x += step
    const group = !none && node.?.*.kind == node_module.GROUP
    if !group && !none { kit_module.disabledBegin(k) }
    if toggle(k, PART_PASS, ui.rect(x, area.y, size, size), icons.PASS_THROUGH, group && node.?.*.passThrough, tr(app, "Pass through: the group's layers mix with what is below it", "Durchreichen: die Ebenen der Gruppe mischen sich mit dem darunter")) && group { setCommand(keep, DO_PASS, id, 0, 0) }
    if !group && !none { kit_module.disabledEnd(k) }
    x += step
    if none { kit_module.disabledEnd(k) }
    // (Not in a docker too narrow for the word.)
    const room = ui.rect(x + px(app, 6), area.y, ui.right(area) - x - px(app, 6), size)
    if !none && room.width >= px(app, 56) { kit_module.label(k, room, kindTitle(node.?.*.kind, app.*.german), kit_module.TEXT_DIM, kit_module.ALIGN_RIGHT) }
}

// A mark at a row's right that takes a lock off when clicked.
fn mark(app: *App, keep: *Keep, k: *Kit, id: u64, area: ui.Rect, icon: u16, command: u8, node: u32) -> void {
    if iconPart(app, k, id, area, icon, state.themeOf(app).*.dim) { setCommand(keep, command, node, 0, 0) }
}

// The typed name is taken (an empty one or the same one changes
// nothing).
fn finishRename(app: *App, keep: *Keep, image: *Image, node: *Node) -> void {
    keep.*.renaming = 0
    const typed: [*]const u8 = &keep.*.renameText
    const text = std.text.trimmed(typed[0..keep.*.renameLength])
    if text.length == 0 || std.text.same(text, node_module.nameOf(node)) { return }
    ops.rename(image, node, text, tr(app, "Rename layer", "Ebene umbenennen"))
    api.layersChanged(app)
}

fn drawRow(app: *App, keep: *Keep, k: *Kit, image: *Image, node: *Node, place: ui.Rect) -> void {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const s = app.*.scale
    const id = node.*.id
    const active = image.*.active != null && same(image.*.active.?, node)
    const row_id = rowId(id)
    const clicked = kit_module.listRow(k, row_id, place, active, false)
    const h = place.height
    // A colour label: a stripe at the row's left.
    if node.*.label != 0 { canvas_module.fillRect(kit_module.canvasOf(k), place.x + s, place.y + 4 * s, 3 * s, h - 8 * s, pixel.premultiplied(dialogs.labelColor(node.*.label))) }
    // The eyes in one column; after them the tree's indent and arrow.
    const part = px(app, PART)
    const part_y = place.y + (h - part) / 2
    const shown = node_module.isShown(node)
    if iconPart(app, k, eyeId(id), ui.rect(place.x + px(app, 4), part_y, part, part), if node.*.visible { icons.VISIBLE } else { icons.HIDDEN }, if node.*.visible { theme.*.dim } else { theme.*.disabled }) { setCommand(keep, DO_VISIBLE, id, 0, 0) }
    var x = place.x + treeX(app) + indentOf(app, node, place.width)
    if node_module.childCount(node) > 0 {
        var open = !node.*.collapsed
        if kit_module.expander(k, expanderId(id), x + px(app, 2), place.y + (h - px(app, 10)) / 2, &open) { setCommand(keep, DO_FOLD, id, 0, 0) }
    }
    x += px(app, EXPANDER)
    // The marks of what is locked take their room from the right.
    var marks: i32 = 0
    if node.*.alphaLocked { marks += 1 }
    if node.*.inheritAlpha { marks += 1 }
    if node.*.locked { marks += 1 }
    if node.*.kind == node_module.GROUP && node.*.passThrough { marks += 1 }
    var right = ui.right(place) - px(app, 3) - marks * part
    const marks_x = right
    // The picture and the kind's icon give way to the name in a narrow
    // docker: the icon first.
    const thumb_room = px(app, THUMB_WIDTH) + px(app, 8)
    const icon = px(app, ICON)
    const icon_room = icon + px(app, 6)
    const least_name = px(app, 48)
    const with_icon = right - x - thumb_room - icon_room >= least_name
    const with_thumb = right - x - thumb_room - (if with_icon { icon_room } else { 0 }) >= least_name
    const box = ui.rect(x, place.y + (h - px(app, THUMB_HEIGHT)) / 2, if with_thumb { px(app, THUMB_WIDTH) } else { 0 }, px(app, THUMB_HEIGHT))
    if with_thumb {
        drawThumbnail(app, keep, k, image, node, box)
        x += thumb_room
    }
    if with_icon {
        icons.draw(kit_module.canvasOf(k), kindIcon(node.*.kind), x, place.y + (h - icon) / 2, icon, if shown { theme.*.dim } else { theme.*.disabled })
        x += icon_room
    }
    right = marks_x + marks * part
    if node.*.alphaLocked {
        right -= part
        mark(app, keep, k, alphaMarkId(id), ui.rect(right, part_y, part, part), icons.ALPHA_LOCKED, DO_ALPHA_LOCK, id)
    }
    if node.*.inheritAlpha {
        right -= part
        mark(app, keep, k, inheritMarkId(id), ui.rect(right, part_y, part, part), icons.INHERIT_ALPHA, DO_INHERIT, id)
    }
    if node.*.locked {
        right -= part
        mark(app, keep, k, lockMarkId(id), ui.rect(right, part_y, part, part), icons.LOCKED, DO_LOCK, id)
    }
    if node.*.kind == node_module.GROUP && node.*.passThrough {
        right -= part
        mark(app, keep, k, passMarkId(id), ui.rect(right, part_y, part, part), icons.PASS_THROUGH, DO_PASS, id)
    }
    // The name, or the field it is typed in.
    const name_area = ui.rect(x, place.y, marks_x - px(app, 4) - x, h)
    if keep.*.renaming == id {
        const field = ui.rect(name_area.x - px(app, 4), place.y + 2 * s, name_area.width + px(app, 4), h - 4 * s)
        const result = kit_module.textBox(k, partId(PART_RENAME), field, &keep.*.renameText, &keep.*.renameLength, node_module.NAME, "")
        if result == kit_module.TEXT_SUBMITTED {
            finishRename(app, keep, image, node)
        } else if result == kit_module.TEXT_CANCELLED {
            keep.*.renaming = 0
        }
    } else {
        kit_module.label(k, name_area, node_module.nameOf(node), if shown { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_LEFT)
    }
    if keep.*.shownCount < SHOWN {
        keep.*.shown[keep.*.shownCount] = Shown.{ .node = id, .area = place, .nameX = name_area.x, .nameRight = ui.right(name_area), .thumb = box }
        keep.*.shownCount += 1
    }
    // What the pointer did: a click chooses, a double click renames (on
    // the name) or opens the properties, the right button the menu.
    if clicked == kit_module.ROW_CLICKED {
        setCommand(keep, DO_ACTIVATE, id, 0, 0)
    } else if clicked == kit_module.ROW_DOUBLE_CLICKED {
        const on_name = widgets.*.pointerX >= name_area.x && widgets.*.pointerX < ui.right(name_area)
        setCommand(keep, if on_name { DO_RENAME_START } else { DO_PROPERTIES }, id, 0, 0)
    }
    if rightClicked(k, row_id) || rightClicked(k, eyeId(id)) || rightClicked(k, expanderId(id)) || rightClicked(k, alphaMarkId(id)) || rightClicked(k, lockMarkId(id)) || rightClicked(k, inheritMarkId(id)) || rightClicked(k, passMarkId(id)) {
        setCommand(keep, DO_MENU, id, 0, 0)
    }
    if kit_module.dragRow(k, row_id, place) { keep.*.dragNode = id }
}

// Where the row dragged would go with the pointer at `pointer_y`: above
// or below the row it is over, into a group over the middle of its row
// (a mask: among a layer's masks, or onto a layer); a layer only among
// the layers of a group, never into itself. dropOk says whether it would
// go anywhere new.
fn findDrop(app: *App, keep: *Keep, image: *Image, pointer_y: i32) -> void {
    keep.*.dropOk = false
    keep.*.dropInto = 0
    const count = keep.*.rowCount
    const dragged = image_module.find(image, keep.*.dragNode)
    if dragged == null || count == 0 || dragged.?.*.parent == null { return }
    const node = dragged.?
    const row = px(app, ROW)
    const offset = pointer_y - keep.*.contentY
    var index: usize = 0
    var quarter: i32 = 0
    if offset >= 0 {
        const at = @intCast(usize, offset / row)
        if at >= count {
            index = count - 1
            quarter = 3
        } else {
            index = at
            quarter = (offset - @intCast(i32, at) * row) * 4 / row
        }
    }
    var target = nodeAt(keep, index)
    var mode = if quarter < 2 { DROP_ABOVE } else { DROP_BELOW }
    const moving_mask = node_module.isMask(node.*.kind)
    if moving_mask {
        if !node_module.isMask(target.*.kind) { mode = DROP_INTO }
    } else if node_module.isMask(target.*.kind) {
        // Among a layer's masks: below that layer.
        target = node_module.layerOf(target)
        mode = DROP_BELOW
    } else if target.*.kind == node_module.GROUP && quarter >= 1 && quarter <= 2 && !same(target, node) {
        mode = DROP_INTO
    }
    var parent = target
    var place: usize = 0
    if mode == DROP_INTO {
        place = node_module.childCount(target)
    } else {
        if target.*.parent == null { return }
        parent = target.*.parent.?
        const at = node_module.indexIn(parent, target)
        if at == null { return }
        place = if mode == DROP_ABOVE { at.? + 1 } else { at.? }
    }
    if node_module.isUnder(parent, node) { return }
    if !moving_mask && parent.*.kind != node_module.GROUP { return }
    if moving_mask && node_module.isMask(parent.*.kind) { return }
    // The index it has once it is there (taken out first when it comes
    // from the same parent); where it is already: nowhere new.
    var final = place
    if node.*.parent != null && same(node.*.parent.?, parent) {
        const was = node_module.indexIn(parent, node)
        if was == null { return }
        if was.? < place { final = place - 1 }
        if final == was.? { return }
    }
    const target_index = indexOf(keep, target)
    if target_index == null { return }
    keep.*.dropOk = true
    keep.*.dropParent = parent.*.id
    keep.*.dropIndex = final
    const level = node_module.depth(parent)
    keep.*.dropX = keep.*.contentX + px(app, 2) + treeX(app) + indentFor(app, if level < 64 { @intCast(i32, level) } else { 64 }, keep.*.contentWidth - px(app, 4))
    if mode == DROP_INTO {
        keep.*.dropInto = target.*.id
        keep.*.dropY = keep.*.contentY + @intCast(i32, target_index.? + 1) * row
    } else if mode == DROP_ABOVE {
        keep.*.dropY = keep.*.contentY + @intCast(i32, target_index.?) * row
    } else {
        // Under the target's row and the rows of all that is in it.
        var last = target_index.?
        while last + 1 < count && node_module.isUnder(nodeAt(keep, last + 1), target) { last += 1 }
        keep.*.dropY = keep.*.contentY + @intCast(i32, last + 1) * row
    }
}

// The list in `area`: a well, scrolled when its rows do not fit.
fn drawList(app: *App, keep: *Keep, k: *Kit, image: *Image, area: ui.Rect) -> void {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const s = app.*.scale
    const canvas = kit_module.canvasOf(k)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.field)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, s, theme_module.mix(theme.*.field, theme.*.border, 330))
    const inner = ui.rect(area.x + s, area.y + s, area.width - 2 * s, area.height - 2 * s)
    keep.*.view = inner
    if inner.width <= 0 || inner.height <= 0 { return }
    const row = px(app, ROW)
    const count = keep.*.rowCount
    // A drag let go: the row goes where the line showed.
    if keep.*.dragNode != 0 && !(view.isPressed(widgets, rowId(keep.*.dragNode)) && widgets.*.pointerDown) {
        if kit_module.dropped(k, rowId(keep.*.dragNode)) && keep.*.dropOk { setCommand(keep, DO_MOVE, keep.*.dragNode, keep.*.dropIndex, keep.*.dropParent) }
        keep.*.dragNode = 0
        keep.*.dropOk = false
    }
    // A drag at the list's ends scrolls it (no wheel needed).
    if keep.*.dragNode != 0 {
        if widgets.*.pointerY < inner.y + row / 2 { keep.*.offset -= row / 3 }
        if widgets.*.pointerY > ui.bottom(inner) - row / 2 { keep.*.offset += row / 3 }
        if keep.*.offset < 0 { keep.*.offset = 0 }
    }
    if keep.*.reveal && image.*.active != null {
        const at = indexOf(keep, image.*.active.?)
        if at != null {
            const top = @intCast(i32, at.?) * row
            if top < keep.*.offset { keep.*.offset = top }
            if top + row > keep.*.offset + inner.height { keep.*.offset = top + row - inner.height }
        }
    }
    keep.*.reveal = false
    const content = kit_module.scrollBegin(k, partId(PART_LIST), inner, @intCast(i32, count) * row, &keep.*.offset)
    keep.*.contentY = content.y
    keep.*.contentX = content.x
    keep.*.contentWidth = content.width
    // The list's empty part: its right button opens the menu of new
    // layers.
    view.region(widgets, partId(PART_WELL), inner)
    if rightClicked(k, partId(PART_WELL)) { setCommand(keep, DO_MENU, 0, 0, 0) }
    // Only the rows in view are drawn and name regions.
    var at: usize = if keep.*.offset > 0 { @intCast(usize, keep.*.offset / row) } else { 0 }
    while at < count {
        const place = ui.rect(content.x + px(app, 2), content.y + @intCast(i32, at) * row, content.width - px(app, 4), row)
        if place.y >= ui.bottom(inner) { break }
        drawRow(app, keep, k, image, nodeAt(keep, at), place)
        at += 1
    }
    if count == 0 { kit_module.label(k, inner, tr(app, "No layers", "Keine Ebenen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER) }
    if keep.*.dragNode != 0 {
        findDrop(app, keep, image, widgets.*.pointerY)
        if keep.*.dropOk {
            if keep.*.dropInto != 0 {
                var index: usize = 0
                while index < keep.*.shownCount {
                    const shown = &keep.*.shown[index]
                    if shown.*.node == keep.*.dropInto { canvas_module.strokeRoundedRect(kit_module.canvasOf(k), shown.*.area.x, shown.*.area.y, shown.*.area.width, shown.*.area.height, theme.*.smallRadius, 2 * s, theme.*.accent) }
                    index += 1
                }
            }
            kit_module.dropLine(k, keep.*.dropY, keep.*.dropX, content.x + content.width - px(app, 8))
        }
    }
    kit_module.scrollEnd(k)
}

// Where `node` goes when raised (`up`) or lowered: past the next sibling
// of its sort (layers past layers, masks past masks), and out of its
// group at the group's end (a layer). No parent: it cannot go.
const Step = struct {
    parent: ?*Node
    index: usize
}

fn sameSort(a: *Node, b: *Node) -> bool { return node_module.isMask(a.*.kind) == node_module.isMask(b.*.kind) }

fn stepOf(node: *Node, up: bool) -> Step {
    var step = Step.{ .parent = null, .index = 0 }
    if node.*.parent == null { return step }
    const parent = node.*.parent.?
    const at = node_module.indexIn(parent, node)
    if at == null { return step }
    const count = node_module.childCount(parent)
    if up {
        var next = at.? + 1
        while next < count && !sameSort(node_module.childAt(parent, next), node) { next += 1 }
        if next < count {
            step.parent = parent
            step.index = next
            return step
        }
    } else {
        var next = at.?
        while next > 0 {
            next -= 1
            if sameSort(node_module.childAt(parent, next), node) {
                step.parent = parent
                step.index = next
                return step
            }
        }
    }
    if node_module.isMask(node.*.kind) || parent.*.parent == null { return step }
    const outer = parent.*.parent.?
    const place = node_module.indexIn(outer, parent)
    if place == null { return step }
    step.parent = outer
    step.index = if up { place.? + 1 } else { place.? }
    return step
}

fn button(k: *Kit, part: usize, area: ui.Rect, icon: u16, tip: []const u8) -> bool {
    return kit_module.iconButton(k, partId(part), area, icons.drawFor, @intCast(usize, icon), tip)
}

// The row of buttons along the bottom: new (and the other kinds),
// duplicate, delete; raise, lower; properties at the right. In a narrow
// docker the gaps shrink, then properties goes (its menu entry stays),
// then raise and lower (Page Up and Page Down stay), before a button
// gets smaller than SMALLEST_BUTTON.
fn drawButtons(app: *App, keep: *Keep, k: *Kit, node: ?*Node, area: ui.Rect) -> void {
    const s = app.*.scale
    const arrow = px(app, 14)
    var gap = px(app, 6)
    var count: i32 = 6
    if area.height * count + arrow + gap * 3 > area.width { gap = px(app, 2) }
    var size = (area.width - arrow - gap * 3) / count
    if size < px(app, SMALLEST_BUTTON) {
        count = 5
        size = (area.width - arrow - gap * 2) / count
    }
    if size < px(app, SMALLEST_BUTTON) {
        count = 3
        size = (area.width - arrow - gap) / count
    }
    if size > area.height { size = area.height }
    if size < px(app, 12) { size = px(app, 12) }
    const y = area.y + (area.height - size) / 2
    var x = area.x
    if button(k, PART_NEW, ui.rect(x, y, size, size), icons.LAYER_NEW, tr(app, "New paint layer (Insert)", "Neue Malebene (Einfg)")) { setCommand(keep, DO_NEW, 0, @intCast(usize, node_module.PAINT), 0) }
    x += size
    const kinds = ui.rect(x, y, arrow, size)
    keep.*.kindsButton = kinds
    if kit_module.iconButton(k, partId(PART_KINDS), kinds, null, 0, tr(app, "Other kinds of layers, and masks", "Andere Ebenenarten und Masken")) { setCommand(keep, DO_KINDS, 0, 0, 0) }
    const canvas = kit_module.canvasOf(k)
    if canvas.*.width > 0 { glyphs.arrowScaled(canvas, kinds.x + (arrow - 8 * s) / 2, y + (size - 10 * s) / 2, true, state.themeOf(app).*.text, s) }
    x += arrow + gap
    const none = node == null
    var id: u32 = 0
    if !none { id = node.?.*.id }
    if none { kit_module.disabledBegin(k) }
    if button(k, PART_DUPLICATE, ui.rect(x, y, size, size), icons.LAYER_DUPLICATE, tr(app, "Duplicate", "Duplizieren")) && !none { setCommand(keep, DO_DUPLICATE, id, 0, 0) }
    x += size
    if button(k, PART_DELETE, ui.rect(x, y, size, size), icons.LAYER_DELETE, tr(app, "Delete (Delete)", "Löschen (Entf)")) && !none { setCommand(keep, DO_DELETE, id, 0, 0) }
    x += size + gap
    if none { kit_module.disabledEnd(k) }
    if count >= 5 {
        const can_raise = !none && stepOf(node.?, true).parent != null
        if !can_raise { kit_module.disabledBegin(k) }
        if button(k, PART_UP, ui.rect(x, y, size, size), icons.LAYER_UP, tr(app, "Raise (Page Up)", "Anheben (Bild auf)")) && can_raise { setCommand(keep, DO_RAISE, id, 0, 0) }
        if !can_raise { kit_module.disabledEnd(k) }
        x += size
        const can_lower = !none && stepOf(node.?, false).parent != null
        if !can_lower { kit_module.disabledBegin(k) }
        if button(k, PART_DOWN, ui.rect(x, y, size, size), icons.LAYER_DOWN, tr(app, "Lower (Page Down)", "Absenken (Bild ab)")) && can_lower { setCommand(keep, DO_LOWER, id, 0, 0) }
        if !can_lower { kit_module.disabledEnd(k) }
    }
    if count >= 6 {
        if none { kit_module.disabledBegin(k) }
        if button(k, PART_PROPERTIES, ui.rect(ui.right(area) - size, y, size, size), icons.LAYER_PROPERTIES, tr(app, "Properties", "Eigenschaften")) && !none { setCommand(keep, DO_PROPERTIES, id, 0, 0) }
        if none { kit_module.disabledEnd(k) }
    }
}

// Draws the docker into `area` (ui/docks.mlx calls it inside the kit's
// clip of `area`; a test may call it inside a frame of its own).
pub fn drawInto(app: *App, area: ui.Rect) -> void {
    const found = keepOf(app)
    if found == null { return }
    const keep = found.?
    const k = api.kit(app)
    // Not drawn in the frame before: what was shown then may be another
    // image now at the same address (one closed, another made).
    if keep.*.frame + 1 != k.*.frame { keep.*.generation += 1 }
    keep.*.frame = k.*.frame
    keep.*.madeNow = 0
    keep.*.shownCount = 0
    keep.*.view = ui.rect(0, 0, 0, 0)
    keep.*.german = app.*.german
    keep.*.command = DO_NOTHING
    takeMenuChoice(app, keep)
    const doc = api.document(app)
    if doc == null {
        keep.*.pending = false
        keep.*.renaming = 0
        keep.*.dragNode = 0
        keep.*.rowCount = 0
        keep.*.command = DO_NOTHING
        kit_module.label(k, area, tr(app, "No image is open", "Kein Bild ist offen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    const image = doc.?.*.image
    watch(keep, doc.?, image)
    const node = image.*.active
    if keep.*.pending && (node == null || node.?.*.id != keep.*.pendingNode) { commitOpacity(app, keep) }
    listRows(app, keep, image)
    const pad = px(app, PAD)
    const gap = px(app, GAP)
    const bar = px(app, BAR)
    const inner = ui.rect(area.x + pad, area.y + pad, area.width - pad * 2, area.height - pad * 2)
    if inner.width > 0 && inner.height > 0 {
        // The blend mode and the opacity side by side, or one over the
        // other in a narrow docker.
        var y = inner.y
        var combo = ui.rect(inner.x, y, inner.width, bar)
        var slider = combo
        if inner.width >= px(app, SIDE_BY_SIDE) {
            combo.width = (inner.width - gap) * 9 / 20
            slider = ui.rect(ui.right(combo) + gap, y, inner.width - combo.width - gap, bar)
            y += bar + gap
        } else {
            slider.y = y + bar + gap
            y += (bar + gap) * 2
        }
        drawControls(app, keep, k, image, node, combo, slider)
        const buttons = ui.rect(inner.x, ui.bottom(inner) - bar, inner.width, bar)
        // The toggles while the list keeps two rows.
        if buttons.y - gap - (y + bar + gap) >= px(app, ROW) * 2 {
            drawToggles(app, keep, k, node, ui.rect(inner.x, y, inner.width, bar))
            y += bar + gap
        }
        if buttons.y - gap > y { drawList(app, keep, k, image, ui.rect(inner.x, y, inner.width, buttons.y - gap - y)) }
        drawButtons(app, keep, k, node, buttons)
    }
    // A name whose edit is gone (its row was not drawn, the node went)
    // is no longer being typed.
    const rename_id = partId(PART_RENAME)
    if keep.*.renaming != 0 && !kit_module.editing(k, rename_id) && k.*.wantedId != rename_id { keep.*.renaming = 0 }
    perform(app, keep)
}

// ---------------------------------------------------------------------------
// Menus

fn addEntry(keep: *Keep, name: []const u8, note: []const u8, action: []const u8, flags: u8, command: u8, value: u8) -> void {
    if keep.*.entryCount >= ENTRIES { return }
    const index = keep.*.entryCount
    keep.*.entries[index] = menus.Entry.{ .name = name, .note = note, .action = action, .flags = flags }
    keep.*.entryDo[index] = command
    keep.*.entryValue[index] = value
    keep.*.entryCount = index + 1
}

// An entry that runs the action `key` when there is one (its shortcut
// beside it, dim when it cannot run now), else does `command` here (dim
// when there is none or it cannot be done: `able`).
fn actionEntry(app: *App, keep: *Keep, name: []const u8, key: []const u8, flags: u8, command: u8, value: u8, able: bool) -> void {
    if keep.*.entryCount >= ENTRIES { return }
    const action = actions.byKey(key)
    if action != null {
        var shown = flags
        if !api.actionEnabled(app, action.?) { shown |= menus.ENTRY_DISABLED }
        const note: [*]u8 = &keep.*.notes[keep.*.entryCount]
        const length = keys.format(shortcuts.ofAction(app, action.?), note)
        addEntry(keep, name, note[0..length], key, shown, DO_NOTHING, 0)
        return
    }
    addEntry(keep, name, "", "", if command != DO_NOTHING && able { flags } else { flags | menus.ENTRY_DISABLED }, command, value)
}

// The kinds of new nodes (`menu`: as a context menu says them, "New
// ..."); the masks and the clone need a node (`able`).
fn addKinds(app: *App, keep: *Keep, able: bool, flags: u8, menu: bool) -> void {
    const off = if able { 0 } else { menus.ENTRY_DISABLED }
    const separator = menus.ENTRY_SEPARATOR_BEFORE
    addEntry(keep, if menu { tr(app, "New Paint Layer", "Neue Malebene") } else { tr(app, "Paint Layer", "Malebene") }, tr(app, "Insert", "Einfg"), "", flags, DO_NEW, node_module.PAINT)
    addEntry(keep, if menu { tr(app, "New Group", "Neue Gruppe") } else { tr(app, "Group", "Gruppe") }, "", "", 0, DO_NEW, node_module.GROUP)
    actionEntry(app, keep, if menu { tr(app, "New Filter Layer", "Neue Filterebene") } else { tr(app, "Filter Layer", "Filterebene") }, "layer_new_filter", 0, DO_NEW, node_module.FILTER, true)
    actionEntry(app, keep, if menu { tr(app, "New Fill Layer", "Neue Füllebene") } else { tr(app, "Fill Layer", "Füllebene") }, "layer_new_fill", 0, DO_NEW, node_module.FILL, true)
    addEntry(keep, if menu { tr(app, "New Clone Layer", "Neue Klonebene") } else { tr(app, "Clone Layer", "Klonebene") }, "", "", off, DO_NEW, node_module.CLONE)
    addEntry(keep, if menu { tr(app, "New Vector Layer", "Neue Vektorebene") } else { tr(app, "Vector Layer", "Vektorebene") }, "", "", 0, DO_NEW, node_module.VECTOR)
    addEntry(keep, if menu { tr(app, "New File Layer", "Neue Dateiebene") } else { tr(app, "File Layer", "Dateiebene") }, "", "", 0, DO_NEW, node_module.FILE)
    addEntry(keep, kindTitle(node_module.TRANSPARENCY_MASK, app.*.german), "", "", off | separator, DO_MASK, node_module.TRANSPARENCY_MASK)
    addEntry(keep, kindTitle(node_module.FILTER_MASK, app.*.german), "", "", off, DO_MASK, node_module.FILTER_MASK)
    addEntry(keep, kindTitle(node_module.COLORIZE_MASK, app.*.german), "", "", off, DO_MASK, node_module.COLORIZE_MASK)
    addEntry(keep, kindTitle(node_module.TRANSFORM_MASK, app.*.german), "", "", off, DO_MASK, node_module.TRANSFORM_MASK)
    addEntry(keep, kindTitle(node_module.SELECTION_MASK, app.*.german), "", "", off, DO_MASK, node_module.SELECTION_MASK)
}

// The menu of node `id` (0: of the list's empty part) at the pointer; the
// node becomes the active one.
fn openMenu(app: *App, keep: *Keep, image: *Image, id: u32) -> void {
    var node: ?*Node = null
    if id != 0 { node = image_module.find(image, id) }
    if node != null { image.*.active = node.? }
    const able = node != null
    const off = if able { 0 } else { menus.ENTRY_DISABLED }
    const separator = menus.ENTRY_SEPARATOR_BEFORE
    keep.*.entryCount = 0
    keep.*.menuNode = if able { id } else { 0 }
    addEntry(keep, tr(app, "Rename", "Umbenennen"), "F2", "", off, DO_RENAME_START, 0)
    actionEntry(app, keep, tr(app, "Duplicate", "Duplizieren"), "layer_duplicate", 0, DO_DUPLICATE, 0, able)
    actionEntry(app, keep, tr(app, "Delete", "Löschen"), "layer_delete", 0, DO_DELETE, 0, able)
    addKinds(app, keep, able, separator, true)
    actionEntry(app, keep, tr(app, "Merge Down", "Nach unten vereinen"), "layer_merge_down", separator, DO_NOTHING, 0, false)
    actionEntry(app, keep, tr(app, "Flatten Layer", "Ebene verflachen"), "layer_flatten", 0, DO_NOTHING, 0, false)
    actionEntry(app, keep, tr(app, "Convert to Paint Layer", "In Malebene umwandeln"), "layer_convert_to_paint", 0, DO_NOTHING, 0, false)
    actionEntry(app, keep, tr(app, "Flatten Image", "Bild verflachen"), "image_flatten", 0, DO_NOTHING, 0, false)
    actionEntry(app, keep, tr(app, "Properties…", "Eigenschaften …"), "layer_properties", separator, DO_PROPERTIES, 0, able)
    const widgets = state.uiOf(app)
    menus.popup(app, partId(PART_MENU), widgets.*.pointerX + 1, widgets.*.pointerY + 1, keep.*.entries[0..keep.*.entryCount])
}

// The kinds of new nodes under the arrow beside the new layer's button
// (over it when there is no room under it).
fn openKinds(app: *App, keep: *Keep, image: *Image) -> void {
    const node = image.*.active
    keep.*.entryCount = 0
    keep.*.menuNode = if node != null { node.?.*.id } else { 0 }
    addKinds(app, keep, node != null, 0, false)
    const anchor = keep.*.kindsButton
    // (About the list's height: rows and a separator.)
    const tall = @intCast(i32, keep.*.entryCount) * px(app, 26) + px(app, 24)
    const y = if ui.bottom(anchor) + tall <= ui.bottom(app.*.window) { ui.bottom(anchor) } else { anchor.y }
    menus.popup(app, partId(PART_KINDS_MENU), anchor.x, y, keep.*.entries[0..keep.*.entryCount])
}

// An entry chosen in one of the docker's menus since the last frame: its
// command.
fn takeMenuChoice(app: *App, keep: *Keep) -> void {
    var chosen = menus.chosen(app, partId(PART_MENU))
    if chosen == null { chosen = menus.chosen(app, partId(PART_KINDS_MENU)) }
    if chosen == null || chosen.? >= keep.*.entryCount { return }
    const command = keep.*.entryDo[chosen.?]
    if command == DO_NOTHING { return }
    setCommand(keep, command, keep.*.menuNode, @intCast(usize, keep.*.entryValue[chosen.?]), 0)
}

// ---------------------------------------------------------------------------
// Doing

fn noMemory(app: *App) -> void {
    api.say(app, tr(app, "There is no memory for it", "Dafür fehlt der Speicher"), true)
}

// A new layer of `kind` above the active one (a clone beside what it
// shows); a filter and a fill layer through their actions when they are
// there (they ask how), else with the first filter's settings and the
// foreground colour.
fn newLayer(app: *App, keep: *Keep, image: *Image, kind: u8) -> void {
    if kind == node_module.FILTER && actions.byKey("layer_new_filter") != null {
        _ = api.run(app, "layer_new_filter")
        return
    }
    if kind == node_module.FILL && actions.byKey("layer_new_fill") != null {
        _ = api.run(app, "layer_new_fill")
        return
    }
    var source: ?*Node = null
    if image.*.active != null { source = node_module.layerOf(image.*.active.?) }
    if kind == node_module.CLONE && source == null { return }
    const made = node_module.create(image.*.allocator, kind, image_module.newId(image), newName(app, keep, image, kind))
    if made == null {
        noMemory(app)
        return
    }
    const node = made.?
    if kind == node_module.FILL {
        generators.defaults(generators.COLOR, &node.*.params)
        const color = app.*.foreground
        node.*.params.values[0] = @floatFromInt(f64, (color >> 16) & 255)
        node.*.params.values[1] = @floatFromInt(f64, (color >> 8) & 255)
        node.*.params.values[2] = @floatFromInt(f64, color & 255)
        node.*.params.values[3] = @floatFromInt(f64, color >> 24)
    } else if kind == node_module.FILTER {
        const first = filters.at(0)
        if first != null { filters.defaults(first.?.*.id, &node.*.params) }
    }
    var place = ops.placeForNew(image)
    if kind == node_module.CLONE {
        node.*.cloneOf = source.?.*.id
        // Beside what it shows, never inside it.
        if source.?.*.parent != null {
            const at = node_module.indexIn(source.?.*.parent.?, source.?)
            if at != null { place = ops.Place.{ .parent = source.?.*.parent.?, .index = at.? + 1 } }
        }
    }
    if !ops.add(image, node, place.parent, place.index, tr(app, "New layer", "Neue Ebene")) {
        node_module.destroy(node)
        noMemory(app)
        return
    }
    keep.*.reveal = true
}

// A new mask of `kind` on the layer of `node` (after its other masks),
// active.
fn newMask(app: *App, keep: *Keep, image: *Image, node: *Node, kind: u8) -> void {
    const layer = node_module.layerOf(node)
    if same(layer, image.*.root) { return }
    const made = ops.newMask(image, layer, kind, kindTitle(kind, app.*.german), tr(app, "New mask", "Neue Maske"))
    if made == null {
        noMemory(app)
        return
    }
    if kind == node_module.FILTER_MASK {
        const first = filters.at(0)
        if first != null { filters.defaults(first.?.*.id, &made.?.*.params) }
    }
    image.*.active = made.?
    keep.*.reveal = true
}

// A copy of `node` and all in it, above it, named "... copy".
fn duplicate(app: *App, keep: *Keep, image: *Image, node: *Node) -> void {
    if node.*.parent == null { return }
    const parent = node.*.parent.?
    const at = node_module.indexIn(parent, node)
    if at == null { return }
    const copy = node_module.duplicate(node, &image.*.nextId)
    if copy == null {
        noMemory(app)
        return
    }
    const suffix = tr(app, " copy", " Kopie")
    const name = node_module.nameOf(node)
    // The name cut where the suffix still fits, at a character's start.
    var length = name.length
    if length + suffix.length > node_module.NAME {
        length = node_module.NAME - suffix.length
        while length > 0 && name[length] & 192 == 128 { length -= 1 }
    }
    const room: [*]u8 = &keep.*.nameRoom
    var used = std.text.append(room, 0, NAME_ROOM, name[0..length])
    used = std.text.append(room, used, NAME_ROOM, suffix)
    node_module.setName(copy.?, room[0..used])
    if !ops.add(image, copy.?, parent, at.? + 1, tr(app, "Duplicate layer", "Ebene duplizieren")) {
        node_module.destroy(copy.?)
        noMemory(app)
        return
    }
    image.*.active = copy.?
    keep.*.reveal = true
}

fn toggleFlag(app: *App, keep: *Keep, image: *Image, node: *Node, command: u8) -> void {
    keep.*.saved = node_module.props(node)
    var name: []const u8 = ""
    if command == DO_LOCK {
        node.*.locked = !node.*.locked
        name = if node.*.locked { tr(app, "Lock layer", "Ebene sperren") } else { tr(app, "Unlock layer", "Ebene entsperren") }
    } else if command == DO_ALPHA_LOCK {
        node.*.alphaLocked = !node.*.alphaLocked
        name = if node.*.alphaLocked { tr(app, "Lock alpha", "Alpha sperren") } else { tr(app, "Unlock alpha", "Alpha entsperren") }
    } else if command == DO_INHERIT {
        node.*.inheritAlpha = !node.*.inheritAlpha
        name = if node.*.inheritAlpha { tr(app, "Inherit alpha", "Alpha erben") } else { tr(app, "Stop inheriting alpha", "Alpha nicht mehr erben") }
    } else {
        if node.*.kind != node_module.GROUP { return }
        node.*.passThrough = !node.*.passThrough
        name = if node.*.passThrough { tr(app, "Pass through", "Durchreichen") } else { tr(app, "Isolate group", "Gruppe abgrenzen") }
    }
    ops.changed(image, node, &keep.*.saved, name)
}

fn properties(app: *App, image: *Image, node: *Node) -> void {
    image.*.active = node
    if actions.byKey("layer_properties") != null {
        _ = api.run(app, "layer_properties")
        return
    }
    _ = dialogs.layerProperties(app, node)
}

fn perform(app: *App, keep: *Keep) -> void {
    const command = keep.*.command
    if command == DO_NOTHING { return }
    keep.*.command = DO_NOTHING
    run(app, keep, command, keep.*.commandNode, keep.*.commandValue, keep.*.commandParent)
}

// Does `command` to node `id` (`value`, `parent_id`: what it needs).
fn run(app: *App, keep: *Keep, command: u8, id: u32, value: usize, parent_id: u32) -> void {
    const found = api.image(app)
    if found == null { return }
    const image = found.?
    if command == DO_KINDS {
        openKinds(app, keep, image)
        return
    }
    if command == DO_MENU {
        openMenu(app, keep, image, id)
        return
    }
    if command == DO_NEW {
        newLayer(app, keep, image, @intCast(u8, value))
        api.layersChanged(app)
        return
    }
    const target = image_module.find(image, id)
    if target == null || same(target.?, image.*.root) { return }
    const node = target.?
    if command == DO_ACTIVATE {
        image.*.active = node
        keep.*.reveal = true
    } else if command == DO_VISIBLE {
        ops.setVisible(image, node, !node.*.visible, if node.*.visible { tr(app, "Hide layer", "Ebene ausblenden") } else { tr(app, "Show layer", "Ebene einblenden") })
    } else if command == DO_LOCK || command == DO_ALPHA_LOCK || command == DO_INHERIT || command == DO_PASS {
        toggleFlag(app, keep, image, node, command)
    } else if command == DO_FOLD {
        node.*.collapsed = !node.*.collapsed
        // What is folded away cannot stay the active one.
        if node.*.collapsed && image.*.active != null && !same(image.*.active.?, node) && node_module.isUnder(image.*.active.?, node) { image.*.active = node }
    } else if command == DO_MOVE {
        const parent = image_module.find(image, parent_id)
        if parent != null && ops.move(image, node, parent.?, value, tr(app, "Move layer", "Ebene verschieben")) {
            image.*.active = node
            keep.*.reveal = true
        }
    } else if command == DO_MASK {
        newMask(app, keep, image, node, @intCast(u8, value))
    } else if command == DO_DUPLICATE {
        duplicate(app, keep, image, node)
    } else if command == DO_DELETE {
        if keep.*.renaming == id { keep.*.renaming = 0 }
        ops.remove(image, node, tr(app, "Delete layer", "Ebene löschen"))
        keep.*.reveal = true
    } else if command == DO_RAISE || command == DO_LOWER {
        const up = command == DO_RAISE
        const step = stepOf(node, up)
        if step.parent != null && ops.move(image, node, step.parent.?, step.index, if up { tr(app, "Raise layer", "Ebene anheben") } else { tr(app, "Lower layer", "Ebene absenken") }) {
            image.*.active = node
            keep.*.reveal = true
        }
    } else if command == DO_PROPERTIES {
        properties(app, image, node)
    } else if command == DO_RENAME_START {
        image.*.active = node
        keep.*.renaming = id
        const name = node_module.nameOf(node)
        var length: usize = 0
        while length < name.length && length < node_module.NAME {
            keep.*.renameText[length] = name[length]
            length += 1
        }
        keep.*.renameLength = length
        kit_module.focus(api.kit(app), partId(PART_RENAME))
        keep.*.reveal = true
    } else if command == DO_BLEND {
        ops.setBlend(image, node, @intCast(u16, value), tr(app, "Blend mode", "Mischmodus"))
    }
    api.layersChanged(app)
}

// ---------------------------------------------------------------------------
// Keys

// A key while the pointer is over the docker: Up, Down, Home, End choose
// a node; Page Up and Page Down move the active one; Delete removes it;
// F2 renames it; Insert makes a new paint layer. Chords are the
// shortcuts'.
fn keyPress(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    if modifiers & (keys.CONTROL | keys.ALT | keys.SUPER) != 0 { return false }
    const found = keepOf(app)
    const picture = api.image(app)
    if found == null || picture == null { return false }
    const keep = found.?
    const image = picture.?
    listRows(app, keep, image)
    const active = image.*.active
    if code == keys.UP || code == keys.DOWN || code == keys.HOME || code == keys.END {
        const count = keep.*.rowCount
        if count == 0 { return true }
        var at: ?usize = null
        if active != null { at = indexOf(keep, active.?) }
        var index: usize = 0
        if code == keys.END {
            index = count - 1
        } else if code == keys.UP && at != null {
            index = if at.? > 0 { at.? - 1 } else { 0 }
        } else if code == keys.DOWN && at != null {
            index = if at.? + 1 < count { at.? + 1 } else { at.? }
        }
        image.*.active = nodeAt(keep, index)
        keep.*.reveal = true
        api.redraw(app)
        return true
    }
    if code == keys.INSERT {
        run(app, keep, DO_NEW, 0, @intCast(usize, node_module.PAINT), 0)
        return true
    }
    if active == null { return false }
    const id = active.?.*.id
    if code == keys.DELETE {
        run(app, keep, DO_DELETE, id, 0, 0)
        return true
    }
    if code == keys.F1 + 1 {
        run(app, keep, DO_RENAME_START, id, 0, 0)
        return true
    }
    if code == keys.PAGE_UP || code == keys.PAGE_DOWN {
        run(app, keep, if code == keys.PAGE_UP { DO_RAISE } else { DO_LOWER }, id, 0, 0)
        return true
    }
    return false
}
