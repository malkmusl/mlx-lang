// nebula dockers: Tool Options: what can be set for the tool in use. A
// heading with the tool's icon and name, and under it whatever the tool
// draws there (its Tool.options, tools/registry.mlx), in a view that
// scrolls when the options are taller than the docker (by the bar at
// its right, or the wheel). A tool that has nothing to set says so.
//
// The tool's options function is handed the rectangle to draw into (as
// tall as the view, or as tall as the options were the frame before)
// and returns the height it took, which the scrolling goes by. When the
// tool changes the view starts at its top again.
const ui = @import("std.ui")
const view = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")

pub const App = state.App

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 2

// The heading's height, the margin around the options (times the
// scale).
pub const HEADING: i32 = 28
const PAD: i32 = 6

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "options", .name = "Tool Options", .german = "Werkzeugoptionen", .icon = icons.DOCKER_TOOL_OPTIONS, .draw = draw, .keyPress = null, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// What the docker keeps: the tool it showed, how far its options are
// scrolled and how tall they were, where they were drawn.
const Keep = struct {
    tool: u8
    offset: i32
    height: i32
    // The kit's frame the docker was drawn in, its place, the options'
    // view (empty: the tool has none).
    frame: u64
    area: ui.Rect
    body: ui.Rect
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

// The id of the region the docker names over all of itself (whatever no
// option lies over is the docker's, not what is under it).
pub fn frameId() -> u64 { return view.id("nebula.options.frame") }

fn scrollId() -> u64 { return view.id("nebula.options.scroll") }

// The tool the docker showed in the frame drawn last (state.NO_TOOL:
// it was not drawn then), and the view its options were drawn in (empty:
// the tool has none, or the docker was not drawn).
pub fn shownTool(app: *App) -> u8 {
    const keep = keepOf(app)
    if keep == null || keep.?.*.frame != api.kit(app).*.frame { return state.NO_TOOL }
    return keep.?.*.tool
}

pub fn optionsArea(app: *App) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.body
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    const k = api.kit(app)
    const theme = state.themeOf(app)
    view.region(state.uiOf(app), frameId(), area)
    keep.?.*.frame = k.*.frame
    keep.?.*.area = area
    keep.?.*.body = ui.rect(0, 0, 0, 0)
    const tool = api.tool(app)
    if tool == null {
        keep.?.*.tool = state.NO_TOOL
        kit_module.label(k, area, state.tr(app, "No tool is chosen", "Kein Werkzeug ist gewählt"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    if keep.?.*.tool != tool.?.*.id {
        keep.?.*.tool = tool.?.*.id
        keep.?.*.offset = 0
        keep.?.*.height = 0
    }
    const pad = px(app, PAD)
    var rest = ui.rect(area.x + pad, area.y, area.width - 2 * pad, area.height)
    if rest.width <= 0 || rest.height <= 0 { return }
    // The heading: the tool's icon and name, a line under them.
    const heading = ui.takeTop(&rest, px(app, HEADING))
    const glyph = px(app, 18)
    icons.draw(kit_module.canvasOf(k), tool.?.*.icon, heading.x, heading.y + (heading.height - glyph) / 2, glyph, theme.*.text)
    kit_module.heading(k, ui.rect(heading.x + glyph + px(app, 8), heading.y, heading.width - glyph - px(app, 8), heading.height), state.tr(app, tool.?.*.name, tool.?.*.german))
    kit_module.separator(k, ui.rect(area.x, ui.bottom(heading) - px(app, 1), area.width, px(app, 1)))
    if tool.?.*.options == null {
        kit_module.label(k, ui.rect(rest.x, rest.y, rest.width, if rest.height < px(app, 48) { rest.height } else { px(app, 48) }), state.tr(app, "Nothing to set for this tool", "Für dieses Werkzeug gibt es nichts einzustellen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    // The options, scrolled when taller than the view.
    const inner = ui.rect(area.x, rest.y + pad, area.width, rest.height - pad)
    if inner.height <= 0 { return }
    keep.?.*.body = inner
    const content = kit_module.scrollBegin(k, scrollId(), inner, keep.?.*.height, &keep.?.*.offset)
    const room = ui.rect(content.x + pad, content.y, content.width - 2 * pad, if content.height > inner.height { content.height } else { inner.height })
    const used = tool.?.*.options.?(app, room)
    kit_module.scrollEnd(k)
    // (Its height shows in the next frame's scrolling.)
    const wanted = if used > 0 { used + pad } else { 0 }
    if wanted != keep.?.*.height {
        keep.?.*.height = wanted
        state.uiOf(app).*.changed = true
    }
}
