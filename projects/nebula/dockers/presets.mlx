// nebula dockers: Brush Presets: the presets (brush/presets.mlx) as a
// grid of their thumbnails, or as a list of rows with their names. A
// click makes one the brush in use (app/brushes.mlx use); the preset the
// brush in use is named after is marked. Above the grid a tag narrows
// the list (Basic, Ink, Paint, Sketch, Texture, Erasers, Pixel, the
// painter's own) and so does a part of a name typed into the search
// field; the button at the right switches between grid and list. Below
// it the name of the preset under the pointer (else the brush's), and
// buttons: the brush in use saved as a new preset (its name asked for),
// the brush editor (ui/brusheditor.mlx), and for a preset of the
// painter's own renaming and deleting it.
//
// With the pointer over the docker the arrow keys go to the preset
// before or after the one in use (it becomes the brush), F2 renames and
// Delete deletes the painter's preset that is marked.
//
// The App keeps the store of presets in its SLOT_BRUSHES, made at the
// first asking (storeOf): the built-in presets and the painter's files,
// read from the folder the program's environment names then.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("../app/keys.mlx")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const brushes = @import("../app/brushes.mlx")
const table = @import("../core/table.mlx")
const types = @import("../brush/types.mlx")
const presets = @import("../brush/presets.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const brusheditor = @import("../ui/brusheditor.mlx")

pub const App = state.App
pub const Store = presets.Store

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 3

// A row of the controls, a cell of the grid, a row of the list (times
// the scale).
pub const ROW: i32 = 24
pub const CELL_HEIGHT: i32 = 46
pub const LEAST_CELL_WIDTH: i32 = 68
pub const LIST_ROW: i32 = 26
const PAD: i32 = 4
// The kit's scroll bar's width (a grid keeps it free).
const BAR: i32 = 8

// The parts of the docker, for idOf().
pub const PART_TAG: usize = 0
pub const PART_SEARCH: usize = 1
pub const PART_VIEW: usize = 2
pub const PART_GRID: usize = 3
pub const PART_NEW: usize = 4
pub const PART_EDIT: usize = 5
pub const PART_RENAME: usize = 6
pub const PART_DELETE: usize = 7
pub const PART_LIST: usize = 8
// List row `n` is PART_ROW + n.
pub const PART_ROW: usize = 64

const NOTHING: usize = 18446744073709551615
const SEARCH: usize = 64

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "presets", .name = "Brush Presets", .german = "Pinselvorlagen", .icon = icons.BRUSH_PRESETS, .draw = draw, .keyPress = keyPress, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// The App's store of presets, made (built-in presets parsed, the
// painter's files read) at the first asking. Null without memory.
pub fn storeOf(app: *App) -> ?*Store {
    const memory = state.slot(app, state.SLOT_BRUSHES, @sizeOf(Store))
    if memory == null { return null }
    const store: *Store = unsafe { @ptrCast(*Store, memory.?) }
    if !store.*.ready && !presets.init(store, app.*.allocator, app.*.shell.*.environment) { return null }
    return store
}

// What the docker keeps: the tag and the text that narrow the list,
// grid or list, how far it is scrolled, which presets are shown, the
// one under the pointer, and the name a dialog it opened is about.
const Keep = struct {
    app: *App
    store: *Store
    // 0: every tag; 1 + n: presets.tagName(n)'s.
    tag: usize
    search: [64]u8
    searchLength: usize
    list: bool
    offset: i32
    shown: [256]u16
    shownCount: usize
    // The preset (its index in the store) under the pointer in the frame
    // drawn last (NOTHING: none).
    hover: usize
    // The preset in use's place among those shown (NOTHING: not shown).
    chosen: usize
    asked: [64]u8
    askedLength: usize
    text: [256]u8
    // The kit's frame the docker was drawn in, the grid's (or the list's)
    // place and its cells then.
    frame: u64
    view: ui.Rect
    cellWidth: i32
    cellHeight: i32
    columns: usize
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    keep.*.app = app
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

// The id of `part` (PART_*) of the docker.
pub fn idOf(part: usize) -> u64 { return view.idOf(view.id("nebula.presets"), part) }

// The preset the brush in use is named after (null: none is).
fn presetInUse(app: *App, store: *Store) -> ?usize {
    return presets.find(store, types.nameOf(brushes.current(app)))
}

// The presets the tag and the search let through, into keep.shown.
fn narrow(keep: *Keep) -> void {
    const store = keep.*.store
    const bits: u8 = if keep.*.tag == 0 || keep.*.tag > presets.TAGS { 0 } else { @intCast(u8, 1) << @intCast(u3, keep.*.tag - 1) }
    const search_bytes: [*]const u8 = &keep.*.search
    const search = search_bytes[0..keep.*.searchLength]
    keep.*.shownCount = 0
    var index: usize = 0
    while index < presets.count(store) && keep.*.shownCount < presets.MOST {
        if presets.matches(store, index, bits, search) {
            keep.*.shown[keep.*.shownCount] = @intCast(u16, index)
            keep.*.shownCount += 1
        }
        index += 1
    }
}

// Where preset `index` (the store's) is among those shown (NOTHING: not
// shown).
fn placeOf(keep: *Keep, index: usize) -> usize {
    var at: usize = 0
    while at < keep.*.shownCount {
        if @intCast(usize, keep.*.shown[at]) == index { return at }
        at += 1
    }
    return NOTHING
}

// Makes preset `index` the brush in use.
fn choose(app: *App, store: *Store, index: usize) -> void {
    const settings = presets.settingsOf(store, index)
    if settings == null { return }
    brushes.use(app, settings.?)
}

// ---------------------------------------------------------------------------
// Where things are (tests and scripts look)

// Where shown preset `place` (its place among those shown) was drawn in
// the frame drawn last (empty: not in view, or the docker was not
// drawn).
pub fn cellArea(app: *App, place: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || ui.isEmpty(keep.?.*.view) || keep.?.*.frame != api.kit(app).*.frame || place >= keep.?.*.shownCount || keep.?.*.columns == 0 { return ui.rect(0, 0, 0, 0) }
    const k = keep.?
    const row = @intCast(i32, place / k.*.columns)
    const column = @intCast(i32, place % k.*.columns)
    const area = ui.rect(k.*.view.x + column * k.*.cellWidth, k.*.view.y - k.*.offset + row * k.*.cellHeight, k.*.cellWidth, k.*.cellHeight)
    if area.y < k.*.view.y || ui.bottom(area) > ui.bottom(k.*.view) { return ui.rect(0, 0, 0, 0) }
    return area
}

// How many presets the docker shows now, and the store's index of the
// one at `place` (NOTHING past the last).
pub fn shownCount(app: *App) -> usize {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.shownCount
}

pub fn shownAt(app: *App, place: usize) -> usize {
    const keep = keepOf(app)
    if keep == null || place >= keep.?.*.shownCount { return NOTHING }
    return @intCast(usize, keep.?.*.shown[place])
}

// Narrows the list to tag `tag` (0: all; 1 + n: presets.tagName(n)'s)
// and `search`, as the tag's list and the search field do; grid or list.
pub fn setFilter(app: *App, tag: usize, search: []const u8, as_list: bool) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    keep.?.*.tag = if tag > presets.TAGS { 0 } else { tag }
    keep.?.*.searchLength = std.text.append(&keep.?.*.search, 0, SEARCH, search)
    keep.?.*.list = as_list
    keep.?.*.offset = 0
    api.redraw(app)
}

// ---------------------------------------------------------------------------
// Drawing

fn tagListName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == 0 { return state.tr(app, "All tags", "Alle") }
    return presets.tagName(index - 1, app.*.german)
}

// A thumbnail's coverage in `color` (premultiplied) with its upper left
// corner at (x, y), every `step`th pixel (2: half its size), inside
// `clip` only.
fn drawThumb(canvas: *state.Canvas, thumb: [*]const u8, x: i32, y: i32, step: usize, clip: ui.Rect, color: u32) -> void {
    if canvas.*.width == 0 || canvas.*.device != 0 { return }
    const width = presets.THUMB_WIDTH / step
    const height = presets.THUMB_HEIGHT / step
    var row: usize = 0
    while row < height {
        const py = y + @intCast(i32, row)
        if py >= clip.y && py < ui.bottom(clip) {
            var column: usize = 0
            while column < width {
                const px_at = x + @intCast(i32, column)
                if px_at >= clip.x && px_at < ui.right(clip) {
                    // (Half size: the mean of the four it stands for.)
                    var cover: u32 = 0
                    if step == 1 {
                        cover = @intCast(u32, thumb[row * presets.THUMB_WIDTH + column])
                    } else {
                        const at = row * 2 * presets.THUMB_WIDTH + column * 2
                        cover = (@intCast(u32, thumb[at]) + @intCast(u32, thumb[at + 1]) + @intCast(u32, thumb[at + presets.THUMB_WIDTH]) + @intCast(u32, thumb[at + presets.THUMB_WIDTH + 1]) + 2) / 4
                    }
                    if cover != 0 { canvas_module.blend(canvas, px_at, py, color, cover) }
                }
                column += 1
            }
        }
        row += 1
    }
}

// A cell of the grid: the thumbnail of shown preset `place` on a tile.
fn drawCell(context: usize, place: usize, canvas: *state.Canvas, cell: ui.Rect, lit: bool) -> void {
    const keep: *Keep = unsafe { @ptrFromInt(*Keep, context) }
    if place >= keep.*.shownCount { return }
    const index = @intCast(usize, keep.*.shown[place])
    const app = keep.*.app
    const theme = state.themeOf(app)
    const s = theme.*.scale
    const tile = ui.rect(cell.x + 2 * s, cell.y + 2 * s, cell.width - 4 * s, cell.height - 4 * s)
    canvas_module.fillRoundedRect(canvas, tile.x, tile.y, tile.width, tile.height, theme.*.smallRadius, if lit { theme.*.hover } else { theme.*.field })
    if lit { keep.*.hover = index }
    const thumb = presets.thumbnail(keep.*.store, index)
    if thumb == null { return }
    const x = tile.x + (tile.width - @intCast(i32, presets.THUMB_WIDTH)) / 2
    const y = tile.y + (tile.height - @intCast(i32, presets.THUMB_HEIGHT)) / 2
    drawThumb(canvas, thumb.?, x, y, 1, ui.rect(tile.x + s, tile.y + s, tile.width - 2 * s, tile.height - 2 * s), theme.*.text)
    // The painter's own presets: a small mark in the corner.
    if presets.isUser(keep.*.store, index) { canvas_module.fillRoundedRect(canvas, ui.right(tile) - 7 * s, tile.y + 3 * s, 4 * s, 4 * s, 2 * s, theme.*.accent) }
}

fn drawGrid(app: *App, keep: *Keep, area: ui.Rect) -> ?usize {
    const k = api.kit(app)
    const s = state.themeOf(app).*.scale
    const usable = area.width - BAR * s
    var columns = usable / px(app, LEAST_CELL_WIDTH)
    if columns < 1 { columns = 1 }
    keep.*.columns = @intCast(usize, columns)
    keep.*.cellWidth = if usable > 0 { usable / columns } else { 1 }
    keep.*.cellHeight = px(app, CELL_HEIGHT)
    return kit_module.grid(k, idOf(PART_GRID), area, keep.*.cellWidth, keep.*.cellHeight, keep.*.shownCount, keep.*.chosen, &keep.*.offset, drawCell, @intFromPtr(keep))
}

fn drawList(app: *App, keep: *Keep, area: ui.Rect) -> ?usize {
    var clicked: ?usize = null
    const k = api.kit(app)
    const theme = state.themeOf(app)
    const s = theme.*.scale
    const row = px(app, LIST_ROW)
    keep.*.columns = 1
    keep.*.cellHeight = row
    const content = kit_module.scrollBegin(k, idOf(PART_LIST), area, @intCast(i32, keep.*.shownCount) * row, &keep.*.offset)
    keep.*.cellWidth = content.width
    const canvas = kit_module.canvasOf(k)
    var at: usize = if keep.*.offset > 0 { @intCast(usize, keep.*.offset / row) } else { 0 }
    while at < keep.*.shownCount {
        const place = ui.rect(content.x, content.y + @intCast(i32, at) * row, content.width, row)
        if place.y >= ui.bottom(area) { break }
        const id = idOf(PART_ROW + at)
        const index = @intCast(usize, keep.*.shown[at])
        if kit_module.listRow(k, id, place, at == keep.*.chosen, false) != kit_module.ROW_NONE { clicked = at }
        if view.isHover(state.uiOf(app), id) { keep.*.hover = index }
        const thumb = presets.thumbnail(keep.*.store, index)
        const small_width = @intCast(i32, presets.THUMB_WIDTH / 2)
        const small_height = @intCast(i32, presets.THUMB_HEIGHT / 2)
        const tile = ui.rect(place.x + 4 * s, place.y + (row - small_height - 2 * s) / 2, small_width + 4 * s, small_height + 2 * s)
        canvas_module.fillRoundedRect(canvas, tile.x, tile.y, tile.width, tile.height, theme.*.smallRadius, theme.*.field)
        if thumb != null { drawThumb(canvas, thumb.?, tile.x + 2 * s, tile.y + s, 2, tile, theme.*.text) }
        const text_x = ui.right(tile) + 8 * s
        kit_module.label(k, ui.rect(text_x, place.y, ui.right(place) - text_x - 4 * s, row), presets.name(keep.*.store, index), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
        at += 1
    }
    kit_module.scrollEnd(k)
    return clicked
}

// A small square button with an icon and a tooltip; disabled when not
// `enabled`. True when clicked.
fn iconButton(app: *App, part: usize, area: ui.Rect, icon: u16, enabled: bool, tip: []const u8) -> bool {
    const k = api.kit(app)
    if !enabled { kit_module.disabledBegin(k) }
    const clicked = kit_module.iconButton(k, idOf(part), area, icons.drawFor, @intCast(usize, icon), tip)
    if !enabled { kit_module.disabledEnd(k) }
    return clicked && enabled
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep = keepOf(app)
    const store = storeOf(app)
    const k = api.kit(app)
    if keep == null || store == null {
        kit_module.label(k, area, state.tr(app, "There is no memory for the presets", "Für die Vorlagen ist kein Speicher da"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    const kp = keep.?
    kp.*.store = store.?
    kp.*.frame = k.*.frame
    kp.*.view = ui.rect(0, 0, 0, 0)
    const theme = state.themeOf(app)
    const s = theme.*.scale
    const pad = px(app, PAD)
    const row = px(app, ROW)
    var rest = ui.rect(area.x + pad, area.y + pad, area.width - 2 * pad, area.height - 2 * pad)
    if rest.width < row * 3 || rest.height < row { return }

    // The tag, the search, grid or list.
    const top = ui.takeTop(&rest, row)
    _ = ui.takeTop(&rest, pad)
    var tag_width = top.width * 2 / 5
    if tag_width > px(app, 120) { tag_width = px(app, 120) }
    const view_area = ui.rect(ui.right(top) - row, top.y, row, row)
    const search_area = ui.rect(top.x + tag_width + pad, top.y, view_area.x - pad - (top.x + tag_width + pad), row)
    if kit_module.comboBoxWith(k, idOf(PART_TAG), ui.rect(top.x, top.y, tag_width, row), presets.TAGS + 1, tagListName, @intFromPtr(app), &kp.*.tag) { kp.*.offset = 0 }
    if kit_module.textBox(k, idOf(PART_SEARCH), search_area, &kp.*.search, &kp.*.searchLength, SEARCH, state.tr(app, "Search", "Suchen")) == kit_module.TEXT_EDITED { kp.*.offset = 0 }
    // (The magnifier where the empty field has room for it beside the
    // word in it.)
    if kp.*.searchLength == 0 && !kit_module.editing(k, idOf(PART_SEARCH)) && search_area.width >= px(app, 90) {
        const glyph = px(app, 14)
        icons.draw(kit_module.canvasOf(k), icons.SEARCH, ui.right(search_area) - glyph - px(app, 6), search_area.y + (row - glyph) / 2, glyph, theme.*.dim)
    }
    if kit_module.toolButton(k, idOf(PART_VIEW), view_area, icons.drawFor, @intCast(usize, if kp.*.list { icons.GRID } else { icons.MENU }), false, if kp.*.list { state.tr(app, "Show as a grid", "Als Raster zeigen") } else { state.tr(app, "Show as a list", "Als Liste zeigen") }) {
        kp.*.list = !kp.*.list
        kp.*.offset = 0
    }

    // The buttons and the name at the bottom.
    const bottom = ui.takeBottom(&rest, row)
    _ = ui.takeBottom(&rest, pad)
    const in_use = presetInUse(app, store.?)
    const own = in_use != null && presets.isUser(store.?, in_use.?)
    var x = bottom.x
    if iconButton(app, PART_NEW, ui.rect(x, bottom.y, row, row), icons.PLUS, true, state.tr(app, "Save the brush as a new preset", "Pinsel als neue Vorlage sichern")) { askSave(app) }
    x += row + s
    if iconButton(app, PART_EDIT, ui.rect(x, bottom.y, row, row), icons.BRUSH_SETTINGS, true, state.tr(app, "Edit the brush", "Pinsel bearbeiten")) { _ = brusheditor.open(app) }
    x += row + s
    if iconButton(app, PART_RENAME, ui.rect(x, bottom.y, row, row), icons.RENAME, own, state.tr(app, "Rename the preset", "Vorlage umbenennen")) { askRename(app, kp) }
    x += row + s
    if iconButton(app, PART_DELETE, ui.rect(x, bottom.y, row, row), icons.LAYER_DELETE, own, state.tr(app, "Delete the preset", "Vorlage löschen")) { askDelete(app, kp) }
    x += row + pad

    // The presets.
    narrow(kp)
    kp.*.chosen = if in_use == null { NOTHING } else { placeOf(kp, in_use.?) }
    const hovered = kp.*.hover
    kp.*.hover = NOTHING
    var clicked: ?usize = null
    if rest.height >= row {
        kp.*.view = rest
        if kp.*.shownCount == 0 {
            kit_module.label(k, rest, state.tr(app, "No preset is called so", "Keine Vorlage heißt so"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        } else if kp.*.list {
            clicked = drawList(app, kp, rest)
        } else {
            clicked = drawGrid(app, kp, rest)
        }
    }
    // (The pointer's preset is known after the cells were drawn; on a
    // pass that only lays out, the one of the frame before stands.)
    if kit_module.canvasOf(k).*.width == 0 { kp.*.hover = hovered }
    const named = if kp.*.hover != NOTHING { presets.name(store.?, kp.*.hover) } else { types.nameOf(brushes.current(app)) }
    kit_module.label(k, ui.rect(x, bottom.y, ui.right(bottom) - x, row), named, if kp.*.hover != NOTHING || in_use != null { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_RIGHT)
    if clicked != null && clicked.? < kp.*.shownCount { choose(app, store.?, @intCast(usize, kp.*.shown[clicked.?])) }
}

// ---------------------------------------------------------------------------
// Saving, renaming, deleting

fn askSave(app: *App) -> void {
    _ = dialogs.prompt(app, state.tr(app, "New Brush Preset", "Neue Pinselvorlage"), state.tr(app, "Name", "Name"), types.nameOf(brushes.current(app)), saveAs)
}

// Saves the brush in use as the painter's preset `text` (the brush is
// called so then, and so marked as the preset in use).
fn saveAs(app: *App, text: []const u8) -> void {
    const store = storeOf(app)
    if store == null { return }
    const saved = presets.save(store.?, brushes.current(app), text)
    if saved == null {
        if presets.folder(store.?).length == 0 {
            api.say(app, state.tr(app, "There is no folder to keep presets in", "Es gibt keinen Ordner für Vorlagen"), true)
        } else {
            api.say(app, state.tr(app, "The preset could not be saved", "Die Vorlage konnte nicht gesichert werden"), true)
        }
        return
    }
    types.setName(brushes.current(app), presets.name(store.?, saved.?))
    reveal(app, saved.?)
    api.sayWith(app, state.tr(app, "Saved as preset: ", "Als Vorlage gesichert: "), presets.name(store.?, saved.?), false)
}

// Scrolls so that preset `index` (the store's) is in view, with every
// tag and no search when it is not shown now.
fn reveal(app: *App, index: usize) -> void {
    const keep = keepOf(app)
    const store = storeOf(app)
    if keep == null || store == null { return }
    keep.?.*.store = store.?
    narrow(keep.?)
    if placeOf(keep.?, index) == NOTHING {
        keep.?.*.tag = 0
        keep.?.*.searchLength = 0
        narrow(keep.?)
    }
    const place = placeOf(keep.?, index)
    if place == NOTHING || keep.?.*.columns == 0 || ui.isEmpty(keep.?.*.view) { return }
    const top = @intCast(i32, place / keep.?.*.columns) * keep.?.*.cellHeight
    if top < keep.?.*.offset { keep.?.*.offset = top }
    if top + keep.?.*.cellHeight > keep.?.*.offset + keep.?.*.view.height { keep.?.*.offset = top + keep.?.*.cellHeight - keep.?.*.view.height }
    api.redraw(app)
}

fn askRename(app: *App, keep: *Keep) -> void {
    const in_use = presetInUse(app, keep.*.store)
    if in_use == null || !presets.isUser(keep.*.store, in_use.?) { return }
    keep.*.askedLength = std.text.append(&keep.*.asked, 0, types.NAME, presets.name(keep.*.store, in_use.?))
    _ = dialogs.prompt(app, state.tr(app, "Rename Brush Preset", "Pinselvorlage umbenennen"), state.tr(app, "Name", "Name"), presets.name(keep.*.store, in_use.?), renameTo)
}

fn askedName(keep: *Keep) -> []const u8 {
    const bytes: [*]const u8 = &keep.*.asked
    return bytes[0..keep.*.askedLength]
}

fn renameTo(app: *App, text: []const u8) -> void {
    const keep = keepOf(app)
    const store = storeOf(app)
    if keep == null || store == null { return }
    const index = presets.find(store.?, askedName(keep.?))
    if index == null { return }
    // (The brush in use follows when it is the preset renamed.)
    const was_in_use = std.text.same(types.nameOf(brushes.current(app)), askedName(keep.?))
    const renamed = presets.rename(store.?, index.?, text)
    if renamed == null {
        api.say(app, state.tr(app, "The preset could not be renamed (is the name another's?)", "Die Vorlage konnte nicht umbenannt werden (trägt eine andere den Namen?)"), true)
        return
    }
    if was_in_use { types.setName(brushes.current(app), presets.name(store.?, renamed.?)) }
    reveal(app, renamed.?)
}

fn askDelete(app: *App, keep: *Keep) -> void {
    const in_use = presetInUse(app, keep.*.store)
    if in_use == null || !presets.isUser(keep.*.store, in_use.?) { return }
    const name_text = presets.name(keep.*.store, in_use.?)
    keep.*.askedLength = std.text.append(&keep.*.asked, 0, types.NAME, name_text)
    var length = std.text.append(&keep.*.text, 0, 256, state.tr(app, "Delete the preset \u{201C}", "Die Vorlage \u{201E}"))
    length = std.text.append(&keep.*.text, length, 256, name_text)
    length = std.text.append(&keep.*.text, length, 256, state.tr(app, "\u{201D}? Its file is deleted too.", "\u{201C} löschen? Ihre Datei wird mit gelöscht."))
    const bytes: [*]const u8 = &keep.*.text
    _ = dialogs.confirm(app, state.tr(app, "Delete Brush Preset", "Pinselvorlage löschen"), bytes[0..length], state.tr(app, "Delete", "Löschen"), state.tr(app, "Keep", "Behalten"), deleteAsked, null)
}

fn deleteAsked(app: *App) -> void {
    const keep = keepOf(app)
    const store = storeOf(app)
    if keep == null || store == null { return }
    const index = presets.find(store.?, askedName(keep.?))
    if index == null { return }
    if !presets.remove(store.?, index.?) {
        api.say(app, state.tr(app, "The preset's file could not be deleted", "Die Datei der Vorlage konnte nicht gelöscht werden"), true)
        return
    }
    api.redraw(app)
}

// ---------------------------------------------------------------------------
// Keys

fn keyPress(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const keep = keepOf(app)
    const store = storeOf(app)
    if keep == null || store == null || modifiers & (keys.CONTROL | keys.ALT) != 0 { return false }
    const kp = keep.?
    kp.*.store = store.?
    const in_use = presetInUse(app, store.?)
    if code == keys.F1 + 1 {
        // F2, as everywhere.
        askRename(app, kp)
        return true
    }
    if code == keys.DELETE {
        askDelete(app, kp)
        return true
    }
    const columns = if kp.*.list || kp.*.columns == 0 { 1 } else { kp.*.columns }
    var step: i64 = 0
    if code == keys.LEFT { step = -1 }
    if code == keys.RIGHT { step = 1 }
    if code == keys.UP { step = 0 - @intCast(i64, columns) }
    if code == keys.DOWN { step = @intCast(i64, columns) }
    if step == 0 { return false }
    narrow(kp)
    if kp.*.shownCount == 0 { return true }
    const place = if in_use == null { NOTHING } else { placeOf(kp, in_use.?) }
    var next: i64 = 0
    if place != NOTHING {
        next = @intCast(i64, place) + step
        if next < 0 { next = 0 }
        if next >= @intCast(i64, kp.*.shownCount) { next = @intCast(i64, kp.*.shownCount) - 1 }
    }
    const index = @intCast(usize, kp.*.shown[@intCast(usize, next)])
    choose(app, store.?, index)
    reveal(app, index)
    return true
}
