// nebula dockers: the list of panels beside the canvas. Each module has
// a table of state.Docker (usually of one) and hands it out with list();
// here they are put together. Ids: layers 0, colour 1, tool options 2,
// brush presets 3, history 4, overview 5, palette 6, channels 7,
// histogram 8, grid and guides 9, timeline 10.
const state = @import("../app/state.mlx")
const layers_module = @import("./layers.mlx")
const color_module = @import("./color.mlx")
const options_module = @import("./options.mlx")
const presets_module = @import("./presets.mlx")
const history_module = @import("./history.mlx")
const overview_module = @import("./overview.mlx")
const palette_module = @import("./palette.mlx")
const channels_module = @import("./channels.mlx")
const histogram_module = @import("./histogram.mlx")
const grid_module = @import("./grid.mlx")
const timeline_module = @import("./timeline.mlx")

pub const Docker = state.Docker

const MODULES: usize = 11

fn listOf(module: usize) -> []const Docker {
    if module == 0 { return layers_module.list() }
    if module == 1 { return color_module.list() }
    if module == 2 { return options_module.list() }
    if module == 3 { return presets_module.list() }
    if module == 4 { return history_module.list() }
    if module == 5 { return overview_module.list() }
    if module == 6 { return palette_module.list() }
    if module == 7 { return channels_module.list() }
    if module == 8 { return histogram_module.list() }
    if module == 9 { return grid_module.list() }
    return timeline_module.list()
}

// How many there are, and the one at a place in the list (in the modules'
// order).
pub fn count() -> usize {
    var total: usize = 0
    var module: usize = 0
    while module < MODULES {
        total += listOf(module).length
        module += 1
    }
    return total
}

pub fn at(index: usize) -> ?*const Docker {
    var left = index
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        if left < list.length { return &list[left] }
        left -= list.length
        module += 1
    }
    return null
}

fn sameText(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if left[index] != right[index] { return false }
        index += 1
    }
    return true
}

// The one named `key` (null: there is none).
pub fn byKey(key: []const u8) -> ?*const Docker {
    const all = count()
    var index: usize = 0
    while index < all {
        const found = at(index)
        if found != null && sameText(found.?.*.key, key) { return found }
        index += 1
    }
    return null
}

// The one numbered `id` (null: there is none).
pub fn find(id: u8) -> ?*const Docker {
    const all = count()
    var index: usize = 0
    while index < all {
        const found = at(index)
        if found != null && found.?.*.id == id { return found }
        index += 1
    }
    return null
}
