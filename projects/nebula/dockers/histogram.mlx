// nebula dockers: the histogram: how many pixels of the active layer
// (or, chosen, of the whole image) have each value of the luminance or
// of red, green or blue, drawn as bars over the 256 values on a linear
// or a logarithmic scale; under them the number of pixels counted, their
// mean and their median.
//
// Pixels are counted over the image's rectangle (a layer's pixels beyond
// it are not), in blocks of 64 x 64; a block the layer has no tile in is
// its default pixel all over and costs nothing. Transparent pixels (alpha
// 0) have no colour and are not counted; any other counts whole. The
// luminance is Rec. 709's: (2126 red + 7152 green + 722 blue) / 10000 of
// the pixel's values as they are, rounded.
//
// The counts are made again when what they are of changed: another
// image (told apart by its number: one made where a closed one was may
// have its address), layer or choice of source, or the image's
// projection was drawn again (core/image.mlx's updateSerial: whatever
// changed pixels damaged the image). Not in every frame, and not again
// when the docker is shown again after it was hidden (the counts of what
// has not changed since are kept). A large layer is counted a few blocks
// a frame (READS read, VISITS looked at), the docker showing that it is
// computing meanwhile (the bars of before faded, a bar of the part done).
// Another channel or scale only draws the bars again from the counts
// there are (all four channels are counted at once).
//
// In a narrow docker the choices take two rows and the numbers three
// lines.
//
// computations(), isComputing(), countOf() and chartArea() let a test
// look; setChannel(), setSource() and setLogarithmic() choose as the
// docker's own widgets do.
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const render = @import("../core/render.mlx")
const geom = @import("../core/geom.mlx")
const scratch = @import("../core/scratch.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")

pub const App = state.App
pub const Image = image_module.Image
pub const Node = node_module.Node

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 8

// What the bars count: the luminance, red, green, blue.
pub const CHANNEL_LUMA: usize = 0
pub const CHANNEL_RED: usize = 1
pub const CHANNEL_GREEN: usize = 2
pub const CHANNEL_BLUE: usize = 3
pub const CHANNELS: usize = 4

// Of what: the active layer, the whole image.
pub const SOURCE_LAYER: usize = 0
pub const SOURCE_IMAGE: usize = 1

// The docker's widgets (controlArea).
pub const CONTROL_CHANNEL: usize = 0
pub const CONTROL_SOURCE: usize = 1
pub const CONTROL_LINEAR: usize = 2
pub const CONTROL_LOG: usize = 3
const CONTROLS: usize = 4

pub const BINS: usize = 256

// Counting: a block's side, the blocks read a frame at most and the
// blocks looked at (empty ones included) a frame at most.
pub const BLOCK: i32 = 64
pub const READS: usize = 32
pub const VISITS: usize = 4096

// Sizes at scale 1: the room around the content, a row of widgets, the
// strip of the values under the bars, a line of the numbers, the least
// height of the bars.
const PADDING: i32 = 6
const ROW: i32 = 24
const STRIP: i32 = 5
const LINE: i32 = 16
const LEAST_CHART: i32 = 40
// The narrowest a column of the numbers may be ("2,097,152").
const NUMBER_COLUMN: i32 = 66

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "histogram", .name = "Histogram", .german = "Histogramm", .icon = icons.DOCKER_HISTOGRAM, .draw = draw, .keyPress = null, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// What counts are of: an image (its number: an image made where a closed
// one was has another), a node of it (0 for the image itself), how far
// its projection had been drawn, the image's size.
const Key = struct {
    image: u64
    node: usize
    nodeId: u32
    serial: u64
    width: i32
    height: i32
}

fn sameKey(a: *const Key, b: *const Key) -> bool {
    return a.*.image == b.*.image && a.*.node == b.*.node && a.*.nodeId == b.*.nodeId && a.*.serial == b.*.serial && a.*.width == b.*.width && a.*.height == b.*.height
}

// What the docker keeps: the choices, the counts made last (four rows of
// 256: luminance, red, green, blue) and what they are of, the counting
// under way, where the parts were drawn.
const Keep = struct {
    ready: bool
    channel: usize
    source: usize
    logarithmic: bool
    // The counts of the last counting that ended.
    counts: [1024]u32
    total: u64
    have: bool
    of: Key
    computations: u64
    // The counting under way: what of, the counts so far, the next block
    // (raster order over the image's rectangle) and how many there are,
    // how many blocks a row of them has.
    running: bool
    job: Key
    work: [1024]u32
    workTotal: u64
    next: u64
    blocks: u64
    columns: u64
    // No memory for a block's pixels: nothing was counted.
    failed: bool
    // The kit's frame the docker was drawn in, the bars' rectangle and
    // the widgets' then.
    frame: u64
    chart: ui.Rect
    controls: [4]ui.Rect
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        keep.*.channel = CHANNEL_LUMA
        keep.*.source = SOURCE_LAYER
        keep.*.logarithmic = false
        keep.*.have = false
        keep.*.running = false
        keep.*.failed = false
        keep.*.computations = 0
        keep.*.frame = 0
        keep.*.ready = true
    }
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn countsOf(keep: *Keep) -> [*]u32 { return &keep.*.counts }
fn workOf(keep: *Keep) -> [*]u32 { return &keep.*.work }

// ---------------------------------------------------------------------------
// For tests and other parts

// How many countings have ended since the program started.
pub fn computations(app: *App) -> u64 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.computations
}

// Whether a counting is under way.
pub fn isComputing(app: *App) -> bool {
    const keep = keepOf(app)
    return keep != null && keep.?.*.running
}

// The pixels with `value` in `channel` (CHANNEL_*) in the counts made
// last (0 when there are none).
pub fn countOf(app: *App, channel: usize, value: usize) -> u32 {
    const keep = keepOf(app)
    if keep == null || !keep.?.*.have || channel >= CHANNELS || value >= BINS { return 0 }
    return keep.?.*.counts[channel * BINS + value]
}

// The pixels counted last.
pub fn pixelCount(app: *App) -> u64 {
    const keep = keepOf(app)
    if keep == null || !keep.?.*.have { return 0 }
    return keep.?.*.total
}

// The mean of `channel`'s values in the counts made last (0 without
// pixels).
pub fn meanOf(app: *App, channel: usize) -> f64 {
    const keep = keepOf(app)
    if keep == null || !keep.?.*.have || channel >= CHANNELS { return 0.0 }
    return mean(countsOf(keep.?), channel, keep.?.*.total)
}

// The median: the least value at or below which half the pixels are (0
// without pixels).
pub fn medianOf(app: *App, channel: usize) -> usize {
    const keep = keepOf(app)
    if keep == null || !keep.?.*.have || channel >= CHANNELS { return 0 }
    return median(countsOf(keep.?), channel, keep.?.*.total)
}

// What the bars count (CHANNEL_*), as the docker's list chooses it; a
// number that is no channel changes nothing.
pub fn setChannel(app: *App, channel: usize) -> void {
    const keep = keepOf(app)
    if keep == null || channel >= CHANNELS { return }
    keep.?.*.channel = channel
    api.redraw(app)
}

// What is counted (SOURCE_*), as the docker's list chooses it (counted
// in the frames that follow); a number that is no source changes
// nothing.
pub fn setSource(app: *App, source: usize) -> void {
    const keep = keepOf(app)
    if keep == null || source > SOURCE_IMAGE { return }
    keep.?.*.source = source
    api.redraw(app)
}

// The bars on the logarithmic scale (or the linear one), as the docker's
// two buttons choose it; nothing is counted again.
pub fn setLogarithmic(app: *App, on: bool) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    keep.?.*.logarithmic = on
    api.redraw(app)
}

// The rectangle the bars were drawn in, in the last frame (empty: none
// were drawn). Bar column c (0 at its left) shows the values from c *
// 256 / width up to (c + 1) * 256 / width.
pub fn chartArea(app: *App) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.chart
}

// Where widget `which` (CONTROL_*) was drawn in the last frame.
pub fn controlArea(app: *App, which: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || which >= CONTROLS || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.controls[which]
}

// ---------------------------------------------------------------------------
// Counting

fn mean(counts: [*]const u32, channel: usize, total: u64) -> f64 {
    if total == 0 { return 0.0 }
    var sum: u64 = 0
    var value: usize = 0
    while value < BINS {
        sum += @intCast(u64, counts[channel * BINS + value]) * @intCast(u64, value)
        value += 1
    }
    return @floatFromInt(f64, sum) / @floatFromInt(f64, total)
}

fn median(counts: [*]const u32, channel: usize, total: u64) -> usize {
    if total == 0 { return 0 }
    var below: u64 = 0
    var value: usize = 0
    while value < BINS {
        below += @intCast(u64, counts[channel * BINS + value])
        if below * 2 >= total { return value }
        value += 1
    }
    return BINS - 1
}

// `count` pixels of `pixels` added to `bins` (four rows of 256), the
// pixels counted to `total`.
fn addPixels(bins: [*]u32, total: *u64, pixels: [*]const u32, count: usize) -> void {
    var counted: u64 = 0
    var index: usize = 0
    while index < count {
        const value = pixels[index]
        if value >> 24 != 0 {
            const red = @intCast(usize, (value >> 16) & 255)
            const green = @intCast(usize, (value >> 8) & 255)
            const blue = @intCast(usize, value & 255)
            const luma = (red * 2126 + green * 7152 + blue * 722 + 5000) / 10000
            bins[luma] += 1
            bins[BINS + red] += 1
            bins[BINS * 2 + green] += 1
            bins[BINS * 3 + blue] += 1
            counted += 1
        }
        index += 1
    }
    total.* += counted
}

// `count` pixels of one value added at once (a block a layer has no tile
// in is its default pixel).
fn addSame(bins: [*]u32, total: *u64, value: u32, count: u64) -> void {
    if value >> 24 == 0 || count == 0 { return }
    const many = @intCast(u32, count)
    const red = @intCast(usize, (value >> 16) & 255)
    const green = @intCast(usize, (value >> 8) & 255)
    const blue = @intCast(usize, value & 255)
    bins[(red * 2126 + green * 7152 + blue * 722 + 5000) / 10000] += many
    bins[BINS + red] += many
    bins[BINS * 2 + green] += many
    bins[BINS * 3 + blue] += many
    total.* += count
}

// Whether `node` keeps its pixels in its device (a paint, vector or file
// layer, a mask); the others are made by render (a group, a fill, a
// clone) or have none of their own (a filter layer).
fn ownsPixels(node: *Node) -> bool {
    const kind = node.*.kind
    return node.*.device != null && (kind == node_module.PAINT || kind == node_module.VECTOR || kind == node_module.FILE || node_module.isMask(kind))
}

// Counts one block (inside the image): true when its pixels had to be
// read, false when it was all one value.
fn countBlock(keep: *Keep, image: *Image, node: ?*Node, block: geom.Rect, pixels: [*]u32) -> bool {
    const count = @intCast(usize, block.width) * @intCast(usize, block.height)
    var device: ?*device_module.Device = null
    if node == null {
        device = image.*.projection
    } else if ownsPixels(node.?) {
        device = node.?.*.device
    }
    if device != null {
        if !device_module.touches(device.?, block) {
            addSame(workOf(keep), &keep.*.workTotal, device.?.*.defaultPixel, @intCast(u64, count))
            return false
        }
        device_module.readRect(device.?, block, pixels, @intCast(usize, block.width))
    } else {
        render.readNode(image, node.?, block, pixels)
    }
    addPixels(workOf(keep), &keep.*.workTotal, pixels, count)
    return true
}

// Starts counting what `key` names.
fn start(keep: *Keep, key: *const Key) -> void {
    keep.*.running = true
    keep.*.failed = false
    keep.*.job = key.*
    device_module.fillWords(workOf(keep), CHANNELS * BINS, 0)
    keep.*.workTotal = 0
    keep.*.next = 0
    const columns = (@intCast(u64, key.*.width) + 63) / 64
    const rows = (@intCast(u64, key.*.height) + 63) / 64
    keep.*.columns = columns
    keep.*.blocks = columns * rows
}

// Counts on, READS blocks read and VISITS looked at at most; when all are
// done the counts become the docker's.
fn step(keep: *Keep, image: *Image, node: ?*Node) -> void {
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const pixels = scratch.words(pool, @intCast(usize, BLOCK * BLOCK))
    if pixels == null {
        scratch.release(pool, mark)
        keep.*.running = false
        keep.*.failed = true
        return
    }
    const bounds = image_module.bounds(image)
    var reads: usize = 0
    var visits: usize = 0
    while keep.*.next < keep.*.blocks && reads < READS && visits < VISITS {
        const column = keep.*.next % keep.*.columns
        const row = keep.*.next / keep.*.columns
        const block = geom.intersect(geom.rect(@intCast(i32, column) * BLOCK, @intCast(i32, row) * BLOCK, BLOCK, BLOCK), bounds)
        if !geom.isEmpty(block) && countBlock(keep, image, node, block, pixels.?) { reads += 1 }
        visits += 1
        keep.*.next += 1
    }
    scratch.release(pool, mark)
    if keep.*.next < keep.*.blocks { return }
    device_module.copyWords(countsOf(keep), workOf(keep), CHANNELS * BINS)
    keep.*.total = keep.*.workTotal
    keep.*.of = keep.*.job
    keep.*.have = true
    keep.*.running = false
    keep.*.computations += 1
}

// Brings the counts up to date as far as this frame may.
fn refresh(app: *App, keep: *Keep, image: *Image, node: ?*Node) -> void {
    keep.*.frame = api.kit(app).*.frame
    _ = render.update(image)
    var key = Key.{ .image = image.*.number, .node = 0, .nodeId = 0, .serial = image.*.updateSerial, .width = image.*.width, .height = image.*.height }
    if node != null {
        key.node = @intFromPtr(node.?)
        key.nodeId = node.?.*.id
    }
    const current = keep.*.have && sameKey(&keep.*.of, &key)
    const going = keep.*.running && sameKey(&keep.*.job, &key)
    if current {
        keep.*.running = false
        return
    }
    if !going {
        // (A counting that failed for memory is tried again only when
        // what it was of changed.)
        if keep.*.failed && sameKey(&keep.*.job, &key) { return }
        start(keep, &key)
    }
    step(keep, image, node)
    // Counting on in the next frame.
    if keep.*.running { api.redraw(app) }
}

// ---------------------------------------------------------------------------
// Drawing

fn channelName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == CHANNEL_RED { return state.tr(app, "Red", "Rot") }
    if index == CHANNEL_GREEN { return state.tr(app, "Green", "Grün") }
    if index == CHANNEL_BLUE { return state.tr(app, "Blue", "Blau") }
    return state.tr(app, "Luminance", "Helligkeit")
}

fn sourceName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == SOURCE_IMAGE { return state.tr(app, "Image", "Bild") }
    return state.tr(app, "Layer", "Ebene")
}

// The bars' colour for `channel` (premultiplied, opaque).
fn barColor(theme: *theme_module.Theme, channel: usize) -> u32 {
    if channel == CHANNEL_RED { return canvas_module.color(255, 224, 86, 86) }
    if channel == CHANNEL_GREEN { return canvas_module.color(255, 72, 178, 96) }
    if channel == CHANNEL_BLUE { return canvas_module.color(255, 84, 140, 236) }
    return theme_module.mix(theme.*.dim | 0xFF000000, theme.*.text | 0xFF000000, 600) | 0xFF000000
}

// The colour of value `value` of `channel` alone (the strip under the
// bars).
fn valueColor(channel: usize, value: u32) -> u32 {
    if channel == CHANNEL_RED { return 0xFF000000 | (value << 16) }
    if channel == CHANNEL_GREEN { return 0xFF000000 | (value << 8) }
    if channel == CHANNEL_BLUE { return 0xFF000000 | value }
    return 0xFF000000 | (value << 16) | (value << 8) | value
}

// How tall a bar of `count` is in `height` pixels when the tallest is
// `largest`: in proportion, or by the logarithm of 1 + the count; never
// 0 for a count above 0.
fn barHeight(count: u32, largest: u32, height: i32, logarithmic: bool) -> i32 {
    if count == 0 || largest == 0 || height <= 0 { return 0 }
    var bar: i32 = 0
    if logarithmic {
        const part = math.ln(1.0 + @floatFromInt(f64, count)) / math.ln(1.0 + @floatFromInt(f64, largest))
        bar = @intFromFloat(i32, math.clamp(part, 0.0, 1.0) * @floatFromInt(f64, height) + 0.5)
    } else {
        bar = @intCast(i32, (@intCast(u64, count) * @intCast(u64, height) + @intCast(u64, largest) - 1) / @intCast(u64, largest))
    }
    if bar < 1 { bar = 1 }
    if bar > height { bar = height }
    return bar
}

// The largest count of the values bar column `column` of `width` shows.
fn columnCount(counts: [*]const u32, channel: usize, column: i32, width: i32) -> u32 {
    const from = @intCast(usize, @intCast(i64, column) * 256 / @intCast(i64, width))
    var to = @intCast(usize, (@intCast(i64, column) + 1) * 256 / @intCast(i64, width))
    if to <= from { to = from + 1 }
    if to > BINS { to = BINS }
    var largest: u32 = 0
    var value = from
    while value < to {
        const count = counts[channel * BINS + value]
        if count > largest { largest = count }
        value += 1
    }
    return largest
}

// The bars of `counts` in `inner`, the tallest as tall as it.
fn drawBars(canvas: *state.Canvas, inner: ui.Rect, counts: [*]const u32, channel: usize, logarithmic: bool, color: u32) -> void {
    if inner.width <= 0 || inner.height <= 0 || canvas.*.width == 0 { return }
    var largest: u32 = 0
    var value: usize = 0
    while value < BINS {
        if counts[channel * BINS + value] > largest { largest = counts[channel * BINS + value] }
        value += 1
    }
    if largest == 0 { return }
    var column: i32 = 0
    while column < inner.width {
        const height = barHeight(columnCount(counts, channel, column, inner.width), largest, inner.height, logarithmic)
        if height > 0 { canvas_module.fillRect(canvas, inner.x + column, ui.bottom(inner) - height, 1, height, color) }
        column += 1
    }
}

// The values from 0 to 255 of `channel` along `area`.
fn drawStrip(canvas: *state.Canvas, area: ui.Rect, channel: usize) -> void {
    if area.width <= 0 || canvas.*.width == 0 { return }
    var column: i32 = 0
    const last = if area.width > 1 { area.width - 1 } else { 1 }
    while column < area.width {
        const value = @intCast(u32, @intCast(i64, column) * 255 / @intCast(i64, last))
        canvas_module.fillRect(canvas, area.x + column, area.y, 1, area.height, valueColor(channel, value))
        column += 1
    }
}

// One of two segments of a choice (Linear, Logarithmic): the chosen one
// raised in a frame like a field's; true when clicked.
fn segment(app: *App, id: u64, area: ui.Rect, text: []const u8, chosen: bool) -> bool {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    view.region(widgets, id, area)
    const s = app.*.scale
    const lit = view.isHover(widgets, id)
    const inset = ui.rect(area.x + 2 * s, area.y + 2 * s, area.width - 4 * s, area.height - 4 * s)
    if chosen {
        canvas_module.fillRoundedRect(kit_module.canvasOf(k), inset.x, inset.y, inset.width, inset.height, theme.*.smallRadius, if lit { theme.*.buttonHover } else { theme.*.button })
    } else if lit {
        canvas_module.fillRoundedRect(kit_module.canvasOf(k), inset.x, inset.y, inset.width, inset.height, theme.*.smallRadius, theme.*.hover)
    }
    kit_module.label(k, area, text, if chosen || lit { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_CENTER)
    return view.takeClick(widgets, id)
}

// The choice of the scale in `area`.
fn drawScale(app: *App, keep: *Keep, area: ui.Rect) -> void {
    const k = api.kit(app)
    const theme = state.themeOf(app)
    const canvas = kit_module.canvasOf(k)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + app.*.scale, theme.*.field)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + app.*.scale, app.*.scale, theme_module.mix(theme.*.field, theme.*.border, 330))
    const half = area.width / 2
    const linear = ui.rect(area.x, area.y, half, area.height)
    const logarithmic = ui.rect(area.x + half, area.y, area.width - half, area.height)
    // (In a narrow docker "Linear" is cut short: its tooltip says it.)
    const whole_word = text_module.measure(state.smallOf(app), "Linear") + px(app, 10) <= linear.width
    if segment(app, view.id("nebula.histogram.linear"), linear, if whole_word { "Linear" } else { "Lin" }, !keep.*.logarithmic) && keep.*.logarithmic {
        keep.*.logarithmic = false
        api.redraw(app)
    }
    kit_module.tooltip(k, view.id("nebula.histogram.linear"), linear, state.tr(app, "Bars in proportion to the counts", "Balken im Verhältnis der Anzahlen"))
    if segment(app, view.id("nebula.histogram.log"), logarithmic, "Log", keep.*.logarithmic) && !keep.*.logarithmic {
        keep.*.logarithmic = true
        api.redraw(app)
    }
    kit_module.tooltip(k, view.id("nebula.histogram.log"), logarithmic, state.tr(app, "Bars by the logarithm of the counts: small counts show", "Balken nach dem Logarithmus der Anzahlen: kleine Anzahlen werden sichtbar"))
    keep.*.controls[CONTROL_LINEAR] = linear
    keep.*.controls[CONTROL_LOG] = logarithmic
}

// `value` with `decimals` in the language of the program (a decimal
// comma and a point between thousands in German, a point and commas in
// English) into `into` (64 bytes); its length.
fn formatValue(app: *App, value: f64, decimals: usize, into: [*]u8) -> usize {
    var digits: [kit_module.NUMBER_ROOM]u8 = undefined
    const raw: [*]u8 = &digits
    const length = kit_module.formatNumber(value, decimals, raw)
    var point = length
    var index: usize = 0
    while index < length {
        if raw[index] == '.' { point = index }
        index += 1
    }
    const group: u8 = if app.*.german { '.' } else { ',' }
    const decimal: u8 = if app.*.german { ',' } else { '.' }
    var used: usize = 0
    index = 0
    if length > 0 && raw[0] == '-' {
        used = std.text.appendByte(into, used, 64, '-')
        index = 1
    }
    while index < length {
        const byte = raw[index]
        if index == point {
            used = std.text.appendByte(into, used, 64, decimal)
        } else {
            used = std.text.appendByte(into, used, 64, byte)
            // A group mark after every third digit from the point back.
            if index < point {
                const left = point - index - 1
                if left > 0 && left % 3 == 0 { used = std.text.appendByte(into, used, 64, group) }
            }
        }
        index += 1
    }
    return used
}

// A caption over a number, in `area` (two lines).
fn drawNumber(app: *App, area: ui.Rect, caption: []const u8, value: []const u8) -> void {
    const k = api.kit(app)
    const line = px(app, LINE)
    kit_module.label(k, ui.rect(area.x, area.y, area.width, line), caption, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    kit_module.label(k, ui.rect(area.x, area.y + line, area.width, line), value, kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
}

// A caption and its number in one line: the caption at the left, the
// number at the right (a narrow docker).
fn drawNumberLine(app: *App, area: ui.Rect, caption: []const u8, value: []const u8) -> void {
    const k = api.kit(app)
    kit_module.label(k, area, caption, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    kit_module.label(k, area, value, kit_module.TEXT_NORMAL, kit_module.ALIGN_RIGHT)
}

// Whether the numbers stand in three columns in `width` (else in three
// lines).
fn numbersInColumns(app: *App, width: i32) -> bool { return width / 3 >= px(app, NUMBER_COLUMN) }

// The number of pixels, the mean and the median of the counts in `area`:
// in three columns, a caption over each number, or (narrow) in three
// lines.
fn drawNumbers(app: *App, keep: *Keep, area: ui.Rect, fresh: bool) -> void {
    const columns = numbersInColumns(app, area.width)
    const third = area.width / 3
    const line = px(app, LINE)
    var pixels_text: [64]u8 = undefined
    var mean_text: [64]u8 = undefined
    var median_text: [64]u8 = undefined
    const pixels_bytes: [*]u8 = &pixels_text
    const mean_bytes: [*]u8 = &mean_text
    const median_bytes: [*]u8 = &median_text
    const known = keep.*.have && fresh && keep.*.total > 0
    var pixels_length: usize = 0
    var mean_length: usize = 0
    var median_length: usize = 0
    if keep.*.have && fresh { pixels_length = formatValue(app, @floatFromInt(f64, keep.*.total), 0, pixels_bytes) }
    if known {
        mean_length = formatValue(app, mean(countsOf(keep), keep.*.channel, keep.*.total), 1, mean_bytes)
        median_length = std.text.appendUnsigned(median_bytes, 0, 64, median(countsOf(keep), keep.*.channel, keep.*.total))
    }
    // (A dash where there is no number yet.)
    const dash = "\xE2\x80\x93"
    const pixels_value = if pixels_length > 0 { pixels_bytes[0..pixels_length] } else { dash }
    const mean_value = if mean_length > 0 { mean_bytes[0..mean_length] } else { dash }
    const median_value = if median_length > 0 { median_bytes[0..median_length] } else { dash }
    if columns {
        drawNumber(app, ui.rect(area.x, area.y, third, area.height), state.tr(app, "Pixels", "Pixel"), pixels_value)
        drawNumber(app, ui.rect(area.x + third, area.y, third, area.height), state.tr(app, "Mean", "Mittel"), mean_value)
        drawNumber(app, ui.rect(area.x + third * 2, area.y, area.width - third * 2, area.height), state.tr(app, "Median", "Median"), median_value)
        return
    }
    drawNumberLine(app, ui.rect(area.x, area.y, area.width, line), state.tr(app, "Pixels", "Pixel"), pixels_value)
    drawNumberLine(app, ui.rect(area.x, area.y + line, area.width, line), state.tr(app, "Mean", "Mittel"), mean_value)
    drawNumberLine(app, ui.rect(area.x, area.y + line * 2, area.width, line), state.tr(app, "Median", "Median"), median_value)
}

// The bars' box: a field with the counts' bars, faint lines at a quarter,
// a half and three quarters of the values, what is under way.
fn drawChart(app: *App, keep: *Keep, chart: ui.Rect, fresh: bool) -> void {
    const k = api.kit(app)
    const theme = state.themeOf(app)
    const canvas = kit_module.canvasOf(k)
    const s = app.*.scale
    canvas_module.fillRoundedRect(canvas, chart.x, chart.y, chart.width, chart.height, theme.*.smallRadius, theme.*.field)
    canvas_module.strokeRoundedRect(canvas, chart.x, chart.y, chart.width, chart.height, theme.*.smallRadius, s, theme_module.mix(theme.*.field, theme.*.border, 330))
    const inner = ui.rect(chart.x + 2 * s, chart.y + 2 * s, chart.width - 4 * s, chart.height - 4 * s)
    keep.*.chart = inner
    if inner.width <= 0 || inner.height <= 0 { return }
    const faint = theme_module.mix(theme.*.field, theme.*.border, 200)
    var quarter: i32 = 1
    while quarter < 4 {
        canvas_module.fillRect(canvas, inner.x + inner.width * quarter / 4, inner.y, s, inner.height, faint)
        quarter += 1
    }
    if keep.*.have {
        // Counts of something else (still being counted again) are faded.
        const opacity = canvas.*.opacity
        if !fresh { canvas_module.setOpacity(canvas, opacity * 90 / 255) }
        drawBars(canvas, inner, countsOf(keep), keep.*.channel, keep.*.logarithmic, barColor(theme, keep.*.channel))
        canvas_module.setOpacity(canvas, opacity)
    }
    if keep.*.running {
        const done = if keep.*.blocks == 0 { 1.0 } else { @floatFromInt(f64, keep.*.next) / @floatFromInt(f64, keep.*.blocks) }
        kit_module.progress(k, ui.rect(inner.x + 4 * s, ui.bottom(inner) - 6 * s, inner.width - 8 * s, 3 * s), done)
        // (Over faded bars of before the bar alone says it; with none to
        // show, the words too.)
        if !keep.*.have || keep.*.total == 0 { kit_module.label(k, inner, state.tr(app, "Computing\xE2\x80\xA6", "Wird berechnet\xE2\x80\xA6"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER) }
    } else if keep.*.failed {
        kit_module.label(k, inner, state.tr(app, "Not enough memory to count", "Zu wenig Speicher zum Zählen"), kit_module.TEXT_DANGER, kit_module.ALIGN_CENTER)
    } else if keep.*.have && keep.*.total == 0 {
        kit_module.label(k, inner, state.tr(app, "No pixels to count", "Keine Pixel zu zählen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
    }
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    const k = api.kit(app)
    keep.?.*.chart = ui.rect(0, 0, 0, 0)
    var part: usize = 0
    while part < CONTROLS {
        keep.?.*.controls[part] = ui.rect(0, 0, 0, 0)
        part += 1
    }
    const image = api.image(app)
    if image == null {
        keep.?.*.frame = k.*.frame
        keep.?.*.have = false
        keep.?.*.running = false
        kit_module.label(k, area, state.tr(app, "No image is open", "Kein Bild ist offen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    var node: ?*Node = null
    if keep.?.*.source == SOURCE_LAYER {
        node = image.?.*.active
        if node == null {
            keep.?.*.frame = k.*.frame
            kit_module.label(k, area, state.tr(app, "There is no active layer", "Es gibt keine aktive Ebene"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
            return
        }
    }
    refresh(app, keep.?, image.?, node)
    // The counts shown are of what is chosen now (else they are faded).
    const fresh = keep.?.*.have && keep.?.*.of.image == image.?.*.number && keep.?.*.of.node == (if node == null { 0 } else { @intFromPtr(node.?) }) && !keep.?.*.running
    const padding = px(app, PADDING)
    const row = px(app, ROW)
    const gap = px(app, 4)
    const x = area.x + padding
    const width = area.width - padding * 2
    var y = area.y + padding
    // The choices: in one row when there is room, else in two.
    const scale_width = px(app, 84)
    const source_width = px(app, 78)
    var channel_box = ui.rect(x, y, width - source_width - scale_width - gap * 2, row)
    var source_box = ui.rect(ui.right(channel_box) + gap, y, source_width, row)
    var scale_box = ui.rect(ui.right(source_box) + gap, y, scale_width, row)
    if channel_box.width < px(app, 96) {
        channel_box = ui.rect(x, y, width, row)
        y += row + gap
        source_box = ui.rect(x, y, (width - gap) / 2, row)
        scale_box = ui.rect(ui.right(source_box) + gap, y, width - source_box.width - gap, row)
    }
    if kit_module.comboBoxWith(k, view.id("nebula.histogram.channel"), channel_box, CHANNELS, channelName, @intFromPtr(app), &keep.?.*.channel) { api.redraw(app) }
    if kit_module.comboBoxWith(k, view.id("nebula.histogram.source"), source_box, 2, sourceName, @intFromPtr(app), &keep.?.*.source) { api.redraw(app) }
    kit_module.tooltip(k, view.id("nebula.histogram.source"), source_box, state.tr(app, "Count the active layer or the whole image", "Die aktive Ebene oder das ganze Bild zählen"))
    drawScale(app, keep.?, scale_box)
    keep.?.*.controls[CONTROL_CHANNEL] = channel_box
    keep.?.*.controls[CONTROL_SOURCE] = source_box
    y += row + gap * 2
    // The numbers at the bottom, the bars and their strip in what is left.
    const numbers = px(app, LINE) * (if numbersInColumns(app, width - 2 * app.*.scale) { 2 } else { 3 })
    const strip = px(app, STRIP)
    var chart_height = ui.bottom(area) - padding - numbers - gap * 2 - strip - y
    if chart_height < px(app, LEAST_CHART) { chart_height = px(app, LEAST_CHART) }
    const chart = ui.rect(x, y, width, chart_height)
    drawChart(app, keep.?, chart, fresh)
    const inner = keep.?.*.chart
    drawStrip(kit_module.canvasOf(k), ui.rect(inner.x, ui.bottom(chart) + gap, inner.width, strip), keep.?.*.channel)
    drawNumbers(app, keep.?, ui.rect(x + 2 * app.*.scale, ui.bottom(chart) + gap * 2 + strip, width - 2 * app.*.scale, numbers), fresh)
}
