// nebula dockers: the timeline: the animation of the image in front
// (core/animation.mlx) as rows of frames. A row for every animated layer
// and one for the active layer (the topmost first, as the layer list
// has them), a column for every frame; a cell shows a key (a filled mark;
// an outlined one for an empty frame), the hold of a key until the next
// (a line), nothing where nothing is. The frames of the clip are lighter
// than those outside it; the time shown is a lit column, its number lit
// in the ruler above.
//
// A click on a cell shows that time and makes the row's layer the active
// one; a double click adds an empty frame there (the first key of a layer
// that is not animated yet makes it animated); a key dragged along its
// row moves to where it is let go. A press on the ruler, and a drag along
// it, shows the time under the pointer. Above the rows: the transport
// (first frame, the one before, play and pause, the one after, the last
// frame of the clip), the time shown as a number, the keys of the active
// layer (an empty frame, a copy of the frame shown, the key taken away,
// the hold made a frame longer and shorter), zoom, the clip's frames
// written as PNG files beside the image's file ("walk.kra" gives
// "walk_0001.png" ...), the frame rate, the clip's start and end, the
// onion skin and how many keys it shows before and after. They wrap onto
// as many rows as the docker's width needs.
// The frames scroll sideways by the bar under them (dragged, or pressed
// beside its thumb), by the wheel over the ruler, and follow the time
// shown; the rows scroll up and down when there are more than fit.
// Keys over the docker: Left and Right a frame, with Shift to the key
// before and after, Home and End to the clip's ends, Enter plays and
// pauses, Delete takes the key at the time shown away.
//
// Playing: the time goes on by the clock (a frame every 1/fps second, round
// the clip), the docker asking the kit for a frame when the next one is
// due (the kit's wakeIn: the program's loop has no way yet for a docker
// to ask for time). The onion skin is drawn over the canvas through the
// canvas view's marks of a part that is not a tool (setMarks), while it
// is on.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("std.ui.keys")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const text_module = @import("std.ui.text")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const animation = @import("../core/animation.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const device_module = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const io_text = @import("../io/text.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const overlay = @import("../ui/overlay.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const viewport = @import("../ui/viewport.mlx")

pub const App = state.App
pub const Canvas = state.Canvas
pub const Animation = animation.Animation

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 10

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "timeline", .name = "Timeline", .german = "Zeitleiste", .icon = icons.DOCKER_ANIMATION, .draw = draw, .keyPress = keyPress, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// Sizes (times the scale): a button, a row of controls, the gaps between
// controls and between groups of them, the room around the docker's
// content, the ruler, a row of frames, the bar under the frames.
const BUTTON: i32 = 24
const GAP: i32 = 2
const GROUP_GAP: i32 = 10
const PAD: i32 = 6
const RULER: i32 = 20
const ROW: i32 = 24
const BAR: i32 = 8
const NUMBER_BOX: i32 = 56
const ONION_BOX: i32 = 50
// The width of a frame at each zoom, and the one a docker starts with.
const ZOOMS = [9]i32{ 4, 6, 8, 10, 12, 16, 20, 24, 32 }
const ZOOM_COUNT: usize = 9
const ZOOM_START: usize = 4
// The ruler numbers every so many frames: the first of these whose
// numbers do not run into each other.
const EVERY = [10]i32{ 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000 }
const EVERY_COUNT: usize = 10
// The most rows listed.
pub const MOST_ROWS: usize = 64

// The buttons (buttonArea's numbers).
pub const BUTTON_FIRST: usize = 0
pub const BUTTON_PREVIOUS: usize = 1
pub const BUTTON_PLAY: usize = 2
pub const BUTTON_NEXT: usize = 3
pub const BUTTON_LAST: usize = 4
pub const BUTTON_BLANK: usize = 5
pub const BUTTON_DUPLICATE: usize = 6
pub const BUTTON_REMOVE: usize = 7
pub const BUTTON_HOLD_MORE: usize = 8
pub const BUTTON_HOLD_LESS: usize = 9
pub const BUTTON_ZOOM_OUT: usize = 10
pub const BUTTON_ZOOM_IN: usize = 11
pub const BUTTON_EXPORT: usize = 12
pub const BUTTON_ONION: usize = 13
pub const BUTTONS: usize = 14

// The number fields (fieldArea's numbers).
pub const FIELD_TIME: usize = 0
pub const FIELD_FPS: usize = 1
pub const FIELD_START: usize = 2
pub const FIELD_END: usize = 3
pub const FIELD_BEFORE: usize = 4
pub const FIELD_AFTER: usize = 5
pub const FIELDS: usize = 6

// What the docker keeps from frame to frame.
const Keep = struct {
    ready: bool
    // The first frame in view, the zoom (an index of ZOOMS), how far the
    // rows are scrolled.
    first: i32
    zoom: usize
    rowsOffset: i32
    // The image and the time shown when the docker drew last: when the
    // time moved out of view, the view follows it.
    image: u64
    lastTime: i32
    // The last click on a cell (a second close to it on the same cell is
    // a double click).
    clickRow: usize
    clickTime: i32
    // The bar under the frames held: the first frame when it was taken.
    barHeld: bool
    barFrom: i32
    // The onion skin's marks are given to the canvas view.
    marks: bool
    // The numbers the fields edit, and what they are told (kept here: as
    // locals they would be taken from the value arena at every frame).
    values: [6]i32
    options: [6]kit_module.SliderOptions
    // Where things were drawn: in which of the kit's frames, the cells'
    // left edge and a frame's width, the first row's top, the rows' view,
    // the ruler, the bar, the rows' layers, the buttons, the fields.
    frame: u64
    cellsX: i32
    cellWidth: i32
    rowsTop: i32
    rowsView: ui.Rect
    ruler: ui.Rect
    bar: ui.Rect
    rowNodes: [64]u32
    rowCount: usize
    buttons: [14]ui.Rect
    fields: [6]ui.Rect
    // A ruler's number as text, for the moment it is drawn; the files'
    // common name when the clip is exported.
    digits: [12]u8
    base: [1024]u8
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        keep.*.first = 0
        keep.*.zoom = ZOOM_START
        keep.*.rowsOffset = 0
        keep.*.image = 0
        keep.*.lastTime = -1
        keep.*.clickRow = MOST_ROWS
        keep.*.clickTime = -1
        keep.*.barHeld = false
        keep.*.marks = false
        keep.*.options[FIELD_TIME] = kit_module.sliderOptions(0.0, @floatFromInt(f64, animation.LAST_TIME), 1.0, 0)
        keep.*.options[FIELD_FPS] = kit_module.sliderOptions(1.0, @floatFromInt(f64, animation.FASTEST), 1.0, 0)
        keep.*.options[FIELD_START] = kit_module.sliderOptions(0.0, @floatFromInt(f64, animation.LAST_TIME), 1.0, 0)
        keep.*.options[FIELD_END] = kit_module.sliderOptions(0.0, @floatFromInt(f64, animation.LAST_TIME), 1.0, 0)
        keep.*.options[FIELD_BEFORE] = kit_module.sliderOptions(0.0, @floatFromInt(f64, animation.ONION_MOST), 1.0, 0)
        keep.*.options[FIELD_AFTER] = kit_module.sliderOptions(0.0, @floatFromInt(f64, animation.ONION_MOST), 1.0, 0)
        keep.*.frame = 0
        keep.*.rowCount = 0
        keep.*.ready = true
    }
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn none() -> ui.Rect { return ui.rect(0, 0, 0, 0) }

fn buttonId(which: usize) -> u64 { return view.idOf(view.id("nebula.timeline.button"), which) }
fn fieldId(which: usize) -> u64 { return view.idOf(view.id("nebula.timeline.field"), which) }
fn nameId(row: usize) -> u64 { return view.idOf(view.id("nebula.timeline.name"), row) }
fn cellsId(row: usize) -> u64 { return view.idOf(view.id("nebula.timeline.cells"), row) }
fn rulerId() -> u64 { return view.id("nebula.timeline.ruler") }
fn barId() -> u64 { return view.id("nebula.timeline.bar") }
fn rowsId() -> u64 { return view.id("nebula.timeline.rows") }

// ---------------------------------------------------------------------------
// Where things were drawn (for tests, and for whoever points at them)

fn drawnNow(app: *App, keep: *Keep) -> bool { return keep.*.frame == api.kit(app).*.frame && keep.*.cellWidth > 0 }

// Where button `which` (BUTTON_*) was drawn in the last frame (empty: not
// in view, or the docker was not drawn).
pub fn buttonArea(app: *App, which: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || which >= BUTTONS || keep.?.*.frame != api.kit(app).*.frame { return none() }
    return keep.?.*.buttons[which]
}

// Where number field `which` (FIELD_*) was drawn in the last frame.
pub fn fieldArea(app: *App, which: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || which >= FIELDS || keep.?.*.frame != api.kit(app).*.frame { return none() }
    return keep.?.*.fields[which]
}

// Where the ruler was drawn in the last frame.
pub fn rulerArea(app: *App) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || !drawnNow(app, keep.?) { return none() }
    return keep.?.*.ruler
}

// Where the bar under the frames was drawn in the last frame.
pub fn barArea(app: *App) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || !drawnNow(app, keep.?) { return none() }
    return keep.?.*.bar
}

// How many rows the docker listed in the last frame, and the layer of
// row `row` (0: none).
pub fn rowCount(app: *App) -> usize {
    const keep = keepOf(app)
    if keep == null || !drawnNow(app, keep.?) { return 0 }
    return keep.?.*.rowCount
}

pub fn rowNode(app: *App, row: usize) -> u32 {
    const keep = keepOf(app)
    if keep == null || !drawnNow(app, keep.?) || row >= keep.?.*.rowCount { return 0 }
    return keep.?.*.rowNodes[row]
}

// Where the cell of row `row` at `time` was drawn in the last frame
// (empty: not in view).
pub fn cellArea(app: *App, row: usize, time: i32) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || !drawnNow(app, keep.?) || row >= keep.?.*.rowCount || time < keep.?.*.first { return none() }
    const k = keep.?
    const x = @intCast(i64, k.*.cellsX) + (@intCast(i64, time) - @intCast(i64, k.*.first)) * @intCast(i64, k.*.cellWidth)
    const y = k.*.rowsTop + @intCast(i32, row) * px(app, ROW)
    if x + @intCast(i64, k.*.cellWidth) > @intCast(i64, ui.right(k.*.rowsView)) { return none() }
    const area = ui.rect(@intCast(i32, x), y, k.*.cellWidth, px(app, ROW))
    if area.y < k.*.rowsView.y || ui.bottom(area) > ui.bottom(k.*.rowsView) { return none() }
    return area
}

// The first frame in view.
pub fn firstFrame(app: *App) -> i32 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return keep.?.*.first
}

// A frame's width now (window pixels).
pub fn frameWidth(app: *App) -> i32 {
    const keep = keepOf(app)
    if keep == null { return 0 }
    return px(app, ZOOMS[keep.?.*.zoom])
}

// ---------------------------------------------------------------------------
// Doing things

fn name(app: *App, english: []const u8, german: []const u8) -> []const u8 { return state.tr(app, english, german) }

// The time shown becomes `time`; playing goes on from there.
fn showTime(app: *App, anim: *Animation, image: *image_module.Image, time: i32) -> void {
    _ = animation.setTime(anim, image, time)
    if anim.*.playing { animation.play(anim, app.*.time) }
    api.redraw(app)
}

// The node of the active layer when it can have keys (a paint layer);
// else null, and the status bar says why.
fn keyedLayer(app: *App, image: *image_module.Image) -> ?*node_module.Node {
    const node = image.*.active
    if node == null {
        api.say(app, name(app, "There is no layer to animate", "Es gibt keine Ebene zum Animieren"), true)
        return null
    }
    if node.?.*.kind != node_module.PAINT {
        api.say(app, name(app, "Only paint layers can be animated", "Nur Malebenen können animiert werden"), true)
        return null
    }
    return node
}

fn afterKeys(app: *App, done: bool) -> void {
    if !done { api.say(app, name(app, "The frames could not be changed", "Die Bilder konnten nicht geändert werden"), true) }
    api.layersChanged(app)
}

fn doButton(app: *App, anim: *Animation, image: *image_module.Image, which: usize) -> void {
    const time = anim.*.time
    if which == BUTTON_FIRST {
        showTime(app, anim, image, anim.*.start)
    } else if which == BUTTON_PREVIOUS {
        showTime(app, anim, image, if time > 0 { time - 1 } else { 0 })
    } else if which == BUTTON_PLAY {
        if anim.*.playing { animation.pause(anim) } else { animation.play(anim, app.*.time) }
        api.redraw(app)
    } else if which == BUTTON_NEXT {
        showTime(app, anim, image, time + 1)
    } else if which == BUTTON_LAST {
        showTime(app, anim, image, anim.*.end)
    } else if which == BUTTON_ZOOM_OUT {
        const keep = keepOf(app)
        if keep != null && keep.?.*.zoom > 0 { keep.?.*.zoom -= 1 }
        api.redraw(app)
    } else if which == BUTTON_ZOOM_IN {
        const keep = keepOf(app)
        if keep != null && keep.?.*.zoom + 1 < ZOOM_COUNT { keep.?.*.zoom += 1 }
        api.redraw(app)
    } else if which == BUTTON_ONION {
        animation.setOnion(anim, !anim.*.onionOn, anim.*.before, anim.*.after)
        api.redraw(app)
    } else if which == BUTTON_EXPORT {
        exportClip(app, anim, image)
    } else {
        if api.toolBusy(app) { return }
        const node = keyedLayer(app, image)
        if node == null { return }
        const id = node.?.*.id
        var done = false
        if which == BUTTON_BLANK {
            done = animation.addBlankKey(anim, image, id, time, name(app, "New Frame", "Neues Bild"))
        } else if which == BUTTON_DUPLICATE {
            done = animation.addDuplicateKey(anim, image, id, time, name(app, "Duplicate Frame", "Bild duplizieren"))
        } else if which == BUTTON_REMOVE {
            done = animation.removeKey(anim, image, id, time, name(app, "Remove Frame", "Bild entfernen"))
        } else if which == BUTTON_HOLD_MORE {
            done = animation.insertHold(anim, image, id, time, 1, name(app, "Insert Hold Frame", "Haltebild einfügen"))
        } else if which == BUTTON_HOLD_LESS {
            done = animation.removeHold(anim, image, id, time, 1, name(app, "Remove Hold Frame", "Haltebild entfernen"))
        }
        afterKeys(app, done)
    }
}

// The clip's frames as PNG files beside the image's file: "walk.kra"
// gives "walk_0001.png" ... The status bar says how it went.
fn exportClip(app: *App, anim: *Animation, image: *image_module.Image) -> void {
    const keep = keepOf(app)
    if keep == null || api.toolBusy(app) { return }
    const path = image_module.pathOf(image)
    const base: [*]u8 = &keep.?.*.base
    const length = if path.length > 0 { io_text.withExtension(path, "", base, 1024) } else { 0 }
    if length == 0 {
        api.say(app, name(app, "Save the image first: its frames are written beside its file", "Erst das Bild speichern: seine Bilder werden neben seine Datei geschrieben"), true)
        return
    }
    var written: usize = 0
    const result = animation.exportSequence(anim, image, base[0..length], anim.*.start, anim.*.end, &written)
    if result != animation.Export.ok {
        api.say(app, name(app, "The frames could not all be written", "Die Bilder konnten nicht alle geschrieben werden"), true)
        return
    }
    const digits: [*]u8 = &keep.?.*.digits
    const count = std.text.appendUnsigned(digits, 0, 12, written)
    api.sayWith(app, digits[0..count], name(app, " frames written beside the image's file", " Bilder neben die Datei des Bildes geschrieben"), false)
}

// Whether button `which` can do something now.
fn buttonEnabled(app: *App, anim: *Animation, image: *image_module.Image, which: usize) -> bool {
    if which < BUTTON_BLANK || which >= BUTTON_ZOOM_OUT { return true }
    const node = image.*.active
    if node == null || node.?.*.kind != node_module.PAINT { return false }
    if which == BUTTON_BLANK { return true }
    const track = animation.trackOf(anim, node.?.*.id)
    var at: usize = 0
    var next: i32 = 0
    if which == BUTTON_DUPLICATE { return track == null || !animation.keyIndexAt(track.?, anim.*.time, &at) }
    if track == null { return false }
    if which == BUTTON_REMOVE { return animation.keyCount(track.?) > 1 && animation.keyIndexAt(track.?, anim.*.time, &at) }
    if !animation.nextKey(track.?, anim.*.time, &next) { return false }
    if which == BUTTON_HOLD_LESS { return next - anim.*.time > 1 }
    return true
}

// ---------------------------------------------------------------------------
// Drawing

// Controls laid out left to right, onto the next row when one does not
// fit any more.
const Flow = struct {
    left: i32
    right: i32
    x: i32
    y: i32
    height: i32
    gap: i32
    rowGap: i32
}

// The place of a group `width` wide.
fn place(flow: *Flow, width: i32) -> ui.Rect {
    if flow.*.x > flow.*.left && flow.*.x + width > flow.*.right {
        flow.*.x = flow.*.left
        flow.*.y += flow.*.height + flow.*.rowGap
    }
    const area = ui.rect(flow.*.x, flow.*.y, width, flow.*.height)
    flow.*.x += width + flow.*.gap
    return area
}

fn iconOf(which: usize, playing: bool) -> u16 {
    if which == BUTTON_FIRST { return icons.FRAME_FIRST }
    if which == BUTTON_PREVIOUS { return icons.FRAME_PREVIOUS }
    if which == BUTTON_PLAY { return if playing { icons.PAUSE } else { icons.PLAY } }
    if which == BUTTON_NEXT { return icons.FRAME_NEXT }
    if which == BUTTON_LAST { return icons.FRAME_LAST }
    if which == BUTTON_BLANK { return icons.FRAME_ADD }
    if which == BUTTON_DUPLICATE { return icons.LAYER_DUPLICATE }
    if which == BUTTON_REMOVE { return icons.FRAME_REMOVE }
    if which == BUTTON_HOLD_MORE { return icons.PLUS }
    if which == BUTTON_HOLD_LESS { return icons.MINUS }
    if which == BUTTON_ZOOM_OUT { return icons.ZOOM_OUT }
    if which == BUTTON_ZOOM_IN { return icons.ZOOM_IN }
    if which == BUTTON_EXPORT { return icons.FILE_EXPORT }
    return icons.ONION_SKIN
}

fn tipOf(app: *App, which: usize, playing: bool) -> []const u8 {
    if which == BUTTON_FIRST { return name(app, "First frame of the clip (Home)", "Erstes Bild des Clips (Pos1)") }
    if which == BUTTON_PREVIOUS { return name(app, "Previous frame (Left)", "Vorheriges Bild (Links)") }
    if which == BUTTON_PLAY { return if playing { name(app, "Pause (Enter)", "Anhalten (Eingabe)") } else { name(app, "Play (Enter)", "Abspielen (Eingabe)") } }
    if which == BUTTON_NEXT { return name(app, "Next frame (Right)", "Nächstes Bild (Rechts)") }
    if which == BUTTON_LAST { return name(app, "Last frame of the clip (End)", "Letztes Bild des Clips (Ende)") }
    if which == BUTTON_BLANK { return name(app, "New empty frame here", "Neues leeres Bild hier") }
    if which == BUTTON_DUPLICATE { return name(app, "Copy of the frame shown here", "Kopie des gezeigten Bildes hier") }
    if which == BUTTON_REMOVE { return name(app, "Remove the frame here (Delete)", "Bild hier entfernen (Entf)") }
    if which == BUTTON_HOLD_MORE { return name(app, "Hold the frame one longer", "Bild eins länger halten") }
    if which == BUTTON_HOLD_LESS { return name(app, "Hold the frame one shorter", "Bild eins kürzer halten") }
    if which == BUTTON_ZOOM_OUT { return name(app, "Narrower frames", "Schmalere Bilder") }
    if which == BUTTON_ZOOM_IN { return name(app, "Wider frames", "Breitere Bilder") }
    if which == BUTTON_EXPORT { return name(app, "Write the clip's frames as PNG files beside the image's file", "Die Bilder des Clips als PNG-Dateien neben die Datei des Bildes schreiben") }
    return name(app, "Onion skin: the frames before and after, tinted", "Zwiebelhaut: die Bilder davor und danach, getönt")
}

fn button(app: *App, keep: *Keep, anim: *Animation, image: *image_module.Image, which: usize, area: ui.Rect) -> void {
    const k = api.kit(app)
    keep.*.buttons[which] = area
    const enabled = buttonEnabled(app, anim, image, which)
    if !enabled { kit_module.disabledBegin(k) }
    const active = (which == BUTTON_PLAY && anim.*.playing) || (which == BUTTON_ONION && anim.*.onionOn)
    if kit_module.toolButton(k, buttonId(which), area, icons.drawFor, @intCast(usize, iconOf(which, anim.*.playing)), active, tipOf(app, which, anim.*.playing)) && enabled {
        doButton(app, anim, image, which)
    }
    if !enabled { kit_module.disabledEnd(k) }
}

// A row of buttons from `first` to `last` in `area`.
fn buttons(app: *App, keep: *Keep, anim: *Animation, image: *image_module.Image, first: usize, last: usize, area: ui.Rect) -> void {
    var x = area.x
    var which = first
    while which <= last {
        button(app, keep, anim, image, which, ui.rect(x, area.y, px(app, BUTTON), px(app, BUTTON)))
        x += px(app, BUTTON + GAP)
        which += 1
    }
}

fn buttonsWidth(app: *App, count: i32) -> i32 { return px(app, BUTTON * count + GAP * (count - 1)) }

// A number field: true when its value changed in this frame.
fn field(app: *App, keep: *Keep, which: usize, area: ui.Rect, tip: []const u8) -> bool {
    const k = api.kit(app)
    keep.*.fields[which] = area
    const changed = kit_module.intBox(k, fieldId(which), area, &keep.*.values[which], &keep.*.options[which])
    kit_module.tooltip(k, fieldId(which), area, tip)
    return changed
}

fn labelWidth(app: *App, text: []const u8) -> i32 {
    return text_module.measure(state.smallOf(app), text) + px(app, 6)
}

// The controls above the frames; the height they took.
fn controls(app: *App, keep: *Keep, anim: *Animation, image: *image_module.Image, area: ui.Rect) -> i32 {
    const k = api.kit(app)
    var flow = Flow.{ .left = area.x, .right = ui.right(area), .x = area.x, .y = area.y, .height = px(app, BUTTON), .gap = px(app, GROUP_GAP), .rowGap = px(app, 4) }
    keep.*.values[FIELD_TIME] = anim.*.time
    keep.*.values[FIELD_FPS] = anim.*.fps
    keep.*.values[FIELD_START] = anim.*.start
    keep.*.values[FIELD_END] = anim.*.end
    keep.*.values[FIELD_BEFORE] = anim.*.before
    keep.*.values[FIELD_AFTER] = anim.*.after
    buttons(app, keep, anim, image, BUTTON_FIRST, BUTTON_LAST, place(&flow, buttonsWidth(app, 5)))
    if field(app, keep, FIELD_TIME, place(&flow, px(app, NUMBER_BOX + 8)), name(app, "The frame shown", "Das gezeigte Bild")) {
        showTime(app, anim, image, keep.*.values[FIELD_TIME])
    }
    buttons(app, keep, anim, image, BUTTON_BLANK, BUTTON_HOLD_LESS, place(&flow, buttonsWidth(app, 5)))
    buttons(app, keep, anim, image, BUTTON_ZOOM_OUT, BUTTON_EXPORT, place(&flow, buttonsWidth(app, 3)))
    // The frame rate.
    const rate = name(app, "FPS", "Bilder/s")
    const rate_width = labelWidth(app, rate)
    const rate_area = place(&flow, rate_width + px(app, NUMBER_BOX))
    kit_module.label(k, ui.rect(rate_area.x, rate_area.y, rate_width, rate_area.height), rate, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    if field(app, keep, FIELD_FPS, ui.rect(rate_area.x + rate_width, rate_area.y, px(app, NUMBER_BOX), rate_area.height), name(app, "Frames a second", "Bilder pro Sekunde")) {
        animation.setRate(anim, keep.*.values[FIELD_FPS])
        if anim.*.playing { animation.play(anim, app.*.time) }
        image.*.modified = true
    }
    // The clip.
    const clip = name(app, "Clip", "Clip")
    const clip_width = labelWidth(app, clip)
    const dash = px(app, 14)
    const clip_area = place(&flow, clip_width + px(app, NUMBER_BOX) * 2 + dash)
    kit_module.label(k, ui.rect(clip_area.x, clip_area.y, clip_width, clip_area.height), clip, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    const start_area = ui.rect(clip_area.x + clip_width, clip_area.y, px(app, NUMBER_BOX), clip_area.height)
    if field(app, keep, FIELD_START, start_area, name(app, "The clip's first frame", "Das erste Bild des Clips")) {
        animation.setRange(anim, keep.*.values[FIELD_START], if keep.*.values[FIELD_START] > anim.*.end { keep.*.values[FIELD_START] } else { anim.*.end })
        image.*.modified = true
    }
    kit_module.label(k, ui.rect(ui.right(start_area), clip_area.y, dash, clip_area.height), "\u{2013}", kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
    if field(app, keep, FIELD_END, ui.rect(ui.right(start_area) + dash, clip_area.y, px(app, NUMBER_BOX), clip_area.height), name(app, "The clip's last frame", "Das letzte Bild des Clips")) {
        animation.setRange(anim, if keep.*.values[FIELD_END] < anim.*.start { keep.*.values[FIELD_END] } else { anim.*.start }, keep.*.values[FIELD_END])
        image.*.modified = true
    }
    // The onion skin: on or off, and how many keys before and after.
    const onion_area = place(&flow, px(app, BUTTON + 4 + ONION_BOX * 2 + 4))
    button(app, keep, anim, image, BUTTON_ONION, ui.rect(onion_area.x, onion_area.y, px(app, BUTTON), px(app, BUTTON)))
    const before_area = ui.rect(onion_area.x + px(app, BUTTON + 4), onion_area.y, px(app, ONION_BOX), onion_area.height)
    if field(app, keep, FIELD_BEFORE, before_area, name(app, "Onion skin: keys before", "Zwiebelhaut: Schlüsselbilder davor")) {
        animation.setOnion(anim, anim.*.onionOn, keep.*.values[FIELD_BEFORE], anim.*.after)
    }
    if field(app, keep, FIELD_AFTER, ui.rect(ui.right(before_area) + px(app, 4), onion_area.y, px(app, ONION_BOX), onion_area.height), name(app, "Onion skin: keys after", "Zwiebelhaut: Schlüsselbilder danach")) {
        animation.setOnion(anim, anim.*.onionOn, anim.*.before, keep.*.values[FIELD_AFTER])
    }
    return flow.y + flow.height - area.y
}

// The layers listed: the animated ones and the active one, the topmost
// first.
fn collect(keep: *Keep, anim: *Animation, image: *image_module.Image, group: *node_module.Node) -> void {
    var index = node_module.childCount(group)
    while index > 0 && keep.*.rowCount < MOST_ROWS {
        index -= 1
        const child = node_module.childAt(group, index)
        if node_module.isMask(child.*.kind) { continue }
        const active = image.*.active != null && @intFromPtr(image.*.active.?) == @intFromPtr(child)
        if (active && child.*.kind == node_module.PAINT) || animation.isAnimated(anim, child.*.id) {
            keep.*.rowNodes[keep.*.rowCount] = child.*.id
            keep.*.rowCount += 1
        }
        if child.*.kind == node_module.GROUP { collect(keep, anim, image, child) }
    }
}

fn timeAt(keep: *Keep, x: i32) -> i32 {
    if keep.*.cellWidth <= 0 { return keep.*.first }
    const offset = x - keep.*.cellsX
    const column = if offset < 0 { -1 } else { offset / keep.*.cellWidth }
    const time = keep.*.first + column
    return if time < 0 { 0 } else if time > animation.LAST_TIME { animation.LAST_TIME } else { time }
}

// The last frame the bar reaches (one screen past the last key and the
// clip's end).
fn reach(anim: *Animation, visible: i32) -> i32 {
    var last = animation.lastKeyTime(anim)
    if anim.*.end > last { last = anim.*.end }
    const far = last + visible
    return if far > animation.LAST_TIME { animation.LAST_TIME } else { far }
}

fn drawRow(app: *App, keep: *Keep, anim: *Animation, image: *image_module.Image, row: usize, area: ui.Rect, names: i32, visible: i32) -> void {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = kit_module.canvasOf(k)
    const s = theme.*.scale
    const node = image_module.find(image, keep.*.rowNodes[row])
    if node == null { return }
    const track = animation.trackOf(anim, node.?.*.id)
    const active = image.*.active != null && @intFromPtr(image.*.active.?) == @intFromPtr(node.?)
    const cell = keep.*.cellWidth
    const name_area = ui.rect(area.x, area.y, names, area.height)
    const cells = ui.rect(area.x + names, area.y, area.width - names, area.height)
    // The layer's name: a click makes it the active one.
    view.region(widgets, nameId(row), name_area)
    canvas_module.fillRect(canvas, name_area.x, name_area.y, name_area.width, name_area.height, if active { theme.*.selected } else if view.isHover(widgets, nameId(row)) { theme.*.hover } else { theme.*.panel })
    kit_module.label(k, ui.rect(name_area.x + px(app, 8), name_area.y, name_area.width - px(app, 12), name_area.height), node_module.nameOf(node.?), if track == null { kit_module.TEXT_DIM } else { kit_module.TEXT_NORMAL }, kit_module.ALIGN_LEFT)
    if track == null { kit_module.tooltip(k, nameId(row), name_area, name(app, "Not animated: a double click on a frame makes it so", "Nicht animiert: ein Doppelklick auf ein Bild macht es dazu")) }
    if view.takeClick(widgets, nameId(row)) && !active {
        image.*.active = node
        api.layersChanged(app)
    }
    // The frames: one region for the row; the frame is found by the
    // pointer.
    view.region(widgets, cellsId(row), cells)
    canvas_module.fillRect(canvas, cells.x, cells.y, cells.width, cells.height, theme.*.panel)
    const clip_left = cells.x + (anim.*.start - keep.*.first) * cell
    const clip_right = cells.x + (anim.*.end + 1 - keep.*.first) * cell
    const lit_left = if clip_left > cells.x { clip_left } else { cells.x }
    const lit_right = if clip_right < ui.right(cells) { clip_right } else { ui.right(cells) }
    if lit_right > lit_left { canvas_module.fillRect(canvas, lit_left, cells.y, lit_right - lit_left, cells.height, theme.*.raised) }
    // The time shown.
    const now_x = cells.x + (anim.*.time - keep.*.first) * cell
    if anim.*.time >= keep.*.first && anim.*.time < keep.*.first + visible {
        canvas_module.fillRect(canvas, now_x, cells.y, cell, cells.height, theme_module.mix(theme.*.raised, theme.*.accent, 300))
    }
    // Lines between the frames, every fifth a little stronger.
    if cell >= px(app, 8) {
        var column: i32 = 0
        while column < visible {
            const time = keep.*.first + column
            const strong = time % 5 == 0
            canvas_module.fillRect(canvas, cells.x + column * cell, cells.y, s, cells.height, if strong { theme_module.mix(theme.*.divider, theme.*.border, 260) } else { theme.*.divider })
            column += 1
        }
    }
    canvas_module.fillRect(canvas, area.x, ui.bottom(area) - s, area.width, s, theme.*.divider)
    if track == null { return }
    // The keys and their holds.
    const middle = cells.y + cells.height / 2
    // A key's mark: room around it in a wide frame, most of a narrow one.
    var mark = cell - 4 * s
    if mark > 10 * s { mark = 10 * s }
    if mark < 3 * s { mark = if cell - s < 3 * s { cell - s } else { 3 * s } }
    const ink = if active { theme.*.accent } else { theme.*.text }
    const hold = if active { theme_module.mix(theme.*.dim, theme.*.accent, 512) } else { theme.*.dim }
    const count = animation.keyCount(track.?)
    const last_shown = keep.*.first + visible
    var index: usize = 0
    while index < count {
        const time = animation.keyTime(track.?, index)
        // How far it holds: to the next key, or to the clip's end (the
        // first key holds back to the clip's start too).
        var until = if anim.*.end >= time { anim.*.end + 1 } else { time + 1 }
        if index + 1 < count { until = animation.keyTime(track.?, index + 1) }
        var from = time
        if index == 0 && anim.*.start < time { from = anim.*.start }
        if until > keep.*.first && from < last_shown {
            const key_x = cells.x + (time - keep.*.first) * cell
            const hold_from = if from < time { cells.x + (from - keep.*.first) * cell } else { key_x + cell / 2 }
            const hold_to = cells.x + (until - keep.*.first) * cell - (if index + 1 < count { cell / 2 } else { s * 2 })
            const left = if hold_from > cells.x { hold_from } else { cells.x }
            const right = if hold_to < ui.right(cells) { hold_to } else { ui.right(cells) }
            if right > left { canvas_module.fillRect(canvas, left, middle - s, right - left, 2 * s, hold) }
            if time >= keep.*.first && time < last_shown && mark > 0 {
                const mark_x = key_x + (cell - mark) / 2
                const mark_y = middle - mark / 2
                const blank = animation.isBlankKey(track.?, index)
                if blank {
                    canvas_module.fillRoundedRect(canvas, mark_x, mark_y, mark, mark, mark / 4, theme.*.raised)
                    canvas_module.strokeRoundedRect(canvas, mark_x, mark_y, mark, mark, mark / 4, if mark > 6 * s { 2 * s } else { s }, ink)
                } else {
                    canvas_module.fillRoundedRect(canvas, mark_x, mark_y, mark, mark, mark / 4, ink)
                }
            }
        }
        index += 1
    }
    // A key being dragged: where it would go.
    if view.isPressed(widgets, cellsId(row)) && widgets.*.pointerDown && mark > 0 {
        const from_time = timeAt(keep, widgets.*.pressX)
        const to_time = timeAt(keep, widgets.*.pointerX)
        var at: usize = 0
        if from_time != to_time && animation.keyIndexAt(track.?, from_time, &at) && to_time >= keep.*.first && to_time < last_shown {
            const ghost_x = cells.x + (to_time - keep.*.first) * cell + (cell - mark) / 2
            canvas_module.strokeRoundedRect(canvas, ghost_x - s, middle - mark / 2 - s, mark + 2 * s, mark + 2 * s, mark / 4 + s, s, theme.*.accent)
        }
    }
}

// A click on row `row`'s frames: the time and the active layer there; a
// double click on the same frame adds an empty one; a press on a key let
// go on another frame moves it there.
fn clickCells(app: *App, keep: *Keep, anim: *Animation, image: *image_module.Image, row: usize) -> void {
    const widgets = state.uiOf(app)
    const node = image_module.find(image, keep.*.rowNodes[row])
    if node == null { return }
    const from = timeAt(keep, widgets.*.pressX)
    const to = timeAt(keep, widgets.*.pointerX)
    const track = animation.trackOf(anim, node.?.*.id)
    var at: usize = 0
    if from != to && track != null && animation.keyIndexAt(track.?, from, &at) {
        if api.toolBusy(app) { return }
        afterKeys(app, animation.moveKey(anim, image, node.?.*.id, from, to, name(app, "Move Frame", "Bild verschieben")))
        showTime(app, anim, image, to)
        keep.*.clickRow = MOST_ROWS
        return
    }
    if image.*.active == null || @intFromPtr(image.*.active.?) != @intFromPtr(node.?) {
        image.*.active = node
        api.layersChanged(app)
    }
    const double = app.*.clicks == 2 && keep.*.clickRow == row && keep.*.clickTime == to
    keep.*.clickRow = row
    keep.*.clickTime = to
    showTime(app, anim, image, to)
    if double && !api.toolBusy(app) {
        keep.*.clickRow = MOST_ROWS
        if track == null || !animation.keyIndexAt(track.?, to, &at) {
            afterKeys(app, animation.addBlankKey(anim, image, node.?.*.id, to, name(app, "New Frame", "Neues Bild")))
        }
    }
}

fn drawRuler(app: *App, keep: *Keep, anim: *Animation, image: *image_module.Image, area: ui.Rect, visible: i32) -> void {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = kit_module.canvasOf(k)
    const s = theme.*.scale
    const cell = keep.*.cellWidth
    view.region(widgets, rulerId(), area)
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, theme.*.panel)
    canvas_module.fillRect(canvas, area.x, ui.bottom(area) - s, area.width, s, theme.*.divider)
    // Numbers every so many frames that they do not run into each other.
    const room = text_module.measure(state.smallOf(app), "0000") + px(app, 6)
    var every: i32 = 1
    var step: usize = 0
    while step < EVERY_COUNT {
        every = EVERY[step]
        if every * cell >= room { break }
        step += 1
    }
    // The time shown: lit.
    if anim.*.time >= keep.*.first && anim.*.time < keep.*.first + visible {
        const x = area.x + (anim.*.time - keep.*.first) * cell
        canvas_module.fillRect(canvas, x, area.y, cell, area.height - s, theme.*.accent)
    }
    var column: i32 = 0
    while column < visible {
        const time = keep.*.first + column
        const x = area.x + column * cell
        const tall = if time % every == 0 { 6 * s } else { 3 * s }
        canvas_module.fillRect(canvas, x, ui.bottom(area) - s - tall, s, tall, if time == anim.*.time { theme.*.onAccent } else { theme.*.dim })
        if time % every == 0 && x + room <= ui.right(area) + room / 2 {
            const bytes: [*]u8 = &keep.*.digits
            const length = std.text.appendUnsigned(bytes, 0, 12, @intCast(usize, time))
            kit_module.label(k, ui.rect(x + 2 * s, area.y, room, area.height - 6 * s), bytes[0..length], if time == anim.*.time { kit_module.TEXT_ON_ACCENT } else { kit_module.TEXT_DIM }, kit_module.ALIGN_LEFT)
        }
        column += 1
    }
    // A press and a drag along it show the time under the pointer.
    if view.isPressed(widgets, rulerId()) && widgets.*.pointerDown {
        const wanted = timeAt(keep, widgets.*.pointerX)
        if wanted != anim.*.time { showTime(app, anim, image, wanted) }
    }
    _ = view.takeClick(widgets, rulerId())
    const wheel = view.takeWheel(widgets, rulerId())
    if wheel != 0 { scrollBy(keep, anim, visible, wheel * 4) }
}

fn scrollBy(keep: *Keep, anim: *Animation, visible: i32, frames: i32) -> void {
    var first = keep.*.first + frames
    const most = reach(anim, visible) - visible + 1
    if first > most { first = most }
    if first < 0 { first = 0 }
    keep.*.first = first
}

fn drawBar(app: *App, keep: *Keep, anim: *Animation, area: ui.Rect, visible: i32) -> void {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = kit_module.canvasOf(k)
    const total = reach(anim, visible) + 1
    if area.width <= 0 || total <= 0 { return }
    view.region(widgets, barId(), area)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, area.height / 2, theme.*.track)
    var thumb = @intCast(i32, @intCast(i64, area.width) * @intCast(i64, visible) / @intCast(i64, total))
    if thumb < px(app, 20) { thumb = px(app, 20) }
    if thumb > area.width { thumb = area.width }
    const room = area.width - thumb
    const most = if total > visible { total - visible } else { 0 }
    const held = view.isPressed(widgets, barId()) && widgets.*.pointerDown
    if held && most > 0 {
        if !keep.*.barHeld {
            keep.*.barHeld = true
            keep.*.barFrom = keep.*.first
            // A press beside the thumb pages toward it.
            const left = area.x + @intCast(i32, @intCast(i64, keep.*.first) * @intCast(i64, room) / @intCast(i64, most))
            if widgets.*.pressX < left { scrollBy(keep, anim, visible, -visible) } else if widgets.*.pressX >= left + thumb { scrollBy(keep, anim, visible, visible) }
            keep.*.barFrom = keep.*.first
        } else if room > 0 {
            keep.*.first = keep.*.barFrom
            scrollBy(keep, anim, visible, @intCast(i32, @intCast(i64, view.dragX(widgets)) * @intCast(i64, most) / @intCast(i64, room)))
        }
        widgets.*.changed = true
    } else {
        keep.*.barHeld = false
    }
    const left = if most > 0 { area.x + @intCast(i32, @intCast(i64, if keep.*.first < most { keep.*.first } else { most }) * @intCast(i64, room) / @intCast(i64, most)) } else { area.x }
    const lit = held || view.isHover(widgets, barId())
    canvas_module.fillRoundedRect(canvas, left, area.y, thumb, area.height, area.height / 2, if lit { theme.*.border } else { theme.*.thumb })
    _ = view.takeClick(widgets, barId())
    const wheel = view.takeWheel(widgets, barId())
    if wheel != 0 { scrollBy(keep, anim, visible, wheel * 4) }
}

// The kit is asked for a frame in `delay` milliseconds at the latest (its
// wakeIn, which it hands the program's loop at its end).
fn wakeIn(app: *App, delay: usize) -> void {
    const k = api.kit(app)
    const wanted: u32 = if delay > 60000 { 60000 } else { @intCast(u32, delay) }
    if wanted < k.*.wakeIn { k.*.wakeIn = wanted }
}

// Animation records of images no document shows any more are let go.
fn forgetClosed(app: *App) -> void {
    var index: usize = 0
    while index < animation.recordSlots() {
        const number = animation.recordNumber(index)
        if number != 0 {
            var open = false
            var at: usize = 0
            while at < app.*.count {
                if app.*.documents[at] != null && app.*.documents[at].?.*.image.*.number == number { open = true }
                at += 1
            }
            if !open { animation.releaseNumber(number) }
        }
        index += 1
    }
}

// The onion skin over the canvas: the active layer's frames before and
// after the one shown (core/animation.mlx's onion), sampled at every
// window pixel of the image's part of the canvas they cover.
fn drawOnion(app: *App, canvas: *Canvas) -> void {
    const doc = api.document(app)
    if doc == null { return }
    const image = doc.?.*.image
    const anim = animation.find(image)
    if anim == null { return }
    const skin = animation.onion(anim.?, image)
    if skin == null { return }
    const marks = overlay.begin(app, canvas)
    if !marks.live { return }
    const extent = device_module.extent(skin.?)
    if geom.isEmpty(extent) { return }
    const kept = ui.rect(marks.left + marks.originX, marks.top + marks.originY, marks.right - marks.left, marks.bottom - marks.top)
    const box = ui.intersect(viewport.windowRectOf(&doc.?.*.view, extent), kept)
    if ui.isEmpty(box) { return }
    // The image place of a window pixel's middle, and how it moves a
    // pixel right and a pixel down.
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var x2: f64 = 0.0
    var y2: f64 = 0.0
    viewport.toImage(&doc.?.*.view, @floatFromInt(f64, box.x) + 0.5, @floatFromInt(f64, box.y) + 0.5, &x0, &y0)
    viewport.toImage(&doc.?.*.view, @floatFromInt(f64, box.x) + 1.5, @floatFromInt(f64, box.y) + 0.5, &x1, &y1)
    viewport.toImage(&doc.?.*.view, @floatFromInt(f64, box.x) + 0.5, @floatFromInt(f64, box.y) + 1.5, &x2, &y2)
    const across_x = x1 - x0
    const across_y = y1 - y0
    const down_x = x2 - x0
    const down_y = y2 - y0
    const pixels = canvas.*.pixels
    const stride = canvas.*.stride
    var row: i32 = 0
    while row < box.height {
        const line_x = x0 + down_x * @floatFromInt(f64, row)
        const line_y = y0 + down_y * @floatFromInt(f64, row)
        const at = @intCast(usize, box.y + row - marks.originY) * stride + @intCast(usize, box.x - marks.originX)
        var column: i32 = 0
        while column < box.width {
            const ix = line_x + across_x * @floatFromInt(f64, column)
            const iy = line_y + across_y * @floatFromInt(f64, column)
            // (The box lies around the skin's tiles: their places are
            // well inside an i32.)
            if ix > -2147483648.0 && ix < 2147483647.0 && iy > -2147483648.0 && iy < 2147483647.0 {
                const value = device_module.pixel(skin.?, @intFromFloat(i32, @floor(ix)), @intFromFloat(i32, @floor(iy)))
                if value >> 24 != 0 {
                    const index = at + @intCast(usize, column)
                    pixels[index] = canvas_module.over(pixels[index], canvas_module.premultiplied(value), 255)
                }
            }
            column += 1
        }
        row += 1
    }
    if marks.bounds != null { marks.bounds.?.* = geom.unite(marks.bounds.?.*, box) }
}

fn draw(app: *App, area: ui.Rect) -> void {
    const found = keepOf(app)
    if found == null { return }
    const keep = found.?
    const k = api.kit(app)
    keep.*.frame = k.*.frame
    keep.*.cellWidth = 0
    keep.*.rowCount = 0
    var index: usize = 0
    while index < BUTTONS {
        keep.*.buttons[index] = none()
        index += 1
    }
    index = 0
    while index < FIELDS {
        keep.*.fields[index] = none()
        index += 1
    }
    forgetClosed(app)
    const image = api.image(app)
    var made: ?*Animation = null
    if image != null { made = animation.make(image.?) }
    if image == null || made == null {
        if keep.*.marks {
            canvasview.setMarks(app, null)
            keep.*.marks = false
        }
        kit_module.label(k, area, if image == null { name(app, "No image is open", "Kein Bild ist offen") } else { name(app, "Out of memory", "Kein Speicher mehr") }, kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    const anim = made.?
    const picture = image.?
    const canvas = kit_module.canvasOf(k)
    // Playing: the time the clock has come to; the next frame asked for.
    // (The canvas was drawn before the dockers: it shows a changed frame
    // in the next one.)
    if canvas.*.width > 0 && !api.toolBusy(app) {
        var changed = animation.sync(anim, picture)
        if anim.*.playing {
            changed = geom.unite(changed, animation.advance(anim, picture, app.*.time))
            wakeIn(app, animation.untilNext(anim, app.*.time))
        }
        if !geom.isEmpty(changed) { api.canvasChanged(app) }
    }
    // The onion skin's marks over the canvas while it is on.
    if anim.*.onionOn != keep.*.marks {
        if anim.*.onionOn { canvasview.setMarks(app, drawOnion) } else { canvasview.setMarks(app, null) }
        keep.*.marks = anim.*.onionOn
    }
    const inner = ui.rect(area.x + px(app, PAD), area.y + px(app, PAD), area.width - px(app, PAD * 2), area.height - px(app, PAD * 2))
    if inner.width <= 0 || inner.height <= 0 { return }
    const used = controls(app, keep, anim, picture, inner)
    // The rows and their frames under the controls.
    const grid_top = inner.y + used + px(app, PAD)
    const grid = ui.rect(area.x, grid_top, area.width, ui.bottom(area) - grid_top)
    if grid.height < px(app, RULER + BAR + 4) { return }
    keep.*.rowCount = 0
    collect(keep, anim, picture, picture.*.root)
    var names = grid.width * 3 / 10
    if names < px(app, 64) { names = px(app, 64) }
    if names > px(app, 140) { names = px(app, 140) }
    const cell = px(app, ZOOMS[keep.*.zoom])
    const row_height = px(app, ROW)
    // The rows as tall as they are (one at least), the bar right under
    // them; the rest of the docker stays empty.
    var rows_height = grid.height - px(app, RULER + BAR + 4)
    const wanted = (if keep.*.rowCount > 0 { @intCast(i32, keep.*.rowCount) } else { 1 }) * row_height
    if wanted < rows_height { rows_height = wanted }
    const rows_view = ui.rect(grid.x, grid.y + px(app, RULER), grid.width, rows_height)
    const content = kit_module.scrollBegin(k, rowsId(), rows_view, @intCast(i32, keep.*.rowCount) * row_height, &keep.*.rowsOffset)
    const cells_width = content.width - names
    var visible = if cell > 0 { (cells_width + cell - 1) / cell } else { 0 }
    if visible < 1 { visible = 1 }
    // The view follows the time shown when it moved out of it.
    if keep.*.image != picture.*.number || keep.*.lastTime != anim.*.time {
        const whole = cells_width / cell
        if anim.*.time < keep.*.first || (whole > 0 && anim.*.time >= keep.*.first + whole) {
            keep.*.first = anim.*.time - whole / 3
            if keep.*.first < 0 { keep.*.first = 0 }
        }
        keep.*.image = picture.*.number
        keep.*.lastTime = anim.*.time
    }
    keep.*.cellsX = content.x + names
    keep.*.cellWidth = cell
    keep.*.rowsTop = content.y
    keep.*.rowsView = ui.rect(rows_view.x, rows_view.y, content.width, rows_view.height)
    canvas_module.fillRect(kit_module.canvasOf(k), rows_view.x, rows_view.y, rows_view.width, rows_view.height, state.themeOf(app).*.panel)
    var clicked: usize = MOST_ROWS
    var row: usize = if keep.*.rowsOffset > 0 { @intCast(usize, keep.*.rowsOffset / row_height) } else { 0 }
    while row < keep.*.rowCount {
        const place_row = ui.rect(content.x, content.y + @intCast(i32, row) * row_height, content.width, row_height)
        if place_row.y >= ui.bottom(rows_view) { break }
        drawRow(app, keep, anim, picture, row, place_row, names, visible)
        if view.takeClick(state.uiOf(app), cellsId(row)) { clicked = row }
        row += 1
    }
    if keep.*.rowCount == 0 {
        kit_module.label(k, rows_view, name(app, "Choose a paint layer to animate it", "Eine Malebene wählen, um sie zu animieren"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
    }
    kit_module.scrollEnd(k)
    // The ruler over the frames, the name column's head beside it.
    const ruler = ui.rect(content.x + names, grid.y, cells_width, px(app, RULER))
    keep.*.ruler = ruler
    const head = ui.rect(grid.x, grid.y, names, px(app, RULER))
    canvas_module.fillRect(kit_module.canvasOf(k), head.x, head.y, head.width, head.height, state.themeOf(app).*.panel)
    canvas_module.fillRect(kit_module.canvasOf(k), head.x, ui.bottom(head) - state.themeOf(app).*.scale, head.width, state.themeOf(app).*.scale, state.themeOf(app).*.divider)
    // (On the ruler's numbers' line.)
    kit_module.label(k, ui.rect(head.x + px(app, 8), head.y, head.width - px(app, 12), head.height - px(app, 6)), name(app, "Layer", "Ebene"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    drawRuler(app, keep, anim, picture, ruler, visible)
    const bar = ui.rect(content.x + names, ui.bottom(rows_view) + px(app, 2), cells_width, px(app, BAR))
    keep.*.bar = bar
    drawBar(app, keep, anim, bar, visible)
    if clicked != MOST_ROWS { clickCells(app, keep, anim, picture, clicked) }
}

fn keyPress(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const image = api.image(app)
    if image == null { return false }
    const anim = animation.make(image.?)
    if anim == null { return false }
    const shift = modifiers & keys.SHIFT != 0
    if modifiers & ~keys.SHIFT != 0 { return false }
    const time = anim.?.*.time
    const node = image.?.*.active
    var track: ?*animation.Track = null
    if node != null { track = animation.trackOf(anim.?, node.?.*.id) }
    var to: i32 = 0
    if code == keys.LEFT {
        if shift {
            if track != null && animation.previousKey(track.?, time, &to) { showTime(app, anim.?, image.?, to) }
        } else if time > 0 {
            showTime(app, anim.?, image.?, time - 1)
        }
        return true
    }
    if code == keys.RIGHT {
        if shift {
            if track != null && animation.nextKey(track.?, time, &to) { showTime(app, anim.?, image.?, to) }
        } else {
            showTime(app, anim.?, image.?, time + 1)
        }
        return true
    }
    if shift { return false }
    if code == keys.HOME {
        showTime(app, anim.?, image.?, anim.?.*.start)
        return true
    }
    if code == keys.END {
        showTime(app, anim.?, image.?, anim.?.*.end)
        return true
    }
    if keys.isEnter(code) {
        doButton(app, anim.?, image.?, BUTTON_PLAY)
        return true
    }
    if code == keys.DELETE {
        if buttonEnabled(app, anim.?, image.?, BUTTON_REMOVE) { doButton(app, anim.?, image.?, BUTTON_REMOVE) }
        return true
    }
    return false
}
