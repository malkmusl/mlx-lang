// nebula dockers: the history: what was done to the image in front, a row
// a step, the oldest at the top under a row for the image as it was at
// first ("Original state": no step done). The steps done are written
// plainly, those undone dimly, the step the image is at is marked. A
// click on a row takes the image there (undoing or redoing what lies
// between); Up and Down over the docker go a step back or forth.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("std.ui.keys")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const history_module = @import("../core/history.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")

pub const App = state.App

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 4

// A row's height (times the scale).
pub const ROW: i32 = 24

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "history", .name = "History", .german = "Verlauf", .icon = icons.DOCKER_HISTORY, .draw = draw, .keyPress = keyPress, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// What the docker keeps: how far the list is scrolled, the steps it
// showed last (when they change the step the image is at is scrolled
// into view), where the rows were this frame.
const Keep = struct {
    offset: i32
    image: usize
    count: usize
    done: usize
    // The kit's frame the rows were drawn in, where the list was, its
    // first row.
    frame: u64
    view: ui.Rect
    first: ui.Rect
}

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    return unsafe { @ptrCast(*Keep, memory.?) }
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn rowId(row: usize) -> u64 { return view.idOf(view.id("nebula.history.row"), row) }

// Where row `row` (0: the original state, n: the n-th step) was drawn
// in the last frame (empty: not in view, or the docker was not drawn).
pub fn rowArea(app: *App, row: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || ui.isEmpty(keep.?.*.view) || row > keep.?.*.count || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    const first = keep.?.*.first
    const area = ui.rect(first.x, first.y + @intCast(i32, row) * first.height, first.width, first.height)
    if area.y < keep.?.*.view.y || ui.bottom(area) > ui.bottom(keep.?.*.view) { return ui.rect(0, 0, 0, 0) }
    return area
}

// Takes the image in front to `wanted` steps done.
fn jump(app: *App, wanted: usize) -> void {
    const image = api.image(app)
    if image == null || api.toolBusy(app) { return }
    const history = image.?.*.history
    if wanted == history_module.stepsDone(history) || wanted > history_module.stepCount(history) { return }
    _ = history_module.jump(history, image.?, wanted)
    api.redraw(app)
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    const k = api.kit(app)
    keep.?.*.view = ui.rect(0, 0, 0, 0)
    keep.?.*.frame = k.*.frame
    const image = api.image(app)
    if image == null {
        kit_module.label(k, area, state.tr(app, "No image is open", "Kein Bild ist offen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    const history = image.?.*.history
    const count = history_module.stepCount(history)
    const done = history_module.stepsDone(history)
    const row = px(app, ROW)
    const padding = px(app, 4)
    const inner = ui.rect(area.x, area.y + padding, area.width, area.height - padding * 2)
    // A step taken, undone or redone elsewhere: the row the image is at
    // comes into view.
    if keep.?.*.image != @intFromPtr(image.?) || keep.?.*.count != count || keep.?.*.done != done {
        const top = @intCast(i32, done) * row
        if top < keep.?.*.offset { keep.?.*.offset = top }
        if top + row > keep.?.*.offset + inner.height { keep.?.*.offset = top + row - inner.height }
        keep.?.*.image = @intFromPtr(image.?)
        keep.?.*.count = count
        keep.?.*.done = done
    }
    const content = kit_module.scrollBegin(k, view.id("nebula.history"), inner, @intCast(i32, count + 1) * row, &keep.?.*.offset)
    keep.?.*.view = inner
    keep.?.*.first = ui.rect(content.x + padding, content.y, content.width - padding * 2, row)
    // Only the rows in view are drawn and take the pointer.
    var at: usize = if keep.?.*.offset > 0 { @intCast(usize, keep.?.*.offset / row) } else { 0 }
    var wanted: ?usize = null
    while at <= count {
        const place = ui.rect(content.x + padding, content.y + @intCast(i32, at) * row, content.width - padding * 2, row)
        if place.y >= ui.bottom(inner) { break }
        const id = rowId(at)
        if kit_module.listRow(k, id, place, at == done, false) != kit_module.ROW_NONE { wanted = at }
        const name = if at == 0 { state.tr(app, "Original state", "Ursprünglicher Zustand") } else { history_module.stepName(history, at - 1) }
        const icon = px(app, 16)
        const color = if at > done { state.themeOf(app).*.disabled } else { state.themeOf(app).*.dim }
        icons.draw(kit_module.canvasOf(k), if at == 0 { icons.IMAGE } else { icons.BULLET }, place.x + px(app, 6), place.y + (row - icon) / 2, icon, color)
        kit_module.label(k, ui.rect(place.x + px(app, 28), place.y, place.width - px(app, 34), row), name, if at > done { kit_module.TEXT_DIM } else { kit_module.TEXT_NORMAL }, kit_module.ALIGN_LEFT)
        at += 1
    }
    kit_module.scrollEnd(k)
    if wanted != null { jump(app, wanted.?) }
}

fn keyPress(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const image = api.image(app)
    if image == null || modifiers != 0 { return false }
    const done = history_module.stepsDone(image.?.*.history)
    if code == keys.UP {
        if done > 0 { jump(app, done - 1) }
        return true
    }
    if code == keys.DOWN {
        jump(app, done + 1)
        return true
    }
    return false
}
