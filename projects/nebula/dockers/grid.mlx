// nebula dockers: grid and guides: how the document in front shows its
// grid (Document.showGrid; the spacing across and down, which a link
// keeps equal; the subdivisions; the offset), its guides (shown or not,
// locked or not, one added across or down at a typed place, each removed
// by its row's cross, all removed at once) and its rulers; and whether
// what the tools place snaps to the grid and to the guides.
//
// The grid and the guides are the document's (ui/canvasview.mlx draws
// them from it); changing them is no step of the history, as moving the
// view is none. Snapping and the lock of the guides are the program's,
// kept here for every document:
//
//     var x = input.*.x
//     var y = input.*.y
//     _ = grid.snapPoint(app, input.*.x, input.*.y, &x, &y)   // a tool's point, snapped
//     if !grid.guidesLocked(app) { ...a guide may be dragged... }
//
// snapPoint moves a place on the image (its pixels' coordinates) to the
// nearest grid line (the subdivisions' lines too) or guide within
// SNAP_REACH window pixels, each axis by itself.
//
// Three sections that fold: the grid, the guides (with the rulers they
// are measured by), snapping. The content scrolls (its bar is dragged:
// no wheel is needed); in a narrow docker the captions of the numbers go
// over their boxes, and the boxes one under the other when even that is
// too narrow.
//
// Not done: the grid's colour and style (the canvas view draws it in its
// own colours), an isometric grid, guides dragged out of the rulers (that
// is the canvas view's or a tool's; they ask guidesLocked).
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const text_module = @import("std.ui.text")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")

pub const App = state.App
pub const Document = state.Document

// The docker's number (dockers/registry.mlx).
pub const ID: u8 = 9

// How near (window pixels at scale 1) a place snaps to a line.
pub const SNAP_REACH: i32 = 8

// The guides a document holds of each kind (state.Document's arrays).
pub const GUIDES: usize = 32

// The limits of what is typed: a spacing and an offset, subdivisions.
pub const MOST_SPACING: i32 = 4096
pub const MOST_DIVISIONS: i32 = 16

// Sizes at scale 1: the room around the content, a row of widgets, a
// section's head, the space between rows and between sections.
const PADDING: i32 = 6
const ROW: i32 = 24
const HEAD: i32 = 22
const GAP: i32 = 4
const SECTION_GAP: i32 = 8
// A row of the list of guides, the link button between two numbers, a
// caption over boxes, the narrowest a number's box may be beside its
// caption ("4096 px" and the steppers).
const GUIDE_ROW: i32 = 22
const LINK: i32 = 22
const CAPTION: i32 = 18
const NARROWEST_BOX: i32 = 70
// Below this width the guides' widgets stand one under the other.
const NARROW: i32 = 200

// How the number rows are laid out: the captions beside the boxes, over
// them, over boxes that each have a row.
const BESIDE: u8 = 0
const OVER: u8 = 1
const TALL: u8 = 2

const DOCKERS = [1]state.Docker{
    state.Docker.{ .id = ID, .key = "grid", .name = "Grid and Guides", .german = "Raster und Hilfslinien", .icon = icons.GRID, .draw = draw, .keyPress = null, .wanted = 0 },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The docker's row of the dockers' table (dockers/registry.mlx puts them
// together).
pub fn list() -> []const state.Docker {
    if kept.address != 0 { return table.rows(state.Docker, &kept) }
    return table.keep(state.Docker, &kept, DOCKERS[0..])
}

// What the docker keeps: the program's snapping and lock of the guides,
// the link of the spacings, what the next guide will be, which sections
// are open, how far the content is scrolled and how tall it was.
const Keep = struct {
    ready: bool
    snapGrid: bool
    snapGuides: bool
    locked: bool
    linked: bool
    // The next guide: 0 across (horizontal, at a y), 1 down (at an x).
    direction: usize
    position: i32
    gridOpen: bool
    guidesOpen: bool
    snappingOpen: bool
    offset: i32
    content: i32
    // The kit's frame the docker was drawn in, and where its parts were.
    frame: u64
    parts: [13]ui.Rect
    // The crosses of the guides' rows (across first, then down).
    crosses: [64]ui.Rect
}

// The parts of the docker a test or a person points at (partArea).
pub const PART_SHOW_GRID: usize = 0
pub const PART_SPACING_X: usize = 1
pub const PART_LINK: usize = 2
pub const PART_SPACING_Y: usize = 3
pub const PART_DIVISIONS: usize = 4
pub const PART_OFFSET_X: usize = 5
pub const PART_OFFSET_Y: usize = 6
pub const PART_DIRECTION: usize = 7
pub const PART_POSITION: usize = 8
pub const PART_ADD: usize = 9
pub const PART_SNAP_GRID: usize = 10
pub const PART_SNAP_GUIDES: usize = 11
pub const PART_CLEAR: usize = 12
const PARTS: usize = 13

fn keepOf(app: *App) -> ?*Keep {
    const memory = state.slot(app, state.SLOT_DOCKER + @intCast(usize, ID), @sizeOf(Keep))
    if memory == null { return null }
    const keep: *Keep = unsafe { @ptrCast(*Keep, memory.?) }
    if !keep.*.ready {
        keep.*.snapGrid = false
        keep.*.snapGuides = false
        keep.*.locked = false
        keep.*.linked = true
        keep.*.direction = 0
        keep.*.position = 0
        keep.*.gridOpen = true
        keep.*.guidesOpen = true
        keep.*.snappingOpen = true
        keep.*.offset = 0
        keep.*.content = 0
        keep.*.frame = 0
        keep.*.ready = true
    }
    return keep
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn idOf(name: []const u8) -> u64 { return view.id(name) }

fn guideRowId(index: usize) -> u64 { return view.idOf(view.id("nebula.grid.guide"), index) }

// ---------------------------------------------------------------------------
// For the program's other parts

// Whether places snap to the grid.
pub fn snapToGrid(app: *App) -> bool {
    const keep = keepOf(app)
    return keep != null && keep.?.*.snapGrid
}

// Whether places snap to the guides.
pub fn snapToGuides(app: *App) -> bool {
    const keep = keepOf(app)
    return keep != null && keep.?.*.snapGuides
}

// Snapping to the grid and to the guides on or off (as the docker's
// check boxes set it).
pub fn setSnapping(app: *App, grid: bool, guides: bool) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    keep.?.*.snapGrid = grid
    keep.?.*.snapGuides = guides
    api.redraw(app)
}

// Whether the guides are locked: nothing may move them by the pointer.
pub fn guidesLocked(app: *App) -> bool {
    const keep = keepOf(app)
    return keep != null && keep.?.*.locked
}

// Locks the guides (or lets them be moved again).
pub fn setGuidesLocked(app: *App, locked: bool) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    keep.?.*.locked = locked
    api.redraw(app)
}

// The nearest of the lines `spacing` apart through `offset` to `value`
// (all in image pixels, spacing above 0).
fn nearestLine(value: f64, offset: f64, spacing: f64) -> f64 {
    const start = offset - @floor(offset / spacing) * spacing
    return start + math.round((value - start) / spacing) * spacing
}

// `value` snapped along one axis: to a line of the grid (`spacing`,
// `offset` and `divisions` of that axis) when `grid`, to one of `guides`
// when `count` > 0, whichever is nearest within `reach`; a guide wins a
// tie. True when it snapped.
fn snapAxis(value: f64, grid: bool, spacing: i32, offset: i32, divisions: i32, guides: [*]const i32, count: usize, reach: f64, into: *f64) -> bool {
    var best = reach
    var found = false
    var index: usize = 0
    while index < count {
        const at = @floatFromInt(f64, guides[index])
        const distance = math.abs(at - value)
        if distance <= best {
            best = distance
            into.* = at
            found = true
        }
        index += 1
    }
    if grid && spacing > 0 {
        const parts = if divisions > 1 { divisions } else { 1 }
        const fine = @floatFromInt(f64, spacing) / @floatFromInt(f64, parts)
        const line = nearestLine(value, @floatFromInt(f64, offset), fine)
        const distance = math.abs(line - value)
        if distance < best || (!found && distance <= best) {
            into.* = line
            found = true
        }
    }
    return found
}

// The place (x, y) on the image in front (its pixels' coordinates) moved
// to the nearest grid line or guide within SNAP_REACH window pixels, as
// snapping is set here, each axis by itself, into (*snapped_x,
// *snapped_y) (the place as it is when nothing is near). True when
// either axis snapped. Tools call it for the points they place.
pub fn snapPoint(app: *App, x: f64, y: f64, snapped_x: *f64, snapped_y: *f64) -> bool {
    snapped_x.* = x
    snapped_y.* = y
    const keep = keepOf(app)
    const doc = api.document(app)
    if keep == null || doc == null { return false }
    if !keep.?.*.snapGrid && !keep.?.*.snapGuides { return false }
    const zoom = doc.?.*.view.zoom
    if !(zoom > 0.0) { return false }
    const reach = @floatFromInt(f64, px(app, SNAP_REACH)) / zoom
    const d = doc.?
    var across_count: usize = 0
    var down_count: usize = 0
    if keep.?.*.snapGuides {
        across_count = if d.*.guidesAcrossCount > GUIDES { GUIDES } else { d.*.guidesAcrossCount }
        down_count = if d.*.guidesDownCount > GUIDES { GUIDES } else { d.*.guidesDownCount }
    }
    const grid = keep.?.*.snapGrid
    const across: [*]const i32 = &d.*.guidesAcross
    const down: [*]const i32 = &d.*.guidesDown
    // Guides down the image stand at an x, those across it at a y.
    const moved_x = snapAxis(x, grid, d.*.gridX, d.*.gridOffsetX, d.*.gridDivisions, down, down_count, reach, snapped_x)
    const moved_y = snapAxis(y, grid, d.*.gridY, d.*.gridOffsetY, d.*.gridDivisions, across, across_count, reach, snapped_y)
    return moved_x || moved_y
}

// Adds a guide to the document in front: across it (horizontal) at y =
// `at` when `across`, else down it at x = `at`. False, and the status
// bar says why, when there is no document, one is there already or no
// more fit.
pub fn addGuide(app: *App, across: bool, at: i32) -> bool {
    const doc = api.document(app)
    if doc == null { return false }
    const d = doc.?
    const count = if across { d.*.guidesAcrossCount } else { d.*.guidesDownCount }
    const guides: [*]i32 = if across { &d.*.guidesAcross } else { &d.*.guidesDown }
    const held = if count > GUIDES { GUIDES } else { count }
    var index: usize = 0
    while index < held {
        if guides[index] == at {
            api.say(app, state.tr(app, "There is a guide there already", "Dort ist schon eine Hilfslinie"), false)
            return false
        }
        index += 1
    }
    if held >= GUIDES {
        api.say(app, state.tr(app, "No more guides of this kind fit (32)", "Mehr Hilfslinien dieser Art passen nicht (32)"), true)
        return false
    }
    guides[held] = at
    if across { d.*.guidesAcrossCount = held + 1 } else { d.*.guidesDownCount = held + 1 }
    // A guide added is meant to be seen.
    d.*.showGuides = true
    api.redraw(app)
    return true
}

// Removes guide `index` of the document in front (across or down).
pub fn removeGuide(app: *App, across: bool, index: usize) -> void {
    const doc = api.document(app)
    if doc == null { return }
    const d = doc.?
    const count = if across { d.*.guidesAcrossCount } else { d.*.guidesDownCount }
    const held = if count > GUIDES { GUIDES } else { count }
    if index >= held { return }
    const guides: [*]i32 = if across { &d.*.guidesAcross } else { &d.*.guidesDown }
    var at = index
    while at + 1 < held {
        guides[at] = guides[at + 1]
        at += 1
    }
    if across { d.*.guidesAcrossCount = held - 1 } else { d.*.guidesDownCount = held - 1 }
    api.redraw(app)
}

// Removes every guide of the document in front.
pub fn removeGuides(app: *App) -> void {
    const doc = api.document(app)
    if doc == null { return }
    doc.?.*.guidesAcrossCount = 0
    doc.?.*.guidesDownCount = 0
    api.redraw(app)
}

// Where part `part` (PART_*) of the docker was drawn in the last frame
// (empty: it was not, or is scrolled out of the docker's sight).
pub fn partArea(app: *App, part: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || part >= PARTS || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.parts[part]
}

// Where the cross that removes guide `index` (across or down) was drawn
// in the last frame (empty: it was not, or is out of the docker's
// sight).
pub fn crossArea(app: *App, across: bool, index: usize) -> ui.Rect {
    const keep = keepOf(app)
    if keep == null || index >= GUIDES || keep.?.*.frame != api.kit(app).*.frame { return ui.rect(0, 0, 0, 0) }
    return keep.?.*.crosses[guideRow(across, index)]
}

// ---------------------------------------------------------------------------
// The docker

fn directionName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == 0 { return state.tr(app, "Horizontal", "Waagerecht") }
    return state.tr(app, "Vertical", "Senkrecht")
}

// What a typed whole number of pixels is held in.
fn pixels(low: i32, high: i32) -> kit_module.SliderOptions {
    var options = kit_module.sliderOptions(@floatFromInt(f64, low), @floatFromInt(f64, high), 1.0, 0)
    options.suffix = " px"
    return options
}

// The widest of the captions of the number rows, and some room after it,
// held between a fifth and two fifths of `width`.
fn captionWidth(app: *App, width: i32) -> i32 {
    const font = state.smallOf(app)
    var widest = text_module.measure(font, state.tr(app, "Spacing", "Abstand"))
    const divisions = text_module.measure(font, state.tr(app, "Subdivisions", "Unterteilungen"))
    const offset = text_module.measure(font, state.tr(app, "Offset", "Versatz"))
    if divisions > widest { widest = divisions }
    if offset > widest { widest = offset }
    widest += px(app, 10)
    if widest < width / 5 { widest = width / 5 }
    if widest > width * 2 / 5 { widest = width * 2 / 5 }
    return widest
}

// A number row's caption at `y`: beside the boxes, or (`stacked`, in a
// narrow docker) over them. The y of the boxes.
fn caption(app: *App, x: i32, y: i32, width: i32, text: []const u8, stacked: bool) -> i32 {
    const k = api.kit(app)
    if stacked {
        kit_module.label(k, ui.rect(x, y, width, px(app, CAPTION)), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        return y + px(app, CAPTION)
    }
    kit_module.label(k, ui.rect(x, y, width - px(app, 6), px(app, ROW)), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    return y
}

// `area` when all of it is in the docker's `sight`, else empty (a part
// scrolled away cannot be pointed at).
fn whole(area: ui.Rect, sight: ui.Rect) -> ui.Rect {
    const seen = ui.intersect(area, sight)
    if ui.isEmpty(seen) || seen.height != area.height { return ui.rect(0, 0, 0, 0) }
    return area
}

// Notes where a part was drawn (what of it is in sight).
fn note(keep: *Keep, part: usize, area: ui.Rect, sight: ui.Rect) -> void {
    keep.*.parts[part] = whole(area, sight)
}

// The grid's section from `y` on; the y after it.
fn drawGrid(app: *App, keep: *Keep, doc: *Document, x: i32, top: i32, width: i32, sight: ui.Rect) -> i32 {
    const k = api.kit(app)
    const row = px(app, ROW)
    const gap = px(app, GAP)
    var y = top
    if !kit_module.section(k, idOf("nebula.grid.section.grid"), ui.rect(x, y, width, px(app, HEAD)), state.tr(app, "Grid", "Raster"), &keep.*.gridOpen) { return y + px(app, HEAD) }
    y += px(app, HEAD) + gap
    const show = ui.rect(x, y, width, row)
    if kit_module.checkBox(k, idOf("nebula.grid.show"), show, state.tr(app, "Show grid", "Raster zeigen"), &doc.*.showGrid) { api.redraw(app) }
    note(keep, PART_SHOW_GRID, show, sight)
    y += row + gap
    // The numbers: a caption, then one box (or two, across and down).
    // The caption goes over the boxes when beside them they would be too
    // narrow for their numbers, and each box gets a row of its own when
    // even that is too narrow.
    const captions = captionWidth(app, width)
    const link = px(app, LINK)
    const space = px(app, 4)
    var layout = BESIDE
    var boxes_x = x + captions
    var box = (width - captions - link - space * 2) / 2
    if box < px(app, NARROWEST_BOX) {
        layout = OVER
        boxes_x = x
        box = (width - link - space * 2) / 2
    }
    if box < px(app, NARROWEST_BOX) {
        layout = TALL
        box = width - link - space
    }
    const over = layout != BESIDE
    const caption_width = if over { width } else { captions }
    const second_x = if layout == TALL { x } else { boxes_x + box + space + link + space }
    const spacing = pixels(1, MOST_SPACING)
    y = caption(app, x, y, caption_width, state.tr(app, "Spacing", "Abstand"), over)
    const spacing_x = ui.rect(boxes_x, y, box, row)
    // (Between the two boxes it links: beside both when they stand one
    // under the other.)
    const link_y = if layout == TALL { y + (row * 2 + gap - link) / 2 } else { y + (row - link) / 2 }
    const link_area = ui.rect(boxes_x + box + space, link_y, link, link)
    if layout == TALL { y += row + gap }
    const spacing_y = ui.rect(second_x, y, box, row)
    if kit_module.intBox(k, idOf("nebula.grid.spacing.x"), spacing_x, &doc.*.gridX, &spacing) {
        if keep.*.linked { doc.*.gridY = doc.*.gridX }
        api.redraw(app)
    }
    kit_module.tooltip(k, idOf("nebula.grid.spacing.x"), spacing_x, state.tr(app, "The grid's spacing across (x)", "Der Abstand des Rasters waagerecht (x)"))
    const link_tip = if keep.*.linked { state.tr(app, "Across and down stay equal: click to set them apart", "Waagerecht und senkrecht bleiben gleich: klicken, um sie getrennt zu setzen") } else { state.tr(app, "Keep across and down equal", "Waagerecht und senkrecht gleich halten") }
    if kit_module.toolButton(k, idOf("nebula.grid.link"), link_area, icons.drawFor, @intCast(usize, if keep.*.linked { icons.LINK } else { icons.UNLINK }), keep.*.linked, link_tip) {
        keep.*.linked = !keep.*.linked
        if keep.*.linked { doc.*.gridY = doc.*.gridX }
        api.redraw(app)
    }
    if kit_module.intBox(k, idOf("nebula.grid.spacing.y"), spacing_y, &doc.*.gridY, &spacing) {
        if keep.*.linked { doc.*.gridX = doc.*.gridY }
        api.redraw(app)
    }
    kit_module.tooltip(k, idOf("nebula.grid.spacing.y"), spacing_y, state.tr(app, "The grid's spacing down (y)", "Der Abstand des Rasters senkrecht (y)"))
    note(keep, PART_SPACING_X, spacing_x, sight)
    note(keep, PART_LINK, link_area, sight)
    note(keep, PART_SPACING_Y, spacing_y, sight)
    y += row + gap
    y = caption(app, x, y, caption_width, state.tr(app, "Subdivisions", "Unterteilungen"), over)
    const divisions = ui.rect(boxes_x, y, box, row)
    const parts = kit_module.sliderOptions(1.0, @floatFromInt(f64, MOST_DIVISIONS), 1.0, 0)
    if kit_module.intBox(k, idOf("nebula.grid.divisions"), divisions, &doc.*.gridDivisions, &parts) { api.redraw(app) }
    kit_module.tooltip(k, idOf("nebula.grid.divisions"), divisions, state.tr(app, "Fainter lines cut each cell into so many parts", "Feinere Linien teilen jede Zelle in so viele Teile"))
    note(keep, PART_DIVISIONS, divisions, sight)
    y += row + gap
    y = caption(app, x, y, caption_width, state.tr(app, "Offset", "Versatz"), over)
    const offsets = pixels(0, MOST_SPACING)
    const offset_x = ui.rect(boxes_x, y, box, row)
    if layout == TALL { y += row + gap }
    const offset_y = ui.rect(second_x, y, box, row)
    if kit_module.intBox(k, idOf("nebula.grid.offset.x"), offset_x, &doc.*.gridOffsetX, &offsets) { api.redraw(app) }
    kit_module.tooltip(k, idOf("nebula.grid.offset.x"), offset_x, state.tr(app, "Where the lines start across (x)", "Wo die Linien waagerecht beginnen (x)"))
    if kit_module.intBox(k, idOf("nebula.grid.offset.y"), offset_y, &doc.*.gridOffsetY, &offsets) { api.redraw(app) }
    kit_module.tooltip(k, idOf("nebula.grid.offset.y"), offset_y, state.tr(app, "Where the lines start down (y)", "Wo die Linien senkrecht beginnen (y)"))
    note(keep, PART_OFFSET_X, offset_x, sight)
    note(keep, PART_OFFSET_Y, offset_y, sight)
    return y + row
}

// The number of the guide list's row for guide `index` of a kind.
fn guideRow(across: bool, index: usize) -> usize { return if across { index } else { GUIDES + index } }

// The guides' section from `top` on; the y after it.
fn drawGuides(app: *App, keep: *Keep, doc: *Document, x: i32, top: i32, width: i32) -> i32 {
    const k = api.kit(app)
    const row = px(app, ROW)
    const gap = px(app, GAP)
    var y = top
    if !kit_module.section(k, idOf("nebula.grid.section.guides"), ui.rect(x, y, width, px(app, HEAD)), state.tr(app, "Guides", "Hilfslinien"), &keep.*.guidesOpen) { return y + px(app, HEAD) }
    y += px(app, HEAD) + gap
    // Side by side, or (a narrow docker) one under the other.
    const narrow = width < px(app, NARROW)
    const space = px(app, 4)
    const half = if narrow { width } else { (width - space) / 2 }
    if kit_module.checkBox(k, idOf("nebula.grid.guides.show"), ui.rect(x, y, half, row), state.tr(app, "Show guides", "Zeigen"), &doc.*.showGuides) { api.redraw(app) }
    if narrow { y += row }
    const lock_x = if narrow { x } else { x + half + space }
    if kit_module.checkBox(k, idOf("nebula.grid.guides.lock"), ui.rect(lock_x, y, x + width - lock_x, row), state.tr(app, "Lock guides", "Sperren"), &keep.*.locked) { api.redraw(app) }
    y += row
    // (The rulers, which the guides are measured by.)
    if kit_module.checkBox(k, idOf("nebula.grid.rulers"), ui.rect(x, y, width, row), state.tr(app, "Show rulers", "Lineale zeigen"), &doc.*.showRulers) { api.redraw(app) }
    y += row + gap
    // A new guide: which way, where, and the button that adds it; the
    // choice of the way in a row of its own when beside it either it
    // could not show its longer name whole (the kit's list wants 38
    // pixels beside the name) or the place's box would be too narrow for
    // its number.
    const font = state.smallOf(app)
    const add_text = state.tr(app, "Add", "Hinzufügen")
    const button = text_module.measure(font, add_text) + px(app, 24)
    var named = text_module.measure(font, directionName(@intFromPtr(app), 0))
    const other_name = text_module.measure(font, directionName(@intFromPtr(app), 1))
    if other_name > named { named = other_name }
    var stacked = narrow
    var choice = (width - button - space * 2) * 11 / 20
    if choice < named + px(app, 38) { choice = named + px(app, 38) }
    if width - button - space * 2 - choice < px(app, NARROWEST_BOX) { stacked = true }
    if stacked { choice = width }
    const direction = ui.rect(x, y, choice, row)
    if stacked { y += row + gap }
    const position_x = if stacked { x } else { ui.right(direction) + space }
    const position = ui.rect(position_x, y, x + width - button - space - position_x, row)
    const add = ui.rect(ui.right(position) + space, y, button, row)
    if kit_module.comboBoxWith(k, idOf("nebula.grid.direction"), direction, 2, directionName, @intFromPtr(app), &keep.*.direction) { api.redraw(app) }
    const across = keep.*.direction == 0
    const reach = if across { doc.*.image.*.height } else { doc.*.image.*.width }
    if keep.*.position > reach { keep.*.position = reach }
    if keep.*.position < 0 { keep.*.position = 0 }
    const where = pixels(0, reach)
    _ = kit_module.intBox(k, idOf("nebula.grid.position"), position, &keep.*.position, &where)
    kit_module.tooltip(k, idOf("nebula.grid.position"), position, if across { state.tr(app, "The new guide's y on the image", "Das y der neuen Hilfslinie im Bild") } else { state.tr(app, "The new guide's x on the image", "Das x der neuen Hilfslinie im Bild") })
    if kit_module.button(k, idOf("nebula.grid.add"), add, add_text, kit_module.BUTTON_NORMAL) { _ = addGuide(app, across, keep.*.position) }
    keep.*.parts[PART_DIRECTION] = direction
    keep.*.parts[PART_POSITION] = position
    keep.*.parts[PART_ADD] = add
    y += row + gap
    // The guides there are, each with the cross that removes it.
    const line = px(app, GUIDE_ROW)
    var removed = false
    var removed_across = false
    var removed_index: usize = 0
    var kind: usize = 0
    while kind < 2 {
        const of_across = kind == 0
        const count = if of_across { doc.*.guidesAcrossCount } else { doc.*.guidesDownCount }
        const held = if count > GUIDES { GUIDES } else { count }
        const guides: [*]const i32 = if of_across { &doc.*.guidesAcross } else { &doc.*.guidesDown }
        var index: usize = 0
        while index < held {
            const area = ui.rect(x, y, width, line)
            const lit = view.isHover(state.uiOf(app), view.idOf(guideRowId(guideRow(of_across, index)), 1))
            _ = kit_module.listRow(k, guideRowId(guideRow(of_across, index)), area, false, lit)
            const size = px(app, 14)
            icons.draw(kit_module.canvasOf(k), if of_across { icons.ALIGN_MIDDLE } else { icons.ALIGN_CENTER }, x + px(app, 6), y + (line - size) / 2, size, state.themeOf(app).*.dim)
            // "Horizontal at 120 px", or where that is too wide "y = 120 px"
            // (the icon says which way it goes).
            const room = ui.rect(x + px(app, 26), y, width - px(app, 54), line)
            var text: [64]u8 = undefined
            const bytes: [*]u8 = &text
            var length = std.text.append(bytes, 0, 64, if of_across { state.tr(app, "Horizontal at ", "Waagerecht bei ") } else { state.tr(app, "Vertical at ", "Senkrecht bei ") })
            length = std.text.appendSigned(bytes, length, 64, @intCast(isize, guides[index]))
            length = std.text.append(bytes, length, 64, " px")
            if text_module.measure(state.smallOf(app), bytes[0..length]) > room.width {
                length = std.text.append(bytes, 0, 64, if of_across { "y = " } else { "x = " })
                length = std.text.appendSigned(bytes, length, 64, @intCast(isize, guides[index]))
                length = std.text.append(bytes, length, 64, " px")
            }
            kit_module.label(k, room, bytes[0..length], kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
            const cross = ui.rect(ui.right(area) - line, y, line, line)
            keep.*.crosses[guideRow(of_across, index)] = cross
            if kit_module.iconButton(k, view.idOf(guideRowId(guideRow(of_across, index)), 1), cross, icons.drawFor, @intCast(usize, icons.CLOSE), state.tr(app, "Remove this guide", "Diese Hilfslinie entfernen")) {
                removed = true
                removed_across = of_across
                removed_index = index
            }
            y += line
            index += 1
        }
        kind += 1
    }
    if doc.*.guidesAcrossCount + doc.*.guidesDownCount > 0 { y += gap }
    const none = doc.*.guidesAcrossCount == 0 && doc.*.guidesDownCount == 0
    const clear = ui.rect(x, y, width, row)
    if kit_module.button(k, idOf("nebula.grid.guides.clear"), clear, state.tr(app, "Remove all guides", "Alle Hilfslinien entfernen"), kit_module.BUTTON_NORMAL | (if none { kit_module.BUTTON_DISABLED } else { 0 })) { removeGuides(app) }
    keep.*.parts[PART_CLEAR] = clear
    // (Removed after the list was drawn: its rows stay where they were
    // for this frame.)
    if removed { removeGuide(app, removed_across, removed_index) }
    return y + row
}

// The snapping's section from `top` on; the y after it.
fn drawSnapping(app: *App, keep: *Keep, x: i32, top: i32, width: i32, sight: ui.Rect) -> i32 {
    const k = api.kit(app)
    const row = px(app, ROW)
    const gap = px(app, GAP)
    var y = top
    if !kit_module.section(k, idOf("nebula.grid.section.snapping"), ui.rect(x, y, width, px(app, HEAD)), state.tr(app, "Snapping", "Einrasten"), &keep.*.snappingOpen) { return y + px(app, HEAD) }
    y += px(app, HEAD) + gap
    const snap_grid = ui.rect(x, y, width, row)
    if kit_module.checkBox(k, idOf("nebula.grid.snap.grid"), snap_grid, state.tr(app, "To the grid", "Am Raster"), &keep.*.snapGrid) { api.redraw(app) }
    kit_module.tooltip(k, idOf("nebula.grid.snap.grid"), snap_grid, state.tr(app, "What the tools place goes to the nearest grid line", "Was die Werkzeuge setzen, geht an die nächste Rasterlinie"))
    note(keep, PART_SNAP_GRID, snap_grid, sight)
    y += row
    const snap_guides = ui.rect(x, y, width, row)
    if kit_module.checkBox(k, idOf("nebula.grid.snap.guides"), snap_guides, state.tr(app, "To the guides", "An Hilfslinien"), &keep.*.snapGuides) { api.redraw(app) }
    kit_module.tooltip(k, idOf("nebula.grid.snap.guides"), snap_guides, state.tr(app, "What the tools place goes to the nearest guide", "Was die Werkzeuge setzen, geht an die nächste Hilfslinie"))
    note(keep, PART_SNAP_GUIDES, snap_guides, sight)
    return y + row
}

fn draw(app: *App, area: ui.Rect) -> void {
    const keep = keepOf(app)
    if keep == null { return }
    const k = api.kit(app)
    keep.?.*.frame = k.*.frame
    var part: usize = 0
    while part < PARTS {
        keep.?.*.parts[part] = ui.rect(0, 0, 0, 0)
        part += 1
    }
    part = 0
    while part < GUIDES * 2 {
        keep.?.*.crosses[part] = ui.rect(0, 0, 0, 0)
        part += 1
    }
    const doc = api.document(app)
    if doc == null {
        kit_module.label(k, area, state.tr(app, "No image is open", "Kein Bild ist offen"), kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
        return
    }
    const padding = px(app, PADDING)
    const content = kit_module.scrollBegin(k, idOf("nebula.grid"), area, keep.?.*.content, &keep.?.*.offset)
    const x = content.x + padding
    const width = content.width - padding * 2
    var y = content.y + padding
    y = drawGrid(app, keep.?, doc.?, x, y, width, area)
    y += px(app, SECTION_GAP)
    y = drawGuides(app, keep.?, doc.?, x, y, width)
    y += px(app, SECTION_GAP)
    y = drawSnapping(app, keep.?, x, y, width, area)
    note(keep.?, PART_DIRECTION, keep.?.*.parts[PART_DIRECTION], area)
    note(keep.?, PART_POSITION, keep.?.*.parts[PART_POSITION], area)
    note(keep.?, PART_ADD, keep.?.*.parts[PART_ADD], area)
    note(keep.?, PART_CLEAR, keep.?.*.parts[PART_CLEAR], area)
    part = 0
    while part < GUIDES * 2 {
        keep.?.*.crosses[part] = whole(keep.?.*.crosses[part], area)
        part += 1
    }
    kit_module.scrollEnd(k)
    // How tall the content was: the scroll bar of the next frame knows.
    const height = y + padding - content.y
    if height != keep.?.*.content {
        keep.?.*.content = height
        api.redraw(app)
    }
}
