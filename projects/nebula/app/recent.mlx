// nebula app: the files used last, newest first (File > Open Recent):
//
//     _ = recent.add(app, path)               // opened or saved: to the front
//     var index: usize = 0
//     while index < recent.count(app) {
//         if recent.exists(app, index) { ... recent.at(app, index) ... }
//         index += 1
//     }
//
// Kept in $XDG_STATE_HOME/mlx/nebula/recent (else
// ~/.local/state/mlx/nebula/recent, through std.xdg on both systems), a
// path a line, newest first; read at the first asking and written whole
// (into "recent.new" first, which then takes its place) at every change.
// A path that comes again moves to the front; what is beyond the setting
// recentFiles (app/settings.mlx, MOST at the very most) is dropped. A file
// that is gone stays in the list (it may be on a disk that comes back),
// but a menu offers only what exists() finds.
const std = @import("std")
const xdg = @import("std.xdg")
const state = @import("./state.mlx")
const settings = @import("./settings.mlx")
const text_io = @import("../io/text.mlx")

pub const App = state.App

// The most paths kept, whatever the setting says.
pub const MOST: usize = 100

// Where the list is under the user's state directory.
const FILE: []const u8 = "/mlx/nebula/recent"

const List = struct {
    loaded: bool
    // The paths, newest first, each with a line feed after it, in one heap
    // block (`capacity` bytes, 0: none yet).
    text: [*]u8
    length: usize
    capacity: usize
    // Where each path is in `text`.
    starts: [100]usize
    lengths: [100]usize
    // What rebuild() takes from its source, before the new block is made.
    picks: [100]usize
    pickLengths: [100]usize
    count: usize
    // The list's file, and a path with a NUL after it for std.fs.
    file: [4096]u8
    name: [4096]u8
}

fn limitOf(app: *App) -> usize {
    const wanted = @intCast(usize, settings.get(app).*.recentFiles)
    return if wanted < MOST { wanted } else { MOST }
}

// A path the list can keep: one line of 1 to PATH_MAX - 1 bytes.
fn isKeepable(path: []const u8) -> bool {
    if path.length == 0 || path.length >= std.fs.PATH_MAX { return false }
    for byte in path {
        if byte == 10 || byte == 13 || byte == 0 { return false }
    }
    return true
}

fn pathAt(list: *List, index: usize) -> []const u8 {
    return list.*.text[list.*.starts[index]..list.*.starts[index] + list.*.lengths[index]]
}

// The list made anew: `first` (when not empty), then the lines of
// `source` that are not `skip`, not `first`, not empty and not there
// already, `limit` paths at most, in a block of just their size (so that
// the heap holds the same for the same list, however it came about).
// `source` may be the list's own text: its block is given back after it
// was read. False without memory (the list is as it was then).
fn rebuild(app: *App, list: *List, first: []const u8, skip: []const u8, source: []const u8, limit: usize) -> bool {
    // First what is kept, as places in `source`.
    const leading = first.length > 0 && limit > 0
    var count: usize = if leading { 1 } else { 0 }
    var total: usize = if leading { first.length + 1 } else { 0 }
    var at: usize = 0
    while at < source.length && count < limit {
        var end = at
        while end < source.length && source[end] != 10 { end += 1 }
        var line = source[at..end]
        // (A file written on another system may end its lines with CR.)
        if line.length > 0 && line[line.length - 1] == 13 { line = source[at..end - 1] }
        const start = at
        at = end + 1
        if !isKeepable(line) || std.text.same(line, skip) || std.text.same(line, first) { continue }
        var seen = false
        var index: usize = if leading { 1 } else { 0 }
        while index < count && !seen {
            seen = std.text.same(source[list.*.picks[index]..list.*.picks[index] + list.*.pickLengths[index]], line)
            index += 1
        }
        if seen { continue }
        list.*.picks[count] = start
        list.*.pickLengths[count] = line.length
        total += line.length + 1
        count += 1
    }
    var into = list.*.text
    if total > 0 {
        const memory = app.*.allocator.alloc(total, 16)
        if memory == null { return false }
        into = memory.?
    }
    var length: usize = 0
    var index: usize = 0
    while index < count {
        const path = if leading && index == 0 { first } else { source[list.*.picks[index]..list.*.picks[index] + list.*.pickLengths[index]] }
        list.*.starts[index] = length
        list.*.lengths[index] = path.length
        length = std.text.append(into, length, total, path)
        length = std.text.appendByte(into, length, total, 10)
        index += 1
    }
    if list.*.capacity != 0 { app.*.allocator.free(list.*.text, list.*.capacity, 16) }
    list.*.text = into
    list.*.capacity = total
    list.*.length = length
    list.*.count = count
    return true
}

// The list's file into list.file; its length, 0 when the environment
// names no place for it.
fn fileOf(app: *App, list: *List) -> usize {
    return xdg.path(app.*.shell.*.environment, xdg.STATE, FILE, &list.*.file, std.fs.PATH_MAX)
}

fn read(app: *App, list: *List) -> bool {
    list.*.loaded = true
    list.*.count = 0
    list.*.length = 0
    const length = fileOf(app, list)
    if length == 0 { return false }
    const path: [*]const u8 = &list.*.file
    var contents: text_io.Contents = undefined
    if text_io.readFile(app.*.allocator, path[0..length], &contents) != text_io.FileStatus.ok { return false }
    const made = rebuild(app, list, "", "", contents.bytes[0..contents.length], limitOf(app))
    text_io.freeFile(&contents)
    return made
}

fn listOf(app: *App) -> ?*List {
    const memory = state.slot(app, state.SLOT_RECENT, @sizeOf(List))
    if memory == null { return null }
    const list: *List = unsafe { @ptrCast(*List, memory.?) }
    if !list.*.loaded { _ = read(app, list) }
    return list
}

// The list as its file, made with the folders it goes in; false when it
// could not be written.
fn write(app: *App, list: *List) -> bool {
    const length = fileOf(app, list)
    if length == 0 { return false }
    const path: [*]u8 = &list.*.file
    if !std.fs.makeParents(path[0..length], 493) { return false }
    // (384 = 0600: which files someone opened is theirs alone to see.)
    if list.*.length == 0 { return std.fs.replaceFile(path, "".pointer, 0, 384) }
    return std.fs.replaceFile(path, list.*.text, list.*.length, 384)
}

// Reads the list again from its file (another run of the program may have
// written it). False when there is none.
pub fn load(app: *App) -> bool {
    const memory = state.slot(app, state.SLOT_RECENT, @sizeOf(List))
    if memory == null { return false }
    const list: *List = unsafe { @ptrCast(*List, memory.?) }
    return read(app, list)
}

// `path` was opened or saved: it goes to the front (from where it was, if
// it was there) and what is beyond the limit is dropped; the file is
// written. False for a path that cannot be kept (empty, more than one
// line, too long), without memory, or when the file could not be written.
pub fn add(app: *App, path: []const u8) -> bool {
    if !isKeepable(path) { return false }
    const list = listOf(app)
    if list == null { return false }
    const own = list.?.*.text[0..list.?.*.length]
    if !rebuild(app, list.?, path, path, own, limitOf(app)) { return false }
    return write(app, list.?)
}

// `path` leaves the list; false when it was not in it, or when the file
// could not be written.
pub fn remove(app: *App, path: []const u8) -> bool {
    const list = listOf(app)
    if list == null { return false }
    var index: usize = 0
    while index < list.?.*.count && !std.text.same(pathAt(list.?, index), path) { index += 1 }
    if index >= list.?.*.count { return false }
    const own = list.?.*.text[0..list.?.*.length]
    if !rebuild(app, list.?, "", path, own, MOST) { return false }
    return write(app, list.?)
}

// Nothing is listed any more; false when the file could not be written.
pub fn clear(app: *App) -> bool {
    const list = listOf(app)
    if list == null { return false }
    list.?.*.count = 0
    list.?.*.length = 0
    return write(app, list.?)
}

// How many paths are listed (the setting recentFiles at most).
pub fn count(app: *App) -> usize {
    const list = listOf(app)
    if list == null { return 0 }
    const limit = limitOf(app)
    return if list.?.*.count < limit { list.?.*.count } else { limit }
}

// The path at `index` (0: the newest); "" past the last. Good until the
// list changes.
pub fn at(app: *App, index: usize) -> []const u8 {
    const list = listOf(app)
    if list == null || index >= count(app) { return "" }
    return pathAt(list.?, index)
}

// Whether the file at `index` is there now (what a menu offers).
pub fn exists(app: *App, index: usize) -> bool {
    const list = listOf(app)
    if list == null || index >= count(app) { return false }
    const bytes: [*]u8 = &list.?.*.name
    const path = pathAt(list.?, index)
    std.mem.copy(bytes, path.pointer, path.length)
    bytes[path.length] = 0
    return std.fs.exists(bytes)
}
