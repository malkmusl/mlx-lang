// nebula app: the open documents: an image each and how it is looked at
// (state.Document), in app.documents; one of them is in front
// (app.current). Opening and saving files is io's and the file actions';
// here documents are made, put in front, asked whether they changed, and
// closed.
const std = @import("std")
const state = @import("./state.mlx")
const settings = @import("./settings.mlx")
const api = @import("./api.mlx")
const viewport = @import("../ui/viewport.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const device_module = @import("../core/device.mlx")
const history_module = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")

pub const App = state.App
pub const Document = state.Document
pub const Image = image_module.Image

pub fn nameOf(doc: *Document) -> []const u8 {
    const bytes: [*]const u8 = &doc.*.name
    return bytes[0..doc.*.nameLength]
}

pub fn setName(doc: *Document, text: []const u8) -> void {
    var length: usize = 0
    while length < text.length && length < state.NAME {
        doc.*.name[length] = text[length]
        length += 1
    }
    doc.*.nameLength = length
}

// Whether the image changed since it was opened or saved last.
pub fn isModified(doc: *Document) -> bool {
    return @intCast(u64, history_module.position(doc.*.image.*.history)) != doc.*.savedSerial
}

// The image is as its file is.
pub fn markSaved(doc: *Document) -> void {
    doc.*.savedSerial = @intCast(u64, history_module.position(doc.*.image.*.history))
    doc.*.image.*.modified = false
}

// Takes `image` as a new document called `name`, in front. The image is
// the document's from then on. Null when no more can be open or without
// memory (the image is still the caller's then).
pub fn add(app: *App, image: *Image, name: []const u8) -> ?*Document {
    if app.*.count >= state.DOCUMENTS {
        api.say(app, state.tr(app, "Too many documents are open", "Es sind zu viele Dokumente offen"), true)
        return null
    }
    const memory = app.*.allocator.alloc(@sizeOf(Document), 16)
    if memory == null { return null }
    std.mem.zero(memory.?, @sizeOf(Document))
    const doc: *Document = unsafe { @ptrCast(*Document, memory.?) }
    doc.*.image = image
    viewport.init(&doc.*.view, image.*.width, image.*.height)
    setName(doc, name)
    doc.*.format = 0
    doc.*.showGrid = false
    doc.*.showRulers = false
    doc.*.showGuides = true
    doc.*.showSelection = true
    doc.*.viewData = 0
    doc.*.gridX = 64
    doc.*.gridY = 64
    doc.*.gridDivisions = 2
    markSaved(doc)
    // The view fits the image once the canvas area is known.
    doc.*.view.zoom = 0.0
    app.*.documents[app.*.count] = doc
    app.*.current = app.*.count
    app.*.count += 1
    api.redraw(app)
    return doc
}

// A new image of `width` x `height`: a background layer filled with
// `background` (transparent: left empty) and an empty layer on it, in
// front as "Untitled-N". Null when it could not be made.
pub fn create(app: *App, width: i32, height: i32, resolution: f64, background: u32) -> ?*Document {
    const made = image_module.create(app.*.allocator, width, height, resolution)
    if made == null {
        api.say(app, state.tr(app, "The image could not be made (its size, or memory)", "Das Bild konnte nicht angelegt werden (Größe oder Speicher)"), true)
        return null
    }
    const image = made.?
    const ground = ops.newLayer(image, node_module.PAINT, state.tr(app, "Background", "Hintergrund"), "New layer")
    if ground != null && background >> 24 != 0 {
        _ = device_module.fill(ground.?.*.device.?, image_module.bounds(image), background)
    }
    _ = ops.newLayer(image, node_module.PAINT, state.tr(app, "Layer 1", "Ebene 1"), "New layer")
    // A new image starts with nothing to undo, and keeps as many steps
    // as the settings say.
    history_module.clear(image.*.history)
    image.*.history.*.limit = @intCast(usize, settings.get(app).*.undoSteps)
    image_module.damageAll(image)
    image.*.modified = false
    app.*.untitled += 1
    var name: [64]u8 = undefined
    const bytes: [*]u8 = &name
    var length = std.text.append(bytes, 0, 64, state.tr(app, "Untitled-", "Unbenannt-"))
    length = std.text.appendUnsigned(bytes, length, 64, @intCast(usize, app.*.untitled))
    const doc = add(app, image, bytes[0..length])
    if doc == null {
        image_module.destroy(image)
        return null
    }
    return doc
}

// Puts document `index` in front.
pub fn show(app: *App, index: usize) -> void {
    if index >= app.*.count || index == app.*.current { return }
    app.*.current = index
    api.redraw(app)
}

// Closes document `index` whatever its state (asking first is the file
// actions' part). What the canvas view kept for it must be let go by the
// caller before (ui/canvasview.mlx's forget).
pub fn close(app: *App, index: usize) -> void {
    if index >= app.*.count { return }
    const doc = app.*.documents[index].?
    image_module.destroy(doc.*.image)
    unsafe { app.*.allocator.free(@ptrCast([*]u8, doc), @sizeOf(Document), 16) }
    var at = index
    while at + 1 < app.*.count {
        app.*.documents[at] = app.*.documents[at + 1]
        at += 1
    }
    app.*.count -= 1
    app.*.documents[app.*.count] = null
    if app.*.current > index || (app.*.current == index && app.*.current >= app.*.count && app.*.current > 0) {
        app.*.current -= 1
    }
    api.redraw(app)
}
