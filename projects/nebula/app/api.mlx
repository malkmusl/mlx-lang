// nebula app: what the program's parts (tools, dockers, actions, dialogs)
// call on the App: the document in front and its image, the active layer
// and whether it can be painted on, the two colours, the tool in use,
// frames, the status bar's note, dialogs, actions by their key, undo.
//
// Changing an image goes through core/ops.mlx (and so into its history);
// afterwards the part says imageChanged(app, area) or, when it damaged
// the image itself, canvasChanged(app): the canvas view then draws the
// image's stale part again and nothing else of the window.
const std = @import("std")
const ui = @import("std.ui")
const state = @import("./state.mlx")
const shell_module = @import("./shell.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const history_module = @import("../core/history.mlx")
const geom = @import("../core/geom.mlx")
const tools = @import("../tools/registry.mlx")
const actions = @import("../actions/registry.mlx")

pub const App = state.App
pub const Document = state.Document
pub const Image = image_module.Image
pub const Node = node_module.Node
pub const Rect = geom.Rect

// ---------------------------------------------------------------------------
// The document in front

pub fn document(app: *App) -> ?*Document {
    if app.*.current >= app.*.count { return null }
    return app.*.documents[app.*.current]
}

pub fn image(app: *App) -> ?*Image {
    const doc = document(app)
    if doc == null { return null }
    return doc.?.*.image
}

// The node tools work on (null: no document, or it has no layer).
pub fn activeNode(app: *App) -> ?*Node {
    const picture = image(app)
    if picture == null { return null }
    return picture.?.*.active
}

// The active node when it can be painted on: it has pixels, is shown and
// not locked. Otherwise null, and the status bar says why.
pub fn paintable(app: *App) -> ?*Node {
    const node = activeNode(app)
    if node == null {
        say(app, state.tr(app, "There is no layer to paint on", "Es gibt keine Ebene zum Malen"), true)
        return null
    }
    const kind = node.?.*.kind
    if node.?.*.device == null || kind == node_module.GROUP || kind == node_module.CLONE || kind == node_module.FILL || kind == node_module.FILE {
        say(app, state.tr(app, "This kind of layer cannot be painted on", "Auf dieser Art von Ebene kann nicht gemalt werden"), true)
        return null
    }
    if node.?.*.locked {
        say(app, state.tr(app, "The layer is locked", "Die Ebene ist gesperrt"), true)
        return null
    }
    if !node_module.isShown(node.?) {
        say(app, state.tr(app, "The layer is hidden", "Die Ebene ist ausgeblendet"), true)
        return null
    }
    return node
}

// ---------------------------------------------------------------------------
// Frames

// The whole window is to be drawn again.
pub fn redraw(app: *App) -> void {
    app.*.fullRedraw = true
    shell_module.redraw(app.*.shell)
}

// Only the canvas changed: the image where it is stale (its `dirty`) or
// what is drawn over it (a tool's marks, the brush's outline).
pub fn canvasChanged(app: *App) -> void {
    shell_module.redraw(app.*.shell)
}

// The image in front looks different in `area`.
pub fn imageChanged(app: *App, area: Rect) -> void {
    const picture = image(app)
    if picture == null { return }
    image_module.damage(picture.?, area)
    shell_module.redraw(app.*.shell)
}

// The layers, their order or their properties changed (the layer list
// and whatever else shows them is drawn again).
pub fn layersChanged(app: *App) -> void {
    redraw(app)
}

// The active tool wants its tick (or no more).
pub fn wantTicks(app: *App, on: bool) -> void {
    app.*.ticking = on
    shell_module.setTick(app.*.shell, if on { 16 } else { 0 })
}

// ---------------------------------------------------------------------------
// The status bar's note

pub fn say(app: *App, text: []const u8, danger: bool) -> void {
    const bytes: [*]u8 = &app.*.note
    app.*.noteLength = std.text.append(bytes, 0, 200, text)
    app.*.noteDanger = danger
    app.*.noteUntil = shell_module.now(app.*.shell) + 5000
    redraw(app)
}

pub fn sayWith(app: *App, first: []const u8, second: []const u8, danger: bool) -> void {
    const bytes: [*]u8 = &app.*.note
    app.*.noteLength = std.text.append(bytes, std.text.append(bytes, 0, 200, first), 200, second)
    app.*.noteDanger = danger
    app.*.noteUntil = shell_module.now(app.*.shell) + 5000
    redraw(app)
}

pub fn noteOf(app: *App) -> []const u8 {
    if app.*.noteLength == 0 || shell_module.now(app.*.shell) > app.*.noteUntil { return "" }
    const bytes: [*]const u8 = &app.*.note
    return bytes[0..app.*.noteLength]
}

// ---------------------------------------------------------------------------
// Colours

pub fn setForeground(app: *App, color: u32) -> void {
    if app.*.foreground == color { return }
    app.*.foreground = color
    redraw(app)
}

pub fn setBackground(app: *App, color: u32) -> void {
    if app.*.background == color { return }
    app.*.background = color
    redraw(app)
}

pub fn swapColors(app: *App) -> void {
    const kept = app.*.foreground
    app.*.foreground = app.*.background
    app.*.background = kept
    redraw(app)
}

// Black on white.
pub fn resetColors(app: *App) -> void {
    app.*.foreground = 0xFF000000
    app.*.background = 0xFFFFFFFF
    redraw(app)
}

// ---------------------------------------------------------------------------
// Tools

pub fn tool(app: *App) -> ?*const state.Tool {
    return tools.find(app.*.tool)
}

// Whether the tool in use is in the middle of something.
pub fn toolBusy(app: *App) -> bool {
    const current = tool(app)
    if current == null || current.?.*.busy == null { return false }
    return current.?.*.busy.?(app)
}

fn switchTool(app: *App, id: u8) -> void {
    if app.*.tool == id { return }
    const next = tools.find(id)
    if next == null { return }
    const before = tool(app)
    if before != null && before.?.*.deactivate != null { before.?.*.deactivate.?(app) }
    app.*.tool = id
    if next.?.*.activate != null { next.?.*.activate.?(app) }
    wantTicks(app, false)
    redraw(app)
}

// Makes tool `id` the one in use.
pub fn setTool(app: *App, id: u8) -> void {
    app.*.toolBefore = state.NO_TOOL
    switchTool(app, id)
}

// Uses tool `id` for a while (until releaseTool): the colour sampler
// while Control is held, the hand while the space bar is.
pub fn holdTool(app: *App, id: u8) -> void {
    if app.*.tool == id || toolBusy(app) { return }
    if app.*.toolBefore == state.NO_TOOL { app.*.toolBefore = app.*.tool }
    switchTool(app, id)
}

pub fn releaseTool(app: *App) -> void {
    if app.*.toolBefore == state.NO_TOOL { return }
    const back = app.*.toolBefore
    app.*.toolBefore = state.NO_TOOL
    switchTool(app, back)
}

// ---------------------------------------------------------------------------
// Dialogs

// Shows `dialog` over the window (over the dialogs already open). False
// when too many are open.
pub fn pushDialog(app: *App, dialog: state.Dialog) -> bool {
    if app.*.dialogCount >= state.DIALOGS { return false }
    app.*.dialogs[app.*.dialogCount] = dialog
    app.*.dialogCount += 1
    redraw(app)
    return true
}

// Closes the dialog on top.
pub fn popDialog(app: *App) -> void {
    if app.*.dialogCount == 0 { return }
    app.*.dialogCount -= 1
    redraw(app)
}

pub fn dialogOpen(app: *App) -> bool { return app.*.dialogCount > 0 }

// ---------------------------------------------------------------------------
// Actions

// Whether an action can run now (its flags and its own answer).
pub fn actionEnabled(app: *App, action: *const state.Action) -> bool {
    const flags = action.*.flags
    if flags & state.ACTION_NEEDS_DOCUMENT != 0 && document(app) == null { return false }
    if flags & state.ACTION_NEEDS_LAYER != 0 && activeNode(app) == null { return false }
    if flags & state.ACTION_NEEDS_SELECTION != 0 {
        const picture = image(app)
        if picture == null || !picture.?.*.selected { return false }
    }
    if action.*.enabled != null { return action.*.enabled.?(app) }
    return true
}

// Runs the action named `key` if there is one and it can run. True when
// it ran.
pub fn run(app: *App, key: []const u8) -> bool {
    const action = actions.byKey(key)
    if action == null { return false }
    if !actionEnabled(app, action.?) { return false }
    action.?.*.run(app)
    redraw(app)
    return true
}

// ---------------------------------------------------------------------------
// Undo

pub fn undo(app: *App) -> void {
    const picture = image(app)
    if picture == null || toolBusy(app) { return }
    if !history_module.canUndo(picture.?.*.history) { return }
    const name = history_module.undoName(picture.?.*.history)
    sayWith(app, state.tr(app, "Undone: ", "Rückgängig: "), name, false)
    _ = history_module.undo(picture.?.*.history, picture.?)
    redraw(app)
}

pub fn redo(app: *App) -> void {
    const picture = image(app)
    if picture == null || toolBusy(app) { return }
    if !history_module.canRedo(picture.?.*.history) { return }
    const name = history_module.redoName(picture.?.*.history)
    sayWith(app, state.tr(app, "Redone: ", "Wiederholt: "), name, false)
    _ = history_module.redo(picture.?.*.history, picture.?)
    redraw(app)
}
