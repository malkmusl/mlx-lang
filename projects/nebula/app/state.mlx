// nebula app: the program's state, and what its parts are to each other.
//
// One App (heap) holds what every part may know: the open documents, the
// colours, the tool in use, the window's layout of this frame, the
// pointer and the keys, what is shown over everything. What only one part
// knows it keeps itself, in a slot: slot(app, SLOT_X, bytes) is zeroed
// memory of its own, made at the first asking and kept until the program
// ends (a docker's scroll offset, a tool's drag in progress).
//
// The parts are described by records in constant tables (as the filters
// are: filters/types.mlx), put together by a registry each:
//
//   Tool     tools/registry.mlx     what the pointer does on the canvas
//   Docker   dockers/registry.mlx   a panel beside the canvas
//   Action   actions/registry.mlx   something done by a menu entry, a
//                                   shortcut or a button
//   Dialog   (pushed while open)    a window over the window, asking
//
// Their functions get the App. app/api.mlx has what they call on it
// (the current document, saying something in the status bar, running an
// action by its key, asking for a frame).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const canvas_module = @import("std.ui.canvas")
const shell_module = @import("./shell.mlx")
const viewport = @import("../ui/viewport.mlx")
const image_module = @import("../core/image.mlx")
const geom = @import("../core/geom.mlx")

pub const Allocator = std.allocator.Allocator
pub const Canvas = canvas_module.Canvas
pub const Text = text_module.Text
pub const Image = image_module.Image
pub const View = viewport.View
pub const Shell = shell_module.Shell

pub const DOCUMENTS: usize = 16
pub const SLOTS: usize = 160
pub const DIALOGS: usize = 4
pub const NO_TOOL: u8 = 255

// ---------------------------------------------------------------------------
// Slots: one per part that keeps state (never reuse a number).

pub const SLOT_KIT: usize = 0
pub const SLOT_ICONS: usize = 1
pub const SLOT_MENUS: usize = 2
pub const SLOT_DOCKS: usize = 3
pub const SLOT_TOOLBAR: usize = 4
pub const SLOT_TOOLBOX: usize = 5
pub const SLOT_STATUS: usize = 6
pub const SLOT_TABS: usize = 7
pub const SLOT_CANVAS: usize = 8
pub const SLOT_SETTINGS: usize = 9
pub const SLOT_BRUSHES: usize = 10
pub const SLOT_CLIPBOARD: usize = 11
pub const SLOT_FILE_DIALOG: usize = 12
pub const SLOT_DIALOGS: usize = 13
pub const SLOT_SCRIPT: usize = 14
pub const SLOT_RESOURCES: usize = 15
pub const SLOT_RECENT: usize = 16
pub const SLOT_SHORTCUTS: usize = 17
pub const SLOT_POPUP: usize = 18
pub const SLOT_COLORS: usize = 19
// 32-79: the dockers, by their id (SLOT_DOCKER + id).
pub const SLOT_DOCKER: usize = 32
// 80-143: the tools, by their id (SLOT_TOOL + id).
pub const SLOT_TOOL: usize = 80
// 144-159: the action modules (SLOT_ACTIONS + a number of their own).
pub const SLOT_ACTIONS: usize = 144

// ---------------------------------------------------------------------------
// Documents

pub const NAME: usize = 256

// An open image and how it is looked at.
pub const Document = struct {
    image: *Image
    view: View
    // What its tab says ("Untitled-1", a file's name).
    name: [256]u8
    nameLength: usize
    // The file format it was opened from or saved as (io/formats.mlx's
    // number; 0: none yet).
    format: u8
    // The history's serial when it was saved last: differs = changed.
    savedSerial: u64
    showGrid: bool
    showRulers: bool
    showGuides: bool
    showSelection: bool
    // What the canvas view keeps for this document (its own record).
    viewData: usize
    // Guides, by the image's pixels: across (y) and down (x).
    guidesAcross: [32]i32
    guidesAcrossCount: usize
    guidesDown: [32]i32
    guidesDownCount: usize
    // The grid: spacing and offset in pixels, subdivisions.
    gridX: i32
    gridY: i32
    gridOffsetX: i32
    gridOffsetY: i32
    gridDivisions: i32
}

// ---------------------------------------------------------------------------
// Tools

// Where the pointer is on the canvas and how it is held, as a tool gets
// it: in the image's coordinates (fractions of a pixel count), and in the
// window's.
pub const Input = struct {
    x: f64
    y: f64
    windowX: i32
    windowY: i32
    // 0 to 1 (1 for a device without pressure).
    pressure: f64
    tiltX: f64
    tiltY: f64
    rotation: f64
    // Milliseconds, growing.
    time: f64
    // The button of a press or release (std.ui.app's BUTTON_LEFT, ...; 0
    // for a motion), which buttons are down (bits: 1 left, 2 right, 4
    // middle) and the modifiers held (app/keys.mlx).
    button: u32
    buttons: u32
    modifiers: u32
    // 2: the press is the second of a double click.
    clicks: u8
}

pub const BUTTONS_LEFT: u32 = 1
pub const BUTTONS_RIGHT: u32 = 2
pub const BUTTONS_MIDDLE: u32 = 4

// The toolbox's groups.
pub const GROUP_PAINT: u8 = 0
pub const GROUP_SHAPE: u8 = 1
pub const GROUP_TRANSFORM: u8 = 2
pub const GROUP_FILL: u8 = 3
pub const GROUP_SELECT: u8 = 4
pub const GROUP_VIEW: u8 = 5
pub const GROUP_OTHER: u8 = 6
pub const GROUPS: usize = 7

// What is drawn at the pointer while the tool is active.
pub const CURSOR_ARROW: u8 = 0
// The brush's outline at its size.
pub const CURSOR_BRUSH: u8 = 1
pub const CURSOR_CROSS: u8 = 2
pub const CURSOR_NONE: u8 = 3

pub const ToolEvent = fn(app: *App, input: *const Input) -> void
pub const ToolCall = fn(app: *App) -> void
// A key while the tool is active (`down`: pressed or repeated); true:
// the tool used it.
pub const ToolKey = fn(app: *App, code: u32, modifiers: u32, down: bool) -> bool
// Draws the tool's marks over the canvas (ui/overlay.mlx draws by the
// image's coordinates).
pub const ToolOverlay = fn(app: *App, canvas: *Canvas) -> void
// Draws the tool's options into `area` of the Tool Options docker; the
// height they took.
pub const ToolOptions = fn(app: *App, area: ui.Rect) -> i32
pub const ToolAsk = fn(app: *App) -> bool

pub const Tool = struct {
    // The tool's number: it stays (settings name tools by `key`).
    id: u8
    key: []const u8
    name: []const u8
    german: []const u8
    // The key that chooses it ("B"; "": none).
    shortcut: []const u8
    // ui/icons.mlx's number of its picture.
    icon: u16
    group: u8
    cursor: u8
    // The tool became the active one / stops being it (a tool with
    // something unfinished finishes or drops it then).
    activate: ?ToolCall
    deactivate: ?ToolCall
    // A button went down on the canvas, the pointer moved (over the
    // canvas with no button down, or anywhere while the press lasts), the
    // button came up.
    press: ?ToolEvent
    move: ?ToolEvent
    release: ?ToolEvent
    keyPress: ?ToolKey
    // Time passed (about 60 times a second while the tool asked for it
    // with api.wantTicks).
    tick: ?ToolCall
    overlay: ?ToolOverlay
    options: ?ToolOptions
    // Escape and Enter while something is unfinished.
    cancel: ?ToolCall
    finish: ?ToolCall
    // Whether something is unfinished (undo and other tools wait).
    busy: ?ToolAsk
}

// ---------------------------------------------------------------------------
// Dockers

pub const DockerDraw = fn(app: *App, area: ui.Rect) -> void
// A key while the pointer is over the docker; true: used.
pub const DockerKey = fn(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool

pub const Docker = struct {
    id: u8
    key: []const u8
    name: []const u8
    german: []const u8
    icon: u16
    // Draws itself into `area` (clipped to it by whoever calls) and takes
    // its input through the widgets it draws.
    draw: DockerDraw
    keyPress: ?DockerKey
    // The height it would like (0: all it can get).
    wanted: i32
}

// ---------------------------------------------------------------------------
// Actions

// The menus of the menu bar, and where else an action may be listed.
pub const MENU_NONE: u8 = 0
pub const MENU_FILE: u8 = 1
pub const MENU_EDIT: u8 = 2
pub const MENU_VIEW: u8 = 3
pub const MENU_IMAGE: u8 = 4
pub const MENU_LAYER: u8 = 5
pub const MENU_SELECT: u8 = 6
pub const MENU_FILTER: u8 = 7
pub const MENU_TOOLS: u8 = 8
pub const MENU_SETTINGS: u8 = 9
pub const MENU_HELP: u8 = 10
pub const MENUS: usize = 11

pub const ACTION_SEPARATOR_BEFORE: u8 = 1
// Needs an open document / an active layer / a selection to be enabled.
pub const ACTION_NEEDS_DOCUMENT: u8 = 2
pub const ACTION_NEEDS_LAYER: u8 = 4
pub const ACTION_NEEDS_SELECTION: u8 = 8
// Shown with a check mark when `checked` says so.
pub const ACTION_CHECKABLE: u8 = 16

pub const ActionRun = fn(app: *App) -> void
pub const ActionAsk = fn(app: *App) -> bool

pub const Action = struct {
    // The action's name in settings and scripts ("file_new"): it stays.
    key: []const u8
    name: []const u8
    german: []const u8
    // Its shortcut unless the user set another ("Ctrl+N"; "": none).
    shortcut: []const u8
    menu: u8
    // The submenu it is in within its menu ("": none), in both languages
    // ("New|Neu").
    submenu: []const u8
    flags: u8
    run: ActionRun
    checked: ?ActionAsk
    enabled: ?ActionAsk
}

// ---------------------------------------------------------------------------
// Dialogs

// Draws the dialog over the window (`window`: all of it) and takes its
// input through the widgets it draws.
pub const DialogDraw = fn(app: *App, window: ui.Rect) -> void
// A key while it is open; true: used (Escape and Enter not used close and
// accept it).
pub const DialogKey = fn(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool

pub const Dialog = struct {
    draw: DialogDraw
    keyPress: ?DialogKey
    // Called when it is closed without being accepted (Escape).
    cancel: ?ActionRun
    // Called when Enter accepts it.
    accept: ?ActionRun
}

// ---------------------------------------------------------------------------
// The program

pub const App = struct {
    allocator: Allocator
    shell: *Shell
    ready: bool
    german: bool
    // Widgets.
    ui: view.Ui
    theme: theme_module.Theme
    title: Text
    body: Text
    small: Text
    mono: Text
    fontsLoaded: bool
    lightness: i32
    scale: i32
    // The window's parts as laid out for this frame.
    window: ui.Rect
    menuBar: ui.Rect
    toolBar: ui.Rect
    tabBar: ui.Rect
    canvasArea: ui.Rect
    leftDock: ui.Rect
    rightDock: ui.Rect
    statusBar: ui.Rect
    // Only the canvas, nothing around it (Tab toggles).
    canvasOnly: bool
    // The open documents and the one in front.
    documents: [16]?*Document
    count: usize
    current: usize
    untitled: u32
    // The tool in use, and the one to come back to when the one in use is
    // held only for a while (the colour sampler while Control is down);
    // NO_TOOL: none.
    tool: u8
    toolBefore: u8
    // Painting: the two colours (straight), the brush in use (a
    // brush.Settings, see app/brushes.mlx), and what applies to every
    // stroke.
    foreground: u32
    background: u32
    brush: usize
    eraser: bool
    mirrorX: bool
    mirrorY: bool
    wrapAround: bool
    // The pointer in the window, the buttons down (BUTTONS_*), the
    // modifiers held, the space bar held.
    pointerX: i32
    pointerY: i32
    pointerInside: bool
    buttons: u32
    modifiers: u32
    spaceHeld: bool
    // A press on the canvas keeps the pointer for the tool until its
    // release; which button it was.
    canvasGrab: bool
    grabButton: u32
    // The last press, for double clicks.
    pressTime: usize
    pressX: i32
    pressY: i32
    clicks: u8
    // Dialogs open, the last one on top.
    dialogs: [4]Dialog
    dialogCount: usize
    // What the status bar says for a while.
    note: [200]u8
    noteLength: usize
    noteUntil: usize
    noteDanger: bool
    // What the next frame must draw: everything, or only the canvas
    // where `canvasDirty` (window pixels) says.
    fullRedraw: bool
    canvasDirty: ui.Rect
    // Time is wanted by the active tool (api.wantTicks).
    ticking: bool
    // The time of the frame being drawn (ms).
    time: usize
    slots: [160]usize
    slotSizes: [160]usize
}

// The memory of slot `index`, `bytes` long, zeroed at first: made at the
// first asking, the same from then on. Null without memory.
pub fn slot(app: *App, index: usize, bytes: usize) -> ?[*]u8 {
    if index >= SLOTS { return null }
    if app.*.slots[index] == 0 {
        const memory = app.*.allocator.alloc(bytes, 16)
        if memory == null { return null }
        std.mem.zero(memory.?, bytes)
        app.*.slots[index] = @intFromPtr(memory.?)
        app.*.slotSizes[index] = bytes
    }
    unsafe { return @ptrFromInt([*]u8, app.*.slots[index]) }
}

// Whether the slot was made already.
pub fn hasSlot(app: *App, index: usize) -> bool {
    return index < SLOTS && app.*.slots[index] != 0
}

pub fn uiOf(app: *App) -> *view.Ui { return &app.*.ui }
pub fn themeOf(app: *App) -> *theme_module.Theme { return &app.*.theme }
pub fn titleOf(app: *App) -> *Text { return &app.*.title }
pub fn bodyOf(app: *App) -> *Text { return &app.*.body }
pub fn smallOf(app: *App) -> *Text { return &app.*.small }
pub fn monoOf(app: *App) -> *Text { return &app.*.mono }

// English or German, as the program runs.
pub fn tr(app: *App, english: []const u8, german: []const u8) -> []const u8 {
    return if app.*.german { german } else { english }
}

// Logical pixels as the window's.
pub fn px(app: *App, value: i32) -> i32 { return value * app.*.scale }

// A fresh App in heap memory: nothing open, the brush tool not yet set
// (main sets up the rest). Null without memory.
pub fn create(allocator: Allocator, shell: *Shell) -> ?*App {
    const memory = allocator.alloc(@sizeOf(App), 16)
    if memory == null { return null }
    std.mem.zero(memory.?, @sizeOf(App))
    const app: *App = unsafe { @ptrCast(*App, memory.?) }
    app.*.allocator = allocator
    app.*.shell = shell
    app.*.ready = false
    app.*.german = false
    app.*.fontsLoaded = false
    app.*.title.loaded = false
    app.*.body.loaded = false
    app.*.small.loaded = false
    app.*.mono.loaded = false
    app.*.lightness = -1
    app.*.scale = 1
    app.*.count = 0
    app.*.current = 0
    app.*.untitled = 0
    app.*.tool = 0
    app.*.toolBefore = NO_TOOL
    app.*.foreground = 0xFF000000
    app.*.background = 0xFFFFFFFF
    app.*.brush = 0
    app.*.pointerX = -1
    app.*.pointerY = -1
    app.*.dialogCount = 0
    app.*.noteLength = 0
    app.*.fullRedraw = true
    app.*.canvasDirty = ui.rect(0, 0, 0, 0)
    return app
}
