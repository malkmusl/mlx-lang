// nebula app: keys and shortcuts. A key event carries a Linux key code
// (what Wayland and evdev give, the same on brixOS) and the modifiers
// held (std.ui.keys: SHIFT, CONTROL, ALT, SUPER); std.ui.keys names only
// a few codes, here are the rest a painting program listens for.
//
// A shortcut is written as people read it ("Ctrl+Shift+Z", "B", "[",
// "F5", "Space", "Ctrl+Alt+Del") and kept as a Shortcut: a letter, digit
// or mark is matched by what the key TYPES without Control and Alt (the
// same letter on every keyboard layout: Z is Z on a German keyboard),
// everything else by its key code.
const std = @import("std")
const ui_keys = @import("std.ui.keys")

pub const SHIFT: u32 = ui_keys.SHIFT
pub const CONTROL: u32 = ui_keys.CONTROL
pub const ALT: u32 = ui_keys.ALT
pub const SUPER: u32 = ui_keys.SUPER

pub const ESCAPE: u32 = 1
pub const DIGIT_1: u32 = 2
pub const DIGIT_0: u32 = 11
pub const MINUS: u32 = 12
pub const EQUAL: u32 = 13
pub const BACKSPACE: u32 = 14
pub const TAB: u32 = 15
pub const LEFT_BRACE: u32 = 26
pub const RIGHT_BRACE: u32 = 27
pub const ENTER: u32 = 28
pub const LEFT_CONTROL: u32 = 29
pub const LEFT_SHIFT: u32 = 42
pub const RIGHT_SHIFT: u32 = 54
pub const LEFT_ALT: u32 = 56
pub const SPACE: u32 = 57
pub const F1: u32 = 59
pub const F10: u32 = 68
pub const F11: u32 = 87
pub const F12: u32 = 88
pub const KEYPAD_ENTER: u32 = 96
pub const RIGHT_CONTROL: u32 = 97
pub const RIGHT_ALT: u32 = 100
pub const HOME: u32 = 102
pub const UP: u32 = 103
pub const PAGE_UP: u32 = 104
pub const LEFT: u32 = 105
pub const RIGHT: u32 = 106
pub const END: u32 = 107
pub const DOWN: u32 = 108
pub const PAGE_DOWN: u32 = 109
pub const INSERT: u32 = 110
pub const DELETE: u32 = 111
pub const LEFT_SUPER: u32 = 125
pub const RIGHT_SUPER: u32 = 126

pub fn isModifier(code: u32) -> bool {
    return code == LEFT_CONTROL || code == RIGHT_CONTROL || code == LEFT_SHIFT || code == RIGHT_SHIFT || code == LEFT_ALT || code == RIGHT_ALT || code == LEFT_SUPER || code == RIGHT_SUPER
}

// The modifier bit a modifier key holds (0: not one).
pub fn modifierOf(code: u32) -> u32 {
    if code == LEFT_CONTROL || code == RIGHT_CONTROL { return CONTROL }
    if code == LEFT_SHIFT || code == RIGHT_SHIFT { return SHIFT }
    if code == LEFT_ALT || code == RIGHT_ALT { return ALT }
    if code == LEFT_SUPER || code == RIGHT_SUPER { return SUPER }
    return 0
}

pub fn isEnter(code: u32) -> bool { return code == ENTER || code == KEYPAD_ENTER }

// The function key's number (1-12; 0: not one).
pub fn functionKey(code: u32) -> u32 {
    if code >= F1 && code <= F10 { return code - F1 + 1 }
    if code == F11 { return 11 }
    if code == F12 { return 12 }
    return 0
}

pub const Shortcut = struct {
    modifiers: u32
    // What the key types, lower case (0: the shortcut is a key code).
    character: u8
    code: u32
}

pub fn none() -> Shortcut {
    return Shortcut.{ .modifiers = 0, .character = 0, .code = 0 }
}

pub fn isNone(shortcut: Shortcut) -> bool {
    return shortcut.character == 0 && shortcut.code == 0
}

const Named = struct {
    name: []const u8
    code: u32
}

const NAMED = [22]Named{
    Named.{ .name = "Space", .code = SPACE },
    Named.{ .name = "Enter", .code = ENTER },
    Named.{ .name = "Return", .code = ENTER },
    Named.{ .name = "Tab", .code = TAB },
    Named.{ .name = "Esc", .code = ESCAPE },
    Named.{ .name = "Escape", .code = ESCAPE },
    Named.{ .name = "Backspace", .code = BACKSPACE },
    Named.{ .name = "Del", .code = DELETE },
    Named.{ .name = "Delete", .code = DELETE },
    Named.{ .name = "Ins", .code = INSERT },
    Named.{ .name = "Insert", .code = INSERT },
    Named.{ .name = "Home", .code = HOME },
    Named.{ .name = "End", .code = END },
    Named.{ .name = "PgUp", .code = PAGE_UP },
    Named.{ .name = "PageUp", .code = PAGE_UP },
    Named.{ .name = "PgDown", .code = PAGE_DOWN },
    Named.{ .name = "PageDown", .code = PAGE_DOWN },
    Named.{ .name = "Left", .code = LEFT },
    Named.{ .name = "Right", .code = RIGHT },
    Named.{ .name = "Up", .code = UP },
    Named.{ .name = "Down", .code = DOWN },
    Named.{ .name = "Plus", .code = 0 },
}

fn lower(byte: u8) -> u8 {
    return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

fn sameWord(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if lower(left[index]) != lower(right[index]) { return false }
        index += 1
    }
    return true
}

// The shortcut a text names ("" and what cannot be read: none).
pub fn parse(text: []const u8) -> Shortcut {
    var result = none()
    var at: usize = 0
    while at < text.length {
        // A part ends at the next '+' that has something before it ("Ctrl++"
        // is Control and the plus key).
        var end = at + 1
        while end < text.length && text[end] != 43 { end += 1 }
        const part = text[at..end]
        const last = end >= text.length
        if !last && sameWord(part, "Ctrl") {
            result.modifiers |= CONTROL
        } else if !last && sameWord(part, "Shift") {
            result.modifiers |= SHIFT
        } else if !last && sameWord(part, "Alt") {
            result.modifiers |= ALT
        } else if !last && (sameWord(part, "Super") || sameWord(part, "Meta")) {
            result.modifiers |= SUPER
        } else if !last {
            return none()
        } else if part.length == 1 {
            result.character = lower(part[0])
        } else if sameWord(part, "Plus") {
            result.character = 43
        } else if part.length >= 2 && part.length <= 3 && lower(part[0]) == 102 && part[1] >= 49 && part[1] <= 57 {
            var number: u32 = @intCast(u32, part[1] - 48)
            if part.length == 3 {
                if part[2] < 48 || part[2] > 57 { return none() }
                number = number * 10 + @intCast(u32, part[2] - 48)
            }
            if number < 1 || number > 12 { return none() }
            result.code = if number <= 10 { F1 + number - 1 } else if number == 11 { F11 } else { F12 }
        } else {
            var found = false
            for named in NAMED[0..] {
                if named.code != 0 && sameWord(part, named.name) {
                    result.code = named.code
                    found = true
                    break
                }
            }
            if !found { return none() }
        }
        at = end + 1
    }
    return result
}

// The shortcut as people read it, into `into` (at most 32 bytes); its
// length.
pub fn format(shortcut: Shortcut, into: [*]u8) -> usize {
    if isNone(shortcut) { return 0 }
    var length: usize = 0
    if shortcut.modifiers & CONTROL != 0 { length = std.text.append(into, length, 32, "Ctrl+") }
    if shortcut.modifiers & ALT != 0 { length = std.text.append(into, length, 32, "Alt+") }
    if shortcut.modifiers & SHIFT != 0 { length = std.text.append(into, length, 32, "Shift+") }
    if shortcut.modifiers & SUPER != 0 { length = std.text.append(into, length, 32, "Super+") }
    if shortcut.character != 0 {
        const shown = if shortcut.character >= 97 && shortcut.character <= 122 { shortcut.character - 32 } else { shortcut.character }
        return std.text.appendByte(into, length, 32, shown)
    }
    const function = functionKey(shortcut.code)
    if function != 0 {
        length = std.text.appendByte(into, length, 32, 70)
        return std.text.appendUnsigned(into, length, 32, @intCast(usize, function))
    }
    for named in NAMED[0..] {
        if named.code == shortcut.code { return std.text.append(into, length, 32, named.name) }
    }
    return length
}

// Whether a key pressed is the shortcut: `code` its key code, `modifiers`
// those held, `plain` what it types without Control and Alt
// (std.ui.host.plainTyped).
pub fn matches(shortcut: Shortcut, code: u32, modifiers: u32, plain: []const u8) -> bool {
    if isNone(shortcut) { return false }
    if shortcut.character != 0 {
        if plain.length != 1 { return false }
        const typed = lower(plain[0])
        if typed != shortcut.character { return false }
        // A letter's Shift is part of the shortcut; a mark's Shift is how
        // the keyboard layout reaches the mark.
        const letter = typed >= 97 && typed <= 122
        if letter { return modifiers == shortcut.modifiers }
        return (modifiers & ~SHIFT) == (shortcut.modifiers & ~SHIFT)
    }
    return code == shortcut.code && modifiers == shortcut.modifiers
}
