// nebula app: what the program remembers between runs: the preferences
// (one Preferences record, every setting a typed field with a default),
// the shortcuts the user changed (app/shortcuts.mlx keeps them here) and
// texts other parts hand in to be kept (the docks' layout, the window's
// last size, the last folder, the last tool), all in one file:
//
//     $XDG_CONFIG_HOME/mlx/nebula.conf      (else ~/.config/mlx/nebula.conf)
//
// found through std.xdg in the environment the program runs with
// (app/shell.mlx's), the same call on Linux and on brixOS. It is a
// std.conf file: 'key = value' lines in [Group]s.
//
//     [General]
//     language = de
//     undo_steps = 200
//     [Shortcuts]
//     file_new = Ctrl+M
//     tool:brush = P
//     [State]
//     docks = left:layers\nright:color
//
// Use:
//
//     const prefs = settings.get(app)                   // read at the first asking
//     if prefs.*.confirmClose { ... }
//     prefs.*.undoSteps = 500
//     _ = settings.changed(app)                         // held to its range, saved
//     _ = settings.setText(app, "last_folder", folder)  // saved at once
//     const folder = settings.text(app, "last_folder")  // "": none kept
//
// Reading forgives: without a file every setting has its default, a value
// that cannot be read gives that setting's default, a number out of range
// is held to the range, a line that is no 'key = value' is passed over.
// What the program does not know (keys and groups of a newer version) is
// kept and written back, so a newer version's settings survive a run of
// an older one; comments are not kept (the program writes the file whole).
// Saving is atomic: the text goes to "nebula.conf.new", which then takes
// the file's place.
//
// The values kept as text ([State], [Shortcuts], the unknown lines) are
// in two heap blocks of the store, one for their records and one for
// their bytes, not one block a line: brixOS gives a process few memory
// regions. A [State] value may hold any bytes (up to MAX_VALUE of them):
// in the file a line feed is "\n", a CR "\r", a tab "\t", a backslash
// "\\" and a space at either end "\s", so the value is one line.
//
// Not here: applying the settings (the parts that use one read it from
// get(app)) and the preferences dialog (settingAt() describes every
// setting for it: its group, key, kind, range and names, word() a
// choice's words).
const std = @import("std")
const conf = @import("std.conf")
const xdg = @import("std.xdg")
const state = @import("./state.mlx")
const text_io = @import("../io/text.mlx")
const smoothing = @import("../brush/smoothing.mlx")
const table = @import("../core/table.mlx")

pub const App = state.App
pub const Allocator = std.allocator.Allocator

// Where the file is under the user's configuration directory.
const FILE: []const u8 = "/mlx/nebula.conf"

// The most bytes of a [State] value and of its key.
pub const MAX_VALUE: usize = 4096
pub const MAX_KEY: usize = 31
// The most bytes of a key in the other groups kept as text (an action's
// key with "tool:" before it fits).
const LONG_KEY: usize = 127

// The groups of the typed settings, by their number in Setting.group.
pub const GENERAL: u8 = 0
pub const CANVAS: u8 = 1
pub const PAINTING: u8 = 2
pub const TABLET: u8 = 3
pub const FILES: u8 = 4
const GROUPS: usize = 5

const GROUP_NAMES = [5][]const u8{ "General", "Canvas", "Painting", "Tablet", "Files" }

// The group app/shortcuts.mlx keeps its lines in, and the one of setText.
pub const SHORTCUTS: []const u8 = "Shortcuts"
const STATE: []const u8 = "State"

pub const LANGUAGE_SYSTEM: u8 = 0
pub const LANGUAGE_ENGLISH: u8 = 1
pub const LANGUAGE_GERMAN: u8 = 2

pub const THEME_SYSTEM: u8 = 0
pub const THEME_DARK: u8 = 1
pub const THEME_LIGHT: u8 = 2

// What zooms the canvas: the wheel itself, or the wheel with Control held
// (the wheel alone then scrolls).
pub const WHEEL_ZOOMS: u8 = 0
pub const CONTROL_WHEEL_ZOOMS: u8 = 1

// A setting that is text, up to LINE bytes.
pub const LINE: usize = 255

pub const Line = struct {
    length: usize
    bytes: [255]u8
}

pub const Preferences = struct {
    // [General]
    // LANGUAGE_*, THEME_*.
    language: u8
    theme: u8
    // How many steps an image's history keeps.
    undoSteps: u32
    // A changed image is saved aside every so many minutes (0: never).
    autosaveMinutes: u32
    // How many files File > Open Recent offers (app/recent.mlx).
    recentFiles: u32
    // Closing an image whose changes are not saved asks first.
    confirmClose: bool
    // [Canvas]
    // How light the ground around the image is: 0 black to 100 white.
    groundBrightness: u32
    // The checkerboard behind transparent pixels: the side of a square in
    // window pixels, its two colours (0xFFRRGGBB).
    checkerSize: u32
    checkerLight: u32
    checkerDark: u32
    // The zoom (percent) from which every pixel is outlined; 0: never.
    pixelGridZoom: u32
    // Outlines (the selection's, the brush's) are drawn smooth.
    antialiasOutline: bool
    // What the pointer shows over the canvas while painting: the brush's
    // outline, a cross at its middle.
    cursorOutline: bool
    cursorCross: bool
    // WHEEL_ZOOMS or CONTROL_WHEEL_ZOOMS.
    wheelZoom: u8
    // [Painting]
    // A new stroke's smoothing: brush/smoothing.mlx's mode (NONE to PIXEL)
    // and its distance in pixels.
    smoothing: u8
    smoothingDistance: u32
    // A mouse's speed stands in for a pen's pressure (fast is thin).
    simulatePressure: bool
    // What File > New proposes: the size in pixels, the pixels per inch,
    // the background (straight 0xAARRGGBB; alpha 0: transparent).
    imageWidth: u32
    imageHeight: u32
    imageResolution: u32
    imageBackground: u32
    // [Tablet]
    // The pen's response, points "x,y;x,y" from 0 to 1 (the tablet's
    // settings read them; here it is text).
    pressureCurve: Line
    // [Files]
    // The format an image that has none is saved in, by its key ("ora").
    saveFormat: Line
    // PNG's compression (0 to 9) and JPEG's quality (1 to 100).
    pngCompression: u32
    jpegQuality: u32
    // Saving over a file keeps the one before beside it.
    keepBackup: bool
}

// The kinds of settings (Setting.kind) and how each is written.
// A whole number, held to low..high: "200".
pub const NUMBER: u8 = 0
// A bool: "on" or "off" (read also: yes/no, true/false, 1/0).
pub const SWITCH: u8 = 1
// One of its words (a u8 field holds the word's number): "dark".
pub const CHOICE: u8 = 2
// 0xAARRGGBB as hexadecimal digits: "RRGGBB" when opaque, else "AARRGGBB".
pub const COLOR: u8 = 3
// A Line, as it is, when `check` takes it.
pub const TEXT: u8 = 4

// One setting: where it is kept, what it is called, what it may be.
pub const Setting = struct {
    group: u8
    key: []const u8
    name: []const u8
    german: []const u8
    kind: u8
    // The field in Preferences (@offsetOf).
    offset: usize
    // NUMBER: the range.
    low: u32
    high: u32
    // The default of a NUMBER and a COLOR, a SWITCH's (1: on), a CHOICE's
    // number.
    initial: u32
    // CHOICE: its words are `wordCount` of WORDS from `firstWord` on, by
    // their number (word() hands them out).
    firstWord: u8
    wordCount: u8
    // TEXT: the default, and what a value must be like.
    text: []const u8
    check: ?fn(value: []const u8) -> bool
}

// The words of every CHOICE, one after another. (A row does not hold a
// slice of a table of its own words: such a slice in a constant table is
// copied into the value arena whenever the row is read, and points there.)
const WORDS = [13][]const u8{
    // LANGUAGE_*: 0
    "system", "en", "de",
    // THEME_*: 3
    "system", "dark", "light",
    // WHEEL_ZOOMS, CONTROL_WHEEL_ZOOMS: 6
    "wheel", "ctrl+wheel",
    // brush/smoothing.mlx's NONE, BASIC, WEIGHTED, STABILIZER, PIXEL: 8
    "none", "basic", "weighted", "stabilizer", "pixel",
}

pub const SETTING_COUNT: usize = 27

