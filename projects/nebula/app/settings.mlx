    Setting.{ .group = FILES, .key = "save_format", .name = "Format to save in", .german = "Format zum Speichern", .kind = TEXT, .offset = @offsetOf(Preferences, "saveFormat"), .low = 0, .high = 0, .initial = 0, .firstWord = 0, .wordCount = 0, .text = "ora", .check = isFormatKey },
    Setting.{ .group = FILES, .key = "png_compression", .name = "PNG compression", .german = "PNG-Kompression", .kind = NUMBER, .offset = @offsetOf(Preferences, "pngCompression"), .low = 0, .high = 9, .initial = 6, .firstWord = 0, .wordCount = 0, .text = "", .check = null },
