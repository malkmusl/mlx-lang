    Setting.{ .group = GENERAL, .key = "language", .name = "Language", .german = "Sprache", .kind = CHOICE, .offset = @offsetOf(Preferences, "language"), .low = 0, .high = 0, .initial = 0, .firstWord = 0, .wordCount = 3, .text = "", .check = null },
    Setting.{ .group = GENERAL, .key = "theme", .name = "Theme", .german = "Erscheinungsbild", .kind = CHOICE, .offset = @offsetOf(Preferences, "theme"), .low = 0, .high = 0, .initial = 0, .firstWord = 3, .wordCount = 3, .text = "", .check = null },
