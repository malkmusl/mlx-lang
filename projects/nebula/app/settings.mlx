    Setting.{ .group = FILES, .key = "keep_backup", .name = "Keep a backup when saving", .german = "Beim Speichern eine Sicherung behalten", .kind = SWITCH, .offset = @offsetOf(Preferences, "keepBackup"), .low = 0, .high = 1, .initial = 1, .firstWord = 0, .wordCount = 0, .text = "", .check = null },
}

var keptRows: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The rows, from heap memory: ROWS is more than 1 KiB, and reading a row
// of it (ROWS[index]) copies the whole table into the value arena.
fn rows() -> []const Setting {
    if keptRows.address != 0 { return table.rows(Setting, &keptRows) }
    return table.keep(Setting, &keptRows, ROWS[0..])
}

// Setting number `index` (0 to SETTING_COUNT - 1), for a dialog that
// lists them; null past the last. The row stays where it is.
pub fn settingAt(index: usize) -> ?*const Setting {
    var found: ?*const Setting = null
    if index < SETTING_COUNT { found = &rows()[index] }
    return found
}

// The name of group `group` as the file writes it ("General"); "" for a
// number that is no group.
pub fn groupName(group: u8) -> []const u8 {
    if @intCast(usize, group) >= GROUPS { return "" }
    return GROUP_NAMES[@intCast(usize, group)]
}

// Word number `number` of a CHOICE as the file writes it ("dark"); ""
// past its last word, and for a setting that is no CHOICE.
pub fn word(setting: *const Setting, number: usize) -> []const u8 {
    return wordAt(setting.*.firstWord, setting.*.wordCount, number)
}

fn wordAt(first: u8, count: u8, number: usize) -> []const u8 {
    if number >= @intCast(usize, count) { return "" }
    return WORDS[@intCast(usize, first) + number]
}

// ---------------------------------------------------------------------------
// The record and its fields

// The text a Line holds (no more than LINE bytes, whatever its length
// says).
pub fn lineText(line: *const Line) -> []const u8 {
    const bytes: [*]const u8 = &line.*.bytes
    return bytes[0..if line.*.length < LINE { line.*.length } else { LINE }]
}

// `line` becomes `value`; false (and `line` as it was) when it does not
// fit in LINE bytes.
pub fn setLine(line: *Line, value: []const u8) -> bool {
    if value.length > LINE { return false }
    const bytes: [*]u8 = &line.*.bytes
    std.mem.copy(bytes, value.pointer, value.length)
    line.*.length = value.length
    return true
}

fn bytesOf(prefs: *Preferences) -> [*]u8 { unsafe { return @ptrCast([*]u8, prefs) } }
fn numberAt(prefs: *Preferences, offset: usize) -> *u32 { unsafe { return @ptrCast(*u32, bytesOf(prefs) + offset) } }
fn switchAt(prefs: *Preferences, offset: usize) -> *bool { unsafe { return @ptrCast(*bool, bytesOf(prefs) + offset) } }
fn choiceAt(prefs: *Preferences, offset: usize) -> *u8 { unsafe { return @ptrCast(*u8, bytesOf(prefs) + offset) } }
fn lineAt(prefs: *Preferences, offset: usize) -> *Line { unsafe { return @ptrCast(*Line, bytesOf(prefs) + offset) } }

// Every setting at its default.
pub fn defaults(prefs: *Preferences) -> void {
    const list = rows()
    var index: usize = 0
    while index < SETTING_COUNT {
        const row = list[index]
        if row.kind == NUMBER || row.kind == COLOR {
            numberAt(prefs, row.offset).* = row.initial
        } else if row.kind == SWITCH {
            switchAt(prefs, row.offset).* = row.initial != 0
        } else if row.kind == CHOICE {
            choiceAt(prefs, row.offset).* = @intCast(u8, row.initial)
        } else {
            _ = setLine(lineAt(prefs, row.offset), row.text)
        }
        index += 1
    }
}

// Every setting held to what it may be: a number to its range, a choice
// and a text that are none of their kind to their default.
fn normalize(prefs: *Preferences) -> void {
    const list = rows()
    var index: usize = 0
    while index < SETTING_COUNT {
        const row = list[index]
        if row.kind == NUMBER {
            const number = numberAt(prefs, row.offset)
            if number.* < row.low { number.* = row.low }
            if number.* > row.high { number.* = row.high }
        } else if row.kind == CHOICE {
            const choice = choiceAt(prefs, row.offset)
            if choice.* >= row.wordCount { choice.* = @intCast(u8, row.initial) }
        } else if row.kind == TEXT {
            const line = lineAt(prefs, row.offset)
            if line.*.length > LINE || row.check == null || !row.check.?(lineText(line)) { _ = setLine(line, row.text) }
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Values as text

// A whole number, a sign allowed, held to low..high into `into`; false
// when the text is no number.
fn readNumber(text: []const u8, low: u32, high: u32, into: *u32) -> bool {
    var index: usize = 0
    var negative = false
    if text.length > 0 && (text[0] == 45 || text[0] == 43) {
        negative = text[0] == 45
        index = 1
    }
    if index >= text.length { return false }
    var value: u64 = 0
    while index < text.length {
        const byte = text[index]
        if byte < 48 || byte > 57 { return false }
        // Beyond what a u32 holds the number only has to stay beyond it:
        // the range takes it back.
        if value < 4294967296 { value = value * 10 + @intCast(u64, byte - 48) }
        index += 1
    }
    if negative && value > 0 {
        into.* = low
    } else if value < @intCast(u64, low) {
        into.* = low
    } else if value > @intCast(u64, high) {
        into.* = high
    } else {
        into.* = @intCast(u32, value)
    }
    return true
}

fn readSwitch(text: []const u8, into: *bool) -> bool {
    const same = text_io.sameIgnoringCase
    if same(text, "on") || same(text, "yes") || same(text, "true") || same(text, "1") {
        into.* = true
        return true
    }
    if same(text, "off") || same(text, "no") || same(text, "false") || same(text, "0") {
        into.* = false
        return true
    }
    return false
}

// "RRGGBB" (opaque) or "AARRGGBB", a "#" before them allowed.
fn readColor(text: []const u8, into: *u32) -> bool {
    var digits = text
    if digits.length > 0 && digits[0] == 35 { digits = text[1..text.length] }
    if digits.length != 6 && digits.length != 8 { return false }
    var value: u32 = 0
    for byte in digits {
        const nibble = std.text.hexValue(byte)
        if nibble >= 16 { return false }
        value = (value << 4) | @intCast(u32, nibble)
    }
    into.* = if digits.length == 6 { value | 0xFF000000 } else { value }
    return true
}

const HEX: []const u8 = "0123456789ABCDEF"

fn appendColor(into: [*]u8, at: usize, capacity: usize, color: u32) -> usize {
    var length = at
    var digits: usize = if color >> 24 == 255 { 6 } else { 8 }
    while digits > 0 {
        digits -= 1
        const nibble = (color >> @intCast(u5, digits * 4)) & 15
        length = std.text.appendByte(into, length, capacity, HEX[@intCast(usize, nibble)])
    }
    return length
}

// The number of the word of a CHOICE (`count` words from WORDS[first])
// that `text` is, in any case; `fallback` when it is none of them.
fn wordOf(first: u8, count: u8, text: []const u8, fallback: u32) -> u8 {
    var index: usize = 0
    while index < @intCast(usize, count) {
        if text_io.sameIgnoringCase(wordAt(first, count, index), text) { return @intCast(u8, index) }
        index += 1
    }
    return @intCast(u8, fallback)
}

// A number of a curve's point: 0 to 1, as "0", "1", "0.25", "1.000".
fn isUnit(text: []const u8) -> bool {
    var index: usize = 0
    var whole: u32 = 0
    while index < text.length && text[index] >= 48 && text[index] <= 57 {
        if whole < 10 { whole = whole * 10 + @intCast(u32, text[index] - 48) }
        index += 1
    }
    if index == 0 || whole > 1 { return false }
    if index == text.length { return true }
    if text[index] != 46 || index + 1 == text.length { return false }
    index += 1
    while index < text.length {
        if text[index] < 48 || text[index] > 57 { return false }
        // 1 is the most: 1.5 is not one.
        if whole == 1 && text[index] != 48 { return false }
        index += 1
    }
    return true
}

// "x,y;x,y": two points at least, each number from 0 to 1, a ";" after
// the last allowed (as Krita writes them).
fn isCurve(text: []const u8) -> bool {
    var points: usize = 0
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 59 { end += 1 }
        const point = text[at..end]
        var comma: usize = 0
        while comma < point.length && point[comma] != 44 { comma += 1 }
        if comma == point.length || !isUnit(point[0..comma]) || !isUnit(point[comma + 1..point.length]) { return false }
        points += 1
        at = end + 1
    }
    return points >= 2
}

// A file format's key: 1 to 15 small letters and digits ("ora", "png").
fn isFormatKey(text: []const u8) -> bool {
    if text.length == 0 || text.length > 15 { return false }
    for byte in text {
        if !((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)) { return false }
    }
    return true
}

// Setting `index` from the file's text; its default when the text is
// none of its kind.
fn apply(prefs: *Preferences, index: usize, value: []const u8) -> void {
    const list = rows()
    const row = list[index]
    if row.kind == NUMBER {
        if !readNumber(value, row.low, row.high, numberAt(prefs, row.offset)) { numberAt(prefs, row.offset).* = row.initial }
    } else if row.kind == SWITCH {
        // (A word that is no switch leaves `on` at the default.)
        var on = row.initial != 0
        _ = readSwitch(value, &on)
        switchAt(prefs, row.offset).* = on
    } else if row.kind == CHOICE {
        choiceAt(prefs, row.offset).* = wordOf(row.firstWord, row.wordCount, value, row.initial)
    } else if row.kind == COLOR {
        if !readColor(value, numberAt(prefs, row.offset)) { numberAt(prefs, row.offset).* = row.initial }
    } else {
        const line = lineAt(prefs, row.offset)
        if row.check == null || !row.check.?(value) || !setLine(line, value) { _ = setLine(line, row.text) }
    }
}

// Setting `index` as its line of the file ("undo_steps = 200\n").
fn appendSetting(prefs: *Preferences, index: usize, into: [*]u8, at: usize, capacity: usize) -> usize {
    const list = rows()
    const row = list[index]
    var length = std.text.append(into, at, capacity, row.key)
    length = std.text.append(into, length, capacity, " = ")
    if row.kind == NUMBER {
        length = std.text.appendUnsigned(into, length, capacity, @intCast(usize, numberAt(prefs, row.offset).*))
    } else if row.kind == SWITCH {
        length = std.text.append(into, length, capacity, if switchAt(prefs, row.offset).* { "on" } else { "off" })
    } else if row.kind == CHOICE {
        const choice = choiceAt(prefs, row.offset).*
        const number = if choice < row.wordCount { choice } else { @intCast(u8, row.initial) }
        length = std.text.append(into, length, capacity, wordAt(row.firstWord, row.wordCount, @intCast(usize, number)))
    } else if row.kind == COLOR {
        length = appendColor(into, length, capacity, numberAt(prefs, row.offset).*)
    } else {
        length = std.text.append(into, length, capacity, lineText(lineAt(prefs, row.offset)))
    }
    return std.text.appendByte(into, length, capacity, 10)
}

// A [State] value as one line (see the header), and back.
fn appendEscaped(into: [*]u8, at: usize, capacity: usize, value: []const u8) -> usize {
    var length = at
    var index: usize = 0
    while index < value.length {
        const byte = value[index]
        if byte == 92 {
            length = std.text.append(into, length, capacity, "\\\\")
        } else if byte == 10 {
            length = std.text.append(into, length, capacity, "\\n")
        } else if byte == 13 {
            length = std.text.append(into, length, capacity, "\\r")
        } else if byte == 9 {
            length = std.text.append(into, length, capacity, "\\t")
        } else if byte == 32 && (index == 0 || index + 1 == value.length) {
            // (Reading takes the blanks around a value away.)
            length = std.text.append(into, length, capacity, "\\s")
        } else {
            length = std.text.appendByte(into, length, capacity, byte)
        }
        index += 1
    }
    return length
}

// The `length` bytes at `bytes` as appendEscaped wrote them, read back in
// place (a backslash before anything else stays); their new length.
fn decode(bytes: [*]u8, length: usize) -> usize {
    var from: usize = 0
    var to: usize = 0
    while from < length {
        var byte = bytes[from]
        if byte == 92 && from + 1 < length {
            const next = bytes[from + 1]
            var escaped = true
            if next == 92 {
                byte = 92
            } else if next == 110 {
                byte = 10
            } else if next == 114 {
                byte = 13
            } else if next == 116 {
                byte = 9
            } else if next == 115 {
                byte = 32
            } else {
                escaped = false
            }
            if escaped { from += 1 }
        }
        bytes[to] = byte
        to += 1
        from += 1
    }
    return to
}

// A key that reads back as itself: 1 to `limit` bytes, no "=", no
// control character, no blank at either end, and not starting as a
// comment or a group does.
fn validKey(key: []const u8, limit: usize) -> bool {
    if key.length == 0 || key.length > limit { return false }
    if key[0] == 35 || key[0] == 91 || key[0] == 32 || key[key.length - 1] == 32 { return false }
    for byte in key {
        if byte < 32 || byte == 61 || byte == 127 { return false }
    }
    return true
}

// ---------------------------------------------------------------------------
// The store: the record, and the lines kept as text

const Span = struct {
    at: usize
    length: usize
}

// A line kept as text: its group, key and value as bytes of the pool (a
// [State] value as it is, every other one as the file says it).
const Record = struct {
    group: Span
    key: Span
    value: Span
}

// The least the pool and the records grow to.
const POOL_LEAST: usize = 1024
const RECORDS_LEAST: usize = 16

const Store = struct {
    // The slot comes zeroed: the defaults are set at the first asking.
    ready: bool
    loaded: bool
    prefs: Preferences
    // Grows whenever the lines kept as text change (a load among them):
    // app/shortcuts.mlx works its table out again then.
    generation: u64
    records: [*]Record
    recordCount: usize
    recordCapacity: usize
    pool: [*]u8
    poolUsed: usize
    poolCapacity: usize
    // The file's path, NUL-terminated (made from the environment at every
    // load and save: a test gives the program another one).
    path: [4096]u8
}

// What get() hands out when there is no memory for the store: the
// defaults (a change to it is not kept).
var fallback: Preferences = undefined

fn storeOf(app: *App) -> ?*Store {
    const memory = state.slot(app, state.SLOT_SETTINGS, @sizeOf(Store))
    if memory == null { return null }
    const store: *Store = unsafe { @ptrCast(*Store, memory.?) }
    if !store.*.ready {
        defaults(&store.*.prefs)
        store.*.ready = true
    }
    return store
}

// The store, read from the file at the first asking.
fn loadedStore(app: *App) -> ?*Store {
    const store = storeOf(app)
    if store == null { return null }
    if !store.?.*.loaded { _ = read(app, store.?) }
    return store
}

fn spanText(store: *Store, span: Span) -> []const u8 {
    if span.length == 0 { return "" }
    return store.*.pool[span.at..span.at + span.length]
}

// The record of `key` in `group`; recordCount when there is none.
fn find(store: *Store, group: []const u8, key: []const u8) -> usize {
    var index: usize = 0
    while index < store.*.recordCount {
        const record = store.*.records[index]
        if std.text.same(spanText(store, record.key), key) && std.text.same(spanText(store, record.group), group) { return index }
        index += 1
    }
    return store.*.recordCount
}

fn copySpan(store: *Store, into: [*]u8, used: *usize, span: Span) -> Span {
    std.mem.copy(into + used.*, store.*.pool + span.at, span.length)
    const moved = Span.{ .at = used.*, .length = span.length }
    used.* += span.length
    return moved
}

// Copies `parts` into the pool, their places into `spans`. Without room
// the pool is made anew with only what the records point at, and larger;
// the old block is given back only after `parts` were copied, for they
// may be bytes of it. False without memory (nothing changed then).
fn place(store: *Store, allocator: Allocator, parts: *const [3][]const u8, spans: *[3]Span) -> bool {
    const total = parts.*[0].length + parts.*[1].length + parts.*[2].length
    const old = store.*.pool
    var oldCapacity: usize = 0
    if store.*.poolUsed + total > store.*.poolCapacity {
        var live: usize = 0
        var index: usize = 0
        while index < store.*.recordCount {
            const record = store.*.records[index]
            live += record.group.length + record.key.length + record.value.length
            index += 1
        }
        var capacity = (live + total) * 2
        if capacity < POOL_LEAST { capacity = POOL_LEAST }
        const memory = allocator.alloc(capacity, 16)
        if memory == null { return false }
        var used: usize = 0
        index = 0
        while index < store.*.recordCount {
            const record = &store.*.records[index]
            record.*.group = copySpan(store, memory.?, &used, record.*.group)
            record.*.key = copySpan(store, memory.?, &used, record.*.key)
            record.*.value = copySpan(store, memory.?, &used, record.*.value)
            index += 1
        }
        oldCapacity = store.*.poolCapacity
        store.*.pool = memory.?
        store.*.poolCapacity = capacity
        store.*.poolUsed = used
    }
    var part: usize = 0
    while part < 3 {
        const bytes = parts.*[part]
        std.mem.copy(store.*.pool + store.*.poolUsed, bytes.pointer, bytes.length)
        spans.*[part] = Span.{ .at = store.*.poolUsed, .length = bytes.length }
        store.*.poolUsed += bytes.length
        part += 1
    }
    if oldCapacity != 0 { allocator.free(old, oldCapacity, 16) }
    return true
}

// Room for one record more; false without memory.
fn roomForRecord(store: *Store, allocator: Allocator) -> bool {
    if store.*.recordCount < store.*.recordCapacity { return true }
    var capacity = store.*.recordCapacity * 2
    if capacity < RECORDS_LEAST { capacity = RECORDS_LEAST }
    const memory = allocator.alloc(capacity * @sizeOf(Record), 16)
    if memory == null { return false }
    const records: [*]Record = unsafe { @ptrCast([*]Record, memory.?) }
    var index: usize = 0
    while index < store.*.recordCount {
        records[index] = store.*.records[index]
        index += 1
    }
    if store.*.recordCapacity != 0 {
        unsafe { allocator.free(@ptrCast([*]u8, store.*.records), store.*.recordCapacity * @sizeOf(Record), 16) }
    }
    store.*.records = records
    store.*.recordCapacity = capacity
    return true
}

// `key` in `group` keeps `value` (its record's value replaced, else a
// record added at the end). False without memory.
fn put(store: *Store, allocator: Allocator, group: []const u8, key: []const u8, value: []const u8) -> bool {
    var spans: [3]Span = undefined
    const index = find(store, group, key)
    if index < store.*.recordCount {
        const old = store.*.records[index].value
        if value.length <= old.length {
            // Where the old value was (the bytes go down, if the new value
            // is a part of the old one).
            std.mem.copy(store.*.pool + old.at, value.pointer, value.length)
            store.*.records[index].value = Span.{ .at = old.at, .length = value.length }
        } else {
            const parts = [3][]const u8{ "", "", value }
            if !place(store, allocator, &parts, &spans) { return false }
            store.*.records[index].value = spans[2]
        }
    } else {
        if !roomForRecord(store, allocator) { return false }
        const parts = [3][]const u8{ group, key, value }
        if !place(store, allocator, &parts, &spans) { return false }
        store.*.records[store.*.recordCount] = Record.{ .group = spans[0], .key = spans[1], .value = spans[2] }
        store.*.recordCount += 1
    }
    store.*.generation += 1
    return true
}

// The record at `index` goes (the ones after it move up).
fn remove(store: *Store, index: usize) -> void {
    if index >= store.*.recordCount { return }
    var at = index
    while at + 1 < store.*.recordCount {
        store.*.records[at] = store.*.records[at + 1]
        at += 1
    }
    store.*.recordCount -= 1
    store.*.generation += 1
}

fn groupNumber(name: []const u8) -> usize {
    var index: usize = 0
    while index < GROUPS {
        if std.text.same(GROUP_NAMES[index], name) { return index }
        index += 1
    }
    return GROUPS
}

fn settingIndex(group: usize, key: []const u8) -> usize {
    const list = rows()
    var index: usize = 0
    while index < SETTING_COUNT {
        if @intCast(usize, list[index].group) == group && std.text.same(list[index].key, key) { return index }
        index += 1
    }
    return SETTING_COUNT
}

// A line of the file: a setting, or a line kept as text.
fn take(store: *Store, allocator: Allocator, group: []const u8, key: []const u8, value: []const u8) -> void {
    const known = groupNumber(group)
    if known < GROUPS {
        const index = settingIndex(known, key)
        if index < SETTING_COUNT {
            apply(&store.*.prefs, index, value)
            return
        }
    }
    if !std.text.same(group, STATE) {
        _ = put(store, allocator, group, key, value)
        return
    }
    if !validKey(key, MAX_KEY) || !put(store, allocator, group, key, value) { return }
    const index = find(store, group, key)
    const record = &store.*.records[index]
    record.*.value.length = decode(store.*.pool + record.*.value.at, record.*.value.length)
    // (Empty is what no value is; too long is what setText refuses.)
    if record.*.value.length == 0 || record.*.value.length > MAX_VALUE { remove(store, index) }
}

// The file's path into the store; its length, 0 when the environment
// names no place for it.
fn pathOf(app: *App, store: *Store) -> usize {
    return xdg.path(app.*.shell.*.environment, xdg.CONFIG, FILE, &store.*.path, std.fs.PATH_MAX)
}

// The store as the file says (the defaults and nothing kept without one).
fn read(app: *App, store: *Store) -> bool {
    defaults(&store.*.prefs)
    store.*.recordCount = 0
    store.*.poolUsed = 0
    store.*.generation += 1
    store.*.loaded = true
    const length = pathOf(app, store)
    if length == 0 { return false }
    const path: [*]const u8 = &store.*.path
    var contents: text_io.Contents = undefined
    if text_io.readFile(app.*.allocator, path[0..length], &contents) != text_io.FileStatus.ok { return false }
    const text = contents.bytes[0..contents.length]
    var group: []const u8 = text[0..0]
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        var entry: conf.Entry = undefined
        const kind = conf.parseLine(text[at..end], &entry)
        if kind == conf.GROUP {
            group = entry.group
        } else if kind == conf.ENTRY && entry.key.length > 0 {
            take(store, app.*.allocator, group, entry.key, entry.value)
        }
        at = end + 1
    }
    text_io.freeFile(&contents)
    return true
}

// The room the file's text needs at most: every value escaped twice over.
fn textBound(store: *Store) -> usize {
    var bound: usize = 1024 + SETTING_COUNT * (LINE + 64)
    var index: usize = 0
    while index < store.*.recordCount {
        const record = store.*.records[index]
        bound += record.group.length * 2 + record.key.length + record.value.length * 2 + 16
        index += 1
    }
    return bound
}

// The kept lines of `group`, after one another.
fn appendRecords(store: *Store, group: []const u8, escaped: bool, into: [*]u8, at: usize, capacity: usize) -> usize {
    var length = at
    var index: usize = 0
    while index < store.*.recordCount {
        const record = store.*.records[index]
        if std.text.same(spanText(store, record.group), group) {
            length = std.text.append(into, length, capacity, spanText(store, record.key))
            length = std.text.append(into, length, capacity, " = ")
            if escaped {
                length = appendEscaped(into, length, capacity, spanText(store, record.value))
            } else {
                length = std.text.append(into, length, capacity, spanText(store, record.value))
            }
            length = std.text.appendByte(into, length, capacity, 10)
        }
        index += 1
    }
    return length
}

fn hasRecords(store: *Store, group: []const u8) -> bool {
    var index: usize = 0
    while index < store.*.recordCount {
        if std.text.same(spanText(store, store.*.records[index].group), group) { return true }
        index += 1
    }
    return false
}

fn appendGroupLine(into: [*]u8, at: usize, capacity: usize, group: []const u8) -> usize {
    var length = std.text.append(into, at, capacity, "\n[")
    length = std.text.append(into, length, capacity, group)
    return std.text.append(into, length, capacity, "]\n")
}

// Whether a group is one nothing here knows: its lines are written in a
// group of their own after the known ones.
fn isForeign(group: []const u8) -> bool {
    return group.length > 0 && groupNumber(group) == GROUPS && !std.text.same(group, SHORTCUTS) && !std.text.same(group, STATE)
}

// The whole file: the lines kept from before any group, the settings by
// group (each with the lines of it nothing here knows), the shortcuts,
// the texts, then the groups nothing here knows, in the order they came.
fn render(store: *Store, into: [*]u8, capacity: usize) -> usize {
    var length = std.text.append(into, 0, capacity, "# Nebula's settings. The program writes this file whole: comments are not kept.\n")
    length = appendRecords(store, "", false, into, length, capacity)
    const list = rows()
    var group: usize = 0
    while group < GROUPS {
        length = appendGroupLine(into, length, capacity, GROUP_NAMES[group])
        var index: usize = 0
        while index < SETTING_COUNT {
            if @intCast(usize, list[index].group) == group { length = appendSetting(&store.*.prefs, index, into, length, capacity) }
            index += 1
        }
        length = appendRecords(store, GROUP_NAMES[group], false, into, length, capacity)
        group += 1
    }
    if hasRecords(store, SHORTCUTS) {
        length = appendGroupLine(into, length, capacity, SHORTCUTS)
        length = appendRecords(store, SHORTCUTS, false, into, length, capacity)
    }
    if hasRecords(store, STATE) {
        length = appendGroupLine(into, length, capacity, STATE)
        length = appendRecords(store, STATE, true, into, length, capacity)
    }
    var index: usize = 0
    while index < store.*.recordCount {
        const name = spanText(store, store.*.records[index].group)
        var first = isForeign(name)
        var before: usize = 0
        while first && before < index {
            if std.text.same(spanText(store, store.*.records[before].group), name) { first = false }
            before += 1
        }
        if first {
            length = appendGroupLine(into, length, capacity, name)
            length = appendRecords(store, name, false, into, length, capacity)
        }
        index += 1
    }
    return length
}

// ---------------------------------------------------------------------------
// Loading and saving

// Reads the file again: every setting as it says (its default where it
// says nothing readable), its other lines kept. False when there is no
// file (or no place for one): everything is at its default then.
pub fn load(app: *App) -> bool {
    const store = storeOf(app)
    if store == null { return false }
    return read(app, store.?)
}

// Writes the file whole (into "nebula.conf.new" first, which then takes
// its place), making the folders it goes in; every setting is held to
// what it may be before (as changed() says). False when it could not be
// written (no place for it, a folder that cannot be made, no memory): the
// file is as it was then.
pub fn save(app: *App) -> bool {
    const found = loadedStore(app)
    if found == null { return false }
    const store = found.?
    // (What is written is what the program goes on with.)
    normalize(&store.*.prefs)
    const length = pathOf(app, store)
    if length == 0 { return false }
    const path: [*]u8 = &store.*.path
    if !std.fs.makeParents(path[0..length], 493) { return false }
    const capacity = textBound(store)
    const memory = app.*.allocator.alloc(capacity, 16)
    if memory == null { return false }
    const written = render(store, memory.?, capacity)
    // (Text that fills the room was cut short; the bound leaves room.)
    const saved = written < capacity && std.fs.replaceFile(path, memory.?, written, 420)
    app.*.allocator.free(memory.?, capacity, 16)
    return saved
}

// The preferences, read from the file at the first asking. A part changes
// a field and then says changed(app).
pub fn get(app: *App) -> *Preferences {
    const store = loadedStore(app)
    if store == null {
        defaults(&fallback)
        return &fallback
    }
    return &store.?.*.prefs
}

// The preferences were changed: each is held to what it may be (a number
// to its range, a choice or a text that is none of its kind to its
// default) and the file is written at once. False when it could not be
// written.
pub fn changed(app: *App) -> bool {
    return save(app)
}

// ---------------------------------------------------------------------------
// Texts kept for other parts ([State])

// The text kept as `key`; "" when none is. The slice is good until the
// next change of what is kept (setText, keep, forget, shortcuts.set, a
// load).
pub fn text(app: *App, key: []const u8) -> []const u8 {
    const found = loadedStore(app)
    if found == null { return "" }
    const store = found.?
    const index = find(store, STATE, key)
    if index >= store.*.recordCount { return "" }
    return spanText(store, store.*.records[index].value)
}

// Keeps `value` as `key` ("": keeps nothing for it) and writes the file
// at once (when it changed). `key`: 1 to MAX_KEY bytes, no "=", no
// control character, no blank at either end; `value`: up to MAX_VALUE
// bytes of any kind. False for a key or value that cannot be kept, or
// without memory; true also when the file could not be written (save()
// says that).
pub fn setText(app: *App, key: []const u8, value: []const u8) -> bool {
    if !validKey(key, MAX_KEY) || value.length > MAX_VALUE { return false }
    const found = loadedStore(app)
    if found == null { return false }
    const store = found.?
    const index = find(store, STATE, key)
    if value.length == 0 {
        if index >= store.*.recordCount { return true }
        remove(store, index)
    } else {
        if index < store.*.recordCount && std.text.same(spanText(store, store.*.records[index].value), value) { return true }
        if !put(store, app.*.allocator, STATE, key, value) { return false }
    }
    _ = changed(app)
    return true
}

// ---------------------------------------------------------------------------
// Groups of 'key = value' lines kept for a part that reads them itself
// (app/shortcuts.mlx's [Shortcuts]). Not the groups of the settings, not
// [State]: those are read through get() and text(). Nothing here writes
// the file: the part says changed(app) when it is done.

// Whether lines of `group` may be kept through keep().
fn isOwnGroup(group: []const u8) -> bool {
    if group.length == 0 || group.length > LONG_KEY || groupNumber(group) < GROUPS || std.text.same(group, STATE) { return false }
    for byte in group {
        if byte < 32 || byte == 91 || byte == 93 { return false }
    }
    return true
}

// The value `key` has in `group`, as the file says it; null when the
// group has no such line. Good until the next change of what is kept.
pub fn kept(app: *App, group: []const u8, key: []const u8) -> ?[]const u8 {
    var result: ?[]const u8 = null
    const found = loadedStore(app)
    if found == null { return result }
    const index = find(found.?, group, key)
    if index < found.?.*.recordCount { result = spanText(found.?, found.?.*.records[index].value) }
    return result
}

// `key` in `group` keeps `value`: one line of text with no blanks at its
// ends (it is written as it is). False for what cannot be kept so, and
// without memory.
pub fn keep(app: *App, group: []const u8, key: []const u8, value: []const u8) -> bool {
    if !isOwnGroup(group) || !validKey(key, LONG_KEY) || value.length > MAX_VALUE { return false }
    if value.length > 0 && (value[0] == 32 || value[value.length - 1] == 32 || value[0] == 9 || value[value.length - 1] == 9) { return false }
    for byte in value {
        if byte == 10 || byte == 13 { return false }
    }
    const found = loadedStore(app)
    if found == null { return false }
    return put(found.?, app.*.allocator, group, key, value)
}

// `key`'s line in `group` goes; whether there was one.
pub fn forget(app: *App, group: []const u8, key: []const u8) -> bool {
    const found = loadedStore(app)
    if found == null || !isOwnGroup(group) { return false }
    const index = find(found.?, group, key)
    if index >= found.?.*.recordCount { return false }
    remove(found.?, index)
    return true
}

// Every line of `group` goes.
pub fn forgetGroup(app: *App, group: []const u8) -> void {
    const found = loadedStore(app)
    if found == null || !isOwnGroup(group) { return }
    const store = found.?
    var index = store.*.recordCount
    while index > 0 {
        index -= 1
        if std.text.same(spanText(store, store.*.records[index].group), group) { remove(store, index) }
    }
}

// A number that changes whenever the lines kept as text change (the file
// read again among them): who works something out of them compares it.
pub fn generation(app: *App) -> u64 {
    const found = loadedStore(app)
    if found == null { return 0 }
    return found.?.*.generation
}
