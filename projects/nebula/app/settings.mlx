    Setting.{ .group = CANVAS, .key = "checker_size", .name = "Checkerboard square size", .german = "Größe der Schachbrettfelder", .kind = NUMBER, .offset = @offsetOf(Preferences, "checkerSize"), .low = 2, .high = 128, .initial = 16, .firstWord = 0, .wordCount = 0, .text = "", .check = null },
