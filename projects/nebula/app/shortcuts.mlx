// nebula app: which key does what. Every action and tool has a shortcut
// of its own (state.Action.shortcut, state.Tool.shortcut); the user may
// give it another one, or none. What the user changed is kept in the
// settings file's [Shortcuts] group (app/settings.mlx), an action by its
// key, a tool by "tool:" and its key, "none" for no shortcut at all:
//
//     [Shortcuts]
//     file_new = Ctrl+M
//     tool:brush = P
//     edit_cut = none
//
// Everything that looks a shortcut up (the loop's key handling, the
// menus' labels, the shortcut editor) asks here:
//
//     const shortcut = shortcuts.ofAction(app, action)       // keys.Shortcut
//     if !shortcuts.set(app, "tool:brush", "P") { ... }       // no such key, or no shortcut in the text
//     const other = shortcuts.conflict(app, keys.parse("P"), "tool:brush")    // null: nobody else has it
//     _ = shortcuts.reset(app, "tool:brush")                  // its own again
//
// set, reset and resetAll write the settings file at once.
//
// ofAction and ofTool are asked for every action and every tool at every
// key nobody else took, so they read no text: the shortcuts are worked out
// once into a table (a hash map from the address of the row's key) when
// the settings were read or their kept lines changed (settings.generation),
// and a row the table does not have yet (a registry that grew) at its
// first asking.
const std = @import("std")
const state = @import("./state.mlx")
const keys = @import("./keys.mlx")
const settings = @import("./settings.mlx")
const actions = @import("../actions/registry.mlx")
const tools = @import("../tools/registry.mlx")
const text_io = @import("../io/text.mlx")

pub const App = state.App
pub const Shortcut = keys.Shortcut

// What a tool's key is written after.
const TOOL_PREFIX: []const u8 = "tool:"
// The longest key written: "tool:" and a tool's key, an action's key.
const KEY_ROOM: usize = 128

const Table = struct {
    // The slot comes zeroed: the map is made at the first asking.
    ready: bool
    // The settings' generation the shortcuts were worked out for.
    generation: u64
    // The shortcut in effect, by the address of the row's key (twice it,
    // and one more for a tool: an action and a tool may share the bytes
    // of their keys).
    map: std.AutoHashMap(u64, Shortcut)
    // The key conflict() names for a tool ("tool:brush").
    named: [128]u8
}

fn idOf(key: []const u8, tool: bool) -> u64 {
    const address = @intCast(u64, @intFromPtr(key.pointer))
    return (address << 1) | (if tool { 1 } else { 0 })
}

// The setting's key of a row: an action's own, "tool:" and a tool's, into
// `into` (KEY_ROOM bytes); its length, 0 when it does not fit.
fn settingKey(key: []const u8, tool: bool, into: [*]u8) -> usize {
    const total = key.length + (if tool { TOOL_PREFIX.length } else { 0 })
    if total == 0 || total > KEY_ROOM { return 0 }
    var length: usize = 0
    if tool { length = std.text.append(into, 0, KEY_ROOM, TOOL_PREFIX) }
    return std.text.append(into, length, KEY_ROOM, key)
}

fn isNoneWord(text: []const u8) -> bool {
    return text_io.sameIgnoringCase(std.text.trimmed(text), "none")
}

// The shortcut a row has now: the user's when the settings keep one that
// can be read ("none": none at all), else its own.
fn workOut(app: *App, key: []const u8, tool: bool, own: []const u8) -> Shortcut {
    var room: [128]u8 = undefined
    const bytes: [*]u8 = &room
    const length = settingKey(key, tool, bytes)
    if length > 0 {
        const given = settings.kept(app, settings.SHORTCUTS, bytes[0..length])
        if given != null {
            if isNoneWord(given.?) { return keys.none() }
            const parsed = keys.parse(given.?)
            if !keys.isNone(parsed) { return parsed }
        }
    }
    return keys.parse(own)
}

// The table, worked out again when the kept lines changed; null without
// memory.
fn tableOf(app: *App) -> ?*Table {
    const memory = state.slot(app, state.SLOT_SHORTCUTS, @sizeOf(Table))
    if memory == null { return null }
    const table: *Table = unsafe { @ptrCast(*Table, memory.?) }
    if !table.*.ready {
        table.*.map = std.AutoHashMap(u64, Shortcut).init(app.*.allocator)
        table.*.ready = true
    }
    const now = settings.generation(app)
    if table.*.generation != now {
        table.*.generation = now
        table.*.map.clearRetainingCapacity()
        var index: usize = 0
        const action_count = actions.count()
        while index < action_count {
            const action = actions.at(index)
            if action != null { _ = table.*.map.put(idOf(action.?.*.key, false), workOut(app, action.?.*.key, false, action.?.*.shortcut)) }
            index += 1
        }
        index = 0
        const tool_count = tools.count()
        while index < tool_count {
            const tool = tools.at(index)
            if tool != null { _ = table.*.map.put(idOf(tool.?.*.key, true), workOut(app, tool.?.*.key, true, tool.?.*.shortcut)) }
            index += 1
        }
    }
    return table
}

fn lookUp(app: *App, key: []const u8, tool: bool, own: []const u8) -> Shortcut {
    const table = tableOf(app)
    if table == null { return workOut(app, key, tool, own) }
    const id = idOf(key, tool)
    const found = table.?.*.map.get(id)
    if found != null { return found.? }
    const worked = workOut(app, key, tool, own)
    // (Without memory it is worked out again at the next asking.)
    _ = table.?.*.map.put(id, worked)
    return worked
}

// The shortcut of an action as it is now (keys.isNone: it has none).
pub fn ofAction(app: *App, action: *const state.Action) -> Shortcut {
    return lookUp(app, action.*.key, false, action.*.shortcut)
}

// The shortcut that chooses a tool.
pub fn ofTool(app: *App, tool: *const state.Tool) -> Shortcut {
    return lookUp(app, tool.*.key, true, tool.*.shortcut)
}

// The shortcut a row named by a setting's key ("file_new", "tool:brush")
// has of its own; null when no action or tool has that key.
fn ownOf(key: []const u8) -> ?[]const u8 {
    var result: ?[]const u8 = null
    if std.text.startsWith(key, TOOL_PREFIX) {
        const tool = tools.byKey(key[TOOL_PREFIX.length..key.length])
        if tool != null { result = tool.?.*.shortcut }
    } else {
        const action = actions.byKey(key)
        if action != null { result = action.?.*.shortcut }
    }
    return result
}

fn same(left: Shortcut, right: Shortcut) -> bool {
    return left.modifiers == right.modifiers && left.character == right.character && left.code == right.code
}

// Whether one key press would be both shortcuts (keys.matches: Shift is
// part of a letter's shortcut, but only the way to a mark's).
fn clash(left: Shortcut, right: Shortcut) -> bool {
    if keys.isNone(left) || keys.isNone(right) { return false }
    if left.character != right.character || left.code != right.code { return false }
    const letter = left.character >= 97 && left.character <= 122
    if left.character != 0 && !letter { return (left.modifiers & ~keys.SHIFT) == (right.modifiers & ~keys.SHIFT) }
    return left.modifiers == right.modifiers
}

// The action or tool named `key` ("file_new", "tool:brush") gets the
// shortcut `text` says ("Ctrl+Shift+N"; "none" or "": none at all), kept
// in the settings, which are written at once. The row's own shortcut
// again is no change kept. False when no action or tool has that key or
// the text names no shortcut.
pub fn set(app: *App, key: []const u8, text: []const u8) -> bool {
    const own = ownOf(key)
    if own == null { return false }
    var wanted = keys.none()
    if std.text.trimmed(text).length > 0 && !isNoneWord(text) {
        wanted = keys.parse(text)
        if keys.isNone(wanted) { return false }
    }
    if same(wanted, keys.parse(own.?)) {
        _ = settings.forget(app, settings.SHORTCUTS, key)
    } else {
        var shown: [32]u8 = undefined
        const bytes: [*]u8 = &shown
        var length = keys.format(wanted, bytes)
        if keys.isNone(wanted) { length = std.text.append(bytes, 0, 32, "none") }
        if !settings.keep(app, settings.SHORTCUTS, key, bytes[0..length]) { return false }
    }
    _ = settings.changed(app)
    return true
}

// The action or tool named `key` has its own shortcut again; whether the
// user had given it another (the settings are written then).
pub fn reset(app: *App, key: []const u8) -> bool {
    if !settings.forget(app, settings.SHORTCUTS, key) { return false }
    _ = settings.changed(app)
    return true
}

// Every action and tool has its own shortcut again (also the ones a newer
// version kept).
pub fn resetAll(app: *App) -> void {
    settings.forgetGroup(app, settings.SHORTCUTS)
    _ = settings.changed(app)
}

// The key of an action or tool other than `except` (a setting's key, as
// set() takes it; "": none excepted) that a press of `shortcut` would
// choose now; null when none would. A tool's key is good until the next
// conflict().
pub fn conflict(app: *App, shortcut: Shortcut, except: []const u8) -> ?[]const u8 {
    var result: ?[]const u8 = null
    if keys.isNone(shortcut) { return result }
    var index: usize = 0
    const action_count = actions.count()
    while index < action_count {
        const action = actions.at(index)
        if action != null && !std.text.same(action.?.*.key, except) && clash(ofAction(app, action.?), shortcut) {
            result = action.?.*.key
            return result
        }
        index += 1
    }
    const table = tableOf(app)
    if table == null { return result }
    const bytes: [*]u8 = &table.?.*.named
    index = 0
    const tool_count = tools.count()
    while index < tool_count {
        const tool = tools.at(index)
        if tool != null {
            const length = settingKey(tool.?.*.key, true, bytes)
            if length > 0 && !std.text.same(bytes[0..length], except) && clash(ofTool(app, tool.?), shortcut) {
                result = bytes[0..length]
                return result
            }
        }
        index += 1
    }
    return result
}
