// nebula app: which key does what. Every action and tool has a shortcut
// of its own (state.Action.shortcut, state.Tool.shortcut); the user's
// settings may give it another. Everything that looks a shortcut up (the
// loop's key handling, the menus' labels, the shortcut editor) asks here.
//
// For now: the built-in ones only (the settings are not written yet).
const state = @import("./state.mlx")
const keys = @import("./keys.mlx")

pub const App = state.App

// The shortcut of an action as it is now.
pub fn ofAction(app: *App, action: *const state.Action) -> keys.Shortcut {
    return keys.parse(action.*.shortcut)
}

// The shortcut that chooses a tool.
pub fn ofTool(app: *App, tool: *const state.Tool) -> keys.Shortcut {
    return keys.parse(tool.*.shortcut)
}
