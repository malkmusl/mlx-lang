// nebula app: what the program asks of the system it runs on, in one
// place: the window (std.ui.host: a Wayland window on Linux, the same on
// brixOS's native transport) or, for tests and scripted runs, nothing at
// all: a Shell with no host answers from what a script set (the size, the
// modifiers held, what a key types, the clock, a clipboard of its own),
// so the whole program runs and draws without a window
// (app/script.mlx plays such a run).
//
// Everything else of the program talks to the Shell, never to
// std.ui.host itself.
const std = @import("std")
const host_module = @import("std.ui.host")
const ui = @import("std.ui")

pub const Host = host_module.Host

pub const Shell = struct {
    host: ?*Host
    environment: [*][*]const u8
    // Without a host: what a script set.
    width: i32
    height: i32
    modifiers: u32
    typed: [16]u8
    typedLength: usize
    plain: [16]u8
    plainLength: usize
    wheelPixels: i32
    clock: usize
    lightness: i32
    // A frame is wanted; the run is over.
    wantFrame: bool
    running: bool
    // The clipboard a headless run has (bytes of the type last set).
    clip: std.ArrayList(u8)
    clipType: [64]u8
    clipTypeLength: usize
}

pub fn init(shell: *Shell, allocator: std.allocator.Allocator) -> void {
    shell.*.host = null
    unsafe { shell.*.environment = @ptrFromInt([*][*]const u8, 16) }
    shell.*.width = 1280
    shell.*.height = 800
    shell.*.modifiers = 0
    shell.*.typedLength = 0
    shell.*.plainLength = 0
    shell.*.wheelPixels = 0
    shell.*.clock = 1000
    shell.*.lightness = 0
    shell.*.wantFrame = true
    shell.*.running = true
    shell.*.clip = std.ArrayList(u8).init(allocator)
    shell.*.clipTypeLength = 0
}

pub fn isHeadless(shell: *Shell) -> bool { return shell.*.host == null }

pub fn width(shell: *Shell) -> i32 {
    if shell.*.host != null { return host_module.width(shell.*.host.?) }
    return shell.*.width
}

pub fn height(shell: *Shell) -> i32 {
    if shell.*.host != null { return host_module.height(shell.*.host.?) }
    return shell.*.height
}

// The next frame is wanted.
pub fn redraw(shell: *Shell) -> void {
    if shell.*.host != null { host_module.redraw(shell.*.host.?) }
    shell.*.wantFrame = true
}

// What the frame being drawn changed (std.ui.host.damage).
pub fn damage(shell: *Shell, area: ui.Rect) -> void {
    if shell.*.host != null { host_module.damage(shell.*.host.?, area.x, area.y, area.width, area.height) }
}

// The canvas a draw gets holds the frame before (std.ui.host.kept).
pub fn kept(shell: *Shell) -> bool {
    if shell.*.host != null { return host_module.kept(shell.*.host.?) }
    return false
}

// The frame being drawn is the one before: nothing goes out.
pub fn unchanged(shell: *Shell) -> void {
    if shell.*.host != null { host_module.unchanged(shell.*.host.?) }
}

// Milliseconds, growing (a script's clock without a host).
pub fn now(shell: *Shell) -> usize {
    if shell.*.host != null { return std.time.milliseconds() }
    return shell.*.clock
}

pub fn modifiers(shell: *Shell) -> u32 {
    if shell.*.host != null { return host_module.modifiers(shell.*.host.?) }
    return shell.*.modifiers
}

// What the key of the event being handled types, and what it would type
// without Control and Alt.
pub fn typed(shell: *Shell) -> []const u8 {
    if shell.*.host != null { return host_module.typed(shell.*.host.?) }
    const bytes: [*]const u8 = &shell.*.typed
    return bytes[0..shell.*.typedLength]
}

pub fn plainTyped(shell: *Shell) -> []const u8 {
    if shell.*.host != null { return host_module.plainTyped(shell.*.host.?) }
    const bytes: [*]const u8 = &shell.*.plain
    return bytes[0..shell.*.plainLength]
}

pub fn wheelPixels(shell: *Shell) -> i32 {
    if shell.*.host != null { return host_module.wheelPixels(shell.*.host.?) }
    return shell.*.wheelPixels
}

// 0 (the desktop is dark) to 1024 (light).
pub fn lightness(shell: *Shell) -> i32 {
    if shell.*.host != null { return host_module.lightness(shell.*.host.?) }
    return shell.*.lightness
}

pub fn setTitle(shell: *Shell, title: []const u8) -> void {
    if shell.*.host != null { host_module.setTitle(shell.*.host.?, title) }
}

// EVENT_TICK every `milliseconds` (0: none).
pub fn setTick(shell: *Shell, milliseconds: usize) -> void {
    if shell.*.host != null { host_module.setTick(shell.*.host.?, milliseconds) }
}

pub fn setFullscreen(shell: *Shell, on: bool) -> void {
    if shell.*.host != null { host_module.setFullscreen(shell.*.host.?, on) }
}

pub fn quit(shell: *Shell) -> void {
    shell.*.running = false
    if shell.*.host != null { host_module.quit(shell.*.host.?) }
}

pub fn environmentValue(shell: *Shell, name: []const u8) -> []const u8 {
    const value = std.process.environmentFrom(shell.*.environment, name)
    if value == null { return "" }
    return std.string.asSlice(value.?)
}

// The user's home.
pub fn home(shell: *Shell) -> []const u8 {
    if shell.*.host != null { return host_module.home(shell.*.host.?) }
    const value = environmentValue(shell, "HOME")
    return if value.length > 0 { value } else { "/" }
}

// The clipboard: `data` as `mime` (false when it could not be set).
pub fn setClipboard(shell: *Shell, mime: []const u8, data: []const u8) -> bool {
    if shell.*.host != null {
        host_module.beginClipboard(shell.*.host.?)
        if !host_module.addClipboard(shell.*.host.?, mime, data) { return false }
        return host_module.publishClipboard(shell.*.host.?)
    }
    shell.*.clip.clearRetainingCapacity()
    if !shell.*.clip.appendSlice(data) { return false }
    var length: usize = 0
    while length < mime.length && length < 64 {
        shell.*.clipType[length] = mime[length]
        length += 1
    }
    shell.*.clipTypeLength = length
    return true
}

// The clipboard's bytes as `mime` ("" when it has none of that type);
// valid until the next reading.
pub fn clipboard(shell: *Shell, mime: []const u8) -> []const u8 {
    if shell.*.host != null { return host_module.readClipboard(shell.*.host.?, mime) }
    const bytes: [*]const u8 = &shell.*.clipType
    if !std.text.same(bytes[0..shell.*.clipTypeLength], mime) { return "" }
    return shell.*.clip.items()
}

pub fn clipboardHas(shell: *Shell, mime: []const u8) -> bool {
    if shell.*.host != null { return host_module.clipboardHas(shell.*.host.?, mime) }
    const bytes: [*]const u8 = &shell.*.clipType
    return shell.*.clip.count() > 0 && std.text.same(bytes[0..shell.*.clipTypeLength], mime)
}

// A line for whoever reads the program's log.
pub fn log(shell: *Shell, line: []const u8) -> void {
    _ = std.io.writeAll(std.io.stdout(), line)
    _ = std.io.writeAll(std.io.stdout(), "\n")
}
