// nebula app: the brush in use: one brush.Settings (brush/types.mlx) in
// heap memory that the brush tools paint with and the toolbar's sliders,
// the brush editor and the presets change. app.brush points at it; it is
// made, as a plain round brush, at the first asking.
//
//     const brush = brushes.current(app)      // never by value: about 20 KiB
//     brushes.setSize(app, 24.0)
//     brushes.grow(app, true)                 // the ] key
//     brushes.fade(app, false)                // the I key
//
// Without memory for it every caller gets one record of this module's
// own (a round brush too), so there is always a brush to read and paint
// with.
//
// (The list of presets and choosing one of them come with brush/presets.)
const std = @import("std")
const state = @import("./state.mlx")
const api = @import("./api.mlx")
const types = @import("../brush/types.mlx")

pub const App = state.App
pub const Settings = types.Settings

// The brush when the heap had no room for one (made a round brush at its
// first use).
var fallback: Settings = undefined
var fallbackMade: bool = false

// The brush in use (never by value: the record is large).
pub fn current(app: *App) -> *Settings {
    if app.*.brush == 0 {
        const memory = app.*.allocator.alloc(@sizeOf(Settings), 16)
        if memory != null {
            const made: *Settings = unsafe { @ptrCast(*Settings, memory.?) }
            types.defaults(made)
            app.*.brush = @intFromPtr(made)
        }
    }
    if app.*.brush == 0 {
        if !fallbackMade {
            types.defaults(&fallback)
            fallbackMade = true
        }
        return &fallback
    }
    unsafe { return @ptrFromInt(*Settings, app.*.brush) }
}

// The brush in use becomes a copy of `settings` (a preset chosen).
pub fn use(app: *App, settings: *const Settings) -> void {
    // (Byte by byte: assigning a record of this size would go through
    // the value arena.)
    unsafe { std.mem.copy(@ptrCast([*]u8, current(app)), @ptrCast([*]const u8, settings), @sizeOf(Settings)) }
    types.sanitize(current(app))
    api.redraw(app)
}

// Its size in pixels, held to what a brush can be.
pub fn setSize(app: *App, size: f64) -> void {
    const brush = current(app)
    var held = size
    if !(held >= types.SMALLEST_SIZE) { held = types.SMALLEST_SIZE }
    if held > types.LARGEST_SIZE { held = types.LARGEST_SIZE }
    brush.*.size = held
    api.redraw(app)
}

// Its opacity, 0 to 1, held there (what is no number is 0).
pub fn setOpacity(app: *App, opacity: f64) -> void {
    current(app).*.opacity = if !(opacity > 0.0) { 0.0 } else if opacity > 1.0 { 1.0 } else { opacity }
    api.redraw(app)
}

// Its flow, 0 to 1, held there (what is no number is 0).
pub fn setFlow(app: *App, flow: f64) -> void {
    current(app).*.flow = if !(flow > 0.0) { 0.0 } else if flow > 1.0 { 1.0 } else { flow }
    api.redraw(app)
}

// A step larger or smaller, as the bracket keys do it: by a tenth, at
// least a pixel; smaller stops at a pixel (a brush already below one, set
// so by hand, stays as it is).
pub fn grow(app: *App, larger: bool) -> void {
    const size = current(app).*.size
    var step = size / 10.0
    if step < 1.0 { step = 1.0 }
    if larger {
        setSize(app, size + step)
        return
    }
    if size <= 1.0 { return }
    setSize(app, if size - step < 1.0 { 1.0 } else { size - step })
}

// A step more or less opaque, as the I and O keys do it: a tenth of the
// whole way, onto the tenths (0.45 goes to 0.4 or 0.5).
pub fn fade(app: *App, more: bool) -> void {
    const tenths = current(app).*.opacity * 10.0
    var next = if more { @floor(tenths + 0.001) + 1.0 } else { @ceil(tenths - 0.001) - 1.0 }
    if next < 0.0 { next = 0.0 }
    if next > 10.0 { next = 10.0 }
    setOpacity(app, next / 10.0)
}
