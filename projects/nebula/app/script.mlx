// nebula app: the program run by a script, without a window: every line
// of the script is an input or a look at what came of it, the frames are
// drawn into memory. Checks use it (tools/check_nebula.sh) and so can
// anyone who wants the same thing done to many pictures:
//
//     nebula --script FILE
//
// A line a step; '#' starts a comment. The window:
//
//     size W H            the window's size (before the first frame)
//     wait MS             time passes (a frame is drawn if one is due)
//     shot FILE           draws a frame and saves it as a PNG picture
//     german              the program speaks German from here on
//
// Input, in the window's pixels:
//
//     pointer X Y         the pointer moves there
//     press [left|right|middle]     a button goes down (left when not said)
//     release [left|right|middle]
//     click X Y           move there, press and release the left button
//     drag X0 Y0 X1 Y1 [STEPS]   press at the first place, move to the
//                         second in STEPS motions (16), release
//     wheel N             the wheel turns N notches (below zero: up)
//     key NAME            a key or shortcut pressed and let go
//                         ("B", "Ctrl+Z", "Escape", "F5": app/keys.mlx)
//     down NAME / up NAME a key held and let go ("Space", "Shift")
//     type TEXT           TEXT typed, a key a character
//
// The program:
//
//     new W H [RRGGBB]    a new image (its ground that colour; none:
//                         transparent)
//     action KEY          runs an action by its key
//     tool KEY            makes a tool the one in use
//     color RRGGBB        the foreground colour
//     background RRGGBB   the background colour
//
// Looking:
//
//     expect X Y AARRGGBB the image shows that pixel at (X, Y) of the
//                         image (what all layers together show)
//     expect-window X Y RRGGBB   the window's frame has that colour there
//     expect-note TEXT    the status bar says something containing TEXT
//     say TEXT            a line on the output
//
// The run ends at the script's end or at `quit`. A failed `expect`, a
// line that cannot be read or a file that cannot be written ends it with
// a message naming the line; run() says how it ended.
const std = @import("std")
const turns_module = @import("std.turns")
const png = @import("std.png")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const state = @import("./state.mlx")
const api = @import("./api.mlx")
const keys = @import("./keys.mlx")
const loop = @import("./loop.mlx")
const documents = @import("./documents.mlx")
const shell_module = @import("./shell.mlx")
const tools = @import("../tools/registry.mlx")
const device_module = @import("../core/device.mlx")
const render = @import("../core/render.mlx")

pub const App = state.App
pub const Canvas = state.Canvas

const Player = struct {
    app: *App
    canvas: Canvas
    // The frame's pixels and how many words they have room for.
    capacity: usize
    line: usize
    failed: bool
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

// The next word of `text` from `at.*` on (empty: none); `at.*` moves past
// it.
fn word(text: []const u8, at: *usize) -> []const u8 {
    var start = at.*
    while start < text.length && isSpace(text[start]) { start += 1 }
    var end = start
    while end < text.length && !isSpace(text[end]) { end += 1 }
    at.* = end
    return text[start..end]
}

// What is left of the line after the words read, without the blanks
// around it.
fn rest(text: []const u8, at: usize) -> []const u8 {
    var start = at
    while start < text.length && isSpace(text[start]) { start += 1 }
    var end = text.length
    while end > start && isSpace(text[end - 1]) { end -= 1 }
    return text[start..end]
}

fn number(text: []const u8, into: *i32) -> bool {
    if text.length == 0 { return false }
    var index: usize = 0
    var negative = false
    if text[0] == 45 {
        negative = true
        index = 1
    }
    if index >= text.length { return false }
    var value: i32 = 0
    while index < text.length {
        if text[index] < 48 || text[index] > 57 || value > 100000000 { return false }
        value = value * 10 + @intCast(i32, text[index] - 48)
        index += 1
    }
    into.* = if negative { -value } else { value }
    return true
}

fn hex(text: []const u8, into: *u32) -> bool {
    if text.length != 6 && text.length != 8 { return false }
    var value: u32 = 0
    for byte in text {
        var digit: u32 = 0
        if byte >= 48 && byte <= 57 {
            digit = @intCast(u32, byte - 48)
        } else if byte >= 65 && byte <= 70 {
            digit = @intCast(u32, byte - 55)
        } else if byte >= 97 && byte <= 102 {
            digit = @intCast(u32, byte - 87)
        } else {
            return false
        }
        value = (value << 4) | digit
    }
    into.* = if text.length == 6 { value | 0xFF000000 } else { value }
    return true
}

fn fail(player: *Player, what: []const u8, detail: []const u8) -> void {
    var text: [300]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 300, "nebula: script line ")
    length = std.text.appendUnsigned(bytes, length, 300, player.*.line)
    length = std.text.append(bytes, length, 300, ": ")
    length = std.text.append(bytes, length, 300, what)
    length = std.text.append(bytes, length, 300, detail)
    _ = std.io.eprintln(bytes[0..length])
    player.*.failed = true
}

// The frame's memory for the window's size now.
fn fitCanvas(player: *Player) -> bool {
    const shell = player.*.app.*.shell
    const width = @intCast(usize, shell_module.width(shell))
    const height = @intCast(usize, shell_module.height(shell))
    if width * height > player.*.capacity {
        const allocator = player.*.app.*.allocator
        if player.*.capacity > 0 { unsafe { allocator.free(@ptrCast([*]u8, player.*.canvas.pixels), player.*.capacity * 4, 16) } }
        player.*.capacity = 0
        const memory = allocator.alloc(width * height * 4, 16)
        if memory == null { return false }
        unsafe { player.*.canvas.pixels = @ptrCast([*]u32, memory.?) }
        player.*.capacity = width * height
    }
    player.*.canvas.width = width
    player.*.canvas.height = height
    player.*.canvas.stride = width
    player.*.canvas.swapRedBlue = false
    player.*.canvas.device = 0
    player.*.canvas.opacity = 255
    return true
}

// Draws frames while the program wants one (a few: an animation must not
// hold the script).
fn settle(player: *Player) -> void {
    const shell = player.*.app.*.shell
    var rounds: usize = 0
    while shell.*.wantFrame && rounds < 4 {
        if !fitCanvas(player) { return }
        loop.frame(player.*.app, &player.*.canvas)
        rounds += 1
    }
}

fn send(player: *Player, kind: u32, a: u32, b: i32) -> void {
    loop.event(player.*.app, kind, a, b)
    settle(player)
}

fn buttonOf(name: []const u8) -> u32 {
    if std.text.same(name, "right") { return ui_app.BUTTON_RIGHT }
    if std.text.same(name, "middle") { return ui_app.BUTTON_MIDDLE }
    return ui_app.BUTTON_LEFT
}

// A key by its name: its code, what it types, and what its modifiers are.
const Key = struct {
    code: u32
    modifiers: u32
    character: u8
}

// Key codes of the letters a-z (a US keyboard's rows).
const LETTER_CODES = [26]u32{ 30, 48, 46, 32, 18, 33, 34, 35, 23, 36, 37, 38, 50, 49, 24, 25, 16, 19, 31, 20, 22, 47, 17, 45, 21, 44 }

fn keyOf(name: []const u8, into: *Key) -> bool {
    into.*.modifiers = 0
    into.*.character = 0
    into.*.code = 0
    if std.text.same(name, "Shift") {
        into.*.code = keys.LEFT_SHIFT
        return true
    }
    if std.text.same(name, "Ctrl") || std.text.same(name, "Control") {
        into.*.code = keys.LEFT_CONTROL
        return true
    }
    if std.text.same(name, "Alt") {
        into.*.code = keys.LEFT_ALT
        return true
    }
    const shortcut = keys.parse(name)
    if keys.isNone(shortcut) { return false }
    into.*.modifiers = shortcut.modifiers
    if shortcut.character != 0 {
        into.*.character = shortcut.character
        const c = shortcut.character
        if c >= 97 && c <= 122 {
            into.*.code = LETTER_CODES[@intCast(usize, c - 97)]
        } else if c >= 49 && c <= 57 {
            into.*.code = keys.DIGIT_1 + @intCast(u32, c - 49)
        } else if c == 48 {
            into.*.code = keys.DIGIT_0
        } else if c == 91 {
            into.*.code = keys.LEFT_BRACE
        } else if c == 93 {
            into.*.code = keys.RIGHT_BRACE
        } else if c == 45 {
            into.*.code = keys.MINUS
        } else if c == 61 || c == 43 {
            into.*.code = keys.EQUAL
        } else {
            // A mark with no place of its own here: matched by what it
            // types.
            into.*.code = 0
        }
        return true
    }
    into.*.code = shortcut.code
    if shortcut.code == keys.SPACE { into.*.character = 32 }
    return true
}

// The shell's "what the key types" for a key (`shifted`: with Shift).
fn setTyped(player: *Player, key: *const Key, modifiers: u32) -> void {
    const shell = player.*.app.*.shell
    shell.*.typedLength = 0
    shell.*.plainLength = 0
    if key.*.character == 0 { return }
    var typed = key.*.character
    if modifiers & keys.SHIFT != 0 && typed >= 97 && typed <= 122 { typed -= 32 }
    shell.*.plain[0] = typed
    shell.*.plainLength = 1
    if modifiers & (keys.CONTROL | keys.ALT) == 0 {
        shell.*.typed[0] = typed
        shell.*.typedLength = 1
    }
}

fn keyDown(player: *Player, key: *const Key) -> void {
    const shell = player.*.app.*.shell
    const held = keys.modifierOf(key.*.code)
    shell.*.modifiers |= held | key.*.modifiers
    setTyped(player, key, shell.*.modifiers)
    send(player, ui_app.EVENT_KEY, key.*.code, 1)
}

fn keyUp(player: *Player, key: *const Key) -> void {
    const shell = player.*.app.*.shell
    setTyped(player, key, shell.*.modifiers)
    send(player, ui_app.EVENT_KEY, key.*.code, 0)
    shell.*.modifiers &= ~(keys.modifierOf(key.*.code) | key.*.modifiers)
    shell.*.typedLength = 0
    shell.*.plainLength = 0
}

fn pointerTo(player: *Player, x: i32, y: i32) -> void {
    send(player, ui_app.EVENT_MOTION, @bitCast(u32, x), y)
}

fn shot(player: *Player, path: []const u8) -> void {
    const app = player.*.app
    app.*.shell.*.wantFrame = true
    app.*.fullRedraw = true
    settle(player)
    var name: [1024]u8 = undefined
    const bytes: [*]u8 = &name
    if path.length == 0 || path.length >= 1023 {
        fail(player, "shot needs a file name", "")
        return
    }
    const terminated = std.text.zeroTerminated(bytes, 1024, path)
    if !png.saveFile(terminated, player.*.canvas.pixels, player.*.canvas.width, player.*.canvas.height, player.*.canvas.stride, false, app.*.allocator) {
        fail(player, "the picture could not be written: ", path)
    }
}

fn step(player: *Player, line: []const u8) -> bool {
    const app = player.*.app
    const shell = app.*.shell
    var at: usize = 0
    const command = word(line, &at)
    if command.length == 0 || command[0] == 35 { return true }
    var a: i32 = 0
    var b: i32 = 0
    var c: i32 = 0
    var d: i32 = 0
    if std.text.same(command, "size") {
        if !number(word(line, &at), &a) || !number(word(line, &at), &b) || a < 64 || b < 64 || a > 8192 || b > 8192 {
            fail(player, "size needs a width and a height", "")
            return false
        }
        shell.*.width = a
        shell.*.height = b
        send(player, ui_app.EVENT_CONFIGURED, @intCast(u32, a), b)
    } else if std.text.same(command, "wait") {
        if !number(word(line, &at), &a) || a < 0 {
            fail(player, "wait needs milliseconds", "")
            return false
        }
        shell.*.clock += @intCast(usize, a)
        if app.*.ticking { send(player, ui_app.EVENT_TICK, 0, 0) }
        settle(player)
    } else if std.text.same(command, "shot") {
        shot(player, rest(line, at))
    } else if std.text.same(command, "german") {
        app.*.german = true
        api.redraw(app)
    } else if std.text.same(command, "pointer") {
        if !number(word(line, &at), &a) || !number(word(line, &at), &b) {
            fail(player, "pointer needs a place", "")
            return false
        }
        pointerTo(player, a, b)
    } else if std.text.same(command, "press") {
        send(player, ui_app.EVENT_BUTTON, buttonOf(word(line, &at)), 1)
    } else if std.text.same(command, "release") {
        send(player, ui_app.EVENT_BUTTON, buttonOf(word(line, &at)), 0)
    } else if std.text.same(command, "click") {
        if !number(word(line, &at), &a) || !number(word(line, &at), &b) {
            fail(player, "click needs a place", "")
            return false
        }
        pointerTo(player, a, b)
        send(player, ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 1)
        shell.*.clock += 30
        send(player, ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 0)
        shell.*.clock += 30
    } else if std.text.same(command, "drag") {
        if !number(word(line, &at), &a) || !number(word(line, &at), &b) || !number(word(line, &at), &c) || !number(word(line, &at), &d) {
            fail(player, "drag needs two places", "")
            return false
        }
        var steps: i32 = 16
        _ = number(word(line, &at), &steps)
        if steps < 1 { steps = 1 }
        pointerTo(player, a, b)
        send(player, ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 1)
        var index: i32 = 1
        while index <= steps {
            shell.*.clock += 8
            pointerTo(player, a + (c - a) * index / steps, b + (d - b) * index / steps)
            index += 1
        }
        send(player, ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 0)
        shell.*.clock += 30
    } else if std.text.same(command, "wheel") {
        if !number(word(line, &at), &a) || a == 0 {
            fail(player, "wheel needs a number of notches", "")
            return false
        }
        var notches = if a < 0 { -a } else { a }
        while notches > 0 {
            shell.*.wheelPixels = if a < 0 { -15 } else { 15 }
            send(player, ui_app.EVENT_WHEEL, 0, if a < 0 { -1 } else { 1 })
            notches -= 1
        }
    } else if std.text.same(command, "key") || std.text.same(command, "down") || std.text.same(command, "up") {
        var key: Key = undefined
        if !keyOf(word(line, &at), &key) {
            fail(player, "this key is not known: ", rest(line, 0))
            return false
        }
        if !std.text.same(command, "up") { keyDown(player, &key) }
        if !std.text.same(command, "down") { keyUp(player, &key) }
    } else if std.text.same(command, "type") {
        for byte in rest(line, at) {
            var key = Key.{ .code = 0, .modifiers = 0, .character = byte }
            var name: [1]u8 = [1]u8{ byte }
            var named: Key = undefined
            if keyOf(name[0..], &named) { key.code = named.code }
            // A capital is its letter with Shift.
            if byte >= 65 && byte <= 90 {
                key.character = byte + 32
                key.modifiers = keys.SHIFT
            }
            keyDown(player, &key)
            keyUp(player, &key)
        }
    } else if std.text.same(command, "new") {
        if !number(word(line, &at), &a) || !number(word(line, &at), &b) {
            fail(player, "new needs a width and a height", "")
            return false
        }
        var ground: u32 = 0
        _ = hex(word(line, &at), &ground)
        if documents.create(app, a, b, 72.0, ground) == null {
            fail(player, "the image could not be made", "")
            return false
        }
        settle(player)
    } else if std.text.same(command, "action") {
        const key = word(line, &at)
        if !api.run(app, key) {
            fail(player, "this action is not there or cannot run now: ", key)
            return false
        }
        settle(player)
    } else if std.text.same(command, "tool") {
        const tool = tools.byKey(word(line, &at))
        if tool == null {
            fail(player, "this tool is not known: ", rest(line, 0))
            return false
        }
        api.setTool(app, tool.?.*.id)
        settle(player)
    } else if std.text.same(command, "color") || std.text.same(command, "background") {
        var color: u32 = 0
        if !hex(word(line, &at), &color) {
            fail(player, "a colour is six or eight hexadecimal digits", "")
            return false
        }
        if std.text.same(command, "color") { api.setForeground(app, color) } else { api.setBackground(app, color) }
        settle(player)
    } else if std.text.same(command, "expect") {
        var wanted: u32 = 0
        if !number(word(line, &at), &a) || !number(word(line, &at), &b) || !hex(word(line, &at), &wanted) {
            fail(player, "expect needs a place and a colour", "")
            return false
        }
        const image = api.image(app)
        if image == null {
            fail(player, "there is no image to look at", "")
            return false
        }
        _ = render.update(image.?)
        const found = device_module.pixel(image.?.*.projection, a, b)
        if found != wanted {
            var text: [16]u8 = undefined
            const bytes: [*]u8 = &text
            var length: usize = 0
            var shift: u32 = 32
            while shift > 0 {
                shift -= 4
                const digit = @intCast(u8, (found >> @intCast(u5, shift)) & 15)
                length = std.text.appendByte(bytes, length, 16, if digit < 10 { 48 + digit } else { 55 + digit })
            }
            fail(player, "the image shows another pixel there: ", bytes[0..length])
            return false
        }
    } else if std.text.same(command, "expect-window") {
        var wanted: u32 = 0
        if !number(word(line, &at), &a) || !number(word(line, &at), &b) || !hex(word(line, &at), &wanted) {
            fail(player, "expect-window needs a place and a colour", "")
            return false
        }
        shell.*.wantFrame = true
        settle(player)
        if a < 0 || b < 0 || @intCast(usize, a) >= player.*.canvas.width || @intCast(usize, b) >= player.*.canvas.height {
            fail(player, "that place is not in the window", "")
            return false
        }
        const found = player.*.canvas.pixels[@intCast(usize, b) * player.*.canvas.stride + @intCast(usize, a)] | 0xFF000000
        if found != (wanted | 0xFF000000) {
            fail(player, "the window shows another colour there", "")
            return false
        }
    } else if std.text.same(command, "expect-note") {
        if !std.text.contains(api.noteOf(app), rest(line, at)) {
            fail(player, "the status bar says something else: ", api.noteOf(app))
            return false
        }
    } else if std.text.same(command, "say") {
        _ = std.io.println(rest(line, at))
    } else if std.text.same(command, "quit") {
        shell.*.running = false
    } else {
        fail(player, "this is no step: ", command)
        return false
    }
    return !player.*.failed
}

// Plays `text` on `app` (which has no window). True when every step went
// well.
pub fn run(app: *App, text: []const u8) -> bool {
    const memory = app.*.allocator.alloc(@sizeOf(Player), 16)
    if memory == null { return false }
    const player: *Player = unsafe { @ptrCast(*Player, memory.?) }
    player.*.app = app
    player.*.capacity = 0
    player.*.line = 0
    player.*.failed = false
    unsafe { player.*.canvas.pixels = @ptrFromInt([*]u32, 16) }
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    settle(player)
    var at: usize = 0
    while at < text.length && app.*.shell.*.running && !player.*.failed {
        // What a step leaves in the value arena goes at the next.
        turns_module.turn(&turns)
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        player.*.line += 1
        if !step(player, text[at..end]) { break }
        at = end + 1
    }
    return !player.*.failed
}
