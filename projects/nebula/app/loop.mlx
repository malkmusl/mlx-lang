// nebula app: a frame and an event, the same whether a window's host
// calls them (main.mlx) or a script without a window does
// (app/script.mlx).
//
// A frame: the window's parts are laid out, the canvas drawn, the tool's
// marks over it, the bars and dockers around it, the dialogs over all.
// An event goes to whoever it is for, in this order: an open dialog; a
// text being typed into; the canvas when the pointer is on it (the tool
// in use gets places on the image: state.Input) or holds it since a
// press; the widgets; and a key that nobody took is looked up among the
// shortcuts of the actions and the tools.
//
// Until tools for it exist the canvas itself answers the wheel (zoom at
// the pointer) and the middle button or the space bar with the left one
// (the hand that moves the view).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const state = @import("./state.mlx")
const api = @import("./api.mlx")
const keys = @import("./keys.mlx")
const shell_module = @import("./shell.mlx")
const chrome = @import("../ui/chrome.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const viewport = @import("../ui/viewport.mlx")
const tools = @import("../tools/registry.mlx")
const actions = @import("../actions/registry.mlx")

pub const App = state.App
pub const Canvas = state.Canvas

// A second press within this many milliseconds and pixels of the first
// is a double click.
const DOUBLE_CLICK: usize = 400
const DOUBLE_REACH: i32 = 4

// The hand that drags the view (the middle button, or the space bar and
// the left one): where the pointer was at its last motion.
var panning: bool = false
var panX: i32 = 0
var panY: i32 = 0

pub fn canvasId() -> u64 { return view.id("nebula.canvas") }

// The fonts once, and the theme for how light the desktop is now.
fn prepare(app: *App) -> void {
    if !app.*.fontsLoaded {
        const allocator = app.*.allocator
        const factor = @intCast(u32, app.*.scale)
        _ = text_module.loadText(state.titleOf(app), 15 * factor, allocator)
        _ = text_module.loadText(state.bodyOf(app), 13 * factor, allocator)
        _ = text_module.loadText(state.smallOf(app), 12 * factor, allocator)
        _ = text_module.loadMonoText(state.monoOf(app), 12 * factor, allocator)
        app.*.fontsLoaded = true
        app.*.theme = theme_module.scaled(theme_module.dark(), app.*.scale)
        view.init(state.uiOf(app), state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app))
        app.*.lightness = -1
    }
    const lightness = shell_module.lightness(app.*.shell)
    if lightness != app.*.lightness {
        app.*.lightness = lightness
        app.*.theme = theme_module.scaled(theme_module.plain(lightness), app.*.scale)
    }
}

fn pass(app: *App, canvas: *Canvas) -> bool {
    prepare(app)
    const widgets = state.uiOf(app)
    widgets.*.time = @intCast(u64, app.*.time)
    view.begin(widgets, canvas)
    chrome.layOut(app, shell_module.width(app.*.shell), shell_module.height(app.*.shell))
    // The canvas area takes the pointer where nothing drawn later lies
    // over it.
    view.region(widgets, canvasId(), app.*.canvasArea)
    canvasview.draw(app, canvas, app.*.canvasArea)
    const tool = api.tool(app)
    if tool != null && tool.?.*.overlay != null && api.document(app) != null { tool.?.*.overlay.?(app, canvas) }
    chrome.draw(app, canvas)
    var index: usize = 0
    while index < app.*.dialogCount {
        // A dialog takes every press: what is under it gets none.
        view.region(widgets, view.idOf(view.id("nebula.dialog"), index), app.*.window)
        app.*.dialogs[index].draw(app, app.*.window)
        index += 1
    }
    return view.end(widgets)
}

// Draws the window into `canvas`.
pub fn frame(app: *App, canvas: *Canvas) -> void {
    app.*.time = shell_module.now(app.*.shell)
    app.*.shell.*.wantFrame = false
    if pass(app, canvas) { shell_module.redraw(app.*.shell) }
    app.*.fullRedraw = false
    app.*.canvasDirty = ui.rect(0, 0, 0, 0)
}

// Lays the window out without drawing, so that a press meets the widgets
// where the program's state puts them now.
fn layOut(app: *App) -> void {
    var nowhere = view.layoutCanvas()
    _ = pass(app, &nowhere)
}

fn buttonBit(button: u32) -> u32 {
    if button == ui_app.BUTTON_LEFT { return state.BUTTONS_LEFT }
    if button == ui_app.BUTTON_RIGHT { return state.BUTTONS_RIGHT }
    if button == ui_app.BUTTON_MIDDLE { return state.BUTTONS_MIDDLE }
    return 0
}

fn inputNow(app: *App, button: u32) -> state.Input {
    var input: state.Input = undefined
    canvasview.inputAt(app, api.document(app).?, app.*.pointerX, app.*.pointerY, &input)
    input.button = button
    input.time = @floatFromInt(f64, shell_module.now(app.*.shell))
    input.clicks = app.*.clicks
    return input
}

fn overCanvas(app: *App) -> bool {
    return app.*.dialogCount == 0 && api.document(app) != null && state.uiOf(app).*.hover == canvasId()
}

fn onPress(app: *App, button: u32) -> void {
    const widgets = state.uiOf(app)
    const now = shell_module.now(app.*.shell)
    const near = app.*.pointerX - app.*.pressX <= DOUBLE_REACH && app.*.pressX - app.*.pointerX <= DOUBLE_REACH && app.*.pointerY - app.*.pressY <= DOUBLE_REACH && app.*.pressY - app.*.pointerY <= DOUBLE_REACH
    app.*.clicks = if near && now >= app.*.pressTime && now - app.*.pressTime < DOUBLE_CLICK && app.*.clicks == 1 { 2 } else { 1 }
    app.*.pressTime = now
    app.*.pressX = app.*.pointerX
    app.*.pressY = app.*.pointerY
    layOut(app)
    _ = view.pointerMove(widgets, app.*.pointerX, app.*.pointerY)
    if overCanvas(app) && !app.*.canvasGrab {
        app.*.canvasGrab = true
        app.*.grabButton = button
        if button == ui_app.BUTTON_MIDDLE || (button == ui_app.BUTTON_LEFT && app.*.spaceHeld) {
            panning = true
            panX = app.*.pointerX
            panY = app.*.pointerY
            return
        }
        const tool = api.tool(app)
        if tool != null && tool.?.*.press != null {
            const input = inputNow(app, button)
            tool.?.*.press.?(app, &input)
        }
        api.canvasChanged(app)
        return
    }
    if button == ui_app.BUTTON_LEFT {
        if ui_app.feed(widgets, ui_app.EVENT_BUTTON, button, 1) != ui_app.FEED_NONE { api.redraw(app) }
    }
}

fn onRelease(app: *App, button: u32) -> void {
    const widgets = state.uiOf(app)
    if app.*.canvasGrab && button == app.*.grabButton {
        app.*.canvasGrab = false
        if panning {
            panning = false
            return
        }
        const tool = api.tool(app)
        if tool != null && tool.?.*.release != null && api.document(app) != null {
            const input = inputNow(app, button)
            tool.?.*.release.?(app, &input)
        }
        api.canvasChanged(app)
        return
    }
    if button == ui_app.BUTTON_LEFT {
        const fed = ui_app.feed(widgets, ui_app.EVENT_BUTTON, button, 0)
        if fed == ui_app.FEED_CLICK { layOut(app) }
        if fed != ui_app.FEED_NONE { api.redraw(app) }
    }
}

fn onMotion(app: *App, x: i32, y: i32) -> void {
    const widgets = state.uiOf(app)
    app.*.pointerX = x
    app.*.pointerY = y
    app.*.pointerInside = true
    const fed = ui_app.feed(widgets, ui_app.EVENT_MOTION, @bitCast(u32, x), y)
    if app.*.canvasGrab {
        const doc = api.document(app)
        if doc == null { return }
        if panning {
            viewport.panBy(&doc.?.*.view, @floatFromInt(f64, x - panX), @floatFromInt(f64, y - panY))
            panX = x
            panY = y
            api.redraw(app)
            return
        }
        const tool = api.tool(app)
        if tool != null && tool.?.*.move != null {
            const input = inputNow(app, 0)
            tool.?.*.move.?(app, &input)
        }
        api.canvasChanged(app)
        return
    }
    if fed != ui_app.FEED_NONE { api.redraw(app) }
    if overCanvas(app) {
        const tool = api.tool(app)
        if tool != null && tool.?.*.move != null {
            const input = inputNow(app, 0)
            tool.?.*.move.?(app, &input)
        }
        // The brush's outline follows the pointer.
        api.canvasChanged(app)
    }
}

fn onWheel(app: *App, axis: u32, steps: i32) -> void {
    const widgets = state.uiOf(app)
    if overCanvas(app) && axis == 0 {
        const doc = api.document(app).?
        const factor: f64 = if steps < 0 { 1.25 } else { 0.8 }
        viewport.zoomAt(&doc.*.view, @floatFromInt(f64, app.*.pointerX) + 0.5, @floatFromInt(f64, app.*.pointerY) + 0.5, doc.*.view.zoom * factor)
        api.redraw(app)
        return
    }
    if ui_app.feed(widgets, ui_app.EVENT_WHEEL, axis, steps) != ui_app.FEED_NONE { api.redraw(app) }
}

// A key nobody took: an action's shortcut, a tool's, or one of the few
// the program has before its actions are written.
fn shortcut(app: *App, code: u32, modifiers: u32, plain: []const u8) -> bool {
    const action_count = actions.count()
    var index: usize = 0
    while index < action_count {
        const action = actions.at(index)
        if action != null && action.?.*.shortcut.length > 0 && keys.matches(keys.parse(action.?.*.shortcut), code, modifiers, plain) {
            if api.actionEnabled(app, action.?) {
                action.?.*.run(app)
                api.redraw(app)
            }
            return true
        }
        index += 1
    }
    const tool_count = tools.count()
    index = 0
    while index < tool_count {
        const tool = tools.at(index)
        if tool != null && tool.?.*.shortcut.length > 0 && keys.matches(keys.parse(tool.?.*.shortcut), code, modifiers, plain) {
            api.setTool(app, tool.?.*.id)
            return true
        }
        index += 1
    }
    if keys.matches(keys.parse("Ctrl+Z"), code, modifiers, plain) {
        api.undo(app)
        return true
    }
    if keys.matches(keys.parse("Ctrl+Shift+Z"), code, modifiers, plain) || keys.matches(keys.parse("Ctrl+Y"), code, modifiers, plain) {
        api.redo(app)
        return true
    }
    if keys.matches(keys.parse("X"), code, modifiers, plain) {
        api.swapColors(app)
        return true
    }
    if keys.matches(keys.parse("D"), code, modifiers, plain) {
        api.resetColors(app)
        return true
    }
    if keys.matches(keys.parse("E"), code, modifiers, plain) {
        app.*.eraser = !app.*.eraser
        api.redraw(app)
        return true
    }
    return false
}

fn onKey(app: *App, code: u32, how: i32) -> void {
    const modifiers = shell_module.modifiers(app.*.shell)
    app.*.modifiers = modifiers
    const tool = api.tool(app)
    if how == 0 {
        if code == keys.SPACE { app.*.spaceHeld = false }
        if tool != null && tool.?.*.keyPress != null { _ = tool.?.*.keyPress.?(app, code, modifiers, false) }
        return
    }
    const typed = shell_module.typed(app.*.shell)
    const plain = shell_module.plainTyped(app.*.shell)
    if app.*.dialogCount > 0 {
        const dialog = app.*.dialogs[app.*.dialogCount - 1]
        if dialog.keyPress != null && dialog.keyPress.?(app, code, modifiers, typed) {
            api.redraw(app)
            return
        }
        if code == keys.ESCAPE {
            api.popDialog(app)
            if dialog.cancel != null { dialog.cancel.?(app) }
        } else if keys.isEnter(code) && dialog.accept != null {
            dialog.accept.?(app)
            api.redraw(app)
        }
        return
    }
    if code == keys.ESCAPE {
        if tool != null && tool.?.*.cancel != null { tool.?.*.cancel.?(app) }
        api.redraw(app)
        return
    }
    if keys.isEnter(code) && tool != null && tool.?.*.finish != null && api.toolBusy(app) {
        tool.?.*.finish.?(app)
        api.redraw(app)
        return
    }
    if tool != null && tool.?.*.keyPress != null && tool.?.*.keyPress.?(app, code, modifiers, true) {
        api.redraw(app)
        return
    }
    if code == keys.SPACE {
        app.*.spaceHeld = true
        return
    }
    if code == keys.TAB && modifiers == 0 && how == 1 {
        app.*.canvasOnly = !app.*.canvasOnly
        api.redraw(app)
        return
    }
    if keys.isModifier(code) { return }
    _ = shortcut(app, code, modifiers, plain)
}

// An event of std.ui.app's kinds.
pub fn event(app: *App, kind: u32, a: u32, b: i32) -> void {
    if !app.*.ready { return }
    if kind == ui_app.EVENT_CLOSED {
        shell_module.quit(app.*.shell)
    } else if kind == ui_app.EVENT_CONFIGURED {
        api.redraw(app)
    } else if kind == ui_app.EVENT_KEY {
        onKey(app, a, b)
    } else if kind == ui_app.EVENT_KEYBOARD_LEAVE {
        app.*.modifiers = 0
        app.*.spaceHeld = false
        api.releaseTool(app)
    } else if kind == ui_app.EVENT_TICK {
        const tool = api.tool(app)
        if app.*.ticking && tool != null && tool.?.*.tick != null { tool.?.*.tick.?(app) }
    } else if kind == ui_app.EVENT_MOTION {
        onMotion(app, @bitCast(i32, a), b)
    } else if kind == ui_app.EVENT_LEAVE {
        app.*.pointerInside = false
        if ui_app.feed(state.uiOf(app), kind, a, b) != ui_app.FEED_NONE { api.redraw(app) }
        api.canvasChanged(app)
    } else if kind == ui_app.EVENT_BUTTON {
        const bit = buttonBit(a)
        if b == 1 {
            app.*.buttons |= bit
            onPress(app, a)
        } else {
            app.*.buttons &= ~bit
            onRelease(app, a)
        }
    } else if kind == ui_app.EVENT_WHEEL {
        onWheel(app, a, b)
    }
}
