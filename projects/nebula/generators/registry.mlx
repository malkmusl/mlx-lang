// nebula generators: what a fill layer shows (and Fill Special fills
// with): pixels made from numbers. A generator is named by a number
// (node.Params.id) that stays for good; its numbers are in params.values
// in the order its Info names them, described as a filter's are
// (filters/types.mlx's Param: the dialog, the files and the defaults
// need no word about any one generator), and a gradient, where one is
// asked for, is params.text in core/gradient.mlx's compact form.
//
//     var params: generators.Params = undefined
//     generators.defaults(generators.SIMPLEX_NOISE, &params)
//     params.values[0] = 8.0                              // frequency
//     _ = generators.render(&params, area, pixels, stride, image_width, image_height)
//
// The generators: Color (a colour), Gradient (core/gradient.mlx's
// render over the image, start and end as parts of the image's size),
// Pattern, Screentone, Multigrid, Checker and Stripes
// (generators/patterns.mlx), Simplex Noise (generators/noise.mlx). Each
// makes every pixel from its own place in the image: rendering an area
// in pieces gives what rendering it at once gives, bit for bit, and the
// compositor may ask for any rectangle. A number out of its range is the
// nearest end of it, a number that is none the initial value.
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const node_module = @import("../core/node.mlx")
const device_module = @import("../core/device.mlx")
const gradient = @import("../core/gradient.mlx")
const table = @import("../core/table.mlx")
const types = @import("../filters/types.mlx")
const noise = @import("./noise.mlx")
const patterns = @import("./patterns.mlx")

pub const Params = node_module.Params
pub const Rect = geom.Rect
pub const Param = types.Param

// The generators' numbers.
pub const COLOR: u16 = 0
pub const GRADIENT: u16 = 1
pub const PATTERN: u16 = patterns.PATTERN
pub const SIMPLEX_NOISE: u16 = noise.SIMPLEX_NOISE
pub const MULTIGRID: u16 = patterns.MULTIGRID
pub const SCREENTONE: u16 = patterns.SCREENTONE
pub const CHECKER: u16 = patterns.CHECKER
pub const STRIPES: u16 = patterns.STRIPES

// The groups of the list.
pub const PLAIN: u8 = 0
pub const GRADIENTS: u8 = 1
pub const PATTERNS: u8 = 2
pub const NOISE: u8 = 3
pub const CATEGORIES: u8 = 4

// The pixels of the area at (area_x, area_y), area_width x area_height
// (the image's coordinates; the image is `image_width` x
// `image_height`), into `into`, `stride` words a row. (The area comes as
// four numbers: a Rect handed through a function pointer is copied into
// the value arena at every call.)
pub const Render = fn(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void

pub const Info = struct {
    id: u16
    // Its name in files (Krita's generator name where Krita has it).
    key: []const u8
    name: []const u8
    german: []const u8
    category: u8
    params: []const Param
    render: Render
}

// ---------------------------------------------------------------------------
// Color

const COLOR_PARAMS = [4]Param{
    Param.{ .name = "Red", .german = "Rot", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 255.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Green", .german = "Grün", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 255.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Blue", .german = "Blau", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 255.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Alpha", .german = "Alpha", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 255.0, .choices = "", .choicesGerman = "" },
}

fn channel(amount: f64) -> u32 {
    if !(amount > 0.0) { return 0 }
    if amount >= 255.0 { return 255 }
    return @intCast(u32, @intFromFloat(i32, amount + 0.5))
}

fn flood(area: Rect, into: [*]u32, stride: usize, value: u32) -> void {
    const width = @intCast(usize, area.width)
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        device_module.fillWords(into + row * stride, width, value)
        row += 1
    }
}

// One colour: values 0-3 are red, green, blue and alpha, 0-255 each.
fn renderColor(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void {
    const area = geom.rect(area_x, area_y, area_width, area_height)
    if geom.isEmpty(area) { return }
    const rows = paramsOf(COLOR)
    const color = pixel.pack(channel(noise.numberOf(params, rows, 3)), channel(noise.numberOf(params, rows, 0)), channel(noise.numberOf(params, rows, 1)), channel(noise.numberOf(params, rows, 2)))
    // (A transparent pixel is 0, whatever its colour.)
    flood(area, into, stride, if color >> 24 == 0 { 0 } else { color })
}

// ---------------------------------------------------------------------------
// Gradient

const GRADIENT_PARAMS = [12]Param{
    Param.{ .name = "Gradient", .german = "Verlauf", .kind = types.TEXT, .low = 0.0, .high = 0.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Shape", .german = "Form", .kind = types.CHOICE, .low = 0.0, .high = 7.0, .initial = 0.0, .choices = "Linear|Bilinear|Radial|Square|Conical|Conical symmetric|Spiral|Reverse spiral", .choicesGerman = "Linear|Bilinear|Radial|Quadratisch|Konisch|Konisch symmetrisch|Spirale|Umgekehrte Spirale" },
    Param.{ .name = "Repeat", .german = "Wiederholung", .kind = types.CHOICE, .low = 0.0, .high = 2.0, .initial = 0.0, .choices = "None|Forwards|Alternating", .choicesGerman = "Keine|Vorwärts|Abwechselnd" },
    Param.{ .name = "Reverse", .german = "Umkehren", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Dither", .german = "Dithern", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Start x", .german = "Anfang x", .kind = types.FLOAT, .low = -10.0, .high = 10.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Start y", .german = "Anfang y", .kind = types.FLOAT, .low = -10.0, .high = 10.0, .initial = 0.5, .choices = "", .choicesGerman = "" },
    Param.{ .name = "End x", .german = "Ende x", .kind = types.FLOAT, .low = -10.0, .high = 10.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "End y", .german = "Ende y", .kind = types.FLOAT, .low = -10.0, .high = 10.0, .initial = 0.5, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Anti-alias threshold", .german = "Kantenglättung ab", .kind = types.FLOAT, .low = 0.0, .high = 1.0, .initial = 0.2, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Foreground", .german = "Vordergrund", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4278190080.0, .choices = "", .choicesGerman = "" },
    Param.{ .name = "Background", .german = "Hintergrund", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
}

// The gradient a generator's or a filter's text names: the compact form
// (core/gradient.mlx); black to white for an empty text or one that is
// no gradient.
pub fn gradientOf(params: *const Params, into: *gradient.Gradient) -> void {
    if !gradient.parse(node_module.paramsText(params), into) { gradient.init(into, pixel.BLACK, pixel.WHITE) }
}

// The gradient tool's picture over the image: the drag from (start x,
// start y) to (end x, end y), each a part of the image's width or
// height (0: the left or top edge, 1: the right or bottom one).
fn renderGradient(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void {
    const area = geom.rect(area_x, area_y, area_width, area_height)
    if geom.isEmpty(area) { return }
    var shown: gradient.Gradient = undefined
    gradientOf(params, &shown)
    const rows = paramsOf(GRADIENT)
    const shape = @intFromFloat(u8, noise.numberOf(params, rows, 1) + 0.5)
    const repeat = @intFromFloat(u8, noise.numberOf(params, rows, 2) + 0.5)
    const reverse = noise.isOn(noise.numberOf(params, rows, 3))
    const dither = noise.isOn(noise.numberOf(params, rows, 4))
    const width = @floatFromInt(f64, if image_width < 1 { 1 } else { image_width })
    const height = @floatFromInt(f64, if image_height < 1 { 1 } else { image_height })
    const x0 = noise.numberOf(params, rows, 5) * width
    const y0 = noise.numberOf(params, rows, 6) * height
    const x1 = noise.numberOf(params, rows, 7) * width
    const y1 = noise.numberOf(params, rows, 8) * height
    const threshold = noise.numberOf(params, rows, 9)
    const foreground = noise.colorOf(noise.numberOf(params, rows, 10))
    const background = noise.colorOf(noise.numberOf(params, rows, 11))
    gradient.render(&shown, shape, repeat, reverse, dither, x0, y0, x1, y1, area, into, stride, foreground, background, threshold)
}

// ---------------------------------------------------------------------------
// The list

const GENERATOR_COUNT: usize = 8

const GENERATORS = [8]Info{
    Info.{ .id = COLOR, .key = "color", .name = "Color", .german = "Farbe", .category = PLAIN, .params = COLOR_PARAMS[0..], .render = renderColor },
    Info.{ .id = GRADIENT, .key = "gradient", .name = "Gradient", .german = "Verlauf", .category = GRADIENTS, .params = GRADIENT_PARAMS[0..], .render = renderGradient },
    Info.{ .id = PATTERN, .key = "pattern", .name = "Pattern", .german = "Muster", .category = PATTERNS, .params = patterns.PATTERN_PARAMS[0..], .render = patterns.renderPattern },
    Info.{ .id = SIMPLEX_NOISE, .key = "simplex_noise", .name = "Simplex Noise", .german = "Simplex-Rauschen", .category = NOISE, .params = noise.SIMPLEX_PARAMS[0..], .render = noise.renderSimplex },
    Info.{ .id = MULTIGRID, .key = "multigrid", .name = "Multigrid", .german = "Multigitter", .category = PATTERNS, .params = patterns.MULTIGRID_PARAMS[0..], .render = patterns.renderMultigrid },
    Info.{ .id = SCREENTONE, .key = "screentone", .name = "Screentone", .german = "Rasterfolie", .category = PATTERNS, .params = patterns.SCREENTONE_PARAMS[0..], .render = patterns.renderScreentone },
    Info.{ .id = CHECKER, .key = "checker", .name = "Checker", .german = "Schachbrett", .category = PLAIN, .params = patterns.CHECKER_PARAMS[0..], .render = patterns.renderChecker },
    Info.{ .id = STRIPES, .key = "stripes", .name = "Stripes", .german = "Streifen", .category = PLAIN, .params = patterns.STRIPES_PARAMS[0..], .render = patterns.renderStripes },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// All generators (heap memory kept for the program's life: see
// core/table.mlx).
pub fn list() -> []const Info {
    if kept.address != 0 { return table.rows(Info, &kept) }
    return table.keep(Info, &kept, GENERATORS[0..])
}

// How many generators there are, and the one at a place in the list.
pub fn count() -> usize { return GENERATOR_COUNT }

pub fn at(index: usize) -> ?*const Info {
    const rows = list()
    if index >= rows.length { return null }
    return &rows[index]
}

// The generator numbered `id` (null: there is none).
pub fn find(id: u16) -> ?*const Info {
    const rows = list()
    var index: usize = 0
    while index < rows.length {
        if rows[index].id == id { return &rows[index] }
        index += 1
    }
    return null
}

fn sameText(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if left[index] != right[index] { return false }
        index += 1
    }
    return true
}

// The generator a file names `key`.
pub fn byKey(key: []const u8) -> ?*const Info {
    const rows = list()
    var index: usize = 0
    while index < rows.length {
        if sameText(rows[index].key, key) { return &rows[index] }
        index += 1
    }
    return null
}

// The description of generator `id`'s numbers (empty for one that is
// none), read from list()'s heap rows: their `params` point at the
// program's data, where a row is read without a copy of the table.
pub fn paramsOf(id: u16) -> []const Param {
    const info = find(id)
    if info != null { return info.?.*.params }
    // (Nothing, cut from a row's own slice: a slice of a constant table
    // taken at run time would copy the table.)
    return list()[0].params[0..0]
}

// The name of a group of the list.
pub fn categoryName(category: u8, german: bool) -> []const u8 {
    if category == PLAIN { return if german { "Einfach" } else { "Plain" } }
    if category == GRADIENTS { return if german { "Verläufe" } else { "Gradients" } }
    if category == PATTERNS { return if german { "Muster" } else { "Patterns" } }
    if category == NOISE { return if german { "Rauschen" } else { "Noise" } }
    return ""
}

// `params` for generator `id` with every number at its initial value and
// no text (a gradient is then black to white).
pub fn defaults(id: u16, params: *Params) -> void {
    node_module.clearParams(params)
    params.*.id = id
    const info = find(id)
    if info == null { return }
    var index: usize = 0
    while index < info.?.*.params.length && index < node_module.VALUES {
        params.*.values[index] = info.?.*.params[index].initial
        index += 1
    }
}

// The pixels of `area` (the image's coordinates; the image is
// `image_width` x `image_height`) into `into`, `stride` words a row.
// False for a generator not known (transparent then).
pub fn render(params: *const Params, area: Rect, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> bool {
    const info = find(params.*.id)
    if geom.isEmpty(area) { return info != null }
    if info == null {
        flood(area, into, stride, 0)
        return false
    }
    info.?.*.render(params, area.x, area.y, area.width, area.height, into, stride, image_width, image_height)
    return true
}
