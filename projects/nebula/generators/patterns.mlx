// nebula generators: patterns. The built-in patterns, tiles of 64 or 128
// pixels that repeat without a seam, made by rule the first time one is
// asked for, and the generators that lay something regular over the
// image: Pattern (a built-in tile, scaled, turned and moved), Screentone
// (a printer's raster of dots or lines), Multigrid (de Bruijn's families
// of parallel lines), Checker and Stripes.
//
//     var width: usize = 0
//     var height: usize = 0
//     const tile = patterns.pattern(patterns.BRICKS, &width, &height)
//     if tile != null {
//         const texel = tile.?[(y % height) * width + x % width]     // straight, opaque
//     }
//
// The fill tool, pattern fills and brush textures take their tiles here.
// All tiles live in one heap block taken at the first asking and kept
// for the program's life (530 KiB: one of brixOS' regions, not one a
// tile); a tile is drawn into it the first time it is asked for, and
// then never changes. Shapes are drawn with 16 samples a pixel, so their
// edges are smooth; the grain patterns (paper, wood, clouds) are made of
// lattice noise whose cells divide the tile (noise.lattice), the weave of
// its threads' profile, the plain noise of a hash of the pixel's place.
// A tile is opaque.
//
// The generators read nothing but the pixel's own place: a picture made
// in pieces is the picture made at once.
//
// Not done: Multigrid draws the line families and colours the cells
// between them by de Bruijn's index (the sum of the cell's strip numbers
// modulo the dimensions), not the rhomb tiling that is their dual. The
// Pattern generator samples its tile bilinearly: shrunk far below its
// size a tile shimmers (there is no smaller copy of it to read).
const std = @import("std")
const math = @import("std.math")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const device_module = @import("../core/device.mlx")
const types = @import("../filters/types.mlx")
const noise = @import("./noise.mlx")
const table_module = @import("../core/table.mlx")

pub const Params = types.Params
pub const Rect = geom.Rect

const numberOf = noise.numberOf
const colorOf = noise.colorOf

// ---------------------------------------------------------------------------
// The built-in patterns

pub const CHECKERBOARD: usize = 0
pub const STRIPES_HORIZONTAL: usize = 1
pub const STRIPES_VERTICAL: usize = 2
pub const STRIPES_DIAGONAL: usize = 3
pub const DOTS: usize = 4
pub const GRID: usize = 5
pub const BRICKS: usize = 6
pub const HEXAGONS: usize = 7
pub const WEAVE: usize = 8
pub const PAPER: usize = 9
pub const WOOD: usize = 10
pub const CLOUDS: usize = 11
pub const HATCH: usize = 12
pub const CROSS_HATCH: usize = 13
pub const WAVES: usize = 14
pub const SCALES: usize = 15
pub const NOISE: usize = 16
pub const DIAMONDS: usize = 17
pub const PATTERNS: usize = 18

const Tile = struct {
    name: []const u8
    german: []const u8
    // What the pattern is drawn with: the ground and what lies on it
    // (dark and light for the grain patterns).
    back: u32
    front: u32
}

const TILES = [18]Tile{
    Tile.{ .name = "Checkerboard", .german = "Schachbrett", .back = 0xFFFFFFFF, .front = 0xFF9A9A9A },
    Tile.{ .name = "Horizontal stripes", .german = "Waagrechte Streifen", .back = 0xFFFFFFFF, .front = 0xFF202020 },
    Tile.{ .name = "Vertical stripes", .german = "Senkrechte Streifen", .back = 0xFFFFFFFF, .front = 0xFF202020 },
    Tile.{ .name = "Diagonal stripes", .german = "Schräge Streifen", .back = 0xFFFFFFFF, .front = 0xFF202020 },
    Tile.{ .name = "Dots", .german = "Punkte", .back = 0xFFFFFFFF, .front = 0xFF101010 },
    Tile.{ .name = "Grid", .german = "Gitter", .back = 0xFFFFFFFF, .front = 0xFF505050 },
    Tile.{ .name = "Bricks", .german = "Ziegelmauer", .back = 0xFFD6D0C4, .front = 0xFFA4492B },
    Tile.{ .name = "Hexagons", .german = "Sechsecke", .back = 0xFFF2F2F2, .front = 0xFF3A3A3A },
    Tile.{ .name = "Canvas weave", .german = "Leinwandbindung", .back = 0xFF5A5248, .front = 0xFFE9E0CC },
    Tile.{ .name = "Paper grain", .german = "Papierkorn", .back = 0xFFA9A59D, .front = 0xFFFFFFFF },
    Tile.{ .name = "Wood grain", .german = "Holzmaserung", .back = 0xFF7A4A24, .front = 0xFFD9A96E },
    Tile.{ .name = "Clouds", .german = "Wolken", .back = 0xFF000000, .front = 0xFFFFFFFF },
    Tile.{ .name = "Hatching", .german = "Schraffur", .back = 0xFFFFFFFF, .front = 0xFF000000 },
    Tile.{ .name = "Cross-hatching", .german = "Kreuzschraffur", .back = 0xFFFFFFFF, .front = 0xFF000000 },
    Tile.{ .name = "Waves", .german = "Wellen", .back = 0xFFFFFFFF, .front = 0xFF2B4C7E },
    Tile.{ .name = "Scales", .german = "Schuppen", .back = 0xFFE6E6E6, .front = 0xFF333333 },
    Tile.{ .name = "Noise", .german = "Rauschen", .back = 0xFF000000, .front = 0xFFFFFFFF },
    Tile.{ .name = "Diamonds", .german = "Rauten", .back = 0xFFFFFFFF, .front = 0xFF6A6A6A },
}

// The seed of the grain patterns' noise: they look the same every run.
const SEED: u64 = 0x6E6562756C61

// The block of all tiles (0: not taken yet), the permutation behind it,
// and which tiles are drawn (a bit each).
var block: usize = 0
var drawn: u64 = 0

// How many built-in patterns there are.
pub fn count() -> usize { return PATTERNS }

// The name of pattern `index` ("" for one that is none).
pub fn name(index: usize, german: bool) -> []const u8 {
    if index >= PATTERNS { return "" }
    return if german { TILES[index].german } else { TILES[index].name }
}

// A tile's width and height. (Worked out, not read from TILES: a row
// of a constant table taken at run time copies the whole table.)
fn sizeOf(index: usize) -> usize {
    if index == BRICKS || index == HEXAGONS || index == PAPER || index == WOOD || index == CLOUDS { return 128 }
    return 64
}

// Where tile `index` starts in the block, in pixels.
fn offsetOf(index: usize) -> usize {
    var total: usize = 0
    var before: usize = 0
    while before < index {
        total += sizeOf(before) * sizeOf(before)
        before += 1
    }
    return total
}

// Built-in pattern `index`: its pixels (`width` x `height`, row after
// row, opaque) and its size in `width` and `height`. Null (and 0 x 0)
// for an index that is none and when memory ran out (the next asking
// tries again). The pixels stay for the program's life.
pub fn pattern(index: usize, width: *usize, height: *usize) -> ?[*]const u32 {
    width.* = 0
    height.* = 0
    if index >= PATTERNS { return null }
    if block == 0 {
        const memory = std.heap.allocator().alloc(offsetOf(PATTERNS) * 4 + noise.PERMUTATION, 16)
        if memory == null { return null }
        block = @intFromPtr(memory.?)
        noise.permute(permutation(), SEED)
    }
    const tiles: [*]u32 = unsafe { @ptrFromInt([*]u32, block) }
    const pixels = tiles + offsetOf(index)
    const size = sizeOf(index)
    const bit = @intCast(u64, 1) << @intCast(u64, index)
    if drawn & bit == 0 {
        draw(index, pixels, size)
        drawn |= bit
    }
    width.* = size
    height.* = size
    return pixels
}

// The grain patterns' permutation, after the tiles in the block.
fn permutation() -> [*]u8 {
    return unsafe { @ptrFromInt([*]u8, block + offsetOf(PATTERNS) * 4) }
}

inline fn fraction(value: f64) -> f64 {
    return value - @floor(value)
}

// The whole part of `value` (a tile's coordinate: small) as an integer.
inline fn whole(value: f64) -> i64 {
    return @intFromFloat(i64, @floor(value))
}

// A hash of two small integers: 0..255.
fn hashed(a: i64, b: i64) -> u32 {
    var z = @bitCast(u64, a) *% 0x9E3779B97F4A7C15 +% @bitCast(u64, b) *% 0xC2B2AE3D27D4EB4F +% SEED
    z = (z ^ (z >> 29)) *% 0xBF58476D1CE4E5B9
    z = z ^ (z >> 32)
    return @intCast(u32, z & 255)
}

// Hexagons: 7 columns of 128 / 7 pixels and 8 rows of 16, every other
// row half a column aside, so that the lattice repeats with the tile
// (the hexagons are a hair, 1 %, taller than regular ones).
const HEX_DX: f64 = 18.285714285714285
const HEX_DY: f64 = 16.0

// How far (u, v) is from the edge between its hexagon and the nearest
// other one.
fn hexagonEdge(u: f64, v: f64) -> f64 {
    var best: f64 = 1.0e30
    var second: f64 = 1.0e30
    var best_x: f64 = 0.0
    var best_y: f64 = 0.0
    var second_x: f64 = 0.0
    var second_y: f64 = 0.0
    const row0 = whole(v / HEX_DY)
    var row = row0 - 1
    while row <= row0 + 1 {
        const shift = if row & 1 != 0 { 0.75 } else { 0.25 }
        const cy = (@floatFromInt(f64, row) + 0.5) * HEX_DY
        const column0 = whole(u / HEX_DX - shift)
        var column = column0 - 1
        while column <= column0 + 2 {
            const cx = (@floatFromInt(f64, column) + shift) * HEX_DX
            const dx = u - cx
            const dy = v - cy
            const distance = dx * dx + dy * dy
            if distance < best {
                second = best
                second_x = best_x
                second_y = best_y
                best = distance
                best_x = cx
                best_y = cy
            } else if distance < second {
                second = distance
                second_x = cx
                second_y = cy
            }
            column += 1
        }
        row += 1
    }
    const apart = @sqrt((second_x - best_x) * (second_x - best_x) + (second_y - best_y) * (second_y - best_y))
    // (The distance to the line halfway between the two centres.)
    return (second - best) / (2.0 * apart)
}

// Scales: rows 16 pixels apart, circles of radius 16 every 32 pixels,
// every other row half aside; a row covers the one below it. Whether
// (u, v) is on the rim of the scale it shows.
fn onScaleRim(u: f64, v: f64) -> bool {
    const row0 = whole(v / 16.0)
    var row = row0
    while row <= row0 + 1 {
        const shift = if row & 1 != 0 { 16.0 } else { 0.0 }
        const cy = @floatFromInt(f64, row) * 16.0
        const cx = @floatFromInt(f64, whole((u - shift) / 32.0 + 0.5)) * 32.0 + shift
        const dx = u - cx
        const dy = v - cy
        const distance = @sqrt(dx * dx + dy * dy)
        if distance <= 16.0 { return distance > 14.5 }
        row += 1
    }
    return false
}

// Whether the point (u, v) of a drawn pattern's tile is of its front
// colour.
fn covers(index: usize, u: f64, v: f64) -> bool {
    if index == CHECKERBOARD { return (whole(u / 16.0) + whole(v / 16.0)) & 1 != 0 }
    if index == STRIPES_HORIZONTAL { return fraction(v / 16.0) < 0.5 }
    if index == STRIPES_VERTICAL { return fraction(u / 16.0) < 0.5 }
    if index == STRIPES_DIAGONAL { return fraction((u + v) / 16.0) < 0.5 }
    if index == DOTS {
        const row = whole(v / 16.0)
        const shift = if row & 1 != 0 { 8.0 } else { 0.0 }
        const dx = fraction((u - shift) / 16.0) * 16.0 - 8.0
        const dy = fraction(v / 16.0) * 16.0 - 8.0
        return dx * dx + dy * dy < 25.0
    }
    if index == GRID { return fraction(u / 16.0) * 16.0 < 2.0 || fraction(v / 16.0) * 16.0 < 2.0 }
    if index == BRICKS {
        const shift = if whole(v / 16.0) & 1 != 0 { 16.0 } else { 0.0 }
        // (The mortar: the front colour is the brick's.)
        return !(fraction(v / 16.0) * 16.0 < 2.0 || fraction((u + shift) / 32.0) * 32.0 < 2.0)
    }
    if index == HEXAGONS { return hexagonEdge(u, v) < 1.0 }
    if index == HATCH { return fraction((u + v) / 8.0) * 8.0 < 1.5 }
    if index == CROSS_HATCH { return fraction((u + v) / 8.0) * 8.0 < 1.5 || fraction((u - v) / 8.0) * 8.0 < 1.5 }
    if index == WAVES { return fraction((v + 4.0 * math.sin(math.tau * u / 64.0)) / 16.0) < 0.4 }
    if index == SCALES { return onScaleRim(u, v) }
    if index == DIAMONDS {
        const dx = fraction(u / 16.0) - 0.5
        const dy = fraction(v / 16.0) - 0.5
        return math.abs(dx) + math.abs(dy) < 0.35
    }
    return false
}

// A drawn pattern's pixel (x, y): the share of 4 x 4 samples in it that
// are of the front colour.
fn coverage(index: usize, x: usize, y: usize) -> u32 {
    var inside: u32 = 0
    var row: usize = 0
    while row < 4 {
        const v = @floatFromInt(f64, y) + (@floatFromInt(f64, row) + 0.5) * 0.25
        var column: usize = 0
        while column < 4 {
            const u = @floatFromInt(f64, x) + (@floatFromInt(f64, column) + 0.5) * 0.25
            if covers(index, u, v) { inside += 1 }
            column += 1
        }
        row += 1
    }
    return (inside * 255 + 8) / 16
}

inline fn unitByte(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 1.0 { return 255 }
    return @intFromFloat(u32, value * 255.0 + 0.5)
}

// The grain patterns' pixel (x, y) (its centre) as a share of the front
// colour over the back one.
fn grain(index: usize, table: [*]const u8, x: usize, y: usize) -> u32 {
    const u = @floatFromInt(f64, x) + 0.5
    const v = @floatFromInt(f64, y) + 0.5
    if index == PAPER {
        // Cells of 4 and 2 pixels: fine, mostly light.
        const n = 0.6 * noise.lattice(table, u / 4.0, v / 4.0, 32, 32) + 0.4 * noise.lattice(table, u / 2.0, v / 2.0, 64, 64)
        return unitByte(0.7 + 0.8 * n)
    }
    if index == WOOD {
        // Six rings across, bent by two noises along the grain.
        const bent = u / 128.0 * 6.0 + 0.8 * noise.lattice(table, u / 32.0, v / 16.0, 4, 8) + 0.15 * noise.lattice(table, u / 8.0, v / 4.0, 16, 32)
        const ring = fraction(bent)
        return unitByte(0.5 + 0.5 * math.sin(math.tau * ring))
    }
    if index == CLOUDS {
        var sum: f64 = 0.0
        var amplitude: f64 = 1.0
        var cells: i32 = 4
        while cells <= 64 {
            const size = 128.0 / @floatFromInt(f64, cells)
            sum += amplitude * noise.lattice(table, u / size, v / size, cells, cells)
            amplitude *= 0.5
            cells *= 2
        }
        return unitByte(0.5 + 0.6 * sum)
    }
    if index == WEAVE {
        // Threads 8 pixels wide, over and under in turn; a thread is
        // lightest along its middle.
        const across = (whole(u / 8.0) + whole(v / 8.0)) & 1 == 0
        const place = if across { fraction(v / 8.0) } else { fraction(u / 8.0) }
        return unitByte(0.15 + 0.85 * math.sin(math.pi * place))
    }
    return hashed(@intCast(i64, x), @intCast(i64, y))
}

// A brick's own shade: the front colour a little lighter or darker,
// the same for all of one brick (bricks counted around the tile).
fn brickColor(front: u32, x: usize, y: usize) -> u32 {
    const row = @intCast(i64, y / 16)
    const shift: usize = if row & 1 != 0 { 16 } else { 0 }
    const column = @intCast(i64, ((x + shift) / 32) % 4)
    const shade = hashed(column, row) / 4
    // 0..63: from 3/4 of the colour to all of it.
    const scale = 192 + shade
    return pixel.pack(255, pixel.red(front) * scale / 255, pixel.green(front) * scale / 255, pixel.blue(front) * scale / 255)
}

fn draw(index: usize, into: [*]u32, size: usize) -> void {
    const back = TILES[index].back
    const front = TILES[index].front
    const grainy = index == PAPER || index == WOOD || index == CLOUDS || index == WEAVE || index == NOISE
    const table = permutation()
    var y: usize = 0
    while y < size {
        var x: usize = 0
        while x < size {
            if grainy {
                into[y * size + x] = pixel.mix(back, front, grain(index, table, x, y))
            } else if index == BRICKS {
                into[y * size + x] = pixel.mix(back, brickColor(front, x, y), coverage(index, x, y))
            } else {
                into[y * size + x] = pixel.mix(back, front, coverage(index, x, y))
            }
            x += 1
        }
        y += 1
    }
}

// ---------------------------------------------------------------------------
// Shared by the generators

// Beyond this a place has no fraction left (and is no integer to take).
const LIMIT: f64 = 1000000000000000.0

inline fn around(value: i64, period: i64) -> i64 {
    const rest = value % period
    return if rest < 0 { rest + period } else { rest }
}

inline fn radians(degrees: f64) -> f64 {
    return degrees * math.pi / 180.0
}

// The generators' descriptions as heap copies (see noise.mlx's header),
// one for each of these.
const PATTERN_ROWS: usize = 0
const SCREENTONE_ROWS: usize = 1
const MULTIGRID_ROWS: usize = 2
const CHECKER_ROWS: usize = 3
const STRIPES_ROWS: usize = 4

var kept: [5]table_module.Kept = [5]table_module.Kept{
    table_module.Kept.{ .address = 0, .length = 0 },
    table_module.Kept.{ .address = 0, .length = 0 },
    table_module.Kept.{ .address = 0, .length = 0 },
    table_module.Kept.{ .address = 0, .length = 0 },
    table_module.Kept.{ .address = 0, .length = 0 },
}

fn rowsOf(which: usize) -> []const types.Param {
    const place = &kept[which]
    if place.*.address != 0 { return table_module.rows(types.Param, place) }
    if which == PATTERN_ROWS { return table_module.keep(types.Param, place, PATTERN_PARAMS[0..]) }
    if which == SCREENTONE_ROWS { return table_module.keep(types.Param, place, SCREENTONE_PARAMS[0..]) }
    if which == MULTIGRID_ROWS { return table_module.keep(types.Param, place, MULTIGRID_PARAMS[0..]) }
    if which == CHECKER_ROWS { return table_module.keep(types.Param, place, CHECKER_PARAMS[0..]) }
    return table_module.keep(types.Param, place, STRIPES_PARAMS[0..])
}

// Every pixel of `area` is `value`.
fn flood(area: Rect, into: [*]u32, stride: usize, value: u32) -> void {
    const width = @intCast(usize, area.width)
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        device_module.fillWords(into + row * stride, width, value)
        row += 1
    }
}

// ---------------------------------------------------------------------------
// The Pattern generator

pub const PATTERN: u16 = 2

pub const PATTERN_PARAMS = [5]types.Param{
    types.Param.{ .name = "Pattern", .german = "Muster", .kind = types.CHOICE, .low = 0.0, .high = 17.0, .initial = 0.0, .choices = "Checkerboard|Horizontal stripes|Vertical stripes|Diagonal stripes|Dots|Grid|Bricks|Hexagons|Canvas weave|Paper grain|Wood grain|Clouds|Hatching|Cross-hatching|Waves|Scales|Noise|Diamonds", .choicesGerman = "Schachbrett|Waagrechte Streifen|Senkrechte Streifen|Schräge Streifen|Punkte|Gitter|Ziegelmauer|Sechsecke|Leinwandbindung|Papierkorn|Holzmaserung|Wolken|Schraffur|Kreuzschraffur|Wellen|Schuppen|Rauschen|Rauten" },
    types.Param.{ .name = "Scale", .german = "Größe", .kind = types.FLOAT, .low = 0.05, .high = 20.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Rotation", .german = "Drehung", .kind = types.ANGLE, .low = -180.0, .high = 180.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Offset x", .german = "Versatz x", .kind = types.INT, .low = -100000.0, .high = 100000.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Offset y", .german = "Versatz y", .kind = types.INT, .low = -100000.0, .high = 100000.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// The tile at (u, v) of its pixels (pixel centres at whole numbers),
// mixed from the four around it; the tile repeats.
fn sample(tile: [*]const u32, size: usize, u: f64, v: f64) -> u32 {
    const fu = @floor(u)
    const fv = @floor(v)
    if !(fu > -LIMIT && fu < LIMIT && fv > -LIMIT && fv < LIMIT) { return tile[0] }
    const period = @intCast(i64, size)
    const left = @intCast(usize, around(@intFromFloat(i64, fu), period))
    const top = @intCast(usize, around(@intFromFloat(i64, fv), period))
    const right = if left + 1 == size { 0 } else { left + 1 }
    const bottom = if top + 1 == size { 0 } else { top + 1 }
    // (On a pixel's centre the share is 0: the pixel itself, exactly.)
    const across = unitByte(u - fu)
    const down = unitByte(v - fv)
    const upper = pixel.mix(tile[top * size + left], tile[top * size + right], across)
    const lower = pixel.mix(tile[bottom * size + left], tile[bottom * size + right], across)
    return pixel.mix(upper, lower, down)
}

// The Pattern generator: a built-in pattern over the image, its tile
// `scale` times its size, turned by `rotation` degrees (clockwise on the
// screen) about the image's corner and moved by the offset. At scale 1,
// no turn and whole offsets the image's pixels are the tile's own.
pub fn renderPattern(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void {
    const area = geom.rect(area_x, area_y, area_width, area_height)
    if geom.isEmpty(area) { return }
    const rows = rowsOf(PATTERN_ROWS)
    const index = @intFromFloat(usize, numberOf(params, rows, 0) + 0.5)
    const scale = numberOf(params, rows, 1)
    const angle = radians(numberOf(params, rows, 2))
    const offset_x = numberOf(params, rows, 3)
    const offset_y = numberOf(params, rows, 4)
    var width: usize = 0
    var height: usize = 0
    const tile = pattern(index, &width, &height)
    if tile == null {
        flood(area, into, stride, 0)
        return
    }
    // From the image to the tile: back by the offset, back by the turn,
    // down by the scale.
    const c = math.cos(angle) / scale
    const s = math.sin(angle) / scale
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        const py = @floatFromInt(f64, area.y) + @floatFromInt(f64, row) + 0.5 - offset_y
        const target = into + row * stride
        var column: usize = 0
        while column < @intCast(usize, area.width) {
            const px = @floatFromInt(f64, area.x) + @floatFromInt(f64, column) + 0.5 - offset_x
            target[column] = sample(tile.?, width, px * c + py * s - 0.5, py * c - px * s - 0.5)
            column += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// The Screentone generator

pub const SCREENTONE: u16 = 5

pub const SCREENTONE_PARAMS = [8]types.Param{
    types.Param.{ .name = "Pattern", .german = "Muster", .kind = types.CHOICE, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "Dots|Lines", .choicesGerman = "Punkte|Linien" },
    types.Param.{ .name = "Shape", .german = "Form", .kind = types.CHOICE, .low = 0.0, .high = 3.0, .initial = 0.0, .choices = "Round|Ellipse|Diamond|Square", .choicesGerman = "Rund|Ellipse|Raute|Quadrat" },
    types.Param.{ .name = "Frequency (cells per 100 pixels)", .german = "Frequenz (Zellen je 100 Pixel)", .kind = types.FLOAT, .low = 0.5, .high = 50.0, .initial = 10.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Rotation", .german = "Drehung", .kind = types.ANGLE, .low = -180.0, .high = 180.0, .initial = 45.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Brightness", .german = "Helligkeit", .kind = types.FLOAT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Contrast", .german = "Kontrast", .kind = types.FLOAT, .low = 0.0, .high = 100.0, .initial = 90.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Foreground", .german = "Vordergrund", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4278190080.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Background", .german = "Hintergrund", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
}

// How much a screen cell's point (fu, fv) (each -0.5..0.5 from the
// cell's middle) is towards the middle of a dot or a line: 1 there,
// about 0 at the cell's edge.
fn screenValue(lines: bool, shape: u32, fu: f64, fv: f64) -> f64 {
    if lines { return 1.0 - 2.0 * math.abs(fv) }
    if shape == 1 {
        const a = fu * 0.8
        const b = fv * 1.25
        return 1.0 - @sqrt(a * a + b * b) * math.sqrt2
    }
    if shape == 2 { return 1.0 - (math.abs(fu) + math.abs(fv)) }
    if shape == 3 { return 1.0 - 2.0 * math.max(math.abs(fu), math.abs(fv)) }
    return 1.0 - @sqrt(fu * fu + fv * fv) * math.sqrt2
}

// The Screentone generator: a raster of dots (or lines) of the
// foreground colour on the background, `frequency` cells to 100 pixels,
// turned by `rotation` degrees. Brightness says how much is ink: at
// -100 everything, at 100 nothing; contrast how hard the dots' edges
// are (at 100 as hard as a pixel allows).
pub fn renderScreentone(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void {
    const area = geom.rect(area_x, area_y, area_width, area_height)
    if geom.isEmpty(area) { return }
    const rows = rowsOf(SCREENTONE_ROWS)
    const lines = noise.isOn(numberOf(params, rows, 0))
    const shape = @intFromFloat(u32, numberOf(params, rows, 1) + 0.5)
    const cell = 100.0 / numberOf(params, rows, 2)
    const angle = radians(numberOf(params, rows, 3))
    const brightness = numberOf(params, rows, 4)
    const contrast = numberOf(params, rows, 5)
    const foreground = colorOf(numberOf(params, rows, 6))
    const background = colorOf(numberOf(params, rows, 7))
    const ink = (100.0 - brightness) / 200.0
    if ink <= 0.0 {
        flood(area, into, stride, background)
        return
    }
    if ink >= 1.0 {
        flood(area, into, stride, foreground)
        return
    }
    const threshold = 1.0 - ink
    // How wide the step from paper to ink is, in the value's units: what
    // the contrast leaves soft, and at least what a pixel spans.
    const soft = (1.0 - contrast / 100.0) * 0.5 + 1.5 / cell
    const c = math.cos(angle) / cell
    const s = math.sin(angle) / cell
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        const py = @floatFromInt(f64, area.y) + @floatFromInt(f64, row) + 0.5
        const target = into + row * stride
        var column: usize = 0
        while column < @intCast(usize, area.width) {
            const px = @floatFromInt(f64, area.x) + @floatFromInt(f64, column) + 0.5
            const u = px * c + py * s
            const v = py * c - px * s
            const value = screenValue(lines, shape, fraction(u) - 0.5, fraction(v) - 0.5)
            target[column] = pixel.mix(background, foreground, unitByte((value - threshold) / soft + 0.5))
            column += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// The Multigrid generator

pub const MULTIGRID: u16 = 4

const MOST_FAMILIES: usize = 12

pub const MULTIGRID_PARAMS = [9]types.Param{
    types.Param.{ .name = "Dimensions", .german = "Dimensionen", .kind = types.INT, .low = 3.0, .high = 12.0, .initial = 5.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Line spacing", .german = "Linienabstand", .kind = types.FLOAT, .low = 2.0, .high = 1000.0, .initial = 40.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Offset", .german = "Versatz", .kind = types.FLOAT, .low = 0.0, .high = 1.0, .initial = 0.2, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Line width", .german = "Linienbreite", .kind = types.FLOAT, .low = 0.0, .high = 20.0, .initial = 1.5, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Rotation", .german = "Drehung", .kind = types.ANGLE, .low = -180.0, .high = 180.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Line colour", .german = "Linienfarbe", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4278190080.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour 1", .german = "Farbe 1", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294240720.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour 2", .german = "Farbe 2", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4282345128.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour the cells", .german = "Zellen färben", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
}

// The Multigrid generator: `dimensions` families of parallel lines
// `spacing` pixels apart, family j across the direction rotation +
// 180° j / dimensions, all shifted by `offset` of a spacing (de Bruijn's
// gamma; the pentagrid of 5 families is Penrose's). A cell between the
// lines is numbered by the strips it lies in, family by family; the sum
// of those numbers modulo the dimensions picks its colour from colour 1
// to colour 2. The lines are drawn over it, `width` pixels wide.
pub fn renderMultigrid(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void {
    const area = geom.rect(area_x, area_y, area_width, area_height)
    if geom.isEmpty(area) { return }
    const rows = rowsOf(MULTIGRID_ROWS)
    const families = @intFromFloat(usize, numberOf(params, rows, 0) + 0.5)
    const spacing = numberOf(params, rows, 1)
    const offset = numberOf(params, rows, 2)
    const half = numberOf(params, rows, 3) * 0.5
    const turn = radians(numberOf(params, rows, 4))
    const line_color = colorOf(numberOf(params, rows, 5))
    const first = colorOf(numberOf(params, rows, 6))
    const second = colorOf(numberOf(params, rows, 7))
    const cells = noise.isOn(numberOf(params, rows, 8))
    // Each family's direction over the spacing: a pixel's strip is its
    // place along that direction.
    var across: [12]f64 = undefined
    var down: [12]f64 = undefined
    var family: usize = 0
    while family < families && family < MOST_FAMILIES {
        const angle = turn + math.pi * @floatFromInt(f64, family) / @floatFromInt(f64, families)
        across[family] = math.cos(angle) / spacing
        down[family] = math.sin(angle) / spacing
        family += 1
    }
    const period = @intCast(i64, families)
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        const py = @floatFromInt(f64, area.y) + @floatFromInt(f64, row) + 0.5
        const target = into + row * stride
        var column: usize = 0
        while column < @intCast(usize, area.width) {
            const px = @floatFromInt(f64, area.x) + @floatFromInt(f64, column) + 0.5
            var line: f64 = 0.0
            var index: i64 = 0
            family = 0
            while family < families {
                const place = px * across[family] + py * down[family] + offset
                const strip = @floor(place)
                if strip > -LIMIT && strip < LIMIT { index += @intFromFloat(i64, strip) }
                // How far the pixel's centre is from the nearer line, in
                // pixels, and how much of the pixel that line covers.
                const part = place - strip
                const distance = math.min(part, 1.0 - part) * spacing
                const covered = math.clamp(half - distance + 0.5, 0.0, 1.0)
                if covered > line { line = covered }
                family += 1
            }
            var fill = first
            if cells {
                const step = around(index, period)
                fill = pixel.mix(first, second, @intCast(u32, step * 255 / (period - 1)))
            }
            target[column] = pixel.mix(fill, line_color, unitByte(line))
            column += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// Checker and Stripes

pub const CHECKER: u16 = 6

pub const CHECKER_PARAMS = [3]types.Param{
    types.Param.{ .name = "Size", .german = "Größe", .kind = types.INT, .low = 1.0, .high = 4096.0, .initial = 32.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour 1", .german = "Farbe 1", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour 2", .german = "Farbe 2", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4290822336.0, .choices = "", .choicesGerman = "" },
}

// The Checker generator: squares of `size` pixels from the image's
// corner, colour 1 where the corner's square is.
pub fn renderChecker(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void {
    const area = geom.rect(area_x, area_y, area_width, area_height)
    if geom.isEmpty(area) { return }
    const rows = rowsOf(CHECKER_ROWS)
    const size = @intFromFloat(i64, numberOf(params, rows, 0) + 0.5)
    const first = colorOf(numberOf(params, rows, 1))
    const second = colorOf(numberOf(params, rows, 2))
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        const y = @intCast(i64, area.y) + @intCast(i64, row)
        // (Squares counted down from the corner: rounded down, also
        // above and left of it.)
        const down = (y - around(y, size)) / size
        const target = into + row * stride
        var column: usize = 0
        while column < @intCast(usize, area.width) {
            const x = @intCast(i64, area.x) + @intCast(i64, column)
            const across = (x - around(x, size)) / size
            target[column] = if (across + down) & 1 == 0 { first } else { second }
            column += 1
        }
        row += 1
    }
}

pub const STRIPES: u16 = 7

pub const STRIPES_PARAMS = [4]types.Param{
    types.Param.{ .name = "Width", .german = "Breite", .kind = types.FLOAT, .low = 1.0, .high = 4096.0, .initial = 16.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Angle", .german = "Winkel", .kind = types.ANGLE, .low = -180.0, .high = 180.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour 1", .german = "Farbe 1", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour 2", .german = "Farbe 2", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4278190080.0, .choices = "", .choicesGerman = "" },
}

// The Stripes generator: stripes of colour 1 and colour 2 in turn, each
// `width` pixels wide, at `angle` degrees (0: across, one under the
// other), colour 1 from the image's corner on. Where an edge crosses a
// pixel the pixel is the mix of what it covers.
pub fn renderStripes(params: *const Params, area_x: i32, area_y: i32, area_width: i32, area_height: i32, into: [*]u32, stride: usize, image_width: i32, image_height: i32) -> void {
    const area = geom.rect(area_x, area_y, area_width, area_height)
    if geom.isEmpty(area) { return }
    const rows = rowsOf(STRIPES_ROWS)
    const width = numberOf(params, rows, 0)
    const angle = radians(numberOf(params, rows, 1))
    const first = colorOf(numberOf(params, rows, 2))
    const second = colorOf(numberOf(params, rows, 3))
    const period = width * 2.0
    const nx = -math.sin(angle)
    const ny = math.cos(angle)
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        const py = @floatFromInt(f64, area.y) + @floatFromInt(f64, row) + 0.5
        const target = into + row * stride
        var column: usize = 0
        while column < @intCast(usize, area.width) {
            const px = @floatFromInt(f64, area.x) + @floatFromInt(f64, column) + 0.5
            // The centre's place in its period: colour 1 up to `width`,
            // colour 2 from there; the pixel as a span of one around it.
            const along = px * nx + py * ny
            const place = (along / period - @floor(along / period)) * period
            const into_second = math.clamp(math.min(place + 0.5, period) - math.max(place - 0.5, width), 0.0, 1.0)
            const from_before = math.clamp(0.5 - place, 0.0, 1.0)
            target[column] = pixel.mix(first, second, unitByte(into_second + from_before))
            column += 1
        }
        row += 1
    }
}
