// nebula brush: the sketch engine ("sketch"), Krita's sketch brush: the
// web of thin lines of the "harmony" drawing toys. Every dab is joined to
// the dab before it by a thin line, and to each earlier point of the
// stroke within its reach, by chance, with another thin line cut short
// at both ends: where the pen comes back near where it was, the space
// between fills with hatching.
//
// Its numbers in Settings.values (values() lists them with their ranges
// and defaults; defaults() makes a sketch brush):
//
//   0  line width        pixels (0.05 to 20; 1)
//   1  density           0..1: the chance that an earlier point within
//                        reach is joined to the dab (0.5); 0: none is
//   2  offset            -1..0.5: the part of each joining line left off
//                        at both of its ends (0.3; below 0 the line
//                        reaches beyond both points)
//   3  reach             in dab diameters (0 to 100; 1): how close an
//                        earlier point must be to be joined
//   4  connection line   1: a line from the dab before (1)
//   5  distance opacity  1: a joining line is the fainter the farther
//                        its points are apart, nothing at the reach (0)
//   6  distance density  1: the chance falls the same way (0)
//   7  history           points of the stroke kept for joining, 2 to
//                        4096 (1024): the oldest go first
//
// A tap paints a dot of the line's width. Each copy of a dab (mirrored)
// keeps its own points (see "Copies" below). Not done: Krita's
// magnetify, random RGB and random opacity, simple mode.
//
// ---------------------------------------------------------------------------
// This module also carries what the procedural engines of its family
// share (spray, hairy, shape, particle, hatching, curve, grid and dyna
// import it): the Ink, the way what they draw reaches the stroke's
// target, and helpers for lines, shapes, chance and an engine's numbers.
//
// An engine builds what a dab draws as a path (core/raster.mlx) in
// ink.path (lines by segment(), shapes by ellipseAt() and boxAt(), all
// clockwise on the screen so that NONZERO fills their union) and fills
// it through the ink, or hands rows of coverage (inkRow) or a tip's mask
// (inkMask) to it:
//
//     const ink = inkOf(stroke)            // made in begin() by inkCreate
//     inkFor(ink, stroke, dab)             // colour, opacity, flow, where
//     segment(ink.*.path, x0, y0, x1, y1, 1.0)
//     inkFill(ink, ink.*.path, raster.NONZERO)
//     return inkBox(ink)                   // what was written since inkFor
//
// The ink paints as brush/pixel_engine.mlx does: on an indirect target
// (wash) it raises the overlay's alpha toward the cap, mul(dab opacity,
// colour alpha), by coverage times flow, mixing the colour by the same
// part, and never beyond the cap however often a pixel is covered; on a
// direct target (build-up) it mixes into the layer by Settings.blend
// (blend.ERASE for an eraser) at opacity times flow, through the
// selection's amounts, keeping alpha where it is locked. inkStrength()
// makes one fill fainter (a coverage factor), inkColor() gives one fill
// another colour (the dab's alpha stays). Everything is drawn inside the
// stroke's clip (wrap-around), and nothing on a device placed farther
// than 2 to the 30th from the image's origin.
//
// Copies: the dabs the framework paints for a mirrored target are told
// apart by Dab.copy (0 the dab, 1 to 3 its mirror images). An engine that
// joins a dab to the one before keeps what it remembers per copy, for
// copies below SLOTS. With wrap-around the copies of a dab near the
// image's edges are numbered by which of them exist, so there such an
// engine may join a copy to another's place; copies from SLOTS on remember
// nothing (they paint as a first dab).
const std = @import("std")
const math = @import("std.math")
const random = @import("std.random")
const types = @import("./types.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const device_module = @import("../core/device.mlx")
const mask_module = @import("../core/mask.mlx")
const blend = @import("../core/blend.mlx")
const raster = @import("../core/raster.mlx")
const color_module = @import("../core/color.mlx")
const table = @import("../core/table.mlx")

pub const Rect = geom.Rect
pub const Allocator = std.allocator.Allocator

// How many copies of a dab an engine remembers things for.
pub const SLOTS: usize = 8

// Nothing is drawn farther from the image's origin than this (as
// core/raster.mlx's fills into devices): every column and row then fits
// an i32 with room to add a tile.
const FAR: i32 = 1073741823

// ---------------------------------------------------------------------------
// An engine's numbers

// One of an engine's numbers in Settings.values (row N of an engine's
// values() is Settings.values[N]): its name in preset files and for
// people, its range and what defaults() sets it to.
pub const Value = struct {
    key: []const u8
    name: []const u8
    german: []const u8
    low: f64
    high: f64
    initial: f64
}

// Number `index` of the stroke's brush (Settings.values), held to the
// range of row `index` of the engine's `list` (what is no number: the
// range's low end).
pub fn number(stroke: *types.Stroke, list: []const Value, index: usize) -> f64 {
    const raw = @floatCast(f64, stroke.*.settings.*.values[index])
    if !(raw >= list[index].low) { return list[index].low }
    if raw > list[index].high { return list[index].high }
    return raw
}

// Whether an on-or-off number is on (one half or more).
pub fn isSet(stroke: *types.Stroke, list: []const Value, index: usize) -> bool {
    return number(stroke, list, index) >= 0.5
}

// A whole number: number() rounded, from one half up (0 for a number
// below 0).
pub fn count(stroke: *types.Stroke, list: []const Value, index: usize) -> usize {
    const value = number(stroke, list, index)
    if !(value > 0.0) { return 0 }
    return @intFromFloat(usize, value + 0.5)
}

// Every number of `list` set to its default in `settings` (the others
// left as they are).
pub fn applyValues(settings: *types.Settings, list: []const Value) -> void {
    var index: usize = 0
    while index < list.length && index < types.VALUES {
        settings.*.values[index] = @floatCast(f32, list[index].initial)
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Chance

// A random number 0..1 from the stroke's own numbers (the same seed and
// input, the same numbers).
pub fn chance(stroke: *types.Stroke) -> f64 {
    return random.unit(&stroke.*.state.random)
}

// A number of the standard normal distribution (mean 0, deviation 1),
// from two of the stroke's random numbers (Box and Muller).
pub fn gaussian(stroke: *types.Stroke) -> f64 {
    var u = chance(stroke)
    const v = chance(stroke)
    if u < 1.0e-300 { u = 1.0e-300 }
    return @sqrt(-2.0 * math.ln(u)) * math.cos(math.tau * v)
}

// `color` with its hue turned by `hue` (a part of the full turn) and its
// saturation and value moved by `saturation` and `value` (held to 0..1
// after); alpha kept.
pub fn shiftedColor(color: u32, hue: f64, saturation: f64, value: f64) -> u32 {
    var h: f64 = 0.0
    var s: f64 = 0.0
    var v: f64 = 0.0
    color_module.toHsv(color, &h, &s, &v)
    return color_module.fromHsv(h + hue, math.clamp(s + saturation, 0.0, 1.0), math.clamp(v + value, 0.0, 1.0), color >> 24)
}

// ---------------------------------------------------------------------------
// Shapes into a path, all clockwise on the screen (as raster.mlx's own),
// so that NONZERO fills the union of any number of them.

// The line from (x0, y0) to (x1, y1), `width` wide, with square ends
// (half the width beyond each point, so that lines joined end to end
// overlap and leave no gap where they turn). A line of no length is a
// square of the width around its point.
pub fn segment(path: *raster.Path, x0: f64, y0: f64, x1: f64, y1: f64, width: f64) -> void {
    const half = width * 0.5
    var dx = x1 - x0
    var dy = y1 - y0
    const length = math.hypot(dx, dy)
    if length > 0.000001 {
        dx = dx / length
        dy = dy / length
    } else {
        dx = 1.0
        dy = 0.0
    }
    const ax = x0 - dx * half
    const ay = y0 - dy * half
    const bx = x1 + dx * half
    const by = y1 + dy * half
    // The normal, to the right of the way on the screen (y points down).
    const nx = 0.0 - dy * half
    const ny = dx * half
    raster.moveTo(path, ax - nx, ay - ny)
    raster.lineTo(path, bx - nx, by - ny)
    raster.lineTo(path, bx + nx, by + ny)
    raster.lineTo(path, ax + nx, ay + ny)
    raster.close(path)
}

// The four-sided piece of a band from the cross-section through (x0, y0)
// with half-width h0 to the one through (x1, y1) with half-width h1, both
// across the way between the two points (a band's joints are covered by
// discs at its points: disc()).
pub fn trapezoid(path: *raster.Path, x0: f64, y0: f64, h0: f64, x1: f64, y1: f64, h1: f64) -> void {
    const dx = x1 - x0
    const dy = y1 - y0
    const length = math.hypot(dx, dy)
    if !(length > 0.000001) { return }
    const nx = 0.0 - dy / length
    const ny = dx / length
    raster.moveTo(path, x0 - nx * h0, y0 - ny * h0)
    raster.lineTo(path, x1 - nx * h1, y1 - ny * h1)
    raster.lineTo(path, x1 + nx * h1, y1 + ny * h1)
    raster.lineTo(path, x0 + nx * h0, y0 + ny * h0)
    raster.close(path)
}

// The circle around (cx, cy).
pub fn disc(path: *raster.Path, cx: f64, cy: f64, radius: f64) -> void {
    if !(radius > 0.0) { return }
    raster.circle(path, cx, cy, radius)
}

// The ellipse around (cx, cy) with the radii rx (along its own x) and ry,
// turned by `turn` radians (clockwise on the screen): a polygon of so
// many corners that its sides are within a tenth of a pixel of the curve
// (at most 1024). Nothing for a radius of 0 or one beyond 100000.
pub fn ellipseAt(path: *raster.Path, cx: f64, cy: f64, rx: f64, ry: f64, turn: f64) -> void {
    if !(rx > 0.0) || !(ry > 0.0) { return }
    const largest = if rx > ry { rx } else { ry }
    if largest > 100000.0 { return }
    // A side of the angle a lies (1 - cos(a/2)) r inside the curve: at
    // most a tenth of a pixel.
    var corners = math.ceil(math.pi / math.acos(1.0 - 0.1 / (if largest > 0.1 { largest } else { 0.1 })))
    if corners < 8.0 { corners = 8.0 }
    if corners > 1024.0 { corners = 1024.0 }
    const c = math.cos(turn)
    const s = math.sin(turn)
    const step = math.tau / corners
    var corner: f64 = 0.0
    while corner < corners {
        const angle = corner * step
        const ex = rx * math.cos(angle)
        const ey = ry * math.sin(angle)
        const x = cx + ex * c - ey * s
        const y = cy + ex * s + ey * c
        if corner == 0.0 { raster.moveTo(path, x, y) } else { raster.lineTo(path, x, y) }
        corner += 1.0
    }
    raster.close(path)
}

// The rectangle `width` x `height` around (cx, cy), turned by `turn`
// radians.
pub fn boxAt(path: *raster.Path, cx: f64, cy: f64, width: f64, height: f64, turn: f64) -> void {
    if !(width > 0.0) || !(height > 0.0) { return }
    const c = math.cos(turn)
    const s = math.sin(turn)
    const hx = width * 0.5
    const hy = height * 0.5
    raster.moveTo(path, cx + (0.0 - hx) * c - (0.0 - hy) * s, cy + (0.0 - hx) * s + (0.0 - hy) * c)
    raster.lineTo(path, cx + hx * c - (0.0 - hy) * s, cy + hx * s + (0.0 - hy) * c)
    raster.lineTo(path, cx + hx * c - hy * s, cy + hx * s + hy * c)
    raster.lineTo(path, cx + (0.0 - hx) * c - hy * s, cy + (0.0 - hx) * s + hy * c)
    raster.close(path)
}

// ---------------------------------------------------------------------------
// The ink

pub const Ink = struct {
    device: *device_module.Device
    direct: bool
    selection: ?*device_module.Device
    flags: u32
    mode: u16
    // The colour of what is filled next (straight; inkColor), and the
    // dab's alpha it keeps.
    color: u32
    alpha: u32
    // Wash: the alpha the overlay rises to at most and the flow, 0-255.
    // Direct: opacity times flow.
    cap: u32
    flow: u32
    opacity: u32
    // Coverage times this (0-255) for the next fills.
    strength: u32
    antialias: bool
    // Nothing would change: no opacity or flow, or (direct) a colour of
    // alpha 0 in a blend mode that leaves the layer alone where the
    // source is transparent.
    idle: bool
    // Where fills paint: the stroke's clip, or as far as devices reach;
    // and whether the device is placed where that can be counted.
    area: Rect
    usable: bool
    // The box around what was written since inkFor (left == right:
    // nothing).
    left: i32
    top: i32
    right: i32
    bottom: i32
    // Direct: 64 pixels of the colour, what blend.compositeSpanAt mixes.
    rowColor: u32
    rowReady: bool
    row: [64]u32
    // A piece of a row: its amounts, and the selection's.
    amounts: [64]u8
    chosen: [64]u8
    // Where engines build what they fill, and room for an outline
    // (raster.stroke's).
    path: *raster.Path
    outline: *raster.Path
}

// An ink in heap memory, with its paths. Null without memory.
pub fn inkCreate(allocator: Allocator) -> ?*Ink {
    const memory = allocator.alloc(@sizeOf(Ink), 16)
    if memory == null { return null }
    const path = raster.create(allocator)
    const outline = raster.create(allocator)
    if path == null || outline == null {
        if path != null { raster.destroy(path.?) }
        if outline != null { raster.destroy(outline.?) }
        allocator.free(memory.?, @sizeOf(Ink), 16)
        return null
    }
    const ink: *Ink = unsafe { @ptrCast(*Ink, memory.?) }
    ink.*.path = path.?
    ink.*.outline = outline.?
    ink.*.usable = false
    ink.*.idle = true
    ink.*.rowReady = false
    ink.*.selection = null
    ink.*.strength = 255
    ink.*.left = 0
    ink.*.right = 0
    ink.*.top = 0
    ink.*.bottom = 0
    return ink
}

// Gives the ink's memory back (inkCreate's allocator).
pub fn inkDestroy(ink: *Ink, allocator: Allocator) -> void {
    raster.destroy(ink.*.path)
    raster.destroy(ink.*.outline)
    unsafe { allocator.free(@ptrCast([*]u8, ink), @sizeOf(Ink), 16) }
}

// The begin() of an engine whose stroke state is an ink alone: the ink
// made and put into Stroke.engineState. False without memory.
pub fn beginInk(stroke: *types.Stroke) -> bool {
    const ink = inkCreate(stroke.*.allocator)
    if ink == null { return false }
    stroke.*.engineState = @intFromPtr(ink.?)
    return true
}

// The free() of such an engine: the ink given back.
pub fn freeInk(stroke: *types.Stroke) -> void {
    if stroke.*.engineState == 0 { return }
    inkDestroy(inkOf(stroke), stroke.*.allocator)
    stroke.*.engineState = 0
}

// The ink of such an engine's stroke (beginInk made it).
pub fn inkOf(stroke: *types.Stroke) -> *Ink {
    unsafe { return @ptrFromInt(*Ink, stroke.*.engineState) }
}

// 0..1 as 0..255.
fn level(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 1.0 { return 255 }
    return @intFromFloat(u32, value * 255.0 + 0.5)
}

inline fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }
inline fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }

fn settled(plane: *device_module.Device) -> bool {
    return plane.*.x > 0 - FAR && plane.*.x < FAR && plane.*.y > 0 - FAR && plane.*.y < FAR
}

// The ink set up for a dab: its colour, opacity and flow, the stroke's
// target and clip, full strength, nothing written yet.
pub fn inkFor(ink: *Ink, stroke: *types.Stroke, dab: *const types.Dab) -> void {
    inkWith(ink, stroke, dab.*.color, dab.*.opacity, dab.*.flow)
}

// The same for a dab of `color` (straight), `opacity` and `flow` (0..1):
// what an engine that paints at the stroke's end kept of the last dab it
// painted (stroke.dab is the last one placed, which may have had nothing
// to paint).
pub fn inkWith(ink: *Ink, stroke: *types.Stroke, color: u32, opacity: f64, flow: f64) -> void {
    const settings = stroke.*.settings
    const target = &stroke.*.target
    const onto = target.*.device
    ink.*.device = onto
    ink.*.direct = target.*.direct
    ink.*.selection = null
    ink.*.flags = 0
    if target.*.direct {
        ink.*.selection = target.*.selection
        if target.*.alphaLock { ink.*.flags = blend.FLAG_ALPHA_LOCK }
    }
    const eraser = settings.*.eraser
    ink.*.mode = if eraser { blend.ERASE } else { settings.*.blend }
    // (An eraser takes away by coverage alone: its colour is no matter.)
    ink.*.color = if eraser { pixel.BLACK } else { color }
    ink.*.alpha = ink.*.color >> 24
    ink.*.cap = pixel.mul(level(opacity), ink.*.alpha)
    ink.*.flow = level(flow)
    ink.*.opacity = level(opacity * flow)
    ink.*.strength = 255
    ink.*.antialias = settings.*.tip.antialias
    // (A transparent colour mixed in by NORMAL changes no pixel, but every
    // tile it went over would be made and kept for the undo: as
    // raster.fillDevice, it writes nothing. inkColor keeps the alpha.)
    const transparent = ink.*.alpha == 0 && !blend.affectsWithoutSource(ink.*.mode)
    ink.*.idle = if target.*.direct { ink.*.opacity == 0 || transparent } else { ink.*.cap == 0 || ink.*.flow == 0 }
    var x0: i32 = 0 - FAR
    var y0: i32 = 0 - FAR
    var x1: i32 = FAR
    var y1: i32 = FAR
    if stroke.*.clipped {
        x0 = larger(x0, stroke.*.clip.x)
        y0 = larger(y0, stroke.*.clip.y)
        x1 = smaller(x1, stroke.*.clip.x + stroke.*.clip.width)
        y1 = smaller(y1, stroke.*.clip.y + stroke.*.clip.height)
    }
    ink.*.area.x = x0
    ink.*.area.y = y0
    ink.*.area.width = if x1 > x0 { x1 - x0 } else { 0 }
    ink.*.area.height = if y1 > y0 { y1 - y0 } else { 0 }
    ink.*.usable = x1 > x0 && y1 > y0 && settled(onto) && (ink.*.selection == null || settled(ink.*.selection.?))
    ink.*.left = 0
    ink.*.right = 0
    ink.*.top = 0
    ink.*.bottom = 0
}

// The next fills in `rgb` (the low 24 bits count; the dab's alpha stays).
// An eraser's ink keeps erasing.
pub fn inkColor(ink: *Ink, rgb: u32) -> void {
    if ink.*.mode == blend.ERASE { return }
    ink.*.color = (ink.*.alpha << 24) | (rgb & 0x00FFFFFF)
}

// The next fills' coverage times `part` (0..1).
pub fn inkStrength(ink: *Ink, part: f64) -> void {
    ink.*.strength = level(part)
}

// The image's rectangle around everything the ink wrote since inkFor
// (empty: nothing).
pub fn inkBox(ink: *Ink) -> Rect {
    return geom.rect(ink.*.left, ink.*.top, ink.*.right - ink.*.left, ink.*.bottom - ink.*.top)
}

// Unites (left, top, right, bottom) with the ink's box: what an engine
// changed besides by the ink (it clears what it showed).
pub fn inkNote(ink: *Ink, left: i32, top: i32, right: i32, bottom: i32) -> void {
    if right <= left || bottom <= top { return }
    if ink.*.right <= ink.*.left {
        ink.*.left = left
        ink.*.top = top
        ink.*.right = right
        ink.*.bottom = bottom
        return
    }
    if left < ink.*.left { ink.*.left = left }
    if top < ink.*.top { ink.*.top = top }
    if right > ink.*.right { ink.*.right = right }
    if bottom > ink.*.bottom { ink.*.bottom = bottom }
}

// (x + 32512) / 65025, x up to 255^3, is (x + 32512) times this >> 40,
// exactly (as in brush/pixel_engine.mlx).
const BY_65025: u64 = 16909061

// The wash rule of brush/pixel_engine.mlx for `count` pixels of a row:
// alpha rises by (cap - alpha) cover flow / 255^2 where it is below the
// cap, the colour moves toward `rgb` by mul(cover, flow).
fn raise(under: [*]u32, cover: [*]const u8, length: usize, rgb: u32, cap: u32, flow: u32) -> void {
    const r = (rgb >> 16) & 255
    const g = (rgb >> 8) & 255
    const b = rgb & 255
    var index: usize = 0
    while index < length {
        const amount = @intCast(u32, cover[index]) * flow
        if amount != 0 {
            const before = under[index]
            const alpha = before >> 24
            var raised = alpha
            if alpha < cap {
                const product = @intCast(u64, (cap - alpha) * amount) + 32512
                raised = alpha + @intCast(u32, (product * BY_65025) >> 40)
            }
            const colour = before & 0x00FFFFFF
            if alpha == 0 {
                if raised != 0 { under[index] = (raised << 24) | rgb }
            } else if raised != alpha || colour != rgb {
                var mixed = colour
                if colour != rgb {
                    const scaled = amount + 128
                    const weight = (scaled + (scaled >> 8)) >> 8
                    const keep = 255 - weight
                    const red = ((before >> 16) & 255) * keep + r * weight + 128
                    const green = ((before >> 8) & 255) * keep + g * weight + 128
                    const blue = (before & 255) * keep + b * weight + 128
                    mixed = (((red + (red >> 8)) >> 8) << 16) | (((green + (green >> 8)) >> 8) << 8) | ((blue + (blue >> 8)) >> 8)
                }
                under[index] = (raised << 24) | mixed
            }
        }
        index += 1
    }
}

// `length` bytes of coverage (0 nothing, 255 all) for row `y` from
// column `x` on, through the ink into its target (only inside its area;
// pieces of a tile's row with nothing to paint make no tile).
pub fn inkRow(ink: *Ink, y: i32, x: i32, coverage: [*]const u8, length: usize) -> void {
    if !ink.*.usable || ink.*.idle || ink.*.strength == 0 || length == 0 { return }
    if y < ink.*.area.y || y >= ink.*.area.y + ink.*.area.height { return }
    // (In i64: a row handed in may begin anywhere.)
    const begin64 = @intCast(i64, x)
    const end64 = begin64 + @intCast(i64, length)
    const left64 = @intCast(i64, ink.*.area.x)
    const right64 = left64 + @intCast(i64, ink.*.area.width)
    if end64 <= left64 || begin64 >= right64 { return }
    var done: usize = 0
    var last = length
    if begin64 < left64 { done = @intCast(usize, left64 - begin64) }
    if end64 > right64 { last = @intCast(usize, right64 - begin64) }
    const device = ink.*.device
    const ly = y - device.*.y
    const row = @intCast(usize, (ly & 63) << 6)
    const rgb = ink.*.color & 0x00FFFFFF
    const strength = ink.*.strength
    const amounts: [*]u8 = &ink.*.amounts
    const chosen: [*]u8 = &ink.*.chosen
    while done < last {
        // (Inside the area: an i32, whatever `done` is.)
        const column = @intCast(i32, begin64 + @intCast(i64, done))
        const px = column - device.*.x
        const within = @intCast(usize, px & 63)
        var piece = 64 - within
        if piece > last - done { piece = last - done }
        var most: u32 = 0
        var least: u32 = 255
        var index: usize = 0
        while index < piece {
            var amount = @intCast(u32, coverage[done + index])
            if strength != 255 { amount = pixel.mul(amount, strength) }
            amounts[index] = @intCast(u8, amount)
            if amount > most { most = amount }
            if amount < least { least = amount }
            index += 1
        }
        if most != 0 && ink.*.selection != null {
            mask_module.readBytes(ink.*.selection.?, geom.rect(column, y, @intCast(i32, piece), 1), chosen, piece)
            most = 0
            least = 255
            index = 0
            while index < piece {
                const amount = pixel.mul(@intCast(u32, amounts[index]), @intCast(u32, chosen[index]))
                amounts[index] = @intCast(u8, amount)
                if amount > most { most = amount }
                if amount < least { least = amount }
                index += 1
            }
        }
        if most != 0 {
            const pixels = device_module.tileWrite(device, px >> 6, ly >> 6)
            if pixels != null {
                const at = pixels.? + (row + within)
                if ink.*.direct {
                    if !ink.*.rowReady || ink.*.rowColor != ink.*.color {
                        device_module.fillWords(&ink.*.row, 64, ink.*.color)
                        ink.*.rowColor = ink.*.color
                        ink.*.rowReady = true
                    }
                    // (Without a mask where everything is covered whole:
                    // the blend's quick way.)
                    var weights: ?[*]const u8 = null
                    if least != 255 { weights = amounts }
                    blend.compositeSpanAt(ink.*.mode, at, &ink.*.row, piece, ink.*.opacity, weights, ink.*.flags, blend.seedAt(column, y))
                } else {
                    raise(at, amounts, piece, rgb, ink.*.cap, ink.*.flow)
                }
                inkNote(ink, column, y, column + @intCast(i32, piece), y + 1)
            }
        }
        done += piece
    }
}

// raster.fill's sink: rows of coverage into the ink.
fn sink(context: *anyopaque, y: i32, x: i32, coverage: [*]const u8, length: usize) -> void {
    const ink: *Ink = unsafe { @ptrCast(*Ink, context) }
    inkRow(ink, y, x, coverage, length)
}

// `path` filled by `rule` (raster.NONZERO, raster.EVEN_ODD) through the
// ink, anti-aliased when the brush's tip is; the path is empty after.
pub fn inkFill(ink: *Ink, path: *raster.Path, rule: u8) -> void {
    if ink.*.usable && !ink.*.idle && ink.*.strength != 0 && !raster.isEmpty(path) {
        raster.fill(path, rule, ink.*.antialias, ink.*.area, sink, ink)
    }
    raster.clear(path)
}

// A mask's coverage (a tip's: brush/tip.mlx, its x and y the image's
// place of its first byte) through the ink.
pub fn inkMask(ink: *Ink, mask: *const types.Mask) -> void {
    if !ink.*.usable || ink.*.idle { return }
    const width = @intCast(usize, mask.*.width)
    var row: i32 = 0
    while row < mask.*.height {
        inkRow(ink, mask.*.y + row, mask.*.x, mask.*.bytes + @intCast(usize, row) * width, width)
        row += 1
    }
}

// ---------------------------------------------------------------------------
// The sketch engine

const WIDTH: usize = 0
const DENSITY: usize = 1
const OFFSET: usize = 2
const REACH: usize = 3
const CONNECT: usize = 4
const DISTANCE_OPACITY: usize = 5
const DISTANCE_DENSITY: usize = 6
const HISTORY: usize = 7

const VALUES = [8]Value{
    Value.{ .key = "line_width", .name = "Line width", .german = "Linienbreite", .low = 0.05, .high = 20.0, .initial = 1.0 },
    Value.{ .key = "density", .name = "Density", .german = "Dichte", .low = 0.0, .high = 1.0, .initial = 0.5 },
    Value.{ .key = "offset", .name = "Offset", .german = "Versatz", .low = -1.0, .high = 0.5, .initial = 0.3 },
    Value.{ .key = "reach", .name = "Reach", .german = "Reichweite", .low = 0.0, .high = 100.0, .initial = 1.0 },
    Value.{ .key = "connection", .name = "Connection line", .german = "Verbindungslinie", .low = 0.0, .high = 1.0, .initial = 1.0 },
    Value.{ .key = "distance_opacity", .name = "Distance opacity", .german = "Deckkraft nach Abstand", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "distance_density", .name = "Distance density", .german = "Dichte nach Abstand", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "history", .name = "History", .german = "Verlauf", .low = 2.0, .high = 4096.0, .initial = 1024.0 },
}

var keptValues: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The engine's numbers (row N is Settings.values[N]).
pub fn values() -> []const Value {
    if keptValues.address != 0 { return table.rows(Value, &keptValues) }
    return table.keep(Value, &keptValues, VALUES[0..])
}

// A sketch brush: types.defaults() with this engine, 40 pixels (the
// reach), the size not by pressure, and the numbers' defaults.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Sketch")
    settings.*.engine = types.ENGINE_SKETCH
    settings.*.size = 40.0
    settings.*.options[types.OPTION_SIZE].on = false
    applyValues(settings, values())
}

// What a stroke keeps: the ink, and for each slot (copy of the dab) a
// ring of the points it went through and its last one.
const Own = struct {
    ink: *Ink
    // SLOTS rings of `capacity` points, x and y each.
    points: [*]f64
    capacity: usize
    filled: [8]usize
    next: [8]usize
    lastX: [8]f64
    lastY: [8]f64
    started: [8]bool
}

fn ownOf(stroke: *types.Stroke) -> *Own {
    unsafe { return @ptrFromInt(*Own, stroke.*.engineState) }
}

fn pointsBytes(capacity: usize) -> usize {
    return SLOTS * capacity * 2 * 8
}

fn begin(stroke: *types.Stroke) -> bool {
    const allocator = stroke.*.allocator
    const list = values()
    const capacity = count(stroke, list, HISTORY)
    const memory = allocator.alloc(@sizeOf(Own), 16)
    const points = allocator.alloc(pointsBytes(capacity), 16)
    const ink = inkCreate(allocator)
    if memory == null || points == null || ink == null {
        if memory != null { allocator.free(memory.?, @sizeOf(Own), 16) }
        if points != null { allocator.free(points.?, pointsBytes(capacity), 16) }
        if ink != null { inkDestroy(ink.?, allocator) }
        return false
    }
    const own: *Own = unsafe { @ptrCast(*Own, memory.?) }
    own.*.ink = ink.?
    unsafe { own.*.points = @ptrCast([*]f64, points.?) }
    own.*.capacity = capacity
    var slot: usize = 0
    while slot < SLOTS {
        own.*.filled[slot] = 0
        own.*.next[slot] = 0
        own.*.started[slot] = false
        slot += 1
    }
    stroke.*.engineState = @intFromPtr(own)
    return true
}

fn free(stroke: *types.Stroke) -> void {
    if stroke.*.engineState == 0 { return }
    const own = ownOf(stroke)
    const allocator = stroke.*.allocator
    inkDestroy(own.*.ink, allocator)
    unsafe { allocator.free(@ptrCast([*]u8, own.*.points), pointsBytes(own.*.capacity), 16) }
    unsafe { allocator.free(@ptrCast([*]u8, own), @sizeOf(Own), 16) }
    stroke.*.engineState = 0
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const own = ownOf(stroke)
    const ink = own.*.ink
    inkFor(ink, stroke, dab)
    const slot = @intCast(usize, dab.*.copy)
    const x = dab.*.x
    const y = dab.*.y
    const list = values()
    const width = number(stroke, list, WIDTH)
    const path = ink.*.path
    if slot >= SLOTS {
        segment(path, x, y, x, y, width)
        inkFill(ink, path, raster.NONZERO)
        return inkBox(ink)
    }
    const probability = number(stroke, list, DENSITY)
    const offset = number(stroke, list, OFFSET)
    const reach = number(stroke, list, REACH) * dab.*.diameter
    const fading = isSet(stroke, list, DISTANCE_OPACITY)
    const thinning = isSet(stroke, list, DISTANCE_DENSITY)
    if !own.*.started[slot] {
        segment(path, x, y, x, y, width)
    } else if isSet(stroke, list, CONNECT) {
        segment(path, own.*.lastX[slot], own.*.lastY[slot], x, y, width)
    }
    // (Lines that each have their own strength are filled one by one;
    // all others together, as one shape.)
    if fading { inkFill(ink, path, raster.NONZERO) }
    const ring = own.*.points + slot * own.*.capacity * 2
    const reach_squared = reach * reach
    var index: usize = 0
    while index < own.*.filled[slot] {
        const dx = ring[index * 2] - x
        const dy = ring[index * 2 + 1] - y
        const squared = dx * dx + dy * dy
        if squared < reach_squared && squared > 0.000001 {
            const apart = @sqrt(squared) / reach
            const wanted = if thinning { probability * (1.0 - apart) } else { probability }
            // (A random number for every point within reach, joined or
            // not: what follows does not depend on the density.)
            if chance(stroke) < wanted {
                segment(path, x + dx * offset, y + dy * offset, x + dx * (1.0 - offset), y + dy * (1.0 - offset), width)
                if fading {
                    inkStrength(ink, 1.0 - apart)
                    inkFill(ink, path, raster.NONZERO)
                }
            }
        }
        index += 1
    }
    inkStrength(ink, 1.0)
    inkFill(ink, path, raster.NONZERO)
    // This point joins the ring (the oldest goes when it is full).
    const at = own.*.next[slot]
    ring[at * 2] = x
    ring[at * 2 + 1] = y
    own.*.next[slot] = if at + 1 >= own.*.capacity { 0 } else { at + 1 }
    if own.*.filled[slot] < own.*.capacity { own.*.filled[slot] += 1 }
    own.*.lastX[slot] = x
    own.*.lastY[slot] = y
    own.*.started[slot] = true
    return inkBox(ink)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = types.ENGINE_SKETCH, .key = "sketch", .name = "Sketch brush", .german = "Skizzenpinsel", .flags = 0, .begin = begin, .dab = paint, .end = null, .free = free },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "sketch" (brush/engines.mlx lists it).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
