// nebula brush: the tip: what one stamp of a brush covers. mask() makes
// the coverage of a dab (a byte a pixel, 0 nothing to 255 all) from a Tip
// (brush/types.mlx), a diameter and the dab's turn and place within its
// pixel; outline() gives the tip's shape as a polygon for the cursor.
//
//     var mask: types.Mask = undefined
//     if tip.forDab(&stroke.*.masks, &stroke.*.settings.*.tip, dab, &mask) {
//         // mask.bytes: mask.height rows of mask.width bytes, the first
//         // byte is the image's pixel (mask.x, mask.y)
//     }
//
// The mask is the cache's own memory (a stroke owns one Cache, made with
// initCache and ended with freeCache): it is valid until the next mask is
// asked of that cache. A dab like the one before (after everything is
// put on its grid: the place within the pixel on eighths, the turn on
// whole degrees, the diameter on steps of a 128th to a 256th of itself,
// coarser with a lower Tip.precision) gets the same buffer again without
// anything being computed; its mirror image is kept beside it, so that
// mirrored painting does not make each mask twice.
//
// AUTO tips are computed by rule, not sampled:
//
// - A circle (an ellipse with `ratio`) or a rectangle, turned by `angle`.
//   Hardness h (the fades, along the tip's width and its height) means
//   full coverage inside h times the radius, falling to nothing at the
//   edge along every ray from the centre: in a straight line (DEFAULT),
//   as 1 - t t (3 - 2 t) (SOFT), or as the bell (exp(-4 t t) - exp(-4)) /
//   (1 - exp(-4)) (GAUSSIAN), t running from 0 where the fade begins to 1
//   at the edge.
// - Spikes n (3 to 12) fold the plane into n sectors around the centre,
//   each showing the ellipse's part around its long axis: a star of n
//   arms for a ratio below 1.
// - The edge is anti-aliased by its distance from the pixel's centre (a
//   pixel half a pixel inside is covered, half a pixel outside is not),
//   so only a band along the edge is computed pixel by pixel: rows are
//   filled by runs inside it, and a 2000 pixel dab costs its outline.
// - That rule is a little too generous for small dabs (by pi/12 of a
//   pixel), so dabs under 16 pixels are computed at 2 to 16 times the
//   size and averaged down: a 0.5 pixel dab is one faint pixel of the
//   right weight, a 1 pixel dab off the grid two or four fainter ones.
// - Density and randomness then thin out and weaken pixels by a random
//   number that comes from the dab's `noise` and the pixel's place.
//
// PREDEFINED tips are built-in grey pictures of 256 x 256, made by rule
// the first time one is used (kept in heap memory until
// dropPredefined()), each with its smaller copies down to 1 x 1; a dab
// reads the two copies nearest to its size, each between four pixels, so
// a tip looks the same at every size and turn. They are masks: black
// (0) no paint, white (255) all.
//
// Not done: predefined tips as coloured pictures, tips loaded from
// files, and a traced outline of a predefined tip (outline() gives the
// ellipse around it).
const std = @import("std")
const math = @import("std.math")
const types = @import("./types.mlx")

pub const Tip = types.Tip
pub const Mask = types.Mask
pub const Cache = types.Cache
pub const Allocator = std.allocator.Allocator

// The largest diameter a mask is made for (a little beyond the largest
// brush: dynamics do not make a dab larger than the brush).
const LARGEST: f64 = 10000.0
const SMALLEST: f64 = 0.01

// ---------------------------------------------------------------------------
// Random numbers by place: the same place and seed, the same number.

fn hashWord(value: u64) -> u64 {
    var z = value +% 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
    return z ^ (z >> 31)
}

fn unitOf(hash: u64) -> f64 {
    return @floatFromInt(f64, @intCast(i64, hash >> 11)) / 9007199254740992.0
}

// 0..1 for the whole place (x, y).
fn lattice(x: i64, y: i64, seed: u64) -> f64 {
    return unitOf(hashWord((@bitCast(u64, x) *% 0x9E3779B97F4A7C15) ^ (@bitCast(u64, y) *% 0xC2B2AE3D27D4EB4F) ^ (seed *% 0x165667B19E3779F9)))
}

// Smooth noise 0..1: the lattice's numbers, blended between the four
// around (x, y).
fn noise(x: f64, y: f64, seed: u64) -> f64 {
    const floor_x = @floor(x)
    const floor_y = @floor(y)
    const ix = @intFromFloat(i64, floor_x)
    const iy = @intFromFloat(i64, floor_y)
    var tx = x - floor_x
    var ty = y - floor_y
    tx = tx * tx * (3.0 - 2.0 * tx)
    ty = ty * ty * (3.0 - 2.0 * ty)
    const top = lattice(ix, iy, seed) * (1.0 - tx) + lattice(ix + 1, iy, seed) * tx
    const bottom = lattice(ix, iy + 1, seed) * (1.0 - tx) + lattice(ix + 1, iy + 1, seed) * tx
    return top * (1.0 - ty) + bottom * ty
}

// Noise of several sizes laid over each other (each half as large and
// half as strong as the one before), 0..1.
fn clouds(x: f64, y: f64, octaves: usize, seed: u64) -> f64 {
    var sum: f64 = 0.0
    var weight: f64 = 0.5
    var total: f64 = 0.0
    var scale: f64 = 1.0
    var octave: usize = 0
    while octave < octaves {
        sum += noise(x * scale, y * scale, seed + @intCast(u64, octave)) * weight
        total += weight
        weight *= 0.5
        scale *= 2.0
        octave += 1
    }
    return sum / total
}

fn unit(value: f64) -> f64 {
    if value >= 1.0 { return 1.0 }
    if value > 0.0 { return value }
    return 0.0
}

// 1 inside `radius`, 0 outside, with `soft` pixels between.
fn within(distance: f64, radius: f64, soft: f64) -> f64 {
    return unit((radius - distance) / soft + 0.5)
}

fn fraction(value: f64) -> f64 { return value - @floor(value) }

// ---------------------------------------------------------------------------
// The built-in tips

const SIDE: usize = 256
const HALF: f64 = 128.0
const LEVELS: usize = 9
// 256^2 + 128^2 + ... + 1.
const PICTURE_BYTES: usize = 87381

const BuiltIn = struct {
    key: []const u8
    name: []const u8
    german: []const u8
}

const CHALK: usize = 0
const SPONGE: usize = 1
const BRISTLES: usize = 2
const SPLATTER: usize = 3
const CHARCOAL: usize = 4
const DRY_BRUSH: usize = 5
const LEAF: usize = 6
const STAR: usize = 7
const SQUARE_GRAIN: usize = 8
const SOFT_NOISE: usize = 9
const HATCH: usize = 10
const DOTS: usize = 11
const RAKE: usize = 12
const CLOUD: usize = 13
const BUILT_IN_COUNT: usize = 14

// The order is the tips' numbers (Tip.predefined): new ones go to the end.
const BUILT_INS = [14]BuiltIn{
    BuiltIn.{ .key = "chalk", .name = "Chalk", .german = "Kreide" },
    BuiltIn.{ .key = "sponge", .name = "Sponge", .german = "Schwamm" },
    BuiltIn.{ .key = "bristles", .name = "Bristles", .german = "Borsten" },
    BuiltIn.{ .key = "splatter", .name = "Splatter", .german = "Spritzer" },
    BuiltIn.{ .key = "charcoal", .name = "Charcoal", .german = "Kohle" },
    BuiltIn.{ .key = "drybrush", .name = "Dry brush", .german = "Trockenpinsel" },
    BuiltIn.{ .key = "leaf", .name = "Leaf", .german = "Blatt" },
    BuiltIn.{ .key = "star", .name = "Star", .german = "Stern" },
    BuiltIn.{ .key = "squaregrain", .name = "Square grain", .german = "Quadratkorn" },
    BuiltIn.{ .key = "softnoise", .name = "Soft noise", .german = "Weiches Rauschen" },
    BuiltIn.{ .key = "hatch", .name = "Hatch", .german = "Schraffur" },
    BuiltIn.{ .key = "dots", .name = "Dots", .german = "Punkte" },
    BuiltIn.{ .key = "rake", .name = "Rake", .german = "Rechen" },
    BuiltIn.{ .key = "cloud", .name = "Cloud", .german = "Wolke" },
}

// All pictures live in one heap block, taken at the first asking for any
// (brixOS gives a process 256 regions of memory, and every block above
// 32 KiB is one: fourteen blocks would be fourteen); each picture is drawn
// into its part when it is first asked for.
var pictures: usize = 0
var drawn: [14]bool = [14]bool{ false, false, false, false, false, false, false, false, false, false, false, false, false, false }

// How many built-in tips there are (Tip.predefined: 0 up to it).
pub fn predefinedCount() -> usize { return BUILT_IN_COUNT }

// A built-in tip's name in preset files ("chalk", "sponge", ...; the
// first one's for a number that is none).
pub fn predefinedKey(index: usize) -> []const u8 {
    if index >= BUILT_IN_COUNT { return BUILT_INS[0].key }
    return BUILT_INS[index].key
}

// What people call built-in tip `index`, in English or German ("" for a
// number that is none).
pub fn predefinedName(index: usize, german: bool) -> []const u8 {
    if index >= BUILT_IN_COUNT { return "" }
    return if german { BUILT_INS[index].german } else { BUILT_INS[index].name }
}

// The number of the built-in tip a preset file names `key` (null: none
// is called so).
pub fn predefinedByKey(key: []const u8) -> ?usize {
    var index: usize = 0
    while index < BUILT_IN_COUNT {
        if std.text.same(BUILT_INS[index].key, key) { return index }
        index += 1
    }
    return null
}

// What tip `index` covers at (x, y), counted in pixels from the middle
// of its 256 x 256 picture: 0..1. (The tips made of blobs are drawn by
// drawBlobs instead.)
fn pictureAt(index: usize, x: f64, y: f64) -> f64 {
    const r = math.hypot(x, y)
    if index == CHALK {
        const body = within(r + 14.0 * (clouds(x / 23.0, y / 23.0, 3, 11) - 0.5), 108.0, 10.0)
        const grain = unit((clouds(x / 2.6, y / 2.6, 3, 12) - 0.38) * 5.0)
        return body * (0.25 + 0.75 * grain)
    }
    if index == SPONGE {
        const body = within(r + 18.0 * (noise(x / 31.0, y / 31.0, 21) - 0.5), 106.0, 6.0)
        if body == 0.0 { return 0.0 }
        // The nearest of the holes, one in every cell of 22 pixels.
        const cell_x = @intFromFloat(i64, @floor(x / 22.0))
        const cell_y = @intFromFloat(i64, @floor(y / 22.0))
        var open: f64 = 1.0
        var oy: i64 = -1
        while oy <= 1 {
            var ox: i64 = -1
            while ox <= 1 {
                const cx = (@floatFromInt(f64, cell_x + ox) + lattice(cell_x + ox, cell_y + oy, 22)) * 22.0
                const cy = (@floatFromInt(f64, cell_y + oy) + lattice(cell_x + ox, cell_y + oy, 23)) * 22.0
                const hole = 4.0 + 5.0 * lattice(cell_x + ox, cell_y + oy, 24)
                const here = unit((math.hypot(x - cx, y - cy) - hole) / 2.5)
                if here < open { open = here }
                ox += 1
            }
            oy += 1
        }
        return body * open
    }
    if index == CHARCOAL {
        const body = within(math.hypot(x / 118.0, y / 50.0) * 50.0, 50.0, 8.0)
        const streak = unit((clouds(x / 28.0, y / 2.2, 3, 51) - 0.36) * 4.5)
        return body * streak
    }
    if index == DRY_BRUSH {
        // Lines along the stroke, each with its own weight and gaps.
        const stripe = @intFromFloat(i64, @floor((y + HALF) / 9.0))
        const middle = (@floatFromInt(f64, stripe) + 0.5) * 9.0 - HALF
        const weight = lattice(stripe, 0, 61)
        const line = within(math.abs(y - middle), 1.5 + 3.0 * lattice(stripe, 1, 61), 1.5)
        const gaps = unit((noise(x / 26.0 + 7.0 * @floatFromInt(f64, stripe), @floatFromInt(f64, stripe) * 3.7, 62) - 0.3 + 0.25 * weight) * 6.0)
        const ends = within(math.abs(x) + 30.0 * lattice(stripe, 2, 61), 112.0, 14.0)
        return line * gaps * ends * within(math.abs(y), 100.0, 6.0)
    }
    if index == LEAF {
        const half: f64 = 112.0
        if math.abs(x) >= half { return 0.0 }
        const wide = 58.0 * math.pow(math.sin(math.pi * (x + half) / (2.0 * half)), 0.75)
        const body = within(math.abs(y), wide, 1.5)
        const rib = 1.0 - 0.55 * within(math.abs(y), 1.6, 1.2)
        const vein = 1.0 - 0.35 * within(math.abs(fraction((x - math.abs(y) * 0.9) / 22.0) - 0.5) * 22.0, 0.9, 1.0)
        return body * rib * vein
    }
    if index == STAR {
        // One of the ten half arms: from the tip at 118 to the notch at
        // 48, a fifth of a half turn on. (The first tip points up.)
        const arm = math.tau / 5.0
        const turned = math.atan2(y, x) + math.pi * 0.5 + math.tau + arm * 0.5
        const within_arm = math.abs(math.fmod(turned, arm) - arm * 0.5)
        const px = r * math.cos(within_arm)
        const py = r * math.sin(within_arm)
        const notch_x = 48.0 * math.cos(arm * 0.5)
        const notch_y = 48.0 * math.sin(arm * 0.5)
        const edge_x = notch_x - 118.0
        const edge_y = notch_y
        const outside = ((px - 118.0) * edge_y - py * edge_x) / math.hypot(edge_x, edge_y)
        return unit(0.5 - outside)
    }
    if index == SQUARE_GRAIN {
        const body = within(math.max(math.abs(x), math.abs(y)), 108.0, 2.0)
        const grain = unit((clouds(x / 5.5, y / 5.5, 3, 91) - 0.33) * 4.0)
        return body * (0.15 + 0.85 * grain)
    }
    if index == SOFT_NOISE {
        const bell = math.exp(0.0 - r * r / 4232.0) * within(r, 124.0, 8.0)
        return bell * (0.35 + 0.65 * clouds(x / 26.0, y / 26.0, 4, 101))
    }
    if index == HATCH {
        const body = within(r, 110.0, 6.0)
        const one = within(math.abs(fraction((x + y) / 17.0) - 0.5) * 17.0, 1.8, 1.4)
        const other = within(math.abs(fraction((x - y) / 17.0) - 0.5) * 17.0, 1.8, 1.4) * 0.8
        return body * math.max(one, other)
    }
    if index == CLOUD {
        const body = within(r + 40.0 * (clouds(x / 45.0, y / 45.0, 3, 141) - 0.5), 100.0, 18.0)
        return body * unit((clouds(x / 20.0, y / 20.0, 4, 142) - 0.3) * 2.6)
    }
    return 0.0
}

// A round blob into the picture: every pixel becomes the larger of what
// it is and what the blob covers there.
fn blob(bytes: [*]u8, cx: f64, cy: f64, radius: f64, soft: f64, amount: f64) -> void {
    const reach = radius + soft
    var y0 = @intFromFloat(i64, @floor(cy + HALF - reach))
    var y1 = @intFromFloat(i64, @ceil(cy + HALF + reach))
    var x0 = @intFromFloat(i64, @floor(cx + HALF - reach))
    var x1 = @intFromFloat(i64, @ceil(cx + HALF + reach))
    if y0 < 0 { y0 = 0 }
    if x0 < 0 { x0 = 0 }
    if y1 > 256 { y1 = 256 }
    if x1 > 256 { x1 = 256 }
    var py = y0
    while py < y1 {
        var px = x0
        while px < x1 {
            const dx = @floatFromInt(f64, px) + 0.5 - HALF - cx
            const dy = @floatFromInt(f64, py) + 0.5 - HALF - cy
            const value = @intFromFloat(u32, within(math.hypot(dx, dy), radius, soft) * amount * 255.0 + 0.5)
            const at = @intCast(usize, py * 256 + px)
            if value > @intCast(u32, bytes[at]) { bytes[at] = @intCast(u8, value) }
            px += 1
        }
        py += 1
    }
}

fn drawBlobs(index: usize, bytes: [*]u8) -> void {
    if index == BRISTLES {
        var number: i64 = 0
        while number < 70 {
            const away = 105.0 * math.sqrt(lattice(number, 0, 31))
            const turn = math.tau * lattice(number, 1, 31)
            const size = lattice(number, 2, 31)
            blob(bytes, away * math.cos(turn), away * math.sin(turn), 3.0 + 7.0 * size * size, 2.0, 0.6 + 0.4 * lattice(number, 3, 31))
            number += 1
        }
    } else if index == SPLATTER {
        blob(bytes, 0.0, 0.0, 34.0, 2.0, 1.0)
        var number: i64 = 0
        while number < 46 {
            const away = 30.0 + 90.0 * math.pow(lattice(number, 0, 41) + 0.0001, 0.7)
            const turn = math.tau * lattice(number, 1, 41)
            const size = 2.0 + 12.0 * (1.0 - away / 125.0) * lattice(number, 2, 41)
            blob(bytes, away * math.cos(turn), away * math.sin(turn), size, 1.5, 1.0)
            number += 1
        }
    } else if index == DOTS {
        var row: i64 = -4
        while row <= 4 {
            var column: i64 = -4
            while column <= 4 {
                const cx = @floatFromInt(f64, column) * 26.0 + 12.0 * (lattice(column, row, 111) - 0.5)
                const cy = @floatFromInt(f64, row) * 26.0 + 12.0 * (lattice(column, row, 112) - 0.5)
                if math.hypot(cx, cy) < 112.0 {
                    blob(bytes, cx, cy, 3.0 + 5.0 * lattice(column, row, 113), 1.5, 1.0)
                }
                column += 1
            }
            row += 1
        }
    } else if index == RAKE {
        var number: i64 = 0
        while number < 7 {
            blob(bytes, 0.0, -105.0 + 35.0 * @floatFromInt(f64, number), 11.0, 2.0, 1.0)
            number += 1
        }
    }
}

fn levelSide(level: usize) -> usize { return SIDE >> @intCast(u6, level) }

// Where a level's bytes begin in a picture's block.
fn levelStart(level: usize) -> usize {
    var start: usize = 0
    var at: usize = 0
    while at < level {
        start += levelSide(at) * levelSide(at)
        at += 1
    }
    return start
}

// Built-in tip `index` as 256 rows of 256 bytes (0 nothing, 255 all),
// made at the first asking; its smaller copies follow in the same block.
// Null for a number that is none, and without memory.
pub fn predefinedPicture(index: usize) -> ?[*]const u8 {
    if index >= BUILT_IN_COUNT { return null }
    if pictures == 0 {
        const memory = std.heap.allocator().alloc(PICTURE_BYTES * BUILT_IN_COUNT, 16)
        if memory == null { return null }
        pictures = @intFromPtr(memory.?)
    }
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrFromInt([*]u8, pictures + index * PICTURE_BYTES) }
    if drawn[index] { return bytes }
    if index == BRISTLES || index == SPLATTER || index == DOTS || index == RAKE {
        std.mem.zero(bytes, SIDE * SIDE)
        drawBlobs(index, bytes)
    } else {
        var py: usize = 0
        while py < SIDE {
            var px: usize = 0
            while px < SIDE {
                const value = pictureAt(index, @floatFromInt(f64, px) + 0.5 - HALF, @floatFromInt(f64, py) + 0.5 - HALF)
                bytes[py * SIDE + px] = @intFromFloat(u8, unit(value) * 255.0 + 0.5)
                px += 1
            }
            py += 1
        }
    }
    // Each smaller copy: the mean of four pixels of the one before.
    var level: usize = 1
    while level < LEVELS {
        const side = levelSide(level)
        const from = bytes + levelStart(level - 1)
        const into = bytes + levelStart(level)
        var y: usize = 0
        while y < side {
            var x: usize = 0
            while x < side {
                const above = from + (y * 2 * side * 2 + x * 2)
                const below = above + side * 2
                const sum = @intCast(u32, above[0]) + @intCast(u32, above[1]) + @intCast(u32, below[0]) + @intCast(u32, below[1])
                into[y * side + x] = @intCast(u8, (sum + 2) / 4)
                x += 1
            }
            y += 1
        }
        level += 1
    }
    drawn[index] = true
    return bytes
}

// Gives back the memory of the built-in pictures (they are made again
// when asked for; no mask of a predefined tip may be in use then).
pub fn dropPredefined() -> void {
    if pictures == 0 { return }
    unsafe { std.heap.allocator().free(@ptrFromInt([*]u8, pictures), PICTURE_BYTES * BUILT_IN_COUNT, 16) }
    pictures = 0
    var index: usize = 0
    while index < BUILT_IN_COUNT {
        drawn[index] = false
        index += 1
    }
}

// A level's value (0..255) at (x, y) in that level's pixels, between the
// four pixels around it; nothing outside the picture.
fn sampleLevel(picture: [*]const u8, level: usize, x: f64, y: f64) -> f64 {
    const side = @intCast(i64, levelSide(level))
    const fx = x - 0.5
    const fy = y - 0.5
    const floor_x = @floor(fx)
    const floor_y = @floor(fy)
    const ix = @intFromFloat(i64, floor_x)
    const iy = @intFromFloat(i64, floor_y)
    if ix < -1 || iy < -1 || ix >= side || iy >= side { return 0.0 }
    const tx = fx - floor_x
    const ty = fy - floor_y
    const texels = picture + levelStart(level)
    var v00: f64 = 0.0
    var v10: f64 = 0.0
    var v01: f64 = 0.0
    var v11: f64 = 0.0
    if iy >= 0 {
        if ix >= 0 { v00 = @floatFromInt(f64, texels[@intCast(usize, iy * side + ix)]) }
        if ix + 1 < side { v10 = @floatFromInt(f64, texels[@intCast(usize, iy * side + ix + 1)]) }
    }
    if iy + 1 < side {
        if ix >= 0 { v01 = @floatFromInt(f64, texels[@intCast(usize, (iy + 1) * side + ix)]) }
        if ix + 1 < side { v11 = @floatFromInt(f64, texels[@intCast(usize, (iy + 1) * side + ix + 1)]) }
    }
    return (v00 * (1.0 - tx) + v10 * tx) * (1.0 - ty) + (v01 * (1.0 - tx) + v11 * tx) * ty
}

// ---------------------------------------------------------------------------
// The cache

pub fn initCache(cache: *Cache, allocator: Allocator) -> void {
    cache.*.allocator = allocator
    cache.*.base = null
    cache.*.baseCapacity = 0
    cache.*.valid = false
    cache.*.flipped = null
    cache.*.flippedCapacity = 0
    cache.*.flippedValid = false
    cache.*.flippedHorizontal = false
    cache.*.flippedVertical = false
    cache.*.profileValid = false
    cache.*.profileModel = 0
    cache.*.profileFade = 0.0
    cache.*.made = 0
    cache.*.asked = 0
}

// Gives back the cache's memory (it can be used again afterwards).
pub fn freeCache(cache: *Cache) -> void {
    if cache.*.base != null { cache.*.allocator.free(cache.*.base.?, cache.*.baseCapacity, 16) }
    if cache.*.flipped != null { cache.*.allocator.free(cache.*.flipped.?, cache.*.flippedCapacity, 16) }
    cache.*.base = null
    cache.*.baseCapacity = 0
    cache.*.valid = false
    cache.*.flipped = null
    cache.*.flippedCapacity = 0
    cache.*.flippedValid = false
}

// Room for `wanted` bytes in one of the cache's two buffers (what was in
// it is lost). Null without memory.
fn room(allocator: Allocator, buffer: *?[*]u8, capacity: *usize, wanted: usize) -> ?[*]u8 {
    if buffer.* != null && capacity.* >= wanted { return buffer.* }
    if buffer.* != null { allocator.free(buffer.*.?, capacity.*, 16) }
    buffer.* = null
    capacity.* = 0
    // An eighth more: sizes creep up along a stroke.
    const size = ((wanted + wanted / 8 + 4096) + 4095) & ~@intCast(usize, 4095)
    const memory = allocator.alloc(size, 16)
    if memory == null { return null }
    buffer.* = memory
    capacity.* = size
    return memory
}

// ---------------------------------------------------------------------------
// Shapes by rule

const Shape = struct {
    rectangle: bool
    // Half the width and half the height, pixels.
    a: f64
    b: f64
    cos: f64
    sin: f64
    // The fades, 0.0001 to 1.
    fadeH: f64
    fadeV: f64
    // No fade at all: the edge alone.
    hard: bool
    model: u8
    // 0: none.
    spikes: u32
    sector: f64
    antialias: bool
    // Samples a pixel along each axis: the edge's band is 1 / scale wide.
    scale: f64
    // The square of a point's distance from the centre, counted in radii
    // (1: on the edge), is qa dx dx + qb dx dy + qc dy dy.
    qa: f64
    qb: f64
    qc: f64
    // Inside `full` (in radii) the coverage is all, outside `outer` none.
    full: f64
    outer: f64
    // Half the mask's width and height.
    reachX: f64
    reachY: f64
    // The coverage depends on the distance in radii alone (cache.profile)
    // up to `plain` radii from the centre.
    byDistance: bool
    plain: f64
}

fn falloff(model: u8, t: f64) -> f64 {
    if t <= 0.0 { return 1.0 }
    if t >= 1.0 { return 0.0 }
    if model == types.SOFT_SOFT { return 1.0 - t * t * (3.0 - 2.0 * t) }
    if model == types.SOFT_GAUSSIAN { return (math.exp(-4.0 * t * t) - 0.018315638888734179) / 0.98168436111126582 }
    return 1.0 - t
}

// What the shape covers at (dx, dy) from its centre, 0..1: the rule
// itself, every case of it.
fn cover(shape: *const Shape, dx: f64, dy: f64) -> f64 {
    var u = dx * shape.*.cos + dy * shape.*.sin
    var v = dy * shape.*.cos - dx * shape.*.sin
    if shape.*.rectangle {
        const au = math.abs(u)
        const av = math.abs(v)
        var edge: f64 = 1.0
        if shape.*.antialias {
            edge = unit(0.5 - (au - shape.*.a) * shape.*.scale) * unit(0.5 - (av - shape.*.b) * shape.*.scale)
        } else if au > shape.*.a || av > shape.*.b {
            edge = 0.0
        }
        if edge <= 0.0 || shape.*.hard { return edge }
        var t: f64 = 0.0
        const inner_a = shape.*.a * shape.*.fadeH
        const inner_b = shape.*.b * shape.*.fadeV
        if au > inner_a && shape.*.a - inner_a > 0.000001 { t = (au - inner_a) / (shape.*.a - inner_a) }
        if av > inner_b && shape.*.b - inner_b > 0.000001 {
            const across = (av - inner_b) / (shape.*.b - inner_b)
            if across > t { t = across }
        }
        return falloff(shape.*.model, t) * edge
    }
    if shape.*.spikes != 0 {
        // Into the sector around the long axis.
        const r = math.hypot(u, v)
        var turn = math.atan2(v, u)
        turn -= math.round(turn / shape.*.sector) * shape.*.sector
        u = r * math.cos(turn)
        v = r * math.sin(turn)
    }
    const nu = u / shape.*.a
    const nv = v / shape.*.b
    const n2 = nu * nu + nv * nv
    const n = @sqrt(n2)
    var edge: f64 = 1.0
    if shape.*.antialias {
        // The distance to the edge in pixels, to the first order: how far
        // n is from 1 over how fast n grows there.
        const slope2 = nu * nu / (shape.*.a * shape.*.a) + nv * nv / (shape.*.b * shape.*.b)
        var distance = 0.0 - math.min(shape.*.a, shape.*.b)
        if slope2 > 0.0 { distance = (n - 1.0) * n / @sqrt(slope2) }
        edge = unit(0.5 - distance * shape.*.scale)
    } else if n > 1.0 {
        edge = 0.0
    }
    if edge <= 0.0 || shape.*.hard { return edge }
    const fu = nu / shape.*.fadeH
    const fv = nv / shape.*.fadeV
    const nf = @sqrt(fu * fu + fv * fv)
    if nf <= 1.0 { return edge }
    if n >= 1.0 { return 0.0 }
    // Along the ray from the centre the fade begins at 1 / nf of the way
    // to the point and the edge is at 1 / n of it.
    return falloff(shape.*.model, n * (nf - 1.0) / (nf - n)) * edge
}

// The columns of a mask's row whose pixel centres lie within `limit`
// radii of the centre (dy: the row's distance from it), as first.* up to
// (not including) last.*; both 0 when there are none.
fn span(shape: *const Shape, dy: f64, limit: f64, left: f64, width: i32, first: *i32, last: *i32) -> void {
    first.* = 0
    last.* = 0
    if limit <= 0.0 { return }
    var low: f64 = 0.0
    var high: f64 = 0.0
    if shape.*.rectangle {
        // Two bands, each between two parallel lines: |u| <= limit a and
        // |v| <= limit b, with u and v straight in dx.
        low = -1000000000.0
        high = 1000000000.0
        const bound_u = limit * shape.*.a
        const bound_v = limit * shape.*.b
        const offset_u = dy * shape.*.sin
        const offset_v = dy * shape.*.cos
        if math.abs(shape.*.cos) < 0.000000001 {
            if math.abs(offset_u) > bound_u { return }
        } else {
            const one = (0.0 - bound_u - offset_u) / shape.*.cos
            const other = (bound_u - offset_u) / shape.*.cos
            low = math.max(low, math.min(one, other))
            high = math.min(high, math.max(one, other))
        }
        if math.abs(shape.*.sin) < 0.000000001 {
            if math.abs(offset_v) > bound_v { return }
        } else {
            const one = (offset_v - bound_v) / shape.*.sin
            const other = (offset_v + bound_v) / shape.*.sin
            low = math.max(low, math.min(one, other))
            high = math.min(high, math.max(one, other))
        }
    } else {
        // qa dx dx + qb dy dx + qc dy dy <= limit limit.
        const linear = shape.*.qb * dy
        const rest = shape.*.qc * dy * dy - limit * limit
        const root = linear * linear - 4.0 * shape.*.qa * rest
        if root < 0.0 { return }
        const reach = @sqrt(root)
        low = (0.0 - linear - reach) / (2.0 * shape.*.qa)
        high = (reach - linear) / (2.0 * shape.*.qa)
    }
    if !(high >= low) { return }
    // Column i's centre is at left + i + 0.5.
    var from = @ceil(low - left - 0.5)
    var to = @floor(high - left - 0.5) + 1.0
    const most = @floatFromInt(f64, width)
    if from < 0.0 { from = 0.0 }
    if to > most { to = most }
    if to <= from { return }
    first.* = @intFromFloat(i32, from)
    last.* = @intFromFloat(i32, to)
}

inline fn toByte(value: f64) -> u8 {
    return @intFromFloat(u8, value * 255.0 + 0.5)
}

// The pixels of a row from column `from` up to `to`, each by the rule
// (or, where the shape allows, by its distance from the centre alone).
fn band(shape: *const Shape, profile: [*]const f32, row: [*]u8, from: i32, to: i32, left: f64, dy: f64) -> void {
    if from >= to { return }
    // (dx steps by whole pixels from a multiple of an eighth: exact, so
    // a mask stays symmetric to the bit.)
    var dx = left + @floatFromInt(f64, from) + 0.5
    var at = @intCast(usize, from)
    const end = @intCast(usize, to)
    if !shape.*.byDistance {
        while at < end {
            row[at] = toByte(cover(shape, dx, dy))
            dx += 1.0
            at += 1
        }
        return
    }
    // The soft part of most brushes, so the loop that counts: n n is a
    // quadratic in dx whose terms of the row are worked out once, and
    // the profile is read instead of the rule.
    const qa = shape.*.qa
    const linear = shape.*.qb * dy
    const constant = shape.*.qc * dy * dy
    const plain = shape.*.plain
    while at < end {
        const n = @sqrt((qa * dx + linear) * dx + constant)
        var value: f64 = 0.0
        if n < plain {
            const place = n * 1024.0
            const whole = @intFromFloat(usize, place)
            const part = place - @floatFromInt(f64, whole)
            value = @floatCast(f64, profile[whole]) * (1.0 - part) + @floatCast(f64, profile[whole + 1]) * part
        } else {
            value = cover(shape, dx, dy)
        }
        row[at] = toByte(value)
        dx += 1.0
        at += 1
    }
}

// The whole mask of a shape at one sample a pixel: row by row, nothing
// outside the edge, all inside the fade's start, the rule between.
fn fillByRows(shape: *const Shape, profile: [*]const f32, bytes: [*]u8, width: i32, height: i32, left: f64, top: f64) -> void {
    var outer_first: i32 = 0
    var outer_last: i32 = 0
    var full_first: i32 = 0
    var full_last: i32 = 0
    const stride = @intCast(usize, width)
    var y: i32 = 0
    while y < height {
        const row = bytes + @intCast(usize, y) * stride
        const dy = top + @floatFromInt(f64, y) + 0.5
        span(shape, dy, shape.*.outer, left, width, &outer_first, &outer_last)
        if outer_last <= outer_first {
            std.mem.zero(row, stride)
        } else {
            if outer_first > 0 { std.mem.zero(row, @intCast(usize, outer_first)) }
            if outer_last < width { std.mem.zero(row + @intCast(usize, outer_last), @intCast(usize, width - outer_last)) }
            span(shape, dy, shape.*.full, left, width, &full_first, &full_last)
            if full_first < outer_first { full_first = outer_first }
            if full_last > outer_last { full_last = outer_last }
            if full_last <= full_first {
                band(shape, profile, row, outer_first, outer_last, left, dy)
            } else {
                band(shape, profile, row, outer_first, full_first, left, dy)
                std.mem.set(row + @intCast(usize, full_first), 255, @intCast(usize, full_last - full_first))
                band(shape, profile, row, full_last, outer_last, left, dy)
            }
        }
        y += 1
    }
}

// The whole mask of a small shape: every pixel the mean of scale x scale
// samples of the rule. A pixel whose centre lies so far outside the edge
// (inside it, for a hard shape) that none of its samples can come near
// the edge's band is nothing (all) without them, the same bytes as
// sampled: the band reaches 0.5 / scale pixels to each side of the edge,
// a sample lies at most 0.7071 pixels from its pixel's centre, and the
// distance cover() takes is at least the change of n (in radii) times
// the shorter radius, n changing by at most 1 / that radius a pixel.
// Rectangles go by each axis alone; stars are sampled everywhere.
fn fillBySamples(shape: *const Shape, bytes: [*]u8, width: i32, height: i32, left: f64, top: f64) -> void {
    const samples = @intFromFloat(i32, shape.*.scale)
    const step = 1.0 / shape.*.scale
    const weight = step * step
    const reach = 0.5 / shape.*.scale + 0.75
    const ellipse = !shape.*.rectangle && shape.*.spikes == 0
    const least = math.min(shape.*.a, shape.*.b)
    const beyond = 1.0 + reach / least
    const within_n = 1.0 - reach / least
    var y: i32 = 0
    while y < height {
        const centre_y = top + @floatFromInt(f64, y) + 0.5
        var x: i32 = 0
        while x < width {
            const centre_x = left + @floatFromInt(f64, x) + 0.5
            if ellipse {
                const n2 = (shape.*.qa * centre_x + shape.*.qb * centre_y) * centre_x + shape.*.qc * centre_y * centre_y
                if n2 >= beyond * beyond {
                    bytes[@intCast(usize, y * width + x)] = 0
                    x += 1
                    continue
                }
                if shape.*.hard && within_n > 0.0 && n2 <= within_n * within_n {
                    bytes[@intCast(usize, y * width + x)] = 255
                    x += 1
                    continue
                }
            } else if shape.*.rectangle {
                const au = math.abs(centre_x * shape.*.cos + centre_y * shape.*.sin)
                const av = math.abs(centre_y * shape.*.cos - centre_x * shape.*.sin)
                if au >= shape.*.a + reach || av >= shape.*.b + reach {
                    bytes[@intCast(usize, y * width + x)] = 0
                    x += 1
                    continue
                }
                if shape.*.hard && au <= shape.*.a - reach && av <= shape.*.b - reach {
                    bytes[@intCast(usize, y * width + x)] = 255
                    x += 1
                    continue
                }
            }
            var sum: f64 = 0.0
            var sy: i32 = 0
            while sy < samples {
                const dy = top + @floatFromInt(f64, y) + (@floatFromInt(f64, sy) + 0.5) * step
                var sx: i32 = 0
                while sx < samples {
                    sum += cover(shape, left + @floatFromInt(f64, x) + (@floatFromInt(f64, sx) + 0.5) * step, dy)
                    sx += 1
                }
                sy += 1
            }
            bytes[@intCast(usize, y * width + x)] = toByte(unit(sum * weight))
            x += 1
        }
        y += 1
    }
}

// The fade's coverage by the distance from the centre in radii, for the
// shapes whose two fades are the same.
fn bakeProfile(cache: *Cache, model: u8, fade: f64) -> void {
    if cache.*.profileValid && cache.*.profileModel == model && cache.*.profileFade == fade { return }
    var index: usize = 0
    while index < 1026 {
        const n = @floatFromInt(f64, index) / 1024.0
        var value: f64 = 1.0
        if n > fade { value = falloff(model, (n - fade) / (1.0 - fade)) }
        cache.*.profile[index] = @floatCast(f32, value)
        index += 1
    }
    cache.*.profileValid = true
    cache.*.profileModel = model
    cache.*.profileFade = fade
}

// Sets up the shape of an AUTO tip of the given size (a: half its width)
// and turn.
fn shapeOf(shape: *Shape, tip: *const Tip, a: f64, b: f64, cos: f64, sin: f64, softness: f64) -> void {
    shape.*.rectangle = tip.*.shape == types.SHAPE_RECTANGLE
    shape.*.a = a
    shape.*.b = b
    shape.*.cos = cos
    shape.*.sin = sin
    shape.*.fadeH = math.clamp(tip.*.horizontalFade * softness, 0.0001, 1.0)
    shape.*.fadeV = math.clamp(tip.*.verticalFade * softness, 0.0001, 1.0)
    shape.*.hard = shape.*.fadeH >= 0.9999 && shape.*.fadeV >= 0.9999
    shape.*.model = tip.*.softness
    shape.*.spikes = 0
    shape.*.sector = math.tau
    // A circle looks the same folded: only an ellipse grows arms.
    if !shape.*.rectangle && tip.*.spikes > 2 && b < a * 0.9999 {
        shape.*.spikes = @intCast(u32, tip.*.spikes)
        shape.*.sector = math.tau / @floatFromInt(f64, tip.*.spikes)
    }
    shape.*.antialias = tip.*.antialias
    // Under 16 pixels the edge's rule is too generous: more samples.
    const smaller = 2.0 * math.min(a, b)
    shape.*.scale = 1.0
    if shape.*.antialias {
        if smaller < 2.0 { shape.*.scale = 16.0 } else if smaller < 4.0 { shape.*.scale = 8.0 } else if smaller < 8.0 { shape.*.scale = 4.0 } else if smaller < 16.0 { shape.*.scale = 2.0 }
    }
    const least_fade = math.min(shape.*.fadeH, shape.*.fadeV)
    const least = math.min(a, b)
    if shape.*.rectangle {
        // In radii of each axis: a pixel in from the edge is full when
        // the fade leaves that much, a pixel out is nothing.
        shape.*.qa = 0.0
        shape.*.qb = 0.0
        shape.*.qc = 0.0
        shape.*.full = math.min(least_fade, 1.0 - 1.0 / least)
        shape.*.outer = 1.0 + 1.0 / least
        shape.*.reachX = a * math.abs(cos) + b * math.abs(sin)
        shape.*.reachY = a * math.abs(sin) + b * math.abs(cos)
        shape.*.byDistance = false
        shape.*.plain = 0.0
        return
    }
    if shape.*.spikes != 0 {
        // Folded, a point is at least as near to the centre (in radii) as
        // on the circle around the tip, and at most as far as on the
        // ellipse's own radius at the sector's border.
        const border = shape.*.sector * 0.5
        const narrow = 1.0 / @sqrt(math.cos(border) * math.cos(border) / (a * a) + math.sin(border) * math.sin(border) / (b * b))
        shape.*.qa = 1.0 / (a * a)
        shape.*.qb = 0.0
        shape.*.qc = 1.0 / (a * a)
        shape.*.full = math.min(least_fade, 1.0 - 1.0 / least) * narrow / a
        shape.*.outer = 1.0 + 1.0 / least
        shape.*.reachX = a
        shape.*.reachY = a
        shape.*.byDistance = false
        shape.*.plain = 0.0
        return
    }
    const inverse_a = 1.0 / (a * a)
    const inverse_b = 1.0 / (b * b)
    shape.*.qa = cos * cos * inverse_a + sin * sin * inverse_b
    shape.*.qb = 2.0 * sin * cos * (inverse_a - inverse_b)
    shape.*.qc = sin * sin * inverse_a + cos * cos * inverse_b
    // The edge's band is half a pixel to each side; in radii that is at
    // most 0.5 / least, taken twice over to be sure.
    shape.*.full = math.min(least_fade, 1.0 - 1.0 / least)
    shape.*.outer = 1.0 + 1.0 / least
    shape.*.reachX = @sqrt(a * a * cos * cos + b * b * sin * sin)
    shape.*.reachY = @sqrt(a * a * sin * sin + b * b * cos * cos)
    shape.*.byDistance = !shape.*.hard && shape.*.fadeH == shape.*.fadeV
    shape.*.plain = math.min(1.0 - 1.0 / least, 0.999)
}

// ---------------------------------------------------------------------------
// Putting numbers on their grids

// 2 to the power of `exponent` (-1000 to 1000).
fn powerOfTwo(exponent: i64) -> f64 {
    return @bitCast(f64, @intCast(u64, exponent + 1023) << 52)
}

// The diameter on its grid: steps of a 128th to a 256th of itself at
// precision 5 (so that sizes people type, 2.5 or 100, are on it), twice
// as coarse with every step of precision down.
fn onSizeGrid(diameter: f64, precision: u8) -> f64 {
    const exponent = @intCast(i64, (@bitCast(u64, diameter) >> 52) & 2047) - 1023
    const step = powerOfTwo(exponent - 7 + @intCast(i64, 5 - precision))
    return math.round(diameter / step) * step
}

// How many places a pixel has along each axis: 8, 4, 2, 1, 1.
fn placesOf(precision: u8) -> i32 {
    if precision >= 5 { return 8 }
    if precision == 4 { return 4 }
    if precision == 3 { return 2 }
    return 1
}

fn sameTip(a: *const Tip, b: *const Tip) -> bool {
    if a.*.kind != b.*.kind || a.*.precision != b.*.precision { return false }
    if a.*.kind == types.TIP_PREDEFINED { return a.*.predefined == b.*.predefined && a.*.density == b.*.density && a.*.randomness == b.*.randomness }
    return a.*.shape == b.*.shape && a.*.horizontalFade == b.*.horizontalFade && a.*.verticalFade == b.*.verticalFade && a.*.spikes == b.*.spikes && a.*.density == b.*.density && a.*.randomness == b.*.randomness && a.*.softness == b.*.softness && a.*.antialias == b.*.antialias
}

// ---------------------------------------------------------------------------
// The mask

// A predefined tip's mask: every pixel read from the picture, turned and
// scaled, between its two copies nearest in size.
fn fillPredefined(picture: [*]const u8, bytes: [*]u8, width: i32, height: i32, left: f64, top: f64, a: f64, b: f64, cos: f64, sin: f64, weight: f64) -> void {
    // Picture pixels a mask pixel: which copies to read.
    const coarser = math.max(HALF / a, HALF / b)
    var level: usize = 0
    var between: f64 = 0.0
    if coarser > 1.0 {
        const exact = math.log2(coarser)
        level = @intFromFloat(usize, exact)
        between = exact - @floatFromInt(f64, level)
        if level >= LEVELS - 1 {
            level = LEVELS - 1
            between = 0.0
        }
    }
    const shrink = 1.0 / @floatFromInt(f64, @intCast(usize, 1) << @intCast(u6, level))
    const scale_u = HALF / a
    const scale_v = HALF / b
    var y: i32 = 0
    while y < height {
        const dy = top + @floatFromInt(f64, y) + 0.5
        var x: i32 = 0
        while x < width {
            const dx = left + @floatFromInt(f64, x) + 0.5
            const pu = (dx * cos + dy * sin) * scale_u + HALF
            const pv = (dy * cos - dx * sin) * scale_v + HALF
            var value: f64 = 0.0
            if pu > -2.0 * scale_u && pv > -2.0 * scale_v && pu < 256.0 + 2.0 * scale_u && pv < 256.0 + 2.0 * scale_v {
                value = sampleLevel(picture, level, pu * shrink, pv * shrink)
                if between > 0.0 { value = value * (1.0 - between) + sampleLevel(picture, level + 1, pu * shrink * 0.5, pv * shrink * 0.5) * between }
            }
            bytes[@intCast(usize, y * width + x)] = @intFromFloat(u8, unit(value * weight / 255.0) * 255.0 + 0.5)
            x += 1
        }
        y += 1
    }
}

// Density and randomness: pixels dropped and weakened by a number that
// depends on the dab's seed and the pixel's place in the mask.
fn roughen(bytes: [*]u8, count: usize, density: f64, randomness: f64, seed: u64) -> void {
    const keep = @intFromFloat(u64, unit(density) * 65536.0)
    const weaken = @intFromFloat(u64, unit(randomness) * 256.0)
    var index: usize = 0
    while index < count {
        const value = @intCast(u64, bytes[index])
        if value != 0 {
            const hash = hashWord(seed ^ (@intCast(u64, index) *% 0x9E3779B97F4A7C15))
            if (hash & 65535) >= keep {
                bytes[index] = 0
            } else if weaken != 0 {
                // Times 1 - randomness * (a number 0..1).
                const less = (weaken * ((hash >> 16) & 255)) >> 8
                bytes[index] = @intCast(u8, (value * (256 - less)) >> 8)
            }
        }
        index += 1
    }
}

// Sharpness: the coverage pulled away from one half toward nothing and
// all (1: no pixel stays between).
fn sharpen(bytes: [*]u8, count: usize, sharpness: f64) -> void {
    var table: [256]u8 = undefined
    const gain = 1.0 / (1.0 - 0.98 * unit(sharpness))
    var value: usize = 0
    while value < 256 {
        table[value] = toByte(unit(0.5 + (@floatFromInt(f64, value) / 255.0 - 0.5) * gain))
        value += 1
    }
    // Nothing stays nothing: the mask's empty margin is not to fill up.
    table[0] = 0
    var index: usize = 0
    while index < count {
        bytes[index] = table[@intCast(usize, bytes[index])]
        index += 1
    }
}

// The mask of one dab.
//
//   tip          the brush's tip (its kind, shape, fades, spikes, ...);
//                its own ratio and angle are NOT read here:
//   diameter     the dab's width in pixels (0.01 to 10000)
//   ratio        its height over its width (0.01 to 1)
//   angle        its turn in radians, clockwise on the screen
//   softness     0..1, the tip's fades are multiplied by it (1: as the
//                tip says)
//   sharpness    0..1, how far half-covered pixels are pushed to nothing
//                or all (0: not at all)
//   subpixel_x, subpixel_y   where in its pixel the dab's centre lies,
//                0 up to 1 (0.5: in the pixel's middle; 0: on its left
//                and upper border)
//   mirror_horizontal, mirror_vertical   the mask is the mirror image
//                left-right (up-down) of the dab's, about the centre
//   noise        the seed of density and randomness (dabs with the same
//                seed have the same grain)
//
// `into` gets the bytes (the cache's: valid until the cache's next
// mask), their width and height and where the first byte's pixel is,
// counted from the pixel the centre lies in (originX, originY; x and y
// are set to the same). False without memory: nothing can be painted.
pub fn mask(cache: *Cache, tip: *const Tip, diameter: f64, ratio: f64, angle: f64, softness: f64, sharpness: f64, subpixel_x: f64, subpixel_y: f64, mirror_horizontal: bool, mirror_vertical: bool, noise_seed: u64, into: *Mask) -> bool {
    cache.*.asked += 1
    const precision = if tip.*.precision < 1 { 1 } else if tip.*.precision > 5 { 5 } else { tip.*.precision }
    // Everything on its grid first: equal dabs then are equal numbers.
    const size = onSizeGrid(math.clamp(if diameter == diameter { diameter } else { SMALLEST }, SMALLEST, LARGEST), precision)
    const shape_ratio = math.round(math.clamp(if ratio == ratio { ratio } else { 1.0 }, 0.01, 1.0) * 1024.0) / 1024.0
    const degree_step: i64 = @intCast(i64, 1) << @intCast(u6, 5 - precision)
    var degrees: i64 = 0
    if angle == angle && math.abs(angle) < 1000000.0 { degrees = @intFromFloat(i64, math.round(angle * 180.0 / math.pi / @floatFromInt(f64, degree_step))) * degree_step }
    degrees = degrees % 360
    if degrees < 0 { degrees += 360 }
    const soft = math.round(math.clamp(if softness == softness { softness } else { 1.0 }, 0.0, 1.0) * 64.0) / 64.0
    const sharp = math.round(math.clamp(if sharpness == sharpness { sharpness } else { 0.0 }, 0.0, 1.0) * 16.0) / 16.0
    const places = placesOf(precision)
    var carry_x: i32 = 0
    var carry_y: i32 = 0
    var sub_x = @intFromFloat(i32, math.round(math.clamp(if subpixel_x == subpixel_x { subpixel_x } else { 0.0 }, 0.0, 1.0) * @floatFromInt(f64, places))) * (8 / places)
    var sub_y = @intFromFloat(i32, math.round(math.clamp(if subpixel_y == subpixel_y { subpixel_y } else { 0.0 }, 0.0, 1.0) * @floatFromInt(f64, places))) * (8 / places)
    if sub_x >= 8 {
        sub_x = 0
        carry_x = 1
    }
    if sub_y >= 8 {
        sub_y = 0
        carry_y = 1
    }
    // A mirrored mask is the mask of the dab mirrored back, flipped: so
    // the mirror image of a dab is that dab's own bytes in the other
    // order, whatever the rule would round.
    var base_x = sub_x
    var base_y = sub_y
    if mirror_horizontal && sub_x != 0 { base_x = 8 - sub_x }
    if mirror_vertical && sub_y != 0 { base_y = 8 - sub_y }
    const grainy = tip.*.density < 1.0 || tip.*.randomness > 0.0
    const seed = if grainy { noise_seed } else { 0 }

    const same = cache.*.valid && cache.*.diameter == size && cache.*.ratio == shape_ratio && cache.*.angle == @floatFromInt(f64, degrees) && cache.*.softness == soft && cache.*.sharpness == sharp && cache.*.subX == base_x && cache.*.subY == base_y && cache.*.noise == seed && sameTip(&cache.*.tip, tip)
    if !same {
        cache.*.valid = false
        cache.*.flippedValid = false
        if !compute(cache, tip, size, shape_ratio, degrees, soft, sharp, base_x, base_y, seed) { return false }
        cache.*.tip = tip.*
        cache.*.diameter = size
        cache.*.ratio = shape_ratio
        cache.*.angle = @floatFromInt(f64, degrees)
        cache.*.softness = soft
        cache.*.sharpness = sharp
        cache.*.subX = base_x
        cache.*.subY = base_y
        cache.*.noise = seed
        cache.*.valid = true
        cache.*.made += 1
    }
    into.*.width = cache.*.width
    into.*.height = cache.*.height
    if !mirror_horizontal && !mirror_vertical {
        into.*.bytes = cache.*.base.?
        into.*.originX = cache.*.originX + carry_x
        into.*.originY = cache.*.originY + carry_y
        into.*.x = into.*.originX
        into.*.y = into.*.originY
        return true
    }
    const count = @intCast(usize, cache.*.width) * @intCast(usize, cache.*.height)
    if !(cache.*.flippedValid && cache.*.flippedHorizontal == mirror_horizontal && cache.*.flippedVertical == mirror_vertical) {
        cache.*.flippedValid = false
        const target = room(cache.*.allocator, &cache.*.flipped, &cache.*.flippedCapacity, count)
        if target == null { return false }
        const source = cache.*.base.?
        const width = @intCast(usize, cache.*.width)
        const height = @intCast(usize, cache.*.height)
        var y: usize = 0
        while y < height {
            const from = source + (if mirror_vertical { height - 1 - y } else { y }) * width
            const to = target.? + y * width
            if mirror_horizontal {
                var x: usize = 0
                while x < width {
                    to[x] = from[width - 1 - x]
                    x += 1
                }
            } else {
                std.mem.copy(to, from, width)
            }
            y += 1
        }
        cache.*.flippedValid = true
        cache.*.flippedHorizontal = mirror_horizontal
        cache.*.flippedVertical = mirror_vertical
    }
    into.*.bytes = cache.*.flipped.?
    // Column i of the dab mirrored back (counted from the centre's
    // pixel) is column -i of the mirror image when the centre lies inside
    // its pixel, where the two centres are 1 - sub and sub; with the
    // centre on a pixel's border it is column -i - 1.
    into.*.originX = cache.*.originX
    into.*.originY = cache.*.originY
    if mirror_horizontal {
        into.*.originX = 0 - (cache.*.originX + cache.*.width - 1)
        if base_x == 0 { into.*.originX -= 1 }
    }
    if mirror_vertical {
        into.*.originY = 0 - (cache.*.originY + cache.*.height - 1)
        if base_y == 0 { into.*.originY -= 1 }
    }
    into.*.originX += carry_x
    into.*.originY += carry_y
    into.*.x = into.*.originX
    into.*.y = into.*.originY
    return true
}

// Computes the cache's base mask for numbers that are on their grids
// already. False without memory.
fn compute(cache: *Cache, tip: *const Tip, size: f64, ratio: f64, degrees: i64, softness: f64, sharpness: f64, sub_x: i32, sub_y: i32, seed: u64) -> bool {
    var cos: f64 = 1.0
    var sin: f64 = 0.0
    if degrees == 90 {
        cos = 0.0
        sin = 1.0
    } else if degrees == 180 {
        cos = -1.0
        sin = 0.0
    } else if degrees == 270 {
        cos = 0.0
        sin = -1.0
    } else if degrees != 0 {
        const radians = @floatFromInt(f64, degrees) * math.pi / 180.0
        cos = math.cos(radians)
        sin = math.sin(radians)
    }
    const centre_x = @floatFromInt(f64, sub_x) / 8.0
    const centre_y = @floatFromInt(f64, sub_y) / 8.0
    var a = size * 0.5
    var b = size * ratio * 0.5
    var reach_x: f64 = 0.0
    var reach_y: f64 = 0.0
    var margin: f64 = 1.0
    var weight: f64 = 1.0
    var shape: Shape = undefined
    const predefined = tip.*.kind == types.TIP_PREDEFINED
    if predefined {
        // Under a pixel the picture would fall between the pixels'
        // centres: it is read a pixel wide and counts less instead.
        if a < 0.5 {
            weight *= a / 0.5
            a = 0.5
        }
        if b < 0.5 {
            weight *= b / 0.5
            b = 0.5
        }
        reach_x = a * math.abs(cos) + b * math.abs(sin)
        reach_y = a * math.abs(sin) + b * math.abs(cos)
    } else {
        shapeOf(&shape, tip, a, b, cos, sin, softness)
        reach_x = shape.reachX
        reach_y = shape.reachY
        margin = 0.5 / shape.scale + 0.01
    }
    const origin_x = @intFromFloat(i32, @floor(centre_x - reach_x - margin))
    const origin_y = @intFromFloat(i32, @floor(centre_y - reach_y - margin))
    const width = @intFromFloat(i32, @ceil(centre_x + reach_x + margin)) - origin_x
    const height = @intFromFloat(i32, @ceil(centre_y + reach_y + margin)) - origin_y
    if width <= 0 || height <= 0 { return false }
    const count = @intCast(usize, width) * @intCast(usize, height)
    const memory = room(cache.*.allocator, &cache.*.base, &cache.*.baseCapacity, count)
    if memory == null { return false }
    const bytes = memory.?
    // (dx, dy) of a pixel's corner from the dab's centre.
    const left = @floatFromInt(f64, origin_x) - centre_x
    const top = @floatFromInt(f64, origin_y) - centre_y
    if predefined {
        const picture = predefinedPicture(@intCast(usize, tip.*.predefined))
        if picture == null { return false }
        fillPredefined(picture.?, bytes, width, height, left, top, a, b, cos, sin, weight)
    } else if shape.scale > 1.0 {
        fillBySamples(&shape, bytes, width, height, left, top)
    } else {
        if shape.byDistance { bakeProfile(cache, shape.model, shape.fadeH) }
        fillByRows(&shape, &cache.*.profile, bytes, width, height, left, top)
    }
    if seed != 0 || tip.*.density < 1.0 || tip.*.randomness > 0.0 { roughen(bytes, count, tip.*.density, tip.*.randomness, seed) }
    if sharpness > 0.0 { sharpen(bytes, count, sharpness) }
    cache.*.width = width
    cache.*.height = height
    cache.*.originX = origin_x
    cache.*.originY = origin_y
    return true
}

// The mask of a Dab of the framework: mask() with the dab's numbers, and
// `into`'s x and y the image's pixel of its first byte. False without
// memory or for a dab that is nowhere (a place beyond a thousand million
// pixels).
pub fn forDab(cache: *Cache, tip: *const Tip, dab: *const types.Dab, into: *Mask) -> bool {
    if !(math.abs(dab.*.x) < 1000000000.0) || !(math.abs(dab.*.y) < 1000000000.0) { return false }
    const floor_x = @floor(dab.*.x)
    const floor_y = @floor(dab.*.y)
    if !mask(cache, tip, dab.*.diameter, dab.*.ratio, dab.*.angle, dab.*.softness, dab.*.sharpness, dab.*.x - floor_x, dab.*.y - floor_y, dab.*.mirrorHorizontal, dab.*.mirrorVertical, dab.*.noise, into) { return false }
    into.*.x = @intFromFloat(i32, floor_x) + into.*.originX
    into.*.y = @intFromFloat(i32, floor_y) + into.*.originY
    return true
}

// ---------------------------------------------------------------------------
// The outline

// The tip's shape as a closed polygon for the cursor: x and y of each
// point in turn, in pixels from the dab's centre, written to `into` (room
// for `capacity` numbers: twice as many as points); the last point is the
// first again. `ratio` and `angle` (radians) as mask() takes them. How
// many points there are: more for a larger tip, so that the line looks
// round (a circle of 10 pixels has 20, one of 1000 has 162), never more
// than fit, and 0 when the shape does not fit (a curved one needs 8
// numbers at least, a closed triangle; a rectangle 10). A predefined tip
// gives the ellipse around it.
pub fn outline(tip: *const Tip, diameter: f64, ratio: f64, angle: f64, into: [*]f64, capacity: usize) -> usize {
    if capacity < 8 { return 0 }
    const a = math.clamp(if diameter == diameter { diameter } else { SMALLEST }, SMALLEST, LARGEST) * 0.5
    const b = a * math.clamp(if ratio == ratio { ratio } else { 1.0 }, 0.01, 1.0)
    const turn = if angle == angle && math.abs(angle) < 1000000.0 { angle } else { 0.0 }
    const cos = math.cos(turn)
    const sin = math.sin(turn)
    const most = capacity / 2 - 1
    if tip.*.kind == types.TIP_AUTO && tip.*.shape == types.SHAPE_RECTANGLE {
        if most < 4 { return 0 }
        var corner: usize = 0
        while corner < 5 {
            const u = if corner == 1 || corner == 2 { a } else { 0.0 - a }
            const v = if corner == 2 || corner == 3 { b } else { 0.0 - b }
            into[corner * 2] = u * cos - v * sin
            into[corner * 2 + 1] = u * sin + v * cos
            corner += 1
        }
        return 5
    }
    var spikes: f64 = 0.0
    if tip.*.kind == types.TIP_AUTO && tip.*.spikes > 2 && b < a * 0.9999 { spikes = @floatFromInt(f64, tip.*.spikes) }
    // So many points that the line is nowhere a tenth of a pixel off the
    // curve; arms need their corners too.
    var points = @intFromFloat(usize, @ceil(math.pi * @sqrt(a / 0.2))) + 4
    if spikes > 0.0 { points = points * 2 + @intFromFloat(usize, spikes) * 8 }
    if points < 12 { points = 12 }
    if points > 720 { points = 720 }
    if points > most { points = most }
    const sector = if spikes > 0.0 { math.tau / spikes } else { math.tau }
    var index: usize = 0
    while index < points {
        const around = math.tau * @floatFromInt(f64, index) / @floatFromInt(f64, points)
        // The edge's distance in this direction: the ellipse's, in the
        // sector the direction folds into.
        var folded = around
        if spikes > 0.0 { folded = around - math.round(around / sector) * sector }
        const along = math.cos(folded) / a
        const across = math.sin(folded) / b
        const radius = 1.0 / @sqrt(along * along + across * across)
        const u = radius * math.cos(around)
        const v = radius * math.sin(around)
        into[index * 2] = u * cos - v * sin
        into[index * 2 + 1] = u * sin + v * cos
        index += 1
    }
    into[points * 2] = into[0]
    into[points * 2 + 1] = into[1]
    return points + 1
}
