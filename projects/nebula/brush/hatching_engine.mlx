// nebula brush: the hatching engine ("hatching"), Krita's hatching brush:
// every dab shows, through its tip's mask, parallel lines that lie fixed
// on the image (so that the dabs of a stroke, and strokes that cross,
// continue the same lines): at an angle, `separation` pixels apart, and
// when asked crossed by more of them perpendicular to them and at 45
// degrees either way.
//
// Its numbers in Settings.values (values() lists them with their ranges
// and defaults; defaults() makes a hatching brush):
//
//   0  angle               degrees, clockwise on the screen: the way the
//                          lines run (-360 to 360; -45)
//   1  separation          pixels from one line to the next, across them
//                          (1 to 1000; 6)
//   2  thickness           pixels (0.05 to 1000; 1)
//   3  crosshatching       the sum of: 1 lines perpendicular to them, 2
//                          lines turned 45 degrees back, 4 lines turned
//                          45 degrees on (0 to 7; 0)
//   4  pressure thickness  0..1: the thickness is that part by the pen's
//                          pressure (0.5)
//   5  origin x            where a line passes, pixels (-100000 to
//   6  origin y            100000; 0)
//
// A pixel's coverage is how much of it a line covers (the overlap of the
// pixel with the line, measured across the line: exact where the lines
// run along the pixel grid; without anti-aliasing a pixel is in when its
// centre is), the largest of all the line sets, times the mask's. Every
// set has its own lines through the origin. The mirrored copies of a dab
// show the image's lines (not mirrored ones). Not done: Krita's moiré,
// separations stepped by a sensor, and the opaque background.
const std = @import("std")
const math = @import("std.math")
const types = @import("./types.mlx")
const tip = @import("./tip.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")
// (The ink the procedural engines share lives in the sketch engine's
// module.)
const ink_module = @import("./sketch_engine.mlx")

pub const Rect = geom.Rect
const Value = ink_module.Value

// The engine's number (Settings.engine): types.mlx has no name for it yet.
pub const ENGINE_HATCHING: u16 = 13

const ANGLE: usize = 0
const SEPARATION: usize = 1
const THICKNESS: usize = 2
const CROSSHATCHING: usize = 3
const PRESSURE_THICKNESS: usize = 4
const ORIGIN_X: usize = 5
const ORIGIN_Y: usize = 6

// The crosshatching number's parts.
pub const PERPENDICULAR: usize = 1
pub const MINUS_45: usize = 2
pub const PLUS_45: usize = 4

const VALUES = [7]Value{
    Value.{ .key = "angle", .name = "Angle", .german = "Winkel", .low = -360.0, .high = 360.0, .initial = -45.0 },
    Value.{ .key = "separation", .name = "Separation", .german = "Abstand", .low = 1.0, .high = 1000.0, .initial = 6.0 },
    Value.{ .key = "thickness", .name = "Thickness", .german = "Strichstärke", .low = 0.05, .high = 1000.0, .initial = 1.0 },
    Value.{ .key = "crosshatching", .name = "Crosshatching", .german = "Kreuzschraffur", .low = 0.0, .high = 7.0, .initial = 0.0 },
    Value.{ .key = "pressure_thickness", .name = "Thickness by pressure", .german = "Stärke nach Druck", .low = 0.0, .high = 1.0, .initial = 0.5 },
    Value.{ .key = "origin_x", .name = "Origin X", .german = "Ursprung X", .low = -100000.0, .high = 100000.0, .initial = 0.0 },
    Value.{ .key = "origin_y", .name = "Origin Y", .german = "Ursprung Y", .low = -100000.0, .high = 100000.0, .initial = 0.0 },
}

var keptValues: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The engine's numbers (row N is Settings.values[N]).
pub fn values() -> []const Value {
    if keptValues.address != 0 { return table.rows(Value, &keptValues) }
    return table.keep(Value, &keptValues, VALUES[0..])
}

// A hatching brush: types.defaults() with this engine, 60 pixels, a
// hard tip, dabs a tenth of the diameter apart, the size not by
// pressure, and the numbers' defaults.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Hatching")
    settings.*.engine = ENGINE_HATCHING
    settings.*.size = 60.0
    settings.*.options[types.OPTION_SIZE].on = false
    ink_module.applyValues(settings, values())
}

// How much of the pixel whose centre lies `phase` separations from a
// line across the lines (lines `separation` apart, `half` half as thick)
// the nearest line covers: the overlap of the stretch the pixel spans
// across the lines with the line's.
inline fn coverOf(phase: f64, separation: f64, half: f64, antialias: bool) -> f64 {
    const distance = math.abs(phase - @floor(phase + 0.5)) * separation
    if !antialias { return if distance <= half { 1.0 } else { 0.0 } }
    const high = math.min(distance + 0.5, half)
    const low = math.max(distance - 0.5, 0.0 - half)
    return if high > low { math.min(high - low, 1.0) } else { 0.0 }
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const ink = ink_module.inkOf(stroke)
    ink_module.inkFor(ink, stroke, dab)
    if !ink.*.usable || ink.*.idle { return geom.empty() }
    const mask = &stroke.*.mask
    if !tip.forDab(&stroke.*.masks, &stroke.*.settings.*.tip, dab, mask) { return geom.empty() }
    const list = values()
    const angle = ink_module.number(stroke, ANGLE, &list[ANGLE]) * math.pi / 180.0
    const separation = ink_module.number(stroke, SEPARATION, &list[SEPARATION])
    const by_pressure = ink_module.number(stroke, PRESSURE_THICKNESS, &list[PRESSURE_THICKNESS])
    const pressure = math.clamp(dab.*.point.pressure, 0.0, 1.0)
    const thickness = ink_module.number(stroke, THICKNESS, &list[THICKNESS]) * (1.0 - by_pressure + by_pressure * pressure)
    const half = thickness * 0.5
    const crossing = ink_module.count(stroke, CROSSHATCHING, &list[CROSSHATCHING])
    const origin_x = ink_module.number(stroke, ORIGIN_X, &list[ORIGIN_X])
    const origin_y = ink_module.number(stroke, ORIGIN_Y, &list[ORIGIN_Y])
    const antialias = ink.*.antialias
    // Each set of lines by its normal (the way across them): the lines,
    // then those perpendicular, turned back and turned on by 45 degrees.
    const a_x = 0.0 - math.sin(angle)
    const a_y = math.cos(angle)
    const perpendicular = crossing & PERPENDICULAR != 0
    const back = crossing & MINUS_45 != 0
    const on = crossing & PLUS_45 != 0
    const back_x = 0.0 - math.sin(angle - math.pi / 4.0)
    const back_y = math.cos(angle - math.pi / 4.0)
    const on_x = 0.0 - math.sin(angle + math.pi / 4.0)
    const on_y = math.cos(angle + math.pi / 4.0)
    // The part of the mask inside the ink's area.
    const x0 = if mask.*.x > ink.*.area.x { mask.*.x } else { ink.*.area.x }
    const y0 = if mask.*.y > ink.*.area.y { mask.*.y } else { ink.*.area.y }
    const mask_right = mask.*.x + mask.*.width
    const mask_bottom = mask.*.y + mask.*.height
    const area_right = ink.*.area.x + ink.*.area.width
    const area_bottom = ink.*.area.y + ink.*.area.height
    const x1 = if mask_right < area_right { mask_right } else { area_right }
    const y1 = if mask_bottom < area_bottom { mask_bottom } else { area_bottom }
    if x1 <= x0 || y1 <= y0 { return geom.empty() }
    const width = @intCast(usize, x1 - x0)
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const row = scratch.bytes(pool, width)
    if row == null {
        scratch.release(pool, mark)
        return geom.empty()
    }
    const stride = @intCast(usize, mask.*.width)
    // Every set's place across its lines goes up by its normal over the
    // separation from one pixel to the next: added, not multiplied, in
    // the loop.
    const step = 1.0 / separation
    const first_x = @floatFromInt(f64, x0) + 0.5 - origin_x
    var y = y0
    while y < y1 {
        const from = mask.*.bytes + (@intCast(usize, y - mask.*.y) * stride + @intCast(usize, x0 - mask.*.x))
        // The row's first pixel's centre, from the origin.
        const cy = @floatFromInt(f64, y) + 0.5 - origin_y
        var phase = (first_x * a_x + cy * a_y) * step
        var phase_perpendicular = (first_x * a_y - cy * a_x) * step
        var phase_back = (first_x * back_x + cy * back_y) * step
        var phase_on = (first_x * on_x + cy * on_y) * step
        var column: usize = 0
        while column < width {
            const cover = from[column]
            var amount: u32 = 0
            if cover != 0 {
                var line = coverOf(phase, separation, half, antialias)
                if perpendicular { line = math.max(line, coverOf(phase_perpendicular, separation, half, antialias)) }
                if back { line = math.max(line, coverOf(phase_back, separation, half, antialias)) }
                if on { line = math.max(line, coverOf(phase_on, separation, half, antialias)) }
                amount = pixel.mul(@intCast(u32, cover), @intFromFloat(u32, line * 255.0 + 0.5))
            }
            row.?[column] = @intCast(u8, amount)
            phase += a_x * step
            phase_perpendicular += a_y * step
            phase_back += back_x * step
            phase_on += on_x * step
            column += 1
        }
        ink_module.inkRow(ink, y, x0, row.?, width)
        y += 1
    }
    scratch.release(pool, mark)
    return ink_module.inkBox(ink)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = ENGINE_HATCHING, .key = "hatching", .name = "Hatching brush", .german = "Schraffurpinsel", .flags = 0, .begin = ink_module.beginInk, .dab = paint, .end = null, .free = ink_module.freeInk },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "hatching" (brush/engines.mlx lists it).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
