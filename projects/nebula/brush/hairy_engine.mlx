// nebula brush: the bristle engine ("hairy"), Krita's bristle brush: a
// bundle of bristles, each drawing a thin line from where it was at the
// dab before to where it is now, with ink that runs out along the
// stroke. The bristles lie in the tip's ellipse (spread over it by a
// sunflower's pattern, each moved a little at random when the stroke
// begins), turn with the dab, and spread wider the harder the pen
// presses.
//
// Its numbers in Settings.values (values() lists them with their ranges
// and defaults; defaults() makes a bristle brush):
//
//    0  bristles          how many (1 to 1000; 30)
//    1  scale             the bundle's width in dab diameters (0.01 to
//                         10; 1)
//    2  random offset     0..1: every dab moves each bristle by up to
//                         that part of the radius at random (0)
//    3  ink amount        pixels of the stroke the ink lasts (1 to
//                         10000000; 1500)
//    4  ink variance      0..1: a bristle holds up to that part less ink
//                         than the most (0.5)
//    5  pressure spread   0..1: full pressure spreads the bundle by that
//                         part more, none draws it in as much (0.5)
//    6  bristle width     pixels (0.05 to 10; 1)
//    7  connected         1: each bristle draws a line from its last
//                         place; 0: a dot where it is (1)
//    8  saturation loss   0..1: the colour loses that part of its
//                         saturation as the ink runs out (0)
//
// The ink left in a bristle is the depletion curve at the part of its
// ink used: the stroke's length so far over its ink amount. The curve is
// Settings.text in brush/curve.mlx's form ("x,y;x,y;..."); without one it
// falls straight from 1 to 0. It is the bristle's coverage (its opacity),
// so a long stroke fades out as the bristles run dry, the poorer ones
// first. Each copy of a dab (mirrored) has its own bristles' places.
// Not done: Krita's shear, soaking up colour from the layer, and weights
// that let pressure or the bristle's length change the ink.
const math = @import("std.math")
const types = @import("./types.mlx")
const curve_module = @import("./curve.mlx")
const geom = @import("../core/geom.mlx")
const raster = @import("../core/raster.mlx")
const table = @import("../core/table.mlx")
// (The ink the procedural engines share lives in the sketch engine's
// module.)
const ink_module = @import("./sketch_engine.mlx")

pub const Rect = geom.Rect
const Value = ink_module.Value
const SLOTS = ink_module.SLOTS

const BRISTLES: usize = 0
const SCALE: usize = 1
const RANDOM_OFFSET: usize = 2
const INK_AMOUNT: usize = 3
const INK_VARIANCE: usize = 4
const PRESSURE_SPREAD: usize = 5
const BRISTLE_WIDTH: usize = 6
const CONNECTED: usize = 7
const SATURATION_LOSS: usize = 8

const VALUES = [9]Value{
    Value.{ .key = "bristles", .name = "Bristles", .german = "Borsten", .low = 1.0, .high = 1000.0, .initial = 30.0 },
    Value.{ .key = "scale", .name = "Scale", .german = "Breite", .low = 0.01, .high = 10.0, .initial = 1.0 },
    Value.{ .key = "random_offset", .name = "Random offset", .german = "Zufälliger Versatz", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "ink_amount", .name = "Ink amount", .german = "Farbmenge", .low = 1.0, .high = 10000000.0, .initial = 1500.0 },
    Value.{ .key = "ink_variance", .name = "Ink variance", .german = "Farbe je Borste", .low = 0.0, .high = 1.0, .initial = 0.5 },
    Value.{ .key = "pressure_spread", .name = "Pressure spread", .german = "Spreizung durch Druck", .low = 0.0, .high = 1.0, .initial = 0.5 },
    Value.{ .key = "bristle_width", .name = "Bristle width", .german = "Borstenbreite", .low = 0.05, .high = 10.0, .initial = 1.0 },
    Value.{ .key = "connected", .name = "Connected", .german = "Verbunden", .low = 0.0, .high = 1.0, .initial = 1.0 },
    Value.{ .key = "saturation_loss", .name = "Saturation loss", .german = "Sättigungsverlust", .low = 0.0, .high = 1.0, .initial = 0.0 },
}

var keptValues: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The engine's numbers (row N is Settings.values[N]).
pub fn values() -> []const Value {
    if keptValues.address != 0 { return table.rows(Value, &keptValues) }
    return table.keep(Value, &keptValues, VALUES[0..])
}

// A bristle brush: types.defaults() with this engine, 30 pixels, dabs a
// twentieth of the diameter apart, the size not by pressure, and the
// numbers' defaults.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Bristles")
    settings.*.engine = types.ENGINE_HAIRY
    settings.*.size = 30.0
    settings.*.tip.spacing = 0.05
    settings.*.options[types.OPTION_SIZE].on = false
    ink_module.applyValues(settings, values())
}

// What a stroke keeps: the ink; each bristle's place in the unit disc and
// its share of the ink; where each was at its slot's last dab; the
// depletion curve, baked.
const Own = struct {
    ink: *ink_module.Ink
    bristles: usize
    // x, y and share for each bristle.
    shape: [*]f64
    // SLOTS times x and y for each bristle.
    last: [*]f64
    started: [8]bool
    curve: curve_module.Curve
    depletion: [256]f32
}

fn ownOf(stroke: *types.Stroke) -> *Own {
    unsafe { return @ptrFromInt(*Own, stroke.*.engineState) }
}

fn shapeBytes(bristles: usize) -> usize { return bristles * 3 * 8 }
fn lastBytes(bristles: usize) -> usize { return SLOTS * bristles * 2 * 8 }

// The golden angle: neighbours in the sunflower's spiral are this far
// apart around the centre, so that no two lines of bristles form.
const GOLDEN: f64 = 2.399963229728653

fn begin(stroke: *types.Stroke) -> bool {
    const allocator = stroke.*.allocator
    const list = values()
    const bristles = ink_module.count(stroke, list, BRISTLES)
    const memory = allocator.alloc(@sizeOf(Own), 16)
    const shape = allocator.alloc(shapeBytes(bristles), 16)
    const last = allocator.alloc(lastBytes(bristles), 16)
    const ink = ink_module.inkCreate(allocator)
    if memory == null || shape == null || last == null || ink == null {
        if memory != null { allocator.free(memory.?, @sizeOf(Own), 16) }
        if shape != null { allocator.free(shape.?, shapeBytes(bristles), 16) }
        if last != null { allocator.free(last.?, lastBytes(bristles), 16) }
        if ink != null { ink_module.inkDestroy(ink.?, allocator) }
        return false
    }
    const own: *Own = unsafe { @ptrCast(*Own, memory.?) }
    own.*.ink = ink.?
    own.*.bristles = bristles
    unsafe { own.*.shape = @ptrCast([*]f64, shape.?) }
    unsafe { own.*.last = @ptrCast([*]f64, last.?) }
    var slot: usize = 0
    while slot < SLOTS {
        own.*.started[slot] = false
        slot += 1
    }
    // The bundle: bristle i of n at the radius sqrt((i + u) / n) (as many
    // near the edge as its length wants) and i golden angles around, u
    // and a little turn drawn at random.
    const variance = ink_module.number(stroke, list, INK_VARIANCE)
    const total = @floatFromInt(f64, bristles)
    var index: usize = 0
    while index < bristles {
        const radius = @sqrt((@floatFromInt(f64, index) + ink_module.chance(stroke)) / total)
        const turn = GOLDEN * (@floatFromInt(f64, index) + ink_module.chance(stroke) - 0.5)
        own.*.shape[index * 3] = radius * math.cos(turn)
        own.*.shape[index * 3 + 1] = radius * math.sin(turn)
        own.*.shape[index * 3 + 2] = 1.0 - variance * ink_module.chance(stroke)
        index += 1
    }
    // The depletion curve: the brush's text, or straight down.
    const text = types.textOf(stroke.*.settings)
    if text.length == 0 || !curve_module.parse(text, &own.*.curve) {
        own.*.curve = curve_module.identity()
        own.*.curve.y[0] = 1.0
        own.*.curve.y[1] = 0.0
    }
    curve_module.bake(&own.*.curve, &own.*.depletion)
    stroke.*.engineState = @intFromPtr(own)
    return true
}

fn free(stroke: *types.Stroke) -> void {
    if stroke.*.engineState == 0 { return }
    const own = ownOf(stroke)
    const allocator = stroke.*.allocator
    ink_module.inkDestroy(own.*.ink, allocator)
    unsafe { allocator.free(@ptrCast([*]u8, own.*.shape), shapeBytes(own.*.bristles), 16) }
    unsafe { allocator.free(@ptrCast([*]u8, own.*.last), lastBytes(own.*.bristles), 16) }
    unsafe { allocator.free(@ptrCast([*]u8, own), @sizeOf(Own), 16) }
    stroke.*.engineState = 0
}

// The ink a bristle has left after `used` of its amount (0: all, 1:
// gone): the baked curve between its two nearest entries.
fn inkLeft(own: *Own, used: f64) -> f64 {
    if !(used > 0.0) { return @floatCast(f64, own.*.depletion[0]) }
    if used >= 1.0 { return @floatCast(f64, own.*.depletion[255]) }
    const at = used * 255.0
    const below = @floor(at)
    const index = @intFromFloat(usize, below)
    const low = @floatCast(f64, own.*.depletion[index])
    const high = @floatCast(f64, own.*.depletion[if index < 255 { index + 1 } else { 255 }])
    return low + (high - low) * (at - below)
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const own = ownOf(stroke)
    const ink = own.*.ink
    ink_module.inkFor(ink, stroke, dab)
    const slot = @intCast(usize, dab.*.copy)
    const list = values()
    const scale = ink_module.number(stroke, list, SCALE)
    const jitter = ink_module.number(stroke, list, RANDOM_OFFSET)
    const amount = ink_module.number(stroke, list, INK_AMOUNT)
    const spread = ink_module.number(stroke, list, PRESSURE_SPREAD)
    const width = ink_module.number(stroke, list, BRISTLE_WIDTH)
    const connected = ink_module.isSet(stroke, list, CONNECTED)
    const desaturate = ink_module.number(stroke, list, SATURATION_LOSS)
    // Pressure one half leaves the bundle as it is.
    const pressure = math.clamp(dab.*.point.pressure, 0.0, 1.0)
    const radius = dab.*.diameter * 0.5 * scale * (1.0 + spread * (2.0 * pressure - 1.0))
    const c = math.cos(dab.*.angle)
    const s = math.sin(dab.*.angle)
    const remembers = slot < SLOTS
    const last = own.*.last + (if remembers { slot } else { 0 }) * own.*.bristles * 2
    const joined = connected && remembers && own.*.started[slot]
    const used = dab.*.distance / amount
    const path = ink.*.path
    var index: usize = 0
    while index < own.*.bristles {
        var bx = own.*.shape[index * 3] * radius
        var by = own.*.shape[index * 3 + 1] * radius * dab.*.ratio
        if jitter > 0.0 {
            bx += (ink_module.chance(stroke) * 2.0 - 1.0) * jitter * radius
            by += (ink_module.chance(stroke) * 2.0 - 1.0) * jitter * radius * dab.*.ratio
        }
        var ox = bx * c - by * s
        var oy = bx * s + by * c
        if dab.*.mirrorHorizontal { ox = 0.0 - ox }
        if dab.*.mirrorVertical { oy = 0.0 - oy }
        const x = dab.*.x + ox
        const y = dab.*.y + oy
        const left = inkLeft(own, used / own.*.shape[index * 3 + 2])
        if left > 0.0 {
            ink_module.inkStrength(ink, left)
            if desaturate > 0.0 { ink_module.inkColor(ink, ink_module.shiftedColor(dab.*.color, 0.0, 0.0 - desaturate * (1.0 - left), 0.0)) }
            if joined {
                ink_module.segment(path, last[index * 2], last[index * 2 + 1], x, y, width)
            } else {
                ink_module.segment(path, x, y, x, y, width)
            }
            ink_module.inkFill(ink, path, raster.NONZERO)
        }
        if remembers {
            last[index * 2] = x
            last[index * 2 + 1] = y
        }
        index += 1
    }
    if remembers { own.*.started[slot] = true }
    return ink_module.inkBox(ink)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = types.ENGINE_HAIRY, .key = "hairy", .name = "Bristle brush", .german = "Borstenpinsel", .flags = 0, .begin = begin, .dab = paint, .end = null, .free = free },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "hairy" (brush/engines.mlx lists it).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
