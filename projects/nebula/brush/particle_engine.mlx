// nebula brush: the particle engine ("particle"), Krita's particle brush:
// a swarm of particles pulled toward the pen, each with its own weight,
// falling by gravity and slowed by drag, drawing the trail it flies. A
// slow stroke leaves tight bundles of lines, a fast one wide loops that
// overshoot the corners.
//
// Its numbers in Settings.values (values() lists them with their ranges
// and defaults; defaults() makes a particle brush):
//
//   0  particles     how many (1 to 500; 30)
//   1  iterations    steps the swarm takes every dab (1 to 100; 8)
//   2  gravity       pixels a step a step, down (negative: up) (-10 to
//                    10; 0.05)
//   3  weight        0..1: how hard the pen pulls (0.15); particle i of n
//                    is pulled by (i + 1) / n of it
//   4  drag          0..1: the part of its speed a particle loses each
//                    step (0.1)
//   5  scale x       the pull along x times this (0 to 10; 1)
//   6  scale y       the pull along y times this (0 to 10; 1)
//   7  line width    pixels (0.05 to 10; 1)
//
// Each step, for every particle: its speed gains (pen - place) times its
// weight, scaled along x and y, and gravity, then loses the drag; it
// moves by its speed and a line marks the way. Within one dab the pen is
// taken from the dab before to this one in as many steps as there are
// iterations. The swarm starts at the first dab, each particle a little
// off it at random (within the dab's radius): the same seed, the same
// swarm. A particle that flies off (farther than ten diameters and a
// thousand pixels from the pen) comes back to it at rest. Each copy of a
// dab (mirrored) has its own swarm. Not done: Krita's opacity weight.
const math = @import("std.math")
const types = @import("./types.mlx")
const geom = @import("../core/geom.mlx")
const raster = @import("../core/raster.mlx")
const table = @import("../core/table.mlx")
// (The ink the procedural engines share lives in the sketch engine's
// module.)
const ink_module = @import("./sketch_engine.mlx")

pub const Rect = geom.Rect
const Value = ink_module.Value
const SLOTS = ink_module.SLOTS

// The engine's number (Settings.engine): types.mlx has no name for it yet.
pub const ENGINE_PARTICLE: u16 = 12

const PARTICLES: usize = 0
const ITERATIONS: usize = 1
const GRAVITY: usize = 2
const WEIGHT: usize = 3
const DRAG: usize = 4
const SCALE_X: usize = 5
const SCALE_Y: usize = 6
const LINE_WIDTH: usize = 7

const VALUES = [8]Value{
    Value.{ .key = "particles", .name = "Particles", .german = "Partikel", .low = 1.0, .high = 500.0, .initial = 30.0 },
    Value.{ .key = "iterations", .name = "Iterations", .german = "Schritte", .low = 1.0, .high = 100.0, .initial = 8.0 },
    Value.{ .key = "gravity", .name = "Gravity", .german = "Schwerkraft", .low = -10.0, .high = 10.0, .initial = 0.05 },
    Value.{ .key = "weight", .name = "Weight", .german = "Gewicht", .low = 0.0, .high = 1.0, .initial = 0.15 },
    Value.{ .key = "drag", .name = "Drag", .german = "Widerstand", .low = 0.0, .high = 1.0, .initial = 0.1 },
    Value.{ .key = "scale_x", .name = "Scale X", .german = "Skalierung X", .low = 0.0, .high = 10.0, .initial = 1.0 },
    Value.{ .key = "scale_y", .name = "Scale Y", .german = "Skalierung Y", .low = 0.0, .high = 10.0, .initial = 1.0 },
    Value.{ .key = "line_width", .name = "Line width", .german = "Linienbreite", .low = 0.05, .high = 10.0, .initial = 1.0 },
}

var keptValues: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The engine's numbers (row N is Settings.values[N]).
pub fn values() -> []const Value {
    if keptValues.address != 0 { return table.rows(Value, &keptValues) }
    return table.keep(Value, &keptValues, VALUES[0..])
}

// A particle brush: types.defaults() with this engine, 30 pixels (the
// swarm's start), dabs a fifth of the diameter apart, the size not by
// pressure, and the numbers' defaults.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Particles")
    settings.*.engine = ENGINE_PARTICLE
    settings.*.size = 30.0
    settings.*.tip.spacing = 0.2
    settings.*.options[types.OPTION_SIZE].on = false
    ink_module.applyValues(settings, values())
}

// What a stroke keeps: the ink, every slot's swarm (place and speed of
// each particle) and where its pen was at its last dab.
const Own = struct {
    ink: *ink_module.Ink
    particles: usize
    // SLOTS swarms of x, y, speed x, speed y for each particle.
    swarm: [*]f64
    penX: [8]f64
    penY: [8]f64
    started: [8]bool
}

fn ownOf(stroke: *types.Stroke) -> *Own {
    unsafe { return @ptrFromInt(*Own, stroke.*.engineState) }
}

fn swarmBytes(particles: usize) -> usize { return SLOTS * particles * 4 * 8 }

fn begin(stroke: *types.Stroke) -> bool {
    const allocator = stroke.*.allocator
    const list = values()
    const particles = ink_module.count(stroke, list, PARTICLES)
    const memory = allocator.alloc(@sizeOf(Own), 16)
    const swarm = allocator.alloc(swarmBytes(particles), 16)
    const ink = ink_module.inkCreate(allocator)
    if memory == null || swarm == null || ink == null {
        if memory != null { allocator.free(memory.?, @sizeOf(Own), 16) }
        if swarm != null { allocator.free(swarm.?, swarmBytes(particles), 16) }
        if ink != null { ink_module.inkDestroy(ink.?, allocator) }
        return false
    }
    const own: *Own = unsafe { @ptrCast(*Own, memory.?) }
    own.*.ink = ink.?
    own.*.particles = particles
    unsafe { own.*.swarm = @ptrCast([*]f64, swarm.?) }
    var slot: usize = 0
    while slot < SLOTS {
        own.*.started[slot] = false
        slot += 1
    }
    stroke.*.engineState = @intFromPtr(own)
    return true
}

fn free(stroke: *types.Stroke) -> void {
    if stroke.*.engineState == 0 { return }
    const own = ownOf(stroke)
    const allocator = stroke.*.allocator
    ink_module.inkDestroy(own.*.ink, allocator)
    unsafe { allocator.free(@ptrCast([*]u8, own.*.swarm), swarmBytes(own.*.particles), 16) }
    unsafe { allocator.free(@ptrCast([*]u8, own), @sizeOf(Own), 16) }
    stroke.*.engineState = 0
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const own = ownOf(stroke)
    const ink = own.*.ink
    ink_module.inkFor(ink, stroke, dab)
    const slot = @intCast(usize, dab.*.copy)
    // (A copy that has no swarm of its own paints nothing.)
    if slot >= SLOTS { return geom.empty() }
    const list = values()
    const iterations = ink_module.count(stroke, list, ITERATIONS)
    const gravity = ink_module.number(stroke, list, GRAVITY)
    const weight = ink_module.number(stroke, list, WEIGHT)
    const keep = 1.0 - ink_module.number(stroke, list, DRAG)
    const scale_x = ink_module.number(stroke, list, SCALE_X)
    const scale_y = ink_module.number(stroke, list, SCALE_Y)
    const width = ink_module.number(stroke, list, LINE_WIDTH)
    const count = own.*.particles
    const swarm = own.*.swarm + slot * count * 4
    const radius = dab.*.diameter * 0.5
    if !own.*.started[slot] {
        var index: usize = 0
        while index < count {
            const r = radius * @sqrt(ink_module.chance(stroke))
            const turn = math.tau * ink_module.chance(stroke)
            swarm[index * 4] = dab.*.x + r * math.cos(turn)
            swarm[index * 4 + 1] = dab.*.y + r * math.sin(turn)
            swarm[index * 4 + 2] = 0.0
            swarm[index * 4 + 3] = 0.0
            index += 1
        }
        own.*.penX[slot] = dab.*.x
        own.*.penY[slot] = dab.*.y
        own.*.started[slot] = true
    }
    const far = dab.*.diameter * 10.0 + 1000.0
    const from_x = own.*.penX[slot]
    const from_y = own.*.penY[slot]
    const path = ink.*.path
    const total = @floatFromInt(f64, count)
    var step: usize = 0
    while step < iterations {
        const along = @floatFromInt(f64, step + 1) / @floatFromInt(f64, iterations)
        const pen_x = from_x + (dab.*.x - from_x) * along
        const pen_y = from_y + (dab.*.y - from_y) * along
        var index: usize = 0
        while index < count {
            const pull = weight * @floatFromInt(f64, index + 1) / total
            const x = swarm[index * 4]
            const y = swarm[index * 4 + 1]
            const vx = (swarm[index * 4 + 2] + (pen_x - x) * pull * scale_x) * keep
            const vy = (swarm[index * 4 + 3] + (pen_y - y) * pull * scale_y + gravity) * keep
            const nx = x + vx
            const ny = y + vy
            if math.abs(nx - pen_x) < far && math.abs(ny - pen_y) < far {
                ink_module.segment(path, x, y, nx, ny, width)
                swarm[index * 4] = nx
                swarm[index * 4 + 1] = ny
                swarm[index * 4 + 2] = vx
                swarm[index * 4 + 3] = vy
            } else {
                // Flown off (or no number any more): back at the pen.
                swarm[index * 4] = pen_x
                swarm[index * 4 + 1] = pen_y
                swarm[index * 4 + 2] = 0.0
                swarm[index * 4 + 3] = 0.0
            }
            index += 1
        }
        step += 1
    }
    ink_module.inkFill(ink, path, raster.NONZERO)
    own.*.penX[slot] = dab.*.x
    own.*.penY[slot] = dab.*.y
    return ink_module.inkBox(ink)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = ENGINE_PARTICLE, .key = "particle", .name = "Particle brush", .german = "Partikelpinsel", .flags = 0, .begin = begin, .dab = paint, .end = null, .free = free },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "particle" (brush/engines.mlx lists it).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
