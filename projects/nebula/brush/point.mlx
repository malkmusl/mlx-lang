// nebula brush: one place of the pen on its way: where it is on the image
// (fractions of a pixel count), how hard it presses, how it is held and
// when. What the canvas hands a stroke for every motion of the pointer;
// a mouse has pressure 1 (or what the speed makes of it, see
// brush/smoothing.mlx) and no tilt.
pub const Point = struct {
    x: f64
    y: f64
    // 0 (not touching) to 1.
    pressure: f64
    // The pen's lean from upright, -1 to 1 each way (0: upright).
    tiltX: f64
    tiltY: f64
    // The pen's turn around its own axis, radians.
    rotation: f64
    // Milliseconds since some start, growing.
    time: f64
}

pub fn at(x: f64, y: f64, pressure: f64, time: f64) -> Point {
    return Point.{ .x = x, .y = y, .pressure = pressure, .tiltX = 0.0, .tiltY = 0.0, .rotation = 0.0, .time = time }
}

// The point `t` of the way from `a` to `b` (0: a, 1: b), everything of it.
pub fn between(a: *const Point, b: *const Point, t: f64) -> Point {
    return Point.{
        .x = a.*.x + (b.*.x - a.*.x) * t,
        .y = a.*.y + (b.*.y - a.*.y) * t,
        .pressure = a.*.pressure + (b.*.pressure - a.*.pressure) * t,
        .tiltX = a.*.tiltX + (b.*.tiltX - a.*.tiltX) * t,
        .tiltY = a.*.tiltY + (b.*.tiltY - a.*.tiltY) * t,
        .rotation = a.*.rotation + (b.*.rotation - a.*.rotation) * t,
        .time = a.*.time + (b.*.time - a.*.time) * t,
    }
}
