// nebula brush: the spray engine ("spray"), Krita's spray brush: every
// dab scatters particles inside its area (the tip's ellipse: the dab's
// diameter, ratio and turn), each a dot, a little square, the pixel it
// falls in or a small stamp of the brush's tip, at random places, sizes
// and turns and, when asked, in colours and opacities of their own.
//
// Its numbers in Settings.values (values() lists them with their ranges
// and defaults; defaults() makes a spray brush):
//
//    0  count            particles a dab (0 to 1000; 20)
//    1  distribution     0 uniform over the area, 1 gaussian around its
//                        centre (held inside the area) (0)
//    2  spread           the gaussian's deviation in radii (0.05 to 2;
//                        0.5)
//    3  shape            0 ellipse, 1 rectangle, 2 the pixel the
//                        particle falls in, 3 the brush's tip (0)
//    4  size             a particle's width in pixels (0.1 to 100; 3)
//    5  size jitter      0..1: a particle is up to that part smaller (0)
//    6  aspect           its height over its width (0.05 to 1; 1)
//    7  rotation         degrees, clockwise (0)
//    8  random rotation  0..1: up to that part of a full turn more (0)
//    9  follow           1: turned along the drawing angle (0)
//   10  hue jitter       0..1: the hue turned by up to half that of a
//                        full turn either way (0)
//   11  saturation jitter, 12 value jitter: 0..1, moved by up to half
//                        that either way (0)
//   13  opacity jitter   0..1: a particle up to that part fainter (0)
//
// A particle's place, size and turn are drawn from the stroke's random
// numbers in that order (only those that vary), then its colour and its
// opacity: the same seed, the same spray. Particles that all look alike
// are filled as one shape (where they overlap, once); those with colours
// or opacities of their own one by one. The SIZE option scales the area,
// not the particles. Not done: Krita's clustered and curve
// distributions, particles from a picture, colours sampled from the
// layer, a filled background.
const std = @import("std")
const math = @import("std.math")
const types = @import("./types.mlx")
const tip = @import("./tip.mlx")
const geom = @import("../core/geom.mlx")
const raster = @import("../core/raster.mlx")
const table = @import("../core/table.mlx")
// (The ink the procedural engines share lives in the sketch engine's
// module.)
const ink_module = @import("./sketch_engine.mlx")

pub const Rect = geom.Rect
const Value = ink_module.Value

const COUNT: usize = 0
const DISTRIBUTION: usize = 1
const SPREAD: usize = 2
const SHAPE: usize = 3
const SIZE: usize = 4
const SIZE_JITTER: usize = 5
const ASPECT: usize = 6
const ROTATION: usize = 7
const RANDOM_ROTATION: usize = 8
const FOLLOW: usize = 9
const HUE_JITTER: usize = 10
const SATURATION_JITTER: usize = 11
const VALUE_JITTER: usize = 12
const OPACITY_JITTER: usize = 13

pub const SHAPE_ELLIPSE: usize = 0
pub const SHAPE_RECTANGLE: usize = 1
pub const SHAPE_PIXEL: usize = 2
pub const SHAPE_TIP: usize = 3

const VALUES = [14]Value{
    Value.{ .key = "count", .name = "Particles", .german = "Partikel", .low = 0.0, .high = 1000.0, .initial = 20.0 },
    Value.{ .key = "distribution", .name = "Gaussian distribution", .german = "Gaußverteilung", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "spread", .name = "Spread", .german = "Streuung", .low = 0.05, .high = 2.0, .initial = 0.5 },
    Value.{ .key = "shape", .name = "Shape", .german = "Form", .low = 0.0, .high = 3.0, .initial = 0.0 },
    Value.{ .key = "size", .name = "Particle size", .german = "Partikelgröße", .low = 0.1, .high = 100.0, .initial = 3.0 },
    Value.{ .key = "size_jitter", .name = "Size jitter", .german = "Größe zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "aspect", .name = "Aspect", .german = "Seitenverhältnis", .low = 0.05, .high = 1.0, .initial = 1.0 },
    Value.{ .key = "rotation", .name = "Rotation", .german = "Drehung", .low = -360.0, .high = 360.0, .initial = 0.0 },
    Value.{ .key = "random_rotation", .name = "Random rotation", .german = "Drehung zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "follow", .name = "Follow the stroke", .german = "Dem Strich folgen", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "hue_jitter", .name = "Hue jitter", .german = "Farbton zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "saturation_jitter", .name = "Saturation jitter", .german = "Sättigung zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "value_jitter", .name = "Value jitter", .german = "Helligkeit zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "opacity_jitter", .name = "Opacity jitter", .german = "Deckkraft zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
}

var keptValues: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The engine's numbers (row N is Settings.values[N]).
pub fn values() -> []const Value {
    if keptValues.address != 0 { return table.rows(Value, &keptValues) }
    return table.keep(Value, &keptValues, VALUES[0..])
}

// A spray brush: types.defaults() with this engine, an area of 60
// pixels, dabs half the diameter apart, the size not by pressure, and the
// numbers' defaults.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Spray")
    settings.*.engine = types.ENGINE_SPRAY
    settings.*.size = 60.0
    settings.*.tip.spacing = 0.5
    settings.*.options[types.OPTION_SIZE].on = false
    ink_module.applyValues(settings, values())
}

// A place in the unit disc: uniform over it, or by the gaussian of
// deviation `spread` (a place outside is drawn again, three times at
// most, then pulled onto the edge). Written to `x` and `y`.
fn place(stroke: *types.Stroke, gaussian: bool, spread: f64, x: *f64, y: *f64) -> void {
    if !gaussian {
        // (The square root: as many particles near the edge, where the
        // rings are long, as near the centre.)
        const r = @sqrt(ink_module.chance(stroke))
        const turn = math.tau * ink_module.chance(stroke)
        x.* = r * math.cos(turn)
        y.* = r * math.sin(turn)
        return
    }
    var tries: usize = 0
    while tries < 4 {
        const gx = ink_module.gaussian(stroke) * spread
        const gy = ink_module.gaussian(stroke) * spread
        const squared = gx * gx + gy * gy
        if squared <= 1.0 || tries == 3 {
            const shrink = if squared > 1.0 { 1.0 / @sqrt(squared) } else { 1.0 }
            x.* = gx * shrink
            y.* = gy * shrink
            return
        }
        tries += 1
    }
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const ink = ink_module.inkOf(stroke)
    ink_module.inkFor(ink, stroke, dab)
    const list = values()
    const particles = ink_module.count(stroke, COUNT, &list[COUNT])
    const gaussian = ink_module.isSet(stroke, DISTRIBUTION, &list[DISTRIBUTION])
    const spread = ink_module.number(stroke, SPREAD, &list[SPREAD])
    const shape = ink_module.count(stroke, SHAPE, &list[SHAPE])
    const size = ink_module.number(stroke, SIZE, &list[SIZE])
    const size_jitter = ink_module.number(stroke, SIZE_JITTER, &list[SIZE_JITTER])
    const aspect = ink_module.number(stroke, ASPECT, &list[ASPECT])
    var rotation = ink_module.number(stroke, ROTATION, &list[ROTATION]) * math.pi / 180.0
    if ink_module.isSet(stroke, FOLLOW, &list[FOLLOW]) { rotation += dab.*.drawingAngle }
    const random_rotation = ink_module.number(stroke, RANDOM_ROTATION, &list[RANDOM_ROTATION])
    const hue_jitter = ink_module.number(stroke, HUE_JITTER, &list[HUE_JITTER])
    const saturation_jitter = ink_module.number(stroke, SATURATION_JITTER, &list[SATURATION_JITTER])
    const value_jitter = ink_module.number(stroke, VALUE_JITTER, &list[VALUE_JITTER])
    const opacity_jitter = ink_module.number(stroke, OPACITY_JITTER, &list[OPACITY_JITTER])
    const colourful = hue_jitter > 0.0 || saturation_jitter > 0.0 || value_jitter > 0.0
    const one_by_one = colourful || opacity_jitter > 0.0 || shape == SHAPE_TIP
    const radius = dab.*.diameter * 0.5
    const c = math.cos(dab.*.angle)
    const s = math.sin(dab.*.angle)
    const path = ink.*.path
    var px: f64 = 0.0
    var py: f64 = 0.0
    var particle: usize = 0
    while particle < particles {
        place(stroke, gaussian, spread, &px, &py)
        // On the tip's ellipse, turned with it, then mirrored about the
        // centre as the dab's mask would be.
        const ex = px * radius
        const ey = py * radius * dab.*.ratio
        var ox = ex * c - ey * s
        var oy = ex * s + ey * c
        if dab.*.mirrorHorizontal { ox = 0.0 - ox }
        if dab.*.mirrorVertical { oy = 0.0 - oy }
        const x = dab.*.x + ox
        const y = dab.*.y + oy
        var width = size
        if size_jitter > 0.0 { width = size * (1.0 - size_jitter * ink_module.chance(stroke)) }
        var turn = rotation
        if random_rotation > 0.0 { turn += math.tau * random_rotation * ink_module.chance(stroke) }
        if colourful {
            const hue = (ink_module.chance(stroke) - 0.5) * hue_jitter
            const saturation = (ink_module.chance(stroke) - 0.5) * saturation_jitter
            const value = (ink_module.chance(stroke) - 0.5) * value_jitter
            ink_module.inkColor(ink, ink_module.shiftedColor(dab.*.color, hue, saturation, value))
        }
        if opacity_jitter > 0.0 { ink_module.inkStrength(ink, 1.0 - opacity_jitter * ink_module.chance(stroke)) }
        if shape == SHAPE_TIP {
            stamp(stroke, ink, dab, x, y, width, turn)
        } else {
            if shape == SHAPE_RECTANGLE {
                ink_module.boxAt(path, x, y, width, width * aspect, turn)
            } else if shape == SHAPE_PIXEL {
                ink_module.boxAt(path, @floor(x) + 0.5, @floor(y) + 0.5, 1.0, 1.0, 0.0)
            } else {
                ink_module.ellipseAt(path, x, y, width * 0.5, width * aspect * 0.5, turn)
            }
            if one_by_one { ink_module.inkFill(ink, path, raster.NONZERO) }
        }
        particle += 1
    }
    ink_module.inkFill(ink, path, raster.NONZERO)
    return ink_module.inkBox(ink)
}

// The brush's tip, `width` across and turned by `turn` more than the
// dab, stamped at (x, y) through the ink (the stroke's mask slot holds
// it).
fn stamp(stroke: *types.Stroke, ink: *ink_module.Ink, dab: *const types.Dab, x: f64, y: f64, width: f64, turn: f64) -> void {
    if !(math.abs(x) < 1000000000.0) || !(math.abs(y) < 1000000000.0) { return }
    const mask = &stroke.*.mask
    const floor_x = @floor(x)
    const floor_y = @floor(y)
    if !tip.mask(&stroke.*.masks, &stroke.*.settings.*.tip, width, dab.*.ratio, dab.*.angle + turn, dab.*.softness, dab.*.sharpness, x - floor_x, y - floor_y, dab.*.mirrorHorizontal, dab.*.mirrorVertical, dab.*.noise, mask) { return }
    mask.*.x = @intFromFloat(i32, floor_x) + mask.*.originX
    mask.*.y = @intFromFloat(i32, floor_y) + mask.*.originY
    ink_module.inkMask(ink, mask)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = types.ENGINE_SPRAY, .key = "spray", .name = "Spray brush", .german = "Sprühpinsel", .flags = 0, .begin = ink_module.beginInk, .dab = paint, .end = null, .free = ink_module.freeInk },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "spray" (brush/engines.mlx lists it).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
