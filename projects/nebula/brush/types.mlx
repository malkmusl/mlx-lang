// nebula brush: the data of a brush. Everything the brush framework
// (brush/stroke.mlx), its parts (curve, dynamics, tip) and every brush
// engine share is declared here, so that an engine imports this module
// (and brush/tip.mlx when it stamps the tip) and nothing of the others.
//
// A brush is a Settings: what a preset file holds. Its parts:
//
//   Tip       the shape one stamp has: made by rule (AUTO: a circle or a
//             rectangle with fade, ratio, spikes, ...) or one of the
//             built-in pictures (PREDEFINED), and how far stamps are apart.
//   Option    one thing of a stamp the pen can drive (its size, opacity,
//             rotation, ...; the OPTION_ numbers), by up to four Sensors
//             (pressure, speed, drawing angle, ...; the SENSOR_ numbers),
//             each with its response Curve, combined as `combine` says.
//   the rest  size, opacity, flow, blend mode, wash or build-up, airbrush,
//             scatter, where the colour comes from, and numbers and a text
//             an engine keeps for itself (`values`, `text`).
//
// A stroke paints on a Target the tool fills in (which device, with which
// colours, mirrored or wrapped, with which seed). For every stamp the
// framework works out a Dab (where, how large, how opaque, which colour)
// and hands it to the brush's Engine: a record of functions an engine
// module fills in and lists in brush/engines.mlx. The Stroke is the state
// of one stroke; State (the pen's motion as the sensors see it), Mask and
// Cache (a stamp's coverage) are parts of it that brush/dynamics.mlx and
// brush/tip.mlx work on.
//
// The sizes matter: a Settings is about 20 KiB, a Stroke more, an Option
// 800 bytes. Records over 1 KiB must never be local values in loops (a
// local of that size is taken from the program's value arena each time
// and given back only when the window's loop turns): they are made once
// (in heap memory, or as a local outside every loop) and passed by
// pointer. A Dab, a Mask, a Tip, a Curve are small and may be values, but
// a Dab handed to an engine is always the stroke's own (`stroke.dab`).
//
// Writing an engine (brush/pixel_engine.mlx is the model):
//
//     fn dab(stroke: *types.Stroke, dab: *const types.Dab) -> types.Rect {
//         const mask = &stroke.*.mask
//         if !tip.forDab(&stroke.*.masks, &stroke.*.settings.*.tip, dab, mask) { return geom.empty() }
//         ... mix dab.*.color into stroke.*.target.device where mask.*.bytes
//         says, inside stroke.*.clip when stroke.*.clipped ...
//         return geom.rect(...)       // the image's rectangle that was changed
//     }
//     const ENGINES = [1]types.Engine{ types.Engine.{ .id = types.ENGINE_SKETCH, .key = "sketch", ... } }
//     var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }
//     pub fn list() -> []const types.Engine {
//         if kept.address != 0 { return table.rows(types.Engine, &kept) }
//         return table.keep(types.Engine, &kept, ENGINES[0..])
//     }
//
// (core/table.mlx: a slice of a module's constant table is a copy in the
// value arena each time it is made; keep() makes it once, in the heap.)
// brush/engines.mlx then lists the module (its load()).
//
// What an engine keeps for the length of a stroke it allocates in begin(),
// puts into stroke.engineState and frees in free(). It draws random
// numbers only from stroke.state.random, so that a stroke with the same
// seed and input paints the same pixels.
//
// A dab function runs twenty thousand times in a long stroke, and it is
// called through the Engine record, where the compiler cannot see what
// becomes of a local record's address: a Mask, a Rect or a Dab that is a
// local there and handed on by pointer is taken from the value arena on
// every call (measured: 40 bytes a dab for a Mask). So: the mask goes
// into stroke.mask (or the engine's own state), numbers are passed as
// numbers, and rectangles are not collected in a local `var` that is
// returned (each assignment in a loop takes another 16 bytes): unite
// them into a field, return a fresh geom.rect().
//
// The preset file format is text, one "key = value" a line (write() and
// parse() below, with every key): a file holds what differs from
// defaults() or everything, keys that are not known are passed over, so
// files of a newer version load in an older one and back.
//
// Not done: textures (the texture fields are kept and written, nothing
// reads them: strength 0 means none), the colour sources GRADIENT and
// PATTERN (they paint the foreground colour), predefined tips used as
// coloured pictures (Tip.asImage is kept, the tip is always a mask), the
// PERSPECTIVE sensor (it is 1 until there are assistants) and
// TANGENTIAL_PRESSURE (brush/point.mlx's Point has no such number yet:
// the sensor reads State.tangential, which stays 0).
const std = @import("std")
const random = @import("std.random")
const geom = @import("../core/geom.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const blend = @import("../core/blend.mlx")
const point_module = @import("./point.mlx")
const curve_module = @import("./curve.mlx")
const tip_module = @import("./tip.mlx")
const engines = @import("./engines.mlx")

pub const Allocator = std.allocator.Allocator
pub const Rect = geom.Rect
pub const Device = device_module.Device
pub const Point = point_module.Point
pub const Curve = curve_module.Curve

// ---------------------------------------------------------------------------
// Sensors: what a dynamic listens to. Each gives 0..1 (see
// brush/dynamics.mlx for how each is measured).

pub const SENSOR_PRESSURE: u8 = 0
// The largest pressure of the stroke so far: it only rises.
pub const SENSOR_PRESSURE_IN: u8 = 1
// 1 with the pen upright, 0 leaning fully left or right (up or down).
pub const SENSOR_X_TILT: u8 = 2
pub const SENSOR_Y_TILT: u8 = 3
// Where the pen leans to, as a part of the full turn.
pub const SENSOR_TILT_DIRECTION: u8 = 4
// 1 with the pen upright, 0 with it lying flat.
pub const SENSOR_TILT_ELEVATION: u8 = 5
pub const SENSOR_SPEED: u8 = 6
// The direction of the motion, as a part of the full turn.
pub const SENSOR_DRAWING_ANGLE: u8 = 7
// The pen's turn around its own axis.
pub const SENSOR_ROTATION: u8 = 8
// These three run from 0 to 1 over the sensor's `length` (pixels drawn,
// milliseconds, dabs) and stay at 1, or start again when `periodic`.
pub const SENSOR_DISTANCE: u8 = 9
pub const SENSOR_TIME: u8 = 10
pub const SENSOR_FADE: u8 = 11
// A random number for every dab, and one for the whole stroke.
pub const SENSOR_FUZZY_DAB: u8 = 12
pub const SENSOR_FUZZY_STROKE: u8 = 13
pub const SENSOR_PERSPECTIVE: u8 = 14
pub const SENSOR_TANGENTIAL_PRESSURE: u8 = 15
pub const SENSOR_KINDS: usize = 16

// How the sensors of one option become one number (Krita's curve modes).
// DIFFERENCE is the largest of them minus the smallest.
pub const COMBINE_MULTIPLY: u8 = 0
pub const COMBINE_ADD: u8 = 1
pub const COMBINE_MAX: u8 = 2
pub const COMBINE_MIN: u8 = 3
pub const COMBINE_DIFFERENCE: u8 = 4
pub const COMBINE_MODES: usize = 5

pub const SENSORS: usize = 4

pub const Sensor = struct {
    kind: u8
    curve: curve_module.Curve
    // DISTANCE: pixels, TIME: milliseconds, FADE: dabs.
    length: f64
    periodic: bool
    // DRAWING_ANGLE: at a corner of the path the dabs fan out from the old
    // direction to the new one in steps of `fanStep` degrees; the
    // direction stays the first one of the stroke (`lockAngle`); and
    // `angleOffset` degrees are added to it.
    fanCorners: bool
    fanStep: f64
    lockAngle: bool
    angleOffset: f64
}

// ---------------------------------------------------------------------------
// Options: what dynamics can drive. Settings.options[OPTION_...]. An
// option that is off does nothing; one that is on gives a number 0..1
// for every dab: `strength` times its sensors' curves combined
// (brush/dynamics.mlx's evaluate). What the framework makes of it:

// The diameter is Settings.size times it.
pub const OPTION_SIZE: usize = 0
// Opacity and flow are the Settings' times it.
pub const OPTION_OPACITY: usize = 1
pub const OPTION_FLOW: usize = 2
// The tip is turned by it times a full turn (1: once around, clockwise on
// the screen; so with the drawing angle as its sensor the tip follows the
// path), added to the tip's own angle.
pub const OPTION_ROTATION: usize = 3
// The tip's ratio is the Tip's times it.
pub const OPTION_RATIO: usize = 4
// The tip's fade is the Tip's times it (0: all soft).
pub const OPTION_SOFTNESS: usize = 5
// The dab goes to whole pixels by that much and its edge is made hard by
// that much (1: on the pixel grid, no half-covered pixels).
pub const OPTION_SHARPNESS: usize = 6
// The dab is moved at random by up to it times Settings.scatterAmount
// diameters.
pub const OPTION_SCATTER: usize = 7
// The distance between dabs is the tip's times it.
pub const OPTION_SPACING: usize = 8
// Above one half the tip is mirrored left-right (up-down).
pub const OPTION_MIRROR_HORIZONTAL: usize = 9
pub const OPTION_MIRROR_VERTICAL: usize = 10
// The colour is made darker: its channels times it (0: black).
pub const OPTION_DARKEN: usize = 11
// The colour between the background's (0) and the foreground's (1).
pub const OPTION_MIX: usize = 12
// The hue turned by (it - 0.5) of the full turn; saturation and value
// moved toward none (0) or full (1), one half leaving them.
pub const OPTION_HUE: usize = 13
pub const OPTION_SATURATION: usize = 14
pub const OPTION_VALUE: usize = 15
// From here on the framework only evaluates: the numbers are handed to
// the engine in Dab.values (engineValue() reads them; 1 when the option is
// off). What a colour-smudge engine needs has its names already:
// how much of the colour under the dab is dragged along, how far around
// the dab it is picked up, how much of the brush's own colour is added,
// how thick the paint is (for tips that light their strokes), where in
// the gradient the colour is taken, how fast an airbrush sprays, how
// strong the texture is; the last one is free for an engine.
pub const OPTION_SMUDGE_LENGTH: usize = 16
pub const OPTION_SMUDGE_RADIUS: usize = 17
pub const OPTION_COLOR_RATE: usize = 18
pub const OPTION_PAINT_THICKNESS: usize = 19
pub const OPTION_GRADIENT: usize = 20
pub const OPTION_AIRBRUSH_RATE: usize = 21
pub const OPTION_TEXTURE_STRENGTH: usize = 22
pub const OPTION_ENGINE: usize = 23
pub const OPTIONS: usize = 24
pub const OPTION_FIRST_FOR_ENGINES: usize = 16
pub const ENGINE_VALUES: usize = 8

pub const Option = struct {
    on: bool
    // How many of `sensors` count (0 to 4; with none the option is its
    // strength for every dab).
    count: u8
    combine: u8
    strength: f64
    sensors: [4]Sensor
}

// ---------------------------------------------------------------------------
// The tip

pub const TIP_AUTO: u8 = 0
pub const TIP_PREDEFINED: u8 = 1

pub const SHAPE_CIRCLE: u8 = 0
pub const SHAPE_RECTANGLE: u8 = 1

// How the coverage falls from the fade's start to the edge: in a straight
// line, in a smooth S, or as a bell.
pub const SOFT_DEFAULT: u8 = 0
pub const SOFT_SOFT: u8 = 1
pub const SOFT_GAUSSIAN: u8 = 2

pub const Tip = struct {
    kind: u8
    // AUTO. The diameter is Settings.size; the tip is `ratio` times as
    // high as wide (0.01 to 1).
    shape: u8
    ratio: f64
    // The hardness along the tip's width and its height, 0..1: full
    // coverage from the centre to that part of the radius, fading to
    // nothing at the edge (1: a hard edge).
    horizontalFade: f64
    verticalFade: f64
    // Degrees, clockwise on the screen.
    angle: f64
    // 2 (none) to 12: the shape repeats that often around the centre (an
    // ellipse becomes a star of so many arms).
    spikes: u8
    // 0..1: the part of the pixels that get paint at all (1: every one).
    density: f64
    // 0..1: how much each pixel's coverage is lessened at random.
    randomness: f64
    softness: u8
    // The edge covers pixels partly (off: a pixel is in or out).
    antialias: bool
    // PREDEFINED: the number of a built-in tip (brush/tip.mlx lists them)
    // and whether its picture is painted as it is instead of being the
    // mask of the brush's colour (kept, not done: always a mask).
    predefined: u16
    asImage: bool
    // Both kinds. Dabs are `spacing` diameters apart (0.01 to 10); with
    // `autoSpacing` the distance is `autoSpacingCoefficient` times the
    // square root of the diameter instead (closer together the larger
    // the brush is, as Krita's auto spacing).
    spacing: f64
    autoSpacing: bool
    autoSpacingCoefficient: f64
    // 1 to 5: how finely a dab's place, size and turn are kept. 5: places
    // to an eighth of a pixel, sizes to a 128th to 256th of themselves,
    // turns to a degree; each step down halves the grid of places (2 and
    // 1: whole pixels) and doubles the size's and the turn's step, and
    // more dabs share one mask (brush/tip.mlx).
    precision: u8
}

// ---------------------------------------------------------------------------
// Settings: a brush, what a preset is.

pub const NAME: usize = 64
pub const TEXT: usize = 128
pub const VALUES: usize = 32

pub const SMALLEST_SIZE: f64 = 0.01
pub const LARGEST_SIZE: f64 = 10000.0

// Wash: the stroke is painted on a plane of its own (the node's overlay)
// and never gets more opaque than the brush's opacity, however often it
// crosses itself. Build-up: every dab goes onto the layer at once and
// adds to what is there.
pub const MODE_WASH: u8 = 0
pub const MODE_BUILD_UP: u8 = 1

// Where the colour comes from: the foreground colour, a random colour
// for each stroke, one for each dab. (GRADIENT and PATTERN: not done.)
pub const COLOR_PLAIN: u8 = 0
pub const COLOR_UNIFORM_RANDOM: u8 = 1
pub const COLOR_TOTAL_RANDOM: u8 = 2
pub const COLOR_GRADIENT: u8 = 3
pub const COLOR_PATTERN: u8 = 4
pub const COLOR_SOURCES: usize = 5

// The engines' numbers (Settings.engine, Engine.id): they stay for good.
// The first two are brush/pixel_engine.mlx; the others are kept for the
// engines that follow.
pub const ENGINE_PAINTBRUSH: u16 = 1
pub const ENGINE_ERASER: u16 = 2
pub const ENGINE_COLORSMUDGE: u16 = 3
pub const ENGINE_DUPLICATE: u16 = 4
pub const ENGINE_SKETCH: u16 = 5
pub const ENGINE_SPRAY: u16 = 6
pub const ENGINE_HAIRY: u16 = 7
pub const ENGINE_FILTER: u16 = 8
pub const ENGINE_DEFORM: u16 = 9
pub const ENGINE_SHAPE: u16 = 10

pub const Settings = struct {
    name: [64]u8
    nameLength: usize
    engine: u16
    tip: Tip
    // The diameter in pixels, SMALLEST_SIZE to LARGEST_SIZE.
    size: f64
    // 0..1. Opacity is how opaque the stroke gets at most, flow how much
    // of that one dab lays down.
    opacity: f64
    flow: f64
    // core/blend.mlx's number.
    blend: u16
    // The brush takes paint away instead of laying it down.
    eraser: bool
    paintMode: u8
    // Dabs also come by time while the pen rests: `airbrushRate` a second.
    airbrush: bool
    airbrushRate: f64
    options: [24]Option
    // How far OPTION_SCATTER moves a dab at most, in diameters, and
    // whether along the direction of the stroke (x) and across it (y).
    scatterAmount: f64
    scatterX: bool
    scatterY: bool
    colorSource: u8
    // Kept for textures (not done; strength 0: none): which built-in
    // pattern, how strongly, how large, and how it meets the dab.
    texture: u16
    textureStrength: f64
    textureScale: f64
    textureMode: u8
    // An engine's own numbers and text: what they mean the engine says.
    values: [32]f32
    text: [128]u8
    textLength: usize
}

// ---------------------------------------------------------------------------
// Target: what a stroke paints on. The tool fills it in.
//
// Painting directly (build-up): `device` is the node's own (inside
// ops.beginPixels ... endPixels), `direct` is true, `selection` the
// image's selection when there is one, `alphaLock` the node's.
//
// Painting indirectly (wash): `device` is a device the tool made and set
// as the node's overlay (core/node.mlx: overlay, overlayOpacity 255,
// overlayBlend = stroke.mergeBlend(settings), overlayMasked when the image
// has a selection), `direct` is false, selection and alpha lock are left
// to ops.mergeOverlay, which the tool calls after the stroke's end.
pub const Target = struct {
    image: *image_module.Image
    node: *node_module.Node
    device: *device_module.Device
    direct: bool
    // Straight 0xAARRGGBB.
    foreground: u32
    background: u32
    // Direct only: dabs count with the mask's amounts (null: everywhere).
    selection: ?*device_module.Device
    // Direct only: every pixel keeps its alpha.
    alphaLock: bool
    // Every dab is painted again on the other side of a vertical line at
    // x = axisX (`mirrorHorizontal`) and of a horizontal one at y = axisY
    // (`mirrorVertical`); with both, four times. With an axis on whole or
    // half pixels the copies are exact mirror images.
    mirrorHorizontal: bool
    axisX: f64
    mirrorVertical: bool
    axisY: f64
    // What leaves the image on one side comes in on the other, and
    // nothing is painted outside the image.
    wrap: bool
    // For everything random: the same seed and the same input give the
    // same pixels.
    seed: u64
    // What engines that read colour (smudge, clone) read from (null: the
    // device they paint on).
    sample: ?*device_module.Device
}

// ---------------------------------------------------------------------------
// Dab: one stamp as the framework worked it out. All dynamics are in it
// already; an engine only paints.
pub const Dab = struct {
    // The centre in the image's coordinates (a pixel's centre is at .5),
    // on the grid the tip's precision gives.
    x: f64
    y: f64
    // Pixels.
    diameter: f64
    ratio: f64
    // The tip's turn in radians, clockwise on the screen (the tip's own
    // angle and OPTION_ROTATION).
    angle: f64
    // 0..1.
    opacity: f64
    flow: f64
    softness: f64
    sharpness: f64
    // Straight 0xAARRGGBB, after MIX, DARKEN and the HSV options.
    color: u32
    // The stamp is the tip's mirror image left-right (up-down), after its
    // turning: brush/tip.mlx's forDab makes the mask so; an engine that
    // draws by itself flips what it draws about the centre.
    mirrorHorizontal: bool
    mirrorVertical: bool
    // Which copy of the dab this is: 0 the dab itself, 1 and up its
    // mirrored and wrapped-around copies (an engine that keeps state from
    // dab to dab keeps it per copy).
    copy: u8
    // The dab's number in the stroke (the first is 0) and the pixels the
    // pen has gone until it.
    index: u32
    distance: f64
    // The pen at the dab: place before scatter, pressure, tilt, time.
    point: point_module.Point
    // Pixels a millisecond, smoothed; the direction of motion in radians.
    speed: f64
    drawingAngle: f64
    // The seed of what is random in the dab's mask (0: nothing is).
    noise: u64
    // Options OPTION_FIRST_FOR_ENGINES and up: engineValue().
    values: [8]f64
}

// The number of an engine's option (OPTION_SMUDGE_LENGTH, ...) for a dab:
// 0..1, and 1 when the option is off.
pub fn engineValue(dab: *const Dab, option: usize) -> f64 {
    if option < OPTION_FIRST_FOR_ENGINES || option >= OPTIONS { return 1.0 }
    return dab.*.values[option - OPTION_FIRST_FOR_ENGINES]
}

// ---------------------------------------------------------------------------
// State: the pen's motion as the sensors see it (brush/dynamics.mlx
// keeps it; the stroke owns it).
pub const State = struct {
    // The stroke's own random numbers: the sensors', the scatter's, an
    // engine's.
    random: random.Xoshiro256
    seed: u64
    // The pen at the dab being placed.
    point: point_module.Point
    // Pixels and milliseconds since the stroke began, dabs placed before
    // this one.
    distance: f64
    time: f64
    dabs: u32
    startTime: f64
    // The largest pressure so far.
    pressureIn: f64
    // The direction of motion (radians, 0: to the right, growing
    // clockwise on the screen) and the first one of the stroke.
    direction: f64
    hasDirection: bool
    firstDirection: f64
    // The segment being drawn: the smoothed speed where it began, its own
    // speed (pixels a millisecond), its duration and length, the path's
    // length before it, and how far (0..1) the dab being placed is along
    // it.
    speedBefore: f64
    segmentSpeed: f64
    segmentTime: f64
    segmentLength: f64
    travelled: f64
    along: f64
    // What the pen does not report yet.
    tangential: f64
    perspective: f64
}

// ---------------------------------------------------------------------------
// Mask: the coverage of one stamp (brush/tip.mlx makes it).
pub const Mask = struct {
    // `height` rows of `width` bytes: 0 nothing, 255 all. The cache's own
    // memory: valid until the next mask is asked of the same cache.
    bytes: [*]u8
    width: i32
    height: i32
    // Where the first byte's pixel is, counted from the pixel the dab's
    // centre lies in.
    originX: i32
    originY: i32
    // The same in the image's coordinates (forDab() fills these in).
    x: i32
    y: i32
}

// What a stroke keeps of masks: the one made last with all it was made
// for, and its mirror image. brush/tip.mlx works on it (initCache,
// freeCache, mask, forDab).
pub const Cache = struct {
    allocator: Allocator
    base: ?[*]u8
    baseCapacity: usize
    valid: bool
    tip: Tip
    diameter: f64
    ratio: f64
    angle: f64
    softness: f64
    sharpness: f64
    // In eighths of a pixel.
    subX: i32
    subY: i32
    noise: u64
    width: i32
    height: i32
    originX: i32
    originY: i32
    flipped: ?[*]u8
    flippedCapacity: usize
    flippedValid: bool
    flippedHorizontal: bool
    flippedVertical: bool
    // The fade's coverage by the distance from the centre (0: there, 1:
    // at the edge) in 1024 steps, for the fades it was made for.
    profile: [1026]f32
    profileValid: bool
    profileModel: u8
    profileFade: f64
    // How many masks were computed and how many asked for (tests and
    // tuning read these).
    made: u64
    asked: u64
}

// ---------------------------------------------------------------------------
// Engine: how a kind of brush paints. A module's table of these is listed
// in brush/engines.mlx.

// The engine reads Target.sample (the tool sets it up).
pub const ENGINE_READS_SAMPLE: u32 = 1
// The engine's dabs depend on what is on the layer already: it always
// paints directly, never on an overlay (stroke.paintsIndirectly()).
pub const ENGINE_DIRECT: u32 = 2

// A stroke begins: settings and target are in place, nothing is painted
// yet. False: the engine cannot paint (no memory); the stroke then paints
// nothing.
pub const Begin = fn(stroke: *Stroke) -> bool
// Paints one stamp. The image's rectangle it changed (empty: nothing).
pub const Paint = fn(stroke: *Stroke, dab: *const Dab) -> geom.Rect
// The stroke ends (the last dab was painted): what the engine still has
// to paint, it paints. The image's rectangle it changed.
pub const End = fn(stroke: *Stroke) -> geom.Rect
// Frees what the engine put into stroke.engineState (called after End, and
// when a stroke is given up).
pub const Free = fn(stroke: *Stroke) -> void

pub const Engine = struct {
    // ENGINE_...: the number in Settings.engine.
    id: u16
    // The name in preset files ("paintbrush", "eraser", "colorsmudge", ...).
    key: []const u8
    name: []const u8
    german: []const u8
    flags: u32
    // (Begin, Paint, End and Free, spelled out: an optional of a named
    // function type does not resolve inside the ring Engine and Stroke
    // form.)
    begin: ?fn(stroke: *Stroke) -> bool
    dab: fn(stroke: *Stroke, dab: *const Dab) -> geom.Rect
    end: ?fn(stroke: *Stroke) -> geom.Rect
    free: ?fn(stroke: *Stroke) -> void
}

// ---------------------------------------------------------------------------
// Stroke: the state of one stroke (brush/stroke.mlx makes and runs it).
// Engines read `target`, `settings`, `clip` and `dab`, draw from
// `state.random`, take masks from `masks` and keep their own in
// `engineState`.
pub const Stroke = struct {
    allocator: Allocator
    // Between begin() and end().
    active: bool
    target: Target
    // The stroke's own copy of the brush (made valid by sanitize()).
    settings: *Settings
    // The engine that paints (a copy of its record: valid while `active`)
    // and what it keeps.
    engine: Engine
    engineState: usize
    // The options' curves baked: OPTIONS x SENSORS x 256 numbers.
    curves: [*]f32
    state: State
    masks: Cache
    // The dab being painted, and room for its mask (tip.forDab's `into`:
    // an engine that needs one mask at a time uses this).
    dab: Dab
    mask: Mask
    // The point the pen was at last, the distance gone since the last
    // dab, and how far after it the next one is due.
    last: point_module.Point
    sinceDab: f64
    gap: f64
    // The first dab waits for the first motion (it needs its direction).
    pendingFirst: bool
    usesDirection: bool
    // Degrees between the dabs that fan out at a corner (0: none do).
    fanStep: f64
    lastDabTime: f64
    // COLOR_UNIFORM_RANDOM's colour.
    strokeColor: u32
    // Dabs placed (mirrored and wrapped copies not counted).
    dabs: u32
    // Engines paint only inside `clip` when `clipped` (wrap-around: the
    // image).
    clip: geom.Rect
    clipped: bool
    // What the call being served (begin, to, tick, end) changed so far,
    // and everything the stroke changed.
    painted: geom.Rect
    dirty: geom.Rect
}

// ---------------------------------------------------------------------------
// Names: the keys of preset files, and what people read.

const Named = struct {
    key: []const u8
    name: []const u8
    german: []const u8
}

const SENSOR_NAMES = [16]Named{
    Named.{ .key = "pressure", .name = "Pressure", .german = "Druck" },
    Named.{ .key = "pressure_in", .name = "Pressure in", .german = "Druckanstieg" },
    Named.{ .key = "tilt_x", .name = "X tilt", .german = "Neigung X" },
    Named.{ .key = "tilt_y", .name = "Y tilt", .german = "Neigung Y" },
    Named.{ .key = "tilt_direction", .name = "Tilt direction", .german = "Neigungsrichtung" },
    Named.{ .key = "tilt_elevation", .name = "Tilt elevation", .german = "Neigungswinkel" },
    Named.{ .key = "speed", .name = "Speed", .german = "Geschwindigkeit" },
    Named.{ .key = "drawing_angle", .name = "Drawing angle", .german = "Zeichenrichtung" },
    Named.{ .key = "rotation", .name = "Rotation", .german = "Stiftdrehung" },
    Named.{ .key = "distance", .name = "Distance", .german = "Strecke" },
    Named.{ .key = "time", .name = "Time", .german = "Zeit" },
    Named.{ .key = "fade", .name = "Fade", .german = "Ausblenden" },
    Named.{ .key = "fuzzy_dab", .name = "Fuzzy dab", .german = "Zufall je Tupfer" },
    Named.{ .key = "fuzzy_stroke", .name = "Fuzzy stroke", .german = "Zufall je Strich" },
    Named.{ .key = "perspective", .name = "Perspective", .german = "Perspektive" },
    Named.{ .key = "tangential_pressure", .name = "Tangential pressure", .german = "Tangentialdruck" },
}

// (Three tables, not one of records: a constant table is copied where it
// is read, into the function's frame up to 1 KiB and into the value
// arena beyond; 24 records of three texts are beyond.)
const OPTION_KEYS = [24][]const u8{
    "size", "opacity", "flow", "rotation",
    "ratio", "softness", "sharpness", "scatter",
    "spacing", "mirror_h", "mirror_v", "darken",
    "mix", "hue", "saturation", "value",
    "smudge_length", "smudge_radius", "color_rate", "paint_thickness",
    "gradient", "airbrush_rate", "texture_strength", "engine",
}

const OPTION_ENGLISH = [24][]const u8{
    "Size", "Opacity", "Flow", "Rotation",
    "Ratio", "Softness", "Sharpness", "Scatter",
    "Spacing", "Mirror horizontally", "Mirror vertically", "Darken",
    "Mix", "Hue", "Saturation", "Value",
    "Smudge length", "Smudge radius", "Colour rate", "Paint thickness",
    "Gradient", "Airbrush rate", "Texture strength", "Engine",
}

const OPTION_GERMAN = [24][]const u8{
    "Größe", "Deckkraft", "Fluss", "Drehung",
    "Seitenverhältnis", "Weichheit", "Schärfe", "Streuung",
    "Abstand", "Waagerecht spiegeln", "Senkrecht spiegeln", "Abdunkeln",
    "Mischen", "Farbton", "Sättigung", "Helligkeit",
    "Wischlänge", "Wischradius", "Farbanteil", "Farbdicke",
    "Verlauf", "Sprührate", "Texturstärke", "Pinselart",
}

const COMBINE_NAMES = [5]Named{
    Named.{ .key = "multiply", .name = "Multiply", .german = "Multiplizieren" },
    Named.{ .key = "add", .name = "Add", .german = "Addieren" },
    Named.{ .key = "max", .name = "Maximum", .german = "Maximum" },
    Named.{ .key = "min", .name = "Minimum", .german = "Minimum" },
    Named.{ .key = "difference", .name = "Difference", .german = "Differenz" },
}

const SOFTNESS_NAMES = [3]Named{
    Named.{ .key = "default", .name = "Default", .german = "Standard" },
    Named.{ .key = "soft", .name = "Soft", .german = "Weich" },
    Named.{ .key = "gaussian", .name = "Gaussian", .german = "Gauß" },
}

const COLOR_NAMES = [5]Named{
    Named.{ .key = "plain", .name = "Plain colour", .german = "Einfarbig" },
    Named.{ .key = "uniform", .name = "Random per stroke", .german = "Zufall je Strich" },
    Named.{ .key = "total", .name = "Random per dab", .german = "Zufall je Tupfer" },
    Named.{ .key = "gradient", .name = "Gradient", .german = "Verlauf" },
    Named.{ .key = "pattern", .name = "Pattern", .german = "Muster" },
}

// (The tables are read one field at a time, TABLE[index].field: a
// pointer to an entry or a slice of a table would put a copy of the
// whole table into the value arena on every call.)
const SENSOR_TABLE: u8 = 0
const OPTION_TABLE: u8 = 1
const COMBINE_TABLE: u8 = 2
const SOFTNESS_TABLE: u8 = 3
const COLOR_TABLE: u8 = 4

fn tableSize(table: u8) -> usize {
    if table == SENSOR_TABLE { return SENSOR_KINDS }
    if table == OPTION_TABLE { return OPTIONS }
    if table == COMBINE_TABLE { return COMBINE_MODES }
    if table == SOFTNESS_TABLE { return 3 }
    return COLOR_SOURCES
}

fn tableKey(table: u8, index: usize) -> []const u8 {
    if table == SENSOR_TABLE { return SENSOR_NAMES[index].key }
    if table == OPTION_TABLE { return OPTION_KEYS[index] }
    if table == COMBINE_TABLE { return COMBINE_NAMES[index].key }
    if table == SOFTNESS_TABLE { return SOFTNESS_NAMES[index].key }
    return COLOR_NAMES[index].key
}

// The place of `key` in a table (null: not in it).
fn indexOf(table: u8, key: []const u8) -> ?usize {
    const size = tableSize(table)
    var index: usize = 0
    while index < size {
        if std.text.same(tableKey(table, index), key) { return index }
        index += 1
    }
    return null
}

// A sensor's name in preset files and for people ("" for a number that
// is none).
pub fn sensorKey(kind: u8) -> []const u8 {
    if @intCast(usize, kind) >= SENSOR_KINDS { return "" }
    return SENSOR_NAMES[@intCast(usize, kind)].key
}

pub fn sensorName(kind: u8, german: bool) -> []const u8 {
    if @intCast(usize, kind) >= SENSOR_KINDS { return "" }
    return if german { SENSOR_NAMES[@intCast(usize, kind)].german } else { SENSOR_NAMES[@intCast(usize, kind)].name }
}

pub fn optionKey(option: usize) -> []const u8 {
    if option >= OPTIONS { return "" }
    return OPTION_KEYS[option]
}

pub fn optionName(option: usize, german: bool) -> []const u8 {
    if option >= OPTIONS { return "" }
    return if german { OPTION_GERMAN[option] } else { OPTION_ENGLISH[option] }
}

pub fn combineName(mode: u8, german: bool) -> []const u8 {
    if @intCast(usize, mode) >= COMBINE_MODES { return "" }
    return if german { COMBINE_NAMES[@intCast(usize, mode)].german } else { COMBINE_NAMES[@intCast(usize, mode)].name }
}

pub fn softnessName(model: u8, german: bool) -> []const u8 {
    if model > SOFT_GAUSSIAN { return "" }
    return if german { SOFTNESS_NAMES[@intCast(usize, model)].german } else { SOFTNESS_NAMES[@intCast(usize, model)].name }
}

pub fn colorSourceName(source: u8, german: bool) -> []const u8 {
    if @intCast(usize, source) >= COLOR_SOURCES { return "" }
    return if german { COLOR_NAMES[@intCast(usize, source)].german } else { COLOR_NAMES[@intCast(usize, source)].name }
}

// ---------------------------------------------------------------------------
// Defaults

// The brush's name.
pub fn nameOf(settings: *const Settings) -> []const u8 {
    const bytes: [*]const u8 = &settings.*.name
    return bytes[0..settings.*.nameLength]
}

// `text` into `into` (room for `room` bytes) as a preset file's line
// keeps it: control characters (a line end, a tab) become blanks, blanks
// at both ends go, and what does not fit is cut where a character of
// UTF-8 begins. The length kept.
fn keepLine(into: [*]u8, room: usize, text: []const u8) -> usize {
    var start: usize = 0
    var end = text.length
    while start < end && (text[start] <= 32 || text[start] == 127) { start += 1 }
    while end > start && (text[end - 1] <= 32 || text[end - 1] == 127) { end -= 1 }
    if end - start > room {
        end = start + room
        // (Not into the middle of a character: its later bytes are
        // 10xxxxxx.)
        while end > start && text[end] & 0xC0 == 0x80 { end -= 1 }
        while end > start && (text[end - 1] <= 32 || text[end - 1] == 127) { end -= 1 }
    }
    var length: usize = 0
    while start + length < end {
        const byte = text[start + length]
        into[length] = if byte < 32 || byte == 127 { 32 } else { byte }
        length += 1
    }
    return length
}

// Sets the name: one line, at most NAME bytes (see keepLine: what is set
// is what a preset file gives back).
pub fn setName(settings: *Settings, text: []const u8) -> void {
    settings.*.nameLength = keepLine(&settings.*.name, NAME, text)
}

// The engine's own text.
pub fn textOf(settings: *const Settings) -> []const u8 {
    const bytes: [*]const u8 = &settings.*.text
    return bytes[0..settings.*.textLength]
}

// Sets the engine's text: one line, at most TEXT bytes, as setName.
pub fn setText(settings: *Settings, text: []const u8) -> void {
    settings.*.textLength = keepLine(&settings.*.text, TEXT, text)
}

// A sensor of `kind` with the curve that changes nothing: lengths of
// 1000 (pixels, milliseconds, dabs), not periodic, no drawing angle
// extras (corners would fan in steps of 30 degrees).
pub fn defaultSensor(sensor: *Sensor, kind: u8) -> void {
    sensor.*.kind = kind
    sensor.*.curve = curve_module.identity()
    sensor.*.length = 1000.0
    sensor.*.periodic = false
    sensor.*.fanCorners = false
    sensor.*.fanStep = 30.0
    sensor.*.lockAngle = false
    sensor.*.angleOffset = 0.0
}

// An option that is off; turned on it would follow the pressure.
pub fn defaultOption(option: *Option) -> void {
    option.*.on = false
    option.*.count = 1
    option.*.combine = COMBINE_MULTIPLY
    option.*.strength = 1.0
    var index: usize = 0
    while index < SENSORS {
        defaultSensor(&option.*.sensors[index], SENSOR_PRESSURE)
        index += 1
    }
}

// A round hard tip, dabs a tenth of the diameter apart.
pub fn defaultTip(tip: *Tip) -> void {
    tip.*.kind = TIP_AUTO
    tip.*.shape = SHAPE_CIRCLE
    tip.*.ratio = 1.0
    tip.*.horizontalFade = 1.0
    tip.*.verticalFade = 1.0
    tip.*.angle = 0.0
    tip.*.spikes = 2
    tip.*.density = 1.0
    tip.*.randomness = 0.0
    tip.*.softness = SOFT_DEFAULT
    tip.*.antialias = true
    tip.*.predefined = 0
    tip.*.asImage = false
    tip.*.spacing = 0.1
    tip.*.autoSpacing = false
    tip.*.autoSpacingCoefficient = 1.0
    tip.*.precision = 5
}

// A plain round brush: the pixel engine, 40 pixels, hard, opaque, dabs a
// tenth of the diameter apart, wash, the pressure drives the size, every
// other option off.
pub fn defaults(settings: *Settings) -> void {
    setName(settings, "Round brush")
    settings.*.engine = ENGINE_PAINTBRUSH
    defaultTip(&settings.*.tip)
    settings.*.size = 40.0
    settings.*.opacity = 1.0
    settings.*.flow = 1.0
    settings.*.blend = blend.NORMAL
    settings.*.eraser = false
    settings.*.paintMode = MODE_WASH
    settings.*.airbrush = false
    settings.*.airbrushRate = 50.0
    var index: usize = 0
    while index < OPTIONS {
        defaultOption(&settings.*.options[index])
        index += 1
    }
    settings.*.options[OPTION_SIZE].on = true
    settings.*.scatterAmount = 1.0
    settings.*.scatterX = true
    settings.*.scatterY = true
    settings.*.colorSource = COLOR_PLAIN
    settings.*.texture = 0
    settings.*.textureStrength = 0.0
    settings.*.textureScale = 1.0
    settings.*.textureMode = 0
    index = 0
    while index < VALUES {
        settings.*.values[index] = 0.0
        index += 1
    }
    settings.*.textLength = 0
}

fn held(value: f64, low: f64, high: f64, otherwise: f64) -> f64 {
    if !(value == value) { return otherwise }
    if value < low { return low }
    if value > high { return high }
    return value
}

// Makes any Settings one the framework can paint with: every number held
// to its range (what is no number becomes the default), curves valid,
// counts and kinds inside what there is, the name and the text one line
// each (as setName and setText keep them). The stroke does this to its
// copy; whoever reads settings from outside may too.
pub fn sanitize(settings: *Settings) -> void {
    if settings.*.nameLength > NAME { settings.*.nameLength = NAME }
    if settings.*.textLength > TEXT { settings.*.textLength = TEXT }
    // (Both are one line, as setName and setText make them; the bytes are
    // moved toward the start only, so reading and writing one array is
    // safe.)
    setName(settings, nameOf(settings))
    setText(settings, textOf(settings))
    settings.*.size = held(settings.*.size, SMALLEST_SIZE, LARGEST_SIZE, 40.0)
    settings.*.opacity = held(settings.*.opacity, 0.0, 1.0, 1.0)
    settings.*.flow = held(settings.*.flow, 0.0, 1.0, 1.0)
    if settings.*.paintMode > MODE_BUILD_UP { settings.*.paintMode = MODE_WASH }
    settings.*.airbrushRate = held(settings.*.airbrushRate, 1.0, 1000.0, 50.0)
    settings.*.scatterAmount = held(settings.*.scatterAmount, 0.0, 10.0, 1.0)
    if @intCast(usize, settings.*.colorSource) >= COLOR_SOURCES { settings.*.colorSource = COLOR_PLAIN }
    settings.*.textureStrength = held(settings.*.textureStrength, 0.0, 1.0, 0.0)
    settings.*.textureScale = held(settings.*.textureScale, 0.01, 100.0, 1.0)
    const tip = &settings.*.tip
    if tip.*.kind > TIP_PREDEFINED { tip.*.kind = TIP_AUTO }
    if tip.*.shape > SHAPE_RECTANGLE { tip.*.shape = SHAPE_CIRCLE }
    tip.*.ratio = held(tip.*.ratio, 0.01, 1.0, 1.0)
    tip.*.horizontalFade = held(tip.*.horizontalFade, 0.0, 1.0, 1.0)
    tip.*.verticalFade = held(tip.*.verticalFade, 0.0, 1.0, 1.0)
    tip.*.angle = held(tip.*.angle, -3600.0, 3600.0, 0.0)
    if tip.*.spikes < 2 { tip.*.spikes = 2 }
    if tip.*.spikes > 12 { tip.*.spikes = 12 }
    tip.*.density = held(tip.*.density, 0.0, 1.0, 1.0)
    tip.*.randomness = held(tip.*.randomness, 0.0, 1.0, 0.0)
    if tip.*.softness > SOFT_GAUSSIAN { tip.*.softness = SOFT_DEFAULT }
    if @intCast(usize, tip.*.predefined) >= tip_module.predefinedCount() { tip.*.predefined = 0 }
    tip.*.spacing = held(tip.*.spacing, 0.01, 10.0, 0.1)
    tip.*.autoSpacingCoefficient = held(tip.*.autoSpacingCoefficient, 0.1, 10.0, 1.0)
    if tip.*.precision < 1 { tip.*.precision = 1 }
    if tip.*.precision > 5 { tip.*.precision = 5 }
    var index: usize = 0
    while index < OPTIONS {
        const option = &settings.*.options[index]
        if @intCast(usize, option.*.count) > SENSORS { option.*.count = 4 }
        if @intCast(usize, option.*.combine) >= COMBINE_MODES { option.*.combine = COMBINE_MULTIPLY }
        option.*.strength = held(option.*.strength, 0.0, 1.0, 1.0)
        var slot: usize = 0
        while slot < SENSORS {
            const sensor = &option.*.sensors[slot]
            if @intCast(usize, sensor.*.kind) >= SENSOR_KINDS { sensor.*.kind = SENSOR_PRESSURE }
            curve_module.normalize(&sensor.*.curve)
            sensor.*.length = held(sensor.*.length, 1.0, 1000000.0, 1000.0)
            sensor.*.fanStep = held(sensor.*.fanStep, 1.0, 180.0, 30.0)
            sensor.*.angleOffset = held(sensor.*.angleOffset, -360.0, 360.0, 0.0)
            slot += 1
        }
        index += 1
    }
    index = 0
    while index < VALUES {
        if !(settings.*.values[index] == settings.*.values[index]) { settings.*.values[index] = 0.0 }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// The text form: a preset file.
//
//     # nebula brush preset
//     name = Round brush
//     engine = paintbrush
//     size = 40
//     tip.kind = auto
//     tip.fade_h = 1
//     option.size = 1
//     option.size.sensors = 1
//     option.size.sensor.0 = pressure
//     option.size.sensor.0.curve = 0,0;1,1
//     ...
//
// One "key = value" a line; lines that are empty or begin with "#" are
// passed over. On and off are 1 and 0. The keys:
//
//   name, engine (an Engine's key), size, opacity, flow, blend
//   (core/blend.mlx's name), eraser, mode (wash, buildup), airbrush,
//   airbrush_rate, scatter (the amount), scatter_x, scatter_y, color
//   (plain, uniform, total, gradient, pattern), texture,
//   texture_strength, texture_scale, texture_mode, text, value.N (N: 0 to
//   31; only those that are not 0 are written)
//   tip.kind (auto, predefined), tip.shape (circle, rectangle), tip.ratio,
//   tip.fade_h, tip.fade_v, tip.angle, tip.spikes, tip.density,
//   tip.randomness, tip.softness (default, soft, gaussian), tip.antialias,
//   tip.predefined (a built-in tip's key), tip.image, tip.spacing,
//   tip.auto_spacing, tip.auto_spacing_coefficient, tip.precision
//   option.O (on or off; O is optionKey(): size, opacity, ...),
//   option.O.strength, option.O.combine (multiply, add, max, min,
//   difference), option.O.sensors (how many), and for each sensor that
//   counts, S from 0: option.O.sensor.S (sensorKey(): pressure, speed,
//   ...), option.O.sensor.S.curve ("x,y;x,y;..."), .length, .periodic,
//   .fan, .fan_step, .lock, .offset
//
// Sensors past an option's count are not written (they do nothing) and
// come back as the default.

fn putKey(into: *std.ArrayList(u8), prefix: []const u8, key: []const u8) -> bool {
    return into.appendSlice(prefix) && into.appendSlice(key) && into.appendSlice(" = ")
}

fn putText(into: *std.ArrayList(u8), prefix: []const u8, key: []const u8, value: []const u8) -> bool {
    return putKey(into, prefix, key) && into.appendSlice(value) && into.append(10)
}

fn putNumber(into: *std.ArrayList(u8), prefix: []const u8, key: []const u8, value: f64) -> bool {
    return putKey(into, prefix, key) && curve_module.appendNumber(into, value) && into.append(10)
}

fn putCount(into: *std.ArrayList(u8), prefix: []const u8, key: []const u8, value: usize) -> bool {
    return putNumber(into, prefix, key, @floatFromInt(f64, value))
}

fn putBool(into: *std.ArrayList(u8), prefix: []const u8, key: []const u8, value: bool) -> bool {
    return putText(into, prefix, key, if value { "1" } else { "0" })
}

// The key "option.O", "option.O.FIELD", "option.O.sensor.S" or
// "option.O.sensor.S.FIELD" and " = " (S: the slot, SENSORS for none;
// FIELD: "" for none). (Written piece by piece into `into`: a key put
// together in a local buffer first would take that buffer from the value
// arena on every call.)
fn putOptionKey(into: *std.ArrayList(u8), option: usize, slot: usize, field: []const u8) -> bool {
    if !into.appendSlice("option.") || !into.appendSlice(OPTION_KEYS[option]) { return false }
    if slot < SENSORS {
        if !into.appendSlice(".sensor.") || !into.append(@intCast(u8, 48 + slot)) { return false }
    }
    if field.length > 0 {
        if !into.append(46) || !into.appendSlice(field) { return false }
    }
    return into.appendSlice(" = ")
}

// The settings as a preset file's text, added to `into`. False without
// memory (`into` then holds a part).
pub fn write(settings: *const Settings, into: *std.ArrayList(u8)) -> bool {
    if !into.appendSlice("# nebula brush preset\n") { return false }
    if !putText(into, "", "name", nameOf(settings)) { return false }
    const engine = engines.find(settings.*.engine)
    if engine != null {
        if !putText(into, "", "engine", engine.?.*.key) { return false }
    }
    if !putNumber(into, "", "size", settings.*.size) { return false }
    if !putNumber(into, "", "opacity", settings.*.opacity) { return false }
    if !putNumber(into, "", "flow", settings.*.flow) { return false }
    if !putText(into, "", "blend", blend.name(settings.*.blend)) { return false }
    if !putBool(into, "", "eraser", settings.*.eraser) { return false }
    if !putText(into, "", "mode", if settings.*.paintMode == MODE_BUILD_UP { "buildup" } else { "wash" }) { return false }
    if !putBool(into, "", "airbrush", settings.*.airbrush) { return false }
    if !putNumber(into, "", "airbrush_rate", settings.*.airbrushRate) { return false }
    if !putNumber(into, "", "scatter", settings.*.scatterAmount) { return false }
    if !putBool(into, "", "scatter_x", settings.*.scatterX) { return false }
    if !putBool(into, "", "scatter_y", settings.*.scatterY) { return false }
    const source = if @intCast(usize, settings.*.colorSource) < COLOR_SOURCES { @intCast(usize, settings.*.colorSource) } else { 0 }
    if !putText(into, "", "color", COLOR_NAMES[source].key) { return false }
    if !putCount(into, "", "texture", @intCast(usize, settings.*.texture)) { return false }
    if !putNumber(into, "", "texture_strength", settings.*.textureStrength) { return false }
    if !putNumber(into, "", "texture_scale", settings.*.textureScale) { return false }
    if !putCount(into, "", "texture_mode", @intCast(usize, settings.*.textureMode)) { return false }
    if settings.*.textLength > 0 {
        if !putText(into, "", "text", textOf(settings)) { return false }
    }
    var index: usize = 0
    while index < VALUES {
        if settings.*.values[index] != 0.0 {
            if !into.appendSlice("value.") || !curve_module.appendNumber(into, @floatFromInt(f64, index)) || !into.appendSlice(" = ") { return false }
            if !curve_module.appendNumber(into, @floatCast(f64, settings.*.values[index])) || !into.append(10) { return false }
        }
        index += 1
    }

    const tip = &settings.*.tip
    if !putText(into, "tip.", "kind", if tip.*.kind == TIP_PREDEFINED { "predefined" } else { "auto" }) { return false }
    if !putText(into, "tip.", "shape", if tip.*.shape == SHAPE_RECTANGLE { "rectangle" } else { "circle" }) { return false }
    if !putNumber(into, "tip.", "ratio", tip.*.ratio) { return false }
    if !putNumber(into, "tip.", "fade_h", tip.*.horizontalFade) { return false }
    if !putNumber(into, "tip.", "fade_v", tip.*.verticalFade) { return false }
    if !putNumber(into, "tip.", "angle", tip.*.angle) { return false }
    if !putCount(into, "tip.", "spikes", @intCast(usize, tip.*.spikes)) { return false }
    if !putNumber(into, "tip.", "density", tip.*.density) { return false }
    if !putNumber(into, "tip.", "randomness", tip.*.randomness) { return false }
    const model = if tip.*.softness <= SOFT_GAUSSIAN { @intCast(usize, tip.*.softness) } else { 0 }
    if !putText(into, "tip.", "softness", SOFTNESS_NAMES[model].key) { return false }
    if !putBool(into, "tip.", "antialias", tip.*.antialias) { return false }
    if !putText(into, "tip.", "predefined", tip_module.predefinedKey(@intCast(usize, tip.*.predefined))) { return false }
    if !putBool(into, "tip.", "image", tip.*.asImage) { return false }
    if !putNumber(into, "tip.", "spacing", tip.*.spacing) { return false }
    if !putBool(into, "tip.", "auto_spacing", tip.*.autoSpacing) { return false }
    if !putNumber(into, "tip.", "auto_spacing_coefficient", tip.*.autoSpacingCoefficient) { return false }
    if !putCount(into, "tip.", "precision", @intCast(usize, tip.*.precision)) { return false }

    index = 0
    while index < OPTIONS {
        const option = &settings.*.options[index]
        if !putOptionKey(into, index, SENSORS, "") || !into.appendSlice(if option.*.on { "1\n" } else { "0\n" }) { return false }
        if !putOptionKey(into, index, SENSORS, "strength") || !curve_module.appendNumber(into, option.*.strength) || !into.append(10) { return false }
        const mode = if @intCast(usize, option.*.combine) < COMBINE_MODES { @intCast(usize, option.*.combine) } else { 0 }
        if !putOptionKey(into, index, SENSORS, "combine") || !into.appendSlice(COMBINE_NAMES[mode].key) || !into.append(10) { return false }
        const count = if @intCast(usize, option.*.count) < SENSORS { @intCast(usize, option.*.count) } else { SENSORS }
        if !putOptionKey(into, index, SENSORS, "sensors") || !curve_module.appendNumber(into, @floatFromInt(f64, count)) || !into.append(10) { return false }
        var slot: usize = 0
        while slot < count {
            const sensor = &option.*.sensors[slot]
            const kind = if @intCast(usize, sensor.*.kind) < SENSOR_KINDS { @intCast(usize, sensor.*.kind) } else { 0 }
            if !putOptionKey(into, index, slot, "") || !into.appendSlice(SENSOR_NAMES[kind].key) || !into.append(10) { return false }
            if !putOptionKey(into, index, slot, "curve") || !curve_module.write(&sensor.*.curve, into) || !into.append(10) { return false }
            if !putOptionKey(into, index, slot, "length") || !curve_module.appendNumber(into, sensor.*.length) || !into.append(10) { return false }
            if !putOptionKey(into, index, slot, "periodic") || !into.appendSlice(if sensor.*.periodic { "1\n" } else { "0\n" }) { return false }
            if !putOptionKey(into, index, slot, "fan") || !into.appendSlice(if sensor.*.fanCorners { "1\n" } else { "0\n" }) { return false }
            if !putOptionKey(into, index, slot, "fan_step") || !curve_module.appendNumber(into, sensor.*.fanStep) || !into.append(10) { return false }
            if !putOptionKey(into, index, slot, "lock") || !into.appendSlice(if sensor.*.lockAngle { "1\n" } else { "0\n" }) { return false }
            if !putOptionKey(into, index, slot, "offset") || !curve_module.appendNumber(into, sensor.*.angleOffset) || !into.append(10) { return false }
            slot += 1
        }
        index += 1
    }
    return true
}

// The `index`th piece of `key` between its points ("" past the last).
fn piece(key: []const u8, index: usize) -> []const u8 {
    var start: usize = 0
    var number: usize = 0
    var at: usize = 0
    while at <= key.length {
        if at == key.length || key[at] == 46 {
            if number == index { return key[start..at] }
            number += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

fn numberOf(text: []const u8, into: *f64) -> bool {
    var at: usize = 0
    var value: f64 = 0.0
    if !curve_module.parseNumber(text, &at, &value) { return false }
    if std.text.trimmed(text[at..]).length != 0 { return false }
    into.* = value
    return true
}

fn readNumber(text: []const u8, into: *f64) -> bool {
    var value: f64 = 0.0
    if !numberOf(text, &value) { return false }
    into.* = value
    return true
}

// A whole number of 0 to `high` (what is beyond is held to it).
fn readCount(text: []const u8, high: usize, into: *usize) -> bool {
    var value: f64 = 0.0
    if !numberOf(text, &value) { return false }
    const top = @floatFromInt(f64, high)
    if !(value > 0.0) { value = 0.0 }
    if value > top { value = top }
    into.* = @intFromFloat(usize, value + 0.5)
    return true
}

fn readBool(text: []const u8, into: *bool) -> bool {
    if std.text.same(text, "1") || std.text.same(text, "true") || std.text.same(text, "on") {
        into.* = true
        return true
    }
    if std.text.same(text, "0") || std.text.same(text, "false") || std.text.same(text, "off") {
        into.* = false
        return true
    }
    return false
}

fn parseTip(tip: *Tip, key: []const u8, value: []const u8) -> bool {
    var count: usize = 0
    if std.text.same(key, "kind") {
        if std.text.same(value, "predefined") { tip.*.kind = TIP_PREDEFINED } else if std.text.same(value, "auto") { tip.*.kind = TIP_AUTO } else { return false }
        return true
    }
    if std.text.same(key, "shape") {
        if std.text.same(value, "rectangle") { tip.*.shape = SHAPE_RECTANGLE } else if std.text.same(value, "circle") { tip.*.shape = SHAPE_CIRCLE } else { return false }
        return true
    }
    if std.text.same(key, "ratio") { return readNumber(value, &tip.*.ratio) }
    if std.text.same(key, "fade_h") { return readNumber(value, &tip.*.horizontalFade) }
    if std.text.same(key, "fade_v") { return readNumber(value, &tip.*.verticalFade) }
    if std.text.same(key, "angle") { return readNumber(value, &tip.*.angle) }
    if std.text.same(key, "spikes") {
        if !readCount(value, 12, &count) { return false }
        tip.*.spikes = @intCast(u8, count)
        return true
    }
    if std.text.same(key, "density") { return readNumber(value, &tip.*.density) }
    if std.text.same(key, "randomness") { return readNumber(value, &tip.*.randomness) }
    if std.text.same(key, "softness") {
        const found = indexOf(SOFTNESS_TABLE, value)
        if found == null { return false }
        tip.*.softness = @intCast(u8, found.?)
        return true
    }
    if std.text.same(key, "antialias") { return readBool(value, &tip.*.antialias) }
    if std.text.same(key, "predefined") {
        const found = tip_module.predefinedByKey(value)
        if found == null { return false }
        tip.*.predefined = @intCast(u16, found.?)
        return true
    }
    if std.text.same(key, "image") { return readBool(value, &tip.*.asImage) }
    if std.text.same(key, "spacing") { return readNumber(value, &tip.*.spacing) }
    if std.text.same(key, "auto_spacing") { return readBool(value, &tip.*.autoSpacing) }
    if std.text.same(key, "auto_spacing_coefficient") { return readNumber(value, &tip.*.autoSpacingCoefficient) }
    if std.text.same(key, "precision") {
        if !readCount(value, 5, &count) { return false }
        tip.*.precision = @intCast(u8, count)
        return true
    }
    return false
}

fn parseSensor(sensor: *Sensor, key: []const u8, value: []const u8) -> bool {
    if key.length == 0 {
        const found = indexOf(SENSOR_TABLE, value)
        if found == null { return false }
        sensor.*.kind = @intCast(u8, found.?)
        return true
    }
    if std.text.same(key, "curve") { return curve_module.parse(value, &sensor.*.curve) }
    if std.text.same(key, "length") { return readNumber(value, &sensor.*.length) }
    if std.text.same(key, "periodic") { return readBool(value, &sensor.*.periodic) }
    if std.text.same(key, "fan") { return readBool(value, &sensor.*.fanCorners) }
    if std.text.same(key, "fan_step") { return readNumber(value, &sensor.*.fanStep) }
    if std.text.same(key, "lock") { return readBool(value, &sensor.*.lockAngle) }
    if std.text.same(key, "offset") { return readNumber(value, &sensor.*.angleOffset) }
    return false
}

// `key` is what follows "option.": "size", "size.strength",
// "size.sensor.0.curve", ...
fn parseOption(settings: *Settings, key: []const u8, value: []const u8) -> bool {
    const found = indexOf(OPTION_TABLE, piece(key, 0))
    if found == null { return false }
    const option = &settings.*.options[found.?]
    const what = piece(key, 1)
    var count: usize = 0
    if what.length == 0 { return readBool(value, &option.*.on) }
    if std.text.same(what, "strength") { return readNumber(value, &option.*.strength) }
    if std.text.same(what, "combine") {
        const mode = indexOf(COMBINE_TABLE, value)
        if mode == null { return false }
        option.*.combine = @intCast(u8, mode.?)
        return true
    }
    if std.text.same(what, "sensors") {
        if !readCount(value, SENSORS, &count) { return false }
        option.*.count = @intCast(u8, count)
        return true
    }
    if std.text.same(what, "sensor") {
        if !readCount(piece(key, 2), 255, &count) || count >= SENSORS { return false }
        return parseSensor(&option.*.sensors[count], piece(key, 3), value)
    }
    return false
}

fn parseLine(settings: *Settings, key: []const u8, value: []const u8) -> bool {
    const first = piece(key, 0)
    var count: usize = 0
    if std.text.same(first, "tip") { return parseTip(&settings.*.tip, piece(key, 1), value) }
    if std.text.same(first, "option") {
        if key.length < 8 { return false }
        return parseOption(settings, key[7..], value)
    }
    if std.text.same(first, "value") {
        var number: f64 = 0.0
        if !readCount(piece(key, 1), 255, &count) || count >= VALUES || !readNumber(value, &number) { return false }
        settings.*.values[count] = @floatCast(f32, number)
        return true
    }
    if std.text.same(key, "name") {
        setName(settings, value)
        return true
    }
    if std.text.same(key, "engine") {
        const engine = engines.byKey(value)
        if engine == null { return false }
        settings.*.engine = engine.?.*.id
        return true
    }
    if std.text.same(key, "size") { return readNumber(value, &settings.*.size) }
    if std.text.same(key, "opacity") { return readNumber(value, &settings.*.opacity) }
    if std.text.same(key, "flow") { return readNumber(value, &settings.*.flow) }
    if std.text.same(key, "blend") {
        settings.*.blend = blend.byName(value)
        return true
    }
    if std.text.same(key, "eraser") { return readBool(value, &settings.*.eraser) }
    if std.text.same(key, "mode") {
        if std.text.same(value, "buildup") { settings.*.paintMode = MODE_BUILD_UP } else if std.text.same(value, "wash") { settings.*.paintMode = MODE_WASH } else { return false }
        return true
    }
    if std.text.same(key, "airbrush") { return readBool(value, &settings.*.airbrush) }
    if std.text.same(key, "airbrush_rate") { return readNumber(value, &settings.*.airbrushRate) }
    if std.text.same(key, "scatter") { return readNumber(value, &settings.*.scatterAmount) }
    if std.text.same(key, "scatter_x") { return readBool(value, &settings.*.scatterX) }
    if std.text.same(key, "scatter_y") { return readBool(value, &settings.*.scatterY) }
    if std.text.same(key, "color") {
        const found = indexOf(COLOR_TABLE, value)
        if found == null { return false }
        settings.*.colorSource = @intCast(u8, found.?)
        return true
    }
    if std.text.same(key, "texture") {
        if !readCount(value, 65535, &count) { return false }
        settings.*.texture = @intCast(u16, count)
        return true
    }
    if std.text.same(key, "texture_strength") { return readNumber(value, &settings.*.textureStrength) }
    if std.text.same(key, "texture_scale") { return readNumber(value, &settings.*.textureScale) }
    if std.text.same(key, "texture_mode") {
        if !readCount(value, 255, &count) { return false }
        settings.*.textureMode = @intCast(u8, count)
        return true
    }
    if std.text.same(key, "text") {
        setText(settings, value)
        return true
    }
    return false
}

// Reads a preset file's text into `into`: starting from defaults(), every
// line that names a key and a value this version knows sets it; all other
// lines are passed over (keys of a newer version, values that are not
// what the key takes); then sanitize(). True when at least one line was
// taken and the engine named (if one is) is known; false otherwise, with
// `into` holding the defaults.
pub fn parse(text: []const u8, into: *Settings) -> bool {
    defaults(into)
    var taken: usize = 0
    var known = true
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[start..end])
        start = end + 1
        if line.length == 0 || line[0] == 35 { continue }
        var split: usize = 0
        while split < line.length && line[split] != 61 { split += 1 }
        if split >= line.length { continue }
        const key = std.text.trimmed(line[0..split])
        const value = std.text.trimmed(line[split + 1..])
        if parseLine(into, key, value) {
            taken += 1
        } else if std.text.same(key, "engine") {
            known = false
        }
    }
    if taken == 0 || !known {
        defaults(into)
        return false
    }
    sanitize(into)
    return true
}
