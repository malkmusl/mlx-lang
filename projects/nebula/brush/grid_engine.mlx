// nebula brush: the grid engine ("grid"), Krita's grid brush: the image
// is divided into a grid of cells (fixed on the image, from its origin),
// and every cell whose centre a dab covers (its tip's mask there at least
// one half) is filled with a shape: a rectangle, an ellipse, or either at
// random. The result is a mosaic: a stroke lays down whole tiles, each
// with the gaps its borders leave.
//
// Its numbers in Settings.values (values() lists them with their ranges
// and defaults; defaults() makes a grid brush):
//
//    0  cell width           pixels (1 to 1000; 12)
//    1  cell height          pixels (1 to 1000; 12)
//    2  shape                0 rectangle, 1 ellipse, 2 either at random
//                            (0)
//    3  scale                0..1: the shape's size in its cell, after
//                            the borders (1)
//    4  horizontal border    pixels left free at the cell's left and
//    5  vertical border      right (top and bottom) side (0 to 500; 1)
//    6  jitter borders       0..1: each border up to that part wider or
//                            narrower at random (0)
//    7  division             1 to 16: every cell is cut into that many
//                            columns and rows (1)
//    8  division by pressure 1: the division is the pen's pressure times
//                            it (at least 1) (0)
//    9  hue jitter           0..1: a cell's hue turned by up to half that
//                            of a full turn either way (0)
//   10  saturation jitter, 11 value jitter: 0..1, moved by up to half
//                            that either way (0)
//   12  opacity jitter       0..1: a cell up to that part fainter (0)
//
// A cell is filled once in a stroke, however many of its dabs cover it
// (so that the mosaic does not darken where dabs overlap). What is random
// about a cell (its shape, borders, colour) comes from the stroke's seed
// and the cell's place: the same seed, the same mosaic. A dab that would
// cover more than 16384 cells takes cells as many times larger as it
// needs to stay within that. Not done: Krita's line and pixel particles,
// colours sampled from the layer, a filled background.
const std = @import("std")
const math = @import("std.math")
const types = @import("./types.mlx")
const tip = @import("./tip.mlx")
const geom = @import("../core/geom.mlx")
const raster = @import("../core/raster.mlx")
const table = @import("../core/table.mlx")
// (The ink the procedural engines share lives in the sketch engine's
// module.)
const ink_module = @import("./sketch_engine.mlx")

pub const Rect = geom.Rect
const Value = ink_module.Value

// The engine's number (Settings.engine): types.mlx has no name for it yet.
pub const ENGINE_GRID: u16 = 15

const CELL_WIDTH: usize = 0
const CELL_HEIGHT: usize = 1
const SHAPE: usize = 2
const SCALE: usize = 3
const BORDER_X: usize = 4
const BORDER_Y: usize = 5
const JITTER: usize = 6
const DIVISION: usize = 7
const DIVISION_BY_PRESSURE: usize = 8
const HUE_JITTER: usize = 9
const SATURATION_JITTER: usize = 10
const VALUE_JITTER: usize = 11
const OPACITY_JITTER: usize = 12

pub const SHAPE_RECTANGLE: usize = 0
pub const SHAPE_ELLIPSE: usize = 1
pub const SHAPE_RANDOM: usize = 2

// The most cells one dab looks at.
const MOST_CELLS: f64 = 16384.0

const VALUES = [13]Value{
    Value.{ .key = "cell_width", .name = "Cell width", .german = "Zellenbreite", .low = 1.0, .high = 1000.0, .initial = 12.0 },
    Value.{ .key = "cell_height", .name = "Cell height", .german = "Zellenhöhe", .low = 1.0, .high = 1000.0, .initial = 12.0 },
    Value.{ .key = "shape", .name = "Shape", .german = "Form", .low = 0.0, .high = 2.0, .initial = 0.0 },
    Value.{ .key = "scale", .name = "Scale", .german = "Skalierung", .low = 0.0, .high = 1.0, .initial = 1.0 },
    Value.{ .key = "border_x", .name = "Horizontal border", .german = "Rand waagerecht", .low = 0.0, .high = 500.0, .initial = 1.0 },
    Value.{ .key = "border_y", .name = "Vertical border", .german = "Rand senkrecht", .low = 0.0, .high = 500.0, .initial = 1.0 },
    Value.{ .key = "jitter", .name = "Jitter borders", .german = "Ränder zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "division", .name = "Division", .german = "Teilung", .low = 1.0, .high = 16.0, .initial = 1.0 },
    Value.{ .key = "division_pressure", .name = "Division by pressure", .german = "Teilung nach Druck", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "hue_jitter", .name = "Hue jitter", .german = "Farbton zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "saturation_jitter", .name = "Saturation jitter", .german = "Sättigung zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "value_jitter", .name = "Value jitter", .german = "Helligkeit zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
    Value.{ .key = "opacity_jitter", .name = "Opacity jitter", .german = "Deckkraft zufällig", .low = 0.0, .high = 1.0, .initial = 0.0 },
}

var keptValues: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The engine's numbers (row N is Settings.values[N]).
pub fn values() -> []const Value {
    if keptValues.address != 0 { return table.rows(Value, &keptValues) }
    return table.keep(Value, &keptValues, VALUES[0..])
}

// A grid brush: types.defaults() with this engine, 50 pixels, a hard
// tip, dabs a fifth of the diameter apart, the size not by pressure, and
// the numbers' defaults.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Grid")
    settings.*.engine = ENGINE_GRID
    settings.*.size = 50.0
    settings.*.tip.spacing = 0.2
    settings.*.options[types.OPTION_SIZE].on = false
    ink_module.applyValues(settings, values())
}

// What a stroke keeps: the ink and the cells it filled.
const Own = @noncopy(struct) {
    ink: *ink_module.Ink
    // A cell's key: cellKey().
    filled: std.AutoHashSet(u64)
}

fn ownOf(stroke: *types.Stroke) -> *Own {
    unsafe { return @ptrFromInt(*Own, stroke.*.engineState) }
}

fn begin(stroke: *types.Stroke) -> bool {
    const allocator = stroke.*.allocator
    const memory = allocator.alloc(@sizeOf(Own), 16)
    const ink = ink_module.inkCreate(allocator)
    if memory == null || ink == null {
        if memory != null { allocator.free(memory.?, @sizeOf(Own), 16) }
        if ink != null { ink_module.inkDestroy(ink.?, allocator) }
        return false
    }
    const own: *Own = unsafe { @ptrCast(*Own, memory.?) }
    own.*.ink = ink.?
    own.*.filled = std.AutoHashSet(u64).init(allocator)
    stroke.*.engineState = @intFromPtr(own)
    return true
}

fn free(stroke: *types.Stroke) -> void {
    if stroke.*.engineState == 0 { return }
    const own = ownOf(stroke)
    const allocator = stroke.*.allocator
    own.*.filled.deinit()
    ink_module.inkDestroy(own.*.ink, allocator)
    unsafe { allocator.free(@ptrCast([*]u8, own), @sizeOf(Own), 16) }
    stroke.*.engineState = 0
}

fn mixed(value: u64) -> u64 {
    var z = value +% 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
    return z ^ (z >> 31)
}

// The cell (column, row) of the grid cut `size` times finer, as one
// number.
fn cellKey(column: i64, row: i64, size: i64) -> u64 {
    return mixed(@bitCast(u64, column) *% 0x9E3779B97F4A7C15 ^ @bitCast(u64, row) *% 0xC2B2AE3D27D4EB4F ^ @bitCast(u64, size) *% 0x165667B19E3779F9)
}

// A number 0..1 for a cell, the same for the same cell, seed and `salt`.
fn cellChance(key: u64, seed: u64, salt: u64) -> f64 {
    const hash = mixed(key ^ (seed *% 0xD6E8FEB86659FD93) ^ (salt *% 0xA0761D6478BD642F))
    return @floatFromInt(f64, @intCast(i64, hash >> 11)) / 9007199254740992.0
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const own = ownOf(stroke)
    const ink = own.*.ink
    ink_module.inkFor(ink, stroke, dab)
    const mask = &stroke.*.mask
    if !tip.forDab(&stroke.*.masks, &stroke.*.settings.*.tip, dab, mask) { return geom.empty() }
    const list = values()
    var division = ink_module.number(stroke, list, DIVISION)
    if ink_module.isSet(stroke, list, DIVISION_BY_PRESSURE) {
        division = math.max(1.0, math.round(division * math.clamp(dab.*.point.pressure, 0.0, 1.0)))
    }
    division = math.round(division)
    var cell_width = ink_module.number(stroke, list, CELL_WIDTH) / division
    var cell_height = ink_module.number(stroke, list, CELL_HEIGHT) / division
    // Cells larger by a whole factor when the dab would look at too many.
    const mask_width = @floatFromInt(f64, mask.*.width)
    const mask_height = @floatFromInt(f64, mask.*.height)
    const looked = (mask_width / cell_width + 2.0) * (mask_height / cell_height + 2.0)
    var coarser: f64 = 1.0
    if looked > MOST_CELLS { coarser = math.ceil(@sqrt(looked / MOST_CELLS)) }
    cell_width *= coarser
    cell_height *= coarser
    const size_key = @intFromFloat(i64, division * 1024.0 + coarser)
    const shape = ink_module.count(stroke, list, SHAPE)
    const scale = ink_module.number(stroke, list, SCALE)
    const border_x = ink_module.number(stroke, list, BORDER_X)
    const border_y = ink_module.number(stroke, list, BORDER_Y)
    const jitter = ink_module.number(stroke, list, JITTER)
    const hue_jitter = ink_module.number(stroke, list, HUE_JITTER)
    const saturation_jitter = ink_module.number(stroke, list, SATURATION_JITTER)
    const value_jitter = ink_module.number(stroke, list, VALUE_JITTER)
    const opacity_jitter = ink_module.number(stroke, list, OPACITY_JITTER)
    const colourful = hue_jitter > 0.0 || saturation_jitter > 0.0 || value_jitter > 0.0
    const one_by_one = colourful || opacity_jitter > 0.0
    const seed = stroke.*.state.seed
    const path = ink.*.path
    // The cells the mask's rectangle reaches.
    const left = @floatFromInt(f64, mask.*.x)
    const top = @floatFromInt(f64, mask.*.y)
    const column0 = @intFromFloat(i64, @floor(left / cell_width))
    const column1 = @intFromFloat(i64, @floor((left + mask_width) / cell_width))
    const row0 = @intFromFloat(i64, @floor(top / cell_height))
    const row1 = @intFromFloat(i64, @floor((top + mask_height) / cell_height))
    var row = row0
    while row <= row1 {
        const cell_top = @floatFromInt(f64, row) * cell_height
        // The pixel the cell's centre lies in, in the mask.
        const my = @intFromFloat(i64, @floor(cell_top + cell_height * 0.5)) - @intCast(i64, mask.*.y)
        if my >= 0 && my < @intCast(i64, mask.*.height) {
            var column = column0
            while column <= column1 {
                const cell_left = @floatFromInt(f64, column) * cell_width
                const mx = @intFromFloat(i64, @floor(cell_left + cell_width * 0.5)) - @intCast(i64, mask.*.x)
                if mx >= 0 && mx < @intCast(i64, mask.*.width) && mask.*.bytes[@intCast(usize, my * @intCast(i64, mask.*.width) + mx)] >= 128 {
                    const key = cellKey(column, row, size_key)
                    if !own.*.filled.contains(key) {
                        // (Without memory to remember it the cell is
                        // filled all the same, perhaps again later.)
                        _ = own.*.filled.insert(key)
                        var round = shape == SHAPE_ELLIPSE
                        if shape == SHAPE_RANDOM { round = cellChance(key, seed, 1) < 0.5 }
                        var gap_x = border_x
                        var gap_y = border_y
                        if jitter > 0.0 {
                            gap_x = border_x * (1.0 + jitter * (2.0 * cellChance(key, seed, 2) - 1.0))
                            gap_y = border_y * (1.0 + jitter * (2.0 * cellChance(key, seed, 3) - 1.0))
                        }
                        const inner_width = math.max(0.0, cell_width - 2.0 * gap_x) * scale
                        const inner_height = math.max(0.0, cell_height - 2.0 * gap_y) * scale
                        const cx = cell_left + cell_width * 0.5
                        const cy = cell_top + cell_height * 0.5
                        if round {
                            ink_module.ellipseAt(path, cx, cy, inner_width * 0.5, inner_height * 0.5, 0.0)
                        } else {
                            ink_module.boxAt(path, cx, cy, inner_width, inner_height, 0.0)
                        }
                        if one_by_one {
                            if colourful {
                                const hue = (cellChance(key, seed, 4) - 0.5) * hue_jitter
                                const saturation = (cellChance(key, seed, 5) - 0.5) * saturation_jitter
                                const value = (cellChance(key, seed, 6) - 0.5) * value_jitter
                                ink_module.inkColor(ink, ink_module.shiftedColor(dab.*.color, hue, saturation, value))
                            }
                            ink_module.inkStrength(ink, 1.0 - opacity_jitter * cellChance(key, seed, 7))
                            ink_module.inkFill(ink, path, raster.NONZERO)
                        }
                    }
                }
                column += 1
            }
        }
        row += 1
    }
    ink_module.inkFill(ink, path, raster.NONZERO)
    return ink_module.inkBox(ink)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = ENGINE_GRID, .key = "grid", .name = "Grid brush", .german = "Rasterpinsel", .flags = 0, .begin = begin, .dab = paint, .end = null, .free = free },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "grid" (brush/engines.mlx lists it).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
