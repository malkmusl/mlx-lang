// nebula brush: the response curve of a sensor: what the pen does (its
// pressure, its speed, ...) goes in as 0..1, what a brush makes of it
// comes out as 0..1. A curve is 2 to 8 points with x ascending; between
// them runs the natural cubic spline through all of them (the smooth
// line that bends least; a straight line for two points), held to 0..1,
// and left of the first point and right of the last it stays at their
// height. This is the curve Krita's curve widget draws, so a curve's
// points mean the same in both.
//
//     var curve = curve_module.identity()
//     _ = curve_module.insert(&curve, 0.5, 0.2)       // a soft start
//     const half = curve_module.evaluate(&curve, 0.5) // 0.2
//
// Dabs do not evaluate splines: bake() writes the curve into 256 numbers
// (entry i is the curve at i / 255) once at the start of a stroke and
// brush/dynamics.mlx reads those.
//
// In a preset file a curve is "x,y;x,y;...": write() and parse(). The
// numbers of presets (at most 6 places after the point, no exponent) are
// written and read by appendNumber() and parseNumber(), which
// brush/types.mlx uses for every other number of a preset too.
const std = @import("std")

pub const POINTS: usize = 8
pub const TABLE: usize = 256

// Two points closer than this in x are one (the later one goes).
const CLOSEST: f64 = 0.000001

pub const Curve = struct {
    // 2 to 8.
    count: u8
    // 0..1, ascending, no two the same.
    x: [8]f64
    y: [8]f64
}

fn hold(value: f64) -> f64 {
    // (What is no number compares false with everything: it becomes 0.)
    if value >= 1.0 { return 1.0 }
    if value > 0.0 { return value }
    return 0.0
}

// The curve that changes nothing: (0, 0) to (1, 1).
pub fn identity() -> Curve {
    var made: Curve = undefined
    made.count = 2
    var index: usize = 0
    while index < POINTS {
        made.x[index] = 1.0
        made.y[index] = 1.0
        index += 1
    }
    made.x[0] = 0.0
    made.y[0] = 0.0
    return made
}

// Whether the curve is the identity's two points.
pub fn isIdentity(curve: *const Curve) -> bool {
    return curve.*.count == 2 && curve.*.x[0] == 0.0 && curve.*.y[0] == 0.0 && curve.*.x[1] == 1.0 && curve.*.y[1] == 1.0
}

// Makes any curve a valid one: its points held to 0..1, put in the order
// of their x, points at the same x made one, and the identity when fewer
// than two are left. Everything that takes points from outside (a file,
// a widget) ends with this.
pub fn normalize(curve: *Curve) -> void {
    var count = @intCast(usize, curve.*.count)
    if count > POINTS { count = POINTS }
    var index: usize = 0
    while index < count {
        curve.*.x[index] = hold(curve.*.x[index])
        curve.*.y[index] = hold(curve.*.y[index])
        index += 1
    }
    // Insertion sort: at most 8 points, nearly always in order already.
    index = 1
    while index < count {
        const px = curve.*.x[index]
        const py = curve.*.y[index]
        var at = index
        while at > 0 && curve.*.x[at - 1] > px {
            curve.*.x[at] = curve.*.x[at - 1]
            curve.*.y[at] = curve.*.y[at - 1]
            at -= 1
        }
        curve.*.x[at] = px
        curve.*.y[at] = py
        index += 1
    }
    var kept: usize = 0
    index = 0
    while index < count {
        if kept == 0 || curve.*.x[index] - curve.*.x[kept - 1] >= CLOSEST {
            curve.*.x[kept] = curve.*.x[index]
            curve.*.y[kept] = curve.*.y[index]
            kept += 1
        }
        index += 1
    }
    if kept < 2 {
        curve.* = identity()
        return
    }
    curve.*.count = @intCast(u8, kept)
    while kept < POINTS {
        curve.*.x[kept] = 1.0
        curve.*.y[kept] = 1.0
        kept += 1
    }
}

// The curve through the given points (the first 8 of them; in any order).
pub fn fromPoints(xs: []const f64, ys: []const f64) -> Curve {
    var made = identity()
    var count = if xs.length < ys.length { xs.length } else { ys.length }
    if count > POINTS { count = POINTS }
    var index: usize = 0
    while index < count {
        made.x[index] = xs[index]
        made.y[index] = ys[index]
        index += 1
    }
    made.count = @intCast(u8, count)
    normalize(&made)
    return made
}

// The spline's second derivative at every point (0 at both ends: the
// natural spline), by the three-term equations solved in one sweep.
fn bends(curve: *const Curve, into: *[8]f64) -> void {
    const count = @intCast(usize, curve.*.count)
    var index: usize = 0
    while index < POINTS {
        into.*[index] = 0.0
        index += 1
    }
    if count < 3 || count > POINTS { return }
    var upper: [8]f64 = undefined
    var right: [8]f64 = undefined
    upper[0] = 0.0
    right[0] = 0.0
    index = 1
    while index + 1 < count {
        const before = curve.*.x[index] - curve.*.x[index - 1]
        const after = curve.*.x[index + 1] - curve.*.x[index]
        if before < CLOSEST * 0.5 || after < CLOSEST * 0.5 {
            // Not a valid curve (normalize() was not called): no bend here.
            upper[index] = 0.0
            right[index] = 0.0
        } else {
            const slope = (curve.*.y[index + 1] - curve.*.y[index]) / after - (curve.*.y[index] - curve.*.y[index - 1]) / before
            const pivot = 2.0 * (before + after) - before * upper[index - 1]
            upper[index] = after / pivot
            right[index] = (6.0 * slope - before * right[index - 1]) / pivot
        }
        index += 1
    }
    index = count - 2
    while index >= 1 {
        into.*[index] = right[index] - upper[index] * into.*[index + 1]
        index -= 1
    }
}

fn valueWith(curve: *const Curve, bend: *const [8]f64, x: f64) -> f64 {
    const count = @intCast(usize, curve.*.count)
    if count < 2 || count > POINTS { return hold(x) }
    if !(x > curve.*.x[0]) { return hold(curve.*.y[0]) }
    if x >= curve.*.x[count - 1] { return hold(curve.*.y[count - 1]) }
    var piece: usize = 0
    while piece + 2 < count && x >= curve.*.x[piece + 1] { piece += 1 }
    const width = curve.*.x[piece + 1] - curve.*.x[piece]
    if width < CLOSEST * 0.5 { return hold(curve.*.y[piece + 1]) }
    const t = x - curve.*.x[piece]
    const m0 = bend.*[piece]
    const m1 = bend.*[piece + 1]
    const slope = (curve.*.y[piece + 1] - curve.*.y[piece]) / width - width * (2.0 * m0 + m1) / 6.0
    return hold(curve.*.y[piece] + t * (slope + t * (m0 * 0.5 + t * (m1 - m0) / (6.0 * width))))
}

// The curve's height at `x` (0..1; outside the points: the height of the
// nearest one).
pub fn evaluate(curve: *const Curve, x: f64) -> f64 {
    var bend: [8]f64 = undefined
    bends(curve, &bend)
    return valueWith(curve, &bend, x)
}

// The curve as 256 numbers: entry i is its height at i / 255.
pub fn bake(curve: *const Curve, into: *[256]f32) -> void {
    var bend: [8]f64 = undefined
    bends(curve, &bend)
    var index: usize = 0
    while index < TABLE {
        into.*[index] = @floatCast(f32, valueWith(curve, &bend, @floatFromInt(f64, index) / 255.0))
        index += 1
    }
}

// A new point (held to 0..1). Its place among the points; null when the
// curve has 8 already or a point sits at that x.
pub fn insert(curve: *Curve, x: f64, y: f64) -> ?usize {
    const count = @intCast(usize, curve.*.count)
    if count >= POINTS { return null }
    const px = hold(x)
    var at: usize = 0
    while at < count && curve.*.x[at] < px { at += 1 }
    if at < count && curve.*.x[at] - px < CLOSEST { return null }
    if at > 0 && px - curve.*.x[at - 1] < CLOSEST { return null }
    var index = count
    while index > at {
        curve.*.x[index] = curve.*.x[index - 1]
        curve.*.y[index] = curve.*.y[index - 1]
        index -= 1
    }
    curve.*.x[at] = px
    curve.*.y[at] = hold(y)
    curve.*.count = @intCast(u8, count + 1)
    return at
}

// Point `index` moved to (x, y): it stays between its neighbours (a point
// dragged past one stops just before it), so its place does not change.
// False for a point that is not there.
pub fn move(curve: *Curve, index: usize, x: f64, y: f64) -> bool {
    const count = @intCast(usize, curve.*.count)
    if index >= count || count > POINTS { return false }
    var px = hold(x)
    if index > 0 && px < curve.*.x[index - 1] + CLOSEST { px = curve.*.x[index - 1] + CLOSEST }
    if index + 1 < count && px > curve.*.x[index + 1] - CLOSEST { px = curve.*.x[index + 1] - CLOSEST }
    curve.*.x[index] = px
    curve.*.y[index] = hold(y)
    return true
}

// Point `index` taken out. False when it is not there or only two points
// are left (a curve has two).
pub fn remove(curve: *Curve, index: usize) -> bool {
    const count = @intCast(usize, curve.*.count)
    if index >= count || count <= 2 || count > POINTS { return false }
    var at = index
    while at + 1 < count {
        curve.*.x[at] = curve.*.x[at + 1]
        curve.*.y[at] = curve.*.y[at + 1]
        at += 1
    }
    curve.*.x[count - 1] = 1.0
    curve.*.y[count - 1] = 1.0
    curve.*.count = @intCast(u8, count - 1)
    return true
}

// ---------------------------------------------------------------------------
// Text

// `value` as a preset file has it: digits, at most 6 after the point (the
// number rounded to that), no zeros at the end, no exponent; what is no
// number is written as 0 and what is beyond +-1e12 as +-1e12. False
// without memory.
pub fn appendNumber(into: *std.ArrayList(u8), value: f64) -> bool {
    var magnitude = value
    if !(value == value) { magnitude = 0.0 }
    if magnitude < 0.0 {
        magnitude = 0.0 - magnitude
        // (-0.0000001 rounds to 0, which has no sign.)
        if magnitude >= 0.0000005 {
            if !into.append(45) { return false }
        }
    }
    if magnitude > 1000000000000.0 { magnitude = 1000000000000.0 }
    const scaled = @intFromFloat(u64, magnitude * 1000000.0 + 0.5)
    const whole = scaled / 1000000
    var part = scaled % 1000000
    var digits: [24]u8 = undefined
    var length: usize = 0
    var left = whole
    while true {
        digits[length] = @intCast(u8, 48 + left % 10)
        length += 1
        left /= 10
        if left == 0 { break }
    }
    while length > 0 {
        length -= 1
        if !into.append(digits[length]) { return false }
    }
    if part == 0 { return true }
    if !into.append(46) { return false }
    var places: usize = 6
    while part % 10 == 0 {
        part /= 10
        places -= 1
    }
    length = 0
    while length < places {
        digits[length] = @intCast(u8, 48 + part % 10)
        part /= 10
        length += 1
    }
    while length > 0 {
        length -= 1
        if !into.append(digits[length]) { return false }
    }
    return true
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

// Reads a number of `text` from place `at.*` on (blanks before it are
// passed): a sign, digits, a point and digits, an exponent ("e-3"). True
// with the number in `value.*` and `at.*` behind it; false (nothing
// changed) when no number stands there.
pub fn parseNumber(text: []const u8, at: *usize, value: *f64) -> bool {
    var index = at.*
    while index < text.length && isSpace(text[index]) { index += 1 }
    var negative = false
    if index < text.length && (text[index] == 45 || text[index] == 43) {
        negative = text[index] == 45
        index += 1
    }
    var result: f64 = 0.0
    var any = false
    while index < text.length && text[index] >= 48 && text[index] <= 57 {
        result = result * 10.0 + @floatFromInt(f64, text[index] - 48)
        any = true
        index += 1
    }
    if index < text.length && text[index] == 46 {
        index += 1
        var place: f64 = 0.1
        while index < text.length && text[index] >= 48 && text[index] <= 57 {
            result += @floatFromInt(f64, text[index] - 48) * place
            place *= 0.1
            any = true
            index += 1
        }
    }
    if !any { return false }
    if index < text.length && (text[index] == 101 || text[index] == 69) {
        var after = index + 1
        var down = false
        if after < text.length && (text[after] == 45 || text[after] == 43) {
            down = text[after] == 45
            after += 1
        }
        var exponent: usize = 0
        var digits: usize = 0
        while after < text.length && text[after] >= 48 && text[after] <= 57 {
            if exponent < 400 { exponent = exponent * 10 + @intCast(usize, text[after] - 48) }
            digits += 1
            after += 1
        }
        if digits > 0 {
            while exponent > 0 {
                result = if down { result / 10.0 } else { result * 10.0 }
                exponent -= 1
            }
            index = after
        }
    }
    value.* = if negative { 0.0 - result } else { result }
    at.* = index
    return true
}

// The curve as "x,y;x,y;...". False without memory.
pub fn write(curve: *const Curve, into: *std.ArrayList(u8)) -> bool {
    var count = @intCast(usize, curve.*.count)
    if count > POINTS { count = POINTS }
    var index: usize = 0
    while index < count {
        if index > 0 {
            if !into.append(59) { return false }
        }
        if !appendNumber(into, curve.*.x[index]) { return false }
        if !into.append(44) { return false }
        if !appendNumber(into, curve.*.y[index]) { return false }
        index += 1
    }
    return true
}

// The curve of "x,y;x,y;..." (blanks anywhere between the numbers; points
// past the eighth are dropped). False, with `into` as it was, when the
// text is not that or has fewer than two points.
pub fn parse(text: []const u8, into: *Curve) -> bool {
    var made = identity()
    var count: usize = 0
    var at: usize = 0
    while true {
        var x: f64 = 0.0
        var y: f64 = 0.0
        if !parseNumber(text, &at, &x) { return false }
        while at < text.length && isSpace(text[at]) { at += 1 }
        if at >= text.length || text[at] != 44 { return false }
        at += 1
        if !parseNumber(text, &at, &y) { return false }
        if count < POINTS {
            made.x[count] = x
            made.y[count] = y
            count += 1
        }
        while at < text.length && isSpace(text[at]) { at += 1 }
        if at >= text.length { break }
        if text[at] != 59 { return false }
        at += 1
        // A ";" at the very end is let pass.
        while at < text.length && isSpace(text[at]) { at += 1 }
        if at >= text.length { break }
    }
    if count < 2 { return false }
    made.count = @intCast(u8, count)
    normalize(&made)
    into.* = made
    return true
}
