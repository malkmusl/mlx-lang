// nebula brush: the curve engine ("curve"), Krita's curve brush: it
// remembers the last points of the stroke and, every dab once it has
// enough of them, draws a smooth curve from the oldest to the newest,
// pulled toward the points a third and two thirds of the way back (a
// cubic Bézier curve with those as its controls). The curves of
// successive dabs lie side by side like the threads of a ribbon that
// lags behind the pen and smooths its corners; a connection line from
// the dab before follows the pen itself.
//
// Its numbers in Settings.values (values() lists them with their ranges
// and defaults; defaults() makes a curve brush):
//
//   0  line width         pixels (0.05 to 20; 1)
//   1  history            points remembered, the oldest first to go (3
//                         to 256; 30)
//   2  curves opacity     0..1: the curves' coverage times it (0.5)
//   3  connection line    1: a line from the dab before (1)
//   4  pressure width     0..1: the width is that part by the pen's
//                         pressure (0)
//
// Each copy of a dab (mirrored) has its own points. Not done: Krita's
// smoothing option (the curves are always smooth).
const math = @import("std.math")
const types = @import("./types.mlx")
const geom = @import("../core/geom.mlx")
const raster = @import("../core/raster.mlx")
const table = @import("../core/table.mlx")
// (The ink the procedural engines share lives in the sketch engine's
// module.)
const ink_module = @import("./sketch_engine.mlx")

pub const Rect = geom.Rect
const Value = ink_module.Value
const SLOTS = ink_module.SLOTS

// The engine's number (Settings.engine): types.mlx has no name for it yet.
pub const ENGINE_CURVE: u16 = 14

const LINE_WIDTH: usize = 0
const HISTORY: usize = 1
const CURVES_OPACITY: usize = 2
const CONNECTION: usize = 3
const PRESSURE_WIDTH: usize = 4

const VALUES = [5]Value{
    Value.{ .key = "line_width", .name = "Line width", .german = "Linienbreite", .low = 0.05, .high = 20.0, .initial = 1.0 },
    Value.{ .key = "history", .name = "History", .german = "Verlauf", .low = 3.0, .high = 256.0, .initial = 30.0 },
    Value.{ .key = "curves_opacity", .name = "Curves opacity", .german = "Deckkraft der Kurven", .low = 0.0, .high = 1.0, .initial = 0.5 },
    Value.{ .key = "connection", .name = "Connection line", .german = "Verbindungslinie", .low = 0.0, .high = 1.0, .initial = 1.0 },
    Value.{ .key = "pressure_width", .name = "Width by pressure", .german = "Breite nach Druck", .low = 0.0, .high = 1.0, .initial = 0.0 },
}

var keptValues: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The engine's numbers (row N is Settings.values[N]).
pub fn values() -> []const Value {
    if keptValues.address != 0 { return table.rows(Value, &keptValues) }
    return table.keep(Value, &keptValues, VALUES[0..])
}

// A curve brush: types.defaults() with this engine, 20 pixels (dabs 4
// pixels apart: the points the curves go through), the size not by
// pressure, and the numbers' defaults.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Curves")
    settings.*.engine = ENGINE_CURVE
    settings.*.size = 20.0
    settings.*.tip.spacing = 0.2
    settings.*.options[types.OPTION_SIZE].on = false
    ink_module.applyValues(settings, values())
}

// What a stroke keeps: the ink, every slot's ring of points, and the
// style the curves are stroked with.
const Own = struct {
    ink: *ink_module.Ink
    history: usize
    // SLOTS rings of `history` points, x and y each.
    points: [*]f64
    first: [8]usize
    filled: [8]usize
    style: raster.Stroke
}

fn ownOf(stroke: *types.Stroke) -> *Own {
    unsafe { return @ptrFromInt(*Own, stroke.*.engineState) }
}

fn pointsBytes(history: usize) -> usize { return SLOTS * history * 2 * 8 }

fn begin(stroke: *types.Stroke) -> bool {
    const allocator = stroke.*.allocator
    const list = values()
    const history = ink_module.count(stroke, list, HISTORY)
    const memory = allocator.alloc(@sizeOf(Own), 16)
    const points = allocator.alloc(pointsBytes(history), 16)
    const ink = ink_module.inkCreate(allocator)
    if memory == null || points == null || ink == null {
        if memory != null { allocator.free(memory.?, @sizeOf(Own), 16) }
        if points != null { allocator.free(points.?, pointsBytes(history), 16) }
        if ink != null { ink_module.inkDestroy(ink.?, allocator) }
        return false
    }
    const own: *Own = unsafe { @ptrCast(*Own, memory.?) }
    own.*.ink = ink.?
    own.*.history = history
    unsafe { own.*.points = @ptrCast([*]f64, points.?) }
    var slot: usize = 0
    while slot < SLOTS {
        own.*.first[slot] = 0
        own.*.filled[slot] = 0
        slot += 1
    }
    own.*.style = raster.solid(1.0)
    own.*.style.join = raster.JOIN_ROUND
    stroke.*.engineState = @intFromPtr(own)
    return true
}

fn free(stroke: *types.Stroke) -> void {
    if stroke.*.engineState == 0 { return }
    const own = ownOf(stroke)
    const allocator = stroke.*.allocator
    ink_module.inkDestroy(own.*.ink, allocator)
    unsafe { allocator.free(@ptrCast([*]u8, own.*.points), pointsBytes(own.*.history), 16) }
    unsafe { allocator.free(@ptrCast([*]u8, own), @sizeOf(Own), 16) }
    stroke.*.engineState = 0
}

// Where in a ring the point `back` places after the oldest is (0: the
// oldest).
inline fn at(own: *Own, slot: usize, back: usize) -> usize {
    return (own.*.first[slot] + back) % own.*.history
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const own = ownOf(stroke)
    const ink = own.*.ink
    ink_module.inkFor(ink, stroke, dab)
    const list = values()
    const by_pressure = ink_module.number(stroke, list, PRESSURE_WIDTH)
    const pressure = math.clamp(dab.*.point.pressure, 0.0, 1.0)
    const width = ink_module.number(stroke, list, LINE_WIDTH) * (1.0 - by_pressure + by_pressure * pressure)
    const path = ink.*.path
    const x = dab.*.x
    const y = dab.*.y
    const slot = @intCast(usize, dab.*.copy)
    if slot >= SLOTS {
        ink_module.segment(path, x, y, x, y, width)
        ink_module.inkFill(ink, path, raster.NONZERO)
        return ink_module.inkBox(ink)
    }
    const ring = own.*.points + slot * own.*.history * 2
    const history = own.*.history
    // The connection line (a dot at the first dab).
    if ink_module.isSet(stroke, list, CONNECTION) {
        if own.*.filled[slot] == 0 {
            ink_module.segment(path, x, y, x, y, width)
        } else {
            const newest = at(own, slot, own.*.filled[slot] - 1)
            ink_module.segment(path, ring[newest * 2], ring[newest * 2 + 1], x, y, width)
        }
        ink_module.inkFill(ink, path, raster.NONZERO)
    }
    // This point joins the ring.
    if own.*.filled[slot] == history {
        own.*.first[slot] = at(own, slot, 1)
        own.*.filled[slot] -= 1
    }
    const place = at(own, slot, own.*.filled[slot])
    ring[place * 2] = x
    ring[place * 2 + 1] = y
    own.*.filled[slot] += 1
    if own.*.filled[slot] == history {
        // The curve from the oldest point to this one.
        const oldest = at(own, slot, 0)
        const third = at(own, slot, history / 3)
        const two_thirds = at(own, slot, history * 2 / 3)
        raster.moveTo(path, ring[oldest * 2], ring[oldest * 2 + 1])
        raster.cubicTo(path, ring[third * 2], ring[third * 2 + 1], ring[two_thirds * 2], ring[two_thirds * 2 + 1], x, y)
        own.*.style.width = width
        raster.stroke(path, ink.*.outline, &own.*.style)
        raster.clear(path)
        ink_module.inkStrength(ink, ink_module.number(stroke, list, CURVES_OPACITY))
        ink_module.inkFill(ink, ink.*.outline, raster.NONZERO)
    }
    return ink_module.inkBox(ink)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = ENGINE_CURVE, .key = "curve", .name = "Curve brush", .german = "Kurvenpinsel", .flags = 0, .begin = begin, .dab = paint, .end = null, .free = free },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "curve" (brush/engines.mlx lists it).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
