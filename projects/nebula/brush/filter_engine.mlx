// nebula brush: the filter brush ("filter"): a filter of the Filter menu
// (filters/registry.mlx) painted on by hand. Every dab reads its area,
// with as much around it as the filter reads (registry.margin), from the
// layer as it was before the stroke, filters that, and lays the result
// down through the tip's mask times the dab's opacity (and the
// selection's amounts): clone_engine's layDown:
//
//     pixel' = mix(pixel, filtered, mask x opacity x selection)
//
// Reading the layer as it was before the stroke, dabs that overlap never
// filter twice: a stroke of Invert inverts once wherever it goes, and a
// blur brush does not keep blurring what it blurred a dab ago. (On a
// layer whose change is open, "before" is where the change began: the
// strokes of one gesture, a multibrush's copies, filter the same picture;
// see clone_engine.keepBefore.)
//
// Which filter and with which numbers is the brush's: Settings.text is
// the filter's key ("invert", "gaussian blur", ...), optionally followed
// by "|" and the filter's own text (a curve's points, for the filters
// that take one), and Settings.values are the filter's numbers in the
// order its Info names them (setFilter() puts the filter's initial ones
// there). A brush whose text names no filter that is known paints
// nothing (its stroke does not begin).
//
// Not done: Krita's "smudge mode" (filtering what the stroke has painted
// already) and filters that need the whole picture at once (they work on
// the dab's area alone here, as on any part a filter is given). The
// brush's numbers are f32 (Settings.values): a filter's colour (its
// 0xAARRGGBB as one number) keeps only its upper 24 bits there, so such a
// filter paints with the blue of its colour rounded.
const types = @import("./types.mlx")
const shared = @import("./clone_engine.mlx")
const geom = @import("../core/geom.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")
const registry = @import("../filters/registry.mlx")

pub const Rect = geom.Rect

// More than this around a dab is not read (a blur of a larger radius is
// cut at it).
const LARGEST_MARGIN: i32 = 1024

const Own = struct {
    area: shared.Area
    before: ?*device_module.Device
    params: node_module.Params
    margin: i32
}

fn ownOf(stroke: *types.Stroke) -> *Own {
    unsafe { return @ptrFromInt(*Own, stroke.*.engineState) }
}

// Where the key ends in a filter brush's text: at its "|" or at the end.
fn keyEnd(text: []const u8) -> usize {
    var at: usize = 0
    while at < text.length && text[at] != 124 { at += 1 }
    return at
}

// The filter the brush names (null: none that is known).
pub fn filterOf(settings: *const types.Settings) -> ?*const registry.Info {
    const text = types.textOf(settings)
    return registry.byKey(text[0..keyEnd(text)])
}

// Makes the brush paint with the filter `key`, its numbers at their
// initial values. False (and nothing changed) for a key that names no
// filter.
pub fn setFilter(settings: *types.Settings, key: []const u8) -> bool {
    const info = registry.byKey(key)
    if info == null { return false }
    types.setText(settings, key)
    var index: usize = 0
    while index < types.VALUES {
        settings.*.values[index] = 0.0
        if index < info.?.*.params.length { settings.*.values[index] = @floatCast(f32, info.?.*.params[index].initial) }
        index += 1
    }
    return true
}

// A filter brush: types.defaults() with this engine, 40 pixels, a soft
// tip, blurring.
pub fn defaults(settings: *types.Settings) -> void {
    types.defaults(settings)
    types.setName(settings, "Filter brush")
    settings.*.engine = types.ENGINE_FILTER
    settings.*.paintMode = types.MODE_BUILD_UP
    settings.*.tip.horizontalFade = 0.5
    settings.*.tip.verticalFade = 0.5
    _ = setFilter(settings, "blur")
}

fn begin(stroke: *types.Stroke) -> bool {
    const memory = stroke.*.allocator.alloc(@sizeOf(Own), 16)
    if memory == null { return false }
    const own: *Own = unsafe { @ptrCast(*Own, memory.?) }
    own.*.before = null
    stroke.*.engineState = @intFromPtr(own)
    const settings = stroke.*.settings
    const info = filterOf(settings)
    if info == null { return false }
    const params = &own.*.params
    node_module.clearParams(params)
    params.*.id = info.?.*.id
    var index: usize = 0
    while index < types.VALUES {
        params.*.values[index] = @floatCast(f64, settings.*.values[index])
        index += 1
    }
    const text = types.textOf(settings)
    const end = keyEnd(text)
    if end < text.length { node_module.setParamsText(params, text[end + 1..]) }
    var margin = registry.margin(params)
    if margin < 0 { margin = 0 }
    if margin > LARGEST_MARGIN { margin = LARGEST_MARGIN }
    own.*.margin = margin
    return shared.keepBefore(stroke, &own.*.before)
}

fn free(stroke: *types.Stroke) -> void {
    if stroke.*.engineState == 0 { return }
    const own = ownOf(stroke)
    shared.dropBefore(&own.*.before)
    unsafe { stroke.*.allocator.free(@ptrFromInt([*]u8, stroke.*.engineState), @sizeOf(Own), 16) }
    stroke.*.engineState = 0
}

fn paint(stroke: *types.Stroke, dab: *const types.Dab) -> Rect {
    const own = ownOf(stroke)
    if !shared.dabArea(stroke, dab, &own.*.area) { return geom.empty() }
    const area = &own.*.area
    const margin = own.*.margin
    // (The area with its margin must be counted in an i32: a dab at the
    // very edge of what a device reaches is not filtered.)
    if @intCast(i64, area.*.x0) - @intCast(i64, margin) < -2147483647 || @intCast(i64, area.*.y0) - @intCast(i64, margin) < -2147483647 { return geom.empty() }
    if @intCast(i64, area.*.x1) + @intCast(i64, margin) > 2147483647 || @intCast(i64, area.*.y1) + @intCast(i64, margin) > 2147483647 { return geom.empty() }
    const width = shared.areaWidth(area)
    const height = shared.areaHeight(area)
    const around = @intCast(usize, margin)
    const wide = width + 2 * around
    const high = height + 2 * around
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const weights = scratch.bytes(pool, width * height)
    const pixels = scratch.words(pool, wide * high)
    if weights == null || pixels == null || !shared.amounts(stroke, area, shared.level(dab.*.opacity * dab.*.flow), weights.?) {
        scratch.release(pool, mark)
        return geom.empty()
    }
    shared.readBefore(stroke, own.*.before, geom.rect(area.*.x0 - margin, area.*.y0 - margin, @intCast(i32, wide), @intCast(i32, high)), pixels.?, wide)
    _ = registry.apply(&own.*.params, pixels.?, wide, high, wide)
    shared.layDown(stroke, area, pixels.? + (around * wide + around), wide, weights.?, false)
    scratch.release(pool, mark)
    return geom.rect(area.*.x0, area.*.y0, area.*.x1 - area.*.x0, area.*.y1 - area.*.y0)
}

const ENGINES = [1]types.Engine{
    types.Engine.{ .id = types.ENGINE_FILTER, .key = "filter", .name = "Filter brush", .german = "Filterpinsel", .flags = types.ENGINE_DIRECT, .begin = begin, .dab = paint, .end = null, .free = free },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's engine, "filter" (brush/engines.mlx lists it): a copy of
// the table in heap memory made at the first asking (core/table.mlx).
pub fn list() -> []const types.Engine {
    if kept.address != 0 { return table.rows(types.Engine, &kept) }
    return table.keep(types.Engine, &kept, ENGINES[0..])
}
