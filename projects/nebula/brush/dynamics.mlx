// nebula brush: dynamics: what the pen does, as numbers 0..1 (the
// sensors), and what an option of a brush makes of them (its curves,
// combined). The stroke (brush/stroke.mlx) keeps a State up to date with
// the calls below, in this order:
//
//     dynamics.start(&state, seed, &first)            // a stroke begins
//     dynamics.bake(&option, curves)                  // once for each option that is on
//     for every piece of the path:
//         dynamics.segment(&state, &from, &to)
//         for every dab on it:
//             state.point = point.between(&from, &to, t)
//             dynamics.place(&state, t, t * length)
//             const size = dynamics.evaluate(&option, curves, &state, salt)
//             dynamics.placed(&state)
//         dynamics.finish(&state)
//
// Nothing here allocates. The sensors:
//
//   PRESSURE             the pen's pressure
//   PRESSURE_IN          the largest pressure of the stroke so far
//   X_TILT, Y_TILT       1 - |tilt|: 1 upright, 0 leaning fully
//   TILT_DIRECTION       where the pen leans to, as a part of the full
//                        turn: 0 to the right, 0.25 down (clockwise on the
//                        screen, where y grows downward); 0 when upright
//   TILT_ELEVATION       1 - the length of (tiltX, tiltY), not below 0:
//                        1 upright, 0 lying flat
//   SPEED                the speed in pixels a millisecond over
//                        FULL_SPEED (3: Krita's sensor reads 1 there
//                        too), not above 1. The speed is each segment's
//                        length over its duration put through a low-pass
//                        with the time constant SPEED_TIME (50 ms): after
//                        that long at a new speed the sensor has gone 63%
//                        of the way to it. A stroke starts at rest.
//   DRAWING_ANGLE        the direction of the motion as a part of the
//                        full turn, counted like TILT_DIRECTION (0 to the
//                        right, 0.125 right and down, 0.25 down, 0.5 to
//                        the left, 0.75 up), plus the sensor's
//                        angleOffset; the first direction of the stroke
//                        with lockAngle; 0 before any motion
//   ROTATION             the pen's own turn as a part of the full turn
//   DISTANCE, TIME, FADE pixels drawn, milliseconds, dabs so far over the
//                        sensor's length: 1 from the length on, or
//                        starting again from 0 when periodic
//   FUZZY_DAB            a random number for every asking
//   FUZZY_STROKE         a random number that stays for the stroke (each
//                        option and sensor has its own)
//   PERSPECTIVE          1 (State.perspective: there are no assistants)
//   TANGENTIAL_PRESSURE  State.tangential (0: the Point has none yet)
const std = @import("std")
const math = @import("std.math")
const random = @import("std.random")
const types = @import("./types.mlx")
const curve_module = @import("./curve.mlx")

pub const State = types.State
pub const Sensor = types.Sensor
pub const Option = types.Option
pub const Point = types.Point

// The low-pass's time constant, milliseconds.
pub const SPEED_TIME: f64 = 50.0
// The speed that reads as 1, pixels a millisecond.
pub const FULL_SPEED: f64 = 3.0

fn unit(value: f64) -> f64 {
    if value >= 1.0 { return 1.0 }
    if value > 0.0 { return value }
    return 0.0
}

// An angle in radians as a part of the full turn, 0 up to 1.
pub fn turnPart(radians: f64) -> f64 {
    if !(math.abs(radians) < 1000000000.0) { return 0.0 }
    const turns = radians / math.tau
    const part = turns - @floor(turns)
    // (A tiny negative angle rounds up to a whole turn: that is none.)
    return if part >= 1.0 { 0.0 } else { part }
}

// A stroke begins at `first`: at rest, nothing drawn, the random numbers
// those of `seed`.
pub fn start(state: *State, seed: u64, first: *const Point) -> void {
    random.seed(&state.*.random, seed)
    state.*.seed = seed
    state.*.point = first.*
    state.*.distance = 0.0
    state.*.time = 0.0
    state.*.dabs = 0
    state.*.startTime = first.*.time
    state.*.pressureIn = unit(first.*.pressure)
    state.*.direction = 0.0
    state.*.hasDirection = false
    state.*.firstDirection = 0.0
    state.*.speedBefore = 0.0
    state.*.segmentSpeed = 0.0
    state.*.segmentTime = 0.0
    state.*.segmentLength = 0.0
    state.*.travelled = 0.0
    state.*.along = 0.0
    state.*.tangential = 0.0
    state.*.perspective = 1.0
}

// The pen goes from `from` to `to`: the direction and the speed of this
// piece. (A piece without length keeps the direction; one without
// duration keeps the speed.)
pub fn segment(state: *State, from: *const Point, to: *const Point) -> void {
    const dx = to.*.x - from.*.x
    const dy = to.*.y - from.*.y
    const length = math.hypot(dx, dy)
    const duration = to.*.time - from.*.time
    state.*.segmentLength = if length == length { length } else { 0.0 }
    state.*.along = 0.0
    if length > 0.0 {
        state.*.direction = math.atan2(dy, dx)
        if !state.*.hasDirection {
            state.*.firstDirection = state.*.direction
            state.*.hasDirection = true
        }
    }
    if duration > 0.0 {
        state.*.segmentTime = duration
        state.*.segmentSpeed = state.*.segmentLength / duration
    } else {
        state.*.segmentTime = 0.0
        state.*.segmentSpeed = state.*.speedBefore
    }
}

// The smoothed speed at the dab being placed, pixels a millisecond.
pub fn speed(state: *const State) -> f64 {
    const elapsed = state.*.along * state.*.segmentTime
    if !(elapsed > 0.0) { return state.*.speedBefore }
    return state.*.speedBefore + (state.*.segmentSpeed - state.*.speedBefore) * (1.0 - math.exp(0.0 - elapsed / SPEED_TIME))
}

// The piece is done: what follows starts from its end.
pub fn finish(state: *State) -> void {
    state.*.along = 1.0
    state.*.speedBefore = speed(state)
    state.*.travelled += state.*.segmentLength
    state.*.segmentLength = 0.0
    state.*.segmentTime = 0.0
    state.*.along = 0.0
}

// The pen stays where it is for `duration` milliseconds: the speed dies
// down.
pub fn rest(state: *State, duration: f64) -> void {
    if duration > 0.0 { state.*.speedBefore *= math.exp(0.0 - duration / SPEED_TIME) }
}

// A dab is about to be placed at state.point (set by the caller), `along`
// (0..1) of the way through the piece, `gone` pixels from its start.
pub fn place(state: *State, along: f64, gone: f64) -> void {
    state.*.along = unit(along)
    state.*.distance = state.*.travelled + gone
    const elapsed = state.*.point.time - state.*.startTime
    state.*.time = if elapsed > 0.0 { elapsed } else { 0.0 }
    const pressure = unit(state.*.point.pressure)
    if pressure > state.*.pressureIn { state.*.pressureIn = pressure }
}

// The dab was placed.
pub fn placed(state: *State) -> void {
    state.*.dabs +%= 1
}

fn ramp(amount: f64, length: f64, periodic: bool) -> f64 {
    if !(length > 0.0) || !(amount > 0.0) { return 0.0 }
    const part = amount / length
    if !periodic { return unit(part) }
    return unit(part - @floor(part))
}

// A sensor's reading for the dab being placed, 0..1 (before its curve).
// `salt` tells the fuzzy-stroke numbers of different options and sensors
// apart.
pub fn value(sensor: *const Sensor, state: *State, salt: u64) -> f64 {
    const kind = sensor.*.kind
    if kind == types.SENSOR_PRESSURE { return unit(state.*.point.pressure) }
    if kind == types.SENSOR_PRESSURE_IN { return state.*.pressureIn }
    if kind == types.SENSOR_X_TILT { return 1.0 - unit(math.abs(state.*.point.tiltX)) }
    if kind == types.SENSOR_Y_TILT { return 1.0 - unit(math.abs(state.*.point.tiltY)) }
    if kind == types.SENSOR_TILT_DIRECTION {
        if state.*.point.tiltX == 0.0 && state.*.point.tiltY == 0.0 { return 0.0 }
        return turnPart(math.atan2(state.*.point.tiltY, state.*.point.tiltX))
    }
    if kind == types.SENSOR_TILT_ELEVATION { return 1.0 - unit(math.hypot(state.*.point.tiltX, state.*.point.tiltY)) }
    if kind == types.SENSOR_SPEED { return unit(speed(state) / FULL_SPEED) }
    if kind == types.SENSOR_DRAWING_ANGLE {
        var direction = if sensor.*.lockAngle { state.*.firstDirection } else { state.*.direction }
        if !state.*.hasDirection { direction = 0.0 }
        return turnPart(direction + sensor.*.angleOffset * math.pi / 180.0)
    }
    if kind == types.SENSOR_ROTATION { return turnPart(state.*.point.rotation) }
    if kind == types.SENSOR_DISTANCE { return ramp(state.*.distance, sensor.*.length, sensor.*.periodic) }
    if kind == types.SENSOR_TIME { return ramp(state.*.time, sensor.*.length, sensor.*.periodic) }
    if kind == types.SENSOR_FADE { return ramp(@floatFromInt(f64, state.*.dabs), sensor.*.length, sensor.*.periodic) }
    if kind == types.SENSOR_FUZZY_DAB { return random.unit(&state.*.random) }
    if kind == types.SENSOR_FUZZY_STROKE {
        var mixed = state.*.seed ^ ((salt +% 1) *% 0x9E3779B97F4A7C15)
        return @floatFromInt(f64, @intCast(i64, random.splitmix64(&mixed) >> 11)) / 9007199254740992.0
    }
    if kind == types.SENSOR_PERSPECTIVE { return unit(state.*.perspective) }
    if kind == types.SENSOR_TANGENTIAL_PRESSURE { return unit(state.*.tangential) }
    return 0.0
}

// The curves of an option's sensors as numbers: `into` gets
// types.SENSORS x 256 of them (sensor s at into[s * 256]).
pub fn bake(option: *const Option, into: [*]f32) -> void {
    var slot: usize = 0
    while slot < types.SENSORS {
        const table: *[256]f32 = unsafe { @ptrCast(*[256]f32, into + slot * 256) }
        curve_module.bake(&option.*.sensors[slot].curve, table)
        slot += 1
    }
}

// What an option is for the dab being placed, 0..1: each of its sensors
// read, put through its curve (`curves`: what bake() wrote for this
// option) and combined as the option says, times its strength. An option
// with no sensors is its strength; one that is off is 1 (callers that
// add something, like the rotation, look at `on` first). `salt`: a
// number of the option's own (its index).
pub fn evaluate(option: *const Option, curves: [*]const f32, state: *State, salt: u64) -> f64 {
    if !option.*.on { return 1.0 }
    var count = @intCast(usize, option.*.count)
    if count > types.SENSORS { count = types.SENSORS }
    if count == 0 { return unit(option.*.strength) }
    var result: f64 = 0.0
    var least: f64 = 1.0
    var most: f64 = 0.0
    var slot: usize = 0
    while slot < count {
        const reading = unit(value(&option.*.sensors[slot], state, salt * 4 + @intCast(u64, slot))) * 255.0
        const whole = @intFromFloat(usize, reading)
        const next = if whole < 255 { whole + 1 } else { 255 }
        const part = reading - @floatFromInt(f64, whole)
        const table = curves + slot * 256
        const curved = @floatCast(f64, table[whole]) * (1.0 - part) + @floatCast(f64, table[next]) * part
        if slot == 0 {
            result = curved
        } else if option.*.combine == types.COMBINE_ADD {
            result += curved
        } else if option.*.combine == types.COMBINE_MULTIPLY {
            result *= curved
        }
        if curved < least { least = curved }
        if curved > most { most = curved }
        slot += 1
    }
    if count > 1 {
        if option.*.combine == types.COMBINE_MAX { result = most }
        if option.*.combine == types.COMBINE_MIN { result = least }
        if option.*.combine == types.COMBINE_DIFFERENCE { result = most - least }
    }
    return unit(result * option.*.strength)
}
