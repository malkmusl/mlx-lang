const BUILT_IN_COUNT: usize = 41

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The table in heap memory (core/table.mlx: the constant table itself is
// never read at run time).
fn builtIns() -> []const BuiltIn {
    if kept.address != 0 { return table.rows(BuiltIn, &kept) }
    return table.keep(BuiltIn, &kept, BUILT_INS[0..])
}

// How many built-in presets there are.
pub fn builtInCount() -> usize { return BUILT_IN_COUNT }

// Built-in preset `index`'s text as it is written here ("" past the
// last).
pub fn builtInText(index: usize) -> []const u8 {
    const list = builtIns()
    if index >= list.length { return "" }
    return list[index].text
}

// What people call tag `which` (0: TAG_BASIC ... 7: TAG_MINE), in
// English or German ("" for a number that is none).
pub fn tagName(which: usize, german: bool) -> []const u8 {
    if which == 0 { return if german { "Grundlegend" } else { "Basic" } }
    if which == 1 { return if german { "Tusche" } else { "Ink" } }
    if which == 2 { return if german { "Malen" } else { "Paint" } }
    if which == 3 { return if german { "Skizze" } else { "Sketch" } }
    if which == 4 { return if german { "Textur" } else { "Texture" } }
    if which == 5 { return if german { "Radierer" } else { "Erasers" } }
    if which == 6 { return "Pixel" }
    if which == 7 { return if german { "Eigene" } else { "Mine" } }
    return ""
}

// ---------------------------------------------------------------------------
// The store

const Entry = struct {
    // Where its record and its thumbnail are (slotSettings, slotThumb).
    slot: u16
    tags: u8
    // The painter's own (a file), not built in.
    user: bool
    thumbReady: bool
    // The painter's: the file's name without EXTENSION.
    stem: [64]u8
    stemLength: usize
}

// What draws strokes for thumbnails and previews: an image (a stroke
// needs one), a device the stroke paints on, the stroke, a copy of the
// brush to draw with (a size held small), the stroke's target and its
// points.
const Drawer = struct {
    ready: bool
    failed: bool
    image: ?*image_module.Image
    device: ?*device_module.Device
    stroke: ?*types.Stroke
    work: ?*Settings
    target: types.Target
    point: point_module.Point
}

pub const Store = struct {
    allocator: Allocator
    ready: bool
    // The program's environment (std.xdg finds the folder in it).
    environment: [*][*]const u8
    entries: [256]Entry
    count: usize
    // Blocks of CHUNK records and thumbnails (0: not made yet), which
    // slots are taken.
    chunks: [17]usize
    taken: [272]bool
    // Thumbnails and previews drawn since the store was made.
    drawn: u64
    // Files of the folder that were no presets when they were read.
    unreadable: usize
    drawer: Drawer
    // The folder of the painter's presets (0 long: there is none) and a
    // file's path in it, NUL-terminated.
    folder: [4096]u8
    folderLength: usize
    path: [4096]u8
}

fn slotBytes() -> usize {
    return (@sizeOf(Settings) + 15) / 16 * 16 + THUMB_BYTES
}

fn slotSettings(store: *Store, slot: u16) -> *Settings {
    const chunk = store.*.chunks[@intCast(usize, slot) / CHUNK]
    return unsafe { @ptrFromInt(*Settings, chunk + (@intCast(usize, slot) % CHUNK) * slotBytes()) }
}

fn slotThumb(store: *Store, slot: u16) -> [*]u8 {
    const chunk = store.*.chunks[@intCast(usize, slot) / CHUNK]
    return unsafe { @ptrFromInt([*]u8, chunk + (@intCast(usize, slot) % CHUNK) * slotBytes() + (@sizeOf(Settings) + 15) / 16 * 16) }
}

// A free slot, its block made when it is the first of it (NO_SLOT: none
// left, or no memory).
fn takeSlot(store: *Store) -> u16 {
    var slot: usize = 0
    while slot < SLOTS {
        if !store.*.taken[slot] {
            const chunk = slot / CHUNK
            if store.*.chunks[chunk] == 0 {
                const memory = store.*.allocator.alloc(CHUNK * slotBytes(), 16)
                if memory == null { return NO_SLOT }
                store.*.chunks[chunk] = @intFromPtr(memory.?)
            }
            store.*.taken[slot] = true
            return @intCast(u16, slot)
        }
        slot += 1
    }
    return NO_SLOT
}

fn copySettings(into: *Settings, from: *const Settings) -> void {
    // (Byte by byte: assigning a record of this size goes through the
    // value arena.)
    unsafe { std.mem.copy(@ptrCast([*]u8, into), @ptrCast([*]const u8, from), @sizeOf(Settings)) }
}

// Lower-case ASCII (the rest as it is): names are compared so.
inline fn folded(byte: u8) -> u8 {
    return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

fn sameFolded(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if folded(left[index]) != folded(right[index]) { return false }
        index += 1
    }
    return true
}

// Whether `left` comes before `right` (lower-cased ASCII, then bytes).
fn before(left: []const u8, right: []const u8) -> bool {
    var index: usize = 0
    while index < left.length && index < right.length {
        const a = folded(left[index])
        const b = folded(right[index])
        if a != b { return a < b }
        index += 1
    }
    return left.length < right.length
}

// How many of `length` bytes at `bytes` are kept when `most` may be:
// all of them, or cut where a character of UTF-8 begins (its later bytes
// are 10xxxxxx).
fn cutAt(bytes: [*]const u8, length: usize, most: usize) -> usize {
    if length <= most { return length }
    var end = most
    while end > 0 && bytes[end] & 0xC0 == 0x80 { end -= 1 }
    return end
}

fn containsFolded(text: []const u8, part: []const u8) -> bool {
    if part.length == 0 { return true }
    if part.length > text.length { return false }
    var start: usize = 0
    while start + part.length <= text.length {
        var index: usize = 0
        while index < part.length && folded(text[start + index]) == folded(part[index]) { index += 1 }
        if index == part.length { return true }
        start += 1
    }
    return false
}

// Puts entry `entry` at `at`, those from there on one place on.
fn insertEntry(store: *Store, at: usize, entry: *const Entry) -> void {
    var index = store.*.count
    while index > at {
        store.*.entries[index] = store.*.entries[index - 1]
        index -= 1
    }
    store.*.entries[at] = entry.*
    store.*.count += 1
}

fn removeEntry(store: *Store, at: usize) -> void {
    store.*.taken[@intCast(usize, store.*.entries[at].slot)] = false
    var index = at
    while index + 1 < store.*.count {
        store.*.entries[index] = store.*.entries[index + 1]
        index += 1
    }
    store.*.count -= 1
}

// Where a painter's preset named `name` goes among theirs (sorted by
// name, after the built-in ones).
fn userPlace(store: *Store, name_text: []const u8) -> usize {
    var at: usize = 0
    while at < store.*.count && !store.*.entries[at].user { at += 1 }
    while at < store.*.count && before(nameOf(store, at), name_text) { at += 1 }
    return at
}

fn nameOf(store: *Store, index: usize) -> []const u8 {
    return types.nameOf(slotSettings(store, store.*.entries[index].slot))
}

// Makes `store` (zeroed memory, or one ended with deinit) the store of
// the built-in presets and those in the painter's folder, which
// `environment` (NUL-terminated entries) names. False when there was no
// memory for the built-in ones.
pub fn init(store: *Store, allocator: Allocator, environment: [*][*]const u8) -> bool {
    store.*.allocator = allocator
    store.*.environment = environment
    store.*.count = 0
    store.*.drawn = 0
    store.*.unreadable = 0
    store.*.drawer.ready = false
    store.*.drawer.failed = false
    var index: usize = 0
    while index < CHUNKS {
        store.*.chunks[index] = 0
        index += 1
    }
    index = 0
    while index < SLOTS {
        store.*.taken[index] = false
        index += 1
    }
    store.*.folderLength = xdg.path(environment, xdg.DATA, FOLDER, &store.*.folder, std.fs.PATH_MAX)
    const list = builtIns()
    index = 0
    while index < list.length {
        if list[index].unless != 0 && engines.find(list[index].unless) != null {
            index += 1
            continue
        }
        const slot = takeSlot(store)
        if slot == NO_SLOT {
            deinit(store)
            return false
        }
        // (A preset of an engine that is not there is left out; the
        // tests see that no other text fails.)
        if types.parse(list[index].text, slotSettings(store, slot)) {
            var entry: Entry = undefined
            entry.slot = slot
            entry.tags = list[index].tags
            entry.user = false
            entry.thumbReady = false
            entry.stemLength = 0
            insertEntry(store, store.*.count, &entry)
        } else {
            store.*.taken[@intCast(usize, slot)] = false
        }
        index += 1
    }
    loadFolder(store)
    store.*.ready = true
    return true
}

// Gives back what the store took (its records, thumbnails, what draws
// them); it holds nothing then.
pub fn deinit(store: *Store) -> void {
    const allocator = store.*.allocator
    var index: usize = 0
    while index < CHUNKS {
        if store.*.chunks[index] != 0 {
            unsafe { allocator.free(@ptrFromInt([*]u8, store.*.chunks[index]), CHUNK * slotBytes(), 16) }
            store.*.chunks[index] = 0
        }
        index += 1
    }
    dropDrawer(store)
    store.*.count = 0
    store.*.ready = false
}

// How many presets there are.
pub fn count(store: *Store) -> usize { return store.*.count }

// Preset `index`'s brush (null past the last). It stays where it is
// until the store changes (save, remove, rename).
pub fn settingsOf(store: *Store, index: usize) -> ?*const Settings {
    if index >= store.*.count { return null }
    return slotSettings(store, store.*.entries[index].slot)
}

// Preset `index`'s name ("" past the last).
pub fn name(store: *Store, index: usize) -> []const u8 {
    if index >= store.*.count { return "" }
    return nameOf(store, index)
}

// Its tags (TAG_* bits; 0 past the last).
pub fn tags(store: *Store, index: usize) -> u8 {
    if index >= store.*.count { return 0 }
    return store.*.entries[index].tags
}

// Whether it is the painter's own (it can be renamed and deleted).
pub fn isUser(store: *Store, index: usize) -> bool {
    return index < store.*.count && store.*.entries[index].user
}

// The preset named `wanted` (capitals and small letters alike; null:
// none is).
pub fn find(store: *Store, wanted: []const u8) -> ?usize {
    var index: usize = 0
    while index < store.*.count {
        if sameFolded(nameOf(store, index), wanted) { return index }
        index += 1
    }
    return null
}

// Whether a preset other than `except` is called `wanted` (capitals and
// small letters alike).
fn namedElsewhere(store: *Store, wanted: []const u8, except: usize) -> bool {
    var index: usize = 0
    while index < store.*.count {
        if index != except && sameFolded(nameOf(store, index), wanted) { return true }
        index += 1
    }
    return false
}

// Whether preset `index` has any of the tags `tag_bits` (0: whatever it
// has) and its name contains `search` (capitals and small letters alike;
// "": any name).
pub fn matches(store: *Store, index: usize, tag_bits: u8, search: []const u8) -> bool {
    if index >= store.*.count { return false }
    if tag_bits != 0 && store.*.entries[index].tags & tag_bits == 0 { return false }
    return containsFolded(nameOf(store, index), std.text.trimmed(search))
}

// How many thumbnails and previews were drawn since the store was made.
pub fn drawnCount(store: *Store) -> u64 { return store.*.drawn }

// How many files of the painter's folder could not be read as presets.
pub fn unreadableCount(store: *Store) -> usize { return store.*.unreadable }

// ---------------------------------------------------------------------------
// The painter's files

// The folder of the painter's presets (empty: the environment names
// none).
pub fn folder(store: *Store) -> []const u8 {
    const bytes: [*]const u8 = &store.*.folder
    return bytes[0..store.*.folderLength]
}

// The path of the file `stem` + EXTENSION in the folder into
// store.path, NUL-terminated (false: no folder, or too long).
fn pathOf(store: *Store, stem: []const u8) -> bool {
    if store.*.folderLength == 0 || store.*.folderLength + 1 + stem.length + EXTENSION.length + 1 > std.fs.PATH_MAX { return false }
    const bytes: [*]u8 = &store.*.path
    var length = std.text.append(bytes, 0, std.fs.PATH_MAX, folder(store))
    length = std.text.appendByte(bytes, length, std.fs.PATH_MAX, 47)
    length = std.text.append(bytes, length, std.fs.PATH_MAX, stem)
    length = std.text.append(bytes, length, std.fs.PATH_MAX, EXTENSION)
    bytes[length] = 0
    return true
}

fn stemOf(entry: *const Entry) -> []const u8 {
    const bytes: [*]const u8 = &entry.*.stem
    return bytes[0..entry.*.stemLength]
}

// The path of preset `index`'s file, NUL-terminated, into `into` (room
// for `capacity` bytes); its length, 0 for a built-in preset or when it
// does not fit.
pub fn fileOf(store: *Store, index: usize, into: [*]u8, capacity: usize) -> usize {
    if !isUser(store, index) || !pathOf(store, stemOf(&store.*.entries[index])) { return 0 }
    const bytes: [*]const u8 = &store.*.path
    const text = std.text.cString(bytes)
    if text.length + 1 > capacity { return 0 }
    const length = std.text.append(into, 0, capacity, text)
    into[length] = 0
    return length
}

// Reads every NAME.nbrush of the folder (a file that is no preset is
// counted and passed over).
fn loadFolder(store: *Store) -> void {
    if store.*.folderLength == 0 || store.*.folderLength + 1 > std.fs.PATH_MAX { return }
    store.*.folder[store.*.folderLength] = 0
    const directory = std.fs.open(&store.*.folder, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(directory) { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const listing = scratch.bytes(pool, 8192)
    const contents = scratch.bytes(pool, FILE_LARGEST)
    if listing != null && contents != null {
        var reader = std.fs.entries(directory, listing.?, 8192)
        var entry: std.fs.Entry = undefined
        while std.fs.nextEntry(&reader, &entry) {
            const file_name = std.string.asSlice(entry.name)
            if std.fs.isDotName(entry.name) || !std.text.endsWith(file_name, EXTENSION) { continue }
            const stem = file_name[0..file_name.length - EXTENSION.length]
            if stem.length == 0 || stem.length > types.NAME { continue }
            loadFile(store, stem, contents.?)
        }
    }
    scratch.release(pool, mark)
    _ = std.fs.close(directory)
}

fn loadFile(store: *Store, stem: []const u8, contents: [*]u8) -> void {
    if store.*.count >= MOST || !pathOf(store, stem) { return }
    const read = std.fs.readFileResult(&store.*.path, contents, FILE_LARGEST)
    if read <= 0 || @intCast(usize, read) >= FILE_LARGEST {
        store.*.unreadable += 1
        return
    }
    const slot = takeSlot(store)
    if slot == NO_SLOT { return }
    const settings = slotSettings(store, slot)
    if !types.parse(contents[0..@intCast(usize, read)], settings) {
        store.*.taken[@intCast(usize, slot)] = false
        store.*.unreadable += 1
        return
    }
    // (A file without a name is called by its own: parse gives it the
    // defaults' otherwise. One called as a preset there already gets a
    // number.)
    if settings.*.nameLength == 0 || !namedIn(contents[0..@intCast(usize, read)]) { types.setName(settings, stem) }
    if !freeName(store, settings, false) {
        store.*.taken[@intCast(usize, slot)] = false
        store.*.unreadable += 1
        return
    }
    var entry: Entry = undefined
    entry.slot = slot
    entry.tags = TAG_MINE
    entry.user = true
    entry.thumbReady = false
    entry.stemLength = std.text.append(&entry.stem, 0, types.NAME, stem)
    insertEntry(store, userPlace(store, types.nameOf(settings)), &entry)
}

// Whether a preset file's text has a line that names the preset
// ("name = ...", as types.write writes it).
fn namedIn(text: []const u8) -> bool {
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[start..end])
        start = end + 1
        var split: usize = 0
        while split < line.length && line[split] != 61 { split += 1 }
        if split < line.length && std.text.same(std.text.trimmed(line[0..split]), "name") { return true }
    }
    return false
}

// A file's name for preset name `text`: what a file name cannot hold (a
// slash, control characters, a dot at the start) becomes "_".
fn stemFor(text: []const u8, into: [*]u8) -> usize {
    var length: usize = 0
    while length < text.length && length < types.NAME {
        const byte = text[length]
        const bad = byte < 32 || byte == 47 || byte == 92 || byte == 127 || (length == 0 && byte == 46)
        into[length] = if bad { 95 } else { byte }
        length += 1
    }
    return length
}

// Whether the file `stem` + EXTENSION is in the folder.
fn fileThere(store: *Store, stem: []const u8) -> bool {
    return pathOf(store, stem) && std.fs.exists(&store.*.path)
}

// Whether the file `stem` is not free for preset `except` (MOST: for a
// new one): a painter's preset other than it has it, or a file of that
// name that is not its own is in the folder (one that is no preset of
// the store: it is never written over).
fn stemTaken(store: *Store, stem: []const u8, except: usize) -> bool {
    var index: usize = 0
    while index < store.*.count {
        if index != except && store.*.entries[index].user && sameFolded(stemOf(&store.*.entries[index]), stem) { return true }
        index += 1
    }
    const own = except < store.*.count && store.*.entries[except].user && sameFolded(stemOf(&store.*.entries[except]), stem)
    return !own && fileThere(store, stem)
}

// The entry's stem made unlike every other preset's file and every file
// of the folder that is not its own ("-2", "-3", ... added, the stem cut
// so that the number fits). False when no number up to 999 is free.
fn uniqueStem(store: *Store, entry: *Entry, except: usize) -> bool {
    if !stemTaken(store, stemOf(entry), except) { return true }
    const base = cutAt(&entry.*.stem, entry.*.stemLength, types.NAME - 4)
    var number: usize = 2
    while number < 1000 {
        var length = base
        length = std.text.appendByte(&entry.*.stem, length, types.NAME, 45)
        length = std.text.appendUnsigned(&entry.*.stem, length, types.NAME, number)
        entry.*.stemLength = length
        if !stemTaken(store, stemOf(entry), except) { return true }
        number += 1
    }
    return false
}

// Writes `settings` as the file `stem` (the folder made when it is not
// there). False when it could not be written.
fn writeFile(store: *Store, stem: []const u8, settings: *const Settings) -> bool {
    if !pathOf(store, stem) || !std.fs.makeDirectories(folder(store), 493) { return false }
    var text = std.ArrayList(u8).init(store.*.allocator)
    defer text.deinit()
    if !types.write(settings, &text) { return false }
    return std.fs.replaceFile(&store.*.path, text.items().pointer, text.count(), 420)
}

// Deletes the file `stem` (true when it is not there afterwards).
fn deleteFile(store: *Store, stem: []const u8) -> bool {
    if !pathOf(store, stem) { return false }
    if std.fs.delete(&store.*.path) { return true }
    return !std.fs.exists(&store.*.path)
}

// Whether a preset is called `wanted` (capitals and small letters alike);
// with `painters_free` a painter's preset of that name does not count (it
// is to be replaced).
fn nameTaken(store: *Store, wanted: []const u8, painters_free: bool) -> bool {
    const found = find(store, wanted)
    return found != null && !(painters_free && store.*.entries[found.?].user)
}

// Gives `settings` (not one of the store's presets yet) a name no preset
// has (see nameTaken): its own, or with " 2", " 3", ... added, the name
// cut so that the number fits. False when it has no name, or no number
// up to 999 is free (its name is as it was then).
fn freeName(store: *Store, settings: *Settings, painters_free: bool) -> bool {
    if settings.*.nameLength == 0 { return false }
    if !nameTaken(store, types.nameOf(settings), painters_free) { return true }
    var base: [64]u8 = undefined
    const whole = settings.*.nameLength
    var index: usize = 0
    while index < whole {
        base[index] = settings.*.name[index]
        index += 1
    }
    var kept_length = cutAt(&settings.*.name, whole, types.NAME - 4)
    while kept_length > 0 && base[kept_length - 1] == 32 { kept_length -= 1 }
    var number: usize = 2
    while number < 1000 {
        var length = std.text.appendByte(&settings.*.name, kept_length, types.NAME, 32)
        length = std.text.appendUnsigned(&settings.*.name, length, types.NAME, number)
        settings.*.nameLength = length
        if !nameTaken(store, types.nameOf(settings), painters_free) { return true }
        number += 1
    }
    restoreName(settings, &base, whole)
    return false
}

// The name a preset saved as `wanted` gets, into `into`: `wanted` as a
// preset's name keeps it (one line, NAME bytes at most); when a built-in
// preset is called so, a number is added (" 2", " 3", ...). Its length,
// 0 when nothing is left of `wanted` or no number is free.
fn savedName(store: *Store, wanted: []const u8, into: *Settings) -> usize {
    types.setName(into, wanted)
    if !freeName(store, into, true) { return 0 }
    return into.*.nameLength
}

// Saves `settings` as a preset of the painter's called `wanted`: a file
// in the folder, and a preset of the store (in its place by name). A
// preset of theirs of that name is replaced (also when the store holds
// MOST); when a built-in one is called so, the new one's name gets a
// number. A file of the folder that is no preset of the store is not
// written over: the new file's name gets a number then ("NAME-2").
// Its index, or null when there is no name, no folder, no room for a
// new one or the file could not be written (the store is as it was
// then).
pub fn save(store: *Store, settings: *const Settings, wanted: []const u8) -> ?usize {
    var result: ?usize = null
    if !store.*.ready { return result }
    const slot = takeSlot(store)
    if slot == NO_SLOT { return result }
    const made = slotSettings(store, slot)
    copySettings(made, settings)
    types.sanitize(made)
    if savedName(store, wanted, made) == 0 {
        store.*.taken[@intCast(usize, slot)] = false
        return result
    }
    const replaced = find(store, types.nameOf(made))
    if replaced == null && store.*.count >= MOST {
        store.*.taken[@intCast(usize, slot)] = false
        return result
    }
    var entry: Entry = undefined
    entry.slot = slot
    entry.tags = TAG_MINE
    entry.user = true
    entry.thumbReady = false
    var stem_free = true
    if replaced != null {
        entry.stemLength = std.text.append(&entry.stem, 0, types.NAME, stemOf(&store.*.entries[replaced.?]))
    } else {
        entry.stemLength = stemFor(types.nameOf(made), &entry.stem)
        stem_free = uniqueStem(store, &entry, MOST)
    }
    if !stem_free || !writeFile(store, stemOf(&entry), made) {
        store.*.taken[@intCast(usize, slot)] = false
        return result
    }
    if replaced != null { removeEntry(store, replaced.?) }
    const at = userPlace(store, types.nameOf(made))
    insertEntry(store, at, &entry)
    result = at
    return result
}

// Deletes the painter's preset `index` and its file. False for a
// built-in one, or when the file could not be deleted.
pub fn remove(store: *Store, index: usize) -> bool {
    if !isUser(store, index) { return false }
    if !deleteFile(store, stemOf(&store.*.entries[index])) { return false }
    removeEntry(store, index)
    return true
}

// Renames the painter's preset `index` to `wanted` (its file too: it is
// written under the new name, never over another file, and the old one
// deleted). Its index then (the list is sorted by name), or null for a
// built-in one, a name that is empty or another preset's, or when the
// file could not be written.
pub fn rename(store: *Store, index: usize, wanted: []const u8) -> ?usize {
    var result: ?usize = null
    if !isUser(store, index) { return result }
    const old = store.*.entries[index]
    const settings = slotSettings(store, old.slot)
    // The record is renamed in place and back again when that fails.
    var previous: [64]u8 = undefined
    const previous_length = settings.*.nameLength
    var at: usize = 0
    while at < previous_length {
        previous[at] = settings.*.name[at]
        at += 1
    }
    types.setName(settings, wanted)
    if settings.*.nameLength == 0 || namedElsewhere(store, types.nameOf(settings), index) {
        restoreName(settings, &previous, previous_length)
        return result
    }
    var entry = old
    entry.stemLength = stemFor(types.nameOf(settings), &entry.stem)
    // A name that differs in capitals only keeps its file (on a file
    // system that does not tell capitals apart the old file would be the
    // new one).
    if sameFolded(stemOf(&entry), stemOf(&old)) { entry = old }
    if !uniqueStem(store, &entry, index) || !writeFile(store, stemOf(&entry), settings) {
        restoreName(settings, &previous, previous_length)
        return result
    }
    if !std.text.same(stemOf(&entry), stemOf(&old)) { _ = deleteFile(store, stemOf(&old)) }
    // Out of the list and in again at its place by the new name (the slot
    // is the same: taken again).
    removeEntry(store, index)
    store.*.taken[@intCast(usize, entry.slot)] = true
    const place = userPlace(store, types.nameOf(settings))
    insertEntry(store, place, &entry)
    result = place
    return result
}

fn restoreName(settings: *Settings, previous: *const [64]u8, length: usize) -> void {
    var at: usize = 0
    while at < length {
        settings.*.name[at] = previous.*[at]
        at += 1
    }
    settings.*.nameLength = length
}

// ---------------------------------------------------------------------------
// Drawing strokes: thumbnails and previews

fn dropDrawer(store: *Store) -> void {
    const drawer = &store.*.drawer
    if drawer.*.stroke != null { stroke_module.destroy(drawer.*.stroke.?) }
    if drawer.*.device != null { device_module.destroy(drawer.*.device.?) }
    if drawer.*.image != null { image_module.destroy(drawer.*.image.?) }
    if drawer.*.work != null { unsafe { store.*.allocator.free(@ptrCast([*]u8, drawer.*.work.?), @sizeOf(Settings), 16) } }
    drawer.*.stroke = null
    drawer.*.device = null
    drawer.*.image = null
    drawer.*.work = null
    drawer.*.ready = false
}

fn drawerReady(store: *Store) -> bool {
    const drawer = &store.*.drawer
    if drawer.*.ready { return true }
    if drawer.*.failed { return false }
    const allocator = store.*.allocator
    drawer.*.image = image_module.create(allocator, DRAW_WIDTH, DRAW_HEIGHT, 72.0)
    drawer.*.device = device_module.create(allocator, 0)
    drawer.*.stroke = stroke_module.create(allocator)
    drawer.*.work = null
    const memory = allocator.alloc(@sizeOf(Settings), 16)
    if memory != null { drawer.*.work = unsafe { @ptrCast(*Settings, memory.?) } }
    if drawer.*.image == null || drawer.*.device == null || drawer.*.stroke == null || drawer.*.work == null {
        dropDrawer(store)
        // (Not tried again at every frame.)
        drawer.*.failed = true
        return false
    }
    drawer.*.ready = true
    return true
}

fn isEraser(settings: *const Settings) -> bool {
    return settings.*.eraser || settings.*.engine == types.ENGINE_ERASER
}

// Whether the brush paints only with what is on the layer already (it
// smudges, clones, filters, deforms): on an empty device it would draw
// nothing.
fn needsPaint(settings: *const Settings) -> bool {
    const engine = engines.find(settings.*.engine)
    return engine != null && engine.?.*.flags & (types.ENGINE_READS_SAMPLE | types.ENGINE_DIRECT) != 0
}

// Draws the wave with `settings` (its size held to `largest`) in `color`
// onto the drawer's device, in the rectangle 0, 0, width, height. An
// eraser draws the shape it takes away. False when nothing can be drawn.
fn drawShape(store: *Store, settings: *const Settings, width: f64, height: f64, largest: f64, color: u32) -> bool {
    if !drawerReady(store) { return false }
    const drawer = &store.*.drawer
    const work = drawer.*.work.?
    copySettings(work, settings)
    types.sanitize(work)
    if isEraser(work) || needsPaint(work) {
        // The shape it takes away or works in, painted once, however
        // often it crosses itself.
        work.*.eraser = false
        work.*.engine = types.ENGINE_PAINTBRUSH
        work.*.paintMode = types.MODE_WASH
    }
    if work.*.size > largest { work.*.size = largest }
    const device = drawer.*.device.?
    device_module.clear(device)
    const image = drawer.*.image.?
    drawer.*.target = types.Target.{ .image = image, .node = image.*.root, .device = device, .direct = !stroke_module.paintsIndirectly(work), .foreground = color, .background = 0xFFFFFFFF, .selection = null, .alphaLock = false, .mirrorHorizontal = false, .axisX = 0.0, .mirrorVertical = false, .axisY = 0.0, .wrap = false, .seed = 20241, .sample = null }
    // A wave lying across the rectangle (an S on its side), thin at both
    // ends as a pen pressed and lifted draws it.
    const margin = work.*.size / 2.0 + 3.0
    var swing = (height / 2.0 - work.*.size / 2.0 - 4.0) * 0.7
    if swing < 2.0 { swing = 2.0 }
    const stroke = drawer.*.stroke.?
    var index: usize = 0
    while index <= PATH_POINTS {
        const t = @floatFromInt(f64, index) / @floatFromInt(f64, PATH_POINTS)
        // (The pressure rises and falls softly: sin^1.5 starts flat.)
        const wave = math.sin(math.pi * t)
        const rise = if wave > 0.0 { wave } else { 0.0 }
        drawer.*.point = point_module.at(margin + (width - 2.0 * margin) * t, height / 2.0 - swing * math.sin(math.tau * t), 0.1 + 0.9 * rise * @sqrt(rise), 400.0 * t)
        if index == 0 {
            _ = stroke_module.begin(stroke, &drawer.*.target, work, &drawer.*.point)
        } else {
            _ = stroke_module.to(stroke, &drawer.*.point)
        }
        index += 1
    }
    _ = stroke_module.end(stroke)
    store.*.drawn += 1
    return true
}

// Preset `index`'s thumbnail: THUMB_HEIGHT rows of THUMB_WIDTH bytes of
// coverage (0 nothing, 255 all), its wave drawn the first time it is
// asked for (an eraser's: a faint band with the wave taken out of it). Null past
// the last, or without memory to draw.
pub fn thumbnail(store: *Store, index: usize) -> ?[*]const u8 {
    if index >= store.*.count { return null }
    const entry = &store.*.entries[index]
    const thumb = slotThumb(store, entry.*.slot)
    if entry.*.thumbReady { return thumb }
    const settings = slotSettings(store, entry.*.slot)
    const largest = if settings.*.tip.kind == types.TIP_PREDEFINED { THUMB_TEXTURE_SIZE } else { THUMB_SIZE }
    if !drawShape(store, settings, @floatFromInt(f64, THUMB_WIDTH), @floatFromInt(f64, THUMB_HEIGHT), largest, 0xFF000000) { return null }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const words = scratch.words(pool, THUMB_WIDTH * THUMB_HEIGHT)
    if words == null {
        scratch.release(pool, mark)
        return null
    }
    device_module.readRect(store.*.drawer.device.?, geom.rect(0, 0, @intCast(i32, THUMB_WIDTH), @intCast(i32, THUMB_HEIGHT)), words.?, THUMB_WIDTH)
    const eraser = isEraser(settings)
    var at: usize = 0
    while at < THUMB_WIDTH * THUMB_HEIGHT {
        const alpha = words.?[at] >> 24
        if eraser {
            const row = at / THUMB_WIDTH
            const band = row >= 6 && row < THUMB_HEIGHT - 6
            thumb[at] = if band { @intCast(u8, (ERASER_GROUND * (255 - alpha) + 127) / 255) } else { 0 }
        } else {
            thumb[at] = @intCast(u8, alpha)
        }
        at += 1
    }
    scratch.release(pool, mark)
    device_module.clear(store.*.drawer.device.?)
    entry.*.thumbReady = true
    return thumb
}

// The wave drawn with `settings` in `color` (straight 0xAARRGGBB), its
// size held to `largest`, into `into`: `height` rows of `width` straight
// pixels, `stride` apart (transparent where it did not paint; an eraser:
// a band of `color` with the wave taken out). The brush editor's preview.
// False without memory (`into` is not touched then).
pub fn preview(store: *Store, settings: *const Settings, color: u32, largest: f64, into: [*]u32, width: usize, height: usize, stride: usize) -> bool {
    if width == 0 || height == 0 || width > @intCast(usize, DRAW_WIDTH) || height > @intCast(usize, DRAW_HEIGHT) { return false }
    if !drawShape(store, settings, @floatFromInt(f64, width), @floatFromInt(f64, height), largest, color | 0xFF000000) { return false }
    device_module.readRect(store.*.drawer.device.?, geom.rect(0, 0, @intCast(i32, width), @intCast(i32, height)), into, stride)
    if isEraser(settings) {
        const ground = color & 0xFFFFFF
        const top = height / 6
        var row: usize = 0
        while row < height {
            var column: usize = 0
            while column < width {
                const at = row * stride + column
                const taken = into[at] >> 24
                into[at] = if row >= top && row < height - top { (((255 - taken) & 255) << 24) | ground } else { 0 }
                column += 1
            }
            row += 1
        }
    }
    device_module.clear(store.*.drawer.device.?)
    return true
}
