// nebula brush: brush presets: the brushes a painter picks from a list.
// A preset is a brush.Settings with a name (brush/types.mlx); the program
// comes with a set of them, written below as preset files' text (a round
// brush hard and soft, an airbrush, pens, a marker, pencils, charcoal,
// chalk, brushes with the built-in tips of brush/tip.mlx, scatter brushes,
// a spray, a smudge brush and a blender, erasers, pixel brushes), and a
// painter adds their own: the brush in use
// saved under a name, kept as a file of the same text,
//
//     $XDG_DATA_HOME/mlx/nebula/brushes/NAME.nbrush
//
// (std.xdg finds the folder from the environment, the same on brixOS and
// on Linux), read in when the store is made. Presets of their own can be
// renamed and deleted; the built-in ones cannot.
//
// A Store (heap memory of the caller's: the App keeps one) holds them
// all, the built-in ones first in their order, then the painter's sorted
// by name. No two have the same name (capitals and small letters alike):
// a file whose preset is called as one there already is called with a
// number added (" 2"), and a file of the folder that is no preset of the
// store (one that could not be read: of an engine this program lacks) is
// never written over. Each has tags (TAG_*: Basic, Ink, Paint, Sketch, Texture,
// Erasers, Pixel; the painter's own are TAG_MINE), by which and by a part
// of its name a list is narrowed (matches), and a thumbnail: a short
// wave (an S on its side) drawn with the preset by brush/stroke.mlx, made
// the first time it is asked for and kept (its coverage, THUMB_WIDTH x
// THUMB_HEIGHT bytes).
//
//     presets.init(store, allocator, environment)
//     var index: usize = 0
//     while index < presets.count(store) {
//         if presets.matches(store, index, presets.TAG_INK, "pen") { ... presets.name(store, index) ... }
//         index += 1
//     }
//     brushes.use(app, presets.settingsOf(store, index).?)
//     const saved = presets.save(store, brushes.current(app), "My pen")   // its index, or null
//
// The records and thumbnails live in blocks of CHUNK presets each (a
// Settings is about 20 KiB: one block each would be a memory region each
// on brixOS); the store holds MOST presets at most (and has room for one
// more record, so that one of MOST can still be replaced).
//
// Presets of an engine that is not in the program (brush/engines.mlx)
// are left out: the smudge brush and the blender need the colour smudge
// engine; without the spray engine the spray is a round brush whose
// small dabs are scattered.
//
// Not done: tags a painter gives (their presets are tagged "mine"), and
// the look of a brush that paints only with the paint under it (it
// smudges, clones, deforms): its thumbnail shows the shape it works in.
const std = @import("std")
const math = @import("std.math")
const xdg = @import("std.xdg")
const types = @import("./types.mlx")
const stroke_module = @import("./stroke.mlx")
const engines = @import("./engines.mlx")
const point_module = @import("./point.mlx")
const geom = @import("../core/geom.mlx")
const device_module = @import("../core/device.mlx")
const image_module = @import("../core/image.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")

pub const Allocator = std.allocator.Allocator
pub const Settings = types.Settings

// Tags, as bits of a preset's tags.
pub const TAG_BASIC: u8 = 1
pub const TAG_INK: u8 = 2
pub const TAG_PAINT: u8 = 4
pub const TAG_SKETCH: u8 = 8
pub const TAG_TEXTURE: u8 = 16
pub const TAG_ERASERS: u8 = 32
pub const TAG_PIXEL: u8 = 64
// The painter's own presets.
pub const TAG_MINE: u8 = 128
pub const TAGS: usize = 8

// How many presets a store holds at most.
pub const MOST: usize = 256
// A thumbnail's size in pixels (a byte of coverage each, row by row).
pub const THUMB_WIDTH: usize = 64
pub const THUMB_HEIGHT: usize = 40
// The largest diameter a thumbnail's stroke is drawn with (larger
// brushes are drawn this large: the wave must fit).
pub const THUMB_SIZE: f64 = 10.0
// The same for a brush whose tip is a built-in picture (its grain shows
// only when it is a little larger).
pub const THUMB_TEXTURE_SIZE: f64 = 16.0
// What a preset's file is called after its name.
pub const EXTENSION: []const u8 = ".nbrush"

const THUMB_BYTES: usize = 2560
const CHUNK: usize = 16
// Records for MOST presets and one block more (a preset replaced is
// written into a record of its own before the old one goes).
const CHUNKS: usize = 17
const SLOTS: usize = 272
const FOLDER: []const u8 = "/mlx/nebula/brushes"
// A file larger than this is no preset (the largest written is about
// 20 KiB).
const FILE_LARGEST: usize = 262144
// The image a stroke is drawn on is this large (only the part a
// thumbnail or the editor's preview takes is read).
const DRAW_WIDTH: i32 = 1024
const DRAW_HEIGHT: i32 = 256
// Points along the wave.
const PATH_POINTS: usize = 48
// What a thumbnail of an eraser shows around the stroke it takes away.
const ERASER_GROUND: u32 = 72

const NO_SLOT: u16 = 65535

// ---------------------------------------------------------------------------
// The built-in presets: preset files' text (brush/types.mlx parse), each
// with what differs from types.defaults() (a round hard brush of 40
// pixels, its size by the pressure, wash).

const BuiltIn = struct {
    text: []const u8
    tags: u8
    // Left out when there is an engine of this number (0: never): the
    // stand-in for a preset of an engine that is not there. (A preset of
    // an engine that is not there does not parse and is left out too.)
    unless: u16
}

