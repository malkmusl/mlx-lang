// nebula brush: the list of brush engines: the ways a brush can paint.
// A preset names its engine by key ("paintbrush"), Settings.engine holds
// the engine's number (types.ENGINE_...), and the stroke
// (brush/stroke.mlx) asks here for the record of functions that paints.
//
// An engine module (brush/pixel_engine.mlx is the model) has a table of
// types.Engine and hands it out with
//
//     pub fn list() -> []const types.Engine { return ENGINES[0..] }
//
// A new engine module is imported here, counted in MODULES and given its
// line in listOf(): nothing else knows the engines one by one.
const std = @import("std")
const types = @import("./types.mlx")
const pixel_engine = @import("./pixel_engine.mlx")

pub const Engine = types.Engine

const MODULES: usize = 1

fn listOf(module: usize) -> []const Engine {
    _ = module
    return pixel_engine.list()
}

// How many engines there are, and the one at a place in the list (in the
// modules' order; null past the last).
pub fn count() -> usize {
    var total: usize = 0
    var module: usize = 0
    while module < MODULES {
        total += listOf(module).length
        module += 1
    }
    return total
}

pub fn at(index: usize) -> ?*const Engine {
    var left = index
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        if left < list.length { return &list[left] }
        left -= list.length
        module += 1
    }
    return null
}

// The engine numbered `id` (null: there is none).
pub fn find(id: u16) -> ?*const Engine {
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        var index: usize = 0
        while index < list.length {
            if list[index].id == id { return &list[index] }
            index += 1
        }
        module += 1
    }
    return null
}

// The engine a preset file names `key` (null: not known).
pub fn byKey(key: []const u8) -> ?*const Engine {
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        var index: usize = 0
        while index < list.length {
            if std.text.same(list[index].key, key) { return &list[index] }
            index += 1
        }
        module += 1
    }
    return null
}

// What people call engine `id` ("" for a number that is none).
pub fn name(id: u16, german: bool) -> []const u8 {
    const engine = find(id)
    if engine == null { return "" }
    return if german { engine.?.*.german } else { engine.?.*.name }
}
