// nebula brush: the list of brush engines: the ways a brush can paint.
// A preset names its engine by key ("paintbrush"), Settings.engine holds
// the engine's number (types.ENGINE_...), and the stroke
// (brush/stroke.mlx) asks here for the record of functions that paints.
//
// An engine module (brush/pixel_engine.mlx is the model) has a table of
// types.Engine and hands it out through core/table.mlx (never as
// `ENGINES[0..]` made on every call: that slice is a copy in the value
// arena each time):
//
//     var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }
//     pub fn list() -> []const types.Engine {
//         if kept.address != 0 { return table.rows(types.Engine, &kept) }
//         return table.keep(types.Engine, &kept, ENGINES[0..])
//     }
//
// A new engine module is imported here and given its line in load():
// nothing else knows the engines one by one. The ids are types.ENGINE_...
// (they stay for good: Settings.engine keeps them), the keys are what
// preset files say.
//
// The records are copied into a table of this module's own at the first
// asking, and the pointers handed out point into that: they stay good
// for the program's life. (A slice of a module's constant table is a
// copy in the value arena, gone when the window's loop turns; nobody
// may keep a pointer into one.)
const std = @import("std")
const types = @import("./types.mlx")
const pixel_engine = @import("./pixel_engine.mlx")
const smudge_engine = @import("./smudge_engine.mlx")
const clone_engine = @import("./clone_engine.mlx")
const filter_engine = @import("./filter_engine.mlx")
const deform_engine = @import("./deform_engine.mlx")
const quick_engine = @import("./quick_engine.mlx")
const sketch_engine = @import("./sketch_engine.mlx")
const spray_engine = @import("./spray_engine.mlx")
const hairy_engine = @import("./hairy_engine.mlx")
const shape_engine = @import("./shape_engine.mlx")
const particle_engine = @import("./particle_engine.mlx")
const hatching_engine = @import("./hatching_engine.mlx")
const curve_engine = @import("./curve_engine.mlx")
const grid_engine = @import("./grid_engine.mlx")
const dyna_engine = @import("./dyna_engine.mlx")

pub const Engine = types.Engine

// Room for so many engines (more are not listed).
const CAPACITY: usize = 48

var table: [48]types.Engine = undefined
var known: usize = 0
var loaded: bool = false

fn add(list: []const Engine) -> void {
    var index: usize = 0
    while index < list.length && known < CAPACITY {
        table[known] = list[index]
        known += 1
        index += 1
    }
}

fn load() -> void {
    if loaded { return }
    known = 0
    add(pixel_engine.list())
    add(smudge_engine.list())
    add(clone_engine.list())
    add(filter_engine.list())
    add(deform_engine.list())
    add(quick_engine.list())
    add(sketch_engine.list())
    add(spray_engine.list())
    add(hairy_engine.list())
    add(shape_engine.list())
    add(particle_engine.list())
    add(hatching_engine.list())
    add(curve_engine.list())
    add(grid_engine.list())
    add(dyna_engine.list())
    loaded = true
}

// How many engines there are.
pub fn count() -> usize {
    load()
    return known
}

// The engine at a place in the list (in the modules' order; null past the
// last). The record stays where it is for the program's life.
pub fn at(index: usize) -> ?*const Engine {
    load()
    if index >= known { return null }
    return &table[index]
}

// The engine numbered `id` (null: there is none).
pub fn find(id: u16) -> ?*const Engine {
    load()
    var index: usize = 0
    while index < known {
        if table[index].id == id { return &table[index] }
        index += 1
    }
    return null
}

// The engine a preset file names `key` (null: not known).
pub fn byKey(key: []const u8) -> ?*const Engine {
    load()
    var index: usize = 0
    while index < known {
        if std.text.same(table[index].key, key) { return &table[index] }
        index += 1
    }
    return null
}

// What people call engine `id` ("" for a number that is none).
pub fn name(id: u16, german: bool) -> []const u8 {
    const engine = find(id)
    if engine == null { return "" }
    return if german { engine.?.*.german } else { engine.?.*.name }
}
