// nebula actions: the Tools menu: every registered tool, by the
// toolbox's groups (a submenu each: Paint, Shapes, Transform, Fill,
// Select, View, Other), the one in use checked; choosing one makes it the
// tool in use (api.setTool). The tools' table may grow: the entries are
// state.MenuSource rows that count the registry's tools of their group.
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const tools = @import("../tools/registry.mlx")
const table = @import("../core/table.mlx")

const App = state.App

const ACTIONS = [0]state.Action{}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

// How many registered tools are of toolbox group `group`.
pub fn countIn(group: u8) -> usize {
    var found: usize = 0
    var index: usize = 0
    const all = tools.count()
    while index < all {
        const tool = tools.at(index)
        if tool != null && tool.?.*.group == group { found += 1 }
        index += 1
    }
    return found
}

// Tool number `place` of group `group` (null past the last).
pub fn toolIn(group: u8, place: usize) -> ?*const state.Tool {
    var left = place
    var index: usize = 0
    const all = tools.count()
    while index < all {
        const tool = tools.at(index)
        if tool != null && tool.?.*.group == group {
            if left == 0 { return tool }
            left -= 1
        }
        index += 1
    }
    return null
}

fn nameIn(app: *App, group: u8, place: usize) -> []const u8 {
    const tool = toolIn(group, place)
    if tool == null { return "" }
    return state.tr(app, tool.?.*.name, tool.?.*.german)
}

fn runIn(app: *App, group: u8, place: usize) -> void {
    const tool = toolIn(group, place)
    if tool != null { api.setTool(app, tool.?.*.id) }
}

fn chosenIn(app: *App, group: u8, place: usize) -> bool {
    const tool = toolIn(group, place)
    return tool != null && tool.?.*.id == app.*.tool
}

// (A tool waits while the one in use is in the middle of something.)
fn free(app: *App, place: usize) -> bool { return !api.toolBusy(app) }

fn count0(app: *App) -> usize { return countIn(state.GROUP_PAINT) }
fn count1(app: *App) -> usize { return countIn(state.GROUP_SHAPE) }
fn count2(app: *App) -> usize { return countIn(state.GROUP_TRANSFORM) }
fn count3(app: *App) -> usize { return countIn(state.GROUP_FILL) }
fn count4(app: *App) -> usize { return countIn(state.GROUP_SELECT) }
fn count5(app: *App) -> usize { return countIn(state.GROUP_VIEW) }
fn count6(app: *App) -> usize { return countIn(state.GROUP_OTHER) }
fn name0(app: *App, place: usize) -> []const u8 { return nameIn(app, state.GROUP_PAINT, place) }
fn name1(app: *App, place: usize) -> []const u8 { return nameIn(app, state.GROUP_SHAPE, place) }
fn name2(app: *App, place: usize) -> []const u8 { return nameIn(app, state.GROUP_TRANSFORM, place) }
fn name3(app: *App, place: usize) -> []const u8 { return nameIn(app, state.GROUP_FILL, place) }
fn name4(app: *App, place: usize) -> []const u8 { return nameIn(app, state.GROUP_SELECT, place) }
fn name5(app: *App, place: usize) -> []const u8 { return nameIn(app, state.GROUP_VIEW, place) }
fn name6(app: *App, place: usize) -> []const u8 { return nameIn(app, state.GROUP_OTHER, place) }
fn run0(app: *App, place: usize) -> void { runIn(app, state.GROUP_PAINT, place) }
fn run1(app: *App, place: usize) -> void { runIn(app, state.GROUP_SHAPE, place) }
fn run2(app: *App, place: usize) -> void { runIn(app, state.GROUP_TRANSFORM, place) }
fn run3(app: *App, place: usize) -> void { runIn(app, state.GROUP_FILL, place) }
fn run4(app: *App, place: usize) -> void { runIn(app, state.GROUP_SELECT, place) }
fn run5(app: *App, place: usize) -> void { runIn(app, state.GROUP_VIEW, place) }
fn run6(app: *App, place: usize) -> void { runIn(app, state.GROUP_OTHER, place) }
fn chosen0(app: *App, place: usize) -> bool { return chosenIn(app, state.GROUP_PAINT, place) }
fn chosen1(app: *App, place: usize) -> bool { return chosenIn(app, state.GROUP_SHAPE, place) }
fn chosen2(app: *App, place: usize) -> bool { return chosenIn(app, state.GROUP_TRANSFORM, place) }
fn chosen3(app: *App, place: usize) -> bool { return chosenIn(app, state.GROUP_FILL, place) }
fn chosen4(app: *App, place: usize) -> bool { return chosenIn(app, state.GROUP_SELECT, place) }
fn chosen5(app: *App, place: usize) -> bool { return chosenIn(app, state.GROUP_VIEW, place) }
fn chosen6(app: *App, place: usize) -> bool { return chosenIn(app, state.GROUP_OTHER, place) }

// One source a group, in the toolbox's order (state.GROUP_*).
const SOURCES = [7]state.MenuSource{
    state.MenuSource.{ .menu = state.MENU_TOOLS, .submenu = "Paint|Malen", .flags = 0, .count = count0, .name = name0, .run = run0, .checked = chosen0, .enabled = free },
    state.MenuSource.{ .menu = state.MENU_TOOLS, .submenu = "Shapes|Formen", .flags = 0, .count = count1, .name = name1, .run = run1, .checked = chosen1, .enabled = free },
    state.MenuSource.{ .menu = state.MENU_TOOLS, .submenu = "Transform|Transformieren", .flags = 0, .count = count2, .name = name2, .run = run2, .checked = chosen2, .enabled = free },
    state.MenuSource.{ .menu = state.MENU_TOOLS, .submenu = "Fill|Füllen", .flags = 0, .count = count3, .name = name3, .run = run3, .checked = chosen3, .enabled = free },
    state.MenuSource.{ .menu = state.MENU_TOOLS, .submenu = "Select|Auswählen", .flags = 0, .count = count4, .name = name4, .run = run4, .checked = chosen4, .enabled = free },
    state.MenuSource.{ .menu = state.MENU_TOOLS, .submenu = "View|Ansicht", .flags = 0, .count = count5, .name = name5, .run = run5, .checked = chosen5, .enabled = free },
    state.MenuSource.{ .menu = state.MENU_TOOLS, .submenu = "Other|Sonstige", .flags = 0, .count = count6, .name = name6, .run = run6, .checked = chosen6, .enabled = free },
}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
