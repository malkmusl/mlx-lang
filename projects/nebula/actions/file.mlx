// nebula actions: the File menu: new, open (and the files used last),
// save, save as, save an incremental version, export, revert, the
// document's information, close, close all, quit. main.mlx opens the
// files named on the command line with openPaths().
//
// Files go through io/formats.mlx (load and save, the list of formats)
// and the file dialog (ui/filedialog.mlx) with filters made from that
// list: Open shows the formats that can be read ("All pictures" first),
// Save As those that can be written, the setting save_format's first
// (app/settings.mlx: "ora" unless the person chose another; a document
// without a file is proposed in it), then the other layered ones, Export
// the same with PNG first. The format saved in is the one the name's
// extension says when that one can be written, else the filter's. An
// image opened (or read again by Revert) keeps as many undo steps as the
// setting undo_steps says.
//
// Save writes the document to its file in its format. A document that
// has no file yet, whose format cannot be written, or that has layers
// while its format keeps none (a PNG with two layers) asks with Save As
// instead; once the person saved such a document flat with Save As
// knowingly (the status bar says the layers were merged in the file),
// Save writes it flat again without asking. After saving, the document is
// unchanged, its tab says the file's name, the file is first among the
// recent ones and the document's autosave (app/autosave.mlx) goes. With
// the setting keep_backup, the file that was there is kept beside it as
// NAME~ first. Export writes a copy and changes nothing of the document.
// An incremental version is NAME_001.EXT, then NAME_002.EXT, ... (the
// first number that is free; a name that ends in "_007" goes on from 8).
//
// Closing a document with changes asks Save / Discard / Cancel (unless
// the setting confirm_close is off); Close All and Quit ask so for each
// changed document, in front, one after the other: Cancel stops there
// (what was closed stays closed), a Save that needs a name asks for it
// and goes on once the document is saved (cancelling that dialog stops).
//
// What a dialog's answer is for (the document, the chain of documents
// being closed, the formats of the filters shown) is kept in the module's
// slot (state.SLOT_ACTIONS + 0): the answers come back to functions
// without a context.
//
// Not done: options of a format when saving or exporting (JPEG's quality
// and PNG's compression are the settings'); a document's file watched
// for changes by others; saving in the background.
const std = @import("std")
const ui = @import("std.ui")
const text_module = @import("std.ui.text")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const documents = @import("../app/documents.mlx")
const recent = @import("../app/recent.mlx")
const settings = @import("../app/settings.mlx")
const shell_module = @import("../app/shell.mlx")
const autosave = @import("../app/autosave.mlx")
const table = @import("../core/table.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const device_module = @import("../core/device.mlx")
const history_module = @import("../core/history.mlx")
const formats = @import("../io/formats.mlx")
const text_io = @import("../io/text.mlx")
const filedialog = @import("../ui/filedialog.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const kit_module = @import("../ui/kit.mlx")
const canvasview = @import("../ui/canvasview.mlx")

pub const App = state.App
pub const Document = state.Document
const Image = image_module.Image
const Node = node_module.Node

const SLOT: usize = state.SLOT_ACTIONS + 0

// What is being closed: nothing, one document, all of them, all and
// then the program.
const CLOSE_NONE: u8 = 0
const CLOSE_ONE: u8 = 1
const CLOSE_ALL: u8 = 2
const CLOSE_QUIT: u8 = 3

// How a save that was asked for went.
const SAVED: u8 = 0
// The Save As dialog is asking for a name.
const ASKING: u8 = 1
const FAILED: u8 = 2

const FILTERS: usize = 16
const NO_INDEX: usize = 18446744073709551615
const PATH: usize = 4096
const ROOM: usize = 512
// dialogs.Hooks.kind of the Document Information dialog (dialogs.find
// tells dialogs apart by it: a number no other part takes; 0x70 on are
// this package's, app/autosave.mlx has 0x71).
const KIND_INFO: u8 = 0x70
const INFO_ROWS: usize = 8
const INFO_TEXT: usize = 160

const Files = struct {
    // The filters of the dialog shown last and the format each stands
    // for (formats.NONE: all files).
    filters: [16]filedialog.Filter
    filterFormats: [16]u16
    filterCount: usize
    // "png jpg jpeg ...": the extensions of every format that is read.
    pictures: [256]u8
    picturesLength: usize
    // Closing: what (CLOSE_*), and the document asked about (its
    // address; 0: none).
    closing: u8
    target: usize
    // The document Save As, Export, Revert and the information are for.
    saveTarget: usize
    exportTarget: usize
    revertTarget: usize
    infoTarget: usize
    // Documents saved flat knowingly (their addresses; 0: free).
    flatOk: [16]usize
    // The recent files that are there now (their places in the list),
    // found when the menu counted them.
    recentPlaces: [100]usize
    recentCount: usize
    // A path or a text being put together; a recent file being opened
    // (a copy: opening it reorders the list).
    path: [4096]u8
    pathLength: usize
    text: [512]u8
    chosen: [4096]u8
    // The information dialog's values.
    info: [8][160]u8
    infoLengths: [8]usize
    labels: [3][]const u8
}

fn filesOf(app: *App) -> ?*Files {
    const memory = state.slot(app, SLOT, @sizeOf(Files))
    if memory == null { return null }
    return unsafe { @ptrCast(*Files, memory.?) }
}

// ---------------------------------------------------------------------------
// Documents by address (an answer comes back after the list may have
// changed)

// The place of the document at `address` in app.documents (NO_INDEX:
// it is not open). (A number, not an optional one: an optional number
// holding 0 is not to be trusted to differ from null.)
fn indexOf(app: *App, address: usize) -> usize {
    if address == 0 { return NO_INDEX }
    var index: usize = 0
    while index < app.*.count {
        if app.*.documents[index] != null && @intFromPtr(app.*.documents[index].?) == address { return index }
        index += 1
    }
    return NO_INDEX
}

fn documentAt(app: *App, address: usize) -> ?*Document {
    const index = indexOf(app, address)
    if index == NO_INDEX { return null }
    return app.*.documents[index]
}

fn textOf(files: *Files, length: usize) -> []const u8 {
    const bytes: [*]const u8 = &files.*.text
    return bytes[0..length]
}

fn pathText(files: *Files) -> []const u8 {
    const bytes: [*]const u8 = &files.*.path
    return bytes[0..files.*.pathLength]
}

// `first`, `name` and `last` one after the other in files.text.
fn joined(files: *Files, first: []const u8, name: []const u8, last: []const u8) -> []const u8 {
    const bytes: [*]u8 = &files.*.text
    var length = std.text.append(bytes, 0, ROOM, first)
    length = std.text.append(bytes, length, ROOM, name)
    length = std.text.append(bytes, length, ROOM, last)
    return textOf(files, length)
}

fn isFlatOk(files: *Files, doc: *Document) -> bool {
    var index: usize = 0
    while index < state.DOCUMENTS {
        if files.*.flatOk[index] == @intFromPtr(doc) { return true }
        index += 1
    }
    return false
}

fn setFlatOk(files: *Files, doc: *Document, on: bool) -> void {
    var free: usize = state.DOCUMENTS
    var index: usize = 0
    while index < state.DOCUMENTS {
        if files.*.flatOk[index] == @intFromPtr(doc) {
            if !on { files.*.flatOk[index] = 0 }
            return
        }
        if files.*.flatOk[index] == 0 && free == state.DOCUMENTS { free = index }
        index += 1
    }
    if on && free < state.DOCUMENTS { files.*.flatOk[free] = @intFromPtr(doc) }
}

// ---------------------------------------------------------------------------
// Formats and filters

fn canWrite(info: *const formats.Info) -> bool {
    return info.*.canWrite && (info.*.write != null || info.*.writeImage != null)
}

fn canRead(info: *const formats.Info) -> bool {
    return info.*.canRead && (info.*.read != null || info.*.readImage != null)
}

fn addFilter(files: *Files, name: []const u8, german: []const u8, extensions: []const u8, format: u16) -> void {
    if files.*.filterCount >= FILTERS { return }
    files.*.filters[files.*.filterCount] = filedialog.Filter.{ .name = name, .german = german, .extensions = extensions }
    files.*.filterFormats[files.*.filterCount] = format
    files.*.filterCount += 1
}

// The formats that are read: "All pictures" (every one's extensions),
// each format, all files.
fn readFilters(files: *Files) -> []const filedialog.Filter {
    files.*.filterCount = 0
    const all = formats.list()
    const bytes: [*]u8 = &files.*.pictures
    var length: usize = 0
    var index: usize = 0
    while index < all.length {
        const info = &all[index]
        if canRead(info) && length + info.*.extensions.length + 1 < 256 {
            if length > 0 { length = std.text.appendByte(bytes, length, 256, 32) }
            length = std.text.append(bytes, length, 256, info.*.extensions)
        }
        index += 1
    }
    files.*.picturesLength = length
    addFilter(files, "All pictures", "Alle Bilder", bytes[0..length], formats.NONE)
    index = 0
    while index < all.length {
        const info = &all[index]
        if canRead(info) { addFilter(files, info.*.name, info.*.german, info.*.extensions, info.*.id) }
        index += 1
    }
    addFilter(files, "All files", "Alle Dateien", "", formats.NONE)
    const filters: [*]const filedialog.Filter = &files.*.filters
    return filters[0..files.*.filterCount]
}

// The formats that are written: `first` (when it is one of them) ahead,
// then the layered ones (to save a document whole) or PNG (to export a
// picture), then the others.
fn writeFilters(files: *Files, first: u16, layered_first: bool) -> []const filedialog.Filter {
    files.*.filterCount = 0
    const all = formats.list()
    var round: usize = 0
    while round < 3 {
        var index: usize = 0
        while index < all.length {
            const info = &all[index]
            const preferred = info.*.id == first
            const early = !preferred && (if layered_first { info.*.layers } else { info.*.id == formats.PNG })
            const take = (round == 0 && preferred) || (round == 1 && early) || (round == 2 && !preferred && !early)
            if canWrite(info) && take { addFilter(files, info.*.name, info.*.german, info.*.extensions, info.*.id) }
            index += 1
        }
        round += 1
    }
    const filters: [*]const filedialog.Filter = &files.*.filters
    return filters[0..files.*.filterCount]
}

// The format the setting save_format names (formats.NONE: none that is
// written).
fn preferredFormat(app: *App) -> u16 {
    const info = formats.byKey(settings.lineText(&settings.get(app).*.saveFormat))
    if info == null || !canWrite(info.?) { return formats.NONE }
    return info.?.*.id
}

// An image read from a file keeps as many steps as the settings say (as
// a new one does).
fn takeUndoSteps(app: *App, image: *Image) -> void {
    image.*.history.*.limit = @intCast(usize, settings.get(app).*.undoSteps)
}

// The first extension of format `id` ("png"; "" for none).
fn extensionOf(id: u16) -> []const u8 {
    const info = formats.find(id)
    if info == null { return "" }
    const words = info.?.*.extensions
    var end: usize = 0
    while end < words.length && words[end] != 32 { end += 1 }
    return words[0..end]
}

// The format to write `path` in, chosen with filter `filter`: the one
// its extension names when that is written, else the filter's (else PNG).
fn formatFor(files: *Files, path: []const u8, filter: usize) -> u16 {
    const named = formats.byPath(path)
    if named != null && canWrite(named.?) { return named.?.*.id }
    if filter < files.*.filterCount && files.*.filterFormats[filter] != formats.NONE { return files.*.filterFormats[filter] }
    return formats.PNG
}

fn keepsLayers(id: u16) -> bool {
    const info = formats.find(id)
    return info != null && info.?.*.layers
}

// Whether the image is more than one layer (what a flat file loses).
fn isLayered(image: *Image) -> bool {
    return image_module.nodeCount(image) > 1
}

fn optionsOf(app: *App) -> formats.SaveOptions {
    const prefs = settings.get(app)
    var options = formats.saveOptions()
    options.level = @intCast(i32, prefs.*.pngCompression)
    options.quality = prefs.*.jpegQuality
    return options
}

// ---------------------------------------------------------------------------
// Opening

// `path` as an absolute one into files.path (a relative one is under the
// working directory). False when it does not fit.
fn absolute(files: *Files, path: []const u8) -> bool {
    const bytes: [*]u8 = &files.*.path
    files.*.pathLength = 0
    if path.length == 0 || path.length >= PATH { return false }
    if path[0] == 47 {
        files.*.pathLength = std.text.append(bytes, 0, PATH, path)
        return true
    }
    const got = std.fs.getWorkingDirectory(bytes, PATH)
    if got <= 0 { return false }
    var length: usize = 0
    while length < PATH && bytes[length] != 0 { length += 1 }
    if length + 1 + path.length >= PATH { return false }
    if length == 0 || bytes[length - 1] != 47 { length = std.text.appendByte(bytes, length, PATH, 47) }
    files.*.pathLength = std.text.append(bytes, length, PATH, path)
    return true
}

fn failed(app: *App, title: []const u8, status: formats.Status, path: []const u8) -> void {
    const files = filesOf(app)
    const said = formats.message(status, app.*.german)
    if files == null {
        api.say(app, said, true)
        return
    }
    const text = joined(files.?, said, ": ", text_io.baseName(path))
    _ = dialogs.message(app, title, text, dialogs.ERROR)
}

// Opens the picture file at `path` (absolute or under the working
// directory) as a document in front; a file that is open already comes
// to the front instead. False when it could not be read (a dialog says
// why).
pub fn openPath(app: *App, path: []const u8) -> bool {
    const files = filesOf(app)
    if files == null || !absolute(files.?, path) { return false }
    const whole = pathText(files.?)
    var index: usize = 0
    while index < app.*.count {
        const doc = app.*.documents[index]
        if doc != null && std.text.same(image_module.pathOf(doc.?.*.image), whole) {
            documents.show(app, index)
            return true
        }
        index += 1
    }
    var result: formats.LoadResult = undefined
    const status = formats.load(app.*.allocator, whole, &result)
    if status != formats.Status.ok {
        failed(app, state.tr(app, "Open", "Öffnen"), status, whole)
        return false
    }
    takeUndoSteps(app, result.image.?)
    const doc = documents.add(app, result.image.?, text_io.baseName(whole))
    if doc == null {
        image_module.destroy(result.image.?)
        return false
    }
    doc.?.*.format = @intCast(u8, result.format)
    documents.markSaved(doc.?)
    _ = recent.add(app, image_module.pathOf(doc.?.*.image))
    api.sayWith(app, state.tr(app, "Opened ", "Geöffnet: "), documents.nameOf(doc.?), false)
    return true
}

// Opens the files of `paths` (NUL-terminated, as a program's arguments
// are: absolute or under the working directory), each as a document; how
// many were opened (or shown, when open already).
pub fn openPaths(app: *App, paths: []const [*]const u8) -> usize {
    var count: usize = 0
    for path in paths {
        if openPath(app, std.text.cString(path)) { count += 1 }
    }
    return count
}

fn opened(app: *App, path: []const u8, filter: usize) -> void {
    _ = openPath(app, path)
}

// ---------------------------------------------------------------------------
// Saving

// The file at `path` copied to "PATH~" (the setting keep_backup). False
// when there was one and it could not be copied (then it is not
// overwritten either).
fn keepBackup(app: *App, path: []const u8) -> bool {
    const allocator = app.*.allocator
    if !settings.get(app).*.keepBackup || !text_io.exists(allocator, path) { return true }
    const name = allocator.alloc(path.length + 1, 1)
    if name == null { return false }
    var length = std.text.append(name.?, 0, path.length + 1, path)
    length = std.text.appendByte(name.?, length, path.length + 1, 126)
    var contents: text_io.Contents = undefined
    var kept = false
    if text_io.readFile(allocator, path, &contents) == text_io.FileStatus.ok {
        kept = text_io.writeFile(allocator, name.?[0..length], contents.bytes[0..contents.length])
        text_io.freeFile(&contents)
    }
    allocator.free(name.?, path.length + 1, 1)
    return kept
}

// Writes `doc` as `path` in format `format`; afterwards it is that file
// (its path, format and name), unchanged. False when it could not be
// written (a dialog says why).
fn saveDocument(app: *App, doc: *Document, path: []const u8, format: u16) -> bool {
    const files = filesOf(app)
    if files == null { return false }
    if !keepBackup(app, path) {
        failed(app, state.tr(app, "Save", "Speichern"), formats.Status.cannotWrite, path)
        return false
    }
    const options = optionsOf(app)
    const status = formats.save(doc.*.image, path, format, &options)
    if status != formats.Status.ok {
        failed(app, state.tr(app, "Save", "Speichern"), status, path)
        return false
    }
    // (`path` may be the image's own path: it is set from a copy.)
    const bytes: [*]u8 = &files.?.*.path
    if @intFromPtr(path.pointer) != @intFromPtr(bytes) { files.?.*.pathLength = std.text.append(bytes, 0, PATH, path) }
    image_module.setPath(doc.*.image, pathText(files.?))
    doc.*.format = @intCast(u8, format)
    documents.setName(doc, text_io.baseName(image_module.pathOf(doc.*.image)))
    documents.markSaved(doc)
    autosave.forget(app, doc)
    _ = recent.add(app, image_module.pathOf(doc.*.image))
    if !keepsLayers(format) && isLayered(doc.*.image) {
        api.sayWith(app, documents.nameOf(doc), state.tr(app, " saved: its layers are merged in the file (the format keeps none)", " gespeichert: die Ebenen sind in der Datei zusammengefügt (das Format kennt keine)"), false)
    } else {
        api.sayWith(app, state.tr(app, "Saved ", "Gespeichert: "), documents.nameOf(doc), false)
    }
    api.redraw(app)
    return true
}

// Whether Save can write `doc` where it is, as it is, without asking.
fn savesAsIs(files: *Files, doc: *Document) -> bool {
    if image_module.pathOf(doc.*.image).length == 0 { return false }
    const info = formats.find(@intCast(u16, doc.*.format))
    if info == null || !canWrite(info.?) { return false }
    return info.?.*.layers || !isLayered(doc.*.image) || isFlatOk(files, doc)
}

// The name proposed for `doc` with `extension`: its file's name, else its
// own, with that extension.
fn proposedName(files: *Files, doc: *Document, extension: []const u8) -> []const u8 {
    const path = image_module.pathOf(doc.*.image)
    const name = if path.length > 0 { text_io.baseName(path) } else { documents.nameOf(doc) }
    const bytes: [*]u8 = &files.*.text
    var length = text_io.withExtension(name, extension, bytes, ROOM)
    if length == 0 { length = std.text.append(bytes, 0, ROOM, name) }
    return textOf(files, length)
}

// Asks for a name to save `doc` under (Save As). False when the dialog
// cannot be shown.
fn askSaveAs(app: *App, doc: *Document) -> bool {
    const files = filesOf(app)
    if files == null { return false }
    files.?.*.saveTarget = @intFromPtr(doc)
    const filters = writeFilters(files.?, preferredFormat(app), true)
    if filters.length == 0 { return false }
    const path = image_module.pathOf(doc.*.image)
    // A document saved before keeps its format proposed (unless it cannot
    // hold the document's layers); a new one gets the first filter's.
    var extension = extensionOf(files.?.*.filterFormats[0])
    const own = formats.find(@intCast(u16, doc.*.format))
    if path.length > 0 && own != null && canWrite(own.?) && (own.?.*.layers || !isLayered(doc.*.image) || !keepsLayers(files.?.*.filterFormats[0])) { extension = text_io.extension(path) }
    const directory = text_io.directory(path)
    return filedialog.save(app, state.tr(app, "Save Image As", "Bild speichern unter"), directory, proposedName(files.?, doc, extension), filters, savedAs)
}

fn savedAs(app: *App, path: []const u8, filter: usize) -> void {
    const files = filesOf(app)
    if files == null { return }
    const doc = documentAt(app, files.?.*.saveTarget)
    if doc == null { return }
    const format = formatFor(files.?, path, filter)
    if !saveDocument(app, doc.?, path, format) {
        endChain(files.?)
        return
    }
    // Saved flat by choice: Save goes on so without asking.
    setFlatOk(files.?, doc.?, !keepsLayers(format) && isLayered(doc.?.*.image))
    if files.?.*.closing != CLOSE_NONE && files.?.*.target == @intFromPtr(doc.?) { closeTargetAndGoOn(app, files.?) }
}

// Saves `doc` where it is, or asks for a name (see the header).
fn saveOrAsk(app: *App, doc: *Document) -> u8 {
    const files = filesOf(app)
    if files == null { return FAILED }
    if !savesAsIs(files.?, doc) { return if askSaveAs(app, doc) { ASKING } else { FAILED } }
    return if saveDocument(app, doc, image_module.pathOf(doc.*.image), @intCast(u16, doc.*.format)) { SAVED } else { FAILED }
}

// "NAME_NNN" of a stem: where NAME ends and the number after it (0:
// none).
fn numbered(stem: []const u8, number: *usize) -> usize {
    number.* = 0
    var at = stem.length
    while at > 0 && stem[at - 1] >= 48 && stem[at - 1] <= 57 { at -= 1 }
    const digits = stem.length - at
    if digits < 3 || digits > 6 || at < 2 || stem[at - 1] != 95 { return stem.length }
    var value: usize = 0
    var index = at
    while index < stem.length {
        value = value * 10 + @intCast(usize, stem[index] - 48)
        index += 1
    }
    number.* = value
    return at - 1
}

// The next incremental version of `path` that is not there yet into
// files.path (NAME_001.EXT, ...). False when none fits.
fn nextVersion(app: *App, files: *Files, path: []const u8) -> bool {
    const extension = text_io.extension(path)
    const stem_end = if extension.length > 0 { path.length - extension.length - 1 } else { path.length }
    const stem = path[0..stem_end]
    var number: usize = 0
    const base_end = numbered(stem, &number)
    var tries: usize = 0
    while tries < 10000 {
        number += 1
        const bytes: [*]u8 = &files.*.path
        var length = std.text.append(bytes, 0, PATH, stem[0..base_end])
        length = std.text.appendByte(bytes, length, PATH, 95)
        if number < 100 { length = std.text.appendByte(bytes, length, PATH, 48) }
        if number < 10 { length = std.text.appendByte(bytes, length, PATH, 48) }
        length = std.text.appendUnsigned(bytes, length, PATH, number)
        if extension.length > 0 {
            length = std.text.appendByte(bytes, length, PATH, 46)
            length = std.text.append(bytes, length, PATH, extension)
        }
        if length >= PATH - 1 { return false }
        files.*.pathLength = length
        if !text_io.exists(app.*.allocator, pathText(files)) { return true }
        tries += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Closing

fn endChain(files: *Files) -> void {
    files.*.closing = CLOSE_NONE
    files.*.target = 0
}

// The tool in use lets go of what it holds of a document (its marks, a
// transform not yet done).
fn settleTool(app: *App) -> void {
    const tool = api.tool(app)
    if api.toolBusy(app) && tool != null && tool.?.*.cancel != null { tool.?.*.cancel.?(app) }
}

// Closes document `index` whatever its state, with what was kept for it.
fn closeDocument(app: *App, index: usize) -> void {
    if index >= app.*.count { return }
    const doc = app.*.documents[index].?
    if index == app.*.current { settleTool(app) }
    const files = filesOf(app)
    if files != null { setFlatOk(files.?, doc, false) }
    canvasview.forget(app, doc)
    autosave.forget(app, doc)
    documents.close(app, index)
}

fn closeTargetAndGoOn(app: *App, files: *Files) -> void {
    const index = indexOf(app, files.*.target)
    files.*.target = 0
    if index != NO_INDEX { closeDocument(app, index) }
    if files.*.closing == CLOSE_ONE {
        endChain(files)
        return
    }
    goOn(app)
}

fn needsAsking(app: *App, doc: *Document) -> bool {
    return documents.isModified(doc) && settings.get(app).*.confirmClose
}

fn onSave(app: *App) -> void {
    const files = filesOf(app)
    if files == null { return }
    const doc = documentAt(app, files.?.*.target)
    if doc == null {
        goOn(app)
        return
    }
    const how = saveOrAsk(app, doc.?)
    if how == SAVED { closeTargetAndGoOn(app, files.?) }
    // (ASKING: savedAs goes on; FAILED: the chain stops, a dialog says
    // why.)
    if how == FAILED { endChain(files.?) }
}

fn onDiscard(app: *App) -> void {
    const files = filesOf(app)
    if files != null { closeTargetAndGoOn(app, files.?) }
}

fn onCancel(app: *App) -> void {
    const files = filesOf(app)
    if files != null { endChain(files.?) }
}

fn ask(app: *App, files: *Files, doc: *Document) -> void {
    files.*.target = @intFromPtr(doc)
    const quitting = files.*.closing == CLOSE_QUIT
    const title = if quitting { state.tr(app, "Quit", "Beenden") } else { state.tr(app, "Close Image", "Bild schließen") }
    const text = joined(files, state.tr(app, "\xE2\x80\x9C", "\xE2\x80\x9E"), documents.nameOf(doc), state.tr(app, "\xE2\x80\x9D has changes that are not saved. Save them before closing?", "\xE2\x80\x9C hat ungespeicherte Änderungen. Vor dem Schließen speichern?"))
    if !dialogs.choose3(app, title, text, state.tr(app, "Save", "Speichern"), state.tr(app, "Discard", "Verwerfen"), state.tr(app, "Cancel", "Abbrechen"), onSave, onDiscard, onCancel) { endChain(files) }
}

// The chain of closing goes on: the next document is closed, or asked
// about; at its end the program quits when that was asked.
fn goOn(app: *App) -> void {
    const files = filesOf(app)
    if files == null { return }
    const f = files.?
    if f.*.closing == CLOSE_ONE {
        const doc = documentAt(app, f.*.target)
        if doc == null {
            endChain(f)
            return
        }
        if needsAsking(app, doc.?) {
            ask(app, f, doc.?)
            return
        }
        closeTargetAndGoOn(app, f)
        return
    }
    if f.*.closing == CLOSE_NONE { return }
    // All of them: those without changes go at once, the next one with
    // changes comes to the front and is asked about.
    var index: usize = 0
    while index < app.*.count {
        const doc = app.*.documents[index].?
        if needsAsking(app, doc) {
            documents.show(app, index)
            ask(app, f, doc)
            return
        }
        closeDocument(app, index)
    }
    const quitting = f.*.closing == CLOSE_QUIT
    endChain(f)
    if quitting { shell_module.quit(app.*.shell) }
}

fn startClosing(app: *App, how: u8) -> void {
    const files = filesOf(app)
    if files == null { return }
    files.?.*.closing = how
    files.?.*.target = 0
    if how == CLOSE_ONE {
        const doc = api.document(app)
        if doc == null {
            endChain(files.?)
            return
        }
        files.?.*.target = @intFromPtr(doc.?)
    }
    goOn(app)
}

// Whether something is being closed and waits for an answer (a dialog
// asks about a document, or for a name to save it under). A chain whose
// Save As was cancelled waits for nothing: with no dialog open it is
// over (nothing more is closed, the program does not quit).
pub fn closing(app: *App) -> bool {
    const files = filesOf(app)
    if files == null || files.?.*.closing == CLOSE_NONE { return false }
    if app.*.dialogCount == 0 {
        endChain(files.?)
        return false
    }
    return true
}

// ---------------------------------------------------------------------------
// The actions

fn newImage(app: *App) -> void {
    _ = dialogs.newImage(app)
}

fn open(app: *App) -> void {
    const files = filesOf(app)
    if files == null { return }
    endChain(files.?)
    _ = filedialog.openMany(app, state.tr(app, "Open Images", "Bilder öffnen"), "", readFilters(files.?), opened)
}

fn save(app: *App) -> void {
    const files = filesOf(app)
    const doc = api.document(app)
    if files == null || doc == null { return }
    endChain(files.?)
    _ = saveOrAsk(app, doc.?)
}

fn saveAs(app: *App) -> void {
    const files = filesOf(app)
    const doc = api.document(app)
    if files == null || doc == null { return }
    endChain(files.?)
    _ = askSaveAs(app, doc.?)
}

fn saveIncremental(app: *App) -> void {
    const files = filesOf(app)
    const doc = api.document(app)
    if files == null || doc == null { return }
    endChain(files.?)
    if !savesAsIs(files.?, doc.?) {
        _ = askSaveAs(app, doc.?)
        return
    }
    if !nextVersion(app, files.?, image_module.pathOf(doc.?.*.image)) {
        api.say(app, state.tr(app, "No free name for a new version", "Kein freier Name für eine neue Version"), true)
        return
    }
    _ = saveDocument(app, doc.?, pathText(files.?), @intCast(u16, doc.?.*.format))
}

fn exported(app: *App, path: []const u8, filter: usize) -> void {
    const files = filesOf(app)
    if files == null { return }
    const doc = documentAt(app, files.?.*.exportTarget)
    if doc == null { return }
    const format = formatFor(files.?, path, filter)
    const options = optionsOf(app)
    const status = formats.save(doc.?.*.image, path, format, &options)
    if status != formats.Status.ok {
        failed(app, state.tr(app, "Export", "Exportieren"), status, path)
        return
    }
    if !keepsLayers(format) && isLayered(doc.?.*.image) {
        api.sayWith(app, text_io.baseName(path), state.tr(app, " exported: the layers are merged into one picture", " exportiert: die Ebenen sind zu einem Bild zusammengefügt"), false)
    } else {
        api.sayWith(app, state.tr(app, "Exported ", "Exportiert: "), text_io.baseName(path), false)
    }
}

fn exportImage(app: *App) -> void {
    const files = filesOf(app)
    const doc = api.document(app)
    if files == null || doc == null { return }
    endChain(files.?)
    files.?.*.exportTarget = @intFromPtr(doc.?)
    const filters = writeFilters(files.?, formats.PNG, false)
    if filters.length == 0 { return }
    const directory = text_io.directory(image_module.pathOf(doc.?.*.image))
    _ = filedialog.save(app, state.tr(app, "Export Image", "Bild exportieren"), directory, proposedName(files.?, doc.?, extensionOf(files.?.*.filterFormats[0])), filters, exported)
}

fn doRevert(app: *App) -> void {
    const files = filesOf(app)
    if files == null { return }
    const doc = documentAt(app, files.?.*.revertTarget)
    if doc == null { return }
    const path = image_module.pathOf(doc.?.*.image)
    var result: formats.LoadResult = undefined
    const status = formats.load(app.*.allocator, path, &result)
    if status != formats.Status.ok {
        failed(app, state.tr(app, "Revert", "Zurücksetzen"), status, path)
        return
    }
    if @intFromPtr(doc.?) == @intFromPtr(api.document(app).?) { settleTool(app) }
    canvasview.forget(app, doc.?)
    image_module.destroy(doc.?.*.image)
    takeUndoSteps(app, result.image.?)
    doc.?.*.image = result.image.?
    doc.?.*.format = @intCast(u8, result.format)
    documents.markSaved(doc.?)
    autosave.forget(app, doc.?)
    api.sayWith(app, state.tr(app, "Reverted to the file: ", "Auf die Datei zurückgesetzt: "), documents.nameOf(doc.?), false)
    api.layersChanged(app)
}

fn revert(app: *App) -> void {
    const files = filesOf(app)
    const doc = api.document(app)
    if files == null || doc == null { return }
    endChain(files.?)
    files.?.*.revertTarget = @intFromPtr(doc.?)
    if !documents.isModified(doc.?) {
        doRevert(app)
        return
    }
    const text = joined(files.?, state.tr(app, "The changes made to \xE2\x80\x9C", "Die Änderungen an \xE2\x80\x9E"), documents.nameOf(doc.?), state.tr(app, "\xE2\x80\x9D since it was saved are lost.", "\xE2\x80\x9C seit dem Speichern gehen verloren."))
    _ = dialogs.confirm(app, state.tr(app, "Revert to Saved", "Auf Gespeichertes zurücksetzen"), text, state.tr(app, "Revert", "Zurücksetzen"), state.tr(app, "Cancel", "Abbrechen"), doRevert, null)
}

fn close(app: *App) -> void { startClosing(app, CLOSE_ONE) }
fn closeAll(app: *App) -> void { startClosing(app, CLOSE_ALL) }
fn quit(app: *App) -> void { startClosing(app, CLOSE_QUIT) }

fn clearRecent(app: *App) -> void {
    _ = recent.clear(app)
}

fn hasFile(app: *App) -> bool {
    const doc = api.document(app)
    return doc != null && image_module.pathOf(doc.?.*.image).length > 0
}

fn hasRecent(app: *App) -> bool { return recent.count(app) > 0 }

// ---------------------------------------------------------------------------
// Document Information

// The bytes the pixels of `node` and everything under it take (shared
// tiles counted whole).
fn bytesUnder(node: *Node) -> usize {
    var total: usize = 0
    if node.*.device != null { total += device_module.bytes(node.*.device.?) }
    for child in node.*.children.items() {
        total += bytesUnder(child)
    }
    return total
}

fn layersUnder(node: *Node, masks: *usize) -> usize {
    var layers: usize = 0
    for child in node.*.children.items() {
        if node_module.isMask(child.*.kind) { masks.* += 1 } else { layers += 1 }
        layers += layersUnder(child, masks)
    }
    return layers
}

fn infoRow(files: *Files, row: usize) -> [*]u8 {
    return &files.*.info[row]
}

fn infoText(files: *Files, row: usize) -> []const u8 {
    const bytes: [*]const u8 = &files.*.info[row]
    return bytes[0..files.*.infoLengths[row]]
}

// A number with `decimals` (a decimal comma in German) at `at`.
fn appendNumber(app: *App, into: [*]u8, at: usize, value: f64, decimals: usize) -> usize {
    var digits: [32]u8 = undefined
    const bytes: [*]u8 = &digits
    const count = kit_module.formatNumber(value, decimals, bytes)
    var length = at
    var index: usize = 0
    while index < count {
        const byte = if app.*.german && bytes[index] == 46 { 44 } else { bytes[index] }
        length = std.text.appendByte(into, length, INFO_TEXT, byte)
        index += 1
    }
    return length
}

// The values the dialog shows, written anew each frame (the document may
// change under it: it is a dialog over the window).
fn fillInfo(app: *App, files: *Files, doc: *Document) -> void {
    const image = doc.*.image
    var row = infoRow(files, 0)
    files.*.infoLengths[0] = std.text.append(row, 0, INFO_TEXT, documents.nameOf(doc))
    row = infoRow(files, 1)
    const path = image_module.pathOf(image)
    const info = formats.find(@intCast(u16, doc.*.format))
    var length: usize = 0
    if path.length == 0 {
        length = std.text.append(row, 0, INFO_TEXT, state.tr(app, "Not saved yet", "Noch nicht gespeichert"))
    } else if info != null {
        length = std.text.append(row, 0, INFO_TEXT, state.tr(app, info.?.*.name, info.?.*.german))
    }
    files.*.infoLengths[1] = length
    row = infoRow(files, 2)
    length = std.text.appendUnsigned(row, 0, INFO_TEXT, @intCast(usize, image.*.width))
    length = std.text.append(row, length, INFO_TEXT, " \xC3\x97 ")
    length = std.text.appendUnsigned(row, length, INFO_TEXT, @intCast(usize, image.*.height))
    length = std.text.append(row, length, INFO_TEXT, state.tr(app, " pixels", " Pixel"))
    files.*.infoLengths[2] = length
    row = infoRow(files, 3)
    const resolution = if image.*.resolution >= 1.0 { image.*.resolution } else { 72.0 }
    length = appendNumber(app, row, 0, resolution, 0)
    length = std.text.append(row, length, INFO_TEXT, " ppi  (")
    length = appendNumber(app, row, length, @floatFromInt(f64, image.*.width) / resolution * 25.4, 1)
    length = std.text.append(row, length, INFO_TEXT, " \xC3\x97 ")
    length = appendNumber(app, row, length, @floatFromInt(f64, image.*.height) / resolution * 25.4, 1)
    length = std.text.append(row, length, INFO_TEXT, " mm)")
    files.*.infoLengths[3] = length
    row = infoRow(files, 4)
    var masks: usize = 0
    const layers = layersUnder(image.*.root, &masks)
    length = std.text.appendUnsigned(row, 0, INFO_TEXT, layers)
    length = std.text.append(row, length, INFO_TEXT, if layers == 1 { state.tr(app, " layer", " Ebene") } else { state.tr(app, " layers", " Ebenen") })
    if masks > 0 {
        length = std.text.append(row, length, INFO_TEXT, ", ")
        length = std.text.appendUnsigned(row, length, INFO_TEXT, masks)
        length = std.text.append(row, length, INFO_TEXT, if masks == 1 { state.tr(app, " mask", " Maske") } else { state.tr(app, " masks", " Masken") })
    }
    files.*.infoLengths[4] = length
    row = infoRow(files, 5)
    const bytes = bytesUnder(image.*.root) + device_module.bytes(image.*.projection) + device_module.bytes(image.*.selection)
    length = appendNumber(app, row, 0, @floatFromInt(f64, bytes) / 1048576.0, 1)
    length = std.text.append(row, length, INFO_TEXT, state.tr(app, " MiB of pixels", " MiB an Pixeln"))
    files.*.infoLengths[5] = length
    row = infoRow(files, 6)
    length = std.text.appendUnsigned(row, 0, INFO_TEXT, history_module.stepsDone(image.*.history))
    length = std.text.append(row, length, INFO_TEXT, state.tr(app, " to undo, ", " rückgängig, "))
    length = std.text.appendUnsigned(row, length, INFO_TEXT, history_module.stepCount(image.*.history) - history_module.stepsDone(image.*.history))
    length = std.text.append(row, length, INFO_TEXT, state.tr(app, " to redo", " wiederholbar"))
    files.*.infoLengths[6] = length
    row = infoRow(files, 7)
    files.*.infoLengths[7] = std.text.append(row, 0, INFO_TEXT, if documents.isModified(doc) { state.tr(app, "Changed since it was saved", "Seit dem Speichern geändert") } else { state.tr(app, "As saved", "Wie gespeichert") })
}

// `text` as it fits `width` pixels in the small font: whole, or "…" and
// as much of its end as fits (into files.text).
fn tailOf(app: *App, files: *Files, text: []const u8, width: i32) -> []const u8 {
    const font = state.smallOf(app)
    if text_module.measure(font, text) <= width { return text }
    const bytes: [*]u8 = &files.*.text
    // The first place from which "…" and the rest fit (the width falls as
    // the place moves on: halved each time).
    var low: usize = 0
    var high = text.length
    while low < high {
        const middle = (low + high) / 2
        var length = std.text.append(bytes, 0, ROOM, "\xE2\x80\xA6")
        length = std.text.append(bytes, length, ROOM, text[middle..])
        if text_module.measure(font, textOf(files, length)) <= width { high = middle } else { low = middle + 1 }
    }
    // (Not inside a character.)
    var start = low
    while start < text.length && text[start] & 192 == 128 { start += 1 }
    var length = std.text.append(bytes, 0, ROOM, "\xE2\x80\xA6")
    length = std.text.append(bytes, length, ROOM, text[start..])
    return textOf(files, length)
}

fn infoLabel(app: *App, row: usize) -> []const u8 {
    if row == 0 { return "Name" }
    if row == 1 { return state.tr(app, "Format", "Format") }
    if row == 2 { return state.tr(app, "Size", "Größe") }
    if row == 3 { return state.tr(app, "Resolution", "Auflösung") }
    if row == 4 { return state.tr(app, "Layers", "Ebenen") }
    if row == 5 { return state.tr(app, "Memory", "Speicher") }
    if row == 6 { return state.tr(app, "History", "Verlauf") }
    return state.tr(app, "State", "Zustand")
}

fn drawInfo(app: *App, level: usize, window: ui.Rect) -> void {
    const files = filesOf(app)
    if files == null { return }
    const f = files.?
    const doc = documentAt(app, f.*.infoTarget)
    if doc == null {
        dialogs.close(app, level, dialogs.CANCEL)
        return
    }
    const kit = api.kit(app)
    const scale = state.themeOf(app).*.scale
    const rows = @intCast(i32, INFO_ROWS) + 1
    const natural = rows * (dialogs.ROW + dialogs.GAP) * scale
    var content = dialogs.frame(app, window, state.tr(app, "Document Information", "Dokumentinformationen"), 480 * scale, dialogs.framed(app, natural))
    const labels: [*][]const u8 = &f.*.labels
    labels[0] = state.tr(app, "Close", "Schließen")
    const clicked = dialogs.buttons(app, &content, labels[0..1], 0)
    fillInfo(app, f, doc.?)
    var area = dialogs.scrollBegin(app, content, natural)
    var row: usize = 0
    while row < INFO_ROWS {
        const field = dialogs.labelled(app, &area, infoLabel(app, row), dialogs.ROW * scale)
        kit_module.label(kit, field, infoText(f, row), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
        // The file's path under the format, dim (cut at the left when it
        // is long: its end names the file).
        if row == 1 {
            const below = dialogs.labelled(app, &area, state.tr(app, "File", "Datei"), dialogs.ROW * scale)
            const path = image_module.pathOf(doc.?.*.image)
            kit_module.label(kit, below, if path.length > 0 { tailOf(app, f, path, below.width) } else { "\xE2\x80\x94" }, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        }
        row += 1
    }
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, clicked.?) }
}

fn finishInfo(app: *App, level: usize, answer: usize) -> void {}

fn documentInfo(app: *App) -> void {
    const files = filesOf(app)
    const doc = api.document(app)
    if files == null || doc == null { return }
    files.?.*.infoTarget = @intFromPtr(doc.?)
    const hooks = dialogs.Hooks.{ .kind = KIND_INFO, .draw = drawInfo, .key = null, .finish = finishInfo, .tabs = true, .closable = true }
    _ = dialogs.host(app, hooks, 16)
}

// ---------------------------------------------------------------------------
// The table

const RECENT_MENU: []const u8 = "Open Recent|Zuletzt geöffnet"

const ACTIONS = [12]state.Action{
    state.Action.{ .key = "file_new", .name = "New\xE2\x80\xA6", .german = "Neu\xE2\x80\xA6", .shortcut = "Ctrl+N", .menu = state.MENU_FILE, .submenu = "", .flags = 0, .run = newImage, .checked = null, .enabled = null },
    state.Action.{ .key = "file_open", .name = "Open\xE2\x80\xA6", .german = "Öffnen\xE2\x80\xA6", .shortcut = "Ctrl+O", .menu = state.MENU_FILE, .submenu = "", .flags = 0, .run = open, .checked = null, .enabled = null },
    state.Action.{ .key = "file_clear_recent", .name = "Clear the List", .german = "Liste leeren", .shortcut = "", .menu = state.MENU_FILE, .submenu = RECENT_MENU, .flags = 0, .run = clearRecent, .checked = null, .enabled = hasRecent },
    state.Action.{ .key = "file_save", .name = "Save", .german = "Speichern", .shortcut = "Ctrl+S", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_SEPARATOR_BEFORE | state.ACTION_NEEDS_DOCUMENT, .run = save, .checked = null, .enabled = null },
    state.Action.{ .key = "file_save_as", .name = "Save As\xE2\x80\xA6", .german = "Speichern unter\xE2\x80\xA6", .shortcut = "Ctrl+Shift+S", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_NEEDS_DOCUMENT, .run = saveAs, .checked = null, .enabled = null },
    state.Action.{ .key = "file_save_incremental", .name = "Save Incremental Version", .german = "Inkrementelle Version speichern", .shortcut = "Ctrl+Alt+S", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_NEEDS_DOCUMENT, .run = saveIncremental, .checked = null, .enabled = hasFile },
    state.Action.{ .key = "file_export", .name = "Export\xE2\x80\xA6", .german = "Exportieren\xE2\x80\xA6", .shortcut = "", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_NEEDS_DOCUMENT, .run = exportImage, .checked = null, .enabled = null },
    state.Action.{ .key = "file_revert", .name = "Revert", .german = "Zurücksetzen", .shortcut = "", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_NEEDS_DOCUMENT, .run = revert, .checked = null, .enabled = hasFile },
    state.Action.{ .key = "file_document_info", .name = "Document Information\xE2\x80\xA6", .german = "Dokumentinformationen\xE2\x80\xA6", .shortcut = "", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_SEPARATOR_BEFORE | state.ACTION_NEEDS_DOCUMENT, .run = documentInfo, .checked = null, .enabled = null },
    state.Action.{ .key = "file_close", .name = "Close", .german = "Schließen", .shortcut = "Ctrl+W", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_SEPARATOR_BEFORE | state.ACTION_NEEDS_DOCUMENT, .run = close, .checked = null, .enabled = null },
    state.Action.{ .key = "file_close_all", .name = "Close All", .german = "Alle schließen", .shortcut = "Ctrl+Shift+W", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_NEEDS_DOCUMENT, .run = closeAll, .checked = null, .enabled = null },
    state.Action.{ .key = "file_quit", .name = "Quit", .german = "Beenden", .shortcut = "Ctrl+Q", .menu = state.MENU_FILE, .submenu = "", .flags = state.ACTION_SEPARATOR_BEFORE, .run = quit, .checked = null, .enabled = null },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The File menu's actions, in the menu's order.
pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

// ---------------------------------------------------------------------------
// The files used last (a submenu of sources)

// The recent files that are there now, counted (the menu asks first, then
// names them one after the other: the places found here serve those).
fn recentCount(app: *App) -> usize {
    const files = filesOf(app)
    if files == null { return 0 }
    const f = files.?
    f.*.recentCount = 0
    const total = recent.count(app)
    var index: usize = 0
    while index < total && f.*.recentCount < recent.MOST {
        if recent.exists(app, index) {
            f.*.recentPlaces[f.*.recentCount] = index
            f.*.recentCount += 1
        }
        index += 1
    }
    return f.*.recentCount
}

// "picture.png   ~/Pictures": the name, then its folder (the home as ~,
// a deep one by its last two parts: "…/work/scans"; a menu row is not
// wide).
fn recentName(app: *App, index: usize) -> []const u8 {
    const files = filesOf(app)
    if files == null || index >= files.?.*.recentCount { return "" }
    const f = files.?
    const path = recent.at(app, f.*.recentPlaces[index])
    const bytes: [*]u8 = &f.*.text
    var length = std.text.append(bytes, 0, ROOM, text_io.baseName(path))
    length = std.text.append(bytes, length, ROOM, "   ")
    var folder = text_io.directory(path)
    const home = shell_module.home(app.*.shell)
    var start: []const u8 = ""
    if home.length > 1 && std.text.startsWith(folder, home) && (folder.length == home.length || folder[home.length] == 47) {
        start = "~"
        folder = folder[home.length..]
    }
    // Where the last two parts begin.
    var cut = folder.length
    var slashes: usize = 0
    while cut > 0 && slashes < 2 {
        cut -= 1
        if folder[cut] == 47 { slashes += 1 }
    }
    if slashes == 2 && cut > 0 {
        start = "\xE2\x80\xA6"
        folder = folder[cut..]
    }
    length = std.text.append(bytes, length, ROOM, start)
    length = std.text.append(bytes, length, ROOM, folder)
    return textOf(f, length)
}

fn openRecent(app: *App, index: usize) -> void {
    const files = filesOf(app)
    if files == null || index >= files.?.*.recentCount { return }
    const path = recent.at(app, files.?.*.recentPlaces[index])
    const bytes: [*]u8 = &files.?.*.chosen
    const length = std.text.append(bytes, 0, PATH, path)
    if length == path.length { _ = openPath(app, bytes[0..length]) }
}

const SOURCES = [1]state.MenuSource{
    state.MenuSource.{ .menu = state.MENU_FILE, .submenu = RECENT_MENU, .flags = state.ACTION_SEPARATOR_BEFORE, .count = recentCount, .name = recentName, .run = openRecent, .checked = null, .enabled = null },
}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The File menu's entries that are not fixed: the recent files.
pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
