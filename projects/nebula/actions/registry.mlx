// nebula actions: the list of what a menu entry, a shortcut or a button
// does. Each module has a table of state.Action and hands it out with
// list(); here they are put together, in the order the menus show them.
const state = @import("../app/state.mlx")
const file_module = @import("./file.mlx")
const edit_module = @import("./edit.mlx")
const view_module = @import("./view.mlx")
const image_module = @import("./image.mlx")
const layer_module = @import("./layer.mlx")
const select_module = @import("./select.mlx")
const filter_module = @import("./filter.mlx")
const tools_module = @import("./tools.mlx")
const settings_module = @import("./settings.mlx")
const help_module = @import("./help.mlx")

pub const Action = state.Action

const MODULES: usize = 10

fn listOf(module: usize) -> []const Action {
    if module == 0 { return file_module.list() }
    if module == 1 { return edit_module.list() }
    if module == 2 { return view_module.list() }
    if module == 3 { return image_module.list() }
    if module == 4 { return layer_module.list() }
    if module == 5 { return select_module.list() }
    if module == 6 { return filter_module.list() }
    if module == 7 { return tools_module.list() }
    if module == 8 { return settings_module.list() }
    return help_module.list()
}

// How many there are, and the one at a place in the list (in the modules'
// order).
pub fn count() -> usize {
    var total: usize = 0
    var module: usize = 0
    while module < MODULES {
        total += listOf(module).length
        module += 1
    }
    return total
}

pub fn at(index: usize) -> ?*const Action {
    var left = index
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        if left < list.length { return &list[left] }
        left -= list.length
        module += 1
    }
    return null
}

fn sameText(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if left[index] != right[index] { return false }
        index += 1
    }
    return true
}

// The one named `key` (null: there is none).
pub fn byKey(key: []const u8) -> ?*const Action {
    const all = count()
    var index: usize = 0
    while index < all {
        const found = at(index)
        if found != null && sameText(found.?.*.key, key) { return found }
        index += 1
    }
    return null
}
