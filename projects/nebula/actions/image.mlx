// nebula actions: the Image menu: what is done to the whole picture: its
// properties (the document's name, the resolution), its size (Scale
// Image resamples every layer, Resize Canvas moves them in a larger or
// smaller canvas), quarter and free turns, mirroring, cropping to the
// selection or to a layer, wrapping all layers around their edges
// (Offset) and flattening it into one layer. However many layers the
// image has, each is one step of the history.
//
// The same geometry serves the Layer menu (actions/layer.mlx): a Job says
// what happens to a device (resampled by a matrix, mirrored or turned
// exactly, moved, wrapped, cropped) and onTree() does it to a node and
// everything under it, each device between ops.beginPixels and
// endPixels, so that one history step holds all of them:
//
//     const before = image_actions.beginStep(image, name)
//     var job = image_actions.flipJob(true, image_module.bounds(image))
//     const done = image_actions.onTree(image, node, &job, name)
//     _ = image_actions.endStep(app, image, before, done)
//
// A clone layer's device is only its place against what it shows: a job
// moves that place as the clone's source moves (mirrored, turned and
// scaled with it; left where it is when everything moves by a whole
// number of pixels, because its source moves too). When memory runs out
// halfway, endStep() takes back what was done of the step, so the image
// is as it was (the step stays to be redone: core/history.mlx has no way
// to forget it).
//
// The dialogs (Image Properties, Scale, Resize Canvas, Rotate, Offset)
// are dialogs.host() bodies drawn with the kit; Scale, Rotate and Offset
// also ask for a layer (askScale(app, node), ...): then they change only
// that node and what is under it.
//
// Not done: the image has no background colour of its own to set
// (core/image.mlx keeps none: the projection is transparent where no
// layer covers it); a vector or file layer's shapes or file are not
// transformed with its pixels (their modules make the pixels again from
// what they keep), nor are a fill layer's numbers (a gradient stays
// where its numbers put it on the image); Offset leaves the selection
// where it is.
const std = @import("std")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const kit_module = @import("../ui/kit.mlx")
const icons = @import("../ui/icons.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const device_module = @import("../core/device.mlx")
const history_module = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const render = @import("../core/render.mlx")
const transform = @import("../core/transform.mlx")
const selection_module = @import("../core/selection.mlx")

pub const App = state.App
pub const Image = image_module.Image
pub const Node = node_module.Node
pub const Device = device_module.Device
pub const Rect = geom.Rect

// ---------------------------------------------------------------------------
// Steps

// The image in front when an action may change it now: null when there
// is none, or while the tool in use is in the middle of something (the
// status bar says so).
pub fn imageReady(app: *App) -> ?*Image {
    const picture = api.image(app)
    if picture == null { return null }
    if api.toolBusy(app) || picture.?.*.history.*.depth > 0 {
        api.say(app, state.tr(app, "Finish what the tool is doing first", "Erst beenden, was das Werkzeug gerade tut"), true)
        return null
    }
    return picture
}

// Opens one step of the history called `name`; what it hands back is for
// endStep().
pub fn beginStep(image: *Image, name: []const u8) -> u32 {
    const before = history_module.position(image.*.history)
    history_module.begin(image.*.history, name)
    return before
}

// Closes the step beginStep() opened. Without `done` (memory ran out)
// what was recorded of it is taken back and the status bar says so.
// Returns `done`.
pub fn endStep(app: *App, image: *Image, before: u32, done: bool) -> bool {
    history_module.end(image.*.history)
    if done { return true }
    if history_module.position(image.*.history) != before { _ = history_module.undo(image.*.history, image) }
    return noMemory(app)
}

// The status bar says memory ran out; false.
pub fn noMemory(app: *App) -> bool {
    api.say(app, state.tr(app, "There was not enough memory: nothing was changed", "Der Speicher reichte nicht: nichts wurde geändert"), true)
    return false
}

// ---------------------------------------------------------------------------
// Jobs: what happens to every device of a tree

// Resampled by `matrix` with `filter` (core/transform.mlx).
pub const JOB_MATRIX: u8 = 0
// Mirrored about the upright or the level middle line of `about`.
pub const JOB_FLIP_H: u8 = 1
pub const JOB_FLIP_V: u8 = 2
// Turned a quarter clockwise, half, or a quarter anticlockwise about
// `about` (transform.rotate90 ...), then moved by (dx, dy).
pub const JOB_TURN_90: u8 = 3
pub const JOB_TURN_180: u8 = 4
pub const JOB_TURN_270: u8 = 5
// Moved by (dx, dy).
pub const JOB_MOVE: u8 = 6
// The pixels of `about` pushed by (dx, dy), what leaves it on one side
// coming in on the other.
pub const JOB_WRAP: u8 = 7
// Moved by (dx, dy), and what then lies outside `keep` is the default.
pub const JOB_CROP: u8 = 8

pub const Job = struct {
    kind: u8
    matrix: transform.Matrix
    filter: u8
    about: Rect
    dx: i32
    dy: i32
    keep: Rect
}

fn blankJob(kind: u8) -> Job {
    return Job.{ .kind = kind, .matrix = transform.identity(), .filter = transform.BICUBIC, .about = geom.empty(), .dx = 0, .dy = 0, .keep = geom.empty() }
}

// Every device resampled by `matrix` with `filter`.
pub fn matrixJob(matrix: transform.Matrix, filter: u8) -> Job {
    var job = blankJob(JOB_MATRIX)
    job.matrix = matrix
    job.filter = filter
    return job
}

// Every device mirrored left to right (`horizontal`) or top to bottom
// about the middle of `about`.
pub fn flipJob(horizontal: bool, about: Rect) -> Job {
    var job = blankJob(if horizontal { JOB_FLIP_H } else { JOB_FLIP_V })
    job.about = about
    return job
}

// `turns` quarter turns clockwise (1, 2 or 3) about `about`, then moved
// by (dx, dy).
pub fn turnJob(turns: u32, about: Rect, dx: i32, dy: i32) -> Job {
    const kind = if turns == 1 { JOB_TURN_90 } else if turns == 2 { JOB_TURN_180 } else { JOB_TURN_270 }
    var job = blankJob(kind)
    job.about = about
    job.dx = dx
    job.dy = dy
    return job
}

// Every device moved by (dx, dy).
pub fn moveJob(dx: i32, dy: i32) -> Job {
    var job = blankJob(JOB_MOVE)
    job.dx = dx
    job.dy = dy
    return job
}

// The pixels of `about` in every device pushed by (dx, dy) around its
// edges.
pub fn wrapJob(about: Rect, dx: i32, dy: i32) -> Job {
    var job = blankJob(JOB_WRAP)
    job.about = about
    job.dx = dx
    job.dy = dy
    return job
}

// Every device moved by (dx, dy), what then lies outside `keep` cleared.
pub fn cropJob(dx: i32, dy: i32, keep: Rect) -> Job {
    var job = blankJob(JOB_CROP)
    job.dx = dx
    job.dy = dy
    job.keep = keep
    return job
}

// A device's place moved by (dx, dy), within the room its arithmetic has
// (2^30 from the origin). False when it would leave it.
fn moved(device: *Device, dx: i32, dy: i32) -> bool {
    const x = @intCast(i64, device.*.x) + @intCast(i64, dx)
    const y = @intCast(i64, device.*.y) + @intCast(i64, dy)
    if x < -1073741824 || x > 1073741824 || y < -1073741824 || y > 1073741824 { return false }
    device_module.moveBy(device, dx, dy)
    return true
}

// What lies outside `keep` becomes the device's default. False without
// memory.
fn cropOutside(device: *Device, keep: Rect) -> bool {
    const all = device_module.extent(device)
    if geom.isEmpty(all) { return true }
    const blank = device.*.defaultPixel
    var done = true
    if keep.y > all.y { done = done && device_module.fill(device, geom.rect(all.x, all.y, all.width, keep.y - all.y), blank) }
    if geom.bottom(all) > geom.bottom(keep) { done = done && device_module.fill(device, geom.rect(all.x, geom.bottom(keep), all.width, geom.bottom(all) - geom.bottom(keep)), blank) }
    if keep.x > all.x { done = done && device_module.fill(device, geom.rect(all.x, keep.y, keep.x - all.x, keep.height), blank) }
    if geom.right(all) > geom.right(keep) { done = done && device_module.fill(device, geom.rect(geom.right(keep), keep.y, geom.right(all) - geom.right(keep), keep.height), blank) }
    return done
}

// The job done to one device. False when it could not be (memory, or a
// place beyond what a device reaches): the device may be changed in part
// then, and whoever began its change rolls it back.
pub fn onDevice(device: *Device, job: *const Job) -> bool {
    const kind = job.*.kind
    if kind == JOB_MATRIX {
        const m = &job.*.matrix
        // (Nothing to do: transformDevice would say nothing changed, as
        // it says when it fails.)
        if transform.isTranslation(m) && m.*.c == 0.0 && m.*.f == 0.0 { return true }
        if geom.isEmpty(device_module.exactBounds(device)) { return true }
        return !geom.isEmpty(transform.transformDevice(device, m, job.*.filter))
    }
    if kind == JOB_FLIP_H { return transform.flipHorizontal(device, job.*.about) }
    if kind == JOB_FLIP_V { return transform.flipVertical(device, job.*.about) }
    if kind == JOB_TURN_90 || kind == JOB_TURN_180 || kind == JOB_TURN_270 {
        var turned = false
        if kind == JOB_TURN_90 {
            turned = transform.rotate90(device, job.*.about)
        } else if kind == JOB_TURN_180 {
            turned = transform.rotate180(device, job.*.about)
        } else {
            turned = transform.rotate270(device, job.*.about)
        }
        return turned && moved(device, job.*.dx, job.*.dy)
    }
    if kind == JOB_MOVE { return moved(device, job.*.dx, job.*.dy) }
    if kind == JOB_WRAP { return transform.offset(device, job.*.about, job.*.dx, job.*.dy) }
    if kind == JOB_CROP { return moved(device, job.*.dx, job.*.dy) && cropOutside(device, job.*.keep) }
    return true
}

fn rounded(value: f64) -> i32 {
    if !(value > -1073741824.0) { return -1073741824 }
    if !(value < 1073741824.0) { return 1073741824 }
    return @intFromFloat(i32, @floor(value + 0.5))
}

// Where a clone sits against what it shows after the job (the job's
// linear part applied to that offset; a move leaves it).
fn clonePlace(job: *const Job, x: i32, y: i32, into_x: *i32, into_y: *i32) -> void {
    const kind = job.*.kind
    into_x.* = x
    into_y.* = y
    if kind == JOB_MATRIX {
        const m = &job.*.matrix
        const w = if m.*.i != 0.0 { m.*.i } else { 1.0 }
        const fx = @floatFromInt(f64, x)
        const fy = @floatFromInt(f64, y)
        into_x.* = rounded((m.*.a * fx + m.*.b * fy) / w)
        into_y.* = rounded((m.*.d * fx + m.*.e * fy) / w)
    } else if kind == JOB_FLIP_H {
        into_x.* = -x
    } else if kind == JOB_FLIP_V {
        into_y.* = -y
    } else if kind == JOB_TURN_90 {
        into_x.* = -y
        into_y.* = x
    } else if kind == JOB_TURN_180 {
        into_x.* = -x
        into_y.* = -y
    } else if kind == JOB_TURN_270 {
        into_x.* = y
        into_y.* = -x
    }
}

// The job done to one node's device, as one change of its pixels (a
// part of the step that is open). False when it could not be done (the
// node is as it was).
pub fn onNode(image: *Image, node: *Node, job: *const Job, name: []const u8) -> bool {
    if node.*.device == null { return true }
    const device = node.*.device.?
    if !ops.beginPixels(image, node) { return true }
    var done = true
    if node.*.kind == node_module.CLONE {
        var x: i32 = 0
        var y: i32 = 0
        clonePlace(job, device.*.x, device.*.y, &x, &y)
        device_module.moveTo(device, x, y)
    } else {
        done = onDevice(device, job)
    }
    if !done {
        _ = ops.cancelPixels(image, node)
        return false
    }
    _ = ops.endPixels(image, node, name)
    return true
}

// The job done to `node` and everything under it. False when memory ran
// out (what was done is recorded: endStep takes it back).
pub fn onTree(image: *Image, node: *Node, job: *const Job, name: []const u8) -> bool {
    if !onNode(image, node, job, name) { return false }
    for child in node.*.children.items() {
        if !onTree(image, child, job, name) { return false }
    }
    return true
}

// The job done to the selection too (when there is one), which is then
// held to `inside` (the image's rectangle after the job). False without
// memory.
pub fn onSelection(image: *Image, job: *const Job, inside: Rect, name: []const u8) -> bool {
    if !image.*.selected { return true }
    ops.beginSelection(image)
    var done = onDevice(image.*.selection, job)
    if done { done = selection_module.clip(image.*.selection, inside) }
    if !done {
        ops.cancelSelection(image)
        return false
    }
    ops.endSelection(image, true, name)
    return true
}

// The image's size and resolution change, recorded in the open step;
// whoever shows the image starts over.
fn resized(image: *Image, width: i32, height: i32, resolution: f64, name: []const u8) -> void {
    history_module.geometry(image.*.history, name, image.*.width, image.*.height, image.*.resolution, width, height, resolution)
    image.*.width = width
    image.*.height = height
    image.*.resolution = resolution
    device_module.clear(image.*.projection)
    image_module.damageAll(image)
    // (As core/history.mlx does for a size undone: more than the sixteen
    // updates a viewer can catch up with, so it composes everything.)
    image.*.updateSerial += 17
    image_module.touch(image)
}

// After the image's size changed: its middle in the middle of the view.
fn recentred(app: *App) -> void {
    const doc = api.document(app)
    if doc == null { return }
    doc.?.*.view.centerX = @floatFromInt(f64, doc.?.*.image.*.width) / 2.0
    doc.?.*.view.centerY = @floatFromInt(f64, doc.?.*.image.*.height) / 2.0
    api.layersChanged(app)
}

fn sizeFits(width: i32, height: i32) -> bool {
    return width >= 1 && height >= 1 && width <= image_module.LARGEST && height <= image_module.LARGEST
}

fn badSize(app: *App) -> bool {
    api.say(app, state.tr(app, "A side must be 1 to 32768 pixels long", "Eine Seite muss 1 bis 32768 Pixel lang sein"), true)
    return false
}

// ---------------------------------------------------------------------------
// The image's size, turns and mirrors

// Every layer and mask (and the selection) resampled with `filter` so
// that the image becomes `width` x `height` pixels, at `resolution`
// pixels an inch. True when it was done (or nothing was to be done).
pub fn scaleImage(app: *App, width: i32, height: i32, resolution: f64, filter: u8) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    if !sizeFits(width, height) { return badSize(app) }
    const ppi = if resolution >= 1.0 { resolution } else { image.*.resolution }
    if width == image.*.width && height == image.*.height && ppi == image.*.resolution { return true }
    const name = state.tr(app, "Scale image", "Bild skalieren")
    const before = beginStep(image, name)
    var done = true
    if width != image.*.width || height != image.*.height {
        const sx = @floatFromInt(f64, width) / @floatFromInt(f64, image.*.width)
        const sy = @floatFromInt(f64, height) / @floatFromInt(f64, image.*.height)
        const job = matrixJob(transform.scaling(sx, sy, 0.0, 0.0), filter)
        done = onTree(image, image.*.root, &job, name) && onSelection(image, &job, geom.rect(0, 0, width, height), name)
    }
    if done { resized(image, width, height, ppi, name) }
    if !endStep(app, image, before, done) { return false }
    recentred(app)
    return true
}

// The image becomes `width` x `height`, its layers (and the selection)
// moved by (dx, dy): where the old image's top left corner lies in the
// new one. Pixels are not changed; what lies outside the new canvas is
// kept (layers have no edges).
pub fn resizeCanvas(app: *App, width: i32, height: i32, dx: i32, dy: i32) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    if !sizeFits(width, height) { return badSize(app) }
    if width == image.*.width && height == image.*.height && dx == 0 && dy == 0 { return true }
    const name = state.tr(app, "Resize canvas", "Arbeitsfläche ändern")
    const before = beginStep(image, name)
    const job = moveJob(dx, dy)
    const done = (dx == 0 && dy == 0) || (onTree(image, image.*.root, &job, name) && onSelection(image, &job, geom.rect(0, 0, width, height), name))
    if done { resized(image, width, height, image.*.resolution, name) }
    if !endStep(app, image, before, done) { return false }
    recentred(app)
    return true
}

// Where the old image's corner goes along one side for an anchor column
// or row (0: the start, 1: the middle, 2: the end).
pub fn anchorOffset(old_size: i32, new_size: i32, place: u32) -> i32 {
    if place == 0 { return 0 }
    if place == 1 { return (new_size - old_size) / 2 }
    return new_size - old_size
}

// The image turned `turns` quarters clockwise (1, 2, 3), exactly.
pub fn rotateImage90(app: *App, turns: u32) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    const quarter = turns % 4
    if quarter == 0 { return true }
    const name = if quarter == 2 { state.tr(app, "Rotate image 180°", "Bild um 180° drehen") } else if quarter == 1 { state.tr(app, "Rotate image 90° clockwise", "Bild um 90° im Uhrzeigersinn drehen") } else { state.tr(app, "Rotate image 90° counter-clockwise", "Bild um 90° gegen den Uhrzeigersinn drehen") }
    const width = if quarter == 2 { image.*.width } else { image.*.height }
    const height = if quarter == 2 { image.*.height } else { image.*.width }
    const before = beginStep(image, name)
    const job = turnJob(quarter, image_module.bounds(image), 0, 0)
    const done = onTree(image, image.*.root, &job, name) && onSelection(image, &job, geom.rect(0, 0, width, height), name)
    if done && quarter != 2 { resized(image, width, height, image.*.resolution, name) }
    if !endStep(app, image, before, done) { return false }
    recentred(app)
    return true
}

// Whole quarter turns of an angle in degrees (clockwise), or 4 when it
// is none (what is no number, or farther than ten turns, is no turn).
fn quarterOf(degrees: f64) -> u32 {
    if !(degrees > -3600.0 && degrees < 3600.0) { return 0 }
    var turned = degrees
    while turned < 0.0 { turned += 360.0 }
    while turned >= 360.0 { turned -= 360.0 }
    if turned == 0.0 { return 0 }
    if turned == 90.0 { return 1 }
    if turned == 180.0 { return 2 }
    if turned == 270.0 { return 3 }
    return 4
}

// The matrix that turns `area` by `degrees` about its middle and puts
// what comes of it at the origin, and the size that holds it.
fn turnAndPlace(area: Rect, degrees: f64, width: *i32, height: *i32) -> transform.Matrix {
    const cx = @floatFromInt(f64, area.x) + @floatFromInt(f64, area.width) / 2.0
    const cy = @floatFromInt(f64, area.y) + @floatFromInt(f64, area.height) / 2.0
    const turn = transform.rotation(degrees * 3.141592653589793 / 180.0, cx, cy)
    const lands = transform.mapRect(&turn, area)
    width.* = lands.width
    height.* = lands.height
    const shift = transform.translation(@floatFromInt(f64, -lands.x), @floatFromInt(f64, -lands.y))
    return transform.multiply(&shift, &turn)
}

// The image turned by `degrees` (clockwise), resampled with `filter`;
// the image grows to hold what is turned. Quarter turns are exact.
pub fn rotateImage(app: *App, degrees: f64, filter: u8) -> bool {
    if !(degrees > -3600.0 && degrees < 3600.0) { return false }
    const quarter = quarterOf(degrees)
    if quarter < 4 { return rotateImage90(app, quarter) }
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    var width: i32 = 0
    var height: i32 = 0
    const matrix = turnAndPlace(image_module.bounds(image), degrees, &width, &height)
    if !sizeFits(width, height) { return badSize(app) }
    const name = state.tr(app, "Rotate image", "Bild drehen")
    const before = beginStep(image, name)
    const job = matrixJob(matrix, filter)
    const done = onTree(image, image.*.root, &job, name) && onSelection(image, &job, geom.rect(0, 0, width, height), name)
    if done { resized(image, width, height, image.*.resolution, name) }
    if !endStep(app, image, before, done) { return false }
    recentred(app)
    return true
}

// Every layer (and the selection) mirrored left to right (`horizontal`)
// or top to bottom about the image's middle.
pub fn mirrorImage(app: *App, horizontal: bool) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    const name = if horizontal { state.tr(app, "Mirror image horizontally", "Bild horizontal spiegeln") } else { state.tr(app, "Mirror image vertically", "Bild vertikal spiegeln") }
    const before = beginStep(image, name)
    const job = flipJob(horizontal, image_module.bounds(image))
    const done = onTree(image, image.*.root, &job, name) && onSelection(image, &job, image_module.bounds(image), name)
    if !endStep(app, image, before, done) { return false }
    api.layersChanged(app)
    return true
}

// The image becomes `area` of itself: everything moved so that the
// area's corner is the origin, what lies outside it taken away. Called
// `name` in the history.
pub fn cropTo(app: *App, area: Rect, name: []const u8) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    if geom.isEmpty(area) { return false }
    if !sizeFits(area.width, area.height) { return badSize(app) }
    if geom.same(area, image_module.bounds(image)) { return true }
    const keep = geom.rect(0, 0, area.width, area.height)
    const before = beginStep(image, name)
    const job = cropJob(-area.x, -area.y, keep)
    const done = onTree(image, image.*.root, &job, name) && onSelection(image, &job, keep, name)
    if done { resized(image, area.width, area.height, image.*.resolution, name) }
    if !endStep(app, image, before, done) { return false }
    recentred(app)
    return true
}

// Crop to Selection: the image becomes the rectangle around what is
// selected (within it).
pub fn cropToSelection(app: *App) -> bool {
    const picture = api.image(app)
    if picture == null { return false }
    var area = geom.empty()
    if picture.?.*.selected { area = geom.intersect(selection_module.bounds(picture.?.*.selection), image_module.bounds(picture.?)) }
    if geom.isEmpty(area) {
        api.say(app, state.tr(app, "Nothing is selected", "Es ist nichts ausgewählt"), true)
        return false
    }
    return cropTo(app, area, state.tr(app, "Crop to selection", "Auf Auswahl zuschneiden"))
}

// The rectangle around what a node holds (its pixels that are not its
// device's default, and those of everything under it; a mask's own).
pub fn contentBounds(node: *Node) -> Rect {
    var area = geom.empty()
    if node.*.device != null && node.*.kind != node_module.CLONE { area = device_module.exactBounds(node.*.device.?) }
    for child in node.*.children.items() {
        if !node_module.isMask(child.*.kind) { area = geom.unite(area, contentBounds(child)) }
    }
    return area
}

// Trim to Layer: the image becomes the rectangle around what the active
// layer holds.
pub fn trimToLayer(app: *App) -> bool {
    const node = api.activeNode(app)
    if node == null { return false }
    const area = contentBounds(node_module.layerOf(node.?))
    if geom.isEmpty(area) {
        api.say(app, state.tr(app, "The layer is empty", "Die Ebene ist leer"), true)
        return false
    }
    return cropTo(app, area, state.tr(app, "Trim to layer", "Auf Ebene zuschneiden"))
}

// Every layer's pixels inside the image pushed by (dx, dy), wrapping
// around its edges.
pub fn offsetImage(app: *App, dx: i32, dy: i32) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    if dx % image.*.width == 0 && dy % image.*.height == 0 { return true }
    const name = state.tr(app, "Offset image", "Bild versetzen")
    const before = beginStep(image, name)
    const job = wrapJob(image_module.bounds(image), dx, dy)
    const done = onTree(image, image.*.root, &job, name)
    if !endStep(app, image, before, done) { return false }
    api.layersChanged(app)
    return true
}

// The resolution changed (and nothing else), one step.
pub fn setResolution(app: *App, resolution: f64) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    if !(resolution >= 1.0) || resolution == image.*.resolution { return true }
    const name = state.tr(app, "Image properties", "Bildeigenschaften")
    const before = beginStep(image, name)
    resized(image, image.*.width, image.*.height, resolution, name)
    return endStep(app, image, before, true)
}

// Flatten Image: all layers become one paint layer showing what they
// showed together (their projection, pixel for pixel).
pub fn flattenImage(app: *App) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    const root = image.*.root
    if node_module.childCount(root) == 0 { return false }
    _ = render.update(image)
    const made = node_module.create(image.*.allocator, node_module.PAINT, image_module.newId(image), state.tr(app, "Background", "Hintergrund"))
    if made == null { return noMemory(app) }
    const copied = device_module.copy(image.*.projection)
    if copied == null {
        node_module.destroy(made.?)
        return noMemory(app)
    }
    device_module.destroy(made.?.*.device.?)
    made.?.*.device = copied
    const name = state.tr(app, "Flatten image", "Bild verflachen")
    const before = beginStep(image, name)
    while node_module.childCount(root) > 0 {
        ops.remove(image, node_module.childAt(root, node_module.childCount(root) - 1), name)
    }
    const added = ops.add(image, made.?, root, 0, name)
    if !added { node_module.destroy(made.?) }
    if !endStep(app, image, before, added) { return false }
    api.layersChanged(app)
    return true
}

// ---------------------------------------------------------------------------
// Layers: the same jobs on the active node and what is under it

// The active node when its pixels may be changed: there is one and it
// is not locked (else the status bar says why).
pub fn changeableNode(app: *App) -> ?*Node {
    const node = api.activeNode(app)
    if node == null { return null }
    if node.?.*.locked {
        api.say(app, state.tr(app, "The layer is locked", "Die Ebene ist gesperrt"), true)
        return null
    }
    return node
}

fn onActive(app: *App, job: *const Job, name: []const u8) -> bool {
    const found = imageReady(app)
    if found == null { return false }
    const image = found.?
    const node = changeableNode(app)
    if node == null { return false }
    const before = beginStep(image, name)
    const done = onTree(image, node.?, job, name)
    if !endStep(app, image, before, done) { return false }
    api.layersChanged(app)
    return true
}

// The active layer mirrored about the image's middle.
pub fn mirrorLayer(app: *App, horizontal: bool) -> bool {
    const image = api.image(app)
    if image == null { return false }
    const job = flipJob(horizontal, image_module.bounds(image.?))
    return onActive(app, &job, if horizontal { state.tr(app, "Mirror layer horizontally", "Ebene horizontal spiegeln") } else { state.tr(app, "Mirror layer vertically", "Ebene vertikal spiegeln") })
}

// The active layer turned `turns` quarters clockwise about the image's
// middle (to a whole pixel: half a pixel off when width and height
// differ by an odd number).
pub fn rotateLayer90(app: *App, turns: u32) -> bool {
    const image = api.image(app)
    if image == null { return false }
    const quarter = turns % 4
    if quarter == 0 { return true }
    const width = image.?.*.width
    const height = image.?.*.height
    // A quarter turn about the image's rectangle puts it at the same
    // corner with its sides swapped: moved back so that its middle stays.
    var dx: i32 = 0
    var dy: i32 = 0
    if quarter != 2 {
        dx = (width - height) / 2
        dy = (height - width) / 2
    }
    const job = turnJob(quarter, image_module.bounds(image.?), dx, dy)
    const name = if quarter == 2 { state.tr(app, "Rotate layer 180°", "Ebene um 180° drehen") } else if quarter == 1 { state.tr(app, "Rotate layer 90° clockwise", "Ebene um 90° im Uhrzeigersinn drehen") } else { state.tr(app, "Rotate layer 90° counter-clockwise", "Ebene um 90° gegen den Uhrzeigersinn drehen") }
    return onActive(app, &job, name)
}

// The active layer turned by `degrees` (clockwise) about the image's
// middle, resampled with `filter`.
pub fn rotateLayer(app: *App, degrees: f64, filter: u8) -> bool {
    if !(degrees > -3600.0 && degrees < 3600.0) { return false }
    const quarter = quarterOf(degrees)
    if quarter < 4 { return rotateLayer90(app, quarter) }
    const image = api.image(app)
    if image == null { return false }
    const cx = @floatFromInt(f64, image.?.*.width) / 2.0
    const cy = @floatFromInt(f64, image.?.*.height) / 2.0
    const job = matrixJob(transform.rotation(degrees * 3.141592653589793 / 180.0, cx, cy), filter)
    return onActive(app, &job, state.tr(app, "Rotate layer", "Ebene drehen"))
}

// The active layer resampled to `width` x `height` pixels (what it
// holds: contentBounds), its top left corner staying where it is.
pub fn scaleLayer(app: *App, width: i32, height: i32, filter: u8) -> bool {
    const node = api.activeNode(app)
    if node == null { return false }
    const area = contentBounds(node.?)
    if geom.isEmpty(area) {
        api.say(app, state.tr(app, "The layer is empty", "Die Ebene ist leer"), true)
        return false
    }
    if !sizeFits(width, height) { return badSize(app) }
    if width == area.width && height == area.height { return true }
    const sx = @floatFromInt(f64, width) / @floatFromInt(f64, area.width)
    const sy = @floatFromInt(f64, height) / @floatFromInt(f64, area.height)
    const job = matrixJob(transform.scaling(sx, sy, @floatFromInt(f64, area.x), @floatFromInt(f64, area.y)), filter)
    return onActive(app, &job, state.tr(app, "Scale layer", "Ebene skalieren"))
}

// The active layer's pixels inside the image pushed by (dx, dy),
// wrapping around the image's edges.
pub fn offsetLayer(app: *App, dx: i32, dy: i32) -> bool {
    const image = api.image(app)
    if image == null { return false }
    if dx % image.?.*.width == 0 && dy % image.?.*.height == 0 { return true }
    const job = wrapJob(image_module.bounds(image.?), dx, dy)
    return onActive(app, &job, state.tr(app, "Offset layer", "Ebene versetzen"))
}

// ---------------------------------------------------------------------------
// The dialogs: their pieces

// dialogs.Hooks.kind of the dialogs here.
const KIND_PROPERTIES: u8 = 65
const KIND_SCALE: u8 = 66
const KIND_CANVAS: u8 = 67
const KIND_ROTATE: u8 = 68
const KIND_OFFSET: u8 = 69

// Units of a size field.
const UNIT_PX: usize = 0
const UNIT_PERCENT: usize = 1
const UNIT_MM: usize = 2
const UNIT_IN: usize = 3

// The fields of the dialogs, for dialogs.partId (scripts and tests find
// them by these).
pub const SCALE_WIDTH: usize = dialogs.PART_FIELD
pub const SCALE_UNIT: usize = dialogs.PART_FIELD + 1
pub const SCALE_HEIGHT: usize = dialogs.PART_FIELD + 2
pub const SCALE_LINKED: usize = dialogs.PART_FIELD + 3
pub const SCALE_RESOLUTION: usize = dialogs.PART_FIELD + 4
pub const SCALE_FILTER: usize = dialogs.PART_FIELD + 5
pub const CANVAS_WIDTH: usize = dialogs.PART_FIELD
pub const CANVAS_UNIT: usize = dialogs.PART_FIELD + 1
pub const CANVAS_HEIGHT: usize = dialogs.PART_FIELD + 2
// Nine of them, row by row from the top left.
pub const CANVAS_ANCHOR: usize = dialogs.PART_FIELD + 3
pub const CANVAS_X: usize = dialogs.PART_FIELD + 12
pub const CANVAS_Y: usize = dialogs.PART_FIELD + 13
pub const ROTATE_ANGLE: usize = dialogs.PART_FIELD
// Three: a quarter anticlockwise, a quarter clockwise, half.
pub const ROTATE_QUICK: usize = dialogs.PART_FIELD + 1
pub const ROTATE_FILTER: usize = dialogs.PART_FIELD + 4
pub const OFFSET_X: usize = dialogs.PART_FIELD
pub const OFFSET_Y: usize = dialogs.PART_FIELD + 1
pub const OFFSET_HALF: usize = dialogs.PART_FIELD + 2
pub const PROPERTIES_NAME: usize = dialogs.PART_FIELD
pub const PROPERTIES_RESOLUTION: usize = dialogs.PART_FIELD + 1

// An anchor's cell and the room between the cells (times the scale).
const CELL: i32 = 24
const CELL_GAP: i32 = 4

fn scaleOf(app: *App) -> i32 { return state.themeOf(app).*.scale }

fn appOf(context: usize) -> *App { return unsafe { @ptrFromInt(*App, context) } }

fn cancelText(app: *App) -> []const u8 { return state.tr(app, "Cancel", "Abbrechen") }

fn unitName(context: usize, index: usize) -> []const u8 {
    if index == UNIT_PERCENT { return "%" }
    if index == UNIT_MM { return "mm" }
    if index == UNIT_IN { return "in" }
    return "px"
}

fn filterName(context: usize, index: usize) -> []const u8 {
    return transform.filterTitle(@intCast(u8, index), appOf(context).*.german)
}

// The image asked about when the dialog opened, if it is still the one in
// front (a dialog answered after its image was closed changes nothing).
fn stillInFront(app: *App, address: usize) -> ?*Image {
    const picture = api.image(app)
    if picture == null || @intFromPtr(picture.?) != address { return null }
    return picture
}

// `value` with `decimals` after the point (a comma in German) appended
// to `into`; `digits` is room for the number on its way.
fn appendNumber(app: *App, into: [*]u8, at: usize, capacity: usize, value: f64, decimals: usize, digits: [*]u8) -> usize {
    const count = kit_module.formatNumber(value, decimals, digits)
    var length = at
    var index: usize = 0
    while index < count {
        const byte = if app.*.german && digits[index] == 46 { 44 } else { digits[index] }
        length = std.text.appendByte(into, length, capacity, byte)
        index += 1
    }
    return length
}

// "W × H" appended.
fn appendSize(into: [*]u8, at: usize, capacity: usize, width: i32, height: i32) -> usize {
    var length = std.text.appendSigned(into, at, capacity, @intCast(isize, width))
    length = std.text.append(into, length, capacity, " × ")
    return std.text.appendSigned(into, length, capacity, @intCast(isize, height))
}

// A whole number of pixels for a side, 1 to LARGEST.
fn sideOf(value: f64) -> i32 {
    if !(value >= 1.0) { return 1 }
    if value >= @floatFromInt(f64, image_module.LARGEST) { return image_module.LARGEST }
    return @intFromFloat(i32, @floor(value + 0.5))
}

// The other side that keeps the ratio of `base_this` to `base_other`.
fn following(value: i32, base_this: i32, base_other: i32) -> i32 {
    if base_this <= 0 { return value }
    return sideOf(@floatFromInt(f64, value) * @floatFromInt(f64, base_other) / @floatFromInt(f64, base_this))
}

// A premultiplied colour at `alpha` (of 255) of itself.
fn faded(color: u32, alpha: u32) -> u32 {
    const a = ((color >> 24) * alpha + 127) / 255
    const r = (((color >> 16) & 255) * alpha + 127) / 255
    const g = (((color >> 8) & 255) * alpha + 127) / 255
    const b = ((color & 255) * alpha + 127) / 255
    return (a << 24) | (r << 16) | (g << 8) | b
}

// ---------------------------------------------------------------------------
// Scale Image / Scale Layer

const ScaleBody = struct {
    image: usize
    // The layer scaled (0: the image).
    node: u32
    // What is scaled now: the image's size, or what the layer holds.
    baseWidth: i32
    baseHeight: i32
    width: i32
    height: i32
    resolution: f64
    unit: usize
    linked: bool
    filter: usize
    labels: [2][]const u8
    note: [160]u8
}

fn scaleBody(app: *App, level: usize) -> *ScaleBody { return unsafe { @ptrCast(*ScaleBody, dialogs.body(app, level)) } }

fn resolutionOf(asked: *ScaleBody) -> f64 {
    return if asked.*.resolution >= 1.0 { asked.*.resolution } else { 1.0 }
}

// Pixels as the unit shows them (`base`: what 100 % is).
fn toUnit(asked: *ScaleBody, pixels: i32, base: i32) -> f64 {
    const value = @floatFromInt(f64, pixels)
    if asked.*.unit == UNIT_PERCENT { return value * 100.0 / @floatFromInt(f64, if base > 0 { base } else { 1 }) }
    if asked.*.unit == UNIT_MM { return value / resolutionOf(asked) * 25.4 }
    if asked.*.unit == UNIT_IN { return value / resolutionOf(asked) }
    return value
}

fn fromUnit(asked: *ScaleBody, value: f64, base: i32) -> i32 {
    var pixels = value
    if asked.*.unit == UNIT_PERCENT { pixels = value * @floatFromInt(f64, base) / 100.0 }
    if asked.*.unit == UNIT_MM { pixels = value / 25.4 * resolutionOf(asked) }
    if asked.*.unit == UNIT_IN { pixels = value * resolutionOf(asked) }
    return sideOf(pixels)
}

fn sideOptions(asked: *ScaleBody, base: i32) -> kit_module.SliderOptions {
    var options = kit_module.sliderOptions(toUnit(asked, 1, base), toUnit(asked, image_module.LARGEST, base), 1.0, 0)
    options.suffix = " px"
    if asked.*.unit == UNIT_PERCENT {
        options.decimals = 2
        options.suffix = " %"
    } else if asked.*.unit == UNIT_MM {
        options.decimals = 1
        options.suffix = " mm"
    } else if asked.*.unit == UNIT_IN {
        options.step = 0.1
        options.decimals = 2
        options.suffix = " in"
    }
    return options
}

// Asks for a new size of the image (`node` null) or of what a layer
// holds, in pixels, percent, millimetres or inches, the two sides linked
// or not, the image's resolution and the filter; OK scales. False when it
// cannot be shown (no image, an empty layer, too many dialogs).
pub fn askScale(app: *App, node: ?*Node) -> bool {
    const picture = api.image(app)
    if picture == null { return false }
    var width = picture.?.*.width
    var height = picture.?.*.height
    var id: u32 = 0
    if node != null {
        const area = contentBounds(node.?)
        if geom.isEmpty(area) {
            api.say(app, state.tr(app, "The layer is empty", "Die Ebene ist leer"), true)
            return false
        }
        width = area.width
        height = area.height
        id = node.?.*.id
    }
    const hooks = dialogs.Hooks.{ .kind = KIND_SCALE, .draw = drawScale, .key = null, .finish = finishScale, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(ScaleBody))
    if level == null { return false }
    const asked = scaleBody(app, level.?)
    asked.*.image = @intFromPtr(picture.?)
    asked.*.node = id
    asked.*.baseWidth = width
    asked.*.baseHeight = height
    asked.*.width = width
    asked.*.height = height
    asked.*.resolution = picture.?.*.resolution
    asked.*.unit = UNIT_PX
    asked.*.linked = true
    asked.*.filter = @intCast(usize, transform.BICUBIC)
    return true
}

fn drawScale(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = scaleBody(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const row = dialogs.ROW * s
    const layer = asked.*.node != 0
    const count: i32 = if layer { 5 } else { 6 }
    const natural = count * (dialogs.ROW + dialogs.GAP) * s
    const title = if layer { state.tr(app, "Scale Layer", "Ebene skalieren") } else { state.tr(app, "Scale Image", "Bild skalieren") }
    var content = dialogs.frame(app, window, title, 460 * s, dialogs.framed(app, natural))
    asked.*.labels[0] = "OK"
    asked.*.labels[1] = cancelText(app)
    const labels: [*][]const u8 = &asked.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 0)
    var rows = dialogs.scrollBegin(app, content, natural)
    const narrow = 150 * s
    const width_field = dialogs.labelled(app, &rows, state.tr(app, "Width", "Breite"), row)
    var options = sideOptions(asked, asked.*.baseWidth)
    var shown = toUnit(asked, asked.*.width, asked.*.baseWidth)
    if kit_module.spinBox(kit, dialogs.idOf(app, level, SCALE_WIDTH), ui.rect(width_field.x, width_field.y, narrow, row), &shown, &options) {
        asked.*.width = fromUnit(asked, shown, asked.*.baseWidth)
        if asked.*.linked { asked.*.height = following(asked.*.width, asked.*.baseWidth, asked.*.baseHeight) }
    }
    // The unit is the width's and the height's, beside the first.
    _ = kit_module.comboBoxWith(kit, dialogs.idOf(app, level, SCALE_UNIT), ui.rect(width_field.x + narrow + 8 * s, width_field.y, 72 * s, row), 4, unitName, 0, &asked.*.unit)
    const height_field = dialogs.labelled(app, &rows, state.tr(app, "Height", "Höhe"), row)
    options = sideOptions(asked, asked.*.baseHeight)
    shown = toUnit(asked, asked.*.height, asked.*.baseHeight)
    if kit_module.spinBox(kit, dialogs.idOf(app, level, SCALE_HEIGHT), ui.rect(height_field.x, height_field.y, narrow, row), &shown, &options) {
        asked.*.height = fromUnit(asked, shown, asked.*.baseHeight)
        if asked.*.linked { asked.*.width = following(asked.*.height, asked.*.baseHeight, asked.*.baseWidth) }
    }
    if kit_module.checkBox(kit, dialogs.idOf(app, level, SCALE_LINKED), dialogs.labelled(app, &rows, "", row), state.tr(app, "Keep the aspect ratio", "Seitenverhältnis beibehalten"), &asked.*.linked) && asked.*.linked {
        asked.*.height = following(asked.*.width, asked.*.baseWidth, asked.*.baseHeight)
    }
    if !layer {
        const resolution_field = dialogs.labelled(app, &rows, state.tr(app, "Resolution", "Auflösung"), row)
        var resolution_options = kit_module.sliderOptions(1.0, 9600.0, 1.0, 0)
        resolution_options.suffix = " ppi"
        var resolution = asked.*.resolution
        if kit_module.spinBox(kit, dialogs.idOf(app, level, SCALE_RESOLUTION), ui.rect(resolution_field.x, resolution_field.y, narrow, row), &resolution, &resolution_options) && resolution >= 1.0 {
            // A size given in millimetres or inches stays that size: the
            // pixels follow the resolution.
            if asked.*.unit == UNIT_MM || asked.*.unit == UNIT_IN {
                const factor = resolution / resolutionOf(asked)
                asked.*.width = sideOf(@floatFromInt(f64, asked.*.width) * factor)
                asked.*.height = sideOf(@floatFromInt(f64, asked.*.height) * factor)
            }
            asked.*.resolution = resolution
        }
    }
    const filter_field = dialogs.labelled(app, &rows, state.tr(app, "Filter", "Filter"), row)
    _ = kit_module.comboBoxWith(kit, dialogs.idOf(app, level, SCALE_FILTER), ui.rect(filter_field.x, filter_field.y, narrow + 8 * s + 72 * s, row), transform.FILTERS, filterName, @intFromPtr(app), &asked.*.filter)
    const note_field = dialogs.labelled(app, &rows, "", row)
    const note: [*]u8 = &asked.*.note
    var length = appendSize(note, 0, 160, asked.*.baseWidth, asked.*.baseHeight)
    length = std.text.append(note, length, 160, " px  →  ")
    length = appendSize(note, length, 160, asked.*.width, asked.*.height)
    length = std.text.append(note, length, 160, " px")
    kit_module.label(kit, note_field, note[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}

fn finishScale(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const asked = scaleBody(app, level)
    if stillInFront(app, asked.*.image) == null { return }
    const width = asked.*.width
    const height = asked.*.height
    const filter = @intCast(u8, asked.*.filter)
    if asked.*.node == 0 {
        _ = scaleImage(app, width, height, asked.*.resolution, filter)
        return
    }
    const node = api.activeNode(app)
    if node == null || node.?.*.id != asked.*.node { return }
    _ = scaleLayer(app, width, height, filter)
}

// ---------------------------------------------------------------------------
// Resize Canvas

const CanvasBody = struct {
    image: usize
    baseWidth: i32
    baseHeight: i32
    width: i32
    height: i32
    // UNIT_PX or UNIT_PERCENT.
    unit: usize
    // The cell of the 3 x 3 the old image keeps to (row by row), and
    // where its corner lies in the new canvas.
    anchor: usize
    dx: i32
    dy: i32
    labels: [2][]const u8
    note: [160]u8
}

fn canvasBody(app: *App, level: usize) -> *CanvasBody { return unsafe { @ptrCast(*CanvasBody, dialogs.body(app, level)) } }

fn placeByAnchor(asked: *CanvasBody) -> void {
    asked.*.dx = anchorOffset(asked.*.baseWidth, asked.*.width, @intCast(u32, asked.*.anchor % 3))
    asked.*.dy = anchorOffset(asked.*.baseHeight, asked.*.height, @intCast(u32, asked.*.anchor / 3))
}

// Asks for the canvas's new size (pixels or percent), where the image
// keeps to (nine anchors) and exactly where its corner goes; OK resizes.
// False when it cannot be shown.
pub fn askCanvas(app: *App) -> bool {
    const picture = api.image(app)
    if picture == null { return false }
    const hooks = dialogs.Hooks.{ .kind = KIND_CANVAS, .draw = drawCanvas, .key = null, .finish = finishCanvas, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(CanvasBody))
    if level == null { return false }
    const asked = canvasBody(app, level.?)
    asked.*.image = @intFromPtr(picture.?)
    asked.*.baseWidth = picture.?.*.width
    asked.*.baseHeight = picture.?.*.height
    asked.*.width = picture.?.*.width
    asked.*.height = picture.?.*.height
    asked.*.unit = UNIT_PX
    asked.*.anchor = 4
    asked.*.dx = 0
    asked.*.dy = 0
    return true
}

fn canvasOptions(asked: *CanvasBody, base: i32) -> kit_module.SliderOptions {
    if asked.*.unit == UNIT_PERCENT {
        const whole = @floatFromInt(f64, base)
        var options = kit_module.sliderOptions(100.0 / whole, @floatFromInt(f64, image_module.LARGEST) * 100.0 / whole, 1.0, 2)
        options.suffix = " %"
        return options
    }
    var options = kit_module.sliderOptions(1.0, @floatFromInt(f64, image_module.LARGEST), 1.0, 0)
    options.suffix = " px"
    return options
}

fn canvasShown(asked: *CanvasBody, pixels: i32, base: i32) -> f64 {
    if asked.*.unit == UNIT_PERCENT { return @floatFromInt(f64, pixels) * 100.0 / @floatFromInt(f64, base) }
    return @floatFromInt(f64, pixels)
}

fn canvasPixels(asked: *CanvasBody, value: f64, base: i32) -> i32 {
    if asked.*.unit == UNIT_PERCENT { return sideOf(value * @floatFromInt(f64, base) / 100.0) }
    return sideOf(value)
}

// The icon of anchor cell `cell` when `chosen` is the anchor: a dot on
// the anchor, arrows on the cells beside it (where the canvas grows).
fn anchorIcon(cell: usize, chosen: usize) -> u16 {
    const dc = @intCast(i32, cell % 3) - @intCast(i32, chosen % 3)
    const dr = @intCast(i32, cell / 3) - @intCast(i32, chosen / 3)
    if dc == 0 && dr == 0 { return icons.BULLET }
    if dr == 0 && dc == -1 { return icons.ARROW_LEFT }
    if dr == 0 && dc == 1 { return icons.ARROW_RIGHT }
    if dc == 0 && dr == -1 { return icons.ARROW_UP }
    if dc == 0 && dr == 1 { return icons.ARROW_DOWN }
    return icons.NONE
}

// The new canvas (outlined) and the old image on it (tinted), fitted into
// `area`.
fn drawCanvasPicture(app: *App, asked: *CanvasBody, area: ui.Rect) -> void {
    const canvas = state.uiOf(app).*.canvas
    if canvas.*.width == 0 || area.width <= 0 || area.height <= 0 { return }
    const theme = state.themeOf(app)
    const s = theme.*.scale
    const fresh = geom.rect(0, 0, asked.*.width, asked.*.height)
    const old = geom.rect(asked.*.dx, asked.*.dy, asked.*.baseWidth, asked.*.baseHeight)
    const both = geom.unite(fresh, old)
    const room_x = @floatFromInt(f64, area.width - 2 * s)
    const room_y = @floatFromInt(f64, area.height - 2 * s)
    var factor = room_x / @floatFromInt(f64, both.width)
    if room_y / @floatFromInt(f64, both.height) < factor { factor = room_y / @floatFromInt(f64, both.height) }
    const shown_width = @floatFromInt(f64, both.width) * factor
    const shown_height = @floatFromInt(f64, both.height) * factor
    const left = @floatFromInt(f64, area.x) + (@floatFromInt(f64, area.width) - shown_width) / 2.0
    const top = @floatFromInt(f64, area.y) + (@floatFromInt(f64, area.height) - shown_height) / 2.0
    const canvas_box = fitted(fresh, both, factor, left, top)
    const image_box = fitted(old, both, factor, left, top)
    canvas_module.fillRect(canvas, canvas_box.x, canvas_box.y, canvas_box.width, canvas_box.height, theme.*.field)
    kit_module.frame(canvas, canvas_box, theme.*.border)
    canvas_module.fillRect(canvas, image_box.x, image_box.y, image_box.width, image_box.height, faded(theme.*.accent, 90))
    kit_module.frame(canvas, image_box, theme.*.accent)
}

// `area` of the picture's plane drawn `factor` times as large, the plane
// `both` starting at (left, top) of the window; at least a pixel across.
fn fitted(area: Rect, both: Rect, factor: f64, left: f64, top: f64) -> ui.Rect {
    const x0 = @intFromFloat(i32, @floor(left + @floatFromInt(f64, area.x - both.x) * factor + 0.5))
    const y0 = @intFromFloat(i32, @floor(top + @floatFromInt(f64, area.y - both.y) * factor + 0.5))
    var x1 = @intFromFloat(i32, @floor(left + @floatFromInt(f64, geom.right(area) - both.x) * factor + 0.5))
    var y1 = @intFromFloat(i32, @floor(top + @floatFromInt(f64, geom.bottom(area) - both.y) * factor + 0.5))
    if x1 <= x0 { x1 = x0 + 1 }
    if y1 <= y0 { y1 = y0 + 1 }
    return ui.rect(x0, y0, x1 - x0, y1 - y0)
}

fn drawCanvas(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = canvasBody(app, level)
    const kit = api.kit(app)
    const theme = state.themeOf(app)
    const s = scaleOf(app)
    const row = dialogs.ROW * s
    const grid = (3 * CELL + 2 * CELL_GAP) * s
    const natural = 5 * (dialogs.ROW + dialogs.GAP) * s + grid + dialogs.GAP * s
    var content = dialogs.frame(app, window, state.tr(app, "Resize Canvas", "Arbeitsfläche ändern"), 460 * s, dialogs.framed(app, natural))
    asked.*.labels[0] = "OK"
    asked.*.labels[1] = cancelText(app)
    const labels: [*][]const u8 = &asked.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 0)
    var rows = dialogs.scrollBegin(app, content, natural)
    const narrow = 150 * s
    const width_field = dialogs.labelled(app, &rows, state.tr(app, "Width", "Breite"), row)
    var options = canvasOptions(asked, asked.*.baseWidth)
    var shown = canvasShown(asked, asked.*.width, asked.*.baseWidth)
    if kit_module.spinBox(kit, dialogs.idOf(app, level, CANVAS_WIDTH), ui.rect(width_field.x, width_field.y, narrow, row), &shown, &options) {
        asked.*.width = canvasPixels(asked, shown, asked.*.baseWidth)
        placeByAnchor(asked)
    }
    _ = kit_module.comboBoxWith(kit, dialogs.idOf(app, level, CANVAS_UNIT), ui.rect(width_field.x + narrow + 8 * s, width_field.y, 72 * s, row), 2, unitName, 0, &asked.*.unit)
    const height_field = dialogs.labelled(app, &rows, state.tr(app, "Height", "Höhe"), row)
    options = canvasOptions(asked, asked.*.baseHeight)
    shown = canvasShown(asked, asked.*.height, asked.*.baseHeight)
    if kit_module.spinBox(kit, dialogs.idOf(app, level, CANVAS_HEIGHT), ui.rect(height_field.x, height_field.y, narrow, row), &shown, &options) {
        asked.*.height = canvasPixels(asked, shown, asked.*.baseHeight)
        placeByAnchor(asked)
    }
    // The anchors, and beside them the picture of what comes of it.
    const anchor_field = dialogs.labelled(app, &rows, state.tr(app, "Anchor", "Anker"), grid)
    const canvas = state.uiOf(app).*.canvas
    var cell: usize = 0
    while cell < 9 {
        const area = ui.rect(anchor_field.x + @intCast(i32, cell % 3) * (CELL + CELL_GAP) * s, anchor_field.y + @intCast(i32, cell / 3) * (CELL + CELL_GAP) * s, CELL * s, CELL * s)
        canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.field)
        const icon = anchorIcon(cell, asked.*.anchor)
        var draw: ?kit_module.IconDraw = null
        if icon != icons.NONE { draw = icons.drawFor }
        if kit_module.toolButton(kit, dialogs.idOf(app, level, CANVAS_ANCHOR + cell), area, draw, @intCast(usize, icon), cell == asked.*.anchor, "") {
            asked.*.anchor = cell
            placeByAnchor(asked)
        }
        cell += 1
    }
    const picture_x = anchor_field.x + grid + 20 * s
    drawCanvasPicture(app, asked, ui.rect(picture_x, anchor_field.y, ui.right(anchor_field) - picture_x, grid))
    var place_options = kit_module.sliderOptions(-@floatFromInt(f64, image_module.LARGEST), @floatFromInt(f64, image_module.LARGEST), 1.0, 0)
    place_options.suffix = " px"
    const x_field = dialogs.labelled(app, &rows, state.tr(app, "Offset x", "Versatz x"), row)
    _ = kit_module.intBox(kit, dialogs.idOf(app, level, CANVAS_X), ui.rect(x_field.x, x_field.y, narrow, row), &asked.*.dx, &place_options)
    const y_field = dialogs.labelled(app, &rows, state.tr(app, "Offset y", "Versatz y"), row)
    _ = kit_module.intBox(kit, dialogs.idOf(app, level, CANVAS_Y), ui.rect(y_field.x, y_field.y, narrow, row), &asked.*.dy, &place_options)
    const note_field = dialogs.labelled(app, &rows, "", row)
    const note: [*]u8 = &asked.*.note
    var length = appendSize(note, 0, 160, asked.*.baseWidth, asked.*.baseHeight)
    length = std.text.append(note, length, 160, " px  →  ")
    length = appendSize(note, length, 160, asked.*.width, asked.*.height)
    length = std.text.append(note, length, 160, " px")
    kit_module.label(kit, note_field, note[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}

fn finishCanvas(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const asked = canvasBody(app, level)
    if stillInFront(app, asked.*.image) == null { return }
    _ = resizeCanvas(app, asked.*.width, asked.*.height, asked.*.dx, asked.*.dy)
}

// ---------------------------------------------------------------------------
// Rotate by an angle (the image, or a layer)

const RotateBody = struct {
    image: usize
    // The layer turned (0: the image).
    node: u32
    degrees: f64
    filter: usize
    labels: [2][]const u8
    note: [160]u8
}

fn rotateBody(app: *App, level: usize) -> *RotateBody { return unsafe { @ptrCast(*RotateBody, dialogs.body(app, level)) } }

// Asks for an angle (clockwise, -180° to 180°, typed or by three quick
// buttons) and the filter; OK turns the image (`node` null: it grows to
// hold what is turned) or the layer about the image's middle. False when
// it cannot be shown.
pub fn askRotate(app: *App, node: ?*Node) -> bool {
    const picture = api.image(app)
    if picture == null { return false }
    const hooks = dialogs.Hooks.{ .kind = KIND_ROTATE, .draw = drawRotate, .key = null, .finish = finishRotate, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(RotateBody))
    if level == null { return false }
    const asked = rotateBody(app, level.?)
    asked.*.image = @intFromPtr(picture.?)
    asked.*.node = 0
    if node != null { asked.*.node = node.?.*.id }
    asked.*.degrees = 0.0
    asked.*.filter = @intCast(usize, transform.BICUBIC)
    return true
}

fn drawRotate(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = rotateBody(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const row = dialogs.ROW * s
    const layer = asked.*.node != 0
    const natural = 4 * (dialogs.ROW + dialogs.GAP) * s
    const title = if layer { state.tr(app, "Rotate Layer", "Ebene drehen") } else { state.tr(app, "Rotate Image", "Bild drehen") }
    var content = dialogs.frame(app, window, title, 460 * s, dialogs.framed(app, natural))
    asked.*.labels[0] = "OK"
    asked.*.labels[1] = cancelText(app)
    const labels: [*][]const u8 = &asked.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 0)
    var rows = dialogs.scrollBegin(app, content, natural)
    var angle = kit_module.sliderOptions(-180.0, 180.0, 1.0, 1)
    angle.suffix = "°"
    _ = kit_module.slider(kit, dialogs.idOf(app, level, ROTATE_ANGLE), dialogs.labelled(app, &rows, state.tr(app, "Angle", "Winkel"), row), state.tr(app, "Clockwise", "Im Uhrzeigersinn"), &asked.*.degrees, &angle)
    // The usual turns at a click (brixOS has no wheel to step by).
    const quick = dialogs.labelled(app, &rows, "", row)
    const third = (quick.width - 2 * 8 * s) / 3
    if kit_module.button(kit, dialogs.idOf(app, level, ROTATE_QUICK), ui.rect(quick.x, quick.y, third, row), "−90°", kit_module.BUTTON_NORMAL) { asked.*.degrees = -90.0 }
    if kit_module.button(kit, dialogs.idOf(app, level, ROTATE_QUICK + 1), ui.rect(quick.x + third + 8 * s, quick.y, third, row), "90°", kit_module.BUTTON_NORMAL) { asked.*.degrees = 90.0 }
    if kit_module.button(kit, dialogs.idOf(app, level, ROTATE_QUICK + 2), ui.rect(ui.right(quick) - third, quick.y, third, row), "180°", kit_module.BUTTON_NORMAL) { asked.*.degrees = 180.0 }
    const filter_field = dialogs.labelled(app, &rows, state.tr(app, "Filter", "Filter"), row)
    _ = kit_module.comboBoxWith(kit, dialogs.idOf(app, level, ROTATE_FILTER), ui.rect(filter_field.x, filter_field.y, 230 * s, row), transform.FILTERS, filterName, @intFromPtr(app), &asked.*.filter)
    const note_field = dialogs.labelled(app, &rows, "", row)
    const note: [*]u8 = &asked.*.note
    var length: usize = 0
    const picture = stillInFront(app, asked.*.image)
    if layer {
        length = std.text.append(note, 0, 160, state.tr(app, "About the middle of the image", "Um die Mitte des Bildes"))
    } else if picture != null {
        var width = picture.?.*.width
        var height = picture.?.*.height
        const quarter = quarterOf(asked.*.degrees)
        if quarter == 1 || quarter == 3 {
            width = picture.?.*.height
            height = picture.?.*.width
        } else if quarter == 4 {
            _ = turnAndPlace(image_module.bounds(picture.?), asked.*.degrees, &width, &height)
        }
        length = std.text.append(note, 0, 160, state.tr(app, "The image becomes ", "Das Bild wird "))
        length = appendSize(note, length, 160, width, height)
        length = std.text.append(note, length, 160, " px")
    }
    kit_module.label(kit, note_field, note[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}

fn finishRotate(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const asked = rotateBody(app, level)
    if stillInFront(app, asked.*.image) == null { return }
    const degrees = asked.*.degrees
    const filter = @intCast(u8, asked.*.filter)
    if asked.*.node == 0 {
        _ = rotateImage(app, degrees, filter)
        return
    }
    const node = api.activeNode(app)
    if node == null || node.?.*.id != asked.*.node { return }
    _ = rotateLayer(app, degrees, filter)
}

// ---------------------------------------------------------------------------
// Offset (the image, or a layer)

const OffsetBody = struct {
    image: usize
    // The layer whose pixels wrap (0: all of the image's).
    node: u32
    dx: i32
    dy: i32
    width: i32
    height: i32
    labels: [2][]const u8
}

fn offsetBody(app: *App, level: usize) -> *OffsetBody { return unsafe { @ptrCast(*OffsetBody, dialogs.body(app, level)) } }

// Asks how far the pixels go across and down (a button sets half the
// image's size: the seams come into the middle); OK wraps all layers
// (`node` null) or the layer. False when it cannot be shown.
pub fn askOffset(app: *App, node: ?*Node) -> bool {
    const picture = api.image(app)
    if picture == null { return false }
    const hooks = dialogs.Hooks.{ .kind = KIND_OFFSET, .draw = drawOffset, .key = null, .finish = finishOffset, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(OffsetBody))
    if level == null { return false }
    const asked = offsetBody(app, level.?)
    asked.*.image = @intFromPtr(picture.?)
    asked.*.node = 0
    if node != null { asked.*.node = node.?.*.id }
    asked.*.dx = 0
    asked.*.dy = 0
    asked.*.width = picture.?.*.width
    asked.*.height = picture.?.*.height
    return true
}

fn drawOffset(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = offsetBody(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const row = dialogs.ROW * s
    const layer = asked.*.node != 0
    const natural = 4 * (dialogs.ROW + dialogs.GAP) * s
    const title = if layer { state.tr(app, "Offset Layer", "Ebene versetzen") } else { state.tr(app, "Offset Image", "Bild versetzen") }
    var content = dialogs.frame(app, window, title, 460 * s, dialogs.framed(app, natural))
    asked.*.labels[0] = "OK"
    asked.*.labels[1] = cancelText(app)
    const labels: [*][]const u8 = &asked.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 0)
    var rows = dialogs.scrollBegin(app, content, natural)
    const narrow = 150 * s
    var options = kit_module.sliderOptions(-@floatFromInt(f64, image_module.LARGEST), @floatFromInt(f64, image_module.LARGEST), 1.0, 0)
    options.suffix = " px"
    const x_field = dialogs.labelled(app, &rows, state.tr(app, "Across", "Waagrecht"), row)
    _ = kit_module.intBox(kit, dialogs.idOf(app, level, OFFSET_X), ui.rect(x_field.x, x_field.y, narrow, row), &asked.*.dx, &options)
    const y_field = dialogs.labelled(app, &rows, state.tr(app, "Down", "Senkrecht"), row)
    _ = kit_module.intBox(kit, dialogs.idOf(app, level, OFFSET_Y), ui.rect(y_field.x, y_field.y, narrow, row), &asked.*.dy, &options)
    const half = dialogs.labelled(app, &rows, "", row)
    if kit_module.button(kit, dialogs.idOf(app, level, OFFSET_HALF), ui.rect(half.x, half.y, 200 * s, row), state.tr(app, "Half the image's size", "Halbe Bildgröße"), kit_module.BUTTON_NORMAL) {
        asked.*.dx = asked.*.width / 2
        asked.*.dy = asked.*.height / 2
    }
    kit_module.label(kit, dialogs.labelled(app, &rows, "", row), state.tr(app, "What leaves one edge comes in at the other", "Was an einem Rand hinausgeht, kommt am anderen herein"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}

fn finishOffset(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const asked = offsetBody(app, level)
    if stillInFront(app, asked.*.image) == null { return }
    const dx = asked.*.dx
    const dy = asked.*.dy
    if asked.*.node == 0 {
        _ = offsetImage(app, dx, dy)
        return
    }
    const node = api.activeNode(app)
    if node == null || node.?.*.id != asked.*.node { return }
    _ = offsetLayer(app, dx, dy)
}

// ---------------------------------------------------------------------------
// Image Properties

const PropertiesBody = struct {
    image: usize
    name: [256]u8
    nameLength: usize
    resolution: f64
    labels: [2][]const u8
    size: [96]u8
    print: [96]u8
    contents: [96]u8
    digits: [32]u8
}

fn propertiesBody(app: *App, level: usize) -> *PropertiesBody { return unsafe { @ptrCast(*PropertiesBody, dialogs.body(app, level)) } }

// Shows the image's name (the document's, editable), its size, its
// resolution (editable), the size it prints at, what it holds and how
// its pixels are kept; OK takes the name and the resolution (one step of
// the history when the resolution changed). False when it cannot be
// shown.
pub fn askProperties(app: *App) -> bool {
    const doc = api.document(app)
    if doc == null { return false }
    const hooks = dialogs.Hooks.{ .kind = KIND_PROPERTIES, .draw = drawProperties, .key = null, .finish = finishProperties, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(PropertiesBody))
    if level == null { return false }
    const asked = propertiesBody(app, level.?)
    asked.*.image = @intFromPtr(doc.?.*.image)
    var length: usize = 0
    while length < doc.?.*.nameLength && length < state.NAME {
        asked.*.name[length] = doc.?.*.name[length]
        length += 1
    }
    asked.*.nameLength = length
    asked.*.resolution = doc.?.*.image.*.resolution
    return true
}

fn countNodes(node: *Node, layers: *usize, masks: *usize) -> void {
    for child in node.*.children.items() {
        if node_module.isMask(child.*.kind) { masks.* += 1 } else { layers.* += 1 }
        countNodes(child, layers, masks)
    }
}

fn drawProperties(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = propertiesBody(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const row = dialogs.ROW * s
    const natural = 6 * (dialogs.ROW + dialogs.GAP) * s
    var content = dialogs.frame(app, window, state.tr(app, "Image Properties", "Bildeigenschaften"), 460 * s, dialogs.framed(app, natural))
    asked.*.labels[0] = "OK"
    asked.*.labels[1] = cancelText(app)
    const labels: [*][]const u8 = &asked.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 0)
    var rows = dialogs.scrollBegin(app, content, natural)
    _ = kit_module.textBox(kit, dialogs.idOf(app, level, PROPERTIES_NAME), dialogs.labelled(app, &rows, "Name", row), &asked.*.name, &asked.*.nameLength, state.NAME, "")
    const picture = stillInFront(app, asked.*.image)
    var width: i32 = 0
    var height: i32 = 0
    var layers: usize = 0
    var masks: usize = 0
    if picture != null {
        width = picture.?.*.width
        height = picture.?.*.height
        countNodes(picture.?.*.root, &layers, &masks)
    }
    const size: [*]u8 = &asked.*.size
    var length = appendSize(size, 0, 96, width, height)
    length = std.text.append(size, length, 96, state.tr(app, " pixels", " Pixel"))
    kit_module.label(kit, dialogs.labelled(app, &rows, state.tr(app, "Size", "Größe"), row), size[0..length], kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    const resolution_field = dialogs.labelled(app, &rows, state.tr(app, "Resolution", "Auflösung"), row)
    var options = kit_module.sliderOptions(1.0, 9600.0, 1.0, 0)
    options.suffix = " ppi"
    _ = kit_module.spinBox(kit, dialogs.idOf(app, level, PROPERTIES_RESOLUTION), ui.rect(resolution_field.x, resolution_field.y, 150 * s, row), &asked.*.resolution, &options)
    const ppi = if asked.*.resolution >= 1.0 { asked.*.resolution } else { 1.0 }
    const print: [*]u8 = &asked.*.print
    const digits: [*]u8 = &asked.*.digits
    length = appendNumber(app, print, 0, 96, @floatFromInt(f64, width) / ppi * 25.4, 1, digits)
    length = std.text.append(print, length, 96, " × ")
    length = appendNumber(app, print, length, 96, @floatFromInt(f64, height) / ppi * 25.4, 1, digits)
    length = std.text.append(print, length, 96, " mm")
    kit_module.label(kit, dialogs.labelled(app, &rows, state.tr(app, "Printed", "Gedruckt"), row), print[0..length], kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    const contents: [*]u8 = &asked.*.contents
    length = std.text.appendUnsigned(contents, 0, 96, layers)
    length = std.text.append(contents, length, 96, if layers == 1 { state.tr(app, " layer, ", " Ebene, ") } else { state.tr(app, " layers, ", " Ebenen, ") })
    length = std.text.appendUnsigned(contents, length, 96, masks)
    length = std.text.append(contents, length, 96, if masks == 1 { state.tr(app, " mask", " Maske") } else { state.tr(app, " masks", " Masken") })
    kit_module.label(kit, dialogs.labelled(app, &rows, state.tr(app, "Contents", "Inhalt"), row), contents[0..length], kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    kit_module.label(kit, dialogs.labelled(app, &rows, state.tr(app, "Colour", "Farbe"), row), state.tr(app, "RGBA, 8 bits a channel", "RGBA, 8 Bit je Kanal"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}

fn finishProperties(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const asked = propertiesBody(app, level)
    if stillInFront(app, asked.*.image) == null { return }
    const doc = api.document(app).?
    // An empty name keeps the one it had.
    if asked.*.nameLength > 0 {
        const bytes: [*]const u8 = &asked.*.name
        var length: usize = 0
        while length < asked.*.nameLength && length < state.NAME {
            doc.*.name[length] = bytes[length]
            length += 1
        }
        doc.*.nameLength = length
    }
    _ = setResolution(app, asked.*.resolution)
    api.redraw(app)
}

// ---------------------------------------------------------------------------
// The menu

fn runProperties(app: *App) -> void { _ = askProperties(app) }
fn runScale(app: *App) -> void { _ = askScale(app, null) }
fn runCanvas(app: *App) -> void { _ = askCanvas(app) }
fn runRotateClockwise(app: *App) -> void { _ = rotateImage90(app, 1) }
fn runRotateAnticlockwise(app: *App) -> void { _ = rotateImage90(app, 3) }
fn runRotateHalf(app: *App) -> void { _ = rotateImage90(app, 2) }
fn runRotate(app: *App) -> void { _ = askRotate(app, null) }
fn runMirrorHorizontal(app: *App) -> void { _ = mirrorImage(app, true) }
fn runMirrorVertical(app: *App) -> void { _ = mirrorImage(app, false) }
fn runCrop(app: *App) -> void { _ = cropToSelection(app) }
fn runTrim(app: *App) -> void { _ = trimToLayer(app) }
fn runOffset(app: *App) -> void { _ = askOffset(app, null) }
fn runFlatten(app: *App) -> void { _ = flattenImage(app) }

fn hasLayers(app: *App) -> bool {
    const picture = api.image(app)
    return picture != null && node_module.childCount(picture.?.*.root) > 0
}

const DOC: u8 = state.ACTION_NEEDS_DOCUMENT
const SEP: u8 = state.ACTION_SEPARATOR_BEFORE
const ROTATE_MENU: []const u8 = "Rotate|Drehen"

const ACTIONS = [13]state.Action{
    state.Action.{ .key = "image_properties", .name = "Image Properties…", .german = "Bildeigenschaften …", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = "", .flags = DOC, .run = runProperties, .checked = null, .enabled = null },
    state.Action.{ .key = "image_scale", .name = "Scale Image to New Size…", .german = "Bild auf neue Größe skalieren …", .shortcut = "Ctrl+Alt+I", .menu = state.MENU_IMAGE, .submenu = "", .flags = SEP | DOC, .run = runScale, .checked = null, .enabled = null },
    state.Action.{ .key = "image_canvas_size", .name = "Resize Canvas…", .german = "Arbeitsfläche ändern …", .shortcut = "Ctrl+Alt+C", .menu = state.MENU_IMAGE, .submenu = "", .flags = DOC, .run = runCanvas, .checked = null, .enabled = null },
    state.Action.{ .key = "image_rotate_90_cw", .name = "Rotate 90° Clockwise", .german = "90° im Uhrzeigersinn drehen", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = ROTATE_MENU, .flags = SEP | DOC, .run = runRotateClockwise, .checked = null, .enabled = null },
    state.Action.{ .key = "image_rotate_90_ccw", .name = "Rotate 90° Counter-clockwise", .german = "90° gegen den Uhrzeigersinn drehen", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = ROTATE_MENU, .flags = DOC, .run = runRotateAnticlockwise, .checked = null, .enabled = null },
    state.Action.{ .key = "image_rotate_180", .name = "Rotate 180°", .german = "180° drehen", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = ROTATE_MENU, .flags = DOC, .run = runRotateHalf, .checked = null, .enabled = null },
    state.Action.{ .key = "image_rotate", .name = "Rotate by Angle…", .german = "Um Winkel drehen …", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = ROTATE_MENU, .flags = SEP | DOC, .run = runRotate, .checked = null, .enabled = null },
    state.Action.{ .key = "image_mirror_horizontal", .name = "Mirror Image Horizontally", .german = "Bild horizontal spiegeln", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = "", .flags = DOC, .run = runMirrorHorizontal, .checked = null, .enabled = null },
    state.Action.{ .key = "image_mirror_vertical", .name = "Mirror Image Vertically", .german = "Bild vertikal spiegeln", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = "", .flags = DOC, .run = runMirrorVertical, .checked = null, .enabled = null },
    state.Action.{ .key = "image_crop_to_selection", .name = "Crop to Selection", .german = "Auf Auswahl zuschneiden", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = "", .flags = SEP | DOC | state.ACTION_NEEDS_SELECTION, .run = runCrop, .checked = null, .enabled = null },
    state.Action.{ .key = "image_trim_to_layer", .name = "Trim to Current Layer", .german = "Auf aktuelle Ebene zuschneiden", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = "", .flags = DOC | state.ACTION_NEEDS_LAYER, .run = runTrim, .checked = null, .enabled = null },
    state.Action.{ .key = "image_offset", .name = "Offset Image…", .german = "Bild versetzen …", .shortcut = "", .menu = state.MENU_IMAGE, .submenu = "", .flags = DOC, .run = runOffset, .checked = null, .enabled = null },
    state.Action.{ .key = "image_flatten", .name = "Flatten Image", .german = "Bild verflachen", .shortcut = "Ctrl+Shift+E", .menu = state.MENU_IMAGE, .submenu = "", .flags = SEP | DOC, .run = runFlatten, .checked = null, .enabled = hasLayers },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The Image menu's actions (kept in heap memory: core/table.mlx).
pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

const SOURCES = [0]state.MenuSource{}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The Image menu has no entries that come and go.
pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
