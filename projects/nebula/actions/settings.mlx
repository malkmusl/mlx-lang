// nebula actions: the Settings menu: the preferences (ui/preferences.mlx:
// every setting, the shortcuts, the language), the same opened at the
// shortcuts, and the dockers put back where they were at the start
// (ui/docks.mlx's defaults: which are shown, in which panels, how wide).
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const preferences = @import("../ui/preferences.mlx")
const docks = @import("../ui/docks.mlx")
const table = @import("../core/table.mlx")

const App = state.App

fn openPreferences(app: *App) -> void { _ = preferences.open(app, preferences.PAGE_GENERAL) }
fn openShortcuts(app: *App) -> void { _ = preferences.open(app, preferences.PAGE_SHORTCUTS) }

fn resetDockers(app: *App) -> void {
    docks.defaults(app)
    api.say(app, state.tr(app, "The dockers are where they were at the start", "Die Docker sind wieder wie am Anfang"), false)
}

const ACTIONS = [3]state.Action{
    state.Action.{ .key = "settings_preferences", .name = "Configure Nebula…", .german = "Nebula einrichten …", .shortcut = "", .menu = state.MENU_SETTINGS, .submenu = "", .flags = 0, .run = openPreferences, .checked = null, .enabled = null },
    state.Action.{ .key = "settings_shortcuts", .name = "Configure Shortcuts…", .german = "Tastenkürzel einrichten …", .shortcut = "", .menu = state.MENU_SETTINGS, .submenu = "", .flags = 0, .run = openShortcuts, .checked = null, .enabled = null },
    state.Action.{ .key = "settings_reset_dockers", .name = "Reset Dockers", .german = "Docker zurücksetzen", .shortcut = "", .menu = state.MENU_SETTINGS, .submenu = "", .flags = state.ACTION_SEPARATOR_BEFORE, .run = resetDockers, .checked = null, .enabled = null },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

const SOURCES = [0]state.MenuSource{}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
