// nebula actions: the Filter menu. Two actions of its own, Apply Filter
// Again (Ctrl+F: the last filter with the numbers it had) and Adjust Last
// Filter (Ctrl+Alt+F: its form again), and then a submenu for each group
// of filters/types.mlx (Adjust, Artistic, Blur, Colours, Edge Detection,
// Emboss, Enhance, Map, Other), whose entries are the registry's filters
// of that group (state.MenuSource rows: the registry may grow). Choosing
// one is ui/filterdialog.mlx's choose(): a filter with numbers opens its
// form with a live preview, one without is applied at once. A filter
// with a form is listed with "…" after its name.
const std = @import("std")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const table = @import("../core/table.mlx")
const filters = @import("../filters/registry.mlx")
const types = @import("../filters/types.mlx")
const filterdialog = @import("../ui/filterdialog.mlx")

const App = state.App

fn repeat(app: *App) -> void { filterdialog.repeat(app) }
fn repeatDialog(app: *App) -> void { filterdialog.repeatDialog(app) }
fn hasLast(app: *App) -> bool { return filterdialog.hasLast(app) && !filterdialog.busy(app) }

const ACTIONS = [2]state.Action{
    state.Action.{ .key = "filter_repeat", .name = "Apply Filter Again", .german = "Filter erneut anwenden", .shortcut = "Ctrl+F", .menu = state.MENU_FILTER, .submenu = "", .flags = state.ACTION_NEEDS_LAYER, .run = repeat, .checked = null, .enabled = hasLast },
    state.Action.{ .key = "filter_repeat_dialog", .name = "Adjust Last Filter…", .german = "Letzten Filter anpassen …", .shortcut = "Ctrl+Alt+F", .menu = state.MENU_FILTER, .submenu = "", .flags = state.ACTION_NEEDS_LAYER, .run = repeatDialog, .checked = null, .enabled = hasLast },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

// ---------------------------------------------------------------------------
// The groups' entries

// How many filters of group `category` the registry has.
pub fn countIn(category: u8) -> usize {
    var found: usize = 0
    var index: usize = 0
    const all = filters.count()
    while index < all {
        const info = filters.at(index)
        if info != null && info.?.*.category == category { found += 1 }
        index += 1
    }
    return found
}

// Filter number `place` of group `category` (null past the last).
pub fn filterIn(category: u8, place: usize) -> ?*const types.Info {
    var left = place
    var index: usize = 0
    const all = filters.count()
    while index < all {
        const info = filters.at(index)
        if info != null && info.?.*.category == category {
            if left == 0 { return info }
            left -= 1
        }
        index += 1
    }
    return null
}

// A name with "…" after it is made here (the menus copy it at once).
var nameRoom: [128]u8 = undefined

fn nameIn(app: *App, category: u8, place: usize) -> []const u8 {
    const info = filterIn(category, place)
    if info == null { return "" }
    const name = if app.*.german && info.?.*.german.length > 0 { info.?.*.german } else { info.?.*.name }
    if info.?.*.params.length == 0 { return name }
    const bytes: [*]u8 = &nameRoom
    var length = std.text.append(bytes, 0, 128, name)
    // German puts a space before the ellipsis.
    length = std.text.append(bytes, length, 128, if app.*.german { " …" } else { "…" })
    return bytes[0..length]
}

fn runIn(app: *App, category: u8, place: usize) -> void {
    const info = filterIn(category, place)
    if info != null { filterdialog.choose(app, info.?.*.id) }
}

// A filter can be chosen while there is a layer and no filter is busy.
fn enabledEntry(app: *App, place: usize) -> bool {
    return api.activeNode(app) != null && !filterdialog.busy(app)
}

fn count0(app: *App) -> usize { return countIn(types.ADJUST) }
fn count1(app: *App) -> usize { return countIn(types.ARTISTIC) }
fn count2(app: *App) -> usize { return countIn(types.BLUR) }
fn count3(app: *App) -> usize { return countIn(types.COLORS) }
fn count4(app: *App) -> usize { return countIn(types.EDGE) }
fn count5(app: *App) -> usize { return countIn(types.EMBOSS) }
fn count6(app: *App) -> usize { return countIn(types.ENHANCE) }
fn count7(app: *App) -> usize { return countIn(types.MAP) }
fn count8(app: *App) -> usize { return countIn(types.OTHER) }
fn name0(app: *App, place: usize) -> []const u8 { return nameIn(app, types.ADJUST, place) }
fn name1(app: *App, place: usize) -> []const u8 { return nameIn(app, types.ARTISTIC, place) }
fn name2(app: *App, place: usize) -> []const u8 { return nameIn(app, types.BLUR, place) }
fn name3(app: *App, place: usize) -> []const u8 { return nameIn(app, types.COLORS, place) }
fn name4(app: *App, place: usize) -> []const u8 { return nameIn(app, types.EDGE, place) }
fn name5(app: *App, place: usize) -> []const u8 { return nameIn(app, types.EMBOSS, place) }
fn name6(app: *App, place: usize) -> []const u8 { return nameIn(app, types.ENHANCE, place) }
fn name7(app: *App, place: usize) -> []const u8 { return nameIn(app, types.MAP, place) }
fn name8(app: *App, place: usize) -> []const u8 { return nameIn(app, types.OTHER, place) }
fn run0(app: *App, place: usize) -> void { runIn(app, types.ADJUST, place) }
fn run1(app: *App, place: usize) -> void { runIn(app, types.ARTISTIC, place) }
fn run2(app: *App, place: usize) -> void { runIn(app, types.BLUR, place) }
fn run3(app: *App, place: usize) -> void { runIn(app, types.COLORS, place) }
fn run4(app: *App, place: usize) -> void { runIn(app, types.EDGE, place) }
fn run5(app: *App, place: usize) -> void { runIn(app, types.EMBOSS, place) }
fn run6(app: *App, place: usize) -> void { runIn(app, types.ENHANCE, place) }
fn run7(app: *App, place: usize) -> void { runIn(app, types.MAP, place) }
fn run8(app: *App, place: usize) -> void { runIn(app, types.OTHER, place) }

// One source a group, in the order of types.ADJUST .. types.OTHER.
const SOURCES = [9]state.MenuSource{
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Adjust|Anpassen", .flags = state.ACTION_SEPARATOR_BEFORE, .count = count0, .name = name0, .run = run0, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Artistic|Künstlerisch", .flags = 0, .count = count1, .name = name1, .run = run1, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Blur|Weichzeichnen", .flags = 0, .count = count2, .name = name2, .run = run2, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Colours|Farben", .flags = 0, .count = count3, .name = name3, .run = run3, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Edge Detection|Kantenerkennung", .flags = 0, .count = count4, .name = name4, .run = run4, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Emboss|Relief", .flags = 0, .count = count5, .name = name5, .run = run5, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Enhance|Verbessern", .flags = 0, .count = count6, .name = name6, .run = run6, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Map|Abbilden", .flags = 0, .count = count7, .name = name7, .run = run7, .checked = null, .enabled = enabledEntry },
    state.MenuSource.{ .menu = state.MENU_FILTER, .submenu = "Other|Sonstige", .flags = 0, .count = count8, .name = name8, .run = run8, .checked = null, .enabled = enabledEntry },
}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
