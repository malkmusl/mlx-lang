// nebula actions: the Help menu: every keyboard shortcut in a list by
// menu (ui/preferences.mlx's showShortcuts, from which they can be
// changed) and what the program is (ui/dialogs.mlx's about). There is no
// handbook to open.
const std = @import("std")
const state = @import("../app/state.mlx")
const preferences = @import("../ui/preferences.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const table = @import("../core/table.mlx")

const App = state.App

fn showShortcuts(app: *App) -> void { _ = preferences.showShortcuts(app) }
fn about(app: *App) -> void { _ = dialogs.about(app) }

const ACTIONS = [2]state.Action{
    state.Action.{ .key = "help_shortcuts", .name = "Keyboard Shortcuts", .german = "Tastenkürzel", .shortcut = "", .menu = state.MENU_HELP, .submenu = "", .flags = 0, .run = showShortcuts, .checked = null, .enabled = null },
    state.Action.{ .key = "help_about", .name = "About Nebula", .german = "Über Nebula", .shortcut = "", .menu = state.MENU_HELP, .submenu = "", .flags = state.ACTION_SEPARATOR_BEFORE, .run = about, .checked = null, .enabled = null },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

const SOURCES = [0]state.MenuSource{}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
