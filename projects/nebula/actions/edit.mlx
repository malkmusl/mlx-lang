// nebula actions: the Edit menu: undo and redo; cut, copy, copy merged
// and the four ways to paste; clear; fill with the foreground colour, the
// background colour or a pattern; stroke the selection's outline.
// Deselecting is the Select menu's.
//
// Every action that changes the image is one step of its history (one
// undo takes it back whole: a paste's new layer and the deselection with
// it). Pixels are taken where the image's selection is (as much as it
// is: a soft edge copies, clears and fills softly), everywhere in the
// image's rectangle when there is none.
//
// The clipboard is app/clipboard.mlx: what is cut or copied keeps its
// place in the image. Paste makes a new layer above the active one with
// the pixels where they came from when that lies inside the image (else
// in the middle of the view) and takes the selection away; Paste at
// Cursor puts their middle under the pointer (in the middle of the view
// when the pointer is not over the canvas); Paste into Active Layer mixes
// them into the active layer at that place (the layer's overlay merged:
// core/ops.mlx's mergeOverlay); Paste into New Image makes a document of
// their size. Paste with no document open does that too. A picture
// another program put on the system's clipboard has no place of its own:
// it goes into the middle of the view.
//
// Fill with Pattern and Stroke Selection ask first, with a form
// (ui/forms.mlx): the pattern (generators/patterns.mlx's built-in ones)
// and its opacity; the line's width, colour (the foreground colour when
// first asked) and where it lies against the outline (inside, centred on
// it, outside). The stroke follows the selection's outline (core/
// selection.mlx's outline(): the edges between pixels selected by half
// or more and the others) made a path of closed rings and stroked with
// mitred corners (core/raster.mlx), drawn only where the selection is
// for a line inside, only where it is not for one outside. A layer whose
// alpha is locked keeps it in the fills and the stroke.
//
// Not done: Paste into Active Layer is not a floating selection to be
// moved before it is set down; a pattern of the person's own (only the
// built-in tiles), its scale and offset; a stroke drawn with the brush.
const std = @import("std")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const documents = @import("../app/documents.mlx")
const clipboard = @import("../app/clipboard.mlx")
const table = @import("../core/table.mlx")
const geom = @import("../core/geom.mlx")
const device_module = @import("../core/device.mlx")
const mask_module = @import("../core/mask.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history_module = @import("../core/history.mlx")
const selection_module = @import("../core/selection.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")
const raster = @import("../core/raster.mlx")
const fill = @import("../core/fill.mlx")
const blend = @import("../core/blend.mlx")
const patterns = @import("../generators/patterns.mlx")
const types = @import("../filters/types.mlx")
const forms = @import("../ui/forms.mlx")
const canvasview = @import("../ui/canvasview.mlx")

pub const App = state.App
const Image = image_module.Image
const Node = node_module.Node
const Device = device_module.Device

const SLOT: usize = state.SLOT_ACTIONS + 1

// Where Stroke Selection's line lies against the outline.
pub const STROKE_INSIDE: usize = 0
pub const STROKE_CENTRED: usize = 1
pub const STROKE_OUTSIDE: usize = 2

// How a paste places what it puts in.
const PASTE_LAYER: u8 = 0
const PASTE_CURSOR: u8 = 1
const PASTE_INTO: u8 = 2

const NONE: usize = 18446744073709551615
// The bytes the pattern names take, one language.
const NAMES: usize = 1024

const Edits = struct {
    // Stroke Selection's numbers (the form edits them in place): width,
    // colour, where; made at the first asking.
    stroke: node_module.Params
    strokeReady: bool
    // Fill with Pattern's: the pattern, its opacity in percent; and its
    // form's rows (the pattern names are known only at run time).
    pattern: node_module.Params
    patternReady: bool
    patternRows: [2]types.Param
    patternNames: [1024]u8
    patternNamesGerman: [1024]u8
}

fn editsOf(app: *App) -> ?*Edits {
    const memory = state.slot(app, SLOT, @sizeOf(Edits))
    if memory == null { return null }
    return unsafe { @ptrCast(*Edits, memory.?) }
}

fn selectionOf(image: *Image) -> ?*Device {
    if image.*.selected { return image.*.selection }
    return null
}

fn noMemory(app: *App) -> void {
    api.say(app, state.tr(app, "Not enough memory", "Nicht genug Speicher"), true)
}

// ---------------------------------------------------------------------------
// Undo and redo

fn undo(app: *App) -> void { api.undo(app) }
fn redo(app: *App) -> void { api.redo(app) }

fn canUndo(app: *App) -> bool {
    const image = api.image(app)
    return image != null && history_module.canUndo(image.?.*.history) && !api.toolBusy(app)
}

fn canRedo(app: *App) -> bool {
    const image = api.image(app)
    return image != null && history_module.canRedo(image.?.*.history) && !api.toolBusy(app)
}

// ---------------------------------------------------------------------------
// Cut and copy

// The active node when its pixels can be copied: a layer that holds
// them, or a mask (not a group, a clone, a fill or filter layer: those
// make their pixels from others). Otherwise null, and the status bar says
// why.
fn copyable(app: *App) -> ?*Node {
    const node = api.activeNode(app)
    if node == null {
        api.say(app, state.tr(app, "There is no layer to copy from", "Es gibt keine Ebene zum Kopieren"), true)
        return null
    }
    const kind = node.?.*.kind
    if node.?.*.device == null || kind == node_module.GROUP || kind == node_module.CLONE || kind == node_module.FILL || kind == node_module.FILTER {
        api.say(app, state.tr(app, "This kind of layer cannot be copied from: use Copy Merged", "Von dieser Art von Ebene kann nicht kopiert werden: Vereint kopieren nutzen"), true)
        return null
    }
    return node
}

// What `source` holds where the image's selection is (the image's
// rectangle without one) goes to the clipboard. False when there was
// nothing (the status bar says so) or no memory.
fn copyOut(app: *App, image: *Image, source: *Device) -> bool {
    const copied = selection_module.copySelected(source, selectionOf(image), image_module.bounds(image))
    if copied == null {
        noMemory(app)
        return false
    }
    if !clipboard.set(app, copied.?) {
        api.say(app, state.tr(app, "There is nothing there to copy", "Dort ist nichts zu kopieren"), false)
        return false
    }
    return true
}

fn saySize(app: *App, first: []const u8) -> void {
    const area = clipboard.bounds(app)
    var text: [96]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 96, first)
    length = std.text.appendUnsigned(bytes, length, 96, @intCast(usize, area.width))
    length = std.text.append(bytes, length, 96, " \xC3\x97 ")
    length = std.text.appendUnsigned(bytes, length, 96, @intCast(usize, area.height))
    length = std.text.append(bytes, length, 96, state.tr(app, " pixels", " Pixel"))
    api.say(app, bytes[0..length], false)
}

fn copy(app: *App) -> void {
    const image = api.image(app)
    if image == null { return }
    const node = copyable(app)
    if node == null { return }
    if copyOut(app, image.?, node.?.*.device.?) { saySize(app, state.tr(app, "Copied ", "Kopiert: ")) }
}

fn cut(app: *App) -> void {
    const image = api.image(app)
    if image == null { return }
    const node = api.paintable(app)
    if node == null || !copyOut(app, image.?, node.?.*.device.?) { return }
    _ = ops.beginPixels(image.?, node.?)
    if !selection_module.clearSelected(node.?.*.device.?, selectionOf(image.?), image_module.bounds(image.?)) {
        api.imageChanged(app, ops.cancelPixels(image.?, node.?))
        noMemory(app)
        return
    }
    api.imageChanged(app, ops.endPixels(image.?, node.?, state.tr(app, "Cut", "Ausschneiden")))
    saySize(app, state.tr(app, "Cut ", "Ausgeschnitten: "))
}

// What all layers together show, where the selection is.
fn copyMerged(app: *App) -> void {
    const image = api.image(app)
    if image == null { return }
    _ = render.update(image.?)
    if copyOut(app, image.?, image.?.*.projection) { saySize(app, state.tr(app, "Copied merged ", "Vereint kopiert: ")) }
}

// ---------------------------------------------------------------------------
// Paste

fn hasClip(app: *App) -> bool { return clipboard.has(app) }

fn hasClipAndDocument(app: *App) -> bool { return api.document(app) != null && clipboard.has(app) }

fn roundOf(value: f64) -> i32 {
    // (The view's centre is held near the image: far inside an i32.)
    if !(value > -1000000000.0) { return -1000000000 }
    if value > 1000000000.0 { return 1000000000 }
    return @intFromFloat(i32, value + if value < 0.0 { -0.5 } else { 0.5 })
}

// Moves the pasted pixels so that their middle is at (x, y).
fn centreAt(pasted: *clipboard.Pasted, x: i32, y: i32) -> void {
    const dx = x - (pasted.*.bounds.x + pasted.*.bounds.width / 2)
    const dy = y - (pasted.*.bounds.y + pasted.*.bounds.height / 2)
    device_module.moveBy(pasted.*.device, dx, dy)
    pasted.*.bounds = geom.moved(pasted.*.bounds, dx, dy)
}

// Where a paste goes (see the header): the pasted pixels moved there.
fn placePasted(app: *App, doc: *state.Document, pasted: *clipboard.Pasted, how: u8) -> void {
    const image = doc.*.image
    if how == PASTE_CURSOR && app.*.pointerInside && geom.contains(app.*.canvasArea, app.*.pointerX, app.*.pointerY) {
        var input: state.Input = undefined
        canvasview.inputAt(app, doc, app.*.pointerX, app.*.pointerY, &input)
        centreAt(pasted, roundOf(input.x - 0.5), roundOf(input.y - 0.5))
        return
    }
    const inside = geom.same(geom.intersect(pasted.*.bounds, image_module.bounds(image)), pasted.*.bounds)
    if how != PASTE_CURSOR && pasted.*.own && inside { return }
    centreAt(pasted, roundOf(doc.*.view.centerX - 0.5), roundOf(doc.*.view.centerY - 0.5))
}

// A new document of the pasted pixels' size holding them (they are its
// from here on, whatever comes).
fn pasteAsImage(app: *App, pasted: *clipboard.Pasted) -> void {
    const area = pasted.*.bounds
    const current = api.image(app)
    const resolution = if current != null { current.?.*.resolution } else { 72.0 }
    const made = image_module.create(app.*.allocator, area.width, area.height, resolution)
    if made == null {
        device_module.destroy(pasted.*.device)
        api.say(app, state.tr(app, "The image could not be made (its size, or memory)", "Das Bild konnte nicht angelegt werden (Größe oder Speicher)"), true)
        return
    }
    const image = made.?
    const layer = ops.newLayer(image, node_module.PAINT, state.tr(app, "Background", "Hintergrund"), state.tr(app, "Paste", "Einfügen"))
    device_module.moveBy(pasted.*.device, 0 - area.x, 0 - area.y)
    const filled = layer != null && device_module.assign(layer.?.*.device.?, pasted.*.device)
    device_module.destroy(pasted.*.device)
    if !filled {
        image_module.destroy(image)
        noMemory(app)
        return
    }
    // A new image has nothing to undo.
    history_module.clear(image.*.history)
    image_module.damageAll(image)
    image.*.modified = false
    app.*.untitled += 1
    var name: [64]u8 = undefined
    const bytes: [*]u8 = &name
    var length = std.text.append(bytes, 0, 64, state.tr(app, "Untitled-", "Unbenannt-"))
    length = std.text.appendUnsigned(bytes, length, 64, @intCast(usize, app.*.untitled))
    if documents.add(app, image, bytes[0..length]) == null { image_module.destroy(image) }
}

// The pasted pixels mixed into the active layer (one step).
fn pasteInto(app: *App, image: *Image, pasted: *clipboard.Pasted) -> void {
    const node = api.paintable(app)
    if node == null || node.?.*.overlay != null {
        if node != null { api.say(app, state.tr(app, "The layer is being painted on", "Auf der Ebene wird gerade gemalt"), true) }
        device_module.destroy(pasted.*.device)
        return
    }
    node.?.*.overlay = pasted.*.device
    node.?.*.overlayBlend = blend.NORMAL
    node.?.*.overlayOpacity = 255
    node.?.*.overlayMasked = false
    api.imageChanged(app, ops.mergeOverlay(image, node.?, state.tr(app, "Paste into layer", "In Ebene einfügen")))
}

// The pasted pixels as a new layer above the active one; the selection
// goes with the same step.
fn pasteAsLayer(app: *App, image: *Image, pasted: *clipboard.Pasted) -> void {
    const layer = node_module.create(app.*.allocator, node_module.PAINT, image_module.newId(image), state.tr(app, "Pasted layer", "Eingefügte Ebene"))
    if layer == null || !device_module.assign(layer.?.*.device.?, pasted.*.device) {
        if layer != null { node_module.destroy(layer.?) }
        device_module.destroy(pasted.*.device)
        noMemory(app)
        return
    }
    device_module.destroy(pasted.*.device)
    const history = image.*.history
    const name = state.tr(app, "Paste", "Einfügen")
    history_module.begin(history, name)
    const place = ops.placeForNew(image)
    if !ops.add(image, layer.?, place.parent, place.index, name) {
        history_module.end(history)
        node_module.destroy(layer.?)
        noMemory(app)
        return
    }
    if image.*.selected {
        ops.beginSelection(image)
        ops.endSelection(image, false, name)
    }
    history_module.end(history)
    api.layersChanged(app)
}

fn pasteWith(app: *App, how: u8) -> void {
    var pasted: clipboard.Pasted = undefined
    if !clipboard.get(app, &pasted) {
        api.say(app, state.tr(app, "The clipboard holds no picture", "In der Zwischenablage ist kein Bild"), true)
        return
    }
    const doc = api.document(app)
    if doc == null {
        pasteAsImage(app, &pasted)
        return
    }
    placePasted(app, doc.?, &pasted, how)
    if how == PASTE_INTO {
        pasteInto(app, doc.?.*.image, &pasted)
    } else {
        pasteAsLayer(app, doc.?.*.image, &pasted)
    }
}

fn paste(app: *App) -> void { pasteWith(app, PASTE_LAYER) }
fn pasteAtCursor(app: *App) -> void { pasteWith(app, PASTE_CURSOR) }
fn pasteIntoLayer(app: *App) -> void { pasteWith(app, PASTE_INTO) }

fn pasteNewImage(app: *App) -> void {
    var pasted: clipboard.Pasted = undefined
    if !clipboard.get(app, &pasted) {
        api.say(app, state.tr(app, "The clipboard holds no picture", "In der Zwischenablage ist kein Bild"), true)
        return
    }
    pasteAsImage(app, &pasted)
}

// ---------------------------------------------------------------------------
// Clear and fill

fn clear(app: *App) -> void {
    const image = api.image(app)
    const node = api.paintable(app)
    if image == null || node == null { return }
    _ = ops.beginPixels(image.?, node.?)
    if !selection_module.clearSelected(node.?.*.device.?, selectionOf(image.?), image_module.bounds(image.?)) {
        api.imageChanged(app, ops.cancelPixels(image.?, node.?))
        noMemory(app)
        return
    }
    api.imageChanged(app, ops.endPixels(image.?, node.?, state.tr(app, "Clear", "Löschen")))
}

fn flagsOf(node: *Node) -> u32 {
    return if node.*.alphaLocked { blend.FLAG_ALPHA_LOCK } else { 0 }
}

// Fills the selection of the active layer (all of the image's rectangle
// without one) with `color`, or with pattern `tile` when it is not null
// (`side_x` x `side_y`, laid from the image's corner), at `opacity`.
fn fillWith(app: *App, color: u32, tile: ?[*]const u32, side_x: i32, side_y: i32, opacity: u32, name: []const u8) -> void {
    const image = api.image(app)
    const node = api.paintable(app)
    if image == null || node == null { return }
    var region = selectionOf(image.?)
    var made: ?*Device = null
    if region == null {
        made = mask_module.create(app.*.allocator, true)
        if made == null {
            noMemory(app)
            return
        }
        region = made
    }
    const target = node.?.*.device.?
    const bounds = image_module.bounds(image.?)
    _ = ops.beginPixels(image.?, node.?)
    if tile != null {
        _ = fill.paintPattern(target, region.?, bounds, tile.?, side_x, side_y, 0, 0, blend.NORMAL, opacity, flagsOf(node.?), null)
    } else {
        _ = fill.paint(target, region.?, bounds, color, blend.NORMAL, opacity, flagsOf(node.?), null)
    }
    api.imageChanged(app, ops.endPixels(image.?, node.?, name))
    if made != null { device_module.destroy(made.?) }
}

fn fillForeground(app: *App) -> void { fillWith(app, app.*.foreground, null, 0, 0, 255, state.tr(app, "Fill with foreground colour", "Mit Vordergrundfarbe füllen")) }
fn fillBackground(app: *App) -> void { fillWith(app, app.*.background, null, 0, 0, 255, state.tr(app, "Fill with background colour", "Mit Hintergrundfarbe füllen")) }

// The form's rows for Fill with Pattern: the patterns by name (known at
// run time), the opacity.
fn patternRows(app: *App, edits: *Edits) -> []const types.Param {
    const english: [*]u8 = &edits.*.patternNames
    const german: [*]u8 = &edits.*.patternNamesGerman
    var english_length: usize = 0
    var german_length: usize = 0
    var index: usize = 0
    while index < patterns.count() {
        if index > 0 {
            english_length = std.text.appendByte(english, english_length, NAMES, 124)
            german_length = std.text.appendByte(german, german_length, NAMES, 124)
        }
        english_length = std.text.append(english, english_length, NAMES, patterns.name(index, false))
        german_length = std.text.append(german, german_length, NAMES, patterns.name(index, true))
        index += 1
    }
    const last = @floatFromInt(f64, patterns.count() - 1)
    edits.*.patternRows[0] = types.Param.{ .name = "Pattern", .german = "Muster", .kind = types.CHOICE, .low = 0.0, .high = last, .initial = 0.0, .choices = english[0..english_length], .choicesGerman = german[0..german_length] }
    edits.*.patternRows[1] = types.Param.{ .name = "Opacity (%)", .german = "Deckkraft (%)", .kind = types.INT, .low = 1.0, .high = 100.0, .initial = 100.0, .choices = "", .choicesGerman = "" }
    const rows: [*]const types.Param = &edits.*.patternRows
    return rows[0..2]
}

fn applyPattern(app: *App) -> void {
    const edits = editsOf(app)
    if edits == null { return }
    const values: [*]const f64 = &edits.?.*.pattern.values
    var chosen: usize = 0
    if values[0] >= 0.0 && values[0] < @floatFromInt(f64, patterns.count()) { chosen = @intFromFloat(usize, values[0]) }
    var percent = values[1]
    if !(percent >= 1.0) { percent = 1.0 }
    if percent > 100.0 { percent = 100.0 }
    var width: usize = 0
    var height: usize = 0
    const tile = patterns.pattern(chosen, &width, &height)
    if tile == null {
        noMemory(app)
        return
    }
    fillWith(app, 0, tile, @intCast(i32, width), @intCast(i32, height), @intFromFloat(u32, percent * 2.55 + 0.5), state.tr(app, "Fill with pattern", "Mit Muster füllen"))
}

fn fillPattern(app: *App) -> void {
    const edits = editsOf(app)
    if edits == null || api.paintable(app) == null { return }
    const rows = patternRows(app, edits.?)
    if !edits.?.*.patternReady {
        node_module.clearParams(&edits.?.*.pattern)
        edits.?.*.pattern.values[0] = @floatFromInt(f64, patterns.BRICKS)
        edits.?.*.pattern.values[1] = 100.0
        edits.?.*.patternReady = true
    }
    const options = forms.FormOptions.{ .onChange = null, .onAccept = applyPattern, .onCancel = null, .preview = null, .reset = false }
    _ = forms.open(app, state.tr(app, "Fill with Pattern", "Mit Muster füllen"), rows, &edits.?.*.pattern, &options)
}

// ---------------------------------------------------------------------------
// Stroke Selection

const STROKE_ROWS = [3]types.Param{
    types.Param.{ .name = "Width (pixels)", .german = "Breite (Pixel)", .kind = types.INT, .low = 1.0, .high = 500.0, .initial = 4.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colour", .german = "Farbe", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4278190080.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Line lies", .german = "Linie liegt", .kind = types.CHOICE, .low = 0.0, .high = 2.0, .initial = 1.0, .choices = "Inside|Centred on the outline|Outside", .choicesGerman = "Innen|Mittig auf dem Umriss|Außen" },
}

var keptStroke: table.Kept = table.Kept.{ .address = 0, .length = 0 }

fn strokeRows() -> []const types.Param {
    if keptStroke.address != 0 { return table.rows(types.Param, &keptStroke) }
    return table.keep(types.Param, &keptStroke, STROKE_ROWS[0..])
}

// Corner (x, y) of the pixel grid as a key.
fn cornerKey(x: i32, y: i32) -> u64 {
    return (@intCast(u64, @bitCast(u32, x)) << 32) | @intCast(u64, @bitCast(u32, y))
}

// The end `end` (0, 1) of segment `index` of `list`.
fn endX(list: []selection_module.Segment, endpoint: usize) -> i32 {
    const segment = &list[endpoint >> 1]
    return if endpoint & 1 == 0 { segment.*.x0 } else { segment.*.x1 }
}

fn endY(list: []selection_module.Segment, endpoint: usize) -> i32 {
    const segment = &list[endpoint >> 1]
    return if endpoint & 1 == 0 { segment.*.y0 } else { segment.*.y1 }
}

// The rings of the outline's segments into `path`: from a segment not
// used yet, on through the segment that meets its end at a corner (where
// four meet, any one not used), until the ring closes. `next` (2 * count
// words) and `used` (count bytes) are working memory; `corners` maps a
// corner to its first segment end there, plus one.
fn chain(path: *raster.Path, list: []selection_module.Segment, corners: *std.AutoHashMap(u64, usize), next: [*]usize, used: [*]u8) -> void {
    const count = list.length
    var start: usize = 0
    while start < count {
        if used[start] != 0 {
            start += 1
            continue
        }
        used[start] = 1
        const first_x = endX(list, start << 1)
        const first_y = endY(list, start << 1)
        var x = endX(list, (start << 1) | 1)
        var y = endY(list, (start << 1) | 1)
        raster.moveTo(path, @floatFromInt(f64, first_x), @floatFromInt(f64, first_y))
        // (The ring's last corner is its first: close() draws that side,
        // a point there again would be a side of no length.)
        var steps: usize = 0
        while (x != first_x || y != first_y) && steps < count {
            raster.lineTo(path, @floatFromInt(f64, x), @floatFromInt(f64, y))
            const head = corners.*.get(cornerKey(x, y))
            var endpoint: usize = if head != null { head.? - 1 } else { NONE }
            while endpoint != NONE && used[endpoint >> 1] != 0 { endpoint = next[endpoint] }
            if endpoint == NONE { break }
            used[endpoint >> 1] = 1
            const other = endpoint ^ 1
            x = endX(list, other)
            y = endY(list, other)
            steps += 1
        }
        raster.close(path)
        start += 1
    }
}

// The outline of the image's selection as a path of closed rings (the
// caller's: raster.destroy). Null without memory or when nothing is
// selected.
fn outlinePath(app: *App, image: *Image) -> ?*raster.Path {
    const allocator = app.*.allocator
    var segments = std.ArrayList(selection_module.Segment).init(allocator)
    defer segments.deinit()
    // (One pixel around the image: an outline along its rim is closed.)
    if !selection_module.outline(image.*.selection, geom.grown(image_module.bounds(image), 1), &segments) { return null }
    const list = segments.items()
    const count = list.length
    if count == 0 { return null }
    const path = raster.create(allocator)
    if path == null { return null }
    var corners = std.AutoHashMap(u64, usize).init(allocator)
    defer corners.deinit()
    const links = allocator.alloc(count * 2 * @sizeOf(usize), 16)
    const marks = allocator.alloc(count, 16)
    var whole = links != null && marks != null && corners.ensureTotalCapacity(count * 2)
    if whole {
        const next: [*]usize = unsafe { @ptrCast([*]usize, links.?) }
        std.mem.zero(marks.?, count)
        var endpoint: usize = 0
        while endpoint < count * 2 && whole {
            const key = cornerKey(endX(list, endpoint), endY(list, endpoint))
            const head = corners.get(key)
            next[endpoint] = if head != null { head.? - 1 } else { NONE }
            whole = corners.put(key, endpoint + 1)
            endpoint += 1
        }
        if whole { chain(path.?, list, &corners, next, marks.?) }
    }
    if links != null { allocator.free(links.?, count * 2 * @sizeOf(usize), 16) }
    if marks != null { allocator.free(marks.?, count, 16) }
    if !whole || raster.failed(path.?) {
        raster.destroy(path.?)
        return null
    }
    return path
}

// Strokes the image's selection on the active layer with a line `width`
// pixels wide of `color` (straight), lying as `where` says (STROKE_*):
// one step. False when there is no selection or layer to stroke on, or
// without memory (the status bar says which).
pub fn strokeSelected(app: *App, width: f64, color: u32, where: usize) -> bool {
    const image = api.image(app)
    if image == null { return false }
    if !image.?.*.selected {
        api.say(app, state.tr(app, "There is no selection to stroke", "Es gibt keine Auswahl zum Nachziehen"), true)
        return false
    }
    const node = api.paintable(app)
    if node == null { return false }
    const path = outlinePath(app, image.?)
    if path == null {
        noMemory(app)
        return false
    }
    // A line on one side is drawn twice as wide about the outline and cut
    // by the selection (inside) or by what it leaves (outside).
    var style = raster.solid(if where == STROKE_CENTRED { width } else { width * 2.0 })
    style.join = raster.JOIN_MITER
    var mask: ?*Device = null
    var outside: ?*Device = null
    if where == STROKE_INSIDE { mask = image.?.*.selection }
    if where == STROKE_OUTSIDE {
        outside = device_module.copy(image.?.*.selection)
        if outside == null || !selection_module.invert(outside.?, image_module.bounds(image.?)) {
            if outside != null { device_module.destroy(outside.?) }
            raster.destroy(path.?)
            noMemory(app)
            return false
        }
        mask = outside
    }
    _ = ops.beginPixels(image.?, node.?)
    _ = raster.strokeDevice(node.?.*.device.?, path.?, &style, true, image_module.bounds(image.?), color, blend.NORMAL, 255, flagsOf(node.?), mask)
    api.imageChanged(app, ops.endPixels(image.?, node.?, state.tr(app, "Stroke selection", "Auswahl nachziehen")))
    if outside != null { device_module.destroy(outside.?) }
    raster.destroy(path.?)
    return true
}

fn applyStroke(app: *App) -> void {
    const edits = editsOf(app)
    if edits == null { return }
    const values: [*]const f64 = &edits.?.*.stroke.values
    var width = values[0]
    if !(width >= 1.0) { width = 1.0 }
    if width > 500.0 { width = 500.0 }
    var color: u32 = 0xFF000000
    if values[1] >= 0.0 && values[1] <= 4294967295.0 { color = @intFromFloat(u32, values[1]) }
    var where = STROKE_CENTRED
    if values[2] >= -0.5 && values[2] < 2.5 { where = @intFromFloat(usize, values[2] + 0.5) }
    _ = strokeSelected(app, width, color, where)
}

fn strokeSelection(app: *App) -> void {
    const edits = editsOf(app)
    if edits == null || api.paintable(app) == null { return }
    if !edits.?.*.strokeReady {
        node_module.clearParams(&edits.?.*.stroke)
        edits.?.*.stroke.values[0] = 4.0
        edits.?.*.stroke.values[2] = @floatFromInt(f64, STROKE_CENTRED)
        edits.?.*.strokeReady = true
    }
    // The foreground colour proposed each time.
    edits.?.*.stroke.values[1] = @floatFromInt(f64, app.*.foreground)
    const options = forms.FormOptions.{ .onChange = null, .onAccept = applyStroke, .onCancel = null, .preview = null, .reset = false }
    _ = forms.open(app, state.tr(app, "Stroke Selection", "Auswahl nachziehen"), strokeRows(), &edits.?.*.stroke, &options)
}

