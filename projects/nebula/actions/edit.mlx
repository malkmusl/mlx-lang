    state.Action.{ .key = "edit_paste_at_cursor", .name = "Paste at Cursor", .german = "Am Zeiger einfügen", .shortcut = "Ctrl+Alt+V", .menu = state.MENU_EDIT, .submenu = "", .flags = state.ACTION_NEEDS_DOCUMENT, .run = pasteAtCursor, .checked = null, .enabled = hasClipAndDocument },
