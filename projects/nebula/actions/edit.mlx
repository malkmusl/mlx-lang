    state.Action.{ .key = "edit_cut", .name = "Cut", .german = "Ausschneiden", .shortcut = "Ctrl+X", .menu = state.MENU_EDIT, .submenu = "", .flags = state.ACTION_SEPARATOR_BEFORE | state.ACTION_NEEDS_LAYER, .run = cut, .checked = null, .enabled = null },
