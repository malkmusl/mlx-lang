    state.Action.{ .key = "edit_fill_background", .name = "Fill with Background Colour", .german = "Mit Hintergrundfarbe füllen", .shortcut = "Backspace", .menu = state.MENU_EDIT, .submenu = "", .flags = state.ACTION_NEEDS_LAYER, .run = fillBackground, .checked = null, .enabled = null },
