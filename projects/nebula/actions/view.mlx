// nebula actions: the View menu: how the document in front is looked at
// (zoom, turn, mirror: ui/canvasview.mlx's commands, the same with keys
// as with the wheel and the hand, for brixOS has no wheel), what is shown
// over it (grid, rulers, guides, the pixel grid, the image repeated
// around itself), what is shown of the window (the canvas only, the whole
// screen) and the dockers (a submenu with one entry a registered docker,
// checked while it is shown: ui/docks.mlx).
//
//     Zoom In Ctrl++, Zoom Out Ctrl+-, Fit Page Ctrl+0, Fit Width,
//     Actual Pixels 1; Rotate Left 4, Rotate Right 6 (15 degrees), Reset
//     Rotation 5; Mirror View M; Canvas Only Tab; Full Screen
//     Ctrl+Shift+F; Show Grid Ctrl+Shift+'; Rulers, Guides, Pixel Grid;
//     Wrap Around W.
//
// The entries that switch something on and off are checked while it is
// on. Whether the window is full screen is kept here (the shell does not
// say).
const std = @import("std")
const math = @import("std.math")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const shell_module = @import("../app/shell.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const docks = @import("../ui/docks.mlx")
const dockers = @import("../dockers/registry.mlx")
const table = @import("../core/table.mlx")

const App = state.App

// The module's slot (module 2 of actions/registry.mlx).
const SLOT: usize = state.SLOT_ACTIONS + 2

const Store = struct {
    fullscreen: bool
}

fn storeOf(app: *App) -> ?*Store {
    const memory = state.slot(app, SLOT, @sizeOf(Store))
    if memory == null { return null }
    return unsafe { @ptrCast(*Store, memory.?) }
}

// One notch of turning: 15 degrees.
const NOTCH: f64 = math.pi / 12.0

fn zoomIn(app: *App) -> void { canvasview.zoomIn(app) }
fn zoomOut(app: *App) -> void { canvasview.zoomOut(app) }
fn fitPage(app: *App) -> void { canvasview.fitPage(app) }
fn fitWidth(app: *App) -> void { canvasview.fitWidth(app) }
fn actualSize(app: *App) -> void { canvasview.actualSize(app) }
fn rotateLeft(app: *App) -> void { canvasview.rotateBy(app, -NOTCH) }
fn rotateRight(app: *App) -> void { canvasview.rotateBy(app, NOTCH) }
fn resetRotation(app: *App) -> void { canvasview.resetRotation(app) }
fn mirror(app: *App) -> void { canvasview.toggleMirror(app) }

fn mirrored(app: *App) -> bool {
    const doc = api.document(app)
    return doc != null && doc.?.*.view.mirror
}

fn turned(app: *App) -> bool {
    const doc = api.document(app)
    return doc != null && doc.?.*.view.rotation != 0.0
}

fn canvasOnly(app: *App) -> void {
    app.*.canvasOnly = !app.*.canvasOnly
    api.redraw(app)
}

fn isCanvasOnly(app: *App) -> bool { return app.*.canvasOnly }

fn fullscreen(app: *App) -> void {
    const store = storeOf(app)
    if store == null { return }
    store.?.*.fullscreen = !store.?.*.fullscreen
    shell_module.setFullscreen(app.*.shell, store.?.*.fullscreen)
    api.redraw(app)
}

fn isFullscreen(app: *App) -> bool {
    const store = storeOf(app)
    return store != null && store.?.*.fullscreen
}

fn grid(app: *App) -> void {
    const doc = api.document(app)
    if doc == null { return }
    doc.?.*.showGrid = !doc.?.*.showGrid
    api.redraw(app)
}

fn showsGrid(app: *App) -> bool {
    const doc = api.document(app)
    return doc != null && doc.?.*.showGrid
}

fn rulers(app: *App) -> void {
    const doc = api.document(app)
    if doc == null { return }
    doc.?.*.showRulers = !doc.?.*.showRulers
    api.redraw(app)
}

fn showsRulers(app: *App) -> bool {
    const doc = api.document(app)
    return doc != null && doc.?.*.showRulers
}

fn guides(app: *App) -> void {
    const doc = api.document(app)
    if doc == null { return }
    doc.?.*.showGuides = !doc.?.*.showGuides
    api.redraw(app)
}

fn showsGuides(app: *App) -> bool {
    const doc = api.document(app)
    return doc != null && doc.?.*.showGuides
}

fn pixelGrid(app: *App) -> void { canvasview.setPixelGrid(app, !canvasview.pixelGrid(app)) }

fn showsPixelGrid(app: *App) -> bool { return api.document(app) != null && canvasview.pixelGrid(app) }

fn wrapAround(app: *App) -> void {
    app.*.wrapAround = !app.*.wrapAround
    api.redraw(app)
}

fn isWrapping(app: *App) -> bool { return app.*.wrapAround }

fn showAllDockers(app: *App) -> void { docks.showAll(app) }
fn hideAllDockers(app: *App) -> void { docks.hideAll(app) }

const NEEDS_DOCUMENT = state.ACTION_NEEDS_DOCUMENT
const CHECKABLE = state.ACTION_CHECKABLE
const SEPARATOR = state.ACTION_SEPARATOR_BEFORE
const DOCKERS: []const u8 = "Dockers|Docker"

const ACTIONS = [18]state.Action{
    state.Action.{ .key = "view_canvas_only", .name = "Canvas Only", .german = "Nur Arbeitsfläche", .shortcut = "Tab", .menu = state.MENU_VIEW, .submenu = "", .flags = CHECKABLE, .run = canvasOnly, .checked = isCanvasOnly, .enabled = null },
    state.Action.{ .key = "view_fullscreen", .name = "Full Screen", .german = "Vollbild", .shortcut = "Ctrl+Shift+F", .menu = state.MENU_VIEW, .submenu = "", .flags = CHECKABLE, .run = fullscreen, .checked = isFullscreen, .enabled = null },
    state.Action.{ .key = "view_wrap_around", .name = "Wrap Around", .german = "Endlos wiederholen", .shortcut = "W", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | CHECKABLE, .run = wrapAround, .checked = isWrapping, .enabled = null },
    state.Action.{ .key = "view_zoom_in", .name = "Zoom In", .german = "Vergrößern", .shortcut = "Ctrl++", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | SEPARATOR, .run = zoomIn, .checked = null, .enabled = null },
    state.Action.{ .key = "view_zoom_out", .name = "Zoom Out", .german = "Verkleinern", .shortcut = "Ctrl+-", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT, .run = zoomOut, .checked = null, .enabled = null },
    state.Action.{ .key = "view_zoom_actual", .name = "Actual Pixels", .german = "Originalgröße", .shortcut = "1", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT, .run = actualSize, .checked = null, .enabled = null },
    state.Action.{ .key = "view_zoom_fit", .name = "Fit Page", .german = "Ganzes Bild", .shortcut = "Ctrl+0", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT, .run = fitPage, .checked = null, .enabled = null },
    state.Action.{ .key = "view_zoom_width", .name = "Fit Width", .german = "Bildbreite", .shortcut = "", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT, .run = fitWidth, .checked = null, .enabled = null },
    state.Action.{ .key = "view_rotate_left", .name = "Rotate Canvas Left", .german = "Arbeitsfläche nach links drehen", .shortcut = "4", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | SEPARATOR, .run = rotateLeft, .checked = null, .enabled = null },
    state.Action.{ .key = "view_rotate_right", .name = "Rotate Canvas Right", .german = "Arbeitsfläche nach rechts drehen", .shortcut = "6", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT, .run = rotateRight, .checked = null, .enabled = null },
    state.Action.{ .key = "view_rotate_reset", .name = "Reset Rotation", .german = "Drehung zurücksetzen", .shortcut = "5", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT, .run = resetRotation, .checked = null, .enabled = turned },
    state.Action.{ .key = "view_mirror", .name = "Mirror View", .german = "Ansicht spiegeln", .shortcut = "M", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | CHECKABLE, .run = mirror, .checked = mirrored, .enabled = null },
    state.Action.{ .key = "view_grid", .name = "Show Grid", .german = "Raster anzeigen", .shortcut = "Ctrl+Shift+'", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | CHECKABLE | SEPARATOR, .run = grid, .checked = showsGrid, .enabled = null },
    state.Action.{ .key = "view_pixel_grid", .name = "Show Pixel Grid", .german = "Pixelraster anzeigen", .shortcut = "", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | CHECKABLE, .run = pixelGrid, .checked = showsPixelGrid, .enabled = null },
    state.Action.{ .key = "view_guides", .name = "Show Guides", .german = "Hilfslinien anzeigen", .shortcut = "", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | CHECKABLE, .run = guides, .checked = showsGuides, .enabled = null },
    state.Action.{ .key = "view_rulers", .name = "Show Rulers", .german = "Lineale anzeigen", .shortcut = "", .menu = state.MENU_VIEW, .submenu = "", .flags = NEEDS_DOCUMENT | CHECKABLE, .run = rulers, .checked = showsRulers, .enabled = null },
    state.Action.{ .key = "view_dockers_show", .name = "Show All", .german = "Alle zeigen", .shortcut = "", .menu = state.MENU_VIEW, .submenu = DOCKERS, .flags = SEPARATOR, .run = showAllDockers, .checked = null, .enabled = null },
    state.Action.{ .key = "view_dockers_hide", .name = "Hide All", .german = "Alle ausblenden", .shortcut = "", .menu = state.MENU_VIEW, .submenu = DOCKERS, .flags = 0, .run = hideAllDockers, .checked = null, .enabled = null },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

// ---------------------------------------------------------------------------
// The dockers' list

fn dockerCount(app: *App) -> usize { return dockers.count() }

fn dockerName(app: *App, index: usize) -> []const u8 {
    const docker = dockers.at(index)
    if docker == null { return "" }
    return state.tr(app, docker.?.*.name, docker.?.*.german)
}

fn dockerToggle(app: *App, index: usize) -> void {
    const docker = dockers.at(index)
    if docker != null { docks.toggle(app, docker.?.*.id) }
}

fn dockerShown(app: *App, index: usize) -> bool {
    const docker = dockers.at(index)
    return docker != null && docks.isShown(app, docker.?.*.id)
}

const SOURCES = [1]state.MenuSource{
    state.MenuSource.{ .menu = state.MENU_VIEW, .submenu = DOCKERS, .flags = SEPARATOR, .count = dockerCount, .name = dockerName, .run = dockerToggle, .checked = dockerShown, .enabled = null },
}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
