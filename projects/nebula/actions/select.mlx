// nebula actions: the Select menu: the image's selection made, joined,
// changed and shown. Every change is one step of the history (between
// ops.beginSelection and ops.endSelection) named as its entry, and the
// work is core/selection.mlx's:
//
//   Select All (Ctrl+A), Deselect (Ctrl+Shift+A), Reselect (Ctrl+Shift+D:
//   the selection Deselect took away last, kept here for the image it
//   was taken from), Invert Selection (Ctrl+I);
//   Select Opaque ▸ Replace, Add, Subtract, Intersect: the active layer's
//   alpha as a selection;
//   Select from Colour Range…: a dialog with a picture of the layer (or
//   of the whole image) in which a click or a drag picks the colour, the
//   colour also chosen in the colour dialog or taken from the foreground,
//   the range and the softness of what counts as like it, and how it
//   joins the selection; the picture shows what will be selected while
//   the numbers change (selection.fromColor on OK);
//   Feather Selection… (Shift+F6), Grow Selection…, Shrink Selection…,
//   Border Selection…: a dialog asking for a number of pixels (typing digits
//   replaces it at once, Up and Down step it, Enter applies), Shrink with
//   "from the image's edge too"; Smooth;
//   Display Selection (Ctrl+H): the document shows its selection's
//   outline or not.
//
// The numbers asked last are offered again. The dialogs are
// dialogs.host() bodies drawn with the kit.
//
// Not here: scaling the selection (Select > Scale: the transform tool's).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const kit_module = @import("../ui/kit.mlx")
const table = @import("../core/table.mlx")
const selection = @import("../core/selection.mlx")
const device_module = @import("../core/device.mlx")
const image_module = @import("../core/image.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const color_module = @import("../core/color.mlx")
const render = @import("../core/render.mlx")

const App = state.App
const Image = image_module.Image
const Device = device_module.Device

// The module's slot (module 5 of actions/registry.mlx).
const SLOT: usize = state.SLOT_ACTIONS + 5
// The dialogs' kinds for dialogs.find (theirs are below 16, a form's 16).
const KIND_ASK: u8 = 40
const KIND_RANGE: u8 = 41

// What the number dialog changes.
const OP_FEATHER: u8 = 0
const OP_GROW: u8 = 1
const OP_SHRINK: u8 = 2
const OP_BORDER: u8 = 3

// The colour range dialog's picture: its largest size (logical pixels),
// the words kept for it.
const THUMB_WIDTH: i32 = 452
const THUMB_HEIGHT: i32 = 200
const THUMB_WORDS: usize = 90400

const Store = struct {
    // The slot comes zeroed: the numbers are set at the first asking.
    ready: bool
    // What Deselect took away last (a Device's address; 0: nothing) and
    // the number of the image it was taken from.
    reselect: usize
    reselectImage: u64
    // The numbers asked last.
    feather: f64
    grow: f64
    shrink: f64
    border: f64
    fromEdge: bool
    rangeColor: u32
    rangeThreshold: f64
    rangeSoftness: f64
    rangeMode: usize
    rangeSample: usize
    // The colour range dialog's picture (straight pixels, heap memory
    // made at its first opening and kept).
    thumb: usize
}

fn storeOf(app: *App) -> ?*Store {
    const memory = state.slot(app, SLOT, @sizeOf(Store))
    if memory == null { return null }
    const store: *Store = unsafe { @ptrCast(*Store, memory.?) }
    if !store.*.ready {
        store.*.ready = true
        store.*.feather = 5.0
        store.*.grow = 4.0
        store.*.shrink = 4.0
        store.*.border = 4.0
        store.*.fromEdge = false
        store.*.rangeColor = 0
        store.*.rangeThreshold = 32.0
        store.*.rangeSoftness = 16.0
        store.*.rangeMode = 0
        store.*.rangeSample = 0
    }
    return store
}

fn noMemory(app: *App) -> void {
    api.say(app, state.tr(app, "There is not enough memory to change the selection", "Zum Ändern der Auswahl fehlt Speicher"), true)
}

// The image's selection changed by `done` (false: memory ran out, it is
// put back) as one step `name`; `selected`: there is one after it.
fn settle(app: *App, image: *Image, done: bool, selected: bool, name: []const u8) -> void {
    if !done {
        ops.cancelSelection(image)
        noMemory(app)
    } else {
        ops.endSelection(image, selected, name)
    }
    api.canvasChanged(app)
    api.redraw(app)
}

// ---------------------------------------------------------------------------
// All, none, again, inverted

fn selectAll(app: *App) -> void {
    const image = api.image(app)
    if image == null { return }
    ops.beginSelection(image.?)
    settle(app, image.?, selection.selectAll(image.?.*.selection, image_module.bounds(image.?)), true, state.tr(app, "Select All", "Alles auswählen"))
}

fn deselect(app: *App) -> void {
    const image = api.image(app)
    const store = storeOf(app)
    if image == null || !image.?.*.selected { return }
    // Kept for Reselect (a copy shares the mask's tiles).
    if store != null {
        const kept = device_module.copy(image.?.*.selection)
        if kept != null {
            if store.?.*.reselect != 0 { device_module.destroy(unsafe { @ptrFromInt(*Device, store.?.*.reselect) }) }
            store.?.*.reselect = @intFromPtr(kept.?)
            store.?.*.reselectImage = image.?.*.number
        }
    }
    ops.beginSelection(image.?)
    settle(app, image.?, true, false, state.tr(app, "Deselect", "Auswahl aufheben"))
}

// What Deselect kept for the image in front (null: nothing).
fn keptSelection(app: *App) -> ?*Device {
    var found: ?*Device = null
    const image = api.image(app)
    const store = storeOf(app)
    if image == null || store == null || store.?.*.reselect == 0 || store.?.*.reselectImage != image.?.*.number { return found }
    found = unsafe { @ptrFromInt(*Device, store.?.*.reselect) }
    return found
}

fn canReselect(app: *App) -> bool { return keptSelection(app) != null }

fn reselect(app: *App) -> void {
    const image = api.image(app)
    const kept = keptSelection(app)
    if image == null || kept == null { return }
    ops.beginSelection(image.?)
    var done = selection.combine(image.?.*.selection, kept.?, selection.REPLACE)
    if done { done = selection.clip(image.?.*.selection, image_module.bounds(image.?)) }
    settle(app, image.?, done, true, state.tr(app, "Reselect", "Erneut auswählen"))
}

fn invert(app: *App) -> void {
    const image = api.image(app)
    if image == null { return }
    ops.beginSelection(image.?)
    // (No selection is none of the mask: inverted it is all.)
    settle(app, image.?, selection.invert(image.?.*.selection, image_module.bounds(image.?)), true, state.tr(app, "Invert Selection", "Auswahl umkehren"))
}

// ---------------------------------------------------------------------------
// Opaque

fn hasPixels(app: *App) -> bool {
    const node = api.activeNode(app)
    return node != null && node.?.*.device != null
}

fn selectOpaque(app: *App, mode: u8, name: []const u8) -> void {
    const image = api.image(app)
    const node = api.activeNode(app)
    if image == null || node == null || node.?.*.device == null { return }
    ops.beginSelection(image.?)
    var done = selection.fromAlpha(image.?.*.selection, node.?.*.device.?, mode)
    if done { done = selection.clip(image.?.*.selection, image_module.bounds(image.?)) }
    settle(app, image.?, done, true, name)
}

fn opaqueReplace(app: *App) -> void { selectOpaque(app, selection.REPLACE, state.tr(app, "Select Opaque", "Deckendes auswählen")) }
fn opaqueAdd(app: *App) -> void { selectOpaque(app, selection.ADD, state.tr(app, "Select Opaque (Add)", "Deckendes auswählen (hinzufügen)")) }
fn opaqueSubtract(app: *App) -> void { selectOpaque(app, selection.SUBTRACT, state.tr(app, "Select Opaque (Subtract)", "Deckendes auswählen (abziehen)")) }
fn opaqueIntersect(app: *App) -> void { selectOpaque(app, selection.INTERSECT, state.tr(app, "Select Opaque (Intersect)", "Deckendes auswählen (Schnittmenge)")) }

// ---------------------------------------------------------------------------
// The outline changed: a number of pixels asked for

const Ask = struct {
    op: u8
    value: f64
    // Nothing was typed or dragged yet: a digit replaces the number.
    fresh: bool
    fromEdge: bool
    labels: [2][]const u8
}

fn askOf(app: *App, level: usize) -> *Ask { return unsafe { @ptrCast(*Ask, dialogs.body(app, level)) } }

fn opTitle(app: *App, op: u8) -> []const u8 {
    if op == OP_FEATHER { return state.tr(app, "Feather Selection", "Auswahl weichzeichnen") }
    if op == OP_GROW { return state.tr(app, "Grow Selection", "Auswahl vergrößern") }
    if op == OP_SHRINK { return state.tr(app, "Shrink Selection", "Auswahl verkleinern") }
    return state.tr(app, "Border Selection", "Auswahlrand")
}

fn opLabel(app: *App, op: u8) -> []const u8 {
    if op == OP_FEATHER { return state.tr(app, "Radius", "Radius") }
    if op == OP_GROW { return state.tr(app, "Grow by", "Vergrößern um") }
    if op == OP_SHRINK { return state.tr(app, "Shrink by", "Verkleinern um") }
    return state.tr(app, "Border width", "Randbreite")
}

fn largest() -> f64 { return @floatFromInt(f64, selection.LARGEST_RADIUS) }

fn heldNumber(value: f64) -> f64 {
    if !(value >= 1.0) { return 1.0 }
    if value > largest() { return largest() }
    return @floor(value + 0.5)
}

fn ask(app: *App, op: u8) -> void {
    const store = storeOf(app)
    const image = api.image(app)
    if store == null || image == null || !image.?.*.selected { return }
    const hooks = dialogs.Hooks.{ .kind = KIND_ASK, .draw = drawAsk, .key = keyAsk, .finish = finishAsk, .tabs = true, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(Ask))
    if level == null { return }
    const body = askOf(app, level.?)
    body.*.op = op
    body.*.fresh = true
    body.*.fromEdge = store.?.*.fromEdge
    body.*.value = if op == OP_FEATHER { store.?.*.feather } else if op == OP_GROW { store.?.*.grow } else if op == OP_SHRINK { store.?.*.shrink } else { store.?.*.border }
}

fn askFeather(app: *App) -> void { ask(app, OP_FEATHER) }
fn askGrow(app: *App) -> void { ask(app, OP_GROW) }
fn askShrink(app: *App) -> void { ask(app, OP_SHRINK) }
fn askBorder(app: *App) -> void { ask(app, OP_BORDER) }

fn drawAsk(app: *App, level: usize, window: ui.Rect) -> void {
    const body = askOf(app, level)
    const kit = api.kit(app)
    const s = state.themeOf(app).*.scale
    const row = dialogs.ROW * s
    const step = (dialogs.ROW + dialogs.GAP) * s
    const hint = 18 * s
    var natural = step + hint
    if body.*.op == OP_SHRINK { natural += step }
    var content = dialogs.frame(app, window, opTitle(app, body.*.op), 400 * s, dialogs.framed(app, natural))
    body.*.labels[0] = "OK"
    body.*.labels[1] = state.tr(app, "Cancel", "Abbrechen")
    const labels: [*][]const u8 = &body.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 0)
    var rows = dialogs.scrollBegin(app, content, natural)
    const field = dialogs.labelled(app, &rows, opLabel(app, body.*.op), row)
    var options = kit_module.sliderOptions(1.0, largest(), 1.0, 0)
    // The bar shows the usual widths; a typed number goes up to the most.
    options.softLow = 1.0
    options.softHigh = 100.0
    options.suffix = " px"
    if kit_module.slider(kit, dialogs.idOf(app, level, dialogs.PART_FIELD), field, "", &body.*.value, &options) { body.*.fresh = false }
    if body.*.op == OP_SHRINK {
        const box = dialogs.labelled(app, &rows, "", row)
        _ = kit_module.checkBox(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + 1), box, state.tr(app, "Shrink from the image's edge too", "Auch vom Bildrand her verkleinern"), &body.*.fromEdge)
    }
    const note = ui.takeTop(&rows, hint)
    kit_module.label(kit, note, state.tr(app, "Type a number; Enter applies it.", "Zahl tippen; die Eingabetaste wendet sie an."), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}

// Digits typed replace the number (the first) or go on it; Backspace
// takes the last one away; Up and Down step it (with Shift by ten).
fn keyAsk(app: *App, level: usize, code: u32, modifiers: u32, typed: []const u8) -> bool {
    if modifiers & (keys.CONTROL | keys.ALT | keys.SUPER) != 0 { return false }
    const body = askOf(app, level)
    if typed.length == 1 && typed[0] >= 48 && typed[0] <= 57 {
        const digit = @floatFromInt(f64, typed[0] - 48)
        var value = if body.*.fresh { digit } else { @floor(body.*.value) * 10.0 + digit }
        if value > largest() { value = largest() }
        body.*.value = value
        body.*.fresh = false
        return true
    }
    if code == keys.BACKSPACE {
        body.*.value = if body.*.fresh { 0.0 } else { @floor(@floor(body.*.value) / 10.0) }
        body.*.fresh = false
        return true
    }
    if code == keys.UP || code == keys.DOWN {
        const amount: f64 = if modifiers & keys.SHIFT != 0 { 10.0 } else { 1.0 }
        body.*.value = heldNumber(if code == keys.UP { body.*.value + amount } else { body.*.value - amount })
        body.*.fresh = false
        return true
    }
    return false
}

fn finishAsk(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const body = askOf(app, level)
    const op = body.*.op
    const amount = heldNumber(body.*.value)
    const from_edge = body.*.fromEdge
    const store = storeOf(app)
    const image = api.image(app)
    if store == null || image == null || !image.?.*.selected { return }
    const pixels = @intFromFloat(i32, amount)
    const bounds = image_module.bounds(image.?)
    const mask = image.?.*.selection
    ops.beginSelection(image.?)
    var done = true
    if op == OP_FEATHER {
        store.?.*.feather = amount
        done = selection.feather(mask, amount)
    } else if op == OP_GROW {
        store.?.*.grow = amount
        done = selection.grow(mask, pixels)
    } else if op == OP_SHRINK {
        store.?.*.shrink = amount
        store.?.*.fromEdge = from_edge
        done = selection.shrink(mask, pixels, bounds, from_edge)
    } else {
        store.?.*.border = amount
        done = selection.border(mask, pixels)
    }
    // (What grew may reach past the image's edge.)
    if done { done = selection.clip(mask, bounds) }
    settle(app, image.?, done, true, opTitle(app, op))
}

fn smooth(app: *App) -> void {
    const image = api.image(app)
    if image == null || !image.?.*.selected { return }
    ops.beginSelection(image.?)
    settle(app, image.?, selection.smooth(image.?.*.selection), true, state.tr(app, "Smooth Selection", "Auswahl glätten"))
}

// ---------------------------------------------------------------------------
// Select from Colour Range

const Range = struct {
    color: u32
    threshold: f64
    softness: f64
    mode: usize
    sample: usize
    // The picture: its size, and for which sample it was made (a sample
    // number past the last: not made yet).
    width: i32
    height: i32
    madeFor: usize
    // How much of the picture is selected with the numbers now, of 1000.
    share: u32
    app: usize
    hex: [16]u8
    note: [96]u8
    labels: [2][]const u8
}

fn rangeOf(app: *App, level: usize) -> *Range { return unsafe { @ptrCast(*Range, dialogs.body(app, level)) } }

fn thumbOf(store: *Store) -> [*]u32 { return unsafe { @ptrFromInt([*]u32, store.*.thumb) } }

fn modeName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == 1 { return state.tr(app, "Add", "Hinzufügen") }
    if index == 2 { return state.tr(app, "Subtract", "Abziehen") }
    if index == 3 { return state.tr(app, "Intersect", "Schnittmenge") }
    return state.tr(app, "Replace", "Ersetzen")
}

fn sampleName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    if index == 1 { return state.tr(app, "Whole image", "Ganzes Bild") }
    return state.tr(app, "Current layer", "Aktuelle Ebene")
}

fn modeOf(index: usize) -> u8 {
    if index == 1 { return selection.ADD }
    if index == 2 { return selection.SUBTRACT }
    if index == 3 { return selection.INTERSECT }
    return selection.REPLACE
}

// What is sampled: the active layer's pixels (when it has any and the
// layer is asked for), else what the image shows.
fn sampled(app: *App, image: *Image, sample: usize) -> *Device {
    const node = api.activeNode(app)
    if sample == 0 && node != null && node.?.*.device != null { return node.?.*.device.? }
    _ = render.update(image)
    return image.*.projection
}

inline fn apart(a: u32, b: u32) -> u32 { return if a > b { a - b } else { b - a } }

// How much a straight pixel counts as like `wanted` (premultiplied):
// selection.fromColor's rule.
fn likeness(value: u32, wanted: u32, threshold: u32, softness: u32) -> u32 {
    const own = pixel.premultiplied(value)
    var distance = apart(own >> 24, wanted >> 24)
    distance = pixel.larger(distance, apart(pixel.red(own), pixel.red(wanted)))
    distance = pixel.larger(distance, apart(pixel.green(own), pixel.green(wanted)))
    distance = pixel.larger(distance, apart(pixel.blue(own), pixel.blue(wanted)))
    if distance <= threshold { return 255 }
    const past = distance - threshold
    if past >= softness { return 0 }
    return (255 * (softness - past) + softness / 2) / softness
}

fn byte(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 255.0 { return 255 }
    return @intFromFloat(u32, value + 0.5)
}

// The picture made of `source` for `image`: the image fitted into the
// largest size (made larger when it is small), a pixel each.
fn makeThumb(store: *Store, range: *Range, image: *Image, source: *Device) -> void {
    const w = @floatFromInt(f64, image.*.width)
    const h = @floatFromInt(f64, image.*.height)
    var factor = @floatFromInt(f64, THUMB_WIDTH) / w
    if @floatFromInt(f64, THUMB_HEIGHT) / h < factor { factor = @floatFromInt(f64, THUMB_HEIGHT) / h }
    var width = @intFromFloat(i32, w * factor + 0.5)
    var height = @intFromFloat(i32, h * factor + 0.5)
    if width < 1 { width = 1 }
    if height < 1 { height = 1 }
    if width > THUMB_WIDTH { width = THUMB_WIDTH }
    if height > THUMB_HEIGHT { height = THUMB_HEIGHT }
    range.*.width = width
    range.*.height = height
    const thumb = thumbOf(store)
    var v: i32 = 0
    while v < height {
        var y = @intFromFloat(i32, (@floatFromInt(f64, v) + 0.5) / factor)
        if y >= image.*.height { y = image.*.height - 1 }
        var u: i32 = 0
        while u < width {
            var x = @intFromFloat(i32, (@floatFromInt(f64, u) + 0.5) / factor)
            if x >= image.*.width { x = image.*.width - 1 }
            thumb[@intCast(usize, v * width + u)] = device_module.pixel(source, x, y)
            u += 1
        }
        v += 1
    }
}

fn selectColorRange(app: *App) -> void {
    const store = storeOf(app)
    const image = api.image(app)
    if store == null || image == null { return }
    if store.?.*.thumb == 0 {
        const memory = app.*.allocator.alloc(THUMB_WORDS * 4, 16)
        if memory == null {
            noMemory(app)
            return
        }
        store.?.*.thumb = @intFromPtr(memory.?)
    }
    const hooks = dialogs.Hooks.{ .kind = KIND_RANGE, .draw = drawRange, .key = null, .finish = finishRange, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(Range))
    if level == null { return }
    const range = rangeOf(app, level.?)
    // The colour last looked for, else the foreground's.
    range.*.color = if store.?.*.rangeColor != 0 { store.?.*.rangeColor } else { app.*.foreground }
    range.*.threshold = store.?.*.rangeThreshold
    range.*.softness = store.?.*.rangeSoftness
    range.*.mode = store.?.*.rangeMode
    range.*.sample = if hasPixels(app) { store.?.*.rangeSample } else { 1 }
    range.*.madeFor = 2
    range.*.app = @intFromPtr(app)
}

// A colour from the colour dialog (also while it is being chosen).
fn rangeColor(app: *App, color: u32) -> void {
    const level = dialogs.find(app, KIND_RANGE)
    if level == null { return }
    rangeOf(app, level.?).*.color = color
    api.redraw(app)
}

// The picture with what would be selected: the rest darkened.
fn drawThumb(app: *App, store: *Store, range: *Range, area: ui.Rect) -> void {
    const canvas = state.uiOf(app).*.canvas
    if canvas.*.width == 0 || canvas.*.device != 0 { return }
    const s = state.themeOf(app).*.scale
    kit_module.checker(canvas, area, 6 * s)
    const thumb = thumbOf(store)
    const wanted = pixel.premultiplied(range.*.color)
    const threshold = byte(range.*.threshold)
    const softness = byte(range.*.softness)
    const width = @intCast(i32, canvas.*.width)
    const height = @intCast(i32, canvas.*.height)
    var y = if area.y < 0 { 0 } else { area.y }
    const bottom = if ui.bottom(area) > height { height } else { ui.bottom(area) }
    const left = if area.x < 0 { 0 } else { area.x }
    const right = if ui.right(area) > width { width } else { ui.right(area) }
    while y < bottom {
        const v = (y - area.y) / s
        const line = canvas.*.pixels + @intCast(usize, y) * canvas.*.stride
        var x = left
        while x < right {
            const u = (x - area.x) / s
            const value = thumb[@intCast(usize, v * range.*.width + u)]
            const amount = likeness(value, wanted, threshold, softness)
            var shown = canvas_module.over(line[@intCast(usize, x)], pixel.premultiplied(value), 255)
            // What stays out is dimmed (an opaque black at 60 % of what
            // is left of the amount).
            const dim = (255 - amount) * 150 / 255
            if dim > 0 { shown = canvas_module.over(shown, dim << 24, 255) }
            line[@intCast(usize, x)] = shown
            x += 1
        }
        y += 1
    }
    kit_module.frame(canvas, area, state.themeOf(app).*.border)
}

// The share of the picture that would be selected, of 1000.
fn shareOf(store: *Store, range: *Range) -> u32 {
    const thumb = thumbOf(store)
    const wanted = pixel.premultiplied(range.*.color)
    const threshold = byte(range.*.threshold)
    const softness = byte(range.*.softness)
    const count = @intCast(usize, range.*.width * range.*.height)
    var sum: u64 = 0
    var index: usize = 0
    while index < count {
        sum += @intCast(u64, likeness(thumb[index], wanted, threshold, softness))
        index += 1
    }
    if count == 0 { return 0 }
    return @intCast(u32, (sum * 1000 + @intCast(u64, count) * 255 / 2) / (@intCast(u64, count) * 255))
}

fn drawRange(app: *App, level: usize, window: ui.Rect) -> void {
    const range = rangeOf(app, level)
    const store = storeOf(app)
    const image = api.image(app)
    if store == null || image == null {
        dialogs.close(app, level, dialogs.CANCEL)
        return
    }
    if range.*.madeFor != range.*.sample {
        makeThumb(store.?, range, image.?, sampled(app, image.?, range.*.sample))
        range.*.madeFor = range.*.sample
    }
    const kit = api.kit(app)
    const s = state.themeOf(app).*.scale
    const row = dialogs.ROW * s
    const step = (dialogs.ROW + dialogs.GAP) * s
    const picture_height = THUMB_HEIGHT * s
    const natural = picture_height + 10 * s + 5 * step + 18 * s
    var content = dialogs.frame(app, window, state.tr(app, "Select from Colour Range", "Auswahl nach Farbbereich"), (THUMB_WIDTH + 28) * s, dialogs.framed(app, natural))
    range.*.labels[0] = "OK"
    range.*.labels[1] = state.tr(app, "Cancel", "Abbrechen")
    const labels: [*][]const u8 = &range.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 0)
    var rows = dialogs.scrollBegin(app, content, natural)
    // The picture, in the middle of its row; pressed, it gives its colour.
    const band = ui.takeTop(&rows, picture_height)
    const shown_width = range.*.width * s
    const shown_height = range.*.height * s
    const picture = ui.rect(band.x + (band.width - shown_width) / 2, band.y + (band.height - shown_height) / 2, shown_width, shown_height)
    const widgets = state.uiOf(app)
    const picture_id = dialogs.idOf(app, level, dialogs.PART_FIELD)
    view.region(widgets, picture_id, picture)
    const picking = view.isPressed(widgets, picture_id) && widgets.*.pointerDown
    if (picking || view.takeClick(widgets, picture_id)) && ui.contains(picture, widgets.*.pointerX, widgets.*.pointerY) {
        const u = (widgets.*.pointerX - picture.x) / s
        const v = (widgets.*.pointerY - picture.y) / s
        if u >= 0 && v >= 0 && u < range.*.width && v < range.*.height {
            range.*.color = thumbOf(store.?)[@intCast(usize, v * range.*.width + u)]
            widgets.*.changed = true
        }
    }
    drawThumb(app, store.?, range, picture)
    _ = ui.takeTop(&rows, 10 * s)
    // The colour: its swatch (the colour dialog), its digits, the
    // foreground's.
    const line = dialogs.labelled(app, &rows, state.tr(app, "Colour", "Farbe"), row)
    if kit_module.colorSwatch(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + 1), ui.rect(line.x, line.y, 56 * s, row), range.*.color, false) {
        _ = dialogs.pickColor(app, state.tr(app, "Colour to Select", "Auszuwählende Farbe"), range.*.color, rangeColor, true)
    }
    const hex_length = color_module.formatHex(range.*.color, &range.*.hex, range.*.color >> 24 != 255)
    const hex: [*]const u8 = &range.*.hex
    const button_width = 120 * s
    kit_module.label(kit, ui.rect(line.x + 66 * s, line.y, line.width - 66 * s - button_width - 8 * s, row), hex[0..hex_length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    if kit_module.button(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + 2), ui.rect(ui.right(line) - button_width, line.y, button_width, row), state.tr(app, "Foreground", "Vordergrund"), kit_module.BUTTON_NORMAL) {
        range.*.color = app.*.foreground
    }
    var options = kit_module.sliderOptions(0.0, 255.0, 1.0, 0)
    _ = kit_module.slider(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + 3), dialogs.labelled(app, &rows, state.tr(app, "Range", "Bereich"), row), "", &range.*.threshold, &options)
    _ = kit_module.slider(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + 4), dialogs.labelled(app, &rows, state.tr(app, "Softness", "Weichheit"), row), "", &range.*.softness, &options)
    _ = kit_module.comboBoxWith(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + 5), dialogs.labelled(app, &rows, state.tr(app, "Sample", "Quelle"), row), 2, sampleName, range.*.app, &range.*.sample)
    _ = kit_module.comboBoxWith(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + 6), dialogs.labelled(app, &rows, state.tr(app, "Selection", "Auswahl"), row), 4, modeName, range.*.app, &range.*.mode)
    // How much that is.
    const share = shareOf(store.?, range)
    const note: [*]u8 = &range.*.note
    var length = std.text.append(note, 0, 96, state.tr(app, "About ", "Etwa "))
    length = std.text.appendUnsigned(note, length, 96, @intCast(usize, (share + 5) / 10))
    length = std.text.append(note, length, 96, state.tr(app, " % of the picture", " % des Bildes"))
    kit_module.label(kit, ui.takeTop(&rows, 18 * s), note[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}

fn finishRange(app: *App, level: usize, answer: usize) -> void {
    const range = rangeOf(app, level)
    const store = storeOf(app)
    const image = api.image(app)
    if store == null || image == null { return }
    store.?.*.rangeThreshold = range.*.threshold
    store.?.*.rangeSoftness = range.*.softness
    store.?.*.rangeMode = range.*.mode
    store.?.*.rangeSample = range.*.sample
    store.?.*.rangeColor = range.*.color
    if answer != 0 { return }
    const source = sampled(app, image.?, range.*.sample)
    const mode = modeOf(range.*.mode)
    ops.beginSelection(image.?)
    const done = selection.fromColor(image.?.*.selection, source, range.*.color, byte(range.*.threshold), byte(range.*.softness), image_module.bounds(image.?), mode)
    settle(app, image.?, done, true, state.tr(app, "Select from Colour Range", "Auswahl nach Farbbereich"))
}

// ---------------------------------------------------------------------------
// Shown or not

fn showsSelection(app: *App) -> bool {
    const doc = api.document(app)
    return doc != null && doc.?.*.showSelection
}

fn toggleDisplay(app: *App) -> void {
    const doc = api.document(app)
    if doc == null { return }
    doc.?.*.showSelection = !doc.?.*.showSelection
    api.canvasChanged(app)
    api.redraw(app)
}

const NEEDS_DOCUMENT = state.ACTION_NEEDS_DOCUMENT
const NEEDS_SELECTION = state.ACTION_NEEDS_SELECTION
const SEPARATOR = state.ACTION_SEPARATOR_BEFORE
const OPAQUE: []const u8 = "Select Opaque|Deckendes auswählen"

const ACTIONS = [15]state.Action{
    state.Action.{ .key = "select_all", .name = "Select All", .german = "Alles auswählen", .shortcut = "Ctrl+A", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_DOCUMENT, .run = selectAll, .checked = null, .enabled = null },
    state.Action.{ .key = "select_none", .name = "Deselect", .german = "Auswahl aufheben", .shortcut = "Ctrl+Shift+A", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_SELECTION, .run = deselect, .checked = null, .enabled = null },
    state.Action.{ .key = "select_reselect", .name = "Reselect", .german = "Erneut auswählen", .shortcut = "Ctrl+Shift+D", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_DOCUMENT, .run = reselect, .checked = null, .enabled = canReselect },
    state.Action.{ .key = "select_invert", .name = "Invert Selection", .german = "Auswahl umkehren", .shortcut = "Ctrl+I", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_DOCUMENT, .run = invert, .checked = null, .enabled = null },
    state.Action.{ .key = "select_display", .name = "Display Selection", .german = "Auswahl anzeigen", .shortcut = "Ctrl+H", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_DOCUMENT | SEPARATOR | state.ACTION_CHECKABLE, .run = toggleDisplay, .checked = showsSelection, .enabled = null },
    state.Action.{ .key = "select_color_range", .name = "Select from Colour Range…", .german = "Auswahl nach Farbbereich …", .shortcut = "", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_DOCUMENT | SEPARATOR, .run = selectColorRange, .checked = null, .enabled = null },
    state.Action.{ .key = "select_opaque", .name = "Replace", .german = "Ersetzen", .shortcut = "", .menu = state.MENU_SELECT, .submenu = OPAQUE, .flags = state.ACTION_NEEDS_LAYER, .run = opaqueReplace, .checked = null, .enabled = hasPixels },
    state.Action.{ .key = "select_opaque_add", .name = "Add", .german = "Hinzufügen", .shortcut = "", .menu = state.MENU_SELECT, .submenu = OPAQUE, .flags = state.ACTION_NEEDS_LAYER, .run = opaqueAdd, .checked = null, .enabled = hasPixels },
    state.Action.{ .key = "select_opaque_subtract", .name = "Subtract", .german = "Abziehen", .shortcut = "", .menu = state.MENU_SELECT, .submenu = OPAQUE, .flags = state.ACTION_NEEDS_LAYER, .run = opaqueSubtract, .checked = null, .enabled = hasPixels },
    state.Action.{ .key = "select_opaque_intersect", .name = "Intersect", .german = "Schnittmenge", .shortcut = "", .menu = state.MENU_SELECT, .submenu = OPAQUE, .flags = state.ACTION_NEEDS_LAYER, .run = opaqueIntersect, .checked = null, .enabled = hasPixels },
    state.Action.{ .key = "select_feather", .name = "Feather Selection…", .german = "Auswahl weichzeichnen …", .shortcut = "Shift+F6", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_SELECTION | SEPARATOR, .run = askFeather, .checked = null, .enabled = null },
    state.Action.{ .key = "select_grow", .name = "Grow Selection…", .german = "Auswahl vergrößern …", .shortcut = "", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_SELECTION, .run = askGrow, .checked = null, .enabled = null },
    state.Action.{ .key = "select_shrink", .name = "Shrink Selection…", .german = "Auswahl verkleinern …", .shortcut = "", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_SELECTION, .run = askShrink, .checked = null, .enabled = null },
    state.Action.{ .key = "select_border", .name = "Border Selection…", .german = "Auswahlrand …", .shortcut = "", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_SELECTION, .run = askBorder, .checked = null, .enabled = null },
    state.Action.{ .key = "select_smooth", .name = "Smooth", .german = "Glätten", .shortcut = "", .menu = state.MENU_SELECT, .submenu = "", .flags = NEEDS_SELECTION, .run = smooth, .checked = null, .enabled = null },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const state.Action {
    if kept.address != 0 { return table.rows(state.Action, &kept) }
    return table.keep(state.Action, &kept, ACTIONS[0..])
}

const SOURCES = [0]state.MenuSource{}

var keptSources: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn sources() -> []const state.MenuSource {
    if keptSources.address != 0 { return table.rows(state.MenuSource, &keptSources) }
    return table.keep(state.MenuSource, &keptSources, SOURCES[0..])
}
