// nebula-icon: draws Nebula's app icon (projects/desktop/apps/Nebula.app/
// icon.png, 256 x 256 as every bundle's) with Nebula's own rasterizer, so
// that the picture can be made again from this source:
//
//     nebula-icon projects/desktop/apps/Nebula.app/icon.png
//
// The look of the desktop's other bundles: a rounded square on a diagonal
// gradient, here night blue through violet to rose, a nebula's glow in it,
// a white brush stroke across it that swells and tapers, and three
// sparkles.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const png = @import("std.png")
const raster = @import("../core/raster.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")

const SIZE: usize = 256
const Failure = error { Usage, NoMemory, NotWritten }

fn usage() -> Failure!void { return Failure.Usage }
fn noMemory() -> Failure!void { return Failure.NoMemory }
fn notWritten() -> Failure!void { return Failure.NotWritten }

// The three colours of the ground, from the top left to the bottom right.
const NIGHT: u32 = 0xFF22307A
const VIOLET: u32 = 0xFF7A35B0
const ROSE: u32 = 0xFFE5577E

fn ground(x: usize, y: usize) -> u32 {
    const t = @floatFromInt(f64, x + y) / @floatFromInt(f64, SIZE * 2 - 2)
    if t < 0.55 { return pixel.mix(NIGHT, VIOLET, @intFromFloat(u32, t / 0.55 * 255.0 + 0.5)) }
    return pixel.mix(VIOLET, ROSE, @intFromFloat(u32, (t - 0.55) / 0.45 * 255.0 + 0.5))
}

// A glow: `color` at `strength` in the middle, fading to nothing at
// `radius`, over the picture.
fn glow(pixels: [*]u32, cx: f64, cy: f64, radius: f64, color: u32, strength: f64) -> void {
    var y: usize = 0
    while y < SIZE {
        var x: usize = 0
        while x < SIZE {
            const dx = @floatFromInt(f64, x) + 0.5 - cx
            const dy = @floatFromInt(f64, y) + 0.5 - cy
            const d = @sqrt(dx * dx + dy * dy) / radius
            if d < 1.0 {
                const fall = (1.0 - d) * (1.0 - d)
                const amount = @intFromFloat(u32, math.clamp(fall * strength, 0.0, 1.0) * 255.0 + 0.5)
                const index = y * SIZE + x
                pixels[index] = pixel.over(pixels[index], color, amount)
            }
            x += 1
        }
        y += 1
    }
}

// `path` filled with `color` over the picture, inside its coverage (the
// rounded square's, so nothing leaves it).
fn paintPath(pixels: [*]u32, coverage: [*]u8, inside: [*]const u8, path: *raster.Path, color: u32, opacity: u32) -> void {
    raster.coverageBytes(path, raster.NONZERO, true, geom.rect(0, 0, @intCast(i32, SIZE), @intCast(i32, SIZE)), coverage, SIZE)
    var index: usize = 0
    while index < SIZE * SIZE {
        const amount = pixel.mul(pixel.mul(@intCast(u32, coverage[index]), @intCast(u32, inside[index])), opacity)
        if amount != 0 { pixels[index] = pixel.over(pixels[index], color, amount) }
        index += 1
    }
}

// The brush stroke: a cubic curve from the bottom left to the top right,
// its width swelling in the middle and tapering at both ends, as a
// polygon of its two edges.
fn strokePath(path: *raster.Path, shift_x: f64, shift_y: f64, scale: f64) -> void {
    const steps: usize = 96
    var xs: [194]f64 = undefined
    var ys: [194]f64 = undefined
    const ax = 58.0
    const ay = 196.0
    const bx = 92.0
    const by = 96.0
    const cx = 150.0
    const cy = 190.0
    const dx = 200.0
    const dy = 62.0
    var index: usize = 0
    while index <= steps {
        const t = @floatFromInt(f64, index) / @floatFromInt(f64, steps)
        const u = 1.0 - t
        const x = u * u * u * ax + 3.0 * u * u * t * bx + 3.0 * u * t * t * cx + t * t * t * dx
        const y = u * u * u * ay + 3.0 * u * u * t * by + 3.0 * u * t * t * cy + t * t * t * dy
        const tx = 3.0 * u * u * (bx - ax) + 6.0 * u * t * (cx - bx) + 3.0 * t * t * (dx - cx)
        const ty = 3.0 * u * u * (by - ay) + 6.0 * u * t * (cy - by) + 3.0 * t * t * (dy - cy)
        const length = @sqrt(tx * tx + ty * ty)
        // Fuller toward the start (the brush pressed), thin at the end.
        const swell = math.pow(math.sin(math.pi * t), 0.7) * (1.0 - 0.35 * t)
        const half = (2.0 + 17.0 * swell) * scale
        const nx = -ty / length
        const ny = tx / length
        xs[index] = x + nx * half + shift_x
        ys[index] = y + ny * half + shift_y
        xs[193 - index] = x - nx * half + shift_x
        ys[193 - index] = y - ny * half + shift_y
        index += 1
    }
    raster.moveTo(path, xs[0], ys[0])
    index = 1
    while index < 194 {
        raster.lineTo(path, xs[index], ys[index])
        index += 1
    }
    raster.close(path)
}

fn sparkle(path: *raster.Path, cx: f64, cy: f64, size: f64) -> void {
    raster.star(path, cx, cy, 4, size * 0.22, size, 0.0)
}

pub fn main(arguments: [][*]const u8) -> !void {
    _ = crash.install()
    if arguments.length != 2 {
        _ = std.io.eprintln("usage: nebula-icon OUT.png")
        return usage()
    }
    const allocator = std.heap.allocator()
    const pixel_memory = allocator.alloc(SIZE * SIZE * 4, 16)
    const coverage_memory = allocator.alloc(SIZE * SIZE, 16)
    const inside_memory = allocator.alloc(SIZE * SIZE, 16)
    const made = raster.create(allocator)
    if pixel_memory == null || coverage_memory == null || inside_memory == null || made == null { return noMemory() }
    const pixels: [*]u32 = unsafe { @ptrCast([*]u32, pixel_memory.?) }
    const coverage = coverage_memory.?
    const inside = inside_memory.?
    const path = made.?

    // The rounded square and its ground.
    raster.roundedRect(path, 8.0, 8.0, 240.0, 240.0, 54.0, 54.0)
    raster.coverageBytes(path, raster.NONZERO, true, geom.rect(0, 0, @intCast(i32, SIZE), @intCast(i32, SIZE)), inside, SIZE)
    var y: usize = 0
    while y < SIZE {
        var x: usize = 0
        while x < SIZE {
            pixels[y * SIZE + x] = ground(x, y)
            x += 1
        }
        y += 1
    }
    // The nebula's glow: rose high on the right, blue low on the left.
    glow(pixels, 182.0, 78.0, 120.0, 0xFFFF8FB8, 0.55)
    glow(pixels, 70.0, 190.0, 110.0, 0xFF5AA8FF, 0.45)
    glow(pixels, 128.0, 128.0, 70.0, 0xFFFFFFFF, 0.12)

    // The stroke's soft shadow, then the stroke.
    raster.clear(path)
    strokePath(path, 3.0, 6.0, 1.15)
    paintPath(pixels, coverage, inside, path, 0xFF1A1440, 70)
    raster.clear(path)
    strokePath(path, 0.0, 0.0, 1.0)
    paintPath(pixels, coverage, inside, path, 0xFFFFFFFF, 255)

    // Sparkles.
    raster.clear(path)
    sparkle(path, 186.0, 150.0, 15.0)
    sparkle(path, 76.0, 70.0, 11.0)
    sparkle(path, 206.0, 202.0, 8.0)
    paintPath(pixels, coverage, inside, path, 0xFFFFFFFF, 235)

    // Outside the rounded square nothing; the window wants premultiplied
    // pixels and so does std.png's writer.
    var index: usize = 0
    while index < SIZE * SIZE {
        const kept = pixel.withAlpha(pixels[index], pixel.mul(pixels[index] >> 24, @intCast(u32, inside[index])))
        pixels[index] = pixel.premultiplied(kept)
        index += 1
    }
    var name: [1024]u8 = undefined
    const target = std.text.zeroTerminated(&name, 1024, std.text.cString(arguments[1]))
    if !png.saveFile(target, pixels, SIZE, SIZE, SIZE, true, allocator) {
        _ = std.io.eprintln("nebula-icon: the picture could not be written")
        return notWritten()
    }
}
