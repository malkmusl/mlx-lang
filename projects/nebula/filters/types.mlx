// nebula filters: what a filter says of itself, so that the list of
// filters, the dialog that asks for its numbers and the files that name
// it need no word about any one filter.
//
// A filter module (filters/adjust.mlx, filters/blur.mlx, ...) has a table
// of Info, one for each of its filters, and hands it out with
//
//     pub fn list() -> []const types.Info { return FILTERS[0..] }
//
// filters/registry.mlx puts the modules' lists together.
const node_module = @import("../core/node.mlx")

pub const Params = node_module.Params

// The Filter menu's groups.
pub const ADJUST: u8 = 0
pub const ARTISTIC: u8 = 1
pub const BLUR: u8 = 2
pub const COLORS: u8 = 3
pub const EDGE: u8 = 4
pub const EMBOSS: u8 = 5
pub const ENHANCE: u8 = 6
pub const MAP: u8 = 7
pub const OTHER: u8 = 8
pub const CATEGORIES: usize = 9

// What a number of a filter is, for the dialog that asks for it.
pub const INT: u8 = 0
pub const FLOAT: u8 = 1
pub const BOOL: u8 = 2
// One of `choices` ("Linear|Radial|Conical": the value is the place in it).
pub const CHOICE: u8 = 3
// A colour: the value is its 0xAARRGGBB as a number.
pub const COLOR: u8 = 4
// Degrees.
pub const ANGLE: u8 = 5
// Not a number: params.text holds it (a curve's points "x,y;x,y;...").
pub const TEXT: u8 = 6

// One number of a filter: params.values[its place in Info.params].
pub const Param = struct {
    name: []const u8
    german: []const u8
    kind: u8
    low: f64
    high: f64
    initial: f64
    choices: []const u8
    choicesGerman: []const u8
}

// How far around a pixel the filter reads with these numbers.
pub const Margin = fn(params: *const Params) -> i32
// Filters `width` x `height` straight pixels at `pixels` (`stride` words
// a row) in place. A filter that reads around a pixel treats what is
// outside the rectangle as its nearest pixel inside.
pub const Apply = fn(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void

pub const Info = struct {
    // The filter's number (node.Params.id): it stays for good.
    id: u16
    // Its name in files (Krita's where Krita has the filter: "blur",
    // "gaussian blur", "invert", "levels", ...).
    key: []const u8
    name: []const u8
    german: []const u8
    category: u8
    params: []const Param
    // Null: each pixel from itself alone.
    margin: ?Margin
    apply: Apply
}
