// nebula filters: the list of what changes pixels by a rule: a filter
// layer, a filter mask, the Filter menu and the filter brush all ask
// here. A filter is named by a number (node.Params.id) and works on a
// rectangle of straight pixels in place; its numbers are in
// params.values in the order its Info names them (filters/types.mlx).
const types = @import("./types.mlx")
const adjust = @import("./adjust.mlx")
const blur = @import("./blur.mlx")
const enhance = @import("./enhance.mlx")
const edge = @import("./edge.mlx")
const artistic = @import("./artistic.mlx")
const map = @import("./map.mlx")
const other = @import("./other.mlx")
const gradientmap = @import("./gradientmap.mlx")
const palettize = @import("./palettize.mlx")

pub const Params = types.Params
pub const Info = types.Info
pub const Param = types.Param

pub const NONE: u16 = 0
pub const INVERT: u16 = adjust.INVERT

const MODULES: usize = 9

fn listOf(module: usize) -> []const Info {
    if module == 0 { return adjust.list() }
    if module == 1 { return blur.list() }
    if module == 2 { return enhance.list() }
    if module == 3 { return edge.list() }
    if module == 4 { return artistic.list() }
    if module == 5 { return map.list() }
    if module == 6 { return other.list() }
    if module == 7 { return gradientmap.list() }
    return palettize.list()
}

// How many filters there are, and the one at a place in the list (in the
// modules' order).
pub fn count() -> usize {
    var total: usize = 0
    var module: usize = 0
    while module < MODULES {
        total += listOf(module).length
        module += 1
    }
    return total
}

pub fn at(index: usize) -> ?*const Info {
    var left = index
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        if left < list.length { return &list[left] }
        left -= list.length
        module += 1
    }
    return null
}

// The filter numbered `id` (null: there is none).
pub fn find(id: u16) -> ?*const Info {
    var module: usize = 0
    while module < MODULES {
        const list = listOf(module)
        var index: usize = 0
        while index < list.length {
            if list[index].id == id { return &list[index] }
            index += 1
        }
        module += 1
    }
    return null
}

fn sameText(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if left[index] != right[index] { return false }
        index += 1
    }
    return true
}

// The filter a file names `key`.
pub fn byKey(key: []const u8) -> ?*const Info {
    var index: usize = 0
    const all = count()
    while index < all {
        const info = at(index)
        if info != null && sameText(info.?.*.key, key) { return info }
        index += 1
    }
    return null
}

// `params` for filter `id` with every number at its initial value.
pub fn defaults(id: u16, params: *Params) -> void {
    params.*.id = id
    params.*.textLength = 0
    var index: usize = 0
    while index < 32 {
        params.*.values[index] = 0.0
        index += 1
    }
    const info = find(id)
    if info == null { return }
    index = 0
    while index < info.?.*.params.length && index < 32 {
        params.*.values[index] = info.?.*.params[index].initial
        index += 1
    }
}

// How many pixels beyond a pixel the filter reads to make it (a blur's
// radius; 0: each pixel from itself alone). Who filters part of a picture
// hands in that much more on every side.
pub fn margin(params: *const Params) -> i32 {
    const info = find(params.*.id)
    if info == null || info.?.*.margin == null { return 0 }
    return info.?.*.margin.?(params)
}

// Filters `width` x `height` pixels at `pixels` (`stride` words a row) in
// place. False for a filter not known (the pixels stay).
pub fn apply(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> bool {
    const info = find(params.*.id)
    if info == null { return false }
    if width == 0 || height == 0 { return true }
    info.?.*.apply(params, pixels, width, height, stride)
    return true
}
