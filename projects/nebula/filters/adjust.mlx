// nebula filters: the adjustments (each pixel from itself alone).
const types = @import("./types.mlx")

pub const Params = types.Params

pub const INVERT: u16 = 1

const NO_PARAMS = [0]types.Param{}

fn invert(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            row[x] = row[x] ^ 0x00FFFFFF
            x += 1
        }
        y += 1
    }
}

const FILTERS = [1]types.Info{
    types.Info.{ .id = INVERT, .key = "invert", .name = "Invert", .german = "Invertieren", .category = types.ADJUST, .params = NO_PARAMS[0..], .margin = null, .apply = invert },
}

pub fn list() -> []const types.Info { return FILTERS[0..] }
