// nebula filters: the Filter menu's Adjust group: the colour adjustments.
// Each makes a pixel from that pixel alone (no margin), which is why they
// are what filter layers ("adjustment layers") and filter masks mostly
// are, and why a picture may be handed to them in any pieces. Two look at
// the whole rectangle first, Auto Contrast and Normalize Range (for its
// darkest and its lightest pixel): what they make depends on the
// rectangle handed in, so the caller filters whole layers with them, not
// blocks.
//
//     var params: filters.Params = undefined
//     filters.defaults(adjust.LEVELS, &params)
//     params.values[0] = 64.0                          // input black
//     params.values[1] = 192.0                         // input white
//     _ = filters.apply(&params, pixels, width, height, stride)
//
// What holds for all of them:
//
// - A pixel's alpha stays. The colour of a transparent pixel is changed
//   like any other (nothing is skipped), but it counts for nothing where a
//   filter measures the picture. The filters about alpha (Transparency;
//   Levels, Colour Adjustment and Cross-channel on the alpha channel)
//   change it, and a pixel they make fully transparent is stored as 0.
// - A number outside its range is the nearest end of it, what is no
//   number is the initial value.
// - At neutral numbers a filter returns before it touches a pixel: the
//   picture stays bit for bit.
// - Filters that are a curve for each channel (Invert, Brightness/
//   Contrast, Levels, Colour Adjustment, Auto Contrast, Burn, Dodge,
//   Slope/Offset/Power, Exposure, Gamma, Colour Temperature, Normalize
//   Range, Transparency) build 256 entries a channel once and then only
//   look pixels up. The ones that think in hue, saturation and lightness
//   work in f64 with core/color.mlx's models.
// - The curves of Colour Adjustment and Cross-channel are text
//   (params.text, see filters/curves.mlx): "x,y;x,y;..." with x and y from
//   0 to 1.
//
// Not here: Color to Alpha (filters/other.mlx), Posterize
// (filters/artistic.mlx), and Krita's Brightness/Contrast as a curve on
// Lab's lightness (ours is the two classic numbers; a curve on the
// lightness is Colour Adjustment's "l").
const math = @import("std.math")
const types = @import("./types.mlx")
const curves = @import("./curves.mlx")
const color = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const node = @import("../core/node.mlx")
const table = @import("../core/table.mlx")

pub const Params = types.Params

pub const INVERT: u16 = 1
pub const BRIGHTNESS_CONTRAST: u16 = 2
pub const LEVELS: u16 = 3
pub const CURVES: u16 = 4
pub const CROSS_CHANNEL: u16 = 5
pub const HSV_ADJUSTMENT: u16 = 6
pub const COLOR_BALANCE: u16 = 7
pub const DESATURATE: u16 = 8
pub const THRESHOLD: u16 = 9
pub const AUTO_CONTRAST: u16 = 10
pub const BURN: u16 = 11
pub const DODGE: u16 = 12
pub const SLOPE_OFFSET_POWER: u16 = 13
pub const EXPOSURE: u16 = 14
pub const GAMMA: u16 = 15
pub const COLOR_TEMPERATURE: u16 = 16
pub const SEPIA: u16 = 17
pub const NORMALIZE_RANGE: u16 = 18
pub const TRANSPARENCY: u16 = 19

// Levels' "Channel".
pub const LEVELS_RGB: u32 = 0
pub const LEVELS_RED: u32 = 1
pub const LEVELS_GREEN: u32 = 2
pub const LEVELS_BLUE: u32 = 3
pub const LEVELS_ALPHA: u32 = 4
pub const LEVELS_LUMA: u32 = 5

// Cross-channel's "Driver channel" and "Channel".
pub const CROSS_HUE: u32 = 0
pub const CROSS_SATURATION: u32 = 1
pub const CROSS_LIGHTNESS: u32 = 2
pub const CROSS_RED: u32 = 3
pub const CROSS_GREEN: u32 = 4
pub const CROSS_BLUE: u32 = 5
pub const CROSS_ALPHA: u32 = 6

// HSV/HSL Adjustment's "Model".
pub const MODEL_HSV: u32 = 0
pub const MODEL_HSL: u32 = 1
pub const MODEL_HSI: u32 = 2
pub const MODEL_HSY: u32 = 3

// Desaturate's "Method".
pub const BY_LIGHTNESS: u32 = 0
pub const BY_LUMINOSITY_709: u32 = 1
pub const BY_LUMINOSITY_601: u32 = 2
pub const BY_AVERAGE: u32 = 3
pub const BY_MINIMUM: u32 = 4
pub const BY_MAXIMUM: u32 = 5

// Burn's and Dodge's "Range".
pub const SHADOWS: u32 = 0
pub const MIDTONES: u32 = 1
pub const HIGHLIGHTS: u32 = 2

// Normalize Range's "Channels".
pub const TOGETHER: u32 = 0
pub const EACH_ALONE: u32 = 1

const NO_PARAMS = [0]types.Param{}

// ---------------------------------------------------------------------
// A filter's numbers

// Number `place` of a filter as it is used: held to its range, the
// initial value for what is no number.
// (The row is taken by value: a slice of a module's constant table would
// be a copy of all of it in the value arena at every call.)
fn number(params: *const Params, param: types.Param, place: usize) -> f64 {
    const value = params.*.values[place]
    if value != value { return param.initial }
    if value < param.low { return param.low }
    if value > param.high { return param.high }
    return value
}

// A choice, a level or a colour: the nearest whole number (of a range
// that does not go below 0).
fn whole(params: *const Params, param: types.Param, place: usize) -> u32 {
    return @intCast(u32, @intFromFloat(u64, number(params, param, place) + 0.5) & 0xFFFFFFFF)
}

fn flag(params: *const Params, param: types.Param, place: usize) -> bool {
    return number(params, param, place) >= 0.5
}

// The filter's text, no longer than there is room for one.
fn textOf(params: *const Params) -> []const u8 {
    const bytes: [*]const u8 = &params.*.text
    const length = if params.*.textLength > node.TEXT { node.TEXT } else { params.*.textLength }
    return bytes[0..length]
}

// ---------------------------------------------------------------------
// Bytes as channels of 0..1

// 256 entries: byte / 255, the very number core/color.mlx's toRgb makes
// of a byte, so that what goes through its models comes back as the byte
// it was. Filled when first asked for and kept (2 KiB).
var unit_table: [256]f64 = undefined
var unit_ready: bool = false

fn units() -> [*]const f64 {
    if !unit_ready {
        var byte: usize = 0
        while byte < 256 {
            unit_table[byte] = @floatFromInt(f64, byte) / 255.0
            byte += 1
        }
        unit_ready = true
    }
    return &unit_table
}

// `value` held to 0..1; what is no number is 0.
inline fn share(value: f64) -> f64 {
    return if !(value > 0.0) { 0.0 } else if value > 1.0 { 1.0 } else { value }
}

// base ^ exponent for a channel of 0..1 and an exponent that is not
// negative: the ends stay the ends (std.math's pow wants a base above 0).
fn power(base: f64, exponent: f64) -> f64 {
    if exponent == 0.0 { return 1.0 }
    if !(base > 0.0) { return 0.0 }
    if base >= 1.0 { return 1.0 }
    return math.pow(base, exponent)
}

// ---------------------------------------------------------------------
// Curves as tables

// The tables a pixel goes through, 256 words each in one block of 1024:
// a channel's entry is the new channel already at its place in the pixel,
// so a pixel is three or four loads and their sum.
const RED: usize = 0
const GREEN: usize = 256
const BLUE: usize = 512
const ALPHA: usize = 768
const TABLES: usize = 1024

// Every channel its own value.
fn plainTables(tables: [*]u32) -> void {
    var index: usize = 0
    while index < 256 {
        const value = @intCast(u32, index)
        tables[RED + index] = value << 16
        tables[GREEN + index] = value << 8
        tables[BLUE + index] = value
        tables[ALPHA + index] = value << 24
        index += 1
    }
}

// The table of `channel` (RED, GREEN, BLUE, ALPHA) from a curve of 256
// bytes.
fn setChannel(tables: [*]u32, channel: usize, curve: [*]const u8) -> void {
    const shift: u32 = if channel == RED { 16 } else if channel == GREEN { 8 } else if channel == BLUE { 0 } else { 24 }
    var index: usize = 0
    while index < 256 {
        tables[channel + index] = @intCast(u32, curve[index]) << shift
        index += 1
    }
}

// Red, green and blue through their tables; the alpha stays.
fn mapColors(pixels: [*]u32, width: usize, height: usize, stride: usize, tables: [*]const u32) -> void {
    const reds = tables + RED
    const greens = tables + GREEN
    const blues = tables + BLUE
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            row[x] = (p & 0xFF000000) | reds[@intCast(usize, (p >> 16) & 255)] | greens[@intCast(usize, (p >> 8) & 255)] | blues[@intCast(usize, p & 255)]
            x += 1
        }
        y += 1
    }
}

// All four channels through their tables. A pixel whose alpha becomes 0
// is stored as 0: what is not there has no colour.
fn mapPixels(pixels: [*]u32, width: usize, height: usize, stride: usize, tables: [*]const u32) -> void {
    const reds = tables + RED
    const greens = tables + GREEN
    const blues = tables + BLUE
    const alphas = tables + ALPHA
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const alpha = alphas[@intCast(usize, p >> 24)]
            if alpha == 0 && p >> 24 != 0 {
                row[x] = 0
            } else {
                row[x] = alpha | reds[@intCast(usize, (p >> 16) & 255)] | greens[@intCast(usize, (p >> 8) & 255)] | blues[@intCast(usize, p & 255)]
            }
            x += 1
        }
        y += 1
    }
}

// Which channels a curve is for (Levels' "Channel" in this order).
const ALL_COLORS: u32 = 0
const ONLY_RED: u32 = 1
const ONLY_GREEN: u32 = 2
const ONLY_BLUE: u32 = 3
const ONLY_ALPHA: u32 = 4

// The picture through one curve of 256 bytes on the channels `which`.
// Without memory the picture stays.
fn throughCurve(pool: *scratch.Pool, pixels: [*]u32, width: usize, height: usize, stride: usize, curve: [*]const u8, which: u32) -> void {
    const mark = scratch.mark(pool)
    const taken = scratch.words(pool, TABLES)
    if taken != null {
        const tables = taken.?
        plainTables(tables)
        if which == ONLY_ALPHA {
            setChannel(tables, ALPHA, curve)
            mapPixels(pixels, width, height, stride, tables)
        } else {
            if which == ALL_COLORS || which == ONLY_RED { setChannel(tables, RED, curve) }
            if which == ALL_COLORS || which == ONLY_GREEN { setChannel(tables, GREEN, curve) }
            if which == ALL_COLORS || which == ONLY_BLUE { setChannel(tables, BLUE, curve) }
            mapColors(pixels, width, height, stride, tables)
        }
    }
    scratch.release(pool, mark)
}

// Each pixel's luma (pixel.luma: Rec. 601's weights, 0-255) through a
// curve of 256 bytes, the colour kept: red, green and blue move by the
// same amount, as far as the curve moves the luma, and what leaves 0..1
// by that closes in on the new luma (color.setLum in HSY). A pixel whose
// luma the curve leaves where it is is not touched.
fn mapLuma(pixels: [*]u32, width: usize, height: usize, stride: usize, curve: [*]const u8) -> void {
    const unit = units()
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const light = pixel.luma(p)
            const wanted = @intCast(u32, curve[@intCast(usize, light)])
            if wanted != light {
                var r: f64 = unit[@intCast(usize, (p >> 16) & 255)]
                var g: f64 = unit[@intCast(usize, (p >> 8) & 255)]
                var b: f64 = unit[@intCast(usize, p & 255)]
                const moved = (@floatFromInt(f64, wanted) - @floatFromInt(f64, light)) / 255.0
                color.setLum(color.HSY, &r, &g, &b, color.luma(color.REC601, r, g, b) + moved)
                row[x] = (p & 0xFF000000) | (color.toByte(r) << 16) | (color.toByte(g) << 8) | color.toByte(b)
            }
            x += 1
        }
        y += 1
    }
}

// ---------------------------------------------------------------------
// Invert

// Every colour channel its opposite, 255 - c.
fn invert(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            row[x] = row[x] ^ 0x00FFFFFF
            x += 1
        }
        y += 1
    }
}

// ---------------------------------------------------------------------
// Brightness/Contrast

const BRIGHTNESS_PARAMS = [2]types.Param{
    types.Param.{ .name = "Brightness", .german = "Helligkeit", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Contrast", .german = "Kontrast", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// The two classic numbers, with the formulas GIMP's Brightness-Contrast
// had for decades (b and c are the numbers over 100, v a channel of
// 0..1): first the brightness, toward black v (1 + b) and toward white
// v + (1 - v) b; then the contrast, (v - 1/2) tan((c + 1) pi/4) + 1/2,
// a line through middle grey whose slope is 1 at 0, level at -100 (all
// middle grey) and upright at 100 (black or white).
fn brightnessContrast(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const brightness = number(params, BRIGHTNESS_PARAMS[0], 0) / 100.0
    const contrast = number(params, BRIGHTNESS_PARAMS[1], 1) / 100.0
    if brightness == 0.0 && contrast == 0.0 { return }
    // (The tangent has no end at a quarter turn: steep enough that no
    // byte lands between black and white.)
    const slant = if contrast == 0.0 { 1.0 } else if contrast >= 1.0 { 1.0e9 } else { math.tan((contrast + 1.0) * math.pi / 4.0) }
    const unit = units()
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.bytes(pool, 256)
    if taken != null {
        const curve = taken.?
        var index: usize = 0
        while index < 256 {
            var value: f64 = unit[index]
            value = if brightness < 0.0 { value * (1.0 + brightness) } else { value + (1.0 - value) * brightness }
            curve[index] = @intCast(u8, color.toByte((value - 0.5) * slant + 0.5))
            index += 1
        }
        throughCurve(pool, pixels, width, height, stride, curve, ALL_COLORS)
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Levels

const LEVELS_PARAMS = [6]types.Param{
    types.Param.{ .name = "Input black", .german = "Eingabe Schwarz", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Input white", .german = "Eingabe Weiß", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 255.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Gamma", .german = "Gamma", .kind = types.FLOAT, .low = 0.1, .high = 10.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Output black", .german = "Ausgabe Schwarz", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Output white", .german = "Ausgabe Weiß", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 255.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Channel", .german = "Kanal", .kind = types.CHOICE, .low = 0.0, .high = 5.0, .initial = 0.0, .choices = "RGB|Red|Green|Blue|Alpha|Luma", .choicesGerman = "RGB|Rot|Grün|Blau|Alpha|Luma" },
}

// What is between the input black and the input white is spread over
// 0..1, bent by the gamma and laid between the output black and the
// output white: x = (in - black) / (white - black) held to 0..1,
// out = output black + (output white - output black) x^(1/gamma). An
// input white not above the input black is a step right above the black;
// an output white below the output black turns the picture around. On
// all of red, green and blue, on one of them, on the alpha, or on the
// luma with the colour kept (mapLuma).
fn levels(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const black = number(params, LEVELS_PARAMS[0], 0)
    const white = number(params, LEVELS_PARAMS[1], 1)
    const gamma = number(params, LEVELS_PARAMS[2], 2)
    const out_black = number(params, LEVELS_PARAMS[3], 3)
    const out_white = number(params, LEVELS_PARAMS[4], 4)
    const channel = whole(params, LEVELS_PARAMS[5], 5)
    if black == 0.0 && white == 255.0 && gamma == 1.0 && out_black == 0.0 && out_white == 255.0 { return }
    const span = if white - black < 1.0 { 1.0 } else { white - black }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.bytes(pool, 256)
    if taken != null {
        const curve = taken.?
        var index: usize = 0
        while index < 256 {
            var x = share((@floatFromInt(f64, index) - black) / span)
            if gamma != 1.0 { x = power(x, 1.0 / gamma) }
            curve[index] = @intCast(u8, color.toByte((out_black + (out_white - out_black) * x) / 255.0))
            index += 1
        }
        if channel == LEVELS_LUMA {
            mapLuma(pixels, width, height, stride, curve)
        } else {
            throughCurve(pool, pixels, width, height, stride, curve, channel)
        }
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Colour Adjustment curves

const CURVES_PARAMS = [1]types.Param{
    types.Param.{ .name = "Curves", .german = "Kurven", .kind = types.TEXT, .low = 0.0, .high = 0.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// The curve `short` or `long` of a text of curves in `curve`. False when
// it is not there, cannot be read or changes nothing.
fn readCurve(curve: *curves.Curve, text: []const u8, short: []const u8, long: []const u8) -> bool {
    var points = curves.section(text, short)
    if points.length == 0 { points = curves.section(text, long) }
    if !curves.parse(curve, points) { return false }
    return !curves.isIdentity(curve)
}

// One colour channel's table: the curve for all three (`shared`, 256
// numbers of 0..1) and then the channel's own, when it has one. Composed
// as numbers, so that two curves round once.
fn composeChannel(tables: [*]u32, channel: usize, bytes: [*]u8, shared: [*]const f64, curve: *const curves.Curve, own: bool) -> void {
    var index: usize = 0
    while index < 256 {
        const value = if own { curves.value(curve, shared[index]) } else { shared[index] }
        bytes[index] = @intCast(u8, color.toByte(value))
        index += 1
    }
    setChannel(tables, channel, bytes)
}

// A response curve for each channel. params.text names them:
//
//     "rgb:0,0;0.5,0.75;1,1|r:0,0;1,0.9|a:0,0;1,1|l:0,0.1;1,1"
//
// "rgb" (or "all") is one curve for red, green and blue alike, "r", "g",
// "b" and "a" (or "red", "green", "blue", "alpha") are a channel's own,
// "l" (or "lightness") is for the luma with the colour kept (mapLuma). A
// colour goes through "rgb" first, then through its own curve; the
// lightness curve comes last. A curve that is missing or cannot be read
// changes nothing, so an empty text is the picture as it is.
fn perChannel(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const text = textOf(params)
    if text.length == 0 { return }
    const unit = units()
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const curve_taken = curves.take(pool)
    const tables_taken = scratch.words(pool, TABLES)
    const shared_taken = scratch.doubles(pool, 256)
    const bytes_taken = scratch.bytes(pool, 256)
    if curve_taken != null && tables_taken != null && shared_taken != null && bytes_taken != null {
        const curve = curve_taken.?
        const tables = tables_taken.?
        const shared = shared_taken.?
        const bytes = bytes_taken.?
        plainTables(tables)
        const all = readCurve(curve, text, "rgb", "all")
        var index: usize = 0
        while index < 256 {
            shared[index] = if all { curves.value(curve, unit[index]) } else { unit[index] }
            index += 1
        }
        var colors = all
        var own = readCurve(curve, text, "r", "red")
        if own || all { composeChannel(tables, RED, bytes, shared, curve, own) }
        colors = colors || own
        own = readCurve(curve, text, "g", "green")
        if own || all { composeChannel(tables, GREEN, bytes, shared, curve, own) }
        colors = colors || own
        own = readCurve(curve, text, "b", "blue")
        if own || all { composeChannel(tables, BLUE, bytes, shared, curve, own) }
        colors = colors || own
        if readCurve(curve, text, "a", "alpha") {
            composeChannel(tables, ALPHA, bytes, unit, curve, true)
            mapPixels(pixels, width, height, stride, tables)
        } else if colors {
            mapColors(pixels, width, height, stride, tables)
        }
        if readCurve(curve, text, "l", "lightness") {
            index = 0
            while index < 256 {
                bytes[index] = @intCast(u8, color.toByte(curves.value(curve, unit[index])))
                index += 1
            }
            mapLuma(pixels, width, height, stride, bytes)
        }
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Cross-channel adjustment curves

const CROSS_PARAMS = [3]types.Param{
    types.Param.{ .name = "Driver channel", .german = "Steuerkanal", .kind = types.CHOICE, .low = 0.0, .high = 6.0, .initial = 0.0, .choices = "Hue|Saturation|Lightness|Red|Green|Blue|Alpha", .choicesGerman = "Farbton|Sättigung|Helligkeit|Rot|Grün|Blau|Alpha" },
    types.Param.{ .name = "Channel", .german = "Kanal", .kind = types.CHOICE, .low = 0.0, .high = 6.0, .initial = 1.0, .choices = "Hue|Saturation|Lightness|Red|Green|Blue|Alpha", .choicesGerman = "Farbton|Sättigung|Helligkeit|Rot|Grün|Blau|Alpha" },
    types.Param.{ .name = "Curve", .german = "Kurve", .kind = types.TEXT, .low = 0.0, .high = 0.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// The curve is read at this many even steps and straight between them.
const CROSS_STEPS: usize = 1024

// The pixels of crossChannel: `amounts` is the curve as what it adds, -1
// to 1, at CROSS_STEPS + 2 places (the last twice, for the step past the
// end).
fn crossPixels(pixels: [*]u32, width: usize, height: usize, stride: usize, amounts: [*]const f64, driver: u32, target: u32) -> void {
    const unit = units()
    const models = driver <= CROSS_LIGHTNESS || target <= CROSS_LIGHTNESS
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            var r: f64 = unit[@intCast(usize, (p >> 16) & 255)]
            var g: f64 = unit[@intCast(usize, (p >> 8) & 255)]
            var b: f64 = unit[@intCast(usize, p & 255)]
            var h: f64 = 0.0
            var s: f64 = 0.0
            var l: f64 = 0.0
            if models { color.rgbToHsl(r, g, b, &h, &s, &l) }
            var at: f64 = 0.0
            if driver == CROSS_HUE {
                at = h
            } else if driver == CROSS_SATURATION {
                at = s
            } else if driver == CROSS_LIGHTNESS {
                at = l
            } else if driver == CROSS_RED {
                at = r
            } else if driver == CROSS_GREEN {
                at = g
            } else if driver == CROSS_BLUE {
                at = b
            } else {
                at = unit[@intCast(usize, p >> 24)]
            }
            // A grey has no hue to be driven by.
            if !(driver == CROSS_HUE && s <= 0.0) {
                const position = share(at) * @floatFromInt(f64, CROSS_STEPS)
                const step = @intFromFloat(usize, position)
                const amount = amounts[step] + (amounts[step + 1] - amounts[step]) * (position - @floatFromInt(f64, step))
                if amount != 0.0 {
                    if target == CROSS_ALPHA {
                        const alpha = color.toByte(unit[@intCast(usize, p >> 24)] + amount)
                        row[x] = if alpha == 0 { 0 } else { (p & 0x00FFFFFF) | (alpha << 24) }
                    } else {
                        if target == CROSS_HUE {
                            color.hslToRgb(h + amount * 0.5, s, l, &r, &g, &b)
                        } else if target == CROSS_SATURATION {
                            color.hslToRgb(h, s * (1.0 + amount), l, &r, &g, &b)
                        } else if target == CROSS_LIGHTNESS {
                            color.hslToRgb(h, s, l + amount, &r, &g, &b)
                        } else if target == CROSS_RED {
                            r += amount
                        } else if target == CROSS_GREEN {
                            g += amount
                        } else {
                            b += amount
                        }
                        row[x] = (p & 0xFF000000) | (color.toByte(r) << 16) | (color.toByte(g) << 8) | color.toByte(b)
                    }
                }
            }
            x += 1
        }
        y += 1
    }
}

// One channel of a pixel drives another through a curve (params.text,
// "x,y;x,y;..."): x is the driver's value, and the curve's height there,
// against the middle 0.5, is what happens to the other channel:
// amount = (height - 0.5) * 2, from -1 to 1. A hue turns by amount half
// turns, a saturation is multiplied by 1 + amount (0 to twice), a
// lightness, a colour channel or the alpha gets the amount added. Hue,
// saturation and lightness are HSL's. A curve level at 0.5, and no curve,
// is the picture as it is; a grey is not driven by a hue (it has none).
//
// "0,0.5;0.3,0.5;0.5,0;0.7,0.5;1,0.5" with hue driving saturation takes
// the colour out of what is cyan; with lightness driving saturation,
// "0,0;1,0.5" takes it out of the shadows.
fn crossChannel(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const driver = whole(params, CROSS_PARAMS[0], 0)
    const target = whole(params, CROSS_PARAMS[1], 1)
    const text = textOf(params)
    if text.length == 0 { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const curve_taken = curves.take(pool)
    const amounts_taken = scratch.doubles(pool, CROSS_STEPS + 2)
    if curve_taken != null && amounts_taken != null {
        const curve = curve_taken.?
        const amounts = amounts_taken.?
        if curves.parse(curve, text) && !curves.isLevel(curve, 0.5) {
            curves.fill(curve, amounts, CROSS_STEPS + 1)
            var index: usize = 0
            while index <= CROSS_STEPS {
                amounts[index] = (amounts[index] - 0.5) * 2.0
                index += 1
            }
            amounts[CROSS_STEPS + 1] = amounts[CROSS_STEPS]
            crossPixels(pixels, width, height, stride, amounts, driver, target)
        }
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// HSV/HSL Adjustment

const HSV_PARAMS = [5]types.Param{
    types.Param.{ .name = "Model", .german = "Modell", .kind = types.CHOICE, .low = 0.0, .high = 3.0, .initial = 1.0, .choices = "HSV|HSL|HSI|HSY", .choicesGerman = "HSV|HSL|HSI|HSY" },
    types.Param.{ .name = "Hue", .german = "Farbton", .kind = types.ANGLE, .low = -180.0, .high = 180.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Saturation", .german = "Sättigung", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Value/Lightness", .german = "Helligkeit", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colorize", .german = "Einfärben", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

fn modelOf(choice: u32) -> u8 {
    if choice == MODEL_HSV { return color.HSV }
    if choice == MODEL_HSL { return color.HSL }
    if choice == MODEL_HSI { return color.HSI }
    return color.HSY
}

// A colour as hue, saturation and lightness of the model chosen (HSV's
// value, HSL's lightness, HSI's intensity, HSY's luma), changed, and
// made a colour again. With h the degrees, s and v the other two numbers
// over 100:
//
//   hue          turned by h
//   saturation   S (1 + s): none at -100, twice at 100 (Krita's and
//                GIMP's way: what is nearly grey stays nearly grey)
//   lightness    V (1 + v) toward black, V + (1 - V) v toward white
//
// Colorize gives every pixel one hue and one saturation and keeps its
// lightness in the model (which the third number then moves as above):
// the hue is h degrees (-120 is 240, blue), the saturation (s + 100) / 2
// percent, half at the slider's middle. With HSL black stays black and
// white white; with HSY the luma stays, and the saturation gives way
// where a luma has no room for it.
fn hsvAdjustment(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const model = modelOf(whole(params, HSV_PARAMS[0], 0))
    const degrees = number(params, HSV_PARAMS[1], 1)
    const saturation = number(params, HSV_PARAMS[2], 2) / 100.0
    const lightness = number(params, HSV_PARAMS[3], 3) / 100.0
    const colorize = flag(params, HSV_PARAMS[4], 4)
    if !colorize && degrees == 0.0 && saturation == 0.0 && lightness == 0.0 { return }
    const turn = degrees / 360.0
    const tint = color.hueFromDegrees(degrees)
    const strength = (saturation + 1.0) * 0.5
    const unit = units()
    // The colour before this one and what was made of it: pictures have
    // runs of one colour.
    var seen: u32 = 0
    var made: u32 = 0
    var known = false
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const rgb = p & 0x00FFFFFF
            if !known || rgb != seen {
                var r: f64 = unit[@intCast(usize, rgb >> 16)]
                var g: f64 = unit[@intCast(usize, (rgb >> 8) & 255)]
                var b: f64 = unit[@intCast(usize, rgb & 255)]
                var h: f64 = tint
                var s: f64 = strength
                var l: f64 = 0.0
                if colorize {
                    l = color.lum(model, r, g, b)
                } else {
                    color.rgbToModel(model, r, g, b, &h, &s, &l)
                    h += turn
                    s = s * (1.0 + saturation)
                }
                l = if lightness < 0.0 { l * (1.0 + lightness) } else { l + (1.0 - l) * lightness }
                color.modelToRgb(model, h, s, l, &r, &g, &b)
                seen = rgb
                made = (color.toByte(r) << 16) | (color.toByte(g) << 8) | color.toByte(b)
                known = true
            }
            row[x] = (p & 0xFF000000) | made
            x += 1
        }
        y += 1
    }
}

// ---------------------------------------------------------------------
// Colour Balance

const BALANCE_PARAMS = [10]types.Param{
    types.Param.{ .name = "Shadows: cyan-red", .german = "Schatten: Cyan-Rot", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Shadows: magenta-green", .german = "Schatten: Magenta-Grün", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Shadows: yellow-blue", .german = "Schatten: Gelb-Blau", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Midtones: cyan-red", .german = "Mitteltöne: Cyan-Rot", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Midtones: magenta-green", .german = "Mitteltöne: Magenta-Grün", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Midtones: yellow-blue", .german = "Mitteltöne: Gelb-Blau", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Highlights: cyan-red", .german = "Lichter: Cyan-Rot", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Highlights: magenta-green", .german = "Lichter: Magenta-Grün", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Highlights: yellow-blue", .german = "Lichter: Gelb-Blau", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Preserve luminosity", .german = "Helligkeit erhalten", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
}

// Where the shadows end and the highlights begin, and how wide the way
// from one range into the next is.
const THIRD: f64 = 1.0 / 3.0
const TWO_THIRDS: f64 = 2.0 / 3.0
const RAMP: f64 = 0.25
// The most a slider at its end moves a channel.
const REACH: f64 = 0.7

// Red, green and blue moved toward a colour or its opposite, separately
// in the shadows, the midtones and the highlights: the transfer curves
// GIMP's and Krita's Colour Balance share. How much of each range a
// pixel is follows from its lightness L (HSL's): the shadows' share
// falls from 1 to 0 around L = 1/3 over a ramp 1/4 wide, the
// highlights' rises around 2/3, the midtones have what is between (the
// three add up to 1). A channel gets its three sliders (each over 100)
// times the shares times 0.7 added. With "Preserve luminosity" the new
// colour's hue and saturation are put back on the lightness the pixel
// had.
fn colorBalance(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const shadows_red = number(params, BALANCE_PARAMS[0], 0) / 100.0
    const shadows_green = number(params, BALANCE_PARAMS[1], 1) / 100.0
    const shadows_blue = number(params, BALANCE_PARAMS[2], 2) / 100.0
    const midtones_red = number(params, BALANCE_PARAMS[3], 3) / 100.0
    const midtones_green = number(params, BALANCE_PARAMS[4], 4) / 100.0
    const midtones_blue = number(params, BALANCE_PARAMS[5], 5) / 100.0
    const highlights_red = number(params, BALANCE_PARAMS[6], 6) / 100.0
    const highlights_green = number(params, BALANCE_PARAMS[7], 7) / 100.0
    const highlights_blue = number(params, BALANCE_PARAMS[8], 8) / 100.0
    const preserve = flag(params, BALANCE_PARAMS[9], 9)
    if shadows_red == 0.0 && shadows_green == 0.0 && shadows_blue == 0.0 && midtones_red == 0.0 && midtones_green == 0.0 && midtones_blue == 0.0 && highlights_red == 0.0 && highlights_green == 0.0 && highlights_blue == 0.0 { return }
    const unit = units()
    var seen: u32 = 0
    var made: u32 = 0
    var known = false
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const rgb = p & 0x00FFFFFF
            if !known || rgb != seen {
                var r: f64 = unit[@intCast(usize, rgb >> 16)]
                var g: f64 = unit[@intCast(usize, (rgb >> 8) & 255)]
                var b: f64 = unit[@intCast(usize, rgb & 255)]
                const high = if r > g { if r > b { r } else { b } } else { if g > b { g } else { b } }
                const low = if r < g { if r < b { r } else { b } } else { if g < b { g } else { b } }
                const light = (high + low) * 0.5
                const shadows = share((THIRD - light) / RAMP + 0.5) * REACH
                const midtones = share((light - THIRD) / RAMP + 0.5) * share((TWO_THIRDS - light) / RAMP + 0.5) * REACH
                const highlights = share((light - TWO_THIRDS) / RAMP + 0.5) * REACH
                const more_red = shadows_red * shadows + midtones_red * midtones + highlights_red * highlights
                const more_green = shadows_green * shadows + midtones_green * midtones + highlights_green * highlights
                const more_blue = shadows_blue * shadows + midtones_blue * midtones + highlights_blue * highlights
                seen = rgb
                made = rgb
                known = true
                if more_red != 0.0 || more_green != 0.0 || more_blue != 0.0 {
                    r = share(r + more_red)
                    g = share(g + more_green)
                    b = share(b + more_blue)
                    if preserve {
                        var h: f64 = 0.0
                        var s: f64 = 0.0
                        var l: f64 = 0.0
                        color.rgbToHsl(r, g, b, &h, &s, &l)
                        color.hslToRgb(h, s, light, &r, &g, &b)
                    }
                    made = (color.toByte(r) << 16) | (color.toByte(g) << 8) | color.toByte(b)
                }
            }
            row[x] = (p & 0xFF000000) | made
            x += 1
        }
        y += 1
    }
}

// ---------------------------------------------------------------------
// Desaturate, Threshold

const DESATURATE_PARAMS = [1]types.Param{
    types.Param.{ .name = "Method", .german = "Verfahren", .kind = types.CHOICE, .low = 0.0, .high = 5.0, .initial = 0.0, .choices = "Lightness|Luminosity (Rec. 709)|Luminosity (Rec. 601)|Average|Minimum|Maximum", .choicesGerman = "Helligkeit|Leuchtdichte (Rec. 709)|Leuchtdichte (Rec. 601)|Durchschnitt|Minimum|Maximum" },
}

// Luma's weights of core/color.mlx as parts of 2^20, for sums of bytes
// without a float: the three add up to 2^20 exactly, so a grey stays the
// grey it is.
const WEIGHT_ONE: u32 = 1048576

fn weightOf(part: f64) -> u32 {
    return @intFromFloat(u32, part * 1048576.0 + 0.5)
}

// Every pixel the grey of how light it is, by one of six measures: HSL's
// lightness (max + min) / 2, the luma with Rec. 709's or Rec. 601's
// weights, the average of the three channels, the smallest, the largest.
// All in whole numbers, a half rounded up.
fn desaturate(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const method = whole(params, DESATURATE_PARAMS[0], 0)
    var red_weight = weightOf(color.REC709_RED)
    var green_weight = weightOf(color.REC709_GREEN)
    if method == BY_LUMINOSITY_601 {
        red_weight = weightOf(color.REC601_RED)
        green_weight = weightOf(color.REC601_GREEN)
    }
    const blue_weight = WEIGHT_ONE - red_weight - green_weight
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const r = (p >> 16) & 255
            const g = (p >> 8) & 255
            const b = p & 255
            var grey: u32 = 0
            if method == BY_LUMINOSITY_709 || method == BY_LUMINOSITY_601 {
                grey = (r * red_weight + g * green_weight + b * blue_weight + 524288) >> 20
            } else if method == BY_AVERAGE {
                grey = ((r + g + b) * 2 + 3) / 6
            } else {
                const high = pixel.larger(r, pixel.larger(g, b))
                const low = pixel.smaller(r, pixel.smaller(g, b))
                grey = if method == BY_MINIMUM { low } else if method == BY_MAXIMUM { high } else { (high + low + 1) >> 1 }
            }
            row[x] = (p & 0xFF000000) | (grey << 16) | (grey << 8) | grey
            x += 1
        }
        y += 1
    }
}

const THRESHOLD_PARAMS = [1]types.Param{
    types.Param.{ .name = "Level", .german = "Schwelle", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 128.0, .choices = "", .choicesGerman = "" },
}

// White where a pixel's luma (pixel.luma, 0-255) is at least the level,
// black where it is below.
fn threshold(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const level = whole(params, THRESHOLD_PARAMS[0], 0)
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            row[x] = if pixel.luma(p) >= level { p | 0x00FFFFFF } else { p & 0xFF000000 }
            x += 1
        }
        y += 1
    }
}

// ---------------------------------------------------------------------
// Auto Contrast, Normalize Range

// The curve that spreads low..high over 0..255 (each byte rounded, what
// is outside held); every byte its own when there is nothing between
// them to spread.
fn stretch(curve: [*]u8, low: u32, high: u32) -> void {
    var index: u32 = 0
    while index < 256 {
        var value = index
        if high > low {
            const span = high - low
            value = if index <= low { 0 } else { pixel.smaller(((index - low) * 255 + span / 2) / span, 255) }
        }
        curve[@intCast(usize, index)] = @intCast(u8, value)
        index += 1
    }
}

// The darkest and the lightest luma (pixel.luma) among the pixels of the
// rectangle that are not fully transparent become black and white, and
// red, green and blue of every pixel go through the one line between
// them: out = (in - darkest) * 255 / (lightest - darkest). Nothing
// happens to a picture of one luma, or one that reaches from 0 to 255
// already. What comes out depends on the rectangle handed in: for whole
// layers, not for blocks.
fn autoContrast(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var low: u32 = 255
    var high: u32 = 0
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            if p >> 24 != 0 {
                const light = pixel.luma(p)
                if light < low { low = light }
                if light > high { high = light }
            }
            x += 1
        }
        y += 1
    }
    if high <= low || (low == 0 && high == 255) { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.bytes(pool, 256)
    if taken != null {
        stretch(taken.?, low, high)
        throughCurve(pool, pixels, width, height, stride, taken.?, ALL_COLORS)
    }
    scratch.release(pool, mark)
}

const NORMALIZE_PARAMS = [1]types.Param{
    types.Param.{ .name = "Channels", .german = "Kanäle", .kind = types.CHOICE, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "Together|Each alone", .choicesGerman = "Gemeinsam|Jeder für sich" },
}

// The smallest and the largest channel value among the pixels of the
// rectangle that are not fully transparent are spread over 0..255.
// "Together": one range for red, green and blue, so the colours keep
// their hue (where Auto Contrast measures the luma, this measures the
// channels: nothing is clipped). "Each alone": every channel its own
// range, which also takes a colour cast out. Like Auto Contrast it
// depends on the rectangle handed in.
fn normalizeRange(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const each = whole(params, NORMALIZE_PARAMS[0], 0) == EACH_ALONE
    var low_red: u32 = 255
    var high_red: u32 = 0
    var low_green: u32 = 255
    var high_green: u32 = 0
    var low_blue: u32 = 255
    var high_blue: u32 = 0
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            if p >> 24 != 0 {
                const r = (p >> 16) & 255
                const g = (p >> 8) & 255
                const b = p & 255
                if r < low_red { low_red = r }
                if r > high_red { high_red = r }
                if g < low_green { low_green = g }
                if g > high_green { high_green = g }
                if b < low_blue { low_blue = b }
                if b > high_blue { high_blue = b }
            }
            x += 1
        }
        y += 1
    }
    if !each {
        low_red = pixel.smaller(low_red, pixel.smaller(low_green, low_blue))
        high_red = pixel.larger(high_red, pixel.larger(high_green, high_blue))
        low_green = low_red
        high_green = high_red
        low_blue = low_red
        high_blue = high_red
    }
    // Nothing visible, or nothing to spread in any channel.
    const spread_red = high_red > low_red && !(low_red == 0 && high_red == 255)
    const spread_green = high_green > low_green && !(low_green == 0 && high_green == 255)
    const spread_blue = high_blue > low_blue && !(low_blue == 0 && high_blue == 255)
    if !spread_red && !spread_green && !spread_blue { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const tables_taken = scratch.words(pool, TABLES)
    const curve_taken = scratch.bytes(pool, 256)
    if tables_taken != null && curve_taken != null {
        const tables = tables_taken.?
        const curve = curve_taken.?
        plainTables(tables)
        stretch(curve, low_red, high_red)
        setChannel(tables, RED, curve)
        stretch(curve, low_green, high_green)
        setChannel(tables, GREEN, curve)
        stretch(curve, low_blue, high_blue)
        setChannel(tables, BLUE, curve)
        mapColors(pixels, width, height, stride, tables)
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Burn, Dodge

const BURN_PARAMS = [2]types.Param{
    types.Param.{ .name = "Exposure", .german = "Belichtung", .kind = types.FLOAT, .low = 0.0, .high = 1.0, .initial = 0.5, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Range", .german = "Bereich", .kind = types.CHOICE, .low = 0.0, .high = 2.0, .initial = 1.0, .choices = "Shadows|Midtones|Highlights", .choicesGerman = "Schatten|Mitteltöne|Lichter" },
}

// The transfer functions of the dodge and burn tools, for every colour
// channel c of 0..1 with the exposure e:
//
//              Dodge (lighter)          Burn (darker)
//   shadows    e/3 + c (1 - e/3)        (c - e/3) / (1 - e/3), not below 0
//   midtones   c ^ (1 / (1 + e))        c ^ (1 + e)
//   highlights c (1 + e/3), at most 1   c (1 - e/3)
fn burnDodge(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize, dodge: bool) -> void {
    const exposure = number(params, BURN_PARAMS[0], 0)
    const range = whole(params, BURN_PARAMS[1], 1)
    if exposure == 0.0 { return }
    const third = exposure / 3.0
    const unit = units()
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.bytes(pool, 256)
    if taken != null {
        const curve = taken.?
        var index: usize = 0
        while index < 256 {
            const value = unit[index]
            var made: f64 = value
            if range == SHADOWS {
                made = if dodge { third + value * (1.0 - third) } else { (value - third) / (1.0 - third) }
            } else if range == MIDTONES {
                made = power(value, if dodge { 1.0 / (1.0 + exposure) } else { 1.0 + exposure })
            } else {
                made = if dodge { value * (1.0 + third) } else { value * (1.0 - third) }
            }
            curve[index] = @intCast(u8, color.toByte(made))
            index += 1
        }
        throughCurve(pool, pixels, width, height, stride, curve, ALL_COLORS)
    }
    scratch.release(pool, mark)
}

fn burn(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    burnDodge(params, pixels, width, height, stride, false)
}

fn dodge(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    burnDodge(params, pixels, width, height, stride, true)
}

// ---------------------------------------------------------------------
// Slope, Offset, Power

const CDL_PARAMS = [3]types.Param{
    types.Param.{ .name = "Slope", .german = "Steigung", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Offset", .german = "Versatz", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4278190080.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Power", .german = "Potenz", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
}

// The colour decision list of the American Society of Cinematographers:
// out = (in * slope + offset) ^ power for each of red, green and blue
// with its own three numbers, the sum held to 0..1 before the power. The
// numbers come as three colours, as Krita gives them: a colour's red is
// red's number, 0 to 1 (its alpha says nothing). White, black, white
// changes nothing.
fn slopeOffsetPower(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const slope = whole(params, CDL_PARAMS[0], 0) & 0x00FFFFFF
    const offset = whole(params, CDL_PARAMS[1], 1) & 0x00FFFFFF
    const exponent = whole(params, CDL_PARAMS[2], 2) & 0x00FFFFFF
    if slope == 0x00FFFFFF && offset == 0 && exponent == 0x00FFFFFF { return }
    const unit = units()
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const tables_taken = scratch.words(pool, TABLES)
    const curve_taken = scratch.bytes(pool, 256)
    if tables_taken != null && curve_taken != null {
        const tables = tables_taken.?
        const curve = curve_taken.?
        plainTables(tables)
        var shift: u32 = 0
        while shift <= 16 {
            const rise = unit[@intCast(usize, (slope >> shift) & 255)]
            const more = unit[@intCast(usize, (offset >> shift) & 255)]
            const bend = unit[@intCast(usize, (exponent >> shift) & 255)]
            var index: usize = 0
            while index < 256 {
                var value = share(unit[index] * rise + more)
                if bend != 1.0 { value = power(value, bend) }
                curve[index] = @intCast(u8, color.toByte(value))
                index += 1
            }
            setChannel(tables, if shift == 16 { RED } else if shift == 8 { GREEN } else { BLUE }, curve)
            shift += 8
        }
        mapColors(pixels, width, height, stride, tables)
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Exposure, Gamma, Colour Temperature

const EXPOSURE_PARAMS = [1]types.Param{
    types.Param.{ .name = "Exposure (stops)", .german = "Belichtung (Blendenstufen)", .kind = types.FLOAT, .low = -5.0, .high = 5.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// One channel's curve for light times `gain`: the byte as linear light
// (sRGB's curve), times the gain, a byte again.
fn gainCurve(curve: [*]u8, gain: f64) -> void {
    var index: u32 = 0
    while index < 256 {
        curve[@intCast(usize, index)] = @intCast(u8, color.srgb8(color.linear8(index) * gain))
        index += 1
    }
}

// As a camera does it: the light of every channel times 2 ^ stops, in
// linear light. One stop more doubles the light, which is not twice the
// byte.
fn exposure(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const stops = number(params, EXPOSURE_PARAMS[0], 0)
    if stops == 0.0 { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.bytes(pool, 256)
    if taken != null {
        gainCurve(taken.?, math.pow(2.0, stops))
        throughCurve(pool, pixels, width, height, stride, taken.?, ALL_COLORS)
    }
    scratch.release(pool, mark)
}

const GAMMA_PARAMS = [1]types.Param{
    types.Param.{ .name = "Gamma", .german = "Gamma", .kind = types.FLOAT, .low = 0.1, .high = 10.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
}

// Every colour channel c of 0..1 becomes c ^ (1 / gamma): above 1 the
// middle tones get lighter, below 1 darker; black and white stay.
fn gamma(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const bend = number(params, GAMMA_PARAMS[0], 0)
    if bend == 1.0 { return }
    const unit = units()
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.bytes(pool, 256)
    if taken != null {
        const curve = taken.?
        var index: usize = 0
        while index < 256 {
            curve[index] = @intCast(u8, color.toByte(power(unit[index], 1.0 / bend)))
            index += 1
        }
        throughCurve(pool, pixels, width, height, stride, curve, ALL_COLORS)
    }
    scratch.release(pool, mark)
}

const TEMPERATURE_PARAMS = [2]types.Param{
    types.Param.{ .name = "Temperature", .german = "Temperatur", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Tint", .german = "Tönung", .kind = types.INT, .low = -100.0, .high = 100.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// Warmer or cooler, as a white balance moves a picture: in linear light
// red is multiplied by 2 ^ (temperature / 100) and blue divided by it
// (100: twice the red, half the blue; below 0 the other way, cooler).
// The tint does the same to green against the other two: above 0 toward
// magenta (green divided by 2 ^ (tint / 100)), below 0 toward green.
// Nothing is made lighter or darker to make up for it.
fn colorTemperature(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const temperature = number(params, TEMPERATURE_PARAMS[0], 0)
    const tint = number(params, TEMPERATURE_PARAMS[1], 1)
    if temperature == 0.0 && tint == 0.0 { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const tables_taken = scratch.words(pool, TABLES)
    const curve_taken = scratch.bytes(pool, 256)
    if tables_taken != null && curve_taken != null {
        const tables = tables_taken.?
        const curve = curve_taken.?
        plainTables(tables)
        if temperature != 0.0 {
            const warm = math.pow(2.0, temperature / 100.0)
            gainCurve(curve, warm)
            setChannel(tables, RED, curve)
            gainCurve(curve, 1.0 / warm)
            setChannel(tables, BLUE, curve)
        }
        if tint != 0.0 {
            gainCurve(curve, math.pow(2.0, -tint / 100.0))
            setChannel(tables, GREEN, curve)
        }
        mapColors(pixels, width, height, stride, tables)
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Sepia / Tint

const SEPIA_PARAMS = [2]types.Param{
    types.Param.{ .name = "Color", .german = "Farbe", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4285547028.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Amount", .german = "Stärke", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 100.0, .choices = "", .choicesGerman = "" },
}

// The picture in the tones of one colour, as an old photograph is brown
// (the initial colour is sepia, #704214): every pixel becomes the
// colour's hue and chroma at the pixel's own luma (color.setLum in HSY,
// so black stays black and white white, and the colour shows in
// between), mixed with what the pixel was by the amount (100: all tint,
// 0: the picture as it is).
fn sepia(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const tint = whole(params, SEPIA_PARAMS[0], 0)
    const amount = @intFromFloat(u32, number(params, SEPIA_PARAMS[1], 1) * 2.55 + 0.5)
    if amount == 0 { return }
    const unit = units()
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.words(pool, 256)
    if taken != null {
        // The tint depends on nothing but the luma: 256 colours.
        const tones = taken.?
        var index: usize = 0
        while index < 256 {
            var r: f64 = unit[@intCast(usize, (tint >> 16) & 255)]
            var g: f64 = unit[@intCast(usize, (tint >> 8) & 255)]
            var b: f64 = unit[@intCast(usize, tint & 255)]
            color.setLum(color.HSY, &r, &g, &b, unit[index])
            tones[index] = (color.toByte(r) << 16) | (color.toByte(g) << 8) | color.toByte(b)
            index += 1
        }
        var y: usize = 0
        while y < height {
            const row = pixels + y * stride
            var x: usize = 0
            while x < width {
                const p = row[x]
                const tone = tones[@intCast(usize, pixel.luma(p))]
                if amount >= 255 {
                    row[x] = (p & 0xFF000000) | tone
                } else {
                    row[x] = (p & 0xFF000000) | (pixel.lerp((p >> 16) & 255, tone >> 16, amount) << 16) | (pixel.lerp((p >> 8) & 255, (tone >> 8) & 255, amount) << 8) | pixel.lerp(p & 255, tone & 255, amount)
                }
                x += 1
            }
            y += 1
        }
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Transparency

const TRANSPARENCY_PARAMS = [2]types.Param{
    types.Param.{ .name = "Opacity (%)", .german = "Deckkraft (%)", .kind = types.FLOAT, .low = 0.0, .high = 400.0, .initial = 100.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Offset", .german = "Versatz", .kind = types.INT, .low = -255.0, .high = 255.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// The alpha of every pixel times the opacity (100 %: as it is) plus the
// offset, held to 0..255; the colours stay. Below 100 % the layer fades,
// above it soft edges get harder; with an offset below 0 thin paint
// goes, and with one above 0 what was transparent shows the colour it
// kept (black where it never had one). An alpha curve of any shape is
// Colour Adjustment's "a".
fn transparency(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const factor = number(params, TRANSPARENCY_PARAMS[0], 0) / 100.0
    const offset = number(params, TRANSPARENCY_PARAMS[1], 1)
    if factor == 1.0 && offset == 0.0 { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.bytes(pool, 256)
    if taken != null {
        const curve = taken.?
        var index: usize = 0
        while index < 256 {
            curve[index] = @intCast(u8, color.toByte((@floatFromInt(f64, index) * factor + offset) / 255.0))
            index += 1
        }
        throughCurve(pool, pixels, width, height, stride, curve, ONLY_ALPHA)
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------

const FILTERS = [19]types.Info{
    types.Info.{ .id = INVERT, .key = "invert", .name = "Invert", .german = "Invertieren", .category = types.ADJUST, .params = NO_PARAMS[0..], .margin = null, .apply = invert },
    types.Info.{ .id = BRIGHTNESS_CONTRAST, .key = "brightnesscontrast", .name = "Brightness/Contrast", .german = "Helligkeit/Kontrast", .category = types.ADJUST, .params = BRIGHTNESS_PARAMS[0..], .margin = null, .apply = brightnessContrast },
    types.Info.{ .id = LEVELS, .key = "levels", .name = "Levels", .german = "Tonwertkorrektur", .category = types.ADJUST, .params = LEVELS_PARAMS[0..], .margin = null, .apply = levels },
    types.Info.{ .id = CURVES, .key = "perchannel", .name = "Color Adjustment Curves", .german = "Farbanpassungskurven", .category = types.ADJUST, .params = CURVES_PARAMS[0..], .margin = null, .apply = perChannel },
    types.Info.{ .id = CROSS_CHANNEL, .key = "crosschannel", .name = "Cross-channel Adjustment Curves", .german = "Kanalübergreifende Anpassungskurven", .category = types.ADJUST, .params = CROSS_PARAMS[0..], .margin = null, .apply = crossChannel },
    types.Info.{ .id = HSV_ADJUSTMENT, .key = "hsvadjustment", .name = "HSV/HSL Adjustment", .german = "HSV/HSL-Anpassung", .category = types.ADJUST, .params = HSV_PARAMS[0..], .margin = null, .apply = hsvAdjustment },
    types.Info.{ .id = COLOR_BALANCE, .key = "colorbalance", .name = "Color Balance", .german = "Farbbalance", .category = types.ADJUST, .params = BALANCE_PARAMS[0..], .margin = null, .apply = colorBalance },
    types.Info.{ .id = DESATURATE, .key = "desaturate", .name = "Desaturate", .german = "Entsättigen", .category = types.ADJUST, .params = DESATURATE_PARAMS[0..], .margin = null, .apply = desaturate },
    types.Info.{ .id = THRESHOLD, .key = "threshold", .name = "Threshold", .german = "Schwellwert", .category = types.ADJUST, .params = THRESHOLD_PARAMS[0..], .margin = null, .apply = threshold },
    types.Info.{ .id = AUTO_CONTRAST, .key = "autocontrast", .name = "Auto Contrast", .german = "Automatischer Kontrast", .category = types.ADJUST, .params = NO_PARAMS[0..], .margin = null, .apply = autoContrast },
    types.Info.{ .id = BURN, .key = "burn", .name = "Burn", .german = "Nachbelichten", .category = types.ADJUST, .params = BURN_PARAMS[0..], .margin = null, .apply = burn },
    types.Info.{ .id = DODGE, .key = "dodge", .name = "Dodge", .german = "Abwedeln", .category = types.ADJUST, .params = BURN_PARAMS[0..], .margin = null, .apply = dodge },
    types.Info.{ .id = SLOPE_OFFSET_POWER, .key = "asc-cdl", .name = "Slope, Offset, Power", .german = "Steigung, Versatz, Potenz", .category = types.ADJUST, .params = CDL_PARAMS[0..], .margin = null, .apply = slopeOffsetPower },
    types.Info.{ .id = EXPOSURE, .key = "exposure", .name = "Exposure", .german = "Belichtung", .category = types.ADJUST, .params = EXPOSURE_PARAMS[0..], .margin = null, .apply = exposure },
    types.Info.{ .id = GAMMA, .key = "gamma", .name = "Gamma", .german = "Gamma", .category = types.ADJUST, .params = GAMMA_PARAMS[0..], .margin = null, .apply = gamma },
    types.Info.{ .id = COLOR_TEMPERATURE, .key = "colortemperature", .name = "Color Temperature", .german = "Farbtemperatur", .category = types.ADJUST, .params = TEMPERATURE_PARAMS[0..], .margin = null, .apply = colorTemperature },
    types.Info.{ .id = SEPIA, .key = "sepia", .name = "Sepia / Tint", .german = "Sepia / Tönung", .category = types.ADJUST, .params = SEPIA_PARAMS[0..], .margin = null, .apply = sepia },
    types.Info.{ .id = NORMALIZE_RANGE, .key = "normalizerange", .name = "Normalize Range", .german = "Wertebereich strecken", .category = types.ADJUST, .params = NORMALIZE_PARAMS[0..], .margin = null, .apply = normalizeRange },
    types.Info.{ .id = TRANSPARENCY, .key = "transparency", .name = "Transparency", .german = "Transparenz", .category = types.ADJUST, .params = TRANSPARENCY_PARAMS[0..], .margin = null, .apply = transparency },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const types.Info {
    if kept.address != 0 { return table.rows(types.Info, &kept) }
    return table.keep(types.Info, &kept, FILTERS[0..])
}
