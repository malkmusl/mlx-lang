// nebula filters: response curves, the lines people bend in the Colour
// Adjustment and Cross-channel dialogs to say which output belongs to
// which input.
//
// A curve is up to 64 points in the unit square, written "x,y;x,y;..."
// with decimal numbers from 0 to 1 (what node.Params.text holds, and
// what Krita writes into its files). Through the points runs the natural
// cubic spline (it has no bend at its two ends): a straight line through
// two points, the point's height for one. Left of the first point and
// right of the last the curve stays at that point's height, and no value
// leaves 0..1.
//
//     const mark = scratch.mark(pool)
//     const curve = curves.take(pool)                  // null without memory
//     if curve != null && curves.parse(curve.?, "0,0;0.5,0.75;1,1") {
//         const lifted = curves.value(curve.?, 0.5)    // 0.75
//     }
//     scratch.release(pool, mark)
//
// A Curve is 2 KiB, so it is no local of a function that runs for every
// tile: it comes from working memory (take) or lives in a struct of the
// caller's. A curve is always worked out: add() and parse() leave it
// ready for value().
//
// Several curves in one text are "name:points|name:points"; section()
// finds one of them.
const std = @import("std")
const scratch = @import("../core/scratch.mlx")

// The most points a curve has (a text of 256 bytes holds no more).
pub const POINTS: usize = 64

// Two points nearer than this in x are one place (the first one stays):
// the spline divides by the distance, and the text has four decimals.
const NEAREST: f64 = 0.0001

pub const Curve = struct {
    count: usize
    // The points, x rising.
    x: [64]f64
    y: [64]f64
    // The spline's second derivative at each point (0 at both ends).
    bend: [64]f64
    // What the solving keeps between its two passes.
    spare: [64]f64
}

// `value` held to 0..1; what is no number is 0.
inline fn held(value: f64) -> f64 {
    return if !(value > 0.0) { 0.0 } else if value > 1.0 { 1.0 } else { value }
}

// A curve without points in working memory (value() answers x for it).
// Null without memory.
pub fn take(pool: *scratch.Pool) -> ?*Curve {
    const memory = scratch.bytes(pool, @sizeOf(Curve))
    if memory == null { return null }
    const curve: *Curve = unsafe { @ptrCast(*Curve, memory.?) }
    curve.*.count = 0
    return curve
}

// The spline through the points: its second derivatives from the three
// term equations that make the slope continuous at every inner point
// (h the distances in x, d the slopes of the straight pieces):
//
//     h[i-1] M[i-1] + 2 (h[i-1] + h[i]) M[i] + h[i] M[i+1] = 6 (d[i] - d[i-1])
//
// solved downward and back up; M is 0 at both ends.
fn solve(curve: *Curve) -> void {
    const count = curve.*.count
    var index: usize = 0
    while index < count {
        curve.*.bend[index] = 0.0
        index += 1
    }
    if count < 3 { return }
    const last = count - 1
    var before = curve.*.x[1] - curve.*.x[0]
    var slope_before = (curve.*.y[1] - curve.*.y[0]) / before
    index = 1
    while index < last {
        const after = curve.*.x[index + 1] - curve.*.x[index]
        const slope_after = (curve.*.y[index + 1] - curve.*.y[index]) / after
        var pivot = 2.0 * (before + after)
        var right = 6.0 * (slope_after - slope_before)
        if index > 1 {
            pivot -= before * curve.*.spare[index - 1]
            right -= before * curve.*.bend[index - 1]
        }
        curve.*.spare[index] = after / pivot
        curve.*.bend[index] = right / pivot
        before = after
        slope_before = slope_after
        index += 1
    }
    index = last - 1
    while index >= 1 {
        curve.*.bend[index] -= curve.*.spare[index] * curve.*.bend[index + 1]
        index -= 1
    }
}

// Puts a point where it belongs in the order of x. False when the curve
// is full, when there is a point at this x already, or for what is no
// number.
fn place(curve: *Curve, x: f64, y: f64) -> bool {
    if curve.*.count >= POINTS || x != x || y != y { return false }
    const px = held(x)
    const py = held(y)
    var at: usize = 0
    while at < curve.*.count && curve.*.x[at] < px { at += 1 }
    if at < curve.*.count && curve.*.x[at] - px < NEAREST { return false }
    if at > 0 && px - curve.*.x[at - 1] < NEAREST { return false }
    var index = curve.*.count
    while index > at {
        curve.*.x[index] = curve.*.x[index - 1]
        curve.*.y[index] = curve.*.y[index - 1]
        index -= 1
    }
    curve.*.x[at] = px
    curve.*.y[at] = py
    curve.*.count += 1
    return true
}

// The curve without points: value() answers x.
pub fn clear(curve: *Curve) -> void {
    curve.*.count = 0
}

// The diagonal from (0, 0) to (1, 1): every value its own.
pub fn identity(curve: *Curve) -> void {
    curve.*.count = 0
    _ = place(curve, 0.0, 0.0)
    _ = place(curve, 1.0, 1.0)
    solve(curve)
}

// Adds a point (x and y held to 0..1). False, and the curve as it was,
// when it has 64 points, when one of them is at this x (nearer than
// 0.0001), or for what is no number.
pub fn add(curve: *Curve, x: f64, y: f64) -> bool {
    if !place(curve, x, y) { return false }
    solve(curve)
    return true
}

fn isDigit(byte: u8) -> bool {
    return byte >= 48 && byte <= 57
}

fn skipBlanks(text: []const u8, from: usize) -> usize {
    var at = from
    while at < text.length && (text[at] == 32 || text[at] == 9 || text[at] == 10 || text[at] == 13) { at += 1 }
    return at
}

// Reads a decimal number ("0.25", ".5", "1", "-0.1") at text[at.*] and
// moves at.* past it. False when there is none. The digits are gathered
// as one whole number and divided once, so "0.75" is the double nearest
// to 0.75; digits beyond the fifteenth say nothing a double could keep.
fn number(text: []const u8, at: *usize, into: *f64) -> bool {
    var index = skipBlanks(text, at.*)
    var negative = false
    if index < text.length && (text[index] == 45 || text[index] == 43) {
        negative = text[index] == 45
        index += 1
    }
    var digits: f64 = 0.0
    var scale: f64 = 1.0
    var taken: usize = 0
    var found = false
    while index < text.length && isDigit(text[index]) {
        if taken < 15 {
            digits = digits * 10.0 + @floatFromInt(f64, text[index] - 48)
            taken += 1
        } else {
            scale = scale * 0.1
        }
        found = true
        index += 1
    }
    if index < text.length && text[index] == 46 {
        index += 1
        while index < text.length && isDigit(text[index]) {
            if taken < 15 {
                digits = digits * 10.0 + @floatFromInt(f64, text[index] - 48)
                scale = scale * 10.0
                taken += 1
            }
            found = true
            index += 1
        }
    }
    if !found { return false }
    const value = digits / scale
    into.* = if negative { -value } else { value }
    at.* = index
    return true
}

// Reads "x,y;x,y;..." (blanks around the numbers and a ';' after the
// last point are fine; the points in any order). What cannot be read
// ends the reading: the points before it count. True when the curve has
// a point then; false leaves it without points (value() answers x).
pub fn parse(curve: *Curve, text: []const u8) -> bool {
    curve.*.count = 0
    var at: usize = 0
    while true {
        var x: f64 = 0.0
        var y: f64 = 0.0
        if !number(text, &at, &x) { break }
        at = skipBlanks(text, at)
        if at >= text.length || text[at] != 44 { break }
        at += 1
        if !number(text, &at, &y) { break }
        _ = place(curve, x, y)
        at = skipBlanks(text, at)
        if at >= text.length || text[at] != 59 { break }
        at += 1
    }
    solve(curve)
    return curve.*.count > 0
}

// The curve named `name` in "name:points|name:points|..." (blanks around
// a name are fine; of two with one name the first): its points, to hand
// to parse(). Nothing (length 0) when it is not there.
pub fn section(text: []const u8, name: []const u8) -> []const u8 {
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text[end] != 124 { end += 1 }
        var colon = start
        while colon < end && text[colon] != 58 { colon += 1 }
        if colon < end && std.text.same(std.text.trimmed(text[start..colon]), name) {
            return text[colon + 1..end]
        }
        start = end + 1
    }
    return text[0..0]
}

// Whether the curve changes nothing: it has no points, or all of them lie
// on the diagonal and reach from 0 to 1.
pub fn isIdentity(curve: *const Curve) -> bool {
    const count = curve.*.count
    if count == 0 { return true }
    if count < 2 || curve.*.x[0] != 0.0 || curve.*.x[count - 1] != 1.0 { return false }
    var index: usize = 0
    while index < count {
        if curve.*.y[index] != curve.*.x[index] { return false }
        index += 1
    }
    return true
}

// Whether the curve is level at `height` everywhere: all its points have
// that y.
pub fn isLevel(curve: *const Curve, height: f64) -> bool {
    if curve.*.count == 0 { return false }
    var index: usize = 0
    while index < curve.*.count {
        if curve.*.y[index] != height { return false }
        index += 1
    }
    return true
}

// The curve's height at `x`, 0..1. Left of the first point and right of
// the last it is that point's height; a curve without points answers x
// (held to 0..1); what is no number counts as 0.
pub fn value(curve: *const Curve, x: f64) -> f64 {
    const count = curve.*.count
    if count == 0 { return held(x) }
    if !(x > curve.*.x[0]) { return curve.*.y[0] }
    const last = count - 1
    if x >= curve.*.x[last] { return curve.*.y[last] }
    var index: usize = 0
    while index + 1 < last && x >= curve.*.x[index + 1] { index += 1 }
    // The piece between two points: the cubic whose second derivative
    // goes straight from one point's bend to the other's.
    const width = curve.*.x[index + 1] - curve.*.x[index]
    const left = curve.*.x[index + 1] - x
    const right = x - curve.*.x[index]
    const bend_left = curve.*.bend[index]
    const bend_right = curve.*.bend[index + 1]
    const cubic = (bend_left * left * left * left + bend_right * right * right * right) / (6.0 * width)
    const line = (curve.*.y[index] / width - bend_left * width / 6.0) * left + (curve.*.y[index + 1] / width - bend_right * width / 6.0) * right
    return held(cubic + line)
}

// The curve at `count` even steps from 0 to 1: into[i] is its height at
// i / (count - 1). A table for pixel loops.
pub fn fill(curve: *const Curve, into: [*]f64, count: usize) -> void {
    if count == 0 { return }
    if count == 1 {
        into[0] = value(curve, 0.0)
        return
    }
    const steps = @floatFromInt(f64, count - 1)
    var index: usize = 0
    while index < count {
        into[index] = value(curve, @floatFromInt(f64, index) / steps)
        index += 1
    }
}

// One number of 0..1 with four decimals at most ("0", "0.5", "0.1234",
// "1") at into[at]; returns the place after it. Seven bytes at most.
fn writeNumber(into: [*]u8, from: usize, value: f64) -> usize {
    var at = from
    const parts = @intFromFloat(u32, held(value) * 10000.0 + 0.5)
    into[at] = if parts >= 10000 { 49 } else { 48 }
    at += 1
    var rest = parts % 10000
    if rest == 0 { return at }
    into[at] = 46
    at += 1
    var divisor: u32 = 1000
    while rest != 0 {
        into[at] = @intCast(u8, 48 + rest / divisor)
        at += 1
        rest = rest % divisor
        divisor = divisor / 10
    }
    return at
}

// Writes the curve as parse() reads it, "x,y;x,y", four decimals to a
// number, into `into` (room for `capacity` bytes); returns the number of
// bytes written. A point that has no room any more is left out with all
// after it (16 bytes a point are always enough).
pub fn format(curve: *const Curve, into: [*]u8, capacity: usize) -> usize {
    var at: usize = 0
    var index: usize = 0
    while index < curve.*.count {
        if at + 16 > capacity { break }
        if index > 0 {
            into[at] = 59
            at += 1
        }
        at = writeNumber(into, at, curve.*.x[index])
        into[at] = 44
        at += 1
        at = writeNumber(into, at, curve.*.y[index])
        index += 1
    }
    return at
}
