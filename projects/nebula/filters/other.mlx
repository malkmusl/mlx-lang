// nebula filters: the Other group of the Filter menu: Random Noise,
// Random Pick and Wave (ids 350-359), and of the Colors group the three
// that are about a pixel's channels: Color to Alpha, Maximize Channel and
// Minimize Channel (ids 360-369).
//
//     var params: types.Params = undefined
//     registry.defaults(other.WAVE, &params)
//     params.values[2] = 12.0                      // horizontal amplitude
//     _ = registry.apply(&params, pixels, width, height, stride)
//
// Each works in place on straight pixels and reads its numbers held in
// their ranges (NaN: the initial value).
//
// Random Noise and Random Pick throw their dice for a pixel from the seed
// and the pixel's place in the rectangle handed in, and Wave counts its
// waves from the rectangle's first row and column: the same numbers give
// the same pixels, but a picture filtered block by block gets each block's
// own dice and waves. They are for a layer filtered whole (for Wave a
// caller can instead add a block's place to the two shifts; margin() is
// the larger amplitude, and Random Pick's half its window).
//
// Alpha: Random Noise, Maximize and Minimize keep it; Color to Alpha is
// about it; Random Pick and Wave move whole pixels, mixing colour weighed
// by alpha, and a pixel that ends transparent is 0.
const math = @import("std.math")
const types = @import("./types.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")

pub const Params = types.Params

pub const RANDOM_NOISE: u16 = 350
pub const RANDOM_PICK: u16 = 351
pub const WAVE: u16 = 352
pub const COLOR_TO_ALPHA: u16 = 360
pub const MAXIMIZE: u16 = 361
pub const MINIMIZE: u16 = 362

// Where each filter is in FILTERS.
const NOISE_PLACE: usize = 0
const PICK_PLACE: usize = 1
const WAVE_PLACE: usize = 2
const COLOR_TO_ALPHA_PLACE: usize = 3

const NO_PARAMS = [0]types.Param{}

// The number at `index` of a filter's `rows`, held in its range (files
// and scripts hand in anything; NaN counts as the initial value).
fn number(params: *const Params, rows: []const types.Param, index: usize) -> f64 {
    const value = params.*.values[index]
    if value != value { return rows[index].initial }
    if value < rows[index].low { return rows[index].low }
    if value > rows[index].high { return rows[index].high }
    return value
}

// The same as a whole number (the nearest).
fn whole(params: *const Params, rows: []const types.Param, index: usize) -> i32 {
    return @intFromFloat(i32, math.round(number(params, rows, index)))
}

// A colour parameter's 0xAARRGGBB.
fn colorOf(params: *const Params, rows: []const types.Param, index: usize) -> u32 {
    return @intCast(u32, @intFromFloat(i64, math.round(number(params, rows, index))))
}

// A percentage as a weight 0-255 (the nearest, a half up: 50 is 128).
fn weightOf(params: *const Params, rows: []const types.Param, index: usize) -> u32 {
    return @intFromFloat(u32, number(params, rows, index) * 255.0 / 100.0 + 0.5)
}

// The rectangle's pixels as rows without gaps between them, for a filter
// that reads around the pixel it writes. Null without memory.
fn copied(pool: *scratch.Pool, pixels: [*]const u32, width: usize, height: usize, stride: usize) -> ?[*]u32 {
    const source = scratch.words(pool, width * height)
    if source == null { return null }
    var y: usize = 0
    while y < height {
        const from = pixels + y * stride
        const into = source.? + y * width
        var x: usize = 0
        while x < width {
            into[x] = from[x]
            x += 1
        }
        y += 1
    }
    return source
}

// A number scrambled into 64 even bits (the last step of splitmix64, in
// three expressions the compiler puts in place of their calls): the dice.
// Nothing of std.random: the same seed has to give the same picture on
// every run and every system.
const GOLDEN: u64 = 0x9E3779B97F4A7C15
inline fn stirred(bits: u64) -> u64 { return (bits ^ (bits >> 30)) *% 0xBF58476D1CE4E5B9 }
inline fn stirredAgain(bits: u64) -> u64 { return (bits ^ (bits >> 27)) *% 0x94D049BB133111EB }
inline fn settled(bits: u64) -> u64 { return bits ^ (bits >> 31) }
inline fn scramble(value: u64) -> u64 { return settled(stirredAgain(stirred(value))) }

// a * b / 255 rounded and the step from a to b at t of 255 (pixel.mul and
// pixel.lerp, each as one expression so that no call is left in a loop).
inline fn rounded(sum: u32) -> u32 { return (sum + (sum >> 8)) >> 8 }
inline fn scaled(a: u32, b: u32) -> u32 { return rounded(a * b + 128) }
inline fn stepped(a: u32, b: u32, t: u32) -> u32 { return rounded(a * (255 - t) + b * t + 128) }

// How many of 2^24 throws change a pixel at `level` percent.
fn chanceOf(level: f64) -> u64 {
    return @intFromFloat(u64, level / 100.0 * 16777216.0 + 0.5)
}

// ---- Random Noise ----
//
// `level` percent of the pixels, chosen by dice, get a colour of the dice
// mixed in at `opacity` percent. Alpha stays, and what is transparent
// stays as it is.

const NOISE_PARAMS = [3]types.Param{
    types.Param.{ .name = "Level", .german = "Stärke", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 50.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Opacity", .german = "Deckkraft", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 100.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Seed", .german = "Startwert", .kind = types.INT, .low = 0.0, .high = 2147483647.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

fn randomNoise(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const rows = described(NOISE_PLACE)
    const chance = chanceOf(number(params, rows, 0))
    const strength = weightOf(params, rows, 1)
    const seed = @intCast(u64, whole(params, rows, 2))
    if chance == 0 || strength == 0 { return }
    const key = scramble(seed)
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        const row_key = scramble(key +% y)
        var x: usize = 0
        while x < width {
            const p = row[x]
            if p >> 24 != 0 {
                // The top 24 bits decide whether, the low 24 are the
                // colour.
                const dice = scramble(row_key +% x *% GOLDEN)
                if (dice >> 40) < chance {
                    const r = stepped((p >> 16) & 255, @intCast(u32, (dice >> 16) & 255), strength)
                    const g = stepped((p >> 8) & 255, @intCast(u32, (dice >> 8) & 255), strength)
                    const b = stepped(p & 255, @intCast(u32, dice & 255), strength)
                    row[x] = (p & 0xFF000000) | (r << 16) | (g << 8) | b
                }
            }
            x += 1
        }
        y += 1
    }
}

// ---- Random Pick ----
//
// `level` percent of the pixels, chosen by dice, become a pixel from
// somewhere in the square window around them (`window size` across, the
// rectangle's edge standing in for what is beyond it), mixed in at
// `opacity` percent. A window of one pixel changes nothing.

const PICK_PARAMS = [4]types.Param{
    types.Param.{ .name = "Level", .german = "Stärke", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 50.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Window size", .german = "Fenstergröße", .kind = types.INT, .low = 1.0, .high = 99.0, .initial = 3.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Opacity", .german = "Deckkraft", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 100.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Seed", .german = "Startwert", .kind = types.INT, .low = 0.0, .high = 2147483647.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

fn randomPickMargin(params: *const Params) -> i32 {
    return whole(params, described(PICK_PLACE), 1) / 2
}

fn randomPick(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const rows = described(PICK_PLACE)
    const chance = chanceOf(number(params, rows, 0))
    const reach = @intCast(usize, whole(params, rows, 1)) / 2
    const strength = weightOf(params, rows, 2)
    const seed = @intCast(u64, whole(params, rows, 3))
    if chance == 0 || strength == 0 || reach == 0 { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const copy = copied(pool, pixels, width, height, stride)
    if copy == null {
        scratch.release(pool, mark)
        return
    }
    const source = copy.?
    const span = @intCast(u64, reach * 2 + 1)
    // Other dice than Random Noise's for the same seed.
    const key = scramble(seed ^ 0x5851F42D4C957F2D)
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        const row_key = scramble(key +% y)
        var x: usize = 0
        while x < width {
            const dice = scramble(row_key +% x *% GOLDEN)
            if (dice >> 40) < chance {
                // A place in the window: 0 to span - 1 from its corner.
                var from_x = x + @intCast(usize, (dice & 0xFFFFF) % span)
                var from_y = y + @intCast(usize, ((dice >> 20) & 0xFFFFF) % span)
                from_x = if from_x < reach { 0 } else { from_x - reach }
                from_y = if from_y < reach { 0 } else { from_y - reach }
                if from_x >= width { from_x = width - 1 }
                if from_y >= height { from_y = height - 1 }
                var picked = source[from_y * width + from_x]
                if strength != 255 { picked = pixel.mix(row[x], picked, strength) }
                row[x] = if picked >> 24 == 0 { 0 } else { picked }
            }
            x += 1
        }
        y += 1
    }
    scratch.release(pool, mark)
}

// ---- Wave ----
//
// Each row is moved sideways by the horizontal wave at its height, each
// column up or down by the vertical wave at its place: the pixel at
// (x, y) shows the picture at (x + h(y), y + v(x)), between pixels the
// mix of the four around (colour weighed by alpha), beyond the edge the
// edge. A wave is amplitude * shape((place + shift) / wavelength), the
// shape a sine or a triangle of the same height, all three in whole
// pixels. No amplitude: nothing changes.

const WAVE_PARAMS = [8]types.Param{
    types.Param.{ .name = "Horizontal wavelength", .german = "Horizontale Wellenlänge", .kind = types.INT, .low = 1.0, .high = 1000.0, .initial = 50.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Horizontal shift", .german = "Horizontale Verschiebung", .kind = types.INT, .low = 0.0, .high = 1000.0, .initial = 50.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Horizontal amplitude", .german = "Horizontale Amplitude", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 4.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Horizontal shape", .german = "Horizontale Form", .kind = types.CHOICE, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "Sine|Triangle", .choicesGerman = "Sinus|Dreieck" },
    types.Param.{ .name = "Vertical wavelength", .german = "Vertikale Wellenlänge", .kind = types.INT, .low = 1.0, .high = 1000.0, .initial = 50.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Vertical shift", .german = "Vertikale Verschiebung", .kind = types.INT, .low = 0.0, .high = 1000.0, .initial = 50.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Vertical amplitude", .german = "Vertikale Amplitude", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 4.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Vertical shape", .german = "Vertikale Form", .kind = types.CHOICE, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "Sine|Triangle", .choicesGerman = "Sinus|Dreieck" },
}

fn waveMargin(params: *const Params) -> i32 {
    const rows = described(WAVE_PLACE)
    const across = whole(params, rows, 2)
    const down = whole(params, rows, 6)
    return if across > down { across } else { down }
}

// `count` shifts of a wave, one for each place from 0 on, as pairs: the
// whole pixels (rounded down) and what is left in 256ths. Where in its
// length the wave is at a place is counted in whole pixels, so that the
// wave is the same one length further on to the bit, and a caller who
// filters a part of a picture gets the picture's wave by adding the
// part's place to the shift. A sine, or a triangle that like it starts
// at nothing and goes up first.
fn waveShifts(into: [*]i32, count: usize, length: usize, shift: usize, amplitude: f64, shape: i32) -> void {
    var index: usize = 0
    while index < count {
        const turns = @floatFromInt(f64, (index + shift) % length) / @floatFromInt(f64, length)
        var moved = amplitude * math.sin(turns * math.tau)
        if shape != 0 {
            const part = turns + 0.75 - @floor(turns + 0.75)
            moved = amplitude * (4.0 * math.abs(part - 0.5) - 1.0)
        }
        var steps = @intFromFloat(i32, @floor(moved))
        var rest = @intFromFloat(i32, (moved - @floor(moved)) * 256.0 + 0.5)
        if rest == 256 {
            steps += 1
            rest = 0
        }
        into[index * 2] = steps
        into[index * 2 + 1] = rest
        index += 1
    }
}

fn wave(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const rows = described(WAVE_PLACE)
    const across = whole(params, rows, 2)
    const down = whole(params, rows, 6)
    if across == 0 && down == 0 { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const copy = copied(pool, pixels, width, height, stride)
    const of_rows = scratch.ints(pool, height * 2)
    const of_columns = scratch.ints(pool, width * 2)
    if copy == null || of_rows == null || of_columns == null {
        scratch.release(pool, mark)
        return
    }
    const source = copy.?
    const sideways = of_rows.?
    const upright = of_columns.?
    waveShifts(sideways, height, @intCast(usize, whole(params, rows, 0)), @intCast(usize, whole(params, rows, 1)), @floatFromInt(f64, across), whole(params, rows, 3))
    waveShifts(upright, width, @intCast(usize, whole(params, rows, 4)), @intCast(usize, whole(params, rows, 5)), @floatFromInt(f64, down), whole(params, rows, 7))
    const last_x = @intCast(isize, width) - 1
    const last_y = @intCast(isize, height) - 1
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        const wx = @intCast(u32, sideways[y * 2 + 1])
        const start = @intCast(isize, sideways[y * 2])
        var x: usize = 0
        while x < width {
            var x0 = @intCast(isize, x) + start
            var x1 = x0 + 1
            if x0 < 0 { x0 = 0 } else if x0 > last_x { x0 = last_x }
            if x1 < 0 { x1 = 0 } else if x1 > last_x { x1 = last_x }
            var y0 = @intCast(isize, y) + @intCast(isize, upright[x * 2])
            var y1 = y0 + 1
            if y0 < 0 { y0 = 0 } else if y0 > last_y { y0 = last_y }
            if y1 < 0 { y1 = 0 } else if y1 > last_y { y1 = last_y }
            const wy = @intCast(u32, upright[x * 2 + 1])
            const upper = source + @intCast(usize, y0) * width
            const p00 = upper[@intCast(usize, x0)]
            if wx == 0 && wy == 0 {
                row[x] = if p00 >> 24 == 0 { 0 } else { p00 }
            } else {
                const lower = source + @intCast(usize, y1) * width
                const p10 = upper[@intCast(usize, x1)]
                const p01 = lower[@intCast(usize, x0)]
                const p11 = lower[@intCast(usize, x1)]
                // The four around the place, each at its share (of
                // 65536) times its alpha. The sums stay in a u32: alpha
                // times share adds up to at most 255 * 65536, a colour
                // times that to 255 * 255 * 65536, which with the half
                // for rounding is below 2^32.
                const a00 = (p00 >> 24) * (256 - wx) * (256 - wy)
                const a10 = (p10 >> 24) * wx * (256 - wy)
                const a01 = (p01 >> 24) * (256 - wx) * wy
                const a11 = (p11 >> 24) * wx * wy
                const total = a00 + a10 + a01 + a11
                const alpha = (total + 32768) >> 16
                if alpha == 0 {
                    row[x] = 0
                } else if total == 16711680 {
                    // All four opaque: the shares alone.
                    const w00 = (256 - wx) * (256 - wy)
                    const w10 = wx * (256 - wy)
                    const w01 = (256 - wx) * wy
                    const w11 = wx * wy
                    const r = (((p00 >> 16) & 255) * w00 + ((p10 >> 16) & 255) * w10 + ((p01 >> 16) & 255) * w01 + ((p11 >> 16) & 255) * w11 + 32768) >> 16
                    const g = (((p00 >> 8) & 255) * w00 + ((p10 >> 8) & 255) * w10 + ((p01 >> 8) & 255) * w01 + ((p11 >> 8) & 255) * w11 + 32768) >> 16
                    const b = ((p00 & 255) * w00 + (p10 & 255) * w10 + (p01 & 255) * w01 + (p11 & 255) * w11 + 32768) >> 16
                    row[x] = 0xFF000000 | (r << 16) | (g << 8) | b
                } else {
                    const half = total / 2
                    const r = (((p00 >> 16) & 255) * a00 + ((p10 >> 16) & 255) * a10 + ((p01 >> 16) & 255) * a01 + ((p11 >> 16) & 255) * a11 + half) / total
                    const g = (((p00 >> 8) & 255) * a00 + ((p10 >> 8) & 255) * a10 + ((p01 >> 8) & 255) * a01 + ((p11 >> 8) & 255) * a11 + half) / total
                    const b = ((p00 & 255) * a00 + (p10 & 255) * a10 + (p01 & 255) * a01 + (p11 & 255) * a11 + half) / total
                    row[x] = (alpha << 24) | (r << 16) | (g << 8) | b
                }
            }
            x += 1
        }
        y += 1
    }
    scratch.release(pool, mark)
}

// ---- Color to Alpha ----
//
// The colour taken out of the picture, as far as it is in it. How far a
// pixel is from the colour (the largest difference of red, green and
// blue) against the threshold says how much of the pixel is left: nothing
// at the colour itself, all from the threshold on. Its alpha is multiplied
// by that, and its colour moved away from the taken colour by as much as
// the alpha went down, so that the result laid over the taken colour is
// the pixel as it was over it (but for a colour that would have to be
// beyond 0 or 255).

const COLOR_TO_ALPHA_PARAMS = [2]types.Param{
    types.Param.{ .name = "Color", .german = "Farbe", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Threshold", .german = "Schwellwert", .kind = types.INT, .low = 1.0, .high = 255.0, .initial = 100.0, .choices = "", .choicesGerman = "" },
}

// A colour's channel moved from the taken colour's by `threshold / far`
// times its distance from it (rounded, held in 0-255).
inline fn unmixed(channel: u32, taken: u32, threshold: i32, far: i32) -> u32 {
    return pixel.clamp(@intCast(i32, taken) + ((@intCast(i32, channel) - @intCast(i32, taken)) * threshold * 2 + (if channel < taken { 0 - far } else { far })) / (far * 2))
}

fn colorToAlpha(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const rows = described(COLOR_TO_ALPHA_PLACE)
    const taken = colorOf(params, rows, 0)
    const threshold = @intCast(u32, whole(params, rows, 1))
    const tr = (taken >> 16) & 255
    const tg = (taken >> 8) & 255
    const tb = taken & 255
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const a = p >> 24
            if a != 0 {
                const r = (p >> 16) & 255
                const g = (p >> 8) & 255
                const b = p & 255
                const dr = if r > tr { r - tr } else { tr - r }
                const dg = if g > tg { g - tg } else { tg - g }
                const db = if b > tb { b - tb } else { tb - b }
                var far = if dr > dg { dr } else { dg }
                if db > far { far = db }
                if far < threshold {
                    // What is left of the pixel, 0-255, times its alpha.
                    const left = scaled(a, (far * 255 + threshold / 2) / threshold)
                    if left == 0 {
                        row[x] = 0
                    } else {
                        const by = @intCast(i32, threshold)
                        const of = @intCast(i32, far)
                        row[x] = (left << 24) | (unmixed(r, tr, by, of) << 16) | (unmixed(g, tg, by, of) << 8) | unmixed(b, tb, by, of)
                    }
                }
            }
            x += 1
        }
        y += 1
    }
}

// ---- Maximize Channel, Minimize Channel ----
//
// Of red, green and blue only the largest (the smallest) stays, the
// others become 0; channels that are equal stay together, so a grey stays
// the grey it is. Alpha stays.

fn maximize(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const r = (p >> 16) & 255
            const g = (p >> 8) & 255
            const b = p & 255
            var most = if r > g { r } else { g }
            if b > most { most = b }
            var result: u32 = p & 0xFF000000
            if r == most { result |= r << 16 }
            if g == most { result |= g << 8 }
            if b == most { result |= b }
            row[x] = result
            x += 1
        }
        y += 1
    }
}

fn minimize(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            const r = (p >> 16) & 255
            const g = (p >> 8) & 255
            const b = p & 255
            var least = if r < g { r } else { g }
            if b < least { least = b }
            var result: u32 = p & 0xFF000000
            if r == least { result |= r << 16 }
            if g == least { result |= g << 8 }
            if b == least { result |= b }
            row[x] = result
            x += 1
        }
        y += 1
    }
}

const FILTERS = [6]types.Info{
    types.Info.{ .id = RANDOM_NOISE, .key = "noise", .name = "Random Noise", .german = "Zufälliges Rauschen", .category = types.OTHER, .params = NOISE_PARAMS[0..], .margin = null, .apply = randomNoise },
    types.Info.{ .id = RANDOM_PICK, .key = "randompick", .name = "Random Pick", .german = "Zufällige Auswahl", .category = types.OTHER, .params = PICK_PARAMS[0..], .margin = randomPickMargin, .apply = randomPick },
    types.Info.{ .id = WAVE, .key = "wave", .name = "Wave", .german = "Welle", .category = types.OTHER, .params = WAVE_PARAMS[0..], .margin = waveMargin, .apply = wave },
    types.Info.{ .id = COLOR_TO_ALPHA, .key = "colortoalpha", .name = "Color to Alpha", .german = "Farbe zu Alpha", .category = types.COLORS, .params = COLOR_TO_ALPHA_PARAMS[0..], .margin = null, .apply = colorToAlpha },
    types.Info.{ .id = MAXIMIZE, .key = "maximize", .name = "Maximize Channel", .german = "Kanal maximieren", .category = types.COLORS, .params = NO_PARAMS[0..], .margin = null, .apply = maximize },
    types.Info.{ .id = MINIMIZE, .key = "minimize", .name = "Minimize Channel", .german = "Kanal minimieren", .category = types.COLORS, .params = NO_PARAMS[0..], .margin = null, .apply = minimize },
}

// The list in heap memory that stays, once it was asked for (a slice of
// the constant table itself would be a copy of all of it in the value
// arena at every asking: core/table.mlx).
var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's filters. What it gives stays valid and where it is (only
// without memory at the first asking is it the table itself, good until
// the window's loop turns; the next asking tries again).
pub fn list() -> []const types.Info {
    if kept.address != 0 { return table.rows(types.Info, &kept) }
    return table.keep(types.Info, &kept, FILTERS[0..])
}

// What the filter at `place` of the list says of its numbers (the rows'
// own slices point at the parameter tables in the program's data).
fn described(place: usize) -> []const types.Param {
    return list()[place].params
}
