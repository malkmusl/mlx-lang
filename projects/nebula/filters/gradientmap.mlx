// nebula filters: Gradient Map (Filter > Map): each pixel's lightness
// looked up in a gradient, dark to the gradient's start, light to its
// end. The gradient is params.text in core/gradient.mlx's compact form
// (black to white when it is empty or no gradient); its stops that
// stand for the foreground or background colour are black and white
// here (a filter layer has no tool colours). A pixel keeps its alpha
// (times the gradient's, where the gradient is translucent); one that
// ends transparent is stored as 0.
//
//     var params: filters.Params = undefined
//     filters.defaults(gradientmap.GRADIENT_MAP, &params)
//     node.setParamsText(&params, "0:#1b1464;0.5:#e8475f;1:#ffe98a")
//     _ = filters.apply(&params, pixels, width, height, stride)
//
// Without dithering the lightness is pixel.luma (0-255) and the colour
// the gradient's at luma / 255: black and white go to the two ends
// exactly. With "Dither" the lightness is taken at 256 times that
// precision and the colour rounded by an ordered 8 x 8 pattern, which
// hides the bands a gradient of many colours shows over a smooth
// picture. The pattern is fixed to the rectangle handed in: blocks that
// start at multiples of 8 (tiles do) join without a seam.
const types = @import("./types.mlx")
const table = @import("../core/table.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const node = @import("../core/node.mlx")
const gradient = @import("../core/gradient.mlx")

pub const Params = types.Params

pub const GRADIENT_MAP: u16 = 310

const PARAMS = [2]types.Param{
    types.Param.{ .name = "Gradient", .german = "Verlauf", .kind = types.TEXT, .low = 0.0, .high = 0.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Dither", .german = "Dithern", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// A pixel of the gradient's colour with the alpha of `source` (times the
// gradient's).
inline fn mapped(source: u32, color: u32) -> u32 {
    const alpha = pixel.mul(source >> 24, color >> 24)
    if alpha == 0 { return 0 }
    return (alpha << 24) | (color & 0x00FFFFFF)
}

fn gradientMap(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var shown: gradient.Gradient = undefined
    if !gradient.parse(node.paramsText(params), &shown) { gradient.init(&shown, pixel.BLACK, pixel.WHITE) }
    const dither = params.*.values[1] >= 0.5
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    if dither {
        const memory = scratch.bytes(pool, gradient.FINE_ENTRIES * 8)
        if memory != null {
            const fine: [*]u64 = unsafe { @ptrCast([*]u64, memory.?) }
            gradient.bakeFine(&shown, fine, pixel.BLACK, pixel.WHITE)
            var y: usize = 0
            while y < height {
                const row = pixels + y * stride
                var x: usize = 0
                while x < width {
                    const value = row[x]
                    // Rec. 601 luma in 256ths of a level: 0..65280.
                    const light = pixel.red(value) * 77 + pixel.green(value) * 150 + pixel.blue(value) * 29
                    const color = gradient.tableColor(fine, @floatFromInt(f64, light) / 65280.0, true, @intCast(i32, x & 7), @intCast(i32, y & 7))
                    row[x] = mapped(value, color)
                    x += 1
                }
                y += 1
            }
        }
        scratch.release(pool, mark)
        return
    }
    const colors = scratch.words(pool, 256)
    if colors != null {
        gradient.bake(&shown, colors.?, 256, pixel.BLACK, pixel.WHITE)
        var y: usize = 0
        while y < height {
            const row = pixels + y * stride
            var x: usize = 0
            while x < width {
                const value = row[x]
                row[x] = mapped(value, colors.?[@intCast(usize, pixel.luma(value))])
                x += 1
            }
            y += 1
        }
    }
    scratch.release(pool, mark)
}

const FILTERS = [1]types.Info{
    types.Info.{ .id = GRADIENT_MAP, .key = "gradientmap", .name = "Gradient Map", .german = "Verlaufsumsetzung", .category = types.MAP, .params = PARAMS[0..], .margin = null, .apply = gradientMap },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const types.Info {
    if kept.address != 0 { return table.rows(types.Info, &kept) }
    return table.keep(types.Info, &kept, FILTERS[0..])
}
