// nebula filters: the Filter menu's Enhance group: what makes a picture
// crisper (Sharpen, Mean Removal, Unsharp Mask) and what takes noise out
// of it (Gaussian Noise Reduction, Wavelet Noise Reducer).
//
// All of them read around a pixel, so they work on wide pixels
// (filters/blur.mlx: alpha times 255, each colour times the alpha) with
// blur.mlx's bands, lines and kernels, and a transparent pixel's colour
// counts for nothing. Where a filter changes the alpha too (the edge of
// what is painted is sharpened or smoothed like the colours) it says so.
// Each is exact for a part of a picture handed in with margin() pixels
// around it, as blur.mlx's are.
const math = @import("std.math")
const types = @import("./types.mlx")
const scratch = @import("../core/scratch.mlx")
const blur = @import("./blur.mlx")

pub const Params = types.Params

pub const SHARPEN: u16 = 150
pub const MEAN_REMOVAL: u16 = 151
pub const UNSHARP_MASK: u16 = 152
pub const GAUSSIAN_NOISE_REDUCTION: u16 = 153
pub const WAVELET_NOISE_REDUCTION: u16 = 154

const NO_PARAMS = [0]types.Param{}

// ---------------------------------------------------------------------
// Sharpen, Mean Removal

// Krita's two: its Sharpen takes two of each of the four neighbours from
// eleven of the pixel and divides by three, its Mean Removal takes all
// eight neighbours from nine of the pixel. (Neither is the
// 0 -1 0 / -1 5 -1 / 0 -1 0 other programs call Sharpen: that one lies
// between the two.) The alpha goes through the same weights.
const SHARPEN_WEIGHTS = [9]i32{ 0, -2, 0, -2, 11, -2, 0, -2, 0 }
const MEAN_REMOVAL_WEIGHTS = [9]i32{ -1, -1, -1, -1, 9, -1, -1, -1, -1 }

fn oneAround(params: *const Params) -> i32 {
    return 1
}

fn sharpen(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const kernel = blur.Kernel.{ .reachX = 1, .reachY = 1, .weights = SHARPEN_WEIGHTS[0..].pointer, .total = 3 }
    _ = blur.convolve(&kernel, pixels, width, height, stride)
}

fn meanRemoval(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const kernel = blur.Kernel.{ .reachX = 1, .reachY = 1, .weights = MEAN_REMOVAL_WEIGHTS[0..].pointer, .total = 1 }
    _ = blur.convolve(&kernel, pixels, width, height, stride)
}

// ---------------------------------------------------------------------
// A picture against its gaussian: Unsharp Mask and Gaussian Noise
// Reduction both blur a copy and then decide pixel by pixel.

// What is made of a pixel and its blurred one.
const SHARPEN_ALL: u8 = 0
const SHARPEN_LIGHT: u8 = 1
const REDUCE: u8 = 2

// One channel pushed away from its blurred value: by `gain` 256ths of
// the difference, where that is at least `least`.
inline fn pushed(own: i64, soft: i64, gain: i64, least: i64) -> u64 {
    const difference = own - soft
    const size = if difference < 0 { -difference } else { difference }
    if size < least { return @intCast(u64, own) }
    var value = own + ((difference * gain + 128) >> 8)
    if value < 0 { value = 0 }
    if value > 65025 { value = 65025 }
    return @intCast(u64, value)
}

// Each channel for itself, the alpha too.
fn sharpenAll(original: [*]u64, blurred: [*]const u64, count: usize, gain: i64, least: i64) -> void {
    var index: usize = 0
    while index < count {
        const own = original[index]
        const soft = blurred[index]
        if own != soft {
            const a = pushed(@intCast(i64, own >> 48), @intCast(i64, soft >> 48), gain, least)
            const r = pushed(@intCast(i64, (own >> 32) & 0xFFFF), @intCast(i64, (soft >> 32) & 0xFFFF), gain, least)
            const g = pushed(@intCast(i64, (own >> 16) & 0xFFFF), @intCast(i64, (soft >> 16) & 0xFFFF), gain, least)
            const b = pushed(@intCast(i64, own & 0xFFFF), @intCast(i64, soft & 0xFFFF), gain, least)
            original[index] = (a << 48) | (r << 32) | (g << 16) | b
        }
        index += 1
    }
}

// A wide pixel's lightness (the weights of pixel.luma) as that of its
// colour alone, 0 to 65025: over its alpha.
inline fn lightness(wide: u64, alpha: i64) -> i64 {
    const light = (@intCast(i64, (wide >> 32) & 0xFFFF) * 77 + @intCast(i64, (wide >> 16) & 0xFFFF) * 150 + @intCast(i64, wide & 0xFFFF) * 29) >> 8
    if alpha == 65025 { return light }
    return light * 65025 / alpha
}

inline fn held(value: i64, most: i64) -> u64 {
    if value < 0 { return 0 }
    if value > most { return @intCast(u64, most) }
    return @intCast(u64, value)
}

// Only how light a pixel is: the difference of the two lightnesses goes
// to all three colours alike, so the hue stays, and the alpha is left
// alone. The lightness is that of the colour itself, not of the colour
// times its alpha: next to a transparent pixel a colour is not darker.
fn sharpenLight(original: [*]u64, blurred: [*]const u64, count: usize, gain: i64, least: i64) -> void {
    var index: usize = 0
    while index < count {
        const own = original[index]
        const soft = blurred[index]
        const alpha = @intCast(i64, own >> 48)
        const soft_alpha = @intCast(i64, soft >> 48)
        if own != soft && alpha != 0 && soft_alpha != 0 {
            const difference = lightness(own, alpha) - lightness(soft, soft_alpha)
            const size = if difference < 0 { -difference } else { difference }
            if size >= least && size != 0 {
                var more = (difference * gain + 128) >> 8
                // As much of it as the pixel has alpha: the colours here
                // are times the alpha.
                if alpha != 65025 { more = more * alpha / 65025 }
                const r = held(@intCast(i64, (own >> 32) & 0xFFFF) + more, alpha)
                const g = held(@intCast(i64, (own >> 16) & 0xFFFF) + more, alpha)
                const b = held(@intCast(i64, own & 0xFFFF) + more, alpha)
                original[index] = (own & 0xFFFF000000000000) | (r << 32) | (g << 16) | b
            }
        }
        index += 1
    }
}

inline fn apart(own: u64, soft: u64) -> i64 {
    const difference = @intCast(i64, own) - @intCast(i64, soft)
    return if difference < 0 { -difference } else { difference }
}

// A pixel whose channels all are nearer than `least` to the blurred
// one's becomes the blurred one; any other stays.
fn reduce(original: [*]u64, blurred: [*]const u64, count: usize, least: i64) -> void {
    var index: usize = 0
    while index < count {
        const own = original[index]
        const soft = blurred[index]
        if own != soft {
            var widest = apart(own >> 48, soft >> 48)
            const r = apart((own >> 32) & 0xFFFF, (soft >> 32) & 0xFFFF)
            const g = apart((own >> 16) & 0xFFFF, (soft >> 16) & 0xFFFF)
            const b = apart(own & 0xFFFF, soft & 0xFFFF)
            if r > widest { widest = r }
            if g > widest { widest = g }
            if b > widest { widest = b }
            if widest < least { original[index] = soft }
        }
        index += 1
    }
}

// The numbers of againstBlur's rule.
const Rule = struct {
    kind: u8
    gain: i64
    least: i64
}

// The rectangle against its gaussian of `radius` (weighed out `cut`
// pixels far when that is above 0): each pixel and its blurred one by
// `rule`. Without memory the pixels stay.
fn againstBlur(pixels: [*]u32, width: usize, height: usize, stride: usize, radius: f64, cut: usize, rule: *const Rule) -> void {
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    var axis: blur.Axis = undefined
    var bands: blur.Bands = undefined
    var lines: blur.Lines = undefined
    var ready = blur.gaussianAxis(&axis, pool, radius, cut)
    if ready { ready = blur.bandsBegin(&bands, pool, pixels, width, height, stride, blur.axisReach(&axis)) }
    if ready {
        const rows = blur.bandsTallest(&bands)
        const original = blur.wides(pool, width * rows)
        const blurred = blur.wides(pool, width * rows)
        if original != null && blurred != null && blur.linesBegin(&lines, pool, width, rows, &axis, &axis) {
            while blur.bandsNext(&bands) {
                blur.bandsLoad(&bands, original.?, width, 0)
                blur.separable(blurred.?, original.?, width, width, blur.bandsRows(&bands), &axis, &axis, &lines)
                // Only the band's own rows are kept: those are decided.
                const own = original.? + bands.margin * width
                const soft = blurred.? + bands.margin * width
                const count = (bands.last - bands.first) * width
                if rule.*.kind == SHARPEN_ALL {
                    sharpenAll(own, soft, count, rule.*.gain, rule.*.least)
                } else if rule.*.kind == SHARPEN_LIGHT {
                    sharpenLight(own, soft, count, rule.*.gain, rule.*.least)
                } else {
                    reduce(own, soft, count, rule.*.least)
                }
                blur.bandsStore(&bands, original.?, width, 0)
            }
        }
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------
// Unsharp Mask

const UNSHARP_PARAMS = [4]types.Param{
    types.Param.{ .name = "Radius", .german = "Radius", .kind = types.FLOAT, .low = 0.0, .high = 100.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Amount", .german = "Menge", .kind = types.FLOAT, .low = 0.0, .high = 5.0, .initial = 0.5, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Threshold", .german = "Schwellwert", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Lightness only", .german = "Nur Helligkeit", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
}

// Nothing happens without a radius or without an amount.
fn unsharpRests(params: *const Params) -> bool {
    return blur.number(params, UNSHARP_PARAMS[0..], 0) <= 0.0 || blur.number(params, UNSHARP_PARAMS[0..], 1) <= 0.0
}

fn unsharpMargin(params: *const Params) -> i32 {
    if unsharpRests(params) { return 0 }
    return @intCast(i32, blur.gaussianReach(blur.number(params, UNSHARP_PARAMS[0..], 0)))
}

// The picture and `Amount` times what a gaussian of `Radius` takes from
// it, where that is at least `Threshold` (of 255). With `Lightness only`
// the colours keep their hue and the alpha stays; without, every channel
// goes for itself, the alpha too.
fn unsharp(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    if unsharpRests(params) { return }
    const rule = Rule.{
        .kind = if blur.number(params, UNSHARP_PARAMS[0..], 3) >= 0.5 { SHARPEN_LIGHT } else { SHARPEN_ALL },
        .gain = @intFromFloat(i64, blur.number(params, UNSHARP_PARAMS[0..], 1) * 256.0 + 0.5),
        .least = @intCast(i64, blur.whole(params, UNSHARP_PARAMS[0..], 2)) * 255,
    }
    againstBlur(pixels, width, height, stride, blur.number(params, UNSHARP_PARAMS[0..], 0), 0, &rule)
}

// ---------------------------------------------------------------------
// Gaussian Noise Reduction

const REDUCER_PARAMS = [2]types.Param{
    types.Param.{ .name = "Threshold", .german = "Schwellwert", .kind = types.INT, .low = 0.0, .high = 255.0, .initial = 15.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Window size", .german = "Fenstergröße", .kind = types.INT, .low = 0.0, .high = 10.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
}

fn reducerMargin(params: *const Params) -> i32 {
    if blur.whole(params, REDUCER_PARAMS[0..], 0) == 0 { return 0 }
    return @intCast(i32, blur.whole(params, REDUCER_PARAMS[0..], 1))
}

// Krita's: a pixel that is nearer than `Threshold` (of 255, in every
// channel and the alpha) to a soft copy of the picture is taken from
// that copy, any other stays as it is: grain goes, edges stay. The copy
// is a gaussian of radius `Window size` that ends at the window.
fn reducer(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const threshold = blur.whole(params, REDUCER_PARAMS[0..], 0)
    const window = blur.whole(params, REDUCER_PARAMS[0..], 1)
    if threshold == 0 || window == 0 { return }
    const rule = Rule.{ .kind = REDUCE, .gain = 0, .least = @intCast(i64, threshold) * 255 }
    againstBlur(pixels, width, height, stride, @floatFromInt(f64, window), window, &rule)
}

// ---------------------------------------------------------------------
// Wavelet Noise Reducer

const WAVELET_PARAMS = [1]types.Param{
    types.Param.{ .name = "Threshold", .german = "Schwellwert", .kind = types.FLOAT, .low = 0.0, .high = 256.0, .initial = 7.0, .choices = "", .choicesGerman = "" },
}

// The picture is taken apart into what is finer than 1, 2, 4, 8 and 16
// pixels and the smooth rest.
const SCALES: usize = 5
// The smoothings reach 1 + 2 + 4 + 8 + 16 pixels together.
const WAVELET_REACH: usize = 31
// What grain of deviation 1 leaves in each scale's details (the length
// of the detail a single pixel makes there): the threshold is meant for
// the grain, so each scale is asked for its share of it.
const GRAIN = [5]f64{ 0.8004, 0.2729, 0.1198, 0.0578, 0.0286 }

// Each detail (what a smoothing took: `finer` less `coarser`) is drawn
// toward nothing by `limit` (a detail smaller than that is gone, a larger
// one that much smaller) and what is left added to `kept`, four numbers a
// pixel.
fn shrink(kept: [*]i32, finer: [*]const u64, coarser: [*]const u64, count: usize, limit: i32) -> void {
    var index: usize = 0
    while index < count {
        const fine = finer[index]
        const coarse = coarser[index]
        if fine != coarse {
            const sums = kept + index * 4
            var shift: u6 = 0
            var channel: usize = 0
            while channel < 4 {
                const detail = @intCast(i32, (fine >> shift) & 0xFFFF) - @intCast(i32, (coarse >> shift) & 0xFFFF)
                if detail > limit {
                    sums[channel] += detail - limit
                } else if detail < -limit {
                    sums[channel] += detail + limit
                }
                shift +%= 16
                channel += 1
            }
        }
        index += 1
    }
}

// The smooth rest and the details that were kept together again.
fn rebuild(rest: [*]u64, kept: [*]const i32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        const wide = rest[index]
        const sums = kept + index * 4
        var b = @intCast(i32, wide & 0xFFFF) + sums[0]
        var g = @intCast(i32, (wide >> 16) & 0xFFFF) + sums[1]
        var r = @intCast(i32, (wide >> 32) & 0xFFFF) + sums[2]
        var a = @intCast(i32, wide >> 48) + sums[3]
        if b < 0 { b = 0 }
        if g < 0 { g = 0 }
        if r < 0 { r = 0 }
        if a < 0 { a = 0 }
        if b > 65025 { b = 65025 }
        if g > 65025 { g = 65025 }
        if r > 65025 { r = 65025 }
        if a > 65025 { a = 65025 }
        rest[index] = (@intCast(u64, a) << 48) | (@intCast(u64, r) << 32) | (@intCast(u64, g) << 16) | @intCast(u64, b)
        index += 1
    }
}

fn waveletMargin(params: *const Params) -> i32 {
    if blur.number(params, WAVELET_PARAMS[0..], 0) <= 0.0 { return 0 }
    return @intCast(i32, WAVELET_REACH)
}

// Grain taken out scale by scale: the picture is smoothed five times,
// each time twice as wide (the pixel's half and a quarter of each of the
// two neighbours 1, 2, 4, 8, 16 away, along the rows and the columns),
// and what each smoothing took is kept only as far as it is larger than
// the threshold's share for that scale. With whole numbers all through,
// a threshold of nothing gives the picture back. The alpha is a channel
// like the colours.
fn wavelet(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const threshold = blur.number(params, WAVELET_PARAMS[0..], 0)
    if threshold <= 0.0 { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    // The planes have the reach more on every side, the picture's edge
    // repeated there: every smoothing then sees the picture continued,
    // not what the smoothing before made of its edge.
    const row_stride = width + 2 * WAVELET_REACH
    var widest: blur.Axis = undefined
    blur.oneAxis(&widest, blur.HAT, 16)
    var axis: blur.Axis = undefined
    var bands: blur.Bands = undefined
    var lines: blur.Lines = undefined
    if blur.bandsBegin(&bands, pool, pixels, width, height, stride, WAVELET_REACH) {
        const rows = blur.bandsTallest(&bands)
        const first = blur.wides(pool, row_stride * rows)
        const second = blur.wides(pool, row_stride * rows)
        const kept = scratch.ints(pool, row_stride * rows * 4)
        if first != null && second != null && kept != null && blur.linesBegin(&lines, pool, row_stride, rows, &widest, &widest) {
            while blur.bandsNext(&bands) {
                const count = blur.bandsRows(&bands) * row_stride
                blur.bandsLoad(&bands, first.?, row_stride, WAVELET_REACH)
                blur.spreadEdges(first.?, row_stride, blur.bandsRows(&bands), width, WAVELET_REACH)
                var index: usize = 0
                while index < count * 4 {
                    kept.?[index] = 0
                    index += 1
                }
                var finer = first.?
                var coarser = second.?
                var scale: usize = 0
                while scale < SCALES {
                    blur.oneAxis(&axis, blur.HAT, @intCast(usize, 1) << @intCast(u6, scale))
                    blur.separable(coarser, finer, row_stride, row_stride, blur.bandsRows(&bands), &axis, &axis, &lines)
                    shrink(kept.?, finer, coarser, count, @intFromFloat(i32, threshold * 255.0 * GRAIN[scale] + 0.5))
                    const swap = finer
                    finer = coarser
                    coarser = swap
                    scale += 1
                }
                rebuild(finer, kept.?, count)
                blur.bandsStore(&bands, finer, row_stride, WAVELET_REACH)
            }
        }
    }
    scratch.release(pool, mark)
}

// ---------------------------------------------------------------------

const FILTERS = [5]types.Info{
    types.Info.{ .id = SHARPEN, .key = "sharpen", .name = "Sharpen", .german = "Schärfen", .category = types.ENHANCE, .params = NO_PARAMS[0..], .margin = oneAround, .apply = sharpen },
    types.Info.{ .id = MEAN_REMOVAL, .key = "mean removal", .name = "Mean Removal", .german = "Mittelwert entfernen", .category = types.ENHANCE, .params = NO_PARAMS[0..], .margin = oneAround, .apply = meanRemoval },
    types.Info.{ .id = UNSHARP_MASK, .key = "unsharp", .name = "Unsharp Mask", .german = "Unscharf maskieren", .category = types.ENHANCE, .params = UNSHARP_PARAMS[0..], .margin = unsharpMargin, .apply = unsharp },
    types.Info.{ .id = GAUSSIAN_NOISE_REDUCTION, .key = "gaussiannoisereducer", .name = "Gaussian Noise Reduction", .german = "Gaußsche Rauschminderung", .category = types.ENHANCE, .params = REDUCER_PARAMS[0..], .margin = reducerMargin, .apply = reducer },
    types.Info.{ .id = WAVELET_NOISE_REDUCTION, .key = "waveletnoisereducer", .name = "Wavelet Noise Reducer", .german = "Wavelet-Rauschminderung", .category = types.ENHANCE, .params = WAVELET_PARAMS[0..], .margin = waveletMargin, .apply = wavelet },
}

pub fn list() -> []const types.Info { return FILTERS[0..] }
