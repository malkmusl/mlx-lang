// nebula filters: the Edge Detection and Emboss groups of the Filter menu
// (ids 200 to 249), and the two convolutions they are made of.
//
// convolve3() meets every pixel and its eight neighbours with nine whole
// weights; convolveSeparable() does the same for a kernel of any size that
// is one row of weights along the picture's rows times another across
// them. Both work in place, take what is outside the rectangle as its
// nearest pixel inside, and answer per channel
//
//     offset + (sum of weight * neighbour) / divisor      rounded, held to 0..255
//
//     const blur = edge.Separable.{ .along = ONES[0..], .across = ONES[0..], .center = 0, .divisor = 9, .offset = 0, .channels = edge.COLOR }
//     _ = edge.convolveSeparable(pixels, width, height, stride, &blur)
//
// What the two agree on:
//
//   Whole numbers. The sums are exact and divided once, halves rounding
//   upward: a picture filtered in parts (each with the filter's margin
//   around it) is the picture filtered whole, bit for bit.
//
//   Convolution. The weights are written as one reads them in a book (and
//   as Krita shows its kernels) and meet the picture turned by half a
//   turn: the weight written first meets the neighbour below and to the
//   right. So Krita's "top edge" kernel (1 1 1 / 0 0 0 / -1 -1 -1) is the
//   row below minus the row above.
//
//   Alpha. A pixel keeps its alpha: these kernels are about colour. A
//   neighbour counts by its alpha, and what it lacks is taken as the
//   pixel's own colour, so a transparent neighbour is no edge and neither
//   darkens nor tints (inside, the sums are of colour times alpha; a
//   picture without any transparency takes a shorter way to the same
//   numbers). A fully transparent pixel is stored as 0.
//
//   Channels. `channels` names the colour channels that take the answer
//   (CHANNEL_RED | CHANNEL_GREEN | CHANNEL_BLUE = COLOR); with GRAY the
//   kernel meets the pixels' lightness (pixel.luma) and its one answer goes
//   to the channels named.
//
// The filters:
//
//   Top, Right, Bottom, Left Edge Detection and the five fixed Emboss
//   filters are Krita's 3x3 kernels, rows of FIXED. Their offset is 127
//   and nothing is made absolute, as in Krita: the answer keeps its sign
//   around mid grey, so the four sides stay four pictures (with absolute
//   values top and bottom would be the same) and a layer of it blends as a
//   relief. "Top" is lighter than mid grey at the upper edge of a light
//   shape (the picture grows lighter downward there), "Left" at its left
//   edge, and so on. Laplacian Edge Detection (ours, Krita has none) is the
//   eight-neighbour laplacian with offset 0: thin light lines on black on
//   the lighter side of every edge.
//
//   Edge Detection builds its kernels for the two radii: a slope kernel
//   one way, a smoothing kernel the other. A radius becomes a reach of
//   ceil(0.3 * radius + 0.3) pixels (1 to 31), the size of the gaussian
//   Krita takes for it. Prewitt: a ramp times a box; Sobel: the slope of a
//   bell times the bell (at reach 1 the classic -1 0 1 times 1 2 1);
//   Simple: one line of 1 / distance. Each is divided so that a hard step
//   answers what it does at reach 1 (3, 4 and 1 times its height), whatever
//   the radius: a larger radius finds softer edges, not louder ones. The
//   horizontal radius shapes the kernel of the left-right slope, the
//   vertical one that of the up-down slope. "All Sides" is the length of
//   the two slopes, the four sides are one slope around mid grey (Prewitt
//   at radius 1 is the fixed filter of that side), "Direction in Radians"
//   is the angle of the slope (0, lighter to the right, is grey 128; a
//   quarter turn, lighter downward, 191; no slope: 128). "Apply to Alpha"
//   keeps the colour and makes the answer's mean the pixel's alpha.
//
//   Gaussian High Pass is the pixel minus a gaussian of it plus 128; the
//   radius is Krita's (sigma 0.3 * radius + 0.3). Up to a reach of 6
//   pixels (a radius of 5.6) the bell is its own weights, three sigmas
//   each way; beyond that it is three box blurs after one another, of the
//   same variance as near as whole boxes get, done with running sums: the
//   time does not grow with the radius.
//
//   Height to Normal Map reads the lightness as a height (255: one pixel
//   high), takes its two slopes with Edge Detection's kernels and writes
//   the tangent-space normal (-slope right, slope down, 1), made one long:
//   each of red, green and blue shows one of X+ X- Y+ Y- Z+ Z- (X to the
//   right, Y up, Z out of the picture; a flat height is 128, 128, 255 for
//   X+, Y+, Z+).
//
//   Emboss with Variable Depth is the classic relief: the lightness of a
//   pixel minus that of its neighbour up and to the left, times depth / 10,
//   around mid grey 127. It works on the lightness, not per channel (the
//   answer is a grey picture, as Krita's, which takes the mean of the three
//   channels' differences), and a difference that leaves 0..255 is held
//   there, not folded back.
//
// Time: a kernel is added up three weights a turn over a whole row; a row
// of equal weights (a box) and one that falls evenly through zero (a ramp:
// Prewitt's slope) are running sums instead, as the high pass's boxes
// are. Not done: Sobel's and Simple's kernels are added up weight by
// weight at every radius (63 weights each way at radius 100, a tenth of
// the speed at radius 1).
//
// Without memory for the working rows a filter leaves the pixels as they
// are.
const math = @import("std.math")
const types = @import("./types.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")

pub const Params = types.Params

pub const TOP_EDGE: u16 = 200
pub const RIGHT_EDGE: u16 = 201
pub const BOTTOM_EDGE: u16 = 202
pub const LEFT_EDGE: u16 = 203
pub const EDGE_DETECTION: u16 = 204
pub const GAUSSIAN_HIGH_PASS: u16 = 205
pub const HEIGHT_TO_NORMAL: u16 = 206
pub const LAPLACIAN: u16 = 207
pub const EMBOSS_HORIZONTAL: u16 = 220
pub const EMBOSS_VERTICAL: u16 = 221
pub const EMBOSS_ALL: u16 = 222
pub const EMBOSS_HORIZONTAL_VERTICAL: u16 = 223
pub const EMBOSS_LAPLACIAN: u16 = 224
pub const EMBOSS: u16 = 225

// Edge Detection's and Height to Normal Map's choices, as their values.
pub const PREWITT: i32 = 0
pub const SOBEL: i32 = 1
pub const SIMPLE: i32 = 2

pub const ALL_SIDES: i32 = 0
pub const TOP: i32 = 1
pub const BOTTOM: i32 = 2
pub const RIGHT: i32 = 3
pub const LEFT: i32 = 4
pub const DIRECTION: i32 = 5

// A kernel's `channels` (the bits of node.channels).
pub const CHANNEL_BLUE: u32 = 1
pub const CHANNEL_GREEN: u32 = 2
pub const CHANNEL_RED: u32 = 4
pub const COLOR: u32 = 7
pub const GRAY: u32 = 16

// The most the absolute weights of one row of a separable kernel may add
// up to: a row's sums of colour times alpha stay inside 32 bits then.
pub const HEAVIEST: i64 = 33000

// Nine weights, the rows from the top, each from the left.
pub const Kernel3 = struct {
    weights: [9]i32
    divisor: i32
    offset: i32
    channels: u32
}

// `along` times `across` (each an odd number of weights, the middle one on
// the pixel), and `center` more for the pixel itself: a high pass is the
// pixel, weighed as much as the blur, minus the blur.
pub const Separable = struct {
    along: []const i32
    across: []const i32
    center: i32
    divisor: i32
    offset: i32
    channels: u32
}

// What a pixel is to a kernel: its three colour channels, or with LUMA its
// lightness alone; with WEIGHED (not every pixel is opaque) these times
// alpha, and the alpha after them.
const LUMA: u32 = 1
const WEIGHED: u32 = 2

inline fn valuesOf(form: u32) -> usize {
    return if form == 0 { 3 } else if form == LUMA { 1 } else if form == WEIGHED { 4 } else { 2 }
}

const EMPTY: u32 = 0
const OPAQUE: u32 = 1
const MIXED: u32 = 2

// Whether the rectangle shows nothing at all, is opaque everywhere, or
// neither.
fn cover(pixels: [*]const u32, width: usize, height: usize, stride: usize) -> u32 {
    var every: u32 = 0xFF000000
    var some: u32 = 0
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            every &= row[x]
            some |= row[x]
            x += 1
        }
        y += 1
    }
    if some >> 24 == 0 { return EMPTY }
    if every >> 24 == 255 { return OPAQUE }
    return MIXED
}

fn clear(pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            row[x] = 0
            x += 1
        }
        y += 1
    }
}

fn longs(pool: *scratch.Pool, count: usize) -> ?[*]i64 {
    const memory = scratch.bytes(pool, count * 8)
    if memory == null { return null }
    unsafe { return @ptrCast([*]i64, memory.?) }
}

fn sumOf(weights: []const i32) -> i64 {
    var total: i64 = 0
    var index: usize = 0
    while index < weights.length {
        total += @intCast(i64, weights[index])
        index += 1
    }
    return total
}

// The absolute weights added up: how far a sum can get from zero.
fn weightOf(weights: []const i32) -> i64 {
    var total: i64 = 0
    var index: usize = 0
    while index < weights.length {
        const weight = @intCast(i64, weights[index])
        total += if weight < 0 { -weight } else { weight }
        index += 1
    }
    return total
}

// A row of pixels as the values of `form`, `reach` pixels more at each
// end (the end pixels again): (width + 2 * reach) * valuesOf(form) values.
fn spread(source: [*]const u32, width: usize, reach: usize, form: u32, into: [*]i32) -> void {
    const values = valuesOf(form)
    const middle = into + reach * values
    var x: usize = 0
    if form == 0 {
        while x < width {
            const p = source[x]
            middle[x * 3] = @intCast(i32, (p >> 16) & 255)
            middle[x * 3 + 1] = @intCast(i32, (p >> 8) & 255)
            middle[x * 3 + 2] = @intCast(i32, p & 255)
            x += 1
        }
    } else if form == LUMA {
        while x < width {
            middle[x] = @intCast(i32, pixel.luma(source[x]))
            x += 1
        }
    } else if form == WEIGHED {
        while x < width {
            const p = source[x]
            const a = p >> 24
            middle[x * 4] = @intCast(i32, ((p >> 16) & 255) * a)
            middle[x * 4 + 1] = @intCast(i32, ((p >> 8) & 255) * a)
            middle[x * 4 + 2] = @intCast(i32, (p & 255) * a)
            middle[x * 4 + 3] = @intCast(i32, a)
            x += 1
        }
    } else {
        while x < width {
            const p = source[x]
            const a = p >> 24
            middle[x * 2] = @intCast(i32, pixel.luma(p) * a)
            middle[x * 2 + 1] = @intCast(i32, a)
            x += 1
        }
    }
    const last = (width - 1) * values
    var index: usize = 0
    while index < reach * values {
        into[index] = middle[index % values]
        middle[width * values + index] = middle[last + index % values]
        index += 1
    }
}

// into[i] = a[i] * wa + b[i] * wb + c[i] * wc, added to what is there with
// `more`. The loops every kernel spends its time in: three weights a turn
// (a weight alone costs half as much again), nothing checked (the callers
// keep the sums inside 32 bits: HEAVIEST).
fn sum32(into: [*]i32, a: [*]const i32, wa: i32, b: [*]const i32, wb: i32, c: [*]const i32, wc: i32, count: usize, more: bool) -> void {
    var index: usize = 0
    if more {
        while index < count {
            into[index] = into[index] +% a[index] *% wa +% b[index] *% wb +% c[index] *% wc
            index += 1
        }
    } else {
        while index < count {
            into[index] = a[index] *% wa +% b[index] *% wb +% c[index] *% wc
            index += 1
        }
    }
}

// The same into 64-bit sums (rows of 32-bit ones added across).
fn sum64(into: [*]i64, a: [*]const i32, wa: i64, b: [*]const i32, wb: i64, c: [*]const i32, wc: i64, count: usize, more: bool) -> void {
    var index: usize = 0
    if more {
        while index < count {
            into[index] = into[index] +% @intCast(i64, a[index]) *% wa +% @intCast(i64, b[index]) *% wb +% @intCast(i64, c[index]) *% wc
            index += 1
        }
    } else {
        while index < count {
            into[index] = @intCast(i64, a[index]) *% wa +% @intCast(i64, b[index]) *% wb +% @intCast(i64, c[index]) *% wc
            index += 1
        }
    }
}

// The sums of one row as they would be were every pixel opaque. Where
// every pixel is, they are that already, but for `center` times the
// pixel. Where pixels are weighed by alpha a sum is of colour times alpha
// and the last value of a pixel is the sum of the alphas: what the
// neighbours lack of the kernel's whole weight (`total`, `center` in it)
// is filled with the pixel's own colour (`center` falls out of that). Such
// a sum stays 255 times too large: whoever divides it divides once, by
// 255 times as much, so that no rounding comes before the last.
fn settle(sums: [*]i64, row: [*]const u32, width: usize, form: u32, center: i64, total: i64) -> void {
    var x: usize = 0
    if form == 0 {
        if center == 0 { return }
        while x < width {
            const p = row[x]
            sums[x * 3] += center * @intCast(i64, (p >> 16) & 255)
            sums[x * 3 + 1] += center * @intCast(i64, (p >> 8) & 255)
            sums[x * 3 + 2] += center * @intCast(i64, p & 255)
            x += 1
        }
    } else if form == LUMA {
        if center == 0 { return }
        while x < width {
            sums[x] += center * @intCast(i64, pixel.luma(row[x]))
            x += 1
        }
    } else if form == WEIGHED {
        while x < width {
            const p = row[x]
            const lack = total * 255 - sums[x * 4 + 3]
            sums[x * 4] += @intCast(i64, (p >> 16) & 255) * lack
            sums[x * 4 + 1] += @intCast(i64, (p >> 8) & 255) * lack
            sums[x * 4 + 2] += @intCast(i64, p & 255) * lack
            x += 1
        }
    } else {
        while x < width {
            sums[x * 2] += @intCast(i64, pixel.luma(row[x])) * (total * 255 - sums[x * 2 + 1])
            x += 1
        }
    }
}

// How far from zero a settled sum can be for a kernel whose absolute
// weights add up to `heavy`: a channel is at most 255; a weighed sum is
// 255 times that, and the colour filled in can make it three times as
// much again.
inline fn farthest(form: u32, heavy: i64) -> i64 {
    return if form & WEIGHED != 0 { heavy * 195075 } else { heavy * 255 }
}

inline fn level(value: i64) -> u32 {
    return @intCast(u32, if value < 0 { 0 } else if value > 255 { 255 } else { value })
}

// The pixel `p` with the colour r, g, b; with `toAlpha` its own colour
// and the mean of r, g, b as its alpha instead.
inline fn stored(p: u32, r: u32, g: u32, b: u32, toAlpha: bool) -> u32 {
    if !toAlpha { return (p & 0xFF000000) | (r << 16) | (g << 8) | b }
    const a = pixel.mul(p >> 24, (r + g + b + 1) / 3)
    return if a == 0 { 0 } else { (p & 0x00FFFFFF) | (a << 24) }
}

// A row's settled sums into its pixels: divided (halves round upward),
// `offset` added, held to 0..255.
fn finish(sums: [*]const i64, row: [*]u32, width: usize, form: u32, channels: u32, divisor: i64, offset: i64, heavy: i64, toAlpha: bool) -> void {
    const step = valuesOf(form)
    const by = if form & WEIGHED != 0 { divisor * 255 } else { divisor }
    // A quotient that may be negative is rounded lifted above zero by a
    // whole number of divisors.
    const floors = farthest(form, heavy) / by + 1
    const lift = floors * by + by / 2
    const unit = by == 1
    const gray = channels & GRAY != 0
    var x: usize = 0
    while x < width {
        const p = row[x]
        if p >> 24 == 0 {
            row[x] = 0
        } else {
            var r = (p >> 16) & 255
            var g = (p >> 8) & 255
            var b = p & 255
            if gray {
                const sum = sums[x * step]
                const v = level((if unit { sum } else { (sum + lift) / by - floors }) + offset)
                if channels & CHANNEL_RED != 0 { r = v }
                if channels & CHANNEL_GREEN != 0 { g = v }
                if channels & CHANNEL_BLUE != 0 { b = v }
            } else {
                if channels & CHANNEL_RED != 0 {
                    const sum = sums[x * step]
                    r = level((if unit { sum } else { (sum + lift) / by - floors }) + offset)
                }
                if channels & CHANNEL_GREEN != 0 {
                    const sum = sums[x * step + 1]
                    g = level((if unit { sum } else { (sum + lift) / by - floors }) + offset)
                }
                if channels & CHANNEL_BLUE != 0 {
                    const sum = sums[x * step + 2]
                    b = level((if unit { sum } else { (sum + lift) / by - floors }) + offset)
                }
            }
            row[x] = stored(p, r, g, b, toAlpha)
        }
        x += 1
    }
}

// Convolves `width` x `height` pixels at `pixels` (`stride` words a row)
// with nine weights, in place. False: the divisor is not above zero, or
// there is no memory for three rows (the pixels stay).
pub fn convolve3(pixels: [*]u32, width: usize, height: usize, stride: usize, kernel: *const Kernel3) -> bool {
    if kernel.*.divisor <= 0 { return false }
    if width == 0 || height == 0 || kernel.*.channels & COLOR == 0 { return true }
    const state = cover(pixels, width, height, stride)
    if state == EMPTY {
        clear(pixels, width, height, stride)
        return true
    }
    var form: u32 = if kernel.*.channels & GRAY != 0 { LUMA } else { 0 }
    if state == MIXED { form |= WEIGHED }
    const values = valuesOf(form)
    const count = width * values
    const wide = (width + 2) * values
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const rows = scratch.ints(pool, wide * 3)
    const sums = longs(pool, count)
    if rows == null || sums == null {
        scratch.release(pool, mark)
        return false
    }
    var total: i64 = 0
    var heavy: i64 = 0
    var index: usize = 0
    while index < 9 {
        const weight = @intCast(i64, kernel.*.weights[index])
        total += weight
        heavy += if weight < 0 { -weight } else { weight }
        index += 1
    }
    // The three rows a row's sums are made of wait spread out, each in the
    // place of its number modulo 3: the row above was overwritten already.
    spread(pixels, width, 1, form, rows.?)
    var y: usize = 0
    while y < height {
        if y + 1 < height { spread(pixels + (y + 1) * stride, width, 1, form, rows.? + ((y + 1) % 3) * wide) }
        var more = false
        var line: usize = 0
        while line < 3 {
            const wa = kernel.*.weights[line * 3]
            const wb = kernel.*.weights[line * 3 + 1]
            const wc = kernel.*.weights[line * 3 + 2]
            if wa != 0 || wb != 0 || wc != 0 || (line == 2 && !more) {
                // The first line of weights meets the row below, the
                // first weight of a line the pixel to the right.
                var from = y
                if line == 0 && y + 1 < height { from = y + 1 }
                if line == 2 && y > 0 { from = y - 1 }
                const base = rows.? + (from % 3) * wide
                sum64(sums.?, base + 2 * values, @intCast(i64, wa), base + values, @intCast(i64, wb), base, @intCast(i64, wc), count, more)
                more = true
            }
            line += 1
        }
        const row = pixels + y * stride
        settle(sums.?, row, width, form, 0, total)
        finish(sums.?, row, width, form, kernel.*.channels, @intCast(i64, kernel.*.divisor), @intCast(i64, kernel.*.offset), heavy, false)
        y += 1
    }
    scratch.release(pool, mark)
    return true
}

// How a row of weights is added up: weight by weight, or by running sums
// where the weights are all the same (a box) or fall evenly through zero
// in the middle (a ramp, the slope kernel of Prewitt): a sum is then made
// from the one before it, whatever the kernel's length.
const TAPS: u32 = 0
const FLAT: u32 = 1
const RAMP: u32 = 2

// Which of these a kernel is (a short one is quicker weight by weight).
// A box's weight is any of its weights; what a ramp falls by from weight
// to weight is the weight before its middle one.
fn shapeOf(weights: []const i32) -> u32 {
    if weights.length < 5 { return TAPS }
    const reach = weights.length / 2
    const step = weights[reach - 1]
    var flat = weights[0] != 0
    var ramp = step != 0
    var index: usize = 0
    while index < weights.length {
        if weights[index] != weights[0] { flat = false }
        if @intCast(i64, weights[index]) != @intCast(i64, step) * (@intCast(i64, reach) - @intCast(i64, index)) { ramp = false }
        index += 1
    }
    return if flat { FLAT } else if ramp { RAMP } else { TAPS }
}

// One separable kernel going down a picture: the rows it needs wait
// filtered along in `ring`, and advance() adds them up across.
const Stream = struct {
    width: usize
    height: usize
    form: u32
    // Values of one row: width * valuesOf(form).
    count: usize
    along: []const i32
    across: []const i32
    alongShape: u32
    acrossShape: u32
    // One row spread out, as far as `along` reaches.
    wide: [*]i32
    // The last across.length rows filtered along, each in the place of
    // its number modulo across.length.
    ring: [*]i32
    // Rows filtered so far.
    filled: usize
    // A box or a ramp across: the plain sum of the window's rows, and
    // after it (a ramp) their sum weighed by their distance below the
    // middle.
    run: [*]i64
    // The sums of the row made last.
    sums: [*]i64
}

// Takes the stream's rows from the pool. The kernels are each an odd
// number of weights no heavier than HEAVIEST (separable() sees to it).
// False without memory.
fn open(stream: *Stream, pool: *scratch.Pool, width: usize, height: usize, form: u32, along: []const i32, across: []const i32) -> bool {
    const values = valuesOf(form)
    const wide = scratch.ints(pool, (width + along.length - 1) * values)
    const ring = scratch.ints(pool, across.length * width * values)
    const run = longs(pool, width * values * 2)
    const sums = longs(pool, width * values)
    if wide == null || ring == null || run == null || sums == null { return false }
    stream.*.width = width
    stream.*.height = height
    stream.*.form = form
    stream.*.count = width * values
    stream.*.along = along
    stream.*.across = across
    stream.*.alongShape = shapeOf(along)
    stream.*.acrossShape = shapeOf(across)
    stream.*.wide = wide.?
    stream.*.ring = ring.?
    stream.*.run = run.?
    stream.*.sums = sums.?
    stream.*.filled = 0
    return true
}

// Row `number` of the picture, filtered along, as the ring holds it (a
// row beyond the picture's ends is its end row).
inline fn ringRow(stream: *const Stream, number: usize) -> [*]i32 {
    const last = stream.*.height - 1
    return stream.*.ring + ((if number > last { last } else { number }) % stream.*.across.length) * stream.*.count
}

// The filtered row that weight `tap` of `across` meets for row `y`.
inline fn below(stream: *const Stream, y: usize, tap: usize) -> [*]const i32 {
    const reach = stream.*.across.length / 2
    return ringRow(stream, if y + reach < tap { 0 } else { y + reach - tap })
}

// A box along a row: each sum the one a pixel before it, plus the value
// that comes into the window, minus the one that leaves.
fn boxAlong(into: [*]i32, wide: [*]const i32, width: usize, values: usize, taps: usize, weight: i32) -> void {
    var value: usize = 0
    while value < values {
        var sum: i32 = 0
        var tap: usize = 0
        while tap < taps {
            sum = sum +% wide[tap * values + value]
            tap += 1
        }
        into[value] = sum *% weight
        var at = values + value
        while at < width * values {
            sum = sum +% wide[at + (taps - 1) * values] -% wide[at - values]
            into[at] = sum *% weight
            at += values
        }
        value += 1
    }
}

// A ramp along a row: the values of the window weighed by their distance
// ahead of the middle. Moving on a pixel, every value is one nearer: the
// weighed sum loses the window's plain sum once, the value that leaves
// had `reach` taken off too much, the one that comes in starts at reach.
fn rampAlong(into: [*]i32, wide: [*]const i32, width: usize, values: usize, taps: usize, step: i32) -> void {
    const reach = @intCast(i32, taps / 2)
    var value: usize = 0
    while value < values {
        var plain_sum: i32 = 0
        var weighed: i32 = 0
        var tap: usize = 0
        while tap < taps {
            const here = wide[tap * values + value]
            plain_sum = plain_sum +% here
            weighed = weighed +% here *% (@intCast(i32, tap) - reach)
            tap += 1
        }
        into[value] = weighed *% step
        var at = values + value
        while at < width * values {
            const comes = wide[at + (taps - 1) * values]
            const leaves = wide[at - values]
            plain_sum = plain_sum +% comes -% leaves
            weighed = weighed +% leaves *% reach +% comes *% (reach + 1) -% plain_sum
            into[at] = weighed *% step
            at += values
        }
        value += 1
    }
}

// The next row of the picture into the ring: spread out and filtered
// along.
fn fill(stream: *Stream, pixels: [*]const u32, stride: usize) -> void {
    const along = stream.*.along
    const values = valuesOf(stream.*.form)
    const count = stream.*.count
    const into = ringRow(stream, stream.*.filled)
    spread(pixels + stream.*.filled * stride, stream.*.width, along.length / 2, stream.*.form, stream.*.wide)
    stream.*.filled += 1
    if stream.*.alongShape == FLAT {
        boxAlong(into, stream.*.wide, stream.*.width, values, along.length, along[0])
        return
    }
    if stream.*.alongShape == RAMP {
        rampAlong(into, stream.*.wide, stream.*.width, values, along.length, along[along.length / 2 - 1])
        return
    }
    var more = false
    var tap: usize = 0
    while tap < along.length {
        // Weight `tap` meets the pixel along.length - 1 - tap further
        // into the spread row. A group cut short by the kernel's end
        // is filled up with weights of zero.
        const second = if tap + 1 < along.length { tap + 1 } else { tap }
        const third = if tap + 2 < along.length { tap + 2 } else { tap }
        const wa = along[tap]
        const wb = if tap + 1 < along.length { along[tap + 1] } else { 0 }
        const wc = if tap + 2 < along.length { along[tap + 2] } else { 0 }
        if wa != 0 || wb != 0 || wc != 0 || (tap + 3 >= along.length && !more) {
            const far = along.length - 1
            sum32(into, stream.*.wide + (far - tap) * values, wa, stream.*.wide + (far - second) * values, wb, stream.*.wide + (far - third) * values, wc, count, more)
            more = true
        }
        tap += 3
    }
}

// into[i] += row[i] * weight.
fn add64(into: [*]i64, row: [*]const i32, weight: i64, count: usize) -> void {
    var index: usize = 0
    while index < count {
        into[index] = into[index] +% @intCast(i64, row[index]) *% weight
        index += 1
    }
}

// A box or a ramp across the rows for row `y`: the window's plain sum
// (and for a ramp its sum weighed by the rows' distance below the middle)
// from those of the row above. The row that leaves the window is taken
// off before the row that comes into it is filled into the ring: at full
// stride the two have the same place there.
fn slideDown(stream: *Stream, pixels: [*]const u32, stride: usize, y: usize) -> void {
    const count = stream.*.count
    const reach = stream.*.across.length / 2
    const last = stream.*.height - 1
    const ramp = stream.*.acrossShape == RAMP
    const plain_sum = stream.*.run
    const weighed = stream.*.run + count
    var index: usize = 0
    if y == 0 {
        while stream.*.filled <= reach && stream.*.filled <= last { fill(stream, pixels, stride) }
        while index < count * 2 {
            plain_sum[index] = 0
            index += 1
        }
        // The rows above the picture are its first row.
        add64(plain_sum, ringRow(stream, 0), @intCast(i64, reach + 1), count)
        if ramp { add64(weighed, ringRow(stream, 0), -@intCast(i64, reach * (reach + 1) / 2), count) }
        var distance: usize = 1
        while distance <= reach {
            add64(plain_sum, ringRow(stream, distance), 1, count)
            if ramp { add64(weighed, ringRow(stream, distance), @intCast(i64, distance), count) }
            distance += 1
        }
    } else {
        const leaves = ringRow(stream, if y < reach + 1 { 0 } else { y - reach - 1 })
        add64(plain_sum, leaves, -1, count)
        if ramp { add64(weighed, leaves, @intCast(i64, reach), count) }
        if stream.*.filled <= y + reach && stream.*.filled <= last { fill(stream, pixels, stride) }
        const comes = ringRow(stream, y + reach)
        add64(plain_sum, comes, 1, count)
        if ramp {
            add64(weighed, comes, @intCast(i64, reach + 1), count)
            index = 0
            while index < count {
                weighed[index] = weighed[index] -% plain_sum[index]
                index += 1
            }
        }
    }
    // A box weighs every row alike; a ramp's first weight meets the row
    // furthest below, and the weight before the middle one, which meets
    // the row just below, is what a row of distance weighs.
    const from = if ramp { weighed } else { plain_sum }
    const factor = @intCast(i64, if ramp { stream.*.across[reach - 1] } else { stream.*.across[0] })
    index = 0
    while index < count {
        stream.*.sums[index] = from[index] *% factor
        index += 1
    }
}

// stream.sums becomes the kernel's sums for row `y`; the rows are asked
// for from the top down, each before its pixels are written.
fn advance(stream: *Stream, pixels: [*]const u32, stride: usize, y: usize) -> void {
    if stream.*.acrossShape != TAPS {
        slideDown(stream, pixels, stride, y)
        return
    }
    const count = stream.*.count
    const across = stream.*.across
    const reach = across.length / 2
    while stream.*.filled <= y + reach && stream.*.filled < stream.*.height { fill(stream, pixels, stride) }
    var more = false
    var tap: usize = 0
    while tap < across.length {
        // Weight `tap` meets the row reach - tap below this one: the
        // first weight the row furthest below.
        const second = if tap + 1 < across.length { tap + 1 } else { tap }
        const third = if tap + 2 < across.length { tap + 2 } else { tap }
        const wa = across[tap]
        const wb = if tap + 1 < across.length { across[tap + 1] } else { 0 }
        const wc = if tap + 2 < across.length { across[tap + 2] } else { 0 }
        if wa != 0 || wb != 0 || wc != 0 || (tap + 3 >= across.length && !more) {
            sum64(stream.*.sums, below(stream, y, tap), @intCast(i64, wa), below(stream, y, second), @intCast(i64, wb), below(stream, y, third), @intCast(i64, wc), count, more)
            more = true
        }
        tap += 3
    }
}

// convolveSeparable(), and with `toAlpha` the answer as the pixels' alpha
// (Edge Detection's "Apply to Alpha").
fn separable(pixels: [*]u32, width: usize, height: usize, stride: usize, kernel: *const Separable, toAlpha: bool) -> bool {
    if kernel.*.divisor <= 0 { return false }
    if kernel.*.along.length & 1 == 0 || kernel.*.across.length & 1 == 0 { return false }
    if weightOf(kernel.*.along) > HEAVIEST || weightOf(kernel.*.across) > HEAVIEST { return false }
    if width == 0 || height == 0 || kernel.*.channels & COLOR == 0 { return true }
    const state = cover(pixels, width, height, stride)
    if state == EMPTY {
        clear(pixels, width, height, stride)
        return true
    }
    var form: u32 = if kernel.*.channels & GRAY != 0 { LUMA } else { 0 }
    if state == MIXED { form |= WEIGHED }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    var stream: Stream = undefined
    if !open(&stream, pool, width, height, form, kernel.*.along, kernel.*.across) {
        scratch.release(pool, mark)
        return false
    }
    const center = @intCast(i64, kernel.*.center)
    const total = sumOf(kernel.*.along) * sumOf(kernel.*.across) + center
    const heavy = weightOf(kernel.*.along) * weightOf(kernel.*.across) + (if center < 0 { -center } else { center })
    var y: usize = 0
    while y < height {
        const line = pixels + y * stride
        advance(&stream, pixels, stride, y)
        settle(stream.sums, line, width, form, center, total)
        finish(stream.sums, line, width, form, kernel.*.channels, @intCast(i64, kernel.*.divisor), @intCast(i64, kernel.*.offset), heavy, toAlpha)
        y += 1
    }
    scratch.release(pool, mark)
    return true
}

// Convolves `width` x `height` pixels at `pixels` (`stride` words a row)
// with a separable kernel, in place. False: a kernel is not an odd number
// of weights or weighs more than HEAVIEST, the divisor is not above zero,
// or there is no memory for the rows (the pixels stay).
pub fn convolveSeparable(pixels: [*]u32, width: usize, height: usize, stride: usize, kernel: *const Separable) -> bool {
    return separable(pixels, width, height, stride, kernel, false)
}

// A number of a filter's params held to its range; the initial value for
// what is not a number. (Each filter reads its own table by place below:
// a slice of a constant table is a copy of the whole table, made in the
// value arena at every call.)
fn held(value: f64, low: f64, high: f64, initial: f64) -> f64 {
    if value != value { return initial }
    if value < low { return low }
    if value > high { return high }
    return value
}

// A number that is a choice or a count.
fn whole(value: f64) -> i32 {
    return @intFromFloat(i32, math.round(value))
}

// How many pixels a kernel for `radius` reaches each way: the size Krita
// gives a gaussian of that radius (sigma 0.3 * radius + 0.3), rounded
// up. (In tenths: a whole sigma is a whole number then, not a hair more.)
fn reachOf(radius: f64) -> usize {
    return @intFromFloat(usize, math.ceil((3.0 * radius + 3.0) / 10.0))
}

// The two kernels of one slope: `slope` (2 * reach + 1 weights) along the
// way the slope is taken, `smooth` across it.
const Detector = struct {
    slope: []const i32
    smooth: []const i32
    divisor: i32
}

// What a detector answers to a hard step, in step heights: the classic
// 3x3 kernel's answer, kept at every reach.
fn gainOf(kind: i32) -> i32 {
    return if kind == PREWITT { 3 } else if kind == SOBEL { 4 } else { 1 }
}

// Builds the kernels of `kind` reaching `reach` pixels in the pool's
// memory; `sign` -1 turns the slope round. False without memory.
//
// The slope's weights fall from the pixels ahead to those behind (a
// convolution: the first weight meets the pixel furthest ahead), so the
// answer is positive where the picture grows lighter rightward or
// downward. Prewitt: the distance, smoothed by a box. Sobel: the distance
// times a bell that has fallen to half at the kernel's end, smoothed by
// that bell (1 2 1 at reach 1). Simple: 2520 / distance (whole up to a
// distance of 10), not smoothed.
fn detector(pool: *scratch.Pool, kind: i32, reach: usize, sign: i32, into: *Detector) -> bool {
    const taps = reach * 2 + 1
    const smooths = if kind == SIMPLE { 1 } else { taps }
    const slope = scratch.ints(pool, taps)
    const smooth = scratch.ints(pool, smooths)
    if slope == null || smooth == null { return false }
    const gain = gainOf(kind)
    var ahead: i32 = 0
    slope.?[reach] = 0
    var distance: usize = 1
    while distance <= reach {
        var weight = @intCast(i32, distance)
        if kind == SOBEL {
            const part = @floatFromInt(f64, distance) / @floatFromInt(f64, reach)
            weight = @intFromFloat(i32, 2.0 * @floatFromInt(f64, distance) * math.exp(-math.ln2 * part * part) + 0.5)
        } else if kind == SIMPLE {
            weight = @intCast(i32, (2520 + distance / 2) / distance)
        }
        slope.?[reach - distance] = sign * weight
        slope.?[reach + distance] = -sign * weight
        ahead += weight
        distance += 1
    }
    var breadth: i32 = 0
    var index: usize = 0
    while index < smooths {
        var weight: i32 = 1
        if kind == SOBEL {
            const part = (@floatFromInt(f64, index) - @floatFromInt(f64, reach)) / @floatFromInt(f64, reach)
            weight = @intFromFloat(i32, 16.0 * math.exp(-math.ln2 * part * part) + 0.5)
        }
        smooth.?[index] = weight * gain
        breadth += weight
        index += 1
    }
    into.*.slope = slope.?[0..taps]
    into.*.smooth = smooth.?[0..smooths]
    into.*.divisor = ahead * breadth
    return true
}

// What becomes of a pixel's two slopes.
const MAGNITUDE: u32 = 0
const HEADING: u32 = 1
const NORMAL: u32 = 2

const Look = struct {
    output: u32
    toAlpha: bool
    // NORMAL: what red, green and blue show (X+ X- Y+ Y- Z+ Z-: 0 to 5).
    red: u32
    green: u32
    blue: u32
}

// The angle of (x, y), -pi to pi, to a hundred-thousandth: the arctangent
// of the smaller part over the larger as a polynomial (Abramowitz and
// Stegun 4.4.49), turned into its octant. 0 for no direction at all.
inline fn angle(y: f64, x: f64) -> f64 {
    const ax = if x < 0.0 { -x } else { x }
    const ay = if y < 0.0 { -y } else { y }
    const large = if ax > ay { ax } else { ay }
    if large == 0.0 { return 0.0 }
    const ratio = (if ax > ay { ay } else { ax }) / large
    const square = ratio * ratio
    var turn = ratio * (0.9998660 + square * (-0.3302995 + square * (0.1801410 + square * (-0.0851330 + square * 0.0208351))))
    if ay > ax { turn = math.pi / 2.0 - turn }
    if x < 0.0 { turn = math.pi - turn }
    return if y < 0.0 { -turn } else { turn }
}

// A settled sum in the channels' own measure: a weighed one divided by
// its 255 (rounded, lifted above zero for it as in finish()). The slopes
// are worked out from these whole numbers, so that a pixel among opaque
// neighbours gets the same answer whether or not the rest of the picture
// is opaque.
inline fn plain(sum: i64, weighed: bool, lift: i64, floors: i64) -> f64 {
    return @floatFromInt(f64, if weighed { (sum + lift) / 255 - floors } else { sum })
}

// The length of a slope as a level. (A slope is at most a few times 255:
// the conversion cannot leave its range.)
inline fn lengthOf(gx: f64, gy: f64) -> u32 {
    const value = @intFromFloat(i32, @sqrt(gx * gx + gy * gy) + 0.5)
    return @intCast(u32, if value > 255 { 255 } else { value })
}

// The angle of a slope as a level: -pi is 0 (and a half), 0 is 128, pi 255.
inline fn headingOf(gx: f64, gy: f64) -> u32 {
    return @intCast(u32, @intFromFloat(i32, 128.0 + angle(gy, gx) * (127.5 / math.pi)))
}

// One part of a normal as a level: `choice` picks the axis and its sign,
// `shrink` is 127.5 over the normal's length.
inline fn partOf(choice: u32, nx: f64, ny: f64, shrink: f64) -> u32 {
    const part = (if choice < 2 { nx } else if choice < 4 { ny } else { 1.0 }) * shrink
    return @intCast(u32, @intFromFloat(i32, 128.0 + (if choice & 1 != 0 { -part } else { part })))
}

// A row's two settled slopes into its pixels. The scales take a sum to a
// slope in levels (NORMAL: in heights); `heavy` is the absolute weight of
// the heavier of the two kernels.
fn finishPair(sx: [*]const i64, sy: [*]const i64, row: [*]u32, width: usize, form: u32, look: *const Look, scaleX: f64, scaleY: f64, heavy: i64) -> void {
    const step = valuesOf(form)
    const weighed = form & WEIGHED != 0
    const floors = farthest(form, heavy) / 255 + 1
    const lift = floors * 255 + 127
    const output = look.*.output
    const toAlpha = look.*.toAlpha
    const red = look.*.red
    const green = look.*.green
    const blue = look.*.blue
    var x: usize = 0
    while x < width {
        const p = row[x]
        if p >> 24 == 0 {
            row[x] = 0
        } else if output == NORMAL {
            // The surface leans against its slope; a normal map's Y
            // points up, the picture's rows count downward.
            const nx = -plain(sx[x * step], weighed, lift, floors) * scaleX
            const ny = plain(sy[x * step], weighed, lift, floors) * scaleY
            const shrink = 127.5 / @sqrt(nx * nx + ny * ny + 1.0)
            row[x] = (p & 0xFF000000) | (partOf(red, nx, ny, shrink) << 16) | (partOf(green, nx, ny, shrink) << 8) | partOf(blue, nx, ny, shrink)
        } else {
            const rx = plain(sx[x * step], weighed, lift, floors) * scaleX
            const ry = plain(sy[x * step], weighed, lift, floors) * scaleY
            const gx = plain(sx[x * step + 1], weighed, lift, floors) * scaleX
            const gy = plain(sy[x * step + 1], weighed, lift, floors) * scaleY
            const bx = plain(sx[x * step + 2], weighed, lift, floors) * scaleX
            const by = plain(sy[x * step + 2], weighed, lift, floors) * scaleY
            if output == MAGNITUDE {
                row[x] = stored(p, lengthOf(rx, ry), lengthOf(gx, gy), lengthOf(bx, by), toAlpha)
            } else {
                row[x] = stored(p, headingOf(rx, ry), headingOf(gx, gy), headingOf(bx, by), toAlpha)
            }
        }
        x += 1
    }
}

// Both slopes of every pixel (kernels of `kind`, reaching `reachX` for
// the left-right slope and `reachY` for the up-down one) and what `look`
// makes of them, in place. False without memory (the pixels stay).
fn slopes(pixels: [*]u32, width: usize, height: usize, stride: usize, kind: i32, reachX: usize, reachY: usize, look: *const Look) -> bool {
    const state = cover(pixels, width, height, stride)
    if state == EMPTY {
        clear(pixels, width, height, stride)
        return true
    }
    var form: u32 = if look.*.output == NORMAL { LUMA } else { 0 }
    if state == MIXED { form |= WEIGHED }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    var across: Detector = undefined
    var down: Detector = undefined
    var streamX: Stream = undefined
    var streamY: Stream = undefined
    if !detector(pool, kind, reachX, 1, &across) || !detector(pool, kind, reachY, 1, &down) || !open(&streamX, pool, width, height, form, across.slope, across.smooth) || !open(&streamY, pool, width, height, form, down.smooth, down.slope) {
        scratch.release(pool, mark)
        return false
    }
    // A slope kernel's weights add up to nothing.
    const heavyX = weightOf(across.slope) * weightOf(across.smooth)
    const heavyY = weightOf(down.slope) * weightOf(down.smooth)
    var scaleX = 1.0 / @floatFromInt(f64, across.divisor)
    var scaleY = 1.0 / @floatFromInt(f64, down.divisor)
    if look.*.output == NORMAL {
        scaleX = scaleX / 255.0
        scaleY = scaleY / 255.0
    }
    var y: usize = 0
    while y < height {
        const line = pixels + y * stride
        advance(&streamX, pixels, stride, y)
        advance(&streamY, pixels, stride, y)
        settle(streamX.sums, line, width, form, 0, 0)
        settle(streamY.sums, line, width, form, 0, 0)
        finishPair(streamX.sums, streamY.sums, line, width, form, look, scaleX, scaleY, if heavyX > heavyY { heavyX } else { heavyY })
        y += 1
    }
    scratch.release(pool, mark)
    return true
}

const NO_PARAMS = [0]types.Param{}

// The 3x3 filters: Krita's kernels as Krita shows them.
const Fixed = struct {
    id: u16
    kernel: Kernel3
}

const FIXED = [10]Fixed{
    Fixed.{ .id = TOP_EDGE, .kernel = Kernel3.{ .weights = [9]i32{ 1, 1, 1, 0, 0, 0, -1, -1, -1 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = RIGHT_EDGE, .kernel = Kernel3.{ .weights = [9]i32{ -1, 0, 1, -1, 0, 1, -1, 0, 1 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = BOTTOM_EDGE, .kernel = Kernel3.{ .weights = [9]i32{ -1, -1, -1, 0, 0, 0, 1, 1, 1 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = LEFT_EDGE, .kernel = Kernel3.{ .weights = [9]i32{ 1, 0, -1, 1, 0, -1, 1, 0, -1 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = LAPLACIAN, .kernel = Kernel3.{ .weights = [9]i32{ -1, -1, -1, -1, 8, -1, -1, -1, -1 }, .divisor = 1, .offset = 0, .channels = COLOR } },
    Fixed.{ .id = EMBOSS_HORIZONTAL, .kernel = Kernel3.{ .weights = [9]i32{ 0, 0, 0, 1, 0, -1, 0, 0, 0 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = EMBOSS_VERTICAL, .kernel = Kernel3.{ .weights = [9]i32{ 0, 1, 0, 0, 0, 0, 0, -1, 0 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = EMBOSS_ALL, .kernel = Kernel3.{ .weights = [9]i32{ -1, -1, -1, -1, 8, -1, -1, -1, -1 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = EMBOSS_HORIZONTAL_VERTICAL, .kernel = Kernel3.{ .weights = [9]i32{ 0, -1, 0, -1, 4, -1, 0, -1, 0 }, .divisor = 1, .offset = 127, .channels = COLOR } },
    Fixed.{ .id = EMBOSS_LAPLACIAN, .kernel = Kernel3.{ .weights = [9]i32{ -1, 0, -1, 0, 4, 0, -1, 0, -1 }, .divisor = 1, .offset = 127, .channels = COLOR } },
}

fn fixed(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    var index: usize = 0
    while index < 10 {
        if FIXED[index].id == params.*.id {
            const kernel = FIXED[index].kernel
            _ = convolve3(pixels, width, height, stride, &kernel)
            return
        }
        index += 1
    }
}

fn one(params: *const Params) -> i32 { return 1 }

const EMBOSS_PARAMS = [1]types.Param{
    types.Param.{ .name = "Depth", .german = "Tiefe", .kind = types.INT, .low = 10.0, .high = 300.0, .initial = 30.0, .choices = "", .choicesGerman = "" },
}

// The pixel minus its neighbour up and to the left (the weight written
// last meets that neighbour), in tenths: emboss() writes the depth over
// the two ones.
const RELIEF = Kernel3.{ .weights = [9]i32{ 0, 0, 0, 0, 1, 0, 0, 0, -1 }, .divisor = 10, .offset = 127, .channels = COLOR | GRAY }

fn emboss(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const depth = whole(held(params.*.values[0], EMBOSS_PARAMS[0].low, EMBOSS_PARAMS[0].high, EMBOSS_PARAMS[0].initial))
    var kernel = RELIEF
    kernel.weights[4] = depth
    kernel.weights[8] = -depth
    _ = convolve3(pixels, width, height, stride, &kernel)
}

const EDGE_PARAMS = [5]types.Param{
    types.Param.{ .name = "Formula", .german = "Formel", .kind = types.CHOICE, .low = 0.0, .high = 2.0, .initial = 0.0, .choices = "Prewitt|Sobel|Simple", .choicesGerman = "Prewitt|Sobel|Einfach" },
    types.Param.{ .name = "Output", .german = "Ausgabe", .kind = types.CHOICE, .low = 0.0, .high = 5.0, .initial = 0.0, .choices = "All Sides|Top Edge|Bottom Edge|Right Edge|Left Edge|Direction in Radians", .choicesGerman = "Alle Seiten|Obere Kante|Untere Kante|Rechte Kante|Linke Kante|Richtung im Bogenmaß" },
    types.Param.{ .name = "Horizontal Radius", .german = "Horizontaler Radius", .kind = types.FLOAT, .low = 1.0, .high = 100.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Vertical Radius", .german = "Vertikaler Radius", .kind = types.FLOAT, .low = 1.0, .high = 100.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Apply to Alpha", .german = "Auf Alpha anwenden", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

fn edgeNumber(params: *const Params, place: usize) -> f64 {
    return held(params.*.values[place], EDGE_PARAMS[place].low, EDGE_PARAMS[place].high, EDGE_PARAMS[place].initial)
}

fn edgesMargin(params: *const Params) -> i32 {
    const output = whole(edgeNumber(params, 1))
    const reachX = @intCast(i32, reachOf(edgeNumber(params, 2)))
    const reachY = @intCast(i32, reachOf(edgeNumber(params, 3)))
    if output == TOP || output == BOTTOM { return reachY }
    if output == LEFT || output == RIGHT { return reachX }
    return if reachX > reachY { reachX } else { reachY }
}

fn edges(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const kind = whole(edgeNumber(params, 0))
    const output = whole(edgeNumber(params, 1))
    const reachX = reachOf(edgeNumber(params, 2))
    const reachY = reachOf(edgeNumber(params, 3))
    // (Set in a branch: the compiler hands a comparison of floats that is
    // kept as a bool on to a function as true, whatever it was.)
    var toAlpha = false
    if edgeNumber(params, 4) >= 0.5 { toAlpha = true }
    if output == ALL_SIDES || output == DIRECTION {
        const look = Look.{ .output = if output == ALL_SIDES { MAGNITUDE } else { HEADING }, .toAlpha = toAlpha, .red = 0, .green = 0, .blue = 0 }
        _ = slopes(pixels, width, height, stride, kind, reachX, reachY, &look)
        return
    }
    // One side: one slope around mid grey, lighter where the picture
    // grows lighter away from that side.
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const upright = output == TOP || output == BOTTOM
    const sign: i32 = if output == TOP || output == LEFT { 1 } else { -1 }
    var made: Detector = undefined
    if detector(pool, kind, if upright { reachY } else { reachX }, sign, &made) {
        const kernel = Separable.{ .along = if upright { made.smooth } else { made.slope }, .across = if upright { made.slope } else { made.smooth }, .center = 0, .divisor = made.divisor, .offset = 127, .channels = COLOR }
        _ = separable(pixels, width, height, stride, &kernel, toAlpha)
    }
    scratch.release(pool, mark)
}

const HIGH_PASS_PARAMS = [1]types.Param{
    types.Param.{ .name = "Radius", .german = "Radius", .kind = types.FLOAT, .low = 0.1, .high = 100.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
}

// The gaussian of a radius: its sigma, and how far its kernel reaches
// (three sigmas, in tenths as in reachOf()).
fn sigmaOf(radius: f64) -> f64 { return 0.3 * radius + 0.3 }

fn bellReach(radius: f64) -> usize {
    return @intFromFloat(usize, math.ceil((9.0 * radius + 9.0) / 10.0))
}

// A bell reaching further than this is blurred by three boxes instead:
// from here on the boxes are the faster way, and near enough the bell.
const WIDEST_BELL: usize = 6

// Three boxes after one another that reach `reach` pixels together: each
// reaches a third of it, the first ones one pixel more where it does not
// divide.
inline fn boxReach(reach: usize, box: usize) -> usize {
    return reach / 3 + (if box < reach % 3 { 1 } else { 0 })
}

// Three times the variance of such three boxes (a box reaching m pixels
// has m * (m + 1) / 3).
fn boxesSpread(reach: usize) -> f64 {
    var spread_out: usize = 0
    var box: usize = 0
    while box < 3 {
        const m = boxReach(reach, box)
        spread_out += m * (m + 1)
        box += 1
    }
    return @floatFromInt(f64, spread_out)
}

// How far three boxes reach together whose blur is nearest a gaussian's
// of `sigma` (the same variance, as near as whole boxes get).
fn boxesReach(sigma: f64) -> usize {
    const wanted = 3.0 * sigma * sigma
    var reach: usize = 3
    while boxesSpread(reach) < wanted { reach += 1 }
    if reach > 3 && wanted - boxesSpread(reach - 1) < boxesSpread(reach) - wanted { reach -= 1 }
    return reach
}

fn highPassRadius(params: *const Params) -> f64 {
    return held(params.*.values[0], HIGH_PASS_PARAMS[0].low, HIGH_PASS_PARAMS[0].high, HIGH_PASS_PARAMS[0].initial)
}

fn highPassMargin(params: *const Params) -> i32 {
    const radius = highPassRadius(params)
    const reach = bellReach(radius)
    return @intCast(i32, if reach <= WIDEST_BELL { reach } else { boxesReach(sigmaOf(radius)) })
}

// into[i] = from[i] + from[i + step] + ... (`window` of them), for `count`
// sums: each the one `step` before it, plus what comes in, minus what
// goes out.
fn box32(into: [*]i64, from: [*]const i32, count: usize, step: usize, window: usize) -> void {
    var index: usize = 0
    while index < step && index < count {
        var sum: i64 = 0
        var tap: usize = 0
        while tap < window {
            sum += @intCast(i64, from[index + tap * step])
            tap += 1
        }
        into[index] = sum
        index += 1
    }
    const far = (window - 1) * step
    while index < count {
        into[index] = into[index - step] +% @intCast(i64, from[index + far]) -% @intCast(i64, from[index - step])
        index += 1
    }
}

fn box64(into: [*]i64, from: [*]const i64, count: usize, step: usize, window: usize) -> void {
    var index: usize = 0
    while index < step && index < count {
        var sum: i64 = 0
        var tap: usize = 0
        while tap < window {
            sum += from[index + tap * step]
            tap += 1
        }
        into[index] = sum
        index += 1
    }
    const far = (window - 1) * step
    while index < count {
        into[index] = into[index - step] +% from[index + far] -% from[index - step]
        index += 1
    }
}

// One more row into a box across the rows: `run` gains it and loses the
// row `kept` holds from a window of rows before, whose place it takes.
fn slide(run: [*]i64, kept: [*]i64, row: [*]const i64, count: usize) -> void {
    var index: usize = 0
    while index < count {
        run[index] = run[index] +% row[index] -% kept[index]
        kept[index] = row[index]
        index += 1
    }
}

// The high pass with three boxes for the bell, reaching `reach` pixels
// together: running sums along a row and across the rows, so a large
// radius costs no more than a small one. A box across the rows keeps the
// rows of its window and their sum; each row that comes in pushes one out,
// and what the first box sums up goes into the second, and on into the
// third. The rows above the picture and below it are its first and last
// row again. False without memory (the pixels stay).
fn highPassBoxes(pixels: [*]u32, width: usize, height: usize, stride: usize, reach: usize) -> bool {
    const state = cover(pixels, width, height, stride)
    if state == EMPTY {
        clear(pixels, width, height, stride)
        return true
    }
    const form: u32 = if state == MIXED { WEIGHED } else { 0 }
    const values = valuesOf(form)
    const count = width * values
    const window0 = boxReach(reach, 0) * 2 + 1
    const window1 = boxReach(reach, 1) * 2 + 1
    const window2 = boxReach(reach, 2) * 2 + 1
    // What a row is after each box along it: shorter by the box's reach
    // at both ends.
    const length1 = count + (window1 + window2 - 2) * values
    const length2 = count + (window2 - 1) * values
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const wide = scratch.ints(pool, (width + reach * 2) * values)
    const first = longs(pool, length1)
    const second = longs(pool, length2)
    const along = longs(pool, count)
    const runs = longs(pool, count * 3)
    const kept = longs(pool, (window0 + window1 + window2) * count)
    const sums = longs(pool, count)
    if wide == null || first == null || second == null || along == null || runs == null || kept == null || sums == null {
        scratch.release(pool, mark)
        return false
    }
    var index: usize = 0
    while index < count * 3 {
        runs.?[index] = 0
        index += 1
    }
    index = 0
    while index < (window0 + window1 + window2) * count {
        kept.?[index] = 0
        index += 1
    }
    const run0 = runs.?
    const run1 = runs.? + count
    const run2 = runs.? + count * 2
    const kept0 = kept.?
    const kept1 = kept.? + window0 * count
    const kept2 = kept.? + (window0 + window1) * count
    // The blur's whole weight: the pixel is weighed as much, the blur
    // taken from it, and the two divided once.
    const weight = @intCast(i64, window0 * window1 * window2)
    const whole_weight = weight * weight
    var fed0: usize = 0
    var fed1: usize = 0
    var fed2: usize = 0
    // The row `along` holds (none yet). A row is read before any row at
    // or below it is written: the first box is `reach` rows ahead of the
    // row that comes out of the third.
    var holds = height
    var step: usize = 0
    while step < height + reach * 2 {
        const source = if step < reach { 0 } else if step - reach > height - 1 { height - 1 } else { step - reach }
        if source != holds {
            spread(pixels + source * stride, width, reach, form, wide.?)
            box32(first.?, wide.?, length1, values, window0)
            box64(second.?, first.?, length2, values, window1)
            box64(along.?, second.?, count, values, window2)
            holds = source
        }
        slide(run0, kept0 + (fed0 % window0) * count, along.?, count)
        fed0 += 1
        if fed0 >= window0 {
            slide(run1, kept1 + (fed1 % window1) * count, run0, count)
            fed1 += 1
        }
        if fed0 >= window0 && fed1 >= window1 {
            slide(run2, kept2 + (fed2 % window2) * count, run1, count)
            fed2 += 1
            if fed2 >= window2 {
                const line = pixels + (step - reach * 2) * stride
                index = 0
                while index < count {
                    sums.?[index] = -run2[index]
                    index += 1
                }
                settle(sums.?, line, width, form, whole_weight, 0)
                finish(sums.?, line, width, form, COLOR, whole_weight, 128, whole_weight * 2, false)
            }
        }
        step += 1
    }
    scratch.release(pool, mark)
    return true
}

// The high pass with the bell itself, in whole weights.
fn highPassBell(pixels: [*]u32, width: usize, height: usize, stride: usize, sigma: f64, reach: usize) -> bool {
    const taps = reach * 2 + 1
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const bell = scratch.ints(pool, taps)
    const turned = scratch.ints(pool, taps)
    var done = false
    if bell != null && turned != null {
        // The weights add up to about 16384 (half of HEAVIEST); across the
        // rows they are negative: the pixel times the kernel's whole
        // weight minus the blur's sums is the pixel minus the blur,
        // divided once.
        var area: f64 = 0.0
        var index: usize = 0
        while index < taps {
            const distance = @floatFromInt(f64, index) - @floatFromInt(f64, reach)
            area += math.exp(-distance * distance / (2.0 * sigma * sigma))
            index += 1
        }
        var total: i32 = 0
        index = 0
        while index < taps {
            const distance = @floatFromInt(f64, index) - @floatFromInt(f64, reach)
            const weight = @intFromFloat(i32, 16384.0 * math.exp(-distance * distance / (2.0 * sigma * sigma)) / area + 0.5)
            bell.?[index] = weight
            turned.?[index] = -weight
            total += weight
            index += 1
        }
        const kernel = Separable.{ .along = bell.?[0..taps], .across = turned.?[0..taps], .center = total * total, .divisor = total * total, .offset = 128, .channels = COLOR }
        done = separable(pixels, width, height, stride, &kernel, false)
    }
    scratch.release(pool, mark)
    return done
}

fn highPass(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const radius = highPassRadius(params)
    const reach = bellReach(radius)
    if reach <= WIDEST_BELL {
        _ = highPassBell(pixels, width, height, stride, sigmaOf(radius), reach)
    } else {
        _ = highPassBoxes(pixels, width, height, stride, boxesReach(sigmaOf(radius)))
    }
}

const NORMAL_PARAMS = [6]types.Param{
    types.Param.{ .name = "Formula", .german = "Formel", .kind = types.CHOICE, .low = 0.0, .high = 2.0, .initial = 1.0, .choices = "Prewitt|Sobel|Simple", .choicesGerman = "Prewitt|Sobel|Einfach" },
    types.Param.{ .name = "Horizontal Radius", .german = "Horizontaler Radius", .kind = types.FLOAT, .low = 1.0, .high = 100.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Vertical Radius", .german = "Vertikaler Radius", .kind = types.FLOAT, .low = 1.0, .high = 100.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Red", .german = "Rot", .kind = types.CHOICE, .low = 0.0, .high = 5.0, .initial = 0.0, .choices = "X+|X-|Y+|Y-|Z+|Z-", .choicesGerman = "X+|X-|Y+|Y-|Z+|Z-" },
    types.Param.{ .name = "Green", .german = "Grün", .kind = types.CHOICE, .low = 0.0, .high = 5.0, .initial = 2.0, .choices = "X+|X-|Y+|Y-|Z+|Z-", .choicesGerman = "X+|X-|Y+|Y-|Z+|Z-" },
    types.Param.{ .name = "Blue", .german = "Blau", .kind = types.CHOICE, .low = 0.0, .high = 5.0, .initial = 4.0, .choices = "X+|X-|Y+|Y-|Z+|Z-", .choicesGerman = "X+|X-|Y+|Y-|Z+|Z-" },
}

fn normalNumber(params: *const Params, place: usize) -> f64 {
    return held(params.*.values[place], NORMAL_PARAMS[place].low, NORMAL_PARAMS[place].high, NORMAL_PARAMS[place].initial)
}

fn normalMargin(params: *const Params) -> i32 {
    const reachX = @intCast(i32, reachOf(normalNumber(params, 1)))
    const reachY = @intCast(i32, reachOf(normalNumber(params, 2)))
    return if reachX > reachY { reachX } else { reachY }
}

fn normal(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const look = Look.{ .output = NORMAL, .toAlpha = false, .red = @intCast(u32, whole(normalNumber(params, 3))), .green = @intCast(u32, whole(normalNumber(params, 4))), .blue = @intCast(u32, whole(normalNumber(params, 5))) }
    _ = slopes(pixels, width, height, stride, whole(normalNumber(params, 0)), reachOf(normalNumber(params, 1)), reachOf(normalNumber(params, 2)), &look)
}

const FILTERS = [14]types.Info{
    types.Info.{ .id = TOP_EDGE, .key = "topedgedetections", .name = "Top Edge Detection", .german = "Kantenerkennung oben", .category = types.EDGE, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = RIGHT_EDGE, .key = "rightedgedetections", .name = "Right Edge Detection", .german = "Kantenerkennung rechts", .category = types.EDGE, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = BOTTOM_EDGE, .key = "bottomedgedetections", .name = "Bottom Edge Detection", .german = "Kantenerkennung unten", .category = types.EDGE, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = LEFT_EDGE, .key = "leftedgedetections", .name = "Left Edge Detection", .german = "Kantenerkennung links", .category = types.EDGE, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = EDGE_DETECTION, .key = "edge detection", .name = "Edge Detection", .german = "Kantenerkennung", .category = types.EDGE, .params = EDGE_PARAMS[0..], .margin = edgesMargin, .apply = edges },
    types.Info.{ .id = GAUSSIAN_HIGH_PASS, .key = "gaussianhighpass", .name = "Gaussian High Pass", .german = "Gaußscher Hochpass", .category = types.EDGE, .params = HIGH_PASS_PARAMS[0..], .margin = highPassMargin, .apply = highPass },
    types.Info.{ .id = HEIGHT_TO_NORMAL, .key = "height to normal", .name = "Height to Normal Map", .german = "Höhe zu Normalenkarte", .category = types.EDGE, .params = NORMAL_PARAMS[0..], .margin = normalMargin, .apply = normal },
    types.Info.{ .id = LAPLACIAN, .key = "laplacian", .name = "Laplacian Edge Detection", .german = "Kantenerkennung (Laplace)", .category = types.EDGE, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = EMBOSS_HORIZONTAL, .key = "emboss horizontal only", .name = "Emboss Horizontal Only", .german = "Relief nur horizontal", .category = types.EMBOSS, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = EMBOSS_VERTICAL, .key = "emboss vertical only", .name = "Emboss Vertical Only", .german = "Relief nur vertikal", .category = types.EMBOSS, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = EMBOSS_ALL, .key = "emboss all directions", .name = "Emboss in All Directions", .german = "Relief in alle Richtungen", .category = types.EMBOSS, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = EMBOSS_HORIZONTAL_VERTICAL, .key = "emboss horizontal and vertical", .name = "Emboss Horizontal and Vertical", .german = "Relief horizontal und vertikal", .category = types.EMBOSS, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = EMBOSS_LAPLACIAN, .key = "emboss laplascian", .name = "Emboss (Laplacian)", .german = "Relief (Laplace)", .category = types.EMBOSS, .params = NO_PARAMS[0..], .margin = one, .apply = fixed },
    types.Info.{ .id = EMBOSS, .key = "emboss", .name = "Emboss with Variable Depth", .german = "Relief mit variabler Tiefe", .category = types.EMBOSS, .params = EMBOSS_PARAMS[0..], .margin = one, .apply = emboss },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const types.Info {
    if kept.address != 0 { return table.rows(types.Info, &kept) }
    return table.keep(types.Info, &kept, FILTERS[0..])
}
