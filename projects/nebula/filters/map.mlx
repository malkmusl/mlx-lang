// nebula filters: the Map group of the Filter menu: Small Tiles, Round
// Corners, Phong Bumpmap, Normalize and Propagate Colors (ids 300-349).
//
//     var params: types.Params = undefined
//     registry.defaults(map.PHONG_BUMPMAP, &params)
//     params.values[5] = 80.0                      // shininess
//     _ = registry.apply(&params, pixels, width, height, stride)
//
// Each works in place on straight pixels and reads its numbers held in
// their ranges (NaN: the initial value).
//
// Small Tiles and Round Corners are about the whole layer: the tiles are
// the rectangle handed in made small, the corners are the rectangle's, so
// the caller hands in the layer's rectangle. Small Tiles has no margin
// that would make blocks come out right and names none. Round Corners
// names its radius: a corner's cut reaches no further than that from the
// layer's sides, so a block grown by it and held inside the layer comes
// out as the whole does (blocks away from the corners: unchanged).
// Phong Bumpmap reads the pixels next to a pixel (margin 1) unless it is
// given a normal map; Normalize reads nothing but the pixel. Propagate
// Colors reads as far as its expansion amount when it is bounded, and
// the whole layer when not (it names no margin then).
//
// Alpha: Small Tiles mixes it as it mixes colour (colour weighed by
// alpha); Round Corners takes it away; Phong Bumpmap and Normalize keep
// it; Propagate Colors gives transparent pixels the nearest seen one's
// (or keeps their 0 and only gives them its colour). A pixel that ends
// transparent is 0, but for Propagate Colors' "Preserve", whose point is
// the colour under the transparency.
//
// Ids 310 ("gradientmap", Gradient Map) and 311 ("palettize", Palettize)
// are kept free for the two filters that need gradients and palettes
// (filters/gradientmap.mlx and filters/palettize.mlx will have them).
const math = @import("std.math")
const types = @import("./types.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const table = @import("../core/table.mlx")

pub const Params = types.Params

pub const SMALL_TILES: u16 = 300
pub const ROUND_CORNERS: u16 = 301
pub const PHONG_BUMPMAP: u16 = 302
pub const NORMALIZE: u16 = 303
pub const PROPAGATE_COLORS: u16 = 304

// Propagate Colors' "Distance metric", "Expansion" and "Alpha channel".
pub const EUCLIDEAN: u32 = 0
pub const CITY_BLOCK: u32 = 1
pub const CHESSBOARD: u32 = 2
pub const BOUNDED: u32 = 0
pub const UNBOUNDED: u32 = 1
pub const PRESERVE: u32 = 0
pub const EXPAND: u32 = 1

// Where each filter is in FILTERS.
const SMALL_TILES_PLACE: usize = 0
const ROUND_CORNERS_PLACE: usize = 1
const PHONG_PLACE: usize = 2
const PROPAGATE_PLACE: usize = 4

const NO_PARAMS = [0]types.Param{}

// The number at `index` of a filter's `rows`, held in its range (files
// and scripts hand in anything; NaN counts as the initial value).
fn number(params: *const Params, rows: []const types.Param, index: usize) -> f64 {
    const value = params.*.values[index]
    if value != value { return rows[index].initial }
    if value < rows[index].low { return rows[index].low }
    if value > rows[index].high { return rows[index].high }
    return value
}

// The same as a whole number (the nearest).
fn whole(params: *const Params, rows: []const types.Param, index: usize) -> i32 {
    return @intFromFloat(i32, math.round(number(params, rows, index)))
}

fn switched(params: *const Params, rows: []const types.Param, index: usize) -> bool {
    return number(params, rows, index) >= 0.5
}

// A colour parameter's 0xAARRGGBB.
fn colorOf(params: *const Params, rows: []const types.Param, index: usize) -> u32 {
    return @intCast(u32, @intFromFloat(i64, math.round(number(params, rows, index))))
}

// a * b / 255 rounded (pixel.mul as one expression, so that no call is
// left in a loop).
inline fn rounded(sum: u32) -> u32 { return (sum + (sum >> 8)) >> 8 }
inline fn scaled(a: u32, b: u32) -> u32 { return rounded(a * b + 128) }

// ---- Small Tiles ----
//
// The picture made small and laid out `number of tiles` times across and
// down. The rectangle is cut into that many columns and rows of tiles as
// evenly as whole pixels allow (tile i begins at i * width / number, so
// two tiles differ by a pixel at most), and each tile shows the whole
// picture made as small as the tile is: in a tile w pixels wide, pixel j
// is the mean of the picture's columns j * width / w up to (j + 1) *
// width / w, and the same down; the alpha's mean, the colour's mean
// weighed by alpha. One tile changes nothing; with more tiles than
// pixels some tiles are no pixel wide and each of the others shows the
// mean of the whole picture.
//
// Tiles of one size show the same small picture, and there are at most
// two sizes across and two down: the small pictures are worked out once
// for each, each row of the picture added up into column sums once for
// each tile height, and the tiles are then copies.

const SMALL_TILES_PARAMS = [1]types.Param{
    types.Param.{ .name = "Number of tiles", .german = "Anzahl der Kacheln", .kind = types.INT, .low = 1.0, .high = 64.0, .initial = 2.0, .choices = "", .choicesGerman = "" },
}

// A row of the small picture `across` pixels wide into `into`, from the
// column sums of the band of `rows` rows of the picture it stands for
// (`sums`: alpha, and red, green and blue times alpha, four for each of
// the `width` columns).
fn smallRow(into: [*]u32, sums: [*]const u64, width: usize, across: usize, rows: usize) -> void {
    var column: usize = 0
    while column < across {
        const left = column * width / across
        const right = (column + 1) * width / across
        var alpha: u64 = 0
        var red: u64 = 0
        var green: u64 = 0
        var blue: u64 = 0
        var x = left
        while x < right {
            alpha += sums[x * 4]
            red += sums[x * 4 + 1]
            green += sums[x * 4 + 2]
            blue += sums[x * 4 + 3]
            x += 1
        }
        const count = @intCast(u64, (right - left) * rows)
        const a = (alpha + count / 2) / count
        var mean: u32 = 0
        if a != 0 {
            const half = alpha / 2
            mean = (@intCast(u32, a) << 24) | (@intCast(u32, (red + half) / alpha) << 16) | (@intCast(u32, (green + half) / alpha) << 8) | @intCast(u32, (blue + half) / alpha)
        }
        into[column] = mean
        column += 1
    }
}

fn smallTiles(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const tiles = @intCast(usize, whole(params, described(SMALL_TILES_PLACE), 0))
    if tiles == 1 { return }
    // The smaller tile's width and height (0 with more tiles than pixels);
    // the larger is one more.
    const narrow = width / tiles
    const low = height / tiles
    // The small pictures as one: its first `low` rows are those of the
    // lower tiles, the next `low + 1` those of the higher; a row holds the
    // narrow tiles' `narrow` pixels, then the wide ones' `narrow + 1`.
    const line = narrow * 2 + 1
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const small = scratch.words(pool, line * (low * 2 + 1))
    const column_sums = scratch.bytes(pool, width * 32)
    const columns = scratch.ints(pool, width)
    if small == null || column_sums == null || columns == null {
        scratch.release(pool, mark)
        return
    }
    const sums: [*]u64 = unsafe { @ptrCast([*]u64, column_sums.?) }
    const place = columns.?
    // A tile height is wanted when a tile has it: the higher only where
    // the number does not divide the height.
    var tall = low
    while tall <= low + 1 {
        if tall != 0 && (tall == low || height % tiles != 0) {
            const first_row = if tall == low { 0 } else { low }
            var row: usize = 0
            while row < tall {
                const top = row * height / tall
                const bottom = (row + 1) * height / tall
                var index: usize = 0
                while index < width * 4 {
                    sums[index] = 0
                    index += 1
                }
                var y = top
                while y < bottom {
                    const from = pixels + y * stride
                    var x: usize = 0
                    while x < width {
                        const p = from[x]
                        const a = p >> 24
                        if a != 0 {
                            sums[x * 4] += @intCast(u64, a)
                            sums[x * 4 + 1] += @intCast(u64, ((p >> 16) & 255) * a)
                            sums[x * 4 + 2] += @intCast(u64, ((p >> 8) & 255) * a)
                            sums[x * 4 + 3] += @intCast(u64, (p & 255) * a)
                        }
                        x += 1
                    }
                    y += 1
                }
                const into = small.? + (first_row + row) * line
                if narrow != 0 { smallRow(into, sums, width, narrow, bottom - top) }
                smallRow(into + narrow, sums, width, narrow + 1, bottom - top)
                row += 1
            }
        }
        tall += 1
    }
    // Where in a row of the small pictures each column of the rectangle
    // takes its pixel from: the tile it is in, and its place in that tile.
    var tile: usize = 0
    var start: usize = 0
    var end = width / tiles
    var x: usize = 0
    while x < width {
        while x >= end {
            tile += 1
            start = end
            end = (tile + 1) * width / tiles
        }
        place[x] = @intCast(i32, (if end - start == narrow { 0 } else { narrow }) + (x - start))
        x += 1
    }
    tile = 0
    start = 0
    end = height / tiles
    var y: usize = 0
    while y < height {
        while y >= end {
            tile += 1
            start = end
            end = (tile + 1) * height / tiles
        }
        const from = small.? + ((if end - start == low { 0 } else { low }) + (y - start)) * line
        const row = pixels + y * stride
        x = 0
        while x < width {
            row[x] = from[@intCast(usize, place[x])]
            x += 1
        }
        y += 1
    }
    scratch.release(pool, mark)
}

// ---- Round Corners ----
//
// The rectangle's four corners cut round. In each corner lies a quarter
// circle of `radius` whose middle is `radius` in from both of the
// corner's sides; what is beyond it towards the corner loses its alpha,
// over one pixel of in-between at the circle's edge (a pixel keeps as
// much as its middle is inside the circle, plus half a pixel, held in 0
// to 1). Radius 0 changes nothing.
//
// Each corner cuts on its own, whatever the rectangle's size: where the
// radius is more than half a side, two corners' cuts meet and a pixel
// that both reach loses alpha to both (beyond half the diagonal nothing is
// left). That is what keeps a corner's reach to `radius` from the sides,
// so that margin() can be the radius (see the module's header); a radius
// held to half the rectangle would depend on the block handed in.

const ROUND_CORNERS_PARAMS = [1]types.Param{
    types.Param.{ .name = "Radius", .german = "Radius", .kind = types.INT, .low = 0.0, .high = 4096.0, .initial = 30.0, .choices = "", .choicesGerman = "" },
}

fn roundCornersMargin(params: *const Params) -> i32 {
    return whole(params, described(ROUND_CORNERS_PLACE), 0)
}

// The pixel at `at` with its alpha times `cover` of 255.
inline fn covered(at: u32, cover: u32) -> u32 {
    return if scaled(at >> 24, cover) == 0 { 0 } else { (at & 0x00FFFFFF) | (scaled(at >> 24, cover) << 24) }
}

fn roundCorners(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const radius = @intCast(usize, whole(params, described(ROUND_CORNERS_PLACE), 0))
    if radius == 0 { return }
    const reach = @floatFromInt(f64, radius)
    // A corner's rows and columns whose middles are short of the circle's
    // middle: only those can be outside it.
    const cut_rows = if radius < height { radius } else { height }
    const cut_columns = if radius < width { radius } else { width }
    // Upper left, upper right, lower left, lower right: (cx, cy) counted
    // from the corner inwards.
    var corner: usize = 0
    while corner < 4 {
        var cy: usize = 0
        while cy < cut_rows {
            const row = pixels + (if corner < 2 { cy } else { height - 1 - cy }) * stride
            const dy = reach - (@floatFromInt(f64, cy) + 0.5)
            var cx: usize = 0
            while cx < cut_columns {
                const dx = reach - (@floatFromInt(f64, cx) + 0.5)
                const inside = reach - @sqrt(dx * dx + dy * dy) + 0.5
                // Further in along the row the pixels are only nearer the
                // circle's middle: from the first kept whole on, all are.
                if inside >= 1.0 { break }
                const cover: u32 = if inside <= 0.0 { 0 } else { @intFromFloat(u32, inside * 255.0 + 0.5) }
                const x = if corner % 2 == 0 { cx } else { width - 1 - cx }
                row[x] = covered(row[x], cover)
                cx += 1
            }
            cy += 1
        }
        corner += 1
    }
}

// ---- Phong Bumpmap ----
//
// The picture read as a relief and lit: the result is the light on it,
// not the picture's colours. The height of a pixel is its lightness (or
// one of its channels) times its alpha, so that what is transparent is
// the ground; the surface's normal comes from the heights left and right
// and above and below (the edge's height going on beyond the edge), as
// (-dx, dy, 8) with the heights 0-255, x to the right and y up. With `use
// normal map` the pixel's colour is the normal itself, red, green and
// blue being x, y and z from -1 to 1 around 128.
//
// Each of up to four lights comes from its azimuth (0 degrees: from the
// right, 90: from above) at its inclination over the picture's plane (90:
// straight from the viewer). A pixel gets the ambient reflectivity, and
// from each light that reaches its side the light's colour times
// (diffuse * (normal . light) + specular * (normal . half)^shininess),
// half being the direction between the light and the viewer: Blinn's
// form of Phong's model. The pixel's alpha stays.

const PHONG_PARAMS = [22]types.Param{
    types.Param.{ .name = "Height channel", .german = "Höhenkanal", .kind = types.CHOICE, .low = 0.0, .high = 4.0, .initial = 0.0, .choices = "Luminance|Red|Green|Blue|Alpha", .choicesGerman = "Helligkeit|Rot|Grün|Blau|Alpha" },
    types.Param.{ .name = "Use normal map", .german = "Normalenkarte verwenden", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Ambient reflectivity", .german = "Umgebungsreflexion", .kind = types.FLOAT, .low = 0.0, .high = 1.0, .initial = 0.2, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Diffuse reflectivity", .german = "Diffuse Reflexion", .kind = types.FLOAT, .low = 0.0, .high = 1.0, .initial = 0.5, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Specular reflectivity", .german = "Spiegelnde Reflexion", .kind = types.FLOAT, .low = 0.0, .high = 1.0, .initial = 0.3, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Shininess", .german = "Glanz", .kind = types.INT, .low = 1.0, .high = 200.0, .initial = 40.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 1", .german = "Licht 1", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 1 color", .german = "Farbe von Licht 1", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 1 azimuth", .german = "Azimut von Licht 1", .kind = types.ANGLE, .low = 0.0, .high = 360.0, .initial = 135.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 1 inclination", .german = "Neigung von Licht 1", .kind = types.ANGLE, .low = 0.0, .high = 90.0, .initial = 45.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 2", .german = "Licht 2", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 2 color", .german = "Farbe von Licht 2", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 2 azimuth", .german = "Azimut von Licht 2", .kind = types.ANGLE, .low = 0.0, .high = 360.0, .initial = 45.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 2 inclination", .german = "Neigung von Licht 2", .kind = types.ANGLE, .low = 0.0, .high = 90.0, .initial = 45.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 3", .german = "Licht 3", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 3 color", .german = "Farbe von Licht 3", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 3 azimuth", .german = "Azimut von Licht 3", .kind = types.ANGLE, .low = 0.0, .high = 360.0, .initial = 225.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 3 inclination", .german = "Neigung von Licht 3", .kind = types.ANGLE, .low = 0.0, .high = 90.0, .initial = 45.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 4", .german = "Licht 4", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 4 color", .german = "Farbe von Licht 4", .kind = types.COLOR, .low = 0.0, .high = 4294967295.0, .initial = 4294967295.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 4 azimuth", .german = "Azimut von Licht 4", .kind = types.ANGLE, .low = 0.0, .high = 360.0, .initial = 315.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Light 4 inclination", .german = "Neigung von Licht 4", .kind = types.ANGLE, .low = 0.0, .high = 90.0, .initial = 45.0, .choices = "", .choicesGerman = "" },
}

const PHONG_LIGHTS: usize = 4
// The numbers before the first light's, and of each light.
const PHONG_FIRST_LIGHT: usize = 6
const PHONG_PER_LIGHT: usize = 4
// A light as the loop over the pixels wants it: its direction, the half
// direction, its colour.
const PHONG_LIGHT_WORDS: usize = 9
// How far the normal of a flat place sticks out against a height step of
// one: the smaller, the steeper the relief looks.
const PHONG_DEPTH: f64 = 8.0

// Only a height map is read around the pixel.
fn phongMargin(params: *const Params) -> i32 {
    return if switched(params, described(PHONG_PLACE), 1) { 0 } else { 1 }
}

// A channel of a normal map as the part of its direction it is: byte /
// 127.5 - 1, from -1 to 1. Worked out at the first asking and kept (2 KiB).
var axis_table: [256]f64 = undefined
var axis_ready: bool = false

fn axes() -> [*]const f64 {
    if !axis_ready {
        var byte: usize = 0
        while byte < 256 {
            axis_table[byte] = @floatFromInt(f64, byte) / 127.5 - 1.0
            byte += 1
        }
        axis_ready = true
    }
    return &axis_table
}

// A light's share 0-1 as a channel.
inline fn channelOf(value: f64) -> u32 {
    return if value >= 1.0 { 255 } else if value <= 0.0 { 0 } else { @intFromFloat(u32, value * 255.0 + 0.5) }
}

// The height 0-255 of a pixel: the channel asked for times alpha.
inline fn heightOf(p: u32, channel: i32) -> u32 {
    return if channel == 4 { p >> 24 } else { scaled(p >> 24, if channel == 0 { pixel.luma(p) } else if channel == 1 { (p >> 16) & 255 } else if channel == 2 { (p >> 8) & 255 } else { p & 255 }) }
}

fn phongBumpmap(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const rows = described(PHONG_PLACE)
    const channel = whole(params, rows, 0)
    const mapped = switched(params, rows, 1)
    const ambient = number(params, rows, 2)
    const diffuse = number(params, rows, 3)
    const specular = number(params, rows, 4)
    const shininess = @intCast(u32, whole(params, rows, 5))
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const lamps = scratch.doubles(pool, PHONG_LIGHTS * PHONG_LIGHT_WORDS)
    // A normal map needs no heights (one byte stands in for the plane).
    const plane = scratch.bytes(pool, if mapped { 1 } else { width * height })
    if lamps == null || plane == null {
        scratch.release(pool, mark)
        return
    }
    const lights = lamps.?
    const heights = plane.?
    const axis = axes()
    var count: usize = 0
    var index: usize = 0
    while index < PHONG_LIGHTS {
        const first = PHONG_FIRST_LIGHT + index * PHONG_PER_LIGHT
        if switched(params, rows, first) {
            const color = colorOf(params, rows, first + 1)
            const azimuth = number(params, rows, first + 2) * math.pi / 180.0
            const inclination = number(params, rows, first + 3) * math.pi / 180.0
            const light = lights + count * PHONG_LIGHT_WORDS
            light[0] = math.cos(azimuth) * math.cos(inclination)
            light[1] = math.sin(azimuth) * math.cos(inclination)
            light[2] = math.sin(inclination)
            // Between the light and the viewer, who looks down z; its z
            // is at least 1, so there is a length to divide by.
            const length = @sqrt(light[0] * light[0] + light[1] * light[1] + (light[2] + 1.0) * (light[2] + 1.0))
            light[3] = light[0] / length
            light[4] = light[1] / length
            light[5] = (light[2] + 1.0) / length
            light[6] = @floatFromInt(f64, (color >> 16) & 255) / 255.0
            light[7] = @floatFromInt(f64, (color >> 8) & 255) / 255.0
            light[8] = @floatFromInt(f64, color & 255) / 255.0
            count += 1
        }
        index += 1
    }
    if !mapped {
        var y: usize = 0
        while y < height {
            const row = pixels + y * stride
            const into = heights + y * width
            var x: usize = 0
            while x < width {
                into[x] = @intCast(u8, heightOf(row[x], channel))
                x += 1
            }
            y += 1
        }
    }
    // What a flat place looks like, once it is worked out: most of a
    // relief is flat.
    var flat: u32 = 0
    var flat_known = false
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        const above = heights + (if y == 0 { 0 } else { y - 1 }) * width
        const below = heights + (if y + 1 == height { y } else { y + 1 }) * width
        const here = heights + y * width
        var x: usize = 0
        while x < width {
            const p = row[x]
            const a = p >> 24
            if a == 0 {
                row[x] = 0
                x += 1
                continue
            }
            var nx: f64 = 0.0
            var ny: f64 = 0.0
            var nz: f64 = PHONG_DEPTH
            var level = false
            if mapped {
                nx = axis[@intCast(usize, (p >> 16) & 255)]
                ny = axis[@intCast(usize, (p >> 8) & 255)]
                nz = axis[@intCast(usize, p & 255)]
            } else {
                const left = here[if x == 0 { 0 } else { x - 1 }]
                const right = here[if x + 1 == width { x } else { x + 1 }]
                const up = above[x]
                const down = below[x]
                level = left == right && up == down
                if level && flat_known {
                    row[x] = (a << 24) | flat
                    x += 1
                    continue
                }
                nx = @floatFromInt(f64, left) - @floatFromInt(f64, right)
                ny = @floatFromInt(f64, down) - @floatFromInt(f64, up)
            }
            const length = @sqrt(nx * nx + ny * ny + nz * nz)
            if length > 0.0 {
                nx = nx / length
                ny = ny / length
                nz = nz / length
            } else {
                nz = 1.0
            }
            var red = ambient
            var green = ambient
            var blue = ambient
            var lamp: usize = 0
            while lamp < count {
                const light = lights + lamp * PHONG_LIGHT_WORDS
                const facing = nx * light[0] + ny * light[1] + nz * light[2]
                if facing > 0.0 {
                    var lit = diffuse * facing
                    const glint = nx * light[3] + ny * light[4] + nz * light[5]
                    if glint > 0.0 && specular > 0.0 {
                        // glint to the power of the shininess, by
                        // squaring.
                        var power: f64 = 1.0
                        var factor = glint
                        var times = shininess
                        while times != 0 {
                            if times & 1 != 0 { power = power * factor }
                            factor = factor * factor
                            times = times >> 1
                        }
                        lit += specular * power
                    }
                    red += light[6] * lit
                    green += light[7] * lit
                    blue += light[8] * lit
                }
                lamp += 1
            }
            const shade = (channelOf(red) << 16) | (channelOf(green) << 8) | channelOf(blue)
            if level {
                flat = shade
                flat_known = true
            }
            row[x] = (a << 24) | shade
            x += 1
        }
        y += 1
    }
    scratch.release(pool, mark)
}

// ---- Normalize ----
//
// For normal maps: red, green and blue read as a direction (x, y and z
// from -1 to 1 around 128) and given the length 1. Alpha stays, and what
// is transparent stays as it is. A normal map has long runs of one colour
// (its flat parts): a pixel like the one before takes its answer.

fn normalize(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const axis = axes()
    // The last pixel worked out and what it became (0 is no pixel that is
    // worked out: those are seen).
    var known: u32 = 0
    var became: u32 = 0
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        var x: usize = 0
        while x < width {
            const p = row[x]
            if p >> 24 != 0 {
                if p != known {
                    const vx = axis[@intCast(usize, (p >> 16) & 255)]
                    const vy = axis[@intCast(usize, (p >> 8) & 255)]
                    const vz = axis[@intCast(usize, p & 255)]
                    // Never 0: no channel is 127.5.
                    const half = 0.5 / @sqrt(vx * vx + vy * vy + vz * vz)
                    became = (p & 0xFF000000) | (channelOf(vx * half + 0.5) << 16) | (channelOf(vy * half + 0.5) << 8) | channelOf(vz * half + 0.5)
                    known = p
                }
                row[x] = became
            }
            x += 1
        }
        y += 1
    }
}

// ---- Propagate Colors ----
//
// The colours of what is seen carried out into what is not: a transparent
// pixel takes the colour of the nearest seen pixel (alpha above 0),
// nearest by the distance metric: Euclidean (round), city block (steps
// along rows and columns: a diamond) or chessboard (the larger of the two
// steps: a square). Bounded, only pixels at most the expansion amount away
// from what is seen take a colour; unbounded, all of them. Of seen pixels
// equally near, the one in the leftmost column wins, and in a column the
// one nearest along it (the upper one of two as near): a rule of places
// alone, which is what makes a block come out as the whole does.
//
// Expand: the pixel becomes the seen one, alpha and all (the layer grows
// by its edges' colours). Preserve: it takes the colour and keeps its
// alpha 0 (the colour under the transparency, for formats and programs
// that use it: a texture's edges that do not darken when it is scaled
// down).
//
// Exact distances in time linear in the pixels, after Meijster, Roerdink
// and Hesselink: first for each pixel the row of the nearest seen pixel in
// its column (a pass down and one up, a row at a time for all columns);
// then along each row which column's nearest is nearest altogether: the
// lower envelope of the columns' distance curves, built left to right on
// a stack and read off right to left.

const PROPAGATE_PARAMS = [4]types.Param{
    types.Param.{ .name = "Distance metric", .german = "Abstandsmaß", .kind = types.CHOICE, .low = 0.0, .high = 2.0, .initial = 0.0, .choices = "Euclidean|City block|Chessboard", .choicesGerman = "Euklidisch|Manhattan|Schachbrett" },
    types.Param.{ .name = "Expansion", .german = "Ausdehnung", .kind = types.CHOICE, .low = 0.0, .high = 1.0, .initial = 1.0, .choices = "Bounded|Unbounded", .choicesGerman = "Begrenzt|Unbegrenzt" },
    types.Param.{ .name = "Expansion amount", .german = "Ausdehnungsweite", .kind = types.FLOAT, .low = 0.0, .high = 2048.0, .initial = 8.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Alpha channel", .german = "Alphakanal", .kind = types.CHOICE, .low = 0.0, .high = 1.0, .initial = 1.0, .choices = "Preserve|Expand", .choicesGerman = "Erhalten|Ausdehnen" },
}

// Further than any two pixels of a rectangle are apart, in every metric.
const PROPAGATE_FAR: i64 = 0x0000400000000000

// Bounded: the amount around a pixel; unbounded is about the whole layer.
fn propagateMargin(params: *const Params) -> i32 {
    const rows = described(PROPAGATE_PLACE)
    if @intCast(u32, whole(params, rows, 1)) != BOUNDED { return 0 }
    return @intFromFloat(i32, @ceil(number(params, rows, 2)))
}

// How far a pixel is from the nearest seen pixel of a column `across`
// columns away, that one being `along` rows off (Euclidean: squared).
inline fn apart(metric: u32, across: i64, along: i64) -> i64 {
    return if metric == EUCLIDEAN { across * across + along * along } else if metric == CITY_BLOCK { across + along } else if across > along { across } else { along }
}

// a / b rounded down (b above 0).
inline fn floorDivided(a: i64, b: i64) -> i64 {
    return if a < 0 && a % b != 0 { a / b - 1 } else { a / b }
}

// The last place at which column `left` (its nearest `left_gap` rows off)
// is at least as near as column `right` (`right_gap`): from there on
// right of it the right one is nearer. PROPAGATE_FAR: never; minus it: the
// right one is nearer everywhere.
fn parting(metric: u32, left: i64, right: i64, left_gap: i64, right_gap: i64) -> i64 {
    if metric == EUCLIDEAN {
        return floorDivided(right * right - left * left + right_gap * right_gap - left_gap * left_gap, 2 * (right - left))
    }
    if metric == CITY_BLOCK {
        if right_gap >= left_gap + right - left { return PROPAGATE_FAR }
        if left_gap > right_gap + right - left { return 0 - PROPAGATE_FAR }
        // Not below 0 here: right_gap - left_gap is at least left - right.
        return (right_gap - left_gap + right + left) / 2
    }
    const middle = (left + right) / 2
    if left_gap <= right_gap { return if left + right_gap > middle { left + right_gap } else { middle } }
    return if right - left_gap < middle { right - left_gap } else { middle }
}

fn propagateColors(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const rows = described(PROPAGATE_PLACE)
    const metric = @intCast(u32, whole(params, rows, 0))
    const bounded = @intCast(u32, whole(params, rows, 1)) == BOUNDED
    const amount = number(params, rows, 2)
    const expand = @intCast(u32, whole(params, rows, 3)) == EXPAND
    // The farthest a pixel may be to take a colour, as apart() counts.
    var limit = PROPAGATE_FAR
    if bounded { limit = @intFromFloat(i64, @floor(if metric == EUCLIDEAN { amount * amount } else { amount })) }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    // For each pixel the row of the nearest seen pixel in its column (-1:
    // none); for each column the nearest seen at or below the row at hand;
    // and along a row: each column's distance to its nearest, the columns
    // on the envelope's stack and where each begins.
    const plane = scratch.ints(pool, width * height)
    const under = scratch.ints(pool, width)
    const gap_row = scratch.ints(pool, width)
    const site_row = scratch.ints(pool, width)
    const start_row = scratch.ints(pool, width)
    if plane == null || under == null || gap_row == null || site_row == null || start_row == null {
        scratch.release(pool, mark)
        return
    }
    const nearest = plane.?
    const below = under.?
    const gaps = gap_row.?
    const sites = site_row.?
    const starts = start_row.?
    // Down the columns: the nearest seen pixel at or above.
    var seen = false
    var unseen = false
    var y: usize = 0
    while y < height {
        const row = pixels + y * stride
        const here = nearest + y * width
        var x: usize = 0
        while x < width {
            if row[x] >> 24 != 0 {
                here[x] = @intCast(i32, y)
                seen = true
            } else {
                here[x] = if y == 0 { -1 } else { nearest[(y - 1) * width + x] }
                unseen = true
            }
            x += 1
        }
        y += 1
    }
    if !seen || !unseen {
        scratch.release(pool, mark)
        return
    }
    // Up: the nearest at or below, and of the two the nearer (the one
    // above when they are as near).
    var x: usize = 0
    while x < width {
        below[x] = -1
        x += 1
    }
    y = height
    while y > 0 {
        y -= 1
        const here = nearest + y * width
        const place = @intCast(i32, y)
        x = 0
        while x < width {
            const above = here[x]
            if above == place {
                below[x] = place
            } else if below[x] >= 0 && (above < 0 || below[x] - place < place - above) {
                here[x] = below[x]
            }
            x += 1
        }
    }
    // Along the rows, those with something not seen.
    y = 0
    while y < height {
        const row = pixels + y * stride
        x = 0
        while x < width && row[x] >> 24 != 0 { x += 1 }
        if x == width {
            y += 1
            continue
        }
        const here = nearest + y * width
        const place = @intCast(i64, y)
        // The envelope: count columns on the stack, each nearer than the
        // ones before from its start on.
        var count: usize = 0
        var column: usize = 0
        while column < width {
            if here[column] >= 0 {
                const gap = if @intCast(i64, here[column]) > place { @intCast(i64, here[column]) - place } else { place - @intCast(i64, here[column]) }
                gaps[column] = @intCast(i32, gap)
                const u = @intCast(i64, column)
                // Off the stack what the new column is nearer at the place
                // it began from (as near: the left one stays).
                while count > 0 {
                    const top = @intCast(i64, sites[count - 1])
                    const begins = @intCast(i64, starts[count - 1])
                    const old_across = if begins > top { begins - top } else { top - begins }
                    const new_across = if begins > u { begins - u } else { u - begins }
                    if apart(metric, old_across, @intCast(i64, gaps[@intCast(usize, sites[count - 1])])) <= apart(metric, new_across, gap) { break }
                    count -= 1
                }
                if count == 0 {
                    sites[0] = @intCast(i32, column)
                    starts[0] = 0
                    count = 1
                } else {
                    const begin = 1 + parting(metric, @intCast(i64, sites[count - 1]), u, @intCast(i64, gaps[@intCast(usize, sites[count - 1])]), gap)
                    if begin < @intCast(i64, width) {
                        sites[count] = @intCast(i32, column)
                        starts[count] = @intCast(i32, begin)
                        count += 1
                    }
                }
            }
            column += 1
        }
        if count != 0 {
            // Right to left: each place's nearest is the column on top of
            // the stack until the place where that column began.
            var top = count - 1
            x = width
            while x > 0 {
                x -= 1
                const site = @intCast(usize, sites[top])
                if row[x] >> 24 == 0 {
                    const across = if x > site { x - site } else { site - x }
                    if apart(metric, @intCast(i64, across), @intCast(i64, gaps[site])) <= limit {
                        // A seen pixel: nothing here writes over one.
                        const from = pixels[@intCast(usize, here[site]) * stride + site]
                        row[x] = if expand { from } else { from & 0x00FFFFFF }
                    }
                }
                if top > 0 && @intCast(i64, x) == @intCast(i64, starts[top]) { top -= 1 }
            }
        }
        y += 1
    }
    scratch.release(pool, mark)
}

const FILTERS = [5]types.Info{
    types.Info.{ .id = SMALL_TILES, .key = "smalltiles", .name = "Small Tiles", .german = "Kleine Kacheln", .category = types.MAP, .params = SMALL_TILES_PARAMS[0..], .margin = null, .apply = smallTiles },
    types.Info.{ .id = ROUND_CORNERS, .key = "roundcorners", .name = "Round Corners", .german = "Abgerundete Ecken", .category = types.MAP, .params = ROUND_CORNERS_PARAMS[0..], .margin = roundCornersMargin, .apply = roundCorners },
    types.Info.{ .id = PHONG_BUMPMAP, .key = "phongbumpmap", .name = "Phong Bumpmap", .german = "Phong-Bumpmap", .category = types.MAP, .params = PHONG_PARAMS[0..], .margin = phongMargin, .apply = phongBumpmap },
    types.Info.{ .id = NORMALIZE, .key = "normalize", .name = "Normalize", .german = "Normalisieren", .category = types.MAP, .params = NO_PARAMS[0..], .margin = null, .apply = normalize },
    types.Info.{ .id = PROPAGATE_COLORS, .key = "propagatecolors", .name = "Propagate Colors", .german = "Farben ausbreiten", .category = types.MAP, .params = PROPAGATE_PARAMS[0..], .margin = propagateMargin, .apply = propagateColors },
}

// The list in heap memory that stays, once it was asked for (a slice of
// the constant table itself would be a copy of all of it in the value
// arena at every asking: core/table.mlx).
var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// The module's filters. What it gives stays valid and where it is (only
// without memory at the first asking is it the table itself, good until
// the window's loop turns; the next asking tries again).
pub fn list() -> []const types.Info {
    if kept.address != 0 { return table.rows(types.Info, &kept) }
    return table.keep(types.Info, &kept, FILTERS[0..])
}

// What the filter at `place` of the list says of its numbers (the rows'
// own slices point at the parameter tables in the program's data).
fn described(place: usize) -> []const types.Param {
    return list()[place].params
}
