// nebula filters: Palettize (id 311, in the Map group): every pixel gets
// the colour of a palette's entry nearest to it (core/palette.mlx: CIE
// Lab distance), the steps between the colours hidden by a dither.
//
//     var params: types.Params = undefined
//     registry.defaults(palettize.PALETTIZE, &params)
//     params.values[0] = @floatFromInt(f64, palette.HANDHELD_4)     // which palette
//     params.values[1] = @floatFromInt(f64, palette.FLOYD_STEINBERG) // how to dither
//     _ = registry.apply(&params, pixels, width, height, stride)
//
// The palette is one of the built-in ones, by its number (palette.DEFAULT
// to palette.CONSOLE_16, in the order of the "Palette" choice), or, with
// the choice's last place (FROM_TEXT), the colours written in params.text
// ("#RRGGBB #RRGGBB ...", as palette.parseColors reads them; at most
// TEXT_COLORS of them). A text without a colour leaves the pixels as they
// are.
//
// What comes out depends on the rectangle handed in, and the filter says
// so with a margin of 0 (no amount of pixels around a rectangle would
// make it come out right):
//
// - An error-diffusing dither (Floyd-Steinberg, Atkinson) hands each
//   pixel's error on to the pixels after it, so a pixel's colour depends
//   on everything before it in the rectangle. Only a layer filtered whole
//   has no seams; the caller filters layers whole with it, not blocks.
// - An ordered dither (the Bayer patterns, Halftone, Lines) is anchored
//   at the first pixel of the buffer handed in and repeats every 8
//   pixels: blocks give the same picture as the whole only when each
//   block begins at a multiple of 8 from the layer's origin. Noise is
//   the same each time for the same rectangle.
//
// Alpha: with "Keep alpha" (the initial value) each pixel keeps its
// alpha and only its colour changes, a fully transparent pixel becomes 0;
// without it a pixel is opaque afterwards where its alpha was at least
// 128 and 0 where it was less (pixel art's hard edges). A number outside
// its range is the nearest end of it, what is no number the initial
// value.
const math = @import("std.math")
const types = @import("./types.mlx")
const palette = @import("../core/palette.mlx")
const scratch = @import("../core/scratch.mlx")
const node = @import("../core/node.mlx")
const table = @import("../core/table.mlx")

pub const Params = types.Params

pub const PALETTIZE: u16 = 311

// The "Palette" choice's last place: the colours of params.text.
pub const FROM_TEXT: usize = palette.BUILTINS
// The most colours the text is read for (a text of node.TEXT bytes holds
// some 50 at most).
pub const TEXT_COLORS: usize = 64

// The numbers' places in params.values.
pub const PALETTE: usize = 0
pub const DITHER: usize = 1
pub const STRENGTH: usize = 2
pub const KEEP_ALPHA: usize = 3

// (The choices are the built-in palettes' names in palette.mlx's order and
// its dithers' in theirs: tests/18_palette.mlx holds them to each other.)
const PARAMS = [5]types.Param{
    types.Param.{ .name = "Palette", .german = "Palette", .kind = types.CHOICE, .low = 0.0, .high = 9.0, .initial = 0.0, .choices = "Default|Greys|Web-safe|Skin tones|Pastel|PC 16 colours|Material|Handheld 4 greens|Pixel console 16|Colours of the text", .choicesGerman = "Standard|Grautöne|Websicher|Hauttöne|Pastell|PC 16 Farben|Material|Handheld 4 Grüntöne|Pixelkonsole 16|Farben aus dem Text" },
    types.Param.{ .name = "Dither", .german = "Rastern", .kind = types.CHOICE, .low = 0.0, .high = 8.0, .initial = 1.0, .choices = "None|Floyd-Steinberg|Bayer 8 x 8|Bayer 4 x 4|Bayer 2 x 2|Halftone|Lines|Noise|Atkinson", .choicesGerman = "Keines|Floyd-Steinberg|Bayer 8 x 8|Bayer 4 x 4|Bayer 2 x 2|Raster|Linien|Rauschen|Atkinson" },
    types.Param.{ .name = "Strength", .german = "Stärke", .kind = types.INT, .low = 0.0, .high = 100.0, .initial = 100.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Keep alpha", .german = "Alpha behalten", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 1.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Colours", .german = "Farben", .kind = types.TEXT, .low = 0.0, .high = 0.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// Number `place` held to its range, the initial value for what is no
// number. (The row comes by value: a slice of the constant table would be
// a copy of all of it in the value arena at every call.)
fn number(params: *const Params, param: types.Param, place: usize) -> f64 {
    const value = params.*.values[place]
    if value != value { return param.initial }
    if value < param.low { return param.low }
    if value > param.high { return param.high }
    return value
}

// A choice: the nearest whole number of its range.
fn whole(params: *const Params, param: types.Param, place: usize) -> usize {
    return @intFromFloat(usize, math.round(number(params, param, place)))
}

// The rectangle decides the result (see the header); nothing around it
// would help.
fn margin(params: *const Params) -> i32 {
    return 0
}

// The filter's text, no longer than there is room for one (files and
// scripts fill in anything).
fn textOf(params: *const Params) -> []const u8 {
    const bytes: [*]const u8 = &params.*.text
    const length = if params.*.textLength > node.TEXT { node.TEXT } else { params.*.textLength }
    return bytes[0..length]
}

fn palettize(params: *const Params, pixels: [*]u32, width: usize, height: usize, stride: usize) -> void {
    const which = whole(params, PARAMS[PALETTE], PALETTE)
    const dither = @intCast(u8, whole(params, PARAMS[DITHER], DITHER))
    const strength = number(params, PARAMS[STRENGTH], STRENGTH) / 100.0
    const keep_alpha = number(params, PARAMS[KEEP_ALPHA], KEEP_ALPHA) >= 0.5
    if which < FROM_TEXT {
        _ = palette.quantizeColors(pixels, width, height, stride, palette.builtinColors(which), dither, strength, keep_alpha)
        return
    }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const colors = scratch.words(pool, TEXT_COLORS)
    if colors != null {
        const found = palette.parseColors(textOf(params), colors.?, TEXT_COLORS)
        if found > 0 { _ = palette.quantizeColors(pixels, width, height, stride, colors.?[0..found], dither, strength, keep_alpha) }
    }
    scratch.release(pool, mark)
}

const FILTERS = [1]types.Info{
    types.Info.{ .id = PALETTIZE, .key = "palettize", .name = "Palettize", .german = "Palettieren", .category = types.MAP, .params = PARAMS[0..], .margin = margin, .apply = palettize },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

pub fn list() -> []const types.Info {
    if kept.address != 0 { return table.rows(types.Info, &kept) }
    return table.keep(types.Info, &kept, FILTERS[0..])
}
