// nebula ui: choosing colours. The widgets the colour docker
// (dockers/color.mlx) and the colour dialog (ui/dialogs.mlx) are made of,
// on the kit (ui/kit.mlx) and std.ui, immediate as they are:
//
//   selector      hue on a ring with saturation and value in a triangle
//                 inside it (one corner the pure hue, one white, one
//                 black), or saturation and value in a square with the
//                 hue in a bar beside it
//   sliders       a slider per channel over a track of the colours it
//                 goes through: red, green, blue, alpha, and hue,
//                 saturation and value, lightness or luma of the model
//                 chosen (HSV, HSL, HSY), each with its number to type
//   hexField      the colour as "#rrggbb" ("#aarrggbb" when translucent)
//   historyRow    the colours used last
//
// A Picker (the caller's memory, init once, release when it goes) keeps
// what lies between frames: the colour shown as hue, saturation and value
// (kept apart from the colour, so that a grey keeps its hue and black its
// saturation while they are set), the image under the selector's marks,
// a drag in progress. Each widget gets the colour it edits (straight
// 0xAARRGGBB, the caller's) and changes it in place; a colour changed
// elsewhere (a palette, a swap) is taken up by the first widget drawn
// after:
//
//     var color = app.*.foreground
//     if colorpicker.selector(k, picker, ID_SELECTOR, box, &color) == colorpicker.PICK_PRIMARY { ... }
//     if colorpicker.sliders(k, picker, ID_SLIDERS, rows, &color) { ... }
//     if color != app.*.foreground { api.setForeground(app, color) }
//
// The selector's image (the ring with the triangle, or the square with
// the bar) is rendered into heap memory of the picker's when its size,
// its shape or the hue changes, and copied onto the canvas each frame;
// only the marks are drawn anew (renders() counts the renderings). Its
// geometry is in window pixels with continuous coordinates (pixel (x, y)
// covers x..x+1); a pointer at pixel (x, y) stands for that pixel's
// middle on the ring and in the triangle, and for the pixel itself in the
// square and the bar, whose first and last pixels are 0 and 1 exactly.
//
// std.ui hands the widgets the left button only. The other button sets
// the other colour (the background while the foreground is edited): the
// caller says in the picker, before each frame, whether it is down and
// where it went down (secondaryDown, secondaryX, secondaryY); a drag of
// it that began on the selector gives PICK_SECONDARY with the colour in
// `secondary`. The caller asks for frames while it lasts (std.ui sees no
// motion of that button: draggingSecondary says so).
//
// Drawing is on the CPU canvas the kit draws on (kit_module.canvasOf);
// a layout pass's canvas of no pixels gets regions and input but no
// pixels, and nothing is rendered for it.
//
// Not done: other selectors of other programs (a hue-saturation disc,
// a "visual" Lab plane), colour management, an eyedropper of its own
// (the colour sampler tool is that).
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("std.ui.keys")
const canvas_module = @import("std.ui.canvas")
const kit_module = @import("./kit.mlx")
const color_module = @import("../core/color.mlx")
const colorsolid = @import("./colorsolid.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")

pub const Allocator = std.allocator.Allocator
pub const Canvas = canvas_module.Canvas
pub const Kit = kit_module.Kit

// The selector's shapes.
pub const SHAPE_RING: u8 = 0
pub const SHAPE_SQUARE: u8 = 1
// The colours of sRGB as a body in space (ui/colorsolid.mlx): OKLab's or
// the sRGB cube, turned by a drag, a colour chosen by a click, cut at a
// lightness by the bar below it.
pub const SHAPE_SOLID: u8 = 2

// The models of the sliders' last three (core/color.mlx's numbers).
pub const MODEL_HSV: u8 = color_module.HSV
pub const MODEL_HSL: u8 = color_module.HSL
pub const MODEL_HSY: u8 = color_module.HSY

// What the selector did in a frame: nothing, the colour edited changed
// (by the left button), the other button chose `secondary`.
pub const PICK_NONE: u8 = 0
pub const PICK_PRIMARY: u8 = 1
pub const PICK_SECONDARY: u8 = 2

// The parts of the selector a press takes hold of.
pub const PART_NONE: u8 = 0
pub const PART_RING: u8 = 1
pub const PART_TRIANGLE: u8 = 2
pub const PART_SQUARE: u8 = 3
pub const PART_BAR: u8 = 4

// The sliders' channels, in their order.
pub const CHANNEL_RED: u8 = 0
pub const CHANNEL_GREEN: u8 = 1
pub const CHANNEL_BLUE: u8 = 2
pub const CHANNEL_ALPHA: u8 = 3
pub const CHANNEL_HUE: u8 = 4
pub const CHANNEL_SATURATION: u8 = 5
// Value, lightness or luma, as the model has it.
pub const CHANNEL_LIGHTNESS: u8 = 6
pub const CHANNELS: usize = 7

// What hexField did: nothing, set the colour typed, could not read what
// was typed (the caller says so).
pub const HEX_NONE: u8 = 0
pub const HEX_SET: u8 = 1
pub const HEX_WRONG: u8 = 2

// The colours a history keeps.
pub const HISTORY: usize = 20

// Sizes, times the theme's scale: the hue bar's width and the gap before
// it; the ring's width at most and at least; the gap between the ring and
// the triangle's corners; a slider row's height, its label's and number's
// widths, its track's height; a history cell at least.
const BAR: i32 = 18
const BAR_GAP: i32 = 8
const RING_MOST: i32 = 26
const RING_LEAST: i32 = 12
const RING_GAP: i32 = 4
const ROW: i32 = 24
const ROW_STEP: i32 = 26
const GROUP_GAP: i32 = 8
const LABEL: i32 = 16
const NUMBER: i32 = 54
const TRACK: i32 = 14
const LEAST_CELL: i32 = 16

// A square or a ring smaller than this (pixels) is not drawn, nor one
// larger than the other (its image would be a block of 4 MiB).
const LEAST_SIDE: i32 = 24
const MOST_SIDE: i32 = 1024

// The 2 pi of a turn.
const TURN: f64 = 6.283185307179586

// The colours a history keeps, the newest first.
pub const History = struct {
    colors: [20]u32
    count: usize
}

// What a picker keeps between frames (init makes it ready; its fields
// are its own but for the three of the secondary button).
pub const Picker = struct {
    allocator: Allocator
    // The colour shown (straight 0xAARRGGBB) as the selector holds it, in
    // HSV, and as the sliders' model holds it (the hue is the same in
    // every model: the hexagon's); all 0..1.
    color: u32
    hue: f64
    saturation: f64
    value: f64
    modelSaturation: f64
    modelLightness: f64
    shape: u8
    model: u8
    // A drag in the selector: the part it holds, whether by the other
    // button, where its press was.
    dragPart: u8
    dragSecondary: bool
    dragPressX: i32
    dragPressY: i32
    // The slider track held in the last frame (view.NONE: none): the
    // click that ends its drag is no new pick.
    heldTrack: u64
    // The other button, as the caller sees it: down now, and where it
    // went down (window pixels). What it chose.
    secondaryDown: bool
    secondaryX: i32
    secondaryY: i32
    secondary: u32
    // The image under the marks (premultiplied, as the canvas): its
    // memory, what it shows, how often one was rendered.
    pixels: [*]u32
    capacity: usize
    imageReady: bool
    imageShape: u8
    imageWidth: i32
    imageHeight: i32
    imageRing: i32
    imageHue: f64
    renders: u64
    // The hex field's text.
    hex: [16]u8
    hexLength: usize
    // The solid shape: the body, whether it is to be drawn again, and the
    // part held (1 the body), whether a press on the body moved (a turn,
    // not a pick) and where the pointer was.
    solid: colorsolid.Solid
    solidDirty: bool
    solidPart: u8
    solidMoved: bool
    solidLastX: i32
    solidLastY: i32
    // The press on the body began with Shift: a fine pick (the chosen
    // place moves a tenth of the pointer's way), not a turn.
    solidFine: bool
}

// Where the selector's parts are, in window pixels. The ring: its middle
// and radii, and the triangle's corners for the hue shown: the pure hue,
// white, black. The square: the square and the bar beside it.
pub const Geometry = struct {
    shape: u8
    // What the selector takes (its region).
    box: ui.Rect
    cx: f64
    cy: f64
    outer: f64
    inner: f64
    hueX: f64
    hueY: f64
    whiteX: f64
    whiteY: f64
    blackX: f64
    blackY: f64
    square: ui.Rect
    bar: ui.Rect
}

// ---------------------------------------------------------------------------
// The picker

// A picker showing `start` (straight), the ring and triangle, the model
// HSV for the sliders. Its image is made at the first frame drawn.
pub fn init(picker: *Picker, allocator: Allocator, start: u32) -> void {
    picker.*.allocator = allocator
    picker.*.hue = 0.0
    picker.*.saturation = 0.0
    picker.*.value = 0.0
    picker.*.modelSaturation = 0.0
    picker.*.modelLightness = 0.0
    picker.*.shape = SHAPE_RING
    picker.*.model = MODEL_HSV
    picker.*.dragPart = PART_NONE
    picker.*.dragSecondary = false
    picker.*.dragPressX = 0
    picker.*.dragPressY = 0
    picker.*.heldTrack = view.NONE
    picker.*.secondaryDown = false
    picker.*.secondaryX = 0
    picker.*.secondaryY = 0
    picker.*.secondary = start
    picker.*.capacity = 0
    picker.*.imageReady = false
    picker.*.imageShape = SHAPE_RING
    picker.*.imageWidth = 0
    picker.*.imageHeight = 0
    picker.*.imageRing = 0
    picker.*.imageHue = 0.0
    picker.*.renders = 0
    picker.*.hexLength = 0
    follow(picker, start)
    colorsolid.init(&picker.*.solid, allocator)
    picker.*.solid.from = colorsolid.OKLAB
    picker.*.solid.to = colorsolid.OKLAB
    picker.*.solidDirty = true
    picker.*.solidPart = 0
    picker.*.solidMoved = false
    picker.*.solidLastX = 0
    picker.*.solidLastY = 0
    picker.*.solidFine = false
}

// Gives back the image's memory (the picker can be drawn again: it makes
// a new one).
pub fn release(picker: *Picker) -> void {
    colorsolid.release(&picker.*.solid)
    if picker.*.capacity != 0 {
        unsafe { picker.*.allocator.free(@ptrCast([*]u8, picker.*.pixels), picker.*.capacity * 4, 16) }
    }
    picker.*.capacity = 0
    picker.*.imageReady = false
}

// How many times the selector's image was rendered (a new size, shape or
// hue; never for a mark that moved).
pub fn renders(picker: *const Picker) -> u64 { return picker.*.renders }

// Whether a drag of the other button is under way (the caller asks for
// frames meanwhile: std.ui sees no motion of that button).
pub fn draggingSecondary(picker: *const Picker) -> bool { return picker.*.dragSecondary }

// The selector's shape (SHAPE_RING, SHAPE_SQUARE; another is the ring).
pub fn setShape(picker: *Picker, shape: u8) -> void {
    picker.*.shape = if shape == SHAPE_SQUARE || shape == SHAPE_SOLID { shape } else { SHAPE_RING }
}

// The sliders' model (MODEL_HSV, MODEL_HSL, MODEL_HSY; another is HSV).
pub fn setModel(picker: *Picker, model: u8) -> void {
    picker.*.model = if model == MODEL_HSL || model == MODEL_HSY { model } else { MODEL_HSV }
    followModel(picker, picker.*.color)
}

// Whether the model's saturation shows in a colour of lightness `light`
// (for black, in HSL and HSY also for white, any saturation is the same
// colour: the one there is kept).
fn saturationShows(model: u8, light: f64) -> bool {
    if model == MODEL_HSV { return light > 1.0e-9 }
    return light > 1.0e-9 && light < 1.0 - 1.0e-9
}

// The model's saturation and lightness of `shown` (the hue is the
// picker's).
fn followModel(picker: *Picker, shown: u32) -> void {
    if picker.*.model == MODEL_HSV {
        picker.*.modelSaturation = picker.*.saturation
        picker.*.modelLightness = picker.*.value
        return
    }
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    color_module.toRgb(shown, &r, &g, &b)
    color_module.rgbToModel(picker.*.model, r, g, b, &h, &s, &l)
    if saturationShows(picker.*.model, l) { picker.*.modelSaturation = s }
    picker.*.modelLightness = l
}

// The picker shows `shown`, a colour set elsewhere: its hue, saturation
// and value, but a grey keeps the hue there was, black the saturation.
pub fn follow(picker: *Picker, shown: u32) -> void {
    picker.*.color = shown
    var h: f64 = 0.0
    var s: f64 = 0.0
    var v: f64 = 0.0
    color_module.toHsv(shown, &h, &s, &v)
    const r = pixel.red(shown)
    const g = pixel.green(shown)
    const b = pixel.blue(shown)
    if r != g || g != b { picker.*.hue = h }
    if saturationShows(MODEL_HSV, v) { picker.*.saturation = s }
    picker.*.value = v
    followModel(picker, shown)
}

// The colour edited, as the caller has it now: taken up when it changed
// elsewhere (not while the other button drags: the picker shows that).
fn sync(picker: *Picker, target: *u32) -> void {
    if picker.*.dragSecondary && !picker.*.secondaryDown {
        picker.*.dragSecondary = false
        picker.*.dragPart = PART_NONE
    }
    if !picker.*.dragSecondary && target.* != picker.*.color { follow(picker, target.*) }
}

// The selector's hue, saturation and value made the colour (its alpha
// kept); the sliders' model follows.
fn fromSelector(picker: *Picker) -> u32 {
    const made = color_module.fromHsv(picker.*.hue, picker.*.saturation, picker.*.value, pixel.alpha(picker.*.color))
    picker.*.color = made
    followModel(picker, made)
    return made
}

// The model's hue, saturation and lightness made the colour; the
// selector's saturation and value follow (the hue is the same).
fn fromModel(picker: *Picker) -> u32 {
    if picker.*.model == MODEL_HSV {
        picker.*.saturation = picker.*.modelSaturation
        picker.*.value = picker.*.modelLightness
        return fromSelector(picker)
    }
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    color_module.modelToRgb(picker.*.model, picker.*.hue, picker.*.modelSaturation, picker.*.modelLightness, &r, &g, &b)
    const made = color_module.fromRgb(r, g, b, pixel.alpha(picker.*.color))
    picker.*.color = made
    var h: f64 = 0.0
    var s: f64 = 0.0
    var v: f64 = 0.0
    color_module.toHsv(made, &h, &s, &v)
    if saturationShows(MODEL_HSV, v) { picker.*.saturation = s }
    picker.*.value = v
    return made
}

// ---------------------------------------------------------------------------
// The history

// `used` becomes the newest colour of `history` (where it was before it
// is no more; the oldest goes when there are HISTORY).
pub fn remember(history: *History, used: u32) -> void {
    // (A count beyond what the record holds is taken for a full one.)
    if history.*.count > HISTORY { history.*.count = HISTORY }
    var at: usize = 0
    while at < history.*.count && history.*.colors[at] != used { at += 1 }
    if at == history.*.count {
        if history.*.count < HISTORY { history.*.count += 1 }
        at = history.*.count - 1
    }
    while at > 0 {
        history.*.colors[at] = history.*.colors[at - 1]
        at -= 1
    }
    history.*.colors[0] = used
}

// ---------------------------------------------------------------------------
// Geometry

fn scaled(s: i32, value: i32) -> i32 { return value * s }

// How tall the selector is for `width` in `shape`: the ring a square of
// the width, the square that less the bar beside it (0 when nothing is
// left; a scale below 1 counts as 1, as in geometry).
pub fn selectorHeight(width: i32, shape: u8, scale: i32) -> i32 {
    if width <= 0 { return 0 }
    const s = if scale > 0 { scale } else { 1 }
    // (The body as the square: its bar beside it.)
    if shape == SHAPE_SQUARE || shape == SHAPE_SOLID {
        const side = width - scaled(s, BAR + BAR_GAP)
        return if side > 0 { side } else { 0 }
    }
    return width
}

fn ringWidth(outer: f64, s: i32) -> f64 {
    const wanted = outer * 0.17
    return math.clamp(wanted, @floatFromInt(f64, scaled(s, RING_LEAST)), @floatFromInt(f64, scaled(s, RING_MOST)))
}

// The selector's parts in `box` for `shape` and the hue `hue` (0..1):
// the ring the largest that fits, in the middle across; the square as
// tall as the box, with the bar beside it. A box with no room for a
// square gives an empty box and square.
pub fn geometry(box: ui.Rect, shape: u8, hue: f64, scale: i32) -> Geometry {
    var made = Geometry.{ .shape = shape, .box = box, .cx = 0.0, .cy = 0.0, .outer = 0.0, .inner = 0.0, .hueX = 0.0, .hueY = 0.0, .whiteX = 0.0, .whiteY = 0.0, .blackX = 0.0, .blackY = 0.0, .square = ui.rect(0, 0, 0, 0), .bar = ui.rect(0, 0, 0, 0) }
    const s = if scale > 0 { scale } else { 1 }
    if shape == SHAPE_SQUARE {
        const bar = scaled(s, BAR)
        const gap = scaled(s, BAR_GAP)
        var side = box.width - bar - gap
        if side > box.height { side = box.height }
        if side <= 0 {
            made.box = ui.rect(box.x, box.y, 0, 0)
            return made
        }
        const left = box.x + (box.width - side - gap - bar) / 2
        made.square = ui.rect(left, box.y, side, side)
        made.bar = ui.rect(left + side + gap, box.y, bar, side)
        made.box = ui.rect(left, box.y, side + gap + bar, side)
        return made
    }
    const side = if box.width < box.height { box.width } else { box.height }
    const left = box.x + (box.width - side) / 2
    made.box = ui.rect(left, box.y, side, side)
    const half = @floatFromInt(f64, side) / 2.0
    made.cx = @floatFromInt(f64, left) + half
    made.cy = @floatFromInt(f64, box.y) + half
    made.outer = half - 0.5
    made.inner = made.outer - ringWidth(made.outer, s)
    const corner = made.inner - @floatFromInt(f64, scaled(s, RING_GAP))
    const angle = hue * TURN
    made.hueX = made.cx + corner * math.cos(angle)
    made.hueY = made.cy - corner * math.sin(angle)
    made.whiteX = made.cx + corner * math.cos(angle + TURN / 3.0)
    made.whiteY = made.cy - corner * math.sin(angle + TURN / 3.0)
    made.blackX = made.cx + corner * math.cos(angle + 2.0 * TURN / 3.0)
    made.blackY = made.cy - corner * math.sin(angle + 2.0 * TURN / 3.0)
    return made
}

// The hue of the place (x, y) on the ring: its angle about the middle,
// counter-clockwise from the right (red).
fn hueAround(geo: *const Geometry, x: f64, y: f64) -> f64 {
    var turns = math.atan2(geo.*.cy - y, x - geo.*.cx) / TURN
    if turns < 0.0 { turns += 1.0 }
    if !(turns >= 0.0 && turns < 1.0) { turns = 0.0 }
    return turns
}

// The saturation and value of the place (x, y) of the triangle: its
// weights between the corners (pure hue, white, black), the value their
// first two together, the saturation the hue's share of that; a place
// outside is held to the nearest edge that way. A place with no value
// keeps the saturation (`s` as it was).
pub fn triangleAt(geo: *const Geometry, x: f64, y: f64, s: *f64, v: *f64) -> void {
    const ax = geo.*.hueX
    const ay = geo.*.hueY
    const bx = geo.*.whiteX
    const by = geo.*.whiteY
    const cx = geo.*.blackX
    const cy = geo.*.blackY
    const denominator = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy)
    if !(denominator > 1.0e-9 || denominator < -1.0e-9) { return }
    const weight_hue = ((by - cy) * (x - cx) + (cx - bx) * (y - cy)) / denominator
    const weight_white = ((cy - ay) * (x - cx) + (ax - cx) * (y - cy)) / denominator
    const lit = weight_hue + weight_white
    v.* = math.clamp(lit, 0.0, 1.0)
    if lit > 1.0e-9 { s.* = math.clamp(weight_hue / lit, 0.0, 1.0) }
}

// The place of saturation `s` and value `v` in the triangle.
pub fn trianglePlace(geo: *const Geometry, s: f64, v: f64, x: *f64, y: *f64) -> void {
    const lit_x = geo.*.whiteX + s * (geo.*.hueX - geo.*.whiteX)
    const lit_y = geo.*.whiteY + s * (geo.*.hueY - geo.*.whiteY)
    x.* = geo.*.blackX + v * (lit_x - geo.*.blackX)
    y.* = geo.*.blackY + v * (lit_y - geo.*.blackY)
}

// `offset` pixels along a side of `length` pixels as 0..1: the first
// pixel 0, the last 1.
fn along(offset: i32, length: i32) -> f64 {
    if length <= 1 { return 0.0 }
    return math.clamp(@floatFromInt(f64, offset) / @floatFromInt(f64, length - 1), 0.0, 1.0)
}

// The part of the selector a press at pixel (x, y) takes hold of.
pub fn partAt(geo: *const Geometry, x: i32, y: i32) -> u8 {
    if geo.*.shape == SHAPE_SQUARE {
        const middle = ui.right(geo.*.square) + (geo.*.bar.x - ui.right(geo.*.square)) / 2
        return if x < middle { PART_SQUARE } else { PART_BAR }
    }
    const dx = @floatFromInt(f64, x) + 0.5 - geo.*.cx
    const dy = @floatFromInt(f64, y) + 0.5 - geo.*.cy
    // (Within a pixel of the ring counts as the ring.)
    return if @sqrt(dx * dx + dy * dy) >= geo.*.inner - 1.0 { PART_RING } else { PART_TRIANGLE }
}

// The pointer at pixel (x, y) moves `part`: the picker's hue, or its
// saturation and value, from that place. True when one of them changed.
fn pick(picker: *Picker, geo: *const Geometry, part: u8, x: i32, y: i32) -> bool {
    const hue = picker.*.hue
    const saturation = picker.*.saturation
    const value = picker.*.value
    const fx = @floatFromInt(f64, x) + 0.5
    const fy = @floatFromInt(f64, y) + 0.5
    if part == PART_RING {
        picker.*.hue = hueAround(geo, fx, fy)
    } else if part == PART_TRIANGLE {
        triangleAt(geo, fx, fy, &picker.*.saturation, &picker.*.value)
    } else if part == PART_SQUARE {
        picker.*.saturation = along(x - geo.*.square.x, geo.*.square.width)
        picker.*.value = 1.0 - along(y - geo.*.square.y, geo.*.square.height)
    } else if part == PART_BAR {
        picker.*.hue = along(y - geo.*.bar.y, geo.*.bar.height)
    } else {
        return false
    }
    return picker.*.hue != hue || picker.*.saturation != saturation || picker.*.value != value
}

// ---------------------------------------------------------------------------
// The image

// A channel of 0..1 times a coverage of 0..1 as a byte.
fn shadeByte(channel: f64, coverage: f64) -> u32 {
    return color_module.toByte(channel * coverage)
}

// The premultiplied pixel of straight channels at `coverage` (0..1).
fn covered(r: f64, g: f64, b: f64, coverage: f64) -> u32 {
    if !(coverage > 0.0) { return 0 }
    if coverage >= 1.0 { return pixel.pack(255, color_module.toByte(r), color_module.toByte(g), color_module.toByte(b)) }
    return pixel.pack(color_module.toByte(coverage), shadeByte(r, coverage), shadeByte(g, coverage), shadeByte(b, coverage))
}

fn unit(value: f64) -> f64 {
    if !(value > 0.0) { return 0.0 }
    return if value > 1.0 { 1.0 } else { value }
}

// The triangle's pixels of the image (ring shape): the inner disc
// rendered anew, the ring left as it is.
fn renderTriangle(picker: *Picker, geo: *const Geometry) -> void {
    const width = picker.*.imageWidth
    const pixels = picker.*.pixels
    const left = @floatFromInt(f64, geo.*.box.x)
    const top = @floatFromInt(f64, geo.*.box.y)
    // The corners in the image's coordinates.
    const ax = geo.*.hueX - left
    const ay = geo.*.hueY - top
    const bx = geo.*.whiteX - left
    const by = geo.*.whiteY - top
    const cx = geo.*.blackX - left
    const cy = geo.*.blackY - top
    const mx = geo.*.cx - left
    const my = geo.*.cy - top
    var hue_r: f64 = 0.0
    var hue_g: f64 = 0.0
    var hue_b: f64 = 0.0
    color_module.hsvToRgb(picker.*.hue, 1.0, 1.0, &hue_r, &hue_g, &hue_b)
    const denominator = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy)
    // What a weight of 1 is in pixels of distance from the edge opposite
    // its corner (the triangle's height there): a weight times it is how
    // far inside that edge a place is.
    const height_hue = heightOver(@sqrt((bx - cx) * (bx - cx) + (by - cy) * (by - cy)), denominator)
    const height_white = heightOver(@sqrt((ax - cx) * (ax - cx) + (ay - cy) * (ay - cy)), denominator)
    const height_black = heightOver(@sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by)), denominator)
    const reach = geo.*.inner - 1.0
    const degenerate = !(denominator > 1.0e-9 || denominator < -1.0e-9)
    // (The weights' factors of x, and below their parts of a row, worked
    // out once: the same numbers as written out per pixel.)
    const hue_across = by - cy
    const white_across = cy - ay
    var row = @intFromFloat(i32, math.max(my - reach, 0.0))
    const row_end = @intFromFloat(i32, math.min(my + reach + 1.0, @floatFromInt(f64, picker.*.imageHeight)))
    while row < row_end {
        const y = @floatFromInt(f64, row) + 0.5
        const line = @intCast(usize, row) * @intCast(usize, width)
        const hue_down = (cx - bx) * (y - cy)
        const white_down = (ax - cx) * (y - cy)
        var column = @intFromFloat(i32, math.max(mx - reach, 0.0))
        const column_end = @intFromFloat(i32, math.min(mx + reach + 1.0, @floatFromInt(f64, width)))
        while column < column_end {
            const x = @floatFromInt(f64, column) + 0.5
            const dx = x - mx
            const dy = y - my
            if dx * dx + dy * dy < reach * reach {
                var shade: u32 = 0
                if !degenerate {
                    const weight_hue = (hue_across * (x - cx) + hue_down) / denominator
                    const weight_white = (white_across * (x - cx) + white_down) / denominator
                    const weight_black = 1.0 - weight_hue - weight_white
                    // How far the pixel's middle is inside the nearest
                    // edge: its coverage.
                    const inside = math.min(math.min(weight_hue * height_hue, weight_white * height_white), weight_black * height_black)
                    const coverage = unit(inside + 0.5)
                    if coverage > 0.0 {
                        const h = unit(weight_hue)
                        const w = unit(weight_white)
                        const k = unit(weight_black)
                        const sum = h + w + k
                        const hn = if sum > 0.0 { h / sum } else { 0.0 }
                        const wn = if sum > 0.0 { w / sum } else { 0.0 }
                        shade = covered(wn + hn * hue_r, wn + hn * hue_g, wn + hn * hue_b, coverage)
                    }
                }
                pixels[line + @intCast(usize, column)] = shade
            }
            column += 1
        }
        row += 1
    }
}

// The distance of a corner from the edge opposite it, `edge` long, in a
// triangle of twice the area |denominator|: what a weight of 1 is in
// pixels.
fn heightOver(edge: f64, denominator: f64) -> f64 {
    if edge < 1.0e-9 { return 0.0 }
    return math.abs(denominator) / edge
}

// The ring's pixels (all of the image: the triangle follows).
fn renderRing(picker: *Picker, geo: *const Geometry) -> void {
    const width = picker.*.imageWidth
    const height = picker.*.imageHeight
    const pixels = picker.*.pixels
    const mx = geo.*.cx - @floatFromInt(f64, geo.*.box.x)
    const my = geo.*.cy - @floatFromInt(f64, geo.*.box.y)
    const outer = geo.*.outer
    const inner = geo.*.inner
    var row: i32 = 0
    while row < height {
        const y = @floatFromInt(f64, row) + 0.5
        const line = @intCast(usize, row) * @intCast(usize, width)
        var column: i32 = 0
        while column < width {
            const x = @floatFromInt(f64, column) + 0.5
            const dx = x - mx
            const dy = y - my
            const distance = @sqrt(dx * dx + dy * dy)
            const coverage = unit(outer + 0.5 - distance) * unit(distance - inner + 0.5)
            var shade: u32 = 0
            if coverage > 0.0 {
                var turns = math.atan2(-dy, dx) / TURN
                if turns < 0.0 { turns += 1.0 }
                var r: f64 = 0.0
                var g: f64 = 0.0
                var b: f64 = 0.0
                color_module.hsvToRgb(turns, 1.0, 1.0, &r, &g, &b)
                shade = covered(r, g, b, coverage)
            }
            pixels[line + @intCast(usize, column)] = shade
            column += 1
        }
        row += 1
    }
}

// The pixel of a rounded rectangle `width` x `height` with corners of
// `radius` at (column, row) inside it, of straight channels: opaque but
// at the corners (ui.roundedCoverage is 255 everywhere else, and asked
// only there).
fn roundedShade(column: i32, row: i32, width: i32, height: i32, radius: i32, r: f64, g: f64, b: f64) -> u32 {
    if (column >= radius && column < width - radius) || (row >= radius && row < height - radius) {
        return pixel.pack(255, color_module.toByte(r), color_module.toByte(g), color_module.toByte(b))
    }
    const coverage = ui.roundedCoverage(column, row, width, height, radius)
    if coverage == 0 { return 0 }
    return covered(r, g, b, @floatFromInt(f64, coverage) / 255.0)
}

// The square and the bar (square shape): all of the image. A square's
// pixel is hsvToRgb's colour of the hue, its column's saturation and its
// row's value: hsvToRgb makes it as the value times the colour of that
// saturation at value 1, so that colour is worked out once a column (in
// scratch memory) and only multiplied here, to the same bits. False
// without scratch memory.
fn renderSquare(picker: *Picker, geo: *const Geometry, s: i32) -> bool {
    const width = picker.*.imageWidth
    const height = picker.*.imageHeight
    const pixels = picker.*.pixels
    const square = geo.*.square
    const bar = geo.*.bar
    const radius = scaled(s, 3)
    const side = @intCast(usize, square.width)
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const taken = scratch.doubles(pool, 3 * side)
    if taken == null {
        scratch.release(pool, mark)
        return false
    }
    const full = taken.?
    var column: i32 = 0
    while column < square.width {
        const at = 3 * @intCast(usize, column)
        var r: f64 = 0.0
        var g: f64 = 0.0
        var b: f64 = 0.0
        color_module.hsvToRgb(picker.*.hue, along(column, square.width), 1.0, &r, &g, &b)
        full[at] = r
        full[at + 1] = g
        full[at + 2] = b
        column += 1
    }
    const bar_left = bar.x - geo.*.box.x
    var row: i32 = 0
    while row < height {
        const line = @intCast(usize, row) * @intCast(usize, width)
        const value = 1.0 - along(row, square.height)
        column = 0
        while column < square.width {
            const at = 3 * @intCast(usize, column)
            pixels[line + @intCast(usize, column)] = roundedShade(column, row, square.width, square.height, radius, value * full[at], value * full[at + 1], value * full[at + 2])
            column += 1
        }
        while column < bar_left {
            pixels[line + @intCast(usize, column)] = 0
            column += 1
        }
        var r: f64 = 0.0
        var g: f64 = 0.0
        var b: f64 = 0.0
        color_module.hsvToRgb(along(row, bar.height), 1.0, 1.0, &r, &g, &b)
        while column < width {
            pixels[line + @intCast(usize, column)] = roundedShade(column - bar_left, row, bar.width, bar.height, radius, r, g, b)
            column += 1
        }
        row += 1
    }
    scratch.release(pool, mark)
    return true
}

// The image right for `geo` and the picker's hue: rendered when its
// shape, size or hue changed (a ring whose size stayed has only its
// triangle rendered for a new hue). False without memory (nothing is
// drawn then; the next frame tries again).
fn prepareImage(picker: *Picker, geo: *const Geometry, s: i32) -> bool {
    const width = geo.*.box.width
    const height = geo.*.box.height
    if width < LEAST_SIDE || height < LEAST_SIDE || width > MOST_SIDE || height > MOST_SIDE { return false }
    // (The ring's width tells two rings of one size apart: another scale.)
    const ring = @intFromFloat(i32, (geo.*.outer - geo.*.inner) * 64.0)
    const same_size = picker.*.imageReady && picker.*.imageShape == geo.*.shape && picker.*.imageWidth == width && picker.*.imageHeight == height && picker.*.imageRing == ring
    if same_size && picker.*.imageHue == picker.*.hue { return true }
    const wanted = @intCast(usize, width) * @intCast(usize, height)
    if wanted > picker.*.capacity {
        release(picker)
        const memory = picker.*.allocator.alloc(wanted * 4, 16)
        if memory == null { return false }
        unsafe { picker.*.pixels = @ptrCast([*]u32, memory.?) }
        picker.*.capacity = wanted
    }
    picker.*.imageShape = geo.*.shape
    picker.*.imageWidth = width
    picker.*.imageHeight = height
    picker.*.imageRing = ring
    picker.*.imageHue = picker.*.hue
    if geo.*.shape == SHAPE_SQUARE {
        if !renderSquare(picker, geo, s) {
            picker.*.imageReady = false
            return false
        }
    } else {
        if !same_size { renderRing(picker, geo) }
        renderTriangle(picker, geo)
    }
    picker.*.imageReady = true
    picker.*.renders += 1
    return true
}

// The image onto `canvas` at its box: opaque pixels stored, the edges'
// mixed, what is outside the canvas left out.
fn blit(canvas: *Canvas, picker: *Picker, geo: *const Geometry) -> void {
    const width = picker.*.imageWidth
    const height = picker.*.imageHeight
    const left = geo.*.box.x
    const top = geo.*.box.y
    const canvas_width = @intCast(i32, canvas.*.width)
    const canvas_height = @intCast(i32, canvas.*.height)
    const opacity = canvas.*.opacity
    const direct = opacity >= 255 && !canvas.*.swapRedBlue
    const pixels = picker.*.pixels
    var row: i32 = if top < 0 { -top } else { 0 }
    while row < height && top + row < canvas_height {
        const line = @intCast(usize, top + row) * canvas.*.stride
        const source = @intCast(usize, row) * @intCast(usize, width)
        var column: i32 = if left < 0 { -left } else { 0 }
        while column < width && left + column < canvas_width {
            const shade = pixels[source + @intCast(usize, column)]
            if shade != 0 {
                if direct {
                    const at = line + @intCast(usize, left + column)
                    canvas.*.pixels[at] = if shade >> 24 == 255 { shade } else { canvas_module.over(canvas.*.pixels[at], shade, 255) }
                } else {
                    canvas_module.blend(canvas, left + column, top + row, shade, opacity)
                }
            }
            column += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// The marks

fn markDark() -> u32 { return canvas_module.color(210, 0, 0, 0) }

// A ring mark about pixel (x, y): dark, white, dark, seen on any colour.
fn drawDot(canvas: *Canvas, x: i32, y: i32, s: i32) -> void {
    canvas_module.strokeRoundedRect(canvas, x - 7 * s, y - 7 * s, 15 * s, 15 * s, 7 * s + 1, s, markDark())
    canvas_module.strokeRoundedRect(canvas, x - 6 * s, y - 6 * s, 13 * s, 13 * s, 6 * s + 1, 2 * s, 0xFFFFFFFF)
    canvas_module.strokeRoundedRect(canvas, x - 4 * s, y - 4 * s, 9 * s, 9 * s, 4 * s + 1, s, markDark())
}

fn drawMarks(canvas: *Canvas, picker: *Picker, geo: *const Geometry, s: i32) -> void {
    if geo.*.shape == SHAPE_SQUARE {
        const square = geo.*.square
        const x = square.x + @intFromFloat(i32, picker.*.saturation * @floatFromInt(f64, square.width - 1) + 0.5)
        const y = square.y + @intFromFloat(i32, (1.0 - picker.*.value) * @floatFromInt(f64, square.height - 1) + 0.5)
        drawDot(canvas, x, y, s)
        const bar = geo.*.bar
        const at = bar.y + @intFromFloat(i32, picker.*.hue * @floatFromInt(f64, bar.height - 1) + 0.5)
        canvas_module.strokeRoundedRect(canvas, bar.x - 3 * s, at - 4 * s, bar.width + 6 * s, 9 * s, 3 * s, s, markDark())
        canvas_module.strokeRoundedRect(canvas, bar.x - 2 * s, at - 3 * s, bar.width + 4 * s, 7 * s, 2 * s, 2 * s, 0xFFFFFFFF)
        return
    }
    // The hue: a bar across the ring.
    const angle = picker.*.hue * TURN
    const c = math.cos(angle)
    const n = -math.sin(angle)
    const from = geo.*.inner + 1.5
    const to = geo.*.outer - 1.5
    const weight = @floatFromInt(f64, s)
    kit_module.line(canvas, geo.*.cx + c * from, geo.*.cy + n * from, geo.*.cx + c * to, geo.*.cy + n * to, markDark(), 5.0 * weight)
    kit_module.line(canvas, geo.*.cx + c * from, geo.*.cy + n * from, geo.*.cx + c * to, geo.*.cy + n * to, 0xFFFFFFFF, 2.5 * weight)
    var x: f64 = 0.0
    var y: f64 = 0.0
    trianglePlace(geo, picker.*.saturation, picker.*.value, &x, &y)
    drawDot(canvas, @intFromFloat(i32, @floor(x)), @intFromFloat(i32, @floor(y)), s)
}

// ---------------------------------------------------------------------------
// The selector

// The selector in `box` (as wide as it is; selectorHeight tall): the ring
// and triangle or the square and bar of the picker's shape, the marks of
// the colour edited (`target`, the caller's, straight). Pressing or
// dragging in it sets the hue (ring, bar) or the saturation and value
// (triangle, square) continuously: PICK_PRIMARY in the frames `target`
// changed. The other button (see the header) gives PICK_SECONDARY with
// the colour in the picker's `secondary`.
pub fn selector(kit: *Kit, picker: *Picker, id: u64, box: ui.Rect, target: *u32) -> u8 {
    sync(picker, target)
    if picker.*.shape == SHAPE_SOLID { return solidSelector(kit, picker, id, box, target) }
    const context = kit.*.ui
    const s = kit.*.theme.*.scale
    var geo = geometry(box, picker.*.shape, picker.*.hue, s)
    view.region(context, id, geo.box)
    var result = PICK_NONE
    const held = view.isPressed(context, id) && context.*.pointerDown && kit.*.disabledDepth == 0
    if held {
        // A new press: the part under it is held until it is let go.
        if picker.*.dragPart == PART_NONE || picker.*.dragSecondary || picker.*.dragPressX != context.*.pressX || picker.*.dragPressY != context.*.pressY {
            picker.*.dragPart = partAt(&geo, context.*.pressX, context.*.pressY)
            picker.*.dragSecondary = false
            picker.*.dragPressX = context.*.pressX
            picker.*.dragPressY = context.*.pressY
        }
        if pick(picker, &geo, picker.*.dragPart, context.*.pointerX, context.*.pointerY) {
            target.* = fromSelector(picker)
            result = PICK_PRIMARY
        }
    } else if view.takeClick(context, id) {
        // Pressed and let go between two frames: what the press would
        // have done; the end of a drag that was seen is no new pick.
        if picker.*.dragPart == PART_NONE && kit.*.disabledDepth == 0 && pick(picker, &geo, partAt(&geo, context.*.pressX, context.*.pressY), context.*.pressX, context.*.pressY) {
            target.* = fromSelector(picker)
            result = PICK_PRIMARY
        }
        picker.*.dragPart = PART_NONE
    } else if picker.*.secondaryDown && kit.*.disabledDepth == 0 && (picker.*.dragSecondary || ui.contains(view.areaOf(context, id), picker.*.secondaryX, picker.*.secondaryY)) {
        if !picker.*.dragSecondary {
            picker.*.dragSecondary = true
            picker.*.dragPart = partAt(&geo, picker.*.secondaryX, picker.*.secondaryY)
            // (A press that began elsewhere in the picker's colour does
            // not count: the secondary starts from the colour shown.)
            picker.*.secondary = picker.*.color
        }
        if pick(picker, &geo, picker.*.dragPart, context.*.pointerX, context.*.pointerY) {
            const made = color_module.fromHsv(picker.*.hue, picker.*.saturation, picker.*.value, pixel.alpha(picker.*.color))
            picker.*.color = made
            followModel(picker, made)
            picker.*.secondary = made
            result = PICK_SECONDARY
        }
    } else if !picker.*.dragSecondary {
        picker.*.dragPart = PART_NONE
    }
    // (The triangle turns with the hue: its corners anew.)
    geo = geometry(box, picker.*.shape, picker.*.hue, s)
    const canvas = kit_module.canvasOf(kit)
    if canvas.*.device != 0 || canvas.*.width == 0 || canvas.*.height == 0 { return result }
    if !prepareImage(picker, &geo, s) { return result }
    blit(canvas, picker, &geo)
    drawMarks(canvas, picker, &geo, s)
    return result
}

// The solid shape: the body (a square), beside it the bar that cuts it
// at an OKLab lightness (white at the top: the whole body), in its corner
// the button that switches the space.
fn solidSelector(kit: *Kit, picker: *Picker, id: u64, box: ui.Rect, target: *u32) -> u8 {
    const context = kit.*.ui
    const s = kit.*.theme.*.scale
    const strip = scaled(s, BAR)
    var side = box.width - strip - scaled(s, BAR_GAP)
    if side > box.height { side = box.height }
    if side < 16 { return PICK_NONE }
    const body = ui.rect(box.x, box.y, side, side)
    const bar = ui.rect(box.x + side + scaled(s, BAR_GAP), box.y, strip, side)
    const toggle = ui.rect(box.x, box.y, scaled(s, 52), scaled(s, 20))
    const bar_id = view.idOf(id, 1)
    const solid = &picker.*.solid
    const enabled = kit.*.disabledDepth == 0
    var result = PICK_NONE
    view.region(context, id, body)
    view.region(context, bar_id, bar)
    // The body: a drag turns it, a click (a press let go where it was)
    // chooses the colour exactly under it (colorsolid.pickAt), and with
    // Shift a drag chooses as it goes, the place a tenth of the pointer's
    // way from where it was pressed (ten times finer than a pixel).
    if enabled && view.isPressed(context, id) && context.*.pointerDown {
        if picker.*.solidPart != 1 || picker.*.dragPressX != context.*.pressX || picker.*.dragPressY != context.*.pressY {
            picker.*.solidPart = 1
            picker.*.solidMoved = false
            picker.*.solidFine = kit.*.modifiers & keys.SHIFT != 0
            picker.*.dragPressX = context.*.pressX
            picker.*.dragPressY = context.*.pressY
            picker.*.solidLastX = context.*.pressX
            picker.*.solidLastY = context.*.pressY
        }
        const away_x = context.*.pointerX - context.*.pressX
        const away_y = context.*.pointerY - context.*.pressY
        if away_x > 3 || away_x < -3 || away_y > 3 || away_y < -3 { picker.*.solidMoved = true }
        if picker.*.solidFine {
            const fine_x = @floatFromInt(f64, context.*.pressX - body.x) + 0.5 + @floatFromInt(f64, away_x) / 10.0
            const fine_y = @floatFromInt(f64, context.*.pressY - body.y) + 0.5 + @floatFromInt(f64, away_y) / 10.0
            var fine: u32 = 0
            if colorsolid.pickAt(solid, fine_x, fine_y, &fine) {
                const made = pixel.withAlpha(fine, pixel.alpha(target.*))
                if made != target.* {
                    follow(picker, made)
                    target.* = made
                    result = PICK_PRIMARY
                }
            }
        } else if picker.*.solidMoved && (context.*.pointerX != picker.*.solidLastX || context.*.pointerY != picker.*.solidLastY) {
            colorsolid.turn(solid, context.*.pointerX - picker.*.solidLastX, context.*.pointerY - picker.*.solidLastY)
            picker.*.solidLastX = context.*.pointerX
            picker.*.solidLastY = context.*.pointerY
            picker.*.solidDirty = true
        }
    } else if view.takeClick(context, id) {
        if enabled && !(picker.*.solidPart == 1 && (picker.*.solidMoved || picker.*.solidFine)) {
            var chosen: u32 = 0
            if colorsolid.pick(solid, context.*.pressX - body.x, context.*.pressY - body.y, &chosen) {
                const made = pixel.withAlpha(chosen, pixel.alpha(target.*))
                follow(picker, made)
                target.* = made
                result = PICK_PRIMARY
            }
        }
        picker.*.solidPart = 0
    } else if picker.*.solidPart == 1 {
        picker.*.solidPart = 0
    }
    // The bar: where it is pressed, the cut (its right end: the whole body).
    var cut_at: i32 = -1
    if enabled && view.isPressed(context, bar_id) && context.*.pointerDown { cut_at = context.*.pointerY }
    if enabled && view.takeClick(context, bar_id) { cut_at = context.*.pressY }
    if cut_at >= 0 && bar.height > 0 {
        var cut = 1.0 - @floatFromInt(f64, cut_at - bar.y) / @floatFromInt(f64, bar.height)
        if cut < 0.05 { cut = 0.05 }
        if cut > 0.98 { cut = 1.0 }
        if cut != solid.*.cut {
            solid.*.cut = cut
            picker.*.solidDirty = true
        }
    }
    // The button: OKLab's body or the sRGB cube.
    const oklab = solid.*.to == colorsolid.OKLAB
    const toggle_id = view.idOf(id, 2)
    if kit_module.button(kit, toggle_id, toggle, if oklab { "OKLab" } else { "sRGB" }, kit_module.BUTTON_NORMAL) {
        const space = if oklab { colorsolid.SRGB } else { colorsolid.OKLAB }
        solid.*.from = space
        solid.*.to = space
        picker.*.solidDirty = true
    }
    kit_module.tooltip(kit, toggle_id, toggle, if oklab { "OKLab body (click: the sRGB cube)" } else { "sRGB cube (click: the OKLab body)" })
    // (The colour edited is marked over the body, below: the body is not
    // drawn again for it.)
    solid.*.hasMark = false
    const canvas = kit_module.canvasOf(kit)
    if canvas.*.device != 0 || canvas.*.width == 0 || canvas.*.height == 0 { return result }
    // Sharp (four samples a pixel) when still, plain while it turns.
    const wanted = if picker.*.solidPart == 1 && picker.*.solidMoved && !picker.*.solidFine { 1 } else { 2 }
    if wanted != solid.*.supersample {
        solid.*.supersample = wanted
        picker.*.solidDirty = true
    }
    if picker.*.solidDirty || solid.*.width != side || solid.*.height != side {
        if !colorsolid.render(solid, side, side) { return result }
        picker.*.solidDirty = false
        picker.*.renders += 1
    }
    // The body onto the canvas (straight pixels, their edge translucent).
    const shown = colorsolid.pixels(solid)
    const opacity = canvas.*.opacity
    var row: i32 = 0
    while row < side {
        var column: i32 = 0
        while column < side {
            const value = shown[@intCast(usize, row) * @intCast(usize, side) + @intCast(usize, column)]
            // (Not over the button in the corner, drawn before.)
            const under_button = column < toggle.width && row < toggle.height
            if value >> 24 != 0 && !under_button { canvas_module.blend(canvas, body.x + column, body.y + row, pixel.premultiplied(value), opacity) }
            column += 1
        }
        row += 1
    }
    // A ring where the colour edited lies.
    var place_x: f64 = 0.0
    var place_y: f64 = 0.0
    if colorsolid.placeOf(solid, target.*, &place_x, &place_y) {
        const ring_x = body.x + @intFromFloat(i32, place_x)
        const ring_y = body.y + @intFromFloat(i32, place_y)
        const outer = scaled(s, 9)
        const inner = scaled(s, 7)
        canvas_module.strokeRoundedRect(canvas, ring_x - outer, ring_y - outer, outer * 2, outer * 2, outer, scaled(s, 2), 0xFF202020)
        canvas_module.strokeRoundedRect(canvas, ring_x - inner, ring_y - inner, inner * 2, inner * 2, inner, scaled(s, 2), 0xFFFFFFFF)
    }
    // The bar: OKLab's greys, white at the top, the cut marked.
    var step: i32 = 0
    while step < bar.height {
        const grey = color_module.fromOklab(1.0 - (@floatFromInt(f64, step) + 0.5) / @floatFromInt(f64, bar.height), 0.0, 0.0, 255)
        canvas_module.fillRect(canvas, bar.x, bar.y + step, bar.width, 1, grey)
        step += 1
    }
    const share = if solid.*.cut > 1.0 { 1.0 } else { solid.*.cut }
    const mark_y = bar.y + @intFromFloat(i32, @floatFromInt(f64, bar.height - 1) * (1.0 - share))
    canvas_module.fillRect(canvas, bar.x - scaled(s, 2), mark_y - scaled(s, 2), bar.width + scaled(s, 4), scaled(s, 5), 0xFF202020)
    canvas_module.fillRect(canvas, bar.x - scaled(s, 1), mark_y - scaled(s, 1), bar.width + scaled(s, 2), scaled(s, 3), 0xFFFFFFFF)
    return result
}

// ---------------------------------------------------------------------------
// The sliders

// What the channel's value is now, 0..1.
fn channelValue(picker: *Picker, channel: u8) -> f64 {
    const now = picker.*.color
    if channel == CHANNEL_RED { return @floatFromInt(f64, pixel.red(now)) / 255.0 }
    if channel == CHANNEL_GREEN { return @floatFromInt(f64, pixel.green(now)) / 255.0 }
    if channel == CHANNEL_BLUE { return @floatFromInt(f64, pixel.blue(now)) / 255.0 }
    if channel == CHANNEL_ALPHA { return @floatFromInt(f64, pixel.alpha(now)) / 255.0 }
    if channel == CHANNEL_HUE { return picker.*.hue }
    if channel == CHANNEL_SATURATION { return picker.*.modelSaturation }
    return picker.*.modelLightness
}

// The colour of the channel set to `t` (0..1), the rest as now
// (straight; the hue's track shows the hues at their fullest instead).
fn channelColor(picker: *Picker, channel: u8, t: f64) -> u32 {
    const now = picker.*.color
    const byte = color_module.toByte(t)
    if channel == CHANNEL_RED { return pixel.pack(255, byte, pixel.green(now), pixel.blue(now)) }
    if channel == CHANNEL_GREEN { return pixel.pack(255, pixel.red(now), byte, pixel.blue(now)) }
    if channel == CHANNEL_BLUE { return pixel.pack(255, pixel.red(now), pixel.green(now), byte) }
    if channel == CHANNEL_ALPHA { return pixel.withAlpha(now, byte) }
    if channel == CHANNEL_HUE { return color_module.fromHsv(t, 1.0, 1.0, 255) }
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    if channel == CHANNEL_SATURATION {
        color_module.modelToRgb(picker.*.model, picker.*.hue, t, picker.*.modelLightness, &r, &g, &b)
    } else {
        color_module.modelToRgb(picker.*.model, picker.*.hue, picker.*.modelSaturation, t, &r, &g, &b)
    }
    return color_module.fromRgb(r, g, b, 255)
}

// The channel set to `t` (0..1): the colour it makes.
fn setChannel(picker: *Picker, channel: u8, t: f64) -> u32 {
    const amount = math.clamp(t, 0.0, 1.0)
    if channel <= CHANNEL_ALPHA {
        const made = channelColor(picker, channel, amount)
        const kept = if channel == CHANNEL_ALPHA { made } else { pixel.withAlpha(made, pixel.alpha(picker.*.color)) }
        follow(picker, kept)
        return kept
    }
    if channel == CHANNEL_HUE {
        picker.*.hue = amount
    } else if channel == CHANNEL_SATURATION {
        picker.*.modelSaturation = amount
    } else {
        picker.*.modelLightness = amount
    }
    return fromModel(picker)
}

// What the number of a channel counts: bytes, degrees, percent.
fn channelMost(channel: u8) -> f64 {
    if channel <= CHANNEL_ALPHA { return 255.0 }
    if channel == CHANNEL_HUE { return 360.0 }
    return 100.0
}

// The checker's square (light or dark) at a place of a track.
fn checkerAt(column: i32, row: i32, cell: i32) -> u32 {
    return if (column / cell + row / cell) & 1 == 0 { 0xFFD2D2D2 } else { 0xFF9A9A9A }
}

// The track of `channel` in `track`: its colours from 0 to 1 left to
// right, over a checker where they are translucent, rounded.
fn drawTrack(canvas: *Canvas, picker: *Picker, channel: u8, track: ui.Rect, radius: i32, s: i32) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || track.width <= 1 || track.height <= 0 { return }
    const opacity = canvas.*.opacity
    const cell = if track.height / 2 > 0 { track.height / 2 } else { 1 }
    var column: i32 = 0
    while column < track.width {
        const x = track.x + column
        if x >= 0 && x < @intCast(i32, canvas.*.width) {
            const shade = channelColor(picker, channel, along(column, track.width))
            var row: i32 = 0
            while row < track.height {
                const coverage = ui.roundedCoverage(column, row, track.width, track.height, radius)
                if coverage > 0 {
                    const seen = if shade >> 24 == 255 { shade } else { pixel.over(checkerAt(column, row, cell), shade, 255) }
                    canvas_module.blend(canvas, x, track.y + row, seen, coverage * opacity / 255)
                }
                row += 1
            }
        }
        column += 1
    }
    canvas_module.strokeRoundedRect(canvas, track.x, track.y, track.width, track.height, radius, s, canvas_module.color(70, 128, 128, 128))
}

// The single letter a channel's row shows (the same in both languages).
fn channelLetter(channel: u8, model: u8) -> []const u8 {
    if channel == CHANNEL_RED { return "R" }
    if channel == CHANNEL_GREEN { return "G" }
    if channel == CHANNEL_BLUE { return "B" }
    if channel == CHANNEL_ALPHA { return "A" }
    if channel == CHANNEL_HUE { return "H" }
    if channel == CHANNEL_SATURATION { return "S" }
    if model == MODEL_HSL { return "L" }
    if model == MODEL_HSY { return "Y" }
    return "V"
}

// A channel's whole name (its slider's tooltip), in German or English;
// the last channel's is the model's: value, lightness or luma.
pub fn channelName(channel: u8, model: u8, german: bool) -> []const u8 {
    if channel == CHANNEL_RED { return if german { "Rot" } else { "Red" } }
    if channel == CHANNEL_GREEN { return if german { "Grün" } else { "Green" } }
    if channel == CHANNEL_BLUE { return if german { "Blau" } else { "Blue" } }
    if channel == CHANNEL_ALPHA { return if german { "Deckkraft (Alpha)" } else { "Opacity (alpha)" } }
    if channel == CHANNEL_HUE { return if german { "Farbton" } else { "Hue" } }
    if channel == CHANNEL_SATURATION { return if german { "Sättigung" } else { "Saturation" } }
    if model == MODEL_HSL { return if german { "Helligkeit" } else { "Lightness" } }
    if model == MODEL_HSY { return if german { "Luma" } else { "Luma" } }
    return if german { "Hellwert" } else { "Value" }
}

// Where a slider row's parts are: the letter, the track, the number.
pub fn trackOf(area: ui.Rect, scale: i32) -> ui.Rect {
    const s = if scale > 0 { scale } else { 1 }
    const left = area.x + scaled(s, LABEL) + scaled(s, 4)
    const right = ui.right(area) - scaled(s, NUMBER) - scaled(s, 6)
    const height = scaled(s, TRACK)
    return ui.rect(left, area.y + (area.height - height) / 2, if right > left { right - left } else { 0 }, height)
}

fn numberOf(area: ui.Rect, s: i32) -> ui.Rect {
    const width = scaled(s, NUMBER)
    return ui.rect(ui.right(area) - width, area.y, width, area.height)
}

// One channel's slider in `area` (a row): its letter, the track of its
// colours with a mark at its value (pressed or dragged: the value is the
// place), its number (typed: a click on it; its steppers). True in the
// frames `target` (the caller's, straight) changed.
pub fn channelSlider(kit: *Kit, picker: *Picker, id: u64, area: ui.Rect, channel: u8, target: *u32) -> bool {
    sync(picker, target)
    const context = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    const track = trackOf(area, s)
    const before = target.*
    // The track takes the pointer over the row's height.
    const grip = ui.rect(track.x - scaled(s, 4), area.y, track.width + scaled(s, 8), area.height)
    const track_id = view.idOf(id, 1)
    view.region(context, track_id, grip)
    if view.isPressed(context, track_id) && context.*.pointerDown && kit.*.disabledDepth == 0 {
        picker.*.heldTrack = track_id
        const t = along(context.*.pointerX - track.x, track.width)
        if t != channelValue(picker, channel) { target.* = setChannel(picker, channel, t) }
    } else if view.takeClick(context, track_id) {
        // Pressed and let go between two frames: the press's place; the
        // end of a drag that was seen changes nothing.
        if picker.*.heldTrack != track_id && kit.*.disabledDepth == 0 {
            const t = along(context.*.pressX - track.x, track.width)
            if t != channelValue(picker, channel) { target.* = setChannel(picker, channel, t) }
        }
        picker.*.heldTrack = view.NONE
    } else if picker.*.heldTrack == track_id {
        picker.*.heldTrack = view.NONE
    }
    kit_module.label(kit, ui.rect(area.x, area.y, scaled(s, LABEL), area.height), channelLetter(channel, picker.*.model), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    kit_module.tooltip(kit, track_id, grip, channelName(channel, picker.*.model, kit.*.german))
    const most = channelMost(channel)
    var options = kit_module.sliderOptions(0.0, most, 1.0, 0)
    var number = @intFromFloat(i32, channelValue(picker, channel) * most + 0.5)
    if kit_module.intBox(kit, view.idOf(id, 2), numberOf(area, s), &number, &options) {
        target.* = setChannel(picker, channel, @floatFromInt(f64, number) / most)
    }
    const canvas = kit_module.canvasOf(kit)
    drawTrack(canvas, picker, channel, track, scaled(s, 3), s)
    // The mark: a white bar edged dark, as tall as the row allows.
    const x = track.x + @intFromFloat(i32, channelValue(picker, channel) * @floatFromInt(f64, track.width - 1) + 0.5)
    const lit = view.isHover(context, track_id) || view.isPressed(context, track_id)
    const mark_top = track.y - scaled(s, 3)
    const mark_height = track.height + scaled(s, 6)
    canvas_module.fillRoundedRect(canvas, x - scaled(s, 3), mark_top, scaled(s, 7), mark_height, scaled(s, 3), markDark())
    canvas_module.fillRoundedRect(canvas, x - scaled(s, 2), mark_top + s, scaled(s, 5), mark_height - 2 * s, scaled(s, 2), if lit { theme.*.accent } else { 0xFFFFFFFF })
    return target.* != before
}

// The choice of the model of the last three sliders, a row of three:
// HSV, HSL, HSY. True when it changed.
pub fn modelChoice(kit: *Kit, picker: *Picker, id: u64, area: ui.Rect) -> bool {
    const theme = kit.*.theme
    const s = theme.*.scale
    const canvas = kit_module.canvasOf(kit)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.field)
    const third = (area.width - scaled(s, 4)) / 3
    var changed = false
    var index: usize = 0
    while index < 3 {
        const model = if index == 0 { MODEL_HSV } else if index == 1 { MODEL_HSL } else { MODEL_HSY }
        const part = ui.rect(area.x + scaled(s, 2) + @intCast(i32, index) * third, area.y + scaled(s, 2), if index == 2 { area.width - scaled(s, 4) - 2 * third } else { third }, area.height - scaled(s, 4))
        const chosen = picker.*.model == model
        const tip = if index == 0 { if kit.*.german { "Farbton, Sättigung, Hellwert" } else { "Hue, saturation, value" } } else if index == 1 { if kit.*.german { "Farbton, Sättigung, Helligkeit" } else { "Hue, saturation, lightness" } } else { if kit.*.german { "Farbton, Sättigung, Luma (wie hell es wirkt)" } else { "Hue, saturation, luma (how light it looks)" } }
        if kit_module.toolButton(kit, view.idOf(id, index + 1), part, null, 0, chosen, tip) && !chosen {
            setModel(picker, model)
            changed = true
        }
        const name = if index == 0 { "HSV" } else if index == 1 { "HSL" } else { "HSY" }
        kit_module.label(kit, part, name, if chosen { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_CENTER)
        index += 1
    }
    return changed
}

// How tall sliders() is.
pub fn slidersHeight(scale: i32) -> i32 {
    const s = if scale > 0 { scale } else { 1 }
    return scaled(s, ROW + GROUP_GAP + 4 * ROW_STEP + GROUP_GAP + 2 * ROW_STEP + ROW)
}

// The area of channel `channel`'s row in sliders() drawn in `area`.
pub fn channelRow(area: ui.Rect, channel: u8, scale: i32) -> ui.Rect {
    const s = if scale > 0 { scale } else { 1 }
    var y = area.y + scaled(s, ROW + GROUP_GAP) + @intCast(i32, channel) * scaled(s, ROW_STEP)
    if channel >= CHANNEL_HUE { y += scaled(s, GROUP_GAP) }
    return ui.rect(area.x, y, area.width, scaled(s, ROW))
}

// The model's choice and a slider for each channel, in `area`
// (slidersHeight tall): red, green, blue and alpha, then hue, saturation
// and the model's lightness. True in the frames `target` changed.
pub fn sliders(kit: *Kit, picker: *Picker, id: u64, area: ui.Rect, target: *u32) -> bool {
    sync(picker, target)
    const s = kit.*.theme.*.scale
    const before = target.*
    _ = modelChoice(kit, picker, view.idOf(id, 1), ui.rect(area.x, area.y, area.width, scaled(s, ROW)))
    var channel: u8 = 0
    while @intCast(usize, channel) < CHANNELS {
        _ = channelSlider(kit, picker, view.idOf(id, 2 + @intCast(usize, channel)), channelRow(area, channel, s), channel, target)
        channel += 1
    }
    return target.* != before
}

// ---------------------------------------------------------------------------
// The hex field and the history

// The colour as text in a field of `area`: "#rrggbb", or "#aarrggbb"
// when it is translucent. A click opens it for typing; Enter takes what
// was typed ("#rgb", "#rrggbb", "#aarrggbb", the '#' may be left out):
// HEX_SET, or HEX_WRONG when it is no colour (the field shows the colour
// again).
pub fn hexField(kit: *Kit, picker: *Picker, id: u64, area: ui.Rect, target: *u32) -> u8 {
    sync(picker, target)
    if !kit_module.editing(kit, id) { picker.*.hexLength = color_module.formatHex(target.*, &picker.*.hex, pixel.alpha(target.*) != 255) }
    const result = kit_module.textBox(kit, id, area, &picker.*.hex, &picker.*.hexLength, 9, "#rrggbb")
    if result != kit_module.TEXT_SUBMITTED { return HEX_NONE }
    const bytes: [*]const u8 = &picker.*.hex
    var typed: u32 = 0
    if !color_module.parseHex(bytes[0..picker.*.hexLength], &typed) { return HEX_WRONG }
    follow(picker, typed)
    target.* = typed
    return HEX_SET
}

// How many history cells go in a row of `width`: all of them when each
// gets LEAST_CELL, else half.
fn historyColumns(width: i32, s: i32) -> i32 {
    return if width >= @intCast(i32, HISTORY) * scaled(s, LEAST_CELL) { @intCast(i32, HISTORY) } else { @intCast(i32, HISTORY) / 2 }
}

// How tall the history is in a row of `width` (its one or two rows of
// cells; 0 for no width).
pub fn historyHeight(width: i32, scale: i32) -> i32 {
    if width <= 0 { return 0 }
    const s = if scale > 0 { scale } else { 1 }
    const columns = historyColumns(width, s)
    const rows = @intCast(i32, HISTORY) / columns
    return rows * (width / columns)
}

// Cell `index` (below HISTORY) of the history drawn in `area`: the cells
// of a row share its width, gaps between them, the first at its left
// edge, the last at its right one.
pub fn historyCell(area: ui.Rect, index: usize, scale: i32) -> ui.Rect {
    const s = if scale > 0 { scale } else { 1 }
    const columns = historyColumns(area.width, s)
    const place = @intCast(i32, if index < HISTORY { index } else { HISTORY - 1 })
    const column = place % columns
    const row = place / columns
    const step = if area.width > 0 { area.width / columns } else { 0 }
    const gap = scaled(s, 3)
    const side = if step > gap { step - gap } else { 0 }
    // (What the cells leave of the width goes into the gaps, spread over
    // them.)
    const room = area.width - columns * side
    const left = if columns > 1 { column * room / (columns - 1) } else { 0 }
    return ui.rect(area.x + column * side + left, area.y + row * step, side, side)
}

// The colours of `history` in `area` (historyHeight tall), the newest
// first, the places not taken yet as faint outlines. The colour clicked,
// or null.
pub fn historyRow(kit: *Kit, id: u64, area: ui.Rect, history: *const History) -> ?u32 {
    var clicked: ?u32 = null
    const s = kit.*.theme.*.scale
    const canvas = kit_module.canvasOf(kit)
    var index: usize = 0
    while index < HISTORY {
        const cell = historyCell(area, index, s)
        if index < history.*.count {
            if kit_module.colorSwatch(kit, view.idOf(id, index + 1), cell, history.*.colors[index], false) { clicked = history.*.colors[index] }
        } else {
            canvas_module.strokeRoundedRect(canvas, cell.x, cell.y, cell.width, cell.height, kit.*.theme.*.smallRadius, s, kit.*.theme.*.divider)
        }
        index += 1
    }
    return clicked
}
