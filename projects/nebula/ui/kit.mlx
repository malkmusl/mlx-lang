// nebula ui: the kit: the widgets nebula's dockers, dialogs and tool
// options are built from, beyond std.ui.controls: a slider with its label
// and number in it that also takes a typed number, spin boxes, a text
// box, drop-down lists, tabs, splitters, list rows, colour swatches, a
// grid of cells, a curve editor, tool buttons with tooltips, and clipping
// and scrolling for all of it. It knows nothing of documents: it builds on
// std.ui (immediate mode: a widget is a function called each frame, which
// draws itself, names its rectangle with an id and says what happened) and
// on core/pixel.mlx.
//
// A Kit (made once, in heap memory) keeps what widgets share between
// frames: the one text edit that is open, the drag in progress, the open
// list, how long the pointer has rested on a button. A frame:
//
//     view.begin(widgets, canvas)
//     kit.begin(k, widgets, canvas, &theme, body, small, mono, std.time.milliseconds(), german)
//     if kit.slider(k, ID_SIZE, row, "Size", &brush.size, &SIZE) { ... }
//     if kit.released(k, ID_SIZE) { ...one undo step... }
//     if kit.comboBox(k, ID_MODE, row2, modeNames(), &mode) { ... }
//     const again = kit.end(k)          // draws the open list and the tooltip on top
//     if view.end(widgets) || again { redraw }
//
// and, from the window's events (std.ui.app.feed hands the widgets only
// the pointer's left button and the wheel):
//
//     kit.setModifiers(k, host.modifiers(h))                 // Shift makes a slider fine
//     if kit.key(k, code, modifiers, typed) { redraw; return }   // an open edit or list took the key
//     if !kit.wantsKeys(k) { ...the app's shortcuts... }
//     kit.secondaryClick(k, x, y)                            // the right button: a slider's number is typed
//     kit.dismiss(k)                                         // a press the widgets do not see (on the picture)
//
// (`modeNames()` hands out a table kept in heap memory by core/table.mlx:
// a constant table sliced in each frame, MODES[0..], would be copied into
// the value arena each time; comboBoxWith names the rows by a function
// and needs no slice.)
//
// Every widget takes the Kit, its id (a u64 as std.ui.view's; a widget
// with parts derives their ids from it) and a ui.Rect, and keeps the
// caller's side to a pointer to the value. Sizes are for rows of ROW
// pixels in the small font, times the theme's scale. Colours given to
// widgets (colorSwatch, colorPair, fillStraight) are straight 0xAARRGGBB
// as the engine's; those given to the drawing set (line, hline, frame)
// are premultiplied as std.ui.canvas's.
//
// Drawing is on the CPU canvas (nebula asks for it): the kit reads and
// writes its pixels. On a layout pass (view.layoutCanvas(): no pixels)
// every widget still names its regions and takes its input, and nothing
// is drawn; the callbacks that draw an icon or a cell are not called.
// Inside clipBegin .. clipEnd (and scrollBegin .. scrollEnd) the canvas
// to draw on is canvasOf(kit), not the window's.
//
// Not done: copy and paste in a text edit (std.ui.field has none; the
// window's clipboard is the app's), a horizontal scroll bar, keys moving
// between widgets (Tab ends an edit, it does not go to the next), more
// than one open text edit or list at a time.
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("std.ui.keys")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const field_module = @import("std.ui.field")
const popup = @import("std.ui.popup")
const glyphs = @import("std.ui.glyphs")
const pixel = @import("../core/pixel.mlx")
const kit_text = @import("./kit_text.mlx")
const kit_curve = @import("./kit_curve.mlx")

pub const Allocator = std.allocator.Allocator
pub const Canvas = canvas_module.Canvas
pub const Text = text_module.Text
pub const Theme = theme_module.Theme
const Ui = view.Ui
const NONE = view.NONE

// The height (times the theme's scale) the widgets are made for.
pub const ROW: i32 = 24

// Label colours (label's `kind`).
pub const TEXT_NORMAL: u8 = 0
pub const TEXT_DIM: u8 = 1
pub const TEXT_ACCENT: u8 = 2
pub const TEXT_DANGER: u8 = 3
pub const TEXT_ON_ACCENT: u8 = 4

// Where a label stands in its rectangle.
pub const ALIGN_LEFT: u8 = 0
pub const ALIGN_CENTER: u8 = 1
pub const ALIGN_RIGHT: u8 = 2

// Button kinds: filled, the primary action, only a background under the
// pointer; `| BUTTON_DISABLED`: drawn faded, taking no click.
pub const BUTTON_NORMAL: u8 = 0
pub const BUTTON_PRIMARY: u8 = 1
pub const BUTTON_PLAIN: u8 = 2
pub const BUTTON_DISABLED: u8 = 128

// What textBox says of a frame.
pub const TEXT_NONE: u8 = 0
pub const TEXT_EDITED: u8 = 1
pub const TEXT_SUBMITTED: u8 = 2
pub const TEXT_CANCELLED: u8 = 3

// What listRow says.
pub const ROW_NONE: u8 = 0
pub const ROW_CLICKED: u8 = 1
pub const ROW_DOUBLE_CLICKED: u8 = 2

// What colorPair says.
pub const PAIR_NONE: u8 = 0
pub const PAIR_FOREGROUND: u8 = 1
pub const PAIR_BACKGROUND: u8 = 2
pub const PAIR_SWAP: u8 = 3
pub const PAIR_RESET: u8 = 4

// Kinds of a drop-down list's rows (a ListKind callback's answer): one to
// choose, a line between groups, a group's heading.
pub const LIST_ITEM: u8 = 0
pub const LIST_SEPARATOR: u8 = 1
pub const LIST_HEADING: u8 = 2

// `chosen` for a grid in which nothing is chosen.
pub const NOTHING: usize = 18446744073709551615

// The most points a curve has (kit_curve's).
pub const CURVE_POINTS: usize = kit_curve.MAX_POINTS

// The bytes formatNumber and ellipsized write into.
pub const NUMBER_ROOM: usize = kit_text.NUMBER_ROOM
pub const TEXT_ROOM: usize = kit_text.TEXT_ROOM

// Draws a button's icon: in the square `size` across at (x, y), in
// `color` (premultiplied). `context` is the caller's (which icon).
pub const IconDraw = fn(context: usize, canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void
// Draws cell `index` of a grid in `cell`; `lit`: the pointer is on it.
pub const CellDraw = fn(context: usize, index: usize, canvas: *Canvas, cell: ui.Rect, lit: bool) -> void
// The name of row `index` of a drop-down list, and its kind (LIST_*).
pub const ListName = fn(context: usize, index: usize) -> []const u8
pub const ListKind = fn(context: usize, index: usize) -> u8

// What a slider or a spin box is told about its number.
pub const SliderOptions = struct {
    // The range a typed number is held in.
    low: f64
    high: f64
    // What the wheel, a stepper and Up and Down change it by.
    step: f64
    // Digits after the point (0: whole numbers); the value is rounded so.
    decimals: usize
    // 1: the bar is linear. Above: its left part is stretched, position =
    // ((value - low) / (high - low)) ^ (1 / exponent): with 3 the left half
    // of a brush size's bar is the smallest eighth of the sizes.
    exponent: f64
    // Written after the number: " px", " %", "°".
    suffix: []const u8
    // The range the bar shows and a drag reaches, when softHigh is above
    // softLow (a size typed up to 10000 on a bar to 1000); else low..high.
    softLow: f64
    softHigh: f64
    // Drawn faded, taking no input.
    disabled: bool
}

// Options with the usual rest: a linear bar over low..high, no suffix.
pub fn sliderOptions(low: f64, high: f64, step: f64, decimals: usize) -> SliderOptions {
    return SliderOptions.{ .low = low, .high = high, .step = step, .decimals = decimals, .exponent = 1.0, .suffix = "", .softLow = 0.0, .softHigh = 0.0, .disabled = false }
}

// Two presses (or clicks) on one thing this close are a double click.
const DOUBLE_MS: u64 = 400
// How long the pointer rests on a button before its tooltip shows.
const TIP_MS: u64 = 600
// A held stepper steps again after this long, then this often.
const REPEAT_FIRST_MS: u64 = 400
const REPEAT_MS: u64 = 60
// Letters typed over a list longer apart than this start a new word.
const TYPED_MS: u64 = 1000
// With Shift a slider moves this much of the pointer's way.
const FINE: f64 = 0.1
// What is disabled shows this much of itself (of 255).
const DISABLED_OPACITY: u32 = 96
// A scroll bar's width, a wheel notch in pixels, a list row's height.
const SCROLL_BAR: i32 = 8
const WHEEL_STEP: i32 = 48
const LIST_ROW: i32 = 24
// A curve's handle is taken within this many pixels; a point dragged this
// far out of the editor is removed.
const CURVE_GRAB: i32 = 9
const CURVE_OUT: i32 = 28
// The squares under a translucent colour.
const CHECK_LIGHT: u32 = 0xFFD2D2D2
const CHECK_DARK: u32 = 0xFF9A9A9A

const LAYERS: usize = 3
const SCROLLS: usize = 4
const TYPED: usize = 32
const NEVER: u32 = 4294967295

// Ids of a widget's parts are view.idOf(id, PART_*); a list's rows and a
// grid's cells follow from PARTS.
const PART_UP: usize = 1
const PART_DOWN: usize = 2
const PART_BAR: usize = 3
const PART_CATCH: usize = 4
const PART_FRAME: usize = 5
const PART_FOREGROUND: usize = 6
const PART_BACKGROUND: usize = 7
const PART_SWAP: usize = 8
const PART_RESET: usize = 9
const PARTS: usize = 16

const EDIT_NUMBER: u8 = 0
const EDIT_TEXT: u8 = 1
// What an open edit waits for its widget to take: nothing, its text to
// be used, the edit to be given up.
const EDIT_OPEN: u8 = 0
const EDIT_COMMIT: u8 = 1
const EDIT_CANCEL: u8 = 2

const JUMP_NONE: u8 = 0
const JUMP_FIRST: u8 = 1
const JUMP_LAST: u8 = 2

// An offscreen canvas of the window's size that drawing goes to between
// clipBegin and clipEnd.
const Layer = struct {
    pixels: [*]u32
    // Pixels the block holds (0: none yet).
    capacity: usize
    canvas: Canvas
    // What was drawn on before, and the part copied in and back.
    saved: *Canvas
    area: ui.Rect
    active: bool
}

const ScrollFrame = struct {
    id: u64
    area: ui.Rect
    content: i32
    offset: *i32
}

pub const Kit = struct {
    allocator: Allocator
    // The frame's (begin sets them).
    ui: *Ui
    theme: *Theme
    body: *Text
    small: *Text
    mono: *Text
    time: u64
    german: bool
    // Frames begun (what was asked of a widget is dropped when it is not
    // drawn within two).
    frame: u64
    // The window's size: resize()'s, else the last canvas's with pixels.
    width: i32
    height: i32
    sized: bool
    // std.ui.keys modifiers held (setModifiers).
    modifiers: u32
    // Milliseconds until the kit wants a frame by itself (NEVER: it does not).
    wakeIn: u32

    // The press being followed: on which id and where it went down, where
    // the pointer was in the last frame, whether it left the threshold,
    // whether it is a double click's second, whether it took hold of
    // nothing (inert: its end is no change), a widget's own start value
    // and place (a slider's position 0..1, a curve's point).
    dragId: u64
    dragPressX: i32
    dragPressY: i32
    dragLastX: i32
    dragLastY: i32
    dragMoved: bool
    dragDouble: bool
    dragInert: bool
    dragValue: f64
    dragPosition: f64
    dragPart: usize
    // The id whose press ended (or whose change is complete) this frame.
    releasedId: u64
    releasedMoved: bool
    // Double clicks: the last press and the last click.
    lastPressId: u64
    lastPressTime: u64
    pressValue: f64
    lastClickId: u64
    lastClickTime: u64
    repeatAt: u64
    // The id the right button went down on, an id whose edit is to open.
    secondaryId: u64
    secondaryFrame: u64
    wantedId: u64
    wantedFrame: u64

    // The open text edit: whose, a number's or a text's, what waits for
    // its widget, Up and Down not applied yet, the value and the text it
    // began with.
    editId: u64
    editKind: u8
    editResult: u8
    editSteps: i32
    editSeen: u64
    editValue: f64
    field: field_module.Field
    original: field_module.Field

    // The open list: whose box, where the box is, its rows (the callbacks
    // of this frame), the row keys move, how far it is scrolled, its width.
    listId: u64
    listArea: ui.Rect
    listCount: usize
    listName: ?ListName
    listKind: ?ListKind
    listContext: usize
    listChosen: usize
    listCursor: usize
    listScroll: i32
    listWidth: i32
    listSeen: u64
    listReveal: bool
    // Keys for it since the last frame.
    listMove: i32
    listJump: u8
    listEnter: bool
    typed: [32]u8
    typedLength: usize
    typedAt: u64
    typedNew: bool
    // The wheel while it is open (kept from what lies under it).
    wheel: i32
    // A row chosen, until its box takes it.
    pickId: u64
    pick: usize
    pickFrame: u64

    // The button the pointer rests on, since when, and its text (of this
    // frame).
    tipId: u64
    tipSince: u64
    tipSeen: bool
    tipText: []const u8
    tipArea: ui.Rect

    disabledDepth: usize
    savedOpacity: u32
    layers: [3]Layer
    clipDepth: usize
    scrolls: [4]ScrollFrame
    scrollDepth: usize

    // A label cut to its width and a number as text live here for the
    // moment they are drawn: as locals whose address is handed on they
    // would be taken from the value arena at every call.
    room: [256]u8
    number: [64]u8
}

// A kit in heap memory (null without it). Nothing is drawn with it before
// the first begin.
pub fn create(allocator: Allocator) -> ?*Kit {
    const memory = allocator.alloc(@sizeOf(Kit), 16)
    if memory == null { return null }
    const kit: *Kit = unsafe { @ptrCast(*Kit, memory.?) }
    kit.*.allocator = allocator
    kit.*.time = 0
    kit.*.german = false
    kit.*.frame = 0
    kit.*.width = 0
    kit.*.height = 0
    kit.*.sized = false
    kit.*.modifiers = 0
    kit.*.wakeIn = NEVER
    kit.*.dragId = NONE
    kit.*.dragPressX = 0
    kit.*.dragPressY = 0
    kit.*.dragLastX = 0
    kit.*.dragLastY = 0
    kit.*.dragMoved = false
    kit.*.dragDouble = false
    kit.*.dragInert = false
    kit.*.dragValue = 0.0
    kit.*.dragPosition = 0.0
    kit.*.dragPart = 0
    kit.*.releasedId = NONE
    kit.*.releasedMoved = false
    kit.*.lastPressId = NONE
    kit.*.lastPressTime = 0
    kit.*.pressValue = 0.0
    kit.*.lastClickId = NONE
    kit.*.lastClickTime = 0
    kit.*.repeatAt = 0
    kit.*.secondaryId = NONE
    kit.*.secondaryFrame = 0
    kit.*.wantedId = NONE
    kit.*.wantedFrame = 0
    kit.*.editId = NONE
    kit.*.editKind = EDIT_NUMBER
    kit.*.editResult = EDIT_OPEN
    kit.*.editSteps = 0
    kit.*.editSeen = 0
    kit.*.editValue = 0.0
    field_module.init(&kit.*.field)
    field_module.init(&kit.*.original)
    kit.*.listId = NONE
    kit.*.listArea = ui.rect(0, 0, 0, 0)
    kit.*.listCount = 0
    kit.*.listName = null
    kit.*.listKind = null
    kit.*.listContext = 0
    kit.*.listChosen = 0
    kit.*.listCursor = 0
    kit.*.listScroll = 0
    kit.*.listWidth = 0
    kit.*.listSeen = 0
    kit.*.listReveal = false
    kit.*.listMove = 0
    kit.*.listJump = JUMP_NONE
    kit.*.listEnter = false
    kit.*.typedLength = 0
    kit.*.typedAt = 0
    kit.*.typedNew = false
    kit.*.wheel = 0
    kit.*.pickId = NONE
    kit.*.pick = 0
    kit.*.pickFrame = 0
    kit.*.tipId = NONE
    kit.*.tipSince = 0
    kit.*.tipSeen = false
    kit.*.tipText = ""
    kit.*.tipArea = ui.rect(0, 0, 0, 0)
    kit.*.disabledDepth = 0
    kit.*.savedOpacity = 255
    var index: usize = 0
    while index < LAYERS {
        kit.*.layers[index].capacity = 0
        kit.*.layers[index].active = false
        index += 1
    }
    kit.*.clipDepth = 0
    kit.*.scrollDepth = 0
    return kit
}

// Gives back everything the kit holds, and the kit.
pub fn destroy(kit: *Kit) -> void {
    const allocator = kit.*.allocator
    field_module.deinit(&kit.*.field)
    field_module.deinit(&kit.*.original)
    var index: usize = 0
    while index < LAYERS {
        freeLayer(kit, &kit.*.layers[index])
        index += 1
    }
    unsafe { allocator.free(@ptrCast([*]u8, kit), @sizeOf(Kit), 16) }
}

fn freeLayer(kit: *Kit, layer: *Layer) -> void {
    if layer.*.capacity == 0 { return }
    unsafe { kit.*.allocator.free(@ptrCast([*]u8, layer.*.pixels), layer.*.capacity * 4, 16) }
    layer.*.capacity = 0
}

// ---------------------------------------------------------------------------
// The frame

// Starts the kit's part of a frame (after view.begin): the context and
// canvas it is drawn with, the theme and fonts, the time in milliseconds
// (double clicks, tooltips, the caret) and the language of what the kit
// itself writes (numbers: a decimal comma in German).
pub fn begin(kit: *Kit, context: *Ui, canvas: *Canvas, theme: *Theme, body: *Text, small: *Text, mono: *Text, time: u64, german: bool) -> void {
    kit.*.ui = context
    kit.*.theme = theme
    kit.*.body = body
    kit.*.small = small
    kit.*.mono = mono
    kit.*.time = time
    kit.*.german = german
    kit.*.frame += 1
    // (std.ui.field blinks its caret by the context's time.)
    context.*.time = time
    if !kit.*.sized && canvas.*.width > 0 && canvas.*.height > 0 {
        kit.*.width = @intCast(i32, canvas.*.width)
        kit.*.height = @intCast(i32, canvas.*.height)
    }
    kit.*.wakeIn = NEVER
    kit.*.clipDepth = 0
    kit.*.scrollDepth = 0
    kit.*.disabledDepth = 0
    kit.*.tipSeen = false
    kit.*.tipText = ""
    // The press that ended since the last frame.
    kit.*.releasedId = NONE
    kit.*.releasedMoved = false
    if kit.*.dragId != NONE && !context.*.pointerDown {
        // (A press that took hold of nothing changed nothing.)
        if !kit.*.dragInert {
            kit.*.releasedId = kit.*.dragId
            kit.*.releasedMoved = kit.*.dragMoved
        }
        kit.*.dragId = NONE
    }
    // What was asked of a widget that is not drawn any more.
    if kit.*.secondaryId != NONE && kit.*.frame > kit.*.secondaryFrame + 2 { kit.*.secondaryId = NONE }
    if kit.*.wantedId != NONE && kit.*.frame > kit.*.wantedFrame + 2 { kit.*.wantedId = NONE }
    if kit.*.pickId != NONE && kit.*.frame > kit.*.pickFrame + 2 { kit.*.pickId = NONE }
    if kit.*.editId != NONE {
        if kit.*.frame > kit.*.editSeen + 1 {
            closeEdit(kit)
        } else if context.*.pointerDown && context.*.pressed != kit.*.editId && kit.*.editResult == EDIT_OPEN {
            // A press elsewhere ends the edit as Enter does.
            kit.*.editResult = EDIT_COMMIT
        }
    }
    // While a list is open the wheel is its own: what lies under it must
    // not scroll.
    if kit.*.listId != NONE {
        kit.*.wheel +|= context.*.wheel
        context.*.wheel = 0
    } else {
        kit.*.wheel = 0
    }
}

// Ends the kit's part of a frame (before view.end): draws what lies over
// everything, the open list and the tooltip. True when the kit wants
// another frame by itself (a caret blinks, a tooltip is due, a held
// stepper repeats, a busy bar moves): frameDelay says when.
pub fn end(kit: *Kit) -> bool {
    // (A clip left open would leave the context drawing into a layer.)
    while kit.*.clipDepth > 0 { clipEnd(kit) }
    while kit.*.disabledDepth > 0 { disabledEnd(kit) }
    drawList(kit)
    drawTooltip(kit)
    // Wheel steps nobody took are gone: they must not scroll what the
    // pointer comes over later.
    kit.*.ui.*.wheel = 0
    return kit.*.wakeIn != NEVER
}

// Milliseconds until the frame `end` asked for is due (0: at once).
pub fn frameDelay(kit: *Kit) -> u32 {
    return if kit.*.wakeIn == NEVER { 0 } else { kit.*.wakeIn }
}

// The window's size, for an app that lays out before it ever drew (a
// layout pass has no canvas to take it from); without it the size of the
// last canvas drawn on is used.
pub fn resize(kit: *Kit, width: i32, height: i32) -> void {
    kit.*.width = width
    kit.*.height = height
    kit.*.sized = true
}

// Which modifier keys are held (std.ui.keys bits; host.modifiers): with
// Shift a slider is dragged finely. Call whenever they may have changed
// (simplest: before each frame).
pub fn setModifiers(kit: *Kit, modifiers: u32) -> void { kit.*.modifiers = modifiers }

// The canvas to draw on now: the window's, or inside clipBegin .. clipEnd
// the layer that is cut to the clip.
pub fn canvasOf(kit: *Kit) -> *Canvas { return kit.*.ui.*.canvas }

// Whether a text edit or a list is open: keys are theirs (kit.key), the
// app must not take letters as shortcuts.
pub fn wantsKeys(kit: *Kit) -> bool { return kit.*.editId != NONE || kit.*.listId != NONE }

// Whether `id`'s text edit is open.
pub fn editing(kit: *Kit, id: u64) -> bool { return kit.*.editId == id && id != NONE }

// True in the frame in which a change of `id` is complete: its drag (a
// slider's, a splitter's, a curve's, a row's) ended, whether or not that
// frame changed anything, a wheel or stepper step was made, a typed
// number was taken. Ask after the widget was drawn; callers record one
// undo step then.
pub fn released(kit: *Kit, id: u64) -> bool { return kit.*.releasedId == id && id != NONE }

// True in the frame in which a row drag of `id` (dragRow) that had left
// its threshold ended: the row is dropped where the pointer is.
pub fn dropped(kit: *Kit, id: u64) -> bool { return released(kit, id) && kit.*.releasedMoved }

// Opens the text edit of the slider, spin box or text box `id` when it is
// drawn next (a row is renamed: F2), its text selected.
pub fn focus(kit: *Kit, id: u64) -> void {
    kit.*.wantedId = id
    kit.*.wantedFrame = kit.*.frame
}

// The right button was pressed at (x, y): a slider or spin box there
// opens its number for typing. (An open edit elsewhere ends as with
// Enter.)
pub fn secondaryClick(kit: *Kit, x: i32, y: i32) -> void {
    const hit = view.hitAt(kit.*.ui, x, y)
    if kit.*.editId != NONE && hit != kit.*.editId && kit.*.editResult == EDIT_OPEN { kit.*.editResult = EDIT_COMMIT }
    kit.*.secondaryId = hit
    kit.*.secondaryFrame = kit.*.frame
}

// Closes what is open, for a press the widgets do not see (on the
// picture, in another window part): a text edit ends as with Enter (its
// widget takes the text in the next frame), a list closes with nothing
// chosen.
pub fn dismiss(kit: *Kit) -> void {
    if kit.*.editId != NONE && kit.*.editResult == EDIT_OPEN { kit.*.editResult = EDIT_COMMIT }
    closeList(kit)
}

fn numberByte(byte: u8) -> bool {
    return byte >= 48 && byte <= 57 || byte == '-' || byte == '+' || byte == '.' || byte == ','
}

// A key press for the kit (Linux key code, std.ui.keys modifiers, the
// text it types): true when the kit used it and the app must not. An
// open list takes Up, Down, Page Up and Down, Home, End, Enter (choose),
// Escape and Tab (close) and letters (the first row that starts with
// what was typed). An open text edit takes typing and the caret's keys,
// Enter and Tab (take the text), Escape (give up), and for a number Up
// and Down (a step); only chords with Control, Alt or Super that mean
// nothing to it are left to the app. What a key did shows in the next
// frame: draw one.
pub fn key(kit: *Kit, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const chord = modifiers & (keys.CONTROL | keys.ALT | keys.SUPER) != 0
    if kit.*.listId != NONE {
        if code == keys.UP {
            kit.*.listMove -|= 1
        } else if code == keys.DOWN {
            kit.*.listMove +|= 1
        } else if code == keys.PAGE_UP {
            kit.*.listMove -|= 8
        } else if code == keys.PAGE_DOWN {
            kit.*.listMove +|= 8
        } else if code == keys.HOME {
            kit.*.listJump = JUMP_FIRST
        } else if code == keys.END {
            kit.*.listJump = JUMP_LAST
        } else if keys.isEnter(code) {
            kit.*.listEnter = true
        } else if code == keys.ESCAPE || code == keys.TAB {
            closeList(kit)
        } else if !chord && typed.length > 0 && typed[0] >= 32 && typed[0] != 127 {
            if kit.*.time < kit.*.typedAt || kit.*.time - kit.*.typedAt > TYPED_MS { kit.*.typedLength = 0 }
            for byte in typed {
                if kit.*.typedLength < TYPED {
                    kit.*.typed[kit.*.typedLength] = byte
                    kit.*.typedLength += 1
                }
            }
            kit.*.typedAt = kit.*.time
            kit.*.typedNew = true
        } else {
            return false
        }
        return true
    }
    if kit.*.editId == NONE { return false }
    // (A result waits for the widget: nothing more is typed into it.)
    if kit.*.editResult != EDIT_OPEN { return true }
    if keys.isEnter(code) || code == keys.TAB {
        kit.*.editResult = EDIT_COMMIT
        return true
    }
    if code == keys.ESCAPE {
        kit.*.editResult = EDIT_CANCEL
        return true
    }
    var result = field_module.KEY_IGNORED
    if kit.*.editKind == EDIT_NUMBER {
        if code == keys.UP || code == keys.DOWN {
            kit.*.editSteps +|= if code == keys.UP { 1 } else { -1 }
            return true
        }
        result = field_module.fieldKeyAccepting(&kit.*.field, code, modifiers, typed, numberByte)
    } else {
        result = field_module.fieldKey(&kit.*.field, code, modifiers, typed)
    }
    return result != field_module.KEY_IGNORED || !chord
}

// ---------------------------------------------------------------------------
// What widgets share

fn px(kit: *Kit, value: i32) -> i32 { return value * kit.*.theme.*.scale }

// The window's rectangle (a very large one before any size is known:
// what must cover the window then does).
fn windowOf(kit: *Kit) -> ui.Rect {
    if kit.*.width <= 0 || kit.*.height <= 0 { return ui.rect(0, 0, 1048576, 1048576) }
    return ui.rect(0, 0, kit.*.width, kit.*.height)
}

// The kit wants a frame in `delay` milliseconds at the latest.
fn wish(kit: *Kit, delay: u64) -> void {
    const wanted = if delay >= 60000 { 60000 } else { @intCast(u32, delay) }
    if wanted < kit.*.wakeIn { kit.*.wakeIn = wanted }
}

fn since(kit: *Kit, then: u64) -> u64 {
    return if kit.*.time >= then { kit.*.time - then } else { 0 }
}

// Whether the button is down on `id`.
fn held(kit: *Kit, id: u64) -> bool {
    return view.isPressed(kit.*.ui, id) && kit.*.ui.*.pointerDown
}

// Notes a press on `id` now; true when it is the second of a double
// click.
fn notePress(kit: *Kit, id: u64) -> bool {
    const double = kit.*.lastPressId == id && since(kit, kit.*.lastPressTime) <= DOUBLE_MS
    kit.*.lastPressId = if double { NONE } else { id }
    kit.*.lastPressTime = kit.*.time
    return double
}

// While `id` is held: true once, in the first frame of the press (the
// kit then follows it: dragLast, dragMoved; dragDouble says whether it
// is a double click's second).
fn pressStarted(kit: *Kit, id: u64) -> bool {
    const context = kit.*.ui
    if kit.*.dragId == id && kit.*.dragPressX == context.*.pressX && kit.*.dragPressY == context.*.pressY { return false }
    kit.*.dragId = id
    kit.*.dragPressX = context.*.pressX
    kit.*.dragPressY = context.*.pressY
    kit.*.dragLastX = context.*.pointerX
    kit.*.dragLastY = context.*.pointerY
    kit.*.dragMoved = false
    kit.*.dragInert = false
    kit.*.dragPart = 0
    kit.*.dragDouble = notePress(kit, id)
    return true
}

// A click on `id` whose press the kit never saw held (down and up between
// two frames): the widget does now what the press would have done.
fn quickClick(kit: *Kit, id: u64) -> bool {
    return view.takeClick(kit.*.ui, id) && kit.*.releasedId != id
}

fn takeSecondary(kit: *Kit, id: u64) -> bool {
    if kit.*.secondaryId != id || id == NONE { return false }
    // (Another edit is still to be taken by its widget: after it.)
    if kit.*.editId != NONE && kit.*.editId != id {
        wish(kit, 0)
        return false
    }
    kit.*.secondaryId = NONE
    return true
}

fn takeWanted(kit: *Kit, id: u64) -> bool {
    if kit.*.wantedId != id || id == NONE { return false }
    if kit.*.editId != NONE && kit.*.editId != id {
        wish(kit, 0)
        return false
    }
    kit.*.wantedId = NONE
    return true
}

fn textColor(kit: *Kit, kind: u8) -> u32 {
    const theme = kit.*.theme
    if kind == TEXT_DIM { return theme.*.dim }
    if kind == TEXT_ACCENT { return theme.*.accent }
    if kind == TEXT_DANGER { return theme.*.danger }
    if kind == TEXT_ON_ACCENT { return theme.*.onAccent }
    return theme.*.text
}

// The faint edge of a field on a panel, and the one under the pointer.
fn edgeColor(kit: *Kit, lit: bool) -> u32 {
    const theme = kit.*.theme
    return if lit { theme.*.border } else { theme_module.mix(theme.*.field, theme.*.border, 330) }
}

// `text` in `font` in `area`, cut with an ellipsis when too wide.
fn drawLabel(kit: *Kit, font: *Text, text: []const u8, area: ui.Rect, color: u32, where: u8) -> void {
    // (On a layout pass nothing is drawn: the text is not even measured.)
    if text.length == 0 || area.width <= 0 || kit.*.ui.*.canvas.*.width == 0 { return }
    const shown = kit_text.ellipsized(font, text, area.width, &kit.*.room)
    var x = area.x
    if where != ALIGN_LEFT {
        const width = text_module.measure(font, shown)
        x = if where == ALIGN_CENTER { area.x + (area.width - width) / 2 } else { ui.right(area) - width }
    }
    text_module.drawText(kit.*.ui.*.canvas, font, shown, x, controls.textTop(font, area.y, area.height), color, 0)
}

// ---------------------------------------------------------------------------
// The drawing set (premultiplied colours, on any CPU canvas; nothing on a
// layout pass's)

fn sane(coordinate: f64) -> bool {
    return coordinate == coordinate && coordinate > -1.0e6 && coordinate < 1.0e6
}

fn floorInt(v: f64) -> i32 { return @intFromFloat(i32, @floor(v)) }

// A straight line from (x0, y0) to (x1, y1), `thickness` pixels wide (1
// at least) with round ends, its edge smoothed. Coordinates are
// continuous: pixel (3, 5) covers 3..4 x 5..6, so a crisp one-pixel
// horizontal line runs at y + 0.5. Only what is on the canvas is drawn.
pub fn line(canvas: *Canvas, x0: f64, y0: f64, x1: f64, y1: f64, color: u32, thickness: f64) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || canvas.*.height == 0 { return }
    if !sane(x0) || !sane(y0) || !sane(x1) || !sane(y1) { return }
    const shade = canvas_module.faded(canvas, color)
    if shade == 0 { return }
    const radius = (if thickness > 1.0 { if thickness < 256.0 { thickness } else { 256.0 } } else { 1.0 }) / 2.0
    // Along the longer side (a) one column at a time, across it (b) only
    // the pixels the line can reach there.
    const steep = math.abs(y1 - y0) > math.abs(x1 - x0)
    const a0 = if steep { y0 } else { x0 }
    const b0 = if steep { x0 } else { y0 }
    const a1 = if steep { y1 } else { x1 }
    const b1 = if steep { x1 } else { y1 }
    const a_limit = @intCast(i32, if steep { canvas.*.height } else { canvas.*.width })
    const b_limit = @intCast(i32, if steep { canvas.*.width } else { canvas.*.height })
    const da = a1 - a0
    const db = b1 - b0
    const length2 = da * da + db * db
    const slope = if da != 0.0 { db / da } else { 0.0 }
    const reach = radius * @sqrt(1.0 + slope * slope) + 1.0
    var a = floorInt(math.min(a0, a1) - radius - 1.0)
    var a_end = floorInt(math.max(a0, a1) + radius + 1.0)
    if a < 0 { a = 0 }
    if a_end >= a_limit { a_end = a_limit - 1 }
    while a <= a_end {
        const ca = @floatFromInt(f64, a) + 0.5
        var along = if da != 0.0 { (ca - a0) / da } else { 0.0 }
        along = math.clamp(along, 0.0, 1.0)
        const cb = b0 + along * db
        var b = floorInt(cb - reach)
        var b_end = floorInt(cb + reach)
        if b < 0 { b = 0 }
        if b_end >= b_limit { b_end = b_limit - 1 }
        while b <= b_end {
            // The pixel's centre to the nearest point of the line.
            const pa = ca - a0
            const pb = @floatFromInt(f64, b) + 0.5 - b0
            var nearest = if length2 > 0.0 { (pa * da + pb * db) / length2 } else { 0.0 }
            nearest = math.clamp(nearest, 0.0, 1.0)
            const ea = pa - nearest * da
            const eb = pb - nearest * db
            const cover = radius + 0.5 - @sqrt(ea * ea + eb * eb)
            if cover > 0.0 {
                const amount = if cover >= 1.0 { 255 } else { @intFromFloat(u32, cover * 255.0 + 0.5) }
                if steep { canvas_module.blend(canvas, b, a, shade, amount) } else { canvas_module.blend(canvas, a, b, shade, amount) }
            }
            b += 1
        }
        a += 1
    }
}

// A horizontal line `width` pixels long from (x, y), one pixel thick.
pub fn hline(canvas: *Canvas, x: i32, y: i32, width: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y, width, 1, color)
}

// A vertical line `height` pixels long from (x, y), one pixel thick.
pub fn vline(canvas: *Canvas, x: i32, y: i32, height: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y, 1, height, color)
}

// The outline of `area`, one pixel thick, inside it.
pub fn frame(canvas: *Canvas, area: ui.Rect, color: u32) -> void {
    if area.width <= 0 || area.height <= 0 { return }
    canvas_module.fillRect(canvas, area.x, area.y, area.width, 1, color)
    canvas_module.fillRect(canvas, area.x, ui.bottom(area) - 1, area.width, 1, color)
    canvas_module.fillRect(canvas, area.x, area.y + 1, 1, area.height - 2, color)
    canvas_module.fillRect(canvas, ui.right(area) - 1, area.y + 1, 1, area.height - 2, color)
}

// The light and dark squares that stand for "nothing here" (`cell`
// pixels each, the first light, counted from the area's corner), opaque.
pub fn checker(canvas: *Canvas, area: ui.Rect, cell: i32) -> void {
    if cell <= 0 || area.width <= 0 || area.height <= 0 { return }
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, CHECK_LIGHT)
    var row: i32 = 0
    var y = area.y
    while y < ui.bottom(area) {
        const tall = if ui.bottom(area) - y < cell { ui.bottom(area) - y } else { cell }
        var x = area.x + (if row & 1 == 0 { cell } else { 0 })
        while x < ui.right(area) {
            const wide = if ui.right(area) - x < cell { ui.right(area) - x } else { cell }
            canvas_module.fillRect(canvas, x, y, wide, tall, CHECK_DARK)
            x += cell * 2
        }
        y += cell
        row += 1
    }
}

// `area` filled with a straight colour (the engine's 0xAARRGGBB) over
// what is there.
pub fn fillStraight(canvas: *Canvas, area: ui.Rect, straight_color: u32) -> void {
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, pixel.premultiplied(straight_color))
}

// The numbers and the ellipsis are kit_text's.
pub const formatNumber = kit_text.formatNumber
pub const parseNumber = kit_text.parseNumber
pub const ellipsized = kit_text.ellipsized

// A rounded box whose columns `from` to `to` (counted from its left) are
// `inside` and the others `outside` (0: left as they are): a slider's bar,
// a progress bar. The corners are smooth whichever colour they get.
fn fillBands(canvas: *Canvas, area: ui.Rect, radius: i32, from: i32, to: i32, inside: u32, outside: u32) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || area.width <= 0 || area.height <= 0 { return }
    const start = if from < 0 { 0 } else if from > area.width { area.width } else { from }
    const stop = if to < start { start } else if to > area.width { area.width } else { to }
    const corner = if radius * 2 > area.height { area.height / 2 } else if radius * 2 > area.width { area.width / 2 } else { radius }
    const faded_inside = canvas_module.faded(canvas, inside)
    const faded_outside = canvas_module.faded(canvas, outside)
    var row: i32 = 0
    while row < area.height {
        const y = area.y + row
        var left: i32 = 0
        var right = area.width
        if row < corner || row >= area.height - corner {
            // The corners' pixels one by one, the rest of the row as runs.
            left = corner
            right = area.width - corner
            var column: i32 = 0
            while column < area.width {
                if column == left && right > left { column = right }
                if column >= area.width { break }
                const coverage = ui.roundedCoverage(column, row, area.width, area.height, corner)
                const shade = if column >= start && column < stop { faded_inside } else { faded_outside }
                if coverage > 0 && shade != 0 { canvas_module.blend(canvas, area.x + column, y, shade, coverage) }
                column += 1
            }
        }
        bandRun(canvas, area.x, y, left, if start < right { start } else { right }, outside)
        bandRun(canvas, area.x, y, if start > left { start } else { left }, if stop < right { stop } else { right }, inside)
        bandRun(canvas, area.x, y, if stop > left { stop } else { left }, right, outside)
        row += 1
    }
}

fn bandRun(canvas: *Canvas, x: i32, y: i32, from: i32, to: i32, color: u32) -> void {
    if to > from && color != 0 { canvas_module.fillRect(canvas, x + from, y, to - from, 1, color) }
}

// A rounded box in a straight colour, over the checker where the colour
// is translucent (a swatch).
fn fillSwatch(canvas: *Canvas, area: ui.Rect, radius: i32, straight_color: u32, cell: i32) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || area.width <= 0 || area.height <= 0 { return }
    if straight_color >> 24 == 255 {
        canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, straight_color)
        return
    }
    const size = if cell > 0 { cell } else { 1 }
    const light = pixel.over(CHECK_LIGHT, straight_color, 255)
    const dark = pixel.over(CHECK_DARK, straight_color, 255)
    const faded_light = canvas_module.faded(canvas, light)
    const faded_dark = canvas_module.faded(canvas, dark)
    var row: i32 = 0
    while row < area.height {
        var column: i32 = 0
        while column < area.width {
            const coverage = ui.roundedCoverage(column, row, area.width, area.height, radius)
            if coverage > 0 {
                const odd = (column / size + row / size) & 1 == 1
                canvas_module.blend(canvas, area.x + column, area.y + row, if odd { faded_dark } else { faded_light }, coverage)
            }
            column += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// Clipping, what is disabled, scrolling

// Rows of `clip` copied between two canvases' pixels of the same
// coordinates.
fn copyRows(to: [*]u32, to_stride: usize, from: [*]const u32, from_stride: usize, clip: ui.Rect) -> void {
    if clip.width <= 0 || clip.height <= 0 { return }
    const x = @intCast(usize, clip.x)
    const bytes = @intCast(usize, clip.width) * 4
    var row = @intCast(usize, clip.y)
    const row_end = row + @intCast(usize, clip.height)
    while row < row_end {
        unsafe { std.mem.copy(@ptrCast([*]u8, to + row * to_stride + x), @ptrCast([*]const u8, from + row * from_stride + x), bytes) }
        row += 1
    }
}

// From here to clipEnd what is drawn shows only inside `area`, and
// regions are cut to it (view.pushClip). The canvas itself cannot clip:
// drawing goes to a layer of the window's size and coordinates (kept by
// the kit; canvasOf says which) that starts as a copy of the area and is
// copied back at clipEnd, so widgets need not know. Clips nest; beyond
// three deep (or without memory for a layer) only the regions are cut.
pub fn clipBegin(kit: *Kit, area: ui.Rect) -> void {
    const context = kit.*.ui
    view.pushClip(context, area)
    const depth = kit.*.clipDepth
    kit.*.clipDepth = depth + 1
    if depth >= LAYERS { return }
    const layer = &kit.*.layers[depth]
    layer.*.active = false
    const outer = context.*.canvas
    if outer.*.device != 0 || outer.*.width == 0 || outer.*.height == 0 { return }
    var clip = ui.intersect(area, ui.rect(0, 0, @intCast(i32, outer.*.width), @intCast(i32, outer.*.height)))
    if depth > 0 && kit.*.layers[depth - 1].active { clip = ui.intersect(clip, kit.*.layers[depth - 1].area) }
    const wanted = outer.*.width * outer.*.height
    if layer.*.capacity < wanted {
        freeLayer(kit, layer)
        const memory = kit.*.allocator.alloc(wanted * 4, 16)
        if memory == null { return }
        unsafe { layer.*.pixels = @ptrCast([*]u32, memory.?) }
        layer.*.capacity = wanted
    }
    layer.*.canvas = Canvas.{ .pixels = layer.*.pixels, .width = outer.*.width, .height = outer.*.height, .stride = outer.*.width, .swapRedBlue = outer.*.swapRedBlue, .device = 0, .opacity = outer.*.opacity }
    copyRows(layer.*.pixels, outer.*.width, outer.*.pixels, outer.*.stride, clip)
    layer.*.saved = outer
    layer.*.area = clip
    layer.*.active = true
    context.*.canvas = &layer.*.canvas
}

pub fn clipEnd(kit: *Kit) -> void {
    if kit.*.clipDepth == 0 { return }
    const context = kit.*.ui
    view.popClip(context)
    kit.*.clipDepth -= 1
    if kit.*.clipDepth >= LAYERS { return }
    const layer = &kit.*.layers[kit.*.clipDepth]
    if !layer.*.active { return }
    copyRows(layer.*.saved.*.pixels, layer.*.saved.*.stride, layer.*.pixels, layer.*.canvas.stride, layer.*.area)
    context.*.canvas = layer.*.saved
    layer.*.active = false
}

// From here to disabledEnd widgets are disabled: drawn faded, naming no
// regions (so nothing is under the pointer there). Nests.
pub fn disabledBegin(kit: *Kit) -> void {
    if kit.*.disabledDepth == 0 {
        const canvas = kit.*.ui.*.canvas
        kit.*.savedOpacity = canvas.*.opacity
        canvas_module.setOpacity(canvas, canvas.*.opacity * DISABLED_OPACITY / 255)
        view.pushClip(kit.*.ui, ui.rect(0, 0, 0, 0))
    }
    kit.*.disabledDepth += 1
}

pub fn disabledEnd(kit: *Kit) -> void {
    if kit.*.disabledDepth == 0 { return }
    kit.*.disabledDepth -= 1
    if kit.*.disabledDepth == 0 {
        canvas_module.setOpacity(kit.*.ui.*.canvas, kit.*.savedOpacity)
        view.popClip(kit.*.ui)
    }
}

fn largestOffset(content: i32, viewport: i32) -> i32 {
    return if content > viewport { content - viewport } else { 0 }
}

fn clampOffset(offset: *i32, content: i32, viewport: i32) -> void {
    if offset.* > largestOffset(content, viewport) { offset.* = largestOffset(content, viewport) }
    if offset.* < 0 { offset.* = 0 }
}

// A scrolled view in `area` of content `content_height` tall, scrolled
// by `offset` pixels (the caller's; held within the content here). Draw
// the content between this and scrollEnd at the rectangle returned: the
// content's, moved up by the offset, the width less a scroll bar's when
// the content is taller than the view. It is clipped to the view. The
// wheel over the view scrolls (when no widget in it took it), the bar at
// the right can be dragged; both at scrollEnd, showing in the next
// frame.
pub fn scrollBegin(kit: *Kit, id: u64, area: ui.Rect, content_height: i32, offset: *i32) -> ui.Rect {
    clampOffset(offset, content_height, area.height)
    const bar = if content_height > area.height { px(kit, SCROLL_BAR) } else { 0 }
    const inner = ui.rect(area.x, area.y, area.width - bar, area.height)
    if kit.*.scrollDepth < SCROLLS {
        kit.*.scrolls[kit.*.scrollDepth] = ScrollFrame.{ .id = id, .area = area, .content = content_height, .offset = offset }
    }
    kit.*.scrollDepth += 1
    clipBegin(kit, inner)
    return ui.rect(inner.x, inner.y - offset.*, inner.width, if content_height > area.height { content_height } else { area.height })
}

pub fn scrollEnd(kit: *Kit) -> void {
    if kit.*.scrollDepth == 0 { return }
    clipEnd(kit)
    kit.*.scrollDepth -= 1
    if kit.*.scrollDepth >= SCROLLS { return }
    const entry = &kit.*.scrolls[kit.*.scrollDepth]
    const context = kit.*.ui
    const area = entry.*.area
    const most = largestOffset(entry.*.content, area.height)
    if most == 0 { return }
    // The wheel, only when it can move this view (else an outer one may).
    if context.*.wheel != 0 && ui.contains(area, context.*.pointerX, context.*.pointerY) {
        var next = entry.*.offset.* +| context.*.wheel *| px(kit, WHEEL_STEP)
        if next > most { next = most }
        if next < 0 { next = 0 }
        if next != entry.*.offset.* {
            entry.*.offset.* = next
            _ = view.takeWheelIn(context, area)
        }
    }
    const bar = px(kit, SCROLL_BAR)
    scrollBar(kit, view.idOf(entry.*.id, PART_BAR), ui.rect(ui.right(area) - bar, area.y, bar, area.height), entry.*.content, area.height, entry.*.offset)
}

// A scroll bar in `track` for content taller than its view: the thumb is
// dragged, a press beside it pages toward it.
fn scrollBar(kit: *Kit, bar_id: u64, track: ui.Rect, content: i32, viewport: i32, offset: *i32) -> void {
    const context = kit.*.ui
    const most = largestOffset(content, viewport)
    if most == 0 || content <= 0 || track.height <= 0 { return }
    view.region(context, bar_id, track)
    var thumb = @intCast(i32, @intCast(i64, viewport) * @intCast(i64, track.height) / @intCast(i64, content))
    if thumb < px(kit, 20) { thumb = px(kit, 20) }
    if thumb > track.height { thumb = track.height }
    const room = track.height - thumb
    var top = track.y + @intCast(i32, @intCast(i64, offset.*) * @intCast(i64, room) / @intCast(i64, most))
    if held(kit, bar_id) {
        const before = offset.*
        if pressStarted(kit, bar_id) {
            if context.*.pressY < top { offset.* -= viewport } else if context.*.pressY >= top + thumb { offset.* += viewport }
            clampOffset(offset, content, viewport)
            kit.*.dragValue = @floatFromInt(f64, offset.*)
        } else if room > 0 {
            // (In i64 and held before it is an i32 again: a long content
            // over a short track moves far for a pixel.)
            var next = @intFromFloat(i64, kit.*.dragValue) + @intCast(i64, view.dragY(context)) * @intCast(i64, most) / @intCast(i64, room)
            if next > @intCast(i64, most) { next = @intCast(i64, most) }
            if next < 0 { next = 0 }
            offset.* = @intCast(i32, next)
        }
        // (The content was drawn at the old offset: once more.)
        if offset.* != before { context.*.changed = true }
        top = track.y + @intCast(i32, @intCast(i64, offset.*) * @intCast(i64, room) / @intCast(i64, most))
    }
    const lit = view.isHover(context, bar_id) || held(kit, bar_id)
    const inset = if lit { px(kit, 1) } else { px(kit, 2) }
    const theme = kit.*.theme
    canvas_module.fillRoundedRect(context.*.canvas, track.x + inset, top, track.width - inset * 2, thumb, (track.width - inset * 2) / 2, if lit { theme.*.border } else { theme.*.thumb })
}

// ---------------------------------------------------------------------------
// Labels and groups

// `text` in the small font in `area`, in the colour `kind` (TEXT_*), at
// the left, centre or right (`where`: ALIGN_*); cut with "…" when it is
// too wide.
pub fn label(kit: *Kit, area: ui.Rect, text: []const u8, kind: u8, where: u8) -> void {
    drawLabel(kit, kit.*.small, text, area, textColor(kit, kind), where)
}

// A heading over a group of widgets: `text` in the body font.
pub fn heading(kit: *Kit, area: ui.Rect, text: []const u8) -> void {
    drawLabel(kit, kit.*.body, text, area, kit.*.theme.*.text, ALIGN_LEFT)
}

// A line between groups, across the middle of `area` (along its longer
// side).
pub fn separator(kit: *Kit, area: ui.Rect) -> void {
    const canvas = kit.*.ui.*.canvas
    const s = kit.*.theme.*.scale
    if area.width >= area.height {
        canvas_module.fillRect(canvas, area.x, area.y + (area.height - s) / 2, area.width, s, kit.*.theme.*.divider)
    } else {
        canvas_module.fillRect(canvas, area.x + (area.width - s) / 2, area.y, s, area.height, kit.*.theme.*.divider)
    }
}

// The header of a group that folds: an arrow and `title`; a click folds
// or opens it (`open`, the caller's). Returns whether it is open now:
// draw the group's content then.
pub fn section(kit: *Kit, id: u64, area: ui.Rect, title: []const u8, open: *bool) -> bool {
    const context = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    view.region(context, id, area)
    if view.takeClick(context, id) { open.* = !open.* }
    const lit = view.isHover(context, id) || held(kit, id)
    // (Between the panel's colour and a button's: a bar, not a button.)
    canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, if lit { theme.*.buttonHover } else { theme_module.mix(theme.*.panel, theme.*.button, 560) })
    glyphs.arrowScaled(context.*.canvas, area.x + 7 * s, area.y + (area.height - 10 * s) / 2, open.*, if lit { theme.*.text } else { theme.*.dim }, s)
    drawLabel(kit, kit.*.small, title, ui.rect(area.x + 22 * s, area.y, area.width - 28 * s, area.height), theme.*.text, ALIGN_LEFT)
    return open.*
}

// ---------------------------------------------------------------------------
// Buttons

// A button with `text` (kind: BUTTON_*); true when clicked.
pub fn button(kit: *Kit, id: u64, area: ui.Rect, text: []const u8, kind: u8) -> bool {
    const context = kit.*.ui
    const theme = kit.*.theme
    const off = kind & BUTTON_DISABLED != 0
    const look = kind & 127
    if off { disabledBegin(kit) }
    view.region(context, id, area)
    const down = held(kit, id)
    const lit = down || view.isHover(context, id)
    var fill = if down { theme.*.pressed } else if lit { theme.*.buttonHover } else { theme.*.button }
    if look == BUTTON_PRIMARY {
        fill = if down { theme_module.mix(theme.*.primary, 0xFF000000, 200) } else if lit { theme.*.primaryHover } else { theme.*.primary }
    } else if look == BUTTON_PLAIN {
        fill = if down { theme.*.pressed } else if lit { theme.*.hover } else { 0 }
    }
    if fill != 0 { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + theme.*.scale, fill) }
    const inset = 6 * theme.*.scale
    drawLabel(kit, kit.*.small, text, ui.rect(area.x + inset, area.y, area.width - inset * 2, area.height), if look == BUTTON_PRIMARY { theme.*.onAccent } else { theme.*.text }, ALIGN_CENTER)
    const clicked = view.takeClick(context, id)
    if off { disabledEnd(kit) }
    return clicked && !off
}

// `text` shows by `id` when the pointer has rested on it for a while (by
// kit.end, inside the window): for any widget, after it was drawn at
// `area`.
pub fn tooltip(kit: *Kit, id: u64, area: ui.Rect, text: []const u8) -> void {
    if text.length == 0 || !view.isHover(kit.*.ui, id) { return }
    if kit.*.tipId != id {
        kit.*.tipId = id
        kit.*.tipSince = kit.*.time
    }
    kit.*.tipSeen = true
    kit.*.tipText = text
    kit.*.tipArea = area
}

// A square button with an icon the caller draws (`draw`, handed
// `context`; null: none), lit while `active` (the tool that is chosen),
// with `tooltip` when the pointer rests on it. True when clicked.
pub fn toolButton(kit: *Kit, id: u64, area: ui.Rect, draw: ?IconDraw, context: usize, active: bool, tip: []const u8) -> bool {
    const widgets = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    view.region(widgets, id, area)
    const down = held(kit, id)
    const lit = down || view.isHover(widgets, id)
    var fill: u32 = 0
    if active {
        fill = if lit { theme_module.mix(theme.*.menuChosen, theme.*.accent, 220) } else { theme.*.menuChosen }
    } else if down {
        fill = theme.*.pressed
    } else if lit {
        fill = theme.*.buttonHover
    }
    const canvas = widgets.*.canvas
    if fill != 0 { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + s, fill) }
    if draw != null && canvas.*.width > 0 {
        const side = if area.width < area.height { area.width } else { area.height }
        var size = side - 8 * s
        if size < side / 2 { size = side / 2 }
        draw.?(context, canvas, area.x + (area.width - size) / 2, area.y + (area.height - size) / 2, size, theme.*.text)
    }
    tooltip(kit, id, area, tip)
    return view.takeClick(widgets, id)
}

// A tool button that is never lit as chosen (an action's).
pub fn iconButton(kit: *Kit, id: u64, area: ui.Rect, draw: ?IconDraw, context: usize, tip: []const u8) -> bool {
    return toolButton(kit, id, area, draw, context, false, tip)
}

// A check box and `text`; a click changes `value` (the caller's). True
// when it did.
pub fn checkBox(kit: *Kit, id: u64, area: ui.Rect, text: []const u8, value: *bool) -> bool {
    const clicked = controls.checkRow(kit.*.ui, id, area, text, if value.* { controls.CHECK_ON } else { controls.CHECK_OFF })
    if clicked { value.* = !value.* }
    return clicked
}

// A radio button and `text`, on when `chosen`; true when clicked (the
// caller makes it the chosen one).
pub fn radio(kit: *Kit, id: u64, area: ui.Rect, text: []const u8, chosen: bool) -> bool {
    return controls.radioRow(kit.*.ui, id, area, text, chosen)
}

// ---------------------------------------------------------------------------
// The text edit (one at a time) and the widgets that open it

fn closeEdit(kit: *Kit) -> void {
    if view.hasFocus(kit.*.ui, kit.*.editId) { view.setFocus(kit.*.ui, NONE) }
    kit.*.editId = NONE
    kit.*.editResult = EDIT_OPEN
    kit.*.editSteps = 0
    field_module.clear(&kit.*.field)
    field_module.clear(&kit.*.original)
}

fn openEdit(kit: *Kit, id: u64, kind: u8, text: []const u8) -> void {
    field_module.set(&kit.*.field, text)
    field_module.selectAll(&kit.*.field)
    kit.*.editId = id
    kit.*.editKind = kind
    kit.*.editResult = EDIT_OPEN
    kit.*.editSteps = 0
    kit.*.editSeen = kit.*.frame
    view.setFocus(kit.*.ui, id)
}

// The open edit drawn in `area`: std.ui.field's text field in the kit's
// measures (a row's small font and corners, for the call). While the
// press that opened it is still down the field does not take it (it
// would place the caret and lose the selection).
fn drawEdit(kit: *Kit, id: u64, area: ui.Rect, placeholder: []const u8) -> void {
    const context = kit.*.ui
    const theme = kit.*.theme
    const radius = theme.*.radius
    const padding = theme.*.padding
    const body = context.*.body
    const pressed = context.*.pressed
    theme.*.radius = theme.*.smallRadius
    theme.*.padding = 7 * theme.*.scale
    context.*.body = kit.*.small
    if kit.*.dragId == id && kit.*.dragInert { context.*.pressed = NONE }
    _ = field_module.textField(context, id, area, &kit.*.field, placeholder, false)
    context.*.pressed = pressed
    context.*.body = body
    theme.*.padding = padding
    theme.*.radius = radius
    kit.*.editSeen = kit.*.frame
    // The caret goes on or off every half second.
    wish(kit, 500 - kit.*.time % 500)
}

fn softLow(options: *const SliderOptions) -> f64 {
    return if options.*.softHigh > options.*.softLow { options.*.softLow } else { options.*.low }
}

fn softHigh(options: *const SliderOptions) -> f64 {
    return if options.*.softHigh > options.*.softLow { options.*.softHigh } else { options.*.high }
}

// Where `value` is on the bar, 0..1.
fn toPosition(options: *const SliderOptions, value: f64) -> f64 {
    const low = softLow(options)
    const high = softHigh(options)
    if high <= low { return 0.0 }
    const part = math.clamp((value - low) / (high - low), 0.0, 1.0)
    if options.*.exponent > 0.0 && options.*.exponent != 1.0 && part > 0.0 { return math.pow(part, 1.0 / options.*.exponent) }
    return part
}

fn fromPosition(options: *const SliderOptions, position: f64) -> f64 {
    const low = softLow(options)
    const high = softHigh(options)
    var part = math.clamp(position, 0.0, 1.0)
    if options.*.exponent > 0.0 && options.*.exponent != 1.0 && part > 0.0 { part = math.pow(part, options.*.exponent) }
    return low + (high - low) * part
}

// `value` as the widget keeps it: in low..high, rounded to its decimals.
fn rounded(options: *const SliderOptions, value: f64) -> f64 {
    var held_value = if value != value { options.*.low } else { value }
    if held_value > options.*.high { held_value = options.*.high }
    if held_value < options.*.low { held_value = options.*.low }
    var scale: f64 = 1.0
    var place: usize = 0
    while place < options.*.decimals && place < 9 {
        scale *= 10.0
        place += 1
    }
    // (A number too large to have decimals in an f64 stays as it is.)
    if math.abs(held_value) < 1.0e15 / scale { held_value = math.round(held_value * scale) / scale }
    return held_value
}

// A number as the kit writes it: with `decimals`, and in German with a
// decimal comma (NUMBER_ROOM bytes).
fn writeNumber(kit: *Kit, value: f64, decimals: usize, into: [*]u8) -> usize {
    const length = kit_text.formatNumber(value, decimals, into)
    if kit.*.german {
        var index: usize = 0
        while index < length {
            if into[index] == '.' { into[index] = ',' }
            index += 1
        }
    }
    return length
}

// The number with its suffix as text (in the kit's number room: good
// until the next number is written).
fn numberText(kit: *Kit, options: *const SliderOptions, value: f64) -> []const u8 {
    const into: [*]u8 = &kit.*.number
    var length = writeNumber(kit, value, options.*.decimals, into)
    for byte in options.*.suffix {
        if length < 64 {
            into[length] = byte
            length += 1
        }
    }
    return into[0..length]
}

fn openNumber(kit: *Kit, id: u64, value: f64, options: *const SliderOptions) -> void {
    const bytes: [*]u8 = &kit.*.number
    const length = writeNumber(kit, value, options.*.decimals, bytes)
    // (The field keeps a copy.)
    openEdit(kit, id, EDIT_NUMBER, bytes[0..length])
    kit.*.editValue = value
}

// The open number edit of `id` in `area`: Up and Down step what is typed,
// Enter takes it (held in low..high), Escape puts back the value the
// edit began with. Returns the value now; the edit is closed after Enter
// and Escape (the widget then draws itself as usual).
fn numberEdit(kit: *Kit, id: u64, area: ui.Rect, value: f64, options: *const SliderOptions) -> f64 {
    var now = value
    kit.*.editSeen = kit.*.frame
    if kit.*.editSteps != 0 {
        _ = kit_text.parseNumber(field_module.text(&kit.*.field), &now)
        now = rounded(options, now + @floatFromInt(f64, kit.*.editSteps) * options.*.step)
        kit.*.editSteps = 0
        const bytes: [*]u8 = &kit.*.number
        const length = writeNumber(kit, now, options.*.decimals, bytes)
        field_module.set(&kit.*.field, bytes[0..length])
        field_module.selectAll(&kit.*.field)
    }
    if kit.*.editResult == EDIT_COMMIT {
        if kit_text.parseNumber(field_module.text(&kit.*.field), &now) { now = rounded(options, now) }
        closeEdit(kit)
        kit.*.releasedId = id
        kit.*.ui.*.changed = true
        return now
    }
    if kit.*.editResult == EDIT_CANCEL {
        closeEdit(kit)
        kit.*.ui.*.changed = true
        return kit.*.editValue
    }
    drawEdit(kit, id, area, "")
    return now
}

// THE widget of a painting program: a bar filled up to the value, with
// `text` at its left and the number at its right in it. Pressing or
// dragging sets the value by the pointer's place on the bar (with Shift
// held: a tenth as fast, from where it is); the wheel changes it by a
// step; a double click or the right button (secondaryClick) opens the
// number for typing in place (Enter takes it, held in the range; Escape
// leaves it; Up and Down step). True when `value` (the caller's) changed
// in this frame; released(kit, id) says when a change is complete.
pub fn slider(kit: *Kit, id: u64, area: ui.Rect, text: []const u8, value: *f64, options: *const SliderOptions) -> bool {
    if options.*.disabled { disabledBegin(kit) }
    const before = value.*
    const now = sliderValue(kit, id, area, text, before, options)
    if options.*.disabled { disabledEnd(kit) }
    // (What is no number is replaced without that counting as a change
    // every frame.)
    if now == before || (now != now && before != before) { return false }
    value.* = now
    return true
}

fn sliderValue(kit: *Kit, id: u64, area: ui.Rect, text: []const u8, given: f64, options: *const SliderOptions) -> f64 {
    const context = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    var now = if given != given { options.*.low } else { given }
    const width = @floatFromInt(f64, if area.width > 1 { area.width } else { 1 })
    if kit.*.editId != id {
        view.region(context, id, area)
        if takeSecondary(kit, id) || takeWanted(kit, id) { openNumber(kit, id, now, options) }
        const down = held(kit, id)
        const pointer = @floatFromInt(f64, context.*.pointerX - area.x) / width
        const fine = kit.*.modifiers & keys.SHIFT != 0
        if down && pressStarted(kit, id) {
            if kit.*.dragDouble {
                // The second press of a double click: the number is typed.
                // What the first press set is put back first.
                now = kit.*.pressValue
                kit.*.dragInert = true
                openNumber(kit, id, now, options)
            } else {
                kit.*.pressValue = now
                kit.*.dragPosition = if fine { toPosition(options, now) } else { pointer }
            }
        }
        if down && kit.*.dragId == id && !kit.*.dragInert {
            if fine {
                kit.*.dragPosition += @floatFromInt(f64, context.*.pointerX - kit.*.dragLastX) / width * FINE
            } else {
                kit.*.dragPosition = pointer
            }
            kit.*.dragPosition = math.clamp(kit.*.dragPosition, 0.0, 1.0)
            kit.*.dragLastX = context.*.pointerX
            now = rounded(options, fromPosition(options, kit.*.dragPosition))
        } else if quickClick(kit, id) {
            if notePress(kit, id) {
                now = kit.*.pressValue
                openNumber(kit, id, now, options)
            } else {
                kit.*.pressValue = now
                now = rounded(options, fromPosition(options, @floatFromInt(f64, context.*.pressX - area.x) / width))
                kit.*.releasedId = id
            }
        }
    }
    if kit.*.editId == id {
        now = numberEdit(kit, id, area, now, options)
        if kit.*.editId == id { return now }
    }
    const steps = view.takeWheel(context, id)
    if steps != 0 {
        now = rounded(options, now - @floatFromInt(f64, steps) * options.*.step)
        kit.*.releasedId = id
    }
    // The bar.
    const lit = view.isHover(context, id) || held(kit, id)
    const canvas = context.*.canvas
    const filled = @intFromFloat(i32, toPosition(options, now) * width + 0.5)
    const fill = if held(kit, id) { theme_module.mix(theme.*.selection, theme.*.accent, 300) } else if lit { theme_module.mix(theme.*.selection, theme.*.accent, 140) } else { theme.*.selection }
    fillBands(canvas, area, theme.*.smallRadius, 0, filled, fill, theme.*.field)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, s, edgeColor(kit, lit))
    const number = numberText(kit, options, now)
    const number_width = text_module.measure(kit.*.small, number)
    const inset = 8 * s
    drawLabel(kit, kit.*.small, number, ui.rect(area.x + inset, area.y, area.width - inset * 2, area.height), theme.*.text, ALIGN_RIGHT)
    drawLabel(kit, kit.*.small, text, ui.rect(area.x + inset, area.y, area.width - inset * 3 - number_width, area.height), theme.*.text, ALIGN_LEFT)
    return now
}

// Whether the stepper `id` steps in this frame: when pressed, and again
// and again while it stays down.
fn stepperFired(kit: *Kit, id: u64) -> bool {
    if quickClick(kit, id) { return true }
    if !held(kit, id) { return false }
    if pressStarted(kit, id) {
        kit.*.repeatAt = kit.*.time + REPEAT_FIRST_MS
        wish(kit, REPEAT_FIRST_MS)
        return true
    }
    if kit.*.time >= kit.*.repeatAt {
        kit.*.repeatAt = kit.*.time + REPEAT_MS
        wish(kit, REPEAT_MS)
        return true
    }
    wish(kit, kit.*.repeatAt - kit.*.time)
    return false
}

// A stepper's triangle, 7 wide and 4 tall, pointing up or down.
fn stepArrow(canvas: *Canvas, x: i32, y: i32, up: bool, color: u32, s: i32) -> void {
    var row: i32 = 0
    while row < 4 {
        const half = if up { row } else { 3 - row }
        canvas_module.fillRect(canvas, x + (3 - half) * s, y + row * s, (half * 2 + 1) * s, s, color)
        row += 1
    }
}

// A number in a field with two small steppers at its right. A click on
// the number (or the right button, secondaryClick) opens it for typing
// (Enter takes it, held in low..high; Escape leaves it; Up and Down
// step); the steppers and the wheel change it by a step, a held stepper
// again and again. True when `value` changed in this frame;
// released(kit, id) when a change is complete.
pub fn spinBox(kit: *Kit, id: u64, area: ui.Rect, value: *f64, options: *const SliderOptions) -> bool {
    if options.*.disabled { disabledBegin(kit) }
    const before = value.*
    const now = spinValue(kit, id, area, before, options)
    if options.*.disabled { disabledEnd(kit) }
    if now == before || (now != now && before != before) { return false }
    value.* = now
    return true
}

fn spinValue(kit: *Kit, id: u64, area: ui.Rect, given: f64, options: *const SliderOptions) -> f64 {
    const context = kit.*.ui
    const theme = kit.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    var now = if given != given { options.*.low } else { given }
    const steppers = 17 * s
    const number_area = ui.rect(area.x, area.y, area.width - steppers, area.height)
    const up_id = view.idOf(id, PART_UP)
    const down_id = view.idOf(id, PART_DOWN)
    const half = area.height / 2
    const up_area = ui.rect(ui.right(area) - steppers, area.y, steppers, half)
    const down_area = ui.rect(ui.right(area) - steppers, area.y + half, steppers, area.height - half)
    // The steppers first: what they change shows in the number below.
    view.region(context, up_id, up_area)
    view.region(context, down_id, down_area)
    var stepped: f64 = 0.0
    if stepperFired(kit, up_id) { stepped += options.*.step }
    if stepperFired(kit, down_id) { stepped -= options.*.step }
    // (A change is complete when the stepper is let go.)
    if kit.*.releasedId == up_id || kit.*.releasedId == down_id { kit.*.releasedId = id }
    if kit.*.editId != id {
        view.region(context, id, number_area)
        if view.takeClick(context, id) || takeSecondary(kit, id) || takeWanted(kit, id) { openNumber(kit, id, now, options) }
    } else if kit.*.editResult != EDIT_OPEN {
        // (An edit that ended, by the press on a stepper too: what was
        // typed is taken first, the step is added to it.)
        now = numberEdit(kit, id, number_area, now, options)
    }
    if stepped != 0.0 {
        // (A step while the number is open is a step of what is typed.)
        if kit.*.editId == id && kit.*.editResult == EDIT_OPEN {
            kit.*.editSteps +|= if stepped > 0.0 { 1 } else { -1 }
        } else {
            now = rounded(options, now + stepped)
        }
    }
    const steps = view.takeWheel(context, id)
    if steps != 0 && kit.*.editId != id {
        now = rounded(options, now - @floatFromInt(f64, steps) * options.*.step)
        kit.*.releasedId = id
    }
    const lit = view.isHover(context, id) || view.isHover(context, up_id) || view.isHover(context, down_id)
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.field)
    var editing_now = false
    if kit.*.editId == id {
        now = numberEdit(kit, id, number_area, now, options)
        editing_now = kit.*.editId == id
    }
    if !editing_now {
        drawLabel(kit, kit.*.small, numberText(kit, options, now), ui.rect(area.x + 7 * s, area.y, number_area.width - 10 * s, area.height), theme.*.text, ALIGN_LEFT)
    }
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, s, if editing_now { theme.*.accent } else { edgeColor(kit, lit) })
    // The steppers.
    const up_lit = view.isHover(context, up_id) || held(kit, up_id)
    const down_lit = view.isHover(context, down_id) || held(kit, down_id)
    if up_lit { canvas_module.fillRect(canvas, up_area.x, up_area.y + s, up_area.width - s, up_area.height - s, if held(kit, up_id) { theme.*.pressed } else { theme.*.buttonHover }) }
    if down_lit { canvas_module.fillRect(canvas, down_area.x, down_area.y, down_area.width - s, down_area.height - s, if held(kit, down_id) { theme.*.pressed } else { theme.*.buttonHover }) }
    canvas_module.fillRect(canvas, up_area.x - s, area.y + s, s, area.height - 2 * s, edgeColor(kit, false))
    stepArrow(canvas, up_area.x + (steppers - 8 * s) / 2, up_area.y + (up_area.height - 4 * s + s) / 2, true, if up_lit { theme.*.text } else { theme.*.dim }, s)
    stepArrow(canvas, down_area.x + (steppers - 8 * s) / 2, down_area.y + (down_area.height - 4 * s - s) / 2, false, if down_lit { theme.*.text } else { theme.*.dim }, s)
    return now
}

// A spin box for a whole number (the options' range and step; their
// decimals do not count).
pub fn intBox(kit: *Kit, id: u64, area: ui.Rect, value: *i32, options: *const SliderOptions) -> bool {
    var whole = options.*
    whole.decimals = 0
    if whole.low < -2147483648.0 { whole.low = -2147483648.0 }
    if whole.high > 2147483647.0 { whole.high = 2147483647.0 }
    var number = @floatFromInt(f64, value.*)
    if !spinBox(kit, id, area, &number, &whole) { return false }
    value.* = @intFromFloat(i32, math.clamp(number, -2147483648.0, 2147483647.0))
    return true
}

// A one-line text field that edits the caller's bytes: `length.*` bytes
// at `buffer`, `capacity` at most (what is typed beyond is not taken).
// Closed it shows the text (or `placeholder`, dim, when empty); a click
// (or focus(kit, id)) opens it, the text selected. While open every
// change is written to the caller's bytes at once: TEXT_EDITED in the
// frame it changed them; TEXT_SUBMITTED when Enter, Tab or a press
// elsewhere ended the edit; TEXT_CANCELLED when Escape did, the bytes as
// they were when it opened. TEXT_NONE otherwise.
pub fn textBox(kit: *Kit, id: u64, area: ui.Rect, buffer: [*]u8, length: *usize, capacity: usize, placeholder: []const u8) -> u8 {
    const context = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    if length.* > capacity { length.* = capacity }
    if kit.*.editId != id {
        view.region(context, id, area)
        const clicked = view.takeClick(context, id)
        if clicked || takeWanted(kit, id) {
            openEdit(kit, id, EDIT_TEXT, buffer[0..length.*])
            field_module.set(&kit.*.original, buffer[0..length.*])
        }
    }
    var result = TEXT_NONE
    if kit.*.editId == id {
        kit.*.editSeen = kit.*.frame
        if kit.*.editResult == EDIT_CANCEL {
            length.* = copyText(buffer, capacity, field_module.text(&kit.*.original))
            result = TEXT_CANCELLED
        } else {
            // The field's text is the caller's: copied when it differs.
            const text = field_module.text(&kit.*.field)
            if !std.text.same(text, buffer[0..length.*]) {
                length.* = copyText(buffer, capacity, text)
                // (What did not fit is not in the field either.)
                if length.* < text.length { field_module.set(&kit.*.field, buffer[0..length.*]) }
                result = TEXT_EDITED
            }
            if kit.*.editResult == EDIT_COMMIT { result = TEXT_SUBMITTED }
        }
        if kit.*.editResult != EDIT_OPEN {
            closeEdit(kit)
            context.*.changed = true
        } else {
            drawEdit(kit, id, area, placeholder)
            return result
        }
    }
    const lit = view.isHover(context, id)
    const canvas = context.*.canvas
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.field)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, s, edgeColor(kit, lit))
    const inner = ui.rect(area.x + 7 * s, area.y, area.width - 14 * s, area.height)
    if length.* == 0 {
        drawLabel(kit, kit.*.small, placeholder, inner, theme.*.dim, ALIGN_LEFT)
    } else {
        drawLabel(kit, kit.*.small, buffer[0..length.*], inner, theme.*.text, ALIGN_LEFT)
    }
    return result
}

// Copies `text` to `buffer`, at most `capacity` bytes of it and whole
// characters only; the length copied.
fn copyText(buffer: [*]u8, capacity: usize, text: []const u8) -> usize {
    var count = if text.length > capacity { capacity } else { text.length }
    while count > 0 && count < text.length && text[count] & 192 == 128 { count -= 1 }
    var index: usize = 0
    while index < count {
        buffer[index] = text[index]
        index += 1
    }
    return count
}

// ---------------------------------------------------------------------------
// The drop-down list (one open at a time, drawn by kit.end over
// everything)

// The box of what lies over the rest (a list, a tooltip): a shadow, an
// opaque ground (the theme's popup colour lets a little through, which
// shows as ghosts of the widgets under a list) and an edge.
fn popupBox(kit: *Kit, box: ui.Rect) -> void {
    const theme = kit.*.theme
    const canvas = kit.*.ui.*.canvas
    const s = theme.*.scale
    const radius = theme.*.smallRadius + 2 * s
    canvas_module.fillRoundedRect(canvas, box.x + 2 * s, box.y + 4 * s, box.width, box.height, radius, theme.*.shadow)
    canvas_module.fillRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, canvas_module.over(theme.*.panel | 0xFF000000, theme.*.popup, 255))
    canvas_module.strokeRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, s, theme.*.popupBorder)
}

fn closeList(kit: *Kit) -> void {
    kit.*.listId = NONE
    kit.*.listMove = 0
    kit.*.listJump = JUMP_NONE
    kit.*.listEnter = false
    kit.*.typedLength = 0
    kit.*.typedNew = false
    kit.*.wheel = 0
}

fn sliceName(context: usize, index: usize) -> []const u8 {
    const items: [*]const []const u8 = unsafe { @ptrFromInt([*]const []const u8, context) }
    return items[index]
}

fn listKindOf(kit: *Kit, index: usize) -> u8 {
    if kit.*.listKind == null { return LIST_ITEM }
    const kind = kit.*.listKind.?(kit.*.listContext, index)
    return if kind > LIST_HEADING { LIST_ITEM } else { kind }
}

fn listNameOf(kit: *Kit, index: usize) -> []const u8 {
    if kit.*.listName == null { return "" }
    return kit.*.listName.?(kit.*.listContext, index)
}

fn listRowHeight(kit: *Kit, kind: u8) -> i32 {
    return px(kit, if kind == LIST_SEPARATOR { 9 } else if kind == LIST_HEADING { 22 } else { LIST_ROW })
}

// A box that shows the one of `items` that is chosen and an arrow; a
// click opens the list of them under it (over it when there is no room
// below; scrolled when long), drawn by kit.end over whatever is drawn
// after the box. In the list a click chooses, the wheel scrolls, and
// through kit.key Up, Down, Enter and Escape work and typing goes to the
// first item that starts so; a press outside closes it and does nothing
// else. True in the frame `chosen` (the caller's) changed.
pub fn comboBox(kit: *Kit, id: u64, area: ui.Rect, items: []const []const u8, chosen: *usize) -> bool {
    return comboBoxKinds(kit, id, area, items.length, sliceName, null, @intFromPtr(items.pointer), chosen)
}

// A comboBox whose `count` items are named by `name` (handed `context`):
// for lists that are tables of something else (blend modes).
pub fn comboBoxWith(kit: *Kit, id: u64, area: ui.Rect, count: usize, name: ListName, context: usize, chosen: *usize) -> bool {
    return comboBoxKinds(kit, id, area, count, name, null, context, chosen)
}

// A comboBoxWith whose rows have kinds (`kind`; null: all items): a
// LIST_SEPARATOR is a line and a LIST_HEADING a group's name, neither to
// be chosen. Names and kinds are asked for in the frame they are drawn
// in, from here and from kit.end: what `context` points at lasts that
// long.
pub fn comboBoxKinds(kit: *Kit, id: u64, area: ui.Rect, count: usize, name: ListName, kind: ?ListKind, context: usize, chosen: *usize) -> bool {
    const widgets = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    var changed = false
    if kit.*.pickId == id {
        kit.*.pickId = NONE
        if kit.*.pick < count && kit.*.pick != chosen.* {
            chosen.* = kit.*.pick
            changed = true
            kit.*.releasedId = id
        }
    }
    view.region(widgets, id, area)
    if view.takeClick(widgets, id) && kit.*.listId != id {
        closeList(kit)
        kit.*.listId = id
        kit.*.listCursor = chosen.*
        kit.*.listScroll = 0
        kit.*.listReveal = true
        // As wide as the widest row needs.
        var widest: i32 = 0
        var index: usize = 0
        while index < count {
            const wide = text_module.measure(kit.*.small, name(context, index))
            if wide > widest { widest = wide }
            index += 1
        }
        kit.*.listWidth = widest + 52 * s
    }
    const open = kit.*.listId == id
    if open {
        kit.*.listArea = area
        kit.*.listCount = count
        kit.*.listName = name
        kit.*.listKind = kind
        kit.*.listContext = context
        kit.*.listChosen = chosen.*
        kit.*.listSeen = kit.*.frame
    }
    const lit = open || view.isHover(widgets, id) || held(kit, id)
    const canvas = widgets.*.canvas
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + s, if lit { theme.*.buttonHover } else { theme.*.button })
    if chosen.* < count { drawLabel(kit, kit.*.small, name(context, chosen.*), ui.rect(area.x + 8 * s, area.y, area.width - 30 * s, area.height), theme.*.text, ALIGN_LEFT) }
    glyphs.arrowScaled(canvas, ui.right(area) - 17 * s, area.y + (area.height - 10 * s) / 2, true, if lit { theme.*.text } else { theme.*.dim }, s)
    return changed
}

// The next row to choose from `from` on, forward or back; `from` when
// there is none.
fn listNeighbour(kit: *Kit, from: usize, forward: bool) -> usize {
    var index = from
    while true {
        if forward {
            if index + 1 >= kit.*.listCount { return from }
            index += 1
        } else {
            if index == 0 { return from }
            index -= 1
        }
        if listKindOf(kit, index) == LIST_ITEM { return index }
    }
}

fn lowered(byte: u8) -> u8 {
    return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

// The first item whose name starts with what was typed (letters of
// either case alike); null when none does.
fn listTyped(kit: *Kit) -> ?usize {
    var index: usize = 0
    while index < kit.*.listCount {
        const name = listNameOf(kit, index)
        if listKindOf(kit, index) == LIST_ITEM && name.length >= kit.*.typedLength {
            var same: usize = 0
            while same < kit.*.typedLength && lowered(name[same]) == lowered(kit.*.typed[same]) { same += 1 }
            if same == kit.*.typedLength { return index }
        }
        index += 1
    }
    return null
}

// A row was chosen: its box takes it in its next frame.
fn listPick(kit: *Kit, index: usize) -> void {
    kit.*.pickId = kit.*.listId
    kit.*.pick = index
    kit.*.pickFrame = kit.*.frame
    closeList(kit)
    kit.*.ui.*.changed = true
    wish(kit, 0)
}

// The keys since the last frame: the cursor moved (and kept in view of a
// list `viewport` tall), a typed start found, Enter choosing.
fn listKeys(kit: *Kit, viewport: i32) -> void {
    const count = kit.*.listCount
    var cursor = if kit.*.listCursor < count { kit.*.listCursor } else { 0 }
    const before = cursor
    if kit.*.listJump == JUMP_FIRST {
        cursor = 0
        if listKindOf(kit, 0) != LIST_ITEM { cursor = listNeighbour(kit, 0, true) }
    } else if kit.*.listJump == JUMP_LAST {
        cursor = count - 1
        if listKindOf(kit, cursor) != LIST_ITEM { cursor = listNeighbour(kit, cursor, false) }
    }
    var steps = kit.*.listMove
    while steps != 0 {
        const next = listNeighbour(kit, cursor, steps > 0)
        if next == cursor { break }
        cursor = next
        steps += if steps > 0 { -1 } else { 1 }
    }
    if kit.*.typedNew && kit.*.typedLength > 0 {
        const found = listTyped(kit)
        if found != null { cursor = found.? }
    }
    kit.*.listMove = 0
    kit.*.listJump = JUMP_NONE
    kit.*.typedNew = false
    kit.*.listCursor = cursor
    if cursor != before || kit.*.listReveal {
        kit.*.listReveal = false
        var top: i32 = 0
        var index: usize = 0
        while index < cursor {
            top +|= listRowHeight(kit, listKindOf(kit, index))
            index += 1
        }
        const tall = listRowHeight(kit, listKindOf(kit, cursor))
        if top < kit.*.listScroll { kit.*.listScroll = top }
        if top +| tall > kit.*.listScroll +| viewport { kit.*.listScroll = (top +| tall) - viewport }
    }
    if kit.*.listEnter {
        kit.*.listEnter = false
        if listKindOf(kit, cursor) == LIST_ITEM { listPick(kit, cursor) }
    }
}

// One row of the open list in `row`; true when it was clicked.
fn listRowDrawn(kit: *Kit, index: usize, kind: u8, row: ui.Rect) -> bool {
    const context = kit.*.ui
    const theme = kit.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    if kind == LIST_SEPARATOR {
        canvas_module.fillRect(canvas, row.x + 4 * s, row.y + row.height / 2, row.width - 8 * s, s, theme.*.popupBorder)
        return false
    }
    if kind == LIST_HEADING {
        drawLabel(kit, kit.*.small, listNameOf(kit, index), ui.rect(row.x + 8 * s, row.y + 2 * s, row.width - 14 * s, row.height - 2 * s), theme.*.dim, ALIGN_LEFT)
        return false
    }
    const row_id = view.idOf(kit.*.listId, PARTS + index)
    view.region(context, row_id, row)
    if index == kit.*.listCursor {
        canvas_module.fillRoundedRect(canvas, row.x, row.y, row.width, row.height, theme.*.smallRadius + s, theme.*.menuChosen)
    } else if view.isHover(context, row_id) {
        canvas_module.fillRoundedRect(canvas, row.x, row.y, row.width, row.height, theme.*.smallRadius + s, theme.*.menuHover)
    }
    if index == kit.*.listChosen { glyphs.checkScaled(canvas, row.x + 3 * s, row.y + (row.height - 14 * s) / 2, theme.*.text, s) }
    drawLabel(kit, kit.*.small, listNameOf(kit, index), ui.rect(row.x + 22 * s, row.y, row.width - 28 * s, row.height), theme.*.text, ALIGN_LEFT)
    return view.takeClick(context, row_id)
}

fn drawList(kit: *Kit) -> void {
    if kit.*.listId == NONE { return }
    // Its box was not drawn in this frame: the list goes with it.
    if kit.*.listSeen != kit.*.frame || kit.*.listCount == 0 {
        closeList(kit)
        return
    }
    const context = kit.*.ui
    const s = kit.*.theme.*.scale
    const count = kit.*.listCount
    var content: i32 = 0
    var index: usize = 0
    while index < count {
        content +|= listRowHeight(kit, listKindOf(kit, index))
        index += 1
    }
    // Under the box, or over it when there is more room there and not
    // enough below; as tall as its rows or as the room.
    const window = windowOf(kit)
    const anchor = kit.*.listArea
    const pad = 4 * s
    const below = window.height - ui.bottom(anchor) - 6 * s
    const above = anchor.y - 6 * s
    var height = content +| pad * 2
    const over = height > below && above > below
    const most = if over { above } else { below }
    if height > most { height = most }
    if height < px(kit, LIST_ROW) + pad * 2 { height = px(kit, LIST_ROW) + pad * 2 }
    var width = if kit.*.listWidth > anchor.width { kit.*.listWidth } else { anchor.width }
    if width > window.width - 8 * s { width = window.width - 8 * s }
    var x = anchor.x
    if x + width > window.width - 4 * s { x = window.width - 4 * s - width }
    if x < 4 * s { x = 4 * s }
    const box = ui.rect(x, if over { anchor.y - 2 * s - height } else { ui.bottom(anchor) + 2 * s }, width, height)
    const inner = ui.rect(box.x + pad, box.y + pad, box.width - pad * 2, box.height - pad * 2)
    listKeys(kit, inner.height)
    if kit.*.listId == NONE { return }
    // The whole window under the list is the list's: a press beside it
    // closes it and reaches nothing else.
    const catch_id = view.idOf(kit.*.listId, PART_CATCH)
    view.region(context, catch_id, window)
    if held(kit, catch_id) || view.takeClick(context, catch_id) {
        closeList(kit)
        context.*.changed = true
        return
    }
    popupBox(kit, box)
    view.region(context, view.idOf(kit.*.listId, PART_FRAME), box)
    if kit.*.wheel != 0 {
        kit.*.listScroll +|= kit.*.wheel *| px(kit, LIST_ROW * 3)
        kit.*.wheel = 0
        context.*.changed = true
    }
    clampOffset(&kit.*.listScroll, content, inner.height)
    const bar = if content > inner.height { px(kit, SCROLL_BAR) } else { 0 }
    const rows = ui.rect(inner.x, inner.y, inner.width - bar, inner.height)
    var picked: ?usize = null
    clipBegin(kit, rows)
    var top = rows.y - kit.*.listScroll
    index = 0
    while index < count && top < ui.bottom(rows) {
        const kind = listKindOf(kit, index)
        const tall = listRowHeight(kit, kind)
        if top + tall > rows.y {
            if listRowDrawn(kit, index, kind, ui.rect(rows.x, top, rows.width, tall)) { picked = index }
        }
        top += tall
        index += 1
    }
    clipEnd(kit)
    if bar > 0 { scrollBar(kit, view.idOf(kit.*.listId, PART_BAR), ui.rect(ui.right(inner) - bar, inner.y, bar, inner.height), content, inner.height, &kit.*.listScroll) }
    if picked != null { listPick(kit, picked.?) }
}

fn drawTooltip(kit: *Kit) -> void {
    if !kit.*.tipSeen {
        kit.*.tipId = NONE
        return
    }
    const context = kit.*.ui
    // A press, or a list over the button, starts the wait again.
    if context.*.pointerDown || kit.*.listId != NONE || kit.*.time < kit.*.tipSince {
        kit.*.tipSince = kit.*.time
        return
    }
    const waited = kit.*.time - kit.*.tipSince
    if waited < TIP_MS {
        wish(kit, TIP_MS - waited)
        return
    }
    if context.*.canvas.*.width == 0 { return }
    // Under the button (over it when there is no room below), inside the
    // window; a long text in several lines.
    const theme = kit.*.theme
    const s = theme.*.scale
    const font = kit.*.small
    const line_height = font.*.ascent * 3 / 2 + 2 * s
    const padding = 8 * s
    var width = text_module.measure(font, kit.*.tipText) + 2 * s
    if width > 280 * s { width = 280 * s }
    const height = popup.wrappedHeight(font, kit.*.tipText, width, line_height, 12) + padding * 2 - 2 * s
    const window = windowOf(kit)
    const area = kit.*.tipArea
    var x = area.x
    var y = ui.bottom(area) + 6 * s
    if y + height > window.height - 4 * s && area.y - 6 * s - height >= 4 * s { y = area.y - 6 * s - height }
    if x + width + padding * 2 > window.width - 4 * s { x = window.width - 4 * s - width - padding * 2 }
    if x < 4 * s { x = 4 * s }
    popupBox(kit, ui.rect(x, y, width + padding * 2, height))
    _ = popup.wrapped(context, font, kit.*.tipText, x + padding, y + padding - s, width, line_height, 12, theme.*.text)
}

// ---------------------------------------------------------------------------
// Tabs, splitters, list rows

// A row of small tabs (a stack of dockers): the chosen one lit, a click
// chooses another (`chosen`, the caller's). True when it changed. Tabs
// that do not fit share the width, their names cut.
pub fn tabs(kit: *Kit, id: u64, area: ui.Rect, items: []const []const u8, chosen: *usize) -> bool {
    const context = kit.*.ui
    const theme = kit.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    canvas_module.fillRect(canvas, area.x, ui.bottom(area) - s, area.width, s, theme.*.divider)
    if items.length == 0 { return false }
    var total: i32 = 0
    for item in items { total += text_module.measure(kit.*.small, item) + 22 * s }
    const share = area.width / @intCast(i32, items.length)
    var changed = false
    var x = area.x
    var index: usize = 0
    while index < items.length {
        const natural = text_module.measure(kit.*.small, items[index]) + 22 * s
        const wide = if total > area.width { share } else { natural }
        const tab = ui.rect(x, area.y, wide, area.height - s)
        const tab_id = view.idOf(id, PARTS + index)
        view.region(context, tab_id, tab)
        if view.takeClick(context, tab_id) && chosen.* != index {
            chosen.* = index
            changed = true
        }
        const lit = view.isHover(context, tab_id) || held(kit, tab_id)
        if index == chosen.* {
            canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, tab.height + s, theme.*.raised)
            canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, 2 * s, theme.*.accent)
        } else if lit {
            canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, tab.height, theme.*.hover)
        }
        drawLabel(kit, kit.*.small, items[index], ui.rect(tab.x + 8 * s, tab.y + s, tab.width - 16 * s, tab.height - s), if index == chosen.* || lit { theme.*.text } else { theme.*.dim }, ALIGN_CENTER)
        x += wide
        index += 1
    }
    return changed
}

// A grip between two panels in `area`. `vertical`: it stands upright
// between a left and a right panel and is dragged sideways; else it lies
// between an upper and a lower one. While it is dragged: how many pixels
// the pointer moved (right or down) since the last frame, for the caller
// to add to a panel's size; else 0. released(kit, id) when it is let go.
pub fn splitter(kit: *Kit, id: u64, area: ui.Rect, vertical: bool) -> i32 {
    const context = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    view.region(context, id, area)
    var moved: i32 = 0
    const down = held(kit, id)
    if down {
        if !pressStarted(kit, id) {
            moved = if vertical { context.*.pointerX - kit.*.dragLastX } else { context.*.pointerY - kit.*.dragLastY }
        }
        kit.*.dragLastX = context.*.pointerX
        kit.*.dragLastY = context.*.pointerY
        if moved != 0 { context.*.changed = true }
    }
    const lit = down || view.isHover(context, id)
    const thick = if lit { 2 * s } else { s }
    const color = if lit { theme.*.accent } else { theme.*.divider }
    if vertical {
        canvas_module.fillRect(context.*.canvas, area.x + (area.width - thick) / 2, area.y, thick, area.height, color)
    } else {
        canvas_module.fillRect(context.*.canvas, area.x, area.y + (area.height - thick) / 2, area.width, thick, color)
    }
    return moved
}

// A list row's background in `area` (the caller draws what is in it,
// and names its parts after this): lit when `chosen`, fainter under the
// pointer or when `lit` (a part of it is). ROW_CLICKED when clicked,
// ROW_DOUBLE_CLICKED for the second click of two close together; the end
// of a drag (dragRow) is no click.
pub fn listRow(kit: *Kit, id: u64, area: ui.Rect, chosen: bool, lit: bool) -> u8 {
    const context = kit.*.ui
    const theme = kit.*.theme
    view.region(context, id, area)
    if chosen {
        canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.menuChosen)
    } else if lit || view.isHover(context, id) {
        canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.hover)
    }
    if !view.takeClick(context, id) { return ROW_NONE }
    if kit.*.releasedId == id && kit.*.releasedMoved { return ROW_NONE }
    const double = kit.*.lastClickId == id && since(kit, kit.*.lastClickTime) <= DOUBLE_MS
    kit.*.lastClickId = if double { NONE } else { id }
    kit.*.lastClickTime = kit.*.time
    return if double { ROW_DOUBLE_CLICKED } else { ROW_CLICKED }
}

// The arrow that folds a row's children, at (x, y); a click changes
// `open` (the caller's). True when it did.
pub fn expander(kit: *Kit, id: u64, x: i32, y: i32, open: *bool) -> bool {
    const context = kit.*.ui
    const s = kit.*.theme.*.scale
    view.region(context, id, ui.rect(x - 4 * s, y - 3 * s, 16 * s, 16 * s))
    glyphs.arrowScaled(context.*.canvas, x, y, open.*, if view.isHover(context, id) { kit.*.theme.*.text } else { kit.*.theme.*.dim }, s)
    if !view.takeClick(context, id) { return false }
    open.* = !open.*
    return true
}

// Whether the row `id` (a listRow's id, drawn at `area`) is being
// dragged: true from when the pointer, held down on it, has moved more
// than 4 pixels, until it is let go; the row is outlined meanwhile. The
// caller finds where it would go from the pointer, draws dropLine there,
// and moves it when dropped(kit, id).
pub fn dragRow(kit: *Kit, id: u64, area: ui.Rect) -> bool {
    if !held(kit, id) { return false }
    const context = kit.*.ui
    _ = pressStarted(kit, id)
    if !kit.*.dragMoved {
        const dx = view.dragX(context)
        const dy = view.dragY(context)
        const slack = px(kit, 4)
        // (Saturating: a held pointer may be reported far outside.)
        if (dx *| dx) +| (dy *| dy) <= slack * slack { return false }
        kit.*.dragMoved = true
    }
    const theme = kit.*.theme
    canvas_module.strokeRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.scale, theme.*.accent)
    return true
}

// The mark of where a dragged row would go: a line from x0 to x1 at y
// (between two rows).
pub fn dropLine(kit: *Kit, y: i32, x0: i32, x1: i32) -> void {
    const canvas = kit.*.ui.*.canvas
    const s = kit.*.theme.*.scale
    const accent = kit.*.theme.*.accent
    canvas_module.fillRect(canvas, x0, y - s, x1 - x0, 2 * s, accent)
    canvas_module.fillRoundedRect(canvas, x0 - 3 * s, y - 3 * s, 6 * s, 6 * s, 3 * s, accent)
    canvas_module.fillRoundedRect(canvas, x1 - 3 * s, y - 3 * s, 6 * s, 6 * s, 3 * s, accent)
}

// ---------------------------------------------------------------------------
// Colours

// The edge that keeps a swatch a square whatever its colour and the
// panel's.
fn swatchEdge() -> u32 { return canvas_module.color(110, 128, 128, 128) }

// A rounded square showing `color` (straight 0xAARRGGBB; over small
// squares where it is translucent), ringed when `chosen`, edged under the
// pointer. True when clicked.
pub fn colorSwatch(kit: *Kit, id: u64, area: ui.Rect, color: u32, chosen: bool) -> bool {
    const context = kit.*.ui
    const theme = kit.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    view.region(context, id, area)
    const radius = theme.*.smallRadius
    fillSwatch(canvas, area, radius, color, 4 * s)
    if chosen {
        // Light outside, dark inside: seen on any colour.
        canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, 2 * s, theme.*.text)
        canvas_module.strokeRoundedRect(canvas, area.x + 2 * s, area.y + 2 * s, area.width - 4 * s, area.height - 4 * s, radius - s, s, theme.*.background)
    } else {
        canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, s, if view.isHover(context, id) { theme.*.text } else { swatchEdge() })
    }
    return view.takeClick(context, id)
}

// The two colours a painting program paints with, in `area` (a square):
// the foreground's square over the corner of the background's, an arrow
// that swaps them at the upper right and a mark that sets them back to
// black and white at the lower left. What was clicked: PAIR_FOREGROUND,
// PAIR_BACKGROUND (the caller opens its colour chooser), PAIR_SWAP,
// PAIR_RESET, or PAIR_NONE. Colours are straight 0xAARRGGBB.
pub fn colorPair(kit: *Kit, id: u64, area: ui.Rect, foreground: u32, background: u32) -> u8 {
    const context = kit.*.ui
    const theme = kit.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    const side = if area.width < area.height { area.width } else { area.height }
    const box = side * 5 / 8
    const corner = side - box - 2 * s
    const front = ui.rect(area.x, area.y, box, box)
    const back = ui.rect(area.x + side - box, area.y + side - box, box, box)
    const swap = ui.rect(area.x + side - corner, area.y, corner, corner)
    const reset = ui.rect(area.x, area.y + side - corner, corner, corner)
    const front_id = view.idOf(id, PART_FOREGROUND)
    const back_id = view.idOf(id, PART_BACKGROUND)
    const swap_id = view.idOf(id, PART_SWAP)
    const reset_id = view.idOf(id, PART_RESET)
    view.region(context, back_id, back)
    view.region(context, front_id, front)
    view.region(context, swap_id, swap)
    view.region(context, reset_id, reset)
    const radius = theme.*.smallRadius
    fillSwatch(canvas, back, radius, background, 4 * s)
    canvas_module.strokeRoundedRect(canvas, back.x, back.y, back.width, back.height, radius, s, if view.isHover(context, back_id) { theme.*.text } else { swatchEdge() })
    // (A gap in the panel's colour keeps the two apart.)
    canvas_module.fillRoundedRect(canvas, front.x - s, front.y - s, front.width + 2 * s, front.height + 2 * s, radius + s, theme.*.panel)
    fillSwatch(canvas, front, radius, foreground, 4 * s)
    canvas_module.strokeRoundedRect(canvas, front.x, front.y, front.width, front.height, radius, s, if view.isHover(context, front_id) { theme.*.text } else { swatchEdge() })
    // The swap arrow: a bent line with a head at each end, pointing at
    // the two squares.
    const ink = if view.isHover(context, swap_id) { theme.*.text } else { theme.*.dim }
    const unit = @floatFromInt(f64, corner) / 12.0
    const sx = @floatFromInt(f64, swap.x)
    const sy = @floatFromInt(f64, swap.y)
    const weight = @floatFromInt(f64, s) * 1.3
    line(canvas, sx + 2.0 * unit, sy + 3.5 * unit, sx + 8.5 * unit, sy + 3.5 * unit, ink, weight)
    line(canvas, sx + 8.5 * unit, sy + 3.5 * unit, sx + 8.5 * unit, sy + 10.0 * unit, ink, weight)
    line(canvas, sx + 2.0 * unit, sy + 3.5 * unit, sx + 4.5 * unit, sy + 1.0 * unit, ink, weight)
    line(canvas, sx + 2.0 * unit, sy + 3.5 * unit, sx + 4.5 * unit, sy + 6.0 * unit, ink, weight)
    line(canvas, sx + 8.5 * unit, sy + 10.0 * unit, sx + 6.0 * unit, sy + 7.5 * unit, ink, weight)
    line(canvas, sx + 8.5 * unit, sy + 10.0 * unit, sx + 11.0 * unit, sy + 7.5 * unit, ink, weight)
    // The reset mark: black over white, small.
    const small = corner * 5 / 9
    const edge = if view.isHover(context, reset_id) { theme.*.text } else { theme.*.dim }
    canvas_module.fillRect(canvas, reset.x + corner - small - s, reset.y + corner - small - s, small, small, 0xFFFFFFFF)
    frame(canvas, ui.rect(reset.x + corner - small - s, reset.y + corner - small - s, small, small), edge)
    canvas_module.fillRect(canvas, reset.x + s, reset.y + s, small, small, 0xFF000000)
    frame(canvas, ui.rect(reset.x + s, reset.y + s, small, small), edge)
    if view.takeClick(context, swap_id) { return PAIR_SWAP }
    if view.takeClick(context, reset_id) { return PAIR_RESET }
    if view.takeClick(context, front_id) { return PAIR_FOREGROUND }
    if view.takeClick(context, back_id) { return PAIR_BACKGROUND }
    return PAIR_NONE
}

// ---------------------------------------------------------------------------
// A grid of cells, progress

// A scrolled grid of `count` cells of cell_width x cell_height in `area`
// (as many columns as fit), each drawn by `draw` (handed `context`):
// brush presets, a palette, patterns. `chosen` is outlined (NOTHING:
// none), the cell under the pointer faintly; `offset` is the scroll
// offset (the caller's). Returns the cell clicked in this frame, or null.
// Only the cells in view are drawn and named as regions.
pub fn grid(kit: *Kit, id: u64, area: ui.Rect, cell_width: i32, cell_height: i32, count: usize, chosen: usize, offset: *i32, draw: CellDraw, context: usize) -> ?usize {
    var clicked: ?usize = null
    if cell_width <= 0 || cell_height <= 0 || area.width <= 0 || area.height <= 0 { return clicked }
    const widgets = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    // (The bar's width is kept free always: the columns do not jump when
    // it appears.)
    const fitting = (area.width - px(kit, SCROLL_BAR)) / cell_width
    const columns = @intCast(usize, if fitting < 1 { 1 } else { fitting })
    const rows = count / columns + (if count % columns != 0 { 1 } else { 0 })
    // (More rows than an i32 of pixels holds are not scrolled to.)
    const tall = @intCast(u64, rows) * @intCast(u64, cell_height)
    const content = scrollBegin(kit, id, area, @intCast(i32, if tall > 1073741824 { 1073741824 } else { tall }), offset)
    const canvas = widgets.*.canvas
    var row = @intCast(usize, offset.* / cell_height)
    const row_end = @intCast(usize, (offset.* + area.height + cell_height - 1) / cell_height)
    while row < row_end && row < rows {
        var column: usize = 0
        while column < columns && row * columns + column < count {
            const index = row * columns + column
            const cell = ui.rect(content.x + @intCast(i32, column) * cell_width, content.y + @intCast(i32, row) * cell_height, cell_width, cell_height)
            const cell_id = view.idOf(id, PARTS + index)
            view.region(widgets, cell_id, cell)
            const lit = view.isHover(widgets, cell_id)
            if canvas.*.width > 0 { draw(context, index, canvas, cell, lit) }
            if index == chosen {
                canvas_module.strokeRoundedRect(canvas, cell.x, cell.y, cell.width, cell.height, theme.*.smallRadius, 2 * s, theme.*.accent)
            } else if lit {
                canvas_module.strokeRoundedRect(canvas, cell.x, cell.y, cell.width, cell.height, theme.*.smallRadius, s, theme.*.border)
            }
            if view.takeClick(widgets, cell_id) { clicked = index }
            column += 1
        }
        row += 1
    }
    scrollEnd(kit)
    return clicked
}

// A bar `fraction` (0..1) full.
pub fn progress(kit: *Kit, area: ui.Rect, fraction: f64) -> void {
    const theme = kit.*.theme
    const part = if fraction != fraction { 0.0 } else { math.clamp(fraction, 0.0, 1.0) }
    const filled = @intFromFloat(i32, part * @floatFromInt(f64, area.width) + 0.5)
    fillBands(kit.*.ui.*.canvas, area, area.height / 2, 0, filled, theme.*.accent, theme.*.track)
}

// A bar that is busy with something of unknown length: a piece of it
// runs along; it asks for frames while it is drawn (kit.end).
pub fn busy(kit: *Kit, area: ui.Rect) -> void {
    const theme = kit.*.theme
    const piece = area.width / 3
    const lap = @intCast(u64, if area.width + piece > 0 { area.width + piece } else { 1 })
    const at = @intCast(i32, (kit.*.time % 1400) * lap / 1400) - piece
    fillBands(kit.*.ui.*.canvas, area, area.height / 2, at, at + piece, theme.*.accent, theme.*.track)
    wish(kit, 33)
}

// ---------------------------------------------------------------------------
// The curve editor

fn curveX(plot: ui.Rect, x: f64) -> f64 {
    return @floatFromInt(f64, plot.x) + x * @floatFromInt(f64, plot.width - 1) + 0.5
}

fn curveY(plot: ui.Rect, y: f64) -> f64 {
    return @floatFromInt(f64, ui.bottom(plot) - 1) - y * @floatFromInt(f64, plot.height - 1) + 0.5
}

// A response curve over a grid of 0..1 x 0..1 in `area`: `count.*`
// points (xs ascending; kit_curve.mlx says what curve runs through them,
// and computes it for whoever uses it) of `capacity` at most
// (CURVE_POINTS at most). A point's handle is dragged (its x stays
// between its neighbours); a press on the curve adds a point there and
// drags it; a point dragged far out of the editor is removed (never the
// first or the last). True when the points changed in this frame;
// released(kit, id) when a drag ended.
pub fn curveEditor(kit: *Kit, id: u64, area: ui.Rect, xs: [*]f32, ys: [*]f32, count: *usize, capacity: usize) -> bool {
    const context = kit.*.ui
    const theme = kit.*.theme
    const canvas = context.*.canvas
    const s = theme.*.scale
    view.region(context, id, area)
    // The plot leaves room for a handle at every edge.
    const margin = 6 * s
    const plot = ui.rect(area.x + margin, area.y + margin, area.width - margin * 2, area.height - margin * 2)
    if plot.width < 2 || plot.height < 2 { return false }
    var changed = false
    var spline: kit_curve.Spline = undefined
    kit_curve.prepare(&spline, xs, ys, count.*)
    const pointer_x = @floatFromInt(f64, context.*.pointerX) + 0.5
    const pointer_y = @floatFromInt(f64, context.*.pointerY) + 0.5
    const at_x = math.clamp((pointer_x - curveX(plot, 0.0)) / @floatFromInt(f64, plot.width - 1), 0.0, 1.0)
    const at_y = math.clamp((curveY(plot, 0.0) - pointer_y) / @floatFromInt(f64, plot.height - 1), 0.0, 1.0)
    // The handle nearest the pointer, when near enough to take.
    const grab = @floatFromInt(f64, CURVE_GRAB * s)
    var near: usize = NOTHING
    var near_distance = grab * grab
    var index: usize = 0
    while index < count.* {
        const dx = curveX(plot, @floatCast(f64, xs[index])) - pointer_x
        const dy = curveY(plot, @floatCast(f64, ys[index])) - pointer_y
        if dx * dx + dy * dy <= near_distance {
            near_distance = dx * dx + dy * dy
            near = index
        }
        index += 1
    }
    const down = held(kit, id)
    if down && pressStarted(kit, id) {
        // dragPart: the point taken, counted from 1 (0: none).
        if near != NOTHING {
            kit.*.dragPart = near + 1
        } else if math.abs(curveY(plot, kit_curve.at(&spline, at_x)) - pointer_y) <= grab && ui.contains(area, context.*.pointerX, context.*.pointerY) {
            const added = kit_curve.insert(xs, ys, count, capacity, @floatCast(f32, at_x), @floatCast(f32, at_y))
            if added != null {
                kit.*.dragPart = added.? + 1
                changed = true
            }
        }
        kit.*.dragInert = kit.*.dragPart == 0
    }
    if down && kit.*.dragId == id && kit.*.dragPart > 0 && kit.*.dragPart <= count.* {
        const point = kit.*.dragPart - 1
        const out = CURVE_OUT * s
        const far = context.*.pointerX < area.x - out || context.*.pointerX >= ui.right(area) + out || context.*.pointerY < area.y - out || context.*.pointerY >= ui.bottom(area) + out
        if far && kit_curve.remove(xs, ys, count, point) {
            kit.*.dragPart = 0
            changed = true
        } else if kit_curve.move(xs, ys, count.*, point, @floatCast(f32, at_x), @floatCast(f32, at_y)) {
            changed = true
        }
    }
    if changed {
        kit_curve.prepare(&spline, xs, ys, count.*)
        context.*.changed = true
    }
    if canvas.*.width == 0 { return changed }
    // The ground, a grid of quarters and the diagonal of "no change".
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.field)
    const faint = theme_module.mix(theme.*.field, theme.*.border, 200)
    var quarter: i32 = 0
    while quarter <= 4 {
        const part = @floatFromInt(f64, quarter) / 4.0
        canvas_module.fillRect(canvas, floorInt(curveX(plot, part)), plot.y, 1, plot.height, faint)
        canvas_module.fillRect(canvas, plot.x, floorInt(curveY(plot, part)), plot.width, 1, faint)
        quarter += 1
    }
    line(canvas, curveX(plot, 0.0), curveY(plot, 0.0), curveX(plot, 1.0), curveY(plot, 1.0), faint, 1.0)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, s, edgeColor(kit, view.isHover(context, id) || down))
    // The curve: its value at every pixel column, joined by short lines.
    const weight = @floatFromInt(f64, s) * 1.5
    var column: i32 = 0
    var last_y = curveY(plot, kit_curve.at(&spline, 0.0))
    while column + 1 < plot.width {
        const next = @floatFromInt(f64, column + 1) / @floatFromInt(f64, plot.width - 1)
        const next_y = curveY(plot, kit_curve.at(&spline, next))
        const x0 = @floatFromInt(f64, plot.x + column) + 0.5
        line(canvas, x0, last_y, x0 + 1.0, next_y, theme.*.text, weight)
        last_y = next_y
        column += 1
    }
    // The handles; the one taken, or the one that a press would take, lit.
    const taken = if down && kit.*.dragId == id && kit.*.dragPart > 0 { kit.*.dragPart - 1 } else if !down && view.isHover(context, id) { near } else { NOTHING }
    const size = 7 * s
    index = 0
    while index < count.* {
        const hx = floorInt(curveX(plot, @floatCast(f64, xs[index]))) - size / 2
        const hy = floorInt(curveY(plot, @floatCast(f64, ys[index]))) - size / 2
        canvas_module.fillRoundedRect(canvas, hx - s, hy - s, size + 2 * s, size + 2 * s, (size + 2 * s) / 2, theme.*.field)
        canvas_module.fillRoundedRect(canvas, hx, hy, size, size, size / 2, if index == taken { theme.*.accent } else { theme.*.text })
        index += 1
    }
    return changed
}
