// nebula ui: the kit: the widgets nebula's dockers, dialogs and tool
// options are built from, beyond std.ui.controls: a slider with its label
// and number in it that also takes a typed number, spin boxes, a text
// box, drop-down lists, tabs, splitters, list rows, colour swatches, a
// grid of cells, a curve editor, tool buttons with tooltips, and clipping
// and scrolling for all of it. It knows nothing of documents: it builds on
// std.ui (immediate mode: a widget is a function called each frame, which
// draws itself, names its rectangle with an id and says what happened) and
// on core/pixel.mlx.
//
// A Kit (made once, in heap memory) keeps what widgets share between
// frames: the one text edit that is open, the drag in progress, the open
// list, how long the pointer has rested on a button. A frame:
//
//     view.begin(widgets, canvas)
//     kit.begin(k, widgets, canvas, &theme, body, small, mono, std.time.milliseconds(), german)
//     if kit.slider(k, ID_SIZE, row, "Size", &brush.size, &SIZE) { ... }
//     if kit.released(k, ID_SIZE) { ...one undo step... }
//     if kit.comboBox(k, ID_MODE, row2, MODES[0..], &mode) { ... }
//     const again = kit.end(k)          // draws the open list and the tooltip on top
//     if view.end(widgets) || again { redraw }
//
// and, from the window's events (std.ui.app.feed hands the widgets only
// the pointer's left button and the wheel):
//
//     kit.setModifiers(k, host.modifiers(h))                 // Shift makes a slider fine
//     if kit.key(k, code, modifiers, typed) { redraw; return }   // an open edit or list took the key
//     if !kit.wantsKeys(k) { ...the app's shortcuts... }
//     kit.secondaryClick(k, x, y)                            // the right button: a slider's number is typed
//     kit.dismiss(k)                                         // a press the widgets do not see (on the picture)
//
// Every widget takes the Kit, its id (a u64 as std.ui.view's; a widget
// with parts derives their ids from it) and a ui.Rect, and keeps the
// caller's side to a pointer to the value. Sizes are for rows of ROW
// pixels in the small font, times the theme's scale. Colours given to
// widgets (colorSwatch, colorPair, fillStraight) are straight 0xAARRGGBB
// as the engine's; those given to the drawing set (line, hline, frame)
// are premultiplied as std.ui.canvas's.
//
// Drawing is on the CPU canvas (nebula asks for it): the kit reads and
// writes its pixels. On a layout pass (view.layoutCanvas(): no pixels)
// every widget still names its regions and takes its input, and nothing
// is drawn; the callbacks that draw an icon or a cell are not called.
// Inside clipBegin .. clipEnd (and scrollBegin .. scrollEnd) the canvas
// to draw on is canvasOf(kit), not the window's.
//
// Not done: copy and paste in a text edit (std.ui.field has none; the
// window's clipboard is the app's), a horizontal scroll bar, keys moving
// between widgets (Tab ends an edit, it does not go to the next), more
// than one open text edit or list at a time.
const std = @import("std")
const math = @import("std.math")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("std.ui.keys")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const field_module = @import("std.ui.field")
const popup = @import("std.ui.popup")
const glyphs = @import("std.ui.glyphs")
const pixel = @import("../core/pixel.mlx")
const kit_text = @import("./kit_text.mlx")
const kit_curve = @import("./kit_curve.mlx")

pub const Allocator = std.allocator.Allocator
pub const Canvas = canvas_module.Canvas
pub const Text = text_module.Text
pub const Theme = theme_module.Theme
const Ui = view.Ui
const NONE = view.NONE

// The height (times the theme's scale) the widgets are made for.
pub const ROW: i32 = 24

// Label colours (label's `kind`).
pub const TEXT_NORMAL: u8 = 0
pub const TEXT_DIM: u8 = 1
pub const TEXT_ACCENT: u8 = 2
pub const TEXT_DANGER: u8 = 3
pub const TEXT_ON_ACCENT: u8 = 4

// Where a label stands in its rectangle.
pub const ALIGN_LEFT: u8 = 0
pub const ALIGN_CENTER: u8 = 1
pub const ALIGN_RIGHT: u8 = 2

// Button kinds: filled, the primary action, only a background under the
// pointer; `| BUTTON_DISABLED`: drawn faded, taking no click.
pub const BUTTON_NORMAL: u8 = 0
pub const BUTTON_PRIMARY: u8 = 1
pub const BUTTON_PLAIN: u8 = 2
pub const BUTTON_DISABLED: u8 = 128

// What textBox says of a frame.
pub const TEXT_NONE: u8 = 0
pub const TEXT_EDITED: u8 = 1
pub const TEXT_SUBMITTED: u8 = 2
pub const TEXT_CANCELLED: u8 = 3

// What listRow says.
pub const ROW_NONE: u8 = 0
pub const ROW_CLICKED: u8 = 1
pub const ROW_DOUBLE_CLICKED: u8 = 2

// What colorPair says.
pub const PAIR_NONE: u8 = 0
pub const PAIR_FOREGROUND: u8 = 1
pub const PAIR_BACKGROUND: u8 = 2
pub const PAIR_SWAP: u8 = 3
pub const PAIR_RESET: u8 = 4

// Kinds of a drop-down list's rows (a ListKind callback's answer): one to
// choose, a line between groups, a group's heading.
pub const LIST_ITEM: u8 = 0
pub const LIST_SEPARATOR: u8 = 1
pub const LIST_HEADING: u8 = 2

// `chosen` for a grid in which nothing is chosen.
pub const NOTHING: usize = 18446744073709551615

// The most points a curve has (kit_curve's).
pub const CURVE_POINTS: usize = kit_curve.MAX_POINTS

// The bytes formatNumber and ellipsized write into.
pub const NUMBER_ROOM: usize = kit_text.NUMBER_ROOM
pub const TEXT_ROOM: usize = kit_text.TEXT_ROOM

// Draws a button's icon: in the square `size` across at (x, y), in
// `color` (premultiplied). `context` is the caller's (which icon).
pub const IconDraw = fn(context: usize, canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void
// Draws cell `index` of a grid in `cell`; `lit`: the pointer is on it.
pub const CellDraw = fn(context: usize, index: usize, canvas: *Canvas, cell: ui.Rect, lit: bool) -> void
// The name of row `index` of a drop-down list, and its kind (LIST_*).
pub const ListName = fn(context: usize, index: usize) -> []const u8
pub const ListKind = fn(context: usize, index: usize) -> u8

// What a slider or a spin box is told about its number.
pub const SliderOptions = struct {
    // The range a typed number is held in.
    low: f64
    high: f64
    // What the wheel, a stepper and Up and Down change it by.
    step: f64
    // Digits after the point (0: whole numbers); the value is rounded so.
    decimals: usize
    // 1: the bar is linear. Above: its left part is stretched, position =
    // ((value - low) / (high - low)) ^ (1 / exponent): with 3 the left half
    // of a brush size's bar is the smallest eighth of the sizes.
    exponent: f64
    // Written after the number: " px", " %", "°".
    suffix: []const u8
    // The range the bar shows and a drag reaches, when softHigh is above
    // softLow (a size typed up to 10000 on a bar to 1000); else low..high.
    softLow: f64
    softHigh: f64
    // Drawn faded, taking no input.
    disabled: bool
}

// Options with the usual rest: a linear bar over low..high, no suffix.
pub fn sliderOptions(low: f64, high: f64, step: f64, decimals: usize) -> SliderOptions {
    return SliderOptions.{ .low = low, .high = high, .step = step, .decimals = decimals, .exponent = 1.0, .suffix = "", .softLow = 0.0, .softHigh = 0.0, .disabled = false }
}

// Two presses (or clicks) on one thing this close are a double click.
const DOUBLE_MS: u64 = 400
// How long the pointer rests on a button before its tooltip shows.
const TIP_MS: u64 = 600
// A held stepper steps again after this long, then this often.
const REPEAT_FIRST_MS: u64 = 400
const REPEAT_MS: u64 = 60
// Letters typed over a list longer apart than this start a new word.
const TYPED_MS: u64 = 1000
// With Shift a slider moves this much of the pointer's way.
const FINE: f64 = 0.1
// What is disabled shows this much of itself (of 255).
const DISABLED_OPACITY: u32 = 96
// A scroll bar's width, a wheel notch in pixels, a list row's height.
const SCROLL_BAR: i32 = 8
const WHEEL_STEP: i32 = 48
const LIST_ROW: i32 = 24
// A curve's handle is taken within this many pixels; a point dragged this
// far out of the editor is removed.
const CURVE_GRAB: i32 = 9
const CURVE_OUT: i32 = 28
// The squares under a translucent colour.
const CHECK_LIGHT: u32 = 0xFFD2D2D2
const CHECK_DARK: u32 = 0xFF9A9A9A

const LAYERS: usize = 3
const SCROLLS: usize = 4
const TYPED: usize = 32
const NEVER: u32 = 4294967295

// Ids of a widget's parts are view.idOf(id, PART_*); a list's rows and a
// grid's cells follow from PARTS.
const PART_UP: usize = 1
const PART_DOWN: usize = 2
const PART_BAR: usize = 3
const PART_CATCH: usize = 4
const PART_FRAME: usize = 5
const PART_FOREGROUND: usize = 6
const PART_BACKGROUND: usize = 7
const PART_SWAP: usize = 8
const PART_RESET: usize = 9
const PARTS: usize = 16

const EDIT_NUMBER: u8 = 0
const EDIT_TEXT: u8 = 1
// What an open edit waits for its widget to take: nothing, its text to
// be used, the edit to be given up.
const EDIT_OPEN: u8 = 0
const EDIT_COMMIT: u8 = 1
const EDIT_CANCEL: u8 = 2

const JUMP_NONE: u8 = 0
const JUMP_FIRST: u8 = 1
const JUMP_LAST: u8 = 2

// An offscreen canvas of the window's size that drawing goes to between
// clipBegin and clipEnd.
const Layer = struct {
    pixels: [*]u32
    // Pixels the block holds (0: none yet).
    capacity: usize
    canvas: Canvas
    // What was drawn on before, and the part copied in and back.
    saved: *Canvas
    area: ui.Rect
    active: bool
}

const ScrollFrame = struct {
    id: u64
    area: ui.Rect
    content: i32
    offset: *i32
}

pub const Kit = struct {
    allocator: Allocator
    // The frame's (begin sets them).
    ui: *Ui
    theme: *Theme
    body: *Text
    small: *Text
    mono: *Text
    time: u64
    german: bool
    // Frames begun (what was asked of a widget is dropped when it is not
    // drawn within two).
    frame: u64
    // The window's size: resize()'s, else the last canvas's with pixels.
    width: i32
    height: i32
    sized: bool
    // std.ui.keys modifiers held (setModifiers).
    modifiers: u32
    // Milliseconds until the kit wants a frame by itself (NEVER: it does not).
    wakeIn: u32

    // The press being followed: on which id and where it went down, where
    // the pointer was in the last frame, whether it left the threshold, a
    // widget's own start value and place (a slider's position 0..1, a
    // curve's point).
    dragId: u64
    dragPressX: i32
    dragPressY: i32
    dragLastX: i32
    dragLastY: i32
    dragMoved: bool
    dragDouble: bool
    dragInert: bool
    dragValue: f64
    dragPosition: f64
    dragPart: usize
    // The id whose press ended (or whose change is complete) this frame.
    releasedId: u64
    releasedMoved: bool
    // Double clicks: the last press and the last click.
    lastPressId: u64
    lastPressTime: u64
    pressValue: f64
    lastClickId: u64
    lastClickTime: u64
    repeatAt: u64
    // The id the right button went down on, an id whose edit is to open.
    secondaryId: u64
    secondaryFrame: u64
    wantedId: u64
    wantedFrame: u64

    // The open text edit: whose, a number's or a text's, what waits for
    // its widget, Up and Down not applied yet, the value and the text it
    // began with.
    editId: u64
    editKind: u8
    editResult: u8
    editSteps: i32
    editSeen: u64
    editValue: f64
    field: field_module.Field
    original: field_module.Field

    // The open list: whose box, where the box is, its rows (the callbacks
    // of this frame), the row keys move, how far it is scrolled, its width.
    listId: u64
    listArea: ui.Rect
    listCount: usize
    listName: ?ListName
    listKind: ?ListKind
    listContext: usize
    listChosen: usize
    listCursor: usize
    listScroll: i32
    listWidth: i32
    listSeen: u64
    listReveal: bool
    // Keys for it since the last frame.
    listMove: i32
    listJump: u8
    listEnter: bool
    typed: [32]u8
    typedLength: usize
    typedAt: u64
    typedNew: bool
    // The wheel while it is open (kept from what lies under it).
    wheel: i32
    // A row chosen, until its box takes it.
    pickId: u64
    pick: usize
    pickFrame: u64

    // The button the pointer rests on, since when, and its text (of this
    // frame).
    tipId: u64
    tipSince: u64
    tipSeen: bool
    tipText: []const u8
    tipArea: ui.Rect

    disabledDepth: usize
    savedOpacity: u32
    layers: [3]Layer
    clipDepth: usize
    scrolls: [4]ScrollFrame
    scrollDepth: usize
}

// A kit in heap memory (null without it). Nothing is drawn with it before
// the first begin.
pub fn create(allocator: Allocator) -> ?*Kit {
    const memory = allocator.alloc(@sizeOf(Kit), 16)
    if memory == null { return null }
    const kit: *Kit = unsafe { @ptrCast(*Kit, memory.?) }
    kit.*.allocator = allocator
    kit.*.time = 0
    kit.*.german = false
    kit.*.frame = 0
    kit.*.width = 0
    kit.*.height = 0
    kit.*.sized = false
    kit.*.modifiers = 0
    kit.*.wakeIn = NEVER
    kit.*.dragId = NONE
    kit.*.dragPressX = 0
    kit.*.dragPressY = 0
    kit.*.dragLastX = 0
    kit.*.dragLastY = 0
    kit.*.dragMoved = false
    kit.*.dragDouble = false
    kit.*.dragInert = false
    kit.*.dragValue = 0.0
    kit.*.dragPosition = 0.0
    kit.*.dragPart = 0
    kit.*.releasedId = NONE
    kit.*.releasedMoved = false
    kit.*.lastPressId = NONE
    kit.*.lastPressTime = 0
    kit.*.pressValue = 0.0
    kit.*.lastClickId = NONE
    kit.*.lastClickTime = 0
    kit.*.repeatAt = 0
    kit.*.secondaryId = NONE
    kit.*.secondaryFrame = 0
    kit.*.wantedId = NONE
    kit.*.wantedFrame = 0
    kit.*.editId = NONE
    kit.*.editKind = EDIT_NUMBER
    kit.*.editResult = EDIT_OPEN
    kit.*.editSteps = 0
    kit.*.editSeen = 0
    kit.*.editValue = 0.0
    field_module.init(&kit.*.field)
    field_module.init(&kit.*.original)
    kit.*.listId = NONE
    kit.*.listArea = ui.rect(0, 0, 0, 0)
    kit.*.listCount = 0
    kit.*.listName = null
    kit.*.listKind = null
    kit.*.listContext = 0
    kit.*.listChosen = 0
    kit.*.listCursor = 0
    kit.*.listScroll = 0
    kit.*.listWidth = 0
    kit.*.listSeen = 0
    kit.*.listReveal = false
    kit.*.listMove = 0
    kit.*.listJump = JUMP_NONE
    kit.*.listEnter = false
    kit.*.typedLength = 0
    kit.*.typedAt = 0
    kit.*.typedNew = false
    kit.*.wheel = 0
    kit.*.pickId = NONE
    kit.*.pick = 0
    kit.*.pickFrame = 0
    kit.*.tipId = NONE
    kit.*.tipSince = 0
    kit.*.tipSeen = false
    kit.*.tipText = ""
    kit.*.tipArea = ui.rect(0, 0, 0, 0)
    kit.*.disabledDepth = 0
    kit.*.savedOpacity = 255
    var index: usize = 0
    while index < LAYERS {
        kit.*.layers[index].capacity = 0
        kit.*.layers[index].active = false
        index += 1
    }
    kit.*.clipDepth = 0
    kit.*.scrollDepth = 0
    return kit
}

// Gives back everything the kit holds, and the kit.
pub fn destroy(kit: *Kit) -> void {
    const allocator = kit.*.allocator
    field_module.deinit(&kit.*.field)
    field_module.deinit(&kit.*.original)
    var index: usize = 0
    while index < LAYERS {
        freeLayer(kit, &kit.*.layers[index])
        index += 1
    }
    unsafe { allocator.free(@ptrCast([*]u8, kit), @sizeOf(Kit), 16) }
}

fn freeLayer(kit: *Kit, layer: *Layer) -> void {
    if layer.*.capacity == 0 { return }
    unsafe { kit.*.allocator.free(@ptrCast([*]u8, layer.*.pixels), layer.*.capacity * 4, 16) }
    layer.*.capacity = 0
}

// ---------------------------------------------------------------------------
// The frame

// Starts the kit's part of a frame (after view.begin): the context and
// canvas it is drawn with, the theme and fonts, the time in milliseconds
// (double clicks, tooltips, the caret) and the language of what the kit
// itself says.
pub fn begin(kit: *Kit, context: *Ui, canvas: *Canvas, theme: *Theme, body: *Text, small: *Text, mono: *Text, time: u64, german: bool) -> void {
    kit.*.ui = context
    kit.*.theme = theme
    kit.*.body = body
    kit.*.small = small
    kit.*.mono = mono
    kit.*.time = time
    kit.*.german = german
    kit.*.frame += 1
    // (std.ui.field blinks its caret by the context's time.)
    context.*.time = time
    if !kit.*.sized && canvas.*.width > 0 && canvas.*.height > 0 {
        kit.*.width = @intCast(i32, canvas.*.width)
        kit.*.height = @intCast(i32, canvas.*.height)
    }
    kit.*.wakeIn = NEVER
    kit.*.clipDepth = 0
    kit.*.scrollDepth = 0
    kit.*.disabledDepth = 0
    kit.*.tipSeen = false
    kit.*.tipText = ""
    // The press that ended since the last frame.
    kit.*.releasedId = NONE
    kit.*.releasedMoved = false
    if kit.*.dragId != NONE && !context.*.pointerDown {
        kit.*.releasedId = kit.*.dragId
        kit.*.releasedMoved = kit.*.dragMoved
        kit.*.dragId = NONE
    }
    // What was asked of a widget that is not drawn any more.
    if kit.*.secondaryId != NONE && kit.*.frame > kit.*.secondaryFrame + 2 { kit.*.secondaryId = NONE }
    if kit.*.wantedId != NONE && kit.*.frame > kit.*.wantedFrame + 2 { kit.*.wantedId = NONE }
    if kit.*.pickId != NONE && kit.*.frame > kit.*.pickFrame + 2 { kit.*.pickId = NONE }
    if kit.*.editId != NONE {
        if kit.*.frame > kit.*.editSeen + 1 {
            closeEdit(kit)
        } else if context.*.pointerDown && context.*.pressed != kit.*.editId && kit.*.editResult == EDIT_OPEN {
            // A press elsewhere ends the edit as Enter does.
            kit.*.editResult = EDIT_COMMIT
        }
    }
    // While a list is open the wheel is its own: what lies under it must
    // not scroll.
    if kit.*.listId != NONE {
        kit.*.wheel += context.*.wheel
        context.*.wheel = 0
    } else {
        kit.*.wheel = 0
    }
}

// Ends the kit's part of a frame (before view.end): draws what lies over
// everything, the open list and the tooltip. True when the kit wants
// another frame by itself (a caret blinks, a tooltip is due, a held
// stepper repeats, a busy bar moves): frameDelay says when.
pub fn end(kit: *Kit) -> bool {
    // (A clip left open would leave the context drawing into a layer.)
    while kit.*.clipDepth > 0 { clipEnd(kit) }
    while kit.*.disabledDepth > 0 { disabledEnd(kit) }
    drawList(kit)
    drawTooltip(kit)
    // Wheel steps nobody took are gone: they must not scroll what the
    // pointer comes over later.
    kit.*.ui.*.wheel = 0
    return kit.*.wakeIn != NEVER
}

// Milliseconds until the frame `end` asked for is due (0: at once).
pub fn frameDelay(kit: *Kit) -> u32 {
    return if kit.*.wakeIn == NEVER { 0 } else { kit.*.wakeIn }
}

// The window's size, for an app that lays out before it ever drew (a
// layout pass has no canvas to take it from); without it the size of the
// last canvas drawn on is used.
pub fn resize(kit: *Kit, width: i32, height: i32) -> void {
    kit.*.width = width
    kit.*.height = height
    kit.*.sized = true
}

// Which modifier keys are held (std.ui.keys bits; host.modifiers): with
// Shift a slider is dragged finely. Call whenever they may have changed
// (simplest: before each frame).
pub fn setModifiers(kit: *Kit, modifiers: u32) -> void { kit.*.modifiers = modifiers }

// The canvas to draw on now: the window's, or inside clipBegin .. clipEnd
// the layer that is cut to the clip.
pub fn canvasOf(kit: *Kit) -> *Canvas { return kit.*.ui.*.canvas }

// Whether a text edit or a list is open: keys are theirs (kit.key), the
// app must not take letters as shortcuts.
pub fn wantsKeys(kit: *Kit) -> bool { return kit.*.editId != NONE || kit.*.listId != NONE }

// Whether `id`'s text edit is open.
pub fn editing(kit: *Kit, id: u64) -> bool { return kit.*.editId == id && id != NONE }

// True in the frame in which a change of `id` is complete: its drag (a
// slider's, a splitter's, a curve's, a row's) ended, whether or not that
// frame changed anything, a wheel or stepper step was made, a typed
// number was taken. Ask after the widget was drawn; callers record one
// undo step then.
pub fn released(kit: *Kit, id: u64) -> bool { return kit.*.releasedId == id && id != NONE }

// True in the frame in which a row drag of `id` (dragRow) that had left
// its threshold ended: the row is dropped where the pointer is.
pub fn dropped(kit: *Kit, id: u64) -> bool { return released(kit, id) && kit.*.releasedMoved }

// Opens the text edit of the slider, spin box or text box `id` when it is
// drawn next (a row is renamed: F2), its text selected.
pub fn focus(kit: *Kit, id: u64) -> void {
    kit.*.wantedId = id
    kit.*.wantedFrame = kit.*.frame
}

// The right button was pressed at (x, y): a slider or spin box there
// opens its number for typing. (An open edit elsewhere ends as with
// Enter.)
pub fn secondaryClick(kit: *Kit, x: i32, y: i32) -> void {
    const hit = view.hitAt(kit.*.ui, x, y)
    if kit.*.editId != NONE && hit != kit.*.editId && kit.*.editResult == EDIT_OPEN { kit.*.editResult = EDIT_COMMIT }
    kit.*.secondaryId = hit
    kit.*.secondaryFrame = kit.*.frame
}

// Closes what is open, for a press the widgets do not see (on the
// picture, in another window part): a text edit ends as with Enter (its
// widget takes the text in the next frame), a list closes with nothing
// chosen.
pub fn dismiss(kit: *Kit) -> void {
    if kit.*.editId != NONE && kit.*.editResult == EDIT_OPEN { kit.*.editResult = EDIT_COMMIT }
    closeList(kit)
}

fn numberByte(byte: u8) -> bool {
    return byte >= 48 && byte <= 57 || byte == '-' || byte == '+' || byte == '.' || byte == ','
}

// A key press for the kit (Linux key code, std.ui.keys modifiers, the
// text it types): true when the kit used it and the app must not. An
// open list takes Up, Down, Page Up and Down, Home, End, Enter (choose),
// Escape and Tab (close) and letters (the first row that starts with
// what was typed). An open text edit takes typing and the caret's keys,
// Enter and Tab (take the text), Escape (give up), and for a number Up
// and Down (a step); only chords with Control, Alt or Super that mean
// nothing to it are left to the app. What a key did shows in the next
// frame: draw one.
pub fn key(kit: *Kit, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const chord = modifiers & (keys.CONTROL | keys.ALT | keys.SUPER) != 0
    if kit.*.listId != NONE {
        if code == keys.UP {
            kit.*.listMove -= 1
        } else if code == keys.DOWN {
            kit.*.listMove += 1
        } else if code == keys.PAGE_UP {
            kit.*.listMove -= 8
        } else if code == keys.PAGE_DOWN {
            kit.*.listMove += 8
        } else if code == keys.HOME {
            kit.*.listJump = JUMP_FIRST
        } else if code == keys.END {
            kit.*.listJump = JUMP_LAST
        } else if keys.isEnter(code) {
            kit.*.listEnter = true
        } else if code == keys.ESCAPE || code == keys.TAB {
            closeList(kit)
        } else if !chord && typed.length > 0 && typed[0] >= 32 && typed[0] != 127 {
            if kit.*.time < kit.*.typedAt || kit.*.time - kit.*.typedAt > TYPED_MS { kit.*.typedLength = 0 }
            for byte in typed {
                if kit.*.typedLength < TYPED {
                    kit.*.typed[kit.*.typedLength] = byte
                    kit.*.typedLength += 1
                }
            }
            kit.*.typedAt = kit.*.time
            kit.*.typedNew = true
        } else {
            return false
        }
        return true
    }
    if kit.*.editId == NONE { return false }
    // (A result waits for the widget: nothing more is typed into it.)
    if kit.*.editResult != EDIT_OPEN { return true }
    if keys.isEnter(code) || code == keys.TAB {
        kit.*.editResult = EDIT_COMMIT
        return true
    }
    if code == keys.ESCAPE {
        kit.*.editResult = EDIT_CANCEL
        return true
    }
    var result = field_module.KEY_IGNORED
    if kit.*.editKind == EDIT_NUMBER {
        if code == keys.UP || code == keys.DOWN {
            kit.*.editSteps += if code == keys.UP { 1 } else { -1 }
            return true
        }
        result = field_module.fieldKeyAccepting(&kit.*.field, code, modifiers, typed, numberByte)
    } else {
        result = field_module.fieldKey(&kit.*.field, code, modifiers, typed)
    }
    return result != field_module.KEY_IGNORED || !chord
}

// ---------------------------------------------------------------------------
// What widgets share

fn px(kit: *Kit, value: i32) -> i32 { return value * kit.*.theme.*.scale }

// The window's rectangle (a very large one before any size is known:
// what must cover the window then does).
fn windowOf(kit: *Kit) -> ui.Rect {
    if kit.*.width <= 0 || kit.*.height <= 0 { return ui.rect(0, 0, 1048576, 1048576) }
    return ui.rect(0, 0, kit.*.width, kit.*.height)
}

// The kit wants a frame in `delay` milliseconds at the latest.
fn wish(kit: *Kit, delay: u64) -> void {
    const wanted = if delay >= 60000 { 60000 } else { @intCast(u32, delay) }
    if wanted < kit.*.wakeIn { kit.*.wakeIn = wanted }
}

fn since(kit: *Kit, then: u64) -> u64 {
    return if kit.*.time >= then { kit.*.time - then } else { 0 }
}

// Whether the button is down on `id`.
fn held(kit: *Kit, id: u64) -> bool {
    return view.isPressed(kit.*.ui, id) && kit.*.ui.*.pointerDown
}

// Notes a press on `id` now; true when it is the second of a double
// click.
fn notePress(kit: *Kit, id: u64) -> bool {
    const double = kit.*.lastPressId == id && since(kit, kit.*.lastPressTime) <= DOUBLE_MS
    kit.*.lastPressId = if double { NONE } else { id }
    kit.*.lastPressTime = kit.*.time
    return double
}

// While `id` is held: true once, in the first frame of the press (the
// kit then follows it: dragLast, dragMoved; dragDouble says whether it
// is a double click's second).
fn pressStarted(kit: *Kit, id: u64) -> bool {
    const context = kit.*.ui
    if kit.*.dragId == id && kit.*.dragPressX == context.*.pressX && kit.*.dragPressY == context.*.pressY { return false }
    kit.*.dragId = id
    kit.*.dragPressX = context.*.pressX
    kit.*.dragPressY = context.*.pressY
    kit.*.dragLastX = context.*.pointerX
    kit.*.dragLastY = context.*.pointerY
    kit.*.dragMoved = false
    kit.*.dragInert = false
    kit.*.dragPart = 0
    kit.*.dragDouble = notePress(kit, id)
    return true
}

// A click on `id` whose press the kit never saw held (down and up between
// two frames): the widget does now what the press would have done.
fn quickClick(kit: *Kit, id: u64) -> bool {
    return view.takeClick(kit.*.ui, id) && kit.*.releasedId != id
}

fn takeSecondary(kit: *Kit, id: u64) -> bool {
    if kit.*.secondaryId != id || id == NONE { return false }
    // (Another edit is still to be taken by its widget: after it.)
    if kit.*.editId != NONE && kit.*.editId != id {
        wish(kit, 0)
        return false
    }
    kit.*.secondaryId = NONE
    return true
}

fn takeWanted(kit: *Kit, id: u64) -> bool {
    if kit.*.wantedId != id || id == NONE { return false }
    if kit.*.editId != NONE && kit.*.editId != id {
        wish(kit, 0)
        return false
    }
    kit.*.wantedId = NONE
    return true
}

fn textColor(kit: *Kit, kind: u8) -> u32 {
    const theme = kit.*.theme
    if kind == TEXT_DIM { return theme.*.dim }
    if kind == TEXT_ACCENT { return theme.*.accent }
    if kind == TEXT_DANGER { return theme.*.danger }
    if kind == TEXT_ON_ACCENT { return theme.*.onAccent }
    return theme.*.text
}

// The faint edge of a field on a panel, and the one under the pointer.
fn edgeColor(kit: *Kit, lit: bool) -> u32 {
    const theme = kit.*.theme
    return if lit { theme.*.border } else { theme_module.mix(theme.*.field, theme.*.border, 330) }
}

// `text` in `font` in `area`, cut with an ellipsis when too wide.
fn drawLabel(kit: *Kit, font: *Text, text: []const u8, area: ui.Rect, color: u32, where: u8) -> void {
    if text.length == 0 || area.width <= 0 { return }
    var room: [256]u8 = undefined
    const shown = kit_text.ellipsized(font, text, area.width, &room)
    var x = area.x
    if where != ALIGN_LEFT {
        const width = text_module.measure(font, shown)
        x = if where == ALIGN_CENTER { area.x + (area.width - width) / 2 } else { ui.right(area) - width }
    }
    text_module.drawText(kit.*.ui.*.canvas, font, shown, x, controls.textTop(font, area.y, area.height), color, 0)
}

// ---------------------------------------------------------------------------
// The drawing set (premultiplied colours, on any CPU canvas; nothing on a
// layout pass's)

fn sane(coordinate: f64) -> bool {
    return coordinate == coordinate && coordinate > -1.0e6 && coordinate < 1.0e6
}

fn floorInt(v: f64) -> i32 { return @intFromFloat(i32, @floor(v)) }

// A straight line from (x0, y0) to (x1, y1), `thickness` pixels wide (1
// at least) with round ends, its edge smoothed. Coordinates are
// continuous: pixel (3, 5) covers 3..4 x 5..6, so a crisp one-pixel
// horizontal line runs at y + 0.5. Only what is on the canvas is drawn.
pub fn line(canvas: *Canvas, x0: f64, y0: f64, x1: f64, y1: f64, color: u32, thickness: f64) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || canvas.*.height == 0 { return }
    if !sane(x0) || !sane(y0) || !sane(x1) || !sane(y1) { return }
    const shade = canvas_module.faded(canvas, color)
    if shade == 0 { return }
    const radius = (if thickness > 1.0 { if thickness < 256.0 { thickness } else { 256.0 } } else { 1.0 }) / 2.0
    // Along the longer side (a) one column at a time, across it (b) only
    // the pixels the line can reach there.
    const steep = math.abs(y1 - y0) > math.abs(x1 - x0)
    const a0 = if steep { y0 } else { x0 }
    const b0 = if steep { x0 } else { y0 }
    const a1 = if steep { y1 } else { x1 }
    const b1 = if steep { x1 } else { y1 }
    const a_limit = @intCast(i32, if steep { canvas.*.height } else { canvas.*.width })
    const b_limit = @intCast(i32, if steep { canvas.*.width } else { canvas.*.height })
    const da = a1 - a0
    const db = b1 - b0
    const length2 = da * da + db * db
    const slope = if da != 0.0 { db / da } else { 0.0 }
    const reach = radius * @sqrt(1.0 + slope * slope) + 1.0
    var a = floorInt(math.min(a0, a1) - radius - 1.0)
    var a_end = floorInt(math.max(a0, a1) + radius + 1.0)
    if a < 0 { a = 0 }
    if a_end >= a_limit { a_end = a_limit - 1 }
    while a <= a_end {
        const ca = @floatFromInt(f64, a) + 0.5
        var along = if da != 0.0 { (ca - a0) / da } else { 0.0 }
        along = math.clamp(along, 0.0, 1.0)
        const cb = b0 + along * db
        var b = floorInt(cb - reach)
        var b_end = floorInt(cb + reach)
        if b < 0 { b = 0 }
        if b_end >= b_limit { b_end = b_limit - 1 }
        while b <= b_end {
            // The pixel's centre to the nearest point of the line.
            const pa = ca - a0
            const pb = @floatFromInt(f64, b) + 0.5 - b0
            var nearest = if length2 > 0.0 { (pa * da + pb * db) / length2 } else { 0.0 }
            nearest = math.clamp(nearest, 0.0, 1.0)
            const ea = pa - nearest * da
            const eb = pb - nearest * db
            const cover = radius + 0.5 - @sqrt(ea * ea + eb * eb)
            if cover > 0.0 {
                const amount = if cover >= 1.0 { 255 } else { @intFromFloat(u32, cover * 255.0 + 0.5) }
                if steep { canvas_module.blend(canvas, b, a, shade, amount) } else { canvas_module.blend(canvas, a, b, shade, amount) }
            }
            b += 1
        }
        a += 1
    }
}

// A horizontal line `width` pixels long from (x, y), one pixel thick.
pub fn hline(canvas: *Canvas, x: i32, y: i32, width: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y, width, 1, color)
}

// A vertical line `height` pixels long from (x, y), one pixel thick.
pub fn vline(canvas: *Canvas, x: i32, y: i32, height: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y, 1, height, color)
}

// The outline of `area`, one pixel thick, inside it.
pub fn frame(canvas: *Canvas, area: ui.Rect, color: u32) -> void {
    if area.width <= 0 || area.height <= 0 { return }
    canvas_module.fillRect(canvas, area.x, area.y, area.width, 1, color)
    canvas_module.fillRect(canvas, area.x, ui.bottom(area) - 1, area.width, 1, color)
    canvas_module.fillRect(canvas, area.x, area.y + 1, 1, area.height - 2, color)
    canvas_module.fillRect(canvas, ui.right(area) - 1, area.y + 1, 1, area.height - 2, color)
}

// The light and dark squares that stand for "nothing here" (`cell`
// pixels each, the first light, counted from the area's corner), opaque.
pub fn checker(canvas: *Canvas, area: ui.Rect, cell: i32) -> void {
    if cell <= 0 || area.width <= 0 || area.height <= 0 { return }
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, CHECK_LIGHT)
    var row: i32 = 0
    var y = area.y
    while y < ui.bottom(area) {
        const tall = if ui.bottom(area) - y < cell { ui.bottom(area) - y } else { cell }
        var x = area.x + (if row & 1 == 0 { cell } else { 0 })
        while x < ui.right(area) {
            const wide = if ui.right(area) - x < cell { ui.right(area) - x } else { cell }
            canvas_module.fillRect(canvas, x, y, wide, tall, CHECK_DARK)
            x += cell * 2
        }
        y += cell
        row += 1
    }
}

// `area` filled with a straight colour (the engine's 0xAARRGGBB) over
// what is there.
pub fn fillStraight(canvas: *Canvas, area: ui.Rect, straight_color: u32) -> void {
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, pixel.premultiplied(straight_color))
}

// The numbers and the ellipsis are kit_text's.
pub const formatNumber = kit_text.formatNumber
pub const parseNumber = kit_text.parseNumber
pub const ellipsized = kit_text.ellipsized

// A rounded box whose columns `from` to `to` (counted from its left) are
// `inside` and the others `outside` (0: left as they are): a slider's bar,
// a progress bar. The corners are smooth whichever colour they get.
fn fillBands(canvas: *Canvas, area: ui.Rect, radius: i32, from: i32, to: i32, inside: u32, outside: u32) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || area.width <= 0 || area.height <= 0 { return }
    const start = if from < 0 { 0 } else if from > area.width { area.width } else { from }
    const stop = if to < start { start } else if to > area.width { area.width } else { to }
    const corner = if radius * 2 > area.height { area.height / 2 } else if radius * 2 > area.width { area.width / 2 } else { radius }
    const faded_inside = canvas_module.faded(canvas, inside)
    const faded_outside = canvas_module.faded(canvas, outside)
    var row: i32 = 0
    while row < area.height {
        const y = area.y + row
        var left: i32 = 0
        var right = area.width
        if row < corner || row >= area.height - corner {
            // The corners' pixels one by one, the rest of the row as runs.
            left = corner
            right = area.width - corner
            var column: i32 = 0
            while column < area.width {
                if column == left && right > left { column = right }
                if column >= area.width { break }
                const coverage = ui.roundedCoverage(column, row, area.width, area.height, corner)
                const shade = if column >= start && column < stop { faded_inside } else { faded_outside }
                if coverage > 0 && shade != 0 { canvas_module.blend(canvas, area.x + column, y, shade, coverage) }
                column += 1
            }
        }
        bandRun(canvas, area.x, y, left, if start < right { start } else { right }, outside)
        bandRun(canvas, area.x, y, if start > left { start } else { left }, if stop < right { stop } else { right }, inside)
        bandRun(canvas, area.x, y, if stop > left { stop } else { left }, right, outside)
        row += 1
    }
}

fn bandRun(canvas: *Canvas, x: i32, y: i32, from: i32, to: i32, color: u32) -> void {
    if to > from && color != 0 { canvas_module.fillRect(canvas, x + from, y, to - from, 1, color) }
}

// A rounded box in a straight colour, over the checker where the colour
// is translucent (a swatch).
fn fillSwatch(canvas: *Canvas, area: ui.Rect, radius: i32, straight_color: u32, cell: i32) -> void {
    if canvas.*.device != 0 || canvas.*.width == 0 || area.width <= 0 || area.height <= 0 { return }
    if straight_color >> 24 == 255 {
        canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, straight_color)
        return
    }
    const size = if cell > 0 { cell } else { 1 }
    const light = pixel.over(CHECK_LIGHT, straight_color, 255)
    const dark = pixel.over(CHECK_DARK, straight_color, 255)
    const faded_light = canvas_module.faded(canvas, light)
    const faded_dark = canvas_module.faded(canvas, dark)
    var row: i32 = 0
    while row < area.height {
        var column: i32 = 0
        while column < area.width {
            const coverage = ui.roundedCoverage(column, row, area.width, area.height, radius)
            if coverage > 0 {
                const odd = (column / size + row / size) & 1 == 1
                canvas_module.blend(canvas, area.x + column, area.y + row, if odd { faded_dark } else { faded_light }, coverage)
            }
            column += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// Clipping, what is disabled, scrolling

// Rows of `clip` copied between two canvases' pixels of the same
// coordinates.
fn copyRows(to: [*]u32, to_stride: usize, from: [*]const u32, from_stride: usize, clip: ui.Rect) -> void {
    if clip.width <= 0 || clip.height <= 0 { return }
    const x = @intCast(usize, clip.x)
    const bytes = @intCast(usize, clip.width) * 4
    var row = @intCast(usize, clip.y)
    const row_end = row + @intCast(usize, clip.height)
    while row < row_end {
        unsafe { std.mem.copy(@ptrCast([*]u8, to + row * to_stride + x), @ptrCast([*]const u8, from + row * from_stride + x), bytes) }
        row += 1
    }
}

// From here to clipEnd what is drawn shows only inside `area`, and
// regions are cut to it (view.pushClip). The canvas itself cannot clip:
// drawing goes to a layer of the window's size and coordinates (kept by
// the kit; canvasOf says which) that starts as a copy of the area and is
// copied back at clipEnd, so widgets need not know. Clips nest; beyond
// three deep (or without memory for a layer) only the regions are cut.
pub fn clipBegin(kit: *Kit, area: ui.Rect) -> void {
    const context = kit.*.ui
    view.pushClip(context, area)
    const depth = kit.*.clipDepth
    kit.*.clipDepth = depth + 1
    if depth >= LAYERS { return }
    const layer = &kit.*.layers[depth]
    layer.*.active = false
    const outer = context.*.canvas
    if outer.*.device != 0 || outer.*.width == 0 || outer.*.height == 0 { return }
    var clip = ui.intersect(area, ui.rect(0, 0, @intCast(i32, outer.*.width), @intCast(i32, outer.*.height)))
    if depth > 0 && kit.*.layers[depth - 1].active { clip = ui.intersect(clip, kit.*.layers[depth - 1].area) }
    const wanted = outer.*.width * outer.*.height
    if layer.*.capacity < wanted {
        freeLayer(kit, layer)
        const memory = kit.*.allocator.alloc(wanted * 4, 16)
        if memory == null { return }
        unsafe { layer.*.pixels = @ptrCast([*]u32, memory.?) }
        layer.*.capacity = wanted
    }
    layer.*.canvas = Canvas.{ .pixels = layer.*.pixels, .width = outer.*.width, .height = outer.*.height, .stride = outer.*.width, .swapRedBlue = outer.*.swapRedBlue, .device = 0, .opacity = outer.*.opacity }
    copyRows(layer.*.pixels, outer.*.width, outer.*.pixels, outer.*.stride, clip)
    layer.*.saved = outer
    layer.*.area = clip
    layer.*.active = true
    context.*.canvas = &layer.*.canvas
}

pub fn clipEnd(kit: *Kit) -> void {
    if kit.*.clipDepth == 0 { return }
    const context = kit.*.ui
    view.popClip(context)
    kit.*.clipDepth -= 1
    if kit.*.clipDepth >= LAYERS { return }
    const layer = &kit.*.layers[kit.*.clipDepth]
    if !layer.*.active { return }
    copyRows(layer.*.saved.*.pixels, layer.*.saved.*.stride, layer.*.pixels, layer.*.canvas.stride, layer.*.area)
    context.*.canvas = layer.*.saved
    layer.*.active = false
}

// From here to disabledEnd widgets are disabled: drawn faded, naming no
// regions (so nothing is under the pointer there). Nests.
pub fn disabledBegin(kit: *Kit) -> void {
    if kit.*.disabledDepth == 0 {
        const canvas = kit.*.ui.*.canvas
        kit.*.savedOpacity = canvas.*.opacity
        canvas_module.setOpacity(canvas, canvas.*.opacity * DISABLED_OPACITY / 255)
        view.pushClip(kit.*.ui, ui.rect(0, 0, 0, 0))
    }
    kit.*.disabledDepth += 1
}

pub fn disabledEnd(kit: *Kit) -> void {
    if kit.*.disabledDepth == 0 { return }
    kit.*.disabledDepth -= 1
    if kit.*.disabledDepth == 0 {
        canvas_module.setOpacity(kit.*.ui.*.canvas, kit.*.savedOpacity)
        view.popClip(kit.*.ui)
    }
}

fn largestOffset(content: i32, viewport: i32) -> i32 {
    return if content > viewport { content - viewport } else { 0 }
}

fn clampOffset(offset: *i32, content: i32, viewport: i32) -> void {
    if offset.* > largestOffset(content, viewport) { offset.* = largestOffset(content, viewport) }
    if offset.* < 0 { offset.* = 0 }
}

// A scrolled view in `area` of content `content_height` tall, scrolled
// by `offset` pixels (the caller's; held within the content here). Draw
// the content between this and scrollEnd at the rectangle returned: the
// content's, moved up by the offset, the width less a scroll bar's when
// the content is taller than the view. It is clipped to the view. The
// wheel over the view scrolls (when no widget in it took it), the bar at
// the right can be dragged; both at scrollEnd, showing in the next
// frame.
pub fn scrollBegin(kit: *Kit, id: u64, area: ui.Rect, content_height: i32, offset: *i32) -> ui.Rect {
    clampOffset(offset, content_height, area.height)
    const bar = if content_height > area.height { px(kit, SCROLL_BAR) } else { 0 }
    const inner = ui.rect(area.x, area.y, area.width - bar, area.height)
    if kit.*.scrollDepth < SCROLLS {
        kit.*.scrolls[kit.*.scrollDepth] = ScrollFrame.{ .id = id, .area = area, .content = content_height, .offset = offset }
    }
    kit.*.scrollDepth += 1
    clipBegin(kit, inner)
    return ui.rect(inner.x, inner.y - offset.*, inner.width, if content_height > area.height { content_height } else { area.height })
}

pub fn scrollEnd(kit: *Kit) -> void {
    if kit.*.scrollDepth == 0 { return }
    clipEnd(kit)
    kit.*.scrollDepth -= 1
    if kit.*.scrollDepth >= SCROLLS { return }
    const entry = &kit.*.scrolls[kit.*.scrollDepth]
    const context = kit.*.ui
    const area = entry.*.area
    const most = largestOffset(entry.*.content, area.height)
    if most == 0 { return }
    // The wheel, only when it can move this view (else an outer one may).
    if context.*.wheel != 0 && ui.contains(area, context.*.pointerX, context.*.pointerY) {
        var next = entry.*.offset.* + context.*.wheel * px(kit, WHEEL_STEP)
        if next > most { next = most }
        if next < 0 { next = 0 }
        if next != entry.*.offset.* {
            entry.*.offset.* = next
            _ = view.takeWheelIn(context, area)
        }
    }
    const bar = px(kit, SCROLL_BAR)
    scrollBar(kit, view.idOf(entry.*.id, PART_BAR), ui.rect(ui.right(area) - bar, area.y, bar, area.height), entry.*.content, area.height, entry.*.offset)
}

// A scroll bar in `track` for content taller than its view: the thumb is
// dragged, a press beside it pages toward it.
fn scrollBar(kit: *Kit, bar_id: u64, track: ui.Rect, content: i32, viewport: i32, offset: *i32) -> void {
    const context = kit.*.ui
    const most = largestOffset(content, viewport)
    if most == 0 || track.height <= 0 { return }
    view.region(context, bar_id, track)
    var thumb = @intCast(i32, @intCast(i64, viewport) * @intCast(i64, track.height) / @intCast(i64, content))
    if thumb < px(kit, 20) { thumb = px(kit, 20) }
    if thumb > track.height { thumb = track.height }
    const room = track.height - thumb
    var top = track.y + @intCast(i32, @intCast(i64, offset.*) * @intCast(i64, room) / @intCast(i64, most))
    if held(kit, bar_id) {
        if pressStarted(kit, bar_id) {
            if context.*.pressY < top { offset.* -= viewport } else if context.*.pressY >= top + thumb { offset.* += viewport }
            clampOffset(offset, content, viewport)
            kit.*.dragValue = @floatFromInt(f64, offset.*)
        } else if room > 0 {
            offset.* = @intFromFloat(i32, kit.*.dragValue) + @intCast(i32, @intCast(i64, view.dragY(context)) * @intCast(i64, most) / @intCast(i64, room))
            clampOffset(offset, content, viewport)
        }
        context.*.changed = true
        top = track.y + @intCast(i32, @intCast(i64, offset.*) * @intCast(i64, room) / @intCast(i64, most))
    }
    const lit = view.isHover(context, bar_id) || held(kit, bar_id)
    const inset = if lit { px(kit, 1) } else { px(kit, 2) }
    const theme = kit.*.theme
    canvas_module.fillRoundedRect(context.*.canvas, track.x + inset, top, track.width - inset * 2, thumb, (track.width - inset * 2) / 2, if lit { theme.*.border } else { theme.*.thumb })
}
