// nebula ui: the file dialog: a file to open (or several), a name to save
// under, chosen in the window itself (a state.Dialog over everything,
// pushed with api.pushDialog) with nebula's widgets. One dialog serves
// every part that reads or writes files: the caller says what it is for,
// where it starts and which kinds of files it takes, and is called back
// with the path chosen:
//
//     fn opened(app: *App, path: []const u8, filter: usize) -> void { ... }
//
//     const filters = [2]filedialog.Filter{
//         filedialog.Filter.{ .name = "PNG image", .german = "PNG-Bild", .extensions = "png" },
//         filedialog.Filter.{ .name = "All files", .german = "Alle Dateien", .extensions = "" },
//     }
//     _ = filedialog.open(app, state.tr(app, "Open Image", "Bild öffnen"), "", filters[0..], opened)
//     _ = filedialog.save(app, title, "", "untitled.png", filters[0..], saved)
//
// What it shows: the directory as a row of its parts to click and as a
// path field (Enter goes there, Tab completes a name as far as the
// entries agree); at the left the places (Home, Desktop, Documents,
// Pictures, Downloads where they are, the file system's root, the
// directories used last); the directory's entries, directories first,
// then the files the chosen filter takes (hidden ones only with the
// toggle), with their size and when they changed, sorted by a click on a
// column's head; New Folder (its name typed in a row of the list); at the
// bottom the filter, the name to save under, the buttons, and a line for
// what went wrong (a directory that cannot be read, a folder that cannot
// be made). Keys: Up, Down, Page Up, Page Down, Home and End move; Enter
// opens a directory or takes a file; Backspace and Alt+Up go up; letters
// go to the first name that starts with them (what is typed within a
// second is one word); "/" or "~" start a path; Ctrl+L the path field;
// Ctrl+H hidden files; F5 reads the directory again; Tab moves between
// the list and the field; Escape cancels. A double click is Enter.
// Saving onto a file that is there asks first, in the dialog's last line;
// a name without an extension gets the filter's first. Choosing several
// (openMany): Ctrl+click and Space add or take one, Shift+click and
// Shift with the keys a run, Ctrl+A all; the caller is called once for
// each file, in the list's order.
//
// What the caller hands over is copied, the filters too (a constant table
// sliced at run time is a copy that goes when the window's loop turns).
// A directory is read once a change into memory of the dialog's own (one
// list of the names' bytes, one of records, one of the rows shown),
// sorted here (a merge sort: std has none), and given back when the
// dialog closes; only the directories used last stay for the program's
// run (recentDirectories and setRecentDirectories hand them to whoever
// keeps them longer).
//
// Not done: previews of pictures, bookmarks of the user's own, a
// directory watched for changes (F5 reads it again), names sorted with
// their numbers as numbers.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const field_module = @import("std.ui.field")
const lists = @import("std.ui.lists")
const xdg = @import("std.xdg")
const timezone = @import("std.timezone")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const shell_module = @import("../app/shell.mlx")
const kit_module = @import("./kit.mlx")
const icons = @import("./icons.mlx")

pub const App = state.App
const Kit = kit_module.Kit
const Field = field_module.Field
const Canvas = state.Canvas

// A kind of file the dialog offers to show (or to save as).
pub const Filter = struct {
    // As people read it, in English and in German ("PNG image").
    name: []const u8
    german: []const u8
    // The names' endings it takes: lower case, without dots, space
    // separated ("png jpg jpeg"); "": every file.
    extensions: []const u8
}

// What the dialog calls when a file was chosen: its path (absolute,
// good for the call only) and which of the filters was chosen (its
// index).
pub const Done = fn(app: *App, path: []const u8, filter: usize) -> void


// No row: the cursor's when nothing is under it.
pub const NO_ROW: usize = 18446744073709551615

// The directories used last that are kept.
pub const RECENT: usize = 5

// Where the parts of the dialog were drawn in the last frame (window
// pixels; an empty rectangle for a part that is not there).
pub const Layout = struct {
    box: ui.Rect
    up: ui.Rect
    crumbs: ui.Rect
    hidden: ui.Rect
    newFolder: ui.Rect
    path: ui.Rect
    places: ui.Rect
    // The list's frame, its column heads, the rows' view.
    frame: ui.Rect
    nameHead: ui.Rect
    sizeHead: ui.Rect
    modifiedHead: ui.Rect
    list: ui.Rect
    // The name to save under (saving only), the filter, the line that
    // says what went wrong or asks.
    name: ui.Rect
    filter: ui.Rect
    message: ui.Rect
    // Cancel and Open (or Save); while the dialog asks whether to replace
    // a file: Back and Replace.
    cancel: ui.Rect
    accept: ui.Rect
}

const MODE_OPEN: u8 = 0
const MODE_MANY: u8 = 1
const MODE_SAVE: u8 = 2

// What takes the keys: the list, the path field, the name field, the
// name of a folder being made.
const FOCUS_LIST: u8 = 0
const FOCUS_PATH: u8 = 1
const FOCUS_NAME: u8 = 2
const FOCUS_FOLDER: u8 = 3

const PLACE_HOME: u8 = 0
const PLACE_DESKTOP: u8 = 1
const PLACE_DOCUMENTS: u8 = 2
const PLACE_PICTURES: u8 = 3
const PLACE_DOWNLOADS: u8 = 4
const PLACE_ROOT: u8 = 5
const PLACE_RECENT: u8 = 6

// The columns the list is sorted by.
const SORT_NAME: u8 = 0
const SORT_SIZE: u8 = 1
const SORT_MODIFIED: u8 = 2

const KIND_NONE: u8 = 0
const KIND_FILE: u8 = 1
const KIND_DIRECTORY: u8 = 2

// What a frame's widgets asked for (done at the frame's end, when no
// list is being walked any more).
const ACT_NONE: u8 = 0
const ACT_UP: u8 = 1
const ACT_CRUMB: u8 = 2
const ACT_PLACE: u8 = 3
const ACT_CLICK: u8 = 4
const ACT_ENTER: u8 = 5
const ACT_SORT: u8 = 6
const ACT_HIDDEN: u8 = 7
const ACT_NEW_FOLDER: u8 = 8
const ACT_FILTER: u8 = 9
const ACT_ACCEPT: u8 = 10
const ACT_CANCEL: u8 = 11
const ACT_REPLACE: u8 = 12
const ACT_BACK: u8 = 13
const ACT_FOCUS: u8 = 14

// Ids of the parts (view.idOf of the dialog's id).
const PART_UP: usize = 1
const PART_HIDDEN: usize = 2
const PART_NEW_FOLDER: usize = 3
const PART_PATH: usize = 4
const PART_LIST: usize = 5
const PART_NAME_HEAD: usize = 6
const PART_SIZE_HEAD: usize = 7
const PART_DATE_HEAD: usize = 8
const PART_NAME: usize = 9
const PART_FILTER: usize = 10
const PART_CANCEL: usize = 11
const PART_ACCEPT: usize = 12
const PART_BACK: usize = 13
const PART_REPLACE: usize = 14
const PART_FOLDER: usize = 15
const PART_ELLIPSIS: usize = 16
const PART_MESSAGE: usize = 17
const PLACES_FROM: usize = 32
const CRUMBS_FROM: usize = 64
const ROWS_FROM: usize = 65536

// Names are at most this long (a file system's limit).
const NAME_MAX: usize = 255
const FILTERS: usize = 16
const PLACES: usize = 16
const TYPED: usize = 32
const TYPE_AHEAD_MS: usize = 1000
const READ_BUFFER: usize = 4096
// (More rows than this are not scrolled to: an i32 of pixels holds them.)
const ROWS_MOST: usize = 4000000

// Sizes, times the theme's scale.
const WIDTH: i32 = 900
const HEIGHT: i32 = 640
const MARGIN: i32 = 16
const PAD: i32 = 12
const ROW: i32 = 24
const BAR: i32 = 26
const TITLE: i32 = 22
const SIDE: i32 = 168
const HEAD: i32 = 24
const SIZE_COLUMN: i32 = 76
const DATE_COLUMN: i32 = 124
const ICON: i32 = 16
const BUTTON: i32 = 96
const COMBO: i32 = 220
const CRUMB_MOST: i32 = 180

// An entry of the directory shown.
const Entry = struct {
    // Its name: `nameLength` bytes from `nameAt` of the names.
    nameAt: usize
    nameLength: usize
    directory: bool
    hidden: bool
    // Chosen among several (openMany).
    selected: bool
    size: u64
    // When it changed last: seconds since 1970, UTC (0: not known).
    modified: i64
}

// A place at the left: its kind and its path in the places' text.
const Place = struct {
    kind: u8
    pathAt: usize
    pathLength: usize
}

// A filter's texts in the dialog's own memory: its name in either
// language as the list of filters shows it (its patterns after it), and
// its extensions.
const FilterText = struct {
    englishAt: usize
    englishLength: usize
    germanAt: usize
    germanLength: usize
    extensionsAt: usize
    extensionsLength: usize
}

// The dialog's state, in its slot (state.SLOT_FILE_DIALOG): made once,
// its lists given back each time it closes.
const Chooser = struct {
    made: bool
    open: bool
    // Its place among the app's dialogs (gone when fewer are open).
    depth: usize
    mode: u8
    done: ?Done
    title: std.ArrayList(u8)
    // The directory shown: absolute, no slash at its end but the root's.
    directory: std.ArrayList(u8)
    // Its entries: the names' bytes, the records, the rows shown (indices
    // of the records, in the order shown) and the merge sort's other half.
    names: std.ArrayList(u8)
    entries: std.ArrayList(Entry)
    shown: std.ArrayList(u32)
    spare: std.ArrayList(u32)
    // Paths being put together, the one made of them (normalized), a path
    // NUL-terminated for the file system, the paths handed to `done`
    // (NUL after each).
    going: std.ArrayList(u8)
    target: std.ArrayList(u8)
    probe: std.ArrayList(u8)
    result: std.ArrayList(u8)
    filterText: std.ArrayList(u8)
    filters: [16]FilterText
    filterCount: usize
    filter: usize
    placeText: std.ArrayList(u8)
    places: [16]Place
    placeCount: usize
    // The directories used last, a line each, the latest first: kept for
    // the program's run.
    recent: std.ArrayList(u8)
    path: Field
    name: Field
    folder: Field
    // The name save() proposed.
    proposed: [256]u8
    proposedLength: usize
    // The name of the directory just left upwards (its row is the
    // cursor's in the one above).
    back: [256]u8
    backLength: usize
    focus: u8
    // The row the keys move (NO_ROW: none), where a run of rows chosen
    // with Shift starts, the list's scroll offset, the cursor to be
    // brought into view in the next frame.
    cursor: usize
    anchor: usize
    offset: i32
    reveal: bool
    showHidden: bool
    sort: u8
    descending: bool
    // Letters typed over the list, and when the last came.
    typed: [32]u8
    typedLength: usize
    typedAt: usize
    // A folder's name is typed in the list; the dialog asks whether to
    // replace a file (its path in the result); the result is being handed
    // to `done` (closing keeps it).
    creating: bool
    confirming: bool
    handing: bool
    message: [320]u8
    messageLength: usize
    danger: bool
    layout: Layout
    zone: timezone.Zone
    zoneLoaded: bool
    stat: std.fs.Stat
    // A row's size and time as text (drawn at once).
    sizeBytes: [24]u8
    dateBytes: [24]u8
    // Records of a directory being read; a user directory's path.
    buffer: [4096]u8
}

// ---------------------------------------------------------------------------
// The state

fn chooserOf(app: *App) -> ?*Chooser {
    const memory = state.slot(app, state.SLOT_FILE_DIALOG, @sizeOf(Chooser))
    if memory == null { return null }
    const c: *Chooser = unsafe { @ptrCast(*Chooser, memory.?) }
    if !c.*.made {
        const allocator = app.*.allocator
        c.*.title = std.ArrayList(u8).init(allocator)
        c.*.directory = std.ArrayList(u8).init(allocator)
        c.*.names = std.ArrayList(u8).init(allocator)
        c.*.entries = std.ArrayList(Entry).init(allocator)
        c.*.shown = std.ArrayList(u32).init(allocator)
        c.*.spare = std.ArrayList(u32).init(allocator)
        c.*.going = std.ArrayList(u8).init(allocator)
        c.*.target = std.ArrayList(u8).init(allocator)
        c.*.probe = std.ArrayList(u8).init(allocator)
        c.*.result = std.ArrayList(u8).init(allocator)
        c.*.filterText = std.ArrayList(u8).init(allocator)
        c.*.placeText = std.ArrayList(u8).init(allocator)
        c.*.recent = std.ArrayList(u8).init(allocator)
        field_module.init(&c.*.path)
        field_module.init(&c.*.name)
        field_module.init(&c.*.folder)
        c.*.open = false
        c.*.sort = SORT_NAME
        c.*.descending = false
        c.*.showHidden = false
        c.*.zoneLoaded = false
        c.*.handing = false
        c.*.made = true
    }
    return c
}

// The dialog's state while it is open (null when it is not).
fn openChooser(app: *App) -> ?*Chooser {
    if !state.hasSlot(app, state.SLOT_FILE_DIALOG) { return null }
    const c = chooserOf(app)
    if c == null || !c.?.*.open { return null }
    return c
}

// Gives back what the dialog holds while it is open (not the directories
// used last, nor the result while it is handed over).
fn release(c: *Chooser) -> void {
    c.*.title.deinit()
    c.*.directory.deinit()
    c.*.names.deinit()
    c.*.entries.deinit()
    c.*.shown.deinit()
    c.*.spare.deinit()
    c.*.going.deinit()
    c.*.target.deinit()
    c.*.probe.deinit()
    c.*.filterText.deinit()
    c.*.placeText.deinit()
    field_module.deinit(&c.*.path)
    field_module.deinit(&c.*.name)
    field_module.deinit(&c.*.folder)
    if !c.*.handing { c.*.result.deinit() }
    c.*.filterCount = 0
    c.*.placeCount = 0
}

fn idOf(part: usize) -> u64 { return view.idOf(view.id("nebula.files"), part) }

// ---------------------------------------------------------------------------
// Text

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn startsFolded(name: []const u8, start: []const u8) -> bool {
    if start.length > name.length { return false }
    var index: usize = 0
    while index < start.length {
        if lower(name[index]) != lower(start[index]) { return false }
        index += 1
    }
    return true
}

fn endsFolded(name: []const u8, ending: []const u8) -> bool {
    if ending.length > name.length { return false }
    const from = name.length - ending.length
    var index: usize = 0
    while index < ending.length {
        if lower(name[from + index]) != lower(ending[index]) { return false }
        index += 1
    }
    return true
}

// Below zero when `x` comes first: letters' case aside, then by their
// bytes (so "a" and "A" keep an order).
fn compareNames(x: []const u8, y: []const u8) -> i32 {
    var index: usize = 0
    while index < x.length && index < y.length {
        const p = lower(x[index])
        const q = lower(y[index])
        if p != q { return if p < q { -1 } else { 1 } }
        index += 1
    }
    if x.length != y.length { return if x.length < y.length { -1 } else { 1 } }
    index = 0
    while index < x.length {
        if x[index] != y[index] { return if x[index] < y[index] { -1 } else { 1 } }
        index += 1
    }
    return 0
}

// What follows the last slash of `path` (the root: "/").
fn baseName(path: []const u8) -> []const u8 {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    if start == path.length { return path }
    return path[start..path.length]
}

// Where the last part of `path` starts (after its last slash).
fn baseStart(path: []const u8) -> usize {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    return start
}

// Where the extension's dot is in the last part of `name`; name.length
// when it has none (a dot first, ".hidden", is none; nor is one last).
fn extensionAt(name: []const u8) -> usize {
    const start = baseStart(name)
    var at = name.length
    while at > start + 1 {
        at -= 1
        if name[at] == 46 {
            return if at + 1 < name.length { at } else { name.length }
        }
    }
    return name.length
}

// The length of the directory above `path` (normalized): "/a/b" is "/a",
// "/a" and "/" are "/".
fn parentLength(path: []const u8) -> usize {
    var end = path.length
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    return if end <= 1 { 1 } else { end - 1 }
}

// `path` (absolute) into `into` with "." and ".." gone, single slashes
// and none at its end (but for the root, "/"). False without memory.
fn normalized(into: *std.ArrayList(u8), path: []const u8) -> bool {
    into.clearRetainingCapacity()
    var at: usize = 0
    while at < path.length {
        while at < path.length && path[at] == 47 { at += 1 }
        var end = at
        while end < path.length && path[end] != 47 { end += 1 }
        const part = path[at..end]
        at = end
        if part.length == 0 || (part.length == 1 && part[0] == 46) { continue }
        if part.length == 2 && part[0] == 46 && part[1] == 46 {
            var cut = into.count()
            while cut > 0 && into.items()[cut - 1] != 47 { cut -= 1 }
            if cut > 0 { cut -= 1 }
            _ = into.resize(cut)
            continue
        }
        if !into.append(47) || !into.appendSlice(part) { return false }
    }
    if into.count() == 0 { return into.append(47) }
    return true
}

// Two digits of `value` (0-99) at `at`.
fn appendTwo(into: [*]u8, at: usize, capacity: usize, value: i64) -> usize {
    const tens = @intCast(u8, @intCast(u64, value / 10 % 10))
    const ones = @intCast(u8, @intCast(u64, value % 10))
    return std.text.appendByte(into, std.text.appendByte(into, at, capacity, 48 + tens), capacity, 48 + ones)
}

// A file's size as people read it ("812 B", "4.2 kB", "13 MB"), with a
// decimal comma in German: its length in `into` (24 bytes). Rounded once,
// half up, from the size itself (12 451 bytes are "12 kB", not 12.5
// rounded again); what rounds to 1000 of a unit is the next one's
// ("1.0 MB" for 999 500 bytes).
fn sizeText(size: u64, german: bool, into: [*]u8) -> usize {
    if size < 1000 { return std.text.append(into, std.text.appendUnsigned(into, 0, 24, @intCast(usize, size)), 24, " B") }
    var divisor: u64 = 1000
    var unit: usize = 1
    while unit < 4 && size / divisor >= 1000 {
        divisor *= 1000
        unit += 1
    }
    // (rest * 10 < 10^13 and rest * 2 < 2 * 10^12: no product traps.)
    var rest = size % divisor
    var tenths = size / divisor * 10 + (rest * 10 + divisor / 2) / divisor
    var whole = size / divisor + (if rest * 2 >= divisor { 1 } else { 0 })
    if whole >= 1000 && unit < 4 {
        divisor *= 1000
        unit += 1
        rest = size % divisor
        tenths = size / divisor * 10 + (rest * 10 + divisor / 2) / divisor
        whole = size / divisor + (if rest * 2 >= divisor { 1 } else { 0 })
    }
    var length: usize = 0
    if tenths < 100 {
        length = std.text.appendUnsigned(into, 0, 24, @intCast(usize, tenths / 10))
        length = std.text.appendByte(into, length, 24, if german { 44 } else { 46 })
        length = std.text.appendUnsigned(into, length, 24, @intCast(usize, tenths % 10))
    } else {
        length = std.text.appendUnsigned(into, 0, 24, @intCast(usize, whole))
    }
    const name = if unit == 1 { " kB" } else if unit == 2 { " MB" } else if unit == 3 { " GB" } else { " TB" }
    return std.text.append(into, length, 24, name)
}

// When something changed, in local time ("2026-11-25 14:03"; German
// "25.11.2026 14:03"): its length in `into` (24 bytes; 0 when not known).
fn dateText(c: *Chooser, seconds: i64, german: bool, into: [*]u8) -> usize {
    if seconds <= 0 || seconds > 253402300799 { return 0 }
    const day = timezone.civil(seconds + timezone.offsetAt(&c.*.zone, seconds))
    if day.year < 1 || day.year > 9999 { return 0 }
    var length: usize = 0
    if german {
        length = appendTwo(into, 0, 24, day.day)
        length = std.text.appendByte(into, length, 24, 46)
        length = appendTwo(into, length, 24, day.month)
        length = std.text.appendByte(into, length, 24, 46)
        length = std.text.appendUnsigned(into, length, 24, @intCast(usize, day.year))
    } else {
        length = std.text.appendUnsigned(into, 0, 24, @intCast(usize, day.year))
        length = std.text.appendByte(into, length, 24, 45)
        length = appendTwo(into, length, 24, day.month)
        length = std.text.appendByte(into, length, 24, 45)
        length = appendTwo(into, length, 24, day.day)
    }
    length = std.text.appendByte(into, length, 24, 32)
    length = appendTwo(into, length, 24, day.hour)
    length = std.text.appendByte(into, length, 24, 58)
    return appendTwo(into, length, 24, day.minute)
}

// The line of the dialog says `first`, `name` and `last` (in the danger
// colour when `danger`).
fn say(c: *Chooser, danger: bool, first: []const u8, name: []const u8, last: []const u8) -> void {
    const bytes: [*]u8 = &c.*.message
    var length = std.text.append(bytes, 0, 320, first)
    length = std.text.append(bytes, length, 320, name)
    c.*.messageLength = std.text.append(bytes, length, 320, last)
    c.*.danger = danger
}

fn quiet(c: *Chooser) -> void { c.*.messageLength = 0 }

// ---------------------------------------------------------------------------
// Files

// `path` NUL-terminated for the file system, in the probe (null without
// memory). `path` must not be the probe's.
fn terminated(c: *Chooser, path: []const u8) -> ?[*]const u8 {
    c.*.probe.clearRetainingCapacity()
    if !c.*.probe.appendSlice(path) || !c.*.probe.append(0) { return null }
    const bytes: [*]const u8 = c.*.probe.items().pointer
    return bytes
}

// Whether `path` is a file, a directory or nothing.
fn kindOf(c: *Chooser, path: []const u8) -> u8 {
    const name = terminated(c, path)
    if name == null || std.fs.status(name.?, &c.*.stat) != 0 { return KIND_NONE }
    return if c.*.stat.mode & 61440 == 16384 { KIND_DIRECTORY } else { KIND_FILE }
}

// What was typed (a path or a name) as an absolute path in the target:
// "~" is the home, a relative one is under `base` (any of the dialog's
// lists but `going` and `target`). False without memory.
fn resolve(app: *App, c: *Chooser, base: []const u8, typed: []const u8) -> bool {
    c.*.going.clearRetainingCapacity()
    var ok = true
    if typed.length > 0 && typed[0] == 126 && (typed.length == 1 || typed[1] == 47) {
        ok = c.*.going.appendSlice(shell_module.home(app.*.shell)) && c.*.going.append(47) && c.*.going.appendSlice(typed[1..typed.length])
    } else if typed.length > 0 && typed[0] == 47 {
        ok = c.*.going.appendSlice(typed)
    } else {
        ok = c.*.going.appendSlice(base) && c.*.going.append(47) && c.*.going.appendSlice(typed)
    }
    return ok && normalized(&c.*.target, c.*.going.items())
}

// The directory shown with `name` after it, in the target.
fn childPath(c: *Chooser, name: []const u8) -> bool {
    c.*.target.clearRetainingCapacity()
    const directory = c.*.directory.items()
    var ok = c.*.target.appendSlice(directory)
    if directory.length == 0 || directory[directory.length - 1] != 47 { ok = ok && c.*.target.append(47) }
    return ok && c.*.target.appendSlice(name)
}

// Reads directory `path` (absolute, normalized: the target) into the
// entries and makes it the one shown. False, and nothing changed, when
// it cannot be opened.
fn read(app: *App, c: *Chooser, path: []const u8) -> bool {
    const name = terminated(c, path)
    if name == null { return false }
    const folder = std.fs.open(name.?, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(folder) { return false }
    c.*.names.clearRetainingCapacity()
    c.*.entries.clearRetainingCapacity()
    var complete = true
    const buffer: [*]u8 = &c.*.buffer
    var reader = std.fs.entries(folder, buffer, READ_BUFFER)
    var found: std.fs.Entry = undefined
    while std.fs.nextEntry(&reader, &found) {
        const entry_name = found.name.pointer[0..found.name.length]
        if entry_name.length == 0 || entry_name.length > NAME_MAX || std.fs.isDotName(found.name) { continue }
        const count = c.*.entries.count()
        const at = c.*.names.count()
        if !c.*.names.appendSlice(entry_name) || !c.*.entries.resize(count + 1) {
            complete = false
            break
        }
        // (Filled in place: no record is made per entry and copied.)
        const entry = &c.*.entries.items()[count]
        entry.*.nameAt = at
        entry.*.nameLength = entry_name.length
        entry.*.directory = found.kind == std.fs.ENTRY_DIRECTORY
        entry.*.hidden = entry_name[0] == 46
        entry.*.selected = false
        entry.*.size = 0
        entry.*.modified = 0
        // Links followed: a link to a directory is one (a dangling link
        // stays what the record says).
        if std.fs.statusFrom(folder, found.name.pointer, &c.*.stat, false) == 0 {
            entry.*.directory = c.*.stat.mode & 61440 == 16384
            entry.*.size = if c.*.stat.size > 0 { @intCast(u64, c.*.stat.size) } else { 0 }
            entry.*.modified = c.*.stat.modifiedSeconds
        }
    }
    if reader.failed { complete = false }
    _ = std.fs.close(folder)
    c.*.directory.clearRetainingCapacity()
    _ = c.*.directory.appendSlice(path)
    c.*.cursor = NO_ROW
    c.*.offset = 0
    c.*.typedLength = 0
    reshow(c)
    quiet(c)
    if !complete { say(c, true, state.tr(app, "Not all of this folder could be read", "Dieser Ordner konnte nicht ganz gelesen werden"), "", "") }
    return true
}

// ---------------------------------------------------------------------------
// The rows shown

fn nameOf(c: *Chooser, entry: *const Entry) -> []const u8 {
    return c.*.names.items()[entry.*.nameAt..entry.*.nameAt + entry.*.nameLength]
}

fn entryAt(c: *Chooser, row: usize) -> *Entry {
    return &c.*.entries.items()[@intCast(usize, c.*.shown.items()[row])]
}

fn filterName(c: *Chooser, index: usize, german: bool) -> []const u8 {
    const text = c.*.filterText.items()
    const filter = &c.*.filters[index]
    if german { return text[filter.*.germanAt..filter.*.germanAt + filter.*.germanLength] }
    return text[filter.*.englishAt..filter.*.englishAt + filter.*.englishLength]
}

fn extensionsOf(c: *Chooser, index: usize) -> []const u8 {
    if index >= c.*.filterCount { return "" }
    const filter = &c.*.filters[index]
    return c.*.filterText.items()[filter.*.extensionsAt..filter.*.extensionsAt + filter.*.extensionsLength]
}

// The first extension of the filter chosen ("": none).
fn firstExtension(c: *Chooser) -> []const u8 {
    const extensions = extensionsOf(c, c.*.filter)
    var at: usize = 0
    while at < extensions.length && extensions[at] == 32 { at += 1 }
    var end = at
    while end < extensions.length && extensions[end] != 32 { end += 1 }
    return extensions[at..end]
}

// Whether filter `index` takes a file of this name.
fn filterTakes(c: *Chooser, index: usize, name: []const u8) -> bool {
    const extensions = extensionsOf(c, index)
    var at: usize = 0
    var any = false
    while at < extensions.length {
        while at < extensions.length && extensions[at] == 32 { at += 1 }
        var end = at
        while end < extensions.length && extensions[end] != 32 { end += 1 }
        const extension = extensions[at..end]
        at = end
        if extension.length == 0 { continue }
        any = true
        if name.length > extension.length + 1 && name[name.length - extension.length - 1] == 46 && endsFolded(name, extension) { return true }
    }
    return !any
}

// Whether entry `a` is shown before entry `b` (indices of the records):
// directories first, then by the column sorted by, by name where that
// says nothing; the other way round when descending.
fn before(c: *Chooser, a: u32, b: u32) -> bool {
    const items = c.*.entries.items()
    const x = &items[@intCast(usize, a)]
    const y = &items[@intCast(usize, b)]
    if x.*.directory != y.*.directory { return x.*.directory }
    var order: i32 = 0
    if c.*.sort == SORT_SIZE && !x.*.directory {
        order = if x.*.size < y.*.size { -1 } else if x.*.size > y.*.size { 1 } else { 0 }
    } else if c.*.sort == SORT_MODIFIED {
        order = if x.*.modified < y.*.modified { -1 } else if x.*.modified > y.*.modified { 1 } else { 0 }
    }
    if order == 0 { order = compareNames(nameOf(c, x), nameOf(c, y)) }
    return if c.*.descending { order > 0 } else { order < 0 }
}

// The rows sorted: a merge sort from runs of one up, between the rows
// and the spare list (stable: what compares the same keeps its order).
// Without memory for the spare list they stay as they are.
fn sortShown(c: *Chooser) -> void {
    const count = c.*.shown.count()
    if count < 2 || !c.*.spare.resize(count) { return }
    const rows: [*]u32 = c.*.shown.items().pointer
    var from: [*]u32 = rows
    var to: [*]u32 = c.*.spare.items().pointer
    var width: usize = 1
    while width < count {
        var start: usize = 0
        while start < count {
            const middle = if count - start > width { start + width } else { count }
            const end = if count - middle > width { middle + width } else { count }
            var left = start
            var right = middle
            var at = start
            while at < end {
                if right < end && (left >= middle || before(c, from[right], from[left])) {
                    to[at] = from[right]
                    right += 1
                } else {
                    to[at] = from[left]
                    left += 1
                }
                at += 1
            }
            start = end
        }
        const swap = from
        from = to
        to = swap
        width *= 2
    }
    if @intFromPtr(from) != @intFromPtr(rows) {
        var index: usize = 0
        while index < count {
            rows[index] = from[index]
            index += 1
        }
    }
}

// The rows made again from the records (the filter, the hidden ones) and
// sorted; the cursor stays on its entry when that is still shown.
fn reshow(c: *Chooser) -> void {
    var kept: usize = NO_ROW
    if c.*.cursor < c.*.shown.count() { kept = @intCast(usize, c.*.shown.items()[c.*.cursor]) }
    c.*.shown.clearRetainingCapacity()
    const count = c.*.entries.count()
    var index: usize = 0
    while index < count && index < ROWS_MOST {
        const entry = &c.*.entries.items()[index]
        var visible = c.*.showHidden || !entry.*.hidden
        if visible && !entry.*.directory { visible = filterTakes(c, c.*.filter, nameOf(c, entry)) }
        // (Only what is seen can be chosen.)
        if !visible { entry.*.selected = false }
        if visible && !c.*.shown.append(@intCast(u32, index)) { break }
        index += 1
    }
    sortShown(c)
    c.*.cursor = NO_ROW
    if kept != NO_ROW {
        var row: usize = 0
        const rows = c.*.shown.items()
        while row < rows.length {
            if @intCast(usize, rows[row]) == kept {
                c.*.cursor = row
                break
            }
            row += 1
        }
    }
    if c.*.cursor == NO_ROW && c.*.mode != MODE_SAVE && c.*.shown.count() > 0 { c.*.cursor = 0 }
    c.*.reveal = true
}

// The first row named `name` (and a directory when `directory`).
fn rowNamed(c: *Chooser, name: []const u8, directory: bool) -> usize {
    var row: usize = 0
    while row < c.*.shown.count() {
        const entry = entryAt(c, row)
        if entry.*.directory == directory && std.text.same(nameOf(c, entry), name) { return row }
        row += 1
    }
    return NO_ROW
}

// ---------------------------------------------------------------------------
// Places and the directories used last

fn placePath(c: *Chooser, index: usize) -> []const u8 {
    const place = &c.*.places[index]
    return c.*.placeText.items()[place.*.pathAt..place.*.pathAt + place.*.pathLength]
}

fn addPlace(c: *Chooser, kind: u8, path: []const u8) -> void {
    if c.*.placeCount >= PLACES || path.length == 0 || path[0] != 47 { return }
    // (A place that is another one already is not listed twice.)
    var index: usize = 0
    while index < c.*.placeCount {
        if std.text.same(placePath(c, index), path) { return }
        index += 1
    }
    if kindOf(c, path) != KIND_DIRECTORY { return }
    const at = c.*.placeText.count()
    if !c.*.placeText.appendSlice(path) { return }
    c.*.places[c.*.placeCount] = Place.{ .kind = kind, .pathAt = at, .pathLength = path.length }
    c.*.placeCount += 1
}

// A user directory by its XDG name ("PICTURES"), where it is.
fn userPlace(app: *App, c: *Chooser, kind: u8, key: []const u8, fallback: []const u8) -> void {
    const bytes: [*]u8 = &c.*.buffer
    const length = xdg.userDirectory(app.*.shell.*.environment, key, fallback, bytes, READ_BUFFER)
    if length > 0 { addPlace(c, kind, bytes[0..length]) }
}

fn findPlaces(app: *App, c: *Chooser) -> void {
    c.*.placeCount = 0
    c.*.placeText.clearRetainingCapacity()
    addPlace(c, PLACE_HOME, shell_module.home(app.*.shell))
    userPlace(app, c, PLACE_DESKTOP, "DESKTOP", "/Desktop")
    userPlace(app, c, PLACE_DOCUMENTS, "DOCUMENTS", "/Documents")
    userPlace(app, c, PLACE_PICTURES, "PICTURES", "/Pictures")
    userPlace(app, c, PLACE_DOWNLOADS, "DOWNLOAD", "/Downloads")
    addPlace(c, PLACE_ROOT, "/")
    const recent = c.*.recent.items()
    var at: usize = 0
    while at < recent.length {
        var end = at
        while end < recent.length && recent[end] != 10 { end += 1 }
        addPlace(c, PLACE_RECENT, recent[at..end])
        at = end + 1
    }
}

fn placeLabel(app: *App, c: *Chooser, index: usize) -> []const u8 {
    const kind = c.*.places[index].kind
    if kind == PLACE_HOME { return state.tr(app, "Home", "Persönlicher Ordner") }
    if kind == PLACE_DESKTOP { return state.tr(app, "Desktop", "Schreibtisch") }
    if kind == PLACE_DOCUMENTS { return state.tr(app, "Documents", "Dokumente") }
    if kind == PLACE_PICTURES { return state.tr(app, "Pictures", "Bilder") }
    if kind == PLACE_DOWNLOADS { return state.tr(app, "Downloads", "Downloads") }
    if kind == PLACE_ROOT { return state.tr(app, "File System", "Dateisystem") }
    return baseName(placePath(c, index))
}

// `directory` first among the directories used last (leaving its place
// further down; RECENT of them at most). One whose name holds a line's
// end is not kept: the list is a line each.
fn remember(c: *Chooser, directory: []const u8) -> void {
    if std.text.contains(directory, "\n") { return }
    c.*.going.clearRetainingCapacity()
    var ok = c.*.going.appendSlice(directory)
    var kept: usize = 1
    const recent = c.*.recent.items()
    var at: usize = 0
    while ok && at < recent.length && kept < RECENT {
        var end = at
        while end < recent.length && recent[end] != 10 { end += 1 }
        const line = recent[at..end]
        at = end + 1
        if line.length > 0 && !std.text.same(line, directory) {
            ok = c.*.going.append(10) && c.*.going.appendSlice(line)
            kept += 1
        }
    }
    if !ok { return }
    c.*.recent.clearRetainingCapacity()
    _ = c.*.recent.appendSlice(c.*.going.items())
}

// The directories used last, a line each, the latest first, after what
// `into` holds: for settings that keep them from one run to the next.
pub fn recentDirectories(app: *App, into: *std.ArrayList(u8)) -> void {
    const c = chooserOf(app)
    if c == null { return }
    _ = into.appendSlice(c.?.*.recent.items())
}

// The directories used last as `text` says (absolute paths, a line each,
// the latest first; what is not one is left out, RECENT are kept). An
// open dialog shows them among its places from its next opening on.
pub fn setRecentDirectories(app: *App, text: []const u8) -> void {
    const found = chooserOf(app)
    if found == null { return }
    const c = found.?
    c.*.recent.clearRetainingCapacity()
    var kept: usize = 0
    var at: usize = 0
    while at < text.length && kept < RECENT {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[at..end])
        at = end + 1
        if line.length == 0 || line[0] != 47 || !normalized(&c.*.going, line) { continue }
        if kept > 0 { _ = c.*.recent.append(10) }
        _ = c.*.recent.appendSlice(c.*.going.items())
        kept += 1
    }
}

// ---------------------------------------------------------------------------
// Opening and closing

// A filter's name in a language with its patterns after it: "PNG image
// (*.png, *.jpg)".
fn appendLabel(c: *Chooser, name: []const u8, extensions: []const u8) -> bool {
    var ok = c.*.filterText.appendSlice(name)
    var at: usize = 0
    var first = true
    while ok && at < extensions.length {
        while at < extensions.length && extensions[at] == 32 { at += 1 }
        var end = at
        while end < extensions.length && extensions[end] != 32 { end += 1 }
        if end > at {
            ok = c.*.filterText.appendSlice(if first { " (*." } else { ", *." }) && c.*.filterText.appendSlice(extensions[at..end])
            first = false
        }
        at = end
    }
    if !first { ok = ok && c.*.filterText.append(41) }
    return ok
}

fn copyFilters(c: *Chooser, filters: []const Filter) -> void {
    c.*.filterText.clearRetainingCapacity()
    c.*.filterCount = 0
    var index: usize = 0
    while index < filters.length && index < FILTERS {
        const filter = &filters[index]
        const text = &c.*.filters[c.*.filterCount]
        text.*.englishAt = c.*.filterText.count()
        if !appendLabel(c, filter.*.name, filter.*.extensions) { return }
        text.*.englishLength = c.*.filterText.count() - text.*.englishAt
        text.*.germanAt = c.*.filterText.count()
        if !appendLabel(c, if filter.*.german.length > 0 { filter.*.german } else { filter.*.name }, filter.*.extensions) { return }
        text.*.germanLength = c.*.filterText.count() - text.*.germanAt
        text.*.extensionsAt = c.*.filterText.count()
        if !c.*.filterText.appendSlice(filter.*.extensions) { return }
        text.*.extensionsLength = filter.*.extensions.length
        c.*.filterCount += 1
        index += 1
    }
}

// The path field shows the directory (a slash after it: a name typed
// next goes into it).
fn showDirectory(c: *Chooser) -> void {
    const directory = c.*.directory.items()
    c.*.going.clearRetainingCapacity()
    _ = c.*.going.appendSlice(directory)
    if directory.length == 0 || directory[directory.length - 1] != 47 { _ = c.*.going.append(47) }
    field_module.set(&c.*.path, c.*.going.items())
}

// The name field holds `name`, the part before its extension selected
// (typing replaces it, the extension stays).
fn setName(c: *Chooser, name: []const u8) -> void {
    field_module.set(&c.*.name, name)
    const text = field_module.text(&c.*.name)
    c.*.name.anchor = baseStart(text)
    c.*.name.cursor = extensionAt(text)
}

fn start(app: *App, mode: u8, title: []const u8, directory: []const u8, name: []const u8, filters: []const Filter, done: Done) -> bool {
    const found = chooserOf(app)
    if found == null { return false }
    const c = found.?
    // Opened again while it is shown: what it shows changes; else it is
    // a dialog more over the window.
    const shown = c.*.open && onStack(app, c)
    if c.*.open && !shown {
        c.*.open = false
        release(c)
    }
    if !shown && app.*.dialogCount >= state.DIALOGS { return false }
    if !c.*.zoneLoaded {
        timezone.load(&c.*.zone, app.*.shell.*.environment, app.*.allocator)
        c.*.zoneLoaded = true
    }
    c.*.mode = mode
    c.*.done = done
    c.*.title.clearRetainingCapacity()
    _ = c.*.title.appendSlice(title)
    copyFilters(c, filters)
    c.*.filter = 0
    c.*.focus = if mode == MODE_SAVE { FOCUS_NAME } else { FOCUS_LIST }
    c.*.creating = false
    c.*.confirming = false
    c.*.typedLength = 0
    c.*.backLength = 0
    c.*.cursor = NO_ROW
    c.*.anchor = NO_ROW
    c.*.offset = 0
    quiet(c)
    field_module.clear(&c.*.folder)
    field_module.clear(&c.*.name)
    c.*.proposedLength = 0
    if mode == MODE_SAVE {
        // The filter that takes the name proposed (else the first).
        var index: usize = 0
        while index < c.*.filterCount {
            if extensionsOf(c, index).length > 0 && filterTakes(c, index, name) {
                c.*.filter = index
                break
            }
            index += 1
        }
        const proposed = if name.length > NAME_MAX { name[0..NAME_MAX] } else { name }
        const bytes: [*]u8 = &c.*.proposed
        c.*.proposedLength = std.text.append(bytes, 0, 256, proposed)
        setName(c, proposed)
    }
    findPlaces(app, c)
    // Where it starts: the directory asked for, else the one used last;
    // when that cannot be read, the home, the root.
    const home = shell_module.home(app.*.shell)
    var ready = false
    if directory.length > 0 {
        ready = resolve(app, c, home, directory) && read(app, c, c.*.target.items())
    } else {
        const recent = c.*.recent.items()
        var end: usize = 0
        while end < recent.length && recent[end] != 10 { end += 1 }
        if end > 0 { ready = resolve(app, c, home, recent[0..end]) && read(app, c, c.*.target.items()) }
    }
    const where_asked = ready || directory.length == 0
    if !ready { ready = resolve(app, c, "/", home) && read(app, c, c.*.target.items()) }
    if !ready { ready = resolve(app, c, "/", "/") && read(app, c, c.*.target.items()) }
    // (The one asked for is named: the person sees why it starts here.)
    if ready && !where_asked { say(c, true, state.tr(app, "\xE2\x80\x9C", "\xE2\x80\x9E"), directory, state.tr(app, "\xE2\x80\x9D cannot be read", "\xE2\x80\x9C kann nicht gelesen werden")) }
    if !ready {
        c.*.directory.clearRetainingCapacity()
        _ = c.*.directory.append(47)
        c.*.names.clearRetainingCapacity()
        c.*.entries.clearRetainingCapacity()
        c.*.shown.clearRetainingCapacity()
        say(c, true, state.tr(app, "No folder could be read", "Kein Ordner konnte gelesen werden"), "", "")
    }
    showDirectory(c)
    // (Laid out at once: layoutOf answers before the first frame.)
    place(app, c, app.*.window)
    if !shown {
        const dialog = state.Dialog.{ .draw = drawDialog, .keyPress = keyDialog, .cancel = closedOutside, .accept = null }
        if !api.pushDialog(app, dialog) {
            release(c)
            return false
        }
        c.*.depth = app.*.dialogCount - 1
        c.*.open = true
    }
    api.redraw(app)
    return true
}

// Shows the dialog for choosing a file to open: `title` over it, in
// `directory` ("": the one used last, else the home; one that cannot be
// read: the home, and the dialog's line says so), the files `filters`
// take (the first chosen; none: all files). `done` is called with the
// file's path when one is chosen, not at all when the dialog is
// cancelled. Called while the dialog is open, it shows the new request
// instead (the first caller is not called). False when it cannot be
// shown (no memory, too many dialogs open).
pub fn open(app: *App, title: []const u8, directory: []const u8, filters: []const Filter, done: Done) -> bool {
    return start(app, MODE_OPEN, title, directory, "", filters, done)
}

// open() for choosing several files: `done` is called once for each, in
// the list's order.
pub fn openMany(app: *App, title: []const u8, directory: []const u8, filters: []const Filter, done: Done) -> bool {
    return start(app, MODE_MANY, title, directory, "", filters, done)
}

// Shows the dialog for naming a file to save: as open(), with `name`
// proposed (the part before its extension selected, so that typing
// replaces it) and the filter that takes it chosen. The file named need
// not be there; one that is there is replaced only when the person says
// so. A name without an extension gets the filter's first.
pub fn save(app: *App, title: []const u8, directory: []const u8, name: []const u8, filters: []const Filter, done: Done) -> bool {
    return start(app, MODE_SAVE, title, directory, name, filters, done)
}

// Whether the app's dialog at the dialog's depth is still this one
// (somebody may have taken it off and shown another there).
fn onStack(app: *App, c: *Chooser) -> bool {
    return c.*.depth < app.*.dialogCount && @intFromPtr(app.*.dialogs[c.*.depth].draw) == @intFromPtr(drawDialog)
}

// What stands in for the dialog closed under another one (the app's
// dialogs can only be taken off from the top): it shows nothing and
// takes itself off as soon as it is on top.
fn drawGone(app: *App, window: ui.Rect) -> void {
    const count = app.*.dialogCount
    if count > 0 && @intFromPtr(app.*.dialogs[count - 1].draw) == @intFromPtr(drawGone) { api.popDialog(app) }
}

fn keyGone(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    drawGone(app, app.*.window)
    return true
}

// Its memory given back but for the directories used last and the
// result, the keys taken from its fields.
fn closed(app: *App, c: *Chooser) -> void {
    c.*.open = false
    const context = state.uiOf(app)
    const focus = context.*.focus
    if focus == idOf(PART_PATH) || focus == idOf(PART_NAME) || focus == idOf(PART_FOLDER) { view.setFocus(context, view.NONE) }
    release(c)
    api.redraw(app)
}

// Closes the dialog (nothing chosen, or after a choice).
fn finish(app: *App, c: *Chooser) -> void {
    if !c.*.open { return }
    if onStack(app, c) {
        if c.*.depth + 1 == app.*.dialogCount {
            api.popDialog(app)
        } else {
            app.*.dialogs[c.*.depth] = state.Dialog.{ .draw = drawGone, .keyPress = keyGone, .cancel = null, .accept = null }
        }
    }
    closed(app, c)
}

// Closes the dialog without a choice (as Cancel does).
pub fn close(app: *App) -> void {
    const c = openChooser(app)
    if c != null { finish(app, c.?) }
}

// The dialog was taken off by another (the loop's Escape when the dialog
// did not take it, dialogs.mlx closing what is on top).
fn closedOutside(app: *App) -> void {
    const c = openChooser(app)
    if c != null { closed(app, c.?) }
}

// Calls back with the paths of the result and closes.
fn deliver(app: *App, c: *Chooser) -> void {
    const done = c.*.done
    const filter = c.*.filter
    // The directory used is the one of the (first) file chosen: a name
    // typed with a folder before it is saved there.
    const chosen = c.*.result.items()
    var first_end: usize = 0
    while first_end < chosen.length && chosen[first_end] != 0 { first_end += 1 }
    if first_end > 0 { remember(c, chosen[0..parentLength(chosen[0..first_end])]) }
    // (The result stays while it is handed over: a `done` that opens the
    // dialog again or closes it leaves it as it is.)
    c.*.handing = true
    finish(app, c)
    if done != null {
        const paths = c.*.result.items()
        var at: usize = 0
        while at < paths.length {
            var end = at
            while end < paths.length && paths[end] != 0 { end += 1 }
            if end > at { done.?(app, paths[at..end], filter) }
            at = end + 1
        }
    }
    c.*.handing = false
    c.*.result.deinit()
}

// The path in the target as the one result.
fn resultIsTarget(c: *Chooser) -> bool {
    c.*.result.clearRetainingCapacity()
    return c.*.result.appendSlice(c.*.target.items()) && c.*.result.append(0)
}

// ---------------------------------------------------------------------------
// Going places

// After the directory changed: nothing typed, nothing being made, the
// path field showing it, the cursor at the first row (none when saving).
fn arrived(c: *Chooser) -> void {
    c.*.creating = false
    c.*.confirming = false
    c.*.anchor = NO_ROW
    if c.*.focus == FOCUS_PATH || c.*.focus == FOCUS_FOLDER { c.*.focus = if c.*.mode == MODE_SAVE { FOCUS_NAME } else { FOCUS_LIST } }
    showDirectory(c)
}

// Goes to directory `path` (absolute; may be the target): true when it
// could be read, else the dialog says so and stays where it is.
fn goTo(app: *App, c: *Chooser, path: []const u8) -> bool {
    c.*.going.clearRetainingCapacity()
    if !c.*.going.appendSlice(path) || !normalized(&c.*.target, c.*.going.items()) { return false }
    if !read(app, c, c.*.target.items()) {
        say(c, true, state.tr(app, "\xE2\x80\x9C", "\xE2\x80\x9E"), c.*.target.items(), state.tr(app, "\xE2\x80\x9D cannot be read", "\xE2\x80\x9C kann nicht gelesen werden"))
        return false
    }
    arrived(c)
    return true
}

fn goInto(app: *App, c: *Chooser, row: usize) -> void {
    if row >= c.*.shown.count() || !childPath(c, nameOf(c, entryAt(c, row))) { return }
    _ = goTo(app, c, c.*.target.items())
}

// Up to the directory above, the cursor on the one left.
fn goUp(app: *App, c: *Chooser) -> void {
    const directory = c.*.directory.items()
    if directory.length <= 1 { return }
    const left = baseName(directory)
    const bytes: [*]u8 = &c.*.back
    c.*.backLength = std.text.append(bytes, 0, 256, left)
    c.*.target.clearRetainingCapacity()
    if !c.*.target.appendSlice(directory[0..parentLength(directory)]) || !goTo(app, c, c.*.target.items()) { return }
    const row = rowNamed(c, bytes[0..c.*.backLength], true)
    if row != NO_ROW {
        c.*.cursor = row
        c.*.reveal = true
    }
}

// The directory read again (what changed in it shows), the cursor kept
// on its name.
fn reread(app: *App, c: *Chooser) -> void {
    var had = false
    if c.*.cursor < c.*.shown.count() {
        const entry = entryAt(c, c.*.cursor)
        const bytes: [*]u8 = &c.*.back
        c.*.backLength = std.text.append(bytes, 0, 256, nameOf(c, entry))
        had = true
    }
    c.*.target.clearRetainingCapacity()
    if !c.*.target.appendSlice(c.*.directory.items()) || !goTo(app, c, c.*.target.items()) { return }
    if had {
        const bytes: [*]const u8 = &c.*.back
        var row = rowNamed(c, bytes[0..c.*.backLength], true)
        if row == NO_ROW { row = rowNamed(c, bytes[0..c.*.backLength], false) }
        if row != NO_ROW { c.*.cursor = row }
    }
}

// Enter in the path field: a directory is gone to; a file is taken (to
// save: its name is the one to save under); a name to save under that is
// not there yet, in a directory that is, too.
fn submitPath(app: *App, c: *Chooser) -> void {
    const typed = std.text.trimmed(field_module.text(&c.*.path))
    if typed.length == 0 {
        showDirectory(c)
        c.*.focus = if c.*.mode == MODE_SAVE { FOCUS_NAME } else { FOCUS_LIST }
        return
    }
    if !resolve(app, c, c.*.directory.items(), typed) { return }
    const kind = kindOf(c, c.*.target.items())
    if kind == KIND_DIRECTORY {
        _ = goTo(app, c, c.*.target.items())
        return
    }
    // A slash at the end asks for a folder: never a file of that name
    // (saving would make "new.png" of a "new/" that is not there).
    if typed[typed.length - 1] == 47 {
        say(c, true, state.tr(app, "There is no folder \xE2\x80\x9C", "Es gibt keinen Ordner \xE2\x80\x9E"), typed, state.tr(app, "\xE2\x80\x9D", "\xE2\x80\x9C"))
        return
    }
    // A file (or, to save, a new name): its directory first.
    const whole = c.*.target.items()
    const name_start = baseStart(whole)
    const bytes: [*]u8 = &c.*.back
    c.*.backLength = std.text.append(bytes, 0, 256, whole[name_start..whole.length])
    const parent = parentLength(whole)
    if (kind == KIND_NONE && c.*.mode != MODE_SAVE) || whole.length - name_start > NAME_MAX {
        say(c, true, state.tr(app, "There is no folder or file \xE2\x80\x9C", "Es gibt keinen Ordner und keine Datei \xE2\x80\x9E"), typed, state.tr(app, "\xE2\x80\x9D", "\xE2\x80\x9C"))
        return
    }
    c.*.going.clearRetainingCapacity()
    if !c.*.going.appendSlice(whole[0..parent]) { return }
    c.*.target.clearRetainingCapacity()
    if !c.*.target.appendSlice(c.*.going.items()) { return }
    if kindOf(c, c.*.target.items()) != KIND_DIRECTORY {
        say(c, true, state.tr(app, "There is no folder \xE2\x80\x9C", "Es gibt keinen Ordner \xE2\x80\x9E"), c.*.target.items(), state.tr(app, "\xE2\x80\x9D", "\xE2\x80\x9C"))
        return
    }
    if !goTo(app, c, c.*.target.items()) { return }
    const name = bytes[0..c.*.backLength]
    if c.*.mode == MODE_SAVE {
        field_module.set(&c.*.name, name)
        c.*.focus = FOCUS_NAME
        accept(app, c)
        return
    }
    const row = rowNamed(c, name, false)
    if row == NO_ROW {
        // (A file the filter does not show is taken all the same.)
        if childPath(c, name) && resultIsTarget(c) { deliver(app, c) }
        return
    }
    c.*.cursor = row
    clearSelection(c)
    accept(app, c)
}

// Tab in the path field: the name after its last slash completed as far
// as the names of that directory that start so agree (a directory's
// alone with a slash after it).
fn complete(app: *App, c: *Chooser) -> void {
    const typed = field_module.text(&c.*.path)
    const slash = baseStart(typed)
    const partial_length = typed.length - slash
    if slash > 0 {
        if !resolve(app, c, c.*.directory.items(), typed[0..slash]) { return }
    } else {
        c.*.target.clearRetainingCapacity()
        if !c.*.target.appendSlice(c.*.directory.items()) { return }
    }
    // (The partial name is copied: the field's text changes below.)
    c.*.result.clearRetainingCapacity()
    if !c.*.result.appendSlice(typed[slash..typed.length]) { return }
    const partial = c.*.result.items()
    const name = terminated(c, c.*.target.items())
    if name == null { return }
    const folder = std.fs.open(name.?, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(folder) { return }
    const buffer: [*]u8 = &c.*.buffer
    var reader = std.fs.entries(folder, buffer, READ_BUFFER)
    var found: std.fs.Entry = undefined
    c.*.going.clearRetainingCapacity()
    var matches: usize = 0
    var only_directory = false
    const dots = partial.length > 0 && partial[0] == 46
    while std.fs.nextEntry(&reader, &found) {
        const entry_name = found.name.pointer[0..found.name.length]
        if std.fs.isDotName(found.name) || entry_name.length < partial.length { continue }
        if entry_name.length > 0 && entry_name[0] == 46 && !dots && !c.*.showHidden { continue }
        if !std.text.same(entry_name[0..partial.length], partial) { continue }
        if matches == 0 {
            if !c.*.going.appendSlice(entry_name) { break }
            only_directory = std.fs.statusFrom(folder, found.name.pointer, &c.*.stat, false) == 0 && c.*.stat.mode & 61440 == 16384
        } else {
            var agree: usize = 0
            const so_far = c.*.going.items()
            while agree < so_far.length && agree < entry_name.length && so_far[agree] == entry_name[agree] { agree += 1 }
            _ = c.*.going.resize(agree)
            only_directory = false
        }
        matches += 1
    }
    _ = std.fs.close(folder)
    c.*.result.clearRetainingCapacity()
    if matches == 0 || c.*.going.count() < partial_length { return }
    const field = &c.*.path
    field.*.cursor = field.*.length
    field.*.anchor = field.*.length
    const common = c.*.going.items()
    if common.length > partial_length { field_module.insert(field, common[partial_length..common.length]) }
    if matches == 1 && only_directory { field_module.insert(field, "/") }
}

// ---------------------------------------------------------------------------
// Choosing

fn clearSelection(c: *Chooser) -> void {
    var row: usize = 0
    while row < c.*.shown.count() {
        entryAt(c, row).*.selected = false
        row += 1
    }
}

// The cursor to `row` (held in the rows). Choosing several: without
// `extend` the file there is the one chosen, with it the run from the
// anchor. Saving: a file's name becomes the one to save under.
fn moveTo(c: *Chooser, row: usize, extend: bool) -> void {
    const count = c.*.shown.count()
    if count == 0 { return }
    const to = if row >= count { count - 1 } else { row }
    c.*.cursor = to
    c.*.reveal = true
    const entry = entryAt(c, to)
    if c.*.mode == MODE_MANY {
        if !extend || c.*.anchor >= count { c.*.anchor = to }
        clearSelection(c)
        var from = if c.*.anchor < to { c.*.anchor } else { to }
        const last = if c.*.anchor < to { to } else { c.*.anchor }
        while from <= last {
            const chosen = entryAt(c, from)
            if !chosen.*.directory { chosen.*.selected = true }
            from += 1
        }
    } else if c.*.mode == MODE_SAVE && !entry.*.directory {
        setName(c, nameOf(c, entry))
    }
}

// A click on a row: the cursor there (choosing several: Control adds or
// takes it, Shift chooses the run from the anchor).
fn clickRow(app: *App, c: *Chooser, row: usize) -> void {
    if row >= c.*.shown.count() { return }
    const modifiers = shell_module.modifiers(app.*.shell)
    if c.*.mode == MODE_MANY && modifiers & keys.CONTROL != 0 {
        const entry = entryAt(c, row)
        if !entry.*.directory { entry.*.selected = !entry.*.selected }
        c.*.cursor = row
        c.*.anchor = row
    } else {
        moveTo(c, row, modifiers & keys.SHIFT != 0)
    }
    if c.*.mode == MODE_SAVE {
        c.*.focus = if entryAt(c, row).*.directory { FOCUS_LIST } else { FOCUS_NAME }
    } else {
        c.*.focus = FOCUS_LIST
    }
}

// Enter on `row` (or its double click): a directory is gone into, a file
// taken.
fn enterRow(app: *App, c: *Chooser, row: usize) -> void {
    if row >= c.*.shown.count() { return }
    if entryAt(c, row).*.directory {
        goInto(app, c, row)
        return
    }
    if c.*.mode == MODE_MANY && !entryAt(c, row).*.selected {
        clearSelection(c)
        entryAt(c, row).*.selected = true
    }
    c.*.cursor = row
    accept(app, c)
}

// Open or Save: what is chosen is taken.
fn accept(app: *App, c: *Chooser) -> void {
    if c.*.focus == FOCUS_PATH {
        submitPath(app, c)
        return
    }
    if c.*.focus == FOCUS_FOLDER {
        makeFolder(app, c)
        return
    }
    if c.*.mode == MODE_SAVE {
        acceptName(app, c)
        return
    }
    c.*.result.clearRetainingCapacity()
    var chosen: usize = 0
    var row: usize = 0
    if c.*.mode == MODE_MANY {
        while row < c.*.shown.count() {
            const entry = entryAt(c, row)
            if entry.*.selected && !entry.*.directory {
                if !childPath(c, nameOf(c, entry)) || !c.*.result.appendSlice(c.*.target.items()) || !c.*.result.append(0) { return }
                chosen += 1
            }
            row += 1
        }
    }
    if chosen == 0 && c.*.cursor < c.*.shown.count() {
        const entry = entryAt(c, c.*.cursor)
        if entry.*.directory {
            goInto(app, c, c.*.cursor)
            return
        }
        if !childPath(c, nameOf(c, entry)) || !resultIsTarget(c) { return }
        chosen = 1
    }
    if chosen == 0 {
        say(c, true, state.tr(app, "Choose a file first", "Bitte zuerst eine Datei wählen"), "", "")
        return
    }
    deliver(app, c)
}

// Save: the name typed is taken (an extension added when it has none);
// a directory of that name is gone into; a file that is there already
// is asked about first.
fn acceptName(app: *App, c: *Chooser) -> void {
    const typed = std.text.trimmed(field_module.text(&c.*.name))
    if typed.length == 0 {
        say(c, true, state.tr(app, "Type a name for the file first", "Bitte zuerst einen Namen für die Datei eingeben"), "", "")
        return
    }
    if !resolve(app, c, c.*.directory.items(), typed) { return }
    var kind = kindOf(c, c.*.target.items())
    if kind == KIND_DIRECTORY {
        if goTo(app, c, c.*.target.items()) {
            const bytes: [*]const u8 = &c.*.proposed
            setName(c, bytes[0..c.*.proposedLength])
            c.*.focus = FOCUS_NAME
        }
        return
    }
    const whole = c.*.target.items()
    const ending = firstExtension(c)
    if extensionAt(whole) == whole.length && ending.length > 0 && whole.length > 1 {
        if !c.*.target.append(46) || !c.*.target.appendSlice(ending) { return }
        // (The name field says what will be written.)
        const named = c.*.target.items()
        field_module.set(&c.*.name, named[baseStart(named)..named.length])
        kind = kindOf(c, c.*.target.items())
    }
    const path = c.*.target.items()
    const name = path[baseStart(path)..path.length]
    if name.length == 0 || name.length > NAME_MAX {
        say(c, true, state.tr(app, "This is no name for a file", "Das ist kein Name für eine Datei"), "", "")
        return
    }
    if kind == KIND_DIRECTORY {
        say(c, true, state.tr(app, "\xE2\x80\x9C", "\xE2\x80\x9E"), name, state.tr(app, "\xE2\x80\x9D is a folder", "\xE2\x80\x9C ist ein Ordner"))
        return
    }
    // The directory it goes into must be there.
    c.*.going.clearRetainingCapacity()
    if !c.*.going.appendSlice(path[0..parentLength(path)]) || kindOf(c, c.*.going.items()) != KIND_DIRECTORY {
        say(c, true, state.tr(app, "There is no folder \xE2\x80\x9C", "Es gibt keinen Ordner \xE2\x80\x9E"), c.*.going.items(), state.tr(app, "\xE2\x80\x9D", "\xE2\x80\x9C"))
        return
    }
    if !resultIsTarget(c) { return }
    if kind == KIND_FILE {
        c.*.confirming = true
        say(c, false, state.tr(app, "\xE2\x80\x9C", "\xE2\x80\x9E"), name, state.tr(app, "\xE2\x80\x9D is there already. Replace it?", "\xE2\x80\x9C gibt es schon. Ersetzen?"))
        return
    }
    deliver(app, c)
}

// The filter chosen changed: the rows again, and the name to save under
// gets the filter's first extension in place of its own.
fn filterChanged(c: *Chooser) -> void {
    reshow(c)
    if c.*.mode != MODE_SAVE { return }
    const ending = firstExtension(c)
    if ending.length == 0 { return }
    const text = field_module.text(&c.*.name)
    const start = baseStart(text)
    const dot = extensionAt(text)
    if dot <= start { return }
    c.*.going.clearRetainingCapacity()
    if !c.*.going.appendSlice(text[0..dot]) || !c.*.going.append(46) || !c.*.going.appendSlice(ending) { return }
    field_module.set(&c.*.name, c.*.going.items())
    c.*.name.anchor = start
    c.*.name.cursor = dot
}

fn toggleHidden(c: *Chooser) -> void {
    c.*.showHidden = !c.*.showHidden
    reshow(c)
}

fn sortBy(c: *Chooser, column: u8) -> void {
    if c.*.sort == column {
        c.*.descending = !c.*.descending
    } else {
        c.*.sort = column
        c.*.descending = false
    }
    reshow(c)
}

// New Folder: a row at the list's top with its name to type, a name no
// entry has yet proposed and selected.
fn startFolder(app: *App, c: *Chooser) -> void {
    const proposal = state.tr(app, "New Folder", "Neuer Ordner")
    const bytes: [*]u8 = &c.*.buffer
    // (freeName gives the whole path: the name is after the directory's.)
    const directory = c.*.directory.items()
    const length = std.fs.freeName(directory, proposal, bytes, READ_BUFFER)
    const skip = directory.length + 1
    field_module.set(&c.*.folder, if length > skip && length - skip <= NAME_MAX { bytes[skip..length] } else { proposal })
    field_module.selectAll(&c.*.folder)
    c.*.creating = true
    c.*.confirming = false
    c.*.focus = FOCUS_FOLDER
    c.*.offset = 0
    quiet(c)
}

fn stopFolder(c: *Chooser) -> void {
    c.*.creating = false
    c.*.focus = if c.*.mode == MODE_SAVE { FOCUS_NAME } else { FOCUS_LIST }
    field_module.clear(&c.*.folder)
}

// The folder named in its row is made, and gone into.
fn makeFolder(app: *App, c: *Chooser) -> void {
    const typed = std.text.trimmed(field_module.text(&c.*.folder))
    if typed.length == 0 {
        say(c, true, state.tr(app, "Type a name for the folder first", "Bitte zuerst einen Namen für den Ordner eingeben"), "", "")
        return
    }
    const bad = std.text.contains(typed, "/") || std.text.same(typed, ".") || std.text.same(typed, "..") || typed.length > NAME_MAX
    if bad {
        say(c, true, state.tr(app, "A folder's name cannot be \xE2\x80\x9C.\xE2\x80\x9D or \xE2\x80\x9C..\xE2\x80\x9D nor hold \xE2\x80\x9C/\xE2\x80\x9D", "Ein Ordnername kann nicht \xE2\x80\x9E.\xE2\x80\x9C oder \xE2\x80\x9E..\xE2\x80\x9C sein und kein \xE2\x80\x9E/\xE2\x80\x9C enthalten"), "", "")
        return
    }
    if !childPath(c, typed) { return }
    const path = c.*.target.items()
    if kindOf(c, path) != KIND_NONE {
        say(c, true, state.tr(app, "\xE2\x80\x9C", "\xE2\x80\x9E"), typed, state.tr(app, "\xE2\x80\x9D is there already", "\xE2\x80\x9C gibt es schon"))
        return
    }
    if !std.fs.makeDirectories(path, 493) || kindOf(c, path) != KIND_DIRECTORY {
        say(c, true, state.tr(app, "The folder \xE2\x80\x9C", "Der Ordner \xE2\x80\x9E"), typed, state.tr(app, "\xE2\x80\x9D could not be made", "\xE2\x80\x9C konnte nicht angelegt werden"))
        return
    }
    stopFolder(c)
    _ = goTo(app, c, c.*.target.items())
}

// Typed over the list: the first row whose name starts with what was
// typed within a second of the letter before.
fn typeAhead(app: *App, c: *Chooser, typed: []const u8) -> void {
    const now = shell_module.now(app.*.shell)
    if now < c.*.typedAt || now - c.*.typedAt > TYPE_AHEAD_MS { c.*.typedLength = 0 }
    c.*.typedAt = now
    for byte in typed {
        if c.*.typedLength < TYPED {
            c.*.typed[c.*.typedLength] = byte
            c.*.typedLength += 1
        }
    }
    const bytes: [*]const u8 = &c.*.typed
    const word = bytes[0..c.*.typedLength]
    var row: usize = 0
    while row < c.*.shown.count() {
        if startsFolded(nameOf(c, entryAt(c, row)), word) {
            moveTo(c, row, false)
            return
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// Keys

// Control and C, X or V in a field: the clipboard. True when used.
fn clipboardKey(app: *App, field: *Field, letter: u8) -> bool {
    const shell = app.*.shell
    if letter == 118 {
        var text = shell_module.clipboard(shell, "text/plain;charset=utf-8")
        if text.length == 0 { text = shell_module.clipboard(shell, "text/plain") }
        var end: usize = 0
        while end < text.length && text[end] != 10 && text[end] != 13 { end += 1 }
        if end > 0 { field_module.insert(field, text[0..end]) }
        return true
    }
    if (letter == 99 || letter == 120) && field_module.hasSelection(field) {
        const text = field_module.text(field)
        _ = shell_module.setClipboard(shell, "text/plain;charset=utf-8", text[field_module.selectionStart(field)..field_module.selectionEnd(field)])
        if letter == 120 { _ = field_module.deleteSelection(field) }
        return true
    }
    return false
}

fn fieldKey(app: *App, field: *Field, code: u32, modifiers: u32, typed: []const u8, letter: u8) -> void {
    if modifiers & keys.CONTROL != 0 && clipboardKey(app, field, letter) { return }
    _ = field_module.fieldKey(field, code, modifiers, typed)
}

fn listKey(app: *App, c: *Chooser, code: u32, modifiers: u32, typed: []const u8, letter: u8) -> void {
    const count = c.*.shown.count()
    const control = modifiers & keys.CONTROL != 0
    const extend = modifiers & keys.SHIFT != 0
    const row_height = ROW * app.*.theme.scale
    const page = @intCast(usize, if c.*.layout.list.height > 2 * row_height { c.*.layout.list.height / row_height - 1 } else { 1 })
    if code == keys.ESCAPE {
        finish(app, c)
    } else if code == keys.TAB {
        c.*.focus = if c.*.mode == MODE_SAVE { FOCUS_NAME } else { FOCUS_PATH }
    } else if code == keys.UP {
        moveTo(c, if c.*.cursor >= count || c.*.cursor == 0 { 0 } else { c.*.cursor - 1 }, extend)
    } else if code == keys.DOWN {
        moveTo(c, if c.*.cursor >= count { 0 } else { c.*.cursor + 1 }, extend)
    } else if code == keys.PAGE_UP {
        moveTo(c, if c.*.cursor >= count || c.*.cursor < page { 0 } else { c.*.cursor - page }, extend)
    } else if code == keys.PAGE_DOWN {
        moveTo(c, if c.*.cursor >= count { page } else { c.*.cursor + page }, extend)
    } else if code == keys.HOME {
        moveTo(c, 0, extend)
    } else if code == keys.END {
        if count > 0 { moveTo(c, count - 1, extend) }
    } else if keys.isEnter(code) {
        // (Several chosen: they are taken, whatever the cursor is on.)
        if c.*.mode != MODE_MANY && c.*.cursor < count { enterRow(app, c, c.*.cursor) } else { accept(app, c) }
    } else if code == keys.BACKSPACE {
        goUp(app, c)
    } else if c.*.mode == MODE_MANY && code == keys.SPACE {
        if c.*.cursor < count {
            const entry = entryAt(c, c.*.cursor)
            if !entry.*.directory { entry.*.selected = !entry.*.selected }
            c.*.anchor = c.*.cursor
        }
    } else if c.*.mode == MODE_MANY && control && letter == 97 {
        var row: usize = 0
        while row < count {
            const entry = entryAt(c, row)
            if !entry.*.directory { entry.*.selected = true }
            row += 1
        }
    } else if !control && modifiers & keys.ALT == 0 && typed.length > 0 && typed[0] >= 32 && typed[0] != 127 {
        if typed[0] == 47 || typed[0] == 126 {
            // A path starts here.
            field_module.set(&c.*.path, typed)
            c.*.focus = FOCUS_PATH
        } else {
            typeAhead(app, c, typed)
        }
    }
}

// A key while the dialog is on top (the loop's: before anything else but
// an open list of the kit's). Every key is the dialog's.
fn keyDialog(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const found = openChooser(app)
    if found == null { return false }
    const c = found.?
    const control = modifiers & keys.CONTROL != 0
    const plain = shell_module.plainTyped(app.*.shell)
    const letter: u8 = if plain.length == 1 { lower(plain[0]) } else { 0 }
    api.redraw(app)
    if c.*.confirming {
        if keys.isEnter(code) {
            deliver(app, c)
        } else if code == keys.ESCAPE {
            c.*.confirming = false
            quiet(c)
        }
        return true
    }
    if control && letter == 104 {
        toggleHidden(c)
        return true
    }
    if control && letter == 108 {
        showDirectory(c)
        field_module.selectAll(&c.*.path)
        c.*.focus = FOCUS_PATH
        return true
    }
    if keys.functionKey(code) == 5 {
        reread(app, c)
        return true
    }
    if modifiers & keys.ALT != 0 && code == keys.UP {
        goUp(app, c)
        return true
    }
    if c.*.focus == FOCUS_PATH {
        if code == keys.TAB {
            complete(app, c)
        } else if code == keys.ESCAPE {
            showDirectory(c)
            c.*.focus = if c.*.mode == MODE_SAVE { FOCUS_NAME } else { FOCUS_LIST }
        } else if keys.isEnter(code) {
            submitPath(app, c)
        } else if code == keys.DOWN {
            c.*.focus = FOCUS_LIST
        } else {
            fieldKey(app, &c.*.path, code, modifiers, typed, letter)
        }
        return true
    }
    if c.*.focus == FOCUS_FOLDER {
        if keys.isEnter(code) {
            makeFolder(app, c)
        } else if code == keys.ESCAPE {
            stopFolder(c)
        } else {
            fieldKey(app, &c.*.folder, code, modifiers, typed, letter)
        }
        return true
    }
    if c.*.focus == FOCUS_NAME {
        if keys.isEnter(code) {
            accept(app, c)
        } else if code == keys.ESCAPE {
            finish(app, c)
        } else if code == keys.TAB || code == keys.DOWN {
            c.*.focus = FOCUS_LIST
            if c.*.cursor >= c.*.shown.count() && c.*.shown.count() > 0 {
                c.*.cursor = 0
                c.*.reveal = true
            }
        } else {
            fieldKey(app, &c.*.name, code, modifiers, typed, letter)
        }
        return true
    }
    listKey(app, c, code, modifiers, typed, letter)
    return true
}

// ---------------------------------------------------------------------------
// Drawing

// `color` over an opaque ground: what is drawn in the dialog shows the
// window under it nowhere.
fn solid(theme: *theme_module.Theme, color: u32) -> u32 {
    return canvas_module.over(theme.*.background | 0xFF000000, color, 255)
}

// Where everything goes in `window` (into the dialog's layout).
fn place(app: *App, c: *Chooser, window: ui.Rect) -> void {
    const s = app.*.theme.scale
    const small = state.smallOf(app)
    const l = &c.*.layout
    const margin = MARGIN * s
    var width = WIDTH * s
    if width > window.width - margin * 2 { width = window.width - margin * 2 }
    var height = HEIGHT * s
    if height > window.height - margin * 2 { height = window.height - margin * 2 }
    if width < 0 { width = 0 }
    if height < 0 { height = 0 }
    const box = ui.rect(window.x + (window.width - width) / 2, window.y + (window.height - height) / 2, width, height)
    l.*.box = box
    const pad = PAD * s
    const left = box.x + pad
    const right = ui.right(box) - pad
    const bar = BAR * s
    var y = box.y + pad + TITLE * s + 8 * s
    // The row of the directory's parts: up, the parts, the hidden files'
    // toggle, New Folder.
    l.*.up = ui.rect(left, y, bar, bar)
    const folder_width = text_module.measure(small, state.tr(app, "New Folder", "Neuer Ordner")) + (ICON + 26) * s
    l.*.newFolder = ui.rect(right - folder_width, y, folder_width, bar)
    const hidden_width = text_module.measure(small, state.tr(app, "Hidden files", "Versteckte Dateien")) + 34 * s
    l.*.hidden = ui.rect(l.*.newFolder.x - 10 * s - hidden_width, y, hidden_width, bar)
    l.*.crumbs = ui.rect(ui.right(l.*.up) + 6 * s, y, l.*.hidden.x - 12 * s - ui.right(l.*.up) - 6 * s, bar)
    y += bar + 6 * s
    l.*.path = ui.rect(left, y, right - left, bar)
    y += bar + 10 * s
    // The bottom: Cancel and Open or Save at the right, the line before
    // them; the filter (and the name to save under) above or beside.
    const buttons_y = ui.bottom(box) - pad - bar
    l.*.accept = ui.rect(right - BUTTON * s, buttons_y, BUTTON * s, bar)
    l.*.cancel = ui.rect(l.*.accept.x - 8 * s - BUTTON * s, buttons_y, BUTTON * s, bar)
    var combo = COMBO * s
    if combo > (right - left) / 3 { combo = (right - left) / 3 }
    var bottom = buttons_y
    if c.*.mode == MODE_SAVE {
        bottom = buttons_y - bar - 8 * s
        const label = text_module.measure(small, state.tr(app, "Name", "Name")) + 10 * s
        l.*.filter = if c.*.filterCount > 0 { ui.rect(right - combo, bottom, combo, bar) } else { ui.rect(right, bottom, 0, 0) }
        const name_right = if c.*.filterCount > 0 { l.*.filter.x - 10 * s } else { right }
        l.*.name = ui.rect(left + label, bottom, name_right - left - label, bar)
        l.*.message = ui.rect(left, buttons_y, l.*.cancel.x - 12 * s - left, bar)
    } else {
        l.*.name = ui.rect(left, buttons_y, 0, 0)
        l.*.filter = if c.*.filterCount > 0 { ui.rect(left, buttons_y, combo, bar) } else { ui.rect(left, buttons_y, 0, 0) }
        const message_left = if c.*.filterCount > 0 { ui.right(l.*.filter) + 12 * s } else { left }
        l.*.message = ui.rect(message_left, buttons_y, l.*.cancel.x - 12 * s - message_left, bar)
    }
    // The places and the list between.
    const content_bottom = bottom - 10 * s
    var side = SIDE * s
    if side > (right - left) / 4 { side = (right - left) / 4 }
    l.*.places = ui.rect(left, y, side, content_bottom - y)
    const frame_left = left + side + 10 * s
    l.*.frame = ui.rect(frame_left, y, right - frame_left, content_bottom - y)
    const inner = ui.rect(l.*.frame.x + s, l.*.frame.y + s, l.*.frame.width - 2 * s, l.*.frame.height - 2 * s)
    // (A little air under the heads' line: a lit first row does not touch it.)
    l.*.list = ui.rect(inner.x, inner.y + HEAD * s + 3 * s, inner.width, inner.height - HEAD * s - 3 * s)
    // The heads (their columns follow the rows': see drawList).
    l.*.nameHead = ui.rect(inner.x, inner.y, 0, HEAD * s)
    l.*.sizeHead = ui.rect(inner.x, inner.y, 0, HEAD * s)
    l.*.modifiedHead = ui.rect(inner.x, inner.y, 0, HEAD * s)
}

// A field of the dialog (std.ui.field's, in the measures of the kit's
// fields: the small font, a row's corners), with the keys when
// `focused`. True when a press gave it the keys.
fn drawField(app: *App, id: u64, area: ui.Rect, field: *Field, placeholder: []const u8, focused: bool) -> bool {
    const context = state.uiOf(app)
    const theme = state.themeOf(app)
    const s = theme.*.scale
    if focused && !view.hasFocus(context, id) { view.setFocus(context, id) }
    if !focused && view.hasFocus(context, id) { view.setFocus(context, view.NONE) }
    const radius = theme.*.radius
    const padding = theme.*.padding
    const body = context.*.body
    const time = context.*.time
    theme.*.radius = theme.*.smallRadius
    theme.*.padding = 7 * s
    context.*.body = context.*.small
    // (A steady caret: nothing asks for frames to blink it.)
    context.*.time = 0
    _ = field_module.textField(context, id, area, field, placeholder, false)
    context.*.time = time
    context.*.body = body
    theme.*.padding = padding
    theme.*.radius = radius
    const has = view.hasFocus(context, id)
    if !has { canvas_module.strokeRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, s, theme_module.mix(theme.*.field, theme.*.border, 330)) }
    return has && !focused
}

// A part of the directory's path to click (`current`: the last).
fn crumb(kit: *Kit, id: u64, area: ui.Rect, label: []const u8, current: bool) -> bool {
    const context = kit.*.ui
    const theme = kit.*.theme
    const s = theme.*.scale
    view.region(context, id, area)
    const down = view.isPressed(context, id) && context.*.pointerDown
    if down || view.isHover(context, id) { canvas_module.fillRoundedRect(context.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius + s, if down { theme.*.pressed } else { theme.*.buttonHover }) }
    kit_module.label(kit, ui.rect(area.x + 6 * s, area.y, area.width - 12 * s, area.height), label, if current { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_CENTER)
    return view.takeClick(context, id)
}

fn crumbCount(path: []const u8) -> usize {
    if path.length <= 1 { return 1 }
    var count: usize = 1
    for byte in path {
        if byte == 47 { count += 1 }
    }
    return count
}

// Where part `index` of `path` ends (0: the root, "/").
fn crumbEnd(path: []const u8, index: usize) -> usize {
    if index == 0 { return 1 }
    var seen: usize = 0
    var at: usize = 1
    while at <= path.length {
        if at == path.length || path[at] == 47 {
            seen += 1
            if seen == index { return at }
        }
        at += 1
    }
    return path.length
}

fn crumbLabel(path: []const u8, index: usize) -> []const u8 {
    if index == 0 { return "/" }
    const end = crumbEnd(path, index)
    const from = crumbEnd(path, index - 1) + (if index == 1 { 0 } else { 1 })
    return path[from..end]
}

fn crumbWidth(small: *text_module.Text, label: []const u8, s: i32) -> i32 {
    const width = text_module.measure(small, label) + 14 * s
    return if width > CRUMB_MOST * s { CRUMB_MOST * s } else { width }
}

// The directory's parts from the root, as many of the last as fit (an
// ellipsis for those before, going to the last of them). The part
// clicked, or NO_ROW.
fn drawCrumbs(app: *App, c: *Chooser, kit: *Kit, area: ui.Rect) -> usize {
    const s = kit.*.theme.*.scale
    const small = state.smallOf(app)
    const path = c.*.directory.items()
    const count = crumbCount(path)
    const gap = 14 * s
    const ellipsis = crumbWidth(small, "\xE2\x80\xA6", s) + gap
    var first = count - 1
    var used = crumbWidth(small, crumbLabel(path, count - 1), s)
    while first > 0 {
        const wanted = used + gap + crumbWidth(small, crumbLabel(path, first - 1), s)
        if wanted + (if first > 1 { ellipsis } else { 0 }) > area.width { break }
        used = wanted
        first -= 1
    }
    var clicked = NO_ROW
    var x = area.x
    const canvas = kit_module.canvasOf(kit)
    const dim = kit.*.theme.*.dim
    if first > 0 {
        const width = ellipsis - gap
        if crumb(kit, idOf(PART_ELLIPSIS), ui.rect(x, area.y, width, area.height), "\xE2\x80\xA6", false) { clicked = first - 1 }
        x += width
        icons.draw(canvas, icons.CHEVRON_RIGHT, x + (gap - 10 * s) / 2, area.y + (area.height - 10 * s) / 2, 10 * s, dim)
        x += gap
    }
    var index = first
    while index < count {
        const label = crumbLabel(path, index)
        var width = crumbWidth(small, label, s)
        if width > ui.right(area) - x { width = ui.right(area) - x }
        if width <= 0 { break }
        if crumb(kit, idOf(CRUMBS_FROM + index), ui.rect(x, area.y, width, area.height), label, index + 1 == count) { clicked = index }
        x += width
        if index + 1 < count {
            icons.draw(canvas, icons.CHEVRON_RIGHT, x + (gap - 10 * s) / 2, area.y + (area.height - 10 * s) / 2, 10 * s, dim)
            x += gap
        }
        index += 1
    }
    return clicked
}

// The places at the left; the one clicked, or NO_ROW.
fn drawPlaces(app: *App, c: *Chooser, kit: *Kit, area: ui.Rect) -> usize {
    const s = kit.*.theme.*.scale
    const theme = kit.*.theme
    const row_height = ROW * s
    const heading = 20 * s
    var clicked = NO_ROW
    var y = area.y
    kit_module.label(kit, ui.rect(area.x + 8 * s, y, area.width - 8 * s, heading), state.tr(app, "Places", "Orte"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    y += heading
    const directory = c.*.directory.items()
    var index: usize = 0
    var recent_shown = false
    while index < c.*.placeCount {
        const recent = c.*.places[index].kind == PLACE_RECENT
        if recent && !recent_shown {
            if y + heading + 6 * s + row_height > ui.bottom(area) { break }
            y += 6 * s
            kit_module.label(kit, ui.rect(area.x + 8 * s, y, area.width - 8 * s, heading), state.tr(app, "Recent", "Zuletzt benutzt"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
            y += heading
            recent_shown = true
        }
        if y + row_height > ui.bottom(area) { break }
        const row = ui.rect(area.x, y, area.width, row_height)
        const id = idOf(PLACES_FROM + index)
        const here = std.text.same(placePath(c, index), directory)
        if kit_module.listRow(kit, id, row, here, false) != kit_module.ROW_NONE { clicked = index }
        icons.draw(kit_module.canvasOf(kit), icons.FOLDER, row.x + 8 * s, row.y + (row_height - ICON * s) / 2, ICON * s, if here { theme.*.accent } else { theme.*.dim })
        kit_module.label(kit, ui.rect(row.x + (ICON + 16) * s, row.y, row.width - (ICON + 20) * s, row_height), placeLabel(app, c, index), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
        if recent { kit_module.tooltip(kit, id, row, placePath(c, index)) }
        y += row_height
        index += 1
    }
    return clicked
}

fn isPicture(name: []const u8) -> bool {
    return endsFolded(name, ".png") || endsFolded(name, ".jpg") || endsFolded(name, ".jpeg") || endsFolded(name, ".webp") || endsFolded(name, ".gif") || endsFolded(name, ".bmp") || endsFolded(name, ".tif") || endsFolded(name, ".tiff") || endsFolded(name, ".kra") || endsFolded(name, ".ora") || endsFolded(name, ".psd")
}

// A sheet of paper: what a file that is no picture shows.
fn drawPage(canvas: *Canvas, x: i32, y: i32, size: i32, s: i32, color: u32) -> void {
    canvas_module.strokeRoundedRect(canvas, x + size / 5, y + size / 16, size - 2 * (size / 5), size - size / 8, 2 * s, s, color)
    canvas_module.fillRect(canvas, x + size * 2 / 5, y + size * 5 / 16, size / 4, s, color)
    canvas_module.fillRect(canvas, x + size * 2 / 5, y + size / 2, size / 4, s, color)
}

// The list: its frame, the rows in view (scrolled with the kit) and the
// heads of its columns. What its rows were asked for goes into `act`.
fn drawList(app: *App, c: *Chooser, kit: *Kit, act: *u8, act_row: *usize) -> void {
    const context = state.uiOf(app)
    const theme = kit.*.theme
    const s = theme.*.scale
    const l = &c.*.layout
    const frame = l.*.frame
    canvas_module.fillRoundedRect(context.*.canvas, frame.x, frame.y, frame.width, frame.height, theme.*.smallRadius, solid(theme, theme.*.field))
    canvas_module.strokeRoundedRect(context.*.canvas, frame.x, frame.y, frame.width, frame.height, theme.*.smallRadius, s, theme_module.mix(theme.*.field, theme.*.border, 330))
    const heads = ui.rect(frame.x + s, frame.y + s, frame.width - 2 * s, HEAD * s)
    canvas_module.fillRect(context.*.canvas, heads.x + s, heads.y + s, heads.width - 2 * s, heads.height - s, theme_module.mix(theme.*.field, theme.*.panel, 640))
    canvas_module.fillRect(context.*.canvas, heads.x, ui.bottom(heads), heads.width, s, theme.*.divider)
    const view_area = l.*.list
    const row_height = ROW * s
    const extra: usize = if c.*.creating { 1 } else { 0 }
    var rows = c.*.shown.count() + extra
    if rows > ROWS_MOST { rows = ROWS_MOST }
    // The cursor brought into view (a key moved it).
    if c.*.reveal && c.*.cursor < c.*.shown.count() && view_area.height > 0 {
        const top = @intCast(i32, c.*.cursor + extra) * row_height
        if top < c.*.offset { c.*.offset = top }
        if top + row_height > c.*.offset + view_area.height { c.*.offset = top + row_height - view_area.height }
    }
    c.*.reveal = false
    const content = kit_module.scrollBegin(kit, idOf(PART_LIST), view_area, @intCast(i32, rows) * row_height, &c.*.offset)
    const canvas = kit_module.canvasOf(kit)
    // Columns: the name, the size (right aligned), when it changed.
    const date_x = ui.right(content) - DATE_COLUMN * s
    const size_x = date_x - SIZE_COLUMN * s
    const name_x = content.x + (ICON + 16) * s
    const first = @intCast(usize, if c.*.offset > 0 { c.*.offset / row_height } else { 0 })
    const most = if view_area.height > 0 { @intCast(usize, (c.*.offset + view_area.height + row_height - 1) / row_height) } else { first }
    const end = if most < rows { most } else { rows }
    var row = first
    while row < end {
        const area = ui.rect(content.x + 2 * s, content.y + @intCast(i32, row) * row_height, content.width - 4 * s, row_height)
        const icon_y = area.y + (row_height - ICON * s) / 2
        if row < extra {
            icons.draw(canvas, icons.FOLDER, area.x + 6 * s, icon_y, ICON * s, theme.*.accent)
            if drawField(app, idOf(PART_FOLDER), ui.rect(name_x - 6 * s, area.y + s, size_x - name_x, row_height - 2 * s), &c.*.folder, "", c.*.focus == FOCUS_FOLDER) {
                act.* = ACT_FOCUS
                act_row.* = @intCast(usize, FOCUS_FOLDER)
            }
        } else {
            const index = row - extra
            const entry = entryAt(c, index)
            const chosen = if c.*.mode == MODE_MANY { entry.*.selected } else { index == c.*.cursor }
            const lit = c.*.mode == MODE_MANY && index == c.*.cursor
            const clicked = kit_module.listRow(kit, view.idOf(idOf(PART_LIST), ROWS_FROM + index), area, chosen, lit)
            if clicked == kit_module.ROW_CLICKED {
                act.* = ACT_CLICK
                act_row.* = index
            } else if clicked == kit_module.ROW_DOUBLE_CLICKED {
                act.* = ACT_ENTER
                act_row.* = index
            }
            if canvas.*.width > 0 {
                const name = nameOf(c, entry)
                const ink = if entry.*.hidden { theme.*.dim } else { theme.*.text }
                if entry.*.directory {
                    icons.draw(canvas, icons.FOLDER, area.x + 6 * s, icon_y, ICON * s, theme.*.accent)
                } else if isPicture(name) {
                    icons.draw(canvas, icons.IMAGE, area.x + 6 * s, icon_y, ICON * s, ink)
                } else {
                    drawPage(canvas, area.x + 6 * s, icon_y, ICON * s, s, ink)
                }
                kit_module.label(kit, ui.rect(name_x, area.y, size_x - name_x - 8 * s, row_height), name, if entry.*.hidden { kit_module.TEXT_DIM } else { kit_module.TEXT_NORMAL }, kit_module.ALIGN_LEFT)
                const german = app.*.german
                if !entry.*.directory {
                    const size_bytes: [*]u8 = &c.*.sizeBytes
                    const size_length = sizeText(entry.*.size, german, size_bytes)
                    kit_module.label(kit, ui.rect(size_x, area.y, SIZE_COLUMN * s - 12 * s, row_height), size_bytes[0..size_length], kit_module.TEXT_DIM, kit_module.ALIGN_RIGHT)
                }
                const date_bytes: [*]u8 = &c.*.dateBytes
                const date_length = dateText(c, entry.*.modified, german, date_bytes)
                kit_module.label(kit, ui.rect(date_x, area.y, DATE_COLUMN * s - 6 * s, row_height), date_bytes[0..date_length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
            }
        }
        row += 1
    }
    kit_module.scrollEnd(kit)
    if rows == 0 {
        const empty = if c.*.entries.count() == 0 { state.tr(app, "This folder is empty", "Dieser Ordner ist leer") } else { state.tr(app, "Nothing here is of this kind", "Hier ist nichts von dieser Art") }
        kit_module.label(kit, ui.rect(view_area.x, view_area.y + 8 * s, view_area.width, row_height), empty, kit_module.TEXT_DIM, kit_module.ALIGN_CENTER)
    }
    // The heads, over the rows' columns.
    l.*.nameHead = ui.rect(name_x, heads.y, size_x - name_x - 8 * s, HEAD * s)
    l.*.sizeHead = ui.rect(size_x, heads.y, SIZE_COLUMN * s - 12 * s, HEAD * s)
    l.*.modifiedHead = ui.rect(date_x, heads.y, DATE_COLUMN * s - 6 * s, HEAD * s)
    if lists.columnHeader(context, idOf(PART_NAME_HEAD), l.*.nameHead, state.tr(app, "Name", "Name"), c.*.sort == SORT_NAME, c.*.descending, false) {
        act.* = ACT_SORT
        act_row.* = @intCast(usize, SORT_NAME)
    }
    if lists.columnHeader(context, idOf(PART_SIZE_HEAD), l.*.sizeHead, state.tr(app, "Size", "Größe"), c.*.sort == SORT_SIZE, c.*.descending, true) {
        act.* = ACT_SORT
        act_row.* = @intCast(usize, SORT_SIZE)
    }
    if lists.columnHeader(context, idOf(PART_DATE_HEAD), l.*.modifiedHead, state.tr(app, "Modified", "Geändert"), c.*.sort == SORT_MODIFIED, c.*.descending, false) {
        act.* = ACT_SORT
        act_row.* = @intCast(usize, SORT_MODIFIED)
    }
}

// The kit's list of the filters names them so.
fn filterListName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    const c = openChooser(app)
    if c == null || index >= c.?.*.filterCount { return "" }
    return filterName(c.?, index, app.*.german)
}

// The dialog over `window` (the loop draws it after the window's parts):
// the frame's input taken, what it asked for done at the end.
fn drawDialog(app: *App, window: ui.Rect) -> void {
    const found = openChooser(app)
    if found == null { return }
    const c = found.?
    const kit = api.kit(app)
    const context = state.uiOf(app)
    const theme = state.themeOf(app)
    const s = theme.*.scale
    place(app, c, window)
    const l = &c.*.layout
    const canvas = kit_module.canvasOf(kit)
    var act = ACT_NONE
    var act_row: usize = 0
    // The window dimmed under it; its box.
    canvas_module.fillRect(canvas, window.x, window.y, window.width, window.height, canvas_module.color(110, 0, 0, 0))
    const box = l.*.box
    const radius = theme.*.smallRadius + 2 * s
    canvas_module.fillRoundedRect(canvas, box.x + 2 * s, box.y + 6 * s, box.width, box.height, radius, theme.*.shadow)
    canvas_module.fillRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, solid(theme, theme.*.panel))
    canvas_module.strokeRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, s, theme.*.popupBorder)
    const pad = PAD * s
    kit_module.heading(kit, ui.rect(box.x + pad, box.y + pad, box.width - pad * 2, TITLE * s), c.*.title.items())
    // The directory's row.
    const at_root = c.*.directory.count() <= 1
    if at_root { kit_module.disabledBegin(kit) }
    if kit_module.iconButton(kit, idOf(PART_UP), l.*.up, icons.drawFor, @intCast(usize, icons.ARROW_UP), state.tr(app, "Up to the folder above (Backspace)", "Hinauf zum Ordner darüber (Rücktaste)")) { act = ACT_UP }
    if at_root { kit_module.disabledEnd(kit) }
    const crumb_clicked = drawCrumbs(app, c, kit, l.*.crumbs)
    if crumb_clicked != NO_ROW {
        act = ACT_CRUMB
        act_row = crumb_clicked
    }
    var hidden = c.*.showHidden
    if kit_module.checkBox(kit, idOf(PART_HIDDEN), l.*.hidden, state.tr(app, "Hidden files", "Versteckte Dateien"), &hidden) { act = ACT_HIDDEN }
    kit_module.tooltip(kit, idOf(PART_HIDDEN), l.*.hidden, state.tr(app, "Show the files whose names start with a dot (Ctrl+H)", "Dateien zeigen, deren Namen mit einem Punkt beginnen (Strg+H)"))
    if kit_module.button(kit, idOf(PART_NEW_FOLDER), l.*.newFolder, "", kit_module.BUTTON_NORMAL) { act = ACT_NEW_FOLDER }
    const folder_area = l.*.newFolder
    icons.draw(kit_module.canvasOf(kit), icons.PLUS, folder_area.x + 8 * s, folder_area.y + (folder_area.height - ICON * s) / 2, ICON * s, theme.*.text)
    kit_module.label(kit, ui.rect(folder_area.x + (ICON + 14) * s, folder_area.y, folder_area.width - (ICON + 20) * s, folder_area.height), state.tr(app, "New Folder", "Neuer Ordner"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    // The path field.
    if drawField(app, idOf(PART_PATH), l.*.path, &c.*.path, state.tr(app, "A path, or a name in this folder", "Ein Pfad oder ein Name in diesem Ordner"), c.*.focus == FOCUS_PATH) {
        act = ACT_FOCUS
        act_row = @intCast(usize, FOCUS_PATH)
    }
    // The places, the list.
    const place_clicked = drawPlaces(app, c, kit, l.*.places)
    if place_clicked != NO_ROW {
        act = ACT_PLACE
        act_row = place_clicked
    }
    drawList(app, c, kit, &act, &act_row)
    // The bottom.
    if c.*.mode == MODE_SAVE {
        const name_area = l.*.name
        kit_module.label(kit, ui.rect(l.*.box.x + pad, name_area.y, name_area.x - l.*.box.x - pad, name_area.height), state.tr(app, "Name", "Name"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
        if drawField(app, idOf(PART_NAME), name_area, &c.*.name, state.tr(app, "The file's name", "Der Name der Datei"), c.*.focus == FOCUS_NAME) {
            act = ACT_FOCUS
            act_row = @intCast(usize, FOCUS_NAME)
        }
    }
    if c.*.filterCount > 0 {
        if kit_module.comboBoxWith(kit, idOf(PART_FILTER), l.*.filter, c.*.filterCount, filterListName, @intFromPtr(app), &c.*.filter) { act = ACT_FILTER }
    }
    if c.*.messageLength > 0 {
        const bytes: [*]const u8 = &c.*.message
        var line = l.*.message
        if c.*.danger {
            icons.draw(kit_module.canvasOf(kit), icons.WARNING, line.x, line.y + (line.height - ICON * s) / 2, ICON * s, theme.*.danger)
            line = ui.rect(line.x + (ICON + 6) * s, line.y, line.width - (ICON + 6) * s, line.height)
        }
        const said = bytes[0..c.*.messageLength]
        kit_module.label(kit, line, said, if c.*.danger { kit_module.TEXT_DANGER } else { kit_module.TEXT_NORMAL }, kit_module.ALIGN_LEFT)
        // (A line cut short, as a long path makes it, is read whole
        // under the pointer.)
        if text_module.measure(state.smallOf(app), said) > line.width {
            view.region(context, idOf(PART_MESSAGE), l.*.message)
            kit_module.tooltip(kit, idOf(PART_MESSAGE), l.*.message, said)
        }
    }
    if c.*.confirming {
        if kit_module.button(kit, idOf(PART_BACK), l.*.cancel, state.tr(app, "Back", "Zurück"), kit_module.BUTTON_NORMAL) { act = ACT_BACK }
        if kit_module.button(kit, idOf(PART_REPLACE), l.*.accept, state.tr(app, "Replace", "Ersetzen"), kit_module.BUTTON_PRIMARY) { act = ACT_REPLACE }
    } else {
        if kit_module.button(kit, idOf(PART_CANCEL), l.*.cancel, state.tr(app, "Cancel", "Abbrechen"), kit_module.BUTTON_NORMAL) { act = ACT_CANCEL }
        var ready = c.*.cursor < c.*.shown.count() || c.*.focus == FOCUS_PATH || c.*.focus == FOCUS_FOLDER
        if c.*.mode == MODE_SAVE { ready = std.text.trimmed(field_module.text(&c.*.name)).length > 0 || c.*.focus == FOCUS_PATH || c.*.focus == FOCUS_FOLDER }
        const label = if c.*.mode == MODE_SAVE { state.tr(app, "Save", "Speichern") } else { state.tr(app, "Open", "Öffnen") }
        if kit_module.button(kit, idOf(PART_ACCEPT), l.*.accept, label, kit_module.BUTTON_PRIMARY | (if ready { 0 } else { kit_module.BUTTON_DISABLED })) { act = ACT_ACCEPT }
    }
    if act == ACT_NONE { return }
    perform(app, c, act, act_row)
    context.*.changed = true
    api.redraw(app)
}

// What a frame's widgets asked for.
fn perform(app: *App, c: *Chooser, act: u8, row: usize) -> void {
    // (Anything but the answer ends the question whether to replace.)
    if c.*.confirming && act != ACT_REPLACE {
        c.*.confirming = false
        quiet(c)
    }
    if c.*.creating && act != ACT_FOCUS && act != ACT_ACCEPT { stopFolder(c) }
    if act == ACT_UP {
        goUp(app, c)
    } else if act == ACT_CRUMB {
        c.*.target.clearRetainingCapacity()
        const path = c.*.directory.items()
        if c.*.target.appendSlice(path[0..crumbEnd(path, row)]) { _ = goTo(app, c, c.*.target.items()) }
    } else if act == ACT_PLACE {
        c.*.target.clearRetainingCapacity()
        if c.*.target.appendSlice(placePath(c, row)) { _ = goTo(app, c, c.*.target.items()) }
    } else if act == ACT_CLICK {
        clickRow(app, c, row)
    } else if act == ACT_ENTER {
        enterRow(app, c, row)
    } else if act == ACT_SORT {
        sortBy(c, @intCast(u8, row))
    } else if act == ACT_HIDDEN {
        toggleHidden(c)
    } else if act == ACT_NEW_FOLDER {
        startFolder(app, c)
    } else if act == ACT_FILTER {
        filterChanged(c)
    } else if act == ACT_ACCEPT {
        accept(app, c)
    } else if act == ACT_CANCEL {
        finish(app, c)
    } else if act == ACT_REPLACE {
        deliver(app, c)
    } else if act == ACT_FOCUS {
        c.*.focus = @intCast(u8, row)
    }
}

// ---------------------------------------------------------------------------
// What it shows (for the program's checks, and whoever draws over it)

// Whether the dialog is open (on top or under another).
pub fn isOpen(app: *App) -> bool { return openChooser(app) != null }

// The directory shown ("" when the dialog is not open).
pub fn directory(app: *App) -> []const u8 {
    const c = openChooser(app)
    if c == null { return "" }
    return c.?.*.directory.items()
}

// How many rows the list has (0 when the dialog is not open), and the
// name of each and whether it is a directory, in the order shown ("" and
// false for a row that is not there).
pub fn rowCount(app: *App) -> usize {
    const c = openChooser(app)
    if c == null { return 0 }
    return c.?.*.shown.count()
}

pub fn rowName(app: *App, row: usize) -> []const u8 {
    const c = openChooser(app)
    if c == null || row >= c.?.*.shown.count() { return "" }
    return nameOf(c.?, entryAt(c.?, row))
}

pub fn rowIsDirectory(app: *App, row: usize) -> bool {
    const c = openChooser(app)
    if c == null || row >= c.?.*.shown.count() { return false }
    return entryAt(c.?, row).*.directory
}

// What the row's size and date columns say, in the program's language
// ("4.2 kB", "2026-11-25 14:03"; "" for a directory's size, a date not
// known, a row that is not there). Good until the next frame or call.
pub fn rowSize(app: *App, row: usize) -> []const u8 {
    const c = openChooser(app)
    if c == null || row >= c.?.*.shown.count() || entryAt(c.?, row).*.directory { return "" }
    const bytes: [*]u8 = &c.?.*.sizeBytes
    return bytes[0..sizeText(entryAt(c.?, row).*.size, app.*.german, bytes)]
}

pub fn rowModified(app: *App, row: usize) -> []const u8 {
    const c = openChooser(app)
    if c == null || row >= c.?.*.shown.count() { return "" }
    const bytes: [*]u8 = &c.?.*.dateBytes
    return bytes[0..dateText(c.?, entryAt(c.?, row).*.modified, app.*.german, bytes)]
}

// The row the keys move (NO_ROW: none).
pub fn cursorRow(app: *App) -> usize {
    const c = openChooser(app)
    if c == null { return NO_ROW }
    return c.?.*.cursor
}

// Where row `row` of the list is drawn now (by the last frame's layout
// and the scroll offset): it is in view when inside layoutOf().list. An
// empty rectangle when the dialog is not open.
pub fn rowArea(app: *App, row: usize) -> ui.Rect {
    const c = openChooser(app)
    if c == null { return ui.rect(0, 0, 0, 0) }
    const s = app.*.theme.scale
    const list = c.?.*.layout.list
    const extra: usize = if c.?.*.creating { 1 } else { 0 }
    const index = if row >= ROWS_MOST { ROWS_MOST } else { row + extra }
    return ui.rect(list.x, list.y - c.?.*.offset + @intCast(i32, index) * ROW * s, list.width, ROW * s)
}

// The name to save under, as typed ("" when the dialog is not open).
pub fn nameText(app: *App) -> []const u8 {
    const c = openChooser(app)
    if c == null { return "" }
    return field_module.text(&c.?.*.name)
}

// What the path field holds ("" when the dialog is not open).
pub fn pathText(app: *App) -> []const u8 {
    const c = openChooser(app)
    if c == null { return "" }
    return field_module.text(&c.?.*.path)
}

// What the dialog's line says ("": nothing), and whether it asks
// whether to replace a file.
pub fn message(app: *App) -> []const u8 {
    const c = openChooser(app)
    if c == null { return "" }
    const bytes: [*]const u8 = &c.?.*.message
    return bytes[0..c.?.*.messageLength]
}

pub fn asking(app: *App) -> bool {
    const c = openChooser(app)
    return c != null && c.?.*.confirming
}

// The filter chosen (an index of the filters handed over; 0 when the
// dialog is not open).
pub fn filter(app: *App) -> usize {
    const c = openChooser(app)
    if c == null { return 0 }
    return c.?.*.filter
}

// The places at the left: how many (0 when the dialog is not open), and
// the path of each ("" for one that is not there).
pub fn placeCount(app: *App) -> usize {
    const c = openChooser(app)
    if c == null { return 0 }
    return c.?.*.placeCount
}

pub fn placeAt(app: *App, index: usize) -> []const u8 {
    const c = openChooser(app)
    if c == null || index >= c.?.*.placeCount { return "" }
    return placePath(c.?, index)
}

// Where the parts were drawn in the last frame (laid out already when
// open() or save() returns; empty rectangles when it is not open).
pub fn layoutOf(app: *App) -> Layout {
    const empty = ui.rect(0, 0, 0, 0)
    const c = openChooser(app)
    if c == null { return Layout.{ .box = empty, .up = empty, .crumbs = empty, .hidden = empty, .newFolder = empty, .path = empty, .places = empty, .frame = empty, .nameHead = empty, .sizeHead = empty, .modifiedHead = empty, .list = empty, .name = empty, .filter = empty, .message = empty, .cancel = empty, .accept = empty } }
    return c.?.*.layout
}
