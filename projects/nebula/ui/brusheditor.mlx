// nebula ui: the brush editor: a dialog (ui/dialogs.mlx hosts it) that
// edits a copy of the brush in use. At the top the brush's name and its
// engine, under them a stroke drawn with the brush as it is now (drawn
// again only when something of the brush changed, not every frame). At
// the left the pages: the tip, the general settings, and the options the
// pen drives (size, opacity, flow, rotation, ... value), each with a box
// that turns it on; at the right the page chosen:
//
//   Tip       made by rule (its shape, diameter, ratio, hardness along
//             and across, angle, spikes, density, randomness, how its
//             edge softens, anti-aliasing) or a built-in picture (a grid
//             of them), the spacing of its dabs (or auto spacing), how
//             finely dabs are placed
//   General   opacity, flow, wash or build-up, eraser, airbrush and its
//             rate, scatter and its directions, where the colour comes
//             from
//   options   on or off, its strength, its sensors (a sensor's kind is
//             changed in its list, one is added from the kinds, removed
//             by its cross), how they combine, the response curve of the
//             sensor chosen (ui/kit.mlx's curveEditor: a press on the
//             curve adds a point, a point dragged far out goes) and what
//             that sensor takes (a length, the drawing angle's corners)
//
// OK makes the copy the brush in use (app/brushes.mlx use); Save as
// Preset keeps it among the painter's presets under the name at the top
// (brush/presets.mlx save; the dialog stays open); Cancel, Escape and the
// close cross leave the brush in use as it was. Up and Down go to the
// page before or after.
//
//     brusheditor.open(app)
//
// Not done: the options the framework hands only to engines (smudge
// length, colour rate, ... of engines that are not written yet) are not
// listed; textures (brush/types.mlx keeps their numbers, nothing paints
// them) are not offered.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const controls = @import("std.ui.controls")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const brushes = @import("../app/brushes.mlx")
const keys = @import("../app/keys.mlx")
const types = @import("../brush/types.mlx")
const curve_module = @import("../brush/curve.mlx")
const engines = @import("../brush/engines.mlx")
const tip_module = @import("../brush/tip.mlx")
const presets = @import("../brush/presets.mlx")
const pixel = @import("../core/pixel.mlx")
const kit_module = @import("./kit.mlx")
const dialogs = @import("./dialogs.mlx")
const icons = @import("./icons.mlx")
const preset_docker = @import("../dockers/presets.mlx")

pub const App = state.App
pub const Settings = types.Settings

// The dialog's size, the list of pages' width, a row and the gap under
// it, the gap between the columns (logical pixels).
pub const WIDTH: i32 = 760
pub const HEIGHT: i32 = 672
const LIST_WIDTH: i32 = 196
const ROW: i32 = 24
const ROW_GAP: i32 = 6
const GAP: i32 = 12
const LABEL: i32 = 112
// The preview: its height, the widest it is drawn, the largest diameter
// its stroke is drawn with.
pub const PREVIEW_HEIGHT: usize = 80
const PREVIEW_WIDTH: usize = 736
const PREVIEW_LARGEST: f64 = 32.0
// The paper the preview's stroke is on (light in both looks: the stroke
// is in the brush's own colour).
const PAPER: u32 = 0xFFF5F3EE
// A built-in tip's cell, and the copy of its picture shown in it: its
// 32 x 32 copy, from a scale of 2 on its 64 x 64 one (brush/tip.mlx keeps
// the 256, 128, 64 and 32 pixel ones in that order in one block).
const TIP_CELL: i32 = 44
const TIP_SMALL: usize = 32
const TIP_SMALL_AT: usize = 86016
const TIP_LARGE: usize = 64
const TIP_LARGE_AT: usize = 81920

// The pages: the tip, the general settings, then the options from
// types.OPTION_SIZE on (those an engine of its own reads are not
// listed).
pub const PAGE_TIP: usize = 0
pub const PAGE_GENERAL: usize = 1
pub const PAGE_OPTION: usize = 2
pub const LISTED_OPTIONS: usize = 16
pub const PAGES: usize = 18

// The parts of the dialog, for idOf().
pub const PART_NAME: usize = 0
pub const PART_ENGINE: usize = 1
pub const PART_LIST: usize = 2
pub const PART_PAGE_SCROLL: usize = 3
pub const PART_KIND_AUTO: usize = 4
pub const PART_KIND_PREDEFINED: usize = 5
pub const PART_SHAPE_CIRCLE: usize = 6
pub const PART_SHAPE_RECTANGLE: usize = 7
pub const PART_DIAMETER: usize = 8
pub const PART_RATIO: usize = 9
pub const PART_FADE_H: usize = 10
pub const PART_FADE_V: usize = 11
pub const PART_ANGLE: usize = 12
pub const PART_SPIKES: usize = 13
pub const PART_DENSITY: usize = 14
pub const PART_RANDOMNESS: usize = 15
pub const PART_SOFTNESS: usize = 16
pub const PART_ANTIALIAS: usize = 17
pub const PART_TIPS: usize = 18
pub const PART_SPACING: usize = 19
pub const PART_AUTO_SPACING: usize = 20
pub const PART_COEFFICIENT: usize = 21
pub const PART_PRECISION: usize = 22
pub const PART_OPACITY: usize = 23
pub const PART_FLOW: usize = 24
pub const PART_WASH: usize = 25
pub const PART_BUILD_UP: usize = 26
pub const PART_ERASER: usize = 27
pub const PART_AIRBRUSH: usize = 28
pub const PART_RATE: usize = 29
pub const PART_SCATTER: usize = 30
pub const PART_SCATTER_X: usize = 31
pub const PART_SCATTER_Y: usize = 32
pub const PART_COLOR: usize = 33
pub const PART_ON: usize = 34
pub const PART_STRENGTH: usize = 35
pub const PART_ADD_SENSOR: usize = 36
pub const PART_COMBINE: usize = 37
pub const PART_CURVE: usize = 38
pub const PART_LENGTH: usize = 39
pub const PART_PERIODIC: usize = 40
pub const PART_LOCK: usize = 41
pub const PART_FAN: usize = 42
pub const PART_FAN_STEP: usize = 43
pub const PART_OFFSET: usize = 44
pub const PART_RESET_CURVE: usize = 45
// Page `n`'s row in the list, option `n`'s box, sensor `n`'s kind and
// its cross.
pub const PART_PAGE: usize = 64
pub const PART_ENABLE: usize = 96
pub const PART_SENSOR: usize = 128
pub const PART_REMOVE: usize = 136

// The buttons (dialogs.PART_BUTTON + these).
pub const BUTTON_SAVE: usize = 0
pub const BUTTON_OK: usize = 1
pub const BUTTON_CANCEL: usize = 2

// The dialog's kind among those ui/dialogs.mlx hosts.
const KIND: u8 = 20

// What the dialog keeps (its body: ui/dialogs.mlx's memory, BODY_BYTES
// at most). The brush being edited, the brush the preview shows and the
// preview's pixels are blocks of their own, taken when the dialog opens
// and given back when it closes.
const Body = struct {
    edited: usize
    shown: usize
    pixels: usize
    // The width and colour the preview was drawn for (0 wide: not drawn
    // yet), and how often it was drawn.
    previewWidth: usize
    previewColor: u32
    renders: u64
    page: usize
    // The sensor an option's page shows the curve of.
    sensor: usize
    listOffset: i32
    pageOffset: i32
    pageHeight: i32
    tipOffset: i32
    // The curve of the sensor shown, as the curve editor edits it.
    curveX: [8]f32
    curveY: [8]f32
    curveCount: usize
    name: [64]u8
    nameLength: usize
    labels: [3][]const u8
    options: kit_module.SliderOptions
    // What the text colour gave over the cells under the built-in tips'
    // pictures (canvas.coverSpan).
    mixes: canvas_module.Mixes
}

fn bodyOf(app: *App, level: usize) -> *Body {
    return unsafe { @ptrCast(*Body, dialogs.body(app, level)) }
}

fn editedOf(body: *Body) -> *Settings {
    return unsafe { @ptrFromInt(*Settings, body.*.edited) }
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

// The id of `part` (PART_*) of the editor.
pub fn idOf(part: usize) -> u64 { return view.idOf(view.id("nebula.brusheditor"), part) }

// The level of the editor among the dialogs (null: it is not open).
fn openLevel(app: *App) -> ?usize { return dialogs.find(app, KIND) }

// Whether the editor is open.
pub fn isOpen(app: *App) -> bool { return openLevel(app) != null }

// The brush being edited (null: the editor is not open).
pub fn edited(app: *App) -> ?*Settings {
    var found: ?*Settings = null
    const level = openLevel(app)
    if level == null { return found }
    const body = bodyOf(app, level.?)
    if body.*.edited == 0 { return found }
    found = editedOf(body)
    return found
}

// How often the preview was drawn since the editor opened (0: it is not
// open).
pub fn previewRenders(app: *App) -> u64 {
    const level = openLevel(app)
    if level == null { return 0 }
    return bodyOf(app, level.?).*.renders
}

// The page shown (PAGE_TIP, PAGE_GENERAL, PAGE_OPTION + an option).
pub fn page(app: *App) -> usize {
    const level = openLevel(app)
    if level == null { return 0 }
    return bodyOf(app, level.?).*.page
}

fn copySettings(into: *Settings, from: *const Settings) -> void {
    // (Byte by byte: assigning a record of this size goes through the
    // value arena.)
    unsafe { std.mem.copy(@ptrCast([*]u8, into), @ptrCast([*]const u8, from), @sizeOf(Settings)) }
}

fn freeBlocks(app: *App, body: *Body) -> void {
    const allocator = app.*.allocator
    if body.*.edited != 0 { unsafe { allocator.free(@ptrFromInt([*]u8, body.*.edited), @sizeOf(Settings), 16) } }
    if body.*.shown != 0 { unsafe { allocator.free(@ptrFromInt([*]u8, body.*.shown), @sizeOf(Settings), 16) } }
    if body.*.pixels != 0 { unsafe { allocator.free(@ptrFromInt([*]u8, body.*.pixels), PREVIEW_WIDTH * PREVIEW_HEIGHT * 4, 16) } }
    body.*.edited = 0
    body.*.shown = 0
    body.*.pixels = 0
}

// Opens the editor on a copy of the brush in use. False when it is open
// already, when no more dialogs can open, or without memory (the status
// bar says so).
pub fn open(app: *App) -> bool {
    if isOpen(app) { return false }
    const hooks = dialogs.Hooks.{ .kind = KIND, .draw = drawEditor, .key = keyEditor, .finish = finish, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(Body))
    if level == null { return false }
    const body = bodyOf(app, level.?)
    const allocator = app.*.allocator
    const edited_memory = allocator.alloc(@sizeOf(Settings), 16)
    const shown_memory = allocator.alloc(@sizeOf(Settings), 16)
    const pixels_memory = allocator.alloc(PREVIEW_WIDTH * PREVIEW_HEIGHT * 4, 16)
    if edited_memory != null { body.*.edited = @intFromPtr(edited_memory.?) }
    if shown_memory != null { body.*.shown = @intFromPtr(shown_memory.?) }
    if pixels_memory != null { body.*.pixels = @intFromPtr(pixels_memory.?) }
    if edited_memory == null || shown_memory == null || pixels_memory == null {
        dialogs.close(app, level.?, dialogs.CANCEL)
        api.say(app, state.tr(app, "There is no memory for the brush editor", "Für den Pinsel-Editor ist kein Speicher da"), true)
        return false
    }
    const brush = brushes.current(app)
    copySettings(editedOf(body), brush)
    types.sanitize(editedOf(body))
    body.*.nameLength = std.text.append(&body.*.name, 0, types.NAME, types.nameOf(brush))
    body.*.previewWidth = 0
    body.*.renders = 0
    body.*.page = PAGE_TIP
    body.*.sensor = 0
    return true
}

fn finish(app: *App, level: usize, answer: usize) -> void {
    const body = bodyOf(app, level)
    if answer == BUTTON_OK && body.*.edited != 0 {
        const brush = editedOf(body)
        const bytes: [*]const u8 = &body.*.name
        if body.*.nameLength > 0 { types.setName(brush, bytes[0..body.*.nameLength]) }
        brushes.use(app, brush)
    }
    freeBlocks(app, body)
}

// Keeps the brush being edited as a preset of the painter's under the
// name at the top.
fn saveAsPreset(app: *App, body: *Body) -> void {
    const store = preset_docker.storeOf(app)
    const brush = editedOf(body)
    const bytes: [*]const u8 = &body.*.name
    if store == null || body.*.nameLength == 0 {
        api.say(app, state.tr(app, "The preset needs a name", "Die Vorlage braucht einen Namen"), true)
        return
    }
    const saved = presets.save(store.?, brush, bytes[0..body.*.nameLength])
    if saved == null {
        api.say(app, state.tr(app, "The preset could not be saved", "Die Vorlage konnte nicht gesichert werden"), true)
        return
    }
    // (A name that is a built-in preset's got a number.)
    const named = presets.name(store.?, saved.?)
    types.setName(brush, named)
    body.*.nameLength = std.text.append(&body.*.name, 0, types.NAME, named)
    api.sayWith(app, state.tr(app, "Saved as preset: ", "Als Vorlage gesichert: "), named, false)
}

fn keyEditor(app: *App, level: usize, code: u32, modifiers: u32, typed: []const u8) -> bool {
    if modifiers != 0 { return false }
    const body = bodyOf(app, level)
    if code == keys.UP || code == keys.DOWN {
        if code == keys.UP && body.*.page > 0 { setPage(body, body.*.page - 1) }
        if code == keys.DOWN && body.*.page + 1 < PAGES { setPage(body, body.*.page + 1) }
        return true
    }
    if code == keys.PAGE_UP || code == keys.PAGE_DOWN {
        const step = px(app, 200)
        body.*.pageOffset = if code == keys.PAGE_UP { body.*.pageOffset - step } else { body.*.pageOffset + step }
        if body.*.pageOffset < 0 { body.*.pageOffset = 0 }
        return true
    }
    return false
}

fn setPage(body: *Body, which: usize) -> void {
    if body.*.page == which { return }
    body.*.page = which
    body.*.sensor = 0
    body.*.pageOffset = 0
}

// ---------------------------------------------------------------------------
// Widgets as the pages use them

// Rows from the top of an area: each ROW tall with ROW_GAP under it.
const Rows = struct {
    x: i32
    y: i32
    width: i32
    row: i32
    gap: i32
    top: i32
}

fn nextRow(rows: *Rows) -> ui.Rect {
    const area = ui.rect(rows.*.x, rows.*.y, rows.*.width, rows.*.row)
    rows.*.y += rows.*.row + rows.*.gap
    return area
}

// A row of `height` (not ROW).
fn nextTall(rows: *Rows, height: i32) -> ui.Rect {
    const area = ui.rect(rows.*.x, rows.*.y, rows.*.width, height)
    rows.*.y += height + rows.*.gap
    return area
}

fn used(rows: *Rows) -> i32 { return rows.*.y - rows.*.top }

fn slider(app: *App, body: *Body, part: usize, area: ui.Rect, text: []const u8, value: *f64, low: f64, high: f64, step: f64, decimals: usize, suffix: []const u8) -> bool {
    body.*.options = kit_module.sliderOptions(low, high, step, decimals)
    body.*.options.suffix = suffix
    return kit_module.slider(api.kit(app), idOf(part), area, text, value, &body.*.options)
}

// A slider for a part (0..1) shown in per cent.
fn percent(app: *App, body: *Body, part: usize, area: ui.Rect, text: []const u8, value: *f64) -> bool {
    var shown = value.* * 100.0
    if !slider(app, body, part, area, text, &shown, 0.0, 100.0, 1.0, 0, " %") { return false }
    value.* = shown / 100.0
    return true
}

// `text` dim at the left of `area` (LABEL wide), and the rest of it.
fn labelled(app: *App, area: ui.Rect, text: []const u8) -> ui.Rect {
    var column = px(app, LABEL)
    if column > area.width / 2 { column = area.width / 2 }
    kit_module.label(api.kit(app), ui.rect(area.x, area.y, column - px(app, 8), area.height), text, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    return ui.rect(area.x + column, area.y, area.width - column, area.height)
}

// Two segments of a choice in `area`: true when the second is chosen
// after this frame (`second`: whether it is now).
fn twoSegments(app: *App, area: ui.Rect, first_part: usize, first: []const u8, second_part: usize, second_text: []const u8, second: bool) -> bool {
    const context = state.uiOf(app)
    const s = state.themeOf(app).*.scale
    controls.segmentsFrame(context, area)
    const half = (area.width - 4 * s) / 2
    var chosen = second
    if controls.segment(context, idOf(first_part), ui.rect(area.x + 2 * s, area.y + 2 * s, half, area.height - 4 * s), first, !second, 0) { chosen = false }
    if controls.segment(context, idOf(second_part), ui.rect(area.x + 2 * s + half, area.y + 2 * s, area.width - 4 * s - half, area.height - 4 * s), second_text, second, 0) { chosen = true }
    return chosen
}

fn engineName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    const engine = engines.at(index)
    if engine == null { return "" }
    return state.tr(app, engine.?.*.name, engine.?.*.german)
}

fn sensorKindName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    return types.sensorName(@intCast(u8, index), app.*.german)
}

fn combineName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    return types.combineName(@intCast(u8, index), app.*.german)
}

fn softnessName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    return types.softnessName(@intCast(u8, index), app.*.german)
}

fn colorSourceName(context: usize, index: usize) -> []const u8 {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    return types.colorSourceName(@intCast(u8, index), app.*.german)
}

// ---------------------------------------------------------------------------
// The dialog

fn drawEditor(app: *App, level: usize, window: ui.Rect) -> void {
    const body = bodyOf(app, level)
    if body.*.edited == 0 { return }
    const k = api.kit(app)
    const s = state.themeOf(app).*.scale
    var content = dialogs.frame(app, window, state.tr(app, "Brush Editor", "Pinsel-Editor"), WIDTH * s, HEIGHT * s)
    body.*.labels[0] = state.tr(app, "Save as Preset", "Als Vorlage sichern")
    body.*.labels[1] = "OK"
    body.*.labels[2] = state.tr(app, "Cancel", "Abbrechen")
    const clicked = dialogs.buttons(app, &content, body.*.labels[0..3], BUTTON_OK)
    const row = px(app, ROW)
    const gap = px(app, GAP)

    // The name and the engine.
    const top = ui.takeTop(&content, row)
    _ = ui.takeTop(&content, px(app, 8))
    const half = (top.width - gap) / 2
    const name_area = labelled(app, ui.rect(top.x, top.y, half, row), state.tr(app, "Name", "Name"))
    _ = kit_module.textBox(k, idOf(PART_NAME), name_area, &body.*.name, &body.*.nameLength, types.NAME, state.tr(app, "Name of the brush", "Name des Pinsels"))
    const engine_area = labelled(app, ui.rect(top.x + half + gap, top.y, top.width - half - gap, row), state.tr(app, "Engine", "Pinselart"))
    var engine_chosen: usize = 0
    const engine_count = engines.count()
    while engine_chosen < engine_count && engines.at(engine_chosen).?.*.id != editedOf(body).*.engine { engine_chosen += 1 }
    if kit_module.comboBoxWith(k, idOf(PART_ENGINE), engine_area, engine_count, engineName, @intFromPtr(app), &engine_chosen) && engine_chosen < engine_count {
        const chosen_id = engines.at(engine_chosen).?.*.id
        if chosen_id != editedOf(body).*.engine { useEngine(app, body, chosen_id) }
    }

    // The preview.
    const preview_area = ui.takeTop(&content, @intCast(i32, PREVIEW_HEIGHT) * s + 2 * s)
    _ = ui.takeTop(&content, px(app, 10))
    drawPreview(app, body, preview_area)

    // The pages and the page chosen.
    const list_area = ui.takeLeft(&content, px(app, LIST_WIDTH))
    _ = ui.takeLeft(&content, gap)
    drawPages(app, body, list_area)
    drawPage(app, body, content)

    if clicked != null {
        if clicked.? == BUTTON_SAVE {
            saveAsPreset(app, body)
        } else if clicked.? == BUTTON_OK {
            dialogs.close(app, level, BUTTON_OK)
        } else {
            dialogs.close(app, level, dialogs.CANCEL)
        }
    }
}

// The stroke drawn with the brush being edited, in the foreground
// colour, on paper; drawn again only when the brush, the colour or the
// room changed. (Once drawn, its pixels are kept as they are on the
// paper: a frame only copies those it painted.)
fn drawPreview(app: *App, body: *Body, area: ui.Rect) -> void {
    const theme = state.themeOf(app)
    const canvas = kit_module.canvasOf(api.kit(app))
    const s = theme.*.scale
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, PAPER)
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, s, theme.*.border)
    if canvas.*.width == 0 || canvas.*.device != 0 { return }
    var width = @intCast(usize, if area.width > 4 * s { area.width - 4 * s } else { 0 })
    if width > PREVIEW_WIDTH { width = PREVIEW_WIDTH }
    if width == 0 { return }
    const color = app.*.foreground | 0xFF000000
    const pixels: [*]u32 = unsafe { @ptrFromInt([*]u32, body.*.pixels) }
    const brush = editedOf(body)
    const shown: *Settings = unsafe { @ptrFromInt(*Settings, body.*.shown) }
    const same = body.*.previewWidth == width && body.*.previewColor == color && unsafe { std.mem.eql(@ptrCast([*]const u8, brush), @ptrCast([*]const u8, shown), @sizeOf(Settings)) }
    if !same {
        const store = preset_docker.storeOf(app)
        if store == null { return }
        if !presets.preview(store.?, brush, color, PREVIEW_LARGEST, pixels, width, PREVIEW_HEIGHT, PREVIEW_WIDTH) { return }
        onPaper(pixels, width)
        copySettings(shown, brush)
        body.*.previewWidth = width
        body.*.previewColor = color
        body.*.renders += 1
    }
    // The rows and columns of it that are on the canvas (a small window
    // puts the dialog's content partly outside).
    const top = @intCast(i64, area.y + (area.height - @intCast(i32, PREVIEW_HEIGHT)) / 2)
    const left = @intCast(i64, area.x + (area.width - @intCast(i32, width)) / 2)
    var row_end = @intCast(i64, PREVIEW_HEIGHT)
    if top + row_end > @intCast(i64, canvas.*.height) { row_end = @intCast(i64, canvas.*.height) - top }
    var column_end = @intCast(i64, width)
    if left + column_end > @intCast(i64, canvas.*.width) { column_end = @intCast(i64, canvas.*.width) - left }
    const column_start = if left < 0 { 0 - left } else { 0 }
    if column_end <= column_start { return }
    const skip = @intCast(usize, column_start)
    const count = @intCast(usize, column_end - column_start)
    const canvas_x = @intCast(usize, left + column_start)
    const swap = canvas.*.swapRedBlue
    var row = if top < 0 { 0 - top } else { 0 }
    while row < row_end {
        const from = pixels + @intCast(usize, row) * PREVIEW_WIDTH + skip
        const into = canvas.*.pixels + @intCast(usize, top + row) * canvas.*.stride + canvas_x
        var column: usize = 0
        while column < count {
            const value = from[column]
            if value != 0 { into[column] = if swap { redBlueSwapped(value) } else { value } }
            column += 1
        }
        row += 1
    }
}

// The preview's straight pixels (`width` of each of its rows) as they
// are on the paper, premultiplied and opaque: what canvas.blend makes of
// each over PAPER; 0 where nothing was painted.
fn onPaper(pixels: [*]u32, width: usize) -> void {
    var row: usize = 0
    while row < PREVIEW_HEIGHT {
        var column: usize = 0
        while column < width {
            const at = row * PREVIEW_WIDTH + column
            const value = pixels[at]
            pixels[at] = if value >> 24 == 0 { 0 } else { canvas_module.over(PAPER, pixel.premultiplied(value), 255) }
            column += 1
        }
        row += 1
    }
}

// A colour as a canvas that keeps red first stores it.
fn redBlueSwapped(color: u32) -> u32 {
    return (color & 0xFF00FF00) | ((color >> 16) & 0xFF) | ((color & 0xFF) << 16)
}

// The brush being edited paints with engine `id` from now on, with the
// numbers and the text an engine keeps for itself (Settings.values,
// text) as the brush in use has them when it is of that engine, else as
// the first preset of the engine has them, else none (zeros).
fn useEngine(app: *App, body: *Body, id: u16) -> void {
    const brush = editedOf(body)
    brush.*.engine = id
    var from: ?*const Settings = null
    const in_use: *const Settings = brushes.current(app)
    if in_use.*.engine == id { from = in_use }
    const store = preset_docker.storeOf(app)
    var index: usize = 0
    while from == null && store != null && index < presets.count(store.?) {
        const preset = presets.settingsOf(store.?, index)
        if preset != null && preset.?.*.engine == id { from = preset }
        index += 1
    }
    var at: usize = 0
    while at < types.VALUES {
        brush.*.values[at] = if from == null { 0.0 } else { from.?.*.values[at] }
        at += 1
    }
    if from == null {
        brush.*.textLength = 0
    } else {
        types.setText(brush, types.textOf(from.?))
    }
}

// The list of pages: the tip, the general settings, an option a row (its
// box turns it on).
fn drawPages(app: *App, body: *Body, area: ui.Rect) -> void {
    const k = api.kit(app)
    const theme = state.themeOf(app)
    const s = theme.*.scale
    const row = px(app, ROW)
    canvas_module.fillRoundedRect(kit_module.canvasOf(k), area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.field)
    const inner = ui.rect(area.x + 2 * s, area.y + 2 * s, area.width - 4 * s, area.height - 4 * s)
    const content = kit_module.scrollBegin(k, idOf(PART_LIST), inner, @intCast(i32, PAGES) * row + px(app, 9), &body.*.listOffset)
    const brush = editedOf(body)
    var which: usize = 0
    while which < PAGES {
        // (A line between the general pages and the options.)
        const y = content.y + @intCast(i32, which) * row + (if which >= PAGE_OPTION { px(app, 9) } else { 0 })
        const place = ui.rect(content.x, y, content.width, row)
        if place.y >= ui.bottom(inner) { break }
        if ui.bottom(place) > inner.y {
            if which == PAGE_OPTION { kit_module.separator(k, ui.rect(content.x + px(app, 6), y - px(app, 9), content.width - px(app, 12), px(app, 9))) }
            if kit_module.listRow(k, idOf(PART_PAGE + which), place, body.*.page == which, false) != kit_module.ROW_NONE { setPage(body, which) }
            if which < PAGE_OPTION {
                const icon = px(app, 16)
                icons.draw(kit_module.canvasOf(k), if which == PAGE_TIP { icons.BRUSH_SETTINGS } else { icons.SETTINGS }, place.x + px(app, 6), place.y + (row - icon) / 2, icon, theme.*.dim)
                kit_module.label(k, ui.rect(place.x + px(app, 28), place.y, place.width - px(app, 32), row), if which == PAGE_TIP { state.tr(app, "Brush Tip", "Pinselspitze") } else { state.tr(app, "General", "Allgemein") }, kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
            } else {
                const option = which - PAGE_OPTION
                const record = &brush.*.options[option]
                if controls.checkBox(state.uiOf(app), idOf(PART_ENABLE + option), place.x + px(app, 6), place.y + (row - 14 * s) / 2, if record.*.on { controls.CHECK_ON } else { controls.CHECK_OFF }, theme.*.accent) { record.*.on = !record.*.on }
                kit_module.label(k, ui.rect(place.x + px(app, 28), place.y, place.width - px(app, 32), row), types.optionName(option, app.*.german), if record.*.on { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_LEFT)
            }
        }
        which += 1
    }
    kit_module.scrollEnd(k)
}

// The page chosen, scrolled when it is taller than its room.
fn drawPage(app: *App, body: *Body, area: ui.Rect) -> void {
    const k = api.kit(app)
    if area.width <= 0 || area.height <= 0 { return }
    const content = kit_module.scrollBegin(k, idOf(PART_PAGE_SCROLL), area, body.*.pageHeight, &body.*.pageOffset)
    var rows = Rows.{ .x = content.x, .y = content.y, .width = content.width, .row = px(app, ROW), .gap = px(app, ROW_GAP), .top = content.y }
    if body.*.page == PAGE_TIP {
        tipPage(app, body, &rows)
    } else if body.*.page == PAGE_GENERAL {
        generalPage(app, body, &rows)
    } else {
        optionPage(app, body, &rows, body.*.page - PAGE_OPTION)
    }
    kit_module.scrollEnd(k)
    const height = used(&rows)
    if height != body.*.pageHeight {
        body.*.pageHeight = height
        state.uiOf(app).*.changed = true
    }
}

// ---------------------------------------------------------------------------
// The pages

fn tipPage(app: *App, body: *Body, rows: *Rows) -> void {
    const k = api.kit(app)
    const brush = editedOf(body)
    const tip = &brush.*.tip
    const gap = px(app, GAP)
    const line = nextRow(rows)
    const half = (line.width - gap) / 2
    const predefined = twoSegments(app, ui.rect(line.x, line.y, half, line.height), PART_KIND_AUTO, state.tr(app, "Auto", "Automatisch"), PART_KIND_PREDEFINED, state.tr(app, "Predefined", "Vorgegeben"), tip.*.kind == types.TIP_PREDEFINED)
    tip.*.kind = if predefined { types.TIP_PREDEFINED } else { types.TIP_AUTO }
    if !predefined {
        const rectangle = twoSegments(app, ui.rect(line.x + half + gap, line.y, line.width - half - gap, line.height), PART_SHAPE_CIRCLE, state.tr(app, "Circle", "Kreis"), PART_SHAPE_RECTANGLE, state.tr(app, "Rectangle", "Rechteck"), tip.*.shape == types.SHAPE_RECTANGLE)
        tip.*.shape = if rectangle { types.SHAPE_RECTANGLE } else { types.SHAPE_CIRCLE }
    } else {
        // The built-in tips, and the name of the one chosen.
        const cells_across = if line.width > px(app, 8) { (line.width - px(app, 8)) / px(app, TIP_CELL) } else { 1 }
        const across = if cells_across < 1 { 1 } else { cells_across }
        const count = tip_module.predefinedCount()
        const lines = (@intCast(i32, count) + across - 1) / across
        const grid_area = nextTall(rows, lines * px(app, TIP_CELL))
        const chosen = kit_module.grid(k, idOf(PART_TIPS), grid_area, px(app, TIP_CELL), px(app, TIP_CELL), count, @intCast(usize, tip.*.predefined), &body.*.tipOffset, drawTipCell, @intFromPtr(app))
        if chosen != null { tip.*.predefined = @intCast(u16, chosen.?) }
        kit_module.label(k, nextRow(rows), tip_module.predefinedName(@intCast(usize, tip.*.predefined), app.*.german), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    }
    var size = brush.*.size
    body.*.options = kit_module.sliderOptions(types.SMALLEST_SIZE, types.LARGEST_SIZE, 1.0, 2)
    body.*.options.exponent = 3.0
    body.*.options.softLow = types.SMALLEST_SIZE
    body.*.options.softHigh = 1000.0
    body.*.options.suffix = " px"
    if kit_module.slider(k, idOf(PART_DIAMETER), nextRow(rows), state.tr(app, "Diameter", "Durchmesser"), &size, &body.*.options) { brush.*.size = size }
    _ = slider(app, body, PART_RATIO, nextRow(rows), state.tr(app, "Ratio", "Seitenverhältnis"), &tip.*.ratio, 0.01, 1.0, 0.01, 2, "")
    var angle = tip.*.angle
    while angle > 180.0 { angle -= 360.0 }
    while angle < -180.0 { angle += 360.0 }
    if slider(app, body, PART_ANGLE, nextRow(rows), state.tr(app, "Angle", "Winkel"), &angle, -180.0, 180.0, 1.0, 0, "\u{00B0}") { tip.*.angle = angle }
    if !predefined {
        _ = percent(app, body, PART_FADE_H, nextRow(rows), state.tr(app, "Hardness along", "Härte längs"), &tip.*.horizontalFade)
        _ = percent(app, body, PART_FADE_V, nextRow(rows), state.tr(app, "Hardness across", "Härte quer"), &tip.*.verticalFade)
        var spikes = @floatFromInt(f64, tip.*.spikes)
        if slider(app, body, PART_SPIKES, nextRow(rows), state.tr(app, "Spikes", "Zacken"), &spikes, 2.0, 12.0, 1.0, 0, "") { tip.*.spikes = @intFromFloat(u8, spikes + 0.5) }
        _ = percent(app, body, PART_DENSITY, nextRow(rows), state.tr(app, "Density", "Dichte"), &tip.*.density)
        _ = percent(app, body, PART_RANDOMNESS, nextRow(rows), state.tr(app, "Randomness", "Zufall"), &tip.*.randomness)
        const model_line = nextRow(rows)
        const model_area = labelled(app, ui.rect(model_line.x, model_line.y, model_line.width - px(app, 140), model_line.height), state.tr(app, "Edge", "Kante"))
        var model = @intCast(usize, tip.*.softness)
        if kit_module.comboBoxWith(k, idOf(PART_SOFTNESS), model_area, 3, softnessName, @intFromPtr(app), &model) { tip.*.softness = @intCast(u8, model) }
        _ = kit_module.checkBox(k, idOf(PART_ANTIALIAS), ui.rect(ui.right(model_area) + gap, model_line.y, model_line.width - (ui.right(model_area) + gap - model_line.x), model_line.height), state.tr(app, "Anti-aliased", "Geglättet"), &tip.*.antialias)
    }
    // How far apart the dabs are.
    rows.*.y += px(app, 6)
    var spacing = tip.*.spacing * 100.0
    body.*.options = kit_module.sliderOptions(1.0, 1000.0, 1.0, 0)
    body.*.options.exponent = 2.0
    body.*.options.softLow = 1.0
    body.*.options.softHigh = 200.0
    body.*.options.suffix = " %"
    body.*.options.disabled = tip.*.autoSpacing
    if kit_module.slider(k, idOf(PART_SPACING), nextRow(rows), state.tr(app, "Spacing", "Abstand"), &spacing, &body.*.options) { tip.*.spacing = spacing / 100.0 }
    const auto_line = nextRow(rows)
    const auto_width = auto_line.width / 3
    _ = kit_module.checkBox(k, idOf(PART_AUTO_SPACING), ui.rect(auto_line.x, auto_line.y, auto_width, auto_line.height), state.tr(app, "Auto spacing", "Auto-Abstand"), &tip.*.autoSpacing)
    if tip.*.autoSpacing {
        _ = slider(app, body, PART_COEFFICIENT, ui.rect(auto_line.x + auto_width + gap, auto_line.y, auto_line.width - auto_width - gap, auto_line.height), state.tr(app, "Coefficient", "Faktor"), &tip.*.autoSpacingCoefficient, 0.1, 10.0, 0.1, 1, "")
    }
    var precision = @floatFromInt(f64, tip.*.precision)
    if slider(app, body, PART_PRECISION, nextRow(rows), state.tr(app, "Precision", "Genauigkeit"), &precision, 1.0, 5.0, 1.0, 0, "") { tip.*.precision = @intFromFloat(u8, precision + 0.5) }
}

// A built-in tip in its cell: its picture's 32 x 32 copy (64 x 64 from a
// scale of 2 on), in the text colour on the field's, row by row through
// canvas.coverSpan (what blend gives pixel by pixel).
fn drawTipCell(context: usize, index: usize, canvas: *state.Canvas, cell: ui.Rect, lit: bool) -> void {
    const app: *App = unsafe { @ptrFromInt(*App, context) }
    const theme = state.themeOf(app)
    const s = theme.*.scale
    canvas_module.fillRoundedRect(canvas, cell.x + 2 * s, cell.y + 2 * s, cell.width - 4 * s, cell.height - 4 * s, theme.*.smallRadius, if lit { theme.*.hover } else { theme.*.field })
    const picture = tip_module.predefinedPicture(index)
    const level = openLevel(app)
    if picture == null || level == null || canvas.*.width == 0 || canvas.*.device != 0 { return }
    const body = bodyOf(app, level.?)
    const side = if s >= 2 { TIP_LARGE } else { TIP_SMALL }
    const start = if s >= 2 { TIP_LARGE_AT } else { TIP_SMALL_AT }
    const x0 = cell.x + (cell.width - @intCast(i32, side)) / 2
    const y0 = cell.y + (cell.height - @intCast(i32, side)) / 2
    const area = ui.intersect(ui.rect(x0, y0, @intCast(i32, side), @intCast(i32, side)), ui.rect(0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height)))
    if ui.isEmpty(area) { return }
    canvas_module.beginMixes(&body.*.mixes)
    var py = area.y
    while py < ui.bottom(area) {
        const from = picture.? + start + @intCast(usize, py - y0) * side + @intCast(usize, area.x - x0)
        canvas_module.coverSpan(canvas, @intCast(usize, py) * canvas.*.stride + @intCast(usize, area.x), from, @intCast(usize, area.width), theme.*.text, &body.*.mixes)
        py += 1
    }
}

fn generalPage(app: *App, body: *Body, rows: *Rows) -> void {
    const k = api.kit(app)
    const brush = editedOf(body)
    const gap = px(app, GAP)
    _ = percent(app, body, PART_OPACITY, nextRow(rows), state.tr(app, "Opacity", "Deckkraft"), &brush.*.opacity)
    _ = percent(app, body, PART_FLOW, nextRow(rows), state.tr(app, "Flow", "Fluss"), &brush.*.flow)
    const mode_line = nextRow(rows)
    const mode_area = labelled(app, mode_line, state.tr(app, "Painting", "Malweise"))
    const build_up = twoSegments(app, mode_area, PART_WASH, state.tr(app, "Wash", "Lasierend"), PART_BUILD_UP, state.tr(app, "Build-up", "Aufbauend"), brush.*.paintMode == types.MODE_BUILD_UP)
    brush.*.paintMode = if build_up { types.MODE_BUILD_UP } else { types.MODE_WASH }
    _ = kit_module.checkBox(k, idOf(PART_ERASER), nextRow(rows), state.tr(app, "Erases", "Radiert"), &brush.*.eraser)
    rows.*.y += px(app, 6)
    const air_line = nextRow(rows)
    const air_width = air_line.width / 3
    _ = kit_module.checkBox(k, idOf(PART_AIRBRUSH), ui.rect(air_line.x, air_line.y, air_width, air_line.height), state.tr(app, "Airbrush", "Airbrush"), &brush.*.airbrush)
    body.*.options = kit_module.sliderOptions(1.0, 1000.0, 1.0, 0)
    body.*.options.exponent = 2.0
    body.*.options.suffix = state.tr(app, " per second", " je Sekunde")
    body.*.options.disabled = !brush.*.airbrush
    _ = kit_module.slider(k, idOf(PART_RATE), ui.rect(air_line.x + air_width + gap, air_line.y, air_line.width - air_width - gap, air_line.height), state.tr(app, "Rate", "Rate"), &brush.*.airbrushRate, &body.*.options)
    rows.*.y += px(app, 6)
    _ = slider(app, body, PART_SCATTER, nextRow(rows), state.tr(app, "Scatter (diameters)", "Streuung (Durchmesser)"), &brush.*.scatterAmount, 0.0, 10.0, 0.1, 1, "")
    const axes = nextRow(rows)
    const axis_width = (axes.width - gap) / 2
    _ = kit_module.checkBox(k, idOf(PART_SCATTER_X), ui.rect(axes.x, axes.y, axis_width, axes.height), state.tr(app, "Along the stroke", "Längs des Strichs"), &brush.*.scatterX)
    _ = kit_module.checkBox(k, idOf(PART_SCATTER_Y), ui.rect(axes.x + axis_width + gap, axes.y, axes.width - axis_width - gap, axes.height), state.tr(app, "Across the stroke", "Quer zum Strich"), &brush.*.scatterY)
    rows.*.y += px(app, 6)
    const color_area = labelled(app, nextRow(rows), state.tr(app, "Colour", "Farbe"))
    var source = @intCast(usize, brush.*.colorSource)
    if kit_module.comboBoxWith(k, idOf(PART_COLOR), color_area, types.COLOR_SOURCES, colorSourceName, @intFromPtr(app), &source) { brush.*.colorSource = @intCast(u8, source) }
}

// What a sensor's length counts.
fn lengthSuffix(app: *App, kind: u8) -> []const u8 {
    if kind == types.SENSOR_TIME { return " ms" }
    if kind == types.SENSOR_FADE { return state.tr(app, " dabs", " Tupfer") }
    return " px"
}

// The first sensor kind the option does not listen to yet (pressure
// when it listens to all).
fn unusedKind(option: *const types.Option) -> u8 {
    var kind: usize = 0
    while kind < types.SENSOR_KINDS {
        var taken = false
        var slot: usize = 0
        while slot < @intCast(usize, option.*.count) {
            if @intCast(usize, option.*.sensors[slot].kind) == kind { taken = true }
            slot += 1
        }
        if !taken { return @intCast(u8, kind) }
        kind += 1
    }
    return types.SENSOR_PRESSURE
}

fn optionPage(app: *App, body: *Body, rows: *Rows, which: usize) -> void {
    const k = api.kit(app)
    const brush = editedOf(body)
    const option = &brush.*.options[which]
    const gap = px(app, GAP)
    const row = px(app, ROW)
    // On, and how strongly.
    const head = nextRow(rows)
    const on_width = head.width / 3
    _ = kit_module.checkBox(k, idOf(PART_ON), ui.rect(head.x, head.y, on_width, head.height), state.tr(app, "On", "Eingeschaltet"), &option.*.on)
    _ = percent(app, body, PART_STRENGTH, ui.rect(head.x + on_width + gap, head.y, head.width - on_width - gap, head.height), state.tr(app, "Strength", "Stärke"), &option.*.strength)
    rows.*.y += px(app, 4)
    // Two columns: the sensors and what they take at the left, the curve
    // of the one chosen at the right.
    var curve_side = rows.*.width * 9 / 20
    if curve_side > px(app, 250) { curve_side = px(app, 250) }
    const left_width = rows.*.width - curve_side - gap
    var left = Rows.{ .x = rows.*.x, .y = rows.*.y, .width = left_width, .row = row, .gap = rows.*.gap, .top = rows.*.y }
    kit_module.label(k, nextRow(&left), state.tr(app, "Sensors", "Sensoren"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    var count = @intCast(usize, option.*.count)
    if count > types.SENSORS { count = types.SENSORS }
    if body.*.sensor >= count { body.*.sensor = if count > 0 { count - 1 } else { 0 } }
    var removed: usize = types.SENSORS
    var slot: usize = 0
    while slot < count {
        const line = nextRow(&left)
        const kind_id = idOf(PART_SENSOR + slot)
        // Of two or more, the row of the sensor whose curve is shown is
        // marked (lit, a bar at its left); a press on its list or beside
        // it shows it.
        const marked = slot == body.*.sensor && count > 1
        if kit_module.listRow(k, view.idOf(kind_id, 1), line, false, marked) != kit_module.ROW_NONE { body.*.sensor = slot }
        if marked { canvas_module.fillRoundedRect(kit_module.canvasOf(k), line.x, line.y + px(app, 4), px(app, 3), line.height - px(app, 8), px(app, 1), state.themeOf(app).*.accent) }
        if state.uiOf(app).*.pressed == kind_id { body.*.sensor = slot }
        var kind = @intCast(usize, option.*.sensors[slot].kind)
        const box = ui.rect(line.x + px(app, 8), line.y, line.width - row - px(app, 12), line.height)
        if kit_module.comboBoxWith(k, kind_id, box, types.SENSOR_KINDS, sensorKindName, @intFromPtr(app), &kind) {
            option.*.sensors[slot].kind = @intCast(u8, kind)
            body.*.sensor = slot
        }
        if kit_module.iconButton(k, idOf(PART_REMOVE + slot), ui.rect(ui.right(line) - row, line.y, row, row), icons.drawFor, @intCast(usize, icons.CLOSE), state.tr(app, "Remove the sensor", "Sensor entfernen")) { removed = slot }
        slot += 1
    }
    if count == 0 {
        kit_module.label(k, nextRow(&left), state.tr(app, "None: the strength for every dab", "Keiner: die Stärke für jeden Tupfer"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    }
    if count < types.SENSORS {
        const add_line = nextRow(&left)
        if kit_module.button(k, idOf(PART_ADD_SENSOR), ui.rect(add_line.x, add_line.y, if add_line.width < px(app, 140) { add_line.width } else { px(app, 140) }, add_line.height), state.tr(app, "Add Sensor", "Sensor hinzufügen"), kit_module.BUTTON_NORMAL) {
            types.defaultSensor(&option.*.sensors[count], unusedKind(option))
            option.*.count = @intCast(u8, count + 1)
            body.*.sensor = count
        }
    }
    if removed < count {
        var at = removed
        while at + 1 < count {
            option.*.sensors[at] = option.*.sensors[at + 1]
            at += 1
        }
        types.defaultSensor(&option.*.sensors[count - 1], types.SENSOR_PRESSURE)
        option.*.count = @intCast(u8, count - 1)
        count -= 1
        if body.*.sensor >= count && count > 0 { body.*.sensor = count - 1 }
    }
    if count > 1 {
        left.y += px(app, 4)
        const combine_area = labelled(app, nextRow(&left), state.tr(app, "Combined by", "Verknüpft durch"))
        var mode = @intCast(usize, option.*.combine)
        if kit_module.comboBoxWith(k, idOf(PART_COMBINE), combine_area, types.COMBINE_MODES, combineName, @intFromPtr(app), &mode) { option.*.combine = @intCast(u8, mode) }
    }
    var curve_bottom = rows.*.y
    if count > 0 {
        const sensor = &option.*.sensors[body.*.sensor]
        // What the sensor chosen takes.
        left.y += px(app, 4)
        if sensor.*.kind == types.SENSOR_DISTANCE || sensor.*.kind == types.SENSOR_TIME || sensor.*.kind == types.SENSOR_FADE {
            body.*.options = kit_module.sliderOptions(1.0, 1000000.0, 1.0, 0)
            body.*.options.exponent = 3.0
            body.*.options.softLow = 1.0
            body.*.options.softHigh = 5000.0
            body.*.options.suffix = lengthSuffix(app, sensor.*.kind)
            _ = kit_module.slider(k, idOf(PART_LENGTH), nextRow(&left), state.tr(app, "Length", "Länge"), &sensor.*.length, &body.*.options)
            _ = kit_module.checkBox(k, idOf(PART_PERIODIC), nextRow(&left), state.tr(app, "Starts again", "Beginnt von vorn"), &sensor.*.periodic)
        } else if sensor.*.kind == types.SENSOR_DRAWING_ANGLE {
            _ = kit_module.checkBox(k, idOf(PART_LOCK), nextRow(&left), state.tr(app, "Keep the first direction", "Erste Richtung halten"), &sensor.*.lockAngle)
            _ = kit_module.checkBox(k, idOf(PART_FAN), nextRow(&left), state.tr(app, "Fan out at corners", "An Ecken auffächern"), &sensor.*.fanCorners)
            if sensor.*.fanCorners {
                _ = slider(app, body, PART_FAN_STEP, nextRow(&left), state.tr(app, "Fan step", "Fächerschritt"), &sensor.*.fanStep, 1.0, 180.0, 1.0, 0, "\u{00B0}")
            }
            _ = slider(app, body, PART_OFFSET, nextRow(&left), state.tr(app, "Offset", "Versatz"), &sensor.*.angleOffset, -360.0, 360.0, 1.0, 0, "\u{00B0}")
        }
        // The curve: what the sensor gives (across) becomes what the
        // option takes (up).
        const curve_area = ui.rect(rows.*.x + left_width + gap, rows.*.y, curve_side, curve_side)
        loadCurve(body, &sensor.*.curve)
        if kit_module.curveEditor(k, idOf(PART_CURVE), curve_area, &body.*.curveX, &body.*.curveY, &body.*.curveCount, curve_module.POINTS) { storeCurve(body, &sensor.*.curve) }
        const caption = ui.rect(curve_area.x, ui.bottom(curve_area) + px(app, 4), curve_side - row - px(app, 4), row)
        kit_module.label(k, caption, types.sensorName(sensor.*.kind, app.*.german), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        if kit_module.iconButton(k, idOf(PART_RESET_CURVE), ui.rect(ui.right(curve_area) - row, caption.y, row, row), icons.drawFor, @intCast(usize, icons.REFRESH), state.tr(app, "A straight curve again", "Wieder eine gerade Kurve")) {
            sensor.*.curve = curve_module.identity()
        }
        curve_bottom = ui.bottom(caption) + rows.*.gap
    }
    rows.*.y = if left.y > curve_bottom { left.y } else { curve_bottom }
}

// The curve's points as the curve editor takes them.
fn loadCurve(body: *Body, curve: *const curve_module.Curve) -> void {
    var count = @intCast(usize, curve.*.count)
    if count > curve_module.POINTS { count = curve_module.POINTS }
    var index: usize = 0
    while index < count {
        body.*.curveX[index] = @floatCast(f32, curve.*.x[index])
        body.*.curveY[index] = @floatCast(f32, curve.*.y[index])
        index += 1
    }
    body.*.curveCount = count
}

// What the curve editor changed, back into the brush's curve.
fn storeCurve(body: *Body, curve: *curve_module.Curve) -> void {
    var count = body.*.curveCount
    if count > curve_module.POINTS { count = curve_module.POINTS }
    var index: usize = 0
    while index < count {
        curve.*.x[index] = @floatCast(f64, body.*.curveX[index])
        curve.*.y[index] = @floatCast(f64, body.*.curveY[index])
        index += 1
    }
    curve.*.count = @intCast(u8, count)
    curve_module.normalize(curve)
}
