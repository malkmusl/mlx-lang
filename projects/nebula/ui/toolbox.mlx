// nebula ui: the toolbox: the column at the window's left with a button
// for every tool of tools/registry.mlx, in the table's order, a little
// space between the groups (state.GROUP_*); the tool in use lit; under
// the tools the two colours. A click on a button makes its tool the one
// in use, the pointer resting on it says its name and shortcut.
//
//     chrome.layOut: const wide = toolbox.widthFor(app, height)
//                    toolbox.place(app, column)
//     chrome.draw:   toolbox.draw(app)
//
// Two columns of buttons; three when the window is too short for two;
// when even three do not fit the column scrolls (its bar can be dragged:
// brixOS has no wheel).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const shortcuts = @import("../app/shortcuts.mlx")
const kit_module = @import("./kit.mlx")
const icons = @import("./icons.mlx")
const tools = @import("../tools/registry.mlx")
const actions = @import("../actions/registry.mlx")

pub const App = state.App

// A button's side, the room between buttons, between groups, around them.
pub const BUTTON: i32 = 28
const GAP: i32 = 2
const GROUP_GAP: i32 = 8
const PADDING: i32 = 4
// The kit's scroll bar's width (ui/kit.mlx's SCROLL_BAR).
const SCROLL_BAR: i32 = 8

// What the toolbox keeps: where it is this frame, in how many columns,
// how far it is scrolled, the tooltip of the button the pointer is on.
const Box = struct {
    area: ui.Rect
    columns: i32
    offset: i32
    tip: [96]u8
    tipLength: usize
}

fn boxOf(app: *App) -> ?*Box {
    const memory = state.slot(app, state.SLOT_TOOLBOX, @sizeOf(Box))
    if memory == null { return null }
    return unsafe { @ptrCast(*Box, memory.?) }
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

// The height the buttons and the colours take in `columns` columns.
fn contentHeight(app: *App, columns: i32) -> i32 {
    const count = tools.count()
    var height = px(app, PADDING)
    var in_row: i32 = 0
    var group: u8 = 255
    var index: usize = 0
    while index < count {
        const tool = tools.at(index)
        if tool != null {
            if index > 0 && tool.?.*.group != group {
                // A new group starts a row of its own, a little apart.
                if in_row > 0 { height += px(app, BUTTON + GAP) }
                height += px(app, GROUP_GAP)
                in_row = 0
            }
            group = tool.?.*.group
            in_row += 1
            if in_row == columns {
                height += px(app, BUTTON + GAP)
                in_row = 0
            }
        }
        index += 1
    }
    if in_row > 0 { height += px(app, BUTTON + GAP) }
    return height + px(app, GROUP_GAP) + pairSide(app, columns) + px(app, PADDING)
}

fn columnWidth(app: *App, columns: i32) -> i32 {
    return px(app, PADDING * 2 + BUTTON * columns + GAP * (columns - 1))
}

// The colours' square under the tools.
fn pairSide(app: *App, columns: i32) -> i32 {
    const side = px(app, BUTTON * 2 + GAP)
    return if columns > 2 { side + px(app, 8) } else { side }
}

// How wide the column is in a middle band `height` tall: two columns of
// buttons, three when two do not fit, with room for the scroll bar when
// three do not either; and the line at its right.
pub fn widthFor(app: *App, height: i32) -> i32 {
    const columns = columnsFor(app, height)
    const bar = if contentHeight(app, columns) > height { px(app, SCROLL_BAR) } else { 0 }
    return columnWidth(app, columns) + bar + px(app, 1)
}

fn columnsFor(app: *App, height: i32) -> i32 {
    return if contentHeight(app, 2) <= height { 2 } else { 3 }
}

// The column is at `area` this frame (empty: not shown).
pub fn place(app: *App, area: ui.Rect) -> void {
    const box = boxOf(app)
    if box == null { return }
    box.?.*.area = area
    box.?.*.columns = columnsFor(app, area.height)
}

// Where the column is this frame.
pub fn area(app: *App) -> ui.Rect {
    const box = boxOf(app)
    if box == null { return ui.rect(0, 0, 0, 0) }
    return box.?.*.area
}

fn buttonId(index: usize) -> u64 { return view.idOf(view.id("nebula.toolbox.tool"), index) }

// The tooltip of the button under the pointer: "Name (Shortcut)", kept in
// the box until the kit draws it.
fn tipOf(app: *App, box: *Box, tool: *const state.Tool) -> []const u8 {
    const bytes: [*]u8 = &box.*.tip
    var length = std.text.append(bytes, 0, 96, state.tr(app, tool.*.name, tool.*.german))
    var shortcut: [32]u8 = undefined
    const written = keys.format(shortcuts.ofTool(app, tool), &shortcut)
    if written > 0 {
        const text: [*]const u8 = &shortcut
        length = std.text.append(bytes, length, 96, " (")
        length = std.text.append(bytes, length, 96, text[0..written])
        length = std.text.append(bytes, length, 96, ")")
    }
    box.*.tipLength = length
    return bytes[0..length]
}

// The place of tool `index`'s button (of the registry's order) in a column
// whose content starts at `top`, and the height the content takes.
fn buttonAt(app: *App, box: *Box, content: ui.Rect, wanted: usize) -> ui.Rect {
    const count = tools.count()
    const columns = box.*.columns
    var y = content.y + px(app, PADDING)
    var column: i32 = 0
    var group: u8 = 255
    var index: usize = 0
    while index < count {
        const tool = tools.at(index)
        if tool != null {
            if index > 0 && tool.?.*.group != group {
                if column > 0 { y += px(app, BUTTON + GAP) }
                y += px(app, GROUP_GAP)
                column = 0
            }
            group = tool.?.*.group
            if index == wanted {
                return ui.rect(content.x + px(app, PADDING) + column * px(app, BUTTON + GAP), y, px(app, BUTTON), px(app, BUTTON))
            }
            column += 1
            if column == columns {
                y += px(app, BUTTON + GAP)
                column = 0
            }
        }
        index += 1
    }
    // Where the colours go: under the last row.
    if column > 0 { y += px(app, BUTTON + GAP) }
    return ui.rect(content.x + px(app, PADDING), y + px(app, GROUP_GAP), 0, 0)
}

// The button of tool `index` (of the registry's order) this frame.
pub fn buttonArea(app: *App, index: usize) -> ui.Rect {
    const box = boxOf(app)
    if box == null || ui.isEmpty(box.?.*.area) || index >= tools.count() { return ui.rect(0, 0, 0, 0) }
    return buttonAt(app, box.?, ui.rect(box.?.*.area.x, box.?.*.area.y - box.?.*.offset, box.?.*.area.width, box.?.*.area.height), index)
}

fn colorAction(app: *App, key: []const u8) -> void {
    if actions.byKey(key) != null { _ = api.run(app, key) }
}

// Draws the column where place() put it.
pub fn draw(app: *App) -> void {
    const box = boxOf(app)
    if box == null || ui.isEmpty(box.?.*.area) { return }
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const where = box.?.*.area
    const s = app.*.scale
    canvas_module.fillRect(widgets.*.canvas, where.x, where.y, where.width, where.height, theme.*.panel)
    canvas_module.fillRect(widgets.*.canvas, ui.right(where) - s, where.y, s, where.height, theme.*.divider)
    const inner = ui.rect(where.x, where.y, where.width - s, where.height)
    const content = kit_module.scrollBegin(k, view.id("nebula.toolbox"), inner, contentHeight(app, box.?.*.columns), &box.?.*.offset)
    const count = tools.count()
    var index: usize = 0
    while index < count {
        const tool = tools.at(index)
        if tool != null {
            const button = buttonAt(app, box.?, content, index)
            // (Buttons out of sight name no region: the column may scroll.)
            if ui.bottom(button) > inner.y && button.y < ui.bottom(inner) {
                const id = buttonId(index)
                const tip = if view.isHover(widgets, id) { tipOf(app, box.?, tool.?) } else { "" }
                if kit_module.toolButton(k, id, button, icons.drawFor, @intCast(usize, tool.?.*.icon), tool.?.*.id == app.*.tool, tip) {
                    api.setTool(app, tool.?.*.id)
                }
            }
        }
        index += 1
    }
    const under = buttonAt(app, box.?, content, count)
    const side = pairSide(app, box.?.*.columns)
    const pair = ui.rect(content.x + (content.width - side) / 2, under.y, side, side)
    const what = kit_module.colorPair(k, view.id("nebula.toolbox.colors"), pair, app.*.foreground, app.*.background)
    if what == kit_module.PAIR_SWAP {
        api.swapColors(app)
    } else if what == kit_module.PAIR_RESET {
        api.resetColors(app)
    } else if what == kit_module.PAIR_FOREGROUND {
        colorAction(app, "color_foreground")
    } else if what == kit_module.PAIR_BACKGROUND {
        colorAction(app, "color_background")
    }
    kit_module.scrollEnd(k)
}
