// nebula ui: the colours of sRGB as a body in space, to turn and to
// choose a colour on: the sRGB cube as colours are stored (R' across, G'
// into the picture, B' up), the same cube in linear light, or sRGB's body
// in OKLab (L up, a across, b into the picture), and any way between two
// of them (a morph: every colour moves from its place in one to its place
// in the other). A cut at an OKLab lightness takes away what is lighter:
// the cut face shows the colours inside the body at that lightness, where
// one chooses the colours the outside does not reach.
//
//     var solid: colorsolid.Solid = undefined
//     colorsolid.init(&solid, allocator)
//     solid.to = colorsolid.OKLAB
//     solid.cut = 0.6
//     _ = colorsolid.render(&solid, 300, 300)        // into its own pixels
//     var chosen: u32 = 0
//     if colorsolid.pick(&solid, x, y, &chosen) { ... }
//
// It is drawn forwards: points on the cube's six faces (and on the cut
// face) are put where the space and the view place them, the nearest one
// of each pixel kept (a depth buffer), each a little larger than the
// space between them so no gap shows. A pixel shows a colour exactly as
// it is: what is picked is what is seen. Pixels are straight 0xAARRGGBB
// (alpha 0 around the body, or `background`).
const std = @import("std")
const math = @import("std.math")
const color = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")

pub const Allocator = std.allocator.Allocator

// The spaces.
pub const SRGB: u8 = 0
pub const LINEAR: u8 = 1
pub const OKLAB: u8 = 2

// OKLab's a and b are stretched by this, so its body is about as wide as
// the cube.
const OKLAB_SPREAD: f64 = 1.6

pub const Solid = struct {
    allocator: Allocator
    // From `from` (morph 0) to `to` (morph 1).
    from: u8
    to: u8
    morph: f64
    // The view: turned about the vertical axis, then tipped toward one.
    yaw: f64
    pitch: f64
    // OKLab lightness above which the body is cut away (1 or more: whole).
    cut: f64
    // Behind the body (0: transparent).
    background: u32
    // A colour marked with a ring where it lies (hasMark).
    mark: u32
    hasMark: bool
    // The picture and its depth, `width` x `height` (heap memory).
    width: i32
    height: i32
    pixels: usize
    depth: usize
    capacity: usize
}

pub fn init(solid: *Solid, allocator: Allocator) -> void {
    solid.*.allocator = allocator
    solid.*.from = SRGB
    solid.*.to = SRGB
    solid.*.morph = 1.0
    solid.*.yaw = -0.45
    solid.*.pitch = 0.38
    solid.*.cut = 1.0
    solid.*.background = 0
    solid.*.mark = 0
    solid.*.hasMark = false
    solid.*.width = 0
    solid.*.height = 0
    solid.*.pixels = 0
    solid.*.depth = 0
    solid.*.capacity = 0
}

pub fn release(solid: *Solid) -> void {
    if solid.*.capacity == 0 { return }
    unsafe {
        solid.*.allocator.free(@ptrFromInt([*]u8, solid.*.pixels), solid.*.capacity * 4, 16)
        solid.*.allocator.free(@ptrFromInt([*]u8, solid.*.depth), solid.*.capacity * 8, 16)
    }
    solid.*.capacity = 0
}

// The picture render() made (width x height, a row after the other).
pub fn pixels(solid: *const Solid) -> [*]const u32 {
    return unsafe { @ptrFromInt([*]const u32, solid.*.pixels) }
}

fn picture(solid: *Solid) -> [*]u32 { return unsafe { @ptrFromInt([*]u32, solid.*.pixels) } }
fn depths(solid: *Solid) -> [*]f64 { return unsafe { @ptrFromInt([*]f64, solid.*.depth) } }

// Turns the view as a drag of (dx, dy) pixels does.
pub fn turn(solid: *Solid, dx: i32, dy: i32) -> void {
    solid.*.yaw += @floatFromInt(f64, dx) * 0.01
    var pitch = solid.*.pitch + @floatFromInt(f64, dy) * 0.01
    if pitch > 1.5 { pitch = 1.5 }
    if pitch < -1.5 { pitch = -1.5 }
    solid.*.pitch = pitch
}

// Where a colour (sRGB channels 0..1, its OKLab beside) lies in `space`.
fn place(space: u8, r: f64, g: f64, b: f64, l: f64, oa: f64, ob: f64, x: *f64, y: *f64, z: *f64) -> void {
    if space == OKLAB {
        x.* = oa * OKLAB_SPREAD
        y.* = l - 0.5
        z.* = ob * OKLAB_SPREAD
        return
    }
    if space == LINEAR {
        x.* = color.srgbToLinear(r) - 0.5
        y.* = color.srgbToLinear(b) - 0.5
        z.* = color.srgbToLinear(g) - 0.5
        return
    }
    x.* = r - 0.5
    y.* = b - 0.5
    z.* = g - 0.5
}

// What a render needs on the way: the view's turn, the picture's middle
// and scale, the dot's size.
const Frame = struct {
    cosYaw: f64
    sinYaw: f64
    cosPitch: f64
    sinPitch: f64
    centreX: f64
    centreY: f64
    scale: f64
    dot: i32
    needLab: bool
}

// One colour of the body put into the picture (when it is nearer than
// what is there).
fn put(solid: *Solid, frame: *const Frame, r: f64, g: f64, b: f64, l: f64, oa: f64, ob: f64) -> void {
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var z0: f64 = 0.0
    place(solid.*.from, r, g, b, l, oa, ob, &x0, &y0, &z0)
    var x = x0
    var y = y0
    var z = z0
    if solid.*.morph < 1.0 || solid.*.from != solid.*.to {
        var x1: f64 = 0.0
        var y1: f64 = 0.0
        var z1: f64 = 0.0
        place(solid.*.to, r, g, b, l, oa, ob, &x1, &y1, &z1)
        const t = solid.*.morph
        x = x0 + (x1 - x0) * t
        y = y0 + (y1 - y0) * t
        z = z0 + (z1 - z0) * t
    }
    const turned_x = x * frame.*.cosYaw + z * frame.*.sinYaw
    const turned_z = z * frame.*.cosYaw - x * frame.*.sinYaw
    const up = y * frame.*.cosPitch - turned_z * frame.*.sinPitch
    const near = y * frame.*.sinPitch + turned_z * frame.*.cosPitch
    const sx = frame.*.centreX + turned_x * frame.*.scale
    const sy = frame.*.centreY - up * frame.*.scale
    if !(sx > -8.0 && sx < 100000.0 && sy > -8.0 && sy < 100000.0) { return }
    const left = @intFromFloat(i32, sx) - frame.*.dot / 2
    const top = @intFromFloat(i32, sy) - frame.*.dot / 2
    const value = pixel.pack(255, @intFromFloat(u32, r * 255.0 + 0.5), @intFromFloat(u32, g * 255.0 + 0.5), @intFromFloat(u32, b * 255.0 + 0.5))
    const into = picture(solid)
    const deep = depths(solid)
    var row = if top < 0 { 0 } else { top }
    const row_end = if top + frame.*.dot > solid.*.height { solid.*.height } else { top + frame.*.dot }
    while row < row_end {
        var column = if left < 0 { 0 } else { left }
        const column_end = if left + frame.*.dot > solid.*.width { solid.*.width } else { left + frame.*.dot }
        while column < column_end {
            const index = @intCast(usize, row) * @intCast(usize, solid.*.width) + @intCast(usize, column)
            if near > deep[index] {
                deep[index] = near
                into[index] = value
            }
            column += 1
        }
        row += 1
    }
}

// A colour of a face: put when it is not cut away.
fn putRgb(solid: *Solid, frame: *const Frame, r: f64, g: f64, b: f64) -> void {
    var l: f64 = 0.0
    var oa: f64 = 0.0
    var ob: f64 = 0.0
    if frame.*.needLab {
        color.linearToOklab(color.srgbToLinear(r), color.srgbToLinear(g), color.srgbToLinear(b), &l, &oa, &ob)
        if l > solid.*.cut { return }
    }
    put(solid, frame, r, g, b, l, oa, ob)
}

// Draws the body at `width` x `height` into the solid's own pixels. False
// when there is no memory for them.
pub fn render(solid: *Solid, width: i32, height: i32) -> bool {
    if width < 1 || height < 1 || width > 4096 || height > 4096 { return false }
    const count = @intCast(usize, width) * @intCast(usize, height)
    if count > solid.*.capacity {
        release(solid)
        const memory = solid.*.allocator.alloc(count * 4, 16)
        if memory == null { return false }
        const deep = solid.*.allocator.alloc(count * 8, 16)
        if deep == null {
            unsafe { solid.*.allocator.free(memory.?, count * 4, 16) }
            return false
        }
        solid.*.pixels = @intFromPtr(memory.?)
        solid.*.depth = @intFromPtr(deep.?)
        solid.*.capacity = count
    }
    solid.*.width = width
    solid.*.height = height
    const into = picture(solid)
    const deep = depths(solid)
    var index: usize = 0
    while index < count {
        into[index] = solid.*.background
        deep[index] = -1000.0
        index += 1
    }
    const side = if width < height { width } else { height }
    var frame = Frame.{
        .cosYaw = math.cos(solid.*.yaw), .sinYaw = math.sin(solid.*.yaw),
        .cosPitch = math.cos(solid.*.pitch), .sinPitch = math.sin(solid.*.pitch),
        .centreX = @floatFromInt(f64, width) / 2.0, .centreY = @floatFromInt(f64, height) / 2.0,
        .scale = @floatFromInt(f64, side) / 1.85, .dot = 2,
        .needLab = solid.*.cut < 1.0 || solid.*.from == OKLAB || solid.*.to == OKLAB,
    }
    // As many points a side as the side has pixels, and a little more.
    var steps = @intFromFloat(i32, frame.scale * 1.15)
    if steps < 16 { steps = 16 }
    if steps > 600 { steps = 600 }
    const last = @floatFromInt(f64, steps)
    var i: i32 = 0
    while i <= steps {
        const u = @floatFromInt(f64, i) / last
        var j: i32 = 0
        while j <= steps {
            const v = @floatFromInt(f64, j) / last
            putRgb(solid, &frame, u, v, 0.0)
            putRgb(solid, &frame, u, v, 1.0)
            putRgb(solid, &frame, u, 0.0, v)
            putRgb(solid, &frame, u, 1.0, v)
            putRgb(solid, &frame, 0.0, u, v)
            putRgb(solid, &frame, 1.0, u, v)
            j += 1
        }
        i += 1
    }
    if solid.*.cut < 1.0 && solid.*.cut > 0.0 { cutFace(solid, &frame, steps) }
    if solid.*.hasMark { drawMark(solid, &frame) }
    return true
}

// The colours at lightness `cut`: OKLab's plane there, where it lies
// inside sRGB.
fn cutFace(solid: *Solid, frame: *const Frame, steps: i32) -> void {
    const l = solid.*.cut
    const reach: f64 = 0.4
    const count = steps * 2
    var i: i32 = 0
    while i <= count {
        const oa = -reach + 2.0 * reach * @floatFromInt(f64, i) / @floatFromInt(f64, count)
        var j: i32 = 0
        while j <= count {
            const ob = -reach + 2.0 * reach * @floatFromInt(f64, j) / @floatFromInt(f64, count)
            var lr: f64 = 0.0
            var lg: f64 = 0.0
            var lb: f64 = 0.0
            color.oklabToLinear(l, oa, ob, &lr, &lg, &lb)
            if lr >= 0.0 && lr <= 1.0 && lg >= 0.0 && lg <= 1.0 && lb >= 0.0 && lb <= 1.0 {
                put(solid, frame, color.linearToSrgb(lr), color.linearToSrgb(lg), color.linearToSrgb(lb), l, oa, ob)
            }
            j += 1
        }
        i += 1
    }
}

// A ring where the marked colour lies (white, a dark one outside it).
fn drawMark(solid: *Solid, frame: *const Frame) -> void {
    const r = @floatFromInt(f64, pixel.red(solid.*.mark)) / 255.0
    const g = @floatFromInt(f64, pixel.green(solid.*.mark)) / 255.0
    const b = @floatFromInt(f64, pixel.blue(solid.*.mark)) / 255.0
    var l: f64 = 0.0
    var oa: f64 = 0.0
    var ob: f64 = 0.0
    color.linearToOklab(color.srgbToLinear(r), color.srgbToLinear(g), color.srgbToLinear(b), &l, &oa, &ob)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var z0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var z1: f64 = 0.0
    place(solid.*.from, r, g, b, l, oa, ob, &x0, &y0, &z0)
    place(solid.*.to, r, g, b, l, oa, ob, &x1, &y1, &z1)
    const t = solid.*.morph
    const x = x0 + (x1 - x0) * t
    const y = y0 + (y1 - y0) * t
    const z = z0 + (z1 - z0) * t
    const turned_x = x * frame.*.cosYaw + z * frame.*.sinYaw
    const turned_z = z * frame.*.cosYaw - x * frame.*.sinYaw
    const up = y * frame.*.cosPitch - turned_z * frame.*.sinPitch
    const cx = frame.*.centreX + turned_x * frame.*.scale
    const cy = frame.*.centreY - up * frame.*.scale
    const into = picture(solid)
    var row: i32 = -9
    while row <= 9 {
        var column: i32 = -9
        while column <= 9 {
            const d = @sqrt(@floatFromInt(f64, row * row + column * column))
            const px = @intFromFloat(i32, cx) + column
            const py = @intFromFloat(i32, cy) + row
            if px >= 0 && py >= 0 && px < solid.*.width && py < solid.*.height {
                const index = @intCast(usize, py) * @intCast(usize, solid.*.width) + @intCast(usize, px)
                if d >= 5.0 && d < 7.0 { into[index] = 0xFFFFFFFF }
                if d >= 7.0 && d < 8.5 { into[index] = 0xFF202020 }
            }
            column += 1
        }
        row += 1
    }
}

// The colour shown at (x, y) of the picture, into `into`; false where the
// body is not (around it, or before the first render).
pub fn pick(solid: *const Solid, x: i32, y: i32, into: *u32) -> bool {
    if solid.*.capacity == 0 || x < 0 || y < 0 || x >= solid.*.width || y >= solid.*.height { return false }
    const index = @intCast(usize, y) * @intCast(usize, solid.*.width) + @intCast(usize, x)
    const deep: [*]const f64 = unsafe { @ptrFromInt([*]const f64, solid.*.depth) }
    if deep[index] <= -1000.0 { return false }
    into.* = pixels(solid)[index]
    return true
}
