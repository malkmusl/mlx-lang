// nebula ui: the colours of sRGB as a body in space, to turn and to
// choose a colour on: the sRGB cube as colours are stored (R' across, G'
// into the picture, B' up), the same cube in linear light, or sRGB's body
// in OKLab (L up, a across, b into the picture), and any way between two
// of them (a morph: every colour moves from its place in one to its place
// in the other). A cut at an OKLab lightness takes away what is lighter:
// the cut face shows the colours inside the body at that lightness, where
// one chooses the colours the outside does not reach.
//
//     var solid: colorsolid.Solid = undefined
//     colorsolid.init(&solid, allocator)
//     solid.to = colorsolid.OKLAB
//     solid.cut = 0.6
//     _ = colorsolid.render(&solid, 300, 300)        // into its own pixels
//     var chosen: u32 = 0
//     if colorsolid.pick(&solid, x, y, &chosen) { ... }
//
// It is drawn forwards: points on the cube's six faces (and on the cut
// face) are put where the space and the view place them, the nearest one
// of each pixel kept (a depth buffer), each a little larger than the
// space between them so no gap shows. The points are worked out once
// (Cloud): turning and morphing only project them again. A pixel shows a colour exactly as
// it is: what is picked is what is seen. Pixels are straight 0xAARRGGBB
// (alpha 0 around the body, or `background`).
const std = @import("std")
const math = @import("std.math")
const color = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")

pub const Allocator = std.allocator.Allocator

// The spaces.
pub const SRGB: u8 = 0
pub const LINEAR: u8 = 1
pub const OKLAB: u8 = 2

// OKLab's a and b are stretched by this, so its body is about as wide as
// the cube.
const OKLAB_SPREAD: f64 = 2.1

pub const Solid = struct {
    allocator: Allocator
    // From `from` (morph 0) to `to` (morph 1).
    from: u8
    to: u8
    morph: f64
    // The view: turned about the vertical axis, then tipped toward one.
    yaw: f64
    pitch: f64
    // OKLab lightness above which the body is cut away (1 or more: whole).
    cut: f64
    // Behind the body (0: transparent).
    background: u32
    // A colour marked with a ring where it lies (hasMark).
    mark: u32
    hasMark: bool
    // The picture and its depth, `width` x `height` (heap memory).
    width: i32
    height: i32
    pixels: usize
    depth: usize
    capacity: usize
    // The points, kept between renders.
    faces: Cloud
    cutFace: Cloud
}

pub fn init(solid: *Solid, allocator: Allocator) -> void {
    solid.*.allocator = allocator
    solid.*.from = SRGB
    solid.*.to = SRGB
    solid.*.morph = 1.0
    solid.*.yaw = -0.45
    solid.*.pitch = 0.38
    solid.*.cut = 1.0
    solid.*.background = 0
    solid.*.mark = 0
    solid.*.hasMark = false
    solid.*.width = 0
    solid.*.height = 0
    solid.*.pixels = 0
    solid.*.depth = 0
    solid.*.capacity = 0
    solid.*.faces = emptyCloud()
    solid.*.cutFace = emptyCloud()
}

// Gives back the points kept and the picture.
pub fn release(solid: *Solid) -> void {
    freeCloud(solid.*.allocator, &solid.*.faces)
    freeCloud(solid.*.allocator, &solid.*.cutFace)
    releasePicture(solid)
}

fn releasePicture(solid: *Solid) -> void {
    if solid.*.capacity == 0 { return }
    unsafe {
        solid.*.allocator.free(@ptrFromInt([*]u8, solid.*.pixels), solid.*.capacity * 4, 16)
        solid.*.allocator.free(@ptrFromInt([*]u8, solid.*.depth), solid.*.capacity * 8, 16)
    }
    solid.*.capacity = 0
}

// The picture render() made (width x height, a row after the other).
pub fn pixels(solid: *const Solid) -> [*]const u32 {
    return unsafe { @ptrFromInt([*]const u32, solid.*.pixels) }
}

fn picture(solid: *Solid) -> [*]u32 { return unsafe { @ptrFromInt([*]u32, solid.*.pixels) } }
fn depths(solid: *Solid) -> [*]f64 { return unsafe { @ptrFromInt([*]f64, solid.*.depth) } }

// Turns the view as a drag of (dx, dy) pixels does.
pub fn turn(solid: *Solid, dx: i32, dy: i32) -> void {
    solid.*.yaw += @floatFromInt(f64, dx) * 0.01
    var pitch = solid.*.pitch + @floatFromInt(f64, dy) * 0.01
    if pitch > 1.5 { pitch = 1.5 }
    if pitch < -1.5 { pitch = -1.5 }
    solid.*.pitch = pitch
}

// Where a colour (sRGB channels 0..1, its OKLab beside) lies in `space`.
fn place(space: u8, r: f64, g: f64, b: f64, l: f64, oa: f64, ob: f64, x: *f64, y: *f64, z: *f64) -> void {
    if space == OKLAB {
        x.* = oa * OKLAB_SPREAD
        y.* = l - 0.5
        z.* = ob * OKLAB_SPREAD
        return
    }
    if space == LINEAR {
        x.* = color.srgbToLinear(r) - 0.5
        y.* = color.srgbToLinear(b) - 0.5
        z.* = color.srgbToLinear(g) - 0.5
        return
    }
    x.* = r - 0.5
    y.* = b - 0.5
    z.* = g - 0.5
}

// The points of the body, worked out once: for every point its colour,
// its OKLab lightness (for the cut) and its place in the two spaces of
// the morph. Turning the body or moving along the morph only puts them
// into the picture again; the colour conversions (three cube roots a
// point) run when the size or the spaces change (and the cut face's when
// the cut does). Each array is its own heap block (none near brixOS's 16
// MiB a block: some 8 MB of them at the largest size).
const Cloud = struct {
    count: usize
    capacity: usize
    colours: usize
    light: usize
    from: usize
    to: usize
    // What it was made for.
    steps: i32
    fromSpace: u8
    toSpace: u8
    cut: f64
    valid: bool
}

fn emptyCloud() -> Cloud {
    return Cloud.{ .count = 0, .capacity = 0, .colours = 0, .light = 0, .from = 0, .to = 0, .steps = 0, .fromSpace = 0, .toSpace = 0, .cut = 0.0, .valid = false }
}

fn colours(cloud: *const Cloud) -> [*]u32 { return unsafe { @ptrFromInt([*]u32, cloud.*.colours) } }
fn lights(cloud: *const Cloud) -> [*]f64 { return unsafe { @ptrFromInt([*]f64, cloud.*.light) } }
fn fromPlaces(cloud: *const Cloud) -> [*]f64 { return unsafe { @ptrFromInt([*]f64, cloud.*.from) } }
fn toPlaces(cloud: *const Cloud) -> [*]f64 { return unsafe { @ptrFromInt([*]f64, cloud.*.to) } }

fn freeCloud(allocator: Allocator, cloud: *Cloud) -> void {
    if cloud.*.capacity != 0 {
        const n = cloud.*.capacity
        unsafe {
            allocator.free(@ptrFromInt([*]u8, cloud.*.colours), n * 4, 16)
            allocator.free(@ptrFromInt([*]u8, cloud.*.light), n * 8, 16)
            allocator.free(@ptrFromInt([*]u8, cloud.*.from), n * 24, 16)
            allocator.free(@ptrFromInt([*]u8, cloud.*.to), n * 24, 16)
        }
    }
    cloud.* = emptyCloud()
}

// Room for `count` points (what was there is gone). False without memory.
fn reserve(allocator: Allocator, cloud: *Cloud, count: usize) -> bool {
    if count <= cloud.*.capacity {
        cloud.*.count = 0
        return true
    }
    freeCloud(allocator, cloud)
    const a = allocator.alloc(count * 4, 16)
    const b = allocator.alloc(count * 8, 16)
    const c = allocator.alloc(count * 24, 16)
    const d = allocator.alloc(count * 24, 16)
    if a == null || b == null || c == null || d == null {
        if a != null { allocator.free(a.?, count * 4, 16) }
        if b != null { allocator.free(b.?, count * 8, 16) }
        if c != null { allocator.free(c.?, count * 24, 16) }
        if d != null { allocator.free(d.?, count * 24, 16) }
        return false
    }
    cloud.*.colours = @intFromPtr(a.?)
    cloud.*.light = @intFromPtr(b.?)
    cloud.*.from = @intFromPtr(c.?)
    cloud.*.to = @intFromPtr(d.?)
    cloud.*.capacity = count
    cloud.*.count = 0
    return true
}

// One more point: sRGB channels 0..1 and their OKLab.
fn add(cloud: *Cloud, r: f64, g: f64, b: f64, l: f64, oa: f64, ob: f64) -> void {
    const at = cloud.*.count
    if at >= cloud.*.capacity { return }
    colours(cloud)[at] = pixel.pack(255, @intFromFloat(u32, r * 255.0 + 0.5), @intFromFloat(u32, g * 255.0 + 0.5), @intFromFloat(u32, b * 255.0 + 0.5))
    lights(cloud)[at] = l
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    place(cloud.*.fromSpace, r, g, b, l, oa, ob, &x, &y, &z)
    const first = fromPlaces(cloud)
    first[at * 3] = x
    first[at * 3 + 1] = y
    first[at * 3 + 2] = z
    place(cloud.*.toSpace, r, g, b, l, oa, ob, &x, &y, &z)
    const second = toPlaces(cloud)
    second[at * 3] = x
    second[at * 3 + 1] = y
    second[at * 3 + 2] = z
    cloud.*.count = at + 1
}

fn addRgb(cloud: *Cloud, r: f64, g: f64, b: f64) -> void {
    var l: f64 = 0.0
    var oa: f64 = 0.0
    var ob: f64 = 0.0
    color.linearToOklab(color.srgbToLinear(r), color.srgbToLinear(g), color.srgbToLinear(b), &l, &oa, &ob)
    add(cloud, r, g, b, l, oa, ob)
}

// The cube's six faces, `steps` points a side.
fn makeFaces(solid: *Solid, steps: i32) -> bool {
    const cloud = &solid.*.faces
    if cloud.*.valid && cloud.*.steps == steps && cloud.*.fromSpace == solid.*.from && cloud.*.toSpace == solid.*.to { return true }
    const side = @intCast(usize, steps + 1)
    if !reserve(solid.*.allocator, cloud, side * side * 6) { return false }
    cloud.*.fromSpace = solid.*.from
    cloud.*.toSpace = solid.*.to
    const last = @floatFromInt(f64, steps)
    var i: i32 = 0
    while i <= steps {
        const u = @floatFromInt(f64, i) / last
        var j: i32 = 0
        while j <= steps {
            const v = @floatFromInt(f64, j) / last
            addRgb(cloud, u, v, 0.0)
            addRgb(cloud, u, v, 1.0)
            addRgb(cloud, u, 0.0, v)
            addRgb(cloud, u, 1.0, v)
            addRgb(cloud, 0.0, u, v)
            addRgb(cloud, 1.0, u, v)
            j += 1
        }
        i += 1
    }
    cloud.*.steps = steps
    cloud.*.valid = true
    return true
}

// The colours at lightness `cut`: OKLab's plane there, where it lies
// inside sRGB.
fn makeCut(solid: *Solid, steps: i32) -> bool {
    const cloud = &solid.*.cutFace
    const l = solid.*.cut
    if cloud.*.valid && cloud.*.steps == steps && cloud.*.cut == l && cloud.*.fromSpace == solid.*.from && cloud.*.toSpace == solid.*.to { return true }
    const count = steps * 2
    const side = @intCast(usize, count + 1)
    if !reserve(solid.*.allocator, cloud, side * side) { return false }
    cloud.*.fromSpace = solid.*.from
    cloud.*.toSpace = solid.*.to
    const reach: f64 = 0.4
    var i: i32 = 0
    while i <= count {
        const oa = -reach + 2.0 * reach * @floatFromInt(f64, i) / @floatFromInt(f64, count)
        var j: i32 = 0
        while j <= count {
            const ob = -reach + 2.0 * reach * @floatFromInt(f64, j) / @floatFromInt(f64, count)
            var lr: f64 = 0.0
            var lg: f64 = 0.0
            var lb: f64 = 0.0
            color.oklabToLinear(l, oa, ob, &lr, &lg, &lb)
            if lr >= 0.0 && lr <= 1.0 && lg >= 0.0 && lg <= 1.0 && lb >= 0.0 && lb <= 1.0 {
                add(cloud, color.linearToSrgb(lr), color.linearToSrgb(lg), color.linearToSrgb(lb), l, oa, ob)
            }
            j += 1
        }
        i += 1
    }
    cloud.*.steps = steps
    cloud.*.cut = l
    cloud.*.valid = true
    return true
}

// What a render needs on the way: the view's turn, the picture's middle
// and scale, the dot's size.
const Frame = struct {
    cosYaw: f64
    sinYaw: f64
    cosPitch: f64
    sinPitch: f64
    centreX: f64
    centreY: f64
    scale: f64
    dot: i32
}

// The points of `cloud` (those not lighter than `cut`) into the picture,
// each where the morph places it, the nearest kept.
fn project(solid: *Solid, frame: *const Frame, cloud: *const Cloud, cut: f64) -> void {
    const into = picture(solid)
    const deep = depths(solid)
    const shade = colours(cloud)
    const light = lights(cloud)
    const first = fromPlaces(cloud)
    const second = toPlaces(cloud)
    const t = solid.*.morph
    const keep = 1.0 - t
    const cy = frame.*.cosYaw
    const sy = frame.*.sinYaw
    const cp = frame.*.cosPitch
    const sp = frame.*.sinPitch
    const scale = frame.*.scale
    const centre_x = frame.*.centreX
    const centre_y = frame.*.centreY
    const width = solid.*.width
    const height = solid.*.height
    const dot = frame.*.dot
    var k: usize = 0
    while k < cloud.*.count {
        if light[k] <= cut {
            const x = first[k * 3] * keep + second[k * 3] * t
            const y = first[k * 3 + 1] * keep + second[k * 3 + 1] * t
            const z = first[k * 3 + 2] * keep + second[k * 3 + 2] * t
            const turned_x = x * cy + z * sy
            const turned_z = z * cy - x * sy
            const up = y * cp - turned_z * sp
            const near = y * sp + turned_z * cp
            const left = @intFromFloat(i32, centre_x + turned_x * scale) - dot / 2
            const top = @intFromFloat(i32, centre_y - up * scale) - dot / 2
            if left >= 0 && top >= 0 && left + dot <= width && top + dot <= height {
                var row: i32 = 0
                while row < dot {
                    var index = @intCast(usize, top + row) * @intCast(usize, width) + @intCast(usize, left)
                    var column: i32 = 0
                    while column < dot {
                        if near > deep[index] {
                            deep[index] = near
                            into[index] = shade[k]
                        }
                        index += 1
                        column += 1
                    }
                    row += 1
                }
            }
        }
        k += 1
    }
}

// Draws the body at `width` x `height` into the solid's own pixels. False
// when there is no memory for them.
pub fn render(solid: *Solid, width: i32, height: i32) -> bool {
    if width < 1 || height < 1 || width > 4096 || height > 4096 { return false }
    const count = @intCast(usize, width) * @intCast(usize, height)
    if count > solid.*.capacity {
        releasePicture(solid)
        const memory = solid.*.allocator.alloc(count * 4, 16)
        if memory == null { return false }
        const deep = solid.*.allocator.alloc(count * 8, 16)
        if deep == null {
            unsafe { solid.*.allocator.free(memory.?, count * 4, 16) }
            return false
        }
        solid.*.pixels = @intFromPtr(memory.?)
        solid.*.depth = @intFromPtr(deep.?)
        solid.*.capacity = count
    }
    solid.*.width = width
    solid.*.height = height
    const into = picture(solid)
    const deep = depths(solid)
    var index: usize = 0
    while index < count {
        into[index] = solid.*.background
        deep[index] = -1000.0
        index += 1
    }
    const side = if width < height { width } else { height }
    const frame = Frame.{
        .cosYaw = math.cos(solid.*.yaw), .sinYaw = math.sin(solid.*.yaw),
        .cosPitch = math.cos(solid.*.pitch), .sinPitch = math.sin(solid.*.pitch),
        .centreX = @floatFromInt(f64, width) / 2.0, .centreY = @floatFromInt(f64, height) / 2.0,
        .scale = @floatFromInt(f64, side) / 1.6, .dot = 3,
    }
    // A point every pixel and a half: the dots of three cover the gaps.
    var steps = @intFromFloat(i32, frame.scale * 0.75)
    if steps < 16 { steps = 16 }
    if steps > 400 { steps = 400 }
    if !makeFaces(solid, steps) { return false }
    const cut: f64 = if solid.*.cut < 1.0 { solid.*.cut } else { 2.0 }
    project(solid, &frame, &solid.*.faces, cut)
    if solid.*.cut < 1.0 && solid.*.cut > 0.0 {
        if !makeCut(solid, steps) { return false }
        project(solid, &frame, &solid.*.cutFace, 2.0)
    }
    if solid.*.hasMark { drawMark(solid, &frame) }
    return true
}

// A ring where the marked colour lies (white, a dark one outside it).
fn drawMark(solid: *Solid, frame: *const Frame) -> void {
    const r = @floatFromInt(f64, pixel.red(solid.*.mark)) / 255.0
    const g = @floatFromInt(f64, pixel.green(solid.*.mark)) / 255.0
    const b = @floatFromInt(f64, pixel.blue(solid.*.mark)) / 255.0
    var l: f64 = 0.0
    var oa: f64 = 0.0
    var ob: f64 = 0.0
    color.linearToOklab(color.srgbToLinear(r), color.srgbToLinear(g), color.srgbToLinear(b), &l, &oa, &ob)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var z0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var z1: f64 = 0.0
    place(solid.*.from, r, g, b, l, oa, ob, &x0, &y0, &z0)
    place(solid.*.to, r, g, b, l, oa, ob, &x1, &y1, &z1)
    const t = solid.*.morph
    const x = x0 + (x1 - x0) * t
    const y = y0 + (y1 - y0) * t
    const z = z0 + (z1 - z0) * t
    const turned_x = x * frame.*.cosYaw + z * frame.*.sinYaw
    const turned_z = z * frame.*.cosYaw - x * frame.*.sinYaw
    const up = y * frame.*.cosPitch - turned_z * frame.*.sinPitch
    const cx = frame.*.centreX + turned_x * frame.*.scale
    const cy = frame.*.centreY - up * frame.*.scale
    const into = picture(solid)
    var row: i32 = -9
    while row <= 9 {
        var column: i32 = -9
        while column <= 9 {
            const d = @sqrt(@floatFromInt(f64, row * row + column * column))
            const px = @intFromFloat(i32, cx) + column
            const py = @intFromFloat(i32, cy) + row
            if px >= 0 && py >= 0 && px < solid.*.width && py < solid.*.height {
                const index = @intCast(usize, py) * @intCast(usize, solid.*.width) + @intCast(usize, px)
                if d >= 5.0 && d < 7.0 { into[index] = 0xFFFFFFFF }
                if d >= 7.0 && d < 8.5 { into[index] = 0xFF202020 }
            }
            column += 1
        }
        row += 1
    }
}

// The colour shown at (x, y) of the picture, into `into`; false where the
// body is not (around it, or before the first render).
pub fn pick(solid: *const Solid, x: i32, y: i32, into: *u32) -> bool {
    if solid.*.capacity == 0 || x < 0 || y < 0 || x >= solid.*.width || y >= solid.*.height { return false }
    const index = @intCast(usize, y) * @intCast(usize, solid.*.width) + @intCast(usize, x)
    const deep: [*]const f64 = unsafe { @ptrFromInt([*]const f64, solid.*.depth) }
    if deep[index] <= -1000.0 { return false }
    into.* = pixels(solid)[index]
    return true
}
