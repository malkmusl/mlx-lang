// The table in heap memory, copied there when it is first asked for:
// reading ICONS itself at run time, even one row by a number known only
// then, copies all of it into the value arena each time.
var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

fn rows() -> []const Icon {
    if kept.address != 0 { return table.rows(Icon, &kept) }
    return table.keep(Icon, &kept, ICONS[0..])
}

// How many icons there are: their numbers are 0 to count() - 1.
pub fn count() -> usize { return COUNT }

// The icon's key (lower case, words joined by hyphens: "tool-brush"), for
// settings and tests; empty for a number that is no icon.
pub fn name(icon: u16) -> []const u8 {
    const index = @intCast(usize, icon)
    if index >= COUNT { return "" }
    return rows()[index].name
}

// The icon with the key `key`; NONE when there is none.
pub fn named(key: []const u8) -> u16 {
    const icons = rows()
    var index: usize = 0
    while index < icons.length {
        if std.text.same(icons[index].name, key) { return @intCast(u16, index) }
        index += 1
    }
    return NONE
}

// ---------------------------------------------------------------------------
// The kept pictures

// The most pictures kept and the most bytes of pixels they take together.
pub const CACHE_PICTURES: usize = 384
pub const CACHE_BYTES: usize = 8388608

// A picture is kept at most this many pixels a side; a larger icon is the
// picture of this size drawn larger.
const LARGEST: i32 = 256

// The places a key may hash to (a power of two, more than twice the
// pictures: a search always ends at a free one).
const SLOTS: usize = 1024

const Picture = struct {
    // The icon, the side and the colour in one word (never 0: a side is
    // at least 1); 0: free.
    key: u64
    // When it was drawn last (the cache's clock then).
    used: u64
    // The pixels: premultiplied, side x side, std.png's Image so that a
    // GPU canvas can take it too.
    image: png.Image
}

const Cache = struct {
    pictures: [*]Picture
    // For each place a key hashes to: the picture there plus one, 0: none.
    slots: [*]u16
    kept: usize
    bytes: usize
    clock: u64
    allocator: Allocator
    // Where a picture is made: here and not a local of render(), whose
    // address, handed to every figure, would take it from the value arena
    // for each picture made.
    glyph: Glyph
}

var cache: ?*Cache = null

fn pictureAt(kept: *Cache, index: usize) -> *Picture {
    unsafe { return @ptrFromInt(*Picture, @intFromPtr(kept.*.pictures) + index * @sizeOf(Picture)) }
}

fn keyOf(icon: u16, side: usize, color: u32) -> u64 {
    return (@intCast(u64, icon) << 48) | ((@intCast(u64, side) & 65535) << 32) | @intCast(u64, color)
}

fn slotOf(key: u64) -> usize {
    return @intCast(usize, (key *% 0x9E3779B97F4A7C15) >> 54)
}

// The cache, made when it is first needed; null without memory.
fn theCache() -> ?*Cache {
    if cache != null { return cache }
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(Cache), 16)
    if memory == null { return null }
    const pictures = allocator.alloc(CACHE_PICTURES * @sizeOf(Picture), 16)
    const slots = allocator.alloc(SLOTS * 2, 16)
    if pictures == null || slots == null {
        if pictures != null { allocator.free(pictures.?, CACHE_PICTURES * @sizeOf(Picture), 16) }
        if slots != null { allocator.free(slots.?, SLOTS * 2, 16) }
        allocator.free(memory.?, @sizeOf(Cache), 16)
        return null
    }
    // Kept until release(): not what a leak check should report.
    leaks.keep(memory.?)
    leaks.keep(pictures.?)
    leaks.keep(slots.?)
    const made: *Cache = unsafe { @ptrCast(*Cache, memory.?) }
    unsafe {
        made.*.pictures = @ptrCast([*]Picture, pictures.?)
        made.*.slots = @ptrCast([*]u16, slots.?)
    }
    made.*.kept = 0
    made.*.bytes = 0
    made.*.clock = 0
    made.*.allocator = allocator
    var index: usize = 0
    while index < CACHE_PICTURES {
        pictureAt(made, index).*.key = 0
        index += 1
    }
    index = 0
    while index < SLOTS {
        made.*.slots[index] = 0
        index += 1
    }
    cache = made
    return made
}

// The kept picture with `key`; null when there is none.
fn find(kept: *Cache, key: u64) -> ?*Picture {
    var slot = slotOf(key)
    while kept.*.slots[slot] != 0 {
        const picture = pictureAt(kept, @intCast(usize, kept.*.slots[slot]) - 1)
        if picture.*.key == key { return picture }
        slot = (slot + 1) & (SLOTS - 1)
    }
    return null
}

fn enter(kept: *Cache, index: usize) -> void {
    var slot = slotOf(pictureAt(kept, index).*.key)
    while kept.*.slots[slot] != 0 { slot = (slot + 1) & (SLOTS - 1) }
    kept.*.slots[slot] = @intCast(u16, index + 1)
}

// Forgets the picture drawn longest ago and enters the others anew (taking
// one out of a row of slots would break the searches that pass it).
fn forgetOldest(kept: *Cache) -> void {
    var oldest: usize = CACHE_PICTURES
    var index: usize = 0
    while index < CACHE_PICTURES {
        const picture = pictureAt(kept, index)
        if picture.*.key != 0 && (oldest == CACHE_PICTURES || picture.*.used < pictureAt(kept, oldest).*.used) { oldest = index }
        index += 1
    }
    if oldest == CACHE_PICTURES { return }
    forget(kept, oldest)
    index = 0
    while index < SLOTS {
        kept.*.slots[index] = 0
        index += 1
    }
    index = 0
    while index < CACHE_PICTURES {
        if pictureAt(kept, index).*.key != 0 { enter(kept, index) }
        index += 1
    }
}

fn forget(kept: *Cache, index: usize) -> void {
    const picture = pictureAt(kept, index)
    const bytes = picture.*.image.width * picture.*.image.height * 4
    unsafe { kept.*.allocator.free(@ptrCast([*]u8, picture.*.image.pixels), bytes, 16) }
    picture.*.key = 0
    kept.*.kept -= 1
    kept.*.bytes -= bytes
}

// The picture of `icon`, `side` pixels square in `color`, drawn now if it
// is not kept; null without memory.
fn pictureOf(kept: *Cache, icon: u16, side: usize, color: u32) -> ?*Picture {
    const key = keyOf(icon, side, color)
    kept.*.clock += 1
    const found = find(kept, key)
    if found != null {
        found.?.*.used = kept.*.clock
        return found
    }
    const bytes = side * side * 4
    while kept.*.kept > 0 && (kept.*.kept >= CACHE_PICTURES || kept.*.bytes + bytes > CACHE_BYTES) { forgetOldest(kept) }
    const memory = kept.*.allocator.alloc(bytes, 16)
    if memory == null { return null }
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, memory.?) }
    if !render(kept, icon, side, color, pixels) {
        kept.*.allocator.free(memory.?, bytes, 16)
        return null
    }
    leaks.keep(memory.?)
    var index: usize = 0
    while pictureAt(kept, index).*.key != 0 { index += 1 }
    const picture = pictureAt(kept, index)
    picture.*.key = key
    picture.*.used = kept.*.clock
    picture.*.image.pixels = pixels
    picture.*.image.width = side
    picture.*.image.height = side
    picture.*.image.allocator = kept.*.allocator
    kept.*.kept += 1
    kept.*.bytes += bytes
    enter(kept, index)
    return picture
}

// How many pictures are kept now (never more than CACHE_PICTURES).
pub fn cached() -> usize {
    if cache == null { return 0 }
    return cache.?.*.kept
}

// How many bytes of pixels they take (never more than CACHE_BYTES).
pub fn cachedBytes() -> usize {
    if cache == null { return 0 }
    return cache.?.*.bytes
}

// Frees every kept picture and the cache itself; the next draw() starts
// a new one.
pub fn release() -> void {
    if cache == null { return }
    const kept = cache.?
    const allocator = kept.*.allocator
    var index: usize = 0
    while index < CACHE_PICTURES {
        if pictureAt(kept, index).*.key != 0 { forget(kept, index) }
        index += 1
    }
    unsafe {
        allocator.free(@ptrCast([*]u8, kept.*.pictures), CACHE_PICTURES * @sizeOf(Picture), 16)
        allocator.free(@ptrCast([*]u8, kept.*.slots), SLOTS * 2, 16)
        allocator.free(@ptrCast([*]u8, kept), @sizeOf(Cache), 16)
    }
    cache = null
}

// ---------------------------------------------------------------------------
// Drawing

// Draws `icon` at (x, y), `size` pixels square, in `color` (a canvas
// colour: premultiplied) over what is there. Nothing for a number that is
// no icon, a size below 1, a colour of no alpha, and on a canvas of no
// pixels.
pub fn draw(canvas: *Canvas, icon: u16, x: i32, y: i32, size: i32, color: u32) -> void {
    if size <= 0 || (color >> 24) == 0 || @intCast(usize, icon) >= COUNT { return }
    if canvas.*.device == 0 {
        // A layout pass's canvas, or all of the icon off the canvas: no
        // picture is made for what will not show.
        if canvas.*.width == 0 || canvas.*.height == 0 { return }
        if x >= @intCast(i32, canvas.*.width) || y >= @intCast(i32, canvas.*.height) { return }
        if x +| size <= 0 || y +| size <= 0 { return }
    }
    const kept = theCache()
    if kept == null { return }
    const side = if size > LARGEST { LARGEST } else { size }
    const picture = pictureOf(kept.?, icon, @intCast(usize, side), color)
    if picture == null { return }
    if canvas.*.device != 0 || side != size {
        canvas_module.drawImage(canvas, imageOf(picture.?), x, y, size, 255)
        return
    }
    copy(canvas, picture.?.*.image.pixels, side, x, y)
}

fn imageOf(picture: *Picture) -> *png.Image {
    unsafe { return @ptrCast(*png.Image, &picture.*.image) }
}

// draw() in the shape ui/kit.mlx's widgets call what draws their icons:
// `context` is the icon's number.
pub fn drawFor(context: usize, canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    if context >= COUNT { return }
    draw(canvas, @intCast(u16, context), x, y, size, color)
}

// The picture's pixels over the canvas's, the part of it that is on the
// canvas. (std.ui.canvas's drawImage does the same through tables of a
// few KiB that it takes from the value arena each time: an icon is drawn
// too often for that.)
fn copy(canvas: *Canvas, source: [*]const u32, side: i32, x: i32, y: i32) -> void {
    const opacity = if canvas.*.opacity > 255 { 255 } else { canvas.*.opacity }
    if opacity == 0 { return }
    const width = @intCast(i32, canvas.*.width)
    const height = @intCast(i32, canvas.*.height)
    const row_start = if y < 0 { 0 - y } else { 0 }
    const row_end = if side < height - y { side } else { height - y }
    const column_start = if x < 0 { 0 - x } else { 0 }
    const column_end = if side < width - x { side } else { width - x }
    if column_end <= column_start { return }
    const pixels = canvas.*.pixels
    const swap = canvas.*.swapRedBlue
    var row = row_start
    while row < row_end {
        var at = @intCast(usize, y + row) * canvas.*.stride + @intCast(usize, x + column_start)
        var from = @intCast(usize, row * side + column_start)
        const end = from + @intCast(usize, column_end - column_start)
        while from < end {
            const word = source[from]
            if word != 0 {
                const own = if swap { (word & 0xFF00FF00) | ((word & 0xFF0000) >> 16) | ((word & 0xFF) << 16) } else { word }
                if opacity == 255 && (word >> 24) == 255 {
                    pixels[at] = own
                } else {
                    pixels[at] = canvas_module.over(pixels[at], own, opacity)
                }
            }
            at += 1
            from += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// A picture in the making

// The grid the pictures are written on.
const UNITS: f64 = 24.0
// A stroke's width on it, and that of a thin one (a ruler's ticks).
const STROKE: f64 = 2.0
const THIN: f64 = 1.2
// A point that lies this close to the middle between two places it could
// be fitted to goes to the outer one.
const TIE: f64 = 0.0001
// The side of a knot (the square on a path's point).
const KNOT: f64 = 3.6

// What a path's piece is that strokePath() walks: a cubic curve or an
// ellipse's arc.
const CUBIC: u8 = 0
const ARC: u8 = 1

const Glyph = struct {
    // One figure at a time is drawn here and then put into `cover`.
    shape: Shape
    // How much of each pixel the picture covers so far, and the figure
    // just drawn: a byte a pixel, side x side.
    cover: [*]u8
    part: [*]u8
    side: usize
    // Pixels a unit of the grid, and the picture's middle in pixels.
    k: f64
    middle: f64
    // The stroke's width in pixels and where its middle line lies on a
    // pixel: 0.5 for an odd width (on the pixel's middle), 0 for an even
    // one (between two pixels).
    stroke: f64
    lattice: f64
    // The lattice a filled path's points are fitted to: 0 (pixel edges),
    // or the stroke's when the figure continues a stroke.
    fillLattice: f64
    // Points are fitted to the pixels (off: exactly where the grid says).
    snap: bool
    // Figures are cut out of the picture instead of added to it.
    cut: bool
    // How much of itself an added figure shows (255: all).
    tone: u32
    // The pen of a stroked path, in pixels, how far fitting moved it from
    // where the grid says, and where the path began.
    penX: f64
    penY: f64
    movedX: f64
    movedY: f64
    startX: f64
    startY: f64
    // The piece strokePath() walks: a cubic's four points, or an arc's
    // centre, radii and angles (radians).
    path: [8]f64
    // sample()'s result: a point of the piece and the way it goes there
    // (a unit vector).
    pointX: f64
    pointY: f64
    wayX: f64
    wayY: f64
    // fit()'s result: a circle's centre and radius in pixels.
    fitX: f64
    fitY: f64
    fitR: f64
}

fn shapeOf(g: *Glyph) -> *Shape {
    unsafe { return @ptrCast(*Shape, &g.*.shape) }
}

// The whole number nearest to `value`, as a float (halves up).
fn whole(value: f64) -> f64 { return @floor(value + 0.5) }

// `units` of the grid in whole pixels, at least one.
fn pixelsOf(g: *Glyph, units: f64) -> f64 {
    const size = whole(units * g.*.k)
    return if size < 1.0 { 1.0 } else { size }
}

// `value` (pixels) moved to the nearest place of `lattice` (0: whole
// pixels, 0.5: their middles), mirrored about `middle`: two values equally
// far from the middle stay so. Of two places equally near, the outer one
// (`outward`) or the inner one.
fn snapAbout(value: f64, middle: f64, lattice: f64, outward: bool) -> f64 {
    const offset = lattice - middle
    const phase = offset - @floor(offset)
    const distance = math.absolute(value - middle)
    const tie = if outward { TIE } else { 0.0 - TIE }
    var steps: f64 = 0.0
    if phase > 0.25 && phase < 0.75 {
        steps = @floor(distance + tie) + 0.5
    } else {
        steps = @floor(distance + 0.5 + tie)
    }
    if steps < 0.0 { steps = 0.0 }
    return if value < middle { middle - steps } else { middle + steps }
}

// A place of the grid in pixels, as it is.
fn raw(g: *Glyph, value: f64) -> f64 { return value * @floatFromInt(f64, g.*.side) / UNITS }

// A place of the grid in pixels where a stroke's middle line may lie.
fn at(g: *Glyph, value: f64) -> f64 {
    if !g.*.snap { return raw(g, value) }
    return snapAbout(raw(g, value), g.*.middle, g.*.lattice, true)
}

// A place of the grid in pixels where a filled figure's edge may lie.
fn edge(g: *Glyph, value: f64) -> f64 {
    if !g.*.snap { return raw(g, value) }
    return snapAbout(raw(g, value), g.*.middle, 0.0, true)
}

// Strokes as wide as `units` of the grid from now on.
fn strokeWidth(g: *Glyph, units: f64) -> void {
    g.*.stroke = pixelsOf(g, units)
    const halves = g.*.stroke / 2.0
    g.*.lattice = halves - @floor(halves)
}

fn thin(g: *Glyph) -> void { strokeWidth(g, THIN) }
fn normal(g: *Glyph) -> void { strokeWidth(g, STROKE) }

// The figure in the shape goes into the picture: added (where two figures
// lie over each other the picture has the larger of them, so that strokes
// that meet or cross do not grow fat) or cut out of it.
fn put(g: *Glyph) -> void {
    vector.coverage(shapeOf(g), g.*.part)
    const cells = g.*.side * g.*.side
    const cover = g.*.cover
    const part = g.*.part
    const cut = g.*.cut
    const tone = g.*.tone
    var index: usize = 0
    while index < cells {
        const amount = @intCast(u32, part[index])
        if amount != 0 {
            const had = @intCast(u32, cover[index])
            if cut {
                cover[index] = @intCast(u8, pixel.mul(had, 255 - amount))
            } else {
                const shown = if tone >= 255 { amount } else { pixel.mul(amount, tone) }
                if shown > had { cover[index] = @intCast(u8, shown) }
            }
        }
        index += 1
    }
}

// A line `width` pixels wide between two places in pixels, its ends round
// or cut straight.
fn capsule(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64, width: f64, round: bool) -> void {
    const dx = x1 - x0
    const dy = y1 - y0
    if dx * dx + dy * dy < 0.0001 {
        if !round { return }
        vector.circle(shapeOf(g), x0, y0, width / 2.0)
    } else {
        vector.line(shapeOf(g), x0, y0, x1, y1, width, round)
    }
    put(g)
}

// --- Strokes: a pen that is put down and moved

// The pen put down at a place of the grid.
fn from(g: *Glyph, x: f64, y: f64) -> void {
    g.*.penX = at(g, x)
    g.*.penY = at(g, y)
    g.*.movedX = g.*.penX - raw(g, x)
    g.*.movedY = g.*.penY - raw(g, y)
    g.*.startX = g.*.penX
    g.*.startY = g.*.penY
}

// A straight stroke from the pen to a place.
fn to(g: *Glyph, x: f64, y: f64) -> void {
    const nx = at(g, x)
    const ny = at(g, y)
    capsule(g, g.*.penX, g.*.penY, nx, ny, g.*.stroke, true)
    g.*.penX = nx
    g.*.penY = ny
    g.*.movedX = nx - raw(g, x)
    g.*.movedY = ny - raw(g, y)
}

// A straight stroke back to where the path began.
fn shut(g: *Glyph) -> void {
    capsule(g, g.*.penX, g.*.penY, g.*.startX, g.*.startY, g.*.stroke, true)
    g.*.penX = g.*.startX
    g.*.penY = g.*.startY
}

fn line(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64) -> void {
    from(g, x0, y0)
    to(g, x1, y1)
}

// A cubic curve from the pen to (x, y) by the control points (ax, ay) and
// (bx, by). Its ends are fitted to the pixels as a line's are; each
// control point moves with the end it belongs to, so the curve leaves and
// arrives the way it was written.
fn curve(g: *Glyph, ax: f64, ay: f64, bx: f64, by: f64, x: f64, y: f64) -> void {
    const nx = at(g, x)
    const ny = at(g, y)
    const mx = nx - raw(g, x)
    const my = ny - raw(g, y)
    g.*.path[0] = g.*.penX
    g.*.path[1] = g.*.penY
    g.*.path[2] = raw(g, ax) + g.*.movedX
    g.*.path[3] = raw(g, ay) + g.*.movedY
    g.*.path[4] = raw(g, bx) + mx
    g.*.path[5] = raw(g, by) + my
    g.*.path[6] = nx
    g.*.path[7] = ny
    const length = math.hypot(g.*.path[2] - g.*.path[0], g.*.path[3] - g.*.path[1]) + math.hypot(g.*.path[4] - g.*.path[2], g.*.path[5] - g.*.path[3]) + math.hypot(nx - g.*.path[4], ny - g.*.path[5])
    strokePath(g, CUBIC, stepsFor(length), g.*.stroke, true)
    g.*.penX = nx
    g.*.penY = ny
    g.*.movedX = mx
    g.*.movedY = my
}

// A quadratic curve from the pen to (x, y) by one control point.
fn bend(g: *Glyph, cx: f64, cy: f64, x: f64, y: f64) -> void {
    const k = g.*.k
    const x0 = (g.*.penX - g.*.movedX) / k
    const y0 = (g.*.penY - g.*.movedY) / k
    curve(g, x0 + (cx - x0) * 2.0 / 3.0, y0 + (cy - y0) * 2.0 / 3.0, x + (cx - x) * 2.0 / 3.0, y + (cy - y) * 2.0 / 3.0, x, y)
}

// A quarter of an ellipse from the pen to (x, y), round the corner
// (cx, cy): the pen leaves towards the corner and arrives from it.
fn turn(g: *Glyph, cx: f64, cy: f64, x: f64, y: f64) -> void {
    const k = g.*.k
    const x0 = (g.*.penX - g.*.movedX) / k
    const y0 = (g.*.penY - g.*.movedY) / k
    const kappa = 0.5522847498
    curve(g, x0 + (cx - x0) * kappa, y0 + (cy - y0) * kappa, x + (cx - x) * kappa, y + (cy - y) * kappa, x, y)
}

// How many straight pieces a curved one of `length` pixels is walked in.
fn stepsFor(length: f64) -> i64 {
    const wanted = @ceil(length / 1.5)
    if wanted < 6.0 { return 6 }
    if wanted > 160.0 { return 160 }
    return @intFromFloat(i64, wanted)
}

// The point of the piece in g.path at `t` (0 to 1) and the way it goes
// there, into g.point and g.way.
fn sample(g: *Glyph, kind: u8, t: f64) -> void {
    var dx: f64 = 0.0
    var dy: f64 = 0.0
    if kind == CUBIC {
        const u = 1.0 - t
        const x0 = g.*.path[0]
        const y0 = g.*.path[1]
        const x1 = g.*.path[2]
        const y1 = g.*.path[3]
        const x2 = g.*.path[4]
        const y2 = g.*.path[5]
        const x3 = g.*.path[6]
        const y3 = g.*.path[7]
        g.*.pointX = u * u * u * x0 + 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t * x3
        g.*.pointY = u * u * u * y0 + 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t * y3
        dx = 3.0 * u * u * (x1 - x0) + 6.0 * u * t * (x2 - x1) + 3.0 * t * t * (x3 - x2)
        dy = 3.0 * u * u * (y1 - y0) + 6.0 * u * t * (y2 - y1) + 3.0 * t * t * (y3 - y2)
        // A control point on its end leaves no way there: the next one's.
        if dx * dx + dy * dy < 0.000001 {
            dx = if t < 0.5 { x2 - x0 } else { x3 - x1 }
            dy = if t < 0.5 { y2 - y0 } else { y3 - y1 }
        }
        if dx * dx + dy * dy < 0.000001 {
            dx = x3 - x0
            dy = y3 - y0
        }
    } else {
        const angle = g.*.path[4] + (g.*.path[5] - g.*.path[4]) * t
        const cosine = math.cos(angle)
        const sine = math.sin(angle)
        const direction = if g.*.path[5] < g.*.path[4] { -1.0 } else { 1.0 }
        // Angles go against the clock as on paper; y goes down.
        g.*.pointX = g.*.path[0] + g.*.path[2] * cosine
        g.*.pointY = g.*.path[1] - g.*.path[3] * sine
        dx = (0.0 - g.*.path[2] * sine) * direction
        dy = (0.0 - g.*.path[3] * cosine) * direction
    }
    const length = math.hypot(dx, dy)
    if length < 0.000001 {
        g.*.wayX = 1.0
        g.*.wayY = 0.0
    } else {
        g.*.wayX = dx / length
        g.*.wayY = dy / length
    }
}

// The piece in g.path stroked `width` pixels wide as one outline: along
// one side, round the end, back along the other side, round the start.
// (Short straight strokes put one after the other would each cover a part
// of the pixels at their joints, and the curve's edge would bead.)
fn strokePath(g: *Glyph, kind: u8, steps: i64, width: f64, round: bool) -> void {
    const shape = shapeOf(g)
    const radius = width / 2.0
    var caps = @intFromFloat(i64, @ceil(radius * 3.2))
    if caps < 4 { caps = 4 }
    if caps > 32 { caps = 32 }
    var step: i64 = 0
    while step <= steps {
        sample(g, kind, vector.toFloat(step) / vector.toFloat(steps))
        const x = g.*.pointX + g.*.wayY * radius
        const y = g.*.pointY - g.*.wayX * radius
        if step == 0 { vector.moveTo(shape, x, y) } else { vector.lineTo(shape, x, y) }
        step += 1
    }
    if round {
        step = 1
        while step < caps {
            const angle = math.pi * vector.toFloat(step) / vector.toFloat(caps)
            const cosine = math.cos(angle)
            const sine = math.sin(angle)
            vector.lineTo(shape, g.*.pointX + (g.*.wayY * cosine + g.*.wayX * sine) * radius, g.*.pointY + (g.*.wayY * sine - g.*.wayX * cosine) * radius)
            step += 1
        }
    }
    step = steps
    while step >= 0 {
        sample(g, kind, vector.toFloat(step) / vector.toFloat(steps))
        vector.lineTo(shape, g.*.pointX - g.*.wayY * radius, g.*.pointY + g.*.wayX * radius)
        step -= 1
    }
    if round {
        step = 1
        while step < caps {
            const angle = math.pi * vector.toFloat(step) / vector.toFloat(caps)
            const cosine = math.cos(angle)
            const sine = math.sin(angle)
            vector.lineTo(shape, g.*.pointX - (g.*.wayY * cosine + g.*.wayX * sine) * radius, g.*.pointY - (g.*.wayY * sine - g.*.wayX * cosine) * radius)
            step += 1
        }
    }
    vector.close(shape)
    put(g)
}

// --- Circles

// Where one axis of a round figure goes: its centre (a place of the grid)
// and radius (units) in pixels, the radius a whole or a half number of
// pixels and the centre such that both ends lie on `lattice`; into g.fitX
// and g.fitR. Of the widths near the true one that is taken which moves
// the centre least: a figure in the middle of the grid stays there.
fn fitAxis(g: *Glyph, centre: f64, radius: f64, lattice: f64) -> void {
    fitBoth(g, centre, centre, radius, lattice)
}

// The same for a circle: one radius for both axes.
fn fit(g: *Glyph, cx: f64, cy: f64, radius: f64, lattice: f64) -> void {
    fitBoth(g, cx, cy, radius, lattice)
}

fn fitBoth(g: *Glyph, cx: f64, cy: f64, radius: f64, lattice: f64) -> void {
    const x = raw(g, cx)
    const y = raw(g, cy)
    const wide = 2.0 * radius * g.*.k
    if !g.*.snap {
        g.*.fitX = x
        g.*.fitY = y
        g.*.fitR = wide / 2.0
        return
    }
    var best: f64 = 1.0
    var least: f64 = 1000000.0
    var candidate = @floor(wide) - 1.0
    var tries: u32 = 0
    while tries < 4 {
        if candidate >= 1.0 {
            const phase = lattice + candidate / 2.0
            const off = math.absolute(snapAbout(x, g.*.middle, phase, true) - x) + math.absolute(snapAbout(y, g.*.middle, phase, true) - y)
            const cost = math.absolute(candidate - wide) + 1.5 * off
            // (Of two as good, the larger: the later.)
            if cost <= least + TIE {
                least = cost
                best = candidate
            }
        }
        candidate += 1.0
        tries += 1
    }
    g.*.fitR = best / 2.0
    g.*.fitX = snapAbout(x, g.*.middle, lattice + best / 2.0, true)
    g.*.fitY = snapAbout(y, g.*.middle, lattice + best / 2.0, true)
}

// A circle's outline.
fn circle(g: *Glyph, cx: f64, cy: f64, radius: f64) -> void {
    fit(g, cx, cy, radius, g.*.lattice)
    const half = g.*.stroke / 2.0
    vector.ellipse(shapeOf(g), g.*.fitX, g.*.fitY, g.*.fitR + half, g.*.fitR + half, false)
    if g.*.fitR > half { vector.ellipse(shapeOf(g), g.*.fitX, g.*.fitY, g.*.fitR - half, g.*.fitR - half, true) }
    put(g)
}

// An ellipse's outline.
fn ellipse(g: *Glyph, cx: f64, cy: f64, rx: f64, ry: f64) -> void {
    const half = g.*.stroke / 2.0
    fitAxis(g, cx, rx, g.*.lattice)
    const x = g.*.fitX
    const across = g.*.fitR
    fitAxis(g, cy, ry, g.*.lattice)
    vector.ellipse(shapeOf(g), x, g.*.fitX, across + half, g.*.fitR + half, false)
    if across > half && g.*.fitR > half { vector.ellipse(shapeOf(g), x, g.*.fitX, across - half, g.*.fitR - half, true) }
    put(g)
}

// A filled circle.
fn disc(g: *Glyph, cx: f64, cy: f64, radius: f64) -> void {
    fit(g, cx, cy, radius, 0.0)
    vector.circle(shapeOf(g), g.*.fitX, g.*.fitY, g.*.fitR)
    put(g)
}

// A part of an ellipse's outline from `first` to `last` degrees (0 to the
// right, 90 up), its ends round or cut straight.
fn sweep(g: *Glyph, cx: f64, cy: f64, rx: f64, ry: f64, first: f64, last: f64, round: bool) -> void {
    if rx == ry {
        fit(g, cx, cy, rx, g.*.lattice)
        g.*.path[0] = g.*.fitX
        g.*.path[1] = g.*.fitY
        g.*.path[2] = g.*.fitR
        g.*.path[3] = g.*.fitR
    } else {
        fitAxis(g, cx, rx, g.*.lattice)
        g.*.path[0] = g.*.fitX
        g.*.path[2] = g.*.fitR
        fitAxis(g, cy, ry, g.*.lattice)
        g.*.path[1] = g.*.fitX
        g.*.path[3] = g.*.fitR
    }
    g.*.path[4] = first * math.pi / 180.0
    g.*.path[5] = last * math.pi / 180.0
    const larger = if g.*.path[2] > g.*.path[3] { g.*.path[2] } else { g.*.path[3] }
    strokePath(g, ARC, stepsFor(math.absolute(g.*.path[5] - g.*.path[4]) * larger), g.*.stroke, round)
}

// A part of a circle's outline, its ends round.
fn arc(g: *Glyph, cx: f64, cy: f64, radius: f64, first: f64, last: f64) -> void {
    sweep(g, cx, cy, radius, radius, first, last, true)
}

// An arc with an arrow's head on its last end, its arms `arm` units long.
fn arrowArc(g: *Glyph, cx: f64, cy: f64, radius: f64, first: f64, last: f64, arm: f64) -> void {
    arc(g, cx, cy, radius, first, last)
    // sweep() left the arc in g.path: its end and the way it arrives.
    sample(g, ARC, 1.0)
    const x = g.*.pointX
    const y = g.*.pointY
    const wx = g.*.wayX
    const wy = g.*.wayY
    const reach = arm * g.*.k
    // The arms lie 40 degrees to each side of the way back.
    const along = 0.766 * reach
    const aside = 0.643 * reach
    capsule(g, x, y, x - wx * along - wy * aside, y - wy * along + wx * aside, g.*.stroke, true)
    capsule(g, x, y, x - wx * along + wy * aside, y - wy * along - wx * aside, g.*.stroke, true)
}

// --- Boxes

// A rectangle's outline with corners rounded by `radius`.
fn frame(g: *Glyph, x: f64, y: f64, width: f64, height: f64, radius: f64) -> void {
    const left = at(g, x)
    const top = at(g, y)
    const right = at(g, x + width)
    const bottom = at(g, y + height)
    const half = g.*.stroke / 2.0
    vector.roundedFrame(shapeOf(g), left - half, top - half, right - left + g.*.stroke, bottom - top + g.*.stroke, radius * g.*.k + half, g.*.stroke)
    put(g)
}

// A filled rectangle with corners rounded by `radius`, at least a pixel
// each way.
fn block(g: *Glyph, x: f64, y: f64, width: f64, height: f64, radius: f64) -> void {
    const left = edge(g, x)
    const top = edge(g, y)
    var right = edge(g, x + width)
    var bottom = edge(g, y + height)
    if right < left + 1.0 { right = left + 1.0 }
    if bottom < top + 1.0 { bottom = top + 1.0 }
    vector.roundedRect(shapeOf(g), left, top, right - left, bottom - top, radius * g.*.k)
    put(g)
}

// A knot: the small filled square on a point of a path. Its side is odd
// when the stroke's width is (and even when that is), so that it sits
// evenly on the stroke's middle line.
fn knot(g: *Glyph, cx: f64, cy: f64) -> void {
    const x = at(g, cx)
    const y = at(g, cy)
    var side = KNOT * g.*.k
    if g.*.snap {
        side = whole(side)
        const over = side - g.*.stroke
        if over - 2.0 * @floor(over / 2.0) > 0.5 { side += 1.0 }
        if side < g.*.stroke + 2.0 { side = g.*.stroke + 2.0 }
    }
    vector.rect(shapeOf(g), x - side / 2.0, y - side / 2.0, side, side)
    put(g)
}

// A line of any width (units) with round ends, where the grid says: a
// thick part of a picture (a pipette's bulb).
fn fat(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64, width: f64) -> void {
    capsule(g, raw(g, x0), raw(g, y0), raw(g, x1), raw(g, y1), width * g.*.k, true)
}

// The outline of such a line: a pill.
fn pill(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64, width: f64) -> void {
    const wide = width * g.*.k
    capsule(g, raw(g, x0), raw(g, y0), raw(g, x1), raw(g, y1), wide + g.*.stroke, true)
    const cut = g.*.cut
    g.*.cut = true
    if wide > g.*.stroke { capsule(g, raw(g, x0), raw(g, y0), raw(g, x1), raw(g, y1), wide - g.*.stroke, true) }
    g.*.cut = cut
}

// --- Filled paths

fn spot(g: *Glyph, value: f64) -> f64 {
    if !g.*.snap { return raw(g, value) }
    return snapAbout(raw(g, value), g.*.middle, g.*.fillLattice, true)
}

// The filled paths that follow continue strokes: their points lie where
// a stroke's would.
fn fillOnStrokes(g: *Glyph) -> void { g.*.fillLattice = g.*.lattice }
fn fillOnEdges(g: *Glyph) -> void { g.*.fillLattice = 0.0 }

fn fillFrom(g: *Glyph, x: f64, y: f64) -> void {
    g.*.penX = spot(g, x)
    g.*.penY = spot(g, y)
    g.*.movedX = g.*.penX - raw(g, x)
    g.*.movedY = g.*.penY - raw(g, y)
    vector.moveTo(shapeOf(g), g.*.penX, g.*.penY)
}

fn fillTo(g: *Glyph, x: f64, y: f64) -> void {
    g.*.penX = spot(g, x)
    g.*.penY = spot(g, y)
    g.*.movedX = g.*.penX - raw(g, x)
    g.*.movedY = g.*.penY - raw(g, y)
    vector.lineTo(shapeOf(g), g.*.penX, g.*.penY)
}

fn fillCurve(g: *Glyph, ax: f64, ay: f64, bx: f64, by: f64, x: f64, y: f64) -> void {
    const nx = spot(g, x)
    const ny = spot(g, y)
    const mx = nx - raw(g, x)
    const my = ny - raw(g, y)
    vector.cubicTo(shapeOf(g), raw(g, ax) + g.*.movedX, raw(g, ay) + g.*.movedY, raw(g, bx) + mx, raw(g, by) + my, nx, ny)
    g.*.penX = nx
    g.*.penY = ny
    g.*.movedX = mx
    g.*.movedY = my
}

// A quarter of an ellipse round the corner (cx, cy), as turn().
fn fillTurn(g: *Glyph, cx: f64, cy: f64, x: f64, y: f64) -> void {
    const k = g.*.k
    const x0 = (g.*.penX - g.*.movedX) / k
    const y0 = (g.*.penY - g.*.movedY) / k
    const kappa = 0.5522847498
    fillCurve(g, x0 + (cx - x0) * kappa, y0 + (cy - y0) * kappa, x + (cx - x) * kappa, y + (cy - y) * kappa, x, y)
}

// The path is closed and filled.
fn fill(g: *Glyph) -> void {
    vector.close(shapeOf(g))
    put(g)
}

// --- Cutting

// A round hole.
fn hole(g: *Glyph, cx: f64, cy: f64, radius: f64) -> void {
    const cut = g.*.cut
    g.*.cut = true
    disc(g, cx, cy, radius)
    g.*.cut = cut
}

// A rectangular hole.
fn window(g: *Glyph, x: f64, y: f64, width: f64, height: f64, radius: f64) -> void {
    const cut = g.*.cut
    g.*.cut = true
    block(g, x, y, width, height, radius)
    g.*.cut = cut
}

// A stroke with clear room beside it (a pixel at least, `room` units),
// cut through what is drawn: a strike through an eye.
fn strike(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64, room: f64) -> void {
    const ax = at(g, x0)
    const ay = at(g, y0)
    const bx = at(g, x1)
    const by = at(g, y1)
    g.*.cut = true
    capsule(g, ax, ay, bx, by, g.*.stroke + 2.0 * pixelsOf(g, room), true)
    g.*.cut = false
    capsule(g, ax, ay, bx, by, g.*.stroke, true)
}

// --- Dashes

// Dashes along one side of a box, from `first` to `last` (pixels) at
// `across`, lying (`level`) or standing; with `arms`, the side begins and
// ends with a corner's arm. The dashes' ends are whole pixels, laid out
// evenly about the side's middle.
fn dashedSpan(g: *Glyph, first: f64, last: f64, across: f64, level: bool, arms: bool) -> void {
    const length = last - first
    const arm = if arms { math.max(2.0, pixelsOf(g, 3.5)) } else { 0.0 }
    const dash = math.max(2.0, pixelsOf(g, 4.0))
    const gap = pixelsOf(g, 2.6)
    if length <= 2.0 * arm + gap {
        slab(g, first, last, across, level)
        return
    }
    if arms {
        slab(g, first, first + arm, across, level)
        slab(g, last - arm, last, across, level)
    }
    const room = length - 2.0 * arm
    const middle = (first + last) / 2.0
    if arms {
        // Dashes between the arms, a gap at each end.
        var pieces = @floor((room - gap) / (dash + gap) + 0.5)
        if pieces < 1.0 { pieces = 1.0 }
        var long = dash
        if pieces * long + (pieces + 1.0) * gap > room { long = (room - (pieces + 1.0) * gap) / pieces }
        if long < 1.0 { return }
        const between = (room - pieces * long) / (pieces + 1.0)
        var index: f64 = 0.0
        while index < pieces {
            const start = first + arm + between * (index + 1.0) + long * index
            slab(g, snapAbout(start, middle, 0.0, false), snapAbout(start + long, middle, 0.0, false), across, level)
            index += 1.0
        }
    } else {
        // A dash at each end.
        var pieces = @floor((room + gap) / (dash + gap) + 0.5)
        if pieces < 2.0 { pieces = 2.0 }
        const long = (room - (pieces - 1.0) * gap) / pieces
        if long < 1.0 {
            slab(g, first, last, across, level)
            return
        }
        var index: f64 = 0.0
        while index < pieces {
            const start = first + (long + gap) * index
            slab(g, snapAbout(start, middle, 0.0, true), snapAbout(start + long, middle, 0.0, false), across, level)
            index += 1.0
        }
    }
}

// One dash of a side: a rectangle a stroke wide (not yet put).
fn slab(g: *Glyph, first: f64, last: f64, across: f64, level: bool) -> void {
    if last <= first { return }
    if level {
        vector.rect(shapeOf(g), first, across, last - first, g.*.stroke)
    } else {
        vector.rect(shapeOf(g), across, first, g.*.stroke, last - first)
    }
}

// A dashed rectangle between two corners: a selection's outline.
fn marquee(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64) -> void {
    const half = g.*.stroke / 2.0
    const left = at(g, x0) - half
    const top = at(g, y0) - half
    const right = at(g, x1) + half
    const bottom = at(g, y1) + half
    dashedSpan(g, left, right, top, true, true)
    dashedSpan(g, left, right, bottom - g.*.stroke, true, true)
    dashedSpan(g, top, bottom, left, false, true)
    dashedSpan(g, top, bottom, right - g.*.stroke, false, true)
    put(g)
}

// A dashed line between two places; a level or an upright one has dashes
// of whole pixels.
fn dashes(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64) -> void {
    const ax = at(g, x0)
    const ay = at(g, y0)
    const bx = at(g, x1)
    const by = at(g, y1)
    const half = g.*.stroke / 2.0
    if g.*.snap && math.absolute(ay - by) < 0.001 {
        dashedSpan(g, math.min(ax, bx) - half, math.max(ax, bx) + half, ay - half, true, false)
        put(g)
        return
    }
    if g.*.snap && math.absolute(ax - bx) < 0.001 {
        dashedSpan(g, math.min(ay, by) - half, math.max(ay, by) + half, ax - half, false, false)
        put(g)
        return
    }
    const length = math.hypot(bx - ax, by - ay)
    if length < 0.001 { return }
    const dash = math.max(2.0, 3.6 * g.*.k)
    const gap = math.max(1.5, 2.8 * g.*.k)
    var pieces = @floor((length + gap) / (dash + gap) + 0.5)
    if pieces < 1.0 { pieces = 1.0 }
    const long = (length - (pieces - 1.0) * gap) / pieces
    if long < 0.5 {
        capsule(g, ax, ay, bx, by, g.*.stroke, false)
        return
    }
    const wx = (bx - ax) / length
    const wy = (by - ay) / length
    var index: f64 = 0.0
    while index < pieces {
        const start = (long + gap) * index
        capsule(g, ax + wx * start, ay + wy * start, ax + wx * (start + long), ay + wy * (start + long), g.*.stroke, false)
        index += 1.0
    }
}

// --- Arrows

// An arrow's head at (x, y) pointing the way (wx, wy) (a unit vector, on
// the grid): two strokes `arm` units long each way, at right angles.
fn head(g: *Glyph, x: f64, y: f64, wx: f64, wy: f64, arm: f64) -> void {
    line(g, x - (wx - wy) * arm, y - (wy + wx) * arm, x, y)
    line(g, x - (wx + wy) * arm, y - (wy - wx) * arm, x, y)
}

// ---------------------------------------------------------------------------
// From figures to pixels

// Draws `icon` into `pixels` (side x side, premultiplied) in `color`;
// false without memory for the work.
fn render(kept: *Cache, icon: u16, side: usize, color: u32, pixels: [*]u32) -> bool {
    const allocator = kept.*.allocator
    const cells = side * side
    const memory = allocator.alloc(cells * 2, 16)
    if memory == null { return false }
    const g: *Glyph = unsafe { @ptrCast(*Glyph, &kept.*.glyph) }
    if !vector.begin(shapeOf(g), side, side, allocator) {
        allocator.free(memory.?, cells * 2, 16)
        return false
    }
    g.*.cover = memory.?
    g.*.part = memory.? + cells
    g.*.side = side
    g.*.k = @floatFromInt(f64, side) / UNITS
    g.*.middle = @floatFromInt(f64, side) / 2.0
    g.*.snap = true
    g.*.cut = false
    g.*.tone = 255
    g.*.fillLattice = 0.0
    g.*.penX = 0.0
    g.*.penY = 0.0
    g.*.movedX = 0.0
    g.*.movedY = 0.0
    g.*.startX = 0.0
    g.*.startY = 0.0
    normal(g)
    var index: usize = 0
    while index < cells {
        g.*.cover[index] = 0
        index += 1
    }
    rows()[@intCast(usize, icon)].paint(g)
    const alpha = color >> 24
    const red = (color >> 16) & 255
    const green = (color >> 8) & 255
    const blue = color & 255
    index = 0
    while index < cells {
        const amount = @intCast(u32, g.*.cover[index])
        if amount == 255 {
            pixels[index] = color
        } else if amount == 0 {
            pixels[index] = 0
        } else {
            pixels[index] = (pixel.mul(alpha, amount) << 24) | (pixel.mul(red, amount) << 16) | (pixel.mul(green, amount) << 8) | pixel.mul(blue, amount)
        }
        index += 1
    }
    vector.end(shapeOf(g))
    allocator.free(memory.?, cells * 2, 16)
    return true
}

// ---------------------------------------------------------------------------
// The pictures, on the 24 x 24 grid. Strokes keep three units between
// their middle lines where they run side by side: less closes up at 16
// pixels.

// --- The toolbox

// A brush: a handle and a full head of bristles drawn to a point.
fn toolBrush(g: *Glyph) -> void {
    line(g, 20.0, 4.0, 13.0, 11.0)
    fillOnStrokes(g)
    fillFrom(g, 10.2, 10.2)
    fillTo(g, 13.8, 13.8)
    fillCurve(g, 13.8, 17.5, 10.5, 20.0, 4.0, 20.0)
    fillCurve(g, 6.5, 18.2, 6.2, 15.8, 6.8, 14.0)
    fillCurve(g, 7.4, 12.0, 8.8, 10.6, 10.2, 10.2)
    fill(g)
}

// An eraser: a block standing on its corner on the ground, a band round
// its middle.
fn toolEraser(g: *Glyph) -> void {
    from(g, 14.5, 4.0)
    to(g, 20.5, 10.0)
    to(g, 11.0, 19.5)
    to(g, 7.5, 19.5)
    to(g, 3.5, 15.0)
    shut(g)
    line(g, 9.0, 9.5, 15.0, 15.5)
    line(g, 11.0, 19.5, 20.5, 19.5)
}

fn toolLine(g: *Glyph) -> void {
    line(g, 5.0, 19.0, 19.0, 5.0)
    disc(g, 5.0, 19.0, 2.2)
    disc(g, 19.0, 5.0, 2.2)
}

fn toolRectangle(g: *Glyph) -> void {
    frame(g, 3.0, 6.0, 18.0, 12.0, 1.0)
}

fn toolEllipse(g: *Glyph) -> void {
    ellipse(g, 12.0, 12.0, 9.0, 6.5)
}

fn toolPolygon(g: *Glyph) -> void {
    from(g, 12.0, 3.5)
    to(g, 20.5, 9.8)
    to(g, 17.2, 19.5)
    to(g, 6.8, 19.5)
    to(g, 3.5, 9.8)
    shut(g)
}

// A line of several pieces, a point at each bend.
fn toolPolyline(g: *Glyph) -> void {
    from(g, 4.0, 18.0)
    to(g, 9.0, 7.0)
    to(g, 15.0, 15.0)
    to(g, 20.0, 5.0)
    disc(g, 4.0, 18.0, 2.0)
    disc(g, 9.0, 7.0, 2.0)
    disc(g, 15.0, 15.0, 2.0)
    disc(g, 20.0, 5.0, 2.0)
}

// A curve through a point with its two handles.
fn toolBezier(g: *Glyph) -> void {
    from(g, 4.0, 20.0)
    curve(g, 4.0, 12.0, 8.0, 7.0, 12.0, 7.0)
    curve(g, 16.0, 7.0, 20.0, 12.0, 20.0, 20.0)
    line(g, 4.5, 7.0, 19.5, 7.0)
    disc(g, 4.0, 7.0, 1.8)
    disc(g, 20.0, 7.0, 1.8)
    knot(g, 12.0, 7.0)
}

// A path drawn by hand: a loose wave between two points.
fn toolFreehandPath(g: *Glyph) -> void {
    from(g, 4.0, 16.0)
    curve(g, 6.0, 5.0, 10.0, 5.0, 12.0, 12.0)
    curve(g, 14.0, 19.0, 18.0, 19.0, 20.0, 8.0)
    knot(g, 4.0, 16.0)
    knot(g, 20.0, 8.0)
}

// A pen's nib, its slit and its hole.
fn toolCalligraphy(g: *Glyph) -> void {
    from(g, 12.0, 21.0)
    to(g, 6.5, 11.0)
    to(g, 9.0, 3.5)
    to(g, 15.0, 3.5)
    to(g, 17.5, 11.0)
    shut(g)
    line(g, 12.0, 20.0, 12.0, 13.5)
    disc(g, 12.0, 11.0, 1.7)
}

// A brush that swings behind the hand: a dab and the wavy way it came.
fn toolDynamicBrush(g: *Glyph) -> void {
    disc(g, 17.0, 7.0, 3.4)
    from(g, 14.0, 10.0)
    curve(g, 10.0, 10.0, 13.0, 15.0, 9.0, 15.0)
    curve(g, 5.5, 15.0, 7.5, 20.0, 3.5, 20.0)
}

// Several brushes at once: three strokes fanned out from one hand, a
// dab at the end of each.
fn toolMultibrush(g: *Glyph) -> void {
    line(g, 4.5, 19.5, 8.8, 8.0)
    line(g, 4.5, 19.5, 13.5, 10.5)
    line(g, 4.5, 19.5, 16.0, 15.2)
    disc(g, 9.5, 6.0, 2.2)
    disc(g, 15.0, 9.0, 2.2)
    disc(g, 18.0, 14.5, 2.2)
}

fn toolMove(g: *Glyph) -> void {
    line(g, 12.0, 3.0, 12.0, 21.0)
    line(g, 3.0, 12.0, 21.0, 12.0)
    head(g, 12.0, 3.0, 0.0, -1.0, 2.8)
    head(g, 12.0, 21.0, 0.0, 1.0, 2.8)
    head(g, 3.0, 12.0, -1.0, 0.0, 2.8)
    head(g, 21.0, 12.0, 1.0, 0.0, 2.8)
}

// A box with a handle on each corner.
fn toolTransform(g: *Glyph) -> void {
    frame(g, 5.0, 5.0, 14.0, 14.0, 0.0)
    knot(g, 5.0, 5.0)
    knot(g, 19.0, 5.0)
    knot(g, 5.0, 19.0)
    knot(g, 19.0, 19.0)
    disc(g, 12.0, 12.0, 1.4)
}

// The two angles of a cropping frame.
fn toolCrop(g: *Glyph) -> void {
    from(g, 7.0, 2.5)
    to(g, 7.0, 17.0)
    to(g, 21.5, 17.0)
    from(g, 2.5, 7.0)
    to(g, 17.0, 7.0)
    to(g, 17.0, 21.5)
}

// A box that fades from full to empty.
fn toolGradient(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.0)
    block(g, 6.0, 8.0, 4.0, 8.0, 0.0)
    g.*.tone = 150
    block(g, 10.0, 8.0, 4.0, 8.0, 0.0)
    g.*.tone = 70
    block(g, 14.0, 8.0, 4.0, 8.0, 0.0)
    g.*.tone = 255
}

// A drop: a point above a round belly.
fn drop(g: *Glyph, cx: f64, top: f64, bottom: f64, half: f64) -> void {
    const belly = bottom - half
    fillFrom(g, cx, top)
    fillCurve(g, cx + half * 0.5, top + (belly - top) * 0.45, cx + half, belly - half * 0.6, cx + half, belly)
    fillCurve(g, cx + half, belly + half * 0.55, cx + half * 0.55, bottom, cx, bottom)
    fillCurve(g, cx - half * 0.55, bottom, cx - half, belly + half * 0.55, cx - half, belly)
    fillCurve(g, cx - half, belly - half * 0.6, cx - half * 0.5, top + (belly - top) * 0.45, cx, top)
    fill(g)
}

// A tipped bucket, its handle over the opening, the paint's level in it
// and a drop falling from the rim.
fn toolFill(g: *Glyph) -> void {
    from(g, 9.5, 5.0)
    to(g, 17.0, 12.5)
    to(g, 10.5, 19.0)
    to(g, 3.0, 11.5)
    shut(g)
    line(g, 4.5, 12.5, 17.0, 12.5)
    arc(g, 13.25, 8.75, 4.0, 135.0, -45.0)
    drop(g, 19.5, 14.0, 20.5, 2.2)
}

// A closed outline and the paint that fills it.
fn toolEncloseFill(g: *Glyph) -> void {
    marquee(g, 3.0, 3.0, 21.0, 21.0)
    drop(g, 12.0, 6.5, 18.0, 4.0)
}

// A pipette: its glass tube drawn to a tip, a collar and the bulb.
fn toolColorSampler(g: *Glyph) -> void {
    from(g, 12.3, 9.0)
    to(g, 6.0, 15.3)
    to(g, 4.8, 19.2)
    to(g, 8.7, 18.0)
    to(g, 15.0, 11.7)
    line(g, 11.0, 7.5, 16.5, 13.0)
    fat(g, 15.2, 8.8, 17.4, 6.6, 5.0)
}

// A plaster over the flaw, and a spark for what it does by itself.
fn toolSmartPatch(g: *Glyph) -> void {
    pill(g, 7.5, 18.0, 18.0, 7.5, 8.0)
    line(g, 8.3, 11.3, 14.2, 17.2)
    line(g, 11.3, 8.3, 17.2, 14.2)
    line(g, 5.0, 3.0, 5.0, 8.0)
    line(g, 2.5, 5.5, 7.5, 5.5)
}

fn toolText(g: *Glyph) -> void {
    line(g, 5.0, 5.0, 19.0, 5.0)
    line(g, 12.0, 5.0, 12.0, 19.5)
    line(g, 5.0, 5.0, 5.0, 7.5)
    line(g, 19.0, 5.0, 19.0, 7.5)
    line(g, 9.5, 19.5, 14.5, 19.5)
}

// The pointer's arrow.
fn pointer(g: *Glyph, x: f64, y: f64) -> void {
    fillFrom(g, x, y)
    fillTo(g, x, y + 13.5)
    fillTo(g, x + 3.6, y + 10.2)
    fillTo(g, x + 6.0, y + 15.6)
    fillTo(g, x + 8.4, y + 14.5)
    fillTo(g, x + 6.0, y + 9.2)
    fillTo(g, x + 10.8, y + 9.2)
    fill(g)
}

// The pointer and a piece of a path with its points.
fn toolEditShapes(g: *Glyph) -> void {
    pointer(g, 3.5, 3.0)
    line(g, 19.0, 6.5, 19.0, 20.0)
    knot(g, 19.0, 6.0)
    knot(g, 19.0, 20.0)
}

// A magnifying glass, light on its lens.
fn toolZoom(g: *Glyph) -> void {
    circle(g, 10.5, 10.5, 7.0)
    line(g, 15.5, 15.5, 20.5, 20.5)
    arc(g, 10.5, 10.5, 3.5, 100.0, 170.0)
}

// An open hand.
fn toolPan(g: *Glyph) -> void {
    from(g, 7.0, 13.5)
    to(g, 7.0, 6.5)
    turn(g, 7.0, 5.0, 8.5, 5.0)
    turn(g, 10.0, 5.0, 10.0, 6.5)
    to(g, 10.0, 4.5)
    turn(g, 10.0, 3.0, 11.5, 3.0)
    turn(g, 13.0, 3.0, 13.0, 4.5)
    to(g, 13.0, 5.5)
    turn(g, 13.0, 4.0, 14.5, 4.0)
    turn(g, 16.0, 4.0, 16.0, 5.5)
    to(g, 16.0, 8.5)
    turn(g, 16.0, 7.0, 17.5, 7.0)
    turn(g, 19.0, 7.0, 19.0, 8.5)
    to(g, 19.0, 15.0)
    curve(g, 19.0, 19.0, 16.0, 21.5, 12.5, 21.5)
    curve(g, 9.5, 21.5, 8.0, 20.0, 6.5, 17.5)
    to(g, 3.6, 13.2)
    curve(g, 2.8, 12.0, 3.4, 11.0, 4.4, 10.7)
    curve(g, 5.2, 10.5, 5.8, 11.0, 6.2, 11.8)
    to(g, 7.0, 13.5)
    line(g, 10.0, 6.5, 10.0, 11.5)
    line(g, 13.0, 5.5, 13.0, 11.5)
    line(g, 16.0, 8.5, 16.0, 11.5)
}

// A ruler laid aslant, its marks along one edge.
fn toolMeasure(g: *Glyph) -> void {
    from(g, 3.0, 16.0)
    to(g, 16.0, 3.0)
    to(g, 21.0, 8.0)
    to(g, 8.0, 21.0)
    shut(g)
    line(g, 6.25, 12.75, 8.0, 14.5)
    line(g, 9.5, 9.5, 12.0, 12.0)
    line(g, 12.75, 6.25, 14.5, 8.0)
}

// A set square.
fn toolAssistant(g: *Glyph) -> void {
    from(g, 4.0, 3.5)
    to(g, 4.0, 20.0)
    to(g, 20.5, 20.0)
    shut(g)
    from(g, 8.0, 12.0)
    to(g, 8.0, 16.0)
    to(g, 12.0, 16.0)
    shut(g)
}

// A picture pinned up.
fn toolReference(g: *Glyph) -> void {
    frame(g, 3.0, 6.0, 18.0, 15.0, 2.0)
    from(g, 6.5, 17.5)
    to(g, 10.5, 12.5)
    to(g, 13.5, 16.0)
    to(g, 15.5, 14.0)
    to(g, 18.0, 17.5)
    hole(g, 17.5, 6.0, 4.6)
    disc(g, 17.5, 5.5, 2.8)
    line(g, 15.5, 7.5, 13.5, 9.5)
}

fn selectRectangle(g: *Glyph) -> void {
    marquee(g, 3.0, 5.0, 21.0, 19.0)
}

fn selectEllipse(g: *Glyph) -> void {
    var index: f64 = 0.0
    while index < 8.0 {
        sweep(g, 12.0, 12.0, 9.0, 7.0, index * 45.0 - 13.0, index * 45.0 + 13.0, false)
        index += 1.0
    }
}

// The two ends of a side, the middle left open: a many-cornered outline
// that keeps its corners whole.
fn ends(g: *Glyph, x0: f64, y0: f64, x1: f64, y1: f64) -> void {
    const ax = at(g, x0)
    const ay = at(g, y0)
    const bx = at(g, x1)
    const by = at(g, y1)
    const share = 0.3
    capsule(g, ax, ay, ax + (bx - ax) * share, ay + (by - ay) * share, g.*.stroke, true)
    capsule(g, bx, by, bx + (ax - bx) * share, by + (ay - by) * share, g.*.stroke, true)
}

fn selectPolygon(g: *Glyph) -> void {
    ends(g, 4.0, 9.5, 13.0, 3.5)
    ends(g, 13.0, 3.5, 20.5, 10.5)
    ends(g, 20.5, 10.5, 16.5, 20.0)
    ends(g, 16.5, 20.0, 6.0, 18.5)
    ends(g, 6.0, 18.5, 4.0, 9.5)
}

// A lasso: the loop and the rope's end.
fn selectFreehand(g: *Glyph) -> void {
    ellipse(g, 12.0, 9.0, 9.0, 5.5)
    from(g, 7.5, 13.8)
    curve(g, 5.0, 16.0, 10.0, 17.5, 6.5, 21.0)
}

// A wand and the spark at its tip.
fn selectContiguous(g: *Glyph) -> void {
    line(g, 4.0, 20.0, 13.5, 10.5)
    line(g, 16.5, 3.0, 16.5, 5.0)
    line(g, 16.5, 10.0, 16.5, 12.0)
    line(g, 12.0, 7.5, 14.0, 7.5)
    line(g, 19.0, 7.5, 21.0, 7.5)
}

// What is alike, selected together.
fn selectSimilar(g: *Glyph) -> void {
    marquee(g, 3.0, 3.0, 21.0, 21.0)
    disc(g, 9.0, 9.5, 2.6)
    disc(g, 15.0, 14.5, 2.6)
}

// A selection whose outline is a curve: a dashed dome, its point at the
// top with the handles that bend it.
fn selectBezier(g: *Glyph) -> void {
    sweep(g, 12.0, 20.0, 8.5, 11.0, 0.0, 22.0, false)
    sweep(g, 12.0, 20.0, 8.5, 11.0, 38.0, 62.0, false)
    sweep(g, 12.0, 20.0, 8.5, 11.0, 118.0, 142.0, false)
    sweep(g, 12.0, 20.0, 8.5, 11.0, 158.0, 180.0, false)
    dashes(g, 3.5, 20.0, 20.5, 20.0)
    line(g, 5.5, 9.0, 18.5, 9.0)
    disc(g, 4.5, 9.0, 1.8)
    disc(g, 19.5, 9.0, 1.8)
    knot(g, 12.0, 9.0)
}

// A horseshoe magnet around (cx, cy), `scale` of its full size: two legs,
// the bow that joins them, and a notch that parts each pole from its leg.
fn magnet(g: *Glyph, cx: f64, cy: f64, scale: f64) -> void {
    const outer = 6.0 * scale
    const inner = 2.0 * scale
    const top = cy - 7.5 * scale
    const bow = cy + 0.5 * scale
    fillFrom(g, cx - outer, top)
    fillTo(g, cx - inner, top)
    fillTo(g, cx - inner, bow)
    fillTurn(g, cx - inner, bow + inner, cx, bow + inner)
    fillTurn(g, cx + inner, bow + inner, cx + inner, bow)
    fillTo(g, cx + inner, top)
    fillTo(g, cx + outer, top)
    fillTo(g, cx + outer, bow)
    fillTurn(g, cx + outer, bow + outer, cx, bow + outer)
    fillTurn(g, cx - outer, bow + outer, cx - outer, bow)
    fill(g)
    window(g, cx - outer - 1.0, top + 2.6 * scale, 2.0 * outer + 2.0, 1.3 * scale, 0.0)
}

// A selection that clings to edges.
fn selectMagnetic(g: *Glyph) -> void {
    from(g, 3.0, 8.0)
    to(g, 3.0, 3.0)
    to(g, 8.0, 3.0)
    dashes(g, 11.0, 3.0, 20.0, 3.0)
    dashes(g, 3.0, 11.0, 3.0, 20.0)
    magnet(g, 14.5, 15.0, 0.75)
}

// --- Layers

// A plus (or a minus) at the lower right, with clear room round it: what
// the picture beside it is added to (or taken from).
fn badge(g: *Glyph, plus: bool) -> void {
    hole(g, 18.0, 18.0, 6.0)
    line(g, 14.5, 18.0, 21.5, 18.0)
    if plus { line(g, 18.0, 14.5, 18.0, 21.5) }
}

// A folder: its tab and its body.
fn folder(g: *Glyph) -> void {
    from(g, 3.0, 5.5)
    to(g, 8.5, 5.5)
    to(g, 10.5, 8.0)
    to(g, 21.0, 8.0)
    to(g, 21.0, 19.0)
    to(g, 3.0, 19.0)
    shut(g)
}

// A sheet of paper, a corner folded.
fn sheet(g: *Glyph) -> void {
    from(g, 6.0, 3.0)
    to(g, 14.0, 3.0)
    to(g, 19.0, 8.0)
    to(g, 19.0, 21.0)
    to(g, 6.0, 21.0)
    shut(g)
    from(g, 14.0, 3.0)
    to(g, 14.0, 8.0)
    to(g, 19.0, 8.0)
}

fn layerNew(g: *Glyph) -> void {
    frame(g, 3.0, 3.0, 15.0, 15.0, 2.0)
    badge(g, true)
}

fn layerNewGroup(g: *Glyph) -> void {
    folder(g)
    badge(g, true)
}

// A mask: a plate with a round opening.
fn layerNewMask(g: *Glyph) -> void {
    block(g, 3.0, 3.0, 16.0, 14.0, 2.5)
    hole(g, 10.0, 10.0, 3.6)
    badge(g, true)
}

// A layer and its copy before it.
fn layerDuplicate(g: *Glyph) -> void {
    frame(g, 8.0, 3.0, 13.0, 11.0, 2.0)
    window(g, 1.5, 8.0, 16.0, 14.5, 3.0)
    frame(g, 3.0, 9.5, 13.0, 11.0, 2.0)
    line(g, 9.5, 12.5, 9.5, 17.5)
    line(g, 7.0, 15.0, 12.0, 15.0)
}

// A bin.
fn layerDelete(g: *Glyph) -> void {
    line(g, 4.0, 6.5, 20.0, 6.5)
    from(g, 9.0, 6.5)
    to(g, 9.0, 3.5)
    to(g, 15.0, 3.5)
    to(g, 15.0, 6.5)
    from(g, 6.0, 6.5)
    to(g, 7.0, 20.5)
    to(g, 17.0, 20.5)
    to(g, 18.0, 6.5)
    line(g, 10.0, 10.5, 10.0, 16.5)
    line(g, 14.0, 10.5, 14.0, 16.5)
}

// A layer seen aslant (as the layers docker's are), its middle at
// (12, y).
fn plate(g: *Glyph, y: f64) -> void {
    from(g, 12.0, y - 3.5)
    to(g, 20.5, y)
    to(g, 12.0, y + 3.5)
    to(g, 3.5, y)
    shut(g)
}

// The layer and the way it moves: up, or down.
fn layerUp(g: *Glyph) -> void {
    plate(g, 17.5)
    line(g, 12.0, 11.0, 12.0, 3.0)
    head(g, 12.0, 3.0, 0.0, -1.0, 3.5)
}

fn layerDown(g: *Glyph) -> void {
    plate(g, 6.5)
    line(g, 12.0, 13.0, 12.0, 21.0)
    head(g, 12.0, 21.0, 0.0, 1.0, 3.5)
}

// One layer pressed onto the one below.
fn layerMergeDown(g: *Glyph) -> void {
    line(g, 4.0, 3.5, 20.0, 3.5)
    line(g, 12.0, 7.5, 12.0, 16.0)
    head(g, 12.0, 16.0, 0.0, 1.0, 3.2)
    line(g, 4.0, 20.5, 20.0, 20.5)
}

// A card with what it lists.
fn layerProperties(g: *Glyph) -> void {
    frame(g, 3.0, 3.0, 18.0, 18.0, 2.5)
    disc(g, 7.5, 8.0, 1.2)
    line(g, 11.0, 8.0, 16.5, 8.0)
    disc(g, 7.5, 12.0, 1.2)
    line(g, 11.0, 12.0, 16.5, 12.0)
    disc(g, 7.5, 16.0, 1.2)
    line(g, 11.0, 16.0, 16.5, 16.0)
}

// An eye.
fn eye(g: *Glyph) -> void {
    from(g, 2.5, 12.0)
    curve(g, 6.0, 6.0, 18.0, 6.0, 21.5, 12.0)
    curve(g, 18.0, 18.0, 6.0, 18.0, 2.5, 12.0)
    disc(g, 12.0, 12.0, 3.0)
}

fn visible(g: *Glyph) -> void {
    eye(g)
}

fn hidden(g: *Glyph) -> void {
    eye(g)
    strike(g, 4.5, 4.5, 19.5, 19.5, 1.3)
}

// A padlock, its shackle in the body or swung out of it.
fn padlock(g: *Glyph, open: bool) -> void {
    if open {
        from(g, 8.0, 11.0)
        to(g, 8.0, 7.0)
        turn(g, 8.0, 3.0, 12.0, 3.0)
        turn(g, 16.0, 3.0, 16.0, 7.0)
    } else {
        from(g, 8.0, 11.0)
        to(g, 8.0, 8.5)
        turn(g, 8.0, 4.5, 12.0, 4.5)
        turn(g, 16.0, 4.5, 16.0, 8.5)
        to(g, 16.0, 11.0)
    }
    frame(g, 5.0, 11.0, 14.0, 10.0, 2.0)
    disc(g, 12.0, 16.0, 1.8)
}

fn locked(g: *Glyph) -> void { padlock(g, false) }
fn unlocked(g: *Glyph) -> void { padlock(g, true) }

// A small padlock at the lower right, clear room round it.
fn smallLock(g: *Glyph) -> void {
    window(g, 12.0, 10.5, 12.0, 13.5, 2.0)
    from(g, 15.0, 16.0)
    to(g, 15.0, 14.5)
    turn(g, 15.0, 12.0, 17.5, 12.0)
    turn(g, 20.0, 12.0, 20.0, 14.5)
    to(g, 20.0, 16.0)
    block(g, 13.5, 15.5, 8.0, 6.5, 1.5)
}

// The checks that stand for what is see-through, locked.
fn alphaLocked(g: *Glyph) -> void {
    frame(g, 3.0, 3.0, 14.0, 14.0, 1.5)
    block(g, 5.5, 5.5, 4.5, 4.5, 0.0)
    block(g, 10.0, 10.0, 4.5, 4.5, 0.0)
    smallLock(g)
}

// The letter alpha, `scale` of twelve units, its upper left at (x, y).
fn alpha(g: *Glyph, x: f64, y: f64, scale: f64) -> void {
    from(g, x + 12.0 * scale, y)
    curve(g, x + 10.0 * scale, y + 6.5 * scale, x + 7.5 * scale, y + 12.0 * scale, x + 4.0 * scale, y + 12.0 * scale)
    curve(g, x + 1.3 * scale, y + 12.0 * scale, x, y + 9.3 * scale, x, y + 6.0 * scale)
    curve(g, x, y + 2.7 * scale, x + 1.3 * scale, y, x + 4.0 * scale, y)
    curve(g, x + 7.5 * scale, y, x + 10.0 * scale, y + 5.5 * scale, x + 12.0 * scale, y + 12.0 * scale)
}

// Alpha taken from below.
fn inheritAlpha(g: *Glyph) -> void {
    alpha(g, 2.5, 6.5, 0.9)
    line(g, 19.5, 5.0, 19.5, 18.5)
    head(g, 19.5, 18.5, 0.0, 1.0, 2.6)
}

// What is below shows through the group as it is.
fn passThrough(g: *Glyph) -> void {
    from(g, 12.0, 7.5)
    to(g, 20.5, 12.0)
    to(g, 12.0, 16.5)
    to(g, 3.5, 12.0)
    shut(g)
    strike(g, 12.0, 3.0, 12.0, 21.0, 1.3)
    head(g, 12.0, 21.0, 0.0, 1.0, 3.0)
}

fn kindPaint(g: *Glyph) -> void {
    frame(g, 3.0, 4.0, 18.0, 16.0, 2.0)
    from(g, 7.0, 15.5)
    curve(g, 9.0, 7.0, 12.5, 17.5, 17.0, 9.0)
}

fn kindGroup(g: *Glyph) -> void {
    folder(g)
    line(g, 7.0, 12.0, 17.0, 12.0)
    line(g, 7.0, 15.5, 17.0, 15.5)
}

fn kindFill(g: *Glyph) -> void {
    frame(g, 3.0, 4.0, 18.0, 16.0, 2.0)
    block(g, 6.0, 7.0, 12.0, 10.0, 0.5)
}

// A disc half dark: what changes the look of what lies below.
fn kindFilter(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 8.0)
    fillOnStrokes(g)
    fillFrom(g, 12.0, 4.0)
    fillTurn(g, 20.0, 4.0, 20.0, 12.0)
    fillTurn(g, 20.0, 20.0, 12.0, 20.0)
    fill(g)
}

// A stamp.
fn kindClone(g: *Glyph) -> void {
    circle(g, 12.0, 6.5, 3.5)
    line(g, 10.5, 10.0, 9.5, 14.0)
    line(g, 13.5, 10.0, 14.5, 14.0)
    frame(g, 4.0, 14.0, 16.0, 4.0, 1.5)
    line(g, 5.0, 21.0, 19.0, 21.0)
}

// A shape and the points that make it.
fn kindVector(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 8.0)
    knot(g, 12.0, 4.0)
    knot(g, 20.0, 12.0)
    knot(g, 12.0, 20.0)
    knot(g, 4.0, 12.0)
}

// A sheet that points to a file elsewhere.
fn kindFile(g: *Glyph) -> void {
    sheet(g)
    line(g, 9.5, 17.5, 15.0, 12.0)
    from(g, 11.0, 12.0)
    to(g, 15.0, 12.0)
    to(g, 15.0, 16.0)
}

fn maskTransparency(g: *Glyph) -> void {
    block(g, 3.0, 5.0, 18.0, 14.0, 2.5)
    hole(g, 12.0, 12.0, 4.2)
}

fn maskFilter(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.5)
    circle(g, 12.0, 12.0, 3.5)
    fillOnStrokes(g)
    fillFrom(g, 12.0, 8.5)
    fillTurn(g, 15.5, 8.5, 15.5, 12.0)
    fillTurn(g, 15.5, 15.5, 12.0, 15.5)
    fill(g)
}

fn maskColorize(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.5)
    drop(g, 12.0, 7.5, 16.5, 3.2)
}

fn maskTransform(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.5)
    line(g, 8.5, 15.5, 15.5, 8.5)
    from(g, 12.0, 8.5)
    to(g, 15.5, 8.5)
    to(g, 15.5, 12.0)
    from(g, 8.5, 12.0)
    to(g, 8.5, 15.5)
    to(g, 12.0, 15.5)
}

fn maskSelection(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.5)
    sweep(g, 12.0, 12.0, 4.0, 4.0, 20.0, 70.0, false)
    sweep(g, 12.0, 12.0, 4.0, 4.0, 110.0, 160.0, false)
    sweep(g, 12.0, 12.0, 4.0, 4.0, 200.0, 250.0, false)
    sweep(g, 12.0, 12.0, 4.0, 4.0, 290.0, 340.0, false)
}

// --- Files and editing

fn fileNew(g: *Glyph) -> void {
    sheet(g)
    line(g, 12.5, 11.5, 12.5, 17.5)
    line(g, 9.5, 14.5, 15.5, 14.5)
}

// An open folder.
fn fileOpen(g: *Glyph) -> void {
    from(g, 3.0, 18.5)
    to(g, 3.0, 5.5)
    to(g, 8.5, 5.5)
    to(g, 10.5, 8.0)
    to(g, 18.5, 8.0)
    to(g, 18.5, 10.5)
    from(g, 3.0, 18.5)
    to(g, 6.5, 10.5)
    to(g, 21.5, 10.5)
    to(g, 18.0, 18.5)
    shut(g)
}

// A disk: its shutter above, its label below.
fn disk(g: *Glyph) -> void {
    from(g, 4.0, 4.0)
    to(g, 16.5, 4.0)
    to(g, 20.0, 7.5)
    to(g, 20.0, 20.0)
    to(g, 4.0, 20.0)
    shut(g)
    from(g, 8.0, 4.0)
    to(g, 8.0, 8.5)
    to(g, 14.5, 8.5)
    to(g, 14.5, 4.0)
    from(g, 7.5, 20.0)
    to(g, 7.5, 13.5)
    to(g, 16.5, 13.5)
    to(g, 16.5, 20.0)
}

fn fileSave(g: *Glyph) -> void {
    disk(g)
}

// A disk and the pen that names it anew.
fn fileSaveAs(g: *Glyph) -> void {
    disk(g)
    g.*.cut = true
    fat(g, 13.0, 22.5, 22.5, 13.0, 7.5)
    g.*.cut = false
    g.*.snap = false
    fat(g, 16.6, 18.9, 20.6, 14.9, 3.4)
    fillFrom(g, 12.6, 22.9)
    fillTo(g, 13.8, 19.2)
    fillTo(g, 16.3, 21.7)
    fill(g)
    g.*.snap = true
}

// Out of the tray.
fn fileExport(g: *Glyph) -> void {
    from(g, 4.0, 14.0)
    to(g, 4.0, 20.0)
    to(g, 20.0, 20.0)
    to(g, 20.0, 14.0)
    line(g, 12.0, 15.5, 12.0, 4.0)
    head(g, 12.0, 4.0, 0.0, -1.0, 3.5)
}

fn undo(g: *Glyph) -> void {
    from(g, 4.5, 9.0)
    to(g, 14.5, 9.0)
    turn(g, 19.5, 9.0, 19.5, 14.0)
    turn(g, 19.5, 19.0, 14.5, 19.0)
    to(g, 9.0, 19.0)
    head(g, 4.5, 9.0, -1.0, 0.0, 3.5)
}

fn redo(g: *Glyph) -> void {
    from(g, 19.5, 9.0)
    to(g, 9.5, 9.0)
    turn(g, 4.5, 9.0, 4.5, 14.0)
    turn(g, 4.5, 19.0, 9.5, 19.0)
    to(g, 15.0, 19.0)
    head(g, 19.5, 9.0, 1.0, 0.0, 3.5)
}

// Scissors.
fn cutOut(g: *Glyph) -> void {
    circle(g, 6.5, 17.5, 2.5)
    circle(g, 17.5, 17.5, 2.5)
    line(g, 8.3, 15.5, 18.5, 4.0)
    line(g, 15.7, 15.5, 5.5, 4.0)
}

// Two sheets, one before the other.
fn copyOut(g: *Glyph) -> void {
    frame(g, 8.5, 3.0, 12.0, 13.5, 2.0)
    window(g, 2.0, 6.0, 15.0, 17.0, 3.0)
    frame(g, 3.5, 7.5, 12.0, 13.5, 2.0)
}

// A clipboard.
fn paste(g: *Glyph) -> void {
    frame(g, 5.0, 5.0, 14.0, 16.0, 2.0)
    window(g, 8.0, 2.0, 8.0, 6.5, 1.5)
    block(g, 9.0, 3.0, 6.0, 4.5, 1.2)
    line(g, 8.5, 12.0, 15.5, 12.0)
    line(g, 8.5, 16.0, 15.5, 16.0)
}

// The key that takes away.
fn clear(g: *Glyph) -> void {
    from(g, 8.0, 5.0)
    to(g, 21.0, 5.0)
    to(g, 21.0, 19.0)
    to(g, 8.0, 19.0)
    to(g, 2.5, 12.0)
    shut(g)
    line(g, 11.5, 9.0, 17.5, 15.0)
    line(g, 17.5, 9.0, 11.5, 15.0)
}

// --- The view

fn lens(g: *Glyph) -> void {
    circle(g, 10.5, 10.5, 7.0)
    line(g, 15.5, 15.5, 20.5, 20.5)
}

fn zoomIn(g: *Glyph) -> void {
    lens(g)
    line(g, 7.5, 10.5, 13.5, 10.5)
    line(g, 10.5, 7.5, 10.5, 13.5)
}

fn zoomOut(g: *Glyph) -> void {
    lens(g)
    line(g, 7.5, 10.5, 13.5, 10.5)
}

// The picture as wide as the window.
fn zoomFit(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.0)
    line(g, 7.5, 12.0, 16.5, 12.0)
    from(g, 10.0, 9.5)
    to(g, 7.5, 12.0)
    to(g, 10.0, 14.5)
    from(g, 14.0, 9.5)
    to(g, 16.5, 12.0)
    to(g, 14.0, 14.5)
}

// One to one.
fn zoomActual(g: *Glyph) -> void {
    from(g, 5.0, 8.0)
    to(g, 7.5, 6.0)
    to(g, 7.5, 18.0)
    disc(g, 12.0, 9.5, 1.4)
    disc(g, 12.0, 15.0, 1.4)
    from(g, 15.0, 8.0)
    to(g, 17.5, 6.0)
    to(g, 17.5, 18.0)
}

fn rotateLeft(g: *Glyph) -> void {
    arrowArc(g, 12.0, 12.0, 8.0, -50.0, 190.0, 4.5)
}

fn rotateRight(g: *Glyph) -> void {
    arrowArc(g, 12.0, 12.0, 8.0, 230.0, -10.0, 4.5)
}

// The turn undone.
fn rotateReset(g: *Glyph) -> void {
    arrowArc(g, 12.0, 12.0, 8.0, -50.0, 190.0, 4.5)
    line(g, 9.5, 9.5, 14.5, 14.5)
    line(g, 14.5, 9.5, 9.5, 14.5)
}

// The view turned over its upright axis.
fn mirrorView(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.0)
    dashes(g, 12.0, 2.0, 12.0, 22.0)
    fillFrom(g, 9.5, 9.0)
    fillTo(g, 9.5, 15.0)
    fillTo(g, 6.0, 12.0)
    fill(g)
    fillFrom(g, 14.5, 9.0)
    fillTo(g, 14.5, 15.0)
    fillTo(g, 18.0, 12.0)
    fill(g)
}

fn grid(g: *Glyph) -> void {
    frame(g, 3.0, 3.0, 18.0, 18.0, 1.5)
    line(g, 9.0, 3.0, 9.0, 21.0)
    line(g, 15.0, 3.0, 15.0, 21.0)
    line(g, 3.0, 9.0, 21.0, 9.0)
    line(g, 3.0, 15.0, 21.0, 15.0)
}

// The rulers along the top and the left.
fn rulers(g: *Glyph) -> void {
    from(g, 3.0, 3.0)
    to(g, 21.0, 3.0)
    to(g, 21.0, 8.5)
    to(g, 8.5, 8.5)
    to(g, 8.5, 21.0)
    to(g, 3.0, 21.0)
    shut(g)
    line(g, 12.5, 3.0, 12.5, 5.5)
    line(g, 16.5, 3.0, 16.5, 5.5)
    line(g, 3.0, 12.5, 5.5, 12.5)
    line(g, 3.0, 16.5, 5.5, 16.5)
}

// Two guides and what lies against them.
fn guides(g: *Glyph) -> void {
    line(g, 2.5, 7.5, 21.5, 7.5)
    line(g, 7.5, 2.5, 7.5, 21.5)
    frame(g, 11.5, 11.5, 8.5, 8.5, 1.0)
}

fn snapTo(g: *Glyph) -> void {
    magnet(g, 12.0, 12.0, 1.0)
}

// The picture and where it goes on at each side.
fn wrapAround(g: *Glyph) -> void {
    frame(g, 8.0, 8.0, 8.0, 8.0, 1.0)
    line(g, 9.0, 3.5, 15.0, 3.5)
    line(g, 9.0, 20.5, 15.0, 20.5)
    line(g, 3.5, 9.0, 3.5, 15.0)
    line(g, 20.5, 9.0, 20.5, 15.0)
}

// The four corners of the whole screen.
fn canvasOnly(g: *Glyph) -> void {
    from(g, 4.0, 9.0)
    to(g, 4.0, 4.0)
    to(g, 9.0, 4.0)
    from(g, 15.0, 4.0)
    to(g, 20.0, 4.0)
    to(g, 20.0, 9.0)
    from(g, 20.0, 15.0)
    to(g, 20.0, 20.0)
    to(g, 15.0, 20.0)
    from(g, 9.0, 20.0)
    to(g, 4.0, 20.0)
    to(g, 4.0, 15.0)
}

// --- The brush bar

// Four tips: a hard one, a soft one, a small one, a square one.
fn brushPresets(g: *Glyph) -> void {
    disc(g, 7.5, 7.5, 3.8)
    g.*.tone = 110
    disc(g, 16.5, 7.5, 3.8)
    g.*.tone = 255
    disc(g, 7.5, 16.5, 2.2)
    fillFrom(g, 16.5, 12.5)
    fillTo(g, 20.5, 16.5)
    fillTo(g, 16.5, 20.5)
    fillTo(g, 12.5, 16.5)
    fill(g)
}

// An upright slider, its knob at `at_y`.
fn sliderUp(g: *Glyph, x: f64, knob: f64) -> void {
    line(g, x, 3.5, x, 20.5)
    window(g, x - 3.5, knob - 2.5, 7.0, 5.0, 0.0)
    block(g, x - 2.5, knob - 1.5, 5.0, 3.0, 1.0)
}

fn brushSettings(g: *Glyph) -> void {
    sliderUp(g, 5.5, 15.0)
    sliderUp(g, 12.0, 8.0)
    sliderUp(g, 18.5, 13.0)
}

// The eraser, its working end dark.
fn eraserMode(g: *Glyph) -> void {
    fillOnStrokes(g)
    fillFrom(g, 9.0, 9.5)
    fillTo(g, 15.0, 15.5)
    fillTo(g, 11.0, 19.5)
    fillTo(g, 7.5, 19.5)
    fillTo(g, 3.5, 15.0)
    fill(g)
    from(g, 14.5, 4.0)
    to(g, 20.5, 10.0)
    to(g, 11.0, 19.5)
    to(g, 7.5, 19.5)
    to(g, 3.5, 15.0)
    shut(g)
}

fn preserveAlpha(g: *Glyph) -> void {
    alpha(g, 3.0, 3.5, 0.95)
    smallLock(g)
}

// What is drawn on one side is drawn on the other.
fn mirrorHorizontal(g: *Glyph) -> void {
    line(g, 12.0, 3.0, 12.0, 21.0)
    from(g, 8.5, 6.0)
    curve(g, 3.5, 8.5, 3.5, 15.5, 8.5, 18.0)
    from(g, 15.5, 6.0)
    curve(g, 20.5, 8.5, 20.5, 15.5, 15.5, 18.0)
}

fn mirrorVertical(g: *Glyph) -> void {
    line(g, 3.0, 12.0, 21.0, 12.0)
    from(g, 6.0, 8.5)
    curve(g, 8.5, 3.5, 15.5, 3.5, 18.0, 8.5)
    from(g, 6.0, 15.5)
    curve(g, 8.5, 20.5, 15.5, 20.5, 18.0, 15.5)
}

// A disc of checks: how much shows through.
fn opacity(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 8.0)
    fillOnStrokes(g)
    fillFrom(g, 12.0, 12.0)
    fillTo(g, 12.0, 4.0)
    fillTurn(g, 4.0, 4.0, 4.0, 12.0)
    fill(g)
    fillFrom(g, 12.0, 12.0)
    fillTo(g, 12.0, 20.0)
    fillTurn(g, 20.0, 20.0, 20.0, 12.0)
    fill(g)
}

// A drop: how much paint comes.
fn flow(g: *Glyph) -> void {
    from(g, 12.0, 3.5)
    curve(g, 14.5, 7.0, 18.5, 11.0, 18.5, 14.5)
    curve(g, 18.5, 18.0, 15.6, 20.5, 12.0, 20.5)
    curve(g, 8.4, 20.5, 5.5, 18.0, 5.5, 14.5)
    curve(g, 5.5, 11.0, 9.5, 7.0, 12.0, 3.5)
    from(g, 9.0, 14.5)
    curve(g, 9.0, 16.2, 10.2, 17.5, 12.0, 17.5)
}

// Three tips, small to large, on one line.
fn brushSize(g: *Glyph) -> void {
    disc(g, 4.0, 12.0, 1.5)
    disc(g, 9.5, 12.0, 2.5)
    disc(g, 17.0, 12.0, 4.5)
}

// Two discs and what they make where they lie over each other.
fn blendMode(g: *Glyph) -> void {
    circle(g, 9.0, 12.0, 6.0)
    circle(g, 15.0, 12.0, 6.0)
    fillOnStrokes(g)
    fillFrom(g, 12.0, 7.0)
    fillCurve(g, 14.0, 8.2, 15.0, 10.0, 15.0, 12.0)
    fillCurve(g, 15.0, 14.0, 14.0, 15.8, 12.0, 17.0)
    fillCurve(g, 10.0, 15.8, 9.0, 14.0, 9.0, 12.0)
    fillCurve(g, 9.0, 10.0, 10.0, 8.2, 12.0, 7.0)
    fill(g)
}

// A pen pressed down.
fn pressure(g: *Glyph) -> void {
    from(g, 9.0, 3.0)
    to(g, 9.0, 11.0)
    to(g, 12.0, 16.0)
    to(g, 15.0, 11.0)
    to(g, 15.0, 3.0)
    arc(g, 12.0, 13.5, 7.5, 215.0, 325.0)
}

// --- Colours

fn colorSwap(g: *Glyph) -> void {
    from(g, 7.0, 18.0)
    to(g, 7.0, 10.0)
    turn(g, 7.0, 7.0, 10.0, 7.0)
    to(g, 18.0, 7.0)
    head(g, 7.0, 18.0, 0.0, 1.0, 3.0)
    head(g, 18.0, 7.0, 1.0, 0.0, 3.0)
}

// Black before white.
fn colorReset(g: *Glyph) -> void {
    frame(g, 9.5, 9.5, 11.0, 11.0, 1.5)
    window(g, 2.5, 2.5, 13.0, 13.0, 2.0)
    block(g, 3.5, 3.5, 11.0, 11.0, 1.5)
}

// The ring of hues and the triangle in it.
fn colorWheel(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 9.0)
    from(g, 12.0, 7.0)
    to(g, 16.3, 14.5)
    to(g, 7.7, 14.5)
    shut(g)
}

// A painter's palette.
fn palette(g: *Glyph) -> void {
    from(g, 12.0, 3.0)
    curve(g, 6.5, 3.0, 3.0, 7.0, 3.0, 12.0)
    curve(g, 3.0, 17.0, 7.0, 21.0, 12.0, 21.0)
    curve(g, 13.5, 21.0, 14.5, 20.0, 14.5, 18.7)
    curve(g, 14.5, 17.5, 13.5, 17.0, 13.5, 15.8)
    curve(g, 13.5, 14.6, 14.5, 14.0, 15.8, 14.0)
    to(g, 18.0, 14.0)
    curve(g, 19.7, 14.0, 21.0, 12.8, 21.0, 11.0)
    curve(g, 21.0, 6.5, 17.0, 3.0, 12.0, 3.0)
    disc(g, 7.5, 11.5, 1.5)
    disc(g, 10.5, 7.5, 1.5)
    disc(g, 15.5, 7.5, 1.5)
}

fn gradient(g: *Glyph) -> void {
    block(g, 3.0, 6.0, 4.5, 12.0, 1.0)
    g.*.tone = 170
    block(g, 8.5, 6.0, 4.0, 12.0, 1.0)
    g.*.tone = 110
    block(g, 13.5, 6.0, 3.5, 12.0, 1.0)
    g.*.tone = 60
    block(g, 18.0, 6.0, 3.0, 12.0, 1.0)
    g.*.tone = 255
}

fn pattern(g: *Glyph) -> void {
    disc(g, 6.0, 6.0, 1.8)
    disc(g, 12.0, 6.0, 1.8)
    disc(g, 18.0, 6.0, 1.8)
    disc(g, 9.0, 12.0, 1.8)
    disc(g, 15.0, 12.0, 1.8)
    disc(g, 6.0, 18.0, 1.8)
    disc(g, 12.0, 18.0, 1.8)
    disc(g, 18.0, 18.0, 1.8)
}

// --- The dockers and the animation's buttons

fn dockerLayers(g: *Glyph) -> void {
    from(g, 12.0, 3.0)
    to(g, 21.0, 7.5)
    to(g, 12.0, 12.0)
    to(g, 3.0, 7.5)
    shut(g)
    from(g, 3.0, 12.0)
    to(g, 12.0, 16.5)
    to(g, 21.0, 12.0)
    from(g, 3.0, 16.5)
    to(g, 12.0, 21.0)
    to(g, 21.0, 16.5)
}

// A level slider, its knob at `knob`.
fn sliderLevel(g: *Glyph, y: f64, knob: f64) -> void {
    line(g, 3.5, y, 20.5, y)
    hole(g, knob, y, 3.4)
    disc(g, knob, y, 2.4)
}

fn dockerToolOptions(g: *Glyph) -> void {
    sliderLevel(g, 6.0, 9.0)
    sliderLevel(g, 12.0, 15.5)
    sliderLevel(g, 18.0, 7.5)
}

// The ring of hues and the square in it.
fn dockerColor(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 9.0)
    frame(g, 8.5, 8.5, 7.0, 7.0, 0.5)
}

// A clock that runs back.
fn dockerHistory(g: *Glyph) -> void {
    arrowArc(g, 12.0, 12.0, 8.0, -60.0, 190.0, 4.0)
    from(g, 12.0, 7.5)
    to(g, 12.0, 12.0)
    to(g, 15.0, 14.0)
}

// The picture and the part of it the window shows.
fn dockerOverview(g: *Glyph) -> void {
    frame(g, 3.0, 4.0, 18.0, 16.0, 2.0)
    block(g, 8.0, 9.0, 8.0, 6.0, 1.0)
}

fn dockerChannels(g: *Glyph) -> void {
    circle(g, 12.0, 8.0, 5.0)
    circle(g, 7.5, 15.5, 5.0)
    circle(g, 16.5, 15.5, 5.0)
}

fn dockerHistogram(g: *Glyph) -> void {
    fillFrom(g, 3.0, 20.5)
    fillTo(g, 3.0, 17.0)
    fillCurve(g, 6.0, 17.0, 6.0, 8.0, 9.0, 8.0)
    fillCurve(g, 11.0, 8.0, 11.0, 14.0, 13.0, 14.0)
    fillCurve(g, 15.0, 14.0, 15.0, 4.5, 17.5, 4.5)
    fillCurve(g, 19.5, 4.5, 19.5, 17.0, 21.0, 18.0)
    fillTo(g, 21.0, 20.5)
    fill(g)
}

// A strip of film.
fn dockerAnimation(g: *Glyph) -> void {
    frame(g, 3.0, 5.0, 18.0, 14.0, 2.0)
    line(g, 7.5, 5.0, 7.5, 19.0)
    line(g, 16.5, 5.0, 16.5, 19.0)
    line(g, 3.0, 9.5, 7.5, 9.5)
    line(g, 3.0, 14.5, 7.5, 14.5)
    line(g, 16.5, 9.5, 21.0, 9.5)
    line(g, 16.5, 14.5, 21.0, 14.5)
}

fn triangle(g: *Glyph, ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> void {
    fillFrom(g, ax, ay)
    fillTo(g, bx, by)
    fillTo(g, cx, cy)
    fill(g)
}

fn play(g: *Glyph) -> void {
    triangle(g, 8.0, 5.0, 19.0, 12.0, 8.0, 19.0)
}

fn pause(g: *Glyph) -> void {
    block(g, 6.5, 5.0, 4.0, 14.0, 1.0)
    block(g, 13.5, 5.0, 4.0, 14.0, 1.0)
}

fn stop(g: *Glyph) -> void {
    block(g, 6.0, 6.0, 12.0, 12.0, 1.5)
}

fn framePrevious(g: *Glyph) -> void {
    block(g, 6.0, 6.0, 2.5, 12.0, 0.5)
    triangle(g, 18.0, 6.0, 18.0, 18.0, 9.5, 12.0)
}

fn frameNext(g: *Glyph) -> void {
    block(g, 15.5, 6.0, 2.5, 12.0, 0.5)
    triangle(g, 6.0, 6.0, 6.0, 18.0, 14.5, 12.0)
}

fn frameFirst(g: *Glyph) -> void {
    block(g, 3.5, 6.0, 2.5, 12.0, 0.5)
    triangle(g, 13.5, 6.0, 13.5, 18.0, 7.0, 12.0)
    triangle(g, 20.5, 6.0, 20.5, 18.0, 14.0, 12.0)
}

fn frameLast(g: *Glyph) -> void {
    block(g, 18.0, 6.0, 2.5, 12.0, 0.5)
    triangle(g, 10.5, 6.0, 10.5, 18.0, 17.0, 12.0)
    triangle(g, 3.5, 6.0, 3.5, 18.0, 10.0, 12.0)
}

// A frame and the paler ones before it.
fn onionSkin(g: *Glyph) -> void {
    g.*.tone = 70
    block(g, 3.0, 6.0, 10.0, 12.0, 2.0)
    g.*.tone = 140
    block(g, 7.0, 6.0, 10.0, 12.0, 2.0)
    g.*.tone = 255
    block(g, 11.0, 6.0, 10.0, 12.0, 2.0)
}

// One frame of a film.
fn filmFrame(g: *Glyph) -> void {
    frame(g, 3.0, 3.0, 15.0, 15.0, 2.0)
    line(g, 7.5, 3.0, 7.5, 18.0)
    line(g, 3.0, 8.0, 7.5, 8.0)
    line(g, 3.0, 13.0, 7.5, 13.0)
}

fn frameAdd(g: *Glyph) -> void {
    filmFrame(g)
    badge(g, true)
}

fn frameRemove(g: *Glyph) -> void {
    filmFrame(g)
    badge(g, false)
}

// --- What every part of the window uses

// A point of the gear's rim: `radius` from the middle at `degrees`.
fn gearPoint(g: *Glyph, radius: f64, degrees: f64) -> void {
    const angle = degrees * math.pi / 180.0
    fillTo(g, 12.0 + radius * math.cos(angle), 12.0 + radius * math.sin(angle))
}

// A gear wheel of eight teeth. (Where the grid says, not fitted to the
// pixels: its teeth would come out each a little different.)
fn settings(g: *Glyph) -> void {
    g.*.snap = false
    fillFrom(g, 12.0 + 6.9 * math.cos(-14.5 * math.pi / 180.0), 12.0 + 6.9 * math.sin(-14.5 * math.pi / 180.0))
    var tooth: i64 = 0
    while tooth < 8 {
        const centre = vector.toFloat(tooth) * 45.0
        if tooth > 0 { gearPoint(g, 6.9, centre - 14.5) }
        gearPoint(g, 9.7, centre - 8.5)
        gearPoint(g, 9.7, centre + 8.5)
        gearPoint(g, 6.9, centre + 14.5)
        tooth += 1
    }
    fill(g)
    g.*.snap = true
    hole(g, 12.0, 12.0, 3.2)
}

fn closeMark(g: *Glyph) -> void {
    line(g, 6.0, 6.0, 18.0, 18.0)
    line(g, 18.0, 6.0, 6.0, 18.0)
}

fn menu(g: *Glyph) -> void {
    line(g, 4.0, 7.0, 20.0, 7.0)
    line(g, 4.0, 12.0, 20.0, 12.0)
    line(g, 4.0, 17.0, 20.0, 17.0)
}

fn more(g: *Glyph) -> void {
    disc(g, 5.5, 12.0, 1.8)
    disc(g, 12.0, 12.0, 1.8)
    disc(g, 18.5, 12.0, 1.8)
}

fn plus(g: *Glyph) -> void {
    line(g, 12.0, 5.0, 12.0, 19.0)
    line(g, 5.0, 12.0, 19.0, 12.0)
}

fn minus(g: *Glyph) -> void {
    line(g, 5.0, 12.0, 19.0, 12.0)
}

fn check(g: *Glyph) -> void {
    from(g, 5.0, 12.5)
    to(g, 10.0, 17.5)
    to(g, 19.0, 7.0)
}

fn arrowLeft(g: *Glyph) -> void {
    line(g, 4.5, 12.0, 19.5, 12.0)
    from(g, 10.5, 6.0)
    to(g, 4.5, 12.0)
    to(g, 10.5, 18.0)
}

fn arrowRight(g: *Glyph) -> void {
    line(g, 4.5, 12.0, 19.5, 12.0)
    from(g, 13.5, 6.0)
    to(g, 19.5, 12.0)
    to(g, 13.5, 18.0)
}

fn arrowUp(g: *Glyph) -> void {
    line(g, 12.0, 4.5, 12.0, 19.5)
    from(g, 6.0, 10.5)
    to(g, 12.0, 4.5)
    to(g, 18.0, 10.5)
}

fn arrowDown(g: *Glyph) -> void {
    line(g, 12.0, 4.5, 12.0, 19.5)
    from(g, 6.0, 13.5)
    to(g, 12.0, 19.5)
    to(g, 18.0, 13.5)
}

fn chevronLeft(g: *Glyph) -> void {
    from(g, 15.0, 6.0)
    to(g, 9.0, 12.0)
    to(g, 15.0, 18.0)
}

fn chevronRight(g: *Glyph) -> void {
    from(g, 9.0, 6.0)
    to(g, 15.0, 12.0)
    to(g, 9.0, 18.0)
}

fn chevronUp(g: *Glyph) -> void {
    from(g, 6.0, 15.0)
    to(g, 12.0, 9.0)
    to(g, 18.0, 15.0)
}

fn chevronDown(g: *Glyph) -> void {
    from(g, 6.0, 9.0)
    to(g, 12.0, 15.0)
    to(g, 18.0, 9.0)
}

// Two arrows apart: larger.
fn expand(g: *Glyph) -> void {
    line(g, 13.5, 10.5, 20.0, 4.0)
    from(g, 14.5, 4.0)
    to(g, 20.0, 4.0)
    to(g, 20.0, 9.5)
    line(g, 10.5, 13.5, 4.0, 20.0)
    from(g, 4.0, 14.5)
    to(g, 4.0, 20.0)
    to(g, 9.5, 20.0)
}

// Two arrows together: smaller.
fn collapse(g: *Glyph) -> void {
    line(g, 20.0, 4.0, 14.0, 10.0)
    from(g, 14.0, 4.5)
    to(g, 14.0, 10.0)
    to(g, 19.5, 10.0)
    line(g, 4.0, 20.0, 10.0, 14.0)
    from(g, 4.5, 14.0)
    to(g, 10.0, 14.0)
    to(g, 10.0, 19.5)
}

fn search(g: *Glyph) -> void {
    lens(g)
}

// A funnel.
fn funnel(g: *Glyph) -> void {
    from(g, 3.5, 5.0)
    to(g, 20.5, 5.0)
    to(g, 14.0, 12.5)
    to(g, 14.0, 19.0)
    to(g, 10.0, 21.0)
    to(g, 10.0, 12.5)
    shut(g)
}

// A pin: its head, its collar and its needle.
fn pin(g: *Glyph) -> void {
    line(g, 8.0, 3.5, 16.0, 3.5)
    from(g, 9.5, 3.5)
    to(g, 9.5, 10.0)
    to(g, 7.0, 13.5)
    to(g, 17.0, 13.5)
    to(g, 14.5, 10.0)
    to(g, 14.5, 3.5)
    line(g, 12.0, 13.5, 12.0, 21.0)
}

// The two ends of a chain's links facing each other.
fn linkEnds(g: *Glyph) -> void {
    from(g, 10.0, 7.5)
    to(g, 7.5, 7.5)
    turn(g, 3.0, 7.5, 3.0, 12.0)
    turn(g, 3.0, 16.5, 7.5, 16.5)
    to(g, 10.0, 16.5)
    from(g, 14.0, 7.5)
    to(g, 16.5, 7.5)
    turn(g, 21.0, 7.5, 21.0, 12.0)
    turn(g, 21.0, 16.5, 16.5, 16.5)
    to(g, 14.0, 16.5)
}

// The links held together.
fn link(g: *Glyph) -> void {
    linkEnds(g)
    line(g, 8.0, 12.0, 16.0, 12.0)
}

// The links apart, the break marked.
fn unlink(g: *Glyph) -> void {
    linkEnds(g)
    line(g, 12.0, 2.5, 12.0, 4.5)
    line(g, 12.0, 19.5, 12.0, 21.5)
}

fn info(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 9.0)
    disc(g, 12.0, 7.8, 1.3)
    line(g, 12.0, 11.0, 12.0, 16.5)
}

fn warning(g: *Glyph) -> void {
    from(g, 12.0, 3.5)
    to(g, 21.5, 20.0)
    to(g, 2.5, 20.0)
    shut(g)
    line(g, 12.0, 9.5, 12.0, 14.0)
    disc(g, 12.0, 17.0, 1.3)
}

fn failure(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 9.0)
    line(g, 9.0, 9.0, 15.0, 15.0)
    line(g, 15.0, 9.0, 9.0, 15.0)
}

fn help(g: *Glyph) -> void {
    circle(g, 12.0, 12.0, 9.0)
    from(g, 9.5, 9.5)
    curve(g, 9.5, 6.5, 14.5, 6.5, 14.5, 9.5)
    curve(g, 14.5, 11.5, 12.0, 11.5, 12.0, 13.5)
    disc(g, 12.0, 16.8, 1.3)
}

fn folderIcon(g: *Glyph) -> void {
    folder(g)
}

// A picture: the sun over hills.
fn image(g: *Glyph) -> void {
    frame(g, 3.0, 4.0, 18.0, 16.0, 2.0)
    disc(g, 8.5, 9.0, 1.8)
    from(g, 6.0, 16.5)
    to(g, 10.0, 12.5)
    to(g, 13.0, 15.5)
    to(g, 15.5, 13.0)
    to(g, 18.5, 16.5)
}

// Round and round again.
fn refresh(g: *Glyph) -> void {
    arrowArc(g, 12.0, 12.0, 8.0, 165.0, 20.0, 3.8)
    arrowArc(g, 12.0, 12.0, 8.0, -15.0, -160.0, 3.8)
}

// --- Transforms

// A shape and what it is turned over into, the axis between them.
fn flipHorizontal(g: *Glyph) -> void {
    from(g, 9.0, 5.5)
    to(g, 9.0, 18.5)
    to(g, 3.0, 18.5)
    shut(g)
    dashes(g, 12.0, 2.5, 12.0, 21.5)
    fillOnStrokes(g)
    triangle(g, 15.0, 5.5, 21.0, 18.5, 15.0, 18.5)
}

fn flipVertical(g: *Glyph) -> void {
    from(g, 5.5, 9.0)
    to(g, 18.5, 9.0)
    to(g, 18.5, 3.0)
    shut(g)
    dashes(g, 2.5, 12.0, 21.5, 12.0)
    fillOnStrokes(g)
    triangle(g, 5.5, 15.0, 18.5, 21.0, 18.5, 15.0)
}

// A quarter turn with the clock.
fn rotateCw(g: *Glyph) -> void {
    frame(g, 3.0, 11.5, 9.5, 9.5, 1.5)
    arrowArc(g, 8.0, 16.0, 10.5, 85.0, 5.0, 4.0)
}

fn rotateCcw(g: *Glyph) -> void {
    frame(g, 11.5, 11.5, 9.5, 9.5, 1.5)
    arrowArc(g, 16.0, 16.0, 10.5, 95.0, 175.0, 4.0)
}

// A box turned as one likes, a handle on each corner.
fn freeTransform(g: *Glyph) -> void {
    from(g, 16.2, 4.6)
    to(g, 19.4, 16.2)
    to(g, 7.8, 19.4)
    to(g, 4.6, 7.8)
    shut(g)
    knot(g, 16.2, 4.6)
    knot(g, 19.4, 16.2)
    knot(g, 7.8, 19.4)
    knot(g, 4.6, 7.8)
}

fn perspective(g: *Glyph) -> void {
    from(g, 8.0, 5.0)
    to(g, 16.0, 5.0)
    to(g, 20.0, 19.0)
    to(g, 4.0, 19.0)
    shut(g)
    knot(g, 8.0, 5.0)
    knot(g, 16.0, 5.0)
    knot(g, 20.0, 19.0)
    knot(g, 4.0, 19.0)
}

// A box with its sides drawn in.
fn warp(g: *Glyph) -> void {
    from(g, 5.0, 5.0)
    bend(g, 12.0, 8.5, 19.0, 5.0)
    bend(g, 15.5, 12.0, 19.0, 19.0)
    bend(g, 12.0, 15.5, 5.0, 19.0)
    bend(g, 8.5, 12.0, 5.0, 5.0)
    knot(g, 5.0, 5.0)
    knot(g, 19.0, 5.0)
    knot(g, 19.0, 19.0)
    knot(g, 5.0, 19.0)
}

// A cage of any shape, a handle on each corner.
fn cage(g: *Glyph) -> void {
    from(g, 5.0, 7.0)
    to(g, 14.0, 4.0)
    to(g, 20.0, 11.0)
    to(g, 16.0, 19.5)
    to(g, 6.0, 17.5)
    shut(g)
    knot(g, 5.0, 7.0)
    knot(g, 14.0, 4.0)
    knot(g, 20.0, 11.0)
    knot(g, 16.0, 19.5)
    knot(g, 6.0, 17.5)
}

// A whirl. (Its half turns meet where the grid says: not fitted.)
fn liquify(g: *Glyph) -> void {
    g.*.snap = false
    arc(g, 12.0, 11.0, 2.25, 180.0, 0.0)
    arc(g, 9.75, 11.0, 4.5, 0.0, -180.0)
    arc(g, 12.0, 11.0, 6.75, 180.0, 0.0)
    arc(g, 9.75, 11.0, 9.0, 0.0, -100.0)
    g.*.snap = true
}

// A net pulled out of shape.
fn mesh(g: *Glyph) -> void {
    from(g, 4.0, 4.5)
    bend(g, 12.0, 6.5, 20.0, 4.5)
    from(g, 3.5, 12.5)
    curve(g, 8.0, 10.5, 16.0, 14.5, 20.5, 11.5)
    from(g, 4.0, 19.5)
    bend(g, 12.0, 17.5, 20.0, 19.5)
    from(g, 4.0, 4.5)
    bend(g, 2.5, 12.0, 4.0, 19.5)
    from(g, 12.0, 5.5)
    curve(g, 10.5, 9.0, 13.5, 15.0, 12.0, 18.5)
    from(g, 20.0, 4.5)
    bend(g, 21.5, 12.0, 20.0, 19.5)
}

// --- Alignment

fn alignLeft(g: *Glyph) -> void {
    line(g, 4.0, 3.0, 4.0, 21.0)
    block(g, 7.0, 6.0, 12.0, 4.5, 1.0)
    block(g, 7.0, 13.5, 7.0, 4.5, 1.0)
}

fn alignCenter(g: *Glyph) -> void {
    line(g, 12.0, 3.0, 12.0, 21.0)
    block(g, 5.0, 6.0, 14.0, 4.5, 1.0)
    block(g, 8.0, 13.5, 8.0, 4.5, 1.0)
}

fn alignRight(g: *Glyph) -> void {
    line(g, 20.0, 3.0, 20.0, 21.0)
    block(g, 5.0, 6.0, 12.0, 4.5, 1.0)
    block(g, 10.0, 13.5, 7.0, 4.5, 1.0)
}

fn alignTop(g: *Glyph) -> void {
    line(g, 3.0, 4.0, 21.0, 4.0)
    block(g, 6.0, 7.0, 4.5, 12.0, 1.0)
    block(g, 13.5, 7.0, 4.5, 7.0, 1.0)
}

fn alignMiddle(g: *Glyph) -> void {
    line(g, 3.0, 12.0, 21.0, 12.0)
    block(g, 6.0, 5.0, 4.5, 14.0, 1.0)
    block(g, 13.5, 8.0, 4.5, 8.0, 1.0)
}

fn alignBottom(g: *Glyph) -> void {
    line(g, 3.0, 20.0, 21.0, 20.0)
    block(g, 6.0, 5.0, 4.5, 12.0, 1.0)
    block(g, 13.5, 10.0, 4.5, 7.0, 1.0)
}

// --- What a painting program needs besides

fn selectAll(g: *Glyph) -> void {
    marquee(g, 3.0, 3.0, 21.0, 21.0)
    block(g, 7.5, 7.5, 9.0, 9.0, 1.0)
}

fn selectNone(g: *Glyph) -> void {
    marquee(g, 3.0, 3.0, 21.0, 21.0)
    line(g, 9.0, 9.0, 15.0, 15.0)
    line(g, 15.0, 9.0, 9.0, 15.0)
}

// What was selected is not, what was not is.
fn selectInvert(g: *Glyph) -> void {
    marquee(g, 3.0, 3.0, 21.0, 21.0)
    fillOnStrokes(g)
    triangle(g, 16.5, 7.5, 16.5, 16.5, 7.5, 16.5)
    from(g, 7.5, 16.5)
    to(g, 7.5, 7.5)
    to(g, 16.5, 7.5)
}

// All layers pressed into one.
fn flatten(g: *Glyph) -> void {
    line(g, 12.0, 3.0, 12.0, 10.0)
    head(g, 12.0, 10.0, 0.0, 1.0, 3.0)
    fillFrom(g, 12.0, 13.0)
    fillTo(g, 21.0, 17.0)
    fillTo(g, 12.0, 21.0)
    fillTo(g, 3.0, 17.0)
    fill(g)
}

fn distributeHorizontal(g: *Glyph) -> void {
    line(g, 4.0, 3.0, 4.0, 21.0)
    line(g, 20.0, 3.0, 20.0, 21.0)
    block(g, 9.5, 6.5, 5.0, 11.0, 1.0)
}

fn distributeVertical(g: *Glyph) -> void {
    line(g, 3.0, 4.0, 21.0, 4.0)
    line(g, 3.0, 20.0, 21.0, 20.0)
    block(g, 6.5, 9.5, 11.0, 5.0, 1.0)
}

fn star(g: *Glyph) -> void {
    from(g, 12.0, 3.0)
    to(g, 14.4, 9.2)
    to(g, 21.0, 9.6)
    to(g, 15.9, 13.8)
    to(g, 17.6, 20.2)
    to(g, 12.0, 16.6)
    to(g, 6.4, 20.2)
    to(g, 8.1, 13.8)
    to(g, 3.0, 9.6)
    to(g, 9.6, 9.2)
    shut(g)
}

fn tag(g: *Glyph) -> void {
    from(g, 4.0, 4.0)
    to(g, 12.0, 4.0)
    to(g, 20.5, 12.5)
    to(g, 12.5, 20.5)
    to(g, 4.0, 12.0)
    shut(g)
    disc(g, 8.0, 8.0, 1.5)
}

// A pencil.
fn rename(g: *Glyph) -> void {
    from(g, 4.0, 20.0)
    to(g, 5.0, 15.5)
    to(g, 16.0, 4.5)
    to(g, 19.5, 8.0)
    to(g, 8.5, 19.0)
    shut(g)
    line(g, 13.5, 7.0, 17.0, 10.5)
}

// Where a thing is taken hold of to drag it.
fn grip(g: *Glyph) -> void {
    disc(g, 9.0, 6.0, 1.6)
    disc(g, 15.0, 6.0, 1.6)
    disc(g, 9.0, 12.0, 1.6)
    disc(g, 15.0, 12.0, 1.6)
    disc(g, 9.0, 18.0, 1.6)
    disc(g, 15.0, 18.0, 1.6)
}

// A box and how far it is to grow.
fn resize(g: *Glyph) -> void {
    frame(g, 3.0, 11.0, 10.0, 10.0, 1.5)
    line(g, 12.0, 12.0, 20.0, 4.0)
    from(g, 14.5, 4.0)
    to(g, 20.0, 4.0)
    to(g, 20.0, 9.5)
}

// A shaky line made a smooth one.
fn stabilizer(g: *Glyph) -> void {
    from(g, 3.0, 9.0)
    to(g, 6.0, 5.0)
    to(g, 9.0, 9.0)
    to(g, 12.0, 5.0)
    to(g, 15.0, 9.0)
    to(g, 18.0, 5.0)
    to(g, 21.0, 9.0)
    from(g, 3.0, 17.0)
    curve(g, 7.0, 12.0, 9.0, 12.0, 12.0, 16.0)
    curve(g, 15.0, 20.0, 17.0, 20.0, 21.0, 15.0)
}

// The mark of the one chosen of several.
fn bullet(g: *Glyph) -> void {
    disc(g, 12.0, 12.0, 3.5)
}
