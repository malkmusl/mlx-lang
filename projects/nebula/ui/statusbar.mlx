// nebula ui: the status bar along the window's bottom. At the left what
// the program has to say (api.say; in red when it is a failure), else the
// tool in use and what it does; then where the pointer is on the image,
// in pixels, while it is over the canvas; at the right the selection's
// size when there is one, the image's size, its pixels' kind, the memory
// its pixels take, and the zoom: a slider (25 % to 3200 %, about the
// canvas's middle) with buttons a step out and in beside it (brixOS has no
// wheel: these are how one zooms there).
//
//     chrome.draw: statusbar.draw(app)          at app.statusBar
//     statusbar.text(app, statusbar.FIELD_SIZE, &bytes)    what a field says
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const kit_module = @import("./kit.mlx")
const icons = @import("./icons.mlx")
const viewport = @import("./viewport.mlx")
const canvasview = @import("./canvasview.mlx")
const selection = @import("../core/selection.mlx")
const tilepool = @import("../core/tilepool.mlx")
const geom = @import("../core/geom.mlx")

pub const App = state.App

// The bar's height (times the scale).
pub const HEIGHT: i32 = 22

// What the bar says, field by field (text()).
pub const FIELD_LEFT: u8 = 0
pub const FIELD_POINTER: u8 = 1
pub const FIELD_SELECTION: u8 = 2
pub const FIELD_SIZE: u8 = 3
pub const FIELD_FORMAT: u8 = 4
pub const FIELD_MEMORY: u8 = 5
pub const FIELD_ZOOM: u8 = 6
// The bytes text() may write.
pub const ROOM: usize = 256

// The zoom slider's range, in per cent.
pub const LEAST_ZOOM: f64 = 25.0
pub const MOST_ZOOM: f64 = 3200.0

const PADDING: i32 = 10
const SLIDER: i32 = 112
const BUTTON: i32 = 20

// What the bar keeps: the selection's size (worked out again only when
// the selection changed), the kit's frame it was looked at last, the zoom
// slider's options.
const Status = struct {
    ready: bool
    zoom: kit_module.SliderOptions
    image: usize
    serial: u64
    frame: u64
    bounds: geom.Rect
}

fn statusOf(app: *App) -> ?*Status {
    const memory = state.slot(app, state.SLOT_STATUS, @sizeOf(Status))
    if memory == null { return null }
    const status: *Status = unsafe { @ptrCast(*Status, memory.?) }
    if !status.*.ready {
        status.*.zoom = zoomOptions()
        status.*.image = 0
        status.*.ready = true
    }
    return status
}

// The zoom slider's options (the overview docker has the same slider).
pub fn zoomOptions() -> kit_module.SliderOptions {
    var options = kit_module.sliderOptions(LEAST_ZOOM, MOST_ZOOM, 10.0, 0)
    // The bar's left third is 25 % to 100 %, its middle up to 400 %.
    options.exponent = 3.0
    options.suffix = " %"
    return options
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

fn hintOf(app: *App, group: u8) -> []const u8 {
    if group == state.GROUP_PAINT { return state.tr(app, "drag on the canvas to paint", "auf der Leinwand ziehen, um zu malen") }
    if group == state.GROUP_SHAPE { return state.tr(app, "drag on the canvas to draw the shape", "auf der Leinwand ziehen, um die Form zu zeichnen") }
    if group == state.GROUP_TRANSFORM { return state.tr(app, "drag to move or transform the layer", "ziehen, um die Ebene zu bewegen oder umzuformen") }
    if group == state.GROUP_FILL { return state.tr(app, "click on the canvas to fill", "auf die Leinwand klicken, um zu füllen") }
    if group == state.GROUP_SELECT { return state.tr(app, "drag on the canvas to select", "auf der Leinwand ziehen, um auszuwählen") }
    if group == state.GROUP_VIEW { return state.tr(app, "drag on the canvas to change the view", "auf der Leinwand ziehen, um die Ansicht zu ändern") }
    return ""
}

// The pointer's place on the image, when it is over the canvas.
fn pointerOnImage(app: *App, x: *i32, y: *i32) -> bool {
    const doc = api.document(app)
    if doc == null || !app.*.pointerInside || app.*.dialogCount > 0 { return false }
    const area = doc.?.*.view.area
    if !ui.contains(area, app.*.pointerX, app.*.pointerY) || !ui.contains(app.*.canvasArea, app.*.pointerX, app.*.pointerY) { return false }
    var ix: f64 = 0.0
    var iy: f64 = 0.0
    viewport.toImage(&doc.?.*.view, @floatFromInt(f64, app.*.pointerX) + 0.5, @floatFromInt(f64, app.*.pointerY) + 0.5, &ix, &iy)
    if !(ix > -1.0e9 && ix < 1.0e9 && iy > -1.0e9 && iy < 1.0e9) { return false }
    x.* = @intFromFloat(i32, @floor(ix))
    y.* = @intFromFloat(i32, @floor(iy))
    return true
}

// The selection's bounds (empty: there is none). Kept while the same
// image's selection stays the same from frame to frame: an image closed
// and another made in its memory has the same address and may have the
// same serial, so after a frame in which the bar did not look (no
// image, no selection, the canvas alone) it is worked out again.
fn selectionBounds(app: *App) -> geom.Rect {
    const image = api.image(app)
    const status = statusOf(app)
    if image == null || status == null || !image.?.*.selected { return geom.empty() }
    const frame = api.kit(app).*.frame
    const seen = status.?.*.frame == frame || status.?.*.frame + 1 == frame
    if !seen || status.?.*.image != @intFromPtr(image.?) || status.?.*.serial != image.?.*.selectionSerial {
        status.?.*.bounds = geom.intersect(selection.bounds(image.?.*.selection), geom.rect(0, 0, image.?.*.width, image.?.*.height))
        status.?.*.image = @intFromPtr(image.?)
        status.?.*.serial = image.?.*.selectionSerial
    }
    status.?.*.frame = frame
    return status.?.*.bounds
}

fn appendSize(into: [*]u8, at: usize, width: i32, height: i32) -> usize {
    var length = std.text.appendSigned(into, at, ROOM, @intCast(isize, width))
    length = std.text.append(into, length, ROOM, " \xC3\x97 ")
    length = std.text.appendSigned(into, length, ROOM, @intCast(isize, height))
    return std.text.append(into, length, ROOM, " px")
}

// What field `field` (FIELD_*) says now, into `into` (ROOM bytes); its
// length (0: the field shows nothing now).
pub fn text(app: *App, field: u8, into: [*]u8) -> usize {
    const doc = api.document(app)
    if field == FIELD_LEFT {
        const note = api.noteOf(app)
        if note.length > 0 { return std.text.append(into, 0, ROOM, note) }
        const tool = api.tool(app)
        if tool == null { return 0 }
        var length = std.text.append(into, 0, ROOM, state.tr(app, tool.?.*.name, tool.?.*.german))
        const hint = hintOf(app, tool.?.*.group)
        if hint.length > 0 {
            length = std.text.append(into, length, ROOM, " \xE2\x80\x94 ")
            length = std.text.append(into, length, ROOM, hint)
        }
        return length
    }
    if field == FIELD_POINTER {
        var x: i32 = 0
        var y: i32 = 0
        if !pointerOnImage(app, &x, &y) { return 0 }
        var length = std.text.appendSigned(into, 0, ROOM, @intCast(isize, x))
        length = std.text.append(into, length, ROOM, ", ")
        length = std.text.appendSigned(into, length, ROOM, @intCast(isize, y))
        return std.text.append(into, length, ROOM, " px")
    }
    if field == FIELD_MEMORY {
        // Tiles are 16 KiB: 64 to a MiB.
        const tiles = tilepool.liveTiles()
        var length = std.text.appendUnsigned(into, 0, ROOM, tiles / 64)
        length = std.text.appendByte(into, length, ROOM, if app.*.german { 44 } else { 46 })
        length = std.text.appendUnsigned(into, length, ROOM, (tiles % 64) * 10 / 64)
        return std.text.append(into, length, ROOM, " MiB")
    }
    if doc == null { return 0 }
    const image = doc.?.*.image
    if field == FIELD_SELECTION {
        const bounds = selectionBounds(app)
        if geom.isEmpty(bounds) { return 0 }
        const length = std.text.append(into, 0, ROOM, state.tr(app, "Selection ", "Auswahl "))
        return appendSize(into, length, bounds.width, bounds.height)
    }
    if field == FIELD_SIZE { return appendSize(into, 0, image.*.width, image.*.height) }
    if field == FIELD_FORMAT { return std.text.append(into, 0, ROOM, state.tr(app, "RGBA 8-bit", "RGBA 8 Bit")) }
    if field == FIELD_ZOOM {
        const zoom = doc.?.*.view.zoom * 100.0
        const percent = if zoom < 1.0 { 1 } else if zoom > 100000.0 { 100000 } else { @intFromFloat(usize, zoom + 0.5) }
        const length = std.text.appendUnsigned(into, 0, ROOM, percent)
        return std.text.append(into, length, ROOM, " %")
    }
    return 0
}

fn zoomId(part: usize) -> u64 { return view.idOf(view.id("nebula.status.zoom"), part) }

// The zoom slider's place this frame (part 1), and the buttons' beside
// it (0: out, 2: in); empty without a document or in a bar too small for
// them.
pub fn zoomArea(app: *App, part: usize) -> ui.Rect {
    const bar = app.*.statusBar
    const button = px(app, BUTTON)
    const slider = px(app, SLIDER)
    if ui.isEmpty(bar) || api.document(app) == null || bar.height < button || bar.width < button * 2 + slider + px(app, 4 + 6 + PADDING) { return ui.rect(0, 0, 0, 0) }
    const right = ui.right(bar) - px(app, 6)
    const top = bar.y + (bar.height - button) / 2 + app.*.scale / 2
    if part == 2 { return ui.rect(right - button, top, button, button) }
    if part == 1 { return ui.rect(right - button - px(app, 2) - slider, top + px(app, 1), slider, button - px(app, 2)) }
    return ui.rect(right - button * 2 - px(app, 4) - slider, top, button, button)
}

// The zoom's controls: out, the slider, in.
fn drawZoom(app: *App, status: *Status) -> void {
    const doc = api.document(app)
    const out = zoomArea(app, 0)
    if doc == null || ui.isEmpty(out) { return }
    const k = api.kit(app)
    const view_record = &doc.?.*.view
    if smallButton(app, zoomId(0), out, icons.ZOOM_OUT, state.tr(app, "Zoom out", "Verkleinern")) { canvasview.zoomOut(app) }
    var percent = view_record.*.zoom * 100.0
    if percent < LEAST_ZOOM { percent = LEAST_ZOOM }
    if percent > MOST_ZOOM { percent = MOST_ZOOM }
    if kit_module.slider(k, zoomId(1), zoomArea(app, 1), "", &percent, &status.*.zoom) {
        const area = view_record.*.area
        viewport.zoomAt(view_record, @floatFromInt(f64, area.x) + @floatFromInt(f64, area.width) / 2.0, @floatFromInt(f64, area.y) + @floatFromInt(f64, area.height) / 2.0, percent / 100.0)
        api.redraw(app)
    }
    kit_module.tooltip(k, zoomId(1), zoomArea(app, 1), state.tr(app, "Zoom", "Zoom"))
    if smallButton(app, zoomId(2), zoomArea(app, 2), icons.ZOOM_IN, state.tr(app, "Zoom in", "Vergrößern")) { canvasview.zoomIn(app) }
}

// A small square button with an icon, lit under the pointer; true when
// clicked.
fn smallButton(app: *App, id: u64, area: ui.Rect, icon: u16, tip: []const u8) -> bool {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    view.region(widgets, id, area)
    const lit = view.isHover(widgets, id) || view.isPressed(widgets, id)
    if lit { canvas_module.fillRoundedRect(widgets.*.canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, if view.isPressed(widgets, id) { theme.*.pressed } else { theme.*.buttonHover }) }
    const size = px(app, 16)
    icons.draw(widgets.*.canvas, icon, area.x + (area.width - size) / 2, area.y + (area.height - size) / 2, size, theme.*.text)
    kit_module.tooltip(k, id, area, tip)
    return view.takeClick(widgets, id)
}

// A field's text right-aligned to `right`; where the next one to its
// left must end (a thin line between them).
fn fieldLeftOf(app: *App, field: u8, right: i32, least: i32) -> i32 {
    var bytes: [256]u8 = undefined
    const written = text(app, field, &bytes)
    if written == 0 { return right }
    const font = state.smallOf(app)
    const shown: [*]const u8 = &bytes
    const wide = text_module.measure(font, shown[0..written])
    const x = right - wide
    if x < least { return right }
    const bar = app.*.statusBar
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    controls.label(widgets, font, shown[0..written], x, controls.textTop(font, bar.y, bar.height), theme.*.dim, 0)
    const gap = px(app, PADDING)
    canvas_module.fillRect(widgets.*.canvas, x - gap, bar.y + px(app, 6), px(app, 1), bar.height - px(app, 12), theme_module.mix(theme.*.panel, theme.*.border, 380))
    return x - gap * 2
}

// Draws the bar at app.statusBar.
pub fn draw(app: *App) -> void {
    const status = statusOf(app)
    const bar = app.*.statusBar
    if status == null || ui.isEmpty(bar) { return }
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = widgets.*.canvas
    const s = app.*.scale
    const font = state.smallOf(app)
    canvas_module.fillRect(canvas, bar.x, bar.y, bar.width, bar.height, theme.*.glass)
    canvas_module.fillRect(canvas, bar.x, bar.y, bar.width, s, theme.*.divider)
    const top = controls.textTop(font, bar.y, bar.height)
    const left = bar.x + px(app, PADDING)
    // From the right: the zoom, then the fields as long as they fit.
    var right = ui.right(bar) - px(app, PADDING)
    const zoom_out = zoomArea(app, 0)
    if !ui.isEmpty(zoom_out) {
        drawZoom(app, status.?)
        right = zoom_out.x - px(app, PADDING)
    }
    // The pointer's place has a column of its own: its text changes as
    // the pointer moves, the others do not.
    const pointer_width = px(app, 96)
    const least = left + px(app, 160) + pointer_width
    right = fieldLeftOf(app, FIELD_MEMORY, right, least)
    right = fieldLeftOf(app, FIELD_FORMAT, right, least)
    right = fieldLeftOf(app, FIELD_SIZE, right, least)
    right = fieldLeftOf(app, FIELD_SELECTION, right, least)
    var bytes: [256]u8 = undefined
    const shown: [*]const u8 = &bytes
    var written = text(app, FIELD_POINTER, &bytes)
    const pointer_x = right - pointer_width
    if written > 0 && pointer_x > left {
        controls.label(widgets, font, shown[0..written], pointer_x, top, theme.*.text, pointer_width)
    }
    // The note, or the tool and what it does: the name plain, the rest dim.
    const room = pointer_x - left - px(app, PADDING)
    if room <= 0 { return }
    const note = api.noteOf(app)
    if note.length > 0 {
        controls.label(widgets, font, note, left, top, if app.*.noteDanger { theme.*.danger } else { theme.*.text }, room)
        return
    }
    const tool = api.tool(app)
    if tool == null { return }
    const name = state.tr(app, tool.?.*.name, tool.?.*.german)
    controls.label(widgets, font, name, left, top, theme.*.text, room)
    const name_width = text_module.measure(font, name) + px(app, 8)
    const hint = hintOf(app, tool.?.*.group)
    if hint.length > 0 && name_width < room {
        written = std.text.append(&bytes, 0, ROOM, "\xE2\x80\x94 ")
        written = std.text.append(&bytes, written, ROOM, hint)
        controls.label(widgets, font, shown[0..written], left + name_width, top, theme.*.dim, room - name_width)
    }
}
