// nebula ui: the tabs of the open documents, over the canvas: a tab for
// each (its name, a dot while it has changes not saved, a cross to close
// it under the pointer), the one in front marked. A click on a tab puts
// its document in front; the cross, or the middle button on a tab
// (middleClick: std.ui's widgets get only the left one), closes it: by
// the action "file_close" when there is one (it asks about changes), else
// at once. Tabs share the width when there are many.
//
//     chrome.layOut: const tall = tabbar.height(app)
//     chrome.draw:   tabbar.draw(app)            at app.tabBar
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const glyphs = @import("std.ui.glyphs")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const documents = @import("../app/documents.mlx")
const kit_module = @import("./kit.mlx")
const canvasview = @import("./canvasview.mlx")
const actions = @import("../actions/registry.mlx")

pub const App = state.App

// The bar's height and a tab's widths (times the scale).
pub const HEIGHT: i32 = 28
const WIDEST: i32 = 220
const PADDING: i32 = 10
// The cross's (or the dot's) square at a tab's right.
const CROSS: i32 = 16

const Tabs = struct {
    tabs: [16]ui.Rect
    count: usize
}

fn tabsOf(app: *App) -> ?*Tabs {
    const memory = state.slot(app, state.SLOT_TABS, @sizeOf(Tabs))
    if memory == null { return null }
    return unsafe { @ptrCast(*Tabs, memory.?) }
}

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

// How tall the bar is: none without a document.
pub fn height(app: *App) -> i32 {
    return if app.*.count > 0 { px(app, HEIGHT) } else { 0 }
}

fn tabId(index: usize) -> u64 { return view.idOf(view.id("nebula.tabs.tab"), index) }
fn closeId(index: usize) -> u64 { return view.idOf(view.id("nebula.tabs.close"), index) }

// Where document `index`'s tab was this frame (empty: none).
pub fn tabArea(app: *App, index: usize) -> ui.Rect {
    const tabs = tabsOf(app)
    if tabs == null || index >= tabs.?.*.count { return ui.rect(0, 0, 0, 0) }
    return tabs.?.*.tabs[index]
}

// Where its cross is (it takes clicks when the tab is under the pointer).
pub fn closeArea(app: *App, index: usize) -> ui.Rect {
    const tab = tabArea(app, index)
    if ui.isEmpty(tab) { return tab }
    const side = px(app, CROSS)
    return ui.rect(ui.right(tab) - px(app, 6) - side, tab.y + (tab.height - side) / 2, side, side)
}

// Closes document `index`: by the action when there is one, else at once.
pub fn close(app: *App, index: usize) -> void {
    if index >= app.*.count { return }
    if actions.byKey("file_close") != null {
        documents.show(app, index)
        _ = api.run(app, "file_close")
        return
    }
    const doc = app.*.documents[index]
    if doc == null { return }
    canvasview.forget(app, doc.?)
    documents.close(app, index)
}

// The middle button went down at (x, y): on a tab it closes its document.
// True when it did.
pub fn middleClick(app: *App, x: i32, y: i32) -> bool {
    const tabs = tabsOf(app)
    if tabs == null { return false }
    var index: usize = 0
    while index < tabs.?.*.count {
        if ui.contains(tabs.?.*.tabs[index], x, y) {
            close(app, index)
            return true
        }
        index += 1
    }
    return false
}

// Draws the bar at app.tabBar.
pub fn draw(app: *App) -> void {
    const tabs = tabsOf(app)
    if tabs == null { return }
    tabs.?.*.count = 0
    const bar = app.*.tabBar
    if ui.isEmpty(bar) { return }
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = widgets.*.canvas
    const s = app.*.scale
    canvas_module.fillRect(canvas, bar.x, bar.y, bar.width, bar.height, theme.*.background)
    canvas_module.fillRect(canvas, bar.x, ui.bottom(bar) - s, bar.width, s, theme.*.divider)
    const count = app.*.count
    if count == 0 { return }
    // As wide as the name wants, at most WIDEST; all share the bar when
    // they do not fit.
    const room = bar.width - px(app, 4)
    var natural: i32 = 0
    var index: usize = 0
    while index < count {
        natural += naturalWidth(app, index)
        index += 1
    }
    const share = room / @intCast(i32, count)
    var x = bar.x
    var closing: usize = state.DOCUMENTS
    index = 0
    while index < count {
        const wide = if natural > room { share } else { naturalWidth(app, index) }
        const tab = ui.rect(x, bar.y + px(app, 4), wide, bar.height - px(app, 4) - s)
        tabs.?.*.tabs[index] = tab
        tabs.?.*.count = index + 1
        if drawTab(app, index, tab) { closing = index }
        x += wide
        index += 1
    }
    if closing < count { close(app, closing) }
}

fn naturalWidth(app: *App, index: usize) -> i32 {
    const doc = app.*.documents[index]
    if doc == null { return 0 }
    const wide = text_module.measure(state.smallOf(app), documents.nameOf(doc.?)) + px(app, PADDING * 2 + CROSS + 6)
    return if wide > px(app, WIDEST) { px(app, WIDEST) } else { wide }
}

// One tab; true when its cross was clicked.
fn drawTab(app: *App, index: usize, tab: ui.Rect) -> bool {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = widgets.*.canvas
    const s = app.*.scale
    const doc = app.*.documents[index]
    if doc == null { return false }
    const id = tabId(index)
    const cross_id = closeId(index)
    const front = index == app.*.current
    view.region(widgets, id, tab)
    const lit = view.isHover(widgets, id) || view.isHover(widgets, cross_id)
    if front {
        canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, tab.height + s, theme.*.raised)
        canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, 2 * s, theme.*.accent)
    } else if lit {
        canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, tab.height, theme.*.hover)
    }
    // A line between two tabs that are neither in front.
    if !front && index + 1 < app.*.count && index + 1 != app.*.current {
        canvas_module.fillRect(canvas, ui.right(tab) - s, tab.y + px(app, 6), s, tab.height - px(app, 12), theme.*.divider)
    }
    const cross = closeArea(app, index)
    kit_module.label(k, ui.rect(tab.x + px(app, PADDING), tab.y + s, cross.x - tab.x - px(app, PADDING + 4), tab.height - s), documents.nameOf(doc.?), if front || lit { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_LEFT)
    var closed = false
    if lit {
        view.region(widgets, cross_id, cross)
        if view.isHover(widgets, cross_id) { canvas_module.fillRoundedRect(canvas, cross.x, cross.y, cross.width, cross.height, theme.*.smallRadius, theme.*.buttonHover) }
        glyphs.crossScaled(canvas, cross.x + (cross.width - 8 * s) / 2, cross.y + (cross.height - 8 * s) / 2, theme.*.text, s)
        closed = view.takeClick(widgets, cross_id)
    } else if documents.isModified(doc.?) {
        const dot = px(app, 8)
        glyphs.dot(canvas, cross.x + (cross.width - dot) / 2, cross.y + (cross.height - dot) / 2, dot, if front { theme.*.text } else { theme.*.dim })
    }
    if view.takeClick(widgets, id) && !front { documents.show(app, index) }
    return closed
}
