// nebula ui: the canvas: the document in front as its view says (zoom,
// place), in the window's canvas area, with the ground it stands on and
// the checker that shows through where it is transparent.
//
// It draws straight into the window's pixels (the program draws on the
// CPU) from the image's projection (core/render.mlx brings it up to date
// first), and it is where the pointer's window pixels become places on
// the image for the tools (inputAt).
//
// Not done yet: a turned or mirrored view is drawn upright; zoomed out
// the image is sampled, not averaged; nothing is kept between frames.
const std = @import("std")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const viewport = @import("./viewport.mlx")
const device_module = @import("../core/device.mlx")
const image_module = @import("../core/image.mlx")
const render = @import("../core/render.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")

pub const App = state.App
pub const Canvas = state.Canvas
pub const Document = state.Document

const CHECK: i32 = 8
const CHECK_LIGHT: u32 = 0xFFFFFFFF
const CHECK_DARK: u32 = 0xFFCCCCCC

// What a window pixel of the canvas area shows of the image: the place
// (x, y) of the image under window pixel (wx, wy), as a tool gets it.
pub fn inputAt(app: *App, doc: *Document, wx: i32, wy: i32, into: *state.Input) -> void {
    var x: f64 = 0.0
    var y: f64 = 0.0
    viewport.toImage(&doc.*.view, @floatFromInt(f64, wx) + 0.5, @floatFromInt(f64, wy) + 0.5, &x, &y)
    into.*.x = x
    into.*.y = y
    into.*.windowX = wx
    into.*.windowY = wy
    into.*.pressure = 1.0
    into.*.tiltX = 0.0
    into.*.tiltY = 0.0
    into.*.rotation = 0.0
    into.*.time = 0.0
    into.*.button = 0
    into.*.buttons = app.*.buttons
    into.*.modifiers = app.*.modifiers
    into.*.clicks = 1
}

// The view fits the image into the area the first time the area is known
// (a new document's zoom is 0 until then).
fn settle(doc: *Document, area: ui.Rect) -> void {
    doc.*.view.area = area
    if doc.*.view.zoom <= 0.0 {
        doc.*.view.zoom = 1.0
        viewport.fit(&doc.*.view, doc.*.image.*.width, doc.*.image.*.height, 24)
        if doc.*.view.zoom > 1.0 { doc.*.view.zoom = 1.0 }
    }
}

// Draws the document in front into `area` of the window (the ground of
// the canvas area when there is none).
pub fn draw(app: *App, canvas: *Canvas, area: ui.Rect) -> void {
    const ground = app.*.theme.background | 0xFF000000
    const doc = api.document(app)
    if doc != null { settle(doc.?, area) }
    if canvas.*.width == 0 || canvas.*.device != 0 { return }
    const clipped = ui.intersect(area, ui.rect(0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height)))
    if ui.isEmpty(clipped) { return }
    if doc == null {
        canvas_module.fillRect(canvas, clipped.x, clipped.y, clipped.width, clipped.height, ground)
        return
    }
    const image = doc.?.*.image
    _ = render.update(image)
    const view = &doc.?.*.view
    const zoom = view.*.zoom
    // The image's pixels the area shows, and a row of them at a time.
    const shown = geom.intersect(viewport.imageRectOf(view, clipped), image_module.bounds(image))
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const row_words = if shown.width > 0 { @intCast(usize, shown.width) } else { 1 }
    const source = scratch.words(pool, row_words)
    if source == null {
        scratch.release(pool, mark)
        return
    }
    const middle_x = @floatFromInt(f64, area.x) + @floatFromInt(f64, area.width) / 2.0
    const middle_y = @floatFromInt(f64, area.y) + @floatFromInt(f64, area.height) / 2.0
    var read_row: i32 = -2147483647
    var wy = clipped.y
    while wy < ui.bottom(clipped) {
        const target = canvas.*.pixels + (@intCast(usize, wy) * canvas.*.stride + @intCast(usize, clipped.x))
        const fy = (@floatFromInt(f64, wy) + 0.5 - middle_y) / zoom + view.*.centerY
        const iy = @intFromFloat(i32, @floor(if fy < -1000000.0 { -1000000.0 } else if fy > 1000000.0 { 1000000.0 } else { fy }))
        const inside_row = iy >= shown.y && iy < shown.y + shown.height
        if inside_row && iy != read_row {
            device_module.readRect(image.*.projection, geom.rect(shown.x, iy, shown.width, 1), source.?, row_words)
            read_row = iy
        }
        var column: i32 = 0
        while column < clipped.width {
            const wx = clipped.x + column
            var shown_pixel = ground
            if inside_row {
                const fx = (@floatFromInt(f64, wx) + 0.5 - middle_x) / zoom + view.*.centerX
                const ix = @intFromFloat(i32, @floor(if fx < -1000000.0 { -1000000.0 } else if fx > 1000000.0 { 1000000.0 } else { fx }))
                if ix >= shown.x && ix < shown.x + shown.width {
                    const straight = source.?[@intCast(usize, ix - shown.x)]
                    if straight >> 24 == 255 {
                        shown_pixel = straight
                    } else {
                        const check = if (((wx - area.x) / CHECK) + ((wy - area.y) / CHECK)) & 1 == 0 { CHECK_LIGHT } else { CHECK_DARK }
                        shown_pixel = pixel.over(check, straight, 255)
                    }
                }
            }
            target[@intCast(usize, column)] = shown_pixel
            column += 1
        }
        wy += 1
    }
    scratch.release(pool, mark)
}

// What the view kept for a document is let go (before the document is
// closed).
pub fn forget(app: *App, doc: *Document) -> void {
    doc.*.viewData = 0
}
