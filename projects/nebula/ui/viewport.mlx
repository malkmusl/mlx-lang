// nebula ui: how a document is looked at: which point of the image is in
// the middle of the canvas area, how many window pixels an image pixel is
// wide (zoom), how far the canvas is turned and whether it is mirrored.
// Only arithmetic: the canvas view draws by it, the tools turn the
// pointer's window pixels into places on the image by it.
//
// An image point goes to the window by: minus the centre, mirrored
// (x = -x) when the view is, turned by `rotation` (radians, clockwise on
// the screen), times `zoom`, plus the middle of `area`.
const ui = @import("std.ui")
const math = @import("std.math")
const geom = @import("../core/geom.mlx")

pub const SMALLEST: f64 = 0.01
pub const LARGEST: f64 = 256.0

pub const View = struct {
    centerX: f64
    centerY: f64
    zoom: f64
    rotation: f64
    mirror: bool
    // Where in the window the canvas is shown (set at every layout).
    area: ui.Rect
}

pub fn init(view: *View, image_width: i32, image_height: i32) -> void {
    view.*.centerX = @floatFromInt(f64, image_width) / 2.0
    view.*.centerY = @floatFromInt(f64, image_height) / 2.0
    view.*.zoom = 1.0
    view.*.rotation = 0.0
    view.*.mirror = false
    view.*.area = ui.rect(0, 0, 0, 0)
}

fn middleX(view: *const View) -> f64 { return @floatFromInt(f64, view.*.area.x) + @floatFromInt(f64, view.*.area.width) / 2.0 }
fn middleY(view: *const View) -> f64 { return @floatFromInt(f64, view.*.area.y) + @floatFromInt(f64, view.*.area.height) / 2.0 }

// The window place of image point (x, y).
pub fn toWindow(view: *const View, x: f64, y: f64, wx: *f64, wy: *f64) -> void {
    var dx = x - view.*.centerX
    const dy = y - view.*.centerY
    if view.*.mirror { dx = -dx }
    const c = math.cos(view.*.rotation)
    const s = math.sin(view.*.rotation)
    wx.* = (dx * c - dy * s) * view.*.zoom + middleX(view)
    wy.* = (dx * s + dy * c) * view.*.zoom + middleY(view)
}

// The image point under window place (wx, wy).
pub fn toImage(view: *const View, wx: f64, wy: f64, x: *f64, y: *f64) -> void {
    const px = (wx - middleX(view)) / view.*.zoom
    const py = (wy - middleY(view)) / view.*.zoom
    const c = math.cos(view.*.rotation)
    const s = math.sin(view.*.rotation)
    var dx = px * c + py * s
    const dy = -px * s + py * c
    if view.*.mirror { dx = -dx }
    x.* = dx + view.*.centerX
    y.* = dy + view.*.centerY
}

pub fn clampZoom(zoom: f64) -> f64 {
    return if zoom < SMALLEST { SMALLEST } else if zoom > LARGEST { LARGEST } else { zoom }
}

// Zooms to `zoom`, the image point under window place (wx, wy) staying
// under it.
pub fn zoomAt(view: *View, wx: f64, wy: f64, zoom: f64) -> void {
    var x: f64 = 0.0
    var y: f64 = 0.0
    toImage(view, wx, wy, &x, &y)
    view.*.zoom = clampZoom(zoom)
    var nx: f64 = 0.0
    var ny: f64 = 0.0
    toImage(view, wx, wy, &nx, &ny)
    view.*.centerX += x - nx
    view.*.centerY += y - ny
}

// Moves what is shown by (dx, dy) window pixels (the content follows the
// pointer of a hand that drags it).
pub fn panBy(view: *View, dx: f64, dy: f64) -> void {
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    toImage(view, 0.0, 0.0, &x0, &y0)
    toImage(view, dx, dy, &x1, &y1)
    view.*.centerX -= x1 - x0
    view.*.centerY -= y1 - y0
}

// Turns the canvas to `rotation`, the image point under window place
// (wx, wy) staying under it.
pub fn rotateAt(view: *View, wx: f64, wy: f64, rotation: f64) -> void {
    var x: f64 = 0.0
    var y: f64 = 0.0
    toImage(view, wx, wy, &x, &y)
    var turned = math.fmod(rotation, math.tau)
    if turned > math.pi { turned -= math.tau }
    if turned < -math.pi { turned += math.tau }
    view.*.rotation = turned
    var nx: f64 = 0.0
    var ny: f64 = 0.0
    toImage(view, wx, wy, &nx, &ny)
    view.*.centerX += x - nx
    view.*.centerY += y - ny
}

// The whole image in the area with `margin` window pixels around it, not
// turned further than it is.
pub fn fit(view: *View, image_width: i32, image_height: i32, margin: i32) -> void {
    view.*.centerX = @floatFromInt(f64, image_width) / 2.0
    view.*.centerY = @floatFromInt(f64, image_height) / 2.0
    const room_x = @floatFromInt(f64, view.*.area.width - margin * 2)
    const room_y = @floatFromInt(f64, view.*.area.height - margin * 2)
    if room_x <= 1.0 || room_y <= 1.0 || image_width <= 0 || image_height <= 0 {
        view.*.zoom = 1.0
        return
    }
    // Turned, the image's box on the screen is wider.
    const c = math.abs(math.cos(view.*.rotation))
    const s = math.abs(math.sin(view.*.rotation))
    const w = @floatFromInt(f64, image_width)
    const h = @floatFromInt(f64, image_height)
    const box_w = w * c + h * s
    const box_h = w * s + h * c
    const zx = room_x / box_w
    const zy = room_y / box_h
    view.*.zoom = clampZoom(if zx < zy { zx } else { zy })
}

fn least(a: f64, b: f64, c: f64, d: f64) -> f64 {
    var result = a
    if b < result { result = b }
    if c < result { result = c }
    if d < result { result = d }
    return result
}

fn most(a: f64, b: f64, c: f64, d: f64) -> f64 {
    var result = a
    if b > result { result = b }
    if c > result { result = c }
    if d > result { result = d }
    return result
}

// The image's pixels (a rectangle around them) that window rectangle
// `window` shows.
pub fn imageRectOf(view: *const View, window: ui.Rect) -> geom.Rect {
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var x2: f64 = 0.0
    var y2: f64 = 0.0
    var x3: f64 = 0.0
    var y3: f64 = 0.0
    const left = @floatFromInt(f64, window.x)
    const top = @floatFromInt(f64, window.y)
    const right = @floatFromInt(f64, window.x + window.width)
    const bottom = @floatFromInt(f64, window.y + window.height)
    toImage(view, left, top, &x0, &y0)
    toImage(view, right, top, &x1, &y1)
    toImage(view, left, bottom, &x2, &y2)
    toImage(view, right, bottom, &x3, &y3)
    return geom.fromBounds(least(x0, x1, x2, x3), least(y0, y1, y2, y3), most(x0, x1, x2, x3), most(y0, y1, y2, y3))
}

// The window pixels (a rectangle around them) that image rectangle
// `area` is shown in.
pub fn windowRectOf(view: *const View, area: geom.Rect) -> ui.Rect {
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var x2: f64 = 0.0
    var y2: f64 = 0.0
    var x3: f64 = 0.0
    var y3: f64 = 0.0
    const left = @floatFromInt(f64, area.x)
    const top = @floatFromInt(f64, area.y)
    const right = @floatFromInt(f64, area.x + area.width)
    const bottom = @floatFromInt(f64, area.y + area.height)
    toWindow(view, left, top, &x0, &y0)
    toWindow(view, right, top, &x1, &y1)
    toWindow(view, left, bottom, &x2, &y2)
    toWindow(view, right, bottom, &x3, &y3)
    return geom.fromBounds(least(x0, x1, x2, x3), least(y0, y1, y2, y3), most(x0, x1, x2, x3), most(y0, y1, y2, y3))
}

// Whether the view is neither turned nor mirrored (the fast way to draw).
pub fn isUpright(view: *const View) -> bool {
    return view.*.rotation == 0.0 && !view.*.mirror
}
