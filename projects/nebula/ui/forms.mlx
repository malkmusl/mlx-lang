// nebula ui: forms: a dialog made from a description, so that the
// filters and the generators need no dialog code of their own. A table
// of filters/types.mlx's Param rows says what the numbers of a
// node.Params record are; open() shows a row for each and edits the
// record in place while it is open:
//
//     var options = forms.FormOptions.{ .onChange = rerender, .onAccept = apply, .onCancel = dropPreview, .preview = &showPreview, .reset = true }
//     _ = forms.open(app, "Gaussian Blur", info.*.params, &params, &options)
//
// A row is the Param's name (in the program's language) and its field:
// INT and FLOAT a slider (whole numbers, or as many decimals as the range
// wants: 4 up to a range of 0.1, 2 up to 10, 1 up to 100), ANGLE a slider
// in degrees, BOOL a check box, CHOICE a drop-down list of the choices
// ("A|B|C", the value is the place), COLOR a swatch that opens
// dialogs.pickColor (the value is the colour's 0xAARRGGBB as a number),
// TEXT a text box for params.text. The value of row n is
// params.values[n]; a table longer than node.VALUES rows shows the first
// ones.
//
// onChange runs in every frame in which a value changed (the caller
// renders its preview again); with `preview` a "Preview" check box at the
// left of the buttons is bound to it (a click runs onChange too); with
// `reset` a Defaults button sets every number back to its Param's initial
// value (a text stays as it is: a Param has no initial text). OK runs
// onAccept. Cancel, Escape and the close cross put back the values (and
// the preview flag) the form was opened with and run onCancel. More rows
// than fit scroll (the bar is dragged; Page Up and Down, Home and End).
//
// The form reads the Param table through the slice it is given, and
// writes the record and the preview flag through their pointers, while it
// is open: the caller keeps all three alive till then (the tables are
// constant, in the program's data; a slice of a table made at run time is
// not: see core/table.mlx).
//
// Not done: an ANGLE does not wrap around (it is held in its range like
// any number); a TEXT row is one line, and a record has one text, so two
// TEXT rows of a table edit the same.
const std = @import("std")
const ui = @import("std.ui")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const kit_module = @import("./kit.mlx")
const dialogs = @import("./dialogs.mlx")
const types = @import("../filters/types.mlx")
const node_module = @import("../core/node.mlx")
const color_module = @import("../core/color.mlx")

pub const App = state.App

// What a form does besides editing the values: whom it tells and which
// extra controls it has (open() copies it).
pub const FormOptions = struct {
    // A value changed (null: nobody is told).
    onChange: ?state.ActionRun
    // OK.
    onAccept: state.ActionRun
    // Cancelled; the values are put back already (null: nobody is told).
    onCancel: ?state.ActionRun
    // The caller's "show a preview" flag, a check box when not null.
    preview: ?*bool
    // A Defaults button.
    reset: bool
}

// dialogs.Hooks.kind of a form.
const KIND_FORM: u8 = 16
// A row each value of a node.Params has.
const ROWS: usize = node_module.VALUES
const NO_ROW: usize = 18446744073709551615
const TITLE: usize = 128

// What a CHOICE row's list is named from (the kit asks for the names
// until its frame is over: kept with the form).
const Choices = struct {
    param: usize
    german: bool
}

const Form = struct {
    title: [128]u8
    titleLength: usize
    params: []const types.Param
    values: *node_module.Params
    // What cancelling puts back.
    before: node_module.Params
    previewBefore: bool
    options: FormOptions
    rows: usize
    chosen: [node_module.VALUES]usize
    choices: [node_module.VALUES]Choices
    // The COLOR row whose colour dialog is open (NO_ROW: none).
    picking: usize
    // A colour's "#rrggbb" while its row is drawn.
    hex: [16]u8
    // The buttons' labels (a local array handed on would be taken from
    // the value arena every frame).
    labels: [3][]const u8
}

fn formOf(app: *App, level: usize) -> *Form { return unsafe { @ptrCast(*Form, dialogs.body(app, level)) } }

// Opens a form under `title` for `values`, a row for each of `params`
// (see the header), with what `options` says (copied). False when it
// cannot be shown (too many dialogs, no memory).
pub fn open(app: *App, title: []const u8, params: []const types.Param, values: *node_module.Params, options: *const FormOptions) -> bool {
    const hooks = dialogs.Hooks.{ .kind = KIND_FORM, .draw = drawForm, .key = null, .finish = finishForm, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(Form))
    if level == null { return false }
    const form = formOf(app, level.?)
    const bytes: [*]u8 = &form.*.title
    var length: usize = 0
    while length < title.length && length < TITLE {
        bytes[length] = title[length]
        length += 1
    }
    // (Whole characters only.)
    while length > 0 && length < title.length && title[length] & 192 == 128 { length -= 1 }
    form.*.titleLength = length
    form.*.params = params
    form.*.values = values
    form.*.before = values.*
    form.*.previewBefore = false
    if options.*.preview != null { form.*.previewBefore = options.*.preview.?.* }
    form.*.options = options.*
    form.*.rows = if params.length > ROWS { ROWS } else { params.length }
    form.*.picking = NO_ROW
    return true
}

fn nameOf(app: *App, param: *const types.Param) -> []const u8 {
    return if app.*.german && param.*.german.length > 0 { param.*.german } else { param.*.name }
}

// The choices of a CHOICE row in the language asked for.
fn choicesOf(param: *const types.Param, german: bool) -> []const u8 {
    return if german && param.*.choicesGerman.length > 0 { param.*.choicesGerman } else { param.*.choices }
}

fn choiceCount(text: []const u8) -> usize {
    if text.length == 0 { return 0 }
    var count: usize = 1
    for byte in text {
        if byte == 124 { count += 1 }
    }
    return count
}

// Choice `index` of "A|B|C".
fn choiceAt(text: []const u8, index: usize) -> []const u8 {
    var start: usize = 0
    var at: usize = 0
    var seen: usize = 0
    while at <= text.length {
        if at == text.length || text[at] == 124 {
            if seen == index { return text[start..at] }
            seen += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

fn choiceName(context: usize, index: usize) -> []const u8 {
    const choices: *Choices = unsafe { @ptrFromInt(*Choices, context) }
    const param: *const types.Param = unsafe { @ptrFromInt(*const types.Param, choices.*.param) }
    return choiceAt(choicesOf(param, choices.*.german), index)
}

// A slider's range and steps for a number row.
fn numberOptions(param: *const types.Param) -> kit_module.SliderOptions {
    const low = param.*.low
    var high = param.*.high
    if !(high > low) { high = low + 1.0 }
    const span = high - low
    var decimals: usize = 0
    var step: f64 = 1.0
    if param.*.kind == types.FLOAT {
        if span <= 0.1 {
            decimals = 4
            step = 0.0001
        } else if span <= 10.0 {
            decimals = 2
            step = 0.01
        } else if span <= 100.0 {
            decimals = 1
            step = 0.1
        }
    }
    var options = kit_module.sliderOptions(low, high, step, decimals)
    if param.*.kind == types.ANGLE { options.suffix = "°" }
    return options
}

// A colour kept as a number (a COLOR row's value).
fn colorOfValue(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 4294967295.0 { return 4294967295 }
    return @intFromFloat(u32, value)
}

// Row `index`, taken off the top of `rows`; true when its value changed.
fn drawRow(app: *App, level: usize, form: *Form, index: usize, rows: *ui.Rect) -> bool {
    const kit = api.kit(app)
    const s = state.themeOf(app).*.scale
    const row = dialogs.ROW * s
    const param = &form.*.params[index]
    const values = form.*.values
    const id = dialogs.idOf(app, level, dialogs.PART_FIELD + index)
    const kind = param.*.kind
    if kind == types.BOOL {
        // The box stands where the other rows' fields start, its name
        // beside it.
        const field = dialogs.labelled(app, rows, "", row)
        var on = values.*.values[index] != 0.0
        if !kit_module.checkBox(kit, id, field, nameOf(app, param), &on) { return false }
        values.*.values[index] = if on { 1.0 } else { 0.0 }
        return true
    }
    const field = dialogs.labelled(app, rows, nameOf(app, param), row)
    if kind == types.INT || kind == types.FLOAT || kind == types.ANGLE {
        const options = numberOptions(param)
        var value = values.*.values[index]
        if !kit_module.slider(kit, id, field, "", &value, &options) { return false }
        values.*.values[index] = value
        return true
    }
    if kind == types.CHOICE {
        form.*.choices[index] = Choices.{ .param = @intFromPtr(param), .german = app.*.german }
        const count = choiceCount(choicesOf(param, app.*.german))
        const value = values.*.values[index]
        // (Held to the choices before it becomes a whole number: what is
        // far out of range has none, and a row without choices has only
        // the first place.)
        var chosen: usize = 0
        if count > 0 {
            if value >= @floatFromInt(f64, count) - 0.5 {
                chosen = count - 1
            } else if value > 0.0 {
                chosen = @intFromFloat(usize, value + 0.5)
            }
        }
        form.*.chosen[index] = chosen
        if !kit_module.comboBoxWith(kit, id, field, count, choiceName, @intFromPtr(&form.*.choices[index]), &form.*.chosen[index]) { return false }
        values.*.values[index] = @floatFromInt(f64, form.*.chosen[index])
        return true
    }
    if kind == types.COLOR {
        const color = colorOfValue(values.*.values[index])
        const swatch = ui.rect(field.x, field.y, 56 * s, row)
        if kit_module.colorSwatch(kit, id, swatch, color, false) {
            form.*.picking = index
            _ = dialogs.pickColor(app, nameOf(app, param), color, pickedColor, true)
        }
        const length = color_module.formatHex(color, &form.*.hex, color >> 24 != 255)
        const bytes: [*]const u8 = &form.*.hex
        kit_module.label(kit, ui.rect(ui.right(swatch) + 10 * s, field.y, field.width - 66 * s, row), bytes[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        return false
    }
    if kind == types.TEXT {
        const result = kit_module.textBox(kit, id, field, &values.*.text, &values.*.textLength, node_module.TEXT, "")
        return result == kit_module.TEXT_EDITED || result == kit_module.TEXT_CANCELLED
    }
    return false
}

// A colour chosen (or, live, being chosen) for the form's COLOR row.
fn pickedColor(app: *App, color: u32) -> void {
    const level = dialogs.find(app, KIND_FORM)
    if level == null { return }
    const form = formOf(app, level.?)
    if form.*.picking >= form.*.rows { return }
    form.*.values.*.values[form.*.picking] = @floatFromInt(f64, color)
    const change = form.*.options.onChange
    if change != null { change.?(app) }
    api.redraw(app)
}

// Every number back to its initial value.
fn defaults(form: *Form) -> void {
    var index: usize = 0
    while index < form.*.rows {
        if form.*.params[index].kind != types.TEXT { form.*.values.*.values[index] = form.*.params[index].initial }
        index += 1
    }
}

fn drawForm(app: *App, level: usize, window: ui.Rect) -> void {
    const form = formOf(app, level)
    const kit = api.kit(app)
    const s = state.themeOf(app).*.scale
    const count = form.*.rows
    const natural = @intCast(i32, count) * (dialogs.ROW + dialogs.GAP) * s
    const title: [*]const u8 = &form.*.title
    var content = dialogs.frame(app, window, title[0..form.*.titleLength], 440 * s, dialogs.framed(app, natural))
    const whole = content
    const labels: [*][]const u8 = &form.*.labels
    var buttons: usize = 0
    if form.*.options.reset {
        labels[0] = state.tr(app, "Defaults", "Standard")
        buttons = 1
    }
    const ok = buttons
    labels[ok] = "OK"
    labels[ok + 1] = state.tr(app, "Cancel", "Abbrechen")
    buttons = ok + 2
    const clicked = dialogs.buttons(app, &content, labels[0..buttons], ok)
    var changed = false
    const preview = form.*.options.preview
    if preview != null {
        // At the left of the buttons' row.
        const height = dialogs.BUTTON_HEIGHT * s
        if kit_module.checkBox(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + ROWS), ui.rect(whole.x, ui.bottom(whole) - height, 130 * s, height), state.tr(app, "Preview", "Vorschau"), preview.?) { changed = true }
    }
    if clicked != null && form.*.options.reset && clicked.? == 0 {
        defaults(form)
        changed = true
    }
    var rows = dialogs.scrollBegin(app, content, natural)
    var index: usize = 0
    while index < count {
        if drawRow(app, level, form, index, &rows) { changed = true }
        index += 1
    }
    dialogs.scrollEnd(app)
    const change = form.*.options.onChange
    if changed && change != null { change.?(app) }
    if clicked != null {
        if clicked.? == ok {
            dialogs.close(app, level, 0)
        } else if clicked.? == ok + 1 {
            dialogs.close(app, level, dialogs.CANCEL)
        }
    }
}

fn finishForm(app: *App, level: usize, answer: usize) -> void {
    const form = formOf(app, level)
    if answer == 0 {
        const accept = form.*.options.onAccept
        accept(app)
        return
    }
    form.*.values.* = form.*.before
    if form.*.options.preview != null { form.*.options.preview.?.* = form.*.previewBefore }
    const cancel = form.*.options.onCancel
    if cancel != null { cancel.?(app) }
}
