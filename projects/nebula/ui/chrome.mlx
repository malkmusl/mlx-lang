// nebula ui: what stands around the canvas: where each part of the window
// is (layOut) and the bars themselves (draw), over the canvas already
// drawn. For now a bar along the top (the tool in use, the colours,
// eraser mode, undo and redo) and the status bar along the bottom (the
// zoom, the image's size, what the program has to say); the menu bar, the
// toolbox and the dockers take their places as they are written.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const controls = @import("std.ui.controls")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const documents = @import("../app/documents.mlx")
const history_module = @import("../core/history.mlx")
const pixel = @import("../core/pixel.mlx")

pub const App = state.App
pub const Canvas = state.Canvas

const TOOLBAR: i32 = 40
const STATUS: i32 = 24

// Where the window's parts are for a window of `width` x `height`.
pub fn layOut(app: *App, width: i32, height: i32) -> void {
    var free = ui.rect(0, 0, width, height)
    app.*.window = free
    app.*.menuBar = ui.rect(0, 0, 0, 0)
    app.*.tabBar = ui.rect(0, 0, 0, 0)
    app.*.leftDock = ui.rect(0, 0, 0, 0)
    app.*.rightDock = ui.rect(0, 0, 0, 0)
    if app.*.canvasOnly {
        app.*.toolBar = ui.rect(0, 0, 0, 0)
        app.*.statusBar = ui.rect(0, 0, 0, 0)
        app.*.canvasArea = free
        return
    }
    app.*.toolBar = ui.takeTop(&free, state.px(app, TOOLBAR))
    app.*.statusBar = ui.takeBottom(&free, state.px(app, STATUS))
    app.*.canvasArea = free
}

fn appendPercent(into: [*]u8, at: usize, capacity: usize, zoom: f64) -> usize {
    const percent = @intFromFloat(i64, if zoom > 1000.0 { 100000.0 } else { zoom * 100.0 + 0.5 })
    const length = std.text.appendUnsigned(into, at, capacity, @intCast(usize, percent))
    return std.text.append(into, length, capacity, " %")
}

fn drawToolBar(app: *App, canvas: *Canvas) -> void {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const bar = app.*.toolBar
    if ui.isEmpty(bar) { return }
    canvas_module.fillRect(canvas, bar.x, bar.y, bar.width, bar.height, theme.*.panel)
    canvas_module.fillRect(canvas, bar.x, ui.bottom(bar) - 1, bar.width, 1, theme.*.divider)
    const s = app.*.scale
    const pad = 8 * s
    var x = bar.x + pad
    const height = bar.height - pad * 2
    const y = bar.y + pad
    const tool = api.tool(app)
    if tool != null {
        const name = state.tr(app, tool.?.*.name, tool.?.*.german)
        controls.label(widgets, state.bodyOf(app), name, x, controls.textTop(state.bodyOf(app), y, height), theme.*.text, 0)
        x += text_module.measure(state.bodyOf(app), name) + pad * 2
    }
    // The two colours: the background's square behind the foreground's.
    const back = ui.rect(x + 10 * s, y + 6 * s, height - 6 * s, height - 6 * s)
    const front = ui.rect(x, y - 2 * s, height - 6 * s, height - 6 * s)
    canvas_module.fillRoundedRect(canvas, back.x - 1, back.y - 1, back.width + 2, back.height + 2, 4 * s, theme.*.border)
    canvas_module.fillRoundedRect(canvas, back.x, back.y, back.width, back.height, 3 * s, pixel.premultiplied(app.*.background | 0xFF000000))
    canvas_module.fillRoundedRect(canvas, front.x - 1, front.y - 1, front.width + 2, front.height + 2, 4 * s, theme.*.border)
    canvas_module.fillRoundedRect(canvas, front.x, front.y, front.width, front.height, 3 * s, pixel.premultiplied(app.*.foreground | 0xFF000000))
    view.region(widgets, view.id("nebula.swap"), ui.rect(x, bar.y, height + 12 * s, bar.height))
    if view.takeClick(widgets, view.id("nebula.swap")) { api.swapColors(app) }
    x += height + 12 * s + pad
    const eraser_label = state.tr(app, "Eraser", "Radierer")
    const eraser_width = controls.buttonWidth(widgets, state.bodyOf(app), eraser_label)
    if controls.toggleButton(widgets, view.id("nebula.eraser"), ui.rect(x, y, eraser_width, height), app.*.eraser) {
        app.*.eraser = !app.*.eraser
        api.redraw(app)
    }
    controls.centeredLabel(widgets, state.bodyOf(app), eraser_label, ui.rect(x, y, eraser_width, height), theme.*.text)
    x += eraser_width + pad
    const image = api.image(app)
    const undo_label = state.tr(app, "Undo", "Rückgängig")
    const undo_width = controls.buttonWidth(widgets, state.bodyOf(app), undo_label)
    if controls.button(widgets, view.id("nebula.undo"), ui.rect(x, y, undo_width, height), undo_label, controls.BUTTON_NORMAL, image != null && history_module.canUndo(image.?.*.history)) { api.undo(app) }
    x += undo_width + pad / 2
    const redo_label = state.tr(app, "Redo", "Wiederholen")
    const redo_width = controls.buttonWidth(widgets, state.bodyOf(app), redo_label)
    if controls.button(widgets, view.id("nebula.redo"), ui.rect(x, y, redo_width, height), redo_label, controls.BUTTON_NORMAL, image != null && history_module.canRedo(image.?.*.history)) { api.redo(app) }
}

fn drawStatus(app: *App, canvas: *Canvas) -> void {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const bar = app.*.statusBar
    if ui.isEmpty(bar) { return }
    canvas_module.fillRect(canvas, bar.x, bar.y, bar.width, bar.height, theme.*.panel)
    canvas_module.fillRect(canvas, bar.x, bar.y, bar.width, 1, theme.*.divider)
    const font = state.smallOf(app)
    const top = controls.textTop(font, bar.y, bar.height)
    const pad = 10 * app.*.scale
    var text: [96]u8 = undefined
    const bytes: [*]u8 = &text
    var right = ui.right(bar) - pad
    const doc = api.document(app)
    if doc != null {
        var length = std.text.appendUnsigned(bytes, 0, 96, @intCast(usize, doc.?.*.image.*.width))
        length = std.text.append(bytes, length, 96, " x ")
        length = std.text.appendUnsigned(bytes, length, 96, @intCast(usize, doc.?.*.image.*.height))
        length = std.text.append(bytes, length, 96, "    ")
        length = appendPercent(bytes, length, 96, doc.?.*.view.zoom)
        const width = text_module.measure(font, bytes[0..length])
        right -= width
        controls.label(widgets, font, bytes[0..length], right, top, theme.*.dim, 0)
        right -= pad * 2
    }
    const note = api.noteOf(app)
    if note.length > 0 {
        controls.label(widgets, font, note, bar.x + pad, top, if app.*.noteDanger { theme.*.danger } else { theme.*.text }, right - bar.x - pad)
    } else if doc != null {
        var length = std.text.append(bytes, 0, 96, documents.nameOf(doc.?))
        if documents.isModified(doc.?) { length = std.text.append(bytes, length, 96, " *") }
        controls.label(widgets, font, bytes[0..length], bar.x + pad, top, theme.*.dim, right - bar.x - pad)
    }
}

// Draws the bars (after the canvas: they lie over what of it reaches
// under them).
pub fn draw(app: *App, canvas: *Canvas) -> void {
    drawToolBar(app, canvas)
    drawStatus(app, canvas)
}
