// nebula ui: everything of the window around the canvas: where each part
// is (layOut, every frame, for the window's size) and the parts drawn
// over the canvas already drawn (draw).
//
// From the top: the menu bar (ui/menus.mlx), the toolbar (ui/toolbar.mlx,
// a row of 36 pixels); below them the middle band: the toolbox's column
// at the far left (ui/toolbox.mlx), the left dock area when it shows a
// docker (ui/docks.mlx), the canvas's column (the documents' tabs,
// ui/tabbar.mlx, over the canvas), the right dock area; the status bar
// (ui/statusbar.mlx, 22 pixels) along the bottom. With app.canvasOnly the
// canvas is the whole window.
//
// The canvas keeps at least LEAST_CANVAS pixels of width: the dock areas
// give up width first (each down to its least), then the left one goes,
// then the right one. The toolbox's column is not in the App: toolboxArea
// says where it is.
//
//     loop: chrome.layOut(app, width, height) ... canvas ... chrome.draw(app, canvas)
const std = @import("std")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const state = @import("../app/state.mlx")
const menus = @import("./menus.mlx")
const toolbar = @import("./toolbar.mlx")
const toolbox = @import("./toolbox.mlx")
const tabbar = @import("./tabbar.mlx")
const statusbar = @import("./statusbar.mlx")
const docks = @import("./docks.mlx")

pub const App = state.App
pub const Canvas = state.Canvas

// The canvas's least width with the dock areas beside it.
pub const LEAST_CANVAS: i32 = 480

fn none() -> ui.Rect { return ui.rect(0, 0, 0, 0) }

// Where the window's parts are for a window of `width` x `height`: fills
// app.window, menuBar, toolBar, tabBar, leftDock, rightDock, statusBar,
// canvasArea (and the toolbox's and docks' own records).
pub fn layOut(app: *App, width: i32, height: i32) -> void {
    var free = ui.rect(0, 0, if width > 0 { width } else { 0 }, if height > 0 { height } else { 0 })
    app.*.window = free
    app.*.menuBar = none()
    app.*.toolBar = none()
    app.*.tabBar = none()
    app.*.leftDock = none()
    app.*.rightDock = none()
    app.*.statusBar = none()
    if app.*.canvasOnly {
        app.*.canvasArea = free
        toolbox.place(app, none())
        docks.place(app, docks.AREA_LEFT, none())
        docks.place(app, docks.AREA_RIGHT, none())
        return
    }
    const menu = menus.barHeight(app)
    if menu > 0 { app.*.menuBar = ui.takeTop(&free, menu) }
    app.*.toolBar = ui.takeTop(&free, state.px(app, toolbar.HEIGHT))
    app.*.statusBar = ui.takeBottom(&free, state.px(app, statusbar.HEIGHT))
    if free.height < 0 { free.height = 0 }
    const column = ui.takeLeft(&free, toolbox.widthFor(app, free.height))
    toolbox.place(app, column)
    // The dock areas: as wide as they are set to, narrower when the
    // canvas would get less than its least.
    var left = docks.width(app, docks.AREA_LEFT)
    var right = docks.width(app, docks.AREA_RIGHT)
    const least_canvas = state.px(app, LEAST_CANVAS)
    const least_dock = state.px(app, docks.SMALLEST_WIDTH)
    var over = left + right + least_canvas - free.width
    if over > 0 {
        // Each gives up in proportion to what it has above its least.
        const spare_left = if left > least_dock { left - least_dock } else { 0 }
        const spare_right = if right > least_dock { right - least_dock } else { 0 }
        const spare = spare_left + spare_right
        if spare > 0 {
            const take = if over < spare { over } else { spare }
            const from_left = @intCast(i32, @intCast(i64, take) * @intCast(i64, spare_left) / @intCast(i64, spare))
            left -= from_left
            right -= take - from_left
            over -= take
        }
    }
    // Still too narrow: the areas go, the left one first.
    if over > 0 && left > 0 {
        over -= left
        left = 0
    }
    if over > 0 && right > 0 && free.width - right < least_canvas / 2 { right = 0 }
    app.*.leftDock = if left > 0 { ui.takeLeft(&free, left) } else { none() }
    app.*.rightDock = if right > 0 { ui.takeRight(&free, right) } else { none() }
    docks.place(app, docks.AREA_LEFT, app.*.leftDock)
    docks.place(app, docks.AREA_RIGHT, app.*.rightDock)
    const tabs = tabbar.height(app)
    if tabs > 0 { app.*.tabBar = ui.takeTop(&free, tabs) }
    app.*.canvasArea = free
}

// Where the toolbox's column is this frame (empty: not shown).
pub fn toolboxArea(app: *App) -> ui.Rect {
    return toolbox.area(app)
}

// Draws the parts around the canvas (after the canvas: they lie over what
// of it reaches under them; the menu bar after the toolbar, the toolbar's
// list after all).
pub fn draw(app: *App, canvas: *Canvas) -> void {
    if app.*.canvasOnly { return }
    toolbox.draw(app)
    docks.draw(app)
    tabbar.draw(app)
    statusbar.draw(app)
    toolbar.draw(app)
    if !ui.isEmpty(app.*.menuBar) { menus.drawBar(app, canvas, app.*.menuBar) }
    toolbar.drawOver(app)
}

// A button other than the left one went down at (x, y), not on the
// canvas (std.ui's widgets see only the left one): the middle one on a
// document's tab closes it. True when a part took it.
pub fn press(app: *App, button: u32, x: i32, y: i32) -> bool {
    if app.*.canvasOnly { return false }
    if button == ui_app.BUTTON_MIDDLE && ui.contains(app.*.tabBar, x, y) { return tabbar.middleClick(app, x, y) }
    return false
}

// A key nobody took before the shortcuts: the docker under the pointer
// gets it. True when it used it.
pub fn key(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    return docks.key(app, code, modifiers, typed)
}
