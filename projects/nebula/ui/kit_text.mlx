// nebula ui: numbers and labels as text, for ui/kit.mlx's widgets (kit.mlx
// hands these on under the same names): a number written with a fixed
// count of decimals, what a person typed read as a number, and a label cut
// to a width with an ellipsis.
//
//     var digits: [kit_text.NUMBER_ROOM]u8 = undefined
//     const length = kit_text.formatNumber(0.5, 2, &digits)      // "0.50"
//     const typed = kit_text.parseNumber("1,5")                  // 1.5 (a German decimal comma)
//     var room: [kit_text.TEXT_ROOM]u8 = undefined
//     const shown = kit_text.ellipsized(font, "A long layer name", 60, &room)
//
// std.fmt writes no floats, hence formatNumber; it writes no exponents
// and no digit groups, and parseNumber reads neither.
const text_module = @import("std.ui.text")

const Text = text_module.Text

// The bytes formatNumber needs at most: a sign, twenty digits, the point
// and nine decimals.
pub const NUMBER_ROOM: usize = 32
// The bytes ellipsized needs for its result; a longer text is cut to it.
pub const TEXT_ROOM: usize = 256

// The most decimals written.
const MOST_DECIMALS: usize = 9
// "…" in UTF-8.
const ELLIPSIS: []const u8 = "\xE2\x80\xA6"

// Writes `value` with `decimals` digits after the point (0: a whole
// number; 9 at most), rounded to that (halves away from zero), into
// `into` (NUMBER_ROOM bytes) and returns the length: "0.50", "-12",
// "1000000". Nothing rounds to "-0": the sign is written only when a digit
// is not zero. A value beyond what 64 bits count is held there; one that
// is no number is written as "0".
pub fn formatNumber(value: f64, decimals: usize, into: [*]u8) -> usize {
    const places = if decimals > MOST_DECIMALS { MOST_DECIMALS } else { decimals }
    var scale: f64 = 1.0
    var unit: u64 = 1
    var place: usize = 0
    while place < places {
        scale *= 10.0
        unit *= 10
        place += 1
    }
    var magnitude = if value < 0.0 { 0.0 - value } else { value }
    if magnitude != magnitude { magnitude = 0.0 }
    // (9e18 is below 2^63: the conversion stays defined.)
    const most = 9.0e18 / scale
    if magnitude > most { magnitude = most }
    // The product of a decimal fraction is often a hair under the half it
    // stands for (0.285 * 100 is 28.499999999999996): two units in the
    // last place more, and what was typed as 0.285 shows as 0.29.
    const product = magnitude * scale
    const scaled = @intFromFloat(u64, product + product * 4.5e-16 + 0.5)
    var whole = scaled / unit
    var fraction = scaled % unit
    var length: usize = 0
    if value < 0.0 && scaled != 0 {
        into[0] = '-'
        length = 1
    }
    // The whole part, its digits found last first.
    var digits: [20]u8 = undefined
    var count: usize = 0
    while whole > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + whole % 10)
        whole /= 10
        count += 1
    }
    while count > 0 {
        count -= 1
        into[length] = digits[count]
        length += 1
    }
    if places == 0 { return length }
    into[length] = '.'
    place = places
    while place > 0 {
        into[length + place] = @intCast(u8, 48 + fraction % 10)
        fraction /= 10
        place -= 1
    }
    return length + 1 + places
}

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

// The number `text` starts with, as a person types it: blanks, a sign
// ("+", "-" or the minus sign U+2212), digits, and decimals after a point
// or a comma (German); whatever follows the number (a unit: "12 px",
// "50%") is not looked at. Null when there is no digit.
pub fn parseNumber(text: []const u8) -> ?f64 {
    var index: usize = 0
    while index < text.length && (text[index] == 32 || text[index] == 9) { index += 1 }
    var negative = false
    if index < text.length && text[index] == '-' {
        negative = true
        index += 1
    } else if index < text.length && text[index] == '+' {
        index += 1
    } else if index + 2 < text.length && text[index] == 0xE2 && text[index + 1] == 0x88 && text[index + 2] == 0x92 {
        negative = true
        index += 3
    }
    var digits: usize = 0
    var whole: f64 = 0.0
    while index < text.length && isDigit(text[index]) {
        whole = whole * 10.0 + @floatFromInt(f64, text[index] - 48)
        digits += 1
        index += 1
    }
    var fraction: f64 = 0.0
    var scale: f64 = 1.0
    if index < text.length && (text[index] == '.' || text[index] == ',') {
        index += 1
        // (More than 18 decimals say nothing an f64 keeps.)
        while index < text.length && isDigit(text[index]) {
            if scale < 1.0e18 {
                fraction = fraction * 10.0 + @floatFromInt(f64, text[index] - 48)
                scale *= 10.0
            }
            digits += 1
            index += 1
        }
    }
    if digits == 0 { return null }
    const result = whole + fraction / scale
    return if negative { 0.0 - result } else { result }
}

// The start of the character after the one at `at`.
fn nextIn(text: []const u8, at: usize) -> usize {
    if at >= text.length { return text.length }
    var index = at + 1
    while index < text.length && text[index] & 192 == 128 { index += 1 }
    return index
}

// `text` as it fits `width` pixels in `font`: itself when it does, else
// its longest start that fits with "…" after it, written into `into`
// (TEXT_ROOM bytes: the result is a slice of it, good while it is); empty
// when not even the ellipsis fits. A font that is not loaded measures
// nothing: the text comes back whole.
pub fn ellipsized(font: *Text, text: []const u8, width: i32, into: [*]u8) -> []const u8 {
    if text.length == 0 || text_module.measure(font, text) <= width { return text }
    const room = width - text_module.measure(font, ELLIPSIS)
    if room < 0 { return "" }
    // The longest start at most `room` wide, by halving: `low` fits, `high`
    // does not.
    var low: usize = 0
    var high = text.length
    while nextIn(text, low) < high {
        var middle = (low + high) / 2
        while middle > low && text[middle] & 192 == 128 { middle -= 1 }
        if middle == low { middle = nextIn(text, low) }
        if text_module.measure(font, text[0..middle]) <= room { low = middle } else { high = middle }
    }
    // (A start too long for the room is cut at a character.)
    while low + ELLIPSIS.length > TEXT_ROOM {
        low -= 1
        while low > 0 && text[low] & 192 == 128 { low -= 1 }
    }
    // (Blanks before the ellipsis only widen it.)
    while low > 0 && text[low - 1] == 32 { low -= 1 }
    var index: usize = 0
    while index < low {
        into[index] = text[index]
        index += 1
    }
    for byte in ELLIPSIS {
        into[index] = byte
        index += 1
    }
    return into[0..index]
}
