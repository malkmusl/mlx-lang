// nebula ui: the docks: the two dock areas beside the canvas, left and
// right, and the dockers they hold (dockers/registry.mlx).
//
// An area is a column of panels; a panel is a stack of dockers shown as
// tabs, the active one's content below them. Between two panels a grip
// moves the border between them, between an area and the canvas a grip
// sets the area's width (SMALLEST_WIDTH to LARGEST_WIDTH). The arrow at a
// panel's left folds it to its row of tabs. A tab dragged onto another
// panel's tabs or onto the middle of its content joins that panel; onto
// the upper or lower quarter of a panel's content it becomes a panel of
// its own there; onto the edge of the canvas beside an area that is empty
// it opens that area. A docker can be hidden and shown again (the
// Settings menu's list calls toggle, isShown, showAll, hideAll).
//
// The layout is a plain record in the app's SLOT_DOCKS; it names dockers
// by their keys, so a docker that is not in the registry (yet) keeps its
// place and simply is not shown until it is there. Its text form, for the
// settings to keep:
//
//     area left 280
//     area right 280
//     panel 333 0 open color palette
//     panel 333 0 open options presets
//     panel 334 1 folded layers history -overview
//
// an area's width, then its panels: a panel's share of the height (out
// of what all its area's panels share), the tab in front, whether it is
// folded, its dockers' keys in order (a hidden one with "-").
//
//     chrome.layOut:  docks.width(app, AREA_RIGHT) ... docks.place(app, AREA_RIGHT, rect)
//     chrome.draw:    docks.draw(app)
//     the loop:       if docks.key(app, code, modifiers, typed) { ... }
//
// A docker draws itself into its content rectangle inside the kit's clip
// (ui/kit.mlx clipBegin/clipEnd): it cannot draw beside it.
//
// Not done: floating dockers (there is one window); a docker's `wanted`
// height is not used (panels share the height by their shares).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const text_module = @import("std.ui.text")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const kit_module = @import("./kit.mlx")
const dockers = @import("../dockers/registry.mlx")

pub const App = state.App
pub const Docker = state.Docker

pub const AREA_LEFT: usize = 0
pub const AREA_RIGHT: usize = 1
pub const AREAS: usize = 2
// Panels an area holds, dockers a panel holds, bytes of a docker's key.
pub const PANELS: usize = 8
pub const TABS: usize = 8
pub const KEY: usize = 24

// An area's width in logical pixels: its limits and what it starts with.
pub const SMALLEST_WIDTH: i32 = 140
pub const LARGEST_WIDTH: i32 = 480
pub const DEFAULT_WIDTH: i32 = 280

// A panel's row of tabs, the breadth of a grip, a panel's least content.
pub const TAB_ROW: i32 = 26
pub const GRIP: i32 = 5
const LEAST_CONTENT: i32 = 48
// The strip at the canvas's edge a tab is dropped on to open an empty
// area.
const EDGE: i32 = 56
// The shares of an area's panels add up to this after a grip moved.
const SHARES: i32 = 1000

const DROP_NONE: u8 = 0
// Into a panel, at a place among its tabs.
const DROP_INTO: u8 = 1
// A panel of its own, at a place among the area's panels.
const DROP_NEW: u8 = 2

const Entry = struct {
    key: [24]u8
    length: usize
    hidden: bool
    // This frame's tab (empty: not shown).
    tab: ui.Rect
}

const Panel = struct {
    entries: [8]Entry
    count: usize
    active: usize
    folded: bool
    share: i32
    // This frame's row of tabs and content (empty: not shown).
    row: ui.Rect
    content: ui.Rect
}

const Area = struct {
    width: i32
    panels: [8]Panel
    count: usize
    // This frame's place, the grip toward the canvas in it.
    place: ui.Rect
    grip: ui.Rect
}

const Drop = struct {
    kind: u8
    area: usize
    panel: usize
    // The tab's place in the panel (DROP_INTO), the panel's place in the
    // area (DROP_NEW).
    index: usize
}

const Layout = struct {
    ready: bool
    areas: [2]Area
    // A tab being dragged: its docker's id, and where it would go.
    dragging: bool
    dragDocker: u8
    drop: Drop
    // A tab let go this frame: moved once the areas are drawn.
    moving: bool
    moveDocker: u8
}

// ---------------------------------------------------------------------------
// The record

fn layoutOf(app: *App) -> ?*Layout {
    const memory = state.slot(app, state.SLOT_DOCKS, @sizeOf(Layout))
    if memory == null { return null }
    const layout: *Layout = unsafe { @ptrCast(*Layout, memory.?) }
    if !layout.*.ready { setDefaults(layout) }
    return layout
}

fn areaAt(layout: *Layout, which: usize) -> *Area { return &layout.*.areas[which] }

fn panelAt(layout: *Layout, which: usize, index: usize) -> *Panel { return &layout.*.areas[which].panels[index] }

fn entryAt(panel: *Panel, index: usize) -> *Entry { return &panel.*.entries[index] }

fn keyOf(entry: *Entry) -> []const u8 {
    const bytes: [*]const u8 = &entry.*.key
    return bytes[0..entry.*.length]
}

fn setKey(entry: *Entry, key: []const u8) -> void {
    var length: usize = 0
    while length < key.length && length < KEY {
        entry.*.key[length] = key[length]
        length += 1
    }
    entry.*.length = length
}

fn clearPanel(panel: *Panel) -> void {
    panel.*.count = 0
    panel.*.active = 0
    panel.*.folded = false
    panel.*.share = SHARES / 3
    panel.*.row = ui.rect(0, 0, 0, 0)
    panel.*.content = ui.rect(0, 0, 0, 0)
}

fn clearArea(area: *Area) -> void {
    area.*.width = DEFAULT_WIDTH
    area.*.count = 0
    area.*.place = ui.rect(0, 0, 0, 0)
    area.*.grip = ui.rect(0, 0, 0, 0)
}

// Adds `key` to the end of `panel` (nothing when it is full or the key
// does not fit an entry: a key cut short would name no docker).
fn append(panel: *Panel, key: []const u8, hidden: bool) -> void {
    if panel.*.count >= TABS || key.length == 0 || key.length > KEY { return }
    const entry = entryAt(panel, panel.*.count)
    setKey(entry, key)
    entry.*.hidden = hidden
    entry.*.tab = ui.rect(0, 0, 0, 0)
    panel.*.count += 1
}

// A new panel at the end of area `which` (null: it is full).
fn addPanel(layout: *Layout, which: usize) -> ?*Panel {
    const area = areaAt(layout, which)
    if area.*.count >= PANELS { return null }
    const panel = panelAt(layout, which, area.*.count)
    clearPanel(panel)
    area.*.count += 1
    return panel
}

fn setDefaults(layout: *Layout) -> void {
    clearArea(areaAt(layout, AREA_LEFT))
    clearArea(areaAt(layout, AREA_RIGHT))
    layout.*.dragging = false
    layout.*.moving = false
    var panel = addPanel(layout, AREA_RIGHT).?
    append(panel, "color", false)
    append(panel, "palette", false)
    panel = addPanel(layout, AREA_RIGHT).?
    append(panel, "options", false)
    append(panel, "presets", false)
    panel = addPanel(layout, AREA_RIGHT).?
    append(panel, "layers", false)
    append(panel, "history", false)
    append(panel, "overview", false)
    panel.*.share = SHARES - 2 * (SHARES / 3)
    layout.*.ready = true
}

// The docker an entry stands for when it is shown: in the registry and
// not hidden.
fn shownDocker(entry: *Entry) -> ?*const Docker {
    if entry.*.hidden { return null }
    return dockers.byKey(keyOf(entry))
}

fn panelShown(panel: *Panel) -> bool {
    var index: usize = 0
    while index < panel.*.count {
        if shownDocker(entryAt(panel, index)) != null { return true }
        index += 1
    }
    return false
}

fn areaShown(layout: *Layout, which: usize) -> bool {
    const area = areaAt(layout, which)
    var index: usize = 0
    while index < area.*.count {
        if panelShown(panelAt(layout, which, index)) { return true }
        index += 1
    }
    return false
}

// The entry in front of a panel: the active one when it is shown, else
// the first that is (null: none is).
fn frontOf(panel: *Panel) -> ?usize {
    if panel.*.active < panel.*.count && shownDocker(entryAt(panel, panel.*.active)) != null { return panel.*.active }
    var index: usize = 0
    while index < panel.*.count {
        if shownDocker(entryAt(panel, index)) != null { return index }
        index += 1
    }
    return null
}

// Where the docker `key` is in the layout: (area, panel, entry); false
// when it is in none.
fn find(layout: *Layout, key: []const u8, where: *Drop) -> bool {
    var which: usize = 0
    while which < AREAS {
        const area = areaAt(layout, which)
        var index: usize = 0
        while index < area.*.count {
            const panel = panelAt(layout, which, index)
            var at: usize = 0
            while at < panel.*.count {
                if std.text.same(keyOf(entryAt(panel, at)), key) {
                    where.*.kind = DROP_INTO
                    where.*.area = which
                    where.*.panel = index
                    where.*.index = at
                    return true
                }
                at += 1
            }
            index += 1
        }
        which += 1
    }
    return false
}

fn removeEntry(panel: *Panel, index: usize) -> void {
    if index >= panel.*.count { return }
    var at = index
    while at + 1 < panel.*.count {
        panel.*.entries[at] = panel.*.entries[at + 1]
        at += 1
    }
    panel.*.count -= 1
    if panel.*.active > index || (panel.*.active == index && panel.*.active >= panel.*.count && panel.*.active > 0) { panel.*.active -= 1 }
}

fn insertEntry(panel: *Panel, index: usize, entry: *const Entry) -> bool {
    if panel.*.count >= TABS { return false }
    const place = if index > panel.*.count { panel.*.count } else { index }
    var at = panel.*.count
    while at > place {
        panel.*.entries[at] = panel.*.entries[at - 1]
        at -= 1
    }
    panel.*.entries[place] = entry.*
    panel.*.count += 1
    panel.*.active = place
    return true
}

fn removePanel(layout: *Layout, which: usize, index: usize) -> void {
    const area = areaAt(layout, which)
    if index >= area.*.count { return }
    var at = index
    while at + 1 < area.*.count {
        area.*.panels[at] = area.*.panels[at + 1]
        at += 1
    }
    area.*.count -= 1
}

// A new empty panel at `index` of area `which` (null: the area is full).
fn insertPanel(layout: *Layout, which: usize, index: usize) -> ?*Panel {
    const area = areaAt(layout, which)
    if area.*.count >= PANELS { return null }
    const place = if index > area.*.count { area.*.count } else { index }
    var at = area.*.count
    while at > place {
        area.*.panels[at] = area.*.panels[at - 1]
        at -= 1
    }
    area.*.count += 1
    const panel = panelAt(layout, which, place)
    clearPanel(panel)
    // It shares the height as the others do on average.
    var total: i32 = 0
    var others: i32 = 0
    var index_other: usize = 0
    while index_other < area.*.count {
        if index_other != place {
            total += panelAt(layout, which, index_other).*.share
            others += 1
        }
        index_other += 1
    }
    panel.*.share = if others > 0 && total > 0 { total / others } else { SHARES / 3 }
    return panel
}

// ---------------------------------------------------------------------------
// Where things are (chrome.layOut asks)

fn px(app: *App, value: i32) -> i32 { return state.px(app, value) }

// The width area `which` wants: its own when a docker in it is shown, 0
// when none is.
pub fn width(app: *App, which: usize) -> i32 {
    const layout = layoutOf(app)
    if layout == null || which >= AREAS || !areaShown(layout.?, which) { return 0 }
    return px(app, areaAt(layout.?, which).*.width)
}

// The width area `which` is set to (whether or not it is shown).
pub fn areaWidth(app: *App, which: usize) -> i32 {
    const layout = layoutOf(app)
    if layout == null || which >= AREAS { return 0 }
    return areaAt(layout.?, which).*.width
}

// Sets area `which`'s width (held within its limits).
pub fn setAreaWidth(app: *App, which: usize, logical: i32) -> void {
    const layout = layoutOf(app)
    if layout == null || which >= AREAS { return }
    areaAt(layout.?, which).*.width = if logical < SMALLEST_WIDTH { SMALLEST_WIDTH } else if logical > LARGEST_WIDTH { LARGEST_WIDTH } else { logical }
    api.redraw(app)
}

// Area `which` is at `place` this frame (empty: not shown): its grip and
// its panels are laid out in it.
pub fn place(app: *App, which: usize, where: ui.Rect) -> void {
    const layout = layoutOf(app)
    if layout == null || which >= AREAS { return }
    const area = areaAt(layout.?, which)
    var index: usize = 0
    while index < area.*.count {
        const panel = panelAt(layout.?, which, index)
        panel.*.row = ui.rect(0, 0, 0, 0)
        panel.*.content = ui.rect(0, 0, 0, 0)
        var at: usize = 0
        while at < panel.*.count {
            entryAt(panel, at).*.tab = ui.rect(0, 0, 0, 0)
            at += 1
        }
        index += 1
    }
    area.*.place = where
    area.*.grip = ui.rect(0, 0, 0, 0)
    if ui.isEmpty(where) { return }
    const grip = px(app, GRIP)
    // The grip is on the canvas's side.
    var inner = where
    if which == AREA_LEFT {
        area.*.grip = ui.takeRight(&inner, grip)
    } else {
        area.*.grip = ui.takeLeft(&inner, grip)
    }
    // The height: a row of tabs for each panel shown, grips between them,
    // the rest to the open ones by their shares.
    var shown: i32 = 0
    var open: i32 = 0
    var shares: i32 = 0
    index = 0
    while index < area.*.count {
        const panel = panelAt(layout.?, which, index)
        if panelShown(panel) {
            shown += 1
            if !panel.*.folded {
                open += 1
                shares += if panel.*.share > 0 { panel.*.share } else { 1 }
            }
        }
        index += 1
    }
    if shown == 0 { return }
    var rest = inner.height - shown * px(app, TAB_ROW) - (shown - 1) * grip
    if rest < 0 { rest = 0 }
    var y = inner.y
    var given: i32 = 0
    var opened: i32 = 0
    index = 0
    while index < area.*.count {
        const panel = panelAt(layout.?, which, index)
        if panelShown(panel) {
            // (In an area too short for every row those that do not fit
            // are not shown: nothing of the area lies outside it.)
            if y + px(app, TAB_ROW) > ui.bottom(inner) { return }
            panel.*.row = ui.rect(inner.x, y, inner.width, px(app, TAB_ROW))
            y += px(app, TAB_ROW)
            if !panel.*.folded {
                opened += 1
                const share = if panel.*.share > 0 { panel.*.share } else { 1 }
                // The last open panel takes what rounding left.
                const height = if opened == open { rest - given } else { @intCast(i32, @intCast(i64, rest) * @intCast(i64, share) / @intCast(i64, shares)) }
                panel.*.content = ui.rect(inner.x, y, inner.width, height)
                given += height
                y += height
            }
            y += grip
        }
        index += 1
    }
}

// Whether a panel is shown open this frame: its content may be 0 pixels
// tall (shares far apart, a short window), and the grips beside it still
// resize it.
fn isOpen(panel: *Panel) -> bool { return !ui.isEmpty(panel.*.row) && !panel.*.folded }

// ---------------------------------------------------------------------------
// Drawing

fn tabId(docker: u8) -> u64 { return view.idOf(view.id("nebula.docks.tab"), @intCast(usize, docker)) }
fn foldId(which: usize, index: usize) -> u64 { return view.idOf(view.id("nebula.docks.fold"), which * PANELS + index) }
fn splitId(which: usize, index: usize) -> u64 { return view.idOf(view.id("nebula.docks.split"), which * PANELS + index) }
fn widthId(which: usize) -> u64 { return view.idOf(view.id("nebula.docks.width"), which) }

fn titleOf(app: *App, docker: *const Docker) -> []const u8 {
    return state.tr(app, docker.*.name, docker.*.german)
}

// A panel's row of tabs: the fold arrow, a tab for each docker shown.
fn drawRow(app: *App, layout: *Layout, which: usize, index: usize, panel: *Panel, front: usize) -> void {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = widgets.*.canvas
    const s = app.*.scale
    const row = panel.*.row
    canvas_module.fillRect(canvas, row.x, row.y, row.width, row.height, theme.*.background)
    canvas_module.fillRect(canvas, row.x, ui.bottom(row) - s, row.width, s, theme.*.divider)
    var open = !panel.*.folded
    if kit_module.expander(k, foldId(which, index), row.x + px(app, 8), row.y + (row.height - px(app, 10)) / 2, &open) {
        panel.*.folded = !open
        api.redraw(app)
    }
    // The tabs share what is left; each as wide as its name when they fit.
    const left = row.x + px(app, 22)
    const room = ui.right(row) - left - px(app, 4)
    var shown: i32 = 0
    var natural: i32 = 0
    var at: usize = 0
    while at < panel.*.count {
        const docker = shownDocker(entryAt(panel, at))
        if docker != null {
            shown += 1
            natural += tabWidth(app, docker.?)
        }
        at += 1
    }
    if shown == 0 || room <= 0 { return }
    const share = room / shown
    var x = left
    at = 0
    while at < panel.*.count {
        const entry = entryAt(panel, at)
        const docker = shownDocker(entry)
        if docker != null {
            const wide = if natural > room { share } else { tabWidth(app, docker.?) }
            const tab = ui.rect(x, row.y + px(app, 3), wide, row.height - px(app, 3) - s)
            entry.*.tab = tab
            drawTab(app, layout, panel, at, docker.?, tab, at == front)
            x += wide
        }
        at += 1
    }
}

fn tabWidth(app: *App, docker: *const Docker) -> i32 {
    return text_module.measure(state.smallOf(app), titleOf(app, docker)) + px(app, 22)
}

fn drawTab(app: *App, layout: *Layout, panel: *Panel, at: usize, docker: *const Docker, tab: ui.Rect, chosen: bool) -> void {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = widgets.*.canvas
    const s = app.*.scale
    const id = tabId(docker.*.id)
    view.region(widgets, id, tab)
    if kit_module.dragRow(k, id, tab) {
        layout.*.dragging = true
        layout.*.dragDocker = docker.*.id
    }
    if kit_module.dropped(k, id) {
        layout.*.moving = true
        layout.*.moveDocker = docker.*.id
    } else if view.takeClick(widgets, id) && panel.*.active != at {
        panel.*.active = at
        api.redraw(app)
    }
    const lit = view.isHover(widgets, id)
    if chosen {
        // The tab in front is of the content's colour: one surface.
        canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, tab.height + s, theme.*.panel)
        canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, 2 * s, theme.*.accent)
    } else if lit {
        canvas_module.fillRect(canvas, tab.x, tab.y, tab.width, tab.height, theme.*.hover)
    }
    kit_module.label(k, ui.rect(tab.x + px(app, 8), tab.y + s, tab.width - px(app, 16), tab.height - s), titleOf(app, docker), if chosen || lit { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_CENTER)
}

// Moves the grip between open panels `upper` and `lower` by `moved`
// pixels: their contents' heights change, every open panel's share
// becomes its height (out of SHARES).
fn moveBorder(app: *App, layout: *Layout, which: usize, upper: usize, lower: usize, moved: i32) -> void {
    const above = panelAt(layout, which, upper)
    const below = panelAt(layout, which, lower)
    const least = px(app, LEAST_CONTENT)
    const sum = above.*.content.height + below.*.content.height
    if sum < least * 2 { return }
    var top = above.*.content.height + moved
    if top < least { top = least }
    if top > sum - least { top = sum - least }
    const area = areaAt(layout, which)
    var total: i32 = 0
    var index: usize = 0
    while index < area.*.count {
        const panel = panelAt(layout, which, index)
        if isOpen(panel) {
            if index == upper {
                total += top
            } else if index == lower {
                total += sum - top
            } else {
                total += panel.*.content.height
            }
        }
        index += 1
    }
    if total <= 0 { return }
    index = 0
    while index < area.*.count {
        const panel = panelAt(layout, which, index)
        if isOpen(panel) {
            const height = if index == upper { top } else if index == lower { sum - top } else { panel.*.content.height }
            var share = @intCast(i32, @intCast(i64, height) * @intCast(i64, SHARES) / @intCast(i64, total))
            if share < 1 { share = 1 }
            panel.*.share = share
        }
        index += 1
    }
    api.redraw(app)
}

fn drawArea(app: *App, layout: *Layout, which: usize) -> void {
    const area = areaAt(layout, which)
    if ui.isEmpty(area.*.place) { return }
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const where = area.*.place
    canvas_module.fillRect(widgets.*.canvas, where.x, where.y, where.width, where.height, theme.*.glass)
    // The grip toward the canvas: dragging it sets the width.
    const moved = kit_module.splitter(k, widthId(which), area.*.grip, true)
    if moved != 0 {
        // From the width it has now (the window may have made it narrower
        // than it is set to), held within the limits.
        const wanted = if which == AREA_LEFT { where.width + moved } else { where.width - moved }
        var logical = wanted / (if app.*.scale > 0 { app.*.scale } else { 1 })
        if logical < SMALLEST_WIDTH { logical = SMALLEST_WIDTH }
        if logical > LARGEST_WIDTH { logical = LARGEST_WIDTH }
        area.*.width = logical
        api.redraw(app)
    }
    // The panel shown before the one drawn now, and whether it is open:
    // a grip between two open ones moves their border, else a line.
    var previous: usize = 0
    var previous_shown = false
    var previous_open = false
    var index: usize = 0
    while index < area.*.count {
        const panel = panelAt(layout, which, index)
        if !ui.isEmpty(panel.*.row) {
            const front = frontOf(panel)
            if previous_shown {
                const grip = ui.rect(panel.*.row.x, panel.*.row.y - px(app, GRIP), panel.*.row.width, px(app, GRIP))
                if previous_open && isOpen(panel) {
                    const shift = kit_module.splitter(k, splitId(which, index), grip, false)
                    if shift != 0 { moveBorder(app, layout, which, previous, index, shift) }
                } else {
                    kit_module.separator(k, grip)
                }
            }
            drawRow(app, layout, which, index, panel, if front == null { 0 } else { front.? })
            if !ui.isEmpty(panel.*.content) && front != null {
                const docker = shownDocker(entryAt(panel, front.?)).?
                kit_module.clipBegin(k, panel.*.content)
                docker.*.draw(app, panel.*.content)
                kit_module.clipEnd(k)
            }
            previous = index
            previous_shown = true
            previous_open = isOpen(panel)
        }
        index += 1
    }
}

// Where a tab let go at (x, y) would go.
fn dropAt(app: *App, layout: *Layout, x: i32, y: i32) -> Drop {
    var drop = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
    var which: usize = 0
    while which < AREAS {
        const area = areaAt(layout, which)
        var index: usize = 0
        while index < area.*.count {
            const panel = panelAt(layout, which, index)
            if ui.contains(panel.*.row, x, y) {
                drop.kind = DROP_INTO
                drop.area = which
                drop.panel = index
                drop.index = panel.*.count
                var at: usize = 0
                while at < panel.*.count {
                    const tab = entryAt(panel, at).*.tab
                    if !ui.isEmpty(tab) && x < tab.x + tab.width / 2 {
                        drop.index = at
                        return drop
                    }
                    at += 1
                }
                return drop
            }
            const content = panel.*.content
            if ui.contains(content, x, y) {
                drop.area = which
                if y < content.y + content.height / 4 {
                    drop.kind = DROP_NEW
                    drop.panel = index
                    drop.index = index
                } else if y >= content.y + content.height * 3 / 4 {
                    drop.kind = DROP_NEW
                    drop.panel = index
                    drop.index = index + 1
                } else {
                    drop.kind = DROP_INTO
                    drop.panel = index
                    drop.index = panel.*.count
                }
                return drop
            }
            index += 1
        }
        which += 1
    }
    // The edge of the canvas beside an area that shows nothing opens it.
    const canvas = app.*.canvasArea
    if ui.contains(canvas, x, y) {
        const edge = px(app, EDGE)
        if x < canvas.x + edge && !areaShown(layout, AREA_LEFT) {
            drop.kind = DROP_NEW
            drop.area = AREA_LEFT
            drop.index = 0
        } else if x >= ui.right(canvas) - edge && !areaShown(layout, AREA_RIGHT) {
            drop.kind = DROP_NEW
            drop.area = AREA_RIGHT
            drop.index = 0
        }
    }
    return drop
}

// The mark of where the dragged tab would go.
fn drawDrop(app: *App, layout: *Layout, drop: Drop) -> void {
    const k = api.kit(app)
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const canvas = widgets.*.canvas
    const s = app.*.scale
    if drop.kind == DROP_NONE { return }
    const area = areaAt(layout, drop.area)
    if drop.kind == DROP_INTO {
        const panel = panelAt(layout, drop.area, drop.panel)
        var whole = panel.*.row
        if !ui.isEmpty(panel.*.content) { whole.height = ui.bottom(panel.*.content) - whole.y }
        canvas_module.strokeRoundedRect(canvas, whole.x + s, whole.y + s, whole.width - 2 * s, whole.height - 2 * s, theme.*.smallRadius, 2 * s, theme.*.accent)
        return
    }
    if area.*.count == 0 || !areaShown(layout, drop.area) {
        // A new area at the canvas's edge.
        const edge = px(app, EDGE)
        const canvas_area = app.*.canvasArea
        const x = if drop.area == AREA_LEFT { canvas_area.x } else { ui.right(canvas_area) - edge }
        canvas_module.fillRect(canvas, x, canvas_area.y, edge, canvas_area.height, theme_module.mix(0, theme.*.accent, 300))
        canvas_module.strokeRoundedRect(canvas, x + 2 * s, canvas_area.y + 2 * s, edge - 4 * s, canvas_area.height - 4 * s, theme.*.smallRadius, 2 * s, theme.*.accent)
        return
    }
    // Between two panels: at the top of the panel at `index`, or under
    // the last one.
    var y = ui.bottom(area.*.place)
    var index = drop.index
    while index < area.*.count {
        const row = panelAt(layout, drop.area, index).*.row
        if !ui.isEmpty(row) {
            y = row.y - px(app, GRIP) / 2
            break
        }
        index += 1
    }
    if index >= area.*.count {
        // Under the last panel shown: its bottom.
        var at = area.*.count
        while at > 0 {
            at -= 1
            const panel = panelAt(layout, drop.area, at)
            if !ui.isEmpty(panel.*.row) {
                const bottom = if ui.isEmpty(panel.*.content) { ui.bottom(panel.*.row) } else { ui.bottom(panel.*.content) }
                y = bottom - 2 * s
                break
            }
        }
    }
    const inner = area.*.place
    kit_module.dropLine(k, if y < inner.y + 2 * s { inner.y + 2 * s } else { y }, inner.x + px(app, 10), ui.right(inner) - px(app, 10))
}

// Moves docker `id`'s tab where `drop` says.
fn moveTab(app: *App, layout: *Layout, id: u8, drop: Drop) -> void {
    const docker = dockers.find(id)
    if docker == null || drop.kind == DROP_NONE { return }
    var source = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
    if !find(layout, docker.?.*.key, &source) { return }
    const from_panel = panelAt(layout, source.area, source.panel)
    const moved = from_panel.*.entries[source.index]
    if drop.kind == DROP_INTO {
        const into = panelAt(layout, drop.area, drop.panel)
        if drop.area == source.area && drop.panel == source.panel {
            // Another place among the same panel's tabs.
            removeEntry(into, source.index)
            const index = if source.index < drop.index { drop.index - 1 } else { drop.index }
            _ = insertEntry(into, index, &moved)
        } else {
            if !insertEntry(into, drop.index, &moved) { return }
            removeEntry(from_panel, source.index)
            if from_panel.*.count == 0 { removePanel(layout, source.area, source.panel) }
        }
    } else {
        // Its own panel: nothing to do when it is one already, there.
        if drop.area == source.area && from_panel.*.count == 1 && (drop.index == source.panel || drop.index == source.panel + 1) { return }
        const made = insertPanel(layout, drop.area, drop.index)
        if made == null { return }
        _ = insertEntry(made.?, 0, &moved)
        var from = source.panel
        if drop.area == source.area && drop.index <= source.panel { from += 1 }
        const old = panelAt(layout, source.area, from)
        removeEntry(old, source.index)
        if old.*.count == 0 { removePanel(layout, source.area, from) }
    }
    api.redraw(app)
}

// Draws both areas (where chrome placed them) and what a dragged tab
// would do.
pub fn draw(app: *App) -> void {
    const layout = layoutOf(app)
    if layout == null { return }
    layout.?.*.dragging = false
    layout.?.*.moving = false
    drawArea(app, layout.?, AREA_LEFT)
    drawArea(app, layout.?, AREA_RIGHT)
    const widgets = state.uiOf(app)
    if layout.?.*.dragging {
        layout.?.*.drop = dropAt(app, layout.?, widgets.*.pointerX, widgets.*.pointerY)
        drawDrop(app, layout.?, layout.?.*.drop)
    }
    if layout.?.*.moving {
        moveTab(app, layout.?, layout.?.*.moveDocker, dropAt(app, layout.?, widgets.*.pointerX, widgets.*.pointerY))
        layout.?.*.moving = false
    }
}

// ---------------------------------------------------------------------------
// Keys

// A key for the docker the pointer is over (its keyPress): true when it
// took it.
pub fn key(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const layout = layoutOf(app)
    if layout == null || app.*.canvasOnly { return false }
    var which: usize = 0
    while which < AREAS {
        const area = areaAt(layout.?, which)
        var index: usize = 0
        while index < area.*.count {
            const panel = panelAt(layout.?, which, index)
            if ui.contains(panel.*.content, app.*.pointerX, app.*.pointerY) {
                const front = frontOf(panel)
                if front == null { return false }
                const docker = shownDocker(entryAt(panel, front.?)).?
                if docker.*.keyPress == null { return false }
                return docker.*.keyPress.?(app, code, modifiers, typed)
            }
            index += 1
        }
        which += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Showing and hiding dockers

// Whether docker `id` is shown: in the registry, in a panel, not hidden.
pub fn isShown(app: *App, id: u8) -> bool {
    const layout = layoutOf(app)
    const docker = dockers.find(id)
    if layout == null || docker == null { return false }
    var where = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
    if !find(layout.?, docker.?.*.key, &where) { return false }
    return !panelAt(layout.?, where.area, where.panel).*.entries[where.index].hidden
}

// Shows a docker that is not in any panel: a tab of the right area's last
// panel (a panel of its own when there is none or it is full).
fn addShown(layout: *Layout, key: []const u8) -> void {
    if key.length == 0 || key.length > KEY { return }
    const area = areaAt(layout, AREA_RIGHT)
    var panel: ?*Panel = null
    if area.*.count > 0 && panelAt(layout, AREA_RIGHT, area.*.count - 1).*.count < TABS { panel = panelAt(layout, AREA_RIGHT, area.*.count - 1) }
    if panel == null { panel = insertPanel(layout, AREA_RIGHT, area.*.count) }
    if panel == null { return }
    append(panel.?, key, false)
    panel.?.*.active = panel.?.*.count - 1
}

fn setShown(layout: *Layout, key: []const u8, shown: bool) -> void {
    var where = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
    if find(layout, key, &where) {
        const panel = panelAt(layout, where.area, where.panel)
        panel.*.entries[where.index].hidden = !shown
        if shown { panel.*.active = where.index }
        return
    }
    if shown { addShown(layout, key) }
}

// Hides docker `id` when it is shown, shows it (in front of its panel)
// when it is not.
pub fn toggle(app: *App, id: u8) -> void {
    const layout = layoutOf(app)
    const docker = dockers.find(id)
    if layout == null || docker == null { return }
    setShown(layout.?, docker.?.*.key, !isShown(app, id))
    api.redraw(app)
}

// Every docker of the registry shown (those in no panel join the right
// area's last).
pub fn showAll(app: *App) -> void {
    setAll(app, true)
}

// Every docker of the registry hidden (each keeps its place).
pub fn hideAll(app: *App) -> void {
    setAll(app, false)
}

fn setAll(app: *App, shown: bool) -> void {
    const layout = layoutOf(app)
    if layout == null { return }
    const count = dockers.count()
    var index: usize = 0
    while index < count {
        const docker = dockers.at(index)
        if docker != null { setShown(layout.?, docker.?.*.key, shown) }
        index += 1
    }
    api.redraw(app)
}

// The layout as it is at the start.
pub fn defaults(app: *App) -> void {
    const layout = layoutOf(app)
    if layout == null { return }
    setDefaults(layout.?)
    api.redraw(app)
}

// ---------------------------------------------------------------------------
// Where things were this frame (for tests and for whoever points at a
// docker)

// The content rectangle docker `id` is drawn in (empty: it is not shown,
// not in front of its panel, or its panel is folded).
pub fn contentOf(app: *App, id: u8) -> ui.Rect {
    const layout = layoutOf(app)
    const docker = dockers.find(id)
    if layout == null || docker == null { return ui.rect(0, 0, 0, 0) }
    var where = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
    if !find(layout.?, docker.?.*.key, &where) { return ui.rect(0, 0, 0, 0) }
    const panel = panelAt(layout.?, where.area, where.panel)
    const front = frontOf(panel)
    if front == null || front.? != where.index { return ui.rect(0, 0, 0, 0) }
    return panel.*.content
}

// Docker `id`'s tab (empty: not shown).
pub fn tabOf(app: *App, id: u8) -> ui.Rect {
    const layout = layoutOf(app)
    const docker = dockers.find(id)
    if layout == null || docker == null { return ui.rect(0, 0, 0, 0) }
    var where = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
    if !find(layout.?, docker.?.*.key, &where) { return ui.rect(0, 0, 0, 0) }
    return panelAt(layout.?, where.area, where.panel).*.entries[where.index].tab
}

// The fold arrow's place on the row of the panel docker `id` is in (empty:
// not shown).
pub fn foldOf(app: *App, id: u8) -> ui.Rect {
    const layout = layoutOf(app)
    const docker = dockers.find(id)
    if layout == null || docker == null { return ui.rect(0, 0, 0, 0) }
    var where = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
    if !find(layout.?, docker.?.*.key, &where) { return ui.rect(0, 0, 0, 0) }
    const row = panelAt(layout.?, where.area, where.panel).*.row
    if ui.isEmpty(row) { return row }
    return ui.rect(row.x + px(app, 4), row.y + (row.height - px(app, 16)) / 2, px(app, 16), px(app, 16))
}

// The grip between area `which` and the canvas (empty: not shown).
pub fn gripOf(app: *App, which: usize) -> ui.Rect {
    const layout = layoutOf(app)
    if layout == null || which >= AREAS { return ui.rect(0, 0, 0, 0) }
    return areaAt(layout.?, which).*.grip
}

// ---------------------------------------------------------------------------
// The text form

fn appendNumber(into: *std.ArrayList(u8), value: i32) -> bool {
    var digits: [16]u8 = undefined
    const bytes: [*]u8 = &digits
    const length = std.text.appendSigned(bytes, 0, 16, @intCast(isize, value))
    return into.*.appendSlice(bytes[0..length])
}

// The layout as text (the form in the header), after what `into` holds.
// False without memory.
pub fn write(app: *App, into: *std.ArrayList(u8)) -> bool {
    const layout = layoutOf(app)
    if layout == null { return false }
    var which: usize = 0
    while which < AREAS {
        const area = areaAt(layout.?, which)
        if !into.*.appendSlice(if which == AREA_LEFT { "area left " } else { "area right " }) { return false }
        if !appendNumber(into, area.*.width) || !into.*.append(10) { return false }
        var index: usize = 0
        while index < area.*.count {
            const panel = panelAt(layout.?, which, index)
            if !into.*.appendSlice("panel ") || !appendNumber(into, panel.*.share) || !into.*.append(32) { return false }
            if !appendNumber(into, @intCast(i32, panel.*.active)) { return false }
            if !into.*.appendSlice(if panel.*.folded { " folded" } else { " open" }) { return false }
            var at: usize = 0
            while at < panel.*.count {
                const entry = entryAt(panel, at)
                if !into.*.append(32) { return false }
                if entry.*.hidden && !into.*.append(45) { return false }
                if !into.*.appendSlice(keyOf(entry)) { return false }
                at += 1
            }
            if !into.*.append(10) { return false }
            index += 1
        }
        which += 1
    }
    return true
}

fn isBlank(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

fn nextWord(text: []const u8, at: *usize) -> []const u8 {
    var start = at.*
    while start < text.length && isBlank(text[start]) { start += 1 }
    var end = start
    while end < text.length && !isBlank(text[end]) { end += 1 }
    at.* = end
    return text[start..end]
}

fn wholeNumber(text: []const u8, into: *i32) -> bool {
    if text.length == 0 || text.length > 6 { return false }
    var value: i32 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return false }
        value = value * 10 + @intCast(i32, byte - 48)
    }
    into.* = value
    return true
}

// Reads `text` into `layout` (which is cleared first); false when a line
// is not of the form, an area is not named exactly once, the layout's
// limits are passed, a key is longer than a key can be or is named twice
// (one docker has one tab).
fn parse(layout: *Layout, text: []const u8) -> bool {
    clearArea(areaAt(layout, AREA_LEFT))
    clearArea(areaAt(layout, AREA_RIGHT))
    layout.*.dragging = false
    layout.*.moving = false
    var which: usize = AREAS
    var named: [2]bool = [2]bool{ false, false }
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        at = end + 1
        var cursor: usize = 0
        const first = nextWord(line, &cursor)
        if first.length == 0 { continue }
        if std.text.same(first, "area") {
            const side = nextWord(line, &cursor)
            if std.text.same(side, "left") {
                which = AREA_LEFT
            } else if std.text.same(side, "right") {
                which = AREA_RIGHT
            } else {
                return false
            }
            if named[which] { return false }
            named[which] = true
            var wide: i32 = 0
            if !wholeNumber(nextWord(line, &cursor), &wide) { return false }
            areaAt(layout, which).*.width = if wide < SMALLEST_WIDTH { SMALLEST_WIDTH } else if wide > LARGEST_WIDTH { LARGEST_WIDTH } else { wide }
            if nextWord(line, &cursor).length != 0 { return false }
        } else if std.text.same(first, "panel") {
            if which >= AREAS { return false }
            var share: i32 = 0
            var active: i32 = 0
            if !wholeNumber(nextWord(line, &cursor), &share) || !wholeNumber(nextWord(line, &cursor), &active) { return false }
            const fold = nextWord(line, &cursor)
            if !std.text.same(fold, "open") && !std.text.same(fold, "folded") { return false }
            const panel = addPanel(layout, which)
            if panel == null { return false }
            panel.?.*.share = if share < 1 { 1 } else { share }
            panel.?.*.folded = std.text.same(fold, "folded")
            while true {
                const word = nextWord(line, &cursor)
                if word.length == 0 { break }
                const hidden = word[0] == 45
                const name = if hidden { word[1..] } else { word }
                if name.length == 0 || name.length > KEY || panel.?.*.count >= TABS { return false }
                var where = Drop.{ .kind = DROP_NONE, .area = 0, .panel = 0, .index = 0 }
                if find(layout, name, &where) { return false }
                append(panel.?, name, hidden)
            }
            if panel.?.*.count == 0 { return false }
            panel.?.*.active = if @intCast(usize, active) < panel.?.*.count { @intCast(usize, active) } else { 0 }
        } else {
            return false
        }
    }
    if !named[AREA_LEFT] || !named[AREA_RIGHT] { return false }
    layout.*.ready = true
    return true
}

// Takes the layout from `text` (write's form: both areas named once, a
// docker at most once). False, and the layout as it was, when the text is
// not of that form.
pub fn read(app: *App, text: []const u8) -> bool {
    const layout = layoutOf(app)
    if layout == null { return false }
    const memory = app.*.allocator.alloc(@sizeOf(Layout), 16)
    if memory == null { return false }
    const trial: *Layout = unsafe { @ptrCast(*Layout, memory.?) }
    const good = parse(trial, text)
    if good { std.mem.copy(unsafe { @ptrCast([*]u8, layout.?) }, memory.?, @sizeOf(Layout)) }
    app.*.allocator.free(memory.?, @sizeOf(Layout), 16)
    if good { api.redraw(app) }
    return good
}
