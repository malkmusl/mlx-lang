// nebula ui: dialogs: the things that ask. The window is the only one, so
// a dialog is drawn inside it, over everything (app/loop.mlx draws
// app.dialogs after the bars, each over a region of the whole window that
// swallows presses), and keys go to the one on top. Every part of the
// program asks through these:
//
//     dialogs.message(app, "Saved", "The picture was written.", dialogs.INFO)
//     dialogs.confirm(app, "Delete Layer", "Delete it?", "Delete", "Keep", deleteIt, null)
//     dialogs.choose3(app, "Close", "Save the changes?", "Save", "Discard", "Cancel", save, discard, null)
//     dialogs.prompt(app, "Rename", "Name", current, renameTo)     // renameTo(app, text)
//     dialogs.pickColor(app, "Foreground", app.*.foreground, setColor, true)
//     dialogs.newImage(app)  dialogs.layerProperties(app, node)  dialogs.about(app)
//     dialogs.progressBegin(app, "Exporting") ... progressUpdate(app, 0.5, "Layer 3") ... progressEnd(app)
//
// Each copies what it is given (the caller's strings need not live on),
// keeps it in state.SLOT_DIALOGS, pushes a state.Dialog through
// api.pushDialog and closes itself when it is answered; the caller's
// function for that answer runs then, once the frame that took the
// answer is done with the dialog. Several stack (a confirm over a form):
// only the one on top takes keys and the pointer. Escape and the close
// cross cancel (the 'no' or 'cancel' function runs), Enter presses the
// button the keys are on (the primary one until Tab, Shift+Tab or the
// arrows move them: in dialogs that have no text field), Page Up and
// Down, Home and End scroll a dialog whose content does not fit.
//
// The look: a dim veil over the window, a centred opaque panel with a
// shadow, a title row with a close cross, the content, a row of buttons
// at the bottom right. A dialog is held inside the window (12 pixels from
// its edges): smaller than it wants in a small window, its content then
// scrolls (the bar is dragged, the keys above work; brixOS has no wheel).
// Sizes are logical pixels times the theme's scale.
//
// Others build their own dialogs from the same pieces: frame() for the
// panel, buttons() for the row of buttons, labelled() for a row with a
// label in a fixed column and the field's rectangle, scrollBegin() /
// scrollEnd() around content that may not fit; and host() to be one of
// the dialogs handled here (ui/forms.mlx is): its body memory, its keys,
// its answer.
//
// The progress dialog is honest about one thread: it is drawn only when
// the loop gets to draw a frame, so a long piece of work shows it only if
// it is done in pieces that give the loop its turn in between (a tool's
// tick, an action that goes on at the next tick); one long call shows
// nothing until it returns. Its Cancel button and Escape only raise a
// flag (progressCancelled) that the work reads between its pieces; the
// work ends the dialog (progressEnd).
//
// Not done: a dialog cannot be moved or resized; there is no version
// number to show in About (the build writes none into the program); the
// New Image dialog keeps the pixels when the resolution changes (the size
// in millimetres or inches follows); Layer Properties shows nothing on
// the canvas before OK (it changes nothing until then).
const std = @import("std")
const builtin = @import("builtin")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const popup = @import("std.ui.popup")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const documents = @import("../app/documents.mlx")
const kit_module = @import("./kit.mlx")
const icons = @import("./icons.mlx")
const color_module = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const ops = @import("../core/ops.mlx")
const blend = @import("../core/blend.mlx")

pub const App = state.App
pub const Node = node_module.Node

// What message() shows: a note, a warning, an error.
pub const INFO: u8 = 0
pub const WARNING: u8 = 1
pub const ERROR: u8 = 2

// An answer: the dialog was cancelled (Escape, the close cross, its
// Cancel button).
pub const CANCEL: usize = 18446744073709551615

// The parts of a dialog, for idOf() and partId(): its close cross, its
// buttons (PART_BUTTON + the button's number), its scrolled body, its
// fields (PART_FIELD + the field's number, in the order the dialog draws
// them; a form's are its rows).
pub const PART_CLOSE: usize = 0
pub const PART_BUTTON: usize = 1
pub const PART_SCROLL: usize = 24
pub const PART_FIELD: usize = 32
const PARTS: usize = 1024

// A field's row, the gap under it (labelled() leaves it) and a button's
// height (times the theme's scale).
pub const ROW: i32 = 24
pub const GAP: i32 = 6
pub const BUTTON_HEIGHT: i32 = 26
const TITLE_HEIGHT: i32 = 36
const PAD: i32 = 14
const LABEL_WIDTH: i32 = 112
const MARGIN: i32 = 12
const BUTTON_MIN: i32 = 84
const BUTTON_GAP: i32 = 8

// app.dialogs has room for four (state.DIALOGS): a level each.
const LEVELS: usize = 4
const BODY_BYTES: usize = 4096
const NO_LEVEL: usize = 18446744073709551615
const NO_FOCUS: usize = 18446744073709551615

// What a dialog keeps of the texts it is given.
const TITLE: usize = 128
const TEXT: usize = 1024
const LABEL: usize = 48
const ANSWER: usize = 256
// A message wraps to this many lines at most.
const MOST_LINES: usize = 40

// The kinds of body (Hooks.kind) of the dialogs here; ui/forms.mlx's
// form is 16.
const KIND_MESSAGE: u8 = 1
const KIND_CHOICE: u8 = 2
const KIND_PROMPT: u8 = 3
const KIND_COLOR: u8 = 4
const KIND_NEW_IMAGE: u8 = 5
const KIND_LAYER: u8 = 6
const KIND_ABOUT: u8 = 7
const KIND_PROGRESS: u8 = 8

// ---------------------------------------------------------------------------
// Hosting: the dialogs handled here, a level of app.dialogs each

// Draws the body of the dialog at `level` (frame(), buttons(), ...).
pub const BodyDraw = fn(app: *state.App, level: usize, window: ui.Rect) -> void
// A key for the dialog at `level` (when no text edit or list of the kit
// has it); true: used. Escape, Enter, Tab and the scrolling keys it
// leaves are handled here.
pub const BodyKey = fn(app: *state.App, level: usize, code: u32, modifiers: u32, typed: []const u8) -> bool
// The dialog at `level` was answered (a button's number, or CANCEL) and
// is closed already; its body is as it was. Runs the caller's function:
// read what it needs from the body before calling it (it may open a
// dialog that takes the same body).
pub const BodyFinish = fn(app: *state.App, level: usize, answer: usize) -> void

pub const Hooks = struct {
    // A number for find() (the kinds here are below 16).
    kind: u8
    draw: fn(app: *state.App, level: usize, window: ui.Rect) -> void
    key: ?fn(app: *state.App, level: usize, code: u32, modifiers: u32, typed: []const u8) -> bool
    finish: fn(app: *state.App, level: usize, answer: usize) -> void
    // Tab and the arrows move between the buttons (no text field here).
    tabs: bool
    // A close cross in the title (Escape cancels too).
    closable: bool
}

const Level = struct {
    open: bool
    // Answered while another dialog lay over it: it goes when it is on
    // top.
    closing: bool
    drawing: bool
    // Answered while being drawn: carried out when its drawing is over.
    answered: bool
    answer: usize
    serial: u64
    hooks: Hooks
    // BODY_BYTES of the body's own, made once for the level.
    body: usize
    // The panel as drawn last.
    frame: ui.Rect
    // The button the keys are on (NO_FOCUS: the primary one), whether
    // Tab moved it (then it is ringed), how many buttons there are.
    focus: usize
    focusShown: bool
    primary: usize
    buttons: usize
    // Enter was pressed: the button the keys are on is pressed in the
    // next frame.
    enter: bool
    // The body scrolled by this much; how tall its view is; whether it
    // has more than fits.
    scroll: i32
    page: i32
    scrollable: bool
}

const Store = struct {
    levels: [4]Level
    serial: u64
    // What a prompt answered, handed to its caller's function.
    answer: [256]u8
    answerLength: usize
    progressLevel: usize
    progressOpen: bool
    // The scroll offset of a dialog not hosted here (scrollBegin's).
    foreignScroll: i32
    // A dialog's button labels while buttons() draws them.
    labels: [3][]const u8
}

// The labels' room when there is no memory for the store.
var spareLabels: [3][]const u8 = undefined

fn storeOf(app: *App) -> ?*Store {
    const memory = state.slot(app, state.SLOT_DIALOGS, @sizeOf(Store))
    if memory == null { return null }
    return unsafe { @ptrCast(*Store, memory.?) }
}

fn entryOf(app: *App, level: usize) -> ?*Level {
    if level >= LEVELS { return null }
    const store = storeOf(app)
    if store == null { return null }
    return &store.?.*.levels[level]
}

fn drawOf(level: usize) -> state.DialogDraw {
    if level == 0 { return draw0 }
    if level == 1 { return draw1 }
    if level == 2 { return draw2 }
    return draw3
}

fn keyOf(level: usize) -> state.DialogKey {
    if level == 0 { return key0 }
    if level == 1 { return key1 }
    if level == 2 { return key2 }
    return key3
}

fn cancelOf(level: usize) -> state.ActionRun {
    if level == 0 { return cancel0 }
    if level == 1 { return cancel1 }
    if level == 2 { return cancel2 }
    return cancel3
}

fn acceptOf(level: usize) -> state.ActionRun {
    if level == 0 { return accept0 }
    if level == 1 { return accept1 }
    if level == 2 { return accept2 }
    return accept3
}

fn draw0(app: *App, window: ui.Rect) -> void { drawLevel(app, 0, window) }
fn draw1(app: *App, window: ui.Rect) -> void { drawLevel(app, 1, window) }
fn draw2(app: *App, window: ui.Rect) -> void { drawLevel(app, 2, window) }
fn draw3(app: *App, window: ui.Rect) -> void { drawLevel(app, 3, window) }
fn key0(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool { return keyLevel(app, 0, code, modifiers, typed) }
fn key1(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool { return keyLevel(app, 1, code, modifiers, typed) }
fn key2(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool { return keyLevel(app, 2, code, modifiers, typed) }
fn key3(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool { return keyLevel(app, 3, code, modifiers, typed) }
fn cancel0(app: *App) -> void { cancelledLevel(app, 0) }
fn cancel1(app: *App) -> void { cancelledLevel(app, 1) }
fn cancel2(app: *App) -> void { cancelledLevel(app, 2) }
fn cancel3(app: *App) -> void { cancelledLevel(app, 3) }
fn accept0(app: *App) -> void { acceptLevel(app, 0) }
fn accept1(app: *App) -> void { acceptLevel(app, 1) }
fn accept2(app: *App) -> void { acceptLevel(app, 2) }
fn accept3(app: *App) -> void { acceptLevel(app, 3) }

// Whether app.dialogs[level] is this module's (somebody may have popped
// ours and pushed another).
fn ours(app: *App, level: usize) -> bool {
    return level < app.*.dialogCount && level < LEVELS && @intFromPtr(app.*.dialogs[level].draw) == @intFromPtr(drawOf(level))
}

// Shows a dialog drawn and answered by `hooks`, with `bytes` of zeroed
// memory of its own (body()), over those open. Its level (its place in
// app.dialogs), or null when no more can be open (the status bar says
// so) or without memory.
pub fn host(app: *App, hooks: Hooks, bytes: usize) -> ?usize {
    const store = storeOf(app)
    if store == null || bytes > BODY_BYTES { return null }
    const level = app.*.dialogCount
    if level >= LEVELS || level >= state.DIALOGS {
        api.say(app, state.tr(app, "Too many dialogs are open", "Es sind zu viele Dialoge offen"), true)
        return null
    }
    const entry = &store.?.*.levels[level]
    if entry.*.body == 0 {
        const memory = app.*.allocator.alloc(BODY_BYTES, 16)
        if memory == null { return null }
        entry.*.body = @intFromPtr(memory.?)
    }
    std.mem.zero(bodyBytes(entry), BODY_BYTES)
    store.?.*.serial += 1
    entry.*.serial = store.?.*.serial
    entry.*.hooks = hooks
    entry.*.open = true
    entry.*.closing = false
    entry.*.drawing = false
    entry.*.answered = false
    entry.*.answer = CANCEL
    entry.*.frame = ui.rect(0, 0, 0, 0)
    entry.*.focus = NO_FOCUS
    entry.*.focusShown = false
    entry.*.primary = 0
    entry.*.buttons = 0
    entry.*.enter = false
    entry.*.scroll = 0
    entry.*.page = 0
    entry.*.scrollable = false
    const dialog = state.Dialog.{ .draw = drawOf(level), .keyPress = keyOf(level), .cancel = cancelOf(level), .accept = acceptOf(level) }
    if !api.pushDialog(app, dialog) {
        entry.*.open = false
        return null
    }
    return level
}

fn bodyBytes(entry: *Level) -> [*]u8 {
    return unsafe { @ptrFromInt([*]u8, entry.*.body) }
}

// The body memory of the dialog at `level` (host's bytes); a level that
// is not open has whatever its last dialog left.
pub fn body(app: *App, level: usize) -> [*]u8 {
    const entry = entryOf(app, level)
    if entry == null || entry.?.*.body == 0 { return unsafe { @ptrFromInt([*]u8, 16) } }
    return bodyBytes(entry.?)
}

// The topmost dialog open here whose hooks have `kind` (null: none).
pub fn find(app: *App, kind: u8) -> ?usize {
    var level = app.*.dialogCount
    while level > 0 {
        level -= 1
        const entry = entryOf(app, level)
        if entry != null && entry.?.*.open && !entry.?.*.closing && entry.?.*.hooks.kind == kind && ours(app, level) { return level }
    }
    return null
}

// Answers the dialog at `level` with `answer` (a button's number or
// CANCEL): it closes and its finish hook runs, at once, or, while the
// dialog is being drawn, when its drawing is over (what is drawn after
// the answer in that frame does no harm); when another dialog lies over
// it, once that one has gone. The first answer counts.
pub fn close(app: *App, level: usize, answer: usize) -> void {
    const entry = entryOf(app, level)
    if entry == null { return }
    const found = entry.?
    if !found.*.open || found.*.answered || found.*.closing { return }
    found.*.answer = answer
    if found.*.drawing {
        found.*.answered = true
        return
    }
    settle(app, level, found)
}

// Carries out the answer: off app.dialogs (when it is on top), then its
// finish hook.
fn settle(app: *App, level: usize, entry: *Level) -> void {
    entry.*.answered = false
    if !(level + 1 == app.*.dialogCount && ours(app, level)) {
        entry.*.closing = true
        return
    }
    entry.*.closing = false
    entry.*.open = false
    api.popDialog(app)
    const finish = entry.*.hooks.finish
    finish(app, level, entry.*.answer)
}

fn drawLevel(app: *App, level: usize, window: ui.Rect) -> void {
    const entry = entryOf(app, level)
    if entry == null || !entry.?.*.open { return }
    const found = entry.?
    if found.*.closing {
        if level + 1 == app.*.dialogCount { settle(app, level, found) }
        return
    }
    found.*.drawing = true
    const draw = found.*.hooks.draw
    draw(app, level, window)
    found.*.drawing = false
    if found.*.answered { settle(app, level, found) }
}

fn keyLevel(app: *App, level: usize, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const entry = entryOf(app, level)
    if entry == null || !entry.?.*.open { return false }
    const found = entry.?
    if found.*.closing {
        settle(app, level, found)
        return true
    }
    const hook = found.*.hooks.key
    if hook != null && hook.?(app, level, code, modifiers, typed) { return true }
    if code == keys.ESCAPE {
        if found.*.hooks.closable { close(app, level, CANCEL) }
        return true
    }
    if keys.isEnter(code) {
        found.*.enter = true
        return true
    }
    if found.*.hooks.tabs && found.*.buttons > 0 && (code == keys.TAB || code == keys.LEFT || code == keys.RIGHT) {
        const count = found.*.buttons
        var focus = if found.*.focus == NO_FOCUS { found.*.primary } else { found.*.focus }
        if focus >= count { focus = 0 }
        // The buttons stand left to right in their order: Left and
        // Shift+Tab go to the one before.
        const backward = code == keys.LEFT || (code == keys.TAB && modifiers & keys.SHIFT != 0)
        if backward {
            focus = if focus == 0 { count - 1 } else { focus - 1 }
        } else {
            focus = if focus + 1 >= count { 0 } else { focus + 1 }
        }
        found.*.focus = focus
        found.*.focusShown = true
        return true
    }
    if found.*.scrollable {
        const s = state.themeOf(app).*.scale
        const step = (ROW + GAP) * s
        const page = if found.*.page > step { found.*.page - step } else { step }
        if code == keys.PAGE_DOWN {
            found.*.scroll += page
        } else if code == keys.PAGE_UP {
            found.*.scroll -= page
        } else if code == keys.DOWN {
            found.*.scroll += step
        } else if code == keys.UP {
            found.*.scroll -= step
        } else if code == keys.HOME {
            found.*.scroll = 0
        } else if code == keys.END {
            // (scrollBegin holds it to the content's end.)
            found.*.scroll = 1 << 24
        } else {
            return false
        }
        if found.*.scroll < 0 { found.*.scroll = 0 }
        if found.*.scroll > 1 << 24 { found.*.scroll = 1 << 24 }
        return true
    }
    return false
}

// The loop took the dialog off already (its own Escape): only the
// answer is left to carry out.
fn cancelledLevel(app: *App, level: usize) -> void {
    const entry = entryOf(app, level)
    if entry == null || !entry.?.*.open { return }
    const found = entry.?
    found.*.open = false
    found.*.closing = false
    found.*.answered = false
    const finish = found.*.hooks.finish
    finish(app, level, CANCEL)
}

fn acceptLevel(app: *App, level: usize) -> void {
    const entry = entryOf(app, level)
    if entry == null || !entry.?.*.open { return }
    entry.?.*.enter = true
    api.redraw(app)
}

// The level whose body is being drawn now (NO_LEVEL: none of ours).
fn drawingLevel(app: *App) -> usize {
    var level = LEVELS
    while level > 0 {
        level -= 1
        const entry = entryOf(app, level)
        if entry != null && entry.?.*.open && entry.?.*.drawing { return level }
    }
    return NO_LEVEL
}

fn idAt(app: *App, level: usize, part: usize) -> u64 {
    const entry = entryOf(app, level)
    if entry == null {
        // A dialog of somebody else's that uses the pieces: by its place.
        return view.idOf(view.id("nebula.dialogs.other"), app.*.dialogCount *% PARTS +% part)
    }
    return view.idOf(view.id("nebula.dialogs"), @intCast(usize, entry.?.*.serial) *% PARTS +% part)
}

// The id of `part` (PART_*) of the dialog at `level`: ids differ from
// one dialog to the next, also at the same level.
pub fn idOf(app: *App, level: usize, part: usize) -> u64 {
    return idAt(app, level, part)
}

// The id of `part` of the dialog on top (view.NONE: none of ours is), to
// find where it is with view.areaOf (scripts, tests).
pub fn partId(app: *App, part: usize) -> u64 {
    if app.*.dialogCount == 0 || !ours(app, app.*.dialogCount - 1) { return view.NONE }
    return idAt(app, app.*.dialogCount - 1, part)
}

// The panel of the dialog on top as it was drawn last (empty: none of
// ours, or not drawn yet).
pub fn frameArea(app: *App) -> ui.Rect {
    if app.*.dialogCount == 0 || !ours(app, app.*.dialogCount - 1) { return ui.rect(0, 0, 0, 0) }
    const entry = entryOf(app, app.*.dialogCount - 1)
    if entry == null { return ui.rect(0, 0, 0, 0) }
    return entry.?.*.frame
}

// ---------------------------------------------------------------------------
// The pieces

fn scaleOf(app: *App) -> i32 { return state.themeOf(app).*.scale }

// The veil over what lies behind: darker on a dark desktop.
fn veil(app: *App) -> u32 {
    var light = app.*.lightness
    if light < 0 { light = 0 }
    if light > 1024 { light = 1024 }
    return canvas_module.color(@intCast(u32, 120 - light * 40 / 1024), 0, 0, 0)
}

// A theme colour made opaque (the window must be where the panel is).
fn solid(given: u32) -> u32 {
    if given >> 24 == 255 { return given }
    return canvas_module.over(0xFF000000, given, 255)
}

fn cancelForeign(app: *App) -> void {
    if app.*.dialogCount == 0 { return }
    const dialog = app.*.dialogs[app.*.dialogCount - 1]
    api.popDialog(app)
    if dialog.cancel != null { dialog.cancel.?(app) }
}

// The dialog's panel: dims what is behind (the whole `window`), draws a
// panel `width` x `height` (window pixels) in the middle of it, smaller
// when the window is (12 pixels from its edges at least), with a shadow,
// `title` and a close cross that cancels the dialog. Returns the content
// rectangle inside the padding: cut the buttons off its bottom
// (buttons()), lay the fields out from its top (labelled()).
pub fn frame(app: *App, window: ui.Rect, title: []const u8, width: i32, height: i32) -> ui.Rect {
    const kit = api.kit(app)
    const theme = state.themeOf(app)
    const canvas = state.uiOf(app).*.canvas
    const s = theme.*.scale
    const level = drawingLevel(app)
    canvas_module.fillRect(canvas, window.x, window.y, window.width, window.height, veil(app))
    var w = if width < window.width - 2 * MARGIN * s { width } else { window.width - 2 * MARGIN * s }
    var h = if height < window.height - 2 * MARGIN * s { height } else { window.height - 2 * MARGIN * s }
    if w < 0 { w = 0 }
    if h < 0 { h = 0 }
    const panel = ui.rect(window.x + (window.width - w) / 2, window.y + (window.height - h) / 2, w, h)
    const radius = theme.*.radius
    // A soft shadow: rings a little larger and fainter each, a little
    // below the panel.
    const shade = canvas_module.color((theme.*.shadow >> 24) / 4, 0, 0, 0)
    var spread: i32 = 4
    while spread > 0 {
        const out = spread * s
        canvas_module.fillRoundedRect(canvas, panel.x - out, panel.y - out + 3 * s, panel.width + 2 * out, panel.height + 2 * out, radius + out, shade)
        spread -= 1
    }
    canvas_module.fillRoundedRect(canvas, panel.x, panel.y, panel.width, panel.height, radius, solid(theme.*.panel))
    canvas_module.strokeRoundedRect(canvas, panel.x, panel.y, panel.width, panel.height, radius, s, theme.*.popupBorder)
    const head = ui.rect(panel.x, panel.y, panel.width, if TITLE_HEIGHT * s < panel.height { TITLE_HEIGHT * s } else { panel.height })
    kit_module.hline(canvas, panel.x + s, ui.bottom(head) - s, panel.width - 2 * s, theme.*.divider)
    var room = head.width - 2 * PAD * s
    var closable = true
    const entry = entryOf(app, level)
    if entry != null {
        entry.?.*.frame = panel
        closable = entry.?.*.hooks.closable
    }
    if closable {
        const side = 24 * s
        const cross = ui.rect(ui.right(head) - side - 6 * s, head.y + (head.height - side) / 2, side, side)
        if kit_module.iconButton(kit, idAt(app, level, PART_CLOSE), cross, icons.drawFor, @intCast(usize, icons.CLOSE), state.tr(app, "Close", "Schließen")) {
            if level == NO_LEVEL { cancelForeign(app) } else { close(app, level, CANCEL) }
        }
        room -= side
    }
    kit_module.heading(kit, ui.rect(panel.x + PAD * s, head.y, room, head.height - s), title)
    const top = ui.bottom(head) + (PAD - 2) * s
    var inner_height = ui.bottom(panel) - (PAD - 2) * s - top
    if inner_height < 0 { inner_height = 0 }
    var inner_width = panel.width - 2 * PAD * s
    if inner_width < 0 { inner_width = 0 }
    return ui.rect(panel.x + PAD * s, top, inner_width, inner_height)
}

// The height to ask of frame() for content `natural` pixels tall above a
// row of buttons.
pub fn framed(app: *App, natural: i32) -> i32 {
    const s = scaleOf(app)
    return TITLE_HEIGHT * s + (PAD - 2) * s + natural + PAD * s + BUTTON_HEIGHT * s + (PAD - 2) * s
}

// A right-aligned row of buttons with `labels`, cut off the bottom of
// `content` (what is above it stays in `content`), the first to the left;
// labels[primary] is highlighted and is what Enter presses (until Tab
// moves the keys to another one; a `primary` beyond the labels: none is
// and Enter presses nothing); by custom the last is Cancel. The
// number of the button clicked (or pressed with Enter), null for none.
pub fn buttons(app: *App, content: *ui.Rect, labels: []const []const u8, primary: usize) -> ?usize {
    const kit = api.kit(app)
    const theme = state.themeOf(app)
    const s = theme.*.scale
    const level = drawingLevel(app)
    const row = ui.takeBottom(content, BUTTON_HEIGHT * s)
    _ = ui.takeBottom(content, PAD * s)
    const entry = entryOf(app, level)
    var focus = primary
    var ringed = false
    if entry != null {
        entry.?.*.primary = primary
        entry.?.*.buttons = labels.length
        if entry.?.*.focus != NO_FOCUS && entry.?.*.focus < labels.length { focus = entry.?.*.focus }
        ringed = entry.?.*.focusShown
    }
    var clicked: ?usize = null
    var x = ui.right(row)
    var index = labels.length
    while index > 0 {
        index -= 1
        var width = text_module.measure(state.smallOf(app), labels[index]) + 28 * s
        if width < BUTTON_MIN * s { width = BUTTON_MIN * s }
        x -= width
        const area = ui.rect(x, row.y, width, row.height)
        const kind = if index == primary { kit_module.BUTTON_PRIMARY } else { kit_module.BUTTON_NORMAL }
        if kit_module.button(kit, idAt(app, level, PART_BUTTON + index), area, labels[index], kind) { clicked = index }
        if ringed && index == focus {
            canvas_module.strokeRoundedRect(state.uiOf(app).*.canvas, area.x - 2 * s, area.y - 2 * s, area.width + 4 * s, area.height + 4 * s, theme.*.smallRadius + 3 * s, s, theme.*.accent)
        }
        x -= BUTTON_GAP * s
    }
    if entry != null && entry.?.*.enter {
        entry.?.*.enter = false
        // (A row with no primary button and no button the keys moved to
        // has nothing for Enter.)
        if clicked == null && focus < labels.length { clicked = focus }
    }
    return clicked
}

// A row `height` tall off the top of `content` (a gap after it): `label`
// at its left in a column of fixed width; the rectangle for its field.
pub fn labelled(app: *App, content: *ui.Rect, label: []const u8, height: i32) -> ui.Rect {
    const s = scaleOf(app)
    const row = ui.takeTop(content, height)
    _ = ui.takeTop(content, GAP * s)
    var column = LABEL_WIDTH * s
    // (A narrow dialog gives its fields the larger part.)
    if column > row.width * 2 / 5 { column = row.width * 2 / 5 }
    kit_module.label(api.kit(app), ui.rect(row.x, row.y, column - 8 * s, row.height), label, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    return ui.rect(row.x + column, row.y, row.width - column, row.height)
}

// From here to scrollEnd the dialog's body: `area` (the content left
// after the buttons), scrolled when `natural`, the height the body needs,
// is more than it has (a bar at the right is dragged; Page Up and Down,
// Home and End move it). Lay the body out in the rectangle returned (its
// top moves with the scrolling) and draw it on the canvas the context has
// now (state.uiOf(app).*.canvas: what is outside the area is cut away).
pub fn scrollBegin(app: *App, area: ui.Rect, natural: i32) -> ui.Rect {
    const kit = api.kit(app)
    const level = drawingLevel(app)
    const entry = entryOf(app, level)
    if entry != null {
        entry.?.*.page = area.height
        entry.?.*.scrollable = natural > area.height
        return kit_module.scrollBegin(kit, idAt(app, level, PART_SCROLL), area, natural, &entry.?.*.scroll)
    }
    const store = storeOf(app)
    if store != null { return kit_module.scrollBegin(kit, idAt(app, level, PART_SCROLL), area, natural, &store.?.*.foreignScroll) }
    // (Without memory for the store: a place of no consequence.)
    var nowhere: i32 = 0
    return kit_module.scrollBegin(kit, idAt(app, level, PART_SCROLL), area, natural, &nowhere)
}

pub fn scrollEnd(app: *App) -> void {
    kit_module.scrollEnd(api.kit(app))
}

// ---------------------------------------------------------------------------
// Texts

// Copies `text` to `into` (at most `capacity` bytes, whole characters
// only); the length copied.
fn copyInto(into: [*]u8, capacity: usize, text: []const u8) -> usize {
    var count = if text.length > capacity { capacity } else { text.length }
    while count > 0 && count < text.length && text[count] & 192 == 128 { count -= 1 }
    var index: usize = 0
    while index < count {
        into[index] = text[index]
        index += 1
    }
    return count
}

fn textOf(bytes: [*]const u8, length: usize) -> []const u8 {
    return bytes[0..length]
}

// A line of wrapped text in `font`.
fn lineOf(app: *App, font: *state.Text) -> i32 {
    if !font.*.loaded { return 18 * scaleOf(app) }
    return font.*.ascent * 3 / 2 + 2
}

// Where a dialog puts its button labels for buttons(): in the store (a
// local array handed on would be taken from the value arena every frame).
fn labelRoom(app: *App) -> [*][]const u8 {
    const store = storeOf(app)
    if store != null { return &store.?.*.labels }
    return &spareLabels
}

fn okLabel(app: *App) -> []const u8 { return "OK" }
fn cancelLabel(app: *App) -> []const u8 { return state.tr(app, "Cancel", "Abbrechen") }

// A channel of 0..255 held and rounded.
fn byteOf(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 255.0 { return 255 }
    return @intFromFloat(u32, value + 0.5)
}

// ---------------------------------------------------------------------------
// Messages and questions

const Message = struct {
    title: [128]u8
    titleLength: usize
    text: [1024]u8
    textLength: usize
    kind: u8
}

const Choice = struct {
    title: [128]u8
    titleLength: usize
    text: [1024]u8
    textLength: usize
    labels: [3][48]u8
    labelLengths: [3]usize
    count: usize
    // The functions of the buttons; Escape and the cross run the last.
    runs: [3]?state.ActionRun
}

fn messageOf(app: *App, level: usize) -> *Message { return unsafe { @ptrCast(*Message, body(app, level)) } }
fn choiceOf(app: *App, level: usize) -> *Choice { return unsafe { @ptrCast(*Choice, body(app, level)) } }

fn finishNothing(app: *App, level: usize, answer: usize) -> void {}

// Shows `text` (wrapped; at most 1024 bytes of it) under `title` with an
// OK button, marked as INFO, WARNING or ERROR. False when it cannot be
// shown (too many dialogs, no memory): the status bar says `text` then.
pub fn message(app: *App, title: []const u8, text: []const u8, kind: u8) -> bool {
    const hooks = Hooks.{ .kind = KIND_MESSAGE, .draw = drawMessage, .key = null, .finish = finishNothing, .tabs = true, .closable = true }
    const level = host(app, hooks, @sizeOf(Message))
    if level == null {
        api.say(app, text, kind == ERROR)
        return false
    }
    const shown = messageOf(app, level.?)
    shown.*.titleLength = copyInto(&shown.*.title, TITLE, title)
    shown.*.textLength = copyInto(&shown.*.text, TEXT, text)
    shown.*.kind = kind
    return true
}

fn iconOfKind(kind: u8) -> u16 {
    if kind == WARNING { return icons.WARNING }
    if kind == ERROR { return icons.ERROR }
    return icons.INFO
}

fn colorOfKind(app: *App, kind: u8) -> u32 {
    const theme = state.themeOf(app)
    if kind == WARNING { return canvas_module.color(255, 230, 162, 48) }
    if kind == ERROR { return theme.*.danger }
    return theme.*.accent
}

// The width a question's text wraps to in a panel `width` wide.
fn textRoom(app: *App, width: i32) -> i32 {
    const s = scaleOf(app)
    return width - 2 * PAD * s - 32 * s - PAD * s
}

// The body of a message or a question: the icon and the text beside it,
// in `content` (scrolled when the window is too small for it).
fn drawSaying(app: *App, content: ui.Rect, icon: u16, icon_color: u32, text: []const u8) -> void {
    const s = scaleOf(app)
    const font = state.bodyOf(app)
    const line = lineOf(app, font)
    const size = 32 * s
    const room = content.width - size - PAD * s
    const tall = popup.wrappedHeight(font, text, room, line, MOST_LINES)
    const natural = if tall > size { tall } else { size }
    const area = scrollBegin(app, content, natural)
    const widgets = state.uiOf(app)
    icons.draw(widgets.*.canvas, icon, area.x, area.y, size, icon_color)
    // One line or two stand in the middle of the icon's height.
    const top = if tall < size { area.y + (size - tall) / 2 } else { area.y }
    _ = popup.wrapped(widgets, font, text, area.x + size + PAD * s, top, room, line, MOST_LINES, state.themeOf(app).*.text)
    scrollEnd(app)
}

// How tall the saying of `text` is in a panel `width` wide.
fn sayingHeight(app: *App, width: i32, text: []const u8) -> i32 {
    const s = scaleOf(app)
    const font = state.bodyOf(app)
    const tall = popup.wrappedHeight(font, text, textRoom(app, width), lineOf(app, font), MOST_LINES)
    return if tall > 32 * s { tall } else { 32 * s }
}

fn drawMessage(app: *App, level: usize, window: ui.Rect) -> void {
    const shown = messageOf(app, level)
    const width = 440 * scaleOf(app)
    const text = textOf(&shown.*.text, shown.*.textLength)
    var content = frame(app, window, textOf(&shown.*.title, shown.*.titleLength), width, framed(app, sayingHeight(app, width, text)))
    const labels = labelRoom(app)
    labels[0] = okLabel(app)
    if buttons(app, &content, labels[0..1], 0) != null { close(app, level, 0) }
    drawSaying(app, content, iconOfKind(shown.*.kind), colorOfKind(app, shown.*.kind), text)
}

fn openChoice(app: *App, title: []const u8, text: []const u8, count: usize) -> ?*Choice {
    const hooks = Hooks.{ .kind = KIND_CHOICE, .draw = drawChoice, .key = null, .finish = finishChoice, .tabs = true, .closable = true }
    const level = host(app, hooks, @sizeOf(Choice))
    if level == null { return null }
    const asked = choiceOf(app, level.?)
    asked.*.titleLength = copyInto(&asked.*.title, TITLE, title)
    asked.*.textLength = copyInto(&asked.*.text, TEXT, text)
    asked.*.count = count
    return asked
}

fn setChoice(asked: *Choice, index: usize, label: []const u8, run: ?state.ActionRun) -> void {
    asked.*.labelLengths[index] = copyInto(&asked.*.labels[index], LABEL, label)
    asked.*.runs[index] = run
}

// Asks `text` under `title` with two buttons, `yes` (the primary one)
// and `no`: on_yes runs for yes, on_no (null: nothing) for no, Escape
// and the close cross. False when it cannot be asked (too many dialogs,
// no memory): nothing runs then.
pub fn confirm(app: *App, title: []const u8, text: []const u8, yes: []const u8, no: []const u8, on_yes: state.ActionRun, on_no: ?state.ActionRun) -> bool {
    const asked = openChoice(app, title, text, 2)
    if asked == null { return false }
    setChoice(asked.?, 0, yes, on_yes)
    setChoice(asked.?, 1, no, on_no)
    return true
}

// Asks `text` with three buttons (Save / Discard / Cancel for unsaved
// changes): `first` is the primary one; Escape and the close cross run
// on_third as its button does. False when it cannot be asked.
pub fn choose3(app: *App, title: []const u8, text: []const u8, first: []const u8, second: []const u8, third: []const u8, on_first: state.ActionRun, on_second: ?state.ActionRun, on_third: ?state.ActionRun) -> bool {
    const asked = openChoice(app, title, text, 3)
    if asked == null { return false }
    setChoice(asked.?, 0, first, on_first)
    setChoice(asked.?, 1, second, on_second)
    setChoice(asked.?, 2, third, on_third)
    return true
}

fn drawChoice(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = choiceOf(app, level)
    const width = 460 * scaleOf(app)
    const text = textOf(&asked.*.text, asked.*.textLength)
    var content = frame(app, window, textOf(&asked.*.title, asked.*.titleLength), width, framed(app, sayingHeight(app, width, text)))
    const labels = labelRoom(app)
    const count = if asked.*.count > 3 { 3 } else { asked.*.count }
    var index: usize = 0
    while index < count {
        labels[index] = textOf(&asked.*.labels[index], asked.*.labelLengths[index])
        index += 1
    }
    const clicked = buttons(app, &content, labels[0..count], 0)
    if clicked != null { close(app, level, clicked.?) }
    drawSaying(app, content, icons.HELP, state.themeOf(app).*.accent, text)
}

fn finishChoice(app: *App, level: usize, answer: usize) -> void {
    const asked = choiceOf(app, level)
    if asked.*.count == 0 || asked.*.count > 3 { return }
    var run: ?state.ActionRun = null
    if answer == CANCEL {
        run = asked.*.runs[asked.*.count - 1]
    } else if answer < asked.*.count {
        run = asked.*.runs[answer]
    }
    if run != null { run.?(app) }
}

// ---------------------------------------------------------------------------
// A text asked for

// What prompt hands the text typed to (it is the caller's to copy: it
// lasts as long as the call).
pub const TextRun = fn(app: *state.App, text: []const u8) -> void

const Prompt = struct {
    title: [128]u8
    titleLength: usize
    label: [48]u8
    labelLength: usize
    text: [256]u8
    textLength: usize
    onText: fn(app: *state.App, text: []const u8) -> void
    // The field was given the keys.
    started: bool
}

fn promptOf(app: *App, level: usize) -> *Prompt { return unsafe { @ptrCast(*Prompt, body(app, level)) } }

// Asks for a line of text (`label` before its field, `initial` in it,
// selected and taking the keys): Enter or OK hands what is typed to
// on_text; Escape, Cancel and the close cross hand nothing. At most 256
// bytes. False when it cannot be asked.
pub fn prompt(app: *App, title: []const u8, label: []const u8, initial: []const u8, on_text: TextRun) -> bool {
    const hooks = Hooks.{ .kind = KIND_PROMPT, .draw = drawPrompt, .key = null, .finish = finishPrompt, .tabs = false, .closable = true }
    const level = host(app, hooks, @sizeOf(Prompt))
    if level == null { return false }
    const asked = promptOf(app, level.?)
    asked.*.titleLength = copyInto(&asked.*.title, TITLE, title)
    asked.*.labelLength = copyInto(&asked.*.label, LABEL, label)
    asked.*.textLength = copyInto(&asked.*.text, ANSWER, initial)
    asked.*.onText = on_text
    asked.*.started = false
    return true
}

fn drawPrompt(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = promptOf(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    var content = frame(app, window, textOf(&asked.*.title, asked.*.titleLength), 420 * s, framed(app, ROW * s))
    const labels = labelRoom(app)
    labels[0] = okLabel(app)
    labels[1] = cancelLabel(app)
    const clicked = buttons(app, &content, labels[0..2], 0)
    var rows = scrollBegin(app, content, ROW * s)
    const field = labelled(app, &rows, textOf(&asked.*.label, asked.*.labelLength), ROW * s)
    const id = idAt(app, level, PART_FIELD)
    if !asked.*.started {
        kit_module.focus(kit, id)
        asked.*.started = true
    }
    const result = kit_module.textBox(kit, id, field, &asked.*.text, &asked.*.textLength, ANSWER, "")
    scrollEnd(app)
    // (An edit ended by a press elsewhere, on Cancel too, is no answer:
    // the click that follows is.)
    if result == kit_module.TEXT_SUBMITTED && !state.uiOf(app).*.pointerDown { close(app, level, 0) }
    if result == kit_module.TEXT_CANCELLED { close(app, level, CANCEL) }
    if clicked != null { close(app, level, if clicked.? == 0 { 0 } else { CANCEL }) }
}

fn finishPrompt(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const store = storeOf(app)
    if store == null { return }
    const asked = promptOf(app, level)
    const run = asked.*.onText
    store.?.*.answerLength = copyInto(&store.?.*.answer, ANSWER, textOf(&asked.*.text, asked.*.textLength))
    run(app, textOf(&store.?.*.answer, store.?.*.answerLength))
}

// ---------------------------------------------------------------------------
// A colour

// What pickColor hands the colour to (straight 0xAARRGGBB).
pub const ColorRun = fn(app: *state.App, color: u32) -> void

const ColorBody = struct {
    title: [128]u8
    titleLength: usize
    initial: u32
    color: u32
    // In degrees and percent: kept apart from the colour so that a grey
    // keeps its hue and black its saturation while they are being set.
    hue: f64
    saturation: f64
    value: f64
    hex: [16]u8
    hexLength: usize
    onColor: fn(app: *state.App, color: u32) -> void
    live: bool
}

fn colorBodyOf(app: *App, level: usize) -> *ColorBody { return unsafe { @ptrCast(*ColorBody, body(app, level)) } }

// Asks for a colour, starting at `initial` (straight 0xAARRGGBB): sliders
// for red, green, blue and alpha and for hue, saturation and value, in
// step with each other, a hex field ("#RRGGBB", "#AARRGGBB"; Enter takes
// it), the old colour and the new side by side (a click on the old one
// takes it back). OK hands the colour to on_color; with `live` every
// change does, and a cancel hands back `initial`. False when it cannot be
// asked.
pub fn pickColor(app: *App, title: []const u8, initial: u32, on_color: ColorRun, live: bool) -> bool {
    const hooks = Hooks.{ .kind = KIND_COLOR, .draw = drawColor, .key = null, .finish = finishColor, .tabs = false, .closable = true }
    const level = host(app, hooks, @sizeOf(ColorBody))
    if level == null { return false }
    const asked = colorBodyOf(app, level.?)
    asked.*.titleLength = copyInto(&asked.*.title, TITLE, title)
    asked.*.initial = initial
    asked.*.color = initial
    asked.*.hue = 0.0
    asked.*.onColor = on_color
    asked.*.live = live
    followRgb(asked)
    return true
}

// The hue, saturation and value of the colour now (a grey keeps the hue
// it had, black its saturation too).
fn followRgb(asked: *ColorBody) -> void {
    var h: f64 = 0.0
    var s: f64 = 0.0
    var v: f64 = 0.0
    color_module.toHsv(asked.*.color, &h, &s, &v)
    if v > 0.0 && s > 0.0 { asked.*.hue = color_module.hueToDegrees(h) }
    if v > 0.0 { asked.*.saturation = s * 100.0 }
    asked.*.value = v * 100.0
}

fn channelSlider(app: *App, level: usize, rows: *ui.Rect, part: usize, label: []const u8, channel: u32, options: *const kit_module.SliderOptions) -> ?u32 {
    var value = @floatFromInt(f64, channel)
    const field = labelled(app, rows, label, ROW * scaleOf(app))
    if !kit_module.slider(api.kit(app), idAt(app, level, PART_FIELD + part), field, "", &value, options) { return null }
    return byteOf(value)
}

// The colour part of the dialog, in `rows` (taken off its top): the
// swatches, the sliders, the hex field. True when the colour changed.
// (A richer selector takes this function's place.)
fn colorPart(app: *App, level: usize, asked: *ColorBody, rows: *ui.Rect) -> bool {
    const kit = api.kit(app)
    const s = scaleOf(app)
    const before = asked.*.color
    const swatches = labelled(app, rows, state.tr(app, "Old / New", "Alt / Neu"), 40 * s)
    const half = (swatches.width - 4 * s) / 2
    if kit_module.colorSwatch(kit, idAt(app, level, PART_FIELD + 8), ui.rect(swatches.x, swatches.y, half, swatches.height), asked.*.initial, false) {
        asked.*.color = asked.*.initial
        followRgb(asked)
    }
    _ = kit_module.colorSwatch(kit, idAt(app, level, PART_FIELD + 9), ui.rect(ui.right(swatches) - half, swatches.y, half, swatches.height), asked.*.color, false)
    var channel = kit_module.sliderOptions(0.0, 255.0, 1.0, 0)
    var rgb = false
    const now = asked.*.color
    const red = channelSlider(app, level, rows, 0, state.tr(app, "Red", "Rot"), pixel.red(now), &channel)
    const green = channelSlider(app, level, rows, 1, state.tr(app, "Green", "Grün"), pixel.green(now), &channel)
    const blue = channelSlider(app, level, rows, 2, state.tr(app, "Blue", "Blau"), pixel.blue(now), &channel)
    const alpha = channelSlider(app, level, rows, 3, "Alpha", pixel.alpha(now), &channel)
    var r = pixel.red(now)
    var g = pixel.green(now)
    var b = pixel.blue(now)
    var a = pixel.alpha(now)
    if red != null {
        r = red.?
        rgb = true
    }
    if green != null {
        g = green.?
        rgb = true
    }
    if blue != null {
        b = blue.?
        rgb = true
    }
    if alpha != null { a = alpha.? }
    asked.*.color = pixel.pack(a, r, g, b)
    if rgb { followRgb(asked) }
    // (Hue, saturation and value a group of their own.)
    _ = ui.takeTop(rows, 10 * s)
    var degrees = kit_module.sliderOptions(0.0, 360.0, 1.0, 0)
    degrees.suffix = "°"
    var percent = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    percent.suffix = " %"
    var hsv = false
    var h = asked.*.hue
    if kit_module.slider(kit, idAt(app, level, PART_FIELD + 4), labelled(app, rows, state.tr(app, "Hue", "Farbton"), ROW * s), "", &h, &degrees) {
        asked.*.hue = h
        hsv = true
    }
    var sat = asked.*.saturation
    if kit_module.slider(kit, idAt(app, level, PART_FIELD + 5), labelled(app, rows, state.tr(app, "Saturation", "Sättigung"), ROW * s), "", &sat, &percent) {
        asked.*.saturation = sat
        hsv = true
    }
    var v = asked.*.value
    if kit_module.slider(kit, idAt(app, level, PART_FIELD + 6), labelled(app, rows, state.tr(app, "Value", "Hellwert"), ROW * s), "", &v, &percent) {
        asked.*.value = v
        hsv = true
    }
    if hsv { asked.*.color = color_module.fromHsv(asked.*.hue / 360.0, asked.*.saturation / 100.0, asked.*.value / 100.0, pixel.alpha(asked.*.color)) }
    const hex_id = idAt(app, level, PART_FIELD + 7)
    // (While it is typed into the field keeps what is typed.)
    if !kit_module.editing(kit, hex_id) { asked.*.hexLength = color_module.formatHex(asked.*.color, &asked.*.hex, pixel.alpha(asked.*.color) != 255) }
    const hex_field = labelled(app, rows, "Hex", ROW * s)
    const result = kit_module.textBox(kit, hex_id, ui.rect(hex_field.x, hex_field.y, if hex_field.width > 120 * s { 120 * s } else { hex_field.width }, hex_field.height), &asked.*.hex, &asked.*.hexLength, 9, "#rrggbb")
    if result == kit_module.TEXT_SUBMITTED {
        var typed: u32 = 0
        if color_module.parseHex(textOf(&asked.*.hex, asked.*.hexLength), &typed) {
            asked.*.color = typed
            followRgb(asked)
        } else {
            api.say(app, state.tr(app, "That is no colour: write #RRGGBB or #AARRGGBB", "Das ist keine Farbe: #RRGGBB oder #AARRGGBB schreiben"), true)
        }
    }
    return asked.*.color != before
}

// How tall the colour part is.
fn colorPartHeight(app: *App) -> i32 {
    const s = scaleOf(app)
    return 40 * s + GAP * s + 8 * (ROW + GAP) * s + 10 * s
}

fn drawColor(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = colorBodyOf(app, level)
    const s = scaleOf(app)
    const natural = colorPartHeight(app)
    var content = frame(app, window, textOf(&asked.*.title, asked.*.titleLength), 400 * s, framed(app, natural))
    const labels = labelRoom(app)
    labels[0] = okLabel(app)
    labels[1] = cancelLabel(app)
    const clicked = buttons(app, &content, labels[0..2], 0)
    var rows = scrollBegin(app, content, natural)
    if colorPart(app, level, asked, &rows) && asked.*.live {
        const run = asked.*.onColor
        run(app, asked.*.color)
    }
    scrollEnd(app)
    if clicked != null { close(app, level, if clicked.? == 0 { 0 } else { CANCEL }) }
}

fn finishColor(app: *App, level: usize, answer: usize) -> void {
    const asked = colorBodyOf(app, level)
    const run = asked.*.onColor
    const chosen = asked.*.color
    const initial = asked.*.initial
    if answer == 0 {
        run(app, chosen)
    } else if asked.*.live {
        run(app, initial)
    }
}

// ---------------------------------------------------------------------------
// New Image

const Preset = struct {
    name: []const u8
    german: []const u8
    width: i32
    height: i32
    // 0: the resolution stays.
    resolution: f64
}

const PRESET_COUNT: usize = 12

const PRESETS = [12]Preset{
    Preset.{ .name = "Custom", .german = "Eigene Größe", .width = 0, .height = 0, .resolution = 0.0 },
    Preset.{ .name = "A4 (300 ppi)", .german = "A4 (300 ppi)", .width = 2480, .height = 3508, .resolution = 300.0 },
    Preset.{ .name = "A5 (300 ppi)", .german = "A5 (300 ppi)", .width = 1748, .height = 2480, .resolution = 300.0 },
    Preset.{ .name = "A3 (300 ppi)", .german = "A3 (300 ppi)", .width = 3508, .height = 4961, .resolution = 300.0 },
    Preset.{ .name = "Letter (300 ppi)", .german = "Letter (300 ppi)", .width = 2550, .height = 3300, .resolution = 300.0 },
    Preset.{ .name = "1920 × 1080 (Full HD)", .german = "1920 × 1080 (Full HD)", .width = 1920, .height = 1080, .resolution = 0.0 },
    Preset.{ .name = "3840 × 2160 (4K)", .german = "3840 × 2160 (4K)", .width = 3840, .height = 2160, .resolution = 0.0 },
    Preset.{ .name = "1280 × 720 (HD)", .german = "1280 × 720 (HD)", .width = 1280, .height = 720, .resolution = 0.0 },
    Preset.{ .name = "1600 × 1200 (screen)", .german = "1600 × 1200 (Bildschirm)", .width = 1600, .height = 1200, .resolution = 0.0 },
    Preset.{ .name = "Square 1024", .german = "Quadrat 1024", .width = 1024, .height = 1024, .resolution = 0.0 },
    Preset.{ .name = "Square 2048", .german = "Quadrat 2048", .width = 2048, .height = 2048, .resolution = 0.0 },
    Preset.{ .name = "Square 4096", .german = "Quadrat 4096", .width = 4096, .height = 4096, .resolution = 0.0 },
}

// Units of the width and height fields.
const UNIT_PX: usize = 0
const UNIT_MM: usize = 1
const UNIT_IN: usize = 2

// What the new image's background is.
const GROUND_WHITE: usize = 0
const GROUND_BLACK: usize = 1
const GROUND_TRANSPARENT: usize = 2
const GROUND_BACKGROUND: usize = 3
const GROUND_FOREGROUND: usize = 4
const GROUNDS: usize = 5

const NewImage = struct {
    name: [128]u8
    nameLength: usize
    // What the name field shows while it is empty: the name it gets.
    placeholder: [64]u8
    placeholderLength: usize
    preset: usize
    width: i32
    height: i32
    resolution: f64
    unit: usize
    ground: usize
    // What one layer takes, written each frame.
    note: [96]u8
}

fn newImageOf(app: *App, level: usize) -> *NewImage { return unsafe { @ptrCast(*NewImage, body(app, level)) } }

fn appOf(context: usize) -> *App { return unsafe { @ptrFromInt(*App, context) } }

fn presetName(context: usize, index: usize) -> []const u8 {
    if index >= PRESET_COUNT { return "" }
    return if appOf(context).*.german { PRESETS[index].german } else { PRESETS[index].name }
}

fn unitName(context: usize, index: usize) -> []const u8 {
    if index == UNIT_MM { return "mm" }
    if index == UNIT_IN { return "in" }
    return "px"
}

fn groundName(context: usize, index: usize) -> []const u8 {
    const app = appOf(context)
    if index == GROUND_BLACK { return state.tr(app, "Black", "Schwarz") }
    if index == GROUND_TRANSPARENT { return "Transparent" }
    if index == GROUND_BACKGROUND { return state.tr(app, "Background colour", "Hintergrundfarbe") }
    if index == GROUND_FOREGROUND { return state.tr(app, "Foreground colour", "Vordergrundfarbe") }
    return state.tr(app, "White", "Weiß")
}

fn groundColor(app: *App, ground: usize) -> u32 {
    if ground == GROUND_BLACK { return 0xFF000000 }
    if ground == GROUND_TRANSPARENT { return 0 }
    if ground == GROUND_BACKGROUND { return app.*.background }
    if ground == GROUND_FOREGROUND { return app.*.foreground }
    return 0xFFFFFFFF
}

// The dialog that makes a new image: its name, a predefined size or one
// of its own (width and height in pixels, millimetres or inches at its
// resolution), portrait or landscape, its background (white, black,
// transparent, the background or the foreground colour), what one layer
// of it takes in memory; Create makes it (app/documents.mlx's create) and
// puts it in front. False when it cannot be shown.
pub fn newImage(app: *App) -> bool {
    const hooks = Hooks.{ .kind = KIND_NEW_IMAGE, .draw = drawNewImage, .key = null, .finish = finishNewImage, .tabs = false, .closable = true }
    const level = host(app, hooks, @sizeOf(NewImage))
    if level == null { return false }
    const asked = newImageOf(app, level.?)
    asked.*.nameLength = 0
    const placeholder: [*]u8 = &asked.*.placeholder
    var length = std.text.append(placeholder, 0, 64, state.tr(app, "Untitled-", "Unbenannt-"))
    asked.*.placeholderLength = std.text.appendUnsigned(placeholder, length, 64, @intCast(usize, app.*.untitled) + 1)
    asked.*.preset = 8
    asked.*.width = PRESETS[8].width
    asked.*.height = PRESETS[8].height
    asked.*.resolution = 300.0
    asked.*.unit = UNIT_PX
    asked.*.ground = GROUND_WHITE
    return true
}

fn resolutionOf(asked: *NewImage) -> f64 {
    return if asked.*.resolution >= 1.0 { asked.*.resolution } else { 1.0 }
}

// Pixels as the unit shows them.
fn toUnit(asked: *NewImage, pixels: i32) -> f64 {
    const value = @floatFromInt(f64, pixels)
    if asked.*.unit == UNIT_MM { return value / resolutionOf(asked) * 25.4 }
    if asked.*.unit == UNIT_IN { return value / resolutionOf(asked) }
    return value
}

// What is written in the unit as pixels (whole ones, 1 to LARGEST).
fn fromUnit(asked: *NewImage, value: f64) -> i32 {
    var pixels = value
    if asked.*.unit == UNIT_MM { pixels = value / 25.4 * resolutionOf(asked) }
    if asked.*.unit == UNIT_IN { pixels = value * resolutionOf(asked) }
    if !(pixels >= 1.0) { return 1 }
    if pixels >= @floatFromInt(f64, image_module.LARGEST) { return image_module.LARGEST }
    return @intFromFloat(i32, pixels + 0.5)
}

fn sideOptions(asked: *NewImage) -> kit_module.SliderOptions {
    var options = kit_module.sliderOptions(toUnit(asked, 1), toUnit(asked, image_module.LARGEST), 1.0, 0)
    options.suffix = " px"
    if asked.*.unit == UNIT_MM {
        options.decimals = 1
        options.suffix = " mm"
    } else if asked.*.unit == UNIT_IN {
        options.step = 0.1
        options.decimals = 2
        options.suffix = " in"
    }
    return options
}

fn newImageHeight(app: *App) -> i32 {
    const s = scaleOf(app)
    return 8 * (ROW + GAP) * s
}

fn drawNewImage(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = newImageOf(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const natural = newImageHeight(app)
    var content = frame(app, window, state.tr(app, "New Image", "Neues Bild"), 460 * s, framed(app, natural))
    const labels = labelRoom(app)
    labels[0] = state.tr(app, "Create", "Anlegen")
    labels[1] = cancelLabel(app)
    const clicked = buttons(app, &content, labels[0..2], 0)
    var rows = scrollBegin(app, content, natural)
    const row = ROW * s
    const narrow = 150 * s
    const name_field = labelled(app, &rows, "Name", row)
    _ = kit_module.textBox(kit, idAt(app, level, PART_FIELD), name_field, &asked.*.name, &asked.*.nameLength, 128, textOf(&asked.*.placeholder, asked.*.placeholderLength))
    const preset_field = labelled(app, &rows, state.tr(app, "Size", "Größe"), row)
    if kit_module.comboBoxWith(kit, idAt(app, level, PART_FIELD + 1), preset_field, PRESET_COUNT, presetName, @intFromPtr(app), &asked.*.preset) && asked.*.preset > 0 && asked.*.preset < PRESET_COUNT {
        asked.*.width = PRESETS[asked.*.preset].width
        asked.*.height = PRESETS[asked.*.preset].height
        if PRESETS[asked.*.preset].resolution > 0.0 { asked.*.resolution = PRESETS[asked.*.preset].resolution }
    }
    var options = sideOptions(asked)
    const width_field = labelled(app, &rows, state.tr(app, "Width", "Breite"), row)
    var shown = toUnit(asked, asked.*.width)
    if kit_module.spinBox(kit, idAt(app, level, PART_FIELD + 2), ui.rect(width_field.x, width_field.y, narrow, row), &shown, &options) {
        asked.*.width = fromUnit(asked, shown)
        asked.*.preset = 0
    }
    // The unit is the width's and the height's, beside the first.
    const unit_area = ui.rect(width_field.x + narrow + 8 * s, width_field.y, 72 * s, row)
    _ = kit_module.comboBoxWith(kit, idAt(app, level, PART_FIELD + 4), unit_area, 3, unitName, 0, &asked.*.unit)
    const height_field = labelled(app, &rows, state.tr(app, "Height", "Höhe"), row)
    shown = toUnit(asked, asked.*.height)
    if kit_module.spinBox(kit, idAt(app, level, PART_FIELD + 3), ui.rect(height_field.x, height_field.y, narrow, row), &shown, &options) {
        asked.*.height = fromUnit(asked, shown)
        asked.*.preset = 0
    }
    const resolution_field = labelled(app, &rows, state.tr(app, "Resolution", "Auflösung"), row)
    var resolution_options = kit_module.sliderOptions(1.0, 9600.0, 1.0, 0)
    resolution_options.suffix = " ppi"
    var resolution = asked.*.resolution
    if kit_module.spinBox(kit, idAt(app, level, PART_FIELD + 5), ui.rect(resolution_field.x, resolution_field.y, narrow, row), &resolution, &resolution_options) { asked.*.resolution = resolution }
    const turn_field = labelled(app, &rows, state.tr(app, "Orientation", "Ausrichtung"), row)
    const first = if turn_field.width > 260 * s { 130 * s } else { turn_field.width / 2 }
    if kit_module.radio(kit, idAt(app, level, PART_FIELD + 6), ui.rect(turn_field.x, turn_field.y, first, row), state.tr(app, "Portrait", "Hochformat"), asked.*.height > asked.*.width) && asked.*.width > asked.*.height { swapSides(asked) }
    if kit_module.radio(kit, idAt(app, level, PART_FIELD + 7), ui.rect(turn_field.x + first, turn_field.y, first, row), state.tr(app, "Landscape", "Querformat"), asked.*.width > asked.*.height) && asked.*.height > asked.*.width { swapSides(asked) }
    const ground_field = labelled(app, &rows, state.tr(app, "Background", "Hintergrund"), row)
    const swatch = ROW * s
    _ = kit_module.comboBoxWith(kit, idAt(app, level, PART_FIELD + 8), ui.rect(ground_field.x, ground_field.y, ground_field.width - swatch - 8 * s, row), GROUNDS, groundName, @intFromPtr(app), &asked.*.ground)
    _ = kit_module.colorSwatch(kit, idAt(app, level, PART_FIELD + 9), ui.rect(ui.right(ground_field) - swatch, ground_field.y, swatch, row), groundColor(app, asked.*.ground), false)
    const note_field = labelled(app, &rows, "", row)
    kit_module.label(kit, note_field, layerNote(app, asked), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    scrollEnd(app)
    if clicked != null { close(app, level, if clicked.? == 0 { 0 } else { CANCEL }) }
}

fn swapSides(asked: *NewImage) -> void {
    const width = asked.*.width
    asked.*.width = asked.*.height
    asked.*.height = width
    asked.*.preset = 0
}

// "One layer takes 33.2 MiB", in the body's note.
fn layerNote(app: *App, asked: *NewImage) -> []const u8 {
    const bytes: [*]u8 = &asked.*.note
    const size = @floatFromInt(f64, asked.*.width) * @floatFromInt(f64, asked.*.height) * 4.0 / 1048576.0
    var length = std.text.append(bytes, 0, 96, state.tr(app, "One layer takes ", "Eine Ebene belegt "))
    var number: [32]u8 = undefined
    const digits: [*]u8 = &number
    const count = kit_module.formatNumber(size, 1, digits)
    var index: usize = 0
    while index < count {
        const byte = if app.*.german && digits[index] == 46 { 44 } else { digits[index] }
        length = std.text.appendByte(bytes, length, 96, byte)
        index += 1
    }
    length = std.text.append(bytes, length, 96, " MiB")
    return bytes[0..length]
}

fn finishNewImage(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const store = storeOf(app)
    if store == null { return }
    const asked = newImageOf(app, level)
    const width = asked.*.width
    const height = asked.*.height
    const resolution = resolutionOf(asked)
    const ground = groundColor(app, asked.*.ground)
    store.?.*.answerLength = copyInto(&store.?.*.answer, ANSWER, textOf(&asked.*.name, asked.*.nameLength))
    const doc = documents.create(app, width, height, resolution, ground)
    if doc != null && store.?.*.answerLength > 0 { documents.setName(doc.?, textOf(&store.?.*.answer, store.?.*.answerLength)) }
}

// ---------------------------------------------------------------------------
// Layer Properties

// The colour labels a layer can carry (Node.label 1-8; 0: none), straight.
pub fn labelColor(label: u8) -> u32 {
    if label == 1 { return 0xFF4A8FD9 }
    if label == 2 { return 0xFF5BB36A }
    if label == 3 { return 0xFFE3C547 }
    if label == 4 { return 0xFFE8903C }
    if label == 5 { return 0xFF9C6C4A }
    if label == 6 { return 0xFFD9534F }
    if label == 7 { return 0xFF9A6BD0 }
    if label == 8 { return 0xFF8C919B }
    return 0
}

pub const LABELS: u8 = 8

// A row of the blend mode list: a mode, or with HEADING a category's
// heading.
const HEADING: u16 = 32768
const BLEND_ROWS: usize = 160

const LayerBody = struct {
    image: usize
    nodeId: u32
    props: node_module.Props
    group: bool
    blendRow: usize
    rows: [160]u16
    rowCount: usize
    german: bool
}

fn layerOf(app: *App, level: usize) -> *LayerBody { return unsafe { @ptrCast(*LayerBody, body(app, level)) } }

fn blendRowName(context: usize, index: usize) -> []const u8 {
    const asked: *LayerBody = unsafe { @ptrFromInt(*LayerBody, context) }
    if index >= asked.*.rowCount { return "" }
    const row = asked.*.rows[index]
    if row & HEADING != 0 { return blend.categoryTitle(@intCast(u8, row & 255), asked.*.german) }
    return blend.title(row, asked.*.german)
}

fn blendRowKind(context: usize, index: usize) -> u8 {
    const asked: *LayerBody = unsafe { @ptrFromInt(*LayerBody, context) }
    if index >= asked.*.rowCount { return kit_module.LIST_ITEM }
    return if asked.*.rows[index] & HEADING != 0 { kit_module.LIST_HEADING } else { kit_module.LIST_ITEM }
}

// The properties of `node` (a node of the image in front): its name,
// opacity (0-100 %), blend mode, whether it is shown, locked, alpha
// locked, inherits alpha, passes through (a group), its colour label.
// Nothing changes before OK; OK makes all of it one step of the history
// (core/ops.mlx's changed); Cancel leaves no trace. False when it cannot
// be shown (the node is not the image's in front, too many dialogs).
pub fn layerProperties(app: *App, node: *Node) -> bool {
    const picture = api.image(app)
    if picture == null { return false }
    const found = node_module.find(picture.?.*.root, node.*.id)
    if found == null || @intFromPtr(found.?) != @intFromPtr(node) { return false }
    const hooks = Hooks.{ .kind = KIND_LAYER, .draw = drawLayer, .key = null, .finish = finishLayer, .tabs = false, .closable = true }
    const level = host(app, hooks, @sizeOf(LayerBody))
    if level == null { return false }
    const asked = layerOf(app, level.?)
    asked.*.image = @intFromPtr(picture.?)
    asked.*.nodeId = node.*.id
    asked.*.props = node_module.props(node)
    asked.*.group = node.*.kind == node_module.GROUP
    var count: usize = 0
    var last: u8 = 255
    var index: usize = 0
    const listed = blend.listedCount()
    while index < listed && count + 2 <= BLEND_ROWS {
        const mode = blend.listed(index)
        const category = blend.category(mode)
        if category != last {
            asked.*.rows[count] = HEADING | @intCast(u16, category)
            count += 1
            last = category
        }
        if mode == asked.*.props.blend { asked.*.blendRow = count }
        asked.*.rows[count] = mode
        count += 1
        index += 1
    }
    asked.*.rowCount = count
    return true
}

fn layerHeight(app: *App) -> i32 {
    const s = scaleOf(app)
    return 7 * (ROW + GAP) * s
}

fn drawLayer(app: *App, level: usize, window: ui.Rect) -> void {
    const asked = layerOf(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const row = ROW * s
    asked.*.german = app.*.german
    const natural = layerHeight(app)
    var content = frame(app, window, state.tr(app, "Layer Properties", "Ebeneneigenschaften"), 460 * s, framed(app, natural))
    const labels = labelRoom(app)
    labels[0] = okLabel(app)
    labels[1] = cancelLabel(app)
    const clicked = buttons(app, &content, labels[0..2], 0)
    var rows = scrollBegin(app, content, natural)
    const props = &asked.*.props
    _ = kit_module.textBox(kit, idAt(app, level, PART_FIELD), labelled(app, &rows, "Name", row), &props.*.name, &props.*.nameLength, node_module.NAME, "")
    var percent = kit_module.sliderOptions(0.0, 100.0, 1.0, 0)
    percent.suffix = " %"
    var opacity = @floatFromInt(f64, props.*.opacity) * 100.0 / 255.0
    if kit_module.slider(kit, idAt(app, level, PART_FIELD + 1), labelled(app, &rows, state.tr(app, "Opacity", "Deckkraft"), row), "", &opacity, &percent) {
        props.*.opacity = @intCast(u8, byteOf(opacity * 2.55))
    }
    if kit_module.comboBoxKinds(kit, idAt(app, level, PART_FIELD + 2), labelled(app, &rows, state.tr(app, "Blend mode", "Mischmodus"), row), asked.*.rowCount, blendRowName, blendRowKind, @intFromPtr(asked), &asked.*.blendRow) {
        if asked.*.blendRow < asked.*.rowCount && asked.*.rows[asked.*.blendRow] & HEADING == 0 { props.*.blend = asked.*.rows[asked.*.blendRow] }
    }
    const first = labelled(app, &rows, state.tr(app, "Options", "Optionen"), row)
    const half = first.width / 2
    _ = kit_module.checkBox(kit, idAt(app, level, PART_FIELD + 3), ui.rect(first.x, first.y, half, row), state.tr(app, "Visible", "Sichtbar"), &props.*.visible)
    _ = kit_module.checkBox(kit, idAt(app, level, PART_FIELD + 4), ui.rect(first.x + half, first.y, first.width - half, row), state.tr(app, "Locked", "Gesperrt"), &props.*.locked)
    const second = labelled(app, &rows, "", row)
    _ = kit_module.checkBox(kit, idAt(app, level, PART_FIELD + 5), ui.rect(second.x, second.y, half, row), state.tr(app, "Alpha locked", "Alpha gesperrt"), &props.*.alphaLocked)
    _ = kit_module.checkBox(kit, idAt(app, level, PART_FIELD + 6), ui.rect(second.x + half, second.y, second.width - half, row), state.tr(app, "Inherit alpha", "Alpha erben"), &props.*.inheritAlpha)
    const third = labelled(app, &rows, "", row)
    // Only a group passes through; for another layer it is shown, faded.
    if !asked.*.group { kit_module.disabledBegin(kit) }
    _ = kit_module.checkBox(kit, idAt(app, level, PART_FIELD + 7), ui.rect(third.x, third.y, third.width, row), state.tr(app, "Pass through", "Durchreichen"), &props.*.passThrough)
    if !asked.*.group { kit_module.disabledEnd(kit) }
    const label_field = labelled(app, &rows, state.tr(app, "Colour label", "Farbmarkierung"), row)
    const step = (label_field.width + 4 * s) / 9
    const side = if step - 4 * s < row { step - 4 * s } else { row }
    var label: u8 = 0
    while label <= LABELS {
        const area = ui.rect(label_field.x + @intCast(i32, label) * step, label_field.y + (row - side) / 2, side, side)
        if kit_module.colorSwatch(kit, idAt(app, level, PART_FIELD + 8 + @intCast(usize, label)), area, labelColor(label), props.*.label == label) { props.*.label = label }
        label += 1
    }
    scrollEnd(app)
    if clicked != null { close(app, level, if clicked.? == 0 { 0 } else { CANCEL }) }
}

fn sameProps(a: *const node_module.Props, b: *const node_module.Props) -> bool {
    if a.*.nameLength != b.*.nameLength || a.*.visible != b.*.visible || a.*.locked != b.*.locked || a.*.alphaLocked != b.*.alphaLocked { return false }
    if a.*.inheritAlpha != b.*.inheritAlpha || a.*.passThrough != b.*.passThrough || a.*.opacity != b.*.opacity || a.*.blend != b.*.blend || a.*.label != b.*.label { return false }
    var index: usize = 0
    while index < a.*.nameLength && index < node_module.NAME {
        if a.*.name[index] != b.*.name[index] { return false }
        index += 1
    }
    return true
}

fn finishLayer(app: *App, level: usize, answer: usize) -> void {
    if answer != 0 { return }
    const asked = layerOf(app, level)
    // The image must still be open (it is, unless a dialog over this one
    // closed it).
    var picture: ?*image_module.Image = null
    var index: usize = 0
    while index < app.*.count {
        const doc = app.*.documents[index]
        if doc != null && @intFromPtr(doc.?.*.image) == asked.*.image { picture = doc.?.*.image }
        index += 1
    }
    if picture == null { return }
    const node = node_module.find(picture.?.*.root, asked.*.nodeId)
    if node == null { return }
    const before = node_module.props(node.?)
    if sameProps(&before, &asked.*.props) { return }
    node_module.setProps(node.?, &asked.*.props)
    ops.changed(picture.?, node.?, &before, state.tr(app, "Layer properties", "Ebeneneigenschaften"))
    api.layersChanged(app)
}

// ---------------------------------------------------------------------------
// About

// What the program is, in a small dialog with an OK button. False when it
// cannot be shown.
pub fn about(app: *App) -> bool {
    const hooks = Hooks.{ .kind = KIND_ABOUT, .draw = drawAbout, .key = null, .finish = finishNothing, .tabs = true, .closable = true }
    return host(app, hooks, 0) != null
}

fn drawAbout(app: *App, level: usize, window: ui.Rect) -> void {
    const kit = api.kit(app)
    const s = scaleOf(app)
    const theme = state.themeOf(app)
    const line = 20 * s
    const natural = 32 * s + 3 * line
    var content = frame(app, window, state.tr(app, "About Nebula", "Über Nebula"), 400 * s, framed(app, natural))
    const labels = labelRoom(app)
    labels[0] = okLabel(app)
    if buttons(app, &content, labels[0..1], 0) != null { close(app, level, 0) }
    var rows = scrollBegin(app, content, natural)
    const head = ui.takeTop(&rows, 32 * s)
    const canvas = state.uiOf(app).*.canvas
    icons.draw(canvas, icons.TOOL_BRUSH, head.x, head.y + (head.height - 24 * s) / 2, 24 * s, theme.*.accent)
    const title_font = state.titleOf(app)
    text_module.drawText(canvas, title_font, "Nebula", head.x + 34 * s, head.y + (head.height - title_font.*.ascent * 3 / 2) / 2, theme.*.text, 0)
    kit_module.label(kit, ui.takeTop(&rows, line), state.tr(app, "A painting program: layers, brushes, selections, filters.", "Ein Malprogramm: Ebenen, Pinsel, Auswahlen, Filter."), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    kit_module.label(kit, ui.takeTop(&rows, line), state.tr(app, "Written in Mlx, for brixOS and Linux.", "Geschrieben in Mlx, für brixOS und Linux."), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    var system = state.tr(app, "This build runs on Linux.", "Dieser Build läuft unter Linux.")
    if comptime builtin.os == builtin.Os.brixos { system = state.tr(app, "This build runs on brixOS.", "Dieser Build läuft unter brixOS.") }
    kit_module.label(kit, ui.takeTop(&rows, line), system, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    scrollEnd(app)
}

// ---------------------------------------------------------------------------
// Progress

const Progress = struct {
    title: [128]u8
    titleLength: usize
    text: [256]u8
    textLength: usize
    // 0..1; below 0: not known (a bar that is busy).
    fraction: f64
    cancelled: bool
}

fn progressOf(app: *App, level: usize) -> *Progress { return unsafe { @ptrCast(*Progress, body(app, level)) } }

// The progress dialog's level when it is open.
fn progressLevel(app: *App) -> ?usize {
    const store = storeOf(app)
    if store == null || !store.?.*.progressOpen { return null }
    const level = store.?.*.progressLevel
    const entry = entryOf(app, level)
    if entry == null || !entry.?.*.open || entry.?.*.closing || entry.?.*.hooks.kind != KIND_PROGRESS || !ours(app, level) {
        store.?.*.progressOpen = false
        return null
    }
    return level
}

// Shows that long work is under way, under `title`, with a bar (busy
// until progressUpdate says how far it is) and a Cancel button (see the
// header for what it does with one thread). One at a time: when one is
// open it is given the new title. False when it cannot be shown.
pub fn progressBegin(app: *App, title: []const u8) -> bool {
    const store = storeOf(app)
    if store == null { return false }
    var level = progressLevel(app)
    if level == null {
        const hooks = Hooks.{ .kind = KIND_PROGRESS, .draw = drawProgress, .key = keyProgress, .finish = finishNothing, .tabs = false, .closable = false }
        level = host(app, hooks, @sizeOf(Progress))
        if level == null { return false }
        store.?.*.progressLevel = level.?
        store.?.*.progressOpen = true
    }
    const shown = progressOf(app, level.?)
    shown.*.titleLength = copyInto(&shown.*.title, TITLE, title)
    shown.*.textLength = 0
    shown.*.fraction = -1.0
    shown.*.cancelled = false
    api.redraw(app)
    return true
}

// How far the work is (`fraction` 0..1; below 0: not known) and what it
// does now (`text`, copied); shown with the next frame.
pub fn progressUpdate(app: *App, fraction: f64, text: []const u8) -> void {
    const level = progressLevel(app)
    if level == null { return }
    const shown = progressOf(app, level.?)
    shown.*.fraction = if fraction != fraction { -1.0 } else if fraction > 1.0 { 1.0 } else { fraction }
    shown.*.textLength = copyInto(&shown.*.text, ANSWER, text)
    api.redraw(app)
}

// The work is over: the progress dialog goes.
pub fn progressEnd(app: *App) -> void {
    const level = progressLevel(app)
    if level == null { return }
    const store = storeOf(app)
    if store != null { store.?.*.progressOpen = false }
    close(app, level.?, 0)
}

// Whether the person asked the work under way to stop (Cancel, Escape).
pub fn progressCancelled(app: *App) -> bool {
    const level = progressLevel(app)
    if level == null { return false }
    return progressOf(app, level.?).*.cancelled
}

fn keyProgress(app: *App, level: usize, code: u32, modifiers: u32, typed: []const u8) -> bool {
    if code == keys.ESCAPE { progressOf(app, level).*.cancelled = true }
    // (Nothing else closes it: the work does.)
    return true
}

fn drawProgress(app: *App, level: usize, window: ui.Rect) -> void {
    const shown = progressOf(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const natural = ROW * s + GAP * s + 8 * s
    var content = frame(app, window, textOf(&shown.*.title, shown.*.titleLength), 420 * s, framed(app, natural))
    const labels = labelRoom(app)
    labels[0] = if shown.*.cancelled { state.tr(app, "Stopping…", "Wird beendet …") } else { cancelLabel(app) }
    // (Cancel is no answer here, only a wish: not the primary button.)
    if buttons(app, &content, labels[0..1], 1) != null { shown.*.cancelled = true }
    var rows = scrollBegin(app, content, natural)
    const line = ui.takeTop(&rows, ROW * s)
    const percent_width = 44 * s
    kit_module.label(kit, ui.rect(line.x, line.y, line.width - percent_width, line.height), textOf(&shown.*.text, shown.*.textLength), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    _ = ui.takeTop(&rows, GAP * s)
    const bar = ui.takeTop(&rows, 8 * s)
    if shown.*.fraction < 0.0 {
        kit_module.busy(kit, bar)
    } else {
        kit_module.progress(kit, bar, shown.*.fraction)
        var digits: [16]u8 = undefined
        const bytes: [*]u8 = &digits
        var length = std.text.appendUnsigned(bytes, 0, 16, @intCast(usize, byteOf(shown.*.fraction * 100.0)))
        length = std.text.append(bytes, length, 16, " %")
        kit_module.label(kit, ui.rect(ui.right(line) - percent_width, line.y, percent_width, line.height), bytes[0..length], kit_module.TEXT_NORMAL, kit_module.ALIGN_RIGHT)
    }
    scrollEnd(app)
}
