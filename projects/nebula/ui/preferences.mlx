// nebula ui: the preferences: one dialog with a list of pages at its
// left. General, Canvas, Painting, Tablet and Files show the settings of
// their group of app/settings.mlx (settingAt() describes each: a number
// in a spin box, a switch as a check box, a choice in a drop-down list, a
// colour as a swatch that opens the colour dialog, a text in a field);
// Tablet is the pen's pressure curve in the kit's curve editor; Language
// is a choice of three; Shortcuts lists every action and tool with its
// shortcut (app/shortcuts.mlx).
//
//     preferences.open(app, preferences.PAGE_GENERAL)
//     preferences.showShortcuts(app)          // Help: the list of all shortcuts
//
// Every change applies at once and the settings file is written
// (settings.changed) when it is complete (a number taken, a box ticked, a
// drag let go): there is no Cancel, only Close. What applying means: the
// language at once, the history of every open image keeps as many steps
// as Undo steps says; the rest is read by its parts when they need it.
// Restore Defaults puts the page's settings back (on Shortcuts, after
// asking, every shortcut).
//
// The shortcuts: a filter field over the list keeps the rows whose name
// or shortcut has what is typed. A click on a row (or Enter on the row
// the Up and Down keys chose) waits for the next key press, which becomes
// the row's shortcut; Escape stops waiting, Backspace and Delete take the
// shortcut away. A shortcut that another row has is not taken at the
// first press: the line above the list names the other row, and the same
// keys pressed again give it to this row (the other has none then). A row
// whose shortcut is not its own shows a button that gives its own back.
//
// Sizes are logical pixels times the theme's scale; the dialog fits
// 1024 x 768 (in a smaller window its pages scroll).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const shell_module = @import("../app/shell.mlx")
const settings = @import("../app/settings.mlx")
const shortcuts = @import("../app/shortcuts.mlx")
const dialogs = @import("./dialogs.mlx")
const kit_module = @import("./kit.mlx")
const menus = @import("./menus.mlx")
const actions = @import("../actions/registry.mlx")
const tools = @import("../tools/registry.mlx")
const color_module = @import("../core/color.mlx")

pub const App = state.App

pub const PAGE_GENERAL: usize = 0
pub const PAGE_CANVAS: usize = 1
pub const PAGE_PAINTING: usize = 2
pub const PAGE_TABLET: usize = 3
pub const PAGE_FILES: usize = 4
pub const PAGE_SHORTCUTS: usize = 5
pub const PAGE_LANGUAGE: usize = 6
pub const PAGES: usize = 7

// The dialogs' kinds for dialogs.find (theirs are below 16, a form's 16).
const KIND_PREFS: u8 = 42
const KIND_KEYS: u8 = 43
const NONE: usize = 18446744073709551615

// The dialog's parts (dialogs.idOf): a page's row in the list, a
// setting's field (by its number), the filter, the shortcuts' list, the
// curve, a language's radio button.
const PART_PAGE: usize = 100
const PART_SETTING: usize = 200
const PART_FILTER: usize = 300
const PART_LIST: usize = 301
const PART_CURVE: usize = 302
const PART_LANGUAGE: usize = 310

// Sizes (times the scale): the dialog, the list of pages, a row of the
// shortcuts' list, the label column of a setting at most.
const WIDTH: i32 = 760
const CONTENT: i32 = 440
const PAGE_LIST: i32 = 168
const LIST_ROW: i32 = 26
const LABEL_MOST: i32 = 270
const FILTER: usize = 64
const CURVE: usize = 32

// What a drop-down list of a choice is named from.
const Choice = struct {
    setting: usize
    app: usize
}

const Prefs = struct {
    page: usize
    // The shortcuts: the filter's text, the list's scroll and view, the
    // row the keys chose, the row waiting for its keys, a shortcut that
    // another row has (waiting to be pressed again) and that row's key.
    filter: [64]u8
    filterLength: usize
    scroll: i32
    listHeight: i32
    chosen: usize
    recording: usize
    pending: keys.Shortcut
    pendingRow: usize
    conflict: [128]u8
    conflictLength: usize
    // What the line above the list says (empty: the usual hint).
    message: [256]u8
    messageLength: usize
    messageDanger: bool
    // The pressure curve as the editor has it.
    xs: [32]f32
    ys: [32]f32
    count: usize
    curveLoaded: bool
    // The file format's field.
    format: [32]u8
    formatLength: usize
    // The setting whose colour dialog is open.
    picking: usize
    choices: [32]Choice
    chosenWords: [32]usize
    hex: [16]u8
    keyRoom: [128]u8
    labels: [2][]const u8
    // What Restore Defaults takes the page's settings from.
    defaults: settings.Preferences
}

fn prefsOf(app: *App, level: usize) -> *Prefs { return unsafe { @ptrCast(*Prefs, dialogs.body(app, level)) } }

fn rowBase() -> u64 { return view.id("nebula.preferences.row") }
fn resetBase() -> u64 { return view.id("nebula.preferences.reset") }

// ---------------------------------------------------------------------------
// The settings' fields

fn bytesOf(prefs: *settings.Preferences) -> [*]u8 { unsafe { return @ptrCast([*]u8, prefs) } }
fn numberAt(prefs: *settings.Preferences, offset: usize) -> *u32 { unsafe { return @ptrCast(*u32, bytesOf(prefs) + offset) } }
fn switchAt(prefs: *settings.Preferences, offset: usize) -> *bool { unsafe { return @ptrCast(*bool, bytesOf(prefs) + offset) } }
fn choiceAt(prefs: *settings.Preferences, offset: usize) -> *u8 { unsafe { return @ptrCast(*u8, bytesOf(prefs) + offset) } }
fn lineAt(prefs: *settings.Preferences, offset: usize) -> *settings.Line { unsafe { return @ptrCast(*settings.Line, bytesOf(prefs) + offset) } }

fn settingNamed(key: []const u8) -> usize {
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const row = settings.settingAt(index)
        if row != null && std.text.same(row.?.*.key, key) { return index }
        index += 1
    }
    return NONE
}

// The language the environment asks for (LC_ALL, LC_MESSAGES, LANG: "de"
// first is German), as the program starts with.
fn germanLocale(app: *App) -> bool {
    var value = shell_module.environmentValue(app.*.shell, "LC_ALL")
    if value.length == 0 { value = shell_module.environmentValue(app.*.shell, "LC_MESSAGES") }
    if value.length == 0 { value = shell_module.environmentValue(app.*.shell, "LANG") }
    return value.length >= 2 && value[0] == 100 && value[1] == 101
}

// Setting `index` changed (in memory): what follows from it is done and
// the settings are written.
fn applied(app: *App, index: usize) -> void {
    const row = settings.settingAt(index)
    if row == null { return }
    const prefs = settings.get(app)
    if std.text.same(row.?.*.key, "language") {
        const language = prefs.*.language
        app.*.german = if language == settings.LANGUAGE_GERMAN { true } else if language == settings.LANGUAGE_ENGLISH { false } else { germanLocale(app) }
    } else if std.text.same(row.?.*.key, "undo_steps") {
        var doc: usize = 0
        while doc < app.*.count {
            const open_doc = app.*.documents[doc]
            if open_doc != null { open_doc.?.*.image.*.history.*.limit = @intCast(usize, prefs.*.undoSteps) }
            doc += 1
        }
    }
    if !settings.changed(app) { api.say(app, state.tr(app, "The settings could not be saved", "Die Einstellungen konnten nicht gespeichert werden"), true) }
    api.redraw(app)
}

fn pageName(app: *App, page: usize) -> []const u8 {
    if page == PAGE_GENERAL { return state.tr(app, "General", "Allgemein") }
    if page == PAGE_CANVAS { return state.tr(app, "Canvas", "Arbeitsfläche") }
    if page == PAGE_PAINTING { return state.tr(app, "Painting", "Malen") }
    if page == PAGE_TABLET { return state.tr(app, "Tablet", "Grafiktablett") }
    if page == PAGE_FILES { return state.tr(app, "Files", "Dateien") }
    if page == PAGE_SHORTCUTS { return state.tr(app, "Shortcuts", "Tastenkürzel") }
    return state.tr(app, "Language", "Sprache")
}

// The settings' group a page shows (none: a page of its own).
fn groupOf(page: usize) -> ?u8 {
    var group: ?u8 = null
    if page == PAGE_GENERAL { group = settings.GENERAL }
    if page == PAGE_CANVAS { group = settings.CANVAS }
    if page == PAGE_PAINTING { group = settings.PAINTING }
    if page == PAGE_FILES { group = settings.FILES }
    return group
}

// Whether setting `row` is shown as a row of its group's page (the
// language has its page, the curve the Tablet page).
fn listed(row: *const settings.Setting) -> bool {
    return !std.text.same(row.*.key, "language") && !std.text.same(row.*.key, "pressure_curve")
}

// A CHOICE's word as people read it.
fn wordName(app: *App, key: []const u8, number: usize) -> []const u8 {
    if std.text.same(key, "theme") || std.text.same(key, "language") {
        if number == 0 { return state.tr(app, "Like the system", "Wie das System") }
        if std.text.same(key, "language") { return if number == 1 { "English" } else { "Deutsch" } }
        return if number == 1 { state.tr(app, "Dark", "Dunkel") } else { state.tr(app, "Light", "Hell") }
    }
    if std.text.same(key, "wheel_zoom") {
        return if number == 0 { state.tr(app, "The wheel", "Dem Mausrad") } else { state.tr(app, "Ctrl and the wheel", "Strg und dem Mausrad") }
    }
    if std.text.same(key, "smoothing") {
        if number == 0 { return state.tr(app, "None", "Keine") }
        if number == 1 { return state.tr(app, "Basic", "Einfach") }
        if number == 2 { return state.tr(app, "Weighted", "Gewichtet") }
        if number == 3 { return state.tr(app, "Stabilizer", "Stabilisator") }
        return state.tr(app, "Pixel art", "Pixelkunst")
    }
    const row = settings.settingAt(settingNamed(key))
    if row == null { return "" }
    return settings.word(row.?, number)
}

fn choiceName(context: usize, index: usize) -> []const u8 {
    const choice: *Choice = unsafe { @ptrFromInt(*Choice, context) }
    const app: *App = unsafe { @ptrFromInt(*App, choice.*.app) }
    const row = settings.settingAt(choice.*.setting)
    if row == null { return "" }
    return wordName(app, row.?.*.key, index)
}

// ---------------------------------------------------------------------------
// The curve as text ("x,y;x,y", numbers 0 to 1)

// A number from 0 to 1 as "0", "1" or "0.25" (three digits at most).
fn appendUnit(into: [*]u8, at: usize, capacity: usize, value: f32) -> usize {
    if !(value > 0.0) { return std.text.appendByte(into, at, capacity, 48) }
    if value >= 1.0 { return std.text.appendByte(into, at, capacity, 49) }
    var thousandths = @intFromFloat(u32, @floatCast(f64, value) * 1000.0 + 0.5)
    if thousandths >= 1000 { return std.text.appendByte(into, at, capacity, 49) }
    if thousandths == 0 { return std.text.appendByte(into, at, capacity, 48) }
    var length = std.text.append(into, at, capacity, "0.")
    var digits: u32 = 3
    while thousandths % 10 == 0 {
        thousandths /= 10
        digits -= 1
    }
    var divisor: u32 = if digits == 3 { 100 } else if digits == 2 { 10 } else { 1 }
    while divisor > 0 {
        length = std.text.appendByte(into, length, capacity, @intCast(u8, 48 + (thousandths / divisor) % 10))
        divisor /= 10
    }
    return length
}

// A number "0", "1", "0.25" (settings.mlx's check took it already).
fn readUnit(text: []const u8) -> f32 {
    var value: f64 = 0.0
    var index: usize = 0
    while index < text.length && text[index] >= 48 && text[index] <= 57 {
        value = value * 10.0 + @floatFromInt(f64, text[index] - 48)
        index += 1
    }
    if index < text.length && text[index] == 46 {
        index += 1
        var place: f64 = 0.1
        while index < text.length && text[index] >= 48 && text[index] <= 57 {
            value += place * @floatFromInt(f64, text[index] - 48)
            place /= 10.0
            index += 1
        }
    }
    if value > 1.0 { value = 1.0 }
    return @floatCast(f32, value)
}

fn loadCurve(body: *Prefs, text: []const u8) -> void {
    body.*.count = 0
    var at: usize = 0
    while at < text.length && body.*.count < CURVE {
        var end = at
        while end < text.length && text[end] != 59 { end += 1 }
        const point = text[at..end]
        var comma: usize = 0
        while comma < point.length && point[comma] != 44 { comma += 1 }
        if comma < point.length {
            body.*.xs[body.*.count] = readUnit(point[0..comma])
            body.*.ys[body.*.count] = readUnit(point[comma + 1..point.length])
            body.*.count += 1
        }
        at = end + 1
    }
    if body.*.count < 2 {
        body.*.xs[0] = 0.0
        body.*.ys[0] = 0.0
        body.*.xs[1] = 1.0
        body.*.ys[1] = 1.0
        body.*.count = 2
    }
    body.*.curveLoaded = true
}

// The editor's points as the setting's text.
fn saveCurve(app: *App, body: *Prefs) -> void {
    const prefs = settings.get(app)
    var text: [settings.LINE]u8 = undefined
    const bytes: [*]u8 = &text
    var length: usize = 0
    var index: usize = 0
    while index < body.*.count {
        if index > 0 { length = std.text.appendByte(bytes, length, settings.LINE, 59) }
        length = appendUnit(bytes, length, settings.LINE, body.*.xs[index])
        length = std.text.appendByte(bytes, length, settings.LINE, 44)
        length = appendUnit(bytes, length, settings.LINE, body.*.ys[index])
        index += 1
    }
    if !settings.setLine(&prefs.*.pressureCurve, bytes[0..length]) { return }
    applied(app, settingNamed("pressure_curve"))
}

// ---------------------------------------------------------------------------
// Opening

// Opens the preferences at `page` (PAGE_*). False when they cannot be
// shown (too many dialogs, no memory).
pub fn open(app: *App, page: usize) -> bool {
    const hooks = dialogs.Hooks.{ .kind = KIND_PREFS, .draw = drawPrefs, .key = keyPrefs, .finish = finishNothing, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(Prefs))
    if level == null { return false }
    const body = prefsOf(app, level.?)
    body.*.page = if page < PAGES { page } else { PAGE_GENERAL }
    body.*.chosen = NONE
    body.*.recording = NONE
    body.*.pendingRow = NONE
    body.*.picking = NONE
    body.*.pending = keys.none()
    // (The body is zeroed: no filter, no message, the curve and the
    // format's field read when first shown.)
    return true
}

fn finishNothing(app: *App, level: usize, answer: usize) -> void {}

// The preferences' level when they are open (null: they are not).
fn levelNow(app: *App) -> ?usize { return dialogs.find(app, KIND_PREFS) }

// The page shown (PAGE_*), or PAGES when the preferences are not open.
pub fn page(app: *App) -> usize {
    const level = levelNow(app)
    if level == null { return PAGES }
    return prefsOf(app, level.?).*.page
}

// Where a page's row of the list was in the last frame (empty: not
// open).
pub fn pageArea(app: *App, which: usize) -> ui.Rect {
    const level = levelNow(app)
    if level == null { return ui.rect(0, 0, 0, 0) }
    return view.areaOf(state.uiOf(app), dialogs.idOf(app, level.?, PART_PAGE + which))
}

// Where the field of the setting named `key` ("undo_steps") was in the
// last frame (empty: not shown).
pub fn settingArea(app: *App, key: []const u8) -> ui.Rect {
    const level = levelNow(app)
    const index = settingNamed(key)
    if level == null || index == NONE { return ui.rect(0, 0, 0, 0) }
    return view.areaOf(state.uiOf(app), dialogs.idOf(app, level.?, PART_SETTING + index))
}

// Where the shortcuts' row of the action or tool named `key` ("file_new",
// "tool:brush") was in the last frame (empty: not shown).
pub fn rowArea(app: *App, key: []const u8) -> ui.Rect {
    const level = levelNow(app)
    if level == null { return ui.rect(0, 0, 0, 0) }
    const body = prefsOf(app, level.?)
    const total = actions.count() + tools.count()
    var row: usize = 0
    while row < total {
        if std.text.same(rowKey(body, row), key) { return view.areaOf(state.uiOf(app), view.idOf(rowBase(), row)) }
        row += 1
    }
    return ui.rect(0, 0, 0, 0)
}

// The key of the action or tool whose shortcut a key press last asked
// for and that has it ("" when none): the conflict the list names.
pub fn conflict(app: *App) -> []const u8 {
    const level = levelNow(app)
    if level == null { return "" }
    const body = prefsOf(app, level.?)
    const bytes: [*]const u8 = &body.*.conflict
    return bytes[0..body.*.conflictLength]
}

// Whether a row waits for the keys of its new shortcut.
pub fn recording(app: *App) -> bool {
    const level = levelNow(app)
    return level != null && prefsOf(app, level.?).*.recording != NONE
}

// ---------------------------------------------------------------------------
// The shortcuts' rows: the actions in their order, then the tools

fn rowKey(body: *Prefs, row: usize) -> []const u8 {
    const action_count = actions.count()
    if row < action_count {
        const action = actions.at(row)
        if action == null { return "" }
        return action.?.*.key
    }
    const tool = tools.at(row - action_count)
    if tool == null { return "" }
    const bytes: [*]u8 = &body.*.keyRoom
    var length = std.text.append(bytes, 0, 128, "tool:")
    length = std.text.append(bytes, length, 128, tool.?.*.key)
    return bytes[0..length]
}

fn rowName(app: *App, row: usize) -> []const u8 {
    const action_count = actions.count()
    if row < action_count {
        const action = actions.at(row)
        if action == null { return "" }
        return state.tr(app, action.?.*.name, action.?.*.german)
    }
    const tool = tools.at(row - action_count)
    if tool == null { return "" }
    return state.tr(app, tool.?.*.name, tool.?.*.german)
}

// Where the row belongs: its menu's title, or "Tool".
fn rowGroup(app: *App, row: usize) -> []const u8 {
    if row < actions.count() {
        const action = actions.at(row)
        if action == null { return "" }
        return menus.title(app, action.?.*.menu)
    }
    return state.tr(app, "Tool", "Werkzeug")
}

fn rowShortcut(app: *App, row: usize) -> keys.Shortcut {
    const action_count = actions.count()
    if row < action_count {
        const action = actions.at(row)
        if action == null { return keys.none() }
        return shortcuts.ofAction(app, action.?)
    }
    const tool = tools.at(row - action_count)
    if tool == null { return keys.none() }
    return shortcuts.ofTool(app, tool.?)
}

fn rowOwn(row: usize) -> keys.Shortcut {
    const action_count = actions.count()
    if row < action_count {
        const action = actions.at(row)
        if action == null { return keys.none() }
        return keys.parse(action.?.*.shortcut)
    }
    const tool = tools.at(row - action_count)
    if tool == null { return keys.none() }
    return keys.parse(tool.?.*.shortcut)
}

fn same(left: keys.Shortcut, right: keys.Shortcut) -> bool {
    return left.modifiers == right.modifiers && left.character == right.character && left.code == right.code
}

// The name of the action or tool a setting's key names.
fn nameOfKey(app: *App, key: []const u8) -> []const u8 {
    if std.text.startsWith(key, "tool:") {
        const tool = tools.byKey(key[5..key.length])
        if tool == null { return key }
        return state.tr(app, tool.?.*.name, tool.?.*.german)
    }
    const action = actions.byKey(key)
    if action == null { return key }
    return state.tr(app, action.?.*.name, action.?.*.german)
}

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// Whether `text` has `part` in it, letters in any case (ASCII).
fn has(text: []const u8, part: []const u8) -> bool {
    if part.length == 0 { return true }
    if part.length > text.length { return false }
    var start: usize = 0
    while start + part.length <= text.length {
        var index: usize = 0
        while index < part.length && lower(text[start + index]) == lower(part[index]) { index += 1 }
        if index == part.length { return true }
        start += 1
    }
    return false
}

fn filterOf(body: *Prefs) -> []const u8 {
    const bytes: [*]const u8 = &body.*.filter
    return std.text.trimmed(bytes[0..body.*.filterLength])
}

// Whether row `row` is in the list the filter leaves.
fn shown(app: *App, body: *Prefs, row: usize) -> bool {
    const wanted = filterOf(body)
    if wanted.length == 0 { return true }
    if has(rowName(app, row), wanted) { return true }
    var text: [32]u8 = undefined
    const bytes: [*]u8 = &text
    const length = keys.format(rowShortcut(app, row), bytes)
    return has(bytes[0..length], wanted)
}

fn setMessage(body: *Prefs, first: []const u8, second: []const u8, third: []const u8, danger: bool) -> void {
    const bytes: [*]u8 = &body.*.message
    var length = std.text.append(bytes, 0, 256, first)
    length = std.text.append(bytes, length, 256, second)
    body.*.messageLength = std.text.append(bytes, length, 256, third)
    body.*.messageDanger = danger
}

// The shortcut a key press is: its character (what it types without
// Control and Alt) or its key, the modifiers held. None when that is no
// shortcut a text can say (keys.format and keys.parse would not give it
// back).
fn pressed(code: u32, modifiers: u32, plain: []const u8) -> keys.Shortcut {
    var shortcut = keys.none()
    shortcut.modifiers = modifiers & (keys.CONTROL | keys.SHIFT | keys.ALT | keys.SUPER)
    if plain.length == 1 && plain[0] > 32 && plain[0] < 127 {
        shortcut.character = lower(plain[0])
    } else {
        shortcut.code = code
    }
    var text: [32]u8 = undefined
    const bytes: [*]u8 = &text
    const length = keys.format(shortcut, bytes)
    if !same(keys.parse(bytes[0..length]), shortcut) { return keys.none() }
    return shortcut
}

// Row `row` gets `shortcut` (none: no shortcut at all); a shortcut
// another row has needs a second press (see the header).
fn record(app: *App, body: *Prefs, row: usize, shortcut: keys.Shortcut) -> void {
    var text: [32]u8 = undefined
    const bytes: [*]u8 = &text
    var length = keys.format(shortcut, bytes)
    const key = rowKey(body, row)
    const other = shortcuts.conflict(app, shortcut, key)
    if other != null && !(body.*.pendingRow == row && same(body.*.pending, shortcut)) {
        body.*.pending = shortcut
        body.*.pendingRow = row
        const room: [*]u8 = &body.*.conflict
        body.*.conflictLength = std.text.append(room, 0, 128, other.?)
        const shown_keys = bytes[0..length]
        const message: [*]u8 = &body.*.message
        var at = std.text.append(message, 0, 256, shown_keys)
        at = std.text.append(message, at, 256, state.tr(app, " is taken by “", " gehört zu „"))
        at = std.text.append(message, at, 256, nameOfKey(app, other.?))
        at = std.text.append(message, at, 256, state.tr(app, "”: press it again to give it to this one.", "“: nochmals drücken, um es hierher zu holen."))
        body.*.messageLength = at
        body.*.messageDanger = true
        return
    }
    if other != null {
        // (Taken over: the other row has none now. Its key is copied: the
        // next lookup may reuse the bytes conflict() named it with.)
        var taken: [128]u8 = undefined
        const taken_bytes: [*]u8 = &taken
        const taken_length = std.text.append(taken_bytes, 0, 128, other.?)
        _ = shortcuts.set(app, taken_bytes[0..taken_length], "none")
    }
    if keys.isNone(shortcut) { length = std.text.append(bytes, 0, 32, "none") }
    if !shortcuts.set(app, key, bytes[0..length]) {
        setMessage(body, state.tr(app, "That cannot be a shortcut.", "Das kann kein Tastenkürzel sein."), "", "", true)
        return
    }
    body.*.recording = NONE
    body.*.pendingRow = NONE
    body.*.conflictLength = 0
    if keys.isNone(shortcut) {
        setMessage(body, state.tr(app, "“", "„"), rowName(app, row), state.tr(app, "” has no shortcut now.", "“ hat jetzt kein Tastenkürzel."), false)
    } else {
        setMessage(body, bytes[0..length], state.tr(app, " is the shortcut of “", " ist jetzt das Kürzel von „"), rowName(app, row), false)
        const message: [*]u8 = &body.*.message
        body.*.messageLength = std.text.append(message, body.*.messageLength, 256, state.tr(app, "” now.", "“."))
    }
    api.redraw(app)
}

fn startRecording(app: *App, body: *Prefs, row: usize) -> void {
    body.*.recording = row
    body.*.chosen = row
    body.*.pendingRow = NONE
    body.*.conflictLength = 0
    setMessage(body, state.tr(app, "Press the new shortcut for “", "Neues Kürzel drücken für „"), rowName(app, row), state.tr(app, "” (Escape: stop, Backspace: none).", "“ (Escape: abbrechen, Rücktaste: keins)."), false)
}

// The rows the filter leaves: how many, and the one at a place among
// them (NONE past the last).
fn shownCount(app: *App, body: *Prefs) -> usize {
    const total = actions.count() + tools.count()
    var found: usize = 0
    var row: usize = 0
    while row < total {
        if shown(app, body, row) { found += 1 }
        row += 1
    }
    return found
}

fn placeOf(app: *App, body: *Prefs, wanted: usize) -> usize {
    const total = actions.count() + tools.count()
    var place: usize = 0
    var row: usize = 0
    while row < total {
        if shown(app, body, row) {
            if row == wanted { return place }
            place += 1
        }
        row += 1
    }
    return NONE
}

fn rowAt(app: *App, body: *Prefs, place: usize) -> usize {
    const total = actions.count() + tools.count()
    var left = place
    var row: usize = 0
    while row < total {
        if shown(app, body, row) {
            if left == 0 { return row }
            left -= 1
        }
        row += 1
    }
    return NONE
}

// The list scrolled so that the row at `place` is in view.
fn reveal(app: *App, body: *Prefs, place: usize) -> void {
    const s = state.themeOf(app).*.scale
    const top = @intCast(i32, place) * LIST_ROW * s
    if top < body.*.scroll { body.*.scroll = top }
    if top + LIST_ROW * s > body.*.scroll + body.*.listHeight { body.*.scroll = top + LIST_ROW * s - body.*.listHeight }
    if body.*.scroll < 0 { body.*.scroll = 0 }
}

fn keyPrefs(app: *App, level: usize, code: u32, modifiers: u32, typed: []const u8) -> bool {
    const body = prefsOf(app, level)
    if body.*.page != PAGE_SHORTCUTS { return false }
    if body.*.recording != NONE {
        if keys.isModifier(code) { return true }
        if code == keys.ESCAPE && modifiers == 0 {
            body.*.recording = NONE
            body.*.pendingRow = NONE
            body.*.conflictLength = 0
            body.*.messageLength = 0
            return true
        }
        if (code == keys.BACKSPACE || code == keys.DELETE) && modifiers == 0 {
            record(app, body, body.*.recording, keys.none())
            return true
        }
        const shortcut = pressed(code, modifiers, shell_module.plainTyped(app.*.shell))
        if keys.isNone(shortcut) {
            setMessage(body, state.tr(app, "That key cannot be a shortcut: press another.", "Diese Taste kann kein Kürzel sein: eine andere drücken."), "", "", true)
            return true
        }
        record(app, body, body.*.recording, shortcut)
        return true
    }
    if modifiers & (keys.CONTROL | keys.ALT | keys.SUPER) != 0 { return false }
    const count = shownCount(app, body)
    if count == 0 { return false }
    var place = if body.*.chosen == NONE { NONE } else { placeOf(app, body, body.*.chosen) }
    if code == keys.UP || code == keys.DOWN || code == keys.PAGE_UP || code == keys.PAGE_DOWN || code == keys.HOME || code == keys.END {
        const view_rows = body.*.listHeight / (LIST_ROW * state.themeOf(app).*.scale)
        const page_rows: usize = if view_rows > 0 { @intCast(usize, view_rows) } else { 0 }
        const jump = if page_rows > 1 { page_rows - 1 } else { 1 }
        if place == NONE {
            place = 0
        } else if code == keys.UP {
            place = if place > 0 { place - 1 } else { 0 }
        } else if code == keys.DOWN {
            place = if place + 1 < count { place + 1 } else { count - 1 }
        } else if code == keys.PAGE_UP {
            place = if place > jump { place - jump } else { 0 }
        } else if code == keys.PAGE_DOWN {
            place = if place + jump < count { place + jump } else { count - 1 }
        } else if code == keys.HOME {
            place = 0
        } else {
            place = count - 1
        }
        body.*.chosen = rowAt(app, body, place)
        reveal(app, body, place)
        return true
    }
    if place != NONE && keys.isEnter(code) {
        startRecording(app, body, body.*.chosen)
        return true
    }
    if place != NONE && (code == keys.DELETE || code == keys.BACKSPACE) {
        record(app, body, body.*.chosen, keys.none())
        return true
    }
    return false
}

// ---------------------------------------------------------------------------
// Drawing

fn scaleOf(app: *App) -> i32 { return state.themeOf(app).*.scale }

// A row of a settings page off the top of `rows`: `label` at its left;
// the field's rectangle.
fn settingRow(app: *App, rows: *ui.Rect, label: []const u8) -> ui.Rect {
    const s = scaleOf(app)
    const row = ui.takeTop(rows, dialogs.ROW * s)
    _ = ui.takeTop(rows, dialogs.GAP * s)
    var column = row.width * 55 / 100
    if column > LABEL_MOST * s { column = LABEL_MOST * s }
    kit_module.label(api.kit(app), ui.rect(row.x, row.y, column - 12 * s, row.height), label, kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    return ui.rect(row.x + column, row.y, row.width - column, row.height)
}

fn narrower(area: ui.Rect, width: i32) -> ui.Rect {
    return ui.rect(area.x, area.y, if area.width < width { area.width } else { width }, area.height)
}

// A colour chosen in the colour dialog for the setting being picked.
fn pickedColor(app: *App, color: u32) -> void {
    const level = levelNow(app)
    if level == null { return }
    const body = prefsOf(app, level.?)
    const row = settings.settingAt(body.*.picking)
    if row == null { return }
    numberAt(settings.get(app), row.?.*.offset).* = color
    applied(app, body.*.picking)
}

fn drawSetting(app: *App, level: usize, body: *Prefs, index: usize, rows: *ui.Rect) -> void {
    const row = settings.settingAt(index).?
    const kit = api.kit(app)
    const s = scaleOf(app)
    const prefs = settings.get(app)
    const id = dialogs.idOf(app, level, PART_SETTING + index)
    const name = state.tr(app, row.*.name, row.*.german)
    const kind = row.*.kind
    if kind == settings.SWITCH {
        // (The box where the fields start, its name beside it.)
        const field = settingRow(app, rows, "")
        var on = switchAt(prefs, row.*.offset).*
        if kit_module.checkBox(kit, id, field, name, &on) {
            switchAt(prefs, row.*.offset).* = on
            applied(app, index)
        }
        return
    }
    const field = settingRow(app, rows, name)
    if kind == settings.NUMBER {
        const options = kit_module.sliderOptions(@floatFromInt(f64, row.*.low), @floatFromInt(f64, row.*.high), 1.0, 0)
        var value = @intCast(i32, numberAt(prefs, row.*.offset).*)
        if kit_module.intBox(kit, id, narrower(field, 150 * s), &value, &options) && value >= 0 { numberAt(prefs, row.*.offset).* = @intCast(u32, value) }
        if kit_module.released(kit, id) { applied(app, index) }
    } else if kind == settings.CHOICE {
        body.*.choices[index] = Choice.{ .setting = index, .app = @intFromPtr(app) }
        body.*.chosenWords[index] = @intCast(usize, choiceAt(prefs, row.*.offset).*)
        if kit_module.comboBoxWith(kit, id, narrower(field, 240 * s), @intCast(usize, row.*.wordCount), choiceName, @intFromPtr(&body.*.choices[index]), &body.*.chosenWords[index]) {
            choiceAt(prefs, row.*.offset).* = @intCast(u8, body.*.chosenWords[index])
            applied(app, index)
        }
    } else if kind == settings.COLOR {
        const color = numberAt(prefs, row.*.offset).*
        if kit_module.colorSwatch(kit, id, ui.rect(field.x, field.y, 56 * s, field.height), color, false) {
            body.*.picking = index
            _ = dialogs.pickColor(app, name, color, pickedColor, false)
        }
        const length = color_module.formatHex(color, &body.*.hex, color >> 24 != 255)
        const hex: [*]const u8 = &body.*.hex
        kit_module.label(kit, ui.rect(field.x + 66 * s, field.y, field.width - 66 * s, field.height), hex[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    } else if kind == settings.TEXT {
        // (Shown as the settings have it while it is not being typed.)
        if !kit_module.editing(kit, id) {
            const line = settings.lineText(lineAt(prefs, row.*.offset))
            const format: [*]u8 = &body.*.format
            body.*.formatLength = std.text.append(format, 0, 32, line)
        }
        const result = kit_module.textBox(kit, id, narrower(field, 150 * s), &body.*.format, &body.*.formatLength, 32, "")
        if result == kit_module.TEXT_SUBMITTED {
            const format: [*]const u8 = &body.*.format
            const typed = std.text.trimmed(format[0..body.*.formatLength])
            if row.*.check == null || row.*.check.?(typed) {
                _ = settings.setLine(lineAt(prefs, row.*.offset), typed)
                applied(app, index)
            } else {
                api.say(app, state.tr(app, "That is not a file format's name (\"ora\", \"png\")", "Das ist kein Name eines Dateiformats („ora“, „png“)"), true)
            }
        }
    }
}

fn settingCount(group: u8) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const row = settings.settingAt(index)
        if row != null && row.?.*.group == group && listed(row.?) { count += 1 }
        index += 1
    }
    return count
}

fn drawGroup(app: *App, level: usize, body: *Prefs, area: ui.Rect, group: u8) -> void {
    const s = scaleOf(app)
    const natural = @intCast(i32, settingCount(group)) * (dialogs.ROW + dialogs.GAP) * s
    var rows = dialogs.scrollBegin(app, area, natural)
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const row = settings.settingAt(index)
        if row != null && row.?.*.group == group && listed(row.?) { drawSetting(app, level, body, index, &rows) }
        index += 1
    }
    dialogs.scrollEnd(app)
}

fn drawTablet(app: *App, level: usize, body: *Prefs, area: ui.Rect) -> void {
    const kit = api.kit(app)
    const s = scaleOf(app)
    if !body.*.curveLoaded { loadCurve(body, settings.lineText(&settings.get(app).*.pressureCurve)) }
    const side = 220 * s
    const natural = dialogs.ROW * s + side + 8 * s + 40 * s
    var rows = dialogs.scrollBegin(app, area, natural)
    kit_module.label(kit, ui.takeTop(&rows, dialogs.ROW * s), state.tr(app, "Pressure curve: how hard the pen is pressed, and what a brush makes of it", "Druckkurve: wie fest der Stift drückt und was ein Pinsel daraus macht"), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    const box = ui.takeTop(&rows, side)
    const editor = ui.rect(box.x, box.y, if box.width < side + 40 * s { box.width } else { side + 40 * s }, side)
    const id = dialogs.idOf(app, level, PART_CURVE)
    _ = kit_module.curveEditor(kit, id, editor, &body.*.xs, &body.*.ys, &body.*.count, CURVE)
    if kit_module.released(kit, id) { saveCurve(app, body) }
    _ = ui.takeTop(&rows, 8 * s)
    kit_module.label(kit, ui.takeTop(&rows, 20 * s), state.tr(app, "Drag a point; a press on the curve adds one, dragged out of the box it goes.", "Punkt ziehen; ein Druck auf die Kurve fügt einen hinzu, aus dem Feld gezogen verschwindet er."), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    kit_module.label(kit, ui.takeTop(&rows, 20 * s), state.tr(app, "Across: the pen's pressure. Up: what the brush gets.", "Waagrecht: Druck des Stifts. Senkrecht: was der Pinsel bekommt."), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
}

fn drawLanguage(app: *App, level: usize, area: ui.Rect) -> void {
    const kit = api.kit(app)
    const s = scaleOf(app)
    const index = settingNamed("language")
    const prefs = settings.get(app)
    const natural = 3 * (dialogs.ROW + dialogs.GAP) * s + 30 * s
    var rows = dialogs.scrollBegin(app, area, natural)
    var number: usize = 0
    while number < 3 {
        const line = ui.takeTop(&rows, dialogs.ROW * s)
        _ = ui.takeTop(&rows, dialogs.GAP * s)
        if kit_module.radio(kit, dialogs.idOf(app, level, PART_LANGUAGE + number), narrower(line, 320 * s), wordName(app, "language", number), @intCast(usize, prefs.*.language) == number) {
            prefs.*.language = @intCast(u8, number)
            applied(app, index)
        }
        number += 1
    }
    _ = ui.takeTop(&rows, 6 * s)
    kit_module.label(kit, ui.takeTop(&rows, 20 * s), state.tr(app, "Menus and dialogs change at once; “Like the system” follows LANG.", "Menüs und Dialoge wechseln sofort; „Wie das System“ folgt LANG."), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    dialogs.scrollEnd(app)
}

fn drawShortcuts(app: *App, level: usize, body: *Prefs, area: ui.Rect) -> void {
    const kit = api.kit(app)
    const s = scaleOf(app)
    const theme = state.themeOf(app)
    var rest = area
    const top = ui.takeTop(&rest, dialogs.ROW * s)
    _ = kit_module.textBox(kit, dialogs.idOf(app, level, PART_FILTER), narrower(top, 260 * s), &body.*.filter, &body.*.filterLength, FILTER, state.tr(app, "Filter…", "Suchen …"))
    _ = ui.takeTop(&rest, 4 * s)
    const note = ui.takeTop(&rest, 22 * s)
    if body.*.messageLength > 0 {
        const message: [*]const u8 = &body.*.message
        kit_module.label(kit, note, message[0..body.*.messageLength], if body.*.messageDanger { kit_module.TEXT_DANGER } else { kit_module.TEXT_ACCENT }, kit_module.ALIGN_LEFT)
    } else {
        kit_module.label(kit, note, state.tr(app, "Click an entry, then press its new keys.", "Einen Eintrag anklicken, dann die neuen Tasten drücken."), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    }
    _ = ui.takeTop(&rest, 4 * s)
    kit_module.hline(state.uiOf(app).*.canvas, rest.x, rest.y, rest.width, theme.*.divider)
    _ = ui.takeTop(&rest, 2 * s)
    body.*.listHeight = rest.height
    const row_height = LIST_ROW * s
    const count = shownCount(app, body)
    const content = @intCast(i32, count) * row_height
    if body.*.scroll > content - rest.height { body.*.scroll = content - rest.height }
    if body.*.scroll < 0 { body.*.scroll = 0 }
    const inner = kit_module.scrollBegin(kit, dialogs.idOf(app, level, PART_LIST), rest, content, &body.*.scroll)
    // Only the rows in view are drawn and named.
    var place = @intCast(usize, body.*.scroll / row_height)
    var row = rowAt(app, body, place)
    const total = actions.count() + tools.count()
    while row != NONE && row < total {
        const area_row = ui.rect(inner.x, inner.y + @intCast(i32, place) * row_height, inner.width, row_height)
        if area_row.y >= ui.bottom(rest) { break }
        if shown(app, body, row) {
            drawShortcutRow(app, body, row, area_row)
            place += 1
        }
        row += 1
    }
    kit_module.scrollEnd(kit)
}

fn drawShortcutRow(app: *App, body: *Prefs, row: usize, area: ui.Rect) -> void {
    const kit = api.kit(app)
    const s = scaleOf(app)
    const waiting = body.*.recording == row
    const clicked = kit_module.listRow(kit, view.idOf(rowBase(), row), area, body.*.chosen == row || waiting, false)
    const now = rowShortcut(app, row)
    const changed = !same(now, rowOwn(row))
    const pad = 8 * s
    const reset_width = 64 * s
    const keys_width = 150 * s
    const right = ui.right(area) - pad - reset_width
    // The reset button first: a click on it is not one on the row.
    var reset = false
    if changed {
        const button = ui.rect(ui.right(area) - reset_width - 2 * s, area.y + 2 * s, reset_width, area.height - 4 * s)
        reset = kit_module.button(kit, view.idOf(resetBase(), row), button, state.tr(app, "Own", "Eigenes"), kit_module.BUTTON_PLAIN)
        kit_module.tooltip(kit, view.idOf(resetBase(), row), button, state.tr(app, "Its own shortcut again", "Wieder sein eigenes Kürzel"))
    }
    const name_width = (right - keys_width - area.x) * 6 / 10
    kit_module.label(kit, ui.rect(area.x + pad, area.y, name_width - pad, area.height), rowName(app, row), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
    kit_module.label(kit, ui.rect(area.x + name_width + pad, area.y, right - keys_width - area.x - name_width - pad, area.height), rowGroup(app, row), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    var text: [32]u8 = undefined
    const bytes: [*]u8 = &text
    var length = keys.format(now, bytes)
    var kind = if changed { kit_module.TEXT_ACCENT } else { kit_module.TEXT_NORMAL }
    if waiting {
        length = std.text.append(bytes, 0, 32, state.tr(app, "Press keys…", "Tasten …"))
        kind = kit_module.TEXT_ACCENT
    } else if length == 0 {
        length = std.text.append(bytes, 0, 32, "—")
        kind = kit_module.TEXT_DIM
    }
    kit_module.label(kit, ui.rect(right - keys_width, area.y, keys_width, area.height), bytes[0..length], kind, kit_module.ALIGN_RIGHT)
    if reset {
        const key = rowKey(body, row)
        _ = shortcuts.reset(app, key)
        body.*.recording = NONE
        body.*.messageLength = 0
        api.redraw(app)
        return
    }
    if clicked != kit_module.ROW_NONE { startRecording(app, body, row) }
}

// Every shortcut its own again (asked first).
fn resetAll(app: *App) -> void {
    shortcuts.resetAll(app)
    const level = levelNow(app)
    if level != null {
        const body = prefsOf(app, level.?)
        body.*.recording = NONE
        body.*.messageLength = 0
    }
    api.redraw(app)
}

// The page's settings back to their defaults.
fn restore(app: *App, body: *Prefs) -> void {
    const page_now = body.*.page
    if page_now == PAGE_SHORTCUTS {
        _ = dialogs.confirm(app, state.tr(app, "Reset Shortcuts", "Kürzel zurücksetzen"), state.tr(app, "Every action and tool gets its own shortcut again.", "Jede Aktion und jedes Werkzeug bekommt wieder sein eigenes Kürzel."), state.tr(app, "Reset", "Zurücksetzen"), state.tr(app, "Cancel", "Abbrechen"), resetAll, null)
        return
    }
    settings.defaults(&body.*.defaults)
    const prefs = settings.get(app)
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const row = settings.settingAt(index).?
        var mine = false
        if page_now == PAGE_LANGUAGE { mine = std.text.same(row.*.key, "language") }
        if page_now == PAGE_TABLET { mine = row.*.group == settings.TABLET }
        const group = groupOf(page_now)
        if group != null && row.*.group == group.? && listed(row) { mine = true }
        if mine {
            const offset = row.*.offset
            if row.*.kind == settings.NUMBER || row.*.kind == settings.COLOR {
                numberAt(prefs, offset).* = numberAt(&body.*.defaults, offset).*
            } else if row.*.kind == settings.SWITCH {
                switchAt(prefs, offset).* = switchAt(&body.*.defaults, offset).*
            } else if row.*.kind == settings.CHOICE {
                choiceAt(prefs, offset).* = choiceAt(&body.*.defaults, offset).*
            } else {
                lineAt(prefs, offset).* = lineAt(&body.*.defaults, offset).*
            }
            applied(app, index)
        }
        index += 1
    }
    body.*.curveLoaded = false
}

fn drawPrefs(app: *App, level: usize, window: ui.Rect) -> void {
    const body = prefsOf(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const theme = state.themeOf(app)
    var content = dialogs.frame(app, window, state.tr(app, "Preferences", "Einstellungen"), WIDTH * s, dialogs.framed(app, CONTENT * s))
    body.*.labels[0] = state.tr(app, "Restore Defaults", "Standardwerte")
    body.*.labels[1] = state.tr(app, "Close", "Schließen")
    const labels: [*][]const u8 = &body.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 1)
    // The pages at the left, a line, the page at the right.
    var rest = content
    const list = ui.takeLeft(&rest, PAGE_LIST * s)
    _ = ui.takeLeft(&rest, 8 * s)
    kit_module.vline(state.uiOf(app).*.canvas, rest.x, rest.y, rest.height, theme.*.divider)
    _ = ui.takeLeft(&rest, 16 * s)
    var page_index: usize = 0
    while page_index < PAGES {
        const line = ui.rect(list.x, list.y + @intCast(i32, page_index) * LIST_ROW * s, list.width, LIST_ROW * s)
        if line.y + line.height > ui.bottom(list) { break }
        const id = dialogs.idOf(app, level, PART_PAGE + page_index)
        if kit_module.listRow(kit, id, line, body.*.page == page_index, false) != kit_module.ROW_NONE && body.*.page != page_index {
            body.*.page = page_index
            body.*.recording = NONE
            body.*.messageLength = 0
            body.*.curveLoaded = false
        }
        kit_module.label(kit, ui.rect(line.x + 10 * s, line.y, line.width - 14 * s, line.height), pageName(app, page_index), if body.*.page == page_index { kit_module.TEXT_NORMAL } else { kit_module.TEXT_DIM }, kit_module.ALIGN_LEFT)
        page_index += 1
    }
    const head = ui.takeTop(&rest, 28 * s)
    kit_module.heading(kit, head, pageName(app, body.*.page))
    _ = ui.takeTop(&rest, 6 * s)
    const group = groupOf(body.*.page)
    if group != null {
        drawGroup(app, level, body, rest, group.?)
    } else if body.*.page == PAGE_TABLET {
        drawTablet(app, level, body, rest)
    } else if body.*.page == PAGE_SHORTCUTS {
        drawShortcuts(app, level, body, rest)
    } else {
        drawLanguage(app, level, rest)
    }
    if clicked != null {
        if clicked.? == 0 { restore(app, body) } else { dialogs.close(app, level, 0) }
    }
}

// ---------------------------------------------------------------------------
// Help: every shortcut, by menu

const List = struct {
    labels: [2][]const u8
    text: [32]u8
}

fn listOf(app: *App, level: usize) -> *List { return unsafe { @ptrCast(*List, dialogs.body(app, level)) } }

// Shows every action and tool that has a shortcut, by menu, with a
// button that opens the preferences at their shortcuts. False when it
// cannot be shown.
pub fn showShortcuts(app: *App) -> bool {
    const hooks = dialogs.Hooks.{ .kind = KIND_KEYS, .draw = drawList, .key = null, .finish = finishList, .tabs = true, .closable = true }
    return dialogs.host(app, hooks, @sizeOf(List)) != null
}

fn finishList(app: *App, level: usize, answer: usize) -> void {
    if answer == 0 { _ = open(app, PAGE_SHORTCUTS) }
}

// The menu a row of the list is under (state.MENUS: the tools).
fn menuOf(row: usize) -> usize {
    if row >= actions.count() { return state.MENUS }
    const action = actions.at(row)
    if action == null { return 0 }
    return @intCast(usize, action.?.*.menu)
}

fn drawList(app: *App, level: usize, window: ui.Rect) -> void {
    const body = listOf(app, level)
    const kit = api.kit(app)
    const s = scaleOf(app)
    const line = 22 * s
    const head = 30 * s
    const total = actions.count() + tools.count()
    // What the list holds: the headings of menus with shortcuts, and
    // the rows that have one.
    var natural: i32 = 0
    var group: usize = 0
    while group <= state.MENUS {
        var any = false
        var row: usize = 0
        while row < total {
            if menuOf(row) == group && !keys.isNone(rowShortcut(app, row)) {
                any = true
                natural += line
            }
            row += 1
        }
        if any { natural += head }
        group += 1
    }
    var content = dialogs.frame(app, window, state.tr(app, "Keyboard Shortcuts", "Tastenkürzel"), 560 * s, dialogs.framed(app, natural))
    body.*.labels[0] = state.tr(app, "Change…", "Ändern …")
    body.*.labels[1] = state.tr(app, "Close", "Schließen")
    const labels: [*][]const u8 = &body.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..2], 1)
    var rows = dialogs.scrollBegin(app, content, natural)
    const view_top = content.y
    const view_bottom = ui.bottom(content)
    var y = rows.y
    group = 0
    while group <= state.MENUS {
        var first = true
        var row: usize = 0
        while row < total {
            const shortcut = rowShortcut(app, row)
            if menuOf(row) == group && !keys.isNone(shortcut) {
                if first {
                    first = false
                    // (Only what is in view is drawn.)
                    if y + head > view_top && y < view_bottom {
                        const title = if group == state.MENUS { state.tr(app, "Tools", "Werkzeuge") } else { menus.title(app, @intCast(u8, group)) }
                        kit_module.heading(kit, ui.rect(rows.x, y + 6 * s, rows.width, head - 6 * s), title)
                    }
                    y += head
                }
                if y + line > view_top && y < view_bottom {
                    kit_module.label(kit, ui.rect(rows.x + 10 * s, y, rows.width - 170 * s, line), rowName(app, row), kit_module.TEXT_NORMAL, kit_module.ALIGN_LEFT)
                    const bytes: [*]u8 = &body.*.text
                    const length = keys.format(shortcut, bytes)
                    kit_module.label(kit, ui.rect(ui.right(rows) - 160 * s, y, 150 * s, line), bytes[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_RIGHT)
                }
                y += line
            }
            row += 1
        }
        group += 1
    }
    dialogs.scrollEnd(app)
    if clicked != null { dialogs.close(app, level, if clicked.? == 0 { 0 } else { dialogs.CANCEL }) }
}
