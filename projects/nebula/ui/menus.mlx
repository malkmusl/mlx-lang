// nebula ui: the menus: the bar along the window's top with the actions
// by their menu (state.Action.menu and .submenu), the lists that open
// from it, and menus that open at the pointer. Placeholder until the
// module is written: there is no bar and nothing opens.
const ui = @import("std.ui")
const state = @import("../app/state.mlx")

pub const App = state.App
pub const Canvas = state.Canvas

// How tall the bar is (0: there is none).
pub fn barHeight(app: *App) -> i32 { return 0 }

// Draws the bar into `area`.
pub fn drawBar(app: *App, canvas: *Canvas, area: ui.Rect) -> void {}

// Draws what is open, over everything drawn before.
pub fn drawOver(app: *App, canvas: *Canvas) -> void {}

// Whether a menu is open (it takes the keys and the next press then).
pub fn isOpen(app: *App) -> bool { return false }

// A key while a menu is open, or one that opens a menu; true: used.
pub fn key(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool { return false }

// Closes whatever is open.
pub fn close(app: *App) -> void {}

// Opens the menu of the actions of `menu` (state.MENU_*) at window place
// (x, y): a context menu.
pub fn openAt(app: *App, menu: u8, x: i32, y: i32) -> void {}
