// nebula ui: the menus: the bar along the window's top with a title for
// each menu of the actions (File, Edit, View, Image, Layer, Select,
// Filter, Tools, Settings, Help: state.MENU_*), the lists that open from
// it and the submenus that open beside them, and lists that open at a
// place in the window: one of the bar's menus (openAt) or entries a part
// of the program makes on the spot (popup: a layer's right click).
//
//     chrome:  app.*.menuBar = ui.takeTop(&free, menus.barHeight(app))
//              menus.claimWheel(app)              before what scrolls is drawn
//              menus.drawBar(app, canvas, app.*.menuBar)
//     loop:    menus.drawOver(app, canvas)       after all but the kit's lists
//              if menus.key(app, code, modifiers, typed) { ...used... }
//              if menus.keyUp(app, code) { ...used... }    a key let go
//     a part:  menus.popup(app, ID_LAYER_MENU, x, y, entries[0..count])
//              const index = menus.chosen(app, ID_LAYER_MENU)   (once)
//
// What a menu holds comes from tables, not from here: the actions
// (actions/registry.mlx: an action's menu, its submenu "New|Neu" in both
// languages, its flags, whether it can run, its shortcut by
// app/shortcuts.mlx) and the entries that are not fixed (state.MenuSource:
// recent files, a group's filters), which follow the actions of the same
// place. The entries of one submenu are one row of their menu, where the
// first of them stands. fill() is that model: the rows of a menu or a
// submenu in a List; everything else (drawing, the pointer, the keys)
// works on Lists. A test that must not depend on what the actions are
// gives its own rows instead (useTestItems) and learns which ran
// (lastTestItem).
//
// A list opens under its title on a click; while one is open, the pointer
// on another title opens that one; a submenu's row opens the submenu
// beside the list (on the left when there is no room on the right) as soon
// as the pointer is on it or it is clicked, and it stays open while the
// pointer heads for it across other rows. A list taller than the window
// scrolls: arrows at its ends (a click moves three rows), the wheel, the
// keys. A press anywhere outside closes what is open and does nothing else
// (a region the size of the window lies under the lists; a title that
// opens nothing is outside too); so does a press of another button.
// Context menus are kept inside the window wherever they are asked for.
// Keys while open: Up and Down (past separators and
// what is disabled), Page Up and Down, Home and End, Left and Right
// (another menu of the bar, into and out of a submenu), Enter and Space
// (run), Escape (one level), a letter (the next entry starting with it);
// a chord with Control is the shortcut's again: the menu closes. F10 opens
// the first menu, and so does Alt tapped alone when the loop tells of its
// release (keyUp).
//
// Not done: a delay before a submenu opens under the pointer and arrows
// that scroll while the pointer rests on them both need time, and the
// loop gives the menus none (it draws a frame only when something
// changes): submenus open at once (the aiming rule keeps them usable), the
// arrows scroll by clicks. app/loop.mlx does not call keyUp yet, so Alt
// alone opens nothing until it does; nor does anything call claimWheel
// before the dockers are drawn, so the wheel over a list that lies over a
// docker scrolls the docker until something does. The loop offers a key
// to the dialog on top before the menus, so a popup opened over a dialog
// is not driven by keys (Escape closes the dialog, and the popup with it).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const controls = @import("std.ui.controls")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const shortcuts = @import("../app/shortcuts.mlx")
const actions = @import("../actions/registry.mlx")
const icons = @import("./icons.mlx")

pub const App = state.App
pub const Canvas = state.Canvas

// What a list holds at most, and the bytes of a row's name and shortcut.
pub const MAX_ROWS: usize = 128
pub const NAME_BYTES: usize = 64
pub const NOTE_BYTES: usize = 32
// What popup() keeps of the entries it is given.
pub const POPUP_ENTRIES: usize = 32
const ACTION_BYTES: usize = 64
// What useTestItems() keeps.
pub const TEST_ITEMS: usize = 160

// A row's flags: a line above it; it cannot be chosen; it shows a check
// mark; it is a submenu's row; it is one that can be checked.
pub const ROW_SEPARATOR_BEFORE: u8 = 1
pub const ROW_DISABLED: u8 = 2
pub const ROW_CHECKED: u8 = 4
pub const ROW_SUBMENU: u8 = 8
pub const ROW_CHECKABLE: u8 = 16

// Where a row comes from: an action (its place in actions.at), a
// MenuSource (actions.sourceAt; `entry` its entry), a submenu's row, a
// test item, a popup's entry.
pub const ORIGIN_ACTION: u8 = 0
pub const ORIGIN_SOURCE: u8 = 1
pub const ORIGIN_SUBMENU: u8 = 2
pub const ORIGIN_TEST: u8 = 3
pub const ORIGIN_POPUP: u8 = 4

// A popup's entry's flags (the same bits as a row's).
pub const ENTRY_SEPARATOR_BEFORE: u8 = 1
pub const ENTRY_DISABLED: u8 = 2
pub const ENTRY_CHECKED: u8 = 4

// No row.
pub const NO_ROW: usize = 18446744073709551615

// Sizes, times the theme's scale: the bar, a title's room left and right
// of its name, a row, a separator's room, a list's inner border, the
// check marks' column, a submenu arrow's column, the room between a name
// and its shortcut and right of the shortcut, the icons, a scroll arrow's
// strip, what is kept free at the window's edges, the narrowest list.
const BAR: i32 = 26
const TITLE_PAD: i32 = 10
const ROW: i32 = 26
const GAP: i32 = 9
const PAD: i32 = 4
const CHECK_COLUMN: i32 = 26
const ARROW_COLUMN: i32 = 24
const NOTE_GAP: i32 = 32
const RIGHT_PAD: i32 = 12
const ICON: i32 = 16
const STRIP: i32 = 18
const MARGIN: i32 = 4
const MIN_WIDTH: i32 = 180
// Rows a wheel step or a click on an arrow moves.
const SCROLL_ROWS: usize = 3

// What is open.
const KIND_NONE: u8 = 0
// A menu of the bar under its title (Left and Right go to the next).
const KIND_BAR: u8 = 1
// A menu of the bar at a place (openAt).
const KIND_AT: u8 = 2
// A popup's entries at a place.
const KIND_POPUP: u8 = 3

// The menus' titles (by state.MENU_*; 0 is none).
const Title = struct {
    english: []const u8
    german: []const u8
}

const TITLES = [11]Title{
    Title.{ .english = "", .german = "" },
    Title.{ .english = "File", .german = "Datei" },
    Title.{ .english = "Edit", .german = "Bearbeiten" },
    Title.{ .english = "View", .german = "Ansicht" },
    Title.{ .english = "Image", .german = "Bild" },
    Title.{ .english = "Layer", .german = "Ebene" },
    Title.{ .english = "Select", .german = "Auswahl" },
    Title.{ .english = "Filter", .german = "Filter" },
    Title.{ .english = "Tools", .german = "Werkzeuge" },
    Title.{ .english = "Settings", .german = "Einstellungen" },
    Title.{ .english = "Help", .german = "Hilfe" },
}

// A row of a list: what it says, its shortcut, how it is shown, where it
// comes from. A name or shortcut too long is cut at a character's start.
pub const Row = struct {
    name: [NAME_BYTES]u8
    nameLength: usize
    note: [NOTE_BYTES]u8
    noteLength: usize
    noteWidth: i32
    flags: u8
    origin: u8
    // The action's, source's, test item's or popup entry's place in its
    // table; a source's entry.
    index: usize
    entry: usize
    // A submenu's row: the submenu's title as the tables write it
    // ("New|Neu").
    submenu: []const u8
    // Its top below the list's first row (separators counted), in pixels.
    top: i32
}

// The rows of a menu or of one of its submenus.
pub const List = struct {
    rows: [MAX_ROWS]Row
    count: usize
    menu: u8
    // "": the menu's own rows; else the submenu's title ("New|Neu").
    submenu: []const u8
    // The language it was filled in.
    german: bool
    // Measured (once a list opens): whether the fonts were there then, the
    // widest name and shortcut, how tall all rows are.
    measuredWithFont: bool
    nameWidth: i32
    noteWidth: i32
    height: i32
    // Some row is a submenu's (the arrows' column is kept).
    submenus: bool
}

// A row the test hook gives instead of the actions: its menu and submenu
// as an action's, the name, the shortcut as text, state.ACTION_* flags
// (separator, checkable), whether it can be chosen and is checked, and a
// number lastTestItem() tells when it runs.
pub const TestItem = struct {
    menu: u8
    submenu: []const u8
    name: []const u8
    shortcut: []const u8
    flags: u8
    enabled: bool
    checked: bool
    number: usize
}

// An entry of a menu made on the spot (popup): its name, a note at the
// right (a shortcut's text, or ""), the action to run when it is chosen
// ("": its owner asks with chosen()), ENTRY_* flags.
pub const Entry = struct {
    name: []const u8
    note: []const u8
    action: []const u8
    flags: u8
}

const Kept = struct {
    name: [NAME_BYTES]u8
    nameLength: usize
    note: [NOTE_BYTES]u8
    noteLength: usize
    action: [ACTION_BYTES]u8
    actionLength: usize
    flags: u8
}

// A list as it is shown: level 0 the menu's (or popup's), level 1 the
// submenu open beside it.
const Level = struct {
    list: List
    // The row keys and the pointer moved to (NO_ROW: none), the first row
    // shown when it scrolls, and that the active row is to be scrolled
    // into view at the next frame.
    active: usize
    first: usize
    reveal: bool
    // As drawn in the last frame: its box, where the rows are shown, the
    // end of the rows shown, whether it scrolls.
    box: ui.Rect
    viewTop: i32
    viewHeight: i32
    shownEnd: usize
    scrolls: bool
    // Level 1: its row in level 0.
    parent: usize
}

const Menus = struct {
    kind: u8
    menu: u8
    // Where openAt or popup asked for it.
    atX: i32
    atY: i32
    // Lists open (0, 1, 2) and the one keys move in.
    depth: usize
    keyLevel: usize
    levels: [2]Level
    // The pointer at the end of the last frame (what moved since).
    pointerX: i32
    pointerY: i32
    // Buttons other than the left one held when it opened (their release
    // and a new press are told apart), the time of the last press seen,
    // and the dialogs open then.
    held: u32
    pressTime: usize
    dialogs: usize
    // Wheel steps taken for the lists before anything else could.
    wheel: i32
    // The bar's titles as laid out last, whether each opens something
    // (asked once a frame), their names' widths, measured in that language
    // with or without the fonts.
    titles: [state.MENUS]ui.Rect
    live: [state.MENUS]bool
    widths: [state.MENUS]i32
    widthsMeasured: bool
    widthsGerman: bool
    widthsWithFont: bool
    // The bar was drawn in this frame.
    barDrawn: bool
    // Alt went down with nothing else: its release opens the first menu.
    altArmed: bool
    // The popup's entries and whose they are; the one chosen, until its
    // owner asks.
    owner: u64
    entryCount: usize
    entries: [POPUP_ENTRIES]Kept
    chosenOwner: u64
    chosenIndex: usize
    chosenWaiting: bool
    // The test hook's rows, and the number of the one run last.
    testing: bool
    testCount: usize
    tests: [TEST_ITEMS]TestItem
    lastTest: usize
    lastTestRun: bool
}

// The menus' state (state.SLOT_MENUS: zeroed at first, nothing open).
fn menusOf(app: *App) -> ?*Menus {
    const memory = state.slot(app, state.SLOT_MENUS, @sizeOf(Menus))
    if memory == null { return null }
    unsafe { return @ptrCast(*Menus, memory.?) }
}

// The same when it was made already (null: nothing was ever open).
fn openedOf(app: *App) -> ?*Menus {
    if !state.hasSlot(app, state.SLOT_MENUS) { return null }
    return menusOf(app)
}

fn baseId() -> u64 { return view.id("nebula.menus") }
fn titleId(menu: usize) -> u64 { return view.idOf(baseId(), menu) }
fn catchId() -> u64 { return view.idOf(baseId(), 20) }
fn levelId(at: usize) -> u64 { return view.idOf(baseId(), 30 + at) }

fn arrowId(at: usize, down: bool) -> u64 {
    const extra: usize = if down { 1 } else { 0 }
    return view.idOf(baseId(), 40 + at * 2 + extra)
}

fn rowId(at: usize, row: usize) -> u64 { return view.idOf(baseId(), 1000 + at * 1000 + row) }

// ---------------------------------------------------------------------------
// Text

// `text` into `into` (`capacity` bytes), cut where a character starts;
// the length kept.
fn copyText(into: [*]u8, capacity: usize, text: []const u8) -> usize {
    var length = if text.length < capacity { text.length } else { capacity }
    // A byte 10xxxxxx continues the character before it: no cut there.
    if length < text.length {
        while length > 0 && (text[length] & 192) == 128 { length -= 1 }
    }
    var index: usize = 0
    while index < length {
        into[index] = text[index]
        index += 1
    }
    return length
}

// The English or German part of a title as the tables write it
// ("New|Neu"; one without '|' is both).
fn part(raw: []const u8, german: bool) -> []const u8 {
    var bar: usize = 0
    while bar < raw.length && raw[bar] != '|' { bar += 1 }
    if bar >= raw.length { return raw }
    return if german { raw[bar + 1..raw.length] } else { raw[0..bar] }
}

fn nameOf(row: *const Row) -> []const u8 {
    const bytes: [*]const u8 = &row.*.name
    return bytes[0..row.*.nameLength]
}

fn noteOf(row: *const Row) -> []const u8 {
    const bytes: [*]const u8 = &row.*.note
    return bytes[0..row.*.noteLength]
}

fn lower(byte: u8) -> u8 {
    return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

fn clamp(value: i32, low: i32, high: i32) -> i32 {
    return if value < low { low } else if value > high { high } else { value }
}

// ---------------------------------------------------------------------------
// The model

fn addRow(list: *List, name: []const u8, flags: u8, origin: u8, index: usize, entry: usize) -> ?*Row {
    if list.*.count >= MAX_ROWS { return null }
    const row = &list.*.rows[list.*.count]
    list.*.count += 1
    const bytes: [*]u8 = &row.*.name
    row.*.nameLength = copyText(bytes, NAME_BYTES - 1, name)
    row.*.noteLength = 0
    row.*.noteWidth = 0
    row.*.flags = flags
    row.*.origin = origin
    row.*.index = index
    row.*.entry = entry
    row.*.submenu = ""
    row.*.top = 0
    return row
}

// The row of submenu `raw` in `list`, made (dim until an entry of it can
// be chosen) where the first of its entries stands, with that one's line
// above it. Null when the list is full.
fn submenuRow(app: *App, list: *List, raw: []const u8, flags: u8) -> ?*Row {
    var index: usize = 0
    while index < list.*.count {
        const row = &list.*.rows[index]
        if row.*.flags & ROW_SUBMENU != 0 && std.text.same(row.*.submenu, raw) { return row }
        index += 1
    }
    const made = addRow(list, part(raw, app.*.german), (flags & ROW_SEPARATOR_BEFORE) | ROW_SUBMENU | ROW_DISABLED, ORIGIN_SUBMENU, 0, 0)
    if made == null { return null }
    made.?.*.submenu = raw
    list.*.submenus = true
    return made
}

// An entry that is in submenu `within` ("": none) put into `list`: a row
// of its own when it belongs to the list's place, else its submenu's row
// in the menu's list (lit up when the entry can be chosen). The row made
// for it (null: it went into its submenu's row, belongs elsewhere, or the
// list is full).
fn place(app: *App, list: *List, within: []const u8, name: []const u8, flags: u8, origin: u8, index: usize, entry: usize) -> ?*Row {
    if std.text.same(within, list.*.submenu) { return addRow(list, name, flags, origin, index, entry) }
    if list.*.submenu.length > 0 { return null }
    const holder = submenuRow(app, list, within, flags)
    if holder != null && flags & ROW_DISABLED == 0 { holder.?.*.flags &= ~ROW_DISABLED }
    return null
}

fn fillActions(app: *App, list: *List, menu: u8) -> void {
    const total = actions.count()
    var index: usize = 0
    while index < total {
        const action = actions.at(index)
        if action != null && action.?.*.menu == menu {
            var flags: u8 = 0
            if action.?.*.flags & state.ACTION_SEPARATOR_BEFORE != 0 { flags |= ROW_SEPARATOR_BEFORE }
            if !api.actionEnabled(app, action.?) { flags |= ROW_DISABLED }
            if action.?.*.flags & state.ACTION_CHECKABLE != 0 {
                flags |= ROW_CHECKABLE
                if action.?.*.checked != null && action.?.*.checked.?(app) { flags |= ROW_CHECKED }
            }
            const row = place(app, list, action.?.*.submenu, state.tr(app, action.?.*.name, action.?.*.german), flags, ORIGIN_ACTION, index, 0)
            if row != null {
                const bytes: [*]u8 = &row.?.*.note
                row.?.*.noteLength = keys.format(shortcuts.ofAction(app, action.?), bytes)
            }
        }
        index += 1
    }
}

fn sourceFlags(app: *App, source: *const state.MenuSource, entry: usize) -> u8 {
    var flags: u8 = 0
    if entry == 0 && source.*.flags & state.ACTION_SEPARATOR_BEFORE != 0 { flags |= ROW_SEPARATOR_BEFORE }
    if source.*.enabled != null && !source.*.enabled.?(app, entry) { flags |= ROW_DISABLED }
    if source.*.checked != null {
        flags |= ROW_CHECKABLE
        if source.*.checked.?(app, entry) { flags |= ROW_CHECKED }
    }
    return flags
}

fn fillSources(app: *App, list: *List, menu: u8) -> void {
    const total = actions.sourceCount()
    var index: usize = 0
    while index < total {
        const source = actions.sourceAt(index)
        if source != null && source.?.*.menu == menu {
            const entries = source.?.*.count(app)
            if list.*.submenu.length == 0 && source.?.*.submenu.length > 0 {
                // All its entries are one row here, its submenu's: shown
                // (dim) even while it has none.
                const holder = submenuRow(app, list, source.?.*.submenu, source.?.*.flags)
                var entry: usize = 0
                while holder != null && entry < entries {
                    if sourceFlags(app, source.?, entry) & ROW_DISABLED == 0 {
                        holder.?.*.flags &= ~ROW_DISABLED
                        break
                    }
                    entry += 1
                }
            } else if std.text.same(source.?.*.submenu, list.*.submenu) {
                var entry: usize = 0
                while entry < entries && list.*.count < MAX_ROWS {
                    _ = addRow(list, source.?.*.name(app, entry), sourceFlags(app, source.?, entry), ORIGIN_SOURCE, index, entry)
                    entry += 1
                }
            }
        }
        index += 1
    }
}

fn fillTests(app: *App, m: *Menus, list: *List, menu: u8) -> void {
    var index: usize = 0
    while index < m.*.testCount {
        const item = &m.*.tests[index]
        if item.*.menu == menu {
            var flags: u8 = 0
            if item.*.flags & state.ACTION_SEPARATOR_BEFORE != 0 { flags |= ROW_SEPARATOR_BEFORE }
            if !item.*.enabled { flags |= ROW_DISABLED }
            if item.*.flags & state.ACTION_CHECKABLE != 0 {
                flags |= ROW_CHECKABLE
                if item.*.checked { flags |= ROW_CHECKED }
            }
            const row = place(app, list, item.*.submenu, item.*.name, flags, ORIGIN_TEST, index, 0)
            if row != null {
                const bytes: [*]u8 = &row.?.*.note
                row.?.*.noteLength = copyText(bytes, NOTE_BYTES, item.*.shortcut)
            }
        }
        index += 1
    }
}

// The model: fills `list` with the rows of menu `menu` (state.MENU_*): with
// `submenu` "" the menu's own rows, in which the entries of one submenu
// are one row (ROW_SUBMENU) where the first of them stands; else the rows
// of that submenu (its title as the tables write it, "New|Neu"). The
// actions come in the order of their tables, the MenuSources' entries
// after the actions of the same place; while test items are set
// (useTestItems) they come instead. Names in the program's language;
// rows past MAX_ROWS are left out.
pub fn fill(app: *App, list: *List, menu: u8, submenu: []const u8) -> void {
    list.*.count = 0
    list.*.menu = menu
    list.*.submenu = submenu
    list.*.german = app.*.german
    list.*.measuredWithFont = false
    list.*.nameWidth = 0
    list.*.noteWidth = 0
    list.*.height = 0
    list.*.submenus = false
    const m = menusOf(app)
    if m != null && m.?.*.testing {
        fillTests(app, m.?, list, menu)
        return
    }
    fillActions(app, list, menu)
    fillSources(app, list, menu)
}

// The popup's entries as rows.
fn fillPopup(app: *App, m: *Menus, list: *List) -> void {
    list.*.count = 0
    list.*.menu = state.MENU_NONE
    list.*.submenu = ""
    list.*.german = app.*.german
    list.*.measuredWithFont = false
    list.*.submenus = false
    var index: usize = 0
    while index < m.*.entryCount {
        const kept = &m.*.entries[index]
        var flags = kept.*.flags & (ROW_SEPARATOR_BEFORE | ROW_DISABLED | ROW_CHECKED)
        if flags & ROW_CHECKED != 0 { flags |= ROW_CHECKABLE }
        const name: [*]const u8 = &kept.*.name
        const row = addRow(list, name[0..kept.*.nameLength], flags, ORIGIN_POPUP, index, 0)
        if row != null {
            const note: [*]const u8 = &kept.*.note
            const bytes: [*]u8 = &row.?.*.note
            row.?.*.noteLength = copyText(bytes, NOTE_BYTES, note[0..kept.*.noteLength])
        }
        index += 1
    }
}

// The widths of the names and shortcuts and where each row is, once a
// list opens (and again when the fonts came only after).
fn measure(app: *App, list: *List) -> void {
    const body = state.bodyOf(app)
    const small = state.smallOf(app)
    const s = app.*.scale
    var name_width: i32 = 0
    var note_width: i32 = 0
    var top: i32 = 0
    var index: usize = 0
    while index < list.*.count {
        const row = &list.*.rows[index]
        if index > 0 && row.*.flags & ROW_SEPARATOR_BEFORE != 0 { top += GAP * s }
        row.*.top = top
        top += ROW * s
        const width = text_module.measure(body, nameOf(row))
        if width > name_width { name_width = width }
        row.*.noteWidth = if row.*.noteLength > 0 { text_module.measure(small, noteOf(row)) } else { 0 }
        if row.*.noteWidth > note_width { note_width = row.*.noteWidth }
        index += 1
    }
    list.*.nameWidth = name_width
    list.*.noteWidth = note_width
    list.*.height = top
    list.*.measuredWithFont = body.*.loaded
}

// How wide a list's box is for its widest row.
fn listWidth(app: *App, list: *const List) -> i32 {
    const s = app.*.scale
    var width = PAD * s * 2 + CHECK_COLUMN * s + list.*.nameWidth
    if list.*.noteWidth > 0 { width += NOTE_GAP * s + list.*.noteWidth }
    width += if list.*.submenus { ARROW_COLUMN * s } else { RIGHT_PAD * s }
    return if width < MIN_WIDTH * s { MIN_WIDTH * s } else { width }
}

// Whether `menu` has anything to show (a title without is dim and opens
// nothing).
pub fn hasEntries(app: *App, menu: u8) -> bool {
    const m = menusOf(app)
    if m != null && m.?.*.testing {
        var index: usize = 0
        while index < m.?.*.testCount {
            if m.?.*.tests[index].menu == menu { return true }
            index += 1
        }
        return false
    }
    const total = actions.count()
    var index: usize = 0
    while index < total {
        const action = actions.at(index)
        if action != null && action.?.*.menu == menu { return true }
        index += 1
    }
    const sources = actions.sourceCount()
    index = 0
    while index < sources {
        const source = actions.sourceAt(index)
        if source != null && source.?.*.menu == menu && (source.?.*.submenu.length > 0 || source.?.*.count(app) > 0) { return true }
        index += 1
    }
    return false
}

// A menu's title in the program's language ("" for no menu).
pub fn title(app: *App, menu: u8) -> []const u8 {
    const index = @intCast(usize, menu)
    if index == 0 || index >= state.MENUS { return "" }
    // (One row of the table, by value: a slice of it would be a copy.)
    const row: Title = TITLES[index]
    return state.tr(app, row.english, row.german)
}

// ---------------------------------------------------------------------------
// Opening and closing

fn resetLevel(level: *Level) -> void {
    level.*.active = NO_ROW
    level.*.first = 0
    level.*.reveal = false
    level.*.box = ui.rect(0, 0, 0, 0)
    level.*.viewTop = 0
    level.*.viewHeight = 0
    level.*.shownEnd = 0
    level.*.scrolls = false
    level.*.parent = NO_ROW
}

fn closeAll(m: *Menus) -> void {
    m.*.kind = KIND_NONE
    m.*.menu = state.MENU_NONE
    m.*.depth = 0
    m.*.keyLevel = 0
    m.*.wheel = 0
}

// Opens a list (a bar menu under its title, one at a place, the popup's),
// nothing in it chosen yet. False when it would be empty.
fn openList(app: *App, m: *Menus, kind: u8, menu: u8, x: i32, y: i32) -> bool {
    const level = &m.*.levels[0]
    if kind == KIND_POPUP {
        fillPopup(app, m, &level.*.list)
    } else {
        fill(app, &level.*.list, menu, "")
    }
    if level.*.list.count == 0 {
        closeAll(m)
        return false
    }
    measure(app, &level.*.list)
    resetLevel(level)
    m.*.kind = kind
    m.*.menu = menu
    m.*.atX = x
    m.*.atY = y
    m.*.depth = 1
    m.*.keyLevel = 0
    m.*.held = app.*.buttons & (state.BUTTONS_RIGHT | state.BUTTONS_MIDDLE)
    m.*.pressTime = app.*.pressTime
    m.*.dialogs = app.*.dialogCount
    m.*.wheel = 0
    m.*.altArmed = false
    state.uiOf(app).*.changed = true
    return true
}

// Opens the submenu of level 0's row `row` beside it (nothing when its
// entries went since the row was made).
fn openSubmenu(app: *App, m: *Menus, row: usize) -> void {
    const parent = &m.*.levels[0].list.rows[row]
    const level = &m.*.levels[1]
    fill(app, &level.*.list, m.*.levels[0].list.menu, parent.*.submenu)
    if level.*.list.count == 0 {
        m.*.depth = 1
        return
    }
    measure(app, &level.*.list)
    resetLevel(level)
    level.*.parent = row
    m.*.depth = 2
    state.uiOf(app).*.changed = true
}

// The first menu of the bar that has entries, opened for the keys.
fn openFirst(app: *App) -> bool {
    const m = menusOf(app)
    if m == null { return false }
    var menu: u8 = 1
    while @intCast(usize, menu) < state.MENUS {
        if hasEntries(app, menu) {
            if !openList(app, m.?, KIND_BAR, menu, 0, 0) { return false }
            api.redraw(app)
            return true
        }
        menu += 1
    }
    return false
}

// The bar's next menu (`forward`) or the one before that has entries.
fn switchMenu(app: *App, m: *Menus, forward: bool) -> void {
    const last = @intCast(u8, state.MENUS - 1)
    var menu = m.*.menu
    var tries: usize = 0
    while tries < state.MENUS {
        if forward {
            menu = if menu >= last { 1 } else { menu + 1 }
        } else {
            menu = if menu <= 1 { last } else { menu - 1 }
        }
        if menu == m.*.menu { return }
        if hasEntries(app, menu) {
            _ = openList(app, m, KIND_BAR, menu, 0, 0)
            return
        }
        tries += 1
    }
}

// Whether a menu is open (it takes the keys and the next press then).
pub fn isOpen(app: *App) -> bool {
    const m = openedOf(app)
    return m != null && m.?.*.kind != KIND_NONE
}

// Closes whatever is open.
pub fn close(app: *App) -> void {
    const m = openedOf(app)
    if m == null || m.?.*.kind == KIND_NONE { return }
    closeAll(m.?)
    api.redraw(app)
}

// Opens the menu of the actions of `menu` (state.MENU_*) at window place
// (x, y): a context menu, kept inside the window (to the left of x and
// above y when there is no room right and below). Nothing for a menu
// without entries.
pub fn openAt(app: *App, menu: u8, x: i32, y: i32) -> void {
    if menu == state.MENU_NONE || @intCast(usize, menu) >= state.MENUS { return }
    const m = menusOf(app)
    if m == null || !hasEntries(app, menu) { return }
    if openList(app, m.?, KIND_AT, menu, x, y) { api.redraw(app) }
}

// Opens a menu made on the spot at window place (x, y), as openAt places
// it: `entries` (at most POPUP_ENTRIES, names cut at NAME_BYTES - 1 bytes,
// notes at NOTE_BYTES) are copied, the caller's memory need not live on.
// `owner` is the caller's id: an entry chosen that has no action is told
// to it by chosen(). An entry whose action key is longer than 64 bytes is
// shown dim (it would name another action cut short). Nothing, and what
// is open stays, for no entries.
pub fn popup(app: *App, owner: u64, x: i32, y: i32, entries: []const Entry) -> void {
    if entries.length == 0 { return }
    const found = menusOf(app)
    if found == null { return }
    const m = found.?
    const count = if entries.length < POPUP_ENTRIES { entries.length } else { POPUP_ENTRIES }
    var index: usize = 0
    while index < count {
        const given = &entries[index]
        const kept = &m.*.entries[index]
        const name: [*]u8 = &kept.*.name
        kept.*.nameLength = copyText(name, NAME_BYTES - 1, given.*.name)
        const note: [*]u8 = &kept.*.note
        kept.*.noteLength = copyText(note, NOTE_BYTES, given.*.note)
        kept.*.flags = given.*.flags
        kept.*.actionLength = 0
        if given.*.action.length > ACTION_BYTES {
            kept.*.flags |= ENTRY_DISABLED
        } else {
            const action: [*]u8 = &kept.*.action
            kept.*.actionLength = copyText(action, ACTION_BYTES, given.*.action)
        }
        index += 1
    }
    m.*.entryCount = count
    m.*.owner = owner
    m.*.chosenWaiting = false
    if openList(app, m, KIND_POPUP, state.MENU_NONE, x, y) { api.redraw(app) }
}

// The index of the entry of `owner`'s popup chosen since it opened, once
// (null: none, or it was told already).
pub fn chosen(app: *App, owner: u64) -> ?usize {
    const m = openedOf(app)
    if m == null || !m.?.*.chosenWaiting || m.?.*.chosenOwner != owner { return null }
    m.?.*.chosenWaiting = false
    return m.?.*.chosenIndex
}

// FOR TESTS: rows of the test's own instead of the actions' and the
// MenuSources' (copied, at most TEST_ITEMS; their texts must live on),
// until it is called with none. Closes what is open.
pub fn useTestItems(app: *App, items: []const TestItem) -> void {
    const found = menusOf(app)
    if found == null { return }
    const m = found.?
    closeAll(m)
    const count = if items.length < TEST_ITEMS { items.length } else { TEST_ITEMS }
    var index: usize = 0
    while index < count {
        m.*.tests[index] = items[index]
        index += 1
    }
    m.*.testCount = count
    m.*.testing = count > 0
    m.*.lastTestRun = false
    m.*.widthsMeasured = false
    api.redraw(app)
}

// FOR TESTS: the number of the test item run since the last asking, once
// (null: none ran).
pub fn lastTestItem(app: *App) -> ?usize {
    const m = openedOf(app)
    if m == null || !m.?.*.lastTestRun { return null }
    m.?.*.lastTestRun = false
    return m.?.*.lastTest
}

// ---------------------------------------------------------------------------
// Choosing

fn isEnabled(level: *Level, row: usize) -> bool {
    return row < level.*.list.count && level.*.list.rows[row].flags & ROW_DISABLED == 0
}

fn firstEnabled(level: *Level) -> usize {
    var row: usize = 0
    while row < level.*.list.count {
        if isEnabled(level, row) { return row }
        row += 1
    }
    return NO_ROW
}

fn lastEnabled(level: *Level) -> usize {
    var row = level.*.list.count
    while row > 0 {
        row -= 1
        if isEnabled(level, row) { return row }
    }
    return NO_ROW
}

// The active row moved to the next row that can be chosen up (`down`
// false) or down, round the ends.
fn step(level: *Level, down: bool) -> void {
    const count = level.*.list.count
    if count == 0 { return }
    var row = level.*.active
    var tries: usize = 0
    while tries < count {
        if down {
            row = if row == NO_ROW || row + 1 >= count { 0 } else { row + 1 }
        } else {
            row = if row == NO_ROW || row == 0 { count - 1 } else { row - 1 }
        }
        if isEnabled(level, row) {
            level.*.active = row
            level.*.reveal = true
            return
        }
        tries += 1
    }
}

// The active row moved by a page (the rows shown), to the nearest one that
// can be chosen there.
fn page(level: *Level, down: bool) -> void {
    const count = level.*.list.count
    if count == 0 { return }
    const shown = if level.*.shownEnd > level.*.first + 1 { level.*.shownEnd - level.*.first - 1 } else { 1 }
    var row = level.*.active
    if row == NO_ROW { row = if down { 0 } else { count - 1 } }
    if down {
        row = if row + shown >= count { count - 1 } else { row + shown }
        while row > 0 && !isEnabled(level, row) { row -= 1 }
    } else {
        row = if row < shown { 0 } else { row - shown }
        while row + 1 < count && !isEnabled(level, row) { row += 1 }
    }
    if isEnabled(level, row) {
        level.*.active = row
        level.*.reveal = true
    }
}

// The next row after the active one (round the end) whose name starts
// with what was typed.
fn jump(level: *Level, typed: []const u8) -> void {
    const count = level.*.list.count
    var row = level.*.active
    var tries: usize = 0
    while tries < count {
        row = if row == NO_ROW || row + 1 >= count { 0 } else { row + 1 }
        if isEnabled(level, row) {
            const name = nameOf(&level.*.list.rows[row])
            var same = name.length >= typed.length
            var index: usize = 0
            while same && index < typed.length {
                if lower(name[index]) != lower(typed[index]) { same = false }
                index += 1
            }
            if same {
                level.*.active = row
                level.*.reveal = true
                return
            }
        }
        tries += 1
    }
}

// Runs a row that is no submenu's: the menu closes, then what the row
// stands for runs, then the window is drawn again.
fn runRow(app: *App, m: *Menus, at: usize, index: usize) -> void {
    const row = &m.*.levels[at].list.rows[index]
    const origin = row.*.origin
    const place_index = row.*.index
    const entry = row.*.entry
    // (What closing forgets is taken first.)
    var key: [ACTION_BYTES]u8 = undefined
    var key_length: usize = 0
    if origin == ORIGIN_POPUP && place_index < m.*.entryCount {
        const kept = &m.*.entries[place_index]
        const action: [*]const u8 = &kept.*.action
        const bytes: [*]u8 = &key
        key_length = copyText(bytes, ACTION_BYTES, action[0..kept.*.actionLength])
    }
    const owner = m.*.owner
    closeAll(m)
    if origin == ORIGIN_ACTION {
        const action = actions.at(place_index)
        if action != null && api.actionEnabled(app, action.?) { action.?.*.run(app) }
    } else if origin == ORIGIN_SOURCE {
        const source = actions.sourceAt(place_index)
        if source != null && entry < source.?.*.count(app) && (source.?.*.enabled == null || source.?.*.enabled.?(app, entry)) { source.?.*.run(app, entry) }
    } else if origin == ORIGIN_TEST {
        if place_index < m.*.testCount {
            m.*.lastTest = m.*.tests[place_index].number
            m.*.lastTestRun = true
        }
    } else if origin == ORIGIN_POPUP {
        if key_length > 0 {
            const bytes: [*]const u8 = &key
            _ = api.run(app, bytes[0..key_length])
        } else {
            m.*.chosenOwner = owner
            m.*.chosenIndex = place_index
            m.*.chosenWaiting = true
        }
    }
    api.redraw(app)
}

// Row `index` of level `at` chosen (clicked, Enter): a submenu's row opens
// its submenu (`keyboard`: its first entry made the active one), another
// runs. Nothing for one that cannot be chosen.
fn activate(app: *App, m: *Menus, at: usize, index: usize, keyboard: bool) -> void {
    const level = &m.*.levels[at]
    if !isEnabled(level, index) { return }
    if level.*.list.rows[index].flags & ROW_SUBMENU != 0 {
        if at != 0 { return }
        level.*.active = index
        if m.*.depth != 2 || m.*.levels[1].parent != index { openSubmenu(app, m, index) }
        state.uiOf(app).*.changed = true
        if m.*.depth != 2 { return }
        m.*.keyLevel = 1
        if keyboard {
            m.*.levels[1].active = firstEnabled(&m.*.levels[1])
            m.*.levels[1].reveal = true
        }
        return
    }
    runRow(app, m, at, index)
}

// ---------------------------------------------------------------------------
// Keys

// A key while a menu is open, or one that opens a menu; true: used. While
// nothing is open only F10 is used (it opens the first menu); Alt alone
// going down is noted for keyUp.
pub fn key(app: *App, code: u32, modifiers: u32, typed: []const u8) -> bool {
    if !isOpen(app) {
        if code == keys.F10 && modifiers == 0 { return openFirst(app) }
        if code == keys.LEFT_ALT || code == keys.RIGHT_ALT {
            if modifiers & ~keys.ALT == 0 {
                const m = menusOf(app)
                if m != null { m.?.*.altArmed = true }
            }
            return false
        }
        const m = openedOf(app)
        if m != null { m.?.*.altArmed = false }
        return false
    }
    const m = menusOf(app).?
    m.*.altArmed = false
    if code == keys.LEFT_ALT || code == keys.RIGHT_ALT {
        closeAll(m)
        api.redraw(app)
        return true
    }
    if keys.isModifier(code) { return true }
    if modifiers & (keys.CONTROL | keys.SUPER) != 0 {
        // A shortcut: the menu goes, the shortcut does what it does.
        closeAll(m)
        api.redraw(app)
        return false
    }
    var at = m.*.keyLevel
    if at >= m.*.depth { at = 0 }
    const level = &m.*.levels[at]
    if code == keys.ESCAPE {
        if m.*.depth == 2 {
            m.*.depth = 1
            m.*.keyLevel = 0
        } else {
            closeAll(m)
        }
    } else if code == keys.F10 {
        closeAll(m)
    } else if code == keys.UP {
        step(level, false)
    } else if code == keys.DOWN {
        step(level, true)
    } else if code == keys.HOME {
        level.*.active = firstEnabled(level)
        level.*.reveal = true
    } else if code == keys.END {
        level.*.active = lastEnabled(level)
        level.*.reveal = true
    } else if code == keys.PAGE_UP {
        page(level, false)
    } else if code == keys.PAGE_DOWN {
        page(level, true)
    } else if code == keys.LEFT {
        if at == 1 {
            m.*.depth = 1
            m.*.keyLevel = 0
        } else if m.*.kind == KIND_BAR {
            switchMenu(app, m, false)
        }
    } else if code == keys.RIGHT {
        if at == 0 && isEnabled(level, level.*.active) && level.*.list.rows[level.*.active].flags & ROW_SUBMENU != 0 {
            activate(app, m, 0, level.*.active, true)
        } else if m.*.kind == KIND_BAR {
            switchMenu(app, m, true)
        }
    } else if keys.isEnter(code) || code == keys.SPACE {
        if level.*.active != NO_ROW { activate(app, m, at, level.*.active, true) }
    } else if typed.length > 0 && typed[0] >= 32 && typed[0] != 127 {
        jump(level, typed)
    }
    api.redraw(app)
    return true
}

// A key let go: Alt, when it went down alone and nothing came between,
// opens the first menu. True: used. (For the window's loop to call on
// releases.)
pub fn keyUp(app: *App, code: u32) -> bool {
    const m = openedOf(app)
    if m == null || !m.?.*.altArmed { return false }
    m.?.*.altArmed = false
    if code != keys.LEFT_ALT && code != keys.RIGHT_ALT { return false }
    if m.?.*.kind != KIND_NONE { return false }
    return openFirst(app)
}

// ---------------------------------------------------------------------------
// The bar

// How tall the bar is: one row.
pub fn barHeight(app: *App) -> i32 { return state.px(app, BAR) }

fn measureTitles(app: *App, m: *Menus) -> void {
    const font = state.bodyOf(app)
    if m.*.widthsMeasured && m.*.widthsGerman == app.*.german && m.*.widthsWithFont == font.*.loaded { return }
    var menu: usize = 1
    while menu < state.MENUS {
        m.*.widths[menu] = text_module.measure(font, title(app, @intCast(u8, menu)))
        menu += 1
    }
    m.*.widthsMeasured = true
    m.*.widthsGerman = app.*.german
    m.*.widthsWithFont = font.*.loaded
}

// Where each title is in a bar in `area` (one with no room left at the
// right is not shown: its list opens at the bar's end), and whether its
// menu has entries now.
fn layOutTitles(app: *App, m: *Menus, area: ui.Rect) -> void {
    measureTitles(app, m)
    const s = app.*.scale
    var x = area.x + 4 * s
    var menu: usize = 1
    while menu < state.MENUS {
        m.*.live[menu] = hasEntries(app, @intCast(u8, menu))
        const width = m.*.widths[menu] + TITLE_PAD * s * 2
        if x + width <= ui.right(area) {
            m.*.titles[menu] = ui.rect(x, area.y, width, area.height)
        } else {
            m.*.titles[menu] = ui.rect(ui.right(area), area.y, 0, area.height)
        }
        x += width
        menu += 1
    }
}

// The pointer moved since the last frame.
fn pointerMoved(app: *App, m: *Menus) -> bool {
    const widgets = state.uiOf(app)
    return widgets.*.pointerX != m.*.pointerX || widgets.*.pointerY != m.*.pointerY
}

// A click on a title opens its menu (closes it when it is the one open);
// while a menu of the bar is open, the pointer coming onto another title
// opens that one.
fn titleInput(app: *App, m: *Menus) -> void {
    const widgets = state.uiOf(app)
    const moved = pointerMoved(app, m)
    var menu: usize = 1
    while menu < state.MENUS {
        const id = titleId(menu)
        const number = @intCast(u8, menu)
        if view.takeClick(widgets, id) {
            if m.*.kind == KIND_BAR && m.*.menu == number {
                closeAll(m)
            } else if m.*.live[menu] {
                _ = openList(app, m, KIND_BAR, number, 0, 0)
            }
        } else if moved && m.*.kind == KIND_BAR && m.*.menu != number && view.isHover(widgets, id) && m.*.live[menu] {
            _ = openList(app, m, KIND_BAR, number, 0, 0)
        }
        menu += 1
    }
}

// While a list is open the wheel is the lists': the steps not taken yet
// are kept for them, so that what lies under a list and takes the wheel
// by where the pointer is (a docker's scrolled part) does not scroll. For
// the frame to call before anything that scrolls is drawn (drawBar does it
// too, for what comes after the bar).
pub fn claimWheel(app: *App) -> void {
    const m = openedOf(app)
    if m == null || m.?.*.kind == KIND_NONE { return }
    const widgets = state.uiOf(app)
    m.?.*.wheel +|= widgets.*.wheel
    widgets.*.wheel = 0
}

// Draws the bar into `area`: the menus' titles, lit when their menu is
// open or the pointer is on them; a title whose menu has no entries is dim
// (and still there: the bar does not change with what is in the menus).
pub fn drawBar(app: *App, canvas: *Canvas, area: ui.Rect) -> void {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const s = app.*.scale
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, theme.*.glass)
    canvas_module.fillRect(canvas, area.x, ui.bottom(area) - s, area.width, s, theme.*.divider)
    const found = menusOf(app)
    if found == null { return }
    const m = found.?
    m.*.barDrawn = true
    claimWheel(app)
    layOutTitles(app, m, area)
    // (A dialog lies over the bar: its titles take nothing then.)
    const active = app.*.dialogCount == 0
    if active { titleInput(app, m) }
    const font = state.bodyOf(app)
    var menu: usize = 1
    while menu < state.MENUS {
        const place_area = m.*.titles[menu]
        if place_area.width > 0 {
            const id = titleId(menu)
            if active { view.region(widgets, id, place_area) }
            const number = @intCast(u8, menu)
            const entries = m.*.live[menu]
            const lit = ui.rect(place_area.x, place_area.y + 3 * s, place_area.width, place_area.height - 6 * s - s)
            if m.*.kind == KIND_BAR && m.*.menu == number {
                canvas_module.fillRoundedRect(canvas, lit.x, lit.y, lit.width, lit.height, theme.*.smallRadius, theme.*.menuChosen)
            } else if active && entries && view.isHover(widgets, id) {
                // (One that opens nothing does not light up.)
                canvas_module.fillRoundedRect(canvas, lit.x, lit.y, lit.width, lit.height, theme.*.smallRadius, theme.*.hover)
            }
            const color = if entries { theme.*.text } else { theme.*.disabled }
            text_module.drawText(canvas, font, title(app, number), place_area.x + TITLE_PAD * s, controls.textTop(font, place_area.y, place_area.height - s), color, 0)
        }
        menu += 1
    }
}

// ---------------------------------------------------------------------------
// The lists

// A list's frame: its shadow, its surface (opaque: nothing of the desktop
// shows through the window there), its outline.
fn frameBox(app: *App, canvas: *Canvas, box: ui.Rect) -> void {
    const theme = state.themeOf(app)
    const s = app.*.scale
    const radius = theme.*.smallRadius + 2 * s
    canvas_module.fillRoundedRect(canvas, box.x + 2 * s, box.y + 4 * s, box.width, box.height, radius, theme.*.shadow)
    canvas_module.fillRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, canvas_module.over(theme.*.panel | 0xFF000000, theme.*.popup, 255))
    canvas_module.strokeRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, s, theme.*.popupBorder)
}

// How tall a list's box is with `room` for it: as its rows, or less (it
// scrolls then: the arrows' strips, and rows between them a whole number
// of rows tall, so that the last one ends at the lower arrow).
fn fitHeight(app: *App, list: *const List, room: i32) -> i32 {
    const s = app.*.scale
    const whole = list.*.height + PAD * s * 2
    if whole <= room { return whole }
    const view_height = room - PAD * s * 2 - STRIP * s * 2
    const rows = if view_height > ROW * s { view_height / (ROW * s) } else { 1 }
    return rows * ROW * s + PAD * s * 2 + STRIP * s * 2
}

// Level 0's box: under its title, or at the place asked, inside the
// window; as tall as its rows or as there is room (then it scrolls).
fn placeFirst(app: *App, m: *Menus) -> ui.Rect {
    const level = &m.*.levels[0]
    const window = app.*.window
    const s = app.*.scale
    const margin = MARGIN * s
    var width = listWidth(app, &level.*.list)
    if width > window.width - margin * 2 { width = window.width - margin * 2 }
    var height: i32 = 0
    var x: i32 = 0
    var y: i32 = 0
    if m.*.kind == KIND_BAR {
        const anchor = m.*.titles[@intCast(usize, m.*.menu)]
        x = anchor.x
        y = ui.bottom(anchor)
        height = fitHeight(app, &level.*.list, ui.bottom(window) - margin - y)
    } else {
        height = fitHeight(app, &level.*.list, window.height - margin * 2)
        // The place, taken into the window first (from far outside it the
        // rules below would leave the list outside, or overflow). Without
        // room right of it, left of it; without room below it, above it;
        // without room there either, as far in as it takes.
        const at_x = clamp(m.*.atX, window.x, ui.right(window))
        const at_y = clamp(m.*.atY, window.y, ui.bottom(window))
        x = at_x
        y = at_y
        if x + width > ui.right(window) - margin {
            x = if at_x - width >= window.x + margin { at_x - width } else { ui.right(window) - margin - width }
        }
        if y + height > ui.bottom(window) - margin {
            y = if at_y - height >= window.y + margin { at_y - height } else { ui.bottom(window) - margin - height }
        }
        // (A place within the margin: the margin kept, as at the right.)
        if y + height > ui.bottom(window) - margin { y = ui.bottom(window) - margin - height }
        if y < window.y + margin { y = window.y + margin }
    }
    if x + width > ui.right(window) - margin { x = ui.right(window) - margin - width }
    if x < window.x + margin { x = window.x + margin }
    return ui.rect(x, y, width, height)
}

// Level 1's box: beside level 0's box (`outer`) at its row `parent`, on the
// right or, without room there, on the left; inside the window.
fn placeSecond(app: *App, m: *Menus, outer: ui.Rect, parent: ui.Rect) -> ui.Rect {
    const level = &m.*.levels[1]
    const window = app.*.window
    const s = app.*.scale
    const margin = MARGIN * s
    var width = listWidth(app, &level.*.list)
    if width > window.width - margin * 2 { width = window.width - margin * 2 }
    const height = fitHeight(app, &level.*.list, window.height - margin * 2)
    var x = ui.right(outer) - s
    if x + width > ui.right(window) - margin { x = outer.x - width + s }
    if x < window.x + margin { x = window.x + margin }
    var y = parent.y - PAD * s
    if y + height > ui.bottom(window) - margin { y = ui.bottom(window) - margin - height }
    if y < window.y + margin { y = window.y + margin }
    return ui.rect(x, y, width, height)
}

// The first row from which all the rest fit the rows' part of a level.
fn lastFirst(app: *App, level: *Level) -> usize {
    const list = &level.*.list
    if list.*.count == 0 { return 0 }
    var first = list.*.count - 1
    while first > 0 && list.*.height - list.*.rows[first - 1].top <= level.*.viewHeight { first -= 1 }
    return first
}

// Scrolls so that the active row shows whole.
fn revealActive(app: *App, level: *Level) -> void {
    const active = level.*.active
    if active == NO_ROW || active >= level.*.list.count { return }
    if active < level.*.first {
        level.*.first = active
        return
    }
    const row = ROW * app.*.scale
    while level.*.first < active && level.*.list.rows[active].top + row - level.*.list.rows[level.*.first].top > level.*.viewHeight { level.*.first += 1 }
}

// Where row `index` of level `at` was drawn in the last frame (empty: not
// shown).
fn rowAreaOf(app: *App, m: *Menus, at: usize, index: usize) -> ui.Rect {
    if at >= m.*.depth { return ui.rect(0, 0, 0, 0) }
    const level = &m.*.levels[at]
    if index == NO_ROW || index < level.*.first || index >= level.*.shownEnd { return ui.rect(0, 0, 0, 0) }
    const s = app.*.scale
    const pad = PAD * s
    const top = level.*.viewTop + level.*.list.rows[index].top - level.*.list.rows[level.*.first].top
    return ui.rect(level.*.box.x + pad, top, level.*.box.width - pad * 2, ROW * s)
}

// Whether the pointer, from where it was at the last frame, heads for the
// open submenu: it moved toward the submenu's near side, within the
// triangle from where it was to that side's corners. Crossing other rows
// of the list on the way then leaves the submenu open.
fn aiming(app: *App, m: *Menus) -> bool {
    const widgets = state.uiOf(app)
    const sub = m.*.levels[1].box
    const right = sub.x >= m.*.levels[0].box.x
    const x0 = @intCast(i64, m.*.pointerX)
    const y0 = @intCast(i64, m.*.pointerY)
    const dx = @intCast(i64, widgets.*.pointerX) - x0
    const dy = @intCast(i64, widgets.*.pointerY) - y0
    const edge = @intCast(i64, if right { sub.x } else { ui.right(sub) })
    const reach = if right { edge - x0 } else { x0 - edge }
    const toward = if right { dx } else { -dx }
    if reach <= 0 || toward <= 0 { return false }
    // The motion's slope dy/toward between the slopes to the top and the
    // bottom corner (multiplied out: no division).
    const top = @intCast(i64, sub.y) - y0
    const bottom = @intCast(i64, ui.bottom(sub)) - y0
    return dy * reach >= top * toward && dy * reach <= bottom * toward
}

// The pointer moved onto level `at`'s row `row`: it becomes the active one;
// in level 0 a submenu's row opens its submenu and another row closes an
// open one (unless the pointer is on its way there).
fn hoverRow(app: *App, m: *Menus, at: usize, row: usize) -> void {
    if at == 1 {
        m.*.levels[1].active = row
        m.*.keyLevel = 1
        return
    }
    if m.*.depth == 2 && row != m.*.levels[1].parent && aiming(app, m) { return }
    const level = &m.*.levels[0]
    level.*.active = row
    m.*.keyLevel = 0
    if level.*.list.rows[row].flags & ROW_SUBMENU != 0 {
        if m.*.depth != 2 || m.*.levels[1].parent != row { openSubmenu(app, m, row) }
    } else if m.*.depth == 2 {
        m.*.depth = 1
        state.uiOf(app).*.changed = true
    }
}

// The pointer moved: what it is on now (in the last frame's regions) makes
// the active rows.
fn follow(app: *App, m: *Menus) -> void {
    const hover = state.uiOf(app).*.hover
    var at: usize = 0
    while at < m.*.depth {
        const level = &m.*.levels[at]
        var row = level.*.first
        while row < level.*.shownEnd {
            if hover == rowId(at, row) {
                hoverRow(app, m, at, row)
                return
            }
            row += 1
        }
        if hover == levelId(at) {
            // Between rows, on a line or a row that cannot be chosen: none is
            // the active one (level 0 keeps its submenu's row).
            if at == 1 || m.*.depth == 1 { level.*.active = NO_ROW }
            return
        }
        at += 1
    }
}

// The wheel steps over `box` not taken yet (those the bar kept first),
// at most a thousand either way.
fn wheelIn(app: *App, m: *Menus, box: ui.Rect) -> i32 {
    const widgets = state.uiOf(app)
    var steps = view.takeWheelIn(widgets, box)
    if m.*.wheel != 0 && ui.contains(box, widgets.*.pointerX, widgets.*.pointerY) {
        steps +|= m.*.wheel
        m.*.wheel = 0
    }
    return if steps > 1000 { 1000 } else if steps < -1000 { -1000 } else { steps }
}

fn scrollBy(app: *App, level: *Level, rows: i32) -> void {
    const most = lastFirst(app, level)
    if rows < 0 {
        const back = @intCast(usize, -rows)
        level.*.first = if level.*.first < back { 0 } else { level.*.first - back }
    } else {
        level.*.first += @intCast(usize, rows)
        if level.*.first > most { level.*.first = most }
    }
}

// A scroll arrow's strip: lit under the pointer, its chevron dim when there
// is nothing more that way. True when clicked.
fn arrow(app: *App, canvas: *Canvas, id: u64, area: ui.Rect, down: bool, live: bool) -> bool {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const s = app.*.scale
    if live {
        view.region(widgets, id, area)
        if view.isHover(widgets, id) { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.menuHover) }
    }
    const icon = if down { icons.CHEVRON_DOWN } else { icons.CHEVRON_UP }
    icons.draw(canvas, icon, area.x + (area.width - ICON * s) / 2, area.y + (area.height - ICON * s) / 2, ICON * s, if live { theme.*.text } else { theme.*.disabled })
    return live && view.takeClick(widgets, id)
}

// Draws a row: lit when it is the active one, its check mark, name,
// shortcut and submenu arrow; dim when it cannot be chosen.
fn drawRow(app: *App, canvas: *Canvas, list: *List, row: *Row, area: ui.Rect, lit: bool) -> void {
    const theme = state.themeOf(app)
    const s = app.*.scale
    const enabled = row.*.flags & ROW_DISABLED == 0
    if lit { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.smallRadius, theme.*.menuChosen) }
    const color = if enabled { theme.*.text } else { theme.*.disabled }
    const icon_y = area.y + (area.height - ICON * s) / 2
    if row.*.flags & ROW_CHECKED != 0 { icons.draw(canvas, icons.CHECK, area.x + (CHECK_COLUMN * s - ICON * s) / 2, icon_y, ICON * s, color) }
    const right = ui.right(area) - (if list.*.submenus { ARROW_COLUMN * s } else { RIGHT_PAD * s })
    const x = area.x + CHECK_COLUMN * s
    var limit = right - x
    if row.*.noteLength > 0 {
        const small = state.smallOf(app)
        const note_x = right - row.*.noteWidth
        limit = note_x - NOTE_GAP * s / 2 - x
        text_module.drawText(canvas, small, noteOf(row), note_x, controls.textTop(small, area.y, area.height), if enabled { theme.*.dim } else { theme.*.disabled }, 0)
    }
    const body = state.bodyOf(app)
    if limit > 0 { text_module.drawText(canvas, body, nameOf(row), x, controls.textTop(body, area.y, area.height), color, limit) }
    if row.*.flags & ROW_SUBMENU != 0 { icons.draw(canvas, icons.CHEVRON_RIGHT, ui.right(area) - ARROW_COLUMN * s + (ARROW_COLUMN * s - ICON * s) / 2, icon_y, ICON * s, if enabled { theme.*.dim } else { theme.*.disabled }) }
}

// Lays out and draws level `at` in `box`: which rows show (scrolled as the
// wheel, the arrows and the keys say), each row's region (not for one that
// cannot be chosen: the frame's is under it). The row clicked (NO_ROW:
// none).
fn drawLevel(app: *App, m: *Menus, canvas: *Canvas, at: usize, box: ui.Rect) -> usize {
    const widgets = state.uiOf(app)
    const theme = state.themeOf(app)
    const s = app.*.scale
    const level = &m.*.levels[at]
    const list = &level.*.list
    level.*.box = box
    frameBox(app, canvas, box)
    view.region(widgets, levelId(at), box)
    const pad = PAD * s
    const inner = ui.rect(box.x + pad, box.y + pad, box.width - pad * 2, box.height - pad * 2)
    level.*.scrolls = list.*.height > inner.height
    const strip = if level.*.scrolls { STRIP * s } else { 0 }
    level.*.viewTop = inner.y + strip
    level.*.viewHeight = inner.height - strip * 2
    if !level.*.scrolls {
        level.*.first = 0
    } else {
        if level.*.reveal { revealActive(app, level) }
        const steps = wheelIn(app, m, box)
        if steps != 0 {
            scrollBy(app, level, steps * @intCast(i32, SCROLL_ROWS))
            widgets.*.changed = true
        }
        const most = lastFirst(app, level)
        if level.*.first > most { level.*.first = most }
    }
    level.*.reveal = false
    if list.*.count == 0 {
        level.*.shownEnd = 0
        return NO_ROW
    }
    // The rows that fit whole.
    const base = list.*.rows[level.*.first].top
    var end = level.*.first
    while end < list.*.count && list.*.rows[end].top - base + ROW * s <= level.*.viewHeight { end += 1 }
    level.*.shownEnd = end
    if level.*.scrolls {
        if arrow(app, canvas, arrowId(at, false), ui.rect(inner.x, inner.y, inner.width, strip), false, level.*.first > 0) {
            scrollBy(app, level, 0 - @intCast(i32, SCROLL_ROWS))
        }
        if arrow(app, canvas, arrowId(at, true), ui.rect(inner.x, ui.bottom(inner) - strip, inner.width, strip), true, end < list.*.count) {
            scrollBy(app, level, @intCast(i32, SCROLL_ROWS))
        }
    }
    var clicked = NO_ROW
    var index = level.*.first
    while index < end {
        const row = &list.*.rows[index]
        const y = level.*.viewTop + row.*.top - base
        if index > level.*.first && row.*.flags & ROW_SEPARATOR_BEFORE != 0 {
            canvas_module.fillRect(canvas, inner.x + 6 * s, y - GAP * s + (GAP * s - s) / 2, inner.width - 12 * s, s, theme.*.popupBorder)
        }
        const area = ui.rect(inner.x, y, inner.width, ROW * s)
        const enabled = row.*.flags & ROW_DISABLED == 0
        const id = rowId(at, index)
        if enabled { view.region(widgets, id, area) }
        drawRow(app, canvas, list, row, area, enabled && index == level.*.active)
        if enabled && view.takeClick(widgets, id) { clicked = index }
        index += 1
    }
    return clicked
}

// Draws what is open, over everything drawn before (the dockers, the
// dialogs), and takes the pointer's part in it: clicks on rows and
// titles, the pointer moving over rows, a press outside.
pub fn drawOver(app: *App, canvas: *Canvas) -> void {
    const found = menusOf(app)
    if found == null { return }
    const m = found.?
    const widgets = state.uiOf(app)
    const window = app.*.window
    const bar_shown = m.*.barDrawn
    m.*.barDrawn = false
    // Without a bar a menu of the bar opens at the window's top.
    if !bar_shown { layOutTitles(app, m, ui.rect(window.x, window.y, window.width, 0)) }
    if app.*.buttons != 0 { m.*.altArmed = false }
    // A dialog came or went: what was open belonged to what is under it now,
    // or to what went.
    if m.*.kind != KIND_NONE && app.*.dialogCount != m.*.dialogs { closeAll(m) }
    if m.*.kind != KIND_NONE { drawOpen(app, m, canvas, bar_shown) }
    m.*.wheel = 0
    m.*.pointerX = widgets.*.pointerX
    m.*.pointerY = widgets.*.pointerY
}

fn drawOpen(app: *App, m: *Menus, canvas: *Canvas, bar_shown: bool) -> void {
    const widgets = state.uiOf(app)
    const moved = pointerMoved(app, m)
    // A press of another button than the left one that came after the
    // list opened closes it (and, as a left one, reaches nothing else):
    // one not down at the last frame, or, while the left one is up, a
    // press later than the last one seen (its button's release may have
    // come without a frame, so that it seems still held).
    m.*.held &= app.*.buttons
    const others = app.*.buttons & (state.BUTTONS_RIGHT | state.BUTTONS_MIDDLE)
    var fresh = others & ~m.*.held
    if others != 0 && app.*.buttons & state.BUTTONS_LEFT == 0 && app.*.pressTime != m.*.pressTime { fresh = others }
    m.*.pressTime = app.*.pressTime
    // Under the lists the whole window is theirs; the bar's titles that
    // open something lie over it again so that the pointer can go from
    // one to the next (a press on one that opens nothing is outside).
    view.region(widgets, catchId(), app.*.window)
    if bar_shown && m.*.kind == KIND_BAR && app.*.dialogCount == 0 {
        var menu: usize = 1
        while menu < state.MENUS {
            if m.*.titles[menu].width > 0 && m.*.live[menu] { view.region(widgets, titleId(menu), m.*.titles[menu]) }
            menu += 1
        }
    }
    if fresh != 0 || (view.isPressed(widgets, catchId()) && widgets.*.pointerDown) {
        closeAll(m)
        widgets.*.changed = true
        return
    }
    // The language changed while open; the fonts came after it opened.
    const first = &m.*.levels[0]
    const fonts = state.bodyOf(app).*.loaded
    if first.*.list.german != app.*.german {
        if m.*.kind == KIND_POPUP { fillPopup(app, m, &first.*.list) } else { fill(app, &first.*.list, m.*.menu, "") }
        measure(app, &first.*.list)
        if first.*.active >= first.*.list.count { first.*.active = NO_ROW }
        // (What the last frame showed may not be there any more.)
        first.*.first = 0
        first.*.shownEnd = 0
        m.*.depth = 1
        m.*.keyLevel = 0
    } else if fonts && !first.*.list.measuredWithFont {
        measure(app, &first.*.list)
        if m.*.depth == 2 { measure(app, &m.*.levels[1].list) }
    }
    if first.*.list.count == 0 {
        closeAll(m)
        return
    }
    if moved { follow(app, m) }
    const box = placeFirst(app, m)
    const clicked_first = drawLevel(app, m, canvas, 0, box)
    var clicked_second = NO_ROW
    if m.*.depth == 2 {
        const parent = rowAreaOf(app, m, 0, m.*.levels[1].parent)
        if ui.isEmpty(parent) {
            // Its row scrolled away: the submenu goes with it.
            m.*.depth = 1
            m.*.keyLevel = 0
        } else {
            clicked_second = drawLevel(app, m, canvas, 1, placeSecond(app, m, box, parent))
        }
    }
    if clicked_second != NO_ROW {
        activate(app, m, 1, clicked_second, false)
    } else if clicked_first != NO_ROW {
        activate(app, m, 0, clicked_first, false)
    }
}

// ---------------------------------------------------------------------------
// What is shown (for tests, and for parts that place things by the menus)

// The bar menu whose list is open (state.MENU_NONE: none, or a popup's).
pub fn openMenu(app: *App) -> u8 {
    const m = openedOf(app)
    if m == null || m.?.*.kind == KIND_NONE { return state.MENU_NONE }
    return m.?.*.menu
}

// How many lists are open: 0, 1 (a menu's), 2 (and its submenu).
pub fn depth(app: *App) -> usize {
    const m = openedOf(app)
    if m == null || m.?.*.kind == KIND_NONE { return 0 }
    return m.?.*.depth
}

fn levelOf(app: *App, at: usize) -> ?*Level {
    const m = openedOf(app)
    if m == null || m.?.*.kind == KIND_NONE || at >= m.?.*.depth { return null }
    return &m.?.*.levels[at]
}

// The rows of the open list at `at` (0: the menu's, 1: its submenu's).
pub fn rowCount(app: *App, at: usize) -> usize {
    const level = levelOf(app, at)
    if level == null { return 0 }
    return level.?.*.list.count
}

// A row's name ("" for no row).
pub fn rowName(app: *App, at: usize, index: usize) -> []const u8 {
    const level = levelOf(app, at)
    if level == null || index >= level.?.*.list.count { return "" }
    return nameOf(&level.?.*.list.rows[index])
}

// A row's shortcut as text ("" for none or for no row).
pub fn rowNote(app: *App, at: usize, index: usize) -> []const u8 {
    const level = levelOf(app, at)
    if level == null || index >= level.?.*.list.count { return "" }
    return noteOf(&level.?.*.list.rows[index])
}

// A row's ROW_* flags (0 for no row).
pub fn rowFlags(app: *App, at: usize, index: usize) -> u8 {
    const level = levelOf(app, at)
    if level == null || index >= level.?.*.list.count { return 0 }
    return level.?.*.list.rows[index].flags
}

// Where a row was drawn in the last frame (empty: not shown).
pub fn rowArea(app: *App, at: usize, index: usize) -> ui.Rect {
    const m = openedOf(app)
    if m == null || m.?.*.kind == KIND_NONE { return ui.rect(0, 0, 0, 0) }
    return rowAreaOf(app, m.?, at, index)
}

// The box of the list at `at` in the last frame (empty: none open).
pub fn listArea(app: *App, at: usize) -> ui.Rect {
    const level = levelOf(app, at)
    if level == null { return ui.rect(0, 0, 0, 0) }
    return level.?.*.box
}

// The row of the list at `at` the keys and the pointer moved to (null:
// none).
pub fn activeRow(app: *App, at: usize) -> ?usize {
    var result: ?usize = null
    const level = levelOf(app, at)
    if level != null && level.?.*.active != NO_ROW { result = level.?.*.active }
    return result
}

// The first row the list at `at` shows (it scrolls when not all fit).
pub fn firstShown(app: *App, at: usize) -> usize {
    const level = levelOf(app, at)
    if level == null { return 0 }
    return level.?.*.first
}

// Where a menu's title is in the bar as laid out last (empty width: not
// shown).
pub fn titleArea(app: *App, menu: u8) -> ui.Rect {
    const m = openedOf(app)
    if m == null || menu == state.MENU_NONE || @intCast(usize, menu) >= state.MENUS { return ui.rect(0, 0, 0, 0) }
    return m.?.*.titles[@intCast(usize, menu)]
}
