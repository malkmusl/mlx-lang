// nebula ui: the filter dialog: what an entry of the Filter menu does. A
// filter without numbers is applied at once; one with numbers shows a
// row for each (the filter's Param table, as ui/forms.mlx makes them: a
// number a slider with its name in it, a switch a check box, a choice a
// drop-down list, a colour a swatch that opens the colour dialog, a text
// a field) and, while it is open, a live preview on the canvas: the
// active layer's content filtered (within the selection, mixed by its
// amounts) is shown through node.substitute and made again whenever a
// number changes. OK (or Enter) applies the filter to the whole layer as
// one step of the history named after the filter; Cancel, Escape and the
// close cross take the substitute away and leave no trace; Defaults puts
// the filter's own numbers back.
//
//     filterdialog.choose(app, blur.GAUSSIAN_BLUR)    // the menu's entry
//     filterdialog.repeat(app)                        // Ctrl+F: the last one, its numbers
//     filterdialog.repeatDialog(app)                  // Ctrl+Alt+F: its numbers asked again
//
// The panel stands at the right of the window, over the dockers, and
// only what is around the canvas is veiled: the preview is the point of
// it and must be seen whole (ui/forms.mlx's form is a panel in the middle
// of a veiled window; its rows are made the same way here).
//
// A filter is applied to the part of the layer it can change: around the
// layer's tiles as far as the filter reads around a pixel (registry's
// margin: a blur spills that far out), the image too when the layer's
// default pixel is not transparent, held to the selection's rectangle
// when there is one. That part goes through in blocks of 256 x 256 on the
// grid of the layer's tiles, each read with the margin around it from the
// layer as it was before (a copy that shares its tiles), so blocks join
// without a seam: the result is the one of the layer filtered in one
// piece. A pixel is then mixed with what it was by the selection's
// amount, keeps its alpha on a layer whose alpha is locked, and only the
// tiles that come out different are written (an unchanged tile costs the
// history nothing). The filters that are about the rectangle handed in
// (Auto Contrast, Normalize Range, Pixelize, Halftone, Raindrops, Small
// Tiles, Round Corners, Random Noise, Random Pick, Wave, Propagate Colors
// without a bound: their modules say so) get the layer's pixels in one
// piece instead.
//
// More than JOB_LEAST pixels are filtered over several frames, a part
// each, under a progress dialog of this module's own (one thread: the
// window shows the progress only between parts); its Cancel, Escape and
// close cross put the layer back as it was. The preview is made of the
// part of the layer the canvas shows (and a little more), all of it at
// every change (a filter about the whole rectangle: the whole layer).
//
// The last filter applied and its numbers are kept for repeat(), and the
// numbers of the last RECENT filters that had a form, for the next time
// their form opens.
//
// Not done: the preview is made at full quality at once (no quicker
// first pass of a big view at a reduced size); a filter about the whole
// rectangle is not done over frames.
const std = @import("std")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const icons = @import("./icons.mlx")
const dialogs = @import("./dialogs.mlx")
const kit_module = @import("./kit.mlx")
const viewport = @import("./viewport.mlx")
const filters = @import("../filters/registry.mlx")
const types = @import("../filters/types.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const device_module = @import("../core/device.mlx")
const mask_module = @import("../core/mask.mlx")
const selection = @import("../core/selection.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const color_module = @import("../core/color.mlx")
const scratch = @import("../core/scratch.mlx")

pub const App = state.App
pub const Params = node_module.Params
const Node = node_module.Node
const Image = image_module.Image
const Device = device_module.Device
const Rect = geom.Rect

// The module's slot (the Filter menu's actions are module 6 of
// actions/registry.mlx).
const SLOT: usize = state.SLOT_ACTIONS + 6
// The dialogs' kinds for dialogs.find (theirs are below 16, a form's is
// 16): the filter's numbers, the progress of a long one.
const KIND_FORM: u8 = 32
const KIND_JOB: u8 = 33
// The panel's width, its title row, its padding, its distance from the
// window's edges (times the scale).
const PANEL_WIDTH: i32 = 340
const TITLE_HEIGHT: i32 = 36
const PAD: i32 = 14
const MARGIN: i32 = 8
// A block's side, and the most pixels a filter may read around one.
const BLOCK: i32 = 256
const MOST_MARGIN: i32 = 4096
// Filtering more pixels than this is done over frames; a frame's part.
pub const JOB_LEAST: u64 = 2097152
const FRAME_PIXELS: u64 = 1048576
// The preview covers this much more than the canvas shows.
const VIEW_MORE: i32 = 16
// Rectangles are held this far from the origin: grown and united they
// stay inside an i32.
const FAR: i64 = 1073741824
// Filters whose numbers are kept for their next form.
const RECENT: usize = 16

// A long filter under way (see the header).
const Job = struct {
    active: bool
    image: u64
    node: u32
    params: node_module.Params
    // What is filtered, where the next block starts, how far it is.
    area: geom.Rect
    margin: i32
    x: i32
    y: i32
    done: u64
    total: u64
    // The layer as it was (a Device that shares its tiles).
    source: usize
    name: [64]u8
    nameLength: usize
    labels: [1][]const u8
}

const Store = struct {
    // The form open now: for which image (its number), layer and filter.
    open: bool
    image: u64
    node: u32
    params: node_module.Params
    preview: bool
    // Where the substitute shows something else than the layer.
    shown: geom.Rect
    // The last filter applied, with its numbers.
    last: node_module.Params
    hasLast: bool
    recent: [16]node_module.Params
    recentNext: usize
    // The preview stays off once it was turned off.
    previewOff: bool
    job: Job
}

fn storeOf(app: *App) -> ?*Store {
    const memory = state.slot(app, SLOT, @sizeOf(Store))
    if memory == null { return null }
    return unsafe { @ptrCast(*Store, memory.?) }
}

fn noMemory(app: *App) -> void {
    api.say(app, state.tr(app, "There is not enough memory to filter the layer", "Zum Filtern der Ebene fehlt Speicher"), true)
}

// ---------------------------------------------------------------------------
// Rectangles

fn held64(value: i64) -> i32 {
    if value < -FAR { return @intCast(i32, -FAR) }
    if value > FAR { return @intCast(i32, FAR) }
    return @intCast(i32, value)
}

// `area` grown by `margin`, its edges held to ±FAR.
fn grownHeld(area: Rect, margin: i32) -> Rect {
    if geom.isEmpty(area) { return geom.empty() }
    const m = @intCast(i64, margin)
    const left = held64(@intCast(i64, area.x) - m)
    const top = held64(@intCast(i64, area.y) - m)
    const right = held64(@intCast(i64, area.x) + @intCast(i64, area.width) + m)
    const bottom = held64(@intCast(i64, area.y) + @intCast(i64, area.height) + m)
    if right <= left || bottom <= top { return geom.empty() }
    return geom.rect(left, top, right - left, bottom - top)
}

fn pixelsOf(area: Rect) -> u64 {
    if geom.isEmpty(area) { return 0 }
    return @intCast(u64, area.width) * @intCast(u64, area.height)
}

// Where the block grid (BLOCK apart, through the device's origin) has its
// line at or before `value`.
fn gridLine(value: i32, origin: i32) -> i32 {
    const offset = @intCast(i64, value) - @intCast(i64, origin)
    const steps = if offset >= 0 { offset / @intCast(i64, BLOCK) } else { (offset - @intCast(i64, BLOCK) + 1) / @intCast(i64, BLOCK) }
    return held64(@intCast(i64, origin) + steps * @intCast(i64, BLOCK))
}

// ---------------------------------------------------------------------------
// Filtering a layer

// Whether filter `info` is about the rectangle handed in, not about each
// pixel's surroundings (its module says so; such a filter is given the
// layer in one piece). `margin` is what it reads around a pixel with its
// numbers now.
fn isWhole(info: *const types.Info, margin: i32) -> bool {
    const key = info.*.key
    if std.text.same(key, "propagatecolors") { return margin == 0 }
    return std.text.same(key, "autocontrast") || std.text.same(key, "normalizerange") || std.text.same(key, "pixelize") || std.text.same(key, "halftone") || std.text.same(key, "raindrops") || std.text.same(key, "smalltiles") || std.text.same(key, "roundcorners") || std.text.same(key, "noise") || std.text.same(key, "randompick") || std.text.same(key, "wave")
}

fn marginOf(params: *const Params) -> i32 {
    const reach = filters.margin(params)
    return if reach < 0 { 0 } else if reach > MOST_MARGIN { MOST_MARGIN } else { reach }
}

// The image's selection when there is one.
fn maskOf(image: *Image) -> ?*Device {
    var mask: ?*Device = null
    if image.*.selected { mask = image.*.selection }
    return mask
}

// The part of `node` (it has a device) that filtering can change: see
// the header. (Made by functions that return at once: a rectangle in a
// variable assigned twice, or made by an `if`, is taken from the value
// arena at every call.)
fn workArea(image: *Image, node: *Node, margin: i32, whole: bool) -> Rect {
    const device = node.*.device.?
    return withSelection(image, withImage(image, device, ownArea(device, margin, whole)))
}

fn ownArea(device: *Device, margin: i32, whole: bool) -> Rect {
    if whole { return device_module.exactBounds(device) }
    return grownHeld(device_module.extent(device), margin)
}

fn withImage(image: *Image, device: *Device, area: Rect) -> Rect {
    if device.*.defaultPixel == 0 { return area }
    return geom.unite(area, image_module.bounds(image))
}

fn withSelection(image: *Image, area: Rect) -> Rect {
    if !image.*.selected { return area }
    const inside = geom.intersect(area, image_module.bounds(image))
    if mask_module.reachesEverywhere(image.*.selection) { return inside }
    return geom.intersect(inside, selection.bounds(image.*.selection))
}

// Whether rows `top` .. `top + height` and columns `left` .. `left + width`
// of two buffers (strides `a_stride`, `b_stride`) differ anywhere.
fn differs(a: [*]const u32, a_stride: usize, b: [*]const u32, b_stride: usize, width: usize, height: usize) -> bool {
    var row: usize = 0
    while row < height {
        const one = a + row * a_stride
        const other = b + row * b_stride
        var column: usize = 0
        while column < width {
            if one[column] != other[column] { return true }
            column += 1
        }
        row += 1
    }
    return false
}

// Filters `block` of `target` (a rectangle inside one block of the grid,
// or the whole layer's for a filter about the whole) from `source`, the
// layer as it was, read with `margin` around it; mixed with what it was
// by `mask`'s amounts, keeping alpha when `locked`. Only the target's
// tiles that come out different are written. False without memory.
fn filterBlock(target: *Device, source: *Device, mask: ?*Device, params: *const Params, block: Rect, margin: i32, locked: bool) -> bool {
    if geom.isEmpty(block) { return true }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const wide = geom.grown(block, margin)
    const stride = @intCast(usize, wide.width)
    const width = @intCast(usize, block.width)
    const height = @intCast(usize, block.height)
    const buffer = scratch.words(pool, stride * @intCast(usize, wide.height))
    const before = scratch.words(pool, width * height)
    var amounts: ?[*]u8 = null
    if mask != null { amounts = scratch.bytes(pool, width * height) }
    if buffer == null || before == null || (mask != null && amounts == null) {
        scratch.release(pool, mark)
        return false
    }
    device_module.readRect(source, wide, buffer.?, stride)
    device_module.readRect(source, block, before.?, width)
    if mask != null { mask_module.readBytes(mask.?, block, amounts.?, width) }
    _ = filters.apply(params, buffer.?, stride, @intCast(usize, wide.height), stride)
    const inner = buffer.? + (@intCast(usize, margin) * stride + @intCast(usize, margin))
    var row: usize = 0
    while row < height {
        const line = inner + row * stride
        const old = before.? + row * width
        var column: usize = 0
        while column < width {
            var made = line[column]
            if locked { made = (made & 0x00FFFFFF) | (old[column] & 0xFF000000) }
            if mask != null {
                const amount = @intCast(u32, amounts.?[row * width + column])
                if amount != 255 { made = pixel.mix(old[column], made, amount) }
            }
            // (A transparent pixel is 0 whatever colour the filter left it.)
            if made >> 24 == 0 { made = 0 }
            line[column] = made
            column += 1
        }
        row += 1
    }
    // The target's tiles over the block, each written when it changed.
    var whole = true
    const origin_x = @intCast(i64, target.*.x)
    const origin_y = @intCast(i64, target.*.y)
    const first_tx = (@intCast(i64, block.x) - origin_x) >> 6
    const last_tx = (@intCast(i64, block.x) + @intCast(i64, block.width) - 1 - origin_x) >> 6
    var ty = (@intCast(i64, block.y) - origin_y) >> 6
    const last_ty = (@intCast(i64, block.y) + @intCast(i64, block.height) - 1 - origin_y) >> 6
    while ty <= last_ty {
        var tx = first_tx
        while tx <= last_tx {
            const tile = geom.rect(held64(origin_x + tx * 64), held64(origin_y + ty * 64), 64, 64)
            const part = geom.intersect(tile, block)
            if !geom.isEmpty(part) {
                const dx = @intCast(usize, part.x - block.x)
                const dy = @intCast(usize, part.y - block.y)
                const made = inner + (dy * stride + dx)
                const was = before.? + (dy * width + dx)
                if differs(made, stride, was, width, @intCast(usize, part.width), @intCast(usize, part.height)) {
                    if !device_module.writeRect(target, part, made, stride) { whole = false }
                }
            }
            tx += 1
        }
        ty += 1
    }
    scratch.release(pool, mark)
    return whole
}

// The blocks of `area` on the grid through the target's origin, from
// the one at (x.*, y.*) on (moved on as they are done), until `budget`
// pixels were filtered (0: no end). False without memory; `done.*` grows
// by the pixels filtered.
fn filterBlocks(target: *Device, source: *Device, mask: ?*Device, params: *const Params, area: Rect, margin: i32, locked: bool, x: *i32, y: *i32, done: *u64, budget: u64) -> bool {
    var spent: u64 = 0
    while y.* < geom.bottom(area) {
        while x.* < geom.right(area) {
            if budget != 0 && spent >= budget { return true }
            const block = geom.intersect(geom.rect(x.*, y.*, BLOCK, BLOCK), area)
            if !filterBlock(target, source, mask, params, block, margin, locked) { return false }
            spent += pixelsOf(block)
            done.* += pixelsOf(block)
            x.* = x.* + BLOCK
        }
        x.* = gridLine(area.x, target.*.x)
        y.* = y.* + BLOCK
    }
    return true
}

// `area` of `target` filtered from `source` (see filterBlock): in blocks
// with the margin, or in one piece for a filter about the whole. False
// without memory.
fn filterArea(target: *Device, source: *Device, mask: ?*Device, params: *const Params, area: Rect, margin: i32, whole: bool, locked: bool) -> bool {
    if geom.isEmpty(area) { return true }
    if whole { return filterBlock(target, source, mask, params, area, 0, locked) }
    var x = gridLine(area.x, target.*.x)
    var y = gridLine(area.y, target.*.y)
    var done: u64 = 0
    return filterBlocks(target, source, mask, params, area, margin, locked, &x, &y, &done, 0)
}

fn nameOf(app: *App, info: *const types.Info) -> []const u8 {
    return if app.*.german && info.*.german.length > 0 { info.*.german } else { info.*.name }
}

// The document that shows image number `number` (null: none open does).
fn documentOf(app: *App, number: u64) -> ?*state.Document {
    var index: usize = 0
    while index < app.*.count {
        const doc = app.*.documents[index]
        if doc != null && doc.?.*.image.*.number == number { return doc }
        index += 1
    }
    return null
}

fn nodeOf(app: *App, number: u64, id: u32) -> ?*Node {
    const doc = documentOf(app, number)
    if doc == null { return null }
    const found = image_module.find(doc.?.*.image, id)
    if found == null || found.?.*.device == null { return null }
    return found
}

// Filters `node` of `image` with `params` now, as one step `name`. False
// when it could not be done (the status bar says why; nothing changed).
fn applyNow(app: *App, image: *Image, node: *Node, params: *const Params, area: Rect, margin: i32, whole: bool, name: []const u8) -> bool {
    const source = device_module.copy(node.*.device.?)
    if source == null {
        noMemory(app)
        return false
    }
    _ = ops.beginPixels(image, node)
    const done = filterArea(node.*.device.?, source.?, maskOf(image), params, area, margin, whole, node.*.alphaLocked)
    device_module.destroy(source.?)
    if !done {
        _ = ops.cancelPixels(image, node)
        noMemory(app)
        return false
    }
    _ = ops.endPixels(image, node, name)
    api.canvasChanged(app)
    return true
}

// `params` kept as the numbers its filter's form opens with next time.
fn remember(store: *Store, params: *const Params) -> void {
    var index: usize = 0
    while index < RECENT {
        if store.*.recent[index].id == params.*.id {
            store.*.recent[index] = params.*
            return
        }
        index += 1
    }
    store.*.recent[store.*.recentNext] = params.*
    store.*.recentNext = (store.*.recentNext + 1) % RECENT
}

// The numbers filter `id` had last (its defaults when none were kept).
fn numbersFor(store: *Store, id: u16, into: *Params) -> void {
    var index: usize = 0
    while index < RECENT {
        if store.*.recent[index].id == id {
            into.* = store.*.recent[index]
            return
        }
        index += 1
    }
    filters.defaults(id, into)
}

// Applies `params` (its filter is known) to `node` of `image`: at once,
// or over frames when the part is large. Noted as the last filter.
fn run(app: *App, store: *Store, image: *Image, node: *Node, params: *const Params) -> void {
    const info = filters.find(params.*.id)
    if info == null { return }
    store.*.last = params.*
    store.*.hasLast = true
    const margin = marginOf(params)
    const whole = isWhole(info.?, margin)
    const area = workArea(image, node, margin, whole)
    if geom.isEmpty(area) {
        api.say(app, state.tr(app, "There is nothing on the layer to filter", "Auf der Ebene ist nichts zu filtern"), false)
        return
    }
    const name = nameOf(app, info.?)
    if !whole && pixelsOf(area) > JOB_LEAST && startJob(app, store, image, node, area, margin, name) { return }
    _ = applyNow(app, image, node, &store.*.last, area, margin, whole, name)
}

// ---------------------------------------------------------------------------
// The preview

// The part of the image the canvas shows, VIEW_MORE pixels more around
// it (the image's rectangle before the canvas was laid out).
fn visibleArea(doc: *state.Document) -> Rect {
    const view = &doc.*.view
    const area = view.*.area
    if area.width <= 0 || area.height <= 0 || !(view.*.zoom > 0.0) { return image_module.bounds(doc.*.image) }
    var left: f64 = 0.0
    var top: f64 = 0.0
    var right: f64 = 0.0
    var bottom: f64 = 0.0
    var corner: usize = 0
    while corner < 4 {
        const wx = @floatFromInt(f64, if corner & 1 == 0 { area.x } else { area.x + area.width })
        const wy = @floatFromInt(f64, if corner < 2 { area.y } else { area.y + area.height })
        var x: f64 = 0.0
        var y: f64 = 0.0
        viewport.toImage(view, wx, wy, &x, &y)
        if corner == 0 || x < left { left = x }
        if corner == 0 || x > right { right = x }
        if corner == 0 || y < top { top = y }
        if corner == 0 || y > bottom { bottom = y }
        corner += 1
    }
    const far = @floatFromInt(f64, FAR)
    if !(left > -far) { left = -far }
    if !(top > -far) { top = -far }
    if !(right < far) { right = far }
    if !(bottom < far) { bottom = far }
    return grownHeld(geom.fromBounds(left, top, right, bottom), VIEW_MORE)
}

// What the preview is made of: the part of the layer filtering changes
// that the canvas shows (all of it for a filter about the whole).
fn previewArea(doc: *state.Document, layer: *Node, margin: i32, whole: bool) -> Rect {
    const area = workArea(doc.*.image, layer, margin, whole)
    if whole { return area }
    return geom.intersect(area, visibleArea(doc))
}

// The substitute goes: the layer shows its own pixels again.
fn dropPreview(app: *App, store: *Store) -> void {
    const node = nodeOf(app, store.*.image, store.*.node)
    if node != null && node.?.*.substitute != null {
        device_module.destroy(node.?.*.substitute.?)
        node.?.*.substitute = null
    }
    const doc = documentOf(app, store.*.image)
    if doc != null && !geom.isEmpty(store.*.shown) { image_module.damage(doc.?.*.image, store.*.shown) }
    store.*.shown = geom.empty()
    api.canvasChanged(app)
}

// The preview made again for the numbers of the open form (or taken away
// when it is turned off).
fn refresh(app: *App, store: *Store) -> void {
    if !store.*.open { return }
    const doc = documentOf(app, store.*.image)
    const node = nodeOf(app, store.*.image, store.*.node)
    const info = filters.find(store.*.params.id)
    if doc == null || node == null || info == null || !store.*.preview {
        dropPreview(app, store)
        return
    }
    const image = doc.?.*.image
    const layer = node.?
    if layer.*.substitute == null {
        const made = device_module.copy(layer.*.device.?)
        if made == null {
            noMemory(app)
            return
        }
        layer.*.substitute = made
    } else if !device_module.assign(layer.*.substitute.?, layer.*.device.?) {
        dropPreview(app, store)
        noMemory(app)
        return
    }
    const margin = marginOf(&store.*.params)
    const whole = isWhole(info.?, margin)
    const area = previewArea(doc.?, layer, margin, whole)
    if !filterArea(layer.*.substitute.?, layer.*.device.?, maskOf(image), &store.*.params, area, margin, whole, layer.*.alphaLocked) { noMemory(app) }
    image_module.damage(image, geom.unite(store.*.shown, area))
    store.*.shown = area
    api.canvasChanged(app)
}

fn accepted(app: *App, store: *Store) -> void {
    dropPreview(app, store)
    store.*.open = false
    remember(store, &store.*.params)
    const doc = documentOf(app, store.*.image)
    const node = nodeOf(app, store.*.image, store.*.node)
    if doc == null || node == null { return }
    run(app, store, doc.?.*.image, node.?, &store.*.params)
}

// ---------------------------------------------------------------------------
// The form: the filter's numbers in a panel beside the canvas

// What a choice's drop-down list is named from (the kit asks until its
// frame is over: kept in the form's body).
const Choice = struct {
    param: usize
    german: bool
}

const Form = struct {
    title: [128]u8
    titleLength: usize
    // What Cancel puts back.
    before: node_module.Params
    previewBefore: bool
    chosen: [32]usize
    choices: [32]Choice
    // The colour row whose colour dialog is open.
    picking: usize
    hex: [16]u8
    labels: [3][]const u8
}

fn formOf(app: *App, level: usize) -> *Form { return unsafe { @ptrCast(*Form, dialogs.body(app, level)) } }

// The form of filter `info` for `node` of the document in front, its
// numbers those in store.params; the preview made at once.
fn openForm(app: *App, store: *Store, info: *const types.Info, node: *Node) -> void {
    const doc = api.document(app).?
    const hooks = dialogs.Hooks.{ .kind = KIND_FORM, .draw = drawForm, .key = null, .finish = finishForm, .tabs = false, .closable = true }
    const level = dialogs.host(app, hooks, @sizeOf(Form))
    if level == null { return }
    const form = formOf(app, level.?)
    const name = nameOf(app, info)
    var length: usize = 0
    while length < name.length && length < 128 {
        form.*.title[length] = name[length]
        length += 1
    }
    // (Whole characters only.)
    while length > 0 && length < name.length && name[length] & 192 == 128 { length -= 1 }
    form.*.titleLength = length
    form.*.before = store.*.params
    form.*.picking = NONE_ROW
    store.*.open = true
    store.*.image = doc.*.image.*.number
    store.*.node = node.*.id
    store.*.preview = !store.*.previewOff
    form.*.previewBefore = store.*.preview
    store.*.shown = geom.empty()
    refresh(app, store)
}

const NONE_ROW: usize = 18446744073709551615

fn finishForm(app: *App, level: usize, answer: usize) -> void {
    const store = storeOf(app)
    if store == null || !store.?.*.open { return }
    if answer == 0 {
        accepted(app, store.?)
        return
    }
    const form = formOf(app, level)
    store.?.*.params = form.*.before
    store.?.*.preview = form.*.previewBefore
    dropPreview(app, store.?)
    store.?.*.open = false
}

fn paramName(app: *App, param: *const types.Param) -> []const u8 {
    return if app.*.german && param.*.german.length > 0 { param.*.german } else { param.*.name }
}

fn choicesOf(param: *const types.Param, german: bool) -> []const u8 {
    return if german && param.*.choicesGerman.length > 0 { param.*.choicesGerman } else { param.*.choices }
}

fn choiceCount(text: []const u8) -> usize {
    if text.length == 0 { return 0 }
    var count: usize = 1
    for byte in text {
        if byte == 124 { count += 1 }
    }
    return count
}

// Choice `index` of "A|B|C".
fn choiceAt(text: []const u8, index: usize) -> []const u8 {
    var start: usize = 0
    var at: usize = 0
    var seen: usize = 0
    while at <= text.length {
        if at == text.length || text[at] == 124 {
            if seen == index { return text[start..at] }
            seen += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

fn choiceName(context: usize, index: usize) -> []const u8 {
    const choice: *Choice = unsafe { @ptrFromInt(*Choice, context) }
    const param: *const types.Param = unsafe { @ptrFromInt(*const types.Param, choice.*.param) }
    return choiceAt(choicesOf(param, choice.*.german), index)
}

// A slider's range and steps for a number (as ui/forms.mlx has them:
// decimals by the width of the range, degrees for an angle).
fn numberOptions(param: *const types.Param) -> kit_module.SliderOptions {
    const low = param.*.low
    var high = param.*.high
    if !(high > low) { high = low + 1.0 }
    const span = high - low
    var decimals: usize = 0
    var step: f64 = 1.0
    if param.*.kind == types.FLOAT {
        if span <= 0.1 {
            decimals = 4
            step = 0.0001
        } else if span <= 10.0 {
            decimals = 2
            step = 0.01
        } else if span <= 100.0 {
            decimals = 1
            step = 0.1
        }
    }
    var options = kit_module.sliderOptions(low, high, step, decimals)
    if param.*.kind == types.ANGLE { options.suffix = "°" }
    return options
}

fn colorOfValue(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 4294967295.0 { return 4294967295 }
    return @intFromFloat(u32, value)
}

// A colour chosen (or, live, being chosen) for the form's colour row.
fn pickedColor(app: *App, color: u32) -> void {
    const store = storeOf(app)
    const level = dialogs.find(app, KIND_FORM)
    if store == null || level == null { return }
    const form = formOf(app, level.?)
    if form.*.picking >= node_module.VALUES { return }
    store.?.*.params.values[form.*.picking] = @floatFromInt(f64, color)
    refresh(app, store.?)
    api.redraw(app)
}

// A row with `label` in a column at its left, off the top of `rows`; the
// field's rectangle.
fn labelledRow(app: *App, rows: *ui.Rect, label: []const u8) -> ui.Rect {
    const s = state.themeOf(app).*.scale
    const row = ui.takeTop(rows, dialogs.ROW * s)
    _ = ui.takeTop(rows, dialogs.GAP * s)
    const column = row.width * 2 / 5
    kit_module.label(api.kit(app), ui.rect(row.x, row.y, column - 8 * s, row.height), label, kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    return ui.rect(row.x + column, row.y, row.width - column, row.height)
}

// Row `index` of the form off the top of `rows`; true when its value
// changed.
fn drawRow(app: *App, level: usize, form: *Form, store: *Store, param: *const types.Param, index: usize, rows: *ui.Rect) -> bool {
    const kit = api.kit(app)
    const s = state.themeOf(app).*.scale
    const id = dialogs.idOf(app, level, dialogs.PART_FIELD + index)
    const values = &store.*.params
    const kind = param.*.kind
    if kind == types.INT || kind == types.FLOAT || kind == types.ANGLE || kind == types.BOOL {
        const row = ui.takeTop(rows, dialogs.ROW * s)
        _ = ui.takeTop(rows, dialogs.GAP * s)
        if kind == types.BOOL {
            var on = values.*.values[index] != 0.0
            if !kit_module.checkBox(kit, id, row, paramName(app, param), &on) { return false }
            values.*.values[index] = if on { 1.0 } else { 0.0 }
            return true
        }
        // (The name inside the bar, the number at its right.)
        const options = numberOptions(param)
        var value = values.*.values[index]
        if !kit_module.slider(kit, id, row, paramName(app, param), &value, &options) { return false }
        values.*.values[index] = value
        return true
    }
    const field = labelledRow(app, rows, paramName(app, param))
    if kind == types.CHOICE {
        form.*.choices[index] = Choice.{ .param = @intFromPtr(param), .german = app.*.german }
        const count = choiceCount(choicesOf(param, app.*.german))
        const value = values.*.values[index]
        // (Held to the choices before it becomes a whole number.)
        var chosen: usize = 0
        if count > 0 {
            if value >= @floatFromInt(f64, count) - 0.5 {
                chosen = count - 1
            } else if value > 0.0 {
                chosen = @intFromFloat(usize, value + 0.5)
            }
        }
        form.*.chosen[index] = chosen
        if !kit_module.comboBoxWith(kit, id, field, count, choiceName, @intFromPtr(&form.*.choices[index]), &form.*.chosen[index]) { return false }
        values.*.values[index] = @floatFromInt(f64, form.*.chosen[index])
        return true
    }
    if kind == types.COLOR {
        const color = colorOfValue(values.*.values[index])
        const swatch = ui.rect(field.x, field.y, 56 * s, field.height)
        if kit_module.colorSwatch(kit, id, swatch, color, false) {
            form.*.picking = index
            _ = dialogs.pickColor(app, paramName(app, param), color, pickedColor, true)
        }
        const length = color_module.formatHex(color, &form.*.hex, color >> 24 != 255)
        const hex: [*]const u8 = &form.*.hex
        kit_module.label(kit, ui.rect(ui.right(swatch) + 10 * s, field.y, field.width - 66 * s, field.height), hex[0..length], kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
        return false
    }
    if kind == types.TEXT {
        const result = kit_module.textBox(kit, id, field, &values.*.text, &values.*.textLength, node_module.TEXT, "")
        return result == kit_module.TEXT_EDITED || result == kit_module.TEXT_CANCELLED
    }
    return false
}

// The veil over what is around the canvas (the canvas stays as it is: the
// preview is on it); darker on a dark desktop, as the dialogs' veil.
fn veilAround(app: *App, window: ui.Rect) -> void {
    const canvas = state.uiOf(app).*.canvas
    var light = app.*.lightness
    if light < 0 { light = 0 }
    if light > 1024 { light = 1024 }
    const veil = canvas_module.color(@intCast(u32, 120 - light * 40 / 1024), 0, 0, 0)
    const middle = geom.intersect(app.*.canvasArea, window)
    if geom.isEmpty(middle) {
        canvas_module.fillRect(canvas, window.x, window.y, window.width, window.height, veil)
        return
    }
    canvas_module.fillRect(canvas, window.x, window.y, window.width, middle.y - window.y, veil)
    canvas_module.fillRect(canvas, window.x, geom.bottom(middle), window.width, geom.bottom(window) - geom.bottom(middle), veil)
    canvas_module.fillRect(canvas, window.x, middle.y, middle.x - window.x, middle.height, veil)
    canvas_module.fillRect(canvas, geom.right(middle), middle.y, geom.right(window) - geom.right(middle), middle.height, veil)
}

// A theme colour made opaque (the window must be where the panel is).
fn solid(given: u32) -> u32 {
    if given >> 24 == 255 { return given }
    return canvas_module.over(0xFF000000, given, 255)
}

// The panel `height` tall at the right of the window, under the bars,
// with its shadow, `title` and a close cross that cancels; the content
// rectangle inside its padding.
fn panel(app: *App, level: usize, window: ui.Rect, title: []const u8, height: i32) -> ui.Rect {
    const kit = api.kit(app)
    const theme = state.themeOf(app)
    const canvas = state.uiOf(app).*.canvas
    const s = theme.*.scale
    var top = window.y
    if !geom.isEmpty(app.*.toolBar) {
        top = geom.bottom(app.*.toolBar)
    } else if !geom.isEmpty(app.*.menuBar) {
        top = geom.bottom(app.*.menuBar)
    }
    top += MARGIN * s
    var width = PANEL_WIDTH * s
    if width > window.width - 2 * MARGIN * s { width = window.width - 2 * MARGIN * s }
    var tall = height
    if tall > geom.bottom(window) - MARGIN * s - top { tall = geom.bottom(window) - MARGIN * s - top }
    if width < 0 { width = 0 }
    if tall < 0 { tall = 0 }
    const box = ui.rect(geom.right(window) - MARGIN * s - width, top, width, tall)
    const radius = theme.*.radius
    const shade = canvas_module.color((theme.*.shadow >> 24) / 4, 0, 0, 0)
    var spread: i32 = 4
    while spread > 0 {
        const out = spread * s
        canvas_module.fillRoundedRect(canvas, box.x - out, box.y - out + 3 * s, box.width + 2 * out, box.height + 2 * out, radius + out, shade)
        spread -= 1
    }
    canvas_module.fillRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, solid(theme.*.panel))
    canvas_module.strokeRoundedRect(canvas, box.x, box.y, box.width, box.height, radius, s, theme.*.popupBorder)
    const head = ui.rect(box.x, box.y, box.width, if TITLE_HEIGHT * s < box.height { TITLE_HEIGHT * s } else { box.height })
    kit_module.hline(canvas, box.x + s, ui.bottom(head) - s, box.width - 2 * s, theme.*.divider)
    const side = 24 * s
    const cross = ui.rect(ui.right(head) - side - 6 * s, head.y + (head.height - side) / 2, side, side)
    if kit_module.iconButton(kit, dialogs.idOf(app, level, dialogs.PART_CLOSE), cross, icons.drawFor, @intCast(usize, icons.CLOSE), state.tr(app, "Close", "Schließen")) {
        dialogs.close(app, level, dialogs.CANCEL)
    }
    kit_module.heading(kit, ui.rect(box.x + PAD * s, head.y, head.width - 2 * PAD * s - side, head.height - s), title)
    const inner_top = ui.bottom(head) + (PAD - 2) * s
    var inner_height = ui.bottom(box) - (PAD - 2) * s - inner_top
    if inner_height < 0 { inner_height = 0 }
    var inner_width = box.width - 2 * PAD * s
    if inner_width < 0 { inner_width = 0 }
    return ui.rect(box.x + PAD * s, inner_top, inner_width, inner_height)
}

fn drawForm(app: *App, level: usize, window: ui.Rect) -> void {
    const store = storeOf(app)
    const form = formOf(app, level)
    if store == null || !store.?.*.open {
        dialogs.close(app, level, dialogs.CANCEL)
        return
    }
    const info = filters.find(store.?.*.params.id)
    if info == null {
        dialogs.close(app, level, dialogs.CANCEL)
        return
    }
    const kit = api.kit(app)
    const s = state.themeOf(app).*.scale
    const params = info.?.*.params
    const count = if params.length > node_module.VALUES { node_module.VALUES } else { params.length }
    const natural = @intCast(i32, count) * (dialogs.ROW + dialogs.GAP) * s
    const height = TITLE_HEIGHT * s + (PAD - 2) * s + natural + (dialogs.ROW + PAD) * s + dialogs.BUTTON_HEIGHT * s + PAD * s + (PAD - 2) * s
    veilAround(app, window)
    const title: [*]const u8 = &form.*.title
    var content = panel(app, level, window, title[0..form.*.titleLength], height)
    form.*.labels[0] = state.tr(app, "Defaults", "Standard")
    form.*.labels[1] = "OK"
    form.*.labels[2] = state.tr(app, "Cancel", "Abbrechen")
    const labels: [*][]const u8 = &form.*.labels
    const clicked = dialogs.buttons(app, &content, labels[0..3], 1)
    var changed = false
    // The preview's switch over the buttons.
    const switch_row = ui.takeBottom(&content, dialogs.ROW * s)
    _ = ui.takeBottom(&content, (PAD - dialogs.GAP) * s)
    if kit_module.checkBox(kit, dialogs.idOf(app, level, dialogs.PART_FIELD + node_module.VALUES), switch_row, state.tr(app, "Preview on the canvas", "Vorschau auf der Arbeitsfläche"), &store.?.*.preview) {
        store.?.*.previewOff = !store.?.*.preview
        changed = true
    }
    if clicked != null && clicked.? == 0 {
        var index: usize = 0
        while index < count {
            if params[index].kind != types.TEXT { store.?.*.params.values[index] = params[index].initial }
            index += 1
        }
        changed = true
    }
    var rows = dialogs.scrollBegin(app, content, natural)
    var index: usize = 0
    while index < count {
        if drawRow(app, level, form, store.?, &params[index], index, &rows) { changed = true }
        index += 1
    }
    dialogs.scrollEnd(app)
    if changed { refresh(app, store.?) }
    if clicked != null {
        if clicked.? == 1 {
            dialogs.close(app, level, 0)
        } else if clicked.? == 2 {
            dialogs.close(app, level, dialogs.CANCEL)
        }
    }
}

// ---------------------------------------------------------------------------
// What the menus call

// Filter `id` chosen for the active layer: applied at once when it has
// no numbers, else its form opens with the numbers it had last (see the
// header). Nothing when there is no layer that can be filtered (the
// status bar says why) or no such filter.
pub fn choose(app: *App, id: u16) -> void {
    const store = storeOf(app)
    const info = filters.find(id)
    if store == null || info == null || store.?.*.open || store.?.*.job.active { return }
    const node = api.paintable(app)
    if node == null { return }
    const image = api.image(app).?
    numbersFor(store.?, id, &store.?.*.params)
    if info.?.*.params.length == 0 {
        run(app, store.?, image, node.?, &store.?.*.params)
        return
    }
    openForm(app, store.?, info.?, node.?)
}

// Whether a filter was applied (repeat has something to repeat).
pub fn hasLast(app: *App) -> bool {
    const store = storeOf(app)
    return store != null && store.?.*.hasLast
}

// The last filter applied, with the numbers it had then, on the active
// layer.
pub fn repeat(app: *App) -> void {
    const store = storeOf(app)
    if store == null || !store.?.*.hasLast || store.?.*.open || store.?.*.job.active { return }
    const node = api.paintable(app)
    if node == null { return }
    run(app, store.?, api.image(app).?, node.?, &store.?.*.last)
}

// The last filter's form again, with the numbers it had then.
pub fn repeatDialog(app: *App) -> void {
    const store = storeOf(app)
    if store == null || !store.?.*.hasLast || store.?.*.open || store.?.*.job.active { return }
    const info = filters.find(store.?.*.last.id)
    if info == null { return }
    const node = api.paintable(app)
    if node == null { return }
    store.?.*.params = store.?.*.last
    if info.?.*.params.length == 0 {
        run(app, store.?, api.image(app).?, node.?, &store.?.*.params)
        return
    }
    openForm(app, store.?, info.?, node.?)
}

// Whether a filter's form is open, or a long filter under way.
pub fn busy(app: *App) -> bool {
    const store = storeOf(app)
    return store != null && (store.?.*.open || store.?.*.job.active)
}

// ---------------------------------------------------------------------------
// A long filter, over frames

fn jobOf(app: *App) -> ?*Job {
    const store = storeOf(app)
    if store == null { return null }
    return &store.?.*.job
}

// Starts filtering `area` of `node` with store.last over frames under the
// progress dialog. False when the dialog cannot be shown (nothing
// started: the caller does it at once).
fn startJob(app: *App, store: *Store, image: *Image, node: *Node, area: Rect, margin: i32, name: []const u8) -> bool {
    const job = &store.*.job
    const source = device_module.copy(node.*.device.?)
    if source == null { return false }
    const hooks = dialogs.Hooks.{ .kind = KIND_JOB, .draw = drawJob, .key = null, .finish = finishJob, .tabs = false, .closable = true }
    if dialogs.host(app, hooks, 0) == null {
        device_module.destroy(source.?)
        return false
    }
    job.*.active = true
    job.*.image = image.*.number
    job.*.node = node.*.id
    job.*.params = store.*.last
    job.*.area = area
    job.*.margin = margin
    job.*.x = gridLine(area.x, node.*.device.?.*.x)
    job.*.y = gridLine(area.y, node.*.device.?.*.y)
    job.*.done = 0
    job.*.total = pixelsOf(area)
    job.*.source = @intFromPtr(source.?)
    const bytes: [*]u8 = &job.*.name
    job.*.nameLength = std.text.append(bytes, 0, 64, name)
    _ = ops.beginPixels(image, node)
    return true
}

fn sourceOf(job: *Job) -> *Device { return unsafe { @ptrFromInt(*Device, job.*.source) } }

// A frame's part of the job; true when it is over (all done, or it can
// go no further).
fn work(app: *App, job: *Job) -> bool {
    const doc = documentOf(app, job.*.image)
    const node = nodeOf(app, job.*.image, job.*.node)
    if doc == null || node == null { return true }
    const target = node.?.*.device.?
    const done = filterBlocks(target, sourceOf(job), maskOf(doc.?.*.image), &job.*.params, job.*.area, job.*.margin, node.?.*.alphaLocked, &job.*.x, &job.*.y, &job.*.done, FRAME_PIXELS)
    if !done { noMemory(app) }
    api.canvasChanged(app)
    return !done || job.*.y >= geom.bottom(job.*.area)
}

fn drawJob(app: *App, level: usize, window: ui.Rect) -> void {
    const job = jobOf(app)
    if job == null { return }
    const kit = api.kit(app)
    const s = state.themeOf(app).*.scale
    const natural = dialogs.ROW * s + dialogs.GAP * s + 8 * s
    const name: [*]const u8 = &job.?.*.name
    var content = dialogs.frame(app, window, name[0..job.?.*.nameLength], 420 * s, dialogs.framed(app, natural))
    job.?.*.labels[0] = state.tr(app, "Cancel", "Abbrechen")
    const labels: [*][]const u8 = &job.?.*.labels
    // (Cancel is no answer to wait for: not the primary button.)
    if dialogs.buttons(app, &content, labels[0..1], 1) != null {
        dialogs.close(app, level, dialogs.CANCEL)
        return
    }
    const fraction = if job.?.*.total == 0 { 1.0 } else { @floatFromInt(f64, job.?.*.done) / @floatFromInt(f64, job.?.*.total) }
    var rows = dialogs.scrollBegin(app, content, natural)
    kit_module.label(kit, ui.takeTop(&rows, dialogs.ROW * s), state.tr(app, "The layer is being filtered…", "Die Ebene wird gefiltert …"), kit_module.TEXT_DIM, kit_module.ALIGN_LEFT)
    _ = ui.takeTop(&rows, dialogs.GAP * s)
    kit_module.progress(kit, ui.takeTop(&rows, 8 * s), fraction)
    dialogs.scrollEnd(app)
    // The work goes on in frames that are drawn (not in layout passes).
    if state.uiOf(app).*.canvas.*.width == 0 { return }
    if work(app, job.?) {
        dialogs.close(app, level, 0)
        return
    }
    api.canvasChanged(app)
}

fn finishJob(app: *App, level: usize, answer: usize) -> void {
    const job = jobOf(app)
    if job == null || !job.?.*.active { return }
    job.?.*.active = false
    const doc = documentOf(app, job.?.*.image)
    const node = nodeOf(app, job.?.*.image, job.?.*.node)
    device_module.destroy(sourceOf(job.?))
    if doc == null || node == null { return }
    const name: [*]const u8 = &job.?.*.name
    if answer == 0 && job.?.*.y >= geom.bottom(job.?.*.area) {
        _ = ops.endPixels(doc.?.*.image, node.?, name[0..job.?.*.nameLength])
    } else {
        _ = ops.cancelPixels(doc.?.*.image, node.?)
    }
    api.redraw(app)
}
