// nebula ui: a response curve as numbers: points (x, y) in 0..1 x 0..1,
// x ascending, and the smooth curve through them. ui/kit.mlx's
// curveEditor shows and changes such points; whoever uses the curve (a
// brush's pressure response, a filter's tone curve) reads it here, so that
// what is drawn in the editor is what is computed. Nothing of the user
// interface is imported: the engine may use this file.
//
//     var xs: [kit_curve.MAX_POINTS]f32 = ...      // 0, 0.5, 1
//     var ys: [kit_curve.MAX_POINTS]f32 = ...      // 0, 0.8, 1
//     const y = kit_curve.value(&xs, &ys, 3, 0.25)
//     kit_curve.table(&xs, &ys, 3, lookup, 256)    // 256 values for x = 0 .. 1
//
// The curve is the natural cubic spline through the points (its bend
// continuous, none at the two ends), flat before the first point and after
// the last, and held in 0..1 where the spline swings out of it. One point
// is a constant, none is the diagonal y = x.

// The most points a curve has (insert takes no more).
pub const MAX_POINTS: usize = 32

// Two points are at least this far apart in x.
pub const GAP: f32 = 0.004

// A curve made ready for reading: its points and the spline's second
// derivative at each (prepare fills it, at reads it).
pub const Spline = struct {
    count: usize
    x: [32]f64
    y: [32]f64
    bend: [32]f64
}

// Makes `spline` the curve through the first `count` points (MAX_POINTS
// at most; x ascending).
pub fn prepare(spline: *Spline, xs: [*]const f32, ys: [*]const f32, count: usize) -> void {
    const n = if count > MAX_POINTS { MAX_POINTS } else { count }
    spline.*.count = n
    var index: usize = 0
    while index < n {
        spline.*.x[index] = @floatCast(f64, xs[index])
        spline.*.y[index] = @floatCast(f64, ys[index])
        spline.*.bend[index] = 0.0
        index += 1
    }
    if n < 3 { return }
    // The bends solve a system of three diagonals (each inner point's own
    // row): swept down once and up once. `upper` and `right` are the swept
    // row above the diagonal and the right side.
    var upper: [32]f64 = undefined
    var right: [32]f64 = undefined
    upper[0] = 0.0
    right[0] = 0.0
    index = 1
    while index + 1 < n {
        const before = width(spline, index - 1)
        const after = width(spline, index)
        const slope_before = (spline.*.y[index] - spline.*.y[index - 1]) / before
        const slope_after = (spline.*.y[index + 1] - spline.*.y[index]) / after
        const pivot = 2.0 * (before + after) - before * upper[index - 1]
        upper[index] = after / pivot
        right[index] = (6.0 * (slope_after - slope_before) - before * right[index - 1]) / pivot
        index += 1
    }
    index = n - 2
    while index > 0 {
        spline.*.bend[index] = right[index] - upper[index] * spline.*.bend[index + 1]
        index -= 1
    }
}

// The step in x from point `index` to the next (never nothing: two points
// at one x are a step, not a division by zero).
fn width(spline: *const Spline, index: usize) -> f64 {
    const step = spline.*.x[index + 1] - spline.*.x[index]
    return if step < 1.0e-6 { 1.0e-6 } else { step }
}

// `y` held in 0..1 (what is no number: 0).
fn held(y: f64) -> f64 {
    return if y > 1.0 { 1.0 } else if y >= 0.0 { y } else { 0.0 }
}

// The prepared curve's y at `x`, in 0..1.
pub fn at(spline: *const Spline, x: f64) -> f64 {
    const n = spline.*.count
    if n == 0 { return held(x) }
    if n == 1 || x <= spline.*.x[0] { return held(spline.*.y[0]) }
    if x >= spline.*.x[n - 1] { return held(spline.*.y[n - 1]) }
    // The piece x is in (few points: found by going along).
    var index: usize = 0
    while index + 2 < n && x >= spline.*.x[index + 1] { index += 1 }
    const step = width(spline, index)
    const b = (x - spline.*.x[index]) / step
    const a = 1.0 - b
    const y = a * spline.*.y[index] + b * spline.*.y[index + 1] + ((a * a * a - a) * spline.*.bend[index] + (b * b * b - b) * spline.*.bend[index + 1]) * step * step / 6.0
    return held(y)
}

// The y at `x` of the curve through the points (prepared for this one
// reading: use table or a Spline for many).
pub fn value(xs: [*]const f32, ys: [*]const f32, count: usize, x: f64) -> f64 {
    var spline: Spline = undefined
    prepare(&spline, xs, ys, count)
    return at(&spline, x)
}

// The curve as `samples` values for x from 0 to 1 in equal steps (the
// first at 0, the last at 1): a lookup table.
pub fn table(xs: [*]const f32, ys: [*]const f32, count: usize, into: [*]f32, samples: usize) -> void {
    var spline: Spline = undefined
    prepare(&spline, xs, ys, count)
    const last = if samples > 1 { samples - 1 } else { 1 }
    var index: usize = 0
    while index < samples {
        into[index] = @floatCast(f32, at(&spline, @floatFromInt(f64, index) / @floatFromInt(f64, last)))
        index += 1
    }
}

fn held32(v: f32) -> f32 {
    return if v > 1.0 { 1.0 } else if v >= 0.0 { v } else { 0.0 }
}

// Adds a point at (x, y) (held in 0..1), keeping x ascending; its index,
// or null when there are `capacity` (or MAX_POINTS) points already or one
// is nearer than GAP in x.
pub fn insert(xs: [*]f32, ys: [*]f32, count: *usize, capacity: usize, x: f32, y: f32) -> ?usize {
    const n = count.*
    if n >= capacity || n >= MAX_POINTS { return null }
    const px = held32(x)
    var place: usize = 0
    while place < n && xs[place] < px { place += 1 }
    if place < n && xs[place] - px < GAP { return null }
    if place > 0 && px - xs[place - 1] < GAP { return null }
    var index = n
    while index > place {
        xs[index] = xs[index - 1]
        ys[index] = ys[index - 1]
        index -= 1
    }
    xs[place] = px
    ys[place] = held32(y)
    count.* = n + 1
    return place
}

// Takes point `index` away; false for the first and the last (a curve
// keeps its ends) and for an index that is none.
pub fn remove(xs: [*]f32, ys: [*]f32, count: *usize, index: usize) -> bool {
    const n = count.*
    if index == 0 || index + 1 >= n { return false }
    var at_index = index
    while at_index + 1 < n {
        xs[at_index] = xs[at_index + 1]
        ys[at_index] = ys[at_index + 1]
        at_index += 1
    }
    count.* = n - 1
    return true
}

// Moves point `index` to (x, y): y held in 0..1, x between its neighbours
// (GAP from each; the first from 0, the last up to 1). True when it is
// somewhere else than it was.
pub fn move(xs: [*]f32, ys: [*]f32, count: usize, index: usize, x: f32, y: f32) -> bool {
    if index >= count { return false }
    var low: f32 = 0.0
    var high: f32 = 1.0
    if index > 0 { low = xs[index - 1] + GAP }
    if index + 1 < count { high = xs[index + 1] - GAP }
    var px = x
    if px > high { px = high }
    if px < low { px = low }
    const py = held32(y)
    if px == xs[index] && py == ys[index] { return false }
    xs[index] = px
    ys[index] = py
    return true
}
