// nebula core: palettes. A palette is a named list of colours as the
// palette docker shows it and files keep it, and the means to reduce a
// picture to such a list (the Palettize filter, GIF export, "index
// colours").
//
// A Palette lives in heap memory. Its entries are a colour (opaque,
// straight 0xFFRRGGBB: a palette has no alpha), a name of up to 31 bytes
// and the group they are in; group 0 is the palette's own, the nameless
// one every entry of a file without groups is in:
//
//     const swatches = palette.create(std.heap.allocator()).?
//     _ = palette.make(swatches, palette.DEFAULT, false)       // a built-in one
//     _ = palette.add(swatches, 0xFF336699, "Sea", 0)
//     const near = palette.nearest(swatches, 0xFF808080)        // ?usize: the entry
//     _ = palette.quantize(pixels, width, height, stride, swatches, palette.FLOYD_STEINBERG, 1.0, true)
//     palette.destroy(swatches)
//
// What holds throughout:
//
// - "Nearest" is the smallest distance in CIE Lab (CIE76), with Lab as
//   core/color.mlx has it (D50); of two entries equally far the earlier
//   one. The numbers come from tables read off color.toLab once and are
//   its own to some 1e-12, so a colour that is in the palette is always
//   its own nearest. nearest() looks at every entry; whoever maps many
//   colours takes a Finder from scratch memory (finder, nearestOf): it
//   remembers what it was asked before, and looks only at the entries a
//   cell of a grid over Lab lists as possible (or, for few askings and
//   long palettes, at those of a like lightness). Its answers are
//   nearest()'s, to the entry.
// - Dithering spreads the error (Floyd-Steinberg, Atkinson) or adds a
//   pattern (the others) in the bytes as they are, not in linear light:
//   what files and other programs do, and what keeps a flat area's mean
//   byte. Diffusion runs each row the other way (serpentine); because
//   every pixel takes its neighbours' errors, its result depends on the
//   rectangle handed in: only a picture reduced whole has no seams. The
//   patterns are anchored at the buffer's first pixel and repeat every 8
//   pixels both ways (NOISE does not repeat, but is the same each time).
// - Files are byte buffers here: reading and writing them is the
//   caller's. read() tells the formats apart (GIMP's .gpl, Adobe's .aco
//   and .ase, Krita's .kpl, a plain list of "#RRGGBB name" lines). A
//   reader replaces what the palette holds; when it returns false the
//   palette is empty. Readers trust nothing in the bytes: what is cut
//   off or damaged gives false, never a trap.
// - Nothing here takes pixel memory as a local: buffers come from
//   core/scratch.mlx and are given back before a function returns.
//
// Not done: writing .aco, .ase and .kpl (they are read); colour books
// (an .aco or .ase entry in a space other than RGB, HSB, CMYK, Lab or
// grey is left out, and CMYK is color.mlx's plain formula, not a press);
// of a .kpl's entries only those in sRGB (Krita's 8- and 16-bit RGB) and
// grey are read, its CMYK, Lab and floating-point RGB entries are left
// out, and its grid's empty places are not kept (the entries close up);
// groups in .gpl and in the plain list (the formats have none: the
// entries are written in their order, read into group 0).
const std = @import("std")
const math = @import("std.math")
const xml = @import("std.xml")
const color = @import("./color.mlx")
const pixel = @import("./pixel.mlx")
const scratch = @import("./scratch.mlx")
const table = @import("./table.mlx")
const zip = @import("../io/zip.mlx")

pub const Allocator = std.allocator.Allocator

// The longest name of an entry and of a group, and of a palette, in bytes.
pub const NAME: usize = 31
pub const TITLE: usize = 63
// The most entries a palette holds (an entry's place fits 16 bits) and
// the most groups, group 0 included.
pub const MOST: usize = 65535
pub const GROUPS: usize = 64
// The columns a new palette is shown in, and the most there are.
pub const COLUMNS: u32 = 16
pub const MOST_COLUMNS: u32 = 64

const FIRST_CAPACITY: usize = 64

pub const Entry = struct {
    // Opaque: 0xFFRRGGBB.
    color: u32
    group: u16
    nameLength: u8
    name: [31]u8
}

pub const Group = struct {
    nameLength: u8
    name: [31]u8
}

pub const Palette = struct {
    allocator: Allocator
    name: [63]u8
    nameLength: usize
    // How many swatches the docker puts in a row, 1 to MOST_COLUMNS.
    columns: u32
    entries: [*]Entry
    count: usize
    capacity: usize
    // GROUPS of them; groups[0] is the nameless one.
    groups: [*]Group
    groupCount: usize
}

// ---------------------------------------------------------------------------
// A palette and its entries.

inline fn atMost(a: usize, b: usize) -> usize { return if a < b { a } else { b } }

// How much of `text` fits `most` bytes without cutting a character of
// UTF-8 in two.
fn fitting(text: []const u8, most: usize) -> usize {
    if text.length <= most { return text.length }
    var length = most
    while length > 0 && text[length] & 0xC0 == 0x80 { length -= 1 }
    return length
}

// `text` as a name of at most NAME bytes at `into`; returns its length.
// Bytes that are no text (below a blank) become blanks: a name is one
// line in every file.
fn putName(into: [*]u8, text: []const u8) -> u8 {
    const length = fitting(text, NAME)
    var index: usize = 0
    while index < length {
        into[index] = if text[index] < 32 { 32 } else { text[index] }
        index += 1
    }
    return @intCast(u8, length)
}

// A new palette without entries, named "", in COLUMNS columns. Null
// without memory.
pub fn create(allocator: Allocator) -> ?*Palette {
    const memory = allocator.alloc(@sizeOf(Palette), @alignOf(Palette))
    if memory == null { return null }
    const groups = allocator.alloc(GROUPS * @sizeOf(Group), @alignOf(Group))
    const entries = allocator.alloc(FIRST_CAPACITY * @sizeOf(Entry), @alignOf(Entry))
    if groups == null || entries == null {
        if groups != null { allocator.free(groups.?, GROUPS * @sizeOf(Group), @alignOf(Group)) }
        if entries != null { allocator.free(entries.?, FIRST_CAPACITY * @sizeOf(Entry), @alignOf(Entry)) }
        allocator.free(memory.?, @sizeOf(Palette), @alignOf(Palette))
        return null
    }
    const palette: *Palette = unsafe { @ptrCast(*Palette, memory.?) }
    palette.*.allocator = allocator
    palette.*.nameLength = 0
    palette.*.columns = COLUMNS
    unsafe { palette.*.entries = @ptrCast([*]Entry, entries.?) }
    palette.*.count = 0
    palette.*.capacity = FIRST_CAPACITY
    unsafe { palette.*.groups = @ptrCast([*]Group, groups.?) }
    palette.*.groupCount = 1
    palette.*.groups[0].nameLength = 0
    return palette
}

pub fn destroy(palette: *Palette) -> void {
    const allocator = palette.*.allocator
    unsafe {
        allocator.free(@ptrCast([*]u8, palette.*.entries), palette.*.capacity * @sizeOf(Entry), @alignOf(Entry))
        allocator.free(@ptrCast([*]u8, palette.*.groups), GROUPS * @sizeOf(Group), @alignOf(Group))
        allocator.free(@ptrCast([*]u8, palette), @sizeOf(Palette), @alignOf(Palette))
    }
}

// Room for `wanted` entries. False without memory or beyond MOST (the
// palette stays as it is).
fn reserve(palette: *Palette, wanted: usize) -> bool {
    if wanted <= palette.*.capacity { return true }
    if wanted > MOST { return false }
    var better = palette.*.capacity * 2
    if better < wanted { better = wanted }
    if better > MOST { better = MOST }
    var moved: ?[*]u8 = null
    unsafe { moved = palette.*.allocator.resize(@ptrCast([*]u8, palette.*.entries), palette.*.capacity * @sizeOf(Entry), better * @sizeOf(Entry), @alignOf(Entry)) }
    if moved == null { return false }
    unsafe { palette.*.entries = @ptrCast([*]Entry, moved.?) }
    palette.*.capacity = better
    return true
}

// No entries and no groups but the nameless one; the palette's name and
// columns stay.
pub fn clear(palette: *Palette) -> void {
    palette.*.count = 0
    palette.*.groupCount = 1
}

// The palette's name, and a new one for it (what does not fit TITLE
// bytes is left off).
pub fn name(palette: *const Palette) -> []const u8 {
    const bytes: [*]const u8 = &palette.*.name
    return bytes[0..palette.*.nameLength]
}

pub fn rename(palette: *Palette, text: []const u8) -> void {
    const length = fitting(text, TITLE)
    var index: usize = 0
    while index < length {
        palette.*.name[index] = if text[index] < 32 { 32 } else { text[index] }
        index += 1
    }
    palette.*.nameLength = length
}

// The columns the palette is shown in, held to 1..MOST_COLUMNS.
pub fn setColumns(palette: *Palette, columns: u32) -> void {
    palette.*.columns = if columns < 1 { 1 } else if columns > MOST_COLUMNS { MOST_COLUMNS } else { columns }
}

pub fn count(palette: *const Palette) -> usize { return palette.*.count }

// The colour of entry `index` (0, the transparent pixel, when there is
// no such entry), its name ("" then) and its group (0 then).
pub fn colorAt(palette: *const Palette, index: usize) -> u32 {
    if index >= palette.*.count { return 0 }
    return palette.*.entries[index].color
}

pub fn nameAt(palette: *const Palette, index: usize) -> []const u8 {
    if index >= palette.*.count { return "" }
    const entry = &palette.*.entries[index]
    const bytes: [*]const u8 = &entry.*.name
    return bytes[0..@intCast(usize, entry.*.nameLength)]
}

pub fn groupAt(palette: *const Palette, index: usize) -> usize {
    if index >= palette.*.count { return 0 }
    return @intCast(usize, palette.*.entries[index].group)
}

// A new entry at place `at` (0..count; what is there and after it moves
// one up) of colour `value` (its alpha is not kept), named `text`, in
// `group`. False for a place or a group that is not there, beyond MOST
// entries and without memory.
pub fn insert(palette: *Palette, at: usize, value: u32, text: []const u8, group: usize) -> bool {
    if at > palette.*.count || group >= palette.*.groupCount { return false }
    if !reserve(palette, palette.*.count + 1) { return false }
    var index = palette.*.count
    while index > at {
        palette.*.entries[index] = palette.*.entries[index - 1]
        index -= 1
    }
    const entry = &palette.*.entries[at]
    entry.*.color = value | 0xFF000000
    entry.*.group = @intCast(u16, group)
    entry.*.nameLength = putName(&entry.*.name, text)
    palette.*.count += 1
    return true
}

// A new entry after the last.
pub fn add(palette: *Palette, value: u32, text: []const u8, group: usize) -> bool {
    return insert(palette, palette.*.count, value, text, group)
}

// Takes entry `index` out; those after it move one down. False when
// there is no such entry.
pub fn remove(palette: *Palette, index: usize) -> bool {
    if index >= palette.*.count { return false }
    var at = index
    while at + 1 < palette.*.count {
        palette.*.entries[at] = palette.*.entries[at + 1]
        at += 1
    }
    palette.*.count -= 1
    return true
}

// Entry `from` to place `to`: it is entry `to` afterwards, those between
// move one toward where it was. False when either is not there.
pub fn move(palette: *Palette, from: usize, to: usize) -> bool {
    if from >= palette.*.count || to >= palette.*.count { return false }
    if from == to { return true }
    const entries = palette.*.entries
    const moved = entries[from]
    var at = from
    while at < to {
        entries[at] = entries[at + 1]
        at += 1
    }
    while at > to {
        entries[at] = entries[at - 1]
        at -= 1
    }
    entries[to] = moved
    return true
}

// An entry's colour (the alpha given is not kept), name and group anew.
// False when the entry or the group is not there.
pub fn setColor(palette: *Palette, index: usize, value: u32) -> bool {
    if index >= palette.*.count { return false }
    palette.*.entries[index].color = value | 0xFF000000
    return true
}

pub fn setName(palette: *Palette, index: usize, text: []const u8) -> bool {
    if index >= palette.*.count { return false }
    const entry = &palette.*.entries[index]
    entry.*.nameLength = putName(&entry.*.name, text)
    return true
}

pub fn setGroup(palette: *Palette, index: usize, group: usize) -> bool {
    if index >= palette.*.count || group >= palette.*.groupCount { return false }
    palette.*.entries[index].group = @intCast(u16, group)
    return true
}

// The first entry of exactly this colour (alpha not looked at); null:
// there is none.
pub fn find(palette: *const Palette, value: u32) -> ?usize {
    const wanted = value | 0xFF000000
    var index: usize = 0
    while index < palette.*.count {
        if palette.*.entries[index].color == wanted { return index }
        index += 1
    }
    return null
}

// How many groups there are, the nameless group 0 included.
pub fn groupCount(palette: *const Palette) -> usize { return palette.*.groupCount }

// A new group named `text`, after the others: its number. Null when
// there are GROUPS already.
pub fn addGroup(palette: *Palette, text: []const u8) -> ?usize {
    if palette.*.groupCount >= GROUPS { return null }
    const group = &palette.*.groups[palette.*.groupCount]
    group.*.nameLength = putName(&group.*.name, text)
    palette.*.groupCount += 1
    return palette.*.groupCount - 1
}

// A group's name ("" for group 0 and for one that is not there).
pub fn groupName(palette: *const Palette, group: usize) -> []const u8 {
    if group == 0 || group >= palette.*.groupCount { return "" }
    const held = &palette.*.groups[group]
    const bytes: [*]const u8 = &held.*.name
    return bytes[0..@intCast(usize, held.*.nameLength)]
}

// False for group 0 (it has no name) and a group that is not there.
pub fn renameGroup(palette: *Palette, group: usize, text: []const u8) -> bool {
    if group == 0 || group >= palette.*.groupCount { return false }
    const held = &palette.*.groups[group]
    held.*.nameLength = putName(&held.*.name, text)
    return true
}

// Takes a group away: its entries are in group 0 afterwards, the groups
// after it are numbered one lower. False for group 0 and a group that is
// not there.
pub fn removeGroup(palette: *Palette, group: usize) -> bool {
    if group == 0 || group >= palette.*.groupCount { return false }
    var index: usize = 0
    while index < palette.*.count {
        const entry = &palette.*.entries[index]
        const held = @intCast(usize, entry.*.group)
        if held == group {
            entry.*.group = 0
        } else if held > group {
            entry.*.group = @intCast(u16, held - 1)
        }
        index += 1
    }
    index = group
    while index + 1 < palette.*.groupCount {
        palette.*.groups[index] = palette.*.groups[index + 1]
        index += 1
    }
    palette.*.groupCount -= 1
    return true
}

// How many entries are in `group`.
pub fn countIn(palette: *const Palette, group: usize) -> usize {
    var total: usize = 0
    var index: usize = 0
    while index < palette.*.count {
        if @intCast(usize, palette.*.entries[index].group) == group { total += 1 }
        index += 1
    }
    return total
}

// `target` made the same as `source`: name, columns, groups, entries.
// False without memory (`target` is empty then).
pub fn copy(target: *Palette, source: *const Palette) -> bool {
    clear(target)
    if !reserve(target, source.*.count) { return false }
    rename(target, name(source))
    target.*.columns = source.*.columns
    var index: usize = 0
    while index < source.*.groupCount {
        target.*.groups[index] = source.*.groups[index]
        index += 1
    }
    target.*.groupCount = source.*.groupCount
    index = 0
    while index < source.*.count {
        target.*.entries[index] = source.*.entries[index]
        index += 1
    }
    target.*.count = source.*.count
    return true
}

// ---------------------------------------------------------------------------
// The built-in palettes.

// A palette the program brings along: its colours in rows of `columns`.
// `names` has a name for every colour, or one for every row (an entry is
// then "Red 3", the third of its row), or none (an entry is named by its
// colour, "#336699").
pub const Builtin = struct {
    name: []const u8
    german: []const u8
    columns: u32
    colors: []const u32
    names: []const []const u8
    germanNames: []const []const u8
}

// Which is which in the list of built-in palettes.
pub const DEFAULT: usize = 0
pub const GREYS: usize = 1
pub const WEB_SAFE: usize = 2
pub const SKIN_TONES: usize = 3
pub const PASTEL: usize = 4
pub const PC_16: usize = 5
pub const MATERIAL: usize = 6
pub const HANDHELD_4: usize = 7
pub const CONSOLE_16: usize = 8
pub const BUILTINS: usize = 9

