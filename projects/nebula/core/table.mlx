// nebula core: lists that are constant tables (the filters, the tools,
// the actions, the blend modes' names, ...) handed out as slices.
//
// Slicing a module-level constant array (`TABLE[0..]`) makes a copy of
// the whole array in the compiler's value arena every time it runs, and
// the copy is gone when the window's loop turns; indexing one element
// (`TABLE[3]`) does not. So a module copies its table into heap memory
// once and hands that out:
//
//     var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }
//
//     pub fn list() -> []const types.Info {
//         if kept.address != 0 { return table.rows(types.Info, &kept) }
//         return table.keep(types.Info, &kept, FILTERS[0..])
//     }
//
// What the rows' own slices point at (strings, other constant tables
// named in the table's initializer) is in the program's data already.
const std = @import("std")

pub const Kept = struct {
    address: usize
    length: usize
}

// The rows kept in `kept` (keep() made it).
pub fn rows(comptime T: type, kept: *const Kept) -> []const T {
    const first: [*]const T = unsafe { @ptrFromInt([*]const T, kept.*.address) }
    return first[0..kept.*.length]
}

// `table` copied into heap memory that stays, noted in `kept`; the copy.
// Without memory `table` itself (good until the loop turns; the next
// asking tries again).
pub fn keep(comptime T: type, kept: *Kept, table: []const T) -> []const T {
    if table.length == 0 { return table }
    const memory = std.heap.allocator().alloc(table.length * @sizeOf(T), 16)
    if memory == null { return table }
    const copy: [*]T = unsafe { @ptrCast([*]T, memory.?) }
    var index: usize = 0
    while index < table.length {
        copy[index] = table[index]
        index += 1
    }
    kept.*.length = table.length
    kept.*.address = @intFromPtr(copy)
    return rows(T, kept)
}
