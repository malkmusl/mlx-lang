// nebula core: lists that are constant tables (the filters, the tools,
// the actions, the blend modes' names, ...) handed out as slices.
//
// A module-level constant array of structs is built anew each time the
// code reads it: slicing it (`TABLE[0..]`) always puts the copy in the
// compiler's value arena, and so does reading one row (`TABLE[i].name`,
// even `TABLE.length`) once the table is larger than about 1 KiB (a
// smaller one is built in the frame); the copy is gone when the window's
// loop turns. (A table of plain numbers, `[300]u64`, is data and costs
// nothing.) So a module copies its table into heap memory once and
// reads only that copy, never the table itself:
//
//     var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }
//
//     pub fn list() -> []const types.Tool {
//         if kept.address != 0 { return table.rows(types.Tool, &kept) }
//         return table.keep(types.Tool, &kept, TOOLS[0..])
//     }
//
// keep() copies the rows alone. That is enough when the rows' slices are
// strings (those are in the program's data), not when a row names
// another constant table (`.params = BLUR_PARAMS[0..]`, `.colors =
// GREYS[0..]`): such a table is built in the value arena with the rows
// (the rows and the tables they name lie side by side there:
// tests/07_table.mlx), so the copy's slices would point at memory the
// loop's turn takes back. A deep keep puts the rows and the tables they name into
// one Block and points the copied rows at the copied tables:
//
//     var block = table.Block.{ .at = 0, .end = 0 }
//     var bytes = table.room(Info, list.length)
//     ... bytes += table.room(Param, list[index].params.length) for each row
//     if !table.open(&block, bytes) { return list }
//     const rows = table.put(Info, &block, list)
//     ... rows[index].params = table.put(Param, &block, list[index].params)[0..list[index].params.length]
//     return table.note(Info, &kept, rows, list.length)
//
// (filters/types.mlx's keepList does this for the filters' lists.)
const std = @import("std")

pub const Kept = struct {
    address: usize
    length: usize
}

// Heap memory that stays, handed out from `at` up to `end`.
pub const Block = struct {
    at: usize
    end: usize
}

// The rows kept in `kept` (keep() or note() made it).
pub fn rows(comptime T: type, kept: *const Kept) -> []const T {
    const first: [*]const T = unsafe { @ptrFromInt([*]const T, kept.*.address) }
    return first[0..kept.*.length]
}

// How many bytes of a Block `count` values of T take (whole 16s, so the
// next piece is aligned as the heap's own memory is).
pub fn room(comptime T: type, count: usize) -> usize {
    return (count * @sizeOf(T) + 15) / 16 * 16
}

// `block` made `bytes` of heap memory that stays; false without memory.
pub fn open(block: *Block, bytes: usize) -> bool {
    const size = if bytes > 0 { bytes } else { 16 }
    const memory = std.heap.allocator().alloc(size, 16)
    if memory == null { return false }
    block.*.at = @intFromPtr(memory.?)
    block.*.end = block.*.at + size
    return true
}

// `values` copied into the next room(T, values.length) bytes of `block`
// (open() made it big enough); the copy, its values still to be changed.
pub fn put(comptime T: type, block: *Block, values: []const T) -> [*]T {
    const copy: [*]T = unsafe { @ptrFromInt([*]T, block.*.at) }
    var index: usize = 0
    while index < values.length {
        copy[index] = values[index]
        index += 1
    }
    block.*.at += room(T, values.length)
    return copy
}

// `length` rows at `first` noted in `kept`; the rows.
pub fn note(comptime T: type, kept: *Kept, first: [*]const T, length: usize) -> []const T {
    kept.*.length = length
    kept.*.address = @intFromPtr(first)
    return rows(T, kept)
}

// `table` copied into heap memory that stays, noted in `kept`; the copy.
// Without memory `table` itself (good until the loop turns; the next
// asking tries again).
pub fn keep(comptime T: type, kept: *Kept, table: []const T) -> []const T {
    if table.length == 0 { return table }
    var block = Block.{ .at = 0, .end = 0 }
    if !open(&block, room(T, table.length)) { return table }
    const copy = put(T, &block, table)
    return note(T, kept, copy, table.length)
}
