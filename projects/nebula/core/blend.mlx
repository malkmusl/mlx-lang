// nebula core: how one row of pixels goes over another: the blend modes.
//
//     blend.compositeSpan(mode, under, source, count, opacity, mask, flags)
//
// mixes `count` straight pixels of `source` into those at `under`: each
// source pixel counts with its alpha times `opacity` (0-255) times its
// byte of `mask` (null: all of it), in the way `mode` says. Opacity
// times mask is the pixel's *amount*; blendPixel(mode, under, source,
// amount) is the same for one pixel, blendPixelAt() with flags too.
//
// What a mode is. Most are a function B(backdrop, source) of one channel
// (Multiply: b s) or of the whole colour (Hue). Where only one of the two
// pixels shows, that one is seen; where both show, B is. With `as` the
// source's alpha times its amount and `ab` the backdrop's:
//
//     alpha   ao = as + ab - as ab
//     colour  ((1 - ab) as Cs + (1 - as) ab Cb + as ab B(Cb, Cs)) / ao
//
// A few have their own rule for alpha instead (Erase, Behind, Destination
// In, Destination Atop, Source Atop, Copy, Dissolve, Alpha Darken,
// Greater, Luminosity/Shine): each says so at its function. Whatever the
// mode, an amount of 0 leaves the backdrop as it is, bit for bit, and so
// does a transparent source, except in the three modes that are about the
// source being absent (affectsWithoutSource()).
//
// Flags hold parts of the backdrop: FLAG_ALPHA_LOCK its alpha (and a
// transparent pixel stays untouched: painting only where there is
// paint), FLAG_LOCK_RED / _GREEN / _BLUE that channel.
//
// The modes have numbers that stay (files keep them by name: name() is
// the id Krita writes, oraName() what an OpenRaster stack says, byName()
// the inverse of both); NORMAL is 0. They come in the categories of
// Krita's menu: category(), categoryTitle(), and listed() walks them in
// the order a menu shows.
//
// Dissolve takes a source pixel whole or not at all, by a number made
// from the pixel's place: compositeSpanAt() takes the seed of the span's
// first pixel, seedAt(x, y), so that a picture dissolves the same however
// it is cut into spans. compositeSpan() is compositeSpanAt() with seed 0:
// every row the same pattern.
//
// Arithmetic: the common modes are whole numbers rounded to nearest
// ((v + 127) / 255 exactly, as pixel.mul), so Normal at full amount
// stores an opaque pixel exactly and a colour mixed with itself stays;
// the exotic ones work in f64 and are held to 0-1 before they become a
// channel. compositeSpan decides by the mode once and then runs a loop
// made for it (Normal, Erase, Multiply, Screen, Overlay, Darken, Lighten,
// Addition, Difference, Dodge, Burn, Hard Light, Soft Light (SVG)) or the
// loop that calls the mode's function; every loop gives what blendPixelAt
// gives.
//
// Not verified against Krita itself, written from its documentation: see
// the comments at Greater, Luminosity/Shine, Easy Burn, the binary
// implications, the modulo and penumbra families and the HSI/HSL/HSV
// modes. The HSY modes use the weights of the W3C's Lum (0.30, 0.59,
// 0.11), where Krita has Rec. 601's (0.299, 0.587, 0.114).
//
// Not done: Dodge and Burn divide for every channel and Soft Light (SVG)
// works in f64, so those three of the loops made for a mode take two to
// five times as long as the others; Krita's two Lambert Lighting modes
// and its older Porter-Duff ids (in, out, xor, clear, plus, minus) are
// not here; "pass through" is a group's property (core/node.mlx), not a
// mode.
const pixel = @import("./pixel.mlx")
const math = @import("std.math")

// Mix.
pub const NORMAL: u16 = 0
// Takes away: under's alpha times (1 - source's), the colour stays.
pub const ERASE: u16 = 1
pub const BEHIND: u16 = 2
pub const DESTINATION_IN: u16 = 3
pub const DESTINATION_ATOP: u16 = 4
pub const SOURCE_ATOP: u16 = 5
pub const COPY: u16 = 6
pub const DISSOLVE: u16 = 7
pub const ALPHA_DARKEN: u16 = 8
pub const GREATER: u16 = 9
pub const OVERLAY: u16 = 10
pub const HARD_OVERLAY: u16 = 11
pub const GRAIN_MERGE: u16 = 12
pub const GRAIN_EXTRACT: u16 = 13
pub const GEOMETRIC_MEAN: u16 = 14
pub const ALLANON: u16 = 15
pub const PARALLEL: u16 = 16
pub const INTERPOLATION: u16 = 17
pub const INTERPOLATION_2X: u16 = 18
pub const PENUMBRA_A: u16 = 19
pub const PENUMBRA_B: u16 = 20
pub const PENUMBRA_C: u16 = 21
pub const PENUMBRA_D: u16 = 22
pub const HARD_MIX: u16 = 23
pub const HARD_MIX_PHOTOSHOP: u16 = 24
pub const HARD_MIX_SOFTER: u16 = 25
// Arithmetic.
pub const ADDITION: u16 = 26
pub const SUBTRACT: u16 = 27
pub const INVERSE_SUBTRACT: u16 = 28
pub const MULTIPLY: u16 = 29
pub const DIVIDE: u16 = 30
// Darken.
pub const DARKEN: u16 = 31
pub const BURN: u16 = 32
pub const LINEAR_BURN: u16 = 33
pub const GAMMA_DARK: u16 = 34
pub const DARKER_COLOR: u16 = 35
pub const SHADE: u16 = 36
pub const FOG_DARKEN: u16 = 37
pub const EASY_BURN: u16 = 38
// Lighten.
pub const LIGHTEN: u16 = 39
pub const SCREEN: u16 = 40
pub const DODGE: u16 = 41
pub const LINEAR_LIGHT: u16 = 42
pub const HARD_LIGHT: u16 = 43
pub const SOFT_LIGHT_SVG: u16 = 44
pub const SOFT_LIGHT_PHOTOSHOP: u16 = 45
pub const SOFT_LIGHT_PEGTOP: u16 = 46
pub const SOFT_LIGHT_IFS: u16 = 47
pub const PIN_LIGHT: u16 = 48
pub const VIVID_LIGHT: u16 = 49
pub const FLAT_LIGHT: u16 = 50
pub const GAMMA_LIGHT: u16 = 51
pub const GAMMA_ILLUMINATION: u16 = 52
pub const LIGHTER_COLOR: u16 = 53
pub const PNORM_A: u16 = 54
pub const PNORM_B: u16 = 55
pub const SUPER_LIGHT: u16 = 56
pub const TINT: u16 = 57
pub const FOG_LIGHTEN: u16 = 58
pub const EASY_DODGE: u16 = 59
pub const LUMINOSITY_SAI: u16 = 60
// Negative.
pub const DIFFERENCE: u16 = 61
pub const EXCLUSION: u16 = 62
pub const EQUIVALENCE: u16 = 63
pub const NEGATION: u16 = 64
pub const ADDITIVE_SUBTRACTIVE: u16 = 65
pub const ARCUS_TANGENT: u16 = 66
// Binary.
pub const AND: u16 = 67
pub const OR: u16 = 68
pub const XOR: u16 = 69
pub const NAND: u16 = 70
pub const NOR: u16 = 71
pub const XNOR: u16 = 72
pub const IMPLICATION: u16 = 73
pub const NOT_IMPLICATION: u16 = 74
pub const CONVERSE: u16 = 75
pub const NOT_CONVERSE: u16 = 76
// Modulo.
pub const MODULO: u16 = 77
pub const MODULO_CONTINUOUS: u16 = 78
pub const DIVISIVE_MODULO: u16 = 79
pub const DIVISIVE_MODULO_CONTINUOUS: u16 = 80
pub const MODULO_SHIFT: u16 = 81
pub const MODULO_SHIFT_CONTINUOUS: u16 = 82
// Quadratic.
pub const REFLECT: u16 = 83
pub const GLOW: u16 = 84
pub const FREEZE: u16 = 85
pub const HEAT: u16 = 86
pub const GLOW_HEAT: u16 = 87
pub const HEAT_GLOW: u16 = 88
pub const REFLECT_FREEZE: u16 = 89
pub const FREEZE_REFLECT: u16 = 90
pub const HEAT_GLOW_FREEZE_REFLECT: u16 = 91
// HSY: hue, saturation and luma. Eight modes, and the same eight in the
// same order for each of the three spaces after it.
pub const COLOR: u16 = 92
pub const HUE: u16 = 93
pub const SATURATION: u16 = 94
pub const LUMINOSITY: u16 = 95
pub const INCREASE_SATURATION: u16 = 96
pub const DECREASE_SATURATION: u16 = 97
pub const INCREASE_LUMINOSITY: u16 = 98
pub const DECREASE_LUMINOSITY: u16 = 99
// HSI: the lightness is the mean of the three channels.
pub const COLOR_HSI: u16 = 100
pub const HUE_HSI: u16 = 101
pub const SATURATION_HSI: u16 = 102
pub const INTENSITY: u16 = 103
pub const INCREASE_SATURATION_HSI: u16 = 104
pub const DECREASE_SATURATION_HSI: u16 = 105
pub const INCREASE_INTENSITY: u16 = 106
pub const DECREASE_INTENSITY: u16 = 107
// HSL: the mean of the largest and the smallest channel.
pub const COLOR_HSL: u16 = 108
pub const HUE_HSL: u16 = 109
pub const SATURATION_HSL: u16 = 110
pub const LIGHTNESS: u16 = 111
pub const INCREASE_SATURATION_HSL: u16 = 112
pub const DECREASE_SATURATION_HSL: u16 = 113
pub const INCREASE_LIGHTNESS: u16 = 114
pub const DECREASE_LIGHTNESS: u16 = 115
// HSV: the largest channel.
pub const COLOR_HSV: u16 = 116
pub const HUE_HSV: u16 = 117
pub const SATURATION_HSV: u16 = 118
pub const VALUE: u16 = 119
pub const INCREASE_SATURATION_HSV: u16 = 120
pub const DECREASE_SATURATION_HSV: u16 = 121
pub const INCREASE_VALUE: u16 = 122
pub const DECREASE_VALUE: u16 = 123
// Misc.
pub const COPY_RED: u16 = 124
pub const COPY_GREEN: u16 = 125
pub const COPY_BLUE: u16 = 126
pub const TANGENT_NORMALMAP: u16 = 127
pub const COMBINE_NORMALMAP: u16 = 128
pub const BUMPMAP: u16 = 129

pub const COUNT: u16 = 130

pub const FLAG_ALPHA_LOCK: u32 = 1
pub const FLAG_LOCK_RED: u32 = 2
pub const FLAG_LOCK_GREEN: u32 = 4
pub const FLAG_LOCK_BLUE: u32 = 8

pub const CATEGORY_MIX: u8 = 0
pub const CATEGORY_ARITHMETIC: u8 = 1
pub const CATEGORY_DARKEN: u8 = 2
pub const CATEGORY_LIGHTEN: u8 = 3
pub const CATEGORY_NEGATIVE: u8 = 4
pub const CATEGORY_BINARY: u8 = 5
pub const CATEGORY_MODULO: u8 = 6
pub const CATEGORY_QUADRATIC: u8 = 7
pub const CATEGORY_HSY: u8 = 8
pub const CATEGORY_HSI: u8 = 9
pub const CATEGORY_HSL: u8 = 10
pub const CATEGORY_HSV: u8 = 11
pub const CATEGORY_MISC: u8 = 12
pub const CATEGORY_COUNT: u8 = 13

// What a mode makes of one channel where both pixels show: the
// backdrop's and the source's, 0-255 each, to 0-255.
const Channel = fn(b: u32, s: u32) -> u32
// The same for a mode that looks at the whole colour: both pixels (their
// alpha bits are not read) to 0x00RRGGBB.
const Color = fn(mode: u16, under: u32, source: u32) -> u32
// A mode with its own rule for alpha: what `source` at `amount` (1-255)
// leaves of `under`. `seed` is the pixel's own number (seedAt).
const Whole = fn(under: u32, source: u32, amount: u32, seed: u32) -> u32

// One mode. `key` is "krita:" and the id Krita's files use; exactly one
// of the three functions is there. The texts are the bytes of a literal,
// which end with a 0 (spelled() makes a slice of them): a table that is
// read for every pixel has to be a variable, a constant one is copied
// into the value arena wherever it is read, and a variable's initial
// value can hold a pointer but no slice.
const Info = struct {
    key: [*]const u8
    english: [*]const u8
    german: [*]const u8
    category: u8
    channel: ?Channel
    color: ?Color
    whole: ?Whole
}

fn spelled(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

// An opaque pixel `cover`/255 of the way from the colour of `before` to
// `color`: each channel (b (255 - cover) + c cover + 127) / 255, which
// is pixel.lerp. Red and blue are weighed side by side in one 64-bit
// word, 16 bits for each (a channel times a weight, 255 * 255 at most,
// stays in its half), green in a second one: the technique of
// std.ui.canvas.
fn toward(before: u32, color: u32, cover: u32) -> u32 {
    const low = @intCast(u64, before)
    const wide = @intCast(u64, color)
    const weight = @intCast(u64, cover)
    const rb = (low & 0x00FF00FF) * (255 - weight) + (wide & 0x00FF00FF) * weight + 0x00800080
    const g = (low & 0x0000FF00) * (255 - weight) + (wide & 0x0000FF00) * weight + 0x00008000
    return @intCast(u32, 0xFF000000 | (((rb + ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF) | (((g + ((g >> 8) & 0x0000FF00)) >> 8) & 0x0000FF00))
}

// value / 255 rounded, for a value up to 255 * 255. (One expression, as
// every small function here that a loop is to have built in: the
// compiler calls a function made of statements, an inline one too.)
inline fn per255(value: u32) -> u32 { return (value + 128 + ((value + 128) >> 8)) >> 8 }

// The mix of the module's header for a backdrop that shows (`before`,
// alpha 1-255): `top` is the source, `cover` (1-255) its alpha times its
// amount, `blended` the mode's B for the two colours.
//
// An opaque backdrop is the lane arithmetic of toward(): the formula
// with ab = 1. Otherwise the three weights add up to `total` (255 * 255
// at most) and each channel is its weighed sum over it, rounded: the
// quotient is taken with one division for all three, as the product
// with 1 / total, and is still the whole-number one: the sum plus a half
// is at least half of 1 / total away from the next whole quotient, the
// product's error a millionth of that. (In signed 64-bit words: their
// checks cost next to nothing, and they become floating-point numbers
// and come back from them in one step each.)
fn joined(before: u32, top: u32, cover: u32, blended: u32) -> u32 {
    if before >> 24 == 255 { return toward(before, blended, cover) }
    const low = @intCast(i64, before)
    const high = @intCast(i64, top)
    const wide = @intCast(i64, blended)
    const as = @intCast(i64, cover)
    const ab = low >> 24
    const both = ab * as
    const alone = (255 - ab) * as
    const stays = (255 - as) * ab
    const total = alone + stays + both
    const nudge = @floatFromInt(f64, total >> 1) + 0.5
    const scale = 1.0 / @floatFromInt(f64, total)
    const r = @intFromFloat(i64, (@floatFromInt(f64, ((high >> 16) & 255) * alone + ((low >> 16) & 255) * stays + ((wide >> 16) & 255) * both) + nudge) * scale)
    const g = @intFromFloat(i64, (@floatFromInt(f64, ((high >> 8) & 255) * alone + ((low >> 8) & 255) * stays + ((wide >> 8) & 255) * both) + nudge) * scale)
    const b = @intFromFloat(i64, (@floatFromInt(f64, (high & 255) * alone + (low & 255) * stays + (wide & 255) * both) + nudge) * scale)
    return @intCast(u32, (((total + 128 + ((total + 128) >> 8)) >> 8) << 24) | (r << 16) | (g << 8) | b)
}

// A channel as a number from 0 to 1, and back: held to 0-1 and rounded.
// What is not a number becomes 0.
const PER_255: f64 = 1.0 / 255.0

inline fn unit(channel: u32) -> f64 { return @floatFromInt(f64, channel) * PER_255 }

inline fn level(value: f64) -> u32 {
    return if !(value > 0.0) { 0 } else if value >= 1.0 { 255 } else { @intFromFloat(u32, value * 255.0 + 0.5) }
}

// ---- One channel: the modes with a loop of their own --------------------
//
// Each is one expression, so that its loop has it built in; the same
// function is the mode's entry in the list.

// a / d as a channel, held at white; d is not 0.
inline fn ratio(a: u32, d: u32) -> u32 { return pixel.smaller(255, (a * 255 + (d >> 1)) / d) }

// All ones where a is below b, nothing elsewhere (the borrow of a - b).
// The four modes that choose between their channels use it instead of
// an `if`: which of two pixels is lighter cannot be guessed, and a
// wrong guess costs more than this arithmetic.
inline fn below(a: u32, b: u32) -> u32 { return 0 -% ((a -% b) >> 31) }

// b s.
inline fn multiplyChannel(b: u32, s: u32) -> u32 { return per255(b * s) }

// 1 - (1 - b) (1 - s) = b + s - b s.
inline fn screenChannel(b: u32, s: u32) -> u32 { return b + s - per255(b * s) }

// The W3C's hard light: multiply by 2 s below the middle of the source,
// screen by 2 s - 1 above it. Screening is multiplying the inverted
// pixels and inverting again: `turn` is 255 above the middle and inverts
// by ^, 0 below it. Overlay is the same with the two swapped: the
// backdrop decides.
inline fn turned(b: u32, s: u32, turn: u32) -> u32 { return per255(2 * (b ^ turn) * (s ^ turn)) ^ turn }

inline fn hardLightChannel(b: u32, s: u32) -> u32 { return turned(b, s, (0 -% (s >> 7)) & 255) }

inline fn overlayChannel(b: u32, s: u32) -> u32 { return hardLightChannel(s, b) }

// The smaller and the larger of the two.
inline fn darkenChannel(b: u32, s: u32) -> u32 { return s +% ((b -% s) & below(b, s)) }
inline fn lightenChannel(b: u32, s: u32) -> u32 { return b -% ((b -% s) & below(b, s)) }

// b + s held at white (linear dodge): a sum past 255 has bit 8.
inline fn additionChannel(b: u32, s: u32) -> u32 { return ((b + s) | (0 -% ((b + s) >> 8))) & 255 }

// |b - s|.
inline fn differenceChannel(b: u32, s: u32) -> u32 { return ((b -% s) ^ below(b, s)) -% below(b, s) }

// The W3C's colour dodge b / (1 - s) and colour burn 1 - (1 - b) / s,
// with its edges: nothing lightens black, nothing darkens white.
inline fn dodgeChannel(b: u32, s: u32) -> u32 {
    return if b == 0 { 0 } else if s == 255 { 255 } else { ratio(b, 255 - s) }
}

inline fn burnChannel(b: u32, s: u32) -> u32 {
    return if b == 255 { 255 } else if s == 0 { 0 } else { 255 - ratio(255 - b, s) }
}

// The W3C's soft light: darkens by b (1 - b) below the middle of the
// source, lightens toward D(b) above it, D being the square root except
// near black, where a polynomial keeps the slope finite.
inline fn softCurve(cb: f64) -> f64 {
    return if cb <= 0.25 { ((16.0 * cb - 12.0) * cb + 4.0) * cb } else { @sqrt(cb) }
}

inline fn softLightValue(cb: f64, cs: f64) -> f64 {
    return if cs <= 0.5 { cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb) } else { cb + (2.0 * cs - 1.0) * (softCurve(cb) - cb) }
}

inline fn softLightSvgChannel(b: u32, s: u32) -> u32 { return level(softLightValue(unit(b), unit(s))) }

// ---- One channel: Mix ---------------------------------------------------

// Multiply by 2 s below the middle of the source, colour dodge by
// 2 s - 1 above it: b / (2 - 2 s).
fn hardOverlayChannel(b: u32, s: u32) -> u32 {
    if s == 255 { return 255 }
    if s <= 127 { return per255(2 * b * s) }
    return pixel.div(b, 2 * (255 - s))
}

// b + s - 1/2 and b - s + 1/2. The half is 128, the grey a grain layer
// is filled with, so that extracting a grain and merging it again gives
// the picture back.
fn grainMergeChannel(b: u32, s: u32) -> u32 {
    const sum = b + s
    return if sum <= 128 { 0 } else if sum > 383 { 255 } else { sum - 128 }
}

fn grainExtractChannel(b: u32, s: u32) -> u32 {
    const sum = b + 128
    return if sum <= s { 0 } else if sum - s > 255 { 255 } else { sum - s }
}

// sqrt(b s): in channels just that, the two 255s under the root cancel.
fn geometricMeanChannel(b: u32, s: u32) -> u32 {
    return @intFromFloat(u32, @sqrt(@floatFromInt(f64, b * s)) + 0.5)
}

// (b + s) / 2.
fn allanonChannel(b: u32, s: u32) -> u32 { return (b + s + 1) / 2 }

// The harmonic mean 2 / (1 / b + 1 / s) = 2 b s / (b + s); black when
// either is.
fn parallelChannel(b: u32, s: u32) -> u32 {
    if b == 0 || s == 0 { return 0 }
    return (2 * b * s + (b + s) / 2) / (b + s)
}

// 1/2 - cos(pi s) / 4 - cos(pi b) / 4: each of the two eased in and out.
fn interpolationValue(b: u32, s: u32) -> f64 {
    return 0.5 - 0.25 * math.cos(math.pi * unit(s)) - 0.25 * math.cos(math.pi * unit(b))
}

fn interpolationChannel(b: u32, s: u32) -> u32 { return level(interpolationValue(b, s)) }

// Interpolation of its own result with itself.
fn interpolation2xChannel(b: u32, s: u32) -> u32 {
    return level(0.5 - 0.5 * math.cos(math.pi * interpolationValue(b, s)))
}

// Penumbra B (documentation, not verified against Krita): half the
// colour dodge of the source by the backdrop while the two do not reach
// white together, the mirror image of it from there on:
// s / (2 (1 - b)), then 1 - (1 - b) / (2 s). Penumbra A is the same
// with the two swapped.
fn penumbra(b: u32, s: u32) -> u32 {
    if b == 255 { return 255 }
    if b + s < 255 { return (s * 255 + (255 - b)) / (2 * (255 - b)) }
    if s == 0 { return 0 }
    const part = ((255 - b) * 255 + s) / (2 * s)
    return if part > 255 { 0 } else { 255 - part }
}

fn penumbraAChannel(b: u32, s: u32) -> u32 { return penumbra(s, b) }
fn penumbraBChannel(b: u32, s: u32) -> u32 { return penumbra(b, s) }

// 2 atan(over / under) / pi: nothing over anything is black, anything
// over nothing white.
fn arcus(under: u32, over: u32) -> u32 {
    if under == 0 { return if over == 0 { 0 } else { 255 } }
    return level(2.0 * math.atan(@floatFromInt(f64, over) / @floatFromInt(f64, under)) / math.pi)
}

// Penumbra D (documentation, not verified against Krita): the arcus
// tangent of the source over the inverted backdrop; C is D with the two
// swapped.
fn penumbraDChannel(b: u32, s: u32) -> u32 {
    if b == 255 { return 255 }
    return arcus(255 - b, s)
}

fn penumbraCChannel(b: u32, s: u32) -> u32 { return penumbraDChannel(s, b) }

// Krita's hard mix: colour dodge where the backdrop is light, colour
// burn where it is dark.
fn hardMixChannel(b: u32, s: u32) -> u32 {
    return if b > 127 { dodgeChannel(b, s) } else { burnChannel(b, s) }
}

// White where the two together pass white, black elsewhere.
fn hardMixPhotoshopChannel(b: u32, s: u32) -> u32 {
    return if b + s > 255 { 255 } else { 0 }
}

// The same with a ramp instead of the step: 3 b - 2 (1 - s).
fn hardMixSofterChannel(b: u32, s: u32) -> u32 {
    const sum = 3 * b + 2 * s
    return if sum <= 510 { 0 } else if sum > 765 { 255 } else { sum - 510 }
}

// ---- One channel: Arithmetic --------------------------------------------

fn subtractChannel(b: u32, s: u32) -> u32 { return if b > s { b - s } else { 0 } }

// b + s - 1: linear burn, and Krita's inverse subtract, b - (1 - s).
fn linearBurnChannel(b: u32, s: u32) -> u32 { return if b + s > 255 { b + s - 255 } else { 0 } }

// b / s; by nothing: black stays black, everything else is white.
fn divideChannel(b: u32, s: u32) -> u32 {
    if s == 0 { return if b == 0 { 0 } else { 255 } }
    return pixel.div(b, s)
}

// ---- One channel: Darken ------------------------------------------------

// b^(1 / s).
fn gammaDarkChannel(b: u32, s: u32) -> u32 {
    if s == 0 { return 0 }
    return level(math.pow(unit(b), 255.0 / @floatFromInt(f64, s)))
}

// 1 - ((1 - b) s + sqrt(1 - s)).
fn shadeChannel(b: u32, s: u32) -> u32 {
    const cs = unit(s)
    return level(1.0 - ((1.0 - unit(b)) * cs + @sqrt(1.0 - cs)))
}

// s b + s - s^2 (both halves of the formula as Krita documents it are
// this one expression).
fn fogDarkenChannel(b: u32, s: u32) -> u32 { return (s * (b + 255 - s) + 127) / 255 }

// 1 - (1 - b)^(1.04 s): the mirror image of Easy Dodge. This is the
// formula of the work package; Krita's own may have the two operands
// the other way round (not verified).
fn easyBurnChannel(b: u32, s: u32) -> u32 {
    return level(1.0 - math.pow(1.0 - unit(b), unit(s) * 1.04))
}

// ---- One channel: Lighten -----------------------------------------------

// b + 2 s - 1.
fn linearLightChannel(b: u32, s: u32) -> u32 {
    const sum = b + 2 * s
    return if sum <= 255 { 0 } else if sum > 510 { 255 } else { sum - 255 }
}

// Photoshop's soft light: the square root all the way down to black.
fn softLightPhotoshopChannel(b: u32, s: u32) -> u32 {
    const cb = unit(b)
    const cs = unit(s)
    if s <= 127 { return level(cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb)) }
    return level(cb + (2.0 * cs - 1.0) * (@sqrt(cb) - cb))
}

// Pegtop's: multiply and screen mixed by the backdrop,
// (1 - b) b s + b (b + s - b s) = (1 - 2 s) b^2 + 2 s b.
fn softLightPegtopChannel(b: u32, s: u32) -> u32 {
    const cb = unit(b)
    const cs = unit(s)
    return level((1.0 - 2.0 * cs) * cb * cb + 2.0 * cs * cb)
}

// IFS Illusions': b^(2^(1 - 2 s)), a gamma from 2 to 1/2.
fn softLightIfsChannel(b: u32, s: u32) -> u32 {
    return level(math.pow(unit(b), math.exp(math.ln2 * (1.0 - 2.0 * unit(s)))))
}

// max(2 s - 1, min(b, 2 s)).
fn pinLightChannel(b: u32, s: u32) -> u32 {
    const twice = 2 * s
    const low = if b < twice { b } else { twice }
    return if twice > 255 && twice - 255 > low { twice - 255 } else { low }
}

// Colour burn by 2 s below the middle of the source, colour dodge by
// 2 s - 1 above it.
fn vividLightChannel(b: u32, s: u32) -> u32 {
    if s <= 127 {
        if s == 0 { return if b == 255 { 255 } else { 0 } }
        const part = ((255 - b) * 255 + s) / (2 * s)
        return if part > 255 { 0 } else { 255 - part }
    }
    if s == 255 { return if b == 0 { 0 } else { 255 } }
    return pixel.div(b, 2 * (255 - s))
}

// Penumbra B where the backdrop is lighter than the source, A elsewhere
// (documentation, not verified against Krita).
fn flatLightChannel(b: u32, s: u32) -> u32 {
    if s == 0 { return 0 }
    return if b > s { penumbra(b, s) } else { penumbra(s, b) }
}

// b^s.
fn gammaLightChannel(b: u32, s: u32) -> u32 { return level(math.pow(unit(b), unit(s))) }

// The inverse of gamma dark of both inverted: 1 - (1 - b)^(1 / (1 - s)).
fn gammaIlluminationChannel(b: u32, s: u32) -> u32 {
    if s == 255 { return 255 }
    return level(1.0 - math.pow(1.0 - unit(b), 255.0 / @floatFromInt(f64, 255 - s)))
}

// (b^p + s^p)^(1 / p) with p = 7/3, and with p = 4.
fn pnormAChannel(b: u32, s: u32) -> u32 {
    return level(math.pow(math.pow(unit(b), 7.0 / 3.0) + math.pow(unit(s), 7.0 / 3.0), 3.0 / 7.0))
}

fn pnormBChannel(b: u32, s: u32) -> u32 {
    const cb = unit(b) * unit(b)
    const cs = unit(s) * unit(s)
    return level(@sqrt(@sqrt(cb * cb + cs * cs)))
}

// The p-norm with p = 2.875 of the backdrop and 2 s - 1 above the
// middle of the source, of both inverted below it.
fn superLightChannel(b: u32, s: u32) -> u32 {
    const p = 2.875
    if s <= 127 { return level(1.0 - math.pow(math.pow(1.0 - unit(b), p) + math.pow(unit(255 - 2 * s), p), 1.0 / p)) }
    return level(math.pow(math.pow(unit(b), p) + math.pow(unit(2 * s - 255), p), 1.0 / p))
}

// s (1 - b) + sqrt(b).
fn tintChannel(b: u32, s: u32) -> u32 {
    const cb = unit(b)
    return level(unit(s) * (1.0 - cb) + @sqrt(cb))
}

// 1 - (1 - s) (s + 1 - b): fog darken of both inverted, inverted.
fn fogLightenChannel(b: u32, s: u32) -> u32 { return 255 - ((255 - s) * (s + 255 - b) + 127) / 255 }

// b^(1.04 (1 - s)).
fn easyDodgeChannel(b: u32, s: u32) -> u32 {
    if s == 255 { return 255 }
    return level(math.pow(unit(b), (1.0 - unit(s)) * 1.04))
}

// ---- One channel: Negative ----------------------------------------------

// b + s - 2 b s.
fn exclusionChannel(b: u32, s: u32) -> u32 { return b + s - (2 * b * s + 127) / 255 }

// 1 - |b - s|.
fn equivalenceChannel(b: u32, s: u32) -> u32 { return 255 - (if b > s { b - s } else { s - b }) }

// 1 - |1 - s - b|: the sum, turning back at white. Modulo Shift
// Continuous is the same wave.
fn negationChannel(b: u32, s: u32) -> u32 {
    const sum = b + s
    return if sum > 255 { 510 - sum } else { sum }
}

// |sqrt(b) - sqrt(s)|.
fn additiveSubtractiveChannel(b: u32, s: u32) -> u32 {
    const gap = @sqrt(unit(b)) - @sqrt(unit(s))
    return level(if gap < 0.0 { -gap } else { gap })
}

// 2 atan(s / b) / pi.
fn arcusTangentChannel(b: u32, s: u32) -> u32 { return arcus(b, s) }

// ---- One channel: Binary ------------------------------------------------
//
// The channels' eight bits, one by one. An implication reads "the
// backdrop implies the source" (not b, or s), its converse the other way
// round; Krita's documentation words them so, its code may have the two
// swapped (not verified).

fn andChannel(b: u32, s: u32) -> u32 { return b & s }
fn orChannel(b: u32, s: u32) -> u32 { return b | s }
fn xorChannel(b: u32, s: u32) -> u32 { return b ^ s }
fn nandChannel(b: u32, s: u32) -> u32 { return (b & s) ^ 255 }
fn norChannel(b: u32, s: u32) -> u32 { return (b | s) ^ 255 }
fn xnorChannel(b: u32, s: u32) -> u32 { return (b ^ s) ^ 255 }
fn implicationChannel(b: u32, s: u32) -> u32 { return (b ^ 255) | s }
fn notImplicationChannel(b: u32, s: u32) -> u32 { return b & (s ^ 255) }
fn converseChannel(b: u32, s: u32) -> u32 { return b | (s ^ 255) }
fn notConverseChannel(b: u32, s: u32) -> u32 { return (b ^ 255) & s }

// ---- One channel: Modulo ------------------------------------------------
//
// Written from Krita's documentation, not verified against it. The
// documentation's "epsilon" is one step of a channel here, and all of it
// is whole-number arithmetic, so the saw teeth fall exactly where they
// belong.

// b mod (s + epsilon).
fn moduloChannel(b: u32, s: u32) -> u32 { return b % (s + 1) }

// Where b / s stands in its wave that climbs to 1 while the quotient
// goes from an even number to the next odd one and falls back from
// there: `numerator` / s, which is 0 when either is black.
fn waveNumerator(b: u32, s: u32) -> u32 {
    if b == 0 || s == 0 { return 0 }
    const step = (b + s - 1) / s
    const rest = b - (step - 1) * s
    return if step % 2 == 1 { rest } else { s - rest }
}

// Divisive Modulo Continuous times s: in channels the wave's numerator
// itself.
fn moduloContinuousChannel(b: u32, s: u32) -> u32 { return waveNumerator(b, s) }

// The fraction of b / s; a whole quotient counts as a full 1 (as the
// epsilon makes it), by nothing as in Divide.
fn divisiveModuloChannel(b: u32, s: u32) -> u32 {
    if b == 0 { return 0 }
    if s == 0 { return 255 }
    const rest = b % s
    return if rest == 0 { 255 } else { (rest * 255 + s / 2) / s }
}

// The same as a wave without the drop: up, then down again.
fn divisiveModuloContinuousChannel(b: u32, s: u32) -> u32 {
    if b == 0 { return 0 }
    if s == 0 { return 255 }
    return (waveNumerator(b, s) * 255 + s / 2) / s
}

// (b + s) mod 1; a sum of exactly white stays white, but a white source
// on black is black.
fn moduloShiftChannel(b: u32, s: u32) -> u32 {
    if s == 255 && b == 0 { return 0 }
    const sum = b + s
    return if sum > 255 { sum - 255 } else { sum }
}

// ---- One channel: Quadratic ---------------------------------------------

// b^2 / (1 - s) held at 1 (Reflect), and 1 - (1 - b)^2 / s held at 0
// (Freeze). Glow is Reflect, Heat is Freeze with the two swapped.
fn reflectValue(b: u32, s: u32) -> f64 {
    if s == 255 { return 1.0 }
    const value = unit(b) * unit(b) / unit(255 - s)
    return if value > 1.0 { 1.0 } else { value }
}

fn freezeValue(b: u32, s: u32) -> f64 {
    if b == 255 { return 1.0 }
    if s == 0 { return 0.0 }
    const value = unit(255 - b) * unit(255 - b) / unit(s)
    return if value > 1.0 { 0.0 } else { 1.0 - value }
}

fn reflectChannel(b: u32, s: u32) -> u32 { return level(reflectValue(b, s)) }
fn glowChannel(b: u32, s: u32) -> u32 { return level(reflectValue(s, b)) }
fn freezeChannel(b: u32, s: u32) -> u32 { return level(freezeValue(b, s)) }
fn heatChannel(b: u32, s: u32) -> u32 { return level(freezeValue(s, b)) }

// The pairs: one of the two where the pixels together pass white, the
// other below; they meet on that line.
fn glowHeatChannel(b: u32, s: u32) -> u32 {
    if b == 255 { return 255 }
    return level(if b + s > 255 { reflectValue(s, b) } else { freezeValue(s, b) })
}

fn heatGlowValue(b: u32, s: u32) -> f64 {
    if b + s > 255 { return freezeValue(s, b) }
    if s == 0 { return 0.0 }
    return reflectValue(s, b)
}

fn heatGlowChannel(b: u32, s: u32) -> u32 { return level(heatGlowValue(b, s)) }

fn reflectFreezeChannel(b: u32, s: u32) -> u32 {
    if s == 255 { return 255 }
    return level(if b + s > 255 { reflectValue(b, s) } else { freezeValue(b, s) })
}

fn freezeReflectValue(b: u32, s: u32) -> f64 {
    if b + s > 255 { return freezeValue(b, s) }
    if b == 0 { return 0.0 }
    return reflectValue(b, s)
}

fn freezeReflectChannel(b: u32, s: u32) -> u32 { return level(freezeReflectValue(b, s)) }

// The mean of Freeze-Reflect and Heat-Glow.
fn hybridChannel(b: u32, s: u32) -> u32 {
    return level((freezeReflectValue(b, s) + heatGlowValue(b, s)) * 0.5)
}

// ---- The whole colour ---------------------------------------------------

const SPACE_Y: u32 = 0
const SPACE_I: u32 = 1
const SPACE_L: u32 = 2

const OP_COLOR: u32 = 0
const OP_HUE: u32 = 1
const OP_SATURATION: u32 = 2
const OP_LIGHTNESS: u32 = 3
const OP_MORE_SATURATION: u32 = 4
const OP_LESS_SATURATION: u32 = 5
const OP_MORE_LIGHTNESS: u32 = 6

// Channels are whole 255ths, so a difference is nothing or at least one
// of them: anything far below that tells the two apart.
const NOTHING: f64 = 0.000000001

inline fn largest(r: f64, g: f64, b: f64) -> f64 { return math.max(math.max(r, g), b) }
inline fn smallest(r: f64, g: f64, b: f64) -> f64 { return math.min(math.min(r, g), b) }

// How light a colour is in a space: the W3C's Lum (Y), the mean of the
// channels (I), the mean of the largest and the smallest (L), the
// largest (V).
fn lightness(space: u32, r: f64, g: f64, b: f64) -> f64 {
    if space == SPACE_Y { return 0.3 * r + 0.59 * g + 0.11 * b }
    if space == SPACE_I { return (r + g + b) / 3.0 }
    if space == SPACE_L { return (largest(r, g, b) + smallest(r, g, b)) * 0.5 }
    return largest(r, g, b)
}

// How colourful: the spread of the channels (Y), and in the other
// spaces that spread over what it could be at the colour's lightness
// (HSI/HSL/HSV as Krita documents them, not verified against it).
fn saturation(space: u32, r: f64, g: f64, b: f64) -> f64 {
    const high = largest(r, g, b)
    const low = smallest(r, g, b)
    const chroma = high - low
    if space == SPACE_Y { return chroma }
    if space == SPACE_I { return if chroma > NOTHING { 1.0 - low * 3.0 / (r + g + b) } else { 0.0 } }
    if space == SPACE_L {
        const room = 1.0 - math.abs(high + low - 1.0)
        return if room > NOTHING { chroma / room } else { 1.0 }
    }
    return if high == 0.0 { 0.0 } else { chroma / high }
}

// The eight modes of a space, in the terms of the W3C's non-separable
// modes (which are the first four of HSY): one of the two colours is
// taken, given a saturation (SetSat: the spread of its channels
// stretched to it, the smallest at 0), then moved along the grey axis
// to a lightness (SetLum) or by an amount, and brought back into the
// cube toward its own grey (ClipColor) with the lightness of the space.
//
//   Colour      the source at the backdrop's lightness
//   Hue         the source at the backdrop's saturation and lightness
//   Saturation  the backdrop at the source's saturation
//   Lightness   the backdrop at the source's lightness
//   more / less saturation  the backdrop's saturation moved toward 1 /
//               scaled toward 0 by the source's
//   more / less lightness   the backdrop lightened by the source's
//               lightness / darkened by what the source lacks to white
fn hsxColor(mode: u16, under: u32, source: u32) -> u32 {
    const place = @intCast(u32, mode - COLOR)
    const space = place / 8
    const op = place % 8
    const dr = unit((under >> 16) & 255)
    const dg = unit((under >> 8) & 255)
    const db = unit(under & 255)
    const sr = unit((source >> 16) & 255)
    const sg = unit((source >> 8) & 255)
    const sb = unit(source & 255)
    var r = dr
    var g = dg
    var b = db
    // Below 0: the colour keeps the spread it has.
    var spread: f64 = -1.0
    // The lightness the colour ends at, or (`added`) what it gains.
    var light: f64 = 0.0
    var added = false
    if op == OP_COLOR || op == OP_HUE {
        r = sr
        g = sg
        b = sb
        if op == OP_HUE { spread = saturation(space, dr, dg, db) }
        light = lightness(space, dr, dg, db)
    } else if op == OP_SATURATION {
        spread = saturation(space, sr, sg, sb)
        light = lightness(space, dr, dg, db)
    } else if op == OP_LIGHTNESS {
        light = lightness(space, sr, sg, sb)
    } else if op == OP_MORE_SATURATION {
        const own = saturation(space, dr, dg, db)
        spread = own + (1.0 - own) * saturation(space, sr, sg, sb)
        light = lightness(space, dr, dg, db)
    } else if op == OP_LESS_SATURATION {
        spread = saturation(space, dr, dg, db) * saturation(space, sr, sg, sb)
        light = lightness(space, dr, dg, db)
    } else {
        added = true
        light = lightness(space, sr, sg, sb)
        if op != OP_MORE_LIGHTNESS { light -= 1.0 }
    }
    if spread >= 0.0 {
        const low = smallest(r, g, b)
        const range = largest(r, g, b) - low
        if range > 0.0 {
            const factor = spread / range
            r = (r - low) * factor
            g = (g - low) * factor
            b = (b - low) * factor
        } else {
            r = 0.0
            g = 0.0
            b = 0.0
        }
    }
    const shift = if added { light } else { light - lightness(space, r, g, b) }
    r += shift
    g += shift
    b += shift
    const grey = lightness(space, r, g, b)
    const low = smallest(r, g, b)
    const high = largest(r, g, b)
    // A grey outside the cube has nothing to scale: level() holds it.
    if low < 0.0 && grey - low > NOTHING {
        const factor = grey / (grey - low)
        r = grey + (r - grey) * factor
        g = grey + (g - grey) * factor
        b = grey + (b - grey) * factor
    }
    if high > 1.0 && high - grey > NOTHING {
        const factor = (1.0 - grey) / (high - grey)
        r = grey + (r - grey) * factor
        g = grey + (g - grey) * factor
        b = grey + (b - grey) * factor
    }
    return (level(r) << 16) | (level(g) << 8) | level(b)
}

// The W3C's Lum times 100, exactly.
inline fn luma100(color: u32) -> u32 {
    return ((color >> 16) & 255) * 30 + ((color >> 8) & 255) * 59 + (color & 255) * 11
}

// The darker (Darker Color) or the lighter (Lighter Color) of the two
// colours as a whole; the source when they are level.
fn extremeColor(mode: u16, under: u32, source: u32) -> u32 {
    const backdrop = luma100(under)
    const over = luma100(source)
    const takeUnder = if mode == DARKER_COLOR { backdrop < over } else { backdrop > over }
    return (if takeUnder { under } else { source }) & 0x00FFFFFF
}

// One channel of the source, the others the backdrop's.
fn copyChannelColor(mode: u16, under: u32, source: u32) -> u32 {
    const taken: u32 = if mode == COPY_RED { 0x00FF0000 } else if mode == COPY_GREEN { 0x0000FF00 } else { 0x000000FF }
    return (under & (0x00FFFFFF ^ taken)) | (source & taken)
}

// Two tangent-space normal maps added: x and y around their middle, z
// around its top.
fn tangentNormalColor(mode: u16, under: u32, source: u32) -> u32 {
    const r = level(unit((source >> 16) & 255) + unit((under >> 16) & 255) - 0.5)
    const g = level(unit((source >> 8) & 255) + unit((under >> 8) & 255) - 0.5)
    const b = level(unit(source & 255) + unit(under & 255) - 1.0)
    return (r << 16) | (g << 8) | b
}

// Reoriented normal mapping (Barré-Brisebois and Hill, "Blending in
// Detail"): the backdrop's normal turned by the rotation that takes
// straight up to the source's normal. t is the source's normal with z
// raised by one, u the backdrop's with x and y turned round; the result
// is t (t.u) / t.z - u, made one long. A source without any z has no
// such rotation; its z counts as a millionth.
fn combineNormalColor(mode: u16, under: u32, source: u32) -> u32 {
    const tx = 2.0 * unit((source >> 16) & 255) - 1.0
    const ty = 2.0 * unit((source >> 8) & 255) - 1.0
    var tz = 2.0 * unit(source & 255)
    if tz < 0.000001 { tz = 0.000001 }
    const ux = 1.0 - 2.0 * unit((under >> 16) & 255)
    const uy = 1.0 - 2.0 * unit((under >> 8) & 255)
    const uz = 2.0 * unit(under & 255) - 1.0
    const k = (tx * ux + ty * uy + tz * uz) / tz
    const x = tx * k - ux
    const y = ty * k - uy
    const z = tz * k - uz
    const length = @sqrt(x * x + y * y + z * z)
    if !(length > NOTHING) { return under & 0x00FFFFFF }
    const half = 0.5 / length
    return (level(x * half + 0.5) << 16) | (level(y * half + 0.5) << 8) | level(z * half + 0.5)
}

// The backdrop times how light the source is (306, 601 and 117 of 1024
// for red, green and blue): a height map shading what is below it.
fn bumpmapColor(mode: u16, under: u32, source: u32) -> u32 {
    const light = ((source >> 16) & 255) * 306 + ((source >> 8) & 255) * 601 + (source & 255) * 117
    const r = (((under >> 16) & 255) * light + 130560) / 261120
    const g = (((under >> 8) & 255) * light + 130560) / 261120
    const b = ((under & 255) * light + 130560) / 261120
    return (r << 16) | (g << 8) | b
}

// ---- Modes with their own rule for alpha --------------------------------

fn normalPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    return pixel.over(under, source, amount)
}

// The backdrop's alpha times (1 - the source's); the colour stays, and
// a pixel erased wholly is 0.
fn erasePixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const cover = pixel.mul(source >> 24, amount)
    if cover == 0 { return under }
    const a = pixel.mul(under >> 24, 255 - cover)
    return if a == 0 { 0 } else { (under & 0x00FFFFFF) | (a << 24) }
}

// The source below the backdrop (destination over): it shows only
// where the backdrop lets it.
fn behindPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const cover = pixel.mul(source >> 24, amount)
    if cover == 0 { return under }
    return pixel.over((cover << 24) | (source & 0x00FFFFFF), under, 255)
}

// The backdrop only where the source is: its alpha times the source's.
// The amount says how much of that is done, so here a transparent source
// erases.
fn destinationInPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const a = pixel.mul(under >> 24, 255 - pixel.mul(255 - (source >> 24), amount))
    return if a == 0 { 0 } else { (under & 0x00FFFFFF) | (a << 24) }
}

// What the source covers and nothing else: the backdrop's colour where
// it was, the source's elsewhere, at the source's alpha. The amount
// moves the pixel there from what it was, so a transparent source erases.
fn destinationAtopPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const sa = source >> 24
    var whole: u32 = 0
    if sa != 0 { whole = (sa << 24) | (toward(source, under, under >> 24) & 0x00FFFFFF) }
    return pixel.mix(under, whole, amount)
}

// The source only where the backdrop is: the backdrop's alpha stays,
// its colour goes to the source's by the source's alpha.
fn sourceAtopPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const cover = pixel.mul(source >> 24, amount)
    if cover == 0 || under >> 24 == 0 { return under }
    return (under & 0xFF000000) | (toward(under, source, cover) & 0x00FFFFFF)
}

// Replaces: the pixel moves to the source by the amount, alpha too, so
// a transparent source clears.
fn copyPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    return pixel.mix(under, source, amount)
}

// A pixel's number well stirred (the finishing steps of MurmurHash3).
fn stirred(value: u32) -> u32 {
    var x = value
    x ^= x >> 16
    x *%= 0x85EBCA6B
    x ^= x >> 13
    x *%= 0xC2B2AE35
    x ^= x >> 16
    return x
}

// The source's colour, opaque, or nothing of it: taken with a chance of
// its alpha times its amount, decided by the pixel's seed alone.
fn dissolvePixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const cover = pixel.mul(source >> 24, amount)
    const bar = @intCast(u32, (@intCast(u64, stirred(seed)) * 255) >> 32)
    return if bar < cover { source | 0xFF000000 } else { under }
}

// A brush's wash: the colour goes to the source's by its alpha times
// the amount, but the alpha only rises toward the amount (the stroke's
// opacity), by the source's alpha, and never falls: dabs over dabs do
// not add up past the stroke's opacity.
fn alphaDarkenPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const sa = source >> 24
    const cover = pixel.mul(sa, amount)
    if cover == 0 { return under }
    const ab = under >> 24
    if ab == 0 { return (cover << 24) | (source & 0x00FFFFFF) }
    const alpha = if amount > ab { pixel.lerp(ab, amount, sa) } else { ab }
    return (alpha << 24) | (toward(under, source, cover) & 0x00FFFFFF)
}

// Paints only where the source is more opaque than the backdrop
// (written from Krita's documentation, not verified against it): the
// alpha becomes the larger of the two, the change-over softened to a few
// hundredths of alpha, and the colour is what a normal mix would show
// that had brought the alpha that far.
fn greaterPixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const cover = pixel.mul(source >> 24, amount)
    const ab = under >> 24
    if cover == 0 || ab == 255 { return under }
    const was = unit(ab)
    const comes = unit(cover)
    const weight = 1.0 / (1.0 + math.exp(-40.0 * (was - comes)))
    var alpha = was * weight + comes * (1.0 - weight)
    if alpha < was { alpha = was }
    const a = level(alpha)
    if a == 0 { return under }
    if ab == 0 { return (a << 24) | (source & 0x00FFFFFF) }
    // The opacity at which the source, mixed the normal way, would have
    // brought the alpha from what it was to this.
    const share = 1.0 - (1.0 - alpha) / (1.0 - was)
    const keep = was * (1.0 - share) / alpha
    const take = share / alpha
    const r = level(unit((under >> 16) & 255) * keep + unit((source >> 16) & 255) * take)
    const g = level(unit((under >> 8) & 255) * keep + unit((source >> 8) & 255) * take)
    const b = level(unit(under & 255) * keep + unit(source & 255) * take)
    return (a << 24) | (r << 16) | (g << 8) | b
}

// Luminosity/Shine as SAI has it (written from Krita's documentation,
// not verified against it): where the backdrop shows, the source's
// colour times its alpha is added to it, without the backdrop giving
// way as it does in Addition; where it does not, the source shows.
fn shinePixel(under: u32, source: u32, amount: u32, seed: u32) -> u32 {
    const cover = pixel.mul(source >> 24, amount)
    if cover == 0 { return under }
    const ab = under >> 24
    if ab == 0 { return (cover << 24) | (source & 0x00FFFFFF) }
    const sr = (source >> 16) & 255
    const sg = (source >> 8) & 255
    const sb = source & 255
    const r = pixel.smaller(255, ((under >> 16) & 255) + pixel.mul(sr, cover))
    const g = pixel.smaller(255, ((under >> 8) & 255) + pixel.mul(sg, cover))
    const b = pixel.smaller(255, (under & 255) + pixel.mul(sb, cover))
    if ab == 255 { return 0xFF000000 | (r << 16) | (g << 8) | b }
    const alone = (255 - ab) * cover
    const shows = 255 * ab
    const total = alone + shows
    const half = total / 2
    return (per255(total) << 24) | (((sr * alone + r * shows + half) / total) << 16) | (((sg * alone + g * shows + half) / total) << 8) | ((sb * alone + b * shows + half) / total)
}

