// Another name a file may have for a mode.
const Alias = struct {
    text: [*]const u8
    mode: u16
}

// What an OpenRaster stack calls the modes it knows (composite-op).
const SVG_NAMES: usize = 20
var SVG: [20]Alias = [20]Alias{
    Alias.{ .text = "svg:src-over".pointer, .mode = NORMAL },
    Alias.{ .text = "svg:multiply".pointer, .mode = MULTIPLY },
    Alias.{ .text = "svg:screen".pointer, .mode = SCREEN },
    Alias.{ .text = "svg:overlay".pointer, .mode = OVERLAY },
    Alias.{ .text = "svg:darken".pointer, .mode = DARKEN },
    Alias.{ .text = "svg:lighten".pointer, .mode = LIGHTEN },
    Alias.{ .text = "svg:color-dodge".pointer, .mode = DODGE },
    Alias.{ .text = "svg:color-burn".pointer, .mode = BURN },
    Alias.{ .text = "svg:hard-light".pointer, .mode = HARD_LIGHT },
    Alias.{ .text = "svg:soft-light".pointer, .mode = SOFT_LIGHT_SVG },
    Alias.{ .text = "svg:difference".pointer, .mode = DIFFERENCE },
    Alias.{ .text = "svg:color".pointer, .mode = COLOR },
    Alias.{ .text = "svg:luminosity".pointer, .mode = LUMINOSITY },
    Alias.{ .text = "svg:hue".pointer, .mode = HUE },
    Alias.{ .text = "svg:saturation".pointer, .mode = SATURATION },
    Alias.{ .text = "svg:plus".pointer, .mode = ADDITION },
    Alias.{ .text = "svg:dst-in".pointer, .mode = DESTINATION_IN },
    Alias.{ .text = "svg:dst-out".pointer, .mode = ERASE },
    Alias.{ .text = "svg:src-atop".pointer, .mode = SOURCE_ATOP },
    Alias.{ .text = "svg:dst-atop".pointer, .mode = DESTINATION_ATOP },
}

// Spellings other programs and older files use.
const OTHER_NAMES: usize = 8
var OTHER: [8]Alias = [8]Alias{
    Alias.{ .text = "svg:dst-over".pointer, .mode = BEHIND },
    Alias.{ .text = "svg:exclusion".pointer, .mode = EXCLUSION },
    Alias.{ .text = "svg:add".pointer, .mode = ADDITION },
    Alias.{ .text = "plus".pointer, .mode = ADDITION },
    Alias.{ .text = "linear_dodge".pointer, .mode = ADDITION },
    Alias.{ .text = "difference".pointer, .mode = DIFFERENCE },
    Alias.{ .text = "luminosity".pointer, .mode = LUMINOSITY },
    Alias.{ .text = "hard_mix_softer".pointer, .mode = HARD_MIX_SOFTER },
}

const Named = struct {
    english: [*]const u8
    german: [*]const u8
}

var CATEGORIES: [13]Named = [13]Named{
    Named.{ .english = "Mix".pointer, .german = "Mischen".pointer },
    Named.{ .english = "Arithmetic".pointer, .german = "Arithmetik".pointer },
    Named.{ .english = "Darken".pointer, .german = "Abdunkeln".pointer },
    Named.{ .english = "Lighten".pointer, .german = "Aufhellen".pointer },
    Named.{ .english = "Negative".pointer, .german = "Negativ".pointer },
    Named.{ .english = "Binary".pointer, .german = "Binär".pointer },
    Named.{ .english = "Modulo".pointer, .german = "Modulo".pointer },
    Named.{ .english = "Quadratic".pointer, .german = "Quadratisch".pointer },
    Named.{ .english = "HSY".pointer, .german = "HSY".pointer },
    Named.{ .english = "HSI".pointer, .german = "HSI".pointer },
    Named.{ .english = "HSL".pointer, .german = "HSL".pointer },
    Named.{ .english = "HSV".pointer, .german = "HSV".pointer },
    Named.{ .english = "Misc".pointer, .german = "Verschiedenes".pointer },
}

// A mode's place in the list; a number that is no mode counts as Normal
// everywhere (a file from a later version still shows).
inline fn placeOf(mode: u16) -> usize {
    return if mode < COUNT { @intCast(usize, mode) } else { 0 }
}

// The id Krita's files know the mode by ("normal", "erase", "multiply",
// "soft_light_svg", "hard mix", ...).
pub fn name(mode: u16) -> []const u8 {
    return spelled(MODES[placeOf(mode)].key)[6..]
}

// The name an OpenRaster stack gives the mode: the SVG one where there
// is one ("svg:src-over", "svg:multiply", ...), Krita's id behind
// "krita:" otherwise.
pub fn oraName(mode: u16) -> []const u8 {
    const place = placeOf(mode)
    var index: usize = 0
    while index < SVG_NAMES {
        if @intCast(usize, SVG[index].mode) == place { return spelled(SVG[index].text) }
        index += 1
    }
    return spelled(MODES[place].key)
}

// Capitals as small letters, and a space or a hyphen as an underscore:
// "Hard Mix", "hard_mix" and "hard-mix" are one name.
inline fn folded(byte: u8) -> u8 {
    return if byte >= 65 && byte <= 90 { byte + 32 } else if byte == 32 || byte == 45 { 95 } else { byte }
}

fn sameName(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if folded(left[index]) != folded(right[index]) { return false }
        index += 1
    }
    return true
}

// The mode of a file's name: what name() and oraName() give, with or
// without "krita:" before it, and a few other spellings. NORMAL for one
// not known.
pub fn byName(text: []const u8) -> u16 {
    var wanted = text
    if wanted.length > 6 && sameName(wanted[0..6], "krita:") { wanted = wanted[6..] }
    var mode: u16 = 0
    while mode < COUNT {
        if sameName(wanted, spelled(MODES[@intCast(usize, mode)].key)[6..]) { return mode }
        mode += 1
    }
    var index: usize = 0
    while index < SVG_NAMES {
        if sameName(wanted, spelled(SVG[index].text)) { return SVG[index].mode }
        index += 1
    }
    index = 0
    while index < OTHER_NAMES {
        if sameName(wanted, spelled(OTHER[index].text)) { return OTHER[index].mode }
        index += 1
    }
    return NORMAL
}

// What people read, in English and in German.
pub fn title(mode: u16, german: bool) -> []const u8 {
    const place = placeOf(mode)
    return spelled(if german { MODES[place].german } else { MODES[place].english })
}

// The category of Krita's menu the mode is in (CATEGORY_...).
pub fn category(mode: u16) -> u8 {
    return MODES[placeOf(mode)].category
}

// A category's name for people ("" for a number that is none).
pub fn categoryTitle(which: u8, german: bool) -> []const u8 {
    if which >= CATEGORY_COUNT { return "" }
    const place = @intCast(usize, which)
    return spelled(if german { CATEGORIES[place].german } else { CATEGORIES[place].english })
}

// The modes in the order a menu shows them: category after category,
// Normal first. listed(index) for index below listedCount() names each
// mode once. (The numbers were given in this order; a mode added later
// takes the next number and its place in the menu from a table here.)
pub fn listedCount() -> usize { return @intCast(usize, COUNT) }

pub fn listed(index: usize) -> u16 {
    return if index < @intCast(usize, COUNT) { @intCast(u16, index) } else { NORMAL }
}

// True for the modes that change the backdrop where the source is
// transparent (Copy, Destination In, Destination Atop): a compositor may
// skip an empty stretch of a layer in every other mode, not in these.
pub fn affectsWithoutSource(mode: u16) -> bool {
    return mode == COPY || mode == DESTINATION_IN || mode == DESTINATION_ATOP
}

// The seed of the pixel at (x, y) of an image, for Dissolve: the pixel
// to its right has the next one, so a span starting at (x, y) is given
// seedAt(x, y) and its pixels count on from there.
pub fn seedAt(x: i32, y: i32) -> u32 {
    return stirred(@bitCast(u32, y)) +% @bitCast(u32, x)
}

// The bits of the backdrop that the flags hold.
fn heldBits(flags: u32) -> u32 {
    var held: u32 = 0
    if flags & FLAG_ALPHA_LOCK != 0 { held |= 0xFF000000 }
    if flags & FLAG_LOCK_RED != 0 { held |= 0x00FF0000 }
    if flags & FLAG_LOCK_GREEN != 0 { held |= 0x0000FF00 }
    if flags & FLAG_LOCK_BLUE != 0 { held |= 0x000000FF }
    return held
}

// One pixel of `source` at `amount` (0-255: its opacity times its mask)
// over `under` in `mode`.
pub fn blendPixel(mode: u16, under: u32, source: u32, amount: u32) -> u32 {
    return blendPixelAt(mode, under, source, amount, 0, 0)
}

// The same under `flags`, the pixel's seed being `seed` (seedAt; only
// Dissolve reads it): exactly what compositeSpanAt leaves of a pixel.
pub fn blendPixelAt(mode: u16, under: u32, source: u32, amount: u32, flags: u32, seed: u32) -> u32 {
    const place = placeOf(mode)
    const weight = if amount > 255 { 255 } else { amount }
    if weight == 0 { return under }
    if flags & FLAG_ALPHA_LOCK != 0 {
        // Nothing to paint on; and the two modes that only take alpha
        // away have nothing to do.
        if under >> 24 == 0 || place == @intCast(usize, ERASE) || place == @intCast(usize, DESTINATION_IN) { return under }
    }
    var mixed = under
    if MODES[place].whole != null {
        mixed = MODES[place].whole.?(under, source, weight, seed)
    } else {
        const cover = pixel.mul(source >> 24, weight)
        if cover == 0 { return under }
        if under >> 24 == 0 {
            mixed = (cover << 24) | (source & 0x00FFFFFF)
        } else if MODES[place].channel != null {
            const channel = MODES[place].channel.?
            const blended = (channel((under >> 16) & 255, (source >> 16) & 255) << 16) | (channel((under >> 8) & 255, (source >> 8) & 255) << 8) | channel(under & 255, source & 255)
            mixed = joined(under, source, cover, blended)
        } else {
            mixed = joined(under, source, cover, MODES[place].color.?(@intCast(u16, place), under, source))
        }
    }
    const held = heldBits(flags)
    return (mixed & ~held) | (under & held)
}

// ---- Rows ---------------------------------------------------------------
//
// The loops count in 64-bit words with the operators that do not check
// for overflow: a channel times a weight stays far below what a word
// holds, and without the checks (and without the narrowing that every
// 32-bit result needs) a pixel takes half the time. What they give is
// held against blendPixelAt, which does check, by the test. In every
// loop `opacity` is 1-255, `held` the bits of the backdrop that stay
// (heldBits) and `locked` says that transparent pixels stay as they are.
//
// All of them step over transparent pixels of the source, store the
// source at its cover where there is nothing below, and over an opaque
// pixel give an opaque one, each channel b (255 - cover) + B cover over
// 255: red and blue side by side in one word (16 bits each, as
// std.ui.canvas does it), green in another. Only two translucent pixels
// need the division: joined().

// Normal, nothing held and no mask: the compositor's everyday row. An
// opaque pixel at the full amount replaces what is there.
fn spanNormal(under: [*]u32, source: [*]const u32, count: usize, opacity: u64) -> void {
    var index: usize = 0
    while index < count {
        const top = @intCast(u64, source[index])
        var cover = top >> 24
        if cover == 0 {
            index +%= 1
            continue
        }
        if opacity != 255 {
            cover = cover *% opacity +% 128
            cover = (cover +% (cover >> 8)) >> 8
            if cover == 0 {
                index +%= 1
                continue
            }
        }
        if cover == 255 {
            under[index] = @intCast(u32, top)
            index +%= 1
            continue
        }
        const low = @intCast(u64, under[index])
        const ab = low >> 24
        if ab == 255 {
            const keep = 255 -% cover
            const rb = (low & 0x00FF00FF) *% keep +% (top & 0x00FF00FF) *% cover +% 0x00800080
            const g = (low & 0x0000FF00) *% keep +% (top & 0x0000FF00) *% cover +% 0x00008000
            under[index] = @intCast(u32, 0xFF000000 | (((rb +% ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF) | (((g +% ((g >> 8) & 0x0000FF00)) >> 8) & 0x0000FF00))
        } else if ab == 0 {
            under[index] = @intCast(u32, (cover << 24) | (top & 0x00FFFFFF))
        } else {
            under[index] = joined(@intCast(u32, low), @intCast(u32, top), @intCast(u32, cover), @intCast(u32, top))
        }
        index +%= 1
    }
}

// The ways a copy of spanMix gets B where both pixels show: built in
// for the first twelve (QUICK_NORMAL: B is the source's colour), by
// calling `channel` for each channel, by calling `color` for the pixel.
// The numbers are the places in the tree of choices in the loop.
const QUICK_NORMAL: u16 = 0
const QUICK_MULTIPLY: u16 = 1
const QUICK_SCREEN: u16 = 2
const QUICK_OVERLAY: u16 = 3
const QUICK_DARKEN: u16 = 4
const QUICK_LIGHTEN: u16 = 5
const QUICK_ADDITION: u16 = 6
const QUICK_DIFFERENCE: u16 = 7
const QUICK_DODGE: u16 = 8
const QUICK_BURN: u16 = 9
const QUICK_HARD_LIGHT: u16 = 10
const QUICK_SOFT_LIGHT: u16 = 11
const QUICK_CHANNEL: u16 = 12
const QUICK_COLOR: u16 = 13

// Every mode that mixes by the header's formula, with a mask and held
// bits or without. The loop is compiled once for each `quick`; only the
// QUICK_CHANNEL copy reads `channel`, only the QUICK_COLOR one `color`
// and `mode`.
//
// The choice between the fourteen is a tree, not a list: the compiled
// copy keeps a jump for every `if comptime` it passes, and at the end of
// a list those would cost more than the mode's arithmetic.
fn spanMix(comptime quick: u16, channel: Channel, color: Color, mode: u16, under: [*]u32, source: [*]const u32, count: usize, opacity: u64, mask: ?[*]const u8, held: u32, locked: bool) -> void {
    var index: usize = 0
    while index < count {
        const top = source[index]
        var cover = @intCast(u64, top >> 24)
        if cover == 0 {
            index +%= 1
            continue
        }
        var amount = opacity
        if mask != null {
            amount = amount *% @intCast(u64, mask.?[index]) +% 128
            amount = (amount +% (amount >> 8)) >> 8
        }
        cover = cover *% amount +% 128
        cover = (cover +% (cover >> 8)) >> 8
        if cover == 0 {
            index +%= 1
            continue
        }
        const before = under[index]
        const ab = before >> 24
        if ab == 0 {
            if !locked { under[index] = ((@intCast(u32, cover << 24) | (top & 0x00FFFFFF)) & ~held) | (before & held) }
            index +%= 1
            continue
        }
        var blended = top
        if comptime quick >= QUICK_DODGE {
            if comptime quick >= QUICK_CHANNEL {
                if comptime quick == QUICK_CHANNEL {
                    blended = (channel((before >> 16) & 255, (top >> 16) & 255) << 16) | (channel((before >> 8) & 255, (top >> 8) & 255) << 8) | channel(before & 255, top & 255)
                } else {
                    blended = color(mode, before, top)
                }
            } else if comptime quick >= QUICK_HARD_LIGHT {
                if comptime quick == QUICK_HARD_LIGHT {
                    blended = (hardLightChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (hardLightChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | hardLightChannel(before & 255, top & 255)
                } else {
                    blended = (softLightSvgChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (softLightSvgChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | softLightSvgChannel(before & 255, top & 255)
                }
            } else if comptime quick == QUICK_DODGE {
                blended = (dodgeChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (dodgeChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | dodgeChannel(before & 255, top & 255)
            } else {
                blended = (burnChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (burnChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | burnChannel(before & 255, top & 255)
            }
        } else if comptime quick >= QUICK_DARKEN {
            if comptime quick >= QUICK_ADDITION {
                if comptime quick == QUICK_ADDITION {
                    blended = (additionChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (additionChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | additionChannel(before & 255, top & 255)
                } else {
                    blended = (differenceChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (differenceChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | differenceChannel(before & 255, top & 255)
                }
            } else if comptime quick == QUICK_DARKEN {
                blended = (darkenChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (darkenChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | darkenChannel(before & 255, top & 255)
            } else {
                blended = (lightenChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (lightenChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | lightenChannel(before & 255, top & 255)
            }
        } else if comptime quick >= QUICK_SCREEN {
            if comptime quick == QUICK_SCREEN {
                blended = (screenChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (screenChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | screenChannel(before & 255, top & 255)
            } else {
                blended = (overlayChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (overlayChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | overlayChannel(before & 255, top & 255)
            }
        } else if comptime quick == QUICK_MULTIPLY {
            blended = (multiplyChannel((before >> 16) & 255, (top >> 16) & 255) << 16) | (multiplyChannel((before >> 8) & 255, (top >> 8) & 255) << 8) | multiplyChannel(before & 255, top & 255)
        }
        var mixed: u32 = 0
        if ab == 255 {
            const low = @intCast(u64, before)
            const wide = @intCast(u64, blended)
            const keep = 255 -% cover
            const rb = (low & 0x00FF00FF) *% keep +% (wide & 0x00FF00FF) *% cover +% 0x00800080
            const g = (low & 0x0000FF00) *% keep +% (wide & 0x0000FF00) *% cover +% 0x00008000
            mixed = @intCast(u32, 0xFF000000 | (((rb +% ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF) | (((g +% ((g >> 8) & 0x0000FF00)) >> 8) & 0x0000FF00))
        } else {
            mixed = joined(before, top, @intCast(u32, cover), blended)
        }
        under[index] = (mixed & ~held) | (before & held)
        index +%= 1
    }
}

// Erase.
fn spanErase(under: [*]u32, source: [*]const u32, count: usize, opacity: u64, mask: ?[*]const u8, held: u32) -> void {
    var index: usize = 0
    while index < count {
        var cover = @intCast(u64, source[index] >> 24)
        if cover != 0 {
            var amount = opacity
            if mask != null {
                amount = amount *% @intCast(u64, mask.?[index]) +% 128
                amount = (amount +% (amount >> 8)) >> 8
            }
            cover = cover *% amount +% 128
            cover = (cover +% (cover >> 8)) >> 8
            if cover != 0 {
                const before = under[index]
                var a = @intCast(u64, before >> 24) *% (255 -% cover) +% 128
                a = (a +% (a >> 8)) >> 8
                const mixed = if a == 0 { 0 } else { (before & 0x00FFFFFF) | @intCast(u32, a << 24) }
                under[index] = (mixed & ~held) | (before & held)
            }
        }
        index +%= 1
    }
}

// A mode with its own rule for alpha: its function for every pixel
// with an amount, the transparent ones of the source too.
fn spanWhole(whole: Whole, under: [*]u32, source: [*]const u32, count: usize, opacity: u64, mask: ?[*]const u8, held: u32, locked: bool, seed: u32) -> void {
    var index: usize = 0
    while index < count {
        var amount = opacity
        if mask != null {
            amount = amount *% @intCast(u64, mask.?[index]) +% 128
            amount = (amount +% (amount >> 8)) >> 8
        }
        if amount != 0 {
            const before = under[index]
            if !(locked && before >> 24 == 0) {
                const mixed = whole(before, source[index], @intCast(u32, amount), seed +% @intCast(u32, index))
                under[index] = (mixed & ~held) | (before & held)
            }
        }
        index +%= 1
    }
}

// `count` pixels of `source` over those at `under` in `mode`, each at
// its alpha times `opacity` (0-255) times its byte of `mask` (null:
// all of it), `flags` holding parts of the backdrop.
pub fn compositeSpan(mode: u16, under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, flags: u32) -> void {
    compositeSpanAt(mode, under, source, count, opacity, mask, flags, 0)
}

// The same for a span whose first pixel has the seed `seed` (seedAt of
// its place in the image): Dissolve then falls the same way wherever a
// row is cut into spans. The other modes do not read it.
pub fn compositeSpanAt(mode: u16, under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, flags: u32, seed: u32) -> void {
    if opacity == 0 || count == 0 { return }
    const amount: u64 = if opacity > 255 { 255 } else { @intCast(u64, opacity) }
    const which = if mode < COUNT { mode } else { NORMAL }
    const locked = flags & FLAG_ALPHA_LOCK != 0
    const held = heldBits(flags)
    // What a copy of spanMix is handed in place of the function it does
    // not read.
    const none = multiplyChannel
    const no = extremeColor
    if which == NORMAL {
        if mask == null && flags == 0 {
            spanNormal(under, source, count, amount)
        } else {
            spanMix(QUICK_NORMAL, none, no, which, under, source, count, amount, mask, held, locked)
        }
    } else if which == ERASE {
        // With the alpha held there is nothing for it to do.
        if !locked { spanErase(under, source, count, amount, mask, held) }
    } else if which == MULTIPLY {
        spanMix(QUICK_MULTIPLY, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == SCREEN {
        spanMix(QUICK_SCREEN, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == OVERLAY {
        spanMix(QUICK_OVERLAY, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == DARKEN {
        spanMix(QUICK_DARKEN, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == LIGHTEN {
        spanMix(QUICK_LIGHTEN, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == ADDITION {
        spanMix(QUICK_ADDITION, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == DIFFERENCE {
        spanMix(QUICK_DIFFERENCE, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == DODGE {
        spanMix(QUICK_DODGE, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == BURN {
        spanMix(QUICK_BURN, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == HARD_LIGHT {
        spanMix(QUICK_HARD_LIGHT, none, no, which, under, source, count, amount, mask, held, locked)
    } else if which == SOFT_LIGHT_SVG {
        spanMix(QUICK_SOFT_LIGHT, none, no, which, under, source, count, amount, mask, held, locked)
    } else {
        const place = @intCast(usize, which)
        if MODES[place].channel != null {
            spanMix(QUICK_CHANNEL, MODES[place].channel.?, no, which, under, source, count, amount, mask, held, locked)
        } else if MODES[place].color != null {
            spanMix(QUICK_COLOR, none, MODES[place].color.?, which, under, source, count, amount, mask, held, locked)
        } else if !(locked && which == DESTINATION_IN) {
            spanWhole(MODES[place].whole.?, under, source, count, amount, mask, held, locked, seed)
        }
    }
}
