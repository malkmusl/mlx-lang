// Another name a file may have for a mode.
const Alias = struct {
    text: []const u8
    mode: u16
}

// What an OpenRaster stack calls the modes it knows (composite-op).
const SVG_NAMES: usize = 20
const SVG: [20]Alias = [20]Alias{
    Alias.{ .text = "svg:src-over", .mode = NORMAL },
    Alias.{ .text = "svg:multiply", .mode = MULTIPLY },
    Alias.{ .text = "svg:screen", .mode = SCREEN },
    Alias.{ .text = "svg:overlay", .mode = OVERLAY },
    Alias.{ .text = "svg:darken", .mode = DARKEN },
    Alias.{ .text = "svg:lighten", .mode = LIGHTEN },
    Alias.{ .text = "svg:color-dodge", .mode = DODGE },
    Alias.{ .text = "svg:color-burn", .mode = BURN },
    Alias.{ .text = "svg:hard-light", .mode = HARD_LIGHT },
    Alias.{ .text = "svg:soft-light", .mode = SOFT_LIGHT_SVG },
    Alias.{ .text = "svg:difference", .mode = DIFFERENCE },
    Alias.{ .text = "svg:color", .mode = COLOR },
    Alias.{ .text = "svg:luminosity", .mode = LUMINOSITY },
    Alias.{ .text = "svg:hue", .mode = HUE },
    Alias.{ .text = "svg:saturation", .mode = SATURATION },
    Alias.{ .text = "svg:plus", .mode = ADDITION },
    Alias.{ .text = "svg:dst-in", .mode = DESTINATION_IN },
    Alias.{ .text = "svg:dst-out", .mode = ERASE },
    Alias.{ .text = "svg:src-atop", .mode = SOURCE_ATOP },
    Alias.{ .text = "svg:dst-atop", .mode = DESTINATION_ATOP },
}

// Spellings other programs and older files use.
const OTHER_NAMES: usize = 8
const OTHER: [8]Alias = [8]Alias{
    Alias.{ .text = "svg:dst-over", .mode = BEHIND },
    Alias.{ .text = "svg:exclusion", .mode = EXCLUSION },
    Alias.{ .text = "svg:add", .mode = ADDITION },
    Alias.{ .text = "plus", .mode = ADDITION },
    Alias.{ .text = "linear_dodge", .mode = ADDITION },
    Alias.{ .text = "difference", .mode = DIFFERENCE },
    Alias.{ .text = "luminosity", .mode = LUMINOSITY },
    Alias.{ .text = "hard_mix_softer", .mode = HARD_MIX_SOFTER },
}

const Named = struct {
    english: []const u8
    german: []const u8
}

const CATEGORIES: [13]Named = [13]Named{
    Named.{ .english = "Mix", .german = "Mischen" },
    Named.{ .english = "Arithmetic", .german = "Arithmetik" },
    Named.{ .english = "Darken", .german = "Abdunkeln" },
    Named.{ .english = "Lighten", .german = "Aufhellen" },
    Named.{ .english = "Negative", .german = "Negativ" },
    Named.{ .english = "Binary", .german = "Binär" },
    Named.{ .english = "Modulo", .german = "Modulo" },
    Named.{ .english = "Quadratic", .german = "Quadratisch" },
    Named.{ .english = "HSY", .german = "HSY" },
    Named.{ .english = "HSI", .german = "HSI" },
    Named.{ .english = "HSL", .german = "HSL" },
    Named.{ .english = "HSV", .german = "HSV" },
    Named.{ .english = "Misc", .german = "Verschiedenes" },
}

// A mode's place in the list; a number that is no mode counts as Normal
// everywhere (a file from a later version still shows).
inline fn placeOf(mode: u16) -> usize {
    return if mode < COUNT { @intCast(usize, mode) } else { 0 }
}

// The id Krita's files know the mode by ("normal", "erase", "multiply",
// "soft_light_svg", "hard mix", ...).
pub fn name(mode: u16) -> []const u8 {
    return MODES[placeOf(mode)].key[6..]
}

// The name an OpenRaster stack gives the mode: the SVG one where there
// is one ("svg:src-over", "svg:multiply", ...), Krita's id behind
// "krita:" otherwise.
pub fn oraName(mode: u16) -> []const u8 {
    const place = placeOf(mode)
    var index: usize = 0
    while index < SVG_NAMES {
        if @intCast(usize, SVG[index].mode) == place { return SVG[index].text }
        index += 1
    }
    return MODES[place].key
}

// Capitals as small letters, and a space or a hyphen as an underscore:
// "Hard Mix", "hard_mix" and "hard-mix" are one name.
inline fn folded(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    if byte == 32 || byte == 45 { return 95 }
    return byte
}

fn sameName(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if folded(left[index]) != folded(right[index]) { return false }
        index += 1
    }
    return true
}

// The mode of a file's name: what name() and oraName() give, with or
// without "krita:" before it, and a few other spellings. NORMAL for one
// not known.
pub fn byName(text: []const u8) -> u16 {
    var wanted = text
    if wanted.length > 6 && sameName(wanted[0..6], "krita:") { wanted = wanted[6..] }
    var mode: u16 = 0
    while mode < COUNT {
        if sameName(wanted, MODES[@intCast(usize, mode)].key[6..]) { return mode }
        mode += 1
    }
    var index: usize = 0
    while index < SVG_NAMES {
        if sameName(wanted, SVG[index].text) { return SVG[index].mode }
        index += 1
    }
    index = 0
    while index < OTHER_NAMES {
        if sameName(wanted, OTHER[index].text) { return OTHER[index].mode }
        index += 1
    }
    return NORMAL
}

// What people read, in English and in German.
pub fn title(mode: u16, german: bool) -> []const u8 {
    const place = placeOf(mode)
    return if german { MODES[place].german } else { MODES[place].english }
}

// The category of Krita's menu the mode is in (CATEGORY_...).
pub fn category(mode: u16) -> u8 {
    return MODES[placeOf(mode)].category
}

// A category's name for people ("" for a number that is none).
pub fn categoryTitle(which: u8, german: bool) -> []const u8 {
    if which >= CATEGORY_COUNT { return "" }
    const place = @intCast(usize, which)
    return if german { CATEGORIES[place].german } else { CATEGORIES[place].english }
}

// The modes in the order a menu shows them: category after category,
// Normal first. listed(index) for index below listedCount() names each
// mode once. (The numbers were given in this order; a mode added later
// takes the next number and its place in the menu from a table here.)
pub fn listedCount() -> usize { return @intCast(usize, COUNT) }

pub fn listed(index: usize) -> u16 {
    return if index < @intCast(usize, COUNT) { @intCast(u16, index) } else { NORMAL }
}

// True for the modes that change the backdrop where the source is
// transparent (Copy, Destination In, Destination Atop): a compositor may
// skip an empty stretch of a layer in every other mode, not in these.
pub fn affectsWithoutSource(mode: u16) -> bool {
    return mode == COPY || mode == DESTINATION_IN || mode == DESTINATION_ATOP
}

// The seed of the pixel at (x, y) of an image, for Dissolve: the pixel
// to its right has the next one, so a span starting at (x, y) is given
// seedAt(x, y) and its pixels count on from there.
pub fn seedAt(x: i32, y: i32) -> u32 {
    return stirred(@bitCast(u32, y)) +% @bitCast(u32, x)
}

// The bits of the backdrop that the flags hold.
fn heldBits(flags: u32) -> u32 {
    var held: u32 = 0
    if flags & FLAG_ALPHA_LOCK != 0 { held |= 0xFF000000 }
    if flags & FLAG_LOCK_RED != 0 { held |= 0x00FF0000 }
    if flags & FLAG_LOCK_GREEN != 0 { held |= 0x0000FF00 }
    if flags & FLAG_LOCK_BLUE != 0 { held |= 0x000000FF }
    return held
}

// One pixel of `source` at `amount` (0-255: its opacity times its mask)
// over `under` in `mode`.
pub fn blendPixel(mode: u16, under: u32, source: u32, amount: u32) -> u32 {
    return blendPixelAt(mode, under, source, amount, 0, 0)
}

// The same under `flags`, the pixel's seed being `seed` (seedAt; only
// Dissolve reads it): exactly what compositeSpanAt leaves of a pixel.
pub fn blendPixelAt(mode: u16, under: u32, source: u32, amount: u32, flags: u32, seed: u32) -> u32 {
    const place = placeOf(mode)
    const weight = if amount > 255 { 255 } else { amount }
    if weight == 0 { return under }
    if flags & FLAG_ALPHA_LOCK != 0 {
        // Nothing to paint on; and the two modes that only take alpha
        // away have nothing to do.
        if under >> 24 == 0 || place == @intCast(usize, ERASE) || place == @intCast(usize, DESTINATION_IN) { return under }
    }
    var mixed = under
    if MODES[place].whole != null {
        mixed = MODES[place].whole.?(under, source, weight, seed)
    } else {
        const cover = pixel.mul(source >> 24, weight)
        if cover == 0 { return under }
        if under >> 24 == 0 {
            mixed = (cover << 24) | (source & 0x00FFFFFF)
        } else if MODES[place].channel != null {
            const channel = MODES[place].channel.?
            const blended = (channel((under >> 16) & 255, (source >> 16) & 255) << 16) | (channel((under >> 8) & 255, (source >> 8) & 255) << 8) | channel(under & 255, source & 255)
            mixed = joined(under, source, cover, blended)
        } else {
            mixed = joined(under, source, cover, MODES[place].color.?(@intCast(u16, place), under, source))
        }
    }
    const held = heldBits(flags)
    return (mixed & ~held) | (under & held)
}

// ---- Rows ---------------------------------------------------------------
//
// In every loop `opacity` is 1-255, `held` the bits of the backdrop that
// stay (heldBits) and `locked` says that transparent pixels stay as they
// are.

// Normal, nothing held and no mask: the compositor's everyday row.
// Transparent stretches of the source are stepped over, opaque ones at
// full opacity stored; over an opaque backdrop a pixel is three lanes
// and two multiplications.
fn spanNormal(under: [*]u32, source: [*]const u32, count: usize, opacity: u32) -> void {
    var index: usize = 0
    while index < count {
        const top = source[index]
        const sa = top >> 24
        if sa == 0 {
            index += 1
            continue
        }
        if sa == 255 && opacity == 255 {
            under[index] = top
            index += 1
            continue
        }
        const cover = pixel.mul(sa, opacity)
        if cover != 0 {
            const before = under[index]
            const ab = before >> 24
            if ab == 255 {
                under[index] = toward(before, top, cover)
            } else if ab == 0 {
                under[index] = (cover << 24) | (top & 0x00FFFFFF)
            } else {
                under[index] = joined(before, top, cover, top)
            }
        }
        index += 1
    }
}

// A mode with a function of one channel. `quick` names the mode whose
// function is built into this copy of the loop (NORMAL: the source's
// colour itself); COUNT: the loop calls `channel`, which is not read
// otherwise.
fn spanSeparable(comptime quick: u16, channel: Channel, under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, held: u32, locked: bool) -> void {
    var index: usize = 0
    while index < count {
        const top = source[index]
        var cover = top >> 24
        if cover != 0 {
            var amount = opacity
            if mask != null { amount = pixel.mul(amount, @intCast(u32, mask.?[index])) }
            cover = pixel.mul(cover, amount)
            if cover != 0 {
                const before = under[index]
                if before >> 24 == 0 {
                    if !locked { under[index] = (((cover << 24) | (top & 0x00FFFFFF)) & ~held) | (before & held) }
                } else {
                    var blended = top
                    if comptime quick == COUNT {
                        blended = (channel((before >> 16) & 255, (top >> 16) & 255) << 16) | (channel((before >> 8) & 255, (top >> 8) & 255) << 8) | channel(before & 255, top & 255)
                    } else if comptime quick != NORMAL {
                        blended = (quickChannel(quick, (before >> 16) & 255, (top >> 16) & 255) << 16) | (quickChannel(quick, (before >> 8) & 255, (top >> 8) & 255) << 8) | quickChannel(quick, before & 255, top & 255)
                    }
                    under[index] = (joined(before, top, cover, blended) & ~held) | (before & held)
                }
            }
        }
        index += 1
    }
}

// A mode with a function of the whole colour.
fn spanColor(color: Color, mode: u16, under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, held: u32, locked: bool) -> void {
    var index: usize = 0
    while index < count {
        const top = source[index]
        var cover = top >> 24
        if cover != 0 {
            var amount = opacity
            if mask != null { amount = pixel.mul(amount, @intCast(u32, mask.?[index])) }
            cover = pixel.mul(cover, amount)
            if cover != 0 {
                const before = under[index]
                if before >> 24 == 0 {
                    if !locked { under[index] = (((cover << 24) | (top & 0x00FFFFFF)) & ~held) | (before & held) }
                } else {
                    under[index] = (joined(before, top, cover, color(mode, before, top)) & ~held) | (before & held)
                }
            }
        }
        index += 1
    }
}

// Erase.
fn spanErase(under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, held: u32) -> void {
    var index: usize = 0
    while index < count {
        var cover = source[index] >> 24
        if cover != 0 {
            var amount = opacity
            if mask != null { amount = pixel.mul(amount, @intCast(u32, mask.?[index])) }
            cover = pixel.mul(cover, amount)
            if cover != 0 {
                const before = under[index]
                const a = pixel.mul(before >> 24, 255 - cover)
                const mixed = if a == 0 { 0 } else { (before & 0x00FFFFFF) | (a << 24) }
                under[index] = (mixed & ~held) | (before & held)
            }
        }
        index += 1
    }
}

// A mode with its own rule for alpha: its function for every pixel
// with an amount, the transparent ones of the source too.
fn spanWhole(whole: Whole, under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, held: u32, locked: bool, seed: u32) -> void {
    var index: usize = 0
    while index < count {
        var amount = opacity
        if mask != null { amount = pixel.mul(amount, @intCast(u32, mask.?[index])) }
        if amount != 0 {
            const before = under[index]
            if !(locked && before >> 24 == 0) {
                const mixed = whole(before, source[index], amount, seed +% @intCast(u32, index))
                under[index] = (mixed & ~held) | (before & held)
            }
        }
        index += 1
    }
}

// `count` pixels of `source` over those at `under` in `mode`, each at
// its alpha times `opacity` (0-255) times its byte of `mask` (null:
// all of it), `flags` holding parts of the backdrop.
pub fn compositeSpan(mode: u16, under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, flags: u32) -> void {
    compositeSpanAt(mode, under, source, count, opacity, mask, flags, 0)
}

// The same for a span whose first pixel has the seed `seed` (seedAt of
// its place in the image): Dissolve then falls the same way wherever a
// row is cut into spans. The other modes do not read it.
pub fn compositeSpanAt(mode: u16, under: [*]u32, source: [*]const u32, count: usize, opacity: u32, mask: ?[*]const u8, flags: u32, seed: u32) -> void {
    if opacity == 0 || count == 0 { return }
    const amount = if opacity > 255 { 255 } else { opacity }
    const which = if mode < COUNT { mode } else { NORMAL }
    const locked = flags & FLAG_ALPHA_LOCK != 0
    const held = heldBits(flags)
    if which == NORMAL {
        if mask == null && flags == 0 {
            spanNormal(under, source, count, amount)
        } else {
            spanSeparable(NORMAL, multiplyChannel, under, source, count, amount, mask, held, locked)
        }
    } else if which == ERASE {
        if !locked { spanErase(under, source, count, amount, mask, held) }
    } else if which == MULTIPLY {
        spanSeparable(MULTIPLY, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == SCREEN {
        spanSeparable(SCREEN, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == OVERLAY {
        spanSeparable(OVERLAY, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == DARKEN {
        spanSeparable(DARKEN, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == LIGHTEN {
        spanSeparable(LIGHTEN, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == ADDITION {
        spanSeparable(ADDITION, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == DIFFERENCE {
        spanSeparable(DIFFERENCE, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == DODGE {
        spanSeparable(DODGE, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == BURN {
        spanSeparable(BURN, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == HARD_LIGHT {
        spanSeparable(HARD_LIGHT, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else if which == SOFT_LIGHT_SVG {
        spanSeparable(SOFT_LIGHT_SVG, multiplyChannel, under, source, count, amount, mask, held, locked)
    } else {
        const place = @intCast(usize, which)
        if MODES[place].channel != null {
            spanSeparable(COUNT, MODES[place].channel.?, under, source, count, amount, mask, held, locked)
        } else if MODES[place].color != null {
            spanColor(MODES[place].color.?, which, under, source, count, amount, mask, held, locked)
        } else if !(locked && which == DESTINATION_IN) {
            spanWhole(MODES[place].whole.?, under, source, count, amount, mask, held, locked, seed)
        }
    }
}
