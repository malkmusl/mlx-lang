// nebula core: working memory for pixel loops. A local array of more than
// a KiB is taken from the program's value arena each time its function
// runs (and given back only when the window's loop turns), so buffers of
// pixels never are locals: they are taken here and given back in the
// order opposite to the taking:
//
//     const mark = scratch.mark(pool)
//     const row = scratch.words(pool, width)          // [*]u32, not cleared
//     ...
//     scratch.release(pool, mark)
//
// The memory comes from the heap in blocks that are kept for the next
// taking; a pointer taken stays where it is until its release.
const std = @import("std")

pub const Allocator = std.allocator.Allocator

const BLOCKS: usize = 48
const SMALLEST: usize = 1048576

const Block = struct {
    memory: usize
    size: usize
    used: usize
}

pub const Mark = struct {
    block: usize
    used: usize
}

pub const Pool = struct {
    allocator: Allocator
    blocks: [48]Block
    count: usize
    // The block takings come from now.
    current: usize
}

pub fn init(pool: *Pool, allocator: Allocator) -> void {
    pool.*.allocator = allocator
    pool.*.count = 0
    pool.*.current = 0
}

pub fn create(allocator: Allocator) -> ?*Pool {
    const memory = allocator.alloc(@sizeOf(Pool), 16)
    if memory == null { return null }
    const pool: *Pool = unsafe { @ptrCast(*Pool, memory.?) }
    init(pool, allocator)
    return pool
}

pub fn mark(pool: *Pool) -> Mark {
    if pool.*.count == 0 { return Mark.{ .block = 0, .used = 0 } }
    return Mark.{ .block = pool.*.current, .used = pool.*.blocks[pool.*.current].used }
}

// Everything taken since `at` is free again.
pub fn release(pool: *Pool, at: Mark) -> void {
    if pool.*.count == 0 { return }
    var index = at.block + 1
    while index < pool.*.count {
        pool.*.blocks[index].used = 0
        index += 1
    }
    pool.*.blocks[at.block].used = at.used
    pool.*.current = at.block
}

// `length` bytes, aligned to 16, not cleared. Null without memory.
pub fn bytes(pool: *Pool, length: usize) -> ?[*]u8 {
    const wanted = (length + 15) & ~@intCast(usize, 15)
    var index = pool.*.current
    while index < pool.*.count {
        const block = &pool.*.blocks[index]
        if block.*.size - block.*.used >= wanted {
            const address = block.*.memory + block.*.used
            block.*.used += wanted
            pool.*.current = index
            unsafe { return @ptrFromInt([*]u8, address) }
        }
        index += 1
    }
    if pool.*.count >= BLOCKS { return null }
    var size = SMALLEST
    if pool.*.count > 0 { size = pool.*.blocks[pool.*.count - 1].size * 2 }
    if size > 67108864 { size = 67108864 }
    if size < wanted { size = wanted }
    const memory = pool.*.allocator.alloc(size, 16)
    if memory == null { return null }
    const made = &pool.*.blocks[pool.*.count]
    made.*.memory = @intFromPtr(memory.?)
    made.*.size = size
    made.*.used = wanted
    pool.*.current = pool.*.count
    pool.*.count += 1
    return memory
}

// `count` pixels (u32), not cleared. Null without memory.
pub fn words(pool: *Pool, count: usize) -> ?[*]u32 {
    const memory = bytes(pool, count * 4)
    if memory == null { return null }
    unsafe { return @ptrCast([*]u32, memory.?) }
}

// `count` doubles, not cleared.
pub fn doubles(pool: *Pool, count: usize) -> ?[*]f64 {
    const memory = bytes(pool, count * 8)
    if memory == null { return null }
    unsafe { return @ptrCast([*]f64, memory.?) }
}

// `count` i32, not cleared.
pub fn ints(pool: *Pool, count: usize) -> ?[*]i32 {
    const memory = bytes(pool, count * 4)
    if memory == null { return null }
    unsafe { return @ptrCast([*]i32, memory.?) }
}

// Gives the heap back all blocks (nothing may be taken at that time).
pub fn trim(pool: *Pool) -> void {
    var index: usize = 0
    while index < pool.*.count {
        unsafe { pool.*.allocator.free(@ptrFromInt([*]u8, pool.*.blocks[index].memory), pool.*.blocks[index].size, 16) }
        index += 1
    }
    pool.*.count = 0
    pool.*.current = 0
}

pub fn destroy(pool: *Pool) -> void {
    trim(pool)
    const allocator = pool.*.allocator
    unsafe { allocator.free(@ptrCast([*]u8, pool), @sizeOf(Pool), 16) }
}

// The program's pool (one thread paints): made at the first asking.
var shared: usize = 0

pub fn common() -> *Pool {
    if shared == 0 {
        const made = create(std.heap.allocator())
        if made != null { shared = @intFromPtr(made.?) }
    }
    unsafe { return @ptrFromInt(*Pool, shared) }
}
