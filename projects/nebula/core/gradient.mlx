// nebula core: gradients: colours along a line from 0 to 1, and the
// shapes the gradient tool lays them out in.
//
// A Gradient is a small record (under 1 KiB, copied like a number; loops
// take it by pointer) of up to 16 stops in the order of their positions.
// A stop has a position (0..1), a colour (a straight pixel) and says how
// the way to the next stop goes: where its middle is (`midpoint`, 0..1
// of the way, 0.5 even) and how it runs (`blending`: the five of GIMP's
// gradient files and a step). Instead of a colour of its own a stop may
// stand for the foreground or the background colour, opaque or
// transparent (`kind`): what it is then is decided when a colour is
// asked for. Before the first stop is the first stop's colour, after the
// last the last's; two stops at one place are a jump (the later one is
// the colour at the place itself).
//
//     var sky: gradient.Gradient = undefined
//     gradient.init(&sky, 0xFF1E5FBF, 0xFFE4F1FB)
//     _ = gradient.addStop(&sky, 0.6, 0xFF7DB9E8)
//     const middle = gradient.colorAt(&sky, 0.5, foreground, background)
//     gradient.render(&sky, gradient.LINEAR, gradient.NONE, false, true, 0.5, 0.5, 0.5, 199.5,
//         area, pixels, stride, foreground, background, 0.2)
//
// How two stops mix (`interpolation`, one for the gradient): RGB mixes
// the bytes as they are (what most programs do), LINEAR_LIGHT the light
// they stand for (no dark middle between two bright colours), HSV_CCW
// and HSV_CW go around the colour wheel, the hue rising or falling (as
// in GIMP: from red, rising is toward yellow). Everywhere alpha goes
// evenly and a colour counts by its alpha, as in pixel.mix: a
// transparent end gives no colour to the middle. (GIMP mixes the four
// channels each for itself: a file with a transparent end of another
// colour looks different there.) A grey has no hue: next to a colour it
// takes that colour's hue; two stops of one hue stay that hue (GIMP
// makes a full turn of them).
//
// Text forms. The compact one is ours, for node.Params.text and
// settings: stops parted by ';', each "position:colour" with the colour
// "#rrggbb", "#rrggbbaa" (alpha last), "fg", "bg", "fg0" or "bg0" (the
// foreground and background colours, the last two transparent), then
// "@midpoint" where it is not 0.5 and "/c", "/s", "/i", "/d" or "/t"
// where the way to the next stop is curved, a sine, spherical
// increasing, spherical decreasing or a step. Another interpolation
// than RGB comes first as a word: "linear", "hsv-cw", "hsv-ccw":
//
//     hsv-ccw;0:#ff0000;0.25:fg@0.3/s;1:#0000ff80
//
// Positions are written to four places after the point. The other form
// is GIMP's .ggr (readGgr, writeGgr), whose segments have two colours
// each: where neighbours differ there are two stops at one place. A
// file of more segments than 16 stops hold is read as 16 stops at even
// places of it (the colours there are right, the ways between them are
// straight). LINEAR_LIGHT is written to a .ggr as RGB, the format has
// no word for it.
//
// Rendering. render() makes the pixels of a rectangle of the image for
// a drag of the gradient tool from (x0, y0) to (x1, y1): each pixel's
// centre gets a value by the shape (0 at the start, 1 at the end of the
// drag), the repeat brings it to 0..1, and the colour is read from a
// table of 1024 steps baked once, mixed between two entries, at more
// than 8 bits a channel, so that `dither` (an ordered 8 x 8 pattern on
// the last rounding, fixed to the image's pixels) has something to hide
// bands with. With an `antialias_threshold` below 1 a pixel whose
// colour differs from one of its four neighbours by more than that part
// of the full range is made of 16 samples instead of one: the edges of
// a repeat, the seam and the centre of a cone, a step of the gradient.
// A pixel depends on nothing but its place: a picture rendered in
// pieces is the picture rendered at once, bit for bit. A drag without
// length (or with a number that is none) gives the end colour
// everywhere. Conical shapes turn once, a repeat changes nothing in
// them; a spiral always starts again after a turn (ALTERNATING lets it
// run there and back within the turn, so that it has no seam).
// fillDevice() is what the tool calls: the same pixels mixed into a
// layer in a blend mode, under the selection.
//
// Not done: SHAPED (the gradient following the selection's outline) is
// a number kept for it; render() treats it as LINEAR. reverse() keeps
// the place of a curved segment's middle but not its exact course.
const std = @import("std")
const math = @import("std.math")
const pixel = @import("./pixel.mlx")
const color = @import("./color.mlx")
const geom = @import("./geom.mlx")
const device_module = @import("./device.mlx")
const mask_module = @import("./mask.mlx")
const blend = @import("./blend.mlx")
const scratch = @import("./scratch.mlx")

pub const Rect = geom.Rect
pub const Device = device_module.Device

pub const MAX_STOPS: usize = 16

// How two stops mix.
pub const RGB: u8 = 0
pub const LINEAR_LIGHT: u8 = 1
pub const HSV_CW: u8 = 2
pub const HSV_CCW: u8 = 3
pub const INTERPOLATIONS: u8 = 4

// How the way from a stop to the next runs (the numbers of a .ggr).
pub const BLEND_LINEAR: u8 = 0
pub const BLEND_CURVED: u8 = 1
pub const BLEND_SINE: u8 = 2
pub const BLEND_SPHERE_INCREASING: u8 = 3
pub const BLEND_SPHERE_DECREASING: u8 = 4
pub const BLEND_STEP: u8 = 5
pub const BLENDINGS: u8 = 6

// What a stop's colour is (the numbers of a .ggr's endpoint colours).
pub const FIXED: u8 = 0
pub const FOREGROUND: u8 = 1
pub const FOREGROUND_TRANSPARENT: u8 = 2
pub const BACKGROUND: u8 = 3
pub const BACKGROUND_TRANSPARENT: u8 = 4
pub const KINDS: u8 = 5

// The gradient tool's shapes.
pub const LINEAR: u8 = 0
// Linear, mirrored about the start.
pub const BILINEAR: u8 = 1
pub const RADIAL: u8 = 2
pub const SQUARE: u8 = 3
// Around the start, from the drag's direction once around (clockwise on
// the screen), with a seam along the drag.
pub const CONICAL: u8 = 4
// Around the start to both sides: 0 along the drag, 1 opposite to it.
pub const CONICAL_SYMMETRIC: u8 = 5
pub const SPIRAL: u8 = 6
pub const REVERSE_SPIRAL: u8 = 7
// Reserved: along the selection's outline. Not done (see the header).
pub const SHAPED: u8 = 8
pub const SHAPES: u8 = 9

// What is beyond the drag's end.
pub const NONE: u8 = 0
pub const FORWARDS: u8 = 1
pub const ALTERNATING: u8 = 2
pub const REPEATS: u8 = 3

pub const Stop = struct {
    position: f64
    // Where between this stop and the next the middle of the two is.
    midpoint: f64
    color: u32
    kind: u8
    // How the way to the next stop runs.
    blending: u8
}

pub const Gradient = struct {
    stops: [16]Stop
    count: usize
    interpolation: u8
}

// A segment shorter than this has no inside (GIMP's own bound).
const EPSILON: f64 = 0.0000000001

// `value` held to 0..1; what is no number is 0.
inline fn unit(value: f64) -> f64 {
    return if !(value > 0.0) { 0.0 } else if value > 1.0 { 1.0 } else { value }
}

inline fn magnitude(value: f64) -> f64 {
    return if value < 0.0 { -value } else { value }
}

// ---------------------------------------------------------------------------
// Making and changing

fn plainStop(position: f64, value: u32, kind: u8) -> Stop {
    return Stop.{ .position = position, .midpoint = 0.5, .color = value, .kind = kind, .blending = BLEND_LINEAR }
}

// A gradient of two colours, `from` at 0 and `to` at 1, mixed as RGB.
pub fn init(gradient: *Gradient, from: u32, to: u32) -> void {
    gradient.*.count = 2
    gradient.*.interpolation = RGB
    gradient.*.stops[0] = plainStop(0.0, from, FIXED)
    gradient.*.stops[1] = plainStop(1.0, to, FIXED)
}

// `into` becomes what `from` is.
pub fn copy(from: *const Gradient, into: *Gradient) -> void {
    into.* = from.*
}

// How many stops count (a record from a file may say anything).
inline fn countOf(gradient: *const Gradient) -> usize {
    return if gradient.*.count > MAX_STOPS { MAX_STOPS } else { gradient.*.count }
}

// Whether two gradients are the same gradient, stop for stop: the stored
// colour only where the stop has one of its own, the way on only where
// there is a next stop.
pub fn same(a: *const Gradient, b: *const Gradient) -> bool {
    const count = countOf(a)
    if count != countOf(b) || a.*.interpolation != b.*.interpolation { return false }
    var index: usize = 0
    while index < count {
        const left = &a.*.stops[index]
        const right = &b.*.stops[index]
        if left.*.position != right.*.position || left.*.kind != right.*.kind { return false }
        if left.*.kind == FIXED && left.*.color != right.*.color { return false }
        // (The last stop's way leads nowhere.)
        if index + 1 < count && (left.*.midpoint != right.*.midpoint || left.*.blending != right.*.blending) { return false }
        index += 1
    }
    return true
}

// A new stop of `value` at `position` (held to 0..1), after the stops at
// or before that place; the way on from it runs as the way it cuts did.
// Its index, or null when the gradient is full.
pub fn addStop(gradient: *Gradient, position: f64, value: u32) -> ?usize {
    const count = countOf(gradient)
    if count >= MAX_STOPS { return null }
    const place = unit(position)
    var at: usize = 0
    while at < count && gradient.*.stops[at].position <= place { at += 1 }
    var index = count
    while index > at {
        gradient.*.stops[index] = gradient.*.stops[index - 1]
        index -= 1
    }
    var made = plainStop(place, value, FIXED)
    if at > 0 { made.blending = gradient.*.stops[at - 1].blending }
    gradient.*.stops[at] = made
    gradient.*.count = count + 1
    return at
}

// Takes the stop at `index` out. False (and nothing changed) for an
// index that is none and for a gradient of two stops: fewer are none.
pub fn removeStop(gradient: *Gradient, index: usize) -> bool {
    const count = countOf(gradient)
    if count <= 2 || index >= count { return false }
    var at = index
    while at + 1 < count {
        gradient.*.stops[at] = gradient.*.stops[at + 1]
        at += 1
    }
    gradient.*.count = count - 1
    return true
}

// The stop at `index` at another `position` (held to 0..1). It passes
// the stops it moves beyond, so the order holds; its index afterwards.
pub fn moveStop(gradient: *Gradient, index: usize, position: f64) -> usize {
    const count = countOf(gradient)
    if index >= count { return index }
    const place = unit(position)
    gradient.*.stops[index].position = place
    var at = index
    while at > 0 && gradient.*.stops[at - 1].position > place {
        const lower = gradient.*.stops[at - 1]
        gradient.*.stops[at - 1] = gradient.*.stops[at]
        gradient.*.stops[at] = lower
        at -= 1
    }
    while at + 1 < count && gradient.*.stops[at + 1].position < place {
        const upper = gradient.*.stops[at + 1]
        gradient.*.stops[at + 1] = gradient.*.stops[at]
        gradient.*.stops[at] = upper
        at += 1
    }
    return at
}

// The stop at `index` gets a colour of its own.
pub fn setColor(gradient: *Gradient, index: usize, value: u32) -> void {
    if index >= countOf(gradient) { return }
    gradient.*.stops[index].color = value
    gradient.*.stops[index].kind = FIXED
}

// The stop at `index` stands for the foreground or background colour
// (FOREGROUND, ...), or with FIXED has its own again.
pub fn setKind(gradient: *Gradient, index: usize, kind: u8) -> void {
    if index >= countOf(gradient) || kind >= KINDS { return }
    gradient.*.stops[index].kind = kind
}

// The gradient the other way round: what was at t is at 1 - t.
pub fn reverse(gradient: *Gradient) -> void {
    const count = countOf(gradient)
    var low: usize = 0
    while low * 2 + 1 < count {
        const high = count - 1 - low
        const kept = gradient.*.stops[low]
        gradient.*.stops[low] = gradient.*.stops[high]
        gradient.*.stops[high] = kept
        low += 1
    }
    // A way belongs to the stop it starts at: after the turn each is at
    // the stop that was its end, and runs backwards.
    var index: usize = 0
    while index < count {
        const stop = &gradient.*.stops[index]
        stop.*.position = 1.0 - stop.*.position
        if index + 1 < count {
            const next = &gradient.*.stops[index + 1]
            stop.*.midpoint = 1.0 - unit(next.*.midpoint)
            var blending = next.*.blending
            if blending == BLEND_SPHERE_INCREASING {
                blending = BLEND_SPHERE_DECREASING
            } else if blending == BLEND_SPHERE_DECREASING {
                blending = BLEND_SPHERE_INCREASING
            }
            stop.*.blending = blending
        } else {
            stop.*.midpoint = 0.5
            stop.*.blending = BLEND_LINEAR
        }
        index += 1
    }
    // The same hues are passed going the other way around.
    if gradient.*.interpolation == HSV_CW {
        gradient.*.interpolation = HSV_CCW
    } else if gradient.*.interpolation == HSV_CCW {
        gradient.*.interpolation = HSV_CW
    }
}

// ---------------------------------------------------------------------------
// The colour at a place

// The colour a stop has with these foreground and background colours.
pub fn resolved(stop: *const Stop, foreground: u32, background: u32) -> u32 {
    const kind = stop.*.kind
    if kind == FOREGROUND { return foreground }
    if kind == FOREGROUND_TRANSPARENT { return foreground & 0x00FFFFFF }
    if kind == BACKGROUND { return background }
    if kind == BACKGROUND_TRANSPARENT { return background & 0x00FFFFFF }
    return stop.*.color
}

// How far a way is at `pos` (0..1 of it) when its middle is at `middle`:
// two straight pieces that meet at (middle, 0.5).
fn linearFactor(middle: f64, pos: f64) -> f64 {
    if pos <= middle {
        if middle < EPSILON { return 0.0 }
        return 0.5 * pos / middle
    }
    const rest = 1.0 - middle
    if rest < EPSILON { return 1.0 }
    return 0.5 + 0.5 * (pos - middle) / rest
}

// The same for each way of running (GIMP's blending functions).
fn factor(blending: u8, midpoint: f64, pos: f64) -> f64 {
    const middle = if midpoint != midpoint { 0.5 } else { unit(midpoint) }
    if blending == BLEND_CURVED {
        // A power through (middle, 0.5).
        if middle < EPSILON { return 1.0 }
        if 1.0 - middle < EPSILON { return 0.0 }
        if !(pos > 0.0) { return 0.0 }
        return unit(math.pow(pos, math.ln(0.5) / math.ln(middle)))
    }
    if blending == BLEND_STEP { return if pos >= middle { 1.0 } else { 0.0 } }
    const even = linearFactor(middle, pos)
    if blending == BLEND_SINE { return unit((math.sin(math.pi * (even - 0.5)) + 1.0) * 0.5) }
    if blending == BLEND_SPHERE_INCREASING { return math.sqrt(1.0 - (even - 1.0) * (even - 1.0)) }
    if blending == BLEND_SPHERE_DECREASING { return 1.0 - math.sqrt(1.0 - even * even) }
    return even
}

// `left` (f = 0) to `right` (f = 1) as channels of 0..255.
fn mixed(interpolation: u8, left: u32, right: u32, f: f64, r: *f64, g: *f64, b: *f64, a: *f64) -> void {
    const left_alpha = @floatFromInt(f64, left >> 24)
    const right_alpha = @floatFromInt(f64, right >> 24)
    a.* = left_alpha + (right_alpha - left_alpha) * f
    // Each colour counts by its alpha. Where neither has any the colours
    // mix evenly: nothing shows of it, but who mixes on from here (the
    // table's neighbours) finds a colour that belongs here.
    var left_share = left_alpha * (1.0 - f)
    var right_share = right_alpha * f
    if !(left_share + right_share > 0.0) {
        left_share = 1.0 - f
        right_share = f
    }
    const total = left_share + right_share
    left_share = left_share / total
    right_share = right_share / total
    if interpolation == LINEAR_LIGHT {
        r.* = 255.0 * color.linearToSrgb(color.linear8(pixel.red(left)) * left_share + color.linear8(pixel.red(right)) * right_share)
        g.* = 255.0 * color.linearToSrgb(color.linear8(pixel.green(left)) * left_share + color.linear8(pixel.green(right)) * right_share)
        b.* = 255.0 * color.linearToSrgb(color.linear8(pixel.blue(left)) * left_share + color.linear8(pixel.blue(right)) * right_share)
        return
    }
    if interpolation == HSV_CW || interpolation == HSV_CCW {
        // A transparent end has no colour to turn from: the way is all
        // the other end's.
        var from = left
        var to = right
        if left_alpha <= 0.0 && right_alpha > 0.0 { from = right }
        if right_alpha <= 0.0 && left_alpha > 0.0 { to = left }
        var h0: f64 = 0.0
        var s0: f64 = 0.0
        var v0: f64 = 0.0
        var h1: f64 = 0.0
        var s1: f64 = 0.0
        var v1: f64 = 0.0
        color.toHsv(from, &h0, &s0, &v0)
        color.toHsv(to, &h1, &s1, &v1)
        if s0 <= 0.0 {
            h0 = h1
        } else if s1 <= 0.0 {
            h1 = h0
        }
        var hue = h0
        if interpolation == HSV_CCW {
            var turn = h1 - h0
            if turn < 0.0 { turn += 1.0 }
            hue = h0 + turn * f
        } else {
            var turn = h0 - h1
            if turn < 0.0 { turn += 1.0 }
            hue = h0 - turn * f
        }
        color.hsvToRgb(hue, s0 + (s1 - s0) * f, v0 + (v1 - v0) * f, r, g, b)
        r.* = r.* * 255.0
        g.* = g.* * 255.0
        b.* = b.* * 255.0
        return
    }
    r.* = @floatFromInt(f64, pixel.red(left)) * left_share + @floatFromInt(f64, pixel.red(right)) * right_share
    g.* = @floatFromInt(f64, pixel.green(left)) * left_share + @floatFromInt(f64, pixel.green(right)) * right_share
    b.* = @floatFromInt(f64, pixel.blue(left)) * left_share + @floatFromInt(f64, pixel.blue(right)) * right_share
}

// The gradient at `at` (held to 0..1) as channels of 0..255.
fn evaluate(gradient: *const Gradient, at: f64, foreground: u32, background: u32, r: *f64, g: *f64, b: *f64, a: *f64) -> void {
    const count = countOf(gradient)
    r.* = 0.0
    g.* = 0.0
    b.* = 0.0
    a.* = 0.0
    if count == 0 { return }
    const t = unit(at)
    // The last stop at or before the place.
    var index: usize = 0
    var scan: usize = 0
    while scan < count && gradient.*.stops[scan].position <= t {
        index = scan
        scan += 1
    }
    const left = &gradient.*.stops[index]
    var whole = resolved(left, foreground, background)
    if scan > 0 && index + 1 < count {
        const right = &gradient.*.stops[index + 1]
        const span = right.*.position - left.*.position
        if span > 0.0 {
            const f = factor(left.*.blending, left.*.midpoint, (t - left.*.position) / span)
            mixed(gradient.*.interpolation, whole, resolved(right, foreground, background), f, r, g, b, a)
            return
        }
        whole = resolved(right, foreground, background)
    }
    r.* = @floatFromInt(f64, pixel.red(whole))
    g.* = @floatFromInt(f64, pixel.green(whole))
    b.* = @floatFromInt(f64, pixel.blue(whole))
    a.* = @floatFromInt(f64, whole >> 24)
}

inline fn byteOf(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 255.0 { return 255 }
    return @intFromFloat(u32, value + 0.5)
}

// The gradient's colour at `t` (held to 0..1; what is no number is 0)
// with these foreground and background colours for the stops that stand
// for them. A place that ends transparent is 0.
pub fn colorAt(gradient: *const Gradient, t: f64, foreground: u32, background: u32) -> u32 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var a: f64 = 0.0
    evaluate(gradient, t, foreground, background, &r, &g, &b, &a)
    const alpha = byteOf(a)
    if alpha == 0 { return 0 }
    return pixel.pack(alpha, byteOf(r), byteOf(g), byteOf(b))
}

// `count` colours into `into`, the gradient from 0 (the first) to 1 (the
// last) at even places: into[i] is colorAt(i / (count - 1)).
pub fn bake(gradient: *const Gradient, into: [*]u32, count: usize, foreground: u32, background: u32) -> void {
    if count == 1 { into[0] = colorAt(gradient, 0.0, foreground, background) }
    if count < 2 { return }
    const last = @floatFromInt(f64, count - 1)
    var index: usize = 0
    while index < count {
        into[index] = colorAt(gradient, @floatFromInt(f64, index) / last, foreground, background)
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Colours at more than 8 bits: what dithering rounds.

// A channel of 0..255 as 256ths of a step.
inline fn fineOf(value: f64) -> u64 {
    if !(value > 0.0) { return 0 }
    if value >= 255.0 { return 65280 }
    return @intFromFloat(u64, value * 256.0 + 0.5)
}

// The gradient's colour at `t` with each channel in 256ths of a step of
// 0-255, alpha, red, green and blue in 16 bits each from the top: what
// rounded() and dithered() make a pixel of. The colour of a transparent
// place is kept here (whoever mixes two of these wants it).
pub fn fineAt(gradient: *const Gradient, t: f64, foreground: u32, background: u32) -> u64 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var a: f64 = 0.0
    evaluate(gradient, t, foreground, background, &r, &g, &b, &a)
    return (fineOf(a) << 48) | (fineOf(r) << 32) | (fineOf(g) << 16) | fineOf(b)
}

// The bytes of a fine colour, each channel rounded up from `bias` 256ths
// below the next step (128: to the nearest).
inline fn narrowed(fine: u64, bias: u64) -> u32 {
    const a = ((fine >> 48) + bias) >> 8
    if a == 0 { return 0 }
    const r = (((fine >> 32) & 0xFFFF) + bias) >> 8
    const g = (((fine >> 16) & 0xFFFF) + bias) >> 8
    const b = ((fine & 0xFFFF) + bias) >> 8
    return @intCast(u32, (a << 24) | (r << 16) | (g << 8) | b)
}

// The pixel of a fine colour, each channel to the nearest byte.
pub fn rounded(fine: u64) -> u32 {
    return narrowed(fine, 128)
}

// The 8 x 8 ordered pattern: each of 0..63 once, spread as evenly as 64
// places allow. A row is one word, its columns the bytes from the lowest
// (a pixel loop then needs no table but a shift):
//
//      0 32  8 40  2 34 10 42
//     48 16 56 24 50 18 58 26
//     12 44  4 36 14 46  6 38
//     60 28 52 20 62 30 54 22
//      3 35 11 43  1 33  9 41
//     51 19 59 27 49 17 57 25
//     15 47  7 39 13 45  5 37
//     63 31 55 23 61 29 53 21
const BAYER_ROWS = [8]u64{
    0x2A0A220228082000,
    0x1A3A123218381030,
    0x26062E0E24042C0C,
    0x16361E3E14341C3C,
    0x290921012B0B2303,
    0x193911311B3B1333,
    0x25052D0D27072F0F,
    0x15351D3D17371F3F,
}

// Where the pattern rounds at the image's pixel (x, y): 1 to 127 of 128.
inline fn bayerAt(x: i32, y: i32) -> u64 {
    const row = BAYER_ROWS[@intCast(usize, y & 7)]
    return ((row >> (@intCast(u64, x & 7) * 8)) & 255) * 2 + 1
}

// The pixel of a fine colour at the image's pixel (x, y), rounded up or
// down by the ordered pattern: over an area the mean is the fine colour.
// At most one step from rounded(); a whole step stays as it is.
pub fn dithered(fine: u64, x: i32, y: i32) -> u32 {
    return narrowed(fine, bayerAt(x, y) * 2)
}

// The table render() reads: FINE_STEPS + 2 fine colours, the gradient
// from 0 (entry 0) to 1 (entry FINE_STEPS) and that one once more.
pub const FINE_STEPS: usize = 1024
pub const FINE_ENTRIES: usize = 1026

// One over the steps, and the steps as 16.16 fixed point.
const FINE_SCALE: f64 = 67108864.0

// Fills `into` (FINE_ENTRIES words) for renderBaked().
pub fn bakeFine(gradient: *const Gradient, into: [*]u64, foreground: u32, background: u32) -> void {
    var index: usize = 0
    while index <= FINE_STEPS {
        into[index] = fineAt(gradient, @floatFromInt(f64, index) / 1024.0, foreground, background)
        index += 1
    }
    into[FINE_STEPS + 1] = into[FINE_STEPS]
}

// The table's colour at `t` (0..1, nothing else), mixed between the two
// entries around it; each channel rounded up from `bias` (of 2^24)
// below the next step.
inline fn lookup(table: [*]const u64, t: f64, bias: u64) -> u32 {
    const place = @intFromFloat(u64, t * FINE_SCALE)
    const index = @intCast(usize, place >> 16)
    const right = place & 0xFFFF
    const left = 65536 - right
    const low = table[index]
    const high = table[index + 1]
    // (16 bits times 17 bits, twice, and a bias below 2^24: no sum here
    // reaches 2^33.)
    const a = ((low >> 48) *% left +% (high >> 48) *% right +% bias) >> 24
    if a == 0 { return 0 }
    const r = (((low >> 32) & 0xFFFF) *% left +% ((high >> 32) & 0xFFFF) *% right +% bias) >> 24
    const g = (((low >> 16) & 0xFFFF) *% left +% ((high >> 16) & 0xFFFF) *% right +% bias) >> 24
    const b = ((low & 0xFFFF) *% left +% (high & 0xFFFF) *% right +% bias) >> 24
    return @intCast(u32, (a << 24) | (r << 16) | (g << 8) | b)
}

const NEAREST: u64 = 8388608

// ---------------------------------------------------------------------------
// The shapes

// How a shape's value comes to 0..1.
const FOLD_CLAMP: u8 = 0
const FOLD_WRAP: u8 = 1
const FOLD_MIRROR: u8 = 2
const FOLD_TRIANGLE: u8 = 3

const Setup = struct {
    shape: u8
    fold: u8
    reverse: bool
    // No drag to speak of: the end colour everywhere.
    flat: bool
    x0: f64
    y0: f64
    // The drag's direction (length 1) and one over its length.
    ux: f64
    uy: f64
    inverse: f64
}

fn prepare(setup: *Setup, shape: u8, repeat: u8, reverse_it: bool, x0: f64, y0: f64, x1: f64, y1: f64) -> void {
    setup.*.shape = if shape >= SHAPED { LINEAR } else { shape }
    setup.*.reverse = reverse_it
    setup.*.x0 = x0
    setup.*.y0 = y0
    const conical = shape == CONICAL || shape == CONICAL_SYMMETRIC
    const spiral = shape == SPIRAL || shape == REVERSE_SPIRAL
    if spiral {
        setup.*.fold = if repeat == ALTERNATING { FOLD_TRIANGLE } else { FOLD_WRAP }
    } else if conical || repeat == NONE || repeat >= REPEATS {
        setup.*.fold = FOLD_CLAMP
    } else if repeat == FORWARDS {
        setup.*.fold = FOLD_WRAP
    } else {
        setup.*.fold = FOLD_MIRROR
    }
    const dx = x1 - x0
    const dy = y1 - y0
    const length = @sqrt(dx * dx + dy * dy)
    // (A number that is none, or without end, fails one of these.)
    const usable = length > 0.000000001 && length < 1000000000000.0 && x0 - x0 == 0.0 && y0 - y0 == 0.0
    setup.*.flat = !usable
    setup.*.ux = 1.0
    setup.*.uy = 0.0
    setup.*.inverse = 1.0
    if usable {
        setup.*.ux = dx / length
        setup.*.uy = dy / length
        setup.*.inverse = 1.0 / length
    }
}

// The shape's value at a point: 0 at the start of the drag, 1 at its
// end (for the shapes that turn: after a whole turn).
fn raw(setup: *const Setup, px: f64, py: f64) -> f64 {
    const shape = setup.*.shape
    const dx = px - setup.*.x0
    const dy = py - setup.*.y0
    const along = (dx * setup.*.ux + dy * setup.*.uy) * setup.*.inverse
    if shape == LINEAR { return along }
    if shape == BILINEAR { return magnitude(along) }
    const radius = @sqrt(dx * dx + dy * dy) * setup.*.inverse
    if shape == RADIAL { return radius }
    const across = (dy * setup.*.ux - dx * setup.*.uy) * setup.*.inverse
    if shape == SQUARE {
        const a = magnitude(along)
        const c = magnitude(across)
        return if a > c { a } else { c }
    }
    // Parts of a turn from the drag's direction: -0.5 to 0.5.
    const turn = math.atan2(across, along) / math.tau
    if shape == CONICAL_SYMMETRIC { return magnitude(turn) * 2.0 }
    const around = if turn < 0.0 { turn + 1.0 } else { turn }
    if shape == CONICAL { return around }
    if shape == SPIRAL { return radius + around }
    return radius - around
}

// A shape's value as a place of the gradient.
fn folded(setup: *const Setup, value: f64) -> f64 {
    const fold = setup.*.fold
    var t = value
    if fold != FOLD_CLAMP {
        const whole = @floor(value)
        t = value - whole
        if fold == FOLD_MIRROR {
            const half = whole * 0.5
            if half != @floor(half) { t = 1.0 - t }
        } else if fold == FOLD_TRIANGLE {
            t = 1.0 - magnitude(2.0 * t - 1.0)
        }
    }
    t = unit(t)
    return if setup.*.reverse { 1.0 - t } else { t }
}

// The place of the gradient (0..1) the tool's options give the point
// (px, py) of the image: what render() looks up for the pixel whose
// centre the point is.
pub fn valueAt(shape: u8, repeat: u8, reverse_it: bool, x0: f64, y0: f64, x1: f64, y1: f64, px: f64, py: f64) -> f64 {
    var setup: Setup = undefined
    prepare(&setup, shape, repeat, reverse_it, x0, y0, x1, y1)
    if setup.flat { return if reverse_it { 0.0 } else { 1.0 } }
    return folded(&setup, raw(&setup, px, py))
}

// The places of the gradient for `count` pixels of row `y` from column
// `x` on (their centres).
fn valuesRow(setup: *const Setup, y: i32, x: i32, count: usize, into: [*]f64) -> void {
    const shape = setup.*.shape
    const py = @floatFromInt(f64, y) + 0.5
    const first = @floatFromInt(f64, x)
    var index: usize = 0
    if shape == LINEAR || shape == BILINEAR {
        // One multiplication and one addition a pixel; what the row
        // adds is the same for all of it.
        const step = setup.*.ux * setup.*.inverse
        const base = (0.5 - setup.*.x0) * step + (py - setup.*.y0) * setup.*.uy * setup.*.inverse
        while index < count {
            into[index] = (first + @floatFromInt(f64, index)) * step + base
            index += 1
        }
        if shape == BILINEAR {
            index = 0
            while index < count {
                into[index] = magnitude(into[index])
                index += 1
            }
        }
    } else if shape == RADIAL {
        const dy = py - setup.*.y0
        const dy2 = dy * dy
        const start = 0.5 - setup.*.x0
        const inverse = setup.*.inverse
        while index < count {
            const dx = first + @floatFromInt(f64, index) + start
            into[index] = @sqrt(dx * dx + dy2) * inverse
            index += 1
        }
    } else {
        while index < count {
            into[index] = raw(setup, first + @floatFromInt(f64, index) + 0.5, py)
            index += 1
        }
    }
    const fold = setup.*.fold
    index = 0
    if fold == FOLD_CLAMP {
        while index < count {
            into[index] = unit(into[index])
            index += 1
        }
    } else if fold == FOLD_WRAP {
        while index < count {
            const value = into[index]
            into[index] = unit(value - @floor(value))
            index += 1
        }
    } else {
        while index < count {
            into[index] = folded(setup, into[index])
            index += 1
        }
        return
    }
    if setup.*.reverse {
        index = 0
        while index < count {
            into[index] = 1.0 - into[index]
            index += 1
        }
    }
}

// The pixels of `count` places of the gradient; `x`, `y` is the first
// one's pixel (the ordered pattern is fixed to the image).
fn colorsRow(table: [*]const u64, values: [*]const f64, count: usize, into: [*]u32, dither: bool, x: i32, y: i32) -> void {
    var index: usize = 0
    if dither {
        const row = BAYER_ROWS[@intCast(usize, y & 7)]
        // (Columns count on from the first one's place in the pattern.)
        const phase = @intCast(u64, x & 7)
        while index < count {
            const column = (phase + index) & 7
            const bias = (((row >> (column * 8)) & 255) * 2 + 1) << 17
            into[index] = lookup(table, values[index], bias)
            index += 1
        }
    } else {
        while index < count {
            into[index] = lookup(table, values[index], NEAREST)
            index += 1
        }
    }
}

inline fn gap(a: u32, b: u32) -> u32 {
    return if a > b { a - b } else { b - a }
}

// The largest difference of a channel of two pixels, alpha included.
inline fn apart(a: u32, b: u32) -> u32 {
    if a == b { return 0 }
    const alphas = gap(a >> 24, b >> 24)
    const reds = gap((a >> 16) & 255, (b >> 16) & 255)
    const greens = gap((a >> 8) & 255, (b >> 8) & 255)
    const blues = gap(a & 255, b & 255)
    const more = if alphas > reds { alphas } else { reds }
    const most = if greens > blues { greens } else { blues }
    return if more > most { more } else { most }
}

// The pixel (x, y) as the mean of 4 x 4 samples in it, each colour
// counting by its alpha.
fn sampled(setup: *const Setup, table: [*]const u64, x: i32, y: i32) -> u32 {
    const left = @floatFromInt(f64, x)
    const top = @floatFromInt(f64, y)
    var alpha: u32 = 0
    var red: u32 = 0
    var green: u32 = 0
    var blue: u32 = 0
    var row: u32 = 0
    while row < 4 {
        const py = top + (@floatFromInt(f64, row) + 0.5) * 0.25
        var column: u32 = 0
        while column < 4 {
            const px = left + (@floatFromInt(f64, column) + 0.5) * 0.25
            const sample = lookup(table, folded(setup, raw(setup, px, py)), NEAREST)
            const a = sample >> 24
            alpha += a
            red += ((sample >> 16) & 255) * a
            green += ((sample >> 8) & 255) * a
            blue += (sample & 255) * a
            column += 1
        }
        row += 1
    }
    const a = (alpha + 8) / 16
    if a == 0 { return 0 }
    const half = alpha / 2
    return pixel.pack(a, (red + half) / alpha, (green + half) / alpha, (blue + half) / alpha)
}

// One colour over the whole of `area`.
fn flood(area: Rect, into: [*]u32, stride: usize, value: u32) -> void {
    const width = @intCast(usize, area.width)
    var row: usize = 0
    while row < @intCast(usize, area.height) {
        device_module.fillWords(into + row * stride, width, value)
        row += 1
    }
}

// The pixels of `area` (the image's coordinates) into `into`, `stride`
// words a row, from a table bakeFine() filled: the drag went from
// (x0, y0) to (x1, y1), `shape` and `repeat` say how the gradient lies
// along it, `reverse_it` turns it round, `dither` rounds by the ordered
// pattern, and with `antialias_threshold` below 1 the pixels that differ
// from a neighbour by more than that part of the full range are made of
// 16 samples. Without working memory the pixels are transparent.
pub fn renderBaked(table: [*]const u64, shape: u8, repeat: u8, reverse_it: bool, dither: bool, x0: f64, y0: f64, x1: f64, y1: f64, area: Rect, into: [*]u32, stride: usize, antialias_threshold: f64) -> void {
    if geom.isEmpty(area) { return }
    var setup: Setup = undefined
    prepare(&setup, shape, repeat, reverse_it, x0, y0, x1, y1)
    if setup.flat {
        flood(area, into, stride, lookup(table, if reverse_it { 0.0 } else { 1.0 }, NEAREST))
        return
    }
    const width = @intCast(usize, area.width)
    const height = @intCast(usize, area.height)
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    if !(antialias_threshold < 1.0) {
        const values = scratch.doubles(pool, width)
        if values == null {
            flood(area, into, stride, 0)
        } else {
            var row: usize = 0
            while row < height {
                const y = area.y + @intCast(i32, row)
                valuesRow(&setup, y, area.x, width, values.?)
                colorsRow(table, values.?, width, into + row * stride, dither, area.x, y)
                row += 1
            }
        }
        scratch.release(pool, mark)
        return
    }
    // Three rows of places and of colours, each a pixel wider than the
    // area on both sides: the row being made, the one above and the one
    // below it. What is outside the area is worked out all the same, so
    // a pixel at the area's edge is judged as one in its middle.
    const wide = width + 2
    const values = scratch.doubles(pool, wide * 3)
    const colors = scratch.words(pool, wide * 3)
    if values == null || colors == null {
        flood(area, into, stride, 0)
        scratch.release(pool, mark)
        return
    }
    const limit = if antialias_threshold > 0.0 { @intFromFloat(u32, antialias_threshold * 255.0) } else { 0 }
    // Which third holds the row above, the row itself and the row below.
    var above: usize = 0
    var here: usize = 1
    var below: usize = 2
    valuesRow(&setup, area.y -% 1, area.x -% 1, wide, values.? + above * wide)
    colorsRow(table, values.? + above * wide, wide, colors.? + above * wide, false, 0, 0)
    valuesRow(&setup, area.y, area.x -% 1, wide, values.? + here * wide)
    colorsRow(table, values.? + here * wide, wide, colors.? + here * wide, false, 0, 0)
    var row: usize = 0
    while row < height {
        const y = area.y + @intCast(i32, row)
        valuesRow(&setup, y +% 1, area.x -% 1, wide, values.? + below * wide)
        colorsRow(table, values.? + below * wide, wide, colors.? + below * wide, false, 0, 0)
        const up = colors.? + above * wide
        const line = colors.? + here * wide
        const down = colors.? + below * wide
        const places = values.? + here * wide
        const target = into + row * stride
        var index: usize = 0
        while index < width {
            const own = line[index + 1]
            var most = apart(own, line[index])
            const right = apart(own, line[index + 2])
            if right > most { most = right }
            const upper = apart(own, up[index + 1])
            if upper > most { most = upper }
            const lower = apart(own, down[index + 1])
            if lower > most { most = lower }
            const x = area.x + @intCast(i32, index)
            if most > limit {
                target[index] = sampled(&setup, table, x, y)
            } else if dither {
                target[index] = lookup(table, places[index + 1], bayerAt(x, y) << 17)
            } else {
                target[index] = own
            }
            index += 1
        }
        const freed = above
        above = here
        here = below
        below = freed
        row += 1
    }
    scratch.release(pool, mark)
}

// The gradient tool's picture: the pixels of `area` into `into` (see
// renderBaked for the options; `foreground` and `background` are what
// the stops that stand for them become).
pub fn render(gradient: *const Gradient, shape: u8, repeat: u8, reverse_it: bool, dither: bool, x0: f64, y0: f64, x1: f64, y1: f64, area: Rect, into: [*]u32, stride: usize, foreground: u32, background: u32, antialias_threshold: f64) -> void {
    if geom.isEmpty(area) { return }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const memory = scratch.bytes(pool, FINE_ENTRIES * 8)
    if memory == null {
        flood(area, into, stride, 0)
    } else {
        const table: [*]u64 = unsafe { @ptrCast([*]u64, memory.?) }
        bakeFine(gradient, table, foreground, background)
        renderBaked(table, shape, repeat, reverse_it, dither, x0, y0, x1, y1, area, into, stride, antialias_threshold)
    }
    scratch.release(pool, mark)
}

fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }

// Lays the gradient over `area` of `target` in blend mode `mode`
// (core/blend.mlx) at `opacity` (0-255), each pixel as much as
// `selection` says (null: everywhere), `flags` holding parts of the
// layer (blend.FLAG_ALPHA_LOCK, ...). The other options are render()'s.
// Tiles the selection leaves out are not touched. The caller brackets it
// with device.begin() and commit(). False when memory ran out (some of
// it may be done then).
pub fn fillDevice(target: *Device, selection: ?*Device, area: Rect, gradient: *const Gradient, shape: u8, repeat: u8, reverse_it: bool, dither: bool, x0: f64, y0: f64, x1: f64, y1: f64, foreground: u32, background: u32, antialias_threshold: f64, mode: u16, opacity: u32, flags: u32) -> bool {
    var bounds = area
    if selection != null && !mask_module.reachesEverywhere(selection.?) {
        bounds = geom.intersect(area, mask_module.bounds(selection.?))
    }
    if geom.isEmpty(bounds) || opacity == 0 { return true }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const memory = scratch.bytes(pool, FINE_ENTRIES * 8)
    const source = scratch.words(pool, device_module.TILE_PIXELS)
    const under = scratch.words(pool, device_module.TILE_PIXELS)
    const amounts = scratch.bytes(pool, device_module.TILE_PIXELS)
    if memory == null || source == null || under == null || amounts == null {
        scratch.release(pool, mark)
        return false
    }
    const table: [*]u64 = unsafe { @ptrCast([*]u64, memory.?) }
    bakeFine(gradient, table, foreground, background)
    var whole = true
    // Tile by tile of the layer, so that each is read and written once.
    const left = bounds.x - target.*.x
    const top = bounds.y - target.*.y
    const right = left + bounds.width
    const bottom = top + bounds.height
    var ty = top >> 6
    while ty <= (bottom - 1) >> 6 {
        const row0 = larger(top, ty * 64)
        const row1 = smaller(bottom, ty * 64 + 64)
        var tx = left >> 6
        while tx <= (right - 1) >> 6 {
            const col0 = larger(left, tx * 64)
            const col1 = smaller(right, tx * 64 + 64)
            const piece = geom.rect(col0 + target.*.x, row0 + target.*.y, col1 - col0, row1 - row0)
            const width = @intCast(usize, piece.width)
            const height = @intCast(usize, piece.height)
            var wanted = true
            if selection != null {
                mask_module.readBytes(selection.?, piece, amounts.?, width)
                wanted = false
                var index: usize = 0
                while index < width * height {
                    if amounts.?[index] != 0 {
                        wanted = true
                        break
                    }
                    index += 1
                }
            }
            if wanted {
                renderBaked(table, shape, repeat, reverse_it, dither, x0, y0, x1, y1, piece, source.?, width, antialias_threshold)
                device_module.readRect(target, piece, under.?, width)
                var row: usize = 0
                while row < height {
                    var line: ?[*]const u8 = null
                    if selection != null { line = amounts.? + row * width }
                    blend.compositeSpanAt(mode, under.? + row * width, source.? + row * width, width, opacity, line, flags, blend.seedAt(piece.x, piece.y + @intCast(i32, row)))
                    row += 1
                }
                if !device_module.writeRect(target, piece, under.?, width) { whole = false }
            }
            tx += 1
        }
        ty += 1
    }
    scratch.release(pool, mark)
    return whole
}

// ---------------------------------------------------------------------------
// Text: what both forms share

fn put(into: [*]u8, at: usize, capacity: usize, text: []const u8) -> usize {
    var length = at
    for byte in text {
        if length < capacity { into[length] = byte }
        length += 1
    }
    return length
}

fn putByte(into: [*]u8, at: usize, capacity: usize, byte: u8) -> usize {
    if at < capacity { into[at] = byte }
    return at + 1
}

fn putDigits(into: [*]u8, at: usize, capacity: usize, value: u64, least: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var left = value
    while left > 0 || count < least || count == 0 {
        digits[count] = @intCast(u8, 48 + left % 10)
        left = left / 10
        count += 1
        if count == 20 { break }
    }
    var length = at
    while count > 0 {
        count -= 1
        length = putByte(into, length, capacity, digits[count])
    }
    return length
}

// `value` (not below 0) with `places` digits after the point; with
// `short` the zeros at the end, and a point with nothing after it, are
// left out ("0.5", "1").
fn putNumber(into: [*]u8, at: usize, capacity: usize, value: f64, places: usize, short: bool) -> usize {
    var scale: u64 = 1
    var index: usize = 0
    while index < places {
        scale *= 10
        index += 1
    }
    const held = if !(value > 0.0) { 0.0 } else if value > 1000000.0 { 1000000.0 } else { value }
    const scaled = @intFromFloat(u64, held * @floatFromInt(f64, scale) + 0.5)
    var length = putDigits(into, at, capacity, scaled / scale, 1)
    var part = scaled % scale
    var digits = places
    if short {
        while digits > 0 && part % 10 == 0 {
            part = part / 10
            digits -= 1
        }
    }
    if digits == 0 { return length }
    length = putByte(into, length, capacity, 46)
    return putDigits(into, length, capacity, part, digits)
}

inline fn isBlank(byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 13
}

inline fn isDigit(byte: u8) -> bool {
    return byte >= 48 && byte <= 57
}

fn skipBlanks(text: []const u8, from: usize) -> usize {
    var at = from
    while at < text.length && isBlank(text[at]) { at += 1 }
    return at
}

// Reads a number in decimal at `at` ("0.25", "-1", ".5", "2e-3") and
// moves `at` past it. False (and `at` as it was) when there is none.
fn readNumber(text: []const u8, at: *usize, value: *f64) -> bool {
    var index = at.*
    var negative = false
    if index < text.length && (text[index] == 45 || text[index] == 43) {
        negative = text[index] == 45
        index += 1
    }
    var mantissa: f64 = 0.0
    var divisor: f64 = 1.0
    var digits: usize = 0
    while index < text.length && isDigit(text[index]) {
        mantissa = mantissa * 10.0 + @floatFromInt(f64, text[index] - 48)
        digits += 1
        index += 1
    }
    if index < text.length && text[index] == 46 {
        index += 1
        while index < text.length && isDigit(text[index]) {
            // (Digits beyond what a double holds change nothing.)
            if divisor < 1000000000000000000.0 {
                mantissa = mantissa * 10.0 + @floatFromInt(f64, text[index] - 48)
                divisor *= 10.0
            }
            digits += 1
            index += 1
        }
    }
    if digits == 0 { return false }
    var result = mantissa / divisor
    if index < text.length && (text[index] == 101 || text[index] == 69) {
        var mark = index + 1
        var down = false
        if mark < text.length && (text[mark] == 45 || text[mark] == 43) {
            down = text[mark] == 45
            mark += 1
        }
        if mark < text.length && isDigit(text[mark]) {
            var exponent: usize = 0
            while mark < text.length && isDigit(text[mark]) {
                if exponent < 400 { exponent = exponent * 10 + @intCast(usize, text[mark] - 48) }
                mark += 1
            }
            while exponent > 0 {
                result = if down { result / 10.0 } else { result * 10.0 }
                exponent -= 1
            }
            index = mark
        }
    }
    value.* = if negative { -result } else { result }
    at.* = index
    return true
}

fn sameWord(text: []const u8, word: []const u8) -> bool {
    if text.length != word.length { return false }
    var index: usize = 0
    while index < text.length {
        const byte = if text[index] >= 65 && text[index] <= 90 { text[index] + 32 } else { text[index] }
        if byte != word[index] { return false }
        index += 1
    }
    return true
}

// The stops in the order of their positions; stops at one place stay in
// the order they came in.
fn sortStops(gradient: *Gradient) -> void {
    var index: usize = 1
    while index < gradient.*.count {
        const moving = gradient.*.stops[index]
        var at = index
        while at > 0 && gradient.*.stops[at - 1].position > moving.position {
            gradient.*.stops[at] = gradient.*.stops[at - 1]
            at -= 1
        }
        gradient.*.stops[at] = moving
        index += 1
    }
}

// ---------------------------------------------------------------------------
// The compact form

const INTERPOLATION_WORDS = [4][]const u8{ "rgb", "linear", "hsv-cw", "hsv-ccw" }
const KIND_WORDS = [5][]const u8{ "", "fg", "fg0", "bg", "bg0" }
// 'l', 'c', 's', 'i', 'd', 't'.
const BLENDING_LETTERS = [6]u8{ 108, 99, 115, 105, 100, 116 }

// What a stop that stands for a colour holds in its own colour (shown
// where no foreground or background is at hand).
fn stand(kind: u8) -> u32 {
    if kind == FOREGROUND { return pixel.BLACK }
    if kind == FOREGROUND_TRANSPARENT { return 0x00000000 }
    if kind == BACKGROUND { return pixel.WHITE }
    return 0x00FFFFFF
}

// One "position:colour[@midpoint][/letter]".
fn parseStop(item: []const u8, stop: *Stop) -> bool {
    var at = skipBlanks(item, 0)
    var position: f64 = 0.0
    if !readNumber(item, &at, &position) { return false }
    at = skipBlanks(item, at)
    if at >= item.length || item[at] != 58 { return false }
    at = skipBlanks(item, at + 1)
    var end = at
    while end < item.length && item[end] != 64 && item[end] != 47 && !isBlank(item[end]) { end += 1 }
    const word = item[at..end]
    stop.* = plainStop(unit(position), 0, FIXED)
    if word.length > 0 && word[0] == 35 {
        const digits = word[1..]
        if digits.length != 6 && digits.length != 8 { return false }
        var value: u32 = 0
        for digit in digits {
            const nibble = std.text.hexValue(digit)
            if nibble > 15 { return false }
            value = (value << 4) | @intCast(u32, nibble)
        }
        // The text has alpha last, a pixel has it first.
        stop.*.color = if digits.length == 6 { 0xFF000000 | value } else { (value >> 8) | ((value & 255) << 24) }
    } else {
        var kind: u8 = 1
        while kind < KINDS && !sameWord(word, KIND_WORDS[@intCast(usize, kind)]) { kind += 1 }
        if kind >= KINDS { return false }
        stop.*.kind = kind
        stop.*.color = stand(kind)
    }
    at = skipBlanks(item, end)
    if at < item.length && item[at] == 64 {
        at += 1
        var midpoint: f64 = 0.5
        if !readNumber(item, &at, &midpoint) { return false }
        stop.*.midpoint = unit(midpoint)
        at = skipBlanks(item, at)
    }
    if at < item.length && item[at] == 47 {
        if at + 1 >= item.length { return false }
        const letter = if item[at + 1] >= 65 && item[at + 1] <= 90 { item[at + 1] + 32 } else { item[at + 1] }
        var blending: u8 = 0
        while blending < BLENDINGS && BLENDING_LETTERS[@intCast(usize, blending)] != letter { blending += 1 }
        if blending >= BLENDINGS { return false }
        stop.*.blending = blending
        at = skipBlanks(item, at + 2)
    }
    return at == item.length
}

// Reads the compact form (see the header) into `into`. Stops may come
// in any order. False, and `into` as it was, for a text that is not one:
// fewer than two stops, more than 16, a word that is none.
pub fn parse(text: []const u8, into: *Gradient) -> bool {
    var made: Gradient = undefined
    made.count = 0
    made.interpolation = RGB
    var start: usize = 0
    var first = true
    while start <= text.length {
        var end = start
        while end < text.length && text[end] != 59 { end += 1 }
        const item = std.text.trimmed(text[start..end])
        start = end + 1
        if item.length == 0 { continue }
        var worded = false
        if first {
            var which: usize = 0
            while which < 4 {
                if sameWord(item, INTERPOLATION_WORDS[which]) {
                    made.interpolation = @intCast(u8, which)
                    worded = true
                }
                which += 1
            }
        }
        first = false
        if worded { continue }
        if made.count >= MAX_STOPS { return false }
        if !parseStop(item, &made.stops[made.count]) { return false }
        made.count += 1
    }
    if made.count < 2 { return false }
    sortStops(&made)
    into.* = made
    return true
}

// Writes the compact form to `into`; the number of bytes, or 0 when
// `capacity` is too small for it (16 stops with everything said need up
// to 400 bytes; node.Params.text's 256 hold 16 plain ones).
pub fn format(gradient: *const Gradient, into: [*]u8, capacity: usize) -> usize {
    const count = countOf(gradient)
    var length: usize = 0
    if gradient.*.interpolation != RGB && gradient.*.interpolation < INTERPOLATIONS {
        length = put(into, length, capacity, INTERPOLATION_WORDS[@intCast(usize, gradient.*.interpolation)])
        length = putByte(into, length, capacity, 59)
    }
    var index: usize = 0
    while index < count {
        const stop = &gradient.*.stops[index]
        if index > 0 { length = putByte(into, length, capacity, 59) }
        length = putNumber(into, length, capacity, unit(stop.*.position), 4, true)
        length = putByte(into, length, capacity, 58)
        if stop.*.kind != FIXED && stop.*.kind < KINDS {
            length = put(into, length, capacity, KIND_WORDS[@intCast(usize, stop.*.kind)])
        } else {
            const digits = "0123456789abcdef"
            const value = stop.*.color
            length = putByte(into, length, capacity, 35)
            var shift: u32 = 24
            while shift > 0 {
                shift -= 4
                length = putByte(into, length, capacity, digits[@intCast(usize, (value >> shift) & 15)])
            }
            if value >> 24 != 255 {
                length = putByte(into, length, capacity, digits[@intCast(usize, value >> 28)])
                length = putByte(into, length, capacity, digits[@intCast(usize, (value >> 24) & 15)])
            }
        }
        // (The last stop's way leads nowhere.)
        if index + 1 < count {
            if stop.*.midpoint != 0.5 && stop.*.midpoint == stop.*.midpoint {
                length = putByte(into, length, capacity, 64)
                length = putNumber(into, length, capacity, unit(stop.*.midpoint), 4, true)
            }
            if stop.*.blending != BLEND_LINEAR && stop.*.blending < BLENDINGS {
                length = putByte(into, length, capacity, 47)
                length = putByte(into, length, capacity, BLENDING_LETTERS[@intCast(usize, stop.*.blending)])
            }
        }
        index += 1
    }
    return if length > capacity { 0 } else { length }
}

// ---------------------------------------------------------------------------
// The built-in gradients

pub const Builtin = struct {
    name: []const u8
    german: []const u8
    // The gradient in the compact form.
    text: []const u8
}

const BUILTIN_COUNT: usize = 15

const BUILTINS = [15]Builtin{
    Builtin.{ .name = "Foreground to Background", .german = "Vordergrund zu Hintergrund", .text = "0:fg;1:bg" },
    Builtin.{ .name = "Foreground to Transparent", .german = "Vordergrund zu Transparent", .text = "0:fg;1:fg0" },
    Builtin.{ .name = "Black to White", .german = "Schwarz zu Weiß", .text = "0:#000000;1:#ffffff" },
    Builtin.{ .name = "Spectrum", .german = "Spektrum", .text = "0:#ff0000;0.1667:#ffff00;0.3333:#00ff00;0.5:#00ffff;0.6667:#0000ff;0.8333:#ff00ff;1:#ff0000" },
    Builtin.{ .name = "Sunset", .german = "Sonnenuntergang", .text = "0:#1b1464;0.35:#7b2d8b;0.6:#e8475f;0.8:#ff9a3c;1:#ffe98a" },
    Builtin.{ .name = "Sky", .german = "Himmel", .text = "0:#1e5fbf;0.6:#7db9e8;1:#e4f1fb" },
    Builtin.{ .name = "Fire", .german = "Feuer", .text = "0:#000000;0.25:#7a0a00;0.5:#e63900;0.75:#ffb000;1:#ffffc8" },
    Builtin.{ .name = "Metal", .german = "Metall", .text = "0:#f5f7fa;0.3:#8a94a3;0.48:#2b3038;0.5:#f0f3f7;0.52:#c9d0da;0.75:#6c7685;1:#e9edf2" },
    Builtin.{ .name = "Rainbow Pastel", .german = "Pastell-Regenbogen", .text = "0:#ffb3ba;0.2:#ffdfba;0.4:#ffffba;0.6:#baffc9;0.8:#bae1ff;1:#e0baff" },
    Builtin.{ .name = "Copper", .german = "Kupfer", .text = "0:#2b1206;0.3:#8c4a1f;0.5:#f2b27a;0.55:#fde3c8;0.7:#b8672e;1:#3d1a0a" },
    Builtin.{ .name = "Sea", .german = "Meer", .text = "0:#02152e;0.4:#0b5c8e;0.75:#2bb5b0;1:#d6fff4" },
    Builtin.{ .name = "Forest", .german = "Wald", .text = "0:#0c2610;0.4:#2f6b2a;0.7:#7fa23c;1:#e3e7a1" },
    Builtin.{ .name = "Skin Tones", .german = "Hauttöne", .text = "0:#3b2219;0.25:#6f4533;0.5:#a8704f;0.75:#d9a37f;1:#f6d7c3" },
    Builtin.{ .name = "Radial Glow", .german = "Radiales Leuchten", .text = "0:#ffffff;0.15:#fff6c0/s;0.5:#ffb84080@0.4;1:#ff800000" },
    Builtin.{ .name = "Stripes", .german = "Streifen", .text = "0:fg;0.25:fg;0.25:bg;0.5:bg;0.5:fg;0.75:fg;0.75:bg;1:bg" },
}

// Where the two that follow the tool's colours are.
pub const FOREGROUND_TO_BACKGROUND: usize = 0
pub const FOREGROUND_TO_TRANSPARENT: usize = 1
pub const BLACK_TO_WHITE: usize = 2

pub fn builtinCount() -> usize { return BUILTIN_COUNT }

// The name of built-in gradient `index` ("" for one that is none).
pub fn builtinName(index: usize, german: bool) -> []const u8 {
    if index >= BUILTIN_COUNT { return "" }
    return if german { BUILTINS[index].german } else { BUILTINS[index].name }
}

// Built-in gradient `index` as the compact form ("" for one that is
// none): what a fill layer's params.text takes.
pub fn builtinText(index: usize) -> []const u8 {
    if index >= BUILTIN_COUNT { return "" }
    return BUILTINS[index].text
}

// Built-in gradient `index` into `into`. False for one that is none.
pub fn builtin(index: usize, into: *Gradient) -> bool {
    if index >= BUILTIN_COUNT { return false }
    return parse(BUILTINS[index].text, into)
}

// ---------------------------------------------------------------------------
// GIMP's .ggr

// What a .ggr calls our interpolations (it has RGB, HSV counter-clockwise
// and HSV clockwise, in that order).
fn ggrColoring(interpolation: u8) -> u64 {
    if interpolation == HSV_CCW { return 1 }
    if interpolation == HSV_CW { return 2 }
    return 0
}

fn putColor(into: [*]u8, at: usize, capacity: usize, value: u32) -> usize {
    var length = at
    length = putByte(into, length, capacity, 32)
    length = putNumber(into, length, capacity, @floatFromInt(f64, pixel.red(value)) / 255.0, 6, false)
    length = putByte(into, length, capacity, 32)
    length = putNumber(into, length, capacity, @floatFromInt(f64, pixel.green(value)) / 255.0, 6, false)
    length = putByte(into, length, capacity, 32)
    length = putNumber(into, length, capacity, @floatFromInt(f64, pixel.blue(value)) / 255.0, 6, false)
    length = putByte(into, length, capacity, 32)
    return putNumber(into, length, capacity, @floatFromInt(f64, value >> 24) / 255.0, 6, false)
}

// One line of a .ggr: the way from `left` to `right`, which lie at
// `from` and `to`.
fn putSegment(into: [*]u8, at: usize, capacity: usize, left: *const Stop, right: *const Stop, from: f64, to: f64, coloring: u64) -> usize {
    var length = putNumber(into, at, capacity, from, 6, false)
    length = putByte(into, length, capacity, 32)
    const middle = if left.*.midpoint != left.*.midpoint { 0.5 } else { unit(left.*.midpoint) }
    length = putNumber(into, length, capacity, from + (to - from) * middle, 6, false)
    length = putByte(into, length, capacity, 32)
    length = putNumber(into, length, capacity, to, 6, false)
    length = putColor(into, length, capacity, left.*.color)
    length = putColor(into, length, capacity, right.*.color)
    length = putByte(into, length, capacity, 32)
    length = putDigits(into, length, capacity, @intCast(u64, if left.*.blending < BLENDINGS { left.*.blending } else { BLEND_LINEAR }), 1)
    length = putByte(into, length, capacity, 32)
    length = putDigits(into, length, capacity, coloring, 1)
    length = putByte(into, length, capacity, 32)
    length = putDigits(into, length, capacity, @intCast(u64, if left.*.kind < KINDS { left.*.kind } else { FIXED }), 1)
    length = putByte(into, length, capacity, 32)
    length = putDigits(into, length, capacity, @intCast(u64, if right.*.kind < KINDS { right.*.kind } else { FIXED }), 1)
    return putByte(into, length, capacity, 10)
}

// Writes the gradient as a GIMP gradient file named `name` to `into`;
// the number of bytes, or 0 when `capacity` is too small (16 stops need
// less than 2 KiB). A segment a stop to the next; two stops at one place
// are the two colours neighbours meet with; what is before the first
// stop and after the last becomes a segment of one colour, since a
// file's segments reach from 0 to 1.
pub fn writeGgr(gradient: *const Gradient, name: []const u8, into: [*]u8, capacity: usize) -> usize {
    const count = countOf(gradient)
    if count == 0 { return 0 }
    const first = &gradient.*.stops[0]
    const last = &gradient.*.stops[count - 1]
    const leading = unit(first.*.position) > 0.0
    const trailing = unit(last.*.position) < 1.0
    var segments: u64 = 0
    if leading { segments += 1 }
    if trailing { segments += 1 }
    var index: usize = 0
    while index + 1 < count {
        if unit(gradient.*.stops[index + 1].position) > unit(gradient.*.stops[index].position) { segments += 1 }
        index += 1
    }
    // (All stops at 0, or all at 1: the one colour the gradient shows.)
    const single = segments == 0
    if single { segments = 1 }
    var length = put(into, 0, capacity, "GIMP Gradient\nName: ")
    for byte in name {
        // (A name is one line.)
        length = putByte(into, length, capacity, if byte == 10 || byte == 13 { 32 } else { byte })
    }
    length = putByte(into, length, capacity, 10)
    length = putDigits(into, length, capacity, segments, 1)
    length = putByte(into, length, capacity, 10)
    const coloring = ggrColoring(gradient.*.interpolation)
    if single {
        return finished(putSegment(into, length, capacity, last, last, 0.0, 1.0, coloring), capacity)
    }
    if leading { length = putSegment(into, length, capacity, first, first, 0.0, unit(first.*.position), coloring) }
    index = 0
    while index + 1 < count {
        const from = unit(gradient.*.stops[index].position)
        const to = unit(gradient.*.stops[index + 1].position)
        if to > from { length = putSegment(into, length, capacity, &gradient.*.stops[index], &gradient.*.stops[index + 1], from, to, coloring) }
        index += 1
    }
    if trailing { length = putSegment(into, length, capacity, last, last, unit(last.*.position), 1.0, coloring) }
    return finished(length, capacity)
}

fn finished(length: usize, capacity: usize) -> usize {
    return if length > capacity { 0 } else { length }
}

// One segment of a .ggr as its line says it.
const Segment = struct {
    left: f64
    middle: f64
    right: f64
    leftColor: u32
    rightColor: u32
    blending: u8
    coloring: u8
    leftKind: u8
    rightKind: u8
}

fn channelOf(value: f64) -> u32 {
    return byteOf(value * 255.0)
}

fn parseSegment(line: []const u8, segment: *Segment) -> bool {
    var numbers: [15]f64 = undefined
    var count: usize = 0
    var at = skipBlanks(line, 0)
    while count < 15 && at < line.length {
        if !readNumber(line, &at, &numbers[count]) { return false }
        count += 1
        at = skipBlanks(line, at)
    }
    // Old files end a line after the colours or after the two types.
    if count < 11 { return false }
    segment.*.left = unit(numbers[0])
    segment.*.middle = unit(numbers[1])
    segment.*.right = unit(numbers[2])
    segment.*.leftColor = pixel.pack(channelOf(numbers[6]), channelOf(numbers[3]), channelOf(numbers[4]), channelOf(numbers[5]))
    segment.*.rightColor = pixel.pack(channelOf(numbers[10]), channelOf(numbers[7]), channelOf(numbers[8]), channelOf(numbers[9]))
    segment.*.blending = BLEND_LINEAR
    segment.*.coloring = 0
    segment.*.leftKind = FIXED
    segment.*.rightKind = FIXED
    if count > 11 { segment.*.blending = small(numbers[11], BLENDINGS) }
    if count > 12 { segment.*.coloring = small(numbers[12], 3) }
    if count > 13 { segment.*.leftKind = small(numbers[13], KINDS) }
    if count > 14 { segment.*.rightKind = small(numbers[14], KINDS) }
    return true
}

// A whole number below `bound` out of a file (0 for anything else).
fn small(value: f64, bound: u8) -> u8 {
    if !(value >= 0.0) || value >= @floatFromInt(f64, bound) { return 0 }
    return @intCast(u8, @intFromFloat(u32, value + 0.5) % @intCast(u32, bound))
}

// The line of `bytes` that starts at `at.*` (without its end), and `at`
// moved to the next one.
fn nextLine(bytes: []const u8, at: *usize) -> []const u8 {
    const start = at.*
    var end = start
    while end < bytes.length && bytes[end] != 10 { end += 1 }
    at.* = if end < bytes.length { end + 1 } else { end }
    return std.text.trimmed(bytes[start..end])
}

fn sameEnd(color_a: u32, kind_a: u8, color_b: u32, kind_b: u8) -> bool {
    if kind_a != kind_b { return false }
    return kind_a != FIXED || color_a == color_b
}

// The colour of a file's segments at `place`: the segment `place` is in
// as a gradient of its own two stops.
fn ggrColorAt(bytes: []const u8, body: usize, segments: usize, place: f64, kind: *u8) -> u32 {
    var at = body
    var index: usize = 0
    var segment: Segment = undefined
    var found = false
    while index < segments {
        var read: Segment = undefined
        if parseSegment(nextLine(bytes, &at), &read) {
            // The last segment that has begun at the place.
            if !found || read.left <= place {
                segment = read
                found = true
            }
        }
        index += 1
    }
    kind.* = FIXED
    if !found { return 0 }
    // (An end that stands for a colour is kept as that where the place
    // is the end itself.)
    if place <= segment.left && segment.leftKind != FIXED {
        kind.* = segment.leftKind
        return stand(segment.leftKind)
    }
    if place >= segment.right && segment.rightKind != FIXED {
        kind.* = segment.rightKind
        return stand(segment.rightKind)
    }
    var piece: Gradient = undefined
    fromSegment(&piece, &segment)
    return colorAt(&piece, place, pixel.BLACK, pixel.WHITE)
}

fn interpolationOf(coloring: u8) -> u8 {
    if coloring == 1 { return HSV_CCW }
    if coloring == 2 { return HSV_CW }
    return RGB
}

fn fromSegment(piece: *Gradient, segment: *const Segment) -> void {
    piece.*.count = 2
    piece.*.interpolation = interpolationOf(segment.*.coloring)
    piece.*.stops[0] = plainStop(segment.*.left, segment.*.leftColor, segment.*.leftKind)
    piece.*.stops[1] = plainStop(segment.*.right, segment.*.rightColor, segment.*.rightKind)
    const span = segment.*.right - segment.*.left
    if span > 0.0 { piece.*.stops[0].midpoint = unit((segment.*.middle - segment.*.left) / span) }
    piece.*.stops[0].blending = segment.*.blending
}

// Reads a GIMP gradient file. Its name goes to `name` (as much as
// `name_capacity` holds; `name_length` says how much). The gradient's
// interpolation is the first segment's (a file names one for each).
// What writeGgr() wrote comes back as it was, except that a first or
// last pair of stops of one colour comes back as the inner one alone
// (which shows the same). False, and `into` as it was, for bytes that
// are no such file. See the header for a file of more segments than a
// Gradient holds.
pub fn readGgr(bytes: []const u8, into: *Gradient, name: [*]u8, name_capacity: usize, name_length: *usize) -> bool {
    var at: usize = 0
    if !std.text.same(nextLine(bytes, &at), "GIMP Gradient") { return false }
    name_length.* = 0
    var line = nextLine(bytes, &at)
    if std.text.startsWith(line, "Name:") {
        const said = std.text.trimmed(line[5..])
        var length: usize = 0
        while length < said.length && length < name_capacity {
            name[length] = said[length]
            length += 1
        }
        name_length.* = length
        line = nextLine(bytes, &at)
    }
    var cursor: usize = 0
    var counted: f64 = 0.0
    if !readNumber(line, &cursor, &counted) || !(counted >= 1.0) || counted > 100000.0 { return false }
    const segments = @intFromFloat(usize, counted)
    const body = at
    var made: Gradient = undefined
    made.count = 0
    made.interpolation = RGB
    var fits = true
    var index: usize = 0
    var before: Segment = undefined
    while index < segments {
        var segment: Segment = undefined
        if !parseSegment(nextLine(bytes, &at), &segment) { return false }
        if index == 0 { made.interpolation = interpolationOf(segment.coloring) }
        // A first or last segment of one colour is only the file's way
        // of saying where the gradient starts and ends (its segments
        // reach from 0 to 1): the stop at its inner end says the same.
        const plain = segments > 1 && segment.right > segment.left && sameEnd(segment.leftColor, segment.leftKind, segment.rightColor, segment.rightKind)
        const lead = plain && index == 0
        const tail = plain && index + 1 == segments
        // A segment starts with its own stop unless it goes on from
        // where and what the one before ended with.
        const joined = index > 0 && segment.left == before.right && sameEnd(segment.leftColor, segment.leftKind, before.rightColor, before.rightKind)
        if fits && !joined && !lead {
            if made.count >= MAX_STOPS {
                fits = false
            } else {
                made.stops[made.count] = plainStop(segment.left, segment.leftColor, segment.leftKind)
                made.count += 1
            }
        }
        if fits && !tail {
            if made.count >= MAX_STOPS {
                fits = false
            } else {
                if !lead && made.count > 0 {
                    const span = segment.right - segment.left
                    const from = &made.stops[made.count - 1]
                    from.*.blending = segment.blending
                    if span > 0.0 { from.*.midpoint = unit((segment.middle - segment.left) / span) }
                }
                made.stops[made.count] = plainStop(segment.right, segment.rightColor, segment.rightKind)
                made.count += 1
            }
        }
        before = segment
        index += 1
    }
    if !fits {
        // Too many for the record: 16 even places of the file.
        made.count = MAX_STOPS
        index = 0
        while index < MAX_STOPS {
            const place = @floatFromInt(f64, index) / 15.0
            var kind: u8 = FIXED
            const value = ggrColorAt(bytes, body, segments, place, &kind)
            made.stops[index] = plainStop(place, value, kind)
            index += 1
        }
        into.* = made
        return true
    }
    if made.count < 2 { return false }
    sortStops(&made)
    into.* = made
    return true
}
