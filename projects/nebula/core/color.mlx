// nebula core: colour models and the ways between them, for everything
// that thinks of a colour as something other than a pixel: the colour
// selectors, the HSV filters, the blend modes that keep a hue or a
// lightness, gradients, palettes, the file formats.
//
// Two layers. The first is scalars for pixel loops: channels are f64
// from 0 to 1 unless said, and results come through pointers to the
// caller's own scalars, so that a loop makes no value but numbers:
//
//     var h: f64 = 0.0
//     var s: f64 = 0.0
//     var v: f64 = 0.0
//     color.rgbToHsv(r, g, b, &h, &s, &v)
//     color.hsvToRgb(h + 0.5, s, v, &r, &g, &b)        // the opposite hue
//
// The second is pixels, straight 0xAARRGGBB as everywhere in the engine
// (core/pixel.mlx):
//
//     const tint = color.fromHsv(0.6, 0.5, 1.0, 255)
//     const label = color.contrastColor(tint)          // black or white
//     var typed: u32 = 0
//     if color.parseHex("#f80", &typed) { ... }         // 0xFFFF8800
//
// What holds throughout:
//
// - A hue is a part of the full turn, 0 <= h < 1: 0 red, 1/6 yellow, 1/3
//   green, 1/2 cyan, 2/3 blue, 5/6 magenta. A hue given may be any
//   number, it wraps (1.25 is 0.25, -0.25 is 0.75). hueToDegrees and
//   hueFromDegrees are there for what people read. HSV, HSL, HSI and HSY
//   share one hue, the hexagon's (the piecewise linear one), so a hue is
//   the same place of the colour wheel in each; HSI's textbook hue (an
//   arc cosine) is not used. LCh's hue is Lab's own angle, also 0..1.
// - A grey has no hue: 0 is returned for its hue and for its saturation.
// - Functions that make RGB out of a hue, a saturation and a lightness
//   hold the latter two to 0..1 first and return channels inside 0..1; a
//   saturation the lightness has no room for (HSI, HSY) gives way, the
//   hue and the lightness stay. The others (the curve, XYZ, Lab, YCbCr,
//   CMYK) hold nothing: what is outside sRGB comes back outside 0..1.
// - Rounding: a channel c of 0..1 is the byte floor(c * 255 + 0.5), held
//   to 0..255; a byte n is the channel n / 255. With this an 8-bit colour
//   comes back as itself from every model here (fromHsv(toHsv(p)) is p),
//   not only within one step: the arithmetic is some 1e-15 off, a byte
//   is 4e-3 wide.
// - RGB means sRGB with its transfer curve ("gamma") unless a name says
//   linear. Nothing here is colour managed: there are no profiles, and
//   CMYK is the plain formula, not a press.
//
// Not done: colour differences beyond CIE76 (CIE94, CIEDE2000), and a
// colour temperature after the CIE daylight locus (kelvinToRgb is a fit
// to the black body's colours, good for a white balance slider, not for
// colorimetry).
const std = @import("std")
const math = @import("std.math")
const pixel = @import("./pixel.mlx")

// ---------------------------------------------------------------------------
// The models with a hue, and luma's weights.

// The models with a hue, as rgbToModel, modelToRgb, lum, sat, setLum and
// setSat take them. They differ in what they call lightness and
// saturation (max and min the largest and the smallest channel):
//
//   HSV   value max                saturation (max - min) / max
//   HSL   lightness (max + min)/2  saturation (max - min) / (1 - |2 L - 1|)
//   HSI   intensity (r + g + b)/3  saturation 1 - min / I
//   HSY   luma Y'                  saturation max - min (the chroma)
//
// HSY's luma has Rec. 601's weights (what Krita's HSY has), HSY709 Rec.
// 709's, HSY_W3C the 0.3, 0.59, 0.11 of the W3C compositing
// specification, whose Lum, Sat, SetLum and SetSat lum, chroma, setLum
// and setChroma then are to the digit.
pub const HSV: u8 = 0
pub const HSL: u8 = 1
pub const HSI: u8 = 2
pub const HSY: u8 = 3
pub const HSY709: u8 = 4
pub const HSY_W3C: u8 = 5

pub const MODELS: u8 = 6

// Luma's weights: how much of a colour's lightness each channel is.
pub const REC601: u8 = 0
pub const REC709: u8 = 1
pub const W3C: u8 = 2

pub const REC601_RED: f64 = 0.299
pub const REC601_GREEN: f64 = 0.587
pub const REC601_BLUE: f64 = 0.114

pub const REC709_RED: f64 = 0.2126
pub const REC709_GREEN: f64 = 0.7152
pub const REC709_BLUE: f64 = 0.0722

pub const W3C_RED: f64 = 0.3
pub const W3C_GREEN: f64 = 0.59
pub const W3C_BLUE: f64 = 0.11

inline fn max3(r: f64, g: f64, b: f64) -> f64 {
    const larger = if r > g { r } else { g }
    return if larger > b { larger } else { b }
}

inline fn min3(r: f64, g: f64, b: f64) -> f64 {
    const smaller = if r < g { r } else { g }
    return if smaller < b { smaller } else { b }
}

// `value` held to 0..1; what is no number is 0.
inline fn unit(value: f64) -> f64 {
    return if !(value > 0.0) { 0.0 } else if value > 1.0 { 1.0 } else { value }
}

// `value` without its whole turns: 0 <= result < 1. What is no number
// or has no end is 0.
fn wrap(value: f64) -> f64 {
    if value >= 0.0 && value < 1.0 { return value }
    const part = value - @floor(value)
    // A negative value next to nothing rounds up to the whole turn, and
    // of what is no number there is no part: neither is below 1.
    return if part >= 0.0 && part < 1.0 { part } else { 0.0 }
}

// A hue in degrees, 0 <= result < 360.
pub fn hueToDegrees(hue: f64) -> f64 {
    return wrap(hue) * 360.0
}

// The hue of an angle in degrees, any number of them: -90 is 0.75.
pub fn hueFromDegrees(degrees: f64) -> f64 {
    return wrap(degrees / 360.0)
}

// The hue of a colour that is not grey: `high` its largest channel,
// `span` > 0 its largest minus its smallest. Each sixth of the turn runs
// from one primary or secondary to the next.
fn hueOf(r: f64, g: f64, b: f64, high: f64, span: f64) -> f64 {
    var sixths: f64 = 0.0
    if r == high {
        sixths = (g - b) / span
        if sixths < 0.0 { sixths += 6.0 }
    } else if g == high {
        sixths = 2.0 + (b - r) / span
    } else {
        sixths = 4.0 + (r - g) / span
    }
    // (A hue a rounding below red rounds up to the whole turn.)
    const hue = sixths / 6.0
    return if hue >= 1.0 { 0.0 } else { hue }
}

// The pure colour of a hue: its largest channel 1, its smallest 0, the
// third wherever in its sixth of the turn the hue is.
fn hueColor(hue: f64, r: *f64, g: *f64, b: *f64) -> void {
    const sixths = wrap(hue) * 6.0
    const sixth = @floor(sixths)
    const rise = sixths - sixth
    const fall = 1.0 - rise
    if sixth < 1.0 {
        r.* = 1.0
        g.* = rise
        b.* = 0.0
    } else if sixth < 2.0 {
        r.* = fall
        g.* = 1.0
        b.* = 0.0
    } else if sixth < 3.0 {
        r.* = 0.0
        g.* = 1.0
        b.* = rise
    } else if sixth < 4.0 {
        r.* = 0.0
        g.* = fall
        b.* = 1.0
    } else if sixth < 5.0 {
        r.* = rise
        g.* = 0.0
        b.* = 1.0
    } else {
        r.* = 1.0
        g.* = 0.0
        b.* = fall
    }
}

// What the W3C compositing specification calls ClipColor, for a colour
// whose lightness is `light` (0..1) in the model at hand: channels below
// 0 or above 1 are brought in by pulling all three toward `light`. That
// keeps the hue and, in each of the models here, the lightness (the
// largest channel, the middle of the largest and the smallest, the mean
// and a weighted sum all stay where they are when the channels close in
// on them). The pull lands on 0 or on 1 but for a rounding; that rounding
// is taken off at the end, so that what comes out is inside 0..1 to the
// last digit (a caller may take a root or a power of it).
fn clipToward(light: f64, r: *f64, g: *f64, b: *f64) -> void {
    const low = min3(r.*, g.*, b.*)
    if low < 0.0 {
        const scale = light / (light - low)
        r.* = light + (r.* - light) * scale
        g.* = light + (g.* - light) * scale
        b.* = light + (b.* - light) * scale
    }
    const high = max3(r.*, g.*, b.*)
    if high > 1.0 {
        const scale = (1.0 - light) / (high - light)
        r.* = light + (r.* - light) * scale
        g.* = light + (g.* - light) * scale
        b.* = light + (b.* - light) * scale
    }
    r.* = unit(r.*)
    g.* = unit(g.*)
    b.* = unit(b.*)
}

// Luma Y' with `weights` (REC601, REC709, W3C): the weighted sum of the
// channels as they are, not linear.
pub fn luma(weights: u8, r: f64, g: f64, b: f64) -> f64 {
    if weights == REC709 { return REC709_RED * r + REC709_GREEN * g + REC709_BLUE * b }
    if weights == W3C { return W3C_RED * r + W3C_GREEN * g + W3C_BLUE * b }
    return REC601_RED * r + REC601_GREEN * g + REC601_BLUE * b
}

// The weights of a model's luma (REC601 for the models without one).
pub fn weightsOf(model: u8) -> u8 {
    if model == HSY709 { return REC709 }
    if model == HSY_W3C { return W3C }
    return REC601
}

// ---------------------------------------------------------------------------
// HSV, HSL, HSI, HSY.

// A colour as hue, saturation and value. Black and the greys: hue 0,
// saturation 0.
pub fn rgbToHsv(r: f64, g: f64, b: f64, h: *f64, s: *f64, v: *f64) -> void {
    const high = max3(r, g, b)
    const span = high - min3(r, g, b)
    v.* = high
    if span <= 0.0 || high <= 0.0 {
        h.* = 0.0
        s.* = 0.0
        return
    }
    h.* = hueOf(r, g, b, high, span)
    s.* = span / high
}

// A pure colour (r, g, b as hueColor gives them: 0..1, the largest 1, the
// smallest 0) at a saturation and a value, both 0..1.
inline fn shadeHsv(s: f64, v: f64, r: *f64, g: *f64, b: *f64) -> void {
    r.* = v * (1.0 - s * (1.0 - r.*))
    g.* = v * (1.0 - s * (1.0 - g.*))
    b.* = v * (1.0 - s * (1.0 - b.*))
}

// The colour of a hue, a saturation and a value.
pub fn hsvToRgb(h: f64, s: f64, v: f64, r: *f64, g: *f64, b: *f64) -> void {
    hueColor(h, r, g, b)
    shadeHsv(unit(s), unit(v), r, g, b)
}

// A colour as hue, saturation and lightness. Black, white and the greys:
// hue 0, saturation 0.
pub fn rgbToHsl(r: f64, g: f64, b: f64, h: *f64, s: *f64, l: *f64) -> void {
    const high = max3(r, g, b)
    const low = min3(r, g, b)
    const span = high - low
    const sum = high + low
    l.* = sum * 0.5
    // The widest span a lightness has room for: 1 - |2 L - 1|.
    const room = if sum <= 1.0 { sum } else { 2.0 - sum }
    if span <= 0.0 || room <= 0.0 {
        h.* = 0.0
        s.* = 0.0
        return
    }
    h.* = hueOf(r, g, b, high, span)
    // The room is a small difference near white: a rounding in it must
    // not make more than all of it of the span.
    s.* = if span < room { span / room } else { 1.0 }
}

// A pure colour at a saturation and a lightness, both 0..1.
inline fn shadeHsl(s: f64, light: f64, r: *f64, g: *f64, b: *f64) -> void {
    const span = s * (if light <= 0.5 { 2.0 * light } else { 2.0 - 2.0 * light })
    const low = light - span * 0.5
    r.* = low + span * r.*
    g.* = low + span * g.*
    b.* = low + span * b.*
}

// The colour of a hue, a saturation and a lightness.
pub fn hslToRgb(h: f64, s: f64, l: f64, r: *f64, g: *f64, b: *f64) -> void {
    hueColor(h, r, g, b)
    shadeHsl(unit(s), unit(l), r, g, b)
}

// A colour as hue, saturation and intensity (the mean of the channels).
// Black and the greys: hue 0, saturation 0.
pub fn rgbToHsi(r: f64, g: f64, b: f64, h: *f64, s: *f64, i: *f64) -> void {
    const high = max3(r, g, b)
    const low = min3(r, g, b)
    const span = high - low
    const mean = (r + g + b) / 3.0
    if span <= 0.0 || mean <= 0.0 {
        h.* = 0.0
        s.* = 0.0
        // A grey is its own intensity (three times a number divided by
        // three is not always the number).
        i.* = high
        return
    }
    h.* = hueOf(r, g, b, high, span)
    // (Two channels a rounding apart can have a mean that is not above
    // the smaller one.)
    s.* = if mean > low { 1.0 - low / mean } else { 0.0 }
    i.* = mean
}

// A pure colour at a saturation and an intensity `mean`, both 0..1; a
// saturation the intensity has no room for gives way.
fn shadeHsi(s: f64, mean: f64, r: *f64, g: *f64, b: *f64) -> void {
    const low = mean * (1.0 - s)
    // The channels are low + span * the pure colour and add up to three
    // times the mean; the pure colour adds up to 1 and its middle one.
    const span = 3.0 * (mean - low) / (r.* + g.* + b.*)
    r.* = low + span * r.*
    g.* = low + span * g.*
    b.* = low + span * b.*
    clipToward(mean, r, g, b)
}

// The colour of a hue, a saturation and an intensity. Not every
// saturation fits an intensity (a full red is no brighter than 1/3): one
// that does not is lowered until the largest channel is 1.
pub fn hsiToRgb(h: f64, s: f64, i: f64, r: *f64, g: *f64, b: *f64) -> void {
    hueColor(h, r, g, b)
    shadeHsi(unit(s), unit(i), r, g, b)
}

// A colour as hue, saturation and luma with `weights` (REC601, REC709,
// W3C). The saturation is the chroma, the largest channel minus the
// smallest, as the W3C's Sat. Black, white and the greys: hue 0,
// saturation 0.
pub fn rgbToHsy(weights: u8, r: f64, g: f64, b: f64, h: *f64, s: *f64, y: *f64) -> void {
    const high = max3(r, g, b)
    const span = high - min3(r, g, b)
    if span <= 0.0 {
        h.* = 0.0
        s.* = 0.0
        // A grey is its own luma (the weights add up to 1 only nearly).
        y.* = high
        return
    }
    h.* = hueOf(r, g, b, high, span)
    s.* = span
    y.* = luma(weights, r, g, b)
}

// A pure colour at a saturation (the chroma) and a luma `light` with
// `weights`, both 0..1; a saturation the luma has no room for gives way.
fn shadeHsy(weights: u8, s: f64, light: f64, r: *f64, g: *f64, b: *f64) -> void {
    r.* = r.* * s
    g.* = g.* * s
    b.* = b.* * s
    const shift = light - luma(weights, r.*, g.*, b.*)
    r.* += shift
    g.* += shift
    b.* += shift
    clipToward(light, r, g, b)
}

// The colour of a hue, a saturation and a luma with `weights`. Not every
// saturation fits a luma (a full blue is no brighter than its weight):
// one that does not is lowered, the luma and the hue stay.
pub fn hsyToRgb(weights: u8, h: f64, s: f64, y: f64, r: *f64, g: *f64, b: *f64) -> void {
    hueColor(h, r, g, b)
    shadeHsy(weights, unit(s), unit(y), r, g, b)
}

// A colour as hue, saturation and lightness of `model` (HSV ... HSY_W3C):
// what a filter that lets people choose the model calls.
pub fn rgbToModel(model: u8, r: f64, g: f64, b: f64, h: *f64, s: *f64, l: *f64) -> void {
    if model == HSV {
        rgbToHsv(r, g, b, h, s, l)
    } else if model == HSL {
        rgbToHsl(r, g, b, h, s, l)
    } else if model == HSI {
        rgbToHsi(r, g, b, h, s, l)
    } else {
        rgbToHsy(weightsOf(model), r, g, b, h, s, l)
    }
}

// The colour of a hue, a saturation and a lightness of `model`.
pub fn modelToRgb(model: u8, h: f64, s: f64, l: f64, r: *f64, g: *f64, b: *f64) -> void {
    if model == HSV {
        hsvToRgb(h, s, l, r, g, b)
    } else if model == HSL {
        hslToRgb(h, s, l, r, g, b)
    } else if model == HSI {
        hsiToRgb(h, s, l, r, g, b)
    } else {
        hsyToRgb(weightsOf(model), h, s, l, r, g, b)
    }
}

// ---------------------------------------------------------------------------
// Lightness and saturation without the way through a hue: what the blend
// modes "hue", "saturation", "colour" and "luminosity" of each model and
// the HSV filters are made of. With HSY_W3C these are the functions of
// the W3C compositing specification's non-separable modes:
//
//     Lum(C)         lum(HSY_W3C, r, g, b)
//     Sat(C)         chroma(r, g, b)
//     SetLum(C, l)   setLum(HSY_W3C, &r, &g, &b, l)
//     SetSat(C, s)   setChroma(&r, &g, &b, s)
//
// so its "hue" mode, SetLum(SetSat(Cs, Sat(Cb)), Lum(Cb)), is
//
//     color.setChroma(&sr, &sg, &sb, color.chroma(br, bg, bb))
//     color.setLum(color.HSY_W3C, &sr, &sg, &sb, color.lum(color.HSY_W3C, br, bg, bb))

// The lightness of a colour in `model`: value, lightness, intensity or
// luma.
pub fn lum(model: u8, r: f64, g: f64, b: f64) -> f64 {
    if model == HSV { return max3(r, g, b) }
    if model == HSL { return (max3(r, g, b) + min3(r, g, b)) * 0.5 }
    if model == HSI { return (r + g + b) / 3.0 }
    return luma(weightsOf(model), r, g, b)
}

// The saturation of a colour in `model` (0 for a grey), as the model's
// rgbTo... returns it.
pub fn sat(model: u8, r: f64, g: f64, b: f64) -> f64 {
    const high = max3(r, g, b)
    const low = min3(r, g, b)
    const span = high - low
    if span <= 0.0 { return 0.0 }
    if model == HSV { return if high > 0.0 { span / high } else { 0.0 } }
    if model == HSL {
        const sum = high + low
        const room = if sum <= 1.0 { sum } else { 2.0 - sum }
        return if room <= 0.0 { 0.0 } else if span < room { span / room } else { 1.0 }
    }
    if model == HSI {
        const mean = (r + g + b) / 3.0
        return if mean > 0.0 && mean > low { 1.0 - low / mean } else { 0.0 }
    }
    return span
}

// The largest channel minus the smallest: the W3C's Sat.
pub fn chroma(r: f64, g: f64, b: f64) -> f64 {
    return max3(r, g, b) - min3(r, g, b)
}

// Moves a colour to the lightness `lightness` (held to 0..1) of `model`:
// all three channels by the same amount, and what leaves 0..1 by that is
// brought back toward the new lightness (the W3C's SetLum and
// ClipColor). The hue stays; the chroma stays where there is room for
// it.
pub fn setLum(model: u8, r: *f64, g: *f64, b: *f64, lightness: f64) -> void {
    const light = unit(lightness)
    const shift = light - lum(model, r.*, g.*, b.*)
    r.* += shift
    g.* += shift
    b.* += shift
    clipToward(light, r, g, b)
}

// The W3C's SetSat: makes of a colour the one of the same hue whose
// smallest channel is 0 and whose largest is `amount` (held to 0..1);
// black of a grey. Its lightness is whatever comes of that: setLum
// follows.
pub fn setChroma(r: *f64, g: *f64, b: *f64, amount: f64) -> void {
    const low = min3(r.*, g.*, b.*)
    const span = max3(r.*, g.*, b.*) - low
    if span <= 0.0 {
        r.* = 0.0
        g.* = 0.0
        b.* = 0.0
        return
    }
    const scale = unit(amount) / span
    r.* = (r.* - low) * scale
    g.* = (g.* - low) * scale
    b.* = (b.* - low) * scale
}

// Moves a colour to the saturation `saturation` (held to 0..1) of
// `model`, its hue and its lightness in the model staying as they are:
// what modelToRgb makes of the colour's hue, the new saturation and the
// colour's lightness, without the way through the hue. A grey stays as
// it is: it has no hue to give colour to. For the HSY models this is
// setChroma and then setLum to the luma there was (the W3C's
// "saturation" mode); in HSI and HSY a saturation the lightness has no
// room for gives way.
pub fn setSat(model: u8, r: *f64, g: *f64, b: *f64, saturation: f64) -> void {
    const low = min3(r.*, g.*, b.*)
    const span = max3(r.*, g.*, b.*) - low
    if span <= 0.0 { return }
    const wanted = unit(saturation)
    const light = unit(lum(model, r.*, g.*, b.*))
    // The pure colour of the hue there is: each channel by how far it is
    // above the smallest. That is read off the channels' differences and
    // not off their distance to the lightness, which for a colour a
    // rounding away from grey is nothing but the rounding of the
    // lightness.
    r.* = (r.* - low) / span
    g.* = (g.* - low) / span
    b.* = (b.* - low) / span
    if model == HSV {
        shadeHsv(wanted, light, r, g, b)
    } else if model == HSL {
        shadeHsl(wanted, light, r, g, b)
    } else if model == HSI {
        shadeHsi(wanted, light, r, g, b)
    } else {
        shadeHsy(weightsOf(model), wanted, light, r, g, b)
    }
}

// ---------------------------------------------------------------------------
// sRGB's transfer curve.

// An sRGB channel as linear light: the curve of IEC 61966-2-1, a
// straight piece near black and a power of 2.4 above it. Values below 0
// follow the straight piece, values above 1 the power.
pub fn srgbToLinear(value: f64) -> f64 {
    if value <= 0.04045 { return value / 12.92 }
    return math.pow((value + 0.055) / 1.055, 2.4)
}

// Linear light as an sRGB channel: the same curve backwards.
pub fn linearToSrgb(value: f64) -> f64 {
    if value <= 0.0031308 { return value * 12.92 }
    return 1.055 * math.pow(value, 1.0 / 2.4) - 0.055
}

// The index of srgbTable()'s last entry, the one of linear 1, as the
// number a loop multiplies with.
pub const SRGB_STEPS: f64 = 4095.0

// The curve as tables, filled when one is first asked for and kept in
// the module's own memory (9 KiB), so that no pixel loop takes a power.
var linear_table: [256]f64 = undefined
var linear_table32: [256]f32 = undefined
// The linear light from which on a byte is the nearest one: that of the
// byte less a half.
var byte_floor: [256]f64 = undefined
var srgb_table: [4096]u8 = undefined
var tables_ready: bool = false

fn buildTables() -> void {
    var byte: usize = 0
    while byte < 256 {
        const value = srgbToLinear(@floatFromInt(f64, byte) / 255.0)
        linear_table[byte] = value
        linear_table32[byte] = @floatCast(f32, value)
        byte_floor[byte] = if byte == 0 { 0.0 } else { srgbToLinear((@floatFromInt(f64, byte) - 0.5) / 255.0) }
        byte += 1
    }
    // The bytes of 4096 even steps of linear light: read off the floors,
    // which rise with the byte, so no power is taken for them.
    var step: usize = 0
    byte = 0
    while step < 4096 {
        const linear = @floatFromInt(f64, step) / SRGB_STEPS
        while byte < 255 && linear >= byte_floor[byte + 1] { byte += 1 }
        srgb_table[step] = @intCast(u8, byte)
        step += 1
    }
    tables_ready = true
}

// 256 entries: the linear light of each sRGB byte, exactly
// srgbToLinear(byte / 255).
pub fn linearTable() -> [*]const f64 {
    if !tables_ready { buildTables() }
    return &linear_table
}

// The same as f32, for buffers of floats.
pub fn linearTable32() -> [*]const f32 {
    if !tables_ready { buildTables() }
    return &linear_table32
}

// 4096 entries: the sRGB byte of linear light step / 4095. A loop reads
// it as table[@intFromFloat(usize, linear * color.SRGB_STEPS + 0.5)]
// with `linear` held to 0..1; that is the byte of the nearest step, at
// most one beside the byte of `linear` itself (srgb8 gives that one). A
// byte's own linear light comes back as the byte either way.
pub fn srgbTable() -> [*]const u8 {
    if !tables_ready { buildTables() }
    return &srgb_table
}

// The linear light of an sRGB byte (0-255; only the low byte of what is
// given is looked at).
pub fn linear8(byte: u32) -> f64 {
    if !tables_ready { buildTables() }
    return linear_table[@intCast(usize, byte & 255)]
}

// The sRGB byte nearest to linear light `linear` (held to 0..1): what
// rounding linearToSrgb(linear) * 255 gives, without the power.
pub fn srgb8(linear: f64) -> u32 {
    if !tables_ready { buildTables() }
    if !(linear > 0.0) { return 0 }
    if linear >= 1.0 { return 255 }
    var byte = @intCast(usize, srgb_table[@intFromFloat(usize, linear * SRGB_STEPS + 0.5)])
    // The table has the byte of the nearest step, and half a step is
    // less than half a byte even near black, where the curve is
    // steepest: one look at the neighbours' floors settles it.
    if byte < 255 && linear >= byte_floor[byte + 1] {
        byte += 1
    } else if byte > 0 && linear < byte_floor[byte] {
        byte -= 1
    }
    return @intCast(u32, byte)
}

// ---------------------------------------------------------------------------
// CIE XYZ, Lab, LCh.

// Linear sRGB as CIE XYZ. The XYZ is relative to D65, sRGB's own white
// (x 0.3127, y 0.3290), with Y = 1 for white: the matrix that follows
// from sRGB's primaries and that white.
pub fn linearToXyz(r: f64, g: f64, b: f64, x: *f64, y: *f64, z: *f64) -> void {
    x.* = 0.4123907992659595 * r + 0.35758433938387796 * g + 0.1804807884018343 * b
    y.* = 0.21263900587151036 * r + 0.7151686787677559 * g + 0.07219231536073371 * b
    z.* = 0.01933081871559185 * r + 0.11919477979462599 * g + 0.9505321522496606 * b
}

// XYZ relative to D65 as linear sRGB: the inverse of that matrix.
pub fn xyzToLinear(x: f64, y: f64, z: f64, r: *f64, g: *f64, b: *f64) -> void {
    r.* = 3.2409699419045213 * x - 1.5373831775700935 * y - 0.4986107602930033 * z
    g.* = -0.9692436362808798 * x + 1.8759675015077206 * y + 0.04155505740717561 * z
    b.* = 0.05563007969699361 * x - 0.20397695888897657 * y + 1.0569715142428786 * z
}

// Lab's white: D50 as the ICC profile connection space has it (Y is 1).
const D50_X: f64 = 0.9642
const D50_Z: f64 = 0.8249

// Where Lab's curve turns from the cube root into a straight piece, and
// that piece's slope (the CIE's 216/24389 and 24389/27).
const LAB_EPSILON: f64 = 216.0 / 24389.0
const LAB_KAPPA: f64 = 24389.0 / 27.0

inline fn labCurve(t: f64) -> f64 {
    return if t > LAB_EPSILON { math.cbrt(t) } else { (LAB_KAPPA * t + 16.0) / 116.0 }
}

inline fn labCurveBack(f: f64) -> f64 {
    const cube = f * f * f
    return if cube > LAB_EPSILON { cube } else { (116.0 * f - 16.0) / LAB_KAPPA }
}

// XYZ relative to D65 (what linearToXyz gives) as CIE L*a*b* relative to
// D50, the way ICC profiles do it: the XYZ is adapted from D65 to D50
// (0.9642, 1, 0.8249) with the Bradford matrix, and Lab taken against
// D50. L is 0..100 (white: 100, 0, 0), a and b about -128..127 (sRGB's
// colours stay within -80..94 and -113..94).
pub fn xyzToLab(x: f64, y: f64, z: f64, l: *f64, a: *f64, b: *f64) -> void {
    const fx = labCurve((1.0478860032225503 * x + 0.02291876517477949 * y - 0.050216095311733 * z) / D50_X)
    const y50 = 0.029581782498003393 * x + 0.9904835184905486 * y - 0.01707870770448268 * z
    const fy = labCurve(y50)
    const fz = labCurve((-0.009251880839208844 * x + 0.015072607487031316 * y + 0.7516781336176034 * z) / D50_Z)
    // On the straight piece 116 f - 16 is the slope times Y: written so,
    // nothing is lost of a small Y under the 16.
    l.* = if y50 > LAB_EPSILON { 116.0 * fy - 16.0 } else { LAB_KAPPA * y50 }
    a.* = 500.0 * (fx - fy)
    b.* = 200.0 * (fy - fz)
}

// Lab relative to D50 as XYZ relative to D65: the above backwards.
pub fn labToXyz(l: f64, a: f64, b: f64, x: *f64, y: *f64, z: *f64) -> void {
    const fy = (l + 16.0) / 116.0
    const x50 = labCurveBack(fy + a / 500.0) * D50_X
    const y50 = labCurveBack(fy)
    const z50 = labCurveBack(fy - b / 200.0) * D50_Z
    x.* = 0.9555125889283475 * x50 - 0.023072975173043513 * y50 + 0.06330908471330182 * z50
    y.* = -0.028324759310118807 * x50 + 1.0099429264007957 * y50 + 0.021054438751389005 * z50
    z.* = 0.012328703174821265 * x50 - 0.02053530765430328 * y50 + 1.3307136899175889 * z50
}

// Below this chroma a Lab colour is a grey whose a and b are what the
// arithmetic left over: no hue is read out of them.
const GREY_CHROMA: f64 = 1.0e-9

// Lab's a and b as LCh's chroma and hue (L is the same in both). The hue
// is the angle from +a toward +b as a part of the turn, 0 <= h < 1
// (sRGB's red is at 0.11, its blue at 0.84); 0 for a grey.
pub fn labToLch(a: f64, b: f64, c: *f64, h: *f64) -> void {
    const length = @sqrt(a * a + b * b)
    c.* = length
    if !(length > GREY_CHROMA) {
        h.* = 0.0
        return
    }
    h.* = wrap(math.atan2(b, a) / math.tau)
}

// LCh's chroma and hue as Lab's a and b.
pub fn lchToLab(c: f64, h: f64, a: *f64, b: *f64) -> void {
    const angle = wrap(h) * math.tau
    a.* = c * math.cos(angle)
    b.* = c * math.sin(angle)
}

// ---------------------------------------------------------------------------
// CMYK and YCbCr.

// RGB as CMYK by the plain formula: black is what the brightest channel
// lacks, the inks what the others lack of it. This is NOT colour
// managed: no press, no paper and no profile is in it, it only gives
// CMYK numbers a meaning where a file has nothing better. Black is
// 0, 0, 0, 1.
pub fn rgbToCmyk(r: f64, g: f64, b: f64, c: *f64, m: *f64, y: *f64, k: *f64) -> void {
    const high = max3(r, g, b)
    if high <= 0.0 {
        c.* = 0.0
        m.* = 0.0
        y.* = 0.0
        k.* = 1.0
        return
    }
    c.* = (high - r) / high
    m.* = (high - g) / high
    y.* = (high - b) / high
    k.* = 1.0 - high
}

// CMYK as RGB by the same plain formula: what each ink and the black
// leave of the paper's white.
pub fn cmykToRgb(c: f64, m: f64, y: f64, k: f64, r: *f64, g: *f64, b: *f64) -> void {
    const paper = 1.0 - k
    r.* = (1.0 - c) * paper
    g.* = (1.0 - m) * paper
    b.* = (1.0 - y) * paper
}

// RGB as Y'CbCr with BT.601's weights over the full range, as JPEG
// (JFIF) has it. All three are 0..1 here, Cb and Cr with their zero at
// 0.5 (a codec working in bytes puts it at 128 itself).
pub fn rgbToYcbcr(r: f64, g: f64, b: f64, y: *f64, cb: *f64, cr: *f64) -> void {
    const light = REC601_RED * r + REC601_GREEN * g + REC601_BLUE * b
    y.* = light
    // Blue and red less the luma, scaled so that each spans 1:
    // 2 (1 - 0.114) and 2 (1 - 0.299).
    cb.* = 0.5 + (b - light) / 1.772
    cr.* = 0.5 + (r - light) / 1.402
}

// Y'CbCr as RGB; what is outside the RGB cube comes back outside 0..1.
pub fn ycbcrToRgb(y: f64, cb: f64, cr: f64, r: *f64, g: *f64, b: *f64) -> void {
    const red = y + 1.402 * (cr - 0.5)
    const blue = y + 1.772 * (cb - 0.5)
    r.* = red
    g.* = (y - REC601_RED * red - REC601_BLUE * blue) / REC601_GREEN
    b.* = blue
}

// ---------------------------------------------------------------------------
// Pixels.

// A channel of 0..1 as a byte: floor(value * 255 + 0.5), what is outside
// held to 0 and 255, what is no number 0.
pub fn toByte(value: f64) -> u32 {
    if !(value > 0.0) { return 0 }
    if value >= 1.0 { return 255 }
    return @intFromFloat(u32, value * 255.0 + 0.5)
}

// A pixel's colour as channels of 0..1 (its alpha is not looked at).
pub fn toRgb(color: u32, r: *f64, g: *f64, b: *f64) -> void {
    r.* = @floatFromInt(f64, pixel.red(color)) / 255.0
    g.* = @floatFromInt(f64, pixel.green(color)) / 255.0
    b.* = @floatFromInt(f64, pixel.blue(color)) / 255.0
}

// The pixel of channels of 0..1 at `alpha` (0-255, more is 255).
pub fn fromRgb(r: f64, g: f64, b: f64, alpha: u32) -> u32 {
    return pixel.pack(if alpha > 255 { 255 } else { alpha }, toByte(r), toByte(g), toByte(b))
}

// A pixel's colour as hue, saturation and value (see rgbToHsv).
pub fn toHsv(color: u32, h: *f64, s: *f64, v: *f64) -> void {
    rgbToHsv(@floatFromInt(f64, pixel.red(color)) / 255.0, @floatFromInt(f64, pixel.green(color)) / 255.0, @floatFromInt(f64, pixel.blue(color)) / 255.0, h, s, v)
}

// The pixel of a hue, a saturation and a value at `alpha` (0-255).
pub fn fromHsv(h: f64, s: f64, v: f64, alpha: u32) -> u32 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    hsvToRgb(h, s, v, &r, &g, &b)
    return fromRgb(r, g, b, alpha)
}

// A pixel's colour as hue, saturation and lightness (see rgbToHsl).
pub fn toHsl(color: u32, h: *f64, s: *f64, l: *f64) -> void {
    rgbToHsl(@floatFromInt(f64, pixel.red(color)) / 255.0, @floatFromInt(f64, pixel.green(color)) / 255.0, @floatFromInt(f64, pixel.blue(color)) / 255.0, h, s, l)
}

// The pixel of a hue, a saturation and a lightness at `alpha` (0-255).
pub fn fromHsl(h: f64, s: f64, l: f64, alpha: u32) -> u32 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    hslToRgb(h, s, l, &r, &g, &b)
    return fromRgb(r, g, b, alpha)
}

// A pixel's colour as Lab (see xyzToLab).
pub fn toLab(color: u32, l: *f64, a: *f64, b: *f64) -> void {
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    linearToXyz(linear8(pixel.red(color)), linear8(pixel.green(color)), linear8(pixel.blue(color)), &x, &y, &z)
    xyzToLab(x, y, z, l, a, b)
}

// The pixel of a Lab colour at `alpha` (0-255); a colour outside sRGB is
// held to it channel by channel.
pub fn fromLab(l: f64, a: f64, b: f64, alpha: u32) -> u32 {
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    labToXyz(l, a, b, &x, &y, &z)
    var red: f64 = 0.0
    var green: f64 = 0.0
    var blue: f64 = 0.0
    xyzToLinear(x, y, z, &red, &green, &blue)
    return pixel.pack(if alpha > 255 { 255 } else { alpha }, srgb8(red), srgb8(green), srgb8(blue))
}

// How light a pixel's colour is in linear light, 0 (black) to 1 (white):
// the relative luminance WCAG 2 measures contrast with.
pub fn luminance(color: u32) -> f64 {
    return REC709_RED * linear8(pixel.red(color)) + REC709_GREEN * linear8(pixel.green(color)) + REC709_BLUE * linear8(pixel.blue(color))
}

// A pixel's luma Y' with `weights` (REC601, REC709, W3C), 0..1: the
// weighted sum of its channels as they are, not linear.
pub fn lumaOf(color: u32, weights: u8) -> f64 {
    return luma(weights, @floatFromInt(f64, pixel.red(color)), @floatFromInt(f64, pixel.green(color)), @floatFromInt(f64, pixel.blue(color))) / 255.0
}

// Black or white (opaque), whichever reads better on the pixel's colour:
// the one with the larger WCAG contrast ratio to it, black where they
// are equal. From a grey of 118 on that is black.
pub fn contrastColor(color: u32) -> u32 {
    // The ratios are (L + 0.05) / 0.05 against black and 1.05 / (L + 0.05)
    // against white: black wins from (L + 0.05)^2 = 1.05 * 0.05 on.
    const light = luminance(color) + 0.05
    return if light * light >= 0.0525 { pixel.BLACK } else { pixel.WHITE }
}

inline fn gap(a: u32, b: u32) -> u32 {
    return if a > b { a - b } else { b - a }
}

// How far apart two pixels' colours are, 0-255: the largest difference
// of a colour channel; the alphas are not looked at.
pub fn distanceRgb(a: u32, b: u32) -> u32 {
    const reds = gap(pixel.red(a), pixel.red(b))
    const greens = gap(pixel.green(a), pixel.green(b))
    const blues = gap(pixel.blue(a), pixel.blue(b))
    return pixel.larger(reds, pixel.larger(greens, blues))
}

// How far apart two pixels are, 0-255: the largest difference of a
// channel, alpha included; what a fill's or a magic wand's threshold is
// compared with. A fully transparent pixel has no colour (its colour
// bytes are what was there before it was erased), so next to one only
// the alphas count: two transparent pixels are 0 apart whatever is in
// them.
pub fn distance(a: u32, b: u32) -> u32 {
    const alphas = gap(a >> 24, b >> 24)
    if a >> 24 == 0 || b >> 24 == 0 { return alphas }
    return pixel.larger(distanceRgb(a, b), alphas)
}

// The CIE76 colour difference of two pixels: the distance of their
// colours in Lab (alpha is not looked at). About 2.3 is what an eye just
// notices; black to white is 100.
pub fn deltaE76(a: u32, b: u32) -> f64 {
    var l1: f64 = 0.0
    var a1: f64 = 0.0
    var b1: f64 = 0.0
    var l2: f64 = 0.0
    var a2: f64 = 0.0
    var b2: f64 = 0.0
    toLab(a, &l1, &a1, &b1)
    toLab(b, &l2, &a2, &b2)
    return @sqrt((l1 - l2) * (l1 - l2) + (a1 - a2) * (a1 - a2) + (b1 - b2) * (b1 - b2))
}

// From pixel `a` (position 0) to `b` (position 1) in linear light: what
// mixing lights does, where pixel.mix goes straight through the bytes
// and darkens the middle. Alpha goes evenly; each colour counts by its
// alpha, so the colour of a transparent end does not count. A position
// outside 0..1 is the nearer end.
pub fn mixLinearAt(a: u32, b: u32, position: f64) -> u32 {
    if !(position > 0.0) { return a }
    if position >= 1.0 { return b }
    const share_a = @floatFromInt(f64, a >> 24) * (1.0 - position)
    const share_b = @floatFromInt(f64, b >> 24) * position
    const total = share_a + share_b
    const alpha = @intFromFloat(u32, total + 0.5)
    if alpha == 0 { return 0 }
    const r = srgb8((linear8(pixel.red(a)) * share_a + linear8(pixel.red(b)) * share_b) / total)
    const g = srgb8((linear8(pixel.green(a)) * share_a + linear8(pixel.green(b)) * share_b) / total)
    const bl = srgb8((linear8(pixel.blue(a)) * share_a + linear8(pixel.blue(b)) * share_b) / total)
    return pixel.pack(alpha, r, g, bl)
}

// The same with `t` 0-255 (more is 255), as pixel.mix takes it. A
// gradient wants mixLinearAt: near black one step of 255 in linear light
// is 13 steps of a byte.
pub fn mixLinear(a: u32, b: u32, t: u32) -> u32 {
    return mixLinearAt(a, b, @floatFromInt(f64, t) / 255.0)
}

// The colour of a black body at `kelvin` (held to 1000..40000) as an
// opaque pixel, its brightest channel 255: orange at 2000, white near
// 6500, blue above. Tanner Helland's fit to the black body's colours: a
// logarithm for green and blue below 6600 K, a power for red and green
// above it, with a small step where the two meet.
pub fn kelvinToRgb(kelvin: u32) -> u32 {
    const held = if kelvin < 1000 { 1000 } else if kelvin > 40000 { 40000 } else { kelvin }
    const hundreds = @floatFromInt(f64, held) / 100.0
    var r: f64 = 255.0
    var g: f64 = 0.0
    var b: f64 = 255.0
    if hundreds <= 66.0 {
        g = 99.4708025861 * math.ln(hundreds) - 161.1195681661
    } else {
        r = 329.698727446 * math.pow(hundreds - 60.0, -0.1332047592)
        g = 288.1221695283 * math.pow(hundreds - 60.0, -0.0755148492)
    }
    // Blue is full from 6600 K on (at 6600 itself all three are), and
    // below 1900 K the fit is under 0: no blue, and no logarithm of
    // nothing at 1000.
    if hundreds < 66.0 {
        b = if hundreds <= 19.0 { 0.0 } else { 138.5177312231 * math.ln(hundreds - 10.0) - 305.0447927307 }
    }
    return pixel.rgb(toByte(r / 255.0), toByte(g / 255.0), toByte(b / 255.0))
}

// Reads a colour as people write it: "#RGB" (each digit standing for
// itself twice: "#f80" is "#ff8800"), "#RRGGBB", "#AARRGGBB", with or
// without the '#', in either case, blanks around it allowed. Without an
// alpha the pixel is opaque. False, and `into` as it was, for anything
// else.
pub fn parseHex(text: []const u8, into: *u32) -> bool {
    var digits = std.text.trimmed(text)
    if digits.length > 0 && digits[0] == 35 { digits = digits[1..] }
    const count = digits.length
    if count != 3 && count != 6 && count != 8 { return false }
    var value: u32 = 0
    var index: usize = 0
    while index < count {
        const digit = std.text.hexValue(digits[index])
        if digit > 15 { return false }
        value = (value << 4) | @intCast(u32, digit)
        index += 1
    }
    if count == 3 {
        into.* = pixel.rgb(((value >> 8) & 15) * 17, ((value >> 4) & 15) * 17, (value & 15) * 17)
    } else if count == 6 {
        into.* = 0xFF000000 | value
    } else {
        into.* = value
    }
    return true
}

// Writes a pixel as "#rrggbb" (7 bytes) or, with `with_alpha`,
// "#aarrggbb" (9 bytes) to `into`, which has room for that; returns the
// number of bytes written. What parseHex reads back.
pub fn formatHex(color: u32, into: [*]u8, with_alpha: bool) -> usize {
    const digits = "0123456789abcdef"
    into[0] = 35
    var at: usize = 1
    var shift: u32 = if with_alpha { 28 } else { 20 }
    while true {
        into[at] = digits[@intCast(usize, (color >> shift) & 15)]
        at += 1
        if shift == 0 { break }
        shift -= 4
    }
    return at
}
