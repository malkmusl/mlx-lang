// nebula core: an image: its size, its tree of layers (core/node.mlx)
// under `root`, the selection, the history of what was done to it
// (core/history.mlx) and the projection: what all layers together show,
// which core/render.mlx brings up to date wherever `dirty` says it is
// stale.
//
// Whoever changes what the image shows says where: damage(image, area).
// Pixels are changed inside a device's begin() and commit()
// (core/device.mlx) and the change handed to the history; the usual steps
// (a new layer, a layer removed or moved, its properties, a layer's
// pixels changed) are core/ops.mlx.
const std = @import("std")
const device_module = @import("./device.mlx")
const mask_module = @import("./mask.mlx")
const node_module = @import("./node.mlx")
const geom = @import("./geom.mlx")
const history_module = @import("./history.mlx")

pub const Device = device_module.Device
pub const Node = node_module.Node
pub const Rect = geom.Rect
pub const Allocator = std.allocator.Allocator

pub const PATH: usize = 1024
pub const LARGEST: i32 = 32768

pub const Image = struct {
    allocator: Allocator
    width: i32
    height: i32
    // Pixels an inch.
    resolution: f64
    // A group that is not listed: the image's layers are its children.
    root: *Node
    nextId: u32
    // The node tools work on (null: none).
    active: ?*Node
    // The selection (a mask, always there) and whether there is one:
    // without one, everything can be changed.
    selection: *Device
    selected: bool
    // What the image shows, straight pixels, valid where `dirty` is not.
    projection: *Device
    dirty: Rect
    history: *history_module.History
    // The file it is (0 long: none yet) and whether it changed since.
    path: [1024]u8
    pathLength: usize
    modified: bool
    // Counted up whenever the tree or a node's properties change: who
    // lists the layers knows to list them again.
    revision: u64
    // Counted up whenever the selection changes: who draws its outline
    // knows to make it again.
    selectionSerial: u64
    // What the projection's bringing up to date drew again lately, for
    // whoever shows the projection (updatesSince): `updateSerial` counts
    // the entries ever made, the last sixteen are kept.
    updates: [16]Rect
    updateSerial: u64
}

// An image of `width` x `height` with no layers. Null without memory or
// for a size not between 1 and LARGEST.
pub fn create(allocator: Allocator, width: i32, height: i32, resolution: f64) -> ?*Image {
    if width < 1 || height < 1 || width > LARGEST || height > LARGEST { return null }
    const memory = allocator.alloc(@sizeOf(Image), 16)
    if memory == null { return null }
    const image: *Image = unsafe { @ptrCast(*Image, memory.?) }
    image.*.allocator = allocator
    image.*.width = width
    image.*.height = height
    image.*.resolution = resolution
    image.*.nextId = 2
    image.*.active = null
    image.*.selected = false
    image.*.dirty = geom.empty()
    image.*.pathLength = 0
    image.*.modified = false
    image.*.revision = 1
    image.*.selectionSerial = 1
    image.*.updateSerial = 0
    const root = node_module.create(allocator, node_module.GROUP, 1, "root")
    const selection = mask_module.create(allocator, false)
    const projection = device_module.create(allocator, 0)
    const history = history_module.create(allocator)
    if root == null || selection == null || projection == null || history == null {
        if root != null { node_module.destroy(root.?) }
        if selection != null { device_module.destroy(selection.?) }
        if projection != null { device_module.destroy(projection.?) }
        if history != null { history_module.destroy(history.?) }
        unsafe { allocator.free(@ptrCast([*]u8, image), @sizeOf(Image), 16) }
        return null
    }
    image.*.root = root.?
    image.*.selection = selection.?
    image.*.projection = projection.?
    image.*.history = history.?
    return image
}

pub fn destroy(image: *Image) -> void {
    history_module.destroy(image.*.history)
    node_module.destroy(image.*.root)
    device_module.destroy(image.*.selection)
    device_module.destroy(image.*.projection)
    const allocator = image.*.allocator
    unsafe { allocator.free(@ptrCast([*]u8, image), @sizeOf(Image), 16) }
}

pub fn bounds(image: *Image) -> Rect {
    return geom.rect(0, 0, image.*.width, image.*.height)
}

// A number no node of the image has.
pub fn newId(image: *Image) -> u32 {
    const id = image.*.nextId
    image.*.nextId += 1
    return id
}

// The projection is stale in `area`.
pub fn damage(image: *Image, area: Rect) -> void {
    image.*.dirty = geom.unite(image.*.dirty, geom.intersect(area, bounds(image)))
}

pub fn damageAll(image: *Image) -> void {
    image.*.dirty = bounds(image)
}

// The projection was drawn again in `area` (core/render.mlx says so).
pub fn noteUpdate(image: *Image, area: Rect) -> void {
    if geom.isEmpty(area) { return }
    image.*.updates[@intCast(usize, image.*.updateSerial % 16)] = area
    image.*.updateSerial += 1
}

// Where the projection was drawn again since it had been drawn again
// `serial` times (a viewer keeps image.updateSerial from its last look):
// the rectangle around all of it into `into` (empty: nowhere). False when
// that is too long ago to say: everything may look different.
pub fn updatesSince(image: *Image, serial: u64, into: *Rect) -> bool {
    into.* = geom.empty()
    if serial > image.*.updateSerial || image.*.updateSerial - serial > 16 { return false }
    var at = serial
    while at < image.*.updateSerial {
        into.* = geom.unite(into.*, image.*.updates[@intCast(usize, at % 16)])
        at += 1
    }
    return true
}

// The selection changed (whoever writes image.selection says so; the
// history and core/ops.mlx do).
pub fn selectionChanged(image: *Image) -> void {
    image.*.selectionSerial += 1
}

// The tree or a node's properties changed.
pub fn touch(image: *Image) -> void {
    image.*.revision += 1
    image.*.modified = true
}

pub fn find(image: *Image, id: u32) -> ?*Node {
    return node_module.find(image.*.root, id)
}

pub fn pathOf(image: *Image) -> []const u8 {
    const bytes: [*]const u8 = &image.*.path
    return bytes[0..image.*.pathLength]
}

pub fn setPath(image: *Image, text: []const u8) -> void {
    var length: usize = 0
    while length < text.length && length < PATH {
        image.*.path[length] = text[length]
        length += 1
    }
    image.*.pathLength = length
}

// The node tools work on is in the tree (after an undo it may not be):
// else the topmost layer becomes it, or none.
pub fn settleActive(image: *Image) -> void {
    if image.*.active != null && node_module.isUnder(image.*.active.?, image.*.root) { return }
    const count = node_module.childCount(image.*.root)
    image.*.active = null
    if count > 0 { image.*.active = node_module.childAt(image.*.root, count - 1) }
}

// The amount of the selection at (x, y): all where there is none.
pub fn selectedAt(image: *Image, x: i32, y: i32) -> u32 {
    if !image.*.selected { return 255 }
    return mask_module.at(image.*.selection, x, y)
}

// How many layers and masks the image has.
pub fn nodeCount(image: *Image) -> usize {
    return countUnder(image.*.root)
}

fn countUnder(node: *Node) -> usize {
    var total: usize = 0
    for child in node.*.children.items() {
        total += 1 + countUnder(child)
    }
    return total
}
