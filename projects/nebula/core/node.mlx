// nebula core: the nodes of an image: its layers, in a tree, and their
// masks. A group's children are the layers in it, the lowest first; a
// layer's (and a group's) masks are children of it too (isMask), applied
// from the first to the last.
//
// What a node shows comes from its kind: a paint layer's pixels are its
// `device`; a mask's amounts are its `device` (core/mask.mlx); a filter
// layer's `device` is the mask of what it filters, `params` says how; a
// fill layer makes its pixels from `params` (a colour, a pattern, a
// gradient: the generators); a clone shows another node (`cloneOf`, by
// id) moved by its device's place; a vector layer and a file layer keep
// their pixels in `device`, made again from what `extra` holds.
//
// Tools show what is not yet done without changing the layer: `overlay`
// is painted over the content (a stroke as it is drawn, at
// `overlayOpacity` in `overlayBlend`), `substitute` stands in for the
// content altogether (a filter's preview). core/render.mlx draws both.
const std = @import("std")
const device_module = @import("./device.mlx")
const mask_module = @import("./mask.mlx")

pub const Device = device_module.Device
pub const Allocator = std.allocator.Allocator

pub const PAINT: u8 = 0
pub const GROUP: u8 = 1
pub const FILL: u8 = 2
pub const FILTER: u8 = 3
pub const CLONE: u8 = 4
pub const VECTOR: u8 = 5
pub const FILE: u8 = 6
pub const TRANSPARENCY_MASK: u8 = 16
pub const FILTER_MASK: u8 = 17
pub const COLORIZE_MASK: u8 = 18
pub const TRANSFORM_MASK: u8 = 19
pub const SELECTION_MASK: u8 = 20

pub fn isMask(kind: u8) -> bool { return kind >= 16 }

pub const NAME: usize = 128
pub const VALUES: usize = 32
pub const TEXT: usize = 256

// How a filter filters, a generator fills, a transform mask transforms:
// which one (the registry's number), its numbers in the order it names
// them, and a text where it needs one (a curve's points, a file's path).
pub const Params = struct {
    id: u16
    values: [32]f64
    text: [256]u8
    textLength: usize
}

pub fn clearParams(params: *Params) -> void {
    params.*.id = 0
    params.*.textLength = 0
    var index: usize = 0
    while index < VALUES {
        params.*.values[index] = 0.0
        index += 1
    }
}

pub fn paramsText(params: *const Params) -> []const u8 {
    const bytes: [*]const u8 = &params.*.text
    return bytes[0..params.*.textLength]
}

pub fn setParamsText(params: *Params, text: []const u8) -> void {
    var length: usize = 0
    while length < text.length && length < TEXT {
        params.*.text[length] = text[length]
        length += 1
    }
    params.*.textLength = length
}

// What undo keeps of a node besides its pixels and its place in the tree.
pub const Props = struct {
    name: [128]u8
    nameLength: usize
    visible: bool
    locked: bool
    alphaLocked: bool
    inheritAlpha: bool
    passThrough: bool
    collapsed: bool
    opacity: u8
    blend: u16
    label: u8
    channels: u8
    cloneOf: u32
    params: Params
}

pub const Node = struct {
    allocator: Allocator
    // The node's number in its image: it stays, wherever the node goes.
    id: u32
    kind: u8
    name: [128]u8
    nameLength: usize
    visible: bool
    locked: bool
    // Painting keeps each pixel's alpha.
    alphaLocked: bool
    // Shows only where the layers below it in its group show.
    inheritAlpha: bool
    // A group whose layers mix with what is below the group one by one.
    passThrough: bool
    // In the layer list: folded.
    collapsed: bool
    opacity: u8
    blend: u16
    // A colour label (0: none).
    label: u8
    // The channels shown: bit 0 blue, 1 green, 2 red, 3 alpha.
    channels: u8
    parent: ?*Node
    children: std.ArrayList(*Node)
    device: ?*Device
    substitute: ?*Device
    overlay: ?*Device
    overlayOpacity: u8
    overlayBlend: u16
    // The overlay shows only where the image's selection is.
    overlayMasked: bool
    cloneOf: u32
    params: Params
    // What a module outside core keeps for the node (a vector layer's
    // shapes), and how it is freed with the node.
    extra: usize
    extraFree: ?fn(extra: usize) -> void
}

pub fn nameOf(node: *Node) -> []const u8 {
    const bytes: [*]const u8 = &node.*.name
    return bytes[0..node.*.nameLength]
}

pub fn setName(node: *Node, text: []const u8) -> void {
    var length: usize = 0
    while length < text.length && length < NAME {
        node.*.name[length] = text[length]
        length += 1
    }
    node.*.nameLength = length
}

// A node of `kind` with no parent: shown, not locked, opaque, normal; a
// paint, vector or file layer and a fill layer with a blank device, a
// mask and a filter layer with a mask of everything, a group and a clone
// with none. Null without memory.
pub fn create(allocator: Allocator, kind: u8, id: u32, name: []const u8) -> ?*Node {
    const memory = allocator.alloc(@sizeOf(Node), 16)
    if memory == null { return null }
    const node: *Node = unsafe { @ptrCast(*Node, memory.?) }
    node.*.allocator = allocator
    node.*.id = id
    node.*.kind = kind
    setName(node, name)
    node.*.visible = true
    node.*.locked = false
    node.*.alphaLocked = false
    node.*.inheritAlpha = false
    node.*.passThrough = false
    node.*.collapsed = false
    node.*.opacity = 255
    node.*.blend = 0
    node.*.label = 0
    node.*.channels = 15
    node.*.parent = null
    node.*.children = std.ArrayList(*Node).init(allocator)
    node.*.device = null
    node.*.substitute = null
    node.*.overlay = null
    node.*.overlayOpacity = 255
    node.*.overlayBlend = 0
    node.*.overlayMasked = false
    node.*.cloneOf = 0
    clearParams(&node.*.params)
    node.*.extra = 0
    node.*.extraFree = null
    if kind == GROUP {
        return node
    }
    if kind == CLONE {
        // Only a place: where the clone sits against what it shows.
        node.*.device = device_module.create(allocator, 0)
    } else if isMask(kind) || kind == FILTER {
        node.*.device = mask_module.create(allocator, true)
    } else {
        node.*.device = device_module.create(allocator, 0)
    }
    if node.*.device == null {
        node.*.children.deinit()
        unsafe { allocator.free(@ptrCast([*]u8, node), @sizeOf(Node), 16) }
        return null
    }
    return node
}

// Ends the node and everything under it (it is in no tree any more, or
// its parent ends with it).
pub fn destroy(node: *Node) -> void {
    for child in node.*.children.items() {
        child.*.parent = null
        destroy(child)
    }
    node.*.children.deinit()
    if node.*.device != null { device_module.destroy(node.*.device.?) }
    if node.*.extraFree != null && node.*.extra != 0 { node.*.extraFree.?(node.*.extra) }
    const allocator = node.*.allocator
    unsafe { allocator.free(@ptrCast([*]u8, node), @sizeOf(Node), 16) }
}

pub fn props(node: *Node) -> Props {
    return Props.{
        .name = node.*.name,
        .nameLength = node.*.nameLength,
        .visible = node.*.visible,
        .locked = node.*.locked,
        .alphaLocked = node.*.alphaLocked,
        .inheritAlpha = node.*.inheritAlpha,
        .passThrough = node.*.passThrough,
        .collapsed = node.*.collapsed,
        .opacity = node.*.opacity,
        .blend = node.*.blend,
        .label = node.*.label,
        .channels = node.*.channels,
        .cloneOf = node.*.cloneOf,
        .params = node.*.params,
    }
}

pub fn setProps(node: *Node, from: *const Props) -> void {
    node.*.name = from.*.name
    node.*.nameLength = from.*.nameLength
    node.*.visible = from.*.visible
    node.*.locked = from.*.locked
    node.*.alphaLocked = from.*.alphaLocked
    node.*.inheritAlpha = from.*.inheritAlpha
    node.*.passThrough = from.*.passThrough
    node.*.collapsed = from.*.collapsed
    node.*.opacity = from.*.opacity
    node.*.blend = from.*.blend
    node.*.label = from.*.label
    node.*.channels = from.*.channels
    node.*.cloneOf = from.*.cloneOf
    node.*.params = from.*.params
}

// ---------------------------------------------------------------------------
// The tree

pub fn childCount(node: *Node) -> usize { return node.*.children.count() }

pub fn childAt(node: *Node, index: usize) -> *Node { return node.*.children.items()[index] }

// Where `child` is among its parent's children (null: not there).
pub fn indexIn(parent: *Node, child: *Node) -> ?usize {
    for candidate, index in parent.*.children.items() {
        if @intFromPtr(candidate) == @intFromPtr(child) { return index }
    }
    return null
}

// Whether `node` is `ancestor` or under it.
pub fn isUnder(node: *Node, ancestor: *Node) -> bool {
    var at: ?*Node = node
    while at != null {
        if @intFromPtr(at.?) == @intFromPtr(ancestor) { return true }
        at = at.?.*.parent
    }
    return false
}

// `child` (in no tree) becomes `parent`'s child number `index` (past the
// last: the last). False without memory, or when it would go under
// itself.
pub fn insert(parent: *Node, child: *Node, index: usize) -> bool {
    if isUnder(parent, child) { return false }
    const at = if index > parent.*.children.count() { parent.*.children.count() } else { index }
    if !parent.*.children.insert(at, child) { return false }
    child.*.parent = parent
    return true
}

// Takes `child` out of its parent (it lives on, in no tree).
pub fn detach(child: *Node) -> void {
    if child.*.parent == null { return }
    const parent = child.*.parent.?
    const index = indexIn(parent, child)
    if index != null { _ = parent.*.children.orderedRemove(index.?) }
    child.*.parent = null
}

// The node numbered `id` in the tree under (and with) `root`.
pub fn find(root: *Node, id: u32) -> ?*Node {
    if root.*.id == id { return root }
    for child in root.*.children.items() {
        const found = find(child, id)
        if found != null { return found }
    }
    return null
}

// How many groups are above the node.
pub fn depth(node: *Node) -> usize {
    var count: usize = 0
    var at = node.*.parent
    while at != null {
        count += 1
        at = at.?.*.parent
    }
    return count
}

// Whether the node and all above it are shown.
pub fn isShown(node: *Node) -> bool {
    var at: ?*Node = node
    while at != null {
        if !at.?.*.visible { return false }
        at = at.?.*.parent
    }
    return true
}

// The nodes under `root` as a layer list shows them: the topmost first, a
// node's children after it (`folded`: not those of a collapsed node).
// False without memory.
pub fn listed(root: *Node, into: *std.ArrayList(*Node), folded: bool) -> bool {
    var index = root.*.children.count()
    while index > 0 {
        index -= 1
        const child = root.*.children.items()[index]
        if !into.append(child) { return false }
        if !(folded && child.*.collapsed) {
            if !listed(child, into, folded) { return false }
        }
    }
    return true
}

// The layer (not a mask) of a node: itself, or what a mask belongs to.
pub fn layerOf(node: *Node) -> *Node {
    if isMask(node.*.kind) && node.*.parent != null { return node.*.parent.? }
    return node
}

// A copy of the node and everything under it, in no tree: the pixels
// shared until written, the ids new (taken from `next_id`, counted on).
// Null without memory.
pub fn duplicate(node: *Node, next_id: *u32) -> ?*Node {
    const allocator = node.*.allocator
    const memory = allocator.alloc(@sizeOf(Node), 16)
    if memory == null { return null }
    const made: *Node = unsafe { @ptrCast(*Node, memory.?) }
    made.*.allocator = allocator
    made.*.id = next_id.*
    next_id.* += 1
    made.*.kind = node.*.kind
    made.*.parent = null
    made.*.children = std.ArrayList(*Node).init(allocator)
    made.*.device = null
    made.*.substitute = null
    made.*.overlay = null
    made.*.overlayOpacity = 255
    made.*.overlayBlend = 0
    made.*.overlayMasked = false
    made.*.extra = 0
    made.*.extraFree = null
    const kept = props(node)
    setProps(made, &kept)
    if node.*.device != null {
        made.*.device = device_module.copy(node.*.device.?)
        if made.*.device == null {
            destroy(made)
            return null
        }
    }
    for child in node.*.children.items() {
        const copied = duplicate(child, next_id)
        if copied == null || !made.*.children.append(copied.?) {
            if copied != null { destroy(copied.?) }
            destroy(made)
            return null
        }
        copied.?.*.parent = made
    }
    return made
}
