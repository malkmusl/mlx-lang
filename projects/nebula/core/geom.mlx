// nebula core: rectangles of whole pixels (std.ui's Rect: x right, y down,
// the first column and row past it are right() and bottom()) as the engine
// uses them: what a change touched, what a layer covers, what is to be
// drawn again. An empty rectangle has no width or no height; uniting with
// one gives the other.
const ui = @import("std.ui")

pub const Rect = ui.Rect

pub fn rect(x: i32, y: i32, width: i32, height: i32) -> Rect {
    return Rect.{ .x = x, .y = y, .width = width, .height = height }
}

pub fn empty() -> Rect {
    return Rect.{ .x = 0, .y = 0, .width = 0, .height = 0 }
}

pub fn isEmpty(area: Rect) -> bool {
    return area.width <= 0 || area.height <= 0
}

pub fn right(area: Rect) -> i32 { return area.x + area.width }
pub fn bottom(area: Rect) -> i32 { return area.y + area.height }

pub fn contains(area: Rect, x: i32, y: i32) -> bool {
    return x >= area.x && y >= area.y && x < area.x + area.width && y < area.y + area.height
}

pub fn same(a: Rect, b: Rect) -> bool {
    return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}

fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }

// The overlap (empty when there is none).
pub fn intersect(a: Rect, b: Rect) -> Rect {
    if isEmpty(a) || isEmpty(b) { return empty() }
    const x = larger(a.x, b.x)
    const y = larger(a.y, b.y)
    const width = smaller(right(a), right(b)) - x
    const height = smaller(bottom(a), bottom(b)) - y
    if width <= 0 || height <= 0 { return empty() }
    return rect(x, y, width, height)
}

// The smallest rectangle around both.
pub fn unite(a: Rect, b: Rect) -> Rect {
    if isEmpty(a) { return b }
    if isEmpty(b) { return a }
    const x = smaller(a.x, b.x)
    const y = smaller(a.y, b.y)
    return rect(x, y, larger(right(a), right(b)) - x, larger(bottom(a), bottom(b)) - y)
}

// The rectangle moved by (dx, dy).
pub fn moved(area: Rect, dx: i32, dy: i32) -> Rect {
    return rect(area.x + dx, area.y + dy, area.width, area.height)
}

// The rectangle grown by `margin` on every side (shrunk by a negative
// one; never below empty).
pub fn grown(area: Rect, margin: i32) -> Rect {
    if isEmpty(area) { return area }
    const width = area.width + margin * 2
    const height = area.height + margin * 2
    if width <= 0 || height <= 0 { return empty() }
    return rect(area.x - margin, area.y - margin, width, height)
}

// The rectangle between two corners given in any order, both inside it.
pub fn fromCorners(x0: i32, y0: i32, x1: i32, y1: i32) -> Rect {
    const left = smaller(x0, x1)
    const top = smaller(y0, y1)
    return rect(left, top, larger(x0, x1) - left + 1, larger(y0, y1) - top + 1)
}

// The whole pixels a box with fractional edges touches.
pub fn fromBounds(left: f64, top: f64, right_edge: f64, bottom_edge: f64) -> Rect {
    const x0 = @intFromFloat(i32, @floor(left))
    const y0 = @intFromFloat(i32, @floor(top))
    const x1 = @intFromFloat(i32, @ceil(right_edge))
    const y1 = @intFromFloat(i32, @ceil(bottom_edge))
    if x1 <= x0 || y1 <= y0 { return empty() }
    return rect(x0, y0, x1 - x0, y1 - y0)
}

pub fn clampInt(value: i32, low: i32, high: i32) -> i32 {
    return if value < low { low } else if value > high { high } else { value }
}
