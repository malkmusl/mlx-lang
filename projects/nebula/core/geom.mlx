// nebula core: rectangles of whole pixels (std.ui's Rect: x right, y down,
// the first column and row past it are right() and bottom()) as the engine
// uses them: what a change touched, what a layer covers, what is to be
// drawn again. An empty rectangle has no width or no height; uniting with
// one gives the other.
//
// Edges are counted in i64 and held to what an i32 holds, so nothing here
// traps whatever the numbers (a rectangle a file or a script names may
// lie anywhere): a rectangle that would reach past the end of an i32 ends
// there.
const ui = @import("std.ui")

pub const Rect = ui.Rect

pub fn rect(x: i32, y: i32, width: i32, height: i32) -> Rect {
    return Rect.{ .x = x, .y = y, .width = width, .height = height }
}

pub fn empty() -> Rect {
    return Rect.{ .x = 0, .y = 0, .width = 0, .height = 0 }
}

pub fn isEmpty(area: Rect) -> bool {
    return area.width <= 0 || area.height <= 0
}

// `value` held to what an i32 holds.
fn fit(value: i64) -> i32 {
    if value > 2147483647 { return 2147483647 }
    if value < 0 - 2147483648 { return 0 - 2147483647 - 1 }
    return @intCast(i32, value)
}

fn wide(value: i32) -> i64 { return @intCast(i64, value) }

pub fn right(area: Rect) -> i32 { return fit(wide(area.x) + wide(area.width)) }
pub fn bottom(area: Rect) -> i32 { return fit(wide(area.y) + wide(area.height)) }

pub fn contains(area: Rect, x: i32, y: i32) -> bool {
    return x >= area.x && y >= area.y && wide(x) < wide(area.x) + wide(area.width) && wide(y) < wide(area.y) + wide(area.height)
}

pub fn same(a: Rect, b: Rect) -> bool {
    return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}

fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }

// The overlap (empty when there is none).
pub fn intersect(a: Rect, b: Rect) -> Rect {
    if isEmpty(a) || isEmpty(b) { return empty() }
    const x = larger(a.x, b.x)
    const y = larger(a.y, b.y)
    const width = wide(smaller(right(a), right(b))) - wide(x)
    const height = wide(smaller(bottom(a), bottom(b))) - wide(y)
    if width <= 0 || height <= 0 { return empty() }
    return rect(x, y, fit(width), fit(height))
}

// The smallest rectangle around both.
pub fn unite(a: Rect, b: Rect) -> Rect {
    if isEmpty(a) { return b }
    if isEmpty(b) { return a }
    const x = smaller(a.x, b.x)
    const y = smaller(a.y, b.y)
    return rect(x, y, fit(wide(larger(right(a), right(b))) - wide(x)), fit(wide(larger(bottom(a), bottom(b))) - wide(y)))
}

// The rectangle moved by (dx, dy).
pub fn moved(area: Rect, dx: i32, dy: i32) -> Rect {
    return rect(fit(wide(area.x) + wide(dx)), fit(wide(area.y) + wide(dy)), area.width, area.height)
}

// The rectangle grown by `margin` on every side (shrunk by a negative
// one; never below empty).
pub fn grown(area: Rect, margin: i32) -> Rect {
    if isEmpty(area) { return area }
    const width = wide(area.width) + wide(margin) * 2
    const height = wide(area.height) + wide(margin) * 2
    if width <= 0 || height <= 0 { return empty() }
    return rect(fit(wide(area.x) - wide(margin)), fit(wide(area.y) - wide(margin)), fit(width), fit(height))
}

// The rectangle between two corners given in any order, both inside it.
pub fn fromCorners(x0: i32, y0: i32, x1: i32, y1: i32) -> Rect {
    const left = smaller(x0, x1)
    const top = smaller(y0, y1)
    return rect(left, top, fit(wide(larger(x0, x1)) - wide(left) + 1), fit(wide(larger(y0, y1)) - wide(top) + 1))
}

// The whole pixels a box with fractional edges touches.
// (Edges beyond an i32 are held to it; a NaN edge gives an empty one.)
pub fn fromBounds(left: f64, top: f64, right_edge: f64, bottom_edge: f64) -> Rect {
    if !(left == left) || !(top == top) || !(right_edge == right_edge) || !(bottom_edge == bottom_edge) { return empty() }
    const x0 = edge(@floor(left))
    const y0 = edge(@floor(top))
    const x1 = edge(@ceil(right_edge))
    const y1 = edge(@ceil(bottom_edge))
    if x1 <= x0 || y1 <= y0 { return empty() }
    return rect(fit(x0), fit(y0), fit(x1 - x0), fit(y1 - y0))
}

// A whole number of f64 as an i64 held to what an i32 holds.
fn edge(value: f64) -> i64 {
    if value >= 2147483647.0 { return 2147483647 }
    if value <= -2147483648.0 { return 0 - 2147483648 }
    return @intFromFloat(i64, value)
}

pub fn clampInt(value: i32, low: i32, high: i32) -> i32 {
    return if value < low { low } else if value > high { high } else { value }
}
