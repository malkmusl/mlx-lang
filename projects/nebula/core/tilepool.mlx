// nebula core: where tiles come from. A picture is thousands of tiles of
// 16 KiB; taken one by one from the heap they would be thousands of the
// heap's slabs, and brixOS gives a process 256 memory regions in all
// (each slab is one). So tiles are cut from a few large blocks (16 MiB:
// one region each, and only the pages touched take memory, on Linux as on
// brixOS), kept in a list of free ones per block, and a block goes back
// to the heap when its last tile is given back.
//
// One pool for the program (one thread paints); core/device.mlx is its
// only caller.
const std = @import("std")

const BLOCK: usize = 16777216
const BLOCKS: usize = 240

// What a tile is to the pool: its first word links the free ones, its
// second says which block it is from (core/device.mlx's Tile starts with
// the same two words: refs and spare).
const Slot = struct {
    next: usize
    block: usize
}

const Block = struct {
    memory: usize
    // Tiles handed out of it, tiles never handed out yet (from `fresh`
    // on), and the free ones given back.
    used: usize
    fresh: usize
    free: usize
}

var blocks: [240]Block = undefined
var count: usize = 0
var tile_bytes: usize = 0
var per_block: usize = 0
var live: usize = 0
// The block looked at first.
var current: usize = 0

fn slotAt(address: usize) -> *Slot { unsafe { return @ptrFromInt(*Slot, address) } }

// Tiles in use, and the blocks they are cut from.
pub fn liveTiles() -> usize { return live }
pub fn blockCount() -> usize { return count }

fn takeFrom(index: usize) -> usize {
    const block = &blocks[index]
    var address: usize = 0
    if block.*.free != 0 {
        address = block.*.free
        block.*.free = slotAt(address).*.next
    } else if block.*.fresh < per_block {
        address = block.*.memory + block.*.fresh * tile_bytes
        block.*.fresh += 1
    } else {
        return 0
    }
    block.*.used += 1
    slotAt(address).*.block = index
    return address
}

// Memory for one tile of `bytes` (the same size at every call; its second
// word is the pool's until it is given back). Null without memory.
pub fn take(bytes: usize) -> ?[*]u8 {
    if tile_bytes == 0 {
        tile_bytes = (bytes + 15) & ~@intCast(usize, 15)
        per_block = BLOCK / tile_bytes
    }
    if bytes > tile_bytes { return null }
    var address: usize = 0
    if current < count && blocks[current].memory != 0 { address = takeFrom(current) }
    var index: usize = 0
    var empty = count
    while address == 0 && index < count {
        if blocks[index].memory == 0 {
            if empty == count { empty = index }
        } else {
            address = takeFrom(index)
            if address != 0 { current = index }
        }
        index += 1
    }
    if address == 0 {
        if empty == count && count >= BLOCKS { return null }
        const memory = std.heap.allocator().alloc(BLOCK, 4096)
        if memory == null { return null }
        blocks[empty] = Block.{ .memory = @intFromPtr(memory.?), .used = 0, .fresh = 0, .free = 0 }
        if empty == count { count += 1 }
        current = empty
        address = takeFrom(empty)
    }
    live += 1
    unsafe { return @ptrFromInt([*]u8, address) }
}

// A tile's memory back to the pool.
pub fn give(memory: [*]u8) -> void {
    const address = @intFromPtr(memory)
    const index = slotAt(address).*.block
    if index >= count || blocks[index].memory == 0 { return }
    const block = &blocks[index]
    slotAt(address).*.next = block.*.free
    block.*.free = address
    block.*.used -= 1
    live -= 1
    if block.*.used == 0 {
        // Nothing of the block is in use: the heap has it again.
        unsafe { std.heap.allocator().free(@ptrFromInt([*]u8, block.*.memory), BLOCK, 4096) }
        block.*.memory = 0
        block.*.free = 0
        block.*.fresh = 0
        while count > 0 && blocks[count - 1].memory == 0 { count -= 1 }
        if current >= count { current = 0 }
    }
}
