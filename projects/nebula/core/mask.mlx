// nebula core: masks. A mask is a Device of opaque greys (core/pixel.mlx's
// gray): 0 nothing, 255 all, between them partly. The selection is one, a
// layer's transparency mask, what a filter layer filters. Being a Device of
// ordinary pixels it is painted, filled, filtered, transformed and undone
// like a layer; here is what reads it as amounts (a byte a pixel).
const std = @import("std")
const device_module = @import("./device.mlx")
const geom = @import("./geom.mlx")
const pixel = @import("./pixel.mlx")

pub const Device = device_module.Device
pub const Rect = geom.Rect
pub const Allocator = std.allocator.Allocator

pub const NOTHING: u32 = 0xFF000000
pub const ALL: u32 = 0xFFFFFFFF

// A mask of nothing (`all`: of everything). Null without memory.
pub fn create(allocator: Allocator, all: bool) -> ?*Device {
    return device_module.create(allocator, if all { ALL } else { NOTHING })
}

// The amount at (x, y).
pub fn at(mask: *Device, x: i32, y: i32) -> u32 {
    return device_module.pixel(mask, x, y) & 255
}

pub fn set(mask: *Device, x: i32, y: i32, amount: u32) -> void {
    device_module.setPixel(mask, x, y, pixel.gray(amount))
}

fn larger(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }
fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }

// The amounts of `area`, a byte a pixel, `stride` bytes from one row to
// the next.
pub fn readBytes(mask: *Device, area: Rect, into: [*]u8, stride: usize) -> void {
    if geom.isEmpty(area) { return }
    const left = area.x - mask.*.x
    const top = area.y - mask.*.y
    const right = left + area.width
    const bottom = top + area.height
    const blank = @intCast(u8, mask.*.defaultPixel & 255)
    var ty = top >> 6
    while ty <= (bottom - 1) >> 6 {
        const row0 = larger(top, ty * 64)
        const row1 = smaller(bottom, ty * 64 + 64)
        var tx = left >> 6
        while tx <= (right - 1) >> 6 {
            const col0 = larger(left, tx * 64)
            const col1 = smaller(right, tx * 64 + 64)
            const span = @intCast(usize, col1 - col0)
            const source = device_module.tileRead(mask, tx, ty)
            var row = row0
            while row < row1 {
                const target = into + (@intCast(usize, row - top) * stride + @intCast(usize, col0 - left))
                if source == null {
                    std.mem.set(target, blank, span)
                } else {
                    const words = source.? + @intCast(usize, ((row & 63) << 6) | (col0 & 63))
                    var index: usize = 0
                    while index < span {
                        target[index] = @intCast(u8, words[index] & 255)
                        index += 1
                    }
                }
                row += 1
            }
            tx += 1
        }
        ty += 1
    }
}

// The amounts of `area` from bytes (`stride` a row). False without memory.
pub fn writeBytes(mask: *Device, area: Rect, from: [*]const u8, stride: usize) -> bool {
    if geom.isEmpty(area) { return true }
    const left = area.x - mask.*.x
    const top = area.y - mask.*.y
    const right = left + area.width
    const bottom = top + area.height
    var whole = true
    var ty = top >> 6
    while ty <= (bottom - 1) >> 6 {
        const row0 = larger(top, ty * 64)
        const row1 = smaller(bottom, ty * 64 + 64)
        var tx = left >> 6
        while tx <= (right - 1) >> 6 {
            const col0 = larger(left, tx * 64)
            const col1 = smaller(right, tx * 64 + 64)
            const span = @intCast(usize, col1 - col0)
            const target = device_module.tileWrite(mask, tx, ty)
            if target == null {
                whole = false
            } else {
                var row = row0
                while row < row1 {
                    const source = from + (@intCast(usize, row - top) * stride + @intCast(usize, col0 - left))
                    const words = target.? + @intCast(usize, ((row & 63) << 6) | (col0 & 63))
                    var index: usize = 0
                    while index < span {
                        words[index] = pixel.gray(@intCast(u32, source[index]))
                        index += 1
                    }
                    row += 1
                }
            }
            tx += 1
        }
        ty += 1
    }
    return whole
}

// The image's rectangle around every pixel that differs from the mask's
// default: around everything that is more than nothing, for a mask whose
// default is nothing (see reachesEverywhere for the others).
pub fn bounds(mask: *Device) -> Rect {
    return device_module.exactBounds(mask)
}

// Whether the mask is more than nothing somewhere no tile says so (its
// default is): then bounds() is not all of it.
pub fn reachesEverywhere(mask: *Device) -> bool {
    return mask.*.defaultPixel & 255 != 0
}

// Whether there is anything at all.
pub fn isNothing(mask: *Device) -> bool {
    if reachesEverywhere(mask) { return false }
    var keys = std.ArrayList(u64).init(mask.*.allocator)
    defer keys.deinit()
    if !device_module.keys(mask, &keys) { return false }
    for key in keys.items() {
        const tile = device_module.tileRead(mask, device_module.keyX(key), device_module.keyY(key))
        if tile != null {
            var index: usize = 0
            while index < device_module.TILE_PIXELS {
                if tile.?[index] & 255 != 0 { return false }
                index += 1
            }
        }
    }
    return true
}
