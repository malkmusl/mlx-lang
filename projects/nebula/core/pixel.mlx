// nebula core: a pixel's parts and the arithmetic every pixel loop shares.
//
// A pixel is a u32, 0xAARRGGBB, alpha straight (the colour is the colour
// whatever the alpha): core/device.mlx keeps such, the file formats too.
// What the window shows is premultiplied (std.ui.canvas): premultiplied()
// at the very end. A mask's pixel is an opaque grey, gray(value): its
// value is any of its colour bytes (value()).
//
// Channels and weights are 0-255 in u32; mul(a, b) is a * b / 255 rounded
// (exactly (a * b + 127) / 255, without dividing).

pub const TRANSPARENT: u32 = 0
pub const BLACK: u32 = 0xFF000000
pub const WHITE: u32 = 0xFFFFFFFF

pub inline fn alpha(pixel: u32) -> u32 { return pixel >> 24 }
pub inline fn red(pixel: u32) -> u32 { return (pixel >> 16) & 255 }
pub inline fn green(pixel: u32) -> u32 { return (pixel >> 8) & 255 }
pub inline fn blue(pixel: u32) -> u32 { return pixel & 255 }

pub inline fn pack(a: u32, r: u32, g: u32, b: u32) -> u32 {
    return (a << 24) | (r << 16) | (g << 8) | b
}

pub inline fn rgb(r: u32, g: u32, b: u32) -> u32 {
    return 0xFF000000 | (r << 16) | (g << 8) | b
}

// The pixel's colour at another alpha.
pub inline fn withAlpha(pixel: u32, a: u32) -> u32 {
    return (pixel & 0x00FFFFFF) | (a << 24)
}

// A mask's pixel for `amount` (0: nothing, 255: all), and the amount of one.
pub inline fn gray(amount: u32) -> u32 {
    return 0xFF000000 | (amount << 16) | (amount << 8) | amount
}

pub inline fn value(pixel: u32) -> u32 { return pixel & 255 }

// a * b / 255, rounded; a and b 0-255.
pub inline fn mul(a: u32, b: u32) -> u32 {
    const product = a * b + 128
    return (product + (product >> 8)) >> 8
}

// a * b * c / 255 / 255, rounded.
pub inline fn mul3(a: u32, b: u32, c: u32) -> u32 {
    return (a * b * c + 32512) / 65025
}

// a * 255 / b held at 255 (0 for b = 0).
pub inline fn div(a: u32, b: u32) -> u32 {
    if b == 0 { return 0 }
    const quotient = (a * 255 + b / 2) / b
    return if quotient > 255 { 255 } else { quotient }
}

// From `a` (t = 0) to `b` (t = 255).
pub inline fn lerp(a: u32, b: u32, t: u32) -> u32 {
    const sum = a * (255 - t) + b * t + 128
    return (sum + (sum >> 8)) >> 8
}

pub inline fn clamp(channel: i32) -> u32 {
    return @intCast(u32, if channel < 0 { 0 } else if channel > 255 { 255 } else { channel })
}

pub inline fn smaller(a: u32, b: u32) -> u32 { return if a < b { a } else { b } }
pub inline fn larger(a: u32, b: u32) -> u32 { return if a > b { a } else { b } }

// How light a colour is, 0-255 (Rec. 601 weights, as the grey of a mask
// made from a picture).
pub inline fn luma(pixel: u32) -> u32 {
    return (red(pixel) * 77 + green(pixel) * 150 + blue(pixel) * 29 + 128) >> 8
}

// The pixel as the window wants it: colour times alpha.
pub fn premultiplied(pixel: u32) -> u32 {
    const a = pixel >> 24
    if a == 255 { return pixel }
    if a == 0 { return 0 }
    return (a << 24) | (mul(red(pixel), a) << 16) | (mul(green(pixel), a) << 8) | mul(blue(pixel), a)
}

// A premultiplied pixel as a straight one.
pub fn straight(pixel: u32) -> u32 {
    const a = pixel >> 24
    if a == 255 { return pixel }
    if a == 0 { return 0 }
    return (a << 24) | (div(red(pixel), a) << 16) | (div(green(pixel), a) << 8) | div(blue(pixel), a)
}

// `source` at `opacity` (0-255) over `under`: the normal mix of two
// straight pixels.
pub fn over(under: u32, source: u32, opacity: u32) -> u32 {
    var sa = source >> 24
    if opacity < 255 { sa = mul(sa, opacity) }
    if sa == 0 { return under }
    if sa == 255 { return source | 0xFF000000 }
    const ua = under >> 24
    if ua == 0 { return (sa << 24) | (source & 0x00FFFFFF) }
    if ua == 255 {
        return 0xFF000000 | (lerp(red(under), red(source), sa) << 16) | (lerp(green(under), green(source), sa) << 8) | lerp(blue(under), blue(source), sa)
    }
    // Both translucent: alpha sa + ua (1 - sa), each colour weighed by
    // its share of it.
    const keep = ua * (255 - sa)
    const total = sa * 255 + keep
    const half = total / 2
    const r = (red(source) * sa * 255 + red(under) * keep + half) / total
    const g = (green(source) * sa * 255 + green(under) * keep + half) / total
    const b = (blue(source) * sa * 255 + blue(under) * keep + half) / total
    return (((total + 127) / 255) << 24) | (r << 16) | (g << 8) | b
}

// `count` pixels of `source` at `opacity` over those at `under`.
pub fn overSpan(under: [*]u32, source: [*]const u32, count: usize, opacity: u32) -> void {
    var index: usize = 0
    while index < count {
        const pixel = source[index]
        if pixel >> 24 != 0 {
            if pixel >> 24 == 255 && opacity == 255 {
                under[index] = pixel
            } else {
                under[index] = over(under[index], pixel, opacity)
            }
        }
        index += 1
    }
}

// One colour over `count` pixels, each at its own coverage (0-255) times
// `opacity`: a brush's dab, a shape's edge.
pub fn coverSpan(under: [*]u32, coverage: [*]const u8, count: usize, color: u32, opacity: u32) -> void {
    const base = mul(color >> 24, opacity)
    if base == 0 { return }
    const solid = color | 0xFF000000
    var index: usize = 0
    while index < count {
        const cover = @intCast(u32, coverage[index])
        if cover != 0 {
            under[index] = over(under[index], solid, mul(base, cover))
        }
        index += 1
    }
}

// `count` pixels made more transparent, each by its coverage times
// `opacity` (an eraser's dab): alpha times (1 - that), the colour stays.
pub fn eraseSpan(under: [*]u32, coverage: [*]const u8, count: usize, opacity: u32) -> void {
    var index: usize = 0
    while index < count {
        const cover = mul(@intCast(u32, coverage[index]), opacity)
        if cover != 0 {
            const pixel = under[index]
            const a = mul(pixel >> 24, 255 - cover)
            under[index] = if a == 0 { 0 } else { (pixel & 0x00FFFFFF) | (a << 24) }
        }
        index += 1
    }
}

// `count` straight pixels as premultiplied ones (what a std.ui canvas and
// std.png's Image hold), and back.
pub fn premultiplySpan(target: [*]u32, source: [*]const u32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        const pixel = source[index]
        target[index] = if pixel >> 24 == 255 { pixel } else { premultiplied(pixel) }
        index += 1
    }
}

pub fn straightenSpan(target: [*]u32, source: [*]const u32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        const pixel = source[index]
        target[index] = if pixel >> 24 == 255 { pixel } else { straight(pixel) }
        index += 1
    }
}

// From pixel `a` (t = 0) to `b` (t = 255), alpha and colour; the colour
// of a transparent end does not count.
pub fn mix(a: u32, b: u32, t: u32) -> u32 {
    if t == 0 { return a }
    if t == 255 { return b }
    const aa = a >> 24
    const ba = b >> 24
    if aa == 255 && ba == 255 {
        return 0xFF000000 | (lerp(red(a), red(b), t) << 16) | (lerp(green(a), green(b), t) << 8) | lerp(blue(a), blue(b), t)
    }
    const wa = aa * (255 - t)
    const wb = ba * t
    const total = wa + wb
    if total == 0 { return 0 }
    const half = total / 2
    const r = (red(a) * wa + red(b) * wb + half) / total
    const g = (green(a) * wa + green(b) * wb + half) / total
    const bl = (blue(a) * wa + blue(b) * wb + half) / total
    return (((total + 127) / 255) << 24) | (r << 16) | (g << 8) | bl
}
