const std = @import("std")
const common = @import("../common.mlx")

fn printHelp() -> u8 {
    return if std.io.print("Usage: unlink FILE\nRemove the specified FILE.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--help") { return printHelp() }
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--version") {
        return if std.io.print("mlx unlink 0.1.0\n") { 0 } else { 1 }
    }
    const first: usize = if count > 1 && common.equals(std.process.argument(arguments, 1), "--") { 2 } else { 1 }
    if count != first + 1 {
        common.writeMessage("unlink", "expected exactly one file")
        return 1
    }
    const path = std.process.argument(arguments, first)
    if !std.fs.delete(path.pointer) {
        common.writePathError("unlink", "cannot unlink", path)
        return 1
    }
    return 0
}
