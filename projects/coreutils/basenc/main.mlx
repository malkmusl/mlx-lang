const std = @import("std")
const common = @import("../common.mlx")
const codec = @import("../codec.mlx")

const Options = struct {
    decode: bool
    ignoreGarbage: bool
    wrap: usize
    wrapSet: bool
    mode: u8
    modeSet: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .decode = false, .ignoreGarbage = false, .wrap = 76, .wrapSet = false, .mode = 0, .modeSet = false,
        .action = 0, .invalid = false, .firstFile = 1,
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-d") || common.equals(argument, "--decode") {
            result.decode = true
            index += 1
            continue
        }
        if common.equals(argument, "-i") || common.equals(argument, "--ignore-garbage") {
            result.ignoreGarbage = true
            index += 1
            continue
        }
        if common.equals(argument, "--base64") {
            result.mode = 0
            result.modeSet = true
            index += 1
            continue
        }
        if common.equals(argument, "--base64url") {
            result.mode = 1
            result.modeSet = true
            index += 1
            continue
        }
        if common.equals(argument, "--base32") {
            result.mode = 2
            result.modeSet = true
            index += 1
            continue
        }
        if common.equals(argument, "--base32hex") {
            result.mode = 3
            result.modeSet = true
            index += 1
            continue
        }
        if common.equals(argument, "--base16") {
            result.mode = 4
            result.modeSet = true
            index += 1
            continue
        }
        if common.equals(argument, "--base2msbf") {
            result.mode = 5
            result.modeSet = true
            index += 1
            continue
        }
        if common.equals(argument, "--base2lsbf") {
            result.mode = 6
            result.modeSet = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--wrap=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 7, argument.length))
            if !parsed.valid { result.invalid = true } else {
                result.wrap = parsed.value
                result.wrapSet = true
            }
            index += 1
            continue
        }
        if common.equals(argument, "-w") || (argument.length > 2 && argument.pointer[1] == 119) {
            var text = std.string.slice(argument, 2, argument.length)
            if text.length == 0 {
                index += 1
                if index >= count {
                    result.invalid = true
                    break
                }
                text = std.process.argument(arguments, index)
            }
            const parsed = std.parse.unsigned(text)
            if !parsed.valid { result.invalid = true } else {
                result.wrap = parsed.value
                result.wrapSet = true
            }
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn readInput(path: std.string.String) -> std.fs.ArrayList {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if common.isDash(path) { return std.fs.readToEndAlloc(std.io.stdin(), allocator) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return std.array_list.ArrayList.init(allocator, 0) }
    const data = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return data
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: basenc [OPTION]... [FILE]\nbasenc encode or decode FILE, or standard input, to standard output.\n      --base64          same as 'base64' program (RFC4648 section 4)\n      --base64url       file- and url-safe base64 (RFC4648 section 5)\n      --base32          same as 'base32' program (RFC4648 section 6)\n      --base32hex       extended hex alphabet base32 (RFC4648 section 7)\n      --base16          hex encoding (RFC4648 section 8)\n      --base2msbf       bit string with most significant bit (msb) first\n      --base2lsbf       bit string with least significant bit (lsb) first\n  -d, --decode          decode data\n  -i, --ignore-garbage  when decoding, ignore non-alphabet characters\n  -w, --wrap=COLS       wrap encoded lines after COLS character (default 76).\n                          Use 0 to disable line wrapping\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx basenc 0.1.0\n") { 0 } else { 1 } }
    if !options.modeSet {
        common.writeMessage("basenc", "missing encoding type")
        return 1
    }
    if options.invalid {
        common.writeMessage("basenc", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    const path = if options.firstFile < count { std.process.argument(arguments, options.firstFile) } else { std.string.fromSlice("-") }
    if options.firstFile + 1 < count {
        common.writeMessage("basenc", "extra operand")
        return 1
    }
    const wrap = options.wrap
    const input = readInput(path)
    var status: u8 = 0
    unsafe {
        var data: [*]const u8 = undefined
        data = @ptrCast([*]const u8, input.items)
        if options.mode == 5 || options.mode == 6 {
            const msb = options.mode == 5
            if options.decode {
                const result = codec.decodeBase2(data, input.length, msb, options.ignoreGarbage)
                if !std.io.writeAllBytes(std.io.stdout(), result.data, result.length) { status = 1 }
                if !result.ok {
                    common.writeMessage("basenc", "invalid input")
                    status = 1
                }
            } else {
                const result = codec.encodeBase2(data, input.length, msb)
                if !codec.writeWrapped(std.io.stdout(), result.data, result.length, wrap) { status = 1 }
            }
        } else {
            var alphabet: [*]const u8 = undefined
            var bits_per_char: usize = 6
            var group_chars: usize = 4
            var use_padding = true
            if options.mode == 0 {
                alphabet = codec.base64Alphabet()
            } else if options.mode == 1 {
                alphabet = codec.base64UrlAlphabet()
            } else if options.mode == 2 {
                alphabet = codec.base32Alphabet()
                bits_per_char = 5
                group_chars = 8
            } else if options.mode == 3 {
                alphabet = codec.base32HexAlphabet()
                bits_per_char = 5
                group_chars = 8
            } else {
                alphabet = codec.base16Alphabet()
                bits_per_char = 4
                group_chars = 2
                use_padding = false
            }
            if options.decode {
                const alphabet_length: usize = if bits_per_char == 6 { 64 } else if bits_per_char == 5 { 32 } else { 16 }
                const lookup = codec.buildLookup(alphabet, alphabet_length)
                const result = codec.decodeGeneric(data, input.length, lookup, bits_per_char, options.ignoreGarbage)
                if !std.io.writeAllBytes(std.io.stdout(), result.data, result.length) { status = 1 }
                if !result.ok {
                    common.writeMessage("basenc", "invalid input")
                    status = 1
                }
            } else {
                const result = codec.encodeGeneric(data, input.length, alphabet, bits_per_char, group_chars, use_padding)
                if !codec.writeWrapped(std.io.stdout(), result.data, result.length, wrap) { status = 1 }
            }
        }
    }
    input.deinit()
    return status
}
