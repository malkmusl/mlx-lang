// strftime as GNU's coreutils 9.11 have it (gnulib's nstrftime over glibc,
// the C locale):
// every conversion (%a %A %b %B %c %C %d %D %e %F %g %G %h %H %I %j %k
// %l %m %M %n %N %p %P %q %r %R %s %S %t %T %u %U %V %w %W %x %X %y %Y
// %z %:z %::z %:::z %Z %%), the flags _ - 0 + ^ #, a field width, the E
// and O modifiers (which change nothing in the C locale, or make the
// conversion print as it is written), and what an unknown or unfinished
// one prints (itself). Function for function after gnulib's
// __strftime_internal.
const std = @import("std")
const timezone = @import("./ls/timezone.mlx")

// A broken-down time (struct tm, with what %N, %z and %Z need).
pub const Time = struct {
    // tm_year + 1900, tm_mon + 1, tm_mday...
    year: isize
    month: isize
    day: isize
    hour: isize
    minute: isize
    second: isize
    // 0 Sunday; 1 the first of January.
    weekday: isize
    yearDay: isize
    nanoseconds: isize
    // Seconds east of UTC, and the zone's abbreviation.
    offset: isize
    zone: std.string.String
    // The seconds since 1970 (for %s).
    seconds: isize
}

// The text made: bytes the allocator gave (free with release).
pub const Text = struct {
    bytes: [*]u8
    length: usize
    capacity: usize
}

const ZERO_PAD: u8 = 0
const ALWAYS_ZERO_PAD: u8 = 1
const SIGN_PAD: u8 = 2
const SPACE_PAD: u8 = 3
const NO_PAD: u8 = 4

const WEEKDAYS = [7][]const u8{ "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" }
const MONTHS = [12][]const u8{ "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" }

fn leap(year: isize) -> bool { return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }

fn monthDays(year: isize, month: isize) -> isize {
    if month == 2 { return if leap(year) { 29 } else { 28 } }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

// `seconds` in the zone of `context`, broken down.
pub fn local(seconds: isize, nanoseconds: isize, context: timezone.Context) -> Time {
    const offset = timezone.offset(context, seconds)
    const shiftedSeconds = seconds + offset
    const days = if shiftedSeconds >= 0 { shiftedSeconds / 86400 } else { -((-shiftedSeconds + 86399) / 86400) }
    const clock = shiftedSeconds - days * 86400
    const shifted = days + 719468
    const era = if shifted >= 0 { shifted / 146097 } else { (shifted - 146096) / 146097 }
    const dayOfEra = shifted - era * 146097
    const yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var year = yearOfEra + era * 400
    const dayOfYearMarch = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    const monthPart = (5 * dayOfYearMarch + 2) / 153
    const day = dayOfYearMarch - (153 * monthPart + 2) / 5 + 1
    const month = if monthPart < 10 { monthPart + 3 } else { monthPart - 9 }
    if month <= 2 { year += 1 }
    var yearDay = day
    var scan: isize = 1
    while scan < month {
        yearDay += monthDays(year, scan)
        scan += 1
    }
    var weekday = (days + 4) % 7
    if weekday < 0 { weekday += 7 }
    return Time.{ .year = year, .month = month, .day = day, .hour = clock / 3600, .minute = clock / 60 % 60, .second = clock % 60, .weekday = weekday, .yearDay = yearDay, .nanoseconds = nanoseconds, .offset = offset, .zone = timezone.abbreviation(context, seconds), .seconds = seconds }
}

// ---- the text ----

fn grow(text: *Text, more: usize) -> void {
    if text.*.length + more <= text.*.capacity { return }
    var capacity = text.*.capacity * 2 + 64
    while capacity < text.*.length + more { capacity *= 2 }
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const bytes = allocator.alloc(capacity, 1).?
    var k: usize = 0
    while k < text.*.length {
        bytes[k] = text.*.bytes[k]
        k += 1
    }
    if text.*.capacity > 0 { allocator.free(text.*.bytes, text.*.capacity, 1) }
    text.*.bytes = bytes
    text.*.capacity = capacity
}

fn put(text: *Text, byte: u8) -> void {
    grow(text, 1)
    text.*.bytes[text.*.length] = byte
    text.*.length += 1
}

pub fn release(text: Text) -> void {
    if text.capacity == 0 { return }
    const allocator: std.allocator.Allocator = std.heap.allocator()
    allocator.free(text.bytes, text.capacity, 1)
}

fn empty() -> Text {
    var text: Text = undefined
    text.length = 0
    text.capacity = 0
    return text
}

// What one conversion is being made with.
const Field = struct {
    pad: u8
    width: isize
    upper: bool
    lower: bool
}

// width_add: `n` bytes (from `bytes`, cased as the field says) after the
// padding the width asks.
fn add(text: *Text, field: Field, bytes: [*]const u8, n: usize) -> void {
    const w: usize = if field.pad == NO_PAD || field.width < 0 { 0 } else { @bitCast(usize, field.width) }
    if n < w {
        var delta = w - n
        const fill: u8 = if field.pad == ALWAYS_ZERO_PAD || field.pad == SIGN_PAD { 48 } else { 32 }
        while delta > 0 {
            put(text, fill)
            delta -= 1
        }
    }
    var k: usize = 0
    while k < n {
        var byte = bytes[k]
        if field.lower {
            if byte >= 65 && byte <= 90 { byte += 32 }
        } else if field.upper {
            if byte >= 97 && byte <= 122 { byte -= 32 }
        }
        put(text, byte)
        k += 1
    }
}

fn addSlice(text: *Text, field: Field, bytes: []const u8) -> void {
    unsafe { add(text, field, @ptrCast([*]const u8, bytes), bytes.length) }
}

fn isoWeekDays(yday: isize, wday: isize) -> isize {
    const big = (366 / 7 + 2) * 7
    return yday - (yday - wday + 4 + big) % 7 + 4 - 1
}

// The number part of a conversion (do_number_body and on): the digits of
// `magnitude` with colons where `mask` says, a sign, the padding.
fn number(text: *Text, field: Field, digits: isize, negative: bool, alwaysSign: bool, magnitudeIn: usize, maskIn: usize) -> void {
    var buffer: [40]u8 = undefined
    var at: usize = 40
    var magnitude = magnitudeIn
    var mask = maskIn
    while true {
        if mask & 1 != 0 {
            at -= 1
            buffer[at] = 58
        }
        mask >>= 1
        at -= 1
        buffer[at] = @intCast(u8, 48 + magnitude % 10)
        magnitude /= 10
        if magnitude == 0 && mask == 0 { break }
    }
    signAndPadding(text, field, digits, negative, alwaysSign, &buffer, at, 40)
}

fn signAndPadding(text: *Text, fieldIn: Field, digits: isize, negative: bool, alwaysSign: bool, buffer: *[40]u8, at: usize, end: usize) -> void {
    var field = fieldIn
    if field.pad == ZERO_PAD { field.pad = ALWAYS_ZERO_PAD }
    if field.width < 0 { field.width = digits }
    const sign: u8 = if negative { 45 } else if alwaysSign { 43 } else { 0 }
    const numberBytes = end - at
    const shortage = field.width - (if sign != 0 { 1 } else { 0 }) - @bitCast(isize, numberBytes)
    const padding: isize = if field.pad == NO_PAD || shortage <= 0 { 0 } else { shortage }
    if sign != 0 {
        if field.pad == SPACE_PAD {
            var k: isize = 0
            while k < padding {
                put(text, 32)
                k += 1
            }
            field.width -= padding
        }
        put(text, sign)
        field.width -= 1
    }
    unsafe { add(text, field, @ptrFromInt([*]const u8, @intFromPtr(buffer) + at), numberBytes) }
}

// A value (with its sign) as DO_NUMBER and its kin make it.
fn signed(text: *Text, field: Field, digits: isize, value: isize) -> void {
    const negative = value < 0
    number(text, field, digits, negative, false, if negative { @bitCast(usize, -value) } else { @bitCast(usize, value) }, 0)
}

fn yearish(text: *Text, fieldIn: Field, digits: isize, negative: bool, magnitude: usize, yearSpec: u8) -> void {
    var field = fieldIn
    if field.pad == ZERO_PAD { field.pad = yearSpec }
    const limit: usize = if digits == 2 { 99 } else { 9999 }
    const alwaysSign = field.pad == SIGN_PAD && (limit < magnitude || digits < field.width)
    number(text, field, digits, negative, alwaysSign, magnitude, 0)
}

fn spacePadded(text: *Text, fieldIn: Field, digits: isize, value: isize) -> void {
    var field = fieldIn
    if field.pad == ZERO_PAD { field.pad = SPACE_PAD }
    signed(text, field, digits, value)
}

// A subformat (%D, %F, %R, %T): made apart, then added as one piece; as in
// coreutils 9.11 the conversion's padding goes on to the year fields in it.
fn subformat(text: *Text, field: Field, format: []const u8, time: Time, subwidth: isize) -> void {
    var inner = empty()
    run(&inner, format, time, field.upper, field.pad, subwidth)
    var plain = field
    plain.upper = false
    plain.lower = false
    if inner.length > 0 { add(text, plain, inner.bytes, inner.length) } else { addSlice(text, plain, "") }
    release(inner)
}

// What coreutils asks the C library's strftime for (%c, %x, %X, %r, and
// %EC %Ey %EY): the C locale's text made without the field's flags, then
// added with its width, padding and case as one piece.
fn underlying(text: *Text, field: Field, format: []const u8, time: Time) -> void {
    var inner = empty()
    run(&inner, format, time, false, ZERO_PAD, -1)
    if inner.length > 0 { add(text, field, inner.bytes, inner.length) } else { addSlice(text, field, "") }
    release(inner)
}

// `format` for `time`.
pub fn format(formatText: []const u8, time: Time) -> Text {
    var text = empty()
    run(&text, formatText, time, false, ZERO_PAD, -1)
    return text
}

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn run(text: *Text, format: []const u8, time: Time, upcase: bool, yearSpec: u8, widthIn: isize) -> void {
    var width = widthIn
    const hour12 = if time.hour > 12 { time.hour - 12 } else if time.hour == 0 { 12 } else { time.hour }
    // tm's fields as strftime has them.
    const tmYear = time.year - 1900
    const tmYday = time.yearDay - 1
    const tmMon = time.month - 1
    var f: usize = 0
    while f < format.length {
        if format[f] != 37 {
            addSlice(text, Field.{ .pad = ZERO_PAD, .width = width, .upper = false, .lower = false }, format[f..f + 1])
            width = -1
            f += 1
            continue
        }
        const percent = f
        var pad = ZERO_PAD
        var upper = upcase
        var lower = false
        var changeCase = false
        // Flags.
        while true {
            f += 1
            if f >= format.length { break }
            const byte = format[f]
            if byte == 95 { pad = SPACE_PAD } else if byte == 45 { pad = NO_PAD } else if byte == 43 { pad = SIGN_PAD } else if byte == 48 { pad = ALWAYS_ZERO_PAD } else if byte == 94 {
                upper = true
            } else if byte == 35 { changeCase = true } else { break }
        }
        if f < format.length && isDigit(format[f]) {
            width = 0
            while f < format.length && isDigit(format[f]) {
                width = width * 10 + @intCast(isize, format[f] - 48)
                if width > 2147483647 { width = 2147483647 }
                f += 1
            }
        }
        var modifier: u8 = 0
        if f < format.length && (format[f] == 69 || format[f] == 79) {
            modifier = format[f]
            f += 1
        }
        // At the end of the format: what was read prints as it is.
        if f >= format.length {
            const field = Field.{ .pad = pad, .width = width, .upper = upper, .lower = false }
            unsafe { add(text, field, @ptrFromInt([*]const u8, @intFromPtr(format.pointer) + percent), f - percent) }
            return
        }
        const c = format[f]
        var bad = false
        var field = Field.{ .pad = pad, .width = width, .upper = upper, .lower = lower }
        if c == 37 {
            if f - 1 != percent {
                // A flag or width before "%%" (bad_percent): the "%", the
                // flags, without this "%" (it starts the next conversion).
                f -= 1
                bad = true
            } else {
                addSlice(text, field, "%")
            }
        } else if c == 97 || c == 65 {
            if modifier != 0 { bad = true } else {
                if changeCase {
                    field.upper = true
                    field.lower = false
                }
                const name = WEEKDAYS[@bitCast(usize, time.weekday)]
                addSlice(text, field, if c == 97 { name[0..3] } else { name })
            }
        } else if c == 98 || c == 104 || c == 66 {
            // (%b and %h take the # before they refuse an E, %B after.)
            if changeCase && c != 66 {
                field.upper = true
                field.lower = false
            }
            if modifier == 69 { bad = true } else {
                if changeCase {
                    field.upper = true
                    field.lower = false
                }
                const name = MONTHS[@bitCast(usize, tmMon)]
                addSlice(text, field, if c == 66 { name } else { name[0..3] })
            }
        } else if c == 99 {
            if modifier == 79 { bad = true } else { underlying(text, field, "%a %b %e %H:%M:%S %Y", time) }
        } else if c == 67 && modifier == 69 {
            underlying(text, field, "%C", time)
        } else if c == 67 {
            const negativeYear = tmYear < -1900
            const zeroThru1899 = !negativeYear && tmYear < 0
            const century = (tmYear - (if zeroThru1899 { 99 } else { 0 })) / 100 + 19
            yearish(text, field, 2, negativeYear, if century < 0 { @bitCast(usize, -century) } else { @bitCast(usize, century) }, yearSpec)
        } else if c == 120 {
            if modifier == 79 { bad = true } else { underlying(text, field, "%m/%d/%y", time) }
        } else if c == 68 {
            if modifier != 0 { bad = true } else { subformat(text, field, "%m/%d/%y", time, -1) }
        } else if c == 100 {
            if modifier == 69 { bad = true } else { signed(text, field, 2, time.day) }
        } else if c == 101 {
            if modifier == 69 { bad = true } else { spacePadded(text, field, 2, time.day) }
        } else if c == 70 {
            if modifier != 0 { bad = true } else {
                var subwidth: isize = 0
                if field.pad == ZERO_PAD && field.width < 0 {
                    field.pad = SIGN_PAD
                    subwidth = 4
                } else {
                    subwidth = field.width - 6
                    if subwidth < 0 { subwidth = 0 }
                }
                subformat(text, field, "%Y-%m-%d", time, subwidth)
            }
        } else if c == 72 {
            if modifier == 69 { bad = true } else { signed(text, field, 2, time.hour) }
        } else if c == 73 {
            if modifier == 69 { bad = true } else { signed(text, field, 2, hour12) }
        } else if c == 107 {
            if modifier == 69 { bad = true } else { spacePadded(text, field, 2, time.hour) }
        } else if c == 108 {
            if modifier == 69 { bad = true } else { spacePadded(text, field, 2, hour12) }
        } else if c == 106 {
            if modifier == 69 { bad = true } else { number(text, field, 3, tmYday < -1, false, @bitCast(usize, if tmYday + 1 < 0 { -(tmYday + 1) } else { tmYday + 1 }), 0) }
        } else if c == 77 {
            if modifier == 69 { bad = true } else { signed(text, field, 2, time.minute) }
        } else if c == 109 {
            if modifier == 69 { bad = true } else { number(text, field, 2, tmMon < -1, false, @bitCast(usize, if tmMon + 1 < 0 { -(tmMon + 1) } else { tmMon + 1 }), 0) }
        } else if c == 78 {
            if modifier == 69 { bad = true } else {
                // The nanoseconds to `width` digits (9), trailing zeros
                // past the width dropped, then padded to the width.
                var n = time.nanoseconds
                if field.width <= 0 { field.width = 9 }
                var ndigs: isize = 9
                while field.width < ndigs || (1 < ndigs && n % 10 == 0) {
                    ndigs -= 1
                    n /= 10
                }
                var buffer: [9]u8 = undefined
                var j = ndigs
                while j > 0 {
                    buffer[@bitCast(usize, j - 1)] = @intCast(u8, 48 + n % 10)
                    n /= 10
                    j -= 1
                }
                if field.pad == ZERO_PAD { field.pad = ALWAYS_ZERO_PAD }
                var noWidth = field
                noWidth.width = 0
                add(text, noWidth, &buffer, @bitCast(usize, ndigs))
                var rest = field
                rest.width = field.width - ndigs
                addSlice(text, rest, "")
            }
        } else if c == 110 {
            addSlice(text, field, "\n")
        } else if c == 80 || c == 112 {
            if c == 80 { field.lower = true }
            if changeCase {
                field.upper = false
                field.lower = true
            }
            addSlice(text, field, if time.hour > 11 { "PM" } else { "AM" })
        } else if c == 113 {
            number(text, field, 1, false, false, @bitCast(usize, ((tmMon * 11) >> 5) + 1), 0)
        } else if c == 82 {
            subformat(text, field, "%H:%M", time, -1)
        } else if c == 114 {
            underlying(text, field, "%I:%M:%S %p", time)
        } else if c == 83 {
            if modifier == 69 { bad = true } else { signed(text, field, 2, time.second) }
        } else if c == 115 {
            var buffer: [40]u8 = undefined
            var at: usize = 40
            const negative = time.seconds < 0
            var t = time.seconds
            while true {
                const d = t % 10
                t /= 10
                at -= 1
                buffer[at] = @intCast(u8, 48 + (if negative { -d } else { d }))
                if t == 0 { break }
            }
            signAndPadding(text, field, 1, negative, false, &buffer, at, 40)
        } else if c == 88 {
            if modifier == 79 { bad = true } else { underlying(text, field, "%H:%M:%S", time) }
        } else if c == 84 {
            subformat(text, field, "%H:%M:%S", time, -1)
        } else if c == 116 {
            addSlice(text, field, "\t")
        } else if c == 117 {
            signed(text, field, 1, (time.weekday - 1 + 7) % 7 + 1)
        } else if c == 85 {
            if modifier == 69 { bad = true } else { signed(text, field, 2, (tmYday - time.weekday + 7) / 7) }
        } else if c == 86 || c == 103 || c == 71 {
            if modifier == 69 { bad = true } else {
                const year = tmYear + (if tmYear < 0 { 300 } else { 300 - 400 })
                var yearAdjust: isize = 0
                var days = isoWeekDays(tmYday, time.weekday)
                if days < 0 {
                    yearAdjust = -1
                    days = isoWeekDays(tmYday + (365 + (if leap(year - 1) { 1 } else { 0 })), time.weekday)
                } else {
                    const d = isoWeekDays(tmYday - (365 + (if leap(year) { 1 } else { 0 })), time.weekday)
                    if 0 <= d {
                        yearAdjust = 1
                        days = d
                    }
                }
                if c == 103 {
                    const yy = (tmYear % 100 + yearAdjust) % 100
                    const value = if 0 <= yy { yy } else if tmYear < -1900 - yearAdjust { -yy } else { yy + 100 }
                    yearish(text, field, 2, false, @bitCast(usize, value), yearSpec)
                } else if c == 71 {
                    const full = tmYear + 1900 + yearAdjust
                    yearish(text, field, 4, tmYear < -1900 - yearAdjust, if full < 0 { @bitCast(usize, -full) } else { @bitCast(usize, full) }, yearSpec)
                } else {
                    signed(text, field, 2, days / 7 + 1)
                }
            }
        } else if c == 87 {
            if modifier == 69 { bad = true } else { signed(text, field, 2, (tmYday - (time.weekday - 1 + 7) % 7 + 7) / 7) }
        } else if c == 119 {
            if modifier == 69 { bad = true } else { signed(text, field, 1, time.weekday) }
        } else if (c == 89 || c == 121) && modifier == 69 {
            underlying(text, field, if c == 89 { "%Y" } else { "%y" }, time)
        } else if c == 89 {
            yearish(text, field, 4, tmYear < -1900, if time.year < 0 { @bitCast(usize, -time.year) } else { @bitCast(usize, time.year) }, yearSpec)
        } else if c == 121 {
            var yy = tmYear % 100
            if yy < 0 { yy = if tmYear < -1900 { -yy } else { yy + 100 } }
            yearish(text, field, 2, false, @bitCast(usize, yy), yearSpec)
        } else if c == 90 {
            if changeCase {
                field.upper = false
                field.lower = true
            }
            add(text, field, time.zone.pointer, time.zone.length)
        } else if c == 58 || c == 122 {
            var colons: usize = 0
            if c == 58 {
                colons = 1
                while f + colons < format.length && format[f + colons] == 58 { colons += 1 }
                if f + colons >= format.length || format[f + colons] != 122 {
                    bad = true
                } else {
                    // (Four colons and more: bad, written up to the z.)
                    f += colons
                    if colons > 3 { bad = true }
                }
            }
            if !bad {
                const diff = time.offset
                var negative = diff < 0
                if diff == 0 { negative = time.zone.length > 0 && time.zone.pointer[0] == 45 }
                const magnitude = if diff < 0 { -diff } else { diff }
                const hours = magnitude / 3600
                const minutes = magnitude / 60 % 60
                const secs = magnitude % 60
                var digits: isize = 5
                var mask: usize = 0
                var value: isize = hours * 100 + minutes
                var kind = colons
                if kind == 3 {
                    if secs != 0 { kind = 2 } else if minutes != 0 { kind = 1 } else { kind = 4 }
                }
                if kind == 1 {
                    digits = 6
                    mask = 4
                } else if kind == 2 {
                    digits = 9
                    mask = 20
                    value = hours * 10000 + minutes * 100 + secs
                } else if kind == 4 {
                    digits = 3
                    value = hours
                }
                number(text, field, digits, negative, true, @bitCast(usize, value), mask)
            }
        } else {
            bad = true
        }
        if bad {
            // The conversion as it is written, from its "%".
            unsafe { add(text, field, @ptrFromInt([*]const u8, @intFromPtr(format.pointer) + percent), f - percent + 1) }
        }
        width = -1
        f += 1
    }
}
