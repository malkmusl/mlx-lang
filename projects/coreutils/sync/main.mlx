const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    dataOnly: bool
    fileSystem: bool
    firstFile: usize
    action: u8
    invalid: bool
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .dataOnly = false, .fileSystem = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstFile < count {
        const argument = std.process.argument(arguments, result.firstFile)
        if common.equals(argument, "--") {
            result.firstFile += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "-d") || common.equals(argument, "--data") {
            result.dataOnly = true
        } else if common.equals(argument, "-f") || common.equals(argument, "--file-system") {
            result.fileSystem = true
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else { result.invalid = true }
        result.firstFile += 1
    }
    if result.dataOnly && result.fileSystem { result.invalid = true }
    return result
}

fn syncPath(path: std.string.String, options: Options) -> bool {
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return false }
    const synced = if options.fileSystem { std.fs.syncFileSystem(file) } else { std.fs.syncFile(file, options.dataOnly) }
    const closed = std.fs.close(file)
    return synced && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: sync [OPTION] [FILE]...\nSynchronize cached writes to persistent storage.\n  -d, --data         sync file data only\n  -f, --file-system  sync filesystems containing the files\n      --help         display this help and exit\n      --version      output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx sync 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.dataOnly && options.firstFile >= count {
        common.writeMessage("sync", "invalid option combination")
        return 1
    }
    if options.firstFile >= count { return if std.fs.syncAll() { 0 } else { 1 } }
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !syncPath(path, options) {
            common.writePathError("sync", "cannot synchronize", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
