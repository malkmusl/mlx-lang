const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    tabWidth: usize
    initial: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .tabWidth = 8, .initial = false, .action = 0, .invalid = false, .firstFile = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--tabs=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 7, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.tabWidth = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-i") || common.equals(argument, "--initial") {
            result.initial = true
            index += 1
            continue
        }
        if common.equals(argument, "-t") || common.equals(argument, "--tabs") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.tabWidth = parsed.value }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 116 {
            const text = std.string.slice(argument, 2, argument.length)
            const parsed = std.parse.unsigned(text)
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.tabWidth = parsed.value }
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn expandLine(file: std.fs.File, line: [*]const u8, length: usize, options: Options, trailing_newline: bool) -> bool {
    var column: usize = 0
    var non_blank_seen = false
    var i: usize = 0
    while i < length {
        const byte = line[i]
        if byte == 9 && (!options.initial || !non_blank_seen) {
            const spaces = options.tabWidth - (column % options.tabWidth)
            var s: usize = 0
            while s < spaces {
                if !std.io.writeAll(file, " ") { return false }
                s += 1
            }
            column += spaces
        } else {
            var buffer: [1]u8 = [1]u8{ byte }
            unsafe { if !std.io.writeAllBytes(file, @ptrCast([*]const u8, buffer[0..1]), 1) { return false } }
            if byte != 32 && byte != 9 { non_blank_seen = true }
            column += 1
        }
        i += 1
    }
    if trailing_newline { return std.io.writeAll(file, "\n") }
    return true
}

fn processBuffer(file: std.fs.File, options: Options, data: [*]const u8, length: usize) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index < length {
        if data[index] == 10 {
            var line: [*]const u8 = undefined
            unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
            if !expandLine(file, line, index - start, options, true) { return false }
            start = index + 1
        }
        index += 1
    }
    if start < length {
        var line: [*]const u8 = undefined
        unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
        if !expandLine(file, line, length - start, options, false) { return false }
    }
    return true
}

fn processFile(file: std.fs.File, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(file, allocator)
    var ok = true
    unsafe {
        ok = processBuffer(std.io.stdout(), options, @ptrCast([*]const u8, data.items), data.length)
    }
    data.deinit()
    return ok
}

fn processPath(path: std.string.String, options: Options) -> bool {
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("expand", path)
        return false
    }
    const processed = processFile(file, options)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("expand", path) }
    return processed && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: expand [OPTION]... [FILE]...\nConvert tabs in each FILE to spaces, writing to standard output.\n  -i, --initial    do not convert tabs after non blanks\n  -t, --tabs=N     have tabs N characters apart, not 8\n      --help        display this help and exit\n      --version     output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx expand 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("expand", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    if options.firstFile >= count { return if processFile(std.io.stdin(), options) { 0 } else { 1 } }
    var status: u8 = 0
    var index = options.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), options) { status = 1 }
        index += 1
    }
    return status
}
