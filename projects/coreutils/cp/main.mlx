const std = @import("std")
const common = @import("../common.mlx")
const crash = @import("std.crash")

const Options = struct {
    noClobber: bool
    update: bool
    verbose: bool
    preserve: bool
    link: bool
    // -r, -R, -a: directories with what is in them (links copied as links).
    recursive: bool
    targetDirectory: std.string.String
    targetSet: bool
    noTargetDirectory: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn setTarget(arguments: [][*]const u8, index: *usize, attached: std.string.String, options: *Options) -> bool {
    var value = attached
    if value.length == 0 {
        index.* += 1
        if index.* >= std.process.count(arguments) { return false }
        value = std.process.argument(arguments, index.*)
    }
    options.*.targetDirectory = value
    options.*.targetSet = true
    return true
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const byte = argument.pointer[current]
        if byte == 102 { options.*.noClobber = false } else if byte == 110 { options.*.noClobber = true } else if byte == 117 {
            options.*.update = true
        } else if byte == 118 { options.*.verbose = true } else if byte == 112 { options.*.preserve = true } else if byte == 108 {
            options.*.link = true
        } else if byte == 114 || byte == 82 { options.*.recursive = true } else if byte == 97 {
            options.*.recursive = true
            options.*.preserve = true
        } else if byte == 100 || byte == 80 {
            // -d, -P: links as links (what -R does anyway).
        } else if byte == 84 { options.*.noTargetDirectory = true } else if byte == 116 {
            return setTarget(arguments, index, std.string.slice(argument, current + 1, argument.length), options)
        } else { return false }
        current += 1
    }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--force") { options.*.noClobber = false } else if common.equals(argument, "--no-clobber") {
        options.*.noClobber = true
    } else if common.equals(argument, "--verbose") || common.equals(argument, "--debug") { options.*.verbose = true } else if common.equals(argument, "--link") {
        options.*.link = true
    } else if common.equals(argument, "--recursive") { options.*.recursive = true } else if common.equals(argument, "--archive") {
        options.*.recursive = true
        options.*.preserve = true
    } else if common.equals(argument, "--no-dereference") {
        // Links as links (what -R does anyway).
    } else if common.equals(argument, "--no-target-directory") { options.*.noTargetDirectory = true } else if common.equals(argument, "--preserve") || std.string.startsWith(argument, std.string.fromSlice("--preserve=")) {
        options.*.preserve = true
    } else if common.equals(argument, "--update") || std.string.startsWith(argument, std.string.fromSlice("--update=")) {
        options.*.update = true
    } else if common.equals(argument, "--target-directory") {
        return setTarget(arguments, index, std.string.fromSlice(""), options)
    } else if std.string.startsWith(argument, std.string.fromSlice("--target-directory=")) {
        const target = std.string.slice(argument, 19, argument.length)
        if target.length == 0 { return false }
        return setTarget(arguments, index, target, options)
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") {
        options.*.action = 2
    } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .noClobber = false, .update = false, .verbose = false, .preserve = false, .link = false, .recursive = false, .targetDirectory = std.string.fromSlice(""), .targetSet = false, .noTargetDirectory = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn isDirectory(status: std.fs.Stat) -> bool {
    return status.mode & 61440 == 16384
}

fn reportCopy(source: std.string.String, destination: std.string.String, verbose: bool) -> void {
    if !verbose { return }
    _ = std.io.print("'")
    _ = std.io.printString(source)
    _ = std.io.print("' -> '")
    _ = std.io.printString(destination)
    _ = std.io.print("'\n")
}

fn preserveMetadata(destination: std.string.String, source: std.fs.Stat) -> bool {
    if !std.fs.chmod(destination.pointer, @intCast(usize, source.mode & 4095)) { return false }
    return std.fs.setTimes(destination.pointer, source.accessedSeconds, source.accessedNanoseconds, source.modifiedSeconds, source.modifiedNanoseconds, false)
}

fn shouldSkip(destination: std.string.String, source: std.fs.Stat, options: Options) -> bool {
    var target: std.fs.Stat = undefined
    if std.fs.status(destination.pointer, &target) != 0 { return false }
    if options.noClobber { return true }
    return options.update && target.modifiedSeconds >= source.modifiedSeconds
}

fn copyFile(source_path: std.string.String, destination: std.string.String, options: Options) -> bool {
    var source_status: std.fs.Stat = undefined
    if std.fs.status(source_path.pointer, &source_status) != 0 || isDirectory(source_status) { return false }
    var target_status: std.fs.Stat = undefined
    if std.fs.status(destination.pointer, &target_status) == 0 && target_status.device == source_status.device && target_status.inode == source_status.inode { return false }
    if shouldSkip(destination, source_status, options) { return true }
    if options.link {
        _ = std.fs.delete(destination.pointer)
        const linked = std.fs.hardLink(source_path.pointer, destination.pointer)
        if linked { reportCopy(source_path, destination, options.verbose) }
        return linked
    }
    const source = std.fs.open(source_path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(source) { return false }
    const mode = @intCast(usize, source_status.mode & 511)
    const target = std.fs.open(destination.pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, mode)
    if !std.fs.isValid(target) {
        _ = std.fs.close(source)
        return false
    }
    const copied = std.fs.copy(source, target)
    const source_closed = std.fs.close(source)
    const target_closed = std.fs.close(target)
    const preserved = !options.preserve || preserveMetadata(destination, source_status)
    if copied && source_closed && target_closed && preserved { reportCopy(source_path, destination, options.verbose) }
    return copied && source_closed && target_closed && preserved
}

// A file, or with -r a directory with everything in it or a link as a
// link.
fn copyAny(source: std.string.String, destination: std.string.String, options: Options) -> bool {
    if options.recursive {
        var status: std.fs.Stat = undefined
        if std.fs.statusAt(source.pointer, &status, true) != 0 { return false }
        const kind = status.mode & 61440
        if kind == 16384 { return copyDirectory(source, destination, status, options) }
        if kind == 40960 { return copyLink(source, destination, options) }
    }
    return copyFile(source, destination, options)
}

fn copyLink(source: std.string.String, destination: std.string.String, options: Options) -> bool {
    var buffer: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    const length = std.fs.readLink(source.pointer, bytes, 4095)
    if length < 0 { return false }
    bytes[@bitCast(usize, length)] = 0
    var existing: std.fs.Stat = undefined
    if std.fs.statusAt(destination.pointer, &existing, true) == 0 {
        if options.noClobber { return true }
        if !std.fs.delete(destination.pointer) { return false }
    }
    if !std.fs.symbolicLink(bytes, destination.pointer) { return false }
    reportCopy(source, destination, options.verbose)
    return true
}

// Whether `inner` is `outer` or under it (as written).
fn within(inner: std.string.String, outer: std.string.String) -> bool {
    var length = outer.length
    while length > 1 && outer.pointer[length - 1] == 47 { length -= 1 }
    if inner.length < length || !std.string.eql(std.string.slice(inner, 0, length), std.string.slice(outer, 0, length)) { return false }
    return inner.length == length || inner.pointer[length] == 47
}

fn copyDirectory(source: std.string.String, destination: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    if within(destination, source) {
        common.writePathError("cp", "cannot copy a directory into itself", source)
        return false
    }
    var target: std.fs.Stat = undefined
    const existing = std.fs.status(destination.pointer, &target) == 0
    if existing && !isDirectory(target) { return false }
    // Writable for us while it fills (the umask applies to the rest).
    if !existing && !std.fs.makeDir(destination.pointer, @intCast(usize, (status.mode & 4095) | 448)) { return false }
    if !existing { reportCopy(source, destination, options.verbose) }
    const directory = std.fs.open(source.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(directory) { return false }
    var buffer: [8192]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var reader = std.fs.entries(directory, bytes, 8192)
    var entry: std.fs.Entry = undefined
    var ok = true
    while std.fs.nextEntry(&reader, &entry) {
        if !std.fs.isDotName(entry.name) {
            const from = std.path.join(source, entry.name)
            const to = std.path.join(destination, entry.name)
            if from == null || to == null {
                ok = false
            } else if !copyAny(std.string.fromParts(from.?.pointer, from.?.length), std.string.fromParts(to.?.pointer, to.?.length), options) {
                common.writePathError("cp", "cannot copy", std.string.fromParts(from.?.pointer, from.?.length))
                ok = false
            }
            if from != null { std.path.free(from.?) }
            if to != null { std.path.free(to.?) }
        }
    }
    if reader.failed { ok = false }
    _ = std.fs.close(directory)
    if !existing {
        // Its own mode now (less the umask unless preserved), then times.
        if options.preserve {
            if !preserveMetadata(destination, status) { ok = false }
        } else {
            if !std.fs.chmod(destination.pointer, @intCast(usize, status.mode & 4095) & ~std.fs.currentUmask()) { ok = false }
        }
    }
    return ok
}

fn copyInto(source: std.string.String, destination: std.string.String, destination_directory: bool, options: Options) -> bool {
    if !destination_directory { return copyAny(source, destination, options) }
    const joined = std.path.join(destination, std.path.basename(source))
    if joined == null { return false }
    const path = joined.?
    const result = copyAny(source, std.string.fromParts(path.pointer, path.length), options)
    std.path.free(path)
    return result
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: cp [OPTION]... SOURCE... DESTINATION\n  -f, --force       overwrite destinations\n  -l, --link        create hard links\n  -n, --no-clobber  do not overwrite\n  -p, --preserve    preserve mode and timestamps\n  -r, -R, --recursive  copy directories and what is in them\n  -a, --archive     -R and -p\n  -t, --target-directory=DIR  copy into DIR\n  -T, --no-target-directory   treat DEST as a file\n  -u, --update      copy only when source is newer\n  -v, --verbose     report copies\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    crash.install()
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx cp 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    const operand_count = count - options.firstOperand
    if options.invalid || operand_count < if options.targetSet { 1 } else { 2 } {
        common.writeMessage("cp", "missing operand or unsupported option")
        return 1
    }
    const destination = if options.targetSet { options.targetDirectory } else { std.process.argument(arguments, count - 1) }
    var destination_status: std.fs.Stat = undefined
    const destination_directory = !options.noTargetDirectory && std.fs.status(destination.pointer, &destination_status) == 0 && isDirectory(destination_status)
    const source_end = if options.targetSet { count } else { count - 1 }
    if source_end - options.firstOperand > 1 && !destination_directory { return 1 }
    var success = true
    var index = options.firstOperand
    while index < source_end {
        const source = std.process.argument(arguments, index)
        if !copyInto(source, destination, destination_directory, options) {
            common.writePathError("cp", "cannot copy", source)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
