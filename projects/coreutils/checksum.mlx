const std = @import("std")
const md5_module = @import("std.md5")
const blake2 = @import("std.blake2")
const sha1_module = @import("std.sha1")
const sha2 = @import("std.sha2")

pub const DigestResult = struct {
    digest: [16]u8
    ok: bool
}

pub const Digest20Result = struct {
    digest: [20]u8
    ok: bool
}

pub const Digest28Result = struct {
    digest: [28]u8
    ok: bool
}

pub const Digest32Result = struct {
    digest: [32]u8
    ok: bool
}

pub const Digest48Result = struct {
    digest: [48]u8
    ok: bool
}

pub const Digest64Result = struct {
    digest: [64]u8
    ok: bool
}

pub fn md5(data: [*]const u8, length: usize, output: [*]u8) -> void {
    unsafe { md5_module.md5(data[0..length], @ptrCast(*[16]u8, output)) }
}

pub fn sha1(data: [*]const u8, length: usize, output: [*]u8) -> void {
    unsafe { sha1_module.sha1(data[0..length], @ptrCast(*[20]u8, output)) }
}

pub fn sha224(data: [*]const u8, length: usize, output: [*]u8) -> void {
    unsafe { sha2.sha224(data[0..length], @ptrCast(*[28]u8, output)) }
}

pub fn sha256(data: [*]const u8, length: usize, output: [*]u8) -> void {
    unsafe { sha2.sha256(data[0..length], @ptrCast(*[32]u8, output)) }
}

pub fn sha384(data: [*]const u8, length: usize, output: [*]u8) -> void {
    unsafe { sha2.sha384(data[0..length], @ptrCast(*[48]u8, output)) }
}

pub fn sha512(data: [*]const u8, length: usize, output: [*]u8) -> void {
    unsafe { sha2.sha512(data[0..length], @ptrCast(*[64]u8, output)) }
}

pub fn blake2b(data: [*]const u8, length: usize, output: [*]u8) -> void {
    unsafe { blake2.blake2b(data[0..length], @ptrCast(*[64]u8, output)) }
}

fn hexDigit(value: u8) -> u8 {
    if value < 10 { return 48 + value }
    return 87 + value
}

pub fn hexEncode(digest: [*]const u8, digest_length: usize, output: [*]u8) -> void {
    var i: usize = 0
    while i < digest_length {
        const byte = digest[i]
        output[i * 2] = hexDigit(byte >> 4)
        output[i * 2 + 1] = hexDigit(byte & 15)
        i += 1
    }
}
