const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    column1: bool
    column2: bool
    column3: bool
    outputDelimiter: std.string.String
    zeroTerminated: bool
    action: u8
    invalid: bool
    file1Set: bool
    file1: std.string.String
    file2Set: bool
    file2: std.string.String
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .column1 = true, .column2 = true, .column3 = true, .outputDelimiter = std.string.fromSlice("\t"),
        .zeroTerminated = false, .action = 0, .invalid = false,
        .file1Set = false, .file1 = std.string.fromSlice(""), .file2Set = false, .file2 = std.string.fromSlice(""),
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    var positional: usize = 0
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "--check-order") || common.equals(argument, "--nocheck-order") || common.equals(argument, "--total") {
            index += 1
            continue
        }
        if common.equals(argument, "-z") || common.equals(argument, "--zero-terminated") {
            result.zeroTerminated = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--output-delimiter=")) {
            result.outputDelimiter = std.string.slice(argument, 19, argument.length)
            index += 1
            continue
        }
        if argument.pointer[1] == 45 {
            result.invalid = true
            index += 1
            continue
        }
        var i: usize = 1
        var ok = true
        while i < argument.length {
            const byte = argument.pointer[i]
            if byte == 49 { result.column1 = false } else if byte == 50 {
                result.column2 = false
            } else if byte == 51 {
                result.column3 = false
            } else if byte == 122 {
                result.zeroTerminated = true
            } else {
                ok = false
            }
            i += 1
        }
        if !ok { result.invalid = true }
        index += 1
    }
    while index < count {
        const argument = std.process.argument(arguments, index)
        if positional == 0 {
            result.file1 = argument
            result.file1Set = true
        } else if positional == 1 {
            result.file2 = argument
            result.file2Set = true
        } else {
            result.invalid = true
        }
        positional += 1
        index += 1
    }
    if positional < 2 { result.invalid = true }
    return result
}

const Lines = struct {
    starts: [*]usize
    lengths: [*]usize
    count: usize
}

fn splitLines(data: [*]const u8, length: usize, delimiter: u8) -> Lines {
    var dummy: [*]usize = undefined
    var line_count: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index < length {
        if data[index] == delimiter { line_count += 1 }
        index += 1
    }
    if start < length && (length == 0 || data[length - 1] != delimiter) { line_count += 1 }
    if line_count == 0 { return Lines.{ .starts = dummy, .lengths = dummy, .count = 0 } }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const starts_allocation = allocator.alloc(line_count * 8, 8)
    const lengths_allocation = allocator.alloc(line_count * 8, 8)
    var starts: [*]usize = undefined
    var lengths: [*]usize = undefined
    unsafe {
        starts = @ptrCast([*]usize, starts_allocation.?)
        lengths = @ptrCast([*]usize, lengths_allocation.?)
    }
    var fill_index: usize = 0
    start = 0
    index = 0
    while index < length {
        if data[index] == delimiter {
            starts[fill_index] = start
            lengths[fill_index] = index - start
            fill_index += 1
            start = index + 1
        }
        index += 1
    }
    if start < length {
        starts[fill_index] = start
        lengths[fill_index] = length - start
        fill_index += 1
    }
    return Lines.{ .starts = starts, .lengths = lengths, .count = line_count }
}

fn lineString(data: [*]const u8, lines: Lines, index: usize) -> std.string.String {
    unsafe {
        var pointer: [*]const u8 = undefined
        pointer = @ptrFromInt([*]const u8, @intFromPtr(data) + lines.starts[index])
        return std.string.fromParts(pointer, lines.lengths[index])
    }
}

fn writePrefix(file: std.fs.File, delimiter: std.string.String, count: usize) -> bool {
    var i: usize = 0
    while i < count {
        if !std.io.writeString(file, delimiter) { return false }
        i += 1
    }
    return true
}

fn writeLine(file: std.fs.File, text: std.string.String, terminator: u8) -> bool {
    if !std.io.writeString(file, text) { return false }
    var buffer: [1]u8 = [1]u8{ terminator }
    unsafe { return std.io.writeAllBytes(file, @ptrCast([*]const u8, buffer[0..1]), 1) }
}

const FileResult = struct {
    data: std.fs.ArrayList
    ok: bool
}

fn readFile(path: std.string.String, program: []const u8) -> FileResult {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if common.isDash(path) { return FileResult.{ .data = std.fs.readToEndAlloc(std.io.stdin(), allocator), .ok = true } }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError(program, path)
        return FileResult.{ .data = std.array_list.ArrayList.init(allocator, 0), .ok = false }
    }
    const data = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return FileResult.{ .data = data, .ok = true }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 {
        return if std.io.print("Usage: comm [OPTION]... FILE1 FILE2\nCompare sorted files FILE1 and FILE2 line by line.\n  -1                      suppress column 1 (lines unique to FILE1)\n  -2                      suppress column 2 (lines unique to FILE2)\n  -3                      suppress column 3 (lines that appear in both files)\n      --output-delimiter=STR  separate columns with STR\n  -z, --zero-terminated   line delimiter is NUL, not newline\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
    }
    if options.action == 2 { return if std.io.print("mlx comm 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("comm", "missing operand")
        return 1
    }
    if common.isDash(options.file1) && common.isDash(options.file2) {
        common.writeMessage("comm", "the input files may not both be standard input")
        return 1
    }
    const delimiter: u8 = if options.zeroTerminated { 0 } else { 10 }
    const result1 = readFile(options.file1, "comm")
    const result2 = readFile(options.file2, "comm")
    const data1 = result1.data
    const data2 = result2.data
    if !result1.ok || !result2.ok {
        data1.deinit()
        data2.deinit()
        return 1
    }
    var lines1: Lines = undefined
    var lines2: Lines = undefined
    unsafe {
        lines1 = splitLines(@ptrCast([*]const u8, data1.items), data1.length, delimiter)
        lines2 = splitLines(@ptrCast([*]const u8, data2.items), data2.length, delimiter)
    }
    var i: usize = 0
    var j: usize = 0
    var ok = true
    unsafe {
        while (i < lines1.count || j < lines2.count) && ok {
            if i >= lines1.count {
                if options.column2 {
                    const prefix_count: usize = if options.column1 { 1 } else { 0 }
                    if !writePrefix(std.io.stdout(), options.outputDelimiter, prefix_count) {
                        ok = false
                        break
                    }
                    if !writeLine(std.io.stdout(), lineString(@ptrCast([*]const u8, data2.items), lines2, j), delimiter) {
                        ok = false
                        break
                    }
                }
                j += 1
            } else if j >= lines2.count {
                if options.column1 {
                    if !writeLine(std.io.stdout(), lineString(@ptrCast([*]const u8, data1.items), lines1, i), delimiter) {
                        ok = false
                        break
                    }
                }
                i += 1
            } else {
                const left = lineString(@ptrCast([*]const u8, data1.items), lines1, i)
                const right = lineString(@ptrCast([*]const u8, data2.items), lines2, j)
                const order = std.string.compare(left, right)
                if order < 0 {
                    if options.column1 {
                        if !writeLine(std.io.stdout(), left, delimiter) {
                            ok = false
                            break
                        }
                    }
                    i += 1
                } else if order > 0 {
                    if options.column2 {
                        const prefix_count: usize = if options.column1 { 1 } else { 0 }
                        if !writePrefix(std.io.stdout(), options.outputDelimiter, prefix_count) {
                            ok = false
                            break
                        }
                        if !writeLine(std.io.stdout(), right, delimiter) {
                            ok = false
                            break
                        }
                    }
                    j += 1
                } else {
                    if options.column3 {
                        var prefix_count: usize = 0
                        if options.column1 { prefix_count += 1 }
                        if options.column2 { prefix_count += 1 }
                        if !writePrefix(std.io.stdout(), options.outputDelimiter, prefix_count) {
                            ok = false
                            break
                        }
                        if !writeLine(std.io.stdout(), left, delimiter) {
                            ok = false
                            break
                        }
                    }
                    i += 1
                    j += 1
                }
            }
        }
    }
    data1.deinit()
    data2.deinit()
    return if ok { 0 } else { 1 }
}
