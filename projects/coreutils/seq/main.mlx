const std = @import("std")
const common = @import("../common.mlx")
const crash = @import("std.crash")

const Options = struct {
    separator: std.string.String
    equalWidth: bool
    action: u8
    invalid: bool
    firstOperand: usize
}

fn looksNumeric(argument: std.string.String) -> bool {
    if argument.length < 2 { return false }
    const second = argument.pointer[1]
    return second >= 48 && second <= 57 || second == 46
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .separator = std.string.fromSlice("\n"), .equalWidth = false, .action = 0, .invalid = false, .firstOperand = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || looksNumeric(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-w") || common.equals(argument, "--equal-width") {
            result.equalWidth = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--separator=")) {
            result.separator = std.string.slice(argument, 12, argument.length)
            index += 1
            continue
        }
        if common.equals(argument, "-s") || common.equals(argument, "--separator") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            result.separator = std.process.argument(arguments, index)
            index += 1
            continue
        }
        if argument.pointer[1] == 115 && argument.length > 2 {
            result.separator = std.string.slice(argument, 2, argument.length)
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstOperand = index
    return result
}

fn magnitudeOf(value: isize) -> usize {
    if value >= 0 { return @intCast(usize, value) }
    return @intCast(usize, -(value + 1)) + 1
}

fn decimalWidth(value: isize) -> usize {
    const magnitude = magnitudeOf(value)
    var count: usize = if value < 0 { 1 } else { 0 }
    if magnitude == 0 { return count + 1 }
    var remaining = magnitude
    while remaining > 0 {
        count += 1
        remaining /= 10
    }
    return count
}

fn widthFor(first: isize, last: isize) -> usize {
    const first_width = decimalWidth(first)
    const last_width = decimalWidth(last)
    return if first_width > last_width { first_width } else { last_width }
}

fn writeNumber(file: std.fs.File, value: isize, width: usize, equal_width: bool) -> bool {
    if !equal_width { return std.io.writeSigned(file, value) }
    const total = decimalWidth(value)
    var pad: usize = if width > total { width - total } else { 0 }
    if value < 0 {
        if !std.io.writeAll(file, "-") { return false }
    }
    while pad > 0 {
        if !std.io.writeAll(file, "0") { return false }
        pad -= 1
    }
    return std.io.writeUnsigned(file, magnitudeOf(value))
}

fn run(options: Options, first: isize, increment: isize, last: isize) -> u8 {
    if increment == 0 {
        common.writeMessage("seq", "invalid Zero increment value")
        return 1
    }
    const width = if options.equalWidth { widthFor(first, last) } else { 0 }
    const file = std.io.stdout()
    var current = first
    var wrote_any = false
    while (increment > 0 && current <= last) || (increment < 0 && current >= last) {
        if wrote_any {
            if !std.io.writeString(file, options.separator) { return 1 }
        }
        wrote_any = true
        if !writeNumber(file, current, width, options.equalWidth) { return 1 }
        if increment > 0 && current > 9223372036854775807 - increment { break }
        if increment < 0 && current < -9223372036854775807 - 1 - increment { break }
        current += increment
    }
    if wrote_any && !std.io.print("\n") { return 1 }
    return 0
}

// ---- decimal numbers (an operand with a '.') ----

// value / 10^digits, exactly.
const Decimal = struct {
    value: isize
    digits: usize
    valid: bool
}

const MAX_DIGITS: usize = 18

fn hasPoint(text: std.string.String) -> bool {
    var k: usize = 0
    while k < text.length {
        if text.pointer[k] == 46 { return true }
        k += 1
    }
    return false
}

// [+-]DIGITS[.DIGITS] (digits on one side at least), 18 digits at most.
fn parseDecimal(text: std.string.String) -> Decimal {
    var result = Decimal.{ .value = 0, .digits = 0, .valid = false }
    var k: usize = 0
    var negative = false
    if k < text.length && (text.pointer[k] == 45 || text.pointer[k] == 43) {
        negative = text.pointer[k] == 45
        k += 1
    }
    var count: usize = 0
    var fraction = false
    while k < text.length {
        const byte = text.pointer[k]
        if byte == 46 && !fraction {
            fraction = true
        } else if byte >= 48 && byte <= 57 {
            count += 1
            if count > MAX_DIGITS { return result }
            result.value = result.value * 10 + @intCast(isize, byte - 48)
            if fraction { result.digits += 1 }
        } else {
            return result
        }
        k += 1
    }
    if count == 0 { return result }
    if negative { result.value = -result.value }
    result.valid = true
    return result
}

// `number` with `digits` decimals (as many or more than it has); false when
// it does not fit.
fn scaled(number: Decimal, digits: usize, into: *isize) -> bool {
    var value = number.value
    var k = number.digits
    while k < digits {
        if value > 922337203685477580 || value < -922337203685477580 { return false }
        value *= 10
        k += 1
    }
    into.* = value
    return true
}

fn power(digits: usize) -> isize {
    var result: isize = 1
    var k: usize = 0
    while k < digits {
        result *= 10
        k += 1
    }
    return result
}

// value / 10^precision as printf's %.{precision}f prints it.
fn decimalText(value: isize, precision: usize, into: *[48]u8) -> usize {
    var digits: [24]u8 = undefined
    var magnitude = magnitudeOf(value)
    var count: usize = 0
    while magnitude > 0 || count <= precision {
        digits[count] = @intCast(u8, 48 + magnitude % 10)
        magnitude /= 10
        count += 1
    }
    var length: usize = 0
    if value < 0 {
        into.*[0] = 45
        length = 1
    }
    var k = count
    while k > 0 {
        k -= 1
        into.*[length] = digits[k]
        length += 1
        if k == precision && precision > 0 {
            into.*[length] = 46
            length += 1
        }
    }
    return length
}

fn runDecimal(options: Options, first: Decimal, increment: Decimal, last: Decimal) -> u8 {
    // Computed at the most decimals any operand has; printed with those of
    // FIRST and INCREMENT (as GNU's seq does).
    var scale = if first.digits > increment.digits { first.digits } else { increment.digits }
    const precision = scale
    if last.digits > scale { scale = last.digits }
    var start: isize = 0
    var step: isize = 0
    var end: isize = 0
    if !scaled(first, scale, &start) || !scaled(increment, scale, &step) || !scaled(last, scale, &end) {
        common.writeMessage("seq", "invalid number")
        return 1
    }
    if step == 0 {
        common.writeMessage("seq", "invalid Zero increment value")
        return 1
    }
    const divisor = power(scale - precision)
    var text: [48]u8 = undefined
    var width: usize = 0
    if options.equalWidth {
        width = decimalText(start / divisor, precision, &text)
        // LAST as printed: down to the precision (toward the start).
        const last_width = decimalText(end / divisor, precision, &text)
        if last_width > width { width = last_width }
    }
    const file = std.io.stdout()
    var current = start
    var wrote_any = false
    while (step > 0 && current <= end) || (step < 0 && current >= end) {
        if wrote_any {
            if !std.io.writeString(file, options.separator) { return 1 }
        }
        wrote_any = true
        const length = decimalText(current / divisor, precision, &text)
        var at: usize = 0
        if length < width {
            // Zeros after the sign up to the width.
            if text[0] == 45 {
                if !std.io.writeAll(file, "-") { return 1 }
                at = 1
            }
            var pad = width - length
            while pad > 0 {
                if !std.io.writeAll(file, "0") { return 1 }
                pad -= 1
            }
        }
        unsafe {
            if !std.io.writeAllBytes(file, @ptrFromInt([*]const u8, @intFromPtr(&text) + at), length - at) { return 1 }
        }
        if step > 0 && current > 9223372036854775807 - step { break }
        if step < 0 && current < -9223372036854775807 - 1 - step { break }
        current += step
    }
    if wrote_any && !std.io.print("\n") { return 1 }
    return 0
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: seq [OPTION]... LAST\n  or:  seq [OPTION]... FIRST LAST\n  or:  seq [OPTION]... FIRST INCREMENT LAST\nPrint numbers from FIRST to LAST, in steps of INCREMENT.\n  -s, --separator=STRING   use STRING to separate numbers (default: \\n)\n  -w, --equal-width        equalize width by padding with leading zeroes\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    crash.install()
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx seq 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("seq", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    const operand_count = count - options.firstOperand
    if operand_count == 0 {
        common.writeMessage("seq", "missing operand")
        return 1
    }
    if operand_count > 3 {
        common.writeMessage("seq", "extra operand")
        return 1
    }
    var first: isize = 1
    var increment: isize = 1
    var last: isize = 0
    var any_point = false
    var k = options.firstOperand
    while k < count {
        if hasPoint(std.process.argument(arguments, k)) { any_point = true }
        k += 1
    }
    if any_point {
        const one = Decimal.{ .value = 1, .digits = 0, .valid = true }
        const a = parseDecimal(std.process.argument(arguments, options.firstOperand))
        const b = if operand_count > 1 { parseDecimal(std.process.argument(arguments, options.firstOperand + 1)) } else { one }
        const c = if operand_count > 2 { parseDecimal(std.process.argument(arguments, options.firstOperand + 2)) } else { one }
        if !a.valid || !b.valid || !c.valid {
            common.writeMessage("seq", "invalid number")
            return 1
        }
        if operand_count == 1 { return runDecimal(options, one, one, a) }
        if operand_count == 2 { return runDecimal(options, a, one, b) }
        return runDecimal(options, a, b, c)
    }
    if operand_count == 1 {
        const result = std.parse.signed(std.process.argument(arguments, options.firstOperand))
        if !result.valid {
            common.writeMessage("seq", "invalid number")
            return 1
        }
        last = result.value
    } else if operand_count == 2 {
        const first_result = std.parse.signed(std.process.argument(arguments, options.firstOperand))
        const last_result = std.parse.signed(std.process.argument(arguments, options.firstOperand + 1))
        if !first_result.valid || !last_result.valid {
            common.writeMessage("seq", "invalid number")
            return 1
        }
        first = first_result.value
        last = last_result.value
    } else {
        const first_result = std.parse.signed(std.process.argument(arguments, options.firstOperand))
        const increment_result = std.parse.signed(std.process.argument(arguments, options.firstOperand + 1))
        const last_result = std.parse.signed(std.process.argument(arguments, options.firstOperand + 2))
        if !first_result.valid || !increment_result.valid || !last_result.valid {
            common.writeMessage("seq", "invalid number")
            return 1
        }
        first = first_result.value
        increment = increment_result.value
        last = last_result.value
    }
    return run(options, first, increment, last)
}
