const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    count: bool
    mode: u8
    skipFields: usize
    skipChars: usize
    ignoreCase: bool
    checkChars: usize
    zeroTerminated: bool
    action: u8
    invalid: bool
    inputSet: bool
    input: std.string.String
    outputSet: bool
    output: std.string.String
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .count = false, .mode = 0, .skipFields = 0, .skipChars = 0, .ignoreCase = false,
        .checkChars = 0, .zeroTerminated = false, .action = 0, .invalid = false,
        .inputSet = false, .input = std.string.fromSlice(""), .outputSet = false, .output = std.string.fromSlice(""),
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    var positional: usize = 0
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "--count") {
            result.count = true
            index += 1
            continue
        }
        if common.equals(argument, "--unique") {
            result.mode = 1
            index += 1
            continue
        }
        if common.equals(argument, "--repeated") {
            result.mode = 2
            index += 1
            continue
        }
        if common.equals(argument, "--ignore-case") {
            result.ignoreCase = true
            index += 1
            continue
        }
        if common.equals(argument, "--zero-terminated") {
            result.zeroTerminated = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--skip-fields=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 14, argument.length))
            if !parsed.valid { result.invalid = true } else { result.skipFields = parsed.value }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--skip-chars=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 13, argument.length))
            if !parsed.valid { result.invalid = true } else { result.skipChars = parsed.value }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--check-chars=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 14, argument.length))
            if !parsed.valid { result.invalid = true } else { result.checkChars = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-D") {
            result.mode = 3
            index += 1
            continue
        }
        if argument.pointer[1] == 45 {
            result.invalid = true
            index += 1
            continue
        }
        var i: usize = 1
        var ok = true
        while i < argument.length {
            const byte = argument.pointer[i]
            if byte == 99 { result.count = true } else if byte == 117 {
                result.mode = 1
            } else if byte == 100 {
                result.mode = 2
            } else if byte == 68 {
                result.mode = 3
            } else if byte == 105 {
                result.ignoreCase = true
            } else if byte == 122 {
                result.zeroTerminated = true
            } else if byte == 102 || byte == 115 || byte == 119 {
                var text = std.string.slice(argument, i + 1, argument.length)
                if text.length == 0 {
                    index += 1
                    if index >= count {
                        ok = false
                        i = argument.length
                        break
                    }
                    text = std.process.argument(arguments, index)
                }
                const parsed = std.parse.unsigned(text)
                if !parsed.valid { ok = false } else if byte == 102 { result.skipFields = parsed.value } else if byte == 115 { result.skipChars = parsed.value } else { result.checkChars = parsed.value }
                i = argument.length
                break
            } else {
                ok = false
            }
            i += 1
        }
        if !ok { result.invalid = true }
        index += 1
    }
    while index < count {
        const argument = std.process.argument(arguments, index)
        if positional == 0 {
            result.input = argument
            result.inputSet = true
        } else if positional == 1 {
            result.output = argument
            result.outputSet = true
        } else {
            result.invalid = true
        }
        positional += 1
        index += 1
    }
    return result
}

fn skipFields(line: [*]const u8, length: usize, fields: usize) -> usize {
    var pos: usize = 0
    var i: usize = 0
    while i < fields && pos < length {
        while pos < length && (line[pos] == 32 || line[pos] == 9) { pos += 1 }
        while pos < length && !(line[pos] == 32 || line[pos] == 9) { pos += 1 }
        i += 1
    }
    return pos
}

fn keyStart(line: [*]const u8, length: usize, fields: usize, chars: usize) -> usize {
    var pos = skipFields(line, length, fields)
    var remaining = chars
    while remaining > 0 && pos < length {
        pos += 1
        remaining -= 1
    }
    return pos
}

fn foldByte(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
}

fn linesEqual(a_line: [*]const u8, a_length: usize, b_line: [*]const u8, b_length: usize, options: Options) -> bool {
    const a_start = keyStart(a_line, a_length, options.skipFields, options.skipChars)
    const b_start = keyStart(b_line, b_length, options.skipFields, options.skipChars)
    var a_key_length = a_length - a_start
    var b_key_length = b_length - b_start
    if options.checkChars > 0 {
        if a_key_length > options.checkChars { a_key_length = options.checkChars }
        if b_key_length > options.checkChars { b_key_length = options.checkChars }
    }
    if a_key_length != b_key_length { return false }
    var i: usize = 0
    while i < a_key_length {
        var ca = a_line[a_start + i]
        var cb = b_line[b_start + i]
        if options.ignoreCase {
            ca = foldByte(ca)
            cb = foldByte(cb)
        }
        if ca != cb { return false }
        i += 1
    }
    return true
}

fn digitCount(value: usize) -> usize {
    if value == 0 { return 1 }
    var count: usize = 0
    var remaining = value
    while remaining > 0 {
        count += 1
        remaining /= 10
    }
    return count
}

fn writeCount(file: std.fs.File, value: usize) -> bool {
    const digits = digitCount(value)
    var pad: usize = if digits < 7 { 7 - digits } else { 0 }
    while pad > 0 {
        if !std.io.writeAll(file, " ") { return false }
        pad -= 1
    }
    return std.io.writeUnsigned(file, value)
}

fn writeGroup(file: std.fs.File, options: Options, data: [*]const u8, starts: [*]usize, lengths: [*]usize, group_start: usize, group_size: usize, delimiter: u8) -> bool {
    var include: usize = if options.mode == 0 || options.mode == 1 { 1 } else if options.mode == 2 { if group_size > 1 { 1 } else { 0 } } else { if group_size > 1 { group_size } else { 0 } }
    if options.mode == 1 && group_size != 1 { include = 0 }
    if include == 0 { return true }
    var index: usize = 0
    while index < include {
        const line_index = group_start + index
        unsafe {
            var pointer: [*]const u8 = undefined
            pointer = @ptrFromInt([*]const u8, @intFromPtr(data) + starts[line_index])
            if options.count {
                if !writeCount(file, group_size) { return false }
                if !std.io.writeAll(file, " ") { return false }
            }
            if lengths[line_index] > 0 && !std.io.writeAllBytes(file, pointer, lengths[line_index]) { return false }
        }
        var delimiter_text: [1]u8 = [1]u8{ delimiter }
        unsafe { if !std.io.writeAllBytes(file, @ptrCast([*]const u8, delimiter_text[0..1]), 1) { return false } }
        index += 1
    }
    return true
}

fn processBuffer(input_file: std.fs.File, output_file: std.fs.File, options: Options, data: [*]const u8, length: usize) -> bool {
    const delimiter: u8 = if options.zeroTerminated { 0 } else { 10 }
    var line_count: usize = 0
    var index: usize = 0
    var start: usize = 0
    while index < length {
        if data[index] == delimiter {
            line_count += 1
            start = index + 1
        }
        index += 1
    }
    if start < length { line_count += 1 }
    if line_count == 0 { return true }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const starts_allocation = allocator.alloc(line_count * 8, 8)
    if starts_allocation == null { return false }
    const lengths_allocation = allocator.alloc(line_count * 8, 8)
    if lengths_allocation == null {
        allocator.free(starts_allocation.?, line_count * 8, 8)
        return false
    }
    var starts: [*]usize = undefined
    var lengths: [*]usize = undefined
    unsafe {
        starts = @ptrCast([*]usize, starts_allocation.?)
        lengths = @ptrCast([*]usize, lengths_allocation.?)
    }
    var fill_index: usize = 0
    start = 0
    index = 0
    while index < length {
        if data[index] == delimiter {
            starts[fill_index] = start
            lengths[fill_index] = index - start
            fill_index += 1
            start = index + 1
        }
        index += 1
    }
    if start < length {
        starts[fill_index] = start
        lengths[fill_index] = length - start
        fill_index += 1
    }
    var ok = true
    var group_start: usize = 0
    var line_index: usize = 1
    while line_index <= line_count {
        var same = false
        if line_index < line_count {
            unsafe {
                var previous_pointer: [*]const u8 = undefined
                var current_pointer: [*]const u8 = undefined
                previous_pointer = @ptrFromInt([*]const u8, @intFromPtr(data) + starts[line_index - 1])
                current_pointer = @ptrFromInt([*]const u8, @intFromPtr(data) + starts[line_index])
                same = linesEqual(previous_pointer, lengths[line_index - 1], current_pointer, lengths[line_index], options)
            }
        }
        if !same {
            const group_size = line_index - group_start
            if !writeGroup(output_file, options, data, starts, lengths, group_start, group_size, delimiter) {
                ok = false
                break
            }
            group_start = line_index
        }
        line_index += 1
    }
    allocator.free(starts_allocation.?, line_count * 8, 8)
    allocator.free(lengths_allocation.?, line_count * 8, 8)
    return ok
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: uniq [OPTION]... [INPUT [OUTPUT]]\nFilter adjacent matching lines from INPUT, writing to OUTPUT.\n  -c, --count            prefix lines by the number of occurrences\n  -d, --repeated         only print duplicate lines, one for each group\n  -D                     print all duplicate lines\n  -f, --skip-fields=N    avoid comparing the first N fields\n  -i, --ignore-case      ignore differences in case when comparing\n  -s, --skip-chars=N     avoid comparing the first N characters\n  -u, --unique           only print unique lines\n  -z, --zero-terminated  line delimiter is NUL, not newline\n  -w, --check-chars=N    compare no more than N characters in lines\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx uniq 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("uniq", "invalid option")
        return 1
    }
    if options.count && options.mode == 3 {
        common.writeMessage("uniq", "printing all duplicated lines and repeat counts is meaningless")
        return 1
    }
    var input_file = std.io.stdin()
    var opened_input = false
    if options.inputSet && !common.isDash(options.input) {
        input_file = std.fs.open(options.input.pointer, std.fs.READ_ONLY, 0)
        if !std.fs.isValid(input_file) {
            common.writeFileError("uniq", options.input)
            return 1
        }
        opened_input = true
    }
    var output_file = std.io.stdout()
    var opened_output = false
    if options.outputSet {
        output_file = std.fs.open(options.output.pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
        if !std.fs.isValid(output_file) {
            common.writePathError("uniq", "cannot open for writing", options.output)
            if opened_input { const closed = std.fs.close(input_file) }
            return 1
        }
        opened_output = true
    }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(input_file, allocator)
    var ok = true
    unsafe {
        ok = processBuffer(input_file, output_file, options, @ptrCast([*]const u8, data.items), data.length)
    }
    data.deinit()
    if opened_input {
        const closed = std.fs.close(input_file)
        ok = ok && closed
    }
    if opened_output {
        const closed = std.fs.close(output_file)
        ok = ok && closed
    }
    return if ok { 0 } else { 1 }
}
