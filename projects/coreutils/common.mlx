const std = @import("std")

pub const BUFFER_SIZE: usize = 65536

pub fn isDash(value: std.string.String) -> bool {
    return value.length == 1 && value.pointer[0] == 45
}

pub fn equals(value: std.string.String, expected: []const u8) -> bool {
    return std.string.eql(value, std.string.fromSlice(expected))
}

pub fn writeMessage(program: []const u8, message: []const u8) -> void {
    _ = std.io.writeAll(std.io.stderr(), program)
    _ = std.io.writeAll(std.io.stderr(), ": ")
    _ = std.io.writeAll(std.io.stderr(), message)
    _ = std.io.writeAll(std.io.stderr(), "\n")
}

pub fn writeFileError(program: []const u8, path: std.string.String) -> void {
    _ = std.io.writeAll(std.io.stderr(), program)
    _ = std.io.writeAll(std.io.stderr(), ": cannot read '")
    _ = std.io.writeString(std.io.stderr(), path)
    _ = std.io.writeAll(std.io.stderr(), "'\n")
}

// Operand `path`'s bytes: standard input's for "-", else the file's; null
// when the file could not be opened.
pub fn readOperand(path: std.string.String) -> ?std.fs.ArrayList {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if isDash(path) { return std.fs.readToEndAlloc(std.io.stdin(), allocator) }
    return std.fs.readFileAlloc(path.pointer, allocator)
}

// readOperand, with an empty list for a file that could not be opened.
pub fn readOperandOrEmpty(path: std.string.String) -> std.fs.ArrayList {
    const data = readOperand(path)
    if data != null { return data.? }
    return std.array_list.ArrayList.init(std.page_allocator.init(), 0)
}

// readOperandOrEmpty for a program that says which operand it could not
// read (writeFileError) and goes on; `ok` is false then.
pub fn readOperandOrSay(program: []const u8, path: std.string.String, ok: *bool) -> std.fs.ArrayList {
    const data = readOperand(path)
    ok.* = data != null
    if data != null { return data.? }
    writeFileError(program, path)
    return std.array_list.ArrayList.init(std.page_allocator.init(), 0)
}

pub fn writePathError(program: []const u8, message: []const u8, path: std.string.String) -> void {
    _ = std.io.writeAll(std.io.stderr(), program)
    _ = std.io.writeAll(std.io.stderr(), ": ")
    _ = std.io.writeAll(std.io.stderr(), message)
    _ = std.io.writeAll(std.io.stderr(), " '")
    _ = std.io.writeString(std.io.stderr(), path)
    _ = std.io.writeAll(std.io.stderr(), "'\n")
}
