const std = @import("std")
const common = @import("../common.mlx")

const Result = struct {
    truthy: bool
    valid: bool
}

fn errorResult() -> Result {
    return Result.{ .truthy = false, .valid = false }
}

fn boolResult(value: bool) -> Result {
    return Result.{ .truthy = value, .valid = true }
}

fn reportError(message: []const u8) -> void {
    common.writeMessage("test", message)
}

fn isUnaryOp(token: std.string.String) -> bool {
    return common.equals(token, "-z") || common.equals(token, "-n") || common.equals(token, "-e") || common.equals(token, "-f") || common.equals(token, "-d") || common.equals(token, "-L") || common.equals(token, "-h") || common.equals(token, "-r") || common.equals(token, "-w") || common.equals(token, "-x") || common.equals(token, "-s")
}

fn isBinaryOp(token: std.string.String) -> bool {
    return common.equals(token, "=") || common.equals(token, "==") || common.equals(token, "!=") || common.equals(token, "-eq") || common.equals(token, "-ne") || common.equals(token, "-lt") || common.equals(token, "-le") || common.equals(token, "-gt") || common.equals(token, "-ge") || common.equals(token, "-nt") || common.equals(token, "-ot") || common.equals(token, "-ef")
}

const StatResult = struct {
    exists: bool
    stat: std.fs.Stat
}

fn statOf(operand: std.string.String, follow: bool) -> StatResult {
    var status: std.fs.Stat = undefined
    const code = std.fs.statusAt(operand.pointer, &status, !follow)
    return StatResult.{ .exists = code >= 0, .stat = status }
}

fn evalUnary(op: std.string.String, operand: std.string.String) -> Result {
    if common.equals(op, "-z") { return boolResult(operand.length == 0) }
    if common.equals(op, "-n") { return boolResult(operand.length > 0) }
    if common.equals(op, "-e") {
        const result = statOf(operand, true)
        return boolResult(result.exists)
    }
    if common.equals(op, "-f") {
        const result = statOf(operand, true)
        return boolResult(result.exists && result.stat.mode & 61440 == 32768)
    }
    if common.equals(op, "-d") {
        const result = statOf(operand, true)
        return boolResult(result.exists && result.stat.mode & 61440 == 16384)
    }
    if common.equals(op, "-L") || common.equals(op, "-h") {
        const result = statOf(operand, false)
        return boolResult(result.exists && result.stat.mode & 61440 == 40960)
    }
    if common.equals(op, "-r") { return boolResult(std.fs.access(operand.pointer, std.fs.ACCESS_READ)) }
    if common.equals(op, "-w") { return boolResult(std.fs.access(operand.pointer, std.fs.ACCESS_WRITE)) }
    if common.equals(op, "-x") { return boolResult(std.fs.access(operand.pointer, std.fs.ACCESS_EXECUTE)) }
    const result = statOf(operand, true)
    return boolResult(result.exists && result.stat.size > 0)
}

fn evalBinary(left: std.string.String, op: std.string.String, right: std.string.String) -> Result {
    if common.equals(op, "=") || common.equals(op, "==") { return boolResult(std.string.eql(left, right)) }
    if common.equals(op, "!=") { return boolResult(!std.string.eql(left, right)) }
    if common.equals(op, "-nt") || common.equals(op, "-ot") || common.equals(op, "-ef") {
        const left_result = statOf(left, true)
        const left_exists = left_result.exists
        const left_stat = left_result.stat
        const right_result = statOf(right, true)
        const right_exists = right_result.exists
        const right_stat = right_result.stat
        if common.equals(op, "-ef") { return boolResult(left_exists && right_exists && left_stat.device == right_stat.device && left_stat.inode == right_stat.inode) }
        if !left_exists || !right_exists { return boolResult(left_exists && !right_exists && common.equals(op, "-nt")) }
        const newer = left_stat.modifiedSeconds > right_stat.modifiedSeconds || (left_stat.modifiedSeconds == right_stat.modifiedSeconds && left_stat.modifiedNanoseconds > right_stat.modifiedNanoseconds)
        const same = left_stat.modifiedSeconds == right_stat.modifiedSeconds && left_stat.modifiedNanoseconds == right_stat.modifiedNanoseconds
        return boolResult(if common.equals(op, "-nt") { newer } else { !newer && !same })
    }
    const left_parsed = std.parse.signed(left)
    const right_parsed = std.parse.signed(right)
    if !left_parsed.valid || !right_parsed.valid {
        reportError("invalid integer argument")
        return errorResult()
    }
    const a = left_parsed.value
    const b = right_parsed.value
    if common.equals(op, "-eq") { return boolResult(a == b) }
    if common.equals(op, "-ne") { return boolResult(a != b) }
    if common.equals(op, "-lt") { return boolResult(a < b) }
    if common.equals(op, "-le") { return boolResult(a <= b) }
    if common.equals(op, "-gt") { return boolResult(a > b) }
    return boolResult(a >= b)
}

fn parseNot(arguments: [][*]const u8, limit: usize, position: *usize) -> Result {
    if position.* < limit && common.equals(std.process.argument(arguments, position.*), "!") {
        position.* += 1
        const inner = parseNot(arguments, limit, position)
        if !inner.valid { return inner }
        return boolResult(!inner.truthy)
    }
    if position.* >= limit {
        reportError("missing argument")
        return errorResult()
    }
    const token = std.process.argument(arguments, position.*)
    if common.equals(token, "(") {
        position.* += 1
        const inner = parseOr(arguments, limit, position)
        if !inner.valid { return inner }
        if position.* >= limit || !common.equals(std.process.argument(arguments, position.*), ")") {
            reportError("syntax error")
            return errorResult()
        }
        position.* += 1
        return inner
    }
    if isUnaryOp(token) {
        position.* += 1
        if position.* >= limit {
            reportError("missing argument")
            return errorResult()
        }
        const operand = std.process.argument(arguments, position.*)
        position.* += 1
        return evalUnary(token, operand)
    }
    position.* += 1
    if position.* < limit && isBinaryOp(std.process.argument(arguments, position.*)) {
        const op = std.process.argument(arguments, position.*)
        position.* += 1
        if position.* >= limit {
            reportError("missing argument")
            return errorResult()
        }
        const right = std.process.argument(arguments, position.*)
        position.* += 1
        return evalBinary(token, op, right)
    }
    return boolResult(token.length > 0)
}

fn parseAnd(arguments: [][*]const u8, limit: usize, position: *usize) -> Result {
    var left = parseNot(arguments, limit, position)
    if !left.valid { return left }
    while position.* < limit && common.equals(std.process.argument(arguments, position.*), "-a") {
        position.* += 1
        const right = parseNot(arguments, limit, position)
        if !right.valid { return right }
        left = boolResult(left.truthy && right.truthy)
    }
    return left
}

fn parseOr(arguments: [][*]const u8, limit: usize, position: *usize) -> Result {
    var left = parseAnd(arguments, limit, position)
    if !left.valid { return left }
    while position.* < limit && common.equals(std.process.argument(arguments, position.*), "-o") {
        position.* += 1
        const right = parseAnd(arguments, limit, position)
        if !right.valid { return right }
        left = boolResult(left.truthy || right.truthy)
    }
    return left
}

pub fn runTest(arguments: [][*]const u8, bracket_mode: bool) -> u8 {
    var count = std.process.count(arguments)
    if bracket_mode {
        if count < 2 || !common.equals(std.process.argument(arguments, count - 1), "]") {
            common.writeMessage("[", "missing ']'")
            return 2
        }
        count -= 1
    }
    if count == 2 {
        const argument = std.process.argument(arguments, 1)
        if common.equals(argument, "--help") {
            return if std.io.print("Usage: test EXPRESSION\n  or:  test\n  or:  [ EXPRESSION ]\n  or:  [ ]\n  or:  [ OPTION\nExit with the status determined by EXPRESSION.\n") { 0 } else { 1 }
        }
        if common.equals(argument, "--version") { return if std.io.print("mlx test 0.1.0\n") { 0 } else { 1 } }
    }
    if count <= 1 { return 1 }
    var position: usize = 1
    const result = parseOr(arguments, count, &position)
    if !result.valid { return 2 }
    if position != count {
        reportError("syntax error")
        return 2
    }
    return if result.truthy { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    return runTest(arguments, false)
}
