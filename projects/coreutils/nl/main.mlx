const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    style: u8
    format: u8
    width: usize
    separator: std.string.String
    start: usize
    increment: usize
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseStyle(value: std.string.String) -> u8 {
    if common.equals(value, "a") { return 0 }
    if common.equals(value, "t") { return 1 }
    if common.equals(value, "n") { return 2 }
    return 255
}

fn parseFormat(value: std.string.String) -> u8 {
    if common.equals(value, "ln") { return 0 }
    if common.equals(value, "rn") { return 1 }
    if common.equals(value, "rz") { return 2 }
    return 255
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .style = 1, .format = 1, .width = 6, .separator = std.string.fromSlice("\t"), .start = 1, .increment = 1, .action = 0, .invalid = false, .firstFile = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        var handled = false
        var key: u8 = 0
        var value: std.string.String = std.string.fromSlice("")
        if argument.pointer[1] != 45 && argument.length > 2 {
            key = argument.pointer[1]
            value = std.string.slice(argument, 2, argument.length)
            handled = true
        } else if argument.pointer[1] != 45 && argument.length == 2 {
            key = argument.pointer[1]
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            value = std.process.argument(arguments, index)
            handled = true
        } else if std.string.startsWith(argument, std.string.fromSlice("--body-numbering=")) {
            key = 98
            value = std.string.slice(argument, 18, argument.length)
            handled = true
        } else if std.string.startsWith(argument, std.string.fromSlice("--number-format=")) {
            key = 110
            value = std.string.slice(argument, 17, argument.length)
            handled = true
        } else if std.string.startsWith(argument, std.string.fromSlice("--number-width=")) {
            key = 119
            value = std.string.slice(argument, 16, argument.length)
            handled = true
        } else if std.string.startsWith(argument, std.string.fromSlice("--number-separator=")) {
            key = 115
            value = std.string.slice(argument, 20, argument.length)
            handled = true
        } else if std.string.startsWith(argument, std.string.fromSlice("--starting-line-number=")) {
            key = 118
            value = std.string.slice(argument, 24, argument.length)
            handled = true
        } else if std.string.startsWith(argument, std.string.fromSlice("--line-increment=")) {
            key = 105
            value = std.string.slice(argument, 18, argument.length)
            handled = true
        }
        if !handled {
            result.invalid = true
            index += 1
            continue
        }
        if key == 98 {
            const style = parseStyle(value)
            if style == 255 {
                result.invalid = true
            } else {
                result.style = style
            }
        } else if key == 110 {
            const format = parseFormat(value)
            if format == 255 {
                result.invalid = true
            } else {
                result.format = format
            }
        } else if key == 119 {
            const parsed = std.parse.unsigned(value)
            if !parsed.valid { result.invalid = true } else { result.width = parsed.value }
        } else if key == 115 {
            result.separator = value
        } else if key == 118 {
            const parsed = std.parse.unsigned(value)
            if !parsed.valid { result.invalid = true } else { result.start = parsed.value }
        } else if key == 105 {
            const parsed = std.parse.unsigned(value)
            if !parsed.valid { result.invalid = true } else { result.increment = parsed.value }
        } else {
            result.invalid = true
        }
        index += 1
    }
    result.firstFile = index
    return result
}

fn digitCount(value: usize) -> usize {
    if value == 0 { return 1 }
    var count: usize = 0
    var remaining = value
    while remaining > 0 {
        count += 1
        remaining /= 10
    }
    return count
}

fn writeNumber(file: std.fs.File, value: usize, width: usize, format: u8) -> bool {
    const digits = digitCount(value)
    var pad: usize = if width > digits { width - digits } else { 0 }
    if format == 2 {
        while pad > 0 {
            if !std.io.writeAll(file, "0") { return false }
            pad -= 1
        }
        return std.io.writeUnsigned(file, value)
    }
    if format == 0 {
        if !std.io.writeUnsigned(file, value) { return false }
        while pad > 0 {
            if !std.io.writeAll(file, " ") { return false }
            pad -= 1
        }
        return true
    }
    while pad > 0 {
        if !std.io.writeAll(file, " ") { return false }
        pad -= 1
    }
    return std.io.writeUnsigned(file, value)
}

fn shouldNumber(style: u8, line_length: usize) -> bool {
    if style == 0 { return true }
    if style == 2 { return false }
    return line_length > 0
}

fn writeSpaces(file: std.fs.File, count: usize) -> bool {
    var remaining = count
    while remaining > 0 {
        if !std.io.writeAll(file, " ") { return false }
        remaining -= 1
    }
    return true
}

fn processLine(file: std.fs.File, options: Options, line: [*]const u8, line_length: usize, counter: *usize) -> bool {
    if shouldNumber(options.style, line_length) {
        if !writeNumber(file, counter.*, options.width, options.format) { return false }
        counter.* += options.increment
        if !std.io.writeString(file, options.separator) { return false }
    } else if !writeSpaces(file, options.width + options.separator.length) { return false }
    unsafe {
        if line_length > 0 && !std.io.writeAllBytes(file, line, line_length) { return false }
    }
    return std.io.writeAll(file, "\n")
}

fn processBuffer(file: std.fs.File, options: Options, data: [*]const u8, length: usize, counter: *usize) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index < length {
        if data[index] == 10 {
            var line: [*]const u8 = undefined
            unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
            if !processLine(file, options, line, index - start, counter) { return false }
            start = index + 1
        }
        index += 1
    }
    if start < length {
        var line: [*]const u8 = undefined
        unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
        if !processLine(file, options, line, length - start, counter) { return false }
    }
    return true
}

fn processFile(file: std.fs.File, options: Options, counter: *usize) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(file, allocator)
    var ok = true
    unsafe {
        ok = processBuffer(std.io.stdout(), options, @ptrCast([*]const u8, data.items), data.length, counter)
    }
    data.deinit()
    return ok
}

fn processPath(path: std.string.String, options: Options, counter: *usize) -> bool {
    if common.isDash(path) { return processFile(std.io.stdin(), options, counter) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("nl", path)
        return false
    }
    const processed = processFile(file, options, counter)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("nl", path) }
    return processed && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: nl [OPTION]... [FILE]...\nWrite each FILE to standard output, with line numbers added.\n  -b, --body-numbering=STYLE      use STYLE for numbering body lines\n  -i, --line-increment=NUMBER     line number increment at each line\n  -n, --number-format=FORMAT      insert line numbers according to FORMAT\n  -s, --number-separator=STRING   add STRING after (possible) line number\n  -v, --starting-line-number=NUMBER  first line number for each section\n  -w, --number-width=NUMBER       use NUMBER columns for line numbers\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx nl 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("nl", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    var counter = options.start
    if options.firstFile >= count { return if processFile(std.io.stdin(), options, &counter) { 0 } else { 1 } }
    var status: u8 = 0
    var index = options.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), options, &counter) { status = 1 }
        index += 1
    }
    return status
}
