const std = @import("std")
const common = @import("../common.mlx")

const RangeList = struct {
    starts: [*]usize
    ends: [*]usize
    count: usize
    valid: bool
}

fn invalidRangeList() -> RangeList {
    var dummy: [*]usize = undefined
    return RangeList.{ .starts = dummy, .ends = dummy, .count = 0, .valid = false }
}

fn countTokens(text: std.string.String) -> usize {
    if text.length == 0 { return 0 }
    var count: usize = 1
    var i: usize = 0
    while i < text.length {
        if text.pointer[i] == 44 { count += 1 }
        i += 1
    }
    return count
}

fn parseList(text: std.string.String) -> RangeList {
    const token_count = countTokens(text)
    if token_count == 0 { return invalidRangeList() }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const starts_allocation = allocator.alloc(token_count * 8, 8)
    if starts_allocation == null { return invalidRangeList() }
    const ends_allocation = allocator.alloc(token_count * 8, 8)
    if ends_allocation == null {
        allocator.free(starts_allocation.?, token_count * 8, 8)
        return invalidRangeList()
    }
    var starts: [*]usize = undefined
    var ends: [*]usize = undefined
    unsafe {
        starts = @ptrCast([*]usize, starts_allocation.?)
        ends = @ptrCast([*]usize, ends_allocation.?)
    }
    var index: usize = 0
    var token_start: usize = 0
    var token_index: usize = 0
    var valid = true
    while index <= text.length {
        if index == text.length || text.pointer[index] == 44 {
            const token = std.string.slice(text, token_start, index)
            if token.length == 0 {
                valid = false
            } else if token.pointer[0] == 45 {
                const rest = std.string.slice(token, 1, token.length)
                const parsed = std.parse.unsigned(rest)
                if !parsed.valid || parsed.value == 0 { valid = false } else {
                    starts[token_index] = 1
                    ends[token_index] = parsed.value
                }
            } else {
                var dash: usize = 0
                var found_dash = false
                var scan: usize = 0
                while scan < token.length {
                    if token.pointer[scan] == 45 {
                        dash = scan
                        found_dash = true
                        break
                    }
                    scan += 1
                }
                if !found_dash {
                    const parsed = std.parse.unsigned(token)
                    if !parsed.valid || parsed.value == 0 { valid = false } else {
                        starts[token_index] = parsed.value
                        ends[token_index] = parsed.value
                    }
                } else {
                    const left = std.string.slice(token, 0, dash)
                    const right = std.string.slice(token, dash + 1, token.length)
                    const left_parsed = std.parse.unsigned(left)
                    if !left_parsed.valid || left_parsed.value == 0 { valid = false } else {
                        starts[token_index] = left_parsed.value
                        if right.length == 0 {
                            ends[token_index] = 0
                        } else {
                            const right_parsed = std.parse.unsigned(right)
                            if !right_parsed.valid || right_parsed.value == 0 { valid = false } else {
                                ends[token_index] = right_parsed.value
                            }
                        }
                    }
                }
            }
            token_index += 1
            token_start = index + 1
        }
        index += 1
    }
    if !valid {
        allocator.free(starts_allocation.?, token_count * 8, 8)
        allocator.free(ends_allocation.?, token_count * 8, 8)
        return invalidRangeList()
    }
    return RangeList.{ .starts = starts, .ends = ends, .count = token_count, .valid = true }
}

fn selected(position: usize, list: RangeList, complement: bool) -> bool {
    var matched = false
    var i: usize = 0
    while i < list.count {
        if position >= list.starts[i] && (list.ends[i] == 0 || position <= list.ends[i]) {
            matched = true
            break
        }
        i += 1
    }
    return if complement { !matched } else { matched }
}

const Options = struct {
    mode: u8
    list: RangeList
    delimiter: u8
    outputDelimiter: u8
    outputDelimiterSet: bool
    complement: bool
    onlyDelimited: bool
    zeroTerminated: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .mode = 0, .list = invalidRangeList(), .delimiter = 9, .outputDelimiter = 9, .outputDelimiterSet = false,
        .complement = false, .onlyDelimited = false, .zeroTerminated = false, .action = 0, .invalid = false, .firstFile = 1,
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "--complement") {
            result.complement = true
            index += 1
            continue
        }
        if common.equals(argument, "-s") || common.equals(argument, "--only-delimited") {
            result.onlyDelimited = true
            index += 1
            continue
        }
        if common.equals(argument, "-z") || common.equals(argument, "--zero-terminated") {
            result.zeroTerminated = true
            index += 1
            continue
        }
        if common.equals(argument, "-n") {
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--output-delimiter=")) {
            const value = std.string.slice(argument, 19, argument.length)
            if value.length != 1 { result.invalid = true } else {
                result.outputDelimiter = value.pointer[0]
                result.outputDelimiterSet = true
            }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--delimiter=")) {
            const value = std.string.slice(argument, 12, argument.length)
            if value.length != 1 { result.invalid = true } else { result.delimiter = value.pointer[0] }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--fields=")) {
            result.mode = 2
            result.list = parseList(std.string.slice(argument, 9, argument.length))
            if !result.list.valid { result.invalid = true }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--bytes=")) {
            result.mode = 1
            result.list = parseList(std.string.slice(argument, 8, argument.length))
            if !result.list.valid { result.invalid = true }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--characters=")) {
            result.mode = 1
            result.list = parseList(std.string.slice(argument, 13, argument.length))
            if !result.list.valid { result.invalid = true }
            index += 1
            continue
        }
        const byte = argument.pointer[1]
        if byte == 98 || byte == 99 || byte == 102 || byte == 100 {
            var text = std.string.slice(argument, 2, argument.length)
            if text.length == 0 {
                index += 1
                if index >= count {
                    result.invalid = true
                    break
                }
                text = std.process.argument(arguments, index)
            }
            if byte == 100 {
                if text.length != 1 { result.invalid = true } else { result.delimiter = text.pointer[0] }
            } else {
                result.mode = if byte == 102 { 2 } else { 1 }
                result.list = parseList(text)
                if !result.list.valid { result.invalid = true }
            }
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn writeByte(file: std.fs.File, byte: u8) -> bool {
    var text: [1]u8 = [1]u8{ byte }
    unsafe { return std.io.writeAllBytes(file, @ptrCast([*]const u8, text[0..1]), 1) }
}

fn processBytes(file: std.fs.File, options: Options, line: [*]const u8, length: usize) -> u8 {
    var i: usize = 0
    while i < length {
        if selected(i + 1, options.list, options.complement) {
            unsafe {
                var pointer: [*]const u8 = undefined
                pointer = @ptrFromInt([*]const u8, @intFromPtr(line) + i)
                if !std.io.writeAllBytes(file, pointer, 1) { return 0 }
            }
        }
        i += 1
    }
    return 1
}

fn processFields(file: std.fs.File, options: Options, line: [*]const u8, length: usize) -> u8 {
    var has_delimiter = false
    var i: usize = 0
    while i < length {
        if line[i] == options.delimiter {
            has_delimiter = true
            break
        }
        i += 1
    }
    if !has_delimiter {
        if options.onlyDelimited { return 2 }
        unsafe {
            if length > 0 && !std.io.writeAllBytes(file, line, length) { return 0 }
        }
        return 1
    }
    const output_delimiter = if options.outputDelimiterSet { options.outputDelimiter } else { options.delimiter }
    var field_start: usize = 0
    var field_index: usize = 1
    var wrote_any = false
    var index: usize = 0
    var ok = true
    while index <= length {
        if index == length || line[index] == options.delimiter {
            if selected(field_index, options.list, options.complement) {
                if wrote_any {
                    if !writeByte(file, output_delimiter) {
                        ok = false
                        break
                    }
                }
                wrote_any = true
                unsafe {
                    var pointer: [*]const u8 = undefined
                    pointer = @ptrFromInt([*]const u8, @intFromPtr(line) + field_start)
                    if index > field_start && !std.io.writeAllBytes(file, pointer, index - field_start) {
                        ok = false
                        break
                    }
                }
            }
            field_start = index + 1
            field_index += 1
        }
        index += 1
    }
    return if ok { 1 } else { 0 }
}

fn processBuffer(file: std.fs.File, options: Options, data: [*]const u8, length: usize) -> bool {
    const delimiter: u8 = if options.zeroTerminated { 0 } else { 10 }
    var start: usize = 0
    var index: usize = 0
    while index < length {
        if data[index] == delimiter {
            var line: [*]const u8 = undefined
            unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
            const line_length = index - start
            const status = if options.mode == 1 { processBytes(file, options, line, line_length) } else { processFields(file, options, line, line_length) }
            if status == 0 { return false }
            if status == 1 && !writeByte(file, delimiter) { return false }
            start = index + 1
        }
        index += 1
    }
    if start < length {
        var line: [*]const u8 = undefined
        unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
        const line_length = length - start
        const status = if options.mode == 1 { processBytes(file, options, line, line_length) } else { processFields(file, options, line, line_length) }
        if status == 0 { return false }
        if status == 1 && !writeByte(file, delimiter) { return false }
    }
    return true
}

fn processFile(file: std.fs.File, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(file, allocator)
    var ok = true
    unsafe {
        ok = processBuffer(std.io.stdout(), options, @ptrCast([*]const u8, data.items), data.length)
    }
    data.deinit()
    return ok
}

fn processPath(path: std.string.String, options: Options) -> bool {
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("cut", path)
        return false
    }
    const processed = processFile(file, options)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("cut", path) }
    return processed && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: cut OPTION... [FILE]...\nPrint selected parts of lines from each FILE to standard output.\n  -b, --bytes=LIST        select only these bytes\n  -c, --characters=LIST   select only these characters\n  -d, --delimiter=DELIM   use DELIM instead of TAB for field delimiter\n  -f, --fields=LIST       select only these fields\n      --complement         complement the set of selected fields\n  -s, --only-delimited    do not print lines not containing delimiters\n      --output-delimiter=STRING  use STRING as the output delimiter\n  -z, --zero-terminated   line delimiter is NUL, not newline\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx cut 0.1.0\n") { 0 } else { 1 } }
    if options.mode == 0 {
        common.writeMessage("cut", "you must specify a list of bytes, characters, or fields")
        return 1
    }
    if options.invalid {
        common.writeMessage("cut", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    if options.firstFile >= count { return if processFile(std.io.stdin(), options) { 0 } else { 1 } }
    var status: u8 = 0
    var index = options.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), options) { status = 1 }
        index += 1
    }
    return status
}
