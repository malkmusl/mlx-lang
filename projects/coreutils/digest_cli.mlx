// What md5sum, sha1sum, sha224sum, sha256sum, sha384sum, sha512sum and
// b2sum share: their options, printing a file's digest (plain or
// --tag), checking the lists they print (-c), and the digests themselves
// (std.md5, std.sha1, std.sha2, std.blake2), which cksum uses too. A
// tool's main names its algorithm, its name and the summary its --help
// prints:
//
//     return digest_cli.main(arguments, digest_cli.Kind.md5, "md5sum", "MD5 (128-bit)")
const std = @import("std")
const common = @import("./common.mlx")
const crash = @import("std.crash")
const base64 = @import("std.base64")
const md5 = @import("std.md5")
const sha1 = @import("std.sha1")
const sha2 = @import("std.sha2")
const blake2 = @import("std.blake2")

pub const Kind = enum(u8) {
    md5,
    sha1,
    sha224,
    sha256,
    sha384,
    sha512,
    blake2b,
}

// The longest digest, BLAKE2b's and SHA-512's.
pub const MAX_DIGEST: usize = 64

// Digest bytes of `kind`.
pub fn digestLength(kind: Kind) -> usize {
    if kind == Kind.md5 { return 16 }
    if kind == Kind.sha1 { return 20 }
    if kind == Kind.sha224 { return 28 }
    if kind == Kind.sha256 { return 32 }
    if kind == Kind.sha384 { return 48 }
    return 64
}

// The name a --tag line starts with.
pub fn tagName(kind: Kind) -> []const u8 {
    if kind == Kind.md5 { return "MD5" }
    if kind == Kind.sha1 { return "SHA1" }
    if kind == Kind.sha224 { return "SHA224" }
    if kind == Kind.sha256 { return "SHA256" }
    if kind == Kind.sha384 { return "SHA384" }
    if kind == Kind.sha512 { return "SHA512" }
    return "BLAKE2b"
}

// A digest being worked out, whichever its kind.
const Hashing = struct {
    kind: Kind
    md5: md5.Md5
    sha1: sha1.Sha1
    small: sha2.Sha256
    large: sha2.Sha512
    blake: blake2.Blake2b
}

fn start(hashing: *Hashing, kind: Kind) -> void {
    hashing.*.kind = kind
    if kind == Kind.md5 { md5.md5Init(&hashing.*.md5) }
    if kind == Kind.sha1 { sha1.sha1Init(&hashing.*.sha1) }
    if kind == Kind.sha224 { sha2.sha224Init(&hashing.*.small) }
    if kind == Kind.sha256 { sha2.sha256Init(&hashing.*.small) }
    if kind == Kind.sha384 { sha2.sha384Init(&hashing.*.large) }
    if kind == Kind.sha512 { sha2.sha512Init(&hashing.*.large) }
    if kind == Kind.blake2b { blake2.blake2bInit(&hashing.*.blake, 64, "") }
}

fn add(hashing: *Hashing, bytes: []const u8) -> void {
    const kind = hashing.*.kind
    if kind == Kind.md5 { md5.md5Update(&hashing.*.md5, bytes) }
    if kind == Kind.sha1 { sha1.sha1Update(&hashing.*.sha1, bytes) }
    if kind == Kind.sha224 || kind == Kind.sha256 { sha2.sha256Update(&hashing.*.small, bytes) }
    if kind == Kind.sha384 || kind == Kind.sha512 { sha2.sha512Update(&hashing.*.large, bytes) }
    if kind == Kind.blake2b { blake2.blake2bUpdate(&hashing.*.blake, bytes) }
}

fn finish(hashing: *Hashing, digest: *[64]u8) -> void {
    const kind = hashing.*.kind
    unsafe {
        if kind == Kind.md5 { md5.md5Final(&hashing.*.md5, @ptrCast(*[16]u8, digest)) }
        if kind == Kind.sha1 { sha1.sha1Final(&hashing.*.sha1, @ptrCast(*[20]u8, digest)) }
        if kind == Kind.sha224 { sha2.sha224Final(&hashing.*.small, @ptrCast(*[28]u8, digest)) }
        if kind == Kind.sha256 { sha2.sha256Final(&hashing.*.small, @ptrCast(*[32]u8, digest)) }
        if kind == Kind.sha384 { sha2.sha384Final(&hashing.*.large, @ptrCast(*[48]u8, digest)) }
        if kind == Kind.sha512 { sha2.sha512Final(&hashing.*.large, digest) }
        if kind == Kind.blake2b { blake2.blake2bFinal(&hashing.*.blake, @ptrCast([*]u8, digest)) }
    }
}

// The digest of `bytes` into `digest` (its first digestLength(kind)
// bytes).
pub fn digestBytes(kind: Kind, bytes: []const u8, digest: *[64]u8) -> void {
    var hashing: Hashing = undefined
    start(&hashing, kind)
    add(&hashing, bytes)
    finish(&hashing, digest)
}

// The digest of what `file` holds, read until it ends or fails.
fn digestOpen(kind: Kind, file: std.fs.File, digest: *[64]u8) -> void {
    var hashing: Hashing = undefined
    start(&hashing, kind)
    var buffer: [65536]u8 = undefined
    const bytes: [*]u8 = &buffer
    while true {
        const amount = std.fs.read(file, bytes, 65536)
        if amount <= 0 { break }
        add(&hashing, bytes[0..@bitCast(usize, amount)])
    }
    finish(&hashing, digest)
}

// The digest of the file at `path` (NUL-terminated; "-" is standard
// input); false when it cannot be opened or closed.
pub fn digestPath(kind: Kind, path: std.string.String, digest: *[64]u8) -> bool {
    if common.isDash(path) {
        digestOpen(kind, std.io.stdin(), digest)
        return true
    }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return false }
    digestOpen(kind, file, digest)
    return std.fs.close(file)
}

// `digest` as lower-case hex into `hex`: how many digits.
pub fn hexOf(kind: Kind, digest: *const [64]u8, hex: *[128]u8) -> usize {
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, digest) }
    const out: [*]u8 = unsafe { @ptrCast([*]u8, hex) }
    return base64.hexEncode(bytes[0..digestLength(kind)], out)
}

// A copy of `text` with a NUL after it (for open).
pub fn toCString(text: std.string.String) -> std.string.String {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(text.length + 1, 1)
    const buffer: [*]u8 = unsafe { @ptrCast([*]u8, allocation.?) }
    var i: usize = 0
    while i < text.length {
        buffer[i] = text.pointer[i]
        i += 1
    }
    buffer[text.length] = 0
    unsafe { return std.string.fromParts(@ptrCast([*]const u8, buffer), text.length) }
}

const Options = struct {
    binary: bool
    check: bool
    tag: bool
    zero: bool
    ignoreMissing: bool
    quiet: bool
    status: bool
    strict: bool
    warn: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .binary = false, .check = false, .tag = false, .zero = false, .ignoreMissing = false,
        .quiet = false, .status = false, .strict = false, .warn = false, .action = 0, .invalid = false, .firstFile = 1,
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else if common.equals(argument, "-b") || common.equals(argument, "--binary") {
            result.binary = true
        } else if common.equals(argument, "-c") || common.equals(argument, "--check") {
            result.check = true
        } else if common.equals(argument, "--tag") {
            result.tag = true
        } else if common.equals(argument, "-t") || common.equals(argument, "--text") {
            result.binary = false
        } else if common.equals(argument, "-z") || common.equals(argument, "--zero") {
            result.zero = true
        } else if common.equals(argument, "--ignore-missing") {
            result.ignoreMissing = true
        } else if common.equals(argument, "--quiet") {
            result.quiet = true
        } else if common.equals(argument, "--status") {
            result.status = true
        } else if common.equals(argument, "--strict") {
            result.strict = true
        } else if common.equals(argument, "-w") || common.equals(argument, "--warn") {
            result.warn = true
        } else {
            result.invalid = true
        }
        index += 1
    }
    result.firstFile = index
    return result
}

fn printDigest(kind: Kind, options: Options, path: std.string.String, digest: *const [64]u8) -> bool {
    var hex: [128]u8 = undefined
    const length = hexOf(kind, digest, &hex)
    const digits: [*]const u8 = &hex
    const file = std.io.stdout()
    var ok = true
    if options.tag {
        ok = std.io.writeAll(file, tagName(kind))
        if ok && !std.io.print(" (") { ok = false }
        if ok && !std.io.writeString(file, path) { ok = false }
        if ok && !std.io.print(") = ") { ok = false }
        if ok && !std.io.writeAllBytes(file, digits, length) { ok = false }
    } else {
        if !std.io.writeAllBytes(file, digits, length) { ok = false }
        if ok && !std.io.print(if options.binary { " *" } else { "  " }) { ok = false }
        if ok && !std.io.writeString(file, path) { ok = false }
    }
    if ok { ok = std.io.writeAll(file, if options.zero { "\0" } else { "\n" }) }
    return ok
}

// `text` as a digest of `length` bytes (hex of either case) into `out`.
fn parseHexDigest(text: std.string.String, out: [*]u8, length: usize) -> bool {
    if text.length != length * 2 { return false }
    return base64.hexDecode(text.pointer[0..text.length], out)
}

fn digestsEqual(a: [*]const u8, b: [*]const u8, length: usize) -> bool {
    var i: usize = 0
    while i < length {
        if a[i] != b[i] { return false }
        i += 1
    }
    return true
}

const Totals = struct {
    ok: usize
    failed: usize
    missing: usize
    formatErrors: usize
}

fn report(filename: std.string.String, outcome: []const u8) -> void {
    _ = std.io.writeString(std.io.stdout(), filename)
    _ = std.io.writeAll(std.io.stdout(), outcome)
}

// One line of a list: its digest and file name, either as --tag prints
// them ("MD5 (name) = digest") or plainly ("digest  name", "digest
// *name"); false when the line is neither.
fn parseLine(kind: Kind, line: std.string.String, expected: [*]u8, filename: *std.string.String) -> bool {
    const tag = tagName(kind)
    const length = digestLength(kind)
    // "TAG (": the name starts after the parenthesis.
    const named = tag.length + 1
    if line.length > named && common.equals(std.string.slice(line, 0, tag.length), tag) && line.pointer[tag.length] == 32 {
        if line.length <= named + 1 || line.pointer[named] != 40 { return false }
        var scan = named + 1
        while scan < line.length && line.pointer[scan] != 41 { scan += 1 }
        if scan >= line.length { return false }
        filename.* = toCString(std.string.slice(line, named + 1, scan))
        const rest = scan + 1
        if rest + 3 > line.length || line.pointer[rest] != 32 || line.pointer[rest + 1] != 61 || line.pointer[rest + 2] != 32 { return false }
        return parseHexDigest(std.string.slice(line, rest + 3, line.length), expected, length)
    }
    var separator: usize = 0
    while separator < line.length && line.pointer[separator] != 32 { separator += 1 }
    if separator >= line.length { return false }
    var nameStart = separator + 1
    if nameStart < line.length && (line.pointer[nameStart] == 32 || line.pointer[nameStart] == 42) { nameStart += 1 }
    filename.* = toCString(std.string.slice(line, nameStart, line.length))
    return parseHexDigest(std.string.slice(line, 0, separator), expected, length)
}

// Checks the digests listed in the file at `path`; false when one does
// not match or a file is missing (with --ignore-missing, not that).
fn checkFile(kind: Kind, tool: []const u8, options: Options, path: std.string.String, totals: *Totals) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var input = std.io.stdin()
    var opened = false
    if !common.isDash(path) {
        input = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
        if !std.fs.isValid(input) {
            common.writeFileError(tool, path)
            return false
        }
        opened = true
    }
    const data = std.fs.readToEndAlloc(input, allocator)
    if opened { _ = std.fs.close(input) }
    const length = digestLength(kind)
    var overall = true
    var lineStart: usize = 0
    var index: usize = 0
    while index <= data.length {
        if index == data.length || data.items[index] == 10 {
            if index > lineStart {
                var line: std.string.String = undefined
                unsafe {
                    const linePointer: [*]const u8 = data.items + lineStart
                    line = std.string.fromParts(linePointer, index - lineStart)
                }
                if line.pointer[line.length - 1] == 13 { line = std.string.slice(line, 0, line.length - 1) }
                var expected: [64]u8 = undefined
                const expectedBytes: [*]u8 = &expected
                var filename = std.string.fromSlice("")
                if !parseLine(kind, line, expectedBytes, &filename) {
                    totals.*.formatErrors += 1
                } else {
                    var digest: [64]u8 = undefined
                    const digestBytes: [*]const u8 = &digest
                    if !digestPath(kind, filename, &digest) {
                        totals.*.missing += 1
                        if !options.ignoreMissing {
                            overall = false
                            if !options.status { report(filename, ": FAILED open or read\n") }
                        }
                    } else if digestsEqual(digestBytes, expectedBytes, length) {
                        totals.*.ok += 1
                        if !options.status && !options.quiet { report(filename, ": OK\n") }
                    } else {
                        totals.*.failed += 1
                        overall = false
                        if !options.status { report(filename, ": FAILED\n") }
                    }
                }
            }
            lineStart = index + 1
        }
        index += 1
    }
    data.deinit()
    return overall
}

fn printHelp(tool: []const u8, summary: []const u8) -> u8 {
    var ok = std.io.print("Usage: ")
    if ok { ok = std.io.writeAll(std.io.stdout(), tool) }
    if ok { ok = std.io.print(" [OPTION]... [FILE]...\nPrint or check ") }
    if ok { ok = std.io.writeAll(std.io.stdout(), summary) }
    if ok { ok = std.io.print(" checksums.\n  -b, --binary          read in binary mode\n  -c, --check           read checksums from the FILEs and check them\n      --tag             create a BSD-style checksum\n  -t, --text            read in text mode (default)\n  -z, --zero            end each output line with NUL, not newline\n      --ignore-missing  don't fail or report status for missing files\n      --quiet           don't print OK for each successfully verified file\n      --status          don't output anything, status code shows success\n      --strict          exit non-zero for improperly formatted checksum lines\n  -w, --warn            warn about improperly formatted checksum lines\n      --help     display this help and exit\n      --version  output version information and exit\n") }
    return if ok { 0 } else { 1 }
}

// A digest tool: `tool` is its name, `summary` what --help says it
// prints ("MD5 (128-bit)").
pub fn main(arguments: [][*]const u8, kind: Kind, tool: []const u8, summary: []const u8) -> u8 {
    crash.install()
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp(tool, summary) }
    if options.action == 2 {
        var ok = std.io.print("mlx ")
        if ok { ok = std.io.writeAll(std.io.stdout(), tool) }
        if ok { ok = std.io.print(" 0.1.0\n") }
        return if ok { 0 } else { 1 }
    }
    if options.invalid {
        common.writeMessage(tool, "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    if options.check {
        var totals = Totals.{ .ok = 0, .failed = 0, .missing = 0, .formatErrors = 0 }
        var overall = true
        if options.firstFile >= count {
            if !checkFile(kind, tool, options, std.string.fromSlice("-"), &totals) { overall = false }
        } else {
            var index = options.firstFile
            while index < count {
                if !checkFile(kind, tool, options, std.process.argument(arguments, index), &totals) { overall = false }
                index += 1
            }
        }
        if totals.formatErrors > 0 && options.strict { overall = false }
        return if overall { 0 } else { 1 }
    }
    var status: u8 = 0
    var digest: [64]u8 = undefined
    if options.firstFile >= count {
        const dash = std.string.fromSlice("-")
        _ = digestPath(kind, dash, &digest)
        if !printDigest(kind, options, dash, &digest) { status = 1 }
        return status
    }
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !digestPath(kind, path, &digest) {
            common.writeFileError(tool, path)
            status = 1
        } else if !printDigest(kind, options, path, &digest) { status = 1 }
        index += 1
    }
    return status
}
