const std = @import("std")
const common = @import("../common.mlx")
const codec = @import("../codec.mlx")

const Options = struct {
    decode: bool
    ignoreGarbage: bool
    wrap: usize
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .decode = false, .ignoreGarbage = false, .wrap = 76, .action = 0, .invalid = false, .firstFile = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-d") || common.equals(argument, "--decode") {
            result.decode = true
            index += 1
            continue
        }
        if common.equals(argument, "-i") || common.equals(argument, "--ignore-garbage") {
            result.ignoreGarbage = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--wrap=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 7, argument.length))
            if !parsed.valid { result.invalid = true } else { result.wrap = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-w") || (argument.length > 2 && argument.pointer[1] == 119) {
            var text = std.string.slice(argument, 2, argument.length)
            if text.length == 0 {
                index += 1
                if index >= count {
                    result.invalid = true
                    break
                }
                text = std.process.argument(arguments, index)
            }
            const parsed = std.parse.unsigned(text)
            if !parsed.valid { result.invalid = true } else { result.wrap = parsed.value }
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn readInput(path: std.string.String) -> std.fs.ArrayList {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if common.isDash(path) { return std.fs.readToEndAlloc(std.io.stdin(), allocator) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return std.array_list.ArrayList.init(allocator, 0) }
    const data = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return data
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: base32 [OPTION]... [FILE]\nBase32 encode or decode FILE, or standard input, to standard output.\n  -d, --decode          decode data\n  -i, --ignore-garbage  when decoding, ignore non-alphabet characters\n  -w, --wrap=COLS       wrap encoded lines after COLS character (default 76).\n                          Use 0 to disable line wrapping\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx base32 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("base32", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    const path = if options.firstFile < count { std.process.argument(arguments, options.firstFile) } else { std.string.fromSlice("-") }
    if options.firstFile + 1 < count {
        common.writeMessage("base32", "extra operand")
        return 1
    }
    const input = readInput(path)
    var status: u8 = 0
    unsafe {
        var data: [*]const u8 = undefined
        data = @ptrCast([*]const u8, input.items)
        if options.decode {
            const lookup = codec.buildLookup(codec.base32Alphabet(), 32)
            const result = codec.decodeGeneric(data, input.length, lookup, 5, options.ignoreGarbage)
            if !std.io.writeAllBytes(std.io.stdout(), result.data, result.length) { status = 1 }
            if !result.ok {
                common.writeMessage("base32", "invalid input")
                status = 1
            }
        } else {
            const result = codec.encodeGeneric(data, input.length, codec.base32Alphabet(), 5, 8, true)
            if !codec.writeWrapped(std.io.stdout(), result.data, result.length, options.wrap) { status = 1 }
        }
    }
    input.deinit()
    return status
}
