const std = @import("std")

fn pathExists(path: std.string.String) -> bool {
    var status: std.fs.Stat = undefined
    return std.fs.status(path.pointer, &status) == 0
}

pub fn supported() -> bool {
    return pathExists(std.string.fromSlice("/sys/fs/selinux/enforce")) || pathExists(std.string.fromSlice("/sys/fs/smackfs"))
}

pub fn warnIfUnavailable(program: std.string.String, explicit: bool) -> void {
    if !explicit || supported() { return }
    const first = std.io.writeString(std.io.stderr(), program)
    const second = std.io.eprint(": warning: ignoring --context; it requires an SELinux/SMACK-enabled kernel\n")
}
