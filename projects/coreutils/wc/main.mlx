const std = @import("std")
const common = @import("../common.mlx")
const crash = @import("std.crash")
const properties = @import("std.unicode.properties")

const Counts = struct {
    lines: usize
    words: usize
    chars: usize
    bytes: usize
    maxLineLength: usize
    currentLineLength: usize
    inWord: bool
    // A UTF-8 sequence being read: its continuation bytes still to come,
    // the code point so far, the least one its length may encode (less is
    // an overlong form, no character).
    pending: usize
    scalar: u32
    least: u32
}

const Options = struct {
    lines: bool
    words: bool
    chars: bool
    bytes: bool
    maxLineLength: bool
    utf8: bool
    filesFrom: std.string.String
    filesSet: bool
    totalMode: u8
    debug: bool
    firstFile: usize
    action: u8
    invalid: bool
}

const FileResult = struct {
    counts: Counts
    name: std.string.String
    success: bool
}

const Results = struct {
    items: [*]FileResult
    length: usize
    bytes: usize
}

fn emptyCounts() -> Counts {
    return Counts.{ .lines = 0, .words = 0, .chars = 0, .bytes = 0, .maxLineLength = 0, .currentLineLength = 0, .inWord = false, .pending = 0, .scalar = 0, .least = 0 }
}

inline fn uncommonWhitespace(value: u64, newline: usize) -> bool {
    const newline_bytes = (newline *% 72624976668147840) & 9259542123273814144
    const without_newline = value | newline_bytes
    return (without_newline -% 1012762419733073422) & ~without_newline & 9259542123273814144 != 0
}

inline fn matchingBytes(pointer: [*]const u8, needle: u8) -> usize {
    unsafe { return @byteMask64(pointer, needle) }
}

// The white space among 64 bytes: newlines (given), spaces, 9 to 13, and
// in the C locale 0xA0 (no-break space as GNU's btoc32 reads the byte).
inline fn whitespaceMask64(pointer: [*]const u8, a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, newline: usize, nbsp: bool) -> usize {
    var whitespace = newline | matchingBytes(pointer, 32)
    if nbsp { whitespace = whitespace | matchingBytes(pointer, 160) }
    const uncommon = uncommonWhitespace(a, newline & 255) || uncommonWhitespace(b, (newline >> 8) & 255) ||
        uncommonWhitespace(c, (newline >> 16) & 255) || uncommonWhitespace(d, (newline >> 24) & 255) ||
        uncommonWhitespace(e, (newline >> 32) & 255) || uncommonWhitespace(f, (newline >> 40) & 255) ||
        uncommonWhitespace(g, (newline >> 48) & 255) || uncommonWhitespace(h, (newline >> 56) & 255)
    if uncommon {
        whitespace = whitespace | matchingBytes(pointer, 9) | matchingBytes(pointer, 11) |
            matchingBytes(pointer, 12) | matchingBytes(pointer, 13)
    }
    return whitespace
}

inline fn loadWord(bytes: [*]const u8, index: usize) -> u64 {
    unsafe {
        const pointer = @ptrFromInt(*const u64, @intFromPtr(bytes) + index)
        return pointer.*
    }
}

inline fn pointerAt(bytes: [*]const u8, index: usize) -> [*]const u8 {
    return bytes + index
}

inline fn possiblyContainsWhitespace(value: u64) -> bool {
    if value == 0 { return false }
    const low_byte = (value -% 2387225703656530209) & ~value & 9259542123273814144
    return low_byte != 0 || value & 9259542123273814144 != 0
}

// What GNU wc (coreutils 9.11, glibc) counts, character by character. In
// the C locale a character is a byte; in a UTF-8 one a code point read as
// glibc reads them (overlong forms and surrogates are none; the old five-
// and six-byte forms are), and a byte that makes no character (an
// encoding error) is neither a character nor columns but part of a word.

// Whether a character is printable (iswprint): not a control, unassigned,
// a surrogate or a line or paragraph separator.
inline fn printable(c: u32, utf8: bool) -> bool {
    if c < 127 { return c >= 32 }
    if !utf8 || c < 160 { return false }
    // Ranges with every code point assigned (Latin-1 and Latin Extended,
    // Cyrillic, kana, CJK ideographs, Hangul syllables) without the tables.
    if c < 592 || (c >= 1024 && c < 1328) || (c >= 12353 && c <= 12438) || (c >= 12441 && c <= 12543) || (c >= 19968 && c <= 40959) || (c >= 44032 && c <= 55203) { return true }
    const category = properties.generalCategory(c)
    return category != properties.GeneralCategory.unassigned && category != properties.GeneralCategory.control &&
        category != properties.GeneralCategory.surrogate && category != properties.GeneralCategory.lineSeparator &&
        category != properties.GeneralCategory.paragraphSeparator
}

// White space between words (isspace or c32isspace, and the no-break
// spaces U+00A0, U+2007, U+202F, U+2060): ASCII's, 0xA0 in the C locale,
// Unicode's in UTF-8.
inline fn space(c: u32, utf8: bool) -> bool {
    if c == 32 || (c >= 9 && c <= 13) { return true }
    if !utf8 { return c == 160 }
    return c == 160 || c == 5760 || (c >= 8192 && c <= 8202) || c == 8239 || c == 8287 || c == 8288 || c == 12288
}

// -L: a tab to the next multiple of 8; a newline, carriage return or
// form feed ends the line; a printable character takes its columns.
inline fn updateWidth(counts: *Counts, c: u32, utf8: bool) -> void {
    if c == 10 || c == 13 || c == 12 {
        if counts.*.currentLineLength > counts.*.maxLineLength { counts.*.maxLineLength = counts.*.currentLineLength }
        counts.*.currentLineLength = 0
    } else if c == 9 {
        counts.*.currentLineLength = (counts.*.currentLineLength / 8 + 1) * 8
    } else if c < 127 {
        if c >= 32 { counts.*.currentLineLength += 1 }
    } else if printable(c, utf8) {
        counts.*.currentLineLength += columns(c)
    }
}

// A printable character's columns (wcwidth): the common ranges without
// the tables.
inline fn columns(c: u32) -> usize {
    if c < 768 || (c >= 1024 && c < 1155) { return 1 }
    if (c >= 12353 && c <= 12438) || (c >= 12443 && c <= 12543) || (c >= 19968 && c <= 40959) || (c >= 44032 && c <= 55203) { return 2 }
    return @intCast(usize, properties.columnWidth(c))
}

// -w: a word is what lies between white space (any other character, a
// control or an encoding error too, is part of one).
inline fn wordCharacter(counts: *Counts, c: u32, utf8: bool) -> void {
    if space(c, utf8) {
        counts.*.inWord = false
    } else {
        inWord(counts)
    }
}

inline fn inWord(counts: *Counts) -> void {
    if !counts.*.inWord { counts.*.words += 1 }
    counts.*.inWord = true
}

// A sequence that makes no character: part of a word (-w), nothing else.
inline fn encodingError(counts: *Counts, wanted: Wanted) -> void {
    counts.*.pending = 0
    if wanted.words { inWord(counts) }
}

// What to count of each character (Options, as the byte loop needs it).
const Wanted = struct {
    chars: bool
    width: bool
    words: bool
    utf8: bool
}

inline fn character(counts: *Counts, c: u32, wanted: Wanted) -> void {
    if wanted.chars { counts.*.chars += 1 }
    if wanted.width { updateWidth(counts, c, wanted.utf8) }
    if wanted.words { wordCharacter(counts, c, wanted.utf8) }
}

// A byte past ASCII in UTF-8: a lead byte starts a sequence (C0, C1 and
// FE, FF none), a continuation byte goes on with one (or is no character).
fn sequenceByte(counts: *Counts, byte: u8, wanted: Wanted) -> void {
    if byte & 192 == 128 {
        if counts.*.pending == 0 {
            encodingError(counts, wanted)
            return
        }
        counts.*.scalar = (counts.*.scalar << 6) | @intCast(u32, byte & 63)
        counts.*.pending -= 1
        if counts.*.pending == 0 {
            const c = counts.*.scalar
            if c >= counts.*.least && (c < 55296 || c > 57343) { character(counts, c, wanted) } else { encodingError(counts, wanted) }
        }
        return
    }
    // A lead byte ends a sequence that was not finished.
    if counts.*.pending != 0 { encodingError(counts, wanted) }
    if byte < 194 || byte >= 254 {
        encodingError(counts, wanted)
    } else if byte >= 194 && byte < 224 {
        counts.*.pending = 1
        counts.*.scalar = @intCast(u32, byte & 31)
        counts.*.least = 128
    } else if byte >= 224 && byte < 240 {
        counts.*.pending = 2
        counts.*.scalar = @intCast(u32, byte & 15)
        counts.*.least = 2048
    } else if byte >= 240 && byte < 248 {
        counts.*.pending = 3
        counts.*.scalar = @intCast(u32, byte & 7)
        counts.*.least = 65536
    } else if byte >= 248 && byte < 252 {
        counts.*.pending = 4
        counts.*.scalar = @intCast(u32, byte & 3)
        counts.*.least = 2097152
    } else if byte >= 252 && byte < 254 {
        counts.*.pending = 5
        counts.*.scalar = @intCast(u32, byte & 1)
        counts.*.least = 67108864
    }
}

// UTF-8 for -l, -w and -m (no -L): consumeScalar's work with the state
// in locals, written back once.
fn consumeUtf8(counts: *Counts, bytes: [*]const u8, start: usize, length: usize, wantLines: bool, wantWords: bool, wantChars: bool) -> void {
    var lines = counts.*.lines
    var words = counts.*.words
    var chars = counts.*.chars
    var in_word = counts.*.inWord
    var pending = counts.*.pending
    var scalar = counts.*.scalar
    var least = counts.*.least
    var index = start
    while index < length {
        const byte = bytes[index]
        index += 1
        var c: u32 = 0
        if byte < 128 {
            if pending != 0 {
                // The sequence before it was not finished: an encoding error.
                pending = 0
                if !in_word { words += 1 }
                in_word = true
            }
            if byte == 10 && wantLines { lines += 1 }
            c = @intCast(u32, byte)
        } else if byte & 192 == 128 {
            if pending == 0 {
                if !in_word { words += 1 }
                in_word = true
                continue
            }
            scalar = (scalar << 6) | @intCast(u32, byte & 63)
            pending -= 1
            if pending != 0 { continue }
            if scalar < least || (scalar >= 55296 && scalar <= 57343) {
                if !in_word { words += 1 }
                in_word = true
                continue
            }
            c = scalar
        } else {
            if pending != 0 || byte < 194 || byte >= 254 {
                if !in_word { words += 1 }
                in_word = true
            }
            pending = 0
            if byte >= 194 && byte < 224 {
                pending = 1
                scalar = @intCast(u32, byte & 31)
                least = 128
            } else if byte >= 224 && byte < 240 {
                pending = 2
                scalar = @intCast(u32, byte & 15)
                least = 2048
            } else if byte >= 240 && byte < 248 {
                pending = 3
                scalar = @intCast(u32, byte & 7)
                least = 65536
            } else if byte >= 248 && byte < 252 {
                pending = 4
                scalar = @intCast(u32, byte & 3)
                least = 2097152
            } else if byte >= 252 && byte < 254 {
                pending = 5
                scalar = @intCast(u32, byte & 1)
                least = 67108864
            }
            continue
        }
        // A character.
        chars += 1
        if space(c, true) {
            in_word = false
        } else if !in_word {
            words += 1
            in_word = true
        }
    }
    counts.*.lines = lines
    if wantWords { counts.*.words = words }
    if wantChars { counts.*.chars = chars }
    counts.*.inWord = in_word
    counts.*.pending = pending
    counts.*.scalar = scalar
    counts.*.least = least
}

fn consumeScalar(counts: *Counts, bytes: [*]const u8, start: usize, length: usize, options: Options) -> void {
    if options.utf8 && !options.maxLineLength {
        consumeUtf8(counts, bytes, start, length, options.lines, options.words, options.chars)
        return
    }
    const wanted = Wanted.{ .chars = options.chars && options.utf8, .width = options.maxLineLength, .words = options.words, .utf8 = options.utf8 }
    const lines = options.lines
    const utf8 = options.utf8
    var index = start
    while index < length {
        const byte = bytes[index]
        if lines && byte == 10 { counts.*.lines += 1 }
        if !utf8 || byte < 128 {
            // (An ASCII byte ends a sequence that was not finished.)
            if counts.*.pending != 0 { encodingError(counts, wanted) }
            character(counts, @intCast(u32, byte), wanted)
        } else {
            sequenceByte(counts, byte, wanted)
        }
        index += 1
    }
}

fn consume(counts: *Counts, bytes: [*]const u8, length: usize, options: Options) -> void {
    var lines = counts.*.lines
    var words = counts.*.words
    var in_word = counts.*.inWord
    var index: usize = 0
    // (Characters are bytes in the C locale: countFile counts them so.)
    const utf8Chars = options.chars && options.utf8
    const decode = options.utf8 && (options.words || options.chars)
    while !options.maxLineLength && index + 64 <= length {
        const a = loadWord(bytes, index)
        const b = loadWord(bytes, index + 8)
        const c = loadWord(bytes, index + 16)
        const d = loadWord(bytes, index + 24)
        const e = loadWord(bytes, index + 32)
        const f = loadWord(bytes, index + 40)
        const g = loadWord(bytes, index + 48)
        const h = loadWord(bytes, index + 56)
        const pointer = pointerAt(bytes, index)
        const high = (a | b | c | d | e | f | g | h) & 9259542123273814144 != 0
        if decode && (high || counts.*.pending != 0) {
            // UTF-8 past ASCII: byte by byte (lines, words, characters).
            counts.*.lines = lines
            counts.*.words = words
            counts.*.inWord = in_word
            consumeScalar(counts, bytes, index, index + 64, options)
            lines = counts.*.lines
            words = counts.*.words
            in_word = counts.*.inWord
            index += 64
            continue
        }
        if utf8Chars { counts.*.chars += 64 }
        if options.words {
            if !possiblyContainsWhitespace(a) && !possiblyContainsWhitespace(b) &&
                !possiblyContainsWhitespace(c) && !possiblyContainsWhitespace(d) &&
                !possiblyContainsWhitespace(e) && !possiblyContainsWhitespace(f) &&
                !possiblyContainsWhitespace(g) && !possiblyContainsWhitespace(h) {
                if !in_word { words += 1 }
                in_word = true
            } else {
                const newline = matchingBytes(pointer, 10)
                const whitespace = whitespaceMask64(pointer, a, b, c, d, e, f, g, h, newline, high && !options.utf8)
                const previous = if in_word { 0 } else { 1 }
                const starts = ~whitespace & ((whitespace << 1) | previous)
                words += @popCount(starts)
                in_word = whitespace & 9223372036854775808 == 0
                if options.lines { lines += @popCount(newline) }
            }
        } else if options.lines {
            lines += @popCount(matchingBytes(pointer, 10))
        }
        index += 64
    }
    counts.*.lines = lines
    counts.*.words = words
    counts.*.inWord = in_word
    consumeScalar(counts, bytes, index, length, options)
    counts.*.bytes += length
}

fn countFile(file: std.fs.File, counts: *Counts, options: Options) -> bool {
    // The C locale's characters are its bytes.
    defer { if options.chars && !options.utf8 { counts.*.chars = counts.*.bytes } }
    if !options.lines && !options.words && !(options.chars && options.utf8) && !options.maxLineLength {
        const start = std.fs.seek(file, 0, std.fs.SEEK_CURRENT)
        if start >= 0 {
            const end = std.fs.seek(file, 0, std.fs.SEEK_END)
            if end >= start {
                counts.*.bytes += @bitCast(usize, end - start)
                return true
            }
            _ = std.fs.seek(file, start, std.fs.SEEK_START)
        }
    }
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const allocation = allocator.alloc(common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = false
    while true {
        var amount: isize = 0
        unsafe {
            amount = std.fs.read(file, buffer, common.BUFFER_SIZE)
        }
        if amount < 0 { break }
        if amount == 0 {
            success = true
            break
        }
        const length = @bitCast(usize, amount)
        if options.lines || options.words || (options.chars && options.utf8) || options.maxLineLength {
            unsafe { consume(counts, @ptrCast([*]const u8, buffer), length, options) }
        } else {
            counts.*.bytes += length
        }
    }
    allocator.free(buffer, common.BUFFER_SIZE, 8)
    // A sequence the input ended in is an encoding error.
    if counts.*.pending != 0 && options.words { inWord(counts) }
    counts.*.pending = 0
    if counts.*.currentLineLength > counts.*.maxLineLength { counts.*.maxLineLength = counts.*.currentLineLength }
    return success
}

fn containsUtf8(value: std.string.String) -> bool {
    var index: usize = 0
    while index + 3 < value.length {
        if std.ascii.toLower(value.pointer[index]) == 117 && std.ascii.toLower(value.pointer[index + 1]) == 116 && std.ascii.toLower(value.pointer[index + 2]) == 102 {
            var digit = index + 3
            if value.pointer[digit] == 45 { digit += 1 }
            if digit < value.length && value.pointer[digit] == 56 { return true }
        }
        index += 1
    }
    return false
}

fn usesUtf8(arguments: [][*]const u8) -> bool {
    var locale = std.process.environment(arguments, std.string.asSlice(std.string.fromSlice("LC_ALL")))
    if locale == null { locale = std.process.environment(arguments, std.string.asSlice(std.string.fromSlice("LC_CTYPE"))) }
    if locale == null { locale = std.process.environment(arguments, std.string.asSlice(std.string.fromSlice("LANG"))) }
    return locale != null && containsUtf8(locale.?)
}

fn setTotalMode(value: std.string.String, options: *Options) -> bool {
    if common.equals(value, "auto") { options.*.totalMode = 0 } else if common.equals(value, "always") {
        options.*.totalMode = 1
    } else if common.equals(value, "only") { options.*.totalMode = 2 } else if common.equals(value, "never") {
        options.*.totalMode = 3
    } else { return false }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--lines") { options.*.lines = true } else if common.equals(argument, "--words") {
        options.*.words = true
    } else if common.equals(argument, "--chars") { options.*.chars = true } else if common.equals(argument, "--bytes") {
        options.*.bytes = true
    } else if common.equals(argument, "--max-line-length") { options.*.maxLineLength = true } else if common.equals(argument, "--debug") {
        options.*.debug = true
    } else if std.string.startsWith(argument, std.string.fromSlice("--files0-from=")) {
        options.*.filesFrom = std.string.slice(argument, 14, argument.length)
        options.*.filesSet = options.*.filesFrom.length > 0
        if !options.*.filesSet { return false }
    } else if common.equals(argument, "--files0-from") {
        index.* += 1
        if index.* >= std.process.count(arguments) { return false }
        options.*.filesFrom = std.process.argument(arguments, index.*)
        options.*.filesSet = true
    } else if std.string.startsWith(argument, std.string.fromSlice("--total=")) {
        if !setTotalMode(std.string.slice(argument, 8, argument.length), options) { return false }
    } else if common.equals(argument, "--total") {
        index.* += 1
        if index.* >= std.process.count(arguments) { return false }
        if !setTotalMode(std.process.argument(arguments, index.*), options) { return false }
    } else if common.equals(argument, "--help") {
        options.*.action = 1
    } else if common.equals(argument, "--version") { options.*.action = 2 } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    const count = std.process.count(arguments)
    var result = Options.{ .lines = false, .words = false, .chars = false, .bytes = false, .maxLineLength = false, .utf8 = usesUtf8(arguments), .filesFrom = std.string.fromSlice(""), .filesSet = false, .totalMode = 0, .debug = false, .firstFile = 1, .action = 0, .invalid = false }
    var argument_index: usize = 1
    while argument_index < count {
        const argument = std.process.argument(arguments, argument_index)
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if argument.length == 2 && argument.pointer[1] == 45 {
            argument_index += 1
            break
        }
        if argument.pointer[1] == 45 {
            if !parseLong(arguments, &argument_index, argument, &result) { result.invalid = true }
        } else {
            var index: usize = 1
            while index < argument.length {
                const option = argument.pointer[index]
                if option == 108 { result.lines = true } else if option == 119 { result.words = true } else if option == 109 {
                    result.chars = true
                } else if option == 99 { result.bytes = true } else if option == 76 { result.maxLineLength = true } else { result.invalid = true }
                index += 1
            }
        }
        argument_index += 1
    }
    result.firstFile = argument_index
    if !result.lines && !result.words && !result.chars && !result.bytes && !result.maxLineLength {
        result.lines = true
        result.words = true
        result.bytes = true
    }
    return result
}

fn digitCount(value: usize) -> usize {
    var result: usize = 1
    var remaining = value
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn outputWidth(counts: Counts, options: Options) -> usize {
    var maximum: usize = 0
    if options.lines && counts.lines > maximum { maximum = counts.lines }
    if options.words && counts.words > maximum { maximum = counts.words }
    if options.chars && counts.chars > maximum { maximum = counts.chars }
    if options.bytes && counts.bytes > maximum { maximum = counts.bytes }
    if options.maxLineLength && counts.maxLineLength > maximum { maximum = counts.maxLineLength }
    return digitCount(maximum)
}

fn printCount(value: usize, width: usize, first: *bool) -> bool {
    if !first.* && !std.io.print(" ") { return false }
    var padding = width - digitCount(value)
    while padding > 0 {
        if !std.io.print(" ") { return false }
        padding -= 1
    }
    first.* = false
    return std.io.writeUnsigned(std.io.stdout(), value)
}

fn printCounts(counts: Counts, options: Options, name: std.string.String, width: usize) -> bool {
    var first = true
    if options.lines && !printCount(counts.lines, width, &first) { return false }
    if options.words && !printCount(counts.words, width, &first) { return false }
    if options.chars && !printCount(counts.chars, width, &first) { return false }
    if options.bytes && !printCount(counts.bytes, width, &first) { return false }
    if options.maxLineLength && !printCount(counts.maxLineLength, width, &first) { return false }
    if name.length > 0 {
        if !std.io.print(" ") || !std.io.printString(name) { return false }
    }
    return std.io.print("\n")
}

fn addCounts(total: *Counts, value: Counts) -> void {
    total.*.lines += value.lines
    total.*.words += value.words
    total.*.chars += value.chars
    total.*.bytes += value.bytes
    if value.maxLineLength > total.*.maxLineLength { total.*.maxLineLength = value.maxLineLength }
}

fn processPath(path: std.string.String, counts: *Counts, options: Options) -> bool {
    if common.isDash(path) { return countFile(std.io.stdin(), counts, options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return false }
    const counted = countFile(file, counts, options)
    const closed = std.fs.close(file)
    return counted && closed
}

fn allocateResults(length: usize) -> ?Results {
    const bytes = length * @sizeOf(FileResult)
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const allocation = allocator.alloc(bytes, @alignOf(FileResult))
    if allocation == null { return null }
    unsafe { return Results.{ .items = @ptrCast([*]FileResult, allocation.?), .length = length, .bytes = bytes } }
}

fn freeResults(results: Results) -> void {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    unsafe { allocator.free(@ptrCast([*]u8, results.items), results.bytes, @alignOf(FileResult)) }
}

fn summarize(results: Results) -> Counts {
    var total = emptyCounts()
    var index: usize = 0
    while index < results.length {
        if results.items[index].success { addCounts(&total, results.items[index].counts) }
        index += 1
    }
    return total
}

fn printResults(results: Results, options: Options) -> u8 {
    const total = summarize(results)
    const width = outputWidth(total, options)
    var status: u8 = 0
    var index: usize = 0
    if options.totalMode != 2 {
        while index < results.length {
            const result = results.items[index]
            if !result.success { status = 1 } else if !printCounts(result.counts, options, result.name, width) { status = 1 }
            index += 1
        }
    }
    const show_total = options.totalMode == 1 || options.totalMode == 2 || options.totalMode == 0 && results.length > 1
    if show_total {
        const name = if options.totalMode == 2 { std.string.fromSlice("") } else { std.string.fromSlice("total") }
        if !printCounts(total, options, name, width) { status = 1 }
    }
    return status
}

fn runArguments(arguments: [][*]const u8, options: Options) -> u8 {
    const count = std.process.count(arguments)
    const path_count = if options.firstFile >= count { 1 } else { count - options.firstFile }
    const allocated = allocateResults(path_count)
    if allocated == null { return 1 }
    const results = allocated.?
    var index: usize = 0
    while index < path_count {
        const name = if options.firstFile >= count { std.string.fromSlice("") } else { std.process.argument(arguments, options.firstFile + index) }
        var counts = emptyCounts()
        const success = if name.length == 0 { countFile(std.io.stdin(), &counts, options) } else { processPath(name, &counts, options) }
        if !success && name.length > 0 { common.writeFileError("wc", name) }
        results.items[index] = FileResult.{ .counts = counts, .name = name, .success = success }
        index += 1
    }
    const status = printResults(results, options)
    freeResults(results)
    return status
}

fn fileListCount(list: std.fs.ArrayList) -> usize {
    var result: usize = 0
    var index: usize = 0
    while index < list.length {
        if list.items[index] == 0 { result += 1 }
        index += 1
    }
    return result
}

fn fillFileList(list: std.fs.ArrayList, results: Results, options: Options) -> u8 {
    var start: usize = 0
    var result_index: usize = 0
    var status: u8 = 0
    var index: usize = 0
    while index < list.length {
        if list.items[index] == 0 {
            const pointer: [*]const u8 = list.items + start
            const name = std.string.fromParts(pointer, index - start)
            var counts = emptyCounts()
            const success = name.length > 0 && !common.isDash(name) && processPath(name, &counts, options)
            if !success {
                common.writeFileError("wc", name)
                status = 1
            }
            results.items[result_index] = FileResult.{ .counts = counts, .name = name, .success = success }
            result_index += 1
            start = index + 1
        }
        index += 1
    }
    return status
}

fn runFileList(options: Options) -> u8 {
    const loaded = common.readOperand(options.filesFrom)
    if loaded == null {
        common.writeFileError("wc", options.filesFrom)
        return 1
    }
    const list = loaded.?
    if list.length > 0 && list.items[list.length - 1] != 0 {
        list.deinit()
        common.writeMessage("wc", "unterminated file name")
        return 1
    }
    const count = fileListCount(list)
    if count == 0 {
        list.deinit()
        return 0
    }
    const allocated = allocateResults(count)
    if allocated == null {
        list.deinit()
        return 1
    }
    const results = allocated.?
    const fill_status = fillFileList(list, results, options)
    var status = printResults(results, options)
    if fill_status != 0 { status = fill_status }
    freeResults(results)
    list.deinit()
    return status
}

pub fn main(arguments: [][*]const u8) -> u8 {
    crash.install()
    const options = parseOptions(arguments)
    if options.action == 1 { return if std.io.print("Usage: wc [OPTION]... [FILE]...\n  -c, --bytes  -m, --chars  -l, --lines\n  -L, --max-line-length  -w, --words\n") { 0 } else { 1 } }
    if options.action == 2 { return if std.io.print("mlx wc 0.1.0\n") { 0 } else { 1 } }
    if options.invalid || options.filesSet && options.firstFile < std.process.count(arguments) {
        common.writeMessage("wc", "invalid option")
        return 1
    }
    if options.debug { common.writeMessage("wc", "using portable 64-byte scanner") }
    if options.filesSet { return runFileList(options) }
    return runArguments(arguments, options)
}
