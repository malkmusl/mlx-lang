const std = @import("std")
const common = @import("../common.mlx")
const timezone = @import("../ls/timezone.mlx")

const Calendar = struct {
    year: isize
    month: usize
    day: usize
    hour: usize
    minute: usize
    second: usize
    weekday: usize
    yearDay: usize
}

fn leap(year: isize) -> bool { return year % 4 == 0 && year % 100 != 0 || year % 400 == 0 }

fn monthDays(year: isize, month: usize) -> usize {
    if month == 2 { return if leap(year) { 29 } else { 28 } }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

fn floorDays(seconds: isize) -> isize {
    if seconds >= 0 { return seconds / 86400 }
    return -((-seconds + 86399) / 86400)
}

fn calendarFromSeconds(seconds: isize) -> Calendar {
    const days = floorDays(seconds)
    const clock = @intCast(usize, seconds - days * 86400)
    const shifted = days + 719468
    const era = if shifted >= 0 { shifted / 146097 } else { (shifted - 146096) / 146097 }
    const dayOfEra = shifted - era * 146097
    const yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var year = yearOfEra + era * 400
    const dayOfYearMarch = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    const monthPart = (5 * dayOfYearMarch + 2) / 153
    const day = dayOfYearMarch - (153 * monthPart + 2) / 5 + 1
    const month = if monthPart < 10 { monthPart + 3 } else { monthPart - 9 }
    if month <= 2 { year += 1 }
    var yearDay: usize = @intCast(usize, day)
    var scan: usize = 1
    while scan < @intCast(usize, month) {
        yearDay += monthDays(year, scan)
        scan += 1
    }
    var weekday = (days + 4) % 7
    if weekday < 0 { weekday += 7 }
    return Calendar.{ .year = year, .month = @intCast(usize, month), .day = @intCast(usize, day), .hour = clock / 3600, .minute = clock / 60 % 60, .second = clock % 60, .weekday = @intCast(usize, weekday), .yearDay = yearDay }
}

fn daysFromCivil(y: isize, m: usize, d: usize) -> isize {
    var year = y
    if m <= 2 { year -= 1 }
    const era = if year >= 0 { year / 400 } else { (year - 399) / 400 }
    const yoe = year - era * 400
    const monthIndex: isize = if m > 2 { @intCast(isize, m) - 3 } else { @intCast(isize, m) + 9 }
    const doy = (153 * monthIndex + 2) / 5 + @intCast(isize, d) - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn digitsCount(value: usize) -> usize {
    var result: usize = 1
    var remaining = value
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn padding(file: std.fs.File, amount: usize, byte: u8) -> bool {
    var buffer: [1]u8 = [1]u8{ byte }
    var remaining = amount
    while remaining > 0 {
        unsafe { if !std.io.writeAllBytes(file, @ptrCast([*]const u8, buffer[0..1]), 1) { return false } }
        remaining -= 1
    }
    return true
}

fn number(file: std.fs.File, value: usize, width: usize, pad: u8) -> bool {
    const length = digitsCount(value)
    if !padding(file, if width > length { width - length } else { 0 }, pad) { return false }
    return std.io.writeUnsigned(file, value)
}

fn signedYear(file: std.fs.File, value: isize, width: usize) -> bool {
    if value >= 0 { return number(file, @bitCast(usize, value), width, 48) }
    if !std.io.writeAll(file, "-") { return false }
    return number(file, @bitCast(usize, -(value + 1)) + 1, width, 48)
}

fn monthName(month: usize, full: bool) -> []const u8 {
    if month == 1 { return if full { "January" } else { "Jan" } }
    if month == 2 { return if full { "February" } else { "Feb" } }
    if month == 3 { return if full { "March" } else { "Mar" } }
    if month == 4 { return if full { "April" } else { "Apr" } }
    if month == 5 { return "May" }
    if month == 6 { return if full { "June" } else { "Jun" } }
    if month == 7 { return if full { "July" } else { "Jul" } }
    if month == 8 { return if full { "August" } else { "Aug" } }
    if month == 9 { return if full { "September" } else { "Sep" } }
    if month == 10 { return if full { "October" } else { "Oct" } }
    if month == 11 { return if full { "November" } else { "Nov" } }
    return if full { "December" } else { "Dec" }
}

fn weekdayName(day: usize, full: bool) -> []const u8 {
    if day == 0 { return if full { "Sunday" } else { "Sun" } }
    if day == 1 { return if full { "Monday" } else { "Mon" } }
    if day == 2 { return if full { "Tuesday" } else { "Tue" } }
    if day == 3 { return if full { "Wednesday" } else { "Wed" } }
    if day == 4 { return if full { "Thursday" } else { "Thu" } }
    if day == 5 { return if full { "Friday" } else { "Fri" } }
    return if full { "Saturday" } else { "Sat" }
}

fn writeOffset(file: std.fs.File, offset: isize, colon: bool) -> bool {
    const positive = offset >= 0
    const magnitude = if positive { @bitCast(usize, offset) } else { @bitCast(usize, -(offset + 1)) + 1 }
    if !std.io.writeAll(file, if positive { "+" } else { "-" }) { return false }
    if !number(file, magnitude / 3600, 2, 48) { return false }
    if colon && !std.io.writeAll(file, ":") { return false }
    return number(file, magnitude / 60 % 60, 2, 48)
}

fn writeClock(file: std.fs.File, value: Calendar, seconds: bool) -> bool {
    if !number(file, value.hour, 2, 48) || !std.io.writeAll(file, ":") || !number(file, value.minute, 2, 48) { return false }
    if !seconds { return true }
    if !std.io.writeAll(file, ":") { return false }
    return number(file, value.second, 2, 48)
}

fn writeDate(file: std.fs.File, value: Calendar) -> bool {
    if !signedYear(file, value.year, 4) || !std.io.writeAll(file, "-") || !number(file, value.month, 2, 48) { return false }
    if !std.io.writeAll(file, "-") { return false }
    return number(file, value.day, 2, 48)
}

fn hour12(hour: usize) -> usize {
    const h = hour % 12
    return if h == 0 { 12 } else { h }
}

fn customSpecifier(file: std.fs.File, specifier: u8, value: Calendar, epochSeconds: isize, nanoseconds: isize, zone: timezone.Context, useZone: bool) -> bool {
    if specifier == 37 { return std.io.writeAll(file, "%") }
    if specifier == 89 { return signedYear(file, value.year, 4) }
    if specifier == 121 { return number(file, @intCast(usize, if value.year >= 0 { value.year % 100 } else { -value.year % 100 }), 2, 48) }
    if specifier == 109 { return number(file, value.month, 2, 48) }
    if specifier == 100 { return number(file, value.day, 2, 48) }
    if specifier == 101 { return number(file, value.day, 2, 32) }
    if specifier == 72 { return number(file, value.hour, 2, 48) }
    if specifier == 107 { return number(file, value.hour, 2, 32) }
    if specifier == 73 { return number(file, hour12(value.hour), 2, 48) }
    if specifier == 108 { return number(file, hour12(value.hour), 2, 32) }
    if specifier == 112 { return std.io.writeAll(file, if value.hour < 12 { "AM" } else { "PM" }) }
    if specifier == 80 { return std.io.writeAll(file, if value.hour < 12 { "am" } else { "pm" }) }
    if specifier == 77 { return number(file, value.minute, 2, 48) }
    if specifier == 83 { return number(file, value.second, 2, 48) }
    if specifier == 78 { return number(file, @bitCast(usize, nanoseconds), 9, 48) }
    if specifier == 98 || specifier == 104 { return std.io.writeAll(file, monthName(value.month, false)) }
    if specifier == 66 { return std.io.writeAll(file, monthName(value.month, true)) }
    if specifier == 97 { return std.io.writeAll(file, weekdayName(value.weekday, false)) }
    if specifier == 65 { return std.io.writeAll(file, weekdayName(value.weekday, true)) }
    if specifier == 106 { return number(file, value.yearDay, 3, 48) }
    if specifier == 119 { return std.io.writeUnsigned(file, value.weekday) }
    if specifier == 117 { return std.io.writeUnsigned(file, if value.weekday == 0 { 7 } else { value.weekday }) }
    if specifier == 122 { return writeOffset(file, if useZone { timezone.offset(zone, epochSeconds) } else { 0 }, false) }
    if specifier == 90 { return std.io.printString(if useZone { timezone.abbreviation(zone, epochSeconds) } else { std.string.fromSlice("UTC") }) }
    if specifier == 115 { return if epochSeconds >= 0 { std.io.writeUnsigned(file, @bitCast(usize, epochSeconds)) } else { std.io.writeAll(file, "-") && std.io.writeUnsigned(file, @bitCast(usize, -(epochSeconds + 1)) + 1) } }
    if specifier == 70 { return writeDate(file, value) }
    if specifier == 82 { return writeClock(file, value, false) }
    if specifier == 84 { return writeClock(file, value, true) }
    if specifier == 68 || specifier == 120 { return number(file, value.month, 2, 48) && std.io.writeAll(file, "/") && number(file, value.day, 2, 48) && std.io.writeAll(file, "/") && number(file, @intCast(usize, if value.year >= 0 { value.year % 100 } else { -value.year % 100 }), 2, 48) }
    if specifier == 88 { return writeClock(file, value, true) }
    if specifier == 114 { return number(file, hour12(value.hour), 2, 48) && std.io.writeAll(file, ":") && number(file, value.minute, 2, 48) && std.io.writeAll(file, ":") && number(file, value.second, 2, 48) && std.io.writeAll(file, " ") && std.io.writeAll(file, if value.hour < 12 { "AM" } else { "PM" }) }
    if specifier == 99 { return std.io.writeAll(file, weekdayName(value.weekday, false)) && std.io.writeAll(file, " ") && std.io.writeAll(file, monthName(value.month, false)) && std.io.writeAll(file, " ") && number(file, value.day, 2, 32) && std.io.writeAll(file, " ") && writeClock(file, value, true) && std.io.writeAll(file, " ") && signedYear(file, value.year, 4) }
    if specifier == 110 { return std.io.writeAll(file, "\n") }
    if specifier == 116 { return std.io.writeAll(file, "\t") }
    if !std.io.writeAll(file, "%") { return false }
    var buffer: [1]u8 = [1]u8{ specifier }
    unsafe { return std.io.writeAllBytes(file, @ptrCast([*]const u8, buffer[0..1]), 1) }
}

fn writeCustom(file: std.fs.File, format: std.string.String, value: Calendar, epochSeconds: isize, nanoseconds: isize, zone: timezone.Context, useZone: bool) -> bool {
    var index: usize = 0
    while index < format.length {
        if format.pointer[index] != 37 {
            unsafe { if !std.io.writeAllBytes(file, @ptrFromInt([*]const u8, @intFromPtr(format.pointer) + index), 1) { return false } }
            index += 1
        } else {
            index += 1
            while index < format.length && (format.pointer[index] == 45 || format.pointer[index] == 95 || format.pointer[index] == 48 || format.pointer[index] == 94 || format.pointer[index] == 35) { index += 1 }
            if index == format.length || !customSpecifier(file, format.pointer[index], value, epochSeconds, nanoseconds, zone, useZone) { return false }
            index += 1
        }
    }
    return true
}

const Options = struct {
    utc: bool
    hasDate: bool
    dateString: std.string.String
    hasReference: bool
    referencePath: std.string.String
    rfcEmail: bool
    iso8601: bool
    iso8601Fmt: u8
    rfc3339: bool
    rfc3339Fmt: u8
    hasFormat: bool
    format: std.string.String
    action: u8
    invalid: bool
}

fn iso8601FormatCode(text: std.string.String) -> u8 {
    if text.length == 0 || common.equals(text, "date") { return 0 }
    if common.equals(text, "hours") { return 1 }
    if common.equals(text, "minutes") { return 2 }
    if common.equals(text, "seconds") { return 3 }
    if common.equals(text, "ns") { return 4 }
    return 255
}

fn rfc3339FormatCode(text: std.string.String) -> u8 {
    if common.equals(text, "date") { return 0 }
    if common.equals(text, "seconds") { return 3 }
    if common.equals(text, "ns") { return 4 }
    return 255
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .utc = false, .hasDate = false, .dateString = std.string.fromSlice(""),
        .hasReference = false, .referencePath = std.string.fromSlice(""),
        .rfcEmail = false, .iso8601 = false, .iso8601Fmt = 0,
        .rfc3339 = false, .rfc3339Fmt = 3,
        .hasFormat = false, .format = std.string.fromSlice(""),
        .action = 0, .invalid = false,
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if argument.length > 0 && argument.pointer[0] == 43 {
            result.hasFormat = true
            result.format = std.string.slice(argument, 1, argument.length)
            index += 1
            continue
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-u") || common.equals(argument, "--utc") || common.equals(argument, "--universal") {
            result.utc = true
            index += 1
            continue
        }
        if common.equals(argument, "-R") || common.equals(argument, "--rfc-email") || common.equals(argument, "--rfc-822") || common.equals(argument, "--rfc-2822") {
            result.rfcEmail = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--date=")) {
            result.hasDate = true
            result.dateString = std.string.slice(argument, 7, argument.length)
            index += 1
            continue
        }
        if common.equals(argument, "-d") || common.equals(argument, "--date") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            result.hasDate = true
            result.dateString = std.process.argument(arguments, index)
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--reference=")) {
            result.hasReference = true
            result.referencePath = std.string.slice(argument, 12, argument.length)
            index += 1
            continue
        }
        if common.equals(argument, "-r") || common.equals(argument, "--reference") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            result.hasReference = true
            result.referencePath = std.process.argument(arguments, index)
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--rfc-3339=")) {
            const code = rfc3339FormatCode(std.string.slice(argument, 11, argument.length))
            if code == 255 { result.invalid = true } else {
                result.rfc3339 = true
                result.rfc3339Fmt = code
            }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--iso-8601=")) {
            const code = iso8601FormatCode(std.string.slice(argument, 11, argument.length))
            if code == 255 { result.invalid = true } else {
                result.iso8601 = true
                result.iso8601Fmt = code
            }
            index += 1
            continue
        }
        if common.equals(argument, "-I") || common.equals(argument, "--iso-8601") {
            result.iso8601 = true
            result.iso8601Fmt = 0
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 73 {
            const code = iso8601FormatCode(std.string.slice(argument, 2, argument.length))
            if code == 255 { result.invalid = true } else {
                result.iso8601 = true
                result.iso8601Fmt = code
            }
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    return result
}

const ParsedDate = struct {
    seconds: isize
    nanoseconds: isize
    ok: bool
}

fn parseTwoDigits(text: std.string.String, at: usize) -> usize {
    if at + 1 >= text.length { return 0 }
    return @intCast(usize, text.pointer[at] - 48) * 10 + @intCast(usize, text.pointer[at + 1] - 48)
}

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn parseDateString(text: std.string.String, zone: timezone.Context, useZone: bool) -> ParsedDate {
    if text.length == 0 { return ParsedDate.{ .seconds = 0, .nanoseconds = 0, .ok = false } }
    if text.pointer[0] == 64 {
        const rest = std.string.slice(text, 1, text.length)
        const parsed = std.parse.signed(rest)
        if !parsed.valid { return ParsedDate.{ .seconds = 0, .nanoseconds = 0, .ok = false } }
        return ParsedDate.{ .seconds = parsed.value, .nanoseconds = 0, .ok = true }
    }
    if common.equals(text, "now") || common.equals(text, "today") {
        const now = std.time.realtime()
        return ParsedDate.{ .seconds = now.seconds, .nanoseconds = now.nanoseconds, .ok = true }
    }
    if text.length < 10 { return ParsedDate.{ .seconds = 0, .nanoseconds = 0, .ok = false } }
    var i: usize = 0
    while i < 4 {
        if !isDigit(text.pointer[i]) { return ParsedDate.{ .seconds = 0, .nanoseconds = 0, .ok = false } }
        i += 1
    }
    if text.pointer[4] != 45 { return ParsedDate.{ .seconds = 0, .nanoseconds = 0, .ok = false } }
    if !isDigit(text.pointer[5]) || !isDigit(text.pointer[6]) || text.pointer[7] != 45 { return ParsedDate.{ .seconds = 0, .nanoseconds = 0, .ok = false } }
    if !isDigit(text.pointer[8]) || !isDigit(text.pointer[9]) { return ParsedDate.{ .seconds = 0, .nanoseconds = 0, .ok = false } }
    const year = @intCast(isize, parseTwoDigits(text, 0)) * 100 + @intCast(isize, parseTwoDigits(text, 2))
    const month = parseTwoDigits(text, 5)
    const day = parseTwoDigits(text, 8)
    var hour: usize = 0
    var minute: usize = 0
    var second: usize = 0
    if text.length >= 16 && (text.pointer[10] == 32 || text.pointer[10] == 84) && isDigit(text.pointer[11]) && isDigit(text.pointer[12]) && text.pointer[13] == 58 && isDigit(text.pointer[14]) && isDigit(text.pointer[15]) {
        hour = parseTwoDigits(text, 11)
        minute = parseTwoDigits(text, 14)
        if text.length >= 19 && text.pointer[16] == 58 && isDigit(text.pointer[17]) && isDigit(text.pointer[18]) {
            second = parseTwoDigits(text, 17)
        }
    }
    const naiveDays = daysFromCivil(year, month, day)
    var naiveSeconds = naiveDays * 86400 + @intCast(isize, hour) * 3600 + @intCast(isize, minute) * 60 + @intCast(isize, second)
    if useZone { naiveSeconds -= timezone.offset(zone, naiveSeconds) }
    return ParsedDate.{ .seconds = naiveSeconds, .nanoseconds = 0, .ok = true }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: date [OPTION]... [+FORMAT]\nDisplay date and time in the given FORMAT.\n  -d, --date=STRING          display time described by STRING, not 'now'\n  -I[FMT], --iso-8601[=FMT]  output date/time in ISO 8601 format\n  -R, --rfc-email             output date and time in RFC 5322 format\n      --rfc-3339=FMT          output date/time in RFC 3339 format\n  -r, --reference=FILE       display the last modification time of FILE\n  -u, --utc, --universal     print or set Coordinated Universal Time (UTC)\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx date 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("date", "invalid option")
        return 1
    }
    var zone: timezone.Context = undefined
    const useZone = !options.utc
    if useZone { zone = timezone.init(std.string.fromSlice("")) }

    var epochSeconds: isize = 0
    var nanoseconds: isize = 0
    if options.hasReference {
        var status: std.fs.Stat = undefined
        if std.fs.status(options.referencePath.pointer, &status) != 0 {
            common.writeFileError("date", options.referencePath)
            return 1
        }
        epochSeconds = status.modifiedSeconds
        nanoseconds = status.modifiedNanoseconds
    } else if options.hasDate {
        const parsed = parseDateString(options.dateString, zone, useZone)
        if !parsed.ok {
            common.writeMessage("date", "invalid date")
            return 1
        }
        epochSeconds = parsed.seconds
        nanoseconds = parsed.nanoseconds
    } else {
        const now = std.time.realtime()
        if now.seconds < 0 {
            common.writeMessage("date", "cannot read the current time")
            return 1
        }
        epochSeconds = now.seconds
        nanoseconds = now.nanoseconds
    }

    const offsetSeconds = if useZone { timezone.offset(zone, epochSeconds) } else { 0 }
    const value = calendarFromSeconds(epochSeconds + offsetSeconds)
    const stdout = std.io.stdout()
    var ok = true

    if options.hasFormat {
        ok = writeCustom(stdout, options.format, value, epochSeconds, nanoseconds, zone, useZone)
    } else if options.rfcEmail {
        ok = std.io.writeAll(stdout, weekdayName(value.weekday, false)) && std.io.writeAll(stdout, ", ") &&
            number(stdout, value.day, 2, 48) && std.io.writeAll(stdout, " ") &&
            std.io.writeAll(stdout, monthName(value.month, false)) && std.io.writeAll(stdout, " ") &&
            signedYear(stdout, value.year, 4) && std.io.writeAll(stdout, " ") &&
            writeClock(stdout, value, true) && std.io.writeAll(stdout, " ") &&
            writeOffset(stdout, offsetSeconds, false)
    } else if options.iso8601 {
        ok = writeDate(stdout, value)
        if ok && options.iso8601Fmt >= 1 {
            ok = std.io.writeAll(stdout, "T") && number(stdout, value.hour, 2, 48)
        }
        if ok && options.iso8601Fmt >= 2 {
            ok = std.io.writeAll(stdout, ":") && number(stdout, value.minute, 2, 48)
        }
        if ok && options.iso8601Fmt >= 3 {
            ok = std.io.writeAll(stdout, ":") && number(stdout, value.second, 2, 48)
        }
        if ok && options.iso8601Fmt >= 4 {
            ok = std.io.writeAll(stdout, ",") && number(stdout, @bitCast(usize, nanoseconds), 9, 48)
        }
        if ok && options.iso8601Fmt >= 1 {
            ok = writeOffset(stdout, offsetSeconds, true)
        }
    } else if options.rfc3339 {
        ok = writeDate(stdout, value)
        if ok && options.rfc3339Fmt >= 3 {
            ok = std.io.writeAll(stdout, " ") && writeClock(stdout, value, true)
        }
        if ok && options.rfc3339Fmt >= 4 {
            ok = std.io.writeAll(stdout, ".") && number(stdout, @bitCast(usize, nanoseconds), 9, 48)
        }
        if ok && options.rfc3339Fmt >= 3 {
            ok = writeOffset(stdout, offsetSeconds, true)
        }
    } else {
        ok = std.io.writeAll(stdout, weekdayName(value.weekday, false)) && std.io.writeAll(stdout, " ") &&
            std.io.writeAll(stdout, monthName(value.month, false)) && std.io.writeAll(stdout, " ") &&
            number(stdout, value.day, 2, 32) && std.io.writeAll(stdout, " ") &&
            writeClock(stdout, value, true) && std.io.writeAll(stdout, " ") &&
            std.io.printString(if useZone { timezone.abbreviation(zone, epochSeconds) } else { std.string.fromSlice("UTC") }) &&
            std.io.writeAll(stdout, " ") && signedYear(stdout, value.year, 4)
    }
    if ok { ok = std.io.print("\n") }
    if useZone { timezone.deinit(zone) }
    return if ok { 0 } else { 1 }
}
