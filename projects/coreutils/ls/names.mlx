const std = @import("std")

fn outputByte(byte: u8) -> bool {
    const value = [1]u8{byte}
    return std.io.writeAll(std.io.stdout(), value[0..1])
}

fn control(byte: u8) -> bool { return byte < 32 || byte == 127 }

fn shellSafe(byte: u8) -> bool {
    if byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 { return true }
    return byte == 95 || byte == 43 || byte == 44 || byte == 45 || byte == 46 || byte == 47 || byte == 58 || byte == 61 || byte == 64 || byte == 37 || byte == 126
}

fn needsShellQuote(name: std.string.String) -> bool {
    if name.length == 0 { return true }
    var index: usize = 0
    while index < name.length {
        if !shellSafe(name.pointer[index]) { return true }
        index += 1
    }
    return false
}

pub fn quoted(name: std.string.String, style: u8) -> bool {
    if style == 2 || style == 4 || style == 6 || style == 7 { return true }
    return (style == 3 || style == 5) && needsShellQuote(name)
}

fn hasControl(name: std.string.String) -> bool {
    var index: usize = 0
    while index < name.length {
        if control(name.pointer[index]) { return true }
        index += 1
    }
    return false
}

fn escapeLength(byte: u8, escapeSpace: bool) -> usize {
    if byte == 10 || byte == 9 || byte == 13 || byte == 8 || byte == 12 || byte == 11 || byte == 7 || byte == 92 || byte == 34 || byte == 39 && !escapeSpace { return 2 }
    if byte < 32 || byte == 127 { return 4 }
    if escapeSpace && !shellSafe(byte) { return 2 }
    return 1
}

fn escapedByte(byte: u8, escapeSpace: bool, quoteSingle: bool) -> bool {
    if byte == 10 { return std.io.print("\\n") }
    if byte == 9 { return std.io.print("\\t") }
    if byte == 13 { return std.io.print("\\r") }
    if byte == 8 { return std.io.print("\\b") }
    if byte == 12 { return std.io.print("\\f") }
    if byte == 11 { return std.io.print("\\v") }
    if byte == 7 { return std.io.print("\\a") }
    if byte == 92 { return std.io.print("\\\\") }
    if byte == 34 { return std.io.print("\\\"") }
    if byte == 39 && quoteSingle { return std.io.print("\\'") }
    if byte < 32 || byte == 127 {
        if !std.io.print("\\") { return false }
        if !outputByte(@intCast(u8, 48 + byte / 64)) { return false }
        if !outputByte(@intCast(u8, 48 + byte / 8 % 8)) { return false }
        return outputByte(@intCast(u8, 48 + byte % 8))
    }
    if escapeSpace && !shellSafe(byte) { return std.io.print("\\") && outputByte(byte) }
    return outputByte(byte)
}

fn writeEscaped(name: std.string.String, escapeSpace: bool, quoted: bool) -> bool {
    if quoted && !std.io.print("\"") { return false }
    var index: usize = 0
    while index < name.length {
        if !escapedByte(name.pointer[index], escapeSpace, false) { return false }
        index += 1
    }
    return !quoted || std.io.print("\"")
}

fn writeSingleRange(name: std.string.String, start: usize, end: usize) -> bool {
    if !std.io.print("'") { return false }
    var index = start
    while index < end {
        if name.pointer[index] == 39 {
            if !std.io.print("'\\''") { return false }
        } else if !outputByte(name.pointer[index]) { return false }
        index += 1
    }
    return std.io.print("'")
}

fn writeControlRange(name: std.string.String, start: usize, end: usize) -> bool {
    if !std.io.print("$'") { return false }
    var index = start
    while index < end {
        if !escapedByte(name.pointer[index], false, true) { return false }
        index += 1
    }
    return std.io.print("'")
}

fn writeShellControls(name: std.string.String) -> bool {
    var index: usize = 0
    while index < name.length && !control(name.pointer[index]) { index += 1 }
    if !writeSingleRange(name, 0, index) { return false }
    while index < name.length {
        const controlStart = index
        while index < name.length && control(name.pointer[index]) { index += 1 }
        if !writeControlRange(name, controlStart, index) { return false }
        const textStart = index
        while index < name.length && !control(name.pointer[index]) { index += 1 }
        if index > textStart && !writeSingleRange(name, textStart, index) { return false }
    }
    return true
}

fn writeShell(name: std.string.String, always: bool, escaped: bool) -> bool {
    if !always && !needsShellQuote(name) { return std.io.printString(name) }
    if escaped && hasControl(name) { return writeShellControls(name) }
    return writeSingleRange(name, 0, name.length)
}

pub fn write(name: std.string.String, style: u8) -> bool {
    if style == 0 { return std.io.printString(name) }
    if style == 1 { return writeEscaped(name, true, false) }
    if style == 2 || style == 7 { return writeEscaped(name, false, true) }
    if style == 3 { return writeShell(name, false, false) }
    if style == 4 { return writeShell(name, true, false) }
    if style == 5 { return writeShell(name, false, true) }
    if style == 6 { return writeShell(name, true, true) }
    var index: usize = 0
    while index < name.length {
        if !outputByte(if control(name.pointer[index]) { 63 } else { name.pointer[index] }) { return false }
        index += 1
    }
    return true
}

fn escapedWidth(name: std.string.String, escapeSpace: bool, quoted: bool) -> usize {
    var result: usize = if quoted { 2 } else { 0 }
    var index: usize = 0
    while index < name.length {
        result += escapeLength(name.pointer[index], escapeSpace)
        index += 1
    }
    return result
}

fn shellWidth(name: std.string.String, always: bool, escaped: bool) -> usize {
    if !always && !needsShellQuote(name) { return name.length }
    var result: usize = 2
    var index: usize = 0
    while index < name.length {
        const byte = name.pointer[index]
        if escaped && control(byte) {
            result += 3 + escapeLength(byte, false)
            index += 1
            while index < name.length && control(name.pointer[index]) {
                result += escapeLength(name.pointer[index], false)
                index += 1
            }
            if index < name.length { result += 2 }
        } else {
            result += if byte == 39 { 4 } else { 1 }
            index += 1
        }
    }
    return result
}

pub fn width(name: std.string.String, style: u8) -> usize {
    if style == 0 || style == 8 { return name.length }
    if style == 1 { return escapedWidth(name, true, false) }
    if style == 2 || style == 7 { return escapedWidth(name, false, true) }
    if style == 3 { return shellWidth(name, false, false) }
    if style == 4 { return shellWidth(name, true, false) }
    if style == 5 { return shellWidth(name, false, true) }
    return shellWidth(name, true, true)
}
