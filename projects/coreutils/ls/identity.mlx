const std = @import("std")
const passwd = @import("std.passwd")

const CAPACITY: usize = 65536

const Database = struct {
    buffer: [*]u8
    length: usize
    valid: bool
}

pub const Context = struct {
    users: Database
    groups: Database
}

fn load(path: [*]const u8) -> Database {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const allocation = allocator.alloc(CAPACITY, 8)
    if allocation == null { return Database.{ .buffer = undefined, .length = 0, .valid = false } }
    const length = std.fs.readFileResult(path, allocation.?, CAPACITY)
    if length >= 0 { return Database.{ .buffer = allocation.?, .length = @bitCast(usize, length), .valid = true } }
    allocator.free(allocation.?, CAPACITY, 8)
    return Database.{ .buffer = undefined, .length = 0, .valid = false }
}

fn textOf(database: Database) -> []const u8 {
    const bytes: [*]const u8 = database.buffer
    return bytes[0..database.length]
}

pub fn init() -> Context {
    unsafe {
        return Context.{ .users = load(@ptrCast([*]const u8, "/etc/passwd")), .groups = load(@ptrCast([*]const u8, "/etc/group")) }
    }
}

fn unload(database: Database) -> void {
    if !database.valid { return }
    const allocator: std.allocator.Allocator = std.heap.allocator()
    allocator.free(database.buffer, CAPACITY, 8)
}

pub fn deinit(context: Context) -> void {
    unload(context.users)
    unload(context.groups)
}

pub fn user(context: Context, id: u32) -> ?std.string.String {
    var entry: passwd.User = undefined
    if !context.users.valid || !passwd.findUserById(textOf(context.users), id, &entry) { return null }
    return std.string.fromSlice(entry.name)
}

pub fn group(context: Context, id: u32) -> ?std.string.String {
    var entry: passwd.Group = undefined
    if !context.groups.valid || !passwd.findGroupById(textOf(context.groups), id, &entry) { return null }
    return std.string.fromSlice(entry.name)
}
