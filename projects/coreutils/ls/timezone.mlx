// The time zone ls, date and pr print times in: std.timezone's zone, kept
// on the page allocator (a Zone holds its transitions, too much to copy
// with each call that passes a Context).
const std = @import("std")
const timezone = @import("std.timezone")

pub const Context = struct {
    zone: *timezone.Zone
    valid: bool
}

// The zone `value` names as $TZ would ("" for /etc/localtime).
pub fn init(value: std.string.String) -> Context {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(timezone.Zone), 8)
    if memory == null { unsafe { return Context.{ .zone = @ptrFromInt(*timezone.Zone, 8), .valid = false } } }
    var zone: *timezone.Zone = undefined
    unsafe { zone = @ptrCast(*timezone.Zone, memory.?) }
    timezone.loadSetting(zone, std.string.asSlice(value), allocator)
    return Context.{ .zone = zone, .valid = true }
}

pub fn deinit(context: Context) -> void {
    if !context.valid { return }
    const allocator: std.allocator.Allocator = std.heap.allocator()
    unsafe { allocator.free(@ptrCast([*]u8, context.zone), @sizeOf(timezone.Zone), 8) }
}

// The offset from UTC (seconds) at `seconds` since 1970.
pub fn offset(context: Context, seconds: isize) -> isize {
    if !context.valid { return 0 }
    return @intCast(isize, timezone.offsetAt(context.zone, @intCast(i64, seconds)))
}

// The zone's abbreviation at `seconds` ("CEST").
pub fn abbreviation(context: Context, seconds: isize) -> std.string.String {
    if !context.valid { return std.string.fromSlice("UTC") }
    return std.string.fromSlice(timezone.abbreviationAt(context.zone, @intCast(i64, seconds)))
}
