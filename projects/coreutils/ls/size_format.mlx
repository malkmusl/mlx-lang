const std = @import("std")
const options_module = @import("./options.mlx")

const Options = options_module.Options

const Human = struct {
    whole: usize
    decimal: usize
    hasDecimal: bool
    unit: usize
}

fn digits(value: usize) -> usize {
    var result: usize = 1
    var remaining = value
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn human(value: usize, base: usize) -> Human {
    if value < base { return Human.{ .whole = value, .decimal = 0, .hasDecimal = false, .unit = 0 } }
    var unit: usize = 1
    var divisor = base
    while unit < 6 && value / divisor >= base {
        if divisor > 18446744073709551615 / base { break }
        divisor *= base
        unit += 1
    }
    const tenths = if value > (18446744073709551615 - divisor + 1) / 10 { value / divisor * 10 } else { (value * 10 + divisor - 1) / divisor }
    if tenths < 100 { return Human.{ .whole = tenths / 10, .decimal = tenths % 10, .hasDecimal = true, .unit = unit } }
    return Human.{ .whole = (value + divisor - 1) / divisor, .decimal = 0, .hasDecimal = false, .unit = unit }
}

fn suffix(unit: usize, decimal: bool) -> u8 {
    if unit == 1 { return if decimal { 107 } else { 75 } }
    if unit == 2 { return 77 }
    if unit == 3 { return 71 }
    if unit == 4 { return 84 }
    if unit == 5 { return 80 }
    return 69
}

fn humanWidth(value: usize, options: Options) -> usize {
    const shown = human(value, if options.human == 2 { 1000 } else { 1024 })
    if shown.unit == 0 { return digits(shown.whole) }
    return digits(shown.whole) + if shown.hasDecimal { 3 } else { 1 }
}

fn scaled(value: usize, options: Options) -> usize {
    if !options.scaleSize { return value }
    const unit = if options.blockSize == 0 { 1 } else { options.blockSize }
    return (value + unit - 1) / unit
}

pub fn width(value: usize, options: Options) -> usize {
    if options.human != 0 { return humanWidth(value, options) }
    return digits(scaled(value, options)) + if options.scaleSize { @intCast(usize, options.blockSuffix) } else { 0 }
}

fn writeByte(byte: u8) -> bool {
    const value = [1]u8{byte}
    return std.io.writeAll(std.io.stdout(), value[0..1])
}

fn blockUnit(unit: u8, decimal: bool) -> u8 {
    if unit == 1 { return if decimal { 107 } else { 75 } }
    if unit == 2 { return 77 }
    if unit == 3 { return 71 }
    if unit == 4 { return 84 }
    if unit == 5 { return 80 }
    return 69
}

fn writeBlockSuffix(options: Options) -> bool {
    if options.blockSuffix == 0 { return true }
    if !writeByte(blockUnit(options.blockUnit, options.blockSuffix == 2)) { return false }
    if options.blockSuffix == 2 { return std.io.print("B") }
    return options.blockSuffix != 3 || std.io.print("iB")
}

pub fn write(value: usize, options: Options) -> bool {
    if options.human == 0 {
        if !std.io.writeUnsigned(std.io.stdout(), scaled(value, options)) { return false }
        return writeBlockSuffix(options)
    }
    const shown = human(value, if options.human == 2 { 1000 } else { 1024 })
    if !std.io.writeUnsigned(std.io.stdout(), shown.whole) { return false }
    if shown.hasDecimal && (!std.io.print(".") || !std.io.writeUnsigned(std.io.stdout(), shown.decimal)) { return false }
    return shown.unit == 0 || writeByte(suffix(shown.unit, options.human == 2))
}

pub fn writeTotal(value: usize, options: Options) -> bool {
    if options.human != 0 || options.scaleSize { return write(value, options) }
    return std.io.writeUnsigned(std.io.stdout(), (value + 1023) / 1024)
}

pub fn totalWidth(value: usize, options: Options) -> usize {
    if options.human != 0 || options.scaleSize { return width(value, options) }
    return digits((value + 1023) / 1024)
}

pub fn major(device: usize) -> usize {
    return (device & 1048320) >> 8 | (device & 18446726481523507200) >> 32
}

pub fn minor(device: usize) -> usize {
    return device & 255 | (device & 17592184995840) >> 12
}
