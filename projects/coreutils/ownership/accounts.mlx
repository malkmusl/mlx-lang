const std = @import("std")
const passwd = @import("std.passwd")

const CAPACITY: usize = 65536

const Database = struct {
    buffer: [*]u8
    length: usize
    valid: bool
}

pub const User = struct {
    id: u32
    group: u32
    valid: bool
    groupValid: bool
}

pub const Group = struct {
    id: u32
    valid: bool
}

pub const Spec = struct {
    user: u32
    group: u32
    userSet: bool
    groupSet: bool
    valid: bool
}

fn load(path: [*]const u8) -> Database {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const allocation = allocator.alloc(CAPACITY, 8)
    if allocation == null { return Database.{ .buffer = undefined, .length = 0, .valid = false } }
    const buffer = allocation.?
    const length = std.fs.readFileResult(path, buffer, CAPACITY - 1)
    if length < 0 {
        allocator.free(buffer, CAPACITY, 8)
        return Database.{ .buffer = undefined, .length = 0, .valid = false }
    }
    buffer[@bitCast(usize, length)] = 0
    return Database.{ .buffer = buffer, .length = @bitCast(usize, length), .valid = true }
}

fn textOf(database: Database) -> []const u8 {
    const bytes: [*]const u8 = database.buffer
    return bytes[0..database.length]
}

fn unload(database: Database) -> void {
    if !database.valid { return }
    const allocator: std.allocator.Allocator = std.heap.allocator()
    allocator.free(database.buffer, CAPACITY, 8)
}

const NumberResult = struct {
    value: u32
    valid: bool
}

fn invalidNumber() -> NumberResult { return NumberResult.{ .value = 0, .valid = false } }

fn parseNumber(value: std.string.String) -> NumberResult {
    if value.length == 0 { return invalidNumber() }
    var index: usize = if value.pointer[0] == 43 { 1 } else { 0 }
    if index == value.length { return invalidNumber() }
    var result: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        if byte < 48 || byte > 57 { return invalidNumber() }
        result = result * 10 + @intCast(usize, byte - 48)
        if result >= 4294967295 { return invalidNumber() }
        index += 1
    }
    return NumberResult.{ .value = @intCast(u32, result), .valid = true }
}

fn findUser(requested: std.string.String, by_id: bool, requested_id: u32) -> User {
    const database = load("/etc/passwd".pointer)
    if !database.valid { return User.{ .id = 0, .group = 0, .valid = false, .groupValid = false } }
    var entry: passwd.User = undefined
    const found = if by_id { passwd.findUserById(textOf(database), requested_id, &entry) } else { passwd.findUserNamed(textOf(database), std.string.asSlice(requested), &entry) }
    unload(database)
    if !found { return User.{ .id = 0, .group = 0, .valid = false, .groupValid = false } }
    return User.{ .id = entry.id, .group = entry.group, .valid = true, .groupValid = true }
}

pub fn resolveUser(value: std.string.String) -> User {
    const numeric = parseNumber(value)
    if !numeric.valid { return findUser(value, false, 0) }
    const found = findUser(value, true, numeric.value)
    if found.valid { return found }
    return User.{ .id = numeric.value, .group = 0, .valid = true, .groupValid = false }
}

pub fn resolveGroup(value: std.string.String) -> Group {
    const numeric = parseNumber(value)
    if numeric.valid { return Group.{ .id = numeric.value, .valid = true } }
    const database = load("/etc/group".pointer)
    if !database.valid { return Group.{ .id = 0, .valid = false } }
    var entry: passwd.Group = undefined
    const found = passwd.findGroupNamed(textOf(database), std.string.asSlice(value), &entry)
    unload(database)
    if !found { return Group.{ .id = 0, .valid = false } }
    return Group.{ .id = entry.id, .valid = true }
}

pub fn writeUserName(id: u32, file: std.fs.File) -> bool {
    const database = load("/etc/passwd".pointer)
    var entry: passwd.User = undefined
    var written = false
    if database.valid && passwd.findUserById(textOf(database), id, &entry) {
        written = std.io.writeAll(file, entry.name)
    } else {
        written = std.io.writeUnsigned(file, @intCast(usize, id))
    }
    unload(database)
    return written
}

pub fn writeGroupName(id: u32, file: std.fs.File) -> bool {
    const database = load("/etc/group".pointer)
    var entry: passwd.Group = undefined
    var written = false
    if database.valid && passwd.findGroupById(textOf(database), id, &entry) {
        written = std.io.writeAll(file, entry.name)
    } else {
        written = std.io.writeUnsigned(file, @intCast(usize, id))
    }
    unload(database)
    return written
}

fn separator(value: std.string.String) -> usize {
    var index: usize = 0
    while index < value.length {
        if value.pointer[index] == 58 { return index }
        index += 1
    }
    index = 0
    while index < value.length {
        if value.pointer[index] == 46 { return index }
        index += 1
    }
    return value.length
}

pub fn parseSpec(value: std.string.String, group_only: bool) -> Spec {
    var result = Spec.{ .user = 0, .group = 0, .userSet = false, .groupSet = false, .valid = true }
    if group_only {
        const group = resolveGroup(value)
        result.group = group.id
        result.groupSet = group.valid
        result.valid = group.valid
        return result
    }
    var has_colon = false
    var scan: usize = 0
    while scan < value.length {
        if value.pointer[scan] == 58 { has_colon = true }
        scan += 1
    }
    if !has_colon {
        const whole_user = resolveUser(value)
        if whole_user.valid {
            result.user = whole_user.id
            result.userSet = true
            return result
        }
    }
    const split = separator(value)
    const owner_text = std.string.slice(value, 0, split)
    const group_text = if split < value.length { std.string.slice(value, split + 1, value.length) } else { std.string.fromSlice("") }
    var user = User.{ .id = 0, .group = 0, .valid = false, .groupValid = false }
    if owner_text.length > 0 {
        user = resolveUser(owner_text)
        result.user = user.id
        result.userSet = user.valid
        result.valid = user.valid
    }
    if split < value.length && group_text.length > 0 {
        const group = resolveGroup(group_text)
        result.group = group.id
        result.groupSet = group.valid
        result.valid = result.valid && group.valid
    } else if split < value.length && owner_text.length > 0 {
        result.group = user.group
        result.groupSet = user.groupValid
        result.valid = result.valid && user.groupValid
    }
    return result
}
