// Embedded bitmaps, as FreeType's SFNT driver reads them (its ttsbit.c
// and pngshim.c, with the strikes of sfobjs.c and FT_Match_Size): the
// strikes of `EBLC`/`EBDT` (or Apple's `bloc`/`bdat`), `CBLC`/`CBDT` and
// `sbix`, their metrics, and the glyphs' bitmaps: byte- and bit-aligned
// images, compound ones, and PNG images (std.png decodes them into the
// premultiplied BGRA FreeType makes).
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const sfnt = @import("./sfnt.mlx")
const bitmap = @import("./bitmap.mlx")
const png = @import("std.png")

pub const KIND_NONE: i64 = 0
pub const KIND_EBLC: i64 = 1
pub const KIND_CBLC: i64 = 2
pub const KIND_SBIX: i64 = 3

// Where the bitmap of FT_GlyphSlotRec is.
const SLOT_BITMAP: usize = 152

// TT_SBit_MetricsRec.
const Metrics = struct {
    width: i64
    height: i64
    horiBearingX: i64
    horiBearingY: i64
    horiAdvance: i64
    vertBearingX: i64
    vertBearingY: i64
    vertAdvance: i64
}

// FT_Size_Metrics of a strike.
const StrikeMetrics = struct {
    x_ppem: i64
    y_ppem: i64
    x_scale: i64
    y_scale: i64
    ascender: i64
    descender: i64
    height: i64
    max_advance: i64
}

fn u8at(f: *o.Face, p: u64) -> i64 { return o.byteAt(f, p) }
fn s8at(f: *o.Face, p: u64) -> i64 {
    const b = o.byteAt(f, p)
    return if b >= 128 { b - 256 } else { b }
}

// ---------------------------------------------------------------------------
// The tables (FreeType's tt_face_load_sbit).

pub fn load(face: usize) -> void {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    f.*.sbitKind = KIND_NONE
    f.*.sbitStrikes = 0
    f.*.sbitTableSize = 0
    var t = o.table(f, o.TAG_CBLC)
    if t.1 != 0 {
        f.*.sbitKind = KIND_CBLC
    } else {
        t = o.table(f, o.TAG_EBLC)
        if t.1 == 0 { t = o.table(f, o.TAG_bloc) }
        if t.1 != 0 { f.*.sbitKind = KIND_EBLC }
    }
    if t.1 == 0 {
        t = o.table(f, o.TAG_sbix)
        if t.1 != 0 { f.*.sbitKind = KIND_SBIX }
    }
    if t.1 == 0 { return }
    const tableSize = t.1
    var failed = tableSize < 8 || t.0 > f.*.size
    if !failed && (f.*.sbitKind == KIND_EBLC || f.*.sbitKind == KIND_CBLC) {
        if !o.within(f, t.0, tableSize) {
            failed = true
        } else {
            f.*.sbitTableOffset = t.0
            f.*.sbitTableSize = tableSize
            const version = @intCast(u64, o.u32At(f, t.0))
            const numStrikes = @intCast(u64, o.u32At(f, t.0 + 4))
            if (version & 0xFFFF0000) != 0x00020000 && (version & 0xFFFF) != 0x0200 && (version & 0xFFFF0000) != 0x00030000 && (version & 0xFFFF) != 0x0300 {
                failed = true
            } else if numStrikes >= 0x10000 {
                failed = true
            } else {
                var count = numStrikes
                if 8 + 48 * count > tableSize { count = (tableSize - 8) / 48 }
                f.*.sbitStrikes = @intCast(i64, count)
            }
        }
    } else if !failed {
        if !o.within(f, t.0, 8) {
            failed = true
        } else {
            const version = o.u16At(f, t.0)
            const flags = o.u16At(f, t.0 + 2)
            const numStrikes = @intCast(u64, o.u32At(f, t.0 + 4))
            if version < 1 || !(flags == 1 || flags == 3) || numStrikes >= 0x10000 {
                failed = true
            } else {
                if flags == 3 { root.*.face_flags |= r.FACE_SBIX_OVERLAY }
                var count = numStrikes
                if 8 + 4 * count > tableSize { count = (tableSize - 8) / 4 }
                if !o.within(f, t.0, 8 + count * 4) {
                    failed = true
                } else {
                    f.*.sbitTableOffset = t.0
                    f.*.sbitTableSize = 8 + count * 4
                    f.*.sbitStrikes = @intCast(i64, count)
                }
            }
        }
    }
    if failed {
        f.*.sbitTableSize = 0
        f.*.sbitKind = KIND_NONE
        f.*.sbitStrikes = 0
        return
    }
    f.*.sbitDataOffset = 0
    f.*.sbitDataSize = 0
    if f.*.sbitKind == KIND_SBIX {
        f.*.sbitDataOffset = t.0
        f.*.sbitDataSize = tableSize
    } else {
        var d = o.table(f, o.TAG_CBDT)
        if d.1 == 0 { d = o.table(f, o.TAG_EBDT) }
        if d.1 == 0 { d = o.table(f, o.TAG_bdat) }
        if d.1 != 0 && d.0 <= f.*.size {
            f.*.sbitDataOffset = d.0
            f.*.sbitDataSize = d.1
        }
    }
    if f.*.sbitDataSize == 0 { f.*.sbitStrikes = 0 }
}

pub fn done(face: usize) -> void {
    const f = o.faceRecord(face)
    f.*.sbitTableSize = 0
    f.*.sbitKind = KIND_NONE
    f.*.sbitStrikes = 0
}

// ---------------------------------------------------------------------------
// Strikes (FreeType's tt_face_load_strike_metrics and the available sizes
// of sfnt_load_face).

// The metrics of strike `index` (a table's own index).
fn strikeMetricsOf(f: *o.Face, index: u64, sm: *StrikeMetrics) -> i32 {
    const upem = sfnt.unitsPerEM(f)
    if f.*.sbitKind == KIND_EBLC || f.*.sbitKind == KIND_CBLC {
        const strike = f.*.sbitTableOffset + 8 + index * 48
        sm.*.x_ppem = u8at(f, strike + 44)
        sm.*.y_ppem = u8at(f, strike + 45)
        sm.*.ascender = s8at(f, strike + 16) * 64
        sm.*.descender = s8at(f, strike + 17) * 64
        const maxBeforeBl = s8at(f, strike + 24)
        const minAfterBl = s8at(f, strike + 25)
        if sm.*.descender > 0 {
            if minAfterBl < 0 { sm.*.descender = 0 - sm.*.descender }
        } else if sm.*.descender == 0 {
            if sm.*.ascender == 0 {
                if maxBeforeBl != 0 || minAfterBl != 0 {
                    sm.*.ascender = maxBeforeBl * 64
                    sm.*.descender = minAfterBl * 64
                } else {
                    sm.*.ascender = sm.*.y_ppem * 64
                    sm.*.descender = 0
                }
            }
        }
        sm.*.height = sm.*.ascender - sm.*.descender
        if sm.*.height == 0 {
            sm.*.height = sm.*.y_ppem * 64
            sm.*.descender = sm.*.ascender - sm.*.height
        }
        sm.*.max_advance = (s8at(f, strike + 22) + u8at(f, strike + 18) + s8at(f, strike + 23)) * 64
        sm.*.x_scale = calc.divFix(sm.*.x_ppem * 64, upem)
        sm.*.y_scale = calc.divFix(sm.*.y_ppem * 64, upem)
        return r.OK
    }
    if f.*.sbitKind == KIND_SBIX {
        const offset = @intCast(u64, o.u32At(f, f.*.sbitTableOffset + 8 + 4 * index))
        if offset + 4 > f.*.sbitDataSize { return r.ERR_INVALID_FILE_FORMAT }
        if f.*.sbitDataOffset + offset > f.*.size || !o.within(f, f.*.sbitDataOffset + offset, 4) { return r.ERR_INVALID_STREAM_OPERATION }
        const ppem = o.u16At(f, f.*.sbitDataOffset + offset)
        sm.*.x_ppem = ppem
        sm.*.y_ppem = ppem
        const scale = calc.divFix(ppem * 64, upem)
        sm.*.ascender = calc.mulFix(sfnt.ascender(f), scale)
        sm.*.descender = calc.mulFix(sfnt.descender(f), scale)
        sm.*.height = calc.mulFix(sfnt.ascender(f) - sfnt.descender(f) + sfnt.lineGap(f), scale)
        sm.*.max_advance = calc.mulFix(@intCast(i64, m.get16(f.*.hhea + 14)), scale)
        sm.*.x_scale = scale
        sm.*.y_scale = scale
        return r.OK
    }
    return r.ERR_UNKNOWN_FILE_FORMAT
}

// The face's available sizes and its map of them to the strikes.
pub fn setStrikes(face: usize) -> void {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    const count = f.*.sbitStrikes
    if count <= 0 { return }
    const memory = f.*.memory
    var emSize = sfnt.unitsPerEM(f)
    var avgWidth = sfnt.xAvgCharWidth(f)
    if emSize == 0 || !sfnt.os2Present(f) {
        avgWidth = 1
        emSize = 1
    }
    root.*.available_sizes = m.alloc(memory, @intCast(usize, count) * 32)
    const map = m.alloc(memory, @intCast(usize, count) * 4)
    if root.*.available_sizes == 0 || map == 0 {
        m.release(memory, map)
        return
    }
    var sm = StrikeMetrics.{ .x_ppem = 0, .y_ppem = 0, .x_scale = 0, .y_scale = 0, .ascender = 0, .descender = 0, .height = 0, .max_advance = 0 }
    var used: i64 = 0
    var i: i64 = 0
    while i < count {
        const bsize = root.*.available_sizes + @intCast(usize, used) * 32
        const err = strikeMetricsOf(f, @intCast(u64, i), &sm)
        i += 1
        if err != r.OK { continue }
        m.putI16(bsize, @intCast(i16, calc.low16(sm.height >> 6)))
        m.putI16(bsize + 2, @intCast(i16, calc.low16((avgWidth * sm.x_ppem + emSize / 2) / emSize)))
        m.putI64(bsize + 16, sm.x_ppem << 6)
        m.putI64(bsize + 24, sm.y_ppem << 6)
        m.putI64(bsize + 8, sm.y_ppem << 6)
        if sm.x_ppem != 0 && sm.y_ppem != 0 {
            m.put32(map + @intCast(usize, used) * 4, @intCast(u32, i - 1))
            used += 1
        }
    }
    if used != 0 {
        f.*.sbitStrikeMap = map
        root.*.face_flags |= r.FACE_FIXED_SIZES
        root.*.num_fixed_sizes = @intCast(i32, used)
    } else {
        m.release(memory, map)
    }
}

fn mappedStrike(f: *o.Face, strike: i64) -> i64 {
    if f.*.sbitStrikeMap == 0 { return strike }
    return @intCast(i64, m.get32(f.*.sbitStrikeMap + @intCast(usize, strike) * 4))
}

// The size's metrics from strike `strike` of the available sizes
// (FreeType's tt_face_load_strike_metrics).
pub fn strikeMetrics(face: usize, size: usize, strike: i64) -> i32 {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    var index = strike
    if f.*.sbitStrikeMap != 0 {
        if strike < 0 || strike >= @intCast(i64, root.*.num_fixed_sizes) { return r.ERR_INVALID_ARGUMENT }
        index = mappedStrike(f, strike)
    } else if strike < 0 || strike >= f.*.sbitStrikes {
        return r.ERR_INVALID_ARGUMENT
    }
    var sm = StrikeMetrics.{ .x_ppem = 0, .y_ppem = 0, .x_scale = 0, .y_scale = 0, .ascender = 0, .descender = 0, .height = 0, .max_advance = 0 }
    const err = strikeMetricsOf(f, @intCast(u64, index), &sm)
    if err != r.OK { return err }
    const s = r.sizeRec(size)
    s.*.x_ppem = @intCast(u16, calc.ulow16(sm.x_ppem))
    s.*.y_ppem = @intCast(u16, calc.ulow16(sm.y_ppem))
    s.*.x_scale = sm.x_scale
    s.*.y_scale = sm.y_scale
    s.*.ascender = sm.ascender
    s.*.descender = sm.descender
    s.*.height = sm.height
    s.*.max_advance = sm.max_advance
    return r.OK
}

// The available size a size request matches (FreeType's FT_Match_Size,
// widths not ignored): its error and the size's index.
pub fn matchStrike(face: usize, req: usize) -> (i32, i64) {
    const root = r.faceRec(face)
    if (root.*.face_flags & r.FACE_FIXED_SIZES) == 0 { return -> (r.ERR_INVALID_FACE_HANDLE, -1) }
    if m.getI32(req) != 0 { return -> (r.ERR_UNIMPLEMENTED_FEATURE, -1) }
    const width = m.getI64(req + 8)
    const height = m.getI64(req + 16)
    const horiRes = @intCast(i64, m.get32(req + 24))
    const vertRes = @intCast(i64, m.get32(req + 28))
    var w = if horiRes != 0 { (width * horiRes + 36) / 72 } else { width }
    var h = if vertRes != 0 { (height * vertRes + 36) / 72 } else { height }
    if width != 0 && height == 0 {
        h = w
    } else if width == 0 && height != 0 {
        w = h
    }
    w = calc.pixRound(w)
    h = calc.pixRound(h)
    if w == 0 || h == 0 { return -> (r.ERR_INVALID_PIXEL_SIZE, -1) }
    var i: i64 = 0
    while i < @intCast(i64, root.*.num_fixed_sizes) {
        const bsize = root.*.available_sizes + @intCast(usize, i) * 32
        if h == calc.pixRound(m.getI64(bsize + 24)) && w == calc.pixRound(m.getI64(bsize + 16)) { return -> (r.OK, i) }
        i += 1
    }
    return -> (r.ERR_INVALID_PIXEL_SIZE, -1)
}

// ---------------------------------------------------------------------------
// The bitmap decoder of `EBDT` and `CBDT` (FreeType's TT_SBitDecoder).

const Decoder = struct {
    f: *o.Face
    slot: usize
    metrics: *Metrics
    metricsLoaded: bool
    bitmapAllocated: bool
    bitDepth: i64
    dataStart: u64
    dataSize: u64
    indexArray: u64
    indexCount: u64
    // The `EBLC` table: its offset and end in the font.
    eblcBase: u64
    eblcLimit: u64
}

fn decoderInit(d: *Decoder, f: *o.Face, slot: usize, strike: i64, metrics: *Metrics) -> i32 {
    const index = @intCast(u64, mappedStrike(f, strike))
    if f.*.sbitDataSize == 0 { return r.ERR_TABLE_MISSING }
    if f.*.sbitDataOffset > f.*.size { return r.ERR_INVALID_STREAM_OPERATION }
    d.*.f = f
    d.*.slot = slot
    d.*.metrics = metrics
    d.*.metricsLoaded = false
    d.*.bitmapAllocated = false
    d.*.dataStart = f.*.sbitDataOffset
    d.*.dataSize = f.*.sbitDataSize
    d.*.eblcBase = f.*.sbitTableOffset
    d.*.eblcLimit = f.*.sbitTableOffset + f.*.sbitTableSize
    if 8 + 48 * index + 3 * 4 + 34 + 1 > f.*.sbitTableSize { return r.ERR_INVALID_FILE_FORMAT }
    const p = d.*.eblcBase + 8 + 48 * index
    d.*.indexArray = @intCast(u64, o.u32At(f, p))
    d.*.indexCount = @intCast(u64, o.u32At(f, p + 8))
    d.*.bitDepth = u8at(f, p + 46)
    if d.*.indexArray > f.*.sbitTableSize || d.*.indexCount > (f.*.sbitTableSize - d.*.indexArray) / 8 { return r.ERR_INVALID_FILE_FORMAT }
    return r.OK
}

fn slotBitmap(d: *Decoder) -> *r.SlotRec { return r.slotRec(d.*.slot) }

// The slot's bitmap of the glyph's size and depth (FreeType's
// tt_sbit_decoder_alloc_bitmap).
fn allocBitmap(d: *Decoder, metricsOnly: bool) -> i32 {
    if !d.*.metricsLoaded { return r.ERR_INVALID_ARGUMENT }
    const s = slotBitmap(d)
    const width = d.*.metrics.*.width
    const height = d.*.metrics.*.height
    s.*.bitmap_width = @intCast(u32, width)
    s.*.bitmap_rows = @intCast(u32, height)
    if d.*.bitDepth == 1 {
        s.*.bitmap_pixel_mode = r.PIXEL_MONO
        s.*.bitmap_pitch = @intCast(i32, (width + 7) >> 3)
        s.*.bitmap_num_grays = 2
    } else if d.*.bitDepth == 2 {
        s.*.bitmap_pixel_mode = r.PIXEL_GRAY2
        s.*.bitmap_pitch = @intCast(i32, (width + 3) >> 2)
        s.*.bitmap_num_grays = 4
    } else if d.*.bitDepth == 4 {
        s.*.bitmap_pixel_mode = r.PIXEL_GRAY4
        s.*.bitmap_pitch = @intCast(i32, (width + 1) >> 1)
        s.*.bitmap_num_grays = 16
    } else if d.*.bitDepth == 8 {
        s.*.bitmap_pixel_mode = r.PIXEL_GRAY
        s.*.bitmap_pitch = @intCast(i32, width)
        s.*.bitmap_num_grays = 256
    } else if d.*.bitDepth == 32 {
        s.*.bitmap_pixel_mode = r.PIXEL_BGRA
        s.*.bitmap_pitch = @intCast(i32, width * 4)
        s.*.bitmap_num_grays = 256
    } else {
        return r.ERR_INVALID_FILE_FORMAT
    }
    const size = @intCast(u64, height) * @intCast(u64, s.*.bitmap_pitch)
    if size == 0 || metricsOnly { return r.OK }
    const err = allocSlotBitmap(d.*.slot, size)
    if err != r.OK { return err }
    d.*.bitmapAllocated = true
    return r.OK
}

// FreeType's ft_glyphslot_alloc_bitmap: zeroed bytes the slot owns.
fn allocSlotBitmap(slot: usize, size: u64) -> i32 {
    const s = r.slotRec(slot)
    const internal = o.slotRecord(slot)
    const memory = r.faceRec(s.*.face).*.memory
    if internal.*.ownBitmap { m.release(memory, s.*.bitmap_buffer) }
    internal.*.ownBitmap = true
    s.*.bitmap_buffer = m.alloc(memory, @intCast(usize, size))
    if s.*.bitmap_buffer == 0 { return r.ERR_OUT_OF_MEMORY }
    return r.OK
}

fn loadMetrics(d: *Decoder, at: u64, limit: u64, big: bool) -> (i32, u64) {
    const f = d.*.f
    var p = at
    if p + 5 > limit { return -> (r.ERR_INVALID_ARGUMENT, at) }
    const mt = d.*.metrics
    mt.*.height = u8at(f, p)
    mt.*.width = u8at(f, p + 1)
    mt.*.horiBearingX = s8at(f, p + 2)
    mt.*.horiBearingY = s8at(f, p + 3)
    mt.*.horiAdvance = u8at(f, p + 4)
    p += 5
    if big {
        if p + 3 > limit { return -> (r.ERR_INVALID_ARGUMENT, at) }
        mt.*.vertBearingX = s8at(f, p)
        mt.*.vertBearingY = s8at(f, p + 1)
        mt.*.vertAdvance = u8at(f, p + 2)
        p += 3
    } else {
        mt.*.vertBearingX = 0
        mt.*.vertBearingY = 0
        mt.*.vertAdvance = 0
    }
    d.*.metricsLoaded = true
    return -> (r.OK, p)
}

fn orByte(at: usize, value: u64) -> void { m.put8(at, @intCast(u8, (@intCast(u64, m.get8(at)) | value) & 0xFF)) }

// FreeType's tt_sbit_decoder_load_byte_aligned.
fn loadByteAligned(d: *Decoder, start: u64, limit: u64, xPos_: i64, yPos: i64) -> i32 {
    const f = d.*.f
    const s = slotBitmap(d)
    var xPos = xPos_
    const bitWidth = @intCast(i64, s.*.bitmap_width)
    const bitHeight = @intCast(i64, s.*.bitmap_rows)
    const pitch = @intCast(i64, s.*.bitmap_pitch)
    var line = s.*.bitmap_buffer
    if line == 0 { return r.OK }
    const width = d.*.metrics.*.width
    const height = d.*.metrics.*.height
    const lineBits = width * d.*.bitDepth
    if xPos < 0 || xPos + width > bitWidth || yPos < 0 || yPos + height > bitHeight { return r.ERR_INVALID_FILE_FORMAT }
    if start + @intCast(u64, ((lineBits + 7) >> 3) * height) > limit { return r.ERR_INVALID_FILE_FORMAT }
    var p = start
    line = line + @intCast(usize, yPos * pitch + (xPos >> 3))
    xPos &= 7
    var h = height
    while h > 0 {
        var write = line
        var w = lineBits
        if xPos == 0 {
            while w >= 8 {
                orByte(write, @intCast(u64, u8at(f, p)))
                p += 1
                write += 1
                w -= 8
            }
            if w > 0 {
                orByte(write, @intCast(u64, u8at(f, p)) & (@intCast(u64, 0xFF00) >> @intCast(u6, w)))
                p += 1
            }
        } else {
            var wval: u64 = 0
            while w >= 8 {
                wval = wval | @intCast(u64, u8at(f, p))
                p += 1
                orByte(write, wval >> @intCast(u6, xPos))
                write += 1
                wval = (wval << 8) & 0xFFFFFFFF
                w -= 8
            }
            if w > 0 {
                wval = wval | (@intCast(u64, u8at(f, p)) & (@intCast(u64, 0xFF00) >> @intCast(u6, w)))
                p += 1
            }
            orByte(write, wval >> @intCast(u6, xPos))
            if xPos + w > 8 {
                write += 1
                wval = (wval << 8) & 0xFFFFFFFF
                orByte(write, wval >> @intCast(u6, xPos))
            }
        }
        line += @intCast(usize, pitch)
        h -= 1
    }
    return r.OK
}

// FreeType's tt_sbit_decoder_load_bit_aligned.
fn loadBitAligned(d: *Decoder, start: u64, limit: u64, xPos_: i64, yPos: i64) -> i32 {
    const f = d.*.f
    const s = slotBitmap(d)
    var xPos = xPos_
    const bitWidth = @intCast(i64, s.*.bitmap_width)
    const bitHeight = @intCast(i64, s.*.bitmap_rows)
    const pitch = @intCast(i64, s.*.bitmap_pitch)
    var line = s.*.bitmap_buffer
    const width = d.*.metrics.*.width
    const height = d.*.metrics.*.height
    const lineBits = width * d.*.bitDepth
    if xPos < 0 || xPos + width > bitWidth || yPos < 0 || yPos + height > bitHeight { return r.ERR_INVALID_FILE_FORMAT }
    if start + @intCast(u64, (lineBits * height + 7) >> 3) > limit { return r.ERR_INVALID_FILE_FORMAT }
    if lineBits == 0 || height == 0 { return r.OK }
    var p = start
    line = line + @intCast(usize, yPos * pitch + (xPos >> 3))
    xPos &= 7
    // (rval is FreeType's FT_UShort.)
    var rval: u64 = 0
    var nbits: i64 = 0
    var h = height
    while h > 0 {
        var write = line
        var w = lineBits
        if xPos != 0 {
            w = if lineBits < 8 - xPos { lineBits } else { 8 - xPos }
            if h == height {
                rval = @intCast(u64, u8at(f, p))
                p += 1
                nbits = xPos
            } else if nbits < w {
                if p < limit {
                    rval = (rval | @intCast(u64, u8at(f, p))) & 0xFFFF
                    p += 1
                }
                nbits += 8 - w
            } else {
                rval = rval >> 8
                nbits -= w
            }
            const mask = ((~(@intCast(u64, 0xFFFFFFFF) << @intCast(u6, w))) & 0xFFFFFFFF) << @intCast(u6, 8 - w - xPos)
            orByte(write, ((rval >> @intCast(u6, nbits)) & 0xFF) & mask)
            write += 1
            rval = (rval << 8) & 0xFFFF
            w = lineBits - w
        }
        while w >= 8 {
            rval = (rval | @intCast(u64, u8at(f, p))) & 0xFFFF
            p += 1
            orByte(write, (rval >> @intCast(u6, nbits)) & 0xFF)
            write += 1
            rval = (rval << 8) & 0xFFFF
            w -= 8
        }
        if w > 0 {
            if nbits < w {
                if p < limit {
                    rval = (rval | @intCast(u64, u8at(f, p))) & 0xFFFF
                    p += 1
                }
                orByte(write, ((rval >> @intCast(u6, nbits)) & 0xFF) & (@intCast(u64, 0xFF00) >> @intCast(u6, w)))
                nbits += 8 - w
                rval = (rval << 8) & 0xFFFF
            } else {
                orByte(write, ((rval >> @intCast(u6, nbits)) & 0xFF) & (@intCast(u64, 0xFF00) >> @intCast(u6, w)))
                nbits -= w
            }
        }
        line += @intCast(usize, pitch)
        h -= 1
    }
    return r.OK
}

// FreeType's tt_sbit_decoder_load_compound.
fn loadCompound(d: *Decoder, start: u64, limit: u64, xPos: i64, yPos: i64, recurse: i64) -> i32 {
    const f = d.*.f
    const mt = d.*.metrics
    const horiBearingX = calc.low16(mt.*.horiBearingX) & 0xFF
    const horiBearingY = calc.low16(mt.*.horiBearingY) & 0xFF
    const horiAdvance = mt.*.horiAdvance & 0xFF
    const vertBearingX = calc.low16(mt.*.vertBearingX) & 0xFF
    const vertBearingY = calc.low16(mt.*.vertBearingY) & 0xFF
    const vertAdvance = mt.*.vertAdvance & 0xFF
    var p = start
    if p + 2 > limit { return r.ERR_INVALID_FILE_FORMAT }
    const numComponents = @intCast(u64, o.u16At(f, p))
    p += 2
    if p + 4 * numComponents > limit { return r.ERR_INVALID_FILE_FORMAT }
    var err = r.OK
    var nn: u64 = 0
    while nn < numComponents {
        const gindex = o.u16At(f, p)
        const dx = s8at(f, p + 2)
        const dy = s8at(f, p + 3)
        p += 4
        err = loadImage(d, gindex, xPos + dx, yPos + dy, recurse + 1, false)
        if err != r.OK { break }
        nn += 1
    }
    // (FT_Char and FT_Byte copies of the metrics put back.)
    mt.*.horiBearingX = if horiBearingX >= 128 { horiBearingX - 256 } else { horiBearingX }
    mt.*.horiBearingY = if horiBearingY >= 128 { horiBearingY - 256 } else { horiBearingY }
    mt.*.horiAdvance = horiAdvance
    mt.*.vertBearingX = if vertBearingX >= 128 { vertBearingX - 256 } else { vertBearingX }
    mt.*.vertBearingY = if vertBearingY >= 128 { vertBearingY - 256 } else { vertBearingY }
    mt.*.vertAdvance = vertAdvance
    const s = slotBitmap(d)
    mt.*.width = @intCast(i64, s.*.bitmap_width) & 0xFF
    mt.*.height = @intCast(i64, s.*.bitmap_rows) & 0xFF
    return err
}

// FreeType's tt_sbit_decoder_load_png.
fn loadPngImage(d: *Decoder, start: u64, limit: u64, xPos: i64, yPos: i64) -> i32 {
    const f = d.*.f
    if limit < start + 4 { return r.ERR_INVALID_FILE_FORMAT }
    const length = @intCast(u64, o.u32At(f, start))
    if limit - (start + 4) < length { return r.ERR_INVALID_FILE_FORMAT }
    return loadPng(d.*.slot, xPos, yPos, d.*.bitDepth, d.*.metrics, f.*.data + @intCast(usize, start + 4), length, false, false)
}

fn loadBitmap(d: *Decoder, format: i64, glyphStart: u64, glyphSize: u64, xPos: i64, yPos: i64, recurse: i64, metricsOnly: bool) -> i32 {
    const f = d.*.f
    if glyphSize == 0 || glyphStart + glyphSize > d.*.dataSize { return r.ERR_INVALID_ARGUMENT }
    const at = d.*.dataStart + glyphStart
    if at > f.*.size || !o.within(f, at, glyphSize) { return r.ERR_INVALID_STREAM_OPERATION }
    var p = at
    const limit = at + glyphSize
    var err = r.OK
    if format == 1 || format == 2 || format == 8 || format == 17 {
        const res = loadMetrics(d, p, limit, false)
        err = res.0
        p = res.1
    } else if format == 6 || format == 7 || format == 9 || format == 18 {
        const res = loadMetrics(d, p, limit, true)
        err = res.0
        p = res.1
    }
    if err != r.OK { return err }
    // The loaders: 1 byte-aligned, 2 bit-aligned, 3 compound, 4 PNG.
    var loader: i64 = 0
    if format == 1 || format == 6 {
        loader = 1
    } else if format == 2 || format == 7 {
        const width = @intCast(u64, d.*.metrics.*.width)
        const height = @intCast(u64, d.*.metrics.*.height)
        const bitSize = (width * height + 7) >> 3
        const byteSize = height * ((width + 7) >> 3)
        loader = if bitSize < byteSize && byteSize == limit - p { 1 } else { 2 }
    } else if format == 5 {
        loader = 2
    } else if format == 8 || format == 9 {
        if format == 8 {
            if p + 1 > limit { return r.OK }
            p += 1
        }
        loader = 3
    } else if format == 17 || format == 18 || format == 19 {
        loader = 4
    } else {
        return r.ERR_INVALID_TABLE
    }
    if !d.*.bitmapAllocated {
        err = allocBitmap(d, metricsOnly)
        if err != r.OK { return err }
    }
    if metricsOnly { return r.OK }
    if loader == 1 { return loadByteAligned(d, p, limit, xPos, yPos) }
    if loader == 2 { return loadBitAligned(d, p, limit, xPos, yPos) }
    if loader == 3 { return loadCompound(d, p, limit, xPos, yPos, recurse) }
    return loadPngImage(d, p, limit, xPos, yPos)
}

// FreeType's tt_sbit_decoder_load_image.
fn loadImage(d: *Decoder, gindex: i64, xPos: i64, yPos: i64, recurse: i64, metricsOnly: bool) -> i32 {
    const f = d.*.f
    const glyph = @intCast(u64, gindex)
    if recurse > 100 { return r.ERR_INVALID_TABLE }
    const arrayStart = d.*.eblcBase + d.*.indexArray
    var p = arrayStart
    const limit = d.*.eblcLimit
    var ranges = d.*.indexCount
    var start: u64 = 0
    var found = false
    while ranges > 0 {
        start = @intCast(u64, o.u16At(f, p))
        const end = @intCast(u64, o.u16At(f, p + 2))
        p += 4
        if glyph >= start && glyph <= end {
            found = true
            break
        }
        p += 4
        ranges -= 1
    }
    if !found { return noBitmap(recurse) }
    var imageOffset = @intCast(u64, o.u32At(f, p))
    p = arrayStart
    if imageOffset > limit - p { return r.ERR_INVALID_TABLE }
    p += imageOffset
    if p + 8 > limit { return noBitmap(recurse) }
    const indexFormat = o.u16At(f, p)
    const imageFormat = o.u16At(f, p + 2)
    imageOffset = @intCast(u64, o.u32At(f, p + 4))
    p += 8
    var imageStart: u64 = 0
    var imageEnd: u64 = 0
    if indexFormat == 1 {
        p += 4 * (glyph - start)
        if p + 8 > limit { return noBitmap(recurse) }
        imageStart = @intCast(u64, o.u32At(f, p))
        imageEnd = @intCast(u64, o.u32At(f, p + 4))
        if imageStart == imageEnd { return noBitmap(recurse) }
    } else if indexFormat == 2 {
        if p + 12 > limit { return noBitmap(recurse) }
        const imageSize = @intCast(u64, o.u32At(f, p))
        p += 4
        if loadMetrics(d, p, limit, true).0 != r.OK { return noBitmap(recurse) }
        imageStart = imageSize * (glyph - start)
        imageEnd = imageStart + imageSize
    } else if indexFormat == 3 {
        p += 2 * (glyph - start)
        if p + 4 > limit { return noBitmap(recurse) }
        imageStart = @intCast(u64, o.u16At(f, p))
        imageEnd = @intCast(u64, o.u16At(f, p + 2))
        if imageStart == imageEnd { return noBitmap(recurse) }
    } else if indexFormat == 4 {
        if p + 4 > limit { return noBitmap(recurse) }
        const numGlyphs = @intCast(u64, o.u32At(f, p))
        p += 4
        if p + 4 > limit || numGlyphs > ((limit - p) >> 2) - 1 { return noBitmap(recurse) }
        var mm: u64 = 0
        while mm < numGlyphs {
            const gi = @intCast(u64, o.u16At(f, p))
            p += 2
            if gi == glyph {
                imageStart = @intCast(u64, o.u16At(f, p))
                p += 4
                imageEnd = @intCast(u64, o.u16At(f, p))
                break
            }
            p += 2
            mm += 1
        }
        if mm >= numGlyphs { return noBitmap(recurse) }
    } else if indexFormat == 5 || indexFormat == 19 {
        if p + 16 > limit { return noBitmap(recurse) }
        const imageSize = @intCast(u64, o.u32At(f, p))
        p += 4
        const res = loadMetrics(d, p, limit, true)
        if res.0 != r.OK { return noBitmap(recurse) }
        p = res.1
        const numGlyphs = @intCast(u64, o.u32At(f, p))
        p += 4
        if numGlyphs > (limit - p) >> 1 { return noBitmap(recurse) }
        var mm: u64 = 0
        while mm < numGlyphs {
            const gi = @intCast(u64, o.u16At(f, p))
            p += 2
            if gi == glyph { break }
            mm += 1
        }
        if mm >= numGlyphs { return noBitmap(recurse) }
        imageStart = imageSize * mm
        imageEnd = imageStart + imageSize
    } else {
        return noBitmap(recurse)
    }
    if imageStart > imageEnd { return noBitmap(recurse) }
    imageEnd -= imageStart
    imageStart = imageOffset + imageStart
    return loadBitmap(d, imageFormat, imageStart, imageEnd, xPos, yPos, recurse, metricsOnly)
}

fn noBitmap(recurse: i64) -> i32 {
    if recurse != 0 { return r.ERR_INVALID_COMPOSITE }
    return r.ERR_MISSING_BITMAP
}

// ---------------------------------------------------------------------------
// The allocator std.png decodes with: the face's FT_Memory.

fn pngAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const p = m.alloc(@intFromPtr(context), length)
    if p == 0 { return null }
    return unsafe { @ptrFromInt([*]u8, p) }
}

fn pngResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn pngRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 {
    const p = m.grow(@intFromPtr(context), @intFromPtr(memory), length, newLength)
    if p == 0 { return null }
    return unsafe { @ptrFromInt([*]u8, p) }
}

fn pngFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void { m.release(@intFromPtr(context), @intFromPtr(memory)) }

// ---------------------------------------------------------------------------
// PNG images (FreeType's Load_SBit_Png): decoded into the slot's BGRA
// bitmap at (xPos, yPos), or into a bitmap of their own size
// (`populate`).

fn loadPng(slot: usize, xPos: i64, yPos: i64, pixBits: i64, metrics: *Metrics, data: usize, length: u64, populate: bool, metricsOnly: bool) -> i32 {
    const s = r.slotRec(slot)
    if xPos < 0 || yPos < 0 { return r.ERR_INVALID_ARGUMENT }
    if !populate && (xPos + metrics.*.width > @intCast(i64, s.*.bitmap_width) || yPos + metrics.*.height > @intCast(i64, s.*.bitmap_rows) || pixBits != 32 || s.*.bitmap_pixel_mode != r.PIXEL_BGRA) { return r.ERR_INVALID_ARGUMENT }
    var image: png.Image = undefined
    const allocator = png.Allocator.{ .context = unsafe { @ptrFromInt(*anyopaque, r.faceRec(s.*.face).*.memory) }, .allocFn = pngAlloc, .resizeFn = pngResize, .remapFn = pngRemap, .freeFn = pngFree }
    const status = png.decode(&image, unsafe { @ptrFromInt([*]const u8, data) }, @intCast(usize, length), allocator)
    if status == png.Status.noMemory { return r.ERR_OUT_OF_MEMORY }
    if status != png.Status.ok { return r.ERR_INVALID_FILE_FORMAT }
    const width = @intCast(i64, image.width)
    const height = @intCast(i64, image.height)
    var err = r.OK
    if !populate && (width != metrics.*.width || height != metrics.*.height) {
        png.deinit(&image)
        return r.OK
    }
    if populate {
        if height > 0x7FFF || width > 0x7FFF {
            png.deinit(&image)
            return r.ERR_ARRAY_TOO_LARGE
        }
        metrics.*.width = width
        metrics.*.height = height
        s.*.bitmap_width = @intCast(u32, width)
        s.*.bitmap_rows = @intCast(u32, height)
        s.*.bitmap_pixel_mode = r.PIXEL_BGRA
        s.*.bitmap_pitch = @intCast(i32, width * 4)
        s.*.bitmap_num_grays = 256
    }
    if metricsOnly {
        png.deinit(&image)
        return r.OK
    }
    if populate {
        err = allocSlotBitmap(slot, @intCast(u64, height) * @intCast(u64, width) * 4)
        if err != r.OK {
            png.deinit(&image)
            return err
        }
    }
    // (std.png's premultiplied 0xAARRGGBB words are FreeType's BGRA bytes
    // in little-endian memory, rounded as it rounds.)
    const pitch = @intCast(i64, s.*.bitmap_pitch)
    var y: i64 = 0
    while y < height {
        const row = s.*.bitmap_buffer + @intCast(usize, (yPos + y) * pitch + xPos * 4)
        var x: i64 = 0
        while x < width {
            const word = unsafe { image.pixels[@intCast(usize, y * width + x)] }
            m.put32(row + @intCast(usize, x) * 4, word)
            x += 1
        }
        y += 1
    }
    png.deinit(&image)
    return r.OK
}

// ---------------------------------------------------------------------------
// `sbix` (FreeType's tt_face_load_sbix_image).

fn loadSbixImage(face: usize, f: *o.Face, slot: usize, strike: i64, gindex_: i64, metrics: *Metrics, metricsOnly: bool) -> i32 {
    const root = r.faceRec(face)
    const index = @intCast(u64, mappedStrike(f, strike))
    var gindex = gindex_
    metrics.*.width = 0
    metrics.*.height = 0
    const strikeOffset = @intCast(u64, o.u32At(f, f.*.sbitTableOffset + 8 + 4 * index))
    var depth: i64 = 0
    while true {
        if gindex > root.*.num_glyphs { return r.ERR_INVALID_ARGUMENT }
        const g = @intCast(u64, gindex)
        if strikeOffset >= f.*.sbitDataSize || f.*.sbitDataSize - strikeOffset < 4 + g * 4 + 8 { return r.ERR_INVALID_FILE_FORMAT }
        const at = f.*.sbitDataOffset + strikeOffset + 4 + g * 4
        if at > f.*.size || !o.within(f, at, 8) { return r.ERR_INVALID_STREAM_OPERATION }
        const glyphStart = @intCast(u64, o.u32At(f, at))
        const glyphEnd = @intCast(u64, o.u32At(f, at + 4))
        if glyphStart == glyphEnd { return r.ERR_MISSING_BITMAP }
        if glyphStart > glyphEnd || glyphEnd - glyphStart < 8 || f.*.sbitDataSize - strikeOffset < glyphEnd { return r.ERR_INVALID_FILE_FORMAT }
        const record = f.*.sbitDataOffset + strikeOffset + glyphStart
        if record > f.*.size || !o.within(f, record, glyphEnd - glyphStart) { return r.ERR_INVALID_STREAM_OPERATION }
        const originOffsetX = o.i16At(f, record)
        const originOffsetY = o.i16At(f, record + 2)
        const graphicType = @intCast(u64, o.u32At(f, record + 4))
        var err = r.OK
        if graphicType == 0x64757065 {
            if depth < 4 {
                gindex = o.u16At(f, record + 8)
                depth += 1
                continue
            }
            err = r.ERR_INVALID_FILE_FORMAT
        } else if graphicType == 0x706E6720 {
            err = loadPng(slot, 0, 0, 32, metrics, f.*.data + @intCast(usize, record + 8), glyphEnd - glyphStart - 8, true, metricsOnly)
        } else if graphicType == 0x6A706720 || graphicType == 0x74696666 || graphicType == 0x7267626C {
            err = r.ERR_UNKNOWN_FILE_FORMAT
        } else {
            err = r.ERR_UNIMPLEMENTED_FEATURE
        }
        if err != r.OK { return err }
        const ppem = @intCast(i64, r.sizeRec(root.*.size).*.x_ppem)
        const upem = sfnt.unitsPerEM(f)
        var advance = sfnt.glyphMetrics(f, false, gindex).1
        metrics.*.horiBearingX = calc.low16(originOffsetX)
        metrics.*.vertBearingX = calc.low16(originOffsetX)
        metrics.*.horiBearingY = calc.low16(originOffsetY + metrics.*.height)
        metrics.*.vertBearingY = calc.low16(originOffsetY)
        metrics.*.horiAdvance = calc.ulow16(advance * ppem / upem)
        if f.*.verticalInfo {
            advance = sfnt.glyphMetrics(f, true, gindex).1
        } else if sfnt.os2Present(f) {
            advance = calc.ulow16(calc.abs(sfnt.typoAscender(f) - sfnt.typoDescender(f)))
        } else {
            advance = calc.ulow16(calc.abs(sfnt.ascender(f) - sfnt.descender(f)))
        }
        metrics.*.vertAdvance = calc.ulow16(advance * ppem / upem)
        return r.OK
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// A glyph's bitmap (FreeType's tt_face_load_sbit_image and the drivers'
// load_sbit_image): the slot's bitmap and metrics.

pub fn loadGlyph(face: usize, size: usize, slot: usize, gindex: i64, loadFlags: i64) -> i32 {
    const f = o.faceRecord(face)
    const strike = o.sizeRecord(size).*.strikeIndex
    var metrics = Metrics.{ .width = 0, .height = 0, .horiBearingX = 0, .horiBearingY = 0, .horiAdvance = 0, .vertBearingX = 0, .vertBearingY = 0, .vertAdvance = 0 }
    const metricsOnly = (loadFlags & r.LOAD_BITMAP_METRICS_ONLY) != 0
    var err = r.OK
    if f.*.sbitKind == KIND_EBLC || f.*.sbitKind == KIND_CBLC {
        var d: Decoder = undefined
        err = decoderInit(&d, f, slot, strike, &metrics)
        if err == r.OK { err = loadImage(&d, gindex, 0, 0, 0, metricsOnly) }
    } else if f.*.sbitKind == KIND_SBIX {
        err = loadSbixImage(face, f, slot, strike, gindex, &metrics, metricsOnly)
    } else {
        err = r.ERR_UNKNOWN_FILE_FORMAT
    }
    const s = r.slotRec(slot)
    if err == r.OK && (loadFlags & r.LOAD_COLOR) == 0 && !metricsOnly && s.*.bitmap_pixel_mode == r.PIXEL_BGRA {
        // (A color bitmap made gray for a program that did not ask for color.)
        var converted: [40]u8 = undefined
        const target = @intFromPtr(&converted)
        bitmap.init(target)
        const library = s.*.library
        err = bitmap.convert(library, slot + SLOT_BITMAP, target, 1)
        if err != r.OK {
            _ = bitmap.done(library, target)
        } else {
            // (FT_Bitmap: rows, width, pitch, buffer, num_grays, pixel_mode.)
            s.*.bitmap_pixel_mode = m.get8(target + 26)
            s.*.bitmap_pitch = m.getI32(target + 8)
            s.*.bitmap_num_grays = m.get16(target + 24)
            const internal = o.slotRecord(slot)
            if internal.*.ownBitmap { m.release(r.faceRec(face).*.memory, s.*.bitmap_buffer) }
            s.*.bitmap_buffer = m.getWord(target + 16)
            internal.*.ownBitmap = true
        }
    }
    if err != r.OK { return err }
    s.*.n_points = 0
    s.*.n_contours = 0
    s.*.width = metrics.width * 64
    s.*.height = metrics.height * 64
    s.*.horiBearingX = metrics.horiBearingX * 64
    s.*.horiBearingY = metrics.horiBearingY * 64
    s.*.horiAdvance = metrics.horiAdvance * 64
    s.*.vertBearingX = metrics.vertBearingX * 64
    s.*.vertBearingY = metrics.vertBearingY * 64
    s.*.vertAdvance = metrics.vertAdvance * 64
    s.*.format = r.FORMAT_BITMAP
    if (loadFlags & r.LOAD_VERTICAL_LAYOUT) != 0 {
        s.*.bitmap_left = @intCast(i32, metrics.vertBearingX)
        s.*.bitmap_top = @intCast(i32, metrics.vertBearingY)
    } else {
        s.*.bitmap_left = @intCast(i32, metrics.horiBearingX)
        s.*.bitmap_top = @intCast(i32, metrics.horiBearingY)
    }
    return r.OK
}
