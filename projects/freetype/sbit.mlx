// Embedded bitmaps (`EBLC`/`EBDT`, `CBLC`/`CBDT`, `sbix`).
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")

pub const KIND_NONE: i64 = 0
pub const KIND_EBLC: i64 = 1
pub const KIND_CBLC: i64 = 2
pub const KIND_SBIX: i64 = 3

pub fn load(face: usize) -> void {}
pub fn setStrikes(face: usize) -> void {}
pub fn strikeMetrics(face: usize, size: usize, strike: i64) -> i32 { return r.ERR_INVALID_ARGUMENT }
pub fn matchStrike(face: usize, req: usize) -> i64 { return -1 }
pub fn loadGlyph(face: usize, size: usize, slot: usize, gindex: i64, loadFlags: i64) -> i32 { return r.ERR_INVALID_ARGUMENT }
pub fn done(face: usize) -> void {}
