// Font variations (`fvar`, `avar`, `gvar`, `HVAR`, `VVAR`, `MVAR`).
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const sfnt = @import("./sfnt.mlx")

pub fn isVaried(face: usize) -> bool { return false }
pub fn variesHorizontalAdvances(face: usize) -> bool { return false }
pub fn variesVerticalAdvances(face: usize) -> bool { return false }

pub fn applyGlyphDeltas(face: usize, gindex: i64, points: usize, nPoints: i64, contours: usize, nContours: i64, base: i64, unrounded: usize) -> (i32, bool) { return -> (r.OK, false) }

pub fn glyphMetrics(face: usize, vertical: bool, gindex: i64) -> (i64, i64) { return sfnt.glyphMetrics(o.faceRecord(face), vertical, gindex) }

pub fn setNamedInstance(face: usize, instance: i64) -> i32 { return r.OK }

pub fn done(face: usize) -> void {}

pub fn postscriptName(face: usize) -> usize { return sfnt.postscriptName(o.faceRecord(face)) }
