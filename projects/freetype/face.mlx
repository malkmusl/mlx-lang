// Faces: opening one (FT_Open_Face and the functions made of it) from a
// font in memory, a file or a program's stream, by the driver its format
// asks for ("truetype" for glyf outlines, "cff" for CFF and CFF2); its
// sizes (FT_New_Size, FT_Request_Size and the functions made of it) and
// glyph slot; closing it.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const library = @import("./library.mlx")
const sfnt = @import("./sfnt.mlx")
const cmap = @import("./cmap.mlx")
const cff = @import("./cff.mlx")
const truetype = @import("./truetype.mlx")
const variations = @import("./variations.mlx")
const sbit = @import("./sbit.mlx")
const color = @import("./color.mlx")

const Face = o.Face

// ---------------------------------------------------------------------------
// The font's bytes.

extern("c") fn open(path: usize, flags: i32, mode: u32) -> i32
extern("c") fn close(fd: i32) -> i32
extern("c") fn lseek(fd: i32, offset: i64, whence: i32) -> i64
extern("c") fn mmap(address: usize, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> usize
extern("c") fn munmap(address: usize, length: usize) -> i32

pub const StreamIo = fn(usize, u64, usize, u64) -> u64
pub const StreamClose = fn(usize) -> void

// The bytes of the font `args` names into `f` (FreeType's FT_Stream_New:
// one of memory, a stream or a path, by the flags).
fn openData(f: *Face, args: usize) -> i32 {
    const flags = m.get32(args) & 7
    if flags == 1 {
        f.*.data = m.getWord(args + 8)
        f.*.size = m.get64(args + 16)
        f.*.dataKind = o.DATA_CALLER
        return r.OK
    }
    if flags == 4 {
        const path = m.getWord(args + 24)
        if path == 0 { return r.ERR_CANNOT_OPEN_RESOURCE }
        const fd = open(path, 0, 0)
        if fd < 0 { return r.ERR_CANNOT_OPEN_RESOURCE }
        const size = lseek(fd, 0, 2)
        if size <= 0 {
            _ = close(fd)
            return r.ERR_CANNOT_OPEN_STREAM
        }
        const address = mmap(0, @intCast(usize, size), 1, 2, fd, 0)
        _ = close(fd)
        if address == 0 || address == 0xFFFFFFFFFFFFFFFF { return r.ERR_CANNOT_OPEN_STREAM }
        f.*.data = address
        f.*.size = @intCast(u64, size)
        f.*.dataKind = o.DATA_MAPPED
        return r.OK
    }
    if flags == 2 && m.getWord(args + 32) != 0 {
        const stream = m.getWord(args + 32)
        f.*.stream = stream
        // (The stream's memory is the library's, as FreeType sets it.)
        m.putWord(stream + 56, f.*.memory)
        const read = m.getWord(stream + 40)
        const size = m.get64(stream + 8)
        if read == 0 {
            f.*.data = m.getWord(stream)
            f.*.size = size
            f.*.dataKind = o.DATA_CALLER
            return r.OK
        }
        const block = m.alloc(f.*.memory, @intCast(usize, size) + 1)
        if block == 0 { return r.ERR_OUT_OF_MEMORY }
        const call: StreamIo = unsafe { @ptrFromInt(StreamIo, read) }
        var done: u64 = 0
        while done < size {
            var chunk = size - done
            if chunk > 1048576 { chunk = 1048576 }
            const got = call(stream, done, block + done, chunk)
            if got == 0 { break }
            done += if got > chunk { chunk } else { got }
        }
        m.putWord(stream + 16, done)
        f.*.data = block
        f.*.size = done
        f.*.dataKind = o.DATA_ALLOCATED
        return r.OK
    }
    if (m.get32(args) & 2) != 0 && m.getWord(args + 32) != 0 { closeStream(m.getWord(args + 32)) }
    return r.ERR_INVALID_ARGUMENT
}

fn closeStream(stream: usize) -> void {
    const closer = m.getWord(stream + 48)
    if closer != 0 {
        const call: StreamClose = unsafe { @ptrFromInt(StreamClose, closer) }
        call(stream)
    }
}

fn releaseData(f: *Face) -> void {
    if f.*.dataKind == o.DATA_MAPPED {
        _ = munmap(f.*.data, @intCast(usize, f.*.size))
    } else if f.*.dataKind == o.DATA_ALLOCATED {
        m.release(f.*.memory, f.*.data)
    }
    f.*.data = 0
    if f.*.stream != 0 {
        closeStream(f.*.stream)
        f.*.stream = 0
    }
}

// ---------------------------------------------------------------------------
// Opening.

// The parameters of FT_Open_Face the SFNT driver reads.
fn hasParameter(args: usize, tag: u64) -> bool {
    if (m.get32(args) & 16) == 0 { return false }
    const count = m.getI32(args + 48)
    const params = m.getWord(args + 56)
    if params == 0 { return false }
    var i: i32 = 0
    while i < count {
        if m.get64(params + @intCast(usize, i) * 16) == tag { return true }
        i += 1
    }
    return false
}

const PARAM_IGNORE_TYPOGRAPHIC_FAMILY: u64 = 0x69677066
const PARAM_IGNORE_TYPOGRAPHIC_SUBFAMILY: u64 = 0x69677073
const PARAM_IGNORE_SBIX: u64 = 0x69736278

// A new face of `f`'s bytes: its public record pointing to `f`.
fn newFace(library_: usize, memory: usize) -> usize {
    const face = m.alloc(memory, r.FACE_REC_SIZE + @sizeOf(Face))
    if face == 0 { return 0 }
    const internal = face + r.FACE_REC_SIZE
    r.faceRec(face).*.internal = internal
    r.faceRec(face).*.memory = memory
    const f = o.faceOf(internal)
    f.*.library = library_
    f.*.memory = memory
    f.*.refcount = 1
    f.*.txx = 0x10000
    f.*.tyy = 0x10000
    f.*.noStemDarkening = -1
    f.*.randomSeed = -1
    f.*.varDefaultNamedInstance = 0
    return face
}

// The SFNT part of opening (FreeType's sfnt_init_face): the collection,
// the directory, the named instances; the face's number of faces, index
// and the named instances in its style flags.
fn initSfnt(face: usize, faceIndex: i64) -> i32 {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    const opened = sfnt.openCollection(f, faceIndex)
    if opened.2 != r.OK { return opened.2 }
    const err = sfnt.loadDirectory(f, opened.1)
    if err != r.OK { return err }
    var instances = sfnt.namedInstances(f).0
    const instanceIndex = calc.abs(faceIndex) >> 16
    if instanceIndex > instances {
        if faceIndex >= 0 { return r.ERR_INVALID_ARGUMENT }
        instances = 0
    }
    root.*.style_flags = instances << 16
    root.*.num_faces = opened.0
    root.*.face_index = faceIndex
    return r.OK
}

// The face's charmaps with their encodings, as FreeType's SFNT driver
// makes them.
fn setCharmaps(face: usize) -> void {
    cmap.buildCharmaps(face)
    const root = r.faceRec(face)
    var i: i32 = 0
    while i < root.*.num_charmaps {
        const c = o.charMap(m.getWord(root.*.charmaps + @intCast(usize, i) * 8))
        c.*.encoding = cmap.encodingOf(@intCast(i64, c.*.platform_id), @intCast(i64, c.*.encoding_id))
        i += 1
    }
}

// The rest of the SFNT part (FreeType's sfnt_load_face): tables, names,
// flags, charmaps, strikes, metrics.
fn loadSfnt(face: usize, args: usize) -> i32 {
    const f = o.faceRecord(face)
    const err = sfnt.loadFace(face, hasParameter(args, PARAM_IGNORE_TYPOGRAPHIC_FAMILY), hasParameter(args, PARAM_IGNORE_TYPOGRAPHIC_SUBFAMILY), hasParameter(args, PARAM_IGNORE_SBIX))
    if err != r.OK { return err }
    sbit.load(face)
    color.load(face)
    const root = r.faceRec(face)
    if f.*.sbitKind == sbit.KIND_CBLC || f.*.sbitKind == sbit.KIND_SBIX || f.*.colrSize != 0 { root.*.face_flags |= r.FACE_COLOR }
    setCharmaps(face)
    sbit.setStrikes(face)
    sfnt.setMetrics(face)
    return r.OK
}

// The TrueType driver's part (FreeType's tt_face_init).
fn initTrueType(face: usize, faceIndex: i64, args: usize) -> i32 {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    var err = initSfnt(face, faceIndex)
    if err != r.OK { return err }
    const tag = f.*.formatTag
    if tag != 0x00010000 && tag != 0x00020000 && tag != o.TAG_true && tag != 0xA56B6264 && tag != 0xA56C7374 { return r.ERR_UNKNOWN_FILE_FORMAT }
    f.*.driver = library.TRUETYPE
    if faceIndex < 0 { return r.OK }
    err = loadSfnt(face, args)
    if err != r.OK { return err }
    if (root.*.face_flags & r.FACE_SCALABLE) != 0 || (root.*.face_flags & r.FACE_SBIX) != 0 {
        err = truetype.loadLocations(f, root)
        if err != r.OK { return err }
        if root.*.num_fixed_sizes != 0 && f.*.locaSize != 0 && truetype.singleNotdef(face) { root.*.face_flags &= ~r.FACE_SCALABLE }
    }
    f.*.outlines = if o.hasTable(f, o.TAG_glyf) { o.OUTLINES_GLYF } else { o.OUTLINES_NONE }
    const instance = faceIndex >> 16
    if (root.*.face_flags & r.FACE_MULTIPLE_MASTERS) != 0 && instance > 0 {
        err = variations.setNamedInstance(face, instance)
        if err != r.OK { return err }
    }
    return r.OK
}

// The CFF driver's part (FreeType's cff_face_init) for CFF in an SFNT
// (OpenType's `OTTO`).
fn initCff(face: usize, faceIndex: i64, args: usize) -> i32 {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    var err = initSfnt(face, faceIndex)
    if err != r.OK { return err }
    if f.*.formatTag != o.TAG_OTTO { return r.ERR_UNKNOWN_FILE_FORMAT }
    f.*.driver = library.CFF
    if faceIndex < 0 { return r.OK }
    if o.hasTable(f, o.TAG_head) {
        err = loadSfnt(face, args)
        if err != r.OK { return err }
    } else {
        // (A CFF without `head`: its charmaps only.)
        return r.ERR_UNKNOWN_FILE_FORMAT
    }
    var isCff2 = false
    var t = o.table(f, o.TAG_CFF2)
    if t.1 != 0 {
        isCff2 = true
    } else {
        t = o.table(f, o.TAG_CFF)
        if t.1 == 0 { return r.ERR_TABLE_MISSING }
    }
    f.*.outlines = if isCff2 { o.OUTLINES_CFF2 } else { o.OUTLINES_CFF }
    err = cff.load(face, t.0, t.1, isCff2)
    if err != r.OK { return err }
    root.*.face_index = faceIndex & 0xFFFF
    root.*.num_glyphs = cff.numGlyphs(face)
    const instance = faceIndex >> 16
    if (root.*.face_flags & r.FACE_MULTIPLE_MASTERS) != 0 && instance > 0 {
        err = variations.setNamedInstance(face, instance)
        if err != r.OK { return err }
    }
    cff.finishFace(face)
    return r.OK
}

// Frees what a face holds (FreeType's destroy_face).
fn destroyFace(face: usize) -> void {
    const root = r.faceRec(face)
    const f = o.faceRecord(face)
    const memory = root.*.memory
    if root.*.autohint_finalizer != 0 {
        const call: StreamClose = unsafe { @ptrFromInt(StreamClose, root.*.autohint_finalizer) }
        call(root.*.autohint_data)
    }
    while root.*.glyph != 0 { doneSlot(root.*.glyph) }
    while root.*.sizes_head != 0 { _ = doneSize(m.getWord(root.*.sizes_head + 16)) }
    root.*.size = 0
    if root.*.generic_finalizer != 0 {
        const call: StreamClose = unsafe { @ptrFromInt(StreamClose, root.*.generic_finalizer) }
        call(face)
    }
    var i: i32 = 0
    while i < root.*.num_charmaps {
        cmap.doneCharmap(m.getWord(root.*.charmaps + @intCast(usize, i) * 8), memory)
        i += 1
    }
    m.release(memory, root.*.charmaps)
    root.*.charmaps = 0
    root.*.num_charmaps = 0
    cff.done(face)
    variations.done(face)
    color.done(face)
    sbit.done(face)
    sfnt.doneFace(f)
    m.release(memory, root.*.family_name)
    m.release(memory, root.*.style_name)
    m.release(memory, root.*.available_sizes)
    releaseData(f)
    m.release(memory, face)
}

// Takes the face off its library's list of open faces.
fn unlink(face: usize) -> void {
    const f = o.faceRecord(face)
    const l = library.lib(f.*.library)
    if l.*.faces == face {
        l.*.faces = f.*.nextFace
        return
    }
    var cur = l.*.faces
    while cur != 0 {
        const next = o.faceRecord(cur).*.nextFace
        if next == face {
            o.faceRecord(cur).*.nextFace = f.*.nextFace
            return
        }
        cur = next
    }
}

export fn __mlx_freetype_done_face(face: usize) -> void {
    unlink(face)
    destroyFace(face)
}

pub fn openFace(library_: usize, args: usize, faceIndex_: i64, aface: usize) -> i32 {
    if library_ == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if args == 0 { return r.ERR_INVALID_ARGUMENT }
    var faceIndex = faceIndex_
    if faceIndex > 0 {
        faceIndex &= 0x7FFFFFFF
    } else {
        faceIndex = 0 - ((0 - faceIndex) & 0x7FFFFFFF)
    }
    const l = library.lib(library_)
    const memory = l.*.memory
    const face = newFace(library_, memory)
    if face == 0 { return r.ERR_OUT_OF_MEMORY }
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    var err = openData(f, args)
    if err != r.OK {
        m.release(memory, face)
        return err
    }
    if f.*.stream != 0 {
        root.*.stream = f.*.stream
        root.*.face_flags |= r.FACE_EXTERNAL_STREAM
    }
    if aface == 0 && faceIndex >= 0 {
        releaseData(f)
        m.release(memory, face)
        return r.ERR_INVALID_ARGUMENT
    }
    // (The drivers in FreeType's order: TrueType, then CFF.)
    err = r.ERR_MISSING_MODULE
    var tried = false
    if l.*.numModules > library.TRUETYPE {
        tried = true
        root.*.driver = library.module(library_, library.TRUETYPE)
        err = initTrueType(face, faceIndex, args)
    }
    if err == r.ERR_UNKNOWN_FILE_FORMAT && l.*.numModules > library.CFF {
        // (Each driver starts from a face of its own.)
        resetFace(face)
        root.*.driver = library.module(library_, library.CFF)
        err = initCff(face, faceIndex, args)
    }
    if !tried { err = r.ERR_MISSING_MODULE }
    if err != r.OK {
        destroyFace(face)
        return err
    }
    // (The Unicode charmap, as FreeType's find_unicode_charmap picks it.)
    _ = selectUnicode(face)
    f.*.nextFace = l.*.faces
    l.*.faces = face
    l.*.doneFace = @intFromPtr(__mlx_freetype_done_face)
    if faceIndex >= 0 {
        err = newSlot(face)
        if err == r.OK {
            const size = newSize(face)
            if size == 0 {
                err = r.ERR_OUT_OF_MEMORY
            } else {
                root.*.size = size
            }
        }
        if err != r.OK {
            __mlx_freetype_done_face(face)
            return err
        }
    }
    if (root.*.face_flags & r.FACE_SCALABLE) != 0 {
        if root.*.height < 0 { root.*.height = 0 - root.*.height }
        if (root.*.face_flags & r.FACE_VERTICAL) == 0 { root.*.max_advance_height = root.*.height }
    }
    if aface != 0 {
        m.putWord(aface, face)
    } else {
        __mlx_freetype_done_face(face)
    }
    return r.OK
}

// The face as before a driver tried it (for the next one).
fn resetFace(face: usize) -> void {
    const root = r.faceRec(face)
    const f = o.faceRecord(face)
    const memory = root.*.memory
    var i: i32 = 0
    while i < root.*.num_charmaps {
        cmap.doneCharmap(m.getWord(root.*.charmaps + @intCast(usize, i) * 8), memory)
        i += 1
    }
    m.release(memory, root.*.charmaps)
    sfnt.doneFace(f)
    m.release(memory, root.*.family_name)
    m.release(memory, root.*.style_name)
    m.release(memory, root.*.available_sizes)
    const data = f.*.data
    const size = f.*.size
    const kind = f.*.dataKind
    const stream = f.*.stream
    const flags = root.*.face_flags & r.FACE_EXTERNAL_STREAM
    const library_ = f.*.library
    m.zero(face, r.FACE_REC_SIZE + @sizeOf(Face))
    r.faceRec(face).*.internal = face + r.FACE_REC_SIZE
    r.faceRec(face).*.memory = memory
    r.faceRec(face).*.face_flags = flags
    r.faceRec(face).*.stream = stream
    const g = o.faceRecord(face)
    g.*.library = library_
    g.*.memory = memory
    g.*.refcount = 1
    g.*.txx = 0x10000
    g.*.tyy = 0x10000
    g.*.noStemDarkening = -1
    g.*.randomSeed = -1
    g.*.data = data
    g.*.size = size
    g.*.dataKind = kind
    g.*.stream = stream
}

pub fn selectUnicode(face: usize) -> i32 {
    const root = r.faceRec(face)
    if root.*.charmaps == 0 { return r.ERR_INVALID_CHARMAP_HANDLE }
    var i = root.*.num_charmaps
    while i > 0 {
        i -= 1
        const c = o.charMap(m.getWord(root.*.charmaps + @intCast(usize, i) * 8))
        if c.*.encoding == r.ENCODING_UNICODE {
            if (c.*.platform_id == 3 && c.*.encoding_id == 10) || (c.*.platform_id == 0 && c.*.encoding_id == 4) {
                root.*.charmap = m.getWord(root.*.charmaps + @intCast(usize, i) * 8)
                return r.OK
            }
        }
    }
    i = root.*.num_charmaps
    while i > 0 {
        i -= 1
        const c = o.charMap(m.getWord(root.*.charmaps + @intCast(usize, i) * 8))
        if c.*.encoding == r.ENCODING_UNICODE {
            root.*.charmap = m.getWord(root.*.charmaps + @intCast(usize, i) * 8)
            return r.OK
        }
    }
    return r.ERR_INVALID_CHARMAP_HANDLE
}

// ---------------------------------------------------------------------------
// The glyph slot.

fn newSlot(face: usize) -> i32 {
    const root = r.faceRec(face)
    const memory = root.*.memory
    const slot = m.alloc(memory, r.SLOT_REC_SIZE + @sizeOf(o.Slot))
    if slot == 0 { return r.ERR_OUT_OF_MEMORY }
    const s = r.slotRec(slot)
    s.*.face = face
    s.*.library = o.faceRecord(face).*.library
    s.*.internal = slot + r.SLOT_REC_SIZE
    s.*.next = root.*.glyph
    root.*.glyph = slot
    return r.OK
}

fn doneSlot(slot: usize) -> void {
    const s = r.slotRec(slot)
    const face = s.*.face
    const root = r.faceRec(face)
    const memory = root.*.memory
    // (Off the face's list of slots.)
    if root.*.glyph == slot {
        root.*.glyph = s.*.next
    } else {
        var cur = root.*.glyph
        while cur != 0 {
            if r.slotRec(cur).*.next == slot {
                r.slotRec(cur).*.next = s.*.next
                break
            }
            cur = r.slotRec(cur).*.next
        }
    }
    if s.*.generic_finalizer != 0 {
        const call: StreamClose = unsafe { @ptrFromInt(StreamClose, s.*.generic_finalizer) }
        call(slot)
    }
    const internal = o.slotRecord(slot)
    truetype.doneLoader(slot, memory)
    if internal.*.ownBitmap { m.release(memory, s.*.bitmap_buffer) }
    m.release(memory, internal.*.points)
    m.release(memory, internal.*.tags)
    m.release(memory, internal.*.contours)
    m.release(memory, internal.*.subglyphs)
    m.release(memory, slot)
}

// ---------------------------------------------------------------------------
// Sizes.

pub fn newSize(face: usize) -> usize {
    const root = r.faceRec(face)
    const memory = root.*.memory
    const size = m.alloc(memory, r.SIZE_REC_SIZE + @sizeOf(o.Size))
    if size == 0 { return 0 }
    const node = m.alloc(memory, 24)
    if node == 0 {
        m.release(memory, size)
        return 0
    }
    r.sizeRec(size).*.face = face
    r.sizeRec(size).*.internal = size + r.SIZE_REC_SIZE
    o.sizeRecord(size).*.strikeIndex = -1
    // (Appended to the face's list of sizes, FT_ListNodeRec: prev, next, data.)
    m.putWord(node + 16, size)
    m.putWord(node, root.*.sizes_tail)
    if root.*.sizes_tail != 0 {
        m.putWord(root.*.sizes_tail + 8, node)
    } else {
        root.*.sizes_head = node
    }
    root.*.sizes_tail = node
    return size
}

pub fn doneSize(size: usize) -> i32 {
    if size == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    const face = r.sizeRec(size).*.face
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const root = r.faceRec(face)
    const memory = root.*.memory
    var node = root.*.sizes_head
    while node != 0 && m.getWord(node + 16) != size { node = m.getWord(node + 8) }
    if node == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    const prev = m.getWord(node)
    const next = m.getWord(node + 8)
    if prev != 0 { m.putWord(prev + 8, next) } else { root.*.sizes_head = next }
    if next != 0 { m.putWord(next, prev) } else { root.*.sizes_tail = prev }
    m.release(memory, node)
    if root.*.size == size {
        root.*.size = 0
        if root.*.sizes_head != 0 { root.*.size = m.getWord(root.*.sizes_head + 16) }
    }
    const s = r.sizeRec(size)
    if s.*.generic_finalizer != 0 {
        const call: StreamClose = unsafe { @ptrFromInt(StreamClose, s.*.generic_finalizer) }
        call(size)
    }
    m.release(memory, size)
    return r.OK
}

// FreeType's ft_recompute_scaled_metrics: the size's global metrics, on
// the pixel grid.
fn recomputeScaledMetrics(face: usize, size: usize) -> void {
    const root = r.faceRec(face)
    const s = r.sizeRec(size)
    s.*.ascender = calc.pixCeil(calc.mulFix(@intCast(i64, root.*.ascender), s.*.y_scale))
    s.*.descender = calc.pixFloor(calc.mulFix(@intCast(i64, root.*.descender), s.*.y_scale))
    s.*.height = calc.pixRound(calc.mulFix(@intCast(i64, root.*.height), s.*.y_scale))
    s.*.max_advance = calc.pixRound(calc.mulFix(@intCast(i64, root.*.max_advance_width), s.*.x_scale))
}

// FreeType's FT_Request_Metrics.
fn requestMetrics(face: usize, size: usize, req: usize) -> i32 {
    const root = r.faceRec(face)
    const s = r.sizeRec(size)
    if (root.*.face_flags & r.FACE_SCALABLE) == 0 {
        s.*.x_ppem = 0
        s.*.y_ppem = 0
        s.*.ascender = 0
        s.*.descender = 0
        s.*.height = 0
        s.*.max_advance = 0
        s.*.x_scale = 0x10000
        s.*.y_scale = 0x10000
        return r.OK
    }
    const kind = m.getI32(req)
    const reqWidth = m.getI64(req + 8)
    const reqHeight = m.getI64(req + 16)
    const horiRes = @intCast(i64, m.get32(req + 24))
    const vertRes = @intCast(i64, m.get32(req + 28))
    var w: i64 = 0
    var h: i64 = 0
    var scaledW: i64 = 0
    var scaledH: i64 = 0
    var ppemOnly = false
    if kind == 0 {
        w = @intCast(i64, root.*.units_per_EM)
        h = w
    } else if kind == 1 {
        w = @intCast(i64, root.*.ascender) - @intCast(i64, root.*.descender)
        h = w
    } else if kind == 2 {
        w = root.*.bbox_xMax - root.*.bbox_xMin
        h = root.*.bbox_yMax - root.*.bbox_yMin
    } else if kind == 3 {
        w = @intCast(i64, root.*.max_advance_width)
        h = @intCast(i64, root.*.ascender) - @intCast(i64, root.*.descender)
    } else if kind == 4 {
        s.*.x_scale = reqWidth
        s.*.y_scale = reqHeight
        if s.*.x_scale == 0 {
            s.*.x_scale = s.*.y_scale
        } else if s.*.y_scale == 0 {
            s.*.y_scale = s.*.x_scale
        }
        ppemOnly = true
    }
    if !ppemOnly {
        if w < 0 { w = 0 - w }
        if h < 0 { h = 0 - h }
        scaledW = if horiRes != 0 { (reqWidth * horiRes + 36) / 72 } else { reqWidth }
        scaledH = if vertRes != 0 { (reqHeight * vertRes + 36) / 72 } else { reqHeight }
        if reqHeight != 0 || reqWidth == 0 {
            if h == 0 { return r.ERR_DIVIDE_BY_ZERO }
            s.*.y_scale = calc.divFix(scaledH, h)
        }
        if reqWidth != 0 {
            if w == 0 { return r.ERR_DIVIDE_BY_ZERO }
            s.*.x_scale = calc.divFix(scaledW, w)
        } else {
            s.*.x_scale = s.*.y_scale
            scaledW = calc.mulDiv(scaledH, w, h)
        }
        if reqHeight == 0 {
            s.*.y_scale = s.*.x_scale
            scaledH = calc.mulDiv(scaledW, h, w)
        }
        if kind == 3 {
            if s.*.y_scale > s.*.x_scale {
                s.*.y_scale = s.*.x_scale
            } else {
                s.*.x_scale = s.*.y_scale
            }
        }
    }
    if kind != 0 {
        scaledW = calc.mulFix(@intCast(i64, root.*.units_per_EM), s.*.x_scale)
        scaledH = calc.mulFix(@intCast(i64, root.*.units_per_EM), s.*.y_scale)
    }
    scaledW = (scaledW + 32) >> 6
    scaledH = (scaledH + 32) >> 6
    if scaledW > 0xFFFF || scaledH > 0xFFFF { return r.ERR_INVALID_PIXEL_SIZE }
    s.*.x_ppem = @intCast(u16, scaledW & 0xFFFF)
    s.*.y_ppem = @intCast(u16, scaledH & 0xFFFF)
    recomputeScaledMetrics(face, size)
    return r.OK
}

// FreeType's FT_Select_Metrics.
pub fn selectMetrics(face: usize, size: usize, strike: i64) -> void {
    const root = r.faceRec(face)
    const s = r.sizeRec(size)
    const bsize = root.*.available_sizes + @intCast(usize, strike) * 32
    const xPpem = m.getI64(bsize + 16)
    const yPpem = m.getI64(bsize + 24)
    s.*.x_ppem = @intCast(u16, ((xPpem + 32) >> 6) & 0xFFFF)
    s.*.y_ppem = @intCast(u16, ((yPpem + 32) >> 6) & 0xFFFF)
    if (root.*.face_flags & r.FACE_SCALABLE) != 0 {
        s.*.x_scale = calc.divFix(xPpem, @intCast(i64, root.*.units_per_EM))
        s.*.y_scale = calc.divFix(yPpem, @intCast(i64, root.*.units_per_EM))
        recomputeScaledMetrics(face, size)
    } else {
        s.*.x_scale = 0x10000
        s.*.y_scale = 0x10000
        s.*.ascender = yPpem
        s.*.descender = 0
        s.*.height = @intCast(i64, m.getI16(bsize)) << 6
        s.*.max_advance = xPpem
    }
}

// TrueType's metrics of a size for loading glyphs (FreeType's
// tt_size_reset): the scales of the rounded ppem when `head` asks for
// integer ppems.
fn resetTrueType(face: usize, size: usize) -> i32 {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    const s = r.sizeRec(size)
    const t = o.sizeRecord(size)
    t.*.ttValid = false
    t.*.tt_x_ppem = @intCast(i64, s.*.x_ppem)
    t.*.tt_y_ppem = @intCast(i64, s.*.y_ppem)
    t.*.tt_x_scale = s.*.x_scale
    t.*.tt_y_scale = s.*.y_scale
    t.*.tt_ascender = s.*.ascender
    t.*.tt_descender = s.*.descender
    t.*.tt_height = s.*.height
    t.*.tt_max_advance = s.*.max_advance
    if s.*.x_ppem < 1 || s.*.y_ppem < 1 { return r.ERR_INVALID_PPEM }
    if (sfnt.headFlags(f) & 8) != 0 {
        t.*.tt_ascender = calc.pixRound(calc.mulFix(@intCast(i64, root.*.ascender), s.*.y_scale))
        t.*.tt_descender = calc.pixRound(calc.mulFix(@intCast(i64, root.*.descender), s.*.y_scale))
        t.*.tt_height = calc.pixRound(calc.mulFix(@intCast(i64, root.*.height), s.*.y_scale))
    }
    t.*.ttValid = true
    if (sfnt.headFlags(f) & 8) != 0 {
        t.*.tt_x_scale = calc.divFix(t.*.tt_x_ppem << 6, @intCast(i64, root.*.units_per_EM))
        t.*.tt_y_scale = calc.divFix(t.*.tt_y_ppem << 6, @intCast(i64, root.*.units_per_EM))
        t.*.tt_max_advance = calc.pixRound(calc.mulFix(@intCast(i64, root.*.max_advance_width), t.*.tt_x_scale))
    }
    return r.OK
}

fn selectStrike(face: usize, size: usize, strike: i64) -> i32 {
    const f = o.faceRecord(face)
    const root = r.faceRec(face)
    const t = o.sizeRecord(size)
    t.*.strikeIndex = strike
    if (root.*.face_flags & r.FACE_SCALABLE) != 0 {
        selectMetrics(face, size, strike)
        if f.*.driver == library.TRUETYPE { _ = resetTrueType(face, size) }
        return r.OK
    }
    const err = sbit.strikeMetrics(face, size, strike)
    if err != r.OK { t.*.strikeIndex = -1 }
    return err
}

pub fn requestSize(face: usize, req: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const root = r.faceRec(face)
    const size = root.*.size
    if size == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    if req == 0 || m.getI64(req + 8) < 0 || m.getI64(req + 16) < 0 || m.getI32(req) < 0 || m.getI32(req) >= 5 { return r.ERR_INVALID_ARGUMENT }
    const f = o.faceRecord(face)
    const t = o.sizeRecord(size)
    if (root.*.face_flags & r.FACE_FIXED_SIZES) != 0 {
        const strike = sbit.matchStrike(face, req)
        if strike >= 0 { return selectStrike(face, size, strike) }
        t.*.strikeIndex = -1
    }
    var err = requestMetrics(face, size, req)
    if err != r.OK { return err }
    if f.*.driver == library.TRUETYPE && (root.*.face_flags & r.FACE_SCALABLE) != 0 { err = resetTrueType(face, size) }
    return err
}

// ---------------------------------------------------------------------------
// The exported functions.

export fn FT_New_Face(library_: usize, path: usize, face_index: i64, aface: usize) -> i32 {
    if path == 0 { return r.ERR_INVALID_ARGUMENT }
    const args = m.cAlloc(64)
    m.put32(args, 4)
    m.putWord(args + 24, path)
    const err = openFace(library_, args, face_index, aface)
    m.cFree(args)
    return err
}

export fn FT_New_Memory_Face(library_: usize, file_base: usize, file_size: i64, face_index: i64, aface: usize) -> i32 {
    if file_base == 0 { return r.ERR_INVALID_ARGUMENT }
    const args = m.cAlloc(64)
    m.put32(args, 1)
    m.putWord(args + 8, file_base)
    m.putI64(args + 16, file_size)
    const err = openFace(library_, args, face_index, aface)
    m.cFree(args)
    return err
}

export fn FT_Open_Face(library_: usize, args: usize, face_index: i64, aface: usize) -> i32 { return openFace(library_, args, face_index, aface) }

export fn FT_Attach_File(face: usize, path: usize) -> i32 {
    if path == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_UNIMPLEMENTED_FEATURE
}

export fn FT_Attach_Stream(face: usize, parameters: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_UNIMPLEMENTED_FEATURE
}

export fn FT_Reference_Face(face: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    o.faceRecord(face).*.refcount += 1
    return r.OK
}

export fn FT_Done_Face(face: usize) -> i32 {
    if face == 0 || r.faceRec(face).*.driver == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const f = o.faceRecord(face)
    f.*.refcount -= 1
    if f.*.refcount > 0 { return r.OK }
    unlink(face)
    destroyFace(face)
    return r.OK
}

export fn FT_New_Size(face: usize, asize: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if asize == 0 { return r.ERR_INVALID_ARGUMENT }
    if r.faceRec(face).*.driver == 0 { return r.ERR_INVALID_DRIVER_HANDLE }
    const size = newSize(face)
    if size == 0 { return r.ERR_OUT_OF_MEMORY }
    m.putWord(asize, size)
    return r.OK
}

export fn FT_Done_Size(size: usize) -> i32 { return doneSize(size) }

export fn FT_Activate_Size(size: usize) -> i32 {
    if size == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    const face = r.sizeRec(size).*.face
    if face == 0 || r.faceRec(face).*.driver == 0 { return r.ERR_INVALID_FACE_HANDLE }
    r.faceRec(face).*.size = size
    return r.OK
}

export fn FT_Request_Size(face: usize, req: usize) -> i32 { return requestSize(face, req) }

export fn FT_Select_Size(face: usize, strike_index: i32) -> i32 {
    if face == 0 || (r.faceRec(face).*.face_flags & r.FACE_FIXED_SIZES) == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const root = r.faceRec(face)
    if strike_index < 0 || strike_index >= root.*.num_fixed_sizes { return r.ERR_INVALID_ARGUMENT }
    return selectStrike(face, root.*.size, @intCast(i64, strike_index))
}

export fn FT_Set_Char_Size(face: usize, char_width_: i64, char_height_: i64, horz_resolution_: u32, vert_resolution_: u32) -> i32 {
    var charWidth = char_width_
    var charHeight = char_height_
    var horz = horz_resolution_
    var vert = vert_resolution_
    if charWidth == 0 {
        charWidth = charHeight
    } else if charHeight == 0 {
        charHeight = charWidth
    }
    if horz == 0 {
        horz = vert
    } else if vert == 0 {
        vert = horz
    }
    if charWidth < 64 { charWidth = 64 }
    if charHeight < 64 { charHeight = 64 }
    if horz == 0 {
        horz = 72
        vert = 72
    }
    const req = m.cAlloc(32)
    m.putI32(req, 0)
    m.putI64(req + 8, charWidth)
    m.putI64(req + 16, charHeight)
    m.put32(req + 24, horz)
    m.put32(req + 28, vert)
    const err = requestSize(face, req)
    m.cFree(req)
    return err
}

export fn FT_Set_Pixel_Sizes(face: usize, pixel_width_: u32, pixel_height_: u32) -> i32 {
    var w = pixel_width_
    var h = pixel_height_
    if w == 0 {
        w = h
    } else if h == 0 {
        h = w
    }
    if w < 1 { w = 1 }
    if h < 1 { h = 1 }
    if w >= 0xFFFF { w = 0xFFFF }
    if h >= 0xFFFF { h = 0xFFFF }
    const req = m.cAlloc(32)
    m.putI32(req, 0)
    m.putI64(req + 8, @intCast(i64, w) << 6)
    m.putI64(req + 16, @intCast(i64, h) << 6)
    const err = requestSize(face, req)
    m.cFree(req)
    return err
}

export fn FT_Set_Transform(face: usize, matrix: usize, delta: usize) -> void {
    if face == 0 { return }
    const f = o.faceRecord(face)
    f.*.transformFlags = 0
    if matrix == 0 {
        f.*.txx = 0x10000
        f.*.txy = 0
        f.*.tyx = 0
        f.*.tyy = 0x10000
    } else {
        f.*.txx = m.getI64(matrix)
        f.*.txy = m.getI64(matrix + 8)
        f.*.tyx = m.getI64(matrix + 16)
        f.*.tyy = m.getI64(matrix + 24)
    }
    if (f.*.txy | f.*.tyx) != 0 || f.*.txx != 0x10000 || f.*.tyy != 0x10000 { f.*.transformFlags |= 1 }
    if delta == 0 {
        f.*.tdx = 0
        f.*.tdy = 0
    } else {
        f.*.tdx = m.getI64(delta)
        f.*.tdy = m.getI64(delta + 8)
    }
    if (f.*.tdx | f.*.tdy) != 0 { f.*.transformFlags |= 2 }
}

export fn FT_Get_Transform(face: usize, matrix: usize, delta: usize) -> void {
    if face == 0 { return }
    const f = o.faceRecord(face)
    if matrix != 0 {
        m.putI64(matrix, f.*.txx)
        m.putI64(matrix + 8, f.*.txy)
        m.putI64(matrix + 16, f.*.tyx)
        m.putI64(matrix + 24, f.*.tyy)
    }
    if delta != 0 {
        m.putI64(delta, f.*.tdx)
        m.putI64(delta + 8, f.*.tdy)
    }
}

export fn FT_Face_Properties(face: usize, num_properties: u32, properties: usize) -> i32 {
    if num_properties > 0 && properties == 0 { return r.ERR_INVALID_ARGUMENT }
    const f = o.faceRecord(face)
    var i: u32 = 0
    while i < num_properties {
        const p = properties + @intCast(usize, i) * 16
        const tag = m.get64(p)
        const data = m.getWord(p + 8)
        if tag == 0x6461726B {
            if data != 0 {
                f.*.noStemDarkening = if m.get8(data) == 1 { 0 } else { 1 }
            } else {
                f.*.noStemDarkening = -1
            }
        } else if tag == 0x6C636466 {
            if data != 0 {
                f.*.lcdWeights = library.packWeights(data)
                f.*.hasLcdWeights = true
            }
        } else if tag == 0x73656564 {
            if data != 0 {
                f.*.randomSeed = @intCast(i64, m.getI32(data))
                if f.*.randomSeed < 0 { f.*.randomSeed = 0 }
            } else {
                f.*.randomSeed = -1
            }
        } else {
            return r.ERR_INVALID_ARGUMENT
        }
        i += 1
    }
    return r.OK
}
