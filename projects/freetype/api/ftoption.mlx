// freetype/config/ftoption.h
// mlx-freetype: the options the library is built with, as FreeType names
// them; a program tests them with `#ifdef`. Only what the library does
// is named here: subpixel (LCD) rendering with its filters, embedded
// bitmaps (CBDT, sbix, EBDT), color layers (COLR and CPAL version 0),
// SFNT names, PostScript glyph names, and font variations (fvar, avar,
// gvar, HVAR, VVAR, MVAR and CFF2's blends). Not here: the bytecode
// interpreter and the auto-hinter (a hinted load is the outline
// unhinted with the metrics on the pixel grid, as FreeType built without
// a hinter gives it), COLR version 1, OpenType SVG, compressed streams.

pub const FT_CONFIG_OPTION_SUBPIXEL_RENDERING: c_int = 1
pub const FT_CONFIG_OPTION_POSTSCRIPT_NAMES: c_int = 1
pub const FT_CONFIG_OPTION_USE_PNG: c_int = 1
pub const FT_RENDER_POOL_SIZE: c_long = 16384
pub const FT_MAX_MODULES: c_int = 32
pub const TT_CONFIG_OPTION_EMBEDDED_BITMAPS: c_int = 1
pub const TT_CONFIG_OPTION_COLOR_LAYERS: c_int = 1
pub const TT_CONFIG_OPTION_POSTSCRIPT_NAMES: c_int = 1
pub const TT_CONFIG_OPTION_SFNT_NAMES: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_0: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_2: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_4: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_6: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_10: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_12: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_13: c_int = 1
pub const TT_CONFIG_CMAP_FORMAT_14: c_int = 1
pub const TT_CONFIG_OPTION_GX_VAR_SUPPORT: c_int = 1
pub const T1_MAX_DICT_DEPTH: c_int = 5
pub const T1_MAX_SUBRS_CALLS: c_int = 16
pub const T1_MAX_CHARSTRINGS_OPERANDS: c_int = 256
