// freetype/ftlcdfil.h
// mlx-freetype: subpixel (LCD) rendering. A library filters the three
// times wider (or higher) image of FT_RENDER_MODE_LCD (LCD_V) with five
// weights, FreeType's default ones unless set; FT_LCD_FILTER_NONE leaves
// it unfiltered.
const freetype = @import("./freetype.mlx")
const ftparams = @import("./ftparams.mlx")

pub const FT_LcdFilter_ = enum(c_int) {
    FT_LCD_FILTER_NONE = 0,
    FT_LCD_FILTER_DEFAULT = 1,
    FT_LCD_FILTER_LIGHT = 2,
    FT_LCD_FILTER_LEGACY1 = 3,
    FT_LCD_FILTER_LEGACY = 16,
    FT_LCD_FILTER_MAX = 17,
}
pub const FT_LcdFilter = FT_LcdFilter_

pub extern("c") fn FT_Library_SetLcdFilter(library: freetype.FT_Library, filter: FT_LcdFilter) -> fttypes.FT_Error
pub extern("c") fn FT_Library_SetLcdFilterWeights(library: freetype.FT_Library, weights: *c_uchar) -> fttypes.FT_Error

pub const FT_LCD_FILTER_FIVE_TAPS: c_int = 5
pub const FT_LcdFiveTapFilter = [5]fttypes.FT_Byte

pub extern("c") fn FT_Library_SetLcdGeometry(library: freetype.FT_Library, sub: *ftimage.FT_Vector) -> fttypes.FT_Error
