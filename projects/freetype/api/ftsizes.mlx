// freetype/ftsizes.h
// mlx-freetype: more than one size of a face: a new size, made the
// active one (face->size) to load glyphs at.
const freetype = @import("./freetype.mlx")

pub extern("c") fn FT_New_Size(face: freetype.FT_Face, size: *freetype.FT_Size) -> fttypes.FT_Error
pub extern("c") fn FT_Done_Size(size: freetype.FT_Size) -> fttypes.FT_Error
pub extern("c") fn FT_Activate_Size(size: freetype.FT_Size) -> fttypes.FT_Error
