// freetype/ftmodapi.h
// mlx-freetype: a library's modules and their properties. The modules
// are the library's own ("truetype", "cff", "sfnt", "smooth", "raster"
// and the others FreeType names); a program cannot add modules of its
// own.
const c_function_pointers = true
const freetype = @import("./freetype.mlx")

const FT_Library = freetype.FT_Library
const FT_Module = freetype.FT_Module
const FT_Error = fttypes.FT_Error

pub const FT_MODULE_FONT_DRIVER: c_int = 1
pub const FT_MODULE_RENDERER: c_int = 2
pub const FT_MODULE_HINTER: c_int = 4
pub const FT_MODULE_STYLER: c_int = 8
pub const FT_MODULE_DRIVER_SCALABLE: c_int = 0x100
pub const FT_MODULE_DRIVER_NO_OUTLINES: c_int = 0x200
pub const FT_MODULE_DRIVER_HAS_HINTER: c_int = 0x400
pub const FT_MODULE_DRIVER_HINTS_LIGHTLY: c_int = 0x800
pub const ft_module_font_driver: c_int = 1
pub const ft_module_renderer: c_int = 2
pub const ft_module_hinter: c_int = 4
pub const ft_module_styler: c_int = 8
pub const ft_module_driver_scalable: c_int = 0x100
pub const ft_module_driver_no_outlines: c_int = 0x200
pub const ft_module_driver_has_hinter: c_int = 0x400
pub const ft_module_driver_hints_lightly: c_int = 0x800

pub const FT_Module_Interface = fttypes.FT_Pointer
pub const FT_Module_Constructor = fn(module: FT_Module) -> FT_Error
pub const FT_Module_Destructor = fn(module: FT_Module) -> void
pub const FT_Module_Requester = fn(module: FT_Module, name: *const c_char) -> FT_Module_Interface

// What a module is: a face's `driver` points to its module, whose first
// word points to this (FT_FACE_DRIVER_NAME reads `module_name` there).
pub const FT_Module_Class_ = struct {
    module_flags: fttypes.FT_ULong
    module_size: fttypes.FT_Long
    module_name: *const fttypes.FT_String
    module_version: fttypes.FT_Fixed
    module_requires: fttypes.FT_Fixed
    module_interface: *const anyopaque
    module_init: FT_Module_Constructor
    module_done: FT_Module_Destructor
    get_interface: FT_Module_Requester
}
pub const FT_Module_Class = FT_Module_Class_

pub extern("c") fn FT_Add_Module(library: FT_Library, clazz: *const FT_Module_Class) -> FT_Error
pub extern("c") fn FT_Get_Module(library: FT_Library, module_name: *const c_char) -> FT_Module
pub extern("c") fn FT_Remove_Module(library: FT_Library, module: FT_Module) -> FT_Error

pub inline fn FT_FACE_DRIVER_NAME(face: anytype) -> *const fttypes.FT_String { return @ptrCast(**FT_Module_Class, face.*.driver).*.*.module_name }

// Sets a property of a module ("truetype" "interpreter-version", "cff"
// "hinting-engine"...): FT_Err_Missing_Module for a module the library
// has not, FT_Err_Missing_Property for a property the module has not.
pub extern("c") fn FT_Property_Set(library: FT_Library, module_name: *const fttypes.FT_String, property_name: *const fttypes.FT_String, value: *const anyopaque) -> FT_Error
pub extern("c") fn FT_Property_Get(library: FT_Library, module_name: *const fttypes.FT_String, property_name: *const fttypes.FT_String, value: *anyopaque) -> FT_Error
// The properties the FREETYPE_PROPERTIES environment variable sets.
pub extern("c") fn FT_Set_Default_Properties(library: FT_Library) -> void
pub extern("c") fn FT_Reference_Library(library: FT_Library) -> FT_Error
// A library allocating through `memory`, with no modules yet: as with
// FreeType, FT_Add_Default_Modules adds them.
pub extern("c") fn FT_New_Library(memory: ftsystem.FT_Memory, alibrary: *FT_Library) -> FT_Error
pub extern("c") fn FT_Done_Library(library: FT_Library) -> FT_Error

pub const FT_DebugHook_Func = fn(arg: *anyopaque) -> FT_Error
pub const FT_DEBUG_HOOK_TRUETYPE: c_int = 0

pub extern("c") fn FT_Set_Debug_Hook(library: FT_Library, hook_index: fttypes.FT_UInt, debug_hook: FT_DebugHook_Func) -> void
pub extern("c") fn FT_Add_Default_Modules(library: FT_Library) -> void

pub const FT_TrueTypeEngineType_ = enum(c_int) {
    FT_TRUETYPE_ENGINE_TYPE_NONE = 0,
    FT_TRUETYPE_ENGINE_TYPE_UNPATENTED = 1,
    FT_TRUETYPE_ENGINE_TYPE_PATENTED = 2,
}
pub const FT_TrueTypeEngineType = FT_TrueTypeEngineType_

pub extern("c") fn FT_Get_TrueType_Engine_Type(library: FT_Library) -> FT_TrueTypeEngineType
