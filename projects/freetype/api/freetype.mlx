    vertResolution: FT_UInt
}
pub const FT_Size_RequestRec = FT_Size_RequestRec_
pub const FT_Size_Request = *FT_Size_RequestRec_

pub extern("c") fn FT_Request_Size(face: FT_Face, req: FT_Size_Request) -> FT_Error
// The active size for characters of `char_width` by `char_height` points
// (26.6; 0 for the other one) at the resolutions given (72 dpi for 0).
pub extern("c") fn FT_Set_Char_Size(face: FT_Face, char_width: fttypes.FT_F26Dot6, char_height: fttypes.FT_F26Dot6, horz_resolution: FT_UInt, vert_resolution: FT_UInt) -> FT_Error
pub extern("c") fn FT_Set_Pixel_Sizes(face: FT_Face, pixel_width: FT_UInt, pixel_height: FT_UInt) -> FT_Error
// The glyph `glyph_index` into the face's glyph slot, by `load_flags`.
pub extern("c") fn FT_Load_Glyph(face: FT_Face, glyph_index: FT_UInt, load_flags: integertypes.FT_Int32) -> FT_Error
pub extern("c") fn FT_Load_Char(face: FT_Face, char_code: FT_ULong, load_flags: integertypes.FT_Int32) -> FT_Error

