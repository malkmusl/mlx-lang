// A charmap of a face: its encoding and the platform and encoding IDs
// of its subtable in the font's `cmap`.
pub const FT_CharMapRec_ = struct {
    face: FT_Face
    encoding: FT_Encoding
    platform_id: FT_UShort
    encoding_id: FT_UShort
}
pub const FT_CharMapRec = FT_CharMapRec_

// A face: one font of a file (`face_index`, of `num_faces`), its glyphs,
// names and flags, its charmaps, the metrics of its design (in font
// units), the glyph slot and the active size.
pub const FT_FaceRec_ = struct {
    num_faces: FT_Long
    face_index: FT_Long
    face_flags: FT_Long
    style_flags: FT_Long
    num_glyphs: FT_Long
    family_name: *FT_String
    style_name: *FT_String
    num_fixed_sizes: FT_Int
    available_sizes: *FT_Bitmap_Size
    num_charmaps: FT_Int
    charmaps: *FT_CharMap
    generic: FT_Generic
    bbox: ftimage.FT_BBox
    units_per_EM: FT_UShort
    ascender: FT_Short
    descender: FT_Short
    height: FT_Short
    max_advance_width: FT_Short
    max_advance_height: FT_Short
    underline_position: FT_Short
    underline_thickness: FT_Short
    glyph: FT_GlyphSlot
    size: FT_Size
    charmap: FT_CharMap
    driver: FT_Driver
    memory: ftsystem.FT_Memory
    stream: ftsystem.FT_Stream
    sizes_list: fttypes.FT_ListRec
    autohint: FT_Generic
    extensions: *anyopaque
    internal: FT_Face_Internal
}
pub const FT_FaceRec = FT_FaceRec_

pub const FT_FACE_FLAG_SCALABLE: c_long = 1 << 0
pub const FT_FACE_FLAG_FIXED_SIZES: c_long = 1 << 1
pub const FT_FACE_FLAG_FIXED_WIDTH: c_long = 1 << 2
pub const FT_FACE_FLAG_SFNT: c_long = 1 << 3
pub const FT_FACE_FLAG_HORIZONTAL: c_long = 1 << 4
pub const FT_FACE_FLAG_VERTICAL: c_long = 1 << 5
pub const FT_FACE_FLAG_KERNING: c_long = 1 << 6
pub const FT_FACE_FLAG_FAST_GLYPHS: c_long = 1 << 7
pub const FT_FACE_FLAG_MULTIPLE_MASTERS: c_long = 1 << 8
pub const FT_FACE_FLAG_GLYPH_NAMES: c_long = 1 << 9
pub const FT_FACE_FLAG_EXTERNAL_STREAM: c_long = 1 << 10
pub const FT_FACE_FLAG_HINTER: c_long = 1 << 11
pub const FT_FACE_FLAG_CID_KEYED: c_long = 1 << 12
pub const FT_FACE_FLAG_TRICKY: c_long = 1 << 13
pub const FT_FACE_FLAG_COLOR: c_long = 1 << 14
pub const FT_FACE_FLAG_VARIATION: c_long = 1 << 15
pub const FT_FACE_FLAG_SVG: c_long = 1 << 16
pub const FT_FACE_FLAG_SBIX: c_long = 1 << 17
pub const FT_FACE_FLAG_SBIX_OVERLAY: c_long = 1 << 18

pub fn FT_HAS_HORIZONTAL(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_HORIZONTAL) != 0 }
pub fn FT_HAS_VERTICAL(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_VERTICAL) != 0 }
pub fn FT_HAS_KERNING(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_KERNING) != 0 }
pub fn FT_IS_SCALABLE(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_SCALABLE) != 0 }
pub fn FT_IS_SFNT(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_SFNT) != 0 }
pub fn FT_IS_FIXED_WIDTH(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_FIXED_WIDTH) != 0 }
pub fn FT_HAS_FIXED_SIZES(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_FIXED_SIZES) != 0 }
pub fn FT_HAS_FAST_GLYPHS(face: anytype) -> bool { return false }
pub fn FT_HAS_GLYPH_NAMES(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_GLYPH_NAMES) != 0 }
pub fn FT_HAS_MULTIPLE_MASTERS(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_MULTIPLE_MASTERS) != 0 }
pub fn FT_IS_NAMED_INSTANCE(face: anytype) -> bool { return (face.*.face_index & 0x7FFF0000) != 0 }
pub fn FT_IS_VARIATION(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_VARIATION) != 0 }
pub fn FT_IS_CID_KEYED(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_CID_KEYED) != 0 }
pub fn FT_IS_TRICKY(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_TRICKY) != 0 }
pub fn FT_HAS_COLOR(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_COLOR) != 0 }
pub fn FT_HAS_SVG(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_SVG) != 0 }
pub fn FT_HAS_SBIX(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_SBIX) != 0 }
pub fn FT_HAS_SBIX_OVERLAY(face: anytype) -> bool { return (face.*.face_flags & FT_FACE_FLAG_SBIX_OVERLAY) != 0 }

pub const FT_STYLE_FLAG_ITALIC: c_int = 1 << 0
pub const FT_STYLE_FLAG_BOLD: c_int = 1 << 1

// The metrics of a size: its pixels per em, the scales from font units
// to 26.6 pixels (16.16), and the face's global metrics at that size.
pub const FT_Size_Metrics_ = struct {
    x_ppem: FT_UShort
    y_ppem: FT_UShort
    x_scale: FT_Fixed
    y_scale: FT_Fixed
    ascender: FT_Pos
    descender: FT_Pos
    height: FT_Pos
    max_advance: FT_Pos
}
pub const FT_Size_Metrics = FT_Size_Metrics_

pub const FT_SizeRec_ = struct {
    face: FT_Face
    generic: FT_Generic
    metrics: FT_Size_Metrics
    internal: FT_Size_Internal
}
pub const FT_SizeRec = FT_SizeRec_

// The glyph slot of a face: the glyph loaded last, its metrics (26.6),
// its advances, and its image (an outline, or a bitmap with its offset).
pub const FT_GlyphSlotRec_ = struct {
    library: FT_Library
    face: FT_Face
    next: FT_GlyphSlot
    glyph_index: FT_UInt
    generic: FT_Generic
    metrics: FT_Glyph_Metrics
    linearHoriAdvance: FT_Fixed
    linearVertAdvance: FT_Fixed
    advance: ftimage.FT_Vector
    format: ftimage.FT_Glyph_Format
    bitmap: ftimage.FT_Bitmap
    bitmap_left: FT_Int
    bitmap_top: FT_Int
    outline: ftimage.FT_Outline
    num_subglyphs: FT_UInt
    subglyphs: FT_SubGlyph
    control_data: *anyopaque
    control_len: c_long
    lsb_delta: FT_Pos
    rsb_delta: FT_Pos
    other: *anyopaque
    internal: FT_Slot_Internal
}
pub const FT_GlyphSlotRec = FT_GlyphSlotRec_

// A library on the C library's allocator, with every module.
pub extern("c") fn FT_Init_FreeType(alibrary: *FT_Library) -> FT_Error
// Done with the library and every face it has open.
pub extern("c") fn FT_Done_FreeType(library: FT_Library) -> FT_Error

pub const FT_OPEN_MEMORY: c_int = 0x1
pub const FT_OPEN_STREAM: c_int = 0x2
pub const FT_OPEN_PATHNAME: c_int = 0x4
pub const FT_OPEN_DRIVER: c_int = 0x8
pub const FT_OPEN_PARAMS: c_int = 0x10
pub const ft_open_memory: c_int = 0x1
pub const ft_open_stream: c_int = 0x2
pub const ft_open_pathname: c_int = 0x4
pub const ft_open_driver: c_int = 0x8
pub const ft_open_params: c_int = 0x10

pub const FT_Parameter_ = struct {
    tag: FT_ULong
    data: fttypes.FT_Pointer
}
pub const FT_Parameter = FT_Parameter_

// Where a face comes from: memory, a stream or a path (`flags`).
pub const FT_Open_Args_ = struct {
    flags: FT_UInt
    memory_base: *const fttypes.FT_Byte
    memory_size: FT_Long
    pathname: *FT_String
    stream: ftsystem.FT_Stream
    driver: FT_Module
    num_params: FT_Int
    params: *FT_Parameter
}
pub const FT_Open_Args = FT_Open_Args_

pub extern("c") fn FT_New_Face(library: FT_Library, filepathname: *const c_char, face_index: FT_Long, aface: *FT_Face) -> FT_Error
pub extern("c") fn FT_New_Memory_Face(library: FT_Library, file_base: *const fttypes.FT_Byte, file_size: FT_Long, face_index: FT_Long, aface: *FT_Face) -> FT_Error
// A face of the font `args` names; with `face_index` -1, only the number
// of faces the file has (in `num_faces`). The upper 16 bits of
// `face_index` choose a named instance of a variable font (1 the first).
pub extern("c") fn FT_Open_Face(library: FT_Library, args: *const FT_Open_Args, face_index: FT_Long, aface: *FT_Face) -> FT_Error
pub extern("c") fn FT_Attach_File(face: FT_Face, filepathname: *const c_char) -> FT_Error
pub extern("c") fn FT_Attach_Stream(face: FT_Face, parameters: *const FT_Open_Args) -> FT_Error
pub extern("c") fn FT_Reference_Face(face: FT_Face) -> FT_Error
pub extern("c") fn FT_Done_Face(face: FT_Face) -> FT_Error
pub extern("c") fn FT_Select_Size(face: FT_Face, strike_index: FT_Int) -> FT_Error

pub const FT_Size_Request_Type_ = enum(c_int) {
    FT_SIZE_REQUEST_TYPE_NOMINAL = 0,
    FT_SIZE_REQUEST_TYPE_REAL_DIM = 1,
    FT_SIZE_REQUEST_TYPE_BBOX = 2,
    FT_SIZE_REQUEST_TYPE_CELL = 3,
    FT_SIZE_REQUEST_TYPE_SCALES = 4,
