pub fn FT_LOAD_TARGET_(x: anytype) -> integertypes.FT_Int32 { return @intCast(integertypes.FT_Int32, x & 15) << 16 }
pub const FT_LOAD_TARGET_NORMAL: c_int = 0 << 16
pub const FT_LOAD_TARGET_LIGHT: c_int = 1 << 16
pub const FT_LOAD_TARGET_MONO: c_int = 2 << 16
pub const FT_LOAD_TARGET_LCD: c_int = 3 << 16
pub const FT_LOAD_TARGET_LCD_V: c_int = 4 << 16
pub fn FT_LOAD_TARGET_MODE(x: anytype) -> FT_Render_Mode { return @intCast(FT_Render_Mode, (x >> 16) & 15) }

// The transform applied to every glyph loaded (scaled and outline ones):
// `matrix` (NULL for none), then `delta` (26.6; NULL for none).
pub extern("c") fn FT_Set_Transform(face: FT_Face, matrix: *fttypes.FT_Matrix, delta: *ftimage.FT_Vector) -> void
pub extern("c") fn FT_Get_Transform(face: FT_Face, matrix: *fttypes.FT_Matrix, delta: *ftimage.FT_Vector) -> void

pub const FT_Render_Mode_ = enum(c_int) {
    FT_RENDER_MODE_NORMAL = 0,
    FT_RENDER_MODE_LIGHT = 1,
    FT_RENDER_MODE_MONO = 2,
    FT_RENDER_MODE_LCD = 3,
    FT_RENDER_MODE_LCD_V = 4,
    FT_RENDER_MODE_SDF = 5,
    FT_RENDER_MODE_MAX = 6,
}
pub const FT_Render_Mode = FT_Render_Mode_

pub const ft_render_mode_normal: c_int = 0
pub const ft_render_mode_mono: c_int = 2

// The outline in the glyph slot as a bitmap: 256 levels of gray (NORMAL,
// LIGHT), one bit a pixel (MONO), three gray levels a pixel (LCD, LCD_V).
pub extern("c") fn FT_Render_Glyph(slot: FT_GlyphSlot, render_mode: FT_Render_Mode) -> FT_Error

