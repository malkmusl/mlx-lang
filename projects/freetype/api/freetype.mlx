// freetype/freetype.h
// mlx-freetype: FreeType's C API (2.13) for the C and C++ programs built
// here, implemented in Mlx by libmlxfreetype.so (projects/freetype). A
// library (FT_Library) opens faces (FT_Face) of font files: TrueType and
// OpenType (glyf and CFF/CFF2 outlines), collections of them, variable
// fonts, color layers and embedded bitmaps. A face has sizes, charmaps
// and a glyph slot, into which a glyph is loaded as an outline or a
// bitmap and rendered.
const c_function_pointers = true
const c_keyword_names = true
const ft2build = @import("./ft2build.mlx")
const ftconfig = @import("./ftconfig.mlx")
const fttypes = @import("./fttypes.mlx")
const fterrors = @import("./fterrors.mlx")
const ftsystem = @import("./ftsystem.mlx")
const ftimage = @import("./ftimage.mlx")
const integertypes = @import("./integertypes.mlx")

const FT_Pos = ftimage.FT_Pos
const FT_Long = fttypes.FT_Long
const FT_ULong = fttypes.FT_ULong
const FT_Int = fttypes.FT_Int
const FT_UInt = fttypes.FT_UInt
const FT_Short = fttypes.FT_Short
const FT_UShort = fttypes.FT_UShort
const FT_Fixed = fttypes.FT_Fixed
const FT_Error = fttypes.FT_Error
const FT_String = fttypes.FT_String
const FT_Generic = fttypes.FT_Generic

pub const FT_Glyph_Metrics_ = struct {
    width: FT_Pos
    height: FT_Pos
    horiBearingX: FT_Pos
    horiBearingY: FT_Pos
    horiAdvance: FT_Pos
    vertBearingX: FT_Pos
    vertBearingY: FT_Pos
    vertAdvance: FT_Pos
}
pub const FT_Glyph_Metrics = FT_Glyph_Metrics_

// A strike of embedded bitmaps.
pub const FT_Bitmap_Size_ = struct {
    height: FT_Short
    width: FT_Short
    size: FT_Pos
    x_ppem: FT_Pos
    y_ppem: FT_Pos
}
pub const FT_Bitmap_Size = FT_Bitmap_Size_

