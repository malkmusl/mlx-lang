// freetype/ftimage.h
// mlx-freetype: the images of glyphs: outlines (points in 26.6 fixed
// point, their tags and the ends of their contours), bitmaps and the
// spans of the anti-aliasing rasterizer.
const c_function_pointers = true
const c_system_headers = "limits.h"

// A coordinate, in 26.6 fixed point for scaled outlines (font units for
// unscaled ones).
pub const FT_Pos = c_long

pub const FT_Vector_ = struct {
    x: FT_Pos
    y: FT_Pos
}
pub const FT_Vector = FT_Vector_

pub const FT_BBox_ = struct {
    xMin: FT_Pos
    yMin: FT_Pos
    xMax: FT_Pos
    yMax: FT_Pos
}
pub const FT_BBox = FT_BBox_

pub const FT_Pixel_Mode_ = enum(c_int) {
    FT_PIXEL_MODE_NONE = 0,
    FT_PIXEL_MODE_MONO = 1,
    FT_PIXEL_MODE_GRAY = 2,
    FT_PIXEL_MODE_GRAY2 = 3,
    FT_PIXEL_MODE_GRAY4 = 4,
    FT_PIXEL_MODE_LCD = 5,
    FT_PIXEL_MODE_LCD_V = 6,
    FT_PIXEL_MODE_BGRA = 7,
    FT_PIXEL_MODE_MAX = 8,
}
pub const FT_Pixel_Mode = FT_Pixel_Mode_

pub const ft_pixel_mode_none: c_int = 0
pub const ft_pixel_mode_mono: c_int = 1
pub const ft_pixel_mode_grays: c_int = 2
pub const ft_pixel_mode_pal2: c_int = 3
pub const ft_pixel_mode_pal4: c_int = 4

// A bitmap: `rows` lines of `width` pixels, `pitch` bytes from one line
// to the next (negative when the first line is the bottom one).
pub const FT_Bitmap_ = struct {
    rows: c_uint
    width: c_uint
    pitch: c_int
    buffer: *c_uchar
    num_grays: c_ushort
    pixel_mode: c_uchar
    palette_mode: c_uchar
    palette: *anyopaque
}
pub const FT_Bitmap = FT_Bitmap_

// An outline: `n_points` points with a tag each (on the curve, a
// quadratic or a cubic control point), in `n_contours` contours, each
// ending at its point of `contours`.
pub const FT_Outline_ = struct {
    n_contours: c_short
    n_points: c_short
    points: *FT_Vector
    tags: *c_char
    contours: *c_short
    flags: c_int
}
pub const FT_Outline = FT_Outline_

pub const FT_OUTLINE_CONTOURS_MAX: c_int = 32767
pub const FT_OUTLINE_POINTS_MAX: c_int = 32767

pub const FT_OUTLINE_NONE: c_int = 0x0
pub const FT_OUTLINE_OWNER: c_int = 0x1
pub const FT_OUTLINE_EVEN_ODD_FILL: c_int = 0x2
pub const FT_OUTLINE_REVERSE_FILL: c_int = 0x4
pub const FT_OUTLINE_IGNORE_DROPOUTS: c_int = 0x8
pub const FT_OUTLINE_SMART_DROPOUTS: c_int = 0x10
pub const FT_OUTLINE_INCLUDE_STUBS: c_int = 0x20
pub const FT_OUTLINE_OVERLAP: c_int = 0x40
pub const FT_OUTLINE_HIGH_PRECISION: c_int = 0x100
pub const FT_OUTLINE_SINGLE_PASS: c_int = 0x200

pub const ft_outline_none: c_int = 0x0
pub const ft_outline_owner: c_int = 0x1
pub const ft_outline_even_odd_fill: c_int = 0x2
pub const ft_outline_reverse_fill: c_int = 0x4
pub const ft_outline_ignore_dropouts: c_int = 0x8
pub const ft_outline_high_precision: c_int = 0x100
pub const ft_outline_single_pass: c_int = 0x200

pub fn FT_CURVE_TAG(flag: anytype) -> c_int { return flag & 3 }

pub const FT_CURVE_TAG_ON: c_int = 0x01
pub const FT_CURVE_TAG_CONIC: c_int = 0x00
pub const FT_CURVE_TAG_CUBIC: c_int = 0x02
pub const FT_CURVE_TAG_HAS_SCANMODE: c_int = 0x04
pub const FT_CURVE_TAG_TOUCH_X: c_int = 0x08
pub const FT_CURVE_TAG_TOUCH_Y: c_int = 0x10
pub const FT_CURVE_TAG_TOUCH_BOTH: c_int = 0x18

pub const FT_Curve_Tag_On: c_int = 0x01
pub const FT_Curve_Tag_Conic: c_int = 0x00
pub const FT_Curve_Tag_Cubic: c_int = 0x02
pub const FT_Curve_Tag_Touch_X: c_int = 0x08
pub const FT_Curve_Tag_Touch_Y: c_int = 0x10

// What FT_Outline_Decompose calls for each part of an outline; a result
// other than 0 stops it and is its result.
pub const FT_Outline_MoveToFunc = fn(to: *const FT_Vector, user: *anyopaque) -> c_int
pub const FT_Outline_LineToFunc = fn(to: *const FT_Vector, user: *anyopaque) -> c_int
pub const FT_Outline_ConicToFunc = fn(control: *const FT_Vector, to: *const FT_Vector, user: *anyopaque) -> c_int
pub const FT_Outline_CubicToFunc = fn(control1: *const FT_Vector, control2: *const FT_Vector, to: *const FT_Vector, user: *anyopaque) -> c_int
pub const FT_Outline_MoveTo_Func = FT_Outline_MoveToFunc
pub const FT_Outline_LineTo_Func = FT_Outline_LineToFunc
pub const FT_Outline_ConicTo_Func = FT_Outline_ConicToFunc
pub const FT_Outline_CubicTo_Func = FT_Outline_CubicToFunc

// The functions, and the points transformed as `(x << shift) - delta`.
pub const FT_Outline_Funcs_ = struct {
    move_to: FT_Outline_MoveToFunc
    line_to: FT_Outline_LineToFunc
    conic_to: FT_Outline_ConicToFunc
    cubic_to: FT_Outline_CubicToFunc
    shift: c_int
    delta: FT_Pos
}
pub const FT_Outline_Funcs = FT_Outline_Funcs_

pub const FT_Glyph_Format_ = enum(c_int) {
    FT_GLYPH_FORMAT_NONE = 0,
    FT_GLYPH_FORMAT_COMPOSITE = 1668246896,
    FT_GLYPH_FORMAT_BITMAP = 1651078259,
    FT_GLYPH_FORMAT_OUTLINE = 1869968492,
    FT_GLYPH_FORMAT_PLOTTER = 1886154612,
    FT_GLYPH_FORMAT_SVG = 1398163232,
}
pub const FT_Glyph_Format = FT_Glyph_Format_

pub const ft_glyph_format_none: c_int = 0
pub const ft_glyph_format_composite: c_int = 1668246896
pub const ft_glyph_format_bitmap: c_int = 1651078259
pub const ft_glyph_format_outline: c_int = 1869968492
pub const ft_glyph_format_plotter: c_int = 1886154612

// A run of `len` pixels from `x` of one coverage, on a line of the
// anti-aliasing rasterizer's direct rendering.
pub const FT_Span_ = struct {
    x: c_short
    len: c_ushort
    coverage: c_uchar
}
pub const FT_Span = FT_Span_

pub const FT_SpanFunc = fn(y: c_int, count: c_int, spans: *const FT_Span, user: *anyopaque) -> void
pub const FT_Raster_Span_Func = FT_SpanFunc
pub const FT_Raster_BitTest_Func = fn(y: c_int, x: c_int, user: *anyopaque) -> c_int
pub const FT_Raster_BitSet_Func = fn(y: c_int, x: c_int, user: *anyopaque) -> void

pub const FT_RASTER_FLAG_DEFAULT: c_int = 0x0
pub const FT_RASTER_FLAG_AA: c_int = 0x1
pub const FT_RASTER_FLAG_DIRECT: c_int = 0x2
pub const FT_RASTER_FLAG_CLIP: c_int = 0x4
pub const FT_RASTER_FLAG_SDF: c_int = 0x8
pub const ft_raster_flag_default: c_int = 0x0
pub const ft_raster_flag_aa: c_int = 0x1
pub const ft_raster_flag_direct: c_int = 0x2
pub const ft_raster_flag_clip: c_int = 0x4

pub const FT_Raster_Params_ = struct {
    target: *const FT_Bitmap
    source: *const anyopaque
    flags: c_int
    gray_spans: FT_SpanFunc
    black_spans: FT_SpanFunc
    bit_test: FT_Raster_BitTest_Func
    bit_set: FT_Raster_BitSet_Func
    user: *anyopaque
    clip_box: FT_BBox
}
pub const FT_Raster_Params = FT_Raster_Params_

pub const FT_RasterRec_ = struct {}
pub const FT_Raster = *FT_RasterRec_
