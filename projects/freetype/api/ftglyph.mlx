// freetype/ftglyph.h
// mlx-freetype: glyph images apart from the glyph slot: an outline or a
// bitmap copied out of it, transformed, measured and rendered.
const freetype = @import("./freetype.mlx")

const FT_Library = freetype.FT_Library
const FT_Error = fttypes.FT_Error
const FT_Vector = ftimage.FT_Vector
const FT_Matrix = fttypes.FT_Matrix

pub const FT_Glyph_Class_ = struct {}
pub const FT_Glyph_Class = FT_Glyph_Class_
pub const FT_Glyph = *FT_GlyphRec_

pub const FT_GlyphRec_ = struct {
    library: FT_Library
    clazz: *const FT_Glyph_Class
    format: ftimage.FT_Glyph_Format
    advance: FT_Vector
}
pub const FT_GlyphRec = FT_GlyphRec_

pub const FT_BitmapGlyph = *FT_BitmapGlyphRec_
pub const FT_BitmapGlyphRec_ = struct {
    root: FT_GlyphRec
    left: fttypes.FT_Int
    top: fttypes.FT_Int
    bitmap: ftimage.FT_Bitmap
}
pub const FT_BitmapGlyphRec = FT_BitmapGlyphRec_

pub const FT_OutlineGlyph = *FT_OutlineGlyphRec_
pub const FT_OutlineGlyphRec_ = struct {
    root: FT_GlyphRec
    outline: ftimage.FT_Outline
}
pub const FT_OutlineGlyphRec = FT_OutlineGlyphRec_

pub const FT_SvgGlyph = *FT_SvgGlyphRec_
pub const FT_SvgGlyphRec_ = struct {
    root: FT_GlyphRec
    svg_document: *fttypes.FT_Byte
    svg_document_length: fttypes.FT_ULong
    glyph_index: fttypes.FT_UInt
    metrics: freetype.FT_Size_Metrics
    units_per_EM: fttypes.FT_UShort
    start_glyph_id: fttypes.FT_UShort
    end_glyph_id: fttypes.FT_UShort
    transform: FT_Matrix
    delta: FT_Vector
}
pub const FT_SvgGlyphRec = FT_SvgGlyphRec_

pub extern("c") fn FT_New_Glyph(library: FT_Library, format: ftimage.FT_Glyph_Format, aglyph: *FT_Glyph) -> FT_Error
// A copy of the slot's glyph image (an outline or a bitmap glyph).
pub extern("c") fn FT_Get_Glyph(slot: freetype.FT_GlyphSlot, aglyph: *FT_Glyph) -> FT_Error
pub extern("c") fn FT_Glyph_Copy(source: FT_Glyph, target: *FT_Glyph) -> FT_Error
pub extern("c") fn FT_Glyph_Transform(glyph: FT_Glyph, matrix: *const FT_Matrix, delta: *const FT_Vector) -> FT_Error

pub const FT_Glyph_BBox_Mode_ = enum(c_int) {
    FT_GLYPH_BBOX_UNSCALED = 0,
    FT_GLYPH_BBOX_SUBPIXELS = 0,
    FT_GLYPH_BBOX_GRIDFIT = 1,
    FT_GLYPH_BBOX_TRUNCATE = 2,
    FT_GLYPH_BBOX_PIXELS = 3,
}
pub const FT_Glyph_BBox_Mode = FT_Glyph_BBox_Mode_

pub const ft_glyph_bbox_unscaled: c_int = 0
pub const ft_glyph_bbox_subpixels: c_int = 0
pub const ft_glyph_bbox_gridfit: c_int = 1
pub const ft_glyph_bbox_truncate: c_int = 2
pub const ft_glyph_bbox_pixels: c_int = 3

pub extern("c") fn FT_Glyph_Get_CBox(glyph: FT_Glyph, bbox_mode: fttypes.FT_UInt, acbox: *ftimage.FT_BBox) -> void
pub extern("c") fn FT_Glyph_To_Bitmap(the_glyph: *FT_Glyph, render_mode: freetype.FT_Render_Mode, origin: *const FT_Vector, destroy: fttypes.FT_Bool) -> FT_Error
pub extern("c") fn FT_Done_Glyph(glyph: FT_Glyph) -> void
pub extern("c") fn FT_Matrix_Multiply(a: *const FT_Matrix, b: *FT_Matrix) -> void
pub extern("c") fn FT_Matrix_Invert(matrix: *FT_Matrix) -> FT_Error
