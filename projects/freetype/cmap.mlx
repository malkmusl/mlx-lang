// Character maps: the subtables of a font's `cmap` (formats 0, 2, 4, 6,
// 8, 10, 12, 13 and 14) as FreeType reads them: each is checked as its
// default validation level checks it (a broken one is left out), and
// looked up and walked as FreeType does, segments that overlap or are
// out of order in format 4 too. A CFF font's encoding is a charmap of
// its own (cff.mlx).
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")

const CharMap = o.CharMap

pub const FLAG_UNSORTED: i64 = 1
pub const FLAG_OVERLAPPING: i64 = 2

// The size of a charmap's record.
pub const CHARMAP_SIZE: usize = @sizeOf(CharMap)

fn be16(p: usize) -> u64 { return @intCast(u64, m.u16be(p)) }
fn sbe16(p: usize) -> i64 { return @intCast(i64, m.i16be(p)) }
fn be32(p: usize) -> u64 { return @intCast(u64, m.u32be(p)) }
fn be24(p: usize) -> u64 { return @intCast(u64, m.u24be(p)) }

// ---------------------------------------------------------------------------
// Validation (FreeType's FT_VALIDATE_DEFAULT level): an error code (0
// valid, -1 broken), the flags of format 4.

fn validate(format: u64, table: usize, limit: usize) -> i64 {
    if format == 0 {
        if table + 4 > limit { return -1 }
        const length = be16(table + 2)
        if table + length > limit || length < 262 { return -1 }
        return 0
    }
    if format == 2 {
        if table + 4 > limit { return -1 }
        const length = be16(table + 2)
        if table + length > limit || length < 6 + 512 { return -1 }
        var maxSubs: u64 = 0
        var n: usize = 0
        while n < 256 {
            const idx = be16(table + 6 + n * 2) >> 3
            if idx > maxSubs { maxSubs = idx }
            n += 1
        }
        const subs = table + 518
        const glyphIds = subs + (maxSubs + 1) * 8
        if glyphIds > limit { return -1 }
        var i: u64 = 0
        while i <= maxSubs {
            const sub = subs + i * 8
            const codeCount = be16(sub + 2)
            const offset = be16(sub + 6)
            if codeCount != 0 && offset != 0 {
                const ids = sub + 6 + offset
                if ids < glyphIds || ids + codeCount * 2 > table + length { return -1 }
            }
            i += 1
        }
        return 0
    }
    if format == 4 {
        if table + 4 > limit { return -1 }
        var length = be16(table + 2)
        if table + length > limit { length = limit - table }
        if length < limit - table { length = limit - table }
        if length < 16 { return -1 }
        const numSegs = be16(table + 6) / 2
        if length < 16 + numSegs * 2 * 4 { return -1 }
        const ends = table + 14
        const starts = table + 16 + numSegs * 2
        const deltas = starts + numSegs * 2
        const offsets = deltas + numSegs * 2
        const glyphIds = offsets + numSegs * 2
        var flags: i64 = 0
        var lastStart: u64 = 0
        var lastEnd: u64 = 0
        var n: u64 = 0
        while n < numSegs {
            const start = be16(starts + n * 2)
            const end = be16(ends + n * 2)
            const offset = be16(offsets + n * 2)
            if start > end { return -1 }
            if start <= lastEnd && n > 0 {
                if lastStart > start || lastEnd > end { flags |= FLAG_UNSORTED } else { flags |= FLAG_OVERLAPPING }
            }
            if offset != 0 && offset != 0xFFFF {
                if n != numSegs - 1 || !(start == 0xFFFF && end == 0xFFFF) {
                    const p = offsets + n * 2 + offset
                    if p < glyphIds || p + (end - start + 1) * 2 > limit { return -1 }
                }
            } else if offset == 0xFFFF {
                if n != numSegs - 1 || !(start == 0xFFFF && end == 0xFFFF) { return -1 }
            }
            lastStart = start
            lastEnd = end
            n += 1
        }
        return flags
    }
    if format == 6 {
        if table + 10 > limit { return -1 }
        const length = be16(table + 2)
        const count = be16(table + 8)
        if table + length > limit || length < 10 + count * 2 { return -1 }
        return 0
    }
    if format == 8 {
        if table + 16 + 8192 > limit { return -1 }
        const length = be32(table + 4)
        if length > limit - table || length < 8192 + 16 { return -1 }
        var p = table + 12 + 8192
        const numGroups = be32(p)
        p += 4
        if numGroups > (limit - p) / 12 { return -1 }
        var last: u64 = 0
        var n: u64 = 0
        while n < numGroups {
            const start = be32(p)
            const end = be32(p + 4)
            p += 12
            if start > end { return -1 }
            if n > 0 && start <= last { return -1 }
            last = end
            n += 1
        }
        return 0
    }
    if format == 10 {
        if table + 20 > limit { return -1 }
        const length = be32(table + 4)
        const count = be32(table + 16)
        if length > limit - table || length < 20 || (length - 20) / 2 < count { return -1 }
        return 0
    }
    if format == 12 || format == 13 {
        if table + 16 > limit { return -1 }
        const length = be32(table + 4)
        const numGroups = be32(table + 12)
        if length > limit - table || length < 16 || (length - 16) / 12 < numGroups { return -1 }
        var p = table + 16
        var last: u64 = 0
        var n: u64 = 0
        while n < numGroups {
            const start = be32(p)
            const end = be32(p + 4)
            p += 12
            if start > end { return -1 }
            if n > 0 && start <= last { return -1 }
            last = end
            n += 1
        }
        return 0
    }
    if format == 14 {
        if table + 10 > limit { return -1 }
        const length = be32(table + 2)
        const numSelectors = be32(table + 6)
        if length > limit - table || length < 10 || (length - 10) / 11 < numSelectors { return -1 }
        var p = table + 10
        var lastVarSel: u64 = 1
        var n: u64 = 0
        while n < numSelectors {
            const varSel = be24(p)
            const defOff = be32(p + 3)
            const nondefOff = be32(p + 7)
            p += 11
            if defOff >= length || nondefOff >= length { return -1 }
            if varSel < lastVarSel { return -1 }
            lastVarSel = varSel + 1
            if defOff != 0 {
                var defp = table + defOff
                if defp + 4 > limit { return -1 }
                const numRanges = be32(defp)
                defp += 4
                if numRanges > (limit - defp) / 4 { return -1 }
                var lastBase: u64 = 0
                var i: u64 = 0
                while i < numRanges {
                    const base = be24(defp)
                    const cnt = @intCast(u64, m.get8(defp + 3))
                    defp += 4
                    if base + cnt >= 0x110000 { return -1 }
                    if base < lastBase { return -1 }
                    lastBase = base + cnt + 1
                    i += 1
                }
            }
            if nondefOff != 0 {
                var ndp = table + nondefOff
                if ndp + 4 > limit { return -1 }
                const numMappings = be32(ndp)
                ndp += 4
                if numMappings > (limit - ndp) / 5 { return -1 }
                var lastUni: u64 = 0
                var i: u64 = 0
                while i < numMappings {
                    const uni = be24(ndp)
                    ndp += 5
                    if uni >= 0x110000 { return -1 }
                    if uni < lastUni { return -1 }
                    lastUni = uni + 1
                    i += 1
                }
            }
            n += 1
        }
        return 0
    }
    return -2
}

// The encoding of a charmap of platform and encoding IDs.
pub fn encodingOf(platform: i64, encoding: i64) -> u32 {
    if platform == 2 || platform == 0 { return r.ENCODING_UNICODE }
    if platform == 1 && encoding == 0 { return r.ENCODING_APPLE_ROMAN }
    if platform == 3 {
        return match encoding {
            0 => r.ENCODING_MS_SYMBOL
            10 => r.ENCODING_UNICODE
            1 => r.ENCODING_UNICODE
            2 => r.ENCODING_SJIS
            3 => r.ENCODING_PRC
            4 => r.ENCODING_BIG5
            5 => r.ENCODING_WANSUNG
            6 => r.ENCODING_JOHAB
            else => r.ENCODING_NONE
        }
    }
    return r.ENCODING_NONE
}

// Adds a charmap to the face (FreeType's FT_CMap_New): its record.
pub fn addCharmap(face: usize, platform: i64, encoding: i64, format: i64, table: usize) -> usize {
    const root = r.faceRec(face)
    const memory = root.*.memory
    const cmap = m.alloc(memory, CHARMAP_SIZE)
    if cmap == 0 { return 0 }
    const c = o.charMap(cmap)
    c.*.face = face
    c.*.platform_id = @intCast(u16, platform)
    c.*.encoding_id = @intCast(u16, encoding)
    c.*.encoding = r.ENCODING_NONE
    c.*.format = format
    c.*.table = table
    if format == 4 {
        c.*.numRanges = be16(table + 6) >> 1
        c.*.curCharcode = 0xFFFFFFFF
        c.*.curGindex = 0
    }
    if format == 12 || format == 13 {
        c.*.numRanges = be32(table + 12)
        c.*.valid = false
    }
    const count = @intCast(usize, root.*.num_charmaps)
    const grown = m.grow(memory, root.*.charmaps, count * 8, (count + 1) * 8)
    if grown == 0 {
        m.release(memory, cmap)
        return 0
    }
    root.*.charmaps = grown
    m.putWord(grown + count * 8, cmap)
    root.*.num_charmaps += 1
    return cmap
}

// The charmaps of the font's `cmap` (FreeType's tt_face_build_cmaps).
pub fn buildCharmaps(face: usize) -> void {
    const f = o.faceRecord(face)
    if f.*.cmapSize < 4 { return }
    const table = f.*.data + f.*.cmapOffset
    const limit = table + f.*.cmapSize
    var p = table + 2
    var numCmaps = be16(p)
    p += 2
    while numCmaps > 0 && p + 8 <= limit {
        const platform = @intCast(i64, be16(p))
        const encoding = @intCast(i64, be16(p + 2))
        const offset = be32(p + 4)
        p += 8
        numCmaps -= 1
        if offset != 0 && offset <= f.*.cmapSize - 2 {
            const sub = table + offset
            const format = be16(sub)
            const valid = validate(format, sub, limit)
            if valid >= 0 {
                const cmap = addCharmap(face, platform, encoding, @intCast(i64, format), sub)
                if cmap != 0 { o.charMap(cmap).*.flags = valid }
            }
        }
    }
}

// The format of a charmap (-1 for one that is not of `cmap`) and its
// language.
pub fn format(cmap: usize) -> i64 {
    const c = o.charMap(cmap)
    if c.*.kind != 0 { return -1 }
    return c.*.format
}

pub fn language(cmap: usize) -> u64 {
    const c = o.charMap(cmap)
    if c.*.kind != 0 { return 0xFFFFFFFF }
    const f = c.*.format
    if f == 0 || f == 2 || f == 4 || f == 6 { return be16(c.*.table + 4) }
    if f == 8 || f == 10 || f == 12 || f == 13 { return be32(c.*.table + 8) }
    return 0xFFFFFFFF
}

// ---------------------------------------------------------------------------
// Lookups.

fn numGlyphs(c: *CharMap) -> u64 { return @intCast(u64, r.faceRec(c.*.face).*.num_glyphs) }

fn cmapLimit(c: *CharMap) -> usize {
    const f = o.faceRecord(c.*.face)
    return f.*.data + f.*.cmapOffset + f.*.cmapSize
}

// The glyph of character `code` (0 when none), as the subtable gives it.
pub fn charIndex(cmap: usize, code: u64) -> u64 {
    const c = o.charMap(cmap)
    const table = c.*.table
    const format = c.*.format
    if format == 0 {
        if code < 256 { return @intCast(u64, m.get8(table + 6 + code)) }
        return 0
    }
    if format == 2 { return cmap2Index(table, code) }
    if format == 4 {
        if code >= 0x10000 { return 0 }
        if (c.*.flags & FLAG_UNSORTED) != 0 { return cmap4Linear(c, code, false).0 }
        return cmap4Binary(c, code, false).0
    }
    if format == 6 {
        const start = be16(table + 6)
        const count = be16(table + 8)
        const idx = (code -% start) & 0xFFFFFFFF
        if idx < count { return be16(table + 10 + 2 * idx) }
        return 0
    }
    if format == 8 {
        var p = table + 8204
        var numGroups = be32(p)
        p += 4
        while numGroups > 0 {
            const start = be32(p)
            const end = be32(p + 4)
            const startId = be32(p + 8)
            p += 12
            numGroups -= 1
            if code < start { break }
            if code <= end {
                if startId > 0xFFFFFFFF - (code - start) { return 0 }
                return (startId + (code - start)) & 0xFFFFFFFF
            }
        }
        return 0
    }
    if format == 10 {
        const start = be32(table + 12)
        const count = be32(table + 16)
        if code < start { return 0 }
        const idx = code - start
        if idx < count { return be16(table + 20 + 2 * idx) }
        return 0
    }
    if format == 12 { return cmap12Binary(c, code, false).0 }
    if format == 13 { return cmap13Binary(c, code, false).0 }
    return 0
}

fn cmap2Subheader(table: usize, code: u64) -> usize {
    if code >= 0x10000 { return 0 }
    const lo = code & 0xFF
    const hi = code >> 8
    const subs = table + 518
    if hi == 0 {
        if be16(table + 6 + lo * 2) != 0 { return 0 }
        return subs
    }
    const sub = subs + (be16(table + 6 + hi * 2) & 0xFFF8)
    if sub == subs { return 0 }
    return sub
}

fn cmap2Index(table: usize, code: u64) -> u64 {
    const sub = cmap2Subheader(table, code)
    if sub == 0 { return 0 }
    const start = be16(sub)
    const count = be16(sub + 2)
    const delta = sbe16(sub + 4)
    const offset = be16(sub + 6)
    const idx = ((code & 0xFF) -% start) & 0xFFFFFFFF
    if idx < count && offset != 0 {
        const g = be16(sub + 6 + offset + 2 * idx)
        if g != 0 { return @intCast(u64, (@intCast(i64, g) + delta) & 0xFFFF) }
    }
    return 0
}

fn cmap2Next(table: usize, from: u64) -> (u64, u64) {
    var code = from + 1
    while code < 0x10000 {
        const sub = cmap2Subheader(table, code)
        if sub != 0 {
            const start = be16(sub)
            const count = be16(sub + 2)
            const delta = sbe16(sub + 4)
            const offset = be16(sub + 6)
            var lo = code & 0xFF
            if lo >= start + count && code <= 0xFF {
                code = 0x100
                continue
            }
            if offset == 0 {
                if code == 0x100 { return -> (0, 0) }
            } else {
                var pos: u64 = 0
                if lo < start {
                    lo = start
                    pos = 0
                } else {
                    pos = lo - start
                }
                var p = sub + 6 + offset + pos * 2
                code = (code & 0xFFFFFF00) + lo
                while pos < count {
                    const idx = be16(p)
                    p += 2
                    if idx != 0 {
                        const g = @intCast(u64, (@intCast(i64, idx) + delta) & 0xFFFF)
                        if g != 0 { return -> (code, g) }
                    }
                    pos += 1
                    code += 1
                }
                if count != 0 { code -= 1 }
            }
        }
        if code <= 0xFF {
            code += 1
        } else {
            code = (code & 0xFFFFFF00) + 0x100
        }
    }
    return -> (0, 0)
}

// Format 4: sets the walk's range to the first usable one from `index`;
// false when there is none.
fn cmap4SetRange(c: *CharMap, rangeIndex: u64) -> bool {
    const table = c.*.table
    const numRanges = c.*.numRanges
    var index = rangeIndex
    while index < numRanges {
        var p = table + 14 + index * 2
        c.*.curEnd = be16(p)
        p += 2 + numRanges * 2
        c.*.curStart = be16(p)
        p += numRanges * 2
        c.*.curDelta = sbe16(p)
        p += numRanges * 2
        var offset = be16(p)
        if index >= numRanges - 1 && c.*.curStart == 0xFFFF && c.*.curEnd == 0xFFFF {
            if offset != 0 && p + offset + 2 > cmapLimit(c) {
                c.*.curDelta = 1
                offset = 0
            }
        }
        if offset != 0xFFFF {
            c.*.curValues = if offset != 0 { p + offset } else { 0 }
            c.*.curRange = index
            return true
        }
        index += 1
    }
    return false
}

fn cmap4Next(c: *CharMap) -> void {
    const limit = cmapLimit(c)
    var charcode = (c.*.curCharcode + 1) & 0xFFFFFFFF
    if charcode < c.*.curStart { charcode = c.*.curStart }
    while true {
        const values = c.*.curValues
        const end = c.*.curEnd
        const delta = c.*.curDelta
        var nextSegment = false
        if charcode <= end {
            if values != 0 {
                var p = values + 2 * (charcode - c.*.curStart)
                if p > limit {
                    nextSegment = true
                } else {
                    while true {
                        var g = be16(p)
                        p += 2
                        if g != 0 {
                            g = @intCast(u64, (@intCast(i64, g) + delta) & 0xFFFF)
                            if g != 0 {
                                c.*.curCharcode = charcode
                                c.*.curGindex = g
                                return
                            }
                        }
                        charcode += 1
                        if charcode > end { break }
                    }
                }
            } else {
                while true {
                    var g = @intCast(u64, (@intCast(i64, charcode) + delta) & 0xFFFF)
                    if g >= numGlyphs(c) {
                        g = 0
                        if @intCast(i64, charcode) + delta < 0 && @intCast(i64, end) + delta >= 0 {
                            charcode = @intCast(u64, 0 - delta)
                        } else if @intCast(i64, charcode) + delta < 0x10000 && @intCast(i64, end) + delta >= 0x10000 {
                            charcode = @intCast(u64, 0x10000 - delta)
                        } else {
                            nextSegment = true
                            break
                        }
                    }
                    if g != 0 {
                        c.*.curCharcode = charcode
                        c.*.curGindex = g
                        return
                    }
                    charcode += 1
                    if charcode > end { break }
                }
            }
        }
        if !cmap4SetRange(c, c.*.curRange + 1) { break }
        if charcode < c.*.curStart { charcode = c.*.curStart }
    }
    c.*.curCharcode = 0xFFFFFFFF
    c.*.curGindex = 0
}

// The glyph of `code` (or, walking, of the first character after it):
// the glyph and the character.
fn cmap4Linear(c: *CharMap, from: u64, next: bool) -> (u64, u64) {
    const table = c.*.table
    const limit = cmapLimit(c)
    const numSegs = be16(table + 6) >> 1
    if numSegs == 0 { return -> (0, from) }
    const numSegs2 = numSegs << 1
    var charcode = if next { (from + 1) & 0xFFFFFFFF } else { from }
    var gindex: u64 = 0
    var i: u64 = 0
    while i < numSegs {
        const end = be16(table + 14 + i * 2)
        const start = be16(table + 16 + numSegs2 + i * 2)
        i += 1
        if charcode < start {
            if next {
                charcode = start
            } else {
                break
            }
        }
        var again = true
        var done = false
        while again {
            again = false
            if charcode <= end {
                const q = table + 16 + numSegs2 + (i - 1) * 2
                var rr = q + numSegs2
                var delta = sbe16(rr)
                rr += numSegs2
                var offset = be16(rr)
                if i - 1 >= numSegs - 1 && start == 0xFFFF && end == 0xFFFF {
                    if offset != 0 && rr + offset + 2 > limit {
                        delta = 1
                        offset = 0
                    }
                }
                if offset == 0xFFFF { break }
                if offset != 0 {
                    rr += offset + (charcode - start) * 2
                    if next && rr > limit { break }
                    gindex = be16(rr)
                    if gindex != 0 {
                        gindex = @intCast(u64, (@intCast(i64, gindex) + delta) & 0xFFFF)
                        if gindex >= numGlyphs(c) { gindex = 0 }
                    }
                } else {
                    gindex = @intCast(u64, (@intCast(i64, charcode) + delta) & 0xFFFF)
                    if next && gindex >= numGlyphs(c) {
                        gindex = 0
                        if @intCast(i64, charcode) + delta < 0 && @intCast(i64, end) + delta >= 0 {
                            charcode = @intCast(u64, 0 - delta)
                        } else if @intCast(i64, charcode) + delta < 0x10000 && @intCast(i64, end) + delta >= 0x10000 {
                            charcode = @intCast(u64, 0x10000 - delta)
                        } else {
                            break
                        }
                    }
                }
                if next && gindex == 0 {
                    if charcode >= 0xFFFF {
                        done = true
                        break
                    }
                    charcode += 1
                    again = true
                    continue
                }
                done = true
            }
        }
        if done { break }
    }
    return -> (gindex, charcode)
}

fn cmap4Binary(c: *CharMap, from: u64, next: bool) -> (u64, u64) {
    const table = c.*.table
    const limit = cmapLimit(c)
    const numSegs = be16(table + 6) >> 1
    if numSegs == 0 { return -> (0, from) }
    const numSegs2 = numSegs << 1
    var charcode = if next { (from + 1) & 0xFFFFFFFF } else { from }
    var gindex: u64 = 0
    var min: u64 = 0
    var max = numSegs
    var mid: u64 = 0
    var start: u64 = 0
    var end: u64 = 0
    var delta: i64 = 0
    var offset: u64 = 0
    var p: usize = 0
    while true {
        mid = (min + max) >> 1
        p = table + 14 + mid * 2
        end = be16(p)
        p += 2 + numSegs2
        start = be16(p)
        if charcode < start {
            max = mid
        } else if charcode > end {
            min = mid + 1
        } else {
            p += numSegs2
            delta = sbe16(p)
            p += numSegs2
            offset = be16(p)
            if mid >= numSegs - 1 && start == 0xFFFF && end == 0xFFFF {
                if offset != 0 && p + offset + 2 > limit {
                    delta = 1
                    offset = 0
                }
            }
            var finish = false
            if (c.*.flags & FLAG_OVERLAPPING) != 0 {
                // (The first of the segments containing the character
                // that is not a 0xFFFF one.)
                max = mid
                if offset == 0xFFFF { mid = max + 1 }
                var i = max
                while i > 0 {
                    const oldP = p
                    p = table + 14 + (i - 1) * 2
                    const prevEnd = be16(p)
                    if charcode > prevEnd {
                        p = oldP
                        break
                    }
                    end = prevEnd
                    p += 2 + numSegs2
                    start = be16(p)
                    p += numSegs2
                    delta = sbe16(p)
                    p += numSegs2
                    offset = be16(p)
                    if offset != 0xFFFF { mid = i - 1 }
                    i -= 1
                }
                if mid == max + 1 {
                    if i != max {
                        p = table + 14 + max * 2
                        end = be16(p)
                        p += 2 + numSegs2
                        start = be16(p)
                        p += numSegs2
                        delta = sbe16(p)
                        p += numSegs2
                        offset = be16(p)
                    }
                    mid = max
                    i = max + 1
                    while i < numSegs {
                        p = table + 14 + i * 2
                        const nextEnd = be16(p)
                        p += 2 + numSegs2
                        const nextStart = be16(p)
                        if charcode < nextStart { break }
                        end = nextEnd
                        start = nextStart
                        p += numSegs2
                        delta = sbe16(p)
                        p += numSegs2
                        offset = be16(p)
                        if offset != 0xFFFF { mid = i }
                        i += 1
                    }
                    i -= 1
                    if mid == max {
                        mid = i
                        finish = true
                    }
                }
                if !finish && mid != i {
                    p = table + 14 + mid * 2
                    end = be16(p)
                    p += 2 + numSegs2
                    start = be16(p)
                    p += numSegs2
                    delta = sbe16(p)
                    p += numSegs2
                    offset = be16(p)
                }
            } else {
                if offset == 0xFFFF { break }
            }
            if finish { break }
            if offset != 0 {
                p += offset + (charcode - start) * 2
                if next && p > limit { break }
                gindex = be16(p)
                if gindex != 0 {
                    gindex = @intCast(u64, (@intCast(i64, gindex) + delta) & 0xFFFF)
                    if gindex >= numGlyphs(c) { gindex = 0 }
                }
            } else {
                gindex = @intCast(u64, (@intCast(i64, charcode) + delta) & 0xFFFF)
                if next && gindex >= numGlyphs(c) {
                    gindex = 0
                    if @intCast(i64, charcode) + delta < 0 && @intCast(i64, end) + delta >= 0 {
                        charcode = @intCast(u64, 0 - delta)
                    } else if @intCast(i64, charcode) + delta < 0x10000 && @intCast(i64, end) + delta >= 0x10000 {
                        charcode = @intCast(u64, 0x10000 - delta)
                    }
                }
            }
            break
        }
        if min >= max { break }
    }
    if next {
        if charcode > end {
            mid += 1
            if mid == numSegs { return -> (0, from) }
        }
        var result = from
        if !cmap4SetRange(c, mid) {
            if gindex != 0 { result = charcode }
        } else {
            c.*.curCharcode = charcode
            if gindex != 0 {
                c.*.curGindex = gindex
            } else {
                cmap4Next(c)
                gindex = c.*.curGindex
            }
            if gindex != 0 { result = c.*.curCharcode }
        }
        return -> (gindex, result)
    }
    return -> (gindex, charcode)
}

fn cmap12Next(c: *CharMap, numGlyphs_: u64) -> void {
    var charcode = c.*.curCharcode + 1
    var n = c.*.curGroup
    while n < c.*.numRanges {
        const p = c.*.table + 16 + 12 * n
        const start = be32(p)
        const end = be32(p + 4)
        const startId = be32(p + 8)
        n += 1
        if charcode < start { charcode = start }
        while charcode <= end {
            if startId > 0xFFFFFFFF - (charcode - start) { break }
            const g = (startId + (charcode - start)) & 0xFFFFFFFF
            if g == 0 {
                if charcode >= 0xFFFFFFFF {
                    c.*.valid = false
                    return
                }
                charcode += 1
                continue
            }
            if g >= numGlyphs_ { break }
            c.*.curCharcode = charcode
            c.*.curGindex = g
            c.*.curGroup = n - 1
            return
        }
    }
    c.*.valid = false
}

fn cmap12Binary(c: *CharMap, from: u64, next: bool) -> (u64, u64) {
    const table = c.*.table
    const numGroups = be32(table + 12)
    if numGroups == 0 { return -> (0, from) }
    const charcode = if next { (from + 1) & 0xFFFFFFFF } else { from }
    var gindex: u64 = 0
    var min: u64 = 0
    var max = numGroups
    var mid: u64 = 0
    var end: u64 = 0
    while true {
        mid = (min + max) >> 1
        const p = table + 16 + 12 * mid
        const start = be32(p)
        end = be32(p + 4)
        if charcode < start {
            max = mid
        } else if charcode > end {
            min = mid + 1
        } else {
            const startId = be32(p + 8)
            if startId > 0xFFFFFFFF - (charcode - start) {
                gindex = 0
            } else {
                gindex = (startId + (charcode - start)) & 0xFFFFFFFF
            }
            break
        }
        if min >= max { break }
    }
    if next {
        if charcode > end {
            mid += 1
            if mid == numGroups { return -> (0, from) }
        }
        c.*.valid = true
        c.*.curCharcode = charcode
        c.*.curGroup = mid
        if gindex >= numGlyphs(c) { gindex = 0 }
        if gindex == 0 {
            cmap12Next(c, numGlyphs(c))
            if c.*.valid { gindex = c.*.curGindex }
        } else {
            c.*.curGindex = gindex
        }
        return -> (gindex, c.*.curCharcode)
    }
    return -> (gindex, charcode)
}

fn cmap13Next(c: *CharMap, numGlyphs_: u64) -> void {
    var charcode = c.*.curCharcode + 1
    var n = c.*.curGroup
    while n < c.*.numRanges {
        const p = c.*.table + 16 + 12 * n
        const start = be32(p)
        const end = be32(p + 4)
        const glyphId = be32(p + 8)
        if charcode < start { charcode = start }
        if charcode <= end {
            if glyphId != 0 && glyphId < numGlyphs_ {
                c.*.curCharcode = charcode
                c.*.curGindex = glyphId
                c.*.curGroup = n
                return
            }
        }
        n += 1
    }
    c.*.valid = false
}

fn cmap13Binary(c: *CharMap, from: u64, next: bool) -> (u64, u64) {
    const table = c.*.table
    const numGroups = be32(table + 12)
    if numGroups == 0 { return -> (0, from) }
    const charcode = if next { (from + 1) & 0xFFFFFFFF } else { from }
    var gindex: u64 = 0
    var min: u64 = 0
    var max = numGroups
    var mid: u64 = 0
    var end: u64 = 0
    while true {
        mid = (min + max) >> 1
        const p = table + 16 + 12 * mid
        const start = be32(p)
        end = be32(p + 4)
        if charcode < start {
            max = mid
        } else if charcode > end {
            min = mid + 1
        } else {
            gindex = be32(p + 8)
            break
        }
        if min >= max { break }
    }
    if next {
        if charcode > end {
            mid += 1
            if mid == numGroups { return -> (0, from) }
        }
        c.*.valid = true
        c.*.curCharcode = charcode
        c.*.curGroup = mid
        if gindex >= numGlyphs(c) { gindex = 0 }
        if gindex == 0 {
            cmap13Next(c, numGlyphs(c))
            if c.*.valid { gindex = c.*.curGindex }
        } else {
            c.*.curGindex = gindex
        }
        return -> (gindex, c.*.curCharcode)
    }
    return -> (gindex, charcode)
}

// The first character after `from` that has a glyph: the glyph (0 when
// there is none) and the character.
pub fn charNext(cmap: usize, from: u64) -> (u64, u64) {
    const c = o.charMap(cmap)
    const table = c.*.table
    const format = c.*.format
    if format == 0 {
        var code = from
        while true {
            code += 1
            if code >= 256 { break }
            const g = @intCast(u64, m.get8(table + 6 + code))
            if g != 0 { return -> (g, code) }
        }
        return -> (0, 0)
    }
    if format == 2 {
        const n = cmap2Next(table, from)
        return -> (n.1, n.0)
    }
    if format == 4 {
        if from >= 0xFFFF { return -> (0, from) }
        if (c.*.flags & FLAG_UNSORTED) != 0 { return cmap4Linear(c, from, true) }
        if from == c.*.curCharcode {
            cmap4Next(c)
            const g = c.*.curGindex
            if g != 0 { return -> (g, c.*.curCharcode) }
            return -> (0, from)
        }
        return cmap4Binary(c, from, true)
    }
    if format == 6 {
        const start = be16(table + 6)
        const count = be16(table + 8)
        var code = from + 1
        if code >= 0x10000 { return -> (0, from) }
        if code < start { code = start }
        var idx = code - start
        while idx < count {
            const g = be16(table + 10 + 2 * idx)
            if g != 0 { return -> (g, code) }
            if code >= 0xFFFF { return -> (0, from) }
            code += 1
            idx += 1
        }
        return -> (0, 0)
    }
    if format == 8 {
        if from >= 0xFFFFFFFF { return -> (0, from) }
        var code = from + 1
        var p = table + 8204
        var numGroups = be32(p)
        p = table + 8208
        while numGroups > 0 {
            const start = be32(p)
            const end = be32(p + 4)
            const startId = be32(p + 8)
            p += 12
            numGroups -= 1
            if code < start { code = start }
            while code <= end {
                if startId > 0xFFFFFFFF - (code - start) { break }
                const g = (startId + (code - start)) & 0xFFFFFFFF
                if g == 0 {
                    if code >= 0xFFFFFFFF { return -> (0, 0) }
                    code += 1
                    continue
                }
                if g >= numGlyphs(c) { break }
                return -> (g, code)
            }
        }
        return -> (0, 0)
    }
    if format == 10 {
        if from >= 0xFFFFFFFF { return -> (0, from) }
        const start = be32(table + 12)
        const count = be32(table + 16)
        var code = from + 1
        if code < start { code = start }
        var idx = code - start
        var g: u64 = 0
        while idx < count {
            g = be16(table + 20 + 2 * idx)
            if g != 0 { break }
            if code >= 0xFFFFFFFF { return -> (0, from) }
            code += 1
            idx += 1
        }
        return -> (g, code)
    }
    if format == 12 {
        if from >= 0xFFFFFFFF { return -> (0, from) }
        if c.*.valid && c.*.curCharcode == from {
            cmap12Next(c, numGlyphs(c))
            if c.*.valid { return -> (c.*.curGindex, c.*.curCharcode) }
            return -> (0, from)
        }
        return cmap12Binary(c, from, true)
    }
    if format == 13 {
        if from >= 0xFFFFFFFF { return -> (0, from) }
        if c.*.valid && c.*.curCharcode == from {
            cmap13Next(c, numGlyphs(c))
            if c.*.valid { return -> (c.*.curGindex, c.*.curCharcode) }
            return -> (0, from)
        }
        return cmap13Binary(c, from, true)
    }
    return -> (0, 0)
}

// ---------------------------------------------------------------------------
// Format 14: variation selectors.

fn findVariant(base: usize, selector: u64) -> usize {
    const numVar = be32(base)
    var min: u64 = 0
    var max = numVar
    while min < max {
        const mid = (min + max) >> 1
        const p = base + 4 + 11 * mid
        const varSel = be24(p)
        if selector < varSel {
            max = mid
        } else if selector > varSel {
            min = mid + 1
        } else {
            return p + 3
        }
    }
    return 0
}

fn mapDefault(base: usize, code: u64) -> bool {
    const numRanges = be32(base)
    var min: u64 = 0
    var max = numRanges
    while min < max {
        const mid = (min + max) >> 1
        const p = base + 4 + 4 * mid
        const start = be24(p)
        const cnt = @intCast(u64, m.get8(p + 3))
        if code < start {
            max = mid
        } else if code > start + cnt {
            min = mid + 1
        } else {
            return true
        }
    }
    return false
}

fn mapNonDefault(base: usize, code: u64) -> u64 {
    const numMappings = be32(base)
    var min: u64 = 0
    var max = numMappings
    while min < max {
        const mid = (min + max) >> 1
        const p = base + 4 + 5 * mid
        const uni = be24(p)
        if code < uni {
            max = mid
        } else if code > uni {
            min = mid + 1
        } else {
            return be16(p + 3)
        }
    }
    return 0
}

pub fn varIndex(vcmap: usize, ucmap: usize, code: u64, selector: u64) -> u64 {
    const table = o.charMap(vcmap).*.table
    const p = findVariant(table + 6, selector)
    if p == 0 { return 0 }
    const defOff = be32(p)
    const nondefOff = be32(p + 4)
    if defOff != 0 && mapDefault(table + defOff, code) { return charIndex(ucmap, code) }
    if nondefOff != 0 { return mapNonDefault(table + nondefOff, code) }
    return 0
}

pub fn varIsDefault(vcmap: usize, code: u64, selector: u64) -> i64 {
    const table = o.charMap(vcmap).*.table
    const p = findVariant(table + 6, selector)
    if p == 0 { return -1 }
    const defOff = be32(p)
    const nondefOff = be32(p + 4)
    if defOff != 0 && mapDefault(table + defOff, code) { return 1 }
    if nondefOff != 0 && mapNonDefault(table + nondefOff, code) != 0 { return 0 }
    return -1
}

// The charmap's array of results (32-bit values), at least `count` long.
fn ensure(vcmap: usize, count: u64) -> usize {
    const c = o.charMap(vcmap)
    if count > c.*.resultsMax {
        const memory = r.faceRec(c.*.face).*.memory
        const grown = m.grow(memory, c.*.results, @intCast(usize, c.*.resultsMax) * 4, @intCast(usize, count) * 4)
        if grown == 0 { return 0 }
        c.*.results = grown
        c.*.resultsMax = count
    }
    return c.*.results
}

pub fn variantSelectors(vcmap: usize) -> usize {
    const table = o.charMap(vcmap).*.table
    const count = be32(table + 6)
    const result = ensure(vcmap, count + 1)
    if result == 0 { return 0 }
    var p = table + 10
    var i: u64 = 0
    while i < count {
        m.put32(result + i * 4, @intCast(u32, be24(p)))
        p += 11
        i += 1
    }
    m.put32(result + i * 4, 0)
    return result
}

pub fn variantsOfChar(vcmap: usize, code: u64) -> usize {
    const table = o.charMap(vcmap).*.table
    var count = be32(table + 6)
    const result = ensure(vcmap, count + 1)
    if result == 0 { return 0 }
    var p = table + 10
    var q = result
    while count > 0 {
        const varSel = be24(p)
        const defOff = be32(p + 3)
        const nondefOff = be32(p + 7)
        p += 11
        if (defOff != 0 && mapDefault(table + defOff, code)) || (nondefOff != 0 && mapNonDefault(table + nondefOff, code) != 0) {
            m.put32(q, @intCast(u32, varSel))
            q += 4
        }
        count -= 1
    }
    m.put32(q, 0)
    return result
}

fn defaultCharCount(p: usize) -> u64 {
    const numRanges = be32(p)
    var total: u64 = 0
    var i: u64 = 0
    while i < numRanges {
        total += 1 + @intCast(u64, m.get8(p + 4 + i * 4 + 3))
        i += 1
    }
    return total
}

fn defaultChars(vcmap: usize, p: usize) -> usize {
    const cnt = defaultCharCount(p)
    const numRanges = be32(p)
    const result = ensure(vcmap, cnt + 1)
    if result == 0 { return 0 }
    var q = result
    var i: u64 = 0
    while i < numRanges {
        var uni = be24(p + 4 + i * 4)
        var n = @intCast(u64, m.get8(p + 4 + i * 4 + 3)) + 1
        while n > 0 {
            m.put32(q, @intCast(u32, uni))
            uni += 1
            q += 4
            n -= 1
        }
        i += 1
    }
    m.put32(q, 0)
    return result
}

fn nonDefaultChars(vcmap: usize, p: usize) -> usize {
    const numMappings = be32(p)
    const result = ensure(vcmap, numMappings + 1)
    if result == 0 { return 0 }
    var i: u64 = 0
    while i < numMappings {
        m.put32(result + i * 4, @intCast(u32, be24(p + 4 + i * 5)))
        i += 1
    }
    m.put32(result + i * 4, 0)
    return result
}

pub fn charsOfVariant(vcmap: usize, selector: u64) -> usize {
    const table = o.charMap(vcmap).*.table
    const p = findVariant(table + 6, selector)
    if p == 0 { return 0 }
    const defOff = be32(p)
    const nondefOff = be32(p + 4)
    if defOff == 0 && nondefOff == 0 { return 0 }
    if defOff == 0 { return nonDefaultChars(vcmap, table + nondefOff) }
    if nondefOff == 0 { return defaultChars(vcmap, table + defOff) }
    const np = table + nondefOff
    const dp = table + defOff
    const numMappings = be32(np)
    const dcount = defaultCharCount(dp)
    const numRanges = be32(dp)
    if numMappings == 0 { return defaultChars(vcmap, dp) }
    if dcount == 0 { return nonDefaultChars(vcmap, np) }
    const result = ensure(vcmap, dcount + numMappings + 1)
    if result == 0 { return 0 }
    // (The two sorted lists merged.)
    var duni = be24(dp + 4)
    var dcnt = @intCast(u64, m.get8(dp + 7))
    var di: u64 = 1
    var nuni = be24(np + 4)
    var ni: u64 = 1
    var i: u64 = 0
    while true {
        if nuni > duni + dcnt {
            var k: u64 = 0
            while k <= dcnt {
                m.put32(result + i * 4, @intCast(u32, duni + k))
                i += 1
                k += 1
            }
            di += 1
            if di > numRanges { break }
            duni = be24(dp + 4 + (di - 1) * 4)
            dcnt = @intCast(u64, m.get8(dp + 4 + (di - 1) * 4 + 3))
        } else {
            if nuni < duni {
                m.put32(result + i * 4, @intCast(u32, nuni))
                i += 1
            }
            ni += 1
            if ni > numMappings { break }
            nuni = be24(np + 4 + (ni - 1) * 5)
        }
    }
    if ni <= numMappings {
        m.put32(result + i * 4, @intCast(u32, nuni))
        i += 1
        while ni < numMappings {
            m.put32(result + i * 4, @intCast(u32, be24(np + 4 + ni * 5)))
            i += 1
            ni += 1
        }
    } else if di <= numRanges {
        var k: u64 = 0
        while k <= dcnt {
            m.put32(result + i * 4, @intCast(u32, duni + k))
            i += 1
            k += 1
        }
        while di < numRanges {
            duni = be24(dp + 4 + di * 4)
            dcnt = @intCast(u64, m.get8(dp + 4 + di * 4 + 3))
            k = 0
            while k <= dcnt {
                m.put32(result + i * 4, @intCast(u32, duni + k))
                i += 1
                k += 1
            }
            di += 1
        }
    }
    m.put32(result + i * 4, 0)
    return result
}

pub fn doneCharmap(cmap: usize, memory: usize) -> void {
    const c = o.charMap(cmap)
    m.release(memory, c.*.results)
    m.release(memory, cmap)
}
