// Fixed-point arithmetic as FreeType does it on x86_64: 16.16 products
// and quotients rounded its way (FT_MulFix takes its operands as 32-bit
// values there), the trigonometry of vectors by CORDIC, and matrices.
// What a font gives is not trusted: the arithmetic wraps where C's would,
// and never traps.
const m = @import("./memory.mlx")

pub fn abs(x: i64) -> i64 { return if x < 0 { 0 -% x } else { x } }
pub fn min(a: i64, b: i64) -> i64 { return if a < b { a } else { b } }
pub fn max(a: i64, b: i64) -> i64 { return if a > b { a } else { b } }

// The low 32 bits of `x` as a signed value (C's cast to a 32-bit int).
pub fn low32(x: i64) -> i64 { return @intCast(i64, @bitCast(i32, @intCast(u32, @bitCast(u64, x) & 0xFFFFFFFF))) }
// The low 16 bits of `x` as a signed value (C's cast to a short).
pub fn low16(x: i64) -> i64 { return @intCast(i64, @bitCast(i16, @intCast(u16, @bitCast(u64, x) & 0xFFFF))) }
// The low 16 bits as an unsigned value.
pub fn ulow16(x: i64) -> i64 { return @intCast(i64, @bitCast(u64, x) & 0xFFFF) }

pub fn shl(x: i64, n: i64) -> i64 { return x << @intCast(u6, n & 63) }
pub fn sar(x: i64, n: i64) -> i64 { return x >> @intCast(u6, n & 63) }

// FT_PIX_FLOOR, FT_PIX_ROUND, FT_PIX_CEIL of 26.6 values.
pub fn pixFloor(x: i64) -> i64 { return x & -64 }
pub fn pixRound(x: i64) -> i64 { return (x +% 32) & -64 }
pub fn pixCeil(x: i64) -> i64 { return (x +% 63) & -64 }

// a * b / 0x10000 rounded, of 32-bit operands (FreeType's FT_MulFix on
// x86_64 casts them to FT_Int32 and its result too).
pub fn mulFix(a: i64, b: i64) -> i64 {
    var ab = low32(a) *% low32(b)
    const sign = ab >> 63
    ab = ab +% 0x8000 +% sign
    return low32(ab >> 16)
}

// (a * b + c / 2) / c with the signs moved out; 0x7FFFFFFF for c 0.
pub fn mulDiv(a: i64, b: i64, c: i64) -> i64 {
    var s: i64 = 1
    var ua = @bitCast(u64, a)
    var ub = @bitCast(u64, b)
    var uc = @bitCast(u64, c)
    if a < 0 {
        ua = 0 -% ua
        s = 0 - s
    }
    if b < 0 {
        ub = 0 -% ub
        s = 0 - s
    }
    if c < 0 {
        uc = 0 -% uc
        s = 0 - s
    }
    const d: u64 = if uc > 0 { (ua *% ub +% (uc >> 1)) / uc } else { 0x7FFFFFFF }
    const r = @bitCast(i64, d)
    return if s < 0 { 0 -% r } else { r }
}

pub fn mulDivNoRound(a: i64, b: i64, c: i64) -> i64 {
    var s: i64 = 1
    var ua = @bitCast(u64, a)
    var ub = @bitCast(u64, b)
    var uc = @bitCast(u64, c)
    if a < 0 {
        ua = 0 -% ua
        s = 0 - s
    }
    if b < 0 {
        ub = 0 -% ub
        s = 0 - s
    }
    if c < 0 {
        uc = 0 -% uc
        s = 0 - s
    }
    const d: u64 = if uc > 0 { (ua *% ub) / uc } else { 0x7FFFFFFF }
    const r = @bitCast(i64, d)
    return if s < 0 { 0 -% r } else { r }
}

// (a << 16 + b / 2) / b with the signs moved out; 0x7FFFFFFF for b 0.
pub fn divFix(a: i64, b: i64) -> i64 {
    var s: i64 = 1
    var ua = @bitCast(u64, a)
    var ub = @bitCast(u64, b)
    if a < 0 {
        ua = 0 -% ua
        s = 0 - s
    }
    if b < 0 {
        ub = 0 -% ub
        s = 0 - s
    }
    const q: u64 = if ub > 0 { ((ua << 16) +% (ub >> 1)) / ub } else { 0x7FFFFFFF }
    const r = @bitCast(i64, q)
    return if s < 0 { 0 -% r } else { r }
}

pub fn roundFix(a: i64) -> i64 { return (a +% 0x8000 -% (if a < 0 { 1 } else { 0 })) & -65536 }
pub fn ceilFix(a: i64) -> i64 { return (a +% 0xFFFF) & -65536 }
pub fn floorFix(a: i64) -> i64 { return a & -65536 }

// The index of the highest bit set of a 32-bit value.
pub fn msb(value: u64) -> i64 {
    var z = value & 0xFFFFFFFF
    var shift: i64 = 0
    if (z & 0xFFFF0000) != 0 {
        z >>= 16
        shift += 16
    }
    if (z & 0x0000FF00) != 0 {
        z >>= 8
        shift += 8
    }
    if (z & 0x000000F0) != 0 {
        z >>= 4
        shift += 4
    }
    if (z & 0x0000000C) != 0 {
        z >>= 2
        shift += 2
    }
    if (z & 0x00000002) != 0 { shift += 1 }
    return shift
}

// ---------------------------------------------------------------------------
// Trigonometry (angles in 16.16 degrees), by CORDIC as FreeType does it.

pub const ANGLE_PI: i64 = 180 << 16
pub const ANGLE_2PI: i64 = 360 << 16
pub const ANGLE_PI2: i64 = 90 << 16
pub const ANGLE_PI4: i64 = 45 << 16

const TRIG_SCALE: u64 = 0xDBD95B16
const TRIG_SAFE_MSB: i64 = 29
const TRIG_MAX_ITERS: i64 = 23

var arctanTable: [22]i64 = [22]i64{ 1740967, 919879, 466945, 234379, 117304, 58666, 29335, 14668, 7334, 3667, 1833, 917, 458, 229, 115, 57, 29, 14, 7, 4, 2, 1 }

fn trigDownscale(value: i64) -> i64 {
    var val = value
    var s: i64 = 1
    if val < 0 {
        val = 0 - val
        s = -1
    }
    val = @bitCast(i64, (@bitCast(u64, val) *% TRIG_SCALE +% 0x40000000) >> 32)
    return if s < 0 { 0 - val } else { val }
}

// The vector scaled to have its highest bit at 29; the shift made.
fn trigPrenorm(x: i64, y: i64) -> (i64, i64, i64) {
    var shift = msb(@bitCast(u64, abs(x) | abs(y)))
    if shift <= TRIG_SAFE_MSB {
        shift = TRIG_SAFE_MSB - shift
        return -> (@bitCast(i64, @bitCast(u64, x) << @intCast(u6, shift)), @bitCast(i64, @bitCast(u64, y) << @intCast(u6, shift)), shift)
    }
    shift -= TRIG_SAFE_MSB
    return -> (x >> @intCast(u6, shift), y >> @intCast(u6, shift), 0 - shift)
}

fn pseudoRotate(vx: i64, vy: i64, angle: i64) -> (i64, i64) {
    var x = vx
    var y = vy
    var theta = angle
    while theta < 0 - ANGLE_PI4 {
        const t = y
        y = 0 - x
        x = t
        theta += ANGLE_PI2
    }
    while theta > ANGLE_PI4 {
        const t = 0 - y
        y = x
        x = t
        theta -= ANGLE_PI2
    }
    var i: i64 = 1
    var b: i64 = 1
    while i < TRIG_MAX_ITERS {
        const shift = @intCast(u6, i)
        if theta < 0 {
            const t = x +% ((y +% b) >> shift)
            y = y -% ((x +% b) >> shift)
            x = t
            theta += arctanTable[@intCast(usize, i - 1)]
        } else {
            const t = x -% ((y +% b) >> shift)
            y = y +% ((x +% b) >> shift)
            x = t
            theta -= arctanTable[@intCast(usize, i - 1)]
        }
        b <<= 1
        i += 1
    }
    return -> (x, y)
}

// The vector's length (scaled by CORDIC's gain) and angle.
fn pseudoPolarize(vx: i64, vy: i64) -> (i64, i64) {
    var x = vx
    var y = vy
    var theta: i64 = 0
    if y > x {
        if y > 0 - x {
            theta = ANGLE_PI2
            const t = y
            y = 0 - x
            x = t
        } else {
            theta = if y > 0 { ANGLE_PI } else { 0 - ANGLE_PI }
            x = 0 - x
            y = 0 - y
        }
    } else {
        if y < 0 - x {
            theta = 0 - ANGLE_PI2
            const t = 0 - y
            y = x
            x = t
        } else {
            theta = 0
        }
    }
    var i: i64 = 1
    var b: i64 = 1
    while i < TRIG_MAX_ITERS {
        const shift = @intCast(u6, i)
        if y > 0 {
            const t = x +% ((y +% b) >> shift)
            y = y -% ((x +% b) >> shift)
            x = t
            theta += arctanTable[@intCast(usize, i - 1)]
        } else {
            const t = x -% ((y +% b) >> shift)
            y = y +% ((x +% b) >> shift)
            x = t
            theta -= arctanTable[@intCast(usize, i - 1)]
        }
        b <<= 1
        i += 1
    }
    // (Rounded to a multiple of 16, as CORDIC's last bits are noise.)
    if theta >= 0 {
        theta = (theta + 8) & -16
    } else {
        theta = 0 - ((8 - theta) & -16)
    }
    return -> (x, theta)
}

pub fn vectorUnit(angle: i64) -> (i64, i64) {
    const r = pseudoRotate(@intCast(i64, TRIG_SCALE >> 8), 0, angle)
    return -> ((r.0 + 0x80) >> 8, (r.1 + 0x80) >> 8)
}

pub fn cos(angle: i64) -> i64 { return vectorUnit(angle).0 }
pub fn sin(angle: i64) -> i64 { return vectorUnit(angle).1 }

pub fn tan(angle: i64) -> i64 {
    const r = pseudoRotate(1 << 24, 0, angle)
    return divFix(r.1, r.0)
}

pub fn atan2(dx: i64, dy: i64) -> i64 {
    if dx == 0 && dy == 0 { return 0 }
    const v = trigPrenorm(dx, dy)
    return pseudoPolarize(v.0, v.1).1
}

pub fn vectorRotate(x: i64, y: i64, angle: i64) -> (i64, i64) {
    if angle == 0 { return -> (x, y) }
    if x == 0 && y == 0 { return -> (x, y) }
    const v = trigPrenorm(x, y)
    var shift = v.2
    const r = pseudoRotate(v.0, v.1, angle)
    const rx = trigDownscale(r.0)
    const ry = trigDownscale(r.1)
    if shift > 0 {
        const half = shl(1, shift - 1)
        const s = @intCast(u6, shift)
        return -> ((rx + half - (if rx < 0 { 1 } else { 0 })) >> s, (ry + half - (if ry < 0 { 1 } else { 0 })) >> s)
    }
    shift = 0 - shift
    return -> (@bitCast(i64, @bitCast(u64, rx) << @intCast(u6, shift)), @bitCast(i64, @bitCast(u64, ry) << @intCast(u6, shift)))
}

pub fn vectorLength(x: i64, y: i64) -> i64 {
    if x == 0 { return abs(y) }
    if y == 0 { return abs(x) }
    const v = trigPrenorm(x, y)
    const shift = v.2
    const p = pseudoPolarize(v.0, v.1)
    const length = trigDownscale(p.0)
    if shift > 0 { return (length + shl(1, shift - 1)) >> @intCast(u6, shift) }
    return @intCast(i64, ((@bitCast(u64, length) & 0xFFFFFFFF) << @intCast(u6, 0 - shift)) & 0xFFFFFFFF)
}

// The length and angle of a vector (none for the null vector: `ok` false).
pub fn vectorPolarize(x: i64, y: i64) -> (i64, i64, bool) {
    if x == 0 && y == 0 { return -> (0, 0, false) }
    const v = trigPrenorm(x, y)
    const shift = v.2
    const p = pseudoPolarize(v.0, v.1)
    const length = trigDownscale(p.0)
    const l = if shift >= 0 { length >> @intCast(u6, shift) } else { @intCast(i64, ((@bitCast(u64, length) & 0xFFFFFFFF) << @intCast(u6, 0 - shift)) & 0xFFFFFFFF) }
    return -> (l, p.1, true)
}

pub fn angleDiff(angle1: i64, angle2: i64) -> i64 {
    var delta = angle2 - angle1
    while delta <= 0 - ANGLE_PI { delta += ANGLE_2PI }
    while delta > ANGLE_PI { delta -= ANGLE_2PI }
    return delta
}

pub fn hypot(x: i64, y: i64) -> i64 { return vectorLength(x, y) }

// The normalized vector (16.16) and the length of `(x, y)`, as FreeType's
// FT_Vector_NormLen computes them (for emboldening).
pub fn vectorNormLen(vx: i64, vy: i64) -> (i64, i64, i64) {
    const x_ = low32(vx)
    const y_ = low32(vy)
    var x: u64 = @bitCast(u64, x_) & 0xFFFFFFFF
    var y: u64 = @bitCast(u64, y_) & 0xFFFFFFFF
    var sx: i64 = 1
    var sy: i64 = 1
    if x_ < 0 {
        x = (0 -% x) & 0xFFFFFFFF
        sx = -1
    }
    if y_ < 0 {
        y = (0 -% y) & 0xFFFFFFFF
        sy = -1
    }
    if x == 0 {
        var ny = vy
        if y > 0 { ny = sy * 0x10000 }
        return -> (vx, ny, @intCast(i64, y))
    } else if y == 0 {
        var nx = vx
        if x > 0 { nx = sx * 0x10000 }
        return -> (nx, vy, @intCast(i64, x))
    }
    var l: u64 = if x > y { x + (y >> 1) } else { y + (x >> 1) }
    var shift = 31 - msb(l)
    shift -= 15 + (if l >= (0xAAAAAAAA >> @intCast(u6, shift)) { 1 } else { 0 })
    if shift > 0 {
        x = (x << @intCast(u6, shift)) & 0xFFFFFFFF
        y = (y << @intCast(u6, shift)) & 0xFFFFFFFF
        l = if x > y { x + (y >> 1) } else { y + (x >> 1) }
        l &= 0xFFFFFFFF
    } else {
        x = x >> @intCast(u6, 0 - shift)
        y = y >> @intCast(u6, 0 - shift)
        l = l >> @intCast(u6, 0 - shift)
    }
    var b: i64 = 0x10000 - low32(@bitCast(i64, l))
    const xi = low32(@bitCast(i64, x))
    const yi = low32(@bitCast(i64, y))
    var u: u64 = 0
    var v: u64 = 0
    while true {
        u = @bitCast(u64, xi +% low32((xi *% b) >> 16)) & 0xFFFFFFFF
        v = @bitCast(u64, yi +% low32((yi *% b) >> 16)) & 0xFFFFFFFF
        var z = 0 - low32(@bitCast(i64, (u *% u +% v *% v) & 0xFFFFFFFF))
        z = z / 0x200
        z = low32(z *% ((0x10000 + b) >> 8))
        z = z / 0x10000
        b += z
        if z <= 0 { break }
    }
    const nx = if sx < 0 { 0 - @bitCast(i64, u) } else { @bitCast(i64, u) }
    const ny = if sy < 0 { 0 - @bitCast(i64, v) } else { @bitCast(i64, v) }
    var len: u64 = @bitCast(u64, 0x10000 + low32(@bitCast(i64, (u *% x +% v *% y) & 0xFFFFFFFF)) / 0x10000) & 0xFFFFFFFF
    if shift > 0 {
        const one: u64 = 1
        len = (len + (one << @intCast(u6, shift - 1))) >> @intCast(u6, shift)
    } else {
        len = (len << @intCast(u6, 0 - shift)) & 0xFFFFFFFF
    }
    return -> (nx, ny, @intCast(i64, len))
}

// The sign of the cross product of the vectors in and out: +1 for a
// turn to the left, -1 to the right, 0 for none.
pub fn cornerOrientation(in_x: i64, in_y: i64, out_x: i64, out_y: i64) -> i64 {
    // (128-bit products, as FreeType's FT_Int64 ones are 64-bit ones of
    // 32-bit coordinates.)
    const delta = in_x *% out_y -% in_y *% out_x
    if delta > 0 { return 1 }
    if delta < 0 { return -1 }
    return 0
}

pub fn cornerIsFlat(in_x: i64, in_y: i64, out_x: i64, out_y: i64) -> bool {
    const ax = in_x + out_x
    const ay = in_y + out_y
    const d_in = hypot(in_x, in_y)
    const d_out = hypot(out_x, out_y)
    const d_hypot = hypot(ax, ay)
    return (d_in + d_out - d_hypot) < (d_hypot >> 4)
}

// ---------------------------------------------------------------------------
// Vectors and matrices in C memory (FT_Vector: x, y; FT_Matrix: xx, xy,
// yx, yy).

pub fn transformX(x: i64, y: i64, matrix: usize) -> i64 { return mulFix(x, m.getI64(matrix)) +% mulFix(y, m.getI64(matrix + 8)) }
pub fn transformY(x: i64, y: i64, matrix: usize) -> i64 { return mulFix(x, m.getI64(matrix + 16)) +% mulFix(y, m.getI64(matrix + 24)) }

pub fn vectorTransform(vector: usize, matrix: usize) -> void {
    if vector == 0 || matrix == 0 { return }
    const x = m.getI64(vector)
    const y = m.getI64(vector + 8)
    m.putI64(vector, transformX(x, y, matrix))
    m.putI64(vector + 8, transformY(x, y, matrix))
}

// b = a * b.
pub fn matrixMultiply(a: usize, b: usize) -> void {
    if a == 0 || b == 0 { return }
    const axx = m.getI64(a)
    const axy = m.getI64(a + 8)
    const ayx = m.getI64(a + 16)
    const ayy = m.getI64(a + 24)
    const bxx = m.getI64(b)
    const bxy = m.getI64(b + 8)
    const byx = m.getI64(b + 16)
    const byy = m.getI64(b + 24)
    m.putI64(b, mulFix(axx, bxx) +% mulFix(axy, byx))
    m.putI64(b + 8, mulFix(axx, bxy) +% mulFix(axy, byy))
    m.putI64(b + 16, mulFix(ayx, bxx) +% mulFix(ayy, byx))
    m.putI64(b + 24, mulFix(ayx, bxy) +% mulFix(ayy, byy))
}

// Inverts the matrix; false when it has no inverse.
pub fn matrixInvert(matrix: usize) -> bool {
    if matrix == 0 { return false }
    const xx = m.getI64(matrix)
    const xy = m.getI64(matrix + 8)
    const yx = m.getI64(matrix + 16)
    const yy = m.getI64(matrix + 24)
    const delta = mulFix(xx, yy) -% mulFix(xy, yx)
    if delta == 0 { return false }
    m.putI64(matrix + 8, 0 -% divFix(xy, delta))
    m.putI64(matrix + 16, 0 -% divFix(yx, delta))
    m.putI64(matrix, divFix(yy, delta))
    m.putI64(matrix + 24, divFix(xx, delta))
    return true
}

// ---------------------------------------------------------------------------
// The exported functions of freetype.h and fttrigon.h.

export fn FT_MulDiv(a: i64, b: i64, c: i64) -> i64 { return mulDiv(a, b, c) }
export fn FT_MulFix(a: i64, b: i64) -> i64 { return mulFix(a, b) }
export fn FT_DivFix(a: i64, b: i64) -> i64 { return divFix(a, b) }
export fn FT_RoundFix(a: i64) -> i64 { return roundFix(a) }
export fn FT_CeilFix(a: i64) -> i64 { return ceilFix(a) }
export fn FT_FloorFix(a: i64) -> i64 { return floorFix(a) }
export fn FT_Vector_Transform(vector: usize, matrix: usize) -> void { vectorTransform(vector, matrix) }
export fn FT_Matrix_Multiply(a: usize, b: usize) -> void { matrixMultiply(a, b) }
export fn FT_Matrix_Invert(matrix: usize) -> i32 { return if matrixInvert(matrix) { 0 } else { 6 } }

export fn FT_Sin(angle: i64) -> i64 { return sin(angle) }
export fn FT_Cos(angle: i64) -> i64 { return cos(angle) }
export fn FT_Tan(angle: i64) -> i64 { return tan(angle) }
export fn FT_Atan2(x: i64, y: i64) -> i64 { return atan2(x, y) }
export fn FT_Angle_Diff(angle1: i64, angle2: i64) -> i64 { return angleDiff(angle1, angle2) }

export fn FT_Vector_Unit(vec: usize, angle: i64) -> void {
    if vec == 0 { return }
    const v = vectorUnit(angle)
    m.putI64(vec, v.0)
    m.putI64(vec + 8, v.1)
}

export fn FT_Vector_Rotate(vec: usize, angle: i64) -> void {
    if vec == 0 || angle == 0 { return }
    const v = vectorRotate(m.getI64(vec), m.getI64(vec + 8), angle)
    m.putI64(vec, v.0)
    m.putI64(vec + 8, v.1)
}

export fn FT_Vector_Length(vec: usize) -> i64 {
    if vec == 0 { return 0 }
    return vectorLength(m.getI64(vec), m.getI64(vec + 8))
}

export fn FT_Vector_Polarize(vec: usize, length: usize, angle: usize) -> void {
    if vec == 0 || length == 0 || angle == 0 { return }
    const p = vectorPolarize(m.getI64(vec), m.getI64(vec + 8))
    if !p.2 { return }
    m.putI64(length, p.0)
    m.putI64(angle, p.1)
}

export fn FT_Vector_From_Polar(vec: usize, length: i64, angle: i64) -> void {
    if vec == 0 { return }
    const v = vectorRotate(length, 0, angle)
    m.putI64(vec, v.0)
    m.putI64(vec + 8, v.1)
}
