// The public structures of FreeType's API as the library reads and writes
// them: the same layout as the C headers give them (Mlx lays a structure
// out as C does), their nested structures written out field by field.
// A pointer from C becomes one of these with `faceRec(address)`.

// FT_FaceRec
pub const FaceRec = struct {
    num_faces: i64
    face_index: i64
    face_flags: i64
    style_flags: i64
    num_glyphs: i64
    family_name: usize
    style_name: usize
    num_fixed_sizes: i32
    available_sizes: usize
    num_charmaps: i32
    charmaps: usize
    generic_data: usize
    generic_finalizer: usize
    bbox_xMin: i64
    bbox_yMin: i64
    bbox_xMax: i64
    bbox_yMax: i64
    units_per_EM: u16
    ascender: i16
    descender: i16
    height: i16
    max_advance_width: i16
    max_advance_height: i16
    underline_position: i16
    underline_thickness: i16
    glyph: usize
    size: usize
    charmap: usize
    driver: usize
    memory: usize
    stream: usize
    sizes_head: usize
    sizes_tail: usize
    autohint_data: usize
    autohint_finalizer: usize
    extensions: usize
    internal: usize
}

// FT_SizeRec
pub const SizeRec = struct {
    face: usize
    generic_data: usize
    generic_finalizer: usize
    x_ppem: u16
    y_ppem: u16
    x_scale: i64
    y_scale: i64
    ascender: i64
    descender: i64
    height: i64
    max_advance: i64
    internal: usize
}

// FT_GlyphSlotRec
pub const SlotRec = struct {
    library: usize
    face: usize
    next: usize
    glyph_index: u32
    generic_data: usize
    generic_finalizer: usize
    width: i64
    height: i64
    horiBearingX: i64
    horiBearingY: i64
    horiAdvance: i64
    vertBearingX: i64
    vertBearingY: i64
    vertAdvance: i64
    linearHoriAdvance: i64
    linearVertAdvance: i64
    advance_x: i64
    advance_y: i64
    format: u32
    format_pad: u32
    bitmap_rows: u32
    bitmap_width: u32
    bitmap_pitch: i32
    bitmap_buffer: usize
    bitmap_num_grays: u16
    bitmap_pixel_mode: u8
    bitmap_palette_mode: u8
    bitmap_palette: usize
    bitmap_left: i32
    bitmap_top: i32
    n_contours: i16
    n_points: i16
    points: usize
    tags: usize
    contours: usize
    outline_flags: i32
    outline_pad: u32
    num_subglyphs: u32
    subglyphs: usize
    control_data: usize
    control_len: i64
    lsb_delta: i64
    rsb_delta: i64
    other: usize
    internal: usize
}

// The offsets of FT_GlyphSlotRec's bitmap and outline (FT_Bitmap and
// FT_Outline in place).
pub const SLOT_METRICS: usize = 48
pub const SLOT_BITMAP: usize = 152
pub const SLOT_OUTLINE: usize = 200

// FT_CharMapRec
pub const CharMapRec = struct {
    face: usize
    encoding: u32
    platform_id: u16
    encoding_id: u16
}

// FT_Bitmap
pub const Bitmap = struct {
    rows: u32
    width: u32
    pitch: i32
    buffer: usize
    num_grays: u16
    pixel_mode: u8
    palette_mode: u8
    palette: usize
}

// FT_Outline
pub const Outline = struct {
    n_contours: i16
    n_points: i16
    points: usize
    tags: usize
    contours: usize
    flags: i32
}

pub fn faceRec(address: usize) -> *FaceRec { unsafe { return @ptrFromInt(*FaceRec, address) } }
pub fn sizeRec(address: usize) -> *SizeRec { unsafe { return @ptrFromInt(*SizeRec, address) } }
pub fn slotRec(address: usize) -> *SlotRec { unsafe { return @ptrFromInt(*SlotRec, address) } }
pub fn charMapRec(address: usize) -> *CharMapRec { unsafe { return @ptrFromInt(*CharMapRec, address) } }
pub fn bitmap(address: usize) -> *Bitmap { unsafe { return @ptrFromInt(*Bitmap, address) } }
pub fn outline(address: usize) -> *Outline { unsafe { return @ptrFromInt(*Outline, address) } }

pub const FACE_REC_SIZE: usize = 248
pub const SIZE_REC_SIZE: usize = 88
pub const SLOT_REC_SIZE: usize = 304
pub const CHARMAP_REC_SIZE: usize = 16

