// CFF and CFF2 fonts.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")

pub fn load(face: usize, offset: u64, length: u64, isCff2: bool) -> i32 { return r.ERR_UNIMPLEMENTED_FEATURE }
pub fn numGlyphs(face: usize) -> i64 { return 0 }
pub fn finishFace(face: usize) -> void {}
pub fn loadGlyph(face: usize, size: usize, slot: usize, gindex: i64, loadFlags: i64) -> i32 { return r.ERR_UNIMPLEMENTED_FEATURE }
pub fn done(face: usize) -> void {}
pub fn glyphName(face: usize, gindex: i64) -> usize { return 0 }
pub fn nameIndex(face: usize, name: usize) -> i64 { return 0 }
pub fn hasGlyphNames(face: usize) -> i32 { return 0 }
pub fn fontInfo(face: usize, info: usize) -> i32 { return r.ERR_INVALID_ARGUMENT }
pub fn fsType(face: usize) -> i64 { return 0 }
pub fn registryOrderingSupplement(face: usize) -> (i32, usize, usize, i64) { return -> (r.ERR_INVALID_ARGUMENT, 0, 0, 0) }
pub fn isCid(face: usize) -> bool { return false }
pub fn cidOfGlyph(face: usize, gindex: i64) -> (i32, i64) { return -> (r.ERR_INVALID_ARGUMENT, 0) }
