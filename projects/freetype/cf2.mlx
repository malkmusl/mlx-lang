// The Type 2 charstring engine of FreeType's CFF driver (Adobe's engine,
// FreeType's psaux cf2_* files), computed as it computes it in 16.16
// fixed point of 32 bits: the interpreter (operators, subroutines, flex,
// seac, CFF2 blend), the stem hints and hint masks, the hint maps that
// fit the stems' edges to the pixel grid and the blue zones, the glyph
// path that maps each point through the current hint map and joins the
// segments, and stem darkening. Unhinted, a glyph's points come out in
// font units (FreeType's scale of 1/64 then `>> 10`); hinted, in 26.6
// pixels.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const calc = @import("./calc.mlx")
const cffload = @import("./cffload.mlx")
const o = @import("./objects.mlx")

// ---------------------------------------------------------------------------
// 32-bit arithmetic as FreeType's ADD_INT32 and the like.

fn add32(a: i64, b: i64) -> i64 { return calc.low32(a +% b) }
fn sub32(a: i64, b: i64) -> i64 { return calc.low32(a -% b) }
fn neg32(a: i64) -> i64 { return calc.low32(0 -% a) }
fn mul32(a: i64, b: i64) -> i64 { return calc.low32(a *% b) }
fn intToFixed(i: i64) -> i64 { return calc.low32(@bitCast(i64, (@bitCast(u64, i) & 0xFFFFFFFF) << 16)) }
fn fixedToInt(x: i64) -> i64 { return calc.low16(@bitCast(i64, ((@bitCast(u64, x) & 0xFFFFFFFF) +% 0x8000) >> 16)) }
fn fixedRound(x: i64) -> i64 { return calc.low32(@bitCast(i64, ((@bitCast(u64, x) & 0xFFFFFFFF) +% 0x8000) & 0xFFFF0000)) }
fn fixedFloor(x: i64) -> i64 { return calc.low32(@bitCast(i64, @bitCast(u64, x) & 0xFFFF0000)) }
fn fixedFraction(x: i64) -> i64 { return calc.low32(x -% fixedFloor(x)) }
fn fixedAbs(x: i64) -> i64 { return if x < 0 { neg32(x) } else { x } }
fn mulFix(a: i64, b: i64) -> i64 { return calc.mulFix(a, b) }
fn divFix(a: i64, b: i64) -> i64 { return calc.low32(calc.divFix(a, b)) }

const FIXED_MAX: i64 = 0x7FFFFFFF
const FIXED_EPSILON: i64 = 1
const MIN_COUNTER: i64 = 32768
const ICF_TOP: i64 = 880 << 16
const ICF_BOTTOM: i64 = -120 << 16

const MAX_HINTS: i64 = 96
const MAX_EDGES: usize = 192
const OPERAND_STACK_SIZE: i64 = 48
const MAX_SUBR: i64 = 16
const STORAGE_SIZE: i64 = 32

const GHOST_BOTTOM: i64 = 0x1
const GHOST_TOP: i64 = 0x2
const PAIR_BOTTOM: i64 = 0x4
const PAIR_TOP: i64 = 0x8
const LOCKED: i64 = 0x10
const SYNTHETIC: i64 = 0x20

const ERR_INVALID_GLYPH_FORMAT: i32 = 0x12
const ERR_STACK_OVERFLOW: i32 = 0x82
const ERR_STACK_UNDERFLOW: i32 = 0xA1
const ERR_SYNTAX_ERROR: i32 = 0xA0

// ---------------------------------------------------------------------------
// The records.

pub const Hint = struct {
    flags: i64
    index: i64
    csCoord: i64
    dsCoord: i64
    scale: i64
}

const Zone = struct {
    csBottomEdge: i64
    csTopEdge: i64
    csFlatEdge: i64
    dsFlatEdge: i64
    bottomZone: bool
}

const Blues = struct {
    scale: i64
    count: i64
    suppressOvershoot: bool
    doEmBoxHints: bool
    blueScale: i64
    blueShift: i64
    blueFuzz: i64
    boost: i64
    emBoxTopEdge: Hint
    emBoxBottomEdge: Hint
    zone: [12]Zone
}

// A growable array of records of `words` words (FreeType's arrstack):
// stem hints (used, min, max, minDS, maxDS) and hint moves (j, moveUp).
const Array = struct {
    ptr: usize
    count: i64
    allocated: i64
    words: i64
}

pub const HintMap = struct {
    initialHintMap: usize
    isValid: bool
    hinted: bool
    scale: i64
    count: i64
    lastIndex: i64
    edge: [192]Hint
}

const HintMask = struct {
    isValid: bool
    isNew: bool
    bitCount: i64
    byteCount: i64
    mask: [12]u8
}

const PATH_MOVE: i64 = 0
const PATH_LINE: i64 = 1
const PATH_CUBE: i64 = 2

const GlyphPath = struct {
    hintMap: HintMap
    firstHintMap: HintMap
    initialHintMap: HintMap
    hintMoves: Array
    scaleX: i64
    scaleC: i64
    scaleY: i64
    fracX: i64
    fracY: i64
    pathIsOpen: bool
    pathIsClosing: bool
    darken: bool
    moveIsPending: bool
    hStems: *Array
    vStems: *Array
    hintMask: *HintMask
    hintOriginY: i64
    xOffset: i64
    yOffset: i64
    miterLimit: i64
    snapThreshold: i64
    offsetStart0X: i64
    offsetStart0Y: i64
    offsetStart1X: i64
    offsetStart1Y: i64
    currentCSX: i64
    currentCSY: i64
    currentDSX: i64
    currentDSY: i64
    startX: i64
    startY: i64
    elemIsQueued: bool
    prevElemOp: i64
    p0x: i64
    p0y: i64
    p1x: i64
    p1y: i64
    p2x: i64
    p2y: i64
    p3x: i64
    p3y: i64
}

// What the engine works with (FreeType's CF2_Font and the decoder).
pub const Engine = struct {
    font: *cffload.Font
    sub: *cffload.SubFont
    isCFF2: bool
    hinted: bool
    scaled: bool
    stemDarkened: bool
    darkened: bool
    reverseWinding: bool
    darkenX: i64
    darkenY: i64
    darkenParams: [8]i64
    unitsPerEm: i64
    ppem: i64
    scaleX: i64
    scaleY: i64
    stdVW: i64
    stdHW: i64
    err: i32
    blues: Blues
    // CFF2's blend of the glyph (FreeType's CF2_Font blend).
    blend: cffload.SubFont
    vsindex: i64
    lenNDV: u64
    ndv: usize
    // Subroutines: the address tables (count + 1 entries) and biases.
    globals: usize
    numGlobals: i64
    globalsBias: i64
    locals: usize
    numLocals: i64
    localsBias: i64
    nominalWidthX: i64
    defaultWidthX: i64
    widthOnly: bool
    glyphWidth: i64
    windingMomentum: i64
    // The outline: the slot's storage (points of 16 bytes, tags,
    // contours), and the builder's state.
    memory: usize
    storage: usize
    ensure: usize
    nPoints: i64
    nContours: i64
    pathBegun: bool
}

pub const Ensure = fn(usize, usize, i64, i64) -> bool

fn setError(e: *Engine, err: i32) -> void { if e.*.err == r.OK { e.*.err = err } }

// ---------------------------------------------------------------------------
// The outline builder (FreeType's ps_builder functions with the cf2
// callbacks).

fn storageOf(e: *Engine) -> (usize, usize, usize) {
    const s: *o.Slot = unsafe { @ptrFromInt(*o.Slot, e.*.storage) }
    return -> (s.*.points, s.*.tags, s.*.contours)
}

fn checkPoints(e: *Engine, points: i64, contours: i64) -> i32 {
    if e.*.nPoints + points > 0x7FFF || e.*.nContours + contours > 0x7FFF { return r.ERR_ARRAY_TOO_LARGE }
    const call: Ensure = unsafe { @ptrFromInt(Ensure, e.*.ensure) }
    if !call(e.*.memory, e.*.storage, e.*.nPoints + points, e.*.nContours + contours) { return r.ERR_OUT_OF_MEMORY }
    return r.OK
}

fn addPoint(e: *Engine, x: i64, y: i64, on: bool) -> void {
    const s = storageOf(e)
    const at = s.0 + @intCast(usize, e.*.nPoints) * 16
    m.putI64(at, x >> 10)
    m.putI64(at + 8, y >> 10)
    m.put8(s.1 + @intCast(usize, e.*.nPoints), if on { 1 } else { 2 })
    e.*.nPoints += 1
}

fn addPoint1(e: *Engine, x: i64, y: i64) -> i32 {
    const err = checkPoints(e, 1, 0)
    if err == r.OK { addPoint(e, x, y, true) }
    return err
}

fn setContourEnd(e: *Engine, c: i64, value: i64) -> void {
    m.putI16(storageOf(e).2 + @intCast(usize, c) * 2, @intCast(i16, calc.low16(value)))
}

fn contourEnd(e: *Engine, c: i64) -> i64 { return @intCast(i64, m.getI16(storageOf(e).2 + @intCast(usize, c) * 2)) }

fn addContour(e: *Engine) -> i32 {
    const err = checkPoints(e, 0, 1)
    if err == r.OK {
        if e.*.nContours > 0 { setContourEnd(e, e.*.nContours - 1, e.*.nPoints - 1) }
        e.*.nContours += 1
    }
    return err
}

fn startPoint(e: *Engine, x: i64, y: i64) -> i32 {
    var err = r.OK
    if !e.*.pathBegun {
        e.*.pathBegun = true
        err = addContour(e)
        if err == r.OK { err = addPoint1(e, x, y) }
    }
    return err
}

fn closeContour(e: *Engine) -> void {
    const first = if e.*.nContours <= 1 { 0 } else { contourEnd(e, e.*.nContours - 2) + 1 }
    if e.*.nContours != 0 && first == e.*.nPoints {
        e.*.nContours -= 1
        return
    }
    if e.*.nPoints > 1 {
        const s = storageOf(e)
        const p1 = s.0 + @intCast(usize, first) * 16
        const p2 = s.0 + @intCast(usize, e.*.nPoints - 1) * 16
        if m.getI64(p1) == m.getI64(p2) && m.getI64(p1 + 8) == m.getI64(p2 + 8) {
            if m.get8(s.1 + @intCast(usize, e.*.nPoints - 1)) == 1 { e.*.nPoints -= 1 }
        }
    }
    if e.*.nContours > 0 {
        if first == e.*.nPoints - 1 {
            e.*.nContours -= 1
            e.*.nPoints -= 1
        } else {
            setContourEnd(e, e.*.nContours - 1, e.*.nPoints - 1)
        }
    }
}

fn outMoveTo(e: *Engine) -> void {
    closeContour(e)
    e.*.pathBegun = false
}

fn outLineTo(e: *Engine, x0: i64, y0: i64, x1: i64, y1: i64) -> void {
    if !e.*.pathBegun {
        const err = startPoint(e, x0, y0)
        if err != r.OK {
            setError(e, err)
            return
        }
    }
    const err = addPoint1(e, x1, y1)
    if err != r.OK { setError(e, err) }
}

fn outCubeTo(e: *Engine, x0: i64, y0: i64, x1: i64, y1: i64, x2: i64, y2: i64, x3: i64, y3: i64) -> void {
    if !e.*.pathBegun {
        const err = startPoint(e, x0, y0)
        if err != r.OK {
            setError(e, err)
            return
        }
    }
    const err = checkPoints(e, 3, 0)
    if err != r.OK {
        setError(e, err)
        return
    }
    addPoint(e, x1, y1, false)
    addPoint(e, x2, y2, false)
    addPoint(e, x3, y3, true)
}

// ---------------------------------------------------------------------------
// Growable arrays.

fn arrayPush(e: *Engine, a: *Array, values: usize) -> void {
    if a.*.count == a.*.allocated {
        const n = a.*.allocated * 2 + 16
        const grown = m.grow(e.*.memory, a.*.ptr, @intCast(usize, a.*.allocated * a.*.words) * 8, @intCast(usize, n * a.*.words) * 8)
        if grown == 0 {
            setError(e, r.ERR_OUT_OF_MEMORY)
            return
        }
        a.*.ptr = grown
        a.*.allocated = n
    }
    m.copy(a.*.ptr + @intCast(usize, a.*.count * a.*.words) * 8, values, @intCast(usize, a.*.words) * 8)
    a.*.count += 1
}

fn arrayAt(e: *Engine, a: *Array, i_: i64) -> usize {
    var i = i_
    if i >= a.*.count {
        setError(e, ERR_STACK_OVERFLOW)
        i = 0
    }
    return a.*.ptr + @intCast(usize, i * a.*.words) * 8
}

// A stem hint: used, min, max, minDS, maxDS.
const S_USED: usize = 0
const S_MIN: usize = 8
const S_MAX: usize = 16
const S_MINDS: usize = 24
const S_MAXDS: usize = 32

// ---------------------------------------------------------------------------
// Hints and hint maps (FreeType's pshints.c).

fn isValid(h: *Hint) -> bool { return h.*.flags != 0 }
fn isPair(h: *Hint) -> bool { return (h.*.flags & (PAIR_BOTTOM | PAIR_TOP)) != 0 }
fn isPairTop(h: *Hint) -> bool { return (h.*.flags & PAIR_TOP) != 0 }
fn isTop(h: *Hint) -> bool { return (h.*.flags & (PAIR_TOP | GHOST_TOP)) != 0 }
fn isBottom(h: *Hint) -> bool { return (h.*.flags & (PAIR_BOTTOM | GHOST_BOTTOM)) != 0 }
fn isLocked(h: *Hint) -> bool { return (h.*.flags & LOCKED) != 0 }
fn isSynthetic(h: *Hint) -> bool { return (h.*.flags & SYNTHETIC) != 0 }
fn zeroHint(h: *Hint) -> void { m.zero(@intFromPtr(h), @sizeOf(Hint)) }

fn hintInit(e: *Engine, hint: *Hint, stems: *Array, index: i64, hintOrigin: i64, scale: i64, bottom: bool) -> void {
    zeroHint(hint)
    const stem = arrayAt(e, stems, index)
    const smin = m.getI64(stem + S_MIN)
    const smax = m.getI64(stem + S_MAX)
    const width = sub32(smax, smin)
    if width == intToFixed(-21) {
        if bottom {
            hint.*.csCoord = smax
            hint.*.flags = GHOST_BOTTOM
        } else {
            hint.*.flags = 0
        }
    } else if width == intToFixed(-20) {
        if bottom {
            hint.*.flags = 0
        } else {
            hint.*.csCoord = smin
            hint.*.flags = GHOST_TOP
        }
    } else if width < 0 {
        if bottom {
            hint.*.csCoord = smax
            hint.*.flags = PAIR_BOTTOM
        } else {
            hint.*.csCoord = smin
            hint.*.flags = PAIR_TOP
        }
    } else {
        if bottom {
            hint.*.csCoord = smin
            hint.*.flags = PAIR_BOTTOM
        } else {
            hint.*.csCoord = smax
            hint.*.flags = PAIR_TOP
        }
    }
    if isTop(hint) { hint.*.csCoord = add32(hint.*.csCoord, 2 * e.*.darkenY) }
    hint.*.csCoord = add32(hint.*.csCoord, hintOrigin)
    hint.*.scale = scale
    hint.*.index = index
    if hint.*.flags != 0 && m.getI64(stem + S_USED) != 0 {
        hint.*.dsCoord = if isTop(hint) { m.getI64(stem + S_MAXDS) } else { m.getI64(stem + S_MINDS) }
        hint.*.flags |= LOCKED
    } else {
        hint.*.dsCoord = mulFix(hint.*.csCoord, scale)
    }
}

fn mapOf(address: usize) -> *HintMap { unsafe { return @ptrFromInt(*HintMap, address) } }

fn hintmapInit(map: *HintMap, e: *Engine, initial: usize, scale: i64) -> void {
    m.zero(@intFromPtr(map), @sizeOf(HintMap))
    map.*.hinted = e.*.hinted
    map.*.scale = scale
    map.*.initialHintMap = initial
}

fn hintmapMap(map: *HintMap, csCoord: i64) -> i64 {
    if map.*.count == 0 || !map.*.hinted { return mulFix(csCoord, map.*.scale) }
    var i = map.*.lastIndex
    while i < map.*.count - 1 && csCoord >= map.*.edge[@intCast(usize, i + 1)].csCoord { i += 1 }
    while i > 0 && csCoord < map.*.edge[@intCast(usize, i)].csCoord { i -= 1 }
    map.*.lastIndex = i
    const edge = &map.*.edge[@intCast(usize, i)]
    if i == 0 && csCoord < map.*.edge[0].csCoord { return add32(mulFix(sub32(csCoord, map.*.edge[0].csCoord), map.*.scale), map.*.edge[0].dsCoord) }
    return add32(mulFix(sub32(csCoord, edge.*.csCoord), edge.*.scale), edge.*.dsCoord)
}

fn hintmapAdjustHints(e: *Engine, map: *HintMap, moves: *Array) -> void {
    moves.*.count = 0
    var i: i64 = 0
    while i < map.*.count {
        const ei = &map.*.edge[@intCast(usize, i)]
        const pair = isPair(ei)
        var move: i64 = 0
        const j = if pair { i + 1 } else { i }
        const ej = &map.*.edge[@intCast(usize, j)]
        const dsI = ei.*.dsCoord
        const dsJ = ej.*.dsCoord
        if !isLocked(ei) {
            const fracDown = fixedFraction(dsI)
            const fracUp = fixedFraction(dsJ)
            const downMoveDown = 0 - fracDown
            const upMoveDown = 0 - fracUp
            const downMoveUp = if fracDown == 0 { 0 } else { intToFixed(1) - fracDown }
            const upMoveUp = if fracUp == 0 { 0 } else { intToFixed(1) - fracUp }
            const moveUp = calc.min(downMoveUp, upMoveUp)
            const moveDown = calc.max(downMoveDown, upMoveDown)
            var saveEdge = false
            if j >= map.*.count - 1 || map.*.edge[@intCast(usize, j + 1)].dsCoord >= add32(dsJ, moveUp + MIN_COUNTER) {
                if i == 0 || map.*.edge[@intCast(usize, i - 1)].dsCoord <= add32(dsI, moveDown - MIN_COUNTER) {
                    move = if 0 - moveDown < moveUp { moveDown } else { moveUp }
                } else {
                    move = moveUp
                }
            } else {
                if i == 0 || map.*.edge[@intCast(usize, i - 1)].dsCoord <= add32(dsI, moveDown - MIN_COUNTER) {
                    move = moveDown
                    saveEdge = moveUp < 0 - moveDown
                } else {
                    move = 0
                    saveEdge = true
                }
            }
            if saveEdge && j < map.*.count - 1 && !isLocked(&map.*.edge[@intCast(usize, j + 1)]) {
                var saved: [2]i64 = undefined
                saved[0] = j
                saved[1] = moveUp - move
                arrayPush(e, moves, @intFromPtr(&saved[0]))
            }
            ei.*.dsCoord = add32(dsI, move)
            if pair { ej.*.dsCoord = add32(dsJ, move) }
        }
        if i > 0 {
            const prev = &map.*.edge[@intCast(usize, i - 1)]
            if ei.*.csCoord != prev.*.csCoord { prev.*.scale = divFix(sub32(ei.*.dsCoord, prev.*.dsCoord), sub32(ei.*.csCoord, prev.*.csCoord)) }
        }
        if pair {
            const prev = &map.*.edge[@intCast(usize, j - 1)]
            if ej.*.csCoord != prev.*.csCoord { prev.*.scale = divFix(sub32(ej.*.dsCoord, prev.*.dsCoord), sub32(ej.*.csCoord, prev.*.csCoord)) }
            i += 1
        }
        i += 1
    }
    var k = moves.*.count
    while k > 0 {
        const mv = moves.*.ptr + @intCast(usize, (k - 1) * 2) * 8
        const j = m.getI64(mv)
        const moveUp = m.getI64(mv + 8)
        const ej = &map.*.edge[@intCast(usize, j)]
        if map.*.edge[@intCast(usize, j + 1)].dsCoord >= add32(ej.*.dsCoord, moveUp + MIN_COUNTER) {
            ej.*.dsCoord = add32(ej.*.dsCoord, moveUp)
            if isPair(ej) {
                const prev = &map.*.edge[@intCast(usize, j - 1)]
                prev.*.dsCoord = add32(prev.*.dsCoord, moveUp)
            }
        }
        k -= 1
    }
}

fn hintmapInsertHint(map: *HintMap, bottom: *Hint, top: *Hint) -> void {
    var pair = true
    var first = bottom
    const second = top
    if !isValid(bottom) {
        first = top
        pair = false
    } else if !isValid(top) {
        pair = false
    }
    if pair && top.*.csCoord < bottom.*.csCoord { return }
    var indexInsert: i64 = 0
    while indexInsert < map.*.count {
        if map.*.edge[@intCast(usize, indexInsert)].csCoord >= first.*.csCoord { break }
        indexInsert += 1
    }
    if indexInsert < map.*.count {
        const at = &map.*.edge[@intCast(usize, indexInsert)]
        if at.*.csCoord == first.*.csCoord { return }
        if pair && at.*.csCoord <= second.*.csCoord { return }
        if isPairTop(at) { return }
    }
    const initial = mapOf(map.*.initialHintMap)
    if initial.*.isValid && !isLocked(first) {
        if pair {
            const midpoint = hintmapMap(initial, add32(first.*.csCoord, sub32(second.*.csCoord, first.*.csCoord) / 2))
            const halfWidth = mulFix(sub32(second.*.csCoord, first.*.csCoord) / 2, map.*.scale)
            first.*.dsCoord = sub32(midpoint, halfWidth)
            second.*.dsCoord = add32(midpoint, halfWidth)
        } else {
            first.*.dsCoord = hintmapMap(initial, first.*.csCoord)
        }
    }
    if indexInsert > 0 {
        if first.*.dsCoord < map.*.edge[@intCast(usize, indexInsert - 1)].dsCoord { return }
    }
    if indexInsert < map.*.count {
        if pair {
            if second.*.dsCoord > map.*.edge[@intCast(usize, indexInsert)].dsCoord { return }
        } else {
            if first.*.dsCoord > map.*.edge[@intCast(usize, indexInsert)].dsCoord { return }
        }
    }
    var iSrc = map.*.count - 1
    var iDst = if pair { map.*.count + 1 } else { map.*.count }
    var count = map.*.count - indexInsert
    if iDst >= @intCast(i64, MAX_EDGES) { return }
    while count > 0 {
        map.*.edge[@intCast(usize, iDst)] = map.*.edge[@intCast(usize, iSrc)]
        iDst -= 1
        iSrc -= 1
        count -= 1
    }
    map.*.edge[@intCast(usize, indexInsert)] = first.*
    map.*.count += 1
    if pair {
        map.*.edge[@intCast(usize, indexInsert + 1)] = second.*
        map.*.count += 1
    }
}

fn maskInit(mask: *HintMask) -> void { m.zero(@intFromPtr(mask), @sizeOf(HintMask)) }

fn maskSetCounts(e: *Engine, mask: *HintMask, bitCount: i64) -> i64 {
    if bitCount > MAX_HINTS {
        setError(e, ERR_INVALID_GLYPH_FORMAT)
        return 0
    }
    mask.*.bitCount = bitCount
    mask.*.byteCount = (bitCount + 7) / 8
    mask.*.isValid = true
    mask.*.isNew = true
    return bitCount
}

fn maskRead(e: *Engine, mask: *HintMask, buf: usize, bitCount: i64) -> void {
    if maskSetCounts(e, mask, bitCount) == 0 { return }
    var i: i64 = 0
    while i < mask.*.byteCount {
        mask.*.mask[@intCast(usize, i)] = @intCast(u8, readByte(buf))
        i += 1
    }
}

fn maskSetAll(e: *Engine, mask: *HintMask, bitCount: i64) -> void {
    const bits = (0 - bitCount) & 7
    const pad = (@intCast(i64, 1) << @intCast(u6, bits)) - 1
    if maskSetCounts(e, mask, bitCount) == 0 { return }
    var i: i64 = 0
    while i < mask.*.byteCount {
        mask.*.mask[@intCast(usize, i)] = 0xFF
        i += 1
    }
    const last = @intCast(usize, mask.*.byteCount - 1)
    mask.*.mask[last] = @intCast(u8, @intCast(i64, mask.*.mask[last]) & ~pad & 0xFF)
}

fn hintmapBuild(e: *Engine, map: *HintMap, moves: *Array, hStems: *Array, vStems: *Array, mask: *HintMask, hintOrigin: i64, initialMap: bool) -> void {
    const initial = mapOf(map.*.initialHintMap)
    if !initialMap && !initial.*.isValid {
        var temp: HintMask = undefined
        maskInit(&temp)
        hintmapBuild(e, initial, moves, hStems, vStems, &temp, hintOrigin, true)
    }
    if !mask.*.isValid {
        maskSetAll(e, mask, hStems.*.count + vStems.*.count)
        if !mask.*.isValid { return }
    }
    map.*.count = 0
    map.*.lastIndex = 0
    var temp = mask.*
    const bitCount = hStems.*.count
    if bitCount > mask.*.bitCount { return }
    if e.*.blues.doEmBoxHints {
        var dummy: Hint = undefined
        zeroHint(&dummy)
        var bottomEdge = e.*.blues.emBoxBottomEdge
        var topEdge = e.*.blues.emBoxTopEdge
        hintmapInsertHint(map, &bottomEdge, &dummy)
        hintmapInsertHint(map, &dummy, &topEdge)
    }
    var i: i64 = 0
    var byteIndex: usize = 0
    var maskByte: u8 = 0x80
    while i < bitCount {
        if (maskByte & temp.mask[byteIndex]) != 0 {
            var bottomEdge: Hint = undefined
            var topEdge: Hint = undefined
            hintInit(e, &bottomEdge, hStems, i, hintOrigin, map.*.scale, true)
            hintInit(e, &topEdge, hStems, i, hintOrigin, map.*.scale, false)
            if isLocked(&bottomEdge) || isLocked(&topEdge) || bluesCapture(e, &bottomEdge, &topEdge) {
                hintmapInsertHint(map, &bottomEdge, &topEdge)
                temp.mask[byteIndex] = temp.mask[byteIndex] & ~maskByte
            }
        }
        if (i & 7) == 7 {
            byteIndex += 1
            maskByte = 0x80
        } else {
            maskByte >>= 1
        }
        i += 1
    }
    if initialMap {
        if map.*.count == 0 || map.*.edge[0].csCoord > 0 || map.*.edge[@intCast(usize, map.*.count - 1)].csCoord < 0 {
            var edge: Hint = undefined
            var invalid: Hint = undefined
            zeroHint(&edge)
            edge.flags = GHOST_BOTTOM | LOCKED | SYNTHETIC
            edge.scale = map.*.scale
            zeroHint(&invalid)
            hintmapInsertHint(map, &edge, &invalid)
        }
    } else {
        i = 0
        byteIndex = 0
        maskByte = 0x80
        while i < bitCount {
            if (maskByte & temp.mask[byteIndex]) != 0 {
                var bottomEdge: Hint = undefined
                var topEdge: Hint = undefined
                hintInit(e, &bottomEdge, hStems, i, hintOrigin, map.*.scale, true)
                hintInit(e, &topEdge, hStems, i, hintOrigin, map.*.scale, false)
                hintmapInsertHint(map, &bottomEdge, &topEdge)
            }
            if (i & 7) == 7 {
                byteIndex += 1
                maskByte = 0x80
            } else {
                maskByte >>= 1
            }
            i += 1
        }
    }
    hintmapAdjustHints(e, map, moves)
    if !initialMap {
        i = 0
        while i < map.*.count {
            const edge = &map.*.edge[@intCast(usize, i)]
            if !isSynthetic(edge) {
                const stem = arrayAt(e, hStems, edge.*.index)
                if isTop(edge) {
                    m.putI64(stem + S_MAXDS, edge.*.dsCoord)
                } else {
                    m.putI64(stem + S_MINDS, edge.*.dsCoord)
                }
                m.putI64(stem + S_USED, 1)
            }
            i += 1
        }
    }
    map.*.isValid = true
    mask.*.isNew = false
}

// ---------------------------------------------------------------------------
// Blue zones (FreeType's psblues.c).

fn bluesInit(e: *Engine) -> void {
    const b = &e.*.blues
    m.zero(@intFromPtr(b), @sizeOf(Blues))
    const pd = &e.*.sub.*.priv
    b.*.scale = e.*.scaleY
    b.*.blueScale = divFix(pd.*.blueScale, intToFixed(1000))
    b.*.blueShift = intToFixed(pd.*.blueShift)
    b.*.blueFuzz = intToFixed(pd.*.blueFuzz)
    const numBlueValues = @intCast(i64, pd.*.numBlueValues)
    const numOtherBlues = @intCast(i64, pd.*.numOtherBlues)
    const numFamilyBlues = @intCast(i64, pd.*.numFamilyBlues)
    const numFamilyOtherBlues = @intCast(i64, pd.*.numFamilyOtherBlues)
    const emBoxBottom = ICF_BOTTOM
    const emBoxTop = ICF_TOP
    var maxZoneHeight: i64 = 0
    if pd.*.languageGroup == 1 && (numBlueValues == 0 || (numBlueValues == 4 && intToFixed(pd.*.blueValues[0]) < emBoxBottom && intToFixed(pd.*.blueValues[1]) < emBoxBottom && intToFixed(pd.*.blueValues[2]) > emBoxTop && intToFixed(pd.*.blueValues[3]) > emBoxTop)) {
        b.*.emBoxBottomEdge.csCoord = emBoxBottom - FIXED_EPSILON
        b.*.emBoxBottomEdge.dsCoord = calc.low32(fixedRound(mulFix(b.*.emBoxBottomEdge.csCoord, b.*.scale)) - MIN_COUNTER)
        b.*.emBoxBottomEdge.scale = b.*.scale
        b.*.emBoxBottomEdge.flags = GHOST_BOTTOM | LOCKED | SYNTHETIC
        b.*.emBoxTopEdge.csCoord = calc.low32(emBoxTop + FIXED_EPSILON + 2 * e.*.darkenY)
        b.*.emBoxTopEdge.dsCoord = calc.low32(fixedRound(mulFix(b.*.emBoxTopEdge.csCoord, b.*.scale)) + MIN_COUNTER)
        b.*.emBoxTopEdge.scale = b.*.scale
        b.*.emBoxTopEdge.flags = GHOST_TOP | LOCKED | SYNTHETIC
        b.*.doEmBoxHints = true
        return
    }
    var i: i64 = 0
    while i < numBlueValues {
        const z = &b.*.zone[@intCast(usize, b.*.count)]
        z.*.csBottomEdge = intToFixed(pd.*.blueValues[@intCast(usize, i)])
        z.*.csTopEdge = intToFixed(pd.*.blueValues[@intCast(usize, i + 1)])
        const zoneHeight = sub32(z.*.csTopEdge, z.*.csBottomEdge)
        if zoneHeight < 0 {
            i += 2
            continue
        }
        if zoneHeight > maxZoneHeight { maxZoneHeight = zoneHeight }
        if i != 0 {
            z.*.csTopEdge = calc.low32(z.*.csTopEdge + 2 * e.*.darkenY)
            z.*.csBottomEdge = calc.low32(z.*.csBottomEdge + 2 * e.*.darkenY)
        }
        if i == 0 {
            z.*.bottomZone = true
            z.*.csFlatEdge = z.*.csTopEdge
        } else {
            z.*.bottomZone = false
            z.*.csFlatEdge = z.*.csBottomEdge
        }
        b.*.count += 1
        i += 2
    }
    i = 0
    while i < numOtherBlues {
        const z = &b.*.zone[@intCast(usize, b.*.count)]
        z.*.csBottomEdge = intToFixed(pd.*.otherBlues[@intCast(usize, i)])
        z.*.csTopEdge = intToFixed(pd.*.otherBlues[@intCast(usize, i + 1)])
        const zoneHeight = sub32(z.*.csTopEdge, z.*.csBottomEdge)
        if zoneHeight < 0 {
            i += 2
            continue
        }
        if zoneHeight > maxZoneHeight { maxZoneHeight = zoneHeight }
        z.*.bottomZone = true
        z.*.csFlatEdge = z.*.csTopEdge
        b.*.count += 1
        i += 2
    }
    const csUnitsPerPixel = divFix(intToFixed(1), b.*.scale)
    i = 0
    while i < b.*.count {
        const z = &b.*.zone[@intCast(usize, i)]
        const flatEdge = z.*.csFlatEdge
        if z.*.bottomZone {
            var minDiff = FIXED_MAX
            var j: i64 = 0
            while j < numFamilyOtherBlues {
                const flatFamilyEdge = intToFixed(pd.*.familyOtherBlues[@intCast(usize, j + 1)])
                const diff = fixedAbs(sub32(flatEdge, flatFamilyEdge))
                if diff < minDiff && diff < csUnitsPerPixel {
                    z.*.csFlatEdge = flatFamilyEdge
                    minDiff = diff
                    if diff == 0 { break }
                }
                j += 2
            }
            if numFamilyBlues >= 2 {
                const flatFamilyEdge = intToFixed(pd.*.familyBlues[1])
                const diff = fixedAbs(sub32(flatEdge, flatFamilyEdge))
                if diff < minDiff && diff < csUnitsPerPixel { z.*.csFlatEdge = flatFamilyEdge }
            }
        } else {
            var minDiff = FIXED_MAX
            var j: i64 = 2
            while j < numFamilyBlues {
                var flatFamilyEdge = intToFixed(pd.*.familyBlues[@intCast(usize, j)])
                flatFamilyEdge = calc.low32(flatFamilyEdge + 2 * e.*.darkenY)
                const diff = fixedAbs(sub32(flatEdge, flatFamilyEdge))
                if diff < minDiff && diff < csUnitsPerPixel {
                    z.*.csFlatEdge = flatFamilyEdge
                    minDiff = diff
                    if diff == 0 { break }
                }
                j += 2
            }
        }
        i += 1
    }
    if maxZoneHeight > 0 {
        if b.*.blueScale > divFix(intToFixed(1), maxZoneHeight) { b.*.blueScale = divFix(intToFixed(1), maxZoneHeight) }
    }
    if b.*.scale < b.*.blueScale {
        b.*.suppressOvershoot = true
        b.*.boost = calc.low32(39322 - calc.mulDiv(39322, b.*.scale, b.*.blueScale))
        if b.*.boost > 0x7FFF { b.*.boost = 0x7FFF }
    }
    if e.*.stemDarkened { b.*.boost = 0 }
    i = 0
    while i < b.*.count {
        const z = &b.*.zone[@intCast(usize, i)]
        if z.*.bottomZone {
            z.*.dsFlatEdge = fixedRound(mulFix(z.*.csFlatEdge, b.*.scale) - b.*.boost)
        } else {
            z.*.dsFlatEdge = fixedRound(mulFix(z.*.csFlatEdge, b.*.scale) + b.*.boost)
        }
        i += 1
    }
}

fn bluesCapture(e: *Engine, bottom: *Hint, top: *Hint) -> bool {
    const b = &e.*.blues
    const csFuzz = b.*.blueFuzz
    var dsMove: i64 = 0
    var captured = false
    var i: i64 = 0
    while i < b.*.count {
        const z = &b.*.zone[@intCast(usize, i)]
        if z.*.bottomZone && isBottom(bottom) {
            if sub32(z.*.csBottomEdge, csFuzz) <= bottom.*.csCoord && bottom.*.csCoord <= add32(z.*.csTopEdge, csFuzz) {
                var dsNew: i64 = 0
                if b.*.suppressOvershoot {
                    dsNew = z.*.dsFlatEdge
                } else if sub32(z.*.csTopEdge, bottom.*.csCoord) >= b.*.blueShift {
                    dsNew = calc.min(fixedRound(bottom.*.dsCoord), sub32(z.*.dsFlatEdge, intToFixed(1)))
                } else {
                    dsNew = fixedRound(bottom.*.dsCoord)
                }
                dsMove = sub32(dsNew, bottom.*.dsCoord)
                captured = true
                break
            }
        }
        if !z.*.bottomZone && isTop(top) {
            if sub32(z.*.csBottomEdge, csFuzz) <= top.*.csCoord && top.*.csCoord <= add32(z.*.csTopEdge, csFuzz) {
                var dsNew: i64 = 0
                if b.*.suppressOvershoot {
                    dsNew = z.*.dsFlatEdge
                } else if sub32(top.*.csCoord, z.*.csBottomEdge) >= b.*.blueShift {
                    dsNew = calc.max(fixedRound(top.*.dsCoord), calc.low32(z.*.dsFlatEdge + intToFixed(1)))
                } else {
                    dsNew = fixedRound(top.*.dsCoord)
                }
                dsMove = sub32(dsNew, top.*.dsCoord)
                captured = true
                break
            }
        }
        i += 1
    }
    if captured {
        if isValid(bottom) {
            bottom.*.dsCoord = add32(bottom.*.dsCoord, dsMove)
            bottom.*.flags |= LOCKED
        }
        if isValid(top) {
            top.*.dsCoord = add32(top.*.dsCoord, dsMove)
            top.*.flags |= LOCKED
        }
    }
    return captured
}

// ---------------------------------------------------------------------------
// The glyph path.

fn hintPoint(g: *GlyphPath, map: *HintMap, x: i64, y: i64) -> (i64, i64) {
    const px = add32(mulFix(g.*.scaleX, x), mulFix(g.*.scaleC, y))
    const py = hintmapMap(map, y)
    // (The outer transform is the identity.)
    const outX = add32(mulFix(0x10000, px), add32(mulFix(0, py), g.*.fracX))
    const outY = add32(mulFix(0, px), add32(mulFix(0x10000, py), g.*.fracY))
    return -> (outX, outY)
}

fn csScale(x: i64) -> i64 { return (x + 0x10) >> 5 }

fn computeIntersection(g: *GlyphPath, u1x: i64, u1y: i64, u2x: i64, u2y: i64, v1x: i64, v1y: i64, v2x: i64, v2y: i64) -> (bool, i64, i64) {
    const ux = csScale(sub32(u2x, u1x))
    const uy = csScale(sub32(u2y, u1y))
    const vx = csScale(sub32(v2x, v1x))
    const vy = csScale(sub32(v2y, v1y))
    const wx = csScale(sub32(v1x, u1x))
    const wy = csScale(sub32(v1y, u1y))
    const denominator = mulFix(ux, vy) - mulFix(uy, vx)
    if denominator == 0 { return -> (false, 0, 0) }
    const s = divFix(mulFix(wx, vy) - mulFix(wy, vx), denominator)
    var ix = add32(u1x, mulFix(s, sub32(u2x, u1x)))
    var iy = add32(u1y, mulFix(s, sub32(u2y, u1y)))
    if u1x == u2x && fixedAbs(sub32(ix, u1x)) < g.*.snapThreshold { ix = u1x }
    if u1y == u2y && fixedAbs(sub32(iy, u1y)) < g.*.snapThreshold { iy = u1y }
    if v1x == v2x && fixedAbs(sub32(ix, v1x)) < g.*.snapThreshold { ix = v1x }
    if v1y == v2y && fixedAbs(sub32(iy, v1y)) < g.*.snapThreshold { iy = v1y }
    if fixedAbs(ix - add32(u2x, v1x) / 2) > g.*.miterLimit || fixedAbs(iy - add32(u2y, v1y) / 2) > g.*.miterLimit { return -> (false, ix, iy) }
    return -> (true, ix, iy)
}

// FreeType's cf2_glyphpath_pushPrevElem; the next element's first point
// (moved to the intersection when there is one).
fn pushPrevElem(e: *Engine, g: *GlyphPath, map: *HintMap, nextP0x_: i64, nextP0y_: i64, nextP1x: i64, nextP1y: i64, close: bool) -> (i64, i64) {
    var nextP0x = nextP0x_
    var nextP0y = nextP0y_
    var useIntersection = false
    var ix: i64 = 0
    var iy: i64 = 0
    const isLine = g.*.prevElemOp == PATH_LINE
    var prev0x = if isLine { g.*.p0x } else { g.*.p2x }
    var prev0y = if isLine { g.*.p0y } else { g.*.p2y }
    var prev1x = if isLine { g.*.p1x } else { g.*.p3x }
    var prev1y = if isLine { g.*.p1y } else { g.*.p3y }
    if prev1x != nextP0x || prev1y != nextP0y {
        const result = computeIntersection(g, prev0x, prev0y, prev1x, prev1y, nextP0x, nextP0y, nextP1x, nextP1y)
        useIntersection = result.0
        ix = result.1
        iy = result.2
        if useIntersection {
            if isLine {
                g.*.p1x = ix
                g.*.p1y = iy
            } else {
                g.*.p3x = ix
                g.*.p3y = iy
            }
        }
    }
    const pt0x = g.*.currentDSX
    const pt0y = g.*.currentDSY
    if isLine {
        const pt1 = if close { hintPoint(g, &g.*.firstHintMap, g.*.p1x, g.*.p1y) } else { hintPoint(g, map, g.*.p1x, g.*.p1y) }
        if pt0x != pt1.0 || pt0y != pt1.1 {
            outLineTo(e, pt0x, pt0y, pt1.0, pt1.1)
            g.*.currentDSX = pt1.0
            g.*.currentDSY = pt1.1
        }
    } else {
        const pt1 = hintPoint(g, map, g.*.p1x, g.*.p1y)
        const pt2 = hintPoint(g, map, g.*.p2x, g.*.p2y)
        const pt3 = hintPoint(g, map, g.*.p3x, g.*.p3y)
        outCubeTo(e, pt0x, pt0y, pt1.0, pt1.1, pt2.0, pt2.1, pt3.0, pt3.1)
        g.*.currentDSX = pt3.0
        g.*.currentDSY = pt3.1
    }
    if !useIntersection || close {
        const pt1 = if close { hintPoint(g, &g.*.firstHintMap, nextP0x, nextP0y) } else { hintPoint(g, map, nextP0x, nextP0y) }
        if pt1.0 != g.*.currentDSX || pt1.1 != g.*.currentDSY {
            outLineTo(e, g.*.currentDSX, g.*.currentDSY, pt1.0, pt1.1)
            g.*.currentDSX = pt1.0
            g.*.currentDSY = pt1.1
        }
    }
    if useIntersection {
        nextP0x = ix
        nextP0y = iy
    }
    return -> (nextP0x, nextP0y)
}

fn pushMove(e: *Engine, g: *GlyphPath, startX: i64, startY: i64) -> void {
    if !g.*.hintMap.isValid { glyphpathMoveTo(e, g, g.*.startX, g.*.startY) }
    const pt1 = hintPoint(g, &g.*.hintMap, startX, startY)
    outMoveTo(e)
    g.*.currentDSX = pt1.0
    g.*.currentDSY = pt1.1
    g.*.offsetStart0X = startX
    g.*.offsetStart0Y = startY
}

fn windingMomentum(x1: i64, y1: i64, x2: i64, y2: i64) -> i64 {
    return calc.low32((x1 >> 16) * (sub32(y2, y1) >> 16) - (y1 >> 16) * (sub32(x2, x1) >> 16))
}

fn computeOffset(e: *Engine, g: *GlyphPath, x1: i64, y1: i64, x2: i64, y2: i64) -> (i64, i64) {
    var dx = sub32(x2, x1)
    var dy = sub32(y2, y1)
    if e.*.reverseWinding {
        dx = neg32(dx)
        dy = neg32(dy)
    }
    if !g.*.darken { return -> (0, 0) }
    e.*.windingMomentum = add32(e.*.windingMomentum, windingMomentum(x1, y1, x2, y2))
    const xo = g.*.xOffset
    const yo = g.*.yOffset
    if dx >= 0 {
        if dy >= 0 {
            if dx > mul32(2, dy) { return -> (0, 0) }
            if dy > mul32(2, dx) { return -> (xo, yo) }
            return -> (mulFix(45875, xo), mulFix(19661, yo))
        }
        if dx > mul32(-2, dy) { return -> (0, 0) }
        if neg32(dy) > mul32(2, dx) { return -> (neg32(xo), yo) }
        return -> (mulFix(-45874, xo), mulFix(19661, yo))
    }
    if dy >= 0 {
        if neg32(dx) > mul32(2, dy) { return -> (0, mul32(2, yo)) }
        if dy > mul32(-2, dx) { return -> (xo, yo) }
        return -> (mulFix(45875, xo), mulFix(111411, yo))
    }
    if neg32(dx) > mul32(-2, dy) { return -> (0, mul32(2, yo)) }
    if neg32(dy) > mul32(-2, dx) { return -> (neg32(xo), yo) }
    return -> (mulFix(-45874, xo), mulFix(111411, yo))
}

fn glyphpathMoveTo(e: *Engine, g: *GlyphPath, x: i64, y: i64) -> void {
    closeOpenPath(e, g)
    g.*.currentCSX = x
    g.*.startX = x
    g.*.currentCSY = y
    g.*.startY = y
    g.*.moveIsPending = true
    if !g.*.hintMap.isValid || g.*.hintMask.*.isNew { hintmapBuild(e, &g.*.hintMap, &g.*.hintMoves, g.*.hStems, g.*.vStems, g.*.hintMask, g.*.hintOriginY, false) }
    g.*.firstHintMap = g.*.hintMap
}

fn glyphpathLineTo(e: *Engine, g: *GlyphPath, x: i64, y: i64) -> void {
    const newHintMap = g.*.hintMask.*.isNew && !g.*.pathIsClosing
    if g.*.currentCSX == x && g.*.currentCSY == y && !newHintMap { return }
    const offset = computeOffset(e, g, g.*.currentCSX, g.*.currentCSY, x, y)
    var p0x = add32(g.*.currentCSX, offset.0)
    var p0y = add32(g.*.currentCSY, offset.1)
    const p1x = add32(x, offset.0)
    const p1y = add32(y, offset.1)
    if g.*.moveIsPending {
        pushMove(e, g, p0x, p0y)
        g.*.moveIsPending = false
        g.*.pathIsOpen = true
        g.*.offsetStart1X = p1x
        g.*.offsetStart1Y = p1y
    }
    if g.*.elemIsQueued {
        const next = pushPrevElem(e, g, &g.*.hintMap, p0x, p0y, p1x, p1y, false)
        p0x = next.0
        p0y = next.1
    }
    g.*.elemIsQueued = true
    g.*.prevElemOp = PATH_LINE
    g.*.p0x = p0x
    g.*.p0y = p0y
    g.*.p1x = p1x
    g.*.p1y = p1y
    if newHintMap { hintmapBuild(e, &g.*.hintMap, &g.*.hintMoves, g.*.hStems, g.*.vStems, g.*.hintMask, g.*.hintOriginY, false) }
    g.*.currentCSX = x
    g.*.currentCSY = y
}

fn glyphpathCurveTo(e: *Engine, g: *GlyphPath, x1: i64, y1: i64, x2: i64, y2: i64, x3: i64, y3: i64) -> void {
    const o1 = computeOffset(e, g, g.*.currentCSX, g.*.currentCSY, x1, y1)
    const o3 = computeOffset(e, g, x2, y2, x3, y3)
    e.*.windingMomentum = add32(e.*.windingMomentum, windingMomentum(x1, y1, x2, y2))
    var p0x = add32(g.*.currentCSX, o1.0)
    var p0y = add32(g.*.currentCSY, o1.1)
    const p1x = add32(x1, o1.0)
    const p1y = add32(y1, o1.1)
    const p2x = add32(x2, o3.0)
    const p2y = add32(y2, o3.1)
    const p3x = add32(x3, o3.0)
    const p3y = add32(y3, o3.1)
    if g.*.moveIsPending {
        pushMove(e, g, p0x, p0y)
        g.*.moveIsPending = false
        g.*.pathIsOpen = true
        g.*.offsetStart1X = p1x
        g.*.offsetStart1Y = p1y
    }
    if g.*.elemIsQueued {
        const next = pushPrevElem(e, g, &g.*.hintMap, p0x, p0y, p1x, p1y, false)
        p0x = next.0
        p0y = next.1
    }
    g.*.elemIsQueued = true
    g.*.prevElemOp = PATH_CUBE
    g.*.p0x = p0x
    g.*.p0y = p0y
    g.*.p1x = p1x
    g.*.p1y = p1y
    g.*.p2x = p2x
    g.*.p2y = p2y
    g.*.p3x = p3x
    g.*.p3y = p3y
    if g.*.hintMask.*.isNew { hintmapBuild(e, &g.*.hintMap, &g.*.hintMoves, g.*.hStems, g.*.vStems, g.*.hintMask, g.*.hintOriginY, false) }
    g.*.currentCSX = x3
    g.*.currentCSY = y3
}

fn closeOpenPath(e: *Engine, g: *GlyphPath) -> void {
    if !g.*.pathIsOpen { return }
    g.*.pathIsClosing = true
    glyphpathLineTo(e, g, g.*.startX, g.*.startY)
    if g.*.elemIsQueued {
        const next = pushPrevElem(e, g, &g.*.hintMap, g.*.offsetStart0X, g.*.offsetStart0Y, g.*.offsetStart1X, g.*.offsetStart1Y, true)
        g.*.offsetStart0X = next.0
        g.*.offsetStart0Y = next.1
    }
    g.*.moveIsPending = true
    g.*.pathIsOpen = false
    g.*.pathIsClosing = false
    g.*.elemIsQueued = false
}

// ---------------------------------------------------------------------------
// The operand stack: (type, value) pairs; type 0 an integer, 1 a fixed.

const Stack = struct {
    buffer: usize
    size: i64
    top: i64
}

fn stackCount(s: *Stack) -> i64 { return s.*.top }
fn clear(s: *Stack) -> void { s.*.top = 0 }

fn pushInt(e: *Engine, s: *Stack, v: i64) -> void {
    if s.*.top == s.*.size {
        setError(e, ERR_STACK_OVERFLOW)
        return
    }
    m.putI64(s.*.buffer + @intCast(usize, s.*.top) * 16, 0)
    m.putI64(s.*.buffer + @intCast(usize, s.*.top) * 16 + 8, calc.low32(v))
    s.*.top += 1
}

fn pushFixed(e: *Engine, s: *Stack, v: i64) -> void {
    if s.*.top == s.*.size {
        setError(e, ERR_STACK_OVERFLOW)
        return
    }
    m.putI64(s.*.buffer + @intCast(usize, s.*.top) * 16, 1)
    m.putI64(s.*.buffer + @intCast(usize, s.*.top) * 16 + 8, calc.low32(v))
    s.*.top += 1
}

fn popInt(e: *Engine, s: *Stack) -> i64 {
    if s.*.top == 0 {
        setError(e, ERR_STACK_UNDERFLOW)
        return 0
    }
    if m.getI64(s.*.buffer + @intCast(usize, s.*.top - 1) * 16) != 0 {
        setError(e, ERR_SYNTAX_ERROR)
        return 0
    }
    s.*.top -= 1
    return m.getI64(s.*.buffer + @intCast(usize, s.*.top) * 16 + 8)
}

fn realAt(s: *Stack, i: i64) -> i64 {
    const at = s.*.buffer + @intCast(usize, i) * 16
    if m.getI64(at) == 0 { return intToFixed(m.getI64(at + 8)) }
    return m.getI64(at + 8)
}

fn popFixed(e: *Engine, s: *Stack) -> i64 {
    if s.*.top == 0 {
        setError(e, ERR_STACK_UNDERFLOW)
        return 0
    }
    s.*.top -= 1
    return realAt(s, s.*.top)
}

fn getReal(e: *Engine, s: *Stack, i: i64) -> i64 {
    if i >= s.*.top || i < 0 {
        setError(e, ERR_STACK_OVERFLOW)
        return 0
    }
    return realAt(s, i)
}

fn setReal(e: *Engine, s: *Stack, i: i64, v: i64) -> void {
    if i > s.*.top || i < 0 {
        setError(e, ERR_STACK_OVERFLOW)
        return
    }
    m.putI64(s.*.buffer + @intCast(usize, i) * 16, 1)
    m.putI64(s.*.buffer + @intCast(usize, i) * 16 + 8, calc.low32(v))
}

fn pop(e: *Engine, s: *Stack, n: i64) -> void {
    if n > s.*.top || n < 0 {
        setError(e, ERR_STACK_UNDERFLOW)
        return
    }
    s.*.top -= n
}

fn roll(e: *Engine, s: *Stack, count: i64, shift_: i64) -> void {
    if count < 2 { return }
    if count > s.*.top {
        setError(e, ERR_STACK_OVERFLOW)
        return
    }
    var shift = shift_
    if shift < 0 {
        shift = 0 - ((0 - shift) % count)
    } else {
        shift = shift % count
    }
    if shift == 0 { return }
    var startIdx: i64 = -1
    var idx: i64 = -1
    var lastType: i64 = 0
    var lastValue: i64 = 0
    var i: i64 = 0
    while i < count {
        if startIdx == idx {
            startIdx += 1
            idx = startIdx
            lastType = m.getI64(s.*.buffer + @intCast(usize, idx) * 16)
            lastValue = m.getI64(s.*.buffer + @intCast(usize, idx) * 16 + 8)
        }
        idx += shift
        if idx >= count {
            idx -= count
        } else if idx < 0 {
            idx += count
        }
        const at = s.*.buffer + @intCast(usize, idx) * 16
        const tmpType = m.getI64(at)
        const tmpValue = m.getI64(at + 8)
        m.putI64(at, lastType)
        m.putI64(at + 8, lastValue)
        lastType = tmpType
        lastValue = tmpValue
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Charstring buffers: start, ptr, end.

fn readByte(buf: usize) -> i64 {
    const ptr = m.getWord(buf + 8)
    if ptr < m.getWord(buf + 16) {
        m.putWord(buf + 8, ptr + 1)
        return @intCast(i64, m.get8(ptr))
    }
    return 0
}

fn isEnd(buf: usize) -> bool { return m.getWord(buf + 8) >= m.getWord(buf + 16) }

fn setBuffer(buf: usize, start: usize, end: usize) -> void {
    m.putWord(buf, start)
    m.putWord(buf + 8, start)
    m.putWord(buf + 16, end)
}

// ---------------------------------------------------------------------------
// The interpreter (FreeType's cf2_interpT2CharString, for CFF and CFF2).

const OP_HSTEM: i64 = 1
const OP_VSTEM: i64 = 3
const OP_VMOVETO: i64 = 4
const OP_RLINETO: i64 = 5
const OP_HLINETO: i64 = 6
const OP_VLINETO: i64 = 7
const OP_RRCURVETO: i64 = 8
const OP_CALLSUBR: i64 = 10
const OP_RETURN: i64 = 11
const OP_ESC: i64 = 12
const OP_ENDCHAR: i64 = 14
const OP_VSINDEX: i64 = 15
const OP_BLEND: i64 = 16
const OP_HSTEMHM: i64 = 18
const OP_HINTMASK: i64 = 19
const OP_CNTRMASK: i64 = 20
const OP_RMOVETO: i64 = 21
const OP_HMOVETO: i64 = 22
const OP_VSTEMHM: i64 = 23
const OP_RCURVELINE: i64 = 24
const OP_RLINECURVE: i64 = 25
const OP_VVCURVETO: i64 = 26
const OP_HHCURVETO: i64 = 27
const OP_SHORTINT: i64 = 28
const OP_CALLGSUBR: i64 = 29
const OP_VHCURVETO: i64 = 30
const OP_HVCURVETO: i64 = 31

// What the interpreter of one charstring works with.
const Interp = struct {
    g: *GlyphPath
    stack: *Stack
    hStems: Array
    vStems: Array
    hintMask: HintMask
    haveWidth: bool
    width: i64
    curX: i64
    curY: i64
    storage: [32]i64
    // The subroutine buffers (17 of 3 words).
    buffers: usize
}

fn doStems(e: *Engine, it: *Interp, stems: *Array) -> void {
    const s = it.*.stack
    const count = stackCount(s)
    const hasWidthArg = (count & 1) != 0
    var position: i64 = 0
    if hasWidthArg && !it.*.haveWidth { it.*.width = add32(getReal(e, s, 0), e.*.nominalWidthX) }
    if e.*.widthOnly {
        it.*.haveWidth = true
        return
    }
    var i: i64 = if hasWidthArg { 1 } else { 0 }
    var stem: [5]i64 = undefined
    while i < count {
        position = add32(position, getReal(e, s, i))
        stem[1] = position
        position = add32(position, getReal(e, s, i + 1))
        stem[2] = position
        stem[0] = 0
        stem[3] = 0
        stem[4] = 0
        arrayPush(e, stems, @intFromPtr(&stem[0]))
        i += 2
    }
    clear(s)
    it.*.haveWidth = true
}

fn doFlex(e: *Engine, it: *Interp, readFromStack: u64, conditionalLastRead: bool) -> void {
    const s = it.*.stack
    var vals: [14]i64 = undefined
    vals[0] = it.*.curX
    vals[1] = it.*.curY
    var idx: i64 = 0
    const isHFlex = (readFromStack & (1 << 9)) == 0
    const top: usize = if isHFlex { 9 } else { 10 }
    var i: usize = 0
    while i < top {
        vals[i + 2] = vals[i]
        if (readFromStack & (@intCast(u64, 1) << @intCast(u6, i))) != 0 {
            vals[i + 2] = add32(vals[i + 2], getReal(e, s, idx))
            idx += 1
        }
        i += 1
    }
    if isHFlex { vals[11] = it.*.curY }
    if conditionalLastRead {
        const lastIsX = fixedAbs(sub32(vals[10], it.*.curX)) > fixedAbs(sub32(vals[11], it.*.curY))
        const lastVal = getReal(e, s, idx)
        if lastIsX {
            vals[12] = add32(vals[10], lastVal)
            vals[13] = it.*.curY
        } else {
            vals[12] = it.*.curX
            vals[13] = add32(vals[11], lastVal)
        }
    } else {
        if (readFromStack & (1 << 10)) != 0 {
            vals[12] = add32(vals[10], getReal(e, s, idx))
            idx += 1
        } else {
            vals[12] = it.*.curX
        }
        if (readFromStack & (1 << 11)) != 0 {
            vals[13] = add32(vals[11], getReal(e, s, idx))
        } else {
            vals[13] = it.*.curY
        }
    }
    var j: usize = 0
    while j < 2 {
        glyphpathCurveTo(e, it.*.g, vals[j * 6 + 2], vals[j * 6 + 3], vals[j * 6 + 4], vals[j * 6 + 5], vals[j * 6 + 6], vals[j * 6 + 7])
        j += 1
    }
    clear(s)
    it.*.curX = vals[12]
    it.*.curY = vals[13]
}

fn doBlend(e: *Engine, s: *Stack, numBlends: i64) -> void {
    // (The indices are FreeType's 32-bit unsigned ones: a stack too short
    // for the operands wraps them.)
    const lenBV = @intCast(i64, e.*.blend.lenBV)
    const numOperands = calc.low32(numBlends * lenBV) & 0xFFFFFFFF
    const base = (stackCount(s) - numOperands) & 0xFFFFFFFF
    var delta = (base + numBlends) & 0xFFFFFFFF
    var i: i64 = 0
    while i < numBlends {
        var sum = getReal(e, s, (i + base) & 0xFFFFFFFF)
        var j: i64 = 1
        while j < lenBV {
            const weight = @intCast(i64, m.getI32(e.*.blend.bv + @intCast(usize, j) * 4))
            sum = add32(sum, mulFix(weight, getReal(e, s, delta)))
            delta = (delta + 1) & 0xFFFFFFFF
            j += 1
        }
        setReal(e, s, (i + base) & 0xFFFFFFFF, sum)
        i += 1
    }
    pop(e, s, (numOperands - numBlends) & 0xFFFFFFFF)
}

fn interpret(e: *Engine, g: *GlyphPath, start: usize, end: usize, doingSeac: bool, curX: i64, curY: i64) -> i64 {
    const memory = e.*.memory
    var width: i64 = 0
    const block = m.alloc(memory, @sizeOf(Interp) + @sizeOf(Stack) + 3 * 8 * 18 + 16 * 520)
    if block == 0 {
        setError(e, r.ERR_OUT_OF_MEMORY)
        return width
    }
    const it: *Interp = unsafe { @ptrFromInt(*Interp, block) }
    const stack: *Stack = unsafe { @ptrFromInt(*Stack, block + @sizeOf(Interp)) }
    it.*.buffers = block + @sizeOf(Interp) + @sizeOf(Stack)
    stack.*.buffer = it.*.buffers + 3 * 8 * 18
    stack.*.size = if e.*.isCFF2 { @intCast(i64, e.*.font.*.topFont.dict.maxstack) } else { OPERAND_STACK_SIZE }
    it.*.stack = stack
    it.*.hStems.words = 5
    it.*.vStems.words = 5
    it.*.curX = curX
    it.*.curY = curY
    // The glyph path of this charstring.
    m.zero(@intFromPtr(g), @sizeOf(GlyphPath))
    it.*.g = g
    g.*.hintMoves.words = 2
    hintmapInit(&g.*.initialHintMap, e, @intFromPtr(&g.*.initialHintMap), e.*.scaleY)
    hintmapInit(&g.*.firstHintMap, e, @intFromPtr(&g.*.initialHintMap), e.*.scaleY)
    hintmapInit(&g.*.hintMap, e, @intFromPtr(&g.*.initialHintMap), e.*.scaleY)
    g.*.scaleX = e.*.scaleX
    g.*.scaleC = 0
    g.*.scaleY = e.*.scaleY
    g.*.hStems = &it.*.hStems
    g.*.vStems = &it.*.vStems
    g.*.hintMask = &it.*.hintMask
    g.*.hintOriginY = curY
    g.*.darken = e.*.darkened
    g.*.xOffset = e.*.darkenX
    g.*.yOffset = e.*.darkenY
    g.*.miterLimit = 2 * calc.max(fixedAbs(g.*.xOffset), fixedAbs(g.*.yOffset))
    g.*.snapThreshold = 6554
    g.*.moveIsPending = true
    it.*.haveWidth = e.*.isCFF2
    width = intToFixed(e.*.defaultWidthX)
    e.*.nominalWidthX = intToFixed(e.*.sub.*.priv.nominalWidth)
    it.*.width = width
    var charstring = it.*.buffers
    setBuffer(charstring, start, end)
    var charstringIndex: i64 = 0
    var instructionLimit: i64 = 20000000
    var finished = false
    while !finished {
        var op1: i64 = 0
        if isEnd(charstring) {
            op1 = if charstringIndex != 0 { OP_RETURN } else { OP_ENDCHAR }
        } else {
            op1 = readByte(charstring)
            if (op1 == OP_RETURN || op1 == OP_ENDCHAR) && e.*.isCFF2 { op1 = 0 }
        }
        if e.*.err != r.OK { break }
        instructionLimit -= 1
        if instructionLimit == 0 {
            setError(e, ERR_INVALID_GLYPH_FORMAT)
            break
        }
        // (`clearAfter`: the operand stack is cleared after the operator,
        // FreeType's `break` out of its switch; `continue` keeps it.)
        var clearAfter = true
        if op1 == 0 || op1 == 2 || op1 == 17 || op1 == 9 || op1 == 13 {
            // (Reserved, or Type 1's closepath and hsbw: unknown here.)
        } else if op1 == OP_VSINDEX {
            if e.*.isCFF2 {
                if e.*.blend.usedBV {
                    setError(e, ERR_INVALID_GLYPH_FORMAT)
                    break
                }
                const temp = popInt(e, stack)
                if temp >= 0 { e.*.vsindex = temp }
            }
        } else if op1 == OP_BLEND {
            if e.*.isCFF2 {
                if cffload.blendCheckVector(&e.*.blend, @intCast(u64, e.*.vsindex), e.*.lenNDV, e.*.ndv) {
                    const err = cffload.blendBuildVector(e.*.font, &e.*.blend, @intCast(u64, e.*.vsindex), e.*.lenNDV, e.*.ndv)
                    if err != r.OK {
                        setError(e, err)
                        break
                    }
                }
                const numBlends = popInt(e, stack) & 0xFFFFFFFF
                if numBlends > stack.*.size {
                    setError(e, ERR_INVALID_GLYPH_FORMAT)
                    break
                }
                doBlend(e, stack, numBlends)
                e.*.blend.usedBV = true
                clearAfter = false
            }
        } else if op1 == OP_HSTEMHM || op1 == OP_HSTEM {
            if !it.*.hintMask.isValid {
                doStems(e, it, &it.*.hStems)
                if e.*.widthOnly { break }
            }
        } else if op1 == OP_VSTEMHM || op1 == OP_VSTEM {
            if !it.*.hintMask.isValid {
                doStems(e, it, &it.*.vStems)
                if e.*.widthOnly { break }
            }
        } else if op1 == OP_VMOVETO {
            if stackCount(stack) > 1 && !it.*.haveWidth { it.*.width = add32(getReal(e, stack, 0), e.*.nominalWidthX) }
            it.*.haveWidth = true
            if e.*.widthOnly { break }
            it.*.curY = add32(it.*.curY, popFixed(e, stack))
            glyphpathMoveTo(e, g, it.*.curX, it.*.curY)
        } else if op1 == OP_RLINETO {
            const count = stackCount(stack)
            var idx: i64 = 0
            while idx < count {
                it.*.curX = add32(it.*.curX, getReal(e, stack, idx))
                it.*.curY = add32(it.*.curY, getReal(e, stack, idx + 1))
                glyphpathLineTo(e, g, it.*.curX, it.*.curY)
                idx += 2
            }
            clear(stack)
            clearAfter = false
        } else if op1 == OP_HLINETO || op1 == OP_VLINETO {
            const count = stackCount(stack)
            var isX = op1 == OP_HLINETO
            var idx: i64 = 0
            while idx < count {
                const v = getReal(e, stack, idx)
                if isX {
                    it.*.curX = add32(it.*.curX, v)
                } else {
                    it.*.curY = add32(it.*.curY, v)
                }
                isX = !isX
                glyphpathLineTo(e, g, it.*.curX, it.*.curY)
                idx += 1
            }
            clear(stack)
            clearAfter = false
        } else if op1 == OP_RCURVELINE || op1 == OP_RRCURVETO {
            const count = stackCount(stack)
            var idx: i64 = 0
            while idx + 6 <= count {
                const x1 = add32(getReal(e, stack, idx), it.*.curX)
                const y1 = add32(getReal(e, stack, idx + 1), it.*.curY)
                const x2 = add32(getReal(e, stack, idx + 2), x1)
                const y2 = add32(getReal(e, stack, idx + 3), y1)
                const x3 = add32(getReal(e, stack, idx + 4), x2)
                const y3 = add32(getReal(e, stack, idx + 5), y2)
                glyphpathCurveTo(e, g, x1, y1, x2, y2, x3, y3)
                it.*.curX = x3
                it.*.curY = y3
                idx += 6
            }
            if op1 == OP_RCURVELINE {
                it.*.curX = add32(it.*.curX, getReal(e, stack, idx))
                it.*.curY = add32(it.*.curY, getReal(e, stack, idx + 1))
                glyphpathLineTo(e, g, it.*.curX, it.*.curY)
            }
            clear(stack)
            clearAfter = false
        } else if op1 == OP_CALLGSUBR || op1 == OP_CALLSUBR {
            if charstringIndex > MAX_SUBR {
                setError(e, ERR_INVALID_GLYPH_FORMAT)
                break
            }
            charstring = it.*.buffers + @intCast(usize, charstringIndex + 1) * 24
            const subrNum = popInt(e, stack)
            if op1 == OP_CALLGSUBR {
                const idx = @bitCast(u64, calc.low32(subrNum + e.*.globalsBias)) & 0xFFFFFFFF
                if idx >= @intCast(u64, e.*.numGlobals) {
                    setError(e, ERR_INVALID_GLYPH_FORMAT)
                    break
                }
                setBuffer(charstring, m.getWord(e.*.globals + @intCast(usize, idx) * 8), m.getWord(e.*.globals + @intCast(usize, idx + 1) * 8))
            } else {
                const idx = @bitCast(u64, calc.low32(subrNum + e.*.localsBias)) & 0xFFFFFFFF
                if idx >= @intCast(u64, e.*.numLocals) {
                    setError(e, ERR_INVALID_GLYPH_FORMAT)
                    break
                }
                setBuffer(charstring, m.getWord(e.*.locals + @intCast(usize, idx) * 8), m.getWord(e.*.locals + @intCast(usize, idx + 1) * 8))
            }
            charstringIndex += 1
            clearAfter = false
        } else if op1 == OP_RETURN {
            if charstringIndex < 1 {
                setError(e, ERR_INVALID_GLYPH_FORMAT)
                break
            }
            charstringIndex -= 1
            charstring = it.*.buffers + @intCast(usize, charstringIndex) * 24
            clearAfter = false
        } else if op1 == OP_ESC {
            const op2 = readByte(charstring)
            clearAfter = escape(e, it, op2)
        } else if op1 == OP_ENDCHAR {
            if stackCount(stack) == 1 || stackCount(stack) == 5 {
                if !it.*.haveWidth { it.*.width = add32(getReal(e, stack, 0), e.*.nominalWidthX) }
            }
            it.*.haveWidth = true
            if e.*.widthOnly { break }
            closeOpenPath(e, g)
            if !e.*.isCFF2 && stackCount(stack) > 1 {
                if doingSeac {
                    setError(e, ERR_INVALID_GLYPH_FORMAT)
                    break
                }
                const achar = popInt(e, stack)
                const bchar = popInt(e, stack)
                const sy = popFixed(e, stack)
                const sx = popFixed(e, stack)
                // (The accent, then the base, each a glyph path of its own.)
                const path = m.alloc(memory, @sizeOf(GlyphPath))
                if path == 0 {
                    setError(e, r.ERR_OUT_OF_MEMORY)
                    break
                }
                const sp: *GlyphPath = unsafe { @ptrFromInt(*GlyphPath, path) }
                var component = seacComponent(e, achar)
                if component.0 == r.OK {
                    _ = interpret(e, sp, component.1, component.2, true, sx, sy)
                    component = seacComponent(e, bchar)
                    if component.0 == r.OK { _ = interpret(e, sp, component.1, component.2, true, 0, 0) }
                }
                m.release(memory, path)
                if component.0 != r.OK { setError(e, component.0) }
            }
            break
        } else if op1 == OP_CNTRMASK || op1 == OP_HINTMASK {
            if !(stackCount(stack) > 1 && it.*.hintMask.isValid) {
                doStems(e, it, &it.*.vStems)
                if e.*.widthOnly { break }
                if op1 == OP_HINTMASK {
                    maskRead(e, &it.*.hintMask, charstring, it.*.hStems.count + it.*.vStems.count)
                } else {
                    // (A counter mask builds a hint map of its own, unused.)
                    const counter: *HintMap = unsafe { @ptrFromInt(*HintMap, m.alloc(memory, @sizeOf(HintMap))) }
                    if @intFromPtr(counter) == 0 {
                        setError(e, r.ERR_OUT_OF_MEMORY)
                        break
                    }
                    hintmapInit(counter, e, @intFromPtr(&g.*.initialHintMap), e.*.scaleY)
                    var counterMask: HintMask = undefined
                    maskInit(&counterMask)
                    maskRead(e, &counterMask, charstring, it.*.hStems.count + it.*.vStems.count)
                    hintmapBuild(e, counter, &g.*.hintMoves, &it.*.hStems, &it.*.vStems, &counterMask, 0, false)
                    m.release(memory, @intFromPtr(counter))
                }
            }
        } else if op1 == OP_RMOVETO {
            if stackCount(stack) > 2 && !it.*.haveWidth { it.*.width = add32(getReal(e, stack, 0), e.*.nominalWidthX) }
            it.*.haveWidth = true
            if e.*.widthOnly { break }
            it.*.curY = add32(it.*.curY, popFixed(e, stack))
            it.*.curX = add32(it.*.curX, popFixed(e, stack))
            glyphpathMoveTo(e, g, it.*.curX, it.*.curY)
        } else if op1 == OP_HMOVETO {
            if stackCount(stack) > 1 && !it.*.haveWidth { it.*.width = add32(getReal(e, stack, 0), e.*.nominalWidthX) }
            it.*.haveWidth = true
            if e.*.widthOnly { break }
            it.*.curX = add32(it.*.curX, popFixed(e, stack))
            glyphpathMoveTo(e, g, it.*.curX, it.*.curY)
        } else if op1 == OP_RLINECURVE {
            const count = stackCount(stack)
            var idx: i64 = 0
            while idx + 6 < count {
                it.*.curX = add32(it.*.curX, getReal(e, stack, idx))
                it.*.curY = add32(it.*.curY, getReal(e, stack, idx + 1))
                glyphpathLineTo(e, g, it.*.curX, it.*.curY)
                idx += 2
            }
            while idx < count {
                const x1 = add32(getReal(e, stack, idx), it.*.curX)
                const y1 = add32(getReal(e, stack, idx + 1), it.*.curY)
                const x2 = add32(getReal(e, stack, idx + 2), x1)
                const y2 = add32(getReal(e, stack, idx + 3), y1)
                const x3 = add32(getReal(e, stack, idx + 4), x2)
                const y3 = add32(getReal(e, stack, idx + 5), y2)
                glyphpathCurveTo(e, g, x1, y1, x2, y2, x3, y3)
                it.*.curX = x3
                it.*.curY = y3
                idx += 6
            }
            clear(stack)
            clearAfter = false
        } else if op1 == OP_VVCURVETO || op1 == OP_HHCURVETO {
            const count1 = stackCount(stack)
            const count = count1 & ~@intCast(i64, 2)
            var idx = count1 - count
            const vertical = op1 == OP_VVCURVETO
            while idx < count {
                var x1: i64 = 0
                var y1: i64 = 0
                if ((count - idx) & 1) != 0 {
                    if vertical {
                        x1 = add32(getReal(e, stack, idx), it.*.curX)
                    } else {
                        y1 = add32(getReal(e, stack, idx), it.*.curY)
                    }
                    idx += 1
                } else {
                    if vertical {
                        x1 = it.*.curX
                    } else {
                        y1 = it.*.curY
                    }
                }
                var x2: i64 = 0
                var y2: i64 = 0
                var x3: i64 = 0
                var y3: i64 = 0
                if vertical {
                    y1 = add32(getReal(e, stack, idx), it.*.curY)
                    x2 = add32(getReal(e, stack, idx + 1), x1)
                    y2 = add32(getReal(e, stack, idx + 2), y1)
                    x3 = x2
                    y3 = add32(getReal(e, stack, idx + 3), y2)
                } else {
                    x1 = add32(getReal(e, stack, idx), it.*.curX)
                    x2 = add32(getReal(e, stack, idx + 1), x1)
                    y2 = add32(getReal(e, stack, idx + 2), y1)
                    x3 = add32(getReal(e, stack, idx + 3), x2)
                    y3 = y2
                }
                glyphpathCurveTo(e, g, x1, y1, x2, y2, x3, y3)
                it.*.curX = x3
                it.*.curY = y3
                idx += 4
            }
            clear(stack)
            clearAfter = false
        } else if op1 == OP_VHCURVETO || op1 == OP_HVCURVETO {
            const count1 = stackCount(stack)
            const count = count1 & ~@intCast(i64, 2)
            var idx = count1 - count
            var alternate = op1 == OP_HVCURVETO
            while idx < count {
                var x1: i64 = 0
                var y1: i64 = 0
                var x2: i64 = 0
                var y2: i64 = 0
                var x3: i64 = 0
                var y3: i64 = 0
                if alternate {
                    x1 = add32(getReal(e, stack, idx), it.*.curX)
                    y1 = it.*.curY
                    x2 = add32(getReal(e, stack, idx + 1), x1)
                    y2 = add32(getReal(e, stack, idx + 2), y1)
                    y3 = add32(getReal(e, stack, idx + 3), y2)
                    if count - idx == 5 {
                        x3 = add32(getReal(e, stack, idx + 4), x2)
                        idx += 1
                    } else {
                        x3 = x2
                    }
                    alternate = false
                } else {
                    x1 = it.*.curX
                    y1 = add32(getReal(e, stack, idx), it.*.curY)
                    x2 = add32(getReal(e, stack, idx + 1), x1)
                    y2 = add32(getReal(e, stack, idx + 2), y1)
                    x3 = add32(getReal(e, stack, idx + 3), x2)
                    if count - idx == 5 {
                        y3 = add32(getReal(e, stack, idx + 4), y2)
                        idx += 1
                    } else {
                        y3 = y2
                    }
                    alternate = true
                }
                glyphpathCurveTo(e, g, x1, y1, x2, y2, x3, y3)
                it.*.curX = x3
                it.*.curY = y3
                idx += 4
            }
            clear(stack)
            clearAfter = false
        } else if op1 == OP_SHORTINT {
            const b1 = readByte(charstring)
            const b2 = readByte(charstring)
            pushInt(e, stack, calc.low16((b1 << 8) | b2))
            clearAfter = false
        } else {
            if op1 <= 246 {
                pushInt(e, stack, op1 - 139)
            } else if op1 <= 250 {
                pushInt(e, stack, (op1 - 247) * 256 + readByte(charstring) + 108)
            } else if op1 <= 254 {
                pushInt(e, stack, 0 - ((op1 - 251) * 256 + readByte(charstring)) - 108)
            } else {
                const b1 = readByte(charstring)
                const b2 = readByte(charstring)
                const b3 = readByte(charstring)
                const b4 = readByte(charstring)
                pushFixed(e, stack, calc.low32((b1 << 24) | (b2 << 16) | (b3 << 8) | b4))
            }
            clearAfter = false
        }
        if clearAfter { clear(stack) }
    }
    width = it.*.width
    m.release(memory, it.*.hStems.ptr)
    m.release(memory, it.*.vStems.ptr)
    m.release(memory, g.*.hintMoves.ptr)
    m.release(memory, block)
    return width
}

// The charstring of a standard-encoding code's glyph (FreeType's
// cf2_getSeacComponent).
fn seacComponent(e: *Engine, code: i64) -> (i32, usize, usize) {
    const gid = cffload.glyphByStdCharcode(e.*.font, code)
    if gid < 0 { return -> (ERR_INVALID_GLYPH_FORMAT, 0, 0) }
    const el = cffload.accessElement(&e.*.font.*.stream, &e.*.font.*.charstringsIndex, @intCast(u64, gid))
    if el.0 != r.OK { return -> (el.0, 0, 0) }
    return -> (r.OK, el.1, el.1 + @intCast(usize, el.2))
}

// The escaped operators (12 x); whether the stack is cleared after.
fn escape(e: *Engine, it: *Interp, op2: i64) -> bool {
    const s = it.*.stack
    if op2 == 34 {
        // hflex: dx1 dx2 dy2 dx3 dx4 dx5 dx6
        doFlex(e, it, 0x555 | 0x8, false)
        return false
    }
    if op2 == 35 {
        doFlex(e, it, 0xFFF, false)
        return true
    }
    if op2 == 36 {
        // hflex1
        doFlex(e, it, 0x75F, false)
        return false
    }
    if op2 == 37 {
        doFlex(e, it, 0x3FF, true)
        return false
    }
    if op2 == 8 || op2 == 13 || op2 == 19 || op2 == 25 || op2 == 31 || op2 == 32 { return true }
    if e.*.isCFF2 || op2 >= 38 { return true }
    if op2 == 0 || op2 == 1 || op2 == 2 || op2 == 6 || op2 == 7 || op2 == 33 {
        // (dotsection, and Type 1 operators: nothing here.)
        return true
    }
    // (Type 1's callothersubr and pop: nothing, the stack kept.)
    if op2 == 16 || op2 == 17 { return false }
    if op2 == 3 {
        const b = popFixed(e, s)
        const a = popFixed(e, s)
        pushInt(e, s, if a != 0 && b != 0 { 1 } else { 0 })
        return false
    }
    if op2 == 4 {
        const b = popFixed(e, s)
        const a = popFixed(e, s)
        pushInt(e, s, if a != 0 || b != 0 { 1 } else { 0 })
        return false
    }
    if op2 == 5 {
        const a = popFixed(e, s)
        pushInt(e, s, if a == 0 { 1 } else { 0 })
        return false
    }
    if op2 == 9 {
        const a = popFixed(e, s)
        if a < -FIXED_MAX {
            pushFixed(e, s, FIXED_MAX)
        } else {
            pushFixed(e, s, calc.abs(a))
        }
        return false
    }
    if op2 == 10 {
        const b = popFixed(e, s)
        const a = popFixed(e, s)
        pushFixed(e, s, add32(a, b))
        return false
    }
    if op2 == 11 {
        const b = popFixed(e, s)
        const a = popFixed(e, s)
        pushFixed(e, s, sub32(a, b))
        return false
    }
    if op2 == 12 {
        const divisor = popFixed(e, s)
        const dividend = popFixed(e, s)
        pushFixed(e, s, divFix(dividend, divisor))
        return false
    }
    if op2 == 14 {
        const a = popFixed(e, s)
        if a < -FIXED_MAX {
            pushFixed(e, s, FIXED_MAX)
        } else {
            pushFixed(e, s, 0 - a)
        }
        return false
    }
    if op2 == 15 {
        const b = popFixed(e, s)
        const a = popFixed(e, s)
        pushInt(e, s, if a == b { 1 } else { 0 })
        return false
    }
    if op2 == 18 {
        _ = popFixed(e, s)
        return false
    }
    if op2 == 20 {
        const idx = @bitCast(u64, popInt(e, s)) & 0xFFFFFFFF
        const val = popFixed(e, s)
        if idx < @intCast(u64, STORAGE_SIZE) { it.*.storage[@intCast(usize, idx)] = val }
        return false
    }
    if op2 == 21 {
        const idx = @bitCast(u64, popInt(e, s)) & 0xFFFFFFFF
        if idx < @intCast(u64, STORAGE_SIZE) { pushFixed(e, s, it.*.storage[@intCast(usize, idx)]) }
        return false
    }
    if op2 == 22 {
        const cond2 = popFixed(e, s)
        const cond1 = popFixed(e, s)
        const arg2 = popFixed(e, s)
        const arg1 = popFixed(e, s)
        pushFixed(e, s, if cond1 <= cond2 { arg1 } else { arg2 })
        return false
    }
    if op2 == 23 {
        const sub = e.*.sub
        const rnd = @intCast(i64, (sub.*.random & 0xFFFF) + 1)
        sub.*.random = random(sub.*.random)
        pushFixed(e, s, rnd)
        return false
    }
    if op2 == 24 {
        const b = popFixed(e, s)
        const a = popFixed(e, s)
        pushFixed(e, s, mulFix(a, b))
        return false
    }
    if op2 == 26 {
        var arg = popFixed(e, s)
        if arg > 0 {
            var root = if arg < 10 { arg } else { arg >> 1 }
            var newRoot: i64 = 0
            while true {
                newRoot = (root + calc.divFix(arg, root) + 1) >> 1
                if newRoot == root { break }
                root = newRoot
            }
            arg = newRoot
        } else {
            arg = 0
        }
        pushFixed(e, s, arg)
        return false
    }
    if op2 == 27 {
        const a = popFixed(e, s)
        pushFixed(e, s, a)
        pushFixed(e, s, a)
        return false
    }
    if op2 == 28 {
        const b = popFixed(e, s)
        const a = popFixed(e, s)
        pushFixed(e, s, b)
        pushFixed(e, s, a)
        return false
    }
    if op2 == 29 {
        const idx = popInt(e, s)
        const size = stackCount(s)
        if size > 0 {
            var grIdx: i64 = 0
            if idx < 0 {
                grIdx = size - 1
            } else if idx >= size {
                grIdx = 0
            } else {
                grIdx = size - 1 - idx
            }
            pushFixed(e, s, getReal(e, s, grIdx))
        }
        return false
    }
    if op2 == 30 {
        const idx = popInt(e, s)
        const count = popInt(e, s)
        roll(e, s, count, idx)
        return false
    }
    return true
}

// FreeType's cff_random.
pub fn random(r_: u32) -> u32 {
    var x = @intCast(u64, r_)
    x = (x ^ (x << 13)) & 0xFFFFFFFF
    x = x ^ (x >> 17)
    x = (x ^ (x << 5)) & 0xFFFFFFFF
    return @intCast(u32, x)
}

// ---------------------------------------------------------------------------
// The font's setup and a glyph's outline (FreeType's cf2_font_setup and
// cf2_getGlyphOutline).

fn computeDarkening(emRatio: i64, ppem: i64, stemWidth: i64, boldenAmount: i64, stemDarkened: bool, params: *[8]i64) -> i64 {
    var amount: i64 = 0
    if boldenAmount == 0 && !stemDarkened { return 0 }
    if emRatio < 655 { return 0 }
    if stemDarkened {
        const x1 = params.*[0]
        const y1 = params.*[1]
        const x2 = params.*[2]
        const y2 = params.*[3]
        const x3 = params.*[4]
        const y3 = params.*[5]
        const x4 = params.*[6]
        const y4 = params.*[7]
        const stemWidthPer1000 = mulFix(stemWidth + boldenAmount, emRatio)
        const logBase2 = calc.msb(@bitCast(u64, stemWidthPer1000) & 0xFFFFFFFF) + calc.msb(@bitCast(u64, ppem) & 0xFFFFFFFF)
        const scaledStem = if logBase2 >= 46 { intToFixed(x4) } else { mulFix(stemWidthPer1000, ppem) }
        // (FreeType's chain of gotos: each segment falls to the next when
        // it has no width.)
        var segment: i64 = 4
        if scaledStem < intToFixed(x1) {
            segment = 0
        } else if scaledStem < intToFixed(x2) {
            segment = 1
        } else if scaledStem < intToFixed(x3) {
            segment = 2
        } else if scaledStem < intToFixed(x4) {
            segment = 3
        }
        if segment == 0 {
            amount = divFix(intToFixed(y1), ppem)
        } else {
            if segment == 1 {
                if x2 - x1 != 0 {
                    amount = calc.low32(calc.mulDiv(calc.low32(stemWidthPer1000 - divFix(intToFixed(x1), ppem)), y2 - y1, x2 - x1) + divFix(intToFixed(y1), ppem))
                } else {
                    segment = 2
                }
            }
            if segment == 2 {
                if x3 - x2 != 0 {
                    amount = calc.low32(calc.mulDiv(calc.low32(stemWidthPer1000 - divFix(intToFixed(x2), ppem)), y3 - y2, x3 - x2) + divFix(intToFixed(y2), ppem))
                } else {
                    segment = 3
                }
            }
            if segment == 3 {
                if x4 - x3 != 0 {
                    amount = calc.low32(calc.mulDiv(calc.low32(stemWidthPer1000 - divFix(intToFixed(x3), ppem)), y4 - y3, x4 - x3) + divFix(intToFixed(y3), ppem))
                } else {
                    segment = 4
                }
            }
            if segment == 4 { amount = divFix(intToFixed(y4), ppem) }
        }
        amount = divFix(amount, 2 * emRatio)
    }
    amount = calc.low32(amount + boldenAmount / 2)
    return amount
}

// Sets up the engine for the subfont and the scale (FreeType's
// cf2_font_setup); `scale` is the transform's a and d.
pub fn setup(e: *Engine, ppemY: i64, scaleX: i64, scaleY: i64) -> void {
    e.*.err = r.OK
    e.*.ppem = intToFixed(ppemY)
    e.*.scaleX = scaleX
    e.*.scaleY = scaleY
    var unitsPerEm = e.*.unitsPerEm
    if unitsPerEm == 0 { unitsPerEm = 1000 }
    const ppem = calc.max(intToFixed(4), e.*.ppem)
    const emRatio = calc.low32(intToFixed(1000) / unitsPerEm)
    e.*.stdVW = intToFixed(e.*.sub.*.priv.standardHeight)
    if e.*.stdVW <= 0 { e.*.stdVW = divFix(intToFixed(75), emRatio) }
    e.*.darkenX = computeDarkening(emRatio, ppem, e.*.stdVW, 0, e.*.stemDarkened, &e.*.darkenParams)
    const stdHW = intToFixed(e.*.sub.*.priv.standardWidth)
    if stdHW > 0 && e.*.stdVW > mul32(2, stdHW) {
        e.*.stdHW = divFix(intToFixed(75), emRatio)
    } else {
        e.*.stdHW = divFix(intToFixed(110), emRatio)
    }
    e.*.darkenY = computeDarkening(emRatio, ppem, e.*.stdHW, 0, e.*.stemDarkened, &e.*.darkenParams)
    e.*.darkened = e.*.darkenX != 0 || e.*.darkenY != 0
    e.*.reverseWinding = false
    bluesInit(e)
}

// The glyph's outline from its charstring [start, end) into the builder;
// its width (16.16).
pub fn glyphOutline(e: *Engine, start: usize, end: usize) -> i64 {
    var advWidth: i64 = 0
    e.*.reverseWinding = false
    var needWinding = e.*.darkened
    const path = m.alloc(e.*.memory, @sizeOf(GlyphPath))
    if path == 0 {
        setError(e, r.ERR_OUT_OF_MEMORY)
        return 0
    }
    const g: *GlyphPath = unsafe { @ptrFromInt(*GlyphPath, path) }
    while true {
        e.*.windingMomentum = 0
        e.*.nPoints = 0
        e.*.nContours = 0
        e.*.pathBegun = false
        advWidth = interpret(e, g, start, end, false, 0, 0)
        if e.*.err != r.OK { break }
        if !needWinding { break }
        if e.*.windingMomentum >= 0 { break }
        e.*.reverseWinding = true
        needWinding = false
    }
    m.release(e.*.memory, path)
    if e.*.err == r.OK { closeContour(e) }
    return advWidth
}

pub fn widthOfFixed(width: i64) -> i64 { return fixedToInt(width) }
