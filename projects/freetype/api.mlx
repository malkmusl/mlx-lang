// The rest of FreeType's API: charmaps, the SFNT tables and names,
// glyph names, the PostScript name and information, `gasp`, the font's
// format, and the functions of drivers the library does not have (BDF,
// the patents of old) as FreeType answers them for an SFNT face.
const m = @import("./memory.mlx")
const r = @import("./records.mlx")
const o = @import("./objects.mlx")
const calc = @import("./calc.mlx")
const library = @import("./library.mlx")
const sfnt = @import("./sfnt.mlx")
const cmap = @import("./cmap.mlx")
const face_ = @import("./face.mlx")
const load = @import("./load.mlx")
const cff = @import("./cff.mlx")
const variations = @import("./variations.mlx")

fn isSfnt(face: usize) -> bool { return face != 0 && (r.faceRec(face).*.face_flags & r.FACE_SFNT) != 0 }
fn isCff(face: usize) -> bool { return o.faceRecord(face).*.driver == library.CFF }

// ---------------------------------------------------------------------------
// Charmaps.

fn charmapAt(face: usize, i: i64) -> usize { return m.getWord(r.faceRec(face).*.charmaps + @intCast(usize, i) * 8) }

export fn FT_Get_Char_Index(face: usize, charcode: u64) -> u32 { return @intCast(u32, load.charIndex(face, charcode)) }

export fn FT_Select_Charmap(face: usize, encoding: u32) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const root = r.faceRec(face)
    if encoding == r.ENCODING_NONE && root.*.num_charmaps == 0 { return r.ERR_INVALID_ARGUMENT }
    if encoding == r.ENCODING_UNICODE { return face_.selectUnicode(face) }
    if root.*.charmaps == 0 { return r.ERR_INVALID_CHARMAP_HANDLE }
    var i: i64 = 0
    while i < @intCast(i64, root.*.num_charmaps) {
        const c = charmapAt(face, i)
        if r.charMapRec(c).*.encoding == encoding {
            root.*.charmap = c
            return r.OK
        }
        i += 1
    }
    return r.ERR_INVALID_ARGUMENT
}

export fn FT_Set_Charmap(face: usize, charmap: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const root = r.faceRec(face)
    if root.*.charmaps == 0 || charmap == 0 { return r.ERR_INVALID_CHARMAP_HANDLE }
    var i: i64 = 0
    while i < @intCast(i64, root.*.num_charmaps) {
        if charmapAt(face, i) == charmap && cmapFormat(charmap) != 14 {
            root.*.charmap = charmap
            return r.OK
        }
        i += 1
    }
    return r.ERR_INVALID_ARGUMENT
}

export fn FT_Get_Charmap_Index(charmap: usize) -> i32 {
    if charmap == 0 || r.charMapRec(charmap).*.face == 0 { return -1 }
    const face = r.charMapRec(charmap).*.face
    var i: i64 = 0
    while i < @intCast(i64, r.faceRec(face).*.num_charmaps) {
        if charmapAt(face, i) == charmap { break }
        i += 1
    }
    return @intCast(i32, i)
}

export fn FT_Get_First_Char(face: usize, agindex: usize) -> u64 {
    var code: u64 = 0
    var gindex: u64 = 0
    if face != 0 && r.faceRec(face).*.charmap != 0 && r.faceRec(face).*.num_glyphs != 0 {
        gindex = load.charIndex(face, 0)
        if gindex == 0 {
            const next = nextChar(face, 0)
            code = next.0
            gindex = next.1
        }
    }
    if agindex != 0 { m.put32(agindex, @intCast(u32, gindex & 0xFFFFFFFF)) }
    return code
}

fn nextChar(face: usize, from: u64) -> (u64, u64) {
    const root = r.faceRec(face)
    var code = from & 0xFFFFFFFF
    var gindex: u64 = 0
    while true {
        const next = cmap.charNext(root.*.charmap, code)
        gindex = next.0
        code = next.1
        if gindex < @intCast(u64, root.*.num_glyphs) { break }
    }
    return -> (if gindex == 0 { 0 } else { code }, gindex)
}

export fn FT_Get_Next_Char(face: usize, char_code: u64, agindex: usize) -> u64 {
    var result: u64 = 0
    var gindex: u64 = 0
    if face != 0 && r.faceRec(face).*.charmap != 0 && r.faceRec(face).*.num_glyphs != 0 {
        const next = nextChar(face, char_code)
        result = next.0
        gindex = next.1
    }
    if agindex != 0 { m.put32(agindex, @intCast(u32, gindex & 0xFFFFFFFF)) }
    return result
}

// The charmap of variation selectors: platform 0, encoding 5, format 14.
fn variantCharmap(face: usize) -> usize {
    const root = r.faceRec(face)
    if root.*.charmaps == 0 { return 0 }
    var i: i64 = 0
    while i < @intCast(i64, root.*.num_charmaps) {
        const c = charmapAt(face, i)
        if r.charMapRec(c).*.platform_id == 0 && r.charMapRec(c).*.encoding_id == 5 && cmapFormat(c) == 14 { return c }
        i += 1
    }
    return 0
}

export fn FT_Face_GetCharVariantIndex(face: usize, charcode: u64, variantSelector: u64) -> u32 {
    if face == 0 { return 0 }
    const root = r.faceRec(face)
    if root.*.charmap == 0 || r.charMapRec(root.*.charmap).*.encoding != r.ENCODING_UNICODE { return 0 }
    const vcmap = variantCharmap(face)
    if vcmap == 0 || charcode > 0xFFFFFFFF || variantSelector > 0xFFFFFFFF { return 0 }
    return @intCast(u32, cmap.varIndex(vcmap, root.*.charmap, charcode, variantSelector) & 0xFFFFFFFF)
}

export fn FT_Face_GetCharVariantIsDefault(face: usize, charcode: u64, variantSelector: u64) -> i32 {
    if face == 0 { return -1 }
    const vcmap = variantCharmap(face)
    if vcmap == 0 || charcode > 0xFFFFFFFF || variantSelector > 0xFFFFFFFF { return -1 }
    return @intCast(i32, cmap.varIsDefault(vcmap, charcode, variantSelector))
}

export fn FT_Face_GetVariantSelectors(face: usize) -> usize {
    if face == 0 { return 0 }
    const vcmap = variantCharmap(face)
    if vcmap == 0 { return 0 }
    return cmap.variantSelectors(vcmap)
}

export fn FT_Face_GetVariantsOfChar(face: usize, charcode: u64) -> usize {
    if face == 0 { return 0 }
    const vcmap = variantCharmap(face)
    if vcmap == 0 || charcode > 0xFFFFFFFF { return 0 }
    return cmap.variantsOfChar(vcmap, charcode)
}

export fn FT_Face_GetCharsOfVariant(face: usize, variantSelector: u64) -> usize {
    if face == 0 { return 0 }
    const vcmap = variantCharmap(face)
    if vcmap == 0 || variantSelector > 0xFFFFFFFF { return 0 }
    return cmap.charsOfVariant(vcmap, variantSelector)
}

// The format of a charmap of `cmap` (FreeType's FT_Get_CMap_Format); a
// charmap the CFF driver made has none (0).
fn cmapFormat(charmap: usize) -> i64 {
    if charmap == 0 || r.charMapRec(charmap).*.face == 0 { return -1 }
    const format = cmap.format(charmap)
    return if format < 0 { 0 } else { format }
}

export fn FT_Get_CMap_Format(charmap: usize) -> i64 { return cmapFormat(charmap) }

export fn FT_Get_CMap_Language_ID(charmap: usize) -> u64 {
    if charmap == 0 || r.charMapRec(charmap).*.face == 0 { return 0 }
    return cmap.language(charmap)
}

// ---------------------------------------------------------------------------
// SFNT tables and names.

const SFNT_HEAD: i64 = 0
const SFNT_MAXP: i64 = 1
const SFNT_OS2: i64 = 2
const SFNT_HHEA: i64 = 3
const SFNT_VHEA: i64 = 4
const SFNT_POST: i64 = 5
const SFNT_PCLT: i64 = 6

export fn FT_Get_Sfnt_Table(face: usize, tag: i32) -> usize {
    if !isSfnt(face) { return 0 }
    const f = o.faceRecord(face)
    const t = @intCast(i64, tag)
    if t == SFNT_HEAD { return f.*.head }
    if t == SFNT_HHEA { return f.*.hhea }
    if t == SFNT_VHEA { return if f.*.verticalInfo { f.*.vhea } else { 0 } }
    if t == SFNT_OS2 { return if sfnt.os2Present(f) { f.*.os2 } else { 0 } }
    if t == SFNT_POST { return f.*.post }
    if t == SFNT_MAXP { return f.*.maxp }
    if t == SFNT_PCLT { return if m.getI64(f.*.pclt) != 0 { f.*.pclt } else { 0 } }
    return 0
}

export fn FT_Load_Sfnt_Table(face: usize, tag: u64, offset_: i64, buffer: usize, length: usize) -> i32 {
    if !isSfnt(face) { return r.ERR_INVALID_FACE_HANDLE }
    const f = o.faceRecord(face)
    var offset = offset_
    var size: u64 = 0
    if tag != 0 {
        const t = o.table(f, @intCast(u32, tag & 0xFFFFFFFF))
        if t.1 == 0 { return r.ERR_TABLE_MISSING }
        offset = offset +% @intCast(i64, t.0)
        size = t.1
    } else {
        size = f.*.size
    }
    if length != 0 && m.get64(length) == 0 {
        m.put64(length, size)
        return r.OK
    }
    if length != 0 { size = m.get64(length) }
    // (FreeType's FT_Stream_ReadAt.)
    if offset < 0 || @intCast(u64, offset) >= f.*.size { return r.ERR_INVALID_STREAM_OPERATION }
    if size > f.*.size - @intCast(u64, offset) { return r.ERR_INVALID_STREAM_OPERATION }
    m.copy(buffer, f.*.data + @intCast(usize, offset), @intCast(usize, size))
    return r.OK
}

export fn FT_Sfnt_Table_Info(face: usize, table_index: u32, tag: usize, length: usize) -> i32 {
    if !isSfnt(face) { return r.ERR_INVALID_FACE_HANDLE }
    const f = o.faceRecord(face)
    if length == 0 { return r.ERR_INVALID_ARGUMENT }
    if tag == 0 {
        m.put64(length, @intCast(u64, f.*.numTables))
        return r.OK
    }
    if @intCast(i64, table_index) >= f.*.numTables { return r.ERR_TABLE_MISSING }
    const entry = f.*.tables + @intCast(usize, table_index) * 16
    m.put64(tag, @intCast(u64, m.get32(entry)))
    m.put64(length, @intCast(u64, m.get32(entry + 12)))
    return r.OK
}

export fn FT_Get_Sfnt_Name_Count(face: usize) -> u32 {
    if !isSfnt(face) { return 0 }
    return @intCast(u32, o.faceRecord(face).*.numNames)
}

// FT_SfntName: platform, encoding, language, name ID (16-bit), the
// string and its length (the bytes of the font, not copied).
export fn FT_Get_Sfnt_Name(face: usize, idx: u32, aname: usize) -> i32 {
    if aname == 0 || !isSfnt(face) { return r.ERR_INVALID_ARGUMENT }
    const f = o.faceRecord(face)
    const n = @intCast(i64, idx)
    if n >= f.*.numNames { return r.ERR_INVALID_ARGUMENT }
    m.put16(aname, @intCast(u16, sfnt.namePlatform(f, n)))
    m.put16(aname + 2, @intCast(u16, sfnt.nameEncoding(f, n)))
    m.put16(aname + 4, @intCast(u16, sfnt.nameLanguage(f, n)))
    m.put16(aname + 6, @intCast(u16, sfnt.nameID(f, n)))
    const length = sfnt.nameLength(f, n)
    m.putWord(aname + 8, if length > 0 { f.*.data + @intCast(usize, sfnt.nameOffset(f, n)) } else { 0 })
    m.put32(aname + 16, @intCast(u32, length))
    return r.OK
}

export fn FT_Get_Sfnt_LangTag(face: usize, langID: u32, alangTag: usize) -> i32 {
    if alangTag == 0 || !isSfnt(face) { return r.ERR_INVALID_ARGUMENT }
    const f = o.faceRecord(face)
    if f.*.nameFormat != 1 { return r.ERR_INVALID_TABLE }
    if langID > 0x8000 && @intCast(i64, langID - 0x8000) < f.*.numLangTags {
        const entry = f.*.langTags + @intCast(usize, langID - 0x8000) * 16
        const length = m.get64(entry)
        m.putWord(alangTag, if length > 0 { f.*.data + @intCast(usize, m.get64(entry + 8)) } else { 0 })
        m.put32(alangTag + 8, @intCast(u32, length))
        return r.OK
    }
    return r.ERR_INVALID_ARGUMENT
}

// ---------------------------------------------------------------------------
// Glyph names, the PostScript name and information.

// Copies a C string into `buffer` of `size` bytes, cut and ended with 0
// (FreeType's ft_mem_strcpyn).
fn copyName(buffer: usize, name: usize, size: u64) -> void {
    var i: u64 = 0
    while i + 1 < size && m.get8(name + i) != 0 {
        m.put8(buffer + i, m.get8(name + i))
        i += 1
    }
    m.put8(buffer + i, 0)
}

export fn FT_Get_Glyph_Name(face: usize, glyph_index: u32, buffer: usize, buffer_max: u32) -> i32 {
    if buffer != 0 && buffer_max > 0 { m.put8(buffer, 0) }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if buffer == 0 || buffer_max == 0 { return r.ERR_INVALID_ARGUMENT }
    const root = r.faceRec(face)
    if (root.*.face_flags & r.FACE_GLYPH_NAMES) == 0 || @intCast(i64, glyph_index) >= root.*.num_glyphs { return r.ERR_INVALID_ARGUMENT }
    const name = glyphName(face, @intCast(i64, glyph_index))
    if name.0 != r.OK { return name.0 }
    if name.1 != 0 { copyName(buffer, name.1, @intCast(u64, buffer_max)) }
    return r.OK
}

// A glyph's name: `post`'s, or the CFF charset's.
fn glyphName(face: usize, gindex: i64) -> (i32, usize) {
    const f = o.faceRecord(face)
    if isCff(face) && f.*.outlines == o.OUTLINES_CFF { return -> (r.OK, cff.glyphName(face, gindex)) }
    if gindex >= sfnt.numGlyphs(f) { return -> (r.ERR_INVALID_GLYPH_INDEX, 0) }
    return -> (r.OK, sfnt.postGlyphName(f, gindex))
}

export fn FT_Get_Name_Index(face: usize, glyph_name: usize) -> u32 {
    if face == 0 || glyph_name == 0 { return 0 }
    const root = r.faceRec(face)
    if (root.*.face_flags & r.FACE_GLYPH_NAMES) == 0 { return 0 }
    if isCff(face) && o.faceRecord(face).*.outlines == o.OUTLINES_CFF { return @intCast(u32, cff.nameIndex(face, glyph_name)) }
    var i: i64 = 0
    while i < root.*.num_glyphs {
        const name = glyphName(face, i)
        if name.0 == r.OK && name.1 != 0 && m.cEqual(name.1, glyph_name) { return @intCast(u32, i) }
        i += 1
    }
    return 0
}

export fn FT_Get_Postscript_Name(face: usize) -> usize {
    if face == 0 { return 0 }
    return variations.postscriptName(face)
}

export fn FT_Has_PS_Glyph_Names(face: usize) -> i32 {
    if face == 0 || !isCff(face) { return 0 }
    return cff.hasGlyphNames(face)
}

export fn FT_Get_PS_Font_Info(face: usize, afont_info: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if afont_info == 0 { return r.ERR_INVALID_ARGUMENT }
    if !isCff(face) { return r.ERR_INVALID_ARGUMENT }
    return cff.fontInfo(face, afont_info)
}

export fn FT_Get_PS_Font_Private(face: usize, afont_private: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if afont_private == 0 { return r.ERR_INVALID_ARGUMENT }
    // (The CFF driver has no FT_PS_Private either.)
    return r.ERR_INVALID_ARGUMENT
}

export fn FT_Get_PS_Font_Value(face: usize, key: i32, idx: u32, value: usize, value_len: i64) -> i64 {
    // (Type 1 fonts only.)
    return -1
}

export fn FT_Get_FSType_Flags(face: usize) -> u16 {
    if face == 0 { return 0 }
    if isCff(face) {
        const fsType = cff.fsType(face)
        if fsType != 0 { return @intCast(u16, fsType) }
    }
    const os2 = FT_Get_Sfnt_Table(face, @intCast(i32, SFNT_OS2))
    if os2 != 0 && m.get16(os2) != 0xFFFF { return m.get16(os2 + 8) }
    return 0
}

const GASP_NO_TABLE: i32 = -1

export fn FT_Get_Gasp(face: usize, ppem: u32) -> i32 {
    if !isSfnt(face) { return GASP_NO_TABLE }
    const f = o.faceRecord(face)
    if f.*.gaspRanges <= 0 { return GASP_NO_TABLE }
    var i: i64 = 0
    while @intCast(i64, ppem) > o.u16At(f, f.*.gaspOffset + @intCast(u64, i) * 4) {
        i += 1
        if i >= f.*.gaspRanges { return GASP_NO_TABLE }
    }
    var result = o.u16At(f, f.*.gaspOffset + @intCast(u64, i) * 4 + 2)
    if f.*.gaspVersion == 0 { result &= 3 }
    return @intCast(i32, result)
}

export fn FT_Get_Font_Format(face: usize) -> usize {
    if face == 0 { return 0 }
    return if isCff(face) { m.literal("CFF") } else { m.literal("TrueType") }
}

export fn FT_Get_X11_Font_Format(face: usize) -> usize { return FT_Get_Font_Format(face) }

// ---------------------------------------------------------------------------
// BDF and CID.

// The `BDF ` table of an SFNT: none of the fonts this library opens has
// one that it reads, as FreeType finds none in a font without it.
export fn FT_Get_BDF_Charset_ID(face: usize, acharset_encoding: usize, acharset_registry: usize) -> i32 {
    var err = r.ERR_INVALID_ARGUMENT
    if face != 0 { err = r.ERR_TABLE_MISSING }
    if acharset_encoding != 0 { m.putWord(acharset_encoding, 0) }
    if acharset_registry != 0 { m.putWord(acharset_registry, 0) }
    return err
}

export fn FT_Get_BDF_Property(face: usize, prop_name: usize, aproperty: usize) -> i32 {
    if aproperty != 0 { m.putI32(aproperty, 0) }
    if face == 0 { return r.ERR_INVALID_ARGUMENT }
    return r.ERR_TABLE_MISSING
}

export fn FT_Get_CID_Registry_Ordering_Supplement(face: usize, registry: usize, ordering: usize, supplement: usize) -> i32 {
    var err = r.ERR_INVALID_ARGUMENT
    var reg: usize = 0
    var ord: usize = 0
    var sup: i64 = 0
    if face != 0 && isCff(face) {
        const result = cff.registryOrderingSupplement(face)
        err = result.0
        reg = result.1
        ord = result.2
        sup = result.3
    }
    if registry != 0 { m.putWord(registry, reg) }
    if ordering != 0 { m.putWord(ordering, ord) }
    if supplement != 0 { m.putI32(supplement, @intCast(i32, sup)) }
    return err
}

export fn FT_Get_CID_Is_Internally_CID_Keyed(face: usize, is_cid: usize) -> i32 {
    var cid: u8 = 0
    var err = r.ERR_INVALID_ARGUMENT
    if face != 0 && isCff(face) {
        err = r.OK
        if cff.isCid(face) { cid = 1 }
    }
    if is_cid != 0 { m.put8(is_cid, cid) }
    return err
}

export fn FT_Get_CID_From_Glyph_Index(face: usize, glyph_index: u32, cid: usize) -> i32 {
    var value: u32 = 0
    var err = r.ERR_INVALID_ARGUMENT
    if face != 0 && isCff(face) {
        const result = cff.cidOfGlyph(face, @intCast(i64, glyph_index))
        err = result.0
        value = @intCast(u32, result.1)
    }
    if cid != 0 { m.put32(cid, value) }
    return err
}

// ---------------------------------------------------------------------------
// Functions FreeType keeps for compatibility.

export fn FT_Face_CheckTrueTypePatents(face: usize) -> u8 { return 0 }
export fn FT_Face_SetUnpatentedHinting(face: usize, value: u8) -> u8 { return 0 }

// FreeType's error strings are an option it is built without.
export fn FT_Error_String(error_code: i32) -> usize { return 0 }
