// ping's side of the system on brixOS (host.mlx is Linux's): brixOS's
// own calls (std.os.brix). A ping socket (socket_open's kind 3: the
// kernel sets the identifier and gives the socket its replies), the one
// wait with a deadline, Ctrl+C as the interrupt event (std.events), and
// the link's record (/devices/net0) for what ping says about this
// machine's side of the network.
const std = @import("std")
const events = @import("std.events")
const brix = std.os.brix

// What `send` answers besides the bytes sent: the request could not go
// now and a later try may (there is no address to send from yet, no
// gateway leads to the host, or the device is busy); it cannot go at
// all. (A request whose neighbour's hardware address is not known yet
// is taken: the kernel keeps it and asks, and when nobody answers the
// socket gets ICMP's "host unreachable" from this machine's address.)
pub const LATER: isize = -1
pub const FAILED: isize = -2

// What `open` answers besides 0.
pub const NO_DEVICE: isize = -1
pub const NO_PERMISSION: isize = -2
pub const NO_SOCKET: isize = -3

pub const Waited = enum(u8) { readable, time_up, interrupted }

var socket: brix.Handle = 0 // (per run)
var stopped: bool = false // (per run)

fn onStop(record: events.Record) -> void {
    _ = record
    stopped = true
}

// Nanoseconds on the clock that only goes forward (the wait's deadline
// is on it).
pub fn now() -> usize { return brix.clock(brix.Clock.MONOTONIC) }

// Ctrl+C (and a request to end) only say so from now on: ping ends its
// run and still gives the summary.
pub fn watchStop() -> void {
    _ = events.handle(events.Event.INTERRUPT, onStop)
    _ = events.handle(events.Event.TERMINATE, onStop)
}

pub fn stopAsked() -> bool { return stopped }

pub fn open() -> isize {
    const opened = brix.socketOpen(brix.SocketKind.PING)
    if opened == -brix.Status.unsupported { return NO_DEVICE }
    if opened < 0 { return NO_SOCKET }
    socket = @intCast(brix.Handle, opened)
    return 0
}

pub fn close() -> void { _ = brix.close(socket) }

// The echo request `message` to `to`: its length, LATER or FAILED.
pub fn send(message: []const u8, to: [4]u8) -> isize {
    const address = brix.SocketAddress.{ .address = to, .port = 0 }
    const sent = brix.socketSend(socket, message, &address)
    if sent == -brix.Status.would_block { return LATER }
    return if sent < 0 { FAILED } else { sent }
}

// Waits until the socket has a datagram, the clock reaches `until`, or
// the user asks to stop.
pub fn wait(until: usize) -> Waited {
    if stopped { return Waited.interrupted }
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = socket, .want = brix.State.READABLE, .seen = 0, .reserved = 0 } }
    const result = brix.wait(items[0..1], until)
    if stopped { return Waited.interrupted }
    return if result > 0 { Waited.readable } else { Waited.time_up }
}

// The next datagram into `into` (its sender into `from`): its length,
// or a negative number when none waits.
pub fn receive(into: []u8, from: *[4]u8) -> isize {
    var source: brix.SocketAddress = undefined
    const got = brix.socketReceive(socket, into, &source)
    if got >= 0 { from.* = source.address }
    return got
}

// This machine's side of the network, as the kernel's record of net0
// has it.
pub const Side = struct {
    // False: the system does not say (the rest means nothing then).
    known: bool
    // False: there is no network device at all (no link to read).
    device: bool
    cable: bool
    // An address is set (by DHCP or the settings).
    configured: bool
    address: [4]u8
    mask: [4]u8
    gateway: [4]u8
}

pub fn side() -> Side {
    var result = Side.{ .known = false, .device = true, .cable = false, .configured = false, .address = [4]u8{ 0, 0, 0, 0 }, .mask = [4]u8{ 0, 0, 0, 0 }, .gateway = [4]u8{ 0, 0, 0, 0 } }
    var link: brix.NetworkLink = undefined
    const read = brix.networkLink(0, &link)
    if read < 0 {
        result.device = read != -brix.Status.not_found
        return result
    }
    result.known = true
    result.cable = link.up
    result.configured = link.configured != brix.NetworkLink.NONE
    result.address = link.address
    result.mask = link.mask
    result.gateway = link.gateway
    return result
}
