// ping HOST [COUNT]: ICMP echo requests to HOST (an address or a name),
// one a second, COUNT of them (4), each reply's round trip said; the
// summary at the end. On a datagram socket of IPPROTO_ICMP (Linux's
// ping sockets, brixOS's too: the kernel sets the identifier); 0 when
// every request was answered, 1 otherwise.
const std = @import("std")
const net = @import("std.net")
const socket = std.linux.socket
const event = std.linux.event

fn say(text: []const u8) -> void { _ = std.linux.write(1, text.pointer, text.length) }

fn sayNumber(value: usize) -> void {
    var buffer: [20]u8 = undefined
    var n = value
    var count: usize = 0
    while true {
        buffer[19 - count] = @intCast(u8, 48 + n % 10)
        count += 1
        n /= 10
        if n == 0 { break }
    }
    say(buffer[20 - count..20])
}

fn sayAddress(a: *const net.Address) -> void {
    var text: [64]u8 = undefined
    const length = net.writeAddress(a, text[0..64])
    say(text[0..length])
}

fn now() -> usize { return std.time.monotonicNanoseconds() }

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count < 2 {
        say("usage: ping HOST [COUNT]\n")
        return 1
    }
    const host = std.string.asSlice(std.process.argument(arguments, 1))
    var wanted: usize = 4
    if count > 2 {
        wanted = 0
        for digit in std.string.asSlice(std.process.argument(arguments, 2)) {
            if digit < 48 || digit > 57 {
                say("ping: COUNT is a number\n")
                return 1
            }
            wanted = wanted * 10 + @intCast(usize, digit - 48)
        }
    }
    var found: [1]net.Address = undefined
    if net.resolve(host, 0, &found, 1, 5000) == 0 {
        say("ping: ")
        say(host)
        say(": no address\n")
        return 1
    }
    const address = found[0]
    const fd = socket.open(if address.family == net.Family.ipv4 { socket.AF_INET } else { socket.AF_INET6 }, socket.SOCK_DGRAM | socket.SOCK_CLOEXEC, 1)
    if fd < 0 {
        say("ping: cannot open a ping socket\n")
        return 1
    }
    var raw: [28]u8 = undefined
    const rawBytes: [*]u8 = &raw
    const rawLength = net.sockaddr(&address, rawBytes)
    say("PING ")
    sayAddress(&address)
    say(": 56 bytes of data\n")
    var answered: usize = 0
    var sequence: usize = 1
    while sequence <= wanted {
        var request: [64]u8 = undefined
        var k: usize = 0
        while k < 64 {
            request[k] = @intCast(u8, 48 + k % 10)
            k += 1
        }
        request[0] = 8
        request[1] = 0
        request[2] = 0
        request[3] = 0
        request[4] = 0
        request[5] = 0
        request[6] = @intCast(u8, (sequence >> 8) & 255)
        request[7] = @intCast(u8, sequence & 255)
        const sent = now()
        if socket.sendTo(fd, &request, 64, 0, @intFromPtr(rawBytes), rawLength) != 64 {
            say("ping: cannot send\n")
        } else {
            var got = false
            while !got && now() - sent < 1000000000 {
                const left = (1000000000 - (now() - sent)) / 1000000
                if event.waitReady(fd, false, @intCast(isize, if left == 0 { 1 } else { left })) <= 0 { break }
                var reply: [128]u8 = undefined
                const length = socket.receiveFrom(fd, &reply, 128, 0, 0, 0)
                if length >= 8 && reply[0] == 0 && (@intCast(usize, reply[6]) << 8 | @intCast(usize, reply[7])) == sequence {
                    const trip = now() - sent
                    say("")
                    sayNumber(@bitCast(usize, length))
                    say(" bytes from ")
                    sayAddress(&address)
                    say(": seq=")
                    sayNumber(sequence)
                    say(" time=")
                    sayNumber(trip / 1000000)
                    say(".")
                    sayNumber((trip / 100000) % 10)
                    say(" ms\n")
                    answered += 1
                    got = true
                }
            }
            if !got {
                say("no answer for seq=")
                sayNumber(sequence)
                say("\n")
            }
        }
        if sequence < wanted {
            const until = sent + 1000000000
            while now() < until { std.time.sleepNanoseconds(until - now()) }
        }
        sequence += 1
    }
    _ = socket.close(fd)
    say("--- ")
    sayNumber(wanted)
    say(" sent, ")
    sayNumber(answered)
    say(" received\n")
    return if answered == wanted { 0 } else { 1 }
}
