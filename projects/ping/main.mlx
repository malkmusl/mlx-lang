// ping [-c COUNT] HOST: ICMP echo requests to HOST (an IPv4 address or a
// name), one a second, until Ctrl+C or COUNT of them; a line for each
// reply with its round trip, a line for each request without one, and
// at the end the summary: how many were sent and answered, the loss in
// percent, the least, mean and greatest round trip. The count may stand
// before or after the host ("-c 3", "-c3", or as before "HOST 3"). 0
// when every request went and was answered, 1 otherwise; what went wrong
// is said on standard error.
//
// Without a count ping goes on until it is interrupted (Ctrl+C ends it
// with the summary), as it does where people know it from: a line that
// comes and goes shows only in a run that does not stop by itself after
// four requests.
//
// A reply is told by its sequence number, whenever it comes: one that
// comes after its second is said late, not taken for another request's
// and not lost (at the end of a count, where replies came late, the
// missing ones are waited for a little longer). Its time is from before
// the request was handed to the system until the reply was taken; one
// that comes from another address than the one asked is shown with that
// said. A request the system cannot take yet is tried again for the
// rest of its second, and when it never went ping says what stands in
// the way (this machine has no address, no gateway leads to the host,
// the link is down); such a request is not counted as sent. brixOS's
// kernel keeps a request while it asks for the neighbour's hardware
// address, and when nobody answers says so itself (ICMP's "host
// unreachable" from this machine's own address): ping then says whose
// hardware address nobody answered for. Where the link is down when a
// request stays without an answer, that is said with it.
//
// The socket, the wait and the interrupt are the system's (host.mlx:
// Linux's ping socket; host.brixos.mlx: brixOS's own calls).
const std = @import("std")
const crash = @import("std.crash")
const net = @import("std.net")
const turns = @import("std.turns")
const host = @import("./host.mlx")

const MILLISECOND: usize = 1000000
const SECOND: usize = 1000000000
// An echo request: ICMP's 8 bytes and 56 of data.
const MESSAGE: usize = 64
// The requests remembered for their replies: one that comes more than
// this many seconds late is not known any more.
const WINDOW: usize = 64

// What became of a request: not sent yet (the system says later), sent
// and waited for, said to have no answer (its reply may still come),
// answered, or refused (a router, or this machine's own system, said
// it cannot be delivered).
const State = enum(u8) { none, unsent, waiting, given_up, answered, refused }

const Request = struct {
    number: usize
    sentAt: usize
    state: State
}

var requests: [WINDOW]Request = undefined // (per run)
// The requests that went, those that never did (the system did not take
// them), and the replies.
var sent: usize = 0 // (per run)
var unsent: usize = 0 // (per run)
var received: usize = 0 // (per run)
// The round trips: the least, the greatest, their sum (nanoseconds).
var least: usize = 0 // (per run)
var greatest: usize = 0 // (per run)
var total: usize = 0 // (per run)
// A reply came after its request was said to have no answer.
var lateSeen: bool = false // (per run)

// A line of output, written whole (two pings at once do not mix theirs).
// It has room for the longest name there is (253 bytes) with what is
// said about it, and always for its end. (With 256 bytes a long name
// took the place of what was said about it, and of the line's end.)
const ROOM: usize = 600

const Line = struct {
    bytes: [ROOM]u8
    length: usize

    fn text(self: *Self, value: []const u8) -> void {
        for byte in value {
            if self.*.length < ROOM - 1 {
                self.*.bytes[self.*.length] = byte
                self.*.length += 1
            }
        }
    }

    // The host as it was typed; of what is too long to be a name, its
    // beginning.
    fn typed(self: *Self, value: []const u8) -> void {
        if value.length <= 253 {
            self.text(value)
            return
        }
        self.text(value[0..60])
        self.text("...")
    }

    fn number(self: *Self, value: usize) -> void {
        var digits: [20]u8 = undefined
        var rest = value
        var count: usize = 0
        while true {
            digits[19 - count] = @intCast(u8, 48 + rest % 10)
            count += 1
            rest /= 10
            if rest == 0 { break }
        }
        self.text(digits[20 - count..20])
    }

    fn address(self: *Self, value: [4]u8) -> void {
        var k: usize = 0
        while k < 4 {
            if k > 0 { self.text(".") }
            self.number(@intCast(usize, value[k]))
            k += 1
        }
    }

    // Nanoseconds as milliseconds, three figures or so of them:
    // "0.045 ms", "1.23 ms", "12.3 ms", "123 ms".
    fn time(self: *Self, nanoseconds: usize) -> void {
        const microseconds = nanoseconds / 1000
        self.number(microseconds / 1000)
        const places: usize = if microseconds < 1000 { 3 } else if microseconds < 10000 { 2 } else if microseconds < 100000 { 1 } else { 0 }
        if places > 0 {
            self.text(".")
            var divisor: usize = 100
            var place: usize = 0
            while place < places {
                self.number((microseconds / divisor) % 10)
                divisor /= 10
                place += 1
            }
        }
        self.text(" ms")
    }

    // The line written, and empty again.
    fn end(self: *Self) -> void {
        self.*.bytes[self.*.length] = 10
        _ = std.io.print(self.*.bytes[0..self.*.length + 1])
        self.*.length = 0
    }

    // The same on standard error: what went wrong, what stands in the
    // way.
    fn complain(self: *Self) -> void {
        self.*.bytes[self.*.length] = 10
        _ = std.io.eprint(self.*.bytes[0..self.*.length + 1])
        self.*.length = 0
    }
}

var line: Line = undefined // (per run)

// The usage: asked for (-h) on standard output, else on standard error.
fn usage(asked: bool) -> void {
    line.text("usage: ping [-c COUNT] HOST\n")
    line.text("an echo request a second to HOST (an address or a name), until Ctrl+C\n")
    line.text("or COUNT of them; then how many were answered and how long they took")
    if asked { line.end() } else { line.complain() }
}

// A count as text: its number, or 0 when it is none (a count is a
// number from 1 on).
fn countOf(text: []const u8) -> usize {
    if text.length == 0 || text.length > 9 { return 0 }
    var value: usize = 0
    for digit in text {
        if digit < 48 || digit > 57 { return 0 }
        value = value * 10 + @intCast(usize, digit - 48)
    }
    return value
}

fn onlyDigits(text: []const u8) -> bool {
    for byte in text {
        if byte < 48 || byte > 57 { return false }
    }
    return text.length > 0
}

// Whether `text` can only be meant as an IPv4 address (digits and dots).
fn looksLikeAddress(text: []const u8) -> bool {
    for byte in text {
        if (byte < 48 || byte > 57) && byte != 46 { return false }
    }
    return text.length > 0
}

// Whether `text` has a colon (an IPv6 address as it is written).
fn hasColon(text: []const u8) -> bool {
    for byte in text {
        if byte == 58 { return true }
    }
    return false
}

// The echo request with sequence number `number` (the identifier and
// the checksum are the system's to set).
fn message(number: usize, into: *[MESSAGE]u8) -> void {
    var k: usize = 0
    while k < MESSAGE {
        into.*[k] = @intCast(u8, 48 + k % 10)
        k += 1
    }
    into.*[0] = 8
    into.*[1] = 0
    into.*[2] = 0
    into.*[3] = 0
    into.*[4] = 0
    into.*[5] = 0
    into.*[6] = @intCast(u8, (number >> 8) & 255)
    into.*[7] = @intCast(u8, number & 255)
}

// The request whose sequence number on the wire is `sequence`, if it is
// remembered.
fn requestOf(sequence: usize) -> ?*Request {
    var k: usize = 0
    while k < WINDOW {
        if requests[k].state != State.none && (requests[k].number & 0xFFFF) == sequence { return &requests[k] }
        k += 1
    }
    return null
}

// Whether `a` and `b` are one address.
fn sameAddress(a: [4]u8, b: [4]u8) -> bool { return a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3] }

// An echo reply of `length` bytes from `from`, taken at `at`, to a
// request that went to `target`.
fn echoed(target: [4]u8, from: [4]u8, length: usize, sequence: usize, at: usize) -> void {
    const found = requestOf(sequence)
    if found == null { return }
    const request = found.?
    if request.*.state == State.unsent { return }
    const trip = if at > request.*.sentAt { at - request.*.sentAt } else { 0 }
    line.number(length)
    line.text(" bytes from ")
    line.address(from)
    line.text(": seq=")
    line.number(request.*.number)
    line.text(" time=")
    line.time(trip)
    // A reply is to come from the address its request went to: one from
    // another (a host with several, a network that rewrites addresses)
    // is counted, and said.
    if !sameAddress(from, target) { line.text(" (not the host asked)") }
    if request.*.state == State.answered {
        // The same reply once more (a network may give one twice):
        // shown, not counted.
        line.text(" (again)")
        line.end()
        return
    }
    // (Late: after "no answer" was said of it. A reply that follows a
    // router's word that its request was not delivered is not.)
    if request.*.state == State.given_up {
        line.text(" (late)")
        lateSeen = true
    }
    line.end()
    request.*.state = State.answered
    if received == 0 || trip < least { least = trip }
    if trip > greatest { greatest = trip }
    total += trip
    received += 1
}

// What a router says when it cannot deliver (ICMP's destination
// unreachable, by its code).
fn unreachableText(code: u8) -> []const u8 {
    if code == 0 { return "the network cannot be reached" }
    if code == 1 { return "the host cannot be reached" }
    if code == 2 || code == 3 { return "the host does not take echo requests" }
    if code == 4 { return "the request is too large for a link on the way" }
    if code == 9 || code == 10 || code == 13 { return "the way there is closed (a filter)" }
    return "it cannot be reached"
}

// An ICMP error from `from` about one of our requests to `target`
// (`bytes`: the error's 8 bytes, then the IP header and the first bytes
// of what it is about): said once, in place of "no answer". "The host
// cannot be reached" from this machine's own address is brixOS's kernel
// speaking: the request never left, because nobody said the hardware
// address it was to go to.
fn refused(target: [4]u8, from: [4]u8, bytes: []const u8) -> void {
    if bytes.length < 8 + 20 + 8 { return }
    const header = @intCast(usize, bytes[8] & 15) * 4
    if header < 20 || bytes.length < 8 + header + 8 || bytes[8 + 9] != 1 || bytes[8 + header] != 8 { return }
    const sequence = (@intCast(usize, bytes[8 + header + 6]) << 8) | @intCast(usize, bytes[8 + header + 7])
    const found = requestOf(sequence)
    if found == null { return }
    const request = found.?
    if request.*.state != State.waiting && request.*.state != State.given_up { return }
    request.*.state = State.refused
    if bytes[0] == 3 && bytes[1] == 1 {
        const side = host.side()
        if side.known && side.configured && sameAddress(from, side.address) {
            nobodyAnswered(target, &side)
            return
        }
    }
    line.text("from ")
    line.address(from)
    line.text(": seq=")
    line.number(request.*.number)
    line.text(if bytes[0] == 11 { " was dropped: too many routers on the way" } else { " was not delivered: " })
    if bytes[0] != 11 { line.text(unreachableText(bytes[1])) }
    line.end()
}

// Every datagram that waits at the socket (replies and ICMP's errors
// about the requests to `target`).
fn takeReplies(target: [4]u8) -> void {
    var reply: [600]u8 = undefined
    while true {
        var from: [4]u8 = [4]u8{ 0, 0, 0, 0 }
        const got = host.receive(reply[0..600], &from)
        if got < 0 { return }
        const at = host.now()
        const length = @bitCast(usize, got)
        if length < 8 { continue }
        if reply[0] == 0 && reply[1] == 0 {
            echoed(target, from, length, (@intCast(usize, reply[6]) << 8) | @intCast(usize, reply[7]), at)
        } else if reply[0] == 3 || reply[0] == 11 {
            refused(target, from, reply[0..length])
        }
    }
}

// Whether `a` and `b` are on one subnet of `mask`.
fn sameNet(a: [4]u8, b: [4]u8, mask: [4]u8) -> bool {
    var k: usize = 0
    while k < 4 {
        if (a[k] & mask[k]) != (b[k] & mask[k]) { return false }
        k += 1
    }
    return true
}

// The requests without an answer, in percent of those sent: rounded,
// but never 0 when one was lost and never 100 when one was answered.
fn lossPercent() -> usize {
    if sent == 0 || received >= sent { return 0 }
    const percent = ((sent - received) * 100 + sent / 2) / sent
    if percent == 0 { return 1 }
    if percent == 100 && received > 0 { return 99 }
    return percent
}

// Whether `address` is 0.0.0.0: none.
fn none(address: [4]u8) -> bool { return address[0] == 0 && address[1] == 0 && address[2] == 0 && address[3] == 0 }

// A request the kernel kept and could not send: nobody answered for
// the hardware address it was to go to, the host's own on our network,
// else the gateway's. With the link down nobody could: that is said
// instead.
fn nobodyAnswered(target: [4]u8, side: *const host.Side) -> void {
    line.text("no answer from ")
    line.address(target)
    if !side.*.cable {
        line.text(" (the network link is down)")
    } else if sameNet(target, side.*.address, side.*.mask) {
        line.text(" (its hardware address is not known: nobody answered for it)")
    } else {
        line.text(" (the hardware address of the gateway ")
        line.address(side.*.gateway)
        line.text(" is not known: nobody answered for it)")
    }
    line.end()
}

// A request that never went: the system said later for its whole
// second. What stands in the way is on this machine's side (looked at
// now: it may have changed since the start): the link is down, there is
// no address, or no gateway to a host that is not on the own network.
// (The link first: where it is down, an address often is missing
// because of it.)
fn neverSent(target: [4]u8, number: usize) -> void {
    const side = host.side()
    line.text("seq=")
    line.number(number)
    line.text(" could not be sent")
    if side.known && !side.cable {
        line.text(": the network link is down")
    } else if side.known && !side.configured {
        line.text(": this machine has no address")
    } else if side.known && none(side.gateway) && !sameNet(target, side.address, side.mask) {
        line.text(": ")
        line.address(target)
        line.text(" is not on this machine's network, and there is no gateway")
    }
    line.end()
}

// How many requests that went have no answer so far.
fn missing() -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < WINDOW {
        if requests[k].state == State.waiting || requests[k].state == State.given_up { count += 1 }
        k += 1
    }
    return count
}

// The requests, one a second, `wanted` of them (0: until interrupted).
fn run(target: [4]u8, wanted: usize) -> void {
    var k: usize = 0
    while k < WINDOW {
        requests[k].state = State.none
        k += 1
    }
    // What a request's second takes of the compiler's value arena (the
    // message, the room for the replies, this machine's side as it is
    // read) is given back before the next request (std.turns): left
    // running, ping does not grow. (The Linux build grew by some 1.8 KiB
    // a request, 150 MiB in a day, until the arena would be full;
    // brixOS's by less.)
    var seconds: turns.Turns = undefined
    turns.begin(&seconds, true, false)
    var number: usize = 1
    while (wanted == 0 || number <= wanted) && !host.stopAsked() {
        turns.turn(&seconds)
        const request = &requests[number % WINDOW]
        request.*.number = number
        request.*.sentAt = 0
        request.*.state = State.unsent
        var bytes: [MESSAGE]u8 = undefined
        message(number, &bytes)
        const end = host.now() + SECOND
        // When the send is tried next, and the pause before the try
        // after it (longer each time).
        var nextTry: usize = 0
        var pause: usize = 10 * MILLISECOND
        var failed = false
        while true {
            var current = host.now()
            if request.*.state == State.unsent && !failed && current >= nextTry {
                // (The round trip is from before the send: the system
                // may give the request to the device, and the device
                // have the reply, before the send comes back. From after
                // it, such a reply's time was only that of taking it.)
                const before = current
                const result = host.send(bytes[0..MESSAGE], target)
                current = host.now()
                if result == host.LATER {
                    nextTry = current + pause
                    if pause < 200 * MILLISECOND { pause *= 2 }
                } else if result < 0 {
                    failed = true
                } else {
                    request.*.sentAt = before
                    request.*.state = State.waiting
                    sent += 1
                }
            }
            // The last one answered: nothing more to wait for.
            if wanted != 0 && number == wanted && (request.*.state == State.answered || request.*.state == State.refused) { break }
            if current >= end { break }
            const until = if request.*.state == State.unsent && !failed && nextTry < end { nextTry } else { end }
            const waited = host.wait(until)
            if waited == host.Waited.interrupted { break }
            if waited == host.Waited.readable { takeReplies(target) }
        }
        if host.stopAsked() { break }
        if request.*.state == State.unsent {
            if failed {
                line.text("seq=")
                line.number(number)
                line.text(" could not be sent")
                line.end()
            } else {
                neverSent(target, number)
            }
            unsent += 1
            request.*.state = State.none
        } else if request.*.state == State.waiting {
            line.text("no answer for seq=")
            line.number(number)
            // (The link as it is now: a cable that came out during the
            // run shows here, request by request.)
            const side = host.side()
            if side.known && !side.cable && target[0] != 127 { line.text(" (the network link is down)") }
            line.end()
            request.*.state = State.given_up
        }
        number += 1
    }
    // The end of a count on a slow way: where replies came late, those
    // still missing are waited for a little longer (twice the greatest
    // round trip, five seconds at most) and not counted lost with the
    // last second.
    if lateSeen && !host.stopAsked() {
        const linger = if 2 * greatest < 5 * SECOND { 2 * greatest } else { 5 * SECOND }
        const until = host.now() + linger
        while missing() > 0 && host.now() < until {
            const waited = host.wait(until)
            if waited == host.Waited.interrupted { break }
            if waited == host.Waited.readable { takeReplies(target) }
        }
    }
}

// What stands in the way on this machine's side, on standard error:
// there is no network device, the link is down, or there is no address
// yet. False when there is no device: nothing but the machine itself is
// reached then.
fn sayThisSide() -> bool {
    const side = host.side()
    if !side.device {
        line.text("ping: this machine has no network device")
        line.complain()
        return false
    }
    if !side.known { return true }
    if !side.cable {
        line.text("ping: the network link is down (no cable, or it is still coming up)")
        line.complain()
    } else if !side.configured {
        line.text("ping: this machine has no address yet (DHCP is asking)")
        line.complain()
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    line.length = 0
    const count = std.process.count(arguments)
    var name: []const u8 = ""
    var wanted: usize = 0
    var counted = false
    var k: usize = 1
    while k < count {
        const argument = std.string.asSlice(std.process.argument(arguments, k))
        k += 1
        // "-c COUNT", "-cCOUNT".
        if argument.length >= 2 && argument[0] == 45 && argument[1] == 99 {
            var text = argument[2..argument.length]
            if text.length == 0 && k < count {
                text = std.string.asSlice(std.process.argument(arguments, k))
                k += 1
            }
            wanted = countOf(text)
            if wanted == 0 || counted {
                line.text(if counted { "ping: one count is enough" } else { "ping: the count is a number from 1 on" })
                line.complain()
                return 1
            }
            counted = true
        } else if argument.length > 0 && argument[0] == 45 {
            // -h, --help, and what ping does not have.
            const asked = std.text.same(argument, "-h") || std.text.same(argument, "--help")
            usage(asked)
            return if asked { 0 } else { 1 }
        } else if name.length == 0 {
            name = argument
        } else if !counted && onlyDigits(argument) {
            // "HOST COUNT", as it was.
            wanted = countOf(argument)
            if wanted == 0 {
                line.text("ping: the count is a number from 1 on")
                line.complain()
                return 1
            }
            counted = true
        } else {
            usage(false)
            return 1
        }
    }
    if name.length == 0 {
        usage(false)
        return 1
    }
    // The address: the first IPv4 one (the echo spoken here is IPv4's).
    var found: [8]net.Address = undefined
    var why = net.Lookup.found
    var addresses: usize = 0
    if looksLikeAddress(name) {
        if net.parseAddress(name, 0, &found[0]) { addresses = 1 }
    } else {
        addresses = net.lookup(name, 0, &found, 8, 5000, &why)
    }
    var target: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    var have = false
    k = 0
    while k < addresses && !have {
        if found[k].family == net.Family.ipv4 {
            target = [4]u8{ found[k].bytes[0], found[k].bytes[1], found[k].bytes[2], found[k].bytes[3] }
            have = true
        }
        k += 1
    }
    if !have {
        line.text("ping: ")
        line.typed(name)
        if addresses > 0 {
            line.text(if hasColon(name) { " is an IPv6 address (ping speaks IPv4)" } else { " has only an IPv6 address (ping speaks IPv4)" })
        } else if looksLikeAddress(name) {
            line.text(" is no address (four numbers up to 255 with dots between)")
        } else if why == net.Lookup.bad_name {
            line.text(" is no name (parts of 1 to 63 characters with dots between, 253 in all)")
        } else if why == net.Lookup.no_server {
            line.text(": no name server is set to look the name up")
        } else if why == net.Lookup.no_answer {
            line.text(": the name server did not answer")
        } else if why == net.Lookup.unable {
            line.text(": the name server answered that it cannot look the name up")
        } else {
            line.text(": the name server knows no such name")
        }
        line.complain()
        // Why no name server is set, or none answers, may be on this
        // machine's side: said with it.
        if addresses == 0 && (why == net.Lookup.no_server || why == net.Lookup.no_answer) { _ = sayThisSide() }
        return 1
    }
    const opened = host.open()
    if opened < 0 {
        line.text(if opened == host.NO_DEVICE { "ping: this machine has no network device" } else if opened == host.NO_PERMISSION { "ping: no permission for a ping socket (net.ipv4.ping_group_range)" } else { "ping: cannot open a ping socket" })
        line.complain()
        return 1
    }
    // What stands in the way on this machine's side, said ahead (nothing
    // does on the way to the machine itself, 127.0.0.0/8, which a
    // machine without a network device reaches too: for any other host
    // that is the end).
    if target[0] != 127 && !sayThisSide() {
        host.close()
        return 1
    }
    line.text("PING ")
    if !looksLikeAddress(name) {
        line.typed(name)
        line.text(" (")
        line.address(target)
        line.text(")")
    } else {
        line.address(target)
    }
    line.text(": 56 bytes of data")
    line.end()
    host.watchStop()
    run(target, wanted)
    host.close()
    // The summary: of the requests that went, how many were answered
    // and the loss; then those that never went (no loss is said of
    // nothing sent).
    line.text("--- ")
    line.number(sent)
    line.text(" sent, ")
    line.number(received)
    line.text(" received")
    if sent > 0 {
        line.text(", ")
        line.number(lossPercent())
        line.text("% lost")
    }
    if unsent > 0 {
        line.text(", ")
        line.number(unsent)
        line.text(" could not be sent")
    }
    line.end()
    if received > 0 {
        line.text("round trip: least ")
        line.time(least)
        line.text(", mean ")
        line.time(total / received)
        line.text(", greatest ")
        line.time(greatest)
        line.end()
    }
    return if sent > 0 && received == sent && unsent == 0 { 0 } else { 1 }
}
