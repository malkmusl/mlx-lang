// Font variations (HarfBuzz's hb-ot-var.cc, the fvar, avar, HVAR, VVAR
// and MVAR tables, and the item variation store of hb-ot-layout-common.hh):
// axes and named instances, design coordinates normalized (and mapped by
// avar, versions 1 and 2), the deltas of an item variation store at the
// font's coordinates, and the variations of fonts (hb_font_set_variations
// and the rest).
const m = @import("./memory.mlx")
const face = @import("./face.mlx")
const font = @import("./font.mlx")
const o = @import("./object.mlx")

// ---------------------------------------------------------------------------
// The item variation store at `store` of table `t`.

// The scalar of region `region` of the region list at `list`.
pub fn regionScalar(t: *m.Table, list: usize, region: u32, coords: usize, count: u32) -> f32 {
    const axisCount = m.u16at(t, list)
    const regionCount = m.u16at(t, list + 2)
    if region >= regionCount { return 0.0 }
    var v: f32 = 1.0
    var i: u32 = 0
    while i < axisCount {
        const a = list + 4 + (@intCast(usize, region) * @intCast(usize, axisCount) + @intCast(usize, i)) * 6
        const coord = if i < count { m.getI32(coords + @intCast(usize, i) * 4) } else { 0 }
        const start = m.i16at(t, a)
        const peak = m.i16at(t, a + 2)
        const end = m.i16at(t, a + 4)
        var factor: f32 = 1.0
        if peak == 0 || coord == peak {
            factor = 1.0
        } else if start > peak || peak > end {
            factor = 1.0
        } else if start < 0 && end > 0 && peak != 0 {
            factor = 1.0
        } else if coord <= start || end <= coord {
            factor = 0.0
        } else if coord < peak {
            factor = @floatFromInt(f32, coord - start) / @floatFromInt(f32, peak - start)
        } else {
            factor = @floatFromInt(f32, end - coord) / @floatFromInt(f32, end - peak)
        }
        if factor == 0.0 { return 0.0 }
        v = v * factor
        i += 1
    }
    return v
}

// The delta of item `outer`.`inner` (an index of 16.16).
pub fn storeDelta(t: *m.Table, store: usize, index: u32, coords: usize, count: u32) -> f32 {
    if store == 0 { return 0.0 }
    const outer = index >> 16
    const inner = index & 0xFFFF
    const dataCount = m.u16at(t, store + 6)
    if outer >= dataCount { return 0.0 }
    const listOffset = @intCast(usize, m.u32at(t, store + 2))
    if listOffset == 0 { return 0.0 }
    const list = store + listOffset
    const dataOffset = @intCast(usize, m.u32at(t, store + 8 + @intCast(usize, outer) * 4))
    if dataOffset == 0 { return 0.0 }
    const d = store + dataOffset
    const itemCount = m.u16at(t, d)
    if inner >= itemCount { return 0.0 }
    const wordField = m.u16at(t, d + 2)
    const isLong = (wordField & 0x8000) != 0
    const wordCount = wordField & 0x7FFF
    const regionCount = m.u16at(t, d + 4)
    if wordCount > regionCount { return 0.0 }
    const rowSize = (@intCast(usize, wordCount) + @intCast(usize, regionCount)) * (if isLong { @intCast(usize, 2) } else { @intCast(usize, 1) })
    var row = d + 6 + @intCast(usize, regionCount) * 2 + @intCast(usize, inner) * rowSize
    const scount = if isLong { regionCount } else { wordCount }
    const lcount = if isLong { wordCount } else { 0 }
    var delta: f32 = 0.0
    var i: u32 = 0
    while i < regionCount {
        const scalar = regionScalar(t, list, m.u16at(t, d + 6 + @intCast(usize, i) * 2), coords, count)
        var value: i32 = 0
        if i < lcount {
            value = m.i32at(t, row)
            row += 4
        } else if i < scount {
            value = m.i16at(t, row)
            row += 2
        } else {
            value = @intCast(i32, @bitCast(i8, @intCast(u8, m.u8at(t, row))))
            row += 1
        }
        delta += scalar * @floatFromInt(f32, value)
        i += 1
    }
    return delta
}

// A delta-set index map at `map` (0: none, the identity).
pub fn mapIndex(t: *m.Table, map: usize, v_: u32) -> u32 {
    var v = v_
    if map == 0 { return v }
    const format = m.u8at(t, map)
    const entryFormat = m.u8at(t, map + 1)
    var count: u32 = 0
    var data: usize = 0
    if format == 0 {
        count = m.u16at(t, map + 2)
        data = map + 4
    } else if format == 1 {
        count = m.u32at(t, map + 2)
        data = map + 6
    } else {
        return v
    }
    if count == 0 { return v }
    if v >= count { v = count - 1 }
    const width = ((entryFormat >> 4) & 3) + 1
    var u: u32 = 0
    var k: u32 = 0
    while k < width {
        u = (u << 8) | m.u8at(t, data + @intCast(usize, width * v + k))
        k += 1
    }
    const n = (entryFormat & 0xF) + 1
    const outer = u >> @intCast(u5, n)
    return (outer << 16) | (u & ((@intCast(u32, 1) << @intCast(u5, n)) - 1))
}

// ---------------------------------------------------------------------------
// HVAR and VVAR

// The advance delta of `glyph` at the coordinates (HVAR or VVAR).
pub fn advanceDelta(fc: usize, vertical: bool, glyph: u32, coords: usize, count: u32) -> f32 {
    var t: m.Table = undefined
    face.view(fc, if vertical { face.T_VVAR } else { face.T_HVAR }, &t)
    if t.length < 20 || m.u16at(&t, 0) != 1 { return 0.0 }
    const store = @intCast(usize, m.u32at(&t, 4))
    const advMap = @intCast(usize, m.u32at(&t, 8))
    return storeDelta(&t, store, mapIndex(&t, advMap, glyph), coords, count)
}

pub fn hasMetricsVariations(fc: usize, vertical: bool) -> bool {
    var t: m.Table = undefined
    face.view(fc, if vertical { face.T_VVAR } else { face.T_HVAR }, &t)
    return t.length >= 20 && m.u16at(&t, 0) == 1
}

// The side bearing delta of `glyph`; whether the table has a map for it.
pub fn bearingDelta(fc: usize, vertical: bool, glyph: u32, coords: usize, count: u32, out: *f32) -> bool {
    var t: m.Table = undefined
    face.view(fc, if vertical { face.T_VVAR } else { face.T_HVAR }, &t)
    if t.length < 20 || m.u16at(&t, 0) != 1 { return false }
    const lsbMap = @intCast(usize, m.u32at(&t, 12))
    if lsbMap == 0 { return false }
    out.* = storeDelta(&t, @intCast(usize, m.u32at(&t, 4)), mapIndex(&t, lsbMap, glyph), coords, count)
    return true
}

// VVAR's delta of the vertical origin of `glyph`.
pub fn vorgDelta(fc: usize, glyph: u32, coords: usize, count: u32, out: *f32) -> bool {
    var t: m.Table = undefined
    face.view(fc, face.T_VVAR, &t)
    if t.length < 24 || m.u16at(&t, 0) != 1 { return false }
    const vorgMap = @intCast(usize, m.u32at(&t, 20))
    if vorgMap == 0 { return false }
    out.* = storeDelta(&t, @intCast(usize, m.u32at(&t, 4)), mapIndex(&t, vorgMap, glyph), coords, count)
    return true
}

// ---------------------------------------------------------------------------
// MVAR

pub fn mvarDelta(fc: usize, tag: u32, coords: usize, count: u32) -> f32 {
    if count == 0 { return 0.0 }
    var t: m.Table = undefined
    face.view(fc, face.T_MVAR, &t)
    if t.length < 12 || m.u16at(&t, 0) != 1 { return 0.0 }
    const recordSize = @intCast(usize, m.u16at(&t, 6))
    const n = m.u16at(&t, 8)
    const store = @intCast(usize, m.u16at(&t, 10))
    if recordSize < 8 { return 0.0 }
    var low: u32 = 0
    var high = n
    while low < high {
        const mid = (low + high) / 2
        const r = 12 + @intCast(usize, mid) * recordSize
        const rt = m.u32at(&t, r)
        if rt == tag { return storeDelta(&t, store, (m.u16at(&t, r + 4) << 16) | m.u16at(&t, r + 6), coords, count) }
        if rt < tag { low = mid + 1 } else { high = mid }
    }
    return 0.0
}

// ---------------------------------------------------------------------------
// fvar and avar

// The fvar table if it passes HarfBuzz's checks.
pub fn fvarView(fc: usize, out: *m.Table) -> void {
    face.view(fc, face.T_FVAR, out)
    const t = out
    if t.*.length < 16 || m.u16at(t, 0) != 1 {
        t.*.length = 0
        return
    }
    const axisCount = m.u16at(t, 8)
    const instanceSize = m.u16at(t, 14)
    const axes = @intCast(usize, m.u16at(t, 4))
    if m.u16at(t, 10) != 20 || instanceSize < axisCount * 4 + 4 || axes + @intCast(usize, axisCount) * 20 + @intCast(usize, m.u16at(t, 12)) * @intCast(usize, instanceSize) > t.*.length { t.*.length = 0 }
}

pub fn axisCount(fc: usize) -> u32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    return m.u16at(&t, 8)
}

fn fixedToFloat(v: i32) -> f32 { return @floatFromInt(f32, v) / 65536.0 }

// The minimum, default and maximum of axis `i` (minimum and maximum
// put on the default's sides).
fn axisCoordinates(t: *m.Table, i: u32, minV: *f32, defV: *f32, maxV: *f32) -> void {
    const a = @intCast(usize, m.u16at(t, 4)) + @intCast(usize, i) * 20
    const d = fixedToFloat(m.i32at(t, a + 8))
    const lo = fixedToFloat(m.i32at(t, a + 4))
    const hi = fixedToFloat(m.i32at(t, a + 12))
    defV.* = d
    minV.* = if lo < d { lo } else { d }
    maxV.* = if hi > d { hi } else { d }
}

pub fn normalizeAxisValue(t: *m.Table, i: u32, v_: f32) -> i32 {
    var lo: f32 = 0.0
    var d: f32 = 0.0
    var hi: f32 = 0.0
    axisCoordinates(t, i, &lo, &d, &hi)
    var v = v_
    if v < lo { v = lo }
    if v > hi { v = hi }
    if v == d { return 0 }
    if v < d { v = (v - d) / (d - lo) } else { v = (v - d) / (hi - d) }
    return m.intOf(m.roundf(v * 16384.0))
}

pub fn unnormalizeAxisValue(t: *m.Table, i: u32, v: i32) -> f32 {
    var lo: f32 = 0.0
    var d: f32 = 0.0
    var hi: f32 = 0.0
    axisCoordinates(t, i, &lo, &d, &hi)
    if v == 0 { return d }
    if v < 0 { return @floatFromInt(f32, v) * (d - lo) / 16384.0 + d }
    return @floatFromInt(f32, v) * (hi - d) / 16384.0 + d
}

// avar's map of one axis's segment map at `seg` (from and to the offsets
// 0 and 2, or 2 and 0 to unmap); the offset after the map.
fn segmentMap(t: *m.Table, seg: usize, value: i32, from: usize, to: usize) -> i32 {
    const len = m.u16at(t, seg)
    const p = seg + 2
    if len < 2 {
        if len == 0 { return value }
        return value - m.i16at(t, p + from) + m.i16at(t, p + to)
    }
    if value <= m.i16at(t, p + from) { return value - m.i16at(t, p + from) + m.i16at(t, p + to) }
    var i: u32 = 1
    const count = len - 1
    while i < count && value > m.i16at(t, p + @intCast(usize, i) * 4 + from) { i += 1 }
    const fi = m.i16at(t, p + @intCast(usize, i) * 4 + from)
    const ti = m.i16at(t, p + @intCast(usize, i) * 4 + to)
    if value >= fi { return value - fi + ti }
    const fp = m.i16at(t, p + @intCast(usize, i - 1) * 4 + from)
    const tp = m.i16at(t, p + @intCast(usize, i - 1) * 4 + to)
    if fp == fi { return tp }
    const denom = fi - fp
    return m.intOf(m.roundf(@floatFromInt(f32, tp) + (@floatFromInt(f32, ti - tp) * @floatFromInt(f32, value - fp)) / @floatFromInt(f32, denom)))
}

fn avarView(fc: usize, out: *m.Table) -> void {
    face.view(fc, face.T_AVAR, out)
    const major = m.u16at(out, 0)
    if out.*.length < 8 || (major != 1 && major != 2) { out.*.length = 0 }
}

pub fn mapCoords(fc: usize, coords: usize, length: u32) -> void {
    var t: m.Table = undefined
    avarView(fc, &t)
    if t.length == 0 { return }
    const axisCountA = m.u16at(&t, 6)
    const count = if length < axisCountA { length } else { axisCountA }
    var seg: usize = 8
    var i: u32 = 0
    while i < count {
        m.putI32(coords + @intCast(usize, i) * 4, segmentMap(&t, seg, m.getI32(coords + @intCast(usize, i) * 4), 0, 2))
        seg += 2 + @intCast(usize, m.u16at(&t, seg)) * 4
        i += 1
    }
    if m.u16at(&t, 0) < 2 { return }
    while i < axisCountA {
        seg += 2 + @intCast(usize, m.u16at(&t, seg)) * 4
        i += 1
    }
    // avar 2: an index map and a variation store after the segment maps.
    const mapOffset = @intCast(usize, m.u32at(&t, seg))
    const storeOffset = @intCast(usize, m.u32at(&t, seg + 4))
    if length == 0 { return }
    const out = m.alloc(@intCast(usize, length) * 4)
    if out == 0 { return }
    var k: u32 = 0
    while k < length {
        var v = m.getI32(coords + @intCast(usize, k) * 4)
        const index = mapIndex(&t, mapOffset, k)
        const delta = storeDelta(&t, storeOffset, index, coords, length)
        v += m.intOf(m.roundf(delta))
        if v < -16384 { v = -16384 }
        if v > 16384 { v = 16384 }
        m.putI32(out + @intCast(usize, k) * 4, v)
        k += 1
    }
    m.copy(coords, out, @intCast(usize, length) * 4)
    m.release(out)
}

pub fn unmapCoords(fc: usize, coords: usize, length: u32) -> void {
    var t: m.Table = undefined
    avarView(fc, &t)
    if t.length == 0 { return }
    const axisCountA = m.u16at(&t, 6)
    const count = if length < axisCountA { length } else { axisCountA }
    var seg: usize = 8
    var i: u32 = 0
    while i < count {
        m.putI32(coords + @intCast(usize, i) * 4, segmentMap(&t, seg, m.getI32(coords + @intCast(usize, i) * 4), 2, 0))
        seg += 2 + @intCast(usize, m.u16at(&t, seg)) * 4
        i += 1
    }
}

// Design coordinates (floats) normalized into `normalized` (ints).
pub fn normalizeCoords(fc: usize, length: u32, design: usize, normalized: usize) -> void {
    var t: m.Table = undefined
    fvarView(fc, &t)
    const n = m.u16at(&t, 8)
    var i: u32 = 0
    while i < length {
        m.putI32(normalized + @intCast(usize, i) * 4, if i < n { normalizeAxisValue(&t, i, m.getF32(design + @intCast(usize, i) * 4)) } else { 0 })
        i += 1
    }
    mapCoords(fc, normalized, length)
}

// The record of named instance `i` (0: none).
fn instanceRecord(t: *m.Table, i: u32) -> usize {
    if i >= m.u16at(t, 12) { return 0 }
    return @intCast(usize, m.u16at(t, 4)) + @intCast(usize, m.u16at(t, 8)) * 20 + @intCast(usize, i) * @intCast(usize, m.u16at(t, 14))
}

pub fn instanceCoords(fc: usize, index: u32, length: usize, coords: usize) -> u32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    const r = instanceRecord(&t, index)
    if r == 0 {
        if length != 0 { m.put32(length, 0) }
        return 0
    }
    const n = m.u16at(&t, 8)
    if length != 0 && m.get32(length) != 0 {
        var c = m.get32(length)
        if c > n { c = n }
        var i: u32 = 0
        while i < c {
            m.putF32(coords + @intCast(usize, i) * 4, fixedToFloat(m.i32at(&t, r + 4 + @intCast(usize, i) * 4)))
            i += 1
        }
        m.put32(length, c)
    }
    return n
}

export fn hb_ot_var_has_data(fc: usize) -> i32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    return if m.u32at(&t, 0) != 0 { 1 } else { 0 }
}

export fn hb_ot_var_get_axis_count(fc: usize) -> u32 { return axisCount(fc) }

// hb_ot_var_axis_info_t: axis_index, tag, name_id, flags, min, default, max, reserved.
fn axisInfo(t: *m.Table, i: u32, info: usize) -> void {
    const a = @intCast(usize, m.u16at(t, 4)) + @intCast(usize, i) * 20
    var lo: f32 = 0.0
    var d: f32 = 0.0
    var hi: f32 = 0.0
    axisCoordinates(t, i, &lo, &d, &hi)
    m.put32(info, i)
    m.put32(info + 4, m.u32at(t, a))
    m.put32(info + 8, m.u16at(t, a + 18))
    m.put32(info + 12, m.u16at(t, a + 16))
    m.putF32(info + 16, lo)
    m.putF32(info + 20, d)
    m.putF32(info + 24, hi)
    m.put32(info + 28, 0)
}

export fn hb_ot_var_get_axis_infos(fc: usize, start: u32, count: usize, infos: usize) -> u32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    const n = m.u16at(&t, 8)
    if count != 0 {
        var c: u32 = 0
        if start < n {
            c = n - start
            if c > m.get32(count) { c = m.get32(count) }
        }
        var i: u32 = 0
        while i < c {
            axisInfo(&t, start + i, infos + @intCast(usize, i) * 32)
            i += 1
        }
        m.put32(count, c)
    }
    return n
}

pub fn findAxisInfo(fc: usize, tag: u32, info: usize) -> bool {
    var t: m.Table = undefined
    fvarView(fc, &t)
    const n = m.u16at(&t, 8)
    var i: u32 = 0
    while i < n {
        if m.u32at(&t, @intCast(usize, m.u16at(&t, 4)) + @intCast(usize, i) * 20) == tag {
            if info != 0 { axisInfo(&t, i, info) }
            return true
        }
        i += 1
    }
    return false
}

export fn hb_ot_var_find_axis_info(fc: usize, tag: u32, info: usize) -> i32 { return if findAxisInfo(fc, tag, info) { 1 } else { 0 } }

// The deprecated hb_ot_var_axis_t: tag, name_id, min, default, max.
export fn hb_ot_var_get_axes(fc: usize, start: u32, count: usize, axes: usize) -> u32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    const n = m.u16at(&t, 8)
    if count != 0 {
        var c: u32 = 0
        if start < n {
            c = n - start
            if c > m.get32(count) { c = m.get32(count) }
        }
        var i: u32 = 0
        while i < c {
            var info: [8]u32 = undefined
            axisInfo(&t, start + i, @intFromPtr(&info))
            const o2 = axes + @intCast(usize, i) * 20
            m.put32(o2, info[1])
            m.put32(o2 + 4, info[2])
            m.put32(o2 + 8, info[4])
            m.put32(o2 + 12, info[5])
            m.put32(o2 + 16, info[6])
            i += 1
        }
        m.put32(count, c)
    }
    return n
}

export fn hb_ot_var_find_axis(fc: usize, tag: u32, index: usize, axis: usize) -> i32 {
    var info: [8]u32 = undefined
    if !findAxisInfo(fc, tag, @intFromPtr(&info)) {
        if index != 0 { m.put32(index, 0xFFFFFFFF) }
        return 0
    }
    if index != 0 { m.put32(index, info[0]) }
    if axis != 0 {
        m.put32(axis, info[1])
        m.put32(axis + 4, info[2])
        m.put32(axis + 8, info[4])
        m.put32(axis + 12, info[5])
        m.put32(axis + 16, info[6])
    }
    return 1
}

export fn hb_ot_var_get_named_instance_count(fc: usize) -> u32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    return m.u16at(&t, 12)
}

export fn hb_ot_var_named_instance_get_subfamily_name_id(fc: usize, index: u32) -> u32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    const r = instanceRecord(&t, index)
    if r == 0 { return 0xFFFF }
    return m.u16at(&t, r)
}

export fn hb_ot_var_named_instance_get_postscript_name_id(fc: usize, index: u32) -> u32 {
    var t: m.Table = undefined
    fvarView(fc, &t)
    const r = instanceRecord(&t, index)
    if r == 0 { return 0xFFFF }
    const n = m.u16at(&t, 8)
    if m.u16at(&t, 14) >= n * 4 + 6 { return m.u16at(&t, r + 4 + @intCast(usize, n) * 4) }
    return 0xFFFF
}

export fn hb_ot_var_named_instance_get_design_coords(fc: usize, index: u32, length: usize, coords: usize) -> u32 { return instanceCoords(fc, index, length, coords) }

export fn hb_ot_var_normalize_variations(fc: usize, variations: usize, count: u32, coords: usize, length: u32) -> void {
    var i: u32 = 0
    while i < length {
        m.putI32(coords + @intCast(usize, i) * 4, 0)
        i += 1
    }
    var t: m.Table = undefined
    fvarView(fc, &t)
    i = 0
    while i < count {
        var info: [8]u32 = undefined
        const v = variations + @intCast(usize, i) * 8
        if findAxisInfo(fc, m.get32(v), @intFromPtr(&info)) && info[0] < length { m.putI32(coords + @intCast(usize, info[0]) * 4, normalizeAxisValue(&t, info[0], m.getF32(v + 4))) }
        i += 1
    }
    mapCoords(fc, coords, length)
}

export fn hb_ot_var_normalize_coords(fc: usize, length: u32, design: usize, normalized: usize) -> void { normalizeCoords(fc, length, design, normalized) }

// ---------------------------------------------------------------------------
// The variations of fonts

fn setFromDesign(f: usize, design: usize, length: u32) -> void {
    const normalized = if length != 0 { m.alloc(@intCast(usize, length) * 4) } else { 0 }
    if length != 0 && normalized == 0 {
        m.release(design)
        return
    }
    normalizeCoords(font.font(f).*.face, length, design, normalized)
    font.adoptCoords(f, normalized, design, length)
}

fn initialDesign(f: usize, length: u32) -> usize {
    const fo = font.font(f)
    var t: m.Table = undefined
    fvarView(fo.*.face, &t)
    const design = if length != 0 { m.alloc(@intCast(usize, length) * 4) } else { 0 }
    var i: u32 = 0
    while i < length {
        m.putF32(design + @intCast(usize, i) * 4, fixedToFloat(m.i32at(&t, @intCast(usize, m.u16at(&t, 4)) + @intCast(usize, i) * 20 + 8)))
        i += 1
    }
    if fo.*.instanceIndex != 0xFFFFFFFF {
        var count = length
        _ = instanceCoords(fo.*.face, fo.*.instanceIndex, @intFromPtr(&count), design)
    }
    return design
}

pub fn setVariations(f: usize, variations: usize, count: u32) -> void {
    if o.isImmutable(f) { return }
    const fo = font.font(f)
    fo.*.serial +%= 1
    fo.*.serialCoords = fo.*.serial
    if count == 0 && fo.*.instanceIndex == 0xFFFFFFFF {
        setNormalized(f, 0, 0)
        return
    }
    var t: m.Table = undefined
    fvarView(fo.*.face, &t)
    const length = m.u16at(&t, 8)
    const design = initialDesign(f, length)
    if length != 0 && design == 0 { return }
    var i: u32 = 0
    while i < count {
        const v = variations + @intCast(usize, i) * 8
        var a: u32 = 0
        while a < length {
            if m.u32at(&t, @intCast(usize, m.u16at(&t, 4)) + @intCast(usize, a) * 20) == m.get32(v) { m.putF32(design + @intCast(usize, a) * 4, m.getF32(v + 4)) }
            a += 1
        }
        i += 1
    }
    setFromDesign(f, design, length)
}

export fn hb_font_set_variations(f: usize, variations: usize, count: u32) -> void { setVariations(f, variations, count) }

export fn hb_font_set_variation(f: usize, tag: u32, value: f32) -> void {
    if o.isImmutable(f) { return }
    const fo = font.font(f)
    fo.*.serial +%= 1
    fo.*.serialCoords = fo.*.serial
    var t: m.Table = undefined
    fvarView(fo.*.face, &t)
    const length = m.u16at(&t, 8)
    var design: usize = 0
    if fo.*.designCoords != 0 {
        design = m.alloc(@intCast(usize, length) * 4 + 4)
        m.copy(design, fo.*.designCoords, @intCast(usize, length) * 4)
    } else {
        design = initialDesign(f, length)
    }
    if length != 0 && design == 0 { return }
    var a: u32 = 0
    while a < length {
        if m.u32at(&t, @intCast(usize, m.u16at(&t, 4)) + @intCast(usize, a) * 20) == tag { m.putF32(design + @intCast(usize, a) * 4, value) }
        a += 1
    }
    setFromDesign(f, design, length)
}

export fn hb_font_set_var_coords_design(f: usize, coords: usize, length: u32) -> void {
    if o.isImmutable(f) { return }
    const fo = font.font(f)
    fo.*.serial +%= 1
    fo.*.serialCoords = fo.*.serial
    const design = if length != 0 { m.alloc(@intCast(usize, length) * 4) } else { 0 }
    if length != 0 && design == 0 { return }
    m.copy(design, coords, @intCast(usize, length) * 4)
    setFromDesign(f, design, length)
}

pub fn setNamedInstance(f: usize, index: u32) -> void {
    if o.isImmutable(f) { return }
    const fo = font.font(f)
    if fo.*.instanceIndex == index { return }
    fo.*.serial +%= 1
    fo.*.serialCoords = fo.*.serial
    fo.*.instanceIndex = index
    setVariations(f, 0, 0)
}

export fn hb_font_set_var_named_instance(f: usize, index: u32) -> void { setNamedInstance(f, index) }

pub fn setNormalized(f: usize, coords: usize, length: u32) -> void {
    if o.isImmutable(f) { return }
    const fo = font.font(f)
    fo.*.serial +%= 1
    fo.*.serialCoords = fo.*.serial
    const copy = if length != 0 { m.alloc(@intCast(usize, length) * 4) } else { 0 }
    const unmapped = if length != 0 { m.alloc(@intCast(usize, length) * 4) } else { 0 }
    const design = if length != 0 { m.alloc(@intCast(usize, length) * 4) } else { 0 }
    if length != 0 && (copy == 0 || unmapped == 0 || design == 0) {
        m.release(copy)
        m.release(unmapped)
        m.release(design)
        return
    }
    m.copy(copy, coords, @intCast(usize, length) * 4)
    m.copy(unmapped, coords, @intCast(usize, length) * 4)
    unmapCoords(fo.*.face, unmapped, length)
    var t: m.Table = undefined
    fvarView(fo.*.face, &t)
    var i: u32 = 0
    while i < length {
        m.putF32(design + @intCast(usize, i) * 4, unnormalizeAxisValue(&t, i, m.getI32(unmapped + @intCast(usize, i) * 4)))
        i += 1
    }
    m.release(unmapped)
    font.adoptCoords(f, copy, design, length)
}

export fn hb_font_set_var_coords_normalized(f: usize, coords: usize, length: u32) -> void { setNormalized(f, coords, length) }
