// hb-paint.h: paint functions objects, the callbacks a program gives for
// painting color glyphs (transforms, clips, colors, images, gradients,
// groups), and color lines (HarfBuzz's hb-paint.cc).
const m = @import("./memory.mlx")
const o = @import("./object.mlx")

pub const PUSH_TRANSFORM: usize = 0
pub const POP_TRANSFORM: usize = 1
pub const COLOR_GLYPH: usize = 2
pub const PUSH_CLIP_GLYPH: usize = 3
pub const PUSH_CLIP_RECTANGLE: usize = 4
pub const POP_CLIP: usize = 5
pub const COLOR: usize = 6
pub const IMAGE: usize = 7
pub const LINEAR_GRADIENT: usize = 8
pub const RADIAL_GRADIENT: usize = 9
pub const SWEEP_GRADIENT: usize = 10
pub const PUSH_GROUP: usize = 11
pub const POP_GROUP: usize = 12
pub const CUSTOM_PALETTE_COLOR: usize = 13
const COUNT: usize = 14

pub const FUNCS_SIZE: usize = 24 + 3 * COUNT * 8

fn funcAt(p: usize, i: usize) -> usize { return m.getWord(p + 24 + i * 8) }
fn dataAt(p: usize, i: usize) -> usize { return m.getWord(p + 24 + COUNT * 8 + i * 8) }
fn destroyAt(p: usize, i: usize) -> usize { return m.getWord(p + 24 + COUNT * 16 + i * 8) }

var emptyFuncs: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyFuncs))
    if e == 0 {
        const made = o.createInert(FUNCS_SIZE)
        if !m.swapWord(@intFromPtr(&emptyFuncs), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyFuncs))
    }
    return e
}

export fn hb_paint_funcs_create() -> usize {
    const p = o.create(FUNCS_SIZE)
    return if p != 0 { p } else { getEmpty() }
}

export fn hb_paint_funcs_get_empty() -> usize { return getEmpty() }
export fn hb_paint_funcs_reference(p: usize) -> usize { return o.reference(p) }

export fn hb_paint_funcs_destroy(p: usize) -> void {
    if !o.destroy(p) { return }
    var i: usize = 0
    while i < COUNT {
        o.callDestroy(destroyAt(p, i), dataAt(p, i))
        i += 1
    }
    m.release(p)
}

export fn hb_paint_funcs_set_user_data(p: usize, key: usize, data: usize, d: usize, replace: i32) -> i32 { return if o.setUserData(p, key, data, d, replace != 0) { 1 } else { 0 } }
export fn hb_paint_funcs_get_user_data(p: usize, key: usize) -> usize { return o.getUserData(p, key) }
export fn hb_paint_funcs_make_immutable(p: usize) -> void { o.makeImmutable(p) }
export fn hb_paint_funcs_is_immutable(p: usize) -> i32 { return if o.isImmutable(p) { 1 } else { 0 } }

fn setFunc(p: usize, i: usize, func: usize, userData: usize, destroyFunc: usize) -> void {
    if o.isImmutable(p) {
        o.callDestroy(destroyFunc, userData)
        return
    }
    o.callDestroy(destroyAt(p, i), dataAt(p, i))
    m.putWord(p + 24 + i * 8, func)
    m.putWord(p + 24 + COUNT * 8 + i * 8, if func != 0 { userData } else { 0 })
    m.putWord(p + 24 + COUNT * 16 + i * 8, if func != 0 { destroyFunc } else { 0 })
    if func == 0 { o.callDestroy(destroyFunc, userData) }
}

export fn hb_paint_funcs_set_push_transform_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, PUSH_TRANSFORM, f, u, d) }
export fn hb_paint_funcs_set_pop_transform_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, POP_TRANSFORM, f, u, d) }
export fn hb_paint_funcs_set_color_glyph_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, COLOR_GLYPH, f, u, d) }
export fn hb_paint_funcs_set_push_clip_glyph_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, PUSH_CLIP_GLYPH, f, u, d) }
export fn hb_paint_funcs_set_push_clip_rectangle_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, PUSH_CLIP_RECTANGLE, f, u, d) }
export fn hb_paint_funcs_set_pop_clip_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, POP_CLIP, f, u, d) }
export fn hb_paint_funcs_set_color_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, COLOR, f, u, d) }
export fn hb_paint_funcs_set_image_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, IMAGE, f, u, d) }
export fn hb_paint_funcs_set_linear_gradient_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, LINEAR_GRADIENT, f, u, d) }
export fn hb_paint_funcs_set_radial_gradient_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, RADIAL_GRADIENT, f, u, d) }
export fn hb_paint_funcs_set_sweep_gradient_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, SWEEP_GRADIENT, f, u, d) }
export fn hb_paint_funcs_set_push_group_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, PUSH_GROUP, f, u, d) }
export fn hb_paint_funcs_set_pop_group_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, POP_GROUP, f, u, d) }
export fn hb_paint_funcs_set_custom_palette_color_func(p: usize, f: usize, u: usize, d: usize) -> void { setFunc(p, CUSTOM_PALETTE_COLOR, f, u, d) }

pub const TransformFunc = fn(usize, usize, f32, f32, f32, f32, f32, f32, usize) -> void
pub const PlainFunc = fn(usize, usize, usize) -> void
pub const GlyphFunc = fn(usize, usize, u32, usize, usize) -> i32
pub const RectangleFunc = fn(usize, usize, f32, f32, f32, f32, usize) -> void
pub const ColorFunc = fn(usize, usize, i32, u32, usize) -> void
pub const ImageFunc = fn(usize, usize, usize, u32, u32, u32, f32, usize, usize) -> i32
pub const LinearFunc = fn(usize, usize, usize, f32, f32, f32, f32, f32, f32, usize) -> void
pub const SweepFunc = fn(usize, usize, usize, f32, f32, f32, f32, usize) -> void
pub const PopGroupFunc = fn(usize, usize, u32, usize) -> void
pub const PaletteFunc = fn(usize, usize, u32, usize, usize) -> i32

pub fn pushTransform(p: usize, data: usize, xx: f32, yx: f32, xy: f32, yy: f32, dx: f32, dy: f32) -> void {
    const f = funcAt(p, PUSH_TRANSFORM)
    if f == 0 { return }
    const call: TransformFunc = unsafe { @ptrFromInt(TransformFunc, f) }
    call(p, data, xx, yx, xy, yy, dx, dy, dataAt(p, PUSH_TRANSFORM))
}

fn plain(p: usize, data: usize, i: usize) -> void {
    const f = funcAt(p, i)
    if f == 0 { return }
    const call: PlainFunc = unsafe { @ptrFromInt(PlainFunc, f) }
    call(p, data, dataAt(p, i))
}

pub fn popTransform(p: usize, data: usize) -> void { plain(p, data, POP_TRANSFORM) }
pub fn popClip(p: usize, data: usize) -> void { plain(p, data, POP_CLIP) }
pub fn pushGroup(p: usize, data: usize) -> void { plain(p, data, PUSH_GROUP) }

pub fn colorGlyph(p: usize, data: usize, glyph: u32, font: usize) -> bool {
    const f = funcAt(p, COLOR_GLYPH)
    if f == 0 { return false }
    const call: GlyphFunc = unsafe { @ptrFromInt(GlyphFunc, f) }
    return call(p, data, glyph, font, dataAt(p, COLOR_GLYPH)) != 0
}

pub fn pushClipGlyph(p: usize, data: usize, glyph: u32, font: usize) -> void {
    const f = funcAt(p, PUSH_CLIP_GLYPH)
    if f == 0 { return }
    const call: GlyphFunc = unsafe { @ptrFromInt(GlyphFunc, f) }
    _ = call(p, data, glyph, font, dataAt(p, PUSH_CLIP_GLYPH))
}

pub fn pushClipRectangle(p: usize, data: usize, x0: f32, y0: f32, x1: f32, y1: f32) -> void {
    const f = funcAt(p, PUSH_CLIP_RECTANGLE)
    if f == 0 { return }
    const call: RectangleFunc = unsafe { @ptrFromInt(RectangleFunc, f) }
    call(p, data, x0, y0, x1, y1, dataAt(p, PUSH_CLIP_RECTANGLE))
}

pub fn color(p: usize, data: usize, isForeground: bool, c: u32) -> void {
    const f = funcAt(p, COLOR)
    if f == 0 { return }
    const call: ColorFunc = unsafe { @ptrFromInt(ColorFunc, f) }
    call(p, data, if isForeground { 1 } else { 0 }, c, dataAt(p, COLOR))
}

pub fn image(p: usize, data: usize, b: usize, width: u32, height: u32, format: u32, slant: f32, extents: usize) -> bool {
    const f = funcAt(p, IMAGE)
    if f == 0 { return false }
    const call: ImageFunc = unsafe { @ptrFromInt(ImageFunc, f) }
    return call(p, data, b, width, height, format, slant, extents, dataAt(p, IMAGE)) != 0
}

fn gradient6(p: usize, i: usize, data: usize, line: usize, a: f32, b: f32, c: f32, d: f32, e: f32, g: f32) -> void {
    const f = funcAt(p, i)
    if f == 0 { return }
    const call: LinearFunc = unsafe { @ptrFromInt(LinearFunc, f) }
    call(p, data, line, a, b, c, d, e, g, dataAt(p, i))
}

pub fn linearGradient(p: usize, data: usize, line: usize, x0: f32, y0: f32, x1: f32, y1: f32, x2: f32, y2: f32) -> void { gradient6(p, LINEAR_GRADIENT, data, line, x0, y0, x1, y1, x2, y2) }
pub fn radialGradient(p: usize, data: usize, line: usize, x0: f32, y0: f32, r0: f32, x1: f32, y1: f32, r1: f32) -> void { gradient6(p, RADIAL_GRADIENT, data, line, x0, y0, r0, x1, y1, r1) }

pub fn sweepGradient(p: usize, data: usize, line: usize, x0: f32, y0: f32, a0: f32, a1: f32) -> void {
    const f = funcAt(p, SWEEP_GRADIENT)
    if f == 0 { return }
    const call: SweepFunc = unsafe { @ptrFromInt(SweepFunc, f) }
    call(p, data, line, x0, y0, a0, a1, dataAt(p, SWEEP_GRADIENT))
}

pub fn popGroup(p: usize, data: usize, mode: u32) -> void {
    const f = funcAt(p, POP_GROUP)
    if f == 0 { return }
    const call: PopGroupFunc = unsafe { @ptrFromInt(PopGroupFunc, f) }
    call(p, data, mode, dataAt(p, POP_GROUP))
}

pub fn customPaletteColor(p: usize, data: usize, index: u32, out: usize) -> bool {
    const f = funcAt(p, CUSTOM_PALETTE_COLOR)
    if f == 0 { return false }
    const call: PaletteFunc = unsafe { @ptrFromInt(PaletteFunc, f) }
    return call(p, data, index, out, dataAt(p, CUSTOM_PALETTE_COLOR)) != 0
}

export fn hb_paint_push_transform(p: usize, data: usize, xx: f32, yx: f32, xy: f32, yy: f32, dx: f32, dy: f32) -> void { pushTransform(p, data, xx, yx, xy, yy, dx, dy) }
export fn hb_paint_pop_transform(p: usize, data: usize) -> void { popTransform(p, data) }
export fn hb_paint_color_glyph(p: usize, data: usize, glyph: u32, font: usize) -> i32 { return if colorGlyph(p, data, glyph, font) { 1 } else { 0 } }
export fn hb_paint_push_clip_glyph(p: usize, data: usize, glyph: u32, font: usize) -> void { pushClipGlyph(p, data, glyph, font) }
export fn hb_paint_push_clip_rectangle(p: usize, data: usize, x0: f32, y0: f32, x1: f32, y1: f32) -> void { pushClipRectangle(p, data, x0, y0, x1, y1) }
export fn hb_paint_pop_clip(p: usize, data: usize) -> void { popClip(p, data) }
export fn hb_paint_color(p: usize, data: usize, fg: i32, c: u32) -> void { color(p, data, fg != 0, c) }
export fn hb_paint_image(p: usize, data: usize, b: usize, w: u32, h: u32, format: u32, slant: f32, extents: usize) -> void { _ = image(p, data, b, w, h, format, slant, extents) }
export fn hb_paint_linear_gradient(p: usize, data: usize, line: usize, x0: f32, y0: f32, x1: f32, y1: f32, x2: f32, y2: f32) -> void { linearGradient(p, data, line, x0, y0, x1, y1, x2, y2) }
export fn hb_paint_radial_gradient(p: usize, data: usize, line: usize, x0: f32, y0: f32, r0: f32, x1: f32, y1: f32, r1: f32) -> void { radialGradient(p, data, line, x0, y0, r0, x1, y1, r1) }
export fn hb_paint_sweep_gradient(p: usize, data: usize, line: usize, x0: f32, y0: f32, a0: f32, a1: f32) -> void { sweepGradient(p, data, line, x0, y0, a0, a1) }
export fn hb_paint_push_group(p: usize, data: usize) -> void { pushGroup(p, data) }
export fn hb_paint_pop_group(p: usize, data: usize, mode: u32) -> void { popGroup(p, data, mode) }
export fn hb_paint_custom_palette_color(p: usize, data: usize, index: u32, out: usize) -> i32 { return if customPaletteColor(p, data, index, out) { 1 } else { 0 } }

// Color lines (hb_color_line_t): data, get_color_stops and its user data,
// get_extend and its user data, then reserved words.
pub const StopsFunc = fn(usize, usize, u32, usize, usize, usize) -> u32
pub const ExtendFunc = fn(usize, usize, usize) -> u32

export fn hb_color_line_get_color_stops(line: usize, start: u32, count: usize, stops: usize) -> u32 {
    const call: StopsFunc = unsafe { @ptrFromInt(StopsFunc, m.getWord(line + 8)) }
    return call(line, m.getWord(line), start, count, stops, m.getWord(line + 16))
}

export fn hb_color_line_get_extend(line: usize) -> u32 {
    const call: ExtendFunc = unsafe { @ptrFromInt(ExtendFunc, m.getWord(line + 24)) }
    return call(line, m.getWord(line), m.getWord(line + 32))
}
