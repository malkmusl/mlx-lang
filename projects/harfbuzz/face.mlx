// hb-face.h: faces (HarfBuzz's hb-face.cc and hb-open-file.hh). A face
// gives the tables of a font: of a blob holding an OpenType font or a
// collection of them, or of a program's function (hb_face_create_for_tables,
// as WebKit and Skia make their faces), or of tables added one by one (a
// face builder). The tables the library reads are referenced once and
// kept with the face, and so are the structures it makes of them
// (accelerators: GSUB's and GPOS's lookups, the chosen cmap subtable...).
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const blob = @import("./blob.mlx")

// The tables the library keeps.
pub const T_CMAP: usize = 0
pub const T_HEAD: usize = 1
pub const T_HHEA: usize = 2
pub const T_HMTX: usize = 3
pub const T_VHEA: usize = 4
pub const T_VMTX: usize = 5
pub const T_MAXP: usize = 6
pub const T_OS2: usize = 7
pub const T_POST: usize = 8
pub const T_NAME: usize = 9
pub const T_GLYF: usize = 10
pub const T_LOCA: usize = 11
pub const T_CFF: usize = 12
pub const T_CFF2: usize = 13
pub const T_GDEF: usize = 14
pub const T_GSUB: usize = 15
pub const T_GPOS: usize = 16
pub const T_KERN: usize = 17
pub const T_FVAR: usize = 18
pub const T_AVAR: usize = 19
pub const T_HVAR: usize = 20
pub const T_VVAR: usize = 21
pub const T_MVAR: usize = 22
pub const T_GVAR: usize = 23
pub const T_COLR: usize = 24
pub const T_CPAL: usize = 25
pub const T_SBIX: usize = 26
pub const T_CBDT: usize = 27
pub const T_CBLC: usize = 28
pub const T_SVG: usize = 29
pub const T_MATH: usize = 30
pub const T_META: usize = 31
pub const T_BASE: usize = 32
pub const T_VORG: usize = 33
pub const T_STAT: usize = 34
pub const T_MORX: usize = 35
pub const T_KERX: usize = 36
pub const T_TRAK: usize = 37
pub const T_JSTF: usize = 38
pub const T_LTAG: usize = 39
pub const TABLE_SLOTS: usize = 40

pub fn tagOfSlot(slot: usize) -> u32 {
    const tags = [_]u32{
        0x636D6170, 0x68656164, 0x68686561, 0x686D7478, 0x76686561, 0x766D7478, 0x6D617870, 0x4F532F32,
        0x706F7374, 0x6E616D65, 0x676C7966, 0x6C6F6361, 0x43464620, 0x43464632, 0x47444546, 0x47535542,
        0x47504F53, 0x6B65726E, 0x66766172, 0x61766172, 0x48564152, 0x56564152, 0x4D564152, 0x67766172,
        0x434F4C52, 0x4350414C, 0x73626978, 0x43424454, 0x43424C43, 0x53564720, 0x4D415448, 0x6D657461,
        0x42415345, 0x564F5247, 0x53544154, 0x6D6F7278, 0x6B657278, 0x7472616B, 0x4A535446, 0x6C746167,
    }
    return tags[slot]
}

// The structures made of the tables (accelerators), each with the C
// function that frees it.
pub const A_GDEF: usize = 0
pub const A_GSUB: usize = 1
pub const A_GPOS: usize = 2
pub const A_CMAP: usize = 3
pub const A_HMTX: usize = 4
pub const A_VMTX: usize = 5
pub const A_GLYF: usize = 6
pub const A_CFF: usize = 7
pub const A_CFF2: usize = 8
pub const A_POST: usize = 9
pub const A_KERN: usize = 10
pub const A_VAR: usize = 11
pub const A_COLOR: usize = 12
pub const A_NAME: usize = 13
pub const A_SHAPER: usize = 14
pub const ACCEL_SLOTS: usize = 16

// How a face gets its tables.
pub const SOURCE_FUNCTION: u32 = 0
pub const SOURCE_DATA: u32 = 1
pub const SOURCE_BUILDER: u32 = 2

pub const Face = struct {
    refcount: u32
    writable: u32
    userList: usize
    lock: u32
    count: u32
    source: u32
    index: u32
    // The program's reference_table function and its data, or the blob of
    // a data face, or the list of a builder.
    referenceTable: usize
    userData: usize
    destroy: usize
    // A data face: the font's offset in its blob (the face of a collection).
    faceOffset: u32
    upem: u32
    numGlyphs: u32
    planLock: u32
    tables: usize
    accels: usize
    accelFrees: usize
    // The shape plans made for the face (hb_shape_plan_create_cached).
    plans: usize
}

pub fn face(address: usize) -> *Face { unsafe { return @ptrFromInt(*Face, address) } }

var emptyFace: usize = 0

fn makeEmpty() -> usize {
    const made = o.createInert(@sizeOf(Face))
    const f = face(made)
    f.*.upem = 1000
    f.*.numGlyphs = 0
    f.*.tables = m.alloc(TABLE_SLOTS * 8)
    f.*.accels = m.alloc(ACCEL_SLOTS * 8)
    f.*.accelFrees = m.alloc(ACCEL_SLOTS * 8)
    return made
}

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyFace))
    if e == 0 {
        const made = makeEmpty()
        if !m.swapWord(@intFromPtr(&emptyFace), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyFace))
    }
    return e
}

fn newFace(source: u32, referenceTable: usize, userData: usize, destroy: usize) -> usize {
    const address = o.create(@sizeOf(Face))
    if address == 0 {
        o.callDestroy(destroy, userData)
        return getEmpty()
    }
    const f = face(address)
    f.*.source = source
    f.*.referenceTable = referenceTable
    f.*.userData = userData
    f.*.destroy = destroy
    f.*.numGlyphs = 0xFFFFFFFF
    f.*.tables = m.alloc(TABLE_SLOTS * 8)
    f.*.accels = m.alloc(ACCEL_SLOTS * 8)
    f.*.accelFrees = m.alloc(ACCEL_SLOTS * 8)
    return address
}

// ---------------------------------------------------------------------------
// The OpenType font file: one font, or a collection of them.

const TAG_TRUETYPE: u32 = 0x00010000
const TAG_CFF: u32 = 0x4F54544F
const TAG_TRUE: u32 = 0x74727565
const TAG_TYP1: u32 = 0x74797031
const TAG_TTC: u32 = 0x74746366

// The number of fonts in the bytes of a font file.
pub fn faceCountOf(data: usize, length: usize) -> u32 {
    if length < 4 { return 0 }
    const t = m.be32(data)
    if t == TAG_TRUETYPE || t == TAG_CFF || t == TAG_TRUE || t == TAG_TYP1 { return 1 }
    if t == TAG_TTC {
        if length < 12 { return 0 }
        const major = m.be16(data + 4)
        if major != 1 && major != 2 { return 0 }
        const n = m.be32(data + 8)
        if @intCast(usize, n) * 4 + 12 > length { return 0 }
        return n
    }
    return 0
}

// The offset of the table directory of font `index` in the file (0
// when there is none... a single font's directory is at 0 too: the
// result's second value says whether there is one).
fn directoryOf(data: usize, length: usize, index: u32) -> (usize, bool) {
    if length < 12 { return -> (0, false) }
    const t = m.be32(data)
    if t == TAG_TRUETYPE || t == TAG_CFF || t == TAG_TRUE || t == TAG_TYP1 { return -> (0, true) }
    if t == TAG_TTC {
        const n = faceCountOf(data, length)
        if index >= n { return -> (0, false) }
        const offset = @intCast(usize, m.be32(data + 12 + @intCast(usize, index) * 4))
        if offset + 12 > length { return -> (0, false) }
        return -> (offset, true)
    }
    return -> (0, false)
}

// The offset and length of table `tag` in the font whose directory is at
// `dir` (length 0: none).
fn findTable(data: usize, length: usize, dir: usize, tag: u32) -> (usize, usize) {
    var numTables = @intCast(usize, m.be16(data + dir + 4))
    if dir + 12 + numTables * 16 > length { numTables = (length - dir - 12) / 16 }
    var i: usize = 0
    if numTables < 16 {
        while i < numTables {
            const r = data + dir + 12 + i * 16
            if m.be32(r) == tag { return -> (@intCast(usize, m.be32(r + 8)), @intCast(usize, m.be32(r + 12))) }
            i += 1
        }
        return -> (0, 0)
    }
    var low: usize = 0
    var high: usize = numTables
    while low < high {
        const mid = (low + high) / 2
        const r = data + dir + 12 + mid * 16
        const t = m.be32(r)
        if t == tag { return -> (@intCast(usize, m.be32(r + 8)), @intCast(usize, m.be32(r + 12))) }
        if t < tag { low = mid + 1 } else { high = mid }
    }
    return -> (0, 0)
}

export fn hb_face_count(b: usize) -> u32 {
    if b == 0 { return 0 }
    const bb = blob.blob(b)
    return faceCountOf(bb.*.data, @intCast(usize, bb.*.length))
}

// ---------------------------------------------------------------------------
// Creating and destroying faces

export fn hb_face_create_for_tables(func: usize, user_data: usize, destroy: usize) -> usize {
    if func == 0 {
        o.callDestroy(destroy, user_data)
        return getEmpty()
    }
    return newFace(SOURCE_FUNCTION, func, user_data, destroy)
}

pub fn createForData(b_: usize, index: u32) -> usize {
    var b = b_
    if b == 0 { b = blob.getEmpty() }
    b = o.reference(b)
    const f = newFace(SOURCE_DATA, 0, b, 0)
    if f == getEmpty() {
        blob.destroyBlob(b)
        return f
    }
    face(f).*.index = index
    return f
}

export fn hb_face_create(b: usize, index: u32) -> usize { return createForData(b, index) }
export fn hb_face_get_empty() -> usize { return getEmpty() }
export fn hb_face_reference(f: usize) -> usize { return o.reference(f) }

pub const PlanDestroy = fn(usize) -> void

pub fn destroyFace(address: usize) -> void {
    if !o.destroy(address) { return }
    const f = face(address)
    // (Shape plans: their destroy function is in the list's entries.)
    var node = f.*.plans
    while node != 0 {
        const next = m.getWord(node)
        o.callDestroy(m.getWord(node + 16), m.getWord(node + 8))
        m.release(node)
        node = next
    }
    var i: usize = 0
    while i < ACCEL_SLOTS {
        const a = m.getWord(f.*.accels + i * 8)
        if a != 0 { o.callDestroy(m.getWord(f.*.accelFrees + i * 8), a) }
        i += 1
    }
    i = 0
    while i < TABLE_SLOTS {
        const t = m.getWord(f.*.tables + i * 8)
        if t != 0 { blob.destroyBlob(t) }
        i += 1
    }
    m.release(f.*.tables)
    m.release(f.*.accels)
    m.release(f.*.accelFrees)
    if f.*.source == SOURCE_DATA {
        blob.destroyBlob(f.*.userData)
    } else if f.*.source == SOURCE_BUILDER {
        destroyBuilderList(f.*.userData)
    } else {
        o.callDestroy(f.*.destroy, f.*.userData)
    }
    m.release(address)
}

export fn hb_face_destroy(f: usize) -> void { destroyFace(f) }
export fn hb_face_set_user_data(f: usize, key: usize, data: usize, destroy: usize, replace: i32) -> i32 { return if o.setUserData(f, key, data, destroy, replace != 0) { 1 } else { 0 } }
export fn hb_face_get_user_data(f: usize, key: usize) -> usize { return o.getUserData(f, key) }
export fn hb_face_make_immutable(f: usize) -> void { o.makeImmutable(f) }
export fn hb_face_is_immutable(f: usize) -> i32 { return if o.isImmutable(f) { 1 } else { 0 } }

// ---------------------------------------------------------------------------
// Tables

pub const ReferenceTableFunc = fn(usize, u32, usize) -> usize

// A new reference to table `tag` (the whole font file for tag 0), the
// empty blob when there is none.
pub fn referenceTable(address: usize, tag: u32) -> usize {
    const f = face(address)
    if f.*.source == SOURCE_DATA {
        const b = f.*.userData
        if tag == 0 { return o.reference(b) }
        const bb = blob.blob(b)
        const length = @intCast(usize, bb.*.length)
        const dir = directoryOf(bb.*.data, length, f.*.index & 0xFFFF)
        if !dir.1 { return blob.getEmpty() }
        const found = findTable(bb.*.data, length, dir.0, tag)
        if found.1 == 0 { return blob.getEmpty() }
        // (A table record's offset is from the start of the file.)
        return blob.subBlob(b, @intCast(u32, found.0 & 0xFFFFFFFF), @intCast(u32, found.1 & 0xFFFFFFFF))
    }
    if f.*.source == SOURCE_BUILDER { return builderReferenceTable(f.*.userData, tag) }
    if f.*.referenceTable == 0 { return blob.getEmpty() }
    const call: ReferenceTableFunc = unsafe { @ptrFromInt(ReferenceTableFunc, f.*.referenceTable) }
    const b = call(address, tag, f.*.userData)
    return if b != 0 { b } else { blob.getEmpty() }
}

export fn hb_face_reference_table(f: usize, tag: u32) -> usize {
    if tag == 0 { return blob.getEmpty() }
    return referenceTable(f, tag)
}

export fn hb_face_reference_blob(f: usize) -> usize { return referenceTable(f, 0) }

// The blob of a kept table (the empty blob when the font has none): kept
// with the face, not a new reference.
pub fn table(address: usize, slot: usize) -> usize {
    const f = face(address)
    const at = f.*.tables + slot * 8
    var t = m.atomicLoadWord(at)
    if t == 0 {
        const made = referenceTable(address, tagOfSlot(slot))
        if m.swapWord(at, 0, made) {
            t = made
        } else {
            blob.destroyBlob(made)
            t = m.atomicLoadWord(at)
        }
    }
    return t
}

// The bytes of a kept table.
pub fn view(address: usize, slot: usize, out: *m.Table) -> void {
    const b = blob.blob(table(address, slot))
    out.*.data = b.*.data
    out.*.length = @intCast(usize, b.*.length)
}

// The accelerator in `slot`, 0 when not made yet.
pub fn accel(address: usize, slot: usize) -> usize { return m.atomicLoadWord(face(address).*.accels + slot * 8) }

// Keeps `made` (freed by the C function `free`) in `slot` unless another
// thread kept one first; the one kept.
pub fn keepAccel(address: usize, slot: usize, made: usize, free: usize) -> usize {
    const f = face(address)
    // (The free function first: a reader of the slot never needs it.)
    if m.swapWord(f.*.accels + slot * 8, 0, made) {
        m.atomicStoreWord(f.*.accelFrees + slot * 8, free)
        return made
    }
    o.callDestroy(free, made)
    return accel(address, slot)
}

// ---------------------------------------------------------------------------
// Index, units per em, glyph count

export fn hb_face_set_index(f: usize, index: u32) -> void { if !o.isImmutable(f) { face(f).*.index = index } }
export fn hb_face_get_index(f: usize) -> u32 { return face(f).*.index }
export fn hb_face_set_upem(f: usize, upem: u32) -> void { if !o.isImmutable(f) { face(f).*.upem = upem } }

// The head table if it passes HarfBuzz's checks (version 1, its magic
// number, 54 bytes); its length 0 else.
pub fn headView(address: usize, out: *m.Table) -> void {
    view(address, T_HEAD, out)
    if out.*.length < 54 || m.u16at(out, 0) != 1 || m.u32at(out, 12) != 0x5F0F3CF5 { out.*.length = 0 }
}

pub fn upem(address: usize) -> u32 {
    const f = face(address)
    var u = m.atomicLoad32(@intFromPtr(&f.*.upem))
    if u == 0 {
        var h: m.Table = undefined
        headView(address, &h)
        u = m.u16at(&h, 18)
        if u < 16 || u > 16384 { u = 1000 }
        m.atomicStore32(@intFromPtr(&f.*.upem), u)
    }
    return u
}

export fn hb_face_get_upem(f: usize) -> u32 { return upem(f) }
export fn hb_face_set_glyph_count(f: usize, count: u32) -> void { if !o.isImmutable(f) { face(f).*.numGlyphs = count } }

pub fn numGlyphs(address: usize) -> u32 {
    const f = face(address)
    var n = m.atomicLoad32(@intFromPtr(&f.*.numGlyphs))
    if n == 0xFFFFFFFF {
        n = 0
        var h: m.Table = undefined
        headView(address, &h)
        const format = m.u16at(&h, 50)
        if format <= 1 {
            var loca: m.Table = undefined
            view(address, T_LOCA, &loca)
            const size: usize = if format == 0 { 2 } else { 4 }
            var count = loca.length / size
            if count < 1 { count = 1 }
            n = @intCast(u32, (count - 1) & 0xFFFFFFFF)
        }
        var maxp: m.Table = undefined
        view(address, T_MAXP, &maxp)
        const version = m.u32at(&maxp, 0)
        if (version == 0x00010000 && maxp.length >= 32) || (version == 0x00005000 && maxp.length >= 6) {
            const fromMaxp = m.u16at(&maxp, 4)
            if fromMaxp > n { n = fromMaxp }
        }
        m.atomicStore32(@intFromPtr(&f.*.numGlyphs), n)
    }
    return n
}

export fn hb_face_get_glyph_count(f: usize) -> u32 { return numGlyphs(f) }

export fn hb_face_get_table_tags(address: usize, start: u32, count: usize, tags: usize) -> u32 {
    const f = face(address)
    if f.*.source != SOURCE_DATA {
        if count != 0 { m.put32(count, 0) }
        return 0
    }
    const bb = blob.blob(f.*.userData)
    const length = @intCast(usize, bb.*.length)
    const dir = directoryOf(bb.*.data, length, f.*.index & 0xFFFF)
    var total: u32 = 0
    if dir.1 {
        total = m.be16(bb.*.data + dir.0 + 4)
        const room = (length - dir.0 - 12) / 16
        if @intCast(usize, total) > room { total = @intCast(u32, room) }
    }
    if count != 0 {
        var n: u32 = 0
        if start < total {
            n = total - start
            if n > m.get32(count) { n = m.get32(count) }
        }
        var i: u32 = 0
        while i < n {
            m.put32(tags + @intCast(usize, i) * 4, m.be32(bb.*.data + dir.0 + 12 + @intCast(usize, start + i) * 16))
            i += 1
        }
        m.put32(count, n)
    }
    return total
}

// ---------------------------------------------------------------------------
// Face builders: tables added one by one; the font file made of them when
// the whole blob is asked for. The list: entries of next, tag, blob.

fn destroyBuilderList(list: usize) -> void {
    var node = m.getWord(list)
    while node != 0 {
        const next = m.getWord(node)
        blob.destroyBlob(m.getWord(node + 16))
        m.release(node)
        node = next
    }
    m.release(list)
}

fn builderReferenceTable(list: usize, tag: u32) -> usize {
    if tag == 0 { return builderBlob(list) }
    var node = m.getWord(list)
    while node != 0 {
        if m.get32(node + 8) == tag { return o.reference(m.getWord(node + 16)) }
        node = m.getWord(node)
    }
    return blob.getEmpty()
}

export fn hb_face_builder_create() -> usize {
    const list = m.alloc(16)
    if list == 0 { return getEmpty() }
    return newFace(SOURCE_BUILDER, 0, list, 0)
}

export fn hb_face_builder_add_table(address: usize, tag: u32, b: usize) -> i32 {
    const f = face(address)
    if f.*.source != SOURCE_BUILDER || tag == 0 { return 0 }
    const list = f.*.userData
    var node = m.getWord(list)
    while node != 0 {
        if m.get32(node + 8) == tag {
            blob.destroyBlob(m.getWord(node + 16))
            m.putWord(node + 16, o.reference(b))
            return 1
        }
        node = m.getWord(node)
    }
    node = m.alloc(24)
    if node == 0 { return 0 }
    m.put32(node + 8, tag)
    m.putWord(node + 16, o.reference(b))
    // (Kept in order of their tags.)
    var at = list
    while m.getWord(at) != 0 && m.get32(m.getWord(at) + 8) < tag { at = m.getWord(at) }
    m.putWord(node, m.getWord(at))
    m.putWord(at, node)
    return 1
}

export fn hb_face_builder_sort_tables(address: usize, tags: usize) -> void {
    const f = face(address)
    if f.*.source != SOURCE_BUILDER || tags == 0 { return }
    // (The tables named first, in that order, then the rest as they are.)
    const list = f.*.userData
    var placed = list
    var t = tags
    while m.get32(t) != 0 {
        const want = m.get32(t)
        var at = placed
        while m.getWord(at) != 0 && m.get32(m.getWord(at) + 8) != want { at = m.getWord(at) }
        const node = m.getWord(at)
        if node != 0 {
            m.putWord(at, m.getWord(node))
            m.putWord(node, m.getWord(placed))
            m.putWord(placed, node)
            placed = node
        }
        t += 4
    }
}

fn padded(n: usize) -> usize { return (n + 3) & 0xFFFFFFFFFFFFFFFC }

fn builderBlob(list: usize) -> usize {
    var count: usize = 0
    var size: usize = 0
    var node = m.getWord(list)
    var cff = false
    while node != 0 {
        count += 1
        size += padded(@intCast(usize, blob.blob(m.getWord(node + 16)).*.length))
        if m.get32(node + 8) == 0x43464620 { cff = true }
        node = m.getWord(node)
    }
    const total = 12 + count * 16 + size
    const data = m.alloc(total)
    if data == 0 { return blob.getEmpty() }
    putBE32(data, if cff { TAG_CFF } else { TAG_TRUETYPE })
    putBE16(data + 4, @intCast(u32, count))
    var entrySelector: u32 = 0
    while (@intCast(usize, 1) << @intCast(u6, entrySelector + 1)) <= count { entrySelector += 1 }
    const searchRange = (@intCast(u32, 1) << @intCast(u5, entrySelector)) * 16
    putBE16(data + 6, if count == 0 { 0 } else { searchRange })
    putBE16(data + 8, if count == 0 { 0 } else { entrySelector })
    putBE16(data + 10, if count == 0 { 0 } else { @intCast(u32, count * 16) - searchRange })
    var offset = 12 + count * 16
    var i: usize = 0
    node = m.getWord(list)
    while node != 0 {
        const b = blob.blob(m.getWord(node + 16))
        const length = @intCast(usize, b.*.length)
        m.copy(data + offset, b.*.data, length)
        var sum: u32 = 0
        var k: usize = 0
        while k < padded(length) {
            sum = sum +% m.be32(data + offset + k)
            k += 4
        }
        const r = data + 12 + i * 16
        putBE32(r, m.get32(node + 8))
        putBE32(r + 4, sum)
        putBE32(r + 8, @intCast(u32, offset))
        putBE32(r + 12, @intCast(u32, length))
        offset += padded(length)
        i += 1
        node = m.getWord(node)
    }
    return blob.create(data, @intCast(u32, total), blob.MODE_WRITABLE, data, @intFromPtr(m.free))
}

fn putBE16(address: usize, v: u32) -> void {
    m.put8(address, @intCast(u8, (v >> 8) & 0xFF))
    m.put8(address + 1, @intCast(u8, v & 0xFF))
}

fn putBE32(address: usize, v: u32) -> void {
    putBE16(address, v >> 16)
    putBE16(address + 2, v & 0xFFFF)
}
