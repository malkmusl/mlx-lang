// hb-blob.h: blobs, a range of bytes with the way it is held and the
// function that lets it go (HarfBuzz's hb-blob.cc): duplicated, read-only
// or writable memory, sub-blobs that keep their parent, files mapped.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")

extern("c") fn open(path: usize, flags: i32, mode: i32) -> i32
extern("c") fn close(fd: i32) -> i32
extern("c") fn lseek(fd: i32, offset: i64, whence: i32) -> i64
extern("c") fn mmap(address: usize, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> usize
extern("c") fn munmap(address: usize, length: usize) -> i32

pub const MODE_DUPLICATE: u32 = 0
pub const MODE_READONLY: u32 = 1
pub const MODE_WRITABLE: u32 = 2
pub const MODE_READONLY_MAY_MAKE_WRITABLE: u32 = 3

pub const Blob = struct {
    refcount: u32
    writable: u32
    userList: usize
    lock: u32
    count: u32
    data: usize
    length: u32
    mode: u32
    userData: usize
    destroy: usize
}

pub fn blob(address: usize) -> *Blob { unsafe { return @ptrFromInt(*Blob, address) } }

var emptyBlob: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyBlob))
    if e == 0 {
        const made = o.createInert(@sizeOf(Blob))
        blob(made).*.mode = MODE_READONLY
        if !m.swapWord(@intFromPtr(&emptyBlob), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyBlob))
    }
    return e
}

fn tryMakeWritable(b: *Blob) -> bool {
    if b.*.length == 0 { b.*.mode = MODE_WRITABLE }
    if b.*.mode == MODE_WRITABLE { return true }
    const copied = m.malloc(if b.*.length == 0 { 1 } else { @intCast(usize, b.*.length) })
    if copied == 0 { return false }
    m.copy(copied, b.*.data, @intCast(usize, b.*.length))
    o.callDestroy(b.*.destroy, b.*.userData)
    b.*.mode = MODE_WRITABLE
    b.*.data = copied
    b.*.userData = copied
    b.*.destroy = @intFromPtr(m.free)
    return true
}

pub fn createOrFail(data: usize, length: u32, mode: u32, userData: usize, destroy: usize) -> usize {
    if length >= 0x80000000 {
        o.callDestroy(destroy, userData)
        return 0
    }
    const address = o.create(@sizeOf(Blob))
    if address == 0 {
        o.callDestroy(destroy, userData)
        return 0
    }
    const b = blob(address)
    b.*.data = data
    b.*.length = length
    b.*.mode = mode
    b.*.userData = userData
    b.*.destroy = destroy
    if mode == MODE_DUPLICATE {
        b.*.mode = MODE_READONLY
        if !tryMakeWritable(b) {
            destroyBlob(address)
            return 0
        }
    }
    return address
}

pub fn create(data: usize, length: u32, mode: u32, userData: usize, destroy: usize) -> usize {
    if length == 0 {
        o.callDestroy(destroy, userData)
        return getEmpty()
    }
    const b = createOrFail(data, length, mode, userData, destroy)
    return if b != 0 { b } else { getEmpty() }
}

pub fn destroyBlob(address: usize) -> void {
    if !o.destroy(address) { return }
    const b = blob(address)
    o.callDestroy(b.*.destroy, b.*.userData)
    m.release(address)
}

export fn __mlx_hb_blob_destroy(address: usize) -> void { destroyBlob(address) }

pub fn subBlob(parent: usize, offset: u32, length: u32) -> usize {
    if length == 0 || parent == 0 || offset >= blob(parent).*.length { return getEmpty() }
    o.makeImmutable(parent)
    const p = blob(parent)
    const room = p.*.length - offset
    return create(p.*.data + @intCast(usize, offset), if length < room { length } else { room }, MODE_READONLY, o.reference(parent), @intFromPtr(__mlx_hb_blob_destroy))
}

export fn hb_blob_create(data: usize, length: u32, mode: u32, user_data: usize, destroy: usize) -> usize { return create(data, length, mode, user_data, destroy) }
export fn hb_blob_create_or_fail(data: usize, length: u32, mode: u32, user_data: usize, destroy: usize) -> usize { return createOrFail(data, length, mode, user_data, destroy) }
export fn hb_blob_create_sub_blob(parent: usize, offset: u32, length: u32) -> usize { return subBlob(parent, offset, length) }

export fn hb_blob_copy_writable_or_fail(address: usize) -> usize {
    const b = blob(address)
    const copied = create(b.*.data, b.*.length, MODE_DUPLICATE, 0, 0)
    return if copied == getEmpty() { 0 } else { copied }
}

export fn hb_blob_get_empty() -> usize { return getEmpty() }
export fn hb_blob_reference(address: usize) -> usize { return o.reference(address) }
export fn hb_blob_destroy(address: usize) -> void { destroyBlob(address) }
export fn hb_blob_set_user_data(address: usize, key: usize, data: usize, destroy: usize, replace: i32) -> i32 { return if o.setUserData(address, key, data, destroy, replace != 0) { 1 } else { 0 } }
export fn hb_blob_get_user_data(address: usize, key: usize) -> usize { return o.getUserData(address, key) }
export fn hb_blob_make_immutable(address: usize) -> void { o.makeImmutable(address) }
export fn hb_blob_is_immutable(address: usize) -> i32 { return if o.isImmutable(address) { 1 } else { 0 } }
export fn hb_blob_get_length(address: usize) -> u32 { return blob(address).*.length }

export fn hb_blob_get_data(address: usize, length: usize) -> usize {
    const b = blob(address)
    if length != 0 { m.put32(length, b.*.length) }
    return b.*.data
}

export fn hb_blob_get_data_writable(address: usize, length: usize) -> usize {
    const b = blob(address)
    if o.isImmutable(address) || !tryMakeWritable(b) {
        if length != 0 { m.put32(length, 0) }
        return 0
    }
    if length != 0 { m.put32(length, b.*.length) }
    return b.*.data
}

// Files: mapped read-only, unmapped when the blob goes.
export fn __mlx_hb_unmap_file(file: usize) -> void {
    _ = munmap(m.getWord(file), m.getWord(file + 8))
    m.release(file)
}

pub fn createFromFileOrFail(name: usize) -> usize {
    if name == 0 { return 0 }
    const fd = open(name, 0, 0)
    if fd < 0 { return 0 }
    const size = lseek(fd, 0, 2)
    if size <= 0 || size >= 0x80000000 {
        _ = close(fd)
        return 0
    }
    const address = mmap(0, @intCast(usize, size), 1, 2, fd, 0)
    _ = close(fd)
    if address == 0xFFFFFFFFFFFFFFFF || address == 0 { return 0 }
    const file = m.alloc(16)
    if file == 0 {
        _ = munmap(address, @intCast(usize, size))
        return 0
    }
    m.putWord(file, address)
    m.putWord(file + 8, @intCast(usize, size))
    return createOrFail(address, @intCast(u32, size), MODE_READONLY_MAY_MAKE_WRITABLE, file, @intFromPtr(__mlx_hb_unmap_file))
}

export fn hb_blob_create_from_file_or_fail(name: usize) -> usize { return createFromFileOrFail(name) }

export fn hb_blob_create_from_file(name: usize) -> usize {
    const b = createFromFileOrFail(name)
    return if b != 0 { b } else { getEmpty() }
}
