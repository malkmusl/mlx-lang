// What the library stands on: memory by address (the C world's objects
// are reached through their addresses, as the freetype, glib and unicode
// libraries do it), the bytes of a font read big-endian and bounded by
// their table, C strings, atomics, and the float arithmetic of C's
// roundf, floorf and ceilf.
//
// The functions here make no aggregates: an exported function's arena is
// given back only when it returns, and shaping runs loops within one call.

pub extern("c") fn malloc(size: usize) -> usize
pub extern("c") fn calloc(count: usize, size: usize) -> usize
pub extern("c") fn realloc(address: usize, size: usize) -> usize
pub extern("c") fn free(address: usize) -> void
pub extern("c") fn memmove(target: usize, source: usize, count: usize) -> usize
pub extern("c") fn memset(target: usize, value: i32, count: usize) -> usize
pub extern("c") fn getenv(name: usize) -> usize
pub extern("c") fn setlocale(category: i32, locale: usize) -> usize

pub fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
pub fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
pub fn get16(address: usize) -> u16 { unsafe { return @ptrFromInt(*u16, address).* } }
pub fn put16(address: usize, value: u16) -> void { unsafe { @ptrFromInt(*u16, address).* = value } }
pub fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
pub fn put32(address: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, address).* = value } }
pub fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
pub fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
pub fn getI32(address: usize) -> i32 { return @bitCast(i32, get32(address)) }
pub fn putI32(address: usize, value: i32) -> void { put32(address, @bitCast(u32, value)) }
pub fn getF32(address: usize) -> f32 { unsafe { return @ptrFromInt(*f32, address).* } }
pub fn putF32(address: usize, value: f32) -> void { unsafe { @ptrFromInt(*f32, address).* = value } }
pub fn word32(address: usize) -> *u32 { unsafe { return @ptrFromInt(*u32, address) } }
pub fn word64(address: usize) -> *u64 { unsafe { return @ptrFromInt(*u64, address) } }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count == 0 || target == source { return }
    _ = memmove(target, source, count)
}

pub fn zero(target: usize, count: usize) -> void {
    if count == 0 { return }
    _ = memset(target, 0, count)
}

// `size` zeroed bytes (0 when there are none).
pub fn alloc(size: usize) -> usize { return calloc(1, if size == 0 { 1 } else { size }) }
pub fn release(address: usize) -> void { if address != 0 { free(address) } }

// The block at `address` grown to `size` bytes (0 when it cannot be).
pub fn grow(address: usize, size: usize) -> usize {
    if address == 0 { return alloc(size) }
    return realloc(address, size)
}

// The address of a literal's bytes (a NUL follows them), for C.
pub fn literal(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

// A C string's length.
pub fn cLength(text: usize) -> usize {
    if text == 0 { return 0 }
    var count: usize = 0
    while get8(text + count) != 0 { count += 1 }
    return count
}

// Whether the `length` bytes at `text` are the bytes of `word`.
pub fn bytesAre(text: usize, length: usize, word: []const u8) -> bool {
    if length != word.length { return false }
    var index: usize = 0
    while index < length {
        if get8(text + index) != word[index] { return false }
        index += 1
    }
    return true
}

// Whether the `length` bytes at `a` and at `b` are the same.
pub fn sameBytes(a: usize, b: usize, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if get8(a + index) != get8(b + index) { return false }
        index += 1
    }
    return true
}

// A copy of `length` bytes at `text`, NUL-ended.
pub fn dupBytes(text: usize, length: usize) -> usize {
    const copied = alloc(length + 1)
    if copied == 0 { return 0 }
    copy(copied, text, length)
    return copied
}

// Copies the C string `text` into `buffer` of `size` bytes (cut short, a
// NUL always ending it when there is room for one); the length copied.
pub fn copyString(buffer: usize, size: usize, text: []const u8) -> usize {
    if size == 0 || buffer == 0 { return 0 }
    var length = text.length
    if length > size - 1 { length = size - 1 }
    var index: usize = 0
    while index < length {
        put8(buffer + index, text[index])
        index += 1
    }
    put8(buffer + length, 0)
    return length
}

pub fn lower(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }
pub fn isSpace(c: u8) -> bool { return c == 32 || (c >= 9 && c <= 13) }
pub fn isAlpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
pub fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }

// ---------------------------------------------------------------------------
// The bytes of a font's table, read big-endian. A read past the table's
// end is 0, as HarfBuzz reads a part of a table that does not pass its
// checks as an empty one.

pub const Table = struct {
    data: usize
    length: usize
}

pub fn u8at(t: *const Table, offset: usize) -> u32 {
    if offset >= t.*.length { return 0 }
    return @intCast(u32, get8(t.*.data + offset))
}

pub fn u16at(t: *const Table, offset: usize) -> u32 {
    if offset + 2 > t.*.length || offset + 2 < offset { return 0 }
    const a = t.*.data + offset
    return (@intCast(u32, get8(a)) << 8) | @intCast(u32, get8(a + 1))
}

pub fn i16at(t: *const Table, offset: usize) -> i32 { return @intCast(i32, @bitCast(i16, @intCast(u16, u16at(t, offset)))) }

pub fn u24at(t: *const Table, offset: usize) -> u32 {
    if offset + 3 > t.*.length || offset + 3 < offset { return 0 }
    const a = t.*.data + offset
    return (@intCast(u32, get8(a)) << 16) | (@intCast(u32, get8(a + 1)) << 8) | @intCast(u32, get8(a + 2))
}

pub fn u32at(t: *const Table, offset: usize) -> u32 {
    if offset + 4 > t.*.length || offset + 4 < offset { return 0 }
    const a = t.*.data + offset
    return (@intCast(u32, get8(a)) << 24) | (@intCast(u32, get8(a + 1)) << 16) | (@intCast(u32, get8(a + 2)) << 8) | @intCast(u32, get8(a + 3))
}

pub fn i32at(t: *const Table, offset: usize) -> i32 { return @bitCast(i32, u32at(t, offset)) }

// Whether `size` bytes from `offset` are in the table.
pub fn fits(t: *const Table, offset: usize, size: usize) -> bool { return offset <= t.*.length && size <= t.*.length - offset }

// Big-endian values at an address (the caller has checked the bounds).
pub fn be16(address: usize) -> u32 { return (@intCast(u32, get8(address)) << 8) | @intCast(u32, get8(address + 1)) }
pub fn be32(address: usize) -> u32 { return (@intCast(u32, get8(address)) << 24) | (@intCast(u32, get8(address + 1)) << 16) | (@intCast(u32, get8(address + 2)) << 8) | @intCast(u32, get8(address + 3)) }

// ---------------------------------------------------------------------------
// Atomics.

pub fn atomicLoad32(address: usize) -> u32 { return @atomicLoad(u32, word32(address), acquire) }
pub fn atomicStore32(address: usize, value: u32) -> void { @atomicStore(u32, word32(address), value, release) }
pub fn atomicAdd32(address: usize, value: u32) -> u32 { return @atomicRmw(u32, word32(address), add, value, acq_rel) }
pub fn atomicSub32(address: usize, value: u32) -> u32 { return @atomicRmw(u32, word32(address), sub, value, acq_rel) }
pub fn atomicLoadWord(address: usize) -> usize { return @intCast(usize, @atomicLoad(u64, word64(address), acquire)) }
pub fn atomicStoreWord(address: usize, value: usize) -> void { @atomicStore(u64, word64(address), @intCast(u64, value), release) }

// Sets the word at `address` to `value` when it holds `expected`; whether
// it did.
pub fn swapWord(address: usize, expected: usize, value: usize) -> bool {
    const result = @cmpxchgStrong(u64, word64(address), @intCast(u64, expected), @intCast(u64, value), acq_rel, acquire)
    return result.0
}

// A spin lock in the word at `address` (0 free, 1 held).
pub fn lock(address: usize) -> void {
    while true {
        const result = @cmpxchgStrong(u32, word32(address), 0, 1, acquire, monotonic)
        if result.0 { return }
    }
}

pub fn unlock(address: usize) -> void { @atomicStore(u32, word32(address), 0, release) }

// ---------------------------------------------------------------------------
// C's float functions.

pub fn floorf(x: f32) -> f32 { return @floor(x) }
pub fn ceilf(x: f32) -> f32 { return @ceil(x) }

// The nearest whole number, halves away from zero (C's roundf).
pub fn roundf(x: f32) -> f32 {
    const t = @trunc(x)
    const d = x - t
    if d >= 0.5 { return t + 1.0 }
    if d <= -0.5 { return t - 1.0 }
    return t
}

pub fn round(x: f64) -> f64 {
    const t = @trunc(x)
    const d = x - t
    if d >= 0.5 { return t + 1.0 }
    if d <= -0.5 { return t - 1.0 }
    return t
}

pub fn fabsf(x: f32) -> f32 { return if x < 0.0 { 0.0 - x } else { x } }

// A float made a C int as C converts it (toward zero; out of range is
// INT_MIN, as x86's conversion gives).
pub fn intOf(x: f32) -> i32 {
    if !(x > -2147483904.0 && x < 2147483648.0) { return -2147483647 - 1 }
    return @intCast(i32, @intFromFloat(i64, x))
}

pub fn intOf64(x: f64) -> i32 {
    if !(x > -2147483649.0 && x < 2147483648.0) { return -2147483647 - 1 }
    return @intCast(i32, @intFromFloat(i64, x))
}

pub fn min32(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
pub fn max32(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }
pub fn minU(a: u32, b: u32) -> u32 { return if a < b { a } else { b } }
pub fn maxU(a: u32, b: u32) -> u32 { return if a > b { a } else { b } }

// The low 32 bits of a value as a signed int (C's wrap of int arithmetic).
pub fn low32(v: i64) -> i32 { return @bitCast(i32, @intCast(u32, @bitCast(u64, v) & 0xFFFFFFFF)) }
