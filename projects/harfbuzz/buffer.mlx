// hb-buffer.h: buffers (HarfBuzz's hb-buffer.cc and hb-buffer.hh): the
// text to shape and, after shaping, the glyphs; and the operations the
// shaper does on them. The glyphs are hb_glyph_info_t and
// hb_glyph_position_t records of 20 bytes, `info` and `pos`. While a
// lookup rewrites the glyphs, an output array (`outInfo`) gets them: the
// same memory as `info` as long as it is not longer than what was read
// (`idx`), the memory of `pos` else; `sync` makes the output the glyphs.
const m = @import("./memory.mlx")
const o = @import("./object.mlx")
const common = @import("./common.mlx")
const unicode = @import("./unicode.mlx")

pub const GlyphInfo = struct {
    codepoint: u32
    mask: u32
    cluster: u32
    var1: u32
    var2: u32
}

pub const GlyphPosition = struct {
    xAdvance: i32
    yAdvance: i32
    xOffset: i32
    yOffset: i32
    var_: u32
}

pub const INFO_SIZE: usize = 20

pub const CONTENT_INVALID: u32 = 0
pub const CONTENT_UNICODE: u32 = 1
pub const CONTENT_GLYPHS: u32 = 2

pub const FLAG_BOT: u32 = 1
pub const FLAG_EOT: u32 = 2
pub const FLAG_PRESERVE_DEFAULT_IGNORABLES: u32 = 4
pub const FLAG_REMOVE_DEFAULT_IGNORABLES: u32 = 8
pub const FLAG_DO_NOT_INSERT_DOTTED_CIRCLE: u32 = 16
pub const FLAG_VERIFY: u32 = 32
pub const FLAG_PRODUCE_UNSAFE_TO_CONCAT: u32 = 64
pub const FLAG_PRODUCE_SAFE_TO_INSERT_TATWEEL: u32 = 128

pub const CLUSTER_MONOTONE_GRAPHEMES: u32 = 0
pub const CLUSTER_MONOTONE_CHARACTERS: u32 = 1
pub const CLUSTER_CHARACTERS: u32 = 2

pub const GLYPH_FLAG_UNSAFE_TO_BREAK: u32 = 1
pub const GLYPH_FLAG_UNSAFE_TO_CONCAT: u32 = 2
pub const GLYPH_FLAG_SAFE_TO_INSERT_TATWEEL: u32 = 4
pub const GLYPH_FLAG_DEFINED: u32 = 7

pub const SCRATCH_HAS_NON_ASCII: u32 = 1
pub const SCRATCH_HAS_DEFAULT_IGNORABLES: u32 = 2
pub const SCRATCH_HAS_SPACE_FALLBACK: u32 = 4
pub const SCRATCH_HAS_GPOS_ATTACHMENT: u32 = 8
pub const SCRATCH_HAS_CGJ: u32 = 16
pub const SCRATCH_HAS_GLYPH_FLAGS: u32 = 32
pub const SCRATCH_HAS_BROKEN_SYLLABLE: u32 = 64
pub const SCRATCH_SHAPER0: u32 = 0x01000000
pub const SCRATCH_SHAPER1: u32 = 0x02000000

const MAX_LEN_FACTOR: u64 = 64
const MAX_LEN_MIN: u32 = 16384
pub const MAX_LEN_DEFAULT: u32 = 0x3FFFFFFF
const MAX_OPS_FACTOR: u64 = 1024
const MAX_OPS_MIN: i32 = 16384
pub const MAX_OPS_DEFAULT: i32 = 0x1FFFFFFF

pub const Buffer = struct {
    refcount: u32
    writable: u32
    userList: usize
    lock: u32
    count: u32
    unicode: usize
    flags: u32
    clusterLevel: u32
    replacement: u32
    invisible: u32
    notFound: u32
    contentType: u32
    // hb_segment_properties_t: direction, script, language, reserved1, reserved2
    direction: u32
    script: u32
    language: usize
    reserved1: usize
    reserved2: usize
    successful: u32
    shapingFailed: u32
    haveOutput: u32
    havePositions: u32
    idx: u32
    len: u32
    outLen: u32
    allocated: u32
    info: usize
    outInfo: usize
    pos: usize
    context: [10]u32
    contextLen0: u32
    contextLen1: u32
    allocatedVarBits: u32
    serial: u32
    scratchFlags: u32
    maxLen: u32
    maxOps: i32
    messageDepth: u32
    messageFunc: usize
    messageData: usize
    messageDestroy: usize
}

pub fn buf(address: usize) -> *Buffer { unsafe { return @ptrFromInt(*Buffer, address) } }

pub fn infoAt(base: usize, i: u32) -> *GlyphInfo { unsafe { return @ptrFromInt(*GlyphInfo, base + @intCast(usize, i) * INFO_SIZE) } }
pub fn posAt(base: usize, i: u32) -> *GlyphPosition { unsafe { return @ptrFromInt(*GlyphPosition, base + @intCast(usize, i) * INFO_SIZE) } }

pub fn info(b: *Buffer, i: u32) -> *GlyphInfo { return infoAt(b.*.info, i) }
pub fn outInfo(b: *Buffer, i: u32) -> *GlyphInfo { return infoAt(b.*.outInfo, i) }
pub fn pos(b: *Buffer, i: u32) -> *GlyphPosition { return posAt(b.*.pos, i) }
pub fn cur(b: *Buffer) -> *GlyphInfo { return infoAt(b.*.info, b.*.idx) }
pub fn curAt(b: *Buffer, k: u32) -> *GlyphInfo { return infoAt(b.*.info, b.*.idx + k) }
pub fn curPos(b: *Buffer) -> *GlyphPosition { return posAt(b.*.pos, b.*.idx) }
pub fn prev(b: *Buffer) -> *GlyphInfo { return infoAt(b.*.outInfo, if b.*.outLen != 0 { b.*.outLen - 1 } else { 0 }) }

pub fn copyInfo(to: *GlyphInfo, from: *GlyphInfo) -> void {
    to.*.codepoint = from.*.codepoint
    to.*.mask = from.*.mask
    to.*.cluster = from.*.cluster
    to.*.var1 = from.*.var1
    to.*.var2 = from.*.var2
}

pub fn backtrackLen(b: *Buffer) -> u32 { return if b.*.haveOutput != 0 { b.*.outLen } else { b.*.idx } }
pub fn lookaheadLen(b: *Buffer) -> u32 { return b.*.len - b.*.idx }

pub fn nextSerial(b: *Buffer) -> u32 {
    b.*.serial = (b.*.serial + 1) & 0xFF
    if b.*.serial == 0 { b.*.serial = 1 }
    return b.*.serial
}

// ---------------------------------------------------------------------------
// Memory

pub fn enlarge(b: *Buffer, size: u32) -> bool {
    if b.*.successful == 0 { return false }
    if size > b.*.maxLen {
        b.*.successful = 0
        return false
    }
    var newAllocated = b.*.allocated
    const separate = b.*.outInfo != b.*.info
    while size >= newAllocated { newAllocated += (newAllocated >> 1) + 32 }
    const bytes = @intCast(usize, newAllocated) * INFO_SIZE
    const newPos = m.realloc(b.*.pos, bytes)
    if newPos != 0 { b.*.pos = newPos }
    const newInfo = m.realloc(b.*.info, bytes)
    if newInfo != 0 { b.*.info = newInfo }
    if newPos == 0 || newInfo == 0 { b.*.successful = 0 }
    b.*.outInfo = if separate { b.*.pos } else { b.*.info }
    if b.*.successful != 0 { b.*.allocated = newAllocated }
    return b.*.successful != 0
}

pub fn ensure(b: *Buffer, size: u32) -> bool {
    if size == 0 || size < b.*.allocated { return true }
    return enlarge(b, size)
}

pub fn makeRoomFor(b: *Buffer, numIn: u32, numOut: u32) -> bool {
    if !ensure(b, b.*.outLen + numOut) { return false }
    if b.*.outInfo == b.*.info && b.*.outLen + numOut > b.*.idx + numIn {
        b.*.outInfo = b.*.pos
        m.copy(b.*.outInfo, b.*.info, @intCast(usize, b.*.outLen) * INFO_SIZE)
    }
    return true
}

pub fn shiftForward(b: *Buffer, count: u32) -> bool {
    if !ensure(b, b.*.len + count) { return false }
    m.copy(b.*.info + @intCast(usize, b.*.idx + count) * INFO_SIZE, b.*.info + @intCast(usize, b.*.idx) * INFO_SIZE, @intCast(usize, b.*.len - b.*.idx) * INFO_SIZE)
    if b.*.idx + count > b.*.len { m.zero(b.*.info + @intCast(usize, b.*.len) * INFO_SIZE, @intCast(usize, b.*.idx + count - b.*.len) * INFO_SIZE) }
    b.*.len += count
    b.*.idx += count
    return true
}

// ---------------------------------------------------------------------------
// The buffer's state

pub fn clear(b: *Buffer) -> void {
    b.*.contentType = CONTENT_INVALID
    b.*.direction = 0
    b.*.script = 0
    b.*.language = 0
    b.*.reserved1 = 0
    b.*.reserved2 = 0
    b.*.successful = 1
    b.*.shapingFailed = 0
    b.*.haveOutput = 0
    b.*.havePositions = 0
    b.*.idx = 0
    b.*.len = 0
    b.*.outLen = 0
    b.*.outInfo = b.*.info
    var i: usize = 0
    while i < 10 {
        b.*.context[i] = 0
        i += 1
    }
    b.*.contextLen0 = 0
    b.*.contextLen1 = 0
    b.*.allocatedVarBits = 0
    b.*.serial = 0
    b.*.scratchFlags = 0
}

pub fn reset(b: *Buffer) -> void {
    unicode.destroyFuncs(b.*.unicode)
    b.*.unicode = unicode.getDefault()
    b.*.flags = 0
    b.*.clusterLevel = 0
    b.*.replacement = 0xFFFD
    b.*.invisible = 0
    b.*.notFound = 0
    clear(b)
}

// Before and after shaping.
pub fn enter(b: *Buffer) -> void {
    b.*.allocatedVarBits = 0
    b.*.serial = 0
    b.*.shapingFailed = 0
    b.*.scratchFlags = 0
    const l = @intCast(u64, b.*.len)
    var maxLen = l * MAX_LEN_FACTOR
    if maxLen < @intCast(u64, MAX_LEN_MIN) { maxLen = @intCast(u64, MAX_LEN_MIN) }
    if maxLen > 0xFFFFFFFF { maxLen = 0xFFFFFFFF }
    b.*.maxLen = @intCast(u32, maxLen)
    var maxOps = l * MAX_OPS_FACTOR
    if maxOps < 16384 { maxOps = 16384 }
    if maxOps > 0x7FFFFFFF { maxOps = 0x7FFFFFFF }
    b.*.maxOps = @intCast(i32, maxOps)
}

pub fn leave(b: *Buffer) -> void {
    b.*.maxLen = MAX_LEN_DEFAULT
    b.*.maxOps = MAX_OPS_DEFAULT
    b.*.allocatedVarBits = 0
    b.*.serial = 0
}

pub fn add(b: *Buffer, codepoint: u32, cluster: u32) -> void {
    if !ensure(b, b.*.len + 1) { return }
    const g = info(b, b.*.len)
    g.*.codepoint = codepoint
    g.*.mask = 0
    g.*.cluster = cluster
    g.*.var1 = 0
    g.*.var2 = 0
    b.*.len += 1
}

pub fn clearOutput(b: *Buffer) -> void {
    b.*.haveOutput = 1
    b.*.havePositions = 0
    b.*.idx = 0
    b.*.outLen = 0
    b.*.outInfo = b.*.info
}

pub fn clearPositions(b: *Buffer) -> void {
    b.*.haveOutput = 0
    b.*.havePositions = 1
    b.*.outLen = 0
    b.*.outInfo = b.*.info
    m.zero(b.*.pos, @intCast(usize, b.*.len) * INFO_SIZE)
}

// Makes the output the glyphs.
pub fn sync(b: *Buffer) -> bool {
    var ret = false
    if b.*.successful != 0 && nextGlyphs(b, b.*.len - b.*.idx) {
        if b.*.outInfo != b.*.info {
            b.*.pos = b.*.info
            b.*.info = b.*.outInfo
        }
        b.*.len = b.*.outLen
        ret = true
    }
    b.*.haveOutput = 0
    b.*.outLen = 0
    b.*.outInfo = b.*.info
    b.*.idx = 0
    return ret
}

pub fn syncSoFar(b: *Buffer) -> i32 {
    const hadOutput = b.*.haveOutput != 0
    const outI = b.*.outLen
    const i = b.*.idx
    const oldIdx = b.*.idx
    if sync(b) { b.*.idx = outI } else { b.*.idx = i }
    if hadOutput {
        b.*.haveOutput = 1
        b.*.outLen = b.*.idx
    }
    return @intCast(i32, b.*.idx) - @intCast(i32, oldIdx)
}

// Moves the reading position so that the output holds `i` glyphs.
pub fn moveTo(b: *Buffer, i: u32) -> bool {
    if b.*.haveOutput == 0 {
        b.*.idx = i
        return true
    }
    if b.*.successful == 0 { return false }
    if b.*.outLen < i {
        const count = i - b.*.outLen
        if !makeRoomFor(b, count, count) { return false }
        m.copy(b.*.outInfo + @intCast(usize, b.*.outLen) * INFO_SIZE, b.*.info + @intCast(usize, b.*.idx) * INFO_SIZE, @intCast(usize, count) * INFO_SIZE)
        b.*.idx += count
        b.*.outLen += count
    } else if b.*.outLen > i {
        const count = b.*.outLen - i
        if b.*.idx < count && !shiftForward(b, count - b.*.idx) { return false }
        b.*.idx -= count
        b.*.outLen -= count
        m.copy(b.*.info + @intCast(usize, b.*.idx) * INFO_SIZE, b.*.outInfo + @intCast(usize, b.*.outLen) * INFO_SIZE, @intCast(usize, count) * INFO_SIZE)
    }
    return true
}

// Replaces `numIn` glyphs from the reading position with the glyphs at
// `glyphs` (u32 each), copies of the current glyph (or the last output
// one at the end); their clusters merged.
pub fn replaceGlyphs(b: *Buffer, numIn: u32, numOut: u32, glyphs: usize) -> bool {
    if !makeRoomFor(b, numIn, numOut) { return false }
    mergeClusters(b, b.*.idx, b.*.idx + numIn)
    var orig: GlyphInfo = undefined
    copyInfo(&orig, if b.*.idx < b.*.len { cur(b) } else { prev(b) })
    var k: u32 = 0
    while k < numOut {
        const p = outInfo(b, b.*.outLen + k)
        copyInfo(p, &orig)
        p.*.codepoint = m.get32(glyphs + @intCast(usize, k) * 4)
        k += 1
    }
    b.*.idx += numIn
    b.*.outLen += numOut
    return true
}

pub fn replaceGlyph(b: *Buffer, glyph: u32) -> bool {
    var g = glyph
    return replaceGlyphs(b, 1, 1, @intFromPtr(&g))
}

pub fn outputGlyph(b: *Buffer, glyph: u32) -> bool {
    var g = glyph
    return replaceGlyphs(b, 0, 1, @intFromPtr(&g))
}

pub fn outputInfo(b: *Buffer, g: *GlyphInfo) -> bool {
    if !makeRoomFor(b, 0, 1) { return false }
    copyInfo(outInfo(b, b.*.outLen), g)
    b.*.outLen += 1
    return true
}

pub fn copyGlyph(b: *Buffer) -> bool {
    var g: GlyphInfo = undefined
    copyInfo(&g, cur(b))
    return outputInfo(b, &g)
}

pub fn nextGlyph(b: *Buffer) -> bool {
    if b.*.haveOutput != 0 {
        if b.*.outInfo != b.*.info || b.*.outLen != b.*.idx {
            if !makeRoomFor(b, 1, 1) { return false }
            copyInfo(outInfo(b, b.*.outLen), info(b, b.*.idx))
        }
        b.*.outLen += 1
    }
    b.*.idx += 1
    return true
}

pub fn nextGlyphs(b: *Buffer, n: u32) -> bool {
    if b.*.haveOutput != 0 {
        if b.*.outInfo != b.*.info || b.*.outLen != b.*.idx {
            if !makeRoomFor(b, n, n) { return false }
            m.copy(b.*.outInfo + @intCast(usize, b.*.outLen) * INFO_SIZE, b.*.info + @intCast(usize, b.*.idx) * INFO_SIZE, @intCast(usize, n) * INFO_SIZE)
        }
        b.*.outLen += n
    }
    b.*.idx += n
    return true
}

pub fn skipGlyph(b: *Buffer) -> void { b.*.idx += 1 }

pub fn resetMasks(b: *Buffer, mask: u32) -> void {
    var j: u32 = 0
    while j < b.*.len {
        info(b, j).*.mask = mask
        j += 1
    }
}

pub fn addMasks(b: *Buffer, mask: u32) -> void {
    var j: u32 = 0
    while j < b.*.len {
        info(b, j).*.mask |= mask
        j += 1
    }
}

pub fn setMasks(b: *Buffer, value_: u32, mask: u32, clusterStart: u32, clusterEnd: u32) -> void {
    if mask == 0 { return }
    const notMask = ~mask
    const value = value_ & mask
    var i: u32 = 0
    while i < b.*.len {
        const g = info(b, i)
        if clusterStart <= g.*.cluster && g.*.cluster < clusterEnd { g.*.mask = (g.*.mask & notMask) | value }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Clusters and glyph flags

pub fn setCluster(g: *GlyphInfo, cluster: u32, mask: u32) -> void {
    if g.*.cluster != cluster { g.*.mask = (g.*.mask & ~GLYPH_FLAG_DEFINED) | (mask & GLYPH_FLAG_DEFINED) }
    g.*.cluster = cluster
}

pub fn mergeClusters(b: *Buffer, start: u32, end: u32) -> void {
    if end < start + 2 { return }
    mergeClustersImpl(b, start, end)
}

fn mergeClustersImpl(b: *Buffer, start_: u32, end_: u32) -> void {
    var start = start_
    var end = end_
    if b.*.clusterLevel == CLUSTER_CHARACTERS {
        unsafeToBreak(b, start, end)
        return
    }
    var cluster = info(b, start).*.cluster
    var i = start + 1
    while i < end {
        if info(b, i).*.cluster < cluster { cluster = info(b, i).*.cluster }
        i += 1
    }
    if cluster != info(b, end - 1).*.cluster {
        while end < b.*.len && info(b, end - 1).*.cluster == info(b, end).*.cluster { end += 1 }
    }
    if cluster != info(b, start).*.cluster {
        while b.*.idx < start && info(b, start - 1).*.cluster == info(b, start).*.cluster { start -= 1 }
    }
    if b.*.idx == start && info(b, start).*.cluster != cluster {
        var k = b.*.outLen
        while k != 0 && outInfo(b, k - 1).*.cluster == info(b, start).*.cluster {
            setCluster(outInfo(b, k - 1), cluster, 0)
            k -= 1
        }
    }
    i = start
    while i < end {
        setCluster(info(b, i), cluster, 0)
        i += 1
    }
}

pub fn mergeOutClusters(b: *Buffer, start_: u32, end_: u32) -> void {
    var start = start_
    var end = end_
    if b.*.clusterLevel == CLUSTER_CHARACTERS { return }
    if end < start + 2 { return }
    var cluster = outInfo(b, start).*.cluster
    var i = start + 1
    while i < end {
        if outInfo(b, i).*.cluster < cluster { cluster = outInfo(b, i).*.cluster }
        i += 1
    }
    while start != 0 && outInfo(b, start - 1).*.cluster == outInfo(b, start).*.cluster { start -= 1 }
    while end < b.*.outLen && outInfo(b, end - 1).*.cluster == outInfo(b, end).*.cluster { end += 1 }
    if end == b.*.outLen {
        var k = b.*.idx
        while k < b.*.len && info(b, k).*.cluster == outInfo(b, end - 1).*.cluster {
            setCluster(info(b, k), cluster, 0)
            k += 1
        }
    }
    i = start
    while i < end {
        setCluster(outInfo(b, i), cluster, 0)
        i += 1
    }
}

// Deletes the current glyph, its cluster merged with a neighbour's.
pub fn deleteGlyph(b: *Buffer) -> void {
    const cluster = info(b, b.*.idx).*.cluster
    if (b.*.idx + 1 < b.*.len && cluster == info(b, b.*.idx + 1).*.cluster) || (b.*.outLen != 0 && cluster == outInfo(b, b.*.outLen - 1).*.cluster) {
        skipGlyph(b)
        return
    }
    if b.*.outLen != 0 {
        if cluster < outInfo(b, b.*.outLen - 1).*.cluster {
            const mask = info(b, b.*.idx).*.mask
            const old = outInfo(b, b.*.outLen - 1).*.cluster
            var k = b.*.outLen
            while k != 0 && outInfo(b, k - 1).*.cluster == old {
                setCluster(outInfo(b, k - 1), cluster, mask)
                k -= 1
            }
        }
        skipGlyph(b)
        return
    }
    if b.*.idx + 1 < b.*.len { mergeClusters(b, b.*.idx, b.*.idx + 2) }
    skipGlyph(b)
}

pub const FilterFunc = fn(*GlyphInfo) -> bool

// Deletes in place the glyphs the filter says (positions kept).
pub fn deleteGlyphsInplace(b: *Buffer, filter: FilterFunc) -> void {
    var j: u32 = 0
    const count = b.*.len
    var i: u32 = 0
    while i < count {
        if filter(info(b, i)) {
            const cluster = info(b, i).*.cluster
            if i + 1 < count && cluster == info(b, i + 1).*.cluster {
                i += 1
                continue
            }
            if j != 0 {
                if cluster < info(b, j - 1).*.cluster {
                    const mask = info(b, i).*.mask
                    const old = info(b, j - 1).*.cluster
                    var k = j
                    while k != 0 && info(b, k - 1).*.cluster == old {
                        setCluster(info(b, k - 1), cluster, mask)
                        k -= 1
                    }
                }
                i += 1
                continue
            }
            if i + 1 < count { mergeClusters(b, i, i + 2) }
            i += 1
            continue
        }
        if j != i {
            copyInfo(info(b, j), info(b, i))
            m.copy(b.*.pos + @intCast(usize, j) * INFO_SIZE, b.*.pos + @intCast(usize, i) * INFO_SIZE, INFO_SIZE)
        }
        j += 1
        i += 1
    }
    b.*.len = j
}

fn infosSetGlyphFlags(b: *Buffer, infos: usize, start: u32, end: u32, cluster: u32, mask: u32) -> void {
    if start == end { return }
    const first = infoAt(infos, start).*.cluster
    const last = infoAt(infos, end - 1).*.cluster
    if b.*.clusterLevel == CLUSTER_CHARACTERS || (cluster != first && cluster != last) {
        var i = start
        while i < end {
            if cluster != infoAt(infos, i).*.cluster {
                b.*.scratchFlags |= SCRATCH_HAS_GLYPH_FLAGS
                infoAt(infos, i).*.mask |= mask
            }
            i += 1
        }
        return
    }
    if cluster == first {
        var i = end
        while start < i && infoAt(infos, i - 1).*.cluster != first {
            b.*.scratchFlags |= SCRATCH_HAS_GLYPH_FLAGS
            infoAt(infos, i - 1).*.mask |= mask
            i -= 1
        }
    } else {
        var i = start
        while i < end && infoAt(infos, i).*.cluster != last {
            b.*.scratchFlags |= SCRATCH_HAS_GLYPH_FLAGS
            infoAt(infos, i).*.mask |= mask
            i += 1
        }
    }
}

fn infosFindMinCluster(b: *Buffer, infos: usize, start: u32, end: u32, cluster_: u32) -> u32 {
    var cluster = cluster_
    if start == end { return cluster }
    if b.*.clusterLevel == CLUSTER_CHARACTERS {
        var i = start
        while i < end {
            if infoAt(infos, i).*.cluster < cluster { cluster = infoAt(infos, i).*.cluster }
            i += 1
        }
        return cluster
    }
    const a = infoAt(infos, start).*.cluster
    const c = infoAt(infos, end - 1).*.cluster
    const lo = if a < c { a } else { c }
    return if lo < cluster { lo } else { cluster }
}

pub fn setGlyphFlags(b: *Buffer, mask: u32, start: u32, end_: u32, interior: bool, fromOut: bool) -> void {
    var end = end_
    if end > b.*.len { end = b.*.len }
    if interior && !fromOut && end < start + 2 { return }
    b.*.scratchFlags |= SCRATCH_HAS_GLYPH_FLAGS
    if !fromOut || b.*.haveOutput == 0 {
        if !interior {
            var i = start
            while i < end {
                info(b, i).*.mask |= mask
                i += 1
            }
        } else {
            const cluster = infosFindMinCluster(b, b.*.info, start, end, 0xFFFFFFFF)
            infosSetGlyphFlags(b, b.*.info, start, end, cluster, mask)
        }
    } else {
        if !interior {
            var i = start
            while i < b.*.outLen {
                outInfo(b, i).*.mask |= mask
                i += 1
            }
            i = b.*.idx
            while i < end {
                info(b, i).*.mask |= mask
                i += 1
            }
        } else {
            var cluster = infosFindMinCluster(b, b.*.info, b.*.idx, end, 0xFFFFFFFF)
            cluster = infosFindMinCluster(b, b.*.outInfo, start, b.*.outLen, cluster)
            infosSetGlyphFlags(b, b.*.outInfo, start, b.*.outLen, cluster, mask)
            infosSetGlyphFlags(b, b.*.info, b.*.idx, end, cluster, mask)
        }
    }
}

pub fn unsafeToBreak(b: *Buffer, start: u32, end: u32) -> void { setGlyphFlags(b, GLYPH_FLAG_UNSAFE_TO_BREAK | GLYPH_FLAG_UNSAFE_TO_CONCAT, start, end, true, false) }
pub fn unsafeToBreakAll(b: *Buffer) -> void { unsafeToBreak(b, 0, 0xFFFFFFFF) }

pub fn safeToInsertTatweel(b: *Buffer, start: u32, end: u32) -> void {
    if (b.*.flags & FLAG_PRODUCE_SAFE_TO_INSERT_TATWEEL) == 0 {
        unsafeToBreak(b, start, end)
        return
    }
    setGlyphFlags(b, GLYPH_FLAG_SAFE_TO_INSERT_TATWEEL, start, end, true, false)
}

pub fn unsafeToConcat(b: *Buffer, start: u32, end: u32) -> void {
    if (b.*.flags & FLAG_PRODUCE_UNSAFE_TO_CONCAT) == 0 { return }
    setGlyphFlags(b, GLYPH_FLAG_UNSAFE_TO_CONCAT, start, end, false, false)
}

pub fn unsafeToBreakFromOutbuffer(b: *Buffer, start: u32, end: u32) -> void { setGlyphFlags(b, GLYPH_FLAG_UNSAFE_TO_BREAK | GLYPH_FLAG_UNSAFE_TO_CONCAT, start, end, true, true) }

pub fn unsafeToConcatFromOutbuffer(b: *Buffer, start: u32, end: u32) -> void {
    if (b.*.flags & FLAG_PRODUCE_UNSAFE_TO_CONCAT) == 0 { return }
    setGlyphFlags(b, GLYPH_FLAG_UNSAFE_TO_CONCAT, start, end, false, true)
}

// ---------------------------------------------------------------------------
// Reversing and sorting

fn swapRecords(base: usize, a: u32, c: u32) -> void {
    var t: GlyphInfo = undefined
    copyInfo(&t, infoAt(base, a))
    copyInfo(infoAt(base, a), infoAt(base, c))
    copyInfo(infoAt(base, c), &t)
}

pub fn reverseRange(b: *Buffer, start: u32, end: u32) -> void {
    if end <= start + 1 { return }
    var i = start
    var j = end - 1
    while i < j {
        swapRecords(b.*.info, i, j)
        if b.*.havePositions != 0 { swapRecords(b.*.pos, i, j) }
        i += 1
        j -= 1
    }
}

pub fn reverse(b: *Buffer) -> void { reverseRange(b, 0, b.*.len) }

pub fn reverseClusters(b: *Buffer) -> void {
    if b.*.len == 0 { return }
    var start: u32 = 0
    var i: u32 = 1
    while i < b.*.len {
        if info(b, i - 1).*.cluster != info(b, i).*.cluster {
            reverseRange(b, start, i)
            start = i
        }
        i += 1
    }
    reverseRange(b, start, i)
    reverse(b)
}

pub const CompareFunc = fn(*GlyphInfo, *GlyphInfo) -> i32

// Insertion sort of the glyphs from `start` to `end`, merging the clusters
// of what moves (hb_buffer_t::sort).
pub fn sort(b: *Buffer, start: u32, end: u32, compare: CompareFunc) -> void {
    var i = start + 1
    while i < end {
        var j = i
        while j > start && compare(info(b, j - 1), info(b, i)) > 0 { j -= 1 }
        if i != j {
            mergeClusters(b, j, i + 1)
            var t: GlyphInfo = undefined
            copyInfo(&t, info(b, i))
            m.copy(b.*.info + @intCast(usize, j + 1) * INFO_SIZE, b.*.info + @intCast(usize, j) * INFO_SIZE, @intCast(usize, i - j) * INFO_SIZE)
            copyInfo(info(b, j), &t)
        }
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Segment properties

pub fn guessSegmentProperties(b: *Buffer) -> void {
    if b.*.script == common.SCRIPT_INVALID {
        var i: u32 = 0
        while i < b.*.len {
            const s = unicode.script(b.*.unicode, info(b, i).*.codepoint)
            if s != common.SCRIPT_COMMON && s != common.SCRIPT_INHERITED && s != common.SCRIPT_UNKNOWN {
                b.*.script = s
                break
            }
            i += 1
        }
    }
    if b.*.direction == common.DIRECTION_INVALID {
        b.*.direction = common.horizontalDirection(b.*.script)
        if b.*.direction == common.DIRECTION_INVALID { b.*.direction = common.DIRECTION_LTR }
    }
    if b.*.language == 0 { b.*.language = common.languageGetDefault() }
}

export fn hb_segment_properties_equal(a: usize, c: usize) -> i32 {
    var k: usize = 0
    while k < 32 {
        if m.getWord(a + k) != m.getWord(c + k) { return 0 }
        k += 8
    }
    return 1
}

export fn hb_segment_properties_hash(p: usize) -> u32 {
    const h = (m.get32(p) *% 31 +% m.get32(p + 4)) *% 31
    return h +% @intCast(u32, m.getWord(p + 8) & 0xFFFFFFFF)
}

export fn hb_segment_properties_overlay(p: usize, src: usize) -> void {
    if p == 0 || src == 0 { return }
    if m.get32(p) == 0 { m.put32(p, m.get32(src)) }
    if m.get32(p) != m.get32(src) { return }
    if m.get32(p + 4) == 0 { m.put32(p + 4, m.get32(src + 4)) }
    if m.get32(p + 4) != m.get32(src + 4) { return }
    if m.getWord(p + 8) == 0 { m.putWord(p + 8, m.getWord(src + 8)) }
}

// ---------------------------------------------------------------------------
// The public API

var emptyBuffer: usize = 0

pub fn getEmpty() -> usize {
    var e = m.atomicLoadWord(@intFromPtr(&emptyBuffer))
    if e == 0 {
        const made = o.createInert(@sizeOf(Buffer))
        const b = buf(made)
        b.*.unicode = unicode.getEmpty()
        b.*.replacement = 0xFFFD
        b.*.shapingFailed = 1
        b.*.havePositions = 1
        if !m.swapWord(@intFromPtr(&emptyBuffer), 0, made) { m.release(made) }
        e = m.atomicLoadWord(@intFromPtr(&emptyBuffer))
    }
    return e
}

pub fn create() -> usize {
    const address = o.create(@sizeOf(Buffer))
    if address == 0 { return getEmpty() }
    const b = buf(address)
    b.*.maxLen = MAX_LEN_DEFAULT
    b.*.maxOps = MAX_OPS_DEFAULT
    b.*.unicode = unicode.getDefault()
    reset(b)
    return address
}

export fn hb_buffer_create() -> usize { return create() }

export fn hb_buffer_create_similar(src: usize) -> usize {
    const address = create()
    const b = buf(address)
    const s = buf(src)
    unicode.destroyFuncs(b.*.unicode)
    b.*.unicode = o.reference(s.*.unicode)
    b.*.flags = s.*.flags
    b.*.clusterLevel = s.*.clusterLevel
    b.*.replacement = s.*.replacement
    b.*.invisible = s.*.invisible
    b.*.notFound = s.*.notFound
    return address
}

export fn hb_buffer_reset(address: usize) -> void {
    if o.isImmutable(address) { return }
    reset(buf(address))
}

export fn hb_buffer_get_empty() -> usize { return getEmpty() }
export fn hb_buffer_reference(address: usize) -> usize { return o.reference(address) }

pub fn destroy(address: usize) -> void {
    if !o.destroy(address) { return }
    const b = buf(address)
    unicode.destroyFuncs(b.*.unicode)
    m.release(b.*.info)
    m.release(b.*.pos)
    o.callDestroy(b.*.messageDestroy, b.*.messageData)
    m.release(address)
}

export fn hb_buffer_destroy(address: usize) -> void { destroy(address) }
export fn hb_buffer_set_user_data(address: usize, key: usize, data: usize, d: usize, replace: i32) -> i32 { return if o.setUserData(address, key, data, d, replace != 0) { 1 } else { 0 } }
export fn hb_buffer_get_user_data(address: usize, key: usize) -> usize { return o.getUserData(address, key) }
export fn hb_buffer_set_content_type(address: usize, t: u32) -> void { buf(address).*.contentType = t }
export fn hb_buffer_get_content_type(address: usize) -> u32 { return buf(address).*.contentType }

export fn hb_buffer_set_unicode_funcs(address: usize, u_: usize) -> void {
    if o.isImmutable(address) { return }
    const u = if u_ == 0 { unicode.getDefault() } else { u_ }
    _ = o.reference(u)
    unicode.destroyFuncs(buf(address).*.unicode)
    buf(address).*.unicode = u
}

export fn hb_buffer_get_unicode_funcs(address: usize) -> usize { return buf(address).*.unicode }
export fn hb_buffer_set_direction(address: usize, d: u32) -> void { if !o.isImmutable(address) { buf(address).*.direction = d } }
export fn hb_buffer_get_direction(address: usize) -> u32 { return buf(address).*.direction }
export fn hb_buffer_set_script(address: usize, s: u32) -> void { if !o.isImmutable(address) { buf(address).*.script = s } }
export fn hb_buffer_get_script(address: usize) -> u32 { return buf(address).*.script }
export fn hb_buffer_set_language(address: usize, l: usize) -> void { if !o.isImmutable(address) { buf(address).*.language = l } }
export fn hb_buffer_get_language(address: usize) -> usize { return buf(address).*.language }

export fn hb_buffer_set_segment_properties(address: usize, props: usize) -> void {
    if o.isImmutable(address) { return }
    const b = buf(address)
    b.*.direction = m.get32(props)
    b.*.script = m.get32(props + 4)
    b.*.language = m.getWord(props + 8)
    b.*.reserved1 = m.getWord(props + 16)
    b.*.reserved2 = m.getWord(props + 24)
}

export fn hb_buffer_get_segment_properties(address: usize, props: usize) -> void {
    const b = buf(address)
    m.put32(props, b.*.direction)
    m.put32(props + 4, b.*.script)
    m.putWord(props + 8, b.*.language)
    m.putWord(props + 16, b.*.reserved1)
    m.putWord(props + 24, b.*.reserved2)
}

export fn hb_buffer_guess_segment_properties(address: usize) -> void { guessSegmentProperties(buf(address)) }
export fn hb_buffer_set_flags(address: usize, f: u32) -> void { if !o.isImmutable(address) { buf(address).*.flags = f } }
export fn hb_buffer_get_flags(address: usize) -> u32 { return buf(address).*.flags }
export fn hb_buffer_set_cluster_level(address: usize, l: u32) -> void { if !o.isImmutable(address) { buf(address).*.clusterLevel = l } }
export fn hb_buffer_get_cluster_level(address: usize) -> u32 { return buf(address).*.clusterLevel }
export fn hb_buffer_set_replacement_codepoint(address: usize, r: u32) -> void { if !o.isImmutable(address) { buf(address).*.replacement = r } }
export fn hb_buffer_get_replacement_codepoint(address: usize) -> u32 { return buf(address).*.replacement }
export fn hb_buffer_set_invisible_glyph(address: usize, g: u32) -> void { if !o.isImmutable(address) { buf(address).*.invisible = g } }
export fn hb_buffer_get_invisible_glyph(address: usize) -> u32 { return buf(address).*.invisible }
export fn hb_buffer_set_not_found_glyph(address: usize, g: u32) -> void { if !o.isImmutable(address) { buf(address).*.notFound = g } }
export fn hb_buffer_get_not_found_glyph(address: usize) -> u32 { return buf(address).*.notFound }
export fn hb_buffer_clear_contents(address: usize) -> void { if !o.isImmutable(address) { clear(buf(address)) } }
export fn hb_buffer_pre_allocate(address: usize, size: u32) -> i32 { return if ensure(buf(address), size) { 1 } else { 0 } }
export fn hb_buffer_allocation_successful(address: usize) -> i32 { return @intCast(i32, buf(address).*.successful) }

export fn hb_buffer_add(address: usize, codepoint: u32, cluster: u32) -> void {
    const b = buf(address)
    add(b, codepoint, cluster)
    b.*.contextLen1 = 0
}

pub fn setLength(b: *Buffer, address: usize, length: u32) -> bool {
    if o.isImmutable(address) { return length == 0 }
    if !ensure(b, length) { return false }
    if length > b.*.len {
        m.zero(b.*.info + @intCast(usize, b.*.len) * INFO_SIZE, @intCast(usize, length - b.*.len) * INFO_SIZE)
        if b.*.havePositions != 0 { m.zero(b.*.pos + @intCast(usize, b.*.len) * INFO_SIZE, @intCast(usize, length - b.*.len) * INFO_SIZE) }
    }
    b.*.len = length
    if length == 0 {
        b.*.contentType = CONTENT_INVALID
        b.*.contextLen0 = 0
    }
    b.*.contextLen1 = 0
    return true
}

export fn hb_buffer_set_length(address: usize, length: u32) -> i32 { return if setLength(buf(address), address, length) { 1 } else { 0 } }
export fn hb_buffer_get_length(address: usize) -> u32 { return buf(address).*.len }

export fn hb_buffer_get_glyph_infos(address: usize, length: usize) -> usize {
    const b = buf(address)
    if length != 0 { m.put32(length, b.*.len) }
    return b.*.info
}

export fn hb_buffer_get_glyph_positions(address: usize, length: usize) -> usize {
    const b = buf(address)
    if length != 0 { m.put32(length, b.*.len) }
    if b.*.havePositions == 0 {
        if b.*.messageDepth != 0 { return 0 }
        clearPositions(b)
    }
    return b.*.pos
}

export fn hb_buffer_has_positions(address: usize) -> i32 { return @intCast(i32, buf(address).*.havePositions) }
export fn hb_glyph_info_get_glyph_flags(g: usize) -> u32 { return m.get32(g + 4) & GLYPH_FLAG_DEFINED }
export fn hb_buffer_reverse(address: usize) -> void { reverse(buf(address)) }
export fn hb_buffer_reverse_range(address: usize, start: u32, end: u32) -> void { reverseRange(buf(address), start, end) }
export fn hb_buffer_reverse_clusters(address: usize) -> void { reverseClusters(buf(address)) }

// ---------------------------------------------------------------------------
// Adding text: UTF-8, UTF-16, UTF-32, Latin-1, codepoints (the encodings
// read as hb-utf.hh reads them: one replacement character for each byte
// of an ill-formed sequence), with the context around the item.

const ENC_UTF8: u32 = 0
const ENC_UTF16: u32 = 1
const ENC_UTF32: u32 = 2
const ENC_LATIN1: u32 = 3
const ENC_CODEPOINTS: u32 = 4

fn unitSize(enc: u32) -> usize {
    if enc == ENC_UTF8 || enc == ENC_LATIN1 { return 1 }
    if enc == ENC_UTF16 { return 2 }
    return 4
}

fn unitAt(text: usize, enc: u32, i: usize) -> u32 {
    if enc == ENC_UTF8 || enc == ENC_LATIN1 { return @intCast(u32, m.get8(text + i)) }
    if enc == ENC_UTF16 { return @intCast(u32, m.get16(text + i * 2)) }
    return m.get32(text + i * 4)
}

// The character at unit `i` (before `end`): its value and the index after.
fn nextChar(text: usize, enc: u32, i: usize, end: usize, replacement: u32, out: *u32) -> usize {
    var c = unitAt(text, enc, i)
    var j = i + 1
    if enc == ENC_LATIN1 || enc == ENC_CODEPOINTS {
        out.* = c
        return j
    }
    if enc == ENC_UTF32 {
        out.* = if c >= 0xD800 && (c <= 0xDFFF || c > 0x10FFFF) { replacement } else { c }
        return j
    }
    if enc == ENC_UTF16 {
        if c < 0xD800 || c > 0xDFFF {
            out.* = c
            return j
        }
        if c <= 0xDBFF && j < end {
            const l = unitAt(text, enc, j)
            if l >= 0xDC00 && l <= 0xDFFF {
                out.* = ((c - 0xD800) << 10) + (l - 0xDC00) + 0x10000
                return j + 1
            }
        }
        out.* = replacement
        return j
    }
    // UTF-8
    if c > 0x7F {
        if c >= 0xC2 && c <= 0xDF {
            if j < end && unitAt(text, enc, j) -% 0x80 <= 0x3F {
                c = ((c & 0x1F) << 6) | (unitAt(text, enc, j) - 0x80)
                j += 1
            } else {
                out.* = replacement
                return j
            }
        } else if c >= 0xE0 && c <= 0xEF {
            if end - j > 1 && unitAt(text, enc, j) -% 0x80 <= 0x3F && unitAt(text, enc, j + 1) -% 0x80 <= 0x3F {
                c = ((c & 0xF) << 12) | ((unitAt(text, enc, j) - 0x80) << 6) | (unitAt(text, enc, j + 1) - 0x80)
                if c < 0x800 || (c >= 0xD800 && c <= 0xDFFF) {
                    out.* = replacement
                    return j
                }
                j += 2
            } else {
                out.* = replacement
                return j
            }
        } else if c >= 0xF0 && c <= 0xF4 {
            if end - j > 2 && unitAt(text, enc, j) -% 0x80 <= 0x3F && unitAt(text, enc, j + 1) -% 0x80 <= 0x3F && unitAt(text, enc, j + 2) -% 0x80 <= 0x3F {
                c = ((c & 0x7) << 18) | ((unitAt(text, enc, j) - 0x80) << 12) | ((unitAt(text, enc, j + 1) - 0x80) << 6) | (unitAt(text, enc, j + 2) - 0x80)
                if c < 0x10000 || c > 0x10FFFF {
                    out.* = replacement
                    return j
                }
                j += 3
            } else {
                out.* = replacement
                return j
            }
        } else {
            out.* = replacement
            return j
        }
    }
    out.* = c
    return j
}

// The character before unit `i` (after `start`): its value and its index.
fn prevChar(text: usize, enc: u32, i: usize, start: usize, replacement: u32, out: *u32) -> usize {
    if enc == ENC_UTF8 {
        const end = i
        var t = i - 1
        while start < t && (unitAt(text, enc, t) & 0xC0) == 0x80 && end - t < 4 { t -= 1 }
        if nextChar(text, enc, t, end, replacement, out) == end { return t }
        out.* = replacement
        return end - 1
    }
    if enc == ENC_UTF16 {
        const c = unitAt(text, enc, i - 1)
        if c < 0xD800 || c > 0xDFFF {
            out.* = c
            return i - 1
        }
        if c >= 0xDC00 && start < i - 1 {
            const h = unitAt(text, enc, i - 2)
            if h >= 0xD800 && h <= 0xDBFF {
                out.* = ((h - 0xD800) << 10) + (c - 0xDC00) + 0x10000
                return i - 2
            }
        }
        out.* = replacement
        return i - 1
    }
    const c = unitAt(text, enc, i - 1)
    if enc == ENC_UTF32 && c >= 0xD800 && (c <= 0xDFFF || c > 0x10FFFF) {
        out.* = replacement
    } else {
        out.* = c
    }
    return i - 1
}

fn addText(address: usize, text: usize, textLength_: i32, itemOffset: u32, itemLength_: i32, enc: u32) -> void {
    const b = buf(address)
    if o.isImmutable(address) { return }
    var textLength = textLength_
    if textLength == -1 {
        var n: i32 = 0
        while unitAt(text, enc, @intCast(usize, n)) != 0 { n += 1 }
        textLength = n
    }
    var itemLength = itemLength_
    if itemLength == -1 { itemLength = textLength - @intCast(i32, itemOffset) }
    if itemLength < 0 || itemLength > 0x7FFFFFFF / 8 { return }
    if !ensure(b, b.*.len + @intCast(u32, @intCast(usize, itemLength) * unitSize(enc) / 4)) { return }
    const replacement = b.*.replacement
    if b.*.len == 0 && itemOffset > 0 {
        b.*.contextLen0 = 0
        var p = @intCast(usize, itemOffset)
        while 0 < p && b.*.contextLen0 < 5 {
            var u: u32 = 0
            p = prevChar(text, enc, p, 0, replacement, &u)
            b.*.context[@intCast(usize, b.*.contextLen0)] = u
            b.*.contextLen0 += 1
        }
    }
    var next = @intCast(usize, itemOffset)
    const end = next + @intCast(usize, itemLength)
    while next < end {
        var u: u32 = 0
        const old = next
        next = nextChar(text, enc, next, end, replacement, &u)
        add(b, u, @intCast(u32, old))
    }
    b.*.contextLen1 = 0
    const textEnd = @intCast(usize, textLength)
    while next < textEnd && b.*.contextLen1 < 5 {
        var u: u32 = 0
        next = nextChar(text, enc, next, textEnd, replacement, &u)
        b.*.context[5 + @intCast(usize, b.*.contextLen1)] = u
        b.*.contextLen1 += 1
    }
    b.*.contentType = CONTENT_UNICODE
}

export fn hb_buffer_add_utf8(address: usize, text: usize, textLength: i32, itemOffset: u32, itemLength: i32) -> void { addText(address, text, textLength, itemOffset, itemLength, ENC_UTF8) }
export fn hb_buffer_add_utf16(address: usize, text: usize, textLength: i32, itemOffset: u32, itemLength: i32) -> void { addText(address, text, textLength, itemOffset, itemLength, ENC_UTF16) }
export fn hb_buffer_add_utf32(address: usize, text: usize, textLength: i32, itemOffset: u32, itemLength: i32) -> void { addText(address, text, textLength, itemOffset, itemLength, ENC_UTF32) }
export fn hb_buffer_add_latin1(address: usize, text: usize, textLength: i32, itemOffset: u32, itemLength: i32) -> void { addText(address, text, textLength, itemOffset, itemLength, ENC_LATIN1) }
export fn hb_buffer_add_codepoints(address: usize, text: usize, textLength: i32, itemOffset: u32, itemLength: i32) -> void { addText(address, text, textLength, itemOffset, itemLength, ENC_CODEPOINTS) }

export fn hb_buffer_append(address: usize, source: usize, start_: u32, end_: u32) -> void {
    const b = buf(address)
    const s = buf(source)
    var start = start_
    var end = end_
    if end > s.*.len { end = s.*.len }
    if start > end { start = end }
    if start == end { return }
    if b.*.len + (end - start) < b.*.len {
        b.*.successful = 0
        return
    }
    const origLen = b.*.len
    _ = setLength(b, address, b.*.len + (end - start))
    if b.*.successful == 0 { return }
    if origLen == 0 { b.*.contentType = s.*.contentType }
    if b.*.havePositions == 0 && s.*.havePositions != 0 { clearPositions(b) }
    hb_segment_properties_overlay(address + @offsetOf(Buffer, "direction"), source + @offsetOf(Buffer, "direction"))
    m.copy(b.*.info + @intCast(usize, origLen) * INFO_SIZE, s.*.info + @intCast(usize, start) * INFO_SIZE, @intCast(usize, end - start) * INFO_SIZE)
    if b.*.havePositions != 0 { m.copy(b.*.pos + @intCast(usize, origLen) * INFO_SIZE, s.*.pos + @intCast(usize, start) * INFO_SIZE, @intCast(usize, end - start) * INFO_SIZE) }
    if s.*.contentType == CONTENT_UNICODE {
        if origLen == 0 && start + s.*.contextLen0 > 0 {
            b.*.contextLen0 = 0
            while start > 0 && b.*.contextLen0 < 5 {
                start -= 1
                b.*.context[@intCast(usize, b.*.contextLen0)] = info(s, start).*.codepoint
                b.*.contextLen0 += 1
            }
            var i: u32 = 0
            while i < s.*.contextLen0 && b.*.contextLen0 < 5 {
                b.*.context[@intCast(usize, b.*.contextLen0)] = s.*.context[@intCast(usize, i)]
                b.*.contextLen0 += 1
                i += 1
            }
        }
        b.*.contextLen1 = 0
        while end < s.*.len && b.*.contextLen1 < 5 {
            b.*.context[5 + @intCast(usize, b.*.contextLen1)] = info(s, end).*.codepoint
            b.*.contextLen1 += 1
            end += 1
        }
        var i: u32 = 0
        while i < s.*.contextLen1 && b.*.contextLen1 < 5 {
            b.*.context[5 + @intCast(usize, b.*.contextLen1)] = s.*.context[5 + @intCast(usize, i)]
            b.*.contextLen1 += 1
            i += 1
        }
    }
}

// Glyphs of a cluster with their advances moved to the cluster's first
// (or last, backward) glyph and the rest as offsets, the marks sorted.
export fn hb_buffer_normalize_glyphs(address: usize) -> void {
    const b = buf(address)
    const backward = common.isBackward(b.*.direction)
    var start: u32 = 0
    while start < b.*.len {
        var end = start + 1
        while end < b.*.len && info(b, end).*.cluster == info(b, start).*.cluster { end += 1 }
        normalizeCluster(b, start, end, backward)
        start = end
    }
}

fn normalizeCluster(b: *Buffer, start: u32, end: u32, backward: bool) -> void {
    var tx: i32 = 0
    var ty: i32 = 0
    var i = start
    while i < end {
        tx +%= pos(b, i).*.xAdvance
        ty +%= pos(b, i).*.yAdvance
        i += 1
    }
    var xa: i32 = 0
    var ya: i32 = 0
    i = start
    while i < end {
        const p = pos(b, i)
        p.*.xOffset +%= xa
        p.*.yOffset +%= ya
        xa +%= p.*.xAdvance
        ya +%= p.*.yAdvance
        p.*.xAdvance = 0
        p.*.yAdvance = 0
        i += 1
    }
    if backward {
        pos(b, end - 1).*.xAdvance = tx
        pos(b, end - 1).*.yAdvance = ty
        stableSortByCodepoint(b, start, end - 1)
    } else {
        pos(b, start).*.xAdvance +%= tx
        pos(b, start).*.yAdvance +%= ty
        i = start + 1
        while i < end {
            pos(b, i).*.xOffset -%= tx
            pos(b, i).*.yOffset -%= ty
            i += 1
        }
        stableSortByCodepoint(b, start + 1, end)
    }
}

// (Descending codepoints, as hb_buffer_normalize_glyphs's comparison
// orders them; positions moved with their glyphs.)
fn stableSortByCodepoint(b: *Buffer, start: u32, end: u32) -> void {
    var i = start + 1
    while i < end {
        var j = i
        while j > start && @intCast(i64, info(b, i).*.codepoint) - @intCast(i64, info(b, j - 1).*.codepoint) > 0 { j -= 1 }
        if j != i {
            var t: GlyphInfo = undefined
            var tp: GlyphInfo = undefined
            copyInfo(&t, info(b, i))
            copyInfo(&tp, infoAt(b.*.pos, i))
            m.copy(b.*.info + @intCast(usize, j + 1) * INFO_SIZE, b.*.info + @intCast(usize, j) * INFO_SIZE, @intCast(usize, i - j) * INFO_SIZE)
            m.copy(b.*.pos + @intCast(usize, j + 1) * INFO_SIZE, b.*.pos + @intCast(usize, j) * INFO_SIZE, @intCast(usize, i - j) * INFO_SIZE)
            copyInfo(info(b, j), &t)
            copyInfo(infoAt(b.*.pos, j), &tp)
        }
        i += 1
    }
}

export fn hb_buffer_diff(address: usize, reference: usize, dottedCircle: u32, fuzz: u32) -> u32 {
    const b = buf(address)
    const r = buf(reference)
    if b.*.contentType != r.*.contentType && b.*.len != 0 && r.*.len != 0 { return 1 }
    var result: u32 = 0
    const contains = dottedCircle != 0xFFFFFFFF
    const count = r.*.len
    if b.*.len != count {
        var i: u32 = 0
        while i < count {
            if contains && info(r, i).*.codepoint == dottedCircle { result |= 8 }
            if contains && info(r, i).*.codepoint == 0 { result |= 4 }
            i += 1
        }
        return result | 2
    }
    if count == 0 { return result }
    var i: u32 = 0
    while i < count {
        const x = info(b, i)
        const y = info(r, i)
        if x.*.codepoint != y.*.codepoint { result |= 16 }
        if x.*.cluster != y.*.cluster { result |= 32 }
        if ((x.*.mask ^ y.*.mask) & GLYPH_FLAG_DEFINED) != 0 { result |= 64 }
        if contains && y.*.codepoint == dottedCircle { result |= 8 }
        if contains && y.*.codepoint == 0 { result |= 4 }
        i += 1
    }
    if b.*.contentType == CONTENT_GLYPHS {
        i = 0
        while i < count {
            const p = pos(b, i)
            const q = pos(r, i)
            if absDiff(p.*.xAdvance, q.*.xAdvance) > fuzz || absDiff(p.*.yAdvance, q.*.yAdvance) > fuzz || absDiff(p.*.xOffset, q.*.xOffset) > fuzz || absDiff(p.*.yOffset, q.*.yOffset) > fuzz {
                result |= 128
                break
            }
            i += 1
        }
    }
    return result
}

fn absDiff(a: i32, c: i32) -> u32 {
    const d = @intCast(i64, a) - @intCast(i64, c)
    return @intCast(u32, (if d < 0 { 0 - d } else { d }) & 0xFFFFFFFF)
}

// Messages: the program's function, called with a text (none are sent by
// this library but the ones it must: the shaper tells nothing).
export fn hb_buffer_set_message_func(address: usize, func: usize, data: usize, destroy_: usize) -> void {
    if o.isImmutable(address) {
        o.callDestroy(destroy_, data)
        return
    }
    const b = buf(address)
    o.callDestroy(b.*.messageDestroy, b.*.messageData)
    if func != 0 {
        b.*.messageFunc = func
        b.*.messageData = data
        b.*.messageDestroy = destroy_
    } else {
        b.*.messageFunc = 0
        b.*.messageData = 0
        b.*.messageDestroy = 0
    }
}
