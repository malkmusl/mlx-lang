// The backdrop: the night behind the picture, drawn once (gradient, bokeh,
// stars, faint constellations); and, once the dial and the letters' glow
// have come in, those drawn into it too (they stand still), so a frame
// draws only what moves.
const std = @import("std")
const paint = @import("./paint.mlx")
const math = @import("std.math")
const state = @import("./state.mlx")
const logo_module = @import("./logo.mlx")
const orbits = @import("./orbits.mlx")

const Scene = state.Scene
const Surface = state.Surface

// The night: indigo at the middle to near black at the edges (by the
// squared distance, through a table, so no square root per pixel), dithered
// so its dark steps do not band; bokeh, stars and faint constellations
// over it.
pub fn draw(scene: *Scene, random: *paint.Random) -> void {
    var shades: [1024]u32 = undefined
    const centre = paint.rgb(34, 28, 78)
    const middle = paint.rgb(15, 14, 40)
    const edge = paint.rgb(4, 5, 13)
    var index: usize = 0
    while index < 1024 {
        const d = math.sqrt(paint.toFloat(index) / 1023.0)
        shades[index] = if d < 0.45 { paint.mix(centre, middle, math.smoothstep(0.0, 0.45, d)) } else { paint.mix(middle, edge, math.smoothstep(0.45, 1.0, d)) }
        index += 1
    }
    const bayer = [16]u32{ 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 }
    const unit = scene.*.unit
    const reach_x = 9.5 * unit
    const reach_y = 6.8 * unit
    var row: usize = 0
    while row < scene.*.height {
        const dy = (paint.toFloat(row) - scene.*.cy) / reach_y
        var column: usize = 0
        while column < scene.*.width {
            const dx = (paint.toFloat(column) - scene.*.cx) / reach_x
            var d2 = dx * dx + dy * dy
            if d2 > 1.0 { d2 = 1.0 }
            const shade = shades[@intCast(usize, paint.toInt(d2 * 1023.0))]
            // A dither of up to one step, the same pattern every 4 pixels.
            const offset = bayer[(row & 3) * 4 + (column & 3)]
            var red = (shade >> 16) & 255
            var green = (shade >> 8) & 255
            var blue = shade & 255
            if offset > 9 { red += 1 }
            if offset > 7 { blue += 1 }
            if offset > 11 { green += 1 }
            scene.*.backdrop.pixels[row * scene.*.width + column] = paint.rgb(red, green, blue)
            column += 1
        }
        row += 1
    }

    // Bokeh: wide soft discs of far lights.
    var disc: usize = 0
    while disc < 11 {
        const x = paint.unit(random) * paint.toFloat(scene.*.width)
        const y = paint.unit(random) * paint.toFloat(scene.*.height)
        const radius = unit * (0.12 + paint.unit(random) * 0.45)
        const colour = if paint.unit(random) < 0.5 { paint.rgb(70, 84, 170) } else { paint.rgb(104, 72, 176) }
        softDisc(&scene.*.backdrop, x, y, radius, colour, 0.06 + paint.unit(random) * 0.1)
        disc += 1
    }
    // Stars, most of them dim.
    var star: usize = 0
    while star < state.STAR_COUNT {
        const x = paint.unit(random) * paint.toFloat(scene.*.width)
        const y = paint.unit(random) * paint.toFloat(scene.*.height)
        const u = paint.unit(random)
        const brightness = 0.12 + u * u * u * 0.85
        const colour = paint.mix(paint.rgb(150, 170, 255), paint.rgb(235, 235, 255), paint.unit(random))
        paint.spark(&scene.*.backdrop, x, y, colour, brightness)
        if brightness > 0.7 { paint.glow(&scene.*.backdrop, &scene.*.dust, x, y, colour, 0.25) }
        star += 1
    }
    // Faint constellations at the sides, the code graph seen from far off.
    var cluster: usize = 0
    while cluster < 4 {
        const side = if cluster % 2 == 0 { -1.0 } else { 1.0 }
        const cluster_x = scene.*.cx + side * unit * (6.6 + paint.unit(random) * 1.0)
        const cluster_y = scene.*.cy + unit * (if cluster < 2 { -2.9 } else { 2.4 }) + paint.unit(random) * unit * 0.6
        constellation(scene, random, cluster_x, cluster_y)
        cluster += 1
    }
}

fn softDisc(surface: *Surface, x: f64, y: f64, radius: f64, colour: u32, strength: f64) -> void {
    const top = paint.toInt(y - radius)
    const bottom = paint.toInt(y + radius) + 1
    const left = paint.toInt(x - radius)
    const right = paint.toInt(x + radius) + 1
    var row = top
    while row <= bottom {
        var column = left
        while column <= right {
            const dx = paint.signedFloat(column) + 0.5 - x
            const dy = paint.signedFloat(row) + 0.5 - y
            const d = math.sqrt(dx * dx + dy * dy) / radius
            if d < 1.0 { paint.add(surface, column, row, paint.dim(colour, strength * (1.0 - math.smoothstep(0.25, 1.0, d)))) }
            column += 1
        }
        row += 1
    }
}

fn constellation(scene: *Scene, random: *paint.Random, x: f64, y: f64) -> void {
    const unit = scene.*.unit
    var xs: [5]f64 = undefined
    var ys: [5]f64 = undefined
    var index: usize = 0
    while index < 5 {
        xs[index] = x + (paint.unit(random) - 0.5) * unit * 2.4
        ys[index] = y + (paint.unit(random) - 0.5) * unit * 1.6
        index += 1
    }
    index = 0
    while index < 5 {
        var other = index + 1
        while other < 5 {
            const dx = xs[index] - xs[other]
            const dy = ys[index] - ys[other]
            if dx * dx + dy * dy < unit * unit * 1.6 {
                paint.line(&scene.*.backdrop, xs[index], ys[index], xs[other], ys[other], paint.rgb(90, 120, 210), 0.22)
            }
            other += 1
        }
        paint.glow(&scene.*.backdrop, &scene.*.dust, xs[index], ys[index], paint.rgb(110, 140, 230), 0.35)
        index += 1
    }
}

// The still parts into the backdrop, within the region: the letters'
// glow and the dial. Their light is added, and light adds up the same in
// any order, so the picture is the same as drawing them each frame.
pub fn bake(scene: *Scene) -> void {
    const frame = &scene.*.frame
    const backdrop = &scene.*.backdrop
    backdrop.*.clipLeft = frame.*.clipLeft
    backdrop.*.clipTop = frame.*.clipTop
    backdrop.*.clipRight = frame.*.clipRight
    backdrop.*.clipBottom = frame.*.clipBottom
    logo_module.addGlow(backdrop, &scene.*.logo, scene.*.logoX, scene.*.logoY, logoLight(1.0))
    orbits.dialStill(scene, backdrop, 1.0)
    paint.clipAll(backdrop)
    scene.*.baked = true
    scene.*.restoreAll = true
}

// The violet light of the letters' glow as they come in (0-1).
pub fn logoLight(shown: f64) -> u32 { return paint.lightOf(paint.rgb(132, 96, 255), 0.55 * shown) }
