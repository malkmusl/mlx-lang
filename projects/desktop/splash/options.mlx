// mlx-splash's command line. Without --png, --frames or --bench it is the
// boot splash daemon; the plymouthd options systemd's units pass are not
// needed, as our own units start it.
const std = @import("std")
const paint = @import("./paint.mlx")
const state = @import("./state.mlx")
const protocol = @import("./protocol.mlx")
const system = @import("./system.mlx")

pub const OutputChoice = enum(u8) {
    automatic,
    kms,
    fbdev,
    none
}

pub const Options = struct {
    width: usize
    height: usize
    mode: state.Mode
    // Pictures instead of a screen.
    png: [*]const u8
    hasPng: bool
    framesDirectory: []const u8
    hasFrames: bool
    count: usize
    fps: usize
    bench: usize
    at: f64
    progress: f64
    status: []const u8
    hasStatus: bool
    message: []const u8
    // --frames: a whole boot as a script plays it (units starting, the bar
    // filling, the splash quitting) instead of a moment held.
    story: bool
    // Threads drawing a frame (0: one for each processor).
    threads: usize
    // The daemon.
    output: OutputChoice
    // A card's path, or a descriptor already open on one (tests hand in
    // an emulated card so).
    cardPath: [*]const u8
    hasCardPath: bool
    cardDescriptor: isize
    framebufferPath: [*]const u8
    terminalPath: [*]const u8
    useTerminal: bool
    socketName: []const u8
    durationPath: [*]const u8
    askDirectory: [*]const u8
    pidPath: [*]const u8
    hasPidPath: bool
    snapshotPath: [*]const u8
    hasSnapshot: bool
}

pub fn parseNumber(text: []const u8, value: *usize) -> bool {
    if text.length == 0 || text.length > 18 { return false }
    var result: usize = 0
    for byte in text {
        if byte < 48 || byte > 57 { return false }
        result = result * 10 + @intCast(usize, byte - 48)
    }
    value.* = result
    return true
}

// A decimal such as 2.5 (no sign, no exponent); trailing spaces and a
// newline are allowed (as a file holds it).
pub fn parseDecimal(text: []const u8, value: *f64) -> bool {
    if text.length == 0 { return false }
    var result: f64 = 0.0
    var scale: f64 = 0.0
    var digits: usize = 0
    for byte in text {
        if byte == 46 && scale == 0.0 {
            scale = 1.0
        } else if byte >= 48 && byte <= 57 {
            const digit = paint.toFloat(@intCast(usize, byte - 48))
            if scale == 0.0 {
                result = result * 10.0 + digit
            } else {
                scale = scale / 10.0
                result += digit * scale
            }
            digits += 1
        } else if byte != 10 && byte != 32 {
            return false
        }
    }
    value.* = result
    return digits > 0
}

fn named(option: std.string.String, name: []const u8) -> bool {
    return std.text.same(std.string.asSlice(option), name)
}

fn parseSize(text: []const u8, options: *Options) -> bool {
    var split: usize = 0
    while split < text.length && text[split] != 120 { split += 1 }
    if split == 0 || split + 1 >= text.length { return false }
    var width: usize = 0
    var height: usize = 0
    if !parseNumber(text[0..split], &width) || !parseNumber(text[split + 1..text.length], &height) { return false }
    if width < 160 || height < 120 || width > 8192 || height > 8192 { return false }
    options.*.width = width
    options.*.height = height
    return true
}

// A mode's name as mlx-splash and plymouth's change-mode give it.
pub fn parseMode(text: []const u8, mode: *state.Mode) -> bool {
    if std.text.same(text, "boot") || std.text.same(text, "boot-up") {
        mode.* = state.Mode.boot
    } else if std.text.same(text, "shutdown") {
        mode.* = state.Mode.shutdown
    } else if std.text.same(text, "reboot") {
        mode.* = state.Mode.reboot
    } else if std.text.same(text, "updates") || std.text.same(text, "system-upgrade") || std.text.same(text, "application-upgrade") || std.text.same(text, "firmware-upgrade") {
        mode.* = state.Mode.updates
    } else {
        return false
    }
    return true
}

fn parseOutput(text: []const u8, choice: *OutputChoice) -> bool {
    if std.text.same(text, "auto") { choice.* = OutputChoice.automatic } else if std.text.same(text, "kms") { choice.* = OutputChoice.kms } else if std.text.same(text, "fbdev") { choice.* = OutputChoice.fbdev } else if std.text.same(text, "none") { choice.* = OutputChoice.none } else { return false }
    return true
}

pub fn usage() -> void {
    const ignored = std.io.writeAll(std.io.stdout(), "usage: mlx-splash [--mode boot|shutdown|reboot|updates] [--output auto|kms|fbdev|none]\n                  [--card PATH | --card-fd N] [--framebuffer PATH] [--tty PATH | --no-tty]\n                  [--socket NAME] [--duration-file PATH] [--ask-password-dir PATH]\n                  [--pid-file PATH] [--snapshot PNG] [--size WxH] [--fps N]\n                  [--threads N]\n       mlx-splash [--size WxH] [--mode MODE] [--status TEXT] [--message TEXT] [--progress PERCENT]\n                  [--threads N] (--png FILE [--at SECONDS] | --frames DIR [--count N] [--fps N] [--story]\n                  | --bench N)\n")
}

// 0 when the options are fine, 1 after --help, else the exit code.
pub fn parse(arguments: [][*]const u8, options: *Options) -> u8 {
    options.*.width = 1920
    options.*.height = 1080
    options.*.mode = state.Mode.boot
    options.*.hasPng = false
    options.*.hasFrames = false
    options.*.count = 90
    options.*.fps = 60
    options.*.bench = 0
    options.*.at = 3.0
    options.*.progress = 0.35
    options.*.hasStatus = false
    options.*.status = ""
    options.*.message = ""
    options.*.story = false
    options.*.threads = 0
    options.*.framesDirectory = ""
    options.*.output = OutputChoice.automatic
    options.*.hasCardPath = false
    options.*.cardDescriptor = -1
    options.*.useTerminal = true
    options.*.socketName = protocol.SOCKET_NAME
    options.*.hasPidPath = false
    options.*.hasSnapshot = false
    unsafe {
        options.*.framebufferPath = @ptrCast([*]const u8, "/dev/fb0")
        options.*.terminalPath = @ptrCast([*]const u8, "/dev/tty1")
        options.*.durationPath = @ptrCast([*]const u8, "/var/lib/mlx/splash/boot-duration")
        options.*.askDirectory = @ptrCast([*]const u8, "/run/systemd/ask-password")
    }
    const count = arguments.length
    var index: usize = 1
    while index < count {
        const option = std.process.argument(arguments, index)
        const has_value = index + 1 < count
        var value: []const u8 = ""
        var pointer: [*]const u8 = undefined
        if has_value {
            value = std.string.asSlice(std.process.argument(arguments, index + 1))
            pointer = std.process.argument(arguments, index + 1).pointer
        }
        var step: usize = 2
        if named(option, "--help") {
            usage()
            return 1
        } else if named(option, "--no-tty") {
            options.*.useTerminal = false
            step = 1
        } else if named(option, "--story") {
            options.*.story = true
            step = 1
        } else if !has_value {
            usage()
            return 2
        } else if named(option, "--size") {
            if !parseSize(value, options) {
                system.say("--size wants WIDTHxHEIGHT (160x120 to 8192x8192)")
                return 2
            }
        } else if named(option, "--mode") {
            if !parseMode(value, &options.*.mode) {
                system.say("--mode wants boot, shutdown, reboot or updates")
                return 2
            }
        } else if named(option, "--output") {
            if !parseOutput(value, &options.*.output) {
                system.say("--output wants auto, kms, fbdev or none")
                return 2
            }
        } else if named(option, "--card") {
            options.*.cardPath = pointer
            options.*.hasCardPath = true
        } else if named(option, "--card-fd") {
            var number: usize = 0
            if !parseNumber(value, &number) || number > 65535 {
                system.say("--card-fd wants a descriptor number")
                return 2
            }
            options.*.cardDescriptor = @intCast(isize, number)
        } else if named(option, "--framebuffer") {
            options.*.framebufferPath = pointer
        } else if named(option, "--tty") {
            options.*.terminalPath = pointer
        } else if named(option, "--socket") {
            options.*.socketName = value
        } else if named(option, "--duration-file") {
            options.*.durationPath = pointer
        } else if named(option, "--ask-password-dir") {
            options.*.askDirectory = pointer
        } else if named(option, "--pid-file") {
            options.*.pidPath = pointer
            options.*.hasPidPath = true
        } else if named(option, "--snapshot") {
            options.*.snapshotPath = pointer
            options.*.hasSnapshot = true
        } else if named(option, "--png") {
            options.*.png = pointer
            options.*.hasPng = true
        } else if named(option, "--at") {
            if !parseDecimal(value, &options.*.at) {
                system.say("--at wants seconds (such as 2.5)")
                return 2
            }
        } else if named(option, "--frames") {
            options.*.framesDirectory = value
            options.*.hasFrames = true
        } else if named(option, "--count") {
            if !parseNumber(value, &options.*.count) || options.*.count == 0 {
                system.say("--count wants a number of frames")
                return 2
            }
        } else if named(option, "--fps") {
            if !parseNumber(value, &options.*.fps) || options.*.fps == 0 || options.*.fps > 240 {
                system.say("--fps wants 1 to 240")
                return 2
            }
        } else if named(option, "--threads") {
            if !parseNumber(value, &options.*.threads) || options.*.threads > 8 {
                system.say("--threads wants 1 to 8 (0: one for each processor)")
                return 2
            }
        } else if named(option, "--bench") {
            if !parseNumber(value, &options.*.bench) || options.*.bench == 0 {
                system.say("--bench wants a number of frames")
                return 2
            }
        } else if named(option, "--progress") {
            var percent: f64 = 0.0
            if !parseDecimal(value, &percent) || percent > 100.0 {
                system.say("--progress wants 0 to 100")
                return 2
            }
            options.*.progress = percent / 100.0
        } else if named(option, "--status") {
            options.*.status = value
            options.*.hasStatus = true
        } else if named(option, "--message") {
            options.*.message = value
        } else {
            usage()
            return 2
        }
        index += step
    }
    return 0
}

// Whether the options ask for pictures rather than the daemon.
pub fn isPreview(options: *const Options) -> bool {
    return options.*.hasPng || options.*.hasFrames || options.*.bench > 0
}
