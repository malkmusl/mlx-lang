// The splash's picture as data: its rings, nodes and particles, the
// backdrop and the frame, what it says. The modules drawing it (backdrop,
// orbits, status) and scene.mlx, which runs a frame, share it from here.
//
// Everything is measured in `unit`, a sixteenth of the widest 16:9 box the
// screen holds, so the picture keeps its proportions at any resolution.
const std = @import("std")
const ui_text = @import("std.ui.text")
const canvas_module = @import("std.ui.canvas")
const paint = @import("./paint.mlx")
const logo_module = @import("./logo.mlx")

pub const Allocator = std.allocator.Allocator
pub const Surface = paint.Surface

pub const RING_COUNT: usize = 3
pub const NODE_COUNT: usize = 6
pub const DUST_COUNT: usize = 90
pub const TWINKLE_COUNT: usize = 48
pub const STAR_COUNT: usize = 460
// Glints riding the rings.
pub const SPARKLE_COUNT: usize = 96
// When the rings, the dial and the letters' glow have all come in (s):
// from then on they stand still and are drawn into the backdrop once.
pub const BAKE_TIME: f64 = 1.75

pub const Mode = enum(u8) {
    boot,
    shutdown,
    reboot,
    updates
}

pub const Ring = struct {
    radius: f64
    // The ring's plane: how far it leans away from the screen's (tilt) and
    // the angle of its long axis on the screen (roll), as cosines and sines.
    tiltCos: f64
    tiltSin: f64
    rollCos: f64
    rollSin: f64
    colour: u32
    // The bright arc running round it: radians per second and where it
    // starts.
    headSpeed: f64
    headOffset: f64
}

pub const Node = struct {
    ring: usize
    // Where on its ring it starts and how fast it goes (radians/s).
    offset: f64
    speed: f64
    colour: u32
    // Its satellite's angle around it and distance (units).
    satelliteAngle: f64
    satelliteDistance: f64
    // Where it was drawn this frame.
    x: f64
    y: f64
    z: f64
}

pub const Scene = struct {
    tables: paint.Tables
    width: usize
    height: usize
    unit: f64
    // The middle of the rings and the letters.
    cx: f64
    cy: f64
    backdrop: Surface
    frame: Surface
    // The part of the screen the animation draws on.
    regionX: usize
    regionY: usize
    regionWidth: usize
    regionHeight: usize
    halo: paint.Sprite
    nodeHalo: paint.Sprite
    nodeCore: paint.Sprite
    dust: paint.Sprite
    logo: logo_module.Logo
    logoX: i64
    logoY: i64
    rings: [3]Ring
    nodes: [6]Node
    dustAngle: [90]f64
    dustRadius: [90]f64
    dustSpeed: [90]f64
    dustBright: [90]f64
    twinkleX: [48]f64
    twinkleY: [48]f64
    twinklePhase: [48]f64
    sparkleRing: [96]usize
    sparkleAngle: [96]f64
    sparkleSpeed: [96]f64
    sparkleLift: [96]f64
    sparklePhase: [96]f64
    text: ui_text.Text
    small: ui_text.Text
    status: [200]u8
    statusLength: usize
    message: [200]u8
    messageLength: usize
    // Shown progress follows `progress` smoothly (0-1); off in shutdown.
    progress: f64
    shownProgress: f64
    showProgress: bool
    mode: Mode
    // The progress bar: where it is, its track (premultiplied, with its
    // border) and its fill's colours, `barColumns` x `barRows` from
    // (barLeft, barTop).
    barX: f64
    barY: f64
    barWidth: f64
    barHeight: f64
    barLeft: i64
    barTop: i64
    barColumns: usize
    barRows: usize
    barTrack: [*]u32
    barColours: [*]u32
    // The picture's brightness while it fades out on quit (1: all).
    brightness: f64
    // Whether the next frame restores the whole screen from the backdrop
    // (after fading, or a change to the backdrop), and whether the last
    // frame changed all of it rather than the region alone: the output
    // then copies all of it.
    restoreAll: bool
    wholeChanged: bool
    // The still parts are in the backdrop. The light of the rings' front
    // halves where the letters are is kept apart (frontAt: pixel indices,
    // frontLight: the light, as much as the letter there covers): the
    // letters are laid over the backdrop each frame and it is added back.
    baked: bool
    frontAt: [*]u32
    frontLight: [*]u32
    frontCount: usize
    frontCapacity: usize
    lastTime: f64
    allocator: Allocator
}

pub fn makeSurface(surface: *Surface, width: usize, height: usize, allocator: Allocator) -> bool {
    const memory = allocator.alloc(width * height * 4, 4096)
    if memory == null { return false }
    unsafe { surface.*.pixels = @ptrCast([*]u32, memory.?) }
    surface.*.width = width
    surface.*.height = height
    surface.*.stride = width
    paint.clipAll(surface)
    return true
}

// Where the point at (cos, sin) * radius of a ring's plane is on the
// screen, and how near (z > 0: in front of the letters).
pub fn project(scene: *Scene, ring: *const Ring, radius: f64, c: f64, s: f64, x: *f64, y: *f64, z: *f64) -> void {
    const px = radius * c
    const in_plane = radius * s
    const py = in_plane * ring.*.tiltCos
    z.* = in_plane * ring.*.tiltSin
    x.* = scene.*.cx + (px * ring.*.rollCos - py * ring.*.rollSin) * scene.*.unit
    y.* = scene.*.cy + (px * ring.*.rollSin + py * ring.*.rollCos) * scene.*.unit
}

// A ring's radius while it comes in (`appear` 0 to 1): it opens out.
pub fn ringRadius(scene: *Scene, index: usize, appear: f64) -> f64 {
    return scene.*.rings[index].radius * (0.55 + 0.45 * appear)
}

// A canvas on the region alone (text is clipped to it as the rest is).
pub fn regionCanvas(scene: *Scene) -> canvas_module.Canvas {
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrFromInt([*]u32, @intFromPtr(scene.*.frame.pixels) + (scene.*.regionY * scene.*.frame.stride + scene.*.regionX) * 4) }
    return canvas_module.Canvas.{
        .pixels = pixels,
        .width = scene.*.regionWidth,
        .height = scene.*.regionHeight,
        .stride = scene.*.frame.stride,
        .swapRedBlue = false,
        .device = 0,
        .opacity = 255,
    }
}

// Text on the region's canvas at screen position (x, y) (its line's top).
pub fn drawText(scene: *Scene, text: *ui_text.Text, string: []const u8, x: f64, y: f64, color: u32) -> void {
    var canvas = regionCanvas(scene)
    ui_text.drawText(&canvas, text, string, @intCast(i32, paint.round(x) - @intCast(i64, scene.*.regionX)), @intCast(i32, paint.round(y) - @intCast(i64, scene.*.regionY)), color, 0)
}

// The width of `string` in `text`, in pixels.
pub fn measure(text: *ui_text.Text, string: []const u8) -> f64 {
    return paint.signedFloat(@intCast(i64, ui_text.measure(text, string)))
}
