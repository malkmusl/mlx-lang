// The splash's picture as data: its rings, nodes and particles, the
// backdrop and the frame, what it says. The modules drawing it (backdrop,
// orbits, status) and scene.mlx, which runs a frame, share it from here.
//
// Everything is measured in `unit`, a sixteenth of the widest 16:9 box the
// screen holds, so the picture keeps its proportions at any resolution.
const std = @import("std")
const ui_text = @import("std.ui.text")
const paint = @import("./paint.mlx")
const logo_module = @import("./logo.mlx")

pub const Allocator = std.allocator.Allocator
pub const Surface = paint.Surface

pub const RING_COUNT: usize = 3
pub const NODE_COUNT: usize = 6
pub const DUST_COUNT: usize = 90
pub const TWINKLE_COUNT: usize = 48
pub const STAR_COUNT: usize = 460
// Glints riding the rings.
pub const SPARKLE_COUNT: usize = 96
// When the dial and the letters' glow have come in (s): from then on they
// stand still and are drawn into the backdrop once.
pub const BAKE_TIME: f64 = 1.75
// A frame is drawn in bands of this many rows (bands.mlx), a whole number
// of tiles.
pub const BAND_ROWS: usize = 64
// The frames whose tiles are kept (an output's buffer two frames behind
// needs its own and this frame's).
pub const HISTORY: u64 = 4
pub const CAPTION_COUNT: usize = 8

// What the scene records besides sparks, glows and lines (paint.mlx).
pub const LETTERS: u32 = 3
pub const LOGO_GLOW: u32 = 4
pub const BAR: u32 = 5
pub const TEXT: u32 = 6

pub const Mode = enum(u8) {
    boot,
    shutdown,
    reboot,
    updates
}

pub const Ring = struct {
    radius: f64
    // The ring's plane: how far it leans away from the screen's (tilt) and
    // the angle of its long axis on the screen (roll), in radians. The roll
    // swings by `swing` either way, `pace` radians of the swing a second,
    // and the tilt rocks by `wobble`, so the orbits turn about the letters
    // as an atom's do while staying clear of the words under them; `phase`
    // sets each ring's swing apart from the others'.
    tilt: f64
    roll: f64
    swing: f64
    pace: f64
    wobble: f64
    phase: f64
    // The plane this frame (turnRings), as cosines and sines.
    tiltCos: f64
    tiltSin: f64
    rollCos: f64
    rollSin: f64
    colour: u32
    // The bright arc running round it: radians per second and where it
    // starts.
    headSpeed: f64
    headOffset: f64
}

pub const Node = struct {
    ring: usize
    // Where on its ring it starts and how fast it goes (radians/s).
    offset: f64
    speed: f64
    colour: u32
    // Its satellite's angle around it and distance (units).
    satelliteAngle: f64
    satelliteDistance: f64
    // Where it was drawn this frame.
    x: f64
    y: f64
    z: f64
}

// A line of text as drawn once (captions.mlx).
pub const Caption = struct {
    // Whose glyphs (a ui_text.Text's address; 0: unused) and what it says.
    font: usize
    bytes: [200]u8
    length: usize
    // Its coverage (0-255), `width` x `height`, its top left (left, top)
    // from where ui_text.drawText puts the line's top left.
    coverage: [*]u8
    capacity: usize
    width: usize
    height: usize
    left: i64
    top: i64
    // The last frame it was drawn in.
    used: u64
}

// The threads drawing a frame's bands besides the caller (bands.mlx).
pub const Crew = struct {
    threads: usize
    // Bumped for each frame (the threads wait on it); the next band to
    // take, the frame's generation in its high half; the bands not drawn
    // yet (the caller waits on it).
    generation: u32
    next: u64
    remaining: u32
    bands: u32
    scene: usize
}

pub const Scene = struct {
    tables: paint.Tables
    width: usize
    height: usize
    unit: f64
    // The middle of the rings and the letters.
    cx: f64
    cy: f64
    backdrop: Surface
    frame: Surface
    // The part of the screen the animation draws on.
    regionX: usize
    regionY: usize
    regionWidth: usize
    regionHeight: usize
    halo: paint.Sprite
    nodeHalo: paint.Sprite
    nodeCore: paint.Sprite
    dust: paint.Sprite
    // The halo's and the dust's glows made once per light (paint.Tints).
    haloTints: paint.Tints
    dustTints: paint.Tints
    logo: logo_module.Logo
    logoX: i64
    logoY: i64
    rings: [3]Ring
    nodes: [6]Node
    dustAngle: [90]f64
    dustRadius: [90]f64
    dustSpeed: [90]f64
    dustBright: [90]f64
    twinkleX: [48]f64
    twinkleY: [48]f64
    twinklePhase: [48]f64
    sparkleRing: [96]usize
    sparkleAngle: [96]f64
    sparkleSpeed: [96]f64
    sparkleLift: [96]f64
    sparklePhase: [96]f64
    text: ui_text.Text
    small: ui_text.Text
    status: [200]u8
    statusLength: usize
    message: [200]u8
    messageLength: usize
    // Shown progress follows `progress` smoothly (0-1); off in shutdown.
    progress: f64
    shownProgress: f64
    showProgress: bool
    mode: Mode
    // The progress bar: where it is, its track (premultiplied, with its
    // border) and its fill's colours, `barColumns` x `barRows` from
    // (barLeft, barTop).
    barX: f64
    barY: f64
    barWidth: f64
    barHeight: f64
    barLeft: i64
    barTop: i64
    barColumns: usize
    barRows: usize
    barTrack: [*]u32
    barColours: [*]u32
    // The picture's brightness while it fades out on quit (1: all).
    brightness: f64
    // Whether the next frame restores the whole screen from the backdrop
    // (the backdrop changed).
    restoreAll: bool
    // The still parts (the dial, the letters' glow) are in the backdrop.
    baked: bool
    lastTime: f64
    // Frames drawn (the first is 1), and the last that changed the whole
    // screen.
    frameNumber: u64
    wholeFrame: u64
    // The tiles each of the last HISTORY frames drew on, one byte each:
    // frame n's at (n % HISTORY) * tileCount.
    marks: [*]u8
    tileColumns: usize
    tileRows: usize
    tileCount: usize
    // The frame recorded and its commands sorted into bands: band b's
    // are bandCounts[b] indices at the address bandLists[b], which has
    // room for bandRooms[b]. What drawing each band would take (roughly,
    // in pixels) and the bands in the order they are taken, the longest
    // first; a surface for each band to draw on.
    recording: paint.Recording
    bandCount: usize
    bandLists: [*]usize
    bandCounts: [*]u32
    bandRooms: [*]u32
    bandCosts: [*]u64
    bandOrder: [*]u32
    bandSurfaces: [*]Surface
    // This frame: restored and marked whole, dimmed to `drawBrightness`.
    drawWhole: bool
    drawBrightness: f64
    // Where each band copies what it drew (output.aim; 0: nowhere): a
    // buffer, rows `targetPitch` bytes apart, holding frame `targetHeld`
    // (it takes what that frame or this one drew on, or all of it when
    // `targetWhole`), red and blue swapped when `targetSwap`.
    targetAddress: usize
    targetPitch: usize
    targetHeld: u64
    targetWhole: bool
    targetSwap: bool
    captions: [8]Caption
    // The threads drawing with this one; set by whoever made the scene
    // (init leaves it).
    crew: *Crew
    allocator: Allocator
}

pub fn makeSurface(surface: *Surface, width: usize, height: usize, allocator: Allocator) -> bool {
    const memory = allocator.alloc(width * height * 4, 4096)
    if memory == null { return false }
    unsafe { surface.*.pixels = @ptrCast([*]u32, memory.?) }
    surface.*.width = width
    surface.*.height = height
    surface.*.stride = width
    paint.clipAll(surface)
    paint.plain(surface)
    return true
}

// The tiles frame `number` drew on.
pub fn marksOf(scene: *Scene, number: u64) -> [*]u8 {
    const marks: [*]u8 = scene.*.marks + @intCast(usize, number % HISTORY) * scene.*.tileCount
    return marks
}

// Where the point at (cos, sin) * radius of a ring's plane is on the
// screen, and how near (z > 0: in front of the letters).
pub fn project(scene: *Scene, ring: *const Ring, radius: f64, c: f64, s: f64, x: *f64, y: *f64, z: *f64) -> void {
    const px = radius * c
    const in_plane = radius * s
    const py = in_plane * ring.*.tiltCos
    z.* = in_plane * ring.*.tiltSin
    x.* = scene.*.cx + (px * ring.*.rollCos - py * ring.*.rollSin) * scene.*.unit
    y.* = scene.*.cy + (px * ring.*.rollSin + py * ring.*.rollCos) * scene.*.unit
}

// A ring's radius while it comes in (`appear` 0 to 1): it opens out.
pub fn ringRadius(scene: *Scene, index: usize, appear: f64) -> f64 {
    return scene.*.rings[index].radius * (0.55 + 0.45 * appear)
}

// The width of `string` in `text`, in pixels.
pub fn measure(text: *ui_text.Text, string: []const u8) -> f64 {
    return paint.signedFloat(@intCast(i64, ui_text.measure(text, string)))
}
