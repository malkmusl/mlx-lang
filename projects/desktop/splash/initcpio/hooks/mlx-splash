#!/usr/bin/ash

splash_disabled() {
    [ "$(getarg mlx.splash)" = "0" ] || [ -n "$(getarg nosplash)" ]
}

run_hook() {
    splash_disabled && return 0
    mkdir -p /run/mlx
    @BINDIR@/mlx-splash --mode boot --pid-file /run/mlx/splash.pid >/dev/null 2>&1 &
}

run_latehook() {
    splash_disabled && return 0
    # Starting the renderer and mounting a very fast root can race. Wait
    # briefly for the abstract socket, then hand the mounted root over.
    local tries=0
    while [ "$tries" -lt 50 ]; do
        if @BINDIR@/mlx-splashctl ping >/dev/null 2>&1; then
            @BINDIR@/mlx-splashctl --newroot=/sysroot >/dev/null 2>&1
            return $?
        fi
        sleep 0.1
        tries=$((tries + 1))
    done
    return 1
}

run_emergencyhook() {
    @BINDIR@/mlx-splashctl quit >/dev/null 2>&1 || true
}
