#!/bin/bash

build() {
    local font

    # add_binary follows the interpreter and shared-library dependencies;
    # no userspace Vulkan/Mesa stack is needed by the CPU/KMS renderer.
    add_binary '@BINDIR@/mlx-splash'
    add_binary '@BINDIR@/mlx-splashctl'

    # The scene uses one proportional and one monospaced TrueType font.
    for font in \
        /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
        /usr/share/fonts/TTF/DejaVuSans.ttf \
        /usr/share/fonts/dejavu/DejaVuSans.ttf \
        /usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf \
        /usr/share/fonts/noto/NotoSans-Regular.ttf \
        /usr/share/fonts/truetype/noto/NotoSans-Regular.ttf \
        /usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf \
        /usr/share/fonts/TTF/LiberationSans-Regular.ttf \
        /usr/share/fonts/liberation/LiberationSans-Regular.ttf; do
        if [[ -f $font ]]; then
            add_file "$font"
            break
        fi
    done
    for font in \
        /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf \
        /usr/share/fonts/TTF/DejaVuSansMono.ttf \
        /usr/share/fonts/dejavu/DejaVuSansMono.ttf \
        /usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono.ttf \
        /usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf \
        /usr/share/fonts/TTF/LiberationMono-Regular.ttf \
        /usr/share/fonts/noto/NotoSansMono-Regular.ttf \
        /usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf \
        /usr/share/fonts/liberation/LiberationMono-Regular.ttf; do
        if [[ -f $font ]]; then
            add_file "$font"
            break
        fi
    done

    if declare -F add_systemd_unit >/dev/null; then
        # A systemd initramfs starts the daemon as the same unit the real
        # root knows, so the active process is adopted rather than doubled.
        add_file /etc/systemd/system/mlx-splash.service /usr/lib/systemd/system/mlx-splash.service
        add_file /etc/systemd/system/mlx-splash-switch-root.service /usr/lib/systemd/system/mlx-splash-switch-root.service
        add_symlink /usr/lib/systemd/system/sysinit.target.wants/mlx-splash.service ../mlx-splash.service
        add_symlink /usr/lib/systemd/system/initrd-switch-root.target.wants/mlx-splash-switch-root.service ../mlx-splash-switch-root.service
    else
        add_runscript
    fi

    if declare -F add_udev_rule >/dev/null; then
        add_udev_rule '71-seat.rules'
    fi
}

help() {
    cat <<HELPEOF
This hook starts mlx-splash in the initramfs, after the KMS driver is loaded.
Put it after kms in HOOKS. It supports classic udev and systemd initramfses.
HELPEOF
}
