// The system calls the splash daemon and mlx-splashctl make, on the kernel
// alone: files, sockets (the Plymouth socket is an abstract Unix one),
// poll, signals as a descriptor, the clock.
const std = @import("std")
const dbus = @import("std.dbus")
const linux = std.linux

pub const SYS_read: usize = 0
pub const SYS_write: usize = 1
pub const SYS_close: usize = 3
pub const SYS_poll: usize = 7
pub const SYS_mmap: usize = 9
pub const SYS_munmap: usize = 11
pub const SYS_rt_sigprocmask: usize = 14
pub const SYS_ioctl: usize = 16
pub const SYS_nanosleep: usize = 35
pub const SYS_getpid: usize = 39
pub const SYS_socket: usize = 41
pub const SYS_connect: usize = 42
pub const SYS_sendto: usize = 44
pub const SYS_bind: usize = 49
pub const SYS_listen: usize = 50
pub const SYS_fsync: usize = 74
pub const SYS_rename: usize = 82
pub const SYS_mkdir: usize = 83
pub const SYS_unlink: usize = 87
pub const SYS_getdents64: usize = 217
pub const SYS_openat: usize = 257
pub const SYS_accept4: usize = 288
pub const SYS_signalfd4: usize = 289

pub const O_RDONLY: usize = 0
pub const O_WRONLY: usize = 1
pub const O_RDWR: usize = 2
pub const O_CREAT: usize = 64
pub const O_NOCTTY: usize = 256
pub const O_TRUNC: usize = 512
pub const O_NONBLOCK: usize = 2048
pub const O_DIRECTORY: usize = 65536
pub const O_CLOEXEC: usize = 524288
const AT_FDCWD: usize = 18446744073709551516

pub const POLLIN: u16 = 1
pub const POLLOUT: u16 = 4
pub const POLLERR: u16 = 8
pub const POLLHUP: u16 = 16

pub const EAGAIN: isize = -11
pub const EINTR: isize = -4
pub const EPIPE: isize = -32

const SOCK_STREAM: usize = 1
const SOCK_NONBLOCK: usize = 2048
const SOCK_CLOEXEC: usize = 524288
const MSG_NOSIGNAL: usize = 16384

// ---------------------------------------------------------------------------
// Words

pub fn say(text: []const u8) -> void {
    const a = std.io.writeAll(std.io.stderr(), "mlx-splash: ")
    const b = std.io.writeAll(std.io.stderr(), text)
    const c = std.io.writeAll(std.io.stderr(), "\n")
}

pub fn sayAbout(text: []const u8, subject: []const u8) -> void {
    const a = std.io.writeAll(std.io.stderr(), "mlx-splash: ")
    const b = std.io.writeAll(std.io.stderr(), text)
    const c = std.io.writeAll(std.io.stderr(), subject)
    const d = std.io.writeAll(std.io.stderr(), "\n")
}

// The bytes up to `string`'s NUL.
pub fn cString(string: [*]const u8) -> []const u8 {
    var length: usize = 0
    while string[length] != 0 { length += 1 }
    return string[0..length]
}

// ---------------------------------------------------------------------------
// Files

pub fn open(path: [*]const u8, flags: usize) -> isize {
    return linux.syscall4(SYS_openat, AT_FDCWD, @intFromPtr(path), flags | O_CLOEXEC, 420)
}

pub fn close(descriptor: isize) -> void {
    if descriptor < 0 { return }
    const closed = linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

pub fn read(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    return linux.syscall3(SYS_read, @bitCast(usize, descriptor), @intFromPtr(into), capacity)
}

pub fn write(descriptor: isize, bytes: [*]const u8, length: usize) -> isize {
    return linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(bytes), length)
}

pub fn writeAll(descriptor: isize, bytes: []const u8) -> bool {
    var start: usize = 0
    unsafe { start = @intFromPtr(@ptrCast([*]const u8, bytes)) }
    var done: usize = 0
    while done < bytes.length {
        var rest: [*]const u8 = undefined
        unsafe { rest = @ptrFromInt([*]const u8, start + done) }
        const written = write(descriptor, rest, bytes.length - done)
        if written == EINTR { continue }
        if written <= 0 { return false }
        done += @bitCast(usize, written)
    }
    return true
}

pub fn ioctl(descriptor: isize, request: usize, argument: usize) -> isize {
    return linux.syscall3(SYS_ioctl, @bitCast(usize, descriptor), request, argument)
}

// A shared read-write mapping of `length` bytes of `descriptor`; 0 when it
// fails.
pub fn mmap(length: usize, descriptor: isize) -> usize {
    const address = linux.syscall6(SYS_mmap, 0, length, 3, 1, @bitCast(usize, descriptor), 0)
    if address < 0 { return 0 }
    return @bitCast(usize, address)
}

pub fn munmap(address: usize, length: usize) -> void {
    if address == 0 { return }
    const unmapped = linux.syscall2(SYS_munmap, address, length)
}

// Reads the whole small file at `path` into `into`; its length, or -1.
pub fn readFile(path: [*]const u8, into: [*]u8, capacity: usize) -> isize {
    const descriptor = open(path, O_RDONLY)
    if descriptor < 0 { return -1 }
    var total: usize = 0
    while total < capacity {
        const rest: [*]u8 = into + total
        const got = read(descriptor, rest, capacity - total)
        if got == EINTR { continue }
        if got <= 0 { break }
        total += @bitCast(usize, got)
    }
    close(descriptor)
    return @bitCast(isize, total)
}

// Writes `bytes` as the file at `path` whole or not at all: into
// PATH.new first, then renamed over it. The directories up to it are made.
pub fn replaceFile(path: [*]const u8, bytes: []const u8) -> bool {
    var temporary: [512]u8 = undefined
    const name = cString(path)
    if name.length + 5 > 512 { return false }
    makeParents(name)
    var index: usize = 0
    while index < name.length {
        temporary[index] = name[index]
        index += 1
    }
    for byte in ".new" {
        temporary[index] = byte
        index += 1
    }
    temporary[index] = 0
    const temporary_path: [*]const u8 = &temporary
    const descriptor = open(temporary_path, O_WRONLY | O_CREAT | O_TRUNC)
    if descriptor < 0 { return false }
    const written = writeAll(descriptor, bytes)
    const synced = linux.syscall1(SYS_fsync, @bitCast(usize, descriptor))
    close(descriptor)
    if !written { return false }
    return linux.syscall2(SYS_rename, @intFromPtr(temporary_path), @intFromPtr(path)) == 0
}

// Makes the directories above the file `path` (as mkdir -p would).
fn makeParents(path: []const u8) -> void {
    var directory: [512]u8 = undefined
    var index: usize = 1
    while index < path.length && index < 511 {
        if path[index] == 47 {
            var copy: usize = 0
            while copy < index {
                directory[copy] = path[copy]
                copy += 1
            }
            directory[index] = 0
            unsafe { const made = linux.syscall2(SYS_mkdir, @intFromPtr(&directory), 493) }
        }
        index += 1
    }
}

// Whether the directory at `path` holds an entry whose name starts with
// `prefix`.
pub fn hasEntry(path: [*]const u8, prefix: []const u8) -> bool {
    const descriptor = open(path, O_RDONLY | O_DIRECTORY)
    if descriptor < 0 { return false }
    var buffer: [2048]u8 = undefined
    const bytes: [*]u8 = &buffer
    var found = false
    while !found {
        const got = linux.syscall3(SYS_getdents64, @bitCast(usize, descriptor), @intFromPtr(bytes), 2048)
        if got <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, got) {
            // struct linux_dirent64: ino (8), off (8), reclen (2), type (1),
            // name.
            const length = @intCast(usize, bytes[at + 16]) | (@intCast(usize, bytes[at + 17]) << 8)
            if length == 0 { break }
            var matches = true
            var index: usize = 0
            while index < prefix.length && matches {
                if bytes[at + 19 + index] != prefix[index] { matches = false }
                index += 1
            }
            if matches { found = true }
            at += length
        }
    }
    close(descriptor)
    return found
}

// ---------------------------------------------------------------------------
// Sockets

// `name` as an abstract Unix address (a NUL, then the name; the length
// stops at its end, as Plymouth's "trimmed" address does) into `address`;
// its length.
fn abstractAddress(address: *[110]u8, name: []const u8) -> usize {
    address.*[0] = 1
    address.*[1] = 0
    address.*[2] = 0
    var index: usize = 0
    while index < name.length && index < 106 {
        address.*[3 + index] = name[index]
        index += 1
    }
    return 3 + index
}

// A listening stream socket at the abstract address `name`; -1 when it is
// taken or cannot be made.
pub fn listenAbstract(name: []const u8) -> isize {
    const descriptor = linux.syscall3(SYS_socket, 1, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0)
    if descriptor < 0 { return -1 }
    var address: [110]u8 = undefined
    const length = abstractAddress(&address, name)
    if linux.syscall3(SYS_bind, @bitCast(usize, descriptor), @intFromPtr(&address), length) != 0 || linux.syscall2(SYS_listen, @bitCast(usize, descriptor), 16) != 0 {
        close(descriptor)
        return -1
    }
    return descriptor
}

// A connection to the abstract address `name` (blocking); -1 when nobody
// listens there.
pub fn connectAbstract(name: []const u8) -> isize {
    const descriptor = linux.syscall3(SYS_socket, 1, SOCK_STREAM | SOCK_CLOEXEC, 0)
    if descriptor < 0 { return -1 }
    var address: [110]u8 = undefined
    const length = abstractAddress(&address, name)
    if linux.syscall3(SYS_connect, @bitCast(usize, descriptor), @intFromPtr(&address), length) != 0 {
        close(descriptor)
        return -1
    }
    return descriptor
}

// The name of the process at the other end of the socket `descriptor`
// (its /proc/PID/comm) into `into`; its length, 0 when unknown.
pub fn peerName(descriptor: isize, into: *[32]u8) -> usize {
    var pid: u32 = 0
    var uid: u32 = 0
    var gid: u32 = 0
    if !dbus.peerCredentials(descriptor, &pid, &uid, &gid) || pid == 0 { return 0 }
    var path: [48]u8 = undefined
    var length: usize = 0
    for byte in "/proc/" {
        path[length] = byte
        length += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = pid
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        path[length] = digits[count]
        length += 1
    }
    for byte in "/comm" {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    var got: isize = 0
    unsafe { got = readFile(&path, @ptrCast([*]u8, into), 32) }
    if got <= 0 { return 0 }
    var name_length = @bitCast(usize, got)
    while name_length > 0 && into.*[name_length - 1] == 10 { name_length -= 1 }
    return name_length
}

pub fn accept(descriptor: isize) -> isize {
    return linux.syscall4(SYS_accept4, @bitCast(usize, descriptor), 0, 0, SOCK_NONBLOCK | SOCK_CLOEXEC)
}

// Writes to a socket whose reader may be gone (systemd sends its updates
// and closes without reading the answer): no SIGPIPE, EPIPE is only a
// result.
pub fn send(descriptor: isize, bytes: []const u8) -> isize {
    var start: usize = 0
    unsafe { start = @intFromPtr(@ptrCast([*]const u8, bytes)) }
    return linux.syscall6(SYS_sendto, @bitCast(usize, descriptor), start, bytes.length, MSG_NOSIGNAL, 0, 0)
}

// ---------------------------------------------------------------------------
// Waiting

// struct pollfd entries: descriptor, events, revents (8 bytes each).
pub fn pollSet(entries: [*]u8, index: usize, descriptor: isize, events: u16) -> void {
    const at = index * 8
    const value = @bitCast(u32, @intCast(i32, descriptor))
    entries[at] = @intCast(u8, value & 255)
    entries[at + 1] = @intCast(u8, (value >> 8) & 255)
    entries[at + 2] = @intCast(u8, (value >> 16) & 255)
    entries[at + 3] = @intCast(u8, (value >> 24) & 255)
    entries[at + 4] = @intCast(u8, events & 255)
    entries[at + 5] = @intCast(u8, events >> 8)
    entries[at + 6] = 0
    entries[at + 7] = 0
}

pub fn pollResult(entries: [*]const u8, index: usize) -> u16 {
    return @intCast(u16, entries[index * 8 + 6]) | (@intCast(u16, entries[index * 8 + 7]) << 8)
}

pub fn poll(entries: [*]u8, count: usize, timeout_milliseconds: isize) -> isize {
    return linux.syscall3(SYS_poll, @intFromPtr(entries), count, @bitCast(usize, timeout_milliseconds))
}

// SIGTERM, SIGINT and SIGHUP as a descriptor to poll (blocked as signals).
pub fn signalDescriptor() -> isize {
    // Bits for signals 1 (HUP), 2 (INT) and 15 (TERM).
    var mask: [8]u8 = [8]u8{ 3, 64, 0, 0, 0, 0, 0, 0 }
    const blocked = linux.syscall4(SYS_rt_sigprocmask, 0, @intFromPtr(&mask), 0, 8)
    return linux.syscall4(SYS_signalfd4, 18446744073709551615, @intFromPtr(&mask), 8, O_NONBLOCK | O_CLOEXEC)
}

pub fn sleepMilliseconds(milliseconds: usize) -> void {
    var time: [16]u8 = undefined
    const seconds = milliseconds / 1000
    const nanoseconds = (milliseconds % 1000) * 1000000
    var index: usize = 0
    while index < 8 {
        time[index] = @intCast(u8, (seconds >> (index * 8)) & 255)
        time[8 + index] = @intCast(u8, (nanoseconds >> (index * 8)) & 255)
        index += 1
    }
    const slept = linux.syscall2(SYS_nanosleep, @intFromPtr(&time), 0)
}

// Seconds on the monotonic clock.
pub fn seconds() -> f64 {
    const nanoseconds: f64 = @floatFromInt(f64, @intCast(i64, std.time.monotonicNanoseconds()))
    return nanoseconds / 1000000000.0
}
