// What the splash daemon and mlx-splashctl need beyond std.linux (on the
// kernel alone): their words, files opened close-on-exec, the real root,
// files replaced whole, a socket peer's name, the clock.
const std = @import("std")
const linux = std.linux

// ---------------------------------------------------------------------------
// Words

pub fn say(text: []const u8) -> void {
    _ = std.io.writeAll(std.io.stderr(), "mlx-splash: ")
    _ = std.io.writeAll(std.io.stderr(), text)
    _ = std.io.writeAll(std.io.stderr(), "\n")
}

pub fn sayAbout(text: []const u8, subject: []const u8) -> void {
    _ = std.io.writeAll(std.io.stderr(), "mlx-splash: ")
    _ = std.io.writeAll(std.io.stderr(), text)
    _ = std.io.writeAll(std.io.stderr(), subject)
    _ = std.io.writeAll(std.io.stderr(), "\n")
}

// ---------------------------------------------------------------------------
// Files

// open(2) of a NUL-terminated path, close-on-exec (made with mode 0644).
pub fn open(path: [*]const u8, flags: usize) -> isize {
    return linux.open(path, flags | linux.O_CLOEXEC, 420)
}

// Moves this process into the real root before initramfs switches to it.
// The protocol hands us a slice, while the kernel wants a NUL-terminated
// path. Only the root-owned `newroot` request calls this.
pub fn changeRoot(path: []const u8) -> bool {
    if path.length == 0 || path.length > 511 || path[0] != 47 { return false }
    var terminated: [512]u8 = undefined
    var index: usize = 0
    while index < path.length {
        if path[index] == 0 { return false }
        terminated[index] = path[index]
        index += 1
    }
    terminated[index] = 0
    if linux.syscall1(linux.SYS_chroot, @intFromPtr(&terminated)) != 0 { return false }
    return linux.syscall1(linux.SYS_chdir, @intFromPtr("/")) == 0
}

// Writes `bytes` as the file at `path` whole or not at all: into
// PATH.new first, then renamed over it. The directories up to it are made.
pub fn replaceFile(path: [*]const u8, bytes: []const u8) -> bool {
    var temporary: [512]u8 = undefined
    const name = std.text.cString(path)
    if name.length + 5 > 512 { return false }
    _ = std.fs.makeParents(name, 493)
    var index: usize = 0
    while index < name.length {
        temporary[index] = name[index]
        index += 1
    }
    for byte in ".new" {
        temporary[index] = byte
        index += 1
    }
    temporary[index] = 0
    const temporary_path: [*]const u8 = &temporary
    const descriptor = open(temporary_path, linux.O_WRONLY | linux.O_CREAT | linux.O_TRUNC)
    if descriptor < 0 { return false }
    const written = linux.writeAll(descriptor, bytes)
    _ = linux.syscall1(linux.SYS_fsync, @bitCast(usize, descriptor))
    linux.close(descriptor)
    if !written { return false }
    return linux.syscall2(linux.SYS_rename, @intFromPtr(temporary_path), @intFromPtr(path)) == 0
}

// Whether the directory at `path` holds an entry whose name starts with
// `prefix`.
pub fn hasEntry(path: [*]const u8, prefix: []const u8) -> bool {
    const descriptor = open(path, linux.O_RDONLY | linux.O_DIRECTORY)
    if descriptor < 0 { return false }
    var buffer: [2048]u8 = undefined
    const bytes: [*]u8 = &buffer
    var found = false
    while !found {
        const got = linux.getdents(descriptor, bytes, 2048)
        if got <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, got) {
            // struct linux_dirent64: ino (8), off (8), reclen (2), type (1),
            // name.
            const length = @intCast(usize, bytes[at + 16]) | (@intCast(usize, bytes[at + 17]) << 8)
            if length == 0 { break }
            var matches = true
            var index: usize = 0
            while index < prefix.length && matches {
                if bytes[at + 19 + index] != prefix[index] { matches = false }
                index += 1
            }
            if matches { found = true }
            at += length
        }
    }
    linux.close(descriptor)
    return found
}

// ---------------------------------------------------------------------------
// Sockets

// The name of the process at the other end of the socket `descriptor`
// (its /proc/PID/comm) into `into`; its length, 0 when unknown.
pub fn peerName(descriptor: isize, into: *[32]u8) -> usize {
    var pid: u32 = 0
    var uid: u32 = 0
    var gid: u32 = 0
    if !linux.socket.peerCredentials(descriptor, &pid, &uid, &gid) || pid == 0 { return 0 }
    var path: [48]u8 = undefined
    var length: usize = 0
    for byte in "/proc/" {
        path[length] = byte
        length += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = pid
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        path[length] = digits[count]
        length += 1
    }
    for byte in "/comm" {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    var got: isize = 0
    unsafe { got = std.fs.readFileResult(&path, @ptrCast([*]u8, into), 32) }
    if got <= 0 { return 0 }
    var name_length = @bitCast(usize, got)
    while name_length > 0 && into.*[name_length - 1] == 10 { name_length -= 1 }
    return name_length
}

// ---------------------------------------------------------------------------
// The clock
// Seconds on the monotonic clock.
pub fn seconds() -> f64 {
    const nanoseconds: f64 = @floatFromInt(f64, @intCast(i64, std.time.monotonicNanoseconds()))
    return nanoseconds / 1000000000.0
}
