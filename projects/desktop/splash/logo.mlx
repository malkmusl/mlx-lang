// The MLX letters of the splash: drawn once at the size they are shown,
// as polygons (std.ui.vector fills them smooth), into two images: the
// letters themselves (premultiplied ARGB: a lavender to violet gradient
// with light on their upper left edges, as if cut from glass) and their
// glow (how much light each pixel gets, blurred out from the letters),
// which the scene adds before laying the letters over it.
const std = @import("std")
const vector = @import("std.ui.vector")
const paint = @import("./paint.mlx")

const Allocator = std.allocator.Allocator

pub const Logo = struct {
    // The images' size: the letters and room for their glow around them.
    width: usize
    height: usize
    // Where the letters start in the images.
    padding: usize
    letters: [*]u32
    glow: [*]u8
    // Per row, the columns from the first with light or letter to past the
    // last, and the same for the letters alone: the rest is empty.
    firsts: [*]u32
    ends: [*]u32
    letterFirsts: [*]u32
    letterEnds: [*]u32
}

// The letters' shapes in units of their height (y down), cut in facets as
// the MLX mark is: the M a wide V between two stems whose tops are cut
// along it, the L plain, the X's rising bar broken with its top set apart.
// Each facet has its own shade, so each group is filled on its own; the
// polygons of a group all wind the same way (clockwise on the screen), or
// where they overlap they would cancel out.
const M_WIDTH: f64 = 1.17
const L_WIDTH: f64 = 0.75
const X_WIDTH: f64 = 0.93
const GAP: f64 = 0.13

// The width of "MLX" for letters `height` high.
pub fn widthFor(height: f64) -> f64 { return (M_WIDTH + L_WIDTH + X_WIDTH + 2.0 * GAP) * height }

const Facet = enum(u8) {
    light,
    violet,
    blue,
    cyan
}

// A closed polygon of `count` numbers (x, y pairs).
fn polygon(shape: *vector.Shape, ox: f64, oy: f64, size: f64, points: [*]const f64, count: usize) -> void {
    vector.moveTo(shape, ox + points[0] * size, oy + points[1] * size)
    var index: usize = 2
    while index + 1 < count {
        vector.lineTo(shape, ox + points[index] * size, oy + points[index + 1] * size)
        index += 2
    }
    vector.close(shape)
}

fn facets(shape: *vector.Shape, facet: Facet, ox: f64, oy: f64, size: f64) -> void {
    const lx = ox + (M_WIDTH + GAP) * size
    const xx = ox + (M_WIDTH + L_WIDTH + 2.0 * GAP) * size
    if facet == Facet.light {
        // The M's V, the L, the X's falling bar and the rising one's foot.
        const points_1 = [14]f64{ 0.0, 0.0, 0.31, 0.0, 0.585, 0.56, 0.86, 0.0, M_WIDTH, 0.0, 0.67, 0.86, 0.50, 0.86 }
        polygon(shape, ox, oy, size, &points_1, 14)
        const points_2 = [12]f64{ 0.0, 0.0, 0.24, 0.0, 0.24, 0.76, L_WIDTH, 0.76, L_WIDTH, 1.0, 0.0, 1.0 }
        polygon(shape, lx, oy, size, &points_2, 12)
        const points_3 = [8]f64{ 0.085, 0.0, 0.335, 0.0, X_WIDTH, 1.0, 0.70, 1.0 }
        polygon(shape, xx, oy, size, &points_3, 8)
        const points_4 = [8]f64{ 0.0, 1.0, 0.42, 0.45, 0.66, 0.45, 0.24, 1.0 }
        polygon(shape, xx, oy, size, &points_4, 8)
    } else if facet == Facet.violet {
        const points_5 = [8]f64{ 0.0, 0.20, 0.20, 0.37, 0.20, 1.0, 0.0, 1.0 }
        polygon(shape, ox, oy, size, &points_5, 8)
    } else if facet == Facet.blue {
        const points_6 = [8]f64{ M_WIDTH - 0.20, 0.37, M_WIDTH, 0.20, M_WIDTH, 1.0, M_WIDTH - 0.20, 1.0 }
        polygon(shape, ox, oy, size, &points_6, 8)
    } else {
        // The rising bar's top, set apart: it points back at its foot.
        const points_7 = [8]f64{ 0.76, 0.0, X_WIDTH, 0.0, 0.73, 0.42, 0.59, 0.21 }
        polygon(shape, xx, oy, size, &points_7, 8)
    }
}

// The shade a facet takes over the lavender of the letters.
fn tintOf(facet: Facet) -> u32 {
    if facet == Facet.violet { return paint.rgb(170, 112, 238) }
    if facet == Facet.blue { return paint.rgb(118, 140, 250) }
    if facet == Facet.cyan { return paint.rgb(130, 222, 255) }
    return paint.rgb(255, 255, 255)
}

// Draws the letters `height` pixels high; false without memory.
pub fn make(logo: *Logo, height: f64, allocator: Allocator) -> bool {
    const blur = paint.round(height * 0.16)
    const padding = @intCast(usize, blur * 3 + 4)
    const letters_width = @intCast(usize, paint.round(widthFor(height))) + 2
    const letters_height = @intCast(usize, paint.round(height)) + 2
    logo.*.padding = padding
    logo.*.width = letters_width + 2 * padding
    logo.*.height = letters_height + 2 * padding
    const count = logo.*.width * logo.*.height
    const letter_memory = allocator.alloc(count * 4, 4)
    const glow_memory = allocator.alloc(count, 1)
    const coverage_memory = allocator.alloc(count, 1)
    const facet_memory = allocator.alloc(count, 1)
    const scratch_memory = allocator.alloc(count * 4, 4)
    const spans_memory = allocator.alloc(logo.*.height * 16, 4)
    if letter_memory == null || glow_memory == null || coverage_memory == null || facet_memory == null || scratch_memory == null || spans_memory == null { return false }
    unsafe {
        logo.*.letters = @ptrCast([*]u32, letter_memory.?)
        const spans_address = @intFromPtr(spans_memory.?)
        logo.*.firsts = @ptrFromInt([*]u32, spans_address)
        logo.*.ends = @ptrFromInt([*]u32, spans_address + logo.*.height * 4)
        logo.*.letterFirsts = @ptrFromInt([*]u32, spans_address + logo.*.height * 8)
        logo.*.letterEnds = @ptrFromInt([*]u32, spans_address + logo.*.height * 12)
    }
    logo.*.glow = glow_memory.?
    const coverage = coverage_memory.?
    const facet_coverage = facet_memory.?
    var sums: [*]u32 = undefined
    unsafe { sums = @ptrCast([*]u32, scratch_memory.?) }
    var index: usize = 0
    while index < count {
        logo.*.letters[index] = 0
        coverage[index] = 0
        index += 1
    }

    const origin = paint.toFloat(padding) + 1.0
    const all = [4]Facet{ Facet.light, Facet.violet, Facet.blue, Facet.cyan }
    var facet_number: usize = 0
    while facet_number < 4 {
        const facet = all[facet_number]
        var shape: vector.Shape = undefined
        if !vector.begin(&shape, logo.*.width, logo.*.height, allocator) { return false }
        facets(&shape, facet, origin, origin, height)
        vector.coverage(&shape, facet_coverage)
        vector.end(&shape)
        colour(logo, facet_coverage, coverage, tintOf(facet), height)
        facet_number += 1
    }

    blurInto(logo.*.glow, coverage, sums, logo.*.width, logo.*.height, @intCast(usize, blur))
    allocator.free(coverage, count, 1)
    allocator.free(facet_coverage, count, 1)
    allocator.free(scratch_memory.?, count * 4, 4)
    spans(logo)
    return true
}

fn spans(logo: *Logo) -> void {
    const width = logo.*.width
    var row: usize = 0
    while row < logo.*.height {
        var first = width
        var end: usize = 0
        var letter_first = width
        var letter_end: usize = 0
        var column: usize = 0
        while column < width {
            const at = row * width + column
            // Light too faint to show is left out.
            if logo.*.glow[at] < 3 { logo.*.glow[at] = 0 }
            if logo.*.glow[at] != 0 || logo.*.letters[at] != 0 {
                if first == width { first = column }
                end = column + 1
            }
            if logo.*.letters[at] != 0 {
                if letter_first == width { letter_first = column }
                letter_end = column + 1
            }
            column += 1
        }
        if first == width { first = 0 }
        if letter_first == width { letter_first = 0 }
        logo.*.firsts[row] = @intCast(u32, first)
        logo.*.ends[row] = @intCast(u32, end)
        logo.*.letterFirsts[row] = @intCast(u32, letter_first)
        logo.*.letterEnds[row] = @intCast(u32, letter_end)
        row += 1
    }
}

// A facet's colour laid into the letters: pink lavender at the left to
// blue lavender at the right, a little lighter at the top, in the facet's
// shade; its coverage added to the letters' for the glow.
fn colour(logo: *Logo, facet: [*]const u8, total: [*]u8, tint: u32, height: f64) -> void {
    const width = logo.*.width
    const top = paint.toFloat(logo.*.padding)
    const across = paint.toFloat(width) - 2.0 * top
    const left_colour = paint.rgb(236, 204, 255)
    const right_colour = paint.rgb(196, 208, 255)
    const shaded = tint != paint.rgb(255, 255, 255)
    var row: usize = 0
    while row < logo.*.height {
        const v = paint.clamp((paint.toFloat(row) - top) / height, 0.0, 1.0)
        var column: usize = 0
        while column < width {
            const at = row * width + column
            const cover = @intCast(u32, facet[at])
            if cover != 0 {
                const u = paint.clamp((paint.toFloat(column) - top) / across, 0.0, 1.0)
                var colour_here = paint.mix(left_colour, right_colour, u)
                if shaded { colour_here = paint.mix(colour_here, tint, 0.55 + 0.15 * v) }
                colour_here = paint.dim(colour_here, 1.0 - 0.14 * v)
                const premultiplied = paint.premultiplied(colour_here, cover)
                logo.*.letters[at] = paint.layer(logo.*.letters[at], premultiplied)
                const sum = @intCast(u32, total[at]) + cover
                total[at] = @intCast(u8, if sum > 255 { 255 } else { sum })
            }
            column += 1
        }
        row += 1
    }
}

// The coverage blurred by three box blurs `radius` wide (close to a
// gaussian), each a running sum along the rows and then the columns.
fn blurInto(out: [*]u8, coverage: [*]const u8, sums: [*]u32, width: usize, height: usize, radius: usize) -> void {
    var index: usize = 0
    while index < width * height {
        sums[index] = @intCast(u32, coverage[index])
        index += 1
    }
    var pass: usize = 0
    while pass < 3 {
        boxRows(sums, width, height, radius)
        boxColumns(sums, width, height, radius)
        pass += 1
    }
    index = 0
    while index < width * height {
        out[index] = @intCast(u8, if sums[index] > 255 { 255 } else { sums[index] })
        index += 1
    }
}

fn boxRows(values: [*]u32, width: usize, height: usize, radius: usize) -> void {
    var line: [8192]u32 = undefined
    const span = 2 * radius + 1
    var row: usize = 0
    while row < height {
        const start = row * width
        var column: usize = 0
        while column < width && column < 8192 {
            line[column] = values[start + column]
            column += 1
        }
        var sum: u32 = 0
        column = 0
        while column < width && column < 8192 {
            if column == 0 {
                var k: usize = 0
                while k <= radius && k < width {
                    sum += line[k]
                    k += 1
                }
            } else {
                if column + radius < width { sum += line[column + radius] }
                if column > radius { sum -= line[column - radius - 1] }
            }
            values[start + column] = sum / @intCast(u32, span)
            column += 1
        }
        row += 1
    }
}

fn boxColumns(values: [*]u32, width: usize, height: usize, radius: usize) -> void {
    var line: [8192]u32 = undefined
    const span = 2 * radius + 1
    var column: usize = 0
    while column < width {
        var row: usize = 0
        while row < height && row < 8192 {
            line[row] = values[row * width + column]
            row += 1
        }
        var sum: u32 = 0
        row = 0
        while row < height && row < 8192 {
            if row == 0 {
                var k: usize = 0
                while k <= radius && k < height {
                    sum += line[k]
                    k += 1
                }
            } else {
                if row + radius < height { sum += line[row + radius] }
                if row > radius { sum -= line[row - radius - 1] }
            }
            values[row * width + column] = sum / @intCast(u32, span)
            row += 1
        }
        column += 1
    }
}

// The logo's glow at (x, y) (its images' top left), `light` (paint.lightOf)
// added: into the frame while the letters fade in, then once into the
// backdrop (light adds up in any order, so it is the same picture).
pub fn addGlow(surface: *paint.Surface, logo: *const Logo, x: i64, y: i64, light: u32) -> void {
    var row: usize = 0
    while row < logo.*.height {
        const sy = y + @intCast(i64, row)
        if sy >= surface.*.clipTop && sy < surface.*.clipBottom {
            const line = @intCast(usize, sy) * surface.*.stride
            var column = @intCast(usize, logo.*.firsts[row])
            var end = @intCast(usize, logo.*.ends[row])
            if x + @intCast(i64, column) < surface.*.clipLeft { column = @intCast(usize, surface.*.clipLeft - x) }
            if x + @intCast(i64, end) > surface.*.clipRight { end = @intCast(usize, surface.*.clipRight - x) }
            if column < end { paint.mark(surface, x + @intCast(i64, column), sy, x + @intCast(i64, end) - 1, sy) }
            while column < end {
                const value = @intCast(u32, logo.*.glow[row * logo.*.width + column])
                if value != 0 {
                    // paint.addPixel(pixel, paint.scale(light, value)),
                    // written out.
                    const to = line + @intCast(usize, x + @intCast(i64, column))
                    const a = surface.*.pixels[to] & 16777215
                    const b = ((((light & paint.RED_BLUE) * value) >> 8) & paint.RED_BLUE) | ((((light & paint.GREEN) * value) >> 8) & paint.GREEN)
                    const sum = ((a & paint.LOW_SEVEN) + (b & paint.LOW_SEVEN)) ^ ((a ^ b) & paint.HIGH_BITS)
                    const carry = ((a & b) | ((a | b) & ~sum)) & paint.HIGH_BITS
                    surface.*.pixels[to] = paint.OPAQUE | sum | ((carry << 1) - (carry >> 7))
                }
                column += 1
            }
        }
        row += 1
    }
}

// The letters at (x, y) (the images' top left) laid over at `alpha` (0-1).
pub fn drawLetters(surface: *paint.Surface, logo: *const Logo, x: i64, y: i64, alpha: f64) -> void {
    const k = paint.weight(alpha)
    if k == 0 { return }
    var row: usize = 0
    while row < logo.*.height {
        const sy = y + @intCast(i64, row)
        if sy >= surface.*.clipTop && sy < surface.*.clipBottom {
            const line = @intCast(usize, sy) * surface.*.stride
            var column = @intCast(usize, logo.*.letterFirsts[row])
            var end = @intCast(usize, logo.*.letterEnds[row])
            if x + @intCast(i64, column) < surface.*.clipLeft { column = @intCast(usize, surface.*.clipLeft - x) }
            if x + @intCast(i64, end) > surface.*.clipRight { end = @intCast(usize, surface.*.clipRight - x) }
            if column < end { paint.mark(surface, x + @intCast(i64, column), sy, x + @intCast(i64, end) - 1, sy) }
            while column < end {
                var letter = logo.*.letters[row * logo.*.width + column]
                if letter != 0 {
                    const to = line + @intCast(usize, x + @intCast(i64, column))
                    if k < 256 { letter = paint.fadePremultiplied(letter, k) }
                    const alpha_byte = letter >> 24
                    if alpha_byte == 255 {
                        surface.*.pixels[to] = letter
                    } else {
                        surface.*.pixels[to] = paint.overPremultiplied(surface.*.pixels[to], letter)
                    }
                }
                column += 1
            }
        }
        row += 1
    }
}
