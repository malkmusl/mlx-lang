// mlx-splashctl: tells the boot splash (mlx-splash, or plymouthd: the
// protocol is the same) what is happening. The plymouth tool's spellings
// work too (--quit, --retain-splash, --ping, --wait, --update=TEXT,
// display-message --text=TEXT, change-mode --shutdown, ...), so scripts
// written for it can call this.
//
//   mlx-splashctl ping                    exit 0 when a splash runs
//   mlx-splashctl quit [--retain-splash]  ends it (the frame stays for the
//                                         display manager with the option)
//   mlx-splashctl wait                    returns once it has ended
//   mlx-splashctl deactivate | reactivate
//   mlx-splashctl show-splash | hide-splash
//   mlx-splashctl message TEXT | hide-message TEXT
//   mlx-splashctl update TEXT             what is starting
//   mlx-splashctl change-mode MODE        boot, shutdown, reboot, updates
//   mlx-splashctl system-update PERCENT
//   mlx-splashctl pause-progress | unpause-progress
//   mlx-splashctl has-active-vt
//   mlx-splashctl absent                  succeeds only when none is running
//
// --socket NAME talks to another abstract socket (tests).
const std = @import("std")
const protocol = @import("./protocol.mlx")
const system = @import("./system.mlx")

fn say(text: []const u8) -> void {
    _ = std.io.writeAll(std.io.stderr(), "mlx-splashctl: ")
    _ = std.io.writeAll(std.io.stderr(), text)
    _ = std.io.writeAll(std.io.stderr(), "\n")
}

fn usage() -> void {
    _ = std.io.writeAll(std.io.stdout(), "usage: mlx-splashctl [--socket NAME] COMMAND [ARGUMENT]\n  ping, quit [--retain-splash], wait, deactivate, reactivate,\n  show-splash, hide-splash, message TEXT, hide-message TEXT, update TEXT,\n  change-mode boot|shutdown|reboot|updates, system-update PERCENT,\n  pause-progress, unpause-progress, has-active-vt, absent\n")
}

// What to send: a command byte and maybe an argument.
const Order = struct {
    command: u8
    hasArgument: bool
    argument: []const u8
    retain: bool
    wait: bool
    absent: bool
}

// The word (and its argument) as an order; false when it is not one.
fn orderOf(word: []const u8, next: ?[]const u8, order: *Order, used_next: *bool) -> bool {
    used_next.* = false
    order.*.hasArgument = false
    order.*.argument = ""
    if std.text.same(word, "ping") || std.text.same(word, "--ping") { order.*.command = 80 } else if std.text.same(word, "quit") || std.text.same(word, "--quit") { order.*.command = 81 } else if std.text.same(word, "wait") || std.text.same(word, "--wait") { order.*.wait = true } else if std.text.same(word, "absent") { order.*.absent = true } else if std.text.same(word, "deactivate") || std.text.same(word, "--deactivate") { order.*.command = 68 } else if std.text.same(word, "reactivate") || std.text.same(word, "--reactivate") { order.*.command = 114 } else if std.text.same(word, "show-splash") || std.text.same(word, "--show-splash") { order.*.command = 36 } else if std.text.same(word, "hide-splash") || std.text.same(word, "--hide-splash") { order.*.command = 72 } else if std.text.same(word, "pause-progress") { order.*.command = 65 } else if std.text.same(word, "unpause-progress") { order.*.command = 97 } else if std.text.same(word, "has-active-vt") || std.text.same(word, "--has-active-vt") { order.*.command = 86 } else if std.text.same(word, "--sysinit") { order.*.command = 83 } else if std.text.startsWith(word, "--update=") {
        order.*.command = 85
        order.*.hasArgument = true
        order.*.argument = word[9..word.length]
    } else if std.text.startsWith(word, "--newroot=") {
        order.*.command = 82
        order.*.hasArgument = true
        order.*.argument = word[10..word.length]
    } else if std.text.same(word, "message") || std.text.same(word, "display-message") || std.text.same(word, "hide-message") || std.text.same(word, "update") || std.text.same(word, "change-mode") || std.text.same(word, "system-update") {
        if next == null { return false }
        var value = next.?
        used_next.* = true
        if std.text.same(word, "message") || std.text.same(word, "display-message") {
            order.*.command = 77
            if std.text.startsWith(value, "--text=") { value = value[7..value.length] }
        } else if std.text.same(word, "hide-message") {
            order.*.command = 109
            if std.text.startsWith(value, "--text=") { value = value[7..value.length] }
        } else if std.text.same(word, "update") {
            order.*.command = 85
            if std.text.startsWith(value, "--status=") { value = value[9..value.length] }
        } else if std.text.same(word, "change-mode") {
            order.*.command = 67
            if std.text.startsWith(value, "--") { value = value[2..value.length] }
        } else {
            order.*.command = 117
            if std.text.startsWith(value, "--progress=") { value = value[11..value.length] }
        }
        order.*.hasArgument = true
        order.*.argument = value
    } else {
        return false
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var socket_name: []const u8 = protocol.SOCKET_NAME
    var order = Order.{ .command = 0, .hasArgument = false, .argument = "", .retain = false, .wait = false, .absent = false }
    var have_order = false
    const count = arguments.length
    var index: usize = 1
    while index < count {
        const word = std.string.asSlice(std.process.argument(arguments, index))
        var next: ?[]const u8 = null
        if index + 1 < count { next = std.string.asSlice(std.process.argument(arguments, index + 1)) }
        if std.text.same(word, "--help") {
            usage()
            return 0
        } else if std.text.same(word, "--socket") && next != null {
            socket_name = next.?
            index += 2
        } else if std.text.same(word, "--retain-splash") {
            order.retain = true
            index += 1
        } else if !have_order {
            var used_next = false
            if !orderOf(word, next, &order, &used_next) {
                usage()
                return 2
            }
            have_order = true
            index += if used_next { 2 } else { 1 }
        } else {
            usage()
            return 2
        }
    }
    if !have_order {
        usage()
        return 2
    }
    const descriptor = std.linux.socket.connectUnix(socket_name, true, std.linux.socket.SOCK_CLOEXEC)
    if descriptor < 0 {
        // Nothing to wait for or tell; ping and has-active-vt say no,
        // while absent is the condition used by the real-root unit.
        if order.wait || order.absent { return 0 }
        if order.command == 80 || order.command == 86 { return 1 }
        say("no splash is running")
        return 1
    }
    if order.absent {
        std.linux.close(descriptor)
        return 1
    }
    if order.wait {
        // The splash closes every connection when it ends.
        var byte: [1]u8 = undefined
        while true {
            const bytes: [*]u8 = &byte
            const got = std.linux.read(descriptor, bytes, 1)
            if got == std.linux.EINTR { continue }
            if got <= 0 { break }
        }
        std.linux.close(descriptor)
        return 0
    }
    var argument: ?[]const u8 = null
    if order.command == 81 {
        // quit's argument: one byte, set to retain the splash.
        argument = if order.retain { "\x01" } else { "" }
    } else if order.hasArgument {
        argument = order.argument
    }
    const reply = protocol.ask(descriptor, order.command, argument)
    std.linux.close(descriptor)
    if reply == protocol.ACK { return 0 }
    if reply == protocol.NAK { return 1 }
    say("the splash did not answer")
    return 1
}
