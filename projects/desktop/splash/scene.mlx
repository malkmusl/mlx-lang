// The splash's picture: the MLX letters in a night of indigo, three rings
// of light orbiting them, the code graph of the Observatory riding the
// rings, a dial of ticks behind the letters, dust drifting out, and below
// them what the system is doing over a progress bar. This module sets it
// up and runs a frame; orbits.mlx, backdrop.mlx and status.mlx draw the
// parts, state.mlx holds them.
//
// The backdrop is drawn once; each frame restores the region the animation
// covers from it and draws over that, so a frame costs the middle of the
// screen, not all of it. Once everything has come in, what stands still
// is drawn into the backdrop too.
const std = @import("std")
const ui_text = @import("std.ui.text")
const canvas_module = @import("std.ui.canvas")
const paint = @import("./paint.mlx")
const logo_module = @import("./logo.mlx")
const state = @import("./state.mlx")
const orbits = @import("./orbits.mlx")
const backdrop = @import("./backdrop.mlx")
const status_module = @import("./status.mlx")

const Allocator = state.Allocator
pub const Scene = state.Scene
pub const Mode = state.Mode

// ---------------------------------------------------------------------------
// Setting up

pub fn init(scene: *Scene, width: usize, height: usize, mode: Mode, allocator: Allocator) -> bool {
    scene.*.width = width
    scene.*.height = height
    scene.*.mode = mode
    scene.*.allocator = allocator
    paint.initTables(&scene.*.tables)
    const box_width = if paint.toFloat(width) * 9.0 > paint.toFloat(height) * 16.0 { paint.toFloat(height) * 16.0 / 9.0 } else { paint.toFloat(width) }
    const unit = box_width / 16.0
    scene.*.unit = unit
    scene.*.cx = paint.toFloat(width) / 2.0
    scene.*.cy = paint.toFloat(height) / 2.0 - 0.15 * unit
    scene.*.statusLength = 0
    scene.*.messageLength = 0
    scene.*.progress = 0.0
    scene.*.shownProgress = 0.0
    scene.*.showProgress = mode == Mode.boot || mode == Mode.updates
    scene.*.brightness = 1.0
    scene.*.restoreAll = true
    scene.*.wholeChanged = true
    scene.*.baked = false
    scene.*.lastTime = 0.0

    if !state.makeSurface(&scene.*.backdrop, width, height, allocator) || !state.makeSurface(&scene.*.frame, width, height, allocator) { return false }
    if !paint.makeSprite(&scene.*.halo, spriteRadius(unit * 0.055, 3.0, 16.0), allocator) { return false }
    if !paint.makeSprite(&scene.*.nodeHalo, spriteRadius(unit * 0.17, 5.0, 48.0), allocator) { return false }
    if !paint.makeSprite(&scene.*.nodeCore, spriteRadius(unit * 0.045, 2.0, 12.0), allocator) { return false }
    if !paint.makeSprite(&scene.*.dust, spriteRadius(unit * 0.03, 1.0, 8.0), allocator) { return false }
    if !logo_module.make(&scene.*.logo, unit * 1.45, allocator) { return false }
    scene.*.logoX = paint.round(scene.*.cx - paint.toFloat(scene.*.logo.width) / 2.0)
    scene.*.logoY = paint.round(scene.*.cy - paint.toFloat(scene.*.logo.height) / 2.0)
    if !backdrop.allocateFrontLight(scene, allocator) { return false }

    // The region: the rings, their nodes and dust, down to the progress
    // bar. Nothing is drawn outside it (it is all a frame clears).
    const left = paint.clamp(scene.*.cx - 6.3 * unit, 0.0, paint.toFloat(width))
    const right = paint.clamp(scene.*.cx + 6.3 * unit, 0.0, paint.toFloat(width))
    const top = paint.clamp(scene.*.cy - 4.0 * unit, 0.0, paint.toFloat(height))
    const bottom = paint.clamp(scene.*.cy + 4.3 * unit, 0.0, paint.toFloat(height))
    scene.*.regionX = @intCast(usize, paint.toInt(left))
    scene.*.regionY = @intCast(usize, paint.toInt(top))
    scene.*.regionWidth = @intCast(usize, paint.toInt(right)) - scene.*.regionX
    scene.*.regionHeight = @intCast(usize, paint.toInt(bottom)) - scene.*.regionY
    if !status_module.prepare(scene) { return false }

    initRings(scene)
    var random = paint.Random.{ .state = 9112539781371292431 }
    initParticles(scene, &random)
    backdrop.draw(scene, &random)
    paint.copyRect(&scene.*.frame, &scene.*.backdrop, 0, 0, width, height)
    scene.*.frame.clipLeft = @intCast(i64, scene.*.regionX)
    scene.*.frame.clipTop = @intCast(i64, scene.*.regionY)
    scene.*.frame.clipRight = @intCast(i64, scene.*.regionX + scene.*.regionWidth)
    scene.*.frame.clipBottom = @intCast(i64, scene.*.regionY + scene.*.regionHeight)

    scene.*.text.loaded = false
    scene.*.small.loaded = false
    const text_height = @intCast(u32, paint.round(paint.clamp(unit * 0.17, 10.0, 64.0)))
    const small_height = @intCast(u32, paint.round(paint.clamp(unit * 0.095, 8.0, 36.0)))
    const ignored_text = ui_text.loadText(&scene.*.text, text_height, allocator)
    const ignored_small = ui_text.loadMonoText(&scene.*.small, small_height, allocator)
    setStatus(scene, modeStatus(mode))
    return true
}

fn spriteRadius(pixels: f64, low: f64, high: f64) -> i32 {
    return @intCast(i32, paint.round(paint.clamp(pixels, low, high)))
}

fn ring(radius: f64, tilt_degrees: f64, roll_degrees: f64, colour: u32, head_speed: f64, head_offset: f64, tables: *const paint.Tables) -> state.Ring {
    const degree = paint.pi() / 180.0
    return state.Ring.{
        .radius = radius,
        .tiltCos = paint.cosine(tables, tilt_degrees * degree),
        .tiltSin = paint.sine(tables, tilt_degrees * degree),
        .rollCos = paint.cosine(tables, roll_degrees * degree),
        .rollSin = paint.sine(tables, roll_degrees * degree),
        .colour = colour,
        .headSpeed = head_speed,
        .headOffset = head_offset,
    }
}

fn node(ring_index: usize, offset: f64, speed: f64, colour: u32, satellite_angle: f64, satellite_distance: f64) -> state.Node {
    return state.Node.{ .ring = ring_index, .offset = offset, .speed = speed, .colour = colour, .satelliteAngle = satellite_angle, .satelliteDistance = satellite_distance, .x = 0.0, .y = 0.0, .z = 0.0 }
}

fn initRings(scene: *Scene) -> void {
    const tables = &scene.*.tables
    scene.*.rings[0] = ring(3.95, 73.0, -11.0, paint.rgb(88, 168, 255), 0.85, 0.4, tables)
    scene.*.rings[1] = ring(3.6, 62.0, 27.0, paint.rgb(146, 116, 255), -0.65, 2.6, tables)
    scene.*.rings[2] = ring(3.0, 50.0, -60.0, paint.rgb(104, 140, 255), 1.1, 4.4, tables)
    // The Observatory icon's modules: orange, green, purple, cyan, yellow,
    // and a rose one; two to a ring.
    scene.*.nodes[0] = node(0, 2.55, 0.16, paint.rgb(244, 146, 70), 3.7, 0.95)
    scene.*.nodes[1] = node(0, 5.9, 0.16, paint.rgb(118, 206, 118), 5.6, 0.8)
    scene.*.nodes[2] = node(1, 0.7, -0.12, paint.rgb(176, 118, 236), 0.9, 0.9)
    scene.*.nodes[3] = node(1, 3.6, -0.12, paint.rgb(78, 210, 238), 2.2, 0.75)
    scene.*.nodes[4] = node(2, 1.4, 0.2, paint.rgb(246, 204, 84), 4.6, 0.85)
    scene.*.nodes[5] = node(2, 4.6, 0.2, paint.rgb(236, 120, 176), 1.3, 0.7)
}

fn initParticles(scene: *Scene, random: *paint.Random) -> void {
    var index: usize = 0
    while index < state.DUST_COUNT {
        scene.*.dustAngle[index] = paint.unit(random) * 2.0 * paint.pi()
        scene.*.dustRadius[index] = 1.4 + paint.unit(random) * 4.8
        scene.*.dustSpeed[index] = 0.08 + paint.unit(random) * 0.22
        scene.*.dustBright[index] = 0.25 + paint.unit(random) * 0.75
        index += 1
    }
    index = 0
    while index < state.SPARKLE_COUNT {
        scene.*.sparkleRing[index] = index % state.RING_COUNT
        scene.*.sparkleAngle[index] = paint.unit(random) * 2.0 * paint.pi()
        scene.*.sparkleSpeed[index] = 0.05 + paint.unit(random) * 0.25
        scene.*.sparkleLift[index] = (paint.unit(random) - 0.5) * 0.35
        scene.*.sparklePhase[index] = paint.unit(random) * 2.0 * paint.pi()
        index += 1
    }
    index = 0
    while index < state.TWINKLE_COUNT {
        scene.*.twinkleX[index] = paint.toFloat(scene.*.regionX) + paint.unit(random) * paint.toFloat(scene.*.regionWidth)
        scene.*.twinkleY[index] = paint.toFloat(scene.*.regionY) + paint.unit(random) * paint.toFloat(scene.*.regionHeight)
        scene.*.twinklePhase[index] = paint.unit(random) * 2.0 * paint.pi()
        index += 1
    }
}

// ---------------------------------------------------------------------------
// What the scene shows

// The line under the letters: what the system is doing.
pub fn setStatus(scene: *Scene, text: []const u8) -> void {
    scene.*.statusLength = copyText(&scene.*.status, text)
}

// What a mode says before any unit is named.
fn modeStatus(mode: Mode) -> []const u8 {
    if mode == Mode.shutdown { return "Shutting down" }
    if mode == Mode.reboot { return "Restarting" }
    if mode == Mode.updates { return "Installing updates" }
    return "Starting MLX"
}

// Another mode (boot, shutdown, reboot, updates): its words, and the bar
// only where progress means something.
pub fn setMode(scene: *Scene, mode: Mode) -> void {
    scene.*.mode = mode
    scene.*.showProgress = mode == Mode.boot || mode == Mode.updates
    setStatus(scene, modeStatus(mode))
}

// The unit systemd is busy with ("systemd-udevd.service"): its name
// without the suffix, "Starting" it at boot, "Stopping" it when going
// down. Updates keep their own words.
pub fn setUnit(scene: *Scene, unit_name: []const u8) -> void {
    if scene.*.mode == Mode.updates { return }
    var length = unit_name.length
    var dot = length
    while dot > 0 {
        dot -= 1
        if unit_name[dot] == 46 {
            length = dot
            break
        }
    }
    var line: [200]u8 = undefined
    const prefix = if scene.*.mode == Mode.boot { "Starting " } else { "Stopping " }
    var at: usize = 0
    while at < prefix.length {
        line[at] = prefix[at]
        at += 1
    }
    var index: usize = 0
    while index < length && at < 199 {
        line[at] = unit_name[index]
        at += 1
        index += 1
    }
    var slice: []const u8 = undefined
    unsafe { slice = @ptrCast([*]const u8, &line)[0..at] }
    setStatus(scene, slice)
}

// The message hidden again, when it is the one shown.
pub fn hideMessage(scene: *Scene, text: []const u8) -> void {
    if text.length != scene.*.messageLength { return }
    var index: usize = 0
    while index < text.length {
        const shown = scene.*.message[index]
        const given = if text[index] < 32 { 32 } else { text[index] }
        if shown != given { return }
        index += 1
    }
    scene.*.messageLength = 0
}

pub fn setMessage(scene: *Scene, text: []const u8) -> void {
    scene.*.messageLength = copyText(&scene.*.message, text)
}

pub fn setProgress(scene: *Scene, fraction: f64) -> void {
    scene.*.progress = paint.clamp(fraction, 0.0, 1.0)
}

fn copyText(into: *[200]u8, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && index < 200 {
        // Control characters would show as boxes.
        into.*[index] = if text[index] < 32 { 32 } else { text[index] }
        index += 1
    }
    return index
}

// ---------------------------------------------------------------------------
// A frame

// The picture at `time` seconds since the splash appeared, into `frame`
// (only the region changes, unless `wholeChanged` says otherwise).
pub fn draw(scene: *Scene, time: f64) -> void {
    const step = paint.clamp(time - scene.*.lastTime, 0.0, 0.25)
    scene.*.lastTime = time
    // The bar catches up with the progress in about half a second.
    scene.*.shownProgress += (scene.*.progress - scene.*.shownProgress) * paint.clamp(step * 5.0, 0.0, 1.0)
    if time >= state.BAKE_TIME && !scene.*.baked { backdrop.bake(scene) }
    // While fading in or out the whole screen changes, so all of it is
    // restored (and once more after, to leave it whole).
    const brightness = paint.min(scene.*.brightness, paint.smoothstep(0.0, 0.5, time))
    const whole = brightness < 1.0 || scene.*.restoreAll
    if whole {
        paint.copyRect(&scene.*.frame, &scene.*.backdrop, 0, 0, scene.*.width, scene.*.height)
    } else {
        paint.copyRect(&scene.*.frame, &scene.*.backdrop, scene.*.regionX, scene.*.regionY, scene.*.regionWidth, scene.*.regionHeight)
    }
    scene.*.restoreAll = brightness < 1.0

    const baked = scene.*.baked
    const appear = if baked { 1.0 } else { paint.easeOut((time - 0.25) / 1.4) }
    const letters = paint.smoothstep(0.05, 0.9, time)
    const dial = paint.smoothstep(0.7, 1.7, time)
    orbits.twinkles(scene, time)
    orbits.dust(scene, time, appear)
    if !baked { orbits.dialStill(scene, &scene.*.frame, dial) }
    orbits.dialScanner(scene, time, dial)
    orbits.placeNodes(scene, time, appear)
    if !baked { orbits.ringBase(scene, &scene.*.frame, appear, false) }
    orbits.ringArcs(scene, time, appear, false)
    orbits.sparkles(scene, time, appear, false)
    orbits.links(scene, time, paint.smoothstep(1.0, 2.0, time))
    orbits.nodes(scene, time, false)
    if !baked { logo_module.addGlow(&scene.*.frame, &scene.*.logo, scene.*.logoX, scene.*.logoY, backdrop.logoLight(letters)) }
    logo_module.drawLetters(&scene.*.frame, &scene.*.logo, scene.*.logoX, scene.*.logoY, letters)
    if baked {
        backdrop.addFrontLight(scene)
    } else {
        orbits.ringBase(scene, &scene.*.frame, appear, true)
    }
    orbits.ringArcs(scene, time, appear, true)
    orbits.sparkles(scene, time, appear, true)
    orbits.nodes(scene, time, true)
    orbits.labels(scene, paint.smoothstep(1.4, 2.4, time))
    status_module.draw(scene, time, paint.smoothstep(0.9, 1.6, time))
    if brightness < 1.0 { fade(scene, brightness) }
    scene.*.wholeChanged = whole
}

fn fade(scene: *Scene, brightness: f64) -> void {
    const k = paint.weight(brightness)
    var row: usize = 0
    while row < scene.*.height {
        const line = row * scene.*.frame.stride
        var column: usize = 0
        while column < scene.*.width {
            scene.*.frame.pixels[line + column] = paint.OPAQUE | paint.scale(scene.*.frame.pixels[line + column], k)
            column += 1
        }
        row += 1
    }
}

// The whole frame dimmed by `brightness` from now on (0: black); the
// backdrop outside the region dims too.
pub fn setBrightness(scene: *Scene, brightness: f64) -> void {
    scene.*.brightness = paint.clamp(brightness, 0.0, 1.0)
}
