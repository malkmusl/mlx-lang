// The screen's picture, handed from the program that leaves brixOS's
// framebuffer to the one that takes it: the splash to the greeter's
// compositor, that one to the session's, the session's to the greeter's
// again. The one that comes fades in from the picture the other left
// (drm.brixos.mlx's opening crossfade) and has it from here, never from
// the device: video memory is mapped write-combining, which is written
// fast and read back a bus transaction at a time (seconds for a whole
// screen).
//
// Whoever draws on /devices/framebuffer composes its frames in memory of
// its own. When it leaves the screen with its picture on it, it writes
// that frame to PATH (in /temporary: the file system's memory when the
// system runs from its boot archive, the disk's /temporary when it runs
// from a disk, where the file is a brixfs file like another and the init
// removes one an earlier boot left): HEADER bytes (four words, little-endian: MAGIC, the width and the height in
// pixels, the pixels' byte order as the framebuffer's geometry names it,
// 1 blue first, 2 red first), then the pixels, four bytes each, row after
// row with nothing between. The program that takes the screen reads the
// file and removes it (it is as large as the screen); one with no use for
// the picture removes it all the same (discard), so a file found there is
// what the screen shows now. With no file, or one that is not this
// screen's (another size, or cut short: its writer was ended at it), there
// is no picture, and nothing is read from anywhere else.
//
// The programs are different users (the splash the system's, the
// greeter's compositor an unprivileged one, the session's the person who
// logged in): the file is its writer's and readable by all (0644, as the
// screen itself is: /devices/framebuffer), and /temporary lets each remove
// the other's. A writer puts nothing through a name that is already there:
// it removes it and makes its own.
const std = @import("std")
const brix = std.os.brix

pub const PATH: []const u8 = "/temporary/screen-picture"

// The pixels' byte order (the framebuffer's format word).
pub const BLUE_FIRST: usize = 1
pub const RED_FIRST: usize = 2

// "brixpic1", as a word.
const MAGIC: usize = 0x3163697078697262
const HEADER: usize = 32
// What one read or write carries at most.
const PIECE: usize = 1048576

fn word(bytes: [*]const u8, at: usize) -> usize {
    var value: usize = 0
    var k: usize = 8
    while k > 0 {
        k -= 1
        value = (value << 8) | @intCast(usize, bytes[at + k])
    }
    return value
}

fn putWord(bytes: [*]u8, at: usize, value: usize) -> void {
    var rest = value
    var k: usize = 0
    while k < 8 {
        bytes[at + k] = @intCast(u8, rest & 255)
        rest = rest >> 8
        k += 1
    }
}

// `length` bytes at `address` to the file's bytes from `at` on; false when
// not all of them went.
fn writeAll(file: brix.Handle, address: usize, length: usize, at: usize) -> bool {
    var done: usize = 0
    while done < length {
        const piece = if length - done > PIECE { PIECE } else { length - done }
        const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address + done) }
        const wrote = brix.write(file, bytes[0..piece], at + done)
        if wrote <= 0 { return false }
        done += @bitCast(usize, wrote)
    }
    return true
}

// `length` bytes of the file from `at` on to `address`; false when it has
// fewer.
fn readAll(file: brix.Handle, address: usize, length: usize, at: usize) -> bool {
    var done: usize = 0
    while done < length {
        const piece = if length - done > PIECE { PIECE } else { length - done }
        const bytes: [*]u8 = unsafe { @ptrFromInt([*]u8, address + done) }
        const got = brix.read(file, bytes[0..piece], at + done)
        if got <= 0 { return false }
        done += @bitCast(usize, got)
    }
    return true
}

// Removes the picture left, if there is one: for a program that takes the
// screen and draws all of it at once.
pub fn discard() -> void { _ = brix.remove(0, PATH) }

// Leaves the frame at `pixels` (`height` rows of `width` pixels in
// `order`, `stride` bytes from one row to the next) as the screen's
// picture for the program that takes the screen next. False when it could
// not be written whole: then there is no file.
pub fn leave(pixels: usize, width: usize, height: usize, stride: usize, order: usize) -> bool {
    discard()
    const opened = brix.open(0, PATH, brix.Open.WRITE | brix.Open.CREATE | brix.Open.EXCLUSIVE, 0x1A4)
    if opened < 0 { return false }
    const file = @intCast(u32, opened)
    var header: [HEADER]u8 = undefined
    const words: [*]u8 = &header
    putWord(words, 0, MAGIC)
    putWord(words, 8, width)
    putWord(words, 16, height)
    putWord(words, 24, order)
    var whole = writeAll(file, @intFromPtr(words), HEADER, 0)
    if stride == width * 4 {
        whole = whole && writeAll(file, pixels, width * height * 4, HEADER)
    } else {
        var row: usize = 0
        while whole && row < height {
            whole = writeAll(file, pixels + row * stride, width * 4, HEADER + row * width * 4)
            row += 1
        }
    }
    _ = brix.close(file)
    if !whole { discard() }
    return whole
}

// The file's pixels to `into` when it is a picture of `width` by `height`.
fn fill(file: brix.Handle, into: usize, width: usize, height: usize, order: usize) -> bool {
    var info: brix.NodeInfo = undefined
    if brix.nodeInfo(file, &info) != 0 || info.kind != brix.NodeKind.FILE { return false }
    const size = width * height * 4
    if @intCast(usize, info.size) != HEADER + size { return false }
    var header: [HEADER]u8 = undefined
    const words: [*]u8 = &header
    if !readAll(file, @intFromPtr(words), HEADER, 0) { return false }
    const theirs = word(words, 24)
    if word(words, 0) != MAGIC || word(words, 8) != width || word(words, 16) != height { return false }
    if theirs != BLUE_FIRST && theirs != RED_FIRST { return false }
    if !readAll(file, into, size, HEADER) { return false }
    if theirs != order {
        // The other order: red and blue change places.
        const pixels: [*]u32 = unsafe { @ptrFromInt([*]u32, into) }
        var k: usize = 0
        while k < width * height {
            const pixel = pixels[k]
            pixels[k] = (pixel & 4278255360) | ((pixel & 255) << 16) | ((pixel >> 16) & 255)
            k += 1
        }
    }
    return true
}

// Whether a picture of `width` by `height` is waiting (a file of that
// size: `take` looks closer), for a program that makes room for it only
// then (it is as large as the screen).
pub fn waiting(width: usize, height: usize) -> bool {
    const opened = brix.open(0, PATH, brix.Open.READ, 0)
    if opened < 0 { return false }
    var info: brix.NodeInfo = undefined
    const fits = brix.nodeInfo(@intCast(u32, opened), &info) == 0 && info.kind == brix.NodeKind.FILE && @intCast(usize, info.size) == HEADER + width * height * 4
    _ = brix.close(@intCast(u32, opened))
    return fits
}

// Takes the picture the program before left on a screen of `width` by
// `height`: its pixels to `into` (width * height * 4 bytes, rows with
// nothing between) in `order`. False when there is none or it is not this
// screen's (`into` is then undefined). The file is removed either way.
pub fn take(into: usize, width: usize, height: usize, order: usize) -> bool {
    const opened = brix.open(0, PATH, brix.Open.READ, 0)
    var fits = false
    if opened >= 0 {
        fits = fill(@intCast(u32, opened), into, width, height, order)
        _ = brix.close(@intCast(u32, opened))
    }
    discard()
    return fits
}
