# Hands the initramfs splash its real root before systemd switches to it.
# The daemon chroots there and therefore neither holds the initramfs nor
# loses its persistent duration and ask-password paths after switch-root.
[Unit]
Description=Hand the real root to the MLX boot splash
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
After=initrd-root-fs.target mlx-splash.service
Before=initrd-switch-root.service

[Service]
Type=oneshot
ExecStart=-@BINDIR@/mlx-splashctl --newroot=/sysroot
StandardInput=null
StandardOutput=null
StandardError=null
