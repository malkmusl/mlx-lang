# The boot splash (projects/desktop/splash) under systemd, in place of
# plymouth-start.service: started in the initramfs as soon as the devices
# are, told by systemd what starts (it speaks Plymouth's protocol), ended by
# mlx-splash-quit.service or by the program taking the screen (a display
# manager, the MLX compositor, mlx-console). tools/install_splash.sh
# installs it. mlx.splash=0 or nosplash on the kernel's command line keeps
# it away. IgnoreOnIsolate keeps the initramfs process across switch-root.
[Unit]
Description=MLX boot splash
Documentation=file://@DOCDIR@/README.md
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-vconsole-setup.service
Before=systemd-ask-password-console.service
ConditionKernelCommandLine=!mlx.splash=0
ConditionKernelCommandLine=!nosplash
ConditionVirtualization=!container
IgnoreOnIsolate=true

[Service]
Type=notify
# A classic initramfs starts the same daemon from its runscript. Skip the
# real-root start when its abstract socket is already present.
ExecCondition=@BINDIR@/mlx-splashctl absent
ExecStart=@BINDIR@/mlx-splash --mode boot
# A stop (SIGTERM) fades it out and gives the console back.
TimeoutStopSec=5

[Install]
WantedBy=sysinit.target
