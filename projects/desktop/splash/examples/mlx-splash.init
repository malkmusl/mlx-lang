# The boot splash under mlx-init (projects/init): it ends when the program
# taking the screen tells it to (mlx-console, the MLX compositor), or
# mlx-splashctl quit.
description = MLX boot splash
exec = @BINDIR@/mlx-splash --mode boot --pid-file /run/mlx/splash.pid
ready = /run/mlx/splash.pid
restart = no
