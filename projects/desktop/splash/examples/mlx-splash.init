# The boot splash is already running from the initramfs when mlx-init takes
# over. Keep this fallback definition for an explicit mlx-initctl start,
# but do not start a second daemon during the normal boot.
description = MLX boot splash
exec = @BINDIR@/mlx-splash --mode boot --pid-file /run/mlx/splash.pid
ready = /run/mlx/splash.pid
restart = no
disabled = yes
