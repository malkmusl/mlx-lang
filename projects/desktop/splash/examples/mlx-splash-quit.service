# Ends the boot splash once the system is up, where no display manager
# takes the screen (with one, mlx-splash.conf in its drop-in directory has
# it end the splash, which leaves its last frame): the login prompt on the
# first terminal comes after it.
[Unit]
Description=End the MLX boot splash
Documentation=file://@DOCDIR@/README.md
After=mlx-splash.service systemd-user-sessions.service rc-local.service
Before=getty@tty1.service
ConditionPathExists=!/etc/systemd/system/display-manager.service

[Service]
Type=oneshot
ExecStart=-@BINDIR@/mlx-splashctl quit
TimeoutSec=20

[Install]
WantedBy=multi-user.target
