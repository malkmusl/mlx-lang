# The splash while the system powers off, in place of plymouth-poweroff.service:
# started once the display manager and the login prompt have gone, it
# stays to the end (its argv[0] starts with "@", which systemd-shutdown's
# last killing spares).
[Unit]
Description=MLX splash while the system powers off
Documentation=file://@DOCDIR@/README.md
DefaultDependencies=no
After=getty@tty1.service display-manager.service
Before=systemd-poweroff.service systemd-halt.service
ConditionKernelCommandLine=!mlx.splash=0
ConditionKernelCommandLine=!nosplash
ConditionVirtualization=!container

[Service]
Type=notify
ExecStart=@BINDIR@/mlx-splash --mode shutdown

[Install]
WantedBy=poweroff.target halt.target
