// mlx-splash: the boot splash. For now the scene alone, drawn into PNG
// files to look at and timed (--png, --frames, --bench).
const std = @import("std")
const png = @import("std.png")
const paint = @import("./paint.mlx")
const scene_module = @import("./scene.mlx")

const Scene = scene_module.Scene

const Options = struct {
    width: usize
    height: usize
    mode: scene_module.Mode
    png: [*]const u8
    hasPng: bool
    framesDirectory: []const u8
    hasFrames: bool
    count: usize
    fps: usize
    bench: usize
    at: f64
    progress: f64
    status: []const u8
    hasStatus: bool
    message: []const u8
}

fn say(text: []const u8) -> void {
    const a = std.io.writeAll(std.io.stderr(), "mlx-splash: ")
    const b = std.io.writeAll(std.io.stderr(), text)
    const c = std.io.writeAll(std.io.stderr(), "\n")
}

fn named(option: std.string.String, name: []const u8) -> bool {
    return std.text.same(std.string.asSlice(option), name)
}

fn parseNumber(text: []const u8, value: *usize) -> bool {
    if text.length == 0 { return false }
    var result: usize = 0
    for byte in text {
        if byte < 48 || byte > 57 { return false }
        result = result * 10 + @intCast(usize, byte - 48)
    }
    value.* = result
    return true
}

// A decimal such as 2.5 (no sign, no exponent).
fn parseDecimal(text: []const u8, value: *f64) -> bool {
    if text.length == 0 { return false }
    var result: f64 = 0.0
    var scale: f64 = 0.0
    for byte in text {
        if byte == 46 && scale == 0.0 {
            scale = 1.0
        } else if byte >= 48 && byte <= 57 {
            const digit = paint.toFloat(@intCast(usize, byte - 48))
            if scale == 0.0 {
                result = result * 10.0 + digit
            } else {
                scale = scale / 10.0
                result += digit * scale
            }
        } else {
            return false
        }
    }
    value.* = result
    return true
}

fn parseSize(text: []const u8, options: *Options) -> bool {
    var split: usize = 0
    while split < text.length && text[split] != 120 { split += 1 }
    if split == 0 || split + 1 >= text.length { return false }
    var width: usize = 0
    var height: usize = 0
    if !parseNumber(text[0..split], &width) || !parseNumber(text[split + 1..text.length], &height) { return false }
    if width < 160 || height < 120 || width > 8192 || height > 8192 { return false }
    options.*.width = width
    options.*.height = height
    return true
}

fn parseMode(text: []const u8, mode: *scene_module.Mode) -> bool {
    if std.text.same(text, "boot") { mode.* = scene_module.Mode.boot } else if std.text.same(text, "shutdown") { mode.* = scene_module.Mode.shutdown } else if std.text.same(text, "reboot") { mode.* = scene_module.Mode.reboot } else if std.text.same(text, "updates") { mode.* = scene_module.Mode.updates } else { return false }
    return true
}

fn usage() -> void {
    const ignored = std.io.writeAll(std.io.stdout(), "usage: mlx-splash [--size WxH] [--mode boot|shutdown|reboot|updates]\n                  [--status TEXT] [--message TEXT] [--progress PERCENT]\n                  (--png FILE [--at SECONDS] | --frames DIR [--count N] [--fps N] | --bench N)\n")
}

// 0 when the options are fine, 1 after --help, else the exit code.
fn parseOptions(arguments: [][*]const u8, options: *Options) -> u8 {
    options.*.width = 1920
    options.*.height = 1080
    options.*.mode = scene_module.Mode.boot
    options.*.hasPng = false
    options.*.hasFrames = false
    options.*.count = 90
    options.*.fps = 30
    options.*.bench = 0
    options.*.at = 3.0
    options.*.progress = 0.35
    options.*.hasStatus = false
    options.*.status = ""
    options.*.message = ""
    options.*.framesDirectory = ""
    const count = arguments.length
    var index: usize = 1
    while index < count {
        const option = std.process.argument(arguments, index)
        const has_value = index + 1 < count
        var value: []const u8 = ""
        if has_value { value = std.string.asSlice(std.process.argument(arguments, index + 1)) }
        if named(option, "--help") {
            usage()
            return 1
        } else if named(option, "--size") && has_value {
            if !parseSize(value, options) {
                say("--size wants WIDTHxHEIGHT (160x120 to 8192x8192)")
                return 2
            }
        } else if named(option, "--mode") && has_value {
            if !parseMode(value, &options.*.mode) {
                say("--mode wants boot, shutdown, reboot or updates")
                return 2
            }
        } else if named(option, "--png") && has_value {
            options.*.png = std.process.argument(arguments, index + 1).pointer
            options.*.hasPng = true
        } else if named(option, "--at") && has_value {
            if !parseDecimal(value, &options.*.at) {
                say("--at wants seconds (such as 2.5)")
                return 2
            }
        } else if named(option, "--frames") && has_value {
            options.*.framesDirectory = value
            options.*.hasFrames = true
        } else if named(option, "--count") && has_value {
            if !parseNumber(value, &options.*.count) || options.*.count == 0 {
                say("--count wants a number of frames")
                return 2
            }
        } else if named(option, "--fps") && has_value {
            if !parseNumber(value, &options.*.fps) || options.*.fps == 0 || options.*.fps > 240 {
                say("--fps wants 1 to 240")
                return 2
            }
        } else if named(option, "--bench") && has_value {
            if !parseNumber(value, &options.*.bench) || options.*.bench == 0 {
                say("--bench wants a number of frames")
                return 2
            }
        } else if named(option, "--progress") && has_value {
            var percent: f64 = 0.0
            if !parseDecimal(value, &percent) || percent > 100.0 {
                say("--progress wants 0 to 100")
                return 2
            }
            options.*.progress = percent / 100.0
        } else if named(option, "--status") && has_value {
            options.*.status = value
            options.*.hasStatus = true
        } else if named(option, "--message") && has_value {
            options.*.message = value
        } else {
            usage()
            return 2
        }
        index += 2
    }
    return 0
}

fn savePng(scene: *Scene, path: [*]const u8, allocator: std.allocator.Allocator) -> bool {
    return png.saveFile(path, scene.*.frame.pixels, scene.*.width, scene.*.height, scene.*.frame.stride, false, allocator)
}

// DIR/frame-NNNN.png, NUL-terminated, into `path`.
fn framePath(path: *[1024]u8, directory: []const u8, number: usize) -> bool {
    if directory.length > 1000 { return false }
    var at: usize = 0
    while at < directory.length {
        path.*[at] = directory[at]
        at += 1
    }
    const name = "/frame-"
    var index: usize = 0
    while index < name.length {
        path.*[at] = name[index]
        at += 1
        index += 1
    }
    var divisor: usize = 1000
    while divisor > 0 {
        path.*[at] = @intCast(u8, 48 + (number / divisor) % 10)
        at += 1
        divisor = divisor / 10
    }
    const suffix = ".png"
    index = 0
    while index < suffix.length {
        path.*[at] = suffix[index]
        at += 1
        index += 1
    }
    path.*[at] = 0
    return true
}

fn seconds() -> f64 {
    return paint.toFloat(@intCast(usize, std.time.monotonicNanoseconds())) / 1000000000.0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var options: Options = undefined
    const status = parseOptions(arguments, &options)
    if status != 0 { return if status == 1 { 0 } else { status } }
    const memory = allocator.alloc(@sizeOf(Scene), 16)
    if memory == null {
        say("out of memory")
        return 1
    }
    var scene: *Scene = undefined
    unsafe { scene = @ptrCast(*Scene, memory.?) }
    const started = seconds()
    if !scene_module.init(scene, options.width, options.height, options.mode, allocator) {
        say("out of memory for the picture")
        return 1
    }
    if options.hasStatus { scene_module.setStatus(scene, options.status) }
    if options.message.length > 0 { scene_module.setMessage(scene, options.message) }
    scene_module.setProgress(scene, options.progress)
    const set_up = seconds() - started

    if options.hasPng {
        // A run up to the moment, so eased values are where they would be.
        var time: f64 = 0.0
        while time + 0.1 < options.at {
            scene_module.draw(scene, time)
            time += 0.1
        }
        scene_module.draw(scene, options.at)
        if !savePng(scene, options.png, allocator) {
            say("the PNG could not be written")
            return 1
        }
        return 0
    }
    if options.hasFrames {
        var number: usize = 0
        while number < options.count {
            scene_module.draw(scene, paint.toFloat(number) / paint.toFloat(options.fps))
            var path: [1024]u8 = undefined
            if !framePath(&path, options.framesDirectory, number) {
                say("--frames: the directory's name is too long")
                return 2
            }
            var pointer: [*]const u8 = undefined
            unsafe { pointer = @ptrCast([*]const u8, &path) }
            if !savePng(scene, pointer, allocator) {
                say("a frame could not be written")
                return 1
            }
            number += 1
        }
        return 0
    }
    if options.bench > 0 {
        const begun = seconds()
        var number: usize = 0
        while number < options.bench {
            scene_module.draw(scene, 2.5 + paint.toFloat(number) / 30.0)
            number += 1
        }
        const each = (seconds() - begun) * 1000.0 / paint.toFloat(options.bench)
        const out = std.io.stdout()
        var ok = std.io.writeAll(out, "set up: ")
        ok = std.io.writeUnsigned(out, @intCast(usize, paint.round(set_up * 1000.0)))
        ok = std.io.writeAll(out, " ms, frame: ")
        ok = std.io.writeUnsigned(out, @intCast(usize, paint.round(each * 1000.0)))
        ok = std.io.writeAll(out, " us\n")
        return 0
    }
    usage()
    return 2
}
