// mlx-splash: the boot splash. As a daemon it shows the MLX picture on
// the screen while the system starts or stops and takes Plymouth's
// requests (daemon.mlx); with --png, --frames or --bench it draws the
// picture into files or times it (preview.mlx).
const std = @import("std")
const options_module = @import("./options.mlx")
const preview = @import("./preview.mlx")
const daemon = @import("./daemon.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    var options: options_module.Options = undefined
    const status = options_module.parse(arguments, &options)
    if status != 0 { return if status == 1 { 0 } else { status } }
    if options_module.isPreview(&options) { return preview.run(&options) }
    return daemon.run(&options, arguments)
}
