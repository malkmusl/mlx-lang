// Under the letters: what the system is doing, in corner brackets, a
// message over it when there is one, and the progress bar (a dark track
// with a border, the fill cyan into blue with a glowing head). The bar's
// track and colours are made once (prepare) and laid over each frame.
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const paint = @import("./paint.mlx")
const state = @import("./state.mlx")
const captions = @import("./captions.mlx")

const Scene = state.Scene
const Surface = state.Surface

// Where the bar goes, its track and its fill's colours; false without
// memory.
pub fn prepare(scene: *Scene) -> bool {
    const unit = scene.*.unit
    scene.*.barWidth = unit * 5.0
    scene.*.barHeight = paint.clamp(unit * 0.12, 5.0, 32.0)
    scene.*.barX = scene.*.cx - scene.*.barWidth / 2.0
    scene.*.barY = scene.*.cy + unit * 3.85
    scene.*.barLeft = paint.toInt(paint.floor(scene.*.barX)) - 2
    scene.*.barTop = paint.toInt(paint.floor(scene.*.barY)) - 2
    scene.*.barColumns = @intCast(usize, paint.toInt(scene.*.barWidth)) + 6
    scene.*.barRows = @intCast(usize, paint.toInt(scene.*.barHeight)) + 6
    const count = scene.*.barColumns * scene.*.barRows
    const track_memory = scene.*.allocator.alloc(count * 4, 4)
    const colour_memory = scene.*.allocator.alloc(count * 4, 4)
    if track_memory == null || colour_memory == null { return false }
    unsafe {
        scene.*.barTrack = @ptrCast([*]u32, track_memory.?)
        scene.*.barColours = @ptrCast([*]u32, colour_memory.?)
    }
    const x = scene.*.barX
    const y = scene.*.barY
    const width = scene.*.barWidth
    const height = scene.*.barHeight
    const border = paint.rgb(70, 82, 132)
    const dark = paint.rgb(12, 14, 30)
    var row: usize = 0
    while row < scene.*.barRows {
        const py = paint.signedFloat(scene.*.barTop + @intCast(i64, row)) + 0.5
        const v = paint.clamp((py - y) / height, 0.0, 1.0)
        var column: usize = 0
        while column < scene.*.barColumns {
            const px = paint.signedFloat(scene.*.barLeft + @intCast(i64, column)) + 0.5
            const outer = coverage(px, py, x - 1.5, y - 1.5, width + 3.0, height + 3.0)
            const inner = coverage(px, py, x, y, width, height)
            var track = paint.premultiplied(border, alphaOf(outer * 0.85))
            track = paint.layer(track, paint.premultiplied(dark, alphaOf(inner * 0.92)))
            const at = row * scene.*.barColumns + column
            scene.*.barTrack[at] = track
            // The fill: cyan into blue over its first 600 pixels, lighter
            // along its top as glass is.
            var colour = paint.mix(paint.rgb(108, 232, 255), paint.rgb(84, 150, 255), paint.clamp((px - x) / 600.0, 0.0, 1.0))
            colour = paint.mix(colour, paint.rgb(220, 250, 255), (1.0 - v) * 0.35)
            scene.*.barColours[at] = colour
            column += 1
        }
        row += 1
    }
    return true
}

fn alphaOf(fraction: f64) -> u32 { return @intCast(u32, paint.toInt(paint.clamp(fraction, 0.0, 1.0) * 255.0 + 0.5)) }

// How much of the pixel centred at (px, py) a bar with round ends covers
// (one pixel of smooth edge).
fn coverage(px: f64, py: f64, x: f64, y: f64, width: f64, height: f64) -> f64 {
    const radius = height / 2.0
    var cx = px
    if cx < x + radius { cx = x + radius }
    if cx > x + width - radius { cx = x + width - radius }
    const dx = px - cx
    const dy = py - (y + radius)
    // Between the round ends only the distance from the middle line
    // counts.
    const d = if dx == 0.0 { if dy < 0.0 { -dy } else { dy } } else { paint.sqrt(dx * dx + dy * dy) }
    return paint.clamp(radius - d + 0.5, 0.0, 1.0)
}

// What is starting, in corner brackets, the message over it and the bar.
pub fn draw(scene: *Scene, time: f64, shown: f64) -> void {
    if shown <= 0.0 { return }
    const unit = scene.*.unit
    const text_size = paint.clamp(unit * 0.17, 10.0, 64.0)
    if scene.*.text.loaded && scene.*.statusLength > 0 {
        var status: []const u8 = undefined
        unsafe { status = @ptrCast([*]const u8, &scene.*.status)[0..scene.*.statusLength] }
        const width = state.measure(&scene.*.text, status)
        const text_x = scene.*.cx - width / 2.0
        const text_y = scene.*.barY - unit * 0.6
        captions.draw(scene, &scene.*.text, status, text_x, text_y, canvas_module.color(@intCast(u32, paint.toInt(shown * 240.0)), 218, 226, 255))
        brackets(scene, text_x - unit * 0.22, text_y - unit * 0.07, width + unit * 0.44, text_size + unit * 0.14, shown)
    }
    if scene.*.text.loaded && scene.*.messageLength > 0 {
        var message: []const u8 = undefined
        unsafe { message = @ptrCast([*]const u8, &scene.*.message)[0..scene.*.messageLength] }
        const width = state.measure(&scene.*.text, message)
        captions.draw(scene, &scene.*.text, message, scene.*.cx - width / 2.0, scene.*.barY - unit * 1.1, canvas_module.color(@intCast(u32, paint.toInt(shown * 255.0)), 236, 238, 255))
    }
    if scene.*.showProgress {
        // Drawn in the bands (drawBar), its head's glow reaching above and
        // below it.
        const reach = @intCast(i64, scene.*.nodeHalo.radius) + 1
        const command = paint.record(&scene.*.frame, state.BAR, scene.*.barTop - reach, scene.*.barTop + @intCast(i64, scene.*.barRows) + reach)
        if command != null {
            command.?.*.x = time
            command.?.*.strength = shown
        }
    }
}

fn brackets(scene: *Scene, x: f64, y: f64, width: f64, height: f64, shown: f64) -> void {
    const arm = scene.*.unit * 0.12
    const colour = paint.rgb(130, 180, 255)
    const k = 0.7 * shown
    const frame = &scene.*.frame
    paint.line(frame, x, y, x + arm, y, colour, k)
    paint.line(frame, x, y, x, y + arm, colour, k)
    paint.line(frame, x + width, y + height, x + width - arm, y + height, colour, k)
    paint.line(frame, x + width, y + height, x + width, y + height - arm, colour, k)
    paint.line(frame, x + width, y, x + width - arm * 0.5, y, colour, k * 0.6)
    paint.line(frame, x, y + height, x + arm * 0.5, y + height, colour, k * 0.6)
}

// The bar on `frame` (a band of the frame): the track, the fill, its head.
pub fn drawBar(scene: *Scene, frame: *Surface, time: f64, shown: f64) -> void {
    const k = paint.weight(shown)
    const fill = scene.*.barWidth * paint.clamp(scene.*.shownProgress, 0.0, 1.0)
    const x = scene.*.barX
    const y = scene.*.barY
    const height = scene.*.barHeight
    const radius = height / 2.0
    // The rows and columns within the clip (a band of the frame).
    const columns = @intCast(i64, scene.*.barColumns)
    const rows = @intCast(i64, scene.*.barRows)
    const first_row = if scene.*.barTop < frame.*.clipTop { frame.*.clipTop - scene.*.barTop } else { 0 }
    const end_row = if scene.*.barTop + rows > frame.*.clipBottom { frame.*.clipBottom - scene.*.barTop } else { rows }
    const first_column = if scene.*.barLeft < frame.*.clipLeft { frame.*.clipLeft - scene.*.barLeft } else { 0 }
    const end_column = if scene.*.barLeft + columns > frame.*.clipRight { frame.*.clipRight - scene.*.barLeft } else { columns }
    // The fill reaches no further than the pixel centred before its end.
    var fill_end = paint.toInt(x + fill + 1.0 - paint.signedFloat(scene.*.barLeft)) + 1
    if fill_end > end_column { fill_end = end_column }
    var row = first_row
    while row < end_row {
        const sy = scene.*.barTop + row
        const py = paint.signedFloat(sy) + 0.5
        const line = @intCast(usize, sy) * frame.*.stride + @intCast(usize, scene.*.barLeft)
        const from_line = @intCast(usize, row) * scene.*.barColumns
        var column = first_column
        while column < end_column {
            var track = scene.*.barTrack[from_line + @intCast(usize, column)]
            if track != 0 {
                if k < 256 { track = paint.fadePremultiplied(track, k) }
                const at = line + @intCast(usize, column)
                frame.*.pixels[at] = paint.overPremultiplied(frame.*.pixels[at], track)
            }
            column += 1
        }
        if fill >= 1.0 {
            // The fill's coverage between its round ends, the same along a
            // row.
            const middle = coverage(x + fill / 2.0, py, x, y, fill, height)
            column = first_column
            while column < fill_end {
                const px = paint.signedFloat(scene.*.barLeft + column) + 0.5
                if px < x + fill + 1.0 {
                    const cover = if px > x + radius + 1.0 && px < x + fill - radius - 1.0 { middle } else { coverage(px, py, x, y, fill, height) }
                    if cover > 0.0 {
                        const at = line + @intCast(usize, column)
                        frame.*.pixels[at] = paint.overPixel(frame.*.pixels[at], scene.*.barColours[from_line + @intCast(usize, column)], @intCast(u32, paint.toInt(cover * shown * 255.0)))
                    }
                }
                column += 1
            }
        }
        row += 1
    }
    paint.markClipped(frame, scene.*.barLeft, scene.*.barTop, scene.*.barLeft + @intCast(i64, scene.*.barColumns) - 1, scene.*.barTop + @intCast(i64, scene.*.barRows) - 1)
    // The fill's head glows, and a shimmer runs along the fill while it
    // waits.
    if fill >= 1.0 {
        const middle_y = y + height / 2.0
        paint.glow(frame, &scene.*.nodeHalo, x + fill, middle_y, paint.rgb(90, 200, 255), 0.35 * shown)
        paint.glow(frame, &scene.*.nodeCore, x + fill, middle_y, paint.rgb(200, 245, 255), 0.6 * shown)
        const shimmer = x + scene.*.barWidth * ((time * 0.35) - paint.floor(time * 0.35))
        if shimmer < x + fill { paint.glow(frame, &scene.*.halo, shimmer, middle_y, paint.rgb(160, 230, 255), 0.5 * shown) }
    }
}
