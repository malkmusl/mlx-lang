// ignition on brixOS: the boot screen. The picture (scene.mlx, the same
// as on Linux) goes to /devices/framebuffer (its geometry read, its pixels
// mapped by node_map); what is happening comes from the init on the
// splash's input (Plymouth's bytes as impulse sends them: "U" the service
// starting, "u" the progress in percent, "C" another mode, "M"/"m" a
// message, "Q" quit, keeping the picture when its argument's first byte is
// set), each answered with one byte (ACK 6, NAK 21) on its output. The
// frames are paced as the daemon's (at most `--fps` a second, never more
// than a third of the processor where there is only one); the loop is one
// wait on the input and the frame's deadline. When the input ends (the init gone), the splash
// quits as if told to. Told to quit with its picture staying, it hands
// its last frame to the program that takes the screen next (picture.mlx:
// a file in /temporary, written from the frame's own memory), which
// fades in from it without reading the display back.
//
//     mlx4 --target=x86_64-brixos projects/desktop/splash/brixos.mlx -o ignition
//     ignition [--mode boot|shutdown|reboot|updates] [--fps N] [--snapshot PNG] [--screen WIDTH:HEIGHT]
//
// `--snapshot PNG` writes the last frame when it quits (a check reads it);
// `--screen 32:9` says the screen's shape where the kernel's word is not
// the one wanted (drawnWidth).
// What it is told is noted on its errors (the serial console): "up",
// "starting NAME", "message: TEXT", "told to quit".
const std = @import("std")
const crash = @import("std.crash")
const brix = std.os.brix
const png = @import("std.png")
const math = @import("std.math")
const paint = @import("./paint.mlx")
const scene_module = @import("./scene.mlx")
const state = @import("./state.mlx")
const bands = @import("./bands.mlx")
const options_module = @import("./options.mlx")
const picture = @import("./picture.mlx")

const Scene = scene_module.Scene
const Allocator = std.allocator.Allocator

const ACK: u8 = 6
const NAK: u8 = 21
const FADE: f64 = 0.35
const BUFFER_SIZE: usize = 1024

const Splash = struct {
    allocator: Allocator
    scene: *Scene
    framebuffer: brix.Handle
    address: usize
    width: usize
    height: usize
    pitch: usize
    swap: bool
    // The shape of the screen the display's picture is shown on, as a
    // width and a height (the kernel's word, or --screen's).
    shapeWidth: usize
    shapeHeight: usize
    input: brix.Handle
    output: brix.Handle
    // The request bytes not yet whole.
    buffer: [BUFFER_SIZE]u8
    length: usize
    started: f64
    interval: f64
    // What a frame is taken to cost (drawFrame), when the next one is due,
    // and how many times a frame's cost one period is at least (the
    // processor's share the animation leaves: see step).
    frameCost: f64
    lastFrame: f64
    due: f64
    share: f64
    // What the frames cost, for the line the splash says when it ends:
    // how many, the seconds spent drawing them and putting them on the
    // display, and the longest one.
    frames: usize
    drawn: f64
    shown: f64
    longest: f64
    held: u64
    quitting: bool
    retain: bool
    drawing: bool
    snapshot: [*]const u8
    hasSnapshot: bool
}

fn say(text: []const u8) -> void { _ = brix.write(brix.ofDescriptor(2), text, brix.STREAM) }

// A line on stderr (the init's: the serial console): what the splash was
// told, so a check sees the way from impulsectl to the screen.
fn note(first: []const u8, second: []const u8, third: []const u8) -> void {
    var line: [320]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 320, first)
    length = std.text.append(bytes, length, 320, second)
    length = std.text.append(bytes, length, 320, third)
    length = std.text.append(bytes, length, 320, "\n")
    say(bytes[0..length])
}

fn seconds() -> f64 {
    const nanoseconds: f64 = @floatFromInt(f64, @intCast(i64, brix.clock(brix.Clock.MONOTONIC)))
    return nanoseconds / 1000000000.0
}

fn now(splash: *Splash) -> f64 { return seconds() - splash.*.started }

fn word(bytes: [*]const u8, at: usize) -> usize {
    var value: usize = 0
    var k: usize = 8
    while k > 0 {
        k -= 1
        value = (value << 8) | @intCast(usize, bytes[at + k])
    }
    return value
}

// The display: its geometry, its pixels mapped.
fn openDisplay(splash: *Splash) -> bool {
    const opened = brix.open(0, "/devices/framebuffer", brix.Open.READ | brix.Open.WRITE, 0)
    if opened < 0 { return false }
    splash.*.framebuffer = @intCast(u32, opened)
    var record: [48]u8 = undefined
    const got = brix.read(splash.*.framebuffer, record[0..48], 0)
    if got < 32 { return false }
    const words: [*]const u8 = &record
    splash.*.width = word(words, 0)
    splash.*.height = word(words, 8)
    splash.*.pitch = word(words, 16)
    // 1: blue first (the frame's words as they are), 2: red first.
    splash.*.swap = word(words, 24) == 2
    if splash.*.width == 0 || splash.*.height == 0 { return false }
    // The screen's shape, unless the command line said it: the kernel's
    // word (the monitor's own mode), the picture's own where it has none.
    if splash.*.shapeWidth == 0 {
        splash.*.shapeWidth = splash.*.width
        splash.*.shapeHeight = splash.*.height
        if got >= 48 && word(words, 32) != 0 && word(words, 40) != 0 {
            splash.*.shapeWidth = word(words, 32)
            splash.*.shapeHeight = word(words, 40)
        }
    }
    const mapped = brix.mapNode(splash.*.framebuffer, 0, splash.*.pitch * splash.*.height)
    if mapped < 0 { return false }
    splash.*.address = @bitCast(usize, mapped)
    return true
}

// How many pixels across the picture is drawn in: the display's, or, on a
// screen wider in shape than the display's mode, as many as give a
// picture of the mode's height the screen's shape. A card's firmware
// often has no mode of a wide monitor's shape; the monitor stretches the
// one it gets across the screen, and what was drawn round is an ellipse.
// Drawn for the screen's shape and brought to the mode's width on the way
// out (paint.squeezeOut), it is round again. Shapes within a fiftieth of
// each other count as one (1366x768 on a 16:9 screen); a screen narrower
// than its mode is left as it is (the rows would have to be brought
// together: no monitor met so far is driven that way); four times the
// display's width at most.
fn drawnWidth(width: usize, height: usize, shape_width: usize, shape_height: usize) -> usize {
    if shape_width == 0 || shape_height == 0 || shape_width > 65535 || shape_height > 65535 { return width }
    const wide = (height * shape_width + shape_height / 2) / shape_height
    if wide * 50 <= width * 51 { return width }
    if wide > width * 4 { return width * 4 }
    return wide
}

fn drawFrame(splash: *Splash, time: f64) -> void {
    const begun = seconds()
    const scene = splash.*.scene
    scene.*.targetAddress = 0
    scene_module.draw(scene, time)
    const composed = seconds()
    if splash.*.drawing {
        state.copyFrame(scene, splash.*.address, splash.*.pitch, splash.*.held, splash.*.swap)
        splash.*.held = scene.*.frameNumber
    }
    const done = seconds()
    // What a frame costs, for the pace: the time this one took, but one
    // that took much longer than the last (the splash was kept waiting:
    // for the kernel, for its turn on the processor) counts only a
    // little more. Taken at its word, a single stall of a tenth of a
    // second made the next frame wait two tenths.
    const cost = done - begun
    splash.*.frameCost = if splash.*.frames == 0 || cost < splash.*.frameCost { cost } else { math.min(cost, splash.*.frameCost * 1.25 + 0.0005) }
    splash.*.lastFrame = time
    splash.*.frames += 1
    splash.*.drawn += composed - begun
    splash.*.shown += done - composed
    if done - begun > splash.*.longest { splash.*.longest = done - begun }
}

// `value` with one decimal place onto `line` (milliseconds, seconds).
fn appendTenths(line: [*]u8, length: usize, capacity: usize, value: f64) -> usize {
    const tenths = @intCast(usize, paint.toInt(value * 10.0 + 0.5))
    var at = std.text.appendUnsigned(line, length, capacity, tenths / 10)
    at = std.text.append(line, at, capacity, ".")
    return std.text.appendUnsigned(line, at, capacity, tenths % 10)
}

// What the animation cost, on the splash's errors when it ends: on a
// machine where it stutters this says whether the frames are slow to
// draw, slow to reach the display, or few because the splash was kept
// waiting (frames a second well under what was asked with cheap frames).
//
//     ignition: 3840x1080, 281 frames in 9.4 s (29.8 a second); a frame: 3.1 ms to draw, 0.9 ms to the display, 14.0 ms at most
fn report(splash: *Splash) -> void {
    if splash.*.frames == 0 { return }
    const elapsed = seconds() - splash.*.started
    const count = paint.toFloat(splash.*.frames)
    var line: [320]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 320, "ignition: ")
    length = std.text.appendUnsigned(bytes, length, 320, splash.*.width)
    length = std.text.append(bytes, length, 320, "x")
    length = std.text.appendUnsigned(bytes, length, 320, splash.*.height)
    length = std.text.append(bytes, length, 320, ", ")
    length = std.text.appendUnsigned(bytes, length, 320, splash.*.frames)
    length = std.text.append(bytes, length, 320, " frames in ")
    length = appendTenths(bytes, length, 320, elapsed)
    length = std.text.append(bytes, length, 320, " s (")
    length = appendTenths(bytes, length, 320, if elapsed > 0.0 { count / elapsed } else { 0.0 })
    length = std.text.append(bytes, length, 320, " a second); a frame: ")
    length = appendTenths(bytes, length, 320, splash.*.drawn * 1000.0 / count)
    length = std.text.append(bytes, length, 320, " ms to draw, ")
    length = appendTenths(bytes, length, 320, splash.*.shown * 1000.0 / count)
    length = std.text.append(bytes, length, 320, " ms to the display, ")
    length = appendTenths(bytes, length, 320, splash.*.longest * 1000.0)
    length = std.text.append(bytes, length, 320, " ms at most\n")
    say(bytes[0..length])
}

fn answer(splash: *Splash, byte: u8) -> void {
    var bytes: [1]u8 = [1]u8{ byte }
    _ = brix.write(splash.*.output, bytes[0..1], brix.STREAM)
}

// One request handled (its argument, when it has one, NUL-terminated in
// the buffer).
fn handle(splash: *Splash, command: u8, argument: []const u8) -> void {
    const scene = splash.*.scene
    var reply = ACK
    if command == 85 {
        scene_module.setUnit(scene, argument)
        note("ignition: ", if scene.*.mode == state.Mode.boot { "starting " } else { "stopping " }, argument)
    } else if command == 117 {
        var percent: usize = 0
        if options_module.parseNumber(argument, &percent) && percent <= 100 {
            scene_module.setProgress(scene, paint.toFloat(percent) / 100.0)
            scene.*.showProgress = true
        }
    } else if command == 67 {
        var mode = scene.*.mode
        if options_module.parseMode(argument, &mode) { scene_module.setMode(scene, mode) }
    } else if command == 77 {
        scene_module.setMessage(scene, argument)
        note("ignition: ", "message: ", argument)
    } else if command == 109 {
        scene_module.hideMessage(scene, argument)
        note("ignition: ", "message taken away", "")
    } else if command == 81 {
        note("ignition: ", "told to quit", if argument.length > 0 && argument[0] != 0 { ", the picture stays" } else { "" })
        splash.*.retain = splash.*.retain || (argument.length > 0 && argument[0] != 0)
        splash.*.quitting = true
        // Answered when done (finish).
        return
    } else if command == 80 || command == 83 || command == 108 || command == 33 || command == 65 || command == 97 || command == 36 || command == 72 {
        // Ping, system initialized, reload, an error, pause, unpause,
        // show, hide: nothing to do here.
    } else {
        reply = NAK
    }
    answer(splash, reply)
}

// The whole requests in the buffer, handled and taken out.
fn parse(splash: *Splash) -> void {
    while splash.*.length >= 2 && !splash.*.quitting {
        const command = splash.*.buffer[0]
        var used: usize = 2
        var argument: []const u8 = ""
        if splash.*.buffer[1] == 2 {
            if splash.*.length < 3 { return }
            const size = @intCast(usize, splash.*.buffer[2])
            if size == 0 {
                used = 3
            } else {
                if splash.*.length < 3 + size { return }
                argument = splash.*.buffer[3..3 + size - 1]
                used = 3 + size
            }
        } else if splash.*.buffer[1] != 0 {
            // Not a request: the rest is dropped.
            splash.*.length = 0
            return
        }
        handle(splash, command, argument)
        const rest = splash.*.length - used
        var move: usize = 0
        while move < rest {
            splash.*.buffer[move] = splash.*.buffer[used + move]
            move += 1
        }
        splash.*.length = rest
    }
}

// What came on the input: requests; its end means quit.
fn readInput(splash: *Splash) -> void {
    const room = BUFFER_SIZE - splash.*.length
    if room == 0 {
        splash.*.length = 0
        return
    }
    const got = brix.read(splash.*.input, splash.*.buffer[splash.*.length..BUFFER_SIZE], brix.STREAM)
    if got == -brix.Status.would_block { return }
    if got <= 0 {
        splash.*.quitting = true
        return
    }
    splash.*.length += @bitCast(usize, got)
    parse(splash)
}

// One turn of the loop: a frame when one is due, then the wait for the
// next one or for a request.
//
// A frame is due a period after the one before WAS DUE: `share` times a
// frame's cost (the animation takes no more than its share of a
// processor: a third where there is one, most of one where the boot's
// work has others), 1/fps at least. Counted from when the frame was due,
// not from when it was done or when the splash woke: the frame's own
// cost came on top of every period before (30 a second could not be
// reached at any cost), and a wake that comes late (the kernel wakes a
// waiter on its tick) pushed every later frame back. Only a splash that
// fell a whole period behind starts its count anew.
fn step(splash: *Splash) -> void {
    const time = now(splash)
    const first = splash.*.lastFrame < 0.0
    if first || time >= splash.*.due {
        drawFrame(splash, time)
        const period = math.clamp(splash.*.share * splash.*.frameCost, splash.*.interval, 1.0)
        const from = if first || time - splash.*.due > period { time } else { splash.*.due }
        splash.*.due = from + period
    }
    var wait = splash.*.due - now(splash)
    if wait < 0.0 { wait = 0.0 }
    var items: [1]brix.WaitItem = undefined
    items[0] = brix.WaitItem.{ .handle = splash.*.input, .want = brix.State.READABLE | brix.State.PEER_GONE, .seen = 0, .reserved = 0 }
    const deadline = brix.clock(brix.Clock.MONOTONIC) + @intCast(usize, paint.toInt(wait * 1000000000.0)) + 1
    const ready = brix.wait(items[0..1], deadline)
    if ready > 0 && items[0].seen & (brix.State.READABLE | brix.State.PEER_GONE) != 0 { readInput(splash) }
}

// The end: the last frame as a PNG when asked, faded out unless the
// picture is to stay (then it is left for the program that takes the
// screen: the frame as the display holds it, if one was drawn), the quit
// answered.
fn finish(splash: *Splash) -> void {
    const scene = splash.*.scene
    const time = now(splash)
    if splash.*.hasSnapshot {
        if !png.saveFile(splash.*.snapshot, scene.*.frame.pixels, scene.*.width, scene.*.height, scene.*.frame.stride, false, splash.*.allocator) { say("ignition: the snapshot could not be written\n") }
    }
    if !splash.*.retain && splash.*.drawing {
        scene_module.setProgress(scene, 1.0)
        const begun = seconds()
        var faded = false
        while !faded {
            const elapsed = seconds() - begun
            faded = elapsed >= FADE
            scene_module.setBrightness(scene, if faded { 0.0 } else { 1.0 - elapsed / FADE })
            drawFrame(splash, time + elapsed)
        }
    }
    report(splash)
    if splash.*.retain && splash.*.drawing && splash.*.held != 0 {
        var left = false
        if scene.*.shownWidth < scene.*.width {
            // (As the display holds it: at the display's width.)
            const shown = splash.*.allocator.alloc(splash.*.width * splash.*.height * 4, 16)
            if shown != null {
                paint.squeezeOut(&scene.*.frame, @intFromPtr(shown.?), splash.*.width * 4, 0, 0, scene.*.width, scene.*.height, false, splash.*.width)
                left = picture.leave(@intFromPtr(shown.?), splash.*.width, splash.*.height, splash.*.width * 4, picture.BLUE_FIRST)
            }
        } else {
            left = picture.leave(@intFromPtr(scene.*.frame.pixels), scene.*.width, scene.*.height, scene.*.frame.stride * 4, picture.BLUE_FIRST)
        }
        if !left { say("ignition: the picture could not be left for the next program\n") }
    }
    answer(splash, ACK)
}

// "WIDTH:HEIGHT" (digits, both more than nothing); false when it is not.
fn parseShape(text: []const u8, width: *usize, height: *usize) -> bool {
    var colon: usize = 0
    while colon < text.length && text[colon] != 58 { colon += 1 }
    if colon == 0 || colon + 1 >= text.length { return false }
    var wide: usize = 0
    var high: usize = 0
    if !options_module.parseNumber(text[0..colon], &wide) || !options_module.parseNumber(text[colon + 1..text.length], &high) { return false }
    if wide == 0 || high == 0 || wide > 65535 || high > 65535 { return false }
    width.* = wide
    height.* = high
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const splash_memory = allocator.alloc(@sizeOf(Splash), 16)
    const scene_memory = allocator.alloc(@sizeOf(Scene), 16)
    const crew_memory = allocator.alloc(@sizeOf(state.Crew), 16)
    if splash_memory == null || scene_memory == null || crew_memory == null {
        say("ignition: out of memory\n")
        return 1
    }
    var splash: *Splash = undefined
    unsafe {
        splash = @ptrCast(*Splash, splash_memory.?)
        splash.*.scene = @ptrCast(*Scene, scene_memory.?)
        splash.*.scene.*.crew = @ptrCast(*state.Crew, crew_memory.?)
    }
    splash.*.allocator = allocator
    splash.*.length = 0
    splash.*.frameCost = 0.0
    splash.*.lastFrame = -1.0
    splash.*.due = 0.0
    // (The boot's work has the other processors where there are some.)
    var machine: brix.SystemInfo = undefined
    const figures = brix.systemInfo(&machine)
    splash.*.share = if figures >= 3 && machine.processors > 1 { 1.25 } else { 3.0 }
    splash.*.held = 0
    splash.*.frames = 0
    splash.*.drawn = 0.0
    splash.*.shown = 0.0
    splash.*.longest = 0.0
    splash.*.quitting = false
    splash.*.retain = false
    splash.*.hasSnapshot = false
    splash.*.shapeWidth = 0
    splash.*.shapeHeight = 0
    var mode = state.Mode.boot
    var fps: usize = 30
    const count = std.process.count(arguments)
    var k: usize = 1
    while k < count {
        const argument = std.string.asSlice(std.process.argument(arguments, k))
        if std.text.same(argument, "--mode") && k + 1 < count {
            k += 1
            if !options_module.parseMode(std.string.asSlice(std.process.argument(arguments, k)), &mode) {
                say("ignition: the mode is boot, shutdown, reboot or updates\n")
                return 2
            }
        } else if std.text.same(argument, "--fps") && k + 1 < count {
            k += 1
            if !options_module.parseNumber(std.string.asSlice(std.process.argument(arguments, k)), &fps) || fps == 0 || fps > 120 {
                say("ignition: --fps takes 1 to 120\n")
                return 2
            }
        } else if std.text.same(argument, "--snapshot") && k + 1 < count {
            k += 1
            splash.*.snapshot = std.process.argument(arguments, k).pointer
            splash.*.hasSnapshot = true
        } else if std.text.same(argument, "--screen") && k + 1 < count {
            // The screen's shape, where the monitor does not say it (or
            // says another than the picture is shown in): "32:9".
            k += 1
            if !parseShape(std.string.asSlice(std.process.argument(arguments, k)), &splash.*.shapeWidth, &splash.*.shapeHeight) {
                say("ignition: --screen takes the screen's shape, a width and a height: 32:9\n")
                return 2
            }
        } else {
            say("usage: ignition [--mode boot|shutdown|reboot|updates] [--fps N] [--snapshot PNG] [--screen WIDTH:HEIGHT]\n")
            return 2
        }
        k += 1
    }
    splash.*.interval = 1.0 / paint.toFloat(fps)
    splash.*.input = brix.handleFor(brix.Role.INPUT)
    splash.*.output = brix.handleFor(brix.Role.OUTPUT)
    splash.*.drawing = openDisplay(splash)
    if !splash.*.drawing {
        say("ignition: no display (/devices/framebuffer): answering without a picture\n")
        splash.*.width = 1024
        splash.*.height = 768
    } else {
        // The screen is the splash's now, all of it: whatever picture the
        // program before left for its successor is no longer on it.
        picture.discard()
    }
    // The picture is drawn for the screen's shape (drawnWidth) and goes
    // out at the display's width.
    var drawn = if splash.*.drawing { drawnWidth(splash.*.width, splash.*.height, splash.*.shapeWidth, splash.*.shapeHeight) } else { splash.*.width }
    // The wider picture takes more memory (its two frames are most of
    // it), and the kernel hands memory out before it has it: a program
    // that reaches into more than there is ends there, with no "no" to
    // answer. So only where the two frames are a quarter of the free
    // memory at most; else the picture is as the display's mode is.
    if drawn != splash.*.width && figures >= 2 && drawn * splash.*.height * 8 > machine.free / 4 {
        say("ignition: too little memory free for a picture of the screen's shape: drawn as the display's mode is\n")
        drawn = splash.*.width
    }
    if !scene_module.init(splash.*.scene, drawn, splash.*.height, mode, allocator) {
        // (No memory for the wider picture: as the display's mode is.)
        if drawn == splash.*.width || !scene_module.init(splash.*.scene, splash.*.width, splash.*.height, mode, allocator) {
            say("ignition: out of memory for the picture\n")
            return 1
        }
        drawn = splash.*.width
    }
    splash.*.scene.*.shownWidth = splash.*.width
    if drawn != splash.*.width {
        var line: [200]u8 = undefined
        const bytes: [*]u8 = &line
        var length = std.text.append(bytes, 0, 200, "ignition: the screen's shape is ")
        length = std.text.appendUnsigned(bytes, length, 200, splash.*.shapeWidth)
        length = std.text.append(bytes, length, 200, ":")
        length = std.text.appendUnsigned(bytes, length, 200, splash.*.shapeHeight)
        length = std.text.append(bytes, length, 200, ", the display's mode ")
        length = std.text.appendUnsigned(bytes, length, 200, splash.*.width)
        length = std.text.append(bytes, length, 200, "x")
        length = std.text.appendUnsigned(bytes, length, 200, splash.*.height)
        length = std.text.append(bytes, length, 200, ": drawn ")
        length = std.text.appendUnsigned(bytes, length, 200, drawn)
        length = std.text.append(bytes, length, 200, " wide and brought to the mode's width, so that it is round on the screen\n")
        say(bytes[0..length])
    }
    // No threads on brixOS: the bands are drawn by this one.
    bands.start(splash.*.scene.*.crew, 0, allocator)
    note("ignition: up, ", if mode == state.Mode.boot { "boot" } else if mode == state.Mode.shutdown { "shutdown" } else if mode == state.Mode.reboot { "reboot" } else { "updates" }, if splash.*.drawing { ", on the display" } else { ", no display" })
    splash.*.started = seconds()
    while !splash.*.quitting { step(splash) }
    finish(splash)
    return 0
}
