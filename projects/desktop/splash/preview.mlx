// mlx-splash without a screen: the picture into PNG files (--png at a
// moment, --frames as a sequence, with --story a whole boot) or timed
// (--bench).
const std = @import("std")
const png = @import("std.png")
const turns_module = @import("std.turns")
const paint = @import("./paint.mlx")
const state = @import("./state.mlx")
const scene_module = @import("./scene.mlx")
const bands = @import("./bands.mlx")
const output_module = @import("./output.mlx")
const options_module = @import("./options.mlx")
const system = @import("./system.mlx")

const Scene = scene_module.Scene
const Options = options_module.Options

// The story: systemd starts a unit every UNIT_EVERY seconds from
// FIRST_UNIT on, the bar fills by FULL_AT, the splash is told to quit at
// QUIT_AT and fades out as the daemon's finish does.
const FIRST_UNIT: f64 = 1.1
const UNIT_EVERY: f64 = 0.3
const FULL_AT: f64 = 8.4
const QUIT_AT: f64 = 8.8
const FADE: f64 = 0.35
const STORY_END: f64 = 9.4
const UNIT_COUNT: usize = 24

fn unitName(index: usize) -> []const u8 {
    if index == 0 { return "systemd-journald.service" }
    if index == 1 { return "systemd-udevd.service" }
    if index == 2 { return "systemd-modules-load.service" }
    if index == 3 { return "systemd-sysctl.service" }
    if index == 4 { return "systemd-udev-trigger.service" }
    if index == 5 { return "systemd-tmpfiles-setup.service" }
    if index == 6 { return "systemd-remount-fs.service" }
    if index == 7 { return "systemd-random-seed.service" }
    if index == 8 { return "systemd-timesyncd.service" }
    if index == 9 { return "systemd-resolved.service" }
    if index == 10 { return "mlx-ipcd.service" }
    if index == 11 { return "mlx-netd.service" }
    if index == 12 { return "mlx-audio.service" }
    if index == 13 { return "systemd-logind.service" }
    if index == 14 { return "polkit.service" }
    if index == 15 { return "bluetooth.service" }
    if index == 16 { return "upower.service" }
    if index == 17 { return "cups.service" }
    if index == 18 { return "systemd-user-sessions.service" }
    if index == 19 { return "mlx-observatory-index.service" }
    if index == 20 { return "user-runtime-dir@1000.service" }
    if index == 21 { return "getty@tty2.service" }
    if index == 22 { return "mlx-session.service" }
    return "mlx-compositor.service"
}

// What the splash would have been told by `time` of the story.
fn story(scene: *Scene, time: f64) -> void {
    if time >= FIRST_UNIT {
        var index = @intCast(usize, paint.toInt((time - FIRST_UNIT) / UNIT_EVERY))
        if index >= UNIT_COUNT { index = UNIT_COUNT - 1 }
        scene_module.setUnit(scene, unitName(index))
    }
    scene_module.setProgress(scene, paint.smoothstep(0.4, FULL_AT, time))
    if time >= QUIT_AT { scene_module.setBrightness(scene, 1.0 - (time - QUIT_AT) / FADE) }
}

pub fn savePng(scene: *Scene, path: [*]const u8, allocator: std.allocator.Allocator) -> bool {
    return png.saveFile(path, scene.*.frame.pixels, scene.*.width, scene.*.height, scene.*.frame.stride, false, allocator)
}

// DIR/frame-NNNN.png, NUL-terminated, into `path`.
fn framePath(path: *[1024]u8, directory: []const u8, number: usize) -> bool {
    if directory.length > 1000 { return false }
    var at: usize = 0
    while at < directory.length {
        path.*[at] = directory[at]
        at += 1
    }
    const name = "/frame-"
    var index: usize = 0
    while index < name.length {
        path.*[at] = name[index]
        at += 1
        index += 1
    }
    var divisor: usize = 1000
    while divisor > 0 {
        path.*[at] = @intCast(u8, 48 + (number / divisor) % 10)
        at += 1
        divisor = divisor / 10
    }
    const suffix = ".png"
    index = 0
    while index < suffix.length {
        path.*[at] = suffix[index]
        at += 1
        index += 1
    }
    path.*[at] = 0
    return true
}


fn seconds() -> f64 { return system.seconds() }

pub fn run(options: *const Options) -> u8 {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Scene), 16)
    if memory == null {
        system.say("out of memory")
        return 1
    }
    const crew_memory = allocator.alloc(@sizeOf(state.Crew), 16)
    if crew_memory == null {
        system.say("out of memory")
        return 1
    }
    var scene: *Scene = undefined
    unsafe {
        scene = @ptrCast(*Scene, memory.?)
        scene.*.crew = @ptrCast(*state.Crew, crew_memory.?)
    }
    bands.start(scene.*.crew, if options.*.threads > 0 { options.*.threads - 1 } else { bands.defaultThreads() }, allocator)
    const started = seconds()
    if !scene_module.init(scene, options.*.width, options.*.height, options.*.mode, allocator) {
        system.say("out of memory for the picture")
        return 1
    }
    if options.*.hasStatus { scene_module.setStatus(scene, options.*.status) }
    if options.*.message.length > 0 { scene_module.setMessage(scene, options.*.message) }
    scene_module.setProgress(scene, options.*.progress)
    const set_up = seconds() - started
    // Each frame's values go back at the next (std.turns).
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)

    if options.*.hasPng {
        // A run up to the moment, so eased values are where they would be.
        var time: f64 = 0.0
        while time + 0.1 < options.*.at {
            turns_module.turn(&turns)
            scene_module.draw(scene, time)
            time += 0.1
        }
        scene_module.draw(scene, options.*.at)
        if !savePng(scene, options.*.png, allocator) {
            system.say("the PNG could not be written")
            return 1
        }
        return 0
    }
    if options.*.hasFrames {
        const count = if options.*.story { @intCast(usize, paint.toInt(STORY_END * paint.toFloat(options.*.fps))) + 1 } else { options.*.count }
        var number: usize = 0
        while number < count {
            turns_module.turn(&turns)
            const time = paint.toFloat(number) / paint.toFloat(options.*.fps)
            if options.*.story { story(scene, time) }
            scene_module.draw(scene, time)
            var path: [1024]u8 = undefined
            if !framePath(&path, options.*.framesDirectory, number) {
                system.say("--frames: the directory's name is too long")
                return 2
            }
            var pointer: [*]const u8 = undefined
            unsafe { pointer = @ptrCast([*]const u8, &path) }
            if !savePng(scene, pointer, allocator) {
                system.say("a frame could not be written")
                return 1
            }
            number += 1
        }
        return 0
    }
    if options.*.bench > 0 {
        // Each frame drawn, then copied into one of two buffers as a card's
        // two would take it.
        var output: output_module.Output = undefined
        output_module.init(&output, allocator)
        if !output_module.openMemory(&output, options.*.width, options.*.height) {
            system.say("out of memory for the buffers")
            return 1
        }
        // The output is kept across the frames.
        turns_module.begin(&turns, true, false)
        var drawing: f64 = 0.0
        var number: usize = 0
        while number < options.*.bench {
            turns_module.turn(&turns)
            const begun = seconds()
            output_module.aim(&output, scene)
            scene_module.draw(scene, 2.5 + paint.toFloat(number) / 30.0)
            const shown = output_module.show(&output, scene)
            drawing += seconds() - begun
            number += 1
        }
        const count = paint.toFloat(options.*.bench)
        const out = std.io.stdout()
        var ok = std.io.writeAll(out, "set up: ")
        ok = std.io.writeUnsigned(out, @intCast(usize, paint.round(set_up * 1000.0)))
        ok = std.io.writeAll(out, " ms, frame: ")
        ok = std.io.writeUnsigned(out, @intCast(usize, paint.round(drawing * 1000000.0 / count)))
        ok = std.io.writeAll(out, " us, ")
        ok = std.io.writeUnsigned(out, scene.*.crew.*.threads + 1)
        ok = std.io.writeAll(out, " threads\n")
        return 0
    }
    return 2
}
