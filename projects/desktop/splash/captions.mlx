// Text drawn once: each line the splash shows (what is starting, the
// message, the modules' labels) has its coverage worked out when it first
// shows, and each frame lays that over. Going through the glyphs for every
// pixel of every line each frame cost a tenth of a frame; a line changes a
// few times a second at most.
const std = @import("std")
const tt = @import("std.truetype")
const ui_text = @import("std.ui.text")
const canvas_module = @import("std.ui.canvas")
const paint = @import("./paint.mlx")
const state = @import("./state.mlx")

const Scene = state.Scene
const Caption = state.Caption
const CAPTION_COUNT = state.CAPTION_COUNT

pub fn init(scene: *Scene) -> void {
    var index: usize = 0
    while index < CAPTION_COUNT {
        scene.*.captions[index].font = 0
        scene.*.captions[index].capacity = 0
        scene.*.captions[index].used = 0
        index += 1
    }
}

// `string` in `text` on the frame being recorded, with the top of its line
// at (x, y) as ui_text.drawText puts it, in `color` (premultiplied).
pub fn draw(scene: *Scene, text: *ui_text.Text, string: []const u8, x: f64, y: f64, color: u32) -> void {
    if !text.*.loaded || string.length == 0 || (color >> 24) == 0 { return }
    const index = find(scene, text, string)
    if index >= CAPTION_COUNT { return }
    const caption = &scene.*.captions[index]
    if caption.*.width == 0 { return }
    const left = paint.round(x) + caption.*.left
    const top = paint.round(y) + caption.*.top
    const command = paint.record(&scene.*.frame, state.TEXT, top, top + @intCast(i64, caption.*.height) - 1)
    if command == null { return }
    command.?.*.x = paint.signedFloat(left)
    command.?.*.y = paint.signedFloat(top)
    command.?.*.colour = color
    command.?.*.item = index
}

// The caption saying `string` in `text`: one made before, else made now
// in place of the one least recently drawn (CAPTION_COUNT when there is
// no memory for it).
fn find(scene: *Scene, text: *ui_text.Text, string: []const u8) -> usize {
    const font = @intFromPtr(text)
    var oldest: usize = 0
    var index: usize = 0
    while index < CAPTION_COUNT {
        const caption = &scene.*.captions[index]
        if caption.*.font == font && says(caption, string) {
            caption.*.used = scene.*.frameNumber
            return index
        }
        if caption.*.used < scene.*.captions[oldest].used { oldest = index }
        index += 1
    }
    if !make(scene, &scene.*.captions[oldest], text, string) { return CAPTION_COUNT }
    return oldest
}

fn says(caption: *const Caption, string: []const u8) -> bool {
    const length = if string.length > 200 { 200 } else { string.length }
    if caption.*.length != length { return false }
    var index: usize = 0
    while index < length {
        if caption.*.bytes[index] != string[index] { return false }
        index += 1
    }
    return true
}

// Lays `string` out and keeps the most any glyph covers of each pixel (as
// tt.runCoverage gives it), glyph by glyph.
fn make(scene: *Scene, caption: *Caption, text: *ui_text.Text, string: []const u8) -> bool {
    caption.*.font = 0
    const length = if string.length > 200 { 200 } else { string.length }
    const ignored = ui_text.measure(text, string[0..length])
    var run: *tt.Run = undefined
    var atlas: *tt.Atlas = undefined
    unsafe {
        run = @ptrCast(*tt.Run, &text.*.run)
        atlas = @ptrCast(*tt.Atlas, &text.*.atlas)
    }
    const left = run.*.left
    const top = run.*.top
    const width = if run.*.right > left { @intCast(usize, run.*.right - left) } else { 0 }
    const height = if run.*.bottom > top { @intCast(usize, run.*.bottom - top) } else { 0 }
    const size = width * height
    if size > caption.*.capacity {
        if caption.*.capacity > 0 { scene.*.allocator.free(caption.*.coverage, caption.*.capacity, 1) }
        caption.*.capacity = 0
        const memory = scene.*.allocator.alloc(size, 1)
        if memory == null { return false }
        caption.*.coverage = memory.?
        caption.*.capacity = size
    }
    var at: usize = 0
    while at < size {
        caption.*.coverage[at] = 0
        at += 1
    }
    var index: usize = 0
    while index < run.*.count {
        const quad = run.*.quads[index]
        var row: u32 = 0
        while row < quad.height {
            const target = @intCast(usize, quad.y - top + @intCast(i32, row)) * width + @intCast(usize, quad.x - left)
            const source = (@intCast(usize, quad.atlasY) + @intCast(usize, row)) * @intCast(usize, atlas.*.width) + @intCast(usize, quad.atlasX)
            var column: usize = 0
            while column < @intCast(usize, quad.width) {
                const value = atlas.*.pixels[source + column]
                if value > caption.*.coverage[target + column] { caption.*.coverage[target + column] = value }
                column += 1
            }
            row += 1
        }
        index += 1
    }
    index = 0
    while index < length {
        caption.*.bytes[index] = string[index]
        index += 1
    }
    caption.*.length = length
    caption.*.width = width
    caption.*.height = height
    caption.*.left = @intCast(i64, left)
    caption.*.top = @intCast(i64, text.*.ascent + top)
    caption.*.used = scene.*.frameNumber
    caption.*.font = @intFromPtr(text)
    return true
}

// A caption laid over the surface with its top left at (left, top), as
// ui_text.drawText blends it (std.ui.canvas's over).
pub fn blit(surface: *paint.Surface, caption: *const Caption, left: i64, top: i64, color: u32) -> void {
    const width = @intCast(i64, caption.*.width)
    const height = @intCast(i64, caption.*.height)
    var first_row = if top < surface.*.clipTop { surface.*.clipTop - top } else { 0 }
    var end_row = if top + height > surface.*.clipBottom { surface.*.clipBottom - top } else { height }
    var first_column = if left < surface.*.clipLeft { surface.*.clipLeft - left } else { 0 }
    var end_column = if left + width > surface.*.clipRight { surface.*.clipRight - left } else { width }
    if first_row >= end_row || first_column >= end_column { return }
    var row = first_row
    while row < end_row {
        const line = @intCast(usize, top + row) * surface.*.stride + @intCast(usize, left)
        const from = @intCast(usize, row) * caption.*.width
        var column = first_column
        while column < end_column {
            const coverage = @intCast(u32, caption.*.coverage[from + @intCast(usize, column)])
            if coverage > 0 {
                const at = line + @intCast(usize, column)
                surface.*.pixels[at] = canvas_module.over(surface.*.pixels[at], color, coverage)
            }
            column += 1
        }
        row += 1
    }
    paint.mark(surface, left + first_column, top + first_row, left + end_column - 1, top + end_row - 1)
}
