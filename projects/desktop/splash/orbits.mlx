// What moves round the letters: three rings of light tilted in depth
// (where a ring passes behind the letters it is drawn before them), the
// bright arcs running round them, glints on them, the code graph of the
// Observatory riding them (its coloured modules as nodes, linked as the
// Code Galaxy links them), the dial behind the letters, dust drifting out
// and stars twinkling.
//
// The rings and the dial stand still once they have come in; they are
// drawn into the backdrop then (ringBase, dialStill) and each frame draws
// only what moves.
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const paint = @import("./paint.mlx")
const state = @import("./state.mlx")

const Scene = state.Scene
const Surface = state.Surface
const RING_COUNT = state.RING_COUNT
const NODE_COUNT = state.NODE_COUNT

// How long the bright arc behind each ring's head is (radians).
const ARC_LENGTH: f64 = 1.9

fn twoPi() -> f64 { return 2.0 * paint.pi() }

// Points along a ring 1.2 pixels apart.
fn stepsFor(scene: *Scene, radius: f64) -> usize {
    return @intCast(usize, paint.toInt(twoPi() * radius * scene.*.unit / 1.2)) + 8
}

// A halo every so many points, as far apart as the halo is wide, so they
// run together into one glow at any size; and their strength for that.
fn haloEvery(scene: *Scene) -> usize {
    return @intCast(usize, paint.toInt(paint.toFloat(@intCast(usize, scene.*.halo.radius)) / 1.2)) + 1
}

fn haloStrength(scene: *Scene) -> f64 { return 0.42 * paint.toFloat(haloEvery(scene)) / 6.0 }

// The rings' halves behind the letters (`front` false) or before them,
// without their arcs: a line of sparks with a halo every few points,
// brighter in front. The points go round by turning the last one a step
// (one multiply of cosines and sines, no table).
pub fn ringBase(scene: *Scene, surface: *Surface, appear: f64, front: bool) -> void {
    if appear <= 0.0 { return }
    const halo_every = haloEvery(scene)
    const halo_strength = haloStrength(scene)
    var index: usize = 0
    while index < RING_COUNT {
        const ring = &scene.*.rings[index]
        const radius = state.ringRadius(scene, index, appear)
        const steps = stepsFor(scene, radius)
        const step_angle = twoPi() / paint.toFloat(steps)
        const step_cos = paint.cosine(&scene.*.tables, step_angle)
        const step_sin = paint.sine(&scene.*.tables, step_angle)
        var c: f64 = 1.0
        var s: f64 = 0.0
        var step: usize = 0
        while step < steps {
            var x: f64 = 0.0
            var y: f64 = 0.0
            var z: f64 = 0.0
            state.project(scene, ring, radius, c, s, &x, &y, &z)
            if (z >= 0.0) == front {
                const near = (z / radius + 1.0) * 0.5
                const strength = (0.34 + 0.46 * near) * appear
                paint.spark(surface, x, y, ring.*.colour, strength)
                if step % halo_every == 0 { paint.glow(surface, &scene.*.halo, x, y, ring.*.colour, strength * halo_strength) }
            }
            const next_c = c * step_cos - s * step_sin
            s = s * step_cos + c * step_sin
            c = next_c
            step += 1
        }
        index += 1
    }
}

// The bright arcs running round the rings, from their faint tails to their
// white-hot heads, on the halves behind or before the letters.
pub fn ringArcs(scene: *Scene, time: f64, appear: f64, front: bool) -> void {
    if appear <= 0.0 { return }
    const white = paint.rgb(220, 240, 255)
    const halo_every = haloEvery(scene)
    const halo_strength = haloStrength(scene)
    var index: usize = 0
    while index < RING_COUNT {
        const ring = &scene.*.rings[index]
        const radius = state.ringRadius(scene, index, appear)
        const step_angle = twoPi() / paint.toFloat(stepsFor(scene, radius))
        const head = ring.*.headOffset + ring.*.headSpeed * time
        const forward = ring.*.headSpeed > 0.0
        const start = if forward { head - ARC_LENGTH } else { head + ARC_LENGTH }
        const turn = if forward { step_angle } else { -step_angle }
        const step_cos = paint.cosine(&scene.*.tables, turn)
        const step_sin = paint.sine(&scene.*.tables, turn)
        const count = @intCast(usize, paint.toInt(ARC_LENGTH / step_angle))
        var c = paint.cosine(&scene.*.tables, start)
        var s = paint.sine(&scene.*.tables, start)
        var step: usize = 0
        while step < count {
            var x: f64 = 0.0
            var y: f64 = 0.0
            var z: f64 = 0.0
            state.project(scene, ring, radius, c, s, &x, &y, &z)
            if (z >= 0.0) == front {
                const fall = paint.toFloat(step) / paint.toFloat(count)
                const arc = fall * fall * 1.6
                const strength = arc * appear
                paint.spark(&scene.*.frame, x, y, paint.mix(ring.*.colour, white, paint.clamp(arc * 0.6, 0.0, 0.85)), strength)
                if step % halo_every == 0 { paint.glow(&scene.*.frame, &scene.*.halo, x, y, ring.*.colour, strength * halo_strength) }
            }
            const next_c = c * step_cos - s * step_sin
            s = s * step_cos + c * step_sin
            c = next_c
            step += 1
        }
        index += 1
    }
}

// Glints on the rings, a little above or below each, coming and going.
pub fn sparkles(scene: *Scene, time: f64, appear: f64, front: bool) -> void {
    if appear <= 0.0 { return }
    var index: usize = 0
    while index < state.SPARKLE_COUNT {
        const which = scene.*.sparkleRing[index]
        const ring = &scene.*.rings[which]
        const direction: f64 = if ring.*.headSpeed > 0.0 { 1.0 } else { -1.0 }
        const angle = scene.*.sparkleAngle[index] + time * scene.*.sparkleSpeed[index] * direction
        const radius = (ring.*.radius + scene.*.sparkleLift[index]) * (0.55 + 0.45 * appear)
        var x: f64 = 0.0
        var y: f64 = 0.0
        var z: f64 = 0.0
        state.project(scene, ring, radius, paint.cosine(&scene.*.tables, angle), paint.sine(&scene.*.tables, angle), &x, &y, &z)
        if (z >= 0.0) == front {
            const level = 0.5 + 0.5 * paint.sine(&scene.*.tables, time * 1.9 + scene.*.sparklePhase[index])
            const strength = level * level * appear * (0.5 + 0.5 * (z / radius + 1.0) * 0.5)
            paint.spark(&scene.*.frame, x, y, paint.rgb(200, 225, 255), strength)
            if index % 2 == 0 { paint.glow(&scene.*.frame, &scene.*.dust, x, y, ring.*.colour, strength * 0.6) }
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// The code graph

pub fn placeNodes(scene: *Scene, time: f64, appear: f64) -> void {
    var index: usize = 0
    while index < NODE_COUNT {
        const node = &scene.*.nodes[index]
        const radius = state.ringRadius(scene, node.*.ring, appear)
        const angle = node.*.offset + node.*.speed * time
        var x: f64 = 0.0
        var y: f64 = 0.0
        var z: f64 = 0.0
        state.project(scene, &scene.*.rings[node.*.ring], radius, paint.cosine(&scene.*.tables, angle), paint.sine(&scene.*.tables, angle), &x, &y, &z)
        node.*.x = x
        node.*.y = y
        node.*.z = z
        index += 1
    }
}

// How much of node `index` shows: they come in one after another.
fn nodeShown(index: usize, time: f64) -> f64 {
    return paint.easeOut((time - 0.9 - 0.14 * paint.toFloat(index)) / 0.5)
}

fn satellite(scene: *Scene, node: *const state.Node, time: f64, x: *f64, y: *f64) -> void {
    const angle = node.*.satelliteAngle + time * 0.3
    x.* = node.*.x + paint.cosine(&scene.*.tables, angle) * node.*.satelliteDistance * scene.*.unit
    y.* = node.*.y + paint.sine(&scene.*.tables, angle) * node.*.satelliteDistance * scene.*.unit * 0.7
}

// The nodes behind the letters or before them: a halo in the module's
// colour, a white-hot core and a thin circle round it, with a satellite
// linked to it.
pub fn nodes(scene: *Scene, time: f64, front: bool) -> void {
    const unit = scene.*.unit
    var index: usize = 0
    while index < NODE_COUNT {
        const node = &scene.*.nodes[index]
        const shown = nodeShown(index, time)
        if shown > 0.0 && (node.*.z >= 0.0) == front {
            const depth = 0.6 + 0.4 * (node.*.z / scene.*.rings[node.*.ring].radius + 1.0) * 0.5
            const strength = shown * depth
            const beat = 0.85 + 0.15 * paint.sine(&scene.*.tables, time * 2.4 + paint.toFloat(index) * 1.1)
            paint.glow(&scene.*.frame, &scene.*.nodeHalo, node.*.x, node.*.y, node.*.colour, 0.7 * strength * beat)
            paint.glow(&scene.*.frame, &scene.*.nodeCore, node.*.x, node.*.y, paint.mix(node.*.colour, paint.rgb(255, 255, 255), 0.6), 2.2 * strength)
            circle(scene, &scene.*.frame, node.*.x, node.*.y, unit * 0.12 * shown, paint.mix(node.*.colour, paint.rgb(190, 230, 255), 0.6), 0.85 * strength)
            var sx: f64 = 0.0
            var sy: f64 = 0.0
            satellite(scene, node, time, &sx, &sy)
            paint.line(&scene.*.frame, node.*.x, node.*.y, sx, sy, paint.rgb(130, 180, 255), 0.5 * strength)
            paint.glow(&scene.*.frame, &scene.*.dust, sx, sy, paint.rgb(170, 215, 255), 1.4 * strength)
            circle(scene, &scene.*.frame, sx, sy, unit * 0.055, paint.rgb(170, 215, 255), 0.8 * strength)
        }
        index += 1
    }
}

fn circle(scene: *Scene, surface: *Surface, x: f64, y: f64, radius: f64, colour: u32, strength: f64) -> void {
    if radius < 1.0 { return }
    const steps = @intCast(usize, paint.toInt(twoPi() * radius / 1.3)) + 6
    var step: usize = 0
    while step < steps {
        const angle = paint.toFloat(step) * twoPi() / paint.toFloat(steps)
        paint.spark(surface, x + paint.cosine(&scene.*.tables, angle) * radius, y + paint.sine(&scene.*.tables, angle) * radius, colour, strength)
        step += 1
    }
}

// The code graph's links: nodes near each other on the screen, fainter the
// further apart; and each satellite linked to its node's neighbour too,
// closing triangles.
pub fn links(scene: *Scene, time: f64, shown: f64) -> void {
    if shown <= 0.0 { return }
    const reach = scene.*.unit * 4.6
    var index: usize = 0
    while index < NODE_COUNT {
        const a = &scene.*.nodes[index]
        var other = index + 1
        while other < NODE_COUNT {
            const b = &scene.*.nodes[other]
            const dx = a.*.x - b.*.x
            const dy = a.*.y - b.*.y
            const d2 = dx * dx + dy * dy
            if d2 < reach * reach {
                const near = 1.0 - d2 / (reach * reach)
                paint.line(&scene.*.frame, a.*.x, a.*.y, b.*.x, b.*.y, paint.rgb(110, 150, 255), 0.4 * near * shown * paint.min(nodeShown(index, time), nodeShown(other, time)))
            }
            other += 1
        }
        const next = (index + 1) % NODE_COUNT
        const b = &scene.*.nodes[next]
        var sx: f64 = 0.0
        var sy: f64 = 0.0
        satellite(scene, a, time, &sx, &sy)
        const dx = sx - b.*.x
        const dy = sy - b.*.y
        const short = scene.*.unit * 2.6
        const d2 = dx * dx + dy * dy
        if d2 < short * short {
            const near = 1.0 - d2 / (short * short)
            paint.line(&scene.*.frame, sx, sy, b.*.x, b.*.y, paint.rgb(120, 165, 255), 0.35 * near * shown * paint.min(nodeShown(index, time), nodeShown(next, time)))
        }
        index += 1
    }
}

// Module names beside three of the nodes, as the Observatory labels its
// map.
pub fn labels(scene: *Scene, shown: f64) -> void {
    if shown <= 0.0 || !scene.*.small.loaded { return }
    labelAt(scene, &scene.*.nodes[0], "compiler", shown)
    labelAt(scene, &scene.*.nodes[3], "observatory", shown)
    labelAt(scene, &scene.*.nodes[4], "desktop", shown)
}

// A label as a heads-up display shows one: a leader from the node, the
// name, a rule under it.
fn labelAt(scene: *Scene, node: *const state.Node, label: []const u8, shown: f64) -> void {
    const unit = scene.*.unit
    const strength = shown * (if node.*.z > 0.0 { 0.85 } else { 0.6 })
    const x = node.*.x + unit * 0.3
    const y = node.*.y - unit * 0.36
    const width = state.measure(&scene.*.small, label)
    state.drawText(scene, &scene.*.small, label, x, y, canvas_module.color(@intCast(u32, paint.toInt(strength * 255.0)), 190, 215, 255))
    const rule_y = y + unit * 0.135
    paint.line(&scene.*.frame, node.*.x + unit * 0.09, node.*.y - unit * 0.09, x - unit * 0.05, rule_y, paint.rgb(120, 165, 255), 0.45 * shown)
    paint.line(&scene.*.frame, x - unit * 0.05, rule_y, x + width, rule_y, paint.rgb(120, 165, 255), 0.4 * shown)
}

// ---------------------------------------------------------------------------
// The dial

fn dialRadius(scene: *Scene) -> f64 { return scene.*.unit * 2.45 }

// The dial behind the letters: ticks on most of a circle, the gap at the
// lower left, and two thick violet arcs on it, the long one over the
// letters and a short one at the right.
pub fn dialStill(scene: *Scene, surface: *Surface, shown: f64) -> void {
    if shown <= 0.0 { return }
    const unit = scene.*.unit
    const radius = dialRadius(scene)
    var tick: usize = 0
    while tick < 100 {
        // 100 ticks over 300 degrees.
        const angle = 2.4 + paint.toFloat(tick) * 0.0523599
        const major = tick % 5 == 0
        const length = if major { unit * 0.17 } else { unit * 0.08 }
        const ends = paint.smoothstep(0.0, 12.0, paint.toFloat(tick)) * paint.smoothstep(100.0, 88.0, paint.toFloat(tick))
        const cs = paint.cosine(&scene.*.tables, angle)
        const sn = paint.sine(&scene.*.tables, angle)
        paint.line(surface, scene.*.cx + cs * radius, scene.*.cy + sn * radius, scene.*.cx + cs * (radius + length), scene.*.cy + sn * (radius + length), paint.rgb(130, 150, 245), (if major { 0.5 } else { 0.3 }) * ends * shown)
        tick += 1
    }
    band(scene, surface, radius + unit * 0.3, unit * 0.075, -2.2, -1.25, shown)
    band(scene, surface, radius + unit * 0.3, unit * 0.075, -0.42, -0.12, shown * 0.85)
}

// A thick arc of the dial from angle `from` to `to`: layers of sparks
// across its width, faint at its start and bright at its end.
fn band(scene: *Scene, surface: *Surface, radius: f64, thickness: f64, from: f64, to: f64, shown: f64) -> void {
    const steps = @intCast(usize, paint.toInt(radius * (to - from) / 1.1)) + 4
    const layers = @intCast(usize, paint.toInt(thickness)) + 1
    var step: usize = 0
    while step < steps {
        const along = paint.toFloat(step) / paint.toFloat(steps)
        const angle = from + (to - from) * along
        const level = (0.15 + 0.85 * along * along) * paint.smoothstep(1.0, 0.94, along) * shown
        const colour = paint.mix(paint.rgb(118, 82, 230), paint.rgb(214, 180, 255), along)
        const cs = paint.cosine(&scene.*.tables, angle)
        const sn = paint.sine(&scene.*.tables, angle)
        var layer: usize = 0
        while layer < layers {
            const r = radius + (paint.toFloat(layer) / paint.toFloat(layers) - 0.5) * thickness
            paint.spark(surface, scene.*.cx + cs * r, scene.*.cy + sn * r, colour, 0.6 * level)
            layer += 1
        }
        if step % 5 == 0 { paint.glow(surface, &scene.*.halo, scene.*.cx + cs * radius, scene.*.cy + sn * radius, paint.rgb(140, 96, 255), 0.25 * level) }
        step += 1
    }
}

// A light running round the dial's ticks, its trail fading behind it.
pub fn dialScanner(scene: *Scene, time: f64, shown: f64) -> void {
    if shown <= 0.0 { return }
    const radius = dialRadius(scene) + scene.*.unit * 0.04
    const head = -1.6 + time * 0.7
    const trail: f64 = 0.7
    const steps = @intCast(usize, paint.toInt(radius * trail / 1.2)) + 2
    var step: usize = 0
    while step < steps {
        const along = paint.toFloat(step) / paint.toFloat(steps)
        const angle = head - trail * (1.0 - along)
        const cs = paint.cosine(&scene.*.tables, angle)
        const sn = paint.sine(&scene.*.tables, angle)
        paint.spark(&scene.*.frame, scene.*.cx + cs * radius, scene.*.cy + sn * radius, paint.rgb(190, 170, 255), along * along * shown)
        step += 1
    }
    const cs = paint.cosine(&scene.*.tables, head)
    const sn = paint.sine(&scene.*.tables, head)
    paint.glow(&scene.*.frame, &scene.*.halo, scene.*.cx + cs * radius, scene.*.cy + sn * radius, paint.rgb(170, 140, 255), 0.9 * shown)
}

// ---------------------------------------------------------------------------
// Dust and stars

// Dust drifting out from the middle, each mote brightening and fading.
pub fn dust(scene: *Scene, time: f64, appear: f64) -> void {
    const unit = scene.*.unit
    var index: usize = 0
    while index < state.DUST_COUNT {
        const travel = scene.*.dustRadius[index] + time * scene.*.dustSpeed[index]
        // Back to the inside once out of reach.
        const radius = 1.4 + (travel - 1.4) - paint.floor((travel - 1.4) / 4.8) * 4.8
        const angle = scene.*.dustAngle[index] + time * 0.03
        const x = scene.*.cx + paint.cosine(&scene.*.tables, angle) * radius * unit
        const y = scene.*.cy + paint.sine(&scene.*.tables, angle) * radius * unit * 0.62
        const life = paint.smoothstep(1.4, 2.2, radius) * paint.smoothstep(6.2, 5.0, radius)
        const flicker = 0.6 + 0.4 * paint.sine(&scene.*.tables, time * 2.3 + paint.toFloat(index) * 1.7)
        const strength = scene.*.dustBright[index] * life * flicker * appear
        if strength > 0.02 {
            paint.spark(&scene.*.frame, x, y, paint.rgb(170, 190, 255), strength * 0.8)
            if index % 3 == 0 { paint.glow(&scene.*.frame, &scene.*.dust, x, y, paint.rgb(120, 130, 255), strength * 0.35) }
        }
        index += 1
    }
}

pub fn twinkles(scene: *Scene, time: f64) -> void {
    var index: usize = 0
    while index < state.TWINKLE_COUNT {
        const level = 0.5 + 0.5 * paint.sine(&scene.*.tables, time * 1.3 + scene.*.twinklePhase[index])
        paint.spark(&scene.*.frame, scene.*.twinkleX[index], scene.*.twinkleY[index], paint.rgb(200, 210, 255), 0.55 * level * level)
        index += 1
    }
}
