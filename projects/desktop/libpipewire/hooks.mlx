// SPA hooks: the listener lists C programs hang on PipeWire's objects
// (spa_hook_list). Each struct spa_hook a program hands the library is
// linked into an object's list through its first two words (a spa_list:
// next, prev) and keeps the program's table of callbacks (cb.funcs: a
// struct whose first word is its version, then one function pointer per
// method) and the data passed to them. The program takes a hook out with
// spa_hook_remove, which is inline in its own code (it unlinks the words
// and calls `removed`), so the list must be a real doubly linked list in
// the program's memory, and a call to every hook goes through a cursor
// linked in behind the one being called: whatever the callback removes
// or adds, the walk goes on from the cursor.
//
// A list head is two words (hooks.LIST) in C memory, pointing at itself
// when the list is empty.
const c = @import("../libpulse/c.mlx")

// struct spa_hook: link (next, prev), cb (funcs, data), removed, priv.
pub const HOOK: usize = 48
const NEXT: usize = 0
const PREV: usize = 8
const FUNCS: usize = 16
const DATA: usize = 24
const REMOVED: usize = 32
const PRIV: usize = 40

pub const LIST: usize = 16

pub fn init(list: usize) -> void {
    c.putPointer(list, NEXT, list)
    c.putPointer(list, PREV, list)
}

pub fn isEmpty(list: usize) -> bool { return c.getPointer(list, NEXT) == list || c.getPointer(list, NEXT) == 0 }

fn link(before: usize, hook: usize, after: usize) -> void {
    c.putPointer(hook, PREV, before)
    c.putPointer(hook, NEXT, after)
    c.putPointer(before, NEXT, hook)
    c.putPointer(after, PREV, hook)
}

fn unlink(hook: usize) -> void {
    const before = c.getPointer(hook, PREV)
    const after = c.getPointer(hook, NEXT)
    if before == 0 || after == 0 { return }
    c.putPointer(before, NEXT, after)
    c.putPointer(after, PREV, before)
    c.putPointer(hook, NEXT, 0)
    c.putPointer(hook, PREV, 0)
}

// Adds `hook` with the program's `funcs` and `data` at the end of the
// list (spa_hook_list_append).
pub fn append(list: usize, hook: usize, funcs: usize, data: usize) -> void {
    if c.getPointer(list, NEXT) == 0 { init(list) }
    link(c.getPointer(list, PREV), hook, list)
    c.putPointer(hook, FUNCS, funcs)
    c.putPointer(hook, DATA, data)
    c.putPointer(hook, REMOVED, 0)
    c.putPointer(hook, PRIV, 0)
}

// Adds it at the front (spa_hook_list_prepend).
pub fn prepend(list: usize, hook: usize, funcs: usize, data: usize) -> void {
    if c.getPointer(list, NEXT) == 0 { init(list) }
    link(list, hook, c.getPointer(list, NEXT))
    c.putPointer(hook, FUNCS, funcs)
    c.putPointer(hook, DATA, data)
    c.putPointer(hook, REMOVED, 0)
    c.putPointer(hook, PRIV, 0)
}

// Takes a hook out, as spa_hook_remove does: unlinked, and told through
// `removed` when it asked.
pub fn remove(hook: usize) -> void {
    unlink(hook)
    const removed = c.getPointer(hook, REMOVED)
    if removed != 0 { c.call1(removed, hook) }
}

// Takes every hook out (spa_hook_list_clean).
pub fn clean(list: usize) -> void {
    if c.getPointer(list, NEXT) == 0 { return }
    while !isEmpty(list) { remove(c.getPointer(list, NEXT)) }
}

pub fn funcsOf(hook: usize) -> usize { return c.getPointer(hook, FUNCS) }

pub fn dataOf(hook: usize) -> usize { return c.getPointer(hook, DATA) }

pub fn setRemoved(hook: usize, removed: usize, priv: usize) -> void {
    c.putPointer(hook, REMOVED, removed)
    c.putPointer(hook, PRIV, priv)
}

pub fn privOf(hook: usize) -> usize { return c.getPointer(hook, PRIV) }

// Whether the table `funcs` has method `index` (counted among the
// function pointers after the version word) at `version`: SPA's
// SPA_CALLBACK_CHECK.
pub fn has(funcs: usize, index: usize, version: u32) -> bool {
    if funcs == 0 { return false }
    if version != 0 && c.get32(funcs, 0) <= version - 1 { return false }
    return c.getPointer(funcs, 8 + index * 8) != 0
}

pub fn methodOf(funcs: usize, index: usize) -> usize { return c.getPointer(funcs, 8 + index * 8) }

// Whether any hook of the list has method `index` at `version`.
pub fn anyHas(list: usize, index: usize, version: u32) -> bool {
    if c.getPointer(list, NEXT) == 0 { return false }
    var hook = c.getPointer(list, NEXT)
    while hook != list && hook != 0 {
        if has(funcsOf(hook), index, version) { return true }
        hook = c.getPointer(hook, NEXT)
    }
    return false
}

// Calls method `index` (version `version`) of every hook with the hook's
// data first and then `count` of the arguments.
fn callEach(list: usize, index: usize, version: u32, count: usize, a: usize, b: usize, d: usize, e: usize, f: usize) -> void {
    if c.getPointer(list, NEXT) == 0 { return }
    var cursor: [6]usize = [6]usize{ 0, 0, 0, 0, 0, 0 }
    const cursor_address = @intFromPtr(&cursor)
    var hook = c.getPointer(list, NEXT)
    while hook != list && hook != 0 {
        link(hook, cursor_address, c.getPointer(hook, NEXT))
        const funcs = funcsOf(hook)
        if has(funcs, index, version) {
            const method = methodOf(funcs, index)
            const data = dataOf(hook)
            if count == 0 {
                c.call1(method, data)
            } else if count == 1 {
                c.call2(method, data, a)
            } else if count == 2 {
                c.call3(method, data, a, b)
            } else if count == 3 {
                c.call4(method, data, a, b, d)
            } else if count == 4 {
                c.call5(method, data, a, b, d, e)
            } else {
                c.call6(method, data, a, b, d, e, f)
            }
        }
        hook = c.getPointer(cursor_address, NEXT)
        unlink(cursor_address)
    }
}

pub fn call0(list: usize, index: usize, version: u32) -> void { callEach(list, index, version, 0, 0, 0, 0, 0, 0) }

pub fn call1(list: usize, index: usize, version: u32, a: usize) -> void { callEach(list, index, version, 1, a, 0, 0, 0, 0) }

pub fn call2(list: usize, index: usize, version: u32, a: usize, b: usize) -> void { callEach(list, index, version, 2, a, b, 0, 0, 0) }

pub fn call3(list: usize, index: usize, version: u32, a: usize, b: usize, d: usize) -> void { callEach(list, index, version, 3, a, b, d, 0, 0) }

pub fn call4(list: usize, index: usize, version: u32, a: usize, b: usize, d: usize, e: usize) -> void { callEach(list, index, version, 4, a, b, d, e, 0) }

pub fn call5(list: usize, index: usize, version: u32, a: usize, b: usize, d: usize, e: usize, f: usize) -> void { callEach(list, index, version, 5, a, b, d, e, f) }

// A table of `count` function pointers for a spa_interface or a set of
// methods the library offers C: its version word, then the pointers
// (filled with `set`).
pub fn table(count: usize, version: u32) -> usize {
    const made = c.alloc(8 + count * 8)
    if made != 0 { c.put32(made, 0, version) }
    return made
}

pub fn set(table_address: usize, index: usize, function: usize) -> void { c.putPointer(table_address, 8 + index * 8, function) }

// struct spa_interface: type (a C string), version, cb (funcs, data).
pub const INTERFACE: usize = 32

pub fn interface(address: usize, kind: usize, version: u32, funcs: usize, data: usize) -> void {
    c.putPointer(address, 0, kind)
    c.put32(address, 8, version)
    c.put32(address, 12, 0)
    c.putPointer(address, 16, funcs)
    c.putPointer(address, 24, data)
}
