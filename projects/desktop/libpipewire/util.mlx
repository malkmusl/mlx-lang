// libpipewire's small utilities for C: strings (pw_strip, pw_split_strv
// and the other strv functions), the names of directions and states, the
// version, random bytes. Strings handed out are C strings in C memory.
const std = @import("std")
const c = @import("../libpulse/c.mlx")

pub const VERSION: []const u8 = "1.0.5"
pub const MAJOR: i32 = 1
pub const MINOR: i32 = 0
pub const MICRO: i32 = 5

// errno values, negative as the library returns them.
pub const ENOENT: i32 = -2
pub const EIO: i32 = -5
pub const EBUSY: i32 = -16
pub const EEXIST: i32 = -17
pub const EINVAL: i32 = -22
pub const ENOSPC: i32 = -28
pub const EPIPE: i32 = -32
pub const ENOTSUP: i32 = -95
pub const ETIMEDOUT: i32 = -110
pub const ENOMEM: i32 = -12
pub const EPROTO: i32 = -71

// Whether `byte` is one of the bytes of the C string `set`.
fn oneOf(byte: u8, set: usize) -> bool {
    var index: usize = 0
    while c.get8(set, index) != 0 {
        if c.get8(set, index) == byte { return true }
        index += 1
    }
    return false
}

// pw_strip: `text` without the bytes of `whitespace` at both ends, in
// place (the end gets a NUL); the start returned.
pub fn strip(text: usize, whitespace: usize) -> usize {
    if text == 0 { return 0 }
    var start: usize = 0
    while c.get8(text, start) != 0 && oneOf(c.get8(text, start), whitespace) { start += 1 }
    var end = c.length(text)
    while end > start && oneOf(c.get8(text, end - 1), whitespace) { end -= 1 }
    c.put8(text, end, 0)
    return text + start
}

// pw_split_walk: the next piece of `text` between the bytes of
// `delimiter`, from `state` (0 at first); its length in `length`, 0 at
// the end.
pub fn splitWalk(text: usize, delimiter: usize, length: usize, state: usize) -> usize {
    var at = c.getPointer(state, 0)
    if at == 0 { at = text }
    while c.get8(at, 0) != 0 && oneOf(c.get8(at, 0), delimiter) { at += 1 }
    if c.get8(at, 0) == 0 {
        c.putPointer(state, 0, at)
        return 0
    }
    var end = at
    while c.get8(end, 0) != 0 && !oneOf(c.get8(end, 0), delimiter) { end += 1 }
    c.putPointer(length, 0, end - at)
    c.putPointer(state, 0, end)
    return at
}

// pw_split_strv: the pieces of `text` as a NULL-terminated array of C
// strings (at most `max_tokens`: the last takes the rest), their count in
// `count`.
pub fn splitStrv(text: usize, delimiter: usize, max_tokens: i32, count: usize) -> usize {
    var found: usize = 0
    var array = c.alloc(8 * 16)
    var capacity: usize = 16
    if array == 0 { return 0 }
    var state: usize = 0
    var length: usize = 0
    while true {
        var piece = splitWalk(text, delimiter, @intFromPtr(&length), @intFromPtr(&state))
        if piece == 0 { break }
        if max_tokens > 0 && found + 1 == @intCast(usize, max_tokens) {
            // The rest, delimiters and all.
            length = c.length(piece)
            state = piece + length
        }
        if found + 2 > capacity {
            array = c.grow(array, 8 * capacity * 2)
            if array == 0 { return 0 }
            c.zero(array + 8 * capacity, 8 * capacity)
            capacity = capacity * 2
        }
        c.putPointer(array, found * 8, c.duplicate(c.bytes(piece)[0..length]))
        found += 1
    }
    c.putPointer(array, found * 8, 0)
    if count != 0 { c.put32(count, 0, @intCast(u32, found)) }
    return array
}

// pw_strv_parse: the strings of a JSON array (`[ "a", b ]`), or of bare
// words, as pw_split_strv gives them.
pub fn strvParse(text: usize, text_length: usize, max_tokens: i32, count: usize) -> usize {
    var array = c.alloc(8 * 16)
    var capacity: usize = 16
    if array == 0 { return 0 }
    var found: usize = 0
    var at: usize = 0
    var piece: [4096]u8 = undefined
    var piece_bytes: [*]u8 = undefined
    unsafe { piece_bytes = @ptrCast([*]u8, &piece) }
    const bytes = c.bytes(text)
    while at < text_length {
        const byte = bytes[at]
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 91 || byte == 93 || byte == 44 {
            at += 1
            continue
        }
        var length: usize = 0
        if byte == 34 {
            at += 1
            while at < text_length && bytes[at] != 34 {
                var value = bytes[at]
                if value == 92 && at + 1 < text_length {
                    at += 1
                    value = bytes[at]
                }
                if length < 4095 {
                    piece_bytes[length] = value
                    length += 1
                }
                at += 1
            }
            if at < text_length { at += 1 }
        } else {
            while at < text_length && bytes[at] != 32 && bytes[at] != 9 && bytes[at] != 10 && bytes[at] != 13 && bytes[at] != 44 && bytes[at] != 93 {
                if length < 4095 {
                    piece_bytes[length] = bytes[at]
                    length += 1
                }
                at += 1
            }
        }
        if max_tokens > 0 && found == @intCast(usize, max_tokens) { break }
        if found + 2 > capacity {
            array = c.grow(array, 8 * capacity * 2)
            if array == 0 { return 0 }
            c.zero(array + 8 * capacity, 8 * capacity)
            capacity = capacity * 2
        }
        c.putPointer(array, found * 8, c.duplicate(piece_bytes[0..length]))
        found += 1
    }
    c.putPointer(array, found * 8, 0)
    if count != 0 { c.put32(count, 0, @intCast(u32, found)) }
    return array
}

pub fn freeStrv(array: usize) -> void {
    if array == 0 { return }
    var index: usize = 0
    while c.getPointer(array, index * 8) != 0 {
        c.release(c.getPointer(array, index * 8))
        index += 1
    }
    c.release(array)
}

// pw_strv_find: where `text` is in the array, -1 when it is not.
pub fn strvFind(array: usize, text: usize) -> i32 {
    if array == 0 || text == 0 { return -1 }
    var index: usize = 0
    while c.getPointer(array, index * 8) != 0 {
        if c.same(c.slice(c.getPointer(array, index * 8)), c.slice(text)) { return @intCast(i32, index) }
        index += 1
    }
    return -1
}

// pw_strv_find_common: the index in `first` of the first string `second`
// has too, -1 when there is none.
pub fn strvFindCommon(first: usize, second: usize) -> i32 {
    if first == 0 || second == 0 { return -1 }
    var index: usize = 0
    while c.getPointer(first, index * 8) != 0 {
        if strvFind(second, c.getPointer(first, index * 8)) >= 0 { return @intCast(i32, index) }
        index += 1
    }
    return -1
}

// pw_split_ip: `text` cut in place at the bytes of `delimiter` into at
// most `max_tokens` pieces, their starts in `tokens`; how many.
pub fn splitInPlace(text: usize, delimiter: usize, max_tokens: i32, tokens: usize) -> i32 {
    var found: i32 = 0
    var at = text
    while found < max_tokens {
        while c.get8(at, 0) != 0 && oneOf(c.get8(at, 0), delimiter) { at += 1 }
        if c.get8(at, 0) == 0 { break }
        c.putPointer(tokens, @intCast(usize, found) * 8, at)
        found += 1
        if found == max_tokens { break }
        while c.get8(at, 0) != 0 && !oneOf(c.get8(at, 0), delimiter) { at += 1 }
        if c.get8(at, 0) == 0 { break }
        c.put8(at, 0, 0)
        at += 1
    }
    return found
}

pub fn directionName(direction: u32) -> []const u8 {
    if direction == 0 { return "input" }
    if direction == 1 { return "output" }
    return "invalid"
}

pub fn nodeStateName(state: i32) -> []const u8 {
    if state == -1 { return "error" }
    if state == 0 { return "creating" }
    if state == 1 { return "suspended" }
    if state == 2 { return "idle" }
    if state == 3 { return "running" }
    return "invalid-state"
}

pub fn linkStateName(state: i32) -> []const u8 {
    if state == -2 { return "error" }
    if state == -1 { return "unlinked" }
    if state == 0 { return "init" }
    if state == 1 { return "negotiating" }
    if state == 2 { return "allocating" }
    if state == 3 { return "paused" }
    if state == 4 { return "active" }
    return "invalid-state"
}

pub fn streamStateName(state: i32) -> []const u8 {
    if state == -1 { return "error" }
    if state == 0 { return "unconnected" }
    if state == 1 { return "connecting" }
    if state == 2 { return "paused" }
    if state == 3 { return "streaming" }
    return "invalid-state"
}

// pw_filter's states are named like pw_stream's.
pub fn filterStateName(state: i32) -> []const u8 { return streamStateName(state) }

// getrandom(2): how many bytes came, or a negative errno.
pub fn random(buffer: usize, length: usize, flags: u32) -> isize { return std.linux.syscall3(318, buffer, length, @intCast(usize, flags)) }

pub fn random32() -> u32 {
    var value: u32 = 0
    const got = random(@intFromPtr(&value), 4, 0)
    return value
}

// Whether the library is at least `major`.`minor`.`micro`.
pub fn atLeast(major: i32, minor: i32, micro: i32) -> bool {
    if MAJOR != major { return MAJOR > major }
    if MINOR != minor { return MINOR > minor }
    return MICRO >= micro
}

// Decimal digits of `value` into `out`: how many.
pub fn decimal(out: [*]u8, value: u64) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var index: usize = 0
    while index < count {
        out[index] = digits[count - 1 - index]
        index += 1
    }
    return count
}
