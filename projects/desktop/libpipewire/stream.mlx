// pw_stream: a program's node on the server, as PipeWire's library makes
// it: a client node (PipeWire:Interface:ClientNode) with one port, driven
// over the native protocol the way projects/desktop/capture/stream.mlx
// drives it from the other side.
//
//   connect:    CreateObject("client-node"), Update (the node's info and
//               params), PortUpdate (the port's: the formats the program
//               offers), and on Transport (the activation record and the
//               wake-up counters) SetActive
//   negotiate:  PortSetParam Format -> param_changed to the program, which
//               answers with pw_stream_update_params (Buffers, Meta) -> a
//               PortUpdate with them
//   run:        PortUseBuffers (the buffers mapped: add_buffer to the
//               program), SetIO, PortSetIO Buffers (the io area), the
//               driver's activation (SetActivation), Command Start
//               (PAUSED -> STREAMING); then each cycle the server marks
//               the node triggered and bumps its counter, the node takes
//               the buffer the io area names (process to the program:
//               pw_stream_dequeue_buffer, pw_stream_queue_buffer), writes
//               back what it is done with and counts the driver down
//
// The stream, its params, buffers and queues are C memory; the program's
// callbacks (pw_stream_events) run on the loop's thread with the thread
// loop's lock held.
const std = @import("std")
const c = @import("../libpulse/c.mlx")
const pod = @import("../capture/pod.mlx")
const hooks = @import("./hooks.mlx")
const loop_module = @import("./loop.mlx")
const context_module = @import("./context.mlx")
const core_module = @import("./core.mlx")
const proxy_module = @import("./proxy.mlx")
const properties = @import("./properties.mlx")
const process_module = @import("./process.mlx")
const util = @import("./util.mlx")

