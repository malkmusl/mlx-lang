// ---------------------------------------------------------------------------
// Rings

fn ringCount(ring: usize) -> u32 { return c.get32(ring, R_WRITE) - c.get32(ring, R_READ) }

fn ringPush(ring: usize, id: u32) -> bool {
    if ringCount(ring) >= @intCast(u32, MAX_BUFFERS) { return false }
    const write = c.get32(ring, R_WRITE)
    c.put32(ring, @intCast(usize, write % @intCast(u32, MAX_BUFFERS)) * 4, id)
    c.put32(ring, R_WRITE, write + 1)
    return true
}

// The oldest id, INVALID when the ring is empty.
fn ringPop(ring: usize) -> u32 {
    if ringCount(ring) == 0 { return INVALID }
    const read = c.get32(ring, R_READ)
    const id = c.get32(ring, @intCast(usize, read % @intCast(u32, MAX_BUFFERS)) * 4)
    c.put32(ring, R_READ, read + 1)
    return id
}

fn ringPeek(ring: usize) -> u32 {
    if ringCount(ring) == 0 { return INVALID }
    return c.get32(ring, @intCast(usize, c.get32(ring, R_READ) % @intCast(u32, MAX_BUFFERS)) * 4)
}

fn ringClear(ring: usize) -> void {
    c.put32(ring, R_READ, 0)
    c.put32(ring, R_WRITE, 0)
}

// ---------------------------------------------------------------------------
// Buffers and queues (as stream.c's queue_push and queue_pop: a buffer is
// in one queue at most, the queues count the bytes that went through)

fn bufferAt(stream: usize, id: u32) -> usize {
    if id >= c.get32(stream, S_BUFFER_COUNT) { return 0 }
    return c.getPointer(stream, S_BUFFERS) + @intCast(usize, id) * BUFFER
}

fn pushDequeued(stream: usize, buffer: usize) -> bool {
    if c.get32(buffer, B_FLAGS) & QUEUED != 0 { return false }
    c.put32(buffer, B_FLAGS, c.get32(buffer, B_FLAGS) | QUEUED)
    c.put64(stream, S_DEQUEUED_IN, c.get64(stream, S_DEQUEUED_IN) + c.get64(buffer, B_SIZE))
    return ringPush(c.getPointer(stream, S_DEQUEUED), c.get32(buffer, B_ID))
}

fn pushQueued(stream: usize, buffer: usize) -> bool {
    if c.get32(buffer, B_FLAGS) & QUEUED != 0 { return false }
    c.put32(buffer, B_FLAGS, c.get32(buffer, B_FLAGS) | QUEUED)
    c.put64(stream, S_QUEUED_IN, c.get64(stream, S_QUEUED_IN) + c.get64(buffer, B_SIZE))
    return ringPush(c.getPointer(stream, S_QUEUED), c.get32(buffer, B_ID))
}

fn popDequeued(stream: usize) -> usize {
    const id = ringPop(c.getPointer(stream, S_DEQUEUED))
    const buffer = bufferAt(stream, id)
    if buffer == 0 { return 0 }
    c.put64(stream, S_DEQUEUED_OUT, c.get64(stream, S_DEQUEUED_OUT) + c.get64(buffer, B_SIZE))
    c.put32(buffer, B_FLAGS, c.get32(buffer, B_FLAGS) & ~QUEUED)
    return buffer
}

fn popQueued(stream: usize) -> usize {
    const id = ringPop(c.getPointer(stream, S_QUEUED))
    const buffer = bufferAt(stream, id)
    if buffer == 0 { return 0 }
    c.put64(stream, S_QUEUED_OUT, c.get64(stream, S_QUEUED_OUT) + c.get64(buffer, B_SIZE))
    c.put32(buffer, B_FLAGS, c.get32(buffer, B_FLAGS) & ~QUEUED)
    return buffer
}

// The buffers go (remove_buffer to the program, their memory unmapped).
fn clearBuffers(stream: usize) -> void {
    var id: u32 = 0
    while id < c.get32(stream, S_BUFFER_COUNT) {
        const buffer = bufferAt(stream, id)
        if c.get32(buffer, B_FLAGS) & ADDED != 0 { emit1(stream, EVENT_REMOVE_BUFFER, 0, buffer) }
        if c.get32(buffer, B_FLAGS) & MAPPED != 0 { core_module.unmap(c.getPointer(buffer, B_MAP_BASE), c.getPointer(buffer, B_MAP_LEN)) }
        c.put32(buffer, B_FLAGS, 0)
        id += 1
    }
    c.put32(stream, S_BUFFER_COUNT, 0)
    ringClear(c.getPointer(stream, S_DEQUEUED))
    ringClear(c.getPointer(stream, S_QUEUED))
    c.put64(stream, S_DEQUEUED_IN, c.get64(stream, S_DEQUEUED_OUT))
    c.put64(stream, S_QUEUED_IN, c.get64(stream, S_QUEUED_OUT))
}

// ---------------------------------------------------------------------------
// Params

fn paramAt(stream: usize, index: usize) -> usize { return c.getPointer(stream, S_PARAMS) + index * PARAM }

fn nodeParamIndex(id: u32) -> usize {
    if id == PARAM_PROP_INFO { return 0 }
    if id == PARAM_PROPS { return 1 }
    if id == PARAM_ENUM_FORMAT { return 2 }
    if id == PARAM_FORMAT { return 3 }
    return 4
}

fn portParamIndex(id: u32) -> usize {
    if id == PARAM_ENUM_FORMAT { return 0 }
    if id == PARAM_META { return 1 }
    if id == PARAM_IO { return 2 }
    if id == PARAM_FORMAT { return 3 }
    if id == PARAM_BUFFERS { return 4 }
    if id == PARAM_LATENCY { return 5 }
    if id == PARAM_TAG { return 6 }
    return 7
}

// Params of `id` changed: the serial bit of its info flips, the node's and
// the port's info are due.
fn paramsChanged(stream: usize, id: u32) -> void {
    const node_index = nodeParamIndex(id)
    if node_index < 4 {
        c.put32(stream, S_NODE_SERIAL + node_index * 4, c.get32(stream, S_NODE_SERIAL + node_index * 4) ^ INFO_SERIAL)
        c.put32(stream, S_NODE_DIRTY, 1)
    }
    const port_index = portParamIndex(id)
    if port_index < 7 {
        c.put32(stream, S_PORT_SERIAL + port_index * 4, c.get32(stream, S_PORT_SERIAL + port_index * 4) ^ INFO_SERIAL)
        c.put32(stream, S_PORT_DIRTY, 1)
    }
}

// Takes the params of `id` out (INVALID: all), but the locked ones.
fn clearParams(stream: usize, id: u32) -> void {
    var count = @intCast(usize, c.get32(stream, S_PARAM_COUNT))
    var index: usize = 0
    var found = false
    while index < count {
        const param = paramAt(stream, index)
        if (id == INVALID && c.get32(param, P_FLAGS) & LOCKED == 0) || (c.get32(param, P_ID) == id && c.get32(param, P_FLAGS) & LOCKED == 0) {
            c.release(c.getPointer(param, P_POD))
            var at = index
            while at + 1 < count {
                c.copy(paramAt(stream, at), paramAt(stream, at + 1), PARAM)
                at += 1
            }
            count -= 1
            found = true
        } else {
            index += 1
        }
    }
    c.put32(stream, S_PARAM_COUNT, @intCast(u32, count))
    if found {
        if id == INVALID {
            c.put32(stream, S_NODE_DIRTY, 1)
            c.put32(stream, S_PORT_DIRTY, 1)
        } else {
            paramsChanged(stream, id)
        }
    }
}

// Keeps a copy of the C pod `address` as param `id` (INVALID: the object's
// own id).
fn addParam(stream: usize, id: u32, flags: u32, address: usize) -> bool {
    if address == 0 || c.get32(address, 4) != pod.OBJECT { return false }
    const count = @intCast(usize, c.get32(stream, S_PARAM_COUNT))
    if count >= MAX_PARAMS { return false }
    var param_id = id
    if param_id == INVALID { param_id = c.get32(address, 12) }
    const size = 8 + @intCast(usize, c.get32(address, 0))
    const copy = c.alloc(size)
    if copy == 0 { return false }
    c.copy(copy, address, size)
    c.put32(copy, 12, param_id)
    const param = paramAt(stream, count)
    c.put32(param, P_ID, param_id)
    c.put32(param, P_FLAGS, flags)
    c.put32(param, P_SIZE, @intCast(u32, size))
    c.putPointer(param, P_POD, copy)
    c.put32(stream, S_PARAM_COUNT, @intCast(u32, count + 1))
    paramsChanged(stream, param_id)
    return true
}

// pw_stream_update_params: the params given replace those of their ids.
fn updateParams(stream: usize, params: usize, count: u32) -> i32 {
    var index: usize = 0
    while index < @intCast(usize, count) {
        const address = c.getPointer(params, index * 8)
        if address != 0 && c.get32(address, 4) == pod.OBJECT { clearParams(stream, c.get32(address, 12)) }
        index += 1
    }
    index = 0
    while index < @intCast(usize, count) {
        if !addParam(stream, INVALID, 0, c.getPointer(params, index * 8)) { return util.EINVAL }
        index += 1
    }
    return 0
}

fn hasParam(stream: usize, id: u32) -> bool {
    var index: usize = 0
    while index < @intCast(usize, c.get32(stream, S_PARAM_COUNT)) {
        if c.get32(paramAt(stream, index), P_ID) == id { return true }
        index += 1
    }
    return false
}

// The params the library always has: the io area it takes (Buffers) and
// the Busy meta.
fn addOwnParams(stream: usize) -> void {
    var io: [10]u32 = [10]u32{ 32, pod.OBJECT, OBJECT_PARAM_IO, PARAM_IO, 1, 0, 4, pod.ID, IO_BUFFERS, 0 }
    // SPA_PARAM_IO_id Id(Buffers), SPA_PARAM_IO_size Int(8)
    var io_pod: [14]u32 = [14]u32{ 48, pod.OBJECT, OBJECT_PARAM_IO, PARAM_IO, 1, 0, 4, pod.ID, IO_BUFFERS, 0, 2, 0, 4, pod.INT }
    var io_full: [16]u32 = [16]u32{ 48, pod.OBJECT, OBJECT_PARAM_IO, PARAM_IO, 1, 0, 4, pod.ID, IO_BUFFERS, 0, 2, 0, 4, pod.INT, 8, 0 }
    const added_io = addParam(stream, PARAM_IO, LOCKED, @intFromPtr(&io_full))
    // SPA_PARAM_META_type Id(Busy), SPA_PARAM_META_size Int(8)
    var meta_full: [16]u32 = [16]u32{ 48, pod.OBJECT, OBJECT_PARAM_META, PARAM_META, 1, 0, 4, pod.ID, META_BUSY, 0, 2, 0, 4, pod.INT, 8, 0 }
    const added_meta = addParam(stream, PARAM_META, LOCKED, @intFromPtr(&meta_full))
}

// The media type and subtype of the first EnumFormat.
fn findFormat(stream: usize) -> void {
    c.put32(stream, S_MEDIA_TYPE, 0)
    c.put32(stream, S_MEDIA_SUBTYPE, 0)
    var index: usize = 0
    while index < @intCast(usize, c.get32(stream, S_PARAM_COUNT)) {
        const param = paramAt(stream, index)
        if c.get32(param, P_ID) == PARAM_ENUM_FORMAT {
            const address = c.getPointer(param, P_POD)
            const bytes = c.bytes(address)
            const object = pod.podAt(bytes, 0, @intCast(usize, c.get32(param, P_SIZE)))
            c.put32(stream, S_MEDIA_TYPE, pod.uintOf(bytes, pod.choiceValue(bytes, pod.property(bytes, object, FORMAT_MEDIA_TYPE), 0)))
            c.put32(stream, S_MEDIA_SUBTYPE, pod.uintOf(bytes, pod.choiceValue(bytes, pod.property(bytes, object, FORMAT_MEDIA_SUBTYPE), 0)))
            return
        }
        index += 1
    }
}

fn mediaClass(stream: usize) -> []const u8 {
    const media_type = c.get32(stream, S_MEDIA_TYPE)
    const subtype = c.get32(stream, S_MEDIA_SUBTYPE)
    if media_type == MEDIA_AUDIO { return "Audio" }
    if media_type == MEDIA_VIDEO { return "Video" }
    if media_type == MEDIA_APPLICATION { return if subtype == SUBTYPE_CONTROL { "Midi" } else { "Data" } }
    if media_type == MEDIA_STREAM { return if subtype == SUBTYPE_MIDI { "Midi" } else { "Data" } }
    return "Unknown"
}

// ---------------------------------------------------------------------------
// Events to the program

fn emit0(stream: usize, index: usize, version: u32) -> void { hooks.call0(stream + S_LISTENERS, index, version) }

fn emit1(stream: usize, index: usize, version: u32, a: usize) -> void { hooks.call1(stream + S_LISTENERS, index, version, a) }

fn emit2(stream: usize, index: usize, version: u32, a: usize, b: usize) -> void { hooks.call2(stream + S_LISTENERS, index, version, a, b) }

fn emit3(stream: usize, index: usize, version: u32, a: usize, b: usize, d: usize) -> void { hooks.call3(stream + S_LISTENERS, index, version, a, b, d) }

pub fn stateOf(stream: usize) -> i32 { return @bitCast(i32, c.get32(stream, S_STATE)) }

// The state, and the program told when it changed.
fn setState(stream: usize, state: i32, result: i32, message: usize) -> bool {
    const old = stateOf(stream)
    if old == state { return false }
    c.release(c.getPointer(stream, S_ERROR))
    c.putPointer(stream, S_ERROR, if message != 0 { c.duplicateC(message) } else { 0 })
    c.put32(stream, S_ERROR_RES, @bitCast(u32, result))
    c.put32(stream, S_STATE, @bitCast(u32, state))
    emit3(stream, EVENT_STATE_CHANGED, 0, c.int(old), c.int(state), c.getPointer(stream, S_ERROR))
    return true
}

fn emitParamChanged(stream: usize, id: u32, address: usize) -> void {
    c.put32(stream, S_IN_EMIT, c.get32(stream, S_IN_EMIT) + 1)
    emit2(stream, EVENT_PARAM_CHANGED, 0, @intCast(usize, id), address)
    c.put32(stream, S_IN_EMIT, c.get32(stream, S_IN_EMIT) - 1)
}

// ---------------------------------------------------------------------------
// Messages to the server

fn send(stream: usize, opcode: u32, writing: *pod.Writer, top: usize) -> void {
    const proxy = c.getPointer(stream, S_PROXY)
    const core = c.getPointer(stream, S_CORE)
    if proxy == 0 || !core_module.alive(core) { return }
    const sent = core_module.sendPlain(core, proxy_module.idOf(proxy), opcode, writing, top)
}

fn putOwnPod(writing: *pod.Writer, param: usize) -> void {
    const address = c.getPointer(param, P_POD)
    const size = @intCast(usize, c.get32(param, P_SIZE))
    var at: usize = 0
    while at < (size + 7) / 8 * 8 {
        pod.putRaw32(writing, if at < size { c.get32(address, at) } else { 0 })
        at += 4
    }
}

fn paramInfoFlags(stream: usize, id: u32, base: u32, serial: u32) -> u32 {
    var flags = base | serial
    if hasParam(stream, id) { flags = flags | INFO_READ }
    return flags
}

// Update: the node's params (PropInfo, Props, EnumFormat, Format) and its
// info (ports, flags, properties, param infos).
fn sendUpdate(stream: usize, change_mask: u32) -> void {
    const core = c.getPointer(stream, S_CORE)
    if c.getPointer(stream, S_PROXY) == 0 || !core_module.alive(core) { return }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    pod.putUint(&writing, change_mask)
    var count: u32 = 0
    var index: usize = 0
    if change_mask & UPDATE_PARAMS != 0 {
        while index < @intCast(usize, c.get32(stream, S_PARAM_COUNT)) {
            if nodeParamIndex(c.get32(paramAt(stream, index), P_ID)) < 4 { count += 1 }
            index += 1
        }
    }
    pod.putUint(&writing, count)
    index = 0
    while change_mask & UPDATE_PARAMS != 0 && index < @intCast(usize, c.get32(stream, S_PARAM_COUNT)) {
        const param = paramAt(stream, index)
        if nodeParamIndex(c.get32(param, P_ID)) < 4 { putOwnPod(&writing, param) }
        index += 1
    }
    if change_mask & UPDATE_INFO != 0 {
        const info = pod.beginStruct(&writing)
        const input = c.get32(stream, S_DIRECTION) == 0
        pod.putUint(&writing, if input { 1 } else { 0 })
        pod.putUint(&writing, if input { 0 } else { 1 })
        // SPA_NODE_CHANGE_MASK_FLAGS | PROPS | PARAMS
        pod.putLong(&writing, 7)
        // SPA_NODE_FLAG_RT, and ASYNC unless the program processes in time.
        var flags: i64 = 1
        if c.get32(stream, S_FLAGS) & FLAG_RT_PROCESS == 0 || c.get32(stream, S_FLAGS) & FLAG_ASYNC != 0 { flags = flags | 64 }
        pod.putLong(&writing, flags)
        const props = c.getPointer(stream, S_PROPERTIES)
        pod.putUint(&writing, @intCast(u32, properties.count(props)))
        var item: usize = 0
        while item < properties.count(props) {
            pod.putString(&writing, c.slice(properties.keyAt(props, item)))
            pod.putString(&writing, c.slice(properties.valueAt(props, item)))
            item += 1
        }
        pod.putUint(&writing, 4)
        pod.putId(&writing, PARAM_PROP_INFO)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_PROP_INFO, 0, c.get32(stream, S_NODE_SERIAL)))
        pod.putId(&writing, PARAM_PROPS)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_PROPS, INFO_WRITE, c.get32(stream, S_NODE_SERIAL + 4)))
        pod.putId(&writing, PARAM_ENUM_FORMAT)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_ENUM_FORMAT, 0, c.get32(stream, S_NODE_SERIAL + 8)))
        pod.putId(&writing, PARAM_FORMAT)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_FORMAT, INFO_WRITE, c.get32(stream, S_NODE_SERIAL + 12)))
        pod.end(&writing, info)
    } else {
        pod.putNone(&writing)
    }
    send(stream, NODE_UPDATE, &writing, top)
    c.put32(stream, S_NODE_DIRTY, 0)
}

// PortUpdate: the port's params (every one kept) and its info.
fn sendPortUpdate(stream: usize, change_mask: u32) -> void {
    const core = c.getPointer(stream, S_CORE)
    if c.getPointer(stream, S_PROXY) == 0 || !core_module.alive(core) { return }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    pod.putUint(&writing, c.get32(stream, S_DIRECTION))
    pod.putUint(&writing, 0)
    pod.putUint(&writing, change_mask)
    if change_mask == 0 {
        pod.putUint(&writing, 0)
        pod.putNone(&writing)
        send(stream, NODE_PORT_UPDATE, &writing, top)
        return
    }
    var count: u32 = 0
    var index: usize = 0
    if change_mask & UPDATE_PARAMS != 0 {
        while index < @intCast(usize, c.get32(stream, S_PARAM_COUNT)) {
            if portParamIndex(c.get32(paramAt(stream, index), P_ID)) < 7 { count += 1 }
            index += 1
        }
    }
    pod.putUint(&writing, count)
    index = 0
    while change_mask & UPDATE_PARAMS != 0 && index < @intCast(usize, c.get32(stream, S_PARAM_COUNT)) {
        const param = paramAt(stream, index)
        if portParamIndex(c.get32(param, P_ID)) < 7 { putOwnPod(&writing, param) }
        index += 1
    }
    if change_mask & UPDATE_INFO != 0 {
        const info = pod.beginStruct(&writing)
        // SPA_PORT_CHANGE_MASK_FLAGS | RATE | PROPS | PARAMS
        pod.putLong(&writing, 15)
        pod.putLong(&writing, if c.get32(stream, S_FLAGS) & FLAG_ALLOC_BUFFERS != 0 { 4 } else { 0 })
        pod.putUint(&writing, 0)
        pod.putUint(&writing, 1)
        const props = c.getPointer(stream, S_PORT_PROPERTIES)
        pod.putUint(&writing, @intCast(u32, properties.count(props)))
        var item: usize = 0
        while item < properties.count(props) {
            pod.putString(&writing, c.slice(properties.keyAt(props, item)))
            pod.putString(&writing, c.slice(properties.valueAt(props, item)))
            item += 1
        }
        pod.putUint(&writing, 7)
        pod.putId(&writing, PARAM_ENUM_FORMAT)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_ENUM_FORMAT, 0, c.get32(stream, S_PORT_SERIAL)))
        pod.putId(&writing, PARAM_META)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_META, 0, c.get32(stream, S_PORT_SERIAL + 4)))
        pod.putId(&writing, PARAM_IO)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_IO, 0, c.get32(stream, S_PORT_SERIAL + 8)))
        pod.putId(&writing, PARAM_FORMAT)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_FORMAT, INFO_WRITE, c.get32(stream, S_PORT_SERIAL + 12)))
        pod.putId(&writing, PARAM_BUFFERS)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_BUFFERS, 0, c.get32(stream, S_PORT_SERIAL + 16)))
        pod.putId(&writing, PARAM_LATENCY)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_LATENCY, INFO_WRITE, c.get32(stream, S_PORT_SERIAL + 20)))
        pod.putId(&writing, PARAM_TAG)
        pod.putUint(&writing, paramInfoFlags(stream, PARAM_TAG, INFO_WRITE, c.get32(stream, S_PORT_SERIAL + 24)))
        pod.end(&writing, info)
    } else {
        pod.putNone(&writing)
    }
    send(stream, NODE_PORT_UPDATE, &writing, top)
    c.put32(stream, S_PORT_DIRTY, 0)
}

// What changed since the last time, told (emit_node_info, emit_port_info).
fn flushInfo(stream: usize) -> void {
    if c.get32(stream, S_NODE_DIRTY) != 0 { sendUpdate(stream, UPDATE_PARAMS | UPDATE_INFO) }
    if c.get32(stream, S_PORT_DIRTY) != 0 { sendPortUpdate(stream, UPDATE_PARAMS | UPDATE_INFO) }
}

fn sendSetActive(stream: usize, active: bool) -> void {
    const core = c.getPointer(stream, S_CORE)
    if c.getPointer(stream, S_PROXY) == 0 || !core_module.alive(core) { return }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    pod.putBool(&writing, active)
    send(stream, NODE_SET_ACTIVE, &writing, top)
}

// A node event to the server (RequestProcess, when a program asks the
// driver to run a cycle).
fn sendRequestProcess(stream: usize) -> void {
    const core = c.getPointer(stream, S_CORE)
    if c.getPointer(stream, S_PROXY) == 0 || !core_module.alive(core) { return }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    const object = pod.beginObject(&writing, EVENT_NODE, NODE_EVENT_REQUEST_PROCESS)
    pod.end(&writing, object)
    send(stream, NODE_EVENT, &writing, top)
}

// ---------------------------------------------------------------------------
// The stream

// The stream of the core whose client node proxy is `proxy`, 0 for none.
fn ofProxy(proxy: usize) -> usize {
    const core = proxy_module.coreOf(proxy)
    if core == 0 { return 0 }
    var stream = c.getPointer(core, core_module.STREAMS)
    while stream != 0 {
        if c.getPointer(stream, S_PROXY) == proxy { return stream }
        stream = c.getPointer(stream, S_NEXT)
    }
    return 0
}

fn link(core: usize, stream: usize) -> void {
    c.putPointer(stream, S_NEXT, c.getPointer(core, core_module.STREAMS))
    c.putPointer(core, core_module.STREAMS, stream)
}

fn unlink(stream: usize) -> void {
    const core = c.getPointer(stream, S_CORE)
    if core == 0 { return }
    var at = c.getPointer(core, core_module.STREAMS)
    var before: usize = 0
    while at != 0 && at != stream {
        before = at
        at = c.getPointer(at, S_NEXT)
    }
    if at == 0 { return }
    if before == 0 { c.putPointer(core, core_module.STREAMS, c.getPointer(stream, S_NEXT)) } else { c.putPointer(before, S_NEXT, c.getPointer(stream, S_NEXT)) }
}

// A stream named `name` with `props` (taken over): on `core`, or on
// `context` without a core yet (pw_stream_new_simple: connected when the
// stream is). 0 when there is no memory.
pub fn new(core: usize, context: usize, name: usize, props: usize) -> usize {
    const stream = c.alloc(SIZE)
    var owned = props
    if owned == 0 { owned = properties.new() }
    const port_props = properties.new()
    const params = c.alloc(MAX_PARAMS * PARAM)
    const buffers = c.alloc(MAX_BUFFERS * BUFFER)
    const dequeued = c.alloc(RING)
    const queued = c.alloc(RING)
    if stream == 0 || owned == 0 || port_props == 0 || params == 0 || buffers == 0 || dequeued == 0 || queued == 0 {
        c.release(stream)
        properties.free(owned)
        properties.free(port_props)
        c.release(params)
        c.release(buffers)
        c.release(dequeued)
        c.release(queued)
        return 0
    }
    if name != 0 && properties.get(owned, "media.name") == 0 { const set = properties.set(owned, "media.name", name) }
    if properties.get(owned, "stream.is-live") == 0 { const set = properties.setText(owned, "stream.is-live", "true") }
    if properties.get(owned, "node.name") == 0 {
        var node_name: usize = 0
        if core != 0 {
            node_name = properties.get(core_module.propertiesOf(core), "application.name")
            if node_name == 0 { node_name = properties.get(core_module.propertiesOf(core), "application.process.binary") }
        }
        if node_name == 0 { node_name = name }
        if node_name != 0 { const set = properties.set(owned, "node.name", node_name) }
    }
    if properties.get(owned, "node.want-driver") == 0 { const set = properties.setText(owned, "node.want-driver", "true") }
    c.putPointer(stream, S_CORE, core)
    c.putPointer(stream, S_CONTEXT, if core != 0 { core_module.contextOf(core) } else { context })
    c.putPointer(stream, S_NAME, c.duplicateC(name))
    c.putPointer(stream, S_PROPERTIES, owned)
    c.putPointer(stream, S_PORT_PROPERTIES, port_props)
    c.putPointer(stream, S_PARAMS, params)
    c.putPointer(stream, S_BUFFERS, buffers)
    c.putPointer(stream, S_DEQUEUED, dequeued)
    c.putPointer(stream, S_QUEUED, queued)
    c.put32(stream, S_NODE_ID, INVALID)
    c.put32(stream, S_CLOCK_ID, INVALID)
    c.putPointer(stream, S_READ_FD, @bitCast(usize, @intCast(isize, -1)))
    c.putPointer(stream, S_WRITE_FD, @bitCast(usize, @intCast(isize, -1)))
    hooks.init(stream + S_LISTENERS)
    if core != 0 { link(core, stream) }
    return stream
}

pub fn addListener(stream: usize, hook: usize, events: usize, data: usize) -> void { hooks.append(stream + S_LISTENERS, hook, events, data) }

// pw_stream_new_simple: the context is the stream's own (freed with it),
// and the listener's hook lives in the stream.
pub fn ownContext(stream: usize) -> void { c.put32(stream, S_OWN_CONTEXT, 1) }

pub fn addOwnListener(stream: usize, events: usize, data: usize) -> void { hooks.append(stream + S_LISTENERS, stream + S_OWN_HOOK, events, data) }

pub fn nameOf(stream: usize) -> usize { return c.getPointer(stream, S_NAME) }

pub fn coreOf(stream: usize) -> usize { return c.getPointer(stream, S_CORE) }

pub fn propertiesOf(stream: usize) -> usize { return c.getPointer(stream, S_PROPERTIES) }

pub fn nodeId(stream: usize) -> u32 { return c.get32(stream, S_NODE_ID) }

pub fn errorOf(stream: usize) -> usize { return c.getPointer(stream, S_ERROR) }

pub fn isDriving(stream: usize) -> bool { return c.get32(stream, S_DRIVING) != 0 }

fn setProperty(props: usize, key: []const u8, value: []const u8, keep: bool) -> void {
    if keep && properties.get(props, key) != 0 { return }
    const set = properties.setText(props, key, value)
}

// pw_stream_connect.
pub fn connect(stream: usize, direction: u32, target_id: u32, flags: u32, params: usize, count: u32) -> i32 {
    if c.getPointer(stream, S_PROXY) != 0 || stateOf(stream) != UNCONNECTED { return util.EBUSY }
    c.put32(stream, S_DIRECTION, if direction == 0 { 0 } else { 1 })
    c.put32(stream, S_FLAGS, flags)
    clearParams(stream, INVALID)
    var index: usize = 0
    while index < @intCast(usize, count) {
        const added = addParam(stream, INVALID, 0, c.getPointer(params, index * 8))
        index += 1
    }
    addOwnParams(stream)
    findFormat(stream)
    c.put32(stream, S_DISCONNECTING, 0)
    c.put32(stream, S_DRAINED, 0)
    c.put32(stream, S_DRAINING, 0)
    c.put32(stream, S_DRIVING, 0)
    c.put32(stream, S_TRIGGER, 0)
    c.put32(stream, S_USING_TRIGGER, 0)
    c.put32(stream, S_HAVE_TRANSPORT, 0)
    c.put32(stream, S_ACTIVE, if flags & FLAG_INACTIVE != 0 { 0 } else { 1 })
    const changed = setState(stream, CONNECTING, 0, 0)
    const props = c.getPointer(stream, S_PROPERTIES)
    if target_id != INVALID && properties.get(props, "node.target") == 0 {
        var digits: [24]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &digits) }
        const length = util.decimal(bytes, @intCast(u64, target_id))
        const set = properties.setText(props, "node.target", bytes[0..length])
    }
    if flags & FLAG_AUTOCONNECT != 0 { setProperty(props, "node.autoconnect", "true", true) }
    if flags & FLAG_EXCLUSIVE != 0 { setProperty(props, "node.exclusive", "true", true) }
    if flags & FLAG_DONT_RECONNECT != 0 { setProperty(props, "node.dont-reconnect", "true", true) }
    if flags & FLAG_DRIVER != 0 { setProperty(props, "node.driver", "true", false) }
    if flags & FLAG_TRIGGER != 0 {
        setProperty(props, "node.trigger", "true", false)
        c.put32(stream, S_TRIGGER, 1)
    }
    if properties.get(props, "media.class") == 0 {
        var class: [96]u8 = undefined
        var out = c.out(@intFromPtr(&class), 96)
        c.append(&out, "Stream/")
        c.append(&out, if direction == 0 { "Input/" } else { "Output/" })
        const media_type = properties.get(props, "media.type")
        c.append(&out, if media_type != 0 { c.slice(media_type) } else { mediaClass(stream) })
        const set = properties.setText(props, "media.class", c.slice(@intFromPtr(&class)))
    }
    const dsp = properties.get(props, "format.dsp")
    if dsp != 0 {
        const set = properties.set(c.getPointer(stream, S_PORT_PROPERTIES), "format.dsp", dsp)
    } else if c.get32(stream, S_MEDIA_TYPE) == MEDIA_APPLICATION && c.get32(stream, S_MEDIA_SUBTYPE) == SUBTYPE_CONTROL {
        setProperty(c.getPointer(stream, S_PORT_PROPERTIES), "format.dsp", "8 bit raw midi", false)
    }
    const node = c.environment("PIPEWIRE_NODE")
    if node.length > 0 { setProperty(props, "target.object", node, false) }
    const autoconnect = c.environment("PIPEWIRE_AUTOCONNECT")
    if autoconnect.length > 0 { setProperty(props, "node.autoconnect", if properties.parseBool(autoconnect) { "true" } else { "false" }, false) }
    const extra = c.environment("PIPEWIRE_PROPS")
    if extra.length > 0 { const updated = properties.updateString(props, extra) }
    const latency = c.environment("PIPEWIRE_LATENCY")
    if latency.length > 0 { setProperty(props, "node.latency", latency, false) }
    const rate = c.environment("PIPEWIRE_RATE")
    if rate.length > 0 { setProperty(props, "node.rate", rate, false) }
    // A stream made without a core (pw_stream_new_simple) connects now.
    var core = c.getPointer(stream, S_CORE)
    if core == 0 {
        core = core_module.connect(c.getPointer(stream, S_CONTEXT), properties.copy(props), 0)
        if core == 0 {
            const failed = setState(stream, UNCONNECTED, util.EIO, 0)
            return util.EIO
        }
        c.putPointer(stream, S_CORE, core)
        c.put32(stream, S_DISCONNECT_CORE, 1)
        link(core, stream)
    }
    const proxy = core_module.createObject(core, c.literal("client-node"), c.literal("PipeWire:Interface:ClientNode"), 5, props, 0)
    if proxy == 0 {
        const failed = setState(stream, UNCONNECTED, util.EIO, 0)
        return util.EIO
    }
    c.putPointer(stream, S_PROXY, proxy)
    sendUpdate(stream, UPDATE_PARAMS | UPDATE_INFO)
    sendPortUpdate(stream, UPDATE_PARAMS | UPDATE_INFO)
    return 0
}

fn dropMapping(stream: usize, pointer: usize, base: usize, length: usize) -> void {
    core_module.unmap(c.getPointer(stream, base), c.getPointer(stream, length))
    c.putPointer(stream, pointer, 0)
    c.putPointer(stream, base, 0)
    c.putPointer(stream, length, 0)
}

fn dropLink(stream: usize, index: usize) -> void {
    const entry = stream + S_LINKS + index * LINK
    core_module.unmap(c.getPointer(entry, L_BASE), c.getPointer(entry, L_LEN))
    c.close(@intCast(isize, @bitCast(i32, c.get32(entry, L_FD))))
    const count = @intCast(usize, c.get32(stream, S_LINK_COUNT))
    var at = index
    while at + 1 < count {
        c.copy(stream + S_LINKS + at * LINK, stream + S_LINKS + (at + 1) * LINK, LINK)
        at += 1
    }
    c.put32(stream, S_LINK_COUNT, @intCast(u32, count - 1))
}

// The transport, io areas, links and buffers go (the node is no more).
fn cleanTransport(stream: usize) -> void {
    clearBuffers(stream)
    while c.get32(stream, S_LINK_COUNT) > 0 { dropLink(stream, 0) }
    const source = c.getPointer(stream, S_DATA_SOURCE)
    if source != 0 {
        loop_module.destroySource(core_module.loopOf(c.getPointer(stream, S_CORE)), source)
        c.putPointer(stream, S_DATA_SOURCE, 0)
    }
    c.close(@bitCast(isize, c.getPointer(stream, S_READ_FD)))
    c.close(@bitCast(isize, c.getPointer(stream, S_WRITE_FD)))
    c.putPointer(stream, S_READ_FD, @bitCast(usize, @intCast(isize, -1)))
    c.putPointer(stream, S_WRITE_FD, @bitCast(usize, @intCast(isize, -1)))
    dropMapping(stream, S_ACTIVATION, S_ACTIVATION_BASE, S_ACTIVATION_LEN)
    dropMapping(stream, S_CLOCK, S_CLOCK_BASE, S_CLOCK_LEN)
    dropMapping(stream, S_POSITION, S_POSITION_BASE, S_POSITION_LEN)
    dropMapping(stream, S_IO, S_IO_BASE, S_IO_LEN)
    dropMapping(stream, S_RATE_MATCH, S_RATE_MATCH_BASE, S_RATE_MATCH_LEN)
    c.put32(stream, S_HAVE_TRANSPORT, 0)
    c.put32(stream, S_DRIVING, 0)
}

// pw_stream_disconnect: the node goes (the server answers with RemoveId,
// which makes the stream unconnected).
pub fn disconnect(stream: usize) -> i32 {
    if c.get32(stream, S_DISCONNECTING) != 0 { return util.EBUSY }
    c.put32(stream, S_DISCONNECTING, 1)
    const proxy = c.getPointer(stream, S_PROXY)
    if proxy != 0 {
        if c.get32(stream, S_HAVE_TRANSPORT) != 0 { sendSetActive(stream, false) }
        cleanTransport(stream)
        core_module.destroyProxy(proxy)
    }
    if c.get32(stream, S_DISCONNECT_CORE) != 0 {
        c.put32(stream, S_DISCONNECT_CORE, 0)
        const core = c.getPointer(stream, S_CORE)
        unlink(stream)
        c.putPointer(stream, S_CORE, 0)
        const disconnected = core_module.disconnect(core)
    }
    return 0
}

// pw_stream_destroy.
pub fn free(stream: usize) -> void {
    if stream == 0 || c.get32(stream, S_DESTROYED) != 0 { return }
    c.put32(stream, S_DESTROYED, 1)
    emit0(stream, EVENT_DESTROY, 0)
    if c.get32(stream, S_DISCONNECTING) == 0 { const disconnected = disconnect(stream) }
    unlink(stream)
    clearParams(stream, INVALID)
    var index: usize = 0
    while index < @intCast(usize, c.get32(stream, S_PARAM_COUNT)) {
        c.release(c.getPointer(paramAt(stream, index), P_POD))
        index += 1
    }
    hooks.clean(stream + S_LISTENERS)
    c.release(c.getPointer(stream, S_ERROR))
    c.release(c.getPointer(stream, S_NAME))
    properties.free(c.getPointer(stream, S_PROPERTIES))
    properties.free(c.getPointer(stream, S_PORT_PROPERTIES))
    c.release(c.getPointer(stream, S_PARAMS))
    c.release(c.getPointer(stream, S_BUFFERS))
    c.release(c.getPointer(stream, S_DEQUEUED))
    c.release(c.getPointer(stream, S_QUEUED))
    if c.get32(stream, S_OWN_CONTEXT) != 0 { context_module.free(c.getPointer(stream, S_CONTEXT)) }
    c.release(stream)
}

// The core's streams, when the connection went (they are unconnected) and
// when the core is destroyed (they go).
pub fn disconnectAll(core: usize) -> void {
    var stream = c.getPointer(core, core_module.STREAMS)
    while stream != 0 {
        const next = c.getPointer(stream, S_NEXT)
        const disconnected = disconnect(stream)
        stream = next
    }
}

pub fn destroyAll(core: usize) -> void {
    while c.getPointer(core, core_module.STREAMS) != 0 { free(c.getPointer(core, core_module.STREAMS)) }
}

// The connection broke: the streams are unconnected.
pub fn coreBroke(core: usize) -> void {
    var stream = c.getPointer(core, core_module.STREAMS)
    while stream != 0 {
        const changed = setState(stream, UNCONNECTED, util.EPIPE, c.literal("connection error"))
        stream = c.getPointer(stream, S_NEXT)
    }
}

// The proxy's events (core.mlx calls them for a client node proxy).

// BoundId: the node has its global id; the stream is paused (ready).
pub fn bound(proxy: usize, global: u32, dict: usize) -> void {
    const stream = ofProxy(proxy)
    if stream == 0 { return }
    c.put32(stream, S_NODE_ID, global)
    if dict != 0 { const updated = properties.update(c.getPointer(stream, S_PROPERTIES), dict) }
    const changed = setState(stream, PAUSED, 0, 0)
}

// RemoveId or the proxy destroyed: unconnected.
pub fn proxyGone(proxy: usize) -> void {
    const stream = ofProxy(proxy)
    if stream == 0 { return }
    cleanTransport(stream)
    c.putPointer(stream, S_PROXY, 0)
    c.put32(stream, S_NODE_ID, INVALID)
    const changed = setState(stream, UNCONNECTED, 0, 0)
}

// An error on the node: the program hears of it, the state stays (a
// pw_stream_set_error makes it permanent).
pub fn proxyError(proxy: usize, seq: i32, result: i32, message: usize) -> void {
    const stream = ofProxy(proxy)
    if stream == 0 { return }
    emit3(stream, EVENT_STATE_CHANGED, 0, c.int(stateOf(stream)), c.int(ERROR), message)
}

// pw_stream_set_error.
pub fn setError(stream: usize, result: i32, message: usize) -> i32 {
    if result >= 0 { return result }
    const proxy = c.getPointer(stream, S_PROXY)
    const core = c.getPointer(stream, S_CORE)
    if proxy != 0 && core_module.alive(core) { const sent = core_module.sendError(core, proxy_module.idOf(proxy), @bitCast(i32, core_module.receivedSequence(core)), result, message) }
    const changed = setState(stream, ERROR, result, message)
    return result
}

// pw_stream_set_active.
pub fn setActive(stream: usize, active: bool) -> i32 {
    if c.getPointer(stream, S_PROXY) == 0 { return util.EIO }
    c.put32(stream, S_ACTIVE, if active { 1 } else { 0 })
    if c.get32(stream, S_HAVE_TRANSPORT) != 0 { sendSetActive(stream, active) }
    if !active || c.get32(stream, S_DRAINED) != 0 {
        c.put32(stream, S_DRAINED, 0)
        c.put32(stream, S_DRAINING, 0)
    }
    return 0
}

// pw_stream_update_params.
pub fn updateParamsFromProgram(stream: usize, params: usize, count: u32) -> i32 {
    const result = updateParams(stream, params, count)
    if result < 0 { return result }
    if c.get32(stream, S_IN_EMIT) == 0 { flushInfo(stream) }
    return 0
}

// pw_stream_update_properties: the node's info tells the server.
pub fn updateProperties(stream: usize, dict: usize) -> i32 {
    const changed = properties.update(c.getPointer(stream, S_PROPERTIES), dict)
    if changed > 0 && c.getPointer(stream, S_PROXY) != 0 {
        c.put32(stream, S_NODE_DIRTY, 1)
        if c.get32(stream, S_IN_EMIT) == 0 { sendUpdate(stream, UPDATE_INFO) }
    }
    return 0
}

// pw_stream_set_param: Props are the only ones a node takes.
pub fn setParam(stream: usize, id: u32, address: usize) -> i32 {
    if c.getPointer(stream, S_PROXY) == 0 { return util.EIO }
    if id != PARAM_PROPS { return util.ENOTSUP }
    emitParamChanged(stream, id, address)
    if stateOf(stream) == ERROR { return @bitCast(i32, c.get32(stream, S_ERROR_RES)) }
    flushInfo(stream)
    return 0
}

// ---------------------------------------------------------------------------
// Running

fn now() -> u64 { return c.monotonicNanoseconds() }

// The time from the position area (copy_position): the clock, the ticks
// since this stream's clock began, what is queued.
fn copyPosition(stream: usize, queued: u64) -> void {
    const position = c.getPointer(stream, S_POSITION)
    if position != 0 {
        c.put64(stream + S_TIME, 0, c.get64(position, POSITION_NSEC))
        c.put64(stream + S_TIME, 8, c.get64(position, POSITION_RATE))
        const id = c.get32(position, POSITION_CLOCK_ID)
        if c.get32(stream, S_CLOCK_ID) != id {
            c.put64(stream, S_BASE_POS, c.get64(position, POSITION_POSITION) - c.get64(stream + S_TIME, 16))
            c.put32(stream, S_CLOCK_ID, id)
        }
        c.put64(stream + S_TIME, 16, c.get64(position, POSITION_POSITION) - c.get64(stream, S_BASE_POS))
        c.put64(stream + S_TIME, 24, 0)
        c.put64(stream + S_TIME, 32, queued)
        c.put64(stream, S_QUANTUM, c.get64(position, POSITION_DURATION))
    }
    const rate_match = c.getPointer(stream, S_RATE_MATCH)
    if rate_match != 0 {
        c.put32(stream, S_RATE_QUEUED, c.get32(rate_match, 0))
        c.put64(stream, S_RATE_SIZE, @intCast(u64, c.get32(rate_match, 4)))
    } else {
        c.put32(stream, S_RATE_QUEUED, 0)
        c.put64(stream, S_RATE_SIZE, c.get64(stream, S_QUANTUM))
    }
}

// process to the program (call_process): an output stream is asked when it
// has a buffer to fill (its `requested` set).
fn callProcess(stream: usize) -> void {
    if c.get32(stream, S_BUFFER_COUNT) == 0 { return }
    if c.get32(stream, S_DIRECTION) == 1 {
        const id = ringPeek(c.getPointer(stream, S_DEQUEUED))
        const buffer = bufferAt(stream, id)
        if buffer == 0 && c.get32(stream, S_USING_TRIGGER) == 0 { return }
        if buffer != 0 {
            c.put64(buffer, B_REQUESTED, c.get64(stream, S_RATE_SIZE))
            if c.get64(buffer, B_REQUESTED) == 0 { return }
        }
    }
    emit0(stream, EVENT_PROCESS, 0)
}

// An input stream's cycle (impl_node_process_input): the buffer the io
// area names is for the program; what the program gave back goes into
// the io area.
fn processInput(stream: usize) -> void {
    const io = c.getPointer(stream, S_IO)
    if io == 0 { return }
    var buffer: usize = 0
    if c.get32(io, 0) == STATUS_HAVE_DATA {
        buffer = bufferAt(stream, c.get32(io, 4))
        if buffer != 0 { const pushed = pushDequeued(stream, buffer) }
    }
    copyPosition(stream, c.get64(stream, S_DEQUEUED_IN))
    if buffer != 0 { c.put64(buffer, B_TIME, c.get64(stream + S_TIME, 0)) }
    if ringCount(c.getPointer(stream, S_DEQUEUED)) > 0 { callProcess(stream) }
    if c.get32(io, 0) != STATUS_NEED_DATA || c.get32(io, 4) == INVALID {
        const recycled = popQueued(stream)
        c.put32(io, 4, if recycled != 0 { c.get32(recycled, B_ID) } else { INVALID })
        c.put32(io, 0, STATUS_NEED_DATA)
    }
    if c.get32(stream, S_DRIVING) != 0 && c.get32(stream, S_USING_TRIGGER) != 0 { emit0(stream, EVENT_TRIGGER_DONE, 2) }
}

// An output stream's cycle (impl_node_process_output): the buffer the
// program queued goes to the server, the one the server is done with
// comes back for the program.
fn processOutput(stream: usize) -> void {
    const io = c.getPointer(stream, S_IO)
    if io == 0 { return }
    var ask_more = false
    if c.get32(io, 0) != STATUS_HAVE_DATA {
        const recycled = bufferAt(stream, c.get32(io, 4))
        if recycled != 0 { const pushed = pushDequeued(stream, recycled) }
        const next = popQueued(stream)
        if next != 0 {
            c.put32(stream, S_DRAINED, 0)
            c.put32(io, 4, c.get32(next, B_ID))
            c.put32(io, 0, STATUS_HAVE_DATA)
            ask_more = ringCount(c.getPointer(stream, S_QUEUED)) == 0 && ringCount(c.getPointer(stream, S_DEQUEUED)) > 0
        } else if c.get32(stream, S_DRAINING) != 0 || c.get32(stream, S_DRAINED) != 0 {
            c.put32(stream, S_DRAINING, 1)
            c.put32(stream, S_DRAINED, 1)
            c.put32(io, 4, INVALID)
            c.put32(io, 0, STATUS_DRAINED)
        } else {
            c.put32(io, 4, INVALID)
            c.put32(io, 0, STATUS_NEED_DATA)
            ask_more = true
        }
    } else {
        ask_more = ringCount(c.getPointer(stream, S_QUEUED)) == 0 && ringCount(c.getPointer(stream, S_DEQUEUED)) > 0
    }
    copyPosition(stream, c.get64(stream, S_QUEUED_OUT))
    if c.get32(stream, S_DRAINING) == 0 && c.get32(stream, S_DRIVING) == 0 && ask_more { callProcess(stream) }
    if c.get32(stream, S_DRIVING) != 0 && c.get32(stream, S_USING_TRIGGER) != 0 && c.get32(io, 0) != STATUS_HAVE_DATA { emit0(stream, EVENT_TRIGGER_DONE, 2) }
}

// A cycle: the node awake, its process, finished, and the drivers it
// links to counted down (the last one to finish triggers them).
fn cycle(stream: usize) -> void {
    const activation = c.getPointer(stream, S_ACTIVATION)
    const started = now()
    if activation != 0 {
        c.put32(activation, ACTIVATION_STATUS, AWAKE)
        c.put64(activation, ACTIVATION_AWAKE_TIME, started)
    }
    if c.get32(stream, S_DIRECTION) == 0 { processInput(stream) } else { processOutput(stream) }
    const finished = now()
    if activation != 0 {
        c.put32(activation, ACTIVATION_STATUS, FINISHED)
        c.put64(activation, ACTIVATION_FINISH_TIME, finished)
    }
    var index: usize = 0
    while index < @intCast(usize, c.get32(stream, S_LINK_COUNT)) {
        const entry = stream + S_LINKS + index * LINK
        const target = c.getPointer(entry, L_PTR)
        const pending = @bitCast(i32, c.get32(target, ACTIVATION_PENDING)) - 1
        c.put32(target, ACTIVATION_PENDING, @bitCast(u32, pending))
        if pending == 0 {
            c.put32(target, ACTIVATION_STATUS, TRIGGERED)
            c.put64(target, ACTIVATION_SIGNAL_TIME, finished)
            c.bump(@intCast(isize, @bitCast(i32, c.get32(entry, L_FD))))
        }
        index += 1
    }
    if c.get32(stream, S_DRAINING) != 0 && c.get32(stream, S_DRAINED) != 0 {
        c.put32(stream, S_DRAINING, 0)
        const io = c.getPointer(stream, S_IO)
        if io != 0 { c.put32(io, 0, STATUS_NEED_DATA) }
        emit0(stream, EVENT_DRAINED, 0)
    }
}

// The server woke the node (its counter).
export fn mlx_pw_stream_on_wake(stream: usize, fd: i32, mask: u32) -> void {
    var count: u64 = 0
    const got = std.linux.syscall3(0, c.int(fd), @intFromPtr(&count), 8)
    if got != 8 || c.getPointer(stream, S_PROXY) == 0 { return }
    cycle(stream)
}

// pw_stream_dequeue_buffer: the next buffer for the program (0: none).
pub fn dequeueBuffer(stream: usize) -> usize { return popDequeued(stream) }

// pw_stream_queue_buffer: a buffer the program is done with.
pub fn queueBuffer(stream: usize, buffer: usize) -> i32 {
    if buffer == 0 || bufferAt(stream, c.get32(buffer, B_ID)) != buffer { return util.EINVAL }
    if !pushQueued(stream, buffer) { return util.EINVAL }
    // An output stream driving the graph without pw_stream_trigger_process:
    // its cycle runs now (the old way).
    if c.get32(stream, S_DIRECTION) == 1 && c.get32(stream, S_DRIVING) != 0 && c.get32(stream, S_USING_TRIGGER) == 0 { cycle(stream) }
    return 0
}

// pw_stream_flush: the buffers back where they came from, or draining.
pub fn flush(stream: usize, drain: bool) -> i32 {
    if c.getPointer(stream, S_PROXY) == 0 { return util.EIO }
    if drain {
        c.put32(stream, S_DRAINING, 1)
        c.put32(stream, S_DRAINED, 0)
        return 0
    }
    if c.get32(stream, S_DIRECTION) == 1 {
        while true {
            const buffer = popQueued(stream)
            if buffer == 0 { break }
            const pushed = pushDequeued(stream, buffer)
        }
    } else {
        while true {
            const buffer = popDequeued(stream)
            if buffer == 0 { break }
            const pushed = pushQueued(stream, buffer)
        }
    }
    c.put64(stream, S_QUEUED_OUT, 0)
    c.put64(stream, S_DEQUEUED_IN, 0)
    c.put64(stream, S_DEQUEUED_OUT, 0)
    c.put64(stream, S_QUEUED_IN, 0)
    return 0
}

// pw_stream_trigger_process: a driver runs its cycle; a follower asks the
// driver for one.
pub fn triggerProcess(stream: usize) -> i32 {
    c.put32(stream, S_USING_TRIGGER, 1)
    if c.get32(stream, S_DRIVING) != 0 {
        if c.get32(stream, S_DIRECTION) == 1 { callProcess(stream) }
        cycle(stream)
    } else {
        sendRequestProcess(stream)
    }
    return 0
}

// pw_stream_get_time_n: struct pw_time (now, rate, ticks, delay, queued,
// buffered, queued_buffers, avail_buffers, size), as much of it as `size`
// says.
pub fn time(stream: usize, out: usize, size: usize) -> i32 {
    var total = size
    if total > 64 { total = 64 }
    c.copy(out, stream + S_TIME, total)
    const dequeued = c.get64(stream, S_DEQUEUED_OUT)
    const queued = c.get64(stream, S_QUEUED_IN)
    if total >= 40 {
        if c.get32(stream, S_DIRECTION) == 0 {
            c.put64(out, 32, c.get64(stream + S_TIME, 32) - dequeued)
        } else {
            c.put64(out, 32, queued - c.get64(stream + S_TIME, 32))
        }
    }
    const available = ringCount(c.getPointer(stream, S_DEQUEUED))
    const count = c.get32(stream, S_BUFFER_COUNT)
    if total >= 48 { c.put64(out, 40, @intCast(u64, c.get32(stream, S_RATE_QUEUED))) }
    if total >= 52 { c.put32(out, 48, if available > count { 0 } else { count - available }) }
    if total >= 56 { c.put32(out, 52, if available > count { count } else { available }) }
    if total >= 64 { c.put64(out, 56, c.get64(stream, S_RATE_SIZE)) }
    return 0
}

// ---------------------------------------------------------------------------
// The client node's events

pub fn event(core: usize, proxy: usize, opcode: u32, body: [*]const u8, payload: pod.Pod) -> void {
    const stream = ofProxy(proxy)
    if stream == 0 { return }
    var cursor = pod.children(body, payload)
    if opcode == EVENT_TRANSPORT {
        transport(stream, body, &cursor)
    } else if opcode == EVENT_SET_PARAM {
        const id = pod.uintOf(body, pod.next(&cursor))
        const flags = pod.next(&cursor)
        const param = core_module.podAddress(body, pod.next(&cursor))
        if id == PARAM_PROPS {
            emitParamChanged(stream, id, param)
            if stateOf(stream) != ERROR { flushInfo(stream) }
        }
    } else if opcode == EVENT_SET_IO {
        setIo(stream, body, &cursor)
    } else if opcode == EVENT_COMMAND_IN {
        command(stream, body, pod.next(&cursor))
    } else if opcode == EVENT_ADD_PORT || opcode == EVENT_REMOVE_PORT {
        const sent = core_module.sendError(core, proxy_module.idOf(proxy), @bitCast(i32, core_module.receivedSequence(core)), util.ENOTSUP, c.literal("add port not supported"))
    } else if opcode == EVENT_PORT_SET_PARAM {
        portSetParam(stream, body, &cursor)
    } else if opcode == EVENT_PORT_USE_BUFFERS {
        portUseBuffers(stream, body, &cursor)
    } else if opcode == EVENT_PORT_SET_IO {
        portSetIo(stream, body, &cursor)
    } else if opcode == EVENT_SET_ACTIVATION {
        setActivation(stream, body, &cursor)
    }
    // Event (unhandled, as PipeWire's own node) and PortSetMixInfo (the
    // peer's id: nothing to keep) pass.
}

// Maps `size` bytes at `offset` of shared memory `memid` into the stream's
// fields (pointer, base, length); the pointer, 0 when it could not.
fn mapInto(stream: usize, memid: u32, offset: u32, size: u32, pointer: usize, base: usize, length: usize) -> usize {
    dropMapping(stream, pointer, base, length)
    if memid == INVALID || size == 0 { return 0 }
    const fd = core_module.memFd(c.getPointer(stream, S_CORE), memid)
    if fd < 0 { return 0 }
    var mapped_base: usize = 0
    var mapped_length: usize = 0
    const address = core_module.mapRange(fd, @intCast(usize, offset), @intCast(usize, size), &mapped_base, &mapped_length)
    c.putPointer(stream, pointer, address)
    c.putPointer(stream, base, mapped_base)
    c.putPointer(stream, length, mapped_length)
    return address
}

// Transport(readfd, writefd, memid, offset, size): the node's activation
// record and the counter it waits on; from here on it is a node.
fn transport(stream: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const core = c.getPointer(stream, S_CORE)
    const read_index = pod.longOf(body, pod.next(cursor))
    const write_index = pod.longOf(body, pod.next(cursor))
    const memid = pod.uintOf(body, pod.next(cursor))
    const offset = pod.uintOf(body, pod.next(cursor))
    const size = pod.uintOf(body, pod.next(cursor))
    cleanTransport(stream)
    const read_fd = core_module.takeFd(core, read_index)
    const write_fd = core_module.takeFd(core, write_index)
    c.putPointer(stream, S_READ_FD, @bitCast(usize, read_fd))
    c.putPointer(stream, S_WRITE_FD, @bitCast(usize, write_fd))
    const activation = mapInto(stream, memid, offset, size, S_ACTIVATION, S_ACTIVATION_BASE, S_ACTIVATION_LEN)
    if activation == 0 || read_fd < 0 {
        const sent = core_module.sendError(core, proxy_module.idOf(c.getPointer(stream, S_PROXY)), @bitCast(i32, core_module.receivedSequence(core)), util.EIO, c.literal("can't map activation"))
        return
    }
    const source = loop_module.addIo(core_module.loopOf(core), read_fd, 1, false, @intFromPtr(mlx_pw_stream_on_wake), stream)
    c.putPointer(stream, S_DATA_SOURCE, source)
    c.put32(stream, S_HAVE_TRANSPORT, 1)
    if c.get32(stream, S_ACTIVE) != 0 { sendSetActive(stream, true) }
}

// SetIO(id, memid, offset, size): the clock and the position areas.
fn setIo(stream: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const id = pod.uintOf(body, pod.next(cursor))
    const memid = pod.uintOf(body, pod.next(cursor))
    const offset = pod.uintOf(body, pod.next(cursor))
    const size = pod.uintOf(body, pod.next(cursor))
    var address: usize = 0
    if id == IO_CLOCK {
        address = mapInto(stream, memid, offset, size, S_CLOCK, S_CLOCK_BASE, S_CLOCK_LEN)
        if size < @intCast(u32, CLOCK_SIZE) { dropMapping(stream, S_CLOCK, S_CLOCK_BASE, S_CLOCK_LEN) }
    } else if id == IO_POSITION {
        address = mapInto(stream, memid, offset, size, S_POSITION, S_POSITION_BASE, S_POSITION_LEN)
        if size < @intCast(u32, POSITION_SIZE) { dropMapping(stream, S_POSITION, S_POSITION_BASE, S_POSITION_LEN) }
    } else {
        return
    }
    const clock = c.getPointer(stream, S_CLOCK)
    const position = c.getPointer(stream, S_POSITION)
    c.put32(stream, S_DRIVING, if clock != 0 && position != 0 && c.get32(position, POSITION_CLOCK_ID) == c.get32(clock, POSITION_CLOCK_ID) { 1 } else { 0 })
    emit3(stream, EVENT_IO_CHANGED, 0, @intCast(usize, id), address, @intCast(usize, size))
}

// Command(command): Start, Pause, Suspend, Flush.
fn command(stream: usize, body: [*]const u8, value: pod.Pod) -> void {
    const id = pod.objectId(body, value)
    if pod.objectType(body, value) != COMMAND_NODE { return }
    if id == COMMAND_SUSPEND || id == COMMAND_PAUSE || id == COMMAND_FLUSH {
        if stateOf(stream) == STREAMING { const changed = setState(stream, PAUSED, 0, 0) }
    } else if id == COMMAND_START {
        if stateOf(stream) == PAUSED {
            if c.get32(stream, S_DIRECTION) == 0 {
                const io = c.getPointer(stream, S_IO)
                if io != 0 { c.put32(io, 0, STATUS_NEED_DATA) }
            } else {
                copyPosition(stream, c.get64(stream, S_QUEUED_IN))
                if c.get32(stream, S_DRIVING) == 0 { callProcess(stream) }
            }
            const changed = setState(stream, STREAMING, 0, 0)
            // The node runs: its info says so (the server knows it listens).
            sendUpdate(stream, UPDATE_INFO)
        }
    }
    emit1(stream, EVENT_COMMAND, 1, core_module.podAddress(body, value))
}

// PortSetParam(direction, port, id, flags, param): the Format the server
// chose (the buffers go), or a Latency.
fn portSetParam(stream: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const direction = pod.next(cursor)
    const port = pod.next(cursor)
    const id = pod.uintOf(body, pod.next(cursor))
    const flags = pod.next(cursor)
    const param = core_module.podAddress(body, pod.next(cursor))
    if c.get32(stream, S_DISCONNECTING) != 0 && param != 0 { return }
    clearParams(stream, id)
    if param != 0 { const added = addParam(stream, id, 0, param) }
    if id == PARAM_FORMAT { clearBuffers(stream) }
    emitParamChanged(stream, id, param)
    if stateOf(stream) == ERROR { return }
    flushInfo(stream)
}

// PortUseBuffers(direction, port, mix, flags, n_buffers, buffers...): the
// buffers the server allotted, each a piece of shared memory with its
// metas, chunks and data; mapped, and given to the program (add_buffer).
fn portUseBuffers(stream: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const core = c.getPointer(stream, S_CORE)
    const direction = pod.next(cursor)
    const port = pod.next(cursor)
    const mix = pod.next(cursor)
    const flags = pod.uintOf(body, pod.next(cursor))
    var count = pod.uintOf(body, pod.next(cursor))
    if c.get32(stream, S_DISCONNECTING) != 0 && count > 0 { return }
    clearBuffers(stream)
    if count > @intCast(u32, MAX_BUFFERS) { count = @intCast(u32, MAX_BUFFERS) }
    var id: u32 = 0
    while id < count {
        const buffer = c.getPointer(stream, S_BUFFERS) + @intCast(usize, id) * BUFFER
        c.zero(buffer, BUFFER)
        c.put32(buffer, B_ID, id)
        c.putPointer(buffer, B_SPA_POINTER, buffer + B_SPA)
        c.putPointer(buffer + B_SPA, 8, buffer + B_METAS)
        c.putPointer(buffer + B_SPA, 16, buffer + B_DATAS)
        const memid = pod.uintOf(body, pod.next(cursor))
        const offset = pod.uintOf(body, pod.next(cursor))
        const size = pod.uintOf(body, pod.next(cursor))
        var base: usize = 0
        const fd = core_module.memFd(core, memid)
        if fd >= 0 && size > 0 {
            var mapped_base: usize = 0
            var mapped_length: usize = 0
            base = core_module.mapRange(fd, @intCast(usize, offset), @intCast(usize, size), &mapped_base, &mapped_length)
            c.putPointer(buffer, B_MAP_BASE, mapped_base)
            c.putPointer(buffer, B_MAP_LEN, mapped_length)
            if base != 0 { c.put32(buffer, B_FLAGS, MAPPED) }
        }
        var n_metas = pod.uintOf(body, pod.next(cursor))
        var at: usize = 0
        var meta: u32 = 0
        var kept_metas: u32 = 0
        while meta < n_metas {
            const kind = pod.uintOf(body, pod.next(cursor))
            const meta_size = pod.uintOf(body, pod.next(cursor))
            if kept_metas < @intCast(u32, MAX_METAS) {
                const entry = buffer + B_METAS + @intCast(usize, kept_metas) * META
                c.put32(entry, 0, kind)
                c.put32(entry, 4, meta_size)
                c.putPointer(entry, 8, if base != 0 { base + at } else { 0 })
                kept_metas += 1
            }
            at += (@intCast(usize, meta_size) + 7) / 8 * 8
            meta += 1
        }
        c.put32(buffer + B_SPA, 0, kept_metas)
        var n_datas = pod.uintOf(body, pod.next(cursor))
        var data: u32 = 0
        var kept_datas: u32 = 0
        var total: u64 = 0
        while data < n_datas {
            var kind = pod.uintOf(body, pod.next(cursor))
            const data_id = pod.uintOf(body, pod.next(cursor))
            const data_flags = pod.uintOf(body, pod.next(cursor))
            const mapoffset = pod.uintOf(body, pod.next(cursor))
            const maxsize = pod.uintOf(body, pod.next(cursor))
            if kept_datas < @intCast(u32, MAX_DATAS) {
                const entry = buffer + B_DATAS + @intCast(usize, kept_datas) * DATA
                c.put32(entry, 4, data_flags)
                c.put32(entry, 16, mapoffset)
                c.put32(entry, 20, maxsize)
                c.putPointer(entry, 32, if base != 0 { base + at + @intCast(usize, kept_datas) * CHUNK } else { 0 })
                var data_fd: i64 = -1
                var pointer: usize = 0
                if kind == DATA_MEM_ID {
                    const block = core_module.memFd(core, data_id)
                    if block >= 0 {
                        data_fd = @intCast(i64, block)
                        kind = core_module.memType(core, data_id)
                        // Memory a program wants mapped (MAP_BUFFERS).
                        if kind == DATA_MEM_FD && c.get32(stream, S_FLAGS) & FLAG_MAP_BUFFERS != 0 {
                            var piece_base: usize = 0
                            var piece_length: usize = 0
                            pointer = core_module.mapRange(block, @intCast(usize, mapoffset), @intCast(usize, maxsize), &piece_base, &piece_length)
                        }
                    }
                } else if kind == DATA_MEM_PTR {
                    pointer = if base != 0 { base + @intCast(usize, data_id) } else { 0 }
                }
                c.put32(entry, 0, kind)
                c.put64(entry, 8, @bitCast(u64, data_fd))
                c.putPointer(entry, 24, pointer)
                total += @intCast(u64, maxsize)
                kept_datas += 1
            }
            data += 1
        }
        c.put32(buffer + B_SPA, 4, kept_datas)
        c.put64(buffer, B_SIZE, total)
        id += 1
    }
    c.put32(stream, S_BUFFER_COUNT, count)
    id = 0
    while id < count {
        const buffer = bufferAt(stream, id)
        if c.get32(stream, S_DIRECTION) == 1 { const pushed = pushDequeued(stream, buffer) }
        c.put32(buffer, B_FLAGS, c.get32(buffer, B_FLAGS) | ADDED)
        emit1(stream, EVENT_ADD_BUFFER, 0, buffer)
        id += 1
    }
}

// PortSetIO(direction, port, mix, id, memid, offset, size): the io area the
// buffers are exchanged through, or the rate matching.
fn portSetIo(stream: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const direction = pod.next(cursor)
    const port = pod.next(cursor)
    const mix = pod.next(cursor)
    const id = pod.uintOf(body, pod.next(cursor))
    const memid = pod.uintOf(body, pod.next(cursor))
    const offset = pod.uintOf(body, pod.next(cursor))
    const size = pod.uintOf(body, pod.next(cursor))
    var address: usize = 0
    if id == IO_BUFFERS {
        address = mapInto(stream, memid, offset, size, S_IO, S_IO_BASE, S_IO_LEN)
        if size < 8 { dropMapping(stream, S_IO, S_IO_BASE, S_IO_LEN) }
    } else if id == IO_RATE_MATCH {
        address = mapInto(stream, memid, offset, size, S_RATE_MATCH, S_RATE_MATCH_BASE, S_RATE_MATCH_LEN)
    } else {
        return
    }
    emit3(stream, EVENT_IO_CHANGED, 0, @intCast(usize, id), address, @intCast(usize, size))
}

// SetActivation(node_id, signalfd, memid, offset, size): a node to count
// down and wake when a cycle is done (the driver), or one to forget.
fn setActivation(stream: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const core = c.getPointer(stream, S_CORE)
    const node = pod.uintOf(body, pod.next(cursor))
    const fd_index = pod.longOf(body, pod.next(cursor))
    const memid = pod.uintOf(body, pod.next(cursor))
    const offset = pod.uintOf(body, pod.next(cursor))
    const size = pod.uintOf(body, pod.next(cursor))
    const fd = core_module.takeFd(core, fd_index)
    if memid == INVALID {
        c.close(fd)
        var index: usize = 0
        while index < @intCast(usize, c.get32(stream, S_LINK_COUNT)) {
            if c.get32(stream + S_LINKS + index * LINK, L_NODE) == node {
                dropLink(stream, index)
                return
            }
            index += 1
        }
        return
    }
    const count = @intCast(usize, c.get32(stream, S_LINK_COUNT))
    const block = core_module.memFd(core, memid)
    if count >= MAX_LINKS || block < 0 || fd < 0 {
        c.close(fd)
        return
    }
    var mapped_base: usize = 0
    var mapped_length: usize = 0
    const address = core_module.mapRange(block, @intCast(usize, offset), @intCast(usize, size), &mapped_base, &mapped_length)
    if address == 0 {
        c.close(fd)
        return
    }
    const entry = stream + S_LINKS + count * LINK
    c.put32(entry, L_NODE, node)
    c.put32(entry, L_FD, @bitCast(u32, @intCast(i32, fd)))
    c.putPointer(entry, L_PTR, address)
    c.putPointer(entry, L_BASE, mapped_base)
    c.putPointer(entry, L_LEN, mapped_length)
    c.put32(stream, S_LINK_COUNT, @intCast(u32, count + 1))
}
