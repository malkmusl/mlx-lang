// The server's globals a program binds through the registry: nodes,
// ports, devices, links, factories, modules and metadata. Their events
// (Info, Param, Property) are demarshalled into the info structs C
// expects, made in C memory for the callback and released after it; their
// methods (SubscribeParams, EnumParams, SetParam, SendCommand, SetProperty,
// Clear) go out as the protocol wants them.
const c = @import("../libpulse/c.mlx")
const pod = @import("../capture/pod.mlx")
const hooks = @import("./hooks.mlx")
const core_module = @import("./core.mlx")
const proxy_module = @import("./proxy.mlx")
const process = @import("./process.mlx")
const util = @import("./util.mlx")

// Events of nodes, ports and devices: Info 0, Param 1. Methods: Subscribe-
// Params 1, EnumParams 2, SetParam 3 (nodes and devices), SendCommand 4
// (nodes). Metadata: event Property 0; methods SetProperty 1, Clear 2.
const EVENT_INFO: u32 = 0
const EVENT_PARAM: u32 = 1
const SUBSCRIBE_PARAMS: u32 = 1
const ENUM_PARAMS: u32 = 2
const SET_PARAM: u32 = 3
const SEND_COMMAND: u32 = 4
const METADATA_SET_PROPERTY: u32 = 1
const METADATA_CLEAR: u32 = 2

pub fn tables() -> void {
    var table = hooks.table(5, 0)
    hooks.set(table, 0, @intFromPtr(mlx_pw_object_add_listener))
    hooks.set(table, 1, @intFromPtr(mlx_pw_node_subscribe_params))
    hooks.set(table, 2, @intFromPtr(mlx_pw_node_enum_params))
    hooks.set(table, 3, @intFromPtr(mlx_pw_node_set_param))
    hooks.set(table, 4, @intFromPtr(mlx_pw_node_send_command))
    process.setField(process.NODE_METHODS, table)
    table = hooks.table(3, 0)
    hooks.set(table, 0, @intFromPtr(mlx_pw_object_add_listener))
    hooks.set(table, 1, @intFromPtr(mlx_pw_node_subscribe_params))
    hooks.set(table, 2, @intFromPtr(mlx_pw_node_enum_params))
    process.setField(process.PORT_METHODS, table)
    table = hooks.table(4, 0)
    hooks.set(table, 0, @intFromPtr(mlx_pw_object_add_listener))
    hooks.set(table, 1, @intFromPtr(mlx_pw_node_subscribe_params))
    hooks.set(table, 2, @intFromPtr(mlx_pw_node_enum_params))
    hooks.set(table, 3, @intFromPtr(mlx_pw_node_set_param))
    process.setField(process.DEVICE_METHODS, table)
    table = hooks.table(3, 0)
    hooks.set(table, 0, @intFromPtr(mlx_pw_object_add_listener))
    hooks.set(table, 1, @intFromPtr(mlx_pw_metadata_set_property))
    hooks.set(table, 2, @intFromPtr(mlx_pw_metadata_clear))
    process.setField(process.METADATA_METHODS, table)
    table = hooks.table(1, 0)
    hooks.set(table, 0, @intFromPtr(mlx_pw_object_add_listener))
    process.setField(process.LINK_METHODS, table)
    process.setField(process.FACTORY_METHODS, table)
    process.setField(process.MODULE_METHODS, table)
    // A client node made by a program itself (pw_core_create_object): it may
    // listen; the stream's own one is driven by stream.mlx.
    table = hooks.table(7, 0)
    hooks.set(table, 0, @intFromPtr(mlx_pw_object_add_listener))
    process.setField(process.CLIENT_NODE_METHODS, table)
}

// ---------------------------------------------------------------------------
// Events

// An event of `proxy` (kind `kind`): the payload's Struct read as the
// kind's info or param.
pub fn event(core: usize, proxy: usize, kind: u32, opcode: u32, body: [*]const u8, payload: pod.Pod) -> void {
    var cursor = pod.children(body, payload)
    if kind == proxy_module.KIND_NODE {
        if opcode == EVENT_INFO { nodeInfo(proxy, body, &cursor) } else if opcode == EVENT_PARAM { param(proxy, body, &cursor) }
    } else if kind == proxy_module.KIND_PORT {
        if opcode == EVENT_INFO { portInfo(proxy, body, &cursor) } else if opcode == EVENT_PARAM { param(proxy, body, &cursor) }
    } else if kind == proxy_module.KIND_DEVICE {
        if opcode == EVENT_INFO { deviceInfo(proxy, body, &cursor) } else if opcode == EVENT_PARAM { param(proxy, body, &cursor) }
    } else if kind == proxy_module.KIND_LINK {
        if opcode == EVENT_INFO { linkInfo(proxy, body, &cursor) }
    } else if kind == proxy_module.KIND_FACTORY {
        if opcode == EVENT_INFO { factoryInfo(proxy, body, &cursor) }
    } else if kind == proxy_module.KIND_MODULE {
        if opcode == EVENT_INFO { moduleInfo(proxy, body, &cursor) }
    } else if kind == proxy_module.KIND_METADATA {
        if opcode == 0 { metadataProperty(proxy, body, &cursor) }
    }
}

// struct pw_node_info: id, max_input_ports, max_output_ports, change_mask,
// n_input_ports, n_output_ports, state, error, props, params, n_params.
fn nodeInfo(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const info = c.alloc(72)
    if info == 0 { return }
    c.put32(info, 0, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 4, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 8, pod.uintOf(body, pod.next(cursor)))
    c.put64(info, 16, @bitCast(u64, pod.longOf(body, pod.next(cursor))))
    c.put32(info, 24, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 28, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 32, pod.uintOf(body, pod.next(cursor)))
    c.putPointer(info, 40, core_module.stringAddress(body, pod.next(cursor)))
    const dict = core_module.dictToC(body, pod.next(cursor))
    var count: u32 = 0
    const params = core_module.paramsToC(body, pod.next(cursor), &count)
    c.putPointer(info, 48, dict)
    c.putPointer(info, 56, params)
    c.put32(info, 64, count)
    proxy_module.emit1(proxy, @intCast(usize, EVENT_INFO), info)
    c.release(params)
    c.release(dict)
    c.release(info)
}

// struct pw_port_info: id, direction, change_mask, props, params, n_params.
fn portInfo(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const info = c.alloc(40)
    if info == 0 { return }
    c.put32(info, 0, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 4, pod.uintOf(body, pod.next(cursor)))
    c.put64(info, 8, @bitCast(u64, pod.longOf(body, pod.next(cursor))))
    const dict = core_module.dictToC(body, pod.next(cursor))
    var count: u32 = 0
    const params = core_module.paramsToC(body, pod.next(cursor), &count)
    c.putPointer(info, 16, dict)
    c.putPointer(info, 24, params)
    c.put32(info, 32, count)
    proxy_module.emit1(proxy, @intCast(usize, EVENT_INFO), info)
    c.release(params)
    c.release(dict)
    c.release(info)
}

// struct pw_device_info: id, change_mask, props, params, n_params.
fn deviceInfo(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const info = c.alloc(40)
    if info == 0 { return }
    c.put32(info, 0, pod.uintOf(body, pod.next(cursor)))
    c.put64(info, 8, @bitCast(u64, pod.longOf(body, pod.next(cursor))))
    const dict = core_module.dictToC(body, pod.next(cursor))
    var count: u32 = 0
    const params = core_module.paramsToC(body, pod.next(cursor), &count)
    c.putPointer(info, 16, dict)
    c.putPointer(info, 24, params)
    c.put32(info, 32, count)
    proxy_module.emit1(proxy, @intCast(usize, EVENT_INFO), info)
    c.release(params)
    c.release(dict)
    c.release(info)
}

// struct pw_link_info: id, output_node_id, output_port_id, input_node_id,
// input_port_id, change_mask, state, error, format, props.
fn linkInfo(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const info = c.alloc(64)
    if info == 0 { return }
    c.put32(info, 0, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 4, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 8, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 12, pod.uintOf(body, pod.next(cursor)))
    c.put32(info, 16, pod.uintOf(body, pod.next(cursor)))
    c.put64(info, 24, @bitCast(u64, pod.longOf(body, pod.next(cursor))))
    c.put32(info, 32, pod.uintOf(body, pod.next(cursor)))
    c.putPointer(info, 40, core_module.stringAddress(body, pod.next(cursor)))
    c.putPointer(info, 48, core_module.podAddress(body, pod.next(cursor)))
    const dict = core_module.dictToC(body, pod.next(cursor))
    c.putPointer(info, 56, dict)
    proxy_module.emit1(proxy, @intCast(usize, EVENT_INFO), info)
    c.release(dict)
    c.release(info)
}

// struct pw_factory_info: id, name, type, version, change_mask, props.
fn factoryInfo(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const info = c.alloc(48)
    if info == 0 { return }
    c.put32(info, 0, pod.uintOf(body, pod.next(cursor)))
    c.putPointer(info, 8, core_module.stringAddress(body, pod.next(cursor)))
    c.putPointer(info, 16, core_module.stringAddress(body, pod.next(cursor)))
    c.put32(info, 24, pod.uintOf(body, pod.next(cursor)))
    c.put64(info, 32, @bitCast(u64, pod.longOf(body, pod.next(cursor))))
    const dict = core_module.dictToC(body, pod.next(cursor))
    c.putPointer(info, 40, dict)
    proxy_module.emit1(proxy, @intCast(usize, EVENT_INFO), info)
    c.release(dict)
    c.release(info)
}

// struct pw_module_info: id, name, filename, args, change_mask, props.
fn moduleInfo(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const info = c.alloc(48)
    if info == 0 { return }
    c.put32(info, 0, pod.uintOf(body, pod.next(cursor)))
    c.putPointer(info, 8, core_module.stringAddress(body, pod.next(cursor)))
    c.putPointer(info, 16, core_module.stringAddress(body, pod.next(cursor)))
    c.putPointer(info, 24, core_module.stringAddress(body, pod.next(cursor)))
    c.put64(info, 32, @bitCast(u64, pod.longOf(body, pod.next(cursor))))
    const dict = core_module.dictToC(body, pod.next(cursor))
    c.putPointer(info, 40, dict)
    proxy_module.emit1(proxy, @intCast(usize, EVENT_INFO), info)
    c.release(dict)
    c.release(info)
}

// Param(seq, id, index, next, param).
fn param(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const seq = pod.intOf(body, pod.next(cursor))
    const id = pod.uintOf(body, pod.next(cursor))
    const index = pod.uintOf(body, pod.next(cursor))
    const next = pod.uintOf(body, pod.next(cursor))
    const value = core_module.podAddress(body, pod.next(cursor))
    proxy_module.emit5(proxy, @intCast(usize, EVENT_PARAM), c.int(seq), @intCast(usize, id), @intCast(usize, index), @intCast(usize, next), value)
}

// Property(subject, key, type, value): the strings may be None (a key
// removed).
fn metadataProperty(proxy: usize, body: [*]const u8, cursor: *pod.Cursor) -> void {
    const subject = pod.uintOf(body, pod.next(cursor))
    const key = core_module.stringAddress(body, pod.next(cursor))
    const kind = core_module.stringAddress(body, pod.next(cursor))
    const value = core_module.stringAddress(body, pod.next(cursor))
    proxy_module.emit4(proxy, 0, @intCast(usize, subject), key, kind, value)
}

// ---------------------------------------------------------------------------
// Methods

export fn mlx_pw_object_add_listener(object: usize, hook: usize, events: usize, data: usize) -> i32 {
    proxy_module.addObjectListener(object, hook, events, data)
    return 0
}

export fn mlx_pw_node_subscribe_params(object: usize, ids: usize, count: u32) -> i32 {
    const core = proxy_module.coreOf(object)
    if !core_module.alive(core) { return util.EIO }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    core_module.putIdArray(&writing, ids, @intCast(usize, count))
    const sent = core_module.sendPlain(core, proxy_module.idOf(object), SUBSCRIBE_PARAMS, &writing, top)
    return 0
}

// EnumParams(seq, id, index, num, filter): the Param events come with the
// sequence number returned (asynchronous).
export fn mlx_pw_node_enum_params(object: usize, seq: i32, id: u32, index: u32, count: u32, filter: usize) -> i32 {
    const core = proxy_module.coreOf(object)
    if !core_module.alive(core) { return util.EIO }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    const result = core_module.asyncResult(core_module.sendSequence(core))
    pod.putInt(&writing, result)
    pod.putId(&writing, id)
    pod.putUint(&writing, index)
    pod.putUint(&writing, count)
    core_module.putPod(&writing, filter)
    const sent = core_module.sendPlain(core, proxy_module.idOf(object), ENUM_PARAMS, &writing, top)
    return result
}

export fn mlx_pw_node_set_param(object: usize, id: u32, flags: u32, value: usize) -> i32 {
    const core = proxy_module.coreOf(object)
    if !core_module.alive(core) { return util.EIO }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    pod.putId(&writing, id)
    pod.putUint(&writing, flags)
    core_module.putPod(&writing, value)
    const sent = core_module.sendPlain(core, proxy_module.idOf(object), SET_PARAM, &writing, top)
    return 0
}

export fn mlx_pw_node_send_command(object: usize, command: usize) -> i32 {
    const core = proxy_module.coreOf(object)
    if !core_module.alive(core) { return util.EIO }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    core_module.putPod(&writing, command)
    const sent = core_module.sendPlain(core, proxy_module.idOf(object), SEND_COMMAND, &writing, top)
    return 0
}

export fn mlx_pw_metadata_set_property(object: usize, subject: u32, key: usize, kind: usize, value: usize) -> i32 {
    const core = proxy_module.coreOf(object)
    if !core_module.alive(core) { return util.EIO }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    pod.putUint(&writing, subject)
    core_module.putCString(&writing, key)
    core_module.putCString(&writing, kind)
    core_module.putCString(&writing, value)
    const sent = core_module.sendPlain(core, proxy_module.idOf(object), METADATA_SET_PROPERTY, &writing, top)
    return 0
}

export fn mlx_pw_metadata_clear(object: usize) -> i32 {
    const core = proxy_module.coreOf(object)
    if !core_module.alive(core) { return util.EIO }
    var writing: pod.Writer = undefined
    const top = core_module.begin(core, &writing)
    const sent = core_module.sendPlain(core, proxy_module.idOf(object), METADATA_CLEAR, &writing, top)
    return 0
}
