// libpipewire-0.3.so.0 in Mlx: PipeWire's client library, for the programs
// that take a screen share or a camera through it (Firefox and Chromium's
// WebRTC, GStreamer's pipewiresrc, OBS). They connect it to the socket
// the ScreenCast portal hands them (projects/desktop/capture: mlx-capture
// answers as the PipeWire daemon would); PipeWire's own library (the
// libpipewire-0.3-0 package) is not needed.
//
//   mlx4 --plugin --soname=libpipewire-0.3.so.0 \
//       projects/desktop/libpipewire/libpipewire.mlx -o libpipewire-0.3.so.0
//
// (tools/build_libpipewire.sh builds it.)
//
// Every function of libpipewire 1.0.5 is exported (export_*.mlx), and the
// two words its headers read as globals (pw_log_level, PW_LOG_TOPIC_DEFAULT).
// The objects live in C memory (projects/desktop/libpulse/c.mlx), the
// loops run on the program's threads, and the protocol is PipeWire's
// native one, version 3 (core.mlx, stream.mlx).
const misc = @import("./export_misc.mlx")
const properties = @import("./export_properties.mlx")
const loops = @import("./export_loops.mlx")
const cores = @import("./export_core.mlx")
const streams = @import("./export_stream.mlx")
const object_infos = @import("./export_infos.mlx")
const stubs = @import("./export_stubs.mlx")
