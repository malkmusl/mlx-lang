// libpipewire's loops for C: pw_loop, pw_thread_loop, pw_main_loop,
// pw_data_loop.
const c = @import("../libpulse/c.mlx")
const loop_module = @import("./loop.mlx")
const thread_loop = @import("./thread_loop.mlx")

export fn pw_loop_new(props: usize) -> usize { return loop_module.new() }

export fn pw_loop_destroy(loop: usize) -> void { loop_module.free(loop) }

export fn pw_loop_check(loop: usize) -> i32 { return loop_module.check(loop) }

export fn pw_thread_loop_new(name: usize, props: usize) -> usize { return thread_loop.new(0, name, props) }

export fn pw_thread_loop_new_full(loop: usize, name: usize, props: usize) -> usize { return thread_loop.new(loop, name, props) }

export fn pw_thread_loop_destroy(threaded: usize) -> void { thread_loop.free(threaded) }

export fn pw_thread_loop_add_listener(threaded: usize, hook: usize, events: usize, data: usize) -> void { thread_loop.addListener(threaded, hook, events, data) }

export fn pw_thread_loop_get_loop(threaded: usize) -> usize { return thread_loop.loopOf(threaded) }

export fn pw_thread_loop_start(threaded: usize) -> i32 { return thread_loop.start(threaded) }

export fn pw_thread_loop_stop(threaded: usize) -> void { thread_loop.stop(threaded) }

export fn pw_thread_loop_lock(threaded: usize) -> void { thread_loop.lock(threaded) }

export fn pw_thread_loop_unlock(threaded: usize) -> void { thread_loop.unlock(threaded) }

export fn pw_thread_loop_wait(threaded: usize) -> void { thread_loop.wait(threaded) }

// pw_thread_loop_timed_wait: 0, or ETIMEDOUT (positive, as the old function
// said it) after `seconds`.
export fn pw_thread_loop_timed_wait(threaded: usize, seconds: i32) -> i32 {
    var deadline: [2]usize = [2]usize{ 0, 0 }
    const got = thread_loop.time(@intFromPtr(&deadline), @intCast(i64, seconds) * 1000000000)
    const result = thread_loop.timedWait(threaded, @intFromPtr(&deadline))
    return if result == -110 { 110 } else { result }
}

export fn pw_thread_loop_get_time(threaded: usize, deadline: usize, timeout: i64) -> i32 { return thread_loop.time(deadline, timeout) }

export fn pw_thread_loop_timed_wait_full(threaded: usize, deadline: usize) -> i32 { return thread_loop.timedWait(threaded, deadline) }

export fn pw_thread_loop_signal(threaded: usize, wait_for_accept: u8) -> void { thread_loop.signal(threaded, wait_for_accept != 0) }

export fn pw_thread_loop_accept(threaded: usize) -> void { thread_loop.accept(threaded) }

export fn pw_thread_loop_in_thread(threaded: usize) -> u8 { return if thread_loop.inThread(threaded) { 1 } else { 0 } }

export fn pw_main_loop_new(props: usize) -> usize { return thread_loop.mainNew(props) }

export fn pw_main_loop_destroy(main: usize) -> void { thread_loop.mainFree(main) }

export fn pw_main_loop_add_listener(main: usize, hook: usize, events: usize, data: usize) -> void { thread_loop.mainAddListener(main, hook, events, data) }

export fn pw_main_loop_get_loop(main: usize) -> usize { return thread_loop.mainLoopOf(main) }

export fn pw_main_loop_run(main: usize) -> i32 { return thread_loop.mainRun(main) }

export fn pw_main_loop_quit(main: usize) -> i32 { return thread_loop.mainQuit(main) }

export fn pw_data_loop_new(props: usize) -> usize { return thread_loop.dataNew(props) }

export fn pw_data_loop_destroy(data_loop: usize) -> void { thread_loop.dataFree(data_loop) }

export fn pw_data_loop_add_listener(data_loop: usize, hook: usize, events: usize, data: usize) -> void { thread_loop.dataAddListener(data_loop, hook, events, data) }

export fn pw_data_loop_get_loop(data_loop: usize) -> usize { return thread_loop.dataLoopOf(data_loop) }

export fn pw_data_loop_start(data_loop: usize) -> i32 { return thread_loop.dataStart(data_loop) }

export fn pw_data_loop_stop(data_loop: usize) -> i32 { return thread_loop.dataStop(data_loop) }

export fn pw_data_loop_exit(data_loop: usize) -> void { thread_loop.dataExit(data_loop) }

export fn pw_data_loop_wait(data_loop: usize, timeout: i32) -> i32 { return thread_loop.dataWait(data_loop, timeout) }

export fn pw_data_loop_in_thread(data_loop: usize) -> u8 { return if thread_loop.dataInThread(data_loop) { 1 } else { 0 } }

export fn pw_data_loop_get_thread(data_loop: usize) -> usize { return thread_loop.dataThread(data_loop) }

export fn pw_data_loop_invoke(data_loop: usize, function: usize, seq: u32, data: usize, size: usize, block: u8, user_data: usize) -> i32 { return thread_loop.dataInvoke(data_loop, function, seq, data, size, block != 0, user_data) }

export fn pw_data_loop_set_thread_utils(data_loop: usize, utils: usize) -> void {}

export fn pw_thread_utils_get() -> usize { return 0 }

export fn pw_thread_utils_set(utils: usize) -> void {}

export fn pw_thread_fill_attr(props: usize, attributes: usize) -> i32 { return 0 }
