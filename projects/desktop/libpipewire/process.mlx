// What the library keeps per process: a page at a fixed address (as
// libpulse's c.anchor, at an address of its own), since a plugin has no
// globals. It holds how often pw_init was called, the names the program
// asks for (pw_get_prgname, pw_get_user_name, pw_get_host_name), the
// method tables C calls through the objects' interfaces (filled with the
// library's exported functions once), and the address of the pw_log_level
// word C reads.
const std = @import("std")
const c = @import("../libpulse/c.mlx")

const ANCHOR: usize = 68994354642944
const MAGIC: u64 = 5788710262723723604

pub const INIT_COUNT: usize = 8
pub const PRGNAME: usize = 16
pub const USER_NAME: usize = 24
pub const HOST_NAME: usize = 32
pub const DOMAIN: usize = 40
pub const LOG_LEVEL: usize = 48
// The method tables (hooks.table), one per interface.
pub const CORE_METHODS: usize = 56
pub const REGISTRY_METHODS: usize = 64
pub const NODE_METHODS: usize = 72
pub const CLIENT_METHODS: usize = 80
pub const DEVICE_METHODS: usize = 88
pub const PORT_METHODS: usize = 96
pub const METADATA_METHODS: usize = 104
pub const LINK_METHODS: usize = 112
pub const FACTORY_METHODS: usize = 120
pub const MODULE_METHODS: usize = 128
pub const CLIENT_NODE_METHODS: usize = 136
pub const LOOP_METHODS: usize = 144
pub const LOOP_CONTROL_METHODS: usize = 152
pub const LOOP_UTILS_METHODS: usize = 160
pub const SYSTEM_METHODS: usize = 168
pub const TYPE_INFO: usize = 176
pub const CLIENT_NAME: usize = 184

// The page, made when `create` and it is not there yet; 0 when it cannot
// be (the address is taken by something else).
pub fn anchor(create: bool) -> usize {
    // msync fails (ENOMEM) on an address nothing maps.
    if std.linux.syscall3(26, ANCHOR, 4096, 1) == 0 {
        return if c.get64(ANCHOR, 0) == MAGIC { ANCHOR } else { 0 }
    }
    if !create { return 0 }
    // MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE
    const mapped = std.linux.syscall6(9, ANCHOR, 4096, 3, 1048610, @bitCast(usize, @intCast(isize, -1)), 0)
    if mapped != @intCast(isize, ANCHOR) { return 0 }
    c.put64(ANCHOR, 0, MAGIC)
    return ANCHOR
}

// The page's pointer at `field`, made by `make` (an allocating function)
// when it is still 0.
pub fn field(offset: usize) -> usize {
    const page = anchor(true)
    if page == 0 { return 0 }
    return c.getPointer(page, offset)
}

pub fn setField(offset: usize, value: usize) -> void {
    const page = anchor(true)
    if page != 0 { c.putPointer(page, offset, value) }
}

// The program's name: the file /proc/self/exe names, after its last `/`,
// kept as a C string.
pub fn prgname() -> usize {
    var cached = field(PRGNAME)
    if cached != 0 { return cached }
    var path: [4096]u8 = undefined
    var link: [*]const u8 = undefined
    unsafe { link = @ptrCast([*]const u8, "/proc/self/exe") }
    const length = std.linux.syscall3(89, @intFromPtr(link), @intFromPtr(&path), 4095)
    var name: []const u8 = "pipewire"
    if length > 0 {
        var start: usize = 0
        var index: usize = 0
        while index < @bitCast(usize, length) {
            if path[index] == 47 { start = index + 1 }
            index += 1
        }
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrCast([*]const u8, &path) }
        name = bytes[start..@bitCast(usize, length)]
    }
    cached = c.duplicate(name)
    setField(PRGNAME, cached)
    return cached
}

// The first line of a file, into `out` (at most `capacity` bytes): how
// many bytes.
fn firstLine(path: []const u8, out: [*]u8, capacity: usize) -> usize {
    var name: [256]u8 = undefined
    var index: usize = 0
    while index < path.length && index < 255 {
        name[index] = path[index]
        index += 1
    }
    name[index] = 0
    const file = std.linux.syscall3(2, @intFromPtr(&name), 0, 0)
    if file < 0 { return 0 }
    const got = std.linux.syscall3(0, @bitCast(usize, file), @intFromPtr(out), capacity)
    const closed = std.linux.syscall1(3, @bitCast(usize, file))
    if got <= 0 { return 0 }
    var end: usize = 0
    while end < @bitCast(usize, got) && out[end] != 10 { end += 1 }
    return end
}

pub fn hostName() -> usize {
    var cached = field(HOST_NAME)
    if cached != 0 { return cached }
    var line: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    const length = firstLine("/proc/sys/kernel/hostname", bytes, 255)
    cached = c.duplicate(if length == 0 { "localhost" } else { bytes[0..length] })
    setField(HOST_NAME, cached)
    return cached
}

// The user's name: $USER, else the account of the process's uid in
// /etc/passwd, else the uid in digits.
pub fn userName() -> usize {
    var cached = field(USER_NAME)
    if cached != 0 { return cached }
    const from_environment = c.environment("USER")
    if from_environment.length > 0 {
        cached = c.duplicate(from_environment)
        setField(USER_NAME, cached)
        return cached
    }
    const uid = @intCast(u64, std.linux.syscall0(102))
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    var count: usize = 0
    var rest = uid
    var scratch: [24]u8 = undefined
    while true {
        scratch[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var index: usize = 0
    while index < count {
        digit_bytes[index] = scratch[count - 1 - index]
        index += 1
    }
    var name = digit_bytes[0..count]
    var passwd: [65536]u8 = undefined
    var passwd_bytes: [*]u8 = undefined
    unsafe { passwd_bytes = @ptrCast([*]u8, &passwd) }
    var path: [12]u8 = [12]u8{ 47, 101, 116, 99, 47, 112, 97, 115, 115, 119, 100, 0 }
    const file = std.linux.syscall3(2, @intFromPtr(&path), 0, 0)
    if file >= 0 {
        const got = std.linux.syscall3(0, @bitCast(usize, file), @intFromPtr(passwd_bytes), 65536)
        const closed = std.linux.syscall1(3, @bitCast(usize, file))
        var start: usize = 0
        while got > 0 && start < @bitCast(usize, got) {
            var end = start
            while end < @bitCast(usize, got) && passwd_bytes[end] != 10 { end += 1 }
            // name:x:uid:...
            var first_colon = start
            while first_colon < end && passwd_bytes[first_colon] != 58 { first_colon += 1 }
            var second_colon = first_colon + 1
            while second_colon < end && passwd_bytes[second_colon] != 58 { second_colon += 1 }
            var third_colon = second_colon + 1
            while third_colon < end && passwd_bytes[third_colon] != 58 { third_colon += 1 }
            if third_colon < end && c.same(passwd_bytes[second_colon + 1..third_colon], digit_bytes[0..count]) {
                name = passwd_bytes[start..first_colon]
                break
            }
            start = end + 1
        }
    }
    cached = c.duplicate(name)
    setField(USER_NAME, cached)
    return cached
}
