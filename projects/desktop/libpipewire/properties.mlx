// pw_properties: PipeWire's key-value lists as C sees them. A struct
// pw_properties is a spa_dict (flags, n_items, items) and flags; programs
// read `props->dict` directly (spa_dict_lookup, spa_dict_for_each), so
// the items (key, value: two C strings each) are an array in C memory and
// every string a copy of its own. The library's own fourth word is the
// array's capacity.
const c = @import("../libpulse/c.mlx")

pub const SIZE: usize = 32
const N_ITEMS: usize = 4
const ITEMS: usize = 8
const FLAGS: usize = 16
const CAPACITY: usize = 24

// struct spa_dict and struct spa_dict_item.
pub const DICT: usize = 16
pub const ITEM: usize = 16

pub fn new() -> usize {
    const props = c.alloc(SIZE)
    if props == 0 { return 0 }
    const items = c.alloc(16 * ITEM)
    if items == 0 {
        c.release(props)
        return 0
    }
    c.putPointer(props, ITEMS, items)
    c.put32(props, CAPACITY, 16)
    return props
}

pub fn free(props: usize) -> void {
    if props == 0 { return }
    clear(props)
    c.release(c.getPointer(props, ITEMS))
    c.release(props)
}

pub fn count(props: usize) -> usize { return @intCast(usize, c.get32(props, N_ITEMS)) }

fn itemAt(props: usize, index: usize) -> usize { return c.getPointer(props, ITEMS) + index * ITEM }

pub fn keyAt(props: usize, index: usize) -> usize { return c.getPointer(itemAt(props, index), 0) }

pub fn valueAt(props: usize, index: usize) -> usize { return c.getPointer(itemAt(props, index), 8) }

// The index of `key`, count when it is not there.
pub fn find(props: usize, key: []const u8) -> usize {
    const total = count(props)
    var index: usize = 0
    while index < total {
        if c.same(c.slice(keyAt(props, index)), key) { return index }
        index += 1
    }
    return total
}

// The value for `key` (a C string), 0 when there is none.
pub fn get(props: usize, key: []const u8) -> usize {
    const index = find(props, key)
    if index == count(props) { return 0 }
    return valueAt(props, index)
}

fn grow(props: usize) -> bool {
    const capacity = @intCast(usize, c.get32(props, CAPACITY))
    const items = c.grow(c.getPointer(props, ITEMS), capacity * 2 * ITEM)
    if items == 0 { return false }
    c.putPointer(props, ITEMS, items)
    c.put32(props, CAPACITY, @intCast(u32, capacity * 2))
    return true
}

// Removes the item at `index` the way PipeWire does: the last item moves
// into its slot (programs see the same order after a removal).
fn removeAt(props: usize, index: usize) -> void {
    const total = count(props)
    c.release(keyAt(props, index))
    c.release(valueAt(props, index))
    if index + 1 < total { c.copy(itemAt(props, index), itemAt(props, total - 1), ITEM) }
    c.put32(props, N_ITEMS, @intCast(u32, total - 1))
}

// Sets `key` to `value` (a C string; 0 takes the key out): 1 when the list
// changed, 0 when it already said so, -1 when there is no memory
// (pw_properties_set).
pub fn set(props: usize, key: []const u8, value: usize) -> i32 {
    const index = find(props, key)
    const total = count(props)
    if value == 0 {
        if index == total { return 0 }
        removeAt(props, index)
        return 1
    }
    if index < total {
        if c.same(c.slice(valueAt(props, index)), c.slice(value)) { return 0 }
        const copy = c.duplicateC(value)
        if copy == 0 { return -1 }
        c.release(valueAt(props, index))
        c.putPointer(itemAt(props, index), 8, copy)
        return 1
    }
    if total == @intCast(usize, c.get32(props, CAPACITY)) && !grow(props) { return -1 }
    const key_copy = c.duplicate(key)
    const value_copy = c.duplicateC(value)
    if key_copy == 0 || value_copy == 0 {
        c.release(key_copy)
        c.release(value_copy)
        return -1
    }
    c.putPointer(itemAt(props, total), 0, key_copy)
    c.putPointer(itemAt(props, total), 8, value_copy)
    c.put32(props, N_ITEMS, @intCast(u32, total + 1))
    return 1
}

pub fn setText(props: usize, key: []const u8, value: []const u8) -> i32 {
    const copy = c.duplicate(value)
    if copy == 0 { return -1 }
    const result = set(props, key, copy)
    c.release(copy)
    return result
}

pub fn clear(props: usize) -> void {
    var index: usize = 0
    while index < count(props) {
        c.release(keyAt(props, index))
        c.release(valueAt(props, index))
        index += 1
    }
    c.put32(props, N_ITEMS, 0)
}

pub fn copy(props: usize) -> usize {
    const made = new()
    if made == 0 { return 0 }
    c.put32(made, FLAGS, c.get32(props, FLAGS))
    const changed = update(made, props)
    return made
}

// ---------------------------------------------------------------------------
// Dictionaries (struct spa_dict in C memory: a pw_properties starts with one)

pub fn dictCount(dict: usize) -> usize {
    if dict == 0 { return 0 }
    return @intCast(usize, c.get32(dict, 4))
}

pub fn dictKey(dict: usize, index: usize) -> usize { return c.getPointer(c.getPointer(dict, 8) + index * ITEM, 0) }

pub fn dictValue(dict: usize, index: usize) -> usize { return c.getPointer(c.getPointer(dict, 8) + index * ITEM, 8) }

// spa_dict_lookup: the value for `key`, 0 when there is none.
pub fn dictLookup(dict: usize, key: []const u8) -> usize {
    const total = dictCount(dict)
    var index: usize = 0
    while index < total {
        if c.same(c.slice(dictKey(dict, index)), key) { return dictValue(dict, index) }
        index += 1
    }
    return 0
}

// Whether `key` is among the C strings of the NULL-terminated array `keys`.
fn among(keys: usize, key: []const u8) -> bool {
    if keys == 0 { return false }
    var index: usize = 0
    while c.getPointer(keys, index * 8) != 0 {
        if c.same(c.slice(c.getPointer(keys, index * 8)), key) { return true }
        index += 1
    }
    return false
}

// Every item of `dict` set: how many changed (pw_properties_update).
pub fn update(props: usize, dict: usize) -> i32 {
    var changed: i32 = 0
    var index: usize = 0
    while index < dictCount(dict) {
        const result = set(props, c.slice(dictKey(dict, index)), dictValue(dict, index))
        if result > 0 { changed += result }
        index += 1
    }
    return changed
}

// The items of `dict` whose keys are in `keys` (pw_properties_update_keys).
pub fn updateKeys(props: usize, dict: usize, keys: usize) -> i32 {
    var changed: i32 = 0
    var index: usize = 0
    while keys != 0 && c.getPointer(keys, index * 8) != 0 {
        const key = c.slice(c.getPointer(keys, index * 8))
        const value = dictLookup(dict, key)
        if value != 0 {
            const result = set(props, key, value)
            if result > 0 { changed += result }
        }
        index += 1
    }
    return changed
}

// The items of `dict` but those whose keys are in `ignore`
// (pw_properties_update_ignore).
pub fn updateIgnore(props: usize, dict: usize, ignore: usize) -> i32 {
    var changed: i32 = 0
    var index: usize = 0
    while index < dictCount(dict) {
        const key = c.slice(dictKey(dict, index))
        if !among(ignore, key) {
            const result = set(props, key, dictValue(dict, index))
            if result > 0 { changed += result }
        }
        index += 1
    }
    return changed
}

// The items of `dict` the list lacks (pw_properties_add).
pub fn add(props: usize, dict: usize) -> i32 {
    var added: i32 = 0
    var index: usize = 0
    while index < dictCount(dict) {
        const key = c.slice(dictKey(dict, index))
        if get(props, key) == 0 && set(props, key, dictValue(dict, index)) > 0 { added += 1 }
        index += 1
    }
    return added
}

pub fn addKeys(props: usize, dict: usize, keys: usize) -> i32 {
    var added: i32 = 0
    var index: usize = 0
    while keys != 0 && c.getPointer(keys, index * 8) != 0 {
        const key = c.slice(c.getPointer(keys, index * 8))
        const value = dictLookup(dict, key)
        if value != 0 && get(props, key) == 0 && set(props, key, value) > 0 { added += 1 }
        index += 1
    }
    return added
}

pub fn newDict(dict: usize) -> usize {
    const made = new()
    if made == 0 { return 0 }
    const changed = update(made, dict)
    return made
}

// ---------------------------------------------------------------------------
// Text: `{ key = value, "key two" = "quoted value" }` or `key=value
// key2=value2` (what pw_properties_new_string and update_string take, SPA's
// JSON with bare words allowed)

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 10 || byte == 13 }

fn isPunctuation(byte: u8) -> bool { return byte == 123 || byte == 125 || byte == 44 || byte == 91 || byte == 93 }

// A token from `at`: quoted (its text without the quotes, escapes
// undone into `out`) or bare (up to a space, `=`, `:` or punctuation when
// `stopAtEquals`); how far it went, and the token in `out` of `length`.
fn token(text: []const u8, at: usize, stop_at_equals: bool, out: [*]u8, length: *usize) -> usize {
    var index = at
    length.* = 0
    if index < text.length && text[index] == 34 {
        index += 1
        while index < text.length && text[index] != 34 {
            var byte = text[index]
            if byte == 92 && index + 1 < text.length {
                index += 1
                byte = text[index]
                if byte == 110 { byte = 10 } else if byte == 116 { byte = 9 }
            }
            if length.* < 4095 {
                out[length.*] = byte
                length.* += 1
            }
            index += 1
        }
        if index < text.length { index += 1 }
        return index
    }
    while index < text.length && !isSpace(text[index]) && !isPunctuation(text[index]) && !(stop_at_equals && (text[index] == 61 || text[index] == 58)) {
        if length.* < 4095 {
            out[length.*] = text[index]
            length.* += 1
        }
        index += 1
    }
    return index
}

// Sets each key = value of `text`: how many changed, -1 when the text is
// not made of them.
pub fn updateString(props: usize, text: []const u8) -> i32 {
    var key: [4096]u8 = undefined
    var value: [4096]u8 = undefined
    var key_bytes: [*]u8 = undefined
    var value_bytes: [*]u8 = undefined
    unsafe {
        key_bytes = @ptrCast([*]u8, &key)
        value_bytes = @ptrCast([*]u8, &value)
    }
    var changed: i32 = 0
    var at: usize = 0
    while at < text.length {
        while at < text.length && (isSpace(text[at]) || isPunctuation(text[at])) { at += 1 }
        if at >= text.length { break }
        var key_length: usize = 0
        at = token(text, at, true, key_bytes, &key_length)
        if key_length == 0 { return -1 }
        while at < text.length && isSpace(text[at]) { at += 1 }
        if at < text.length && (text[at] == 61 || text[at] == 58) { at += 1 }
        while at < text.length && isSpace(text[at]) { at += 1 }
        var value_length: usize = 0
        at = token(text, at, false, value_bytes, &value_length)
        const result = setText(props, key_bytes[0..key_length], value_bytes[0..value_length])
        if result > 0 { changed += result }
    }
    return changed
}

pub fn newString(text: []const u8) -> usize {
    const made = new()
    if made == 0 { return 0 }
    if updateString(made, text) < 0 {
        free(made)
        return 0
    }
    return made
}

// ---------------------------------------------------------------------------
// Values

// A decimal or 0x hexadecimal integer with a sign; `ok` says whether the
// whole text was one.
pub fn parseInteger(text: []const u8, ok: *bool) -> i64 {
    ok.* = false
    if text.length == 0 { return 0 }
    var at: usize = 0
    var negative = false
    if text[0] == 45 || text[0] == 43 {
        negative = text[0] == 45
        at = 1
    }
    var base: u64 = 10
    if at + 1 < text.length && text[at] == 48 && (text[at + 1] == 120 || text[at + 1] == 88) {
        base = 16
        at += 2
    }
    if at >= text.length { return 0 }
    var value: u64 = 0
    while at < text.length {
        const byte = text[at]
        var digit: u64 = 0
        if byte >= 48 && byte <= 57 {
            digit = @intCast(u64, byte - 48)
        } else if base == 16 && byte >= 97 && byte <= 102 {
            digit = @intCast(u64, byte - 87)
        } else if base == 16 && byte >= 65 && byte <= 70 {
            digit = @intCast(u64, byte - 55)
        } else {
            return 0
        }
        value = value * base + digit
        at += 1
    }
    ok.* = true
    if negative { return 0 - @bitCast(i64, value) }
    return @bitCast(i64, value)
}

// spa_atob: "true" or "1".
pub fn parseBool(text: []const u8) -> bool { return c.same(text, "true") || c.same(text, "1") }
