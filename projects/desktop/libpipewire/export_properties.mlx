// libpipewire's property lists for C: pw_properties_*.
const c = @import("../libpulse/c.mlx")
const printf = @import("../libpulse/printf.mlx")
const properties = @import("./properties.mlx")
const util = @import("./util.mlx")

extern("c") fn fputs(text: [*]const u8, file: usize) -> i32

// pw_properties_new(key, value, ..., NULL): the pairs come in the six
// integer registers and then on the stack (up to seven pairs here); a
// NULL value leaves its key out.
export fn pw_properties_new(k0: usize, v0: usize, k1: usize, v1: usize, k2: usize, v2: usize, k3: usize, v3: usize, k4: usize, v4: usize, k5: usize, v5: usize, k6: usize, v6: usize) -> usize {
    const props = properties.new()
    if props == 0 { return 0 }
    var keys: [7]usize = [7]usize{ k0, k1, k2, k3, k4, k5, k6 }
    var values: [7]usize = [7]usize{ v0, v1, v2, v3, v4, v5, v6 }
    var index: usize = 0
    while index < 7 && keys[index] != 0 {
        if values[index] != 0 { const set = properties.set(props, c.slice(keys[index]), values[index]) }
        index += 1
    }
    return props
}

export fn pw_properties_new_dict(dict: usize) -> usize { return properties.newDict(dict) }

export fn pw_properties_new_string(text: usize) -> usize { return properties.newString(c.slice(text)) }

export fn pw_properties_copy(props: usize) -> usize { return properties.copy(props) }

export fn pw_properties_update_keys(props: usize, dict: usize, keys: usize) -> i32 { return properties.updateKeys(props, dict, keys) }

export fn pw_properties_update_ignore(props: usize, dict: usize, ignore: usize) -> i32 { return properties.updateIgnore(props, dict, ignore) }

export fn pw_properties_update(props: usize, dict: usize) -> i32 { return properties.update(props, dict) }

export fn pw_properties_update_string(props: usize, text: usize, length: usize) -> i32 {
    if text == 0 { return 0 }
    return properties.updateString(props, c.bytes(text)[0..length])
}

export fn pw_properties_add(props: usize, dict: usize) -> i32 { return properties.add(props, dict) }

export fn pw_properties_add_keys(props: usize, dict: usize, keys: usize) -> i32 { return properties.addKeys(props, dict, keys) }

export fn pw_properties_clear(props: usize) -> void { properties.clear(props) }

export fn pw_properties_free(props: usize) -> void { properties.free(props) }

export fn pw_properties_set(props: usize, key: usize, value: usize) -> i32 {
    if key == 0 { return util.EINVAL }
    return properties.set(props, c.slice(key), value)
}

// pw_properties_setf(props, key, format, ...): a printf format's arguments
// as a variadic call passes them (projects/desktop/libpulse/printf.mlx).
export fn pw_properties_setf(props: usize, key: usize, pattern: usize, a: usize, b: usize, d: usize, e: usize, f: usize, g: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> i32 {
    if key == 0 { return util.EINVAL }
    if pattern == 0 { return properties.set(props, c.slice(key), 0) }
    var integers: [6]u64 = [6]u64{ @intCast(u64, a), @intCast(u64, b), @intCast(u64, d), @intCast(u64, e), @intCast(u64, f), @intCast(u64, g) }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const text = printf.format(c.slice(pattern), @intFromPtr(&integers), 6, @intFromPtr(&doubles), 8)
    const result = properties.set(props, c.slice(key), text)
    c.release(text)
    return result
}

// pw_properties_setva takes a va_list: the integer and double arguments are
// read from where it says they are (System V: the register save area, then
// the overflow area).
export fn pw_properties_setva(props: usize, key: usize, pattern: usize, list: usize) -> i32 {
    if key == 0 { return util.EINVAL }
    if pattern == 0 { return properties.set(props, c.slice(key), 0) }
    var integers: [16]u64 = undefined
    var doubles: [8]f64 = undefined
    var gp_offset = @intCast(usize, c.get32(list, 0))
    var fp_offset = @intCast(usize, c.get32(list, 4))
    var overflow = c.getPointer(list, 8)
    const saved = c.getPointer(list, 16)
    var index: usize = 0
    while index < 16 {
        if gp_offset < 48 {
            integers[index] = c.get64(saved, gp_offset)
            gp_offset += 8
        } else {
            integers[index] = c.get64(overflow, 0)
            overflow += 8
        }
        index += 1
    }
    index = 0
    while index < 8 {
        var bits: u64 = 0
        if fp_offset < 176 {
            bits = c.get64(saved, fp_offset)
            fp_offset += 16
        }
        doubles[index] = @bitCast(f64, bits)
        index += 1
    }
    const text = printf.format(c.slice(pattern), @intFromPtr(&integers), 16, @intFromPtr(&doubles), 8)
    const result = properties.set(props, c.slice(key), text)
    c.release(text)
    return result
}

export fn pw_properties_get(props: usize, key: usize) -> usize {
    if props == 0 || key == 0 { return 0 }
    return properties.get(props, c.slice(key))
}

fn fetchInteger(props: usize, key: usize, out: usize, bits: usize, signed: bool) -> i32 {
    const value = pw_properties_get(props, key)
    if value == 0 { return util.ENOENT }
    var ok = false
    const parsed = properties.parseInteger(c.slice(value), &ok)
    if !ok { return util.EINVAL }
    if bits == 32 {
        if signed {
            if parsed < -2147483648 || parsed > 2147483647 { return util.EINVAL }
            c.put32(out, 0, @bitCast(u32, @intCast(i32, parsed)))
        } else {
            if parsed < 0 || parsed > 4294967295 { return util.EINVAL }
            c.put32(out, 0, @intCast(u32, parsed))
        }
    } else {
        c.put64(out, 0, @bitCast(u64, parsed))
    }
    return 0
}

export fn pw_properties_fetch_uint32(props: usize, key: usize, out: usize) -> i32 { return fetchInteger(props, key, out, 32, false) }

export fn pw_properties_fetch_int32(props: usize, key: usize, out: usize) -> i32 { return fetchInteger(props, key, out, 32, true) }

export fn pw_properties_fetch_uint64(props: usize, key: usize, out: usize) -> i32 { return fetchInteger(props, key, out, 64, false) }

export fn pw_properties_fetch_int64(props: usize, key: usize, out: usize) -> i32 { return fetchInteger(props, key, out, 64, true) }

export fn pw_properties_fetch_bool(props: usize, key: usize, out: usize) -> i32 {
    const value = pw_properties_get(props, key)
    if value == 0 { return util.ENOENT }
    c.put8(out, 0, if properties.parseBool(c.slice(value)) { 1 } else { 0 })
    return 0
}

// pw_properties_iterate(props, &state): the next key, NULL after the last.
export fn pw_properties_iterate(props: usize, state: usize) -> usize {
    const index = c.getPointer(state, 0)
    if props == 0 || index >= properties.count(props) { return 0 }
    c.putPointer(state, 0, index + 1)
    return properties.keyAt(props, index)
}

// pw_properties_serialize_dict(FILE *, dict, flags): the items as JSON
// members, `"key": value`, after a space each, or each on a line of its
// own indented by two with PW_PROPERTIES_FLAG_NL (1); values that are
// JSON already (null, true, false, numbers, quoted strings, objects and
// arrays) go as they are, the others as encoded strings; how many.
export fn pw_properties_serialize_dict(file: usize, dict: usize, flags: u32) -> i32 {
    var written: i32 = 0
    var index: usize = 0
    var line: [8192]u8 = undefined
    const lines = flags & 1 != 0
    while index < properties.dictCount(dict) {
        var out = c.out(@intFromPtr(&line), 8192)
        if index > 0 { c.append(&out, ",") }
        c.append(&out, if lines { "\n  " } else { " " })
        encodeString(&out, c.slice(properties.dictKey(dict, index)))
        c.append(&out, ": ")
        const value = properties.dictValue(dict, index)
        if value == 0 || c.length(value) == 0 {
            c.append(&out, "null")
        } else if jsonAlready(c.slice(value)) {
            c.append(&out, c.slice(value))
        } else {
            encodeString(&out, c.slice(value))
        }
        const put = fputs(c.bytes(@intFromPtr(&line)), file)
        written += 1
        index += 1
    }
    return written
}

// A JSON string: quotes, with \n \r \b \t \f, the quote and the backslash
// escaped, other control characters as \u00XX (spa_json_encode_string).
fn encodeString(out: *c.Out, text: []const u8) -> void {
    c.appendByte(out, 34)
    var at: usize = 0
    while at < text.length {
        const byte = text[at]
        if byte == 10 {
            c.append(out, "\\n")
        } else if byte == 13 {
            c.append(out, "\\r")
        } else if byte == 8 {
            c.append(out, "\\b")
        } else if byte == 9 {
            c.append(out, "\\t")
        } else if byte == 12 {
            c.append(out, "\\f")
        } else if byte == 34 || byte == 92 {
            c.appendByte(out, 92)
            c.appendByte(out, byte)
        } else if byte < 32 {
            c.append(out, "\\u00")
            c.appendByte(out, hexDigit(byte >> 4))
            c.appendByte(out, hexDigit(byte & 15))
        } else {
            c.appendByte(out, byte)
        }
        at += 1
    }
    c.appendByte(out, 34)
}

fn hexDigit(value: u8) -> u8 { return if value < 10 { 48 + value } else { 87 + value } }

// Whether a value is written as it is: null, true, false, a number, a
// quoted string, or an object or array (whose whole text is the value).
fn jsonAlready(text: []const u8) -> bool {
    if same(text, "null") || same(text, "true") || same(text, "false") { return true }
    const first = text[0]
    const last = text[text.length - 1]
    if first == 123 { return last == 125 }
    if first == 91 { return last == 93 }
    if first == 34 { return text.length >= 2 && last == 34 }
    return isNumber(text)
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// What strtof reads whole out of the characters + - 0-9 . E e
// (spa_json_is_float): a sign, digits with at most one point (one digit
// at least), an exponent with digits.
fn isNumber(text: []const u8) -> bool {
    var at: usize = 0
    if at < text.length && (text[at] == 43 || text[at] == 45) { at += 1 }
    var digits: usize = 0
    while at < text.length && text[at] >= 48 && text[at] <= 57 {
        at += 1
        digits += 1
    }
    if at < text.length && text[at] == 46 {
        at += 1
        while at < text.length && text[at] >= 48 && text[at] <= 57 {
            at += 1
            digits += 1
        }
    }
    if digits == 0 { return false }
    if at < text.length && (text[at] == 69 || text[at] == 101) {
        at += 1
        if at < text.length && (text[at] == 43 || text[at] == 45) { at += 1 }
        var exponent: usize = 0
        while at < text.length && text[at] >= 48 && text[at] <= 57 {
            at += 1
            exponent += 1
        }
        if exponent == 0 { return false }
    }
    return at == text.length
}
