// libpipewire's odds and ends for C: pw_init and the names of the
// process, the version, logging (pw_log_level is the word C reads;
// messages go to stderr when PIPEWIRE_DEBUG asks for their level), the
// string utilities, directions and states.
const std = @import("std")
const c = @import("../libpulse/c.mlx")
const printf = @import("../libpulse/printf.mlx")
const util = @import("./util.mlx")
const process = @import("./process.mlx")

// enum spa_log_level: none 0, error 1, warn 2, info 3, debug 4, trace 5.
// C reads the level from this word (pw_log_level_enabled); pw_init and
// pw_log_set_level write it.
export const pw_log_level: u32 = 2
// The default topic: none, so the macros fall back to pw_log_level.
export const PW_LOG_TOPIC_DEFAULT: u64 = 0

fn logLevelWord() -> usize {
    var cached = process.field(process.LOG_LEVEL)
    if cached != 0 { return cached }
    var name: [*]const u8 = undefined
    unsafe { name = @ptrCast([*]const u8, "pw_log_level") }
    cached = c.ownSymbol(@intFromPtr(pw_init), name)
    if cached != 0 { process.setField(process.LOG_LEVEL, cached) }
    return cached
}

fn currentLevel() -> u32 {
    const word = logLevelWord()
    if word == 0 { return 2 }
    return c.get32(word, 0)
}

// $PIPEWIRE_DEBUG: a number, or one of E W I D T (the first letter of the
// level); "<level>,topic:level" forms take their first part.
fn levelFromEnvironment() -> u32 {
    const text = c.environment("PIPEWIRE_DEBUG")
    if text.length == 0 { return 0 }
    const first = text[0]
    if first >= 48 && first <= 57 { return @intCast(u32, first - 48) }
    if first == 69 { return 1 }
    if first == 87 { return 2 }
    if first == 73 { return 3 }
    if first == 68 { return 4 }
    if first == 84 { return 5 }
    return 0
}

export fn pw_init(argc: usize, argv: usize) -> void {
    const page = process.anchor(true)
    if page == 0 { return }
    const count = c.get64(page, process.INIT_COUNT)
    c.put64(page, process.INIT_COUNT, count + 1)
    if count == 0 {
        const level = levelFromEnvironment()
        if level != 0 { pw_log_set_level(level) }
    }
}

export fn pw_deinit() -> void {
    const page = process.anchor(false)
    if page == 0 { return }
    const count = c.get64(page, process.INIT_COUNT)
    if count > 0 { c.put64(page, process.INIT_COUNT, count - 1) }
}

export fn pw_get_library_version() -> usize { return c.literal("1.0.5") }

export fn pw_check_library_version(major: i32, minor: i32, micro: i32) -> u8 { return if util.atLeast(major, minor, micro) { 1 } else { 0 } }

export fn pw_get_prgname() -> usize { return process.prgname() }

export fn pw_get_application_name() -> usize { return 0 }

export fn pw_get_client_name() -> usize { return process.prgname() }

export fn pw_get_user_name() -> usize { return process.userName() }

export fn pw_get_host_name() -> usize { return process.hostName() }

export fn pw_set_domain(domain: usize) -> i32 {
    process.setField(process.DOMAIN, c.duplicateC(domain))
    return 0
}

export fn pw_get_domain() -> usize { return process.field(process.DOMAIN) }

export fn pw_gettext(text: usize) -> usize { return text }

export fn pw_ngettext(singular: usize, plural: usize, count: u64) -> usize { return if count == 1 { singular } else { plural } }

export fn pw_debug_is_category_enabled(name: usize) -> u8 { return 0 }

export fn pw_check_option(option: usize, value: usize) -> u8 { return 0 }

export fn pw_get_support(support: usize, max_support: u32) -> u32 { return 0 }

export fn pw_load_spa_handle(lib: usize, factory: usize, info: usize, n_support: u32, support: usize) -> usize { return 0 }

export fn pw_unload_spa_handle(handle: usize) -> i32 { return util.ENOTSUP }

// pw_type_info: the interface types known here, a table ended by an entry
// without a name (struct spa_type_info: type, parent, name, values). One
// table per process, made when first asked for.
export fn pw_type_info() -> usize {
    var table = process.field(process.TYPE_INFO)
    if table != 0 { return table }
    table = c.alloc(24 * 4)
    if table == 0 { return 0 }
    // SPA_TYPE_POINTER_START + 1..: PipeWire's interfaces by name.
    c.put32(table, 0, 65537)
    c.put32(table, 4, 65536)
    c.putPointer(table, 8, c.literal("PipeWire:Interface:Core"))
    c.put32(table, 24, 65538)
    c.put32(table, 28, 65536)
    c.putPointer(table, 32, c.literal("PipeWire:Interface:Registry"))
    c.put32(table, 48, 65539)
    c.put32(table, 52, 65536)
    c.putPointer(table, 56, c.literal("PipeWire:Interface:Node"))
    process.setField(process.TYPE_INFO, table)
    return table
}

// ---------------------------------------------------------------------------
// Logging

export fn pw_log_set_level(level: u32) -> void {
    const word = logLevelWord()
    if word != 0 { c.put32(word, 0, level) }
}

export fn pw_log_set(log: usize) -> void {}

export fn pw_log_get() -> usize { return 0 }

fn levelName(level: u32) -> []const u8 {
    if level == 1 { return "E" }
    if level == 2 { return "W" }
    if level == 3 { return "I" }
    if level == 4 { return "D" }
    return "T"
}

// A line on stderr: "[LEVEL] file:line func: message".
fn logLine(level: u32, file: usize, line: i32, function: usize, pattern: usize, integers: usize, integer_count: usize, doubles: usize) -> void {
    if level == 0 || level > currentLevel() || pattern == 0 { return }
    const message = printf.format(c.slice(pattern), integers, integer_count, doubles, 8)
    var text: [4096]u8 = undefined
    var out = c.out(@intFromPtr(&text), 4096)
    c.append(&out, "[")
    c.append(&out, levelName(level))
    c.append(&out, "][")
    c.append(&out, c.slice(file))
    c.append(&out, ":")
    c.appendSigned(&out, @intCast(i64, line))
    c.append(&out, " ")
    c.append(&out, c.slice(function))
    c.append(&out, "()] ")
    c.append(&out, c.slice(message))
    c.append(&out, "\n")
    c.release(message)
    const written = std.linux.syscall3(1, 2, @intFromPtr(&text), out.length)
}

export fn pw_log_log(level: u32, file: usize, line: i32, function: usize, pattern: usize, a: usize, s0: usize, s1: usize, s2: usize, s3: usize, s4: usize, s5: usize, s6: usize, s7: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var integers: [9]u64 = [9]u64{ @intCast(u64, a), @intCast(u64, s0), @intCast(u64, s1), @intCast(u64, s2), @intCast(u64, s3), @intCast(u64, s4), @intCast(u64, s5), @intCast(u64, s6), @intCast(u64, s7) }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    logLine(level, file, line, function, pattern, @intFromPtr(&integers), 9, @intFromPtr(&doubles))
}

// pw_log_logt(level, topic, file, line, func, fmt, ...): the topic's own
// level counts when it has one (struct spa_log_topic: version, topic,
// level, has_custom_level).
export fn pw_log_logt(level: u32, topic: usize, file: usize, line: i32, function: usize, pattern: usize, s0: usize, s1: usize, s2: usize, s3: usize, s4: usize, s5: usize, s6: usize, s7: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    if topic != 0 && c.get8(topic, 20) != 0 && level > c.get32(topic, 16) { return }
    var integers: [8]u64 = [8]u64{ @intCast(u64, s0), @intCast(u64, s1), @intCast(u64, s2), @intCast(u64, s3), @intCast(u64, s4), @intCast(u64, s5), @intCast(u64, s6), @intCast(u64, s7) }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    logLine(level, file, line, function, pattern, @intFromPtr(&integers), 8, @intFromPtr(&doubles))
}

// The va_list forms: the arguments where the list says (System V).
fn fromList(list: usize, integers: [*]u64, doubles: [*]f64) -> void {
    var gp_offset = @intCast(usize, c.get32(list, 0))
    var fp_offset = @intCast(usize, c.get32(list, 4))
    var overflow = c.getPointer(list, 8)
    const saved = c.getPointer(list, 16)
    var index: usize = 0
    while index < 16 {
        if gp_offset < 48 {
            integers[index] = c.get64(saved, gp_offset)
            gp_offset += 8
        } else {
            integers[index] = c.get64(overflow, 0)
            overflow += 8
        }
        index += 1
    }
    index = 0
    while index < 8 {
        var bits: u64 = 0
        if fp_offset < 176 {
            bits = c.get64(saved, fp_offset)
            fp_offset += 16
        }
        doubles[index] = @bitCast(f64, bits)
        index += 1
    }
}

export fn pw_log_logv(level: u32, file: usize, line: i32, function: usize, pattern: usize, list: usize) -> void {
    var integers: [16]u64 = undefined
    var doubles: [8]f64 = undefined
    var integer_bytes: [*]u64 = undefined
    var double_bytes: [*]f64 = undefined
    unsafe {
        integer_bytes = @ptrCast([*]u64, &integers)
        double_bytes = @ptrCast([*]f64, &doubles)
    }
    fromList(list, integer_bytes, double_bytes)
    logLine(level, file, line, function, pattern, @intFromPtr(&integers), 16, @intFromPtr(&doubles))
}

export fn pw_log_logtv(level: u32, topic: usize, file: usize, line: i32, function: usize, pattern: usize, list: usize) -> void {
    if topic != 0 && c.get8(topic, 20) != 0 && level > c.get32(topic, 16) { return }
    pw_log_logv(level, file, line, function, pattern, list)
}

// ---------------------------------------------------------------------------
// Strings, names, numbers

export fn pw_strip(text: usize, whitespace: usize) -> usize { return util.strip(text, whitespace) }

export fn pw_split_walk(text: usize, delimiter: usize, length: usize, state: usize) -> usize { return util.splitWalk(text, delimiter, length, state) }

export fn pw_split_strv(text: usize, delimiter: usize, max_tokens: i32, count: usize) -> usize { return util.splitStrv(text, delimiter, max_tokens, count) }

export fn pw_split_ip(text: usize, delimiter: usize, max_tokens: i32, tokens: usize) -> i32 { return util.splitInPlace(text, delimiter, max_tokens, tokens) }

export fn pw_strv_parse(text: usize, length: usize, max_tokens: i32, count: usize) -> usize { return util.strvParse(text, length, max_tokens, count) }

export fn pw_free_strv(array: usize) -> void { util.freeStrv(array) }

export fn pw_strv_find(array: usize, text: usize) -> i32 { return util.strvFind(array, text) }

export fn pw_strv_find_common(first: usize, second: usize) -> i32 { return util.strvFindCommon(first, second) }

export fn pw_direction_as_string(direction: u32) -> usize { return c.literal(util.directionName(direction)) }

export fn pw_direction_reverse(direction: u32) -> u32 {
    if direction == 0 { return 1 }
    if direction == 1 { return 0 }
    return direction
}

export fn pw_node_state_as_string(state: i32) -> usize { return c.literal(util.nodeStateName(state)) }

export fn pw_link_state_as_string(state: i32) -> usize { return c.literal(util.linkStateName(state)) }

export fn pw_getrandom(buffer: usize, length: usize, flags: u32) -> isize { return util.random(buffer, length, flags) }

export fn pw_random() -> u32 { return util.random32() }

export fn pw_reallocarray(address: usize, count: usize, size: usize) -> usize {
    if size != 0 && count > 18446744073709551615 / size { return 0 }
    return c.grow(address, count * size)
}
