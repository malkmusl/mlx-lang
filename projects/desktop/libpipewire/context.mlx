// pw_context: what a program sets up before it connects: the main loop
// it runs on, its properties (filled with the process's name, user, host
// and the like, as PipeWire fills them), listeners, and the cores (the
// connections) made from it. Configuration files are not read: there is
// no daemon to configure, and the sections programs ask for are empty.
const c = @import("../libpulse/c.mlx")
const hooks = @import("./hooks.mlx")
const properties = @import("./properties.mlx")
const process = @import("./process.mlx")
const util = @import("./util.mlx")

pub const SIZE: usize = 96
const LOOP: usize = 0
const PROPERTIES: usize = 8
const USER_DATA_SIZE: usize = 16
const LISTENERS: usize = 24
pub const CORES: usize = 40
const SETTINGS: usize = 48
const DESTROYED: usize = 56

// pw_context_events: destroy 0, free 1, check_access 2, global_added 3,
// global_removed 4, driver_added 5, driver_removed 6.
const EVENT_DESTROY: usize = 0
const EVENT_FREE: usize = 1

fn fillProperties(props: usize) -> void {
    if properties.get(props, "application.name") == 0 { const set = properties.set(props, "application.name", process.prgname()) }
    if properties.get(props, "application.process.binary") == 0 { const set = properties.set(props, "application.process.binary", process.prgname()) }
    if properties.get(props, "application.language") == 0 {
        const language = c.environment("LANG")
        if language.length > 0 { const set = properties.setText(props, "application.language", language) }
    }
    if properties.get(props, "application.process.id") == 0 {
        var digits: [24]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &digits) }
        const count = util.decimal(bytes, @intCast(u64, c.processId()))
        const set = properties.setText(props, "application.process.id", bytes[0..count])
    }
    if properties.get(props, "application.process.user") == 0 { const set = properties.set(props, "application.process.user", process.userName()) }
    if properties.get(props, "application.process.host") == 0 { const set = properties.set(props, "application.process.host", process.hostName()) }
    if properties.get(props, "application.process.session-id") == 0 {
        const session = c.environment("XDG_SESSION_ID")
        if session.length > 0 { const set = properties.setText(props, "application.process.session-id", session) }
    }
    if properties.get(props, "window.x11.display") == 0 {
        const display = c.environment("DISPLAY")
        if display.length > 0 { const set = properties.setText(props, "window.x11.display", display) }
    }
    const version = properties.setText(props, "core.version", util.VERSION)
    if properties.get(props, "core.name") == 0 {
        var name: [128]u8 = undefined
        var out = c.out(@intFromPtr(&name), 128)
        c.append(&out, "pipewire-")
        c.append(&out, c.slice(process.userName()))
        c.append(&out, "-")
        c.appendNumber(&out, @intCast(u64, c.processId()))
        const set = properties.setText(props, "core.name", c.slice(@intFromPtr(&name)))
    }
}

// A context on `loop` with `props` (taken over; 0 for none) and
// `user_data_size` bytes after it for the program.
pub fn new(loop: usize, props: usize, user_data_size: usize) -> usize {
    const context = c.alloc(SIZE + user_data_size)
    if context == 0 {
        properties.free(props)
        return 0
    }
    var owned = props
    if owned == 0 { owned = properties.new() }
    if owned == 0 {
        c.release(context)
        return 0
    }
    fillProperties(owned)
    c.putPointer(context, LOOP, loop)
    c.putPointer(context, PROPERTIES, owned)
    c.putPointer(context, USER_DATA_SIZE, user_data_size)
    hooks.init(context + LISTENERS)
    return context
}

pub fn loopOf(context: usize) -> usize { return c.getPointer(context, LOOP) }

pub fn propertiesOf(context: usize) -> usize { return c.getPointer(context, PROPERTIES) }

pub fn userData(context: usize) -> usize { return context + SIZE }

pub fn addListener(context: usize, hook: usize, events: usize, data: usize) -> void { hooks.append(context + LISTENERS, hook, events, data) }

pub fn updateProperties(context: usize, dict: usize) -> i32 { return properties.update(c.getPointer(context, PROPERTIES), dict) }

// The cores of the context: a list through core.mlx's CONTEXT_NEXT word.
pub fn firstCore(context: usize) -> usize { return c.getPointer(context, CORES) }

pub fn setFirstCore(context: usize, core: usize) -> void { c.putPointer(context, CORES, core) }

// Tells the listeners the context goes (destroy, then free); the cores
// are the caller's to end first (core.mlx: they need the context's loop).
pub fn free(context: usize) -> void {
    if context == 0 || c.get32(context, DESTROYED) != 0 { return }
    c.put32(context, DESTROYED, 1)
    hooks.call0(context + LISTENERS, EVENT_DESTROY, 0)
    hooks.call0(context + LISTENERS, EVENT_FREE, 0)
    hooks.clean(context + LISTENERS)
    properties.free(c.getPointer(context, PROPERTIES))
    c.release(context)
}
