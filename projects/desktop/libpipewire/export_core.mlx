// libpipewire's contexts, cores and proxies for C: pw_context_*, pw_core_*,
// pw_proxy_*.
const c = @import("../libpulse/c.mlx")
const printf = @import("../libpulse/printf.mlx")
const hooks = @import("./hooks.mlx")
const context_module = @import("./context.mlx")
const core_module = @import("./core.mlx")
const proxy_module = @import("./proxy.mlx")
const util = @import("./util.mlx")

export fn pw_context_new(loop: usize, props: usize, user_data_size: usize) -> usize { return context_module.new(loop, props, user_data_size) }

// The cores of the context go first: they need its loop.
export fn pw_context_destroy(context: usize) -> void {
    if context == 0 { return }
    while context_module.firstCore(context) != 0 {
        const core = context_module.firstCore(context)
        const disconnected = core_module.disconnect(core)
        // A core the program still holds a reference to stays; off the list
        // it goes nonetheless.
        if context_module.firstCore(context) == core { context_module.setFirstCore(context, core_module.nextInContext(core)) }
    }
    context_module.free(context)
}

export fn pw_context_get_user_data(context: usize) -> usize { return context_module.userData(context) }

export fn pw_context_add_listener(context: usize, hook: usize, events: usize, data: usize) -> void { context_module.addListener(context, hook, events, data) }

export fn pw_context_get_properties(context: usize) -> usize { return context_module.propertiesOf(context) }

export fn pw_context_update_properties(context: usize, dict: usize) -> i32 { return context_module.updateProperties(context, dict) }

export fn pw_context_get_main_loop(context: usize) -> usize { return context_module.loopOf(context) }

// No configuration is read: there is no daemon here to configure.
export fn pw_context_get_conf_section(context: usize, section: usize) -> usize { return 0 }

export fn pw_context_parse_conf_section(context: usize, props: usize, section: usize) -> i32 { return 0 }

export fn pw_context_conf_update_props(context: usize, section: usize, props: usize) -> i32 { return 0 }

export fn pw_context_conf_section_for_each(context: usize, section: usize, callback: usize, data: usize) -> i32 { return 0 }

export fn pw_context_conf_section_match_rules(context: usize, section: usize, props: usize, callback: usize, data: usize) -> i32 { return 0 }

export fn pw_context_get_support(context: usize, count: usize) -> usize {
    if count != 0 { c.put32(count, 0, 0) }
    return 0
}

// The daemon's side of a context (its data loop, work queue, memory pool,
// globals, factories, modules, SPA plugins) is not here: a client has
// none.
export fn pw_context_get_data_loop(context: usize) -> usize { return 0 }

export fn pw_context_get_work_queue(context: usize) -> usize { return 0 }

export fn pw_context_get_mempool(context: usize) -> usize { return 0 }

export fn pw_context_for_each_global(context: usize, callback: usize, data: usize) -> i32 { return 0 }

export fn pw_context_find_global(context: usize, id: u32) -> usize { return 0 }

export fn pw_context_add_spa_lib(context: usize, pattern: usize, library: usize) -> i32 { return util.ENOTSUP }

export fn pw_context_find_spa_lib(context: usize, factory: usize) -> usize { return 0 }

export fn pw_context_load_spa_handle(context: usize, factory: usize, info: usize) -> usize { return 0 }

export fn pw_context_register_export_type(context: usize, kind: usize) -> i32 { return util.ENOTSUP }

export fn pw_context_find_export_type(context: usize, kind: usize) -> usize { return 0 }

export fn pw_context_set_object(context: usize, kind: usize, value: usize) -> i32 { return util.ENOTSUP }

export fn pw_context_get_object(context: usize, kind: usize) -> usize { return 0 }

export fn pw_context_find_factory(context: usize, name: usize) -> usize { return 0 }

export fn pw_context_find_protocol(context: usize, name: usize) -> usize { return 0 }

export fn pw_context_get_default_core(context: usize) -> usize { return 0 }

export fn pw_context_load_module(context: usize, name: usize, arguments: usize, props: usize) -> usize { return 0 }

export fn pw_context_create_client(context: usize, protocol: usize, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_create_core(context: usize, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_create_device(context: usize, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_create_factory(context: usize, name: usize, kind: usize, version: u32, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_create_link(context: usize, output: usize, input: usize, format_filter: usize, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_create_metadata(context: usize, name: usize, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_create_node(context: usize, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_create_port(context: usize, node: usize, direction: u32, port_id: u32, info: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_context_connect(context: usize, props: usize, user_data_size: usize) -> usize { return core_module.connect(context, props, user_data_size) }

export fn pw_context_connect_fd(context: usize, fd: i32, props: usize, user_data_size: usize) -> usize { return core_module.connectWithFd(context, @intCast(isize, fd), props, user_data_size) }

// A connection to a server inside the program: none runs here.
export fn pw_context_connect_self(context: usize, props: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_core_disconnect(core: usize) -> i32 { return core_module.disconnect(core) }

export fn pw_core_export(core: usize, kind: usize, props: usize, object: usize, user_data_size: usize) -> usize { return 0 }

export fn pw_core_find_proxy(core: usize, id: u32) -> usize { return core_module.objectAt(core, id) }

export fn pw_core_get_client(core: usize) -> usize { return core_module.clientOf(core) }

export fn pw_core_get_context(core: usize) -> usize { return core_module.contextOf(core) }

export fn pw_core_get_mempool(core: usize) -> usize { return 0 }

export fn pw_core_get_properties(core: usize) -> usize { return core_module.propertiesOf(core) }

export fn pw_core_get_user_data(core: usize) -> usize { return core_module.userData(core) }

export fn pw_core_set_paused(core: usize, paused: u8) -> i32 { return core_module.setPaused(core, paused != 0) }

export fn pw_core_steal_fd(core: usize) -> i32 { return core_module.stealFd(core) }

export fn pw_core_update_properties(core: usize, dict: usize) -> i32 { return core_module.updateProperties(core, dict) }

export fn pw_proxy_new(factory: usize, kind: usize, version: u32, user_data_size: usize) -> usize {
    if factory == 0 || kind == 0 { return 0 }
    const core = proxy_module.coreOf(factory)
    if core == 0 { return 0 }
    return core_module.newProxy(core, proxy_module.kindOf(c.slice(kind)), c.slice(kind), version, user_data_size)
}

export fn pw_proxy_add_listener(proxy: usize, hook: usize, events: usize, data: usize) -> void { proxy_module.addListener(proxy, hook, events, data) }

export fn pw_proxy_add_object_listener(proxy: usize, hook: usize, events: usize, data: usize) -> void { proxy_module.addObjectListener(proxy, hook, events, data) }

export fn pw_proxy_destroy(proxy: usize) -> void { core_module.destroyProxy(proxy) }

export fn pw_proxy_ref(proxy: usize) -> void { proxy_module.ref(proxy) }

export fn pw_proxy_unref(proxy: usize) -> void { core_module.unrefProxy(proxy) }

export fn pw_proxy_get_user_data(proxy: usize) -> usize { return proxy_module.userData(proxy) }

export fn pw_proxy_get_id(proxy: usize) -> u32 { return proxy_module.idOf(proxy) }

export fn pw_proxy_get_type(proxy: usize, version: usize) -> usize {
    if version != 0 { c.put32(version, 0, c.get32(proxy, proxy_module.VERSION)) }
    return c.getPointer(proxy, proxy_module.TYPE_NAME)
}

export fn pw_proxy_get_protocol(proxy: usize) -> usize { return 0 }

export fn pw_proxy_sync(proxy: usize, seq: i32) -> i32 {
    const core = proxy_module.coreOf(proxy)
    if !core_module.alive(core) { return util.EIO }
    return core_module.sync(core, proxy_module.idOf(proxy), seq)
}

export fn pw_proxy_set_bound_id(proxy: usize, global: u32) -> i32 {
    c.put32(proxy, proxy_module.BOUND_ID, global)
    proxy_module.emitBound(proxy, global)
    return 0
}

export fn pw_proxy_get_bound_id(proxy: usize) -> u32 { return c.get32(proxy, proxy_module.BOUND_ID) }

export fn pw_proxy_error(proxy: usize, result: i32, message: usize) -> i32 {
    const core = proxy_module.coreOf(proxy)
    if !core_module.alive(core) { return util.EIO }
    return core_module.sendError(core, proxy_module.idOf(proxy), @bitCast(i32, core_module.receivedSequence(core)), result, message)
}

export fn pw_proxy_errorf(proxy: usize, result: i32, pattern: usize, a: usize, b: usize, d: usize, e: usize, f: usize, g: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> i32 {
    const core = proxy_module.coreOf(proxy)
    if !core_module.alive(core) { return util.EIO }
    var integers: [6]u64 = [6]u64{ @intCast(u64, a), @intCast(u64, b), @intCast(u64, d), @intCast(u64, e), @intCast(u64, f), @intCast(u64, g) }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const text = printf.format(c.slice(pattern), @intFromPtr(&integers), 6, @intFromPtr(&doubles), 8)
    const sent = core_module.sendError(core, proxy_module.idOf(proxy), @bitCast(i32, core_module.receivedSequence(core)), result, text)
    c.release(text)
    return sent
}

export fn pw_proxy_get_object_listeners(proxy: usize) -> usize { return proxy + proxy_module.OBJECT_LISTENERS }

export fn pw_proxy_get_marshal(proxy: usize) -> usize { return 0 }

export fn pw_proxy_install_marshal(proxy: usize, implementor: u8) -> i32 { return util.ENOTSUP }
