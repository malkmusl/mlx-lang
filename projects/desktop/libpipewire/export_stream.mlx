// libpipewire's streams for C: pw_stream_*.
const c = @import("../libpulse/c.mlx")
const printf = @import("../libpulse/printf.mlx")
const context_module = @import("./context.mlx")
const stream_module = @import("./stream.mlx")
const util = @import("./util.mlx")

export fn pw_stream_new(core: usize, name: usize, props: usize) -> usize {
    if core == 0 { return 0 }
    return stream_module.new(core, 0, name, props)
}

// pw_stream_new_simple: a stream with a context of its own on `loop`,
// connected when pw_stream_connect is called.
export fn pw_stream_new_simple(loop: usize, name: usize, props: usize, events: usize, data: usize) -> usize {
    const context = context_module.new(loop, 0, 0)
    if context == 0 { return 0 }
    const stream = stream_module.new(0, context, name, props)
    if stream == 0 {
        context_module.free(context)
        return 0
    }
    stream_module.ownContext(stream)
    // The listener's hook lives in the stream (the program gave none).
    stream_module.addOwnListener(stream, events, data)
    return stream
}

export fn pw_stream_destroy(stream: usize) -> void { stream_module.free(stream) }

export fn pw_stream_add_listener(stream: usize, hook: usize, events: usize, data: usize) -> void { stream_module.addListener(stream, hook, events, data) }

export fn pw_stream_get_state(stream: usize, errorOut: usize) -> i32 {
    if errorOut != 0 { c.putPointer(errorOut, 0, stream_module.errorOf(stream)) }
    return stream_module.stateOf(stream)
}

export fn pw_stream_state_as_string(state: i32) -> usize { return c.literal(util.streamStateName(state)) }

export fn pw_stream_get_name(stream: usize) -> usize { return stream_module.nameOf(stream) }

export fn pw_stream_get_core(stream: usize) -> usize { return stream_module.coreOf(stream) }

export fn pw_stream_get_properties(stream: usize) -> usize { return stream_module.propertiesOf(stream) }

export fn pw_stream_update_properties(stream: usize, dict: usize) -> i32 { return stream_module.updateProperties(stream, dict) }

export fn pw_stream_connect(stream: usize, direction: u32, target: u32, flags: u32, params: usize, count: u32) -> i32 { return stream_module.connect(stream, direction, target, flags, params, count) }

export fn pw_stream_get_node_id(stream: usize) -> u32 { return stream_module.nodeId(stream) }

export fn pw_stream_disconnect(stream: usize) -> i32 { return stream_module.disconnect(stream) }

export fn pw_stream_set_error(stream: usize, result: i32, pattern: usize, a: usize, b: usize, d: usize, e: usize, f: usize, g: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> i32 {
    if result >= 0 { return result }
    var integers: [6]u64 = [6]u64{ @intCast(u64, a), @intCast(u64, b), @intCast(u64, d), @intCast(u64, e), @intCast(u64, f), @intCast(u64, g) }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const text = if pattern != 0 { printf.format(c.slice(pattern), @intFromPtr(&integers), 6, @intFromPtr(&doubles), 8) } else { c.duplicate("error") }
    const set = stream_module.setError(stream, result, text)
    c.release(text)
    return result
}

export fn pw_stream_update_params(stream: usize, params: usize, count: u32) -> i32 { return stream_module.updateParamsFromProgram(stream, params, count) }

export fn pw_stream_set_param(stream: usize, id: u32, param: usize) -> i32 { return stream_module.setParam(stream, id, param) }

// Controls come from PropInfo params of the node, which no server here
// offers: there are none.
export fn pw_stream_set_control(stream: usize, id: u32, count: u32, values: usize) -> i32 { return util.ENOTSUP }

export fn pw_stream_get_control(stream: usize, id: u32) -> usize { return 0 }

export fn pw_stream_set_active(stream: usize, active: u8) -> i32 { return stream_module.setActive(stream, active != 0) }

// pw_stream_get_time: the old struct pw_time of 40 bytes.
export fn pw_stream_get_time(stream: usize, time: usize) -> i32 { return stream_module.time(stream, time, 40) }

export fn pw_stream_get_time_n(stream: usize, time: usize, size: usize) -> i32 { return stream_module.time(stream, time, size) }

export fn pw_stream_get_nsec(stream: usize) -> u64 { return c.monotonicNanoseconds() }

export fn pw_stream_dequeue_buffer(stream: usize) -> usize { return stream_module.dequeueBuffer(stream) }

export fn pw_stream_queue_buffer(stream: usize, buffer: usize) -> i32 { return stream_module.queueBuffer(stream, buffer) }

export fn pw_stream_flush(stream: usize, drain: u8) -> i32 { return stream_module.flush(stream, drain != 0) }

export fn pw_stream_is_driving(stream: usize) -> u8 { return if stream_module.isDriving(stream) { 1 } else { 0 } }

export fn pw_stream_trigger_process(stream: usize) -> i32 { return stream_module.triggerProcess(stream) }
