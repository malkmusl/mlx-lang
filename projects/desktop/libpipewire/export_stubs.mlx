// The rest of libpipewire 1.0.5: what a program linked against it may
// reference but what this library does not do, so that every symbol
// resolves. The daemon's half of the API (pw_impl_*, pw_global_*,
// pw_resource_*, pw_protocol_*, pw_control_*, pw_buffers_*,
// pw_work_queue_*) answers nothing or -ENOTSUP: it belongs to the
// PipeWire daemon, whose place mlx-capture and mlx-audiod take. The
// client-side pieces that are not done yet (pw_filter, memory pools,
// configuration files) answer the same, and say so.
const c = @import("../libpulse/c.mlx")
const util = @import("./util.mlx")

// The daemon's objects (pw_impl_*: nodes, ports, links, clients, devices,
// factories, modules, metadata, cores as the daemon has them): a program
// that embeds the daemon would need them. This library is the client's
// half; mlx-capture and mlx-audiod are the daemon.
