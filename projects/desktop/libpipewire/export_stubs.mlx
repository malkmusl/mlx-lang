// pw_filter: the DSP-style port API of libpipewire (one node with any
// number of ports, used by JACK-like programs). Not implemented:
// pw_filter_new answers NULL, and the state of one is error. Screen
// sharing, cameras and audio use pw_stream.
export fn pw_filter_add_listener(filter: usize, listener: usize, events: usize, data: usize) -> void { }
export fn pw_filter_add_port(filter: usize, direction: usize, flags: usize, port_data_size: usize, props: usize, params: usize, n_params: usize) -> usize { return 0 }
export fn pw_filter_connect(filter: usize, flags: usize, params: usize, n_params: usize) -> i32 { return util.ENOTSUP }
export fn pw_filter_dequeue_buffer(port_data: usize) -> usize { return 0 }
export fn pw_filter_destroy(filter: usize) -> void { }
export fn pw_filter_disconnect(filter: usize) -> i32 { return util.ENOTSUP }
export fn pw_filter_flush(filter: usize, drain: usize) -> i32 { return util.ENOTSUP }
export fn pw_filter_get_core(filter: usize) -> usize { return 0 }
export fn pw_filter_get_dsp_buffer(port_data: usize, n_samples: usize) -> usize { return 0 }
export fn pw_filter_get_name(filter: usize) -> usize { return 0 }
export fn pw_filter_get_node_id(filter: usize) -> u32 { return 0 }
export fn pw_filter_get_nsec(filter: usize) -> u64 { return 0 }
export fn pw_filter_get_properties(filter: usize, port_data: usize) -> usize { return 0 }
export fn pw_filter_get_state(filter: usize, message: usize) -> i32 {
    if message != 0 { c.putPointer(message, 0, c.literal("pw_filter is not implemented")) }
    return -1
}
export fn pw_filter_get_time(filter: usize, time: usize) -> i32 { return util.ENOTSUP }
export fn pw_filter_is_driving(filter: usize) -> u8 { return 0 }
export fn pw_filter_new(core: usize, name: usize, props: usize) -> usize { return 0 }
