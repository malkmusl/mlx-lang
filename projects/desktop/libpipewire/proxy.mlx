// pw_proxy: the client's side of an object on the server (the core, the
// client, a registry, a node, a stream's client node...). As C sees it a
// proxy starts with a spa_interface (type, version, the method table and
// the proxy itself as the data), which is how pw_core_sync, pw_registry_bind
// and the other inline methods of the headers reach the library; the rest
// is the library's: the core, the id on the connection, the global id it
// was bound to, the reference count, the listeners (pw_proxy_events) and
// the object listeners (the interface's events), its kind, and the
// program's user data after it all.
const c = @import("../libpulse/c.mlx")
const hooks = @import("./hooks.mlx")
const process = @import("./process.mlx")

pub const SIZE: usize = 112
pub const CORE: usize = 32
pub const ID: usize = 40
pub const BOUND_ID: usize = 44
pub const REFCOUNT: usize = 48
pub const FLAGS: usize = 52
pub const LISTENERS: usize = 56
pub const OBJECT_LISTENERS: usize = 72
pub const KIND: usize = 88
pub const VERSION: usize = 92
pub const USER_DATA_SIZE: usize = 96
pub const TYPE_NAME: usize = 104

// The server told it to go (RemoveId), the program destroyed it, no more
// events reach the program (zombie), it has a slot in the core's map.
pub const REMOVED: u32 = 1
pub const DESTROYED: u32 = 2
pub const ZOMBIE: u32 = 4
pub const IN_MAP: u32 = 8

pub const KIND_CORE: u32 = 1
pub const KIND_CLIENT: u32 = 2
pub const KIND_REGISTRY: u32 = 3
pub const KIND_NODE: u32 = 4
pub const KIND_PORT: u32 = 5
pub const KIND_DEVICE: u32 = 6
pub const KIND_LINK: u32 = 7
pub const KIND_FACTORY: u32 = 8
pub const KIND_MODULE: u32 = 9
pub const KIND_METADATA: u32 = 10
pub const KIND_CLIENT_NODE: u32 = 11
pub const KIND_OTHER: u32 = 12

pub const INVALID_ID: u32 = 4294967295

// pw_proxy_events: destroy, bound, removed, done, error, bound_props.
const EVENT_DESTROY: usize = 0
const EVENT_BOUND: usize = 1
const EVENT_REMOVED: usize = 2
const EVENT_DONE: usize = 3
const EVENT_ERROR: usize = 4
const EVENT_BOUND_PROPS: usize = 5

pub fn typeName(kind: u32) -> []const u8 {
    if kind == KIND_CORE { return "PipeWire:Interface:Core" }
    if kind == KIND_CLIENT { return "PipeWire:Interface:Client" }
    if kind == KIND_REGISTRY { return "PipeWire:Interface:Registry" }
    if kind == KIND_NODE { return "PipeWire:Interface:Node" }
    if kind == KIND_PORT { return "PipeWire:Interface:Port" }
    if kind == KIND_DEVICE { return "PipeWire:Interface:Device" }
    if kind == KIND_LINK { return "PipeWire:Interface:Link" }
    if kind == KIND_FACTORY { return "PipeWire:Interface:Factory" }
    if kind == KIND_MODULE { return "PipeWire:Interface:Module" }
    if kind == KIND_METADATA { return "PipeWire:Interface:Metadata" }
    if kind == KIND_CLIENT_NODE { return "PipeWire:Interface:ClientNode" }
    return ""
}

pub fn kindOf(type_name: []const u8) -> u32 {
    var kind: u32 = KIND_CORE
    while kind < KIND_OTHER {
        if c.same(typeName(kind), type_name) { return kind }
        kind += 1
    }
    return KIND_OTHER
}

// The interface version the library speaks for each kind (PW_VERSION_*).
pub fn interfaceVersion(kind: u32) -> u32 {
    if kind == KIND_CORE { return 4 }
    if kind == KIND_CLIENT_NODE { return 5 }
    return 3
}

// The method table C calls through the interface (process.mlx fields).
pub fn methodsOf(kind: u32) -> usize {
    if kind == KIND_CORE { return process.field(process.CORE_METHODS) }
    if kind == KIND_REGISTRY { return process.field(process.REGISTRY_METHODS) }
    if kind == KIND_NODE { return process.field(process.NODE_METHODS) }
    if kind == KIND_CLIENT { return process.field(process.CLIENT_METHODS) }
    if kind == KIND_DEVICE { return process.field(process.DEVICE_METHODS) }
    if kind == KIND_PORT { return process.field(process.PORT_METHODS) }
    if kind == KIND_METADATA { return process.field(process.METADATA_METHODS) }
    if kind == KIND_LINK { return process.field(process.LINK_METHODS) }
    if kind == KIND_FACTORY { return process.field(process.FACTORY_METHODS) }
    if kind == KIND_MODULE { return process.field(process.MODULE_METHODS) }
    return process.field(process.CLIENT_NODE_METHODS)
}

// Fills `proxy` (SIZE bytes and the user data after them, zeroed) as the
// object `id` of `kind` on `core`.
pub fn init(proxy: usize, core: usize, kind: u32, type_name: []const u8, version: u32, user_data_size: usize, id: u32) -> void {
    c.putPointer(proxy, TYPE_NAME, c.duplicate(type_name))
    hooks.interface(proxy, c.getPointer(proxy, TYPE_NAME), version, methodsOf(kind), proxy)
    c.putPointer(proxy, CORE, core)
    c.put32(proxy, ID, id)
    c.put32(proxy, BOUND_ID, INVALID_ID)
    c.put32(proxy, REFCOUNT, 1)
    c.put32(proxy, FLAGS, IN_MAP)
    hooks.init(proxy + LISTENERS)
    hooks.init(proxy + OBJECT_LISTENERS)
    c.put32(proxy, KIND, kind)
    c.put32(proxy, VERSION, version)
    c.putPointer(proxy, USER_DATA_SIZE, user_data_size)
}

pub fn userData(proxy: usize) -> usize { return if c.getPointer(proxy, USER_DATA_SIZE) > 0 { proxy + SIZE } else { 0 } }

pub fn idOf(proxy: usize) -> u32 { return c.get32(proxy, ID) }

pub fn kindOfProxy(proxy: usize) -> u32 { return c.get32(proxy, KIND) }

pub fn coreOf(proxy: usize) -> usize { return c.getPointer(proxy, CORE) }

pub fn has(proxy: usize, flag: u32) -> bool { return c.get32(proxy, FLAGS) & flag != 0 }

pub fn set(proxy: usize, flag: u32) -> void { c.put32(proxy, FLAGS, c.get32(proxy, FLAGS) | flag) }

pub fn clear(proxy: usize, flag: u32) -> void { c.put32(proxy, FLAGS, c.get32(proxy, FLAGS) & ~flag) }

pub fn ref(proxy: usize) -> void { c.put32(proxy, REFCOUNT, c.get32(proxy, REFCOUNT) + 1) }

// One reference less: true when it was the last (the caller frees).
pub fn unref(proxy: usize) -> bool {
    const count = c.get32(proxy, REFCOUNT)
    if count <= 1 {
        c.put32(proxy, REFCOUNT, 0)
        return true
    }
    c.put32(proxy, REFCOUNT, count - 1)
    return false
}

pub fn release(proxy: usize) -> void {
    c.release(c.getPointer(proxy, TYPE_NAME))
    c.release(proxy)
}

pub fn addListener(proxy: usize, hook: usize, events: usize, data: usize) -> void { hooks.append(proxy + LISTENERS, hook, events, data) }

pub fn addObjectListener(proxy: usize, hook: usize, events: usize, data: usize) -> void { hooks.append(proxy + OBJECT_LISTENERS, hook, events, data) }

pub fn emitDestroy(proxy: usize) -> void { hooks.call0(proxy + LISTENERS, EVENT_DESTROY, 0) }

pub fn emitBound(proxy: usize, global: u32) -> void { hooks.call1(proxy + LISTENERS, EVENT_BOUND, 0, @intCast(usize, global)) }

pub fn emitRemoved(proxy: usize) -> void { hooks.call0(proxy + LISTENERS, EVENT_REMOVED, 0) }

pub fn emitDone(proxy: usize, seq: i32) -> void { hooks.call1(proxy + LISTENERS, EVENT_DONE, 0, c.int(seq)) }

pub fn emitError(proxy: usize, seq: i32, result: i32, message: usize) -> void { hooks.call3(proxy + LISTENERS, EVENT_ERROR, 0, c.int(seq), c.int(result), message) }

pub fn emitBoundProps(proxy: usize, global: u32, props: usize) -> void { hooks.call2(proxy + LISTENERS, EVENT_BOUND_PROPS, 1, @intCast(usize, global), props) }

// The object's own events (the interface's), by index.
pub fn emit0(proxy: usize, index: usize) -> void { hooks.call0(proxy + OBJECT_LISTENERS, index, 0) }

pub fn emit1(proxy: usize, index: usize, a: usize) -> void { hooks.call1(proxy + OBJECT_LISTENERS, index, 0, a) }

pub fn emit2(proxy: usize, index: usize, a: usize, b: usize) -> void { hooks.call2(proxy + OBJECT_LISTENERS, index, 0, a, b) }

pub fn emit3(proxy: usize, index: usize, a: usize, b: usize, d: usize) -> void { hooks.call3(proxy + OBJECT_LISTENERS, index, 0, a, b, d) }

pub fn emit4(proxy: usize, index: usize, a: usize, b: usize, d: usize, e: usize) -> void { hooks.call4(proxy + OBJECT_LISTENERS, index, 0, a, b, d, e) }

pub fn emit5(proxy: usize, index: usize, a: usize, b: usize, d: usize, e: usize, f: usize) -> void { hooks.call5(proxy + OBJECT_LISTENERS, index, 0, a, b, d, e, f) }

pub fn emit3Versioned(proxy: usize, index: usize, version: u32, a: usize, b: usize, d: usize) -> void { hooks.call3(proxy + OBJECT_LISTENERS, index, version, a, b, d) }
