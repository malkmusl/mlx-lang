// The object infos a program keeps between events (pw_*_info_update,
// _merge, _free): the registry hands it a struct pw_node_info (port,
// device, client, link, factory, module, core) that lives only during
// the event, and it keeps a copy of its own that each update merges into
// by change_mask. The copies and their strings, dicts, params and format
// are all in C memory, so the program may free them with the library's
// own pw_*_info_free, as it does with PipeWire's.
//
// Layouts (bytes): the id first, then the kind's own fields, change_mask,
// props (a struct spa_dict pointer) and, for nodes, ports and devices,
// params (an array of struct spa_param_info, 32 bytes each) and n_params.
const c = @import("../libpulse/c.mlx")

const CHANGE_PROPS: u64 = 1
// struct spa_param_info: id, flags, user, seq, padding[4].
const PARAM: usize = 32

// struct pw_core_info: id, cookie, user_name, host_name, version, name,
// change_mask, props.
pub const CORE: usize = 56
// struct pw_node_info: id, max_input_ports, max_output_ports, change_mask,
// n_input_ports, n_output_ports, state, error, props, params, n_params.
pub const NODE: usize = 72
const NODE_INPUT_PORTS: u64 = 1
const NODE_OUTPUT_PORTS: u64 = 2
const NODE_STATE: u64 = 4
const NODE_PROPS: u64 = 8
const NODE_PARAMS: u64 = 16
// struct pw_port_info: id, direction, change_mask, props, params, n_params.
pub const PORT: usize = 40
// struct pw_device_info: id, change_mask, props, params, n_params.
pub const DEVICE: usize = 40
const PARAMS_MASK: u64 = 2
// struct pw_client_info: id, change_mask, props.
pub const CLIENT: usize = 24
// struct pw_link_info: id, output_node_id, output_port_id, input_node_id,
// input_port_id, change_mask, state, error, format, props.
pub const LINK: usize = 64
const LINK_STATE: u64 = 1
const LINK_FORMAT: u64 = 2
const LINK_PROPS: u64 = 4
// struct pw_factory_info: id, name, type, version, change_mask, props.
pub const FACTORY: usize = 48
// struct pw_module_info: id, name, filename, args, change_mask, props.
pub const MODULE: usize = 48

// A copy of a struct spa_dict with copies of its strings; 0 for none.
pub fn dictCopy(dict: usize) -> usize {
    if dict == 0 { return 0 }
    const count = @intCast(usize, c.get32(dict, 4))
    const copy = c.alloc(16)
    if copy == 0 { return 0 }
    const items = c.alloc(count * 16)
    if items == 0 {
        c.release(copy)
        return 0
    }
    c.put32(copy, 0, c.get32(dict, 0))
    c.put32(copy, 4, @intCast(u32, count))
    c.putPointer(copy, 8, items)
    const source = c.getPointer(dict, 8)
    var index: usize = 0
    while index < count {
        c.putPointer(items, index * 16, c.duplicateC(c.getPointer(source, index * 16)))
        const value = c.getPointer(source, index * 16 + 8)
        c.putPointer(items, index * 16 + 8, if value == 0 { 0 } else { c.duplicateC(value) })
        index += 1
    }
    return copy
}

pub fn dictDestroy(dict: usize) -> void {
    if dict == 0 { return }
    const count = @intCast(usize, c.get32(dict, 4))
    const items = c.getPointer(dict, 8)
    var index: usize = 0
    while index < count {
        c.release(c.getPointer(items, index * 16))
        c.release(c.getPointer(items, index * 16 + 8))
        index += 1
    }
    c.release(items)
    c.release(dict)
}

// A copy of a pod (its header and body) in C memory; 0 for none.
pub fn podCopy(pod: usize) -> usize {
    if pod == 0 { return 0 }
    const size = 8 + @intCast(usize, c.get32(pod, 0))
    const copy = c.alloc(size)
    if copy != 0 { c.copy(copy, pod, size) }
    return copy
}

// `text` replaced by a copy of `update`'s string (or 0).
fn replaceString(info: usize, at: usize, update: usize) -> void {
    c.release(c.getPointer(info, at))
    const text = c.getPointer(update, at)
    c.putPointer(info, at, if text == 0 { 0 } else { c.duplicateC(text) })
}

fn replaceDict(info: usize, at: usize, update: usize) -> void {
    dictDestroy(c.getPointer(info, at))
    c.putPointer(info, at, dictCopy(c.getPointer(update, at)))
}

// The params array at `params` (its count at `count`) brought to the
// update's: an entry's user counter goes up when its flags changed (or
// it is new), and back to 0 first when `reset`.
fn mergeParams(info: usize, params: usize, count: usize, update: usize, reset: bool) -> void {
    const wanted = @intCast(usize, c.get32(update, count))
    var had = @intCast(usize, c.get32(info, count))
    var array = c.getPointer(info, params)
    if wanted == 0 {
        c.release(array)
        array = 0
        had = 0
    } else {
        array = c.grow(array, wanted * PARAM)
        if array == 0 { had = 0 }
    }
    c.putPointer(info, params, array)
    if array == 0 {
        c.put32(info, count, 0)
        return
    }
    const source = c.getPointer(update, params)
    var index: usize = 0
    while index < had && index < wanted {
        const entry = array + index * PARAM
        const fresh = source + index * PARAM
        c.put32(entry, 0, c.get32(fresh, 0))
        if reset { c.put32(entry, 8, 0) }
        if c.get32(entry, 4) != c.get32(fresh, 4) {
            c.put32(entry, 4, c.get32(fresh, 4))
            c.put32(entry, 8, c.get32(entry, 8) + 1)
        }
        index += 1
    }
    while index < wanted {
        const entry = array + index * PARAM
        const fresh = source + index * PARAM
        c.zero(entry, PARAM)
        c.put32(entry, 0, c.get32(fresh, 0))
        c.put32(entry, 4, c.get32(fresh, 4))
        c.put32(entry, 8, 1)
        index += 1
    }
    c.put32(info, count, @intCast(u32, wanted))
}

// The change mask at `at` reset (when asked) and the update's bits added;
// the update's mask.
fn mergeMask(info: usize, at: usize, update: usize, reset: bool) -> u64 {
    const fresh = c.get64(update, at)
    const mask = if reset { fresh } else { c.get64(info, at) | fresh }
    c.put64(info, at, mask)
    return fresh
}

pub fn mergeCore(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(CORE)
        if info == 0 { return 0 }
        c.put32(info, 0, c.get32(update, 0))
        c.put32(info, 4, c.get32(update, 4))
        replaceString(info, 8, update)
        replaceString(info, 16, update)
        replaceString(info, 24, update)
        replaceString(info, 32, update)
    }
    const changed = mergeMask(info, 40, update, reset)
    if changed & CHANGE_PROPS != 0 { replaceDict(info, 48, update) }
    return info
}

pub fn freeCore(info: usize) -> void {
    if info == 0 { return }
    c.release(c.getPointer(info, 8))
    c.release(c.getPointer(info, 16))
    c.release(c.getPointer(info, 24))
    c.release(c.getPointer(info, 32))
    dictDestroy(c.getPointer(info, 48))
    c.release(info)
}

pub fn mergeNode(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(NODE)
        if info == 0 { return 0 }
        c.put32(info, 0, c.get32(update, 0))
        c.put32(info, 4, c.get32(update, 4))
        c.put32(info, 8, c.get32(update, 8))
    }
    const changed = mergeMask(info, 16, update, reset)
    if changed & NODE_INPUT_PORTS != 0 { c.put32(info, 24, c.get32(update, 24)) }
    if changed & NODE_OUTPUT_PORTS != 0 { c.put32(info, 28, c.get32(update, 28)) }
    if changed & NODE_STATE != 0 {
        c.put32(info, 32, c.get32(update, 32))
        replaceString(info, 40, update)
    }
    if changed & NODE_PROPS != 0 { replaceDict(info, 48, update) }
    if changed & NODE_PARAMS != 0 { mergeParams(info, 56, 64, update, reset) }
    return info
}

pub fn freeNode(info: usize) -> void {
    if info == 0 { return }
    c.release(c.getPointer(info, 40))
    dictDestroy(c.getPointer(info, 48))
    c.release(c.getPointer(info, 56))
    c.release(info)
}

pub fn mergePort(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(PORT)
        if info == 0 { return 0 }
        c.put32(info, 0, c.get32(update, 0))
        c.put32(info, 4, c.get32(update, 4))
    }
    const changed = mergeMask(info, 8, update, reset)
    if changed & CHANGE_PROPS != 0 { replaceDict(info, 16, update) }
    if changed & PARAMS_MASK != 0 { mergeParams(info, 24, 32, update, reset) }
    return info
}

pub fn freePort(info: usize) -> void {
    if info == 0 { return }
    dictDestroy(c.getPointer(info, 16))
    c.release(c.getPointer(info, 24))
    c.release(info)
}

pub fn mergeDevice(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(DEVICE)
        if info == 0 { return 0 }
        c.put32(info, 0, c.get32(update, 0))
    }
    const changed = mergeMask(info, 8, update, reset)
    if changed & CHANGE_PROPS != 0 { replaceDict(info, 16, update) }
    if changed & PARAMS_MASK != 0 { mergeParams(info, 24, 32, update, reset) }
    return info
}

pub fn freeDevice(info: usize) -> void { freePort(info) }

pub fn mergeClient(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(CLIENT)
        if info == 0 { return 0 }
        c.put32(info, 0, c.get32(update, 0))
    }
    const changed = mergeMask(info, 8, update, reset)
    if changed & CHANGE_PROPS != 0 { replaceDict(info, 16, update) }
    return info
}

pub fn freeClient(info: usize) -> void {
    if info == 0 { return }
    dictDestroy(c.getPointer(info, 16))
    c.release(info)
}

pub fn mergeLink(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(LINK)
        if info == 0 { return 0 }
        c.copy(info, update, 20)
    }
    const changed = mergeMask(info, 24, update, reset)
    if changed & LINK_STATE != 0 {
        c.put32(info, 32, c.get32(update, 32))
        replaceString(info, 40, update)
    }
    if changed & LINK_FORMAT != 0 {
        c.release(c.getPointer(info, 48))
        c.putPointer(info, 48, podCopy(c.getPointer(update, 48)))
    }
    if changed & LINK_PROPS != 0 { replaceDict(info, 56, update) }
    return info
}

pub fn freeLink(info: usize) -> void {
    if info == 0 { return }
    c.release(c.getPointer(info, 40))
    c.release(c.getPointer(info, 48))
    dictDestroy(c.getPointer(info, 56))
    c.release(info)
}

pub fn mergeFactory(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(FACTORY)
        if info == 0 { return 0 }
        c.put32(info, 0, c.get32(update, 0))
        replaceString(info, 8, update)
        replaceString(info, 16, update)
        c.put32(info, 24, c.get32(update, 24))
    }
    const changed = mergeMask(info, 32, update, reset)
    if changed & CHANGE_PROPS != 0 { replaceDict(info, 40, update) }
    return info
}

pub fn freeFactory(info: usize) -> void {
    if info == 0 { return }
    c.release(c.getPointer(info, 8))
    c.release(c.getPointer(info, 16))
    dictDestroy(c.getPointer(info, 40))
    c.release(info)
}

pub fn mergeModule(given: usize, update: usize, reset: bool) -> usize {
    if update == 0 { return given }
    var info = given
    if info == 0 {
        info = c.alloc(MODULE)
        if info == 0 { return 0 }
        c.put32(info, 0, c.get32(update, 0))
        replaceString(info, 8, update)
        replaceString(info, 16, update)
        replaceString(info, 24, update)
    }
    const changed = mergeMask(info, 32, update, reset)
    if changed & CHANGE_PROPS != 0 { replaceDict(info, 40, update) }
    return info
}

pub fn freeModule(info: usize) -> void {
    if info == 0 { return }
    c.release(c.getPointer(info, 8))
    c.release(c.getPointer(info, 16))
    c.release(c.getPointer(info, 24))
    dictDestroy(c.getPointer(info, 40))
    c.release(info)
}
