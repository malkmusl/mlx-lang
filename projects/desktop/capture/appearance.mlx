// The desktop's look for apps, on the portal's object (portal.mlx):
// org.freedesktop.portal.Settings (version 2), which GTK (libadwaita), Qt
// and Firefox ask to follow dark and light, and org.mlx.Appearance to
// change it (the top bar's control centre, mlx-settings).
//
//   Settings.ReadAll(as) -> a{sa{sv}}   the namespaces asked for (none:
//                                       all; "org.freedesktop.*" globs)
//   Settings.ReadOne(s, s) -> v         one value
//   Settings.Read(s, s) -> v            the same in a variant again (the
//                                       old way)
//   Settings.SettingChanged(s, s, v)    a value changed
//   Appearance.SetColorScheme(u)        0 no preference, 1 dark, 2 light
//
// It knows org.freedesktop.appearance's color-scheme (u) and contrast (u,
// always 0). The scheme is kept in ~/.config/mlx/appearance.conf
// ("color-scheme = dark", "light" or "default"); without it the desktop
// is dark.
const std = @import("std")
const dbus = @import("std.dbus")
const service = @import("./service.mlx")
const config_file = @import("../shared/config_file.mlx")

const Server = service.Server

pub const SETTINGS: []const u8 = "org.freedesktop.portal.Settings"
pub const OWN: []const u8 = "org.mlx.Appearance"
pub const VERSION: u32 = 2
const NAMESPACE: []const u8 = "org.freedesktop.appearance"
const FILE: []const u8 = "appearance.conf"
const BODY: usize = 16384

pub const SCHEME_DEFAULT: u32 = 0
pub const SCHEME_DARK: u32 = 1
pub const SCHEME_LIGHT: u32 = 2

fn nothing() -> [*]const isize {
    var none: [1]isize = [1]isize{ 0 }
    return &none
}

fn writer(server: *Server, writing: *dbus.Writer) -> void { dbus.begin(writing, server.*.body, BODY, false) }

// The scheme kept (dark without one).
pub fn scheme(server: *Server) -> u32 {
    if config_file.equals(server.*.environment, FILE, "color-scheme", "light", server.*.allocator) { return SCHEME_LIGHT }
    if config_file.equals(server.*.environment, FILE, "color-scheme", "default", server.*.allocator) { return SCHEME_DEFAULT }
    return SCHEME_DARK
}

fn refuse(server: *Server, message: *const dbus.Header, error_name: []const u8, text: []const u8) -> void {
    if message.*.flags & dbus.NO_REPLY_EXPECTED != 0 { return }
    var writing: dbus.Writer = undefined
    writer(server, &writing)
    dbus.putString(&writing, text)
    var header = dbus.newHeader(dbus.ERROR, 0)
    header.errorName = error_name
    header.replySerial = message.*.serial
    header.hasReplySerial = true
    header.destination = message.*.sender
    header.signature = "s"
    const sent = dbus.send(server.*.bus, &header, writing.bytes, writing.length, nothing(), 0)
}

// Whether namespace pattern `pattern` takes in `name` (a trailing "*"
// matches the rest).
fn matches(pattern: []const u8, name: []const u8) -> bool {
    if pattern.length > 0 && pattern[pattern.length - 1] == 42 {
        const prefix = pattern[0..pattern.length - 1]
        return name.length >= prefix.length && service.same(name[0..prefix.length], prefix)
    }
    return service.same(pattern, name)
}

// A {sv} entry with a u32 value.
fn entry(writing: *dbus.Writer, key: []const u8, value: u32) -> void {
    dbus.pad(writing, 8)
    dbus.putString(writing, key)
    dbus.putVariantU32(writing, value)
}

// Key `key` of the appearance's value into `value`; false when there is
// no such key.
fn valueOf(server: *Server, namespace: []const u8, key: []const u8, value: *u32) -> bool {
    if !service.same(namespace, NAMESPACE) { return false }
    if service.same(key, "color-scheme") {
        value.* = scheme(server)
        return true
    }
    if service.same(key, "contrast") {
        value.* = 0
        return true
    }
    return false
}

// A call to SETTINGS or OWN on the portal's object.
pub fn handle(server: *Server, message: *const dbus.Header) -> void {
    var reading = dbus.reader(dbus.bodyOf(server.*.bus, message), message.*.bodyLength, message.*.big)
    const member = message.*.member
    var writing: dbus.Writer = undefined
    writer(server, &writing)
    if service.same(message.*.interface, OWN) {
        if !service.same(member, "SetColorScheme") {
            refuse(server, message, "org.freedesktop.DBus.Error.UnknownMethod", "org.mlx.Appearance has SetColorScheme(u)")
            return
        }
        const wanted = dbus.readU32(&reading)
        if reading.failed || wanted > SCHEME_LIGHT {
            refuse(server, message, "org.freedesktop.DBus.Error.InvalidArgs", "SetColorScheme takes 0, 1 or 2")
            return
        }
        const text: []const u8 = if wanted == SCHEME_LIGHT { "light" } else if wanted == SCHEME_DEFAULT { "default" } else { "dark" }
        if !config_file.set(server.*.environment, FILE, "color-scheme", text, server.*.allocator) {
            refuse(server, message, "org.freedesktop.DBus.Error.Failed", "appearance.conf could not be written")
            return
        }
        if message.*.flags & dbus.NO_REPLY_EXPECTED == 0 { const sent = dbus.reply(server.*.bus, message, "", server.*.body, 0, nothing(), 0) }
        if server.*.verbose {
            const said = std.io.writeAll(std.io.stderr(), "portal: color-scheme ")
            const said_value = std.io.writeAll(std.io.stderr(), text)
            const said_end = std.io.writeAll(std.io.stderr(), "\n")
        }
        // Everyone listening hears it.
        writer(server, &writing)
        dbus.putString(&writing, NAMESPACE)
        dbus.putString(&writing, "color-scheme")
        dbus.putVariantU32(&writing, wanted)
        var header = dbus.newHeader(dbus.SIGNAL, 0)
        header.path = "/org/freedesktop/portal/desktop"
        header.interface = SETTINGS
        header.member = "SettingChanged"
        header.signature = "ssv"
        const signalled = dbus.send(server.*.bus, &header, writing.bytes, writing.length, nothing(), 0)
        return
    }
    if service.same(member, "ReadAll") {
        // The namespaces asked for.
        var wanted = false
        const length = dbus.readU32(&reading)
        const end = reading.position + @intCast(usize, length)
        if length == 0 { wanted = true }
        while reading.position < end && !reading.failed {
            if matches(dbus.readString(&reading), NAMESPACE) { wanted = true }
        }
        const outer = dbus.beginArray(&writing, 8)
        if wanted {
            dbus.pad(&writing, 8)
            dbus.putString(&writing, NAMESPACE)
            const inner = dbus.beginArray(&writing, 8)
            entry(&writing, "color-scheme", scheme(server))
            entry(&writing, "contrast", 0)
            dbus.endArray(&writing, inner, 8)
        }
        dbus.endArray(&writing, outer, 8)
        const sent = dbus.reply(server.*.bus, message, "a{sa{sv}}", writing.bytes, writing.length, nothing(), 0)
        return
    }
    if service.same(member, "ReadOne") || service.same(member, "Read") {
        const namespace = dbus.readString(&reading)
        const key = dbus.readString(&reading)
        var value: u32 = 0
        if reading.failed || !valueOf(server, namespace, key, &value) {
            refuse(server, message, "org.freedesktop.portal.Error.NotFound", "no such setting")
            return
        }
        // Read wraps the value in a second variant.
        if service.same(member, "Read") { dbus.putSignature(&writing, "v") }
        dbus.putVariantU32(&writing, value)
        const sent = dbus.reply(server.*.bus, message, "v", writing.bytes, writing.length, nothing(), 0)
        return
    }
    refuse(server, message, "org.freedesktop.DBus.Error.UnknownMethod", "org.freedesktop.portal.Settings has ReadAll, ReadOne and Read")
}
