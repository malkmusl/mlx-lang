// mlx-capture: the screen, or one window, as a PNG, through the
// compositor's ext-image-copy-capture-v1 (client.mlx, which the OBS plugin
// in obs.mlx shares). No libc, no libwayland.
//
//   mlx-capture FILE.png                   the screen
//   mlx-capture --window NAME FILE.png     the window whose identifier, app
//                                          id or title is NAME
//   mlx-capture --list                     the windows: identifier, app id,
//                                          title
//   --frames N                             N frames in a row (each after the
//                                          last: the next waits until
//                                          something changed), the last one
//                                          saved; each says what changed
//                                          ("frame 2: damage 0,0 40x20")
//
// It prints "saved FILE.png (WxH)", or says why not (and fails).
//
//   mlx-capture --record FILE.mkv          a video of the screen (or of
//                                          --window NAME) with its sound
//                                          (record.mlx), until Ctrl+C
//   --duration SECONDS                     or this long
//   --fps N                                at most N frames a second (30)
//   --quality Q                            JPEG quality, 1 to 100 (80)
//   --audio desktop,microphone             the sound tracks: desktop (what
//                                          plays), microphone, both (the
//                                          default) or none
//   --mix                                  both in one track
//   --desktop SOURCE                       the desktop's sound from another
//                                          sink's monitor (monitor:NAME)
//
// Screen sharing (browsers, Discord, OBS), without PipeWire:
//
//   mlx-capture --portal                   the ScreenCast portal on the
//                                          session bus, with PipeWire's
//                                          protocol for the streams
//                                          (serve.mlx)
//   mlx-capture --pick APP                 its dialog (picker.mlx)
//   mlx-capture --share -- COMMAND         a share through the portal, as a
//                                          browser asks for one, handed to
//                                          COMMAND (share.mlx)
const std = @import("std")
const png = @import("std.png")
const crash = @import("std.crash")
const client = @import("./client.mlx")
const recording = @import("./record.mlx")
const serve = @import("./serve.mlx")
const picker = @import("./picker.mlx")
const share = @import("./share.mlx")

const Capture = client.Capture

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

fn sayNumber(value: i32) -> void {
    if value < 0 {
        say("-")
        const ignored = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, 0 - value))
    } else {
        const ignored = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, value))
    }
}

fn listWindows(capture: *Capture) -> void {
    var index: usize = 0
    while index < capture.*.windowCount {
        const window = &capture.*.windows[index]
        if !window.*.closed {
            say(client.identifierOf(window))
            say("  ")
            say(client.appIdOf(window))
            say("  ")
            say(client.titleOf(window))
            say("\n")
        }
        index += 1
    }
}

const Failure = error { NoCapture, NoWindow, Stopped, CaptureFailed, NotSaved, Usage }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    const said = std.io.eprintln(message)
    return failure
}

// Waits until the session's constraints are in (or it stopped).
fn awaitConstraints(capture: *Capture) -> bool {
    while !capture.*.constraintsDone && !capture.*.stopped {
        if !client.wait(capture) { return false }
    }
    return !capture.*.stopped
}

fn run(capture: *Capture, file: std.string.String, window_name: std.string.String, frames: usize, list: bool) -> !void {
    if !client.open(capture, "") { return fail("mlx-capture: no compositor with screen capture (ext-image-copy-capture-v1)", Failure.NoCapture) }
    if list {
        listWindows(capture)
        client.close(capture)
        return
    }
    const whole = window_name.length == 0
    if !client.start(capture, std.string.asSlice(window_name)) {
        if whole { return fail("mlx-capture: the compositor offers no screen capture", Failure.NoCapture) }
        return fail("mlx-capture: no such window (mlx-capture --list shows them)", Failure.NoWindow)
    }
    if !awaitConstraints(capture) { return fail("mlx-capture: the capture stopped (the window went)", Failure.Stopped) }
    var shown: usize = 0
    var tries: usize = 0
    while shown < frames {
        if !client.requestFrame(capture) { return fail("mlx-capture: no buffer the compositor would take", Failure.CaptureFailed) }
        while !capture.*.ready && !capture.*.failed {
            if !client.wait(capture) { return fail("mlx-capture: the compositor went", Failure.CaptureFailed) }
        }
        if capture.*.failed {
            // Another size: a buffer of the new one.
            if capture.*.failure == 1 && tries < 3 {
                tries += 1
                if !awaitConstraints(capture) { return fail("mlx-capture: the capture stopped (the window went)", Failure.Stopped) }
                continue
            }
            return fail("mlx-capture: the capture failed", Failure.CaptureFailed)
        }
        shown += 1
        if frames > 1 {
            say("frame ")
            sayNumber(@intCast(i32, shown))
            say(": damage ")
            sayNumber(capture.*.damageX)
            say(",")
            sayNumber(capture.*.damageY)
            say(" ")
            sayNumber(capture.*.damageWidth)
            say("x")
            sayNumber(capture.*.damageHeight)
            say("\n")
        }
    }
    const width = @intCast(usize, capture.*.width)
    const height = @intCast(usize, capture.*.height)
    const saved = png.saveFile(file.pointer, client.pixels(capture), width, height, width, !whole, std.page_allocator.init())
    client.close(capture)
    if !saved { return fail("mlx-capture: the file could not be written", Failure.NotSaved) }
    say("saved ")
    say(std.string.asSlice(file))
    say(" (")
    sayNumber(@intCast(i32, width))
    say("x")
    sayNumber(@intCast(i32, height))
    say(")\n")
}

fn number(text: std.string.String) -> usize {
    var value: usize = 0
    var at: usize = 0
    while at < text.length && text.pointer[at] >= 48 && text.pointer[at] <= 57 {
        value = value * 10 + @intCast(usize, text.pointer[at] - 48)
        at += 1
    }
    return value
}

fn contains(text: []const u8, word: []const u8) -> bool {
    var at: usize = 0
    while at + word.length <= text.length {
        if std.text.same(text[at..at + word.length], word) { return true }
        at += 1
    }
    return false
}

pub fn main(arguments: [][*]const u8) -> !void {
    const installed = crash.install()
    if std.process.count(arguments) >= 2 {
        const mode = std.process.argument(arguments, 1)
        if named(mode, "--portal") {
            try serve.run(arguments)
            return
        }
        if named(mode, "--pick") {
            try picker.run(arguments)
            return
        }
        if named(mode, "--share") {
            try share.run(arguments)
            return
        }
    }
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Capture), 16)
    var capture: *Capture = undefined
    unsafe { capture = @ptrCast(*Capture, memory.?) }
    var file = std.string.fromSlice("")
    var window_name = std.string.fromSlice("")
    var frames: usize = 1
    var list = false
    var record = false
    var options: recording.Options = undefined
    options.window = ""
    options.duration = 0
    options.fps = 30
    options.quality = 80
    options.desktop = true
    options.microphone = true
    options.mix = false
    options.desktopSource = "monitor"
    options.environment = std.process.environmentEntries(arguments)
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if named(argument, "--list") {
            list = true
        } else if named(argument, "--window") && index + 1 < count {
            index += 1
            window_name = std.process.argument(arguments, index)
        } else if named(argument, "--record") && index + 1 < count {
            index += 1
            record = true
            file = std.process.argument(arguments, index)
        } else if named(argument, "--duration") && index + 1 < count {
            index += 1
            options.duration = @intCast(u64, number(std.process.argument(arguments, index))) * 1000
        } else if named(argument, "--fps") && index + 1 < count {
            index += 1
            options.fps = @intCast(u32, number(std.process.argument(arguments, index)))
        } else if named(argument, "--quality") && index + 1 < count {
            index += 1
            options.quality = @intCast(u32, number(std.process.argument(arguments, index)))
        } else if named(argument, "--audio") && index + 1 < count {
            index += 1
            const tracks = std.string.asSlice(std.process.argument(arguments, index))
            options.desktop = contains(tracks, "desktop") || std.text.same(tracks, "both")
            options.microphone = contains(tracks, "microphone") || contains(tracks, "mic") || std.text.same(tracks, "both")
        } else if named(argument, "--mix") {
            options.mix = true
        } else if named(argument, "--desktop") && index + 1 < count {
            index += 1
            options.desktopSource = std.string.asSlice(std.process.argument(arguments, index))
        } else if named(argument, "--frames") && index + 1 < count {
            index += 1
            const text = std.process.argument(arguments, index)
            frames = 0
            var at: usize = 0
            while at < text.length {
                frames = frames * 10 + @intCast(usize, text.pointer[at] - 48)
                at += 1
            }
            if frames == 0 { frames = 1 }
        } else {
            file = argument
        }
        index += 1
    }
    if !list && file.length == 0 {
        const said = std.io.writeAll(std.io.stderr(), "usage: mlx-capture [--window NAME] [--frames N] FILE.png | --list | --record FILE.mkv [--window NAME] [--duration S] [--fps N] [--quality Q] [--audio desktop,microphone|none] [--mix] [--desktop monitor:SINK]")
        return fail("", Failure.Usage)
    }
    if record {
        options.window = std.string.asSlice(window_name)
        try recording.record(capture, file, &options)
        return
    }
    try run(capture, file, window_name, frames, list)
}
