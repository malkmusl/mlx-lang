# The ScreenCast portal (mlx-capture --portal), started by mlx-ipcd
# (MLXIPC) when an app first asks to share the screen. It lives in
# PREFIX/share/mlx/dbus-1/services, which MLXIPC searches before the
# system's directories (mlx-session passes --services): in the MLX session
# mlx-capture answers org.freedesktop.portal.Desktop, not
# xdg-desktop-portal, and streams over its own PipeWire connections.
[D-BUS Service]
Name=org.freedesktop.portal.Desktop
Exec=@BINDIR@/mlx-capture --portal
