// mlx-capture --share: what a browser does to share the screen, through
// the ScreenCast portal on the session bus (portal.mlx, or any other):
// CreateSession, SelectSources, Start (the picker asks), OpenPipeWireRemote;
// then it runs a command with the PipeWire connection as descriptor 3 and
// the stream's node id in PIPEWIRE_NODE (and for "%n" in its arguments),
// and closes the session when the command ends. For tests, and to watch
// a share with any PipeWire program:
//
//   mlx-capture --share [--windows] -- gst-launch-1.0 pipewiresrc fd=3 path=%n ! ...
//
// --windows asks for a window instead of the screen.
const std = @import("std")
const dbus = @import("std.dbus")

const PORTAL: []const u8 = "org.freedesktop.portal.Desktop"
const PATH: []const u8 = "/org/freedesktop/portal/desktop"
const SCREEN_CAST: []const u8 = "org.freedesktop.portal.ScreenCast"
const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"

const SYS_close: usize = 3
const SYS_dup2: usize = 33
const SYS_fork: usize = 57
const SYS_execve: usize = 59
const SYS_exit_group: usize = 231
const SYS_wait4: usize = 61

const Failure = error { Usage, NoMemory, NoBus, NoPortal, Refused, Failed }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    const said = std.io.eprintln(message)
    return failure
}

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn copyInto(target: [*]u8, capacity: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && index < capacity {
        target[index] = text[index]
        index += 1
    }
    return index
}

fn advance(bytes: [*]u8, count: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(bytes) + count) }
}

fn decimal(out: [*]u8, value: usize) -> usize {
    var reversed: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        reversed[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var index: usize = 0
    while index < count {
        out[index] = reversed[count - 1 - index]
        index += 1
    }
    return count
}

// An option {sv}: a string, or a u32.
fn optionString(writing: *dbus.Writer, key: []const u8, value: []const u8) -> void {
    dbus.pad(writing, 8)
    dbus.putString(writing, key)
    dbus.putVariantString(writing, value)
}

fn optionU32(writing: *dbus.Writer, key: []const u8, value: u32) -> void {
    dbus.pad(writing, 8)
    dbus.putString(writing, key)
    dbus.putVariantU32(writing, value)
}

const Share = struct {
    client: *dbus.Client
    body: [*]u8
    // The last Response: its code and its results (copied).
    code: u32
    results: [4096]u8
    resultsLength: usize
    big: bool
}

// Calls `member` and waits for its request's Response; false when the
// portal failed to answer.
fn request(share: *Share, member: []const u8, signature: []const u8, writing: *dbus.Writer) -> bool {
    const serial = dbus.call(share.*.client, PORTAL, PATH, SCREEN_CAST, member, signature, writing.*.bytes, writing.*.length)
    var reply: dbus.Header = undefined
    if serial == 0 || !dbus.waitReply(share.*.client, serial, &reply, 25000) { return false }
    if reply.kind == dbus.ERROR {
        const said = std.io.eprintln(reply.errorName)
        return false
    }
    var reading = dbus.reader(dbus.bodyOf(share.*.client, &reply), reply.bodyLength, reply.big)
    var handle: [256]u8 = undefined
    var handle_bytes: [*]u8 = undefined
    unsafe { handle_bytes = @ptrCast([*]u8, &handle) }
    const handle_length = copyInto(handle_bytes, 256, dbus.readString(&reading))
    // The Response (the user may take a while: the picker waits two
    // minutes).
    var message: dbus.Header = undefined
    while dbus.next(share.*.client, &message, 150000) {
        if message.kind == dbus.SIGNAL && same(message.member, "Response") && same(message.path, handle_bytes[0..handle_length]) {
            var response = dbus.reader(dbus.bodyOf(share.*.client, &message), message.bodyLength, message.big)
            share.*.code = dbus.readU32(&response)
            // The whole body (the code, then the results), so the
            // results keep their alignment.
            var results: [*]u8 = undefined
            unsafe { results = @ptrCast([*]u8, &share.*.results) }
            var bytes: [*]const u8 = dbus.bodyOf(share.*.client, &message)
            share.*.resultsLength = 0
            if message.bodyLength <= 4096 {
                var index: usize = 0
                while index < message.bodyLength {
                    results[index] = bytes[index]
                    index += 1
                }
                share.*.resultsLength = message.bodyLength
            }
            share.*.big = message.big
            return true
        }
    }
    return false
}

// The results' value for `key` (a{sv}): a reader at the value, its
// signature in `signature`; false when it has none.
fn result(share: *Share, key: []const u8, reading: *dbus.Reader, signature: *[]const u8) -> bool {
    var results: [*]const u8 = undefined
    unsafe { results = @ptrCast([*]const u8, &share.*.results) }
    reading.* = dbus.reader(results, share.*.resultsLength, share.*.big)
    const code = dbus.readU32(reading)
    const length = @intCast(usize, dbus.readU32(reading))
    dbus.alignTo(reading, 8)
    const end = reading.*.position + length
    while !reading.*.failed && reading.*.position < end {
        dbus.alignTo(reading, 8)
        const name = dbus.readString(reading)
        const kind = dbus.readSignature(reading)
        if reading.*.failed || kind.length == 0 { return false }
        if same(name, key) {
            signature.* = kind
            return true
        }
        if !dbus.skipValue(reading, kind, 0, 0) { return false }
    }
    return false
}

pub fn run(arguments: [][*]const u8) -> !void {
    const count = std.process.count(arguments)
    var types: u32 = 1
    var index: usize = 2
    var command: usize = 0
    while index < count {
        const argument = std.process.argument(arguments, index)
        if named(argument, "--windows") {
            types = 2
        } else if named(argument, "--") {
            command = index + 1
            break
        } else {
            return fail("usage: mlx-capture --share [--windows] -- COMMAND [ARGUMENTS] (%n: the node id; descriptor 3: the PipeWire connection)", Failure.Usage)
        }
        index += 1
    }
    if command == 0 || command >= count { return fail("usage: mlx-capture --share [--windows] -- COMMAND [ARGUMENTS]", Failure.Usage) }
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Share), 16)
    const client_memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    const body = allocator.alloc(4096, 16)
    if memory == null || client_memory == null || body == null { return fail("mlx-capture: no memory", Failure.NoMemory) }
    var share: *Share = undefined
    unsafe { share = @ptrCast(*Share, memory.?) }
    unsafe { share.*.client = @ptrCast(*dbus.Client, client_memory.?) }
    share.*.body = body.?
    const environment = std.process.environmentEntries(arguments)
    if !dbus.connectSession(share.*.client, allocator, environment) { return fail("mlx-capture: no session bus (DBUS_SESSION_BUS_ADDRESS)", Failure.NoBus) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, share.*.body, 4096, false)
    dbus.putString(&writing, "type='signal',interface='org.freedesktop.portal.Request',member='Response'")
    const matched = dbus.call(share.*.client, BUS, BUS_PATH, BUS, "AddMatch", "s", writing.bytes, writing.length)
    // CreateSession.
    dbus.begin(&writing, share.*.body, 4096, false)
    var at = dbus.beginArray(&writing, 8)
    optionString(&writing, "handle_token", "mlxshare1")
    optionString(&writing, "session_handle_token", "mlxshare")
    dbus.endArray(&writing, at, 8)
    if !request(share, "CreateSession", "a{sv}", &writing) || share.*.code != 0 { return fail("mlx-capture: the portal made no session", Failure.NoPortal) }
    var reading: dbus.Reader = undefined
    var signature: []const u8 = ""
    if !result(share, "session_handle", &reading, &signature) { return fail("mlx-capture: the portal named no session", Failure.NoPortal) }
    var session: [256]u8 = undefined
    var session_bytes: [*]u8 = undefined
    unsafe { session_bytes = @ptrCast([*]u8, &session) }
    const session_length = copyInto(session_bytes, 256, dbus.readString(&reading))
    const session_path = session_bytes[0..session_length]
    // SelectSources.
    dbus.begin(&writing, share.*.body, 4096, false)
    dbus.putString(&writing, session_path)
    at = dbus.beginArray(&writing, 8)
    optionString(&writing, "handle_token", "mlxshare2")
    optionU32(&writing, "types", types)
    optionU32(&writing, "cursor_mode", 2)
    dbus.endArray(&writing, at, 8)
    if !request(share, "SelectSources", "oa{sv}", &writing) || share.*.code != 0 { return fail("mlx-capture: the portal took no sources", Failure.Failed) }
    // Start: the picker.
    dbus.begin(&writing, share.*.body, 4096, false)
    dbus.putString(&writing, session_path)
    dbus.putString(&writing, "")
    at = dbus.beginArray(&writing, 8)
    optionString(&writing, "handle_token", "mlxshare3")
    dbus.endArray(&writing, at, 8)
    if !request(share, "Start", "osa{sv}", &writing) { return fail("mlx-capture: the portal did not start", Failure.Failed) }
    if share.*.code == 1 { return fail("mlx-capture: nothing is shared (the user said no)", Failure.Refused) }
    if share.*.code != 0 || !result(share, "streams", &reading, &signature) { return fail("mlx-capture: the portal shares no stream", Failure.Failed) }
    // a(ua{sv}): the first stream's node.
    const streams = dbus.readU32(&reading)
    dbus.alignTo(&reading, 8)
    const node = dbus.readU32(&reading)
    if reading.failed || streams == 0 { return fail("mlx-capture: the portal shares no stream", Failure.Failed) }
    say("node ")
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    const digit_count = decimal(digit_bytes, @intCast(usize, node))
    say(digit_bytes[0..digit_count])
    say("\n")
    // OpenPipeWireRemote.
    dbus.begin(&writing, share.*.body, 4096, false)
    dbus.putString(&writing, session_path)
    at = dbus.beginArray(&writing, 8)
    dbus.endArray(&writing, at, 8)
    const serial = dbus.call(share.*.client, PORTAL, PATH, SCREEN_CAST, "OpenPipeWireRemote", "oa{sv}", writing.bytes, writing.length)
    var reply: dbus.Header = undefined
    if serial == 0 || !dbus.waitReply(share.*.client, serial, &reply, 25000) || reply.kind == dbus.ERROR || reply.unixFds == 0 { return fail("mlx-capture: the portal gave no PipeWire connection", Failure.Failed) }
    const remote = dbus.descriptorOf(share.*.client, 0)
    // The command: %n is the node, descriptor 3 the connection.
    var text: [4096]u8 = undefined
    var text_bytes: [*]u8 = undefined
    unsafe { text_bytes = @ptrCast([*]u8, &text) }
    var used: usize = 0
    var argv: [64][*]const u8 = undefined
    var argc: usize = 0
    index = command
    while index < count && argc < 62 {
        const argument = std.string.asSlice(std.process.argument(arguments, index))
        argv[argc] = advance(text_bytes, used)
        argc += 1
        var at_byte: usize = 0
        while at_byte < argument.length && used < 4000 {
            if argument[at_byte] == 37 && at_byte + 1 < argument.length && argument[at_byte + 1] == 110 {
                used += copyInto(advance(text_bytes, used), 24, digit_bytes[0..digit_count])
                at_byte += 2
            } else {
                text_bytes[used] = argument[at_byte]
                used += 1
                at_byte += 1
            }
        }
        text_bytes[used] = 0
        used += 1
        index += 1
    }
    unsafe { argv[argc] = @ptrFromInt([*]const u8, 0) }
    var entries: [512][*]const u8 = undefined
    var entry_count: usize = 0
    while @intFromPtr(environment[entry_count]) != 0 && entry_count < 500 {
        entries[entry_count] = environment[entry_count]
        entry_count += 1
    }
    var node_entry: [48]u8 = undefined
    var node_bytes: [*]u8 = undefined
    unsafe { node_bytes = @ptrCast([*]u8, &node_entry) }
    var node_length = copyInto(node_bytes, 16, "PIPEWIRE_NODE=")
    node_length += copyInto(advance(node_bytes, node_length), 24, digit_bytes[0..digit_count])
    node_bytes[node_length] = 0
    entries[entry_count] = node_bytes
    entry_count += 1
    unsafe { entries[entry_count] = @ptrFromInt([*]const u8, 0) }
    var program: [512]u8 = undefined
    var program_bytes: [*]u8 = undefined
    unsafe { program_bytes = @ptrCast([*]u8, &program) }
    const program_length = findProgram(environment, std.string.asSlice(std.process.argument(arguments, command)), program_bytes)
    if program_length == 0 { return fail("mlx-capture: no such command", Failure.Usage) }
    var argv_pointer: [*][*]const u8 = undefined
    unsafe { argv_pointer = @ptrCast([*][*]const u8, &argv) }
    var entries_pointer: [*][*]const u8 = undefined
    unsafe { entries_pointer = @ptrCast([*][*]const u8, &entries) }
    const child = std.linux.syscall0(SYS_fork)
    if child == 0 {
        // The bus's socket goes first: it may be descriptor 3.
        dbus.closeDescriptor(dbus.descriptorOfClient(share.*.client))
        if remote == 3 {
            // F_SETFD: kept across exec.
            const kept = std.linux.syscall3(72, 3, 2, 0)
        } else {
            const duplicated = std.linux.syscall2(SYS_dup2, @bitCast(usize, remote), 3)
        }
        const ignored = std.linux.syscall3(SYS_execve, @intFromPtr(program_bytes), @intFromPtr(argv_pointer), @intFromPtr(entries_pointer))
        const exited = std.linux.syscall1(SYS_exit_group, 127)
    }
    dbus.closeDescriptor(remote)
    var status: i32 = 0
    if child > 0 { const reaped = std.linux.syscall4(SYS_wait4, @bitCast(usize, child), @intFromPtr(&status), 0, 0) }
    // Session.Close.
    const closed = dbus.call(share.*.client, PORTAL, session_path, "org.freedesktop.portal.Session", "Close", "", share.*.body, 0)
    var closing: dbus.Header = undefined
    const answered = dbus.waitReply(share.*.client, closed, &closing, 5000)
    if child < 0 || (status & 127) != 0 || ((status >> 8) & 255) != 0 { return fail("mlx-capture: the command failed", Failure.Failed) }
}

// The command's path: as given when it has a slash, else the first
// directory of PATH that has it. Its length (0: none).
fn findProgram(environment: [*][*]const u8, name: []const u8, out: [*]u8) -> usize {
    var index: usize = 0
    while index < name.length {
        if name[index] == 47 {
            const length = copyInto(out, 500, name)
            out[length] = 0
            return length
        }
        index += 1
    }
    const path = std.process.environmentFrom(environment, "PATH")
    if path == null { return 0 }
    const directories = std.string.asSlice(path.?)
    var start: usize = 0
    while start < directories.length {
        var end = start
        while end < directories.length && directories[end] != 58 { end += 1 }
        var length = copyInto(out, 400, directories[start..end])
        out[length] = 47
        length += 1
        length += copyInto(advance(out, length), 100, name)
        out[length] = 0
        // X_OK.
        if std.linux.syscall2(21, @intFromPtr(out), 1) == 0 { return length }
        start = end + 1
    }
    return 0
}
