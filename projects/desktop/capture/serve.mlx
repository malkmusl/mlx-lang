// mlx-capture --portal: the screen-sharing service. It owns
// org.freedesktop.portal.Desktop on the session bus (MLXIPC starts it from
// its service file when an app first asks), answers Settings with the
// desktop's look (appearance.mlx) and ScreenCast (portal.mlx), asks the
// user what to share (picker.mlx), captures it
// (sources.mlx) and streams it over the PipeWire connections it hands out
// (pipewire.mlx, stream.mlx). One event loop: the bus, each picker's
// pipe, each PipeWire connection and stream, each source's compositor
// connection and pacing timer.
//
//   mlx-capture --portal [--choose screen|deny|window:NAME] [--verbose]
//
// --choose answers every Start without a picker (for tests).
const std = @import("std")
const dbus = @import("std.dbus")
const turns_module = @import("std.turns")
const service = @import("./service.mlx")
const portal = @import("./portal.mlx")
const pipewire = @import("./pipewire.mlx")
const stream = @import("./stream.mlx")
const sources = @import("./sources.mlx")

const Failure = error { Usage, NoMemory, NoBus, Taken, NoLoop }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    _ = std.io.eprintln(message)
    return failure
}

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn serve(server: *service.Server, signals: isize) -> void {
    var events: std.linux.event.Events = undefined
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    while server.*.running {
        turns_module.turn(&turns)
        const timeout: isize = if stream.starting(server) { 100 } else { -1 }
        const count = std.linux.event.waitEvents(server.*.eventLoop, &events, timeout)
        var index: usize = 0
        while count > 0 && index < @intCast(usize, count) {
            const token = std.linux.event.eventToken(&events, index)
            const flags = std.linux.event.eventFlags(&events, index)
            if token == service.TOKEN_BUS {
                portal.busReadable(server)
            } else if token == service.TOKEN_SIGNALS {
                while std.linux.event.readSignal(signals) != 0 { server.*.running = false }
            } else if token >= service.TOKEN_PICKER && token < service.TOKEN_PICKER + service.MAX_PICKERS {
                portal.pickerReadable(server, token - service.TOKEN_PICKER)
            } else if token >= service.TOKEN_PEER && token < service.TOKEN_PEER + service.MAX_PEERS {
                const slot = token - service.TOKEN_PEER
                if service.peerAt(server, slot).*.used && flags & (std.linux.event.EPOLLIN | std.linux.event.EPOLLHUP | std.linux.event.EPOLLERR) != 0 { pipewire.readable(server, slot) }
            } else if token >= service.TOKEN_DONE && token < service.TOKEN_DONE + service.MAX_CONSUMERS {
                stream.finished(server, token - service.TOKEN_DONE)
            } else if token >= service.TOKEN_SOURCE && token < service.TOKEN_SOURCE + service.MAX_SOURCES {
                sources.readable(server, token - service.TOKEN_SOURCE)
            } else if token >= service.TOKEN_TIMER && token < service.TOKEN_TIMER + service.MAX_SOURCES {
                sources.timerFired(server, token - service.TOKEN_TIMER)
            }
            index += 1
        }
        sources.pump(server)
        portal.pump(server)
        pipewire.flushAll(server)
    }
}

pub fn run(arguments: [][*]const u8) -> !void {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(service.Server), 16)
    const bus_memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    const message = allocator.alloc(pipewire.MESSAGE, 16)
    const body = allocator.alloc(16384, 16)
    if memory == null || bus_memory == null || message == null || body == null { return fail("mlx-capture: out of memory", Failure.NoMemory) }
    var server: *service.Server = unsafe { @ptrCast(*service.Server, memory.?) }
    unsafe { server.*.bus = @ptrCast(*dbus.Client, bus_memory.?) }
    server.*.allocator = allocator
    server.*.environment = std.process.environmentEntries(arguments)
    server.*.message = message.?
    server.*.body = body.?
    server.*.running = true
    server.*.verbose = false
    server.*.choose = service.PICK_ASK
    server.*.chooseWindowLength = 0
    server.*.nextId = 40
    server.*.requests = 0
    var slot: usize = 0
    while slot < service.MAX_SESSIONS {
        service.sessionAt(server, slot).*.used = false
        slot += 1
    }
    slot = 0
    while slot < service.MAX_SOURCES {
        service.sourceAt(server, slot).*.used = false
        slot += 1
    }
    slot = 0
    while slot < service.MAX_PEERS {
        service.peerAt(server, slot).*.used = false
        slot += 1
    }
    slot = 0
    while slot < service.MAX_CONSUMERS {
        service.consumerAt(server, slot).*.used = false
        slot += 1
    }
    slot = 0
    while slot < service.MAX_PICKERS {
        service.pickerAt(server, slot).*.used = false
        slot += 1
    }
    var index: usize = 2
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if named(argument, "--verbose") {
            server.*.verbose = true
        } else if named(argument, "--choose") && index + 1 < count {
            index += 1
            const given = std.string.asSlice(std.process.argument(arguments, index))
            if std.text.same(given, "screen") {
                server.*.choose = service.PICK_SCREEN
            } else if std.text.same(given, "deny") {
                server.*.choose = service.PICK_DENY
            } else if given.length > 7 && std.text.same(given[0..7], "window:") {
                server.*.choose = service.PICK_WINDOW
                const bytes: [*]u8 = &server.*.chooseWindow
                server.*.chooseWindowLength = std.text.append(bytes, 0, 64, given[7..given.length])
            } else {
                try fail("mlx-capture: --choose takes screen, deny or window:NAME", Failure.Usage)
            }
        } else {
            try fail("usage: mlx-capture --portal [--choose screen|deny|window:NAME] [--verbose]", Failure.Usage)
        }
        index += 1
    }

    // INT and TERM end it.
    const signals = std.linux.event.signalDescriptor(std.linux.process.signalBit(std.linux.SIGINT) | std.linux.process.signalBit(std.linux.SIGTERM))
    server.*.eventLoop = std.linux.event.createEventLoop()
    if server.*.eventLoop < 0 || signals < 0 { try fail("mlx-capture: no event loop", Failure.NoLoop) }
    if !dbus.connectSession(server.*.bus, allocator, server.*.environment) { try fail("mlx-capture: no session bus (DBUS_SESSION_BUS_ADDRESS)", Failure.NoBus) }
    if !portal.takeName(server) { try fail("mlx-capture: another portal has org.freedesktop.portal.Desktop", Failure.Taken) }
    _ = std.linux.event.watch(server.*.eventLoop, dbus.descriptorOfClient(server.*.bus), service.TOKEN_BUS, false)
    _ = std.linux.event.watch(server.*.eventLoop, signals, service.TOKEN_SIGNALS, false)
    service.say(server, "capture: the ScreenCast portal, as ")
    service.say(server, dbus.uniqueName(server.*.bus))
    service.say(server, "\n")
    // Anything that came with the name.
    portal.busReadable(server)

    serve(server, signals)

    slot = 0
    while slot < service.MAX_SESSIONS {
        portal.closeSession(server, slot, true)
        slot += 1
    }
    service.say(server, "capture: the portal ended\n")
}
