// The streams: an app's client node (its pw_stream, an input) taking a
// shared screen's or window's frames. The service is the graph's driver:
// for each frame it fills a buffer the client gave back, puts its id in
// the port's io area (HAVE_DATA), marks the client's activation
// triggered and writes its wake-up counter; the client takes the buffer,
// hands back one it is done with (NEED_DATA and its id) and, finished,
// counts the driver's activation down to 0 and writes the driver's
// counter, which the service reads (finished).
//
// What a link takes, in the order PipeWire sends it (each memory a memfd
// of its own, told with Core.AddMem):
//
//   create:   the client's activation, BoundProps, Transport (its wake-up
//             counter), SetIO Clock and Position (its own activation)
//   link:     PortSetMixInfo, PortSetParam Format (BGRx, the source's size)
//   then, at the client's next PortUpdate (its Buffers and Meta params):
//             the buffers, PortUseBuffers, the driver's activation,
//             SetIO Position (the driver's), SetActivation (the driver,
//             its counter), the io area, PortSetIO Buffers, Command Start
//
// The activation records (struct pw_node_activation, 2312 bytes) have
// been the same from PipeWire 0.3 to 1.4; the driver's says version 0,
// so a newer client counts it down the way older ones did.
const std = @import("std")
const dbus = @import("std.dbus")
const service = @import("./service.mlx")
const pod = @import("./pod.mlx")
const pipewire = @import("./pipewire.mlx")

const Server = service.Server
const Consumer = service.Consumer

// Client node methods.
const NODE_UPDATE: u32 = 2
const NODE_PORT_UPDATE: u32 = 3
const NODE_SET_ACTIVE: u32 = 4
// Client node events.
const NODE_TRANSPORT: u32 = 0
const NODE_SET_IO: u32 = 2
const NODE_COMMAND: u32 = 4
const NODE_PORT_SET_PARAM: u32 = 7
const NODE_PORT_USE_BUFFERS: u32 = 8
const NODE_PORT_SET_IO: u32 = 9
const NODE_SET_ACTIVATION: u32 = 10
const NODE_PORT_SET_MIX_INFO: u32 = 11
// PW_CLIENT_NODE_PORT_UPDATE_PARAMS.
const PORT_UPDATE_PARAMS: u32 = 1

// SPA ids: io areas, params, objects, commands.
const IO_BUFFERS: u32 = 1
const IO_CLOCK: u32 = 3
const IO_POSITION: u32 = 7
const PARAM_ENUM_FORMAT: u32 = 3
const PARAM_FORMAT: u32 = 4
const PARAM_BUFFERS: u32 = 5
const PARAM_META: u32 = 6
const OBJECT_FORMAT: u32 = 262147
const COMMAND_NODE: u32 = 196610
const COMMAND_START: u32 = 2
// Format keys and values.
const FORMAT_MEDIA_TYPE: u32 = 1
const FORMAT_MEDIA_SUBTYPE: u32 = 2
const FORMAT_VIDEO_FORMAT: u32 = 131073
const FORMAT_VIDEO_SIZE: u32 = 131075
const FORMAT_VIDEO_FRAMERATE: u32 = 131076
const FORMAT_VIDEO_MAX_FRAMERATE: u32 = 131077
const MEDIA_VIDEO: u32 = 2
const SUBTYPE_RAW: u32 = 1
const VIDEO_BGRX: u32 = 8
const VIDEO_BGRA: u32 = 12
// Buffers params: how many, which data types.
const BUFFERS_BUFFERS: u32 = 1
const BUFFERS_DATA_TYPE: u32 = 6
// Meta params and the metas filled here.
const META_TYPE: u32 = 1
const META_SIZE: u32 = 2
const META_HEADER: u32 = 1
const META_VIDEO_CROP: u32 = 2
const META_VIDEO_DAMAGE: u32 = 3
// Data: an offset into the buffer's memory, or a memory of its own.
const DATA_MEM_PTR: u32 = 1
const DATA_MEM_ID: u32 = 4
// SPA_DATA_FLAG_READABLE | SPA_DATA_FLAG_WRITABLE.
const DATA_READ_WRITE: i32 = 3
// io status.
const STATUS_NEED_DATA: u32 = 1
const STATUS_HAVE_DATA: u32 = 2

// struct pw_node_activation: the status, state[0] (status, required,
// pending), when it was signalled, and the position (spa_io_position: the
// clock, the video size, the state, the segments).
const ACTIVATION_SIZE: usize = 2312
const ACTIVATION_MEMORY: usize = 4096
const STATUS: usize = 0
const REQUIRED: usize = 12
const PENDING: usize = 16
const SIGNAL_TIME: usize = 32
const POSITION: usize = 560
const POSITION_SIZE: usize = 1688
const CLOCK_SIZE: usize = 160
const CLOCK_ID: usize = 564
const CLOCK_NAME: usize = 568
const CLOCK_NSEC: usize = 632
const CLOCK_RATE: usize = 640
const CLOCK_POSITION: usize = 648
const CLOCK_DURATION: usize = 656
const CLOCK_RATE_DIFF: usize = 672
const CLOCK_NEXT_NSEC: usize = 680
const CLOCK_TARGET_RATE: usize = 688
const CLOCK_TARGET_DURATION: usize = 696
const VIDEO_FLAGS: usize = 720
const VIDEO_STRIDE: usize = 724
const VIDEO_SIZE: usize = 728
const VIDEO_RATE: usize = 736
const POSITION_STATE: usize = 768
const SEGMENT_COUNT: usize = 772
const SEGMENT_RATE: usize = 800
const TRIGGERED: u32 = 1
const FINISHED: u32 = 3
// SPA_IO_POSITION_STATE_RUNNING.
const RUNNING: u32 = 2
// 1.0 as a double's bits.
const ONE: u64 = 4607182418800017408

// A buffer's chunk: offset, size, stride, flags.
const CHUNK: usize = 16

// A cycle the client never finished is given up after this long; a
// client that never says it listens is taken to after this long.
const STUCK: u64 = 1000000000
const LISTENING: u64 = 300000000

// ---------------------------------------------------------------------------
// Memory

fn put32(address: usize, offset: usize, value: u32) -> void {
    var words: [*]u32 = undefined
    unsafe { words = @ptrFromInt([*]u32, address + offset) }
    words[0] = value
}

fn put64(address: usize, offset: usize, value: u64) -> void {
    put32(address, offset, @intCast(u32, value & 4294967295))
    put32(address, offset + 4, @intCast(u32, value >> 32))
}

fn get32(address: usize, offset: usize) -> u32 {
    var words: [*]const u32 = undefined
    unsafe { words = @ptrFromInt([*]const u32, address + offset) }
    return words[0]
}

fn rounded(size: usize, alignment: usize) -> usize { return (size + alignment - 1) / alignment * alignment }

// Copies `bytes` (a multiple of 4) from `source` to `target`, eight at a
// time.
fn copyPixels(target: usize, source: usize, bytes: usize) -> void {
    var to: [*]u64 = undefined
    var from: [*]const u64 = undefined
    unsafe {
        to = @ptrFromInt([*]u64, target)
        from = @ptrFromInt([*]const u64, source)
    }
    const words = bytes / 8
    var index: usize = 0
    while index + 4 <= words {
        to[index] = from[index]
        to[index + 1] = from[index + 1]
        to[index + 2] = from[index + 2]
        to[index + 3] = from[index + 3]
        index += 4
    }
    while index < words {
        to[index] = from[index]
        index += 1
    }
    if bytes % 8 != 0 { put32(target, words * 8, get32(source, words * 8)) }
}

fn clearBytes(target: usize, bytes: usize) -> void {
    var to: [*]u8 = undefined
    unsafe { to = @ptrFromInt([*]u8, target) }
    var index: usize = 0
    while index < bytes {
        to[index] = 0
        index += 1
    }
}

// A memfd of `size` bytes, mapped: its address (0 when it failed) and
// descriptor.
fn makeMemory(size: usize, descriptor: *isize) -> usize {
    descriptor.* = service.sharedMemory(size)
    if descriptor.* < 0 { return 0 }
    const address = service.map(descriptor.*, size)
    if address == 0 {
        dbus.closeDescriptor(descriptor.*)
        descriptor.* = -1
    }
    return address
}

fn dropMemory(address: usize, descriptor: isize, size: usize) -> void {
    service.unmap(address, size)
    if descriptor >= 0 { dbus.closeDescriptor(descriptor) }
}

// ---------------------------------------------------------------------------
// Streams

// The stream the client of connection `peer` calls `object`, or NO_SLOT.
pub fn find(server: *Server, peer: usize, object: u32) -> usize {
    var slot: usize = 0
    while slot < service.MAX_CONSUMERS {
        const consumer = service.consumerAt(server, slot)
        if consumer.*.used && consumer.*.peer == peer && consumer.*.object == object { return slot }
        slot += 1
    }
    return service.NO_SLOT
}

// The node the stream asked for (target.object, or node.target as the
// portal's apps pass it) in a dictionary of its properties.
fn targetOf(bytes: [*]const u8, dict: pod.Pod) -> u32 {
    var found = false
    var value = pod.dictValue(bytes, dict, "target.object", &found)
    if !found { value = pod.dictValue(bytes, dict, "node.target", &found) }
    if !found { return service.NO_ID }
    return service.number(value)
}

// CreateObject("client-node"): a stream for the client's object `object`;
// false when there is no room.
pub fn create(server: *Server, peer: usize, object: u32, bytes: [*]const u8, props: pod.Pod) -> bool {
    var slot: usize = 0
    while slot < service.MAX_CONSUMERS && service.consumerAt(server, slot).*.used { slot += 1 }
    if slot == service.MAX_CONSUMERS { return false }
    const consumer = service.consumerAt(server, slot)
    consumer.*.peer = peer
    consumer.*.object = object
    consumer.*.nodeId = server.*.nextId
    server.*.nextId += 1
    consumer.*.source = service.NO_SLOT
    consumer.*.target = targetOf(bytes, props)
    consumer.*.state = service.CREATED
    consumer.*.active = false
    consumer.*.hasPort = false
    consumer.*.formats = 0
    consumer.*.format = VIDEO_BGRX
    consumer.*.wantedBuffers = 0
    consumer.*.minBuffers = 1
    consumer.*.maxBuffers = @intCast(u32, service.MAX_BUFFERS)
    consumer.*.memPtr = true
    consumer.*.metaCount = 0
    consumer.*.width = 0
    consumer.*.height = 0
    consumer.*.stride = 0
    consumer.*.activationFd = -1
    consumer.*.driverFd = -1
    consumer.*.ioFd = -1
    consumer.*.buffersFd = -1
    consumer.*.activation = 0
    consumer.*.driver = 0
    consumer.*.io = 0
    consumer.*.buffers = 0
    consumer.*.activationMem = service.NO_ID
    consumer.*.driverMem = service.NO_ID
    consumer.*.ioMem = service.NO_ID
    consumer.*.buffersMem = service.NO_ID
    consumer.*.buffersBytes = 0
    consumer.*.count = 0
    consumer.*.free = 0
    consumer.*.busy = false
    consumer.*.sequence = 0
    consumer.*.wake = service.eventCounter()
    consumer.*.done = service.eventCounter()
    const dummy = service.eventCounter()
    var activation_fd: isize = -1
    consumer.*.activation = makeMemory(ACTIVATION_MEMORY, &activation_fd)
    consumer.*.activationFd = activation_fd
    if consumer.*.wake < 0 || consumer.*.done < 0 || dummy < 0 || consumer.*.activation == 0 {
        if consumer.*.wake >= 0 { dbus.closeDescriptor(consumer.*.wake) }
        if consumer.*.done >= 0 { dbus.closeDescriptor(consumer.*.done) }
        if dummy >= 0 { dbus.closeDescriptor(dummy) }
        if consumer.*.activation != 0 { dropMemory(consumer.*.activation, consumer.*.activationFd, ACTIVATION_MEMORY) }
        return false
    }
    consumer.*.used = true
    // Its activation: its own clock (the client takes its node id from
    // it).
    put32(consumer.*.activation, CLOCK_ID, consumer.*.nodeId)
    put32(consumer.*.activation, STATUS, FINISHED)
    consumer.*.activationMem = pipewire.addMem(server, peer, consumer.*.activationFd)
    pipewire.boundProps(server, peer, object, consumer.*.nodeId)
    // Transport: the counter it waits on (read), and one it would write
    // when it drove a graph itself (never here).
    var writing: pod.Writer = undefined
    var top = pipewire.begin(server, &writing)
    pod.putFd(&writing, 0)
    pod.putFd(&writing, 1)
    pod.putUint(&writing, consumer.*.activationMem)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, @intCast(i32, ACTIVATION_SIZE))
    var descriptors: [2]isize = [2]isize{ service.duplicate(consumer.*.wake), dummy }
    var held: [*]const isize = undefined
    unsafe { held = @ptrCast([*]const isize, &descriptors) }
    pipewire.send(server, peer, object, NODE_TRANSPORT, &writing, top, held, 2)
    setIo(server, slot, IO_CLOCK, consumer.*.activationMem, POSITION, CLOCK_SIZE)
    setIo(server, slot, IO_POSITION, consumer.*.activationMem, POSITION, POSITION_SIZE)
    const watched = dbus.watch(server.*.eventLoop, consumer.*.done, service.TOKEN_DONE + slot, false)
    service.say(server, "capture: a stream (node ")
    service.sayNumber(server, @intCast(usize, consumer.*.nodeId))
    service.say(server, ")\n")
    return true
}

fn plain() -> [*]const isize {
    var none: [1]isize = [1]isize{ 0 }
    unsafe { return @ptrCast([*]const isize, &none) }
}

fn setIo(server: *Server, slot: usize, id: u32, memory: u32, offset: usize, size: usize) -> void {
    const consumer = service.consumerAt(server, slot)
    var writing: pod.Writer = undefined
    const top = pipewire.begin(server, &writing)
    pod.putId(&writing, id)
    pod.putUint(&writing, memory)
    pod.putInt(&writing, @intCast(i32, offset))
    pod.putInt(&writing, @intCast(i32, size))
    pipewire.send(server, consumer.*.peer, consumer.*.object, NODE_SET_IO, &writing, top, plain(), 0)
}

// Ends the stream; `tell`: the client still listens (its memory is taken
// back; RemoveId is the caller's).
pub fn destroy(server: *Server, slot: usize, tell: bool) -> void {
    const consumer = service.consumerAt(server, slot)
    if !consumer.*.used { return }
    if tell {
        pipewire.removeMem(server, consumer.*.peer, consumer.*.buffersMem)
        pipewire.removeMem(server, consumer.*.peer, consumer.*.ioMem)
        pipewire.removeMem(server, consumer.*.peer, consumer.*.driverMem)
        pipewire.removeMem(server, consumer.*.peer, consumer.*.activationMem)
    }
    const unwatched = dbus.unwatch(server.*.eventLoop, consumer.*.done)
    dbus.closeDescriptor(consumer.*.wake)
    dbus.closeDescriptor(consumer.*.done)
    dropMemory(consumer.*.activation, consumer.*.activationFd, ACTIVATION_MEMORY)
    if consumer.*.driver != 0 { dropMemory(consumer.*.driver, consumer.*.driverFd, ACTIVATION_MEMORY) }
    if consumer.*.io != 0 { dropMemory(consumer.*.io, consumer.*.ioFd, ACTIVATION_MEMORY) }
    if consumer.*.buffers != 0 { dropMemory(consumer.*.buffers, consumer.*.buffersFd, consumer.*.buffersBytes) }
    consumer.*.activation = 0
    consumer.*.driver = 0
    consumer.*.io = 0
    consumer.*.buffers = 0
    consumer.*.used = false
    service.say(server, "capture: a stream ended\n")
}

// A client node's method.
pub fn method(server: *Server, slot: usize, opcode: u32, bytes: [*]const u8, payload: pod.Pod) -> void {
    const consumer = service.consumerAt(server, slot)
    var cursor = pod.children(bytes, payload)
    if opcode == NODE_UPDATE {
        // Its node runs now: its data loop listens.
        if consumer.*.state == service.RUNNING { consumer.*.ready = true }
        // change_mask, the params, then the node's info: max input and
        // output ports, change mask, flags, and its properties.
        const changed = pod.next(&cursor)
        const count = pod.uintOf(bytes, pod.next(&cursor))
        var index: u32 = 0
        while index < count {
            const param = pod.next(&cursor)
            index += 1
        }
        const info = pod.next(&cursor)
        if info.kind == pod.STRUCT {
            var fields = pod.children(bytes, info)
            var skipped: usize = 0
            while skipped < 4 {
                const field = pod.next(&fields)
                skipped += 1
            }
            const target = inlineTarget(bytes, &fields)
            if target != service.NO_ID { consumer.*.target = target }
        }
    } else if opcode == NODE_PORT_UPDATE {
        portUpdate(server, slot, bytes, &cursor)
    } else if opcode == NODE_SET_ACTIVE {
        consumer.*.active = pod.uintOf(bytes, pod.next(&cursor)) != 0
        link(server, slot)
    }
}

// Properties as the node's info carries them: the count, then each key
// and value.
fn inlineTarget(bytes: [*]const u8, cursor: *pod.Cursor) -> u32 {
    const count = pod.uintOf(bytes, pod.next(cursor))
    var target = service.NO_ID
    var index: u32 = 0
    while index < count {
        const key = pod.stringOf(bytes, pod.next(cursor))
        const value = pod.stringOf(bytes, pod.next(cursor))
        if service.same(key, "target.object") || (service.same(key, "node.target") && target == service.NO_ID) { target = service.number(value) }
        index += 1
    }
    return target
}

// PortUpdate(direction, port, change_mask, params..., info): the formats it
// takes, the buffers and metas it wants.
fn portUpdate(server: *Server, slot: usize, bytes: [*]const u8, cursor: *pod.Cursor) -> void {
    const consumer = service.consumerAt(server, slot)
    const direction = pod.uintOf(bytes, pod.next(cursor))
    const port = pod.uintOf(bytes, pod.next(cursor))
    const changed = pod.uintOf(bytes, pod.next(cursor))
    if direction != 0 || port != 0 { return }
    if changed == 0 {
        consumer.*.hasPort = false
        return
    }
    consumer.*.hasPort = true
    if changed & PORT_UPDATE_PARAMS != 0 {
        const count = pod.uintOf(bytes, pod.next(cursor))
        consumer.*.metaCount = 0
        var formats: u32 = 0
        var index: u32 = 0
        while index < count {
            const param = pod.next(cursor)
            const id = pod.objectId(bytes, param)
            if id == PARAM_ENUM_FORMAT {
                formats = formats | formatsOf(bytes, param)
            } else if id == PARAM_META && consumer.*.metaCount < service.MAX_METAS {
                const kind = pod.uintOf(bytes, pod.choiceValue(bytes, pod.property(bytes, param, META_TYPE), 0))
                const size = pod.uintOf(bytes, pod.choiceValue(bytes, pod.property(bytes, param, META_SIZE), 0))
                if kind != 0 && size > 0 && size <= 65536 {
                    consumer.*.metaTypes[consumer.*.metaCount] = kind
                    consumer.*.metaSizes[consumer.*.metaCount] = size
                    consumer.*.metaCount += 1
                }
            } else if id == PARAM_BUFFERS {
                buffersOf(consumer, bytes, param)
            }
            index += 1
        }
        if formats != 0 { consumer.*.formats = formats }
    }
    if consumer.*.state == service.NEGOTIATING {
        start(server, slot)
    } else {
        link(server, slot)
    }
}

// The formats an EnumFormat offers: 1 BGRx, 2 BGRA, 4 another.
fn formatsOf(bytes: [*]const u8, param: pod.Pod) -> u32 {
    if pod.uintOf(bytes, pod.choiceValue(bytes, pod.property(bytes, param, FORMAT_MEDIA_TYPE), 0)) != MEDIA_VIDEO { return 0 }
    const value = pod.property(bytes, param, FORMAT_VIDEO_FORMAT)
    var formats: u32 = 0
    const count = pod.choiceCount(bytes, value)
    var index: usize = 0
    while index < count {
        const format = pod.uintOf(bytes, pod.choiceValue(bytes, value, index))
        if format == VIDEO_BGRX {
            formats = formats | 1
        } else if format == VIDEO_BGRA {
            formats = formats | 2
        } else {
            formats = formats | 4
        }
        index += 1
    }
    return formats
}

// A Buffers param: how many buffers (its default, at least and at most)
// and whether a pointer into the buffer's memory will do (MemPtr).
fn buffersOf(consumer: *Consumer, bytes: [*]const u8, param: pod.Pod) -> void {
    const buffers = pod.property(bytes, param, BUFFERS_BUFFERS)
    if buffers.kind != 0 {
        consumer.*.wantedBuffers = pod.uintOf(bytes, pod.choiceValue(bytes, buffers, 0))
        if pod.choiceOf(bytes, buffers) == pod.CHOICE_RANGE && pod.choiceCount(bytes, buffers) >= 3 {
            consumer.*.minBuffers = pod.uintOf(bytes, pod.choiceValue(bytes, buffers, 1))
            consumer.*.maxBuffers = pod.uintOf(bytes, pod.choiceValue(bytes, buffers, 2))
        }
    }
    const types = pod.property(bytes, param, BUFFERS_DATA_TYPE)
    if types.kind != 0 {
        const mask = pod.uintOf(bytes, pod.choiceValue(bytes, types, 0))
        if mask != 0 { consumer.*.memPtr = mask & (1 << DATA_MEM_PTR) != 0 }
    }
}

// The source the stream takes: the one it named, else its session's
// first; NO_SLOT when its session shares none (yet).
fn sourceFor(server: *Server, consumer: *Consumer) -> usize {
    const session = service.peerAt(server, consumer.*.peer).*.session
    var first = service.NO_SLOT
    var slot: usize = 0
    while slot < service.MAX_SOURCES {
        const source = service.sourceAt(server, slot)
        if source.*.used && source.*.session == session {
            if source.*.nodeId == consumer.*.target { return slot }
            if first == service.NO_SLOT { first = slot }
        }
        slot += 1
    }
    return first
}

// Links the stream to its source once it has a port, is active and the
// source knows its size: the format.
pub fn link(server: *Server, slot: usize) -> void {
    const consumer = service.consumerAt(server, slot)
    if consumer.*.state != service.CREATED || !consumer.*.active || !consumer.*.hasPort { return }
    const found = sourceFor(server, consumer)
    if found == service.NO_SLOT { return }
    const source = service.sourceAt(server, found)
    if source.*.width == 0 || source.*.height == 0 { return }
    consumer.*.source = found
    consumer.*.width = source.*.width
    consumer.*.height = source.*.height
    consumer.*.stride = source.*.width * 4
    consumer.*.format = if consumer.*.formats & 1 == 0 && consumer.*.formats & 2 != 0 { VIDEO_BGRA } else { VIDEO_BGRX }
    var writing: pod.Writer = undefined
    var top = pipewire.begin(server, &writing)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putUint(&writing, source.*.nodeId)
    const dict = pod.beginDict(&writing, 0)
    pod.end(&writing, dict)
    pipewire.send(server, consumer.*.peer, consumer.*.object, NODE_PORT_SET_MIX_INFO, &writing, top, plain(), 0)
    top = pipewire.begin(server, &writing)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putId(&writing, PARAM_FORMAT)
    pod.putInt(&writing, 0)
    const object = pod.beginObject(&writing, OBJECT_FORMAT, PARAM_FORMAT)
    pod.putKey(&writing, FORMAT_MEDIA_TYPE)
    pod.putId(&writing, MEDIA_VIDEO)
    pod.putKey(&writing, FORMAT_MEDIA_SUBTYPE)
    pod.putId(&writing, SUBTYPE_RAW)
    pod.putKey(&writing, FORMAT_VIDEO_FORMAT)
    pod.putId(&writing, consumer.*.format)
    pod.putKey(&writing, FORMAT_VIDEO_SIZE)
    pod.putRectangle(&writing, consumer.*.width, consumer.*.height)
    // Frames come when the screen changed: a variable rate, at most the
    // source's.
    pod.putKey(&writing, FORMAT_VIDEO_FRAMERATE)
    pod.putFraction(&writing, 0, 1)
    pod.putKey(&writing, FORMAT_VIDEO_MAX_FRAMERATE)
    pod.putFraction(&writing, source.*.rate, 1)
    pod.end(&writing, object)
    pipewire.send(server, consumer.*.peer, consumer.*.object, NODE_PORT_SET_PARAM, &writing, top, plain(), 0)
    consumer.*.state = service.NEGOTIATING
    service.say(server, "capture: stream ")
    service.sayNumber(server, @intCast(usize, consumer.*.nodeId))
    service.say(server, " takes ")
    service.sayNumber(server, @intCast(usize, consumer.*.width))
    service.say(server, "x")
    service.sayNumber(server, @intCast(usize, consumer.*.height))
    service.say(server, if consumer.*.format == VIDEO_BGRA { " BGRA\n" } else { " BGRx\n" })
}

// Each source the stream's session shares got its size: links the streams
// waiting for it.
pub fn sourceReady(server: *Server, source: usize) -> void {
    var slot: usize = 0
    while slot < service.MAX_CONSUMERS {
        const consumer = service.consumerAt(server, slot)
        if consumer.*.used && consumer.*.state == service.CREATED { link(server, slot) }
        slot += 1
    }
}

// The buffers (as the client asked), the driver and the io area; then it
// starts.
fn start(server: *Server, slot: usize) -> void {
    const consumer = service.consumerAt(server, slot)
    const peer = consumer.*.peer
    const source = service.sourceAt(server, consumer.*.source)
    var count = consumer.*.wantedBuffers
    if count == 0 { count = 4 }
    if count < consumer.*.minBuffers { count = consumer.*.minBuffers }
    if count > consumer.*.maxBuffers { count = consumer.*.maxBuffers }
    if count < 2 { count = 2 }
    if count > @intCast(u32, service.MAX_BUFFERS) { count = @intCast(u32, service.MAX_BUFFERS) }
    consumer.*.count = count
    // Each buffer: its metas, its chunk, then its pixels.
    var metas: usize = 0
    var index: usize = 0
    while index < consumer.*.metaCount {
        metas += rounded(@intCast(usize, consumer.*.metaSizes[index]), 8)
        index += 1
    }
    // The pixels start on a page of their own: a client mapping its
    // buffer's memfd itself (Firefox) maps from there.
    consumer.*.chunkOffset = metas
    consumer.*.dataOffset = rounded(metas + CHUNK, 4096)
    const pixels = @intCast(usize, consumer.*.stride) * @intCast(usize, consumer.*.height)
    consumer.*.bufferSize = rounded(consumer.*.dataOffset + pixels, 4096)
    consumer.*.buffersBytes = rounded(consumer.*.bufferSize * @intCast(usize, count), 4096)
    var buffers_fd: isize = -1
    consumer.*.buffers = makeMemory(consumer.*.buffersBytes, &buffers_fd)
    consumer.*.buffersFd = buffers_fd
    var driver_fd: isize = -1
    consumer.*.driver = makeMemory(ACTIVATION_MEMORY, &driver_fd)
    consumer.*.driverFd = driver_fd
    var io_fd: isize = -1
    consumer.*.io = makeMemory(ACTIVATION_MEMORY, &io_fd)
    consumer.*.ioFd = io_fd
    if consumer.*.buffers == 0 || consumer.*.driver == 0 || consumer.*.io == 0 {
        service.say(server, "capture: no memory for a stream's buffers\n")
        return
    }
    consumer.*.buffersMem = pipewire.addMem(server, peer, consumer.*.buffersFd)
    useBuffers(server, slot)
    // The driver: its clock is the source's.
    const driver = consumer.*.driver
    put32(driver, STATUS, FINISHED)
    put32(driver, REQUIRED, 1)
    put32(driver, PENDING, 1)
    put32(driver, CLOCK_ID, source.*.nodeId)
    var name: [*]u8 = undefined
    unsafe { name = @ptrFromInt([*]u8, driver + CLOCK_NAME) }
    const named = service.copyInto(name, 63, "mlx-capture")
    put32(driver, CLOCK_RATE, 1)
    put32(driver, CLOCK_RATE + 4, 1000000000)
    put64(driver, CLOCK_DURATION, 1)
    put64(driver, CLOCK_RATE_DIFF, ONE)
    put32(driver, CLOCK_TARGET_RATE, 1)
    put32(driver, CLOCK_TARGET_RATE + 4, 1000000000)
    put64(driver, CLOCK_TARGET_DURATION, 1)
    // SPA_IO_VIDEO_SIZE_VALID.
    put32(driver, VIDEO_FLAGS, 1)
    put32(driver, VIDEO_STRIDE, consumer.*.stride)
    put32(driver, VIDEO_SIZE, consumer.*.width)
    put32(driver, VIDEO_SIZE + 4, consumer.*.height)
    put32(driver, VIDEO_RATE, source.*.rate)
    put32(driver, VIDEO_RATE + 4, 1)
    put32(driver, POSITION_STATE, RUNNING)
    put32(driver, SEGMENT_COUNT, 1)
    put64(driver, SEGMENT_RATE, ONE)
    consumer.*.driverMem = pipewire.addMem(server, peer, consumer.*.driverFd)
    setIo(server, slot, IO_POSITION, consumer.*.driverMem, POSITION, POSITION_SIZE)
    var writing: pod.Writer = undefined
    var top = pipewire.begin(server, &writing)
    pod.putUint(&writing, source.*.nodeId)
    pod.putFd(&writing, 0)
    pod.putUint(&writing, consumer.*.driverMem)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, @intCast(i32, ACTIVATION_SIZE))
    var descriptors: [1]isize = [1]isize{ service.duplicate(consumer.*.done) }
    var held: [*]const isize = undefined
    unsafe { held = @ptrCast([*]const isize, &descriptors) }
    pipewire.send(server, peer, consumer.*.object, NODE_SET_ACTIVATION, &writing, top, held, 1)
    // The port's io area: nothing in it yet.
    put32(consumer.*.io, 0, 0)
    put32(consumer.*.io, 4, service.NO_ID)
    consumer.*.ioMem = pipewire.addMem(server, peer, consumer.*.ioFd)
    top = pipewire.begin(server, &writing)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putId(&writing, IO_BUFFERS)
    pod.putUint(&writing, consumer.*.ioMem)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 8)
    pipewire.send(server, peer, consumer.*.object, NODE_PORT_SET_IO, &writing, top, plain(), 0)
    top = pipewire.begin(server, &writing)
    const command = pod.beginObject(&writing, COMMAND_NODE, COMMAND_START)
    pod.end(&writing, command)
    pipewire.send(server, peer, consumer.*.object, NODE_COMMAND, &writing, top, plain(), 0)
    consumer.*.free = (1 << count) - 1
    consumer.*.busy = false
    consumer.*.ready = false
    consumer.*.startedAt = service.now()
    consumer.*.state = service.RUNNING
    service.say(server, "capture: stream ")
    service.sayNumber(server, @intCast(usize, consumer.*.nodeId))
    service.say(server, " runs with ")
    service.sayNumber(server, @intCast(usize, count))
    service.say(server, " buffers\n")
}

// PortUseBuffers: each buffer's memory (an offset into the buffers'
// memfd), its metas and its one data.
fn useBuffers(server: *Server, slot: usize) -> void {
    const consumer = service.consumerAt(server, slot)
    var writing: pod.Writer = undefined
    const top = pipewire.begin(server, &writing)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putInt(&writing, 0)
    pod.putUint(&writing, consumer.*.count)
    var buffer: u32 = 0
    while buffer < consumer.*.count {
        const offset = @intCast(usize, buffer) * consumer.*.bufferSize
        pod.putUint(&writing, consumer.*.buffersMem)
        pod.putUint(&writing, @intCast(u32, offset))
        pod.putUint(&writing, @intCast(u32, consumer.*.bufferSize))
        pod.putUint(&writing, @intCast(u32, consumer.*.metaCount))
        var meta: usize = 0
        while meta < consumer.*.metaCount {
            pod.putId(&writing, consumer.*.metaTypes[meta])
            pod.putUint(&writing, consumer.*.metaSizes[meta])
            meta += 1
        }
        pod.putInt(&writing, 1)
        const pixels = consumer.*.stride * consumer.*.height
        if consumer.*.memPtr {
            pod.putId(&writing, DATA_MEM_PTR)
            pod.putUint(&writing, @intCast(u32, consumer.*.dataOffset))
            pod.putInt(&writing, DATA_READ_WRITE)
            pod.putInt(&writing, 0)
        } else {
            pod.putId(&writing, DATA_MEM_ID)
            pod.putUint(&writing, consumer.*.buffersMem)
            pod.putInt(&writing, DATA_READ_WRITE)
            pod.putUint(&writing, @intCast(u32, offset + consumer.*.dataOffset))
        }
        pod.putUint(&writing, pixels)
        buffer += 1
    }
    pipewire.send(server, consumer.*.peer, consumer.*.object, NODE_PORT_USE_BUFFERS, &writing, top, plain(), 0)
}

// ---------------------------------------------------------------------------
// Frames

// Where buffer `buffer`'s meta of `kind` is (0: it has none).
fn metaAt(consumer: *Consumer, buffer: u32, kind: u32, size: *u32) -> usize {
    var offset = consumer.*.buffers + @intCast(usize, buffer) * consumer.*.bufferSize
    var index: usize = 0
    while index < consumer.*.metaCount {
        if consumer.*.metaTypes[index] == kind {
            size.* = consumer.*.metaSizes[index]
            return offset
        }
        offset += rounded(@intCast(usize, consumer.*.metaSizes[index]), 8)
        index += 1
    }
    return 0
}

// A frame of `source` (`pixels`: width x height words, 0xAARRGGBB, which
// is BGRA in memory), with what changed: to each of its running streams
// with a buffer free.
pub fn frame(server: *Server, source: usize, pixels: usize, width: u32, height: u32, damage_x: i32, damage_y: i32, damage_width: i32, damage_height: i32, time: u64) -> void {
    const moment = service.now()
    var slot: usize = 0
    while slot < service.MAX_CONSUMERS {
        const consumer = service.consumerAt(server, slot)
        if consumer.*.used && consumer.*.source == source && listening(consumer, moment) {
            if consumer.*.busy && moment - consumer.*.busySince > STUCK { consumer.*.busy = false }
            if !consumer.*.busy && consumer.*.free != 0 { fill(server, slot, pixels, width, height, damage_x, damage_y, damage_width, damage_height, time, moment) }
        }
        slot += 1
    }
}

fn fill(server: *Server, slot: usize, pixels: usize, width: u32, height: u32, damage_x: i32, damage_y: i32, damage_width: i32, damage_height: i32, time: u64, moment: u64) -> void {
    const consumer = service.consumerAt(server, slot)
    var buffer: u32 = 0
    while consumer.*.free & (1 << buffer) == 0 { buffer += 1 }
    const base = consumer.*.buffers + @intCast(usize, buffer) * consumer.*.bufferSize
    const data = base + consumer.*.dataOffset
    // The pixels; a frame of another size (a window resized) is cropped
    // or padded to the stream's.
    const columns = if width < consumer.*.width { width } else { consumer.*.width }
    const rows = if height < consumer.*.height { height } else { consumer.*.height }
    if width == consumer.*.width && height == consumer.*.height {
        copyPixels(data, pixels, @intCast(usize, consumer.*.stride) * @intCast(usize, rows))
    } else {
        clearBytes(data, @intCast(usize, consumer.*.stride) * @intCast(usize, consumer.*.height))
        var row: u32 = 0
        while row < rows {
            copyPixels(data + @intCast(usize, row) * @intCast(usize, consumer.*.stride), pixels + @intCast(usize, row) * @intCast(usize, width) * 4, @intCast(usize, columns) * 4)
            row += 1
        }
    }
    // Its metas: the header (when, which), the crop (what holds the
    // picture) and what changed.
    consumer.*.sequence += 1
    var size: u32 = 0
    const header = metaAt(consumer, buffer, META_HEADER, &size)
    if header != 0 && size >= 32 {
        put32(header, 0, 0)
        put32(header, 4, 0)
        put64(header, 8, if time != 0 { time } else { moment })
        put64(header, 16, 0)
        put64(header, 24, consumer.*.sequence)
    }
    const crop = metaAt(consumer, buffer, META_VIDEO_CROP, &size)
    if crop != 0 && size >= 16 {
        put32(crop, 0, 0)
        put32(crop, 4, 0)
        put32(crop, 8, columns)
        put32(crop, 12, rows)
    }
    const damage = metaAt(consumer, buffer, META_VIDEO_DAMAGE, &size)
    if damage != 0 && size >= 16 {
        var x = damage_x
        var y = damage_y
        var w = damage_width
        var h = damage_height
        if w <= 0 || h <= 0 {
            x = 0
            y = 0
            w = @intCast(i32, columns)
            h = @intCast(i32, rows)
        }
        put32(damage, 0, @bitCast(u32, x))
        put32(damage, 4, @bitCast(u32, y))
        put32(damage, 8, @bitCast(u32, w))
        put32(damage, 12, @bitCast(u32, h))
        // The list ends at an empty region.
        if size >= 32 { clearBytes(damage + 16, 16) }
    }
    const chunk = base + consumer.*.chunkOffset
    put32(chunk, 0, 0)
    put32(chunk, 4, consumer.*.stride * consumer.*.height)
    put32(chunk, 8, consumer.*.stride)
    put32(chunk, 12, 0)
    // The io area says which buffer; the driver waits for one finished
    // client; the client is triggered and woken.
    put32(consumer.*.io, 4, buffer)
    put32(consumer.*.io, 0, STATUS_HAVE_DATA)
    const driver = consumer.*.driver
    put32(driver, PENDING, 1)
    put32(driver, STATUS, TRIGGERED)
    put64(driver, CLOCK_NSEC, moment)
    put64(driver, CLOCK_POSITION, consumer.*.sequence)
    put64(driver, CLOCK_NEXT_NSEC, moment + 1000000000 / @intCast(u64, service.sourceAt(server, consumer.*.source).*.rate))
    put32(consumer.*.activation, STATUS, TRIGGERED)
    put64(consumer.*.activation, SIGNAL_TIME, moment)
    consumer.*.free = consumer.*.free & ~(1 << buffer)
    consumer.*.busy = true
    consumer.*.busySince = moment
    service.signalCounter(consumer.*.wake)
    if consumer.*.sequence <= 3 {
        service.say(server, "capture: frame ")
        service.sayNumber(server, @intCast(usize, consumer.*.sequence))
        service.say(server, " to stream ")
        service.sayNumber(server, @intCast(usize, consumer.*.nodeId))
        service.say(server, " in buffer ")
        service.sayNumber(server, @intCast(usize, buffer))
        service.say(server, "\n")
    }
}

// The client finished a cycle: the buffer it gave back is free again (and
// the one it was given, when it did not take it).
pub fn finished(server: *Server, slot: usize) -> void {
    const consumer = service.consumerAt(server, slot)
    const counted = service.readCounter(consumer.*.done)
    if !consumer.*.used || consumer.*.io == 0 { return }
    consumer.*.busy = false
    put32(consumer.*.driver, STATUS, FINISHED)
    const status = get32(consumer.*.io, 0)
    const buffer = get32(consumer.*.io, 4)
    if consumer.*.sequence <= 3 {
        service.say(server, "capture: stream ")
        service.sayNumber(server, @intCast(usize, consumer.*.nodeId))
        service.say(server, " finished: status ")
        service.sayNumber(server, @intCast(usize, status))
        service.say(server, ", buffer ")
        service.sayNumber(server, @intCast(usize, buffer))
        service.say(server, "\n")
    }
    if buffer < consumer.*.count && (status == STATUS_NEED_DATA || status == STATUS_HAVE_DATA) { consumer.*.free = consumer.*.free | (1 << buffer) }
}

// Whether the stream runs and its client listens.
fn listening(consumer: *Consumer, moment: u64) -> bool {
    if consumer.*.state != service.RUNNING || !consumer.*.active { return false }
    if !consumer.*.ready && moment - consumer.*.startedAt > LISTENING { consumer.*.ready = true }
    return consumer.*.ready
}

// Whether any running stream takes `source`'s frames.
pub fn wanted(server: *Server, source: usize) -> bool {
    const moment = service.now()
    var slot: usize = 0
    while slot < service.MAX_CONSUMERS {
        const consumer = service.consumerAt(server, slot)
        if consumer.*.used && consumer.*.source == source && listening(consumer, moment) { return true }
        slot += 1
    }
    return false
}

// Whether a running stream of `source` has had no frame yet.
pub fn hungry(server: *Server, source: usize) -> bool {
    var slot: usize = 0
    while slot < service.MAX_CONSUMERS {
        const consumer = service.consumerAt(server, slot)
        if consumer.*.used && consumer.*.source == source && listening(consumer, service.now()) && consumer.*.sequence == 0 && !consumer.*.busy { return true }
        slot += 1
    }
    return false
}

// Whether a stream started and its client has not said it listens yet
// (the loop then wakes up on its own to give up waiting).
pub fn starting(server: *Server) -> bool {
    var slot: usize = 0
    while slot < service.MAX_CONSUMERS {
        const consumer = service.consumerAt(server, slot)
        if consumer.*.used && consumer.*.state == service.RUNNING && !consumer.*.ready { return true }
        slot += 1
    }
    return false
}
