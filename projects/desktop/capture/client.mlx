// The capture client mlx-capture and its OBS plugin share: a Wayland
// connection to the compositor with its capture globals
// (ext-image-copy-capture-v1, ext-image-capture-source-v1,
// ext-foreign-toplevel-list-v1), the windows it lists, and one capture
// session into a shared-memory buffer of the size the session asks for.
//
//     var capture: client.Capture = undefined          (memory of the caller's)
//     if !client.open(&capture, path) { ... }          a socket path, "" for the environment's
//     client.start(&capture, name)                     "" the screen, else a window (identifier, app id or title)
//     client.requestFrame(&capture)                    asks for a frame
//     ... dispatch (client.wait: blocking; client.poll: what is there) until
//     capture.ready (capture.pixels(), width x height, damage) or capture.failed
//
// The first frame comes at once; each later one when the source changed.
// Nothing here waits unless asked to (client.wait), so a plugin can poll it
// from its host's thread every frame.
const std = @import("std")
const wl = @import("std.wayland")

pub const MAX_WINDOWS: usize = 64
pub const NAME: usize = 64

// ARGB8888 and XRGB8888 (Capture.formats bits 1, 2).
pub const SHM_ARGB8888: u32 = 0
pub const SHM_XRGB8888: u32 = 1

pub const Window = struct {
    handle: wl.ext_foreign_toplevel_handle_v1.Proxy
    // NUL-terminated (for C hosts) as well as counted.
    identifier: [33]u8
    identifierLength: usize
    appId: [65]u8
    appIdLength: usize
    title: [65]u8
    titleLength: usize
    closed: bool
}

pub const Capture = struct {
    display: wl.client.Display
    connected: bool
    registry: wl.wl_registry.Proxy
    shm: wl.wl_shm.Proxy
    hasShm: bool
    output: wl.wl_output.Proxy
    hasOutput: bool
    outputSources: wl.ext_output_image_capture_source_manager_v1.Proxy
    hasOutputSources: bool
    toplevelSources: wl.ext_foreign_toplevel_image_capture_source_manager_v1.Proxy
    hasToplevelSources: bool
    manager: wl.ext_image_copy_capture_manager_v1.Proxy
    hasManager: bool
    toplevelList: wl.ext_foreign_toplevel_list_v1.Proxy
    hasToplevelList: bool
    windows: [64]Window
    windowCount: usize
    // The session: its constraints (buffer size, formats offered: bits 1
    // ARGB8888, 2 XRGB8888) and whether they are complete; stopped when its
    // source went.
    hasSession: bool
    session: wl.ext_image_copy_capture_session_v1.Proxy
    width: u32
    height: u32
    formats: u32
    constraintsDone: bool
    stopped: bool
    // The buffer frames are copied into (made for width x height).
    hasBuffer: bool
    buffer: wl.wl_buffer.Proxy
    memory: wl.SharedMemory
    bufferWidth: u32
    bufferHeight: u32
    // The frame asked for: capturing until ready or failed (and why: 1 the
    // buffer no longer fits, 2 the source went); its damage, and when it was
    // presented (CLOCK_MONOTONIC nanoseconds).
    hasFrame: bool
    frame: wl.ext_image_copy_capture_frame_v1.Proxy
    capturing: bool
    ready: bool
    failed: bool
    failure: u32
    damageX: i32
    damageY: i32
    damageWidth: i32
    damageHeight: i32
    time: u64
    frames: usize
}

fn captureOf(context: *anyopaque) -> *Capture {
    unsafe { return @ptrCast(*Capture, context) }
}

fn contextOf(capture: *Capture) -> *anyopaque {
    unsafe { return @ptrCast(*anyopaque, capture) }
}

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn ignoreEvent(context: *anyopaque, event: wl.client.Event) -> void {}

fn onRegistry(context: *anyopaque, event: wl.client.Event) -> void {
    const capture = captureOf(context)
    const decoded = wl.wl_registry.decodeEvent(event)
    if @tagOf(decoded) != 0 { return }
    const global = decoded.global
    const registry = capture.*.registry
    if named(global.interface, "wl_shm") {
        capture.*.shm = wl.wl_shm.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_shm, 1))
        capture.*.hasShm = true
    } else if named(global.interface, "wl_output") && !capture.*.hasOutput {
        capture.*.output = wl.wl_output.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_output, 1))
        capture.*.output.setHandler(ignoreEvent, context)
        capture.*.hasOutput = true
    } else if named(global.interface, "ext_output_image_capture_source_manager_v1") {
        capture.*.outputSources = wl.ext_output_image_capture_source_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_output_image_capture_source_manager_v1, 1))
        capture.*.hasOutputSources = true
    } else if named(global.interface, "ext_foreign_toplevel_image_capture_source_manager_v1") {
        capture.*.toplevelSources = wl.ext_foreign_toplevel_image_capture_source_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 1))
        capture.*.hasToplevelSources = true
    } else if named(global.interface, "ext_image_copy_capture_manager_v1") {
        capture.*.manager = wl.ext_image_copy_capture_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_image_copy_capture_manager_v1, 1))
        capture.*.hasManager = true
    } else if named(global.interface, "ext_foreign_toplevel_list_v1") {
        capture.*.toplevelList = wl.ext_foreign_toplevel_list_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_foreign_toplevel_list_v1, 1))
        capture.*.hasToplevelList = true
    }
}

// ---------------------------------------------------------------------------
// Windows

fn copyText(target: [*]u8, text: std.string.String, capacity: usize) -> usize {
    const length = if text.length < capacity { text.length } else { capacity }
    var index: usize = 0
    while index < length {
        target[index] = text.pointer[index]
        index += 1
    }
    target[length] = 0
    return length
}

fn windowOf(capture: *Capture, event: wl.client.Event) -> usize {
    var index: usize = 0
    while index < capture.*.windowCount {
        if capture.*.windows[index].handle.object.id == event.object.id { return index }
        index += 1
    }
    return MAX_WINDOWS
}

fn onHandle(context: *anyopaque, event: wl.client.Event) -> void {
    const capture = captureOf(context)
    const index = windowOf(capture, event)
    if index == MAX_WINDOWS { return }
    const decoded = wl.ext_foreign_toplevel_handle_v1.decodeEvent(event)
    var bytes: [*]u8 = undefined
    if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_CLOSED {
        capture.*.windows[index].closed = true
    } else if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_TITLE {
        unsafe { bytes = @ptrCast([*]u8, &capture.*.windows[index].title) }
        capture.*.windows[index].titleLength = copyText(bytes, decoded.title.title, NAME)
    } else if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_APP_ID {
        unsafe { bytes = @ptrCast([*]u8, &capture.*.windows[index].appId) }
        capture.*.windows[index].appIdLength = copyText(bytes, decoded.app_id.app_id, NAME)
    } else if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_IDENTIFIER {
        unsafe { bytes = @ptrCast([*]u8, &capture.*.windows[index].identifier) }
        capture.*.windows[index].identifierLength = copyText(bytes, decoded.identifier.identifier, 32)
    }
}

fn onList(context: *anyopaque, event: wl.client.Event) -> void {
    const capture = captureOf(context)
    if event.opcode != wl.ext_foreign_toplevel_list_v1.EVENT_TOPLEVEL { return }
    const decoded = wl.ext_foreign_toplevel_list_v1.decodeEvent(event)
    const handle = decoded.toplevel.toplevel
    handle.setHandler(onHandle, context)
    // A closed window's slot is taken again.
    var index: usize = 0
    while index < capture.*.windowCount && !capture.*.windows[index].closed { index += 1 }
    if index == capture.*.windowCount {
        if capture.*.windowCount >= MAX_WINDOWS { return }
        capture.*.windowCount += 1
    } else {
        capture.*.windows[index].handle.destroy()
    }
    capture.*.windows[index].handle = handle
    capture.*.windows[index].identifierLength = 0
    capture.*.windows[index].identifier[0] = 0
    capture.*.windows[index].appIdLength = 0
    capture.*.windows[index].appId[0] = 0
    capture.*.windows[index].titleLength = 0
    capture.*.windows[index].title[0] = 0
    capture.*.windows[index].closed = false
}

pub fn textOf(bytes: [*]const u8, length: usize) -> []const u8 { return bytes[0..length] }

pub fn identifierOf(window: *const Window) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &window.*.identifier) }
    return textOf(bytes, window.*.identifierLength)
}

pub fn appIdOf(window: *const Window) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &window.*.appId) }
    return textOf(bytes, window.*.appIdLength)
}

pub fn titleOf(window: *const Window) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &window.*.title) }
    return textOf(bytes, window.*.titleLength)
}

fn same(text: []const u8, name: []const u8) -> bool {
    if text.length != name.length || text.length == 0 { return false }
    var index: usize = 0
    while index < text.length {
        if text[index] != name[index] { return false }
        index += 1
    }
    return true
}

// The open window named `name` (its identifier, app id or title), or
// MAX_WINDOWS.
pub fn findWindow(capture: *Capture, name: []const u8) -> usize {
    var index: usize = 0
    while index < capture.*.windowCount {
        const window = &capture.*.windows[index]
        if !window.*.closed && (same(identifierOf(window), name) || same(appIdOf(window), name) || same(titleOf(window), name)) { return index }
        index += 1
    }
    return MAX_WINDOWS
}

// ---------------------------------------------------------------------------
// Connecting

fn reset(capture: *Capture) -> void {
    capture.*.connected = false
    capture.*.hasShm = false
    capture.*.hasOutput = false
    capture.*.hasOutputSources = false
    capture.*.hasToplevelSources = false
    capture.*.hasManager = false
    capture.*.hasToplevelList = false
    capture.*.windowCount = 0
    capture.*.hasSession = false
    capture.*.width = 0
    capture.*.height = 0
    capture.*.formats = 0
    capture.*.constraintsDone = false
    capture.*.stopped = false
    capture.*.hasBuffer = false
    capture.*.bufferWidth = 0
    capture.*.bufferHeight = 0
    capture.*.hasFrame = false
    capture.*.capturing = false
    capture.*.ready = false
    capture.*.failed = false
    capture.*.failure = 0
    capture.*.frames = 0
}

// Connects to the compositor (at the socket `path`; "" for the
// environment's: WAYLAND_DISPLAY) and learns its globals and windows. False
// when that failed or it offers no capture.
pub fn open(capture: *Capture, path: []const u8) -> bool {
    reset(capture)
    const allocator = std.page_allocator.init()
    var display: wl.client.Display = undefined
    if !wl.client.Display.open(&display, allocator, path) { return false }
    capture.*.display = display
    capture.*.connected = true
    capture.*.registry = wl.displayProxy(display).getRegistry()
    capture.*.registry.setHandler(onRegistry, contextOf(capture))
    var ok = display.sync()
    if ok && capture.*.hasToplevelList {
        capture.*.toplevelList.setHandler(onList, contextOf(capture))
        // The windows, then their names.
        ok = display.sync() && display.sync()
    }
    if !ok {
        display.disconnect()
        capture.*.connected = false
        return false
    }
    return capture.*.hasShm && capture.*.hasManager
}

pub fn close(capture: *Capture) -> void {
    if !capture.*.connected { return }
    stop(capture)
    capture.*.display.disconnect()
    capture.*.connected = false
}

// Whether the connection still works.
pub fn alive(capture: *Capture) -> bool { return capture.*.connected && capture.*.display.running() }

// Handles what has arrived, without waiting.
pub fn poll(capture: *Capture) -> bool { return capture.*.connected && capture.*.display.poll() }

// Waits for the next event and handles it (and what else has arrived).
pub fn wait(capture: *Capture) -> bool {
    if !capture.*.connected || !capture.*.display.send() { return false }
    if !capture.*.display.poll() { return false }
    const waited = wl.transport.wait(wl.Handle.fromDescriptor(capture.*.display.descriptor()), false, 100)
    return capture.*.display.poll()
}

// The window list again (a roundtrip: what came since).
pub fn refresh(capture: *Capture) -> bool { return capture.*.connected && capture.*.display.sync() }

// ---------------------------------------------------------------------------
// The session and its frames

fn onSession(context: *anyopaque, event: wl.client.Event) -> void {
    const capture = captureOf(context)
    const decoded = wl.ext_image_copy_capture_session_v1.decodeEvent(event)
    if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_BUFFER_SIZE {
        capture.*.width = decoded.buffer_size.width
        capture.*.height = decoded.buffer_size.height
        capture.*.formats = 0
        capture.*.constraintsDone = false
    } else if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_SHM_FORMAT {
        if decoded.shm_format.format == SHM_ARGB8888 { capture.*.formats = capture.*.formats | 1 }
        if decoded.shm_format.format == SHM_XRGB8888 { capture.*.formats = capture.*.formats | 2 }
    } else if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_DONE {
        capture.*.constraintsDone = true
    } else if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_STOPPED {
        capture.*.stopped = true
    }
}

fn onFrame(context: *anyopaque, event: wl.client.Event) -> void {
    const capture = captureOf(context)
    const decoded = wl.ext_image_copy_capture_frame_v1.decodeEvent(event)
    if event.opcode == wl.ext_image_copy_capture_frame_v1.EVENT_DAMAGE {
        capture.*.damageX = decoded.damage.x
        capture.*.damageY = decoded.damage.y
        capture.*.damageWidth = decoded.damage.width
        capture.*.damageHeight = decoded.damage.height
    } else if event.opcode == wl.ext_image_copy_capture_frame_v1.EVENT_PRESENTATION_TIME {
        const seconds = (@intCast(u64, decoded.presentation_time.tv_sec_hi) << 32) | @intCast(u64, decoded.presentation_time.tv_sec_lo)
        capture.*.time = seconds * 1000000000 + @intCast(u64, decoded.presentation_time.tv_nsec)
    } else if event.opcode == wl.ext_image_copy_capture_frame_v1.EVENT_READY {
        capture.*.ready = true
        capture.*.capturing = false
        capture.*.frames += 1
    } else if event.opcode == wl.ext_image_copy_capture_frame_v1.EVENT_FAILED {
        capture.*.failed = true
        capture.*.capturing = false
        capture.*.failure = decoded.failed.reason
    }
}

// Starts a session on the screen (`name` "") or on the window named
// `name`; false when there is no such window or no way to capture it.
pub fn start(capture: *Capture, name: []const u8) -> bool {
    stop(capture)
    capture.*.stopped = false
    capture.*.constraintsDone = false
    capture.*.width = 0
    capture.*.height = 0
    var source: wl.ext_image_capture_source_v1.Proxy = undefined
    if name.length == 0 {
        if !capture.*.hasOutputSources || !capture.*.hasOutput { return false }
        source = capture.*.outputSources.createSource(capture.*.output)
    } else {
        if !capture.*.hasToplevelSources { return false }
        const index = findWindow(capture, name)
        if index == MAX_WINDOWS { return false }
        source = capture.*.toplevelSources.createSource(capture.*.windows[index].handle)
    }
    capture.*.session = capture.*.manager.createSession(source, 0)
    capture.*.session.setHandler(onSession, contextOf(capture))
    // (The session keeps its source.)
    source.destroy()
    capture.*.hasSession = true
    return true
}

fn dropBuffer(capture: *Capture) -> void {
    if !capture.*.hasBuffer { return }
    capture.*.buffer.destroy()
    capture.*.memory.release()
    capture.*.hasBuffer = false
}

// Ends the session (and its frame and buffer).
pub fn stop(capture: *Capture) -> void {
    if capture.*.hasFrame {
        capture.*.frame.destroy()
        capture.*.hasFrame = false
    }
    capture.*.capturing = false
    if capture.*.hasSession {
        capture.*.session.destroy()
        capture.*.hasSession = false
    }
    dropBuffer(capture)
}

// A buffer of the session's size (again when it changed); false when there
// is no size yet or no memory.
fn ensureBuffer(capture: *Capture) -> bool {
    if capture.*.width == 0 || capture.*.height == 0 || capture.*.formats & 3 == 0 { return false }
    if capture.*.hasBuffer && capture.*.bufferWidth == capture.*.width && capture.*.bufferHeight == capture.*.height { return true }
    dropBuffer(capture)
    const size = @intCast(usize, capture.*.width) * @intCast(usize, capture.*.height) * 4
    var memory: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&memory, size) { return false }
    capture.*.memory = memory
    const format = if capture.*.formats & 1 != 0 { SHM_ARGB8888 } else { SHM_XRGB8888 }
    const pool = capture.*.shm.createPool(memory.handle, @intCast(i32, size))
    capture.*.buffer = pool.createBuffer(0, @intCast(i32, capture.*.width), @intCast(i32, capture.*.height), @intCast(i32, capture.*.width * 4), format)
    pool.destroy()
    capture.*.bufferWidth = capture.*.width
    capture.*.bufferHeight = capture.*.height
    capture.*.hasBuffer = true
    return true
}

// Asks for the next frame (once the session's constraints are in); false
// when it cannot yet. capture.ready or capture.failed says how it went.
pub fn requestFrame(capture: *Capture) -> bool {
    if !capture.*.hasSession || capture.*.stopped || !capture.*.constraintsDone || capture.*.capturing { return false }
    if !ensureBuffer(capture) { return false }
    if capture.*.hasFrame { capture.*.frame.destroy() }
    capture.*.ready = false
    capture.*.failed = false
    capture.*.frame = capture.*.session.createFrame()
    capture.*.frame.setHandler(onFrame, contextOf(capture))
    capture.*.frame.attachBuffer(capture.*.buffer)
    capture.*.frame.damageBuffer(0, 0, @intCast(i32, capture.*.width), @intCast(i32, capture.*.height))
    capture.*.frame.capture()
    capture.*.hasFrame = true
    capture.*.capturing = true
    return capture.*.display.send()
}

// The last frame's pixels: premultiplied 0xAARRGGBB words, width per row.
pub fn pixels(capture: *Capture) -> [*]const u32 {
    var words: [*]const u32 = undefined
    unsafe { words = @ptrFromInt([*]const u32, capture.*.memory.address) }
    return words
}
