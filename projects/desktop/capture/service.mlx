// The records of mlx-capture's screen-sharing service (serve.mlx): the
// portal's sessions (portal.mlx), the screens and windows they share
// (sources.mlx), the PipeWire connections apps were handed
// (pipewire.mlx) and the streams on them (stream.mlx). They live here,
// apart from the modules that use them, because those modules import one
// another. Also the few kernel objects they all make: shared memory,
// event counters and timers.
const std = @import("std")
const dbus = @import("std.dbus")
const client = @import("./client.mlx")

pub const MAX_SESSIONS: usize = 8
pub const MAX_SOURCES: usize = 8
pub const MAX_PEERS: usize = 16
pub const MAX_CONSUMERS: usize = 16
pub const MAX_PICKERS: usize = 4
// Buffers a stream has, metas a buffer has.
pub const MAX_BUFFERS: usize = 16
pub const MAX_METAS: usize = 8
// A path, a bus name, an app id.
pub const PATH: usize = 256
pub const NAME: usize = 128

// Event tokens: the bus, the signals, then each picker's pipe, peer's
// socket, stream's "done" counter and source's Wayland connection and
// pacing timer (the slot is added).
pub const TOKEN_BUS: usize = 1
pub const TOKEN_SIGNALS: usize = 2
pub const TOKEN_PICKER: usize = 16
pub const TOKEN_PEER: usize = 256
pub const TOKEN_DONE: usize = 512
pub const TOKEN_SOURCE: usize = 768
pub const TOKEN_TIMER: usize = 1024
pub const TOKEN_END: usize = 1280

// No object, no node, no slot.
pub const NO_ID: u32 = 4294967295
pub const NO_SLOT: usize = 4096

// What the picker answers without asking (--choose, for tests).
pub const PICK_ASK: u8 = 0
pub const PICK_SCREEN: u8 = 1
pub const PICK_WINDOW: u8 = 2
pub const PICK_DENY: u8 = 3

// A portal session (org.freedesktop.portal.ScreenCast's CreateSession):
// whose it is (its connection on the bus, its app), its object path, what
// SelectSources asked for (types: 1 the screen, 2 windows; the cursor
// mode), whether Start was answered, and the sources it shares.
pub const Session = struct {
    used: bool
    owner: [64]u8
    ownerLength: usize
    app: [128]u8
    appLength: usize
    sandboxed: bool
    path: [256]u8
    pathLength: usize
    types: u32
    cursorMode: u32
    selected: bool
    started: bool
    // Start's request (its path) while the picker is open, and then until
    // the sources know their sizes (waiting: the Response is due then).
    request: [256]u8
    requestLength: usize
    picking: bool
    waiting: bool
    picker: usize
    // The bus call asking who the app is (0: none waiting).
    appSerial: u32
    sources: [4]usize
    sourceCount: usize
}

// A screen or window shared: its node (the id apps connect to), its
// session, what it captures (a window's identifier; "" the screen), the
// compositor connection capturing it, the size of its frames, and when
// the next frame may come (frames are paced to `rate` a second).
pub const Source = struct {
    used: bool
    session: usize
    nodeId: u32
    window: [33]u8
    windowLength: usize
    capture: client.Capture
    connected: bool
    timer: isize
    paced: bool
    rate: u32
    width: u32
    height: u32
    lastFrame: u64
    frames: usize
    stopped: bool
}

// A PipeWire connection (the server's end of a portal's
// OpenPipeWireRemote): which session it may see, the client's own ids
// (its registry), the next memory id and message sequence.
pub const Peer = struct {
    used: bool
    connection: dbus.Connection
    descriptor: isize
    dead: bool
    session: usize
    clientId: u32
    registry: u32
    nextMem: u32
    sequence: u32
    hello: bool
    watchingOutput: bool
}

// Where a stream is.
pub const CREATED: u8 = 0
// The format was set; its buffers come with the client's next port update.
pub const NEGOTIATING: u8 = 1
pub const RUNNING: u8 = 2

// A stream: a client's client-node (a pw_stream) taking a source's frames.
// The client's id for it and its global id, the source it takes (NO_SLOT:
// none yet) or asked for (target.object), what its port offered (the
// formats: 1 BGRx, 2 BGRA, 4 anything else; the buffers and metas it
// wants), the format it got, and the memory it shares with the client:
// its activation, the driver's (the service is its driver), its port's
// io and the buffers (each: metas, a chunk, then the pixels).
pub const Consumer = struct {
    used: bool
    peer: usize
    object: u32
    nodeId: u32
    source: usize
    target: u32
    state: u8
    active: bool
    hasPort: bool
    formats: u32
    format: u32
    wantedBuffers: u32
    minBuffers: u32
    maxBuffers: u32
    memPtr: bool
    metaTypes: [8]u32
    metaSizes: [8]u32
    metaCount: usize
    width: u32
    height: u32
    stride: u32
    activationFd: isize
    activation: usize
    activationMem: u32
    driverFd: isize
    driver: usize
    driverMem: u32
    ioFd: isize
    io: usize
    ioMem: u32
    buffersFd: isize
    buffers: usize
    buffersMem: u32
    buffersBytes: usize
    count: u32
    bufferSize: usize
    chunkOffset: usize
    dataOffset: usize
    // Whether the client listens for its wake-ups yet (it says so with
    // its node's update after Start; it clears its counter before that),
    // and when it was started.
    ready: bool
    startedAt: u64
    // Buffers the client gave back (bit per buffer), whether a cycle runs
    // (the client was woken and has not said it finished) and since when.
    free: u32
    busy: bool
    busySince: u64
    // The client's wake-up counter (the service writes it) and the one it
    // writes when it finished (the service reads it).
    wake: isize
    done: isize
    sequence: u64
}

// A picker dialog (picker.mlx) and the session waiting for its answer.
pub const Picker = struct {
    used: bool
    pid: isize
    pipe: isize
    session: usize
    answer: [128]u8
    answerLength: usize
}

pub const Server = struct {
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    eventLoop: isize
    running: bool
    verbose: bool
    bus: *dbus.Client
    // PipeWire messages are built here (pipewire.mlx), the bus's message
    // bodies there (portal.mlx).
    message: [*]u8
    body: [*]u8
    // Request paths made up for calls without a handle_token.
    requests: usize
    choose: u8
    chooseWindow: [64]u8
    chooseWindowLength: usize
    // Global ids for nodes and clients.
    nextId: u32
    sessions: [8]Session
    sources: [8]Source
    peers: [16]Peer
    consumers: [16]Consumer
    pickers: [4]Picker
}

pub fn sessionAt(server: *Server, slot: usize) -> *Session {
    unsafe { return @ptrCast(*Session, &server.*.sessions[slot]) }
}

pub fn sourceAt(server: *Server, slot: usize) -> *Source {
    unsafe { return @ptrCast(*Source, &server.*.sources[slot]) }
}

pub fn peerAt(server: *Server, slot: usize) -> *Peer {
    unsafe { return @ptrCast(*Peer, &server.*.peers[slot]) }
}

pub fn consumerAt(server: *Server, slot: usize) -> *Consumer {
    unsafe { return @ptrCast(*Consumer, &server.*.consumers[slot]) }
}

pub fn pickerAt(server: *Server, slot: usize) -> *Picker {
    unsafe { return @ptrCast(*Picker, &server.*.pickers[slot]) }
}

pub fn captureOf(source: *Source) -> *client.Capture {
    unsafe { return @ptrCast(*client.Capture, &source.*.capture) }
}

pub fn connectionOf(peer: *Peer) -> *dbus.Connection {
    unsafe { return @ptrCast(*dbus.Connection, &peer.*.connection) }
}

pub fn ownerOf(session: *Session) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &session.*.owner) }
    return bytes[0..session.*.ownerLength]
}

pub fn appOf(session: *Session) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &session.*.app) }
    return bytes[0..session.*.appLength]
}

pub fn pathOf(session: *Session) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &session.*.path) }
    return bytes[0..session.*.pathLength]
}

pub fn requestOf(session: *Session) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &session.*.request) }
    return bytes[0..session.*.requestLength]
}

pub fn windowOf(source: *Source) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &source.*.window) }
    return bytes[0..source.*.windowLength]
}

// ---------------------------------------------------------------------------
// Text

pub fn say(server: *Server, text: []const u8) -> void {
    if server.*.verbose { const ignored = std.io.writeAll(std.io.stdout(), text) }
}

pub fn sayNumber(server: *Server, value: usize) -> void {
    if server.*.verbose { const ignored = std.io.writeUnsigned(std.io.stdout(), value) }
}

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

pub fn copyInto(target: [*]u8, capacity: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && index < capacity {
        target[index] = text[index]
        index += 1
    }
    return index
}

pub fn advance(bytes: [*]u8, count: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(bytes) + count) }
}

// `value` in decimal into `out`: how many digits.
pub fn decimal(out: [*]u8, value: usize) -> usize {
    var reversed: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        reversed[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var index: usize = 0
    while index < count {
        out[index] = reversed[count - 1 - index]
        index += 1
    }
    return count
}

// The digits at the start of `text` as a number (NO_ID when there are
// none).
pub fn number(text: []const u8) -> u32 {
    if text.length == 0 || text[0] < 48 || text[0] > 57 { return NO_ID }
    var value: u32 = 0
    var index: usize = 0
    while index < text.length && text[index] >= 48 && text[index] <= 57 {
        value = value * 10 + @intCast(u32, text[index] - 48)
        index += 1
    }
    return value
}

// ---------------------------------------------------------------------------
// Kernel objects

const SYS_mmap: usize = 9
const SYS_munmap: usize = 11
const SYS_fcntl: usize = 72
const SYS_ftruncate: usize = 77
const SYS_clock_gettime: usize = 228
const SYS_timerfd_create: usize = 283
const SYS_timerfd_settime: usize = 286
const SYS_eventfd2: usize = 290
const SYS_memfd_create: usize = 319

// CLOCK_MONOTONIC in nanoseconds.
pub fn now() -> u64 {
    var time: [2]usize = [2]usize{ 0, 0 }
    const result = std.linux.syscall2(SYS_clock_gettime, 1, @intFromPtr(&time))
    return @intCast(u64, time[0]) * 1000000000 + @intCast(u64, time[1])
}

// Shared memory of `size` bytes (MFD_CLOEXEC | MFD_ALLOW_SEALING): the
// descriptor, or a negative errno.
pub fn sharedMemory(size: usize) -> isize {
    var name: usize = 0
    unsafe { name = @intFromPtr(@ptrCast([*]const u8, "mlx-capture")) }
    const descriptor = std.linux.syscall2(SYS_memfd_create, name, 3)
    if descriptor < 0 { return descriptor }
    const truncated = std.linux.syscall2(SYS_ftruncate, @bitCast(usize, descriptor), size)
    if truncated < 0 {
        dbus.closeDescriptor(descriptor)
        return truncated
    }
    return descriptor
}

// Maps `size` bytes of `descriptor`, readable and writable and shared: the
// address, 0 when it failed.
pub fn map(descriptor: isize, size: usize) -> usize {
    // PROT_READ | PROT_WRITE, MAP_SHARED.
    const result = std.linux.syscall6(SYS_mmap, 0, size, 3, 1, @bitCast(usize, descriptor), 0)
    if result < 0 && result > -4096 { return 0 }
    return @bitCast(usize, result)
}

pub fn unmap(address: usize, size: usize) -> void {
    if address == 0 { return }
    const ignored = std.linux.syscall2(SYS_munmap, address, size)
}

// An event counter (EFD_CLOEXEC | EFD_NONBLOCK).
pub fn eventCounter() -> isize { return std.linux.syscall2(SYS_eventfd2, 0, 526336) }

// A copy of `descriptor` (close-on-exec), for a message to own.
pub fn duplicate(descriptor: isize) -> isize { return std.linux.syscall3(SYS_fcntl, @bitCast(usize, descriptor), 1030, 0) }

pub fn signalCounter(descriptor: isize) -> void {
    var one: u64 = 1
    const written = std.linux.syscall3(1, @bitCast(usize, descriptor), @intFromPtr(&one), 8)
}

// Reads the counter (resetting it): how often it was written.
pub fn readCounter(descriptor: isize) -> u64 {
    var value: u64 = 0
    const got = std.linux.syscall3(0, @bitCast(usize, descriptor), @intFromPtr(&value), 8)
    if got != 8 { return 0 }
    return value
}

// A timer (CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC).
pub fn timer() -> isize { return std.linux.syscall2(SYS_timerfd_create, 1, 526336) }

// Arms `descriptor` to fire once in `nanoseconds` (0: disarms it).
pub fn arm(descriptor: isize, nanoseconds: u64) -> void {
    var spec: [4]u64 = [4]u64{ 0, 0, nanoseconds / 1000000000, nanoseconds % 1000000000 }
    const set = std.linux.syscall4(SYS_timerfd_settime, @bitCast(usize, descriptor), 0, @intFromPtr(&spec), 0)
}
