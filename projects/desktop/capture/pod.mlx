// SPA PODs: the values PipeWire's native protocol is made of
// (pipewire.mlx). A pod is its body's size (u32), its type (u32) and its
// body, padded to 8 bytes. A Struct holds pods; an Object its type, its
// id and properties (key u32, flags u32, a pod); a Choice its kind, flags
// and one child type with values of that size packed one after the
// other (the first is the default). Native byte order: little-endian.
//
//     var writing: pod.Writer = undefined
//     pod.begin(&writing, bytes, capacity)
//     const top = pod.beginStruct(&writing)
//     pod.putInt(&writing, 3)
//     pod.end(&writing, top)
//
//     var cursor = pod.children(bytes, pod.podAt(bytes, 0, length))
//     const first = pod.next(&cursor)          kind 0 after the last
pub const NONE: u32 = 1
pub const BOOL: u32 = 2
pub const ID: u32 = 3
pub const INT: u32 = 4
pub const LONG: u32 = 5
pub const FLOAT: u32 = 6
pub const DOUBLE: u32 = 7
pub const STRING: u32 = 8
pub const BYTES: u32 = 9
pub const RECTANGLE: u32 = 10
pub const FRACTION: u32 = 11
pub const BITMAP: u32 = 12
pub const ARRAY: u32 = 13
pub const STRUCT: u32 = 14
pub const OBJECT: u32 = 15
pub const SEQUENCE: u32 = 16
pub const POINTER: u32 = 17
pub const FD: u32 = 18
pub const CHOICE: u32 = 19

// Choices.
pub const CHOICE_NONE: u32 = 0
pub const CHOICE_RANGE: u32 = 1
pub const CHOICE_STEP: u32 = 2
pub const CHOICE_ENUM: u32 = 3
pub const CHOICE_FLAGS: u32 = 4

pub const Writer = struct {
    bytes: [*]u8
    capacity: usize
    length: usize
    failed: bool
}

// A pod in a message: its type (0: none there), its body's size and where
// the body starts.
pub const Pod = struct {
    kind: u32
    size: u32
    body: usize
}

// The pods of a container, one after the other.
pub const Cursor = struct {
    bytes: [*]const u8
    at: usize
    end: usize
}

pub fn store32(bytes: [*]u8, at: usize, value: u32) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 2] = @intCast(u8, (value >> 16) & 255)
    bytes[at + 3] = @intCast(u8, value >> 24)
}

pub fn store64(bytes: [*]u8, at: usize, value: u64) -> void {
    store32(bytes, at, @intCast(u32, value & 4294967295))
    store32(bytes, at + 4, @intCast(u32, value >> 32))
}

pub fn load32(bytes: [*]const u8, at: usize) -> u32 {
    return @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) | (@intCast(u32, bytes[at + 2]) << 16) | (@intCast(u32, bytes[at + 3]) << 24)
}

pub fn load64(bytes: [*]const u8, at: usize) -> u64 {
    return @intCast(u64, load32(bytes, at)) | (@intCast(u64, load32(bytes, at + 4)) << 32)
}

fn rounded(size: usize) -> usize { return (size + 7) / 8 * 8 }

// ---------------------------------------------------------------------------
// Writing

pub fn begin(writing: *Writer, bytes: [*]u8, capacity: usize) -> void {
    writing.*.bytes = bytes
    writing.*.capacity = capacity
    writing.*.length = 0
    writing.*.failed = false
}

fn room(writing: *Writer, count: usize) -> bool {
    if writing.*.length + count > writing.*.capacity {
        writing.*.failed = true
        return false
    }
    return true
}

pub fn putRaw32(writing: *Writer, value: u32) -> void {
    if !room(writing, 4) { return }
    store32(writing.*.bytes, writing.*.length, value)
    writing.*.length += 4
}

pub fn putRaw64(writing: *Writer, value: u64) -> void {
    putRaw32(writing, @intCast(u32, value & 4294967295))
    putRaw32(writing, @intCast(u32, value >> 32))
}

// Zeros up to the next multiple of 8.
fn pad(writing: *Writer) -> void {
    while writing.*.length % 8 != 0 {
        if !room(writing, 1) { return }
        writing.*.bytes[writing.*.length] = 0
        writing.*.length += 1
    }
}

fn header(writing: *Writer, size: u32, kind: u32) -> void {
    putRaw32(writing, size)
    putRaw32(writing, kind)
}

pub fn putNone(writing: *Writer) -> void { header(writing, 0, NONE) }

pub fn putBool(writing: *Writer, value: bool) -> void {
    header(writing, 4, BOOL)
    putRaw32(writing, if value { 1 } else { 0 })
    pad(writing)
}

pub fn putId(writing: *Writer, value: u32) -> void {
    header(writing, 4, ID)
    putRaw32(writing, value)
    pad(writing)
}

pub fn putInt(writing: *Writer, value: i32) -> void {
    header(writing, 4, INT)
    putRaw32(writing, @bitCast(u32, value))
    pad(writing)
}

// A u32 as an Int (ids and counts travel as Ints).
pub fn putUint(writing: *Writer, value: u32) -> void { putInt(writing, @bitCast(i32, value)) }

pub fn putLong(writing: *Writer, value: i64) -> void {
    header(writing, 8, LONG)
    putRaw64(writing, @bitCast(u64, value))
}

// A descriptor: its index among the message's descriptors (-1: none).
pub fn putFd(writing: *Writer, index: i64) -> void {
    header(writing, 8, FD)
    putRaw64(writing, @bitCast(u64, index))
}

pub fn putString(writing: *Writer, text: []const u8) -> void {
    header(writing, @intCast(u32, text.length + 1), STRING)
    if !room(writing, text.length + 1) { return }
    var index: usize = 0
    while index < text.length {
        writing.*.bytes[writing.*.length + index] = text[index]
        index += 1
    }
    writing.*.bytes[writing.*.length + text.length] = 0
    writing.*.length += text.length + 1
    pad(writing)
}

pub fn putRectangle(writing: *Writer, width: u32, height: u32) -> void {
    header(writing, 8, RECTANGLE)
    putRaw32(writing, width)
    putRaw32(writing, height)
}

pub fn putFraction(writing: *Writer, numerator: u32, denominator: u32) -> void {
    header(writing, 8, FRACTION)
    putRaw32(writing, numerator)
    putRaw32(writing, denominator)
}

// A Struct: where its header is (for end).
pub fn beginStruct(writing: *Writer) -> usize {
    const at = writing.*.length
    header(writing, 0, STRUCT)
    return at
}

// An Object of `kind` (Format, Buffers, a node command...) with `id`.
pub fn beginObject(writing: *Writer, kind: u32, id: u32) -> usize {
    const at = writing.*.length
    header(writing, 0, OBJECT)
    putRaw32(writing, kind)
    putRaw32(writing, id)
    return at
}

// An Object's property: its key, then its value (any pod).
pub fn putKey(writing: *Writer, key: u32) -> void {
    putRaw32(writing, key)
    putRaw32(writing, 0)
}

// A Choice of `choice` over values of `kind`, `size` bytes each, which
// follow (putRaw32 and putRaw64), the default first.
pub fn beginChoice(writing: *Writer, choice: u32, kind: u32, size: u32) -> usize {
    const at = writing.*.length
    header(writing, 0, CHOICE)
    putRaw32(writing, choice)
    putRaw32(writing, 0)
    putRaw32(writing, size)
    putRaw32(writing, kind)
    return at
}

// Ends the container begun at `at`: its size, then padding.
pub fn end(writing: *Writer, at: usize) -> void {
    if writing.*.failed { return }
    store32(writing.*.bytes, at, @intCast(u32, writing.*.length - at - 8))
    pad(writing)
}

// A dictionary as PipeWire sends one: a Struct of the count and then
// each key and value.
pub fn beginDict(writing: *Writer, count: u32) -> usize {
    const at = beginStruct(writing)
    putUint(writing, count)
    return at
}

pub fn putItem(writing: *Writer, key: []const u8, value: []const u8) -> void {
    putString(writing, key)
    putString(writing, value)
}

// ---------------------------------------------------------------------------
// Reading

fn nothing() -> Pod { return Pod.{ .kind = 0, .size = 0, .body = 0 } }

// The pod at `at`; kind 0 when it does not end before `end`.
pub fn podAt(bytes: [*]const u8, at: usize, end_at: usize) -> Pod {
    if at + 8 > end_at { return nothing() }
    const size = load32(bytes, at)
    if @intCast(usize, size) > end_at - at - 8 { return nothing() }
    return Pod.{ .kind = load32(bytes, at + 4), .size = size, .body = at + 8 }
}

// The pods inside a Struct (or the bytes from `at` to `end`).
pub fn children(bytes: [*]const u8, container: Pod) -> Cursor {
    return Cursor.{ .bytes = bytes, .at = container.body, .end = container.body + @intCast(usize, container.size) }
}

pub fn next(cursor: *Cursor) -> Pod {
    const found = podAt(cursor.*.bytes, cursor.*.at, cursor.*.end)
    if found.kind == 0 {
        cursor.*.at = cursor.*.end
        return found
    }
    cursor.*.at = found.body + rounded(@intCast(usize, found.size))
    return found
}

// An Int, Id or Bool's value (a Long's low half; 0 for anything else).
pub fn uintOf(bytes: [*]const u8, value: Pod) -> u32 {
    if (value.kind == INT || value.kind == ID || value.kind == BOOL) && value.size >= 4 { return load32(bytes, value.body) }
    if (value.kind == LONG || value.kind == FD) && value.size >= 8 { return load32(bytes, value.body) }
    return 0
}

pub fn intOf(bytes: [*]const u8, value: Pod) -> i32 { return @bitCast(i32, uintOf(bytes, value)) }

pub fn longOf(bytes: [*]const u8, value: Pod) -> i64 {
    if (value.kind == LONG || value.kind == FD) && value.size >= 8 { return @bitCast(i64, load64(bytes, value.body)) }
    return @intCast(i64, intOf(bytes, value))
}

// A String's text (without its NUL); "" for None or anything else.
pub fn stringOf(bytes: [*]const u8, value: Pod) -> []const u8 {
    if value.kind != STRING || value.size == 0 { return bytes[0..0] }
    var length: usize = 0
    while length < @intCast(usize, value.size) && bytes[value.body + length] != 0 { length += 1 }
    return bytes[value.body..value.body + length]
}

// A Rectangle's or Fraction's first and second half.
pub fn firstOf(bytes: [*]const u8, value: Pod) -> u32 {
    if value.size < 4 { return 0 }
    return load32(bytes, value.body)
}

pub fn secondOf(bytes: [*]const u8, value: Pod) -> u32 {
    if value.size < 8 { return 0 }
    return load32(bytes, value.body + 4)
}

// An Object's type and id.
pub fn objectType(bytes: [*]const u8, object: Pod) -> u32 {
    if object.kind != OBJECT || object.size < 8 { return 0 }
    return load32(bytes, object.body)
}

pub fn objectId(bytes: [*]const u8, object: Pod) -> u32 {
    if object.kind != OBJECT || object.size < 8 { return 0 }
    return load32(bytes, object.body + 4)
}

// An Object's property `key`: its value (kind 0 when it has none).
pub fn property(bytes: [*]const u8, object: Pod, key: u32) -> Pod {
    if object.kind != OBJECT || object.size < 8 { return nothing() }
    const end_at = object.body + @intCast(usize, object.size)
    var at = object.body + 8
    while at + 16 <= end_at {
        const value = podAt(bytes, at + 8, end_at)
        if value.kind == 0 { return value }
        if load32(bytes, at) == key { return value }
        at = value.body + rounded(@intCast(usize, value.size))
    }
    return nothing()
}

// A Choice's kind (CHOICE_NONE for a plain value).
pub fn choiceOf(bytes: [*]const u8, value: Pod) -> u32 {
    if value.kind != CHOICE || value.size < 16 { return CHOICE_NONE }
    return load32(bytes, value.body)
}

// How many values a Choice has (1 for a plain value).
pub fn choiceCount(bytes: [*]const u8, value: Pod) -> usize {
    if value.kind != CHOICE || value.size < 16 { return 1 }
    const size = @intCast(usize, load32(bytes, value.body + 8))
    if size == 0 { return 0 }
    return (@intCast(usize, value.size) - 16) / size
}

// A Choice's value `index` as a pod of its child type (0: the default);
// a plain value is its own only one.
pub fn choiceValue(bytes: [*]const u8, value: Pod, index: usize) -> Pod {
    if value.kind != CHOICE { return value }
    if value.size < 16 || index >= choiceCount(bytes, value) { return nothing() }
    const size = load32(bytes, value.body + 8)
    return Pod.{ .kind = load32(bytes, value.body + 12), .size = size, .body = value.body + 16 + index * @intCast(usize, size) }
}

// A dictionary's (a Struct of the count, then keys and values) value for
// `key`; found says whether it had one.
pub fn dictValue(bytes: [*]const u8, dict: Pod, key: []const u8, found: *bool) -> []const u8 {
    found.* = false
    if dict.kind != STRUCT { return bytes[0..0] }
    var cursor = children(bytes, dict)
    const count = uintOf(bytes, next(&cursor))
    var index: u32 = 0
    while index < count {
        const name = next(&cursor)
        const value = next(&cursor)
        if name.kind == 0 || value.kind == 0 { break }
        if same(stringOf(bytes, name), key) {
            found.* = true
            return stringOf(bytes, value)
        }
        index += 1
    }
    return bytes[0..0]
}

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}
