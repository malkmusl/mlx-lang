// Layout and drawing (part of main.mlx, split from it).
const std = @import("std")
const png = @import("std.png")
const canvas_module = @import("std.ui.canvas")
const field = @import("std.ui.field")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const lists = @import("std.ui.lists")
const scroll = @import("std.ui.scroll")
const glyphs = @import("std.ui.glyphs")
const text_module = @import("std.ui.text")
const places = @import("../shared/places.mlx")
const host_module = @import("std.ui.host")
const icons = @import("../shared/icons.mlx")
const clock = @import("../shared/clock.mlx")
const timezone = @import("std.timezone")
const files_ui = @import("../../filemanager-shared/ui.mlx")
const files_view = @import("../../filemanager-shared/view.mlx")
const app = @import("./main.mlx")
const folder_module = @import("./folder.mlx")
const input_module = @import("./input.mlx")
const changes_module = @import("./changes.mlx")

// ---------------------------------------------------------------------------
// Layout

fn surfaceWidth(files: *app.Files) -> i32 { return host_module.width(app.hostOf(files)) }
pub fn surfaceHeight(files: *app.Files) -> i32 { return host_module.height(app.hostOf(files)) }

// Where everything is (projects/filemanager-shared/ui.mlx): by the
// window's size in logical pixels (pixels over the density) a phone's
// view, a compact one, or a wide one with the sidebar (full or a rail of
// icons; the narrower ones have a drawer over the content), inside the
// space the system's bars leave.
pub fn layoutOf(files: *app.Files) -> files_ui.Layout {
    return files_ui.layoutWithSidebar(surfaceWidth(files), surfaceHeight(files), host_module.insets(app.hostOf(files)), files.*.listView, files.*.scale, files.*.sidebarExpanded, files.*.sidebarOverlayOpen)
}

// The blur behind the translucent sidebar (none without one).
pub fn updateSidebarBlur(files: *app.Files) -> void {
    const layout = layoutOf(files)
    var rects: [4]i32 = [4]i32{ layout.sidebar.x, layout.sidebar.y, layout.sidebar.width, layout.sidebar.height }
    unsafe { host_module.setBlur(app.hostOf(files), @ptrCast([*]const i32, &rects), if ui.isEmpty(layout.sidebar) { 0 } else { 1 }) }
}

// The sidebar button: full sidebar or rail when wide, the drawer open or
// shut when narrower.
pub fn toggleSidebar(files: *app.Files) -> void {
    if layoutOf(files).mode == files_ui.Mode.wide {
        files.*.sidebarExpanded = !files.*.sidebarExpanded
    } else {
        files.*.sidebarOverlayOpen = !files.*.sidebarOverlayOpen
    }
    clampScroll(files)
    updateSidebarBlur(files)
}

fn contentLeft(files: *app.Files) -> i32 { return layoutOf(files).content.x }
pub fn contentTop(files: *app.Files) -> i32 { return layoutOf(files).content.y }
pub fn contentBottom(files: *app.Files) -> i32 { return ui.bottom(layoutOf(files).content) }
fn contentWidth(files: *app.Files) -> i32 { return layoutOf(files).content.width }
fn rowHeight(files: *app.Files) -> i32 { return layoutOf(files).rowHeight }
fn cellHeight(files: *app.Files) -> i32 { return layoutOf(files).cellHeight }
fn gridPadding(files: *app.Files) -> i32 { return layoutOf(files).gridPadding }

pub fn columns(files: *app.Files) -> i32 {
    const layout = layoutOf(files)
    return files_ui.columns(&layout)
}

fn cellWidth(files: *app.Files) -> i32 {
    const layout = layoutOf(files)
    return files_ui.cellWidth(&layout)
}

fn contentHeight(files: *app.Files) -> i32 {
    const count = @intCast(i32, files.*.shownCount)
    if files.*.listView { return count * rowHeight(files) + app.px(files, 8) }
    return gridPadding(files) * 2 + (count + columns(files) - 1) / columns(files) * cellHeight(files)
}

fn maxScroll(files: *app.Files) -> i32 {
    const extra = contentHeight(files) - (contentBottom(files) - contentTop(files))
    return if extra > 0 { extra } else { 0 }
}

pub fn clampScroll(files: *app.Files) -> void {
    if files.*.scroll > maxScroll(files) { files.*.scroll = maxScroll(files) }
    if files.*.scroll < 0 { files.*.scroll = 0 }
}

// Where item `index` (among those shown) is.
pub fn itemX(files: *app.Files, index: usize) -> i32 {
    const layout = layoutOf(files)
    return files_ui.itemRect(&layout, index, files.*.scroll, files.*.listView).x
}

pub fn itemY(files: *app.Files, index: usize) -> i32 {
    const layout = layoutOf(files)
    return files_ui.itemRect(&layout, index, files.*.scroll, files.*.listView).y
}

pub fn itemWidth(files: *app.Files) -> i32 { return if files.*.listView { contentWidth(files) } else { cellWidth(files) } }
pub fn itemHeight(files: *app.Files) -> i32 { return if files.*.listView { rowHeight(files) } else { cellHeight(files) } }

// The list's columns: where each starts (0: not shown for want of room;
// the room counted in logical pixels).
fn contentRight(files: *app.Files) -> i32 { return contentLeft(files) + contentWidth(files) }
fn kindColumn(files: *app.Files) -> i32 { return if contentWidth(files) >= app.px(files, 700) { contentRight(files) - app.px(files, 130) } else { 0 } }
fn sizeColumnRight(files: *app.Files) -> i32 {
    if contentWidth(files) < app.px(files, 470) { return 0 }
    return if kindColumn(files) > 0 { kindColumn(files) - app.px(files, 20) } else { contentRight(files) - app.px(files, 20) }
}
fn dateColumn(files: *app.Files) -> i32 {
    if contentWidth(files) < app.px(files, 380) { return 0 }
    const right = if sizeColumnRight(files) > 0 { sizeColumnRight(files) - app.px(files, 80) } else { contentRight(files) - app.px(files, 20) }
    return right - app.px(files, 170)
}
fn listNameX(files: *app.Files) -> i32 { return contentLeft(files) + app.px(files, 18) + layoutOf(files).listIconSize + app.px(files, 8) }
fn nameLimit(files: *app.Files) -> i32 {
    const end = if dateColumn(files) > 0 { dateColumn(files) } else { contentRight(files) }
    return end - listNameX(files) - app.px(files, 12)
}

// The trash's Empty button, left of grid and list (when there is room).
fn emptyTrashX(files: *app.Files) -> i32 { return layoutOf(files).gridButton.x - app.px(files, 12 + 110) }
fn showEmptyTrash(files: *app.Files) -> bool { return files.*.inTrash && emptyTrashX(files) >= layoutOf(files).title.x + app.px(files, 80) }

fn positiveWidth(width: i32) -> i32 { return if width > 0 { width } else { 0 } }

// The breadcrumbs of the status bar: part `index` of the path, and where
// it starts; count of them.
fn crumbCount(files: *app.Files) -> usize {
    if files.*.inTrash { return 1 }
    const path = app.pathText(app.pathOf(files))
    var start: usize = 0
    var count: usize = 1
    if app.underHome(files, path) { start = app.homeLength(files) }
    var index = start
    while index < path.length {
        if path[index] == 47 && index + 1 < path.length { count += 1 }
        index += 1
    }
    return count
}

// Crumb `index`: its label, and the length of the path up to it.
pub fn crumb(files: *app.Files, index: usize, end: *usize) -> []const u8 {
    const path = app.pathText(app.pathOf(files))
    if files.*.inTrash {
        end.* = path.length
        return app.say(files, "Trash", "Papierkorb")
    }
    const home = app.underHome(files, path)
    const start = if home { app.homeLength(files) } else { 0 }
    if index == 0 {
        end.* = if start == 0 { 1 } else { start }
        if home { return places.baseName(path[0..start]) }
        return app.say(files, "Computer", "Computer")
    }
    var at = start
    var part: usize = 0
    while at < path.length {
        if path[at] == 47 && at + 1 < path.length {
            part += 1
            if part == index {
                var stop = at + 1
                while stop < path.length && path[stop] != 47 { stop += 1 }
                end.* = stop
                return path[at + 1..stop]
            }
        }
        at += 1
    }
    end.* = path.length
    return path[0..0]
}

pub fn hitAt(files: *app.Files, x: i32, y: i32) -> usize {
    // The widgets name their own places (in the last frame): places,
    // buttons, the search, crumbs, columns, items.
    const context = app.uiOf(files)
    context.*.pointerInside = true
    const widget = view.hitAt(context, x, y)
    if widget != view.NONE { return app.hitOfId(widget) }
    const layout = layoutOf(files)
    if !ui.isEmpty(layout.sidebar) && ui.contains(layout.sidebar, x, y) { return app.HIT_SIDEBAR }
    if !ui.contains(layout.content, x, y) { return app.NONE }
    return app.HIT_CONTENT
}

// Scrolls so the cursor shows.
pub fn revealCursor(files: *app.Files) -> void {
    if files.*.cursor == app.NONE { return }
    const index = folder_module.shownIndexOf(files, files.*.cursor)
    if index == app.NONE { return }
    const top = itemY(files, index) + files.*.scroll - contentTop(files)
    const visible = contentBottom(files) - contentTop(files)
    const pad = if files.*.listView { 0 } else { gridPadding(files) }
    if top - pad < files.*.scroll { files.*.scroll = top - pad }
    if top + itemHeight(files) + pad > files.*.scroll + visible { files.*.scroll = top + itemHeight(files) + pad - visible }
    clampScroll(files)
}

// ---------------------------------------------------------------------------
// Drawing

const BACKGROUND: u32 = 4280164392
const TEXT_COLOR: u32 = 4293652213
const DIM_COLOR: u32 = 4287402656
const ACCENT: u32 = 4284129535

pub fn writeNumber(out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var index = at
    while count > 0 {
        count -= 1
        out[index] = digits[count]
        index += 1
    }
    return index
}

// A size as people read it: "812 bytes", "1.2 KB", "34 MB" (German: "1,2
// MB"); into `out` from `at`, the length then.
fn formatSize(files: *app.Files, size: isize, out: [*]u8, at: usize) -> usize {
    var length: usize = 0
    const value = if size > 0 { @intCast(usize, size) } else { 0 }
    if value < 1000 {
        length = writeNumber(out, at, value)
        return writeText(out, length, if value == 1 { app.say(files, " byte", " Byte") } else { app.say(files, " bytes", " Bytes") })
    }
    var unit: usize = 0
    // Tenths of the unit.
    var tenths = value / 100
    while tenths >= 10000 && unit < 4 {
        tenths = tenths / 1000
        unit += 1
    }
    if tenths >= 100 {
        length = writeNumber(out, at, (tenths + 5) / 10)
    } else {
        length = writeNumber(out, at, tenths / 10)
        var separator: u8 = 46
        if files.*.german { separator = 44 }
        out[length] = separator
        length = writeNumber(out, length + 1, tenths % 10)
    }
    const units = match unit { 0 => " KB", 1 => " MB", 2 => " GB", 3 => " TB", else => " PB" }
    return writeText(out, length, units)
}

fn writeText(out: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        out[index] = byte
        index += 1
    }
    return index
}

// What kind of file an entry is ("Folder", "PNG image", ...).
fn kindOf(files: *app.Files, entry: *const app.Entry, out: [*]u8) -> usize {
    if entry.*.directory { return writeText(out, 0, app.say(files, "Folder", "Ordner")) }
    const extension = folder_module.extensionOf(app.nameOf(files, entry))
    var upper: [8]u8 = undefined
    var length: usize = 0
    for byte in extension {
        if length < 8 {
            upper[length] = if byte >= 97 && byte <= 122 { byte - 32 } else { byte }
            length += 1
        }
    }
    const kind = upper[0..length]
    if length == 0 || extension.length > 8 {
        if entry.*.executable { return writeText(out, 0, app.say(files, "Program", "Programm")) }
        return writeText(out, 0, app.say(files, "Document", "Dokument"))
    }
    if std.text.same(kind, "PNG") || std.text.same(kind, "JPG") || std.text.same(kind, "JPEG") || std.text.same(kind, "GIF") || std.text.same(kind, "WEBP") || std.text.same(kind, "SVG") || std.text.same(kind, "BMP") {
        length = writeText(out, 0, kind)
        return writeText(out, length, app.say(files, " image", "-Bild"))
    }
    if std.text.same(kind, "PDF") { return writeText(out, 0, app.say(files, "PDF document", "PDF-Dokument")) }
    if std.text.same(kind, "TXT") || std.text.same(kind, "MD") { return writeText(out, 0, app.say(files, "Plain text", "Text")) }
    if std.text.same(kind, "ZIP") || std.text.same(kind, "GZ") || std.text.same(kind, "XZ") || std.text.same(kind, "ZST") || std.text.same(kind, "TAR") || std.text.same(kind, "7Z") || std.text.same(kind, "RAR") || std.text.same(kind, "BZ2") { return writeText(out, 0, app.say(files, "Archive", "Archiv")) }
    if std.text.same(kind, "MP3") || std.text.same(kind, "FLAC") || std.text.same(kind, "OGG") || std.text.same(kind, "WAV") || std.text.same(kind, "OPUS") || std.text.same(kind, "M4A") { return writeText(out, 0, "Audio") }
    if std.text.same(kind, "MP4") || std.text.same(kind, "MKV") || std.text.same(kind, "WEBM") || std.text.same(kind, "MOV") || std.text.same(kind, "AVI") { return writeText(out, 0, "Video") }
    if std.text.same(kind, "DESKTOP") { return writeText(out, 0, app.say(files, "App", "Programm")) }
    if std.text.same(kind, "MLX") || std.text.same(kind, "C") || std.text.same(kind, "H") || std.text.same(kind, "RS") || std.text.same(kind, "PY") || std.text.same(kind, "JS") || std.text.same(kind, "TS") || std.text.same(kind, "ZIG") || std.text.same(kind, "SH") || std.text.same(kind, "GO") || std.text.same(kind, "CPP") || std.text.same(kind, "JAVA") { return writeText(out, 0, app.say(files, "Source code", "Quelltext")) }
    length = writeText(out, 0, kind)
    return writeText(out, length, app.say(files, " file", "-Datei"))
}

// A house for the home folder, 18 logical pixels (times `scale`).
fn drawHomeGlyph(canvas: *app.Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    var row: i32 = 0
    while row < 8 {
        canvas_module.fillRect(canvas, x + (9 - row) * scale, y + (1 + row) * scale, row * 2 * scale, scale, color)
        row += 1
    }
    canvas_module.fillRect(canvas, x + 3 * scale, y + 9 * scale, 12 * scale, 8 * scale, color)
    canvas_module.fillRect(canvas, x + 7 * scale, y + 12 * scale, 4 * scale, 5 * scale, canvas_module.color(255, 26, 28, 36))
}

// A screen on a stand for the computer.
fn drawComputerGlyph(canvas: *app.Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.fillRoundedRect(canvas, x + scale, y + 2 * scale, 16 * scale, 11 * scale, 2 * scale, color)
    canvas_module.fillRect(canvas, x + 3 * scale, y + 4 * scale, 12 * scale, 7 * scale, canvas_module.color(255, 26, 28, 36))
    canvas_module.fillRect(canvas, x + 7 * scale, y + 13 * scale, 4 * scale, 3 * scale, color)
    canvas_module.fillRect(canvas, x + 4 * scale, y + 16 * scale, 10 * scale, 2 * scale, color)
}

fn drawSidebar(files: *app.Files, canvas: *app.Canvas) -> void {
    const layout = layoutOf(files)
    if ui.isEmpty(layout.sidebar) { return }
    const left = layout.sidebar.x
    const width = layout.sidebar.width
    files_view.drawSidebarBackground(canvas, &layout)
    view.region(app.uiOf(files), app.idOf(app.HIT_SIDEBAR), layout.sidebar)
    const small = app.smallOf(files)
    const body = app.bodyOf(files)
    const s = files.*.scale
    const place_row = placeRow(files)
    if layout.sidebarOpen { text_module.drawText(canvas, small, app.say(files, "Favorites", "Favoriten"), left + 18 * s, layout.sidebar.y + 22 * s, DIM_COLOR, 0) }
    var index: usize = 0
    var locations_drawn = false
    while index < files.*.placeCount {
        const kind = files.*.placeKinds[index]
        const y = placeTop(files, index)
        if layout.sidebarOpen && (kind == app.PLACE_COMPUTER || kind == app.PLACE_TRASH) && !locations_drawn {
            text_module.drawText(canvas, small, app.say(files, "Locations", "Orte"), left + 18 * s, y - 22 * s, DIM_COLOR, 0)
            locations_drawn = true
        }
        const chosen = lists.rowBackground(app.uiOf(files), app.idOf(app.HIT_PLACE + index), ui.rect(left + 8 * s, y, width - 16 * s, place_row), folder_module.placeActive(files, index), false)
        const glyph = ACCENT
        const icon_y = y + (place_row - 18 * s) / 2
        if kind == app.PLACE_HOME {
            drawHomeGlyph(canvas, left + 16 * s, icon_y, glyph, s)
        } else if kind == app.PLACE_COMPUTER {
            drawComputerGlyph(canvas, left + 16 * s, icon_y, glyph, s)
        } else if kind == app.PLACE_TRASH {
            icons.drawTrash(canvas, left + 14 * s, icon_y - 2 * s, 22 * s, places.trashFull(files.*.environment), false)
        } else {
            icons.drawFolder(small, canvas, app.pathText(app.placePathAt(files, index)), left + 15 * s, icon_y, 20 * s)
        }
        if layout.sidebarOpen { text_module.drawText(canvas, body, folder_module.placeLabel(files, index), left + 44 * s, y + (place_row - 16 * s) / 2, TEXT_COLOR, width - 56 * s) }
        index += 1
    }
}

// The row of place `index`: below "Favorites" (the "Locations" heading
// pushes the computer and the trash down); a rail of icons has neither.
pub fn placeTop(files: *app.Files, index: usize) -> i32 {
    const layout = layoutOf(files)
    const s = files.*.scale
    if !layout.sidebarOpen { return layout.sidebar.y + 52 * s + @intCast(i32, index) * placeRow(files) }
    var y = layout.sidebar.y + 44 * s + @intCast(i32, index) * placeRow(files)
    if layout.mode == files_ui.Mode.phone { y += 12 * s }
    if files.*.placeKinds[index] == app.PLACE_COMPUTER || files.*.placeKinds[index] == app.PLACE_TRASH { y += 30 * s }
    return y
}

// A place's row: taller for a finger.
fn placeRow(files: *app.Files) -> i32 {
    const layout = layoutOf(files)
    return (if layout.mode == files_ui.Mode.phone { 44 } else { app.PLACE_ROW }) * files.*.scale
}

fn drawToolbar(files: *app.Files, canvas: *app.Canvas) -> void {
    const layout = layoutOf(files)
    const context = app.uiOf(files)
    const button = layout.buttonSize
    const top = layout.backButton.y
    files_view.drawToolbarBackground(canvas, &layout)
    const back = controls.chevronButton(context, app.idOf(app.HIT_BACK), layout.backButton, true, files.*.backCount > 0)
    const forward = controls.chevronButton(context, app.idOf(app.HIT_FORWARD), layout.forwardButton, false, files.*.forwardCount > 0)
    // The folder's name.
    const name = folder_module.folderTitle(files)
    const title_x = layout.title.x
    const title_end = if showEmptyTrash(files) { emptyTrashX(files) - 12 } else { ui.right(layout.title) }
    const s = files.*.scale
    text_module.drawText(canvas, app.titleOf(files), name, title_x, layout.title.y + (layout.title.height - 17 * s) / 2, TEXT_COLOR, positiveWidth(title_end - title_x))
    // Grid or list: two segments with a glyph each.
    const grid_x = layout.gridButton.x
    const list_x = layout.listButton.x
    controls.segmentsFrame(context, ui.rect(grid_x, top, ui.right(layout.listButton) - grid_x, button))
    const grid = controls.segment(context, app.idOf(app.HIT_GRID), ui.rect(grid_x + 2 * s, top + 2 * s, button - 2 * s, button - 4 * s), "", !files.*.listView, 0)
    const list = controls.segment(context, app.idOf(app.HIT_LIST), ui.rect(list_x, top + 2 * s, button - 2 * s, button - 4 * s), "", files.*.listView, 0)
    files_view.drawGridGlyphScaled(canvas, grid_x + (button - 14 * s) / 2, top + (button - 14 * s) / 2, TEXT_COLOR, s)
    files_view.drawListGlyphScaled(canvas, list_x + (button - 16 * s) / 2, top + (button - 14 * s) / 2, TEXT_COLOR, s)
    // The trash's Empty button.
    if showEmptyTrash(files) {
        const emptied = controls.button(context, app.idOf(app.HIT_EMPTY_TRASH), ui.rect(emptyTrashX(files), top, 110 * s, button), app.say(files, "Empty", "Leeren"), controls.BUTTON_NORMAL, true)
    }
    // The search field (the app keeps which has the keyboard).
    if ui.isEmpty(layout.search) { return }
    const search_id = app.idOf(app.HIT_SEARCH)
    if files.*.searchFocused { view.setFocus(context, search_id) } else if view.hasFocus(context, search_id) { view.setFocus(context, view.NONE) }
    const searched = field.textField(context, search_id, layout.search, app.searchOf(files), app.say(files, "Search", "Suchen"), true)
}

// The sidebar's button (over the sidebar when it is there): lit while the
// sidebar is open.
fn drawSidebarToggle(files: *app.Files, canvas: *app.Canvas) -> void {
    const layout = layoutOf(files)
    const button = layout.buttonSize
    const toggled = controls.toggleButton(app.uiOf(files), app.idOf(app.HIT_SIDEBAR_TOGGLE), layout.sidebarButton, layout.sidebarOpen)
    const s = files.*.scale
    files_view.drawSidebarGlyphScaled(canvas, layout.sidebarButton.x + (button - 16 * s) / 2, layout.sidebarButton.y + (button - 14 * s) / 2, TEXT_COLOR, s)
}

fn drawStatus(files: *app.Files, canvas: *app.Canvas) -> void {
    const layout = layoutOf(files)
    const status = layout.status
    if ui.isEmpty(status) { return }
    const top = status.y
    const right = ui.right(status)
    files_view.drawStatusBackground(canvas, &layout)
    const small = app.smallOf(files)
    const s = files.*.scale
    // The path: the parts to click on.
    var x = status.x + 12 * s
    var index: usize = 0
    const count = crumbCount(files)
    while index < count {
        var end: usize = 0
        const label = crumb(files, index, &end)
        const w = text_module.measure(small, label)
        const chosen = controls.crumb(app.uiOf(files), app.idOf(app.HIT_CRUMB + index), ui.rect(x - 5 * s, top + 5 * s, w + 10 * s, status.height - 10 * s), small, label, index + 1 == count)
        x += w
        if index + 1 < count {
            glyphs.chevron(canvas, x + 8 * s, top + (status.height - 9 * s) / 2, false, DIM_COLOR, 9 * s, 2 * s)
        }
        x += 22 * s
        index += 1
    }
    // How many, or a note.
    var buffer: [160]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    var length: usize = 0
    var color = DIM_COLOR
    if files.*.noteLength > 0 {
        length = writeText(text, 0, app.noteText(files))
        color = canvas_module.color(255, 240, 160, 90)
    } else {
        const selected = input_module.selectedCount(files)
        if selected > 0 {
            length = writeNumber(text, 0, selected)
            length = writeText(text, length, app.say(files, " of ", " von "))
            length = writeNumber(text, length, files.*.shownCount)
            length = writeText(text, length, app.say(files, " selected", " ausgewählt"))
        } else {
            length = writeNumber(text, 0, files.*.shownCount)
            length = writeText(text, length, if files.*.shownCount == 1 { app.say(files, " item", " Objekt") } else { app.say(files, " items", " Objekte") })
            var disk: std.fs.FileSystemStat = undefined
            if !files.*.inTrash && std.fs.fileSystemStatus(folder_module.listedPath(files), &disk) == 0 {
                length = writeText(text, length, ", ")
                length = formatSize(files, @intCast(isize, disk.blocksAvailable) * disk.blockSize, text, length)
                length = writeText(text, length, app.say(files, " available", " verfügbar"))
            }
        }
    }
    const shown = text[0..length]
    const w = text_module.measure(small, shown)
    if x + 20 * s < right - 14 * s - w { text_module.drawText(canvas, small, shown, right - 14 * s - w, top + (status.height - 14 * s) / 2, color, 0) }
}

// Entry `index`'s icon in a `size` square at (x, y): its picture, a folder
// or a page; `faded` while cut.
pub fn drawEntryIcon(files: *app.Files, canvas: *app.Canvas, index: usize, x: i32, y: i32, size: i32, allow_thumb: bool) -> void {
    const entry = app.entryAt(files, index)
    const name = app.nameOf(files, entry)
    if entry.*.directory {
        icons.drawFolder(app.smallOf(files), canvas, name, x, y, size)
        return
    }
    if allow_thumb {
        const thumb = findThumb(files, index)
        if thumb != null {
            const image = thumb.?
            const w = @intCast(i32, image.*.width)
            canvas_module.drawImage(canvas, image, x + (size - w) / 2, y + (size - w) / 2, w, 255)
            return
        }
    }
    icons.drawFile(app.smallOf(files), canvas, name, x, y, size)
}

// A picture already read (drawDragIcon draws outside a frame).
fn findThumb(files: *app.Files, index: usize) -> ?*png.Image {
    var slot: usize = 0
    while slot < app.THUMBS {
        if files.*.thumbEntry[slot] == index && files.*.thumbState[slot] == 1 { return app.thumbAt(files, slot) }
        slot += 1
    }
    return null
}

// Whether the path of an entry was cut (it shows faded until pasted).
fn isCut(files: *app.Files, index: usize) -> bool {
    if !files.*.clipCut || files.*.clipCount == 0 { return false }
    var path: app.Path = undefined
    app.entryPath(files, index, &path)
    const clip = app.fieldBytes(files, @offsetOf(app.Files, "clip"))
    var at: usize = 0
    while at < files.*.clipLength {
        var end = at
        while clip[end] != 0 { end += 1 }
        if std.text.same(clip[at..end], app.pathText(&path)) { return true }
        at = end + 1
    }
    return false
}

// The field renaming an entry: the name typed, the caret.
fn drawEditor(files: *app.Files, canvas: *app.Canvas, x: i32, y: i32, width: i32, height: i32) -> void {
    const body = app.bodyOf(files)
    const s = files.*.scale
    canvas_module.fillRoundedRect(canvas, x - 2 * s, y - 2 * s, width + 4 * s, height + 4 * s, 6 * s, ACCENT)
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 5 * s, canvas_module.color(255, 22, 24, 30))
    const text = app.editText(files)
    // Scrolled so the caret shows.
    const caret_at = text_module.measure(body, text[0..files.*.caret])
    var shift: i32 = 0
    if caret_at > width - 12 * s { shift = caret_at - (width - 12 * s) }
    if files.*.editSelected { canvas_module.fillRect(canvas, x + 5 * s - shift, y + 3 * s, caret_at, height - 6 * s, canvas_module.color(255, 50, 90, 150)) }
    text_module.drawText(canvas, body, text, x + 5 * s - shift, y + (height - 16 * s) / 2, TEXT_COLOR, width - 8 * s + shift)
    canvas_module.fillRect(canvas, x + 5 * s - shift + caret_at, y + 3 * s, 2 * s, height - 6 * s, ACCENT)
}

fn drawGrid(files: *app.Files, canvas: *app.Canvas) -> void {
    const small = app.smallOf(files)
    const body = app.bodyOf(files)
    const top = contentTop(files)
    const bottom = contentBottom(files)
    const cell = cellWidth(files)
    const cell_height = cellHeight(files)
    const grid_icon = layoutOf(files).gridIconSize
    const s = files.*.scale
    var budget: usize = 12
    var index: usize = 0
    while index < files.*.shownCount {
        const x = itemX(files, index)
        const y = itemY(files, index)
        if y + cell_height > top && y < bottom {
            const at = files.*.shown[index]
            const entry = app.entryAt(files, at)
            const icon_x = x + (cell - grid_icon) / 2
            const icon_y = y + 6 * s
            const drop_here = files.*.dropHover == at
            // The icon and the name take the pointer, not the space around.
            const part = lists.part(app.uiOf(files), app.idOf(index), ui.rect(x + 6 * s, y + 4 * s, cell - 12 * s, cell_height - 8 * s))
            if entry.*.selected || drop_here {
                canvas_module.fillRoundedRect(canvas, icon_x - 6 * s, icon_y - 4 * s, grid_icon + 12 * s, grid_icon + 8 * s, 9 * s, canvas_module.color(255, 58, 62, 76))
            } else if files.*.hover == index {
                canvas_module.fillRoundedRect(canvas, icon_x - 6 * s, icon_y - 4 * s, grid_icon + 12 * s, grid_icon + 8 * s, 9 * s, canvas_module.color(255, 42, 45, 56))
            }
            if !entry.*.directory { const thumb = folder_module.thumbOf(files, at, grid_icon, &budget) }
            drawEntryIcon(files, canvas, at, icon_x, icon_y, grid_icon, true)
            if isCut(files, at) { canvas_module.fillRect(canvas, icon_x, icon_y, grid_icon, grid_icon, canvas_module.color(150, 30, 32, 40)) }
            const name_y = icon_y + grid_icon + 8 * s
            if files.*.editing == at {
                drawEditor(files, canvas, x + 4 * s, name_y - 3 * s, cell - 8 * s, 22 * s)
            } else {
                var buffer: [100]u8 = undefined
                var bytes: [*]u8 = undefined
                unsafe { bytes = @ptrCast([*]u8, &buffer) }
                const name = icons.fitText(small, app.nameOf(files, entry), cell - 12 * s, bytes)
                const w = text_module.measure(small, name)
                const name_x = x + (cell - w) / 2
                if entry.*.selected { canvas_module.fillRoundedRect(canvas, name_x - 5 * s, name_y - 2 * s, w + 10 * s, 18 * s, 6 * s, ACCENT) }
                text_module.drawText(canvas, small, name, name_x, name_y, if entry.*.hidden && !entry.*.selected { DIM_COLOR } else { TEXT_COLOR }, 0)
            }
        }
        index += 1
    }
}

fn drawListHeader(files: *app.Files, canvas: *app.Canvas) -> void {
    const layout = layoutOf(files)
    const header = layout.listHeader
    if ui.isEmpty(header) { return }
    files_view.drawListHeaderBackground(canvas, &layout)
    // Each title takes clicks across its column.
    const y = header.y
    const height = header.height - 1
    columnTitle(files, app.say(files, "Name", "Name"), ui.rect(listNameX(files), y, nameLimit(files), height), app.SORT_NAME, false)
    const s = files.*.scale
    if dateColumn(files) > 0 { columnTitle(files, app.say(files, "Date Modified", "Änderungsdatum"), ui.rect(dateColumn(files), y, 170 * s, height), app.SORT_DATE, false) }
    if sizeColumnRight(files) > 0 { columnTitle(files, app.say(files, "Size", "Größe"), ui.rect(sizeColumnRight(files) - 80 * s, y, 80 * s, height), app.SORT_SIZE, true) }
    if kindColumn(files) > 0 { columnTitle(files, app.say(files, "Kind", "Art"), ui.rect(kindColumn(files), y, contentRight(files) - kindColumn(files) - 8 * s, height), app.SORT_KIND, false) }
}

fn columnTitle(files: *app.Files, title: []const u8, area: ui.Rect, key: usize, right: bool) -> void {
    const clicked = lists.columnHeader(app.uiOf(files), app.idOf(app.HIT_COLUMN + key), area, title, files.*.sortKey == key, files.*.sortReversed, right)
}

fn drawList(files: *app.Files, canvas: *app.Canvas) -> void {
    const layout = layoutOf(files)
    const width = layout.content.width
    const left = layout.content.x
    const row_height = layout.rowHeight
    const list_icon = layout.listIconSize
    const small = app.smallOf(files)
    const body = app.bodyOf(files)
    const top = contentTop(files)
    const bottom = contentBottom(files)
    const name_x = listNameX(files)
    const s = files.*.scale
    const text_y = (row_height - 16 * s) / 2
    const small_text_y = (row_height - 14 * s) / 2
    const limit = nameLimit(files)
    var index: usize = 0
    var buffer: [160]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    const today = localDay(files, timezone.now())
    while index < files.*.shownCount {
        const y = itemY(files, index)
        if y + row_height > top && y < bottom {
            const at = files.*.shown[index]
            const entry = app.entryAt(files, at)
            const selected = entry.*.selected
            const part = lists.part(app.uiOf(files), app.idOf(index), ui.rect(left, y, width, row_height))
            if selected {
                files_view.drawListRow(canvas, &layout, y, if files.*.searchFocused { canvas_module.color(255, 70, 76, 92) } else { ACCENT })
            } else if files.*.dropHover == at {
                files_view.drawListRow(canvas, &layout, y, canvas_module.color(255, 58, 62, 76))
            } else if index % 2 == 1 {
                files_view.drawListRow(canvas, &layout, y, canvas_module.color(255, 35, 37, 46))
            }
            drawEntryIcon(files, canvas, at, left + 18 * s, y + (row_height - list_icon) / 2, list_icon, false)
            if isCut(files, at) { canvas_module.fillRect(canvas, left + 18 * s, y + (row_height - list_icon) / 2, list_icon, list_icon, canvas_module.color(150, 30, 32, 40)) }
            const color = if selected { canvas_module.color(255, 255, 255, 255) } else if entry.*.hidden { DIM_COLOR } else { TEXT_COLOR }
            const dim = if selected { canvas_module.color(255, 225, 235, 255) } else { DIM_COLOR }
            if files.*.editing == at {
                drawEditor(files, canvas, name_x - 4 * s, y + 2 * s, limit, row_height - 4 * s)
            } else {
                var name_buffer: [100]u8 = undefined
                var name_bytes: [*]u8 = undefined
                unsafe { name_bytes = @ptrCast([*]u8, &name_buffer) }
                text_module.drawText(canvas, body, icons.fitText(body, app.nameOf(files, entry), limit, name_bytes), name_x, y + text_y, color, 0)
            }
            if dateColumn(files) > 0 {
                const modified = @intCast(i64, entry.*.modified)
                const time = timezone.civil(modified + timezone.offsetAt(app.zoneOf(files), modified))
                const length = clock.formatDate(&time, today - timezone.daysFromCivil(time.year, time.month, time.day), files.*.german, text)
                text_module.drawText(canvas, small, text[0..length], dateColumn(files), y + small_text_y, dim, 0)
            }
            if sizeColumnRight(files) > 0 {
                var length: usize = 0
                if entry.*.directory {
                    length = writeText(text, 0, "--")
                } else {
                    length = formatSize(files, entry.*.size, text, 0)
                }
                const shown = text[0..length]
                text_module.drawText(canvas, small, shown, sizeColumnRight(files) - text_module.measure(small, shown), y + small_text_y, dim, 0)
            }
            if kindColumn(files) > 0 {
                const length = kindOf(files, entry, text)
                text_module.drawText(canvas, small, text[0..length], kindColumn(files), y + small_text_y, dim, left + width - kindColumn(files) - 16 * s)
            }
        }
        index += 1
    }
}

// The day number of a moment in the local time zone.
fn localDay(files: *app.Files, utc: i64) -> i64 {
    const time = timezone.civil(utc + timezone.offsetAt(app.zoneOf(files), utc))
    return timezone.daysFromCivil(time.year, time.month, time.day)
}

// A thin bar at the right while there is more to scroll to (dragged, it
// scrolls).
fn drawScrollbar(files: *app.Files) -> void {
    const bar = app.barOf(files)
    const s = files.*.scale
    const top = contentTop(files) + 4 * s
    bar.*.content = contentHeight(files)
    bar.*.viewport = contentBottom(files) - contentTop(files)
    bar.*.offset = files.*.scroll
    if scroll.indicator(app.uiOf(files), app.idOf(app.HIT_SCROLL), ui.rect(contentRight(files) - 14 * s, top, 14 * s, contentBottom(files) - 4 * s - top), bar) { files.*.scroll = bar.*.offset }
}

pub fn draw(context: *anyopaque, canvas: *app.Canvas) -> void {
    const files = app.filesOf(context)
    if !files.*.ready { return }
    const s = files.*.scale
    const width = surfaceWidth(files)
    const height = surfaceHeight(files)
    // The widgets see the pointer as the app tracks it.
    const widgets = app.uiOf(files)
    view.begin(widgets, canvas)
    widgets.*.hover = app.idOf(files.*.hover)
    widgets.*.pointerX = files.*.pointerX
    widgets.*.pointerY = files.*.pointerY
    widgets.*.pressX = files.*.pressX
    widgets.*.pressY = files.*.pressY
    widgets.*.pressed = if files.*.pressHit != app.NONE { app.idOf(files.*.pressHit) } else { view.NONE }
    widgets.*.time = @intCast(u64, std.time.milliseconds())
    const layout = layoutOf(files)
    canvas_module.clear(canvas, 0)
    files_view.drawMainBackground(canvas, &layout)
    // What scrolls lies under the bars, cut to its place.
    const content = layout.content
    view.region(widgets, app.idOf(app.HIT_CONTENT), content)
    view.pushClip(widgets, content)
    // The files first: the bars are drawn over what scrolls under them.
    if files.*.unreadable {
        const message = app.say(files, "This folder can't be read", "Dieser Ordner kann nicht gelesen werden")
        text_module.drawText(canvas, app.bodyOf(files), message, content.x + (content.width - text_module.measure(app.bodyOf(files), message)) / 2, contentTop(files) + 60 * s, DIM_COLOR, 0)
    } else if files.*.shownCount == 0 {
        const message = if app.searchText(files).length > 0 { app.say(files, "No matches", "Keine Treffer") } else if files.*.inTrash { app.say(files, "The trash is empty", "Der Papierkorb ist leer") } else { app.say(files, "This folder is empty", "Dieser Ordner ist leer") }
        text_module.drawText(canvas, app.bodyOf(files), message, content.x + (content.width - text_module.measure(app.bodyOf(files), message)) / 2, contentTop(files) + 60 * s, DIM_COLOR, 0)
    } else if files.*.listView {
        drawList(files, canvas)
    } else {
        drawGrid(files, canvas)
    }
    // Files dragged over the folder itself.
    if files.*.dropping && files.*.dropHover == app.NONE && !files.*.inTrash {
        const drop_top = ui.bottom(layout.toolbar) + 3 * s
        canvas_module.strokeRoundedRect(canvas, content.x + 3 * s, drop_top, content.width - 6 * s, layout.status.y - drop_top - 3 * s, 8 * s, 2 * s, ACCENT)
    }
    // The selecting rectangle.
    if files.*.pressed && files.*.banding {
        const left = if files.*.pressX < files.*.pointerX { files.*.pressX } else { files.*.pointerX }
        const top = if files.*.pressY < files.*.pointerY { files.*.pressY } else { files.*.pointerY }
        const w = if files.*.pressX < files.*.pointerX { files.*.pointerX - files.*.pressX } else { files.*.pressX - files.*.pointerX }
        const h = if files.*.pressY < files.*.pointerY { files.*.pointerY - files.*.pressY } else { files.*.pressY - files.*.pointerY }
        canvas_module.fillRect(canvas, left, top, w, h, canvas_module.color(50, 90, 160, 255))
        canvas_module.strokeRoundedRect(canvas, left, top, w, h, 0, s, canvas_module.color(200, 90, 160, 255))
    }
    drawScrollbar(files)
    view.popClip(widgets)
    if files.*.listView { drawListHeader(files, canvas) }
    drawToolbar(files, canvas)
    drawStatus(files, canvas)
    drawSidebar(files, canvas)
    drawSidebarToggle(files, canvas)
    // The menu over everything.
    changes_module.drawMenu(files, canvas)
    // A widget took what changed: once more.
    if view.end(widgets) { app.redraw(files) }
}
