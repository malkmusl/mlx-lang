// The file manager of the Mlx desktop, laid out like the Finder of macOS:
// a translucent sidebar with the places (home, the XDG folders such as
// Downloads, the computer, the trash), a toolbar with back and forward,
// the folder's name, grid or list view and a search field, the folder's
// files as icons or as a list (name, date modified, size, kind; a click on
// a column sorts by it), and a status bar with the path and how many items
// there are. Folders come first and names sort as people count
// ("File 2" before "File 10").
//
//   mlx-files [PATH | file:///PATH | trash:///]
//
// A click selects (Ctrl adds, Shift a range, dragging over empty space
// selects what the rectangle touches), a double click or Enter opens: a
// folder here, a file with its app (xdg-open). The keyboard: the arrows,
// Home, End, Page Up/Down move, typing jumps to a name, Backspace or
// Alt+Left goes back, Alt+Right forward, Alt+Up to the parent, F2
// renames, Ctrl+Shift+N makes a folder, Delete moves to the trash,
// Ctrl+C/X/V copy, cut and paste (within the file manager), Ctrl+A selects
// all, Ctrl+F searches, Ctrl+H shows hidden files, Ctrl+1/2 switch the
// view, F5 reloads, Ctrl+W closes. A right click offers the same. Files
// dragged out go as text/uri-list (onto the dock's trash, another folder,
// other apps); files dropped in are copied here (onto a folder: into it),
// the file manager's own ones moved. A folder that changes is read again
// within a second. Dates and labels follow the locale (German or English).
const std = @import("std")
const png = @import("std.png")
const apps_module = @import("../shared/apps.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("../shared/panel.mlx")
const panel_drag = @import("../shared/panel_drag.mlx")
const menu_module = @import("../shared/menu.mlx")
const places = @import("../shared/places.mlx")
const pins_module = @import("../shared/pins.mlx")
const icons = @import("../shared/icons.mlx")
const thumbs_module = @import("../shared/thumbs.mlx")
const clock = @import("../shared/clock.mlx")
const timezone = @import("std.timezone")
const crash = @import("std.crash")
const folder_module = @import("./folder.mlx")
const input_module = @import("./input.mlx")
const drawing_module = @import("./drawing.mlx")

pub const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Panel = panel_module.Panel
pub const Path = apps_module.Path

const WIDTH: i32 = 940
const HEIGHT: i32 = 580
const MIN_WIDTH: i32 = 560
const MIN_HEIGHT: i32 = 340
pub const SIDEBAR: i32 = 200
pub const TOOLBAR: i32 = 52
pub const STATUS: i32 = 30
pub const HEADER: i32 = 28
pub const ROW: i32 = 26
pub const LIST_ICON: i32 = 18
pub const CELL_WIDTH: i32 = 104
pub const CELL_HEIGHT: i32 = 104
pub const GRID_ICON: i32 = 56
pub const GRID_PADDING: i32 = 14
pub const PLACE_ROW: i32 = 28
pub const SEARCH_WIDTH: i32 = 190
pub const BUTTON: i32 = 30

pub const NONE: usize = 1 << 40
pub const BUTTON_LEFT: u32 = 272
pub const BUTTON_RIGHT: u32 = 273

// What a point is over: an item (its index among those shown), or one of
// these.
pub const HIT_PLACE: usize = 1 << 31
pub const HIT_CRUMB: usize = 1 << 32
pub const HIT_COLUMN: usize = 1 << 33
pub const HIT_BACK: usize = 1 << 34
pub const HIT_FORWARD: usize = HIT_BACK + 1
pub const HIT_GRID: usize = HIT_BACK + 2
pub const HIT_LIST: usize = HIT_BACK + 3
pub const HIT_SEARCH: usize = HIT_BACK + 4
pub const HIT_EMPTY_TRASH: usize = HIT_BACK + 5
pub const HIT_CONTENT: usize = HIT_BACK + 6
pub const HIT_SIDEBAR: usize = HIT_BACK + 7

// A folder's entries: at most MAX_ENTRIES, their names in one buffer.
pub const MAX_ENTRIES: usize = 16384
pub const NAMES: usize = 2097152
pub const HISTORY: usize = 32
pub const MAX_PLACES: usize = 10
pub const THUMBS: usize = 96
pub const CLIP: usize = 16384
pub const EDIT: usize = 255
pub const SEARCH: usize = 64
pub const SCRIPT: usize = 32768

// Sort keys (the list's columns).
pub const SORT_NAME: usize = 0
pub const SORT_DATE: usize = 1
pub const SORT_SIZE: usize = 2
pub const SORT_KIND: usize = 3

// Places.
pub const PLACE_HOME: u8 = 0
pub const PLACE_FOLDER: u8 = 1
pub const PLACE_COMPUTER: u8 = 2
pub const PLACE_TRASH: u8 = 3

// What a menu entry does.
pub const MENU_OPEN: u32 = 0
pub const MENU_RENAME: u32 = 1
pub const MENU_TRASH: u32 = 2
pub const MENU_COPY: u32 = 3
pub const MENU_CUT: u32 = 4
pub const MENU_PASTE: u32 = 5
pub const MENU_NEW_FOLDER: u32 = 6
pub const MENU_TERMINAL: u32 = 7
pub const MENU_HIDDEN: u32 = 8
pub const MENU_RESTORE: u32 = 9
pub const MENU_DELETE: u32 = 10
pub const MENU_EMPTY_TRASH: u32 = 11
pub const MENU_DOCK: u32 = 12
pub const MENU_SORT: u32 = 13
pub const MENU_VIEW: u32 = 14

// Keys (evdev).
pub const KEY_ESCAPE: u32 = 1
pub const KEY_1: u32 = 2
pub const KEY_2: u32 = 3
pub const KEY_BACKSPACE: u32 = 14
pub const KEY_W: u32 = 17
pub const KEY_ENTER: u32 = 28
pub const KEY_A: u32 = 30
pub const KEY_F: u32 = 33
pub const KEY_H: u32 = 35
pub const KEY_X: u32 = 45
pub const KEY_C: u32 = 46
pub const KEY_V: u32 = 47
pub const KEY_N: u32 = 49
pub const KEY_F2: u32 = 60
pub const KEY_F5: u32 = 63
pub const KEY_KP_ENTER: u32 = 96
pub const KEY_HOME: u32 = 102
pub const KEY_UP: u32 = 103
pub const KEY_PAGE_UP: u32 = 104
pub const KEY_LEFT: u32 = 105
pub const KEY_RIGHT: u32 = 106
pub const KEY_END: u32 = 107
pub const KEY_DOWN: u32 = 108
pub const KEY_PAGE_DOWN: u32 = 109
pub const KEY_DELETE: u32 = 111

// Modifiers (the compositor's keymap: wl_keyboard.modifiers).
pub const SHIFT: u32 = 1
pub const CONTROL: u32 = 4
pub const ALT: u32 = 8

pub const SYS_open: usize = 2
const SYS_close: usize = 3
pub const O_DIRECTORY: usize = 65536
pub const O_CLOEXEC: usize = 524288

pub const Entry = struct {
    // Where its name is in the names buffer.
    name: usize
    nameLength: usize
    size: isize
    modified: isize
    directory: bool
    link: bool
    executable: bool
    hidden: bool
    selected: bool
}

pub const Files = struct {
    panel: Panel
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    terminal: [*]const u8
    german: bool
    zone: timezone.Zone
    // The folder shown (the trash's files directory for the trash), and
    // what its directory looked like when read (see refresh).
    path: Path
    inTrash: bool
    unreadable: bool
    changedSeconds: isize
    changedNanoseconds: isize
    lastCheck: usize
    // Its entries (entries, names), sorted (order), and those shown after
    // the hidden ones and the search are left out (shown: indices into
    // entries).
    entries: [*]Entry
    names: [*]u8
    namesUsed: usize
    count: usize
    order: [*]usize
    scratch: [*]usize
    shown: [*]usize
    shownCount: usize
    // Where we were and where Back came from.
    back: [32]Path
    backCount: usize
    forward: [32]Path
    forwardCount: usize
    // The view.
    listView: bool
    showHidden: bool
    sortKey: usize
    sortReversed: bool
    scroll: i32
    // The selection: the entry the keyboard is at (NONE: none), and where
    // a Shift range starts.
    cursor: usize
    anchor: usize
    // The pointer, what it is over, a press (where, on what, whether it
    // became a drag or a selecting rectangle), and the last click (for
    // double clicks).
    pointerX: i32
    pointerY: i32
    hover: usize
    pressed: bool
    pressX: i32
    pressY: i32
    pressHit: usize
    pressKeep: bool
    dragging: bool
    banding: bool
    bandBase: [*]bool
    lastClick: usize
    lastClickHit: usize
    // A drag of files over the window: the folder entry under it (NONE:
    // the folder shown), and whether one is over us.
    dropHover: usize
    dropping: bool
    // Renaming (editing: the entry, NONE: not renaming): the name typed
    // and the caret in it.
    editing: usize
    edit: [256]u8
    editLength: usize
    caret: usize
    // The name before its extension is selected (typing replaces it).
    editSelected: bool
    // The search field.
    searchFocused: bool
    search: [64]u8
    searchLength: usize
    // Typing jumps to names: what was typed lately and when.
    typed: [32]u8
    typedLength: usize
    typedAt: usize
    // Copied or cut paths (NUL after each).
    clip: [16384]u8
    clipLength: usize
    clipCount: usize
    clipCut: bool
    // The sidebar.
    placeKinds: [10]u8
    placePaths: [10]Path
    placeCount: usize
    // The right-click menu and what it is for (an entry, NONE: the folder).
    menu: menu_module.Menu
    menuOpen: bool
    menuEntry: usize
    // Pictures of PNG files in the grid: which entry each slot holds and
    // its state (0 free, 1 read, 2 none), and the next slot to reuse.
    thumbs: [96]png.Image
    thumbEntry: [96]usize
    thumbState: [96]u8
    thumbNext: usize
    thumbsPending: bool
    pictures: thumbs_module.Thumbs
    // A note in the status bar (an error) until noteUntil.
    note: [160]u8
    noteLength: usize
    noteUntil: usize
    // Names kept across a reload (the selection; NUL after each).
    keep: [8192]u8
    keepLength: usize
    keepCursor: [256]u8
    keepCursorLength: usize
    // Modifier keys held (see modifiers).
    held: u32
    body: Text
    small: Text
    title: Text
}

// ---------------------------------------------------------------------------
// Access

pub fn filesOf(context: *anyopaque) -> *Files {
    unsafe { return @ptrCast(*Files, context) }
}

pub fn panelOf(files: *Files) -> *Panel {
    unsafe { return @ptrCast(*Panel, &files.*.panel) }
}

pub fn zoneOf(files: *Files) -> *timezone.Zone {
    unsafe { return @ptrCast(*timezone.Zone, &files.*.zone) }
}

pub fn pathOf(files: *Files) -> *Path {
    unsafe { return @ptrCast(*Path, &files.*.path) }
}

pub fn menuOf(files: *Files) -> *menu_module.Menu {
    unsafe { return @ptrCast(*menu_module.Menu, &files.*.menu) }
}

pub fn bodyOf(files: *Files) -> *Text {
    unsafe { return @ptrCast(*Text, &files.*.body) }
}

pub fn smallOf(files: *Files) -> *Text {
    unsafe { return @ptrCast(*Text, &files.*.small) }
}

pub fn titleOf(files: *Files) -> *Text {
    unsafe { return @ptrCast(*Text, &files.*.title) }
}

pub fn fieldBytes(files: *Files, field: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(files) + field) }
}

pub fn backAt(files: *Files, index: usize) -> *Path {
    unsafe { return @ptrFromInt(*Path, @intFromPtr(files) + @offsetOf(Files, "back") + index * @sizeOf(Path)) }
}

pub fn forwardAt(files: *Files, index: usize) -> *Path {
    unsafe { return @ptrFromInt(*Path, @intFromPtr(files) + @offsetOf(Files, "forward") + index * @sizeOf(Path)) }
}

pub fn placePathAt(files: *Files, index: usize) -> *Path {
    unsafe { return @ptrFromInt(*Path, @intFromPtr(files) + @offsetOf(Files, "placePaths") + index * @sizeOf(Path)) }
}

pub fn thumbAt(files: *Files, slot: usize) -> *png.Image {
    unsafe { return @ptrFromInt(*png.Image, @intFromPtr(files) + @offsetOf(Files, "thumbs") + slot * @sizeOf(png.Image)) }
}

pub fn entryAt(files: *Files, index: usize) -> *Entry {
    unsafe { return @ptrFromInt(*Entry, @intFromPtr(files.*.entries) + index * @sizeOf(Entry)) }
}

pub fn nameOf(files: *Files, entry: *const Entry) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(files.*.names) + entry.*.name) }
    return bytes[0..entry.*.nameLength]
}

pub fn editText(files: *Files) -> []const u8 { return fieldBytes(files, @offsetOf(Files, "edit"))[0..files.*.editLength] }
pub fn searchText(files: *Files) -> []const u8 { return fieldBytes(files, @offsetOf(Files, "search"))[0..files.*.searchLength] }
pub fn noteText(files: *Files) -> []const u8 { return fieldBytes(files, @offsetOf(Files, "note"))[0..files.*.noteLength] }

pub fn pathText(path: *Path) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, path) }
    return bytes[0..path.*.length]
}

pub fn copyPath(target: *Path, source: *Path) -> void {
    apps_module.pathClear(target)
    apps_module.pathAdd(target, pathText(source))
}

fn noString() -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

// The label in the locale's language.
pub fn say(files: *Files, english: []const u8, german: []const u8) -> []const u8 {
    return if files.*.german { german } else { english }
}

// The modifiers held: what the compositor says (wl_keyboard.modifiers)
// and the modifier keys seen pressed (for compositors that say little).
// Held modifiers; not Ctrl and Alt for a key that types its third level
// (AltGr, or Ctrl+Alt standing in for it).
pub fn modifiers(files: *Files) -> u32 {
    const panel = panelOf(files)
    const held = panel.*.keyboard.depressed | files.*.held
    if panel.*.keyboard.levelThree && panel.*.textLength > 0 { return held & ~(CONTROL | ALT) }
    return held
}

pub fn trackModifier(files: *Files, code: u32, pressed: bool) -> void {
    var bit: u32 = 0
    if code == 42 || code == 54 { bit = SHIFT }
    if code == 29 || code == 97 { bit = CONTROL }
    if code == 56 || code == 100 { bit = ALT }
    if bit == 0 { return }
    files.*.held = if pressed { files.*.held | bit } else { files.*.held & ~bit }
}

// A note in the status bar for four seconds.
pub fn setNote(files: *Files, first: []const u8, second: []const u8) -> void {
    var length: usize = 0
    for byte in first {
        if length < 160 {
            files.*.note[length] = byte
            length += 1
        }
    }
    for byte in second {
        if length < 160 {
            files.*.note[length] = byte
            length += 1
        }
    }
    files.*.noteLength = length
    files.*.noteUntil = panel_module.milliseconds() + 4000
}

// ---------------------------------------------------------------------------
// Paths

// The path of entry `index` into `into`.
pub fn entryPath(files: *Files, index: usize, into: *Path) -> void {
    copyPath(into, pathOf(files))
    if into.*.length == 0 || into.*.bytes[into.*.length - 1] != 47 { apps_module.pathAdd(into, "/") }
    apps_module.pathAdd(into, nameOf(files, entryAt(files, index)))
}

// `path` without its last part ("/" stays "/").
pub fn parentOf(path: *Path) -> void {
    var end = path.*.length
    while end > 1 && path.*.bytes[end - 1] == 47 { end -= 1 }
    while end > 0 && path.*.bytes[end - 1] != 47 { end -= 1 }
    while end > 1 && path.*.bytes[end - 1] == 47 { end -= 1 }
    if end == 0 { end = 1 }
    path.*.length = end
    path.*.bytes[0] = 47
}

pub fn homeOf(files: *Files) -> [*]const u8 { return apps_module.environmentValue(files.*.environment, "HOME") }

pub fn homeLength(files: *Files) -> usize {
    const home = homeOf(files)
    if @intFromPtr(home) == 0 { return 0 }
    var length: usize = 0
    while home[length] != 0 { length += 1 }
    while length > 1 && home[length - 1] == 47 { length -= 1 }
    return length
}

// Whether `path` is $HOME or inside it.
pub fn underHome(files: *Files, path: []const u8) -> bool {
    const length = homeLength(files)
    if length == 0 || path.length < length { return false }
    const home = homeOf(files)
    if !std.text.same(path[0..length], home[0..length]) { return false }
    return path.length == length || path[length] == 47
}

// ---------------------------------------------------------------------------
// Starting

const Failure = error { NoMemory, NoHome }

fn noMemory() -> Failure!void { return Failure.NoMemory }

fn allocate(files: *Files, bytes: usize) -> ?[*]u8 {
    return files.*.allocator.alloc(bytes, 16)
}

// Where to start: the argument (a path, a file:// URI, trash:///), else
// the home folder; a file's folder with the file selected.
fn startAt(files: *Files, arguments: [][*]const u8) -> void {
    var target: Path = undefined
    apps_module.pathClear(&target)
    var select_name: [256]u8 = undefined
    var select_length: usize = 0
    if arguments.length > 1 {
        const argument = arguments[1]
        var length: usize = 0
        while argument[length] != 0 { length += 1 }
        const text = argument[0..length]
        if length >= 6 && std.text.same(text[0..6], "trash:") {
            folder_module.goTrash(files)
            files.*.backCount = 0
            return
        }
        if length >= 7 && std.text.same(text[0..7], "file://") {
            const found = places.uriPath(text, 0, &target)
        } else if length > 0 && text[0] != 47 {
            var cwd: [1024]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &cwd) }
            if std.fs.getWorkingDirectory(bytes, 1024) > 0 {
                apps_module.pathAddC(&target, bytes)
                apps_module.pathAdd(&target, "/")
            }
            apps_module.pathAdd(&target, text)
        } else {
            apps_module.pathAdd(&target, text)
        }
    }
    if target.length > 0 && !places.isDirectory(apps_module.pathEnd(&target)) {
        const base = places.baseName(pathText(&target))
        for byte in base {
            if select_length < 256 {
                select_name[select_length] = byte
                select_length += 1
            }
        }
        parentOf(&target)
    }
    if target.length == 0 || !places.isDirectory(apps_module.pathEnd(&target)) {
        apps_module.pathClear(&target)
        const home = homeOf(files)
        if @intFromPtr(home) != 0 { apps_module.pathAdd(&target, home[0..homeLength(files)]) } else { apps_module.pathAdd(&target, "/") }
    }
    const shown = folder_module.go(files, pathText(&target), false, false)
    var index: usize = 0
    while select_length > 0 && index < files.*.count {
        if std.text.same(nameOf(files, entryAt(files, index)), select_name[0..select_length]) {
            input_module.selectOnly(files, index)
            drawing_module.revealCursor(files)
        }
        index += 1
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    crash.install()
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Files), 16)
    if memory == null { return noMemory() }
    var files: *Files = undefined
    unsafe { files = @ptrCast(*Files, memory.?) }
    files.*.allocator = allocator
    files.*.environment = environment
    files.*.terminal = apps_module.environmentValue(environment, "MLX_TERMINAL")
    files.*.german = clock.germanLocale(environment)
    timezone.load(zoneOf(files), environment, allocator)
    const entries = allocate(files, MAX_ENTRIES * @sizeOf(Entry))
    const names = allocate(files, NAMES)
    const order = allocate(files, MAX_ENTRIES * 8)
    const scratch = allocate(files, MAX_ENTRIES * 8)
    const shown = allocate(files, MAX_ENTRIES * 8)
    const band = allocate(files, MAX_ENTRIES)
    if entries == null || names == null || order == null || scratch == null || shown == null || band == null { return noMemory() }
    unsafe {
        files.*.entries = @ptrCast([*]Entry, entries.?)
        files.*.names = names.?
        files.*.order = @ptrCast([*]usize, order.?)
        files.*.scratch = @ptrCast([*]usize, scratch.?)
        files.*.shown = @ptrCast([*]usize, shown.?)
        files.*.bandBase = @ptrCast([*]bool, band.?)
    }
    files.*.cursor = NONE
    files.*.anchor = NONE
    files.*.hover = NONE
    files.*.pressHit = NONE
    files.*.lastClickHit = NONE
    files.*.dropHover = NONE
    files.*.editing = NONE
    files.*.menuEntry = NONE
    files.*.sortKey = SORT_NAME
    files.*.listView = false
    var slot: usize = 0
    while slot < THUMBS {
        files.*.thumbState[slot] = 0
        files.*.thumbEntry[slot] = NONE
        slot += 1
    }
    thumbs_module.init(folder_module.picturesOf(files), environment, allocator)
    const loaded_body = text_module.loadText(bodyOf(files), 13, allocator)
    const loaded_small = text_module.loadText(smallOf(files), 12, allocator)
    const loaded_title = text_module.loadText(titleOf(files), 16, allocator)
    folder_module.findPlaces(files)
    startAt(files, arguments)

    const panel = panelOf(files)
    panel.*.context = @ptrCast(*anyopaque, files)
    panel.*.draw = drawing_module.draw
    panel.*.event = input_module.onEvent
    try panel_module.openWindow(panel, allocator, arguments, "Files", "org.mlx.files", @intCast(u32, WIDTH), @intCast(u32, HEIGHT))
    panel.*.toplevel.setMinSize(MIN_WIDTH, MIN_HEIGHT)
    folder_module.setTitle(files)
    panel_drag.acceptDrops(panel, "text/uri-list")
    panel_module.report(panel, "mlx-files")
    panel.*.tickInterval = 250
    try panel_module.run(panel)
    panel_module.close(panel)
}
