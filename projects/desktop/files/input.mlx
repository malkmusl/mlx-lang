// Selection and input (part of main.mlx, split from it).
const canvas_module = @import("std.ui.canvas")
const field = @import("std.ui.field")
const text_module = @import("std.ui.text")
const panel_module = @import("../shared/panel.mlx")
const panel_drag = @import("../shared/panel_drag.mlx")
const panel_menu = @import("../shared/panel_menu.mlx")
const menu_module = @import("../shared/menu.mlx")
const places = @import("../shared/places.mlx")
const thumbs_module = @import("../shared/thumbs.mlx")
const app = @import("./main.mlx")
const folder_module = @import("./folder.mlx")
const changes_module = @import("./changes.mlx")
const drawing_module = @import("./drawing.mlx")

// ---------------------------------------------------------------------------
// Selection

fn clearSelection(files: *app.Files) -> void {
    var index: usize = 0
    while index < files.*.count {
        app.entryAt(files, index).*.selected = false
        index += 1
    }
}

pub fn selectOnly(files: *app.Files, entry: usize) -> void {
    clearSelection(files)
    app.entryAt(files, entry).*.selected = true
    files.*.cursor = entry
    files.*.anchor = entry
}

pub fn selectedCount(files: *app.Files) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        if app.entryAt(files, files.*.shown[index]).*.selected { count += 1 }
        index += 1
    }
    return count
}

// Selects the items from the anchor to `to` (shown indices).
fn selectRange(files: *app.Files, last: usize) -> void {
    var from = if files.*.anchor == app.NONE { app.NONE } else { folder_module.shownIndexOf(files, files.*.anchor) }
    if from == app.NONE { from = last }
    clearSelection(files)
    var low = if from < last { from } else { last }
    const high = if from < last { last } else { from }
    while low <= high {
        app.entryAt(files, files.*.shown[low]).*.selected = true
        low += 1
    }
    files.*.cursor = files.*.shown[last]
}

// Moves the cursor by `step` items (Shift: selecting on the way).
fn moveCursor(files: *app.Files, step: i32, extend: bool) -> void {
    if files.*.shownCount == 0 { return }
    var at: i32 = 0
    if files.*.cursor != app.NONE {
        const index = folder_module.shownIndexOf(files, files.*.cursor)
        if index != app.NONE { at = @intCast(i32, index) + step }
    } else if step < 0 {
        at = @intCast(i32, files.*.shownCount) - 1
    }
    if at < 0 { at = 0 }
    if at >= @intCast(i32, files.*.shownCount) { at = @intCast(i32, files.*.shownCount) - 1 }
    const index = @intCast(usize, at)
    if extend {
        selectRange(files, index)
    } else {
        selectOnly(files, files.*.shown[index])
    }
    drawing_module.revealCursor(files)
}

// The selecting rectangle: the items it touches are selected (with those
// selected before when Ctrl was held).
fn updateBand(files: *app.Files) -> void {
    const left = if files.*.pressX < files.*.pointerX { files.*.pressX } else { files.*.pointerX }
    const right = if files.*.pressX < files.*.pointerX { files.*.pointerX } else { files.*.pressX }
    const top = if files.*.pressY < files.*.pointerY { files.*.pressY } else { files.*.pointerY }
    const bottom = if files.*.pressY < files.*.pointerY { files.*.pointerY } else { files.*.pressY }
    var index: usize = 0
    while index < files.*.shownCount {
        const entry = app.entryAt(files, files.*.shown[index])
        var x = drawing_module.itemX(files, index)
        var w = drawing_module.itemWidth(files)
        if !files.*.listView {
            x += 8
            w -= 16
        }
        const y = drawing_module.itemY(files, index)
        const touches = x < right && x + w > left && y < bottom && y + drawing_module.itemHeight(files) > top
        entry.*.selected = touches || (files.*.pressKeep && files.*.bandBase[files.*.shown[index]])
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Input

// Starts dragging the selected items (text/uri-list, as file:// URIs).
fn startDragOut(files: *app.Files) -> void {
    var data: [1024]u8 = undefined
    var length: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if app.entryAt(files, at).*.selected {
            var path: app.Path = undefined
            app.entryPath(files, at, &path)
            // file://PATH with the bytes a URI can't hold as %XX.
            var uri: [1024]u8 = undefined
            var uri_length: usize = 0
            for byte in "file://" {
                uri[uri_length] = byte
                uri_length += 1
            }
            for byte in app.pathText(&path) {
                const plain = (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || folder_module.isDigit(byte) || byte == 47 || byte == 45 || byte == 46 || byte == 95 || byte == 126
                if uri_length + 3 < 1020 {
                    if plain {
                        uri[uri_length] = byte
                        uri_length += 1
                    } else {
                        const digits = "0123456789ABCDEF"
                        uri[uri_length] = 37
                        uri[uri_length + 1] = digits[@intCast(usize, byte >> 4)]
                        uri[uri_length + 2] = digits[@intCast(usize, byte & 15)]
                        uri_length += 3
                    }
                }
            }
            if length + uri_length + 2 <= 1024 {
                var at_byte: usize = 0
                while at_byte < uri_length {
                    data[length] = uri[at_byte]
                    length += 1
                    at_byte += 1
                }
                data[length] = 13
                data[length + 1] = 10
                length += 2
            }
        }
        index += 1
    }
    if length == 0 { return }
    files.*.dragging = panel_drag.startDrag(app.panelOf(files), "text/uri-list", data[0..length], 64, drawDragIcon)
}

fn drawDragIcon(context: *anyopaque, canvas: *app.Canvas) -> void {
    const files = app.filesOf(context)
    if files.*.cursor == app.NONE || files.*.cursor >= files.*.count { return }
    drawing_module.drawEntryIcon(files, canvas, files.*.cursor, 4, 4, 56, true)
    const count = selectedCount(files)
    if count > 1 {
        // A badge with how many.
        var digits: [24]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &digits) }
        const length = drawing_module.writeNumber(bytes, 0, count)
        canvas_module.fillRoundedRect(canvas, 36, 0, 28, 20, 10, canvas_module.color(255, 230, 60, 60))
        const text = bytes[0..length]
        text_module.drawText(canvas, app.smallOf(files), text, 50 - text_module.measure(app.smallOf(files), text) / 2, 3, canvas_module.color(255, 255, 255, 255), 0)
    }
}

fn press(files: *app.Files, hit: usize) -> void {
    const now = panel_module.milliseconds()
    const is_double = hit == files.*.lastClickHit && now < files.*.lastClick + 400
    files.*.lastClick = if is_double { 0 } else { now }
    files.*.lastClickHit = hit
    // What was pressed (a std.ui widget follows the pointer while held).
    files.*.pressHit = hit
    if files.*.editing != app.NONE && hit != folder_module.shownIndexOf(files, files.*.editing) { changes_module.finishRename(files) }
    files.*.searchFocused = hit == app.HIT_SEARCH
    if hit == app.HIT_BACK {
        folder_module.goBack(files)
    } else if hit == app.HIT_FORWARD {
        folder_module.goForward(files)
    } else if hit == app.HIT_GRID {
        changes_module.setView(files, false)
    } else if hit == app.HIT_LIST {
        changes_module.setView(files, true)
    } else if hit == app.HIT_EMPTY_TRASH {
        places.emptyTrash(files.*.environment)
    } else if hit >= app.HIT_COLUMN && hit < app.HIT_COLUMN + 4 {
        changes_module.setSort(files, hit - app.HIT_COLUMN)
    } else if hit >= app.HIT_CRUMB && hit < app.HIT_CRUMB + 256 {
        var end: usize = 0
        const label = drawing_module.crumb(files, hit - app.HIT_CRUMB, &end)
        if !files.*.inTrash && end < app.pathOf(files).*.length {
            var target: app.Path = undefined
            app.copyPath(&target, app.pathOf(files))
            target.length = end
            const shown = folder_module.go(files, app.pathText(&target), false, true)
        }
    } else if hit >= app.HIT_PLACE && hit < app.HIT_PLACE + app.MAX_PLACES {
        folder_module.goPlace(files, hit - app.HIT_PLACE)
    } else if hit == app.HIT_CONTENT {
        // A selecting rectangle from here.
        files.*.pressed = true
        files.*.banding = true
        files.*.pressKeep = app.modifiers(files) & (app.CONTROL | app.SHIFT) != 0
        var index: usize = 0
        while index < files.*.count {
            files.*.bandBase[index] = app.entryAt(files, index).*.selected
            index += 1
        }
        if !files.*.pressKeep {
            clearSelection(files)
            files.*.cursor = app.NONE
        }
    } else if hit < files.*.shownCount {
        const entry_index = files.*.shown[hit]
        const entry = app.entryAt(files, entry_index)
        const held = app.modifiers(files)
        files.*.pressed = true
        files.*.pressHit = hit
        files.*.pressKeep = false
        if held & app.CONTROL != 0 {
            entry.*.selected = !entry.*.selected
            files.*.cursor = entry_index
            files.*.anchor = entry_index
        } else if held & app.SHIFT != 0 {
            selectRange(files, hit)
        } else if entry.*.selected {
            // Kept for a drag of all of them; one alone on release.
            files.*.cursor = entry_index
            files.*.pressKeep = true
        } else {
            selectOnly(files, entry_index)
        }
        if is_double && held & (app.CONTROL | app.SHIFT) == 0 {
            files.*.pressed = false
            folder_module.openSelected(files)
        }
    }
}

fn release(files: *app.Files) -> void {
    if files.*.pressed && !files.*.banding && files.*.pressKeep && !files.*.dragging && files.*.pressHit < files.*.shownCount {
        selectOnly(files, files.*.shown[files.*.pressHit])
    }
    files.*.pressed = false
    files.*.banding = false
    files.*.pressHit = app.NONE
}

fn motion(files: *app.Files, x: i32, y: i32) -> bool {
    files.*.pointerX = x
    files.*.pointerY = y
    if files.*.pressed && files.*.banding {
        updateBand(files)
        return true
    }
    // The scroll indicator's thumb, the search's selection.
    if files.*.pressHit == app.HIT_SCROLL || files.*.pressHit == app.HIT_SEARCH { return true }
    if files.*.pressed && !files.*.dragging && files.*.pressHit < files.*.shownCount {
        const dx = x - files.*.pressX
        const dy = y - files.*.pressY
        if dx * dx + dy * dy > 36 {
            files.*.pressed = false
            startDragOut(files)
            return true
        }
    }
    const hover = drawing_module.hitAt(files, x, y)
    if hover == files.*.hover { return false }
    files.*.hover = hover
    return true
}

fn onKey(files: *app.Files, key_code: u32) -> void {
    const panel = app.panelOf(files)
    const held = app.modifiers(files)
    const control = held & app.CONTROL != 0
    const alt = held & app.ALT != 0
    const shift = held & app.SHIFT != 0
    if files.*.editing != app.NONE {
        changes_module.editKey(files, key_code)
        return
    }
    if control && key_code == app.KEY_F {
        files.*.searchFocused = true
        return
    }
    if files.*.searchFocused && !control && !alt {
        changes_module.searchKey(files, key_code)
        return
    }
    if control && key_code == app.KEY_W {
        panel.*.running = false
    } else if control && key_code == app.KEY_H {
        files.*.showHidden = !files.*.showHidden
        folder_module.buildShown(files)
    } else if control && key_code == app.KEY_A {
        var index: usize = 0
        while index < files.*.shownCount {
            app.entryAt(files, files.*.shown[index]).*.selected = true
            index += 1
        }
    } else if control && key_code == app.KEY_C {
        changes_module.copySelected(files, false)
    } else if control && key_code == app.KEY_X {
        changes_module.copySelected(files, true)
    } else if control && key_code == app.KEY_V {
        changes_module.paste(files)
    } else if control && shift && key_code == app.KEY_N {
        changes_module.newFolder(files)
    } else if control && key_code == app.KEY_1 {
        changes_module.setView(files, false)
    } else if control && key_code == app.KEY_2 {
        changes_module.setView(files, true)
    } else if key_code == app.KEY_F5 {
        folder_module.reload(files)
    } else if key_code == app.KEY_F2 {
        if files.*.cursor != app.NONE && app.entryAt(files, files.*.cursor).*.selected { changes_module.startRename(files, files.*.cursor) }
    } else if key_code == app.KEY_DELETE {
        changes_module.trashSelected(files)
    } else if alt && key_code == app.KEY_LEFT || key_code == app.KEY_BACKSPACE {
        folder_module.goBack(files)
    } else if alt && key_code == app.KEY_RIGHT {
        folder_module.goForward(files)
    } else if alt && key_code == app.KEY_UP {
        folder_module.goUp(files)
    } else if (control || alt) && key_code == app.KEY_DOWN {
        folder_module.openSelected(files)
    } else if key_code == app.KEY_ENTER || key_code == app.KEY_KP_ENTER {
        folder_module.openSelected(files)
    } else if key_code == app.KEY_ESCAPE {
        if app.searchText(files).length > 0 {
            field.clear(app.searchOf(files))
            folder_module.buildShown(files)
        } else {
            clearSelection(files)
            files.*.cursor = app.NONE
        }
    } else if key_code == app.KEY_LEFT {
        moveCursor(files, -1, shift)
    } else if key_code == app.KEY_RIGHT {
        moveCursor(files, 1, shift)
    } else if key_code == app.KEY_UP {
        moveCursor(files, if files.*.listView { -1 } else { -drawing_module.columns(files) }, shift)
    } else if key_code == app.KEY_DOWN {
        moveCursor(files, if files.*.listView { 1 } else { drawing_module.columns(files) }, shift)
    } else if key_code == app.KEY_PAGE_UP || key_code == app.KEY_PAGE_DOWN {
        const rows = (drawing_module.contentBottom(files) - drawing_module.contentTop(files)) / drawing_module.itemHeight(files)
        const per_row = if files.*.listView { 1 } else { drawing_module.columns(files) }
        var step = rows - 1
        if step < 1 { step = 1 }
        step = step * per_row
        moveCursor(files, if key_code == app.KEY_PAGE_UP { -step } else { step }, shift)
    } else if key_code == app.KEY_HOME {
        moveCursor(files, -1000000, shift)
    } else if key_code == app.KEY_END {
        moveCursor(files, 1000000, shift)
    } else if !control && !alt {
        changes_module.typeAhead(files)
    }
}

pub fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const files = app.filesOf(context)
    const panel = app.panelOf(files)
    if kind == panel_module.EVENT_CONFIGURED {
        // Blur behind the translucent sidebar.
        var rects: [4]i32 = [4]i32{ 0, 0, app.SIDEBAR, drawing_module.surfaceHeight(files) }
        unsafe { panel_module.setBlur(panel, @ptrCast([*]const i32, &rects), 1) }
        drawing_module.clampScroll(files)
        drawing_module.revealCursor(files)
    } else if kind == panel_module.EVENT_MOTION {
        if !motion(files, @bitCast(i32, a), b) { return }
    } else if kind == panel_module.EVENT_LEAVE {
        files.*.hover = app.NONE
    } else if kind == panel_module.EVENT_BUTTON {
        if a == app.BUTTON_LEFT && b == 1 {
            files.*.pressX = files.*.pointerX
            files.*.pressY = files.*.pointerY
            press(files, drawing_module.hitAt(files, files.*.pointerX, files.*.pointerY))
        } else if a == app.BUTTON_LEFT && b == 0 {
            release(files)
        } else if a == app.BUTTON_RIGHT && b == 1 {
            if files.*.editing != app.NONE { changes_module.finishRename(files) }
            const hit = drawing_module.hitAt(files, files.*.pointerX, files.*.pointerY)
            if hit < files.*.shownCount {
                const entry = files.*.shown[hit]
                if !app.entryAt(files, entry).*.selected { selectOnly(files, entry) }
                files.*.cursor = entry
                changes_module.openMenu(files, entry)
            } else if hit == app.HIT_CONTENT {
                clearSelection(files)
                files.*.cursor = app.NONE
                changes_module.openMenu(files, app.NONE)
            }
        }
    } else if kind == panel_module.EVENT_WHEEL {
        if a != 0 { return }
        var pixels = panel.*.wheelPixels * 3
        if pixels == 0 { pixels = b * 40 }
        files.*.scroll += pixels
        drawing_module.clampScroll(files)
        files.*.hover = drawing_module.hitAt(files, files.*.pointerX, files.*.pointerY)
    } else if kind == panel_module.EVENT_KEY {
        app.trackModifier(files, a, b != 0)
        if b == 0 { return }
        onKey(files, a)
    } else if kind == panel_module.EVENT_KEYBOARD_LEAVE {
        files.*.held = 0
        return
    } else if kind == panel_module.EVENT_MENU_MOTION {
        if menu_module.hover(app.menuOf(files), b) { panel_menu.menuChanged(panel) }
        return
    } else if kind == panel_module.EVENT_MENU_LEAVE {
        app.menuOf(files).*.hover = menu_module.NONE
        panel_menu.menuChanged(panel)
        return
    } else if kind == panel_module.EVENT_MENU_BUTTON {
        if b == 0 && app.menuOf(files).*.hover != menu_module.NONE { changes_module.choose(files, app.menuOf(files).*.hover) }
    } else if kind == panel_module.EVENT_MENU_CLOSED {
        files.*.menuOpen = false
    } else if kind == panel_module.EVENT_DRAG_MOTION {
        files.*.dropping = true
        const hit = drawing_module.hitAt(files, @bitCast(i32, a), b)
        files.*.dropHover = app.NONE
        if hit < files.*.shownCount && app.entryAt(files, files.*.shown[hit]).*.directory && !app.entryAt(files, files.*.shown[hit]).*.selected { files.*.dropHover = files.*.shown[hit] }
    } else if kind == panel_module.EVENT_DRAG_LEAVE {
        files.*.dropping = false
        files.*.dropHover = app.NONE
    } else if kind == panel_module.EVENT_DROP {
        const hit = drawing_module.hitAt(files, @bitCast(i32, a), b)
        files.*.dropHover = app.NONE
        if hit < files.*.shownCount && app.entryAt(files, files.*.shown[hit]).*.directory && !app.entryAt(files, files.*.shown[hit]).*.selected { files.*.dropHover = files.*.shown[hit] }
        changes_module.dropFiles(files)
    } else if kind == panel_module.EVENT_DRAG_END {
        files.*.dragging = false
    } else if kind == panel_module.EVENT_TICK {
        tick(files)
        return
    }
    panel.*.dirty = true
}

// Every tick: pictures still to read, the folder changed, the note gone.
fn tick(files: *app.Files) -> void {
    const panel = app.panelOf(files)
    const now = panel_module.milliseconds()
    thumbs_module.pump(folder_module.picturesOf(files))
    const pending = files.*.thumbsPending || thumbs_module.busy(folder_module.picturesOf(files))
    files.*.thumbsPending = false
    if folder_module.recheckThumbs(files) || pending { panel.*.dirty = true }
    if files.*.noteLength > 0 && now >= files.*.noteUntil {
        files.*.noteLength = 0
        panel.*.dirty = true
    }
    if now >= files.*.lastCheck + 700 {
        files.*.lastCheck = now
        // Not while something points at entries by their place (renaming,
        // the menu, a press, a drag over us).
        const busy = files.*.editing != app.NONE || files.*.menuOpen || files.*.pressed || files.*.dropping
        if !busy && folder_module.directoryChanged(files) {
            folder_module.reload(files)
            panel.*.dirty = true
        }
    }
    panel.*.tickInterval = if pending { 120 } else { 250 }
}
