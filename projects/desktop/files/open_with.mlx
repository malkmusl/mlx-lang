// The Open with popup: which app opens a file, chosen over the window.
// A file whose extension has no app yet (shared/defaults.mlx) opens it
// on a double click, as does Open with ... in the menu: the apps that
// take the file's type first ("Recommended"), then every other app,
// each with its icon; "Always use for .EXT files" (ticked when the
// extension has no app yet) makes the choice the extension's default.
// Open (Enter, or a double click on an app) starts the app with the file;
// Cancel (Escape, a click beside the card) leaves it.
const std = @import("std")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const controls = @import("std.ui.controls")
const host_module = @import("std.ui.host")
const apps_module = @import("../shared/apps.mlx")
const defaults = @import("../shared/defaults.mlx")
const app = @import("./main.mlx")

const NONE: usize = app.NONE
// Logical pixels.
const WIDTH: i32 = 420
const HEIGHT: i32 = 460
const HEADER: i32 = 70
const CAPTION: i32 = 26
const ROW: i32 = 38
const FOOTER: i32 = 100
const ICON: i32 = 24

const KEY_SPACE: u32 = 57

// Where the popup's parts are.
const Layout = struct {
    card: ui.Rect
    list: ui.Rect
    check: ui.Rect
    cancel: ui.Rect
    open: ui.Rect
}

fn layoutOf(files: *app.Files) -> Layout {
    const width = host_width(files)
    const height = host_height(files)
    var card_width = app.px(files, WIDTH)
    if card_width > width - app.px(files, 32) { card_width = width - app.px(files, 32) }
    var card_height = app.px(files, HEIGHT)
    if card_height > height - app.px(files, 32) { card_height = height - app.px(files, 32) }
    const card = ui.rect((width - card_width) / 2, (height - card_height) / 2, card_width, card_height)
    const pad = app.px(files, 18)
    const list = ui.rect(card.x + app.px(files, 8), card.y + app.px(files, HEADER), card.width - app.px(files, 16), card.height - app.px(files, HEADER + FOOTER))
    const check = ui.rect(card.x + pad, ui.bottom(list) + app.px(files, 8), card.width - pad * 2, app.px(files, 30))
    const button_width = app.px(files, 104)
    const button_height = app.px(files, 32)
    const button_y = ui.bottom(card) - pad - button_height
    const open = ui.rect(ui.right(card) - pad - button_width, button_y, button_width, button_height)
    const cancel = ui.rect(open.x - app.px(files, 10) - button_width, button_y, button_width, button_height)
    return Layout.{ .card = card, .list = list, .check = check, .cancel = cancel, .open = open }
}

fn host_width(files: *app.Files) -> i32 { return host_module.width(app.hostOf(files)) }
fn host_height(files: *app.Files) -> i32 { return host_module.height(app.hostOf(files)) }

fn extensionOf(files: *app.Files) -> []const u8 {
    const bytes: [*]u8 = &files.*.chooserExtension
    return bytes[0..files.*.chooserExtensionLength]
}

// Where app `position` of the list is, from the list's top (before the
// scroll): the captions above the recommended and the other apps.
fn rowTop(files: *app.Files, position: usize) -> i32 {
    var top = app.px(files, CAPTION) + @intCast(i32, position) * app.px(files, ROW)
    if files.*.chooserRecommended > 0 && files.*.chooserRecommended < files.*.chooserCount && position >= files.*.chooserRecommended { top += app.px(files, CAPTION) }
    return top
}

fn listHeight(files: *app.Files) -> i32 {
    if files.*.chooserCount == 0 { return app.px(files, CAPTION) }
    return rowTop(files, files.*.chooserCount - 1) + app.px(files, ROW)
}

// The app under (x, y) (a place in the list), NONE when none is.
fn rowAt(files: *app.Files, layout: *const Layout, x: i32, y: i32) -> usize {
    if !ui.contains(layout.*.list, x, y) { return NONE }
    var position: usize = 0
    while position < files.*.chooserCount {
        const top = layout.*.list.y + rowTop(files, position) - files.*.chooserScroll
        if y >= top && y < top + app.px(files, ROW) { return position }
        position += 1
    }
    return NONE
}

// Opens the popup for entry `entry` (its file); `first`: its extension
// has no app yet (the choice is kept, unless it is unticked).
pub fn start(files: *app.Files, entry: usize, first: bool) -> void {
    const maybe = app.appsOf(files)
    if maybe == null { return }
    const apps = maybe.?
    app.entryPath(files, entry, &files.*.chooserPath)
    const path = app.pathText(&files.*.chooserPath)
    files.*.chooserExtensionLength = defaults.extensionOf(path, &files.*.chooserExtension)
    var recommended: usize = 0
    files.*.chooserCount = defaults.ranked(apps, defaults.typeOf(apps_module.pathEnd(&files.*.chooserPath)), &files.*.chooserApps, 64, &recommended)
    files.*.chooserRecommended = recommended
    // The app it has now, else the best.
    files.*.chooserChosen = 0
    const current = defaults.appForFile(apps, files.*.environment, path)
    var position: usize = 0
    while position < files.*.chooserCount {
        if files.*.chooserApps[position] == current { files.*.chooserChosen = position }
        position += 1
    }
    files.*.chooserAlways = first
    files.*.chooserScroll = 0
    files.*.chooserHover = NONE
    files.*.chooserClickAt = 0
    files.*.chooserClickRow = NONE
    files.*.chooserOpen = true
    app.redraw(files)
}

fn close(files: *app.Files) -> void {
    files.*.chooserOpen = false
    app.redraw(files)
}

// Opens the file with the app chosen (its extension's default from now
// on when ticked).
fn confirm(files: *app.Files) -> void {
    const maybe = app.appsOf(files)
    if maybe == null || files.*.chooserChosen >= files.*.chooserCount {
        close(files)
        return
    }
    const apps = maybe.?
    const index = files.*.chooserApps[files.*.chooserChosen]
    if index >= apps.*.count {
        close(files)
        return
    }
    const chosen = apps_module.appAt(apps, index)
    if files.*.chooserAlways {
        if defaults.choose(files.*.environment, extensionOf(files), apps_module.idOf(chosen)) {
            app.setNote(files, extensionOf(files), app.say(files, " files open with this app from now on", "-Dateien öffnen ab jetzt mit dieser App"))
        }
    }
    apps_module.launchWith(chosen, app.pathText(&files.*.chooserPath), files.*.terminal, files.*.environment)
    close(files)
}

// Keeps the chosen app in sight.
fn reveal(files: *app.Files) -> void {
    const layout = layoutOf(files)
    const top = rowTop(files, files.*.chooserChosen)
    if top - app.px(files, CAPTION) < files.*.chooserScroll { files.*.chooserScroll = top - app.px(files, CAPTION) }
    if top + app.px(files, ROW) > files.*.chooserScroll + layout.list.height { files.*.chooserScroll = top + app.px(files, ROW) - layout.list.height }
    clampScroll(files)
}

fn clampScroll(files: *app.Files) -> void {
    const layout = layoutOf(files)
    const most = listHeight(files) - layout.list.height
    if files.*.chooserScroll > most { files.*.chooserScroll = most }
    if files.*.chooserScroll < 0 { files.*.chooserScroll = 0 }
}

// An event while the popup is shown: it takes every pointer event and
// key (the window under it waits). False when it is not shown.
pub fn event(files: *app.Files, kind: u32, a: u32, b: i32) -> bool {
    if !files.*.chooserOpen { return false }
    if kind == ui_app.EVENT_CONFIGURED || kind == ui_app.EVENT_TICK || kind == ui_app.EVENT_CLOSED { return false }
    const layout = layoutOf(files)
    if kind == ui_app.EVENT_MOTION {
        files.*.pointerX = @bitCast(i32, a)
        files.*.pointerY = b
        const hover = rowAt(files, &layout, files.*.pointerX, b)
        if hover != files.*.chooserHover {
            files.*.chooserHover = hover
            app.redraw(files)
        }
        return true
    }
    if kind == ui_app.EVENT_WHEEL {
        if a == 0 {
            files.*.chooserScroll += b * app.px(files, ROW)
            clampScroll(files)
            files.*.chooserHover = rowAt(files, &layout, files.*.pointerX, files.*.pointerY)
            app.redraw(files)
        }
        return true
    }
    if kind == ui_app.EVENT_BUTTON {
        if a != app.BUTTON_LEFT || b != 1 { return true }
        const x = files.*.pointerX
        const y = files.*.pointerY
        if !ui.contains(layout.card, x, y) {
            close(files)
            return true
        }
        if ui.contains(layout.open, x, y) {
            confirm(files)
            return true
        }
        if ui.contains(layout.cancel, x, y) {
            close(files)
            return true
        }
        if ui.contains(layout.check, x, y) {
            files.*.chooserAlways = !files.*.chooserAlways
            app.redraw(files)
            return true
        }
        const row = rowAt(files, &layout, x, y)
        if row != NONE {
            const now = @intCast(usize, std.time.milliseconds())
            const again = row == files.*.chooserClickRow && now >= files.*.chooserClickAt && now - files.*.chooserClickAt < 450
            files.*.chooserChosen = row
            files.*.chooserClickRow = row
            files.*.chooserClickAt = now
            if again { confirm(files) } else { app.redraw(files) }
        }
        return true
    }
    if kind == ui_app.EVENT_KEY {
        app.trackModifier(files, a, b != 0)
        if b == 0 { return true }
        if a == app.KEY_ESCAPE || a == app.KEY_BACK {
            close(files)
        } else if a == app.KEY_ENTER || a == app.KEY_KP_ENTER {
            confirm(files)
        } else if a == KEY_SPACE {
            files.*.chooserAlways = !files.*.chooserAlways
        } else if a == app.KEY_UP && files.*.chooserChosen > 0 {
            files.*.chooserChosen -= 1
            reveal(files)
        } else if a == app.KEY_DOWN && files.*.chooserChosen + 1 < files.*.chooserCount {
            files.*.chooserChosen += 1
            reveal(files)
        }
        app.redraw(files)
        return true
    }
    return kind == ui_app.EVENT_LEAVE || kind == ui_app.EVENT_DRAG_MOTION || kind == ui_app.EVENT_DROP
}

// A button drawn as std.ui's (the popup takes its own clicks).
fn button(files: *app.Files, canvas: *app.Canvas, area: ui.Rect, label: []const u8, primary: bool) -> void {
    const theme = app.themeOf(files)
    const hover = ui.contains(area, files.*.pointerX, files.*.pointerY)
    const fill = if primary { (if hover { theme.*.primaryHover } else { theme.*.primary }) } else { (if hover { theme.*.buttonHover } else { theme.*.button }) }
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius, fill)
    const font = app.bodyOf(files)
    text_module.drawText(canvas, font, label, area.x + (area.width - text_module.measure(font, label)) / 2, controls.textTop(font, area.y, area.height), if primary { theme.*.onAccent } else { theme.*.text }, 0)
}

pub fn draw(files: *app.Files, canvas: *app.Canvas) -> void {
    if !files.*.chooserOpen { return }
    const theme = app.themeOf(files)
    const s = files.*.scale
    const layout = layoutOf(files)
    const card = layout.card
    const maybe = app.appsOf(files)
    if maybe == null { return }
    const apps = maybe.?
    // The window dimmed under it; the card.
    canvas_module.fillRect(canvas, 0, 0, host_width(files), host_height(files), canvas_module.color(110, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, card.x, card.y, card.width, card.height, app.px(files, 14), theme.*.popup)
    canvas_module.strokeRoundedRect(canvas, card.x, card.y, card.width, card.height, app.px(files, 14), s, theme.*.popupBorder)
    // What it asks, and of which file.
    const pad = app.px(files, 18)
    const title = app.say(files, "Open with", "Öffnen mit")
    text_module.drawText(canvas, app.titleOf(files), title, card.x + pad, card.y + app.px(files, 14), theme.*.text, 0)
    const path = app.pathText(&files.*.chooserPath)
    var name_start = path.length
    while name_start > 0 && path[name_start - 1] != 47 { name_start -= 1 }
    controls.label(app.uiOf(files), app.smallOf(files), path[name_start..path.length], card.x + pad, card.y + app.px(files, 44), theme.*.dim, card.width - pad * 2)
    // The apps, scrolled in the list's area.
    const list = layout.list
    canvas_module.fillRect(canvas, list.x, list.y - s, list.width, s, theme.*.divider)
    // (Only what lies wholly in the list is drawn: the canvas does not cut.)
    const recommended = files.*.chooserRecommended
    const count = files.*.chooserCount
    const caption_height = app.px(files, CAPTION)
    if recommended > 0 && files.*.chooserScroll == 0 {
        controls.label(app.uiOf(files), app.smallOf(files), app.say(files, "Recommended", "Empfohlen"), list.x + app.px(files, 10), list.y + app.px(files, 6), theme.*.dim, list.width)
    }
    const caption_y = list.y + (if recommended > 0 { rowTop(files, recommended) - caption_height } else { 0 }) - files.*.chooserScroll
    if recommended < count && caption_y >= list.y && caption_y + caption_height <= ui.bottom(list) {
        controls.label(app.uiOf(files), app.smallOf(files), if recommended > 0 { app.say(files, "Other apps", "Andere Apps") } else { app.say(files, "All apps", "Alle Apps") }, list.x + app.px(files, 10), caption_y + app.px(files, 6), theme.*.dim, list.width)
    }
    var position: usize = 0
    while position < count {
        const y = list.y + rowTop(files, position) - files.*.chooserScroll
        if y >= list.y && y + app.px(files, ROW) <= ui.bottom(list) {
            const row = ui.rect(list.x, y, list.width, app.px(files, ROW) - app.px(files, 2))
            const chosen = position == files.*.chooserChosen
            if chosen {
                const accent = theme.*.accent
                canvas_module.fillRoundedRect(canvas, row.x, row.y, row.width, row.height, app.px(files, 8), canvas_module.color(90, (accent >> 16) & 255, (accent >> 8) & 255, accent & 255))
            } else if position == files.*.chooserHover {
                canvas_module.fillRoundedRect(canvas, row.x, row.y, row.width, row.height, app.px(files, 8), theme.*.hover)
            }
            const shown = apps_module.appAt(apps, files.*.chooserApps[position])
            const icon = app.px(files, ICON)
            const icon_x = row.x + app.px(files, 10)
            const icon_y = row.y + (row.height - icon) / 2
            if apps_module.loadIcon(apps, shown, @intCast(usize, icon)) {
                canvas_module.drawImage(canvas, apps_module.imageOf(shown), icon_x, icon_y, icon, 255)
            } else {
                canvas_module.fillRoundedRect(canvas, icon_x, icon_y, icon, icon, app.px(files, 6), apps_module.tileColor(apps_module.nameOf(shown)))
            }
            const label_x = icon_x + icon + app.px(files, 12)
            controls.label(app.uiOf(files), app.bodyOf(files), apps_module.nameOf(shown), label_x, controls.textTop(app.bodyOf(files), row.y, row.height), theme.*.text, ui.right(row) - label_x - app.px(files, 8))
        }
        position += 1
    }
    canvas_module.fillRect(canvas, list.x, ui.bottom(list), list.width, s, theme.*.divider)
    // Always for this extension.
    const check = layout.check
    controls.drawCheckBox(app.uiOf(files), check.x, check.y + (check.height - app.px(files, 14)) / 2, if files.*.chooserAlways { controls.CHECK_ON } else { controls.CHECK_OFF }, theme.*.accent)
    var label: [96]u8 = undefined
    const bytes: [*]u8 = &label
    var length: usize = 0
    const extension = extensionOf(files)
    if extension.length <= 1 {
        length = std.text.append(bytes, 0, 90, app.say(files, "Always use for files without an extension", "Immer für Dateien ohne Endung verwenden"))
    } else {
        length = std.text.append(bytes, 0, 90, app.say(files, "Always use for ", "Immer für "))
        length = std.text.append(bytes, length, 90, extension)
        length = std.text.append(bytes, length, 90, app.say(files, " files", "-Dateien verwenden"))
    }
    controls.label(app.uiOf(files), app.bodyOf(files), bytes[0..length], check.x + app.px(files, 24), controls.textTop(app.bodyOf(files), check.y, check.height), theme.*.text, check.width - app.px(files, 24))
    button(files, canvas, layout.cancel, app.say(files, "Cancel", "Abbrechen"), false)
    button(files, canvas, layout.open, app.say(files, "Open", "Öffnen"), true)
}
