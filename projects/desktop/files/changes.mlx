// Changing files (in the background) and the menu (part of main.mlx, split from it).
const std = @import("std")
const field = @import("std.ui.field")
const apps_module = @import("../shared/apps.mlx")
const host_module = @import("std.ui.host")
const platform = @import("std.platform")
const ui = @import("std.ui")
const menu_module = @import("../shared/menu.mlx")
const places = @import("../shared/places.mlx")
const pins_module = @import("../shared/pins.mlx")
const app = @import("./main.mlx")
const folder_module = @import("./folder.mlx")
const input_module = @import("./input.mlx")
const drawing_module = @import("./drawing.mlx")

// ---------------------------------------------------------------------------
// Changing files (std.fs: copied, moved and removed by the app
// itself; the folder is read again after) and a command for the terminal

const Script = struct {
    bytes: [32768]u8
    length: usize
}

fn scriptAdd(script: *Script, text: []const u8) -> void {
    for byte in text {
        if script.*.length < app.SCRIPT - 2 {
            script.*.bytes[script.*.length] = byte
            script.*.length += 1
        }
    }
}

fn scriptQuoted(script: *Script, text: []const u8) -> void {
    scriptAdd(script, "'")
    for byte in text {
        if byte == 39 {
            scriptAdd(script, "'\\''")
        } else if script.*.length < app.SCRIPT - 2 {
            script.*.bytes[script.*.length] = byte
            script.*.length += 1
        }
    }
    scriptAdd(script, "'")
}


// Moves the selected items into the trash (in the trash: deletes them).
pub fn trashSelected(files: *app.Files) -> void {
    if files.*.inTrash {
        deleteSelected(files)
        return
    }
    var failed: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if app.entryAt(files, at).*.selected {
            var path: app.Path = undefined
            app.entryPath(files, at, &path)
            if !places.trash(files.*.environment, app.pathText(&path)) { failed += 1 }
        }
        index += 1
    }
    if failed > 0 { app.setNote(files, app.say(files, "Some items could not be moved to the trash", "Manches konnte nicht in den Papierkorb"), "") }
    folder_module.reload(files)
}

// In the trash: deletes the selected items for good, with what the trash
// knows of them.
fn deleteSelected(files: *app.Files) -> void {
    var failed: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if app.entryAt(files, at).*.selected {
            var path: app.Path = undefined
            app.entryPath(files, at, &path)
            if std.fs.removeTree(apps_module.pathEnd(&path)) {
                infoPath(files, at, &path)
                _ = std.fs.delete(apps_module.pathEnd(&path))
            } else {
                failed += 1
            }
        }
        index += 1
    }
    if failed > 0 { app.setNote(files, app.say(files, "Some items could not be deleted", "Manches konnte nicht gelöscht werden"), "") }
    folder_module.reload(files)
}

// The trash's note on entry `index` (Trash/info/NAME.trashinfo).
fn infoPath(files: *app.Files, index: usize, into: *app.Path) -> void {
    app.copyPath(into, app.pathOf(files))
    app.parentOf(into)
    apps_module.pathAdd(into, "/info/")
    apps_module.pathAdd(into, app.nameOf(files, app.entryAt(files, index)))
    apps_module.pathAdd(into, ".trashinfo")
}

fn hexValue(byte: u8) -> u32 { return @intCast(u32, std.text.hexValue(byte)) }

// Puts the selected items of the trash back where they were (the Path=
// line of their note, %XX decoded), not over anything there now.
fn restoreSelected(files: *app.Files) -> void {
    var failed: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if app.entryAt(files, at).*.selected {
            var info: app.Path = undefined
            infoPath(files, at, &info)
            var target: app.Path = undefined
            apps_module.pathClear(&target)
            const file = std.fs.open(apps_module.pathEnd(&info), 0, 0)
            if std.fs.isValid(file) {
                var buffer: [4096]u8 = undefined
                const bytes: [*]u8 = &buffer
                const read = std.fs.read(file, bytes, 4096)
                _ = std.fs.close(file)
                var line: usize = 0
                const length = if read > 0 { @intCast(usize, read) } else { 0 }
                while line + 5 < length {
                    if (line == 0 || bytes[line - 1] == 10) && bytes[line] == 80 && bytes[line + 1] == 97 && bytes[line + 2] == 116 && bytes[line + 3] == 104 && bytes[line + 4] == 61 {
                        var at_byte = line + 5
                        while at_byte < length && bytes[at_byte] != 10 && bytes[at_byte] != 13 && target.length < 1020 {
                            if bytes[at_byte] == 37 && at_byte + 2 < length && hexValue(bytes[at_byte + 1]) < 16 && hexValue(bytes[at_byte + 2]) < 16 {
                                target.bytes[target.length] = @intCast(u8, hexValue(bytes[at_byte + 1]) * 16 + hexValue(bytes[at_byte + 2]))
                                at_byte += 3
                            } else {
                                target.bytes[target.length] = bytes[at_byte]
                                at_byte += 1
                            }
                            target.length += 1
                        }
                        line = length
                    }
                    line += 1
                }
            }
            var restored = false
            if target.length > 1 && target.bytes[0] == 47 {
                var source: app.Path = undefined
                app.entryPath(files, at, &source)
                var parent: app.Path = undefined
                app.copyPath(&parent, &target)
                app.parentOf(&parent)
                places.makeDirectories(&parent)
                if std.fs.moveTree(apps_module.pathEnd(&source), apps_module.pathEnd(&target)) {
                    _ = std.fs.delete(apps_module.pathEnd(&info))
                    restored = true
                }
            }
            if !restored { failed += 1 }
        }
        index += 1
    }
    if failed > 0 { app.setNote(files, app.say(files, "Some items could not be put back", "Manches konnte nicht zurückgelegt werden"), "") }
    folder_module.reload(files)
}

// Copies (or cuts) the selected items' paths.
pub fn copySelected(files: *app.Files, cut: bool) -> void {
    files.*.clipLength = 0
    files.*.clipCount = 0
    files.*.clipCut = cut
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if app.entryAt(files, at).*.selected {
            var path: app.Path = undefined
            app.entryPath(files, at, &path)
            if files.*.clipLength + path.length + 1 < app.CLIP {
                for byte in app.pathText(&path) {
                    files.*.clip[files.*.clipLength] = byte
                    files.*.clipLength += 1
                }
                files.*.clip[files.*.clipLength] = 0
                files.*.clipLength += 1
                files.*.clipCount += 1
            }
        }
        index += 1
    }
    publishCopied(files)
}

// The types other apps take copied files as: GNOME's file managers
// ("copy" or "cut", then a URI a line), KDE's (a URI list, and whether
// it was a cut), and any program's (a URI list, or the paths as text).
const GNOME_FILES = "x-special/gnome-copied-files"
const KDE_CUT = "application/x-kde-cutselection"
const URI_LIST = "text/uri-list"
const PLAIN_UTF8 = "text/plain;charset=utf-8"
const PLAIN = "text/plain"
const COPIED_BYTES: usize = 65536

// The copied paths into `into` after `header`, as file:// URIs or as
// they are, `separator` after each (but the last, unless `trailing`).
fn copiedList(files: *app.Files, into: [*]u8, header: []const u8, uris: bool, separator: []const u8, trailing: bool) -> usize {
    var length: usize = 0
    for byte in header {
        into[length] = byte
        length += 1
    }
    const clip = app.fieldBytes(files, @offsetOf(app.Files, "clip"))
    var at: usize = 0
    while at < files.*.clipLength {
        var end = at
        while clip[end] != 0 { end += 1 }
        const path = clip[at..end]
        at = end + 1
        // Room for the item at its longest, and a separator on each side.
        if length + 7 + path.length * 3 + separator.length * 2 > COPIED_BYTES { break }
        if length > header.length && !trailing {
            for byte in separator {
                into[length] = byte
                length += 1
            }
        }
        if uris {
            length = places.addFileUri(into, length, COPIED_BYTES, path)
        } else {
            for byte in path {
                into[length] = byte
                length += 1
            }
        }
        if trailing {
            for byte in separator {
                into[length] = byte
                length += 1
            }
        }
    }
    return length
}

// What was copied, on the system clipboard for every other app too.
fn publishCopied(files: *app.Files) -> void {
    const host = app.hostOf(files)
    if files.*.clipCount == 0 { return }
    var buffer: [65536]u8 = undefined
    host_module.beginClipboard(host)
    var length = copiedList(files, &buffer, if files.*.clipCut { "cut\n" } else { "copy\n" }, true, "\n", false)
    var fits = host_module.addClipboard(host, GNOME_FILES, buffer[0..length])
    length = copiedList(files, &buffer, "", true, "\r\n", true)
    fits = fits && host_module.addClipboard(host, URI_LIST, buffer[0..length])
    if files.*.clipCut { fits = fits && host_module.addClipboard(host, KDE_CUT, "1") }
    length = copiedList(files, &buffer, "", false, "\n", false)
    fits = fits && host_module.addClipboard(host, PLAIN_UTF8, buffer[0..length])
    fits = fits && host_module.addClipboard(host, PLAIN, buffer[0..length])
    if fits { _ = host_module.publishClipboard(host) }
}

// Whether a paste has something to paste: files another app copied, or
// what this one did.
pub fn canPaste(files: *app.Files) -> bool {
    const host = app.hostOf(files)
    if host_module.clipboardIsOurs(host) { return files.*.clipCount > 0 }
    return host_module.clipboardHas(host, GNOME_FILES) || host_module.clipboardHas(host, URI_LIST) || host_module.clipboardHas(host, PLAIN_UTF8) || host_module.clipboardHas(host, PLAIN)
}

// The path a line of a list names (a file:// URI, or an absolute path)
// into `into`; false for any other line.
fn linePath(line: []const u8, into: *app.Path) -> bool {
    if places.uriPath(line, 0, into) { return true }
    if line.length == 0 || line[0] != 47 || line.length >= 1020 { return false }
    apps_module.pathClear(into)
    apps_module.pathAdd(into, line)
    return true
}

// Pastes what another app copied: each path on the lines of the list
// (after the first `skip` lines), moved for a cut. The number that
// failed.
fn pasteList(files: *app.Files, list: []const u8, skip: usize, moving: bool) -> usize {
    var failed: usize = 0
    var start: usize = 0
    var line: usize = 0
    while start < list.length {
        var end = start
        while end < list.length && list[end] != 10 { end += 1 }
        var stop = end
        if stop > start && list[stop - 1] == 13 { stop -= 1 }
        var path: app.Path = undefined
        if line >= skip && linePath(list[start..stop], &path) {
            if !places.transfer(app.pathText(&path), app.pathText(app.pathOf(files)), moving) { failed += 1 }
        }
        start = end + 1
        line += 1
    }
    return failed
}

// Pastes the system clipboard's files when another app put them there;
// false when it holds none.
fn pasteOthers(files: *app.Files) -> bool {
    const host = app.hostOf(files)
    var failed: usize = 0
    if host_module.clipboardHas(host, GNOME_FILES) {
        const list = host_module.readClipboard(host, GNOME_FILES)
        const cut = list.length >= 3 && std.text.same(list[0..3], "cut")
        failed = pasteList(files, list, 1, cut)
    } else if host_module.clipboardHas(host, URI_LIST) {
        const cut = host_module.clipboardHas(host, KDE_CUT) && std.text.same(host_module.readClipboard(host, KDE_CUT), "1")
        failed = pasteList(files, host_module.readClipboard(host, URI_LIST), 0, cut)
    } else if host_module.clipboardHas(host, PLAIN_UTF8) {
        failed = pasteList(files, host_module.readClipboard(host, PLAIN_UTF8), 0, false)
    } else if host_module.clipboardHas(host, PLAIN) {
        failed = pasteList(files, host_module.readClipboard(host, PLAIN), 0, false)
    } else {
        return false
    }
    if failed > 0 { app.setNote(files, app.say(files, "Some items could not be pasted", "Manches konnte nicht eingefügt werden"), "") }
    folder_module.reload(files)
    return true
}

// Copies (or moves, after a cut) what was copied into the folder shown;
// nothing is overwritten (a name taken gets a number).
pub fn paste(files: *app.Files) -> void {
    if files.*.inTrash { return }
    if !host_module.clipboardIsOurs(app.hostOf(files)) {
        if pasteOthers(files) { return }
    }
    if files.*.clipCount == 0 { return }
    const clip = app.fieldBytes(files, @offsetOf(app.Files, "clip"))
    var failed: usize = 0
    var at: usize = 0
    while at < files.*.clipLength {
        var end = at
        while clip[end] != 0 { end += 1 }
        if !places.transfer(clip[at..end], app.pathText(app.pathOf(files)), files.*.clipCut) { failed += 1 }
        at = end + 1
    }
    if failed > 0 { app.setNote(files, app.say(files, "Some items could not be pasted", "Manches konnte nicht eingefügt werden"), "") }
    if files.*.clipCut {
        // A cut is pasted once: the clipboard holds it no more.
        files.*.clipCount = 0
        files.*.clipLength = 0
        host_module.clearClipboard(app.hostOf(files))
    }
    folder_module.reload(files)
}

// Makes "untitled folder" (or "untitled folder 2" and so on) and renames it.
pub fn newFolder(files: *app.Files) -> void {
    if files.*.inTrash { return }
    const base = app.say(files, "untitled folder", "Neuer Ordner")
    var number: usize = 1
    var path: app.Path = undefined
    var name: [64]u8 = undefined
    var name_length: usize = 0
    while number < 100 {
        name_length = 0
        for byte in base {
            name[name_length] = byte
            name_length += 1
        }
        if number > 1 {
            name[name_length] = 32
            name_length += 1
            if number >= 10 {
                name[name_length] = @intCast(u8, 48 + number / 10)
                name_length += 1
            }
            name[name_length] = @intCast(u8, 48 + number % 10)
            name_length += 1
        }
        app.copyPath(&path, app.pathOf(files))
        if path.length > 1 { apps_module.pathAdd(&path, "/") }
        apps_module.pathAdd(&path, name[0..name_length])
        if std.fs.makeDir(apps_module.pathEnd(&path), 493) {
            folder_module.load(files)
            var index: usize = 0
            while index < files.*.count {
                if std.text.same(app.nameOf(files, app.entryAt(files, index)), name[0..name_length]) {
                    input_module.selectOnly(files, index)
                    drawing_module.revealCursor(files)
                    startRename(files, index)
                }
                index += 1
            }
            return
        }
        var status: std.fs.Stat = undefined
        if std.fs.status(apps_module.pathEnd(&path), &status) != 0 {
            app.setNote(files, app.say(files, "Can't make a folder here", "Hier kann kein Ordner angelegt werden"), "")
            return
        }
        number += 1
    }
}

pub fn startRename(files: *app.Files, index: usize) -> void {
    if files.*.inTrash { return }
    files.*.editing = index
    files.*.editLength = 0
    for byte in app.nameOf(files, app.entryAt(files, index)) {
        if files.*.editLength < app.EDIT {
            files.*.edit[files.*.editLength] = byte
            files.*.editLength += 1
        }
    }
    // The caret before the extension, as the Finder does.
    const extension = folder_module.extensionOf(app.editText(files))
    files.*.caret = if extension.length > 0 && !app.entryAt(files, index).*.directory { files.*.editLength - extension.length - 1 } else { files.*.editLength }
    files.*.editSelected = files.*.caret > 0
    files.*.searchFocused = false
}

// Renames the entry to what was typed (nothing happens for an empty name,
// one with a slash, or one that is taken).
pub fn finishRename(files: *app.Files) -> void {
    const index = files.*.editing
    files.*.editing = app.NONE
    if index == app.NONE || index >= files.*.count { return }
    const name = app.editText(files)
    if name.length == 0 || std.text.same(name, app.nameOf(files, app.entryAt(files, index))) { return }
    for byte in name {
        if byte == 47 {
            app.setNote(files, app.say(files, "A name can't have a slash", "Ein Name darf keinen Schrägstrich enthalten"), "")
            return
        }
    }
    var old: app.Path = undefined
    app.entryPath(files, index, &old)
    var new: app.Path = undefined
    app.copyPath(&new, app.pathOf(files))
    if new.length > 1 { apps_module.pathAdd(&new, "/") }
    apps_module.pathAdd(&new, name)
    var status: std.fs.Stat = undefined
    if std.fs.statusAt(apps_module.pathEnd(&new), &status, true) == 0 {
        app.setNote(files, app.say(files, "The name is taken: ", "Der Name ist vergeben: "), name)
        return
    }
    if !std.fs.rename(apps_module.pathEnd(&old), apps_module.pathEnd(&new)) {
        app.setNote(files, app.say(files, "Can't rename ", "Kann nicht umbenannt werden: "), app.nameOf(files, app.entryAt(files, index)))
        return
    }
    // Read again with the new name selected.
    var kept: [256]u8 = undefined
    var kept_length: usize = 0
    for byte in name {
        kept[kept_length] = byte
        kept_length += 1
    }
    folder_module.load(files)
    var at: usize = 0
    while at < files.*.count {
        if std.text.same(app.nameOf(files, app.entryAt(files, at)), kept[0..kept_length]) {
            input_module.selectOnly(files, at)
            drawing_module.revealCursor(files)
        }
        at += 1
    }
}

// Removes the selected part of the name (what is before the caret).
fn cutEditSelection(files: *app.Files) -> void {
    if !files.*.editSelected { return }
    files.*.editSelected = false
    const removed = files.*.caret
    var index = removed
    while index < files.*.editLength {
        files.*.edit[index - removed] = files.*.edit[index]
        index += 1
    }
    files.*.editLength -= removed
    files.*.caret = 0
}

// A key while renaming.
pub fn editKey(files: *app.Files, key: u32) -> void {
    if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        finishRename(files)
        return
    }
    if key == app.KEY_ESCAPE {
        files.*.editing = app.NONE
        return
    }
    if (key == app.KEY_LEFT || key == app.KEY_HOME) && files.*.editSelected {
        files.*.editSelected = false
        files.*.caret = 0
        return
    }
    if key == app.KEY_RIGHT || key == app.KEY_END { files.*.editSelected = false }
    if key == app.KEY_LEFT && files.*.caret > 0 {
        files.*.caret -= 1
        while files.*.caret > 0 && files.*.edit[files.*.caret] >= 128 && files.*.edit[files.*.caret] < 192 { files.*.caret -= 1 }
        return
    }
    if key == app.KEY_RIGHT && files.*.caret < files.*.editLength {
        files.*.caret += 1
        while files.*.caret < files.*.editLength && files.*.edit[files.*.caret] >= 128 && files.*.edit[files.*.caret] < 192 { files.*.caret += 1 }
        return
    }
    if key == app.KEY_HOME {
        files.*.caret = 0
        return
    }
    if key == app.KEY_END {
        files.*.caret = files.*.editLength
        return
    }
    if (key == app.KEY_BACKSPACE || key == app.KEY_DELETE) && files.*.editSelected {
        cutEditSelection(files)
        return
    }
    if key == app.KEY_BACKSPACE || key == app.KEY_DELETE {
        // One character (all its UTF-8 bytes) before or after the caret.
        var start = files.*.caret
        var end = files.*.caret
        if key == app.KEY_BACKSPACE {
            if start == 0 { return }
            start -= 1
            while start > 0 && files.*.edit[start] >= 128 && files.*.edit[start] < 192 { start -= 1 }
        } else {
            if end >= files.*.editLength { return }
            end += 1
            while end < files.*.editLength && files.*.edit[end] >= 128 && files.*.edit[end] < 192 { end += 1 }
        }
        var index = end
        while index < files.*.editLength {
            files.*.edit[index - (end - start)] = files.*.edit[index]
            index += 1
        }
        files.*.editLength -= end - start
        files.*.caret = start
        return
    }
    const typed = host_module.typed(app.hostOf(files))
    if typed.length == 0 || app.modifiers(files) & (app.CONTROL | app.ALT) != 0 { return }
    if typed[0] < 32 { return }
    cutEditSelection(files)
    if files.*.editLength + typed.length > app.EDIT { return }
    var index = files.*.editLength
    while index > files.*.caret {
        index -= 1
        files.*.edit[index + typed.length] = files.*.edit[index]
    }
    var at: usize = 0
    while at < typed.length {
        files.*.edit[files.*.caret + at] = typed[at]
        at += 1
    }
    files.*.editLength += typed.length
    files.*.caret += typed.length
}

// A key while the search field has the keyboard.
pub fn searchKey(files: *app.Files, key: u32) -> void {
    if key == app.KEY_ESCAPE {
        field.clear(app.searchOf(files))
        files.*.searchFocused = false
    } else if key == app.KEY_ENTER || key == app.KEY_KP_ENTER || key == app.KEY_DOWN {
        files.*.searchFocused = false
        if files.*.shownCount > 0 && files.*.cursor == app.NONE { input_module.selectOnly(files, files.*.shown[0]) }
    } else {
        // Typing, Backspace, the arrows, a selection (std.ui.field).
        if field.fieldKey(app.searchOf(files), key, app.uiModifiers(files), host_module.typed(app.hostOf(files))) != field.KEY_EDITED { return }
    }
    files.*.scroll = 0
    folder_module.buildShown(files)
}

// Typing selects the first name that starts with what was typed lately.
pub fn typeAhead(files: *app.Files) -> void {
    const text = host_module.typed(app.hostOf(files))
    if text.length == 0 || text[0] <= 32 { return }
    const now = std.time.milliseconds()
    if now > files.*.typedAt + 1000 { files.*.typedLength = 0 }
    files.*.typedAt = now
    var at: usize = 0
    while at < text.length && files.*.typedLength < 32 {
        files.*.typed[files.*.typedLength] = text[at]
        files.*.typedLength += 1
        at += 1
    }
    const typed = app.fieldBytes(files, @offsetOf(app.Files, "typed"))[0..files.*.typedLength]
    var index: usize = 0
    while index < files.*.shownCount {
        const name = app.nameOf(files, app.entryAt(files, files.*.shown[index]))
        if name.length >= typed.length && apps_module.containsText(name[0..typed.length], typed) {
            input_module.selectOnly(files, files.*.shown[index])
            drawing_module.revealCursor(files)
            return
        }
        index += 1
    }
}

// What a drag at (x, y) would go into: a folder entry not among the ones
// dragged, a place in the sidebar (the phone's storage only with access),
// a part of the path; else the folder shown.
pub fn dropAt(files: *app.Files, x: i32, y: i32) -> void {
    const hit = drawing_module.hitAt(files, x, y)
    files.*.dropHover = app.NONE
    files.*.dropPlace = app.NONE
    if hit < files.*.shownCount {
        const at = files.*.shown[hit]
        if app.entryAt(files, at).*.directory && !app.entryAt(files, at).*.selected { files.*.dropHover = at }
    } else if hit >= app.HIT_PLACE && hit < app.HIT_PLACE + files.*.placeCount {
        const kind = files.*.placeKinds[hit - app.HIT_PLACE]
        if kind != app.PLACE_STORAGE || host_module.sharedStorageAllowed(app.hostOf(files)) { files.*.dropPlace = hit }
    } else if hit >= app.HIT_CRUMB && hit < app.HIT_CRUMB + 256 && !files.*.inTrash {
        files.*.dropPlace = hit
    }
}

// The folder files dropped now go into, into `into`: the place or the
// part of the path under the pointer, the folder entry, else the folder
// shown. True for the trash's place (they go to the trash).
fn dropTarget(files: *app.Files, into: *app.Path) -> bool {
    const place = files.*.dropPlace
    if place >= app.HIT_PLACE && place < app.HIT_PLACE + app.MAX_PLACES {
        if files.*.placeKinds[place - app.HIT_PLACE] == app.PLACE_TRASH { return true }
        app.copyPath(into, app.placePathAt(files, place - app.HIT_PLACE))
    } else if place != app.NONE {
        var end: usize = 0
        _ = drawing_module.crumb(files, place - app.HIT_CRUMB, &end)
        app.copyPath(into, app.pathOf(files))
        into.*.length = end
    } else if files.*.dropHover != app.NONE {
        app.entryPath(files, files.*.dropHover, into)
    } else {
        app.copyPath(into, app.pathOf(files))
    }
    return false
}

// Files dropped on the window: moved when they came from this window,
// else copied; nothing is overwritten. On the trash's place they go to
// the trash (apps' desktop entries dragged from the launcher stay).
pub fn dropFiles(files: *app.Files) -> void {
    const list = host_module.dropData(app.hostOf(files))
    var target: app.Path = undefined
    const to_trash = dropTarget(files, &target)
    const onto_place = files.*.dropPlace != app.NONE
    files.*.dropping = false
    files.*.dropHover = app.NONE
    files.*.dropPlace = app.NONE
    if to_trash {
        var total: usize = 0
        var each: app.Path = undefined
        while places.uriPath(list, total, &each) { total += 1 }
        if places.moveToTrash(list, files.*.environment) < total { app.setNote(files, app.say(files, "Some items could not be moved to the trash", "Manches konnte nicht in den Papierkorb"), "") }
        folder_module.reload(files)
        return
    }
    if files.*.inTrash && !onto_place { return }
    var failed: usize = 0
    var path: app.Path = undefined
    var line: usize = 0
    while places.uriPath(list, line, &path) {
        if !places.transfer(app.pathText(&path), app.pathText(&target), files.*.dragging) { failed += 1 }
        line += 1
    }
    if failed > 0 { app.setNote(files, app.say(files, "Some items could not be copied", "Manches konnte nicht kopiert werden"), "") }
    folder_module.reload(files)
}

// Adds a pinned folder to the dock (~/.config/mlx/dock-folders).
fn addToDock(files: *app.Files, index: usize) -> void {
    var path: app.Path = undefined
    app.entryPath(files, index, &path)
    var pinned: app.Path = undefined
    apps_module.pathClear(&pinned)
    const text = app.pathText(&path)
    if app.underHome(files, text) {
        apps_module.pathAdd(&pinned, "~")
        apps_module.pathAdd(&pinned, text[app.homeLength(files)..text.length])
    } else {
        apps_module.pathAdd(&pinned, text)
    }
    var pins: pins_module.Pins = undefined
    if !pins_module.read(files.*.environment, pins_module.FOLDERS, files.*.allocator, &pins) {
        pins.count = 0
        pins_module.insert(&pins, "~/Downloads", 0)
    }
    if pins_module.find(&pins, app.pathText(&pinned)) == pins.count { pins_module.insert(&pins, app.pathText(&pinned), pins.count) }
    _ = pins_module.write(files.*.environment, pins_module.FOLDERS, &pins)
}

fn openTerminal(files: *app.Files) -> void {
    var command: app.Path = undefined
    apps_module.pathClear(&command)
    apps_module.pathAdd(&command, "cd ")
    var quoted: Script = undefined
    quoted.length = 0
    scriptQuoted(&quoted, app.pathText(app.pathOf(files)))
    apps_module.pathAdd(&command, quoted.bytes[0..quoted.length])
    apps_module.pathAdd(&command, " && exec \"${SHELL:-/bin/sh}\"")
    var terminal = files.*.terminal
    if @intFromPtr(terminal) == 0 { unsafe { terminal = @ptrCast([*]const u8, "mlx-terminal") } }
    apps_module.run(app.pathText(&command), terminal, files.*.environment)
}

// ---------------------------------------------------------------------------
// The menu

// The menu over the window, below and right of where it was opened (moved
// in when the window ends sooner).
pub fn menuArea(files: *app.Files) -> ui.Rect {
    const menu = app.menuOf(files)
    const width = @intCast(i32, menu_module.width(menu, app.bodyOf(files)))
    const height = @intCast(i32, menu_module.height(menu))
    const host = app.hostOf(files)
    var x = files.*.menuX
    var y = files.*.menuY
    if x + width > host_module.width(host) { x = host_module.width(host) - width }
    if y + height > host_module.height(host) { y = host_module.height(host) - height }
    if x < 0 { x = 0 }
    if y < 0 { y = 0 }
    return ui.rect(x, y, width, height)
}

pub fn drawMenu(files: *app.Files, canvas: *app.Canvas) -> void {
    if !files.*.menuOpen { return }
    const area = menuArea(files)
    app.menuOf(files).*.light = host_module.lightness(app.hostOf(files))
    menu_module.drawAt(app.menuOf(files), canvas, app.bodyOf(files), area.x, area.y, area.width, area.height)
}

pub fn closeMenu(files: *app.Files) -> void {
    files.*.menuOpen = false
    files.*.menuPressed = false
    app.redraw(files)
}

pub fn openMenu(files: *app.Files, entry: usize) -> void {
    const menu = app.menuOf(files)
    menu_module.clear(menu)
    menu_module.setScale(menu, files.*.scale)
    files.*.menuEntry = entry
    if entry != app.NONE {
        if files.*.inTrash {
            menu_module.add(menu, app.say(files, "Put Back", "Zurücklegen"), app.MENU_RESTORE, 0)
            menu_module.add(menu, app.say(files, "Delete Immediately", "Sofort löschen"), app.MENU_DELETE, 0)
        } else {
            menu_module.add(menu, app.say(files, "Open", "Öffnen"), app.MENU_OPEN, 0)
            menu_module.separator(menu)
            menu_module.add(menu, app.say(files, "Rename", "Umbenennen"), app.MENU_RENAME, 0)
            menu_module.add(menu, app.say(files, "Copy", "Kopieren"), app.MENU_COPY, 0)
            menu_module.add(menu, app.say(files, "Cut", "Ausschneiden"), app.MENU_CUT, 0)
            if app.entryAt(files, entry).*.directory && !platform.ANDROID { menu_module.add(menu, app.say(files, "Add to Dock", "Zum Dock hinzufügen"), app.MENU_DOCK, 0) }
            menu_module.separator(menu)
            menu_module.add(menu, app.say(files, "Move to Trash", "In den Papierkorb legen"), app.MENU_TRASH, 0)
        }
    } else if files.*.inTrash {
        menu_module.add(menu, app.say(files, "Empty Trash", "Papierkorb leeren"), app.MENU_EMPTY_TRASH, 0)
    } else {
        menu_module.add(menu, app.say(files, "New Folder", "Neuer Ordner"), app.MENU_NEW_FOLDER, 0)
        if canPaste(files) { menu_module.add(menu, app.say(files, "Paste", "Einfügen"), app.MENU_PASTE, 0) }
        if !platform.ANDROID { menu_module.add(menu, app.say(files, "Open in Terminal", "Im Terminal öffnen"), app.MENU_TERMINAL, 0) }
        menu_module.separator(menu)
        menu_module.add(menu, if files.*.listView { app.say(files, "View as Icons", "Als Symbole") } else { app.say(files, "View as List", "Als Liste") }, app.MENU_VIEW, 0)
        menu_module.add(menu, app.say(files, "Sort by Name", "Nach Name sortieren"), app.MENU_SORT, app.SORT_NAME)
        menu_module.add(menu, app.say(files, "Sort by Date", "Nach Datum sortieren"), app.MENU_SORT, app.SORT_DATE)
        menu_module.add(menu, app.say(files, "Sort by Size", "Nach Größe sortieren"), app.MENU_SORT, app.SORT_SIZE)
        menu_module.add(menu, app.say(files, "Sort by Kind", "Nach Art sortieren"), app.MENU_SORT, app.SORT_KIND)
        menu_module.add(menu, if files.*.showHidden { app.say(files, "Hide Hidden Files", "Versteckte Dateien ausblenden") } else { app.say(files, "Show Hidden Files", "Versteckte Dateien zeigen") }, app.MENU_HIDDEN, 0)
    }
    files.*.menuX = files.*.pointerX + 1
    files.*.menuY = files.*.pointerY + 1
    files.*.menuOpen = true
    files.*.menuPressed = false
    app.redraw(files)
}

pub fn setSort(files: *app.Files, key: usize) -> void {
    if files.*.sortKey == key {
        files.*.sortReversed = !files.*.sortReversed
    } else {
        files.*.sortKey = key
        files.*.sortReversed = false
    }
    folder_module.sortEntries(files)
    folder_module.buildShown(files)
}

pub fn choose(files: *app.Files, index: usize) -> void {
    const menu = app.menuOf(files)
    const kind = menu_module.kindAt(menu, index)
    const value = menu_module.valueAt(menu, index)
    const entry = files.*.menuEntry
    closeMenu(files)
    if kind == app.MENU_OPEN { folder_module.openSelected(files) }
    if kind == app.MENU_RENAME && entry != app.NONE { startRename(files, entry) }
    if kind == app.MENU_COPY { copySelected(files, false) }
    if kind == app.MENU_CUT { copySelected(files, true) }
    if kind == app.MENU_PASTE { paste(files) }
    if kind == app.MENU_TRASH { trashSelected(files) }
    if kind == app.MENU_DELETE { deleteSelected(files) }
    if kind == app.MENU_RESTORE { restoreSelected(files) }
    if kind == app.MENU_EMPTY_TRASH { places.emptyTrash(files.*.environment) }
    if kind == app.MENU_NEW_FOLDER { newFolder(files) }
    if kind == app.MENU_TERMINAL { openTerminal(files) }
    if kind == app.MENU_DOCK && entry != app.NONE { addToDock(files, entry) }
    if kind == app.MENU_VIEW { setView(files, !files.*.listView) }
    if kind == app.MENU_SORT { setSort(files, value) }
    if kind == app.MENU_HIDDEN {
        files.*.showHidden = !files.*.showHidden
        folder_module.buildShown(files)
    }
    app.redraw(files)
}

pub fn setView(files: *app.Files, list: bool) -> void {
    files.*.listView = list
    drawing_module.clampScroll(files)
    drawing_module.revealCursor(files)
}
