// libpulse's small utilities: growing text, ASCII and UTF-8 checks, error
// texts, names (user, host, program), paths, sleeping, times
// (struct timeval: seconds and microseconds, 16 bytes) and the names of
// encodings and directions.
const std = @import("std")
const c = @import("./c.mlx")

// ---------------------------------------------------------------------------
// Text that grows in C memory (its result is the program's to free)

pub const Text = struct {
    buffer: usize
    length: usize
    room: usize
}

pub fn text() -> Text { return Text.{ .buffer = 0, .length = 0, .room = 0 } }

pub fn addByte(writing: *Text, value: u8) -> void {
    if writing.*.length + 2 > writing.*.room {
        const room = if writing.*.room == 0 { 64 } else { writing.*.room * 2 }
        const grown = c.grow(writing.*.buffer, room)
        if grown == 0 { return }
        writing.*.buffer = grown
        writing.*.room = room
    }
    c.put8(writing.*.buffer, writing.*.length, value)
    writing.*.length += 1
    c.put8(writing.*.buffer, writing.*.length, 0)
}

pub fn add(writing: *Text, part: []const u8) -> void {
    var index: usize = 0
    while index < part.length {
        addByte(writing, part[index])
        index += 1
    }
}

pub fn addNumber(writing: *Text, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        addByte(writing, digits[count])
    }
}

pub fn addSigned(writing: *Text, value: i64) -> void {
    if value < 0 {
        addByte(writing, 45)
        addNumber(writing, @intCast(u64, 0 - value))
    } else {
        addNumber(writing, @intCast(u64, value))
    }
}

// The C string (an empty one when nothing was added).
pub fn finish(writing: *Text) -> usize {
    if writing.*.buffer == 0 { return c.alloc(1) }
    return writing.*.buffer
}

pub fn hexDigit(value: u8) -> u8 { return if value < 10 { 48 + value } else { 87 + value } }

pub fn isHex(digit: u8) -> bool { return (digit >= 48 && digit <= 57) || (digit >= 97 && digit <= 102) || (digit >= 65 && digit <= 70) }

pub fn hexValue(digit: u8) -> u32 {
    if digit >= 48 && digit <= 57 { return @intCast(u32, digit - 48) }
    if digit >= 97 && digit <= 102 { return @intCast(u32, digit - 87) }
    if digit >= 65 && digit <= 70 { return @intCast(u32, digit - 55) }
    return 0
}

// ---------------------------------------------------------------------------
// ASCII and UTF-8

pub fn asciiValid(value: []const u8) -> bool {
    var index: usize = 0
    while index < value.length {
        if value[index] >= 128 { return false }
        index += 1
    }
    return true
}

fn unicode(point: u32) -> bool {
    if point >= 1114112 { return false }
    if (point & 4294965248) == 55296 { return false }
    if point >= 64976 && point <= 65007 { return false }
    return (point & 65534) != 65534
}

// The length of the UTF-8 sequence at `index`, 0 when it is not one.
fn sequence(value: []const u8, index: usize) -> usize {
    const first = value[index]
    if first < 128 { return 1 }
    var size: usize = 0
    var point: u32 = 0
    var least: u32 = 0
    if (first & 224) == 192 {
        size = 2
        least = 128
        point = @intCast(u32, first & 31)
    } else if (first & 240) == 224 {
        size = 3
        least = 2048
        point = @intCast(u32, first & 15)
    } else if (first & 248) == 240 {
        size = 4
        least = 65536
        point = @intCast(u32, first & 7)
    } else {
        return 0
    }
    if index + size > value.length { return 0 }
    var at: usize = 1
    while at < size {
        const next = value[index + at]
        if (next & 192) != 128 { return 0 }
        point = (point << 6) | @intCast(u32, next & 63)
        at += 1
    }
    if point < least || !unicode(point) { return 0 }
    return size
}

pub fn utf8Valid(value: []const u8) -> bool {
    var index: usize = 0
    while index < value.length {
        const size = sequence(value, index)
        if size == 0 { return false }
        index += size
    }
    return true
}

// A C copy with what is not UTF-8 as '_'.
pub fn utf8Filter(value: []const u8) -> usize {
    var writing = text()
    var index: usize = 0
    while index < value.length {
        const size = sequence(value, index)
        if size == 0 {
            addByte(&writing, 95)
            index += 1
        } else {
            add(&writing, value[index..index + size])
            index += size
        }
    }
    return finish(&writing)
}

// A C copy without what is not ASCII.
pub fn asciiFilter(value: []const u8) -> usize {
    var writing = text()
    var index: usize = 0
    while index < value.length {
        if value[index] < 128 { addByte(&writing, value[index]) }
        index += 1
    }
    return finish(&writing)
}

// ---------------------------------------------------------------------------
// Errors (pa_error_code_t)

pub const OK: i32 = 0
pub const ERR_ACCESS: i32 = 1
pub const ERR_COMMAND: i32 = 2
pub const ERR_INVALID: i32 = 3
pub const ERR_EXIST: i32 = 4
pub const ERR_NOENTITY: i32 = 5
pub const ERR_CONNECTIONREFUSED: i32 = 6
pub const ERR_PROTOCOL: i32 = 7
pub const ERR_TIMEOUT: i32 = 8
pub const ERR_AUTHKEY: i32 = 9
pub const ERR_INTERNAL: i32 = 10
pub const ERR_CONNECTIONTERMINATED: i32 = 11
pub const ERR_KILLED: i32 = 12
pub const ERR_INVALIDSERVER: i32 = 13
pub const ERR_MODINITFAILED: i32 = 14
pub const ERR_BADSTATE: i32 = 15
pub const ERR_NODATA: i32 = 16
pub const ERR_VERSION: i32 = 17
pub const ERR_TOOLARGE: i32 = 18
pub const ERR_NOTSUPPORTED: i32 = 19
pub const ERR_UNKNOWN: i32 = 20
pub const ERR_NOEXTENSION: i32 = 21
pub const ERR_OBSOLETE: i32 = 22
pub const ERR_NOTIMPLEMENTED: i32 = 23
pub const ERR_FORKED: i32 = 24
pub const ERR_IO: i32 = 25
pub const ERR_BUSY: i32 = 26
pub const ERR_MAX: i32 = 27

pub fn strerror(given: i32) -> usize {
    const code = if given < 0 { 0 - given } else { given }
    if code == OK { return c.literal("OK") }
    if code == ERR_ACCESS { return c.literal("Access denied") }
    if code == ERR_COMMAND { return c.literal("Unknown command") }
    if code == ERR_INVALID { return c.literal("Invalid argument") }
    if code == ERR_EXIST { return c.literal("Entity exists") }
    if code == ERR_NOENTITY { return c.literal("No such entity") }
    if code == ERR_CONNECTIONREFUSED { return c.literal("Connection refused") }
    if code == ERR_PROTOCOL { return c.literal("Protocol error") }
    if code == ERR_TIMEOUT { return c.literal("Timeout") }
    if code == ERR_AUTHKEY { return c.literal("No authentication key") }
    if code == ERR_INTERNAL { return c.literal("Internal error") }
    if code == ERR_CONNECTIONTERMINATED { return c.literal("Connection terminated") }
    if code == ERR_KILLED { return c.literal("Entity killed") }
    if code == ERR_INVALIDSERVER { return c.literal("Invalid server") }
    if code == ERR_MODINITFAILED { return c.literal("Module initialization failed") }
    if code == ERR_BADSTATE { return c.literal("Bad state") }
    if code == ERR_NODATA { return c.literal("No data") }
    if code == ERR_VERSION { return c.literal("Incompatible protocol version") }
    if code == ERR_TOOLARGE { return c.literal("Too large") }
    if code == ERR_NOTSUPPORTED { return c.literal("Not supported") }
    if code == ERR_UNKNOWN { return c.literal("Unknown error code") }
    if code == ERR_NOEXTENSION { return c.literal("No such extension") }
    if code == ERR_OBSOLETE { return c.literal("Obsolete functionality") }
    if code == ERR_NOTIMPLEMENTED { return c.literal("Missing implementation") }
    if code == ERR_FORKED { return c.literal("Client forked") }
    if code == ERR_IO { return c.literal("Input/Output error") }
    if code == ERR_BUSY { return c.literal("Device or resource busy") }
    return 0
}

// ---------------------------------------------------------------------------
// Names

const SYS_read: usize = 0
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_readlink: usize = 89
const SYS_uname: usize = 63
const SYS_getuid: usize = 102

// Copies `value` into the C buffer (at most `capacity` - 1 bytes and a
// NUL); the buffer, or 0 when there is nothing to copy.
pub fn copyOut(buffer: usize, capacity: usize, value: []const u8) -> usize {
    if buffer == 0 || capacity == 0 || value.length == 0 { return 0 }
    var writing = c.out(buffer, capacity)
    c.append(&writing, value)
    return buffer
}

// A field of the password database's line for this user (0: name, 5:
// home), into the buffer.
fn passwordField(buffer: usize, capacity: usize, wanted: usize) -> usize {
    var path: [12]u8 = [12]u8{ 47, 101, 116, 99, 47, 112, 97, 115, 115, 119, 100, 0 } // /etc/passwd
    const file = std.linux.syscall3(SYS_open, @intFromPtr(&path), 524288, 0)
    if file < 0 { return 0 }
    const uid = @intCast(u64, std.linux.syscall0(SYS_getuid))
    var data: [65536]u8 = undefined
    var size: usize = 0
    while size < 65536 {
        const got = std.linux.syscall3(SYS_read, @bitCast(usize, file), @intFromPtr(&data) + size, 65536 - size)
        if got <= 0 { break }
        size += @bitCast(usize, got)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, file))
    var lines: [*]const u8 = undefined
    unsafe { lines = @ptrCast([*]const u8, &data) }
    const all = lines[0..size]
    var start: usize = 0
    while start < size {
        var end = start
        while end < size && all[end] != 10 { end += 1 }
        const line = all[start..end]
        // name:password:uid:gid:gecos:home:shell
        var fields: [7]usize = undefined
        var ends: [7]usize = undefined
        var field: usize = 0
        fields[0] = 0
        var at: usize = 0
        while at < line.length && field < 7 {
            if line[at] == 58 {
                ends[field] = at
                field += 1
                if field < 7 { fields[field] = at + 1 }
            }
            at += 1
        }
        if field < 7 { ends[field] = line.length }
        if field >= 5 {
            var ok = false
            const id = c.parseNumber(line[fields[2]..ends[2]], &ok)
            if ok && id == uid { return copyOut(buffer, capacity, line[fields[wanted]..ends[wanted]]) }
        }
        start = end + 1
    }
    return 0
}

pub fn userName(buffer: usize, capacity: usize) -> usize {
    const fromEnvironment = c.environment("USER")
    if fromEnvironment.length > 0 { return copyOut(buffer, capacity, fromEnvironment) }
    const login = c.environment("LOGNAME")
    if login.length > 0 { return copyOut(buffer, capacity, login) }
    const found = passwordField(buffer, capacity, 0)
    if found != 0 { return found }
    return copyOut(buffer, capacity, "root")
}

pub fn homeDirectory(buffer: usize, capacity: usize) -> usize {
    const home = c.environment("HOME")
    if home.length > 0 { return copyOut(buffer, capacity, home) }
    return passwordField(buffer, capacity, 5)
}

pub fn hostName(buffer: usize, capacity: usize) -> usize {
    // struct utsname: six fields of 65 bytes; the node name is the second.
    var names: [390]u8 = undefined
    if std.linux.syscall1(SYS_uname, @intFromPtr(&names)) != 0 { return 0 }
    return copyOut(buffer, capacity, c.slice(@intFromPtr(&names) + 65))
}

// The program's file name (without its directory).
pub fn binaryName(buffer: usize, capacity: usize) -> usize {
    var path: [15]u8 = [15]u8{ 47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 101, 120, 101, 0 } // /proc/self/exe
    var target: [4096]u8 = undefined
    const got = std.linux.syscall3(SYS_readlink, @intFromPtr(&path), @intFromPtr(&target), 4095)
    if got <= 0 { return 0 }
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &target) }
    const full = bytes[0..@bitCast(usize, got)]
    return copyOut(buffer, capacity, full[fileNameStart(full)..full.length])
}

pub fn fileNameStart(path: []const u8) -> usize {
    var index = path.length
    while index > 0 {
        if path[index - 1] == 47 { return index }
        index -= 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Time

pub const USEC_INVALID: u64 = 18446744073709551615
pub const USEC_PER_SEC: u64 = 1000000
// tv_usec's flag for a time on the monotonic clock (PulseAudio's
// PA_TIMEVAL_RTCLOCK).
pub const RTCLOCK: u64 = 1073741824
const SECONDS_MAX: u64 = 9223372036854775807

pub fn sleep(milliseconds: u64) -> void {
    var time: [2]u64 = [2]u64{ milliseconds / 1000, (milliseconds % 1000) * 1000000 }
    const slept = std.linux.syscall2(35, @intFromPtr(&time), 0)
}

pub fn seconds(time: usize) -> u64 { return c.get64(time, 0) }

pub fn micro(time: usize) -> u64 { return c.get64(time, 8) }

pub fn storeTime(time: usize, value: u64) -> void {
    if value == USEC_INVALID {
        c.put64(time, 0, SECONDS_MAX)
        c.put64(time, 8, USEC_PER_SEC - 1)
        return
    }
    c.put64(time, 0, value / USEC_PER_SEC)
    c.put64(time, 8, value % USEC_PER_SEC)
}

pub fn loadTime(time: usize) -> u64 {
    if time == 0 { return USEC_INVALID }
    return seconds(time) * USEC_PER_SEC + micro(time)
}

pub fn now(time: usize) -> usize {
    storeTime(time, c.realtime())
    return time
}

pub fn compare(first: usize, second: usize) -> i32 {
    if seconds(first) < seconds(second) { return -1 }
    if seconds(first) > seconds(second) { return 1 }
    if micro(first) < micro(second) { return -1 }
    if micro(first) > micro(second) { return 1 }
    return 0
}

pub fn difference(first: usize, second: usize) -> u64 {
    var later = first
    var earlier = second
    if compare(first, second) < 0 {
        later = second
        earlier = first
    }
    return loadTime(later) - loadTime(earlier)
}

pub fn addTime(time: usize, value: u64) -> usize {
    const whole = value / USEC_PER_SEC
    if seconds(time) > SECONDS_MAX - whole {
        c.put64(time, 0, SECONDS_MAX)
        c.put64(time, 8, USEC_PER_SEC - 1)
        return time
    }
    var second = seconds(time) + whole
    var part = micro(time) + value % USEC_PER_SEC
    while part >= USEC_PER_SEC {
        second += 1
        part -= USEC_PER_SEC
    }
    c.put64(time, 0, second)
    c.put64(time, 8, part)
    return time
}

pub fn subtractTime(time: usize, value: u64) -> usize {
    const whole = value / USEC_PER_SEC
    const part = value % USEC_PER_SEC
    if seconds(time) < whole {
        storeTime(time, 0)
        return time
    }
    var second = seconds(time) - whole
    if micro(time) >= part {
        c.put64(time, 0, second)
        c.put64(time, 8, micro(time) - part)
        return time
    }
    if second == 0 {
        storeTime(time, 0)
        return time
    }
    c.put64(time, 0, second - 1)
    c.put64(time, 8, micro(time) + USEC_PER_SEC - part)
    return time
}

// A timeval's time on the monotonic clock: marked ones are, others are
// wall-clock times (moved by the clocks' difference now); USEC_INVALID for
// none.
pub fn monotonicOf(time: usize) -> u64 {
    if time == 0 { return USEC_INVALID }
    if micro(time) & RTCLOCK != 0 { return seconds(time) * USEC_PER_SEC + (micro(time) & (RTCLOCK - 1)) }
    const wall = loadTime(time)
    const wallNow = c.realtime()
    const monotonicNow = c.monotonic()
    if wall >= wallNow { return monotonicNow + (wall - wallNow) }
    const ago = wallNow - wall
    return if ago > monotonicNow { 0 } else { monotonicNow - ago }
}

// A monotonic time as a marked timeval (or, `marked` false, as wall-clock
// time for a main loop that is not this library's).
pub fn storeMonotonic(time: usize, value: u64, marked: bool) -> usize {
    if value == USEC_INVALID {
        storeTime(time, value)
        return time
    }
    if marked {
        storeTime(time, value)
        c.put64(time, 8, micro(time) | RTCLOCK)
        return time
    }
    const monotonicNow = c.monotonic()
    const wallNow = c.realtime()
    storeTime(time, if value >= monotonicNow { wallNow + (value - monotonicNow) } else { wallNow - (monotonicNow - value) })
    return time
}

// ---------------------------------------------------------------------------
// Encodings and directions

pub const ENCODING_ANY: i32 = 0
pub const ENCODING_PCM: i32 = 1
pub const ENCODING_MAX: i32 = 9
pub const ENCODING_INVALID: i32 = -1

pub fn encodingName(encoding: i32) -> usize {
    if encoding == 0 { return c.literal("any") }
    if encoding == 1 { return c.literal("pcm") }
    if encoding == 2 { return c.literal("ac3-iec61937") }
    if encoding == 3 { return c.literal("eac3-iec61937") }
    if encoding == 4 { return c.literal("mpeg-iec61937") }
    if encoding == 5 { return c.literal("dts-iec61937") }
    if encoding == 6 { return c.literal("mpeg2-aac-iec61937") }
    if encoding == 7 { return c.literal("truehd-iec61937") }
    if encoding == 8 { return c.literal("dtshd-iec61937") }
    return 0
}

pub fn encodingFromName(name: []const u8) -> i32 {
    var encoding: i32 = 0
    while encoding < ENCODING_MAX {
        if c.same(c.slice(encodingName(encoding)), name) { return encoding }
        encoding += 1
    }
    return ENCODING_INVALID
}

pub const DIRECTION_OUTPUT: i32 = 1
pub const DIRECTION_INPUT: i32 = 2

pub fn directionValid(direction: i32) -> bool { return direction == 1 || direction == 2 || direction == 3 }

pub fn directionName(direction: i32) -> usize {
    if direction == DIRECTION_INPUT { return c.literal("input") }
    if direction == DIRECTION_OUTPUT { return c.literal("output") }
    if direction == 3 { return c.literal("bidirectional") }
    return c.literal("invalid")
}
