// ALSA's PCM and control plugin for MLX Audio, in Mlx: alsa-plugins' pulse
// plugins (pcm_pulse.c, ctl_pulse.c) done again, with this directory's
// libpulse built in. ALSA programs (aplay, games, Wine) open `default`,
// which asound.conf points at this plugin; it plays and records through a
// PulseAudio stream, and its mixer is the default sink's and source's
// volume and mute.
//
//   mlx4 --plugin --library libasound.so.2 projects/desktop/libpulse/alsa.mlx \
//       -o libasound_module_pcm_pulse.so
//
// One object holds both, as type mlx and as type pulse (installed in
// alsa-lib's plugin directory as libasound_module_pcm_pulse.so and
// libasound_module_ctl_pulse.so it is alsa-plugins' pulse plugin). PCM:
// an ioplug whose ring buffer is the stream's (the pointer moves on as the
// server asks for, or delivers, bytes), poll descriptor a pipe the
// stream's callbacks make readable. Control: four elements (capture and
// master volume and switch).
//
// The layouts are alsa-lib 1.2's (include/pcm_ioplug.h,
// control_external.h): snd_pcm_ioplug_t is 120 bytes, its callbacks 160;
// snd_ctl_ext_t is 280, its callbacks 200.
const std = @import("std")
const c = @import("./c.mlx")
const core = @import("./core.mlx")
const contexts = @import("./context.mlx")
const streams = @import("./stream.mlx")
const threaded = @import("./threaded.mlx")
const introspect = @import("./introspect.mlx")
const wire = @import("./wire.mlx")
const util = @import("./util.mlx")
const sample = @import("./sample.mlx")
const maps = @import("./channels.mlx")
const volumes = @import("./volume.mlx")

// libpulse's functions the plugins use, on this directory's modules (the
// plugin carries its own client: it works whichever libpulse the program
// has loaded, or none).
fn pa_threaded_mainloop_new() -> usize { return threaded.new() }

fn pa_threaded_mainloop_free(loop: usize) -> void { threaded.free(loop) }

fn pa_threaded_mainloop_start(loop: usize) -> i32 { return threaded.start(loop) }

fn pa_threaded_mainloop_stop(loop: usize) -> void { threaded.stop(loop) }

fn pa_threaded_mainloop_lock(loop: usize) -> void { threaded.lock(loop) }

fn pa_threaded_mainloop_unlock(loop: usize) -> void { threaded.unlock(loop) }

fn pa_threaded_mainloop_wait(loop: usize) -> void { threaded.wait(loop) }

fn pa_threaded_mainloop_signal(loop: usize, accept: i32) -> void { threaded.signal(loop, accept != 0) }

fn pa_threaded_mainloop_get_api(loop: usize) -> usize { return threaded.loopOf(loop) }

fn pa_context_new(api: usize, name: usize) -> usize { return contexts.new(api, name, 0) }

fn pa_context_set_state_callback(owner: usize, callback: usize, userdata: usize) -> void {
    c.putPointer(owner, core.C_STATE_CALLBACK, callback)
    c.putPointer(owner, core.C_STATE_USERDATA, userdata)
}

fn pa_context_set_subscribe_callback(owner: usize, callback: usize, userdata: usize) -> void {
    c.putPointer(owner, core.C_SUBSCRIBE_CALLBACK, callback)
    c.putPointer(owner, core.C_SUBSCRIBE_USERDATA, userdata)
}

fn pa_context_connect(owner: usize, server: usize, flags: u32, spawn: usize) -> i32 { return contexts.connect(owner, server, flags) }

fn pa_context_disconnect(owner: usize) -> void { contexts.disconnect(owner) }

fn pa_context_unref(owner: usize) -> void { core.unref(owner) }

fn pa_context_get_state(owner: usize) -> i32 { return @bitCast(i32, core.state(owner)) }

fn pa_context_errno(owner: usize) -> i32 { return @bitCast(i32, c.get32(owner, core.C_ERROR)) }

fn pa_context_subscribe(owner: usize, mask: u32, callback: usize, userdata: usize) -> usize { return contexts.subscribe(owner, mask, callback, userdata) }

fn pa_context_get_server_info(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.serverInfo(owner, callback, userdata) }

fn pa_context_get_sink_info_by_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return introspect.byName(owner, introspect.GET_SINK_INFO, name, core.R_SINK_INFO, callback, userdata) }

fn pa_context_get_source_info_by_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return introspect.byName(owner, introspect.GET_SOURCE_INFO, name, core.R_SOURCE_INFO, callback, userdata) }

fn pa_context_set_sink_volume_by_name(owner: usize, name: usize, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_VOLUME, wire.INVALID, name, introspect.VALUE_VOLUME, levels, callback, userdata) }

fn pa_context_set_source_volume_by_name(owner: usize, name: usize, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_VOLUME, wire.INVALID, name, introspect.VALUE_VOLUME, levels, callback, userdata) }

fn pa_context_set_sink_mute_by_name(owner: usize, name: usize, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_MUTE, wire.INVALID, name, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

fn pa_context_set_source_mute_by_name(owner: usize, name: usize, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_MUTE, wire.INVALID, name, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

fn pa_stream_new(owner: usize, name: usize, spec: usize, map: usize) -> usize { return streams.new(owner, name, spec, map, 0, 0, 0) }

fn pa_stream_unref(own: usize) -> void { core.streamUnref(own) }

fn pa_stream_get_state(own: usize) -> i32 { return @bitCast(i32, core.streamState(own)) }

fn setStreamCallback(own: usize, field: usize, callback: usize, userdata: usize) -> void {
    c.putPointer(own, field, callback)
    c.putPointer(own, field + 8, userdata)
}

fn pa_stream_set_state_callback(own: usize, callback: usize, userdata: usize) -> void { setStreamCallback(own, core.S_STATE_CALLBACK, callback, userdata) }

fn pa_stream_set_read_callback(own: usize, callback: usize, userdata: usize) -> void { setStreamCallback(own, core.S_READ_CALLBACK, callback, userdata) }

fn pa_stream_set_write_callback(own: usize, callback: usize, userdata: usize) -> void { setStreamCallback(own, core.S_WRITE_CALLBACK, callback, userdata) }

fn pa_stream_set_underflow_callback(own: usize, callback: usize, userdata: usize) -> void { setStreamCallback(own, core.S_UNDERFLOW_CALLBACK, callback, userdata) }

fn pa_stream_set_latency_update_callback(own: usize, callback: usize, userdata: usize) -> void { setStreamCallback(own, core.S_LATENCY_CALLBACK, callback, userdata) }

fn pa_stream_connect_playback(own: usize, device: usize, attributes: usize, flags: u32, levels: usize, sync: usize) -> i32 { return streams.connect(own, core.PLAYBACK, device, attributes, flags, levels, sync) }

fn pa_stream_connect_record(own: usize, device: usize, attributes: usize, flags: u32) -> i32 { return streams.connect(own, core.RECORD, device, attributes, flags, 0, 0) }

fn pa_stream_disconnect(own: usize) -> i32 { return streams.disconnect(own) }

fn pa_stream_writable_size(own: usize) -> usize { return streams.writableSize(own) }

fn pa_stream_readable_size(own: usize) -> usize { return streams.readableSize(own) }

fn pa_stream_write(own: usize, data: usize, length: usize, free: usize, offset: i64, seek: u32) -> i32 { return streams.write(own, data, length, free, data, offset, seek) }

fn pa_stream_peek(own: usize, data: usize, length: usize) -> i32 { return streams.peek(own, data, length) }

fn pa_stream_drop(own: usize) -> i32 { return streams.drop(own) }

fn pa_stream_cork(own: usize, corked: i32, callback: usize, userdata: usize) -> usize { return streams.cork(own, corked != 0, callback, userdata) }

fn pa_stream_flush(own: usize, callback: usize, userdata: usize) -> usize { return streams.flush(own, callback, userdata) }

fn pa_stream_trigger(own: usize, callback: usize, userdata: usize) -> usize { return streams.trigger(own, callback, userdata) }

fn pa_stream_drain(own: usize, callback: usize, userdata: usize) -> usize { return streams.drain(own, callback, userdata) }

fn pa_stream_get_latency(own: usize, result: usize, negative: usize) -> i32 { return streams.getLatency(own, result, negative) }

fn pa_stream_get_underflow_index(own: usize) -> i64 { return @bitCast(i64, c.get64(own, core.S_UNDERFLOW_INDEX)) }

fn pa_operation_get_state(operation: usize) -> i32 { return @bitCast(i32, core.operationState(operation)) }

fn pa_operation_unref(operation: usize) -> void { core.operationUnref(operation) }

fn pa_channel_map_init_auto(map: usize, count: u32, def: i32) -> usize { return if maps.initAuto(map, count, @bitCast(u32, def)) { map } else { 0 } }

fn pa_usec_to_bytes(usec: u64, spec: usize) -> usize { return sample.usecToBytes(usec, sample.read(spec)) }

fn pa_cvolume_equal(first: usize, second: usize) -> i32 { return if volumes.equal(first, second) { 1 } else { 0 } }

fn pa_get_binary_name(buffer: usize, capacity: usize) -> usize { return util.binaryName(buffer, capacity) }

extern("c") fn snd_pcm_ioplug_create(io: usize, name: usize, stream: i32, mode: i32) -> i32
extern("c") fn snd_pcm_ioplug_delete(io: usize) -> i32
extern("c") fn snd_pcm_ioplug_set_param_list(io: usize, kind: i32, count: u32, list: usize) -> i32
extern("c") fn snd_pcm_ioplug_set_param_minmax(io: usize, kind: i32, least: u32, most: u32) -> i32
extern("c") fn snd_pcm_ioplug_set_state(io: usize, state: i32) -> i32
extern("c") fn snd_pcm_sw_params_get_start_threshold(params: usize, threshold: usize) -> i32
extern("c") fn snd_pcm_open_fallback(pcm: usize, root: usize, fallback: usize, name: usize, stream: i32, mode: i32) -> i32
extern("c") fn snd_ctl_ext_create(ext: usize, name: usize, mode: i32) -> i32
extern("c") fn snd_ctl_open_fallback(ctl: usize, root: usize, fallback: usize, name: usize, mode: i32) -> i32
extern("c") fn snd_ctl_elem_id_set_interface(id: usize, iface: i32) -> void
extern("c") fn snd_ctl_elem_id_set_name(id: usize, name: usize) -> void
extern("c") fn snd_ctl_elem_id_get_numid(id: usize) -> u32
extern("c") fn snd_ctl_elem_id_get_name(id: usize) -> usize
extern("c") fn snd_config_iterator_first(node: usize) -> usize
extern("c") fn snd_config_iterator_next(iterator: usize) -> usize
extern("c") fn snd_config_iterator_end(node: usize) -> usize
extern("c") fn snd_config_iterator_entry(iterator: usize) -> usize
extern("c") fn snd_config_get_id(node: usize, id: usize) -> i32
extern("c") fn snd_config_get_string(node: usize, text: usize) -> i32
extern("c") fn snd_config_get_bool(node: usize) -> i32

const EINVAL: i32 = -22
const EIO: i32 = -5
const EPIPE: i32 = -32
const EAGAIN: i32 = -11
const ENOMEM: i32 = -12
const EBADFD: i32 = -77
const ECONNREFUSED: i32 = -111
const ERR_NODATA: i32 = 16

const POLLIN: u16 = 1
const POLLOUT: u16 = 4

// ---------------------------------------------------------------------------
// The connection both plugins share (alsa-plugins' snd_pulse_t): the loop,
// the context, and a pipe whose reading end is the plugin's poll
// descriptor (the loop's thread writes to wake the program).

const PULSE: usize = 24
const P_LOOP: usize = 0
const P_CONTEXT: usize = 8
const P_MAIN: usize = 16
const P_THREAD: usize = 20

fn pulseLoop(pulse: usize) -> usize { return c.getPointer(pulse, P_LOOP) }

fn pulseContext(pulse: usize) -> usize { return c.getPointer(pulse, P_CONTEXT) }

fn contextGood(state: i32) -> bool { return state >= 1 && state <= 4 }

fn streamGood(state: i32) -> bool { return state >= 1 && state <= 2 }

fn checkConnection(pulse: usize) -> i32 {
    if pulse == 0 || pulseContext(pulse) == 0 || pulseLoop(pulse) == 0 { return EBADFD }
    if !contextGood(pa_context_get_state(pulseContext(pulse))) { return EIO }
    return 0
}

fn activate(pulse: usize) -> void {
    var byte: u8 = 120
    const written = std.linux.syscall3(1, @intCast(usize, c.get32(pulse, P_THREAD)), @intFromPtr(&byte), 1)
}

fn deactivate(pulse: usize) -> void {
    var bytes: [16]u8 = undefined
    while std.linux.syscall3(0, @intCast(usize, c.get32(pulse, P_MAIN)), @intFromPtr(&bytes), 16) > 0 {}
}

export fn mlx_alsa_context_state(context: usize, pulse: usize) -> void {
    const state = pa_context_get_state(context)
    if !contextGood(state) { activate(pulse) }
    if state == 4 || !contextGood(state) { pa_threaded_mainloop_signal(pulseLoop(pulse), 0) }
}

export fn mlx_alsa_context_success(context: usize, success: i32, pulse: usize) -> void { pa_threaded_mainloop_signal(pulseLoop(pulse), 0) }

fn waitOperation(pulse: usize, operation: usize) -> i32 {
    while true {
        const checked = checkConnection(pulse)
        if checked < 0 { return checked }
        if pa_operation_get_state(operation) != 0 { break }
        pa_threaded_mainloop_wait(pulseLoop(pulse))
    }
    return 0
}

fn pulseFree(pulse: usize) -> void {
    if pulseLoop(pulse) != 0 { pa_threaded_mainloop_stop(pulseLoop(pulse)) }
    if pulseContext(pulse) != 0 {
        pa_context_disconnect(pulseContext(pulse))
        pa_context_unref(pulseContext(pulse))
    }
    if pulseLoop(pulse) != 0 { pa_threaded_mainloop_free(pulseLoop(pulse)) }
    c.close(@intCast(isize, @bitCast(i32, c.get32(pulse, P_THREAD))))
    c.close(@intCast(isize, @bitCast(i32, c.get32(pulse, P_MAIN))))
    c.release(pulse)
}

fn pulseNew() -> usize {
    const pulse = c.alloc(PULSE)
    var ends: [2]i32 = [2]i32{ -1, -1 }
    // O_NONBLOCK | O_CLOEXEC
    if std.linux.syscall2(293, @intFromPtr(&ends), 526336) != 0 {
        c.release(pulse)
        return 0
    }
    c.put32(pulse, P_MAIN, @bitCast(u32, ends[0]))
    c.put32(pulse, P_THREAD, @bitCast(u32, ends[1]))
    c.putPointer(pulse, P_LOOP, pa_threaded_mainloop_new())
    if pulseLoop(pulse) == 0 {
        pulseFree(pulse)
        return 0
    }
    // "ALSA plug-in [program]"
    var program: [256]u8 = undefined
    var name: [300]u8 = undefined
    var writing = c.out(@intFromPtr(&name), 300)
    c.append(&writing, "ALSA plug-in")
    if pa_get_binary_name(@intFromPtr(&program), 256) != 0 {
        c.append(&writing, " [")
        c.append(&writing, c.slice(@intFromPtr(&program)))
        c.append(&writing, "]")
    }
    c.putPointer(pulse, P_CONTEXT, pa_context_new(pa_threaded_mainloop_get_api(pulseLoop(pulse)), @intFromPtr(&name)))
    if pulseContext(pulse) == 0 {
        pulseFree(pulse)
        return 0
    }
    pa_context_set_state_callback(pulseContext(pulse), @intFromPtr(mlx_alsa_context_state), pulse)
    if pa_threaded_mainloop_start(pulseLoop(pulse)) < 0 {
        pulseFree(pulse)
        return 0
    }
    return pulse
}

// Connects; with a fallback, quietly (no autospawn either).
fn pulseConnect(pulse: usize, server: usize, fallback: bool) -> i32 {
    if pa_context_get_state(pulseContext(pulse)) != 0 { return EBADFD }
    pa_threaded_mainloop_lock(pulseLoop(pulse))
    var good = pa_context_connect(pulseContext(pulse), server, if fallback { 1 } else { 0 }, 0) >= 0
    while good {
        const state = pa_context_get_state(pulseContext(pulse))
        if !contextGood(state) { good = false }
        if state == 4 || !good { break }
        pa_threaded_mainloop_wait(pulseLoop(pulse))
    }
    pa_threaded_mainloop_unlock(pulseLoop(pulse))
    return if good { 0 } else { ECONNREFUSED }
}

// A configuration's string fields (server, device, ...): into `values`
// by the index of their key in `keys`; -EINVAL for an unknown key.
fn configure(conf: usize, keys: []const []const u8, values: usize, underrun: *i32) -> i32 {
    var iterator = snd_config_iterator_first(conf)
    const end = snd_config_iterator_end(conf)
    while iterator != end {
        const node = snd_config_iterator_entry(iterator)
        iterator = snd_config_iterator_next(iterator)
        var id: usize = 0
        if snd_config_get_id(node, @intFromPtr(&id)) < 0 { continue }
        const key = c.slice(id)
        if c.same(key, "comment") || c.same(key, "type") || c.same(key, "hint") { continue }
        if c.same(key, "handle_underrun") {
            const value = snd_config_get_bool(node)
            if value < 0 { return EINVAL }
            underrun.* = value
            continue
        }
        var found = false
        var index: usize = 0
        while index < keys.length {
            if c.same(key, keys[index]) {
                var text: usize = 0
                if snd_config_get_string(node, @intFromPtr(&text)) < 0 { return EINVAL }
                c.putPointer(values, index * 8, if text != 0 && c.get8(text, 0) != 0 { text } else { 0 })
                found = true
            }
            index += 1
        }
        if !found { return EINVAL }
    }
    return 0
}

// ---------------------------------------------------------------------------
// PCM

const IO_SIZE: usize = 120
const IO_VERSION: usize = 0
const IO_NAME: usize = 8
const IO_POLL_FD: usize = 20
const IO_POLL_EVENTS: usize = 24
const IO_MMAP_RW: usize = 28
const IO_CALLBACK: usize = 32
const IO_PRIVATE: usize = 40
const IO_PCM: usize = 48
const IO_STREAM: usize = 56
const IO_STATE: usize = 60
const IO_FORMAT: usize = 88
const IO_CHANNELS: usize = 92
const IO_RATE: usize = 96
const IO_PERIOD: usize = 104
const IO_BUFFER: usize = 112
const IOPLUG_VERSION: u32 = 65538

// The plugin's PCM: the ioplug first, then ours.
const PCM_SIZE: usize = 392
const PULSE_OF: usize = 120
const DEVICE: usize = 128
const LAST_SIZE: usize = 136
const POINTER: usize = 144
const UNDERRUN: usize = 152
const HANDLE_UNDERRUN: usize = 156
const OFFSET: usize = 160
const WRITTEN: usize = 168
const STREAM: usize = 176
const SPEC: usize = 184
const FRAME_SIZE: usize = 200
const ATTR: usize = 208
const CALLBACKS: usize = 232

const MAXLENGTH: usize = 208
const TLENGTH: usize = 212
const PREBUF: usize = 216
const MINREQ: usize = 220
const FRAGSIZE: usize = 224

const PLAYBACK: i32 = 0
const STATE_RUNNING: i32 = 3
const STATE_XRUN: i32 = 4

fn pulseOf(pcm: usize) -> usize { return c.getPointer(pcm, PULSE_OF) }

fn streamOf(pcm: usize) -> usize { return c.getPointer(pcm, STREAM) }

fn playback(pcm: usize) -> bool { return @bitCast(i32, c.get32(pcm, IO_STREAM)) == PLAYBACK }

fn ready(pcm: usize) -> bool { return pulseOf(pcm) != 0 && pulseLoop(pulseOf(pcm)) != 0 }

fn lock(pcm: usize) -> void { pa_threaded_mainloop_lock(pulseLoop(pulseOf(pcm))) }

fn unlock(pcm: usize) -> void { pa_threaded_mainloop_unlock(pulseLoop(pulseOf(pcm))) }

fn checkStream(pcm: usize) -> i32 {
    const checked = checkConnection(pulseOf(pcm))
    if checked < 0 { return checked }
    if streamOf(pcm) == 0 { return EBADFD }
    if !streamGood(pa_stream_get_state(streamOf(pcm))) { return EIO }
    return 0
}

// The fake ring buffer's pointer moves on as room (or data) appears.
fn updatePointer(pcm: usize) -> i32 {
    var size = if playback(pcm) { pa_stream_writable_size(streamOf(pcm)) } else { pa_stream_readable_size(streamOf(pcm)) }
    if size == 18446744073709551615 { return EIO }
    if !playback(pcm) { size -= c.getPointer(pcm, OFFSET) }
    const length = @intCast(usize, c.get32(pcm, TLENGTH))
    const frame = c.getPointer(pcm, FRAME_SIZE)
    if size > length - frame { size = length - frame }
    const last = c.getPointer(pcm, LAST_SIZE)
    if size > last { c.putPointer(pcm, POINTER, (c.getPointer(pcm, POINTER) + size - last) % length) }
    c.putPointer(pcm, LAST_SIZE, size)
    return 0
}

fn checkActive(pcm: usize) -> i32 {
    if playback(pcm) {
        const room = pa_stream_writable_size(streamOf(pcm))
        if room == 18446744073709551615 { return EIO }
        return if room >= @intCast(usize, c.get32(pcm, MINREQ)) { 1 } else { 0 }
    }
    const data = pa_stream_readable_size(streamOf(pcm))
    if data == 18446744073709551615 { return EIO }
    return if data >= @intCast(usize, c.get32(pcm, FRAGSIZE)) { 1 } else { 0 }
}

fn updateActive(pcm: usize) -> i32 {
    var result = checkStream(pcm)
    if result >= 0 { result = checkActive(pcm) }
    if result != 0 { activate(pulseOf(pcm)) } else { deactivate(pulseOf(pcm)) }
    return result
}

fn waitStreamState(pcm: usize, target: i32) -> i32 {
    while true {
        const checked = checkConnection(pulseOf(pcm))
        if checked < 0 { return checked }
        if streamOf(pcm) == 0 { return EBADFD }
        const state = pa_stream_get_state(streamOf(pcm))
        if state == target { break }
        if !streamGood(state) { return EIO }
        pa_threaded_mainloop_wait(pulseLoop(pulseOf(pcm)))
    }
    return 0
}

export fn mlx_alsa_stream_success(stream: usize, success: i32, pcm: usize) -> void {
    if pulseOf(pcm) != 0 { pa_threaded_mainloop_signal(pulseLoop(pulseOf(pcm)), 0) }
}

export fn mlx_alsa_stream_state(stream: usize, pcm: usize) -> void {
    if pulseOf(pcm) == 0 { return }
    if !streamGood(pa_stream_get_state(stream)) { activate(pulseOf(pcm)) }
    pa_threaded_mainloop_signal(pulseLoop(pulseOf(pcm)), 0)
}

export fn mlx_alsa_stream_request(stream: usize, length: usize, pcm: usize) -> void {
    if pulseOf(pcm) != 0 { const active = updateActive(pcm) }
}

export fn mlx_alsa_stream_underrun(stream: usize, pcm: usize) -> void {
    if pulseOf(pcm) == 0 { return }
    if @bitCast(i64, c.get64(pcm, WRITTEN)) <= pa_stream_get_underflow_index(stream) { c.put32(pcm, UNDERRUN, 1) }
}

export fn mlx_alsa_stream_latency(stream: usize, pcm: usize) -> void {
    if pulseOf(pcm) != 0 { pa_threaded_mainloop_signal(pulseLoop(pulseOf(pcm)), 0) }
}

// Waits for two operations (the second may be missing); EIO when one
// failed to come.
fn waitBoth(pcm: usize, first: usize, second: usize) -> i32 {
    const one = waitOperation(pulseOf(pcm), first)
    var two: i32 = 0
    if second != 0 { two = waitOperation(pulseOf(pcm), second) }
    pa_operation_unref(first)
    if second != 0 { pa_operation_unref(second) }
    return if one < 0 || two < 0 { EIO } else { 0 }
}

export fn mlx_alsa_pcm_start(pcm: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var result = checkStream(pcm)
    if result >= 0 {
        const uncorked = pa_stream_cork(streamOf(pcm), 0, @intFromPtr(mlx_alsa_stream_success), pcm)
        if uncorked == 0 {
            result = EIO
        } else {
            const triggered = pa_stream_trigger(streamOf(pcm), @intFromPtr(mlx_alsa_stream_success), pcm)
            c.put32(pcm, UNDERRUN, 0)
            result = waitBoth(pcm, uncorked, triggered)
        }
    }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_stop(pcm: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var result = checkStream(pcm)
    if result >= 0 {
        const corked = pa_stream_cork(streamOf(pcm), 1, @intFromPtr(mlx_alsa_stream_success), pcm)
        if corked == 0 {
            result = EIO
        } else {
            const flushed = pa_stream_flush(streamOf(pcm), @intFromPtr(mlx_alsa_stream_success), pcm)
            if flushed == 0 {
                pa_operation_unref(corked)
                result = EIO
            } else {
                result = waitBoth(pcm, corked, flushed)
            }
        }
    }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_drain(pcm: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var result = checkStream(pcm)
    if result >= 0 {
        const drained = pa_stream_drain(streamOf(pcm), @intFromPtr(mlx_alsa_stream_success), pcm)
        result = if drained == 0 { EIO } else { waitBoth(pcm, drained, 0) }
    }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_pointer(pcm: usize) -> i64 {
    if !ready(pcm) { return @intCast(i64, EBADFD) }
    const state = @bitCast(i32, c.get32(pcm, IO_STATE))
    if state == STATE_XRUN { return @intCast(i64, EPIPE) }
    if state != STATE_RUNNING { return 0 }
    lock(pcm)
    var result: i64 = @intCast(i64, checkStream(pcm))
    if result >= 0 {
        if c.get32(pcm, UNDERRUN) != 0 || updatePointer(pcm) < 0 || c.get32(pcm, UNDERRUN) != 0 {
            result = @intCast(i64, EPIPE)
        } else {
            result = @intCast(i64, c.getPointer(pcm, POINTER) / c.getPointer(pcm, FRAME_SIZE))
        }
    }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_delay(pcm: usize, delay: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var result: i32 = 0
    var latency: u64 = 0
    while true {
        result = checkStream(pcm)
        if result < 0 { break }
        const got = pa_stream_get_latency(streamOf(pcm), @intFromPtr(&latency), 0)
        if got >= 0 { break }
        if pa_context_errno(pulseContext(pulseOf(pcm))) != ERR_NODATA {
            result = EIO
            break
        }
        pa_threaded_mainloop_wait(pulseLoop(pulseOf(pcm)))
    }
    if result >= 0 {
        const frames = pa_usec_to_bytes(latency, pcm + SPEC) / c.getPointer(pcm, FRAME_SIZE)
        c.put64(delay, 0, @intCast(u64, frames))
        result = 0
    }
    if c.get32(pcm, UNDERRUN) != 0 && @bitCast(i32, c.get32(pcm, IO_STATE)) == STATE_RUNNING { const set = snd_pcm_ioplug_set_state(pcm, STATE_XRUN) }
    unlock(pcm)
    return result
}

// The interleaved frames at `offset` in the first area.
fn areaAddress(pcm: usize, areas: usize, offset: u64) -> usize {
    const address = c.getPointer(areas, 0)
    const first = @intCast(u64, c.get32(areas, 8))
    const step = @intCast(u64, c.get32(areas, 12))
    return address + @intCast(usize, (first + step * offset) / 8)
}

export fn mlx_alsa_pcm_write(pcm: usize, areas: usize, offset: u64, size: u64) -> i64 {
    if !ready(pcm) { return @intCast(i64, EBADFD) }
    lock(pcm)
    var result: i64 = @intCast(i64, checkStream(pcm))
    if result >= 0 { result = @intCast(i64, updatePointer(pcm)) }
    if result >= 0 {
        const bytes = @intCast(usize, size) * c.getPointer(pcm, FRAME_SIZE)
        if pa_stream_write(streamOf(pcm), areaAddress(pcm, areas, offset), bytes, 0, 0, 0) < 0 {
            result = @intCast(i64, EIO)
        } else {
            c.putPointer(pcm, LAST_SIZE, c.getPointer(pcm, LAST_SIZE) - bytes)
            c.put64(pcm, WRITTEN, c.get64(pcm, WRITTEN) + @intCast(u64, bytes))
            result = @intCast(i64, updatePointer(pcm))
            if result >= 0 { result = @intCast(i64, updateActive(pcm)) }
            if result >= 0 {
                result = @intCast(i64, size)
                c.put32(pcm, UNDERRUN, 0)
            }
        }
    }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_read(pcm: usize, areas: usize, offset: u64, size: u64) -> i64 {
    if !ready(pcm) { return @intCast(i64, EBADFD) }
    lock(pcm)
    var result: i64 = @intCast(i64, checkStream(pcm))
    if result >= 0 { result = @intCast(i64, updatePointer(pcm)) }
    var left = @intCast(usize, size) * c.getPointer(pcm, FRAME_SIZE)
    var target = areaAddress(pcm, areas, offset)
    while result >= 0 && left > 0 {
        var data: usize = 0
        var length: usize = 0
        if pa_stream_peek(streamOf(pcm), @intFromPtr(&data), @intFromPtr(&length)) < 0 {
            result = @intCast(i64, EIO)
            break
        }
        if length == 0 { break }
        if data != 0 {
            data += c.getPointer(pcm, OFFSET)
            length -= c.getPointer(pcm, OFFSET)
            if length > left {
                c.putPointer(pcm, OFFSET, c.getPointer(pcm, OFFSET) + left)
                length = left
            } else {
                c.putPointer(pcm, OFFSET, 0)
            }
            c.copy(target, data, length)
        } else {
            // A hole: silence.
            c.zero(target, length)
        }
        if c.getPointer(pcm, OFFSET) == 0 { const dropped = pa_stream_drop(streamOf(pcm)) }
        target += length
        left -= length
        c.putPointer(pcm, LAST_SIZE, c.getPointer(pcm, LAST_SIZE) - length)
    }
    if result >= 0 { result = @intCast(i64, updatePointer(pcm)) }
    if result >= 0 { result = @intCast(i64, updateActive(pcm)) }
    if result >= 0 { result = @intCast(i64, size - @intCast(u64, left / c.getPointer(pcm, FRAME_SIZE))) }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_poll_revents(pcm: usize, fds: usize, count: u32, revents: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var result = checkStream(pcm)
    if result >= 0 { result = checkActive(pcm) }
    if result >= 0 {
        c.put8(revents, 0, 0)
        c.put8(revents, 1, 0)
        if result > 0 { c.put8(revents, 0, @intCast(u8, if playback(pcm) { POLLOUT } else { POLLIN })) }
        result = 0
    }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_prepare(pcm: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    if streamOf(pcm) != 0 {
        const disconnected = pa_stream_disconnect(streamOf(pcm))
        const ended = waitStreamState(pcm, 4)
        pa_stream_unref(streamOf(pcm))
        c.putPointer(pcm, STREAM, 0)
    }
    var result = checkConnection(pulseOf(pcm))
    if result >= 0 {
        // ALSA's channel order, extended with aux channels.
        var map: [132]u8 = undefined
        const at = @intFromPtr(&map)
        const count = @intCast(u32, c.get8(pcm, SPEC + 8))
        var known = count
        while known > 0 && pa_channel_map_init_auto(at, known, 1) == 0 { known -= 1 }
        var index = known
        while index < count {
            c.put32(at, 4 + @intCast(usize, index) * 4, 12 + index - known)
            index += 1
        }
        c.put8(at, 0, @intCast(u8, count))
        const name = if playback(pcm) { c.literal("ALSA Playback") } else { c.literal("ALSA Capture") }
        c.putPointer(pcm, STREAM, pa_stream_new(pulseContext(pulseOf(pcm)), name, pcm + SPEC, at))
        if streamOf(pcm) == 0 {
            result = ENOMEM
        } else {
            pa_stream_set_state_callback(streamOf(pcm), @intFromPtr(mlx_alsa_stream_state), pcm)
            pa_stream_set_latency_update_callback(streamOf(pcm), @intFromPtr(mlx_alsa_stream_latency), pcm)
            // AUTO_TIMING_UPDATE | INTERPOLATE_TIMING | EARLY_REQUESTS
            const flags: u32 = 16394
            var connected: i32 = 0
            if playback(pcm) {
                pa_stream_set_write_callback(streamOf(pcm), @intFromPtr(mlx_alsa_stream_request), pcm)
                if c.get32(pcm, HANDLE_UNDERRUN) != 0 { pa_stream_set_underflow_callback(streamOf(pcm), @intFromPtr(mlx_alsa_stream_underrun), pcm) }
                connected = pa_stream_connect_playback(streamOf(pcm), c.getPointer(pcm, DEVICE), pcm + ATTR, flags, 0, 0)
            } else {
                pa_stream_set_read_callback(streamOf(pcm), @intFromPtr(mlx_alsa_stream_request), pcm)
                connected = pa_stream_connect_record(streamOf(pcm), c.getPointer(pcm, DEVICE), pcm + ATTR, flags)
            }
            if connected >= 0 { result = waitStreamState(pcm, 2) } else { result = EIO }
            if result < 0 {
                pa_stream_unref(streamOf(pcm))
                c.putPointer(pcm, STREAM, 0)
            } else {
                c.putPointer(pcm, OFFSET, 0)
                c.put32(pcm, UNDERRUN, 0)
                c.put64(pcm, WRITTEN, 0)
                c.putPointer(pcm, LAST_SIZE, 0)
                c.putPointer(pcm, POINTER, 0)
                const updated = updatePointer(pcm)
            }
        }
    }
    unlock(pcm)
    return result
}

// ALSA's sample formats as PulseAudio's, with their widths in bits; -1
// for those PulseAudio has not.
fn pulseFormat(format: i32, width: *u32) -> i32 {
    width.* = 32
    if format == 1 {
        width.* = 8
        return 0
    }
    if format == 21 {
        width.* = 8
        return 1
    }
    if format == 20 {
        width.* = 8
        return 2
    }
    if format == 2 || format == 3 {
        width.* = 16
        return format + 1
    }
    if format == 14 { return 5 }
    if format == 15 { return 6 }
    if format == 10 { return 7 }
    if format == 11 { return 8 }
    if format == 32 || format == 33 {
        width.* = 24
        return format - 23
    }
    if format == 6 { return 11 }
    if format == 7 { return 12 }
    return -1
}

export fn mlx_alsa_pcm_hw_params(pcm: usize, params: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var width: u32 = 0
    const format = pulseFormat(@bitCast(i32, c.get32(pcm, IO_FORMAT)), &width)
    var result: i32 = 0
    if format < 0 {
        result = EINVAL
    } else {
        const channels = c.get32(pcm, IO_CHANNELS)
        const frame = @intCast(usize, width * channels / 8)
        c.putPointer(pcm, FRAME_SIZE, frame)
        c.put32(pcm, SPEC, @bitCast(u32, format))
        c.put32(pcm, SPEC + 4, c.get32(pcm, IO_RATE))
        c.put8(pcm, SPEC + 8, @intCast(u8, channels))
        const period = c.getPointer(pcm, IO_PERIOD)
        const buffer = c.getPointer(pcm, IO_BUFFER)
        c.put32(pcm, MAXLENGTH, 4194304)
        c.put32(pcm, TLENGTH, @intCast(u32, buffer * frame))
        if c.get32(pcm, PREBUF) == 4294967295 { c.put32(pcm, PREBUF, @intCast(u32, (buffer - period) * frame)) }
        c.put32(pcm, MINREQ, @intCast(u32, period * frame))
        c.put32(pcm, FRAGSIZE, @intCast(u32, period * frame))
    }
    unlock(pcm)
    return result
}

export fn mlx_alsa_pcm_sw_params(pcm: usize, params: usize) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var threshold: u64 = 0
    const got = snd_pcm_sw_params_get_start_threshold(params, @intFromPtr(&threshold))
    // At least a period, for PulseAudio.
    const period = c.get64(pcm, IO_PERIOD)
    if threshold < period { threshold = period }
    c.put32(pcm, PREBUF, @intCast(u32, threshold * @intCast(u64, c.getPointer(pcm, FRAME_SIZE))))
    unlock(pcm)
    return 0
}

export fn mlx_alsa_pcm_close(pcm: usize) -> i32 {
    if ready(pcm) {
        lock(pcm)
        if streamOf(pcm) != 0 {
            const disconnected = pa_stream_disconnect(streamOf(pcm))
            pa_stream_unref(streamOf(pcm))
        }
        unlock(pcm)
    }
    if pulseOf(pcm) != 0 { pulseFree(pulseOf(pcm)) }
    c.release(c.getPointer(pcm, DEVICE))
    c.release(pcm)
    return 0
}

export fn mlx_alsa_pcm_pause(pcm: usize, enable: i32) -> i32 {
    if !ready(pcm) { return EBADFD }
    lock(pcm)
    var result = checkStream(pcm)
    if result >= 0 {
        const corked = pa_stream_cork(streamOf(pcm), enable, 0, 0)
        if corked != 0 { pa_operation_unref(corked) } else { result = EIO }
    }
    unlock(pcm)
    return result
}

// The formats offered, as ALSA's: U8, A_LAW, MU_LAW, S16_LE, S16_BE,
// FLOAT_LE, FLOAT_BE, S32_LE, S32_BE, S24_3LE, S24_3BE, S24_LE, S24_BE.
fn constrain(pcm: usize) -> i32 {
    var access: [1]u32 = [1]u32{ 3 }
    var result = snd_pcm_ioplug_set_param_list(pcm, 0, 1, @intFromPtr(&access))
    if result < 0 { return result }
    var formats: [13]u32 = [13]u32{ 1, 21, 20, 2, 3, 14, 15, 10, 11, 32, 33, 6, 7 }
    result = snd_pcm_ioplug_set_param_list(pcm, 1, 13, @intFromPtr(&formats))
    if result < 0 { return result }
    result = snd_pcm_ioplug_set_param_minmax(pcm, 2, 1, 32)
    if result < 0 { return result }
    result = snd_pcm_ioplug_set_param_minmax(pcm, 3, 1, 384000)
    if result < 0 { return result }
    result = snd_pcm_ioplug_set_param_minmax(pcm, 5, 1, 4194304)
    if result < 0 { return result }
    result = snd_pcm_ioplug_set_param_minmax(pcm, 4, 128, 2097152)
    if result < 0 { return result }
    return snd_pcm_ioplug_set_param_minmax(pcm, 6, 3, 1024)
}

fn openPcm(target: usize, name: usize, root: usize, conf: usize, stream: i32, mode: i32) -> i32 {
    var values: [3]usize = [3]usize{ 0, 0, 0 }
    var underrun: i32 = 1
    const keys = [3][]const u8{ "server", "device", "fallback" }
    const configured = configure(conf, keys[0..3], @intFromPtr(&values), &underrun)
    if configured < 0 { return configured }
    var fallback = values[2]
    if fallback != 0 && name != 0 && c.same(c.slice(name), c.slice(fallback)) { fallback = 0 }
    const pcm = c.alloc(PCM_SIZE)
    if pcm == 0 { return ENOMEM }
    if values[1] != 0 { c.putPointer(pcm, DEVICE, c.duplicateC(values[1])) }
    c.put32(pcm, HANDLE_UNDERRUN, @bitCast(u32, underrun))
    c.put32(pcm, PREBUF, 4294967295)
    var result: i32 = 0
    c.putPointer(pcm, PULSE_OF, pulseNew())
    if pulseOf(pcm) == 0 {
        result = EIO
    } else {
        result = pulseConnect(pulseOf(pcm), values[0], fallback != 0)
    }
    if result >= 0 {
        const callbacks = pcm + CALLBACKS
        c.putPointer(callbacks, 0, @intFromPtr(mlx_alsa_pcm_start))
        c.putPointer(callbacks, 8, @intFromPtr(mlx_alsa_pcm_stop))
        c.putPointer(callbacks, 16, @intFromPtr(mlx_alsa_pcm_pointer))
        c.putPointer(callbacks, 24, if stream == PLAYBACK { @intFromPtr(mlx_alsa_pcm_write) } else { @intFromPtr(mlx_alsa_pcm_read) })
        c.putPointer(callbacks, 32, @intFromPtr(mlx_alsa_pcm_close))
        c.putPointer(callbacks, 40, @intFromPtr(mlx_alsa_pcm_hw_params))
        if stream == PLAYBACK {
            c.putPointer(callbacks, 56, @intFromPtr(mlx_alsa_pcm_sw_params))
            c.putPointer(callbacks, 72, @intFromPtr(mlx_alsa_pcm_drain))
            c.putPointer(callbacks, 80, @intFromPtr(mlx_alsa_pcm_pause))
        }
        c.putPointer(callbacks, 64, @intFromPtr(mlx_alsa_pcm_prepare))
        c.putPointer(callbacks, 112, @intFromPtr(mlx_alsa_pcm_poll_revents))
        c.putPointer(callbacks, 128, @intFromPtr(mlx_alsa_pcm_delay))
        c.put32(pcm, IO_VERSION, IOPLUG_VERSION)
        c.putPointer(pcm, IO_NAME, c.literal("ALSA <-> MLX Audio PCM I/O Plugin"))
        c.put32(pcm, IO_POLL_FD, c.get32(pulseOf(pcm), P_MAIN))
        c.put32(pcm, IO_POLL_EVENTS, @intCast(u32, POLLIN))
        c.put32(pcm, IO_MMAP_RW, 0)
        c.putPointer(pcm, IO_CALLBACK, callbacks)
        c.putPointer(pcm, IO_PRIVATE, pcm)
        result = snd_pcm_ioplug_create(pcm, name, stream, mode)
        if result >= 0 {
            result = constrain(pcm)
            if result < 0 {
                // (Deleting closes it: the close callback frees it.)
                const deleted = snd_pcm_ioplug_delete(pcm)
                if fallback != 0 { return snd_pcm_open_fallback(target, root, fallback, name, stream, mode) }
                return result
            }
            c.putPointer(target, 0, c.getPointer(pcm, IO_PCM))
            return 0
        }
    }
    if pulseOf(pcm) != 0 { pulseFree(pulseOf(pcm)) }
    c.release(c.getPointer(pcm, DEVICE))
    c.release(pcm)
    if fallback != 0 { return snd_pcm_open_fallback(target, root, fallback, name, stream, mode) }
    return result
}

export fn _snd_pcm_mlx_open(target: usize, name: usize, root: usize, conf: usize, stream: i32, mode: i32) -> i32 { return openPcm(target, name, root, conf, stream, mode) }

// alsa-lib looks for this name to know the plugin's interface version.
export fn __snd_pcm_mlx_open_dlsym_pcm_001() -> void {}

// The same plugin as type pulse, where it stands in for alsa-plugins'
// (installed as libasound_module_pcm_pulse.so).
export fn _snd_pcm_pulse_open(target: usize, name: usize, root: usize, conf: usize, stream: i32, mode: i32) -> i32 { return openPcm(target, name, root, conf, stream, mode) }

export fn __snd_pcm_pulse_open_dlsym_pcm_001() -> void {}

// ---------------------------------------------------------------------------
// Control: the default sink's and source's volume and mute

const EXT_SIZE: usize = 280
const EXT_VERSION: usize = 0
const EXT_ID: usize = 8
const EXT_DRIVER: usize = 24
const EXT_NAME: usize = 40
const EXT_LONGNAME: usize = 72
const EXT_MIXERNAME: usize = 152
const EXT_POLL_FD: usize = 232
const EXT_CALLBACK: usize = 240
const EXT_PRIVATE: usize = 248
const EXT_HANDLE: usize = 256
const CTL_EXT_VERSION: u32 = 65537

// The control: the ext first, then ours.
const CTL_SIZE: usize = 840
const CTL_PULSE: usize = 280
const SOURCE: usize = 288
const SINK: usize = 296
const SINK_VOLUME: usize = 304
const SOURCE_VOLUME: usize = 436
const SINK_MUTED: usize = 568
const SOURCE_MUTED: usize = 572
const SUBSCRIBED: usize = 576
const UPDATED: usize = 580
const CTL_CALLBACKS: usize = 584

const UPDATE_SINK_VOLUME: u32 = 1
const UPDATE_SINK_MUTE: u32 = 2
const UPDATE_SOURCE_VOLUME: u32 = 4
const UPDATE_SOURCE_MUTE: u32 = 8

const SOURCE_VOLUME_NAME: []const u8 = "Capture Volume"
const SOURCE_MUTE_NAME: []const u8 = "Capture Switch"
const SINK_VOLUME_NAME: []const u8 = "Master Playback Volume"
const SINK_MUTE_NAME: []const u8 = "Master Playback Switch"

fn ctlPulse(ctl: usize) -> usize { return c.getPointer(ctl, CTL_PULSE) }

fn ctlReady(ctl: usize) -> bool { return ctlPulse(ctl) != 0 && pulseLoop(ctlPulse(ctl)) != 0 }

// A sink's or source's info (pa_sink_info and pa_source_info share the
// layout: volume at 172, mute at 304) into ours.
fn deviceInfo(ctl: usize, info: usize, last: i32, volume: usize, muted: usize, volumeBit: u32, muteBit: u32) -> void {
    if last != 0 {
        pa_threaded_mainloop_signal(pulseLoop(ctlPulse(ctl)), 0)
        return
    }
    var changed = false
    const mute = c.get32(info, 304) != 0
    if (c.get32(ctl, muted) != 0) != mute {
        c.put32(ctl, muted, if mute { 1 } else { 0 })
        c.put32(ctl, UPDATED, c.get32(ctl, UPDATED) | muteBit)
        changed = true
    }
    if pa_cvolume_equal(ctl + volume, info + 172) == 0 {
        c.copy(ctl + volume, info + 172, 132)
        c.put32(ctl, UPDATED, c.get32(ctl, UPDATED) | volumeBit)
        changed = true
    }
    if changed { activate(ctlPulse(ctl)) }
}

export fn mlx_alsa_sink_info(context: usize, info: usize, last: i32, ctl: usize) -> void { deviceInfo(ctl, info, last, SINK_VOLUME, SINK_MUTED, UPDATE_SINK_VOLUME, UPDATE_SINK_MUTE) }

export fn mlx_alsa_source_info(context: usize, info: usize, last: i32, ctl: usize) -> void { deviceInfo(ctl, info, last, SOURCE_VOLUME, SOURCE_MUTED, UPDATE_SOURCE_VOLUME, UPDATE_SOURCE_MUTE) }

export fn mlx_alsa_event(context: usize, kind: u32, index: u32, ctl: usize) -> void {
    if !ctlReady(ctl) || pulseContext(ctlPulse(ctl)) == 0 { return }
    const sink = pa_context_get_sink_info_by_name(context, c.getPointer(ctl, SINK), @intFromPtr(mlx_alsa_sink_info), ctl)
    if sink != 0 { pa_operation_unref(sink) }
    const source = pa_context_get_source_info_by_name(context, c.getPointer(ctl, SOURCE), @intFromPtr(mlx_alsa_source_info), ctl)
    if source != 0 { pa_operation_unref(source) }
}

fn updateVolume(ctl: usize) -> i32 {
    const pulse = ctlPulse(ctl)
    var result = checkConnection(pulse)
    if result < 0 { return result }
    const sink = pa_context_get_sink_info_by_name(pulseContext(pulse), c.getPointer(ctl, SINK), @intFromPtr(mlx_alsa_sink_info), ctl)
    if sink == 0 { return EIO }
    result = waitOperation(pulse, sink)
    pa_operation_unref(sink)
    if result < 0 { return result }
    const source = pa_context_get_source_info_by_name(pulseContext(pulse), c.getPointer(ctl, SOURCE), @intFromPtr(mlx_alsa_source_info), ctl)
    if source == 0 { return EIO }
    result = waitOperation(pulse, source)
    pa_operation_unref(source)
    return result
}

fn ctlLock(ctl: usize) -> void { pa_threaded_mainloop_lock(pulseLoop(ctlPulse(ctl))) }

fn ctlUnlock(ctl: usize) -> void { pa_threaded_mainloop_unlock(pulseLoop(ctlPulse(ctl))) }

export fn mlx_alsa_ctl_elem_count(ctl: usize) -> i32 {
    if !ctlReady(ctl) { return EBADFD }
    ctlLock(ctl)
    var count = checkConnection(ctlPulse(ctl))
    if count >= 0 {
        if c.getPointer(ctl, SOURCE) != 0 { count += 2 }
        if c.getPointer(ctl, SINK) != 0 { count += 2 }
    }
    ctlUnlock(ctl)
    return count
}

fn nameElement(id: usize, name: []const u8) -> void { snd_ctl_elem_id_set_name(id, c.literal(name)) }

export fn mlx_alsa_ctl_elem_list(ctl: usize, offset: u32, id: usize) -> i32 {
    if !ctlReady(ctl) { return EBADFD }
    snd_ctl_elem_id_set_interface(id, 2)
    ctlLock(ctl)
    const result = checkConnection(ctlPulse(ctl))
    var at = offset
    if result >= 0 {
        if c.getPointer(ctl, SOURCE) != 0 {
            if at == 0 { nameElement(id, SOURCE_VOLUME_NAME) } else if at == 1 { nameElement(id, SOURCE_MUTE_NAME) }
        } else {
            at += 2
        }
    }
    ctlUnlock(ctl)
    if result >= 0 {
        if at == 2 { nameElement(id, SINK_VOLUME_NAME) } else if at == 3 { nameElement(id, SINK_MUTE_NAME) }
    }
    return if result < 0 { result } else { 0 }
}

export fn mlx_alsa_ctl_find_elem(ctl: usize, id: usize) -> u64 {
    const number = snd_ctl_elem_id_get_numid(id)
    if number > 0 && number <= 4 { return @intCast(u64, number - 1) }
    const name = c.slice(snd_ctl_elem_id_get_name(id))
    if c.same(name, SOURCE_VOLUME_NAME) { return 0 }
    if c.same(name, SOURCE_MUTE_NAME) { return 1 }
    if c.same(name, SINK_VOLUME_NAME) { return 2 }
    if c.same(name, SINK_MUTE_NAME) { return 3 }
    return 18446744073709551615
}

export fn mlx_alsa_ctl_get_attribute(ctl: usize, key: u64, kind: usize, access: usize, count: usize) -> i32 {
    if key > 3 { return EINVAL }
    if !ctlReady(ctl) { return EBADFD }
    ctlLock(ctl)
    var result = checkConnection(ctlPulse(ctl))
    if result >= 0 { result = updateVolume(ctl) }
    if result >= 0 {
        // Switches are booleans, volumes integers; both read and written.
        c.put32(kind, 0, if key & 1 != 0 { 1 } else { 2 })
        c.put32(access, 0, 3)
        var values: u32 = 1
        if key == 0 { values = @intCast(u32, c.get8(ctl, SOURCE_VOLUME)) }
        if key == 2 { values = @intCast(u32, c.get8(ctl, SINK_VOLUME)) }
        c.put32(count, 0, values)
    }
    ctlUnlock(ctl)
    return result
}

export fn mlx_alsa_ctl_get_integer_info(ctl: usize, key: u64, least: usize, most: usize, step: usize) -> i32 {
    c.put64(step, 0, 1)
    c.put64(least, 0, 0)
    c.put64(most, 0, 65536)
    return 0
}

export fn mlx_alsa_ctl_read_integer(ctl: usize, key: u64, values: usize) -> i32 {
    if !ctlReady(ctl) { return EBADFD }
    ctlLock(ctl)
    var result = checkConnection(ctlPulse(ctl))
    if result >= 0 { result = updateVolume(ctl) }
    if result >= 0 {
        if key == 1 || key == 3 {
            const muted = c.get32(ctl, if key == 1 { SOURCE_MUTED } else { SINK_MUTED }) != 0
            c.put64(values, 0, if muted { 0 } else { 1 })
        } else if key == 0 || key == 2 {
            const levels = ctl + (if key == 0 { SOURCE_VOLUME } else { SINK_VOLUME })
            var index: usize = 0
            while index < @intCast(usize, c.get8(levels, 0)) {
                c.put64(values, index * 8, @intCast(u64, c.get32(levels, 4 + index * 4)))
                index += 1
            }
        } else {
            result = EINVAL
        }
    }
    ctlUnlock(ctl)
    return result
}

export fn mlx_alsa_ctl_write_integer(ctl: usize, key: u64, values: usize) -> i32 {
    if !ctlReady(ctl) { return EBADFD }
    ctlLock(ctl)
    const pulse = ctlPulse(ctl)
    var result = checkConnection(pulse)
    if result >= 0 { result = updateVolume(ctl) }
    var operation: usize = 0
    var changed = false
    if result >= 0 {
        if key == 1 || key == 3 {
            const field = if key == 1 { SOURCE_MUTED } else { SINK_MUTED }
            const mute = c.get64(values, 0) == 0
            if (c.get32(ctl, field) != 0) != mute {
                c.put32(ctl, field, if mute { 1 } else { 0 })
                changed = true
                if key == 1 {
                    operation = pa_context_set_source_mute_by_name(pulseContext(pulse), c.getPointer(ctl, SOURCE), if mute { 1 } else { 0 }, @intFromPtr(mlx_alsa_context_success), pulse)
                } else {
                    operation = pa_context_set_sink_mute_by_name(pulseContext(pulse), c.getPointer(ctl, SINK), if mute { 1 } else { 0 }, @intFromPtr(mlx_alsa_context_success), pulse)
                }
            }
        } else if key == 0 || key == 2 {
            const levels = ctl + (if key == 0 { SOURCE_VOLUME } else { SINK_VOLUME })
            var index: usize = 0
            while index < @intCast(usize, c.get8(levels, 0)) {
                if c.get64(values, index * 8) != @intCast(u64, c.get32(levels, 4 + index * 4)) { changed = true }
                c.put32(levels, 4 + index * 4, @intCast(u32, c.get64(values, index * 8) & 4294967295))
                index += 1
            }
            if changed {
                if key == 0 {
                    operation = pa_context_set_source_volume_by_name(pulseContext(pulse), c.getPointer(ctl, SOURCE), levels, @intFromPtr(mlx_alsa_context_success), pulse)
                } else {
                    operation = pa_context_set_sink_volume_by_name(pulseContext(pulse), c.getPointer(ctl, SINK), levels, @intFromPtr(mlx_alsa_context_success), pulse)
                }
            }
        } else {
            result = EINVAL
        }
    }
    if result >= 0 && changed {
        if operation == 0 {
            result = EIO
        } else {
            result = waitOperation(pulse, operation)
            pa_operation_unref(operation)
            if result >= 0 { result = 1 }
        }
    }
    ctlUnlock(ctl)
    return result
}

export fn mlx_alsa_ctl_subscribe_events(ctl: usize, subscribe: i32) -> void {
    if !ctlReady(ctl) { return }
    ctlLock(ctl)
    c.put32(ctl, SUBSCRIBED, if subscribe & 1 != 0 { 1 } else { 0 })
    ctlUnlock(ctl)
}

export fn mlx_alsa_ctl_read_event(ctl: usize, id: usize, mask: usize) -> i32 {
    if !ctlReady(ctl) { return EBADFD }
    ctlLock(ctl)
    var result = checkConnection(ctlPulse(ctl))
    var element: u32 = 4
    if result >= 0 {
        const updated = c.get32(ctl, UPDATED)
        if updated == 0 || c.get32(ctl, SUBSCRIBED) == 0 {
            result = EAGAIN
        } else {
            const offset: u32 = if c.getPointer(ctl, SOURCE) != 0 { 2 } else { 0 }
            var bit: u32 = 0
            if updated & UPDATE_SOURCE_VOLUME != 0 {
                element = 0
                bit = UPDATE_SOURCE_VOLUME
            } else if updated & UPDATE_SOURCE_MUTE != 0 {
                element = 1
                bit = UPDATE_SOURCE_MUTE
            } else if updated & UPDATE_SINK_VOLUME != 0 {
                element = offset
                bit = UPDATE_SINK_VOLUME
            } else {
                element = offset + 1
                bit = UPDATE_SINK_MUTE
            }
            c.put32(ctl, UPDATED, updated & ~bit)
            c.put32(mask, 0, 1)
            if c.get32(ctl, UPDATED) == 0 { deactivate(ctlPulse(ctl)) }
            result = 1
        }
    }
    ctlUnlock(ctl)
    if element < 4 { const listed = mlx_alsa_ctl_elem_list(ctl, element, id) }
    return result
}

export fn mlx_alsa_ctl_poll_revents(ctl: usize, fds: usize, count: u32, revents: usize) -> i32 {
    if !ctlReady(ctl) { return EBADFD }
    ctlLock(ctl)
    const result = checkConnection(ctlPulse(ctl))
    if result >= 0 {
        c.put8(revents, 0, if c.get32(ctl, UPDATED) != 0 { @intCast(u8, POLLIN) } else { 0 })
        c.put8(revents, 1, 0)
    }
    ctlUnlock(ctl)
    return if result < 0 { result } else { 0 }
}

export fn mlx_alsa_ctl_close(ctl: usize) -> void {
    if ctlPulse(ctl) != 0 { pulseFree(ctlPulse(ctl)) }
    c.release(c.getPointer(ctl, SOURCE))
    c.release(c.getPointer(ctl, SINK))
    c.release(ctl)
}

export fn mlx_alsa_server_info(context: usize, info: usize, ctl: usize) -> void {
    if info != 0 {
        if c.getPointer(info, 56) != 0 && c.getPointer(ctl, SOURCE) == 0 { c.putPointer(ctl, SOURCE, c.duplicateC(c.getPointer(info, 56))) }
        if c.getPointer(info, 48) != 0 && c.getPointer(ctl, SINK) == 0 { c.putPointer(ctl, SINK, c.duplicateC(c.getPointer(info, 48))) }
    }
    pa_threaded_mainloop_signal(pulseLoop(ctlPulse(ctl)), 0)
}

fn copyName(ctl: usize, field: usize, capacity: usize, name: []const u8) -> void {
    var writing = c.out(ctl + field, capacity)
    c.append(&writing, name)
}

fn openCtl(target: usize, name: usize, root: usize, conf: usize, mode: i32) -> i32 {
    var values: [5]usize = [5]usize{ 0, 0, 0, 0, 0 }
    var underrun: i32 = 0
    const keys = [5][]const u8{ "server", "device", "source", "sink", "fallback" }
    const configured = configure(conf, keys[0..5], @intFromPtr(&values), &underrun)
    if configured < 0 { return configured }
    var fallback = values[4]
    if fallback != 0 && name != 0 && c.same(c.slice(name), c.slice(fallback)) { fallback = 0 }
    const ctl = c.alloc(CTL_SIZE)
    if ctl == 0 { return ENOMEM }
    var result: i32 = 0
    c.putPointer(ctl, CTL_PULSE, pulseNew())
    if ctlPulse(ctl) == 0 {
        result = EIO
    } else {
        result = pulseConnect(ctlPulse(ctl), values[0], fallback != 0)
    }
    const device = values[1]
    if result >= 0 {
        const source = if values[2] != 0 { values[2] } else { device }
        const sink = if values[3] != 0 { values[3] } else { device }
        if source != 0 { c.putPointer(ctl, SOURCE, c.duplicateC(source)) }
        if sink != 0 { c.putPointer(ctl, SINK, c.duplicateC(sink)) }
        const pulse = ctlPulse(ctl)
        if c.getPointer(ctl, SOURCE) == 0 || c.getPointer(ctl, SINK) == 0 {
            pa_threaded_mainloop_lock(pulseLoop(pulse))
            const asked = pa_context_get_server_info(pulseContext(pulse), @intFromPtr(mlx_alsa_server_info), ctl)
            if asked != 0 {
                result = waitOperation(pulse, asked)
                pa_operation_unref(asked)
            } else {
                result = EIO
            }
            pa_threaded_mainloop_unlock(pulseLoop(pulse))
        }
        if result >= 0 {
            pa_threaded_mainloop_lock(pulseLoop(pulse))
            pa_context_set_subscribe_callback(pulseContext(pulse), @intFromPtr(mlx_alsa_event), ctl)
            // PA_SUBSCRIPTION_MASK_SINK | PA_SUBSCRIPTION_MASK_SOURCE
            const subscribed = pa_context_subscribe(pulseContext(pulse), 3, @intFromPtr(mlx_alsa_context_success), pulse)
            if subscribed != 0 {
                result = waitOperation(pulse, subscribed)
                pa_operation_unref(subscribed)
            } else {
                result = EIO
            }
            pa_threaded_mainloop_unlock(pulseLoop(pulse))
        }
    }
    if result >= 0 {
        const callbacks = ctl + CTL_CALLBACKS
        c.putPointer(callbacks, 0, @intFromPtr(mlx_alsa_ctl_close))
        c.putPointer(callbacks, 8, @intFromPtr(mlx_alsa_ctl_elem_count))
        c.putPointer(callbacks, 16, @intFromPtr(mlx_alsa_ctl_elem_list))
        c.putPointer(callbacks, 24, @intFromPtr(mlx_alsa_ctl_find_elem))
        c.putPointer(callbacks, 40, @intFromPtr(mlx_alsa_ctl_get_attribute))
        c.putPointer(callbacks, 48, @intFromPtr(mlx_alsa_ctl_get_integer_info))
        c.putPointer(callbacks, 80, @intFromPtr(mlx_alsa_ctl_read_integer))
        c.putPointer(callbacks, 120, @intFromPtr(mlx_alsa_ctl_write_integer))
        c.putPointer(callbacks, 160, @intFromPtr(mlx_alsa_ctl_subscribe_events))
        c.putPointer(callbacks, 168, @intFromPtr(mlx_alsa_ctl_read_event))
        c.putPointer(callbacks, 192, @intFromPtr(mlx_alsa_ctl_poll_revents))
        c.put32(ctl, EXT_VERSION, CTL_EXT_VERSION)
        copyName(ctl, EXT_ID, 16, "mlx")
        copyName(ctl, EXT_DRIVER, 16, "MLX Audio plugin")
        copyName(ctl, EXT_NAME, 32, "MLX Audio")
        copyName(ctl, EXT_LONGNAME, 80, "MLX Audio")
        copyName(ctl, EXT_MIXERNAME, 80, "MLX Audio")
        c.put32(ctl, EXT_POLL_FD, c.get32(ctlPulse(ctl), P_MAIN))
        c.putPointer(ctl, EXT_CALLBACK, callbacks)
        c.putPointer(ctl, EXT_PRIVATE, ctl)
        result = snd_ctl_ext_create(ctl, name, mode)
        if result >= 0 {
            c.putPointer(target, 0, c.getPointer(ctl, EXT_HANDLE))
            return 0
        }
    }
    if ctlPulse(ctl) != 0 { pulseFree(ctlPulse(ctl)) }
    c.release(c.getPointer(ctl, SOURCE))
    c.release(c.getPointer(ctl, SINK))
    c.release(ctl)
    if fallback != 0 { return snd_ctl_open_fallback(target, root, fallback, name, mode) }
    return result
}

export fn _snd_ctl_mlx_open(target: usize, name: usize, root: usize, conf: usize, mode: i32) -> i32 { return openCtl(target, name, root, conf, mode) }

export fn __snd_ctl_mlx_open_dlsym_control_001() -> void {}

export fn _snd_ctl_pulse_open(target: usize, name: usize, root: usize, conf: usize, mode: i32) -> i32 { return openCtl(target, name, root, conf, mode) }

export fn __snd_ctl_pulse_open_dlsym_control_001() -> void {}
