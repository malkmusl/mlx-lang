// Channel maps (pa_channel_map: channels u8, then 32 positions as i32;
// 132 bytes) and their positions' names.
const c = @import("./c.mlx")
const sample = @import("./sample.mlx")

pub const MAP: usize = 132
pub const MAX: u32 = 32

pub const MONO: u32 = 0
pub const FRONT_LEFT: u32 = 1
pub const FRONT_RIGHT: u32 = 2
pub const FRONT_CENTER: u32 = 3
pub const REAR_CENTER: u32 = 4
pub const REAR_LEFT: u32 = 5
pub const REAR_RIGHT: u32 = 6
pub const LFE: u32 = 7
pub const FRONT_LEFT_OF_CENTER: u32 = 8
pub const FRONT_RIGHT_OF_CENTER: u32 = 9
pub const SIDE_LEFT: u32 = 10
pub const SIDE_RIGHT: u32 = 11
pub const AUX0: u32 = 12
pub const TOP_CENTER: u32 = 44
pub const TOP_FRONT_LEFT: u32 = 45
pub const TOP_FRONT_RIGHT: u32 = 46
pub const TOP_FRONT_CENTER: u32 = 47
pub const TOP_REAR_LEFT: u32 = 48
pub const TOP_REAR_RIGHT: u32 = 49
pub const TOP_REAR_CENTER: u32 = 50
pub const POSITIONS: u32 = 51
pub const INVALID: u32 = 4294967295

// Standard maps (pa_channel_map_def_t).
pub const DEF_AIFF: u32 = 0
pub const DEF_ALSA: u32 = 1
pub const DEF_AUX: u32 = 2
pub const DEF_WAVEEX: u32 = 3
pub const DEF_OSS: u32 = 4

pub fn channels(map: usize) -> u32 { return @intCast(u32, c.get8(map, 0)) }

pub fn position(map: usize, channel: u32) -> u32 { return c.get32(map, 4 + @intCast(usize, channel) * 4) }

pub fn setPosition(map: usize, channel: u32, value: u32) -> void { c.put32(map, 4 + @intCast(usize, channel) * 4, value) }

pub fn setChannels(map: usize, count: u32) -> void { c.put8(map, 0, @intCast(u8, count & 255)) }

pub fn init(map: usize) -> void {
    c.put8(map, 0, 0)
    var index: u32 = 0
    while index < MAX {
        setPosition(map, index, INVALID)
        index += 1
    }
}

pub fn valid(map: usize) -> bool {
    const count = channels(map)
    if !sample.channelsValid(count) { return false }
    var index: u32 = 0
    while index < count {
        if position(map, index) >= POSITIONS { return false }
        index += 1
    }
    return true
}

pub fn equal(first: usize, second: usize) -> bool {
    if !valid(first) || !valid(second) { return false }
    if channels(first) != channels(second) { return false }
    var index: u32 = 0
    while index < channels(first) {
        if position(first, index) != position(second, index) { return false }
        index += 1
    }
    return true
}

fn set(map: usize, count: u32, positions: []const u32) -> void {
    setChannels(map, count)
    var index: usize = 0
    while index < positions.length {
        setPosition(map, @intCast(u32, index), positions[index])
        index += 1
    }
}

// pa_channel_map_init_auto: false when `def` has no map for that many
// channels.
pub fn initAuto(map: usize, count: u32, def: u32) -> bool {
    init(map)
    setChannels(map, count)
    if count == 1 && def != DEF_AUX {
        setPosition(map, 0, MONO)
        return true
    }
    if def == DEF_AIFF {
        if count == 2 {
            set(map, 2, [2]u32{ FRONT_LEFT, FRONT_RIGHT }[0..2])
        } else if count == 3 {
            set(map, 3, [3]u32{ FRONT_LEFT, FRONT_RIGHT, FRONT_CENTER }[0..3])
        } else if count == 4 {
            set(map, 4, [4]u32{ FRONT_LEFT, FRONT_CENTER, FRONT_RIGHT, REAR_CENTER }[0..4])
        } else if count == 5 {
            set(map, 5, [5]u32{ FRONT_LEFT, FRONT_RIGHT, FRONT_CENTER, REAR_LEFT, REAR_RIGHT }[0..5])
        } else if count == 6 {
            set(map, 6, [6]u32{ FRONT_LEFT, FRONT_LEFT_OF_CENTER, FRONT_CENTER, FRONT_RIGHT, FRONT_RIGHT_OF_CENTER, REAR_CENTER }[0..6])
        } else {
            return false
        }
        return true
    }
    if def == DEF_ALSA {
        if count == 2 {
            set(map, 2, [2]u32{ FRONT_LEFT, FRONT_RIGHT }[0..2])
        } else if count == 4 {
            set(map, 4, [4]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT }[0..4])
        } else if count == 5 {
            set(map, 5, [5]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT, FRONT_CENTER }[0..5])
        } else if count == 6 {
            set(map, 6, [6]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT, FRONT_CENTER, LFE }[0..6])
        } else if count == 8 {
            set(map, 8, [8]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT, FRONT_CENTER, LFE, SIDE_LEFT, SIDE_RIGHT }[0..8])
        } else {
            return false
        }
        return true
    }
    if def == DEF_AUX {
        var index: u32 = 0
        while index < count {
            setPosition(map, index, AUX0 + index)
            index += 1
        }
        return true
    }
    if def == DEF_WAVEEX {
        const order = [18]u32{ FRONT_LEFT, FRONT_RIGHT, FRONT_CENTER, LFE, REAR_LEFT, REAR_RIGHT, FRONT_LEFT_OF_CENTER, FRONT_RIGHT_OF_CENTER, REAR_CENTER, SIDE_LEFT, SIDE_RIGHT, TOP_CENTER, TOP_FRONT_LEFT, TOP_FRONT_CENTER, TOP_FRONT_RIGHT, TOP_REAR_LEFT, TOP_REAR_CENTER, TOP_REAR_RIGHT }
        if !(count == 2 || count == 3 || count == 4 || count == 6 || count == 8 || count == 9 || count == 11 || count == 12 || count == 15 || count == 18) { return false }
        set(map, count, order[0..@intCast(usize, count)])
        return true
    }
    if def == DEF_OSS {
        const order = [8]u32{ FRONT_LEFT, FRONT_RIGHT, FRONT_CENTER, LFE, SIDE_LEFT, SIDE_RIGHT, REAR_LEFT, REAR_RIGHT }
        if !(count == 2 || count == 3 || count == 4 || count == 6 || count == 8) { return false }
        set(map, count, order[0..@intCast(usize, count)])
        return true
    }
    return false
}

// pa_channel_map_init_extend: the largest standard map that fits, the rest
// auxiliary.
pub fn initExtend(map: usize, count: u32, def: u32) -> bool {
    var known = count
    while known > 0 {
        if initAuto(map, known, def) {
            var aux: u32 = 0
            while known < count {
                setPosition(map, known, AUX0 + aux)
                aux += 1
                known += 1
            }
            setChannels(map, count)
            return true
        }
        known -= 1
    }
    init(map)
    return false
}

// "front-left,front-right"
pub fn print(buffer: usize, capacity: usize, map: usize) -> usize {
    var writing = c.out(buffer, capacity)
    if !valid(map) {
        c.append(&writing, "(invalid)")
        return c.result(&writing)
    }
    var index: u32 = 0
    while index < channels(map) {
        if index > 0 { c.append(&writing, ",") }
        c.append(&writing, c.slice(positionName(position(map, index))))
        index += 1
    }
    return c.result(&writing)
}

// pa_channel_map_parse: the named layouts, else a comma-separated list.
pub fn parse(map: usize, text: []const u8) -> bool {
    var parsed: [132]u8 = undefined
    const scratch = @intFromPtr(&parsed)
    init(scratch)
    if c.same(text, "stereo") {
        set(scratch, 2, [2]u32{ FRONT_LEFT, FRONT_RIGHT }[0..2])
    } else if c.same(text, "surround-21") {
        set(scratch, 3, [3]u32{ FRONT_LEFT, FRONT_RIGHT, LFE }[0..3])
    } else if c.same(text, "surround-40") {
        set(scratch, 4, [4]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT }[0..4])
    } else if c.same(text, "surround-41") {
        set(scratch, 5, [5]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT, LFE }[0..5])
    } else if c.same(text, "surround-50") {
        set(scratch, 5, [5]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT, FRONT_CENTER }[0..5])
    } else if c.same(text, "surround-51") {
        set(scratch, 6, [6]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT, FRONT_CENTER, LFE }[0..6])
    } else if c.same(text, "surround-71") {
        set(scratch, 8, [8]u32{ FRONT_LEFT, FRONT_RIGHT, REAR_LEFT, REAR_RIGHT, FRONT_CENTER, LFE, SIDE_LEFT, SIDE_RIGHT }[0..8])
    } else {
        var count: u32 = 0
        var start: usize = 0
        while start <= text.length {
            var end = start
            while end < text.length && text[end] != 44 { end += 1 }
            if count >= MAX { return false }
            const found = positionFromName(text[start..end])
            if found == INVALID { return false }
            setPosition(scratch, count, found)
            count += 1
            start = end + 1
        }
        setChannels(scratch, count)
    }
    if !valid(scratch) { return false }
    c.copy(map, scratch, MAP)
    return true
}

// Which positions the map has, a bit each.
pub fn mask(map: usize) -> u64 {
    if !valid(map) { return 0 }
    var bits: u64 = 0
    var index: u32 = 0
    while index < channels(map) {
        bits = bits | (@intCast(u64, 1) << @intCast(u6, position(map, index)))
        index += 1
    }
    return bits
}

fn bit(value: u32) -> u64 { return @intCast(u64, 1) << @intCast(u6, value) }

pub fn maskLeft() -> u64 { return bit(FRONT_LEFT) | bit(REAR_LEFT) | bit(FRONT_LEFT_OF_CENTER) | bit(SIDE_LEFT) | bit(TOP_FRONT_LEFT) | bit(TOP_REAR_LEFT) }

pub fn maskRight() -> u64 { return bit(FRONT_RIGHT) | bit(REAR_RIGHT) | bit(FRONT_RIGHT_OF_CENTER) | bit(SIDE_RIGHT) | bit(TOP_FRONT_RIGHT) | bit(TOP_REAR_RIGHT) }

pub fn maskFront() -> u64 { return bit(FRONT_LEFT) | bit(FRONT_RIGHT) | bit(FRONT_CENTER) | bit(TOP_FRONT_LEFT) | bit(TOP_FRONT_RIGHT) | bit(TOP_FRONT_CENTER) | bit(FRONT_LEFT_OF_CENTER) | bit(FRONT_RIGHT_OF_CENTER) }

pub fn maskRear() -> u64 { return bit(REAR_LEFT) | bit(REAR_RIGHT) | bit(REAR_CENTER) | bit(TOP_REAR_LEFT) | bit(TOP_REAR_RIGHT) | bit(TOP_REAR_CENTER) }

pub fn maskLfe() -> u64 { return bit(LFE) }

pub fn maskHfe() -> u64 { return maskRear() | maskFront() | bit(SIDE_LEFT) | bit(SIDE_RIGHT) | bit(TOP_CENTER) }

pub fn canBalance(map: usize) -> bool {
    const bits = mask(map)
    return bits & maskLeft() != 0 && bits & maskRight() != 0
}

pub fn canFade(map: usize) -> bool {
    const bits = mask(map)
    return bits & maskFront() != 0 && bits & maskRear() != 0
}

pub fn canLfeBalance(map: usize) -> bool {
    const bits = mask(map)
    return bits & maskLfe() != 0 && bits & maskHfe() != 0
}

pub fn superset(first: usize, second: usize) -> bool {
    if !valid(first) || !valid(second) { return false }
    const wanted = mask(second)
    return mask(first) & wanted == wanted
}

pub fn hasPosition(map: usize, wanted: u32) -> bool {
    if !valid(map) || wanted >= POSITIONS { return false }
    var index: u32 = 0
    while index < channels(map) {
        if position(map, index) == wanted { return true }
        index += 1
    }
    return false
}

// The layout's name ("stereo"), its pretty name ("Stereo"), or 0.
pub fn name(map: usize, pretty: bool) -> usize {
    if !valid(map) { return 0 }
    const bits = mask(map)
    if bits == bit(MONO) { return if pretty { c.literal("Mono") } else { c.literal("mono") } }
    const stereo = bit(FRONT_LEFT) | bit(FRONT_RIGHT)
    if bits == stereo { return if pretty { c.literal("Stereo") } else { c.literal("stereo") } }
    const four = stereo | bit(REAR_LEFT) | bit(REAR_RIGHT)
    if bits == four { return if pretty { c.literal("Surround 4.0") } else { c.literal("surround-40") } }
    if bits == four | bit(LFE) { return if pretty { c.literal("Surround 4.1") } else { c.literal("surround-41") } }
    if bits == four | bit(FRONT_CENTER) { return if pretty { c.literal("Surround 5.0") } else { c.literal("surround-50") } }
    const six = four | bit(FRONT_CENTER) | bit(LFE)
    if bits == six { return if pretty { c.literal("Surround 5.1") } else { c.literal("surround-51") } }
    if bits == six | bit(SIDE_LEFT) | bit(SIDE_RIGHT) { return if pretty { c.literal("Surround 7.1") } else { c.literal("surround-71") } }
    return 0
}

// The positions' names (C strings that live as long as the library).
pub fn positionName(position: u32) -> usize {
    if position == 0 { return c.literal("mono") }
    if position == 1 { return c.literal("front-left") }
    if position == 2 { return c.literal("front-right") }
    if position == 3 { return c.literal("front-center") }
    if position == 4 { return c.literal("rear-center") }
    if position == 5 { return c.literal("rear-left") }
    if position == 6 { return c.literal("rear-right") }
    if position == 7 { return c.literal("lfe") }
    if position == 8 { return c.literal("front-left-of-center") }
    if position == 9 { return c.literal("front-right-of-center") }
    if position == 10 { return c.literal("side-left") }
    if position == 11 { return c.literal("side-right") }
    if position == 12 { return c.literal("aux0") }
    if position == 13 { return c.literal("aux1") }
    if position == 14 { return c.literal("aux2") }
    if position == 15 { return c.literal("aux3") }
    if position == 16 { return c.literal("aux4") }
    if position == 17 { return c.literal("aux5") }
    if position == 18 { return c.literal("aux6") }
    if position == 19 { return c.literal("aux7") }
    if position == 20 { return c.literal("aux8") }
    if position == 21 { return c.literal("aux9") }
    if position == 22 { return c.literal("aux10") }
    if position == 23 { return c.literal("aux11") }
    if position == 24 { return c.literal("aux12") }
    if position == 25 { return c.literal("aux13") }
    if position == 26 { return c.literal("aux14") }
    if position == 27 { return c.literal("aux15") }
    if position == 28 { return c.literal("aux16") }
    if position == 29 { return c.literal("aux17") }
    if position == 30 { return c.literal("aux18") }
    if position == 31 { return c.literal("aux19") }
    if position == 32 { return c.literal("aux20") }
    if position == 33 { return c.literal("aux21") }
    if position == 34 { return c.literal("aux22") }
    if position == 35 { return c.literal("aux23") }
    if position == 36 { return c.literal("aux24") }
    if position == 37 { return c.literal("aux25") }
    if position == 38 { return c.literal("aux26") }
    if position == 39 { return c.literal("aux27") }
    if position == 40 { return c.literal("aux28") }
    if position == 41 { return c.literal("aux29") }
    if position == 42 { return c.literal("aux30") }
    if position == 43 { return c.literal("aux31") }
    if position == 44 { return c.literal("top-center") }
    if position == 45 { return c.literal("top-front-left") }
    if position == 46 { return c.literal("top-front-right") }
    if position == 47 { return c.literal("top-front-center") }
    if position == 48 { return c.literal("top-rear-left") }
    if position == 49 { return c.literal("top-rear-right") }
    if position == 50 { return c.literal("top-rear-center") }
    return 0
}

pub fn positionPrettyName(position: u32) -> usize {
    if position == 0 { return c.literal("Mono") }
    if position == 1 { return c.literal("Front Left") }
    if position == 2 { return c.literal("Front Right") }
    if position == 3 { return c.literal("Front Center") }
    if position == 4 { return c.literal("Rear Center") }
    if position == 5 { return c.literal("Rear Left") }
    if position == 6 { return c.literal("Rear Right") }
    if position == 7 { return c.literal("Subwoofer") }
    if position == 8 { return c.literal("Front Left-of-center") }
    if position == 9 { return c.literal("Front Right-of-center") }
    if position == 10 { return c.literal("Side Left") }
    if position == 11 { return c.literal("Side Right") }
    if position == 12 { return c.literal("Auxiliary 0") }
    if position == 13 { return c.literal("Auxiliary 1") }
    if position == 14 { return c.literal("Auxiliary 2") }
    if position == 15 { return c.literal("Auxiliary 3") }
    if position == 16 { return c.literal("Auxiliary 4") }
    if position == 17 { return c.literal("Auxiliary 5") }
    if position == 18 { return c.literal("Auxiliary 6") }
    if position == 19 { return c.literal("Auxiliary 7") }
    if position == 20 { return c.literal("Auxiliary 8") }
    if position == 21 { return c.literal("Auxiliary 9") }
    if position == 22 { return c.literal("Auxiliary 10") }
    if position == 23 { return c.literal("Auxiliary 11") }
    if position == 24 { return c.literal("Auxiliary 12") }
    if position == 25 { return c.literal("Auxiliary 13") }
    if position == 26 { return c.literal("Auxiliary 14") }
    if position == 27 { return c.literal("Auxiliary 15") }
    if position == 28 { return c.literal("Auxiliary 16") }
    if position == 29 { return c.literal("Auxiliary 17") }
    if position == 30 { return c.literal("Auxiliary 18") }
    if position == 31 { return c.literal("Auxiliary 19") }
    if position == 32 { return c.literal("Auxiliary 20") }
    if position == 33 { return c.literal("Auxiliary 21") }
    if position == 34 { return c.literal("Auxiliary 22") }
    if position == 35 { return c.literal("Auxiliary 23") }
    if position == 36 { return c.literal("Auxiliary 24") }
    if position == 37 { return c.literal("Auxiliary 25") }
    if position == 38 { return c.literal("Auxiliary 26") }
    if position == 39 { return c.literal("Auxiliary 27") }
    if position == 40 { return c.literal("Auxiliary 28") }
    if position == 41 { return c.literal("Auxiliary 29") }
    if position == 42 { return c.literal("Auxiliary 30") }
    if position == 43 { return c.literal("Auxiliary 31") }
    if position == 44 { return c.literal("Top Center") }
    if position == 45 { return c.literal("Top Front Left") }
    if position == 46 { return c.literal("Top Front Right") }
    if position == 47 { return c.literal("Top Front Center") }
    if position == 48 { return c.literal("Top Rear Left") }
    if position == 49 { return c.literal("Top Rear Right") }
    if position == 50 { return c.literal("Top Rear Center") }
    return 0
}

pub fn positionFromName(text: []const u8) -> u32 {
    if c.same(text, "left") { return FRONT_LEFT }
    if c.same(text, "right") { return FRONT_RIGHT }
    if c.same(text, "center") { return FRONT_CENTER }
    if c.same(text, "subwoofer") { return LFE }
    var position: u32 = 0
    while position < POSITIONS {
        if c.same(text, c.slice(positionName(position))) { return position }
        position += 1
    }
    return INVALID
}
