// What the library needs of the C world it lives in: it is loaded into C
// programs (Firefox, Chromium, SDL games, pactl), so memory it hands them
// comes from their allocator (they may free it), the threads it starts are
// their C library's (callbacks run C code that needs its thread state) and
// the environment is theirs as it is now (getenv: they may have changed
// it). Everything else is the library's own: memory access, strings,
// clocks, and locks on the kernel's futexes (FUTEX_LOCK_PI takes and gives
// a lock atomically in the kernel, so no atomic instructions are needed
// here).
extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn realloc(address: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void
extern("c") fn getenv(name: [*]const u8) -> usize
extern("c") fn pthread_create(thread: *u64, attributes: usize, start: usize, argument: usize) -> i32
extern("c") fn pthread_join(thread: u64, result: usize) -> i32

const std = @import("std")

// ---------------------------------------------------------------------------
// Memory

// `size` bytes, zeroed (0 when there is no memory).
pub fn alloc(size: usize) -> usize { return calloc(1, if size == 0 { 1 } else { size }) }

pub fn release(address: usize) -> void {
    if address != 0 { free(address) }
}

pub fn grow(address: usize, size: usize) -> usize { return realloc(address, size) }

pub fn bytes(address: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, address) }
}

pub fn get8(address: usize, offset: usize) -> u8 { return bytes(address)[offset] }

pub fn put8(address: usize, offset: usize, value: u8) -> void { bytes(address)[offset] = value }

pub fn get32(address: usize, offset: usize) -> u32 {
    var words: [*]const u32 = undefined
    unsafe { words = @ptrFromInt([*]const u32, address + offset) }
    return words[0]
}

pub fn put32(address: usize, offset: usize, value: u32) -> void {
    var words: [*]u32 = undefined
    unsafe { words = @ptrFromInt([*]u32, address + offset) }
    words[0] = value
}

pub fn get64(address: usize, offset: usize) -> u64 {
    var words: [*]const u64 = undefined
    unsafe { words = @ptrFromInt([*]const u64, address + offset) }
    return words[0]
}

pub fn put64(address: usize, offset: usize, value: u64) -> void {
    var words: [*]u64 = undefined
    unsafe { words = @ptrFromInt([*]u64, address + offset) }
    words[0] = value
}

pub fn getPointer(address: usize, offset: usize) -> usize { return @intCast(usize, get64(address, offset)) }

pub fn putPointer(address: usize, offset: usize, value: usize) -> void { put64(address, offset, @intCast(u64, value)) }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    var to = bytes(target)
    var from = bytes(source)
    var index: usize = 0
    while index + 8 <= count {
        put64(target, index, get64(source, index))
        index += 8
    }
    while index < count {
        to[index] = from[index]
        index += 1
    }
}

pub fn zero(target: usize, count: usize) -> void {
    var to = bytes(target)
    var index: usize = 0
    while index < count {
        to[index] = 0
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Strings: C's (NUL-terminated, at an address; 0 is none) and Mlx's slices

pub fn length(text: usize) -> usize {
    if text == 0 { return 0 }
    var count: usize = 0
    while get8(text, count) != 0 { count += 1 }
    return count
}

pub fn slice(text: usize) -> []const u8 {
    if text == 0 { return "" }
    return bytes(text)[0..length(text)]
}

pub fn literal(text: []const u8) -> usize {
    unsafe { return @intFromPtr(@ptrCast([*]const u8, text)) }
}

// A C copy of `text` (0 when there is no memory).
pub fn duplicate(text: []const u8) -> usize {
    const copied = alloc(text.length + 1)
    if copied == 0 { return 0 }
    var index: usize = 0
    while index < text.length {
        put8(copied, index, text[index])
        index += 1
    }
    return copied
}

pub fn duplicateC(text: usize) -> usize {
    if text == 0 { return 0 }
    return duplicate(slice(text))
}

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

pub fn startsWith(text: []const u8, prefix: []const u8) -> bool { return text.length >= prefix.length && same(text[0..prefix.length], prefix) }

// The environment's value for `name` (NUL-terminated), "" when unset.
pub fn environment(name: []const u8) -> []const u8 { return slice(getenv(bytes(literal(name)))) }

// Text into a C buffer of `capacity` bytes, always NUL-terminated.
pub const Out = struct {
    buffer: usize
    capacity: usize
    length: usize
}

pub fn out(buffer: usize, capacity: usize) -> Out {
    if buffer != 0 && capacity > 0 { put8(buffer, 0, 0) }
    return Out.{ .buffer = buffer, .capacity = capacity, .length = 0 }
}

pub fn append(writing: *Out, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        appendByte(writing, text[index])
        index += 1
    }
}

pub fn appendByte(writing: *Out, value: u8) -> void {
    if writing.*.buffer == 0 || writing.*.length + 1 >= writing.*.capacity { return }
    put8(writing.*.buffer, writing.*.length, value)
    writing.*.length += 1
    put8(writing.*.buffer, writing.*.length, 0)
}

pub fn appendNumber(writing: *Out, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        appendByte(writing, digits[count])
    }
}

pub fn appendSigned(writing: *Out, value: i64) -> void {
    if value < 0 {
        appendByte(writing, 45)
        appendNumber(writing, @intCast(u64, 0 - value))
    } else {
        appendNumber(writing, @intCast(u64, value))
    }
}

// `value` with `decimals` digits after the point, rounded as printf does
// (to the nearest, a half to the even digit).
pub fn appendFixed(writing: *Out, value: f64, decimals: usize) -> void {
    var number = value
    if number < 0.0 {
        appendByte(writing, 45)
        number = 0.0 - number
    }
    var scale: u64 = 1
    var index: usize = 0
    while index < decimals {
        scale = scale * 10
        index += 1
    }
    const factor: f64 = @floatFromInt(f64, @intCast(i64, scale))
    const exact: f64 = number * factor
    var scaled: i64 = @intFromFloat(i64, exact)
    const below: f64 = @floatFromInt(f64, scaled)
    const rest: f64 = exact - below
    if rest > 0.5 || (rest == 0.5 && scaled % 2 == 1) { scaled += 1 }
    const whole = @intCast(u64, scaled) / scale
    var fraction = @intCast(u64, scaled) % scale
    appendNumber(writing, whole)
    if decimals == 0 { return }
    appendByte(writing, 46)
    var divisor = scale / 10
    while divisor > 0 {
        appendByte(writing, @intCast(u8, 48 + fraction / divisor))
        fraction = fraction % divisor
        divisor = divisor / 10
    }
}

// The buffer, for returning (the C functions return what they wrote to).
pub fn result(writing: *Out) -> usize { return writing.*.buffer }

// An unsigned decimal at the start of `text`; `ok` says whether there was
// one (and nothing after it).
pub fn parseNumber(text: []const u8, ok: *bool) -> u64 {
    ok.* = text.length > 0
    var value: u64 = 0
    var index: usize = 0
    while index < text.length {
        if text[index] < 48 || text[index] > 57 {
            ok.* = false
            return value
        }
        value = value * 10 + @intCast(u64, text[index] - 48)
        index += 1
    }
    return value
}

// ---------------------------------------------------------------------------
// Clocks

const SYS_clock_gettime: usize = 228

fn clock(which: usize) -> u64 {
    var time: [2]usize = [2]usize{ 0, 0 }
    const read = std.linux.syscall2(SYS_clock_gettime, which, @intFromPtr(&time))
    return @intCast(u64, time[0]) * 1000000 + @intCast(u64, time[1]) / 1000
}

// CLOCK_MONOTONIC and CLOCK_REALTIME, in microseconds.
pub fn monotonic() -> u64 { return clock(1) }

pub fn realtime() -> u64 { return clock(0) }

// ---------------------------------------------------------------------------
// Calling C

pub const Call1 = fn(usize) -> void
pub const Call2 = fn(usize, usize) -> void
pub const Call3 = fn(usize, usize, usize) -> void
pub const Call4 = fn(usize, usize, usize, usize) -> void
pub const Call5 = fn(usize, usize, usize, usize, usize) -> void
pub const Poll = fn(usize, usize, usize, usize) -> i32
pub const Call1Result = fn(usize) -> usize
pub const Call2Result = fn(usize, usize) -> usize
pub const Call3Result = fn(usize, usize, usize) -> usize
pub const Call4Result = fn(usize, usize, usize, usize) -> usize
pub const Call5Result = fn(usize, usize, usize, usize, usize) -> usize

pub fn call1(function: usize, a: usize) -> void {
    if function == 0 { return }
    var target: Call1 = undefined
    unsafe { target = @ptrFromInt(Call1, function) }
    target(a)
}

pub fn call2(function: usize, a: usize, b: usize) -> void {
    if function == 0 { return }
    var target: Call2 = undefined
    unsafe { target = @ptrFromInt(Call2, function) }
    target(a, b)
}

pub fn call3(function: usize, a: usize, b: usize, c: usize) -> void {
    if function == 0 { return }
    var target: Call3 = undefined
    unsafe { target = @ptrFromInt(Call3, function) }
    target(a, b, c)
}

pub fn call4(function: usize, a: usize, b: usize, c: usize, d: usize) -> void {
    if function == 0 { return }
    var target: Call4 = undefined
    unsafe { target = @ptrFromInt(Call4, function) }
    target(a, b, c, d)
}

pub fn call5(function: usize, a: usize, b: usize, c: usize, d: usize, e: usize) -> void {
    if function == 0 { return }
    var target: Call5 = undefined
    unsafe { target = @ptrFromInt(Call5, function) }
    target(a, b, c, d, e)
}

pub fn call1Result(function: usize, a: usize) -> usize {
    if function == 0 { return 0 }
    var target: Call1Result = undefined
    unsafe { target = @ptrFromInt(Call1Result, function) }
    return target(a)
}

pub fn call2Result(function: usize, a: usize, b: usize) -> usize {
    if function == 0 { return 0 }
    var target: Call2Result = undefined
    unsafe { target = @ptrFromInt(Call2Result, function) }
    return target(a, b)
}

pub fn callPoll(function: usize, a: usize, b: usize, c: usize, d: usize) -> i32 {
    var target: Poll = undefined
    unsafe { target = @ptrFromInt(Poll, function) }
    return target(a, b, c, d)
}

// An int for a C parameter (its low 32 bits are what C reads).
pub fn int(value: i32) -> usize { return @bitCast(usize, @intCast(isize, value)) }

// ---------------------------------------------------------------------------
// Threads and locks

const SYS_gettid: usize = 186
const SYS_futex: usize = 202
const FUTEX_WAIT_PRIVATE: usize = 128
const FUTEX_WAKE_PRIVATE: usize = 129
const FUTEX_LOCK_PI_PRIVATE: usize = 134
const FUTEX_UNLOCK_PI_PRIVATE: usize = 135

pub fn thread() -> u32 { return @intCast(u32, std.linux.syscall0(SYS_gettid)) }

// Starts `entry` (an exported function) on a thread of the C library's;
// its id, 0 when it could not.
pub fn spawn(entry: usize, argument: usize) -> u64 {
    var handle: u64 = 0
    if pthread_create(&handle, 0, entry, argument) != 0 { return 0 }
    return handle
}

pub fn join(handle: u64) -> void { const joined = pthread_join(handle, 0) }

// A recursive lock: the futex word (the owner's thread id, which the
// kernel sets and clears), and how deep the owner holds it. 16 bytes.
pub const LOCK: usize = 16

pub fn lock(address: usize) -> void {
    const self = thread()
    if get32(address, 4) == self && get32(address, 8) > 0 {
        put32(address, 8, get32(address, 8) + 1)
        return
    }
    while std.linux.syscall4(SYS_futex, address, FUTEX_LOCK_PI_PRIVATE, 0, 0) != 0 {}
    put32(address, 4, self)
    put32(address, 8, 1)
}

pub fn unlock(address: usize) -> void {
    const depth = get32(address, 8)
    if depth > 1 {
        put32(address, 8, depth - 1)
        return
    }
    put32(address, 8, 0)
    put32(address, 4, 0)
    const unlocked = std.linux.syscall2(SYS_futex, address, FUTEX_UNLOCK_PI_PRIVATE)
}

// Whether this thread holds the lock.
pub fn holding(address: usize) -> bool { return get32(address, 4) == thread() && get32(address, 8) > 0 }

// A condition: a counter that signals bump (under the lock) and waiters
// sleep on (FUTEX_WAIT returns once it changed).
pub const CONDITION: usize = 8

// Waits for the condition with the lock given up meanwhile (at whatever
// depth it was held), and held again after.
pub fn wait(condition: usize, mutex: usize) -> void {
    const seen = get32(condition, 0)
    const depth = get32(mutex, 8)
    put32(mutex, 8, 1)
    unlock(mutex)
    const waited = std.linux.syscall4(SYS_futex, condition, FUTEX_WAIT_PRIVATE, @intCast(usize, seen), 0)
    lock(mutex)
    put32(mutex, 8, depth)
}

pub fn broadcast(condition: usize) -> void {
    put32(condition, 0, get32(condition, 0) + 1)
    const woken = std.linux.syscall3(SYS_futex, condition, FUTEX_WAKE_PRIVATE, 2147483647)
}

// ---------------------------------------------------------------------------
// Event counters (wake-ups across threads)

const SYS_read: usize = 0
const SYS_write: usize = 1

pub fn counter() -> isize { return std.linux.syscall2(290, 0, 526336) }

pub fn bump(descriptor: isize) -> void {
    var one: u64 = 1
    const written = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(&one), 8)
}

pub fn drain(descriptor: isize) -> void {
    var value: u64 = 0
    const got = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), @intFromPtr(&value), 8)
}

pub fn close(descriptor: isize) -> void {
    if descriptor >= 0 { const closed = std.linux.syscall1(3, @bitCast(usize, descriptor)) }
}

// ---------------------------------------------------------------------------
// The process's anchor: a page at a fixed address for the little the
// library keeps per process (it has no globals): a magic word, then the
// users' fields (mainloop.mlx: the signal pipe). 0 when it is not there
// (and `create` is false) or the address is someone else's.

const ANCHOR: usize = 68920657854464
const ANCHOR_MAGIC: u64 = 5786924168309444941

pub fn anchor(create: bool) -> usize {
    // msync fails (ENOMEM) on an address nothing maps.
    if std.linux.syscall3(26, ANCHOR, 4096, 1) == 0 {
        return if get64(ANCHOR, 0) == ANCHOR_MAGIC { ANCHOR } else { 0 }
    }
    if !create { return 0 }
    // MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE
    const mapped = std.linux.syscall6(9, ANCHOR, 4096, 3, 1048610, @bitCast(usize, @intCast(isize, -1)), 0)
    if mapped != @intCast(isize, ANCHOR) { return 0 }
    put64(ANCHOR, 0, ANCHOR_MAGIC)
    return ANCHOR
}

// A line on stderr when $MLX_PULSE_DEBUG is set: `label` and a number.
pub fn debug(label: []const u8, value: u64) -> void {
    if environment("MLX_PULSE_DEBUG").length == 0 { return }
    var line: [128]u8 = undefined
    var writing = out(@intFromPtr(&line), 128)
    append(&writing, "libpulse: ")
    append(&writing, label)
    append(&writing, " ")
    appendNumber(&writing, value)
    append(&writing, "\n")
    const written = std.linux.syscall3(1, 2, @intFromPtr(&line), length(@intFromPtr(&line)))
}
