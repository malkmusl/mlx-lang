// The little floating-point math volumes need (decibels: logarithms and
// powers of ten; PulseAudio's cubic volume curve: cube roots), on the
// doubles' bits: no libm.
// (Module-level float constants do not reach a plugin's data: these are
// functions.)
fn ln2() -> f64 { return 0.6931471805599453 }

fn ln10() -> f64 { return 2.302585092994046 }

pub const NEGATIVE_INFINITY: u64 = 18442240474082181120

pub fn infinityBelow() -> f64 { return @bitCast(f64, NEGATIVE_INFINITY) }

// The natural logarithm of `x` (> 0): x = m * 2^e with m in [1, 2), and
// ln m = 2 atanh((m - 1) / (m + 1)) as a series.
pub fn ln(x: f64) -> f64 {
    if !(x > 0.0) { return infinityBelow() }
    const bits = @bitCast(u64, x)
    const exponent = @intCast(i64, (bits >> 52) & 2047) - 1023
    const mantissa = @bitCast(f64, (bits & 4503599627370495) | 4607182418800017408)
    const t = (mantissa - 1.0) / (mantissa + 1.0)
    const square = t * t
    var term = t
    var sum: f64 = 0.0
    var odd: f64 = 1.0
    var index: usize = 0
    while index < 24 {
        sum = sum + term / odd
        term = term * square
        odd = odd + 2.0
        index += 1
    }
    const power: f64 = @floatFromInt(f64, exponent)
    return 2.0 * sum + power * ln2()
}

// e^x: x = k ln 2 + r with |r| <= ln 2 / 2, e^r as a series, 2^k in the
// exponent's bits.
pub fn exp(x: f64) -> f64 {
    const infinity: u64 = 9218868437227405312
    if x > 709.0 { return @bitCast(f64, infinity) }
    if x < -745.0 { return 0.0 }
    var half: f64 = 0.5
    if x < 0.0 { half = -0.5 }
    const quotient: f64 = x / ln2() + half
    var k: i64 = @intFromFloat(i64, quotient)
    const whole: f64 = @floatFromInt(f64, k)
    const r: f64 = x - whole * ln2()
    var term: f64 = 1.0
    var sum: f64 = 1.0
    var index: usize = 1
    while index < 24 {
        const divisor: f64 = @floatFromInt(f64, @intCast(i64, index))
        term = term * r / divisor
        sum = sum + term
        index += 1
    }
    // 2^k, in two steps when it would leave the normal range.
    while k > 1000 {
        const big: u64 = 2045
        sum = sum * @bitCast(f64, big << 52)
        k -= 1022
    }
    while k < -1000 {
        const small: u64 = 1
        sum = sum * @bitCast(f64, small << 52)
        k += 1022
    }
    const biased: u64 = @intCast(u64, k + 1023)
    const scale: f64 = @bitCast(f64, biased << 52)
    return sum * scale
}

pub fn log10(x: f64) -> f64 { return ln(x) / ln10() }

// 10^x.
pub fn tenTo(x: f64) -> f64 { return exp(x * ln10()) }

// The cube root of `x` (>= 0): a first guess from the logarithm, then
// Newton's steps.
pub fn cbrt(x: f64) -> f64 {
    if !(x > 0.0) { return 0.0 }
    var y = exp(ln(x) / 3.0)
    var index: usize = 0
    while index < 4 {
        y = y - (y * y * y - x) / (3.0 * y * y)
        index += 1
    }
    return y
}

// Rounded to the nearest whole number (halves away from zero).
pub fn round(x: f64) -> i64 {
    var shifted: f64 = x + 0.5
    if x < 0.0 { shifted = x - 0.5 }
    const result: i64 = @intFromFloat(i64, shifted)
    return result
}
