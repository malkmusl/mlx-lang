// libpulse's streams for C: pa_stream_*.
const c = @import("./c.mlx")
const core = @import("./core.mlx")
const stream = @import("./stream.mlx")
const util = @import("./util.mlx")

const INVALID: u32 = 4294967295

fn ending(owner: usize) -> bool { return core.streamState(owner) == core.S_FAILED || core.streamState(owner) == core.S_TERMINATED }

fn setCallback(owner: usize, field: usize, callback: usize, userdata: usize) -> void {
    if ending(owner) { return }
    c.putPointer(owner, field, callback)
    c.putPointer(owner, field + 8, userdata)
}

export fn pa_stream_new(owner: usize, name: usize, spec: usize, map: usize) -> usize { return stream.new(owner, name, spec, map, 0, 0, 0) }

export fn pa_stream_new_with_proplist(owner: usize, name: usize, spec: usize, map: usize, list: usize) -> usize { return stream.new(owner, name, spec, map, 0, 0, list) }

export fn pa_stream_new_extended(owner: usize, name: usize, formats: usize, count: u32, list: usize) -> usize {
    if count == 0 || formats == 0 {
        const failed = core.fail(owner, util.ERR_INVALID)
        return 0
    }
    return stream.new(owner, name, 0, 0, formats, count, list)
}

export fn pa_stream_ref(owner: usize) -> usize {
    core.streamRef(owner)
    return owner
}

export fn pa_stream_unref(owner: usize) -> void { core.streamUnref(owner) }

export fn pa_stream_get_state(owner: usize) -> i32 { return @bitCast(i32, core.streamState(owner)) }

export fn pa_stream_get_context(owner: usize) -> usize { return core.streamContext(owner) }

export fn pa_stream_get_index(owner: usize) -> u32 { return stream.index(owner) }

export fn pa_stream_get_device_index(owner: usize) -> u32 { return stream.deviceIndex(owner) }

export fn pa_stream_get_device_name(owner: usize) -> usize { return stream.deviceName(owner) }

export fn pa_stream_is_suspended(owner: usize) -> i32 { return stream.isSuspended(owner) }

export fn pa_stream_is_corked(owner: usize) -> i32 { return stream.isCorked(owner) }

export fn pa_stream_connect_playback(owner: usize, device: usize, attributes: usize, flags: u32, levels: usize, sync: usize) -> i32 { return stream.connect(owner, core.PLAYBACK, device, attributes, flags, levels, sync) }

export fn pa_stream_connect_record(owner: usize, device: usize, attributes: usize, flags: u32) -> i32 { return stream.connect(owner, core.RECORD, device, attributes, flags, 0, 0) }

export fn pa_stream_connect_upload(owner: usize, length: usize) -> i32 { return stream.connectUpload(owner, length) }

export fn pa_stream_finish_upload(owner: usize) -> i32 { return stream.finishUpload(owner) }

export fn pa_stream_disconnect(owner: usize) -> i32 { return stream.disconnect(owner) }

export fn pa_stream_begin_write(owner: usize, data: usize, size: usize) -> i32 { return stream.beginWrite(owner, data, size) }

export fn pa_stream_cancel_write(owner: usize) -> i32 { return stream.cancelWrite(owner) }

export fn pa_stream_write(owner: usize, data: usize, length: usize, free: usize, offset: i64, seek: u32) -> i32 { return stream.write(owner, data, length, free, data, offset, seek) }

export fn pa_stream_write_ext_free(owner: usize, data: usize, length: usize, free: usize, freeData: usize, offset: i64, seek: u32) -> i32 { return stream.write(owner, data, length, free, freeData, offset, seek) }

export fn pa_stream_peek(owner: usize, data: usize, length: usize) -> i32 { return stream.peek(owner, data, length) }

export fn pa_stream_drop(owner: usize) -> i32 { return stream.drop(owner) }

export fn pa_stream_writable_size(owner: usize) -> usize { return stream.writableSize(owner) }

export fn pa_stream_readable_size(owner: usize) -> usize { return stream.readableSize(owner) }

export fn pa_stream_drain(owner: usize, callback: usize, userdata: usize) -> usize { return stream.drain(owner, callback, userdata) }

export fn pa_stream_update_timing_info(owner: usize, callback: usize, userdata: usize) -> usize { return stream.updateTiming(owner, callback, userdata) }

export fn pa_stream_set_state_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_STATE_CALLBACK, callback, userdata) }

export fn pa_stream_set_write_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_WRITE_CALLBACK, callback, userdata) }

export fn pa_stream_set_read_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_READ_CALLBACK, callback, userdata) }

export fn pa_stream_set_overflow_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_OVERFLOW_CALLBACK, callback, userdata) }

export fn pa_stream_set_underflow_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_UNDERFLOW_CALLBACK, callback, userdata) }

export fn pa_stream_set_started_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_STARTED_CALLBACK, callback, userdata) }

export fn pa_stream_set_latency_update_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_LATENCY_CALLBACK, callback, userdata) }

export fn pa_stream_set_moved_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_MOVED_CALLBACK, callback, userdata) }

export fn pa_stream_set_suspended_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_SUSPENDED_CALLBACK, callback, userdata) }

export fn pa_stream_set_event_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_EVENT_CALLBACK, callback, userdata) }

export fn pa_stream_set_buffer_attr_callback(owner: usize, callback: usize, userdata: usize) -> void { setCallback(owner, core.S_BUFFER_ATTR_CALLBACK, callback, userdata) }

export fn pa_stream_get_underflow_index(owner: usize) -> i64 { return @bitCast(i64, c.get64(owner, core.S_UNDERFLOW_INDEX)) }

export fn pa_stream_cork(owner: usize, corked: i32, callback: usize, userdata: usize) -> usize { return stream.cork(owner, corked != 0, callback, userdata) }

export fn pa_stream_flush(owner: usize, callback: usize, userdata: usize) -> usize { return stream.flush(owner, callback, userdata) }

export fn pa_stream_prebuf(owner: usize, callback: usize, userdata: usize) -> usize { return stream.prebuf(owner, callback, userdata) }

export fn pa_stream_trigger(owner: usize, callback: usize, userdata: usize) -> usize { return stream.trigger(owner, callback, userdata) }

export fn pa_stream_set_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return stream.setName(owner, name, callback, userdata) }

export fn pa_stream_get_time(owner: usize, result: usize) -> i32 { return stream.getTime(owner, result) }

export fn pa_stream_get_latency(owner: usize, result: usize, negative: usize) -> i32 { return stream.getLatency(owner, result, negative) }

export fn pa_stream_get_timing_info(owner: usize) -> usize { return stream.timingInfo(owner) }

export fn pa_stream_get_sample_spec(owner: usize) -> usize { return owner + core.S_SPEC }

export fn pa_stream_get_channel_map(owner: usize) -> usize { return owner + core.S_MAP }

export fn pa_stream_get_format_info(owner: usize) -> usize { return stream.formatInfo(owner) }

export fn pa_stream_get_buffer_attr(owner: usize) -> usize { return stream.bufferAttr(owner) }

export fn pa_stream_set_buffer_attr(owner: usize, attributes: usize, callback: usize, userdata: usize) -> usize { return stream.setBufferAttr(owner, attributes, callback, userdata) }

export fn pa_stream_update_sample_rate(owner: usize, rate: u32, callback: usize, userdata: usize) -> usize { return stream.updateSampleRate(owner, rate, callback, userdata) }

export fn pa_stream_proplist_update(owner: usize, mode: u32, list: usize, callback: usize, userdata: usize) -> usize { return stream.proplistUpdate(owner, mode, list, callback, userdata) }

export fn pa_stream_proplist_remove(owner: usize, keys: usize, callback: usize, userdata: usize) -> usize { return stream.proplistRemove(owner, keys, callback, userdata) }

export fn pa_stream_set_monitor_stream(owner: usize, input: u32) -> i32 { return stream.setMonitorStream(owner, input) }

export fn pa_stream_get_monitor_stream(owner: usize) -> u32 { return stream.monitorStream(owner) }
