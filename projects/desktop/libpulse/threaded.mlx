// pa_threaded_mainloop: a pa_mainloop on a thread of its own, with a lock
// the program takes around everything it does with the library (the loop
// holds it while it dispatches and gives it up while it polls), and a
// condition the callbacks signal and the program waits on.
const std = @import("std")
const turns_module = @import("std.turns")
const c = @import("./c.mlx")
const mainloop = @import("./mainloop.mlx")

extern("c") fn pthread_setname_np(thread: u64, name: [*]const u8) -> i32
extern("c") fn pthread_self() -> u64

const SIZE: usize = 128
const LOOP: usize = 0
const THREAD: usize = 8
const MUTEX: usize = 16
const CONDITION: usize = 32
const ACCEPT: usize = 40
const WAITING_FOR_ACCEPT: usize = 48
const THREAD_ID: usize = 56
const NAME: usize = 64
const RUNNING: usize = 72

// The poll function: the lock is given up while the loop waits.
export fn mlx_pulse_threaded_poll(fds: usize, count: usize, timeout: i32, threaded: usize) -> i32 {
    const mutex = threaded + MUTEX
    const depth = c.get32(mutex, 8)
    c.put32(mutex, 8, 1)
    c.unlock(mutex)
    var polled = std.linux.syscall3(7, fds, count, c.int(timeout))
    c.lock(mutex)
    c.put32(mutex, 8, depth)
    if polled == -4 { polled = 0 }
    return @intCast(i32, polled)
}

// The loop's thread: signals stay with the program's other threads.
export fn mlx_pulse_threaded_main(threaded: usize) -> usize {
    var all: u64 = 18446744073709551615
    const masked = std.linux.syscall4(14, 0, @intFromPtr(&all), 0, 8)
    c.put32(threaded, THREAD_ID, c.thread())
    const name = c.getPointer(threaded, NAME)
    if name != 0 { const named = pthread_setname_np(pthread_self(), c.bytes(name)) }
    const mutex = threaded + MUTEX
    c.lock(mutex)
    const loop = c.getPointer(threaded, LOOP)
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    while true {
        turns_module.turn(&turns)
        if mainloop.iterate(loop, true, 0) < 0 { break }
    }
    c.unlock(mutex)
    return 0
}

pub fn new() -> usize {
    const threaded = c.alloc(SIZE)
    if threaded == 0 { return 0 }
    const loop = mainloop.new()
    if loop == 0 {
        c.release(threaded)
        return 0
    }
    c.putPointer(threaded, LOOP, loop)
    c.putPointer(threaded, NAME, c.duplicate("threaded-ml"))
    mainloop.setPollFunction(loop, @intFromPtr(mlx_pulse_threaded_poll), threaded)
    return threaded
}

pub fn loopOf(threaded: usize) -> usize { return c.getPointer(threaded, LOOP) }

pub fn inThread(threaded: usize) -> bool { return c.get32(threaded, RUNNING) != 0 && c.get32(threaded, THREAD_ID) == c.thread() }

pub fn start(threaded: usize) -> i32 {
    if c.get32(threaded, RUNNING) != 0 { return -1 }
    mainloop.resume(c.getPointer(threaded, LOOP))
    const handle = c.spawn(@intFromPtr(mlx_pulse_threaded_main), threaded)
    if handle == 0 { return -1 }
    c.put64(threaded, THREAD, handle)
    c.put32(threaded, RUNNING, 1)
    return 0
}

pub fn stop(threaded: usize) -> void {
    if c.get32(threaded, RUNNING) == 0 || inThread(threaded) { return }
    lock(threaded)
    mainloop.quit(c.getPointer(threaded, LOOP), 0)
    unlock(threaded)
    c.join(c.get64(threaded, THREAD))
    c.put32(threaded, RUNNING, 0)
}

pub fn free(threaded: usize) -> void {
    if threaded == 0 { return }
    if !inThread(threaded) { stop(threaded) }
    mainloop.free(c.getPointer(threaded, LOOP))
    c.release(c.getPointer(threaded, NAME))
    c.release(threaded)
}

pub fn lock(threaded: usize) -> void { c.lock(threaded + MUTEX) }

pub fn unlock(threaded: usize) -> void { c.unlock(threaded + MUTEX) }

pub fn wait(threaded: usize) -> void { c.wait(threaded + CONDITION, threaded + MUTEX) }

pub fn signal(threaded: usize, waitForAccept: bool) -> void {
    c.broadcast(threaded + CONDITION)
    if !waitForAccept { return }
    c.put32(threaded, WAITING_FOR_ACCEPT, c.get32(threaded, WAITING_FOR_ACCEPT) + 1)
    while c.get32(threaded, WAITING_FOR_ACCEPT) > 0 { c.wait(threaded + ACCEPT, threaded + MUTEX) }
}

pub fn accept(threaded: usize) -> void {
    if c.get32(threaded, WAITING_FOR_ACCEPT) > 0 { c.put32(threaded, WAITING_FOR_ACCEPT, c.get32(threaded, WAITING_FOR_ACCEPT) - 1) }
    c.broadcast(threaded + ACCEPT)
}

pub fn setName(threaded: usize, name: usize) -> void {
    c.release(c.getPointer(threaded, NAME))
    c.putPointer(threaded, NAME, c.duplicateC(name))
    if c.get32(threaded, RUNNING) != 0 && name != 0 { const named = pthread_setname_np(c.get64(threaded, THREAD), c.bytes(name)) }
}

// pa_threaded_mainloop_once_unlocked: `callback(threaded, userdata)` once
// from the loop's thread, without the lock.
export fn mlx_pulse_once_unlocked(api: usize, data: usize) -> void {
    const threaded = c.getPointer(data, 0)
    unlock(threaded)
    c.call2(c.getPointer(data, 8), threaded, c.getPointer(data, 16))
    lock(threaded)
    c.release(data)
}

pub fn onceUnlocked(threaded: usize, callback: usize, userdata: usize) -> void {
    const data = c.alloc(24)
    c.putPointer(data, 0, threaded)
    c.putPointer(data, 8, callback)
    c.putPointer(data, 16, userdata)
    mainloop.once(c.getPointer(threaded, LOOP), @intFromPtr(mlx_pulse_once_unlocked), data)
}
