// The printf formats libpulse's variadic functions take
// (pa_proplist_setf): %d %i %u %x %X %o %c %s %p %f %g %e %%, with flags
// (-, 0, +, space), a width and precision (numbers or *), and the length
// modifiers (hh h l ll z j t). The arguments come as the integer registers
// and stack slots the call filled, and the double registers.
const c = @import("./c.mlx")
const util = @import("./util.mlx")

fn digitsOf(value: u64, base: u64, upper: bool, buffer: *[32]u8) -> usize {
    var count: usize = 0
    var rest = value
    while true {
        const digit = @intCast(u8, rest % base)
        buffer.*[count] = if digit < 10 { 48 + digit } else { (if upper { 55 } else { 87 }) + digit }
        count += 1
        rest = rest / base
        if rest == 0 { break }
    }
    return count
}

fn pad(writing: *util.Text, count: usize, fill: u8) -> void {
    var index: usize = 0
    while index < count {
        util.addByte(writing, fill)
        index += 1
    }
}

// `text` in a field of `width` (left-aligned with `left`).
fn field(writing: *util.Text, text: []const u8, width: usize, left: bool) -> void {
    if !left && width > text.length { pad(writing, width - text.length, 32) }
    util.add(writing, text)
    if left && width > text.length { pad(writing, width - text.length, 32) }
}

pub fn format(pattern: []const u8, integers: usize, integerCount: usize, doubles: usize, doubleCount: usize) -> usize {
    var writing = util.text()
    var nextInteger: usize = 0
    var nextDouble: usize = 0
    var at: usize = 0
    while at < pattern.length {
        const byte = pattern[at]
        at += 1
        if byte != 37 || at >= pattern.length {
            util.addByte(&writing, byte)
            continue
        }
        var left = false
        var zero = false
        var plus = false
        var space = false
        while at < pattern.length {
            const flag = pattern[at]
            if flag == 45 { left = true } else if flag == 48 { zero = true } else if flag == 43 { plus = true } else if flag == 32 { space = true } else { break }
            at += 1
        }
        var width: usize = 0
        if at < pattern.length && pattern[at] == 42 {
            if nextInteger < integerCount { width = @intCast(usize, c.get64(integers, nextInteger * 8) & 65535) }
            nextInteger += 1
            at += 1
        }
        while at < pattern.length && pattern[at] >= 48 && pattern[at] <= 57 {
            width = width * 10 + @intCast(usize, pattern[at] - 48)
            at += 1
        }
        var precision: usize = 6
        var hasPrecision = false
        if at < pattern.length && pattern[at] == 46 {
            hasPrecision = true
            precision = 0
            at += 1
            if at < pattern.length && pattern[at] == 42 {
                if nextInteger < integerCount { precision = @intCast(usize, c.get64(integers, nextInteger * 8) & 65535) }
                nextInteger += 1
                at += 1
            }
            while at < pattern.length && pattern[at] >= 48 && pattern[at] <= 57 {
                precision = precision * 10 + @intCast(usize, pattern[at] - 48)
                at += 1
            }
        }
        // The length: 1, 2, 4 or 8 bytes.
        var size: usize = 4
        while at < pattern.length {
            const modifier = pattern[at]
            if modifier == 104 {
                size = if size == 2 { 1 } else { 2 }
            } else if modifier == 108 || modifier == 122 || modifier == 106 || modifier == 116 || modifier == 76 || modifier == 113 {
                size = 8
            } else {
                break
            }
            at += 1
        }
        if at >= pattern.length { break }
        const conversion = pattern[at]
        at += 1
        if conversion == 37 {
            util.addByte(&writing, 37)
            continue
        }
        if conversion == 102 || conversion == 70 || conversion == 103 || conversion == 71 || conversion == 101 || conversion == 69 {
            var value: f64 = 0.0
            if nextDouble < doubleCount {
                const bits = c.get64(doubles, nextDouble * 8)
                value = @bitCast(f64, bits)
            }
            nextDouble += 1
            var number = util.text()
            if value < 0.0 {
                util.addByte(&number, 45)
                value = 0.0 - value
            } else if plus {
                util.addByte(&number, 43)
            }
            // %g: up to six significant digits, no trailing zeros.
            var decimals = precision
            if conversion == 103 || conversion == 71 {
                var whole: u64 = 1
                var digits: usize = 1
                while value >= @floatFromInt(f64, @intCast(i64, whole * 10)) && digits < 18 {
                    whole = whole * 10
                    digits += 1
                }
                const significant = if hasPrecision { if precision == 0 { 1 } else { precision } } else { 6 }
                decimals = if significant > digits { significant - digits } else { 0 }
            }
            var fixed: [64]u8 = undefined
            var out = c.out(@intFromPtr(&fixed), 64)
            c.appendFixed(&out, value, decimals)
            var printed = c.slice(@intFromPtr(&fixed))
            if (conversion == 103 || conversion == 71) && decimals > 0 {
                var end = printed.length
                while end > 0 && printed[end - 1] == 48 { end -= 1 }
                if end > 0 && printed[end - 1] == 46 { end -= 1 }
                printed = printed[0..end]
            }
            util.add(&number, printed)
            const text = util.finish(&number)
            field(&writing, c.slice(text), width, left)
            c.release(text)
            continue
        }
        var raw: u64 = 0
        if nextInteger < integerCount { raw = c.get64(integers, nextInteger * 8) }
        nextInteger += 1
        if conversion == 115 {
            var text = if raw == 0 { "(null)" } else { c.slice(@intCast(usize, raw)) }
            if hasPrecision && text.length > precision { text = text[0..precision] }
            field(&writing, text, width, left)
            continue
        }
        if conversion == 99 {
            var one: [1]u8 = [1]u8{ @intCast(u8, raw & 255) }
            var bytes: [*]const u8 = undefined
            unsafe { bytes = @ptrCast([*]const u8, &one) }
            field(&writing, bytes[0..1], width, left)
            continue
        }
        var negative = false
        var magnitude = raw
        var base: u64 = 10
        if size == 1 { magnitude = raw & 255 } else if size == 2 { magnitude = raw & 65535 } else if size == 4 { magnitude = raw & 4294967295 }
        if conversion == 100 || conversion == 105 {
            // The sign bit of the argument's width.
            const top: u64 = if size == 1 { 128 } else { if size == 2 { 32768 } else { if size == 4 { 2147483648 } else { 9223372036854775808 } } }
            negative = magnitude & top != 0
            if negative {
                const width_mask: u64 = if size == 8 { 18446744073709551615 } else { top * 2 - 1 }
                magnitude = (~magnitude + 1) & width_mask
            }
        } else if conversion == 120 || conversion == 88 || conversion == 112 {
            base = 16
            if conversion == 112 { magnitude = raw }
        } else if conversion == 111 {
            base = 8
        }
        var digits: [32]u8 = undefined
        const count = digitsOf(magnitude, base, conversion == 88, &digits)
        var number = util.text()
        if negative { util.addByte(&number, 45) } else if plus && (conversion == 100 || conversion == 105) { util.addByte(&number, 43) } else if space && (conversion == 100 || conversion == 105) { util.addByte(&number, 32) }
        if conversion == 112 { util.add(&number, "0x") }
        if hasPrecision && precision > count { pad(&number, precision - count, 48) }
        const sign = number.length
        if zero && !left && !hasPrecision && width > sign + count { pad(&number, width - sign - count, 48) }
        var index = count
        while index > 0 {
            index -= 1
            util.addByte(&number, digits[index])
        }
        const text = util.finish(&number)
        field(&writing, c.slice(text), width, left)
        c.release(text)
    }
    return util.finish(&writing)
}
