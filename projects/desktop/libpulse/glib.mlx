// libpulse-mainloop-glib.so.0 in Mlx: PulseAudio's main loop interface on
// a GLib main context (pa_glib_mainloop, for GTK programs: pavucontrol,
// volume applets). A GSource drives a loop of this directory's
// (mainloop.mlx): it prepares it (the time to wait), hands its descriptors
// to GLib to poll, and dispatches it.
//
//   mlx4 --plugin --library libglib-2.0.so.0 --soname=libpulse-mainloop-glib.so.0 \
//       --symbol-version=PULSE_0 projects/desktop/libpulse/glib.mlx -o libpulse-mainloop-glib.so.0
const c = @import("./c.mlx")
const mainloop = @import("./mainloop.mlx")

extern("c") fn g_source_new(functions: usize, size: u32) -> usize
extern("c") fn g_source_attach(source: usize, context: usize) -> u32
extern("c") fn g_source_destroy(source: usize) -> void
extern("c") fn g_source_unref(source: usize) -> void
extern("c") fn g_source_set_can_recurse(source: usize, can: i32) -> void
extern("c") fn g_source_add_poll(source: usize, fd: usize) -> void
extern("c") fn g_source_remove_poll(source: usize, fd: usize) -> void
extern("c") fn g_main_context_default() -> usize
extern("c") fn g_main_context_ref(context: usize) -> usize
extern("c") fn g_main_context_unref(context: usize) -> void

// struct GSource is 96 bytes; ours carries the pa_glib_mainloop after it.
const SOURCE_SIZE: u32 = 104
const SOURCE_OWNER: usize = 96

// pa_glib_mainloop: the GSource, its GSourceFuncs, the GLib context, the
// loop, and the descriptors handed to GLib (GPollFD, as pollfd) and their
// count.
const SIZE: usize = 64
const SOURCE: usize = 0
const FUNCTIONS: usize = 8
const CONTEXT: usize = 16
const LOOP: usize = 24
const POLLS: usize = 32
const POLL_COUNT: usize = 40

fn ownerOf(source: usize) -> usize { return c.getPointer(source, SOURCE_OWNER) }

// Gives GLib the descriptors the loop just chose.
fn handOver(glib: usize) -> void {
    const source = c.getPointer(glib, SOURCE)
    const loop = c.getPointer(glib, LOOP)
    var polls = c.getPointer(glib, POLLS)
    const count = c.getPointer(glib, POLL_COUNT)
    const wanted = mainloop.pollCount(loop)
    var same = count == wanted
    var index: usize = 0
    while same && index < count {
        if c.get64(polls, index * 8) & 281474976710655 != c.get64(mainloop.pollfds(loop), index * 8) & 281474976710655 { same = false }
        index += 1
    }
    if same { return }
    index = 0
    while index < count {
        g_source_remove_poll(source, polls + index * 8)
        index += 1
    }
    c.release(polls)
    polls = c.alloc(wanted * 8)
    c.copy(polls, mainloop.pollfds(loop), wanted * 8)
    index = 0
    while index < wanted {
        c.put32(polls, index * 8 + 4, c.get32(polls, index * 8 + 4) & 65535)
        g_source_add_poll(source, polls + index * 8)
        index += 1
    }
    c.putPointer(glib, POLLS, polls)
    c.putPointer(glib, POLL_COUNT, wanted)
}

export fn mlx_pulse_glib_prepare(source: usize, timeout: usize) -> i32 {
    const glib = ownerOf(source)
    const loop = c.getPointer(glib, LOOP)
    if mainloop.prepare(loop, -1) < 0 {
        c.put32(timeout, 0, @bitCast(u32, @intCast(i32, -1)))
        return 0
    }
    handOver(glib)
    c.put32(timeout, 0, @bitCast(u32, mainloop.timeout(loop)))
    return if mainloop.timeout(loop) == 0 { 1 } else { 0 }
}

// What GLib's poll found goes back into the loop's array.
export fn mlx_pulse_glib_check(source: usize) -> i32 {
    const glib = ownerOf(source)
    const loop = c.getPointer(glib, LOOP)
    const polls = c.getPointer(glib, POLLS)
    var found: i32 = 0
    var index: usize = 0
    while index < c.getPointer(glib, POLL_COUNT) && index < mainloop.pollCount(loop) {
        const revents = c.get32(polls, index * 8 + 4) & 4294901760
        const at = mainloop.pollfds(loop) + index * 8 + 4
        c.put32(at, 0, (c.get32(at, 0) & 65535) | revents)
        if revents != 0 { found += 1 }
        index += 1
    }
    mainloop.setPolled(loop, found)
    return if found > 0 || mainloop.due(loop) { 1 } else { 0 }
}

export fn mlx_pulse_glib_dispatch(source: usize, callback: usize, userdata: usize) -> i32 {
    const glib = ownerOf(source)
    const dispatched = mainloop.dispatch(c.getPointer(glib, LOOP))
    return 1
}

export fn pa_glib_mainloop_new(context: usize) -> usize {
    const glib = c.alloc(SIZE)
    const loop = mainloop.new()
    if glib == 0 || loop == 0 {
        c.release(glib)
        return 0
    }
    c.putPointer(glib, LOOP, loop)
    const owned = if context != 0 { context } else { g_main_context_default() }
    c.putPointer(glib, CONTEXT, g_main_context_ref(owned))
    // GSourceFuncs: prepare, check, dispatch, finalize, and two closure
    // functions.
    const functions = c.alloc(48)
    c.putPointer(functions, 0, @intFromPtr(mlx_pulse_glib_prepare))
    c.putPointer(functions, 8, @intFromPtr(mlx_pulse_glib_check))
    c.putPointer(functions, 16, @intFromPtr(mlx_pulse_glib_dispatch))
    c.putPointer(glib, FUNCTIONS, functions)
    const source = g_source_new(functions, SOURCE_SIZE)
    c.putPointer(source, SOURCE_OWNER, glib)
    c.putPointer(glib, SOURCE, source)
    g_source_set_can_recurse(source, 0)
    const attached = g_source_attach(source, c.getPointer(glib, CONTEXT))
    return glib
}

export fn pa_glib_mainloop_free(glib: usize) -> void {
    if glib == 0 { return }
    const source = c.getPointer(glib, SOURCE)
    var index: usize = 0
    while index < c.getPointer(glib, POLL_COUNT) {
        g_source_remove_poll(source, c.getPointer(glib, POLLS) + index * 8)
        index += 1
    }
    g_source_destroy(source)
    g_source_unref(source)
    mainloop.free(c.getPointer(glib, LOOP))
    g_main_context_unref(c.getPointer(glib, CONTEXT))
    c.release(c.getPointer(glib, POLLS))
    c.release(c.getPointer(glib, FUNCTIONS))
    c.release(glib)
}

// The loop's table (its first field).
export fn pa_glib_mainloop_get_api(glib: usize) -> usize { return c.getPointer(glib, LOOP) }
