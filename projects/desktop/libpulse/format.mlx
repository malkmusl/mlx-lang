// Stream formats (pa_format_info: encoding i32, then its property list;
// 16 bytes). The properties' values are JSON, as PulseAudio writes them:
// 44100, "s16le", [ 44100, 48000 ], [ "a", "b" ] or { "min": 1, "max": 8 }.
const c = @import("./c.mlx")
const util = @import("./util.mlx")
const proplist = @import("./proplist.mlx")
const sample = @import("./sample.mlx")
const channels = @import("./channels.mlx")

pub const SIZE: usize = 16
const ENCODING: usize = 0
const PLIST: usize = 8

pub const SAMPLE_FORMAT: []const u8 = "format.sample_format"
pub const RATE: []const u8 = "format.rate"
pub const CHANNELS: []const u8 = "format.channels"
pub const CHANNEL_MAP: []const u8 = "format.channel_map"

// pa_prop_type_t.
pub const TYPE_INT: i32 = 0
pub const TYPE_INT_RANGE: i32 = 1
pub const TYPE_INT_ARRAY: i32 = 2
pub const TYPE_STRING: i32 = 3
pub const TYPE_STRING_ARRAY: i32 = 4
pub const TYPE_INVALID: i32 = -1

pub fn encoding(format: usize) -> i32 { return @bitCast(i32, c.get32(format, ENCODING)) }

pub fn setEncoding(format: usize, value: i32) -> void { c.put32(format, ENCODING, @bitCast(u32, value)) }

pub fn properties(format: usize) -> usize { return c.getPointer(format, PLIST) }

pub fn new() -> usize {
    const format = c.alloc(SIZE)
    if format == 0 { return 0 }
    setEncoding(format, util.ENCODING_INVALID)
    c.putPointer(format, PLIST, proplist.new())
    return format
}

pub fn copy(source: usize) -> usize {
    const format = c.alloc(SIZE)
    if format == 0 { return 0 }
    setEncoding(format, encoding(source))
    if properties(source) != 0 { c.putPointer(format, PLIST, proplist.copy(properties(source))) }
    return format
}

pub fn free(format: usize) -> void {
    if format == 0 { return }
    proplist.free(properties(format))
    c.release(format)
}

pub fn valid(format: usize) -> bool { return encoding(format) >= 0 && encoding(format) < util.ENCODING_MAX && properties(format) != 0 }

pub fn isPcm(format: usize) -> bool { return encoding(format) == util.ENCODING_PCM }

// "pcm, format.rate = \"44100\"  ..." or "(invalid)".
pub fn print(buffer: usize, capacity: usize, format: usize) -> usize {
    var writing = c.out(buffer, capacity)
    if !valid(format) {
        c.append(&writing, "(invalid)")
        return c.result(&writing)
    }
    c.append(&writing, c.slice(util.encodingName(encoding(format))))
    const listed = proplist.toString(properties(format), "  ")
    if c.length(listed) > 0 {
        c.append(&writing, ", ")
        c.append(&writing, c.slice(listed))
    }
    c.release(listed)
    return c.result(&writing)
}

fn trimmed(value: []const u8) -> []const u8 {
    var start: usize = 0
    var end = value.length
    while start < end && (value[start] == 32 || value[start] == 9 || value[start] == 10) { start += 1 }
    while end > start && (value[end - 1] == 32 || value[end - 1] == 9 || value[end - 1] == 10) { end -= 1 }
    return value[start..end]
}

// "encoding, properties" back into a format; 0 when it is not one.
pub fn fromString(text: []const u8) -> usize {
    var comma: usize = 0
    while comma < text.length && text[comma] != 44 { comma += 1 }
    const kind = util.encodingFromName(trimmed(text[0..comma]))
    if kind == util.ENCODING_INVALID { return 0 }
    const format = new()
    setEncoding(format, kind)
    if comma < text.length {
        const list = proplist.fromString(text[comma + 1..text.length])
        if list == 0 {
            free(format)
            return 0
        }
        proplist.free(properties(format))
        c.putPointer(format, PLIST, list)
    }
    return format
}

// ---------------------------------------------------------------------------
// The JSON values

fn space(value: u8) -> bool { return value == 32 || value == 9 || value == 10 || value == 13 }

fn skip(text: []const u8, at: usize) -> usize {
    var index = at
    while index < text.length && space(text[index]) { index += 1 }
    return index
}

// An integer at `at` (ok false when there is none); `end` where it ends.
fn integerAt(text: []const u8, at: usize, end: *usize, ok: *bool) -> i64 {
    var index = skip(text, at)
    var negative = false
    if index < text.length && text[index] == 45 {
        negative = true
        index += 1
    }
    const start = index
    var value: i64 = 0
    while index < text.length && text[index] >= 48 && text[index] <= 57 {
        value = value * 10 + @intCast(i64, text[index] - 48)
        index += 1
    }
    ok.* = index > start
    end.* = index
    return if negative { 0 - value } else { value }
}

// A string at `at`: its contents (without the quotes; escapes kept).
fn stringAt(text: []const u8, at: usize, end: *usize, ok: *bool) -> []const u8 {
    var index = skip(text, at)
    ok.* = false
    if index >= text.length || text[index] != 34 { return "" }
    index += 1
    const start = index
    while index < text.length && text[index] != 34 {
        if text[index] == 92 { index += 1 }
        index += 1
    }
    if index >= text.length { return "" }
    ok.* = true
    end.* = index + 1
    return text[start..index]
}

fn integerValue(text: []const u8, ok: *bool) -> i64 {
    var end: usize = 0
    const value = integerAt(text, 0, &end, ok)
    if ok.* && skip(text, end) != text.length { ok.* = false }
    return value
}

fn stringValue(text: []const u8, ok: *bool) -> []const u8 {
    var end: usize = 0
    const value = stringAt(text, 0, &end, ok)
    if ok.* && skip(text, end) != text.length { ok.* = false }
    return value
}

// The array's items: calls back for each as integer or string (`strings`).
fn arrayCount(text: []const u8, strings: bool, ok: *bool) -> usize {
    var index = skip(text, 0)
    ok.* = false
    if index >= text.length || text[index] != 91 { return 0 }
    index += 1
    var count: usize = 0
    while true {
        var end: usize = 0
        var good = false
        if strings {
            const item = stringAt(text, index, &end, &good)
        } else {
            const item = integerAt(text, index, &end, &good)
        }
        if !good { return 0 }
        count += 1
        index = skip(text, end)
        if index >= text.length { return 0 }
        if text[index] == 93 { break }
        if text[index] != 44 { return 0 }
        index += 1
    }
    ok.* = skip(text, index + 1) == text.length
    return count
}

// The array's `wanted`-th item's position.
fn arrayItem(text: []const u8, wanted: usize) -> usize {
    var index = skip(text, 0) + 1
    var count: usize = 0
    while count < wanted {
        var inString = false
        while index < text.length {
            if text[index] == 34 { inString = !inString }
            if text[index] == 92 && inString { index += 1 }
            if text[index] == 44 && !inString { break }
            index += 1
        }
        index += 1
        count += 1
    }
    return index
}

// { "min": A, "max": B }
fn range(text: []const u8, least: *i64, most: *i64) -> bool {
    var index = skip(text, 0)
    if index >= text.length || text[index] != 123 { return false }
    index += 1
    var found: u32 = 0
    while true {
        var end: usize = 0
        var ok = false
        const key = stringAt(text, index, &end, &ok)
        if !ok { return false }
        index = skip(text, end)
        if index >= text.length || text[index] != 58 { return false }
        const value = integerAt(text, index + 1, &end, &ok)
        if !ok { return false }
        if c.same(key, "min") {
            least.* = value
            found = found | 1
        } else if c.same(key, "max") {
            most.* = value
            found = found | 2
        }
        index = skip(text, end)
        if index >= text.length { return false }
        if text[index] == 125 { break }
        if text[index] != 44 { return false }
        index += 1
    }
    return found == 3
}

fn propertyText(format: usize, key: []const u8) -> []const u8 { return c.slice(proplist.getString(properties(format), key)) }

pub fn propertyType(format: usize, key: []const u8) -> i32 {
    const value = proplist.getString(properties(format), key)
    if value == 0 { return TYPE_INVALID }
    const text = c.slice(value)
    var ok = false
    const number = integerValue(text, &ok)
    if ok { return TYPE_INT }
    const string = stringValue(text, &ok)
    if ok { return TYPE_STRING }
    const integers = arrayCount(text, false, &ok)
    if ok { return TYPE_INT_ARRAY }
    const strings = arrayCount(text, true, &ok)
    if ok { return TYPE_STRING_ARRAY }
    var least: i64 = 0
    var most: i64 = 0
    if range(text, &least, &most) { return TYPE_INT_RANGE }
    return TYPE_INVALID
}

// The getters: 0, or -NOENTITY (no such property) or -INVALID (another
// type).
pub fn getInt(format: usize, key: []const u8, result: usize) -> i32 {
    const value = proplist.getString(properties(format), key)
    if value == 0 { return 0 - util.ERR_NOENTITY }
    var ok = false
    const number = integerValue(c.slice(value), &ok)
    if !ok { return 0 - util.ERR_INVALID }
    c.put32(result, 0, @bitCast(u32, @intCast(i32, number)))
    return 0
}

pub fn getRange(format: usize, key: []const u8, least: usize, most: usize) -> i32 {
    const value = proplist.getString(properties(format), key)
    if value == 0 { return 0 - util.ERR_NOENTITY }
    var low: i64 = 0
    var high: i64 = 0
    if !range(c.slice(value), &low, &high) { return 0 - util.ERR_INVALID }
    c.put32(least, 0, @bitCast(u32, @intCast(i32, low)))
    c.put32(most, 0, @bitCast(u32, @intCast(i32, high)))
    return 0
}

pub fn getIntArray(format: usize, key: []const u8, values: usize, count: usize) -> i32 {
    const value = proplist.getString(properties(format), key)
    if value == 0 { return 0 - util.ERR_NOENTITY }
    const text = c.slice(value)
    var ok = false
    const total = arrayCount(text, false, &ok)
    if !ok { return 0 - util.ERR_INVALID }
    const items = c.alloc(total * 4)
    var index: usize = 0
    while index < total {
        var end: usize = 0
        const number = integerAt(text, arrayItem(text, index), &end, &ok)
        c.put32(items, index * 4, @bitCast(u32, @intCast(i32, number)))
        index += 1
    }
    c.putPointer(values, 0, items)
    c.put32(count, 0, @intCast(u32, total))
    return 0
}

fn unescape(value: []const u8) -> usize {
    var writing = util.text()
    var index: usize = 0
    while index < value.length {
        if value[index] == 92 && index + 1 < value.length { index += 1 }
        util.addByte(&writing, value[index])
        index += 1
    }
    return util.finish(&writing)
}

pub fn getString(format: usize, key: []const u8, result: usize) -> i32 {
    const value = proplist.getString(properties(format), key)
    if value == 0 { return 0 - util.ERR_NOENTITY }
    var ok = false
    const string = stringValue(c.slice(value), &ok)
    if !ok { return 0 - util.ERR_INVALID }
    c.putPointer(result, 0, unescape(string))
    return 0
}

pub fn getStringArray(format: usize, key: []const u8, values: usize, count: usize) -> i32 {
    const value = proplist.getString(properties(format), key)
    if value == 0 { return 0 - util.ERR_NOENTITY }
    const text = c.slice(value)
    var ok = false
    const total = arrayCount(text, true, &ok)
    if !ok { return 0 - util.ERR_INVALID }
    const items = c.alloc(total * 8)
    var index: usize = 0
    while index < total {
        var end: usize = 0
        const string = stringAt(text, arrayItem(text, index), &end, &ok)
        c.putPointer(items, index * 8, unescape(string))
        index += 1
    }
    c.putPointer(values, 0, items)
    c.put32(count, 0, @intCast(u32, total))
    return 0
}

pub fn freeStrings(values: usize, count: i32) -> void {
    var index: i32 = 0
    while index < count {
        c.release(c.getPointer(values, @intCast(usize, index) * 8))
        index += 1
    }
    c.release(values)
}

fn setText(format: usize, key: []const u8, writing: *util.Text) -> void {
    const value = util.finish(writing)
    const done = proplist.setString(properties(format), key, c.slice(value))
    c.release(value)
}

pub fn setInt(format: usize, key: []const u8, value: i32) -> void {
    var writing = util.text()
    util.addSigned(&writing, @intCast(i64, value))
    setText(format, key, &writing)
}

pub fn setIntArray(format: usize, key: []const u8, values: usize, count: i32) -> void {
    if count <= 0 { return }
    var writing = util.text()
    util.add(&writing, "[ ")
    var index: i32 = 0
    while index < count {
        if index > 0 { util.add(&writing, ", ") }
        util.addSigned(&writing, @intCast(i64, @bitCast(i32, c.get32(values, @intCast(usize, index) * 4))))
        index += 1
    }
    util.add(&writing, " ]")
    setText(format, key, &writing)
}

pub fn setRange(format: usize, key: []const u8, least: i32, most: i32) -> void {
    var writing = util.text()
    util.add(&writing, "{ \"min\": ")
    util.addSigned(&writing, @intCast(i64, least))
    util.add(&writing, ", \"max\": ")
    util.addSigned(&writing, @intCast(i64, most))
    util.add(&writing, " }")
    setText(format, key, &writing)
}

pub fn setString(format: usize, key: []const u8, value: []const u8) -> void {
    var writing = util.text()
    util.addByte(&writing, 34)
    util.add(&writing, value)
    util.addByte(&writing, 34)
    setText(format, key, &writing)
}

pub fn setStringArray(format: usize, key: []const u8, values: usize, count: i32) -> void {
    if count <= 0 { return }
    var writing = util.text()
    util.add(&writing, "[ ")
    var index: i32 = 0
    while index < count {
        if index > 0 { util.add(&writing, ", ") }
        util.addByte(&writing, 34)
        util.add(&writing, c.slice(c.getPointer(values, @intCast(usize, index) * 8)))
        util.addByte(&writing, 34)
        index += 1
    }
    util.add(&writing, " ]")
    setText(format, key, &writing)
}

pub fn setSampleFormat(format: usize, value: u32) -> void { setString(format, SAMPLE_FORMAT, c.slice(sample.formatName(value))) }

pub fn setRate(format: usize, value: i32) -> void { setInt(format, RATE, value) }

pub fn setChannels(format: usize, value: i32) -> void { setInt(format, CHANNELS, value) }

pub fn setChannelMap(format: usize, map: usize) -> void {
    var printed: [336]u8 = undefined
    const text = channels.print(@intFromPtr(&printed), 336, map)
    setString(format, CHANNEL_MAP, c.slice(text))
}

pub fn getSampleFormat(format: usize, result: usize) -> i32 {
    var value: u64 = 0
    const got = getString(format, SAMPLE_FORMAT, @intFromPtr(&value))
    if got < 0 { return got }
    const name = @intCast(usize, value)
    const parsed = sample.parseFormat(c.slice(name))
    c.release(name)
    if !sample.formatValid(parsed) { return 0 - util.ERR_INVALID }
    c.put32(result, 0, parsed)
    return 0
}

pub fn getRate(format: usize, result: usize) -> i32 {
    var value: u32 = 0
    const got = getInt(format, RATE, @intFromPtr(&value))
    if got < 0 { return got }
    if !sample.rateValid(value) { return 0 - util.ERR_INVALID }
    c.put32(result, 0, value)
    return 0
}

pub fn getChannels(format: usize, result: usize) -> i32 {
    var value: u32 = 0
    const got = getInt(format, CHANNELS, @intFromPtr(&value))
    if got < 0 { return got }
    if !sample.channelsValid(value) { return 0 - util.ERR_INVALID }
    c.put8(result, 0, @intCast(u8, value))
    return 0
}

pub fn getChannelMap(format: usize, map: usize) -> i32 {
    var value: u64 = 0
    const got = getString(format, CHANNEL_MAP, @intFromPtr(&value))
    if got < 0 { return got }
    const name = @intCast(usize, value)
    const parsed = channels.parse(map, c.slice(name))
    c.release(name)
    return if parsed { 0 } else { 0 - util.ERR_INVALID }
}

pub fn fromSampleSpec(spec: usize, map: usize) -> usize {
    const format = new()
    setEncoding(format, util.ENCODING_PCM)
    const given = sample.read(spec)
    setSampleFormat(format, given.format)
    setRate(format, @intCast(i32, given.rate))
    setChannels(format, @intCast(i32, given.channels))
    if map != 0 { setChannelMap(format, map) }
    return format
}

// A PCM format's spec (and map); for a compressed one (passed through),
// the 16-bit stereo spec that carries it.
pub fn toSampleSpec(format: usize, spec: usize, map: usize) -> i32 {
    if !isPcm(format) {
        var rate: u32 = 0
        if getInt(format, RATE, @intFromPtr(&rate)) < 0 { return 0 - util.ERR_INVALID }
        const kind = encoding(format)
        // E-AC3, TrueHD and DTS-HD go at four times their rate.
        if kind == 3 || kind == 7 || kind == 8 { rate = rate * 4 }
        sample.write(spec, sample.Spec.{ .format = sample.S16LE, .rate = rate, .channels = 2 })
        if map != 0 { const made = channels.initAuto(map, 2, channels.DEF_AIFF) }
        return 0
    }
    if getSampleFormat(format, spec) < 0 { return 0 - util.ERR_INVALID }
    if getRate(format, spec + 4) < 0 { return 0 - util.ERR_INVALID }
    if getChannels(format, spec + 8) < 0 { return 0 - util.ERR_INVALID }
    if map != 0 && getChannelMap(format, map) < 0 { return 0 - util.ERR_INVALID }
    return 0
}

// Whether two values of a property can meet: equal, or one of an array's,
// or within a range.
fn meets(first: []const u8, second: []const u8) -> bool {
    var ok = false
    var other = false
    const one = integerValue(first, &ok)
    const two = integerValue(second, &other)
    if ok && other { return one == two }
    const left = stringValue(first, &ok)
    const right = stringValue(second, &other)
    if ok && other { return c.same(left, right) }
    if contains(first, second) || contains(second, first) { return true }
    return false
}

// Whether the array or range `set` holds the single value `item`.
fn contains(set: []const u8, item: []const u8) -> bool {
    var ok = false
    const number = integerValue(item, &ok)
    if ok {
        var least: i64 = 0
        var most: i64 = 0
        if range(set, &least, &most) { return number >= least && number <= most }
        const total = arrayCount(set, false, &ok)
        if !ok { return false }
        var index: usize = 0
        while index < total {
            var end: usize = 0
            var good = false
            if integerAt(set, arrayItem(set, index), &end, &good) == number && good { return true }
            index += 1
        }
        return false
    }
    const string = stringValue(item, &ok)
    if !ok { return false }
    const total = arrayCount(set, true, &ok)
    if !ok { return false }
    var index: usize = 0
    while index < total {
        var end: usize = 0
        var good = false
        if c.same(stringAt(set, arrayItem(set, index), &end, &good), string) { return true }
        index += 1
    }
    return false
}

pub fn compatible(first: usize, second: usize) -> bool {
    if encoding(first) != encoding(second) { return false }
    const list = properties(first)
    var index: usize = 0
    while index < proplist.count(list) {
        const key = c.slice(proplist.keyAt(list, index))
        const one = proplist.getString(list, key)
        const two = proplist.getString(properties(second), key)
        if two == 0 || one == 0 || !meets(c.slice(one), c.slice(two)) { return false }
        index += 1
    }
    return true
}
