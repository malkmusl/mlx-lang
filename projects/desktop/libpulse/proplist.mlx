// Property lists (pa_proplist): keys (ASCII) with values (bytes; a string
// value keeps its NUL), in the order they were first set. In C memory: the
// count, the room and the entries (key, value, its byte count; 24 bytes
// each).
const c = @import("./c.mlx")
const util = @import("./util.mlx")

const COUNT: usize = 0
const ROOM: usize = 8
const ENTRIES: usize = 16
const ENTRY: usize = 24

// pa_update_mode_t.
pub const UPDATE_SET: u32 = 0
pub const UPDATE_MERGE: u32 = 1
pub const UPDATE_REPLACE: u32 = 2

pub fn new() -> usize { return c.alloc(24) }

pub fn count(list: usize) -> usize { return c.getPointer(list, COUNT) }

fn entry(list: usize, index: usize) -> usize { return c.getPointer(list, ENTRIES) + index * ENTRY }

pub fn keyAt(list: usize, index: usize) -> usize { return c.getPointer(entry(list, index), 0) }

pub fn valueAt(list: usize, index: usize) -> usize { return c.getPointer(entry(list, index), 8) }

pub fn sizeAt(list: usize, index: usize) -> usize { return c.getPointer(entry(list, index), 16) }

pub fn clear(list: usize) -> void {
    var index: usize = 0
    while index < count(list) {
        c.release(keyAt(list, index))
        c.release(valueAt(list, index))
        index += 1
    }
    c.putPointer(list, COUNT, 0)
}

pub fn free(list: usize) -> void {
    if list == 0 { return }
    clear(list)
    c.release(c.getPointer(list, ENTRIES))
    c.release(list)
}

pub fn keyValid(key: []const u8) -> bool { return key.length > 0 && util.asciiValid(key) }

// The entry's index, or count when there is none.
pub fn find(list: usize, key: []const u8) -> usize {
    var index: usize = 0
    while index < count(list) {
        if c.same(c.slice(keyAt(list, index)), key) { return index }
        index += 1
    }
    return count(list)
}

pub fn contains(list: usize, key: []const u8) -> bool { return find(list, key) < count(list) }

// Sets `key` to the `size` bytes at `data` (copied, with a NUL after them
// that is not counted). False when there is no memory.
pub fn set(list: usize, key: []const u8, data: usize, size: usize) -> bool {
    const value = c.alloc(size + 1)
    if value == 0 { return false }
    if size > 0 { c.copy(value, data, size) }
    var index = find(list, key)
    if index == count(list) {
        if count(list) == c.getPointer(list, ROOM) {
            const room = if count(list) == 0 { 8 } else { count(list) * 2 }
            const entries = c.grow(c.getPointer(list, ENTRIES), room * ENTRY)
            if entries == 0 {
                c.release(value)
                return false
            }
            c.putPointer(list, ENTRIES, entries)
            c.putPointer(list, ROOM, room)
        }
        const name = c.duplicate(key)
        if name == 0 {
            c.release(value)
            return false
        }
        c.putPointer(entry(list, index), 0, name)
        c.putPointer(list, COUNT, index + 1)
    } else {
        c.release(valueAt(list, index))
    }
    c.putPointer(entry(list, index), 8, value)
    c.putPointer(entry(list, index), 16, size)
    return true
}

// A string value (its NUL counted, as PulseAudio stores them).
pub fn setString(list: usize, key: []const u8, value: []const u8) -> i32 {
    if !keyValid(key) || !util.utf8Valid(value) { return -1 }
    const copied = c.duplicate(value)
    if copied == 0 { return -1 }
    const done = set(list, key, copied, value.length + 1)
    c.release(copied)
    return if done { 0 } else { -1 }
}

// The value when it is a string (NUL-terminated at its end, nothing NUL
// inside, UTF-8), else 0.
pub fn getString(list: usize, key: []const u8) -> usize {
    if !keyValid(key) { return 0 }
    const index = find(list, key)
    if index == count(list) { return 0 }
    const value = valueAt(list, index)
    const size = sizeAt(list, index)
    if size == 0 || c.get8(value, size - 1) != 0 || c.length(value) != size - 1 { return 0 }
    if !util.utf8Valid(c.slice(value)) { return 0 }
    return value
}

pub fn unset(list: usize, key: []const u8) -> i32 {
    if !keyValid(key) { return -1 }
    const index = find(list, key)
    if index == count(list) { return -2 }
    c.release(keyAt(list, index))
    c.release(valueAt(list, index))
    var at = index
    while at + 1 < count(list) {
        c.copy(entry(list, at), entry(list, at + 1), ENTRY)
        at += 1
    }
    c.putPointer(list, COUNT, count(list) - 1)
    return 0
}

pub fn update(list: usize, mode: u32, other: usize) -> void {
    if mode == UPDATE_SET { clear(list) }
    var index: usize = 0
    while index < count(other) {
        const key = c.slice(keyAt(other, index))
        if !(mode == UPDATE_MERGE && contains(list, key)) {
            const done = set(list, key, valueAt(other, index), sizeAt(other, index))
        }
        index += 1
    }
}

pub fn copy(list: usize) -> usize {
    const copied = new()
    if copied != 0 { update(copied, UPDATE_REPLACE, list) }
    return copied
}

pub fn equal(first: usize, second: usize) -> bool {
    if first == second { return true }
    if count(first) != count(second) { return false }
    var index: usize = 0
    while index < count(first) {
        const other = find(second, c.slice(keyAt(first, index)))
        if other == count(second) || sizeAt(second, other) != sizeAt(first, index) { return false }
        const size = sizeAt(first, index)
        var at: usize = 0
        while at < size {
            if c.get8(valueAt(first, index), at) != c.get8(valueAt(second, other), at) { return false }
            at += 1
        }
        index += 1
    }
    return true
}

// "key = \"value\"" (quotes in it escaped) or "key = hex:0a1b", `separator`
// between them; a C string (malloc'd).
pub fn toString(list: usize, separator: []const u8) -> usize {
    var text = util.text()
    var index: usize = 0
    while index < count(list) {
        if index > 0 { util.add(&text, separator) }
        const key = c.slice(keyAt(list, index))
        util.add(&text, key)
        const value = getString(list, key)
        if value != 0 {
            util.add(&text, " = \"")
            const string = c.slice(value)
            var at: usize = 0
            while at < string.length {
                if string[at] == 34 { util.addByte(&text, 92) }
                util.addByte(&text, string[at])
                at += 1
            }
            util.addByte(&text, 34)
        } else {
            util.add(&text, " = hex:")
            var at: usize = 0
            while at < sizeAt(list, index) {
                const value_byte = c.get8(valueAt(list, index), at)
                util.addByte(&text, util.hexDigit(value_byte >> 4))
                util.addByte(&text, util.hexDigit(value_byte & 15))
                at += 1
            }
        }
        index += 1
    }
    return util.finish(&text)
}

fn space(value: u8) -> bool { return value == 32 || (value >= 9 && value <= 13) }

// A value in quotes or ticks with backslash escapes taken out.
fn unescaped(list: usize, key: []const u8, value: []const u8) -> bool {
    var text = util.text()
    var index: usize = 0
    while index < value.length {
        if value[index] == 92 && index + 1 < value.length { index += 1 }
        util.addByte(&text, value[index])
        index += 1
    }
    const string = util.finish(&text)
    if string == 0 { return false }
    const done = setString(list, key, c.slice(string)) == 0
    c.release(string)
    return done
}

fn hexValue(list: usize, key: []const u8, value: []const u8) -> bool {
    if !keyValid(key) || value.length % 2 != 0 { return false }
    var at: usize = 0
    while at < value.length {
        if !util.isHex(value[at]) { return false }
        at += 1
    }
    const data = c.alloc(value.length / 2 + 1)
    var index: usize = 0
    while index < value.length / 2 {
        c.put8(data, index, @intCast(u8, util.hexValue(value[index * 2]) * 16 + util.hexValue(value[index * 2 + 1])))
        index += 1
    }
    const done = set(list, key, data, value.length / 2)
    c.release(data)
    return done
}

// pa_proplist_from_string: key=value pairs, values bare, in double quotes,
// in single quotes or hex:...; 0 when the text is not one.
pub fn fromString(source: []const u8) -> usize {
    const list = new()
    var at: usize = 0
    while true {
        while at < source.length && space(source[at]) { at += 1 }
        if at >= source.length { return list }
        if source[at] == 61 { break }
        const keyStart = at
        while at < source.length && source[at] != 61 && !space(source[at]) { at += 1 }
        const key = source[keyStart..at]
        while at < source.length && space(source[at]) { at += 1 }
        if at >= source.length || source[at] != 61 { break }
        at += 1
        while at < source.length && space(source[at]) { at += 1 }
        if at >= source.length { break }
        const rest = source[at..source.length]
        if c.startsWith(rest, "hex:") {
            at += 4
            const valueStart = at
            while at < source.length && !space(source[at]) { at += 1 }
            if !hexValue(list, key, source[valueStart..at]) { break }
        } else if source[at] == 34 || source[at] == 39 {
            const quote = source[at]
            at += 1
            const valueStart = at
            while at < source.length && source[at] != quote {
                if source[at] == 92 { at += 1 }
                at += 1
            }
            if at >= source.length { break }
            if !unescaped(list, key, source[valueStart..at]) { break }
            at += 1
        } else {
            const valueStart = at
            while at < source.length && !space(source[at]) { at += 1 }
            if setString(list, key, source[valueStart..at]) != 0 { break }
        }
    }
    free(list)
    return 0
}
