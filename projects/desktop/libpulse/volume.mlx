// Volumes: pa_volume_t (u32; 65536 is 100%, cubic in loudness) and
// pa_cvolume (channels u8, then 32 volumes u32; 132 bytes).
const c = @import("./c.mlx")
const math = @import("./math.mlx")
const sample = @import("./sample.mlx")
const channels = @import("./channels.mlx")

pub const CVOLUME: usize = 132
pub const NORM: u32 = 65536
pub const MUTED: u32 = 0
pub const MAX: u32 = 2147483647
pub const INVALID: u32 = 4294967295

pub fn isValid(volume: u32) -> bool { return volume <= MAX }

fn clamp(value: u64) -> u32 { return if value > @intCast(u64, MAX) { MAX } else { @intCast(u32, value) } }

pub fn count(volume: usize) -> u32 { return @intCast(u32, c.get8(volume, 0)) }

pub fn value(volume: usize, channel: u32) -> u32 { return c.get32(volume, 4 + @intCast(usize, channel) * 4) }

pub fn setValue(volume: usize, channel: u32, amount: u32) -> void { c.put32(volume, 4 + @intCast(usize, channel) * 4, amount) }

pub fn setCount(volume: usize, channel_count: u32) -> void { c.put8(volume, 0, @intCast(u8, channel_count & 255)) }

pub fn valid(volume: usize) -> bool {
    if !sample.channelsValid(count(volume)) { return false }
    var index: u32 = 0
    while index < count(volume) {
        if !isValid(value(volume, index)) { return false }
        index += 1
    }
    return true
}

pub fn equal(first: usize, second: usize) -> bool {
    if !valid(first) || !valid(second) || count(first) != count(second) { return false }
    var index: u32 = 0
    while index < count(first) {
        if value(first, index) != value(second, index) { return false }
        index += 1
    }
    return true
}

pub fn init(volume: usize) -> void {
    setCount(volume, 0)
    var index: u32 = 0
    while index < channels.MAX {
        setValue(volume, index, INVALID)
        index += 1
    }
}

pub fn set(volume: usize, channel_count: u32, amount: u32) -> void {
    setCount(volume, channel_count)
    var index: u32 = 0
    while index < channel_count && index < channels.MAX {
        setValue(volume, index, if amount > MAX { MAX } else { amount })
        index += 1
    }
}

pub fn average(volume: usize) -> u32 {
    if !valid(volume) { return MUTED }
    var sum: u64 = 0
    var index: u32 = 0
    while index < count(volume) {
        sum += @intCast(u64, value(volume, index))
        index += 1
    }
    return @intCast(u32, sum / @intCast(u64, count(volume)))
}

fn inMask(map: usize, channel: u32, bits: u64) -> bool { return (@intCast(u64, 1) << @intCast(u6, channels.position(map, channel))) & bits != 0 }

pub fn compatibleWithMap(volume: usize, map: usize) -> bool { return valid(volume) && channels.valid(map) && count(volume) == channels.channels(map) }

pub fn averageMask(volume: usize, map: usize, bits: u64) -> u32 {
    if map == 0 { return average(volume) }
    if !compatibleWithMap(volume, map) { return MUTED }
    var sum: u64 = 0
    var taken: u64 = 0
    var index: u32 = 0
    while index < count(volume) {
        if inMask(map, index, bits) {
            sum += @intCast(u64, value(volume, index))
            taken += 1
        }
        index += 1
    }
    if taken > 0 { sum = sum / taken }
    return @intCast(u32, sum)
}

pub fn maximum(volume: usize) -> u32 {
    if !valid(volume) { return MUTED }
    var most = MUTED
    var index: u32 = 0
    while index < count(volume) {
        if value(volume, index) > most { most = value(volume, index) }
        index += 1
    }
    return most
}

pub fn minimum(volume: usize) -> u32 {
    if !valid(volume) { return MUTED }
    var least = MAX
    var index: u32 = 0
    while index < count(volume) {
        if value(volume, index) < least { least = value(volume, index) }
        index += 1
    }
    return least
}

pub fn maximumMask(volume: usize, map: usize, bits: u64) -> u32 {
    if map == 0 { return maximum(volume) }
    if !compatibleWithMap(volume, map) { return MUTED }
    var most = MUTED
    var index: u32 = 0
    while index < count(volume) {
        if inMask(map, index, bits) && value(volume, index) > most { most = value(volume, index) }
        index += 1
    }
    return most
}

pub fn minimumMask(volume: usize, map: usize, bits: u64) -> u32 {
    if map == 0 { return minimum(volume) }
    if !compatibleWithMap(volume, map) { return MUTED }
    var least = MAX
    var index: u32 = 0
    while index < count(volume) {
        if inMask(map, index, bits) && value(volume, index) < least { least = value(volume, index) }
        index += 1
    }
    return least
}

pub fn multiply(first: u32, second: u32) -> u32 {
    if !isValid(first) || !isValid(second) { return INVALID }
    return clamp((@intCast(u64, first) * @intCast(u64, second) + @intCast(u64, NORM / 2)) / @intCast(u64, NORM))
}

pub fn divide(first: u32, second: u32) -> u32 {
    if !isValid(first) || !isValid(second) { return INVALID }
    if second == MUTED { return 0 }
    return clamp((@intCast(u64, first) * @intCast(u64, NORM) + @intCast(u64, second / 2)) / @intCast(u64, second))
}

pub fn fromLinear(linear: f64) -> u32 {
    if !(linear > 0.0) { return MUTED }
    const rounded = math.round(math.cbrt(linear) * 65536.0)
    if rounded < 0 { return MUTED }
    return clamp(@intCast(u64, rounded))
}

pub fn toLinear(volume: u32) -> f64 {
    if !isValid(volume) || volume == MUTED { return 0.0 }
    if volume == NORM { return 1.0 }
    const level: f64 = @floatFromInt(f64, @intCast(i64, volume))
    const fraction = level / 65536.0
    return fraction * fraction * fraction
}

// (PulseAudio's floor, PA_DECIBEL_MININFTY, is minus infinity.)
pub fn fromDb(decibels: f64) -> u32 {
    if !(decibels > math.infinityBelow()) { return MUTED }
    return fromLinear(math.tenTo(decibels / 20.0))
}

pub fn toDb(volume: u32) -> f64 {
    if !isValid(volume) || volume == MUTED { return math.infinityBelow() }
    return 20.0 * math.log10(toLinear(volume))
}

fn percent(volume: u32) -> u64 { return (@intCast(u64, volume) * 100 + @intCast(u64, NORM / 2)) / @intCast(u64, NORM) }

// "%3u%%"
fn appendPercent(writing: *c.Out, volume: u32) -> void {
    const amount = percent(volume)
    if amount < 10 { c.append(writing, "  ") } else if amount < 100 { c.append(writing, " ") }
    c.appendNumber(writing, amount)
    c.append(writing, "%")
}

// "%0.2f dB" (-inf dB when muted)
fn appendDb(writing: *c.Out, volume: u32) -> void {
    const decibels = toDb(volume)
    if !(decibels > math.infinityBelow()) {
        c.append(writing, "-inf dB")
        return
    }
    c.appendFixed(writing, decibels, 2)
    c.append(writing, " dB")
}

pub fn printVolume(buffer: usize, capacity: usize, volume: u32) -> usize {
    var writing = c.out(buffer, capacity)
    if !isValid(volume) {
        c.append(&writing, "(invalid)")
    } else {
        appendPercent(&writing, volume)
    }
    return c.result(&writing)
}

pub fn printVolumeDb(buffer: usize, capacity: usize, volume: u32) -> usize {
    var writing = c.out(buffer, capacity)
    if !isValid(volume) {
        c.append(&writing, "(invalid)")
    } else {
        appendDb(&writing, volume)
    }
    return c.result(&writing)
}

fn appendVerbose(writing: *c.Out, volume: u32, decibels: bool) -> void {
    c.appendNumber(writing, @intCast(u64, volume))
    c.append(writing, " / ")
    appendPercent(writing, volume)
    if decibels {
        c.append(writing, " / ")
        appendDb(writing, volume)
    }
}

pub fn printVolumeVerbose(buffer: usize, capacity: usize, volume: u32, decibels: bool) -> usize {
    var writing = c.out(buffer, capacity)
    if !isValid(volume) {
        c.append(&writing, "(invalid)")
    } else {
        appendVerbose(&writing, volume, decibels)
    }
    return c.result(&writing)
}

// "0:  50% 1:  50%" (or with decibels: "0: -18.06 dB 1: ...").
pub fn print(buffer: usize, capacity: usize, volume: usize, decibels: bool) -> usize {
    var writing = c.out(buffer, capacity)
    if !valid(volume) {
        c.append(&writing, "(invalid)")
        return c.result(&writing)
    }
    var index: u32 = 0
    while index < count(volume) {
        if index > 0 { c.append(&writing, " ") }
        c.appendNumber(&writing, @intCast(u64, index))
        c.append(&writing, ": ")
        if decibels { appendDb(&writing, value(volume, index)) } else { appendPercent(&writing, value(volume, index)) }
        index += 1
    }
    return c.result(&writing)
}

// "front-left: 32768 /  50% / -18.06 dB,   front-right: ..."
pub fn printVerbose(buffer: usize, capacity: usize, volume: usize, map: usize, decibels: bool) -> usize {
    var writing = c.out(buffer, capacity)
    if !valid(volume) {
        c.append(&writing, "(invalid)")
        return c.result(&writing)
    }
    var index: u32 = 0
    while index < count(volume) {
        if index > 0 { c.append(&writing, ",   ") }
        if map != 0 { c.append(&writing, c.slice(channels.positionName(channels.position(map, index)))) } else { c.appendNumber(&writing, @intCast(u64, index)) }
        c.append(&writing, ": ")
        appendVerbose(&writing, value(volume, index), decibels)
        index += 1
    }
    return c.result(&writing)
}

pub fn channelsEqualTo(volume: usize, amount: u32) -> bool {
    if !valid(volume) || !isValid(amount) { return false }
    var index: u32 = 0
    while index < count(volume) {
        if value(volume, index) != amount { return false }
        index += 1
    }
    return true
}

// dest = a (*, /) b, channel by channel; `scalar`: b is one volume.
pub fn combine(dest: usize, first: usize, second: usize, scalar: u32, by_scalar: bool, dividing: bool) -> usize {
    if !valid(first) || (!by_scalar && !valid(second)) || (by_scalar && !isValid(scalar)) { return 0 }
    var channel_count = count(first)
    if !by_scalar && count(second) < channel_count { channel_count = count(second) }
    var index: u32 = 0
    while index < channel_count {
        const other = if by_scalar { scalar } else { value(second, index) }
        setValue(dest, index, if dividing { divide(value(first, index), other) } else { multiply(value(first, index), other) })
        index += 1
    }
    setCount(dest, channel_count)
    return dest
}

fn onLeft(position: u32) -> bool { return (@intCast(u64, 1) << @intCast(u6, position)) & channels.maskLeft() != 0 }

fn sideOf(position: u32, side: u32) -> bool {
    const bit = @intCast(u64, 1) << @intCast(u6, position)
    if side == 0 { return bit & channels.maskLeft() != 0 }
    if side == 1 { return bit & channels.maskRight() != 0 }
    if side == 2 { return bit & (channels.maskFront() & channels.maskRear() | (@intCast(u64, 1) << 3) | (@intCast(u64, 1) << 4) | (@intCast(u64, 1) << 44) | (@intCast(u64, 1) << 47) | (@intCast(u64, 1) << 50)) != 0 }
    if side == 3 { return bit & channels.maskLfe() != 0 }
    if side == 4 { return bit & channels.maskFront() != 0 }
    if side == 5 { return bit & channels.maskRear() != 0 }
    return bit & channels.maskHfe() != 0
}

// Sides: 0 left, 1 right, 2 center, 3 lfe, 4 front, 5 rear, 6 hfe.
const LEFT: u32 = 0
const RIGHT: u32 = 1
const CENTER: u32 = 2
const SIDE_LFE: u32 = 3
const FRONT: u32 = 4
const REAR: u32 = 5
const HFE: u32 = 6

pub fn remap(volume: usize, from: usize, to: usize) -> usize {
    if !channels.valid(to) || !compatibleWithMap(volume, from) { return 0 }
    if channels.equal(from, to) { return volume }
    var result: [132]u8 = undefined
    const remapped = @intFromPtr(&result)
    setCount(remapped, channels.channels(to))
    var target: u32 = 0
    while target < channels.channels(to) {
        var sum: u64 = 0
        var taken: u64 = 0
        var source: u32 = 0
        while source < channels.channels(from) {
            if channels.position(from, source) == channels.position(to, target) {
                sum += @intCast(u64, value(volume, source))
                taken += 1
            }
            source += 1
        }
        if taken == 0 {
            source = 0
            while source < channels.channels(from) {
                const a = channels.position(from, source)
                const b = channels.position(to, target)
                if (sideOf(a, LEFT) && sideOf(b, LEFT)) || (sideOf(a, RIGHT) && sideOf(b, RIGHT)) || (sideOf(a, CENTER) && sideOf(b, CENTER)) || (sideOf(a, SIDE_LFE) && sideOf(b, SIDE_LFE)) {
                    sum += @intCast(u64, value(volume, source))
                    taken += 1
                }
                source += 1
            }
        }
        setValue(remapped, target, if taken == 0 { average(volume) } else { @intCast(u32, sum / taken) })
        target += 1
    }
    c.copy(volume, remapped, CVOLUME)
    return volume
}

// The average volume of the channels on each of two sides.
fn sides(volume: usize, map: usize, first: u32, second: u32, first_average: *u32, second_average: *u32) -> void {
    var a: u64 = 0
    var b: u64 = 0
    var na: u64 = 0
    var nb: u64 = 0
    var index: u32 = 0
    while index < channels.channels(map) {
        const position = channels.position(map, index)
        if sideOf(position, first) {
            a += @intCast(u64, value(volume, index))
            na += 1
        } else if sideOf(position, second) {
            b += @intCast(u64, value(volume, index))
            nb += 1
        }
        index += 1
    }
    first_average.* = if na == 0 { NORM } else { @intCast(u32, a / na) }
    second_average.* = if nb == 0 { NORM } else { @intCast(u32, b / nb) }
}

fn getBalanceOf(volume: usize, map: usize, first: u32, second: u32) -> f32 {
    var a: u32 = 0
    var b: u32 = 0
    sides(volume, map, first, second, &a, &b)
    if a == b { return 0.0 }
    const fa: f64 = @floatFromInt(f64, @intCast(i64, a))
    const fb: f64 = @floatFromInt(f64, @intCast(i64, b))
    var result: f64 = 1.0 - fa / fb
    if a > b { result = -1.0 + fb / fa }
    const narrow: f32 = @floatCast(f32, result)
    return narrow
}

fn setBalanceOf(volume: usize, map: usize, balance: f32, first: u32, second: u32) -> usize {
    var a: u32 = 0
    var b: u32 = 0
    sides(volume, map, first, second, &a, &b)
    const most = if a > b { a } else { b }
    const amount: f64 = @floatCast(f64, balance)
    const largest: f64 = @floatFromInt(f64, @intCast(i64, most))
    var na: u32 = most
    var nb: u32 = most
    if amount <= 0.0 {
        const scaled: i64 = @intFromFloat(i64, (amount + 1.0) * largest)
        nb = @intCast(u32, scaled)
    } else {
        const scaled: i64 = @intFromFloat(i64, (1.0 - amount) * largest)
        na = @intCast(u32, scaled)
    }
    var index: u32 = 0
    while index < channels.channels(map) {
        const position = channels.position(map, index)
        if sideOf(position, first) {
            setValue(volume, index, if a == 0 { na } else { clamp(@intCast(u64, value(volume, index)) * @intCast(u64, na) / @intCast(u64, a)) })
        } else if sideOf(position, second) {
            setValue(volume, index, if b == 0 { nb } else { clamp(@intCast(u64, value(volume, index)) * @intCast(u64, nb) / @intCast(u64, b)) })
        }
        index += 1
    }
    return volume
}

pub fn getBalance(volume: usize, map: usize) -> f32 {
    if !compatibleWithMap(volume, map) || !channels.canBalance(map) { return 0.0 }
    return getBalanceOf(volume, map, LEFT, RIGHT)
}

pub fn setBalance(volume: usize, map: usize, balance: f32) -> usize {
    if !compatibleWithMap(volume, map) { return 0 }
    const amount: f64 = @floatCast(f64, balance)
    if amount < -1.0 || amount > 1.0 { return 0 }
    if !channels.canBalance(map) { return volume }
    return setBalanceOf(volume, map, balance, LEFT, RIGHT)
}

pub fn getFade(volume: usize, map: usize) -> f32 {
    if !compatibleWithMap(volume, map) || !channels.canFade(map) { return 0.0 }
    return getBalanceOf(volume, map, REAR, FRONT)
}

pub fn setFade(volume: usize, map: usize, fade: f32) -> usize {
    if !compatibleWithMap(volume, map) { return 0 }
    const amount: f64 = @floatCast(f64, fade)
    if amount < -1.0 || amount > 1.0 { return 0 }
    if !channels.canFade(map) { return volume }
    return setBalanceOf(volume, map, fade, REAR, FRONT)
}

pub fn getLfeBalance(volume: usize, map: usize) -> f32 {
    if !compatibleWithMap(volume, map) || !channels.canLfeBalance(map) { return 0.0 }
    return getBalanceOf(volume, map, HFE, SIDE_LFE)
}

pub fn setLfeBalance(volume: usize, map: usize, balance: f32) -> usize {
    if !compatibleWithMap(volume, map) { return 0 }
    const amount: f64 = @floatCast(f64, balance)
    if amount < -1.0 || amount > 1.0 { return 0 }
    if !channels.canLfeBalance(map) { return volume }
    return setBalanceOf(volume, map, balance, HFE, SIDE_LFE)
}

pub fn scale(volume: usize, most: u32) -> usize {
    if !valid(volume) || !isValid(most) { return 0 }
    const top = maximum(volume)
    if top == MUTED {
        set(volume, count(volume), most)
        return volume
    }
    var index: u32 = 0
    while index < count(volume) {
        setValue(volume, index, clamp(@intCast(u64, value(volume, index)) * @intCast(u64, most) / @intCast(u64, top)))
        index += 1
    }
    return volume
}

pub fn scaleMask(volume: usize, most: u32, map: usize, bits: u64) -> usize {
    if !isValid(most) { return 0 }
    if map == 0 { return scale(volume, most) }
    if !compatibleWithMap(volume, map) { return 0 }
    const top = maximumMask(volume, map, bits)
    if top == MUTED {
        set(volume, count(volume), most)
        return volume
    }
    var index: u32 = 0
    while index < count(volume) {
        setValue(volume, index, clamp(@intCast(u64, value(volume, index)) * @intCast(u64, most) / @intCast(u64, top)))
        index += 1
    }
    return volume
}

pub fn setPosition(volume: usize, map: usize, position: u32, amount: u32) -> usize {
    if !compatibleWithMap(volume, map) || position >= channels.POSITIONS || !isValid(amount) { return 0 }
    var good = false
    var index: u32 = 0
    while index < channels.channels(map) {
        if channels.position(map, index) == position {
            setValue(volume, index, amount)
            good = true
        }
        index += 1
    }
    return if good { volume } else { 0 }
}

pub fn getPosition(volume: usize, map: usize, position: u32) -> u32 {
    if !compatibleWithMap(volume, map) || position >= channels.POSITIONS { return MUTED }
    var most = MUTED
    var index: u32 = 0
    while index < channels.channels(map) {
        if channels.position(map, index) == position && value(volume, index) > most { most = value(volume, index) }
        index += 1
    }
    return most
}

pub fn merge(dest: usize, first: usize, second: usize) -> usize {
    if !valid(first) || !valid(second) { return 0 }
    var channel_count = count(first)
    if count(second) < channel_count { channel_count = count(second) }
    var index: u32 = 0
    while index < channel_count {
        const a = value(first, index)
        const b = value(second, index)
        setValue(dest, index, if a > b { a } else { b })
        index += 1
    }
    setCount(dest, channel_count)
    return dest
}

pub fn incClamp(volume: usize, step: u32, limit: u32) -> usize {
    if !valid(volume) || !isValid(step) { return 0 }
    var most = maximum(volume)
    if limit < step || most >= limit - step { most = limit } else { most += step }
    return scale(volume, most)
}

pub fn dec(volume: usize, step: u32) -> usize {
    if !valid(volume) || !isValid(step) { return 0 }
    var most = maximum(volume)
    if most <= MUTED + step { most = MUTED } else { most -= step }
    return scale(volume, most)
}
