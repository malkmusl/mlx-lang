// PulseAudio's native protocol on the wire: packets (a descriptor of five
// big-endian u32: payload length, channel (-1 for commands), the offset's
// two halves, flags; then the payload) and tagstructs, the commands'
// bodies: values each after a tag byte, big-endian. The server's side of
// the same protocol is projects/desktop/audio/tagstruct.mlx; this one
// writes into and reads from C memory, as the library keeps it.
const c = @import("./c.mlx")
const proplist = @import("./proplist.mlx")
const format = @import("./format.mlx")
const sample = @import("./sample.mlx")
const channels = @import("./channels.mlx")
const volume = @import("./volume.mlx")
const util = @import("./util.mlx")

pub const DESCRIPTOR: usize = 20
pub const CONTROL: u32 = 4294967295
pub const INVALID: u32 = 4294967295

const TAG_U32: u8 = 76
const TAG_U8: u8 = 66
const TAG_U64: u8 = 82
const TAG_S64: u8 = 114
const TAG_STRING: u8 = 116
const TAG_STRING_NULL: u8 = 78
const TAG_TRUE: u8 = 49
const TAG_FALSE: u8 = 48
const TAG_ARBITRARY: u8 = 120
const TAG_SAMPLE_SPEC: u8 = 97
const TAG_CHANNEL_MAP: u8 = 109
const TAG_CVOLUME: u8 = 118
const TAG_VOLUME: u8 = 86
const TAG_USEC: u8 = 85
const TAG_TIMEVAL: u8 = 84
const TAG_PROPLIST: u8 = 80
const TAG_FORMAT_INFO: u8 = 102

// ---------------------------------------------------------------------------
// Writing a packet: room for the descriptor first, the payload after it.

pub const Writer = struct {
    data: usize
    length: usize
    room: usize
}

pub fn writer() -> Writer {
    var writing = Writer.{ .data = c.alloc(256), .length = DESCRIPTOR, .room = 256 }
    if writing.data == 0 { writing.room = 0 }
    return writing
}

fn ensure(writing: *Writer, count: usize) -> bool {
    if writing.*.length + count <= writing.*.room { return true }
    var room = writing.*.room * 2
    while room < writing.*.length + count { room = room * 2 }
    const grown = c.grow(writing.*.data, room)
    if grown == 0 { return false }
    writing.*.data = grown
    writing.*.room = room
    return true
}

pub fn raw8(writing: *Writer, value: u8) -> void {
    if !ensure(writing, 1) { return }
    c.put8(writing.*.data, writing.*.length, value)
    writing.*.length += 1
}

pub fn raw32(writing: *Writer, value: u32) -> void {
    if !ensure(writing, 4) { return }
    store32(writing.*.data, writing.*.length, value)
    writing.*.length += 4
}

fn raw64(writing: *Writer, value: u64) -> void {
    raw32(writing, @intCast(u32, value >> 32))
    raw32(writing, @intCast(u32, value & 4294967295))
}

fn rawBytes(writing: *Writer, data: usize, count: usize) -> void {
    if count == 0 || !ensure(writing, count) { return }
    c.copy(writing.*.data + writing.*.length, data, count)
    writing.*.length += count
}

pub fn store32(data: usize, at: usize, value: u32) -> void {
    c.put8(data, at, @intCast(u8, value >> 24))
    c.put8(data, at + 1, @intCast(u8, (value >> 16) & 255))
    c.put8(data, at + 2, @intCast(u8, (value >> 8) & 255))
    c.put8(data, at + 3, @intCast(u8, value & 255))
}

pub fn load32(data: usize, at: usize) -> u32 {
    return (@intCast(u32, c.get8(data, at)) << 24) | (@intCast(u32, c.get8(data, at + 1)) << 16) | (@intCast(u32, c.get8(data, at + 2)) << 8) | @intCast(u32, c.get8(data, at + 3))
}

pub fn putU32(writing: *Writer, value: u32) -> void {
    raw8(writing, TAG_U32)
    raw32(writing, value)
}

pub fn putU8(writing: *Writer, value: u8) -> void {
    raw8(writing, TAG_U8)
    raw8(writing, value)
}

pub fn putU64(writing: *Writer, value: u64) -> void {
    raw8(writing, TAG_U64)
    raw64(writing, value)
}

pub fn putS64(writing: *Writer, value: i64) -> void {
    raw8(writing, TAG_S64)
    raw64(writing, @bitCast(u64, value))
}

pub fn putBool(writing: *Writer, value: bool) -> void { raw8(writing, if value { TAG_TRUE } else { TAG_FALSE }) }

pub fn putString(writing: *Writer, text: []const u8) -> void {
    raw8(writing, TAG_STRING)
    var index: usize = 0
    while index < text.length {
        raw8(writing, text[index])
        index += 1
    }
    raw8(writing, 0)
}

// A C string, or the null string for 0.
pub fn putCString(writing: *Writer, text: usize) -> void {
    if text == 0 {
        raw8(writing, TAG_STRING_NULL)
        return
    }
    putString(writing, c.slice(text))
}

pub fn putArbitrary(writing: *Writer, data: usize, count: usize) -> void {
    raw8(writing, TAG_ARBITRARY)
    raw32(writing, @intCast(u32, count))
    rawBytes(writing, data, count)
}

pub fn putSampleSpec(writing: *Writer, spec: sample.Spec) -> void {
    raw8(writing, TAG_SAMPLE_SPEC)
    raw8(writing, @intCast(u8, spec.format & 255))
    raw8(writing, @intCast(u8, spec.channels & 255))
    raw32(writing, spec.rate)
}

pub fn putChannelMap(writing: *Writer, map: usize) -> void {
    raw8(writing, TAG_CHANNEL_MAP)
    const count = channels.channels(map)
    raw8(writing, @intCast(u8, count))
    var index: u32 = 0
    while index < count {
        raw8(writing, @intCast(u8, channels.position(map, index) & 255))
        index += 1
    }
}

pub fn putCvolume(writing: *Writer, levels: usize) -> void {
    raw8(writing, TAG_CVOLUME)
    const count = volume.count(levels)
    raw8(writing, @intCast(u8, count))
    var index: u32 = 0
    while index < count {
        raw32(writing, volume.value(levels, index))
        index += 1
    }
}

pub fn putVolume(writing: *Writer, value: u32) -> void {
    raw8(writing, TAG_VOLUME)
    raw32(writing, value)
}

pub fn putUsec(writing: *Writer, value: u64) -> void {
    raw8(writing, TAG_USEC)
    raw64(writing, value)
}

pub fn putTimeval(writing: *Writer, time: usize) -> void {
    raw8(writing, TAG_TIMEVAL)
    raw32(writing, @intCast(u32, util.seconds(time) & 4294967295))
    raw32(writing, @intCast(u32, util.micro(time) & 4294967295))
}

pub fn putProplist(writing: *Writer, list: usize) -> void {
    raw8(writing, TAG_PROPLIST)
    var index: usize = 0
    while list != 0 && index < proplist.count(list) {
        putString(writing, c.slice(proplist.keyAt(list, index)))
        putU32(writing, @intCast(u32, proplist.sizeAt(list, index)))
        putArbitrary(writing, proplist.valueAt(list, index), proplist.sizeAt(list, index))
        index += 1
    }
    raw8(writing, TAG_STRING_NULL)
}

pub fn putFormat(writing: *Writer, info: usize) -> void {
    raw8(writing, TAG_FORMAT_INFO)
    putU8(writing, @intCast(u8, @bitCast(u32, format.encoding(info)) & 255))
    putProplist(writing, format.properties(info))
}

// The packet: descriptor filled in (`channel`, offset, flags).
pub fn finish(writing: *Writer, channel: u32, offset: u64, flags: u32) -> void {
    store32(writing.*.data, 0, @intCast(u32, writing.*.length - DESCRIPTOR))
    store32(writing.*.data, 4, channel)
    store32(writing.*.data, 8, @intCast(u32, offset >> 32))
    store32(writing.*.data, 12, @intCast(u32, offset & 4294967295))
    store32(writing.*.data, 16, flags)
}

pub fn command(code: u32, tag: u32) -> Writer {
    var writing = writer()
    putU32(&writing, code)
    putU32(&writing, tag)
    return writing
}

// ---------------------------------------------------------------------------
// Reading a payload

pub const Reader = struct {
    data: usize
    length: usize
    position: usize
    failed: bool
}

pub fn reader(data: usize, length: usize) -> Reader { return Reader.{ .data = data, .length = length, .position = 0, .failed = false } }

pub fn atEnd(reading: *Reader) -> bool { return reading.*.position >= reading.*.length }

fn expect(reading: *Reader, tag: u8, count: usize) -> bool {
    if reading.*.failed || reading.*.position + 1 + count > reading.*.length || c.get8(reading.*.data, reading.*.position) != tag {
        reading.*.failed = true
        return false
    }
    reading.*.position += 1
    return true
}

fn take8(reading: *Reader) -> u8 {
    const value = c.get8(reading.*.data, reading.*.position)
    reading.*.position += 1
    return value
}

fn take32(reading: *Reader) -> u32 {
    const value = load32(reading.*.data, reading.*.position)
    reading.*.position += 4
    return value
}

fn take64(reading: *Reader) -> u64 {
    const high = @intCast(u64, take32(reading))
    return (high << 32) | @intCast(u64, take32(reading))
}

fn more(reading: *Reader, count: usize) -> bool {
    if reading.*.position + count > reading.*.length {
        reading.*.failed = true
        return false
    }
    return true
}

pub fn readU32(reading: *Reader) -> u32 {
    if !expect(reading, TAG_U32, 4) { return 0 }
    return take32(reading)
}

pub fn readU8(reading: *Reader) -> u8 {
    if !expect(reading, TAG_U8, 1) { return 0 }
    return take8(reading)
}

pub fn readU64(reading: *Reader) -> u64 {
    if !expect(reading, TAG_U64, 8) { return 0 }
    return take64(reading)
}

pub fn readS64(reading: *Reader) -> i64 {
    if !expect(reading, TAG_S64, 8) { return 0 }
    return @bitCast(i64, take64(reading))
}

pub fn readUsec(reading: *Reader) -> u64 {
    if !expect(reading, TAG_USEC, 8) { return 0 }
    return take64(reading)
}

pub fn readVolume(reading: *Reader) -> u32 {
    if !expect(reading, TAG_VOLUME, 4) { return 0 }
    return take32(reading)
}

pub fn readBool(reading: *Reader) -> bool {
    if reading.*.failed || reading.*.position >= reading.*.length {
        reading.*.failed = true
        return false
    }
    const tag = c.get8(reading.*.data, reading.*.position)
    if tag != TAG_TRUE && tag != TAG_FALSE {
        reading.*.failed = true
        return false
    }
    reading.*.position += 1
    return tag == TAG_TRUE
}

// A string in place (an address into the payload; 0 for the null
// string). It lives as long as the payload.
pub fn readString(reading: *Reader) -> usize {
    if reading.*.failed || reading.*.position >= reading.*.length {
        reading.*.failed = true
        return 0
    }
    const tag = c.get8(reading.*.data, reading.*.position)
    if tag == TAG_STRING_NULL {
        reading.*.position += 1
        return 0
    }
    if tag != TAG_STRING {
        reading.*.failed = true
        return 0
    }
    const start = reading.*.position + 1
    var end = start
    while end < reading.*.length && c.get8(reading.*.data, end) != 0 { end += 1 }
    if end >= reading.*.length {
        reading.*.failed = true
        return 0
    }
    reading.*.position = end + 1
    return reading.*.data + start
}

// Arbitrary bytes: their address (in the payload) and count.
pub fn readArbitrary(reading: *Reader, count: *usize) -> usize {
    if !expect(reading, TAG_ARBITRARY, 4) { return 0 }
    const size = @intCast(usize, take32(reading))
    if !more(reading, size) { return 0 }
    const start = reading.*.data + reading.*.position
    reading.*.position += size
    count.* = size
    return start
}

// Into a pa_sample_spec at `spec`.
pub fn readSampleSpec(reading: *Reader, spec: usize) -> void {
    if !expect(reading, TAG_SAMPLE_SPEC, 6) { return }
    const kind = take8(reading)
    const count = take8(reading)
    const rate = take32(reading)
    sample.write(spec, sample.Spec.{ .format = @intCast(u32, kind), .rate = rate, .channels = @intCast(u32, count) })
}

pub fn readChannelMap(reading: *Reader, map: usize) -> void {
    if !expect(reading, TAG_CHANNEL_MAP, 1) { return }
    const count = take8(reading)
    if count > 32 || !more(reading, @intCast(usize, count)) {
        reading.*.failed = true
        return
    }
    channels.init(map)
    channels.setChannels(map, @intCast(u32, count))
    var index: u32 = 0
    while index < @intCast(u32, count) {
        channels.setPosition(map, index, @intCast(u32, take8(reading)))
        index += 1
    }
}

pub fn readCvolume(reading: *Reader, levels: usize) -> void {
    if !expect(reading, TAG_CVOLUME, 1) { return }
    const count = take8(reading)
    if count > 32 || !more(reading, @intCast(usize, count) * 4) {
        reading.*.failed = true
        return
    }
    volume.init(levels)
    volume.setCount(levels, @intCast(u32, count))
    var index: u32 = 0
    while index < @intCast(u32, count) {
        volume.setValue(levels, index, take32(reading))
        index += 1
    }
}

pub fn readTimeval(reading: *Reader, time: usize) -> void {
    if !expect(reading, TAG_TIMEVAL, 8) { return }
    c.put64(time, 0, @intCast(u64, take32(reading)))
    c.put64(time, 8, @intCast(u64, take32(reading)))
}

// Into the property list `list` (added to it).
pub fn readProplist(reading: *Reader, list: usize) -> void {
    if !expect(reading, TAG_PROPLIST, 0) { return }
    while true {
        const key = readString(reading)
        if reading.*.failed { return }
        if key == 0 { return }
        const size = readU32(reading)
        var count: usize = 0
        const value = readArbitrary(reading, &count)
        if reading.*.failed || count != @intCast(usize, size) {
            reading.*.failed = true
            return
        }
        if list != 0 { const set = proplist.set(list, c.slice(key), value, count) }
    }
}

// Into a pa_format_info made with format.new.
pub fn readFormat(reading: *Reader, info: usize) -> void {
    if !expect(reading, TAG_FORMAT_INFO, 0) { return }
    const encoding = readU8(reading)
    format.setEncoding(info, @intCast(i32, encoding))
    readProplist(reading, format.properties(info))
}
