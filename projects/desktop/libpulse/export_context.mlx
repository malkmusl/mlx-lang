// libpulse's contexts, operations and the server's objects for C:
// pa_context_*, pa_operation_*, the introspection requests, the sample
// cache, the (obsolete) autoload entries and the extensions.
const c = @import("./c.mlx")
const core = @import("./core.mlx")
const context = @import("./context.mlx")
const introspect = @import("./introspect.mlx")
const util = @import("./util.mlx")
const wire = @import("./wire.mlx")

const INVALID: u32 = 4294967295

fn flag(value: bool) -> i32 { return if value { 1 } else { 0 } }

fn ending(owner: usize) -> bool { return core.state(owner) == core.FAILED || core.state(owner) == core.TERMINATED }

// ---------------------------------------------------------------------------
// Contexts

export fn pa_context_new(api: usize, name: usize) -> usize { return context.new(api, name, 0) }

export fn pa_context_new_with_proplist(api: usize, name: usize, list: usize) -> usize { return context.new(api, name, list) }

export fn pa_context_ref(owner: usize) -> usize {
    core.ref(owner)
    return owner
}

export fn pa_context_unref(owner: usize) -> void { core.unref(owner) }

export fn pa_context_set_state_callback(owner: usize, callback: usize, userdata: usize) -> void {
    if ending(owner) { return }
    c.putPointer(owner, core.C_STATE_CALLBACK, callback)
    c.putPointer(owner, core.C_STATE_USERDATA, userdata)
}

export fn pa_context_set_event_callback(owner: usize, callback: usize, userdata: usize) -> void {
    if ending(owner) { return }
    c.putPointer(owner, core.C_EVENT_CALLBACK, callback)
    c.putPointer(owner, core.C_EVENT_USERDATA, userdata)
}

export fn pa_context_set_subscribe_callback(owner: usize, callback: usize, userdata: usize) -> void {
    if ending(owner) { return }
    c.putPointer(owner, core.C_SUBSCRIBE_CALLBACK, callback)
    c.putPointer(owner, core.C_SUBSCRIBE_USERDATA, userdata)
}

export fn pa_context_errno(owner: usize) -> i32 {
    if owner == 0 { return util.ERR_INVALID }
    return @bitCast(i32, c.get32(owner, core.C_ERROR))
}

export fn pa_context_is_pending(owner: usize) -> i32 { return context.isPending(owner) }

export fn pa_context_get_state(owner: usize) -> i32 { return @bitCast(i32, core.state(owner)) }

export fn pa_context_connect(owner: usize, server: usize, flags: u32, spawn: usize) -> i32 { return context.connect(owner, server, flags) }

export fn pa_context_disconnect(owner: usize) -> void { context.disconnect(owner) }

export fn pa_context_drain(owner: usize, callback: usize, userdata: usize) -> usize { return context.drain(owner, callback, userdata) }

export fn pa_context_exit_daemon(owner: usize, callback: usize, userdata: usize) -> usize { return context.exitDaemon(owner, callback, userdata) }

export fn pa_context_set_default_sink(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return context.setDefault(owner, true, name, callback, userdata) }

export fn pa_context_set_default_source(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return context.setDefault(owner, false, name, callback, userdata) }

export fn pa_context_is_local(owner: usize) -> i32 {
    if !core.good(core.state(owner)) { return core.fail(owner, util.ERR_BADSTATE) }
    return @bitCast(i32, c.get32(owner, core.C_LOCAL))
}

export fn pa_context_set_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return context.setName(owner, name, callback, userdata) }

export fn pa_context_get_server(owner: usize) -> usize { return context.server(owner) }

export fn pa_context_get_protocol_version(owner: usize) -> u32 { return context.PROTOCOL_VERSION }

export fn pa_context_get_server_protocol_version(owner: usize) -> u32 {
    if !core.good(core.state(owner)) {
        const failed = core.fail(owner, util.ERR_BADSTATE)
        return INVALID
    }
    return core.version(owner)
}

export fn pa_context_proplist_update(owner: usize, mode: u32, list: usize, callback: usize, userdata: usize) -> usize { return context.proplistUpdate(owner, mode, list, callback, userdata) }

export fn pa_context_proplist_remove(owner: usize, keys: usize, callback: usize, userdata: usize) -> usize { return context.proplistRemove(owner, keys, callback, userdata) }

export fn pa_context_get_index(owner: usize) -> u32 {
    if core.state(owner) != core.READY {
        const failed = core.fail(owner, util.ERR_BADSTATE)
        return INVALID
    }
    return c.get32(owner, core.C_CLIENT)
}

export fn pa_context_rttime_new(owner: usize, usec: u64, callback: usize, userdata: usize) -> usize { return core.timeNew(owner, usec, callback, userdata) }

export fn pa_context_rttime_restart(owner: usize, event: usize, usec: u64) -> void { core.timeRestart(owner, event, usec) }

export fn pa_context_get_tile_size(owner: usize, spec: usize) -> usize { return context.tileSize(owner, spec) }

export fn pa_context_load_cookie_from_file(owner: usize, path: usize) -> i32 { return context.loadCookie(owner, path) }

export fn pa_context_subscribe(owner: usize, mask: u32, callback: usize, userdata: usize) -> usize { return context.subscribe(owner, mask, callback, userdata) }

// ---------------------------------------------------------------------------
// Operations

export fn pa_operation_ref(operation: usize) -> usize {
    core.operationRef(operation)
    return operation
}

export fn pa_operation_unref(operation: usize) -> void { core.operationUnref(operation) }

export fn pa_operation_cancel(operation: usize) -> void { core.cancel(operation) }

export fn pa_operation_get_state(operation: usize) -> i32 { return @bitCast(i32, core.operationState(operation)) }

export fn pa_operation_set_state_callback(operation: usize, callback: usize, userdata: usize) -> void { core.setOperationStateCallback(operation, callback, userdata) }

// ---------------------------------------------------------------------------
// The server's objects

export fn pa_context_get_server_info(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.serverInfo(owner, callback, userdata) }

export fn pa_context_stat(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.stat(owner, callback, userdata) }

export fn pa_context_get_sink_info_by_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return introspect.byName(owner, introspect.GET_SINK_INFO, name, core.R_SINK_INFO, callback, userdata) }

export fn pa_context_get_sink_info_by_index(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_SINK_INFO, index, true, core.R_SINK_INFO, callback, userdata) }

export fn pa_context_get_sink_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_SINK_INFO_LIST, core.R_SINK_INFO, callback, userdata) }

export fn pa_context_get_source_info_by_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return introspect.byName(owner, introspect.GET_SOURCE_INFO, name, core.R_SOURCE_INFO, callback, userdata) }

export fn pa_context_get_source_info_by_index(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_SOURCE_INFO, index, true, core.R_SOURCE_INFO, callback, userdata) }

export fn pa_context_get_source_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_SOURCE_INFO_LIST, core.R_SOURCE_INFO, callback, userdata) }

export fn pa_context_get_module_info(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_MODULE_INFO, index, false, core.R_MODULE_INFO, callback, userdata) }

export fn pa_context_get_module_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_MODULE_INFO_LIST, core.R_MODULE_INFO, callback, userdata) }

export fn pa_context_get_client_info(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_CLIENT_INFO, index, false, core.R_CLIENT_INFO, callback, userdata) }

export fn pa_context_get_client_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_CLIENT_INFO_LIST, core.R_CLIENT_INFO, callback, userdata) }

export fn pa_context_get_card_info_by_index(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_CARD_INFO, index, true, core.R_CARD_INFO, callback, userdata) }

export fn pa_context_get_card_info_by_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return introspect.byName(owner, introspect.GET_CARD_INFO, name, core.R_CARD_INFO, callback, userdata) }

export fn pa_context_get_card_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_CARD_INFO_LIST, core.R_CARD_INFO, callback, userdata) }

export fn pa_context_get_sink_input_info(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_SINK_INPUT_INFO, index, false, core.R_SINK_INPUT_INFO, callback, userdata) }

export fn pa_context_get_sink_input_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_SINK_INPUT_INFO_LIST, core.R_SINK_INPUT_INFO, callback, userdata) }

export fn pa_context_get_source_output_info(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_SOURCE_OUTPUT_INFO, index, false, core.R_SOURCE_OUTPUT_INFO, callback, userdata) }

export fn pa_context_get_source_output_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_SOURCE_OUTPUT_INFO_LIST, core.R_SOURCE_OUTPUT_INFO, callback, userdata) }

export fn pa_context_get_sample_info_by_name(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return introspect.byName(owner, introspect.GET_SAMPLE_INFO, name, core.R_SAMPLE_INFO, callback, userdata) }

export fn pa_context_get_sample_info_by_index(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.byIndex(owner, introspect.GET_SAMPLE_INFO, index, true, core.R_SAMPLE_INFO, callback, userdata) }

export fn pa_context_get_sample_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.request(owner, introspect.GET_SAMPLE_INFO_LIST, core.R_SAMPLE_INFO, callback, userdata) }

export fn pa_context_set_sink_volume_by_index(owner: usize, index: u32, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_VOLUME, index, 0, introspect.VALUE_VOLUME, levels, callback, userdata) }

export fn pa_context_set_sink_volume_by_name(owner: usize, name: usize, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_VOLUME, INVALID, name, introspect.VALUE_VOLUME, levels, callback, userdata) }

export fn pa_context_set_sink_mute_by_index(owner: usize, index: u32, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_MUTE, index, 0, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

export fn pa_context_set_sink_mute_by_name(owner: usize, name: usize, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_MUTE, INVALID, name, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

export fn pa_context_set_sink_port_by_index(owner: usize, index: u32, port: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_PORT, index, 0, introspect.VALUE_STRING, port, callback, userdata) }

export fn pa_context_set_sink_port_by_name(owner: usize, name: usize, port: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SINK_PORT, INVALID, name, introspect.VALUE_STRING, port, callback, userdata) }

export fn pa_context_set_source_volume_by_index(owner: usize, index: u32, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_VOLUME, index, 0, introspect.VALUE_VOLUME, levels, callback, userdata) }

export fn pa_context_set_source_volume_by_name(owner: usize, name: usize, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_VOLUME, INVALID, name, introspect.VALUE_VOLUME, levels, callback, userdata) }

export fn pa_context_set_source_mute_by_index(owner: usize, index: u32, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_MUTE, index, 0, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

export fn pa_context_set_source_mute_by_name(owner: usize, name: usize, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_MUTE, INVALID, name, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

export fn pa_context_set_source_port_by_index(owner: usize, index: u32, port: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_PORT, index, 0, introspect.VALUE_STRING, port, callback, userdata) }

export fn pa_context_set_source_port_by_name(owner: usize, name: usize, port: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_SOURCE_PORT, INVALID, name, introspect.VALUE_STRING, port, callback, userdata) }

export fn pa_context_set_card_profile_by_index(owner: usize, index: u32, profile: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_CARD_PROFILE, index, 0, introspect.VALUE_STRING, profile, callback, userdata) }

export fn pa_context_set_card_profile_by_name(owner: usize, name: usize, profile: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnDevice(owner, introspect.SET_CARD_PROFILE, INVALID, name, introspect.VALUE_STRING, profile, callback, userdata) }

export fn pa_context_suspend_sink_by_name(owner: usize, name: usize, suspended: i32, callback: usize, userdata: usize) -> usize { return introspect.suspend(owner, introspect.SUSPEND_SINK, INVALID, name, suspended != 0, callback, userdata) }

export fn pa_context_suspend_sink_by_index(owner: usize, index: u32, suspended: i32, callback: usize, userdata: usize) -> usize { return introspect.suspend(owner, introspect.SUSPEND_SINK, index, 0, suspended != 0, callback, userdata) }

export fn pa_context_suspend_source_by_name(owner: usize, name: usize, suspended: i32, callback: usize, userdata: usize) -> usize { return introspect.suspend(owner, introspect.SUSPEND_SOURCE, INVALID, name, suspended != 0, callback, userdata) }

export fn pa_context_suspend_source_by_index(owner: usize, index: u32, suspended: i32, callback: usize, userdata: usize) -> usize { return introspect.suspend(owner, introspect.SUSPEND_SOURCE, index, 0, suspended != 0, callback, userdata) }

export fn pa_context_set_sink_input_volume(owner: usize, index: u32, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.SET_SINK_INPUT_VOLUME, index, introspect.VALUE_VOLUME, levels, callback, userdata) }

export fn pa_context_set_sink_input_mute(owner: usize, index: u32, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.SET_SINK_INPUT_MUTE, index, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

export fn pa_context_set_source_output_volume(owner: usize, index: u32, levels: usize, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.SET_SOURCE_OUTPUT_VOLUME, index, introspect.VALUE_VOLUME, levels, callback, userdata) }

export fn pa_context_set_source_output_mute(owner: usize, index: u32, mute: i32, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.SET_SOURCE_OUTPUT_MUTE, index, introspect.VALUE_BOOL, @intCast(usize, @bitCast(u32, mute)), callback, userdata) }

export fn pa_context_kill_client(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.KILL_CLIENT, index, introspect.VALUE_NONE, 0, callback, userdata) }

export fn pa_context_kill_sink_input(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.KILL_SINK_INPUT, index, introspect.VALUE_NONE, 0, callback, userdata) }

export fn pa_context_kill_source_output(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.KILL_SOURCE_OUTPUT, index, introspect.VALUE_NONE, 0, callback, userdata) }

export fn pa_context_unload_module(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return introspect.setOnIndex(owner, introspect.UNLOAD_MODULE, index, introspect.VALUE_NONE, 0, callback, userdata) }

export fn pa_context_load_module(owner: usize, name: usize, argument: usize, callback: usize, userdata: usize) -> usize { return introspect.loadModule(owner, name, argument, callback, userdata) }

export fn pa_context_move_sink_input_by_name(owner: usize, index: u32, name: usize, callback: usize, userdata: usize) -> usize { return introspect.move(owner, introspect.MOVE_SINK_INPUT, index, INVALID, name, callback, userdata) }

export fn pa_context_move_sink_input_by_index(owner: usize, index: u32, target: u32, callback: usize, userdata: usize) -> usize { return introspect.move(owner, introspect.MOVE_SINK_INPUT, index, target, 0, callback, userdata) }

export fn pa_context_move_source_output_by_name(owner: usize, index: u32, name: usize, callback: usize, userdata: usize) -> usize { return introspect.move(owner, introspect.MOVE_SOURCE_OUTPUT, index, INVALID, name, callback, userdata) }

export fn pa_context_move_source_output_by_index(owner: usize, index: u32, target: u32, callback: usize, userdata: usize) -> usize { return introspect.move(owner, introspect.MOVE_SOURCE_OUTPUT, index, target, 0, callback, userdata) }

export fn pa_context_set_port_latency_offset(owner: usize, card: usize, port: usize, offset: i64, callback: usize, userdata: usize) -> usize { return introspect.portLatencyOffset(owner, card, port, offset, callback, userdata) }

export fn pa_context_send_message_to_object(owner: usize, path: usize, message: usize, parameters: usize, callback: usize, userdata: usize) -> usize { return introspect.sendMessage(owner, path, message, parameters, callback, userdata) }

// ---------------------------------------------------------------------------
// The sample cache

export fn pa_context_play_sample(owner: usize, name: usize, device: usize, level: u32, callback: usize, userdata: usize) -> usize { return introspect.playSample(owner, name, device, level, 0, false, callback, userdata) }

export fn pa_context_play_sample_with_proplist(owner: usize, name: usize, device: usize, level: u32, list: usize, callback: usize, userdata: usize) -> usize { return introspect.playSample(owner, name, device, level, list, true, callback, userdata) }

export fn pa_context_remove_sample(owner: usize, name: usize, callback: usize, userdata: usize) -> usize { return introspect.removeSample(owner, name, callback, userdata) }

// ---------------------------------------------------------------------------
// Autoload entries went with PulseAudio 0.9.

fn obsolete(owner: usize) -> usize {
    const failed = core.fail(owner, util.ERR_OBSOLETE)
    return 0
}

export fn pa_context_get_autoload_info_by_name(owner: usize, name: usize, kind: i32, callback: usize, userdata: usize) -> usize { return obsolete(owner) }

export fn pa_context_get_autoload_info_by_index(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return obsolete(owner) }

export fn pa_context_get_autoload_info_list(owner: usize, callback: usize, userdata: usize) -> usize { return obsolete(owner) }

export fn pa_context_add_autoload(owner: usize, name: usize, kind: i32, module: usize, argument: usize, callback: usize, userdata: usize) -> usize { return obsolete(owner) }

export fn pa_context_remove_autoload_by_name(owner: usize, name: usize, kind: i32, callback: usize, userdata: usize) -> usize { return obsolete(owner) }

export fn pa_context_remove_autoload_by_index(owner: usize, index: u32, callback: usize, userdata: usize) -> usize { return obsolete(owner) }

// ---------------------------------------------------------------------------
// Extensions: asked for (their subcommands), answered by the server
// (MLX Audio: no such extension). Their events never come.

const STREAM_RESTORE: []const u8 = "module-stream-restore"
const DEVICE_RESTORE: []const u8 = "module-device-restore"
const DEVICE_MANAGER: []const u8 = "module-device-manager"

export fn pa_ext_stream_restore_test(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, STREAM_RESTORE, 0, core.R_EXT_TEST, 0, false, callback, userdata) }

export fn pa_ext_stream_restore_read(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, STREAM_RESTORE, 1, core.R_EXT_LIST, 0, false, callback, userdata) }

export fn pa_ext_stream_restore_write(owner: usize, mode: i32, data: usize, count: u32, apply: i32, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, STREAM_RESTORE, 2, core.R_EXT_ACK, 0, false, callback, userdata) }

export fn pa_ext_stream_restore_delete(owner: usize, names: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, STREAM_RESTORE, 3, core.R_EXT_ACK, 0, false, callback, userdata) }

export fn pa_ext_stream_restore_subscribe(owner: usize, enable: i32, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, STREAM_RESTORE, 4, core.R_EXT_ACK, @bitCast(u32, enable), true, callback, userdata) }

export fn pa_ext_stream_restore_set_subscribe_cb(owner: usize, callback: usize, userdata: usize) -> void {
    c.putPointer(owner, core.C_EXT_STREAM_CALLBACK, callback)
    c.putPointer(owner, core.C_EXT_STREAM_USERDATA, userdata)
}

export fn pa_ext_device_restore_test(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_RESTORE, 0, core.R_EXT_TEST, 0, false, callback, userdata) }

export fn pa_ext_device_restore_subscribe(owner: usize, enable: i32, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_RESTORE, 1, core.R_EXT_ACK, @bitCast(u32, enable), true, callback, userdata) }

export fn pa_ext_device_restore_set_subscribe_cb(owner: usize, callback: usize, userdata: usize) -> void {}

export fn pa_ext_device_restore_read_formats_all(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_RESTORE, 3, core.R_EXT_LIST, 0, false, callback, userdata) }

export fn pa_ext_device_restore_read_formats(owner: usize, kind: i32, index: u32, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_RESTORE, 4, core.R_EXT_LIST, 0, false, callback, userdata) }

export fn pa_ext_device_restore_save_formats(owner: usize, kind: i32, index: u32, count: u8, formats: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_RESTORE, 5, core.R_EXT_ACK, 0, false, callback, userdata) }

export fn pa_ext_device_manager_test(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_MANAGER, 0, core.R_EXT_TEST, 0, false, callback, userdata) }

export fn pa_ext_device_manager_read(owner: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_MANAGER, 1, core.R_EXT_LIST, 0, false, callback, userdata) }

export fn pa_ext_device_manager_set_device_description(owner: usize, device: usize, description: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_MANAGER, 2, core.R_EXT_ACK, 0, false, callback, userdata) }

export fn pa_ext_device_manager_delete(owner: usize, names: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_MANAGER, 3, core.R_EXT_ACK, 0, false, callback, userdata) }

export fn pa_ext_device_manager_enable_role_device_priority_routing(owner: usize, enable: i32, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_MANAGER, 4, core.R_EXT_ACK, @bitCast(u32, enable), true, callback, userdata) }

export fn pa_ext_device_manager_reorder_devices_for_role(owner: usize, role: usize, devices: usize, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_MANAGER, 5, core.R_EXT_ACK, 0, false, callback, userdata) }

export fn pa_ext_device_manager_subscribe(owner: usize, enable: i32, callback: usize, userdata: usize) -> usize { return introspect.extension(owner, DEVICE_MANAGER, 6, core.R_EXT_ACK, @bitCast(u32, enable), true, callback, userdata) }

export fn pa_ext_device_manager_set_subscribe_cb(owner: usize, callback: usize, userdata: usize) -> void {}
