// libpulse's functions on values: sample specs, channel maps, volumes,
// property lists, formats, times, strings and names (PulseAudio 16.1's
// names and signatures; C calls them, hence `export`).
const std = @import("std")
const c = @import("./c.mlx")
const util = @import("./util.mlx")
const sample = @import("./sample.mlx")
const channels = @import("./channels.mlx")
const volume = @import("./volume.mlx")
const proplist = @import("./proplist.mlx")
const format = @import("./format.mlx")
const printf = @import("./printf.mlx")

const INVALID: u32 = 4294967295
const SIZE_INVALID: usize = 18446744073709551615

fn flag(value: bool) -> i32 { return if value { 1 } else { 0 } }

// ---------------------------------------------------------------------------
// Memory and strings

export fn pa_xmalloc(size: usize) -> usize { return c.alloc(size) }

export fn pa_xmalloc0(size: usize) -> usize { return c.alloc(size) }

export fn pa_xrealloc(address: usize, size: usize) -> usize { return c.grow(address, size) }

export fn pa_xfree(address: usize) -> void { c.release(address) }

export fn pa_xstrdup(text: usize) -> usize { return c.duplicateC(text) }

export fn pa_xstrndup(text: usize, most: usize) -> usize {
    if text == 0 { return 0 }
    var count: usize = 0
    while count < most && c.get8(text, count) != 0 { count += 1 }
    return c.duplicate(c.bytes(text)[0..count])
}

export fn pa_xmemdup(data: usize, size: usize) -> usize {
    if data == 0 { return 0 }
    const copied = c.alloc(size)
    c.copy(copied, data, size)
    return copied
}

export fn pa_get_library_version() -> usize { return c.literal("16.1.0") }

export fn pa_strerror(code: i32) -> usize { return util.strerror(code) }

export fn pa_utf8_valid(text: usize) -> usize { return if util.utf8Valid(c.slice(text)) { text } else { 0 } }

export fn pa_ascii_valid(text: usize) -> usize { return if util.asciiValid(c.slice(text)) { text } else { 0 } }

export fn pa_utf8_filter(text: usize) -> usize { return util.utf8Filter(c.slice(text)) }

export fn pa_ascii_filter(text: usize) -> usize { return util.asciiFilter(c.slice(text)) }

// The locale is taken to be UTF-8 (what is not passes as '_').
export fn pa_utf8_to_locale(text: usize) -> usize { return util.utf8Filter(c.slice(text)) }

export fn pa_locale_to_utf8(text: usize) -> usize { return util.utf8Filter(c.slice(text)) }

export fn pa_get_user_name(buffer: usize, capacity: usize) -> usize { return util.userName(buffer, capacity) }

export fn pa_get_host_name(buffer: usize, capacity: usize) -> usize { return util.hostName(buffer, capacity) }

export fn pa_get_fqdn(buffer: usize, capacity: usize) -> usize { return util.hostName(buffer, capacity) }

export fn pa_get_home_dir(buffer: usize, capacity: usize) -> usize { return util.homeDirectory(buffer, capacity) }

export fn pa_get_binary_name(buffer: usize, capacity: usize) -> usize { return util.binaryName(buffer, capacity) }

export fn pa_path_get_filename(path: usize) -> usize {
    if path == 0 { return 0 }
    return path + util.fileNameStart(c.slice(path))
}

export fn pa_msleep(milliseconds: u64) -> i32 {
    util.sleep(milliseconds)
    return 0
}

// SCHED_RR (with SCHED_RESET_ON_FORK) at `priority`; 0 or -1.
export fn pa_thread_make_realtime(priority: i32) -> i32 {
    var parameter: i32 = priority
    const set = std.linux.syscall3(144, 0, 1073741826, @intFromPtr(&parameter))
    return if set == 0 { 0 } else { -1 }
}

export fn pa_encoding_to_string(encoding: i32) -> usize { return util.encodingName(encoding) }

export fn pa_encoding_from_string(name: usize) -> i32 { return util.encodingFromName(c.slice(name)) }

export fn pa_direction_valid(direction: i32) -> i32 { return flag(util.directionValid(direction)) }

export fn pa_direction_to_string(direction: i32) -> usize { return util.directionName(direction) }

// ---------------------------------------------------------------------------
// Times

export fn pa_gettimeofday(time: usize) -> usize { return util.now(time) }

export fn pa_timeval_diff(first: usize, second: usize) -> u64 { return util.difference(first, second) }

export fn pa_timeval_cmp(first: usize, second: usize) -> i32 { return util.compare(first, second) }

export fn pa_timeval_age(time: usize) -> u64 {
    var now: [2]u64 = [2]u64{ 0, 0 }
    return util.difference(util.now(@intFromPtr(&now)), time)
}

export fn pa_timeval_add(time: usize, value: u64) -> usize { return util.addTime(time, value) }

export fn pa_timeval_sub(time: usize, value: u64) -> usize { return util.subtractTime(time, value) }

export fn pa_timeval_store(time: usize, value: u64) -> usize {
    util.storeTime(time, value)
    return time
}

export fn pa_timeval_load(time: usize) -> u64 { return util.loadTime(time) }

export fn pa_rtclock_now() -> u64 { return c.monotonic() }

// ---------------------------------------------------------------------------
// Sample specs

export fn pa_sample_size(spec: usize) -> usize { return sample.sizeOfFormat(sample.read(spec).format) }

export fn pa_sample_size_of_format(kind: i32) -> usize { return sample.sizeOfFormat(@bitCast(u32, kind)) }

export fn pa_frame_size(spec: usize) -> usize { return sample.frameSize(sample.read(spec)) }

export fn pa_bytes_per_second(spec: usize) -> usize { return sample.bytesPerSecond(sample.read(spec)) }

export fn pa_bytes_to_usec(bytes: u64, spec: usize) -> u64 { return sample.bytesToUsec(bytes, sample.read(spec)) }

export fn pa_usec_to_bytes(usec: u64, spec: usize) -> usize { return sample.usecToBytes(usec, sample.read(spec)) }

export fn pa_sample_spec_init(spec: usize) -> usize {
    sample.write(spec, sample.Spec.{ .format = sample.INVALID, .rate = 0, .channels = 0 })
    return spec
}

export fn pa_sample_format_valid(kind: u32) -> i32 { return flag(sample.formatValid(kind)) }

export fn pa_sample_rate_valid(rate: u32) -> i32 { return flag(sample.rateValid(rate)) }

export fn pa_channels_valid(count: u8) -> i32 { return flag(sample.channelsValid(@intCast(u32, count))) }

export fn pa_sample_spec_valid(spec: usize) -> i32 { return flag(sample.valid(sample.read(spec))) }

export fn pa_sample_spec_equal(first: usize, second: usize) -> i32 {
    if first == second { return 1 }
    return flag(sample.equal(sample.read(first), sample.read(second)))
}

export fn pa_sample_format_to_string(kind: i32) -> usize { return sample.formatName(@bitCast(u32, kind)) }

export fn pa_parse_sample_format(name: usize) -> i32 { return @bitCast(i32, sample.parseFormat(c.slice(name))) }

export fn pa_sample_spec_snprint(buffer: usize, capacity: usize, spec: usize) -> usize { return sample.print(buffer, capacity, sample.read(spec)) }

export fn pa_bytes_snprint(buffer: usize, capacity: usize, value: u32) -> usize { return sample.printBytes(buffer, capacity, value) }

export fn pa_sample_format_is_le(kind: i32) -> i32 { return sample.littleEndian(@bitCast(u32, kind)) }

export fn pa_sample_format_is_be(kind: i32) -> i32 {
    const little = sample.littleEndian(@bitCast(u32, kind))
    return if little < 0 { -1 } else { 1 - little }
}

// ---------------------------------------------------------------------------
// Channel maps

export fn pa_channel_map_init(map: usize) -> usize {
    channels.init(map)
    return map
}

export fn pa_channel_map_init_mono(map: usize) -> usize {
    channels.init(map)
    channels.setChannels(map, 1)
    channels.setPosition(map, 0, channels.MONO)
    return map
}

export fn pa_channel_map_init_stereo(map: usize) -> usize {
    channels.init(map)
    channels.setChannels(map, 2)
    channels.setPosition(map, 0, channels.FRONT_LEFT)
    channels.setPosition(map, 1, channels.FRONT_RIGHT)
    return map
}

export fn pa_channel_map_init_auto(map: usize, count: u32, def: i32) -> usize { return if channels.initAuto(map, count, @bitCast(u32, def)) { map } else { 0 } }

export fn pa_channel_map_init_extend(map: usize, count: u32, def: i32) -> usize { return if channels.initExtend(map, count, @bitCast(u32, def)) { map } else { 0 } }

export fn pa_channel_position_to_string(position: i32) -> usize { return channels.positionName(@bitCast(u32, position)) }

export fn pa_channel_position_to_pretty_string(position: i32) -> usize { return channels.positionPrettyName(@bitCast(u32, position)) }

export fn pa_channel_position_from_string(name: usize) -> i32 { return @bitCast(i32, channels.positionFromName(c.slice(name))) }

export fn pa_channel_map_snprint(buffer: usize, capacity: usize, map: usize) -> usize { return channels.print(buffer, capacity, map) }

export fn pa_channel_map_parse(map: usize, text: usize) -> usize { return if channels.parse(map, c.slice(text)) { map } else { 0 } }

export fn pa_channel_map_equal(first: usize, second: usize) -> i32 { return flag(channels.equal(first, second)) }

export fn pa_channel_map_valid(map: usize) -> i32 { return flag(channels.valid(map)) }

export fn pa_channel_map_compatible(map: usize, spec: usize) -> i32 { return flag(channels.valid(map) && sample.valid(sample.read(spec)) && channels.channels(map) == sample.read(spec).channels) }

export fn pa_channel_map_superset(first: usize, second: usize) -> i32 { return flag(channels.superset(first, second)) }

export fn pa_channel_map_can_balance(map: usize) -> i32 { return flag(channels.canBalance(map)) }

export fn pa_channel_map_can_fade(map: usize) -> i32 { return flag(channels.canFade(map)) }

export fn pa_channel_map_can_lfe_balance(map: usize) -> i32 { return flag(channels.canLfeBalance(map)) }

export fn pa_channel_map_to_name(map: usize) -> usize { return channels.name(map, false) }

export fn pa_channel_map_to_pretty_name(map: usize) -> usize { return channels.name(map, true) }

export fn pa_channel_map_has_position(map: usize, position: i32) -> i32 { return flag(channels.hasPosition(map, @bitCast(u32, position))) }

export fn pa_channel_map_mask(map: usize) -> u64 { return channels.mask(map) }

// ---------------------------------------------------------------------------
// Volumes

export fn pa_cvolume_equal(first: usize, second: usize) -> i32 { return flag(volume.equal(first, second)) }

export fn pa_cvolume_init(levels: usize) -> usize {
    volume.init(levels)
    return levels
}

export fn pa_cvolume_set(levels: usize, count: u32, value: u32) -> usize {
    if count == 0 || count > 32 || !volume.isValid(value) { return 0 }
    volume.set(levels, count, value)
    return levels
}

export fn pa_cvolume_snprint(buffer: usize, capacity: usize, levels: usize) -> usize { return volume.print(buffer, capacity, levels, false) }

export fn pa_sw_cvolume_snprint_dB(buffer: usize, capacity: usize, levels: usize) -> usize { return volume.print(buffer, capacity, levels, true) }

export fn pa_cvolume_snprint_verbose(buffer: usize, capacity: usize, levels: usize, map: usize, decibels: i32) -> usize { return volume.printVerbose(buffer, capacity, levels, map, decibels != 0) }

export fn pa_volume_snprint(buffer: usize, capacity: usize, value: u32) -> usize { return volume.printVolume(buffer, capacity, value) }

export fn pa_sw_volume_snprint_dB(buffer: usize, capacity: usize, value: u32) -> usize { return volume.printVolumeDb(buffer, capacity, value) }

export fn pa_volume_snprint_verbose(buffer: usize, capacity: usize, value: u32, decibels: i32) -> usize { return volume.printVolumeVerbose(buffer, capacity, value, decibels != 0) }

export fn pa_cvolume_avg(levels: usize) -> u32 { return volume.average(levels) }

export fn pa_cvolume_avg_mask(levels: usize, map: usize, mask: u64) -> u32 { return volume.averageMask(levels, map, mask) }

export fn pa_cvolume_max(levels: usize) -> u32 { return volume.maximum(levels) }

export fn pa_cvolume_max_mask(levels: usize, map: usize, mask: u64) -> u32 { return volume.maximumMask(levels, map, mask) }

export fn pa_cvolume_min(levels: usize) -> u32 { return volume.minimum(levels) }

export fn pa_cvolume_min_mask(levels: usize, map: usize, mask: u64) -> u32 { return volume.minimumMask(levels, map, mask) }

export fn pa_cvolume_valid(levels: usize) -> i32 { return flag(volume.valid(levels)) }

export fn pa_cvolume_channels_equal_to(levels: usize, value: u32) -> i32 { return flag(volume.channelsEqualTo(levels, value)) }

export fn pa_sw_volume_multiply(first: u32, second: u32) -> u32 { return volume.multiply(first, second) }

export fn pa_sw_volume_divide(first: u32, second: u32) -> u32 { return volume.divide(first, second) }

export fn pa_sw_cvolume_multiply(dest: usize, first: usize, second: usize) -> usize { return volume.combine(dest, first, second, 0, false, false) }

export fn pa_sw_cvolume_multiply_scalar(dest: usize, first: usize, second: u32) -> usize { return volume.combine(dest, first, 0, second, true, false) }

export fn pa_sw_cvolume_divide(dest: usize, first: usize, second: usize) -> usize { return volume.combine(dest, first, second, 0, false, true) }

export fn pa_sw_cvolume_divide_scalar(dest: usize, first: usize, second: u32) -> usize { return volume.combine(dest, first, 0, second, true, true) }

export fn pa_sw_volume_from_dB(decibels: f64) -> u32 { return volume.fromDb(decibels) }

export fn pa_sw_volume_to_dB(value: u32) -> f64 { return volume.toDb(value) }

export fn pa_sw_volume_from_linear(linear: f64) -> u32 { return volume.fromLinear(linear) }

export fn pa_sw_volume_to_linear(value: u32) -> f64 { return volume.toLinear(value) }

export fn pa_cvolume_remap(levels: usize, from: usize, to: usize) -> usize { return volume.remap(levels, from, to) }

export fn pa_cvolume_compatible(levels: usize, spec: usize) -> i32 { return flag(volume.valid(levels) && sample.valid(sample.read(spec)) && volume.count(levels) == sample.read(spec).channels) }

export fn pa_cvolume_compatible_with_channel_map(levels: usize, map: usize) -> i32 { return flag(volume.compatibleWithMap(levels, map)) }

export fn pa_cvolume_get_balance(levels: usize, map: usize) -> f32 { return volume.getBalance(levels, map) }

export fn pa_cvolume_set_balance(levels: usize, map: usize, balance: f32) -> usize { return volume.setBalance(levels, map, balance) }

export fn pa_cvolume_get_fade(levels: usize, map: usize) -> f32 { return volume.getFade(levels, map) }

export fn pa_cvolume_set_fade(levels: usize, map: usize, fade: f32) -> usize { return volume.setFade(levels, map, fade) }

export fn pa_cvolume_get_lfe_balance(levels: usize, map: usize) -> f32 { return volume.getLfeBalance(levels, map) }

export fn pa_cvolume_set_lfe_balance(levels: usize, map: usize, balance: f32) -> usize { return volume.setLfeBalance(levels, map, balance) }

export fn pa_cvolume_scale(levels: usize, most: u32) -> usize { return volume.scale(levels, most) }

export fn pa_cvolume_scale_mask(levels: usize, most: u32, map: usize, mask: u64) -> usize { return volume.scaleMask(levels, most, map, mask) }

export fn pa_cvolume_set_position(levels: usize, map: usize, position: i32, value: u32) -> usize { return volume.setPosition(levels, map, @bitCast(u32, position), value) }

export fn pa_cvolume_get_position(levels: usize, map: usize, position: i32) -> u32 { return volume.getPosition(levels, map, @bitCast(u32, position)) }

export fn pa_cvolume_merge(dest: usize, first: usize, second: usize) -> usize { return volume.merge(dest, first, second) }

export fn pa_cvolume_inc_clamp(levels: usize, step: u32, limit: u32) -> usize { return volume.incClamp(levels, step, limit) }

export fn pa_cvolume_inc(levels: usize, step: u32) -> usize { return volume.incClamp(levels, step, volume.MAX) }

export fn pa_cvolume_dec(levels: usize, step: u32) -> usize { return volume.dec(levels, step) }

// ---------------------------------------------------------------------------
// Property lists

export fn pa_proplist_new() -> usize { return proplist.new() }

export fn pa_proplist_free(list: usize) -> void { proplist.free(list) }

export fn pa_proplist_key_valid(key: usize) -> i32 { return flag(proplist.keyValid(c.slice(key))) }

export fn pa_proplist_sets(list: usize, key: usize, value: usize) -> i32 { return proplist.setString(list, c.slice(key), c.slice(value)) }

export fn pa_proplist_setp(list: usize, pair: usize) -> i32 {
    const text = c.slice(pair)
    var at: usize = 0
    while at < text.length && text[at] != 61 { at += 1 }
    if at >= text.length { return -1 }
    return proplist.setString(list, text[0..at], text[at + 1..text.length])
}

// pa_proplist_setf(list, key, format, ...): the arguments a printf format
// takes, as a variadic call passes them: integers, strings and pointers in
// the integer registers left and then the stack (up to six here), doubles
// in the vector registers (up to eight).
export fn pa_proplist_setf(list: usize, key: usize, pattern: usize, a: usize, b: usize, d: usize, e: usize, f: usize, g: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> i32 {
    if !proplist.keyValid(c.slice(key)) || !util.utf8Valid(c.slice(pattern)) { return -1 }
    var integers: [6]u64 = [6]u64{ @intCast(u64, a), @intCast(u64, b), @intCast(u64, d), @intCast(u64, e), @intCast(u64, f), @intCast(u64, g) }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const text = printf.format(c.slice(pattern), @intFromPtr(&integers), 6, @intFromPtr(&doubles), 8)
    const result = proplist.setString(list, c.slice(key), c.slice(text))
    c.release(text)
    return result
}

export fn pa_proplist_set(list: usize, key: usize, data: usize, size: usize) -> i32 {
    if !proplist.keyValid(c.slice(key)) { return -1 }
    return if proplist.set(list, c.slice(key), data, size) { 0 } else { -1 }
}

export fn pa_proplist_gets(list: usize, key: usize) -> usize { return proplist.getString(list, c.slice(key)) }

export fn pa_proplist_get(list: usize, key: usize, data: usize, size: usize) -> i32 {
    if !proplist.keyValid(c.slice(key)) { return -1 }
    const index = proplist.find(list, c.slice(key))
    if index == proplist.count(list) { return -1 }
    c.putPointer(data, 0, proplist.valueAt(list, index))
    c.putPointer(size, 0, proplist.sizeAt(list, index))
    return 0
}

export fn pa_proplist_update(list: usize, mode: u32, other: usize) -> void { proplist.update(list, mode, other) }

export fn pa_proplist_unset(list: usize, key: usize) -> i32 { return proplist.unset(list, c.slice(key)) }

export fn pa_proplist_unset_many(list: usize, keys: usize) -> i32 {
    var index: usize = 0
    while c.getPointer(keys, index * 8) != 0 {
        if !proplist.keyValid(c.slice(c.getPointer(keys, index * 8))) { return -1 }
        index += 1
    }
    var removed: i32 = 0
    index = 0
    while c.getPointer(keys, index * 8) != 0 {
        if proplist.unset(list, c.slice(c.getPointer(keys, index * 8))) == 0 { removed += 1 }
        index += 1
    }
    return removed
}

// `state` holds the next index (plus one, so that NULL is the start).
export fn pa_proplist_iterate(list: usize, state: usize) -> usize {
    const index = c.getPointer(state, 0)
    if index >= proplist.count(list) { return 0 }
    c.putPointer(state, 0, index + 1)
    return proplist.keyAt(list, index)
}

export fn pa_proplist_to_string(list: usize) -> usize {
    const text = proplist.toString(list, "\n")
    var writing = util.text()
    util.add(&writing, c.slice(text))
    util.addByte(&writing, 10)
    c.release(text)
    return util.finish(&writing)
}

export fn pa_proplist_to_string_sep(list: usize, separator: usize) -> usize { return proplist.toString(list, c.slice(separator)) }

export fn pa_proplist_from_string(text: usize) -> usize { return proplist.fromString(c.slice(text)) }

export fn pa_proplist_contains(list: usize, key: usize) -> i32 {
    if !proplist.keyValid(c.slice(key)) { return -1 }
    return flag(proplist.contains(list, c.slice(key)))
}

export fn pa_proplist_clear(list: usize) -> void { proplist.clear(list) }

export fn pa_proplist_copy(list: usize) -> usize { return proplist.copy(list) }

export fn pa_proplist_size(list: usize) -> u32 { return @intCast(u32, proplist.count(list)) }

export fn pa_proplist_isempty(list: usize) -> i32 { return flag(proplist.count(list) == 0) }

export fn pa_proplist_equal(first: usize, second: usize) -> i32 { return flag(proplist.equal(first, second)) }

// ---------------------------------------------------------------------------
// Formats

export fn pa_format_info_new() -> usize { return format.new() }

export fn pa_format_info_copy(info: usize) -> usize { return format.copy(info) }

export fn pa_format_info_free(info: usize) -> void { format.free(info) }

export fn pa_format_info_valid(info: usize) -> i32 { return flag(format.valid(info)) }

export fn pa_format_info_is_pcm(info: usize) -> i32 { return flag(format.isPcm(info)) }

export fn pa_format_info_is_compatible(first: usize, second: usize) -> i32 { return flag(format.compatible(first, second)) }

export fn pa_format_info_snprint(buffer: usize, capacity: usize, info: usize) -> usize { return format.print(buffer, capacity, info) }

export fn pa_format_info_from_string(text: usize) -> usize { return format.fromString(c.slice(text)) }

export fn pa_format_info_from_sample_spec(spec: usize, map: usize) -> usize { return format.fromSampleSpec(spec, map) }

export fn pa_format_info_to_sample_spec(info: usize, spec: usize, map: usize) -> i32 { return format.toSampleSpec(info, spec, map) }

export fn pa_format_info_get_prop_type(info: usize, key: usize) -> i32 { return format.propertyType(info, c.slice(key)) }

export fn pa_format_info_get_prop_int(info: usize, key: usize, value: usize) -> i32 { return format.getInt(info, c.slice(key), value) }

export fn pa_format_info_get_prop_int_range(info: usize, key: usize, least: usize, most: usize) -> i32 { return format.getRange(info, c.slice(key), least, most) }

export fn pa_format_info_get_prop_int_array(info: usize, key: usize, values: usize, count: usize) -> i32 { return format.getIntArray(info, c.slice(key), values, count) }

export fn pa_format_info_get_prop_string(info: usize, key: usize, value: usize) -> i32 { return format.getString(info, c.slice(key), value) }

export fn pa_format_info_get_prop_string_array(info: usize, key: usize, values: usize, count: usize) -> i32 { return format.getStringArray(info, c.slice(key), values, count) }

export fn pa_format_info_free_string_array(values: usize, count: i32) -> void { format.freeStrings(values, count) }

export fn pa_format_info_set_prop_int(info: usize, key: usize, value: i32) -> void { format.setInt(info, c.slice(key), value) }

export fn pa_format_info_set_prop_int_array(info: usize, key: usize, values: usize, count: i32) -> void { format.setIntArray(info, c.slice(key), values, count) }

export fn pa_format_info_set_prop_int_range(info: usize, key: usize, least: i32, most: i32) -> void { format.setRange(info, c.slice(key), least, most) }

export fn pa_format_info_set_prop_string(info: usize, key: usize, value: usize) -> void { format.setString(info, c.slice(key), c.slice(value)) }

export fn pa_format_info_set_prop_string_array(info: usize, key: usize, values: usize, count: i32) -> void { format.setStringArray(info, c.slice(key), values, count) }

export fn pa_format_info_get_sample_format(info: usize, kind: usize) -> i32 { return format.getSampleFormat(info, kind) }

export fn pa_format_info_get_rate(info: usize, rate: usize) -> i32 { return format.getRate(info, rate) }

export fn pa_format_info_get_channels(info: usize, count: usize) -> i32 { return format.getChannels(info, count) }

export fn pa_format_info_get_channel_map(info: usize, map: usize) -> i32 { return format.getChannelMap(info, map) }

export fn pa_format_info_set_sample_format(info: usize, kind: i32) -> void { format.setSampleFormat(info, @bitCast(u32, kind)) }

export fn pa_format_info_set_rate(info: usize, rate: i32) -> void { format.setRate(info, rate) }

export fn pa_format_info_set_channels(info: usize, count: i32) -> void { format.setChannels(info, count) }

export fn pa_format_info_set_channel_map(info: usize, map: usize) -> void { format.setChannelMap(info, map) }
