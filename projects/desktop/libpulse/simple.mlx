// libpulse-simple.so.0 in Mlx: PulseAudio's blocking API (pa_simple: one
// stream that plays or records, each call waiting until it is done), as
// PulseAudio builds it: on libpulse.so.0's threaded main loop (this
// directory's libpulse.mlx), whose functions it calls.
//
//   mlx4 --plugin --library libpulse.so.0 --soname=libpulse-simple.so.0 \
//       --symbol-version=PULSE_0 projects/desktop/libpulse/simple.mlx -o libpulse-simple.so.0
const c = @import("./c.mlx")

extern("c") fn pa_threaded_mainloop_new() -> usize
extern("c") fn pa_threaded_mainloop_free(loop: usize) -> void
extern("c") fn pa_threaded_mainloop_start(loop: usize) -> i32
extern("c") fn pa_threaded_mainloop_stop(loop: usize) -> void
extern("c") fn pa_threaded_mainloop_lock(loop: usize) -> void
extern("c") fn pa_threaded_mainloop_unlock(loop: usize) -> void
extern("c") fn pa_threaded_mainloop_wait(loop: usize) -> void
extern("c") fn pa_threaded_mainloop_signal(loop: usize, accept: i32) -> void
extern("c") fn pa_threaded_mainloop_get_api(loop: usize) -> usize
extern("c") fn pa_context_new(api: usize, name: usize) -> usize
extern("c") fn pa_context_set_state_callback(context: usize, callback: usize, userdata: usize) -> void
extern("c") fn pa_context_connect(context: usize, server: usize, flags: u32, spawn: usize) -> i32
extern("c") fn pa_context_disconnect(context: usize) -> void
extern("c") fn pa_context_unref(context: usize) -> void
extern("c") fn pa_context_get_state(context: usize) -> i32
extern("c") fn pa_context_errno(context: usize) -> i32
extern("c") fn pa_stream_new(context: usize, name: usize, spec: usize, map: usize) -> usize
extern("c") fn pa_stream_unref(stream: usize) -> void
extern("c") fn pa_stream_get_state(stream: usize) -> i32
extern("c") fn pa_stream_set_state_callback(stream: usize, callback: usize, userdata: usize) -> void
extern("c") fn pa_stream_set_read_callback(stream: usize, callback: usize, userdata: usize) -> void
extern("c") fn pa_stream_set_write_callback(stream: usize, callback: usize, userdata: usize) -> void
extern("c") fn pa_stream_set_latency_update_callback(stream: usize, callback: usize, userdata: usize) -> void
extern("c") fn pa_stream_connect_playback(stream: usize, device: usize, attributes: usize, flags: u32, levels: usize, sync: usize) -> i32
extern("c") fn pa_stream_connect_record(stream: usize, device: usize, attributes: usize, flags: u32) -> i32
extern("c") fn pa_stream_writable_size(stream: usize) -> usize
extern("c") fn pa_stream_write(stream: usize, data: usize, length: usize, free: usize, offset: i64, seek: u32) -> i32
extern("c") fn pa_stream_peek(stream: usize, data: usize, length: usize) -> i32
extern("c") fn pa_stream_drop(stream: usize) -> i32
extern("c") fn pa_stream_drain(stream: usize, callback: usize, userdata: usize) -> usize
extern("c") fn pa_stream_flush(stream: usize, callback: usize, userdata: usize) -> usize
extern("c") fn pa_stream_get_latency(stream: usize, result: usize, negative: usize) -> i32
extern("c") fn pa_stream_get_sample_spec(stream: usize) -> usize
extern("c") fn pa_operation_get_state(operation: usize) -> i32
extern("c") fn pa_operation_cancel(operation: usize) -> void
extern("c") fn pa_operation_unref(operation: usize) -> void
extern("c") fn pa_sample_spec_valid(spec: usize) -> i32
extern("c") fn pa_channel_map_valid(map: usize) -> i32
extern("c") fn pa_bytes_to_usec(bytes: u64, spec: usize) -> u64

// pa_simple.
const SIZE: usize = 64
const LOOP: usize = 0
const CONTEXT: usize = 8
const STREAM: usize = 16
const DIRECTION: usize = 24
const READ_DATA: usize = 32
const READ_INDEX: usize = 40
const READ_LENGTH: usize = 48
const SUCCESS: usize = 56

const PLAYBACK: i32 = 1
const RECORD: i32 = 2
const CONTEXT_READY: i32 = 4
const STREAM_READY: i32 = 2
const STREAM_FAILED: i32 = 3
const CONTEXT_FAILED: i32 = 5
const ERR_INVALID: i32 = 3
const ERR_INTERNAL: i32 = 10
const ERR_BADSTATE: i32 = 15
const ERR_NODATA: i32 = 16
// INTERPOLATE_TIMING | ADJUST_LATENCY | AUTO_TIMING_UPDATE
const FLAGS: u32 = 8202
const USEC_INVALID: u64 = 18446744073709551615

fn loop(simple: usize) -> usize { return c.getPointer(simple, LOOP) }

fn context(simple: usize) -> usize { return c.getPointer(simple, CONTEXT) }

fn stream(simple: usize) -> usize { return c.getPointer(simple, STREAM) }

fn report(result: usize, code: i32) -> void {
    if result != 0 { c.put32(result, 0, @bitCast(u32, code)) }
}

fn contextGood(state: i32) -> bool { return state >= 1 && state <= 4 }

fn streamGood(state: i32) -> bool { return state >= 1 && state <= 2 }

// The connection and the stream still work; else the error is reported.
fn alive(simple: usize, result: usize) -> bool {
    const owner = context(simple)
    const own = stream(simple)
    if owner != 0 && contextGood(pa_context_get_state(owner)) && own != 0 && streamGood(pa_stream_get_state(own)) { return true }
    if (owner != 0 && pa_context_get_state(owner) == CONTEXT_FAILED) || (own != 0 && pa_stream_get_state(own) == STREAM_FAILED) {
        report(result, pa_context_errno(owner))
    } else {
        report(result, ERR_BADSTATE)
    }
    return false
}

export fn mlx_pulse_simple_context_state(owner: usize, simple: usize) -> void {
    const state = pa_context_get_state(owner)
    if state == CONTEXT_READY || !contextGood(state) { pa_threaded_mainloop_signal(loop(simple), 0) }
}

export fn mlx_pulse_simple_stream_state(own: usize, simple: usize) -> void {
    const state = pa_stream_get_state(own)
    if state == STREAM_READY || !streamGood(state) { pa_threaded_mainloop_signal(loop(simple), 0) }
}

export fn mlx_pulse_simple_request(own: usize, length: usize, simple: usize) -> void { pa_threaded_mainloop_signal(loop(simple), 0) }

export fn mlx_pulse_simple_latency(own: usize, simple: usize) -> void { pa_threaded_mainloop_signal(loop(simple), 0) }

export fn mlx_pulse_simple_success(own: usize, success: i32, simple: usize) -> void {
    c.put32(simple, SUCCESS, @bitCast(u32, success))
    pa_threaded_mainloop_signal(loop(simple), 0)
}

export fn pa_simple_new(server: usize, name: usize, direction: i32, device: usize, streamName: usize, spec: usize, map: usize, attributes: usize, result: usize) -> usize {
    if (server != 0 && c.get8(server, 0) == 0) || (direction != PLAYBACK && direction != RECORD) || (device != 0 && c.get8(device, 0) == 0) || spec == 0 || pa_sample_spec_valid(spec) == 0 {
        report(result, ERR_INVALID)
        return 0
    }
    if map != 0 && (pa_channel_map_valid(map) == 0 || c.get8(map, 0) != c.get8(spec, 8)) {
        report(result, ERR_INVALID)
        return 0
    }
    const simple = c.alloc(SIZE)
    c.put32(simple, DIRECTION, @bitCast(u32, direction))
    var code = ERR_INTERNAL
    c.putPointer(simple, LOOP, pa_threaded_mainloop_new())
    if loop(simple) == 0 { return failed(simple, result, code) }
    c.putPointer(simple, CONTEXT, pa_context_new(pa_threaded_mainloop_get_api(loop(simple)), name))
    if context(simple) == 0 { return failed(simple, result, code) }
    pa_context_set_state_callback(context(simple), @intFromPtr(mlx_pulse_simple_context_state), simple)
    if pa_context_connect(context(simple), server, 0, 0) < 0 { return failed(simple, result, pa_context_errno(context(simple))) }
    pa_threaded_mainloop_lock(loop(simple))
    if pa_threaded_mainloop_start(loop(simple)) < 0 { return unlockAndFail(simple, result, code) }
    while true {
        const state = pa_context_get_state(context(simple))
        if state == CONTEXT_READY { break }
        if !contextGood(state) { return unlockAndFail(simple, result, pa_context_errno(context(simple))) }
        pa_threaded_mainloop_wait(loop(simple))
    }
    c.putPointer(simple, STREAM, pa_stream_new(context(simple), streamName, spec, map))
    if stream(simple) == 0 { return unlockAndFail(simple, result, pa_context_errno(context(simple))) }
    pa_stream_set_state_callback(stream(simple), @intFromPtr(mlx_pulse_simple_stream_state), simple)
    pa_stream_set_read_callback(stream(simple), @intFromPtr(mlx_pulse_simple_request), simple)
    pa_stream_set_write_callback(stream(simple), @intFromPtr(mlx_pulse_simple_request), simple)
    pa_stream_set_latency_update_callback(stream(simple), @intFromPtr(mlx_pulse_simple_latency), simple)
    var connected: i32 = 0
    if direction == PLAYBACK {
        connected = pa_stream_connect_playback(stream(simple), device, attributes, FLAGS, 0, 0)
    } else {
        connected = pa_stream_connect_record(stream(simple), device, attributes, FLAGS)
    }
    if connected < 0 { return unlockAndFail(simple, result, pa_context_errno(context(simple))) }
    while true {
        const state = pa_stream_get_state(stream(simple))
        if state == STREAM_READY { break }
        if !streamGood(state) { return unlockAndFail(simple, result, pa_context_errno(context(simple))) }
        pa_threaded_mainloop_wait(loop(simple))
    }
    pa_threaded_mainloop_unlock(loop(simple))
    return simple
}

fn unlockAndFail(simple: usize, result: usize, code: i32) -> usize {
    pa_threaded_mainloop_unlock(loop(simple))
    return failed(simple, result, code)
}

fn failed(simple: usize, result: usize, code: i32) -> usize {
    report(result, code)
    free(simple)
    return 0
}

fn free(simple: usize) -> void {
    if loop(simple) != 0 { pa_threaded_mainloop_stop(loop(simple)) }
    if stream(simple) != 0 { pa_stream_unref(stream(simple)) }
    if context(simple) != 0 {
        pa_context_disconnect(context(simple))
        pa_context_unref(context(simple))
    }
    if loop(simple) != 0 { pa_threaded_mainloop_free(loop(simple)) }
    c.release(simple)
}

export fn pa_simple_free(simple: usize) -> void { free(simple) }

export fn pa_simple_write(simple: usize, data: usize, length: usize, result: usize) -> i32 {
    if @bitCast(i32, c.get32(simple, DIRECTION)) != PLAYBACK {
        report(result, ERR_BADSTATE)
        return -1
    }
    if data == 0 || length == 0 {
        report(result, ERR_INVALID)
        return -1
    }
    pa_threaded_mainloop_lock(loop(simple))
    var at = data
    var left = length
    var ok = alive(simple, result)
    while ok && left > 0 {
        var room = pa_stream_writable_size(stream(simple))
        while ok && room == 0 {
            pa_threaded_mainloop_wait(loop(simple))
            ok = alive(simple, result)
            if ok { room = pa_stream_writable_size(stream(simple)) }
        }
        if !ok { break }
        if room == 18446744073709551615 {
            report(result, pa_context_errno(context(simple)))
            ok = false
            break
        }
        if room > left { room = left }
        if pa_stream_write(stream(simple), at, room, 0, 0, 0) < 0 {
            report(result, pa_context_errno(context(simple)))
            ok = false
            break
        }
        at += room
        left -= room
    }
    pa_threaded_mainloop_unlock(loop(simple))
    return if ok { 0 } else { -1 }
}

export fn pa_simple_read(simple: usize, data: usize, length: usize, result: usize) -> i32 {
    if @bitCast(i32, c.get32(simple, DIRECTION)) != RECORD {
        report(result, ERR_BADSTATE)
        return -1
    }
    if data == 0 || length == 0 {
        report(result, ERR_INVALID)
        return -1
    }
    pa_threaded_mainloop_lock(loop(simple))
    var at = data
    var left = length
    var ok = alive(simple, result)
    while ok && left > 0 {
        while ok && c.getPointer(simple, READ_DATA) == 0 {
            if pa_stream_peek(stream(simple), simple + READ_DATA, simple + READ_LENGTH) != 0 {
                report(result, pa_context_errno(context(simple)))
                ok = false
            } else if c.getPointer(simple, READ_LENGTH) == 0 {
                pa_threaded_mainloop_wait(loop(simple))
                ok = alive(simple, result)
            } else if c.getPointer(simple, READ_DATA) == 0 {
                // A hole: skipped.
                if pa_stream_drop(stream(simple)) != 0 {
                    report(result, pa_context_errno(context(simple)))
                    ok = false
                }
            } else {
                c.putPointer(simple, READ_INDEX, 0)
            }
        }
        if !ok { break }
        var count = c.getPointer(simple, READ_LENGTH)
        if count > left { count = left }
        c.copy(at, c.getPointer(simple, READ_DATA) + c.getPointer(simple, READ_INDEX), count)
        at += count
        left -= count
        c.putPointer(simple, READ_INDEX, c.getPointer(simple, READ_INDEX) + count)
        c.putPointer(simple, READ_LENGTH, c.getPointer(simple, READ_LENGTH) - count)
        if c.getPointer(simple, READ_LENGTH) == 0 {
            const dropped = pa_stream_drop(stream(simple))
            c.putPointer(simple, READ_DATA, 0)
            c.putPointer(simple, READ_INDEX, 0)
            if dropped != 0 {
                report(result, pa_context_errno(context(simple)))
                ok = false
            }
        }
    }
    pa_threaded_mainloop_unlock(loop(simple))
    return if ok { 0 } else { -1 }
}

// Waits for a stream operation (drain, flush) to succeed.
fn await(simple: usize, operation: usize, result: usize) -> i32 {
    var ok = operation != 0
    if !ok { report(result, pa_context_errno(context(simple))) }
    c.put32(simple, SUCCESS, 0)
    while ok && pa_operation_get_state(operation) == 0 {
        pa_threaded_mainloop_wait(loop(simple))
        ok = alive(simple, result)
    }
    if ok && c.get32(simple, SUCCESS) == 0 {
        report(result, pa_context_errno(context(simple)))
        ok = false
    }
    if operation != 0 {
        if !ok { pa_operation_cancel(operation) }
        pa_operation_unref(operation)
    }
    pa_threaded_mainloop_unlock(loop(simple))
    return if ok { 0 } else { -1 }
}

export fn pa_simple_drain(simple: usize, result: usize) -> i32 {
    if @bitCast(i32, c.get32(simple, DIRECTION)) != PLAYBACK {
        report(result, ERR_BADSTATE)
        return -1
    }
    pa_threaded_mainloop_lock(loop(simple))
    if !alive(simple, result) {
        pa_threaded_mainloop_unlock(loop(simple))
        return -1
    }
    return await(simple, pa_stream_drain(stream(simple), @intFromPtr(mlx_pulse_simple_success), simple), result)
}

export fn pa_simple_flush(simple: usize, result: usize) -> i32 {
    pa_threaded_mainloop_lock(loop(simple))
    if !alive(simple, result) {
        pa_threaded_mainloop_unlock(loop(simple))
        return -1
    }
    return await(simple, pa_stream_flush(stream(simple), @intFromPtr(mlx_pulse_simple_success), simple), result)
}

export fn pa_simple_get_latency(simple: usize, result: usize) -> u64 {
    pa_threaded_mainloop_lock(loop(simple))
    var latency: u64 = USEC_INVALID
    while alive(simple, result) {
        var usec: u64 = 0
        var negative: i32 = 0
        if pa_stream_get_latency(stream(simple), @intFromPtr(&usec), @intFromPtr(&negative)) >= 0 {
            if @bitCast(i32, c.get32(simple, DIRECTION)) == RECORD {
                // What a read left of the chunk it peeked counts as read.
                const read = pa_bytes_to_usec(@intCast(u64, c.getPointer(simple, READ_INDEX)), pa_stream_get_sample_spec(stream(simple)))
                if negative == 0 { usec = if usec > read { usec - read } else { 0 } }
            }
            latency = if negative != 0 { 0 } else { usec }
            break
        }
        if pa_context_errno(context(simple)) != ERR_NODATA {
            report(result, pa_context_errno(context(simple)))
            break
        }
        pa_threaded_mainloop_wait(loop(simple))
    }
    pa_threaded_mainloop_unlock(loop(simple))
    return latency
}
