// The server's objects as the programs see them (pactl, pavucontrol,
// volume applets): requests for the server's, sinks', sources', clients',
// modules', streams', cards' and samples' info, and the requests that
// change them; their replies read into PulseAudio's structs (C memory, the
// strings pointing into the reply) for the program's callbacks. The
// extensions (stream and device restore, the device manager) are asked
// for like PulseAudio does; MLX Audio has none, so they fail.
const c = @import("./c.mlx")
const core = @import("./core.mlx")
const wire = @import("./wire.mlx")
const util = @import("./util.mlx")
const proplist = @import("./proplist.mlx")
const format = @import("./format.mlx")
const channels = @import("./channels.mlx")
const volume = @import("./volume.mlx")
const sample = @import("./sample.mlx")

const REPLY: u32 = 2
const STAT: u32 = 13
const PLAY_SAMPLE: u32 = 18
const REMOVE_SAMPLE: u32 = 19
const GET_SERVER_INFO: u32 = 20
pub const GET_SINK_INFO: u32 = 21
pub const GET_SINK_INFO_LIST: u32 = 22
pub const GET_SOURCE_INFO: u32 = 23
pub const GET_SOURCE_INFO_LIST: u32 = 24
pub const GET_MODULE_INFO: u32 = 25
pub const GET_MODULE_INFO_LIST: u32 = 26
pub const GET_CLIENT_INFO: u32 = 27
pub const GET_CLIENT_INFO_LIST: u32 = 28
pub const GET_SINK_INPUT_INFO: u32 = 29
pub const GET_SINK_INPUT_INFO_LIST: u32 = 30
pub const GET_SOURCE_OUTPUT_INFO: u32 = 31
pub const GET_SOURCE_OUTPUT_INFO_LIST: u32 = 32
pub const GET_SAMPLE_INFO: u32 = 33
pub const GET_SAMPLE_INFO_LIST: u32 = 34
pub const SET_SINK_VOLUME: u32 = 36
pub const SET_SINK_INPUT_VOLUME: u32 = 37
pub const SET_SOURCE_VOLUME: u32 = 38
pub const SET_SINK_MUTE: u32 = 39
pub const SET_SOURCE_MUTE: u32 = 40
pub const KILL_CLIENT: u32 = 48
pub const KILL_SINK_INPUT: u32 = 49
pub const KILL_SOURCE_OUTPUT: u32 = 50
const LOAD_MODULE: u32 = 51
pub const UNLOAD_MODULE: u32 = 52
pub const MOVE_SINK_INPUT: u32 = 67
pub const MOVE_SOURCE_OUTPUT: u32 = 68
pub const SET_SINK_INPUT_MUTE: u32 = 69
pub const SUSPEND_SINK: u32 = 70
pub const SUSPEND_SOURCE: u32 = 71
const EXTENSION: u32 = 87
pub const GET_CARD_INFO: u32 = 88
pub const GET_CARD_INFO_LIST: u32 = 89
pub const SET_CARD_PROFILE: u32 = 90
pub const SET_SINK_PORT: u32 = 96
pub const SET_SOURCE_PORT: u32 = 97
pub const SET_SOURCE_OUTPUT_VOLUME: u32 = 98
pub const SET_SOURCE_OUTPUT_MUTE: u32 = 99
const SET_PORT_LATENCY_OFFSET: u32 = 100
const SEND_OBJECT_MESSAGE: u32 = 104

fn ready(context: usize) -> bool {
    if core.state(context) == core.READY { return true }
    const failed = core.fail(context, util.ERR_BADSTATE)
    return false
}

fn refuse(context: usize, code: i32) -> usize {
    const failed = core.fail(context, code)
    return 0
}

// ---------------------------------------------------------------------------
// Requests

pub fn request(context: usize, code: u32, kind: u32, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    const tag = core.nextTag(context)
    var writing = wire.command(code, tag)
    return core.simple(context, &writing, tag, kind, callback, userdata)
}

// By index; `named` requests also carry a (null) name.
pub fn byIndex(context: usize, code: u32, index: u32, named: bool, kind: u32, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if index == wire.INVALID { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(code, tag)
    wire.putU32(&writing, index)
    if named { wire.putCString(&writing, 0) }
    return core.simple(context, &writing, tag, kind, callback, userdata)
}

pub fn byName(context: usize, code: u32, name: usize, kind: u32, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if name == 0 || c.length(name) == 0 { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(code, tag)
    wire.putU32(&writing, wire.INVALID)
    wire.putCString(&writing, name)
    return core.simple(context, &writing, tag, kind, callback, userdata)
}

// A device by index or by name (one of them), then `then`'s values: a
// volume, a flag or a port.
pub const VALUE_NONE: u32 = 0
pub const VALUE_VOLUME: u32 = 1
pub const VALUE_BOOL: u32 = 2
pub const VALUE_STRING: u32 = 3

pub fn setOnDevice(context: usize, code: u32, index: u32, name: usize, then: u32, value: usize, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if then == VALUE_VOLUME && (value == 0 || !volume.valid(value)) { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(code, tag)
    wire.putU32(&writing, index)
    wire.putCString(&writing, name)
    putValue(&writing, then, value)
    return core.simple(context, &writing, tag, core.R_CONTEXT_ACK, callback, userdata)
}

fn putValue(writing: *wire.Writer, then: u32, value: usize) -> void {
    if then == VALUE_VOLUME { wire.putCvolume(writing, value) }
    if then == VALUE_BOOL { wire.putBool(writing, value != 0) }
    if then == VALUE_STRING { wire.putCString(writing, value) }
}

// A stream's or client's (by index) value.
pub fn setOnIndex(context: usize, code: u32, index: u32, then: u32, value: usize, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if index == wire.INVALID || (then == VALUE_VOLUME && (value == 0 || !volume.valid(value))) { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(code, tag)
    wire.putU32(&writing, index)
    putValue(&writing, then, value)
    return core.simple(context, &writing, tag, core.R_CONTEXT_ACK, callback, userdata)
}

// Moving a stream to a device by index or name.
pub fn move(context: usize, code: u32, index: u32, target: u32, name: usize, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if index == wire.INVALID || (target == wire.INVALID && name == 0) { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(code, tag)
    wire.putU32(&writing, index)
    wire.putU32(&writing, target)
    wire.putCString(&writing, name)
    return core.simple(context, &writing, tag, core.R_CONTEXT_ACK, callback, userdata)
}

pub fn suspend(context: usize, code: u32, index: u32, name: usize, suspended: bool, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    const tag = core.nextTag(context)
    var writing = wire.command(code, tag)
    wire.putU32(&writing, index)
    if name != 0 {
        wire.putCString(&writing, name)
    } else if index == wire.INVALID {
        wire.putString(&writing, "")
    } else {
        wire.putCString(&writing, 0)
    }
    wire.putBool(&writing, suspended)
    return core.simple(context, &writing, tag, core.R_CONTEXT_ACK, callback, userdata)
}

pub fn loadModule(context: usize, name: usize, argument: usize, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if name == 0 || c.length(name) == 0 { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(LOAD_MODULE, tag)
    wire.putCString(&writing, name)
    wire.putCString(&writing, argument)
    return core.simple(context, &writing, tag, core.R_INDEX, callback, userdata)
}

pub fn portLatencyOffset(context: usize, card: usize, port: usize, offset: i64, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if core.version(context) < 27 { return refuse(context, util.ERR_NOTSUPPORTED) }
    const tag = core.nextTag(context)
    var writing = wire.command(SET_PORT_LATENCY_OFFSET, tag)
    wire.putU32(&writing, wire.INVALID)
    wire.putCString(&writing, card)
    wire.putCString(&writing, port)
    wire.putS64(&writing, offset)
    return core.simple(context, &writing, tag, core.R_CONTEXT_ACK, callback, userdata)
}

pub fn sendMessage(context: usize, path: usize, message: usize, parameters: usize, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if path == 0 || message == 0 { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(SEND_OBJECT_MESSAGE, tag)
    wire.putCString(&writing, path)
    wire.putCString(&writing, message)
    wire.putCString(&writing, parameters)
    return core.simple(context, &writing, tag, core.R_STRING, callback, userdata)
}

pub fn playSample(context: usize, name: usize, device: usize, level: u32, list: usize, withIndex: bool, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if name == 0 || c.length(name) == 0 || (level != volume.INVALID && !volume.isValid(level)) { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(PLAY_SAMPLE, tag)
    wire.putU32(&writing, wire.INVALID)
    wire.putCString(&writing, device)
    wire.putU32(&writing, level)
    wire.putCString(&writing, name)
    if core.version(context) >= 13 { wire.putProplist(&writing, list) }
    return core.simple(context, &writing, tag, if withIndex { core.R_INDEX } else { core.R_CONTEXT_ACK }, callback, userdata)
}

pub fn removeSample(context: usize, name: usize, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if name == 0 { return refuse(context, util.ERR_INVALID) }
    const tag = core.nextTag(context)
    var writing = wire.command(REMOVE_SAMPLE, tag)
    wire.putCString(&writing, name)
    return core.simple(context, &writing, tag, core.R_CONTEXT_ACK, callback, userdata)
}

pub fn serverInfo(context: usize, callback: usize, userdata: usize) -> usize { return request(context, GET_SERVER_INFO, core.R_SERVER_INFO, callback, userdata) }

pub fn stat(context: usize, callback: usize, userdata: usize) -> usize { return request(context, STAT, core.R_STAT, callback, userdata) }

// An extension's request: the module, the subcommand and (when given) a
// u32 or a flag.
pub fn extension(context: usize, module: []const u8, subcommand: u32, kind: u32, argument: u32, hasArgument: bool, callback: usize, userdata: usize) -> usize {
    if !ready(context) { return 0 }
    if core.version(context) < 14 { return refuse(context, util.ERR_NOTSUPPORTED) }
    const tag = core.nextTag(context)
    var writing = wire.command(EXTENSION, tag)
    wire.putU32(&writing, wire.INVALID)
    wire.putString(&writing, module)
    wire.putU32(&writing, subcommand)
    if hasArgument { wire.putBool(&writing, argument != 0) }
    return core.simple(context, &writing, tag, kind, callback, userdata)
}

// ---------------------------------------------------------------------------
// Replies

// pa_server_info and the others' sizes and fields.
const SERVER_INFO: usize = 200
const SINK_INFO: usize = 416
const PORT_INFO: usize = 40
const CLIENT_INFO: usize = 40
const MODULE_INFO: usize = 40
const STREAM_INFO: usize = 376
const CARD_INFO: usize = 96
const PROFILE_INFO: usize = 32
const CARD_PORT_INFO: usize = 80
const SAMPLE_INFO: usize = 328
const STAT_INFO: usize = 20

fn failed(context: usize) -> void { core.failWith(context, util.ERR_PROTOCOL) }

pub fn reply(context: usize, entry: usize, code: u32, reading: *wire.Reader) -> void {
    const kind = c.get32(entry, core.P_KIND)
    const operation = c.getPointer(entry, core.P_OBJECT)
    if c.getPointer(operation, core.O_CONTEXT) == 0 { return }
    const callback = c.getPointer(operation, core.O_CALLBACK)
    const userdata = c.getPointer(operation, core.O_USERDATA)
    var ok = true
    if code != REPLY {
        if core.handleError(context, code, reading) < 0 { return }
        ok = false
    }
    if kind == core.R_CONTEXT_ACK || kind == core.R_EXT_ACK {
        c.call3(callback, context, if ok { 1 } else { 0 }, userdata)
    } else if kind == core.R_INDEX {
        var index = wire.INVALID
        if ok {
            index = wire.readU32(reading)
            if reading.*.failed {
                failed(context)
                return
            }
        }
        c.call3(callback, context, @intCast(usize, index), userdata)
    } else if kind == core.R_STRING {
        var response: usize = 0
        if ok {
            response = wire.readString(reading)
            if reading.*.failed {
                failed(context)
                return
            }
        }
        c.call4(callback, context, if ok { 1 } else { 0 }, response, userdata)
    } else if kind == core.R_EXT_TEST {
        var found = wire.INVALID
        if ok { found = wire.readU32(reading) }
        c.call3(callback, context, @intCast(usize, found), userdata)
    } else if kind == core.R_EXT_LIST {
        c.call4(callback, context, 0, c.int(if ok { 1 } else { -1 }), userdata)
    } else if kind == core.R_SERVER_INFO {
        if !ok {
            c.call3(callback, context, 0, userdata)
        } else {
            const info = c.alloc(SERVER_INFO)
            c.putPointer(info, 24, wire.readString(reading))
            c.putPointer(info, 16, wire.readString(reading))
            c.putPointer(info, 0, wire.readString(reading))
            c.putPointer(info, 8, wire.readString(reading))
            wire.readSampleSpec(reading, info + 32)
            c.putPointer(info, 48, wire.readString(reading))
            c.putPointer(info, 56, wire.readString(reading))
            c.put32(info, 64, wire.readU32(reading))
            if core.version(context) >= 15 {
                wire.readChannelMap(reading, info + 68)
            } else {
                const made = channels.initExtend(info + 68, sample.read(info + 32).channels, channels.DEF_AIFF)
            }
            if reading.*.failed {
                c.release(info)
                failed(context)
                return
            }
            c.call3(callback, context, info, userdata)
            c.release(info)
        }
    } else if kind == core.R_STAT {
        if !ok {
            c.call3(callback, context, 0, userdata)
        } else {
            const info = c.alloc(STAT_INFO)
            var field: usize = 0
            while field < 20 {
                c.put32(info, field, wire.readU32(reading))
                field += 4
            }
            if reading.*.failed {
                c.release(info)
                failed(context)
                return
            }
            c.call3(callback, context, info, userdata)
            c.release(info)
        }
    } else {
        // A list: each entry, then the end (or -1 when it failed).
        if ok {
            while !wire.atEnd(reading) {
                if !entryOf(context, kind, reading, callback, userdata) {
                    failed(context)
                    return
                }
                if c.getPointer(operation, core.O_CONTEXT) == 0 { return }
            }
        }
        c.call4(callback, context, 0, c.int(if ok { 1 } else { -1 }), userdata)
    }
    core.done(operation)
}

// Reads one entry of a list and hands it to the callback; false when the
// reply is not one.
fn entryOf(context: usize, kind: u32, reading: *wire.Reader, callback: usize, userdata: usize) -> bool {
    if kind == core.R_SINK_INFO || kind == core.R_SOURCE_INFO { return deviceInfo(context, kind == core.R_SINK_INFO, reading, callback, userdata) }
    if kind == core.R_CLIENT_INFO {
        const info = c.alloc(CLIENT_INFO)
        const list = proplist.new()
        c.putPointer(info, 32, list)
        c.put32(info, 0, wire.readU32(reading))
        c.putPointer(info, 8, wire.readString(reading))
        c.put32(info, 16, wire.readU32(reading))
        c.putPointer(info, 24, wire.readString(reading))
        if core.version(context) >= 13 { wire.readProplist(reading, list) }
        return deliver(context, reading, info, list, callback, userdata)
    }
    if kind == core.R_MODULE_INFO {
        const info = c.alloc(MODULE_INFO)
        const list = proplist.new()
        c.putPointer(info, 32, list)
        c.put32(info, 0, wire.readU32(reading))
        c.putPointer(info, 8, wire.readString(reading))
        c.putPointer(info, 16, wire.readString(reading))
        c.put32(info, 24, wire.readU32(reading))
        if core.version(context) < 15 {
            c.put32(info, 28, if wire.readBool(reading) { 1 } else { 0 })
        } else {
            wire.readProplist(reading, list)
        }
        return deliver(context, reading, info, list, callback, userdata)
    }
    if kind == core.R_SINK_INPUT_INFO || kind == core.R_SOURCE_OUTPUT_INFO { return streamInfo(context, kind == core.R_SINK_INPUT_INFO, reading, callback, userdata) }
    if kind == core.R_SAMPLE_INFO {
        const info = c.alloc(SAMPLE_INFO)
        const list = proplist.new()
        c.putPointer(info, 320, list)
        c.put32(info, 0, wire.readU32(reading))
        c.putPointer(info, 8, wire.readString(reading))
        wire.readCvolume(reading, info + 16)
        c.put64(info, 296, wire.readUsec(reading))
        wire.readSampleSpec(reading, info + 148)
        wire.readChannelMap(reading, info + 160)
        c.put32(info, 304, wire.readU32(reading))
        c.put32(info, 308, if wire.readBool(reading) { 1 } else { 0 })
        c.putPointer(info, 312, wire.readString(reading))
        if core.version(context) >= 13 { wire.readProplist(reading, list) }
        return deliver(context, reading, info, list, callback, userdata)
    }
    if kind == core.R_CARD_INFO { return cardInfo(context, reading, callback, userdata) }
    return false
}

fn deliver(context: usize, reading: *wire.Reader, info: usize, list: usize, callback: usize, userdata: usize) -> bool {
    if reading.*.failed {
        proplist.free(list)
        c.release(info)
        return false
    }
    c.call4(callback, context, info, 0, userdata)
    proplist.free(list)
    c.release(info)
    return true
}

// pa_sink_info / pa_source_info (the same layout), with their ports and
// formats.
fn deviceInfo(context: usize, sink: bool, reading: *wire.Reader, callback: usize, userdata: usize) -> bool {
    const server_version = core.version(context)
    const info = c.alloc(SINK_INFO)
    const list = proplist.new()
    c.putPointer(info, 344, list)
    c.put32(info, 360, volume.NORM)
    c.put32(info, 368, volume.NORM + 1)
    c.put32(info, 372, wire.INVALID)
    c.put32(info, 364, @bitCast(u32, @intCast(i32, -1)))
    c.put32(info, 8, wire.readU32(reading))
    c.putPointer(info, 0, wire.readString(reading))
    c.putPointer(info, 16, wire.readString(reading))
    wire.readSampleSpec(reading, info + 24)
    wire.readChannelMap(reading, info + 36)
    c.put32(info, 168, wire.readU32(reading))
    wire.readCvolume(reading, info + 172)
    c.put32(info, 304, if wire.readBool(reading) { 1 } else { 0 })
    c.put32(info, 308, wire.readU32(reading))
    c.putPointer(info, 312, wire.readString(reading))
    c.put64(info, 320, wire.readUsec(reading))
    c.putPointer(info, 328, wire.readString(reading))
    c.put32(info, 336, wire.readU32(reading))
    if server_version >= 13 {
        wire.readProplist(reading, list)
        c.put64(info, 352, wire.readUsec(reading))
    }
    if server_version >= 15 {
        c.put32(info, 360, wire.readVolume(reading))
        c.put32(info, 364, wire.readU32(reading))
        c.put32(info, 368, wire.readU32(reading))
        c.put32(info, 372, wire.readU32(reading))
    }
    var ports: usize = 0
    var formats: usize = 0
    var format_count: u32 = 0
    var good = !reading.*.failed
    if good && server_version >= 16 {
        const count = wire.readU32(reading)
        c.put32(info, 376, count)
        if count > 0 && count < 1024 && !reading.*.failed {
            ports = c.alloc((@intCast(usize, count) + 1) * 8 + @intCast(usize, count) * PORT_INFO)
            const first = ports + (@intCast(usize, count) + 1) * 8
            var index: u32 = 0
            while index < count {
                const port = first + @intCast(usize, index) * PORT_INFO
                c.putPointer(ports, @intCast(usize, index) * 8, port)
                c.putPointer(port, 0, wire.readString(reading))
                c.putPointer(port, 8, wire.readString(reading))
                c.put32(port, 16, wire.readU32(reading))
                if server_version >= 24 { c.put32(port, 20, wire.readU32(reading)) }
                if server_version >= 34 {
                    c.putPointer(port, 24, wire.readString(reading))
                    c.put32(port, 32, wire.readU32(reading))
                }
                index += 1
            }
            c.putPointer(info, 384, ports)
        }
        const active = wire.readString(reading)
        if active != 0 && ports != 0 {
            var index: u32 = 0
            while index < count {
                const port = c.getPointer(ports, @intCast(usize, index) * 8)
                if c.same(c.slice(c.getPointer(port, 0)), c.slice(active)) { c.putPointer(info, 392, port) }
                index += 1
            }
        }
        good = !reading.*.failed
    }
    if good && server_version >= (if sink { 21 } else { 22 }) {
        format_count = @intCast(u32, wire.readU8(reading))
        if format_count > 0 && !reading.*.failed {
            formats = c.alloc(@intCast(usize, format_count) * 8)
            var index: u32 = 0
            while index < format_count {
                const one = format.new()
                c.putPointer(formats, @intCast(usize, index) * 8, one)
                wire.readFormat(reading, one)
                index += 1
            }
            c.put32(info, 400, format_count)
            c.putPointer(info, 408, formats)
        }
        good = !reading.*.failed && format_count > 0
    }
    if good { c.call4(callback, context, info, 0, userdata) }
    var index: u32 = 0
    while index < format_count {
        format.free(c.getPointer(formats, @intCast(usize, index) * 8))
        index += 1
    }
    c.release(formats)
    c.release(ports)
    proplist.free(list)
    c.release(info)
    return good
}

// pa_sink_input_info / pa_source_output_info.
fn streamInfo(context: usize, input: bool, reading: *wire.Reader, callback: usize, userdata: usize) -> bool {
    const server_version = core.version(context)
    const info = c.alloc(STREAM_INFO)
    const list = proplist.new()
    const kind = format.new()
    c.putPointer(info, if input { 344 } else { 208 }, list)
    c.putPointer(info, 368, kind)
    c.put32(info, 0, wire.readU32(reading))
    c.putPointer(info, 8, wire.readString(reading))
    c.put32(info, 16, wire.readU32(reading))
    c.put32(info, 20, wire.readU32(reading))
    c.put32(info, 24, wire.readU32(reading))
    wire.readSampleSpec(reading, info + 28)
    wire.readChannelMap(reading, info + 40)
    if input {
        wire.readCvolume(reading, info + 172)
        c.put64(info, 304, wire.readUsec(reading))
        c.put64(info, 312, wire.readUsec(reading))
        c.putPointer(info, 320, wire.readString(reading))
        c.putPointer(info, 328, wire.readString(reading))
        if server_version >= 11 { c.put32(info, 336, if wire.readBool(reading) { 1 } else { 0 }) }
        if server_version >= 13 { wire.readProplist(reading, list) }
        if server_version >= 19 { c.put32(info, 352, if wire.readBool(reading) { 1 } else { 0 }) }
        if server_version >= 20 {
            c.put32(info, 356, if wire.readBool(reading) { 1 } else { 0 })
            c.put32(info, 360, if wire.readBool(reading) { 1 } else { 0 })
        }
        if server_version >= 21 { wire.readFormat(reading, kind) }
    } else {
        c.put64(info, 176, wire.readUsec(reading))
        c.put64(info, 184, wire.readUsec(reading))
        c.putPointer(info, 192, wire.readString(reading))
        c.putPointer(info, 200, wire.readString(reading))
        if server_version >= 13 { wire.readProplist(reading, list) }
        if server_version >= 19 { c.put32(info, 216, if wire.readBool(reading) { 1 } else { 0 }) }
        if server_version >= 22 {
            wire.readCvolume(reading, info + 220)
            c.put32(info, 352, if wire.readBool(reading) { 1 } else { 0 })
            c.put32(info, 356, if wire.readBool(reading) { 1 } else { 0 })
            c.put32(info, 360, if wire.readBool(reading) { 1 } else { 0 })
            wire.readFormat(reading, kind)
        }
    }
    const good = !reading.*.failed
    if good { c.call4(callback, context, info, 0, userdata) }
    format.free(kind)
    proplist.free(list)
    c.release(info)
    return good
}

// pa_card_info: profiles (and their pa_card_profile_info2 copies), the
// active one, ports with the profiles they belong to.
fn cardInfo(context: usize, reading: *wire.Reader, callback: usize, userdata: usize) -> bool {
    const server_version = core.version(context)
    const info = c.alloc(CARD_INFO)
    c.put32(info, 0, wire.readU32(reading))
    c.putPointer(info, 8, wire.readString(reading))
    c.put32(info, 16, wire.readU32(reading))
    c.putPointer(info, 24, wire.readString(reading))
    const count = wire.readU32(reading)
    if reading.*.failed || count > 1024 {
        c.release(info)
        return false
    }
    c.put32(info, 32, count)
    const total = @intCast(usize, count)
    // Profiles (count + 1, the last zeroed), then the profile2 pointers
    // (count + 1) and the profile2 structs.
    const profiles = c.alloc((total + 1) * PROFILE_INFO)
    const pointers = c.alloc((total + 1) * 8 + total * PROFILE_INFO)
    c.putPointer(info, 40, profiles)
    c.putPointer(info, 80, pointers)
    var index: usize = 0
    while index < total {
        const profile = profiles + index * PROFILE_INFO
        c.putPointer(profile, 0, wire.readString(reading))
        c.putPointer(profile, 8, wire.readString(reading))
        c.put32(profile, 16, wire.readU32(reading))
        c.put32(profile, 20, wire.readU32(reading))
        c.put32(profile, 24, wire.readU32(reading))
        const second = pointers + (total + 1) * 8 + index * PROFILE_INFO
        c.copy(second, profile, 28)
        c.put32(second, 28, if server_version >= 29 { wire.readU32(reading) } else { 1 })
        c.putPointer(pointers, index * 8, second)
        index += 1
    }
    const list = proplist.new()
    c.putPointer(info, 56, list)
    const active = wire.readString(reading)
    wire.readProplist(reading, list)
    if active != 0 {
        index = 0
        while index < total {
            if c.same(c.slice(c.getPointer(profiles + index * PROFILE_INFO, 0)), c.slice(active)) {
                c.putPointer(info, 48, profiles + index * PROFILE_INFO)
                c.putPointer(info, 88, c.getPointer(pointers, index * 8))
            }
            index += 1
        }
    }
    var ports: usize = 0
    var port_count: usize = 0
    var lists: usize = 0
    if server_version >= 26 && !reading.*.failed {
        port_count = @intCast(usize, wire.readU32(reading))
        if port_count > 1024 { reading.*.failed = true }
        if port_count > 0 && !reading.*.failed {
            ports = c.alloc((port_count + 1) * 8 + port_count * CARD_PORT_INFO)
            // Per port: its proplist and its two profile lists.
            lists = c.alloc(port_count * 24)
            c.put32(info, 64, @intCast(u32, port_count))
            c.putPointer(info, 72, ports)
            var at: usize = 0
            while at < port_count && !reading.*.failed {
                const port = ports + (port_count + 1) * 8 + at * CARD_PORT_INFO
                c.putPointer(ports, at * 8, port)
                const properties = proplist.new()
                c.putPointer(lists, at * 24, properties)
                c.putPointer(port, 0, wire.readString(reading))
                c.putPointer(port, 8, wire.readString(reading))
                c.put32(port, 16, wire.readU32(reading))
                c.put32(port, 20, wire.readU32(reading))
                c.put32(port, 24, @intCast(u32, wire.readU8(reading)))
                wire.readProplist(reading, properties)
                c.putPointer(port, 40, properties)
                const profile_count = wire.readU32(reading)
                c.put32(port, 28, profile_count)
                if profile_count > 0 && !reading.*.failed {
                    const own = c.alloc((total + 1) * 8)
                    const own2 = c.alloc((total + 1) * 8)
                    c.putPointer(lists, at * 24 + 8, own)
                    c.putPointer(lists, at * 24 + 16, own2)
                    c.putPointer(port, 32, own)
                    c.putPointer(port, 56, own2)
                    var k: u32 = 0
                    while k < profile_count && !reading.*.failed {
                        const name = wire.readString(reading)
                        var found = false
                        index = 0
                        while index < total {
                            if name != 0 && c.same(c.slice(c.getPointer(profiles + index * PROFILE_INFO, 0)), c.slice(name)) && @intCast(usize, k) < total {
                                c.putPointer(own, @intCast(usize, k) * 8, profiles + index * PROFILE_INFO)
                                c.putPointer(own2, @intCast(usize, k) * 8, c.getPointer(pointers, index * 8))
                                found = true
                            }
                            index += 1
                        }
                        if !found { reading.*.failed = true }
                        k += 1
                    }
                }
                if server_version >= 27 { c.put64(port, 48, @bitCast(u64, wire.readS64(reading))) }
                if server_version >= 34 {
                    c.putPointer(port, 64, wire.readString(reading))
                    c.put32(port, 72, wire.readU32(reading))
                }
                at += 1
            }
        }
    }
    const good = !reading.*.failed
    if good { c.call4(callback, context, info, 0, userdata) }
    var at: usize = 0
    while at < port_count {
        proplist.free(c.getPointer(lists, at * 24))
        c.release(c.getPointer(lists, at * 24 + 8))
        c.release(c.getPointer(lists, at * 24 + 16))
        at += 1
    }
    c.release(lists)
    c.release(ports)
    proplist.free(list)
    c.release(pointers)
    c.release(profiles)
    c.release(info)
    return good
}
