// Sample formats and specs (pa_sample_spec: format i32, rate u32,
// channels u8; 12 bytes), sizes and times.
const c = @import("./c.mlx")

pub const U8: u32 = 0
pub const ALAW: u32 = 1
pub const ULAW: u32 = 2
pub const S16LE: u32 = 3
pub const S16BE: u32 = 4
pub const FLOAT32LE: u32 = 5
pub const FLOAT32BE: u32 = 6
pub const S32LE: u32 = 7
pub const S32BE: u32 = 8
pub const S24LE: u32 = 9
pub const S24BE: u32 = 10
pub const S24_32LE: u32 = 11
pub const S24_32BE: u32 = 12
pub const FORMATS: u32 = 13
pub const INVALID: u32 = 4294967295

pub const SPEC: usize = 12
pub const RATE_MAX: u32 = 384000
pub const CHANNELS_MAX: u32 = 32

// A spec as values.
pub const Spec = struct {
    format: u32
    rate: u32
    channels: u32
}

pub fn read(address: usize) -> Spec {
    return Spec.{ .format = c.get32(address, 0), .rate = c.get32(address, 4), .channels = @intCast(u32, c.get8(address, 8)) }
}

pub fn write(address: usize, spec: Spec) -> void {
    c.put32(address, 0, spec.format)
    c.put32(address, 4, spec.rate)
    c.put8(address, 8, @intCast(u8, spec.channels & 255))
}

pub fn sizeOfFormat(format: u32) -> usize {
    if format == U8 || format == ALAW || format == ULAW { return 1 }
    if format == S16LE || format == S16BE { return 2 }
    if format == S24LE || format == S24BE { return 3 }
    if format < FORMATS { return 4 }
    return 0
}

pub fn formatValid(format: u32) -> bool { return format < FORMATS }

pub fn rateValid(rate: u32) -> bool { return rate > 0 && rate <= RATE_MAX * 101 / 100 }

pub fn channelsValid(channels: u32) -> bool { return channels > 0 && channels <= CHANNELS_MAX }

pub fn valid(spec: Spec) -> bool { return rateValid(spec.rate) && channelsValid(spec.channels) && formatValid(spec.format) }

pub fn frameSize(spec: Spec) -> usize { return sizeOfFormat(spec.format) * @intCast(usize, spec.channels) }

pub fn bytesPerSecond(spec: Spec) -> usize { return @intCast(usize, spec.rate) * frameSize(spec) }

pub fn bytesToUsec(bytes: u64, spec: Spec) -> u64 {
    const frame = @intCast(u64, frameSize(spec))
    if frame == 0 || spec.rate == 0 { return 0 }
    return bytes / frame * 1000000 / @intCast(u64, spec.rate)
}

pub fn usecToBytes(usec: u64, spec: Spec) -> usize {
    return @intCast(usize, usec * @intCast(u64, spec.rate) / 1000000) * frameSize(spec)
}

pub fn equal(first: Spec, second: Spec) -> bool { return first.format == second.format && first.rate == second.rate && first.channels == second.channels }

// The format's name (a C string that lives as long as the library), 0
// for an invalid one.
pub fn formatName(format: u32) -> usize {
    if format == U8 { return c.literal("u8") }
    if format == ALAW { return c.literal("aLaw") }
    if format == ULAW { return c.literal("uLaw") }
    if format == S16LE { return c.literal("s16le") }
    if format == S16BE { return c.literal("s16be") }
    if format == FLOAT32LE { return c.literal("float32le") }
    if format == FLOAT32BE { return c.literal("float32be") }
    if format == S32LE { return c.literal("s32le") }
    if format == S32BE { return c.literal("s32be") }
    if format == S24LE { return c.literal("s24le") }
    if format == S24BE { return c.literal("s24be") }
    if format == S24_32LE { return c.literal("s24-32le") }
    if format == S24_32BE { return c.literal("s24-32be") }
    return 0
}

fn lower(value: u8) -> u8 { return if value >= 65 && value <= 90 { value + 32 } else { value } }

// Whether `text` is `name`, ignoring case.
pub fn named(text: []const u8, name: []const u8) -> bool {
    if text.length != name.length { return false }
    var index: usize = 0
    while index < text.length {
        if lower(text[index]) != lower(name[index]) { return false }
        index += 1
    }
    return true
}

// pa_parse_sample_format's names (ne: native, little-endian here; re:
// the other).
pub fn parseFormat(text: []const u8) -> u32 {
    if named(text, "s16le") || named(text, "s16ne") || named(text, "s16") || named(text, "16") { return S16LE }
    if named(text, "s16be") || named(text, "s16re") { return S16BE }
    if named(text, "u8") || named(text, "8") { return U8 }
    if named(text, "float32") || named(text, "float32ne") || named(text, "float") || named(text, "float32le") { return FLOAT32LE }
    if named(text, "float32re") || named(text, "float32be") { return FLOAT32BE }
    if named(text, "ulaw") || named(text, "mulaw") { return ULAW }
    if named(text, "alaw") { return ALAW }
    if named(text, "s32le") || named(text, "s32ne") || named(text, "s32") || named(text, "32") { return S32LE }
    if named(text, "s32be") { return S32BE }
    if named(text, "s32re") { return S24BE }
    if named(text, "s24le") || named(text, "s24ne") || named(text, "s24") || named(text, "24") { return S24LE }
    if named(text, "s24be") || named(text, "s24re") { return S24BE }
    if named(text, "s24-32le") || named(text, "s24-32ne") || named(text, "s24-32") { return S24_32LE }
    if named(text, "s24-32be") || named(text, "s24-32re") { return S24_32BE }
    return INVALID
}

// 1 little-endian, 0 big-endian, -1 neither (8 bits, laws).
pub fn littleEndian(format: u32) -> i32 {
    if format == S16LE || format == S24LE || format == S32LE || format == S24_32LE || format == FLOAT32LE { return 1 }
    if format == S16BE || format == S24BE || format == S32BE || format == S24_32BE || format == FLOAT32BE { return 0 }
    return -1
}

// "s16le 2ch 44100Hz"
pub fn print(buffer: usize, capacity: usize, spec: Spec) -> usize {
    var writing = c.out(buffer, capacity)
    if !valid(spec) {
        c.append(&writing, "(invalid)")
        return c.result(&writing)
    }
    c.append(&writing, c.slice(formatName(spec.format)))
    c.append(&writing, " ")
    c.appendNumber(&writing, @intCast(u64, spec.channels))
    c.append(&writing, "ch ")
    c.appendNumber(&writing, @intCast(u64, spec.rate))
    c.append(&writing, "Hz")
    return c.result(&writing)
}

// "1.5 MiB"
pub fn printBytes(buffer: usize, capacity: usize, value: u32) -> usize {
    var writing = c.out(buffer, capacity)
    const amount: f64 = @floatFromInt(f64, @intCast(i64, value))
    if value >= 1073741824 {
        c.appendFixed(&writing, amount / 1073741824.0, 1)
        c.append(&writing, " GiB")
    } else if value >= 1048576 {
        c.appendFixed(&writing, amount / 1048576.0, 1)
        c.append(&writing, " MiB")
    } else if value >= 1024 {
        c.appendFixed(&writing, amount / 1024.0, 1)
        c.append(&writing, " KiB")
    } else {
        c.appendNumber(&writing, @intCast(u64, value))
        c.append(&writing, " B")
    }
    return c.result(&writing)
}
