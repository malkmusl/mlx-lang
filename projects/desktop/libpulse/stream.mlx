// pa_stream: playback, recording and sample upload streams on a context.
// Playback: the server asks for bytes (REQUEST), the program writes them
// (each write a data packet on the stream's channel); recording: the
// server's data packets queue up until the program peeks and drops them.
// Timing: the server's latency replies (sink and source latency, its read
// and write indexes, when it measured) give the stream's time; between
// replies it runs on with the clock (INTERPOLATE_TIMING) from the last
// one, and stands while the stream does not play.
const c = @import("./c.mlx")
const core = @import("./core.mlx")
const wire = @import("./wire.mlx")
const util = @import("./util.mlx")
const sample = @import("./sample.mlx")
const channels = @import("./channels.mlx")
const volume = @import("./volume.mlx")
const proplist = @import("./proplist.mlx")
const format = @import("./format.mlx")
const mainloop = @import("./mainloop.mlx")

// pa_stream_flags_t.
const START_CORKED: u32 = 1
const INTERPOLATE_TIMING: u32 = 2
const NOT_MONOTONIC: u32 = 4
const AUTO_TIMING_UPDATE: u32 = 8
const NO_REMAP_CHANNELS: u32 = 16
const NO_REMIX_CHANNELS: u32 = 32
const FIX_FORMAT: u32 = 64
const FIX_RATE: u32 = 128
const FIX_CHANNELS: u32 = 256
const DONT_MOVE: u32 = 512
const VARIABLE_RATE: u32 = 1024
const PEAK_DETECT: u32 = 2048
const START_MUTED: u32 = 4096
const ADJUST_LATENCY: u32 = 8192
const EARLY_REQUESTS: u32 = 16384
const DONT_INHIBIT_AUTO_SUSPEND: u32 = 32768
const START_UNMUTED: u32 = 65536
const FAIL_ON_SUSPEND: u32 = 131072
const RELATIVE_VOLUME: u32 = 262144
const PASSTHROUGH: u32 = 524288
const ALL_FLAGS: u32 = 1048575

// pa_seek_mode_t.
const SEEK_RELATIVE: u32 = 0
const SEEK_ABSOLUTE: u32 = 1
const SEEK_RELATIVE_END: u32 = 3

// Commands.
const REPLY: u32 = 2
const CREATE_PLAYBACK_STREAM: u32 = 3
const DELETE_PLAYBACK_STREAM: u32 = 4
const CREATE_RECORD_STREAM: u32 = 5
const DELETE_RECORD_STREAM: u32 = 6
const DRAIN_PLAYBACK_STREAM: u32 = 12
const GET_PLAYBACK_LATENCY: u32 = 14
const CREATE_UPLOAD_STREAM: u32 = 15
const DELETE_UPLOAD_STREAM: u32 = 16
const FINISH_UPLOAD_STREAM: u32 = 17
const CORK_PLAYBACK_STREAM: u32 = 41
const FLUSH_PLAYBACK_STREAM: u32 = 42
const TRIGGER_PLAYBACK_STREAM: u32 = 43
const GET_RECORD_LATENCY: u32 = 57
const CORK_RECORD_STREAM: u32 = 58
const FLUSH_RECORD_STREAM: u32 = 59
const PREBUF_PLAYBACK_STREAM: u32 = 60
const REQUEST: u32 = 61
const OVERFLOW: u32 = 62
const UNDERFLOW: u32 = 63
const PLAYBACK_STREAM_KILLED: u32 = 64
const RECORD_STREAM_KILLED: u32 = 65
const SET_PLAYBACK_STREAM_BUFFER_ATTR: u32 = 72
const SET_RECORD_STREAM_BUFFER_ATTR: u32 = 73
const UPDATE_PLAYBACK_STREAM_SAMPLE_RATE: u32 = 74
const UPDATE_RECORD_STREAM_SAMPLE_RATE: u32 = 75
const PLAYBACK_STREAM_SUSPENDED: u32 = 76
const RECORD_STREAM_SUSPENDED: u32 = 77
const PLAYBACK_STREAM_MOVED: u32 = 78
const RECORD_STREAM_MOVED: u32 = 79
const UPDATE_RECORD_STREAM_PROPLIST: u32 = 80
const UPDATE_PLAYBACK_STREAM_PROPLIST: u32 = 81
const REMOVE_RECORD_STREAM_PROPLIST: u32 = 83
const REMOVE_PLAYBACK_STREAM_PROPLIST: u32 = 84
const STARTED: u32 = 86
const PLAYBACK_STREAM_EVENT: u32 = 92
const RECORD_STREAM_EVENT: u32 = 93
const PLAYBACK_BUFFER_ATTR_CHANGED: u32 = 94
const RECORD_BUFFER_ATTR_CHANGED: u32 = 95

// The most bytes in one data packet.
const BLOCK: usize = 65472
const CORRECTIONS: u32 = 10
const CORRECTION: usize = 32
const AUTO_START: u64 = 10000
const AUTO_END: u64 = 1500000

// pa_timing_info within the stream.
const T_TIMESTAMP: usize = 0
const T_SYNCHRONIZED: usize = 16
const T_SINK_USEC: usize = 24
const T_SOURCE_USEC: usize = 32
const T_TRANSPORT_USEC: usize = 40
const T_PLAYING: usize = 48
const T_WRITE_CORRUPT: usize = 52
const T_WRITE_INDEX: usize = 56
const T_READ_CORRUPT: usize = 64
const T_READ_INDEX: usize = 72
const T_CONFIGURED_SINK: usize = 80
const T_CONFIGURED_SOURCE: usize = 88
const T_SINCE_UNDERRUN: usize = 96

fn timing(stream: usize) -> usize { return stream + core.S_TIMING }

fn spec(stream: usize) -> sample.Spec { return sample.read(stream + core.S_SPEC) }

fn direction(stream: usize) -> u32 { return c.get32(stream, core.S_DIRECTION) }

fn flags(stream: usize) -> u32 { return c.get32(stream, core.S_FLAGS) }

fn attr(stream: usize, field: usize) -> u32 { return c.get32(stream, core.S_ATTR + field) }

fn setAttr(stream: usize, field: usize, value: u32) -> void { c.put32(stream, core.S_ATTR + field, value) }

const MAXLENGTH: usize = 0
const TLENGTH: usize = 4
const PREBUF: usize = 8
const MINREQ: usize = 12
const FRAGSIZE: usize = 16

fn context(stream: usize) -> usize { return c.getPointer(stream, core.S_CONTEXT) }

fn requested(stream: usize) -> i64 { return @bitCast(i64, c.get64(stream, core.S_REQUESTED)) }

fn setRequested(stream: usize, value: i64) -> void { c.put64(stream, core.S_REQUESTED, @bitCast(u64, value)) }

// Fails with `code` (the stream's context's error); false.
fn refuse(stream: usize, code: i32) -> bool {
    const failed = core.fail(context(stream), code)
    return false
}

// The stream may be used: attached, READY, and (when `kinds` says) of a
// direction allowed.
fn usable(stream: usize) -> bool {
    if context(stream) == 0 || core.streamState(stream) != core.S_READY { return refuse(stream, util.ERR_BADSTATE) }
    return true
}

// The error the last refusal set.
fn lastError(stream: usize) -> i32 {
    const owner = context(stream)
    return if owner == 0 { util.ERR_BADSTATE } else { @bitCast(i32, c.get32(owner, core.C_ERROR)) }
}

fn notify(stream: usize, callback: usize) -> void { c.call2(c.getPointer(stream, callback), stream, c.getPointer(stream, callback + 8)) }

// ---------------------------------------------------------------------------
// Creating

pub fn new(owner: usize, name: usize, given: usize, map: usize, formats: usize, count: u32, properties: usize) -> usize {
    if count == 0 {
        if given == 0 || !sample.valid(sample.read(given)) {
            const failed = core.fail(owner, util.ERR_INVALID)
            return 0
        }
        if map != 0 && (!channels.valid(map) || channels.channels(map) != sample.read(given).channels) {
            const failed = core.fail(owner, util.ERR_INVALID)
            return 0
        }
    }
    if name == 0 && (properties == 0 || !proplist.contains(properties, "media.name")) {
        const failed = core.fail(owner, util.ERR_INVALID)
        return 0
    }
    const stream = c.alloc(core.STREAM)
    if stream == 0 { return 0 }
    // One reference for the program, one the context holds.
    c.put32(stream, core.S_REFS, 2)
    c.putPointer(stream, core.S_CONTEXT, owner)
    if given != 0 {
        sample.write(stream + core.S_SPEC, sample.read(given))
    } else {
        sample.write(stream + core.S_SPEC, sample.Spec.{ .format = sample.INVALID, .rate = 0, .channels = 0 })
    }
    if map != 0 {
        c.copy(stream + core.S_MAP, map, channels.MAP)
    } else if given != 0 {
        const made = channels.initAuto(stream + core.S_MAP, sample.read(given).channels, channels.DEF_AIFF)
    } else {
        channels.init(stream + core.S_MAP)
    }
    if count > 0 {
        const list = c.alloc(@intCast(usize, count) * 8)
        var index: u32 = 0
        while index < count {
            c.putPointer(list, @intCast(usize, index) * 8, format.copy(c.getPointer(formats, @intCast(usize, index) * 8)))
            index += 1
        }
        c.putPointer(stream, core.S_FORMATS, list)
        c.put32(stream, core.S_FORMAT_COUNT, count)
    }
    const list = if properties != 0 { proplist.copy(properties) } else { proplist.new() }
    if name != 0 { const set = proplist.setString(list, "media.name", c.slice(name)) }
    c.putPointer(stream, core.S_PROPLIST, list)
    c.put32(stream, core.S_SYNCID, c.get32(owner, core.C_SYNCID))
    c.put32(owner, core.C_SYNCID, c.get32(owner, core.C_SYNCID) + 1)
    c.put32(stream, core.S_DIRECT_ON_INPUT, wire.INVALID)
    c.put32(stream, core.S_DEVICE_INDEX, wire.INVALID)
    c.put32(stream, core.S_CHANNEL, 0)
    var field: usize = 0
    while field < 20 {
        c.put32(stream, core.S_ATTR + field, wire.INVALID)
        field += 4
    }
    c.put64(stream, core.S_UNDERFLOW_INDEX, @bitCast(u64, @intCast(i64, -1)))
    c.put32(timing(stream), T_WRITE_CORRUPT, 1)
    c.put32(timing(stream), T_READ_CORRUPT, 1)
    c.putPointer(stream, core.S_NEXT, c.getPointer(owner, core.C_STREAMS))
    c.putPointer(owner, core.C_STREAMS, stream)
    return stream
}

// $PULSE_LATENCY_MSEC sets the buffers for every stream.
fn patchAttributes(stream: usize) -> bool {
    const latency = c.environment("PULSE_LATENCY_MSEC")
    if latency.length == 0 { return false }
    var ok = false
    const milliseconds = c.parseNumber(latency, &ok)
    if !ok || milliseconds == 0 || !sample.valid(spec(stream)) { return false }
    const length = @intCast(u32, sample.usecToBytes(milliseconds * 1000, spec(stream)))
    setAttr(stream, MAXLENGTH, wire.INVALID)
    setAttr(stream, TLENGTH, length)
    setAttr(stream, MINREQ, wire.INVALID)
    setAttr(stream, PREBUF, wire.INVALID)
    setAttr(stream, FRAGSIZE, length)
    return true
}

fn flag(writing: *wire.Writer, value: u32, mask: u32) -> void { wire.putBool(writing, value & mask != 0) }

pub fn connect(stream: usize, kind: u32, device: usize, attributes: usize, given_flags: u32, levels: usize, sync: usize) -> i32 {
    const owner = context(stream)
    if owner == 0 || core.streamState(stream) != core.S_UNCONNECTED { return core.fail(owner, util.ERR_BADSTATE) }
    if core.state(owner) != core.READY { return core.fail(owner, util.ERR_BADSTATE) }
    if given_flags & ~ALL_FLAGS != 0 { return core.fail(owner, util.ERR_INVALID) }
    if levels != 0 && (!volume.valid(levels) || (sample.valid(spec(stream)) && volume.count(levels) != spec(stream).channels)) { return core.fail(owner, util.ERR_INVALID) }
    core.streamRef(stream)
    c.put32(stream, core.S_DIRECTION, kind)
    if sync != 0 { c.put32(stream, core.S_SYNCID, c.get32(sync, core.S_SYNCID)) }
    if attributes != 0 { c.copy(stream + core.S_ATTR, attributes, 20) }
    var chosen = given_flags
    if patchAttributes(stream) { chosen = chosen | ADJUST_LATENCY }
    c.put32(stream, core.S_FLAGS, chosen)
    c.put32(stream, core.S_CORKED, if chosen & START_CORKED != 0 { 1 } else { 0 })
    // A format list without a spec: the first PCM format that gives one
    // (servers that do not negotiate formats want a spec).
    var sendFormats = c.get32(stream, core.S_FORMAT_COUNT)
    if !sample.valid(spec(stream)) {
        var index: u32 = 0
        while index < c.get32(stream, core.S_FORMAT_COUNT) {
            const info = c.getPointer(c.getPointer(stream, core.S_FORMATS), @intCast(usize, index) * 8)
            if format.isPcm(info) && format.toSampleSpec(info, stream + core.S_SPEC, stream + core.S_MAP) == 0 {
                if !channels.valid(stream + core.S_MAP) || channels.channels(stream + core.S_MAP) != spec(stream).channels { const made = channels.initAuto(stream + core.S_MAP, spec(stream).channels, channels.DEF_AIFF) }
                sendFormats = 0
                break
            }
            index += 1
        }
    }
    const server_version = core.version(owner)
    const playback = kind == core.PLAYBACK
    const tag = core.nextTag(owner)
    var writing = wire.command(if playback { CREATE_PLAYBACK_STREAM } else { CREATE_RECORD_STREAM }, tag)
    const list = c.getPointer(stream, core.S_PROPLIST)
    if server_version < 13 { wire.putCString(&writing, proplist.getString(list, "media.name")) }
    wire.putSampleSpec(&writing, spec(stream))
    wire.putChannelMap(&writing, stream + core.S_MAP)
    wire.putU32(&writing, wire.INVALID)
    wire.putCString(&writing, device)
    wire.putU32(&writing, attr(stream, MAXLENGTH))
    wire.putBool(&writing, chosen & START_CORKED != 0)
    var reset: [132]u8 = undefined
    var levelsSent = levels
    if levels == 0 {
        levelsSent = @intFromPtr(&reset)
        volume.set(levelsSent, if sample.valid(spec(stream)) { spec(stream).channels } else { 32 }, volume.NORM)
    }
    if playback {
        wire.putU32(&writing, attr(stream, TLENGTH))
        wire.putU32(&writing, attr(stream, PREBUF))
        wire.putU32(&writing, attr(stream, MINREQ))
        wire.putU32(&writing, c.get32(stream, core.S_SYNCID))
        wire.putCvolume(&writing, levelsSent)
    } else {
        wire.putU32(&writing, attr(stream, FRAGSIZE))
    }
    if server_version >= 12 {
        flag(&writing, chosen, NO_REMAP_CHANNELS)
        flag(&writing, chosen, NO_REMIX_CHANNELS)
        flag(&writing, chosen, FIX_FORMAT)
        flag(&writing, chosen, FIX_RATE)
        flag(&writing, chosen, FIX_CHANNELS)
        flag(&writing, chosen, DONT_MOVE)
        flag(&writing, chosen, VARIABLE_RATE)
    }
    if server_version >= 13 {
        flag(&writing, chosen, if playback { START_MUTED } else { PEAK_DETECT })
        flag(&writing, chosen, ADJUST_LATENCY)
        wire.putProplist(&writing, list)
        if !playback { wire.putU32(&writing, c.get32(stream, core.S_DIRECT_ON_INPUT)) }
    }
    if server_version >= 14 {
        if playback { wire.putBool(&writing, levels != 0) }
        flag(&writing, chosen, EARLY_REQUESTS)
    }
    if server_version >= 15 {
        if playback { flag(&writing, chosen, START_MUTED | START_UNMUTED) }
        flag(&writing, chosen, DONT_INHIBIT_AUTO_SUSPEND)
        flag(&writing, chosen, FAIL_ON_SUSPEND)
    }
    if server_version >= 17 && playback { flag(&writing, chosen, RELATIVE_VOLUME) }
    if server_version >= 18 && playback { flag(&writing, chosen, PASSTHROUGH) }
    if (server_version >= 21 && playback) || server_version >= 22 {
        wire.putU8(&writing, @intCast(u8, sendFormats & 255))
        var index: u32 = 0
        while index < sendFormats {
            wire.putFormat(&writing, c.getPointer(c.getPointer(stream, core.S_FORMATS), @intCast(usize, index) * 8))
            index += 1
        }
    }
    if server_version >= 22 && !playback {
        wire.putCvolume(&writing, levelsSent)
        flag(&writing, chosen, START_MUTED)
        wire.putBool(&writing, levels != 0)
        flag(&writing, chosen, START_MUTED | START_UNMUTED)
        flag(&writing, chosen, RELATIVE_VOLUME)
        flag(&writing, chosen, PASSTHROUGH)
    }
    core.send(owner, &writing)
    core.expectReply(owner, tag, core.R_STREAM_CREATE, stream, 0)
    core.setStreamState(stream, core.S_CREATING)
    core.streamUnref(stream)
    return 0
}

pub fn connectUpload(stream: usize, length: usize) -> i32 {
    const owner = context(stream)
    if owner == 0 || core.streamState(stream) != core.S_UNCONNECTED || core.state(owner) != core.READY { return core.fail(owner, util.ERR_BADSTATE) }
    if length == 0 { return core.fail(owner, util.ERR_INVALID) }
    core.streamRef(stream)
    c.put32(stream, core.S_DIRECTION, core.UPLOAD)
    c.put32(stream, core.S_UPLOAD_LENGTH, @intCast(u32, length))
    const tag = core.nextTag(owner)
    var writing = wire.command(CREATE_UPLOAD_STREAM, tag)
    const list = c.getPointer(stream, core.S_PROPLIST)
    wire.putCString(&writing, proplist.getString(list, "media.name"))
    wire.putSampleSpec(&writing, spec(stream))
    wire.putChannelMap(&writing, stream + core.S_MAP)
    wire.putU32(&writing, @intCast(u32, length))
    if core.version(owner) >= 13 { wire.putProplist(&writing, list) }
    core.send(owner, &writing)
    core.expectReply(owner, tag, core.R_UPLOAD_CREATE, stream, 0)
    core.setStreamState(stream, core.S_CREATING)
    core.streamUnref(stream)
    return 0
}

fn deleteCommand(stream: usize, code: u32) -> i32 {
    const owner = context(stream)
    if owner == 0 || c.get32(stream, core.S_CHANNEL_VALID) == 0 || core.state(owner) != core.READY { return core.fail(owner, util.ERR_BADSTATE) }
    core.streamRef(stream)
    const tag = core.nextTag(owner)
    var writing = wire.command(code, tag)
    wire.putU32(&writing, c.get32(stream, core.S_CHANNEL))
    core.send(owner, &writing)
    core.expectReply(owner, tag, core.R_STREAM_DISCONNECT, stream, 0)
    core.streamUnref(stream)
    return 0
}

pub fn finishUpload(stream: usize) -> i32 {
    if c.get32(stream, core.S_DIRECTION) != core.UPLOAD { return core.fail(context(stream), util.ERR_BADSTATE) }
    return deleteCommand(stream, FINISH_UPLOAD_STREAM)
}

pub fn disconnect(stream: usize) -> i32 {
    const kind = direction(stream)
    return deleteCommand(stream, if kind == core.PLAYBACK { DELETE_PLAYBACK_STREAM } else { if kind == core.RECORD { DELETE_RECORD_STREAM } else { DELETE_UPLOAD_STREAM } })
}

fn complete(stream: usize) -> void {
    core.setStreamState(stream, core.S_READY)
    if context(stream) == 0 { return }
    if requested(stream) > 0 { c.call3(c.getPointer(stream, core.S_WRITE_CALLBACK), stream, @intCast(usize, requested(stream)), c.getPointer(stream, core.S_WRITE_CALLBACK + 8)) }
    if flags(stream) & AUTO_TIMING_UPDATE != 0 && context(stream) != 0 {
        c.put64(stream, core.S_AUTO_INTERVAL, AUTO_START)
        c.putPointer(stream, core.S_AUTO_EVENT, core.timeNew(context(stream), c.monotonic() + AUTO_START, @intFromPtr(mlx_pulse_stream_auto_timing), stream))
        requestTiming(stream, true)
    }
}

fn created(owner: usize, stream: usize, reading: *wire.Reader) -> void {
    const server_version = core.version(owner)
    const kind = direction(stream)
    c.put32(stream, core.S_CHANNEL, wire.readU32(reading))
    if kind != core.UPLOAD { c.put32(stream, core.S_INDEX, wire.readU32(reading)) }
    var bytes: u32 = 0
    if kind != core.RECORD { bytes = wire.readU32(reading) }
    setRequested(stream, @intCast(i64, bytes))
    if reading.*.failed || c.get32(stream, core.S_CHANNEL) == wire.INVALID {
        core.failWith(owner, util.ERR_PROTOCOL)
        return
    }
    if server_version >= 9 && kind == core.PLAYBACK {
        setAttr(stream, MAXLENGTH, wire.readU32(reading))
        setAttr(stream, TLENGTH, wire.readU32(reading))
        setAttr(stream, PREBUF, wire.readU32(reading))
        setAttr(stream, MINREQ, wire.readU32(reading))
    } else if server_version >= 9 && kind == core.RECORD {
        setAttr(stream, MAXLENGTH, wire.readU32(reading))
        setAttr(stream, FRAGSIZE, wire.readU32(reading))
    }
    if server_version >= 12 && kind != core.UPLOAD {
        var given: [12]u8 = undefined
        var map: [132]u8 = undefined
        wire.readSampleSpec(reading, @intFromPtr(&given))
        wire.readChannelMap(reading, @intFromPtr(&map))
        c.put32(stream, core.S_DEVICE_INDEX, wire.readU32(reading))
        const device = wire.readString(reading)
        const suspended = wire.readBool(reading)
        const got = sample.read(@intFromPtr(&given))
        if reading.*.failed || device == 0 || c.get32(stream, core.S_DEVICE_INDEX) == wire.INVALID || got.channels != channels.channels(@intFromPtr(&map)) || !channels.valid(@intFromPtr(&map)) || !sample.valid(got) {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        if c.get32(stream, core.S_FORMAT_COUNT) == 0 {
            const wanted = spec(stream)
            if (flags(stream) & FIX_FORMAT == 0 && got.format != wanted.format) || (flags(stream) & FIX_RATE == 0 && got.rate != wanted.rate) || (flags(stream) & FIX_CHANNELS == 0 && !channels.equal(@intFromPtr(&map), stream + core.S_MAP)) {
                core.failWith(owner, util.ERR_PROTOCOL)
                return
            }
        }
        c.release(c.getPointer(stream, core.S_DEVICE_NAME))
        c.putPointer(stream, core.S_DEVICE_NAME, c.duplicateC(device))
        c.put32(stream, core.S_SUSPENDED, if suspended { 1 } else { 0 })
        c.copy(stream + core.S_MAP, @intFromPtr(&map), channels.MAP)
        sample.write(stream + core.S_SPEC, got)
    }
    if server_version >= 13 && kind != core.UPLOAD {
        const configured = wire.readUsec(reading)
        if reading.*.failed {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        c.put64(timing(stream), if kind == core.RECORD { T_CONFIGURED_SOURCE } else { T_CONFIGURED_SINK }, configured)
    }
    if (server_version >= 21 && kind == core.PLAYBACK) || (server_version >= 22 && kind != core.UPLOAD) {
        const info = format.new()
        wire.readFormat(reading, info)
        if reading.*.failed || !format.valid(info) {
            format.free(info)
            reading.*.failed = false
        } else {
            c.putPointer(stream, core.S_FORMAT, info)
        }
    }
    c.put32(stream, core.S_CHANNEL_VALID, 1)
    complete(stream)
}

// ---------------------------------------------------------------------------
// Playback

pub fn write(stream: usize, data: usize, length: usize, free_callback: usize, free_data: usize, offset: i64, seek: u32) -> i32 {
    if !usable(stream) { return 0 - util.ERR_BADSTATE }
    const kind = direction(stream)
    const owner = context(stream)
    if kind != core.PLAYBACK && kind != core.UPLOAD { return core.fail(owner, util.ERR_BADSTATE) }
    if seek > SEEK_RELATIVE_END || (kind != core.PLAYBACK && (seek != SEEK_RELATIVE || offset != 0)) { return core.fail(owner, util.ERR_INVALID) }
    const frame = sample.frameSize(spec(stream))
    const buffer = c.getPointer(stream, core.S_WRITE_BUFFER)
    if buffer != 0 && (data < buffer || data + length > buffer + c.getPointer(stream, core.S_WRITE_SIZE)) { return core.fail(owner, util.ERR_INVALID) }
    if frame > 0 && (length % frame != 0 || @bitCast(u64, offset) % @intCast(u64, frame) != 0) { return core.fail(owner, util.ERR_INVALID) }
    if free_callback != 0 && buffer != 0 { return core.fail(owner, util.ERR_INVALID) }
    var block = BLOCK
    if frame > 0 { block = BLOCK / frame * frame }
    var sent: usize = 0
    var chunk_offset = offset
    var chunk_seek = seek
    while sent < length {
        const count = if length - sent > block { block } else { length - sent }
        core.sendData(owner, c.get32(stream, core.S_CHANNEL), data + sent, count, chunk_offset, chunk_seek)
        sent += count
        chunk_offset = 0
        chunk_seek = SEEK_RELATIVE
    }
    if buffer != 0 {
        c.release(buffer)
        c.putPointer(stream, core.S_WRITE_BUFFER, 0)
        c.putPointer(stream, core.S_WRITE_SIZE, 0)
    } else if free_callback != 0 {
        c.call1(free_callback, free_data)
    }
    const moved = (if seek == SEEK_RELATIVE { offset } else { 0 }) + @intCast(i64, length)
    setRequested(stream, requested(stream) - moved)
    if kind == core.PLAYBACK {
        const slot = correction(stream, c.get32(stream, core.S_CORRECTION))
        if c.get32(slot, 0) != 0 {
            if seek == SEEK_ABSOLUTE {
                c.put32(slot, 8, 0)
                c.put32(slot, 4, 1)
                c.put64(slot, 16, @bitCast(u64, offset + @intCast(i64, length)))
            } else if seek == SEEK_RELATIVE {
                if c.get32(slot, 8) == 0 { c.put64(slot, 16, @bitCast(u64, @bitCast(i64, c.get64(slot, 16)) + offset + @intCast(i64, length))) }
            } else {
                c.put32(slot, 8, 1)
            }
        }
        const info = timing(stream)
        if c.get32(stream, core.S_TIMING_VALID) != 0 {
            if seek == SEEK_ABSOLUTE {
                c.put32(info, T_WRITE_CORRUPT, 0)
                c.put64(info, T_WRITE_INDEX, @bitCast(u64, offset + @intCast(i64, length)))
            } else if seek == SEEK_RELATIVE {
                if c.get32(info, T_WRITE_CORRUPT) == 0 { c.put64(info, T_WRITE_INDEX, @bitCast(u64, @bitCast(i64, c.get64(info, T_WRITE_INDEX)) + offset + @intCast(i64, length))) }
            } else {
                c.put32(info, T_WRITE_CORRUPT, 1)
            }
        }
        if c.get32(stream, core.S_TIMING_VALID) == 0 || c.get32(info, T_WRITE_CORRUPT) != 0 { requestTiming(stream, true) }
    }
    return 0
}

pub fn beginWrite(stream: usize, data: usize, size: usize) -> i32 {
    if !usable(stream) { return 0 - util.ERR_BADSTATE }
    if direction(stream) != core.PLAYBACK && direction(stream) != core.UPLOAD { return core.fail(context(stream), util.ERR_BADSTATE) }
    const frame = sample.frameSize(spec(stream))
    var wanted = c.getPointer(size, 0)
    const most = if frame > 0 { BLOCK / frame * frame } else { BLOCK }
    if wanted == 18446744073709551615 || wanted > most { wanted = most }
    if wanted == 0 { wanted = if frame > 0 { frame } else { 1 } }
    if c.getPointer(stream, core.S_WRITE_BUFFER) == 0 {
        c.putPointer(stream, core.S_WRITE_BUFFER, c.alloc(wanted))
        c.putPointer(stream, core.S_WRITE_SIZE, wanted)
    }
    c.putPointer(data, 0, c.getPointer(stream, core.S_WRITE_BUFFER))
    c.putPointer(size, 0, c.getPointer(stream, core.S_WRITE_SIZE))
    return 0
}

pub fn cancelWrite(stream: usize) -> i32 {
    if !usable(stream) { return 0 - util.ERR_BADSTATE }
    if c.getPointer(stream, core.S_WRITE_BUFFER) == 0 { return core.fail(context(stream), util.ERR_BADSTATE) }
    c.release(c.getPointer(stream, core.S_WRITE_BUFFER))
    c.putPointer(stream, core.S_WRITE_BUFFER, 0)
    c.putPointer(stream, core.S_WRITE_SIZE, 0)
    return 0
}

pub fn writableSize(stream: usize) -> usize {
    if !usable(stream) || direction(stream) == core.RECORD {
        const failed = core.fail(context(stream), util.ERR_BADSTATE)
        return 18446744073709551615
    }
    return if requested(stream) > 0 { @intCast(usize, requested(stream)) } else { 0 }
}

// ---------------------------------------------------------------------------
// Recording

// Recorded samples on `channel` (a copy of the packet's payload).
pub fn received(owner: usize, channel: u32, payload: usize, length: usize) -> void {
    const stream = core.streamOn(owner, channel, true)
    if stream == 0 || core.streamState(stream) != core.S_READY || length == 0 { return }
    const chunk = c.alloc(core.CHUNK + length)
    if chunk == 0 { return }
    c.putPointer(chunk, 8, length)
    c.copy(chunk + core.CHUNK, payload, length)
    if c.getPointer(stream, core.S_QUEUE_TAIL) != 0 { c.putPointer(c.getPointer(stream, core.S_QUEUE_TAIL), 0, chunk) } else { c.putPointer(stream, core.S_QUEUE_HEAD, chunk) }
    c.putPointer(stream, core.S_QUEUE_TAIL, chunk)
    c.put64(stream, core.S_QUEUE_BYTES, c.get64(stream, core.S_QUEUE_BYTES) + @intCast(u64, length))
    // Over the most the queue may hold: the oldest go (not one peeked).
    const most = attr(stream, MAXLENGTH)
    while most != wire.INVALID && c.get64(stream, core.S_QUEUE_BYTES) > @intCast(u64, most) {
        const head = c.getPointer(stream, core.S_QUEUE_HEAD)
        if head == 0 || head == c.getPointer(stream, core.S_PEEKED) || c.getPointer(head, 0) == 0 { break }
        c.putPointer(stream, core.S_QUEUE_HEAD, c.getPointer(head, 0))
        c.put64(stream, core.S_QUEUE_BYTES, c.get64(stream, core.S_QUEUE_BYTES) - @intCast(u64, c.getPointer(head, 8) - c.getPointer(head, 16)))
        c.release(head)
    }
    c.call3(c.getPointer(stream, core.S_READ_CALLBACK), stream, @intCast(usize, c.get64(stream, core.S_QUEUE_BYTES)), c.getPointer(stream, core.S_READ_CALLBACK + 8))
}

pub fn peek(stream: usize, data: usize, length: usize) -> i32 {
    if !usable(stream) { return 0 - util.ERR_BADSTATE }
    if direction(stream) != core.RECORD { return core.fail(context(stream), util.ERR_BADSTATE) }
    var chunk = c.getPointer(stream, core.S_PEEKED)
    if chunk == 0 {
        chunk = c.getPointer(stream, core.S_QUEUE_HEAD)
        if chunk == 0 {
            c.putPointer(data, 0, 0)
            c.putPointer(length, 0, 0)
            return 0
        }
        c.putPointer(stream, core.S_PEEKED, chunk)
        c.putPointer(stream, core.S_PEEK_LENGTH, c.getPointer(chunk, 8) - c.getPointer(chunk, 16))
    }
    c.putPointer(data, 0, chunk + core.CHUNK + c.getPointer(chunk, 16))
    c.putPointer(length, 0, c.getPointer(stream, core.S_PEEK_LENGTH))
    return 0
}

pub fn drop(stream: usize) -> i32 {
    if !usable(stream) { return 0 - util.ERR_BADSTATE }
    const chunk = c.getPointer(stream, core.S_PEEKED)
    if direction(stream) != core.RECORD || chunk == 0 { return core.fail(context(stream), util.ERR_BADSTATE) }
    const length = c.getPointer(stream, core.S_PEEK_LENGTH)
    c.putPointer(stream, core.S_QUEUE_HEAD, c.getPointer(chunk, 0))
    if c.getPointer(stream, core.S_QUEUE_HEAD) == 0 { c.putPointer(stream, core.S_QUEUE_TAIL, 0) }
    c.put64(stream, core.S_QUEUE_BYTES, c.get64(stream, core.S_QUEUE_BYTES) - @intCast(u64, length))
    c.release(chunk)
    c.putPointer(stream, core.S_PEEKED, 0)
    c.putPointer(stream, core.S_PEEK_LENGTH, 0)
    const info = timing(stream)
    if c.get32(stream, core.S_TIMING_VALID) != 0 && c.get32(info, T_READ_CORRUPT) == 0 { c.put64(info, T_READ_INDEX, @bitCast(u64, @bitCast(i64, c.get64(info, T_READ_INDEX)) + @intCast(i64, length))) }
    return 0
}

pub fn readableSize(stream: usize) -> usize {
    if !usable(stream) || direction(stream) != core.RECORD {
        const failed = core.fail(context(stream), util.ERR_BADSTATE)
        return 18446744073709551615
    }
    return @intCast(usize, c.get64(stream, core.S_QUEUE_BYTES))
}

// ---------------------------------------------------------------------------
// Timing

fn correction(stream: usize, index: u32) -> usize { return stream + core.S_CORRECTIONS + @intCast(usize, index) * CORRECTION }

export fn mlx_pulse_stream_auto_timing(api: usize, event: usize, time: usize, stream: usize) -> void {
    core.streamRef(stream)
    requestTiming(stream, false)
    core.streamUnref(stream)
}

// Asks for timing (when the stream updates it by itself), and moves its
// timer on (from 10 ms, doubling up to 1.5 s; forced: from the start).
fn requestTiming(stream: usize, force: bool) -> void {
    if flags(stream) & AUTO_TIMING_UPDATE == 0 { return }
    if core.streamState(stream) == core.S_READY && (force || c.get32(stream, core.S_TIMING_REQUESTED) == 0) {
        const operation = updateTiming(stream, 0, 0)
        if operation != 0 {
            core.operationUnref(operation)
            c.put32(stream, core.S_TIMING_REQUESTED, 1)
        }
    }
    const event = c.getPointer(stream, core.S_AUTO_EVENT)
    if event == 0 || context(stream) == 0 { return }
    if c.get32(stream, core.S_SUSPENDED) != 0 && !force {
        mainloop.timeFree(core.api(context(stream)), event)
        c.putPointer(stream, core.S_AUTO_EVENT, 0)
        return
    }
    if force { c.put64(stream, core.S_AUTO_INTERVAL, AUTO_START) }
    const interval = c.get64(stream, core.S_AUTO_INTERVAL)
    core.timeRestart(context(stream), event, c.monotonic() + interval)
    c.put64(stream, core.S_AUTO_INTERVAL, if interval * 2 > AUTO_END { AUTO_END } else { interval * 2 })
}

pub fn updateTiming(stream: usize, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    const kind = direction(stream)
    if kind == core.UPLOAD {
        const refused = refuse(stream, util.ERR_BADSTATE)
        return 0
    }
    const owner = context(stream)
    var slot_index: u32 = 0
    if kind == core.PLAYBACK {
        slot_index = (c.get32(stream, core.S_CORRECTION) + 1) % CORRECTIONS
        if c.get32(correction(stream, slot_index), 0) != 0 {
            const refused = refuse(stream, util.ERR_INTERNAL)
            return 0
        }
    }
    const operation = core.operationNew(owner, stream, callback, userdata)
    const tag = core.nextTag(owner)
    var writing = wire.command(if kind == core.PLAYBACK { GET_PLAYBACK_LATENCY } else { GET_RECORD_LATENCY }, tag)
    wire.putU32(&writing, c.get32(stream, core.S_CHANNEL))
    var now: [2]u64 = [2]u64{ 0, 0 }
    wire.putTimeval(&writing, util.now(@intFromPtr(&now)))
    core.send(owner, &writing)
    core.expectReply(owner, tag, core.R_STREAM_TIMING, operation, 0)
    if kind == core.PLAYBACK {
        c.put32(stream, core.S_CORRECTION, slot_index)
        const slot = correction(stream, slot_index)
        c.put32(slot, 0, 1)
        c.put32(slot, 4, 0)
        c.put32(slot, 8, 0)
        c.put32(slot, 12, tag)
        c.put64(slot, 16, 0)
    }
    return operation
}

// The stream's time from the last timing reply (without the clock).
fn calculated(stream: usize, ignoreTransport: bool) -> u64 {
    const info = timing(stream)
    const running = c.get32(stream, core.S_CORKED) == 0 && c.get32(stream, core.S_SUSPENDED) == 0
    var usec: u64 = 0
    if direction(stream) == core.PLAYBACK {
        const index = @bitCast(i64, c.get64(info, T_READ_INDEX))
        usec = sample.bytesToUsec(if index < 0 { 0 } else { @intCast(u64, index) }, spec(stream))
        if running {
            if !ignoreTransport { usec += c.get64(info, T_TRANSPORT_USEC) }
            const sink = c.get64(info, T_SINK_USEC)
            usec = if sink >= usec { 0 } else { usec - sink }
        }
    } else {
        const index = @bitCast(i64, c.get64(info, T_WRITE_INDEX))
        usec = sample.bytesToUsec(if index < 0 { 0 } else { @intCast(u64, index) }, spec(stream))
        if running {
            if !ignoreTransport { usec += c.get64(info, T_TRANSPORT_USEC) }
            usec += c.get64(info, T_SOURCE_USEC)
            const sink = c.get64(info, T_SINK_USEC)
            usec = if sink >= usec { 0 } else { usec - sink }
        }
    }
    return usec
}

// The clock's part: from the last reply's time on, while the stream plays.
fn interpolated(stream: usize, now: u64) -> u64 {
    const value = c.get64(stream, core.S_SMOOTH_VALUE)
    if c.get32(stream, core.S_SMOOTH_RUNNING) == 0 { return value }
    const at = c.get64(stream, core.S_SMOOTH_AT)
    if now <= at { return value }
    var result = value + (now - at)
    // Not past what was written.
    if direction(stream) == core.PLAYBACK && c.get32(timing(stream), T_WRITE_CORRUPT) == 0 {
        const index = @bitCast(i64, c.get64(timing(stream), T_WRITE_INDEX))
        const written = sample.bytesToUsec(if index < 0 { 0 } else { @intCast(u64, index) }, spec(stream))
        if result > written { result = if written > value { written } else { value } }
    }
    return result
}

fn freeze(stream: usize) -> void {
    if c.get32(stream, core.S_SMOOTH_HAVE) == 0 { return }
    const now = c.monotonic()
    c.put64(stream, core.S_SMOOTH_VALUE, interpolated(stream, now))
    c.put64(stream, core.S_SMOOTH_AT, now)
    c.put32(stream, core.S_SMOOTH_RUNNING, 0)
}

fn timingReply(owner: usize, operation: usize, code: u32, reading: *wire.Reader) -> void {
    const stream = c.getPointer(operation, core.O_STREAM)
    if stream == 0 || c.getPointer(operation, core.O_CONTEXT) == 0 { return }
    const info = timing(stream)
    c.put32(stream, core.S_TIMING_VALID, 0)
    c.put32(info, T_WRITE_CORRUPT, 1)
    c.put32(info, T_READ_CORRUPT, 1)
    if code != REPLY {
        if core.handleError(owner, code, reading) < 0 { return }
    } else {
        c.put64(info, T_SINK_USEC, wire.readUsec(reading))
        c.put64(info, T_SOURCE_USEC, wire.readUsec(reading))
        const playing = wire.readBool(reading)
        var local: [2]u64 = [2]u64{ 0, 0 }
        var remote: [2]u64 = [2]u64{ 0, 0 }
        wire.readTimeval(reading, @intFromPtr(&local))
        wire.readTimeval(reading, @intFromPtr(&remote))
        c.put64(info, T_WRITE_INDEX, @bitCast(u64, wire.readS64(reading)))
        c.put64(info, T_READ_INDEX, @bitCast(u64, wire.readS64(reading)))
        var underrun_for: u64 = 0
        var playing_for: u64 = 0
        if core.version(owner) >= 13 && direction(stream) == core.PLAYBACK {
            underrun_for = wire.readU64(reading)
            playing_for = wire.readU64(reading)
        }
        if reading.*.failed {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        c.put32(stream, core.S_TIMING_VALID, 1)
        c.put32(info, T_WRITE_CORRUPT, 0)
        c.put32(info, T_READ_CORRUPT, 0)
        c.put32(info, T_PLAYING, if playing { 1 } else { 0 })
        c.put64(info, T_SINCE_UNDERRUN, if playing { playing_for } else { underrun_for })
        var now: [2]u64 = [2]u64{ 0, 0 }
        const here = util.now(@intFromPtr(&now))
        const sent = @intFromPtr(&local)
        const there = @intFromPtr(&remote)
        if util.compare(sent, there) <= 0 && util.compare(there, here) <= 0 {
            c.put64(info, T_TRANSPORT_USEC, if direction(stream) == core.PLAYBACK { util.difference(there, sent) } else { util.difference(here, there) })
            c.put32(info, T_SYNCHRONIZED, 1)
            c.copy(info + T_TIMESTAMP, there, 16)
        } else {
            c.put64(info, T_TRANSPORT_USEC, util.difference(here, sent) / 2)
            c.put32(info, T_SYNCHRONIZED, 0)
            c.copy(info + T_TIMESTAMP, sent, 16)
            const added = util.addTime(info + T_TIMESTAMP, c.get64(info, T_TRANSPORT_USEC))
        }
        const tag = c.get32(operation, core.O_VALUE)
        if tag < c.get32(stream, core.S_READ_NOT_BEFORE) { c.put32(info, T_READ_CORRUPT, 1) }
        if tag < c.get32(stream, core.S_WRITE_NOT_BEFORE) { c.put32(info, T_WRITE_CORRUPT, 1) }
        if direction(stream) == core.PLAYBACK {
            // The writes made after the request moved the write index on.
            var after = tag
            var count: u32 = 0
            var index = (c.get32(stream, core.S_CORRECTION) + 1) % CORRECTIONS
            while count < CORRECTIONS {
                const slot = correction(stream, index)
                if c.get32(slot, 0) != 0 && c.get32(slot, 12) >= after {
                    after = c.get32(slot, 12) + 1
                    if c.get32(slot, 8) != 0 {
                        c.put32(info, T_WRITE_CORRUPT, 1)
                    } else if c.get32(slot, 4) != 0 {
                        c.put64(info, T_WRITE_INDEX, c.get64(slot, 16))
                        c.put32(info, T_WRITE_CORRUPT, 0)
                    } else if c.get32(info, T_WRITE_CORRUPT) == 0 {
                        c.put64(info, T_WRITE_INDEX, @bitCast(u64, @bitCast(i64, c.get64(info, T_WRITE_INDEX)) + @bitCast(i64, c.get64(slot, 16))))
                    }
                }
                count += 1
                index = (index + 1) % CORRECTIONS
            }
            count = 0
            while count < CORRECTIONS {
                const slot = correction(stream, count)
                if c.get32(slot, 0) != 0 && c.get32(slot, 12) <= tag { c.put32(slot, 0, 0) }
                count += 1
            }
        }
        if direction(stream) == core.RECORD && c.get32(info, T_READ_CORRUPT) == 0 {
            c.put64(info, T_READ_INDEX, @bitCast(u64, @bitCast(i64, c.get64(info, T_READ_INDEX)) - @bitCast(i64, c.get64(stream, core.S_QUEUE_BYTES))))
        }
        // The clock's starting point.
        if flags(stream) & INTERPOLATE_TIMING != 0 && c.get32(stream, core.S_CORKED) == 0 {
            const measured = c.monotonic() - c.get64(info, T_TRANSPORT_USEC)
            var start = measured
            if direction(stream) == core.PLAYBACK && core.version(owner) >= 13 {
                const since = sample.bytesToUsec(c.get64(info, T_SINCE_UNDERRUN), spec(stream))
                const sink = c.get64(info, T_SINK_USEC)
                if since < sink { start += sink - since }
            }
            const index_ok = if direction(stream) == core.PLAYBACK { c.get32(info, T_READ_CORRUPT) == 0 } else { c.get32(info, T_WRITE_CORRUPT) == 0 }
            if index_ok {
                c.put64(stream, core.S_SMOOTH_VALUE, calculated(stream, true))
                c.put64(stream, core.S_SMOOTH_AT, if playing { start } else { measured })
                c.put32(stream, core.S_SMOOTH_RUNNING, if playing { 1 } else { 0 })
                c.put32(stream, core.S_SMOOTH_HAVE, 1)
            } else if !playing {
                freeze(stream)
            }
        }
    }
    c.put32(stream, core.S_TIMING_REQUESTED, 0)
    notify(stream, core.S_LATENCY_CALLBACK)
    if core.streamState(stream) == core.S_READY { c.call3(c.getPointer(operation, core.O_CALLBACK), stream, if c.get32(stream, core.S_TIMING_VALID) != 0 { 1 } else { 0 }, c.getPointer(operation, core.O_USERDATA)) }
}

fn timingUsable(stream: usize, latency: bool) -> bool {
    if !usable(stream) { return false }
    const kind = direction(stream)
    if kind == core.UPLOAD { return refuse(stream, util.ERR_BADSTATE) }
    const info = timing(stream)
    if c.get32(stream, core.S_TIMING_VALID) == 0 { return refuse(stream, util.ERR_NODATA) }
    if kind == core.PLAYBACK && c.get32(info, T_READ_CORRUPT) != 0 { return refuse(stream, util.ERR_NODATA) }
    if kind == core.RECORD && c.get32(info, T_WRITE_CORRUPT) != 0 { return refuse(stream, util.ERR_NODATA) }
    if latency && kind == core.PLAYBACK && c.get32(info, T_WRITE_CORRUPT) != 0 { return refuse(stream, util.ERR_NODATA) }
    if latency && kind == core.RECORD && c.get32(info, T_READ_CORRUPT) != 0 { return refuse(stream, util.ERR_NODATA) }
    return true
}

fn time(stream: usize) -> u64 {
    var usec: u64 = 0
    if flags(stream) & INTERPOLATE_TIMING != 0 && c.get32(stream, core.S_SMOOTH_HAVE) != 0 {
        usec = interpolated(stream, c.monotonic())
    } else {
        usec = calculated(stream, false)
    }
    if flags(stream) & NOT_MONOTONIC == 0 {
        if usec < c.get64(stream, core.S_PREVIOUS_TIME) { usec = c.get64(stream, core.S_PREVIOUS_TIME) } else { c.put64(stream, core.S_PREVIOUS_TIME, usec) }
    }
    return usec
}

pub fn getTime(stream: usize, result: usize) -> i32 {
    if !timingUsable(stream, false) { return 0 - lastError(stream) }
    const usec = time(stream)
    if result != 0 { c.put64(result, 0, usec) }
    return 0
}

pub fn getLatency(stream: usize, result: usize, negative: usize) -> i32 {
    if !timingUsable(stream, true) { return 0 - lastError(stream) }
    const now = time(stream)
    const info = timing(stream)
    var index = @bitCast(i64, c.get64(info, if direction(stream) == core.PLAYBACK { T_WRITE_INDEX } else { T_READ_INDEX }))
    if index < 0 { index = 0 }
    const counter = sample.bytesToUsec(@intCast(u64, index), spec(stream))
    if negative != 0 { c.put32(negative, 0, 0) }
    var latency: u64 = 0
    if direction(stream) == core.PLAYBACK {
        latency = if counter >= now { counter - now } else { 0 }
    } else if now >= counter {
        latency = now - counter
    } else if negative != 0 {
        c.put32(negative, 0, 1)
        latency = counter - now
    }
    c.put64(result, 0, latency)
    return 0
}

pub fn timingInfo(stream: usize) -> usize {
    if !usable(stream) { return 0 }
    if direction(stream) == core.UPLOAD || c.get32(stream, core.S_TIMING_VALID) == 0 {
        const refused = refuse(stream, if direction(stream) == core.UPLOAD { util.ERR_BADSTATE } else { util.ERR_NODATA })
        return 0
    }
    return timing(stream)
}

fn invalidate(stream: usize, read: bool, wrote: bool) -> void {
    if core.streamState(stream) != core.S_READY { return }
    const tag = c.get32(context(stream), core.C_TAG)
    if wrote {
        c.put32(stream, core.S_WRITE_NOT_BEFORE, tag)
        if c.get32(stream, core.S_TIMING_VALID) != 0 { c.put32(timing(stream), T_WRITE_CORRUPT, 1) }
    }
    if read {
        c.put32(stream, core.S_READ_NOT_BEFORE, tag)
        if c.get32(stream, core.S_TIMING_VALID) != 0 { c.put32(timing(stream), T_READ_CORRUPT, 1) }
    }
    requestTiming(stream, true)
}

// ---------------------------------------------------------------------------
// Requests

fn request(stream: usize, code: u32, tag: u32) -> wire.Writer {
    var writing = wire.command(code, tag)
    wire.putU32(&writing, c.get32(stream, core.S_CHANNEL))
    return writing
}

fn ack(stream: usize, writing: *wire.Writer, tag: u32, callback: usize, userdata: usize) -> usize {
    const owner = context(stream)
    const operation = core.operationNew(owner, stream, callback, userdata)
    core.send(owner, writing)
    core.expectReply(owner, tag, core.R_STREAM_ACK, operation, 0)
    return operation
}

fn simple(stream: usize, code: u32, callback: usize, userdata: usize) -> usize {
    const tag = core.nextTag(context(stream))
    var writing = request(stream, code, tag)
    return ack(stream, &writing, tag, callback, userdata)
}

pub fn cork(stream: usize, corked: bool, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    if direction(stream) == core.UPLOAD {
        const refused = refuse(stream, util.ERR_BADSTATE)
        return 0
    }
    requestTiming(stream, true)
    if corked { freeze(stream) }
    c.put32(stream, core.S_CORKED, if corked { 1 } else { 0 })
    const tag = core.nextTag(context(stream))
    var writing = request(stream, if direction(stream) == core.PLAYBACK { CORK_PLAYBACK_STREAM } else { CORK_RECORD_STREAM }, tag)
    wire.putBool(&writing, corked)
    const operation = ack(stream, &writing, tag, callback, userdata)
    requestTiming(stream, true)
    return operation
}

pub fn flush(stream: usize, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    if direction(stream) == core.UPLOAD {
        const refused = refuse(stream, util.ERR_BADSTATE)
        return 0
    }
    requestTiming(stream, true)
    const playback = direction(stream) == core.PLAYBACK
    const operation = simple(stream, if playback { FLUSH_PLAYBACK_STREAM } else { FLUSH_RECORD_STREAM }, callback, userdata)
    if playback {
        const slot = correction(stream, c.get32(stream, core.S_CORRECTION))
        if c.get32(slot, 0) != 0 { c.put32(slot, 8, 1) }
        invalidate(stream, false, true)
    } else {
        invalidate(stream, true, false)
    }
    return operation
}

fn playbackOnly(stream: usize, code: u32, needsPrebuf: bool, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    if direction(stream) != core.PLAYBACK || (needsPrebuf && attr(stream, PREBUF) == 0) {
        const refused = refuse(stream, util.ERR_BADSTATE)
        return 0
    }
    requestTiming(stream, true)
    const operation = simple(stream, code, callback, userdata)
    requestTiming(stream, true)
    return operation
}

pub fn prebuf(stream: usize, callback: usize, userdata: usize) -> usize { return playbackOnly(stream, PREBUF_PLAYBACK_STREAM, true, callback, userdata) }

pub fn trigger(stream: usize, callback: usize, userdata: usize) -> usize { return playbackOnly(stream, TRIGGER_PLAYBACK_STREAM, true, callback, userdata) }

pub fn drain(stream: usize, callback: usize, userdata: usize) -> usize { return playbackOnly(stream, DRAIN_PLAYBACK_STREAM, false, callback, userdata) }

pub fn proplistUpdate(stream: usize, mode: u32, list: usize, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    if mode > proplist.UPDATE_REPLACE || direction(stream) == core.UPLOAD {
        const refused = refuse(stream, util.ERR_INVALID)
        return 0
    }
    const tag = core.nextTag(context(stream))
    var writing = request(stream, if direction(stream) == core.RECORD { UPDATE_RECORD_STREAM_PROPLIST } else { UPDATE_PLAYBACK_STREAM_PROPLIST }, tag)
    wire.putU32(&writing, mode)
    wire.putProplist(&writing, list)
    return ack(stream, &writing, tag, callback, userdata)
}

pub fn proplistRemove(stream: usize, keys: usize, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    if keys == 0 || c.getPointer(keys, 0) == 0 || direction(stream) == core.UPLOAD {
        const refused = refuse(stream, util.ERR_INVALID)
        return 0
    }
    const tag = core.nextTag(context(stream))
    var writing = request(stream, if direction(stream) == core.RECORD { REMOVE_RECORD_STREAM_PROPLIST } else { REMOVE_PLAYBACK_STREAM_PROPLIST }, tag)
    var index: usize = 0
    while c.getPointer(keys, index * 8) != 0 {
        wire.putCString(&writing, c.getPointer(keys, index * 8))
        index += 1
    }
    wire.putCString(&writing, 0)
    return ack(stream, &writing, tag, callback, userdata)
}

pub fn setName(stream: usize, name: usize, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    const list = proplist.new()
    const set = proplist.setString(list, "media.name", c.slice(name))
    const operation = proplistUpdate(stream, proplist.UPDATE_REPLACE, list, callback, userdata)
    proplist.free(list)
    return operation
}

pub fn setBufferAttr(stream: usize, attributes: usize, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    if direction(stream) == core.UPLOAD || attributes == 0 {
        const refused = refuse(stream, util.ERR_BADSTATE)
        return 0
    }
    const owner = context(stream)
    const playback = direction(stream) == core.PLAYBACK
    const tag = core.nextTag(owner)
    var writing = request(stream, if playback { SET_PLAYBACK_STREAM_BUFFER_ATTR } else { SET_RECORD_STREAM_BUFFER_ATTR }, tag)
    wire.putU32(&writing, c.get32(attributes, MAXLENGTH))
    if playback {
        wire.putU32(&writing, c.get32(attributes, TLENGTH))
        wire.putU32(&writing, c.get32(attributes, PREBUF))
        wire.putU32(&writing, c.get32(attributes, MINREQ))
    } else {
        wire.putU32(&writing, c.get32(attributes, FRAGSIZE))
    }
    if core.version(owner) >= 13 { flag(&writing, flags(stream), ADJUST_LATENCY) }
    if core.version(owner) >= 14 { flag(&writing, flags(stream), EARLY_REQUESTS) }
    const operation = core.operationNew(owner, stream, callback, userdata)
    core.send(owner, &writing)
    core.expectReply(owner, tag, core.R_STREAM_BUFFER_ATTR, operation, 0)
    requestTiming(stream, true)
    return operation
}

pub fn updateSampleRate(stream: usize, rate: u32, callback: usize, userdata: usize) -> usize {
    if !usable(stream) { return 0 }
    if !sample.rateValid(rate) || flags(stream) & VARIABLE_RATE == 0 || direction(stream) == core.UPLOAD {
        const refused = refuse(stream, if flags(stream) & VARIABLE_RATE == 0 { util.ERR_BADSTATE } else { util.ERR_INVALID })
        return 0
    }
    const owner = context(stream)
    const tag = core.nextTag(owner)
    var writing = request(stream, if direction(stream) == core.RECORD { UPDATE_RECORD_STREAM_SAMPLE_RATE } else { UPDATE_PLAYBACK_STREAM_SAMPLE_RATE }, tag)
    wire.putU32(&writing, rate)
    const operation = core.operationNew(owner, stream, callback, userdata)
    core.send(owner, &writing)
    core.expectReply(owner, tag, core.R_STREAM_RATE, operation, @intCast(u64, rate))
    return operation
}

// ---------------------------------------------------------------------------
// Replies

// A reply for a stream (its kinds are below R_CONTEXT_ACK).
pub fn reply(owner: usize, entry: usize, code: u32, reading: *wire.Reader) -> void {
    const kind = c.get32(entry, core.P_KIND)
    const object = c.getPointer(entry, core.P_OBJECT)
    if kind == core.R_STREAM_CREATE || kind == core.R_UPLOAD_CREATE || kind == core.R_STREAM_DISCONNECT {
        const stream = object
        core.streamRef(stream)
        if code != REPLY {
            if core.handleError(owner, code, reading) == 0 { core.setStreamState(stream, core.S_FAILED) }
        } else if kind == core.R_STREAM_DISCONNECT {
            core.setStreamState(stream, core.S_TERMINATED)
        } else if kind == core.R_UPLOAD_CREATE {
            c.put32(stream, core.S_CHANNEL, wire.readU32(reading))
            setRequested(stream, @intCast(i64, wire.readU32(reading)))
            if reading.*.failed {
                core.failWith(owner, util.ERR_PROTOCOL)
            } else {
                c.put32(stream, core.S_CHANNEL_VALID, 1)
                complete(stream)
            }
        } else {
            created(owner, stream, reading)
        }
        core.streamUnref(stream)
        return
    }
    // An operation's.
    const operation = object
    // Its tag, for the timing reply's index corrections.
    c.put32(operation, core.O_VALUE, c.get32(entry, core.P_TAG))
    if c.getPointer(operation, core.O_CONTEXT) == 0 {
        return
    }
    if kind == core.R_STREAM_TIMING {
        timingReply(owner, operation, code, reading)
        core.done(operation)
        return
    }
    const stream = c.getPointer(operation, core.O_STREAM)
    var success: usize = 1
    if code != REPLY {
        if core.handleError(owner, code, reading) < 0 { return }
        success = 0
    } else if kind == core.R_STREAM_BUFFER_ATTR && stream != 0 {
        const playback = direction(stream) == core.PLAYBACK
        setAttr(stream, MAXLENGTH, wire.readU32(reading))
        if playback {
            setAttr(stream, TLENGTH, wire.readU32(reading))
            setAttr(stream, PREBUF, wire.readU32(reading))
            setAttr(stream, MINREQ, wire.readU32(reading))
        } else {
            setAttr(stream, FRAGSIZE, wire.readU32(reading))
        }
        if core.version(owner) >= 13 { c.put64(timing(stream), if playback { T_CONFIGURED_SINK } else { T_CONFIGURED_SOURCE }, wire.readUsec(reading)) }
        if reading.*.failed {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
    } else if kind == core.R_STREAM_RATE && stream != 0 {
        c.put32(stream, core.S_SPEC + 4, @intCast(u32, c.get64(entry, core.P_VALUE)))
    }
    c.call3(c.getPointer(operation, core.O_CALLBACK), stream, success, c.getPointer(operation, core.O_USERDATA))
    core.done(operation)
}

// ---------------------------------------------------------------------------
// The server's commands about streams

fn attributesChanged(owner: usize, stream: usize, record: bool, reading: *wire.Reader, configured: *u64) -> void {
    setAttr(stream, MAXLENGTH, wire.readU32(reading))
    if record {
        setAttr(stream, FRAGSIZE, wire.readU32(reading))
    } else {
        setAttr(stream, TLENGTH, wire.readU32(reading))
        setAttr(stream, PREBUF, wire.readU32(reading))
        setAttr(stream, MINREQ, wire.readU32(reading))
    }
    configured.* = wire.readUsec(reading)
}

fn startAutoTiming(stream: usize) -> void {
    if flags(stream) & AUTO_TIMING_UPDATE == 0 || c.get32(stream, core.S_SUSPENDED) != 0 || c.getPointer(stream, core.S_AUTO_EVENT) != 0 { return }
    c.put64(stream, core.S_AUTO_INTERVAL, AUTO_START)
    c.putPointer(stream, core.S_AUTO_EVENT, core.timeNew(context(stream), c.monotonic() + AUTO_START, @intFromPtr(mlx_pulse_stream_auto_timing), stream))
    requestTiming(stream, true)
}

pub fn command(owner: usize, code: u32, reading: *wire.Reader) -> void {
    const record = code == RECORD_STREAM_KILLED || code == RECORD_STREAM_SUSPENDED || code == RECORD_STREAM_MOVED || code == RECORD_STREAM_EVENT || code == RECORD_BUFFER_ATTR_CHANGED
    const known = code == REQUEST || code == OVERFLOW || code == UNDERFLOW || code == PLAYBACK_STREAM_KILLED || code == RECORD_STREAM_KILLED || code == PLAYBACK_STREAM_SUSPENDED || code == RECORD_STREAM_SUSPENDED || code == PLAYBACK_STREAM_MOVED || code == RECORD_STREAM_MOVED || code == STARTED || code == PLAYBACK_STREAM_EVENT || code == RECORD_STREAM_EVENT || code == PLAYBACK_BUFFER_ATTR_CHANGED || code == RECORD_BUFFER_ATTR_CHANGED
    // Others (extensions' events) are not for this library.
    if !known { return }
    const channel = wire.readU32(reading)
    if reading.*.failed {
        core.failWith(owner, util.ERR_PROTOCOL)
        return
    }
    const stream = core.streamOn(owner, channel, record)
    if code == REQUEST {
        const bytes = wire.readU32(reading)
        if reading.*.failed {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        if stream == 0 || core.streamState(stream) != core.S_READY { return }
        setRequested(stream, requested(stream) + @intCast(i64, bytes))
        if requested(stream) > 0 { c.call3(c.getPointer(stream, core.S_WRITE_CALLBACK), stream, @intCast(usize, requested(stream)), c.getPointer(stream, core.S_WRITE_CALLBACK + 8)) }
        return
    }
    if code == OVERFLOW || code == UNDERFLOW {
        var offset: i64 = -1
        if core.version(owner) >= 23 && code == UNDERFLOW { offset = wire.readS64(reading) }
        if reading.*.failed {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        if stream == 0 || core.streamState(stream) != core.S_READY { return }
        if offset != -1 { c.put64(stream, core.S_UNDERFLOW_INDEX, @bitCast(u64, offset)) }
        if attr(stream, PREBUF) > 0 { freeze(stream) }
        requestTiming(stream, true)
        notify(stream, if code == OVERFLOW { core.S_OVERFLOW_CALLBACK } else { core.S_UNDERFLOW_CALLBACK })
        return
    }
    if code == PLAYBACK_STREAM_KILLED || code == RECORD_STREAM_KILLED {
        if stream == 0 || core.streamState(stream) != core.S_READY { return }
        const failed = core.fail(owner, util.ERR_KILLED)
        core.setStreamState(stream, core.S_FAILED)
        return
    }
    if code == PLAYBACK_STREAM_SUSPENDED || code == RECORD_STREAM_SUSPENDED {
        const suspended = wire.readBool(reading)
        if reading.*.failed {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        if stream == 0 || core.streamState(stream) != core.S_READY { return }
        c.put32(stream, core.S_SUSPENDED, if suspended { 1 } else { 0 })
        if suspended { freeze(stream) }
        startAutoTiming(stream)
        requestTiming(stream, true)
        notify(stream, core.S_SUSPENDED_CALLBACK)
        return
    }
    if code == PLAYBACK_STREAM_MOVED || code == RECORD_STREAM_MOVED {
        const device_index = wire.readU32(reading)
        const device = wire.readString(reading)
        const suspended = wire.readBool(reading)
        var configured: u64 = 0
        var saved: [20]u8 = undefined
        if stream != 0 { c.copy(@intFromPtr(&saved), stream + core.S_ATTR, 20) }
        if core.version(owner) >= 13 && stream != 0 { attributesChanged(owner, stream, record, reading, &configured) }
        if reading.*.failed || device == 0 || device_index == wire.INVALID {
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        if stream == 0 || core.streamState(stream) != core.S_READY { return }
        c.put64(timing(stream), if record { T_CONFIGURED_SOURCE } else { T_CONFIGURED_SINK }, configured)
        c.release(c.getPointer(stream, core.S_DEVICE_NAME))
        c.putPointer(stream, core.S_DEVICE_NAME, c.duplicateC(device))
        c.put32(stream, core.S_DEVICE_INDEX, device_index)
        c.put32(stream, core.S_SUSPENDED, if suspended { 1 } else { 0 })
        startAutoTiming(stream)
        requestTiming(stream, true)
        notify(stream, core.S_MOVED_CALLBACK)
        return
    }
    if code == STARTED {
        if stream == 0 || core.streamState(stream) != core.S_READY { return }
        requestTiming(stream, true)
        notify(stream, core.S_STARTED_CALLBACK)
        return
    }
    if code == PLAYBACK_STREAM_EVENT || code == RECORD_STREAM_EVENT {
        const name = wire.readString(reading)
        const list = proplist.new()
        wire.readProplist(reading, list)
        if reading.*.failed || name == 0 {
            proplist.free(list)
            core.failWith(owner, util.ERR_PROTOCOL)
            return
        }
        if stream != 0 && core.streamState(stream) == core.S_READY {
            if c.same(c.slice(name), "format-lost") && timingUsable(stream, false) {
                var writing = util.text()
                util.addNumber(&writing, time(stream))
                const text = util.finish(&writing)
                const set = proplist.setString(list, "stream-time", c.slice(text))
                c.release(text)
            }
            c.call4(c.getPointer(stream, core.S_EVENT_CALLBACK), stream, name, list, c.getPointer(stream, core.S_EVENT_CALLBACK + 8))
        }
        proplist.free(list)
        return
    }
    // The buffers changed.
    if stream == 0 { return }
    var configured: u64 = 0
    attributesChanged(owner, stream, record, reading, &configured)
    if reading.*.failed {
        core.failWith(owner, util.ERR_PROTOCOL)
        return
    }
    if core.streamState(stream) != core.S_READY { return }
    c.put64(timing(stream), if record { T_CONFIGURED_SOURCE } else { T_CONFIGURED_SINK }, configured)
    requestTiming(stream, true)
    notify(stream, core.S_BUFFER_ATTR_CALLBACK)
}

// ---------------------------------------------------------------------------
// What the stream is

pub fn index(stream: usize) -> u32 {
    if !usable(stream) { return wire.INVALID }
    return c.get32(stream, core.S_INDEX)
}

pub fn bufferAttr(stream: usize) -> usize {
    if !usable(stream) { return 0 }
    if direction(stream) == core.UPLOAD || core.version(context(stream)) < 9 {
        const refused = refuse(stream, util.ERR_BADSTATE)
        return 0
    }
    return stream + core.S_ATTR
}

pub fn formatInfo(stream: usize) -> usize {
    if !usable(stream) { return 0 }
    return c.getPointer(stream, core.S_FORMAT)
}

pub fn deviceIndex(stream: usize) -> u32 {
    if !usable(stream) { return wire.INVALID }
    if direction(stream) == core.UPLOAD || c.get32(stream, core.S_DEVICE_INDEX) == wire.INVALID {
        const refused = refuse(stream, util.ERR_NOTSUPPORTED)
        return wire.INVALID
    }
    return c.get32(stream, core.S_DEVICE_INDEX)
}

pub fn deviceName(stream: usize) -> usize {
    if !usable(stream) { return 0 }
    if direction(stream) == core.UPLOAD || c.getPointer(stream, core.S_DEVICE_NAME) == 0 {
        const refused = refuse(stream, util.ERR_NOTSUPPORTED)
        return 0
    }
    return c.getPointer(stream, core.S_DEVICE_NAME)
}

pub fn isSuspended(stream: usize) -> i32 {
    if !usable(stream) { return 0 - util.ERR_BADSTATE }
    if direction(stream) == core.UPLOAD { return core.fail(context(stream), util.ERR_BADSTATE) }
    return @bitCast(i32, c.get32(stream, core.S_SUSPENDED))
}

pub fn isCorked(stream: usize) -> i32 {
    if !usable(stream) { return 0 - util.ERR_BADSTATE }
    if direction(stream) == core.UPLOAD { return core.fail(context(stream), util.ERR_BADSTATE) }
    return @bitCast(i32, c.get32(stream, core.S_CORKED))
}

pub fn setMonitorStream(stream: usize, input: u32) -> i32 {
    const owner = context(stream)
    if input == wire.INVALID { return core.fail(owner, util.ERR_INVALID) }
    if core.streamState(stream) != core.S_UNCONNECTED { return core.fail(owner, util.ERR_BADSTATE) }
    if owner != 0 && core.version(owner) != 0 && core.version(owner) < 13 { return core.fail(owner, util.ERR_NOTSUPPORTED) }
    c.put32(stream, core.S_DIRECT_ON_INPUT, input)
    return 0
}

pub fn monitorStream(stream: usize) -> u32 {
    if c.get32(stream, core.S_DIRECT_ON_INPUT) == wire.INVALID {
        const refused = refuse(stream, util.ERR_BADSTATE)
        return wire.INVALID
    }
    return c.get32(stream, core.S_DIRECT_ON_INPUT)
}
