// libpulse.so.0 in Mlx: PulseAudio's client library, for the programs that
// speak PulseAudio (Firefox, Chromium and Electron apps, SDL games, mpv,
// GStreamer, pactl, pavucontrol, alsa-plugins' pulse plugin). They reach
// MLX Audio's PulseAudio socket (projects/desktop/audio/pulse.mlx) with it;
// PulseAudio's own library (the libpulse0 package) is not needed.
//
//   mlx4 --plugin --soname=libpulse.so.0 --symbol-version=PULSE_0 \
//       projects/desktop/libpulse/libpulse.mlx -o libpulse.so.0
//
// (tools/build_libpulse.sh builds it with libpulse-simple.so.0,
// libpulse-mainloop-glib.so.0 and the ALSA plugin.)
//
// Every function of libpulse 16.1 is exported (export_*.mlx); the library
// keeps its objects in C memory (c.mlx), runs its loops on the program's
// threads and speaks protocol 35 without shared memory (context.mlx,
// stream.mlx, introspect.mlx).
const values = @import("./export_values.mlx")
const loops = @import("./export_loops.mlx")
const contexts = @import("./export_context.mlx")
const streams = @import("./export_stream.mlx")
