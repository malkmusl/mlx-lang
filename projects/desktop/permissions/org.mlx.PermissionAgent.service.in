# The permission agent, started by mlx-ipcd (MLXIPC) when it first has to
# ask the user whether an app may do something. It lives in
# PREFIX/share/mlx/dbus-1/services, where only MLXIPC looks (mlx-session
# passes --services).
[D-BUS Service]
Name=org.mlx.PermissionAgent
Exec=@BINDIR@/mlx-permissions
