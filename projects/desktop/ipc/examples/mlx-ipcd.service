# MLXIPC's system bus under systemd: /run/mlx/bus, open to every user,
# root alone owns names, the rules in /etc/mlx/ipc.conf.
# tools/install_network.sh installs it into /etc/systemd/system for
# mlx-netd, which answers on it; dbus-daemon may run beside it. It says
# READY=1 once the socket takes connections (Type=notify), so the units
# after it find the bus there.
[Unit]
Description=MLXIPC system bus
Documentation=file://@DOCDIR@/README.md
Before=mlx-netd.service

[Service]
Type=notify
ExecStart=@BINDIR@/mlx-ipcd --system
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
