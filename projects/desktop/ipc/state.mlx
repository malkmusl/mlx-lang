// The records of mlx-ipcd (MLXIPC's bus): the bus, its clients, names,
// match rules and calls waiting for replies (bus.mlx), the apps and their
// permissions (policy.mlx), the questions put to the user (prompts.mlx)
// and the services being started (activation.mlx). They live here, apart from the modules that use them,
// because those modules import one another.
const std = @import("std")
const dbus = @import("std.dbus")

pub const Identity = struct {
    pid: u32
    app: [128]u8
    appLength: usize
    sandboxed: bool
}

// A rule's (and the policy's) decisions.
pub const DENY: u8 = 0
pub const ALLOW: u8 = 1
// The user is asked (prompts.mlx), for `use` rules.
pub const ASK: u8 = 2

pub const Rule = struct {
    decision: u8
    actions: u8
    subject: [128]u8
    subjectLength: usize
    pattern: [256]u8
    patternLength: usize
}

pub const Group = struct {
    name: [64]u8
    nameLength: usize
    // Its apps, each followed by a space.
    members: [1024]u8
    membersLength: usize
}

pub const Policy = struct {
    rules: [256]Rule
    ruleCount: usize
    groups: [32]Group
    groupCount: usize
    strict: bool
    path: [512]u8
    pathLength: usize
    // The file's modification time when it was read (0: not there).
    modifiedSeconds: isize
    modifiedNanoseconds: isize
}

// A call waiting for its service: a copy of the message, and its
// descriptors.
pub const Waiting = struct {
    caller: usize
    message: [*]u8
    size: usize
    descriptors: [28]isize
    count: usize
}

// A service being started.
pub const Starting = struct {
    used: bool
    name: [256]u8
    nameLength: usize
    pid: isize
    startedAt: usize
    // Waiting records.
    waiting: [16]usize
    waitingCount: usize
    // StartServiceByName calls to answer.
    starters: [8]usize
    starterSerials: [8]u32
    starterCount: usize
}

pub const Activation = struct {
    starting: [16]Starting
    // From UpdateActivationEnvironment: "KEY=VALUE" entries, each ended by
    // a NUL.
    environment: [16384]u8
    environmentLength: usize
    // --services DIR: searched first ("" none).
    directory: [512]u8
    directoryLength: usize
}

// A well-known name, its owner and who waits for it.
pub const Name = struct {
    name: [256]u8
    length: usize
    owner: usize
    ownerFlags: u32
    queue: [8]usize
    queueFlags: [8]u32
    queued: usize
}

// A match rule (AddMatch). Empty strings match anything.
pub const Match = struct {
    client: usize
    rule: [512]u8
    ruleLength: usize
    kind: u8
    sender: [256]u8
    senderLength: usize
    interface: [256]u8
    interfaceLength: usize
    member: [256]u8
    memberLength: usize
    path: [256]u8
    pathLength: usize
    pathNamespace: [256]u8
    pathNamespaceLength: usize
    destination: [256]u8
    destinationLength: usize
    arg0: [256]u8
    arg0Length: usize
    arg0Namespace: bool
}

// A call that waits for its reply: the reply goes back whatever the rules
// say.
pub const Expected = struct {
    caller: usize
    callee: usize
    serial: u32
}

pub const Client = struct {
    descriptor: isize
    connection: dbus.Connection
    state: u8
    sawNul: bool
    unixFds: bool
    pid: u32
    uid: u32
    gid: u32
    hello: bool
    unique: [32]u8
    uniqueLength: usize
    // Serials of the messages the bus sends it.
    serial: u32
    dead: bool
    watchingOutput: bool
    // A monitor (BecomeMonitor): it gets a copy of everything, sends
    // nothing.
    monitor: bool
    identity: Identity
}

// Who opened a direct channel (org.mlx.IPC.Connect): the service on the
// other end asks about it (Check) by the caller's unique name, which
// stays known after the caller left the bus (unique names never come
// back).
pub const Opener = struct {
    unique: [32]u8
    uniqueLength: usize
    identity: Identity
}

// A question to the user (the permission agent, prompts.mlx): may `app`
// use `permission`? The bus's call to the agent, and the Checks waiting
// for the answer (the asking connection and its call's serial).
pub const Prompt = struct {
    used: bool
    serial: u32
    agent: usize
    app: [128]u8
    appLength: usize
    sandboxed: bool
    permission: [64]u8
    permissionLength: usize
    startedAt: usize
    waiters: [16]usize
    waiterSerials: [16]u32
    waiterCount: usize
}

// An answer the user gave for this session only (not kept in ipc.conf).
pub const Grant = struct {
    app: [128]u8
    appLength: usize
    permission: [64]u8
    permissionLength: usize
    allowed: bool
}

// An app that asked for a service's permission (the Apps settings list
// them), kept in $XDG_STATE_HOME/mlx/ipc-seen.
pub const Seen = struct {
    app: [128]u8
    appLength: usize
    permission: [64]u8
    permissionLength: usize
    sandboxed: bool
}

pub const Bus = struct {
    allocator: std.allocator.Allocator
    listener: isize
    eventLoop: isize
    running: bool
    verbose: bool
    // A system bus (--system): every user connects, root alone owns names.
    system: bool
    // The bus's id (GetId, and the OK of authentication).
    guid: [32]u8
    nextId: usize
    clients: [512]usize
    clientCount: usize
    names: [1024]usize
    nameCount: usize
    matches: [4096]usize
    matchCount: usize
    // "unix:path=...": what clients and started services are told.
    address: [256]u8
    addressLength: usize
    environment: [*][*]const u8
    policy: Policy
    activation: Activation
    // Where outgoing messages are built, and the bus's own bodies.
    scratch: [*]u8
    body: [*]u8
    expected: [4096]Expected
    expectedCount: usize
    openers: [256]Opener
    openerCount: usize
    nextOpener: usize
    // Delivered and refused messages (for the log and tests).
    delivered: usize
    denied: usize
    prompts: [16]Prompt
    grants: [64]Grant
    grantCount: usize
    seen: [256]Seen
    seenCount: usize
    // $XDG_STATE_HOME/mlx/ipc-seen (NUL-terminated; empty: not kept).
    seenPath: [512]u8
    seenPathLength: usize
}
