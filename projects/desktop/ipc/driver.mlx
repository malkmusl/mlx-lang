// What mlx-ipcd answers itself: org.freedesktop.DBus (Hello, names, match
// rules, credentials, activation, monitoring), its Peer and
// Introspectable interfaces, and org.mlx.IPC (who the apps are, the
// policy, direct channels); and the signals it sends of its own
// (NameOwnerChanged, NameAcquired, NameLost).
//
// org.mlx.IPC.Check(s NAME, s PERMISSION) -> b is how services ask about
// their own permissions ("audio.record"): the policy's `use` rules decide
// for the app behind NAME, or the user does (an `ask`: the answer waits
// for the permission agent, prompts.mlx). When the rules change the bus
// says org.mlx.IPC.PermissionsChanged(), and services check again what
// they allowed. ListPermissions and SetPermission are the Apps
// settings' (prompts.mlx).
//
// org.mlx.IPC.Connect(s NAME) -> h is MLXIPC's way past the bus (as in
// hyprtavern): the bus makes a socket pair, hands one end to the caller
// and the other to NAME's owner (org.mlx.IPC.Peer.Connected(h, s caller,
// s app), a call that wants no reply), and the two talk directly from
// then on, in D-Bus messages or any protocol of their own. The policy
// decides as for a call: the caller must be allowed to talk to NAME.
const std = @import("std")
const dbus = @import("std.dbus")
const state = @import("./state.mlx")
const bus_module = @import("./bus.mlx")
const policy = @import("./policy.mlx")
const activation = @import("./activation.mlx")
const prompts = @import("./prompts.mlx")

fn same(first: []const u8, second: []const u8) -> bool { return bus_module.same(first, second) }

pub const IPC_NAME: []const u8 = "org.mlx.IPC"
pub const IPC_PATH: []const u8 = "/org/mlx/IPC"
pub const PEER_INTERFACE: []const u8 = "org.mlx.IPC.Peer"

const INTROSPECTION: []const u8 = "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\" \"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">\n<node>\n <interface name=\"org.freedesktop.DBus\">\n  <method name=\"Hello\"><arg direction=\"out\" type=\"s\"/></method>\n  <method name=\"RequestName\"><arg direction=\"in\" type=\"s\"/><arg direction=\"in\" type=\"u\"/><arg direction=\"out\" type=\"u\"/></method>\n  <method name=\"ReleaseName\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"u\"/></method>\n  <method name=\"StartServiceByName\"><arg direction=\"in\" type=\"s\"/><arg direction=\"in\" type=\"u\"/><arg direction=\"out\" type=\"u\"/></method>\n  <method name=\"UpdateActivationEnvironment\"><arg direction=\"in\" type=\"a{ss}\"/></method>\n  <method name=\"NameHasOwner\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"b\"/></method>\n  <method name=\"ListNames\"><arg direction=\"out\" type=\"as\"/></method>\n  <method name=\"ListActivatableNames\"><arg direction=\"out\" type=\"as\"/></method>\n  <method name=\"AddMatch\"><arg direction=\"in\" type=\"s\"/></method>\n  <method name=\"RemoveMatch\"><arg direction=\"in\" type=\"s\"/></method>\n  <method name=\"GetNameOwner\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"s\"/></method>\n  <method name=\"ListQueuedOwners\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"as\"/></method>\n  <method name=\"GetConnectionUnixUser\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"u\"/></method>\n  <method name=\"GetConnectionUnixProcessID\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"u\"/></method>\n  <method name=\"GetConnectionCredentials\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"a{sv}\"/></method>\n  <method name=\"GetId\"><arg direction=\"out\" type=\"s\"/></method>\n  <method name=\"ReloadConfig\"/>\n  <signal name=\"NameOwnerChanged\"><arg type=\"s\"/><arg type=\"s\"/><arg type=\"s\"/></signal>\n  <signal name=\"NameLost\"><arg type=\"s\"/></signal>\n  <signal name=\"NameAcquired\"><arg type=\"s\"/></signal>\n </interface>\n <interface name=\"org.freedesktop.DBus.Monitoring\">\n  <method name=\"BecomeMonitor\"><arg direction=\"in\" type=\"as\"/><arg direction=\"in\" type=\"u\"/></method>\n </interface>\n <interface name=\"org.freedesktop.DBus.Peer\">\n  <method name=\"Ping\"/>\n  <method name=\"GetMachineId\"><arg direction=\"out\" type=\"s\"/></method>\n </interface>\n <interface name=\"org.freedesktop.DBus.Introspectable\">\n  <method name=\"Introspect\"><arg direction=\"out\" type=\"s\"/></method>\n </interface>\n <interface name=\"org.mlx.IPC\">\n  <method name=\"GetAppId\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"s\"/><arg direction=\"out\" type=\"b\"/></method>\n  <method name=\"ListApps\"><arg direction=\"out\" type=\"a(ssbu)\"/></method>\n  <method name=\"Connect\"><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"h\"/></method>\n  <method name=\"Check\"><arg direction=\"in\" type=\"s\"/><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"b\"/></method>\n  <method name=\"CheckProcess\"><arg direction=\"in\" type=\"u\"/><arg direction=\"in\" type=\"s\"/><arg direction=\"out\" type=\"b\"/></method>\n  <method name=\"ListPermissions\"><arg direction=\"out\" type=\"a(sssb)\"/></method>\n  <method name=\"SetPermission\"><arg direction=\"in\" type=\"s\"/><arg direction=\"in\" type=\"s\"/><arg direction=\"in\" type=\"s\"/></method>\n  <method name=\"Reload\"/>\n  <signal name=\"PermissionsChanged\"/>\n </interface>\n</node>\n"

fn nothing() -> [*]const isize {
    var none: [1]isize = [1]isize{ 0 }
    unsafe { return @ptrCast([*]const isize, &none) }
}

pub fn nextSerial(client: *state.Client) -> u32 {
    client.*.serial +%= 1
    if client.*.serial == 0 { client.*.serial = 1 }
    return client.*.serial
}

// A body to build (in the bus's body area).
pub fn body(bus: *state.Bus, writing: *dbus.Writer) -> void { dbus.begin(writing, bus.*.body, dbus.MAX_MESSAGE - 1024, false) }

// Sends a message of the bus's to `client` (monitors get a copy).
fn send(bus: *state.Bus, client: *state.Client, header: *const dbus.Header, bytes: [*]const u8, descriptors: [*]const isize, count: usize) -> void {
    bus_module.monitorCopy(bus, header, bus_module.BUS_NAME, bytes)
    bus_module.deliver(bus, client, header, bus_module.BUS_NAME, bytes, descriptors, count, false)
}

// The reply to `call`, its body in `writing` (of signature `signature`).
fn reply(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, signature: []const u8, writing: *const dbus.Writer) -> void {
    if call.*.flags & dbus.NO_REPLY_EXPECTED != 0 { return }
    var header = dbus.newHeader(dbus.METHOD_RETURN, nextSerial(client))
    header.replySerial = call.*.serial
    header.hasReplySerial = true
    header.destination = bus_module.uniqueOf(client)
    header.signature = signature
    header.bodyLength = writing.*.length
    send(bus, client, &header, writing.*.bytes, nothing(), 0)
}

pub fn replyWith(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, signature: []const u8, writing: *const dbus.Writer) -> void { reply(bus, client, call, signature, writing) }

// A call of the bus's own (no descriptors) to `client`.
pub fn sendFromBus(bus: *state.Bus, client: *state.Client, header: *const dbus.Header, bytes: [*]const u8) -> void { send(bus, client, header, bytes, nothing(), 0) }

// The boolean reply to `client`'s call `serial`, given later.
pub fn replyBoolTo(bus: *state.Bus, client: *state.Client, serial: u32, value: bool) -> void {
    var call = dbus.newHeader(dbus.METHOD_CALL, serial)
    replyBool(bus, client, &call, value)
}

fn replyEmpty(bus: *state.Bus, client: *state.Client, call: *const dbus.Header) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    reply(bus, client, call, "", &writing)
}

fn replyU32(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, value: u32) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    dbus.putU32(&writing, value)
    reply(bus, client, call, "u", &writing)
}

fn replyString(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, text: []const u8) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    dbus.putString(&writing, text)
    reply(bus, client, call, "s", &writing)
}

fn replyBool(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, value: bool) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    dbus.putBool(&writing, value)
    reply(bus, client, call, "b", &writing)
}

// The reply StartServiceByName waited for (activation.mlx): 1, started.
pub fn replyStarted(bus: *state.Bus, client: *state.Client, serial: u32) -> void {
    var call = dbus.newHeader(dbus.METHOD_CALL, serial)
    replyU32(bus, client, &call, 1)
}

fn failed(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8, message: []const u8) -> void { bus_module.replyError(bus, client, call, name, message) }

// ---------------------------------------------------------------------------
// Signals

fn signalHeader(serial: u32, member: []const u8, signature: []const u8, length: usize) -> dbus.Header {
    var header = dbus.newHeader(dbus.SIGNAL, serial)
    header.path = bus_module.BUS_PATH
    header.interface = bus_module.BUS_NAME
    header.member = member
    header.signature = signature
    header.bodyLength = length
    return header
}

// NameOwnerChanged(name, old, new) to whoever's rules take it and may
// know of the name.
pub fn nameOwnerChanged(bus: *state.Bus, name: []const u8, old: []const u8, new: []const u8) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    dbus.putString(&writing, name)
    dbus.putString(&writing, old)
    dbus.putString(&writing, new)
    if writing.failed { return }
    var header = signalHeader(1, "NameOwnerChanged", "sss", writing.length)
    bus_module.monitorCopy(bus, &header, bus_module.BUS_NAME, writing.bytes)
    var index: usize = 0
    while index < bus.*.clientCount {
        const client = bus_module.clientAt(bus.*.clients[index])
        if bus_module.wants(bus, client, &header, bus_module.BUS_NAME, writing.bytes) && policy.maySeeName(bus, client, name) {
            header.serial = nextSerial(client)
            bus_module.deliver(bus, client, &header, bus_module.BUS_NAME, writing.bytes, nothing(), 0, false)
        }
        index += 1
    }
}

// org.mlx.IPC.PermissionsChanged() to whoever's rules take it (services
// check again what they allowed).
pub fn permissionsChanged(bus: *state.Bus) -> void {
    var header = dbus.newHeader(dbus.SIGNAL, 1)
    header.path = IPC_PATH
    header.interface = IPC_NAME
    header.member = "PermissionsChanged"
    header.signature = ""
    header.bodyLength = 0
    var empty: [8]u8 = undefined
    var empty_bytes: [*]const u8 = undefined
    unsafe { empty_bytes = @ptrCast([*]const u8, &empty) }
    bus_module.monitorCopy(bus, &header, bus_module.BUS_NAME, empty_bytes)
    var index: usize = 0
    while index < bus.*.clientCount {
        const client = bus_module.clientAt(bus.*.clients[index])
        if !client.*.dead && bus_module.wants(bus, client, &header, bus_module.BUS_NAME, empty_bytes) {
            header.serial = nextSerial(client)
            bus_module.deliver(bus, client, &header, bus_module.BUS_NAME, empty_bytes, nothing(), 0, false)
        }
        index += 1
    }
}

fn nameSignal(bus: *state.Bus, client: *state.Client, member: []const u8, name: []const u8) -> void {
    if !client.*.hello || client.*.monitor { return }
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    dbus.putString(&writing, name)
    var header = signalHeader(nextSerial(client), member, "s", writing.length)
    header.destination = bus_module.uniqueOf(client)
    send(bus, client, &header, writing.bytes, nothing(), 0)
}

pub fn nameAcquired(bus: *state.Bus, client: *state.Client, name: []const u8) -> void { nameSignal(bus, client, "NameAcquired", name) }
pub fn nameLost(bus: *state.Bus, client: *state.Client, name: []const u8) -> void { nameSignal(bus, client, "NameLost", name) }

// ---------------------------------------------------------------------------
// Methods

fn hello(bus: *state.Bus, client: *state.Client, call: *const dbus.Header) -> void {
    if client.*.hello {
        failed(bus, client, call, "org.freedesktop.DBus.Error.Failed", "Already handled an Hello message")
        return
    }
    // ":1.N"
    var digits: [20]u8 = undefined
    var count: usize = 0
    var value = bus.*.nextId
    bus.*.nextId += 1
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value = value / 10
        if value == 0 { break }
    }
    client.*.unique[0] = 58
    client.*.unique[1] = 49
    client.*.unique[2] = 46
    var length: usize = 3
    while count > 0 {
        count -= 1
        client.*.unique[length] = digits[count]
        length += 1
    }
    client.*.uniqueLength = length
    client.*.hello = true
    const unique = bus_module.uniqueOf(client)
    replyString(bus, client, call, unique)
    nameOwnerChanged(bus, unique, "", unique)
    nameAcquired(bus, client, unique)
    bus_module.say(bus, "ipc: ")
    bus_module.say(bus, unique)
    bus_module.say(bus, " is ")
    bus_module.say(bus, policy.appOf(policy.identityOf(client)))
    if client.*.identity.sandboxed { bus_module.say(bus, " (sandboxed)") }
    bus_module.say(bus, "\n")
}

// Whether a call has the signature `wanted` and a readable first string;
// else it gets an InvalidArgs error.
fn takes(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, bytes: [*]const u8, wanted: []const u8) -> bool {
    if !same(call.*.signature, wanted) {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "The arguments are not what the method takes")
        return false
    }
    var reading = dbus.reader(bytes, call.*.bodyLength, call.*.big)
    const text = dbus.readString(&reading)
    if reading.failed {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "The arguments are malformed")
        return false
    }
    return true
}

// The call's first argument, a string.
fn firstString(call: *const dbus.Header, bytes: [*]const u8) -> []const u8 {
    var reading = dbus.reader(bytes, call.*.bodyLength, call.*.big)
    return dbus.readString(&reading)
}

fn isValidName(name: []const u8) -> bool {
    if name.length == 0 || name.length > 255 || name[0] == 58 || name[0] == 46 { return false }
    var dots: usize = 0
    var index: usize = 0
    while index < name.length {
        const byte = name[index]
        if byte == 46 {
            if index + 1 >= name.length || name[index + 1] == 46 { return false }
            dots += 1
        } else if !((byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95 || byte == 45) {
            return false
        }
        index += 1
    }
    return dots > 0
}

fn requestName(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, bytes: [*]const u8) -> void {
    if !same(call.*.signature, "su") {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "RequestName takes (su)")
        return
    }
    var reading = dbus.reader(bytes, call.*.bodyLength, call.*.big)
    const name = dbus.readString(&reading)
    const flags = dbus.readU32(&reading)
    if reading.failed || !isValidName(name) {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "Not a valid bus name")
        return
    }
    if same(name, bus_module.BUS_NAME) || same(name, IPC_NAME) {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "That name is the bus's own")
        return
    }
    if bus.*.system && client.*.uid != 0 {
        bus.*.denied += 1
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: on the system bus only root owns names")
        return
    }
    if !policy.mayOwn(bus, client, name) {
        bus.*.denied += 1
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: this app may not own that name (~/.config/mlx/ipc.conf)")
        return
    }
    const result = bus_module.requestName(bus, client, name, flags)
    // The change's signals went first, then the reply (dbus-daemon's
    // order).
    replyU32(bus, client, call, result)
    // Calls that waited for the name (activation) go after the reply: the
    // new owner reads that first.
    if result == bus_module.PRIMARY_OWNER { activation.nameAcquired(bus, name, @intFromPtr(client)) }
}

fn putName(writing: *dbus.Writer, name: []const u8) -> void { dbus.putString(writing, name) }

fn listNames(bus: *state.Bus, client: *state.Client, call: *const dbus.Header) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    const at = dbus.beginArray(&writing, 4)
    putName(&writing, bus_module.BUS_NAME)
    var index: usize = 0
    while index < bus.*.clientCount {
        const other = bus_module.clientAt(bus.*.clients[index])
        if other.*.hello && policy.maySeeName(bus, client, bus_module.uniqueOf(other)) { putName(&writing, bus_module.uniqueOf(other)) }
        index += 1
    }
    index = 0
    while index < bus.*.nameCount {
        const name = bus_module.nameText(bus_module.nameAt(bus.*.names[index]))
        if policy.maySeeName(bus, client, name) { putName(&writing, name) }
        index += 1
    }
    dbus.endArray(&writing, at, 4)
    reply(bus, client, call, "as", &writing)
}

fn listActivatable(bus: *state.Bus, client: *state.Client, call: *const dbus.Header) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    const at = dbus.beginArray(&writing, 4)
    putName(&writing, bus_module.BUS_NAME)
    activation.putNames(bus, client, &writing)
    dbus.endArray(&writing, at, 4)
    reply(bus, client, call, "as", &writing)
}

// The connection `name` names (unique or well-known) for a question about
// it; 0 (and NameHasNoOwner) when there is none the client may know of.
fn connectionOf(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8) -> usize {
    const owner = bus_module.resolve(bus, name)
    if owner == 0 || !policy.maySeeName(bus, client, name) {
        failed(bus, client, call, "org.freedesktop.DBus.Error.NameHasNoOwner", "The name has no owner")
        return 0
    }
    return owner
}

fn getNameOwner(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8) -> void {
    if same(name, bus_module.BUS_NAME) {
        replyString(bus, client, call, bus_module.BUS_NAME)
        return
    }
    const owner = connectionOf(bus, client, call, name)
    if owner != 0 { replyString(bus, client, call, bus_module.uniqueOf(bus_module.clientAt(owner))) }
}

fn listQueued(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8) -> void {
    const record = bus_module.findName(bus, name)
    if record == 0 || !policy.maySeeName(bus, client, name) {
        failed(bus, client, call, "org.freedesktop.DBus.Error.NameHasNoOwner", "The name has no owner")
        return
    }
    const owned = bus_module.nameAt(record)
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    const at = dbus.beginArray(&writing, 4)
    putName(&writing, bus_module.uniqueOf(bus_module.clientAt(owned.*.owner)))
    var index: usize = 0
    while index < owned.*.queued {
        putName(&writing, bus_module.uniqueOf(bus_module.clientAt(owned.*.queue[index])))
        index += 1
    }
    dbus.endArray(&writing, at, 4)
    reply(bus, client, call, "as", &writing)
}

fn credentials(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8) -> void {
    var uid: u32 = 0
    var pid: u32 = 0
    if same(name, bus_module.BUS_NAME) {
        uid = @intCast(u32, std.linux.syscall0(102))
        pid = @intCast(u32, std.linux.syscall0(39))
    } else {
        const owner = connectionOf(bus, client, call, name)
        if owner == 0 { return }
        uid = bus_module.clientAt(owner).*.uid
        pid = bus_module.clientAt(owner).*.pid
    }
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    const at = dbus.beginArray(&writing, 8)
    dbus.pad(&writing, 8)
    dbus.putString(&writing, "UnixUserID")
    dbus.putVariantU32(&writing, uid)
    if pid != 0 {
        dbus.pad(&writing, 8)
        dbus.putString(&writing, "ProcessID")
        dbus.putVariantU32(&writing, pid)
    }
    dbus.endArray(&writing, at, 8)
    reply(bus, client, call, "a{sv}", &writing)
}

fn unixUser(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8, process: bool) -> void {
    if same(name, bus_module.BUS_NAME) {
        replyU32(bus, client, call, @intCast(u32, std.linux.syscall0(if process { 39 } else { 102 })))
        return
    }
    const owner = connectionOf(bus, client, call, name)
    if owner == 0 { return }
    const other = bus_module.clientAt(owner)
    if process && other.*.pid == 0 {
        failed(bus, client, call, "org.freedesktop.DBus.Error.UnixProcessIdUnknown", "The process is not known")
        return
    }
    replyU32(bus, client, call, if process { other.*.pid } else { other.*.uid })
}

fn startService(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, bytes: [*]const u8) -> void {
    if !same(call.*.signature, "su") {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "StartServiceByName takes (su)")
        return
    }
    var reading = dbus.reader(bytes, call.*.bodyLength, call.*.big)
    const name = dbus.readString(&reading)
    if bus_module.resolve(bus, name) != 0 || same(name, bus_module.BUS_NAME) {
        // 2: already running.
        replyU32(bus, client, call, 2)
        return
    }
    if !policy.decide(policy.of(bus), policy.identityOf(client), policy.TALK, name) {
        bus.*.denied += 1
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: this app may not talk to that name (~/.config/mlx/ipc.conf)")
        return
    }
    if !activation.startFor(bus, client, name, call.*.serial) {
        failed(bus, client, call, "org.freedesktop.DBus.Error.ServiceUnknown", "No service file provides the name")
    }
}

fn updateEnvironment(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, bytes: [*]const u8) -> void {
    if !same(call.*.signature, "a{ss}") {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "UpdateActivationEnvironment takes (a{ss})")
        return
    }
    if client.*.identity.sandboxed {
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: sandboxed apps may not change the session's environment")
        return
    }
    var reading = dbus.reader(bytes, call.*.bodyLength, call.*.big)
    const length = @intCast(usize, dbus.readU32(&reading))
    dbus.alignTo(&reading, 8)
    const end = reading.position + length
    while reading.position < end && !reading.failed {
        dbus.alignTo(&reading, 8)
        const key = dbus.readString(&reading)
        const value = dbus.readString(&reading)
        if !reading.failed { activation.setEnvironment(bus, key, value) }
    }
    replyEmpty(bus, client, call)
}

// A literal's bytes (literals end with a NUL).
fn cString(text: []const u8) -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, text) }
}

fn machineId(bus: *state.Bus, client: *state.Client, call: *const dbus.Header) -> void {
    var text: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = policy.readFile(cString("/etc/machine-id"), bytes, 64)
    if length == 0 { length = policy.readFile(cString("/var/lib/dbus/machine-id"), bytes, 64) }
    while length > 0 && (text[length - 1] == 10 || text[length - 1] == 32) { length -= 1 }
    if length == 0 {
        failed(bus, client, call, "org.freedesktop.DBus.Error.FileNotFound", "No machine id")
        return
    }
    replyString(bus, client, call, bytes[0..length])
}

fn becomeMonitor(bus: *state.Bus, client: *state.Client, call: *const dbus.Header) -> void {
    if client.*.identity.sandboxed || !policy.decide(policy.of(bus), policy.identityOf(client), policy.SEE, "*") {
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: this app may not watch the bus")
        return
    }
    replyEmpty(bus, client, call)
    bus_module.becomeMonitor(bus, client)
}

// org.mlx.IPC

fn appId(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8) -> void {
    const owner = connectionOf(bus, client, call, name)
    if owner == 0 { return }
    const other = bus_module.clientAt(owner)
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    dbus.putString(&writing, policy.appOf(policy.identityOf(other)))
    dbus.putBool(&writing, other.*.identity.sandboxed)
    reply(bus, client, call, "sb", &writing)
}

fn listApps(bus: *state.Bus, client: *state.Client, call: *const dbus.Header) -> void {
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    const at = dbus.beginArray(&writing, 8)
    var index: usize = 0
    while index < bus.*.clientCount {
        const other = bus_module.clientAt(bus.*.clients[index])
        if other.*.hello && policy.maySeeName(bus, client, bus_module.uniqueOf(other)) {
            dbus.pad(&writing, 8)
            dbus.putString(&writing, bus_module.uniqueOf(other))
            dbus.putString(&writing, policy.appOf(policy.identityOf(other)))
            dbus.putBool(&writing, other.*.identity.sandboxed)
            dbus.putU32(&writing, other.*.pid)
        }
        index += 1
    }
    dbus.endArray(&writing, at, 8)
    reply(bus, client, call, "a(ssbu)", &writing)
}

// A socket pair: [0] for the caller, [1] for the owner; false when the
// kernel would not make one.
fn socketPair(ends: *[2]isize) -> bool {
    var pair: [8]u8 = undefined
    // AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC.
    const made = std.linux.syscall4(53, 1, 524289, 0, @intFromPtr(&pair))
    if made != 0 { return false }
    unsafe {
        const bytes = @ptrCast([*]const u8, &pair)
        ends.*[0] = @intCast(isize, dbus.load32(bytes, 0, false))
        ends.*[1] = @intCast(isize, dbus.load32(bytes, 4, false))
    }
    return true
}

fn connect(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, name: []const u8) -> void {
    const owner = connectionOf(bus, client, call, name)
    if owner == 0 { return }
    const target = bus_module.clientAt(owner)
    if !policy.mayTalk(bus, client, target) {
        bus.*.denied += 1
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: this app may not talk to that name (~/.config/mlx/ipc.conf)")
        return
    }
    if !client.*.unixFds || !target.*.unixFds {
        failed(bus, client, call, "org.freedesktop.DBus.Error.NotSupported", "Both connections must pass Unix descriptors")
        return
    }
    var ends: [2]isize = [2]isize{ -1, -1 }
    if !socketPair(&ends) {
        failed(bus, client, call, "org.freedesktop.DBus.Error.LimitsExceeded", "No socket pair")
        return
    }
    // The owner's end: Connected(h, s caller, s app).
    var writing: dbus.Writer = undefined
    body(bus, &writing)
    dbus.putU32(&writing, 0)
    dbus.putString(&writing, bus_module.uniqueOf(client))
    dbus.putString(&writing, policy.appOf(policy.identityOf(client)))
    var told = dbus.newHeader(dbus.METHOD_CALL, nextSerial(target))
    told.flags = dbus.NO_REPLY_EXPECTED
    told.path = IPC_PATH
    told.interface = PEER_INTERFACE
    told.member = "Connected"
    told.destination = bus_module.uniqueOf(target)
    told.signature = "hss"
    told.bodyLength = writing.length
    told.unixFds = 1
    var theirs: [1]isize = [1]isize{ ends[1] }
    unsafe { send(bus, target, &told, writing.bytes, @ptrCast([*]const isize, &theirs), 1) }
    // The caller's.
    body(bus, &writing)
    dbus.putU32(&writing, 0)
    var header = dbus.newHeader(dbus.METHOD_RETURN, nextSerial(client))
    header.replySerial = call.*.serial
    header.hasReplySerial = true
    header.destination = bus_module.uniqueOf(client)
    header.signature = "h"
    header.bodyLength = writing.length
    header.unixFds = 1
    var mine: [1]isize = [1]isize{ ends[0] }
    unsafe { send(bus, client, &header, writing.bytes, @ptrCast([*]const isize, &mine), 1) }
    rememberOpener(bus, client)
    bus_module.say(bus, "ipc: a direct channel from ")
    bus_module.say(bus, bus_module.uniqueOf(client))
    bus_module.say(bus, " to ")
    bus_module.say(bus, name)
    bus_module.say(bus, "\n")
}

// Check(s connection, s permission) -> b: whether the app behind
// `connection` (a name it owns, or its unique name) may use `permission`.
// Services ask before they do what the permission names (MLX Audio:
// audio.play, audio.record, audio.monitor); sandboxed apps may not ask.
// When the policy says to ask, the user answers (the reply waits; no
// agent: no).
fn check(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, bytes: [*]const u8) -> void {
    if !same(call.*.signature, "ss") {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "Check takes (ss)")
        return
    }
    if client.*.identity.sandboxed {
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: sandboxed apps may not ask about others")
        return
    }
    var reading = dbus.reader(bytes, call.*.bodyLength, call.*.big)
    const name = dbus.readString(&reading)
    const permission = dbus.readString(&reading)
    const owner = bus_module.resolve(bus, name)
    var identity: *state.Identity = undefined
    if !reading.failed && owner != 0 {
        identity = policy.identityOf(bus_module.clientAt(owner))
    } else {
        const opener = if reading.failed { 0 } else { findOpener(bus, name) }
        if opener == 0 {
            failed(bus, client, call, "org.freedesktop.DBus.Error.NameHasNoOwner", "The name has no owner (and opened no channel)")
            return
        }
        unsafe { identity = @ptrFromInt(*state.Identity, opener) }
    }
    decide(bus, client, call, identity, permission)
}

// CheckProcess(u pid, s permission) -> b: as Check, for the app process
// `pid` is; for services whose apps reach them past the bus (MLX Audio's
// PulseAudio socket: the pid is the socket's peer). Sandboxed apps may
// not ask.
fn checkProcess(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, bytes: [*]const u8) -> void {
    if !same(call.*.signature, "us") {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "CheckProcess takes (us)")
        return
    }
    if client.*.identity.sandboxed {
        failed(bus, client, call, "org.freedesktop.DBus.Error.AccessDenied", "MLXIPC: sandboxed apps may not ask about others")
        return
    }
    var reading = dbus.reader(bytes, call.*.bodyLength, call.*.big)
    const pid = dbus.readU32(&reading)
    const permission = dbus.readString(&reading)
    if reading.failed || pid == 0 {
        failed(bus, client, call, "org.freedesktop.DBus.Error.InvalidArgs", "CheckProcess takes (u pid, s permission)")
        return
    }
    var identity: state.Identity = undefined
    policy.identify(&identity, pid)
    decide(bus, client, call, &identity, permission)
}

// The answer to a Check: the policy's, the session's, or the user's (the
// reply then waits).
fn decide(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, identity: *state.Identity, permission: []const u8) -> void {
    prompts.note(bus, identity, permission)
    var decision = policy.decideUse(policy.of(bus), identity, permission)
    if decision == state.ASK {
        // Asked this session already, or the user is asked now.
        const answer = prompts.sessionAnswer(bus, policy.appOf(identity), permission)
        if answer != policy.NO_RULE {
            decision = answer
        } else if prompts.ask(bus, client, call, identity, permission) {
            return
        } else {
            bus_module.say(bus, "ipc: no permission agent to ask\n")
            decision = state.DENY
        }
    }
    const allowed = decision == state.ALLOW
    if !allowed { bus.*.denied += 1 }
    bus_module.say(bus, "ipc: ")
    bus_module.say(bus, policy.appOf(identity))
    bus_module.say(bus, if allowed { " may use " } else { " may not use " })
    bus_module.say(bus, permission)
    bus_module.say(bus, "\n")
    replyBool(bus, client, call, allowed)
}

// Remembers who opened a channel.
fn rememberOpener(bus: *state.Bus, client: *state.Client) -> void {
    const slot = bus.*.nextOpener % 256
    bus.*.nextOpener += 1
    if bus.*.openerCount < 256 { bus.*.openerCount += 1 }
    const unique = bus_module.uniqueOf(client)
    var index: usize = 0
    while index < unique.length && index < 32 {
        bus.*.openers[slot].unique[index] = unique[index]
        index += 1
    }
    bus.*.openers[slot].uniqueLength = index
    const source = policy.identityOf(client)
    bus.*.openers[slot].identity.pid = source.*.pid
    bus.*.openers[slot].identity.sandboxed = source.*.sandboxed
    bus.*.openers[slot].identity.appLength = source.*.appLength
    index = 0
    while index < source.*.appLength {
        bus.*.openers[slot].identity.app[index] = source.*.app[index]
        index += 1
    }
}

// The identity of the opener `unique` (its address), 0 when none.
fn findOpener(bus: *state.Bus, unique: []const u8) -> usize {
    var slot: usize = 0
    while slot < bus.*.openerCount {
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrCast([*]const u8, &bus.*.openers[slot].unique) }
        if same(bytes[0..bus.*.openers[slot].uniqueLength], unique) {
            var identity: usize = 0
            unsafe { identity = @intFromPtr(&bus.*.openers[slot].identity) }
            return identity
        }
        slot += 1
    }
    return 0
}

// A call to the bus (destination org.freedesktop.DBus, or org.mlx.IPC).
pub fn handle(bus: *state.Bus, client: *state.Client, call: *const dbus.Header, bytes: [*]const u8) -> void {
    // A reply to a call of the bus's own (the permission agent's answer).
    if call.*.kind == dbus.METHOD_RETURN || call.*.kind == dbus.ERROR {
        prompts.answered(bus, client, call, bytes)
        return
    }
    if call.*.kind != dbus.METHOD_CALL { return }
    const member = call.*.member
    const interface = call.*.interface
    if same(member, "Hello") {
        hello(bus, client, call)
    } else if same(interface, "org.freedesktop.DBus.Peer") || ((interface.length == 0) && (same(member, "Ping") || same(member, "GetMachineId"))) {
        if same(member, "Ping") { replyEmpty(bus, client, call) } else if same(member, "GetMachineId") { machineId(bus, client, call) } else { failed(bus, client, call, "org.freedesktop.DBus.Error.UnknownMethod", "No such method") }
    } else if same(member, "Introspect") {
        replyString(bus, client, call, INTROSPECTION)
    } else if same(interface, IPC_NAME) || same(call.*.destination, IPC_NAME) {
        if same(member, "GetAppId") {
            if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            appId(bus, client, call, text) }
        } else if same(member, "ListApps") {
            listApps(bus, client, call)
        } else if same(member, "Connect") {
            if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            connect(bus, client, call, text) }
        } else if same(member, "Check") {
            check(bus, client, call, bytes)
        } else if same(member, "CheckProcess") {
            checkProcess(bus, client, call, bytes)
        } else if same(member, "ListPermissions") {
            prompts.list(bus, client, call)
        } else if same(member, "SetPermission") {
            prompts.set(bus, client, call, bytes)
        } else if same(member, "Reload") {
            policy.reload(policy.of(bus), bus)
            replyEmpty(bus, client, call)
        } else {
            failed(bus, client, call, "org.freedesktop.DBus.Error.UnknownMethod", "No such method")
        }
    } else if same(member, "RequestName") {
        requestName(bus, client, call, bytes)
    } else if same(member, "ReleaseName") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            replyU32(bus, client, call, bus_module.releaseName(bus, client, text)) }
    } else if same(member, "ListNames") {
        listNames(bus, client, call)
    } else if same(member, "ListActivatableNames") {
        listActivatable(bus, client, call)
    } else if same(member, "NameHasOwner") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            replyBool(bus, client, call, same(text, bus_module.BUS_NAME) || (bus_module.resolve(bus, text) != 0 && policy.maySeeName(bus, client, text))) }
    } else if same(member, "GetNameOwner") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            getNameOwner(bus, client, call, text) }
    } else if same(member, "ListQueuedOwners") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            listQueued(bus, client, call, text) }
    } else if same(member, "AddMatch") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
           
            if bus_module.addMatch(bus, client, text) { replyEmpty(bus, client, call) } else { failed(bus, client, call, "org.freedesktop.DBus.Error.MatchRuleInvalid", "The match rule is not valid") }
        }
    } else if same(member, "RemoveMatch") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
           
            if bus_module.removeMatch(bus, client, text) { replyEmpty(bus, client, call) } else { failed(bus, client, call, "org.freedesktop.DBus.Error.MatchRuleNotFound", "No such match rule") }
        }
    } else if same(member, "GetConnectionUnixUser") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            unixUser(bus, client, call, text, false) }
    } else if same(member, "GetConnectionUnixProcessID") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            unixUser(bus, client, call, text, true) }
    } else if same(member, "GetConnectionCredentials") {
        if takes(bus, client, call, bytes, "s") {
            const text = firstString(call, bytes)
            credentials(bus, client, call, text) }
    } else if same(member, "GetId") {
        var bytes_of_guid: [*]const u8 = undefined
        unsafe { bytes_of_guid = @ptrCast([*]const u8, &bus.*.guid) }
        replyString(bus, client, call, bytes_of_guid[0..32])
    } else if same(member, "StartServiceByName") {
        startService(bus, client, call, bytes)
    } else if same(member, "UpdateActivationEnvironment") {
        updateEnvironment(bus, client, call, bytes)
    } else if same(member, "ReloadConfig") {
        policy.reload(policy.of(bus), bus)
        replyEmpty(bus, client, call)
    } else if same(member, "BecomeMonitor") {
        becomeMonitor(bus, client, call)
    } else if same(member, "GetAdtAuditSessionData") || same(member, "GetConnectionSELinuxSecurityContext") {
        failed(bus, client, call, "org.freedesktop.DBus.Error.NotSupported", "Not on this bus")
    } else {
        failed(bus, client, call, "org.freedesktop.DBus.Error.UnknownMethod", "No such method on org.freedesktop.DBus")
    }
}
