// mlx-ipc: MLXIPC from the command line, on std.dbus's client (no libc, no
// libdbus).
//
//   mlx-ipc apps               the connections: unique name, app, sandboxed,
//                              process
//   mlx-ipc names              the names on the bus
//   mlx-ipc reload             the bus reads its policy again
//   mlx-ipc serve NAME         owns NAME and answers org.mlx.Echo.Echo(s) with
//                              the same string; a direct channel to it
//                              (org.mlx.IPC.Connect) gets "hello from NAME"
//   mlx-ipc call NAME TEXT     calls NAME's org.mlx.Echo.Echo(TEXT)
//   mlx-ipc connect NAME       opens a direct channel to NAME and prints what
//                              comes through it
//
// It says what the bus answered, or the error it gave (and fails).
const std = @import("std")
const dbus = @import("std.dbus")
const crash = @import("std.crash")

const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const IPC: []const u8 = "org.mlx.IPC"
const IPC_PATH: []const u8 = "/org/mlx/IPC"
const ECHO: []const u8 = "org.mlx.Echo"

const Failure = error { Usage, NoBus, Refused, Lost }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    const said = std.io.eprintln(message)
    return failure
}

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn nothing() -> [*]const isize {
    var none: [1]isize = [1]isize{ 0 }
    unsafe { return @ptrCast([*]const isize, &none) }
}

fn noBody() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "") }
}

// The reply to `serial`; an error is said ("org...Error.X: message") and
// fails.
fn awaitReply(client: *dbus.Client, serial: u32, reply: *dbus.Header) -> !void {
    if serial == 0 || !dbus.waitReply(client, serial, reply, 25000) { return fail("mlx-ipc: no reply from the bus", Failure.Lost) }
    if reply.*.kind == dbus.ERROR {
        const said = std.io.writeAll(std.io.stderr(), reply.*.errorName)
        if reply.*.signature.length > 0 && reply.*.signature[0] == 115 {
            var reading = dbus.reader(dbus.bodyOf(client, reply), reply.*.bodyLength, reply.*.big)
            const comma = std.io.writeAll(std.io.stderr(), ": ")
            const shown = std.io.writeAll(std.io.stderr(), dbus.readString(&reading))
        }
        return fail("", Failure.Refused)
    }
}

// Builds a body of one string into `memory`.
fn stringBody(memory: [*]u8, text: []const u8) -> usize {
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, memory, 4096, false)
    dbus.putString(&writing, text)
    return writing.length
}

fn apps(client: *dbus.Client) -> !void {
    var reply: dbus.Header = undefined
    try awaitReply(client, dbus.call(client, BUS, IPC_PATH, IPC, "ListApps", "", noBody(), 0), &reply)
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    const length = @intCast(usize, dbus.readU32(&reading))
    dbus.alignTo(&reading, 8)
    const end = reading.position + length
    while reading.position < end && !reading.failed {
        dbus.alignTo(&reading, 8)
        const unique = dbus.readString(&reading)
        const app = dbus.readString(&reading)
        const sandboxed = dbus.readBool(&reading)
        const pid = dbus.readU32(&reading)
        say(unique)
        say("  ")
        say(app)
        say(if sandboxed { "  sandboxed  " } else { "  " })
        const shown = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, pid))
        say("\n")
    }
}

fn names(client: *dbus.Client) -> !void {
    var reply: dbus.Header = undefined
    try awaitReply(client, dbus.call(client, BUS, BUS_PATH, BUS, "ListNames", "", noBody(), 0), &reply)
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    const length = @intCast(usize, dbus.readU32(&reading))
    const end = reading.position + length
    while reading.position < end && !reading.failed {
        say(dbus.readString(&reading))
        say("\n")
    }
}

fn reload(client: *dbus.Client) -> !void {
    var reply: dbus.Header = undefined
    try awaitReply(client, dbus.call(client, BUS, IPC_PATH, IPC, "Reload", "", noBody(), 0), &reply)
    say("the policy was read again\n")
}

fn serve(client: *dbus.Client, name: []const u8) -> !void {
    var memory: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &memory) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 4096, false)
    dbus.putString(&writing, name)
    // DO_NOT_QUEUE.
    dbus.putU32(&writing, 4)
    var reply: dbus.Header = undefined
    try awaitReply(client, dbus.call(client, BUS, BUS_PATH, BUS, "RequestName", "su", bytes, writing.length), &reply)
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    if dbus.readU32(&reading) != 1 { return fail("mlx-ipc: the name has another owner", Failure.Refused) }
    say("serving ")
    say(name)
    say(" as ")
    say(dbus.uniqueName(client))
    say("\n")
    var message: dbus.Header = undefined
    while dbus.next(client, &message, -1) {
        if message.kind == dbus.METHOD_CALL && same(message.member, "Echo") && same(message.signature, "s") {
            var arguments = dbus.reader(dbus.bodyOf(client, &message), message.bodyLength, message.big)
            const text = dbus.readString(&arguments)
            const length = stringBody(bytes, text)
            const sent = dbus.reply(client, &message, "s", bytes, length, nothing(), 0)
        } else if message.kind == dbus.METHOD_CALL && same(message.member, "Connected") {
            // A direct channel: a greeting through it, then it closes.
            const channel = dbus.descriptorOf(client, 0)
            if channel >= 0 {
                var greeting: [300]u8 = undefined
                var at: usize = 0
                const words = "hello from "
                while at < words.length {
                    greeting[at] = words[at]
                    at += 1
                }
                var index: usize = 0
                while index < name.length && at < 298 {
                    greeting[at] = name[index]
                    at += 1
                    index += 1
                }
                greeting[at] = 10
                at += 1
                const written = std.linux.syscall3(1, @bitCast(usize, channel), @intFromPtr(&greeting), at)
                dbus.closeDescriptor(channel)
            }
        } else if message.kind == dbus.METHOD_CALL && message.flags & dbus.NO_REPLY_EXPECTED == 0 {
            var error_header = dbus.newHeader(dbus.ERROR, 0)
            error_header.errorName = "org.freedesktop.DBus.Error.UnknownMethod"
            error_header.replySerial = message.serial
            error_header.hasReplySerial = true
            error_header.destination = message.sender
            error_header.signature = "s"
            const length = stringBody(bytes, "mlx-ipc serve answers org.mlx.Echo.Echo(s)")
            const sent = dbus.send(client, &error_header, bytes, length, nothing(), 0)
        }
    }
}

fn echo(client: *dbus.Client, name: []const u8, text: []const u8) -> !void {
    var memory: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &memory) }
    const length = stringBody(bytes, text)
    var reply: dbus.Header = undefined
    try awaitReply(client, dbus.call(client, name, "/", ECHO, "Echo", "s", bytes, length), &reply)
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    say(dbus.readString(&reading))
    say("\n")
}

fn connect(client: *dbus.Client, name: []const u8) -> !void {
    var memory: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &memory) }
    const length = stringBody(bytes, name)
    var reply: dbus.Header = undefined
    try awaitReply(client, dbus.call(client, BUS, IPC_PATH, IPC, "Connect", "s", bytes, length), &reply)
    const channel = dbus.descriptorOf(client, 0)
    if channel < 0 { return fail("mlx-ipc: the bus sent no channel", Failure.Lost) }
    // What comes through, until the other side closes.
    var buffer: [4096]u8 = undefined
    while true {
        const got = std.linux.syscall3(0, @bitCast(usize, channel), @intFromPtr(&buffer), 4096)
        if got <= 0 { break }
        var shown: [*]const u8 = undefined
        unsafe { shown = @ptrCast([*]const u8, &buffer) }
        say(shown[0..@intCast(usize, got)])
    }
    dbus.closeDescriptor(channel)
}

pub fn main(arguments: [][*]const u8) -> !void {
    const installed = crash.install()
    const count = std.process.count(arguments)
    if count < 2 {
        const said = std.io.writeAll(std.io.stderr(), "usage: mlx-ipc apps | names | reload | serve NAME | call NAME TEXT | connect NAME")
        return fail("", Failure.Usage)
    }
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    var client: *dbus.Client = undefined
    unsafe { client = @ptrCast(*dbus.Client, memory.?) }
    if !dbus.connectSession(client, allocator, std.process.environmentEntries(arguments)) { return fail("mlx-ipc: no session bus (DBUS_SESSION_BUS_ADDRESS)", Failure.NoBus) }
    const command = std.process.argument(arguments, 1)
    if named(command, "apps") {
        try apps(client)
    } else if named(command, "names") {
        try names(client)
    } else if named(command, "reload") {
        try reload(client)
    } else if named(command, "serve") && count > 2 {
        try serve(client, std.string.asSlice(std.process.argument(arguments, 2)))
    } else if named(command, "call") && count > 3 {
        try echo(client, std.string.asSlice(std.process.argument(arguments, 2)), std.string.asSlice(std.process.argument(arguments, 3)))
    } else if named(command, "connect") && count > 2 {
        try connect(client, std.string.asSlice(std.process.argument(arguments, 2)))
    } else {
        return fail("usage: mlx-ipc apps | names | reload | serve NAME | call NAME TEXT | connect NAME", Failure.Usage)
    }
}
