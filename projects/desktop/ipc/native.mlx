// mlx-ipc --native: mlx-ipc's commands on MLXIPC's native wire format
// (std.ipc) instead of D-Bus. The bus carries either to the other, so a
// name served here answers dbus-send as it answers `mlx-ipc --native
// call`, and a direct channel between two native programs carries
// native messages with no bus between.
//
//   mlx-ipc --native names             the names on the bus
//   mlx-ipc --native apps              the connections
//   mlx-ipc --native protocol NAME     what NAME's owner speaks: mlx or dbus
//   mlx-ipc --native serve NAME        owns NAME, answers org.mlx.Echo.Echo(s);
//                                      a direct channel to it gets a native
//                                      signal org.mlx.Echo.Hello(s)
//   mlx-ipc --native call NAME TEXT    calls NAME's org.mlx.Echo.Echo(TEXT)
//   mlx-ipc --native connect NAME      a direct channel to NAME; prints the
//                                      string of the first native message
//                                      that comes through it
//   mlx-ipc --native emit TEXT         sends the signal org.mlx.Echo.Said(TEXT)
//   mlx-ipc --native bench NAME COUNT [BYTES]
//                                      COUNT Echo calls to NAME, one after the
//                                      other, each of a string of BYTES (5);
//                                      says how long one took
//   mlx-ipc --native chbench NAME COUNT [BYTES]
//                                      the same over a direct channel to NAME
//                                      (org.mlx.IPC.Connect): no bus between
const std = @import("std")
const ipc = @import("std.ipc")
const turns_module = @import("std.turns")

const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const IPC: []const u8 = "org.mlx.IPC"
const IPC_PATH: []const u8 = "/org/mlx/IPC"
const ECHO: []const u8 = "org.mlx.Echo"
const USAGE: []const u8 = "usage: mlx-ipc --native names | apps | protocol NAME | serve NAME | call NAME TEXT | connect NAME | emit TEXT | bench NAME COUNT | chbench NAME COUNT"

pub const Failure = error { Usage, NoBus, Refused, Lost }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    _ = std.io.eprintln(message)
    return failure
}

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn same(first: []const u8, second: []const u8) -> bool { return ipc.same(first, second) }

fn nothing() -> [*]const isize {
    var none: [1]isize = [1]isize{ 0 }
    return &none
}

fn noBody() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "") }
}

// The reply to `serial`; an error is said ("org...Error.X: message") and
// fails.
fn awaitReply(client: *ipc.Client, serial: u32, reply: *ipc.Message) -> !void {
    if serial == 0 || !ipc.waitReply(client, serial, reply, 25000) { return fail("mlx-ipc: no reply from the bus", Failure.Lost) }
    if reply.*.kind == ipc.ERROR {
        _ = std.io.writeAll(std.io.stderr(), reply.*.errorName)
        if same(reply.*.signature, "s") {
            var reading = ipc.reader(ipc.bodyOf(client, reply), reply.*.bodyLength)
            _ = std.io.writeAll(std.io.stderr(), ": ")
            _ = std.io.writeAll(std.io.stderr(), ipc.readString(&reading))
        }
        return fail("", Failure.Refused)
    }
}

// Builds a body of one string into `memory` (BODY bytes of room).
const BODY: usize = 65536

fn stringBody(memory: [*]u8, text: []const u8) -> usize {
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, memory, BODY)
    ipc.putString(&writing, text)
    if writing.failed { return 0 }
    return writing.length
}

fn names(client: *ipc.Client) -> !void {
    var reply: ipc.Message = undefined
    try awaitReply(client, ipc.call(client, BUS, BUS_PATH, BUS, "ListNames", "", noBody(), 0), &reply)
    var reading = ipc.reader(ipc.bodyOf(client, &reply), reply.bodyLength)
    var count = ipc.readArray(&reading)
    while count > 0 && !reading.failed {
        say(ipc.readString(&reading))
        say("\n")
        count -= 1
    }
}

fn apps(client: *ipc.Client) -> !void {
    var reply: ipc.Message = undefined
    try awaitReply(client, ipc.call(client, BUS, IPC_PATH, IPC, "ListApps", "", noBody(), 0), &reply)
    var reading = ipc.reader(ipc.bodyOf(client, &reply), reply.bodyLength)
    var count = ipc.readArray(&reading)
    while count > 0 && !reading.failed {
        const unique = ipc.readString(&reading)
        const app = ipc.readString(&reading)
        const sandboxed = ipc.readBool(&reading)
        const pid = ipc.readU32(&reading)
        say(unique)
        say("  ")
        say(app)
        say(if sandboxed { "  sandboxed  " } else { "  " })
        _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, pid))
        say("\n")
        count -= 1
    }
}

fn protocol(client: *ipc.Client, name: []const u8) -> !void {
    var memory: [4096]u8 = undefined
    const bytes: [*]u8 = &memory
    const length = stringBody(bytes, name)
    var reply: ipc.Message = undefined
    try awaitReply(client, ipc.call(client, BUS, IPC_PATH, IPC, "GetProtocol", "s", bytes, length), &reply)
    var reading = ipc.reader(ipc.bodyOf(client, &reply), reply.bodyLength)
    say(name)
    say(": ")
    say(ipc.readString(&reading))
    say("\n")
}

fn echo(client: *ipc.Client, name: []const u8, text: []const u8) -> !void {
    var memory: [4096]u8 = undefined
    const bytes: [*]u8 = &memory
    const length = stringBody(bytes, text)
    var reply: ipc.Message = undefined
    try awaitReply(client, ipc.call(client, name, "/", ECHO, "Echo", "s", bytes, length), &reply)
    var reading = ipc.reader(ipc.bodyOf(client, &reply), reply.bodyLength)
    say(ipc.readString(&reading))
    say("\n")
}

// COUNT round trips to NAME's Echo, one after the other: the time one
// took (microseconds, with two decimals).
fn bench(client: *ipc.Client, name: []const u8, count: usize, size: usize) -> !void {
    var memory: [65536]u8 = undefined
    const bytes: [*]u8 = &memory
    const length = payload(bytes, size)
    var reply: ipc.Message = undefined
    // A loop of thousands of turns releases each turn's values
    // (std.turns), as every event loop here does.
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    const started = std.time.monotonicNanoseconds()
    var done: usize = 0
    while done < count {
        turns_module.turn(&turns)
        try awaitReply(client, ipc.call(client, name, "/", ECHO, "Echo", "s", bytes, length), &reply)
        done += 1
    }
    const took = std.time.monotonicNanoseconds() - started
    sayTiming(count, took)
}

// A body of one string of `size` letters (at most 60000) in `memory`.
pub fn payload(memory: [*]u8, size: usize) -> usize {
    var text: [60000]u8 = undefined
    const wanted = if size > 60000 { 60000 } else { size }
    var index: usize = 0
    while index < wanted {
        text[index] = 97 + @intCast(u8, index % 26)
        index += 1
    }
    const text_bytes: [*]const u8 = &text
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, memory, 65536)
    ipc.putString(&writing, text_bytes[0..wanted])
    return writing.length
}

pub fn sayTiming(count: usize, nanoseconds: usize) -> void {
    _ = std.io.writeUnsigned(std.io.stdout(), count)
    say(" round trips in ")
    _ = std.io.writeUnsigned(std.io.stdout(), nanoseconds / 1000000)
    say(" ms: ")
    const hundredths = nanoseconds / 10 / count
    _ = std.io.writeUnsigned(std.io.stdout(), hundredths / 100)
    say(".")
    if hundredths % 100 < 10 { say("0") }
    _ = std.io.writeUnsigned(std.io.stdout(), hundredths % 100)
    say(" us each\n")
}

fn emit(client: *ipc.Client, text: []const u8) -> !void {
    var memory: [4096]u8 = undefined
    const bytes: [*]u8 = &memory
    const length = stringBody(bytes, text)
    if ipc.signal(client, "/", ECHO, "Said", "s", bytes, length) == 0 { return fail("mlx-ipc: the signal was not sent", Failure.Lost) }
    say("sent org.mlx.Echo.Said\n")
}

// A greeting through a direct channel (a native signal), then Echo calls
// answered over it until the peer closes it.
fn greet(allocator: std.allocator.Allocator, channel: isize, name: []const u8) -> void {
    var peer: ipc.Client = undefined
    if !ipc.attach(&peer, allocator, channel) {
        ipc.closeDescriptor(channel)
        return
    }
    var greeting: [65536]u8 = undefined
    const bytes: [*]u8 = &greeting
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, bytes, BODY)
    var text: [300]u8 = undefined
    var at: usize = 0
    const words = "hello from "
    while at < words.length {
        text[at] = words[at]
        at += 1
    }
    var index: usize = 0
    while index < name.length && at < 290 {
        text[at] = name[index]
        at += 1
        index += 1
    }
    const tail = " (mlx)"
    index = 0
    while index < tail.length {
        text[at] = tail[index]
        at += 1
        index += 1
    }
    const text_bytes: [*]const u8 = &text
    ipc.putString(&writing, text_bytes[0..at])
    _ = ipc.signal(&peer, "/", ECHO, "Hello", "s", bytes, writing.length)
    var message: ipc.Message = undefined
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    while ipc.next(&peer, &message, -1) {
        turns_module.turn(&turns)
        if message.kind == ipc.CALL && same(message.member, "Echo") && same(message.signature, "s") {
            var arguments = ipc.reader(ipc.bodyOf(&peer, &message), message.bodyLength)
            const echoed = ipc.readString(&arguments)
            const length = stringBody(bytes, echoed)
            _ = ipc.reply(&peer, &message, "s", bytes, length, nothing(), 0)
        } else if message.kind == ipc.CALL && message.flags & ipc.NO_REPLY_EXPECTED == 0 {
            _ = ipc.replyError(&peer, &message, "org.freedesktop.DBus.Error.UnknownMethod", "the channel answers org.mlx.Echo.Echo(s)")
        }
    }
    ipc.disconnect(&peer, allocator)
}

// A direct channel to NAME, then COUNT Echo round trips over it.
fn channelBench(client: *ipc.Client, allocator: std.allocator.Allocator, name: []const u8, count: usize, size: usize) -> !void {
    var memory: [65536]u8 = undefined
    const bytes: [*]u8 = &memory
    var length = stringBody(bytes, name)
    var reply: ipc.Message = undefined
    try awaitReply(client, ipc.call(client, BUS, IPC_PATH, IPC, "Connect", "s", bytes, length), &reply)
    const channel = ipc.descriptorOf(client, 0)
    if channel < 0 { return fail("mlx-ipc: the bus sent no channel", Failure.Lost) }
    var peer: ipc.Client = undefined
    if !ipc.attach(&peer, allocator, channel) {
        ipc.closeDescriptor(channel)
        return fail("mlx-ipc: no memory for the channel", Failure.Lost)
    }
    // The greeting first.
    var message: ipc.Message = undefined
    if !ipc.next(&peer, &message, 5000) { return fail("mlx-ipc: no greeting through the channel", Failure.Lost) }
    length = payload(bytes, size)
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    const started = std.time.monotonicNanoseconds()
    var done: usize = 0
    while done < count {
        turns_module.turn(&turns)
        try awaitReply(&peer, ipc.call(&peer, "", "/", ECHO, "Echo", "s", bytes, length), &message)
        done += 1
    }
    sayTiming(count, std.time.monotonicNanoseconds() - started)
    ipc.disconnect(&peer, allocator)
}

fn serve(client: *ipc.Client, allocator: std.allocator.Allocator, name: []const u8) -> !void {
    var memory: [65536]u8 = undefined
    const bytes: [*]u8 = &memory
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, bytes, BODY)
    ipc.putString(&writing, name)
    // DO_NOT_QUEUE.
    ipc.putU32(&writing, 4)
    var reply: ipc.Message = undefined
    try awaitReply(client, ipc.call(client, BUS, BUS_PATH, BUS, "RequestName", "su", bytes, writing.length), &reply)
    var reading = ipc.reader(ipc.bodyOf(client, &reply), reply.bodyLength)
    if ipc.readU32(&reading) != 1 { return fail("mlx-ipc: the name has another owner", Failure.Refused) }
    say("serving ")
    say(name)
    say(" as ")
    say(ipc.uniqueName(client))
    say(" (mlx)\n")
    var message: ipc.Message = undefined
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    while ipc.next(client, &message, -1) {
        turns_module.turn(&turns)
        if message.kind == ipc.CALL && same(message.member, "Echo") && same(message.signature, "s") {
            var arguments = ipc.reader(ipc.bodyOf(client, &message), message.bodyLength)
            const text = ipc.readString(&arguments)
            const length = stringBody(bytes, text)
            _ = ipc.reply(client, &message, "s", bytes, length, nothing(), 0)
        } else if message.kind == ipc.CALL && same(message.member, "Connected") {
            const channel = ipc.descriptorOf(client, 0)
            if channel >= 0 { greet(allocator, channel, name) }
        } else if message.kind == ipc.CALL && message.flags & ipc.NO_REPLY_EXPECTED == 0 {
            _ = ipc.replyError(client, &message, "org.freedesktop.DBus.Error.UnknownMethod", "mlx-ipc --native serve answers org.mlx.Echo.Echo(s)")
        }
    }
}

fn connect(client: *ipc.Client, allocator: std.allocator.Allocator, name: []const u8) -> !void {
    var memory: [4096]u8 = undefined
    const bytes: [*]u8 = &memory
    const length = stringBody(bytes, name)
    var reply: ipc.Message = undefined
    try awaitReply(client, ipc.call(client, BUS, IPC_PATH, IPC, "Connect", "s", bytes, length), &reply)
    const channel = ipc.descriptorOf(client, 0)
    if channel < 0 { return fail("mlx-ipc: the bus sent no channel", Failure.Lost) }
    var peer: ipc.Client = undefined
    if !ipc.attach(&peer, allocator, channel) {
        ipc.closeDescriptor(channel)
        return fail("mlx-ipc: no memory for the channel", Failure.Lost)
    }
    var message: ipc.Message = undefined
    const came = ipc.next(&peer, &message, 5000)
    if came && same(message.signature, "s") {
        var reading = ipc.reader(ipc.bodyOf(&peer, &message), message.bodyLength)
        say(message.interface)
        say(".")
        say(message.member)
        say(": ")
        say(ipc.readString(&reading))
        say("\n")
    }
    ipc.disconnect(&peer, allocator)
    if !came { return fail("mlx-ipc: nothing came through the channel", Failure.Lost) }
}

// The commands, from argument `first` on.
pub fn run(arguments: [][*]const u8, allocator: std.allocator.Allocator, first: usize) -> !void {
    const count = std.process.count(arguments)
    if count <= first { return fail(USAGE, Failure.Usage) }
    const memory = allocator.alloc(@sizeOf(ipc.Client), 16)
    if memory == null { return fail("mlx-ipc: out of memory", Failure.Lost) }
    const client: *ipc.Client = unsafe { @ptrCast(*ipc.Client, memory.?) }
    if !ipc.connectSession(client, allocator, std.process.environmentEntries(arguments)) { return fail("mlx-ipc: no session bus (DBUS_SESSION_BUS_ADDRESS)", Failure.NoBus) }
    const command = std.process.argument(arguments, first)
    if named(command, "names") {
        try names(client)
    } else if named(command, "apps") {
        try apps(client)
    } else if named(command, "protocol") && count > first + 1 {
        try protocol(client, std.string.asSlice(std.process.argument(arguments, first + 1)))
    } else if named(command, "serve") && count > first + 1 {
        try serve(client, allocator, std.string.asSlice(std.process.argument(arguments, first + 1)))
    } else if named(command, "call") && count > first + 2 {
        try echo(client, std.string.asSlice(std.process.argument(arguments, first + 1)), std.string.asSlice(std.process.argument(arguments, first + 2)))
    } else if named(command, "connect") && count > first + 1 {
        try connect(client, allocator, std.string.asSlice(std.process.argument(arguments, first + 1)))
    } else if named(command, "emit") && count > first + 1 {
        try emit(client, std.string.asSlice(std.process.argument(arguments, first + 1)))
    } else if named(command, "chbench") && count > first + 2 {
        const rounds = std.parse.unsigned(std.process.argument(arguments, first + 2))
        const size = if count > first + 3 { std.parse.unsigned(std.process.argument(arguments, first + 3)).value } else { 5 }
        if !rounds.valid { return fail(USAGE, Failure.Usage) }
        try channelBench(client, allocator, std.string.asSlice(std.process.argument(arguments, first + 1)), rounds.value, size)
    } else if named(command, "bench") && count > first + 2 {
        const rounds = std.parse.unsigned(std.process.argument(arguments, first + 2))
        const size = if count > first + 3 { std.parse.unsigned(std.process.argument(arguments, first + 3)).value } else { 5 }
        if !rounds.valid { return fail(USAGE, Failure.Usage) }
        try bench(client, std.string.asSlice(std.process.argument(arguments, first + 1)), rounds.value, size)
    } else {
        return fail(USAGE, Failure.Usage)
    }
}
