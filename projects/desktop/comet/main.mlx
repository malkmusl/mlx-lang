// comet: the desktop's text editor. Its text is MLX Observatory's editor
// (projects/desktop/shared/editor.mlx: the cursor and the selection,
// undo and redo, the clipboard, Mlx's tokens), here without the code map:
// a window of the desktop's glass with the open documents on the left
// (New and Open above them; a dot: not saved), the text in a card set
// into it, a line of the prism along its top, the line numbers, the
// tokens in the colours of the wallpaper's prism (std.ui.scheme), and a
// status line (where the cursor is, what the text is).
//
// Open (Ctrl+O) is std.ui.chooser in the window; Save (Ctrl+S) writes
// the file, and a text not yet a file asks where (a path field: Enter
// saves, Escape leaves it; Ctrl+Shift+S always asks). Find (Ctrl+F) is a
// field in the header: Enter goes to the next place, Shift+Enter to the
// one before. The keys: the arrows (Ctrl: by word; Shift: selecting),
// Home and End, Page Up and Down, Ctrl+Home and Ctrl+End, Backspace and
// Delete, Enter (keeping the indentation), Tab, Ctrl+Z and Ctrl+Y (or
// Ctrl+Shift+Z), Ctrl+X, C, V and A, Ctrl+N, Ctrl+W (close; a text not
// saved asks a second time). The mouse places the cursor, a drag selects,
// a double click takes a word, the wheel scrolls.
//
//     comet [FILE...]
const std = @import("std")
const crash = @import("std.crash")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const theme_module = @import("std.ui.theme")
const scheme_module = @import("std.ui.scheme")
const controls = @import("std.ui.controls")
const sidebar_module = @import("std.ui.sidebar")
const host_module = @import("std.ui.host")
const chooser_module = @import("std.ui.chooser")
const field_module = @import("std.ui.field")
const glyphs = @import("std.ui.glyphs")
const lists = @import("std.ui.lists")
const keys = @import("std.ui.keys")
const clock = @import("../shared/clock.mlx")
const editor_module = @import("../shared/editor.mlx")

const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Host = host_module.Host
const Editor = editor_module.Editor

// Documents open at once, and how large each may be.
const DOCUMENTS: usize = 8
const DOCUMENT_SIZE: usize = 4194304
// Logical pixels.
const SIDEBAR: i32 = 200
const HEADER: i32 = 44
const STATUS: i32 = 26
const LINE: i32 = 20
const PAD: i32 = 16

// The kinds of text (how it is coloured).
const PLAIN_TEXT: u8 = 0
const CODE: u8 = 1
const HASH_COMMENTS: u8 = 2
const MARKDOWN: u8 = 3

// What the header's field is for.
const ASK_NONE: u8 = 0
const ASK_FIND: u8 = 1
const ASK_SAVE: u8 = 2

// Widget ids.
const ID_NEW: usize = 1
const ID_OPEN: usize = 2
const ID_SAVE: usize = 3
const ID_FIND: usize = 4
const ID_FIELD: usize = 5
const ID_TEXT: usize = 6
const ID_DOCUMENT: usize = 100
const ID_CLOSE: usize = 200

const Document = struct {
    editor: Editor
    // The first column shown (scrolled sideways).
    left: usize
    kind: u8
    // A close asked while not saved: the next one closes.
    closing: bool
}

const Comet = struct {
    host: *Host
    ready: bool
    german: bool
    scale: i32
    fontScale: i32
    title: Text
    body: Text
    small: Text
    mono: Text
    ui: view.Ui
    theme: theme_module.Theme
    documents: [8]Document
    count: usize
    current: usize
    // A character's width and the text area as last drawn.
    charWidth: i32
    textLeft: i32
    textTop: i32
    textRight: i32
    textBottom: i32
    rows: usize
    // The mouse: selecting by a drag, and the last press (a double click).
    dragging: bool
    lastPress: usize
    lastOffset: usize
    // Open: the chooser over the card.
    choosing: bool
    chooser: chooser_module.Chooser
    // The header's field: finding, or where to save.
    asking: u8
    field: field_module.Field
    // What the status line says for a while (0: nothing).
    note: [160]u8
    noteLength: usize
    noteDanger: bool
}

fn titleOf(c: *Comet) -> *Text { unsafe { return @ptrCast(*Text, &c.*.title) } }
fn bodyOf(c: *Comet) -> *Text { unsafe { return @ptrCast(*Text, &c.*.body) } }
fn smallOf(c: *Comet) -> *Text { unsafe { return @ptrCast(*Text, &c.*.small) } }
fn monoOf(c: *Comet) -> *Text { unsafe { return @ptrCast(*Text, &c.*.mono) } }
fn uiOf(c: *Comet) -> *view.Ui { unsafe { return @ptrCast(*view.Ui, &c.*.ui) } }
fn themeOf(c: *Comet) -> *theme_module.Theme { unsafe { return @ptrCast(*theme_module.Theme, &c.*.theme) } }
fn chooserOf(c: *Comet) -> *chooser_module.Chooser { unsafe { return @ptrCast(*chooser_module.Chooser, &c.*.chooser) } }
fn fieldOf(c: *Comet) -> *field_module.Field { unsafe { return @ptrCast(*field_module.Field, &c.*.field) } }
fn stateOf(context: *anyopaque) -> *Comet { unsafe { return @ptrCast(*Comet, context) } }

fn idOf(item: usize) -> u64 { return @intCast(u64, item) + 1 }
fn px(c: *Comet, value: i32) -> i32 { return value * c.*.scale }
fn tr(c: *Comet, english: []const u8, german: []const u8) -> []const u8 { return if c.*.german { german } else { english } }
fn redraw(c: *Comet) -> void { host_module.redraw(c.*.host) }

fn documentAt(c: *Comet, index: usize) -> *Document { return &c.*.documents[index] }
fn editorAt(c: *Comet, index: usize) -> *Editor { return &c.*.documents[index].editor }
fn hasDocument(c: *Comet) -> bool { return c.*.current < c.*.count }
fn current(c: *Comet) -> *Editor { return editorAt(c, c.*.current) }

// ---------------------------------------------------------------------------
// Words

fn appendText(into: [*]u8, at: usize, capacity: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        if index >= capacity { return index }
        into[index] = byte
        index += 1
    }
    return index
}

fn appendNumber(into: [*]u8, at: usize, value: usize) -> usize { return std.text.appendUnsigned(into, at, at + 20, value) }

fn say(c: *Comet, text: []const u8, danger: bool) -> void {
    const bytes: [*]u8 = &c.*.note
    c.*.noteLength = appendText(bytes, 0, 160, text)
    c.*.noteDanger = danger
}

fn sayWith(c: *Comet, first: []const u8, second: []const u8, danger: bool) -> void {
    const bytes: [*]u8 = &c.*.note
    c.*.noteLength = appendText(bytes, appendText(bytes, 0, 160, first), 160, second)
    c.*.noteDanger = danger
}

// The last part of a path.
fn baseName(path: []const u8) -> []const u8 {
    var at = path.length
    while at > 0 && path[at - 1] != 47 { at -= 1 }
    return path[at..path.length]
}

fn extensionOf(name: []const u8) -> []const u8 {
    var at = name.length
    while at > 0 && name[at - 1] != 46 { at -= 1 }
    if at == 0 { return "" }
    return name[at..name.length]
}

fn listed(list: []const u8, word: []const u8) -> bool {
    if word.length == 0 { return false }
    var start: usize = 0
    var at: usize = 0
    while at <= list.length {
        if at == list.length || list[at] == 32 {
            if std.text.same(list[start..at], word) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

fn kindFor(path: []const u8) -> u8 {
    const name = baseName(path)
    const extension = extensionOf(name)
    if listed("mlx c h cc cpp hpp cxx zig rs js ts mjs go java kt swift cs json css glsl vert frag", extension) { return CODE }
    if listed("md markdown", extension) { return MARKDOWN }
    if listed("sh conf ini toml yaml yml py rb service desktop cfg mk cmake", extension) || std.text.same(name, "Makefile") { return HASH_COMMENTS }
    return PLAIN_TEXT
}

fn kindName(c: *Comet, path: []const u8, kind: u8) -> []const u8 {
    const extension = extensionOf(baseName(path))
    if std.text.same(extension, "mlx") { return "Mlx" }
    if std.text.same(extension, "c") || std.text.same(extension, "h") { return "C" }
    if listed("cc cpp hpp cxx", extension) { return "C++" }
    if std.text.same(extension, "zig") { return "Zig" }
    if std.text.same(extension, "rs") { return "Rust" }
    if listed("js mjs", extension) { return "JavaScript" }
    if std.text.same(extension, "json") { return "JSON" }
    if std.text.same(extension, "sh") { return "Shell" }
    if std.text.same(extension, "py") { return "Python" }
    if kind == MARKDOWN { return "Markdown" }
    if kind == HASH_COMMENTS { return tr(c, "Settings", "Einstellungen") }
    if kind == CODE { return tr(c, "Code", "Code") }
    return tr(c, "Plain text", "Text")
}

fn documentName(c: *Comet, index: usize) -> []const u8 {
    const editor = editorAt(c, index)
    if editor.*.pathLength == 0 { return tr(c, "Untitled", "Unbenannt") }
    return baseName(editor_module.pathOf(editor))
}

// ---------------------------------------------------------------------------
// Documents

// A new place for a document (the oldest saved one makes room when all are
// taken; none when none of them is saved).
fn newSlot(c: *Comet) -> ?usize {
    if c.*.count < DOCUMENTS {
        const index = c.*.count
        // Each slot keeps its buffers once made.
        if !editorAt(c, index).*.ready { editor_module.initSized(editorAt(c, index), std.heap.allocator(), DOCUMENT_SIZE) }
        c.*.count += 1
        return index
    }
    var index: usize = 0
    while index < c.*.count {
        if !editor_module.isDirty(editorAt(c, index)) && index != c.*.current {
            moveToEnd(c, index)
            return c.*.count - 1
        }
        index += 1
    }
    say(c, tr(c, "Too many documents not saved: save or close one first", "Zu viele ungespeicherte Dokumente: zuerst eines speichern oder schließen"), true)
    return null
}

// Moves document `index` to the end of the list (its buffers with it).
fn moveToEnd(c: *Comet, index: usize) -> void {
    var at = index
    while at + 1 < c.*.count {
        swap(c, at, at + 1)
        at += 1
    }
}

fn swap(c: *Comet, a: usize, b: usize) -> void {
    const kept = c.*.documents[a]
    c.*.documents[a] = c.*.documents[b]
    c.*.documents[b] = kept
}

fn prepare(c: *Comet, index: usize, path: []const u8) -> void {
    const document = documentAt(c, index)
    document.*.left = 0
    document.*.closing = false
    document.*.kind = kindFor(path)
    c.*.current = index
    updateTitle(c)
}

fn newDocument(c: *Comet) -> void {
    const slot = newSlot(c)
    if slot == null { return }
    editor_module.blank(editorAt(c, slot.?), "")
    prepare(c, slot.?, "")
    c.*.noteLength = 0
}

// Opens `path` (already open: shows it; not there: a new text that save
// writes there).
fn openPath(c: *Comet, path: []const u8) -> void {
    var index: usize = 0
    while index < c.*.count {
        if std.text.same(editor_module.pathOf(editorAt(c, index)), path) {
            c.*.current = index
            updateTitle(c)
            return
        }
        index += 1
    }
    // An untitled, unchanged text in front is taken over.
    var slot: ?usize = null
    if hasDocument(c) && editorAt(c, c.*.current).*.pathLength == 0 && editorAt(c, c.*.current).*.length == 0 {
        slot = c.*.current
    } else {
        slot = newSlot(c)
    }
    if slot == null { return }
    const editor = editorAt(c, slot.?)
    if editor_module.load(editor, path) {
        if editor.*.length + 65536 > editor.*.textCapacity {
            sayWith(c, tr(c, "Only the start was read (too large): ", "Nur der Anfang wurde gelesen (zu groß): "), baseName(path), true)
        } else {
            c.*.noteLength = 0
        }
    } else {
        editor_module.blank(editor, path)
        sayWith(c, tr(c, "New file: ", "Neue Datei: "), path, false)
    }
    prepare(c, slot.?, path)
}

fn closeDocument(c: *Comet, index: usize) -> void {
    if index >= c.*.count { return }
    const document = documentAt(c, index)
    if editor_module.isDirty(&document.*.editor) && !document.*.closing {
        document.*.closing = true
        sayWith(c, documentName(c, index), tr(c, " is not saved: close it again to discard the changes", " ist nicht gespeichert: noch einmal schließen verwirft die Änderungen"), true)
        return
    }
    document.*.closing = false
    document.*.editor.open = false
    moveToEnd(c, index)
    c.*.count -= 1
    if c.*.current > index || c.*.current >= c.*.count { c.*.current = if c.*.current > 0 { c.*.current - 1 } else { 0 } }
    if c.*.count == 0 { newDocument(c) }
    c.*.noteLength = 0
    updateTitle(c)
}

fn save(c: *Comet, ask: bool) -> void {
    if !hasDocument(c) { return }
    const editor = current(c)
    if ask || editor.*.pathLength == 0 {
        startAsking(c, ASK_SAVE)
        return
    }
    if editor_module.save(editor) {
        sayWith(c, tr(c, "Saved ", "Gespeichert: "), editor_module.pathOf(editor), false)
        documentAt(c, c.*.current).*.closing = false
    } else {
        sayWith(c, tr(c, "Cannot write ", "Kann nicht schreiben: "), editor_module.pathOf(editor), true)
    }
}

fn updateTitle(c: *Comet) -> void {
    if !hasDocument(c) { return }
    var title: [200]u8 = undefined
    const bytes: [*]u8 = &title
    var length = appendText(bytes, 0, 200, documentName(c, c.*.current))
    if editor_module.isDirty(current(c)) { length = appendText(bytes, length, 200, " *") }
    length = appendText(bytes, length, 200, " - Comet")
    host_module.setTitle(c.*.host, bytes[0..length])
}

// ---------------------------------------------------------------------------
// The header's field

fn startAsking(c: *Comet, what: u8) -> void {
    c.*.asking = what
    if what == ASK_SAVE {
        const editor = current(c)
        if editor.*.pathLength > 0 {
            field_module.set(fieldOf(c), editor_module.pathOf(editor))
        } else {
            var path: [1100]u8 = undefined
            const bytes: [*]u8 = &path
            var length = appendText(bytes, 0, 1000, host_module.home(c.*.host))
            length = appendText(bytes, length, 1090, tr(c, "/Untitled.txt", "/Unbenannt.txt"))
            field_module.set(fieldOf(c), bytes[0..length])
        }
    } else if hasDocument(c) && editor_module.hasSelection(current(c)) {
        const editor = current(c)
        const start = editor_module.selectionStart(editor)
        const end = editor_module.selectionEnd(editor)
        if end - start < 200 && !containsNewline(editor.*.text[start..end]) { field_module.set(fieldOf(c), editor.*.text[start..end]) }
    }
    field_module.selectAll(fieldOf(c))
    view.setFocus(uiOf(c), idOf(ID_FIELD))
}

fn stopAsking(c: *Comet) -> void {
    c.*.asking = ASK_NONE
    view.setFocus(uiOf(c), idOf(ID_TEXT))
}

fn containsNewline(text: []const u8) -> bool {
    for byte in text {
        if byte == 10 { return true }
    }
    return false
}

// The field's Enter: find the next (or, `backwards`, the one before), or
// save where it says.
fn submit(c: *Comet, backwards: bool) -> void {
    if c.*.asking == ASK_SAVE {
        const path = field_module.text(fieldOf(c))
        if path.length == 0 { return }
        const editor = current(c)
        editor_module.setPath(editor, path)
        documentAt(c, c.*.current).*.kind = kindFor(path)
        stopAsking(c)
        save(c, false)
        updateTitle(c)
        return
    }
    find(c, backwards)
}

fn matchesAt(text: []const u8, at: usize, wanted: []const u8) -> bool {
    if at + wanted.length > text.length { return false }
    var index: usize = 0
    while index < wanted.length {
        if lower(text[at + index]) != lower(wanted[index]) { return false }
        index += 1
    }
    return true
}

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// Selects the next place of the field's text after the selection (before
// it when `backwards`), around the end when there is none.
fn find(c: *Comet, backwards: bool) -> void {
    if !hasDocument(c) { return }
    const wanted = field_module.text(fieldOf(c))
    if wanted.length == 0 { return }
    const editor = current(c)
    const text = editor_module.textOf(editor)
    if text.length < wanted.length {
        say(c, tr(c, "Not found", "Nicht gefunden"), true)
        return
    }
    const last = text.length - wanted.length
    var tries: usize = 0
    var at = if backwards { editor_module.selectionStart(editor) } else { editor_module.selectionEnd(editor) }
    while tries <= last + 1 {
        if backwards {
            at = if at == 0 { last } else { at - 1 }
            if at > last { at = last }
        } else if tries > 0 {
            at = if at >= last { 0 } else { at + 1 }
        }
        if at > last { at = 0 }
        if matchesAt(text, at, wanted) {
            editor_module.moveTo(editor, at, false)
            editor_module.moveTo(editor, at + wanted.length, true)
            keepCursorShown(c)
            c.*.noteLength = 0
            return
        }
        tries += 1
    }
    say(c, tr(c, "Not found", "Nicht gefunden"), true)
}

// ---------------------------------------------------------------------------
// The text's colours

// The prism's gradient at `t` (0 to 1024), at `alpha`.
fn prismAt(t: i32, alpha: u32) -> u32 {
    const at = if t < 0 { 0 } else if t > 1024 { 1024 } else { t }
    const color = if at < 512 { scheme_module.mix(scheme_module.prism(0), scheme_module.prism(1), at * 2) } else { scheme_module.mix(scheme_module.prism(1), scheme_module.prism(2), (at - 512) * 2) }
    return canvas_module.color(alpha, (color >> 16) & 255, (color >> 8) & 255, color & 255)
}

fn prismStripe(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, alpha: u32) -> void {
    if width <= 0 || height <= 0 { return }
    const step: i32 = 3
    var at: i32 = 0
    while at < width {
        const piece = if width - at < step { width - at } else { step }
        canvas_module.fillRect(canvas, x + at, y, piece, height, prismAt(at * 1024 / width, alpha))
        at += step
    }
}

// A colour of the scheme readable on the card: lighter on a dark one,
// darker on a light one.
fn readable(c: *Comet, color: u32) -> u32 {
    const light = host_module.lightness(c.*.host) >= 512
    const toward: u32 = if light { 0 } else { 16777215 }
    const mixed = scheme_module.mix(color, toward, if light { 420 } else { 300 })
    return canvas_module.color(255, (mixed >> 16) & 255, (mixed >> 8) & 255, mixed & 255)
}

fn tokenColor(c: *Comet, kind: u8) -> u32 {
    const theme = themeOf(c)
    return match kind {
        editor_module.KEYWORD => readable(c, scheme_module.prism(0)),
        editor_module.TYPE => readable(c, scheme_module.prism(1)),
        editor_module.CALL => readable(c, scheme_module.prism(2)),
        editor_module.BUILTIN => readable(c, scheme_module.mix(scheme_module.prism(0), scheme_module.prism(2), 512)),
        editor_module.STRING => readable(c, scheme_module.mix(scheme_module.prism(1), scheme_module.prism(2), 512)),
        editor_module.NUMBER => readable(c, scheme_module.accent()),
        editor_module.CONSTANT => readable(c, scheme_module.accent()),
        editor_module.COMMENT => theme.*.dim,
        editor_module.DOC => theme.*.dim,
        editor_module.PUNCTUATION => theme.*.dim,
        else => theme.*.text
    }
}

// ---------------------------------------------------------------------------
// Drawing

fn gutterWidth(c: *Comet, editor: *Editor) -> i32 {
    var digits: i32 = 1
    var lines = editor.*.lineCount
    while lines >= 10 {
        lines /= 10
        digits += 1
    }
    if digits < 3 { digits = 3 }
    return digits * c.*.charWidth + px(c, 28)
}

fn drawSidebar(c: *Comet, canvas: *Canvas, height: i32) -> void {
    const widgets = uiOf(c)
    const theme = themeOf(c)
    const width = px(c, SIDEBAR)
    sidebar_module.glass(widgets, ui.rect(0, 0, width, height))
    text_module.drawText(canvas, titleOf(c), "Comet", px(c, PAD), px(c, 12), theme.*.text, 0)
    prismStripe(canvas, px(c, PAD), px(c, 40), text_module.measure(titleOf(c), "Comet"), px(c, 2), 255)
    // New and Open.
    const button_y = px(c, 54)
    const button_width = (width - px(c, PAD * 2) - px(c, 8)) / 2
    if controls.button(widgets, idOf(ID_NEW), ui.rect(px(c, PAD), button_y, button_width, px(c, 28)), tr(c, "New", "Neu"), controls.BUTTON_NORMAL, true) { newDocument(c) }
    if controls.button(widgets, idOf(ID_OPEN), ui.rect(px(c, PAD) + button_width + px(c, 8), button_y, button_width, px(c, 28)), tr(c, "Open", "Öffnen"), controls.BUTTON_NORMAL, true) { startOpen(c) }
    sidebar_module.heading(widgets, tr(c, "Documents", "Dokumente"), 0, px(c, 98), width)
    var y = px(c, 118)
    var index: usize = 0
    while index < c.*.count && y + px(c, 30) < height {
        const row = ui.rect(px(c, 8), y, width - px(c, 16), px(c, 30))
        const chosen = index == c.*.current
        const row_id = idOf(ID_DOCUMENT + index)
        const close_id = idOf(ID_CLOSE + index)
        if lists.rowBackground(widgets, row_id, row, chosen, false) {
            c.*.current = index
            c.*.dragging = false
            updateTitle(c)
        }
        const editor = editorAt(c, index)
        const name = documentName(c, index)
        const kind = glyphs.fileKind(name, "")
        glyphs.fileScaled(canvas, row.x + px(c, 8), row.y + (row.height - px(c, 20)) / 2, kind, if chosen { theme.*.text } else { theme.*.dim }, prismAt(@intCast(i32, index) * 1024 / 7, 255), c.*.scale)
        const label_x = row.x + px(c, 32)
        const hover = view.isHover(widgets, row_id) || view.isHover(widgets, close_id)
        controls.label(widgets, bodyOf(c), name, label_x, controls.textTop(bodyOf(c), row.y, row.height), theme.*.text, ui.right(row) - label_x - px(c, 28))
        const mark = ui.rect(ui.right(row) - px(c, 24), row.y + (row.height - px(c, 20)) / 2, px(c, 20), px(c, 20))
        if hover {
            if controls.closeButton(widgets, close_id, mark) { closeDocument(c, index) }
        } else if editor_module.isDirty(editor) {
            const dot = px(c, 8)
            canvas_module.fillRoundedRect(canvas, mark.x + (mark.width - dot) / 2, mark.y + (mark.height - dot) / 2, dot, dot, dot / 2, prismAt(512, 255))
        }
        y += px(c, 32)
        index += 1
    }
}

// The header in the card: the name and where it is, Find and Save, or
// the field asking.
fn drawHeader(c: *Comet, canvas: *Canvas, area: ui.Rect) -> void {
    const widgets = uiOf(c)
    const theme = themeOf(c)
    if !hasDocument(c) { return }
    const editor = current(c)
    const save_label = tr(c, "Save", "Speichern")
    const find_label = tr(c, "Find", "Suchen")
    const button_height = px(c, 28)
    const button_y = area.y + (area.height - button_height) / 2
    const save_width = controls.buttonWidth(widgets, bodyOf(c), save_label)
    const find_width = controls.buttonWidth(widgets, bodyOf(c), find_label)
    const save_x = ui.right(area) - px(c, PAD) - save_width
    const find_x = save_x - px(c, 8) - find_width
    if controls.button(widgets, idOf(ID_SAVE), ui.rect(save_x, button_y, save_width, button_height), save_label, controls.BUTTON_PRIMARY, editor_module.isDirty(editor) || editor.*.pathLength == 0) { save(c, false) }
    if controls.button(widgets, idOf(ID_FIND), ui.rect(find_x, button_y, find_width, button_height), find_label, controls.BUTTON_NORMAL, true) {
        if c.*.asking == ASK_FIND { stopAsking(c) } else { startAsking(c, ASK_FIND) }
    }
    const left = area.x + px(c, PAD)
    if c.*.asking != ASK_NONE {
        const label = if c.*.asking == ASK_FIND { tr(c, "Find", "Suchen") } else { tr(c, "Save as", "Speichern als") }
        const label_width = text_module.measure(smallOf(c), label)
        controls.label(widgets, smallOf(c), label, left, controls.textTop(smallOf(c), area.y, area.height), theme.*.dim, label_width)
        const field_x = left + label_width + px(c, 10)
        _ = field_module.textField(widgets, idOf(ID_FIELD), ui.rect(field_x, button_y, find_x - px(c, 12) - field_x, button_height), fieldOf(c), if c.*.asking == ASK_FIND { tr(c, "Text to find", "Gesuchter Text") } else { tr(c, "Path", "Pfad") }, c.*.asking == ASK_FIND)
        return
    }
    const name = documentName(c, c.*.current)
    text_module.drawText(canvas, bodyOf(c), name, left, controls.textTop(bodyOf(c), area.y, area.height), theme.*.text, 0)
    const name_width = text_module.measure(bodyOf(c), name)
    if editor.*.pathLength > 0 {
        const path = editor_module.pathOf(editor)
        var folder = path.length - baseName(path).length
        if folder > 1 { folder -= 1 }
        const where_x = left + name_width + px(c, 12)
        controls.label(widgets, smallOf(c), path[0..folder], where_x, controls.textTop(smallOf(c), area.y, area.height), theme.*.dim, find_x - px(c, 12) - where_x)
    }
}

fn drawText(c: *Comet, canvas: *Canvas, area: ui.Rect) -> void {
    const widgets = uiOf(c)
    const theme = themeOf(c)
    if !hasDocument(c) { return }
    const document = documentAt(c, c.*.current)
    const editor = &document.*.editor
    const mono = monoOf(c)
    const cw = c.*.charWidth
    const line_height = px(c, LINE)
    const gutter = gutterWidth(c, editor)
    view.region(widgets, idOf(ID_TEXT), area)
    c.*.textLeft = area.x + gutter
    c.*.textTop = area.y + px(c, 6)
    c.*.textRight = ui.right(area) - px(c, 10)
    c.*.textBottom = ui.bottom(area)
    c.*.rows = @intCast(usize, (c.*.textBottom - c.*.textTop) / line_height)
    if c.*.rows == 0 { c.*.rows = 1 }
    if editor.*.top >= editor.*.lineCount { editor.*.top = editor.*.lineCount - 1 }
    const light = host_module.lightness(c.*.host) >= 512
    const accent = theme.*.accent
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    const select_start = editor_module.selectionStart(editor)
    const select_end = editor_module.selectionEnd(editor)
    const selection = canvas_module.color(if light { 70 } else { 90 }, (accent >> 16) & 255, (accent >> 8) & 255, accent & 255)
    const columns_shown = @intCast(usize, (c.*.textRight - c.*.textLeft) / cw)
    var digits: [24]u8 = undefined
    const digit_bytes: [*]u8 = &digits
    var row: usize = 0
    while row < c.*.rows {
        const line = editor.*.top + row
        if line >= editor.*.lineCount { break }
        const y = c.*.textTop + @intCast(i32, row) * line_height
        const start = editor_module.lineStart(editor, line)
        const end = editor_module.lineEnd(editor, line)
        if line == cursor_line && !editor_module.hasSelection(editor) {
            canvas_module.fillRect(canvas, area.x, y, area.width, line_height, if light { canvas_module.color(14, 0, 0, 0) } else { canvas_module.color(12, 255, 255, 255) })
            canvas_module.fillRect(canvas, area.x, y, px(c, 3), line_height, prismAt(@intCast(i32, (line * 37) % 1024), 255))
        }
        // The line's number, lit on the cursor's line.
        const number_length = appendNumber(digit_bytes, 0, line + 1)
        const number_x = c.*.textLeft - px(c, 16) - @intCast(i32, number_length) * cw
        text_module.drawText(canvas, mono, digit_bytes[0..number_length], number_x, y + px(c, 2), if line == cursor_line { readable(c, scheme_module.accent()) } else { theme.*.disabled }, 0)
        // The selection on this line.
        if select_start != select_end && select_start <= end && select_end >= start {
            const from = if select_start > start { select_start } else { start }
            const to = if select_end < end { select_end } else { end }
            const from_column = editor_module.columnsBetween(editor, start, from)
            const to_column = editor_module.columnsBetween(editor, start, to)
            var x0 = c.*.textLeft + (@intCast(i32, from_column) - @intCast(i32, document.*.left)) * cw
            var x1 = c.*.textLeft + (@intCast(i32, to_column) - @intCast(i32, document.*.left)) * cw
            if select_end > end { x1 += cw / 2 }
            if x0 < c.*.textLeft { x0 = c.*.textLeft }
            if x1 > c.*.textRight { x1 = c.*.textRight }
            if x1 > x0 { canvas_module.fillRect(canvas, x0, y, x1 - x0, line_height, selection) }
        }
        drawLine(c, canvas, document, start, end, y, columns_shown)
        // The cursor: a bar of the prism.
        if line == cursor_line {
            const column = @intCast(i32, editor_module.columnsBetween(editor, start, editor.*.cursor)) - @intCast(i32, document.*.left)
            if column >= 0 {
                const x = c.*.textLeft + column * cw
                if x <= c.*.textRight { canvas_module.fillRect(canvas, x, y + px(c, 1), px(c, 2), line_height - px(c, 2), prismAt(@intCast(i32, (line * 37) % 1024), 255)) }
            }
        }
        row += 1
    }
    // Where the view is in the text: a thin bar of the prism at the right.
    if editor.*.lineCount > c.*.rows {
        const track = ui.rect(ui.right(area) - px(c, 6), area.y + px(c, 6), px(c, 3), area.height - px(c, 12))
        canvas_module.fillRoundedRect(canvas, track.x, track.y, track.width, track.height, track.width / 2, if light { canvas_module.color(24, 0, 0, 0) } else { canvas_module.color(24, 255, 255, 255) })
        const total = @intCast(i32, editor.*.lineCount)
        var thumb = track.height * @intCast(i32, c.*.rows) / total
        if thumb < px(c, 24) { thumb = px(c, 24) }
        const thumb_y = track.y + (track.height - thumb) * @intCast(i32, editor.*.top) / (if total - @intCast(i32, c.*.rows) > 0 { total - @intCast(i32, c.*.rows) } else { 1 })
        canvas_module.fillRoundedRect(canvas, track.x, thumb_y, track.width, thumb, track.width / 2, prismAt((thumb_y - track.y) * 1024 / track.height, 230))
    }
}

// A line's text, token by token in their colours, from the first column
// shown.
fn drawLine(c: *Comet, canvas: *Canvas, document: *Document, start: usize, end: usize, y: i32, columns_shown: usize) -> void {
    const editor = &document.*.editor
    const mono = monoOf(c)
    const cw = c.*.charWidth
    const text = editor.*.text[start..end]
    const theme = themeOf(c)
    var first: usize = 0
    while first < text.length && text[first] == 32 { first += 1 }
    // A whole line in one colour: a comment of # or a Markdown heading.
    var whole: u32 = 0
    if document.*.kind == HASH_COMMENTS && first < text.length && text[first] == 35 { whole = theme.*.dim }
    if document.*.kind == MARKDOWN && first < text.length && text[first] == 35 { whole = readable(c, scheme_module.prism(0)) }
    if document.*.kind == MARKDOWN && first + 1 < text.length && (text[first] == 45 || text[first] == 42) && text[first + 1] == 32 { whole = 0 }
    var column: usize = 0
    var at: usize = 0
    while at < text.length && column < document.*.left + columns_shown {
        var kind: u8 = editor_module.PLAIN
        var token_end = at + 1
        if document.*.kind == CODE {
            token_end = editor_module.token(text, at, &kind)
        } else {
            // Plain text: words and spaces.
            const space = text[at] == 32 || text[at] == 9
            while token_end < text.length && (text[token_end] == 32 || text[token_end] == 9) == space { token_end += 1 }
        }
        const piece = text[at..token_end]
        const columns = editor_module.columnsBetween(editor, start + at, start + token_end)
        if piece[0] != 32 && piece[0] != 9 && column + columns > document.*.left {
            // Cut where it starts before the first column shown.
            var skip: usize = 0
            var shown_at: usize = 0
            while column + skip < document.*.left && shown_at < piece.length {
                shown_at += 1
                while shown_at < piece.length && piece[shown_at] & 192 == 128 { shown_at += 1 }
                skip += 1
            }
            const x = c.*.textLeft + @intCast(i32, column + skip - document.*.left) * cw
            const color = if whole != 0 { whole } else if document.*.kind == CODE { tokenColor(c, kind) } else { theme.*.text }
            // In the grid's cells (whatever the font's own advance), up to
            // the last column shown.
            var shown_end = shown_at
            var room = document.*.left + columns_shown - (column + skip)
            while shown_end < piece.length && room > 0 {
                shown_end += 1
                while shown_end < piece.length && piece[shown_end] & 192 == 128 { shown_end += 1 }
                room -= 1
            }
            text_module.drawCells(canvas, mono, piece[shown_at..shown_end], x, y + px(c, 2), color, cw, y, px(c, LINE))
        }
        column += columns
        at = token_end
    }
}

fn drawStatus(c: *Comet, canvas: *Canvas, area: ui.Rect) -> void {
    const widgets = uiOf(c)
    const theme = themeOf(c)
    canvas_module.fillRect(canvas, area.x, area.y, area.width, c.*.scale, theme.*.divider)
    if !hasDocument(c) { return }
    const document = documentAt(c, c.*.current)
    const editor = &document.*.editor
    const text_y = controls.textTop(smallOf(c), area.y, area.height)
    // Right: where the cursor is, how many lines, what the text is.
    var place: [96]u8 = undefined
    const bytes: [*]u8 = &place
    const line = editor_module.lineOf(editor, editor.*.cursor)
    var length = appendText(bytes, 0, 96, tr(c, "Ln ", "Z. "))
    length = appendNumber(bytes, length, line + 1)
    length = appendText(bytes, length, 96, tr(c, ", Col ", ", Sp. "))
    length = appendNumber(bytes, length, editor_module.columnOf(editor, editor.*.cursor) + 1)
    if editor_module.hasSelection(editor) {
        length = appendText(bytes, length, 96, "  (")
        length = appendNumber(bytes, length, editor_module.selectionEnd(editor) - editor_module.selectionStart(editor))
        length = appendText(bytes, length, 96, tr(c, " selected)", " gewählt)"))
    }
    length = appendText(bytes, length, 96, "   ")
    length = appendNumber(bytes, length, editor.*.lineCount)
    length = appendText(bytes, length, 96, tr(c, " lines   ", " Zeilen   "))
    length = appendText(bytes, length, 96, kindName(c, editor_module.pathOf(editor), document.*.kind))
    length = appendText(bytes, length, 96, "   UTF-8")
    const right_text = bytes[0..length]
    const right_width = text_module.measure(smallOf(c), right_text)
    const right_x = ui.right(area) - px(c, PAD) - right_width
    text_module.drawText(canvas, smallOf(c), right_text, right_x, text_y, theme.*.dim, 0)
    // Left: what was said last, or whether it is saved.
    const note_bytes: [*]u8 = &c.*.note
    if c.*.noteLength > 0 {
        controls.label(widgets, smallOf(c), note_bytes[0..c.*.noteLength], area.x + px(c, PAD), text_y, if c.*.noteDanger { theme.*.danger } else { theme.*.dim }, right_x - area.x - px(c, PAD * 2))
    } else {
        const saved = !editor_module.isDirty(editor) && editor.*.pathLength > 0
        const dot = px(c, 7)
        canvas_module.fillRoundedRect(canvas, area.x + px(c, PAD), area.y + (area.height - dot) / 2, dot, dot, dot / 2, if saved { prismAt(200, 255) } else { prismAt(800, 255) })
        controls.label(widgets, smallOf(c), if saved { tr(c, "Saved", "Gespeichert") } else { tr(c, "Changed", "Geändert") }, area.x + px(c, PAD) + dot + px(c, 8), text_y, theme.*.dim, right_x - area.x - px(c, PAD * 2))
    }
}

fn drawAll(c: *Comet, canvas: *Canvas) -> void {
    const widgets = uiOf(c)
    const width = host_module.width(c.*.host)
    const height = host_module.height(c.*.host)
    const sidebar = px(c, SIDEBAR)
    drawSidebar(c, canvas, height)
    // The card: the header, a line of the prism, the text, the status.
    const card = ui.rect(sidebar, 0, width - sidebar, height)
    sidebar_module.card(widgets, card)
    const header = ui.rect(card.x, 0, card.width, px(c, HEADER))
    if c.*.choosing {
        const result = chooser_module.draw(chooserOf(c), widgets, ui.rect(card.x, 0, card.width, height))
        if result != chooser_module.WAITING { closeChooser(c, result) }
        return
    }
    drawHeader(c, canvas, header)
    prismStripe(canvas, card.x + px(c, 12), ui.bottom(header), card.width - px(c, 12), c.*.scale, 150)
    const status = px(c, STATUS)
    drawText(c, canvas, ui.rect(card.x, ui.bottom(header) + c.*.scale, card.width, height - ui.bottom(header) - c.*.scale - status))
    drawStatus(c, canvas, ui.rect(card.x, height - status, card.width, status))
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const c = stateOf(context)
    if !c.*.ready { return }
    c.*.theme = theme_module.scaled(theme_module.at(host_module.lightness(c.*.host)), c.*.scale)
    const widgets = uiOf(c)
    view.begin(widgets, canvas)
    canvas_module.clear(canvas, 0)
    drawAll(c, canvas)
    if view.end(widgets) { redraw(c) }
}

fn layOut(c: *Comet) -> void {
    var nowhere = view.layoutCanvas()
    const widgets = uiOf(c)
    view.begin(widgets, &nowhere)
    drawAll(c, &nowhere)
    _ = view.end(widgets)
}

// ---------------------------------------------------------------------------
// Open

fn startOpen(c: *Comet) -> void {
    var folder: [1100]u8 = undefined
    const bytes: [*]u8 = &folder
    var length: usize = 0
    if hasDocument(c) && current(c).*.pathLength > 0 {
        const path = editor_module.pathOf(current(c))
        length = appendText(bytes, 0, 1090, path[0..path.length - baseName(path).length])
        if length > 1 { length -= 1 }
    } else {
        length = appendText(bytes, 0, 1090, host_module.home(c.*.host))
    }
    chooser_module.startFor(chooserOf(c), host_module.environment(c.*.host), "org.mlx.comet", bytes[0..length], false, "")
    c.*.choosing = true
    c.*.asking = ASK_NONE
}

fn closeChooser(c: *Comet, result: u8) -> void {
    c.*.choosing = false
    if result != chooser_module.CHOSEN { return }
    var paths = std.ArrayList(u8).init(std.heap.allocator())
    defer paths.deinit()
    chooser_module.paths(chooserOf(c), &paths)
    const list = paths.items()
    // A path a line: each opened.
    var at: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 10 { end += 1 }
        if end > at { openPath(c, list[at..end]) }
        at = end + 1
    }
    redraw(c)
}

// ---------------------------------------------------------------------------
// Editing

// Scrolls so the cursor is in sight.
fn keepCursorShown(c: *Comet) -> void {
    if !hasDocument(c) { return }
    const document = documentAt(c, c.*.current)
    const editor = &document.*.editor
    const line = editor_module.lineOf(editor, editor.*.cursor)
    const rows = if c.*.rows > 0 { c.*.rows } else { 20 }
    if line < editor.*.top { editor.*.top = line }
    if line >= editor.*.top + rows { editor.*.top = line + 1 - rows }
    const column = editor_module.columnOf(editor, editor.*.cursor)
    const shown = if c.*.charWidth > 0 && c.*.textRight > c.*.textLeft { @intCast(usize, (c.*.textRight - c.*.textLeft) / c.*.charWidth) } else { 80 }
    if column < document.*.left { document.*.left = if column > 8 { column - 8 } else { 0 } }
    if shown > 4 && column + 2 > document.*.left + shown { document.*.left = column + 10 - shown }
}

fn copySelection(c: *Comet) -> void {
    const editor = current(c)
    if !editor_module.hasSelection(editor) { return }
    editor_module.copy(editor)
    const text = editor_module.clipboardText(editor)
    host_module.beginClipboard(c.*.host)
    _ = host_module.addClipboard(c.*.host, "text/plain;charset=utf-8", text)
    _ = host_module.addClipboard(c.*.host, "text/plain", text)
    _ = host_module.addClipboard(c.*.host, "UTF8_STRING", text)
    _ = host_module.publishClipboard(c.*.host)
}

fn paste(c: *Comet) -> void {
    const editor = current(c)
    var pasted = host_module.readClipboard(c.*.host, "text/plain;charset=utf-8")
    if pasted.length == 0 { pasted = host_module.readClipboard(c.*.host, "UTF8_STRING") }
    if pasted.length == 0 { pasted = host_module.readClipboard(c.*.host, "text/plain") }
    if pasted.length == 0 { pasted = editor_module.clipboardText(editor) }
    if pasted.length > 0 { editor_module.paste(editor, pasted) }
}

// A key for the text; true when it did something.
fn textKey(c: *Comet, code: u32, modifiers: u32) -> bool {
    if !hasDocument(c) { return false }
    const editor = current(c)
    const shift = modifiers & keys.SHIFT != 0
    const control = modifiers & keys.CONTROL != 0
    const page = if c.*.rows > 1 { @intCast(isize, c.*.rows) - 1 } else { 10 }
    if code == keys.LEFT {
        editor_module.left(editor, shift, control)
    } else if code == keys.RIGHT {
        editor_module.right(editor, shift, control)
    } else if code == keys.UP {
        if control {
            if editor.*.top > 0 { editor.*.top -= 1 }
            return true
        }
        editor_module.vertical(editor, -1, shift)
    } else if code == keys.DOWN {
        if control {
            if editor.*.top + 1 < editor.*.lineCount { editor.*.top += 1 }
            return true
        }
        editor_module.vertical(editor, 1, shift)
    } else if code == keys.PAGE_UP {
        editor_module.vertical(editor, -page, shift)
        editor.*.top = if editor.*.top > @intCast(usize, page) { editor.*.top - @intCast(usize, page) } else { 0 }
    } else if code == keys.PAGE_DOWN {
        editor_module.vertical(editor, page, shift)
        editor.*.top += @intCast(usize, page)
        if editor.*.top >= editor.*.lineCount { editor.*.top = editor.*.lineCount - 1 }
    } else if code == keys.HOME {
        if control { editor_module.moveTo(editor, 0, shift) } else { editor_module.home(editor, shift) }
    } else if code == keys.END {
        if control { editor_module.moveTo(editor, editor.*.length, shift) } else { editor_module.end(editor, shift) }
    } else if code == keys.BACKSPACE {
        editor_module.backspace(editor, control)
    } else if code == keys.DELETE {
        editor_module.delete(editor, control)
    } else if keys.isEnter(code) {
        editor_module.newline(editor)
    } else if code == keys.TAB {
        editor_module.tab(editor)
    } else {
        return false
    }
    keepCursorShown(c)
    return true
}

// Ctrl and a letter (by what the key types without Ctrl: the same on any
// layout, Colemak too).
fn shortcut(c: *Comet, letter: u8, shift: bool) -> bool {
    if letter == 110 {
        newDocument(c)
        return true
    }
    if letter == 111 {
        startOpen(c)
        return true
    }
    if letter == 115 {
        save(c, shift)
        return true
    }
    if letter == 102 {
        startAsking(c, ASK_FIND)
        return true
    }
    if letter == 119 {
        closeDocument(c, c.*.current)
        return true
    }
    if !hasDocument(c) { return false }
    const editor = current(c)
    if letter == 122 {
        if shift { editor_module.redo(editor) } else { editor_module.undo(editor) }
    } else if letter == 121 {
        editor_module.redo(editor)
    } else if letter == 97 {
        editor_module.selectAll(editor)
    } else if letter == 99 {
        copySelection(c)
        return true
    } else if letter == 120 {
        copySelection(c)
        if editor_module.hasSelection(editor) { editor_module.deleteSelection(editor) }
    } else if letter == 118 {
        paste(c)
    } else if letter == 103 {
        find(c, shift)
        return true
    } else {
        return false
    }
    keepCursorShown(c)
    return true
}

fn onKey(c: *Comet, code: u32) -> void {
    const modifiers = host_module.modifiers(c.*.host)
    const typed = host_module.typed(c.*.host)
    if c.*.choosing {
        _ = chooser_module.keyTyped(chooserOf(c), code, modifiers, typed)
        layOut(c)
        return
    }
    const control = modifiers & keys.CONTROL != 0
    const shift = modifiers & keys.SHIFT != 0
    const plain = host_module.plainTyped(c.*.host)
    if control && plain.length == 1 {
        const letter = lower(plain[0])
        if letter >= 97 && letter <= 122 {
            if shortcut(c, letter, shift) { afterEdit(c) }
            return
        }
    }
    // The header's field has the keys while it is shown and focused.
    if c.*.asking != ASK_NONE && view.hasFocus(uiOf(c), idOf(ID_FIELD)) {
        const result = field_module.fieldKey(fieldOf(c), code, modifiers, typed)
        if result == field_module.KEY_SUBMIT || keys.isEnter(code) {
            submit(c, shift)
        } else if result == field_module.KEY_CANCEL || code == keys.ESCAPE {
            stopAsking(c)
        } else if c.*.asking == ASK_FIND && result == field_module.KEY_EDITED {
            // Finding as it is typed: from the selection's start.
            if hasDocument(c) { editor_module.moveTo(current(c), editor_module.selectionStart(current(c)), false) }
            find(c, false)
        }
        return
    }
    if code == keys.ESCAPE {
        if c.*.asking != ASK_NONE { stopAsking(c) } else if hasDocument(c) { editor_module.moveTo(current(c), current(c).*.cursor, false) }
        return
    }
    if textKey(c, code, modifiers) {
        afterEdit(c)
        return
    }
    if control || modifiers & keys.ALT != 0 || !hasDocument(c) { return }
    if typed.length > 0 && typed[0] >= 32 && typed[0] != 127 {
        editor_module.insert(current(c), typed)
        keepCursorShown(c)
        afterEdit(c)
    }
}

fn afterEdit(c: *Comet) -> void {
    if hasDocument(c) { documentAt(c, c.*.current).*.closing = false }
    updateTitle(c)
}

// The offset under the pointer at (x, y) in the text.
fn offsetAtPoint(c: *Comet, x: i32, y: i32) -> usize {
    const document = documentAt(c, c.*.current)
    const editor = &document.*.editor
    var row = (y - c.*.textTop) / px(c, LINE)
    if y < c.*.textTop { row = -1 }
    var line_value = @intCast(isize, editor.*.top) + @intCast(isize, row)
    if line_value < 0 { line_value = 0 }
    var line = @intCast(usize, line_value)
    if line >= editor.*.lineCount { return editor.*.length }
    var column = (x - c.*.textLeft + c.*.charWidth / 2) / c.*.charWidth
    if column < 0 { column = 0 }
    return editor_module.offsetAt(editor, line, @intCast(usize, column) + document.*.left)
}

fn inText(c: *Comet, x: i32, y: i32) -> bool {
    return x >= c.*.textLeft - px(c, 40) && x < c.*.textRight + px(c, 10) && y >= c.*.textTop && y < c.*.textBottom
}

// ---------------------------------------------------------------------------
// Events

fn fitScale(c: *Comet) -> void {
    const scale = host_module.scale(c.*.host)
    c.*.scale = scale
    if scale == c.*.fontScale { return }
    if c.*.fontScale != 0 {
        text_module.unloadText(titleOf(c))
        text_module.unloadText(bodyOf(c))
        text_module.unloadText(smallOf(c))
        text_module.unloadText(monoOf(c))
    }
    c.*.fontScale = scale
    const factor = @intCast(u32, scale)
    const allocator = std.heap.allocator()
    _ = text_module.loadText(titleOf(c), 20 * factor, allocator)
    _ = text_module.loadText(bodyOf(c), 13 * factor, allocator)
    _ = text_module.loadText(smallOf(c), 12 * factor, allocator)
    _ = text_module.loadMonoText(monoOf(c), 13 * factor, allocator)
    c.*.charWidth = text_module.measure(monoOf(c), "M")
    if c.*.charWidth <= 0 { c.*.charWidth = 8 * scale }
    c.*.theme = theme_module.scaled(theme_module.dark(), scale)
    view.init(uiOf(c), themeOf(c), bodyOf(c), smallOf(c), bodyOf(c))
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const c = stateOf(context)
    if !c.*.ready { return }
    if kind == ui_app.EVENT_CLOSED {
        host_module.quit(c.*.host)
        return
    }
    if kind == ui_app.EVENT_CONFIGURED {
        fitScale(c)
        // The whole window's glass is blurred: the sidebar, the card.
        var rects: [4]i32 = [4]i32{ 0, 0, host_module.width(c.*.host), host_module.height(c.*.host) }
        host_module.setBlur(c.*.host, &rects, 1)
        redraw(c)
        return
    }
    if kind == ui_app.EVENT_KEY {
        if b == 0 { return }
        onKey(c, a)
        redraw(c)
        return
    }
    const widgets = uiOf(c)
    // The text takes its own presses and drags.
    if !c.*.choosing && hasDocument(c) {
        if kind == ui_app.EVENT_BUTTON && a == ui_app.BUTTON_LEFT {
            const x = widgets.*.pointerX
            const y = widgets.*.pointerY
            if b == 1 && inText(c, x, y) {
                const editor = current(c)
                const offset = offsetAtPoint(c, x, y)
                const now = std.time.milliseconds()
                const shift = host_module.modifiers(c.*.host) & keys.SHIFT != 0
                if now >= c.*.lastPress && now - c.*.lastPress < 400 && offset == c.*.lastOffset {
                    var start: usize = 0
                    var end: usize = 0
                    editor_module.wordAt(editor, offset, &start, &end)
                    editor_module.moveTo(editor, start, false)
                    editor_module.moveTo(editor, end, true)
                    c.*.dragging = false
                } else {
                    editor_module.moveTo(editor, offset, shift)
                    c.*.dragging = true
                }
                c.*.lastPress = now
                c.*.lastOffset = offset
                if c.*.asking == ASK_FIND { view.setFocus(widgets, idOf(ID_TEXT)) }
                _ = ui_app.feed(widgets, kind, a, b)
                redraw(c)
                return
            }
            if b == 0 && c.*.dragging {
                c.*.dragging = false
                _ = ui_app.feed(widgets, kind, a, b)
                redraw(c)
                return
            }
        }
        if kind == ui_app.EVENT_MOTION && c.*.dragging {
            _ = ui_app.feed(widgets, kind, a, b)
            const editor = current(c)
            editor_module.moveTo(editor, offsetAtPoint(c, widgets.*.pointerX, widgets.*.pointerY), true)
            keepCursorShown(c)
            redraw(c)
            return
        }
        if kind == ui_app.EVENT_WHEEL && a == 0 {
            const editor = current(c)
            var pixels = host_module.wheelPixels(c.*.host)
            if pixels == 0 { pixels = b * px(c, LINE * 3) }
            var lines = pixels / px(c, LINE)
            if lines == 0 { lines = if pixels > 0 { 1 } else if pixels < 0 { -1 } else { 0 } }
            var top = @intCast(isize, editor.*.top) + @intCast(isize, lines)
            if top < 0 { top = 0 }
            if top >= @intCast(isize, editor.*.lineCount) { top = @intCast(isize, editor.*.lineCount) - 1 }
            editor.*.top = @intCast(usize, top)
            redraw(c)
            return
        }
    }
    if ui_app.pressing(kind, a, b) { layOut(c) }
    const fed = ui_app.feed(widgets, kind, a, b)
    if fed == ui_app.FEED_CLICK {
        layOut(c)
        updateTitle(c)
    }
    if fed != ui_app.FEED_NONE { redraw(c) }
}

pub fn main(arguments: [][*]const u8) -> !void {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(Comet), 16)
    if memory == null { return }
    const c: *Comet = unsafe { @ptrCast(*Comet, memory.?) }
    c.*.ready = false
    c.*.scale = 1
    c.*.fontScale = 0
    c.*.count = 0
    c.*.current = 0
    c.*.charWidth = 8
    c.*.rows = 20
    c.*.textLeft = 0
    c.*.textTop = 0
    c.*.textRight = 0
    c.*.textBottom = 0
    c.*.dragging = false
    c.*.lastPress = 0
    c.*.lastOffset = 0
    c.*.choosing = false
    c.*.asking = ASK_NONE
    c.*.noteLength = 0
    c.*.noteDanger = false
    var index: usize = 0
    while index < DOCUMENTS {
        c.*.documents[index].editor.ready = false
        index += 1
    }
    c.*.chooser = chooser_module.Chooser.init()
    field_module.init(fieldOf(c))
    const host = host_module.create(host_module.Options.{ .title = "Comet", .appId = "org.mlx.comet", .width = 980, .height = 680, .minWidth = 560, .minHeight = 360 }, c, draw, onEvent)
    if host == null { return }
    c.*.host = host.?
    try host_module.open(c.*.host, arguments)
    c.*.german = clock.germanLocale(host_module.environment(c.*.host))
    fitScale(c)
    // The files named (not the options), or a new text.
    var argument: usize = 1
    while argument < arguments.length {
        const name = std.text.cString(arguments[argument])
        if name.length > 0 && name[0] != 45 { openPath(c, name) }
        argument += 1
    }
    if c.*.count == 0 { newDocument(c) }
    c.*.current = 0
    updateTitle(c)
    view.setFocus(uiOf(c), idOf(ID_TEXT))
    c.*.ready = true
    redraw(c)
    try host_module.run(c.*.host)
}
