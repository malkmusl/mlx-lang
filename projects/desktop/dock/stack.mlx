// The dock's folder stacks (part of main.mlx, split from it): a pinned
// folder's newest entries in a popup over its icon, their pictures from
// the thumbnail cache, an Open button, and the file manager's window
// growing out of the stack when a folder opens. Entries drag out of it
// as file:// URIs (to the file manager, any other app, the trash), and
// files dropped on it go into its folder or into the folder entry they
// land on: moved when they came from the stack, else copied.
const std = @import("std")
const png = @import("std.png")
const apps_module = @import("../shared/apps.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")
const panel_menu = @import("std.ui.wayland.panel_menu")
const panel_drag = @import("std.ui.wayland.panel_drag")
const places = @import("../shared/places.mlx")
const icons = @import("../shared/icons.mlx")
const thumbs_module = @import("../shared/thumbs.mlx")
const palette = @import("../shared/palette.mlx")
const theme_module = @import("std.ui.theme")
const dock_module = @import("./main.mlx")

const Canvas = canvas_module.Canvas

// A folder's stack view: a grid of its entries (newest first) under a
// header with its name and an Open button, scrolled by rows.
const STACK_COLUMNS: i32 = 5
const STACK_ROWS: i32 = 3
const STACK_CELL_WIDTH: i32 = 92
const STACK_CELL_HEIGHT: i32 = 92
const STACK_HEADER: i32 = 46
const STACK_PADDING: i32 = 12
const STACK_ICON: i32 = 52
pub const STACK_OPEN: usize = dock_module.NONE - 1

fn stackRows(dock: *dock_module.Dock) -> i32 {
    return (@intCast(i32, dock_module.listingOf(dock).*.count) + STACK_COLUMNS - 1) / STACK_COLUMNS
}

fn stackVisibleRows(dock: *dock_module.Dock) -> i32 {
    const rows = stackRows(dock)
    if rows < 1 { return 1 }
    return if rows > STACK_ROWS { STACK_ROWS } else { rows }
}

fn stackWidth() -> i32 { return STACK_COLUMNS * STACK_CELL_WIDTH + STACK_PADDING * 2 }
fn stackHeight(dock: *dock_module.Dock) -> i32 { return STACK_HEADER + stackVisibleRows(dock) * STACK_CELL_HEIGHT + STACK_PADDING }

fn openButtonLeft() -> i32 { return stackWidth() - STACK_PADDING - 70 }

// What stack point (x, y) is over: an entry, STACK_OPEN, or dock_module.NONE.
pub fn stackAt(dock: *dock_module.Dock, x: i32, y: i32) -> usize {
    if y >= 10 && y < STACK_HEADER - 8 && x >= openButtonLeft() && x < stackWidth() - STACK_PADDING { return STACK_OPEN }
    if y < STACK_HEADER || x < STACK_PADDING || x >= stackWidth() - STACK_PADDING { return dock_module.NONE }
    const column = (x - STACK_PADDING) / STACK_CELL_WIDTH
    const row = (y - STACK_HEADER) / STACK_CELL_HEIGHT
    if row >= stackVisibleRows(dock) { return dock_module.NONE }
    const index = @intCast(usize, (row + dock.*.stackScroll) * STACK_COLUMNS + column)
    return if index < dock_module.listingOf(dock).*.count { index } else { dock_module.NONE }
}

pub fn dropThumbs(dock: *dock_module.Dock) -> void {
    var index: usize = 0
    while index < dock_module.THUMBS {
        if dock.*.thumbState[index] == 1 { png.deinit(dock_module.thumbAt(dock, index)) }
        dock.*.thumbState[index] = 0
        index += 1
    }
}

pub fn closeStack(dock: *dock_module.Dock) -> void {
    dock.*.stackOpening = 0
    thumbs_module.clearQueue(picturesOf(dock))
    dock_module.panelOf(dock).*.tickInterval = 1000
    if dock.*.stackItem == dock_module.NONE { return }
    dock.*.stackItem = dock_module.NONE
    dropThumbs(dock)
    panel_menu.closeMenu(dock_module.panelOf(dock))
}

pub fn openStack(dock: *dock_module.Dock, index: usize) -> void {
    const item = dock_module.itemAt(dock, index)
    var path: apps_module.Path = undefined
    if !places.expand(dock.*.environment, dock_module.appIdOf(item), &path) { return }
    dropThumbs(dock)
    places.list(apps_module.pathEnd(&path), dock_module.listingOf(dock))
    dock.*.stackScroll = 0
    dock.*.stackHover = dock_module.NONE
    dock.*.stackItem = index
    // Faster ticks while pictures may be coming (stackTick).
    dock_module.panelOf(dock).*.tickInterval = 150
    dock_module.panelOf(dock).*.nextTick = 0
    dock.*.menuItem = dock_module.NONE
    dock.*.hover = dock_module.NONE
    dock.*.pointerIn = false
    dock_module.panelOf(dock).*.dirty = true
    if !panel_menu.openMenu(dock_module.panelOf(dock), item.*.x, dock_module.barTop(dock) - 4, item.*.size, 4, panel_module.PLACE_TOP, @intCast(u32, stackWidth()), @intCast(u32, stackHeight(dock)), drawStack) { dock.*.stackItem = dock_module.NONE }
}

// The path of entry `index` of the open stack (or the folder itself for
// dock_module.NONE) into `into`.
fn stackPath(dock: *dock_module.Dock, index: usize, into: *apps_module.Path) -> bool {
    if dock.*.stackItem == dock_module.NONE || dock.*.stackItem >= dock.*.itemCount { return false }
    if !places.expand(dock.*.environment, dock_module.appIdOf(dock_module.itemAt(dock, dock.*.stackItem)), into) { return false }
    if index != dock_module.NONE {
        apps_module.pathAdd(into, "/")
        apps_module.pathAdd(into, places.listedName(dock_module.listingOf(dock), index))
    }
    return true
}

pub fn stackClick(dock: *dock_module.Dock, index: usize) -> void {
    if dock.*.stackOpening != 0 { return }
    var path: apps_module.Path = undefined
    const found = stackPath(dock, if index == STACK_OPEN { dock_module.NONE } else { index }, &path)
    if !found {
        closeStack(dock)
        return
    }
    // A folder: the file manager's window grows out of the stack (the
    // compositor closes it then).
    const folder = index == STACK_OPEN || places.listedDirectory(dock_module.listingOf(dock), index)
    if folder && zoomFromStack(dock) {
        dock.*.stackOpening = panel_module.milliseconds()
        dock.*.stackHover = dock_module.NONE
        panel_menu.menuChanged(dock_module.panelOf(dock))
    } else {
        closeStack(dock)
    }
    places.open(path.bytes[0..path.length], dock.*.environment)
}

// Tells the compositor the next window comes out of the stack (z); false
// without it.
fn zoomFromStack(dock: *dock_module.Dock) -> bool {
    if dock.*.channel < 0 { return false }
    var byte: [1]u8 = [1]u8{ 122 }
    const sent = std.linux.syscall6(std.linux.SYS_sendto, @bitCast(usize, dock.*.channel), @intFromPtr(&byte), 1, 64 | 16384, 0, 0)
    return sent == 1
}

// Tells the compositor the next window comes out of an item's icon (Z and
// its rectangle on the dock).
pub fn zoomFromItem(dock: *dock_module.Dock, item: *dock_module.Item) -> void {
    if dock.*.channel < 0 { return }
    const size = if item.*.size > 0 { item.*.size } else { dock_module.ICON }
    var values: [4]i32 = [4]i32{ item.*.x, dock_module.barTop(dock) + dock_module.BAR_HEIGHT - 8 - size, size, size }
    var message: [17]u8 = undefined
    message[0] = 90
    var value: usize = 0
    while value < 4 {
        const bits = @bitCast(u32, values[value])
        message[1 + value * 4] = @intCast(u8, bits & 255)
        message[2 + value * 4] = @intCast(u8, (bits >> 8) & 255)
        message[3 + value * 4] = @intCast(u8, (bits >> 16) & 255)
        message[4 + value * 4] = @intCast(u8, bits >> 24)
        value += 1
    }
    _ = std.linux.syscall6(std.linux.SYS_sendto, @bitCast(usize, dock.*.channel), @intFromPtr(&message), 17, 64 | 16384, 0, 0)
}

pub fn stackScrollBy(dock: *dock_module.Dock, rows: i32) -> void {
    const last = stackRows(dock) - stackVisibleRows(dock)
    var scroll = dock.*.stackScroll + rows
    if scroll > last { scroll = last }
    if scroll < 0 { scroll = 0 }
    if scroll == dock.*.stackScroll { return }
    dock.*.stackScroll = scroll
    dock.*.stackHover = dock_module.NONE
    panel_menu.menuChanged(dock_module.panelOf(dock))
}

pub fn picturesOf(dock: *dock_module.Dock) -> *thumbs_module.Thumbs {
    unsafe { return @ptrCast(*thumbs_module.Thumbs, &dock.*.pictures) }
}

// The picture of entry `index` (from the thumbnail cache, a few each
// drawing; the worker makes missing ones of PNG files), else null. Never
// waits on the file itself: a folder of big screenshots opens at once.
fn thumbOf(dock: *dock_module.Dock, index: usize) -> ?*png.Image {
    if index >= dock_module.THUMBS || places.listedDirectory(dock_module.listingOf(dock), index) { return null }
    if dock.*.thumbState[index] == 0 {
        if dock.*.thumbBudget == 0 {
            dock.*.thumbState[index] = 3
            return null
        }
        dock.*.thumbBudget -= 1
        dock.*.thumbState[index] = 2
        var path: apps_module.Path = undefined
        if stackPath(dock, index, &path) {
            const listing = dock_module.listingOf(dock)
            const modified = listing.*.times[listing.*.order[index]]
            const found = thumbs_module.lookup(picturesOf(dock), path.bytes[0..path.length], modified, @intCast(usize, STACK_ICON), dock_module.thumbAt(dock, index))
            if found == thumbs_module.READY { dock.*.thumbState[index] = 1 }
            if found == thumbs_module.COMING { dock.*.thumbState[index] = 3 }
        }
    }
    if dock.*.thumbState[index] != 1 { return null }
    return dock_module.thumbAt(dock, index)
}

// While the stack shows: the thumbnail worker's progress, and the pictures
// still coming looked up again.
pub fn stackTick(dock: *dock_module.Dock) -> void {
    thumbs_module.pump(picturesOf(dock))
    if dock.*.stackItem == dock_module.NONE {
        dock_module.panelOf(dock).*.tickInterval = if thumbs_module.busy(picturesOf(dock)) { 150 } else { 1000 }
        return
    }
    var waiting = false
    var index: usize = 0
    while index < dock_module.THUMBS {
        if dock.*.thumbState[index] == 3 {
            dock.*.thumbState[index] = 0
            waiting = true
        }
        index += 1
    }
    if waiting { panel_menu.menuChanged(dock_module.panelOf(dock)) }
    const panel = dock_module.panelOf(dock)
    panel.*.tickInterval = if waiting || thumbs_module.busy(picturesOf(dock)) { 150 } else { 1000 }
}

// Entry `index`'s icon (its picture, a folder or a file) at (x, y).
fn drawEntryIcon(dock: *dock_module.Dock, canvas: *Canvas, index: usize, x: i32, y: i32) -> void {
    const listing = dock_module.listingOf(dock)
    const name = places.listedName(listing, index)
    const thumb = thumbOf(dock, index)
    if places.listedDirectory(listing, index) {
        icons.drawFolder(dock_module.smallOf(dock), canvas, name, x, y, STACK_ICON)
    } else if thumb != null {
        const image = thumb.?
        const w = @intCast(i32, image.*.width)
        const h = @intCast(i32, image.*.height)
        canvas_module.drawImageRect(canvas, image, x + (STACK_ICON - w) / 2, y + (STACK_ICON - h) / 2, w, h, 255)
    } else {
        icons.drawFile(dock_module.smallOf(dock), canvas, name, x, y, STACK_ICON)
    }
}

fn drawStack(context: *anyopaque, canvas: *Canvas) -> void {
    const dock = dock_module.dockOf(context)
    dock.*.thumbBudget = dock_module.THUMB_BUDGET
    const width = @intCast(i32, canvas.*.width)
    const height = @intCast(i32, canvas.*.height)
    const small = dock_module.smallOf(dock)
    // Light or dark as the desktop is.
    const colors = palette.at(panel_module.lightness(dock_module.panelOf(dock)))
    const white = palette.ink(&colors, 255)
    canvas_module.clear(canvas, 0)
    canvas_module.fillRoundedRect(canvas, 0, 0, width, height, 14, colors.popup)
    canvas_module.strokeRoundedRect(canvas, 0, 0, width, height, 14, 1, colors.edge)
    // The header: the folder's name and Open.
    if dock.*.stackItem != dock_module.NONE && dock.*.stackItem < dock.*.itemCount {
        text_module.drawText(canvas, small, places.baseName(dock_module.appIdOf(dock_module.itemAt(dock, dock.*.stackItem))), STACK_PADDING + 4, 16, white, openButtonLeft() - STACK_PADDING - 12)
    }
    const open_lit = dock.*.stackHover == STACK_OPEN
    const button = if open_lit { canvas_module.color(255, 90, 160, 255) } else { theme_module.mix(canvas_module.color(255, 58, 62, 74), canvas_module.color(255, 228, 229, 236), colors.t) }
    canvas_module.fillRoundedRect(canvas, openButtonLeft(), 10, 70, STACK_HEADER - 18, 8, button)
    const open_width = text_module.measure(small, "Open")
    text_module.drawText(canvas, small, "Open", openButtonLeft() + (70 - open_width) / 2, 15, if open_lit { canvas_module.color(255, 255, 255, 255) } else { white }, 0)
    canvas_module.fillRect(canvas, STACK_PADDING, STACK_HEADER - 2, width - STACK_PADDING * 2, 1, colors.line)
    const listing = dock_module.listingOf(dock)
    if listing.*.count == 0 {
        const empty = "No files"
        text_module.drawText(canvas, small, empty, (width - text_module.measure(small, empty)) / 2, STACK_HEADER + 30, palette.ink(&colors, 150), 0)
        return
    }
    var row: i32 = 0
    while row < stackVisibleRows(dock) {
        var column: i32 = 0
        while column < STACK_COLUMNS {
            const index = @intCast(usize, (row + dock.*.stackScroll) * STACK_COLUMNS + column)
            if index < listing.*.count {
                const x = STACK_PADDING + column * STACK_CELL_WIDTH
                const y = STACK_HEADER + row * STACK_CELL_HEIGHT
                if index == dock.*.stackHover { canvas_module.fillRoundedRect(canvas, x + 3, y + 3, STACK_CELL_WIDTH - 6, STACK_CELL_HEIGHT - 6, 10, theme_module.mix(canvas_module.color(255, 52, 58, 74), canvas_module.color(255, 228, 229, 236), colors.t)) }
                const name = places.listedName(listing, index)
                const icon_y = y + 8
                drawEntryIcon(dock, canvas, index, x + (STACK_CELL_WIDTH - STACK_ICON) / 2, icon_y)
                var buffer: [100]u8 = undefined
                const bytes: [*]u8 = &buffer
                const shown = icons.fitText(small, name, STACK_CELL_WIDTH - 8, bytes)
                text_module.drawText(canvas, small, shown, x + (STACK_CELL_WIDTH - text_module.measure(small, shown)) / 2, icon_y + STACK_ICON + 6, white, 0)
            }
            column += 1
        }
        row += 1
    }
    // Where the rows shown are among all of them.
    const rows = stackRows(dock)
    if rows > STACK_ROWS {
        const track = height - STACK_HEADER - STACK_PADDING - 8
        const bar = track * STACK_ROWS / rows
        const top = STACK_HEADER + 4 + track * dock.*.stackScroll / rows
        canvas_module.fillRoundedRect(canvas, width - 8, top, 4, bar, 2, palette.ink(&colors, 110))
    }
}

// ---------------------------------------------------------------------------
// Dragging out of the stack and dropping into it

// How far the pointer moves with the button down before an entry drags.
const DRAG_DISTANCE: i32 = 6

// The pointer over the stack at (x, y); with the button down on an entry
// and far enough from where it went down, the entry drags out (true).
pub fn pointerAt(dock: *dock_module.Dock, x: i32, y: i32) -> bool {
    dock.*.stackPointerX = x
    dock.*.stackPointerY = y
    const index = dock.*.stackPress
    if index == dock_module.NONE || index == STACK_OPEN || dock.*.stackDragged != dock_module.NONE { return false }
    const dx = x - dock.*.stackPressX
    const dy = y - dock.*.stackPressY
    if dx * dx + dy * dy < DRAG_DISTANCE * DRAG_DISTANCE { return false }
    dock.*.stackPress = dock_module.NONE
    var path: apps_module.Path = undefined
    if !stackPath(dock, index, &path) { return false }
    var uri: [2048]u8 = undefined
    var length = places.addFileUri(&uri, 0, 2046, path.bytes[0..path.length])
    if length == 0 { return false }
    uri[length] = 13
    uri[length + 1] = 10
    length += 2
    dock.*.stackDragged = index
    if !panel_drag.startDrag(dock_module.panelOf(dock), "text/uri-list", uri[0..length], @intCast(u32, STACK_ICON), drawDragIcon) {
        dock.*.stackDragged = dock_module.NONE
        return false
    }
    dock.*.stackHover = dock_module.NONE
    panel_menu.menuChanged(dock_module.panelOf(dock))
    return true
}

// The left button went down (`down`) or up over the stack; up on an entry
// (not after a drag) opens it.
pub fn button(dock: *dock_module.Dock, down: bool) -> void {
    if down {
        dock.*.stackPress = dock.*.stackHover
        dock.*.stackPressX = dock.*.stackPointerX
        dock.*.stackPressY = dock.*.stackPointerY
        return
    }
    const pressed = dock.*.stackPress
    dock.*.stackPress = dock_module.NONE
    if pressed != dock_module.NONE && dock.*.stackHover != dock_module.NONE { stackClick(dock, dock.*.stackHover) }
}

fn drawDragIcon(context: *anyopaque, canvas: *Canvas) -> void {
    const dock = dock_module.dockOf(context)
    const index = dock.*.stackDragged
    if index != dock_module.NONE && index < dock_module.listingOf(dock).*.count { drawEntryIcon(dock, canvas, index, 0, 0) }
}

// The stack's folder read again (files came or went), its pictures with
// it.
pub fn relist(dock: *dock_module.Dock) -> void {
    if dock.*.stackItem == dock_module.NONE { return }
    var path: apps_module.Path = undefined
    if !stackPath(dock, dock_module.NONE, &path) { return }
    dropThumbs(dock)
    places.list(apps_module.pathEnd(&path), dock_module.listingOf(dock))
    const last = stackRows(dock) - stackVisibleRows(dock)
    if dock.*.stackScroll > last { dock.*.stackScroll = if last > 0 { last } else { 0 } }
    dock.*.stackHover = dock_module.NONE
    panel_menu.menuChanged(dock_module.panelOf(dock))
}

// A drag out of the stack ended (`dropped`: somewhere took it).
pub fn dragEnded(dock: *dock_module.Dock, dropped: bool) -> void {
    if dock.*.stackDragged == dock_module.NONE { return }
    dock.*.stackDragged = dock_module.NONE
    if dropped { relist(dock) }
}

// A drag over the stack at (x, y): the folder entry under it lights up
// (what is dropped goes into it), else the stack's folder takes it.
pub fn dragOver(dock: *dock_module.Dock, x: i32, y: i32) -> void {
    if dock.*.stackItem == dock_module.NONE { return }
    const at = stackAt(dock, x, y)
    var entry = dock_module.NONE
    if at != dock_module.NONE && at != STACK_OPEN && at != dock.*.stackDragged && places.listedDirectory(dock_module.listingOf(dock), at) { entry = at }
    dock.*.dropOnStack = true
    if entry == dock.*.stackDropEntry && entry == dock.*.stackHover { return }
    dock.*.stackDropEntry = entry
    dock.*.stackHover = entry
    panel_menu.menuChanged(dock_module.panelOf(dock))
}

pub fn dragLeft(dock: *dock_module.Dock) -> void {
    if !dock.*.dropOnStack { return }
    dock.*.dropOnStack = false
    dock.*.stackDropEntry = dock_module.NONE
    dock.*.stackHover = dock_module.NONE
    panel_menu.menuChanged(dock_module.panelOf(dock))
}

// What was dropped on the stack (a text/uri-list) goes into its folder
// or the folder entry it landed on.
pub fn dropOn(dock: *dock_module.Dock, data: []const u8) -> void {
    const entry = dock.*.stackDropEntry
    dragLeft(dock)
    var folder: apps_module.Path = undefined
    if !stackPath(dock, entry, &folder) { return }
    const moving = dock.*.stackDragged != dock_module.NONE
    if places.transferList(data, folder.bytes[0..folder.length], moving) > 0 { dock_module.say("mlx-dock: some files could not be put into the folder\n") }
    relist(dock)
}
