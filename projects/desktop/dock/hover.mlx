// The window previews the pointer brings up (part of main.mlx, split from
// it): resting on the icon of an app that has windows for HOVER_DELAY
// milliseconds asks the compositor for their previews over the icon. While
// they show, the pointer on another icon swaps in that app's at once, and
// an icon without windows takes them away; between the icons and past the
// ends they stay. A click on the icon brings the app's next window forward
// and a right click opens its menu; either takes the previews away. The
// compositor closes them itself when the pointer leaves both them and the
// bar (or on Escape, a click on one) and says so, and the pointer then
// waits on another icon before they come again.
const std = @import("std")
const panel_module = @import("std.ui.wayland.panel")
const dock_module = @import("./main.mlx")

const Dock = dock_module.Dock
const Item = dock_module.Item
const NONE = dock_module.NONE

// To the compositor: 104 'h', a count (at most WINDOWS, 0: none), that many
// u32 handle object ids, then (with any) the icon's middle on the dock as
// an i32. From it: 118 'v', no hover previews show (they closed, or the
// previews a click opened are in the way).
const MESSAGE_HOVER: u8 = 104
pub const MESSAGE_CLOSED: u8 = 118
pub const WINDOWS: usize = 8
pub const MESSAGE: usize = 38

const HOVER_DELAY: usize = 600
// Ticks while the delay runs (the dock's own come once a second).
const HOVER_TICK: usize = 100

pub fn start(dock: *Dock) -> void {
    dock.*.hoverItem = NONE
    dock.*.hoverSince = 0
    dock.*.previewItem = NONE
}

// Puts the handle object ids of `item`'s windows (at most WINDOWS) into
// `message` from byte 2; how many.
pub fn putWindows(dock: *Dock, item: *Item, message: *[38]u8) -> usize {
    const panel = dock_module.panelOf(dock)
    var count: usize = 0
    var index: usize = 0
    while index < panel.*.windowCount && count < WINDOWS {
        const window = panel_module.windowAt(panel, index)
        if dock_module.owns(dock, item, window) {
            putU32(message, 2 + count * 4, window.*.handle.id())
            count += 1
        }
        index += 1
    }
    return count
}

fn putU32(message: *[38]u8, at: usize, value: u32) -> void {
    message.*[at] = @intCast(u8, value & 255)
    message.*[at + 1] = @intCast(u8, (value >> 8) & 255)
    message.*[at + 2] = @intCast(u8, (value >> 16) & 255)
    message.*[at + 3] = @intCast(u8, value >> 24)
}

// Whether item `index` would show previews now: an app with windows, no
// menu, stack or drag of the dock's own in the way, a compositor to ask.
fn wants(dock: *Dock, index: usize) -> bool {
    if dock.*.channel < 0 || index >= dock.*.itemCount { return false }
    if dock.*.menuItem != NONE || dock.*.stackItem != NONE { return false }
    if dock.*.dropAt != NONE || dock.*.dropFolder != NONE || dock.*.dropOnTrash { return false }
    return dock_module.itemAt(dock, index).*.running > 0
}

// The delay runs: the pointer rests on an icon that wants previews and
// none show.
fn waiting(dock: *Dock) -> bool {
    return dock.*.previewItem == NONE && dock.*.hoverSince != 0 && dock.*.pointerIn && wants(dock, dock.*.hoverItem)
}

// Asks for item `index`'s previews (NONE, or an icon without windows: the
// ones shown go).
fn ask(dock: *Dock, index: usize) -> void {
    var message: [38]u8 = undefined
    message[0] = MESSAGE_HOVER
    var count: usize = 0
    var item: *Item = undefined
    if index != NONE && index < dock.*.itemCount {
        item = dock_module.itemAt(dock, index)
        count = putWindows(dock, item, &message)
    }
    if count == 0 && dock.*.previewItem == NONE { return }
    message[1] = @intCast(u8, count)
    var length = 2 + count * 4
    if count > 0 {
        putU32(&message, length, @bitCast(u32, item.*.x + item.*.size / 2))
        length += 4
    }
    // sendto with MSG_DONTWAIT | MSG_NOSIGNAL, as the dock's other asks.
    _ = std.linux.syscall6(std.linux.SYS_sendto, @bitCast(usize, dock.*.channel), @intFromPtr(&message), length, 64 | 16384, 0, 0)
    dock.*.previewItem = if count > 0 { index } else { NONE }
    // The icon's name gives way to the previews (draw).
    dock_module.panelOf(dock).*.dirty = true
}

// The pointer moved on the bar, onto item `index` (NONE: none).
pub fn moved(dock: *Dock, index: usize) -> void {
    if index == dock.*.hoverItem { return }
    dock.*.hoverItem = index
    dock.*.hoverSince = panel_module.milliseconds()
    if dock.*.hoverSince == 0 { dock.*.hoverSince = 1 }
    if dock.*.previewItem != NONE {
        if index != NONE && index != dock.*.previewItem { ask(dock, if wants(dock, index) { index } else { NONE }) }
        return
    }
    if !waiting(dock) { return }
    const panel = dock_module.panelOf(dock)
    panel.*.tickInterval = HOVER_TICK
    const due = dock.*.hoverSince + HOVER_TICK
    if panel.*.nextTick == 0 || panel.*.nextTick > due { panel.*.nextTick = due }
}

// The pointer left the bar (perhaps for the previews: the compositor
// decides whether they stay).
pub fn left(dock: *Dock) -> void {
    dock.*.hoverItem = NONE
    dock.*.hoverSince = 0
}

// A tick: the delay seen out asks for the previews; until then the ticks
// come faster.
pub fn tick(dock: *Dock) -> void {
    if !waiting(dock) { return }
    if panel_module.milliseconds() >= dock.*.hoverSince + HOVER_DELAY {
        ask(dock, dock.*.hoverItem)
        return
    }
    const panel = dock_module.panelOf(dock)
    if panel.*.tickInterval > HOVER_TICK { panel.*.tickInterval = HOVER_TICK }
}

// The previews go (a click, a menu); they come again from another icon.
pub fn hide(dock: *Dock) -> void {
    ask(dock, NONE)
    dock.*.hoverSince = 0
}

// The compositor says none show.
pub fn closed(dock: *Dock) -> void {
    dock.*.previewItem = NONE
    dock.*.hoverSince = 0
    dock_module.panelOf(dock).*.dirty = true
}
