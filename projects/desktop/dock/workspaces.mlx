// The dock's apps by workspace (part of main.mlx, split from it): the
// compositor says on the dock's channel which workspace each window is on
// (its launching.mlx notifyDock; the foreign-toplevel protocol carries no
// workspaces) and whether the dock groups by them (its dock-workspaces
// setting). Grouped, the apps that run come after the pinned ones in a
// group per workspace, the first workspace first, an app with windows on
// two workspaces in both; each group starts with a separator that carries
// the workspace's number, drawn like the top bar's workspace buttons (the
// one shown lit).
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")
const palette = @import("../shared/palette.mlx")
const dock_module = @import("./main.mlx")
const hover = @import("./hover.mlx")

const Canvas = canvas_module.Canvas
const Dock = dock_module.Dock
const Window = panel_module.Window

// The compositor's message: 119 'w', 1 to group (else 0), the workspace
// shown, a count and that many u32 handle object ids each with a u8
// workspace. At most WINDOWS of them, on its nine workspaces; the channel
// is a stream, so a message may come in parts (INCOMING bytes are kept).
const MESSAGE_WORKSPACES: u8 = 119
pub const WINDOWS: usize = 64
pub const COUNT: usize = 9
pub const INCOMING: usize = 1024

// The label's pill over a group's separator.
const LABEL_WIDTH: i32 = 15
const LABEL_HEIGHT: i32 = 18
const LABEL_TOP: i32 = 7

// The workspace `window` is on (the one shown while the compositor has not
// named it yet).
pub fn windowWorkspace(dock: *Dock, window: *Window) -> usize {
    const id = window.*.handle.id()
    var index: usize = 0
    while index < dock.*.workspaceCount {
        if dock.*.workspaceIds[index] == id { return @intCast(usize, dock.*.workspaceOf[index]) }
        index += 1
    }
    return dock.*.currentWorkspace
}

// Reads what the compositor sent; true when the items should be built
// again. The end of the channel ends us (the compositor starts a new dock
// with itself).
pub fn listen(dock: *Dock) -> bool {
    const room = INCOMING - dock.*.incomingLength
    const count = std.linux.syscall3(0, @bitCast(usize, dock.*.channel), @intFromPtr(&dock.*.incoming) + dock.*.incomingLength, room)
    if count == 0 {
        dock_module.panelOf(dock).*.running = false
        return false
    }
    if count < 0 { return false }
    const length = dock.*.incomingLength + @intCast(usize, count)
    var changed = false
    var at: usize = 0
    while at < length {
        if dock.*.incoming[at] == hover.MESSAGE_CLOSED {
            hover.closed(dock)
            at += 1
            continue
        }
        if dock.*.incoming[at] != MESSAGE_WORKSPACES {
            // Nothing we know: the rest cannot be told apart either.
            at = length
            break
        }
        if at + 4 > length { break }
        const size = 4 + @intCast(usize, dock.*.incoming[at + 3]) * 5
        if at + size > length { break }
        if apply(dock, at) { changed = true }
        at += size
    }
    // A message not all here yet waits at the front for its rest; one too
    // long for the buffer is dropped.
    var kept: usize = 0
    while at + kept < length {
        dock.*.incoming[kept] = dock.*.incoming[at + kept]
        kept += 1
    }
    dock.*.incomingLength = if kept == INCOMING { 0 } else { kept }
    return changed
}

// Takes the message at `at`; true when it changes what the dock shows
// (grouped, any change does: a lit number or a window that moved).
fn apply(dock: *Dock, at: usize) -> bool {
    const group = dock.*.incoming[at + 1] != 0
    const regrouped = group != dock.*.groupWorkspaces
    dock.*.groupWorkspaces = group
    const current = @intCast(usize, dock.*.incoming[at + 2])
    dock.*.currentWorkspace = if current < COUNT { current } else { 0 }
    const count = @intCast(usize, dock.*.incoming[at + 3])
    var index: usize = 0
    while index < count && index < WINDOWS {
        const from = at + 4 + index * 5
        dock.*.workspaceIds[index] = @intCast(u32, dock.*.incoming[from]) | (@intCast(u32, dock.*.incoming[from + 1]) << 8) | (@intCast(u32, dock.*.incoming[from + 2]) << 16) | (@intCast(u32, dock.*.incoming[from + 3]) << 24)
        const workspace = dock.*.incoming[from + 4]
        dock.*.workspaceOf[index] = if @intCast(usize, workspace) < COUNT { workspace } else { 0 }
        index += 1
    }
    dock.*.workspaceCount = index
    return group || regrouped
}

// Says in the log which workspaces have groups and which is shown, when
// that changed: "mlx-dock: by workspace: 1 2, 2 shown".
pub fn report(dock: *Dock) -> void {
    if !dock.*.groupWorkspaces {
        if dock.*.reportedGroups != 0 { dock_module.say("mlx-dock: not by workspace\n") }
        dock.*.reportedGroups = 0
        return
    }
    var line: [64]u8 = undefined
    var length: usize = 0
    for byte in "mlx-dock: by workspace:" {
        line[length] = byte
        length += 1
    }
    var index = dock.*.pinnedCount
    while index < dock.*.folderStart {
        if dock_module.groupStart(dock, index) {
            line[length] = 32
            line[length + 1] = @intCast(u8, 49 + dock_module.itemAt(dock, index).*.workspace)
            length += 2
        }
        index += 1
    }
    if dock.*.pinnedCount >= dock.*.folderStart {
        for byte in " none" {
            line[length] = byte
            length += 1
        }
    }
    for byte in ", " {
        line[length] = byte
        length += 1
    }
    line[length] = @intCast(u8, 49 + dock.*.currentWorkspace)
    length += 1
    for byte in " shown\n" {
        line[length] = byte
        length += 1
    }
    var signature: usize = 5381
    var at: usize = 0
    while at < length {
        signature = signature *% 33 +% @intCast(usize, line[at])
        at += 1
    }
    signature |= 1
    if signature == dock.*.reportedGroups { return }
    dock.*.reportedGroups = signature
    const bytes: [*]const u8 = &line
    dock_module.say(bytes[0..length])
}

// A group's separator at `x` on the bar whose top is `top`: the pill with
// the workspace's number, the line below it.
pub fn drawLabel(dock: *Dock, canvas: *Canvas, colors: *const palette.Palette, x: i32, top: i32, workspace: usize) -> void {
    const current = workspace == dock.*.currentWorkspace
    const left = x - LABEL_WIDTH / 2
    const pill_top = top + LABEL_TOP
    canvas_module.fillRoundedRect(canvas, left, pill_top, LABEL_WIDTH, LABEL_HEIGHT, 5, palette.ink(colors, if current { 230 } else { 60 }))
    var digit: [1]u8 = [1]u8{ @intCast(u8, 49 + workspace) }
    const digit_bytes: [*]const u8 = &digit
    const label = digit_bytes[0..1]
    const small = dock_module.smallOf(dock)
    const label_width = text_module.measure(small, label)
    text_module.drawText(canvas, small, label, left + (LABEL_WIDTH - label_width + 1) / 2, pill_top + 1, if current { colors.*.popup } else { palette.ink(colors, 255) }, 0)
    const line_top = pill_top + LABEL_HEIGHT + 5
    canvas_module.fillRect(canvas, x, line_top, 1, top + dock_module.BAR_HEIGHT - 12 - line_top, palette.ink(colors, 80))
}
