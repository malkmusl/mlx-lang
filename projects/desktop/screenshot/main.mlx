// mlx-screenshot: the screen, or one window, as a PNG, through the
// compositor's ext-image-copy-capture-v1 (with ext-image-capture-source-v1
// and ext-foreign-toplevel-list-v1). No libc, no libwayland.
//
//   mlx-screenshot FILE.png                   the screen
//   mlx-screenshot --window NAME FILE.png     the first window whose app id
//                                             or title is NAME
//   mlx-screenshot --list                     the windows: identifier, app
//                                             id, title
//   --frames N                                N frames in a row (each after
//                                             the last: the next waits until
//                                             something changed), the last
//                                             one saved; each says what
//                                             changed ("frame 2: damage
//                                             0,0 40x20")
//
// It prints "saved FILE.png (WxH)", or says why not (and fails).
const std = @import("std")
const wl = @import("std.wayland")
const png = @import("std.png")
const crash = @import("std.crash")

const MAX_WINDOWS: usize = 64
const NAME: usize = 64

const Window = struct {
    handle: wl.ext_foreign_toplevel_handle_v1.Proxy
    identifier: [32]u8
    identifierLength: usize
    appId: [64]u8
    appIdLength: usize
    title: [64]u8
    titleLength: usize
    closed: bool
}

const App = struct {
    display: wl.client.Display
    registry: wl.wl_registry.Proxy
    shm: wl.wl_shm.Proxy
    hasShm: bool
    output: wl.wl_output.Proxy
    hasOutput: bool
    outputSources: wl.ext_output_image_capture_source_manager_v1.Proxy
    hasOutputSources: bool
    toplevelSources: wl.ext_foreign_toplevel_image_capture_source_manager_v1.Proxy
    hasToplevelSources: bool
    captureManager: wl.ext_image_copy_capture_manager_v1.Proxy
    hasCaptureManager: bool
    toplevelList: wl.ext_foreign_toplevel_list_v1.Proxy
    hasToplevelList: bool
    windows: [64]Window
    windowCount: usize
    // The session's constraints: the buffer size, the formats offered
    // (bits: 1 ARGB8888, 2 XRGB8888), and whether they are complete.
    width: u32
    height: u32
    formats: u32
    constraintsDone: bool
    stopped: bool
    // The frame: ready, failed (and why), its damage.
    ready: bool
    failed: bool
    failure: u32
    damageX: i32
    damageY: i32
    damageWidth: i32
    damageHeight: i32
}

fn appOf(context: *anyopaque) -> *App {
    unsafe { return @ptrCast(*App, context) }
}

fn contextOf(app: *App) -> *anyopaque {
    unsafe { return @ptrCast(*anyopaque, app) }
}

fn minimum(left: u32, right: u32) -> u32 { return if left < right { left } else { right } }

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn onRegistry(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.wl_registry.decodeEvent(event)
    if @tagOf(decoded) != 0 { return }
    const global = decoded.global
    const registry = app.*.registry
    if named(global.interface, "wl_shm") {
        app.*.shm = wl.wl_shm.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_shm, 1))
        app.*.hasShm = true
    } else if named(global.interface, "wl_output") && !app.*.hasOutput {
        app.*.output = wl.wl_output.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_output, 1))
        app.*.output.setHandler(ignoreEvent, context)
        app.*.hasOutput = true
    } else if named(global.interface, "ext_output_image_capture_source_manager_v1") {
        app.*.outputSources = wl.ext_output_image_capture_source_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_output_image_capture_source_manager_v1, 1))
        app.*.hasOutputSources = true
    } else if named(global.interface, "ext_foreign_toplevel_image_capture_source_manager_v1") {
        app.*.toplevelSources = wl.ext_foreign_toplevel_image_capture_source_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 1))
        app.*.hasToplevelSources = true
    } else if named(global.interface, "ext_image_copy_capture_manager_v1") {
        app.*.captureManager = wl.ext_image_copy_capture_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_image_copy_capture_manager_v1, 1))
        app.*.hasCaptureManager = true
    } else if named(global.interface, "ext_foreign_toplevel_list_v1") {
        app.*.toplevelList = wl.ext_foreign_toplevel_list_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.ext_foreign_toplevel_list_v1, minimum(global.version, 1)))
        app.*.hasToplevelList = true
    }
}

fn ignoreEvent(context: *anyopaque, event: wl.client.Event) -> void {}

// ---------------------------------------------------------------------------
// The windows

fn copyText(target: [*]u8, text: std.string.String, capacity: usize) -> usize {
    const length = if text.length < capacity { text.length } else { capacity }
    var index: usize = 0
    while index < length {
        target[index] = text.pointer[index]
        index += 1
    }
    return length
}

fn windowOf(app: *App, event: wl.client.Event) -> usize {
    var index: usize = 0
    while index < app.*.windowCount {
        if app.*.windows[index].handle.object.id == event.object.id { return index }
        index += 1
    }
    return MAX_WINDOWS
}

fn onHandle(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const index = windowOf(app, event)
    if index == MAX_WINDOWS { return }
    const decoded = wl.ext_foreign_toplevel_handle_v1.decodeEvent(event)
    var bytes: [*]u8 = undefined
    if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_CLOSED {
        app.*.windows[index].closed = true
    } else if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_TITLE {
        unsafe { bytes = @ptrCast([*]u8, &app.*.windows[index].title) }
        app.*.windows[index].titleLength = copyText(bytes, decoded.title.title, NAME)
    } else if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_APP_ID {
        unsafe { bytes = @ptrCast([*]u8, &app.*.windows[index].appId) }
        app.*.windows[index].appIdLength = copyText(bytes, decoded.app_id.app_id, NAME)
    } else if event.opcode == wl.ext_foreign_toplevel_handle_v1.EVENT_IDENTIFIER {
        unsafe { bytes = @ptrCast([*]u8, &app.*.windows[index].identifier) }
        app.*.windows[index].identifierLength = copyText(bytes, decoded.identifier.identifier, 32)
    }
}

fn onList(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    if event.opcode != wl.ext_foreign_toplevel_list_v1.EVENT_TOPLEVEL { return }
    const decoded = wl.ext_foreign_toplevel_list_v1.decodeEvent(event)
    const handle = decoded.toplevel.toplevel
    handle.setHandler(onHandle, context)
    if app.*.windowCount >= MAX_WINDOWS { return }
    const index = app.*.windowCount
    app.*.windows[index].handle = handle
    app.*.windows[index].identifierLength = 0
    app.*.windows[index].appIdLength = 0
    app.*.windows[index].titleLength = 0
    app.*.windows[index].closed = false
    app.*.windowCount += 1
}

fn textOf(bytes: [*]const u8, length: usize) -> []const u8 { return bytes[0..length] }

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

fn sayNumber(value: i32) -> void {
    if value < 0 {
        say("-")
        const ignored = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, 0 - value))
    } else {
        const ignored = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, value))
    }
}

fn listWindows(app: *App) -> void {
    var index: usize = 0
    while index < app.*.windowCount {
        const window = &app.*.windows[index]
        if !window.*.closed {
            var bytes: [*]const u8 = undefined
            unsafe { bytes = @ptrCast([*]const u8, &window.*.identifier) }
            say(textOf(bytes, window.*.identifierLength))
            say("  ")
            unsafe { bytes = @ptrCast([*]const u8, &window.*.appId) }
            say(textOf(bytes, window.*.appIdLength))
            say("  ")
            unsafe { bytes = @ptrCast([*]const u8, &window.*.title) }
            say(textOf(bytes, window.*.titleLength))
            say("\n")
        }
        index += 1
    }
}

fn matches(bytes: [*]const u8, length: usize, name: std.string.String) -> bool {
    if length != name.length { return false }
    var index: usize = 0
    while index < length {
        if bytes[index] != name.pointer[index] { return false }
        index += 1
    }
    return true
}

fn findWindow(app: *App, name: std.string.String) -> usize {
    var index: usize = 0
    while index < app.*.windowCount {
        const window = &app.*.windows[index]
        var app_id: [*]const u8 = undefined
        var title: [*]const u8 = undefined
        unsafe {
            app_id = @ptrCast([*]const u8, &window.*.appId)
            title = @ptrCast([*]const u8, &window.*.title)
        }
        if !window.*.closed && (matches(app_id, window.*.appIdLength, name) || matches(title, window.*.titleLength, name)) { return index }
        index += 1
    }
    return MAX_WINDOWS
}

// ---------------------------------------------------------------------------
// Capture

fn onSession(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.ext_image_copy_capture_session_v1.decodeEvent(event)
    if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_BUFFER_SIZE {
        app.*.width = decoded.buffer_size.width
        app.*.height = decoded.buffer_size.height
        app.*.formats = 0
        app.*.constraintsDone = false
    } else if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_SHM_FORMAT {
        if decoded.shm_format.format == @intFromEnum(wl.wl_shm.Format.argb8888) { app.*.formats = app.*.formats | 1 }
        if decoded.shm_format.format == @intFromEnum(wl.wl_shm.Format.xrgb8888) { app.*.formats = app.*.formats | 2 }
    } else if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_DONE {
        app.*.constraintsDone = true
    } else if event.opcode == wl.ext_image_copy_capture_session_v1.EVENT_STOPPED {
        app.*.stopped = true
    }
}

fn onFrame(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.ext_image_copy_capture_frame_v1.decodeEvent(event)
    if event.opcode == wl.ext_image_copy_capture_frame_v1.EVENT_DAMAGE {
        app.*.damageX = decoded.damage.x
        app.*.damageY = decoded.damage.y
        app.*.damageWidth = decoded.damage.width
        app.*.damageHeight = decoded.damage.height
    } else if event.opcode == wl.ext_image_copy_capture_frame_v1.EVENT_READY {
        app.*.ready = true
    } else if event.opcode == wl.ext_image_copy_capture_frame_v1.EVENT_FAILED {
        app.*.failed = true
        app.*.failure = decoded.failed.reason
    }
}

const Failure = error { NoCapture, NoWindow, Stopped, CaptureFailed, NoMemory, NotSaved }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    const said = std.io.eprintln(message)
    return failure
}

fn usage() -> void {
    const said = std.io.writeAll(std.io.stderr(), "usage: mlx-screenshot [--window NAME] [--frames N] FILE.png | --list")
}

fn run(app: *App, file: std.string.String, window_name: std.string.String, frames: usize, list: bool) -> !void {
    const allocator = std.page_allocator.init()
    var display: wl.client.Display = undefined
    try wl.client.Display.connect(&display, allocator)
    app.*.display = display
    app.*.registry = wl.displayProxy(display).getRegistry()
    app.*.registry.setHandler(onRegistry, contextOf(app))
    try display.roundtrip()
    if app.*.hasToplevelList {
        app.*.toplevelList.setHandler(onList, contextOf(app))
        try display.roundtrip()
        try display.roundtrip()
    }
    if list {
        if !app.*.hasToplevelList { return fail("mlx-screenshot: the compositor lists no windows (ext-foreign-toplevel-list-v1)", Failure.NoCapture) }
        listWindows(app)
        display.disconnect()
        return
    }
    if !app.*.hasShm || !app.*.hasCaptureManager { return fail("mlx-screenshot: the compositor offers no capture (ext-image-copy-capture-v1)", Failure.NoCapture) }
    var source: wl.ext_image_capture_source_v1.Proxy = undefined
    const whole = window_name.length == 0
    if whole {
        if !app.*.hasOutputSources || !app.*.hasOutput { return fail("mlx-screenshot: the compositor offers no output capture (ext-image-capture-source-v1)", Failure.NoCapture) }
        source = app.*.outputSources.createSource(app.*.output)
    } else {
        if !app.*.hasToplevelSources { return fail("mlx-screenshot: the compositor offers no window capture (ext-image-capture-source-v1)", Failure.NoCapture) }
        const index = findWindow(app, window_name)
        if index == MAX_WINDOWS { return fail("mlx-screenshot: no such window (mlx-screenshot --list shows them)", Failure.NoWindow) }
        source = app.*.toplevelSources.createSource(app.*.windows[index].handle)
    }
    const session = app.*.captureManager.createSession(source, 0)
    session.setHandler(onSession, contextOf(app))
    while !app.*.constraintsDone && !app.*.stopped { try display.dispatch() }
    if app.*.stopped { return fail("mlx-screenshot: the capture stopped (the window went)", Failure.Stopped) }
    if app.*.formats & 3 == 0 { return fail("mlx-screenshot: no shared-memory format offered that it can save", Failure.NoCapture) }
    var memory: wl.SharedMemory = undefined
    var size: usize = 0
    var buffer: wl.wl_buffer.Proxy = undefined
    var made = false
    var shown: usize = 0
    var tries: usize = 0
    while shown < frames {
        if !made {
            size = @intCast(usize, app.*.width) * @intCast(usize, app.*.height) * 4
            if !wl.transport.createSharedMemory(&memory, size) { return fail("mlx-screenshot: no shared memory", Failure.NoMemory) }
            const format = if app.*.formats & 1 != 0 { wl.wl_shm.Format.argb8888 } else { wl.wl_shm.Format.xrgb8888 }
            const pool = app.*.shm.createPool(memory.handle, @intCast(i32, size))
            buffer = pool.createBuffer(0, @intCast(i32, app.*.width), @intCast(i32, app.*.height), @intCast(i32, app.*.width * 4), @intFromEnum(format))
            pool.destroy()
            made = true
        }
        app.*.ready = false
        app.*.failed = false
        const frame = session.createFrame()
        frame.setHandler(onFrame, contextOf(app))
        frame.attachBuffer(buffer)
        frame.damageBuffer(0, 0, @intCast(i32, app.*.width), @intCast(i32, app.*.height))
        frame.capture()
        while !app.*.ready && !app.*.failed { try display.dispatch() }
        frame.destroy()
        if app.*.failed {
            // New constraints (another size): a buffer of the new size.
            if app.*.failure == 1 && tries < 3 {
                tries += 1
                while !app.*.constraintsDone && !app.*.stopped { try display.dispatch() }
                buffer.destroy()
                memory.release()
                made = false
                continue
            }
            return fail("mlx-screenshot: the capture failed", Failure.CaptureFailed)
        }
        shown += 1
        if frames > 1 {
            say("frame ")
            sayNumber(@intCast(i32, shown))
            say(": damage ")
            sayNumber(app.*.damageX)
            say(",")
            sayNumber(app.*.damageY)
            say(" ")
            sayNumber(app.*.damageWidth)
            say("x")
            sayNumber(app.*.damageHeight)
            say("\n")
        }
    }
    var pixels: [*]const u32 = undefined
    unsafe { pixels = @ptrFromInt([*]const u32, memory.address) }
    const saved = png.saveFile(file.pointer, pixels, @intCast(usize, app.*.width), @intCast(usize, app.*.height), @intCast(usize, app.*.width), !whole, allocator)
    buffer.destroy()
    session.destroy()
    try display.roundtrip()
    memory.release()
    display.disconnect()
    if !saved { return fail("mlx-screenshot: the file could not be written", Failure.NotSaved) }
    say("saved ")
    say(std.string.asSlice(file))
    say(" (")
    sayNumber(@intCast(i32, app.*.width))
    say("x")
    sayNumber(@intCast(i32, app.*.height))
    say(")\n")
}

pub fn main(arguments: [][*]const u8) -> !void {
    const installed = crash.install()
    var app: App = undefined
    app.hasShm = false
    app.hasOutput = false
    app.hasOutputSources = false
    app.hasToplevelSources = false
    app.hasCaptureManager = false
    app.hasToplevelList = false
    app.windowCount = 0
    app.width = 0
    app.height = 0
    app.formats = 0
    app.constraintsDone = false
    app.stopped = false
    app.ready = false
    app.failed = false
    app.failure = 0
    app.damageX = 0
    app.damageY = 0
    app.damageWidth = 0
    app.damageHeight = 0
    var file = std.string.fromSlice("")
    var window_name = std.string.fromSlice("")
    var frames: usize = 1
    var list = false
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if named(argument, "--list") {
            list = true
        } else if named(argument, "--window") && index + 1 < count {
            index += 1
            window_name = std.process.argument(arguments, index)
        } else if named(argument, "--frames") && index + 1 < count {
            index += 1
            const text = std.process.argument(arguments, index)
            frames = 0
            var at: usize = 0
            while at < text.length {
                frames = frames * 10 + @intCast(usize, text.pointer[at] - 48)
                at += 1
            }
            if frames == 0 { frames = 1 }
        } else {
            file = argument
        }
        index += 1
    }
    if !list && file.length == 0 {
        usage()
        return fail("", Failure.NoCapture)
    }
    try run(&app, file, window_name, frames, list)
}
