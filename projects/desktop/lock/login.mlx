// The one privileged request mlx-lock makes.  This module owns the MLXIPC
// system-bus connection so the drawing and input side never has to keep a
// second password copy. `std.dbus` is only MLXIPC's libc-free wire codec;
// this does not contact dbus-daemon or link libdbus. The outgoing message
// body is wiped as soon as the codec call has consumed it; malformed,
// missing and error replies all fail closed.
const std = @import("std")
const dbus = @import("std.dbus")

const NAME: []const u8 = "org.mlx.Login"
const PATH: []const u8 = "/org/mlx/Login"

pub const DENIED: u8 = 0
pub const ALLOWED: u8 = 1
pub const UNAVAILABLE: u8 = 2

pub const Login = struct {
    client: dbus.Client
    connected: bool
    environment: [*][*]const u8
}

fn clientOf(login: *Login) -> *dbus.Client {
    unsafe { return @ptrCast(*dbus.Client, &login.*.client) }
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn busPath(environment: [*][*]const u8) -> []const u8 {
    const value = std.process.environmentFrom(environment, "DBUS_SYSTEM_BUS_ADDRESS")
    if value == null { return "/run/mlx/bus" }
    const address = std.string.asSlice(value.?)
    const prefix = "unix:path="
    if address.length <= prefix.length || !same(address[0..prefix.length], prefix) { return "/run/mlx/bus" }
    var end = prefix.length
    while end < address.length && address[end] != 44 { end += 1 }
    return address[prefix.length..end]
}

fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

pub fn init(login: *Login, environment: [*][*]const u8) -> void {
    login.*.environment = environment
    login.*.connected = false
}

fn connect(login: *Login) -> bool {
    if login.*.connected && !clientOf(login).*.closed { return true }
    if login.*.connected {
        dbus.disconnect(clientOf(login), std.page_allocator.init())
        login.*.connected = false
    }
    if !dbus.connectClient(clientOf(login), std.page_allocator.init(), busPath(login.*.environment)) { return false }
    login.*.connected = true
    return true
}

pub fn close(login: *Login) -> void {
    if !login.*.connected { return }
    dbus.disconnect(clientOf(login), std.page_allocator.init())
    login.*.connected = false
}

// `secret` is mutable on purpose: every return path wipes all of its
// capacity, and the ordinary path does so immediately after the MLXIPC call,
// before waiting for the daemon's delayed answer.
pub fn unlock(login: *Login, user: []const u8, secret: [*]u8, length: usize, capacity: usize) -> u8 {
    if capacity > 4096 || length > capacity {
        wipe(secret, if capacity <= 4096 { capacity } else { 0 })
        return DENIED
    }
    if user.length == 0 || user.length > 64 || length == 0 || length > 512 {
        wipe(secret, capacity)
        return DENIED
    }
    if !connect(login) {
        wipe(secret, capacity)
        return UNAVAILABLE
    }

    var body: [640]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 640, false)
    dbus.putString(&writing, user)
    dbus.putString(&writing, secret[0..length])
    if writing.failed {
        wipe(bytes, 640)
        wipe(secret, capacity)
        return DENIED
    }
    const client = clientOf(login)
    const serial = dbus.call(client, NAME, PATH, NAME, "Unlock", "ss", bytes, writing.length)
    wipe(bytes, 640)
    wipe(secret, capacity)
    // The MLXIPC send flushes before returning, but its two reusable output
    // pages otherwise retain the marshalled password.
    wipe(client.*.out, dbus.MAX_MESSAGE)
    wipe(dbus.connectionOf(client).*.output, dbus.MAX_MESSAGE)
    if serial == 0 {
        close(login)
        return UNAVAILABLE
    }

    var reply: dbus.Header = undefined
    if !dbus.waitReply(client, serial, &reply, 5000) || reply.kind != dbus.METHOD_RETURN || !same(reply.signature, "b") { return UNAVAILABLE }
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    const allowed = dbus.readBool(&reading)
    if reading.failed { return UNAVAILABLE }
    return if allowed { ALLOWED } else { DENIED }
}
