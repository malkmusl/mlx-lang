// mlx-lock: the Mlx desktop's screen locker.  It takes the session through
// ext-session-lock-v1, draws one full-output lock surface and asks the
// root-owned org.mlx.Login service to authenticate the session user.  A
// compositor unlock happens only after an explicit true reply.
//
//     mlx4 projects/desktop/lock/main.mlx -o mlx-lock
//     mlx-lock
const std = @import("std")
const crash = @import("std.crash")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const field = @import("std.ui.field")
const keys = @import("std.ui.keys")
const panel_module = @import("std.ui.wayland.panel")
const palette = @import("../shared/palette.mlx")
const clock = @import("../shared/clock.mlx")
const login_module = @import("./login.mlx")

const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Panel = panel_module.Panel

const BUTTON_LEFT: u32 = 272
const CARD_WIDTH: i32 = 430
const CARD_HEIGHT: i32 = 292
const FIELD_WIDTH: i32 = 350
const FIELD_HEIGHT: i32 = 42
const BUTTON_HEIGHT: i32 = 40

const PROBLEM_NONE: u8 = 0
const PROBLEM_DENIED: u8 = 1
const PROBLEM_UNAVAILABLE: u8 = 2

const Failure = error { NoMemory }

fn noMemory() -> Failure!void { return Failure.NoMemory }

const Lock = struct {
    panel: Panel
    login: login_module.Login
    environment: [*][*]const u8
    password: field.Field
    shown: field.Field
    title: Text
    body: Text
    small: Text
    german: bool
    problem: u8
    held: u32
    pointerX: i32
    pointerY: i32
    buttonDown: bool
}

fn lockOf(context: *anyopaque) -> *Lock {
    unsafe { return @ptrCast(*Lock, context) }
}

fn panelOf(lock: *Lock) -> *Panel {
    unsafe { return @ptrCast(*Panel, &lock.*.panel) }
}

fn loginOf(lock: *Lock) -> *login_module.Login {
    unsafe { return @ptrCast(*login_module.Login, &lock.*.login) }
}

fn passwordOf(lock: *Lock) -> *field.Field {
    unsafe { return @ptrCast(*field.Field, &lock.*.password) }
}

fn shownOf(lock: *Lock) -> *field.Field {
    unsafe { return @ptrCast(*field.Field, &lock.*.shown) }
}

fn titleOf(lock: *Lock) -> *Text {
    unsafe { return @ptrCast(*Text, &lock.*.title) }
}

fn bodyOf(lock: *Lock) -> *Text {
    unsafe { return @ptrCast(*Text, &lock.*.body) }
}

fn smallOf(lock: *Lock) -> *Text {
    unsafe { return @ptrCast(*Text, &lock.*.small) }
}

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

fn tr(lock: *Lock, english: []const u8, german: []const u8) -> []const u8 {
    return if lock.*.german { german } else { english }
}

fn userName(lock: *Lock) -> []const u8 {
    const value = std.process.environmentFrom(lock.*.environment, "USER")
    if value == null || value.?.length == 0 { return "" }
    return value.?.pointer[0..value.?.length]
}

fn wipeField(value: *field.Field) -> void {
    var index: usize = 0
    while index < field.CAPACITY {
        value.*.bytes[index] = 0
        index += 1
    }
    field.clear(value)
}

fn wipePassword(lock: *Lock) -> void {
    wipeField(passwordOf(lock))
    wipeField(shownOf(lock))
}

fn maskPassword(lock: *Lock) -> void {
    const password = passwordOf(lock)
    const shown = shownOf(lock)
    var index: usize = 0
    while index < password.*.length {
        shown.*.bytes[index] = 42
        index += 1
    }
    shown.*.length = password.*.length
    shown.*.cursor = password.*.cursor
    shown.*.anchor = password.*.anchor
    shown.*.scroll = password.*.scroll
}

fn wipeTyped(panel: *Panel) -> void {
    var index: usize = 0
    while index < 8 {
        panel.*.text[index] = 0
        panel.*.plainText[index] = 0
        index += 1
    }
    panel.*.textLength = 0
    panel.*.plainLength = 0
}

fn cardLeft(lock: *Lock) -> i32 {
    const width = @intCast(i32, panelOf(lock).*.width)
    return (width - CARD_WIDTH) / 2
}

fn cardTop(lock: *Lock) -> i32 {
    const height = @intCast(i32, panelOf(lock).*.height)
    return (height - CARD_HEIGHT) / 2
}

fn buttonHit(lock: *Lock) -> bool {
    const left = cardLeft(lock) + (CARD_WIDTH - FIELD_WIDTH) / 2
    const top = cardTop(lock) + 218
    return lock.*.pointerX >= left && lock.*.pointerX < left + FIELD_WIDTH && lock.*.pointerY >= top && lock.*.pointerY < top + BUTTON_HEIGHT
}

fn attempt(lock: *Lock) -> void {
    const password = passwordOf(lock)
    const length = password.*.length
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &password.*.bytes) }
    const result = login_module.unlock(loginOf(lock), userName(lock), bytes, length, field.CAPACITY)
    // login.unlock has already zeroed password.bytes before it waited for
    // the reply.  Reset the field metadata and wipe the stars as well.
    field.clear(password)
    wipeField(shownOf(lock))
    if result == login_module.ALLOWED {
        lock.*.problem = PROBLEM_NONE
        say("mlx-lock: unlocked\n")
        panel_module.unlock(panelOf(lock))
    } else if result == login_module.DENIED {
        lock.*.problem = PROBLEM_DENIED
        say("mlx-lock: authentication failed\n")
    } else {
        lock.*.problem = PROBLEM_UNAVAILABLE
        say("mlx-lock: login service unavailable\n")
    }
}

fn modifier(lock: *Lock, code: u32, pressed: bool) -> void {
    var bit: u32 = 0
    if code == 42 || code == 54 { bit = keys.SHIFT }
    if code == 29 || code == 97 { bit = keys.CONTROL }
    if code == 56 || code == 100 { bit = keys.ALT }
    if bit == 0 { return }
    if pressed { lock.*.held |= bit } else { lock.*.held &= ~bit }
}

fn onKey(lock: *Lock, code: u32, state: i32) -> void {
    modifier(lock, code, state != 0)
    if state == 0 { return }
    const panel = panelOf(lock)
    const typed = panel_module.textOf(panel)
    // AltGr is represented as Ctrl+Alt by some keymaps.  Text produced by
    // the compositor is still password text, not a shortcut.
    const modifiers = if typed.length > 0 { lock.*.held & ~(keys.CONTROL | keys.ALT) } else { lock.*.held }
    const result = field.fieldKey(passwordOf(lock), code, modifiers, typed)
    wipeTyped(panel)
    if result == field.KEY_SUBMIT {
        if passwordOf(lock).*.length > 0 { attempt(lock) }
    } else if result == field.KEY_EDITED || result == field.KEY_MOVED {
        if result == field.KEY_EDITED { lock.*.problem = PROBLEM_NONE }
        maskPassword(lock)
    }
    panel.*.dirty = true
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const lock = lockOf(context)
    const panel = panelOf(lock)
    if kind == panel_module.EVENT_LOCKED {
        say("mlx-lock: locked\n")
    } else if kind == panel_module.EVENT_LOCK_FINISHED {
        say("mlx-lock: lock refused\n")
    } else if kind == panel_module.EVENT_CONFIGURED {
        panel.*.dirty = true
    } else if kind == panel_module.EVENT_MOTION {
        lock.*.pointerX = @bitCast(i32, a)
        lock.*.pointerY = b
        panel.*.dirty = true
    } else if kind == panel_module.EVENT_LEAVE {
        lock.*.pointerX = -1
        lock.*.pointerY = -1
        panel.*.dirty = true
    } else if kind == panel_module.EVENT_BUTTON && a == BUTTON_LEFT {
        if b == 1 {
            lock.*.buttonDown = buttonHit(lock)
        } else {
            const take = lock.*.buttonDown && buttonHit(lock) && passwordOf(lock).*.length > 0
            lock.*.buttonDown = false
            if take { attempt(lock) }
        }
        panel.*.dirty = true
    } else if kind == panel_module.EVENT_KEY {
        onKey(lock, a, b)
    }
}

fn centered(canvas: *Canvas, font: *Text, text: []const u8, y: i32, color: u32) -> void {
    const width = text_module.measure(font, text)
    text_module.drawText(canvas, font, text, (@intCast(i32, canvas.*.width) - width) / 2, y, color, 0)
}

fn drawLockMark(canvas: *Canvas, x: i32, y: i32, color: u32, background: u32) -> void {
    canvas_module.strokeRoundedRect(canvas, x + 7, y, 30, 30, 15, 4, color)
    canvas_module.fillRoundedRect(canvas, x, y + 18, 44, 36, 10, color)
    canvas_module.fillRoundedRect(canvas, x + 19, y + 31, 6, 13, 3, background)
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const lock = lockOf(context)
    const colors = palette.at(panel_module.lightness(panelOf(lock)))
    const background = palette.mix(canvas_module.color(255, 19, 22, 31), canvas_module.color(255, 224, 230, 241), colors.t)
    canvas_module.clear(canvas, background)

    const left = cardLeft(lock)
    const top = cardTop(lock)
    canvas_module.fillRoundedRect(canvas, left, top, CARD_WIDTH, CARD_HEIGHT, 22, colors.popup)
    canvas_module.strokeRoundedRect(canvas, left, top, CARD_WIDTH, CARD_HEIGHT, 22, 1, colors.edge)
    drawLockMark(canvas, left + (CARD_WIDTH - 44) / 2, top + 22, palette.ACCENT, colors.popup)
    centered(canvas, titleOf(lock), tr(lock, "Screen locked", "Bildschirm gesperrt"), top + 84, palette.ink(&colors, 255))

    const user = userName(lock)
    const who = if user.length > 0 { user } else { tr(lock, "Current session", "Aktuelle Sitzung") }
    centered(canvas, smallOf(lock), who, top + 119, palette.ink(&colors, 170))

    const fieldLeft = left + (CARD_WIDTH - FIELD_WIDTH) / 2
    const fieldTop = top + 148
    canvas_module.fillRoundedRect(canvas, fieldLeft, fieldTop, FIELD_WIDTH, FIELD_HEIGHT, 10, colors.panel)
    canvas_module.strokeRoundedRect(canvas, fieldLeft, fieldTop, FIELD_WIDTH, FIELD_HEIGHT, 10, 2, palette.ACCENT)
    const shown = field.text(shownOf(lock))
    if shown.length == 0 {
        text_module.drawText(canvas, bodyOf(lock), tr(lock, "Password", "Passwort"), fieldLeft + 14, fieldTop + 12, palette.ink(&colors, 120), 0)
    } else {
        text_module.drawText(canvas, bodyOf(lock), shown, fieldLeft + 14, fieldTop + 12, palette.ink(&colors, 255), FIELD_WIDTH - 28)
    }

    if lock.*.problem != PROBLEM_NONE {
        const message = if lock.*.problem == PROBLEM_DENIED {
            tr(lock, "Could not unlock. Please try again.", "Entsperren fehlgeschlagen. Bitte erneut versuchen.")
        } else {
            tr(lock, "Login service is unavailable.", "Anmeldedienst ist nicht erreichbar.")
        }
        centered(canvas, smallOf(lock), message, top + 197, canvas_module.color(255, 224, 79, 84))
    }

    const buttonTop = top + 218
    const hovered = buttonHit(lock)
    const fill = if hovered { palette.mix(canvas_module.color(255, 74, 132, 240), canvas_module.color(255, 55, 105, 215), colors.t) } else { palette.ACCENT }
    canvas_module.fillRoundedRect(canvas, fieldLeft, buttonTop, FIELD_WIDTH, BUTTON_HEIGHT, 11, fill)
    const label = tr(lock, "Unlock", "Entsperren")
    const labelWidth = text_module.measure(bodyOf(lock), label)
    text_module.drawText(canvas, bodyOf(lock), label, fieldLeft + (FIELD_WIDTH - labelWidth) / 2, buttonTop + 11, palette.ON_ACCENT, 0)
}

pub fn main(arguments: [][*]const u8) -> !void {
    const reporting = crash.install()
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Lock), 16)
    if memory == null { return noMemory() }
    var lock: *Lock = undefined
    unsafe { lock = @ptrCast(*Lock, memory.?) }
    lock.*.environment = std.process.environmentEntries(arguments)
    lock.*.german = clock.germanLocale(lock.*.environment)
    lock.*.problem = PROBLEM_NONE
    lock.*.held = 0
    lock.*.pointerX = -1
    lock.*.pointerY = -1
    lock.*.buttonDown = false
    field.clear(passwordOf(lock))
    field.clear(shownOf(lock))
    login_module.init(loginOf(lock), lock.*.environment)
    const loadedTitle = text_module.loadText(titleOf(lock), 25, allocator)
    const loadedBody = text_module.loadText(bodyOf(lock), 15, allocator)
    const loadedSmall = text_module.loadText(smallOf(lock), 13, allocator)

    const panel = panelOf(lock)
    panel.*.context = lock
    panel.*.draw = draw
    panel.*.event = onEvent
    try panel_module.openLock(panel, allocator, arguments)
    panel_module.report(panel, "mlx-lock")
    defer panel_module.close(panel)
    defer login_module.close(loginOf(lock))
    defer wipePassword(lock)
    try panel_module.run(panel)
}
