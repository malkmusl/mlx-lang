// The Network page: mlx-netd (projects/network) on the system bus. The
// links with what they have (address, gateway, name servers, the Wi-Fi
// network), each switched on or off (Up, Down); the Wi-Fi networks in
// sight (Networks, Scan): a click on one shows what can be done with it
// (join it, typing its passphrase when it needs one and none is saved,
// leave it, forget it). The page asks mlx-netd again every second while
// it is shown; `mlx-settings network SSID` opens it with that network
// chosen (the top bar's control centre does, for a network that needs a
// passphrase). The passphrase goes to mlx-netd and is wiped here; mlx-netd
// keeps the network's PMK, not the passphrase. Without mlx-netd the page
// says why and what to run, and shows the kernel's links
// (network_status.mlx).
const std = @import("std")
const dbus = @import("std.dbus")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const field = @import("std.ui.field")
const popup = @import("std.ui.popup")
const apps_module = @import("../shared/apps.mlx")
const page_module = @import("./page.mlx")
const status_module = @import("./network_status.mlx")

const Page = page_module.Page

pub const MAX_LINKS: usize = 8
pub const MAX_NETWORKS: usize = 32

const NAME: []const u8 = "org.mlx.Network"
const PATH: []const u8 = "/org/mlx/Network"

// The widgets' items (page_module.idOf), above what the other pages use.
const ITEM_LINK: usize = 3000
const ITEM_SCAN: usize = 3100
const ITEM_NETWORK: usize = 3200
const ITEM_JOIN: usize = 3300
const ITEM_LEAVE: usize = 3301
const ITEM_FORGET: usize = 3302
pub const ITEM_PASSPHRASE: usize = 3303

const KEY_ENTER: u32 = 28

pub const Link = struct {
    name: [16]u8
    nameLength: usize
    kind: [12]u8
    kindLength: usize
    state: [16]u8
    stateLength: usize
    address: [24]u8
    addressLength: usize
    gateway: [16]u8
    gatewayLength: usize
    network: [32]u8
    networkLength: usize
    dns: [64]u8
    dnsLength: usize
}

pub const Wifi = struct {
    ssid: [32]u8
    ssidLength: usize
    signal: u32
    frequency: u32
    security: [12]u8
    securityLength: usize
    problem: [16]u8
    problemLength: usize
    saved: bool
    connected: bool
}

pub const Network = struct {
    environment: [*][*]const u8
    // The system bus (a dbus.Client; 0: not connected).
    client: usize
    // mlx-netd answered.
    known: bool
    links: [8]Link
    linkCount: usize
    networks: [32]Wifi
    networkCount: usize
    // The network clicked (its actions show under it), and whether its
    // passphrase field is to take the keys (it was just chosen).
    chosen: [32]u8
    chosenLength: usize
    focusWanted: bool
    passphrase: field.Field
    // What the passphrase field shows: as many stars.
    shown: field.Field
    // What mlx-netd said when something failed, or what is going on.
    problem: [160]u8
    problemLength: usize
    // The network asked to join (until it is joined or refused).
    joining: [32]u8
    joiningLength: usize
    // Why mlx-netd does not answer, and the kernel's links meanwhile.
    status: status_module.Status
}

// ---------------------------------------------------------------------------
// Field access

fn bytesAt(base: usize, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, base + offset) }
}

fn clientOf(network: *Network) -> *dbus.Client {
    unsafe { return @ptrFromInt(*dbus.Client, network.*.client) }
}

fn linkAt(network: *Network, index: usize) -> *Link {
    unsafe { return @ptrFromInt(*Link, @intFromPtr(network) + @offsetOf(Network, "links") + index * @sizeOf(Link)) }
}

fn wifiAt(network: *Network, index: usize) -> *Wifi {
    unsafe { return @ptrFromInt(*Wifi, @intFromPtr(network) + @offsetOf(Network, "networks") + index * @sizeOf(Wifi)) }
}

fn statusOf(network: *Network) -> *status_module.Status {
    unsafe { return @ptrCast(*status_module.Status, &network.*.status) }
}

fn passphraseOf(network: *Network) -> *field.Field {
    unsafe { return @ptrCast(*field.Field, &network.*.passphrase) }
}

fn shownOf(network: *Network) -> *field.Field {
    unsafe { return @ptrCast(*field.Field, &network.*.shown) }
}

fn chosenOf(network: *Network) -> []const u8 { return bytesAt(@intFromPtr(network), @offsetOf(Network, "chosen"))[0..network.*.chosenLength] }

fn joiningOf(network: *Network) -> []const u8 { return bytesAt(@intFromPtr(network), @offsetOf(Network, "joining"))[0..network.*.joiningLength] }

fn problemOf(network: *Network) -> []const u8 { return bytesAt(@intFromPtr(network), @offsetOf(Network, "problem"))[0..network.*.problemLength] }

fn text(base: usize, offset: usize, length: usize) -> []const u8 { return bytesAt(base, offset)[0..length] }

fn nameOf(link: *Link) -> []const u8 { return text(@intFromPtr(link), @offsetOf(Link, "name"), link.*.nameLength) }
fn kindOf(link: *Link) -> []const u8 { return text(@intFromPtr(link), @offsetOf(Link, "kind"), link.*.kindLength) }
fn stateOf(link: *Link) -> []const u8 { return text(@intFromPtr(link), @offsetOf(Link, "state"), link.*.stateLength) }
fn addressOf(link: *Link) -> []const u8 { return text(@intFromPtr(link), @offsetOf(Link, "address"), link.*.addressLength) }
fn gatewayOf(link: *Link) -> []const u8 { return text(@intFromPtr(link), @offsetOf(Link, "gateway"), link.*.gatewayLength) }
fn joinedOf(link: *Link) -> []const u8 { return text(@intFromPtr(link), @offsetOf(Link, "network"), link.*.networkLength) }
fn dnsOf(link: *Link) -> []const u8 { return text(@intFromPtr(link), @offsetOf(Link, "dns"), link.*.dnsLength) }

fn ssidOf(wifi: *Wifi) -> []const u8 { return text(@intFromPtr(wifi), @offsetOf(Wifi, "ssid"), wifi.*.ssidLength) }
fn securityOf(wifi: *Wifi) -> []const u8 { return text(@intFromPtr(wifi), @offsetOf(Wifi, "security"), wifi.*.securityLength) }
fn wifiProblemOf(wifi: *Wifi) -> []const u8 { return text(@intFromPtr(wifi), @offsetOf(Wifi, "problem"), wifi.*.problemLength) }

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn copyInto(target: [*]u8, capacity: usize, value: []const u8) -> usize {
    var index: usize = 0
    while index < value.length && index < capacity {
        target[index] = value[index]
        index += 1
    }
    return index
}

fn setProblem(network: *Network, value: []const u8) -> void {
    network.*.problemLength = copyInto(bytesAt(@intFromPtr(network), @offsetOf(Network, "problem")), 160, value)
}

fn setChosen(network: *Network, ssid: []const u8) -> void {
    network.*.chosenLength = copyInto(bytesAt(@intFromPtr(network), @offsetOf(Network, "chosen")), 32, ssid)
}

fn setJoining(network: *Network, ssid: []const u8) -> void {
    network.*.joiningLength = copyInto(bytesAt(@intFromPtr(network), @offsetOf(Network, "joining")), 32, ssid)
}

// Wipes the passphrase typed (and its stars).
fn wipePassphrase(network: *Network) -> void {
    const typed = passphraseOf(network)
    var index: usize = 0
    while index < field.CAPACITY {
        typed.*.bytes[index] = 0
        index += 1
    }
    field.clear(typed)
    field.clear(shownOf(network))
}

// ---------------------------------------------------------------------------
// mlx-netd

pub fn init(network: *Network, environment: [*][*]const u8) -> void {
    network.*.environment = environment
    network.*.client = 0
    network.*.known = false
    network.*.linkCount = 0
    network.*.networkCount = 0
    network.*.chosenLength = 0
    network.*.focusWanted = false
    network.*.problemLength = 0
    network.*.joiningLength = 0
    field.clear(passphraseOf(network))
    field.clear(shownOf(network))
    status_module.init(statusOf(network))
}

// The network to show chosen (the command line's SSID).
pub fn choose(network: *Network, ssid: []const u8) -> void {
    setChosen(network, ssid)
    network.*.focusWanted = true
}

// The system bus's socket: DBUS_SYSTEM_BUS_ADDRESS's unix:path=, else
// MLXIPC's system bus, /run/mlx/bus.
fn busPath(network: *Network) -> []const u8 {
    const value = apps_module.environmentValue(network.*.environment, "DBUS_SYSTEM_BUS_ADDRESS")
    if @intFromPtr(value) != 0 {
        var length: usize = 0
        while value[length] != 0 { length += 1 }
        const address = value[0..length]
        if length > 10 && same(address[0..10], "unix:path=") {
            var stop: usize = 10
            while stop < length && address[stop] != 44 { stop += 1 }
            return address[10..stop]
        }
    }
    return "/run/mlx/bus"
}

fn disconnect(network: *Network, allocator: std.allocator.Allocator) -> void {
    if network.*.client == 0 { return }
    dbus.disconnect(clientOf(network), allocator)
    var memory: [*]u8 = undefined
    unsafe { memory = @ptrFromInt([*]u8, network.*.client) }
    allocator.free(memory, @sizeOf(dbus.Client), 16)
    network.*.client = 0
}

fn connect(network: *Network, allocator: std.allocator.Allocator) -> bool {
    if network.*.client != 0 && !clientOf(network).*.closed { return true }
    disconnect(network, allocator)
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    if memory == null { return false }
    network.*.client = @intFromPtr(memory.?)
    if !dbus.connectClient(clientOf(network), allocator, busPath(network)) {
        allocator.free(memory.?, @sizeOf(dbus.Client), 16)
        network.*.client = 0
        return false
    }
    return true
}

fn noBody() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "") }
}

// A call with `body` (signature `signature`); the reply into `reply`,
// false when none came. An error's text becomes the page's problem.
fn call(network: *Network, member: []const u8, signature: []const u8, body: [*]const u8, length: usize, reply: *dbus.Header) -> bool {
    const client = clientOf(network)
    const serial = dbus.call(client, NAME, PATH, NAME, member, signature, body, length)
    if serial == 0 || !dbus.waitReply(client, serial, reply, 2000) { return false }
    if reply.*.kind == dbus.ERROR {
        if reply.*.signature.length > 0 && reply.*.signature[0] == 115 {
            var reading = dbus.reader(dbus.bodyOf(client, reply), reply.*.bodyLength, reply.*.big)
            setProblem(network, dbus.readString(&reading))
        } else {
            setProblem(network, reply.*.errorName)
        }
        return false
    }
    return true
}

// Devices and Networks again; false when mlx-netd does not answer (the
// page finds out why then).
pub fn refresh(network: *Network, allocator: std.allocator.Allocator) -> bool {
    if !connect(network, allocator) {
        network.*.known = false
        status_module.noBus(statusOf(network))
        return false
    }
    var reply: dbus.Header = undefined
    reply.kind = 0
    const client = clientOf(network)
    if !call(network, "Devices", "", noBody(), 0, &reply) {
        network.*.known = false
        const denied = reply.kind == dbus.ERROR && same(reply.errorName, status_module.ACCESS_DENIED)
        network.*.problemLength = 0
        status_module.diagnose(statusOf(network), client, denied)
        return false
    }
    network.*.known = true
    status_module.answered(statusOf(network))
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    var length = @intCast(usize, dbus.readU32(&reading))
    dbus.alignTo(&reading, 8)
    var end = reading.position + length
    var count: usize = 0
    while reading.position < end && !reading.failed && count < MAX_LINKS {
        dbus.alignTo(&reading, 8)
        const link = linkAt(network, count)
        const base = @intFromPtr(link)
        link.*.nameLength = copyInto(bytesAt(base, @offsetOf(Link, "name")), 16, dbus.readString(&reading))
        link.*.kindLength = copyInto(bytesAt(base, @offsetOf(Link, "kind")), 12, dbus.readString(&reading))
        link.*.stateLength = copyInto(bytesAt(base, @offsetOf(Link, "state")), 16, dbus.readString(&reading))
        link.*.addressLength = copyInto(bytesAt(base, @offsetOf(Link, "address")), 24, dbus.readString(&reading))
        link.*.gatewayLength = copyInto(bytesAt(base, @offsetOf(Link, "gateway")), 16, dbus.readString(&reading))
        link.*.networkLength = copyInto(bytesAt(base, @offsetOf(Link, "network")), 32, dbus.readString(&reading))
        // The name servers, one after the other.
        const servers = @intCast(usize, dbus.readU32(&reading))
        const servers_end = reading.position + servers
        var dns_length: usize = 0
        while reading.position < servers_end && !reading.failed {
            const server = dbus.readString(&reading)
            if dns_length > 0 && dns_length < 64 { dns_length += copyInto(bytesAt(base, @offsetOf(Link, "dns") + dns_length), 64 - dns_length, ", ") }
            if dns_length < 64 { dns_length += copyInto(bytesAt(base, @offsetOf(Link, "dns") + dns_length), 64 - dns_length, server) }
        }
        link.*.dnsLength = dns_length
        if reading.failed { break }
        count += 1
    }
    network.*.linkCount = count
    network.*.networkCount = 0
    if !call(network, "Networks", "", noBody(), 0, &reply) { return true }
    reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    length = @intCast(usize, dbus.readU32(&reading))
    dbus.alignTo(&reading, 8)
    end = reading.position + length
    count = 0
    while reading.position < end && !reading.failed && count < MAX_NETWORKS {
        dbus.alignTo(&reading, 8)
        const wifi = wifiAt(network, count)
        const base = @intFromPtr(wifi)
        wifi.*.ssidLength = copyInto(bytesAt(base, @offsetOf(Wifi, "ssid")), 32, dbus.readString(&reading))
        wifi.*.signal = dbus.readU32(&reading)
        wifi.*.frequency = dbus.readU32(&reading)
        wifi.*.securityLength = copyInto(bytesAt(base, @offsetOf(Wifi, "security")), 12, dbus.readString(&reading))
        wifi.*.problemLength = copyInto(bytesAt(base, @offsetOf(Wifi, "problem")), 16, dbus.readString(&reading))
        wifi.*.saved = dbus.readBool(&reading)
        wifi.*.connected = dbus.readBool(&reading)
        if reading.failed { break }
        // What was asked came to an end: joined, or refused.
        if network.*.joiningLength > 0 && same(ssidOf(wifi), joiningOf(network)) {
            if wifi.*.connected {
                network.*.joiningLength = 0
                network.*.problemLength = 0
            } else if wifi.*.problemLength > 0 {
                // Refused: the passphrase field takes the keys again.
                network.*.joiningLength = 0
                if same(ssidOf(wifi), chosenOf(network)) { network.*.focusWanted = true }
            }
        }
        count += 1
    }
    network.*.networkCount = count
    return true
}

fn findWifi(network: *Network, ssid: []const u8) -> usize {
    var index: usize = 0
    while index < network.*.networkCount {
        if same(ssidOf(wifiAt(network, index)), ssid) { return index }
        index += 1
    }
    return MAX_NETWORKS
}

fn switchLink(network: *Network, link: *Link, on: bool, allocator: std.allocator.Allocator) -> void {
    network.*.problemLength = 0
    if !connect(network, allocator) { return }
    var memory: [64]u8 = undefined
    const bytes: [*]u8 = &memory
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 64, false)
    dbus.putString(&writing, nameOf(link))
    var reply: dbus.Header = undefined
    const done = call(network, if on { "Up" } else { "Down" }, "s", bytes, writing.length, &reply)
    const read = refresh(network, allocator)
}

// Joins the chosen network with what was typed (nothing: open or saved).
fn join(network: *Network, allocator: std.allocator.Allocator) -> void {
    network.*.problemLength = 0
    if network.*.chosenLength == 0 || !connect(network, allocator) { return }
    var memory: [640]u8 = undefined
    const bytes: [*]u8 = &memory
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 640, false)
    dbus.putString(&writing, chosenOf(network))
    dbus.putString(&writing, field.text(passphraseOf(network)))
    var reply: dbus.Header = undefined
    const started = call(network, "Connect", "ss", bytes, writing.length, &reply)
    var index: usize = 0
    while index < 640 {
        memory[index] = 0
        index += 1
    }
    wipePassphrase(network)
    if started { setJoining(network, chosenOf(network)) }
    const read = refresh(network, allocator)
}

fn simple(network: *Network, member: []const u8, ssid: []const u8, allocator: std.allocator.Allocator) -> void {
    network.*.problemLength = 0
    if !connect(network, allocator) { return }
    var memory: [64]u8 = undefined
    const bytes: [*]u8 = &memory
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 64, false)
    if ssid.length > 0 { dbus.putString(&writing, ssid) }
    var reply: dbus.Header = undefined
    const done = call(network, member, if ssid.length > 0 { "s" } else { "" }, bytes, writing.length, &reply)
    const read = refresh(network, allocator)
}

// A key while the page is shown: the passphrase field's when it has the
// focus (Enter joins, Escape gives the focus back); true when taken.
pub fn key(network: *Network, context: *view.Ui, code: u32, modifiers: u32, typed: []const u8, allocator: std.allocator.Allocator) -> bool {
    if !view.hasFocus(context, page_module.idOf(ITEM_PASSPHRASE)) { return false }
    const result = field.fieldKey(passphraseOf(network), code, modifiers, typed)
    if result == field.KEY_SUBMIT || code == KEY_ENTER {
        view.setFocus(context, view.NONE)
        join(network, allocator)
    } else if result == field.KEY_CANCEL {
        view.setFocus(context, view.NONE)
    }
    return true
}

// ---------------------------------------------------------------------------
// The page

fn kindLabel(page: *const Page, kind: []const u8) -> []const u8 {
    if same(kind, "ethernet") { return page_module.say(page, "Cable", "Kabel") }
    if same(kind, "wifi") { return page_module.say(page, "Wi-Fi", "WLAN") }
    return page_module.say(page, "Other", "Andere")
}

fn stateLabel(page: *const Page, link: *Link) -> []const u8 {
    const state = stateOf(link)
    const wifi = same(kindOf(link), "wifi")
    if same(state, "connected") { return page_module.say(page, "Connected", "Verbunden") }
    if same(state, "connecting") { return page_module.say(page, "Connecting…", "Verbinde…") }
    if same(state, "off") { return page_module.say(page, "Off", "Aus") }
    if same(state, "no-carrier") { return if wifi { page_module.say(page, "Not connected", "Nicht verbunden") } else { page_module.say(page, "No cable", "Kein Kabel") } }
    return page_module.say(page, "Not managed", "Nicht verwaltet")
}

// What a network is, at the right of its row.
fn wifiValue(page: *const Page, wifi: *Wifi, into: [*]u8) -> usize {
    var length: usize = 0
    const security = securityOf(wifi)
    if wifi.*.connected {
        length = copyInto(into, 40, page_module.say(page, "Connected", "Verbunden"))
    } else if same(wifiProblemOf(wifi), "passphrase") {
        length = copyInto(into, 40, page_module.say(page, "Wrong passphrase", "Falsches Passwort"))
    } else if wifi.*.saved {
        length = copyInto(into, 40, page_module.say(page, "Saved", "Gespeichert"))
    } else if same(security, "open") {
        length = copyInto(into, 40, page_module.say(page, "Open", "Offen"))
    } else if same(security, "wpa2") {
        length = copyInto(into, 40, "WPA2")
    } else if same(security, "wpa3") {
        length = copyInto(into, 40, "WPA3")
    } else if same(security, "enterprise") {
        length = copyInto(into, 40, "802.1X")
    } else {
        length = copyInto(into, 40, "WEP/WPA")
    }
    length += copyInto(bytesAt(@intFromPtr(into), length), 4, " · ")
    var percent = wifi.*.signal
    var digits: [4]u8 = undefined
    var count: usize = 0
    while true {
        digits[count] = @intCast(u8, 48 + percent % 10)
        count += 1
        percent = percent / 10
        if percent == 0 || count == 3 { break }
    }
    while count > 0 {
        count -= 1
        into[length] = digits[count]
        length += 1
    }
    into[length] = 37
    return length + 1
}

fn supported(wifi: *Wifi) -> bool { return same(securityOf(wifi), "open") || same(securityOf(wifi), "wpa2") }

// The chosen network's actions under its row; the y after them.
fn actions(network: *Network, page: *const Page, y: i32, wifi: *Wifi, allocator: std.allocator.Allocator) -> i32 {
    var top = y
    const left = page.*.left
    const s = page.*.scale
    if !supported(wifi) {
        return page_module.note(page, top, page_module.say(page, "mlx-netd joins open and WPA2 networks; this one asks for another (WPA3, 802.1X or an old one).", "mlx-netd verbindet offene und WPA2-Netze; dieses verlangt etwas anderes (WPA3, 802.1X oder ein altes Verfahren)."))
    }
    const needs = same(securityOf(wifi), "wpa2") && (!wifi.*.saved || same(wifiProblemOf(wifi), "passphrase"))
    if needs && !wifi.*.connected {
        // The passphrase (shown as stars), then Join.
        const typed = passphraseOf(network)
        const shown = shownOf(network)
        var index: usize = 0
        while index < typed.*.length {
            shown.*.bytes[index] = 42
            index += 1
        }
        shown.*.length = typed.*.length
        shown.*.cursor = typed.*.cursor
        shown.*.anchor = typed.*.anchor
        const join_label = page_module.say(page, "Join", "Verbinden")
        const button_width = controls.buttonWidth(page.*.ui, page.*.body, join_label)
        const area = ui.rect(left, top + page_module.px(page, 6), page.*.width - button_width - page_module.px(page, 10), page_module.px(page, 32))
        if network.*.focusWanted {
            network.*.focusWanted = false
            view.setFocus(page.*.ui, page_module.idOf(ITEM_PASSPHRASE))
        }
        const clicked = field.textField(page.*.ui, page_module.idOf(ITEM_PASSPHRASE), area, shown, page_module.say(page, "Passphrase", "Passwort"), false)
        typed.*.cursor = shown.*.cursor
        typed.*.anchor = shown.*.anchor
        if controls.button(page.*.ui, page_module.idOf(ITEM_JOIN), ui.rect(left + page.*.width - button_width, top + page_module.px(page, 6), button_width, page_module.px(page, 32)), join_label, controls.BUTTON_PRIMARY, typed.*.length >= 8) { join(network, allocator) }
        top += page_module.px(page, 44)
    } else {
        // Join, Leave, Forget as they apply.
        var x = left
        if !wifi.*.connected {
            const label = page_module.say(page, "Join", "Verbinden")
            const width = controls.buttonWidth(page.*.ui, page.*.body, label)
            if controls.button(page.*.ui, page_module.idOf(ITEM_JOIN), ui.rect(x, top + page_module.px(page, 6), width, page_module.px(page, 30)), label, controls.BUTTON_PRIMARY, true) { join(network, allocator) }
            x += width + 8 * s
        } else {
            const label = page_module.say(page, "Disconnect", "Trennen")
            const width = controls.buttonWidth(page.*.ui, page.*.body, label)
            if controls.button(page.*.ui, page_module.idOf(ITEM_LEAVE), ui.rect(x, top + page_module.px(page, 6), width, page_module.px(page, 30)), label, controls.BUTTON_NORMAL, true) { simple(network, "Disconnect", "", allocator) }
            x += width + 8 * s
        }
        if wifi.*.saved {
            const label = page_module.say(page, "Forget", "Vergessen")
            const width = controls.buttonWidth(page.*.ui, page.*.body, label)
            if controls.button(page.*.ui, page_module.idOf(ITEM_FORGET), ui.rect(x, top + page_module.px(page, 6), width, page_module.px(page, 30)), label, controls.BUTTON_NORMAL, true) { simple(network, "Forget", ssidOf(wifi), allocator) }
        }
        top += page_module.px(page, 42)
    }
    return top
}

pub fn draw(network: *Network, page: *const Page, top: i32, allocator: std.allocator.Allocator) -> i32 {
    const theme = page.*.theme
    var y = top
    const intro = page_module.say(page, "The links mlx-netd looks after and the Wi-Fi networks it sees. It configures a link once it has a cable (or joined a network): by DHCP, or as /etc/mlx/network.conf says.", "Die Verbindungen, um die sich mlx-netd kümmert, und die WLAN-Netze in Reichweite. Eine Verbindung wird eingerichtet, sobald ein Kabel steckt (oder ein Netz verbunden ist): per DHCP oder wie /etc/mlx/network.conf es sagt.")
    const line = page_module.px(page, 18)
    const lines = popup.wrapped(page.*.ui, page.*.small, intro, page.*.left, y, page.*.width, line, 4, theme.*.dim)
    y += @intCast(i32, lines) * line + page_module.px(page, 4)
    if !network.*.known { return status_module.draw(statusOf(network), page, y, busPath(network)) }
    // The links.
    y = page_module.section(page, y, page_module.say(page, "Connections", "Verbindungen"))
    var has_wifi = false
    var index: usize = 0
    while index < network.*.linkCount {
        const link = linkAt(network, index)
        if same(kindOf(link), "wifi") { has_wifi = true }
        var label: [48]u8 = undefined
        const label_bytes: [*]u8 = &label
        var length = copyInto(label_bytes, 16, nameOf(link))
        length += copyInto(bytesAt(@intFromPtr(label_bytes), length), 4, " · ")
        length += copyInto(bytesAt(@intFromPtr(label_bytes), length), 16, kindLabel(page, kindOf(link)))
        var note: [200]u8 = undefined
        const note_bytes: [*]u8 = &note
        var note_length = copyInto(note_bytes, 40, stateLabel(page, link))
        if link.*.networkLength > 0 {
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 4, " · ")
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 32, joinedOf(link))
        }
        if link.*.addressLength > 0 {
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 4, " · ")
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 24, addressOf(link))
        }
        if link.*.gatewayLength > 0 {
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 8, page_module.say(page, " via ", " über "))
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 16, gatewayOf(link))
        }
        if link.*.dnsLength > 0 {
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 8, " · DNS ")
            note_length += copyInto(bytesAt(@intFromPtr(note_bytes), note_length), 64, dnsOf(link))
        }
        const on = !same(stateOf(link), "off")
        if page_module.switchRow(page, y, ITEM_LINK + index, label_bytes[0..length], note_bytes[0..note_length], on) { switchLink(network, link, !on, allocator) }
        y += page_module.px(page, page_module.SWITCH_ROW)
        index += 1
    }
    if network.*.linkCount == 0 { y = page_module.note(page, y, page_module.say(page, "No links.", "Keine Verbindungen.")) }
    if !has_wifi { return y }
    // The Wi-Fi networks.
    y = page_module.section(page, y, page_module.say(page, "Wi-Fi networks", "WLAN-Netze"))
    if page_module.buttonRow(page, y, ITEM_SCAN, page_module.say(page, "Search again", "Erneut suchen")) { simple(network, "Scan", "", allocator) }
    y += page_module.px(page, 40)
    if network.*.joiningLength > 0 {
        var joining: [64]u8 = undefined
        const joining_bytes: [*]u8 = &joining
        var joining_length = copyInto(joining_bytes, 24, page_module.say(page, "Joining ", "Verbinde mit "))
        joining_length += copyInto(bytesAt(@intFromPtr(joining_bytes), joining_length), 32, joiningOf(network))
        joining_length += copyInto(bytesAt(@intFromPtr(joining_bytes), joining_length), 3, "…")
        y = page_module.note(page, y, joining_bytes[0..joining_length])
    }
    if network.*.problemLength > 0 { y = page_module.note(page, y, problemOf(network)) }
    if network.*.networkCount == 0 {
        return page_module.note(page, y, page_module.say(page, "No network in sight yet.", "Noch kein Netz in Reichweite."))
    }
    index = 0
    while index < network.*.networkCount {
        const wifi = wifiAt(network, index)
        var value: [64]u8 = undefined
        const value_bytes: [*]u8 = &value
        const value_length = wifiValue(page, wifi, value_bytes)
        const chosen = same(ssidOf(wifi), chosenOf(network))
        if page_module.valueRow(page, y, ITEM_NETWORK + index, ssidOf(wifi), value_bytes[0..value_length]) {
            if chosen {
                network.*.chosenLength = 0
            } else {
                setChosen(network, ssidOf(wifi))
                network.*.focusWanted = true
                wipePassphrase(network)
                network.*.problemLength = 0
            }
        }
        y += page_module.px(page, page_module.VALUE_ROW)
        if same(ssidOf(wifi), chosenOf(network)) { y = actions(network, page, y, wifi, allocator) }
        index += 1
    }
    return y
}
