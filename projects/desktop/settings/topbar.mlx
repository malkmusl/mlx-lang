// The Top bar page: a preview of the bar's right side as it will look,
// then its items from left to right, each with its symbol, a switch
// (shown or hidden; the whole row takes the click) and arrows moving it a
// place up (to the left on the bar) or down. The rows and the preview's
// items glide to their new places, hidden ones fade. Every change is
// written to ~/.config/mlx/topbar.conf (shared/topbar_items.mlx), which
// the bar reads again within a second.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const timezone = @import("std.timezone")
const page_module = @import("./page.mlx")
const items_module = @import("../shared/topbar_items.mlx")
const symbols = @import("../shared/symbols.mlx")
const anim = @import("../shared/anim.mlx")
const clock = @import("../shared/clock.mlx")

const Canvas = canvas_module.Canvas
const Page = page_module.Page
const ITEMS = items_module.ITEMS

// Logical pixels: a row, the preview strip, an arrow button, a symbol.
const ROW: i32 = page_module.SWITCH_ROW
const PREVIEW: i32 = 36
const ARROW: i32 = 28
const SYMBOL: i32 = 20
// A row's place glides in 256ths of a row, the preview's items in pixels
// from the strip's right edge, over GLIDE milliseconds.
const STEPS: i32 = 256
const GLIDE: usize = 220

// The widgets' ids (page_module.idOf): an item's row, its arrows.
pub const ID_ROW: usize = 2000
pub const ID_UP: usize = 2100
pub const ID_DOWN: usize = 2200

pub const TopBar = struct {
    environment: [*][*]const u8
    items: items_module.Items
    // Each item's row (by its number), its place in the preview and how
    // much of it shows there (0 to 255).
    row: [8]anim.Glide
    place: [8]anim.Glide
    shown: [8]anim.Glide
    // The preview's places stand until it is first drawn.
    placed: bool
    // Something still glides: draw again.
    moving: bool
    // The file could not be written.
    failed: bool
    symbols: symbols.Cache
}

fn itemsOf(topbar: *TopBar) -> *items_module.Items {
    unsafe { return @ptrCast(*items_module.Items, &topbar.*.items) }
}

fn symbolsOf(topbar: *TopBar) -> *symbols.Cache {
    unsafe { return @ptrCast(*symbols.Cache, &topbar.*.symbols) }
}

fn glideAt(topbar: *TopBar, field: usize, item: usize) -> *anim.Glide {
    unsafe { return @ptrFromInt(*anim.Glide, @intFromPtr(topbar) + field + item * @sizeOf(anim.Glide)) }
}

fn rowOf(topbar: *TopBar, item: usize) -> *anim.Glide { return glideAt(topbar, @offsetOf(TopBar, "row"), item) }
fn placeOf(topbar: *TopBar, item: usize) -> *anim.Glide { return glideAt(topbar, @offsetOf(TopBar, "place"), item) }
fn shownOf(topbar: *TopBar, item: usize) -> *anim.Glide { return glideAt(topbar, @offsetOf(TopBar, "shown"), item) }

// Each row where it stands, without gliding.
fn settle(topbar: *TopBar) -> void {
    const items = itemsOf(topbar)
    var position: usize = 0
    while position < ITEMS {
        const item = items_module.at(items, position)
        anim.jump(rowOf(topbar, item), @intCast(i32, position) * STEPS)
        anim.jump(shownOf(topbar, item), if items_module.isShown(items, item) { 255 } else { 0 })
        position += 1
    }
    topbar.*.placed = false
}

pub fn init(topbar: *TopBar, environment: [*][*]const u8, allocator: std.allocator.Allocator) -> void {
    topbar.*.environment = environment
    topbar.*.moving = false
    topbar.*.failed = false
    symbols.init(symbolsOf(topbar), allocator)
    items_module.read(environment, allocator, itemsOf(topbar))
    settle(topbar)
}

// The file again (shown anew).
pub fn refresh(topbar: *TopBar, allocator: std.allocator.Allocator) -> void {
    items_module.read(topbar.*.environment, allocator, itemsOf(topbar))
    settle(topbar)
}

fn save(topbar: *TopBar) -> void {
    topbar.*.failed = !items_module.write(topbar.*.environment, itemsOf(topbar))
}

// Every row glides to where its item stands now.
fn glideRows(topbar: *TopBar) -> void {
    const items = itemsOf(topbar)
    var position: usize = 0
    while position < ITEMS {
        anim.set(rowOf(topbar, items_module.at(items, position)), @intCast(i32, position) * STEPS, GLIDE)
        position += 1
    }
}

fn itemSymbol(item: usize) -> u32 {
    return match item { 0 => symbols.CLOCK, 1 => symbols.BATTERY, 2 => symbols.SPEAKER, 3 => symbols.TRAY, 4 => symbols.NOTE, else => symbols.TOGGLES }
}

fn itemVariant(item: usize) -> u32 { return if item == items_module.BATTERY { 80 } else if item == items_module.SOUND { 3 } else { 0 } }

// ---------------------------------------------------------------------------
// The preview

// The width of an item in the preview (pixels).
fn previewWidth(page: *const Page, item: usize, time: []const u8) -> i32 {
    if item == items_module.CLOCK { return text_module.measure(page.*.small, time) + page_module.px(page, 12) }
    if item == items_module.MEDIA { return text_module.measure(page.*.small, page_module.say(page, "Song", "Titel")) + page_module.px(page, 34) }
    if item == items_module.TRAY { return page_module.px(page, 30) }
    return page_module.px(page, 28)
}

// The bar's right side: a strip as dark as the bar with the mark on the
// left and the shown items from the right edge in, as the bar will have
// them. Returns the y after it.
fn preview(topbar: *TopBar, page: *const Page, y: i32) -> i32 {
    const canvas = page.*.ui.*.canvas
    const theme = page.*.theme
    const height = page_module.px(page, PREVIEW)
    const right = page.*.left + page.*.width
    canvas_module.fillRoundedRect(canvas, page.*.left, y, page.*.width, height, page_module.px(page, 10), canvas_module.color(255, 22, 23, 29))
    canvas_module.strokeRoundedRect(canvas, page.*.left, y, page.*.width, height, page_module.px(page, 10), page.*.scale, canvas_module.color(255, 52, 54, 64))
    const size = page_module.px(page, 16)
    const middle = y + (height - size) / 2
    symbols.draw(symbolsOf(topbar), canvas, symbols.MARK, 0, page.*.left + page_module.px(page, 12), middle, size, 4294967295)
    // Now in the bar's words ("So. 11. Okt.  16:05").
    var bytes: [48]u8 = undefined
    var time_text: [*]u8 = undefined
    unsafe { time_text = @ptrCast([*]u8, &bytes) }
    const now = timezone.civil(timezone.now())
    const time_length = clock.format(&now, page.*.german, time_text)
    const time = time_text[0..time_length]
    // Where each goes: from the right edge in (pixels left of it).
    const items = itemsOf(topbar)
    var offset = page_module.px(page, 8)
    var position = ITEMS
    while position > 0 {
        position -= 1
        const item = items_module.at(items, position)
        const width = previewWidth(page, item, time)
        if items_module.isShown(items, item) {
            offset += width
            if topbar.*.placed { anim.set(placeOf(topbar, item), offset, GLIDE) } else { anim.jump(placeOf(topbar, item), offset) }
            offset += page_module.px(page, 4)
        } else if !topbar.*.placed {
            anim.jump(placeOf(topbar, item), offset + width)
        }
    }
    topbar.*.placed = true
    view.pushClip(page.*.ui, ui.rect(page.*.left + page_module.px(page, 36), y, page.*.width - page_module.px(page, 36), height))
    var item: usize = 0
    while item < ITEMS {
        const opacity = anim.value(shownOf(topbar, item))
        if anim.moving(placeOf(topbar, item)) || anim.moving(shownOf(topbar, item)) { topbar.*.moving = true }
        if opacity > 0 {
            canvas_module.setOpacity(canvas, @intCast(u32, opacity))
            const left = right - anim.value(placeOf(topbar, item))
            if item == items_module.CLOCK {
                text_module.drawText(canvas, page.*.small, time, left + page_module.px(page, 6), controls.textTop(page.*.small, y, height), theme.*.text, 0)
            } else if item == items_module.MEDIA {
                symbols.draw(symbolsOf(topbar), canvas, symbols.NOTE, 0, left + page_module.px(page, 6), middle, size, 4294967295)
                text_module.drawText(canvas, page.*.small, page_module.say(page, "Song", "Titel"), left + page_module.px(page, 28), controls.textTop(page.*.small, y, height), theme.*.dim, 0)
            } else {
                symbols.draw(symbolsOf(topbar), canvas, itemSymbol(item), itemVariant(item), left + (previewWidth(page, item, time) - size) / 2, middle, size, 4294967295)
            }
            canvas_module.setOpacity(canvas, 255)
        }
        item += 1
    }
    view.popClip(page.*.ui)
    return y + height + page_module.px(page, 8)
}

// ---------------------------------------------------------------------------
// The rows

// An arrow button (dim and taking no clicks when not `enabled`); true when
// clicked.
fn arrow(topbar: *TopBar, page: *const Page, id: usize, x: i32, y: i32, up: bool, enabled: bool) -> bool {
    const size = page_module.px(page, ARROW)
    var clicked = false
    if enabled { clicked = controls.miniButton(page.*.ui, page_module.idOf(id), ui.rect(x, y, size, size)) }
    const glyph = page_module.px(page, 18)
    const color = if enabled { page.*.theme.*.text } else { page.*.theme.*.disabled }
    symbols.draw(symbolsOf(topbar), page.*.ui.*.canvas, if up { symbols.CHEVRON_UP } else { symbols.CHEVRON_DOWN }, 0, x + (size - glyph) / 2, y + (size - glyph) / 2, glyph, color)
    return clicked
}

// The row of the item at `position`, drawn at `y`; lifted (on a raised
// background, over the others) while it glides.
fn row(topbar: *TopBar, page: *const Page, y: i32, position: usize, lifted: bool) -> void {
    const items = itemsOf(topbar)
    const item = items_module.at(items, position)
    const context = page.*.ui
    const theme = page.*.theme
    const canvas = context.*.canvas
    const s = page.*.scale
    const area = ui.rect(page.*.left - page_module.px(page, 8), y, page.*.width + page_module.px(page, 16), page_module.px(page, ROW - 4))
    const row_id = page_module.idOf(ID_ROW + item)
    view.region(context, row_id, area)
    const lit = view.isHover(context, row_id)
    if lifted { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius + 2, theme.*.raised) }
    if lit { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius + 2, theme.*.hover) }
    const on = items_module.isShown(items, item)
    const symbol_size = page_module.px(page, SYMBOL)
    symbols.draw(symbolsOf(topbar), canvas, itemSymbol(item), itemVariant(item), page.*.left, y + (area.height - symbol_size) / 2, symbol_size, if on { theme.*.text } else { theme.*.disabled })
    const switch_left = ui.right(area) - (8 + controls.SWITCH_WIDTH) * s
    const arrows_left = switch_left - page_module.px(page, 16 + 2 * ARROW + 4)
    const text_left = page.*.left + page_module.px(page, 34)
    const room = arrows_left - text_left - page_module.px(page, 8)
    controls.label(context, page.*.body, items_module.label(item, page.*.german), text_left, y + 2 * s, if on { theme.*.text } else { theme.*.dim }, room)
    controls.label(context, page.*.small, items_module.note(item, page.*.german), text_left, y + 22 * s, theme.*.dim, room)
    controls.drawSwitch(context, switch_left, area.y + (area.height - controls.SWITCH_HEIGHT * s) / 2, on, lit)
    const arrow_top = area.y + (area.height - page_module.px(page, ARROW)) / 2
    if arrow(topbar, page, ID_UP + item, arrows_left, arrow_top, true, position > 0) {
        if items_module.move(items, position, true) {
            glideRows(topbar)
            save(topbar)
        }
    }
    if arrow(topbar, page, ID_DOWN + item, arrows_left + page_module.px(page, ARROW + 4), arrow_top, false, position + 1 < ITEMS) {
        if items_module.move(items, position, false) {
            glideRows(topbar)
            save(topbar)
        }
    }
    if view.takeClick(context, row_id) {
        items.*.shown[item] = !on
        anim.set(shownOf(topbar, item), if on { 0 } else { 255 }, GLIDE)
        save(topbar)
    }
}

// The page from `top`; the y after it. topbar.moving says whether it
// should be drawn again (something glides).
pub fn draw(topbar: *TopBar, page: *const Page, top: i32) -> i32 {
    topbar.*.moving = false
    var y = page_module.section(page, top, page_module.say(page, "Preview", "Vorschau"))
    y = preview(topbar, page, y)
    y = page_module.section(page, y, page_module.say(page, "Items from left to right", "Elemente von links nach rechts"))
    const first = y
    const step = page_module.px(page, ROW)
    // The rows moving are drawn last (over the others).
    var pass: usize = 0
    while pass < 2 {
        var position: usize = 0
        while position < ITEMS {
            const glide = rowOf(topbar, items_module.at(itemsOf(topbar), position))
            const gliding = anim.moving(glide)
            if gliding { topbar.*.moving = true }
            if (pass == 1) == gliding { row(topbar, page, first + anim.value(glide) * step / STEPS, position, gliding) }
            position += 1
        }
        pass += 1
    }
    y = first + @intCast(i32, ITEMS) * step
    if topbar.*.failed { return page_module.note(page, y, page_module.say(page, "The file could not be written.", "Die Datei konnte nicht geschrieben werden.")) }
    return page_module.note(page, y, page_module.say(page, "The bar takes a change within a second.", "Die Leiste übernimmt Änderungen binnen einer Sekunde."))
}
