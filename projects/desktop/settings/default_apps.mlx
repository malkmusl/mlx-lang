// The Apps page's first part: the default apps by file extension
// (shared/defaults.mlx). Polaris asks for an extension the first time a
// file of it is opened (its Open with popup); here are the extensions
// chosen so far, the user's and the system's, each with its app. A click
// on one shows the apps to choose from (those that take its type first)
// and, for the user's own, Forget (the system's choice, or Polaris's
// question, again).
const std = @import("std")
const mime = @import("std.http.mime")
const apps_module = @import("../shared/apps.mlx")
const defaults = @import("../shared/defaults.mlx")
const page_module = @import("./page.mlx")

const Page = page_module.Page

pub const ID_ROW: usize = 5000
pub const ID_CHOICE: usize = 5200
pub const ID_FORGET: usize = 5199
const MAX: usize = 64

// The extension shown open (its apps to choose from); none: length 0.
pub const DefaultApps = struct {
    open: [24]u8
    openLength: usize
}

pub fn init(state: *DefaultApps) -> void { state.*.openLength = 0 }

fn openOf(state: *DefaultApps) -> []const u8 {
    const bytes: [*]u8 = &state.*.open
    return bytes[0..state.*.openLength]
}

// One extension's line: where its key and app are in `text`, and whether
// it is the user's.
const Line = struct {
    keyAt: usize
    keyLength: usize
    idAt: usize
    idLength: usize
    mine: bool
}

// The lines of `text` (a defaults file in `buffer`) not listed yet,
// into `lines`.
fn collect(text: []const u8, mine: bool, lines: *[64]Line, count: *usize, buffer: [*]const u8) -> void {
    var at: usize = 0
    while at < text.length && count.* < MAX {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        at = end + 1
        var key: []const u8 = ""
        var id: []const u8 = ""
        if !defaults.splitLine(line, &key, &id) || key[0] != 46 { continue }
        var known = false
        var index: usize = 0
        while index < count.* {
            const other = lines.*[index]
            if std.text.same(buffer[other.keyAt..other.keyAt + other.keyLength], key) { known = true }
            index += 1
        }
        if known { continue }
        lines.*[count.*] = Line.{ .keyAt = @intFromPtr(key.pointer) - @intFromPtr(buffer), .keyLength = key.length, .idAt = @intFromPtr(id.pointer) - @intFromPtr(buffer), .idLength = id.length, .mine = mine }
        count.* += 1
    }
}

// The default apps on `page` from `top`; the y after them.
pub fn draw(state: *DefaultApps, apps: *apps_module.Apps, environment: [*][*]const u8, page: *const Page, top: i32) -> i32 {
    var y = page_module.section(page, top, page_module.say(page, "Default apps by file extension", "Standard-Apps nach Dateiendung"))
    y = page_module.note(page, y - page_module.px(page, 8), page_module.say(page, "Polaris asks for a new extension when it is first opened.", "Polaris fragt bei einer neuen Endung beim ersten Öffnen."))
    // The user's file and the system's, one buffer.
    var buffer: [16384]u8 = undefined
    const bytes: [*]u8 = &buffer
    var path: [1024]u8 = undefined
    const path_bytes: [*]u8 = &path
    var user_size: usize = 0
    if defaults.userPath(environment, path_bytes, 1000) > 0 { user_size = std.fs.readFile(path_bytes, bytes, 8192) }
    const system_size = std.fs.readFile(defaults.systemPath(), bytes + 8192, 8192)
    var lines: [64]Line = undefined
    var count: usize = 0
    collect(bytes[0..user_size], true, &lines, &count, bytes)
    collect(bytes[8192..8192 + system_size], false, &lines, &count, bytes)
    if count == 0 { return page_module.note(page, y, page_module.say(page, "No extension has an app yet.", "Noch keine Endung hat eine App.")) + page_module.px(page, 8) }
    var index: usize = 0
    while index < count {
        const line = lines[index]
        // (Copied: a choice below writes the file the buffer was read from.)
        var key_copy: [24]u8 = undefined
        const key_bytes: [*]u8 = &key_copy
        var key_length: usize = 0
        while key_length < line.keyLength && key_length < 24 {
            key_bytes[key_length] = bytes[line.keyAt + key_length]
            key_length += 1
        }
        const key = key_bytes[0..key_length]
        const id = bytes[line.idAt..line.idAt + line.idLength]
        const found = apps_module.find(apps, id)
        var value: [128]u8 = undefined
        const value_bytes: [*]u8 = &value
        var value_length = std.text.append(value_bytes, 0, 100, if found < apps.*.count { apps_module.nameOf(apps_module.appAt(apps, found)) } else { id })
        if !line.mine { value_length = std.text.append(value_bytes, value_length, 127, page_module.say(page, " (system)", " (System)")) }
        const label = if key.length <= 1 { page_module.say(page, "Without an extension", "Ohne Endung") } else { key }
        const shown = std.text.same(openOf(state), key)
        if page_module.valueRow(page, y, ID_ROW + index, label, value_bytes[0..value_length]) {
            if shown {
                state.*.openLength = 0
            } else {
                state.*.openLength = 0
                for byte in key {
                    state.*.open[state.*.openLength] = byte
                    state.*.openLength += 1
                }
            }
        }
        y += page_module.px(page, page_module.VALUE_ROW)
        if shown {
            // The apps, those that take its type first.
            var sample: [32]u8 = undefined
            const sample_bytes: [*]u8 = &sample
            var sample_length = std.text.append(sample_bytes, 0, 30, "file")
            if key.length > 1 { sample_length = std.text.append(sample_bytes, sample_length, 30, key) }
            var uncertain = false
            var type_ = mime.byName(sample_bytes[0..sample_length], &uncertain)
            if type_.length == 0 { type_ = "text/plain" }
            var choices: [32]usize = undefined
            const choice_bytes: [*]usize = &choices
            var recommended: usize = 0
            const choice_count = defaults.ranked(apps, type_, choice_bytes, 32, &recommended)
            var choice: usize = 0
            while choice < choice_count {
                const offered = apps_module.appAt(apps, choices[choice])
                if page_module.choiceRow(page, y, ID_CHOICE + choice, apps_module.nameOf(offered), choices[choice] == found) {
                    _ = defaults.choose(environment, key, apps_module.idOf(offered))
                }
                y += page_module.px(page, page_module.CHOICE_ROW)
                choice += 1
            }
            if line.mine {
                if page_module.buttonRow(page, y, ID_FORGET, page_module.say(page, "Forget this choice", "Diese Wahl vergessen")) {
                    _ = defaults.forget(environment, key)
                    state.*.openLength = 0
                }
                y += page_module.px(page, 44)
            }
        }
        index += 1
    }
    return y + page_module.px(page, 12)
}
