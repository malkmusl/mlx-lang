// The Apps page's first part: the default apps, which app opens each kind
// of file (shared/defaults.mlx: the user's defaults.conf). A kind with an
// app that takes it shows those apps as choices, the one that opens it
// now chosen; a click makes another one its default (for the whole kind:
// "image/*", "text/*"; Polaris's Always open sets one type).
const std = @import("std")
const apps_module = @import("../shared/apps.mlx")
const defaults = @import("../shared/defaults.mlx")
const page_module = @import("./page.mlx")

const Page = page_module.Page

pub const ID_CHOICE: usize = 5000

// The default apps' choices on `page` from `top`; the y after them.
pub fn draw(apps: *apps_module.Apps, environment: [*][*]const u8, page: *const Page, top: i32) -> i32 {
    var y = page_module.section(page, top, page_module.say(page, "Default apps", "Standard-Apps"))
    y = page_module.note(page, y - page_module.px(page, 8), page_module.say(page, "Which app opens a file of each kind (a double click in Polaris).", "Welche App eine Datei jeder Art öffnet (ein Doppelklick in Polaris)."))
    var shown = false
    var kind: usize = 0
    while kind < defaults.KINDS {
        var choices: [8]usize = undefined
        const choice_bytes: [*]usize = &choices
        const count = defaults.candidates(apps, defaults.kindSample(kind), choice_bytes, 8)
        if count > 0 {
            shown = true
            y = page_module.section(page, y, defaults.kindName(kind, page.*.german))
            const current = defaults.appFor(apps, environment, defaults.kindSample(kind))
            var index: usize = 0
            while index < count {
                const app = apps_module.appAt(apps, choices[index])
                if page_module.choiceRow(page, y, ID_CHOICE + kind * 16 + index, apps_module.nameOf(app), choices[index] == current) {
                    _ = defaults.choose(environment, defaults.kindType(kind), apps_module.idOf(app))
                }
                y += page_module.px(page, page_module.CHOICE_ROW)
                index += 1
            }
        }
        kind += 1
    }
    if !shown { y = page_module.note(page, y, page_module.say(page, "No app says which files it opens.", "Keine App sagt, welche Dateien sie öffnet.")) }
    return y + page_module.px(page, 12)
}
