// What a settings page draws with: where its rows go, the widgets'
// context, fonts and theme, and the rows every page uses (sections,
// notes, switches, choices, sliders). main.mlx, sound.mlx and display.mlx
// share them.
const ui = @import("std.ui")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")

const Text = text_module.Text

pub const SWITCH_ROW: i32 = 50
pub const CHOICE_ROW: i32 = 38
pub const SLIDER_ROW: i32 = 40

// Where the page's rows go: from `left`, `width` wide (pixels).
pub const Page = struct {
    left: i32
    width: i32
    ui: *view.Ui
    body: *Text
    small: *Text
    theme: *theme_module.Theme
    scale: i32
    german: bool
}

pub fn idOf(item: usize) -> u64 { return @intCast(u64, item) + 1 }

// `value` logical pixels in pixels.
pub fn px(page: *const Page, value: i32) -> i32 { return value * page.*.scale }

pub fn say(page: *const Page, english: []const u8, german: []const u8) -> []const u8 {
    return if page.*.german { german } else { english }
}

// A section's name, small above its rows; the y after it.
pub fn section(page: *const Page, y: i32, name: []const u8) -> i32 {
    const top = y + px(page, 10)
    controls.label(page.*.ui, page.*.small, name, page.*.left, top, page.*.theme.*.dim, page.*.width)
    return top + px(page, 24)
}

// A note in small dim text; the y after it.
pub fn note(page: *const Page, y: i32, text: []const u8) -> i32 {
    controls.label(page.*.ui, page.*.small, text, page.*.left, y + px(page, 6), page.*.theme.*.dim, page.*.width)
    return y + px(page, 26)
}

// A line of body text; the y after it.
pub fn line(page: *const Page, y: i32, text: []const u8) -> i32 {
    controls.label(page.*.ui, page.*.body, text, page.*.left, y + px(page, 6), page.*.theme.*.text, page.*.width)
    return y + px(page, 28)
}

// A row with a name on the left and its value on the right (read only);
// the y after it.
pub fn infoRow(page: *const Page, y: i32, name: []const u8, value: []const u8) -> i32 {
    const half = page.*.width * 2 / 5
    controls.label(page.*.ui, page.*.body, name, page.*.left, y + px(page, 6), page.*.theme.*.dim, half)
    controls.label(page.*.ui, page.*.body, value, page.*.left + half, y + px(page, 6), page.*.theme.*.text, page.*.width - half)
    return y + px(page, 30)
}

// A switch row; true when clicked.
pub fn switchRow(page: *const Page, y: i32, item: usize, label: []const u8, note_text: []const u8, on: bool) -> bool {
    return controls.switchRow(page.*.ui, idOf(item), ui.rect(page.*.left - px(page, 8), y, page.*.width + px(page, 16), px(page, SWITCH_ROW - 4)), label, note_text, on)
}

// A choice among several (a radio button); true when clicked.
pub fn choiceRow(page: *const Page, y: i32, item: usize, label: []const u8, chosen: bool) -> bool {
    return controls.radioRow(page.*.ui, idOf(item), ui.rect(page.*.left - px(page, 8), y, page.*.width + px(page, 16), px(page, CHOICE_ROW - 4)), label, chosen)
}

// A slider row: `label` on the left, the slider, the value in percent of
// `hundred` on the right. Returns the value it has now.
pub fn sliderRow(page: *const Page, y: i32, item: usize, label: []const u8, value: u32, hundred: u32, most: u32) -> u32 {
    const label_width = page.*.width * 2 / 5
    const number_width = px(page, 48)
    const area = ui.rect(page.*.left + label_width, y + px(page, 8), page.*.width - label_width - number_width, px(page, SLIDER_ROW - 16))
    controls.label(page.*.ui, page.*.body, label, page.*.left, controls.textTop(page.*.body, y, px(page, SLIDER_ROW)), page.*.theme.*.text, label_width - px(page, 8))
    const now = controls.slider(page.*.ui, idOf(item), area, value, most)
    var digits: [8]u8 = undefined
    var length: usize = 0
    var percent = (now * 100 + hundred / 2) / hundred
    var reversed: [8]u8 = undefined
    var count: usize = 0
    while true {
        reversed[count] = @intCast(u8, 48 + percent % 10)
        count += 1
        percent = percent / 10
        if percent == 0 { break }
    }
    while count > 0 {
        count -= 1
        digits[length] = reversed[count]
        length += 1
    }
    digits[length] = 37
    length += 1
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &digits) }
    controls.label(page.*.ui, page.*.body, bytes[0..length], page.*.left + page.*.width - number_width + px(page, 10), controls.textTop(page.*.body, y, px(page, SLIDER_ROW)), page.*.theme.*.dim, number_width)
    return now
}

// A button on its own row (at the page's left); true when clicked.
pub fn buttonRow(page: *const Page, y: i32, item: usize, label: []const u8) -> bool {
    const width = controls.buttonWidth(page.*.ui, page.*.body, label)
    return controls.button(page.*.ui, idOf(item), ui.rect(page.*.left, y + px(page, 4), width, px(page, 30)), label, controls.BUTTON_NORMAL, true)
}
