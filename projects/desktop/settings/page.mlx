// What a settings page draws with: where its rows go, the widgets'
// context, fonts and theme, and the rows every page uses (sections,
// notes, switches, choices, sliders), laid out by std.ui.flow and drawn
// by std.ui.widgets. main.mlx, sound.mlx and display.mlx share them. Each
// row takes the y it goes at (the page scrolls) and its widget's id is the
// page's item number (std.ui.flow.id), so the pages can map hits back to
// their items.
const ui = @import("std.ui")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const flow_module = @import("std.ui.flow")
const widgets = @import("std.ui.widgets")
const surface = @import("std.ui.surface")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")

const Text = text_module.Text

// The rows' heights with the gap after them (logical pixels): a switch
// row with a note, a choice (radio) row, a slider row, a value row.
pub const SWITCH_ROW: i32 = widgets.ROW + flow_module.DEFAULT_GAP
pub const CHOICE_ROW: i32 = widgets.SHORT_ROW + flow_module.DEFAULT_GAP
pub const SLIDER_ROW: i32 = widgets.SHORT_ROW + flow_module.DEFAULT_GAP
pub const VALUE_ROW: i32 = widgets.SHORT_ROW + flow_module.DEFAULT_GAP

// Where the page's rows go: from `left`, `width` wide (pixels).
pub const Page = struct {
    left: i32
    width: i32
    ui: *view.Ui
    body: *Text
    small: *Text
    theme: *theme_module.Theme
    scale: i32
    german: bool
    // Between cardBegin and cardEnd: the rows are inset by the card's
    // padding.
    inCard: bool
}

// Where a row's text starts: the alignment edge (the header's title and
// the section labels share it).
pub fn textLeft(page: *Page) -> i32 { return page.*.left + px(page, widgets.TEXT_INSET) }

pub fn idOf(item: usize) -> u64 { return @intCast(u64, item) + 1 }

// `value` logical pixels in pixels.
pub fn px(page: *Page, value: i32) -> i32 { return value * page.*.scale }

pub fn say(page: *Page, english: []const u8, german: []const u8) -> []const u8 {
    return if page.*.german { german } else { english }
}

// A flow for one row at y (the page lays its rows out itself, each at
// its y, as it scrolls them); inset in a card.
fn rowAt(page: *Page, y: i32) -> flow_module.Flow {
    var row = flow_module.begin(page.*.ui, ui.rect(page.*.left, y, page.*.width, 100000), page.*.scale)
    if page.*.inCard { row.inset = px(page, widgets.CARD_PADDING) }
    return row
}

// The rectangle of a row `logical` logical pixels tall at y, as the
// widgets' rows lie (for a page's own controls).
pub fn rowRect(page: *Page, y: i32, logical: i32) -> ui.Rect {
    var row = rowAt(page, y)
    return flow_module.row(&row, logical)
}

// The y after what a flow laid out.
fn after(row: *const flow_module.Flow) -> i32 { return row.*.area.y + flow_module.used(row) + flow_module.px(row, row.*.gap) }

// A section's name, small above its rows; the y after it.
pub fn section(page: *Page, y: i32, name: []const u8) -> i32 {
    var row = rowAt(page, y)
    widgets.section(&row, name)
    return after(&row)
}

// A note in small dim text (wrapped); the y after it.
pub fn note(page: *Page, y: i32, text: []const u8) -> i32 {
    var row = rowAt(page, y)
    widgets.note(&row, text)
    return after(&row)
}

// A line of body text; the y after it.
pub fn line(page: *Page, y: i32, text: []const u8) -> i32 {
    var row = rowAt(page, y)
    widgets.line(&row, text)
    return after(&row)
}

// A row with a name on the left and its value on the right (read only);
// the y after it.
pub fn infoRow(page: *Page, y: i32, name: []const u8, value: []const u8) -> i32 {
    var row = rowAt(page, y)
    widgets.infoRow(&row, name, value)
    return after(&row)
}

// A switch row; true when clicked (the caller flips its setting; the
// pages keep their settings themselves, so the row is the control's, in
// the widgets' row).
pub fn switchRow(page: *Page, y: i32, item: usize, label: []const u8, note_text: []const u8, on: bool) -> bool {
    var row = rowAt(page, y)
    const area = flow_module.row(&row, if note_text.length > 0 { widgets.ROW } else { widgets.SHORT_ROW })
    return controls.switchRow(page.*.ui, idOf(item), area, label, note_text, on)
}

// A choice among several (a radio button); true when clicked.
pub fn choiceRow(page: *Page, y: i32, item: usize, label: []const u8, chosen: bool) -> bool {
    var row = rowAt(page, y)
    const area = flow_module.row(&row, widgets.SHORT_ROW)
    return controls.radioRow(page.*.ui, idOf(item), area, label, chosen)
}

// A slider row: `label` on the left, the slider, the value in percent of
// `hundred` on the right. Returns the value it has now.
pub fn sliderRow(page: *Page, y: i32, item: usize, label: []const u8, value: u32, hundred: u32, most: u32) -> u32 {
    var row = rowAt(page, y)
    const area = flow_module.row(&row, widgets.SHORT_ROW)
    const label_width = area.width * 2 / 5
    const number_width = px(page, 56)
    const top = controls.textTop(page.*.body, area.y, area.height)
    controls.label(page.*.ui, page.*.body, label, textLeft(page), top, page.*.theme.*.text, label_width - px(page, 12))
    const track = ui.rect(area.x + label_width, area.y + px(page, 6), area.width - label_width - number_width - px(page, 8), area.height - px(page, 12))
    const now = controls.slider(page.*.ui, idOf(item), track, value, most)
    var digits: [8]u8 = undefined
    var length: usize = 0
    var percent = (now * 100 + hundred / 2) / hundred
    var reversed: [8]u8 = undefined
    var count: usize = 0
    while true {
        reversed[count] = @intCast(u8, 48 + percent % 10)
        count += 1
        percent = percent / 10
        if percent == 0 { break }
    }
    while count > 0 {
        count -= 1
        digits[length] = reversed[count]
        length += 1
    }
    digits[length] = 37
    length += 1
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &digits) }
    controls.label(page.*.ui, page.*.body, bytes[0..length], ui.right(area) - number_width + px(page, 10), top, page.*.theme.*.dim, number_width)
    return now
}

// A row with `label` and `value` in a box at its right (a choice that
// changes on a click); true when clicked.
pub fn valueRow(page: *Page, y: i32, item: usize, label: []const u8, value: []const u8) -> bool {
    var row = rowAt(page, y)
    flow_module.id(&row, idOf(item))
    return widgets.valueRow(&row, label, value, false)
}

// A button on its own row (at the page's left); true when clicked.
pub fn buttonRow(page: *Page, y: i32, item: usize, label: []const u8) -> bool {
    var row = rowAt(page, y)
    flow_module.id(&row, idOf(item))
    return widgets.button(&row, label, controls.BUTTON_NORMAL)
}

// A card around a group of rows: cardBegin draws it (as tall as it was
// in the last frame, std.ui.view.measured) across the page's width and
// returns the y of the first row in it (the rows are inset by the
// card's padding until cardEnd); cardEnd takes the y cardBegin was given
// and the y after the last row, remembers the height and returns the y
// after the card.
//
//     const card = y
//     y = page_module.cardBegin(page, y, "dock")
//     ...rows at y...
//     y = page_module.cardEnd(page, card, y, "dock")
pub fn cardBegin(page: *Page, y: i32, name: []const u8) -> i32 {
    const height = view.measured(page.*.ui, view.id(name))
    if height > 0 { surface.card(page.*.ui, ui.rect(page.*.left, y, page.*.width, height)) }
    page.*.inCard = true
    return y + px(page, widgets.CARD_PADDING)
}

pub fn cardEnd(page: *Page, top: i32, y: i32, name: []const u8) -> i32 {
    const bottom = y + px(page, widgets.CARD_PADDING)
    view.setMeasured(page.*.ui, view.id(name), bottom - top)
    page.*.inCard = false
    return bottom + px(page, widgets.CARD_GAP)
}
