// The Appearance page's wallpaper and colours: the desktop takes its
// colours from its background as Material You does (the compositor's
// background.mlx, std.ui.scheme), or from a colour the user chooses. Its
// keys in compositor.conf: `wallpaper` (a PNG or JPEG; none: a background
// made of the colours) and `accent-color` (auto: from the wallpaper, or
// #rrggbb). The wallpaper is chosen with std.ui.chooser over the page.
// main.mlx keeps the values with the rest of the file and saves them when
// `changed` says so.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const canvas_module = @import("std.ui.canvas")
const chooser_module = @import("std.ui.chooser")
const scheme_module = @import("std.ui.scheme")
const page_module = @import("./page.mlx")
const apps_module = @import("../shared/apps.mlx")

const Page = page_module.Page

// The colours on offer to start from (0xRRGGBB): lively ones, around the
// wheel.
const SEEDS: usize = 11

fn seed(index: usize) -> u32 {
    return match index {
        0 => 8150271, 1 => 3900150, 2 => 439252, 3 => 1357990, 4 => 2278750, 5 => 8703254,
        6 => 16096779, 7 => 16347926, 8 => 15680580, 9 => 15485081, else => 14239471
    }
}

// The widgets' ids (page_module.idOf).
pub const ID_AUTO: usize = 4000
pub const ID_OWN: usize = 4001
pub const ID_CHOOSE: usize = 4002
pub const ID_NONE: usize = 4003
pub const ID_SEED: usize = 4010

const SWATCH: i32 = 28
const SWATCH_GAP: i32 = 10

pub const Colours = struct {
    environment: [*][*]const u8
    // The wallpaper's path (empty: none) and the chosen colour (0: from
    // the wallpaper), as the file has them.
    wallpaper: [256]u8
    wallpaperLength: usize
    seed: u32
    // Choosing a wallpaper: the chooser over the page.
    choosing: bool
    chooser: chooser_module.Chooser
    // Something was changed: main.mlx saves the file.
    changed: bool
}

fn chooserOf(colours: *Colours) -> *chooser_module.Chooser {
    unsafe { return @ptrCast(*chooser_module.Chooser, &colours.*.chooser) }
}

pub fn init(colours: *Colours, environment: [*][*]const u8) -> void {
    colours.*.environment = environment
    colours.*.chooser = chooser_module.Chooser.init()
    colours.*.choosing = false
    colours.*.changed = false
    defaults(colours)
}

pub fn defaults(colours: *Colours) -> void {
    colours.*.wallpaperLength = 0
    colours.*.seed = 0
}

fn wallpaperText(colours: *Colours) -> []const u8 {
    const bytes: [*]const u8 = &colours.*.wallpaper
    return bytes[0..colours.*.wallpaperLength]
}

fn setWallpaper(colours: *Colours, text: []const u8) -> void {
    if text.length > 255 { return }
    var index: usize = 0
    while index < text.length {
        colours.*.wallpaper[index] = text[index]
        index += 1
    }
    colours.*.wallpaperLength = text.length
}

// A compositor.conf line about them into the values; false when `key` is
// none of theirs.
pub fn loadKey(colours: *Colours, key: []const u8, value: []const u8) -> bool {
    if std.text.same(key, "wallpaper") {
        if std.text.same(value, "none") { colours.*.wallpaperLength = 0 } else { setWallpaper(colours, value) }
        return true
    }
    if std.text.same(key, "accent-color") {
        var color: u32 = 0
        if std.text.same(value, "auto") {
            colours.*.seed = 0
        } else if scheme_module.parseColor(value, &color) {
            colours.*.seed = color & 16777215
        }
        return true
    }
    return false
}

fn append(into: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        into[index] = byte
        index += 1
    }
    return index
}

// The lines for compositor.conf from `at`; the end (at most 300 bytes).
pub fn save(colours: *Colours, into: [*]u8, at: usize) -> usize {
    var length = at
    if colours.*.wallpaperLength > 0 {
        length = append(into, length, "wallpaper = ")
        length = append(into, length, wallpaperText(colours))
        length = append(into, length, "\n")
    }
    length = append(into, length, "accent-color = ")
    if colours.*.seed == 0 {
        length = append(into, length, "auto")
    } else {
        length = scheme_module.formatColor(colours.*.seed, into, length)
    }
    return append(into, length, "\n")
}

// The file name of the wallpaper (after its last /).
fn fileName(text: []const u8) -> []const u8 {
    var start: usize = 0
    var index: usize = 0
    while index < text.length {
        if text[index] == 47 { start = index + 1 }
        index += 1
    }
    return text[start..text.length]
}

// The desktop's prism as a strip: what the colours give now.
fn prismStrip(page: *const Page, y: i32, height: i32) -> void {
    const canvas = page.*.ui.*.canvas
    const steps: i32 = 48
    const width = page.*.width
    var step: i32 = 0
    while step < steps {
        const left = page.*.left + width * step / steps
        const right = page.*.left + width * (step + 1) / steps
        const t = step * 1024 / (steps - 1)
        const color = if t < 512 { scheme_module.mix(scheme_module.prism(0), scheme_module.prism(1), t * 2) } else { scheme_module.mix(scheme_module.prism(1), scheme_module.prism(2), (t - 512) * 2) }
        canvas_module.fillRect(canvas, left, y, right - left, height, color)
        step += 1
    }
}

// The section from `top`; the y after it.
pub fn draw(colours: *Colours, page: *const Page, top: i32) -> i32 {
    const context = page.*.ui
    var y = page_module.section(page, top, page_module.say(page, "Wallpaper", "Hintergrundbild"))
    const name = if colours.*.wallpaperLength > 0 { fileName(wallpaperText(colours)) } else { page_module.say(page, "None: made of the colours", "Keins: aus den Farben gemacht") }
    controls.label(context, page.*.body, name, page.*.left, y + page_module.px(page, 6), page.*.theme.*.text, page.*.width)
    y += page_module.px(page, 30)
    const choose_label = page_module.say(page, "Choose a picture...", "Bild wählen...")
    const choose_width = controls.buttonWidth(context, page.*.body, choose_label)
    if controls.button(context, page_module.idOf(ID_CHOOSE), ui.rect(page.*.left, y, choose_width, page_module.px(page, 30)), choose_label, controls.BUTTON_NORMAL, true) {
        // Where it last chose, else the Pictures folder, else home.
        var folder: [256]u8 = undefined
        const bytes: [*]u8 = &folder
        var length: usize = 0
        const home = apps_module.environmentValue(colours.*.environment, "HOME")
        if @intFromPtr(home) != 0 {
            while home[length] != 0 && length < 200 {
                bytes[length] = home[length]
                length += 1
            }
            const pictures = std.text.append(bytes, length, 250, "/Pictures")
            bytes[pictures] = 0
            if std.fs.exists(bytes) { length = pictures }
        }
        chooser_module.startFor(chooserOf(colours), colours.*.environment, "org.mlx.settings", bytes[0..length], false, "image/png,image/jpeg,.png,.jpg,.jpeg")
        colours.*.choosing = true
    }
    if colours.*.wallpaperLength > 0 {
        const none_label = page_module.say(page, "No picture", "Kein Bild")
        if controls.button(context, page_module.idOf(ID_NONE), ui.rect(page.*.left + choose_width + page_module.px(page, 8), y, controls.buttonWidth(context, page.*.body, none_label), page_module.px(page, 30)), none_label, controls.BUTTON_NORMAL, true) {
            colours.*.wallpaperLength = 0
            colours.*.changed = true
        }
    }
    y += page_module.px(page, 40)
    y = page_module.section(page, y, page_module.say(page, "Colours", "Farben"))
    if page_module.choiceRow(page, y, ID_AUTO, page_module.say(page, "From the wallpaper", "Aus dem Hintergrund"), colours.*.seed == 0) && colours.*.seed != 0 {
        colours.*.seed = 0
        colours.*.changed = true
    }
    y += page_module.px(page, page_module.CHOICE_ROW)
    if page_module.choiceRow(page, y, ID_OWN, page_module.say(page, "My own colour", "Eigene Farbe"), colours.*.seed != 0) && colours.*.seed == 0 {
        colours.*.seed = seed(0)
        colours.*.changed = true
    }
    y += page_module.px(page, page_module.CHOICE_ROW)
    // The colours to start from (choosing one chooses "My own colour").
    const size = page_module.px(page, SWATCH)
    const step = size + page_module.px(page, SWATCH_GAP)
    var per_row = page.*.width / step
    if per_row < 1 { per_row = 1 }
    var index: usize = 0
    var at = y + page_module.px(page, 4)
    while index < SEEDS {
        const column = @intCast(i32, index) % per_row
        if column == 0 && index > 0 { at += step }
        const color = seed(index)
        if controls.swatch(context, page_module.idOf(ID_SEED + index), page.*.left + column * step, at, size, 4278190080 | color, color == colours.*.seed) {
            colours.*.seed = color
            colours.*.changed = true
        }
        index += 1
    }
    y = at + step + page_module.px(page, 6)
    // What they give: the desktop's gradient.
    prismStrip(page, y, page_module.px(page, 10))
    y += page_module.px(page, 14)
    return page_module.note(page, y, page_module.say(page, "Title bars, the top bar, the dock and every app take these colours.", "Titelleisten, Leiste, Dock und alle Apps übernehmen diese Farben."))
}

// The chooser over `area` while it is shown; true while it is.
pub fn drawChooser(colours: *Colours, context: *view.Ui, area: ui.Rect) -> bool {
    if !colours.*.choosing { return false }
    const result = chooser_module.draw(chooserOf(colours), context, area)
    if result == chooser_module.WAITING { return true }
    colours.*.choosing = false
    if result == chooser_module.CHOSEN {
        var paths = std.ArrayList(u8).init(std.heap.allocator())
        chooser_module.paths(chooserOf(colours), &paths)
        // The first path (a line each).
        const text = paths.items()
        var end: usize = 0
        while end < text.length && text[end] != 10 { end += 1 }
        if end > 0 {
            setWallpaper(colours, text[0..end])
            colours.*.changed = true
        }
        paths.deinit()
    }
    return false
}

// A key while the chooser is shown; true when it took it.
pub fn keyTyped(colours: *Colours, code: u32, modifiers: u32, typed: []const u8) -> bool {
    if !colours.*.choosing { return false }
    _ = chooser_module.keyTyped(chooserOf(colours), code, modifiers, typed)
    return true
}
