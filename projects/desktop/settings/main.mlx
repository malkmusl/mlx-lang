// The settings app of the Mlx desktop (std.ui.host: a Wayland window): a
// sidebar of categories and their settings beside it, which change the
// compositor and the apps while they run.
//
//   General: the dock hiding at the screen's edge, the hotkey for a
//     terminal, where the settings are kept.
//   Window management: title bars and their frames-per-second counter,
//     programs drawing their own title bars (client decorations, off by
//     default), wobbly windows, and the window hotkeys: a click on one
//     records the next key combination (the compositor passes every key
//     to the window meanwhile: keyboard-shortcuts-inhibit), Escape keeps
//     the old one, Backspace unbinds it and a right click restores the
//     default.
//   Appearance: the border colour of the focused window and of the
//     others, and how round window corners are.
//   Display: the monitor (connector, resolution, refresh rate), the mode
//     it starts in, and night light (warmer colours), from what the
//     compositor tells in $XDG_RUNTIME_DIR/<WAYLAND_DISPLAY>.display.
//   Sound: MLX Audio's output and input (the sound cards, or none), their
//     volumes and mute, the apps playing and recording with each one's
//     volume, and which apps may use the microphone (MLXIPC's permission
//     audio.record, written into ~/.config/mlx/ipc.conf). It talks to
//     mlx-audiod over std.audio (the server keeps the choice in
//     ~/.config/mlx/audio.conf).
//   Apps: every app that asked for a permission (or has a rule), and for
//     each permission Allow, Ask, Deny or the default, from and to MLXIPC
//     (ListPermissions, SetPermission: ipc.conf).
//   Language: the desktop's (German or English, or the system's locale);
//     the apps take it when they start (shared/clock.mlx), this one at
//     once.
//
// Every change is written to $XDG_CONFIG_HOME/mlx/compositor.conf
// (~/.config/mlx/compositor.conf), which the compositor reads again within
// half a second (projects/desktop/compositor/settings.mlx).
//
//   mlx-settings
const std = @import("std")
const apps_module = @import("../shared/apps.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const lists = @import("std.ui.lists")
const glyphs = @import("std.ui.glyphs")
const sidebar_module = @import("std.ui.sidebar")
const host_module = @import("std.ui.host")
const keys = @import("../shared/keys.mlx")
const clock = @import("../shared/clock.mlx")
const timezone = @import("std.timezone")
const crash = @import("std.crash")
const page_module = @import("./page.mlx")
const sound_module = @import("./sound.mlx")
const display_module = @import("./display.mlx")
const permissions_module = @import("./permissions.mlx")

const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Host = host_module.Host
const Page = page_module.Page

// The window (logical pixels).
const WIDTH: i32 = 780
const HEIGHT: i32 = 560
const MIN_WIDTH: i32 = 520
const MIN_HEIGHT: i32 = 380
const SIDEBAR: i32 = 200
const SIDEBAR_NARROW: i32 = 168
const PADDING: i32 = 28
const HEADER: i32 = 52
const SWITCH_ROW: i32 = page_module.SWITCH_ROW
const HOTKEY_ROW: i32 = 34
const SWATCHES: usize = 10
const SWATCH: i32 = 30
const SWATCH_GAP: i32 = 8
const BINDING_WIDTH: i32 = 150

const KEY_BACKSPACE: u32 = 14
const KEY_ESCAPE: u32 = 1
const KEY_UP: u32 = 103
const KEY_DOWN: u32 = 108
const BUTTON_RIGHT: u32 = 273
const NONE: usize = 1 << 40
// The Sound page asks MLX Audio again this often while it is shown (ms),
// the Apps page the bus.
const SOUND_TICK: usize = 500
const APPS_TICK: usize = 1000

const O_WRONLY_CREATE_TRUNCATE: usize = 577

// The categories.
const CATEGORIES: usize = 7
const GENERAL: usize = 0
const DISPLAY: usize = 1
const SOUND: usize = 2
const APPS: usize = 3
const WINDOWS: usize = 4
const APPEARANCE: usize = 5
const LANGUAGE: usize = 6

// The widgets' ids: border swatch 0..9, inactive swatch 10..19, switch
// 100 + row, hotkey 200 + action, category 300 + index, corner 400 +
// choice, language 500 + choice (std.ui ids start at 1); the Sound,
// Display and Apps pages use 1000 and above.
const ID_INACTIVE: usize = 10
const ID_SWITCH: usize = 100
const ID_HOTKEY: usize = 200
const ID_CATEGORY: usize = 300
const ID_CORNER: usize = 400
const ID_LANGUAGE: usize = 500

// The compositor's defaults (scene.FOCUS_COLOR, FRAME_COLOR,
// CORNER_RADIUS: libadwaita's windows).
const DEFAULT_BORDER: u32 = 5939455
const DEFAULT_INACTIVE: u32 = 5263456
const DEFAULT_RADIUS: u32 = 12

const Settings = struct {
    host: *Host
    // Set up (main): events before it are not the app's yet.
    ready: bool
    environment: [*][*]const u8
    // The settings file (NUL-terminated), and the same with ".new" for
    // writing it whole before it replaces the old one.
    path: [256]u8
    pathLength: usize
    // What the file says (colours as 0xRRGGBB).
    border: u32
    inactive: u32
    titleBars: bool
    fpsCounter: bool
    clientDecorations: bool
    // Pixels (0: square).
    cornerRadius: u32
    wobblyWindows: bool
    dockAutohide: bool
    // clock.LANGUAGE_*, and whether the labels are German now.
    language: u8
    german: bool
    // The hotkeys (keys.mlx: modifier mask and key code, 0: none), and the
    // one being recorded (NONE: none) with the modifiers held meanwhile.
    hotkeyModifiers: [keys.ACTIONS]u32
    hotkeyKeys: [keys.ACTIONS]u32
    recording: usize
    held: u32
    saved: bool
    // The category shown, how far its page is scrolled and how tall it was
    // when last drawn (pixels).
    category: usize
    scroll: i32
    pageHeight: i32
    // Pixels a logical pixel, and the one the fonts and theme have.
    scale: i32
    fontScale: i32
    title: Text
    body: Text
    small: Text
    // The widgets (std.ui): their pointer and look.
    ui: view.Ui
    theme: theme_module.Theme
    // The Sound page (MLX Audio's state) and the Display page (the
    // monitor, and its keys of the settings file).
    sound: sound_module.Sound
    display: display_module.Display
    // The Apps page (MLXIPC's permissions).
    permissions: permissions_module.Permissions
}

fn settingsOf(context: *anyopaque) -> *Settings {
    unsafe { return @ptrCast(*Settings, context) }
}

fn titleOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.title) }
}

fn bodyOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.body) }
}

fn smallOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.small) }
}

fn pathOf(settings: *Settings) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(settings) + @offsetOf(Settings, "path")) }
}

fn themeOf(settings: *Settings) -> *theme_module.Theme {
    unsafe { return @ptrCast(*theme_module.Theme, &settings.*.theme) }
}

fn uiOf(settings: *Settings) -> *view.Ui {
    unsafe { return @ptrCast(*view.Ui, &settings.*.ui) }
}

fn soundOf(settings: *Settings) -> *sound_module.Sound {
    unsafe { return @ptrCast(*sound_module.Sound, &settings.*.sound) }
}

fn displayOf(settings: *Settings) -> *display_module.Display {
    unsafe { return @ptrCast(*display_module.Display, &settings.*.display) }
}

fn permissionsOf(settings: *Settings) -> *permissions_module.Permissions {
    unsafe { return @ptrCast(*permissions_module.Permissions, &settings.*.permissions) }
}

// `value` logical pixels in pixels.
fn px(settings: *Settings, value: i32) -> i32 { return value * settings.*.scale }

fn say(settings: *Settings, english: []const u8, german: []const u8) -> []const u8 {
    return if settings.*.german { german } else { english }
}

fn redraw(settings: *Settings) -> void { host_module.redraw(settings.*.host) }

// The colours on offer (0xRRGGBB): the compositor's blue first.
fn preset(index: usize) -> u32 {
    return match index {
        0 => DEFAULT_BORDER, 1 => 9662683, 2 => 15548997, 3 => 15485081, 4 => 16225862,
        5 => 16436245, 6 => 2278750, 7 => 1357990, 8 => 7109249,
        else => 15132390
    }
}

// The others' colours on offer: the compositor's grey first, then quieter
// ones.
fn inactivePreset(index: usize) -> u32 {
    return match index {
        0 => DEFAULT_INACTIVE, 1 => 3355443, 2 => 6710886, 3 => 10066329, 4 => 4473924,
        5 => 3815994, 6 => 5592405, 7 => 2763306, 8 => 7368816,
        else => 13421772
    }
}

// The corners on offer: square, small, GTK's, large (pixels).
fn cornerChoice(index: usize) -> u32 { return match index { 0 => 0, 1 => 6, 2 => DEFAULT_RADIUS, else => 18 } }

// ---------------------------------------------------------------------------
// The settings file

fn append(settings: *Settings, text: []const u8) -> void {
    for byte in text {
        if settings.*.pathLength < 240 {
            settings.*.path[settings.*.pathLength] = byte
            settings.*.pathLength += 1
        }
    }
    settings.*.path[settings.*.pathLength] = 0
}

fn appendC(settings: *Settings, text: [*]const u8) -> void {
    var index: usize = 0
    while text[index] != 0 && settings.*.pathLength < 240 {
        settings.*.path[settings.*.pathLength] = text[index]
        settings.*.pathLength += 1
        index += 1
    }
    settings.*.path[settings.*.pathLength] = 0
}

// The directory part of the path so far exists (mkdir, errors ignored).
fn makeDirectory(settings: *Settings) -> void {
    const made = std.fs.makeDir(pathOf(settings), 493)
}

// Finds the file's path; makes ~/.config and ~/.config/mlx on the way.
fn locate(settings: *Settings, environment: [*][*]const u8) -> bool {
    settings.*.pathLength = 0
    const config = apps_module.environmentValue(environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] != 0 {
        appendC(settings, config)
    } else {
        const home = apps_module.environmentValue(environment, "HOME")
        if @intFromPtr(home) == 0 || home[0] == 0 { return false }
        appendC(settings, home)
        append(settings, "/.config")
    }
    makeDirectory(settings)
    append(settings, "/mlx")
    makeDirectory(settings)
    append(settings, "/compositor.conf")
    return true
}

fn hexDigit(byte: u8) -> u32 { return @intCast(u32, std.text.hexValue(byte)) }

fn parseColor(text: []const u8, fallback: u32) -> u32 {
    var start: usize = 0
    if text.length > 0 && text[0] == 35 { start = 1 }
    if text.length - start != 6 { return fallback }
    var value: u32 = 0
    var index = start
    while index < text.length {
        const digit = hexDigit(text[index])
        if digit == 16 { return fallback }
        value = value * 16 + digit
        index += 1
    }
    return value
}

// A whole number up to 20 (the compositor's limit), else `fallback`.
fn parseNumber(text: []const u8, fallback: u32) -> u32 {
    if text.length == 0 || text.length > 2 { return fallback }
    var value: u32 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return fallback }
        value = value * 10 + @intCast(u32, byte - 48)
    }
    return if value > 20 { fallback } else { value }
}

fn parseSwitch(text: []const u8, fallback: bool) -> bool {
    if std.text.same(text, "on") || std.text.same(text, "yes") || std.text.same(text, "true") || std.text.same(text, "1") { return true }
    if std.text.same(text, "off") || std.text.same(text, "no") || std.text.same(text, "false") || std.text.same(text, "0") { return false }
    return fallback
}

// What the file says now (the defaults for what it leaves out).
fn load(settings: *Settings, allocator: std.allocator.Allocator) -> void {
    settings.*.border = DEFAULT_BORDER
    settings.*.inactive = DEFAULT_INACTIVE
    settings.*.titleBars = true
    settings.*.fpsCounter = true
    settings.*.clientDecorations = false
    settings.*.cornerRadius = DEFAULT_RADIUS
    settings.*.wobblyWindows = true
    settings.*.dockAutohide = false
    settings.*.language = clock.LANGUAGE_SYSTEM
    display_module.defaults(displayOf(settings))
    var action: usize = 0
    while action < keys.ACTIONS {
        var modifiers: u32 = 0
        var key: u32 = 0
        keys.defaultBinding(action, &modifiers, &key)
        settings.*.hotkeyModifiers[action] = modifiers
        settings.*.hotkeyKeys[action] = key
        action += 1
    }
    const file = std.fs.open(pathOf(settings), 0, 0)
    if !std.fs.isValid(file) { return }
    const contents = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    const text = contents.items
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[at..end])
        var equals: usize = 0
        while equals < line.length && line[equals] != 61 { equals += 1 }
        if line.length > 0 && line[0] != 35 && equals < line.length {
            const key = std.text.trimmed(line[0..equals])
            const value = std.text.trimmed(line[equals + 1..line.length])
            if std.text.same(key, "border-color") { settings.*.border = parseColor(value, settings.*.border) }
            if std.text.same(key, "inactive-border-color") { settings.*.inactive = parseColor(value, settings.*.inactive) }
            if std.text.same(key, "title-bars") { settings.*.titleBars = parseSwitch(value, settings.*.titleBars) }
            if std.text.same(key, "fps-counter") { settings.*.fpsCounter = parseSwitch(value, settings.*.fpsCounter) }
            if std.text.same(key, "client-decorations") { settings.*.clientDecorations = parseSwitch(value, settings.*.clientDecorations) }
            if std.text.same(key, "corner-radius") { settings.*.cornerRadius = parseNumber(value, settings.*.cornerRadius) }
            if std.text.same(key, "wobbly-windows") { settings.*.wobblyWindows = parseSwitch(value, settings.*.wobblyWindows) }
            if std.text.same(key, "dock-autohide") { settings.*.dockAutohide = parseSwitch(value, settings.*.dockAutohide) }
            if std.text.same(key, "language") {
                if std.text.same(value, "de") { settings.*.language = clock.LANGUAGE_GERMAN }
                if std.text.same(value, "en") { settings.*.language = clock.LANGUAGE_ENGLISH }
                if std.text.same(value, "system") { settings.*.language = clock.LANGUAGE_SYSTEM }
            }
            parseHotkey(settings, key, value)
            const display_key = display_module.loadKey(displayOf(settings), key, value)
        }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
}

// A key-* line (keys.actionKey): "none" or a combination.
fn parseHotkey(settings: *Settings, name: []const u8, value: []const u8) -> void {
    var action: usize = 0
    while action < keys.ACTIONS {
        if std.text.same(name, keys.actionKey(action)) {
            var modifiers: u32 = 0
            var key: u32 = 0
            if std.text.same(value, "none") {
                settings.*.hotkeyModifiers[action] = 0
                settings.*.hotkeyKeys[action] = 0
            } else if keys.parse(value, &modifiers, &key) {
                settings.*.hotkeyModifiers[action] = modifiers
                settings.*.hotkeyKeys[action] = key
            }
            return
        }
        action += 1
    }
}

fn writeColor(line: [*]u8, at: usize, color: u32) -> usize {
    line[at] = 35
    var index: usize = 0
    while index < 6 {
        const nibble = (color >> @intCast(u5, (5 - index) * 4)) & 15
        line[at + 1 + index] = @intCast(u8, if nibble < 10 { 48 + nibble } else { 87 + nibble })
        index += 1
    }
    return at + 7
}

fn writeText(line: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        line[index] = byte
        index += 1
    }
    return index
}

// Writes the file whole (as NAME.new, renamed over it: the compositor never
// reads half a file).
fn save(settings: *Settings) -> void {
    var bytes: [1536]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length = writeText(text, 0, "# The Mlx compositor's settings (mlx-settings writes this file).\nborder-color = ")
    length = writeColor(text, length, settings.*.border)
    length = writeText(text, length, "\ninactive-border-color = ")
    length = writeColor(text, length, settings.*.inactive)
    length = writeText(text, length, if settings.*.titleBars { "\ntitle-bars = on\n" } else { "\ntitle-bars = off\n" })
    length = writeText(text, length, if settings.*.fpsCounter { "fps-counter = on\n" } else { "fps-counter = off\n" })
    length = writeText(text, length, if settings.*.clientDecorations { "client-decorations = on\n" } else { "client-decorations = off\n" })
    length = writeText(text, length, if settings.*.wobblyWindows { "wobbly-windows = on\n" } else { "wobbly-windows = off\n" })
    length = writeText(text, length, if settings.*.dockAutohide { "dock-autohide = on\n" } else { "dock-autohide = off\n" })
    length = writeText(text, length, "language = ")
    length = writeText(text, length, if settings.*.language == clock.LANGUAGE_GERMAN { "de\n" } else if settings.*.language == clock.LANGUAGE_ENGLISH { "en\n" } else { "system\n" })
    length = writeText(text, length, "corner-radius = ")
    if settings.*.cornerRadius >= 10 {
        text[length] = @intCast(u8, 48 + settings.*.cornerRadius / 10)
        length += 1
    }
    text[length] = @intCast(u8, 48 + settings.*.cornerRadius % 10)
    text[length + 1] = 10
    length += 2
    var action: usize = 0
    while action < keys.ACTIONS {
        length = writeText(text, length, keys.actionKey(action))
        length = writeText(text, length, " = ")
        if settings.*.hotkeyKeys[action] == 0 {
            length = writeText(text, length, "none")
        } else {
            var at: [*]u8 = undefined
            unsafe { at = @ptrFromInt([*]u8, @intFromPtr(text) + length) }
            length += keys.format(settings.*.hotkeyModifiers[action], settings.*.hotkeyKeys[action], at)
        }
        text[length] = 10
        length += 1
        action += 1
    }
    length = display_module.save(displayOf(settings), text, length)

    var temporary: [264]u8 = undefined
    var temporary_path: [*]u8 = undefined
    unsafe { temporary_path = @ptrCast([*]u8, &temporary) }
    var index: usize = 0
    while index < settings.*.pathLength {
        temporary_path[index] = settings.*.path[index]
        index += 1
    }
    index = writeText(temporary_path, index, ".new")
    temporary_path[index] = 0
    const file = std.fs.open(temporary_path, O_WRONLY_CREATE_TRUNCATE, 420)
    if !std.fs.isValid(file) {
        settings.*.saved = false
        return
    }
    const written = std.fs.writeAllBytes(file, text, length)
    const closed = std.fs.close(file)
    settings.*.saved = written && std.fs.rename(temporary_path, pathOf(settings))
}

// ---------------------------------------------------------------------------
// Input

// Recording a hotkey: every key comes here (the compositor's hotkeys
// too, while it lets this window have them).
fn startRecording(settings: *Settings, action: usize) -> void {
    settings.*.recording = action
    settings.*.held = 0
    host_module.inhibitShortcuts(settings.*.host, true)
}

fn stopRecording(settings: *Settings) -> void {
    settings.*.recording = NONE
    host_module.inhibitShortcuts(settings.*.host, false)
}

// A key while recording: modifiers are held, the first other key makes
// the combination (a letter or the like needs a modifier, so typing stays
// possible; function keys, Print and the like do not).
fn recordKey(settings: *Settings, key: u32, pressed: bool) -> void {
    const modifier = keys.modifierOf(key)
    if modifier != 0 {
        settings.*.held = if pressed { settings.*.held | modifier } else { settings.*.held & ~modifier }
        return
    }
    if !pressed { return }
    const action = settings.*.recording
    if key == KEY_ESCAPE && settings.*.held == 0 {
        stopRecording(settings)
        return
    }
    if key == KEY_BACKSPACE && settings.*.held == 0 {
        settings.*.hotkeyModifiers[action] = 0
        settings.*.hotkeyKeys[action] = 0
        stopRecording(settings)
        save(settings)
        return
    }
    if keys.keyName(key).length == 0 { return }
    const plain = (key >= 59 && key <= 68) || key == 87 || key == 88 || key == 99
    if settings.*.held == 0 && !plain { return }
    settings.*.hotkeyModifiers[action] = settings.*.held
    settings.*.hotkeyKeys[action] = key
    stopRecording(settings)
    save(settings)
}

fn idOf(item: usize) -> u64 { return @intCast(u64, item) + 1 }

fn itemOf(widget: u64) -> usize { return if widget == view.NONE { NONE } else { @intCast(usize, widget - 1) } }

// The widgets laid out (and a click taken) without drawing.
fn layOut(context: *anyopaque) -> void {
    var nowhere = view.layoutCanvas()
    draw(context, &nowhere)
}

fn choose(settings: *Settings, category: usize) -> void {
    if settings.*.recording != NONE { stopRecording(settings) }
    settings.*.category = category
    settings.*.scroll = 0
    // What the server and the compositor say now; the server again and
    // again while its page is shown.
    const allocator = std.page_allocator.init()
    if category == SOUND { const read = sound_module.refresh(soundOf(settings), allocator) }
    if category == DISPLAY { const known = display_module.refresh(displayOf(settings), allocator) }
    if category == APPS { const listed = permissions_module.refresh(permissionsOf(settings), allocator) }
    host_module.setTick(settings.*.host, if category == SOUND { SOUND_TICK } else if category == APPS { APPS_TICK } else { 0 })
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const settings = settingsOf(context)
    if !settings.*.ready { return }
    if kind == ui_app.EVENT_CONFIGURED {
        fitScale(settings)
        updateBlur(settings)
        redraw(settings)
        return
    }
    if kind == ui_app.EVENT_TICK {
        // Not while a slider is dragged; not to start a server that went
        // ("Try again" does).
        if settings.*.category == SOUND && settings.*.ui.pressed == view.NONE && settings.*.sound.connected {
            const read = sound_module.refresh(soundOf(settings), std.page_allocator.init())
            redraw(settings)
        }
        if settings.*.category == APPS && settings.*.ui.pressed == view.NONE {
            const listed = permissions_module.refresh(permissionsOf(settings), std.page_allocator.init())
            redraw(settings)
        }
        return
    }
    const widgets = uiOf(settings)
    // The pointer to the widgets, laid out before a press (it may come
    // before the first frame); a click is taken at once, not at the next
    // frame: keys typed right after it go to what it started.
    if ui_app.pressing(kind, a, b) { layOut(context) }
    const fed = ui_app.feed(widgets, kind, a, b)
    if fed == ui_app.FEED_CLICK { layOut(context) }
    if kind == ui_app.EVENT_MOTION || kind == ui_app.EVENT_LEAVE {
        if fed == ui_app.FEED_NONE { return }
    } else if kind == ui_app.EVENT_WHEEL {
        if a != 0 { return }
        // Over a slider the wheel turns it (std.ui.controls.slider).
        const over = itemOf(widgets.*.hover)
        if sound_module.isSlider(over) || display_module.isSlider(over) {
            redraw(settings)
            return
        }
        var pixels = host_module.wheelPixels(settings.*.host)
        if pixels == 0 { pixels = b * px(settings, 40) }
        settings.*.scroll += pixels
    } else if kind == ui_app.EVENT_BUTTON {
        const item = itemOf(view.hitAt(widgets, widgets.*.pointerX, widgets.*.pointerY))
        if a == BUTTON_RIGHT && b == 1 && item >= ID_HOTKEY && item < ID_HOTKEY + keys.ACTIONS {
            // The default again.
            if settings.*.recording != NONE { stopRecording(settings) }
            const action = item - ID_HOTKEY
            var modifiers: u32 = 0
            var key: u32 = 0
            keys.defaultBinding(action, &modifiers, &key)
            settings.*.hotkeyModifiers[action] = modifiers
            settings.*.hotkeyKeys[action] = key
            save(settings)
        }
    } else if kind == ui_app.EVENT_KEY {
        if settings.*.recording != NONE {
            if b != 2 { recordKey(settings, a, b == 1) }
        } else if b != 0 && a == KEY_ESCAPE {
            host_module.quit(settings.*.host)
        } else if b != 0 && a == KEY_UP && settings.*.category > 0 {
            choose(settings, settings.*.category - 1)
        } else if b != 0 && a == KEY_DOWN && settings.*.category + 1 < CATEGORIES {
            choose(settings, settings.*.category + 1)
        }
    }
    redraw(settings)
}

// ---------------------------------------------------------------------------
// Drawing

fn opaque(rgb: u32) -> u32 { return 4278190080 | rgb }

fn categoryName(settings: *Settings, category: usize) -> []const u8 {
    return match category {
        0 => say(settings, "General", "Allgemein"),
        1 => say(settings, "Display", "Anzeige"),
        2 => say(settings, "Sound", "Ton"),
        3 => say(settings, "Apps", "Apps"),
        4 => say(settings, "Window management", "Fensterverwaltung"),
        5 => say(settings, "Appearance", "Erscheinungsbild"),
        else => say(settings, "Language", "Sprache")
    }
}

fn actionLabel(settings: *Settings, action: usize) -> []const u8 {
    if !settings.*.german { return keys.actionLabel(action) }
    return match action {
        0 => "Maximieren oder wiederherstellen", 1 => "Minimieren", 2 => "Vollbild", 3 => "Fenster schließen", 4 => "Terminal öffnen",
        5 => "Nächstes Fenster", 6 => "Links andocken, oder die Spalte links", 7 => "Rechts andocken, oder die Spalte rechts",
        8 => "Spalte nach links", 9 => "Spalte nach rechts", 10 => "Spaltenbreite wechseln",
        else => "Tiling an oder aus (dieser Workspace)"
    }
}

// A hotkey row: what it does, and its keys in a box on the right (the box
// lit while it records); true when it was clicked.
fn hotkeyRow(settings: *Settings, page: *const Page, y: i32, action: usize) -> bool {
    const recording = settings.*.recording == action
    var bytes: [48]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    if recording {
        length = writeText(text, 0, say(settings, "Press keys", "Tasten drücken"))
    } else if settings.*.hotkeyKeys[action] == 0 {
        length = writeText(text, 0, say(settings, "None", "Keine"))
    } else {
        length = keys.format(settings.*.hotkeyModifiers[action], settings.*.hotkeyKeys[action], text)
    }
    const box = if page.*.width > px(settings, 380) { px(settings, BINDING_WIDTH) } else { page.*.width / 3 }
    return controls.valueRow(uiOf(settings), idOf(ID_HOTKEY + action), ui.rect(page.*.left - px(settings, 8), y, page.*.width + px(settings, 16), px(settings, HOTKEY_ROW - 4)), actionLabel(settings, action), text[0..length], box, recording)
}

fn hotkeyRows(settings: *Settings, page: *const Page, y: i32, first: usize, last: usize) -> i32 {
    var at = y
    var action = first
    while action <= last {
        if hotkeyRow(settings, page, at, action) {
            if settings.*.recording != NONE { stopRecording(settings) }
            startRecording(settings, action)
        }
        at += px(settings, HOTKEY_ROW)
        action += 1
    }
    return at
}

// What a click changed: saved at once.
fn changed(settings: *Settings) -> void {
    if settings.*.recording != NONE { stopRecording(settings) }
    save(settings)
}

fn drawGeneral(settings: *Settings, page: *const Page, top: i32) -> i32 {
    var y = page_module.section(page, top, say(settings, "Dock", "Dock"))
    if page_module.switchRow(page, y, ID_SWITCH + 0, say(settings, "Auto-hide dock", "Dock automatisch ausblenden"), say(settings, "The dock hides; the screen's bottom edge brings it", "Der untere Bildschirmrand holt es zurück"), settings.*.dockAutohide) {
        settings.*.dockAutohide = !settings.*.dockAutohide
        changed(settings)
    }
    y += px(settings, SWITCH_ROW)
    y = page_module.section(page, y, say(settings, "Hotkeys", "Tastenkürzel"))
    y = hotkeyRows(settings, page, y, keys.ACTION_TERMINAL, keys.ACTION_TERMINAL)
    y = page_module.section(page, y, say(settings, "Settings file", "Einstellungsdatei"))
    // Under the home folder as ~/...
    var shown = pathOf(settings)[0..settings.*.pathLength]
    var tilde: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &tilde) }
    const home = apps_module.environmentValue(settings.*.environment, "HOME")
    if @intFromPtr(home) != 0 {
        var length: usize = 0
        while home[length] != 0 { length += 1 }
        if length > 1 && length < shown.length && shown[length] == 47 && std.text.same(shown[0..length], home[0..length]) {
            bytes[0] = 126
            var index = length
            while index < shown.length {
                bytes[1 + index - length] = shown[index]
                index += 1
            }
            shown = bytes[0..1 + shown.length - length]
        }
    }
    y = page_module.note(page, y, shown)
    return page_module.note(page, y, say(settings, "The compositor reads it again within half a second.", "Der Compositor liest sie binnen einer halben Sekunde neu."))
}

fn drawWindows(settings: *Settings, page: *const Page, top: i32) -> i32 {
    var y = page_module.section(page, top, say(settings, "Windows", "Fenster"))
    if page_module.switchRow(page, y, ID_SWITCH + 1, say(settings, "Title bars", "Titelleisten"), say(settings, "A bar with the title above each window", "Eine Leiste mit dem Titel über jedem Fenster"), settings.*.titleBars) {
        settings.*.titleBars = !settings.*.titleBars
        changed(settings)
    }
    y += px(settings, SWITCH_ROW)
    if page_module.switchRow(page, y, ID_SWITCH + 2, say(settings, "FPS counter", "FPS-Anzeige"), say(settings, "Frames per second in the title bars", "Bilder pro Sekunde in den Titelleisten"), settings.*.fpsCounter) {
        settings.*.fpsCounter = !settings.*.fpsCounter
        changed(settings)
    }
    y += px(settings, SWITCH_ROW)
    if page_module.switchRow(page, y, ID_SWITCH + 3, say(settings, "App decorations", "App-Dekorationen"), say(settings, "Programs draw their own title bars and frames", "Programme zeichnen eigene Titelleisten und Rahmen"), settings.*.clientDecorations) {
        settings.*.clientDecorations = !settings.*.clientDecorations
        changed(settings)
    }
    y += px(settings, SWITCH_ROW)
    if page_module.switchRow(page, y, ID_SWITCH + 4, say(settings, "Wobbly windows", "Wabbelnde Fenster"), say(settings, "Windows wobble as you move them", "Fenster wabbeln beim Verschieben"), settings.*.wobblyWindows) {
        settings.*.wobblyWindows = !settings.*.wobblyWindows
        changed(settings)
    }
    y += px(settings, SWITCH_ROW)
    y = page_module.section(page, y, say(settings, "Hotkeys", "Tastenkürzel"))
    y = hotkeyRows(settings, page, y, keys.ACTION_MAXIMIZE, keys.ACTION_CLOSE)
    y = hotkeyRows(settings, page, y, keys.ACTION_SWITCH, keys.ACTION_SWITCH)
    y = hotkeyRows(settings, page, y, keys.ACTION_LEFT, keys.ACTION_TILING)
    const hint = if settings.*.recording != NONE { say(settings, "Esc keeps the old keys, Backspace clears them", "Esc behält die alten Tasten, Rücktaste löscht sie") } else { say(settings, "Click to record, right-click for the default", "Klicken zum Aufnehmen, Rechtsklick für den Standard") }
    return page_module.note(page, y, hint)
}

// A row of colour swatches (wrapping to the page); the y after it.
fn swatches(settings: *Settings, page: *const Page, y: i32, first_id: usize, current: u32, inactive: bool) -> i32 {
    const size = px(settings, SWATCH)
    const step = size + px(settings, SWATCH_GAP)
    var per_row = page.*.width / step
    if per_row < 1 { per_row = 1 }
    var index: usize = 0
    var at = y
    while index < SWATCHES {
        const column = @intCast(i32, index) % per_row
        if column == 0 && index > 0 { at += step }
        const color = if inactive { inactivePreset(index) } else { preset(index) }
        if controls.swatch(uiOf(settings), idOf(first_id + index), page.*.left + column * step, at, size, opaque(color), color == current) {
            if inactive { settings.*.inactive = color } else { settings.*.border = color }
            changed(settings)
        }
        index += 1
    }
    return at + step + px(settings, 4)
}

fn drawAppearance(settings: *Settings, page: *const Page, top: i32) -> i32 {
    var y = page_module.section(page, top, say(settings, "Border of the focused window", "Rahmen des aktiven Fensters"))
    y = swatches(settings, page, y, 0, settings.*.border, false)
    y = page_module.section(page, y, say(settings, "Border of the other windows", "Rahmen der anderen Fenster"))
    y = swatches(settings, page, y, ID_INACTIVE, settings.*.inactive, true)
    y = page_module.section(page, y, say(settings, "Window corners", "Fensterecken"))
    const height = px(settings, 34)
    const width = if page.*.width < px(settings, 440) { page.*.width } else { px(settings, 440) }
    controls.segmentsFrame(uiOf(settings), ui.rect(page.*.left, y, width, height))
    const part = (width - px(settings, 4)) / 4
    var choice: usize = 0
    while choice < 4 {
        const label = match choice { 0 => say(settings, "Square", "Eckig"), 1 => say(settings, "Small", "Klein"), 2 => say(settings, "Medium", "Mittel"), else => say(settings, "Large", "Groß") }
        if controls.segment(uiOf(settings), idOf(ID_CORNER + choice), ui.rect(page.*.left + px(settings, 2) + @intCast(i32, choice) * part, y + px(settings, 2), part, height - px(settings, 4)), label, settings.*.cornerRadius == cornerChoice(choice), 0) {
            settings.*.cornerRadius = cornerChoice(choice)
            changed(settings)
        }
        choice += 1
    }
    y += height + px(settings, 8)
    return page_module.note(page, y, say(settings, "Medium is GTK's 12 pixels.", "Mittel entspricht GTKs 12 Pixeln."))
}

fn drawLanguage(settings: *Settings, page: *const Page, top: i32) -> i32 {
    var y = page_module.section(page, top, say(settings, "Desktop language", "Sprache des Desktops"))
    var choice: usize = 0
    while choice < 3 {
        const value = match choice { 0 => clock.LANGUAGE_SYSTEM, 1 => clock.LANGUAGE_GERMAN, else => clock.LANGUAGE_ENGLISH }
        const label = match choice { 0 => say(settings, "As the system (LANG)", "Wie das System (LANG)"), 1 => "Deutsch", else => "English" }
        if controls.radioRow(uiOf(settings), idOf(ID_LANGUAGE + choice), ui.rect(page.*.left - px(settings, 8), y, page.*.width + px(settings, 16), px(settings, 34)), label, settings.*.language == value) {
            settings.*.language = value
            settings.*.german = if value == clock.LANGUAGE_SYSTEM { clock.systemGerman(settings.*.environment) } else { value == clock.LANGUAGE_GERMAN }
            host_module.setTitle(settings.*.host, say(settings, "Settings", "Einstellungen"))
            changed(settings)
        }
        y += px(settings, 38)
        choice += 1
    }
    // How a date reads in it (the top bar's clock).
    y = page_module.section(page, y, say(settings, "Example", "Beispiel"))
    var bytes: [48]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    const now = timezone.now()
    const time = timezone.civil(now)
    const length = clock.format(&time, settings.*.german, text)
    controls.label(uiOf(settings), bodyOf(settings), text[0..length], page.*.left, y, themeOf(settings).*.text, page.*.width)
    y += px(settings, 30)
    return page_module.note(page, y, say(settings, "Apps take it when they start.", "Apps übernehmen sie beim nächsten Start."))
}

// The sidebar's width (narrower in a narrow window).
fn sidebarWidth(settings: *Settings) -> i32 {
    return px(settings, if host_module.width(settings.*.host) < px(settings, 640) { SIDEBAR_NARROW } else { SIDEBAR })
}

// The blur behind the translucent sidebar (std.ui.sidebar).
fn updateBlur(settings: *Settings) -> void {
    var rects: [4]i32 = [4]i32{ 0, 0, sidebarWidth(settings), host_module.height(settings.*.host) }
    unsafe { host_module.setBlur(settings.*.host, @ptrCast([*]const i32, &rects), 1) }
}

// A category's glyph in an 18 logical pixels square at (x, y).
fn drawCategoryGlyph(canvas: *Canvas, category: usize, x: i32, y: i32, s: i32) -> void {
    const color = canvas_module.color(255, 90, 160, 255)
    if category == GENERAL {
        canvas_module.strokeRoundedRect(canvas, x + 2 * s, y + 2 * s, 14 * s, 14 * s, 7 * s, 2 * s, color)
        glyphs.dot(canvas, x + 7 * s, y + 7 * s, 4 * s, color)
    } else if category == DISPLAY {
        // A monitor on its stand.
        canvas_module.strokeRoundedRect(canvas, x + s, y + 2 * s, 16 * s, 11 * s, 2 * s, 2 * s, color)
        canvas_module.fillRect(canvas, x + 8 * s, y + 13 * s, 2 * s, 2 * s, color)
        canvas_module.fillRect(canvas, x + 5 * s, y + 15 * s, 8 * s, 2 * s, color)
    } else if category == SOUND {
        // A speaker and its sound.
        canvas_module.fillRect(canvas, x + s, y + 7 * s, 4 * s, 5 * s, color)
        canvas_module.fillRect(canvas, x + 5 * s, y + 5 * s, 2 * s, 9 * s, color)
        canvas_module.fillRect(canvas, x + 7 * s, y + 3 * s, 2 * s, 13 * s, color)
        canvas_module.fillRoundedRect(canvas, x + 11 * s, y + 7 * s, 2 * s, 5 * s, s, color)
        canvas_module.fillRoundedRect(canvas, x + 15 * s, y + 4 * s, 2 * s, 11 * s, s, color)
    } else if category == APPS {
        // Four apps in a grid.
        canvas_module.fillRoundedRect(canvas, x + s, y + s, 7 * s, 7 * s, 2 * s, color)
        canvas_module.fillRoundedRect(canvas, x + 10 * s, y + s, 7 * s, 7 * s, 2 * s, color)
        canvas_module.fillRoundedRect(canvas, x + s, y + 10 * s, 7 * s, 7 * s, 2 * s, color)
        canvas_module.strokeRoundedRect(canvas, x + 10 * s, y + 10 * s, 7 * s, 7 * s, 2 * s, 2 * s, color)
    } else if category == WINDOWS {
        canvas_module.strokeRoundedRect(canvas, x + s, y + 3 * s, 16 * s, 12 * s, 3 * s, 2 * s, color)
        canvas_module.fillRect(canvas, x + s, y + 5 * s, 16 * s, 3 * s, color)
    } else if category == APPEARANCE {
        glyphs.dot(canvas, x + s, y + 2 * s, 7 * s, canvas_module.color(255, 240, 110, 100))
        glyphs.dot(canvas, x + 10 * s, y + 2 * s, 7 * s, canvas_module.color(255, 120, 210, 130))
        glyphs.dot(canvas, x + 5 * s, y + 10 * s, 7 * s, color)
    } else {
        canvas_module.strokeRoundedRect(canvas, x + s, y + s, 16 * s, 16 * s, 8 * s, 2 * s, color)
        canvas_module.strokeRoundedRect(canvas, x + 5 * s, y + s, 8 * s, 16 * s, 4 * s, s, color)
        canvas_module.fillRect(canvas, x + 2 * s, y + 8 * s, 14 * s, s, color)
    }
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const settings = settingsOf(context)
    if !settings.*.ready { return }
    const widgets = uiOf(settings)
    const theme = themeOf(settings)
    view.begin(widgets, canvas)
    const width = host_module.width(settings.*.host)
    const height = host_module.height(settings.*.host)
    const s = settings.*.scale
    // Transparent under the sidebar's tint: the compositor blurs what is
    // behind it (as in mlx-files and MLX Observatory).
    canvas_module.clear(canvas, 0)

    // The categories (std.ui.sidebar).
    const sidebar = sidebarWidth(settings)
    const sidebar_area = ui.rect(0, 0, sidebar, height)
    sidebar_module.background(widgets, sidebar_area)
    sidebar_module.heading(widgets, say(settings, "Settings", "Einstellungen"), 0, px(settings, 22), sidebar)
    var index: usize = 0
    while index < CATEGORIES {
        const row = sidebar_module.rowArea(widgets, sidebar_area, px(settings, 44) + @intCast(i32, index) * px(settings, sidebar_module.ROW))
        if sidebar_module.item(widgets, idOf(ID_CATEGORY + index), row, categoryName(settings, index), settings.*.category == index, true) { choose(settings, index) }
        drawCategoryGlyph(canvas, index, sidebar_module.glyphX(widgets, row), row.y + (row.height - 18 * s) / 2, s)
        index += 1
    }
    const footer = if settings.*.saved { say(settings, "Saved", "Gespeichert") } else { say(settings, "Changes apply at once", "Änderungen gelten sofort") }
    sidebar_module.heading(widgets, footer, 0, height - px(settings, 30), sidebar)

    // The page's background.
    const header = px(settings, HEADER)
    const background = canvas_module.color(255, 30, 32, 40)
    canvas_module.fillRect(canvas, sidebar, 0, width - sidebar, height, background)

    // The category's page: its rows, scrolled, then its header over them.
    var page = Page.{ .left = sidebar + px(settings, PADDING), .width = width - sidebar - px(settings, PADDING * 2), .ui = widgets, .body = bodyOf(settings), .small = smallOf(settings), .theme = theme, .scale = s, .german = settings.*.german }
    const top = header + px(settings, 16)
    const visible = height - top
    const most = settings.*.pageHeight - visible
    if settings.*.scroll > most { settings.*.scroll = most }
    if settings.*.scroll < 0 { settings.*.scroll = 0 }
    view.pushClip(widgets, ui.rect(sidebar, top, width - sidebar, visible))
    const start = top - settings.*.scroll
    var end = start
    if settings.*.category == GENERAL { end = drawGeneral(settings, &page, start) }
    if settings.*.category == DISPLAY {
        end = display_module.draw(displayOf(settings), &page, start)
        if settings.*.display.changed {
            settings.*.display.changed = false
            changed(settings)
        }
    }
    if settings.*.category == SOUND { end = sound_module.draw(soundOf(settings), &page, start, std.page_allocator.init()) }
    if settings.*.category == APPS { end = permissions_module.draw(permissionsOf(settings), &page, start, std.page_allocator.init()) }
    if settings.*.category == WINDOWS { end = drawWindows(settings, &page, start) }
    if settings.*.category == APPEARANCE { end = drawAppearance(settings, &page, start) }
    if settings.*.category == LANGUAGE { end = drawLanguage(settings, &page, start) }
    view.popClip(widgets)
    settings.*.pageHeight = end - start + px(settings, 16)
    // The header (mlx-files' toolbar) with the category's name, and the
    // gap under it: rows scrolled up go under them.
    canvas_module.fillRect(canvas, sidebar, header, width - sidebar, top - header, background)
    canvas_module.fillRect(canvas, sidebar, 0, width - sidebar, header, canvas_module.color(255, 36, 38, 47))
    canvas_module.fillRect(canvas, sidebar, header - s, width - sidebar, s, canvas_module.color(255, 20, 21, 27))
    controls.label(widgets, titleOf(settings), categoryName(settings, settings.*.category), page.left, controls.textTop(titleOf(settings), 0, header), theme.*.text, page.width)
    // A click changed what was drawn before it: once more.
    if view.end(widgets) { redraw(settings) }
}

// Fonts and theme for the screen's density (again when it changes).
fn fitScale(settings: *Settings) -> void {
    const scale = host_module.scale(settings.*.host)
    settings.*.scale = scale
    if scale == settings.*.fontScale { return }
    if settings.*.fontScale != 0 {
        text_module.unloadText(titleOf(settings))
        text_module.unloadText(bodyOf(settings))
        text_module.unloadText(smallOf(settings))
    }
    settings.*.fontScale = scale
    const factor = @intCast(u32, scale)
    const allocator = std.page_allocator.init()
    const loaded_title = text_module.loadText(titleOf(settings), 16 * factor, allocator)
    const loaded_body = text_module.loadText(bodyOf(settings), 13 * factor, allocator)
    const loaded_small = text_module.loadText(smallOf(settings), 12 * factor, allocator)
    settings.*.theme = theme_module.scaled(theme_module.dark(), scale)
    view.init(uiOf(settings), themeOf(settings), bodyOf(settings), smallOf(settings), bodyOf(settings))
}

const Failure = error { NoMemory, NoHome }

fn noMemory() -> Failure!void { return Failure.NoMemory }
fn noHome() -> Failure!void { return Failure.NoHome }

fn options() -> host_module.Options {
    return host_module.Options.{ .title = "Settings", .appId = "org.mlx.settings", .width = @intCast(u32, WIDTH), .height = @intCast(u32, HEIGHT), .minWidth = MIN_WIDTH, .minHeight = MIN_HEIGHT }
}

pub fn main(arguments: [][*]const u8) -> !void {
    crash.install()
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Settings), 16)
    if memory == null { return noMemory() }
    var settings: *Settings = undefined
    unsafe { settings = @ptrCast(*Settings, memory.?) }
    settings.*.ready = false
    settings.*.saved = false
    settings.*.recording = NONE
    settings.*.held = 0
    settings.*.category = GENERAL
    settings.*.scroll = 0
    settings.*.pageHeight = 0
    settings.*.scale = 1
    settings.*.fontScale = 0
    const host = host_module.create(options(), @ptrCast(*anyopaque, settings), draw, onEvent)
    if host == null { return noMemory() }
    settings.*.host = host.?
    try host_module.open(settings.*.host, arguments)
    settings.*.environment = host_module.environment(settings.*.host)
    if !locate(settings, settings.*.environment) { return noHome() }
    display_module.init(displayOf(settings), settings.*.environment)
    permissions_module.init(permissionsOf(settings), settings.*.environment)
    load(settings, allocator)
    // ipc.conf is next to compositor.conf.
    sound_module.init(soundOf(settings), settings.*.environment, pathOf(settings)[0..settings.*.pathLength - 16])
    settings.*.german = if settings.*.language == clock.LANGUAGE_SYSTEM { clock.systemGerman(settings.*.environment) } else { settings.*.language == clock.LANGUAGE_GERMAN }
    fitScale(settings)
    host_module.setTitle(settings.*.host, say(settings, "Settings", "Einstellungen"))
    settings.*.ready = true
    updateBlur(settings)
    redraw(settings)
    host_module.report(settings.*.host, "mlx-settings")
    try host_module.run(settings.*.host)
}
