// The settings app of the Mlx desktop: a window (a Wayland client) that
// changes the compositor's look while it runs. It shows the border colour
// of the focused window as a row of colours to pick from, and switches for
// the title bars, their frames-per-second counter, rounded window corners
// (GTK's 12 pixels, or square), wobbly windows, the dock hiding and
// whether programs draw
// their own title
// bars (client decorations, off by default: the compositor tells them it
// decorates windows), then the compositor's hotkeys: a click on one
// records the next key combination (the compositor passes every key to
// the window meanwhile: keyboard-shortcuts-inhibit), Escape keeps the old
// one, Backspace unbinds it and a right click restores the default.
// Every change is
// written to $XDG_CONFIG_HOME/mlx/compositor.conf (~/.config/mlx/
// compositor.conf), which the compositor reads again within half a second
// (projects/desktop/compositor/settings.mlx).
//
//   mlx-settings
const std = @import("std")
const apps_module = @import("../shared/apps.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const panel_module = @import("../shared/panel.mlx")
const keys = @import("../shared/keys.mlx")
const crash = @import("std.crash")

const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Panel = panel_module.Panel

const WIDTH: i32 = 440
const HEIGHT: i32 = 666
const PADDING: i32 = 24
const SWATCHES: i32 = 10
const SWATCH: i32 = 30
const SWATCH_GAP: i32 = 8
const SWATCH_TOP: i32 = 100
const ROW_TOP: i32 = 160
const ROW_HEIGHT: i32 = 42
// The hotkeys: a heading, then one row per action.
const SWITCH_ROWS: usize = 6
const HOTKEY_TITLE: i32 = 422
const HOTKEY_TOP: i32 = 448
const HOTKEY_HEIGHT: i32 = 30
const BINDING_WIDTH: i32 = 150
const BUTTON_RIGHT: u32 = 273
const KEY_BACKSPACE: u32 = 14
const NONE: usize = 1 << 40
const BUTTON_LEFT: u32 = 272
const KEY_ESCAPE: u32 = 1

const O_WRONLY_CREATE_TRUNCATE: usize = 577

// The compositor's defaults (scene.FOCUS_COLOR, FRAME_COLOR,
// CORNER_RADIUS: libadwaita's windows).
const DEFAULT_BORDER: u32 = 5939455
const DEFAULT_INACTIVE: u32 = 5263456
const DEFAULT_RADIUS: u32 = 12

const Settings = struct {
    panel: Panel
    // The settings file (NUL-terminated), and the same with ".new" for
    // writing it whole before it replaces the old one.
    path: [256]u8
    pathLength: usize
    // What the file says (colours as 0xRRGGBB).
    border: u32
    inactive: u32
    titleBars: bool
    fpsCounter: bool
    clientDecorations: bool
    // Pixels; the switch turns 0 into DEFAULT_RADIUS and anything else
    // into 0.
    cornerRadius: u32
    wobblyWindows: bool
    dockAutohide: bool
    // The hotkeys (keys.mlx: modifier mask and key code, 0: none), and the
    // one being recorded (NONE: none) with the modifiers held meanwhile.
    hotkeyModifiers: [6]u32
    hotkeyKeys: [6]u32
    recording: usize
    held: u32
    saved: bool
    title: Text
    body: Text
    small: Text
    // The widgets (std.ui): their pointer and look.
    ui: view.Ui
    theme: theme_module.Theme
}

fn settingsOf(context: *anyopaque) -> *Settings {
    unsafe { return @ptrCast(*Settings, context) }
}

fn panelOf(settings: *Settings) -> *Panel {
    unsafe { return @ptrCast(*Panel, &settings.*.panel) }
}

fn titleOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.title) }
}

fn bodyOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.body) }
}

fn smallOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.small) }
}

fn pathOf(settings: *Settings) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(settings) + @offsetOf(Settings, "path")) }
}

// The colours on offer (0xRRGGBB): the compositor's blue first.
fn preset(index: usize) -> u32 {
    return match index {
        0 => DEFAULT_BORDER, 1 => 9662683, 2 => 15548997, 3 => 15485081, 4 => 16225862,
        5 => 16436245, 6 => 2278750, 7 => 1357990, 8 => 7109249,
        else => 15132390
    }
}

// ---------------------------------------------------------------------------
// The settings file

fn append(settings: *Settings, text: []const u8) -> void {
    for byte in text {
        if settings.*.pathLength < 240 {
            settings.*.path[settings.*.pathLength] = byte
            settings.*.pathLength += 1
        }
    }
    settings.*.path[settings.*.pathLength] = 0
}

fn appendC(settings: *Settings, text: [*]const u8) -> void {
    var index: usize = 0
    while text[index] != 0 && settings.*.pathLength < 240 {
        settings.*.path[settings.*.pathLength] = text[index]
        settings.*.pathLength += 1
        index += 1
    }
    settings.*.path[settings.*.pathLength] = 0
}

// The directory part of the path so far exists (mkdir, errors ignored).
fn makeDirectory(settings: *Settings) -> void {
    const made = std.fs.makeDir(pathOf(settings), 493)
}

// Finds the file's path; makes ~/.config and ~/.config/mlx on the way.
fn locate(settings: *Settings, environment: [*][*]const u8) -> bool {
    settings.*.pathLength = 0
    const config = apps_module.environmentValue(environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] != 0 {
        appendC(settings, config)
    } else {
        const home = apps_module.environmentValue(environment, "HOME")
        if @intFromPtr(home) == 0 || home[0] == 0 { return false }
        appendC(settings, home)
        append(settings, "/.config")
    }
    makeDirectory(settings)
    append(settings, "/mlx")
    makeDirectory(settings)
    append(settings, "/compositor.conf")
    return true
}

fn hexDigit(byte: u8) -> u32 { return @intCast(u32, std.text.hexValue(byte)) }

fn parseColor(text: []const u8, fallback: u32) -> u32 {
    var start: usize = 0
    if text.length > 0 && text[0] == 35 { start = 1 }
    if text.length - start != 6 { return fallback }
    var value: u32 = 0
    var index = start
    while index < text.length {
        const digit = hexDigit(text[index])
        if digit == 16 { return fallback }
        value = value * 16 + digit
        index += 1
    }
    return value
}

// A whole number up to 20 (the compositor's limit), else `fallback`.
fn parseNumber(text: []const u8, fallback: u32) -> u32 {
    if text.length == 0 || text.length > 2 { return fallback }
    var value: u32 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return fallback }
        value = value * 10 + @intCast(u32, byte - 48)
    }
    return if value > 20 { fallback } else { value }
}

fn parseSwitch(text: []const u8, fallback: bool) -> bool {
    if std.text.same(text, "on") || std.text.same(text, "yes") || std.text.same(text, "true") || std.text.same(text, "1") { return true }
    if std.text.same(text, "off") || std.text.same(text, "no") || std.text.same(text, "false") || std.text.same(text, "0") { return false }
    return fallback
}

// What the file says now (the defaults for what it leaves out).
fn load(settings: *Settings, allocator: std.allocator.Allocator) -> void {
    settings.*.border = DEFAULT_BORDER
    settings.*.inactive = DEFAULT_INACTIVE
    settings.*.titleBars = true
    settings.*.fpsCounter = true
    settings.*.clientDecorations = false
    settings.*.cornerRadius = DEFAULT_RADIUS
    settings.*.wobblyWindows = true
    settings.*.dockAutohide = false
    var action: usize = 0
    while action < keys.ACTIONS {
        var modifiers: u32 = 0
        var key: u32 = 0
        keys.defaultBinding(action, &modifiers, &key)
        settings.*.hotkeyModifiers[action] = modifiers
        settings.*.hotkeyKeys[action] = key
        action += 1
    }
    const file = std.fs.open(pathOf(settings), 0, 0)
    if !std.fs.isValid(file) { return }
    const contents = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    const text = contents.items
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[at..end])
        var equals: usize = 0
        while equals < line.length && line[equals] != 61 { equals += 1 }
        if line.length > 0 && line[0] != 35 && equals < line.length {
            const key = std.text.trimmed(line[0..equals])
            const value = std.text.trimmed(line[equals + 1..line.length])
            if std.text.same(key, "border-color") { settings.*.border = parseColor(value, settings.*.border) }
            if std.text.same(key, "inactive-border-color") { settings.*.inactive = parseColor(value, settings.*.inactive) }
            if std.text.same(key, "title-bars") { settings.*.titleBars = parseSwitch(value, settings.*.titleBars) }
            if std.text.same(key, "fps-counter") { settings.*.fpsCounter = parseSwitch(value, settings.*.fpsCounter) }
            if std.text.same(key, "client-decorations") { settings.*.clientDecorations = parseSwitch(value, settings.*.clientDecorations) }
            if std.text.same(key, "corner-radius") { settings.*.cornerRadius = parseNumber(value, settings.*.cornerRadius) }
            if std.text.same(key, "wobbly-windows") { settings.*.wobblyWindows = parseSwitch(value, settings.*.wobblyWindows) }
            if std.text.same(key, "dock-autohide") { settings.*.dockAutohide = parseSwitch(value, settings.*.dockAutohide) }
            parseHotkey(settings, key, value)
        }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
}

// A key-* line (keys.actionKey): "none" or a combination.
fn parseHotkey(settings: *Settings, name: []const u8, value: []const u8) -> void {
    var action: usize = 0
    while action < keys.ACTIONS {
        if std.text.same(name, keys.actionKey(action)) {
            var modifiers: u32 = 0
            var key: u32 = 0
            if std.text.same(value, "none") {
                settings.*.hotkeyModifiers[action] = 0
                settings.*.hotkeyKeys[action] = 0
            } else if keys.parse(value, &modifiers, &key) {
                settings.*.hotkeyModifiers[action] = modifiers
                settings.*.hotkeyKeys[action] = key
            }
            return
        }
        action += 1
    }
}

fn writeColor(line: [*]u8, at: usize, color: u32) -> usize {
    line[at] = 35
    var index: usize = 0
    while index < 6 {
        const nibble = (color >> @intCast(u5, (5 - index) * 4)) & 15
        line[at + 1 + index] = @intCast(u8, if nibble < 10 { 48 + nibble } else { 87 + nibble })
        index += 1
    }
    return at + 7
}

fn writeText(line: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        line[index] = byte
        index += 1
    }
    return index
}

// Writes the file whole (as NAME.new, renamed over it: the compositor never
// reads half a file).
fn save(settings: *Settings) -> void {
    var bytes: [1024]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length = writeText(text, 0, "# The Mlx compositor's settings (mlx-settings writes this file).\nborder-color = ")
    length = writeColor(text, length, settings.*.border)
    length = writeText(text, length, "\ninactive-border-color = ")
    length = writeColor(text, length, settings.*.inactive)
    length = writeText(text, length, if settings.*.titleBars { "\ntitle-bars = on\n" } else { "\ntitle-bars = off\n" })
    length = writeText(text, length, if settings.*.fpsCounter { "fps-counter = on\n" } else { "fps-counter = off\n" })
    length = writeText(text, length, if settings.*.clientDecorations { "client-decorations = on\n" } else { "client-decorations = off\n" })
    length = writeText(text, length, if settings.*.wobblyWindows { "wobbly-windows = on\n" } else { "wobbly-windows = off\n" })
    length = writeText(text, length, if settings.*.dockAutohide { "dock-autohide = on\n" } else { "dock-autohide = off\n" })
    length = writeText(text, length, "corner-radius = ")
    if settings.*.cornerRadius >= 10 {
        text[length] = @intCast(u8, 48 + settings.*.cornerRadius / 10)
        length += 1
    }
    text[length] = @intCast(u8, 48 + settings.*.cornerRadius % 10)
    text[length + 1] = 10
    length += 2
    var action: usize = 0
    while action < keys.ACTIONS {
        length = writeText(text, length, keys.actionKey(action))
        length = writeText(text, length, " = ")
        if settings.*.hotkeyKeys[action] == 0 {
            length = writeText(text, length, "none")
        } else {
            var at: [*]u8 = undefined
            unsafe { at = @ptrFromInt([*]u8, @intFromPtr(text) + length) }
            length += keys.format(settings.*.hotkeyModifiers[action], settings.*.hotkeyKeys[action], at)
        }
        text[length] = 10
        length += 1
        action += 1
    }

    var temporary: [264]u8 = undefined
    var temporary_path: [*]u8 = undefined
    unsafe { temporary_path = @ptrCast([*]u8, &temporary) }
    var index: usize = 0
    while index < settings.*.pathLength {
        temporary_path[index] = settings.*.path[index]
        index += 1
    }
    index = writeText(temporary_path, index, ".new")
    temporary_path[index] = 0
    const file = std.fs.open(temporary_path, O_WRONLY_CREATE_TRUNCATE, 420)
    if !std.fs.isValid(file) {
        settings.*.saved = false
        return
    }
    const written = std.fs.writeAllBytes(file, text, length)
    const closed = std.fs.close(file)
    settings.*.saved = written && std.fs.rename(temporary_path, pathOf(settings))
}

// ---------------------------------------------------------------------------
// Layout and input

fn swatchX(index: usize) -> i32 { return PADDING + @intCast(i32, index) * (SWATCH + SWATCH_GAP) }

// Row 0: title bars, row 1: the fps counter, row 2: rounded corners, row 3:
// wobbly windows, row 4: client decorations, row 5: the dock hiding.
fn rowY(row: usize) -> i32 { return ROW_TOP + @intCast(i32, row) * ROW_HEIGHT }

fn hotkeyY(action: usize) -> i32 { return HOTKEY_TOP + @intCast(i32, action) * HOTKEY_HEIGHT }

// The widgets' ids: swatch 0..9, switch row 100 + row, hotkey row
// 200 + action (std.ui ids start at 1).
fn idOf(item: usize) -> u64 { return @intCast(u64, item) + 1 }

fn itemOf(widget: u64) -> usize { return if widget == view.NONE { NONE } else { @intCast(usize, widget - 1) } }

fn themeOf(settings: *Settings) -> *theme_module.Theme {
    unsafe { return @ptrCast(*theme_module.Theme, &settings.*.theme) }
}

fn uiOf(settings: *Settings) -> *view.Ui {
    unsafe { return @ptrCast(*view.Ui, &settings.*.ui) }
}

// Recording a hotkey: every key comes here (the compositor's hotkeys
// too, while it lets this window have them).
fn startRecording(settings: *Settings, action: usize) -> void {
    settings.*.recording = action
    settings.*.held = 0
    panel_module.inhibitShortcuts(panelOf(settings), true)
}

fn stopRecording(settings: *Settings) -> void {
    settings.*.recording = NONE
    panel_module.inhibitShortcuts(panelOf(settings), false)
}

// A key while recording: modifiers are held, the first other key makes
// the combination (a letter or the like needs a modifier, so typing stays
// possible; function keys, Print and the like do not).
fn recordKey(settings: *Settings, key: u32, pressed: bool) -> void {
    const modifier = keys.modifierOf(key)
    if modifier != 0 {
        settings.*.held = if pressed { settings.*.held | modifier } else { settings.*.held & ~modifier }
        return
    }
    if !pressed { return }
    const action = settings.*.recording
    if key == KEY_ESCAPE && settings.*.held == 0 {
        stopRecording(settings)
        return
    }
    if key == KEY_BACKSPACE && settings.*.held == 0 {
        settings.*.hotkeyModifiers[action] = 0
        settings.*.hotkeyKeys[action] = 0
        stopRecording(settings)
        save(settings)
        return
    }
    if keys.keyName(key).length == 0 { return }
    const plain = (key >= 59 && key <= 68) || key == 87 || key == 88 || key == 99
    if settings.*.held == 0 && !plain { return }
    settings.*.hotkeyModifiers[action] = settings.*.held
    settings.*.hotkeyKeys[action] = key
    stopRecording(settings)
    save(settings)
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const settings = settingsOf(context)
    const panel = panelOf(settings)
    const widgets = uiOf(settings)
    if kind == panel_module.EVENT_MOTION {
        if !view.pointerMove(widgets, @bitCast(i32, a), b) { return }
    } else if kind == panel_module.EVENT_LEAVE {
        const left = view.pointerLeave(widgets)
    } else if kind == panel_module.EVENT_BUTTON {
        // A click is taken at once (a layout-only pass), not at the next
        // frame: keys typed right after it go to what it started.
        if a == BUTTON_LEFT && view.pointerButton(widgets, b == 1) != view.NONE && b == 0 {
            var nowhere = view.layoutCanvas()
            draw(context, &nowhere)
        }
        const item = itemOf(view.hitAt(widgets, widgets.*.pointerX, widgets.*.pointerY))
        if a == BUTTON_RIGHT && b == 1 && item >= 200 && item < 200 + keys.ACTIONS {
            // The default again.
            if settings.*.recording != NONE { stopRecording(settings) }
            const action = item - 200
            var modifiers: u32 = 0
            var key: u32 = 0
            keys.defaultBinding(action, &modifiers, &key)
            settings.*.hotkeyModifiers[action] = modifiers
            settings.*.hotkeyKeys[action] = key
            save(settings)
        }
    } else if kind == panel_module.EVENT_KEY {
        if settings.*.recording != NONE {
            if b != 2 { recordKey(settings, a, b == 1) }
        } else if a == KEY_ESCAPE && b == 1 {
            panel.*.running = false
        }
    }
    panel.*.dirty = true
}

// ---------------------------------------------------------------------------
// Drawing

fn opaque(rgb: u32) -> u32 { return 4278190080 | rgb }

// A switch row; true when it was clicked.
fn switchRow(settings: *Settings, row: usize, label: []const u8, note: []const u8, on: bool) -> bool {
    return controls.switchRow(uiOf(settings), idOf(100 + row), ui.rect(PADDING - 8, rowY(row), WIDTH - PADDING * 2 + 16, ROW_HEIGHT - 4), label, note, on)
}

// A hotkey row: what it does, and its keys in a box on the right (the box
// lit while it records); true when it was clicked.
fn hotkeyRow(settings: *Settings, action: usize) -> bool {
    const recording = settings.*.recording == action
    var bytes: [48]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    if recording {
        length = writeText(text, 0, "Press keys")
    } else if settings.*.hotkeyKeys[action] == 0 {
        length = writeText(text, 0, "None")
    } else {
        length = keys.format(settings.*.hotkeyModifiers[action], settings.*.hotkeyKeys[action], text)
    }
    return controls.valueRow(uiOf(settings), idOf(200 + action), ui.rect(PADDING - 8, hotkeyY(action), WIDTH - PADDING * 2 + 16, HOTKEY_HEIGHT - 4), keys.actionLabel(action), text[0..length], BINDING_WIDTH, recording)
}

// What a click changed (a switch, a swatch): saved at once.
fn changed(settings: *Settings) -> void {
    if settings.*.recording != NONE { stopRecording(settings) }
    save(settings)
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const settings = settingsOf(context)
    const widgets = uiOf(settings)
    const theme = themeOf(settings)
    view.begin(widgets, canvas)
    canvas_module.clear(canvas, theme.*.panel)
    text_module.drawText(canvas, titleOf(settings), "Settings", PADDING, 18, theme.*.knob, 0)

    // The border colour.
    text_module.drawText(canvas, bodyOf(settings), "Border color", PADDING, 66, theme.*.knob, 0)
    var index: usize = 0
    while index < @intCast(usize, SWATCHES) {
        if controls.swatch(widgets, idOf(index), swatchX(index), SWATCH_TOP, SWATCH, opaque(preset(index)), preset(index) == settings.*.border) {
            settings.*.border = preset(index)
            changed(settings)
        }
        index += 1
    }

    canvas_module.fillRect(canvas, PADDING, ROW_TOP - 14, WIDTH - PADDING * 2, 1, theme.*.button)
    if switchRow(settings, 0, "Title bars", "A bar with the title above each window", settings.*.titleBars) {
        settings.*.titleBars = !settings.*.titleBars
        changed(settings)
    }
    if switchRow(settings, 1, "FPS counter", "Frames per second in the title bars", settings.*.fpsCounter) {
        settings.*.fpsCounter = !settings.*.fpsCounter
        changed(settings)
    }
    if switchRow(settings, 2, "Rounded corners", "Window corners like GTK's (12 pixels)", settings.*.cornerRadius > 0) {
        settings.*.cornerRadius = if settings.*.cornerRadius == 0 { DEFAULT_RADIUS } else { 0 }
        changed(settings)
    }
    if switchRow(settings, 3, "Wobbly windows", "Windows wobble as you move them", settings.*.wobblyWindows) {
        settings.*.wobblyWindows = !settings.*.wobblyWindows
        changed(settings)
    }
    if switchRow(settings, 4, "App decorations", "Programs draw their own title bars and frames", settings.*.clientDecorations) {
        settings.*.clientDecorations = !settings.*.clientDecorations
        changed(settings)
    }
    if switchRow(settings, 5, "Auto-hide dock", "The dock hides; the screen's bottom edge brings it", settings.*.dockAutohide) {
        settings.*.dockAutohide = !settings.*.dockAutohide
        changed(settings)
    }

    // The hotkeys: a click records the row's keys.
    canvas_module.fillRect(canvas, PADDING, HOTKEY_TITLE - 10, WIDTH - PADDING * 2, 1, theme.*.button)
    text_module.drawText(canvas, bodyOf(settings), "Hotkeys", PADDING, HOTKEY_TITLE, theme.*.knob, 0)
    var action: usize = 0
    while action < keys.ACTIONS {
        if hotkeyRow(settings, action) {
            if settings.*.recording != NONE { stopRecording(settings) }
            startRecording(settings, action)
        }
        action += 1
    }

    const footer = if settings.*.recording != NONE { "Esc keeps the old keys, Backspace clears them" } else if settings.*.saved { "Saved to ~/.config/mlx/compositor.conf" } else { "Changes apply at once" }
    text_module.drawText(canvas, smallOf(settings), footer, PADDING, HEIGHT - 34, theme.*.dim, 0)
    // A click changed what was drawn before it: once more.
    if view.end(widgets) { panelOf(settings).*.dirty = true }
}

const Failure = error { NoMemory, NoHome }

fn noMemory() -> Failure!void { return Failure.NoMemory }
fn noHome() -> Failure!void { return Failure.NoHome }

pub fn main(arguments: [][*]const u8) -> !void {
    crash.install()
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Settings), 16)
    if memory == null { return noMemory() }
    var settings: *Settings = undefined
    unsafe { settings = @ptrCast(*Settings, memory.?) }
    settings.*.saved = false
    settings.*.recording = NONE
    settings.*.held = 0
    if !locate(settings, environment) { return noHome() }
    load(settings, allocator)
    const loaded_title = text_module.loadText(titleOf(settings), 22, allocator)
    const loaded_body = text_module.loadText(bodyOf(settings), 15, allocator)
    const loaded_small = text_module.loadText(smallOf(settings), 12, allocator)
    settings.*.theme = theme_module.dark()
    view.init(uiOf(settings), themeOf(settings), bodyOf(settings), smallOf(settings), bodyOf(settings))

    const panel = panelOf(settings)
    panel.*.context = @ptrCast(*anyopaque, settings)
    panel.*.draw = draw
    panel.*.event = onEvent
    try panel_module.openWindow(panel, allocator, arguments, "Settings", "org.mlx.settings", @intCast(u32, WIDTH), @intCast(u32, HEIGHT))
    panel_module.report(panel, "mlx-settings")
    try panel_module.run(panel)
    panel_module.close(panel)
}
