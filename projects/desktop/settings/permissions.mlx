// The Apps page: what each app may do, as MLXIPC decides it
// (projects/desktop/ipc). The bus lists every app that asked for a
// permission and every rule of ipc.conf naming one app and one permission
// (org.mlx.IPC.ListPermissions); each row offers Allow, Ask, Deny or the
// default, and a choice goes back to the bus (SetPermission), which
// writes ipc.conf; the services check their apps again at once (a
// recording whose permission went ends). The page asks the bus again
// every second while it is shown, so an answer given in the permission
// dialog (mlx-permissions) shows up. It talks to the bus over std.dbus.
const std = @import("std")
const dbus = @import("std.dbus")
const ui = @import("std.ui")
const controls = @import("std.ui.controls")
const popup = @import("std.ui.popup")
const apps_module = @import("../shared/apps.mlx")
const page_module = @import("./page.mlx")

const Page = page_module.Page

pub const MAX_ENTRIES: usize = 64

const BUS: []const u8 = "org.freedesktop.DBus"
const IPC: []const u8 = "org.mlx.IPC"
const IPC_PATH: []const u8 = "/org/mlx/IPC"

// The widgets' items (page_module.idOf): a row's choices at ITEM_CHOICE
// + 4 * entry + choice, above what the other pages use.
const ITEM_CHOICE: usize = 2000

// The choices, in the order the segments show them.
const CHOICES: usize = 4
const CHOICE_ALLOW: usize = 0
const CHOICE_ASK: usize = 1
const CHOICE_DENY: usize = 2
const CHOICE_DEFAULT: usize = 3

// The segments' width (logical pixels), and the page narrower than which
// they go under the row's name.
const SEGMENTS: i32 = 300
const NARROW: i32 = 480
const ROW: i32 = 50

// One app's permission as the bus told it.
pub const Entry = struct {
    app: [128]u8
    appLength: usize
    permission: [64]u8
    permissionLength: usize
    // allow, deny, ask (a rule), session-allow, session-deny,
    // default-allow, default-ask, default-deny.
    decision: [16]u8
    decisionLength: usize
    sandboxed: bool
}

pub const Permissions = struct {
    environment: [*][*]const u8
    // The bus (a dbus.Client; 0: not connected).
    client: usize
    // The bus answered ListPermissions (it is MLXIPC).
    known: bool
    entries: [64]Entry
    entryCount: usize
    // What the bus said when a change failed (empty: nothing).
    problem: [128]u8
    problemLength: usize
    // The apps' names (their desktop entries), read once.
    apps: apps_module.Apps
    appsRead: bool
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool { return text.length >= prefix.length && same(text[0..prefix.length], prefix) }

fn copyInto(target: [*]u8, capacity: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && index < capacity {
        target[index] = text[index]
        index += 1
    }
    return index
}

fn after(bytes: [*]u8, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(bytes) + offset) }
}

fn noBody() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "") }
}

fn clientOf(permissions: *Permissions) -> *dbus.Client {
    unsafe { return @ptrFromInt(*dbus.Client, permissions.*.client) }
}

fn entryAt(permissions: *Permissions, index: usize) -> *Entry {
    unsafe { return @ptrCast(*Entry, &permissions.*.entries[index]) }
}

fn appsOf(permissions: *Permissions) -> *apps_module.Apps {
    unsafe { return @ptrCast(*apps_module.Apps, &permissions.*.apps) }
}

fn appOf(entry: *Entry) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &entry.*.app) }
    return bytes[0..entry.*.appLength]
}

fn permissionOf(entry: *Entry) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &entry.*.permission) }
    return bytes[0..entry.*.permissionLength]
}

fn decisionOf(entry: *Entry) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &entry.*.decision) }
    return bytes[0..entry.*.decisionLength]
}

fn problemOf(permissions: *Permissions) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &permissions.*.problem) }
    return bytes[0..permissions.*.problemLength]
}

pub fn init(permissions: *Permissions, environment: [*][*]const u8) -> void {
    permissions.*.environment = environment
    permissions.*.client = 0
    permissions.*.known = false
    permissions.*.entryCount = 0
    permissions.*.problemLength = 0
    permissions.*.appsRead = false
}

fn disconnect(permissions: *Permissions, allocator: std.allocator.Allocator) -> void {
    if permissions.*.client == 0 { return }
    dbus.disconnect(clientOf(permissions), allocator)
    var memory: [*]u8 = undefined
    unsafe { memory = @ptrFromInt([*]u8, permissions.*.client) }
    allocator.free(memory, @sizeOf(dbus.Client), 16)
    permissions.*.client = 0
}

fn connect(permissions: *Permissions, allocator: std.allocator.Allocator) -> bool {
    if permissions.*.client != 0 && !clientOf(permissions).*.closed { return true }
    disconnect(permissions, allocator)
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    if memory == null { return false }
    permissions.*.client = @intFromPtr(memory.?)
    if !dbus.connectSession(clientOf(permissions), allocator, permissions.*.environment) {
        allocator.free(memory.?, @sizeOf(dbus.Client), 16)
        permissions.*.client = 0
        return false
    }
    return true
}

// Asks the bus for the list again; false when there is no MLXIPC to ask.
pub fn refresh(permissions: *Permissions, allocator: std.allocator.Allocator) -> bool {
    if !permissions.*.appsRead {
        permissions.*.appsRead = true
        if apps_module.init(appsOf(permissions), permissions.*.environment, allocator) {
            apps_module.scan(appsOf(permissions))
        } else {
            permissions.*.apps.count = 0
        }
    }
    if !connect(permissions, allocator) {
        permissions.*.known = false
        return false
    }
    const client = clientOf(permissions)
    var reply: dbus.Header = undefined
    const serial = dbus.call(client, BUS, IPC_PATH, IPC, "ListPermissions", "", noBody(), 0)
    if serial == 0 || !dbus.waitReply(client, serial, &reply, 1000) || reply.kind == dbus.ERROR {
        permissions.*.known = false
        return false
    }
    permissions.*.known = true
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    const length = @intCast(usize, dbus.readU32(&reading))
    dbus.alignTo(&reading, 8)
    const end = reading.position + length
    var count: usize = 0
    while reading.position < end && !reading.failed && count < MAX_ENTRIES {
        dbus.alignTo(&reading, 8)
        const app = dbus.readString(&reading)
        const permission = dbus.readString(&reading)
        const decision = dbus.readString(&reading)
        const sandboxed = dbus.readBool(&reading)
        if reading.failed { break }
        const entry = entryAt(permissions, count)
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &entry.*.app) }
        entry.*.appLength = copyInto(bytes, 128, app)
        unsafe { bytes = @ptrCast([*]u8, &entry.*.permission) }
        entry.*.permissionLength = copyInto(bytes, 64, permission)
        unsafe { bytes = @ptrCast([*]u8, &entry.*.decision) }
        entry.*.decisionLength = copyInto(bytes, 16, decision)
        entry.*.sandboxed = sandboxed
        count += 1
    }
    permissions.*.entryCount = count
    return true
}

// SetPermission(app, permission, decision), then the list again.
fn change(permissions: *Permissions, entry: *Entry, decision: []const u8, allocator: std.allocator.Allocator) -> void {
    permissions.*.problemLength = 0
    if !connect(permissions, allocator) { return }
    const client = clientOf(permissions)
    var memory: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &memory) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 512, false)
    dbus.putString(&writing, appOf(entry))
    dbus.putString(&writing, permissionOf(entry))
    dbus.putString(&writing, decision)
    var reply: dbus.Header = undefined
    const serial = dbus.call(client, BUS, IPC_PATH, IPC, "SetPermission", "sss", bytes, writing.length)
    if serial != 0 && dbus.waitReply(client, serial, &reply, 2000) && reply.kind == dbus.ERROR {
        var problem: [*]u8 = undefined
        unsafe { problem = @ptrCast([*]u8, &permissions.*.problem) }
        if reply.signature.length > 0 && reply.signature[0] == 115 {
            var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
            permissions.*.problemLength = copyInto(problem, 128, dbus.readString(&reading))
        } else {
            permissions.*.problemLength = copyInto(problem, 128, reply.errorName)
        }
    }
    const read = refresh(permissions, allocator)
}

// The app's name from its desktop entry, else its id.
fn nameOf(permissions: *Permissions, app: []const u8) -> []const u8 {
    const index = apps_module.find(appsOf(permissions), app)
    if index < permissions.*.apps.count { return apps_module.nameOf(apps_module.appAt(appsOf(permissions), index)) }
    return app
}

// What a permission lets an app do.
fn permissionLabel(page: *Page, permission: []const u8) -> []const u8 {
    if same(permission, "audio.record") { return page_module.say(page, "Microphone", "Mikrofon") }
    if same(permission, "audio.monitor") { return page_module.say(page, "Sound of other apps", "Ton anderer Apps") }
    if same(permission, "audio.play") { return page_module.say(page, "Play sound", "Ton abspielen") }
    if same(permission, "audio.control") { return page_module.say(page, "Sound settings", "Toneinstellungen") }
    if same(permission, "ipc.manage") { return page_module.say(page, "Permissions of apps", "Berechtigungen von Apps") }
    return permission
}

// Where the decision comes from, under the row's name.
fn decisionNote(page: *Page, decision: []const u8) -> []const u8 {
    if same(decision, "session-allow") { return page_module.say(page, "Allowed for this session", "Für diese Sitzung erlaubt") }
    if same(decision, "session-deny") { return page_module.say(page, "Denied for this session", "Für diese Sitzung abgelehnt") }
    if same(decision, "default-allow") { return page_module.say(page, "Default: allowed", "Standard: erlaubt") }
    if same(decision, "default-ask") { return page_module.say(page, "Default: asks", "Standard: fragen") }
    if same(decision, "default-deny") { return page_module.say(page, "Default: denied", "Standard: abgelehnt") }
    return page_module.say(page, "Chosen here (ipc.conf)", "Hier festgelegt (ipc.conf)")
}

// The segment a decision shows as chosen.
fn chosenOf(decision: []const u8) -> usize {
    if same(decision, "allow") { return CHOICE_ALLOW }
    if same(decision, "ask") { return CHOICE_ASK }
    if same(decision, "deny") { return CHOICE_DENY }
    return CHOICE_DEFAULT
}

fn choiceLabel(page: *Page, choice: usize) -> []const u8 {
    return match choice {
        0 => page_module.say(page, "Allow", "Erlauben"),
        1 => page_module.say(page, "Ask", "Fragen"),
        2 => page_module.say(page, "Deny", "Ablehnen"),
        else => page_module.say(page, "Default", "Standard")
    }
}

fn choiceText(choice: usize) -> []const u8 {
    return match choice {
        0 => "allow",
        1 => "ask",
        2 => "deny",
        else => "default"
    }
}

// One permission of an app: its name and where its decision comes from,
// the four choices on the right (under them when the page is narrow).
fn row(permissions: *Permissions, page: *Page, y: i32, index: usize, allocator: std.allocator.Allocator) -> i32 {
    const entry = entryAt(permissions, index)
    const theme = page.*.theme
    const narrow = page.*.width < page_module.px(page, NARROW)
    const segments = if narrow { page.*.width } else { page_module.px(page, SEGMENTS) }
    const room = if narrow { page.*.width } else { page.*.width - segments - page_module.px(page, 12) }
    controls.label(page.*.ui, page.*.body, permissionLabel(page, permissionOf(entry)), page.*.left, y + page_module.px(page, 4), theme.*.text, room)
    controls.label(page.*.ui, page.*.small, decisionNote(page, decisionOf(entry)), page.*.left, y + page_module.px(page, 24), theme.*.dim, room)
    const height = page_module.px(page, 32)
    var top = y + page_module.px(page, 6)
    var left = page.*.left + page.*.width - segments
    if narrow {
        top = y + page_module.px(page, 46)
        left = page.*.left
    }
    controls.segmentsFrame(page.*.ui, ui.rect(left, top, segments, height))
    const part = (segments - page_module.px(page, 4)) / 4
    const chosen = chosenOf(decisionOf(entry))
    var choice: usize = 0
    while choice < CHOICES {
        const area = ui.rect(left + page_module.px(page, 2) + @intCast(i32, choice) * part, top + page_module.px(page, 2), part, height - page_module.px(page, 4))
        if controls.segment(page.*.ui, page_module.idOf(ITEM_CHOICE + index * CHOICES + choice), area, choiceLabel(page, choice), choice == chosen, 0) && choice != chosen {
            change(permissions, entry, choiceText(choice), allocator)
        }
        choice += 1
    }
    return y + page_module.px(page, if narrow { ROW + 38 } else { ROW })
}

// Whether an earlier entry has the same app (its rows were drawn with
// that one).
fn listedBefore(permissions: *Permissions, index: usize) -> bool {
    const app = appOf(entryAt(permissions, index))
    var earlier: usize = 0
    while earlier < index {
        if same(appOf(entryAt(permissions, earlier)), app) { return true }
        earlier += 1
    }
    return false
}

pub fn draw(permissions: *Permissions, page: *Page, top: i32, allocator: std.allocator.Allocator) -> i32 {
    const theme = page.*.theme
    var y = top
    const intro = page_module.say(page, "What apps may do, as the session bus (MLXIPC) decides it. Sandboxed apps ask before they use the microphone or record other apps; a remembered answer shows here.", "Was Apps dürfen, wie es der Sitzungsbus (MLXIPC) entscheidet. Apps in einer Sandbox fragen, bevor sie das Mikrofon nutzen oder andere Apps aufnehmen; eine gemerkte Antwort steht hier.")
    const line = page_module.px(page, 18)
    const lines = popup.wrapped(page.*.ui, page.*.small, intro, page.*.left, y, page.*.width, line, 4, theme.*.dim)
    y += @intCast(i32, lines) * line + page_module.px(page, 4)
    if !permissions.*.known {
        return page_module.note(page, y, page_module.say(page, "The session bus is not MLXIPC: there are no permissions to show.", "Der Sitzungsbus ist nicht MLXIPC: keine Berechtigungen anzuzeigen."))
    }
    if permissions.*.problemLength > 0 { y = page_module.note(page, y, problemOf(permissions)) }
    if permissions.*.entryCount == 0 {
        return page_module.note(page, y, page_module.say(page, "No app has asked for a permission yet.", "Noch keine App hat nach einer Berechtigung gefragt."))
    }
    var index: usize = 0
    while index < permissions.*.entryCount {
        if !listedBefore(permissions, index) {
            // The app: its name, its id and whether it runs in a sandbox;
            // then each of its permissions.
            const first = entryAt(permissions, index)
            const app = appOf(first)
            if index > 0 { popup.separator(page.*.ui, page.*.left - page_module.px(page, 8), y + page_module.px(page, 4), page.*.width + page_module.px(page, 16)) }
            y += page_module.px(page, 12)
            const name = nameOf(permissions, app)
            controls.label(page.*.ui, page.*.body, name, page.*.left, y, theme.*.text, page.*.width)
            // Its id when the name is another, and the sandbox.
            var detail: [192]u8 = undefined
            var detail_bytes: [*]u8 = undefined
            unsafe { detail_bytes = @ptrCast([*]u8, &detail) }
            var length: usize = 0
            if !same(name, app) { length = copyInto(detail_bytes, 128, app) }
            if first.*.sandboxed {
                if length > 0 { length += copyInto(after(detail_bytes, length), 4, " · ") }
                length += copyInto(after(detail_bytes, length), 48, page_module.say(page, "sandboxed", "in einer Sandbox"))
            }
            if length > 0 {
                controls.label(page.*.ui, page.*.small, detail_bytes[0..length], page.*.left, y + page_module.px(page, 20), theme.*.dim, page.*.width)
                y += page_module.px(page, 20)
            }
            y += page_module.px(page, 24)
            var other = index
            while other < permissions.*.entryCount {
                if same(appOf(entryAt(permissions, other)), app) { y = row(permissions, page, y, other, allocator) }
                other += 1
            }
        }
        index += 1
    }
    return y
}
