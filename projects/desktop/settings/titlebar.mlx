// The Windows page's title bar section: a preview of a title bar as the
// compositor will draw it, then its buttons (close, minimize, maximize),
// each with a switch (shown or not; the whole row takes the click) and
// arrows moving it a place to the left or the right on the bar (past the
// end of a side it goes over to the other), then how translucent title
// bars are and whether what is behind them is blurred. main.mlx keeps
// the values in compositor.conf (title-buttons, title-opacity, title-blur;
// shared/title_buttons.mlx) and saves them when `changed` says so.
const ui = @import("std.ui")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const std = @import("std")
const page_module = @import("./page.mlx")
const buttons_module = @import("../shared/title_buttons.mlx")
const symbols = @import("../shared/symbols.mlx")

const Canvas = canvas_module.Canvas
const Page = page_module.Page
const Layout = buttons_module.Layout

// Logical pixels: a row, the preview, an arrow button, a button's circle.
const ROW: i32 = page_module.SWITCH_ROW
const PREVIEW: i32 = 34
const ARROW: i32 = 28
const CIRCLE: i32 = 12

// The compositor's defaults (scene.TITLE_ALPHA, 214 of 255).
pub const DEFAULT_OPACITY: u32 = 84

// The widgets' ids (page_module.idOf): a button's row, its arrows, the
// opacity slider, the blur switch.
pub const ID_ROW: usize = 3000
pub const ID_LEFT: usize = 3100
pub const ID_RIGHT: usize = 3200
pub const ID_OPACITY: usize = 3300
pub const ID_BLUR: usize = 3301

pub const TitleBar = struct {
    layout: Layout
    // Percent (15 to 100).
    opacity: u32
    blur: bool
    // Something was changed: main.mlx saves the file.
    changed: bool
    symbols: symbols.Cache
}

fn layoutOf(bar: *TitleBar) -> *Layout {
    unsafe { return @ptrCast(*Layout, &bar.*.layout) }
}

fn symbolsOf(bar: *TitleBar) -> *symbols.Cache {
    unsafe { return @ptrCast(*symbols.Cache, &bar.*.symbols) }
}

pub fn init(bar: *TitleBar, allocator: std.allocator.Allocator) -> void {
    symbols.init(symbolsOf(bar), allocator)
    defaults(bar)
    bar.*.changed = false
}

pub fn defaults(bar: *TitleBar) -> void {
    buttons_module.defaults(layoutOf(bar))
    bar.*.opacity = DEFAULT_OPACITY
    bar.*.blur = true
}

// A compositor.conf line about the title bar into the values; false when
// `key` is none of theirs.
pub fn loadKey(bar: *TitleBar, key: []const u8, value: []const u8) -> bool {
    if std.text.same(key, "title-buttons") {
        _ = buttons_module.parse(value, layoutOf(bar))
        return true
    }
    if std.text.same(key, "title-opacity") {
        var number: u32 = 0
        var digits: usize = 0
        for byte in value {
            if byte < 48 || byte > 57 { return true }
            number = number * 10 + @intCast(u32, byte - 48)
            digits += 1
        }
        if digits > 0 && digits <= 3 && number >= 15 && number <= 100 { bar.*.opacity = number }
        return true
    }
    if std.text.same(key, "title-blur") {
        if std.text.same(value, "on") || std.text.same(value, "true") || std.text.same(value, "yes") { bar.*.blur = true }
        if std.text.same(value, "off") || std.text.same(value, "false") || std.text.same(value, "no") { bar.*.blur = false }
        return true
    }
    return false
}

fn append(into: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        into[index] = byte
        index += 1
    }
    return index
}

// The lines for compositor.conf from `at`; the end (at most 80 bytes).
pub fn save(bar: *const TitleBar, into: [*]u8, at: usize) -> usize {
    var length = append(into, at, "title-buttons = ")
    length = buttons_module.write(&bar.*.layout, into, length)
    length = append(into, length, "\ntitle-opacity = ")
    if bar.*.opacity >= 100 {
        length = append(into, length, "100")
    } else {
        into[length] = @intCast(u8, 48 + bar.*.opacity / 10)
        into[length + 1] = @intCast(u8, 48 + bar.*.opacity % 10)
        length += 2
    }
    length = append(into, length, if bar.*.blur { "\ntitle-blur = on\n" } else { "\ntitle-blur = off\n" })
    return length
}

// ---------------------------------------------------------------------------
// The preview

fn buttonColor(kind: u8) -> u32 {
    if kind == buttons_module.CLOSE { return canvas_module.color(255, 255, 95, 87) }
    if kind == buttons_module.MINIMIZE { return canvas_module.color(255, 254, 188, 46) }
    return canvas_module.color(255, 40, 200, 64)
}

// A title bar over a strip of window: the buttons where the compositor
// puts them, the title between. Returns the y after it.
fn preview(bar: *TitleBar, page: *const Page, y: i32) -> i32 {
    const canvas = page.*.ui.*.canvas
    const theme = page.*.theme
    const height = page_module.px(page, PREVIEW)
    const radius = page_module.px(page, 10)
    const alpha = bar.*.opacity * 255 / 100
    // The bar as the compositor draws it (scene.FOCUS_COLOR), over a
    // stripe of colour that shows how translucent it is.
    canvas_module.fillRoundedRect(canvas, page.*.left, y, page.*.width, height + page_module.px(page, 12), radius, canvas_module.color(255, 46, 60, 110))
    canvas_module.fillRect(canvas, page.*.left + page.*.width / 3, y, page.*.width / 3, height, canvas_module.color(255, 90, 160, 255))
    canvas_module.fillRoundedRect(canvas, page.*.left, y, page.*.width, height, radius, canvas_module.color(alpha, 48, 55, 68))
    canvas_module.fillRect(canvas, page.*.left, y + height, page.*.width, page_module.px(page, 12), canvas_module.color(255, 30, 30, 30))
    const layout = layoutOf(bar)
    const size = page_module.px(page, CIRCLE)
    const step = size + page_module.px(page, 8)
    const margin = page_module.px(page, 12)
    const middle = y + (height - size) / 2
    var index: usize = 0
    while index < layout.*.leftCount {
        const x = page.*.left + margin + @intCast(i32, index) * step
        canvas_module.fillRoundedRect(canvas, x, middle, size, size, size / 2, buttonColor(layout.*.left[index]))
        index += 1
    }
    index = 0
    while index < layout.*.rightCount {
        const x = page.*.left + page.*.width - margin - size - @intCast(i32, layout.*.rightCount - 1 - index) * step
        canvas_module.fillRoundedRect(canvas, x, middle, size, size, size / 2, buttonColor(layout.*.right[index]))
        index += 1
    }
    const title_left = page.*.left + margin + @intCast(i32, layout.*.leftCount) * step + page_module.px(page, 4)
    controls.label(page.*.ui, page.*.small, page_module.say(page, "Window title", "Fenstertitel"), title_left, controls.textTop(page.*.small, y, height), canvas_module.color(255, 255, 255, 255), page.*.width / 2)
    _ = theme
    return y + height + page_module.px(page, 22)
}

// ---------------------------------------------------------------------------
// The rows

// An arrow button (dim and taking no clicks when not `enabled`); true when
// clicked.
fn arrow(bar: *TitleBar, page: *const Page, id: usize, x: i32, y: i32, left: bool, enabled: bool) -> bool {
    const size = page_module.px(page, ARROW)
    var clicked = false
    if enabled { clicked = controls.miniButton(page.*.ui, page_module.idOf(id), ui.rect(x, y, size, size)) }
    const glyph = page_module.px(page, 18)
    const color = if enabled { page.*.theme.*.text } else { page.*.theme.*.disabled }
    symbols.draw(symbolsOf(bar), page.*.ui.*.canvas, if left { symbols.CHEVRON_LEFT } else { symbols.CHEVRON_RIGHT }, 0, x + (size - glyph) / 2, y + (size - glyph) / 2, glyph, color)
    return clicked
}

fn place(page: *const Page, layout: *const Layout, kind: u8) -> []const u8 {
    var left = false
    var at: usize = 0
    if !buttons_module.find(layout, kind, &left, &at) { return page_module.say(page, "Hidden", "Ausgeblendet") }
    return if left { page_module.say(page, "On the left of the title bar", "Links in der Titelleiste") } else { page_module.say(page, "On the right of the title bar", "Rechts in der Titelleiste") }
}

fn row(bar: *TitleBar, page: *const Page, y: i32, kind: u8) -> void {
    const layout = layoutOf(bar)
    const context = page.*.ui
    const theme = page.*.theme
    const canvas = context.*.canvas
    const s = page.*.scale
    const area = ui.rect(page.*.left - page_module.px(page, 8), y, page.*.width + page_module.px(page, 16), page_module.px(page, ROW - 4))
    const row_id = page_module.idOf(ID_ROW + @intCast(usize, kind))
    view.region(context, row_id, area)
    const lit = view.isHover(context, row_id)
    if lit { canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, theme.*.radius + 2, theme.*.hover) }
    var on_left = false
    var at: usize = 0
    const on = buttons_module.find(layout, kind, &on_left, &at)
    const size = page_module.px(page, CIRCLE + 4)
    canvas_module.fillRoundedRect(canvas, page.*.left, y + (area.height - size) / 2, size, size, size / 2, if on { buttonColor(kind) } else { theme.*.disabled })
    const switch_left = ui.right(area) - (8 + controls.SWITCH_WIDTH) * s
    const arrows_left = switch_left - page_module.px(page, 16 + 2 * ARROW + 4)
    const text_left = page.*.left + page_module.px(page, 34)
    const room = arrows_left - text_left - page_module.px(page, 8)
    controls.label(context, page.*.body, buttons_module.label(kind, page.*.german), text_left, y + 2 * s, if on { theme.*.text } else { theme.*.dim }, room)
    controls.label(context, page.*.small, place(page, layout, kind), text_left, y + 22 * s, theme.*.dim, room)
    controls.drawSwitch(context, switch_left, area.y + (area.height - controls.SWITCH_HEIGHT * s) / 2, on, lit)
    const arrow_top = area.y + (area.height - page_module.px(page, ARROW)) / 2
    // Furthest left: first on the left; furthest right: last on the right.
    const can_left = on && !(on_left && at == 0)
    const can_right = on && !(!on_left && at + 1 == layout.*.rightCount)
    if arrow(bar, page, ID_LEFT + @intCast(usize, kind), arrows_left, arrow_top, true, can_left) {
        buttons_module.move(layout, kind, true)
        bar.*.changed = true
    }
    if arrow(bar, page, ID_RIGHT + @intCast(usize, kind), arrows_left + page_module.px(page, ARROW + 4), arrow_top, false, can_right) {
        buttons_module.move(layout, kind, false)
        bar.*.changed = true
    }
    if view.takeClick(context, row_id) {
        buttons_module.toggle(layout, kind)
        bar.*.changed = true
    }
}

// The section from `top`; the y after it.
pub fn draw(bar: *TitleBar, page: *const Page, top: i32) -> i32 {
    var y = page_module.section(page, top, page_module.say(page, "Title bar", "Titelleiste"))
    y = preview(bar, page, y)
    row(bar, page, y, buttons_module.CLOSE)
    y += page_module.px(page, ROW)
    row(bar, page, y, buttons_module.MINIMIZE)
    y += page_module.px(page, ROW)
    row(bar, page, y, buttons_module.MAXIMIZE)
    y += page_module.px(page, ROW)
    y = page_module.note(page, y, page_module.say(page, "The arrows move a button along the bar, across the title to the other side.", "Die Pfeile schieben einen Knopf entlang der Leiste, über den Titel auf die andere Seite."))
    var opacity = page_module.sliderRow(page, y, ID_OPACITY, page_module.say(page, "Opacity", "Deckkraft"), bar.*.opacity, 100, 100)
    if opacity < 15 { opacity = 15 }
    if opacity != bar.*.opacity {
        bar.*.opacity = opacity
        bar.*.changed = true
    }
    y += page_module.px(page, page_module.SLIDER_ROW)
    if page_module.switchRow(page, y, ID_BLUR, page_module.say(page, "Blur behind title bars", "Unschärfe hinter Titelleisten"), page_module.say(page, "What is behind a translucent title bar is blurred, like frosted glass", "Was hinter einer durchscheinenden Titelleiste liegt, wird wie Milchglas weichgezeichnet"), bar.*.blur) {
        bar.*.blur = !bar.*.blur
        bar.*.changed = true
    }
    return y + page_module.px(page, page_module.SWITCH_ROW)
}
