// The Sound page: MLX Audio (mlx-audiod) through std.audio. The page asks
// the server for its state (STATUS) when it is shown and twice a second
// while it is, and changes it (SET): the output and the input (a sound
// card, the first there is, or none), their volumes and mute, each app's
// volume and the sink it plays to, the virtual sinks' volumes (sinks are
// added with mlx-audio sink add). Which apps may use the microphone is MLXIPC's
// permission audio.record: a switch writes "allow APP use audio.record"
// or "deny ..." into ~/.config/mlx/ipc.conf (the bus reads it again) and
// asks the server to check its streams again (a recording whose
// permission went ends). Controlling the server takes audio.control,
// which unsandboxed apps have.
const std = @import("std")
const audio = @import("std.audio")
const apps_module = @import("../shared/apps.mlx")
const page_module = @import("./page.mlx")

const Page = page_module.Page

pub const MAX_DEVICES: usize = 16
pub const MAX_STREAMS: usize = 16
pub const MAX_ASKED: usize = 16
pub const MAX_APPS: usize = 16
pub const MAX_SINKS: usize = 8
pub const STATE_SIZE: usize = 32768

// The widgets' items (page_module.idOf): above everything main.mlx uses.
const ITEM_OUTPUT: usize = 1000
const ITEM_INPUT: usize = 1100
const ITEM_VOLUME: usize = 1200
const ITEM_MUTE: usize = 1201
const ITEM_INPUT_VOLUME: usize = 1202
const ITEM_INPUT_MUTE: usize = 1203
const ITEM_TEST: usize = 1204
const ITEM_RETRY: usize = 1205
const ITEM_APP: usize = 1300
const ITEM_APP_SINK: usize = 1320
const ITEM_SINK: usize = 1340
const ITEM_MICROPHONE: usize = 1400

// Whether widget item `item` is one of the page's sliders (the wheel turns
// it rather than scrolling the page).
pub fn isSlider(item: usize) -> bool { return item == ITEM_VOLUME || item == ITEM_INPUT_VOLUME || (item >= ITEM_APP && item < ITEM_APP + MAX_APPS) || (item >= ITEM_SINK && item < ITEM_SINK + MAX_SINKS) }

pub const Device = struct {
    capture: bool
    name: [32]u8
    nameLength: usize
    label: [96]u8
    labelLength: usize
}

pub const Stream = struct {
    id: u32
    app: [64]u8
    appLength: usize
    record: bool
    volume: u32
    name: [64]u8
    nameLength: usize
}

// An app MLX Audio knows (it played, or has settings): its volume, mute
// and sink (empty: the default one).
pub const App = struct {
    name: [64]u8
    nameLength: usize
    volume: u32
    mute: bool
    sink: [32]u8
    sinkLength: usize
}

// A virtual sink: where its mix goes (to the output, or only its
// monitor), its volume and mute.
pub const Sink = struct {
    name: [32]u8
    nameLength: usize
    output: bool
    volume: u32
    mute: bool
}

pub const Asked = struct {
    app: [96]u8
    appLength: usize
    record: bool
    allowed: bool
}

pub const Sound = struct {
    environment: [*][*]const u8
    // The std.audio connection (0: none yet), and what connect said.
    connection: usize
    connected: bool
    status: u32
    // The server lets this app see and change it (audio.control).
    control: bool
    output: [96]u8
    outputLength: usize
    input: [96]u8
    inputLength: usize
    outputProblem: [16]u8
    outputProblemLength: usize
    inputProblem: [16]u8
    inputProblemLength: usize
    holder: [64]u8
    holderLength: usize
    volume: u32
    mute: bool
    inputVolume: u32
    inputMute: bool
    devices: [16]Device
    deviceCount: usize
    streams: [16]Stream
    streamCount: usize
    asked: [16]Asked
    askedCount: usize
    apps: [16]App
    appCount: usize
    sinks: [8]Sink
    sinkCount: usize
    // STATE's text, as it came.
    state: [*]u8
    // ~/.config/mlx/ipc.conf (NUL-terminated).
    ipcPath: [256]u8
    ipcPathLength: usize
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool { return text.length >= prefix.length && same(text[0..prefix.length], prefix) }

fn copyInto(target: [*]u8, capacity: usize, text: []const u8) -> usize {
    var length: usize = 0
    while length < text.length && length < capacity {
        target[length] = text[length]
        length += 1
    }
    return length
}

fn number(text: []const u8) -> u32 {
    var value: u32 = 0
    var index: usize = 0
    while index < text.length && text[index] >= 48 && text[index] <= 57 {
        value = value * 10 + @intCast(u32, text[index] - 48)
        index += 1
    }
    return value
}

fn connectionOf(sound: *Sound) -> *audio.Audio {
    unsafe { return @ptrFromInt(*audio.Audio, sound.*.connection) }
}

fn deviceAt(sound: *Sound, index: usize) -> *Device {
    unsafe { return @ptrCast(*Device, &sound.*.devices[index]) }
}

fn streamAt(sound: *Sound, index: usize) -> *Stream {
    unsafe { return @ptrCast(*Stream, &sound.*.streams[index]) }
}

fn askedAt(sound: *Sound, index: usize) -> *Asked {
    unsafe { return @ptrCast(*Asked, &sound.*.asked[index]) }
}

fn appAt(sound: *Sound, index: usize) -> *App {
    unsafe { return @ptrCast(*App, &sound.*.apps[index]) }
}

fn sinkAt(sound: *Sound, index: usize) -> *Sink {
    unsafe { return @ptrCast(*Sink, &sound.*.sinks[index]) }
}


// `bytes` from `offset` on.
fn after(bytes: [*]u8, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(bytes) + offset) }
}

fn noTerminal() -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

// `config_directory`: where compositor.conf is (~/.config/mlx).
pub fn init(sound: *Sound, environment: [*][*]const u8, config_directory: []const u8) -> void {
    sound.*.environment = environment
    sound.*.connection = 0
    sound.*.connected = false
    sound.*.status = audio.NO_SERVER
    sound.*.control = false
    sound.*.outputLength = 0
    sound.*.inputLength = 0
    sound.*.deviceCount = 0
    sound.*.streamCount = 0
    sound.*.askedCount = 0
    sound.*.appCount = 0
    sound.*.sinkCount = 0
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &sound.*.ipcPath) }
    var length = copyInto(bytes, 230, config_directory)
    length += copyInto(after(bytes, length), 20, "/ipc.conf")
    sound.*.ipcPath[length] = 0
    sound.*.ipcPathLength = length
}

// Connects (once more, when it went) and reads the server's state; false
// when there is no server to read.
pub fn refresh(sound: *Sound, allocator: std.allocator.Allocator) -> bool {
    if sound.*.connection == 0 {
        const memory = allocator.alloc(@sizeOf(audio.Audio), 16)
        const state = allocator.alloc(STATE_SIZE, 16)
        if memory == null || state == null { return false }
        sound.*.connection = @intFromPtr(memory.?)
        sound.*.state = state.?
    }
    const connection = connectionOf(sound)
    if !sound.*.connected {
        sound.*.status = audio.connect(connection, allocator, sound.*.environment)
        sound.*.connected = sound.*.status == audio.OK
        if !sound.*.connected { return false }
    }
    const length = audio.status(connection, sound.*.state, STATE_SIZE, 1000)
    if length == 0 {
        if !connection.*.connected {
            sound.*.connected = false
            sound.*.status = audio.NO_SERVER
        }
        return false
    }
    parse(sound, sound.*.state[0..length])
    return true
}

// The tab-separated part `index` of `text`.
fn part(text: []const u8, index: usize) -> []const u8 {
    var at: usize = 0
    var count: usize = 0
    while count < index {
        while at < text.length && text[at] != 9 { at += 1 }
        if at >= text.length { return text[0..0] }
        at += 1
        count += 1
    }
    var end = at
    while end < text.length && text[end] != 9 { end += 1 }
    return text[at..end]
}

// STATE's lines into the fields.
fn parse(sound: *Sound, text: []const u8) -> void {
    sound.*.deviceCount = 0
    sound.*.streamCount = 0
    sound.*.askedCount = 0
    sound.*.appCount = 0
    sound.*.sinkCount = 0
    sound.*.control = false
    var bytes: [*]u8 = undefined
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        var equals: usize = 0
        while equals + 2 < line.length && !(line[equals] == 32 && line[equals + 1] == 61 && line[equals + 2] == 32) { equals += 1 }
        if equals + 2 < line.length || (equals + 2 == line.length) {
            const key = line[0..equals]
            const value = if equals + 3 <= line.length { line[equals + 3..line.length] } else { line[0..0] }
            if same(key, "control") { sound.*.control = same(value, "1") }
            if same(key, "output") {
                unsafe { bytes = @ptrCast([*]u8, &sound.*.output) }
                sound.*.outputLength = copyInto(bytes, 96, value)
            }
            if same(key, "input") {
                unsafe { bytes = @ptrCast([*]u8, &sound.*.input) }
                sound.*.inputLength = copyInto(bytes, 96, value)
            }
            if same(key, "output-problem") {
                unsafe { bytes = @ptrCast([*]u8, &sound.*.outputProblem) }
                sound.*.outputProblemLength = copyInto(bytes, 16, value)
            }
            if same(key, "input-problem") {
                unsafe { bytes = @ptrCast([*]u8, &sound.*.inputProblem) }
                sound.*.inputProblemLength = copyInto(bytes, 16, value)
            }
            if same(key, "holder") {
                unsafe { bytes = @ptrCast([*]u8, &sound.*.holder) }
                sound.*.holderLength = copyInto(bytes, 64, value)
            }
            if same(key, "volume") { sound.*.volume = number(value) }
            if same(key, "mute") { sound.*.mute = same(value, "1") }
            if same(key, "input-volume") { sound.*.inputVolume = number(value) }
            if same(key, "input-mute") { sound.*.inputMute = same(value, "1") }
            if same(key, "device") && sound.*.deviceCount < MAX_DEVICES {
                const device = deviceAt(sound, sound.*.deviceCount)
                device.*.capture = same(part(value, 0), "c")
                unsafe { bytes = @ptrCast([*]u8, &device.*.name) }
                device.*.nameLength = copyInto(bytes, 32, part(value, 1))
                unsafe { bytes = @ptrCast([*]u8, &device.*.label) }
                device.*.labelLength = copyInto(bytes, 96, part(value, 2))
                sound.*.deviceCount += 1
            }
            if same(key, "stream") && sound.*.streamCount < MAX_STREAMS {
                const stream = streamAt(sound, sound.*.streamCount)
                stream.*.id = number(part(value, 0))
                unsafe { bytes = @ptrCast([*]u8, &stream.*.app) }
                stream.*.appLength = copyInto(bytes, 64, part(value, 1))
                stream.*.record = same(part(value, 2), "record")
                stream.*.volume = number(part(value, 3))
                unsafe { bytes = @ptrCast([*]u8, &stream.*.name) }
                stream.*.nameLength = copyInto(bytes, 64, part(value, 5))
                sound.*.streamCount += 1
            }
            if same(key, "app") && sound.*.appCount < MAX_APPS {
                const app = appAt(sound, sound.*.appCount)
                unsafe { bytes = @ptrCast([*]u8, &app.*.name) }
                app.*.nameLength = copyInto(bytes, 64, part(value, 0))
                app.*.volume = number(part(value, 1))
                app.*.mute = same(part(value, 2), "1")
                unsafe { bytes = @ptrCast([*]u8, &app.*.sink) }
                app.*.sinkLength = copyInto(bytes, 32, part(value, 3))
                sound.*.appCount += 1
            }
            if same(key, "sink") && sound.*.sinkCount < MAX_SINKS {
                const sink = sinkAt(sound, sound.*.sinkCount)
                unsafe { bytes = @ptrCast([*]u8, &sink.*.name) }
                sink.*.nameLength = copyInto(bytes, 32, part(value, 0))
                sink.*.output = same(part(value, 1), "output")
                sink.*.volume = number(part(value, 2))
                sink.*.mute = same(part(value, 3), "1")
                sound.*.sinkCount += 1
            }
            if same(key, "asked") && sound.*.askedCount < MAX_ASKED && same(part(value, 1), "record") {
                const asked = askedAt(sound, sound.*.askedCount)
                unsafe { bytes = @ptrCast([*]u8, &asked.*.app) }
                asked.*.appLength = copyInto(bytes, 96, part(value, 0))
                asked.*.record = true
                asked.*.allowed = same(part(value, 2), "1")
                sound.*.askedCount += 1
            }
        }
        at = end + 1
    }
}

fn outputOf(sound: *Sound) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &sound.*.output) }
    return bytes[0..sound.*.outputLength]
}

fn inputOf(sound: *Sound) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &sound.*.input) }
    return bytes[0..sound.*.inputLength]
}

fn problemOf(sound: *Sound, input: bool) -> []const u8 {
    var bytes: [*]const u8 = undefined
    if input {
        unsafe { bytes = @ptrCast([*]const u8, &sound.*.inputProblem) }
        return bytes[0..sound.*.inputProblemLength]
    }
    unsafe { bytes = @ptrCast([*]const u8, &sound.*.outputProblem) }
    return bytes[0..sound.*.outputProblemLength]
}

fn set(sound: *Sound, what: u32, value: u32, target: u32, text: []const u8) -> void {
    if !sound.*.connected { return }
    if !audio.set(connectionOf(sound), what, value, target, text) { sound.*.connected = false }
}

// "alsa:" and a device's name.
fn deviceSpec(device: *Device, out: [*]u8) -> []const u8 {
    var length = copyInto(out, 5, "alsa:")
    var name: [*]const u8 = undefined
    unsafe { name = @ptrCast([*]const u8, &device.*.name) }
    length += copyInto(after(out, length), 32, name[0..device.*.nameLength])
    return out[0..length]
}

// The choices of an output or input: automatic, each card's device, none.
fn devices(sound: *Sound, page: *Page, y: i32, capture: bool) -> i32 {
    const base = if capture { ITEM_INPUT } else { ITEM_OUTPUT }
    const current = if capture { inputOf(sound) } else { outputOf(sound) }
    const none = if capture { "none" } else { "null" }
    var at = y
    if page_module.choiceRow(page, at, base, page_module.say(page, "Automatic (the first sound card)", "Automatisch (die erste Soundkarte)"), same(current, "auto")) { choose(sound, capture, "auto") }
    at += page_module.px(page, page_module.CHOICE_ROW)
    var spec: [48]u8 = undefined
    var spec_bytes: [*]u8 = undefined
    unsafe { spec_bytes = @ptrCast([*]u8, &spec) }
    var index: usize = 0
    while index < sound.*.deviceCount {
        const device = deviceAt(sound, index)
        if device.*.capture == capture {
            const wanted = deviceSpec(device, spec_bytes)
            var label: [*]const u8 = undefined
            unsafe { label = @ptrCast([*]const u8, &device.*.label) }
            if page_module.choiceRow(page, at, base + 1 + index, label[0..device.*.labelLength], same(current, wanted)) { choose(sound, capture, wanted) }
            at += page_module.px(page, page_module.CHOICE_ROW)
        }
        index += 1
    }
    if page_module.choiceRow(page, at, base + 99, if capture { page_module.say(page, "None (silence)", "Keiner (Stille)") } else { page_module.say(page, "None (muted)", "Keine (stumm)") }, same(current, none)) { choose(sound, capture, none) }
    at += page_module.px(page, page_module.CHOICE_ROW)
    const problem = problemOf(sound, capture)
    if same(problem, "busy") {
        var holder: [*]const u8 = undefined
        unsafe { holder = @ptrCast([*]const u8, &sound.*.holder) }
        var text: [200]u8 = undefined
        var text_bytes: [*]u8 = undefined
        unsafe { text_bytes = @ptrCast([*]u8, &text) }
        var length = copyInto(text_bytes, 120, page_module.say(page, "The sound card is busy", "Die Soundkarte ist belegt"))
        if sound.*.holderLength > 0 {
            length += copyInto(after(text_bytes, length), 4, " (")
            length += copyInto(after(text_bytes, length), 40, holder[0..sound.*.holderLength])
            length += copyInto(after(text_bytes, length), 2, ")")
        }
        length += copyInto(after(text_bytes, length), 70, page_module.say(page, "; MLX Audio takes it once free.", "; MLX Audio übernimmt sie, sobald sie frei ist."))
        at = page_module.note(page, at, text_bytes[0..length])
    } else if same(problem, "missing") {
        at = page_module.note(page, at, page_module.say(page, "No sound card found; MLX Audio waits for one.", "Keine Soundkarte gefunden; MLX Audio wartet auf eine."))
    }
    return at
}

fn choose(sound: *Sound, capture: bool, spec: []const u8) -> void {
    set(sound, if capture { audio.SET_INPUT } else { audio.SET_OUTPUT }, 0, 0, spec)
    var bytes: [*]u8 = undefined
    if capture {
        unsafe { bytes = @ptrCast([*]u8, &sound.*.input) }
        sound.*.inputLength = copyInto(bytes, 96, spec)
    } else {
        unsafe { bytes = @ptrCast([*]u8, &sound.*.output) }
        sound.*.outputLength = copyInto(bytes, 96, spec)
    }
}

// The microphone permission of `app`: its rule in ipc.conf (a rule of
// the same form for it goes), then the server checks its streams again.
fn allowMicrophone(sound: *Sound, app: []const u8, allowed: bool, allocator: std.allocator.Allocator) -> void {
    var path: [*]const u8 = undefined
    unsafe { path = @ptrCast([*]const u8, &sound.*.ipcPath) }
    const capacity: usize = 65536
    const old = allocator.alloc(capacity, 16)
    const new = allocator.alloc(capacity + 512, 16)
    if old == null || new == null { return }
    var length: usize = 0
    const file = std.fs.open(path, 524288, 0)
    if file.descriptor >= 0 {
        while length < capacity {
            const got = std.fs.read(file, after(old.?, length), capacity - length)
            if got <= 0 { break }
            length += @intCast(usize, got)
        }
        const closed = std.fs.close(file)
    }
    var written: usize = 0
    var at: usize = 0
    while at < length {
        var end = at
        while end < length && old.?[end] != 10 { end += 1 }
        const line = old.?[at..end]
        var mine = false
        const kinds = [2][]const u8{ "allow ", "deny " }
        var kind: usize = 0
        while kind < 2 {
            const prefix = kinds[kind]
            if startsWith(line, prefix) && line.length == prefix.length + app.length + 17 && same(line[prefix.length..prefix.length + app.length], app) && same(line[prefix.length + app.length..line.length], " use audio.record") { mine = true }
            kind += 1
        }
        if !mine {
            written += copyInto(after(new.?, written), end - at, line)
            new.?[written] = 10
            written += 1
        }
        at = end + 1
    }
    written += copyInto(after(new.?, written), 6, if allowed { "allow " } else { "deny " })
    written += copyInto(after(new.?, written), 128, app)
    written += copyInto(after(new.?, written), 18, " use audio.record\n")
    var temporary: [264]u8 = undefined
    var temporary_bytes: [*]u8 = undefined
    unsafe { temporary_bytes = @ptrCast([*]u8, &temporary) }
    var path_length = copyInto(temporary_bytes, 250, path[0..sound.*.ipcPathLength])
    path_length += copyInto(after(temporary_bytes, path_length), 4, ".new")
    temporary[path_length] = 0
    // O_WRONLY | O_CREAT | O_TRUNC
    const out = std.fs.open(temporary_bytes, 577, 420)
    if out.descriptor >= 0 {
        const done = std.fs.writeAllBytes(out, new.?, written)
        const closed = std.fs.close(out)
        if done { const renamed = std.fs.rename(temporary_bytes, path) }
    }
    allocator.free(old.?, capacity, 16)
    allocator.free(new.?, capacity + 512, 16)
    // The bus reads the file again (inotify); the server asks it again.
    var pause: [2]usize = [2]usize{ 0, 200000000 }
    const slept = std.linux.syscall2(35, @intFromPtr(&pause), 0)
    set(sound, audio.SET_RECHECK, 0, 0, "")
}

// Whether one of `app`'s streams records now.
fn records(sound: *Sound, app: []const u8) -> bool {
    var index: usize = 0
    while index < sound.*.streamCount {
        const stream = streamAt(sound, index)
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrCast([*]const u8, &stream.*.app) }
        if stream.*.record && same(bytes[0..stream.*.appLength], app) { return true }
        index += 1
    }
    return false
}

// Routes `app` to the sink after its current one (the default sink after
// the last).
fn routeNext(sound: *Sound, app: *App) -> void {
    var sink_bytes: [*]u8 = undefined
    unsafe { sink_bytes = @ptrCast([*]u8, &app.*.sink) }
    const current = sink_bytes[0..app.*.sinkLength]
    var next: usize = 0
    if current.length > 0 {
        var index: usize = 0
        while index < sound.*.sinkCount {
            const sink = sinkAt(sound, index)
            var name: [*]const u8 = undefined
            unsafe { name = @ptrCast([*]const u8, &sink.*.name) }
            if same(name[0..sink.*.nameLength], current) { next = index + 2 }
            index += 1
        }
    } else {
        next = 1
    }
    // next: 0 the default sink, i + 1 the sink at i.
    if next > sound.*.sinkCount { next = 0 }
    var message: [128]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &message) }
    var name_bytes: [*]const u8 = undefined
    unsafe { name_bytes = @ptrCast([*]const u8, &app.*.name) }
    var length = copyInto(bytes, 64, name_bytes[0..app.*.nameLength])
    bytes[length] = 9
    length += 1
    if next == 0 {
        app.*.sinkLength = 0
    } else {
        const sink = sinkAt(sound, next - 1)
        var name: [*]const u8 = undefined
        unsafe { name = @ptrCast([*]const u8, &sink.*.name) }
        length += copyInto(after(bytes, length), 32, name[0..sink.*.nameLength])
        app.*.sinkLength = copyInto(sink_bytes, 32, name[0..sink.*.nameLength])
    }
    set(sound, audio.SET_APP_SINK, 0, 0, bytes[0..length])
}

// The page; the y after it.
pub fn draw(sound: *Sound, page: *Page, top: i32, allocator: std.allocator.Allocator) -> i32 {
    var y = top
    if !sound.*.connected {
        y = page_module.section(page, y, "MLX Audio")
        const why = if sound.*.status == audio.NO_BUS { page_module.say(page, "There is no session bus (MLX Audio runs on MLXIPC: the desktop session starts mlx-ipcd).", "Es gibt keinen Sitzungsbus (MLX Audio läuft auf MLXIPC: die Desktop-Sitzung startet mlx-ipcd).") } else if sound.*.status == audio.NOT_ALLOWED { page_module.say(page, "This app may not talk to MLX Audio (MLXIPC permissions).", "Diese App darf nicht mit MLX Audio sprechen (MLXIPC-Rechte).") } else { page_module.say(page, "MLX Audio is not running (mlx-audiod; it starts when an app first wants sound).", "MLX Audio läuft nicht (mlx-audiod; es startet, sobald eine App Ton möchte).") }
        y = page_module.note(page, y, why)
        if page_module.buttonRow(page, y, ITEM_RETRY, page_module.say(page, "Try again", "Erneut versuchen")) { const again = refresh(sound, allocator) }
        return y + page_module.px(page, 40)
    }
    if !sound.*.control {
        y = page_module.section(page, y, "MLX Audio")
        return page_module.note(page, y, page_module.say(page, "This app may not change MLX Audio (MLXIPC permission audio.control).", "Diese App darf MLX Audio nicht ändern (MLXIPC-Recht audio.control)."))
    }
    y = page_module.section(page, y, page_module.say(page, "Output", "Ausgabe"))
    var card = y
    y = page_module.cardBegin(page, y, "output")
    y = devices(sound, page, y, false)
    const volume = page_module.sliderRow(page, y, ITEM_VOLUME, page_module.say(page, "Volume", "Lautstärke"), sound.*.volume, 65536, 65536)
    if volume != sound.*.volume {
        sound.*.volume = volume
        set(sound, audio.SET_VOLUME, volume, 0, "")
    }
    y += page_module.px(page, page_module.SLIDER_ROW)
    if page_module.switchRow(page, y, ITEM_MUTE, page_module.say(page, "Mute", "Stumm"), page_module.say(page, "Nothing is heard; the apps play on", "Nichts ist zu hören; die Apps spielen weiter"), sound.*.mute) {
        sound.*.mute = !sound.*.mute
        set(sound, audio.SET_MUTE, if sound.*.mute { 1 } else { 0 }, 0, "")
    }
    y += page_module.px(page, page_module.SWITCH_ROW)
    if page_module.buttonRow(page, y, ITEM_TEST, page_module.say(page, "Test tone", "Testton")) { apps_module.run("mlx-audio tone 523 1", noTerminal(), sound.*.environment) }
    y += page_module.px(page, 42)
    y = page_module.cardEnd(page, card, y, "output")

    y = page_module.section(page, y, page_module.say(page, "Input", "Eingang"))
    card = y
    y = page_module.cardBegin(page, y, "input")
    y = devices(sound, page, y, true)
    const input_volume = page_module.sliderRow(page, y, ITEM_INPUT_VOLUME, page_module.say(page, "Input volume", "Eingangslautstärke"), sound.*.inputVolume, 65536, 65536)
    if input_volume != sound.*.inputVolume {
        sound.*.inputVolume = input_volume
        set(sound, audio.SET_INPUT_VOLUME, input_volume, 0, "")
    }
    y += page_module.px(page, page_module.SLIDER_ROW)
    if page_module.switchRow(page, y, ITEM_INPUT_MUTE, page_module.say(page, "Microphone off", "Mikrofon aus"), page_module.say(page, "Recordings get silence", "Aufnahmen bekommen Stille"), sound.*.inputMute) {
        sound.*.inputMute = !sound.*.inputMute
        set(sound, audio.SET_INPUT_MUTE, if sound.*.inputMute { 1 } else { 0 }, 0, "")
    }
    y += page_module.px(page, page_module.SWITCH_ROW)
    y = page_module.cardEnd(page, card, y, "input")

    y = page_module.section(page, y, page_module.say(page, "Apps", "Apps"))
    card = y
    y = page_module.cardBegin(page, y, "apps")
    if sound.*.appCount == 0 { y = page_module.note(page, y, page_module.say(page, "No app has played since MLX Audio started.", "Seit dem Start von MLX Audio hat keine App gespielt.")) }
    var index: usize = 0
    var label: [160]u8 = undefined
    var label_bytes: [*]u8 = undefined
    unsafe { label_bytes = @ptrCast([*]u8, &label) }
    while index < sound.*.appCount {
        const app = appAt(sound, index)
        var name_bytes: [*]const u8 = undefined
        unsafe { name_bytes = @ptrCast([*]const u8, &app.*.name) }
        const name = name_bytes[0..app.*.nameLength]
        var length = copyInto(label_bytes, 64, name)
        if records(sound, name) { length += copyInto(after(label_bytes, length), 20, page_module.say(page, " (recording)", " (nimmt auf)")) }
        if app.*.mute { length += copyInto(after(label_bytes, length), 20, page_module.say(page, " (muted)", " (stumm)")) }
        const now = page_module.sliderRow(page, y, ITEM_APP + index, label_bytes[0..length], app.*.volume, 65536, 65536)
        if now != app.*.volume {
            app.*.volume = now
            set(sound, audio.SET_APP_VOLUME, now, 0, name)
        }
        y += page_module.px(page, page_module.SLIDER_ROW)
        // Where it plays: a click takes the next sink.
        if sound.*.sinkCount > 0 {
            var sink_bytes: [*]const u8 = undefined
            unsafe { sink_bytes = @ptrCast([*]const u8, &app.*.sink) }
            const sink = sink_bytes[0..app.*.sinkLength]
            if page_module.valueRow(page, y, ITEM_APP_SINK + index, page_module.say(page, "Plays to", "Spielt auf"), if sink.length == 0 { page_module.say(page, "Default", "Standard") } else { sink }) { routeNext(sound, app) }
            y += page_module.px(page, page_module.VALUE_ROW)
        }
        index += 1
    }
    y = page_module.cardEnd(page, card, y, "apps")
    if sound.*.sinkCount > 0 {
        y = page_module.section(page, y, page_module.say(page, "Virtual outputs", "Virtuelle Ausgänge"))
        card = y
        y = page_module.cardBegin(page, y, "sinks")
        index = 0
        while index < sound.*.sinkCount {
            const sink = sinkAt(sound, index)
            var name_bytes: [*]const u8 = undefined
            unsafe { name_bytes = @ptrCast([*]const u8, &sink.*.name) }
            var length = copyInto(label_bytes, 32, name_bytes[0..sink.*.nameLength])
            length += copyInto(after(label_bytes, length), 60, if sink.*.output { page_module.say(page, " (to the output)", " (zur Ausgabe)") } else { page_module.say(page, " (recordable only)", " (nur aufnehmbar)") })
            const now = page_module.sliderRow(page, y, ITEM_SINK + index, label_bytes[0..length], sink.*.volume, 65536, 65536)
            if now != sink.*.volume {
                sink.*.volume = now
                set(sound, audio.SET_SINK_VOLUME, now, 0, name_bytes[0..sink.*.nameLength])
            }
            y += page_module.px(page, page_module.SLIDER_ROW)
            index += 1
        }
        y = page_module.cardEnd(page, card, y, "sinks")
    }
    y = page_module.note(page, y, page_module.say(page, "mlx-audio sink add NAME adds a virtual output; recordings can take what plays to it.", "mlx-audio sink add NAME legt einen virtuellen Ausgang an; Aufnahmen können mitschneiden, was dorthin spielt."))

    y = page_module.section(page, y, page_module.say(page, "Microphone access", "Mikrofonzugriff"))
    card = y
    y = page_module.cardBegin(page, y, "microphone")
    if sound.*.askedCount == 0 { y = page_module.note(page, y, page_module.say(page, "No app has asked to record yet.", "Noch keine App wollte aufnehmen.")) }
    index = 0
    while index < sound.*.askedCount {
        const asked = askedAt(sound, index)
        var app: [*]const u8 = undefined
        unsafe { app = @ptrCast([*]const u8, &asked.*.app) }
        const name = app[0..asked.*.appLength]
        if page_module.switchRow(page, y, ITEM_MICROPHONE + index, name, if asked.*.allowed { page_module.say(page, "May record", "Darf aufnehmen") } else { page_module.say(page, "May not record", "Darf nicht aufnehmen") }, asked.*.allowed) {
            asked.*.allowed = !asked.*.allowed
            allowMicrophone(sound, name, asked.*.allowed, allocator)
        }
        y += page_module.px(page, page_module.SWITCH_ROW)
        index += 1
    }
    y = page_module.cardEnd(page, card, y, "microphone")
    return page_module.note(page, y, page_module.say(page, "Sandboxed apps (Flatpak) need the permission; others have it until it is taken.", "Apps in einer Sandbox (Flatpak) brauchen die Erlaubnis; andere haben sie, bis sie entzogen wird."))
}
