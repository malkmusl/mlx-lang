// Light or dark for the whole desktop, from the Appearance page: the
// Settings portal's org.mlx.Appearance.SetColorScheme on the session bus
// (GTK, Qt and Firefox hear SettingChanged from it; it writes
// appearance.conf, which every app of the desktop follows through
// std.ui.appearance). Without the portal the file is written here.
const std = @import("std")
const dbus = @import("std.dbus")
const config_file = @import("../shared/config_file.mlx")

const PORTAL: []const u8 = "org.freedesktop.portal.Desktop"
const PATH: []const u8 = "/org/freedesktop/portal/desktop"
const INTERFACE: []const u8 = "org.mlx.Appearance"
// org.freedesktop.appearance's color-scheme: 1 dark, 2 light.
const SCHEME_DARK: u32 = 1
const SCHEME_LIGHT: u32 = 2

// Asks for the light look (or the dark one); false when neither the
// portal nor the file took it.
pub fn choose(environment: [*][*]const u8, light: bool, allocator: std.allocator.Allocator) -> bool {
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    if memory != null {
        const client: *dbus.Client = unsafe { @ptrCast(*dbus.Client, memory.?) }
        var taken = false
        if dbus.connectSession(client, allocator, environment) {
            var body: [8]u8 = undefined
            const bytes: [*]u8 = &body
            var writing: dbus.Writer = undefined
            dbus.begin(&writing, bytes, 8, false)
            dbus.putU32(&writing, if light { SCHEME_LIGHT } else { SCHEME_DARK })
            const serial = dbus.call(client, PORTAL, PATH, INTERFACE, "SetColorScheme", "u", bytes, writing.length)
            var reply: dbus.Header = undefined
            taken = serial != 0 && dbus.waitReply(client, serial, &reply, 1000) && reply.kind != dbus.ERROR
            dbus.disconnect(client, allocator)
        }
        allocator.free(memory.?, @sizeOf(dbus.Client), 16)
        if taken { return true }
    }
    return config_file.set(environment, "appearance.conf", "color-scheme", if light { "light" } else { "dark" }, allocator)
}
