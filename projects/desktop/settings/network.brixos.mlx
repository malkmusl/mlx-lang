// The Network page on brixOS: what the kernel says. Here the kernel runs
// the network (the card's driver, DHCP or the address of the file
// /system/settings/network, the stack: projects/brix/kernel/net), so
// there is no nexus and no bus to ask. Every link is a node, /devices/net0
// and on, whose read gives its state (std.os.brix's networkLink; the
// record is spec/04-stdlib/os/brix.xml's NetworkLink): its driver and
// hardware address, whether the cable is in, the address with its prefix
// length, the gateway, the name server, whether DHCP or the settings gave
// them, and the frames counted. The page shows that and reads it again
// every two seconds while it is shown. What it shows goes to stderr once
// each time it changes ("control: network: ...", a line a link; the
// frame counts aside).
//
// The same interface as network.mlx (Linux's page: nexus over the system
// bus), in whose place the compiler takes this file for brixOS. Nothing
// is changed from here yet: the kernel reads its settings file at boot.
const std = @import("std")
const brix = std.os.brix
const view = @import("std.ui.view")
const popup = @import("std.ui.popup")
const controls = @import("std.ui.controls")
const page_module = @import("./page.mlx")

const Page = page_module.Page

pub const MAX_LINKS: usize = 8
// The page reads the links again this often while it is shown (ms).
pub const TICK: usize = 2000

// The most one link's line on stderr takes, and all of them.
const TOLD_LINE: usize = 160
const TOLD: usize = 1280

pub const Network = struct {
    // The links as they were read last.
    links: [8]brix.NetworkLink
    linkCount: usize
    // What stderr was told last (so it is told again only when it
    // changes), and whether it was told anything yet.
    told: [1280]u8
    toldLength: usize
    toldOnce: bool
}

// ---------------------------------------------------------------------------
// Field access

fn bytesAt(base: usize, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, base + offset) }
}

fn linkAt(network: *Network, index: usize) -> *brix.NetworkLink {
    unsafe { return @ptrFromInt(*brix.NetworkLink, @intFromPtr(network) + @offsetOf(Network, "links") + index * @sizeOf(brix.NetworkLink)) }
}

fn toldOf(network: *Network) -> [*]u8 { return bytesAt(@intFromPtr(network), @offsetOf(Network, "told")) }

// ---------------------------------------------------------------------------
// Text

// "net0" after `at`; the new length.
fn putName(into: [*]u8, at: usize, capacity: usize, index: usize) -> usize {
    return std.text.appendUnsigned(into, std.text.append(into, at, capacity, "net"), capacity, index)
}

// "a.b.c.d" after `at`; the new length.
fn putAddress(into: [*]u8, at: usize, capacity: usize, address: [4]u8) -> usize {
    var length = at
    var part: usize = 0
    while part < 4 {
        if part > 0 { length = std.text.appendByte(into, length, capacity, 46) }
        length = std.text.appendUnsigned(into, length, capacity, @intCast(usize, address[part]))
        part += 1
    }
    return length
}

// The hardware address, "52:54:00:12:34:56", after `at`; the new length.
fn putHardware(into: [*]u8, at: usize, capacity: usize, link: *const brix.NetworkLink) -> usize {
    const digits = "0123456789abcdef"
    var length = at
    var part: usize = 0
    while part < 6 {
        if part > 0 { length = std.text.appendByte(into, length, capacity, 58) }
        length = std.text.appendByte(into, length, capacity, digits[@intCast(usize, link.*.hardware[part] >> 4)])
        length = std.text.appendByte(into, length, capacity, digits[@intCast(usize, link.*.hardware[part] & 15)])
        part += 1
    }
    return length
}

// A netmask's prefix length (255.255.255.0: 24).
fn prefixOf(mask: [4]u8) -> usize {
    var bits: usize = 0
    var part: usize = 0
    while part < 4 {
        var byte = mask[part]
        while byte & 0x80 != 0 {
            bits += 1
            byte = byte << 1
        }
        part += 1
    }
    return bits
}

// "10.0.2.15/24" after `at`; the new length.
fn putAddressWithPrefix(into: [*]u8, at: usize, capacity: usize, link: *const brix.NetworkLink) -> usize {
    var length = putAddress(into, at, capacity, link.*.address)
    length = std.text.appendByte(into, length, capacity, 47)
    return std.text.appendUnsigned(into, length, capacity, prefixOf(link.*.mask))
}

fn driverOf(link: *const brix.NetworkLink) -> []const u8 {
    return bytesAt(@intFromPtr(link), @offsetOf(brix.NetworkLink, "driver"))[0..link.*.driverLength]
}

// ---------------------------------------------------------------------------
// The kernel's links

pub fn init(network: *Network, environment: [*][*]const u8) -> void {
    _ = environment
    network.*.linkCount = 0
    network.*.toldLength = 0
    network.*.toldOnce = false
}

// (Linux's page opens with a Wi-Fi network chosen; there is none here.)
pub fn choose(network: *Network, ssid: []const u8) -> void {
    _ = network
    _ = ssid
}

// A link's line for stderr after `at`; the new length.
fn tellLink(into: [*]u8, at: usize, capacity: usize, index: usize, link: *const brix.NetworkLink) -> usize {
    var length = std.text.append(into, at, capacity, "control: network: ")
    length = putName(into, length, capacity, index)
    length = std.text.append(into, length, capacity, " (")
    length = std.text.append(into, length, capacity, driverOf(link))
    length = std.text.append(into, length, capacity, ", ")
    length = putHardware(into, length, capacity, link)
    length = std.text.append(into, length, capacity, if link.*.up { ") connected, " } else { ") no cable, " })
    if link.*.configured == brix.NetworkLink.NONE {
        length = std.text.append(into, length, capacity, if link.*.asking { "no address yet (DHCP is asking)" } else { "no address" })
    } else {
        length = putAddressWithPrefix(into, length, capacity, link)
        length = std.text.append(into, length, capacity, if link.*.configured == brix.NetworkLink.DHCP { " by DHCP, gateway " } else { " from the settings, gateway " })
        length = putAddress(into, length, capacity, link.*.gateway)
        length = std.text.append(into, length, capacity, ", name server ")
        length = putAddress(into, length, capacity, link.*.nameServer)
    }
    return std.text.append(into, length, capacity, "\n")
}

// Says what the page shows on stderr when it is not what was said last.
fn tell(network: *Network) -> void {
    var text: [1280]u8 = undefined
    const bytes: [*]u8 = &text
    var length: usize = 0
    var index: usize = 0
    while index < network.*.linkCount {
        length = tellLink(bytes, length, length + TOLD_LINE, index, linkAt(network, index))
        index += 1
    }
    if network.*.linkCount == 0 { length = std.text.append(bytes, 0, TOLD, "control: network: no links (the kernel found no network device)\n") }
    if network.*.toldOnce && std.text.same(bytes[0..length], toldOf(network)[0..network.*.toldLength]) { return }
    network.*.toldOnce = true
    network.*.toldLength = std.text.append(toldOf(network), 0, TOLD, bytes[0..length])
    _ = std.io.eprint(bytes[0..length])
}

// The links read again from the kernel (net0, net1, ... until one is not
// there); true always: the kernel answers at once.
pub fn refresh(network: *Network, allocator: std.allocator.Allocator) -> bool {
    _ = allocator
    var count: usize = 0
    while count < MAX_LINKS && brix.networkLink(count, linkAt(network, count)) == 0 { count += 1 }
    network.*.linkCount = count
    tell(network)
    return true
}

// (No field takes keys on this page.)
pub fn key(network: *Network, context: *view.Ui, code: u32, modifiers: u32, typed: []const u8, allocator: std.allocator.Allocator) -> bool {
    _ = network
    _ = context
    _ = code
    _ = modifiers
    _ = typed
    _ = allocator
    return false
}

// ---------------------------------------------------------------------------
// The page

// `text` wrapped in small dim text (six lines at most, for a narrow
// window); the y after it.
fn wrapped(page: *const Page, y: i32, text: []const u8) -> i32 {
    const line = page_module.px(page, 18)
    const lines = popup.wrapped(page.*.ui, page.*.small, text, page.*.left, y, page.*.width, line, 6, page.*.theme.*.dim)
    return y + @intCast(i32, lines) * line + page_module.px(page, 4)
}

// A link's first row: its name on the left, in the text's colour, and
// how it is on the right; the y after it.
fn headRow(page: *const Page, y: i32, name: []const u8, value: []const u8) -> i32 {
    const half = page.*.width * 2 / 5
    controls.label(page.*.ui, page.*.body, name, page.*.left, y + page_module.px(page, 6), page.*.theme.*.text, half)
    controls.label(page.*.ui, page.*.body, value, page.*.left + half, y + page_module.px(page, 6), page.*.theme.*.text, page.*.width - half)
    return y + page_module.px(page, 30)
}

// One link's rows; the y after them.
fn drawLink(page: *const Page, top: i32, index: usize, link: *const brix.NetworkLink) -> i32 {
    var name: [32]u8 = undefined
    const name_bytes: [*]u8 = &name
    var name_length = putName(name_bytes, 0, 32, index)
    name_length = std.text.append(name_bytes, name_length, 32, " · ")
    name_length = std.text.append(name_bytes, name_length, 32, page_module.say(page, "Cable", "Kabel"))
    var value: [96]u8 = undefined
    const bytes: [*]u8 = &value
    // Connected or not, and how fast when the card says so.
    var length = std.text.append(bytes, 0, 96, if link.*.up { page_module.say(page, "Connected", "Verbunden") } else { page_module.say(page, "No cable", "Kein Kabel") })
    if link.*.up && link.*.speed > 0 {
        length = std.text.append(bytes, length, 96, " · ")
        length = std.text.appendUnsigned(bytes, length, 96, @intCast(usize, link.*.speed))
        length = std.text.append(bytes, length, 96, " Mbit/s")
    }
    var y = headRow(page, top, name_bytes[0..name_length], bytes[0..length])
    // The address with its prefix length and where it is from, then the
    // gateway and the name server it came with.
    if link.*.configured == brix.NetworkLink.NONE {
        y = page_module.infoRow(page, y, page_module.say(page, "Address", "Adresse"), if link.*.asking { page_module.say(page, "None yet · DHCP is asking", "Noch keine · DHCP fragt an") } else { page_module.say(page, "None", "Keine") })
    } else {
        length = putAddressWithPrefix(bytes, 0, 96, link)
        length = std.text.append(bytes, length, 96, " · ")
        length = std.text.append(bytes, length, 96, if link.*.configured == brix.NetworkLink.DHCP { page_module.say(page, "by DHCP", "per DHCP") } else { page_module.say(page, "from the settings", "aus den Einstellungen") })
        y = page_module.infoRow(page, y, page_module.say(page, "Address", "Adresse"), bytes[0..length])
        y = page_module.infoRow(page, y, page_module.say(page, "Gateway", "Gateway"), bytes[0..putAddress(bytes, 0, 96, link.*.gateway)])
        y = page_module.infoRow(page, y, page_module.say(page, "Name server", "Nameserver"), bytes[0..putAddress(bytes, 0, 96, link.*.nameServer)])
    }
    y = page_module.infoRow(page, y, page_module.say(page, "Hardware address", "Hardware-Adresse"), bytes[0..putHardware(bytes, 0, 96, link)])
    y = page_module.infoRow(page, y, page_module.say(page, "Driver", "Treiber"), driverOf(link))
    length = std.text.appendUnsigned(bytes, 0, 96, link.*.received)
    length = std.text.append(bytes, length, 96, page_module.say(page, " received · ", " empfangen · "))
    length = std.text.appendUnsigned(bytes, length, 96, link.*.sent)
    length = std.text.append(bytes, length, 96, page_module.say(page, " sent", " gesendet"))
    return page_module.infoRow(page, y, page_module.say(page, "Frames", "Frames"), bytes[0..length])
}

pub fn draw(network: *Network, page: *const Page, top: i32, allocator: std.allocator.Allocator) -> i32 {
    _ = allocator
    var y = wrapped(page, top, page_module.say(page, "On brixOS the kernel runs the network: it drives the card and takes the address by DHCP, or from the file /system/settings/network. This page shows what the kernel says, read again every two seconds.", "Unter brixOS kümmert sich der Kernel um das Netz: Er steuert die Karte und holt die Adresse per DHCP oder aus der Datei /system/settings/network. Diese Seite zeigt, was der Kernel meldet, alle zwei Sekunden neu gelesen."))
    y = page_module.section(page, y, page_module.say(page, "Connections", "Verbindungen"))
    if network.*.linkCount == 0 {
        y = wrapped(page, y + page_module.px(page, 4), page_module.say(page, "No links: the kernel found no network card it drives (virtio, Intel igb).", "Keine Verbindungen: Der Kernel hat keine Netzwerkkarte gefunden, die er ansteuert (virtio, Intel igb)."))
    }
    var index: usize = 0
    while index < network.*.linkCount {
        if index > 0 { y += page_module.px(page, 8) }
        y = drawLink(page, y, index, linkAt(network, index))
        index += 1
    }
    // The settings file and what it takes, as the kernel reads it.
    y = page_module.section(page, y, page_module.say(page, "Fixed address", "Feste Adresse"))
    return wrapped(page, y, page_module.say(page, "For a fixed address, write the lines address, netmask, gateway and nameserver, each followed by its a.b.c.d, to /system/settings/network. The kernel reads the file when it starts and then does not ask by DHCP.", "Für eine feste Adresse die Zeilen address, netmask, gateway und nameserver, jeweils gefolgt von a.b.c.d, in /system/settings/network schreiben. Der Kernel liest die Datei beim Start und fragt dann nicht per DHCP."))
}
