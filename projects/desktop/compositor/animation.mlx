// Animations: the compositor shows what it does to windows moving
// instead of jumping (settings `animations = off`: all of it at once).
//
// - Gliding: a window the compositor puts somewhere (a tiling column laid
//   out or scrolled to, a snap, maximize and restore, tiling turned on or
//   off) moves there over GLIDE_MICROS, easing out (scene.eased);
//   windows.moveWindowTo goes along with it, so input, both renderers and
//   Xwayland see it where it is drawn. A window the user drags, or one
//   not shown, goes at once.
// - Sliding: switching workspaces slides the old one out and the new one
//   in from the side its number lies on (SLIDE_MICROS); a three-finger
//   swipe (gestures.mlx) pulls it in as the fingers go, sideways or up and
//   down, and lets it go on or spring back. The renderers
//   draw both, every window moved by its workspace's offset while they
//   compose (scene.shiftWindows); input and focus are on the new one at
//   once.
// - Leaving: a window moved to another workspace slides off this one
//   towards it.
// - The snap preview grows out of the dragged window, or out of the last
//   zone, and fades in (scene.snapRectNow).
// - Opening: a new window grows out of a slightly smaller rectangle and
//   fades in (the zoom the dock's stacks use: scene.zoomRect).
//
// The shell steps them after every frame (advance, from frameDone) and
// damages what they cover, so frames keep coming until they rest.
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const windows_module = @import("./windows.mlx")
const ui = @import("std.ui")

const Compositor = state.Compositor
const Surface = state.Surface

pub const GLIDE_MICROS: usize = 220000
pub const SLIDE_MICROS: usize = 300000
// A new window grows from this much of its size (in 1/1024).
const OPEN_SCALE: i32 = 880

// Where the window rests: where it glides to, else where it is (window
// coordinates).
pub fn restX(surface: *const Surface) -> i32 { return if surface.*.gliding { surface.*.glideToX } else { scene.windowX(surface) } }
pub fn restY(surface: *const Surface) -> i32 { return if surface.*.gliding { surface.*.glideToY } else { scene.windowY(surface) } }

// Puts the window at (x, y) (window coordinates): gliding there from
// where it is now, or at once when animations are off, it is not shown,
// the user drags it or it is fullscreen. A glide under way turns towards
// the new place from where it is.
pub fn glide(surface: *Surface, x: i32, y: i32) -> void {
    const compositor = surface.*.compositor
    const address = state.addressOfSurface(surface)
    if !compositor.*.animations || !surface.*.mapped || scene.hidden(address) || compositor.*.moving == address || surface.*.fullscreen {
        surface.*.gliding = false
        windows_module.moveWindowTo(surface, x, y)
        return
    }
    if surface.*.gliding && surface.*.glideToX == x && surface.*.glideToY == y { return }
    const from_x = scene.windowX(surface)
    const from_y = scene.windowY(surface)
    if from_x == x && from_y == y {
        surface.*.gliding = false
        return
    }
    surface.*.gliding = true
    surface.*.glideFromX = from_x
    surface.*.glideFromY = from_y
    surface.*.glideToX = x
    surface.*.glideToY = y
    surface.*.glideStart = state.microseconds()
    scene.damageSurface(compositor, surface)
}

// Leaves a glide where the window is (the user takes it, it goes away).
pub fn stop(surface: *Surface) -> void {
    surface.*.gliding = false
}

// Ends a glide at its end at once (a window just opened takes its place).
pub fn finish(surface: *Surface) -> void {
    if !surface.*.gliding { return }
    surface.*.gliding = false
    windows_module.moveWindowTo(surface, surface.*.glideToX, surface.*.glideToY)
}

// The workspace shown changed from `from` to `to`: the old one slides out,
// the new one in (from the right when its number is higher). A window
// still leaving is where it went. When fingers were pulling `to` in (a
// three-finger swipe let go: slideTracking), the slide goes on from there,
// the way they pulled it.
pub fn slide(compositor: *Compositor, from: usize, to: usize) -> void {
    endDepartures(compositor)
    if compositor.*.slideTracking && compositor.*.slideFrom == to {
        compositor.*.slideTracking = false
        startSlide(compositor, from, compositor.*.slideRight, compositor.*.slideVertical, compositor.*.slideProgress)
        return
    }
    compositor.*.slideTracking = false
    if from == to { return }
    startSlide(compositor, from, to > from, false, 0)
}

// A slide of the workspace shown in from the `positive` side (right, or
// below when `vertical`) and `from` out the other way, `base` of it (0 to
// 1024) done already.
fn startSlide(compositor: *Compositor, from: usize, positive: bool, vertical: bool, base: i32) -> void {
    if !compositor.*.animations {
        compositor.*.slideStart = 0
        compositor.*.slideOld = 0
        compositor.*.slideNew = 0
        scene.damageAll(compositor)
        return
    }
    compositor.*.slideFrom = from
    compositor.*.slideRight = positive
    compositor.*.slideVertical = vertical
    compositor.*.slideBase = base
    compositor.*.slideStart = state.microseconds()
    updateSlide(compositor, compositor.*.slideStart)
    compositor.*.shifting = true
    scene.damageAll(compositor)
}

// How long an animation `micros` long takes now (settings: slow).
fn lasting(compositor: *const Compositor, micros: usize) -> usize { return micros * compositor.*.animationScale }

// How far a slide goes: the output's width, or its height up and down.
fn slideDistance(compositor: *const Compositor) -> i32 {
    return @intCast(i32, if compositor.*.slideVertical { compositor.*.height } else { compositor.*.width })
}

// The two workspaces' offsets when `progress` (0 to 1024) of the slide is
// done: the incoming one (the workspace shown) comes from its side, the
// other goes out the opposite way.
fn placeSlide(compositor: *Compositor, progress: i32) -> void {
    const distance = slideDistance(compositor)
    const travelled = scene.between(0, distance, progress)
    const sign: i32 = if compositor.*.slideRight { 1 } else { -1 }
    compositor.*.slideNew = sign * (distance - travelled)
    compositor.*.slideOld = 0 - sign * travelled
}

fn updateSlide(compositor: *Compositor, now: usize) -> void {
    const t = scene.eased(now - compositor.*.slideStart, lasting(compositor, SLIDE_MICROS))
    placeSlide(compositor, compositor.*.slideBase + scene.between(0, 1024 - compositor.*.slideBase, t))
}

// Fingers pull workspace `peek` in from the `positive` side (`vertical`:
// up and down), `progress` (0 to 1024) of the way: the workspace shown
// moves aside as far. Nothing changes for input until they let go.
pub fn trackSlide(compositor: *Compositor, peek: usize, positive: bool, vertical: bool, progress: i32) -> void {
    endDepartures(compositor)
    compositor.*.slideTracking = true
    compositor.*.slideFrom = peek
    compositor.*.slideRight = positive
    compositor.*.slideVertical = vertical
    compositor.*.slideProgress = if progress < 0 { 0 } else if progress > 1024 { 1024 } else { progress }
    if compositor.*.slideStart == 0 { compositor.*.slideStart = state.microseconds() }
    // Pulled in: the peeked workspace is the one coming (slideOld goes
    // with slideFrom, slideNew with the workspace shown).
    const distance = slideDistance(compositor)
    const travelled = scene.between(0, distance, compositor.*.slideProgress)
    const sign: i32 = if positive { 1 } else { -1 }
    compositor.*.slideOld = sign * (distance - travelled)
    compositor.*.slideNew = 0 - sign * travelled
    compositor.*.shifting = true
    scene.damageAll(compositor)
}

// The fingers let go short of switching (or turned round): the pulled-in
// workspace slides back out and the one shown back into place.
pub fn springBack(compositor: *Compositor) -> void {
    if !compositor.*.slideTracking { return }
    compositor.*.slideTracking = false
    startSlide(compositor, compositor.*.slideFrom, !compositor.*.slideRight, compositor.*.slideVertical, 1024 - compositor.*.slideProgress)
}

// `surface` went to workspace `to`: it slides off this one towards that
// side (it is drawn while it goes: scene.shown).
pub fn depart(compositor: *Compositor, surface: *Surface, to: usize) -> void {
    if !compositor.*.animations || !surface.*.mapped || surface.*.minimized { return }
    surface.*.departStart = state.microseconds()
    surface.*.departRight = to > compositor.*.workspace
    surface.*.departOffset = 0
    compositor.*.shifting = true
    scene.damageAll(compositor)
}

fn endDepartures(compositor: *Compositor) -> void {
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        if surface.*.departStart != 0 {
            surface.*.departStart = 0
            surface.*.departOffset = 0
            scene.damageAll(compositor)
        }
        index += 1
    }
}

// The snap zone is about to change: the preview grows from where it is
// drawn now (from the dragged window when there was none).
pub fn snapFrom(compositor: *Compositor, dragged: *const Surface) -> void {
    if !compositor.*.animations {
        compositor.*.snapStart = 0
        return
    }
    const from = if compositor.*.snapZone != state.SNAP_NONE { scene.snapRectNow(compositor) } else { scene.restBounds(dragged) }
    compositor.*.snapFromX = from.x
    compositor.*.snapFromY = from.y
    compositor.*.snapFromWidth = from.width
    compositor.*.snapFromHeight = from.height
    compositor.*.snapStart = state.microseconds()
}

// What the snap preview may cover while it grows (to damage it).
pub fn snapBounds(compositor: *const Compositor) -> ui.Rect {
    const zone = scene.snapRect(compositor, compositor.*.snapZone)
    if compositor.*.snapStart == 0 { return zone }
    return scene.unionRect(zone, ui.rect(compositor.*.snapFromX, compositor.*.snapFromY, compositor.*.snapFromWidth, compositor.*.snapFromHeight))
}

// A window just mapped grows out of a slightly smaller rectangle around
// its middle (unless the dock's zoom has it already).
pub fn open(compositor: *Compositor, surface: *Surface) -> void {
    if !compositor.*.animations || surface.*.zooming { return }
    const rest = scene.restBounds(surface)
    if rest.width <= 0 || rest.height <= 0 { return }
    const width = rest.width * OPEN_SCALE / 1024
    const height = rest.height * OPEN_SCALE / 1024
    surface.*.zooming = true
    surface.*.zoomX = rest.x + (rest.width - width) / 2
    surface.*.zoomY = rest.y + (rest.height - height) / 2
    surface.*.zoomWidth = width
    surface.*.zoomHeight = height
    surface.*.zoomStart = state.microseconds()
}

// After every frame: windows glide on, a slide and windows leaving go on,
// the snap preview grows; what they cover is damaged.
pub fn advance(compositor: *Compositor) -> void {
    const now = state.microseconds()
    var shifting = false
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        index += 1
        if surface.*.gliding {
            const t = scene.eased(now - surface.*.glideStart, lasting(compositor, GLIDE_MICROS))
            if t >= 1024 {
                surface.*.gliding = false
                windows_module.moveWindowTo(surface, surface.*.glideToX, surface.*.glideToY)
            } else {
                windows_module.moveWindowTo(surface, scene.between(surface.*.glideFromX, surface.*.glideToX, t), scene.between(surface.*.glideFromY, surface.*.glideToY, t))
                // Frames go on while it glides, also when the ease's tail
                // moves it less than a pixel a frame (no damage of its own).
                scene.damageSurface(compositor, surface)
            }
        }
        if surface.*.departStart != 0 {
            scene.damageAll(compositor)
            const t = scene.eased(now - surface.*.departStart, lasting(compositor, SLIDE_MICROS))
            if t >= 1024 {
                surface.*.departStart = 0
                surface.*.departOffset = 0
            } else {
                const travelled = scene.between(0, @intCast(i32, compositor.*.width), t)
                surface.*.departOffset = if surface.*.departRight { travelled } else { 0 - travelled }
                shifting = true
            }
        }
    }
    if compositor.*.slideTracking {
        // Where the fingers have it.
        shifting = true
    } else if compositor.*.slideStart != 0 {
        scene.damageAll(compositor)
        if now - compositor.*.slideStart >= lasting(compositor, SLIDE_MICROS) {
            compositor.*.slideStart = 0
            compositor.*.slideOld = 0
            compositor.*.slideNew = 0
        } else {
            updateSlide(compositor, now)
            shifting = true
        }
    }
    compositor.*.shifting = shifting
    if compositor.*.snapStart != 0 {
        scene.damageRect(compositor, snapBounds(compositor))
        if now - compositor.*.snapStart >= lasting(compositor, scene.SNAP_MICROS) { compositor.*.snapStart = 0 }
    }
}
