// The session bus hears where the desktop is: WAYLAND_DISPLAY (and
// DISPLAY with Xwayland) join the environment of the services it starts
// on demand (org.freedesktop.DBus.UpdateActivationEnvironment), as
// sway's dbus-update-activation-environment does. mlx-session's bus
// (mlx-ipcd) runs before the compositor and starts mlx-notifyd, the
// portal (mlx-capture --portal) and the permission agent with its own
// environment, which has neither: without this they could not reach the
// compositor, and a notification never showed.
//
// Only for the desktop session (freestanding, or --session): a nested
// compositor inside another desktop must not point that desktop's
// services at itself.
const std = @import("std")
const dbus = @import("std.dbus")
const state = @import("./state.mlx")

const Compositor = state.Compositor

const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const BODY: usize = 1024

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 && length < 400 { length += 1 }
    return text[0..length]
}

// A KEY=value entry of the compositor's children's environment, if it
// is there.
fn put(writing: *dbus.Writer, compositor: *Compositor, key: []const u8) -> bool {
    const value = state.environmentValue(compositor.*.environment, key)
    if @intFromPtr(value) == 0 { return false }
    dbus.pad(writing, 8)
    dbus.putString(writing, key)
    dbus.putString(writing, cString(value))
    return true
}

// Tells the session bus (DBUS_SESSION_BUS_ADDRESS) the display; true when
// it took it.
pub fn announce(compositor: *Compositor) -> bool {
    const environment = compositor.*.environment
    if @intFromPtr(state.environmentValue(environment, "DBUS_SESSION_BUS_ADDRESS")) == 0 { return false }
    const memory = compositor.*.allocator.alloc(@sizeOf(dbus.Client), 16)
    if memory == null { return false }
    var client: *dbus.Client = undefined
    unsafe { client = @ptrCast(*dbus.Client, memory.?) }
    var taken = false
    if dbus.connectSession(client, compositor.*.allocator, environment) {
        var body: [1024]u8 = undefined
        const bytes: [*]u8 = &body
        var writing: dbus.Writer = undefined
        dbus.begin(&writing, bytes, BODY, false)
        const entries = dbus.beginArray(&writing, 8)
        const wayland = put(&writing, compositor, "WAYLAND_DISPLAY")
        _ = put(&writing, compositor, "DISPLAY")
        _ = put(&writing, compositor, "XDG_SESSION_TYPE")
        dbus.endArray(&writing, entries, 8)
        if wayland && !writing.failed {
            const serial = dbus.call(client, BUS, BUS_PATH, BUS, "UpdateActivationEnvironment", "a{ss}", bytes, writing.length)
            var reply: dbus.Header = undefined
            taken = serial != 0 && dbus.waitReply(client, serial, &reply, 2000) && reply.kind != dbus.ERROR
        }
        dbus.disconnect(client, compositor.*.allocator)
    }
    compositor.*.allocator.free(memory.?, @sizeOf(dbus.Client), 16)
    if taken {
        if compositor.*.verbose { state.say("session bus: services it starts get WAYLAND_DISPLAY (and DISPLAY)\n") }
    } else {
        state.say("session bus: could not tell it WAYLAND_DISPLAY; services it starts (notifications, the portal) may not reach the compositor\n")
    }
    return taken
}
