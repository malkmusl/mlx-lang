// The shell's side of the module boundary (entries.mlx): its entries, its
// handlers by name, and the layout of the records it shares with the
// program. The program compiles this in as its built-in shell; the shell
// module (shell_module.mlx, libmlx-shell.so) answers queries from it.
const state = @import("./state.mlx")
const shell = @import("./shell.mlx")
const protocols = @import("./protocols.mlx")
const windows = @import("./windows.mlx")
const launching = @import("./launching.mlx")
const data = @import("./data.mlx")
const dmabuf = @import("./dmabuf.mlx")
const pointer = @import("./pointer.mlx")
const capture = @import("./capture.mlx")
const xwayland = @import("./xwayland.mlx")
const xwm = @import("./xwm.mlx")
const entries = @import("./entries.mlx")
const kms = @import("./kms.mlx")

const Compositor = state.Compositor

// The protocol globals: the shell's, clipboard, linux-dmabuf, relative
// pointers and pointer constraints, capture.
fn createGlobals(compositor: *Compositor) -> bool {
    return shell.createGlobals(compositor) && dmabuf.createGlobal(compositor) && data.createGlobal(compositor) && pointer.createGlobals(compositor) && capture.createGlobals(compositor) && xwayland.createGlobals(compositor)
}

pub fn entry(index: usize) -> usize {
    if index == entries.SHELL_CREATE_GLOBALS { return @intFromPtr(createGlobals) }
    if index == entries.SHELL_LAUNCH { return @intFromPtr(launching.launch) }
    if index == entries.SHELL_REAP_CHILDREN { return @intFromPtr(launching.reapChildren) }
    if index == entries.SHELL_FRAME_DONE { return @intFromPtr(windows.frameDone) }
    if index == entries.SHELL_ADOPT_CPU_RENDERER { return @intFromPtr(windows.adoptCpuRenderer) }
    if index == entries.SHELL_BROADCAST_KEYMAP { return @intFromPtr(windows.broadcastKeymap) }
    if index == entries.SHELL_KEYBOARD_KEY { return @intFromPtr(windows.keyboardKey) }
    if index == entries.SHELL_KEYBOARD_MODIFIERS { return @intFromPtr(windows.keyboardModifiers) }
    if index == entries.SHELL_POINTER_AXIS { return @intFromPtr(windows.pointerAxis) }
    if index == entries.SHELL_POINTER_BUTTON { return @intFromPtr(windows.pointerButton) }
    if index == entries.SHELL_POINTER_MOTION { return @intFromPtr(windows.pointerMotion) }
    if index == entries.SHELL_POINTER_LEAVE { return @intFromPtr(windows.pointerLeave) }
    if index == entries.SHELL_START_HELPERS { return @intFromPtr(launching.startHelpers) }
    if index == entries.SHELL_HELPER_MESSAGES { return @intFromPtr(launching.helperMessages) }
    if index == entries.SHELL_SETTINGS_CHANGED { return @intFromPtr(protocols.settingsChanged) }
    if index == entries.SHELL_POINTER_RELATIVE { return @intFromPtr(windows.pointerRelative) }
    if index == entries.SHELL_POINTER_AXIS_STOP { return @intFromPtr(windows.pointerAxisStop) }
    return 0
}

pub fn handlerCount() -> usize {
    return shell.HANDLER_COUNT + protocols.HANDLER_COUNT + data.HANDLER_COUNT + dmabuf.HANDLER_COUNT + pointer.HANDLER_COUNT + capture.HANDLER_COUNT + xwayland.HANDLER_COUNT
}

pub fn handlerAddress(index: usize) -> usize {
    var at = index
    if at < shell.HANDLER_COUNT { return shell.handlerAddress(at) }
    at -= shell.HANDLER_COUNT
    if at < protocols.HANDLER_COUNT { return protocols.handlerAddress(at) }
    at -= protocols.HANDLER_COUNT
    if at < data.HANDLER_COUNT { return data.handlerAddress(at) }
    at -= data.HANDLER_COUNT
    if at < dmabuf.HANDLER_COUNT { return dmabuf.handlerAddress(at) }
    at -= dmabuf.HANDLER_COUNT
    if at < pointer.HANDLER_COUNT { return pointer.handlerAddress(at) }
    at -= pointer.HANDLER_COUNT
    if at < capture.HANDLER_COUNT { return capture.handlerAddress(at) }
    at -= capture.HANDLER_COUNT
    return xwayland.handlerAddress(at)
}

pub fn handlerName(index: usize) -> []const u8 {
    var at = index
    if at < shell.HANDLER_COUNT { return shell.handlerName(at) }
    at -= shell.HANDLER_COUNT
    if at < protocols.HANDLER_COUNT { return protocols.handlerName(at) }
    at -= protocols.HANDLER_COUNT
    if at < data.HANDLER_COUNT { return data.handlerName(at) }
    at -= data.HANDLER_COUNT
    if at < dmabuf.HANDLER_COUNT { return dmabuf.handlerName(at) }
    at -= dmabuf.HANDLER_COUNT
    if at < pointer.HANDLER_COUNT { return pointer.handlerName(at) }
    at -= pointer.HANDLER_COUNT
    if at < capture.HANDLER_COUNT { return capture.handlerName(at) }
    at -= capture.HANDLER_COUNT
    return xwayland.handlerName(at)
}

// The records the shell keeps across a reload, by size (a changed record
// needs a restart). state.LAYOUT_VERSION covers what sizes miss.
pub fn layout() -> usize {
    var value = state.layout()
    value = value *% 31 +% @sizeOf(data.Source)
    value = value *% 31 +% @sizeOf(data.Device)
    value = value *% 31 +% @sizeOf(data.Offer)
    value = value *% 31 +% @sizeOf(dmabuf.Params)
    value = value *% 31 +% @sizeOf(kms.Output)
    value = value *% 31 +% @sizeOf(capture.ExtHandle)
    value = value *% 31 +% @sizeOf(capture.Source)
    value = value *% 31 +% @sizeOf(capture.Session)
    value = value *% 31 +% @sizeOf(capture.Frame)
    value = value *% 31 +% @sizeOf(xwm.Xwm)
    value = value *% 31 +% @sizeOf(xwm.XWindow)
    return value
}
