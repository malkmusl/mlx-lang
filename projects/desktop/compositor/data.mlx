// Copy and paste between clients: wl_data_device_manager with its data
// sources, data devices and data offers (GTK 4 refuses a display without
// it). The selection (the clipboard) is a data source a client set; the
// client with keyboard focus gets it as a data offer, when it gains focus
// and whenever the selection changes. Reading an offer asks the source's
// client to write the data into the reader's pipe; the compositor only
// passes the pipe along.
//
// Drag and drop: a client starts a drag while a button is held (the
// source, the surface it came from, an icon surface). Until the buttons
// are up the pointer is the drag's: clients get no pointer events, the
// icon follows the pointer, and the surface under it is offered the
// source's MIME types (enter, motion, leave on its data devices). The
// offer accepts a type and, from version 3, agrees on an action with the
// source; released there, the target gets drop and reads the data as it
// would the selection, then says finish. Released anywhere else, or over
// a surface that accepted nothing, the source is cancelled. A drag
// without a source stays within its client.
//
// An X program's CLIPBOARD comes as an X source (no client of ours: the
// X window manager reads it, xwm_selection.mlx), and every change of the
// selection is told to the X side. Clipboard tools (wl-copy, clipboard
// managers) see and set the selection through ext-data-control
// (data_control.mlx) with sources and offers of their own kind. A drag over an X window goes to it by
// XDND (xwm_dnd.mlx), not as data offers; an X program's drag off its
// windows is dragged here as an X source.

const std = @import("std")
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const xwm_selection = @import("./xwm_selection.mlx")
const xwm_dnd = @import("./xwm_dnd.mlx")
const data_control = @import("./data_control.mlx")

const Compositor = state.Compositor

const SYS_fcntl: usize = 72
const F_DUPFD_CLOEXEC: usize = 1030

// Room for a source's MIME types, each stored as a length byte and its
// bytes (types longer than 255 bytes are not offered).
const MIME_BYTES: usize = 4096

pub const Source = struct {
    compositor: *Compositor
    resource: wl.server.Object
    mimes: [*]u8
    mimeBytes: usize
    // The drag and drop actions it offers (wl_data_source.set_actions).
    actions: u32
    // An X program's selection (resource: none; xwm_selection reads it).
    x: bool
    // A clipboard tool's (resource: its ext_data_control_source_v1).
    control: bool
}

pub const Device = struct {
    compositor: *Compositor
    resource: wl.server.Object
}

pub const Offer = struct {
    compositor: *Compositor
    resource: wl.server.Object
    // The Source it reads from; 0 once that source is gone.
    source: usize
    // Offered for a drag: whether the target accepted a MIME type, and
    // the actions it takes (set_actions) and would prefer.
    drag: bool
    accepted: bool
    actions: u32
    preferred: u32
    // The action chosen for it (negotiate; 0: none).
    action: u32
}

fn sourceAt(address: usize) -> *Source {
    unsafe { return @ptrFromInt(*Source, address) }
}

fn deviceAt(address: usize) -> *Device {
    unsafe { return @ptrFromInt(*Device, address) }
}

fn offerAt(address: usize) -> *Offer {
    unsafe { return @ptrFromInt(*Offer, address) }
}

fn recordOf(context: *anyopaque) -> usize { return @intFromPtr(context) }

fn contextAt(address: usize) -> *anyopaque {
    unsafe { return @ptrFromInt(*anyopaque, address) }
}

fn findSource(compositor: *Compositor, object: wl.server.Object) -> usize {
    var index: usize = 0
    while index < compositor.*.dataSources.length {
        const address = state.listAt(compositor.*.dataSources, index)
        const source = sourceAt(address)
        if source.*.resource.id == object.id && state.sameClient(source.*.resource, object) { return address }
        index += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Offering the selection

// Sends the selection to `device`: a new data offer listing the source's
// MIME types, or none when nothing is selected.
fn offerSelection(compositor: *Compositor, device: *Device) -> void {
    const resource = wl.wl_data_device.Resource.fromObject(device.*.resource)
    if compositor.*.selection == 0 {
        resource.sendSelection(null)
        return
    }
    const source = sourceAt(compositor.*.selection)
    var offer = resource.sendDataOffer()
    if offer.isNull() { return }
    const memory = state.allocate(compositor, @sizeOf(Offer))
    const address = @intFromPtr(memory)
    const record = offerAt(address)
    record.*.compositor = compositor
    record.*.resource = offer.object
    record.*.source = compositor.*.selection
    record.*.drag = false
    record.*.accepted = false
    record.*.actions = 0
    record.*.preferred = 0
    record.*.action = 0
    compositor.*.dataOffers = state.listAppend(compositor.*.dataOffers, address)
    offer.setHandler(onOffer, contextAt(address))
    offer.setDestroyHandler(onOfferDestroyed, contextAt(address))
    var at: usize = 0
    while at < source.*.mimeBytes {
        const length = @intCast(usize, source.*.mimes[at])
        offer.sendOffer(source.*.mimes[at + 1..at + 1 + length])
        at += 1 + length
    }
    resource.sendSelection(&offer)
}

// Gives the client with keyboard focus the current selection (on every
// data device it has). Call when the focus or the selection changed,
// before the keyboard enter event.
pub fn offerToFocus(compositor: *Compositor) -> void {
    const focused = compositor.*.keyboardFocus
    if focused == 0 { return }
    const surface = state.surfaceAt(focused).*.resource
    var index: usize = 0
    while index < compositor.*.dataDevices.length {
        const device = deviceAt(state.listAt(compositor.*.dataDevices, index))
        if state.sameClient(device.*.resource, surface) { offerSelection(compositor, device) }
        index += 1
    }
}

// A source's client hears it is no longer the selection.
fn cancelSource(source: *Source) -> void {
    if source.*.x { return }
    if source.*.control {
        wl.ext_data_control_source_v1.Resource.fromObject(source.*.resource).sendCancelled()
    } else {
        wl.wl_data_source.Resource.fromObject(source.*.resource).sendCancelled()
    }
}

// Asks a source's client to write its data as `mime` into `fd` (it gets
// a copy).
fn askSource(source: *Source, mime: []const u8, fd: wl.server.Handle) -> void {
    if source.*.control {
        wl.ext_data_control_source_v1.Resource.fromObject(source.*.resource).sendSend(mime, fd)
    } else {
        wl.wl_data_source.Resource.fromObject(source.*.resource).sendSend(mime, fd)
    }
}

fn setSelection(compositor: *Compositor, address: usize) -> void {
    const old = compositor.*.selection
    if old == address { return }
    // The replaced source learns that it is no longer the selection.
    if old != 0 { cancelSource(sourceAt(old)) }
    compositor.*.selection = address
    if compositor.*.verbose {
        if address == 0 { state.say("selection: cleared\n") } else { state.say("selection: set\n") }
    }
    offerToFocus(compositor)
    xwm_selection.selectionChanged(compositor)
    data_control.selectionChanged(compositor)
}

// ---------------------------------------------------------------------------
// wl_data_offer

fn onOffer(context: *anyopaque, request: wl.server.Request) -> void {
    const offer = offerAt(recordOf(context))
    const compositor = offer.*.compositor
    if request.opcode == wl.wl_data_offer.REQUEST_ACCEPT {
        const mime = wl.wl_data_offer.decodeRequest(request).accept.mime_type
        offer.*.accepted = mime.length > 0
        if offer.*.drag && offer.*.source != 0 && !sourceAt(offer.*.source).*.x {
            const source = wl.wl_data_source.Resource.fromObject(sourceAt(offer.*.source).*.resource)
            if mime.length > 0 { source.sendTarget(mime.pointer[0..mime.length]) } else { source.sendTarget(null) }
        }
        return
    }
    if request.opcode == wl.wl_data_offer.REQUEST_SET_ACTIONS {
        const actions = wl.wl_data_offer.decodeRequest(request).set_actions
        offer.*.actions = actions.dnd_actions
        offer.*.preferred = actions.preferred_action
        if offer.*.drag { negotiate(compositor, recordOf(context)) }
        return
    }
    if request.opcode == wl.wl_data_offer.REQUEST_FINISH {
        // As GNOME and Weston: only a drop with a type accepted and an
        // action chosen can be finished.
        if offer.*.drag && wl.wl_data_offer.Resource.fromObject(request.object).version() >= 3 && (!offer.*.accepted || offer.*.action == 0) {
            wl.wl_data_offer.Resource.fromObject(request.object).postError(@intFromEnum(wl.wl_data_offer.Error.invalid_finish), "finished without a type accepted or an action chosen")
            return
        }
        if offer.*.drag && offer.*.source != 0 && sourceAt(offer.*.source).*.x {
            // An X program's drop: its XdndFinished.
            xwm_dnd.waylandFinished(compositor, offer.*.action)
        } else if offer.*.drag && offer.*.source != 0 {
            const source = wl.wl_data_source.Resource.fromObject(sourceAt(offer.*.source).*.resource)
            if source.version() >= 3 { source.sendDndFinished() }
        }
        if compositor.*.verbose { state.say("drag: finished\n") }
        return
    }
    if request.opcode != wl.wl_data_offer.REQUEST_RECEIVE { return }
    const receive = wl.wl_data_offer.decodeRequest(request).receive
    const mime = receive.mime_type
    receiveFrom(compositor, offer.*.source, mime.pointer[0..mime.length], receive.fd)
    receive.fd.close()
}

// An offer of the source at `address` read as `mime` into `fd` (the
// caller closes its own): the source's client writes into the pipe
// (sendSend passes a copy) and the reader sees end of file once the
// writer closes it. An X selection is converted into a copy of the pipe.
fn receiveFrom(compositor: *Compositor, address: usize, mime: []const u8, fd: wl.server.Handle) -> void {
    if address == 0 { return }
    if sourceAt(address).*.x {
        const copy = std.linux.syscall3(SYS_fcntl, @bitCast(usize, fd.descriptor), F_DUPFD_CLOEXEC, 0)
        if copy >= 0 && xwm_dnd.isDragSource(compositor, address) {
            xwm_dnd.receive(compositor, mime, copy)
        } else if copy >= 0 {
            xwm_selection.receive(compositor, mime, copy)
        }
    } else {
        askSource(sourceAt(address), mime, fd)
    }
}

fn onOfferDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = recordOf(context)
    const compositor = offerAt(address).*.compositor
    if compositor.*.dragOffer == address { compositor.*.dragOffer = 0 }
    compositor.*.dataOffers = state.listRemove(compositor.*.dataOffers, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Offer)) }
}

// ---------------------------------------------------------------------------
// wl_data_source

fn onSource(context: *anyopaque, request: wl.server.Request) -> void {
    const source = sourceAt(recordOf(context))
    if request.opcode == wl.wl_data_source.REQUEST_SET_ACTIONS {
        source.*.actions = wl.wl_data_source.decodeRequest(request).set_actions.dnd_actions
        return
    }
    if request.opcode != wl.wl_data_source.REQUEST_OFFER { return }
    const decoded = wl.wl_data_source.decodeRequest(request)
    const mime = decoded.offer.mime_type
    addType(source, mime.pointer[0..mime.length])
}

fn addType(source: *Source, mime: []const u8) -> void {
    if mime.length == 0 || mime.length > 255 || source.*.mimeBytes + 1 + mime.length > MIME_BYTES { return }
    source.*.mimes[source.*.mimeBytes] = @intCast(u8, mime.length)
    var index: usize = 0
    while index < mime.length {
        source.*.mimes[source.*.mimeBytes + 1 + index] = mime[index]
        index += 1
    }
    source.*.mimeBytes += 1 + mime.length
}

fn onSourceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    forgetSource(recordOf(context))
}

// A source gone: its offers read nothing more, and a selection of it
// ends.
fn forgetSource(address: usize) -> void {
    const source = sourceAt(address)
    const compositor = source.*.compositor
    xwm_selection.sourceGone(compositor, address)
    xwm_dnd.sourceGone(compositor, address)
    // A drag whose source went is over.
    if compositor.*.dragging && compositor.*.dragSource == address {
        dragFocus(compositor, 0)
        endDrag(compositor)
    }
    compositor.*.dataSources = state.listRemove(compositor.*.dataSources, address)
    var index: usize = 0
    while index < compositor.*.dataOffers.length {
        const offer = offerAt(state.listAt(compositor.*.dataOffers, index))
        if offer.*.source == address { offer.*.source = 0 }
        index += 1
    }
    // A selection whose source is gone is no selection.
    if compositor.*.selection == address {
        compositor.*.selection = 0
        offerToFocus(compositor)
        if !source.*.x { xwm_selection.selectionChanged(compositor) }
        data_control.selectionChanged(compositor)
    }
    state.release(compositor, source.*.mimes, MIME_BYTES)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Source)) }
}

fn newSource(compositor: *Compositor) -> usize {
    const memory = state.allocate(compositor, @sizeOf(Source))
    const address = @intFromPtr(memory)
    const source = sourceAt(address)
    source.*.compositor = compositor
    source.*.mimes = state.allocate(compositor, MIME_BYTES)
    source.*.mimeBytes = 0
    source.*.actions = 0
    source.*.x = false
    source.*.control = false
    compositor.*.dataSources = state.listAppend(compositor.*.dataSources, address)
    return address
}

fn createSource(compositor: *Compositor, resource: wl.wl_data_source.Resource) -> void {
    const address = newSource(compositor)
    sourceAt(address).*.resource = resource.object
    resource.setHandler(onSource, contextAt(address))
    resource.setDestroyHandler(onSourceDestroyed, contextAt(address))
}

// ---------------------------------------------------------------------------
// X sources (xwm_selection.mlx)

// A source standing for an X program's selection (its types added with
// addXSourceType).
pub fn newXSource(compositor: *Compositor) -> usize {
    const address = newSource(compositor)
    const source = sourceAt(address)
    // No client's: an id no object has.
    source.*.resource.id = 0
    source.*.x = true
    return address
}

pub fn addXSourceType(address: usize, mime: []const u8) -> void {
    const source = sourceAt(address)
    // Each type once.
    var at: usize = 0
    while at < source.*.mimeBytes {
        const length = @intCast(usize, source.*.mimes[at])
        if std.text.same(source.*.mimes[at + 1..at + 1 + length], mime) { return }
        at += 1 + length
    }
    addType(source, mime)
}

pub fn setXSelection(compositor: *Compositor, address: usize) -> void { setSelection(compositor, address) }

pub fn dropXSource(compositor: *Compositor, address: usize) -> void {
    if address == 0 { return }
    forgetSource(address)
}

// A source's types: a length byte and the type each.
pub fn typesOf(address: usize) -> []const u8 {
    if address == 0 { return "" }
    const source = sourceAt(address)
    return source.*.mimes[0..source.*.mimeBytes]
}

// Asks a client's source to write its data as `mime` into `descriptor`
// (a pipe's end; the caller closes its own).
pub fn sendFromSource(compositor: *Compositor, address: usize, mime: []const u8, descriptor: isize) -> void {
    if address == 0 || sourceAt(address).*.x { return }
    askSource(sourceAt(address), mime, wl.server.Handle.fromDescriptor(descriptor))
}

// ---------------------------------------------------------------------------
// Clipboard tools (data_control.mlx)

// A source of a clipboard tool's (its types added with addControlType).
pub fn newControlSource(compositor: *Compositor, resource: wl.server.Object) -> usize {
    const address = newSource(compositor)
    sourceAt(address).*.resource = resource
    sourceAt(address).*.control = true
    return address
}

pub fn addControlType(address: usize, mime: []const u8) -> void { addType(sourceAt(address), mime) }

// A clipboard tool's source as the selection (0: none).
pub fn setControlSelection(compositor: *Compositor, address: usize) -> void { setSelection(compositor, address) }

pub fn dropControlSource(address: usize) -> void { forgetSource(address) }

// An offer of the selection for a clipboard tool's `resource`
// (ext_data_control_offer_v1): an Offer record as a client's has.
pub fn newControlOffer(compositor: *Compositor, resource: wl.server.Object) -> usize {
    const address = @intFromPtr(state.allocate(compositor, @sizeOf(Offer)))
    const record = offerAt(address)
    record.*.compositor = compositor
    record.*.resource = resource
    record.*.source = compositor.*.selection
    record.*.drag = false
    record.*.accepted = false
    record.*.actions = 0
    record.*.preferred = 0
    record.*.action = 0
    compositor.*.dataOffers = state.listAppend(compositor.*.dataOffers, address)
    return address
}

pub fn controlReceive(address: usize, mime: []const u8, fd: wl.server.Handle) -> void {
    receiveFrom(offerAt(address).*.compositor, offerAt(address).*.source, mime, fd)
}

pub fn dropControlOffer(address: usize) -> void {
    const compositor = offerAt(address).*.compositor
    compositor.*.dataOffers = state.listRemove(compositor.*.dataOffers, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Offer)) }
}

// ---------------------------------------------------------------------------
// wl_data_device

fn onDevice(context: *anyopaque, request: wl.server.Request) -> void {
    const device = deviceAt(recordOf(context))
    const compositor = device.*.compositor
    const decoded = wl.wl_data_device.decodeRequest(request)
    if request.opcode == wl.wl_data_device.REQUEST_SET_SELECTION {
        const source = decoded.set_selection.source
        setSelection(compositor, if source.isNull() { 0 } else { findSource(compositor, source.object) })
    } else if request.opcode == wl.wl_data_device.REQUEST_START_DRAG {
        const drag = decoded.start_drag
        startDrag(compositor, drag.source, drag.origin, drag.icon)
    }
}

fn onDeviceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = recordOf(context)
    const compositor = deviceAt(address).*.compositor
    compositor.*.dataDevices = state.listRemove(compositor.*.dataDevices, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Device)) }
}

// ---------------------------------------------------------------------------
// Drag and drop

fn startDrag(compositor: *Compositor, source: wl.wl_data_source.Resource, origin: wl.wl_surface.Resource, icon: wl.wl_surface.Resource) -> void {
    // Only while a button is held (the press that began it), one at a time.
    if compositor.*.dragging || compositor.*.buttonsDown == 0 {
        if !source.isNull() { source.sendCancelled() }
        return
    }
    compositor.*.dragSource = if source.isNull() { 0 } else { findSource(compositor, source.object) }
    compositor.*.dragOrigin = origin.object
    compositor.*.dragIcon = if icon.isNull() { 0 } else { state.findSurface(compositor, icon.object) }
    compositor.*.dragIconX = 0
    compositor.*.dragIconY = 0
    if compositor.*.dragIcon != 0 { state.surfaceAt(compositor.*.dragIcon).*.role = state.ROLE_DRAG_ICON }
    compositor.*.dragTarget = 0
    compositor.*.dragOffer = 0
    compositor.*.dragAction = 0
    compositor.*.dragging = true
    // X windows may take it (xwm_dnd.mlx).
    if compositor.*.dragSource != 0 { xwm_selection.dragStarted(compositor, compositor.*.dragSource) }
    if compositor.*.verbose { state.say("drag: started\n") }
    scene.damageCursor(compositor)
    // What is under the pointer now has the drag (a busy client asks late,
    // when the pointer may already rest where it goes).
    dragMotion(compositor)
}

// The actions of the source and of the offer: the offer's preferred one
// when both have it, else the first both have (copy, move, ask), else none.
fn negotiate(compositor: *Compositor, address: usize) -> void {
    const offer = offerAt(address)
    if offer.*.source == 0 { return }
    const source = sourceAt(offer.*.source)
    const both = source.*.actions & offer.*.actions
    var action: u32 = 0
    if both & offer.*.preferred != 0 {
        action = offer.*.preferred
    } else if both & 1 != 0 {
        action = 1
    } else if both & 2 != 0 {
        action = 2
    } else if both & 4 != 0 {
        action = 4
    }
    offer.*.action = action
    if compositor.*.dragOffer == address { compositor.*.dragAction = action }
    const resource = wl.wl_data_offer.Resource.fromObject(offer.*.resource)
    if resource.version() >= 3 { resource.sendAction(action) }
    if source.*.x { return }
    const source_resource = wl.wl_data_source.Resource.fromObject(source.*.resource)
    if source_resource.version() >= 3 { source_resource.sendAction(action) }
}

// The surface under the pointer changed to `target` (0: none): the old one
// is left, the new one (when it may have the drag) entered with an offer.
fn dragFocus(compositor: *Compositor, target: usize) -> void {
    if target == compositor.*.dragTarget { return }
    const old = compositor.*.dragTarget
    var index: usize = 0
    if xwm_dnd.isX(compositor, old) {
        xwm_dnd.leave(compositor)
    } else if old != 0 {
        while index < compositor.*.dataDevices.length {
            const device = deviceAt(state.listAt(compositor.*.dataDevices, index))
            if state.sameClient(device.*.resource, state.surfaceAt(old).*.resource) { wl.wl_data_device.Resource.fromObject(device.*.resource).sendLeave() }
            index += 1
        }
    }
    // An offer that was left leads nowhere.
    if compositor.*.dragOffer != 0 { offerAt(compositor.*.dragOffer).*.drag = false }
    compositor.*.dragTarget = 0
    compositor.*.dragOffer = 0
    compositor.*.dragAction = 0
    if target == 0 { return }
    const surface = state.surfaceAt(target)
    if compositor.*.dragSource == 0 && !state.sameClient(surface.*.resource, compositor.*.dragOrigin) { return }
    // X windows take drags by XDND (xwm_dnd.mlx).
    if xwm_dnd.isX(compositor, target) {
        if compositor.*.dragSource == 0 || sourceAt(compositor.*.dragSource).*.x { return }
        compositor.*.dragTarget = target
        xwm_dnd.enter(compositor, target)
        return
    }
    compositor.*.dragTarget = target
    const serial = compositor.*.server.nextSerial()
    const x = wl.Fixed.fromInt(compositor.*.pointerX - scene.originX(surface))
    const y = wl.Fixed.fromInt(compositor.*.pointerY - scene.originY(surface))
    index = 0
    while index < compositor.*.dataDevices.length {
        const device = deviceAt(state.listAt(compositor.*.dataDevices, index))
        const resource = wl.wl_data_device.Resource.fromObject(device.*.resource)
        if state.sameClient(device.*.resource, surface.*.resource) {
            if compositor.*.dragSource == 0 {
                resource.sendEnter(serial, wl.wl_surface.Resource.fromObject(surface.*.resource), x, y, null)
            } else {
                var offer = resource.sendDataOffer()
                if !offer.isNull() {
                    const memory = state.allocate(compositor, @sizeOf(Offer))
                    const address = @intFromPtr(memory)
                    const record = offerAt(address)
                    record.*.compositor = compositor
                    record.*.resource = offer.object
                    record.*.source = compositor.*.dragSource
                    record.*.drag = true
                    record.*.accepted = false
                    record.*.actions = 0
                    record.*.preferred = 0
                    record.*.action = 0
                    compositor.*.dataOffers = state.listAppend(compositor.*.dataOffers, address)
                    offer.setHandler(onOffer, contextAt(address))
                    offer.setDestroyHandler(onOfferDestroyed, contextAt(address))
                    const source = sourceAt(compositor.*.dragSource)
                    var at: usize = 0
                    while at < source.*.mimeBytes {
                        const length = @intCast(usize, source.*.mimes[at])
                        offer.sendOffer(source.*.mimes[at + 1..at + 1 + length])
                        at += 1 + length
                    }
                    if offer.version() >= 3 { offer.sendSourceActions(source.*.actions) }
                    if compositor.*.dragOffer == 0 { compositor.*.dragOffer = address }
                    resource.sendEnter(serial, wl.wl_surface.Resource.fromObject(surface.*.resource), x, y, &offer)
                }
            }
        }
        index += 1
    }
}

// The pointer moved during a drag.
pub fn dragMotion(compositor: *Compositor) -> void {
    dragFocus(compositor, scene.surfaceAtPoint(compositor, compositor.*.pointerX, compositor.*.pointerY))
    const target = compositor.*.dragTarget
    if target == 0 { return }
    if xwm_dnd.isX(compositor, target) {
        xwm_dnd.motion(compositor)
        return
    }
    const surface = state.surfaceAt(target)
    const x = wl.Fixed.fromInt(compositor.*.pointerX - scene.originX(surface))
    const y = wl.Fixed.fromInt(compositor.*.pointerY - scene.originY(surface))
    var index: usize = 0
    while index < compositor.*.dataDevices.length {
        const device = deviceAt(state.listAt(compositor.*.dataDevices, index))
        if state.sameClient(device.*.resource, surface.*.resource) { wl.wl_data_device.Resource.fromObject(device.*.resource).sendMotion(compositor.*.time, x, y) }
        index += 1
    }
}

fn endDrag(compositor: *Compositor) -> void {
    scene.damageCursor(compositor)
    compositor.*.dragging = false
    compositor.*.dragSource = 0
    compositor.*.dragIcon = 0
    compositor.*.dragTarget = 0
    compositor.*.dragOffer = 0
}

// The buttons are up: dropped on the surface under the pointer when it
// accepted (and agreed on an action), else cancelled.
pub fn dragRelease(compositor: *Compositor) -> void {
    if !compositor.*.dragging { return }
    const target = compositor.*.dragTarget
    const over_x = xwm_dnd.isX(compositor, target)
    var dropped = false
    if over_x {
        dropped = xwm_dnd.drop(compositor)
    } else if target != 0 {
        if compositor.*.dragSource == 0 {
            dropped = true
        } else if compositor.*.dragOffer != 0 {
            dropped = dropTaken(compositor)
        }
    }
    const from_x = compositor.*.dragSource != 0 && sourceAt(compositor.*.dragSource).*.x
    if dropped {
        const surface = state.surfaceAt(target)
        var index: usize = 0
        while index < compositor.*.dataDevices.length && !over_x {
            const device = deviceAt(state.listAt(compositor.*.dataDevices, index))
            if state.sameClient(device.*.resource, surface.*.resource) { wl.wl_data_device.Resource.fromObject(device.*.resource).sendDrop() }
            index += 1
        }
        if compositor.*.dragSource != 0 && !from_x {
            const source = wl.wl_data_source.Resource.fromObject(sourceAt(compositor.*.dragSource).*.resource)
            if source.version() >= 3 { source.sendDndDropPerformed() }
        }
        if compositor.*.verbose {
            var root = target
            var depth: usize = 0
            while state.surfaceAt(root).*.parent != 0 && depth < 16 {
                root = state.surfaceAt(root).*.parent
                depth += 1
            }
            state.say("drag: dropped on ")
            state.sayTitle(state.surfaceAt(root))
            state.say("\n")
        }
    } else {
        dragFocus(compositor, 0)
        if compositor.*.dragSource != 0 && !from_x { wl.wl_data_source.Resource.fromObject(sourceAt(compositor.*.dragSource).*.resource).sendCancelled() }
        if compositor.*.verbose { state.say("drag: cancelled\n") }
    }
    // X reads what was dropped on it until its XdndFinished.
    if !dropped || !over_x { xwm_selection.dragEnded(compositor) }
    endDrag(compositor)
}

// Whether the offer the drag is over took a type and (both from version
// 3) agreed on an action.
fn dropTaken(compositor: *Compositor) -> bool {
    if compositor.*.dragOffer == 0 || compositor.*.dragSource == 0 { return false }
    const offer = offerAt(compositor.*.dragOffer)
    const source = sourceAt(compositor.*.dragSource)
    const needs_action = wl.wl_data_offer.Resource.fromObject(offer.*.resource).version() >= 3 && (source.*.x || wl.wl_data_source.Resource.fromObject(source.*.resource).version() >= 3)
    return offer.*.accepted && (!needs_action || compositor.*.dragAction != 0)
}

// An X program's drag left its windows (xwm_dnd.mlx): the X source at
// `address` is dragged over Wayland surfaces from now on, the pointer
// staying with the X window.
pub fn startXDrag(compositor: *Compositor, address: usize) -> void {
    if compositor.*.dragging { return }
    compositor.*.dragSource = address
    if compositor.*.pointerFocus != 0 { compositor.*.dragOrigin = state.surfaceAt(compositor.*.pointerFocus).*.resource }
    compositor.*.dragIcon = 0
    compositor.*.dragTarget = 0
    compositor.*.dragOffer = 0
    compositor.*.dragAction = 0
    compositor.*.dragging = true
    if compositor.*.verbose { state.say("drag: started from an X program\n") }
    dragMotion(compositor)
}

// The actions an X source offers (as the program asks).
pub fn setXSourceActions(address: usize, actions: u32) -> void {
    if address == 0 { return }
    sourceAt(address).*.actions = actions
}

// The action the target under the pointer agreed on when it took a type
// (0: it would not take the drop).
pub fn xDragAction(compositor: *Compositor) -> u32 {
    if !compositor.*.dragging || !dropTaken(compositor) { return 0 }
    return compositor.*.dragAction
}

// The X program dropped (its XdndDrop): dropped where the pointer is, or
// cancelled; true when a target took it.
pub fn xDrop(compositor: *Compositor) -> bool {
    if !compositor.*.dragging { return false }
    const taken = compositor.*.dragTarget != 0 && dropTaken(compositor)
    dragRelease(compositor)
    return taken
}

// The actions the drag's source offers (0: none, or no source).
pub fn dragActions(compositor: *Compositor) -> u32 {
    if compositor.*.dragSource == 0 { return 0 }
    return sourceAt(compositor.*.dragSource).*.actions
}

// An X window's status for the drag over it (xwm_dnd.mlx): the source
// hears whether a type is taken (its first) and the action.
pub fn xStatus(compositor: *Compositor, accepted: bool, action: u32) -> void {
    if !compositor.*.dragging || compositor.*.dragSource == 0 || sourceAt(compositor.*.dragSource).*.x { return }
    const source = sourceAt(compositor.*.dragSource)
    const resource = wl.wl_data_source.Resource.fromObject(source.*.resource)
    if accepted && source.*.mimeBytes > 0 {
        const length = @intCast(usize, source.*.mimes[0])
        resource.sendTarget(source.*.mimes[1..1 + length])
    } else {
        resource.sendTarget(null)
    }
    if action != compositor.*.dragAction && resource.version() >= 3 { resource.sendAction(action) }
    compositor.*.dragAction = action
}

// An X window finished reading what was dropped on it (xwm_dnd.mlx).
pub fn xFinished(compositor: *Compositor, address: usize) -> void {
    if address == 0 || !state.listContains(compositor.*.dataSources, address) || sourceAt(address).*.x { return }
    const resource = wl.wl_data_source.Resource.fromObject(sourceAt(address).*.resource)
    if resource.version() >= 3 { resource.sendDndFinished() }
    if compositor.*.verbose { state.say("drag: finished\n") }
}

// A surface is going away: no longer the drag's target or icon.
pub fn surfaceGone(compositor: *Compositor, address: usize) -> void {
    if compositor.*.dragTarget == address {
        xwm_dnd.surfaceGone(compositor, address)
        compositor.*.dragTarget = 0
        compositor.*.dragOffer = 0
    }
    if compositor.*.dragIcon == address { compositor.*.dragIcon = 0 }
}

// ---------------------------------------------------------------------------
// wl_data_device_manager

fn onManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.wl_data_device_manager.decodeRequest(request)
    if request.opcode == wl.wl_data_device_manager.REQUEST_CREATE_DATA_SOURCE {
        createSource(compositor, decoded.create_data_source.id)
    } else if request.opcode == wl.wl_data_device_manager.REQUEST_GET_DATA_DEVICE {
        const resource = decoded.get_data_device.id
        const memory = state.allocate(compositor, @sizeOf(Device))
        const address = @intFromPtr(memory)
        const device = deviceAt(address)
        device.*.compositor = compositor
        device.*.resource = resource.object
        compositor.*.dataDevices = state.listAppend(compositor.*.dataDevices, address)
        resource.setHandler(onDevice, contextAt(address))
        resource.setDestroyHandler(onDeviceDestroyed, contextAt(address))
        // A client that already has focus gets the selection right away.
        const focused = compositor.*.keyboardFocus
        if focused != 0 && state.sameClient(resource.object, state.surfaceAt(focused).*.resource) { offerSelection(compositor, device) }
    }
}

fn bindManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.wl_data_device_manager.Resource.fromObject(object).setHandler(onManager, context)
}

pub fn createGlobal(compositor: *Compositor) -> bool {
    compositor.*.dataSources = state.newList(compositor.*.allocator)
    compositor.*.dataDevices = state.newList(compositor.*.allocator)
    compositor.*.dataOffers = state.newList(compositor.*.allocator)
    compositor.*.selection = 0
    const memory: [*]u8 = unsafe { @ptrCast([*]u8, compositor) }
    return compositor.*.server.createGlobal(wl.Interface.wl_data_device_manager, 3, bindManager, state.contextOf(memory)) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name: when
// the shell is loaded again (modules.mlx), each resource's handler is
// replaced by the new code's function of the same name. Every function
// passed to setHandler, setDestroyHandler, createGlobal or a client
// handler here must be listed (tools/check_compositor_modules.py checks;
// --fix rewrites this table).

pub const HANDLER_COUNT: usize = 8

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindManager) }
    if index == 1 { return @intFromPtr(onDevice) }
    if index == 2 { return @intFromPtr(onDeviceDestroyed) }
    if index == 3 { return @intFromPtr(onManager) }
    if index == 4 { return @intFromPtr(onOffer) }
    if index == 5 { return @intFromPtr(onOfferDestroyed) }
    if index == 6 { return @intFromPtr(onSource) }
    if index == 7 { return @intFromPtr(onSourceDestroyed) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "data.bindManager" }
    if index == 1 { return "data.onDevice" }
    if index == 2 { return "data.onDeviceDestroyed" }
    if index == 3 { return "data.onManager" }
    if index == 4 { return "data.onOffer" }
    if index == 5 { return "data.onOfferDestroyed" }
    if index == 6 { return "data.onSource" }
    if index == 7 { return "data.onSourceDestroyed" }
    return ""
}
