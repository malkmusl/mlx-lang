// The calls that cross a module boundary (see modules.mlx).
//
// The compositor is a program (the event loop, the backends, the session)
// and two parts that can be replaced while it runs: the shell (the Wayland
// protocol and the window management: shell.mlx, data.mlx, dmabuf.mlx,
// with scene.mlx's bookkeeping) and the renderer (composition on the CPU,
// scene.mlx's drawing, and Vulkan: vulkan.mlx). Each part is reached
// through a table of function addresses in the compositor record:
// compositor.shellEntries and compositor.renderEntries. The program fills
// them with its own built-in copy of each part (shell_table.mlx,
// render_table.mlx) and replaces them with a shared object's when one is
// loaded (libmlx-shell.so, libmlx-render.so), and again whenever that file
// changes. Everything that lives across a reload is in records the program
// allocated, whose layout both sides must share (layout() in the tables).
//
// The functions below call the current version. The program calls them in
// place of shell.*, vulkan.* and scene.compose; the shell calls the
// renderer's releasePool and releaseSurface through them too.
const wl = @import("std.wayland")
const ui = @import("std.ui")
const state = @import("./state.mlx")
const kms = @import("./kms.mlx")

const Compositor = state.Compositor
const Pool = state.Pool
const Surface = state.Surface

// What a shared object says it is (its query MODULE_QUERY_KIND).
pub const MODULE_SHELL: usize = 1
pub const MODULE_RENDER: usize = 2

// The queries a module answers (mlx_compositor_module(query, index)).
pub const QUERY_KIND: usize = 0
pub const QUERY_LAYOUT: usize = 1
pub const QUERY_ENTRY: usize = 2
pub const QUERY_HANDLER_COUNT: usize = 3
pub const QUERY_HANDLER_ADDRESS: usize = 4
pub const QUERY_HANDLER_NAME: usize = 5
pub const QUERY_HANDLER_NAME_LENGTH: usize = 6

// The shell's entries.
pub const SHELL_CREATE_GLOBALS: usize = 0
pub const SHELL_LAUNCH: usize = 1
pub const SHELL_REAP_CHILDREN: usize = 2
pub const SHELL_FRAME_DONE: usize = 3
pub const SHELL_ADOPT_CPU_RENDERER: usize = 4
pub const SHELL_BROADCAST_KEYMAP: usize = 5
pub const SHELL_KEYBOARD_KEY: usize = 6
pub const SHELL_KEYBOARD_MODIFIERS: usize = 7
pub const SHELL_POINTER_AXIS: usize = 8
pub const SHELL_POINTER_BUTTON: usize = 9
pub const SHELL_POINTER_MOTION: usize = 10
pub const SHELL_POINTER_LEAVE: usize = 11
pub const SHELL_START_HELPERS: usize = 12
pub const SHELL_HELPER_MESSAGES: usize = 13
pub const SHELL_SETTINGS_CHANGED: usize = 14
pub const SHELL_POINTER_RELATIVE: usize = 15
pub const SHELL_POINTER_AXIS_STOP: usize = 16
pub const SHELL_POINTER_SWIPE: usize = 17
pub const SHELL_ENTRIES: usize = 18

// The renderer's entries.
pub const RENDER_OPEN: usize = 0
pub const RENDER_COMPOSE: usize = 1
pub const RENDER_COPY_INSTEAD: usize = 2
pub const RENDER_VERIFY_OUTPUT: usize = 3
pub const RENDER_RELEASE_POOL: usize = 4
pub const RENDER_RELEASE_SURFACE: usize = 5
pub const RENDER_COMPOSE_CPU: usize = 6
pub const RENDER_RELOADED: usize = 7
pub const RENDER_ENTRIES: usize = 8

pub const CreateGlobals = fn(*Compositor) -> bool
pub const Launch = fn(*Compositor, [*]const u8) -> void
pub const ReapChildren = fn(*Compositor) -> void
pub const FrameDone = fn(*Compositor, u32) -> void
pub const CompositorOnly = fn(*Compositor) -> void
pub const KeyboardKey = fn(*Compositor, u32, bool) -> void
pub const KeyboardModifiers = fn(*Compositor, u32, u32, u32, u32) -> void
pub const PointerAxis = fn(*Compositor, u32, wl.Fixed) -> void
pub const PointerAxisStop = fn(*Compositor, u32) -> void
pub const PointerSwipe = fn(*Compositor, u32, u32, i32, i32) -> void
pub const PointerButton = fn(*Compositor, u32, bool) -> void
pub const PointerMotion = fn(*Compositor, i32, i32) -> void
pub const PointerRelative = fn(*Compositor, i32, i32, i32, i32) -> void
pub const RenderOpen = fn(*Compositor, [][*]const u8, ?*kms.Output) -> bool
pub const RenderSlot = fn(*Compositor, usize) -> bool
pub const RenderOutput = fn(*Compositor, *kms.Output) -> bool
pub const ReleasePool = fn(*Compositor, *Pool) -> void
pub const ReleaseSurface = fn(*Compositor, *Surface) -> void
pub const ComposeCpu = fn(*Compositor, [*]u8, ui.Rect) -> void

fn shellEntry(compositor: *const Compositor, index: usize) -> usize { return compositor.*.shellEntries[index] }
fn renderEntry(compositor: *const Compositor, index: usize) -> usize { return compositor.*.renderEntries[index] }

// ---------------------------------------------------------------------------
// The shell

pub fn createGlobals(compositor: *Compositor) -> bool {
    var function: CreateGlobals = undefined
    unsafe { function = @ptrFromInt(CreateGlobals, shellEntry(compositor, SHELL_CREATE_GLOBALS)) }
    return function(compositor)
}

pub fn launch(compositor: *Compositor, program: [*]const u8) -> void {
    var function: Launch = undefined
    unsafe { function = @ptrFromInt(Launch, shellEntry(compositor, SHELL_LAUNCH)) }
    function(compositor, program)
}

// Starts the helpers that stay running: the launcher (hidden until Super
// shows it) and the dock.
pub fn startHelpers(compositor: *Compositor) -> void {
    var function: CompositorOnly = undefined
    unsafe { function = @ptrFromInt(CompositorOnly, shellEntry(compositor, SHELL_START_HELPERS)) }
    function(compositor)
}

// Reads what the helpers sent (the dock's channel is readable).
pub fn helperMessages(compositor: *Compositor) -> void {
    var function: CompositorOnly = undefined
    unsafe { function = @ptrFromInt(CompositorOnly, shellEntry(compositor, SHELL_HELPER_MESSAGES)) }
    function(compositor)
}

// The settings file was read again (settings.mlx).
pub fn settingsChanged(compositor: *Compositor) -> void {
    var function: CompositorOnly = undefined
    unsafe { function = @ptrFromInt(CompositorOnly, shellEntry(compositor, SHELL_SETTINGS_CHANGED)) }
    function(compositor)
}

pub fn reapChildren(compositor: *Compositor) -> void {
    var function: ReapChildren = undefined
    unsafe { function = @ptrFromInt(ReapChildren, shellEntry(compositor, SHELL_REAP_CHILDREN)) }
    function(compositor)
}

pub fn frameDone(compositor: *Compositor, time: u32) -> void {
    var function: FrameDone = undefined
    unsafe { function = @ptrFromInt(FrameDone, shellEntry(compositor, SHELL_FRAME_DONE)) }
    function(compositor, time)
}

pub fn adoptCpuRenderer(compositor: *Compositor) -> void {
    var function: CompositorOnly = undefined
    unsafe { function = @ptrFromInt(CompositorOnly, shellEntry(compositor, SHELL_ADOPT_CPU_RENDERER)) }
    function(compositor)
}

pub fn broadcastKeymap(compositor: *Compositor) -> void {
    var function: CompositorOnly = undefined
    unsafe { function = @ptrFromInt(CompositorOnly, shellEntry(compositor, SHELL_BROADCAST_KEYMAP)) }
    function(compositor)
}

pub fn keyboardKey(compositor: *Compositor, key: u32, pressed: bool) -> void {
    var function: KeyboardKey = undefined
    unsafe { function = @ptrFromInt(KeyboardKey, shellEntry(compositor, SHELL_KEYBOARD_KEY)) }
    function(compositor, key, pressed)
}

pub fn keyboardModifiers(compositor: *Compositor, depressed: u32, latched: u32, locked: u32, group: u32) -> void {
    var function: KeyboardModifiers = undefined
    unsafe { function = @ptrFromInt(KeyboardModifiers, shellEntry(compositor, SHELL_KEYBOARD_MODIFIERS)) }
    function(compositor, depressed, latched, locked, group)
}

pub fn pointerAxis(compositor: *Compositor, axis: u32, value: wl.Fixed) -> void {
    var function: PointerAxis = undefined
    unsafe { function = @ptrFromInt(PointerAxis, shellEntry(compositor, SHELL_POINTER_AXIS)) }
    function(compositor, axis, value)
}

// Fingers lifted off a touchpad (the axis events before came from them).
pub fn pointerAxisStop(compositor: *Compositor, axis: u32) -> void {
    var function: PointerAxisStop = undefined
    unsafe { function = @ptrFromInt(PointerAxisStop, shellEntry(compositor, SHELL_POINTER_AXIS_STOP)) }
    function(compositor, axis)
}

// A touchpad swipe: `phase` gestures.PHASE_* (begin with how many
// fingers, update with how far they moved in 1/256 pixels, end, cancel).
pub fn pointerSwipe(compositor: *Compositor, phase: u32, fingers: u32, dx: i32, dy: i32) -> void {
    var function: PointerSwipe = undefined
    unsafe { function = @ptrFromInt(PointerSwipe, shellEntry(compositor, SHELL_POINTER_SWIPE)) }
    function(compositor, phase, fingers, dx, dy)
}

pub fn pointerButton(compositor: *Compositor, button: u32, pressed: bool) -> void {
    var function: PointerButton = undefined
    unsafe { function = @ptrFromInt(PointerButton, shellEntry(compositor, SHELL_POINTER_BUTTON)) }
    function(compositor, button, pressed)
}

pub fn pointerMotion(compositor: *Compositor, x: i32, y: i32) -> void {
    var function: PointerMotion = undefined
    unsafe { function = @ptrFromInt(PointerMotion, shellEntry(compositor, SHELL_POINTER_MOTION)) }
    function(compositor, x, y)
}

// The pointer moved by (dx, dy), (raw_dx, raw_dy) before acceleration (for
// relative pointers); call before pointerMotion.
pub fn pointerRelative(compositor: *Compositor, dx: i32, dy: i32, raw_dx: i32, raw_dy: i32) -> void {
    var function: PointerRelative = undefined
    unsafe { function = @ptrFromInt(PointerRelative, shellEntry(compositor, SHELL_POINTER_RELATIVE)) }
    function(compositor, dx, dy, raw_dx, raw_dy)
}

pub fn pointerLeave(compositor: *Compositor) -> void {
    var function: CompositorOnly = undefined
    unsafe { function = @ptrFromInt(CompositorOnly, shellEntry(compositor, SHELL_POINTER_LEAVE)) }
    function(compositor)
}

// ---------------------------------------------------------------------------
// The renderer

pub fn openRenderer(compositor: *Compositor, arguments: [][*]const u8, output: ?*kms.Output) -> bool {
    var function: RenderOpen = undefined
    unsafe { function = @ptrFromInt(RenderOpen, renderEntry(compositor, RENDER_OPEN)) }
    return function(compositor, arguments, output)
}

pub fn compose(compositor: *Compositor, slot: usize) -> bool {
    var function: RenderSlot = undefined
    unsafe { function = @ptrFromInt(RenderSlot, renderEntry(compositor, RENDER_COMPOSE)) }
    const start = state.microseconds()
    const composed = function(compositor, slot)
    compositor.*.renderMicros += state.microseconds() - start
    return composed
}

pub fn verifyOutput(compositor: *Compositor, slot: usize) -> bool {
    var function: RenderSlot = undefined
    unsafe { function = @ptrFromInt(RenderSlot, renderEntry(compositor, RENDER_VERIFY_OUTPUT)) }
    return function(compositor, slot)
}

pub fn copyInstead(compositor: *Compositor, output: *kms.Output) -> bool {
    var function: RenderOutput = undefined
    unsafe { function = @ptrFromInt(RenderOutput, renderEntry(compositor, RENDER_COPY_INSTEAD)) }
    return function(compositor, output)
}

pub fn releasePool(compositor: *Compositor, pool: *Pool) -> void {
    var function: ReleasePool = undefined
    unsafe { function = @ptrFromInt(ReleasePool, renderEntry(compositor, RENDER_RELEASE_POOL)) }
    function(compositor, pool)
}

pub fn releaseSurface(compositor: *Compositor, surface: *Surface) -> void {
    var function: ReleaseSurface = undefined
    unsafe { function = @ptrFromInt(ReleaseSurface, renderEntry(compositor, RENDER_RELEASE_SURFACE)) }
    function(compositor, surface)
}

pub fn composeCpu(compositor: *Compositor, pixels: [*]u8, area: ui.Rect) -> void {
    var function: ComposeCpu = undefined
    unsafe { function = @ptrFromInt(ComposeCpu, renderEntry(compositor, RENDER_COMPOSE_CPU)) }
    const start = state.microseconds()
    function(compositor, pixels, area)
    compositor.*.renderMicros += state.microseconds() - start
}

// Called on a renderer just loaded while the compositor runs.
pub fn rendererReloaded(compositor: *Compositor) -> void {
    var function: CompositorOnly = undefined
    unsafe { function = @ptrFromInt(CompositorOnly, renderEntry(compositor, RENDER_RELOADED)) }
    function(compositor)
}
