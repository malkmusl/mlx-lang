// The compositor and the session bus on brixOS (session_bus.mlx is
// Linux's, on the D-Bus wire): the bus is synapse, reached natively
// (std.ipc), told the display so the services it starts reach the
// compositor.
const std = @import("std")
const ipc = @import("std.ipc")
const state = @import("./state.mlx")

const Compositor = state.Compositor

const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const BODY: usize = 1024

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 && length < 400 { length += 1 }
    return text[0..length]
}

fn put(writing: *ipc.Writer, compositor: *Compositor, key: []const u8) -> bool {
    const value = state.environmentValue(compositor.*.environment, key)
    if @intFromPtr(value) == 0 { return false }
    ipc.putString(writing, key)
    ipc.putString(writing, cString(value))
    return true
}

// Tells the session bus (DBUS_SESSION_BUS_ADDRESS) the display; true when
// it took it.
pub fn announce(compositor: *Compositor) -> bool {
    const environment = compositor.*.environment
    if @intFromPtr(state.environmentValue(environment, "DBUS_SESSION_BUS_ADDRESS")) == 0 { return false }
    const memory = compositor.*.allocator.alloc(@sizeOf(ipc.Client), 16)
    if memory == null { return false }
    const client: *ipc.Client = unsafe { @ptrCast(*ipc.Client, memory.?) }
    var taken = false
    if ipc.connectSession(client, compositor.*.allocator, environment) {
        var body: [1024]u8 = undefined
        const bytes: [*]u8 = &body
        var writing: ipc.Writer = undefined
        ipc.begin(&writing, bytes, BODY)
        const entries = ipc.beginArray(&writing)
        var count: usize = 0
        const wayland = put(&writing, compositor, "WAYLAND_DISPLAY")
        if wayland { count += 1 }
        if put(&writing, compositor, "DISPLAY") { count += 1 }
        if put(&writing, compositor, "XDG_SESSION_TYPE") { count += 1 }
        ipc.endArray(&writing, entries, count)
        if wayland && !writing.failed {
            const serial = ipc.call(client, BUS, BUS_PATH, BUS, "UpdateActivationEnvironment", "a{ss}", bytes, writing.length)
            var reply: ipc.Message = undefined
            taken = serial != 0 && ipc.waitReply(client, serial, &reply, 2000) && reply.kind != ipc.ERROR
        }
        ipc.disconnect(client, compositor.*.allocator)
    }
    compositor.*.allocator.free(memory.?, @sizeOf(ipc.Client), 16)
    if taken {
        if compositor.*.verbose { state.say("session bus: services it starts get WAYLAND_DISPLAY (and DISPLAY)\n") }
    } else {
        state.say("session bus: could not tell it WAYLAND_DISPLAY; services it starts (notifications, the portal) may not reach the compositor\n")
    }
    return taken
}
