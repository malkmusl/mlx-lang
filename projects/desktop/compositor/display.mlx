// The monitor for the settings app, and night light.
//
// write() tells what the compositor drives in
// $XDG_RUNTIME_DIR/<socket>.display (mlx-settings' Display page reads it;
// projects/desktop/settings/display.mlx):
//
//     backend = drm                  (drm: the monitor itself; nested: a
//                                     window in another session)
//     output = HDMI-A-1
//     mode = 2560x1440@144           (pixels and the kernel's rounded Hz)
//     millihertz = 143912
//     available = 2560x1440@144      (one line each: the connector's
//                                     progressive modes)
//     gamma = 256                    (the CRTC's gamma table's size; 0:
//                                     none, no night light)
//
// The mode it starts in is the settings' display-mode (drm.mlx hands it to
// kms.mlx); night light (night-light, night-light-temperature) is the
// CRTC's gamma table scaled toward a warmer white (kms.setTemperature),
// set again whenever the settings change. wl_output tells clients the
// output's name and refresh rate from here too.
const std = @import("std")
const state = @import("./state.mlx")
const kms = @import("./kms.mlx")
const drm = @import("./drm.mlx")

const Compositor = state.Compositor

const O_WRONLY_CREATE_TRUNCATE: usize = 577

fn say(text: []const u8) -> void { state.say(text) }

fn put(out: [*]u8, at: usize, text: []const u8) -> usize {
    var length = at
    for byte in text {
        out[length] = byte
        length += 1
    }
    return length
}

fn putNumber(out: [*]u8, at: usize, value: usize) -> usize {
    var reversed: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        reversed[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var length = at
    while count > 0 {
        count -= 1
        out[length] = reversed[count]
        length += 1
    }
    return length
}

// "WxH@HZ".
fn putMode(out: [*]u8, at: usize, width: usize, height: usize, hertz: usize) -> usize {
    var length = putNumber(out, at, width)
    out[length] = 120
    length = putNumber(out, length + 1, height)
    out[length] = 64
    return putNumber(out, length + 1, hertz)
}

fn outputOf(compositor: *Compositor) -> *kms.Output { return drm.output(drm.backendAt(compositor.*.drm)) }

// The file's path (NUL-terminated) into `path` (256 bytes); false without
// XDG_RUNTIME_DIR.
fn pathOf(compositor: *Compositor, path: [*]u8) -> bool {
    const runtime = state.environmentValue(compositor.*.environment, "XDG_RUNTIME_DIR")
    if @intFromPtr(runtime) == 0 || runtime[0] == 0 { return false }
    var length: usize = 0
    while runtime[length] != 0 && length < 160 {
        path[length] = runtime[length]
        length += 1
    }
    path[length] = 47
    length += 1
    var index: usize = 0
    while index < compositor.*.socketNameLength && index < 64 {
        path[length] = compositor.*.socketName[index]
        length += 1
        index += 1
    }
    length = put(path, length, ".display")
    path[length] = 0
    return true
}

// What the output is, into the file (whole: NAME.new renamed over it) and
// into what wl_output says. Call once the backend has its output.
pub fn write(compositor: *Compositor) -> void {
    var bytes: [2048]u8 = undefined
    var out: [*]u8 = undefined
    unsafe { out = @ptrCast([*]u8, &bytes) }
    var length = put(out, 0, "# The Mlx compositor's output (mlx-settings reads this file).\nbackend = ")
    if compositor.*.drm != 0 {
        const output = outputOf(compositor)
        var name: [*]u8 = undefined
        unsafe { name = @ptrCast([*]u8, &compositor.*.outputName) }
        compositor.*.outputNameLength = kms.connectorName(output, name)
        compositor.*.outputMillihertz = output.*.millihertz
        length = put(out, length, "drm\noutput = ")
        length = put(out, length, name[0..compositor.*.outputNameLength])
        length = put(out, length, "\nmode = ")
        length = putMode(out, length, output.*.width, output.*.height, @intCast(usize, output.*.refresh))
        length = put(out, length, "\nmillihertz = ")
        length = putNumber(out, length, @intCast(usize, output.*.millihertz))
        var index: usize = 0
        while index < output.*.modeCount {
            length = put(out, length, "\navailable = ")
            length = putMode(out, length, @intCast(usize, output.*.modeWidths[index]), @intCast(usize, output.*.modeHeights[index]), @intCast(usize, output.*.modeHertz[index]))
            index += 1
        }
        length = put(out, length, "\ngamma = ")
        length = putNumber(out, length, @intCast(usize, output.*.gammaSize))
    } else {
        // A window: its size, at the host monitor's rate.
        const millihertz = if compositor.*.hostModeRefresh > 0 { @intCast(usize, compositor.*.hostModeRefresh) } else { 60000 }
        compositor.*.outputMillihertz = @intCast(u32, millihertz)
        length = put(out, length, "nested\nmode = ")
        length = putMode(out, length, compositor.*.width, compositor.*.height, (millihertz + 500) / 1000)
        length = put(out, length, "\nmillihertz = ")
        length = putNumber(out, length, millihertz)
        length = put(out, length, "\ngamma = 0")
    }
    out[length] = 10
    length += 1

    var path: [264]u8 = undefined
    var temporary: [264]u8 = undefined
    var path_bytes: [*]u8 = undefined
    var temporary_bytes: [*]u8 = undefined
    unsafe {
        path_bytes = @ptrCast([*]u8, &path)
        temporary_bytes = @ptrCast([*]u8, &temporary)
    }
    if !pathOf(compositor, path_bytes) { return }
    var path_length: usize = 0
    while path[path_length] != 0 {
        temporary[path_length] = path[path_length]
        path_length += 1
    }
    const end = put(temporary_bytes, path_length, ".new")
    temporary[end] = 0
    const file = std.fs.open(temporary_bytes, O_WRONLY_CREATE_TRUNCATE, 420)
    if !std.fs.isValid(file) { return }
    const written = std.fs.writeAllBytes(file, out, length)
    const closed = std.fs.close(file)
    if written && std.fs.rename(temporary_bytes, path_bytes) {
        if compositor.*.verbose {
            say("display: told in ")
            say(path_bytes[0..path_length])
            say("\n")
        }
    }
}

// The file goes with the compositor.
pub fn remove(compositor: *Compositor) -> void {
    var path: [264]u8 = undefined
    var path_bytes: [*]u8 = undefined
    unsafe { path_bytes = @ptrCast([*]u8, &path) }
    if pathOf(compositor, path_bytes) { const deleted = std.fs.delete(path_bytes) }
}

// Night light as the settings say, on the monitor (the DRM backend; a
// nested window has no gamma table of its own).
pub fn applyNightLight(compositor: *Compositor) -> void {
    if compositor.*.drm == 0 { return }
    const output = outputOf(compositor)
    const kelvin = if compositor.*.nightLight { compositor.*.nightTemperature } else { kms.NEUTRAL }
    const before = output.*.temperature
    const set = kms.setTemperature(output, kelvin)
    if !compositor.*.verbose { return }
    if !set {
        if compositor.*.nightLight { say("night light: the CRTC has no gamma table to set\n") }
    } else if output.*.temperature != before {
        if output.*.temperature == 0 {
            say("night light: off\n")
        } else {
            say("night light: ")
            state.sayNumber(@intCast(usize, output.*.temperature))
            say(" K\n")
        }
    }
}
