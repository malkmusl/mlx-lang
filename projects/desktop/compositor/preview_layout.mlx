// Where the window previews go (part of scene.mlx, split from it): the
// panel above the dock with an app's windows scaled down and their titles
// below, the dock asking for them when an app has several or the pointer
// rests on its icon; drawn here on the CPU (vulkan.mlx draws it on the
// GPU from the same places).
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const tt = @import("std.truetype")
const ui = @import("std.ui")

const Compositor = state.Compositor
const Surface = state.Surface

pub const PREVIEW_MAX: usize = 8
pub const PREVIEW_HEIGHT: i32 = 150
pub const PREVIEW_WIDTH: i32 = 260
pub const PREVIEW_GAP: i32 = 16
pub const PREVIEW_PADDING: i32 = 16
pub const PREVIEW_TITLE: i32 = 24
pub const PREVIEW_RADIUS: i32 = 14
// The panel's colour (0xFF202430).
pub const PREVIEW_COLOR: u32 = 4280296496

// A window's thumbnail size: its rest bounds scaled to fit PREVIEW_WIDTH
// x PREVIEW_HEIGHT, never enlarged.
pub fn previewSize(surface: *const Surface, width: *i32, height: *i32) -> void {
    const bounds = scene.restBounds(surface)
    var w = if bounds.width > 0 { bounds.width } else { 1 }
    var h = if bounds.height > 0 { bounds.height } else { 1 }
    if h > PREVIEW_HEIGHT {
        w = w * PREVIEW_HEIGHT / h
        h = PREVIEW_HEIGHT
    }
    if w > PREVIEW_WIDTH {
        h = h * PREVIEW_WIDTH / w
        w = PREVIEW_WIDTH
    }
    width.* = if w > 0 { w } else { 1 }
    height.* = if h > 0 { h } else { 1 }
}

// The panel: centred above the dock (what the bottom edge reserves).
pub fn previewPanel(compositor: *const Compositor) -> ui.Rect {
    var width = PREVIEW_PADDING * 2 - PREVIEW_GAP
    var index: usize = 0
    while index < compositor.*.previewCount {
        var w: i32 = 0
        var h: i32 = 0
        previewSize(state.surfaceAt(compositor.*.previewWindows[index]), &w, &h)
        width += w + PREVIEW_GAP
        index += 1
    }
    const height = PREVIEW_HEIGHT + PREVIEW_TITLE + PREVIEW_PADDING * 2
    const below = if compositor.*.dockReserve > compositor.*.reserveBottom { compositor.*.dockReserve } else { compositor.*.reserveBottom }
    const output_width = @intCast(i32, compositor.*.width)
    var x = (output_width - width) / 2
    // Over the icon the pointer rests on (kept on the output).
    if compositor.*.previewAnchorX >= 0 {
        x = compositor.*.previewAnchorX - width / 2
        if x + width > output_width - 8 { x = output_width - 8 - width }
        if x < 8 { x = 8 }
    }
    return ui.rect(x, @intCast(i32, compositor.*.height) - below - 12 - height, width, height)
}

pub fn previewShape(compositor: *const Compositor) -> scene.Shape {
    const panel = previewPanel(compositor)
    return scene.Shape.{ .x = panel.x, .y = panel.y, .width = panel.width, .height = panel.height, .top = PREVIEW_RADIUS, .bottom = PREVIEW_RADIUS }
}

// Window `index`'s thumbnail, centred in its column's picture band.
pub fn previewSlot(compositor: *const Compositor, index: usize) -> ui.Rect {
    const panel = previewPanel(compositor)
    var x = panel.x + PREVIEW_PADDING
    var slot: usize = 0
    while slot < compositor.*.previewCount {
        var w: i32 = 0
        var h: i32 = 0
        previewSize(state.surfaceAt(compositor.*.previewWindows[slot]), &w, &h)
        if slot == index { return ui.rect(x, panel.y + PREVIEW_PADDING + (PREVIEW_HEIGHT - h) / 2, w, h) }
        x += w + PREVIEW_GAP
        slot += 1
    }
    return ui.rect(0, 0, 0, 0)
}

// The highlight behind the thumbnail under the pointer.
pub fn previewHighlight(compositor: *const Compositor, index: usize) -> scene.Shape {
    const slot = previewSlot(compositor, index)
    return scene.Shape.{ .x = slot.x - 6, .y = slot.y - 6, .width = slot.width + 12, .height = slot.height + 12, .top = 8, .bottom = 8 }
}

// Where window `index`'s title goes: its pen start on the baseline, and
// how wide it may be.
pub fn previewTitleX(compositor: *const Compositor, index: usize) -> i32 { return previewSlot(compositor, index).x }
pub fn previewTitleY(compositor: *const Compositor) -> i32 { return previewPanel(compositor).y + PREVIEW_PADDING + PREVIEW_HEIGHT + 18 }

// The thumbnail at (x, y), PREVIEW_MAX when none.
pub fn previewAt(compositor: *const Compositor, x: i32, y: i32) -> usize {
    var index: usize = 0
    while index < compositor.*.previewCount {
        const slot = previewHighlight(compositor, index)
        if x >= slot.x && y >= slot.y && x < slot.x + slot.width && y < slot.y + slot.height + PREVIEW_TITLE { return index }
        index += 1
    }
    return PREVIEW_MAX
}

// Lays out window `index`'s title (as far as it fits its column) into the
// compositor's run; false when there is nothing to draw.
pub fn layoutPreviewTitle(compositor: *Compositor, index: usize) -> bool {
    if !compositor.*.hasText { return false }
    const surface = state.surfaceAt(compositor.*.previewWindows[index])
    if surface.*.titleLength == 0 { return false }
    var text: [64]u8 = undefined
    const bytes: [*]u8 = &text
    var length: usize = 0
    while length < surface.*.titleLength && length < 64 {
        bytes[length] = surface.*.title[length]
        length += 1
    }
    const run = compositor.*.run
    tt.layoutBytes(compositor.*.atlas, bytes, length, run)
    return clipRun(run, previewSlot(compositor, index).width)
}

// Keeps the quads of `run` that end within `limit` pixels of its origin,
// and their bounding box; false when none is left.
fn clipRun(run: *tt.Run, limit: i32) -> bool {
    var kept: usize = 0
    while kept < run.*.count {
        const quad = run.*.quads[kept]
        if quad.x + @intCast(i32, quad.width) > limit { break }
        kept += 1
    }
    run.*.count = kept
    if kept == 0 { return false }
    var index: usize = 0
    while index < kept {
        const quad = run.*.quads[index]
        const right = quad.x + @intCast(i32, quad.width)
        const bottom = quad.y + @intCast(i32, quad.height)
        if index == 0 || quad.x < run.*.left { run.*.left = quad.x }
        if index == 0 || quad.y < run.*.top { run.*.top = quad.y }
        if index == 0 || right > run.*.right { run.*.right = right }
        if index == 0 || bottom > run.*.bottom { run.*.bottom = bottom }
        index += 1
    }
    return true
}

// The previews on the CPU: the panel, the highlight, each window's buffer
// scaled into its thumbnail (nearest pixel; the Vulkan renderer shows the
// whole window, frame and title bar too), and the titles.
pub fn drawPreviews(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect) -> void {
    if compositor.*.previewCount == 0 { return }
    const panel = previewShape(compositor)
    scene.fillShape(compositor, pixels, clip, &panel, PREVIEW_COLOR)
    if compositor.*.previewHover < compositor.*.previewCount {
        const highlight = previewHighlight(compositor, compositor.*.previewHover)
        scene.fillShape(compositor, pixels, clip, &highlight, compositor.*.focusColor)
    }
    const target: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    var index: usize = 0
    while index < compositor.*.previewCount {
        const surface = state.surfaceAt(compositor.*.previewWindows[index])
        const slot = previewSlot(compositor, index)
        const area = ui.intersect(slot, clip)
        if surface.*.hasContent && !ui.isEmpty(area) && surface.*.pixelWidth > 0 && surface.*.pixelHeight > 0 {
            const source: [*]const u32 = unsafe { @ptrCast([*]const u32, surface.*.pixels) }
            var row = area.y
            while row < ui.bottom(area) {
                const from_row = @intCast(usize, row - slot.y) * surface.*.pixelHeight / @intCast(usize, slot.height)
                var column = area.x
                while column < ui.right(area) {
                    const from_column = @intCast(usize, column - slot.x) * surface.*.pixelWidth / @intCast(usize, slot.width)
                    const pixel = source[from_row * surface.*.pixelWidth + from_column]
                    const alpha = pixel >> 24
                    const at = @intCast(usize, row) * compositor.*.width + @intCast(usize, column)
                    if alpha == 255 { target[at] = pixel } else if alpha != 0 { target[at] = scene.blendPixel(target[at], pixel, alpha) }
                    column += 1
                }
                row += 1
            }
        }
        if layoutPreviewTitle(compositor, index) {
            const words: [*]u32 = unsafe { @ptrFromInt([*]u32, @intFromPtr(pixels) + (@intCast(usize, clip.y) * compositor.*.width + @intCast(usize, clip.x)) * 4) }
            tt.drawRun(compositor.*.atlas, compositor.*.run, words, @intCast(usize, clip.width), @intCast(usize, clip.height), compositor.*.width, previewTitleX(compositor, index) - clip.x, previewTitleY(compositor) - clip.y, scene.TITLE_COLOR, 0)
        }
        index += 1
    }
}
