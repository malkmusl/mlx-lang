// The aggregate arena, and how the compositor keeps it from filling up.
//
// This compiler keeps every struct, array and tuple value that is not a
// field of something else — locals, literals, values returned by
// functions — in one 1 GiB mapping that is only ever bumped: nothing in
// it is released when a function returns. A program that runs for long
// allocates it up (each pointer motion costs a few hundred bytes, an
// event's decoded payload and a few rectangles, so a mouse at 1000 Hz
// fills it within minutes) and traps with an illegal instruction when it
// is full: that was the compositor dying with signal 4 after a minute or
// two of use.
//
// The compositor's event loop is a fixed point: everything that outlives
// one turn of the loop is in memory from the allocator (surfaces, clients,
// lists, renderer records, the frame buffers) or was allocated before the
// loop started (the compositor record, the backends, the font). So the loop
// notes the arena's fill before its first turn and restores it at the start
// of every turn (release), which frees what the turn's handlers and frame
// allocated. The arena's first word is the fill (the next free address),
// which the generated code bumps; the arena is found by walking down from
// a local of this module, page by page within the mapping /proc/self/maps
// lists for it (the kernel merges neighbouring anonymous mappings, so the
// mapping can be larger than the arena), to the word that an allocation
// proves to be the fill.
//
// MLX_ARENA_RELEASE=0 keeps the arena growing (as before), and
// MLX_ARENA_POISON=1 overwrites the released bytes so that a value wrongly
// kept across turns is noticed in tests rather than read back intact.
const state = @import("./state.mlx")
const turns = @import("std.turns")

const Compositor = state.Compositor

// Reads the environment and finds the arena; says what it will do when
// verbose. Called once everything the loop keeps was set up, right before
// the loop's first turn (each turn then calls std.turns.turn).
pub fn begin(compositor: *Compositor) -> void {
    const disabled = state.environmentValue(compositor.*.environment, "MLX_ARENA_RELEASE")
    compositor.*.arenaRelease = @intFromPtr(disabled) == 0 || disabled[0] != 48
    const poison = state.environmentValue(compositor.*.environment, "MLX_ARENA_POISON")
    turns.begin(&compositor.*.turns, compositor.*.arenaRelease, @intFromPtr(poison) != 0 && poison[0] == 49)
    if !compositor.*.verbose { return }
    if compositor.*.turns.base != 0 {
        state.say("memory: ")
        state.sayNumber(turns.used(compositor.*.turns.base) / 1024)
        state.say(" KiB of values kept; each turn of the loop releases its own")
        if compositor.*.turns.poison { state.say(" (and poisons them)") }
        state.say("\n")
    } else if compositor.*.arenaRelease {
        state.say("memory: the value arena was not found; values are kept until the compositor ends\n")
    } else {
        state.say("memory: values are kept until the compositor ends (MLX_ARENA_RELEASE=0)\n")
    }
}

// Says, when verbose, how much the loop's turns allocated at most; called
// when the loop ended.
pub fn end(compositor: *Compositor) -> void {
    if !compositor.*.verbose || compositor.*.turns.base == 0 { return }
    turns.turn(&compositor.*.turns)
    state.say("memory: a turn of the loop allocated up to ")
    state.sayNumber(compositor.*.turns.peak)
    state.say(" bytes of values\n")
}
