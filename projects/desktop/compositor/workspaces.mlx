// Workspaces: nine of them, every window on one; only the current one's
// windows are drawn and hit (scene.hidden). Super+1..9 switches,
// Super+Shift+1..9 moves the focused window, and the top bar (mlx-topbar)
// shows them and switches them over its channel (MLX_TOPBAR_FD): the
// compositor sends it the state whenever it changes, a 'W' (87), the
// current workspace, the tiling mask as two bytes and the nine window
// counts; the bar sends 'w' (119) and a workspace to switch, or 't'
// (116), a workspace and 1 or 0 to turn its tiling on or off. Switching
// slides the old workspace out and the new one in (animation.mlx).
const std = @import("std")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const shell = @import("./shell.mlx")
const windows_module = @import("./windows.mlx")
const tiling_module = @import("./tiling.mlx")
const animation_module = @import("./animation.mlx")

const Compositor = state.Compositor
const Surface = state.Surface

pub const MESSAGE_STATE: u8 = 87
pub const MESSAGE_SWITCH: u8 = 119
pub const MESSAGE_TILING: u8 = 116

// How many mapped windows a workspace holds.
pub fn windowCount(compositor: *Compositor, workspace: usize) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < compositor.*.stack.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.stack, index))
        if surface.*.role == state.ROLE_TOPLEVEL && windows_module.isWindow(surface) && surface.*.workspace == workspace { count += 1 }
        index += 1
    }
    return count
}

// Shows workspace `index` (0 to 8): what was being moved or resized is let
// go, the focus goes to the workspace's topmost window, the pointer to
// what is under it there.
pub fn switchTo(compositor: *Compositor, index: usize) -> void {
    if index >= state.MAX_WORKSPACES || index == compositor.*.workspace { return }
    windows_module.endInteraction(compositor)
    const old = compositor.*.workspace
    compositor.*.fingerScrolling = false
    // A swipe that was pulling the strip lets go.
    if compositor.*.swipeKind == state.SWIPE_KIND_STRIP { compositor.*.swipeKind = state.SWIPE_KIND_NONE }
    compositor.*.workspace = index
    animation_module.slide(compositor, old, index)
    scene.damageAll(compositor)
    const focused = compositor.*.keyboardFocus
    // (Through focus, so the window that had it hears it lost it.)
    if focused == 0 || scene.hidden(focused) { windows_module.focusTopmost(compositor) }
    windows_module.refreshPointerFocus(compositor)
    tiling_module.layout(compositor, index)
    notifyTopbar(compositor)
    if compositor.*.verbose {
        state.say("workspace: ")
        state.sayNumber(index + 1)
        state.say("\n")
    }
}

// Moves the focused window to workspace `index` (it stays here).
pub fn moveFocused(compositor: *Compositor, index: usize) -> void {
    const focused = compositor.*.keyboardFocus
    if focused == 0 { return }
    const surface = state.surfaceAt(focused)
    if surface.*.role != state.ROLE_TOPLEVEL { return }
    moveWindow(compositor, surface, index)
}

// Puts `surface` on workspace `index`: out of this workspace's tiling and
// into the other's when that tiles.
pub fn moveWindow(compositor: *Compositor, surface: *Surface, index: usize) -> void {
    if index >= state.MAX_WORKSPACES || surface.*.workspace == index { return }
    const address = state.addressOfSurface(surface)
    if compositor.*.moving == address || compositor.*.resizing == address { windows_module.endInteraction(compositor) }
    scene.damageSurface(compositor, surface)
    tiling_module.remove(compositor, surface)
    surface.*.workspace = index
    if compositor.*.workspaceTiling[index] { tiling_module.add(compositor, surface) }
    // Off this workspace towards that one's side.
    if index != compositor.*.workspace { animation_module.depart(compositor, surface, index) }
    if compositor.*.keyboardFocus == address { windows_module.focusTopmost(compositor) }
    windows_module.refreshPointerFocus(compositor)
    scene.damageAll(compositor)
    notifyTopbar(compositor)
    if compositor.*.verbose {
        state.say("moved to workspace ")
        state.sayNumber(index + 1)
        state.say(": ")
        state.sayTitle(surface)
        state.say("\n")
    }
}

// The workspace before or after the current one (`step` -1 or 1), as the
// wheel asks: at most one switch per WHEEL_COOLDOWN, so a long spin of a
// fast wheel or a touchpad does not race through all nine.
const WHEEL_COOLDOWN: usize = 150000

pub fn step(compositor: *Compositor, by: i32) -> void {
    const now = state.microseconds()
    if compositor.*.wheelSwitchedAt != 0 && now - compositor.*.wheelSwitchedAt < WHEEL_COOLDOWN { return }
    const current = @intCast(i32, compositor.*.workspace)
    const next = current + by
    if next < 0 || next >= @intCast(i32, state.MAX_WORKSPACES) { return }
    compositor.*.wheelSwitchedAt = now
    switchTo(compositor, @intCast(usize, next))
}

// Tells the top bar the workspaces (on its channel; nothing without one).
pub fn notifyTopbar(compositor: *Compositor) -> void {
    if compositor.*.topbarChannel < 0 { return }
    var message: [16]u8 = undefined
    message[0] = MESSAGE_STATE
    message[1] = @intCast(u8, compositor.*.workspace)
    var mask: usize = 0
    var index: usize = 0
    while index < state.MAX_WORKSPACES {
        if compositor.*.workspaceTiling[index] { mask |= @intCast(usize, 1) << index }
        const count = windowCount(compositor, index)
        message[4 + index] = @intCast(u8, if count > 255 { 255 } else { count })
        index += 1
    }
    message[2] = @intCast(u8, mask & 255)
    message[3] = @intCast(u8, (mask >> 8) & 255)
    // sendto with MSG_DONTWAIT | MSG_NOSIGNAL: a bar that does not read
    // loses a message and gets the next.
    const sent = std.linux.syscall6(44, @bitCast(usize, compositor.*.topbarChannel), @intFromPtr(&message), 4 + state.MAX_WORKSPACES, 64 | 16384, 0, 0)
}

// What the top bar sent: switches and tiling changes.
pub fn topbarMessages(compositor: *Compositor, bytes: [*]const u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        const kind = bytes[index]
        if kind == MESSAGE_SWITCH && index + 1 < length {
            switchTo(compositor, @intCast(usize, bytes[index + 1]))
            index += 2
        } else if kind == MESSAGE_TILING && index + 2 < length {
            tiling_module.set(compositor, @intCast(usize, bytes[index + 1]), bytes[index + 2] != 0)
            index += 3
        } else {
            index += 1
        }
    }
}
