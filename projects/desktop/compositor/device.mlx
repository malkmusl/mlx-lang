// Kernel devices for the DRM backend (drm.mlx): one type for a DRM card
// or an input device, over std.linux's system calls.
//
// A device is normally a character device (from logind's TakeDevice or
// opened directly), used with ioctl(2), read(2) and mmap(2). When the
// descriptor is a Unix socket instead, the device is emulated by a test
// harness (tools/fake_drm_session.py) and the same calls travel as frames:
//
//   request:  u32 kind (1: ioctl), u32 length, u64 request, argument bytes
//   reply:    u32 kind (1), u32 length, i64 result, argument bytes back
//             (the replies to MAP_DUMB and PRIME_HANDLE_TO_FD carry the
//             buffer's memfd as SCM_RIGHTS)
//   data:     u32 kind (2), u32 length, bytes read(2) would return (DRM
//             events, input_event records)
//
// Everything above this file is the same for both: the ioctl numbers and
// the kernel's structure layouts.

const std = @import("std")

const linux = std.linux

const FRAME_IOCTL: u32 = 1
const FRAME_DATA: u32 = 2
// Room for data frames that arrive while an emulated ioctl waits.
const BUFFER_SIZE: usize = 65536

// ---------------------------------------------------------------------------
// Little-endian fields of kernel structures

pub fn store16(bytes: [*]u8, offset: usize, value: u32) -> void {
    std.mem.writeU16Little(bytes, offset, @intCast(u16, value & 65535))
}

pub fn load16(bytes: [*]const u8, offset: usize) -> u32 {
    return @intCast(u32, std.mem.readU16Little(bytes, offset))
}

// A signed 32-bit field.
pub fn loadInt(bytes: [*]const u8, offset: usize) -> i32 {
    const value = std.mem.readU32Little(bytes, offset)
    if value < 2147483648 { return @intCast(i32, value) }
    return 0 - @intCast(i32, 4294967295 - value) - 1
}

// open(2), close-on-exec.
pub fn openPath(path: [*]const u8, flags: usize) -> isize {
    return linux.open(path, flags | linux.O_CLOEXEC, 0)
}

// ---------------------------------------------------------------------------
// Files

pub const Stat = struct {
    mode: u32
    major: u32
    minor: u32
}

fn decodeStat(bytes: [*]const u8, result: *Stat) -> void {
    result.*.mode = std.mem.readU32Little(bytes, 24)
    const number = std.mem.readU64Little(bytes, 40)
    result.*.major = @intCast(u32, ((number >> 8) & 4095) | ((number >> 32) & 4294963200))
    result.*.minor = @intCast(u32, (number & 255) | ((number >> 12) & 4294967040))
}

// stat(2) of a path: its type and, for device nodes, the device number.
pub fn statPath(path: [*]const u8, result: *Stat) -> bool {
    var buffer: [144]u8 = undefined
    const bytes: [*]u8 = &buffer
    if linux.syscall4(linux.SYS_newfstatat, linux.AT_FDCWD, @intFromPtr(path), @intFromPtr(bytes), 0) < 0 { return false }
    decodeStat(bytes, result)
    return true
}

// A device number (dev_t) as the kernel's new encoding has it.
pub fn deviceNumber(major: u32, minor: u32) -> usize {
    const high = @intCast(usize, major)
    const low = @intCast(usize, minor)
    return ((high & 4294963200) << 32) | ((high & 4095) << 8) | ((low & 4294967040) << 12) | (low & 255)
}

pub fn deviceMajor(number: usize) -> u32 { return @intCast(u32, ((number >> 8) & 4095) | ((number >> 32) & 4294963200)) }
pub fn deviceMinor(number: usize) -> u32 { return @intCast(u32, (number & 255) | ((number >> 12) & 4294967040)) }

pub fn isCharacterDevice(value: *const Stat) -> bool { return value.*.mode & linux.S_IFMT == linux.S_IFCHR }

fn isSocket(descriptor: isize) -> bool {
    var buffer: [144]u8 = undefined
    const bytes: [*]u8 = &buffer
    if linux.syscall2(linux.SYS_fstat, @bitCast(usize, descriptor), @intFromPtr(bytes)) < 0 { return false }
    return std.mem.readU32Little(bytes, 24) & linux.S_IFMT == linux.S_IFSOCK
}

// ---------------------------------------------------------------------------
// Devices

pub const Device = struct {
    descriptor: isize
    emulated: bool
    // Emulated devices: bytes received but not yet framed, and data frames'
    // bytes waiting for read.
    pending: [*]u8
    pendingLength: usize
    data: [*]u8
    dataLength: usize
    // A descriptor that came with the last ioctl reply (-1: none).
    receivedDescriptor: isize
    // The emulating side closed its end (a revoked or removed device).
    hungUp: bool
}

// Takes ownership of `descriptor`. A real device is made nonblocking:
// read and the event loop count on EAGAIN, and a descriptor handed over by
// a session manager need not come that way (systemd-logind opens them with
// O_NONBLOCK, others may not; a blocking card left the compositor waiting
// in read(2) for a flip after its first frame, deaf to clients and keys).
pub fn init(device: *Device, descriptor: isize, allocator: std.allocator.Allocator) -> void {
    device.*.descriptor = descriptor
    device.*.emulated = isSocket(descriptor)
    if !device.*.emulated && descriptor >= 0 { _ = linux.setNonBlocking(descriptor) }
    device.*.pendingLength = 0
    device.*.dataLength = 0
    device.*.receivedDescriptor = -1
    device.*.hungUp = false
    if device.*.emulated {
        device.*.pending = allocator.alloc(BUFFER_SIZE, 16).?
        device.*.data = allocator.alloc(BUFFER_SIZE, 16).?
    }
}

pub fn deinit(device: *Device, allocator: std.allocator.Allocator) -> void {
    linux.close(device.*.descriptor)
    device.*.descriptor = -1
    if device.*.emulated {
        allocator.free(device.*.pending, BUFFER_SIZE, 16)
        allocator.free(device.*.data, BUFFER_SIZE, 16)
        device.*.emulated = false
    }
}

// Reads what the emulating socket has, filing complete frames: data frames
// into `data`, an ioctl reply's argument bytes into `reply` (returning
// true, with its result in `result`). Returns false when no reply came.
fn receiveFrames(device: *Device, reply: [*]u8, reply_size: usize, result: *isize) -> bool {
    var passed: [1]isize = [1]isize{ -1 }
    var count: usize = 0
    const received = linux.socket.receiveWithDescriptors(device.*.descriptor, device.*.pending + device.*.pendingLength, BUFFER_SIZE - device.*.pendingLength, &passed, 1, &count, linux.socket.MSG_DONTWAIT | linux.socket.MSG_CMSG_CLOEXEC)
    if received == 0 || (received < 0 && received != linux.EAGAIN) { device.*.hungUp = true }
    if received > 0 {
        device.*.pendingLength += @bitCast(usize, received)
        if count > 0 {
            linux.close(device.*.receivedDescriptor)
            device.*.receivedDescriptor = passed[0]
        }
    }
    var replied = false
    while device.*.pendingLength >= 8 {
        const kind = std.mem.readU32Little(device.*.pending, 0)
        const length = @intCast(usize, std.mem.readU32Little(device.*.pending, 4))
        if device.*.pendingLength < 8 + length { break }
        if kind == FRAME_DATA && device.*.dataLength + length <= BUFFER_SIZE {
            var index: usize = 0
            while index < length {
                device.*.data[device.*.dataLength + index] = device.*.pending[8 + index]
                index += 1
            }
            device.*.dataLength += length
        } else if kind == FRAME_IOCTL && length >= 8 {
            result.* = @bitCast(isize, std.mem.readU64Little(device.*.pending, 8))
            var index: usize = 0
            while index < length - 8 && index < reply_size {
                reply[index] = device.*.pending[16 + index]
                index += 1
            }
            replied = true
        }
        const rest = device.*.pendingLength - 8 - length
        var index: usize = 0
        while index < rest {
            device.*.pending[index] = device.*.pending[8 + length + index]
            index += 1
        }
        device.*.pendingLength = rest
        if replied { return true }
    }
    return false
}

// ioctl(2) with `size` bytes of argument at `argument` (updated in place).
// Returns the result, or a negative errno.
pub fn ioctl(device: *Device, request: usize, argument: [*]u8, size: usize) -> isize {
    if !device.*.emulated {
        var result: isize = linux.EINTR
        while result == linux.EINTR {
            result = linux.ioctl(device.*.descriptor, request, @intFromPtr(argument))
        }
        return result
    }
    // One frame: header, request, argument.
    var frame: [4096]u8 = undefined
    const bytes: [*]u8 = &frame
    if size + 16 > 4096 { return -22 }
    std.mem.writeU32Little(bytes, 0, FRAME_IOCTL)
    std.mem.writeU32Little(bytes, 4, @intCast(u32, 8 + size))
    std.mem.writeU64Little(bytes, 8, request)
    var index: usize = 0
    while index < size {
        bytes[16 + index] = argument[index]
        index += 1
    }
    var sent: usize = 0
    while sent < 16 + size {
        const count = linux.write(device.*.descriptor, bytes + sent, 16 + size - sent)
        if count < 0 && count != linux.EAGAIN && count != linux.EINTR { return linux.ENODEV }
        if count > 0 { sent += @bitCast(usize, count) }
        // A full socket: give the other side a millisecond.
        if count == linux.EAGAIN { _ = std.linux.event.waitReady(-1, false, 1) }
    }
    var result: isize = 0
    var waited: usize = 0
    while !receiveFrames(device, argument, size, &result) {
        if waited > 5000 || device.*.hungUp { return linux.ENODEV }
        if std.linux.event.waitReady(device.*.descriptor, false, 100) <= 0 { waited += 100 }
    }
    return result
}

// read(2): the device's next bytes, EAGAIN when there are none.
pub fn read(device: *Device, buffer: [*]u8, capacity: usize) -> isize {
    if !device.*.emulated {
        return linux.read(device.*.descriptor, buffer, capacity)
    }
    if device.*.dataLength == 0 {
        var ignored: isize = 0
        var none: [8]u8 = undefined
        const none_bytes: [*]u8 = &none
        _ = receiveFrames(device, none_bytes, 0, &ignored)
        if device.*.dataLength == 0 { return if device.*.hungUp { linux.ENODEV } else { linux.EAGAIN } }
    }
    var count = device.*.dataLength
    if count > capacity { count = capacity }
    var index: usize = 0
    while index < count {
        buffer[index] = device.*.data[index]
        index += 1
    }
    const rest = device.*.dataLength - count
    index = 0
    while index < rest {
        device.*.data[index] = device.*.data[count + index]
        index += 1
    }
    device.*.dataLength = rest
    return @bitCast(isize, count)
}

// Whether read would return bytes without waiting (emulated devices keep
// what arrived during an ioctl).
pub fn hasBufferedData(device: *const Device) -> bool {
    return device.*.emulated && device.*.dataLength > 0
}

// The descriptor that came with the last ioctl reply of an emulated device
// (-1 when none, or a real device): the caller owns it from now on.
pub fn takeDescriptor(device: *Device) -> isize {
    const descriptor = device.*.receivedDescriptor
    device.*.receivedDescriptor = -1
    return descriptor
}

// Maps `size` bytes of a DRM dumb buffer: at `offset` of the card, or, on
// an emulated card, the memfd that came with the MAP_DUMB reply. Returns
// the address, or 0.
pub fn mapBuffer(device: *Device, offset: usize, size: usize) -> usize {
    var descriptor = device.*.descriptor
    var position = offset
    if device.*.emulated {
        descriptor = device.*.receivedDescriptor
        position = 0
        if descriptor < 0 { return 0 }
    }
    const address = linux.mmap(0, size, linux.PROT_READ | linux.PROT_WRITE, linux.MAP_SHARED, descriptor, position)
    if device.*.emulated {
        linux.close(descriptor)
        device.*.receivedDescriptor = -1
    }
    if address < 0 { return 0 }
    return @bitCast(usize, address)
}

pub fn unmap(address: usize, size: usize) -> void {
    linux.munmap(address, size)
}
