// Scrollable tiling, the way niri lays windows out: on a workspace with
// tiling on, every window is a column on a strip that may be wider than
// the screen; the columns stand side by side from the left, GAP pixels
// apart and from the work area's edges, each as tall as the work area
// allows and as wide as its column (a third, half or two thirds of the
// width by default). The strip scrolls (workspaceView) so that the
// focused column is in sight; a new window opens as a column after the
// focused one; closing one closes the gap. A floating window turning into
// a column keeps its rectangle (floatX..) for the way back. Columns glide
// to their places (animation.mlx), except while fingers on a touchpad
// drag the strip along: then it follows them, and settles on a column
// when they lift.
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const shell = @import("./shell.mlx")
const windows_module = @import("./windows.mlx")
const workspaces_module = @import("./workspaces.mlx")
const animation_module = @import("./animation.mlx")

const Compositor = state.Compositor
const Surface = state.Surface
const Vector = state.Vector

pub const GAP: i32 = 8
// A column is at least this wide.
const MIN_WIDTH: i32 = 160

fn columnsOf(compositor: *Compositor, workspace: usize) -> *Vector {
    var pointer: *Vector = undefined
    unsafe { pointer = @ptrCast(*Vector, &compositor.*.columns[workspace]) }
    return pointer
}

pub fn isOn(compositor: *const Compositor, workspace: usize) -> bool {
    return workspace < state.MAX_WORKSPACES && compositor.*.workspaceTiling[workspace]
}

// The width the columns share (the work area without the outer gaps).
fn stripWidth(compositor: *const Compositor) -> i32 {
    return scene.workArea(compositor).width - 2 * GAP
}

// The width of `count` equal columns filling the strip.
fn presetWidth(compositor: *const Compositor, count: i32) -> i32 {
    return (stripWidth(compositor) - GAP * (count - 1)) / count
}

// A column's width: its own, else half the strip.
fn widthOf(compositor: *const Compositor, surface: *const Surface) -> i32 {
    var width = surface.*.columnWidth
    if width <= 0 { width = presetWidth(compositor, 2) }
    const widest = stripWidth(compositor)
    if width > widest { width = widest }
    if width < MIN_WIDTH { width = MIN_WIDTH }
    return width
}

// The strip's whole width (every column and the gaps between them).
fn totalWidth(compositor: *Compositor, workspace: usize) -> i32 {
    const columns = columnsOf(compositor, workspace)
    var total: i32 = 0
    var index: usize = 0
    while index < columns.*.length {
        if index > 0 { total += GAP }
        total += widthOf(compositor, state.surfaceAt(state.listAt(columns.*, index)))
        index += 1
    }
    return total
}

// Where column `position` starts on the strip (from its left end).
fn columnStart(compositor: *Compositor, workspace: usize, position: usize) -> i32 {
    const columns = columnsOf(compositor, workspace)
    var start: i32 = 0
    var index: usize = 0
    while index < position && index < columns.*.length {
        start += widthOf(compositor, state.surfaceAt(state.listAt(columns.*, index))) + GAP
        index += 1
    }
    return start
}

fn clampView(compositor: *Compositor, workspace: usize) -> void {
    const most = totalWidth(compositor, workspace) - stripWidth(compositor)
    var view = compositor.*.workspaceView[workspace]
    if view > most { view = most }
    if view < 0 { view = 0 }
    compositor.*.workspaceView[workspace] = view
}

// Puts every column of the workspace where the strip and the view say
// (gliding there), and asks each window for its column's size when that
// changed.
pub fn layout(compositor: *Compositor, workspace: usize) -> void {
    arrange(compositor, workspace, true)
}

// The same at once (the strip follows fingers).
fn layoutNow(compositor: *Compositor, workspace: usize) -> void {
    arrange(compositor, workspace, false)
}

fn arrange(compositor: *Compositor, workspace: usize, animate: bool) -> void {
    if workspace >= state.MAX_WORKSPACES || !compositor.*.workspaceTiling[workspace] { return }
    clampView(compositor, workspace)
    const area = scene.workArea(compositor)
    const columns = columnsOf(compositor, workspace)
    var x = area.x + GAP - compositor.*.workspaceView[workspace]
    var index: usize = 0
    while index < columns.*.length {
        const surface = state.surfaceAt(state.listAt(columns.*, index))
        const width = widthOf(compositor, surface)
        if !surface.*.fullscreen {
            const frame = scene.frameWidth(surface)
            const title = scene.titleHeight(surface)
            const inner_width = width - 2 * frame
            const inner_height = area.height - 2 * GAP - 2 * frame - title
            const window_x = x + frame
            const window_y = area.y + GAP + frame + title
            const resized = surface.*.configuredWidth != inner_width || surface.*.configuredHeight != inner_height
            const moved = animation_module.restX(surface) != window_x || animation_module.restY(surface) != window_y
            if resized {
                surface.*.configuredWidth = inner_width
                surface.*.configuredHeight = inner_height
                windows_module.configureToplevel(surface)
            }
            if animate {
                if moved { animation_module.glide(surface, window_x, window_y) }
            } else {
                animation_module.stop(surface)
                windows_module.moveWindowTo(surface, window_x, window_y)
            }
            if (resized || moved) && compositor.*.verbose {
                state.say("column: ")
                state.sayTitle(surface)
                state.say(" at ")
                state.sayInteger(x)
                state.say(" width ")
                state.sayInteger(width)
                state.say("\n")
            }
        }
        x += width + GAP
        index += 1
    }
}

pub fn layoutAll(compositor: *Compositor) -> void {
    var workspace: usize = 0
    while workspace < state.MAX_WORKSPACES {
        layout(compositor, workspace)
        workspace += 1
    }
}

// Scrolls the strip so that the column of `surface` is in sight.
pub fn reveal(compositor: *Compositor, surface: *Surface) -> void {
    if !surface.*.tiled { return }
    const workspace = surface.*.workspace
    const columns = columnsOf(compositor, workspace)
    const position = state.listIndexOf(columns.*, state.addressOfSurface(surface))
    if position >= columns.*.length { return }
    const start = columnStart(compositor, workspace, position)
    const width = widthOf(compositor, surface)
    const visible = stripWidth(compositor)
    var view = compositor.*.workspaceView[workspace]
    if start < view { view = start }
    if start + width > view + visible { view = start + width - visible }
    compositor.*.workspaceView[workspace] = view
    layout(compositor, workspace)
}

// The floating rectangle a window had before it became a column.
fn keepFloat(surface: *Surface) -> void {
    if surface.*.hasFloat { return }
    surface.*.hasFloat = true
    surface.*.floatX = animation_module.restX(surface)
    surface.*.floatY = animation_module.restY(surface)
    surface.*.floatWidth = scene.windowWidth(surface)
    surface.*.floatHeight = scene.windowHeight(surface)
}

// A column again a floating window: where it was.
fn restoreFloat(surface: *Surface) -> void {
    surface.*.tiled = false
    if !surface.*.hasFloat { return }
    surface.*.hasFloat = false
    surface.*.configuredWidth = surface.*.floatWidth
    surface.*.configuredHeight = surface.*.floatHeight
    animation_module.glide(surface, surface.*.floatX, surface.*.floatY)
    windows_module.configureToplevel(surface)
}

// Makes `surface` a column of its workspace, after the focused column (or
// at the end); nothing for a window that is one already, or not a window.
pub fn add(compositor: *Compositor, surface: *Surface) -> void {
    if surface.*.tiled || !windows_module.isWindow(surface) || !surface.*.mapped { return }
    const workspace = surface.*.workspace
    if !compositor.*.workspaceTiling[workspace] { return }
    keepFloat(surface)
    surface.*.tiled = true
    surface.*.snapped = state.SNAP_NONE
    // A column is never maximized: the state goes with the next configure.
    surface.*.maximized = false
    const columns = columnsOf(compositor, workspace)
    const address = state.addressOfSurface(surface)
    var position = columns.*.length
    const focused = compositor.*.keyboardFocus
    if focused != 0 && focused != address {
        const after = state.listIndexOf(columns.*, focused)
        if after < columns.*.length { position = after + 1 }
    }
    columns.* = state.listInsert(columns.*, position, address)
    layout(compositor, workspace)
    reveal(compositor, surface)
}

// Takes `surface` out of its workspace's columns (when it leaves the
// workspace, is unmapped or minimized, or the tiling goes); it floats
// where it did before.
pub fn remove(compositor: *Compositor, surface: *Surface) -> void {
    if !surface.*.tiled { return }
    const workspace = surface.*.workspace
    const columns = columnsOf(compositor, workspace)
    columns.* = state.listRemove(columns.*, state.addressOfSurface(surface))
    restoreFloat(surface)
    layout(compositor, workspace)
}

// Takes `surface` out of the columns without a word to its client (it is
// unmapped, perhaps destroyed); the rest close the gap.
pub fn forget(compositor: *Compositor, surface: *Surface) -> void {
    surface.*.hasFloat = false
    if !surface.*.tiled { return }
    surface.*.tiled = false
    const workspace = surface.*.workspace
    const columns = columnsOf(compositor, workspace)
    columns.* = state.listRemove(columns.*, state.addressOfSurface(surface))
    layout(compositor, workspace)
}

// After a column's commit: back where its column is (a client that
// changed its window geometry moved its window).
pub fn place(surface: *Surface) -> void {
    const compositor = surface.*.compositor
    const workspace = surface.*.workspace
    if surface.*.fullscreen || !compositor.*.workspaceTiling[workspace] { return }
    const columns = columnsOf(compositor, workspace)
    const position = state.listIndexOf(columns.*, state.addressOfSurface(surface))
    if position >= columns.*.length { return }
    const area = scene.workArea(compositor)
    const frame = scene.frameWidth(surface)
    const x = area.x + GAP - compositor.*.workspaceView[workspace] + columnStart(compositor, workspace, position)
    const window_x = x + frame
    const window_y = area.y + GAP + frame + scene.titleHeight(surface)
    // (A glide there goes on.)
    if surface.*.gliding && surface.*.glideToX == window_x && surface.*.glideToY == window_y { return }
    if compositor.*.fingerScrolling && workspace == compositor.*.workspace {
        windows_module.moveWindowTo(surface, window_x, window_y)
        return
    }
    animation_module.glide(surface, window_x, window_y)
}

// Turns tiling on or off for a workspace: on, its windows become columns
// in their stacking order (bottom first); off, they float where they were.
pub fn set(compositor: *Compositor, workspace: usize, on: bool) -> void {
    if workspace >= state.MAX_WORKSPACES || compositor.*.workspaceTiling[workspace] == on { return }
    windows_module.endInteraction(compositor)
    compositor.*.workspaceTiling[workspace] = on
    compositor.*.workspaceView[workspace] = 0
    if on {
        var index: usize = 0
        while index < compositor.*.stack.length {
            const surface = state.surfaceAt(state.listAt(compositor.*.stack, index))
            if surface.*.role == state.ROLE_TOPLEVEL && windows_module.isWindow(surface) && surface.*.workspace == workspace && !surface.*.minimized && !surface.*.fullscreen { add(compositor, surface) }
            index += 1
        }
        layout(compositor, workspace)
        const focused = compositor.*.keyboardFocus
        if focused != 0 && state.surfaceAt(focused).*.tiled { reveal(compositor, state.surfaceAt(focused)) }
    } else {
        const columns = columnsOf(compositor, workspace)
        while columns.*.length > 0 {
            const surface = state.surfaceAt(state.listAt(columns.*, columns.*.length - 1))
            columns.* = state.listRemove(columns.*, state.addressOfSurface(surface))
            restoreFloat(surface)
        }
    }
    scene.damageAll(compositor)
    workspaces_module.notifyTopbar(compositor)
    if compositor.*.verbose {
        state.say(if on { "tiling: on (workspace " } else { "tiling: off (workspace " })
        state.sayNumber(workspace + 1)
        state.say(")\n")
    }
}

pub fn toggle(compositor: *Compositor, workspace: usize) -> void {
    if workspace >= state.MAX_WORKSPACES { return }
    set(compositor, workspace, !compositor.*.workspaceTiling[workspace])
}

// The settings' `tiling`: workspaces without windows start that way.
pub fn applyDefault(compositor: *Compositor) -> void {
    var workspace: usize = 0
    while workspace < state.MAX_WORKSPACES {
        if workspaces_module.windowCount(compositor, workspace) == 0 && compositor.*.workspaceTiling[workspace] != compositor.*.tilingDefault {
            compositor.*.workspaceTiling[workspace] = compositor.*.tilingDefault
            compositor.*.workspaceView[workspace] = 0
        }
        workspace += 1
    }
    workspaces_module.notifyTopbar(compositor)
}

// Focuses the column left (or right) of the focused one.
pub fn focusNeighbour(compositor: *Compositor, right: bool) -> void {
    const focused = compositor.*.keyboardFocus
    const workspace = compositor.*.workspace
    const columns = columnsOf(compositor, workspace)
    if columns.*.length == 0 { return }
    var position = if focused != 0 { state.listIndexOf(columns.*, focused) } else { columns.*.length }
    if position >= columns.*.length {
        position = if right { 0 } else { columns.*.length - 1 }
    } else if right {
        if position + 1 >= columns.*.length { return }
        position += 1
    } else {
        if position == 0 { return }
        position -= 1
    }
    windows_module.focus(compositor, state.listAt(columns.*, position))
}

// Moves the column of `surface` one place left (or right).
pub fn moveColumn(compositor: *Compositor, surface: *Surface, right: bool) -> void {
    if !surface.*.tiled { return }
    const workspace = surface.*.workspace
    const columns = columnsOf(compositor, workspace)
    const address = state.addressOfSurface(surface)
    const position = state.listIndexOf(columns.*, address)
    if position >= columns.*.length { return }
    if right && position + 1 >= columns.*.length { return }
    if !right && position == 0 { return }
    const target = if right { position + 1 } else { position - 1 }
    columns.* = state.listRemove(columns.*, address)
    columns.* = state.listInsert(columns.*, target, address)
    layout(compositor, workspace)
    reveal(compositor, surface)
}

// The next of a third, half and two thirds of the strip for the column.
pub fn cycleWidth(compositor: *Compositor, surface: *Surface) -> void {
    if !surface.*.tiled { return }
    const third = presetWidth(compositor, 3)
    const half = presetWidth(compositor, 2)
    const two_thirds = stripWidth(compositor) - third - GAP
    const current = widthOf(compositor, surface)
    var next = third
    if current < third - 1 { next = third } else if current < half - 1 { next = half } else if current < two_thirds - 1 { next = two_thirds } else { next = third }
    surface.*.columnWidth = next
    layout(compositor, surface.*.workspace)
    reveal(compositor, surface)
    if compositor.*.verbose {
        state.say("column width: ")
        state.sayInteger(next)
        state.say(" ")
        state.sayTitle(surface)
        state.say("\n")
    }
}

// A column as wide as the strip, or back to half (maximize on a column).
pub fn toggleFull(compositor: *Compositor, surface: *Surface) -> void {
    if !surface.*.tiled { return }
    const full = stripWidth(compositor)
    surface.*.columnWidth = if widthOf(compositor, surface) >= full { presetWidth(compositor, 2) } else { full }
    layout(compositor, surface.*.workspace)
    reveal(compositor, surface)
}

// The column of `surface` `width` pixels wide (a border dragged).
pub fn resizeColumn(compositor: *Compositor, surface: *Surface, width: i32) -> void {
    if !surface.*.tiled { return }
    var wanted = width
    if wanted < MIN_WIDTH { wanted = MIN_WIDTH }
    if wanted > stripWidth(compositor) { wanted = stripWidth(compositor) }
    surface.*.columnWidth = wanted
    layout(compositor, surface.*.workspace)
}

// A column dragged by its title: past the middle of its neighbour it
// takes that neighbour's place.
pub fn drag(compositor: *Compositor, surface: *Surface, pointer_x: i32) -> void {
    if !surface.*.tiled { return }
    const workspace = surface.*.workspace
    const columns = columnsOf(compositor, workspace)
    const address = state.addressOfSurface(surface)
    const position = state.listIndexOf(columns.*, address)
    if position >= columns.*.length { return }
    const area = scene.workArea(compositor)
    const left_edge = area.x + GAP - compositor.*.workspaceView[workspace]
    if position > 0 {
        const neighbour = state.surfaceAt(state.listAt(columns.*, position - 1))
        const middle = left_edge + columnStart(compositor, workspace, position - 1) + widthOf(compositor, neighbour) / 2
        if pointer_x < middle {
            moveColumn(compositor, surface, false)
            return
        }
    }
    if position + 1 < columns.*.length {
        const neighbour = state.surfaceAt(state.listAt(columns.*, position + 1))
        const middle = left_edge + columnStart(compositor, workspace, position + 1) + widthOf(compositor, neighbour) / 2
        if pointer_x > middle { moveColumn(compositor, surface, true) }
    }
}

// Fingers scroll the current workspace's strip by `delta` pixels: it
// follows them at once.
pub fn scroll(compositor: *Compositor, delta: i32) -> void {
    const workspace = compositor.*.workspace
    if !compositor.*.workspaceTiling[workspace] { return }
    // How fast (the last moves count most).
    const now = state.microseconds()
    const elapsed = now - compositor.*.fingerScrolledAt
    if compositor.*.fingerScrolledAt != 0 && elapsed > 0 && elapsed < 100000 {
        const speed = @intCast(i32, @intCast(i64, delta) * 1000000 / @intCast(i64, elapsed))
        compositor.*.fingerVelocity = (speed * 3 + compositor.*.fingerVelocity) / 4
    } else {
        compositor.*.fingerVelocity = 0
    }
    compositor.*.fingerScrolledAt = now
    compositor.*.workspaceView[workspace] += delta
    layoutNow(compositor, workspace)
}

// How far a strip let go while it moves goes on: as far as it would in
// MOMENTUM_MICROS at that speed (it stops being a flick when the fingers
// rested a while before lifting).
const MOMENTUM_MICROS: i64 = 250000
const FLICK_PAUSE: usize = 120000

fn momentum(compositor: *Compositor) -> i32 {
    if compositor.*.fingerScrolledAt == 0 || state.microseconds() - compositor.*.fingerScrolledAt > FLICK_PAUSE { return 0 }
    return @intCast(i32, @intCast(i64, compositor.*.fingerVelocity) * MOMENTUM_MICROS / 1000000)
}

// The fingers lifted: the strip settles with a column's left edge at the
// strip's (the one nearest where the view is, or would be after a flick;
// the last ones as far as the strip goes), and that column takes the
// focus.
pub fn settle(compositor: *Compositor) -> void {
    const workspace = compositor.*.workspace
    const columns = columnsOf(compositor, workspace)
    const thrown = momentum(compositor)
    compositor.*.fingerScrolledAt = 0
    compositor.*.fingerVelocity = 0
    if !compositor.*.workspaceTiling[workspace] || columns.*.length == 0 { return }
    const view = compositor.*.workspaceView[workspace] + thrown
    var most = totalWidth(compositor, workspace) - stripWidth(compositor)
    if most < 0 { most = 0 }
    var nearest: usize = 0
    var nearest_view: i32 = 0
    var best: i32 = 0
    var index: usize = 0
    while index < columns.*.length {
        var candidate = columnStart(compositor, workspace, index)
        if candidate > most { candidate = most }
        const distance = if candidate > view { candidate - view } else { view - candidate }
        if index == 0 || distance < best {
            nearest = index
            nearest_view = candidate
            best = distance
        }
        index += 1
    }
    compositor.*.workspaceView[workspace] = nearest_view
    layout(compositor, workspace)
    const address = state.listAt(columns.*, nearest)
    if compositor.*.keyboardFocus != address { windows_module.focus(compositor, address) }
    if compositor.*.verbose {
        state.say("settled on column ")
        state.sayNumber(nearest + 1)
        state.say(": ")
        state.sayTitle(state.surfaceAt(address))
        state.say("\n")
    }
}
