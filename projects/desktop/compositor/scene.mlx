// Scene management and software composition for the compositor.
//
// Windows are drawn bottom to top into the output buffer with premultiplied
// ARGB8888 blending (the wl_shm pixel convention), each with a thin frame
// that highlights the keyboard focus, followed by the cursor: the client's
// cursor surface when one is set, otherwise a built-in arrow.
//
// Only what changed is drawn: every change to the scene reports the area
// it affects (damageRect, damageSurface, damageContent, damageCursor,
// damageAll), the backend asks takeDamage what its frame slot lacks (a
// slot shown two frames ago lacks two frames' changes), and compose draws
// that clip only. The blur behind a surface is kept from frame to frame
// and made again only where what lies below the surface changed (see
// Blur).

const std = @import("std")
const state = @import("./state.mlx")
const cursors = @import("./cursors.mlx")
const preview_layout = @import("./preview_layout.mlx")
const tt = @import("std.truetype")
const ui = @import("std.ui")
const ui_scheme = @import("std.ui.scheme")
const background = @import("./background.mlx")

const Compositor = state.Compositor
const Surface = state.Surface

// The title bars' colours when nothing names them (settings border-color
// and inactive-border-color name them; without, they follow the
// desktop's colours: schemeFocusColor, schemeFrameColor). Both are drawn
// TITLE_ALPHA opaque over what is behind, blurred behind the bar
// (title-opacity, title-blur): a tinted glass.
pub const FOCUS_COLOR: u32 = 4284129535
pub const FRAME_COLOR: u32 = 4283453536
pub const TITLE_ALPHA: u32 = 214
pub const TITLE_HEIGHT: i32 = 22
pub const TITLE_TEXT_SIZE: u32 = 14
pub const TITLE_COLOR: u32 = 4294967295
// An unfocused window's title and button symbols.
pub const TITLE_INACTIVE_COLOR: u32 = 4288980132
// The prism line along the top of the focused window's bar (pixels).
pub const PRISM_LINE: i32 = 2

// The title bar's buttons (settings title-buttons): which, where. Each is
// a chip (a rounded rectangle, TITLE_BUTTON_WIDTH x TITLE_BUTTON_HEIGHT)
// with a thin symbol; under the pointer the chip lights up in its colour
// (minimize and maximize the prism's first and second, close a red).
pub const TITLE_BUTTON_NONE: u8 = 0
pub const TITLE_BUTTON_CLOSE: u8 = 1
pub const TITLE_BUTTON_MINIMIZE: u8 = 2
pub const TITLE_BUTTON_MAXIMIZE: u8 = 3
pub const TITLE_BUTTON_WIDTH: i32 = 22
pub const TITLE_BUTTON_HEIGHT: i32 = 16
pub const TITLE_BUTTON_GAP: i32 = 2
pub const TITLE_BUTTON_MARGIN: i32 = 4
pub const TITLE_BUTTON_RADIUS: i32 = 5
pub const BUTTON_CLOSE_COLOR: u32 = 4293209165
pub const ARROW_WIDTH: i32 = 13
pub const ARROW_HEIGHT: i32 = 17

// xdg_toplevel.ResizeEdge bits.
pub const EDGE_TOP: u32 = 1
pub const EDGE_BOTTOM: u32 = 2
pub const EDGE_LEFT: u32 = 4
pub const EDGE_RIGHT: u32 = 8
// How far outside its frame a window's border can be grabbed, and how far
// along an edge from a corner a grab still takes the corner.
pub const GRAB: i32 = 6
pub const CORNER: i32 = 16


// Where a surface's buffer starts on the output: its position, or, for a
// subsurface, its offset from its parent's origin.
pub fn originX(surface: *const Surface) -> i32 {
    var total: i32 = 0
    var current = surface
    var depth: usize = 0
    while current.*.role == state.ROLE_SUBSURFACE && current.*.parent != 0 && depth < 16 {
        total += current.*.subX
        current = state.surfaceAt(current.*.parent)
        depth += 1
    }
    return total + current.*.x
}

pub fn originY(surface: *const Surface) -> i32 {
    var total: i32 = 0
    var current = surface
    var depth: usize = 0
    while current.*.role == state.ROLE_SUBSURFACE && current.*.parent != 0 && depth < 16 {
        total += current.*.subY
        current = state.surfaceAt(current.*.parent)
        depth += 1
    }
    return total + current.*.y
}

// The window rectangle used for hit-testing, frames and placement: the
// xdg window geometry when the client set one, otherwise the buffer.
pub fn windowX(surface: *const Surface) -> i32 {
    return if surface.*.hasGeometry { surface.*.x + surface.*.geometryX } else { surface.*.x }
}

pub fn windowY(surface: *const Surface) -> i32 {
    return if surface.*.hasGeometry { surface.*.y + surface.*.geometryY } else { surface.*.y }
}

pub fn windowWidth(surface: *const Surface) -> i32 {
    return if surface.*.hasGeometry { surface.*.geometryWidth } else { @intCast(i32, surface.*.pixelWidth) }
}

pub fn windowHeight(surface: *const Surface) -> i32 {
    return if surface.*.hasGeometry { surface.*.geometryHeight } else { @intCast(i32, surface.*.pixelHeight) }
}

// How tall a toplevel's title bar is: TITLE_HEIGHT, or 0 when the settings
// turned title bars off.
pub fn titleHeight(surface: *const Surface) -> i32 {
    if surface.*.fullscreen || surface.*.undecorated { return 0 }
    return if surface.*.compositor.*.titleBars { TITLE_HEIGHT } else { 0 }
}

// The frame around a toplevel: 2 pixels, none when fullscreen.
pub fn frameWidth(surface: *const Surface) -> i32 { return if surface.*.fullscreen || surface.*.undecorated { 0 } else { 2 } }

// Whether `surface` belongs to a screen locker's lock surface
// (lock.mlx): while the session is locked, nothing else is drawn or hit.
pub fn lockSurfaceOf(surface: *const Surface) -> bool {
    var current = surface
    var depth: usize = 0
    while current.*.parent != 0 && depth < 16 {
        current = state.surfaceAt(current.*.parent)
        depth += 1
    }
    return current.*.role == state.ROLE_LOCK
}

// Whether this surface belongs to the client launched through --greeter's
// private socket.  Pointer comparison is safe here: ClientState lives for
// the connection and every surface keeps its client object.
pub fn greeterSurfaceOf(surface: *const Surface) -> bool {
    const compositor = surface.*.compositor
    return compositor.*.greeterClient != 0 && @intFromPtr(surface.*.resource.client.state) == compositor.*.greeterClient
}

// Whether the window at `address` (a toplevel or anything of its) is
// minimized or on another workspace, or a restricted screen belongs to a
// different client: not drawn, not hit.
pub fn hidden(address: usize) -> bool {
    const surface = state.surfaceAt(address)
    if surface.*.dismissed { return true }
    if surface.*.compositor.*.greeterMode && !greeterSurfaceOf(surface) { return true }
    if surface.*.compositor.*.locked && !lockSurfaceOf(surface) { return true }
    const toplevel = toplevelOf(address)
    if toplevel == 0 { return false }
    const window = state.surfaceAt(toplevel)
    return window.*.minimized || window.*.workspace != window.*.compositor.*.workspace
}

// Whether the renderers draw what is at `address` now: what is not
// hidden, and while they animate (animation.mlx) the windows of the
// workspace sliding out and a window leaving for another workspace. Input
// and focus go by `hidden` alone.
pub fn shown(address: usize) -> bool {
    if !hidden(address) { return true }
    const surface = state.surfaceAt(address)
    if surface.*.dismissed || surface.*.compositor.*.locked { return false }
    if surface.*.compositor.*.greeterMode && !greeterSurfaceOf(surface) { return false }
    const toplevel = toplevelOf(address)
    if toplevel == 0 { return false }
    const window = state.surfaceAt(toplevel)
    if window.*.minimized { return false }
    if window.*.departStart != 0 { return true }
    const compositor = window.*.compositor
    return compositor.*.slideStart != 0 && window.*.workspace == compositor.*.slideFrom
}

// How far what is at `address` is drawn off its place (animation.mlx): a
// sliding workspace's windows by its offset (sideways, or up and down for
// a vertical slide), a leaving window by its own (sideways).
fn slideShiftOf(compositor: *const Compositor, window: *const Surface) -> i32 {
    if compositor.*.slideStart == 0 { return 0 }
    if window.*.workspace == compositor.*.workspace { return compositor.*.slideNew }
    if window.*.workspace == compositor.*.slideFrom { return compositor.*.slideOld }
    return 0
}

fn shiftXOf(compositor: *const Compositor, address: usize) -> i32 {
    const toplevel = toplevelOf(address)
    if toplevel == 0 { return 0 }
    const window = state.surfaceAt(toplevel)
    if window.*.departStart != 0 { return window.*.departOffset }
    if compositor.*.slideVertical { return 0 }
    return slideShiftOf(compositor, window)
}

fn shiftYOf(compositor: *const Compositor, address: usize) -> i32 {
    if !compositor.*.slideVertical { return 0 }
    const toplevel = toplevelOf(address)
    if toplevel == 0 { return 0 }
    const window = state.surfaceAt(toplevel)
    if window.*.departStart != 0 { return 0 }
    return slideShiftOf(compositor, window)
}

// Moves every window that is drawn off its place there (`sign` 1) or
// back (-1): the renderers compose between the two, so everything they
// draw a window with (its frame, its buffers, its popups) follows, and
// nothing else sees the offset. Subsurfaces sit relative to their parent.
pub fn shiftWindows(compositor: *Compositor, sign: i32) -> void {
    if !compositor.*.shifting { return }
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const address = state.listAt(compositor.*.surfaces, index)
        const surface = state.surfaceAt(address)
        if surface.*.role != state.ROLE_SUBSURFACE {
            surface.*.x += sign * shiftXOf(compositor, address)
            surface.*.y += sign * shiftYOf(compositor, address)
        }
        index += 1
    }
}

// The output without what docks and panels reserve: where maximized
// windows go.
pub fn workArea(compositor: *const Compositor) -> ui.Rect {
    return ui.rect(compositor.*.reserveLeft, compositor.*.reserveTop, @intCast(i32, compositor.*.width) - compositor.*.reserveLeft - compositor.*.reserveRight, @intCast(i32, compositor.*.height) - compositor.*.reserveTop - compositor.*.reserveBottom)
}

// ---------------------------------------------------------------------------
// Rounded corners

// The corner radius windows get by default (settings: corner-radius):
// libadwaita's, the look of GNOME's GTK 4 programs, 12 pixels. At most
// TITLE_HEIGHT, so the frame's curve stays within the title bar.
pub const CORNER_RADIUS: i32 = 12

// A rounded rectangle on the output: corners of `top` in its upper half,
// `bottom` in its lower half (the Vulkan blit shader's shapes).
pub const Shape = struct {
    x: i32
    y: i32
    width: i32
    height: i32
    top: i32
    bottom: i32
}

pub fn emptyShape() -> Shape { return Shape.{ .x = 0, .y = 0, .width = 0, .height = 0, .top = 0, .bottom = 0 } }

// ---------------------------------------------------------------------------
// Aero snap: where a window dragged to an edge of the work area goes

// The outer rectangle (frame and title bar included) a window snapped to
// `zone` takes: a half or a quarter of the work area, or all of it.
pub fn snapRect(compositor: *const Compositor, zone: u8) -> ui.Rect {
    const area = workArea(compositor)
    const half_width = area.width / 2
    const half_height = area.height / 2
    if zone == state.SNAP_LEFT { return ui.rect(area.x, area.y, half_width, area.height) }
    if zone == state.SNAP_RIGHT { return ui.rect(area.x + half_width, area.y, area.width - half_width, area.height) }
    if zone == state.SNAP_TOP_LEFT { return ui.rect(area.x, area.y, half_width, half_height) }
    if zone == state.SNAP_TOP_RIGHT { return ui.rect(area.x + half_width, area.y, area.width - half_width, half_height) }
    if zone == state.SNAP_BOTTOM_LEFT { return ui.rect(area.x, area.y + half_height, half_width, area.height - half_height) }
    if zone == state.SNAP_BOTTOM_RIGHT { return ui.rect(area.x + half_width, area.y + half_height, area.width - half_width, area.height - half_height) }
    return area
}

// The zone the pointer at (x, y) means while a window is dragged: the
// left or right edge of the work area a half, within SNAP_CORNER of a
// corner a quarter, the top edge maximized; SNAP_NONE elsewhere.
pub const SNAP_CORNER: i32 = 48

pub fn snapZoneAt(compositor: *const Compositor, x: i32, y: i32) -> u8 {
    const area = workArea(compositor)
    const at_left = x <= area.x + 1
    const at_right = x >= ui.right(area) - 2
    const at_top = y <= area.y + 1
    const near_top = y < area.y + SNAP_CORNER
    const near_bottom = y >= ui.bottom(area) - SNAP_CORNER
    const near_left = x < area.x + SNAP_CORNER
    const near_right = x >= ui.right(area) - SNAP_CORNER
    if at_left {
        if near_top { return state.SNAP_TOP_LEFT }
        if near_bottom { return state.SNAP_BOTTOM_LEFT }
        return state.SNAP_LEFT
    }
    if at_right {
        if near_top { return state.SNAP_TOP_RIGHT }
        if near_bottom { return state.SNAP_BOTTOM_RIGHT }
        return state.SNAP_RIGHT
    }
    if at_top {
        if near_left { return state.SNAP_TOP_LEFT }
        if near_right { return state.SNAP_TOP_RIGHT }
        return state.SNAP_TOP
    }
    return state.SNAP_NONE
}

// The translucent preview of where the dragged window would snap (both
// renderers draw it): the focus colour at three eighths, premultiplied
// as the surfaces' pixels are (the blit shader and blendPixel add it to
// what is behind, scaled down by its alpha).
// It grows out of the window when it appears (and out of the last zone
// when the zone changes), fading in: SNAP_LEVELS steps of opacity, the
// last SNAP_ALPHA (the Vulkan renderer keeps a palette row for each).
const SNAP_ALPHA: u32 = 96
pub const SNAP_LEVELS: u32 = 8
pub const SNAP_MICROS: usize = 180000

pub fn snapPreviewColor(compositor: *const Compositor, level: u32) -> u32 {
    const color = accentColor(compositor)
    const alpha = SNAP_ALPHA * (level + 1) / SNAP_LEVELS
    const red = (((color >> 16) & 255) * alpha + 127) / 255
    const green = (((color >> 8) & 255) * alpha + 127) / 255
    const blue = ((color & 255) * alpha + 127) / 255
    return (alpha << 24) | (red << 16) | (green << 8) | blue
}

// How far the preview has grown (0 to 1024; 1024 when it stands).
fn snapProgress(compositor: *const Compositor) -> i32 {
    if compositor.*.snapStart == 0 { return 1024 }
    return eased(state.microseconds() - compositor.*.snapStart, SNAP_MICROS * compositor.*.animationScale)
}

// The opacity step drawn now (0 to SNAP_LEVELS - 1).
pub fn snapPreviewLevel(compositor: *const Compositor) -> u32 {
    const t = snapProgress(compositor)
    const level = @intCast(u32, t) * SNAP_LEVELS / 1024
    return if level >= SNAP_LEVELS { SNAP_LEVELS - 1 } else { level }
}

// Where the preview is drawn now: from the rectangle it grows out of to
// the zone's.
pub fn snapRectNow(compositor: *const Compositor) -> ui.Rect {
    const area = snapRect(compositor, compositor.*.snapZone)
    const t = snapProgress(compositor)
    if t >= 1024 { return area }
    return ui.rect(between(compositor.*.snapFromX, area.x, t), between(compositor.*.snapFromY, area.y, t), between(compositor.*.snapFromWidth, area.width, t), between(compositor.*.snapFromHeight, area.height, t))
}

pub fn snapShape(compositor: *const Compositor) -> Shape {
    const area = snapRectNow(compositor)
    const radius = if compositor.*.cornerRadius < 0 { 0 } else { compositor.*.cornerRadius }
    return Shape.{ .x = area.x, .y = area.y, .width = area.width, .height = area.height, .top = radius, .bottom = radius }
}

pub fn snapPreviewShown(compositor: *const Compositor) -> bool {
    return compositor.*.snapZone != state.SNAP_NONE && compositor.*.moving != 0
}

fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }

// The radius of a toplevel's content: the setting, at most half its size.
fn contentRadius(surface: *const Surface) -> i32 {
    if surface.*.maximized || surface.*.fullscreen { return 0 }
    const radius = smaller(surface.*.compositor.*.cornerRadius, TITLE_HEIGHT)
    if radius <= 0 { return 0 }
    return smaller(radius, smaller(windowWidth(surface) / 2, windowHeight(surface) / 2))
}

// A toplevel's content: its window rectangle with rounded corners (the top
// ones square under a title bar). What its surfaces draw in the corners
// outside the curve is cut off; outside the rectangle (client shadows)
// nothing is.
pub fn contentShape(surface: *const Surface) -> Shape {
    const radius = contentRadius(surface)
    return Shape.{ .x = windowX(surface), .y = windowY(surface), .width = windowWidth(surface), .height = windowHeight(surface), .top = if titleHeight(surface) > 0 { 0 } else { radius }, .bottom = radius }
}

// The frame and title bar around it: 2 pixels wider on every side, the
// title bar on top, corners 2 pixels rounder (the same centres).
pub fn outerShape(surface: *const Surface) -> Shape {
    const radius = contentRadius(surface)
    const outer = if radius > 0 { radius + 2 } else { 0 }
    const title = titleHeight(surface)
    const frame = frameWidth(surface)
    return Shape.{ .x = windowX(surface) - frame, .y = windowY(surface) - frame - title, .width = windowWidth(surface) + frame * 2, .height = windowHeight(surface) + frame * 2 + title, .top = outer, .bottom = outer }
}

pub fn shapeCoverage(shape: *const Shape, x: i32, y: i32) -> u32 {
    const lx = x - shape.*.x
    const ly = y - shape.*.y
    return ui.roundedCoverage(lx, ly, shape.*.width, shape.*.height, if ly * 2 < shape.*.height { shape.*.top } else { shape.*.bottom })
}

fn inShape(shape: *const Shape, x: i32, y: i32) -> bool {
    return x >= shape.*.x && y >= shape.*.y && x < shape.*.x + shape.*.width && y < shape.*.y + shape.*.height
}

// A surface pixel of a toplevel at (x, y): cut by the content's corners
// (the shader's FLAG_CLIP_CORNERS).
fn clipCoverage(shape: *const Shape, x: i32, y: i32) -> u32 {
    if !inShape(shape, x, y) { return 255 }
    return shapeCoverage(shape, x, y)
}

// A frame pixel: in the outer shape, not in the content (FLAG_RING).
fn ringCoverage(outer: *const Shape, inner: *const Shape, x: i32, y: i32) -> u32 {
    const a = shapeCoverage(outer, x, y)
    const b = shapeCoverage(inner, x, y)
    return if a > b { a - b } else { 0 }
}

// The frame and title bar as four rectangles that hold each of its pixels
// once: the band above the content's straight sides (the title bar and
// the top corners), the band below, and the two sides between.
pub fn ringPieces(outer: *const Shape, inner: *const Shape, pieces: *[4]ui.Rect) -> void {
    const top_end = inner.*.y + inner.*.top
    const bottom_start = inner.*.y + inner.*.height - inner.*.bottom
    pieces.*[0] = ui.rect(outer.*.x, outer.*.y, outer.*.width, top_end - outer.*.y)
    pieces.*[1] = ui.rect(outer.*.x, bottom_start, outer.*.width, outer.*.y + outer.*.height - bottom_start)
    pieces.*[2] = ui.rect(outer.*.x, top_end, inner.*.x - outer.*.x, bottom_start - top_end)
    pieces.*[3] = ui.rect(inner.*.x + inner.*.width, top_end, outer.*.x + outer.*.width - inner.*.x - inner.*.width, bottom_start - top_end)
}

// A toplevel's title bar, above its frame: x, y, width (height titleHeight).
pub fn titleX(surface: *const Surface) -> i32 { return windowX(surface) - frameWidth(surface) }
pub fn titleY(surface: *const Surface) -> i32 { return windowY(surface) - frameWidth(surface) - titleHeight(surface) }
pub fn titleWidth(surface: *const Surface) -> i32 { return windowWidth(surface) + frameWidth(surface) * 2 }

// The title's text origin (pen start on the baseline): 4 pixels in, and
// half the corner radius more, clear of the rounded corner.
// After the buttons on the left, when there are some.
pub fn titleTextX(surface: *const Surface) -> i32 {
    const count = titleButtonCount(surface, true)
    if count > 0 { return titleX(surface) + TITLE_BUTTON_MARGIN + @intCast(i32, count) * (TITLE_BUTTON_WIDTH + TITLE_BUTTON_GAP) + 6 }
    return windowX(surface) + titleInset(surface)
}

fn titleInset(surface: *const Surface) -> i32 { return 6 + contentRadius(surface) / 2 }
// The baseline, the text's middle on the bar's.
pub fn titleTextY(surface: *const Surface) -> i32 { return titleY(surface) + titleHeight(surface) / 2 + 5 }

// Where the title must end: before the buttons on the right.
fn titleTextEnd(surface: *const Surface) -> i32 {
    const count = titleButtonCount(surface, false)
    if count > 0 { return titleX(surface) + titleWidth(surface) - TITLE_BUTTON_MARGIN - @intCast(i32, count) * (TITLE_BUTTON_WIDTH + TITLE_BUTTON_GAP) - 4 }
    return titleX(surface) + titleWidth(surface) - titleInset(surface)
}

// ---------------------------------------------------------------------------
// The desktop's colours (background.mlx: taken from the wallpaper or the
// colour the user chose; std.ui.scheme) on the title bars.

pub fn accentColor(compositor: *const Compositor) -> u32 { return 4278190080 | compositor.*.scheme.accent }

// The focused window's glass and the others': the scheme's tint, the
// focused one lighter.
pub fn schemeFocusColor(compositor: *const Compositor) -> u32 {
    const tint = ui_scheme.toHsl(compositor.*.scheme.tint)
    return ui_scheme.fromHsl(ui_scheme.Hsl.{ .hue = tint.hue, .saturation = if tint.saturation > 320 { 320 } else { tint.saturation }, .lightness = 225 })
}

pub fn schemeFrameColor(compositor: *const Compositor) -> u32 {
    const tint = ui_scheme.toHsl(compositor.*.scheme.tint)
    return ui_scheme.fromHsl(ui_scheme.Hsl.{ .hue = tint.hue, .saturation = if tint.saturation > 220 { 220 } else { tint.saturation }, .lightness = 150 })
}

// The prism line's colour at column `x` of the output: the gradient runs
// across the whole screen, so windows side by side light up as one.
pub fn prismAt(compositor: *const Compositor, x: i32) -> u32 {
    const width = @intCast(i32, compositor.*.width)
    const t = if width > 1 { x * 1024 / (width - 1) } else { 0 }
    return 4278190080 | ui_scheme.gradient(&compositor.*.scheme, t)
}

// A button's colour when lit (under the pointer).
pub fn titleButtonColor(compositor: *const Compositor, kind: u8) -> u32 {
    if kind == TITLE_BUTTON_CLOSE { return BUTTON_CLOSE_COLOR }
    if kind == TITLE_BUTTON_MINIMIZE { return 4278190080 | compositor.*.scheme.prism[0] }
    return 4278190080 | compositor.*.scheme.prism[1]
}

// ---------------------------------------------------------------------------
// Title bar buttons: close, minimize and maximize, in the order and on the
// side the settings put them (title-buttons).

// How many buttons the bar has on the left (or the right); none without a
// title bar.
pub fn titleButtonCount(surface: *const Surface, left: bool) -> usize {
    if titleHeight(surface) == 0 { return 0 }
    const compositor = surface.*.compositor
    return if left { compositor.*.titleButtonsLeftCount } else { compositor.*.titleButtonsRightCount }
}

// The `index`th button on the left (from the edge) or on the right (from
// the left), and its chip.
pub fn titleButtonKind(surface: *const Surface, left: bool, index: usize) -> u8 {
    const compositor = surface.*.compositor
    return if left { compositor.*.titleButtonsLeft[index] } else { compositor.*.titleButtonsRight[index] }
}

pub fn titleButtonShape(surface: *const Surface, left: bool, index: usize) -> Shape {
    const step = TITLE_BUTTON_WIDTH + TITLE_BUTTON_GAP
    var x: i32 = 0
    if left {
        x = titleX(surface) + TITLE_BUTTON_MARGIN + @intCast(i32, index) * step
    } else {
        const count = titleButtonCount(surface, false)
        x = titleX(surface) + titleWidth(surface) - TITLE_BUTTON_MARGIN - TITLE_BUTTON_WIDTH - @intCast(i32, count - 1 - index) * step
    }
    const y = titleY(surface) + (titleHeight(surface) - TITLE_BUTTON_HEIGHT) / 2 + 1
    return Shape.{ .x = x, .y = y, .width = TITLE_BUTTON_WIDTH, .height = TITLE_BUTTON_HEIGHT, .top = TITLE_BUTTON_RADIUS, .bottom = TITLE_BUTTON_RADIUS }
}

// The button of `surface`'s title bar at (x, y) (TITLE_BUTTON_NONE when
// none): its chip and half the gap around it, the bar's whole height.
pub fn titleButtonAt(surface: *const Surface, x: i32, y: i32) -> u8 {
    if surface.*.role != state.ROLE_TOPLEVEL { return TITLE_BUTTON_NONE }
    if y < titleY(surface) || y >= titleY(surface) + titleHeight(surface) { return TITLE_BUTTON_NONE }
    var side: usize = 0
    while side < 2 {
        const left = side == 0
        const count = titleButtonCount(surface, left)
        var index: usize = 0
        while index < count {
            const shape = titleButtonShape(surface, left, index)
            if x >= shape.x - TITLE_BUTTON_GAP / 2 && x < shape.x + shape.width + TITLE_BUTTON_GAP / 2 { return titleButtonKind(surface, left, index) }
            index += 1
        }
        side += 1
    }
    return TITLE_BUTTON_NONE
}

// The button of `surface` under the pointer (TITLE_BUTTON_NONE: none).
pub fn titleButtonHovered(surface: *const Surface) -> u8 {
    const compositor = surface.*.compositor
    if compositor.*.hoverTitleWindow == 0 || state.surfaceAt(compositor.*.hoverTitleWindow) != surface { return TITLE_BUTTON_NONE }
    return compositor.*.hoverTitleButton
}

// The symbol of a button in its chip as up to 16 one-pixel-wide
// rectangles into `pieces` (their count): a line (minimize), a square
// (maximize; two overlapping when the window is maximized: restore), an x
// (close).
pub fn titleButtonSymbol(surface: *const Surface, kind: u8, shape: *const Shape, pieces: *[16]ui.Rect) -> usize {
    const x = shape.*.x + (shape.*.width - 9) / 2
    const y = shape.*.y + (shape.*.height - 9) / 2
    if kind == TITLE_BUTTON_MINIMIZE {
        pieces.*[0] = ui.rect(x, y + 4, 9, 1)
        return 1
    }
    if kind == TITLE_BUTTON_MAXIMIZE {
        if surface.*.maximized {
            pieces.*[0] = ui.rect(x, y + 2, 7, 1)
            pieces.*[1] = ui.rect(x, y + 8, 7, 1)
            pieces.*[2] = ui.rect(x, y + 2, 1, 7)
            pieces.*[3] = ui.rect(x + 6, y + 2, 1, 7)
            pieces.*[4] = ui.rect(x + 2, y, 7, 1)
            pieces.*[5] = ui.rect(x + 8, y, 1, 7)
            return 6
        }
        pieces.*[0] = ui.rect(x, y, 9, 1)
        pieces.*[1] = ui.rect(x, y + 8, 9, 1)
        pieces.*[2] = ui.rect(x, y, 1, 9)
        pieces.*[3] = ui.rect(x + 8, y, 1, 9)
        return 4
    }
    var count: usize = 0
    var step: i32 = 0
    while step < 8 {
        pieces.*[count] = ui.rect(x + step, y + step, 1, 1)
        pieces.*[count + 1] = ui.rect(x + step + 1, y + 7 - step, 1, 1)
        count += 2
        step += 1
    }
    return count
}

// The title bar's buttons again (the pointer came or went).
pub fn damageTitleButtons(compositor: *Compositor, address: usize) -> void {
    if address == 0 { return }
    damageTitle(compositor, state.surfaceAt(address))
}

// ---------------------------------------------------------------------------
// Translucent title bars: what is behind them blurred (settings
// title-blur). A title bar's blur is not kept (blurBehind keeps a
// surface's): it is made out of each frame that draws the bar, so damage
// within its reach takes in all of it and what it reads (widenWhole).

pub fn titleTranslucent(compositor: *const Compositor) -> bool { return compositor.*.titleAlpha < 255 }

fn titlesBlur(compositor: *const Compositor) -> bool { return compositor.*.titleBlur && titleTranslucent(compositor) && compositor.*.titleBars }

// The area a toplevel's title bar blurs (empty when it blurs none).
pub fn titleBlurBounds(surface: *const Surface) -> ui.Rect {
    if !titlesBlur(surface.*.compositor) || titleHeight(surface) == 0 { return ui.rect(0, 0, 0, 0) }
    return ui.rect(titleX(surface), titleY(surface), titleWidth(surface), titleHeight(surface))
}

fn squareRoot(value: i32) -> i32 {
    var root: i32 = 0
    while (root + 1) * (root + 1) <= value { root += 1 }
    return root
}

// The title bar's blurred region as region operations relative to its
// top-left (titleX, titleY): the bar, less its rounded top corners as
// steps two rows high. Their count (at most 1 + 2 * 9).
pub fn titleBlurOps(surface: *const Surface, ops: *[32]state.RegionOp) -> usize {
    const width = titleWidth(surface)
    const height = titleHeight(surface)
    ops.*[0] = state.RegionOp.{ .subtract = false, .x = 0, .y = 0, .width = width, .height = height }
    var count: usize = 1
    const radius = outerShape(surface).top
    var row: i32 = 0
    while row < radius && row < height && count + 2 <= 32 {
        const rise = radius - row
        const cut = radius - squareRoot(radius * radius - rise * rise)
        if cut > 0 {
            ops.*[count] = state.RegionOp.{ .subtract = true, .x = 0, .y = row, .width = cut, .height = 2 }
            ops.*[count + 1] = state.RegionOp.{ .subtract = true, .x = width - cut, .y = row, .width = cut, .height = 2 }
            count += 2
        }
        row += 2
    }
    return count
}

// The decoration's colour (premultiplied): `color` (0xRRGGBB) at the
// title bars' opacity.
pub fn decorationColor(compositor: *const Compositor, color: u32) -> u32 {
    const alpha = compositor.*.titleAlpha
    const red = (((color >> 16) & 255) * alpha + 127) / 255
    const green = (((color >> 8) & 255) * alpha + 127) / 255
    const blue = ((color & 255) * alpha + 127) / 255
    return (alpha << 24) | (red << 16) | (green << 8) | blue
}

// The toplevel whose title bar is at (x, y), unless a window above covers
// the point; 0 when none.
pub fn titleAt(compositor: *Compositor, x: i32, y: i32) -> usize {
    var index = compositor.*.stack.length
    while index > 0 {
        index -= 1
        const address = state.listAt(compositor.*.stack, index)
        if hidden(address) { continue }
        const surface = state.surfaceAt(address)
        const left = windowX(surface)
        const top = windowY(surface)
        if x >= left && y >= top && x < left + windowWidth(surface) && y < top + windowHeight(surface) { return 0 }
        if surface.*.role == state.ROLE_TOPLEVEL {
            const bar_x = titleX(surface)
            const bar_y = titleY(surface)
            if x >= bar_x && y >= bar_y && x < bar_x + titleWidth(surface) && y < bar_y + titleHeight(surface) { return address }
            if borderEdges(surface, x, y) != 0 { return 0 }
        }
    }
    return 0
}

// The resize edges of `surface`'s border at (x, y): its frame, the title
// bar's top, and GRAB pixels around them; 0 outside, or on the title bar.
pub fn borderEdges(surface: *const Surface, x: i32, y: i32) -> u32 {
    // Maximized and fullscreen windows do not resize by hand.
    if surface.*.maximized || surface.*.fullscreen { return 0 }
    const left = windowX(surface)
    const right = left + windowWidth(surface)
    const top = titleY(surface)
    const bottom = windowY(surface) + windowHeight(surface)
    if x < left - 2 - GRAB || x >= right + 2 + GRAB || y < top - GRAB || y >= bottom + 2 + GRAB { return 0 }
    var edges: u32 = 0
    if x < left { edges = EDGE_LEFT } else if x >= right { edges = EDGE_RIGHT }
    if y < top { edges = edges | EDGE_TOP } else if y >= bottom { edges = edges | EDGE_BOTTOM }
    // Near a corner, the corner.
    if edges == EDGE_LEFT || edges == EDGE_RIGHT {
        if y < top + CORNER { edges = edges | EDGE_TOP } else if y >= bottom - CORNER { edges = edges | EDGE_BOTTOM }
    } else if edges == EDGE_TOP || edges == EDGE_BOTTOM {
        if x < left + CORNER { edges = edges | EDGE_LEFT } else if x >= right - CORNER { edges = edges | EDGE_RIGHT }
    }
    // Inside the frame is the title bar (moving) or the window itself.
    if y >= top && y < bottom && x >= left - 2 && x < right + 2 && (y < windowY(surface) || x >= left && x < right) { return 0 }
    return edges
}

// Whether (x, y) is on a toplevel's decorations: its title bar or border.
fn onDecoration(surface: *const Surface, x: i32, y: i32) -> bool {
    if surface.*.role != state.ROLE_TOPLEVEL { return false }
    const bar_x = titleX(surface)
    const bar_y = titleY(surface)
    if x >= bar_x && y >= bar_y && x < bar_x + titleWidth(surface) && y < bar_y + titleHeight(surface) { return true }
    return borderEdges(surface, x, y) != 0
}

// The toplevel whose border is at (x, y), unless a window above covers
// the point; 0 when none.
pub fn borderAt(compositor: *Compositor, x: i32, y: i32) -> usize {
    var index = compositor.*.stack.length
    while index > 0 {
        index -= 1
        const address = state.listAt(compositor.*.stack, index)
        if hidden(address) { continue }
        const surface = state.surfaceAt(address)
        const left = windowX(surface)
        const top = windowY(surface)
        if x >= left && y >= top && x < left + windowWidth(surface) && y < top + windowHeight(surface) { return 0 }
        if surface.*.role == state.ROLE_TOPLEVEL {
            const bar_x = titleX(surface)
            const bar_y = titleY(surface)
            if x >= bar_x && y >= bar_y && x < bar_x + titleWidth(surface) && y < bar_y + titleHeight(surface) { return 0 }
            if borderEdges(surface, x, y) != 0 { return address }
        }
    }
    return 0
}

// The title bar again (its frames-per-second counter changed).
pub fn damageTitle(compositor: *Compositor, surface: *const Surface) -> void {
    damageRect(compositor, ui.rect(titleX(surface), titleY(surface), titleWidth(surface), titleHeight(surface)))
}

fn appendText(into: [*]u8, at: usize, text: []const u8) -> usize { return std.text.append(into, at, 160, text) }

fn appendNumber(buffer: [*]u8, length: usize, value: u32) -> usize { return std.text.appendUnsigned(buffer, length, length + 10, @intCast(usize, value)) }

// Lays the title out into compositor.run, dropping glyphs past the bar:
// the window's title, then its frames per second and the desktop's.
pub fn layoutTitle(compositor: *Compositor, surface: *const Surface) -> bool {
    if !compositor.*.hasText { return false }
    var text: [192]u8 = undefined
    const title: [*]u8 = &text
    var length: usize = 0
    var index: usize = 0
    while index < surface.*.titleLength {
        title[length] = surface.*.title[index]
        length += 1
        index += 1
    }
    if compositor.*.showFps {
        if length > 0 { length = appendText(title, length, "  |  ") }
        length = appendNumber(title, length, surface.*.fps)
        length = appendText(title, length, " fps  |  desktop ")
        length = appendNumber(title, length, compositor.*.desktopFps)
        length = appendText(title, length, " fps")
    }
    if length == 0 { return false }
    const run = compositor.*.run
    tt.layoutBytes(compositor.*.atlas, title, length, run)
    const limit = titleTextEnd(surface) - titleTextX(surface)
    var kept: usize = 0
    while kept < run.*.count {
        const quad = run.*.quads[kept]
        if quad.x + @intCast(i32, quad.width) > limit { break }
        kept += 1
    }
    run.*.count = kept
    if kept == 0 { return false }
    // The bounding box of what is left.
    index = 0
    while index < kept {
        const quad = run.*.quads[index]
        const right = quad.x + @intCast(i32, quad.width)
        const bottom = quad.y + @intCast(i32, quad.height)
        if index == 0 || quad.x < run.*.left { run.*.left = quad.x }
        if index == 0 || quad.y < run.*.top { run.*.top = quad.y }
        if index == 0 || right > run.*.right { run.*.right = right }
        if index == 0 || bottom > run.*.bottom { run.*.bottom = bottom }
        index += 1
    }
    return true
}

// The surface of `address`'s tree under (x, y), topmost first (its
// subsurfaces above it, itself, those below); 0 when none has the point.
fn treeAtPoint(address: usize, x: i32, y: i32, depth: usize) -> usize {
    const surface = state.surfaceAt(address)
    var index = surface.*.children.length
    while index > surface.*.belowCount {
        index -= 1
        const hit = treeAtPoint(state.listAt(surface.*.children, index), x, y, depth + 1)
        if hit != 0 { return hit }
    }
    if surface.*.hasContent {
        const left = originX(surface)
        const top = originY(surface)
        if x >= left && y >= top && x < left + @intCast(i32, surface.*.pixelWidth) && y < top + @intCast(i32, surface.*.pixelHeight) && inputContains(surface, x - left, y - top) { return address }
    }
    if depth < 16 {
        index = surface.*.belowCount
        while index > 0 {
            index -= 1
            const hit = treeAtPoint(state.listAt(surface.*.children, index), x, y, depth + 1)
            if hit != 0 { return hit }
        }
    }
    return 0
}

// Whether the surface takes pointer input at (x, y) in its own
// coordinates: everywhere without an input region, else inside it.
pub fn inputContains(surface: *const Surface, x: i32, y: i32) -> bool {
    if !surface.*.hasInputRegion { return true }
    const ops: [*]const state.RegionOp = &surface.*.inputOps
    return state.regionContains(ops, surface.*.inputCount, x, y)
}

// The mapped surface under (x, y), topmost first (a window, or one of its
// subsurfaces); 0 when none.
pub fn surfaceAtPoint(compositor: *Compositor, x: i32, y: i32) -> usize {
    var index = compositor.*.stack.length
    while index > 0 {
        index -= 1
        const address = state.listAt(compositor.*.stack, index)
        if hidden(address) { continue }
        const surface = state.surfaceAt(address)
        const left = windowX(surface)
        const top = windowY(surface)
        const inside = x >= left && y >= top && x < left + windowWidth(surface) && y < top + windowHeight(surface)
        const hit = treeAtPoint(address, x, y, 0)
        if hit != 0 { return hit }
        if inside && inputContains(surface, x - originX(surface), y - originY(surface)) { return address }
        // A title bar or border above covers what is below it.
        if onDecoration(surface, x, y) { return 0 }
    }
    return 0
}

// The toplevel a surface belongs to (itself, or a popup's root parent).
pub fn toplevelOf(address: usize) -> usize {
    var current = address
    var depth: usize = 0
    while current != 0 && depth < 16 {
        const surface = state.surfaceAt(current)
        if surface.*.role == state.ROLE_TOPLEVEL { return current }
        current = surface.*.parent
        depth += 1
    }
    return 0
}

pub fn raise(compositor: *Compositor, address: usize) -> void {
    if !state.listContains(compositor.*.stack, address) { return }
    compositor.*.stack = state.listRemove(compositor.*.stack, address)
    compositor.*.stack = state.listAppend(compositor.*.stack, address)
    // Keep the window's popups above it.
    var index: usize = 0
    var count = compositor.*.stack.length
    while index < count {
        const other = state.listAt(compositor.*.stack, index)
        if other != address && toplevelOf(other) == address {
            compositor.*.stack = state.listRemove(compositor.*.stack, other)
            compositor.*.stack = state.listAppend(compositor.*.stack, other)
            damageSurface(compositor, state.surfaceAt(other))
            count -= 1
        } else {
            index += 1
        }
    }
    restack(compositor)
    damageSurface(compositor, state.surfaceAt(address))
}

// Where a surface stacks: layer surfaces of the background and bottom
// layers below the windows, those of the top and overlay layers above
// them, a locker's lock surfaces above everything; a popup or subsurface
// with the surface it belongs to.
fn band(address: usize) -> u32 {
    var current = address
    var depth: usize = 0
    while state.surfaceAt(current).*.parent != 0 && depth < 16 {
        current = state.surfaceAt(current).*.parent
        depth += 1
    }
    const root = state.surfaceAt(current)
    if root.*.role == state.ROLE_LOCK { return 6 }
    // Windows between the bottom and top layers; fullscreen ones above
    // the top layer (docks, panels), below the overlay (the launcher).
    if root.*.role != state.ROLE_LAYER { return if root.*.fullscreen { 4 } else { 2 } }
    if root.*.layer <= state.LAYER_BOTTOM { return root.*.layer }
    return if root.*.layer == state.LAYER_TOP { 3 } else { 5 }
}

// Sorts the stack by band, keeping the order within each.
pub fn restack(compositor: *Compositor) -> void {
    var sorted = true
    var index: usize = 1
    while index < compositor.*.stack.length {
        if band(state.listAt(compositor.*.stack, index - 1)) > band(state.listAt(compositor.*.stack, index)) { sorted = false }
        index += 1
    }
    if sorted { return }
    var ordered = state.newList(compositor.*.allocator)
    var level: u32 = 0
    while level <= 6 {
        index = 0
        while index < compositor.*.stack.length {
            const address = state.listAt(compositor.*.stack, index)
            if band(address) == level { ordered = state.listAppend(ordered, address) }
            index += 1
        }
        level += 1
    }
    compositor.*.stack.deinit()
    compositor.*.stack = ordered
    damageAll(compositor)
}

// Places a new toplevel: cascaded from the top-left, wrapping around.
pub fn place(compositor: *Compositor, surface: *Surface) -> void {
    const offset_x = if surface.*.hasGeometry { surface.*.geometryX } else { 0 }
    const offset_y = if surface.*.hasGeometry { surface.*.geometryY } else { 0 }
    surface.*.x = compositor.*.nextWindowX - offset_x
    surface.*.y = compositor.*.nextWindowY - offset_y
    // Clear of the edges docks and panels reserve.
    const below = titleY(surface) + titleHeight(surface) + 4 + windowHeight(surface) - (@intCast(i32, compositor.*.height) - compositor.*.reserveBottom)
    if below > 0 { surface.*.y -= below }
    if titleY(surface) < compositor.*.reserveTop { surface.*.y += compositor.*.reserveTop - titleY(surface) }
    if titleX(surface) < compositor.*.reserveLeft { surface.*.x += compositor.*.reserveLeft - titleX(surface) }
    compositor.*.nextWindowX += 40
    compositor.*.nextWindowY += 32
    if compositor.*.nextWindowX > @intCast(i32, compositor.*.width / 2) || compositor.*.nextWindowY > @intCast(i32, compositor.*.height / 2) {
        compositor.*.nextWindowX = 24
        compositor.*.nextWindowY = 24
    }
}

// ---------------------------------------------------------------------------
// Damage

pub fn unionRect(a: ui.Rect, b: ui.Rect) -> ui.Rect {
    if ui.isEmpty(a) { return b }
    if ui.isEmpty(b) { return a }
    const left = if a.x < b.x { a.x } else { b.x }
    const top = if a.y < b.y { a.y } else { b.y }
    const right = if ui.right(a) > ui.right(b) { ui.right(a) } else { ui.right(b) }
    const bottom = if ui.bottom(a) > ui.bottom(b) { ui.bottom(a) } else { ui.bottom(b) }
    return ui.rect(left, top, right - left, bottom - top)
}

pub fn outputRect(compositor: *const Compositor) -> ui.Rect {
    return ui.rect(0, 0, @intCast(i32, compositor.*.width), @intCast(i32, compositor.*.height))
}

// Records that `area` (output coordinates) has to be drawn again: something
// in the scene changed there.
pub fn damageRect(compositor: *Compositor, area: ui.Rect) -> void { damageFrom(compositor, area, false) }

// `above`: what changed in `area` is drawn above every surface (the
// pointer, what a drag carries), so no blur reads it.
fn damageFrom(compositor: *Compositor, area: ui.Rect, above: bool) -> void {
    var clipped = ui.intersect(area, outputRect(compositor))
    if ui.isEmpty(clipped) { return }
    if compositor.*.blurred.length > 0 && !above { clipped = widenForBlur(compositor, clipped) }
    compositor.*.damage = unionRect(compositor.*.damage, clipped)
    compositor.*.needsRedraw = true
    if compositor.*.blurred.length > 0 || titlesBlur(compositor) { compositor.*.damage = widenWhole(compositor, compositor.*.damage, false) }
}

// ---------------------------------------------------------------------------
// Blur (ext-background-effect-v1)
//
// Behind a surface's blur region what was drawn below it is blurred: three
// box blurs of radius BLUR_RADIUS one after the other (close to a Gaussian),
// across and then down. A blurred pixel depends on everything within
// BLUR_REACH of it.
//
// The blur is kept (state.KeptBlur, Surface.blurKept): the picture below
// the surface within the blur's reach as the frames drew it, and that
// picture blurred. A frame that draws the surface compares what it drew
// below it, where it drew, with the kept picture and blurs again only what
// lies within reach of a difference; everything else of the blur is copied
// from what is kept. So a frame in which nothing below the surface changed
// (the pointer over it, its own commit, a window under it committing what
// it showed there before, the whole screen drawn again) blurs nothing, and
// a window moving under it blurs what lies around the window.
//
// What that comparison cannot see is a change of what counts as below: a
// surface raised, or put elsewhere in the order surfaces are drawn in, has
// under it what was above it, also where no pixel of the screen changes and
// no frame draws. So a surface that may have moved in any way is reported
// as that (damageSurface), and what it keeps of its blur is not valid any
// more; a surface that only shows something new where it is (a commit:
// damageContent) keeps it, and so do all surfaces when everything is drawn
// again (damageAll: the frame then compares all a blur reads).
//
// Damage follows from that. Damage that may have changed what lies below a
// blurred surface (damageRect) takes in the blurred pixels within reach of
// it; damage above every surface (damageCursor) takes in nothing. A blur
// that is not kept (the surface is new, it moved, its region or the output
// changed, a frame did not draw it) is made out of the frame itself, which
// must then hold all the blur reads: damage near such a surface takes in
// all of its blur and what that reads (widenWhole), as every damage did
// before blurs were kept, and the frame that draws it keeps it again.
pub const BLUR_RADIUS: i32 = 6
pub const BLUR_PASSES: i32 = 3
pub const BLUR_REACH: i32 = 18
// A box's mean: the sum of its BLUR_RADIUS * 2 + 1 = 13 bytes divided by
// 13 is (sum * BLUR_MEAN_FACTOR) >> BLUR_MEAN_SHIFT (20165 * 13 = 2^18 + 1:
// the same for every sum below 2^18; tests/268 goes through all there can
// be). Another radius needs its own factor.
pub const BLUR_MEAN_FACTOR: u64 = 20165
pub const BLUR_MEAN_SHIFT: u6 = 18
// A pixel's four channels in the 16-bit lanes of a u64 (a sum of 13 bytes
// fits one): the lanes at bits 0 and 32, which leave a product with the
// factor room, and one byte in each of the two.
const BLUR_LANES: u64 = 281470681808895
const BLUR_BYTES: u64 = 1095216660735
// A blur is made tile by tile, in memory of a tile's size: at most this
// many pixels of the blurred area, and what the passes before the last
// make around them.
const BLUR_TILE_WIDTH: usize = 512
const BLUR_TILE_HEIGHT: usize = 128
// The rows a window down holds (BLUR_RADIUS * 2 + 1), and the one that
// enters it next.
const BLUR_RING: usize = 14

// The blur region's bounds on the output (empty when it has none).
pub fn blurBounds(surface: *const Surface) -> ui.Rect {
    var bounds = ui.rect(0, 0, 0, 0)
    var index: usize = 0
    while index < surface.*.blurCount {
        if !surface.*.blurOps[index].subtract {
            bounds = unionRect(bounds, ui.rect(surface.*.blurOps[index].x, surface.*.blurOps[index].y, surface.*.blurOps[index].width, surface.*.blurOps[index].height))
        }
        index += 1
    }
    const own = ui.rect(0, 0, @intCast(i32, surface.*.pixelWidth), @intCast(i32, surface.*.pixelHeight))
    const inside = ui.intersect(bounds, own)
    if ui.isEmpty(inside) { return ui.rect(0, 0, 0, 0) }
    return ui.rect(inside.x + originX(surface), inside.y + originY(surface), inside.width, inside.height)
}

fn widen(area: ui.Rect, amount: i32) -> ui.Rect {
    return ui.rect(area.x - amount, area.y - amount, area.width + amount * 2, area.height + amount * 2)
}

fn contains(outer: ui.Rect, inner: ui.Rect) -> bool {
    return inner.x >= outer.x && inner.y >= outer.y && ui.right(inner) <= ui.right(outer) && ui.bottom(inner) <= ui.bottom(outer)
}

pub fn sameRect(a: ui.Rect, b: ui.Rect) -> bool {
    return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}

fn fewer(a: usize, b: usize) -> usize { return if a < b { a } else { b } }

// `value` less `amount`, 0 at the least.
fn lessBy(value: usize, amount: usize) -> usize { return if value > amount { value - amount } else { 0 } }

// What `surface` keeps of its blur (the record's address), when that is
// the blur of its region's `bounds` on the output as it is now; 0 when it
// keeps nothing, or another blur.
fn keptBlur(compositor: *const Compositor, surface: *const Surface, bounds: ui.Rect) -> usize {
    if surface.*.blurKept == 0 { return 0 }
    const blur = state.keptBlurAt(surface.*.blurKept)
    if !blur.*.valid || !sameRect(blur.*.bounds, bounds) { return 0 }
    if blur.*.outputWidth != compositor.*.width || blur.*.outputHeight != compositor.*.height { return 0 }
    return surface.*.blurKept
}

// How many blurred surfaces widenForBlur follows one by one.
const BLUR_FOLLOWED: usize = 8

// `area`, in which what lies below blurred surfaces may have changed, and
// what has to be drawn again with it: of a blur that is kept the pixels
// within reach of the area (they are blurred again, the rest is as it was),
// of one that is not all of it and what it reads (it is made out of the
// frame). What is drawn again of one blur can lie within reach of another,
// so each blur's part follows from the area and from the other blurs' parts
// (not from its own: its pixels are not below it), until none grows.
fn widenForBlur(compositor: *Compositor, area: ui.Rect) -> ui.Rect {
    const count = compositor.*.blurred.length
    if count > BLUR_FOLLOWED { return widenWhole(compositor, area, true) }
    var parts: [8]ui.Rect = undefined
    var index: usize = 0
    while index < count {
        parts[index] = ui.rect(0, 0, 0, 0)
        index += 1
    }
    var round: usize = 0
    var changed = true
    while changed && round < 4 {
        changed = false
        index = 0
        while index < count {
            const surface = state.surfaceAt(state.listAt(compositor.*.blurred, index))
            const own = index
            index += 1
            const bounds = blurBounds(surface)
            if ui.isEmpty(bounds) { continue }
            const kept = keptBlur(compositor, surface, bounds)
            const reach = ui.intersect(widen(bounds, BLUR_REACH), outputRect(compositor))
            // Its part: what each of the others' parts, and the area
            // (`other` at `count`), reaches of it.
            var part = ui.rect(0, 0, 0, 0)
            var other: usize = 0
            while other <= count {
                const from = if other == count { area } else { parts[other] }
                if other != own && !ui.isEmpty(from) {
                    if kept != 0 {
                        const blur = state.keptBlurAt(kept)
                        const touched = ui.intersect(from, blur.*.reach)
                        if !ui.isEmpty(touched) { part = unionRect(part, ui.intersect(widen(touched, BLUR_REACH), blur.*.area)) }
                    } else if !ui.isEmpty(ui.intersect(from, reach)) {
                        part = reach
                    }
                }
                other += 1
            }
            if !ui.isEmpty(part) && !contains(parts[own], part) {
                parts[own] = unionRect(parts[own], part)
                changed = true
            }
        }
        round += 1
    }
    var result = area
    index = 0
    while index < count {
        result = unionRect(result, parts[index])
        index += 1
    }
    // Blurred surfaces within reach of one another, each taking in a
    // little more for the other: all of each, which settles.
    if changed { result = widenWhole(compositor, result, true) }
    return result
}

// `area` and all of every blur it reaches into that is not kept (`every`:
// of every blur), with what those read. Applied to the damage as it grows
// and to what a frame slot lacks (the union of two frames' damage can reach
// into a blur neither reached): a blur made out of the frame needs all it
// reads drawn in that frame.
fn widenWhole(compositor: *Compositor, area: ui.Rect, every: bool) -> ui.Rect {
    var result = area
    var changed = true
    while changed {
        changed = false
        var index: usize = 0
        while index < compositor.*.blurred.length {
            const surface = state.surfaceAt(state.listAt(compositor.*.blurred, index))
            index += 1
            const bounds = blurBounds(surface)
            if ui.isEmpty(bounds) { continue }
            if !every && keptBlur(compositor, surface, bounds) != 0 { continue }
            const reach = ui.intersect(widen(bounds, BLUR_REACH), outputRect(compositor))
            if !ui.isEmpty(ui.intersect(reach, result)) && !contains(result, reach) {
                result = unionRect(result, reach)
                changed = true
            }
        }
        // Translucent title bars: their blur is never kept.
        if titlesBlur(compositor) {
            index = 0
            while index < compositor.*.stack.length {
                const address = state.listAt(compositor.*.stack, index)
                const surface = state.surfaceAt(address)
                index += 1
                if surface.*.role != state.ROLE_TOPLEVEL || !shown(address) { continue }
                const bounds = titleBlurBounds(surface)
                if ui.isEmpty(bounds) { continue }
                const reach = ui.intersect(widen(bounds, BLUR_REACH), outputRect(compositor))
                if !ui.isEmpty(ui.intersect(reach, result)) && !contains(result, reach) {
                    result = unionRect(result, reach)
                    changed = true
                }
            }
        }
    }
    return result
}

// Memory of at least `size` bytes at `address.*`, which has room for
// `capacity.*`: kept when that is enough, else taken anew.
fn blurMemory(compositor: *Compositor, address: *usize, capacity: *usize, size: usize) -> void {
    if capacity.* >= size { return }
    if capacity.* > 0 { unsafe { state.release(compositor, @ptrFromInt([*]u8, address.*), capacity.*) } }
    address.* = @intFromPtr(state.allocate(compositor, size))
    capacity.* = size
}

// Makes `blur` the record of the blur of `area` (the part of `bounds` to
// blur, on the output) with room for it; nothing in it is valid yet.
fn blurRoom(compositor: *Compositor, blur: *state.KeptBlur, bounds: ui.Rect, area: ui.Rect) -> void {
    const reach = ui.intersect(widen(area, BLUR_REACH), outputRect(compositor))
    blur.*.valid = false
    blur.*.bounds = ui.rect(bounds.x, bounds.y, bounds.width, bounds.height)
    blur.*.outputWidth = compositor.*.width
    blur.*.outputHeight = compositor.*.height
    blur.*.area = ui.rect(area.x, area.y, area.width, area.height)
    blur.*.reach = ui.rect(reach.x, reach.y, reach.width, reach.height)
    // A tile and what the passes before the last make around it.
    const around = @intCast(usize, BLUR_RADIUS * (BLUR_PASSES - 1) * 2)
    blur.*.wide = fewer(@intCast(usize, area.width), BLUR_TILE_WIDTH) + around
    blur.*.high = fewer(@intCast(usize, area.height), BLUR_TILE_HEIGHT) + around
    blurMemory(compositor, &blur.*.below, &blur.*.belowSize, @intCast(usize, reach.width) * @intCast(usize, reach.height) * 4)
    blurMemory(compositor, &blur.*.blurred, &blur.*.blurredSize, @intCast(usize, area.width) * @intCast(usize, area.height) * 4)
    // The plane, the ring's rows, the sums and a row to read (with a
    // window's values more: those beside it, and one read past them).
    blurMemory(compositor, &blur.*.work, &blur.*.workSize, (blur.*.wide * (blur.*.high + BLUR_RING + 2) + @intCast(usize, BLUR_RADIUS * 2 + 1)) * 8)
}

fn blurRelease(compositor: *Compositor, blur: *state.KeptBlur) -> void {
    unsafe {
        if blur.*.belowSize > 0 { state.release(compositor, @ptrFromInt([*]u8, blur.*.below), blur.*.belowSize) }
        if blur.*.blurredSize > 0 { state.release(compositor, @ptrFromInt([*]u8, blur.*.blurred), blur.*.blurredSize) }
        if blur.*.workSize > 0 { state.release(compositor, @ptrFromInt([*]u8, blur.*.work), blur.*.workSize) }
    }
    blur.*.below = 0
    blur.*.belowSize = 0
    blur.*.blurred = 0
    blur.*.blurredSize = 0
    blur.*.work = 0
    blur.*.workSize = 0
    blur.*.valid = false
}

// Gives back what `surface` keeps of its blur (it has none any more, or is
// going away).
pub fn forgetBlur(compositor: *Compositor, surface: *Surface) -> void {
    if surface.*.blurKept == 0 { return }
    blurRelease(compositor, state.keptBlurAt(surface.*.blurKept))
    unsafe { state.release(compositor, @ptrFromInt([*]u8, surface.*.blurKept), @sizeOf(state.KeptBlur)) }
    surface.*.blurKept = 0
}

// The record `surface` keeps the blur of its region's `bounds` in (`area`
// of them on the output): the one it has, when that is this blur's, else
// one with room for it and nothing valid in it.
fn blurRecord(compositor: *Compositor, surface: *Surface, bounds: ui.Rect, area: ui.Rect) -> *state.KeptBlur {
    if keptBlur(compositor, surface, bounds) != 0 { return state.keptBlurAt(surface.*.blurKept) }
    if surface.*.blurKept == 0 {
        surface.*.blurKept = @intFromPtr(state.allocate(compositor, @sizeOf(state.KeptBlur)))
        const fresh = state.keptBlurAt(surface.*.blurKept)
        fresh.*.below = 0
        fresh.*.belowSize = 0
        fresh.*.blurred = 0
        fresh.*.blurredSize = 0
        fresh.*.work = 0
        fresh.*.workSize = 0
        fresh.*.drawn = false
        fresh.*.tiles = 0
    }
    const blur = state.keptBlurAt(surface.*.blurKept)
    blurRoom(compositor, blur, bounds, area)
    return blur
}

// How many of the `count` pixels at `first` and at `second` (addresses)
// are the same from the start on: eight at a time, as four 64-bit words.
fn samePixels(first: usize, second: usize, count: usize) -> usize {
    var a: [*]const u64 = undefined
    var b: [*]const u64 = undefined
    var pixels_a: [*]const u32 = undefined
    var pixels_b: [*]const u32 = undefined
    unsafe {
        a = @ptrFromInt([*]const u64, first)
        b = @ptrFromInt([*]const u64, second)
        pixels_a = @ptrFromInt([*]const u32, first)
        pixels_b = @ptrFromInt([*]const u32, second)
    }
    const pairs = count / 2
    var pair: usize = 0
    while pair + 4 <= pairs {
        if ((a[pair] ^ b[pair]) | (a[pair + 1] ^ b[pair + 1]) | (a[pair + 2] ^ b[pair + 2]) | (a[pair + 3] ^ b[pair + 3])) != 0 { break }
        pair += 4
    }
    var index = pair * 2
    while index < count && pixels_a[index] == pixels_b[index] { index += 1 }
    return index
}

// The same from the end: where the last pixel that differs ends, given
// that the one at `from` differs.
fn differingEnd(first: usize, second: usize, from: usize, count: usize) -> usize {
    var pixels_a: [*]const u32 = undefined
    var pixels_b: [*]const u32 = undefined
    unsafe {
        pixels_a = @ptrFromInt([*]const u32, first)
        pixels_b = @ptrFromInt([*]const u32, second)
    }
    var end = count
    while end >= from + 8 {
        var a: [*]const u64 = undefined
        var b: [*]const u64 = undefined
        unsafe {
            a = @ptrFromInt([*]const u64, first + (end - 8) * 4)
            b = @ptrFromInt([*]const u64, second + (end - 8) * 4)
        }
        if ((a[0] ^ b[0]) | (a[1] ^ b[1]) | (a[2] ^ b[2]) | (a[3] ^ b[3])) != 0 { break }
        end -= 8
    }
    while end > from + 1 && pixels_a[end - 1] == pixels_b[end - 1] { end -= 1 }
    return end
}

// Brings the kept picture of what lies below up to date with the frame
// inside `clip` (what the frame drew there is what lies below the surface
// now) and returns the smallest rectangle around what differed (empty:
// nothing did).
fn blurBelow(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, blur: *state.KeptBlur) -> ui.Rect {
    const part = ui.intersect(clip, blur.*.reach)
    if ui.isEmpty(part) { return ui.rect(0, 0, 0, 0) }
    const count = @intCast(usize, part.width)
    const stride = compositor.*.width
    const kept_stride = @intCast(usize, blur.*.reach.width)
    const kept_left = @intCast(usize, part.x - blur.*.reach.x)
    var first_column = count
    var last_column: usize = 0
    var first_row = part.y
    var last_row = part.y
    var row = part.y
    while row < ui.bottom(part) {
        const drawn = @intFromPtr(pixels) + (@intCast(usize, row) * stride + @intCast(usize, part.x)) * 4
        const kept = blur.*.below + (@intCast(usize, row - blur.*.reach.y) * kept_stride + kept_left) * 4
        const from = samePixels(drawn, kept, count)
        if from < count {
            const until = differingEnd(drawn, kept, from, count)
            state.copyPixels(kept + from * 4, drawn + from * 4, until - from)
            if from < first_column { first_column = from }
            if until > last_column { last_column = until }
            if last_row == part.y { first_row = row }
            last_row = row + 1
        }
        row += 1
    }
    if last_row == part.y { return ui.rect(0, 0, 0, 0) }
    return ui.rect(part.x + @intCast(i32, first_column), first_row, @intCast(i32, last_column - first_column), last_row - first_row)
}

// One row blurred across: `count` means, each of the BLUR_RADIUS * 2 + 1
// values of `line` from its place on (the row with BLUR_RADIUS values more
// at each end, and one more that is read and not used). The four channels
// are summed in a u64's 16-bit lanes and divided two at a time
// (BLUR_LANES); no step carries between lanes.
fn blurAcross(line: [*]const u64, into: [*]u64, count: usize) -> void {
    const window = @intCast(usize, BLUR_RADIUS * 2 + 1)
    var sum: u64 = 0
    var index: usize = 0
    while index < window {
        sum += line[index]
        index += 1
    }
    index = 0
    while index < count {
        into[index] = ((((sum & BLUR_LANES) * BLUR_MEAN_FACTOR) >> BLUR_MEAN_SHIFT) & BLUR_BYTES) | ((((((sum >> 16) & BLUR_LANES) * BLUR_MEAN_FACTOR) >> BLUR_MEAN_SHIFT) & BLUR_BYTES) << 16)
        sum = sum + line[index + window] - line[index]
        index += 1
    }
}

// Blurs the tile [left, right) x [top, bottom) of the output (a part of
// the blur's area) out of the kept picture below into the kept blur: for
// each of its pixels what BLUR_PASSES box blurs across and down over all
// the blur reads give, every mean cut to a whole number (tests/268 holds
// it against those passes written out plainly, as the blur was made
// before). It is made with less. Each pass makes only what the passes
// after it read (the last the tile, the one before BLUR_RADIUS more around
// it, the first twice that), a row at a time: a row is blurred across into
// a ring of rows when the window down first reaches it, and the window's
// sums move down by the row that enters and the row that leaves. Beyond
// the output's edges the edge is repeated. (Passes over all a blur reads
// repeat the ends of that as well, where they are not the output's: no
// pixel of the area depends on anything that far away.)
fn blurTile(blur: *const state.KeptBlur, left: usize, top: usize, right: usize, bottom: usize, width: usize, height: usize) -> void {
    const radius = @intCast(usize, BLUR_RADIUS)
    const passes = @intCast(usize, BLUR_PASSES)
    const wide = blur.*.wide
    const reach_x = @intCast(usize, blur.*.reach.x)
    const reach_y = @intCast(usize, blur.*.reach.y)
    const reach_width = @intCast(usize, blur.*.reach.width)
    const area_x = @intCast(usize, blur.*.area.x)
    const area_y = @intCast(usize, blur.*.area.y)
    const area_width = @intCast(usize, blur.*.area.width)
    // The work: a plane of what a pass made (four channels to a u64, as
    // blurAcross has them), the ring, the sums, a row to read.
    var plane: [*]u64 = undefined
    var ring: [*]u64 = undefined
    var sums: [*]u64 = undefined
    var line: [*]u64 = undefined
    unsafe {
        plane = @ptrFromInt([*]u64, blur.*.work)
        ring = @ptrFromInt([*]u64, blur.*.work + wide * blur.*.high * 8)
        sums = @ptrFromInt([*]u64, blur.*.work + wide * (blur.*.high + BLUR_RING) * 8)
        line = @ptrFromInt([*]u64, blur.*.work + wide * (blur.*.high + BLUR_RING + 1) * 8)
    }
    // The plane's first column and row on the output: the first pass's.
    const plane_x = lessBy(left, radius * (passes - 1))
    const plane_y = lessBy(top, radius * (passes - 1))
    var pass: usize = 0
    while pass < passes {
        const around = radius * (passes - 1 - pass)
        const x0 = lessBy(left, around)
        const x1 = fewer(right + around, width)
        const y0 = lessBy(top, around)
        const y1 = fewer(bottom + around, height)
        const count = x1 - x0
        // What a row across reads: `radius` more columns on each side, of
        // which `inside` are on the output.
        const in0 = lessBy(x0, radius)
        const inside = fewer(x1 + radius, width) - in0
        const before = radius - (x0 - in0)
        const after = count + radius * 2 - before - inside
        // The next row to blur across (rows enter the window in order).
        var next = lessBy(y0, radius)
        var y = y0
        while y < y1 {
            // The row that enters the window after this one (none after
            // the last): blurred across now, with those before it, when it
            // was not yet.
            const enter = fewer(if y + 1 < y1 { y + radius + 1 } else { y + radius }, height - 1)
            while next <= enter {
                var index: usize = 0
                if pass == 0 {
                    const from: [*]const u32 = unsafe { @ptrFromInt([*]const u32, blur.*.below + ((next - reach_y) * reach_width + (in0 - reach_x)) * 4) }
                    while index < inside {
                        const pixel = @intCast(u64, from[index])
                        line[before + index] = (pixel & 255) | ((pixel & 65280) << 8) | ((pixel & 16711680) << 16) | ((pixel & 4278190080) << 24)
                        index += 1
                    }
                } else {
                    state.copyWords(@intFromPtr(line) + before * 8, @intFromPtr(plane) + ((next - plane_y) * wide + (in0 - plane_x)) * 8, inside * 8)
                }
                index = 0
                while index < before {
                    line[index] = line[before]
                    index += 1
                }
                index = 0
                while index < after {
                    line[before + inside + index] = line[before + inside - 1]
                    index += 1
                }
                line[count + radius * 2] = 0
                const across: [*]u64 = unsafe { @ptrFromInt([*]u64, @intFromPtr(ring) + (next % BLUR_RING) * wide * 8) }
                blurAcross(line, across, count)
                next += 1
            }
            var index: usize = 0
            if y == y0 {
                // The first window: the rows `radius` above to `radius`
                // below (the output's edge repeated).
                while index < count {
                    sums[index] = 0
                    index += 1
                }
                var offset: usize = 0
                while offset <= radius * 2 {
                    const row = fewer(lessBy(y0 + offset, radius), height - 1)
                    const from: [*]const u64 = unsafe { @ptrFromInt([*]const u64, @intFromPtr(ring) + (row % BLUR_RING) * wide * 8) }
                    index = 0
                    while index < count {
                        sums[index] += from[index]
                        index += 1
                    }
                    offset += 1
                }
            }
            // The row's means: into the plane, or, the last pass's, as
            // pixels into the kept blur (through the line).
            var into: [*]u64 = line
            if pass + 1 < passes { unsafe { into = @ptrFromInt([*]u64, @intFromPtr(plane) + ((y - plane_y) * wide + (x0 - plane_x)) * 8) } }
            index = 0
            if y + 1 < y1 {
                var entering: [*]const u64 = undefined
                var leaving: [*]const u64 = undefined
                unsafe {
                    entering = @ptrFromInt([*]const u64, @intFromPtr(ring) + (enter % BLUR_RING) * wide * 8)
                    leaving = @ptrFromInt([*]const u64, @intFromPtr(ring) + (lessBy(y, radius) % BLUR_RING) * wide * 8)
                }
                while index < count {
                    const sum = sums[index]
                    into[index] = ((((sum & BLUR_LANES) * BLUR_MEAN_FACTOR) >> BLUR_MEAN_SHIFT) & BLUR_BYTES) | ((((((sum >> 16) & BLUR_LANES) * BLUR_MEAN_FACTOR) >> BLUR_MEAN_SHIFT) & BLUR_BYTES) << 16)
                    sums[index] = sum + entering[index] - leaving[index]
                    index += 1
                }
            } else {
                while index < count {
                    const sum = sums[index]
                    into[index] = ((((sum & BLUR_LANES) * BLUR_MEAN_FACTOR) >> BLUR_MEAN_SHIFT) & BLUR_BYTES) | ((((((sum >> 16) & BLUR_LANES) * BLUR_MEAN_FACTOR) >> BLUR_MEAN_SHIFT) & BLUR_BYTES) << 16)
                    index += 1
                }
            }
            if pass + 1 == passes {
                const to: [*]u32 = unsafe { @ptrFromInt([*]u32, blur.*.blurred + ((y - area_y) * area_width + (x0 - area_x)) * 4) }
                index = 0
                while index < count {
                    const lanes = into[index]
                    to[index] = @intCast(u32, (lanes & 255) | ((lanes >> 8) & 65280) | ((lanes >> 16) & 16711680) | ((lanes >> 24) & 4278190080))
                    index += 1
                }
            }
            y += 1
        }
        pass += 1
    }
}

// Blurs `part` of the blur's area again, tile by tile.
fn blurAgain(compositor: *const Compositor, blur: *state.KeptBlur, part: ui.Rect) -> void {
    if ui.isEmpty(part) { return }
    const right = @intCast(usize, ui.right(part))
    const bottom = @intCast(usize, ui.bottom(part))
    var top = @intCast(usize, part.y)
    while top < bottom {
        const under = fewer(top + BLUR_TILE_HEIGHT, bottom)
        var left = @intCast(usize, part.x)
        while left < right {
            const beside = fewer(left + BLUR_TILE_WIDTH, right)
            blurTile(blur, left, top, beside, under, compositor.*.width, compositor.*.height)
            blur.*.tiles += 1
            left = beside
        }
        top = under
    }
}

// Makes all of `blur` out of the frame: what the frame holds in its reach
// is the picture below, all of its area is blurred.
fn blurWhole(compositor: *Compositor, pixels: [*]u8, blur: *state.KeptBlur) -> void {
    const width = @intCast(usize, blur.*.reach.width)
    var row: usize = 0
    while row < @intCast(usize, blur.*.reach.height) {
        state.copyPixels(blur.*.below + row * width * 4, @intFromPtr(pixels) + ((@intCast(usize, blur.*.reach.y) + row) * compositor.*.width + @intCast(usize, blur.*.reach.x)) * 4, width)
        row += 1
    }
    blurAgain(compositor, blur, blur.*.area)
    blur.*.valid = true
}

// The blur into the frame, inside `clip` and the surface's blur region:
// each row in runs between the edges of the region's rectangles.
fn blurOut(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface, blur: *const state.KeptBlur) -> void {
    const part = ui.intersect(clip, blur.*.area)
    if ui.isEmpty(part) { return }
    const left = originX(surface)
    const top = originY(surface)
    const stride = compositor.*.width
    const kept_stride = @intCast(usize, blur.*.area.width)
    var y = part.y
    while y < ui.bottom(part) {
        var x = part.x
        while x < ui.right(part) {
            // Whether the region has (x, y), and up to where that holds.
            var inside = false
            var next = ui.right(part)
            var index: usize = 0
            while index < surface.*.blurCount {
                const above = top + surface.*.blurOps[index].y
                if y >= above && y < above + surface.*.blurOps[index].height {
                    const start = left + surface.*.blurOps[index].x
                    const end = start + surface.*.blurOps[index].width
                    if x >= start && x < end { inside = !surface.*.blurOps[index].subtract }
                    if start > x && start < next { next = start }
                    if end > x && end < next { next = end }
                }
                index += 1
            }
            if inside {
                state.copyPixels(@intFromPtr(pixels) + (@intCast(usize, y) * stride + @intCast(usize, x)) * 4, blur.*.blurred + (@intCast(usize, y - blur.*.area.y) * kept_stride + @intCast(usize, x - blur.*.area.x)) * 4, @intCast(usize, next - x))
            }
            x = next
        }
        y += 1
    }
}

// Blurs what is drawn behind the surface's blur region, in `clip` (called
// when everything below the surface is drawn there, and nothing else yet).
// `keep`: out of what the surface keeps of its blur, brought up to date
// with what the frame drew below it; else, and when nothing can be kept
// yet, out of the frame alone.
fn blurBehind(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *Surface, keep: bool) -> void {
    const bounds = blurBounds(surface)
    const whole = ui.intersect(bounds, outputRect(compositor))
    if ui.isEmpty(whole) { return }
    if keep {
        const blur = blurRecord(compositor, surface, bounds, whole)
        blur.*.drawn = true
        if blur.*.valid {
            // Blurred again: what lies within reach of what differs below.
            const differs = blurBelow(compositor, pixels, clip, blur)
            if !ui.isEmpty(differs) { blurAgain(compositor, blur, ui.intersect(widen(differs, BLUR_REACH), blur.*.area)) }
        } else if contains(clip, blur.*.reach) {
            // The frame holds all the blur reads: kept from now on.
            blurWhole(compositor, pixels, blur)
        }
        if blur.*.valid {
            blurOut(compositor, pixels, clip, surface, blur)
            return
        }
    }
    // Out of the frame, for this frame: the part of the blur in the clip,
    // from what the frame holds around it (damage took all of it in:
    // widenWhole).
    const area = ui.intersect(bounds, clip)
    if ui.isEmpty(area) { return }
    var once: state.KeptBlur = undefined
    once.below = 0
    once.belowSize = 0
    once.blurred = 0
    once.blurredSize = 0
    once.work = 0
    once.workSize = 0
    once.tiles = 0
    blurRoom(compositor, &once, bounds, area)
    blurWhole(compositor, pixels, &once)
    blurOut(compositor, pixels, clip, surface, &once)
    blurRelease(compositor, &once)
}

// Blurs what is drawn behind a toplevel's translucent title bar, in `clip`,
// out of the frame (as blurBehind does a blur it does not keep).
fn blurTitle(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface) -> void {
    const bounds = titleBlurBounds(surface)
    const area = ui.intersect(ui.intersect(bounds, clip), outputRect(compositor))
    if ui.isEmpty(area) { return }
    var ops: [32]state.RegionOp = undefined
    const count = titleBlurOps(surface, &ops)
    var once: state.KeptBlur = undefined
    once.below = 0
    once.belowSize = 0
    once.blurred = 0
    once.blurredSize = 0
    once.work = 0
    once.workSize = 0
    once.tiles = 0
    blurRoom(compositor, &once, bounds, area)
    blurWhole(compositor, pixels, &once)
    const view: [*]const state.RegionOp = &ops
    const left = titleX(surface)
    const top = titleY(surface)
    const output: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    const blurred: [*]const u32 = unsafe { @ptrFromInt([*]const u32, once.blurred) }
    const kept_stride = @intCast(usize, area.width)
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            if state.regionContains(view, count, x - left, y - top) {
                output[@intCast(usize, y) * compositor.*.width + @intCast(usize, x)] = blurred[@intCast(usize, y - area.y) * kept_stride + @intCast(usize, x - area.x)]
            }
            x += 1
        }
        y += 1
    }
    blurRelease(compositor, &once)
}

// Nothing kept of any blur is valid any more: another renderer composes
// from now on (a module loaded while the compositor runs), which may blur
// differently and lay its work out differently.
pub fn renewBlurs(compositor: *Compositor) -> void {
    var index: usize = 0
    while index < compositor.*.blurred.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.blurred, index))
        if surface.*.blurKept != 0 { state.keptBlurAt(surface.*.blurKept).*.valid = false }
        index += 1
    }
}

// Before a frame is composed: no surface's blur is drawn yet.
fn blursBegin(compositor: *Compositor) -> void {
    var index: usize = 0
    while index < compositor.*.blurred.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.blurred, index))
        if surface.*.blurKept != 0 { state.keptBlurAt(surface.*.blurKept).*.drawn = false }
        index += 1
    }
}

// After it: what a surface keeps of its blur stays good only while every
// frame that draws within the blur's reach draws the surface too (and
// brings the kept picture up to date there). A frame drew in `clip` and
// left the surface out (it is hidden, opening, without content): what it
// keeps is no longer valid and its memory is given back; the next frame
// that draws the surface makes its blur anew.
fn blursEnd(compositor: *Compositor, clip: ui.Rect) -> void {
    var index: usize = 0
    while index < compositor.*.blurred.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.blurred, index))
        index += 1
        if surface.*.blurKept == 0 { continue }
        const blur = state.keptBlurAt(surface.*.blurKept)
        if !blur.*.drawn && !ui.isEmpty(ui.intersect(clip, blur.*.reach)) { blurRelease(compositor, blur) }
    }
}

pub fn damageAll(compositor: *Compositor) -> void {
    compositor.*.damage = outputRect(compositor)
    compositor.*.needsRedraw = true
}

fn treeBounds(surface: *const Surface, depth: usize) -> ui.Rect {
    var bounds = ui.rect(originX(surface), originY(surface), @intCast(i32, surface.*.pixelWidth), @intCast(i32, surface.*.pixelHeight))
    if depth >= 16 { return bounds }
    var index: usize = 0
    while index < surface.*.children.length {
        bounds = unionRect(bounds, treeBounds(state.surfaceAt(state.listAt(surface.*.children, index)), depth + 1))
        index += 1
    }
    return bounds
}

// Everything a mapped surface draws at rest: its buffer, its subsurfaces
// and, for a toplevel, its frame and title bar.
pub fn restBounds(surface: *const Surface) -> ui.Rect {
    const buffer = treeBounds(surface, 0)
    if surface.*.role != state.ROLE_TOPLEVEL { return buffer }
    const decorated = ui.rect(titleX(surface), titleY(surface), titleWidth(surface), titleHeight(surface) + windowHeight(surface) + frameWidth(surface) * 2)
    return unionRect(buffer, decorated)
}

// What it draws now: wobbling (wobble.mlx), as far as it bends too;
// opening out of a rectangle, that too.
pub fn surfaceBounds(surface: *const Surface) -> ui.Rect {
    var bounds = restBounds(surface)
    if surface.*.zooming { bounds = unionRect(bounds, ui.rect(surface.*.zoomX, surface.*.zoomY, surface.*.zoomWidth, surface.*.zoomHeight)) }
    if !surface.*.wobbling { return bounds }
    return widen(bounds, surface.*.wobbleReach)
}

// ---------------------------------------------------------------------------
// Opening out of a rectangle: a window the dock opens (a folder from its
// stack) grows from the stack to where it rests, fading in.

pub const ZOOM_MICROS: usize = 340000

// How far an animation `duration` microseconds long is after `elapsed`:
// 0 to 1024, easing out (fast, then settling: a cubic).
pub fn eased(elapsed: usize, duration: usize) -> i32 {
    if elapsed >= duration { return 1024 }
    const t = @intCast(i64, elapsed * 1024 / duration)
    const left = 1024 - t
    return @intCast(i32, 1024 - left * left / 1024 * left / 1024)
}

// How far it has grown: 0 to 1024.
pub fn zoomProgress(surface: *const Surface) -> i32 {
    return eased(state.microseconds() - surface.*.zoomStart, ZOOM_MICROS * surface.*.compositor.*.animationScale)
}

// From `from` to `to` by `t` (0 to 1024).
pub fn between(from: i32, to: i32, t: i32) -> i32 {
    return from + @intCast(i32, @intCast(i64, to - from) * @intCast(i64, t) / 1024)
}

// Where it is drawn now: from the rectangle to its rest bounds.
pub fn zoomRect(surface: *const Surface) -> ui.Rect {
    const rest = restBounds(surface)
    const t = zoomProgress(surface)
    return ui.rect(between(surface.*.zoomX, rest.x, t), between(surface.*.zoomY, rest.y, t), between(surface.*.zoomWidth, rest.width, t), between(surface.*.zoomHeight, rest.height, t))
}

// How opaque (0-255): from 170 to whole over the first half.
pub fn zoomOpacity(surface: *const Surface) -> u32 {
    const t = zoomProgress(surface)
    if t >= 512 { return 255 }
    return 170 + @intCast(u32, t) * 85 / 512
}

fn scaledPixel(pixel: u32, alpha: u32) -> u32 {
    if alpha >= 255 { return pixel }
    var result: u32 = 0
    var shift: u32 = 0
    while shift < 32 {
        result = result | ((((pixel >> shift) & 255) * alpha + 127) / 255 << shift)
        shift += 8
    }
    return result
}

// A zooming toplevel on the CPU: its rest bounds scaled into zoomRect
// (nearest pixel): the buffer where it is, the frame's colour where the
// frame and title bar are.
fn drawZoomed(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface, focused: bool) -> void {
    const rest = restBounds(surface)
    const target = zoomRect(surface)
    if rest.width <= 0 || rest.height <= 0 || target.width <= 0 || target.height <= 0 { return }
    const area = ui.intersect(target, clip)
    if ui.isEmpty(area) { return }
    const alpha = zoomOpacity(surface)
    const frame = 4278190080 | (if focused { compositor.*.focusColor } else { compositor.*.frameColor })
    const decorated = ui.rect(titleX(surface), titleY(surface), titleWidth(surface), titleHeight(surface) + windowHeight(surface) + frameWidth(surface) * 2)
    const buffer_x = originX(surface)
    const buffer_y = originY(surface)
    const buffer_width = @intCast(i32, surface.*.pixelWidth)
    const buffer_height = @intCast(i32, surface.*.pixelHeight)
    const source: [*]const u32 = unsafe { @ptrCast([*]const u32, surface.*.pixels) }
    const out: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    var row = area.y
    while row < ui.bottom(area) {
        const y = rest.y + @intCast(i32, @intCast(i64, row - target.y) * @intCast(i64, rest.height) / @intCast(i64, target.height))
        var column = area.x
        while column < ui.right(area) {
            const x = rest.x + @intCast(i32, @intCast(i64, column - target.x) * @intCast(i64, rest.width) / @intCast(i64, target.width))
            var pixel: u32 = 0
            const bx = x - buffer_x
            const by = y - buffer_y
            if surface.*.hasContent && bx >= 0 && by >= 0 && bx < buffer_width && by < buffer_height {
                pixel = source[@intCast(usize, by) * surface.*.pixelWidth + @intCast(usize, bx)]
            } else if x >= decorated.x && y >= decorated.y && x < ui.right(decorated) && y < ui.bottom(decorated) {
                pixel = frame
            }
            pixel = scaledPixel(pixel, alpha)
            const at = @intCast(usize, row) * compositor.*.width + @intCast(usize, column)
            const coverage = pixel >> 24
            if coverage == 255 { out[at] = pixel } else if coverage != 0 { out[at] = blendPixel(out[at], pixel, coverage) }
            column += 1
        }
        row += 1
    }
}

// Everything `surface` draws has to be drawn again: it appeared or went,
// moved, changed its size, or its place in the order surfaces are drawn in
// (before and after such a change). What it keeps of its blur may then no
// longer be the blur of what lies below it, also where no pixel of the
// screen changed (raised, it has under it what was above it), so that is
// made anew.
pub fn damageSurface(compositor: *Compositor, surface: *const Surface) -> void {
    blursMoved(compositor, surface)
    damageRect(compositor, surfaceBounds(surface))
}

// The same when only what the surface shows changed (a commit's new
// content) and nothing about its place: the blur it keeps stays.
pub fn damageContent(compositor: *Compositor, surface: *const Surface) -> void {
    damageRect(compositor, surfaceBounds(surface))
}

// What `surface` and the surfaces drawn with it (its subsurfaces, its
// popups) keep of their blurs is no longer valid.
fn blursMoved(compositor: *Compositor, surface: *const Surface) -> void {
    var index: usize = 0
    while index < compositor.*.blurred.length {
        const blurred = state.surfaceAt(state.listAt(compositor.*.blurred, index))
        index += 1
        if blurred.*.blurKept == 0 { continue }
        var current = @intFromPtr(blurred)
        var depth: usize = 0
        while current != 0 && depth < 16 {
            if current == @intFromPtr(surface) {
                state.keptBlurAt(blurred.*.blurKept).*.valid = false
                break
            }
            current = state.surfaceAt(current).*.parent
            depth += 1
        }
    }
}

// Part of a surface's buffer (`part`, its own pixels) has new content and
// nothing else about the surface changed: that part where it is drawn
// (the blur the surface keeps stays, as with damageContent). False, and
// nothing damaged, when none of it is on the output.
pub fn damagePart(compositor: *Compositor, surface: *const Surface, part: ui.Rect) -> bool {
    const area = ui.rect(originX(surface) + part.x, originY(surface) + part.y, part.width, part.height)
    if ui.isEmpty(ui.intersect(area, outputRect(compositor))) { return false }
    damageRect(compositor, area)
    return true
}

// Where the cursor is drawn: the client's cursor surface, or the box any
// built-in cursor can cover (the hot spot is the arrow's tip or the box's
// middle). It and what a drag carries are drawn above every surface
// (compose), so what changes with them changes nothing a blur reads.
pub fn damageCursor(compositor: *Compositor) -> void {
    if compositor.*.dragging && compositor.*.dragIcon != 0 {
        const icon = state.surfaceAt(compositor.*.dragIcon)
        damageFrom(compositor, ui.rect(compositor.*.pointerX + compositor.*.dragIconX, compositor.*.pointerY + compositor.*.dragIconY, @intCast(i32, icon.*.pixelWidth), @intCast(i32, icon.*.pixelHeight)), true)
    }
    if compositor.*.cursorSurface != 0 {
        const cursor = state.surfaceAt(compositor.*.cursorSurface)
        damageFrom(compositor, ui.rect(compositor.*.pointerX - compositor.*.cursorHotspotX, compositor.*.pointerY - compositor.*.cursorHotspotY, @intCast(i32, cursor.*.pixelWidth), @intCast(i32, cursor.*.pixelHeight)), true)
    } else {
        const half = cursors.CURSOR_SIZE / 2
        damageFrom(compositor, ui.rect(compositor.*.pointerX - half, compositor.*.pointerY - half, cursors.CURSOR_SIZE + half, cursors.CURSOR_SIZE + half), true)
    }
}

// Starts a frame into slot `slot` (0 or 1): what changed since the last
// frame goes to `changed`, and the part of the output the slot has to be
// drawn again in (everything that changed since it was last composed
// into) is returned. Both slots forget nothing until composed.
pub fn takeDamage(compositor: *Compositor, slot: usize, changed: *ui.Rect) -> ui.Rect {
    // (Fields copied one by one: a struct copied into a local and then
    // overwritten at its source reads the new value with this compiler.)
    changed.* = ui.rect(compositor.*.damage.x, compositor.*.damage.y, compositor.*.damage.width, compositor.*.damage.height)
    compositor.*.slotDamage[0] = unionRect(compositor.*.slotDamage[0], changed.*)
    compositor.*.slotDamage[1] = unionRect(compositor.*.slotDamage[1], changed.*)
    // For capture sessions (capture.mlx), taken when it is presented.
    compositor.*.presentedDamage = unionRect(compositor.*.presentedDamage, changed.*)
    const pending = compositor.*.slotDamage[slot]
    var region = ui.rect(pending.x, pending.y, pending.width, pending.height)
    if (compositor.*.blurred.length > 0 || titlesBlur(compositor)) && !ui.isEmpty(region) { region = widenWhole(compositor, region, false) }
    compositor.*.slotDamage[slot] = ui.rect(0, 0, 0, 0)
    compositor.*.damage = ui.rect(0, 0, 0, 0)
    compositor.*.needsRedraw = false
    return region
}

// ---------------------------------------------------------------------------
// Drawing

// Fills the part of the rectangle inside `clip`.
fn fillRect(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, x: i32, y: i32, width: i32, height: i32, color: u32) -> void {
    const area = ui.intersect(ui.rect(x, y, width, height), clip)
    if ui.isEmpty(area) { return }
    const count = @intCast(usize, area.width)
    const opaque = color | 4278190080
    var row = area.y
    while row < ui.bottom(area) {
        const line = (@intCast(usize, row) * compositor.*.width + @intCast(usize, area.x)) * 4
        state.fillPixels(@intFromPtr(pixels) + line, count, opaque)
        row += 1
    }
}

// Lane constants: the same 16-bit value in the three lanes at bits 0, 16
// and 32 of a u64.
const LANES_1: u64 = 4295032833
const LANES_127: u64 = 545469169791
const LANES_255: u64 = 1095233372415

// `source` (premultiplied ARGB with alpha `alpha`, neither 0 nor 255) over
// `destination`: each channel min(255, source + (destination * (255 -
// alpha) + 127) / 255), the result opaque. The three channels are blended
// at once in 16-bit lanes of a u64; no step carries between lanes.
pub fn blendPixel(destination: u32, source: u32, alpha: u32) -> u32 {
    const d = @intCast(u64, destination)
    const s = @intCast(u64, source)
    const lanes_d = (d & 255) | ((d & 65280) << 8) | ((d & 16711680) << 16)
    const lanes_s = (s & 255) | ((s & 65280) << 8) | ((s & 16711680) << 16)
    // destination * (255 - alpha) + 127: at most 65152 per lane.
    const kept = lanes_d * @intCast(u64, 255 - alpha) + LANES_127
    // Exact division by 255: (x + 1 + (x >> 8)) >> 8 for x below 65535.
    const divided = ((kept + LANES_1 + ((kept >> 8) & LANES_255)) >> 8) & LANES_255
    const sum = lanes_s + divided
    // Lanes past 255 (bit 8 set; the sum is at most 510) become 255.
    const over = (sum >> 8) & LANES_1
    const clamped = (sum | (over * 255)) & LANES_255
    return 4278190080 | @intCast(u32, clamped & 255) | @intCast(u32, (clamped >> 8) & 65280) | @intCast(u32, (clamped >> 16) & 16711680)
}

// `source` (premultiplied, alpha `alpha`) at `coverage` over `destination`,
// as the blit shader does it: each of the four channels scaled by (value *
// coverage + 127) / 255, then blended like blendPixel.
fn coverPixel(destination: u32, source: u32, alpha: u32, coverage: u32) -> u32 {
    const scaled = (alpha * coverage + 127) / 255
    if scaled == 0 { return destination }
    const red = (((source >> 16) & 255) * coverage + 127) / 255
    const green = (((source >> 8) & 255) * coverage + 127) / 255
    const blue = ((source & 255) * coverage + 127) / 255
    const color = (red << 16) | (green << 8) | blue
    if scaled == 255 { return 4278190080 | color }
    return blendPixel(destination, color, scaled)
}

// Draws the part of `surface` inside `clip`, with its top-left at (x, y);
// cut by `shape`'s corners when `clipped` (a toplevel's surfaces).
fn blit(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface, x: i32, y: i32, shape: *const Shape, clipped: bool) -> void {
    if !surface.*.hasContent { return }
    const area = ui.intersect(ui.rect(x, y, @intCast(i32, surface.*.pixelWidth), @intCast(i32, surface.*.pixelHeight)), clip)
    if ui.isEmpty(area) { return }
    const count = @intCast(usize, area.width)
    const left = @intCast(usize, area.x - x)
    var target: [*]u32 = undefined
    var source: [*]const u32 = undefined
    unsafe {
        target = @ptrCast([*]u32, pixels)
        source = @ptrCast([*]const u32, surface.*.pixels)
    }
    var row = area.y
    while row < ui.bottom(area) {
        const from = @intCast(usize, row - y) * surface.*.pixelWidth + left
        const to = @intCast(usize, row) * compositor.*.width + @intCast(usize, area.x)
        // Rows through the rounded corners, pixel by pixel.
        const cornered = clipped && ((row >= shape.*.y && row < shape.*.y + shape.*.top) || (row >= shape.*.y + shape.*.height - shape.*.bottom && row < shape.*.y + shape.*.height))
        if cornered {
            var column: usize = 0
            while column < count {
                const coverage = clipCoverage(shape, area.x + @intCast(i32, column), row)
                const pixel = source[from + column]
                const alpha = pixel >> 24
                if coverage == 255 {
                    if alpha == 255 {
                        target[to + column] = pixel
                    } else if alpha != 0 {
                        target[to + column] = blendPixel(target[to + column], pixel, alpha)
                    }
                } else if coverage != 0 {
                    target[to + column] = coverPixel(target[to + column], pixel, alpha, coverage)
                }
                column += 1
            }
        } else if surface.*.opaque {
            state.copyPixels(@intFromPtr(pixels) + to * 4, @intFromPtr(surface.*.pixels) + from * 4, count)
        } else {
            var column: usize = 0
            while column < count {
                const pixel = source[from + column]
                const alpha = pixel >> 24
                if alpha == 255 {
                    target[to + column] = pixel
                } else if alpha != 0 {
                    target[to + column] = blendPixel(target[to + column], pixel, alpha)
                }
                column += 1
            }
        }
        row += 1
    }
}

// A rounded shape filled with `color` (opaque), inside `clip`.
pub fn fillShape(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, shape: *const Shape, color: u32) -> void {
    const area = ui.intersect(ui.rect(shape.*.x, shape.*.y, shape.*.width, shape.*.height), clip)
    if ui.isEmpty(area) { return }
    const target: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    const opaque = 4278190080 | color
    var row = area.y
    while row < ui.bottom(area) {
        const line = @intCast(usize, row) * compositor.*.width
        var column = area.x
        while column < ui.right(area) {
            const coverage = shapeCoverage(shape, column, row)
            const at = line + @intCast(usize, column)
            if coverage == 255 { target[at] = opaque } else if coverage != 0 { target[at] = coverPixel(target[at], opaque, 255, coverage) }
            column += 1
        }
        row += 1
    }
}

// A shape filled with a translucent premultiplied colour (its alpha),
// blended over what is there (the snap preview).
fn fillTranslucent(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, shape: *const Shape, color: u32) -> void {
    const area = ui.intersect(ui.rect(shape.*.x, shape.*.y, shape.*.width, shape.*.height), clip)
    if ui.isEmpty(area) { return }
    const target: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    const alpha = color >> 24
    const opaque = color
    var row = area.y
    while row < ui.bottom(area) {
        const line = @intCast(usize, row) * compositor.*.width
        var column = area.x
        while column < ui.right(area) {
            const coverage = shapeCoverage(shape, column, row)
            const at = line + @intCast(usize, column)
            if coverage != 0 { target[at] = coverPixel(target[at], opaque, alpha, coverage) }
            column += 1
        }
        row += 1
    }
}

fn drawSnapPreview(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect) -> void {
    if !snapPreviewShown(compositor) { return }
    const shape = snapShape(compositor)
    fillTranslucent(compositor, pixels, clip, &shape, snapPreviewColor(compositor, snapPreviewLevel(compositor)))
}

// ---------------------------------------------------------------------------
// Window previews (where they go: preview_layout.mlx).

pub fn damagePreviews(compositor: *Compositor) -> void {
    if compositor.*.previewCount == 0 { return }
    damageRect(compositor, preview_layout.previewPanel(compositor))
}

// The frame and title bar of a toplevel (rounded, see outerShape), then
// its title.
fn drawDecoration(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface, focused: bool) -> void {
    blurTitle(compositor, pixels, clip, surface)
    const color = decorationColor(compositor, if focused { compositor.*.focusColor } else { compositor.*.frameColor })
    const alpha = color >> 24
    const outer = outerShape(surface)
    const inner = contentShape(surface)
    var pieces: [4]ui.Rect = undefined
    ringPieces(&outer, &inner, &pieces)
    const target: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    var index: usize = 0
    while index < 4 {
        const area = ui.intersect(pieces[index], clip)
        if !ui.isEmpty(area) {
            var row = area.y
            while row < ui.bottom(area) {
                const line = @intCast(usize, row) * compositor.*.width
                var column = area.x
                while column < ui.right(area) {
                    const coverage = ringCoverage(&outer, &inner, column, row)
                    const at = line + @intCast(usize, column)
                    if coverage != 0 { target[at] = coverPixel(target[at], color, alpha, coverage) }
                    column += 1
                }
                row += 1
            }
        }
        index += 1
    }
    if focused { drawPrismLine(compositor, pixels, clip, surface, &outer) }
    drawTitleButtons(compositor, pixels, clip, surface, focused)
    drawTitle(compositor, pixels, clip, surface, focused)
}

// The focused window's prism line: the desktop's gradient along the top
// of its bar, inside its rounded corners.
fn drawPrismLine(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface, outer: *const Shape) -> void {
    if titleHeight(surface) == 0 { return }
    const area = ui.intersect(ui.rect(outer.*.x, outer.*.y, outer.*.width, PRISM_LINE), clip)
    if ui.isEmpty(area) { return }
    const target: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    var row = area.y
    while row < ui.bottom(area) {
        var column = area.x
        while column < ui.right(area) {
            const coverage = shapeCoverage(outer, column, row)
            const at = @intCast(usize, row) * compositor.*.width + @intCast(usize, column)
            if coverage != 0 { target[at] = coverPixel(target[at], prismAt(compositor, column), 255, coverage) }
            column += 1
        }
        row += 1
    }
}

// The title bar's buttons: their symbols, the one under the pointer on a
// chip of its colour.
fn drawTitleButtons(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface, focused: bool) -> void {
    const hovered = titleButtonHovered(surface)
    var side: usize = 0
    while side < 2 {
        const left = side == 0
        const count = titleButtonCount(surface, left)
        var index: usize = 0
        while index < count {
            const kind = titleButtonKind(surface, left, index)
            const shape = titleButtonShape(surface, left, index)
            if !ui.isEmpty(ui.intersect(ui.rect(shape.x, shape.y, shape.width, shape.height), clip)) {
                const lit = kind == hovered
                if lit { fillShape(compositor, pixels, clip, &shape, titleButtonColor(compositor, kind)) }
                var pieces: [16]ui.Rect = undefined
                const piece_count = titleButtonSymbol(surface, kind, &shape, &pieces)
                const ink = if lit || focused { TITLE_COLOR } else { TITLE_INACTIVE_COLOR }
                var piece: usize = 0
                while piece < piece_count {
                    fillRect(compositor, pixels, clip, pieces[piece].x, pieces[piece].y, pieces[piece].width, pieces[piece].height, ink)
                    piece += 1
                }
            }
            index += 1
        }
        side += 1
    }
}

fn drawTitle(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, surface: *const Surface, focused: bool) -> void {
    if titleHeight(surface) == 0 { return }
    const bar = ui.rect(titleX(surface), titleY(surface), titleWidth(surface), TITLE_HEIGHT)
    if ui.isEmpty(ui.intersect(bar, clip)) { return }
    if !layoutTitle(compositor, surface) { return }
    // The text is drawn into the clip as an image of its own (rows the
    // output's width apart), which keeps it inside the clip.
    const words: [*]u32 = unsafe { @ptrFromInt([*]u32, @intFromPtr(pixels) + (@intCast(usize, clip.y) * compositor.*.width + @intCast(usize, clip.x)) * 4) }
    tt.drawRun(compositor.*.atlas, compositor.*.run, words, @intCast(usize, clip.width), @intCast(usize, clip.height), compositor.*.width, titleTextX(surface) - clip.x, titleTextY(surface) - clip.y, if focused { TITLE_COLOR } else { TITLE_INACTIVE_COLOR }, 0)
}

// The resize cursor for resize edges (the arrow for none).
pub fn cursorForEdges(edges: u32) -> u32 {
    if edges == 0 { return cursors.CURSOR_ARROW }
    const horizontal = edges & (EDGE_LEFT | EDGE_RIGHT) != 0
    const vertical = edges & (EDGE_TOP | EDGE_BOTTOM) != 0
    if horizontal && vertical {
        return if edges == (EDGE_TOP | EDGE_LEFT) || edges == (EDGE_BOTTOM | EDGE_RIGHT) { cursors.CURSOR_DIAGONAL } else { cursors.CURSOR_ANTIDIAGONAL }
    }
    return if horizontal { cursors.CURSOR_HORIZONTAL } else { cursors.CURSOR_VERTICAL }
}

// The cursor the compositor draws now: a resize cursor while resizing or
// over a border, else the shape the client under the pointer named
// (cursor-shape; the arrow when it named none).
pub fn cursorKind(compositor: *const Compositor) -> u32 {
    const edges = if compositor.*.resizing != 0 { compositor.*.resizeEdges } else { compositor.*.hoverEdges }
    return if edges != 0 { cursorForEdges(edges) } else { compositor.*.cursorShape }
}

// The desktop background's pixel at (x, y) (background.mlx: the
// wallpaper, or one made of the desktop's colours).
pub fn backgroundPixel(compositor: *const Compositor, x: usize, y: usize) -> u32 { return background.pixel(compositor, x, y) }

fn drawCursor(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, cursor: u32) -> void {
    const size = cursors.CURSOR_SIZE
    const box = ui.rect(compositor.*.pointerX - cursors.hotspotX(cursor), compositor.*.pointerY - cursors.hotspotY(cursor), size, size)
    if ui.isEmpty(ui.intersect(box, clip)) { return }
    var y: i32 = 0
    while y < size {
        var x: i32 = 0
        while x < size {
            const kind = cursors.cursorPixel(cursor, x, y)
            if kind != 0 {
                fillRect(compositor, pixels, clip, box.x + x, box.y + y, 1, 1, cursors.arrowColor(kind))
            }
            x += 1
        }
        y += 1
    }
}

// Draws a surface with its subsurfaces: those below it, itself, those
// above, each with its own subsurfaces in turn.
// A toplevel's tree is cut by its content's rounded corners (`shape`,
// `clipped`). `keep`: blurs are made out of what is kept of them
// (blurBehind).
fn drawTree(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, address: usize, depth: usize, shape: *const Shape, clipped: bool, keep: bool) -> void {
    const surface = state.surfaceAt(address)
    var index: usize = 0
    while index < surface.*.belowCount && depth < 16 {
        drawTree(compositor, pixels, clip, state.listAt(surface.*.children, index), depth + 1, shape, clipped, keep)
        index += 1
    }
    if surface.*.hasBlur && surface.*.hasContent { blurBehind(compositor, pixels, clip, surface, keep) }
    blit(compositor, pixels, clip, surface, originX(surface), originY(surface), shape, clipped)
    index = surface.*.belowCount
    while index < surface.*.children.length && depth < 16 {
        drawTree(compositor, pixels, clip, state.listAt(surface.*.children, index), depth + 1, shape, clipped, keep)
        index += 1
    }
}

// Composes the part of the output inside `clip` into `pixels` (width x
// height ARGB8888; the rest of it is left as it is).
pub fn compose(compositor: *Compositor, pixels: [*]u8, area: ui.Rect) -> void { composeWith(compositor, pixels, area, true) }

// The same with nothing read or written that frames keep from one to the
// next (every blur made out of this frame alone): what tests/268 holds the
// frames against.
pub fn composeAnew(compositor: *Compositor, pixels: [*]u8, area: ui.Rect) -> void { composeWith(compositor, pixels, area, false) }

fn composeWith(compositor: *Compositor, pixels: [*]u8, area: ui.Rect, keep: bool) -> void {
    const clip = ui.intersect(area, outputRect(compositor))
    if ui.isEmpty(clip) { return }
    if keep { blursBegin(compositor) }
    const width = compositor.*.width
    if background.ensure(compositor) { damageAll(compositor) }
    var row = clip.y
    while row < ui.bottom(clip) {
        background.copyRow(compositor, @intFromPtr(pixels) + (@intCast(usize, row) * width + @intCast(usize, clip.x)) * 4, @intCast(usize, clip.x), @intCast(usize, row), @intCast(usize, clip.width))
        row += 1
    }
    // Windows sliding (animation.mlx) are drawn where the slide has them.
    shiftWindows(compositor, 1)
    var index: usize = 0
    while index < compositor.*.stack.length {
        const address = state.listAt(compositor.*.stack, index)
        const surface = state.surfaceAt(address)
        if !shown(address) {
            index += 1
            continue
        }
        const toplevel = surface.*.role == state.ROLE_TOPLEVEL
        if toplevel && surface.*.zooming {
            drawZoomed(compositor, pixels, clip, surface, address == compositor.*.keyboardFocus)
            index += 1
            continue
        }
        if toplevel { drawDecoration(compositor, pixels, clip, surface, address == compositor.*.keyboardFocus) }
        const shape = if toplevel { contentShape(surface) } else { emptyShape() }
        drawTree(compositor, pixels, clip, address, 0, &shape, toplevel, keep)
        index += 1
    }
    shiftWindows(compositor, -1)
    if keep { blursEnd(compositor, clip) }
    drawSnapPreview(compositor, pixels, clip)
    preview_layout.drawPreviews(compositor, pixels, clip)
    // What a drag carries, at the pointer.
    if compositor.*.dragging && compositor.*.dragIcon != 0 {
        const icon = state.surfaceAt(compositor.*.dragIcon)
        const none = emptyShape()
        if icon.*.hasContent { blit(compositor, pixels, clip, icon, compositor.*.pointerX + compositor.*.dragIconX, compositor.*.pointerY + compositor.*.dragIconY, &none, false) }
    }
    if compositor.*.pointerInside {
        if compositor.*.cursorSurface != 0 {
            const cursor = state.surfaceAt(compositor.*.cursorSurface)
            const none = emptyShape()
            blit(compositor, pixels, clip, cursor, compositor.*.pointerX - compositor.*.cursorHotspotX, compositor.*.pointerY - compositor.*.cursorHotspotY, &none, false)
        } else if !compositor.*.cursorHidden {
            drawCursor(compositor, pixels, clip, cursorKind(compositor))
        }
    }
}
