// The graphics card's Vulkan device, looked for beside the renderer: on
// brixOS (card.brixos.mlx) the compositor finds the card through our own
// driver and std.gpu and says what it found, while it composes on the
// processor. Elsewhere the renderer's own choice (vulkan.mlx) is all
// there is, and this does nothing.
const state = @import("./state.mlx")

const Compositor = state.Compositor

pub fn look(compositor: *Compositor, arguments: [][*]const u8) -> void {}
