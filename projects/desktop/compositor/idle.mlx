// Idle notifications (ext_idle_notifier_v1, ext-idle-notify): swayidle and
// screen lockers ask to be told when the seat has had no input for a time
// (idled) and when input comes again (resumed). A notification made with
// get_idle_notification waits while a mapped surface inhibits idling
// (extras.mlx, idle-inhibit: a video playing); one made with
// get_input_idle_notification (version 2) looks at input alone. The
// program notes when input came (entries.mlx); check looks at the time
// since every turn of the event loop, which waits a second at most, and
// tells those idled whose time is up and those idled already that input
// came (`idle: idled` and `idle: resumed` in the log). A notification's
// time starts when it is made or at the input after, whichever is later.
// A greeter compositor does not offer it.
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const extras = @import("./extras.mlx")

const Compositor = state.Compositor

pub const Notification = struct {
    compositor: *Compositor
    resource: wl.server.Object
    // Milliseconds without input before it is idle, whether idle
    // inhibitors hold it off, when it was made (state.microseconds) and,
    // once told idled, the input it was idle after.
    timeout: usize
    inhibitable: bool
    made: usize
    idle: bool
    idleAfter: usize
}

fn notificationAt(address: usize) -> *Notification {
    unsafe { return @ptrFromInt(*Notification, address) }
}

fn contextAt(address: usize) -> *anyopaque {
    unsafe { return @ptrFromInt(*anyopaque, address) }
}

// A turn of the event loop.
pub fn check(compositor: *Compositor) -> void {
    if !compositor.*.hasIdleNotifier || compositor.*.idleNotifications.length == 0 { return }
    const now = state.microseconds()
    const last = compositor.*.lastInput
    const inhibited = extras.idleInhibited(compositor)
    var index: usize = 0
    while index < compositor.*.idleNotifications.length {
        const notification = notificationAt(state.listAt(compositor.*.idleNotifications, index))
        const resource = wl.ext_idle_notification_v1.Resource.fromObject(notification.*.resource)
        if notification.*.idle {
            if last != notification.*.idleAfter {
                notification.*.idle = false
                resource.sendResumed()
                if compositor.*.verbose { state.say("idle: resumed\n") }
            }
        } else {
            const start = if last > notification.*.made { last } else { notification.*.made }
            const quiet = if now > start { (now - start) / 1000 } else { 0 }
            if quiet >= notification.*.timeout && !(inhibited && notification.*.inhibitable) {
                notification.*.idle = true
                notification.*.idleAfter = last
                resource.sendIdled()
                if compositor.*.verbose { state.say("idle: idled\n") }
            }
        }
        index += 1
    }
}

// Its one request is destroy.
fn onNotification(context: *anyopaque, request: wl.server.Request) -> void {}

fn onNotificationDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = @intFromPtr(context)
    const compositor = notificationAt(address).*.compositor
    compositor.*.idleNotifications = state.listRemove(compositor.*.idleNotifications, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Notification)) }
}

fn onNotifier(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.ext_idle_notifier_v1.decodeRequest(request)
    var resource: wl.ext_idle_notification_v1.Resource = undefined
    var timeout: u32 = 0
    var inhibitable = true
    if request.opcode == wl.ext_idle_notifier_v1.REQUEST_GET_IDLE_NOTIFICATION {
        resource = decoded.get_idle_notification.id
        timeout = decoded.get_idle_notification.timeout
    } else if request.opcode == wl.ext_idle_notifier_v1.REQUEST_GET_INPUT_IDLE_NOTIFICATION {
        resource = decoded.get_input_idle_notification.id
        timeout = decoded.get_input_idle_notification.timeout
        inhibitable = false
    } else {
        return
    }
    const address = @intFromPtr(state.allocate(compositor, @sizeOf(Notification)))
    const notification = notificationAt(address)
    notification.*.compositor = compositor
    notification.*.resource = resource.object
    notification.*.timeout = @intCast(usize, timeout)
    notification.*.inhibitable = inhibitable
    notification.*.made = state.microseconds()
    notification.*.idle = false
    notification.*.idleAfter = 0
    compositor.*.idleNotifications = state.listAppend(compositor.*.idleNotifications, address)
    resource.setHandler(onNotification, contextAt(address))
    resource.setDestroyHandler(onNotificationDestroyed, contextAt(address))
}

fn bindNotifier(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.ext_idle_notifier_v1.Resource.fromObject(object).setHandler(onNotifier, context)
}

pub fn createGlobal(compositor: *Compositor) -> bool {
    compositor.*.idleNotifications = state.newList(compositor.*.allocator)
    compositor.*.hasIdleNotifier = true
    const memory: [*]u8 = unsafe { @ptrCast([*]u8, compositor) }
    return compositor.*.server.createGlobal(wl.Interface.ext_idle_notifier_v1, 2, bindNotifier, state.contextOf(memory)) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name: when
// the shell is loaded again (modules.mlx), each resource's handler is
// replaced by the new code's function of the same name. Every function
// passed to setHandler, setDestroyHandler, createGlobal or a client
// handler here must be listed (tools/check_compositor_modules.py checks;
// --fix rewrites this table).

pub const HANDLER_COUNT: usize = 4

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindNotifier) }
    if index == 1 { return @intFromPtr(onNotification) }
    if index == 2 { return @intFromPtr(onNotificationDestroyed) }
    if index == 3 { return @intFromPtr(onNotifier) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "idle.bindNotifier" }
    if index == 1 { return "idle.onNotification" }
    if index == 2 { return "idle.onNotificationDestroyed" }
    if index == 3 { return "idle.onNotifier" }
    return ""
}
