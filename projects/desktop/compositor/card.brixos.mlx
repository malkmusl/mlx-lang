// The graphics card's Vulkan device on brixOS (the compositor takes this
// file for card.mlx there). Our driver (projects/brix/vulkan) is offered to
// std.vulkan.loader over the system's cards (/devices/gpuN), and the
// device is looked for as the Vulkan renderer looks for one (vulkan.mlx's
// openDevice: the loader's drivers in order, std.gpu's open with sharing
// asked for). THE CHOICE AT START (the Vulkan driver's study, 8.2 (b), the
// roll-out's first step): the card when a device opens (which is only when
// its self-test, run by vkCreateDevice, passed: the kernel serves the
// calls at a boot whose card came up to stage 7) and the Vulkan renderer
// composes the first frame on it the same as the processor does, pixel for
// pixel; then every frame is composed on the card into its own memory and
// read back into the backend's frame (the renderer's copy path: a buffer
// of the card's, a readback buffer in the system's memory), from where the
// backend copies what changed into /devices/framebuffer as before. Else
// the processor, as before. One line in the log says which and why
// (card_choice.mlx makes it, once all is known, so that a line of the
// renderer's own comes before it). A frame the card cannot compose later
// hands the output to the processor for good (drm.brixos.mlx). On QEMU
// (no card) nothing changes.
const std = @import("std")
const loader = @import("std.vulkan.loader")
const gpu = @import("std.gpu")
const state = @import("./state.mlx")
const entries = @import("./entries.mlx")
const scene = @import("./scene.mlx")
const vulkan = @import("./vulkan.mlx")
const ui = @import("std.ui")
const drm = @import("./drm.mlx")
const choice = @import("./card_choice.mlx")
const driver = @import("../../brix/vulkan/driver.mlx")
const native = @import("../../brix/vulkan/card_brix.mlx")

const Compositor = state.Compositor

// The device's name, kept while the line is made.
var name: [256]u8 = undefined
var nameLength: usize = 0

fn keepName(context: *gpu.Context) -> void {
    const given = gpu.deviceName(context)
    nameLength = 0
    while nameLength < 256 && given[nameLength] != 0 {
        name[nameLength] = given[nameLength]
        nameLength += 1
    }
}

// The line for `outcome`, in one write.
fn tell(outcome: choice.Outcome, width: usize, height: usize, check: choice.Check, why: []const u8) -> void {
    var line: choice.Line = undefined
    choice.say(&line, outcome, name[0..nameLength], width, height, check, why)
    state.say(choice.text(&line))
}

pub fn look(compositor: *Compositor, arguments: [][*]const u8) -> void {
    const allocator = compositor.*.allocator
    const none = choice.Check.{ .differ = 0, .first = 0 }
    _ = driver.offer(native.interface())
    var manifests: loader.Manifests = undefined
    if loader.findDrivers(&manifests, arguments, allocator) == 0 {
        tell(choice.Outcome.no_device, 0, 0, none, "")
        return
    }
    var options = gpu.defaultOptions("kepler".pointer)
    options.wantSharing = true
    var index: usize = 0
    while index < manifests.count {
        var opened: loader.Driver = undefined
        const manifest = loader.manifestAt(&manifests, index)
        index += 1
        if loader.openDriver(&opened, manifest, allocator) != loader.Status.ok { continue }
        var context: gpu.Context = undefined
        const status = gpu.open(&context, opened, &options, allocator)
        if status == gpu.Status.ok || status == gpu.Status.deviceFailed || status == gpu.Status.driverIncomplete {
            keepName(&context)
            if status == gpu.Status.ok {
                // (The renderer opens a device of its own: this one goes.)
                gpu.close(&context)
                loader.closeDriver(&opened)
                onTheCard(compositor, arguments)
                return
            } else if manifest.*.builtIn != 0 && driver.refusal() == driver.Refusal.NO_ENGINE {
                tell(choice.Outcome.refused, 0, 0, none, "no engine of the card takes commands at this boot")
            } else if manifest.*.builtIn != 0 && driver.refusal() != driver.Refusal.NONE {
                tell(choice.Outcome.refused, 0, 0, none, driver.refusalText(driver.refusal()))
            } else {
                tell(choice.Outcome.refused, 0, 0, none, gpu.statusMessage(status))
            }
            loader.closeDriver(&opened)
            return
        }
        loader.closeDriver(&opened)
    }
    state.say("renderer: no Vulkan device opens; composing on the processor\n")
}

// Once a device opened: the renderer started on the backend's frame (its
// two slots both that frame, copied into by the card), its first frame
// composed and held against the processor's, and the line said.
fn onTheCard(compositor: *Compositor, arguments: [][*]const u8) -> void {
    const backend = drm.backendAt(compositor.*.drm)
    const output = drm.output(backend)
    const width = compositor.*.width
    const height = compositor.*.height
    const none = choice.Check.{ .differ = 0, .first = 0 }
    const frame = drm.frameOf(backend)
    var slot: usize = 0
    while slot < 2 {
        output.*.addresses[slot] = @intFromPtr(frame)
        output.*.pitches[slot] = width * 4
        output.*.sizes[slot] = width * height * 4
        slot += 1
    }
    if !entries.openRenderer(compositor, arguments, output) {
        tell(choice.Outcome.no_renderer, width, height, none, "")
        return
    }
    // The first frame: the whole output on the card, read back into our
    // frame, and the processor's composition of the same beside it.
    scene.damageAll(compositor)
    var changed: ui.Rect = undefined
    _ = scene.takeDamage(compositor, 0, &changed)
    compositor.*.copyRegion = scene.outputRect(compositor)
    const composed = entries.compose(compositor, 0)
    const bytes = width * height * 4
    const mine = state.allocate(compositor, bytes)
    entries.composeCpu(compositor, mine, scene.outputRect(compositor))
    const theirs: [*]const u32 = unsafe { @ptrCast([*]const u32, frame) }
    const ours: [*]const u32 = unsafe { @ptrCast([*]const u32, mine) }
    const check = if composed { choice.compare(theirs, ours, width * height) } else { none }
    if composed && check.differ == 0 {
        state.release(compositor, mine, bytes)
        tell(choice.Outcome.card, width, height, check, "")
        scene.damageAll(compositor)
        return
    }
    const renderer: *vulkan.Renderer = unsafe { @ptrFromInt(*vulkan.Renderer, compositor.*.renderer) }
    entries.adoptCpuRenderer(compositor)
    gpu.close(renderer.*.context)
    tell(if composed { choice.Outcome.differs } else { choice.Outcome.not_composed }, width, height, check, "")
    // (Our frame is the processor's again, whole.)
    std.mem.copy(frame, mine, bytes)
    state.release(compositor, mine, bytes)
    scene.damageAll(compositor)
}
