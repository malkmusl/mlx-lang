// The login session for the DRM backend, through systemd-logind on the
// system bus (std.dbus), as display managers (GDM, SDDM) set it up.
//
// TakeControl makes the compositor the session's controller: logind puts
// the session's VT into graphics mode with the kernel's keyboard handling
// off, and hands out the DRM card and the input devices with TakeDevice,
// without root. When the user switches to another VT (SwitchTo, on
// Ctrl+Alt+F1..F12) logind pauses the devices (PauseDevice: the card loses
// DRM master, input descriptors are revoked) and resumes them on return
// (ResumeDevice, with new input descriptors).

const std = @import("std")

const linux = std.linux
const dbus = @import("std.dbus")
const state = @import("./state.mlx")

const LOGIN1: []const u8 = "org.freedesktop.login1"
const MANAGER_PATH: []const u8 = "/org/freedesktop/login1"
const MANAGER: []const u8 = "org.freedesktop.login1.Manager"
const SESSION: []const u8 = "org.freedesktop.login1.Session"
const SEAT: []const u8 = "org.freedesktop.login1.Seat"

// A call waits this long for its reply (milliseconds).
const CALL_TIMEOUT: isize = 5000

pub const PAUSE: u8 = 1
pub const RESUME: u8 = 2
// PauseDevice's kinds: "pause" (acknowledge with PauseDeviceComplete),
// "force" (already paused), "gone" (the device was removed).
pub const PAUSE_ASKED: u8 = 0
pub const PAUSE_FORCED: u8 = 1
pub const PAUSE_GONE: u8 = 2

pub const Event = struct {
    kind: u8
    major: u32
    minor: u32
    pauseKind: u8
    // RESUME: the device's new descriptor (the caller owns it).
    descriptor: isize
}

pub const Session = struct {
    client: dbus.Client
    allocator: std.allocator.Allocator
    path: [128]u8
    pathLength: usize
    seatPath: [128]u8
    seatPathLength: usize
}

fn clientOf(session: *Session) -> *dbus.Client {
    unsafe { return @ptrFromInt(*dbus.Client, @intFromPtr(session) + @offsetOf(Session, "client")) }
}

fn pathOf(session: *Session) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(session) + @offsetOf(Session, "path")) }
}

fn seatPathOf(session: *Session) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(session) + @offsetOf(Session, "seatPath")) }
}

// Calls `member` with the body in `body` and waits for its reply, into
// `reply`; false (the error's name said) when it failed. The reply's body
// and descriptors stay the client's until its next call or `next`.
fn succeeded(session: *Session, destination: []const u8, path: []const u8, interface: []const u8, member: []const u8, signature: []const u8, body: *const dbus.Writer, reply: *dbus.Header) -> bool {
    const client = clientOf(session)
    if body.*.failed { return false }
    const serial = dbus.call(client, destination, path, interface, member, signature, body.*.bytes, body.*.length)
    if serial == 0 { return false }
    if !dbus.waitReply(client, serial, reply, CALL_TIMEOUT) { return false }
    if reply.*.kind != dbus.METHOD_RETURN {
        if reply.*.kind == dbus.ERROR {
            state.say("logind: ")
            state.say(reply.*.errorName)
            state.say("\n")
        }
        dbus.closeDescriptors(client, @intCast(usize, reply.*.unixFds))
        return false
    }
    return true
}

// Calls a method of our session object.
fn sessionCall(session: *Session, member: []const u8, signature: []const u8, body: *const dbus.Writer, reply: *dbus.Header) -> bool {
    return succeeded(session, LOGIN1, pathOf(session)[0..session.*.pathLength], SESSION, member, signature, body, reply)
}

// A call's body, built in `storage`.
fn beginBody(body: *dbus.Writer, storage: [*]u8) -> void { dbus.begin(body, storage, 512, false) }

fn bodyReader(session: *Session, reply: *const dbus.Header) -> dbus.Reader {
    return dbus.reader(dbus.bodyOf(clientOf(session), reply), reply.*.bodyLength, reply.*.big)
}

// A Unix descriptor argument ('h'): the message's descriptor it names
// (-1 when missing), which the caller then owns; the message's others are
// closed.
fn readHandle(session: *Session, reading: *dbus.Reader, count: u32) -> isize {
    const client = clientOf(session)
    const index = @intCast(usize, dbus.readU32(reading))
    if reading.*.failed || index >= @intCast(usize, count) {
        dbus.closeDescriptors(client, @intCast(usize, count))
        return -1
    }
    const descriptor = dbus.descriptorOf(client, index)
    dbus.closeDescriptors(client, index)
    return descriptor
}

// Connects to logind, finds our session ($XDG_SESSION_ID, else the one of
// our process) and its seat ($XDG_SEAT, else seat0), listens for its
// device signals and takes control of it. False (with a message) when any
// of that fails.
pub fn open(session: *Session, allocator: std.allocator.Allocator, environment: [*][*]const u8) -> bool {
    const client = clientOf(session)
    session.*.allocator = allocator
    // logind hands the devices over as descriptors: a bus that cannot pass
    // them is of no use.
    if !dbus.connectClient(client, allocator, dbus.systemPath(environment, dbus.SYSTEM_BUS)) || !client.*.unixFds || !dbus.keepSignals(client, allocator) {
        state.say("logind: cannot connect to the system bus\n")
        return false
    }
    var storage: [512]u8 = undefined
    var body: dbus.Writer = undefined
    var reply: dbus.Header = undefined
    beginBody(&body, &storage)
    const session_id = state.environmentValue(environment, "XDG_SESSION_ID")
    var found = false
    if @intFromPtr(session_id) != 0 {
        dbus.putString(&body, std.text.cString(session_id))
        found = succeeded(session, LOGIN1, MANAGER_PATH, MANAGER, "GetSession", "s", &body, &reply)
    } else {
        dbus.putU32(&body, @intCast(u32, linux.getpid()))
        found = succeeded(session, LOGIN1, MANAGER_PATH, MANAGER, "GetSessionByPID", "u", &body, &reply)
    }
    if !found {
        state.say("logind: no login session for this process\n")
        dbus.disconnect(client, allocator)
        return false
    }
    var reading = bodyReader(session, &reply)
    const path = dbus.readString(&reading)
    session.*.pathLength = std.text.append(pathOf(session), 0, 128, path)

    var seat_length: usize = std.text.append(seatPathOf(session), 0, 128, "/org/freedesktop/login1/seat/")
    const seat = state.environmentValue(environment, "XDG_SEAT")
    if @intFromPtr(seat) != 0 {
        seat_length = std.text.append(seatPathOf(session), seat_length, 128, std.text.cString(seat))
    } else {
        seat_length = std.text.append(seatPathOf(session), seat_length, 128, "seat0")
    }
    session.*.seatPathLength = seat_length

    // type='signal',sender='org.freedesktop.login1',interface='...Session',path='<ours>'
    var rule: [320]u8 = undefined
    var rule_bytes: [*]u8 = undefined
    unsafe { rule_bytes = @ptrCast([*]u8, &rule) }
    var rule_length = std.text.append(rule_bytes, 0, 320, "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Session',path='")
    rule_length = std.text.append(rule_bytes, rule_length, 320, pathOf(session)[0..session.*.pathLength])
    rule_length = std.text.append(rule_bytes, rule_length, 320, "'")
    beginBody(&body, &storage)
    dbus.putString(&body, rule_bytes[0..rule_length])
    if !succeeded(session, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "AddMatch", "s", &body, &reply) {
        dbus.disconnect(client, allocator)
        return false
    }

    beginBody(&body, &storage)
    dbus.putBool(&body, false)
    if !sessionCall(session, "TakeControl", "b", &body, &reply) {
        state.say("logind: cannot take control of the session (is another compositor running in it?)\n")
        dbus.disconnect(client, allocator)
        return false
    }
    return true
}

pub fn close(session: *Session) -> void {
    var storage: [512]u8 = undefined
    var body: dbus.Writer = undefined
    var reply: dbus.Header = undefined
    beginBody(&body, &storage)
    const released = sessionCall(session, "ReleaseControl", "", &body, &reply)
    dbus.disconnect(clientOf(session), session.*.allocator)
}

// The bus connection's descriptor, to wait on.
pub fn descriptor(session: *Session) -> isize { return dbus.descriptorOfClient(clientOf(session)) }

// A call of `member` on our session with the device `major`:`minor`.
fn deviceCall(session: *Session, member: []const u8, major: u32, minor: u32, reply: *dbus.Header) -> bool {
    var storage: [512]u8 = undefined
    var body: dbus.Writer = undefined
    beginBody(&body, &storage)
    dbus.putU32(&body, major)
    dbus.putU32(&body, minor)
    return sessionCall(session, member, "uu", &body, reply)
}

// Opens the device `major`:`minor` through logind. Returns its descriptor
// (-1 when refused); `inactive` tells that the session is not in the
// foreground right now (the device starts paused).
pub fn takeDevice(session: *Session, major: u32, minor: u32, inactive: *bool) -> isize {
    var reply: dbus.Header = undefined
    if !deviceCall(session, "TakeDevice", major, minor, &reply) { return -1 }
    var reading = bodyReader(session, &reply)
    const result = readHandle(session, &reading, reply.unixFds)
    inactive.* = dbus.readBool(&reading)
    return result
}

pub fn releaseDevice(session: *Session, major: u32, minor: u32) -> void {
    var reply: dbus.Header = undefined
    const released = deviceCall(session, "ReleaseDevice", major, minor, &reply)
}

// Tells logind a paused device ("pause") has been let go of.
pub fn pauseComplete(session: *Session, major: u32, minor: u32) -> void {
    var reply: dbus.Header = undefined
    const completed = deviceCall(session, "PauseDeviceComplete", major, minor, &reply)
}

// Switches the seat to virtual terminal `number`.
pub fn switchTo(session: *Session, number: u32) -> bool {
    var storage: [512]u8 = undefined
    var body: dbus.Writer = undefined
    var reply: dbus.Header = undefined
    beginBody(&body, &storage)
    dbus.putU32(&body, number)
    return succeeded(session, LOGIN1, seatPathOf(session)[0..session.*.seatPathLength], SEAT, "SwitchTo", "u", &body, &reply)
}

// The next device signal, if one came. False when there is none (other
// messages are skipped). `alive` turns false when the bus went away.
pub fn nextEvent(session: *Session, event: *Event, alive: *bool) -> bool {
    const client = clientOf(session)
    var message: dbus.Header = undefined
    while dbus.next(client, &message, 0) {
        const ours = message.kind == dbus.SIGNAL && std.text.same(message.interface, SESSION)
        if ours && std.text.same(message.member, "PauseDevice") {
            var reading = bodyReader(session, &message)
            event.*.kind = PAUSE
            event.*.major = dbus.readU32(&reading)
            event.*.minor = dbus.readU32(&reading)
            const kind = dbus.readString(&reading)
            event.*.pauseKind = if std.text.same(kind, "pause") { PAUSE_ASKED } else if std.text.same(kind, "gone") { PAUSE_GONE } else { PAUSE_FORCED }
            event.*.descriptor = -1
            dbus.closeDescriptors(client, @intCast(usize, message.unixFds))
            return true
        }
        if ours && std.text.same(message.member, "ResumeDevice") {
            var reading = bodyReader(session, &message)
            event.*.kind = RESUME
            event.*.major = dbus.readU32(&reading)
            event.*.minor = dbus.readU32(&reading)
            event.*.descriptor = readHandle(session, &reading, message.unixFds)
            return true
        }
        dbus.closeDescriptors(client, @intCast(usize, message.unixFds))
    }
    alive.* = !client.*.closed
    return false
}
