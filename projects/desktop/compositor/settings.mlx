// The compositor's settings, from $XDG_CONFIG_HOME/mlx/compositor.conf
// (~/.config/mlx/compositor.conf), read at start and again whenever the
// file changes (looked at twice a second), so a settings app (examples/
// mlx-settings) changes the running compositor by writing it. One setting
// per line, lines starting with `#` are comments:
//
//     border-color = #5aa0ff           (the focused window's frame and title bar)
//     inactive-border-color = #505060  (the other windows')
//     title-bars = on                  (on or off)
//     fps-counter = on                 (frames per second in title bars)
//     client-decorations = off         (programs draw their own title bars)
//     corner-radius = 12               (windows' rounded corners, 0 to 20
//                                       pixels; 0: square)
//     wobbly-windows = on              (moved windows wobble; Vulkan only)
//     animations = on                  (windows glide into place and grow
//                                       open, workspaces slide; slow:
//                                       eight times slower, to watch)
//     dock-autohide = off              (the dock slides away and reserves
//                                       no space; the bottom edge shows it)
//     key-maximize = Super+Up          (hotkeys: key-maximize, key-minimize,
//     key-fullscreen = Super+F          key-fullscreen, key-close,
//                                       key-terminal, key-switch, key-left,
//                                       key-right, key-move-left,
//                                       key-move-right, key-column-width,
//                                       key-tiling; "none" unbinds)
//     tiling = off                     (on: workspaces start with their
//                                       windows tiled as scrolling columns;
//                                       the top bar switches each)
//     display-mode = auto              (the monitor's mode at the next
//                                       start: WxH@HZ, WxH for the fastest
//                                       of that size, or auto: the native
//                                       one at its fastest rate)
//     night-light = off                (warmer colours: the monitor's
//     night-light-temperature = 4000    gamma table, at once; Kelvin, 1000
//                                       to 6500)
//
// Settings the file leaves out keep their defaults; a line that does not
// parse is ignored (and logged).
const std = @import("std")
const state = @import("./state.mlx")
const entries = @import("./entries.mlx")
const scene = @import("./scene.mlx")
const keys = @import("../shared/keys.mlx")
const display = @import("./display.mlx")

const Compositor = state.Compositor

const CHECK_INTERVAL: usize = 500
// Night light's colour temperature unless the file says (Kelvin).
const DEFAULT_TEMPERATURE: u32 = 4000

fn say(text: []const u8) -> void { state.say(text) }

// Where the file is: into compositor.settingsPath. Call once, with the
// environment set.
pub fn init(compositor: *Compositor) -> void {
    compositor.*.settingsPathLength = 0
    compositor.*.settingsStamp = 0
    compositor.*.settingsCheckedAt = 0
    const config = state.environmentValue(compositor.*.environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] != 0 {
        appendC(compositor, config)
    } else {
        const home = state.environmentValue(compositor.*.environment, "HOME")
        if @intFromPtr(home) == 0 || home[0] == 0 {
            // No file to read: the defaults.
            load(compositor, false)
            return
        }
        appendC(compositor, home)
        append(compositor, "/.config")
    }
    append(compositor, "/mlx/compositor.conf")
    compositor.*.settingsPath[compositor.*.settingsPathLength] = 0
    check(compositor)
}

fn append(compositor: *Compositor, text: []const u8) -> void {
    for byte in text {
        if compositor.*.settingsPathLength < 250 {
            compositor.*.settingsPath[compositor.*.settingsPathLength] = byte
            compositor.*.settingsPathLength += 1
        }
    }
}

fn appendC(compositor: *Compositor, text: [*]const u8) -> void {
    var index: usize = 0
    while text[index] != 0 && compositor.*.settingsPathLength < 250 {
        compositor.*.settingsPath[compositor.*.settingsPathLength] = text[index]
        compositor.*.settingsPathLength += 1
        index += 1
    }
}

fn pathOf(compositor: *Compositor) -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, @intFromPtr(compositor) + @offsetOf(Compositor, "settingsPath")) }
}

// Reads the file again when it changed; cheap enough for every turn of the
// event loop (it looks only twice a second).
pub fn poll(compositor: *Compositor) -> void {
    if compositor.*.settingsPathLength == 0 { return }
    const now = state.microseconds() / 1000
    if now - compositor.*.settingsCheckedAt < CHECK_INTERVAL { return }
    check(compositor)
}

fn check(compositor: *Compositor) -> void {
    compositor.*.settingsCheckedAt = state.microseconds() / 1000
    var status: std.fs.Stat = undefined
    // A missing file counts as stamp 1: the defaults.
    var stamp: usize = 1
    if std.fs.status(pathOf(compositor), &status) == 0 {
        stamp = @bitCast(usize, status.modifiedSeconds) *% 1000000000 +% @bitCast(usize, status.modifiedNanoseconds) +% @bitCast(usize, status.size) *% 7
    }
    if stamp == compositor.*.settingsStamp { return }
    compositor.*.settingsStamp = stamp
    load(compositor, stamp != 1)
}

// Back to the defaults, then what the file says.
fn load(compositor: *Compositor, exists: bool) -> void {
    compositor.*.focusColor = scene.FOCUS_COLOR
    compositor.*.frameColor = scene.FRAME_COLOR
    compositor.*.titleBars = true
    compositor.*.clientDecorations = false
    compositor.*.cornerRadius = scene.CORNER_RADIUS
    compositor.*.wobblyWindows = true
    compositor.*.animations = true
    compositor.*.animationScale = 1
    compositor.*.dockAutohide = false
    compositor.*.tilingDefault = false
    compositor.*.displayWidth = 0
    compositor.*.displayHeight = 0
    compositor.*.displayHertz = 0
    compositor.*.nightLight = false
    compositor.*.nightTemperature = DEFAULT_TEMPERATURE
    var action: usize = 0
    while action < keys.ACTIONS {
        var modifiers: u32 = 0
        var key: u32 = 0
        keys.defaultBinding(action, &modifiers, &key)
        compositor.*.hotkeyModifiers[action] = modifiers
        compositor.*.hotkeyKeys[action] = key
        action += 1
    }
    compositor.*.showFps = !compositor.*.noFpsOption
    if exists {
        const file = std.fs.open(pathOf(compositor), 0, 0)
        if std.fs.isValid(file) {
            const contents = std.fs.readToEndAlloc(file, compositor.*.allocator)
            const closed = std.fs.close(file)
            const text = contents.items
            var at: usize = 0
            while at < contents.length {
                var end = at
                while end < contents.length && text[end] != 10 { end += 1 }
                line(compositor, text[at..end])
                at = end + 1
            }
            std.fs.ArrayList.deinit(contents)
        }
    }
    if compositor.*.verbose {
        say("settings: border #")
        sayColor(compositor.*.focusColor)
        say(", inactive #")
        sayColor(compositor.*.frameColor)
        say(if compositor.*.titleBars { ", title bars on" } else { ", title bars off" })
        say(if compositor.*.showFps { ", fps counter on" } else { ", fps counter off" })
        say(if compositor.*.clientDecorations { ", client decorations on" } else { ", client decorations off" })
        say(", corner radius ")
        state.sayNumber(@intCast(usize, compositor.*.cornerRadius))
        say(if compositor.*.wobblyWindows { ", wobbly windows on" } else { ", wobbly windows off" })
        say(if !compositor.*.animations { ", animations off" } else if compositor.*.animationScale > 1 { ", animations slow" } else { ", animations on" })
        say(if compositor.*.dockAutohide { ", dock autohide on" } else { ", dock autohide off" })
        if compositor.*.displayWidth == 0 {
            say(", display mode auto")
        } else {
            say(", display mode ")
            state.sayNumber(@intCast(usize, compositor.*.displayWidth))
            say("x")
            state.sayNumber(@intCast(usize, compositor.*.displayHeight))
            if compositor.*.displayHertz != 0 {
                say("@")
                state.sayNumber(@intCast(usize, compositor.*.displayHertz))
            }
        }
        if compositor.*.nightLight {
            say(", night light ")
            state.sayNumber(@intCast(usize, compositor.*.nightTemperature))
            say(" K\n")
        } else {
            say(", night light off\n")
        }
    }
    // Everything is drawn again, with the colours in the renderer's
    // palette refreshed.
    if compositor.*.renderer != 0 { entries.rendererReloaded(compositor) }
    scene.damageAll(compositor)
    entries.settingsChanged(compositor)
    display.applyNightLight(compositor)
}

// "on"/"off" (also yes/no, true/false, 1/0) into `value`; false when it is
// neither.
fn parseSwitch(text: []const u8, value: *bool) -> bool {
    if std.text.same(text, "on") || std.text.same(text, "yes") || std.text.same(text, "true") || std.text.same(text, "1") {
        value.* = true
        return true
    }
    if std.text.same(text, "off") || std.text.same(text, "no") || std.text.same(text, "false") || std.text.same(text, "0") {
        value.* = false
        return true
    }
    return false
}

// A whole number of pixels, 0 to TITLE_HEIGHT (the frame's curve stays
// within the title bar), into `radius`; false otherwise.
fn parseRadius(text: []const u8, radius: *i32) -> bool {
    if text.length == 0 || text.length > 3 { return false }
    var value: i32 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return false }
        value = value * 10 + @intCast(i32, byte - 48)
    }
    if value > scene.TITLE_HEIGHT { return false }
    radius.* = value
    return true
}

// A hotkey line: its action by name, "none" or a combination.
fn parseHotkey(compositor: *Compositor, name: []const u8, value: []const u8) -> bool {
    var action: usize = 0
    while action < keys.ACTIONS {
        if std.text.same(name, keys.actionKey(action)) {
            if std.text.same(value, "none") {
                compositor.*.hotkeyModifiers[action] = 0
                compositor.*.hotkeyKeys[action] = 0
                return true
            }
            var modifiers: u32 = 0
            var key: u32 = 0
            if !keys.parse(value, &modifiers, &key) { return false }
            compositor.*.hotkeyModifiers[action] = modifiers
            compositor.*.hotkeyKeys[action] = key
            return true
        }
        action += 1
    }
    return false
}

// Digits from `text`'s start: their value, and how many into `used`.
fn digits(text: []const u8, used: *usize) -> u32 {
    var value: u32 = 0
    var index: usize = 0
    while index < text.length && index < 6 && text[index] >= 48 && text[index] <= 57 {
        value = value * 10 + @intCast(u32, text[index] - 48)
        index += 1
    }
    used.* = index
    return value
}

// "auto", "WxH" or "WxH@HZ" into the display-mode fields; false otherwise.
fn parseMode(compositor: *Compositor, text: []const u8) -> bool {
    if std.text.same(text, "auto") {
        compositor.*.displayWidth = 0
        return true
    }
    var used: usize = 0
    const width = digits(text, &used)
    if used == 0 || used + 1 >= text.length || text[used] != 120 { return false }
    var at = used + 1
    const height = digits(text[at..text.length], &used)
    if used == 0 || width == 0 || height == 0 { return false }
    at += used
    var hertz: u32 = 0
    if at < text.length {
        if text[at] != 64 { return false }
        hertz = digits(text[at + 1..text.length], &used)
        if used == 0 || at + 1 + used != text.length { return false }
    }
    compositor.*.displayWidth = width
    compositor.*.displayHeight = height
    compositor.*.displayHertz = hertz
    return true
}

fn hexDigit(byte: u8) -> u32 { return @intCast(u32, std.text.hexValue(byte)) }

// "#rrggbb" (or without the #) into an opaque colour; false otherwise.
fn parseColor(text: []const u8, color: *u32) -> bool {
    var start: usize = 0
    if text.length > 0 && text[0] == 35 { start = 1 }
    if text.length - start != 6 { return false }
    var value: u32 = 0
    var index = start
    while index < text.length {
        const digit = hexDigit(text[index])
        if digit == 16 { return false }
        value = value * 16 + digit
        index += 1
    }
    color.* = 4278190080 | value
    return true
}

fn line(compositor: *Compositor, raw: []const u8) -> void {
    const text = std.text.trimmed(raw)
    if text.length == 0 || text[0] == 35 { return }
    var equals: usize = 0
    while equals < text.length && text[equals] != 61 { equals += 1 }
    if equals == text.length {
        bad(text)
        return
    }
    const key = std.text.trimmed(text[0..equals])
    const value = std.text.trimmed(text[equals + 1..text.length])
    var ok = false
    var color: u32 = 0
    var on = true
    if std.text.same(key, "border-color") {
        ok = parseColor(value, &color)
        if ok { compositor.*.focusColor = color }
    } else if std.text.same(key, "inactive-border-color") {
        ok = parseColor(value, &color)
        if ok { compositor.*.frameColor = color }
    } else if std.text.same(key, "title-bars") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.titleBars = on }
    } else if std.text.same(key, "fps-counter") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.showFps = on && !compositor.*.noFpsOption }
    } else if std.text.same(key, "client-decorations") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.clientDecorations = on }
    } else if key.length > 4 && std.text.same(key[0..4], "key-") {
        ok = parseHotkey(compositor, key, value)
    } else if std.text.same(key, "dock-autohide") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.dockAutohide = on }
    } else if std.text.same(key, "wobbly-windows") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.wobblyWindows = on }
    } else if std.text.same(key, "animations") {
        if std.text.same(value, "slow") {
            ok = true
            compositor.*.animations = true
            compositor.*.animationScale = 8
        } else {
            ok = parseSwitch(value, &on)
            if ok { compositor.*.animations = on }
        }
    } else if std.text.same(key, "tiling") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.tilingDefault = on }
    } else if std.text.same(key, "language") {
        // The apps' (mlx-settings, shared/clock.mlx), not the compositor's.
        ok = true
    } else if std.text.same(key, "display-mode") {
        ok = parseMode(compositor, value)
    } else if std.text.same(key, "night-light") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.nightLight = on }
    } else if std.text.same(key, "night-light-temperature") {
        var used: usize = 0
        const kelvin = digits(value, &used)
        ok = used == value.length && kelvin >= 1000 && kelvin <= 6500
        if ok { compositor.*.nightTemperature = kelvin }
    } else if std.text.same(key, "corner-radius") {
        var radius: i32 = 0
        ok = parseRadius(value, &radius)
        if ok { compositor.*.cornerRadius = radius }
    }
    if !ok { bad(text) }
}

fn bad(text: []const u8) -> void {
    say("settings: ignored line: ")
    say(text)
    say("\n")
}

fn sayColor(color: u32) -> void {
    var digits: [6]u8 = undefined
    var index: usize = 0
    while index < 6 {
        const nibble = (color >> @intCast(u5, (5 - index) * 4)) & 15
        digits[index] = @intCast(u8, if nibble < 10 { 48 + nibble } else { 87 + nibble })
        index += 1
    }
    say(digits[0..6])
}
