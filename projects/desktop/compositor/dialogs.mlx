// Windows that belong to another (xdg_toplevel.set_parent): such a dialog
// opens centred over its parent, on the parent's workspace and outside the
// tiling, and stays above it (focusing the parent raises its dialogs with
// it). A modal one (xdg_dialog_v1.set_modal, xdg-dialog) takes the
// keyboard whenever its parent is given it, as GNOME does: the parent
// waits until the dialog is answered (`dialog: modal TITLE` in the log).
// When the parent is unmapped its dialogs belong to its own parent, as
// xdg-shell says.
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")

const Compositor = state.Compositor
const Surface = state.Surface
const Extension = state.SurfaceExtension

fn recordAt(address: usize) -> *Extension {
    unsafe { return @ptrFromInt(*Extension, address) }
}

fn contextAt(address: usize) -> *anyopaque {
    unsafe { return @ptrFromInt(*anyopaque, address) }
}

// The window whose xdg_toplevel is `object` (0: none).
fn windowOf(compositor: *Compositor, object: wl.server.Object) -> usize {
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const address = state.listAt(compositor.*.surfaces, index)
        const surface = state.surfaceAt(address)
        if surface.*.hasToplevel && surface.*.toplevel.id == object.id && state.sameClient(surface.*.toplevel, object) { return address }
        index += 1
    }
    return 0
}

// xdg_toplevel.set_parent (null: none). The window itself, or a window
// that is its dialog already, cannot be its parent (invalid_parent).
pub fn setParent(surface: *Surface, parent: wl.xdg_toplevel.Resource) -> void {
    const address = if parent.isNull() { 0 } else { windowOf(surface.*.compositor, parent.object) }
    if !setParentWindow(surface, address) {
        wl.xdg_toplevel.Resource.fromObject(surface.*.toplevel).postError(@intFromEnum(wl.xdg_toplevel.Error.invalid_parent), "a window cannot be its own parent")
    }
}

// Makes the window at `address` (0: none) the surface's parent; false,
// leaving it as it was, when that would make it its own.
pub fn setParentWindow(surface: *Surface, address: usize) -> bool {
    const own = state.addressOfSurface(surface)
    var current = address
    var depth: usize = 0
    while current != 0 && depth < 16 {
        if current == own { return false }
        current = state.surfaceAt(current).*.transientFor
        depth += 1
    }
    surface.*.transientFor = address
    return true
}

// Where a new dialog goes: centred over its mapped parent (its title bar
// kept clear of the panels' edges and on the output), on the parent's
// workspace. False for a window without one (scene.place's to place).
pub fn place(compositor: *Compositor, surface: *Surface) -> bool {
    if surface.*.transientFor == 0 { return false }
    const parent = state.surfaceAt(surface.*.transientFor)
    if !parent.*.mapped { return false }
    const centre_x = scene.windowX(parent) + scene.windowWidth(parent) / 2
    const centre_y = scene.windowY(parent) + scene.windowHeight(parent) / 2
    surface.*.x += centre_x - scene.windowWidth(surface) / 2 - scene.windowX(surface)
    surface.*.y += centre_y - scene.windowHeight(surface) / 2 - scene.windowY(surface)
    const below = scene.titleY(surface) + scene.titleHeight(surface) + 4 + scene.windowHeight(surface) - (@intCast(i32, compositor.*.height) - compositor.*.reserveBottom)
    if below > 0 { surface.*.y -= below }
    if scene.titleY(surface) < compositor.*.reserveTop { surface.*.y += compositor.*.reserveTop - scene.titleY(surface) }
    if scene.titleX(surface) < compositor.*.reserveLeft { surface.*.x += compositor.*.reserveLeft - scene.titleX(surface) }
    const right = scene.titleX(surface) + scene.titleWidth(surface) - @intCast(i32, compositor.*.width)
    if right > 0 { surface.*.x -= right }
    surface.*.workspace = parent.*.workspace
    return true
}

// Raises the window at `address` and its dialogs above it (theirs above
// them, and so on).
pub fn raise(compositor: *Compositor, address: usize) -> void { raiseFrom(compositor, address, 0) }

fn raiseFrom(compositor: *Compositor, address: usize, depth: usize) -> void {
    scene.raise(compositor, address)
    if depth >= 8 { return }
    var dialogs: [8]usize = undefined
    var count: usize = 0
    var index: usize = 0
    while index < compositor.*.stack.length && count < 8 {
        const other = state.listAt(compositor.*.stack, index)
        const surface = state.surfaceAt(other)
        if surface.*.role == state.ROLE_TOPLEVEL && surface.*.transientFor == address {
            dialogs[count] = other
            count += 1
        }
        index += 1
    }
    index = 0
    while index < count {
        raiseFrom(compositor, dialogs[index], depth + 1)
        index += 1
    }
}

// The window that takes the keyboard when the one at `address` is given
// it: its modal dialog (that dialog's own, and so on), else itself.
pub fn modalFor(compositor: *Compositor, address: usize) -> usize {
    var current = address
    var depth: usize = 0
    while depth < 8 {
        var found: usize = 0
        var index = compositor.*.stack.length
        while index > 0 && found == 0 {
            index -= 1
            const other = state.listAt(compositor.*.stack, index)
            const surface = state.surfaceAt(other)
            if surface.*.mapped && surface.*.modal && surface.*.transientFor == current { found = other }
        }
        if found == 0 { return current }
        current = found
        depth += 1
    }
    return current
}

// The window at `address` is unmapped or gone: its dialogs belong to its
// parent.
pub fn parentGone(compositor: *Compositor, address: usize) -> void {
    const grandparent = state.surfaceAt(address).*.transientFor
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        if surface.*.transientFor == address { surface.*.transientFor = grandparent }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// xdg-dialog

fn onDialog(context: *anyopaque, request: wl.server.Request) -> void {
    const record = recordAt(@intFromPtr(context))
    if record.*.surface == 0 { return }
    const surface = state.surfaceAt(record.*.surface)
    if request.opcode == wl.xdg_dialog_v1.REQUEST_SET_MODAL {
        surface.*.modal = true
        if record.*.compositor.*.verbose {
            state.say("dialog: modal ")
            state.sayTitle(surface)
            state.say("\n")
        }
    } else if request.opcode == wl.xdg_dialog_v1.REQUEST_UNSET_MODAL {
        surface.*.modal = false
    }
}

fn onDialogDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = @intFromPtr(context)
    const record = recordAt(address)
    if record.*.surface != 0 {
        state.surfaceAt(record.*.surface).*.modal = false
        state.surfaceAt(record.*.surface).*.dialogRecord = 0
    }
    unsafe { state.release(record.*.compositor, @ptrFromInt([*]u8, address), @sizeOf(Extension)) }
}

fn onDialogManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    if request.opcode != wl.xdg_wm_dialog_v1.REQUEST_GET_XDG_DIALOG { return }
    const decoded = wl.xdg_wm_dialog_v1.decodeRequest(request).get_xdg_dialog
    const window = windowOf(compositor, decoded.toplevel.object)
    if window == 0 { return }
    if state.surfaceAt(window).*.dialogRecord != 0 {
        wl.xdg_wm_dialog_v1.Resource.fromObject(request.object).postError(@intFromEnum(wl.xdg_wm_dialog_v1.Error.already_used), "the window has a dialog object already")
        return
    }
    const address = @intFromPtr(state.allocate(compositor, @sizeOf(Extension)))
    const record = recordAt(address)
    record.*.compositor = compositor
    record.*.resource = decoded.id.object
    record.*.surface = window
    state.surfaceAt(window).*.dialogRecord = address
    decoded.id.setHandler(onDialog, contextAt(address))
    decoded.id.setDestroyHandler(onDialogDestroyed, contextAt(address))
}

fn bindDialogManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.xdg_wm_dialog_v1.Resource.fromObject(object).setHandler(onDialogManager, context)
}

// A window's toplevel or surface is going away: its dialog object stays,
// about no window, and its dialogs belong to its parent.
pub fn surfaceGone(compositor: *Compositor, surface: *Surface) -> void {
    if surface.*.dialogRecord != 0 { recordAt(surface.*.dialogRecord).*.surface = 0 }
    surface.*.dialogRecord = 0
    parentGone(compositor, state.addressOfSurface(surface))
    surface.*.transientFor = 0
    surface.*.modal = false
}

pub fn createGlobal(compositor: *Compositor) -> bool {
    const memory: [*]u8 = unsafe { @ptrCast([*]u8, compositor) }
    return compositor.*.server.createGlobal(wl.Interface.xdg_wm_dialog_v1, 1, bindDialogManager, state.contextOf(memory)) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name: when
// the shell is loaded again (modules.mlx), each resource's handler is
// replaced by the new code's function of the same name. Every function
// passed to setHandler, setDestroyHandler, createGlobal or a client
// handler here must be listed (tools/check_compositor_modules.py checks;
// --fix rewrites this table).

pub const HANDLER_COUNT: usize = 4

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindDialogManager) }
    if index == 1 { return @intFromPtr(onDialog) }
    if index == 2 { return @intFromPtr(onDialogDestroyed) }
    if index == 3 { return @intFromPtr(onDialogManager) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "dialogs.bindDialogManager" }
    if index == 1 { return "dialogs.onDialog" }
    if index == 2 { return "dialogs.onDialogDestroyed" }
    if index == 3 { return "dialogs.onDialogManager" }
    return ""
}
