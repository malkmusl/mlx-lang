// What clients say of their surfaces, kept for what may use it:
//
//   - wp_tearing_control_manager_v1 (tearing-control): a game asks for its
//     frames to be shown at once rather than at the next vertical blank
//     (`tearing: async TITLE` in the log). Frames are always shown at
//     the vertical blank here, which the protocol allows;
//   - wp_content_type_manager_v1 (content-type): what a surface shows, a
//     photo, a video or a game (`content: video TITLE`).
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")

const Compositor = state.Compositor
const Surface = state.Surface
const Extension = state.SurfaceExtension

fn recordAt(address: usize) -> *Extension {
    unsafe { return @ptrFromInt(*Extension, address) }
}

fn contextAt(address: usize) -> *anyopaque {
    unsafe { return @ptrFromInt(*anyopaque, address) }
}

fn newRecord(compositor: *Compositor, resource: wl.server.Object, surface: usize) -> usize {
    const address = @intFromPtr(state.allocate(compositor, @sizeOf(Extension)))
    recordAt(address).*.compositor = compositor
    recordAt(address).*.resource = resource
    recordAt(address).*.surface = surface
    return address
}

fn releaseRecord(address: usize) -> void {
    unsafe { state.release(recordAt(address).*.compositor, @ptrFromInt([*]u8, address), @sizeOf(Extension)) }
}

// For the log: the window the surface belongs to.
fn sayWindow(surface: *Surface) -> void {
    const window = scene.toplevelOf(state.addressOfSurface(surface))
    if window != 0 { state.sayTitle(state.surfaceAt(window)) }
    state.say("\n")
}

// ---------------------------------------------------------------------------
// tearing-control

fn onTearing(context: *anyopaque, request: wl.server.Request) -> void {
    const record = recordAt(@intFromPtr(context))
    if record.*.surface == 0 || request.opcode != wl.wp_tearing_control_v1.REQUEST_SET_PRESENTATION_HINT { return }
    const surface = state.surfaceAt(record.*.surface)
    surface.*.asyncPresentation = wl.wp_tearing_control_v1.decodeRequest(request).set_presentation_hint.hint == @intFromEnum(wl.wp_tearing_control_v1.PresentationHint.async)
    if record.*.compositor.*.verbose {
        state.say(if surface.*.asyncPresentation { "tearing: async " } else { "tearing: vsync " })
        sayWindow(surface)
    }
}

fn onTearingDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = @intFromPtr(context)
    const record = recordAt(address)
    if record.*.surface != 0 {
        state.surfaceAt(record.*.surface).*.asyncPresentation = false
        state.surfaceAt(record.*.surface).*.tearingRecord = 0
    }
    releaseRecord(address)
}

fn onTearingManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    if request.opcode != wl.wp_tearing_control_manager_v1.REQUEST_GET_TEARING_CONTROL { return }
    const decoded = wl.wp_tearing_control_manager_v1.decodeRequest(request).get_tearing_control
    const surface = state.findSurface(compositor, decoded.surface.object)
    if surface == 0 { return }
    if state.surfaceAt(surface).*.tearingRecord != 0 {
        wl.wp_tearing_control_manager_v1.Resource.fromObject(request.object).postError(@intFromEnum(wl.wp_tearing_control_manager_v1.Error.tearing_control_exists), "the surface has a tearing control already")
        return
    }
    const address = newRecord(compositor, decoded.id.object, surface)
    state.surfaceAt(surface).*.tearingRecord = address
    decoded.id.setHandler(onTearing, contextAt(address))
    decoded.id.setDestroyHandler(onTearingDestroyed, contextAt(address))
}

fn bindTearingManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.wp_tearing_control_manager_v1.Resource.fromObject(object).setHandler(onTearingManager, context)
}

// ---------------------------------------------------------------------------
// content-type

fn onContentType(context: *anyopaque, request: wl.server.Request) -> void {
    const record = recordAt(@intFromPtr(context))
    if record.*.surface == 0 || request.opcode != wl.wp_content_type_v1.REQUEST_SET_CONTENT_TYPE { return }
    const surface = state.surfaceAt(record.*.surface)
    const kind = wl.wp_content_type_v1.decodeRequest(request).set_content_type.content_type
    surface.*.contentType = kind
    if record.*.compositor.*.verbose {
        state.say("content: ")
        if kind == @intFromEnum(wl.wp_content_type_v1.Type.photo) {
            state.say("photo ")
        } else if kind == @intFromEnum(wl.wp_content_type_v1.Type.video) {
            state.say("video ")
        } else if kind == @intFromEnum(wl.wp_content_type_v1.Type.game) {
            state.say("game ")
        } else {
            state.say("none ")
        }
        sayWindow(surface)
    }
}

fn onContentTypeDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = @intFromPtr(context)
    const record = recordAt(address)
    if record.*.surface != 0 {
        state.surfaceAt(record.*.surface).*.contentType = 0
        state.surfaceAt(record.*.surface).*.contentTypeRecord = 0
    }
    releaseRecord(address)
}

fn onContentTypeManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    if request.opcode != wl.wp_content_type_manager_v1.REQUEST_GET_SURFACE_CONTENT_TYPE { return }
    const decoded = wl.wp_content_type_manager_v1.decodeRequest(request).get_surface_content_type
    const surface = state.findSurface(compositor, decoded.surface.object)
    if surface == 0 { return }
    if state.surfaceAt(surface).*.contentTypeRecord != 0 {
        wl.wp_content_type_manager_v1.Resource.fromObject(request.object).postError(@intFromEnum(wl.wp_content_type_manager_v1.Error.already_constructed), "the surface has a content type already")
        return
    }
    const address = newRecord(compositor, decoded.id.object, surface)
    state.surfaceAt(surface).*.contentTypeRecord = address
    decoded.id.setHandler(onContentType, contextAt(address))
    decoded.id.setDestroyHandler(onContentTypeDestroyed, contextAt(address))
}

fn bindContentTypeManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.wp_content_type_manager_v1.Resource.fromObject(object).setHandler(onContentTypeManager, context)
}

// ---------------------------------------------------------------------------

// A surface is going away: its hint objects stay, about no surface.
pub fn surfaceGone(surface: *Surface) -> void {
    if surface.*.tearingRecord != 0 { recordAt(surface.*.tearingRecord).*.surface = 0 }
    if surface.*.contentTypeRecord != 0 { recordAt(surface.*.contentTypeRecord).*.surface = 0 }
    surface.*.tearingRecord = 0
    surface.*.contentTypeRecord = 0
}

pub fn createGlobals(compositor: *Compositor) -> bool {
    const memory: [*]u8 = unsafe { @ptrCast([*]u8, compositor) }
    const context = state.contextOf(memory)
    if compositor.*.server.createGlobal(wl.Interface.wp_tearing_control_manager_v1, 1, bindTearingManager, context) == 0 { return false }
    return compositor.*.server.createGlobal(wl.Interface.wp_content_type_manager_v1, 1, bindContentTypeManager, context) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name: when
// the shell is loaded again (modules.mlx), each resource's handler is
// replaced by the new code's function of the same name. Every function
// passed to setHandler, setDestroyHandler, createGlobal or a client
// handler here must be listed (tools/check_compositor_modules.py checks;
// --fix rewrites this table).

pub const HANDLER_COUNT: usize = 8

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindContentTypeManager) }
    if index == 1 { return @intFromPtr(bindTearingManager) }
    if index == 2 { return @intFromPtr(onContentType) }
    if index == 3 { return @intFromPtr(onContentTypeDestroyed) }
    if index == 4 { return @intFromPtr(onContentTypeManager) }
    if index == 5 { return @intFromPtr(onTearing) }
    if index == 6 { return @intFromPtr(onTearingDestroyed) }
    if index == 7 { return @intFromPtr(onTearingManager) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "hints.bindContentTypeManager" }
    if index == 1 { return "hints.bindTearingManager" }
    if index == 2 { return "hints.onContentType" }
    if index == 3 { return "hints.onContentTypeDestroyed" }
    if index == 4 { return "hints.onContentTypeManager" }
    if index == 5 { return "hints.onTearing" }
    if index == 6 { return "hints.onTearingDestroyed" }
    if index == 7 { return "hints.onTearingManager" }
    return ""
}
