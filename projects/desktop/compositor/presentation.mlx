// When a surface's content reached the screen (wp_presentation,
// presentation-time): video players and browsers time their frames by it.
// A feedback asked for goes with the surface's next commit; when the
// frame that shows it is presented (windows.frameDone) the feedback says
// so, with the time (CLOCK_MONOTONIC), the output's refresh period and
// the frame's number, and vsync when the frame came from a DRM page flip
// (freestanding). Content replaced by another commit before a frame
// showed it, or of a surface that shows nothing or went, is discarded.
// A greeter compositor does not offer it.
const wl = @import("std.wayland")
const state = @import("./state.mlx")

const Compositor = state.Compositor
const Surface = state.Surface

const CLOCK_MONOTONIC: u32 = 1
const FLAG_VSYNC: u32 = 1
const FLAG_HW_COMPLETION: u32 = 4

fn feedbackOf(surface: *const Surface, id: u32) -> wl.wp_presentation_feedback.Resource {
    return wl.wp_presentation_feedback.Resource.fromObject(wl.server.Object.{ .client = surface.*.resource.client, .id = id })
}

fn discard(surface: *Surface) -> void {
    var index: usize = 0
    while index < surface.*.feedbackCount {
        feedbackOf(surface, surface.*.feedbacks[index]).sendDiscarded()
        index += 1
    }
    surface.*.feedbackCount = 0
}

// A commit: the feedbacks asked for since go with its content, and the
// content before it, not shown yet, will never be.
pub fn committed(surface: *Surface) -> void {
    if surface.*.feedbackCount == 0 && surface.*.pendingFeedbackCount == 0 { return }
    discard(surface)
    var index: usize = 0
    while index < surface.*.pendingFeedbackCount {
        surface.*.feedbacks[index] = surface.*.pendingFeedbacks[index]
        index += 1
    }
    surface.*.feedbackCount = surface.*.pendingFeedbackCount
    surface.*.pendingFeedbackCount = 0
}

// A frame reached the screen: what the surfaces showed in it was
// presented.
pub fn presented(compositor: *Compositor) -> void {
    const now = state.microseconds()
    const seconds = now / 1000000
    const nanoseconds = @intCast(u32, now % 1000000 * 1000)
    const millihertz: usize = if compositor.*.outputMillihertz > 0 { @intCast(usize, compositor.*.outputMillihertz) } else { 60000 }
    const refresh = @intCast(u32, 1000000000000 / millihertz)
    const frame = compositor.*.frames
    const flags: u32 = if compositor.*.freestanding { FLAG_VSYNC | FLAG_HW_COMPLETION } else { 0 }
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        if surface.*.feedbackCount > 0 && !surface.*.hasContent {
            discard(surface)
        } else if surface.*.feedbackCount > 0 {
            var at: usize = 0
            while at < surface.*.feedbackCount {
                feedbackOf(surface, surface.*.feedbacks[at]).sendPresented(@intCast(u32, seconds >> 32), @intCast(u32, seconds & 4294967295), nanoseconds, refresh, @intCast(u32, frame >> 32), @intCast(u32, frame & 4294967295), flags)
                at += 1
            }
            surface.*.feedbackCount = 0
        }
        index += 1
    }
}

// A surface is going away: nothing of it will be shown.
pub fn surfaceGone(surface: *Surface) -> void {
    discard(surface)
    var index: usize = 0
    while index < surface.*.pendingFeedbackCount {
        feedbackOf(surface, surface.*.pendingFeedbacks[index]).sendDiscarded()
        index += 1
    }
    surface.*.pendingFeedbackCount = 0
}

fn onPresentation(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    if request.opcode != wl.wp_presentation.REQUEST_FEEDBACK { return }
    const decoded = wl.wp_presentation.decodeRequest(request).feedback
    const address = state.findSurface(compositor, decoded.surface.object)
    // More than a surface keeps at once: told at once it is not kept.
    if address == 0 || state.surfaceAt(address).*.pendingFeedbackCount >= state.MAX_FEEDBACKS {
        decoded.callback.sendDiscarded()
        return
    }
    const surface = state.surfaceAt(address)
    surface.*.pendingFeedbacks[surface.*.pendingFeedbackCount] = decoded.callback.object.id
    surface.*.pendingFeedbackCount += 1
}

fn bindPresentation(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    const presentation = wl.wp_presentation.Resource.fromObject(object)
    presentation.setHandler(onPresentation, context)
    presentation.sendClockId(CLOCK_MONOTONIC)
}

pub fn createGlobal(compositor: *Compositor) -> bool {
    const memory: [*]u8 = unsafe { @ptrCast([*]u8, compositor) }
    return compositor.*.server.createGlobal(wl.Interface.wp_presentation, 1, bindPresentation, state.contextOf(memory)) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name: when
// the shell is loaded again (modules.mlx), each resource's handler is
// replaced by the new code's function of the same name. Every function
// passed to setHandler, setDestroyHandler, createGlobal or a client
// handler here must be listed (tools/check_compositor_modules.py checks;
// --fix rewrites this table).

pub const HANDLER_COUNT: usize = 2

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindPresentation) }
    if index == 1 { return @intFromPtr(onPresentation) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "presentation.bindPresentation" }
    if index == 1 { return "presentation.onPresentation" }
    return ""
}
