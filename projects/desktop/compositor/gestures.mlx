// Three-finger swipes on a touchpad, as niri has them: sideways on a
// tiling workspace the strip of columns follows the fingers and settles
// on a column when they lift (further on after a flick); up and down, and
// sideways on a floating workspace, the next or previous workspace slides
// in with the fingers, and when they lift it comes all the way (past a
// third of the screen, or flicked that way) or springs back.
//
// The content follows the fingers: fingers going left pull the strip left
// (the view goes right) and the next workspace in from the right; going up
// they pull the next one in from below.
//
// Swipes come from the backends through entries.pointerSwipe: evdev
// (three fingers on the pad) and, nested, the host's zwp_pointer_gestures_v1.
// Fewer than three fingers are not ours (two fingers scroll).
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const tiling_module = @import("./tiling.mlx")
const workspaces_module = @import("./workspaces.mlx")
const animation_module = @import("./animation.mlx")

const Compositor = state.Compositor

pub const PHASE_BEGIN: u32 = 0
pub const PHASE_UPDATE: u32 = 1
pub const PHASE_END: u32 = 2
pub const PHASE_CANCEL: u32 = 3

// How far the fingers go before the swipe's way is decided (1/256 pixels).
const DECIDE: i32 = 4096
// A workspace swipe let go past this much of the way (of 1024) switches;
// so does one flicked that way faster than FLICK pixels a second.
const COMMIT: i32 = 340
const FLICK: i32 = 600
const FLICK_PAUSE: usize = 120000

fn magnitude(value: i32) -> i32 { return if value < 0 { 0 - value } else { value } }

// The fingers moved (dx, dy) in 1/256 pixels (`phase` PHASE_*; `fingers`
// at the beginning).
pub fn swipe(compositor: *Compositor, phase: u32, fingers: u32, dx: i32, dy: i32) -> void {
    if phase == PHASE_BEGIN {
        compositor.*.swipeActive = fingers >= 3
        compositor.*.swipeAxis = state.SWIPE_AXIS_NONE
        compositor.*.swipeKind = state.SWIPE_KIND_NONE
        compositor.*.swipeX = 0
        compositor.*.swipeY = 0
        compositor.*.swipeTarget = state.MAX_WORKSPACES
        compositor.*.swipeVelocity = 0
        compositor.*.swipeTime = state.microseconds()
        return
    }
    if !compositor.*.swipeActive { return }
    if phase == PHASE_UPDATE {
        update(compositor, dx, dy)
        return
    }
    compositor.*.swipeActive = false
    finish(compositor, phase == PHASE_CANCEL)
}

fn update(compositor: *Compositor, dx: i32, dy: i32) -> void {
    compositor.*.swipeX += dx
    compositor.*.swipeY += dy
    if compositor.*.swipeAxis == state.SWIPE_AXIS_NONE {
        if magnitude(compositor.*.swipeX) < DECIDE && magnitude(compositor.*.swipeY) < DECIDE { return }
        decide(compositor)
        // Everything so far counts.
        if compositor.*.swipeKind == state.SWIPE_KIND_STRIP {
            tiling_module.scroll(compositor, 0 - compositor.*.swipeX / 256)
            return
        }
    } else if compositor.*.swipeKind == state.SWIPE_KIND_STRIP {
        tiling_module.scroll(compositor, 0 - dx / 256)
        return
    }
    if compositor.*.swipeKind != state.SWIPE_KIND_WORKSPACE { return }
    // How fast along the way (pixels a second).
    const along = if compositor.*.swipeAxis == state.SWIPE_AXIS_VERTICAL { dy } else { dx }
    const now = state.microseconds()
    const elapsed = now - compositor.*.swipeTime
    if elapsed > 0 && elapsed < 100000 {
        const speed = @intCast(i32, @intCast(i64, along) * 1000000 / 256 / @intCast(i64, elapsed))
        compositor.*.swipeVelocity = (speed * 3 + compositor.*.swipeVelocity) / 4
    }
    compositor.*.swipeTime = now
    pull(compositor)
}

// The first moves decide: sideways on a tiling workspace the strip,
// otherwise workspaces.
fn decide(compositor: *Compositor) -> void {
    const sideways = magnitude(compositor.*.swipeX) >= magnitude(compositor.*.swipeY)
    compositor.*.swipeAxis = if sideways { state.SWIPE_AXIS_HORIZONTAL } else { state.SWIPE_AXIS_VERTICAL }
    if sideways && compositor.*.workspaceTiling[compositor.*.workspace] {
        compositor.*.swipeKind = state.SWIPE_KIND_STRIP
        compositor.*.fingerScrolling = true
        compositor.*.fingerScrolledAt = 0
        return
    }
    compositor.*.swipeKind = state.SWIPE_KIND_WORKSPACE
    if compositor.*.verbose { state.say(if sideways { "swipe: workspaces sideways\n" } else { "swipe: workspaces up and down\n" }) }
}

// A workspace swipe: the workspace on the side the fingers pull from comes
// in as far as they went (none past the first or the last: the one shown
// stays).
fn pull(compositor: *Compositor) -> void {
    const vertical = compositor.*.swipeAxis == state.SWIPE_AXIS_VERTICAL
    var travel = compositor.*.swipeX / 256
    var distance = @intCast(i32, compositor.*.width)
    if vertical {
        travel = compositor.*.swipeY / 256
        distance = @intCast(i32, compositor.*.height)
    }
    // Fingers going left (or up) pull in the next workspace from the right
    // (or from below).
    const next = travel < 0
    const current = compositor.*.workspace
    var target = state.MAX_WORKSPACES
    if next && current + 1 < state.MAX_WORKSPACES { target = current + 1 }
    if !next && current > 0 { target = current - 1 }
    if target == state.MAX_WORKSPACES || travel == 0 {
        // Nothing that way: what was pulled in goes back.
        if compositor.*.slideTracking { animation_module.trackSlide(compositor, compositor.*.slideFrom, compositor.*.slideRight, vertical, 0) }
        compositor.*.swipeTarget = state.MAX_WORKSPACES
        return
    }
    compositor.*.swipeTarget = target
    const progress = @intCast(i32, @intCast(i64, magnitude(travel)) * 1024 / @intCast(i64, if distance > 0 { distance } else { 1 }))
    animation_module.trackSlide(compositor, target, next, vertical, progress)
}

fn finish(compositor: *Compositor, cancelled: bool) -> void {
    const kind = compositor.*.swipeKind
    compositor.*.swipeKind = state.SWIPE_KIND_NONE
    if kind == state.SWIPE_KIND_STRIP {
        compositor.*.fingerScrolling = false
        tiling_module.settle(compositor)
        return
    }
    if kind != state.SWIPE_KIND_WORKSPACE { return }
    const target = compositor.*.swipeTarget
    compositor.*.swipeTarget = state.MAX_WORKSPACES
    if target == state.MAX_WORKSPACES || !compositor.*.slideTracking {
        animation_module.springBack(compositor)
        return
    }
    // Flicked towards the incoming workspace: the velocity has the sign of
    // the travel that pulls it in (both negative for the next one). Fingers
    // that rested before lifting flicked nothing.
    var velocity = compositor.*.swipeVelocity
    if state.microseconds() - compositor.*.swipeTime > FLICK_PAUSE { velocity = 0 }
    const toward = if compositor.*.slideRight { 0 - velocity } else { velocity }
    const commit = !cancelled && (compositor.*.slideProgress >= COMMIT || toward >= FLICK)
    if compositor.*.verbose {
        state.say(if commit { "swipe: to workspace " } else { "swipe: back from workspace " })
        state.sayNumber(target + 1)
        state.say("\n")
    }
    if commit {
        workspaces_module.switchTo(compositor, target)
    } else {
        animation_module.springBack(compositor)
    }
}
