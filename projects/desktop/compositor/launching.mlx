// Launching clients; windows zooming out of the dock, previews, the dock hiding (part of shell.mlx, split from it).
const std = @import("std")
const wl = @import("std.wayland")
const ui = @import("std.ui")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const preview_layout = @import("./preview_layout.mlx")
const shell = @import("./shell.mlx")
const protocols_module = @import("./protocols.mlx")
const xwayland_module = @import("./xwayland.mlx")
const xwm_module = @import("./xwm.mlx")
const workspaces_module = @import("./workspaces.mlx")
const lock_module = @import("./lock.mlx")
const windows_module = @import("./windows.mlx")
const data_module = @import("./data.mlx")

const SOCK_STREAM_CLOEXEC: usize = 524289
const SYS_kill: usize = 62

// ---------------------------------------------------------------------------
// Launching clients

// Runs `program` (a path, or a name looked up in PATH) with our
// WAYLAND_DISPLAY. Only called in the forked child.
fn execute(program: [*]const u8, environment: [*][*]const u8) -> void {
    var arguments: [2][*]const u8 = undefined
    unsafe {
        arguments[0] = program
        arguments[1] = @ptrFromInt([*]const u8, 0)
    }
    var has_slash = false
    var length: usize = 0
    while program[length] != 0 {
        if program[length] == 47 { has_slash = true }
        length += 1
    }
    if has_slash {
        _ = std.linux.syscall3(shell.SYS_execve, @intFromPtr(program), @intFromPtr(&arguments), @intFromPtr(environment))
        return
    }
    const path = state.environmentValue(environment, "PATH")
    if @intFromPtr(path) == 0 { return }
    var candidate: [512]u8 = undefined
    var position: usize = 0
    while true {
        var used: usize = 0
        while path[position] != 0 && path[position] != 58 && used < 400 {
            candidate[used] = path[position]
            used += 1
            position += 1
        }
        if used > 0 && used + length + 2 < 512 {
            candidate[used] = 47
            var index: usize = 0
            while index <= length {
                candidate[used + 1 + index] = program[index]
                index += 1
            }
            _ = std.linux.syscall3(shell.SYS_execve, @intFromPtr(&candidate), @intFromPtr(&arguments), @intFromPtr(environment))
        }
        if path[position] == 0 { return }
        position += 1
    }
}

pub fn launch(compositor: *shell.Compositor, program: [*]const u8) -> void {
    if compositor.*.verbose {
        state.say("launch: ")
        var length: usize = 0
        while program[length] != 0 { length += 1 }
        _ = std.io.writeAllBytes(std.io.stdout(), program, length)
        state.say("\n")
    }
    const child = std.linux.syscall0(shell.SYS_fork)
    if child == 0 {
        execute(program, compositor.*.environment)
        _ = std.linux.syscall1(shell.SYS_exit_group, 127)
    }
}

// Sends the launcher that stays one byte (115 's': show); false when it is
// gone (never a SIGPIPE: MSG_NOSIGNAL).
pub fn tellLauncher(compositor: *shell.Compositor, command: u8) -> bool {
    var byte: [1]u8 = [1]u8{ command }
    const sent = std.linux.syscall6(shell.SYS_sendto, @bitCast(usize, compositor.*.launcherChannel), @intFromPtr(&byte), 1, shell.MSG_DONTWAIT | shell.MSG_NOSIGNAL, 0, 0)
    // A full buffer (-EAGAIN) means it is busy, not gone.
    return sent == 1 || sent == -11
}

// The helpers that stay running, started with the compositor: the launcher
// (hidden until Super) and the dock.
pub fn startHelpers(compositor: *shell.Compositor) -> void {
    if compositor.*.greeterMode {
        startGreeter(compositor)
        return
    }
    xwayland_module.start(compositor)
    startLauncher(compositor, false)
    startDock(compositor)
    startTopbar(compositor)
}

// Starts the greeter on a socket pair adopted directly by the Wayland
// server.  Remembering that exact client, rather than trusting an app id or
// whichever client happens to connect first, keeps the public display socket
// from becoming an input path around the login screen.
fn startGreeter(compositor: *shell.Compositor) -> void {
    if compositor.*.greeterPid >= 0 || @intFromPtr(compositor.*.greeterProgram) == 0 { return }
    var wayland: [2]i32 = [2]i32{ -1, -1 }
    if std.linux.syscall4(shell.SYS_socketpair, 1, SOCK_STREAM_CLOEXEC, 0, @intFromPtr(&wayland)) != 0 {
        state.say("greeter: cannot create its Wayland connection\n")
        compositor.*.running = false
        return
    }
    if compositor.*.verbose {
        state.say("greeter: launch: ")
        var length: usize = 0
        while compositor.*.greeterProgram[length] != 0 { length += 1 }
        _ = std.io.writeAllBytes(std.io.stdout(), compositor.*.greeterProgram, length)
        state.say("\n")
    }
    const child = std.linux.syscall0(shell.SYS_fork)
    if child == 0 {
        const ours = @intCast(usize, wayland[0])
        const theirs = @intCast(usize, wayland[1])
        _ = std.linux.syscall1(shell.SYS_close, ours)
        _ = std.linux.syscall3(shell.SYS_fcntl, theirs, shell.F_SETFD, 0)
        execute(compositor.*.greeterProgram, helperEnvironment(compositor, "WAYLAND_SOCKET=", theirs, false))
        _ = std.linux.syscall1(shell.SYS_exit_group, 127)
    }
    _ = std.linux.syscall1(shell.SYS_close, @intCast(usize, wayland[1]))
    if child < 0 {
        _ = std.linux.syscall1(shell.SYS_close, @intCast(usize, wayland[0]))
        state.say("greeter: cannot start\n")
        compositor.*.running = false
        return
    }
    compositor.*.greeterPid = child
    var client: wl.server.Client = undefined
    if !compositor.*.server.adoptClient(wl.Handle.fromDescriptor(@intCast(isize, wayland[0])), &client) {
        _ = std.linux.syscall1(shell.SYS_close, @intCast(usize, wayland[0]))
        _ = std.linux.syscall2(SYS_kill, @bitCast(usize, child), 9)
        state.say("greeter: cannot add its Wayland connection\n")
        compositor.*.running = false
        return
    }
    compositor.*.greeterClient = @intFromPtr(client.state)
}

// Starts the top bar to stay running, with its socket pair as MLX_TOPBAR_FD
// (its end going tells the bar the compositor went).
fn startTopbar(compositor: *shell.Compositor) -> void {
    if !compositor.*.hasTopbar || compositor.*.topbarChannel >= 0 { return }
    var pid: isize = -1
    compositor.*.topbarChannel = startHelper(compositor, compositor.*.topbar, "MLX_TOPBAR_FD=", false, &pid)
    compositor.*.topbarPid = pid
    compositor.*.topbarStartedAt = @intCast(u32, (state.microseconds() / 1000) & 4294967295)
    // The workspaces as they are (the socket keeps it until the bar reads).
    workspaces_module.notifyTopbar(compositor)
}

// Starts the launcher to stay running: with one end of a socket pair as
// MLX_LAUNCHER_FD, on which it hears when to show itself, and
// MLX_LAUNCHER_SHOW=1 when it should show itself once ready.
pub fn startLauncher(compositor: *shell.Compositor, show: bool) -> void {
    if !compositor.*.hasLauncher || compositor.*.launcherChannel >= 0 { return }
    var pid: isize = -1
    compositor.*.launcherChannel = startHelper(compositor, compositor.*.launcher, "MLX_LAUNCHER_FD=", show, &pid)
    compositor.*.launcherPid = pid
}

// Starts the dock to stay running, with its socket pair as MLX_DOCK_FD.
fn startDock(compositor: *shell.Compositor) -> void {
    if !compositor.*.hasDock || compositor.*.dockChannel >= 0 { return }
    var pid: isize = -1
    compositor.*.dockChannel = startHelper(compositor, compositor.*.dock, "MLX_DOCK_FD=", false, &pid)
    compositor.*.dockPid = pid
    compositor.*.dockStartedAt = @intCast(u32, (state.microseconds() / 1000) & 4294967295)
    // The new dock hears the workspaces once it has its windows.
    compositor.*.dockWorkspaceSignature = 0
}

// Starts `program` with one end of a new socket pair as `variable` (e.g.
// "MLX_DOCK_FD=") in its environment; returns our end (nonblocking, not
// inherited by other children), or -1. Its process id goes to `pid`.
fn startHelper(compositor: *shell.Compositor, program: [*]const u8, variable: []const u8, show: bool, pid: *isize) -> isize {
    var descriptors: [2]i32 = [2]i32{ -1, -1 }
    if std.linux.syscall4(shell.SYS_socketpair, 1, 1, 0, @intFromPtr(&descriptors)) != 0 { return -1 }
    const ours = @intCast(usize, descriptors[0])
    const theirs = @intCast(usize, descriptors[1])
    _ = std.linux.syscall3(shell.SYS_fcntl, ours, shell.F_SETFD, shell.FD_CLOEXEC)
    _ = std.linux.syscall3(shell.SYS_fcntl, ours, shell.F_SETFL, shell.O_NONBLOCK)
    if compositor.*.verbose {
        state.say("launch: ")
        var length: usize = 0
        while program[length] != 0 { length += 1 }
        _ = std.io.writeAllBytes(std.io.stdout(), program, length)
        state.say("\n")
    }
    const child = std.linux.syscall0(shell.SYS_fork)
    if child == 0 {
        _ = std.linux.syscall1(shell.SYS_close, ours)
        execute(program, helperEnvironment(compositor, variable, theirs, show))
        _ = std.linux.syscall1(shell.SYS_exit_group, 127)
    }
    _ = std.linux.syscall1(shell.SYS_close, theirs)
    if child < 0 {
        _ = std.linux.syscall1(shell.SYS_close, ours)
        return -1
    }
    pid.* = child
    return @intCast(isize, ours)
}

// Our environment for a helper, with `variable``descriptor` (and
// MLX_LAUNCHER_SHOW=1). Made in the child, just before exec.
fn helperEnvironment(compositor: *shell.Compositor, name: []const u8, descriptor: usize, show: bool) -> [*][*]const u8 {
    var count: usize = 0
    while @intFromPtr(compositor.*.environment[count]) != 0 { count += 1 }
    const result: [*][*]const u8 = unsafe { @ptrCast([*][*]const u8, state.allocate(compositor, (count + 3) * 8)) }
    var index: usize = 0
    while index < count {
        result[index] = compositor.*.environment[index]
        index += 1
    }
    const variable = state.allocate(compositor, 48)
    var length: usize = 0
    for byte in name {
        variable[length] = byte
        length += 1
    }
    var digits: [20]u8 = undefined
    var digit_count: usize = 0
    var rest = descriptor
    while rest > 0 || digit_count == 0 {
        digits[digit_count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        digit_count += 1
    }
    while digit_count > 0 {
        digit_count -= 1
        variable[length] = digits[digit_count]
        length += 1
    }
    variable[length] = 0
    unsafe { result[count] = @ptrCast([*]const u8, variable) }
    count += 1
    if show {
        unsafe { result[count] = @ptrCast([*]const u8, "MLX_LAUNCHER_SHOW=1") }
        count += 1
    }
    unsafe { result[count] = @ptrFromInt([*]const u8, 0) }
    return result
}

fn closeChannel(channel: isize) -> void {
    if channel >= 0 { _ = std.linux.syscall1(shell.SYS_close, @bitCast(usize, channel)) }
}

// What the dock sent: 108 'l' is its apps button (the launcher shows,
// unless that same click just closed it: then it stays closed, a toggle);
// 112 'p', a count and that many u32 object ids (the dock's
// zwlr_foreign_toplevel_handle_v1 objects) shows those windows' previews
// (the same toggle); 104 'h', a count, the ids and an i32 (the icon's
// middle on the dock): the pointer rests on an app's icon, its previews
// show over it (none: they go; ignored while previews a click opened
// show); 122 'z': the next window opens out of the dock's
// popup (a folder from its stack); 90 'Z' and four i32 (x, y, width,
// height on the dock): out of that rectangle (an icon). The end of the
// channel is the dock going (reapChildren starts it again).
pub fn helperMessages(compositor: *shell.Compositor) -> void {
    // The X window manager's connection (it reads without waiting).
    xwm_module.dispatch(compositor)
    topbarMessages(compositor)
    if compositor.*.dockChannel < 0 { return }
    var bytes: [64]u8 = undefined
    const count = std.linux.syscall3(0, @bitCast(usize, compositor.*.dockChannel), @intFromPtr(&bytes), 64)
    if count == 0 || (count < 0 && count != -11) {
        closeChannel(compositor.*.dockChannel)
        compositor.*.dockChannel = -1
        return
    }
    var index: usize = 0
    const length = if count > 0 { @intCast(usize, count) } else { 0 }
    while index < length {
        const kind = bytes[index]
        if kind == 108 {
            const just_closed = compositor.*.launcherClosedAt != 0 && compositor.*.time -% compositor.*.launcherClosedAt < 400
            if !just_closed && protocols_module.launcherSurface(compositor) == 0 { protocols_module.toggleLauncher(compositor) }
            index += 1
        } else if kind == 122 {
            zoomFromPopup(compositor)
            index += 1
        } else if kind == 90 && index + 17 <= length {
            var values: [4]i32 = [4]i32{ 0, 0, 0, 0 }
            var value: usize = 0
            while value < 4 {
                const at = index + 1 + value * 4
                values[value] = @bitCast(i32, @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) | (@intCast(u32, bytes[at + 2]) << 16) | (@intCast(u32, bytes[at + 3]) << 24))
                value += 1
            }
            zoomFromDock(compositor, values[0], values[1], values[2], values[3])
            index += 17
        } else if (kind == 112 || kind == 104) && index + 1 < length {
            const wanted = @intCast(usize, bytes[index + 1])
            index += 2
            var ids: [8]u32 = [8]u32{ 0, 0, 0, 0, 0, 0, 0, 0 }
            var taken: usize = 0
            while taken < wanted && index + 4 <= length {
                const id = readU32(&bytes, index)
                if taken < 8 { ids[taken] = id }
                taken += 1
                index += 4
            }
            const kept = if taken < 8 { taken } else { 8 }
            if kind == 104 {
                var anchor: i32 = -1
                if index + 4 <= length {
                    anchor = @bitCast(i32, readU32(&bytes, index))
                    index += 4
                }
                hoverPreviews(compositor, &ids, kept, anchor)
            } else {
                const just_closed = compositor.*.previewClosedAt != 0 && compositor.*.time -% compositor.*.previewClosedAt < 400
                if compositor.*.previewCount > 0 {
                    hidePreviews(compositor)
                } else if !just_closed {
                    compositor.*.previewFromHover = false
                    compositor.*.previewAnchorX = -1
                    showPreviews(compositor, &ids, kept)
                }
            }
        } else {
            index += 1
        }
    }
}

fn readU32(bytes: *[64]u8, at: usize) -> u32 {
    return @intCast(u32, bytes.*[at]) | (@intCast(u32, bytes.*[at + 1]) << 8) | (@intCast(u32, bytes.*[at + 2]) << 16) | (@intCast(u32, bytes.*[at + 3]) << 24)
}

// What the top bar sent (workspaces.mlx says what): a workspace to show, a
// workspace's tiling to turn on or off. The end of the channel is the bar
// going (reapChildren starts it again).
fn topbarMessages(compositor: *shell.Compositor) -> void {
    if compositor.*.topbarChannel < 0 { return }
    var bytes: [64]u8 = undefined
    const count = std.linux.syscall3(0, @bitCast(usize, compositor.*.topbarChannel), @intFromPtr(&bytes), 64)
    if count == 0 || (count < 0 && count != -11) {
        closeChannel(compositor.*.topbarChannel)
        compositor.*.topbarChannel = -1
        return
    }
    if count < 0 { return }
    const pointer: [*]const u8 = &bytes
    workspaces_module.topbarMessages(compositor, pointer, @intCast(usize, count))
}

// ---------------------------------------------------------------------------
// Windows opening out of the dock (scene.zoomRect draws them): the dock
// says a window is coming (a folder opened from its stack, the trash);
// the next toplevel to map within three seconds grows out of the stack,
// or the icon, to where it goes, and the stack goes as it comes.

const ZOOM_WAIT: usize = 3000000

fn expectZoom(compositor: *shell.Compositor, rect: ui.Rect, popup: bool) -> void {
    if rect.width <= 0 || rect.height <= 0 { return }
    compositor.*.zoomX = rect.x
    compositor.*.zoomY = rect.y
    compositor.*.zoomWidth = rect.width
    compositor.*.zoomHeight = rect.height
    compositor.*.zoomFromPopup = popup
    compositor.*.zoomUntil = state.microseconds() + ZOOM_WAIT
}

// The dock's popup that shows (0: none).
fn dockPopup(compositor: *shell.Compositor) -> usize {
    const dock = dockSurface(compositor)
    if dock == 0 { return 0 }
    var index: usize = 0
    while index < compositor.*.stack.length {
        const address = state.listAt(compositor.*.stack, index)
        const surface = state.surfaceAt(address)
        if surface.*.role == state.ROLE_POPUP && surface.*.hasPopup && !surface.*.dismissed && protocols_module.rootAddress(address) == dock { return address }
        index += 1
    }
    return 0
}

fn zoomFromPopup(compositor: *shell.Compositor) -> void {
    const popup = dockPopup(compositor)
    if popup == 0 { return }
    expectZoom(compositor, scene.restBounds(state.surfaceAt(popup)), true)
}

fn zoomFromDock(compositor: *shell.Compositor, x: i32, y: i32, width: i32, height: i32) -> void {
    const dock = dockSurface(compositor)
    if dock == 0 { return }
    const origin = scene.restBounds(state.surfaceAt(dock))
    expectZoom(compositor, ui.rect(origin.x + x, origin.y + y, width, height), false)
}

// A toplevel mapped: when the dock said one is coming, it grows out of
// the rectangle, and the dock's stack goes (not drawn from now on; the
// dock is told to close it).
pub fn startZoom(compositor: *shell.Compositor, surface: *shell.Surface) -> void {
    if compositor.*.zoomUntil == 0 { return }
    const now = state.microseconds()
    const fresh = now < compositor.*.zoomUntil
    compositor.*.zoomUntil = 0
    if !fresh || !compositor.*.animations { return }
    surface.*.zooming = true
    surface.*.zoomX = compositor.*.zoomX
    surface.*.zoomY = compositor.*.zoomY
    surface.*.zoomWidth = compositor.*.zoomWidth
    surface.*.zoomHeight = compositor.*.zoomHeight
    surface.*.zoomStart = now
    if compositor.*.zoomFromPopup {
        const popup = dockPopup(compositor)
        if popup != 0 {
            const stack = state.surfaceAt(popup)
            scene.damageSurface(compositor, stack)
            stack.*.dismissed = true
            wl.xdg_popup.Resource.fromObject(stack.*.popup).sendPopupDone()
        }
    }
    if compositor.*.verbose {
        state.say("zoom: from ")
        state.sayInteger(surface.*.zoomWidth)
        state.say("x")
        state.sayInteger(surface.*.zoomHeight)
        state.say(" at ")
        state.sayInteger(surface.*.zoomX)
        state.say(",")
        state.sayInteger(surface.*.zoomY)
        state.say("\n")
    }
}

// After each frame: opening windows grow on (their bounds damaged, so
// frames keep coming) until they rest.
pub fn zoomStep(compositor: *shell.Compositor) -> void {
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        index += 1
        if !surface.*.zooming { continue }
        scene.damageSurface(compositor, surface)
        if state.microseconds() - surface.*.zoomStart >= scene.ZOOM_MICROS * compositor.*.animationScale {
            surface.*.zooming = false
            scene.damageSurface(compositor, surface)
        }
    }
}

// Tells the dock which workspace each of its windows is on, which the
// foreign-toplevel protocol does not carry: 119 'w', 1 when it groups its
// running apps by workspace (dock-workspaces) else 0, the workspace shown,
// a count and that many u32 object ids (its
// zwlr_foreign_toplevel_handle_v1 objects) each with a u8 workspace. Sent
// when any of it changed; every turn of the loop looks (reapChildren).
const DOCK_WORKSPACES: u8 = 119
const DOCK_WINDOWS: usize = 64

fn notifyDock(compositor: *shell.Compositor) -> void {
    if compositor.*.dockChannel < 0 { return }
    const dock = dockSurface(compositor)
    if dock == 0 { return }
    const dock_surface = state.surfaceAt(dock)
    var message: [324]u8 = undefined
    message[0] = DOCK_WORKSPACES
    message[1] = if compositor.*.dockWorkspaces { 1 } else { 0 }
    message[2] = @intCast(u8, compositor.*.workspace)
    var signature: usize = 5381 +% @intCast(usize, message[1]) *% 31 +% compositor.*.workspace *% 977
    var count: usize = 0
    var index: usize = 0
    while index < compositor.*.toplevelHandles.length && count < DOCK_WINDOWS {
        const handle = protocols_module.handleAt(state.listAt(compositor.*.toplevelHandles, index))
        if !handle.*.closed && handle.*.surface != 0 && state.sameClient(handle.*.object, dock_surface.*.resource) {
            const id = handle.*.object.id
            const workspace = state.surfaceAt(handle.*.surface).*.workspace
            const at = 4 + count * 5
            message[at] = @intCast(u8, id & 255)
            message[at + 1] = @intCast(u8, (id >> 8) & 255)
            message[at + 2] = @intCast(u8, (id >> 16) & 255)
            message[at + 3] = @intCast(u8, id >> 24)
            message[at + 4] = @intCast(u8, workspace)
            signature = signature *% 1099511628211 +% @intCast(usize, id) *% 16 +% workspace
            count += 1
        }
        index += 1
    }
    message[3] = @intCast(u8, count)
    signature = (signature *% 31 +% count) | 1
    if signature == compositor.*.dockWorkspaceSignature { return }
    // sendto with MSG_DONTWAIT | MSG_NOSIGNAL: a dock that does not read
    // gets it on a later turn.
    const sent = std.linux.syscall6(44, @bitCast(usize, compositor.*.dockChannel), @intFromPtr(&message), 4 + count * 5, 64 | 16384, 0, 0)
    if sent > 0 { compositor.*.dockWorkspaceSignature = signature }
}

// ---------------------------------------------------------------------------
// Window previews (scene.mlx draws them): the dock asks for an app's
// windows; a click on one brings it forward, anywhere else (or Escape)
// closes them.

// The surface a handle of the dock's client with object id `id` stands for
// (0: none).
fn dockWindow(compositor: *shell.Compositor, id: u32) -> usize {
    const dock = dockSurface(compositor)
    if dock == 0 { return 0 }
    const dock_surface = state.surfaceAt(dock)
    var index: usize = 0
    while index < compositor.*.toplevelHandles.length {
        const handle = protocols_module.handleAt(state.listAt(compositor.*.toplevelHandles, index))
        if !handle.*.closed && handle.*.surface != 0 && handle.*.object.id == id && state.sameClient(handle.*.object, dock_surface.*.resource) { return handle.*.surface }
        index += 1
    }
    return 0
}

fn showPreviews(compositor: *shell.Compositor, ids: [*]const u32, count: usize) -> void {
    var shown: usize = 0
    var index: usize = 0
    while index < count {
        const address = dockWindow(compositor, ids[index])
        if address != 0 && state.surfaceAt(address).*.mapped {
            compositor.*.previewWindows[shown] = address
            shown += 1
        }
        index += 1
    }
    if shown == 0 { return }
    compositor.*.previewCount = shown
    compositor.*.previewHover = if compositor.*.pointerInside { preview_layout.previewAt(compositor, compositor.*.pointerX, compositor.*.pointerY) } else { preview_layout.PREVIEW_MAX }
    scene.damagePreviews(compositor)
    if compositor.*.verbose {
        const panel = preview_layout.previewPanel(compositor)
        state.say("previews: ")
        state.sayNumber(shown)
        state.say(" windows, panel ")
        state.sayInteger(panel.width)
        state.say("x")
        state.sayInteger(panel.height)
        state.say(" at ")
        state.sayInteger(panel.x)
        state.say(",")
        state.sayInteger(panel.y)
        state.say("\n")
    }
}

// The dock's 'h': the previews of the app whose icon the pointer rests on
// (`anchor`: the icon's middle on the dock), shown over the icon in
// place of the ones there; none: they go. Previews a click opened stay.
fn hoverPreviews(compositor: *shell.Compositor, ids: [*]const u32, count: usize, anchor: i32) -> void {
    if compositor.*.previewCount > 0 && !compositor.*.previewFromHover { return }
    if count == 0 {
        hidePreviews(compositor)
        return
    }
    if compositor.*.previewCount > 0 { scene.damagePreviews(compositor) }
    compositor.*.previewCount = 0
    const dock = dockSurface(compositor)
    compositor.*.previewFromHover = true
    compositor.*.previewAnchorX = if dock != 0 && anchor >= 0 { state.surfaceAt(dock).*.x + anchor } else { -1 }
    showPreviews(compositor, ids, count)
    if compositor.*.previewCount == 0 { compositor.*.previewFromHover = false }
}

// Hover previews go when the pointer is neither on them, on the dock's bar
// nor in between.
pub fn leaveHoverPreviews(compositor: *shell.Compositor, x: i32, y: i32) -> void {
    if compositor.*.previewCount == 0 || !compositor.*.previewFromHover { return }
    const panel = preview_layout.previewPanel(compositor)
    var left = panel.x
    var right = panel.x + panel.width
    const top = panel.y
    var bottom = panel.y + panel.height
    const dock = dockSurface(compositor)
    if dock != 0 {
        const surface = state.surfaceAt(dock)
        const bar = dockArea(compositor, surface)
        if bar.x < left { left = bar.x }
        if bar.x + bar.width > right { right = bar.x + bar.width }
        if bar.y + bar.height > bottom { bottom = bar.y + bar.height }
    }
    if x >= left && x < right && y >= top && y < bottom { return }
    hidePreviews(compositor)
}

pub fn hidePreviews(compositor: *shell.Compositor) -> void {
    if compositor.*.previewCount == 0 { return }
    scene.damagePreviews(compositor)
    compositor.*.previewFromHover = false
    compositor.*.previewCount = 0
    compositor.*.previewHover = preview_layout.PREVIEW_MAX
    compositor.*.previewClosedAt = compositor.*.time
    if compositor.*.previewClosedAt == 0 { compositor.*.previewClosedAt = 1 }
    if compositor.*.verbose { state.say("previews closed\n") }
}

// A window went: out of the previews (which close when none is left).
pub fn dropPreview(compositor: *shell.Compositor, address: usize) -> void {
    var index: usize = 0
    while index < compositor.*.previewCount {
        if compositor.*.previewWindows[index] == address {
            scene.damagePreviews(compositor)
            var rest = index
            while rest + 1 < compositor.*.previewCount {
                compositor.*.previewWindows[rest] = compositor.*.previewWindows[rest + 1]
                rest += 1
            }
            compositor.*.previewCount -= 1
            compositor.*.previewHover = preview_layout.PREVIEW_MAX
            if compositor.*.previewCount == 0 { compositor.*.previewClosedAt = compositor.*.time }
            scene.damagePreviews(compositor)
            return
        }
        index += 1
    }
}

// Whether (x, y) is on the panel.
pub fn onPreviews(compositor: *const shell.Compositor, x: i32, y: i32) -> bool {
    if compositor.*.previewCount == 0 { return false }
    const panel = preview_layout.previewPanel(compositor)
    return x >= panel.x && y >= panel.y && x < panel.x + panel.width && y < panel.y + panel.height
}

// ---------------------------------------------------------------------------
// The dock hiding (dock-autohide): it slides below the bottom edge when the
// pointer has been away from it for DOCK_LINGER milliseconds, and back up
// when the pointer touches the bottom edge. It stays while its previews
// show, a menu or folder stack of its own is open, or a button is held. Smart (dock-autohide = smart), it only goes
// while a window is where it shows, and comes back by itself once none
// is.

const DOCK_LINGER: u32 = 600
// Pixels a millisecond.
const DOCK_SPEED: i32 = 1

pub fn isDock(surface: *const shell.Surface) -> bool {
    return surface.*.role == state.ROLE_LAYER && surface.*.hasLayerSurface && !surface.*.layerClosed && protocols_module.titleIs(surface, "mlx-dock")
}

// The dock's surface (0: none).
fn dockSurface(compositor: *shell.Compositor) -> usize {
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const address = state.listAt(compositor.*.surfaces, index)
        if isDock(state.surfaceAt(address)) { return address }
        index += 1
    }
    return 0
}

pub fn revealDock(compositor: *shell.Compositor) -> void {
    compositor.*.dockWanted = true
    compositor.*.dockLeftAt = 0
    const dock = dockSurface(compositor)
    if dock != 0 { scene.damageSurface(compositor, state.surfaceAt(dock)) }
}

// Where the dock shows when it is up: the bar (the part that takes the
// pointer: its input region) of the surface, as if it had not moved down.
fn dockArea(compositor: *shell.Compositor, dock: *const shell.Surface) -> ui.Rect {
    const height = @intCast(i32, dock.*.pixelHeight)
    const down = if compositor.*.dockOffset < height + dock.*.marginBottom { compositor.*.dockOffset } else { height + dock.*.marginBottom }
    var left: i32 = 0
    var top: i32 = 0
    var right = @intCast(i32, dock.*.pixelWidth)
    var bottom = height
    if dock.*.hasInputRegion && dock.*.inputCount > 0 {
        left = right
        top = bottom
        right = 0
        bottom = 0
        var index: usize = 0
        while index < dock.*.inputCount {
            const op = dock.*.inputOps[index]
            if !op.subtract {
                if op.x < left { left = op.x }
                if op.y < top { top = op.y }
                if op.x + op.width > right { right = op.x + op.width }
                if op.y + op.height > bottom { bottom = op.y + op.height }
            }
            index += 1
        }
        if right <= left || bottom <= top { return ui.rect(dock.*.x, dock.*.y - down, @intCast(i32, dock.*.pixelWidth), height) }
    }
    return ui.rect(dock.*.x + left, dock.*.y - down + top, right - left, bottom - top)
}

// Whether a window of the workspace shown (its frame and title bar) is
// where the dock shows.
fn dockCovered(compositor: *shell.Compositor, dock: *const shell.Surface) -> bool {
    const area = dockArea(compositor, dock)
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const address = state.listAt(compositor.*.surfaces, index)
        const surface = state.surfaceAt(address)
        if windows_module.isWindow(surface) && surface.*.mapped && !scene.hidden(address) {
            const x = scene.titleX(surface)
            const y = scene.titleY(surface)
            const width = scene.titleWidth(surface)
            const height = scene.windowHeight(surface) + scene.titleHeight(surface) + scene.frameWidth(surface) * 2
            if x < area.x + area.width && x + width > area.x && y < area.y + area.height && y + height > area.y { return true }
        }
        index += 1
    }
    return false
}

// Whether a popup of the dock's (its menu, a folder's stack) is open.
fn dockHasPopup(compositor: *shell.Compositor, dock: usize) -> bool {
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        if surface.*.role == state.ROLE_POPUP && surface.*.mapped {
            // A popup of a popup of the dock counts too.
            var parent = surface.*.parent
            var depth: usize = 0
            while parent != 0 && parent != dock && depth < 8 {
                parent = state.surfaceAt(parent).*.parent
                depth += 1
            }
            if parent == dock { return true }
        }
        index += 1
    }
    return false
}

// Each frame: whether the dock should show, and a step towards that.
pub fn dockStep(compositor: *shell.Compositor, time: u32) -> void {
    const elapsed = time -% compositor.*.dockTime
    compositor.*.dockTime = time
    const address = dockSurface(compositor)
    if address == 0 { return }
    const dock = state.surfaceAt(address)
    if !dock.*.mapped { return }
    var target: i32 = 0
    if compositor.*.dockAutohide {
        const hovered = compositor.*.pointerInside && compositor.*.pointerFocus == address
        const at_edge = compositor.*.pointerInside && compositor.*.pointerY >= @intCast(i32, compositor.*.height) - 2
        // Smart: with nothing in its way it comes back and stays.
        const clear = compositor.*.dockSmartHide && !dockCovered(compositor, dock)
        if hovered || at_edge || compositor.*.previewCount > 0 || compositor.*.buttonsDown > 0 || dockHasPopup(compositor, address) {
            compositor.*.dockLeftAt = 0
            // The bottom edge brings it back, also under a drag (which has
            // the pointer: no motion reaches windows.mlx then).
            if at_edge && !compositor.*.dockWanted { revealDock(compositor) }
        } else if clear {
            compositor.*.dockLeftAt = 0
            if !compositor.*.dockWanted {
                compositor.*.dockWanted = true
                if compositor.*.verbose { state.say("dock: nothing in its way\n") }
            }
        } else if compositor.*.dockWanted {
            if compositor.*.dockLeftAt == 0 {
                compositor.*.dockLeftAt = if time == 0 { 1 } else { time }
            } else if time -% compositor.*.dockLeftAt >= DOCK_LINGER {
                compositor.*.dockWanted = false
                compositor.*.dockLeftAt = 0
                if compositor.*.verbose { state.say("dock: hidden\n") }
            }
            // Frames keep coming while it waits.
            scene.damageSurface(compositor, dock)
        }
        if !compositor.*.dockWanted { target = @intCast(i32, dock.*.pixelHeight) + dock.*.marginBottom }
    }
    if compositor.*.dockOffset == target { return }
    var step = @intCast(i32, if elapsed > 50 { 50 } else { elapsed }) * DOCK_SPEED
    if step < 1 { step = 1 }
    scene.damageSurface(compositor, dock)
    if compositor.*.dockOffset < target {
        compositor.*.dockOffset = if compositor.*.dockOffset + step > target { target } else { compositor.*.dockOffset + step }
    } else {
        compositor.*.dockOffset = if compositor.*.dockOffset - step < target { target } else { compositor.*.dockOffset - step }
    }
    protocols_module.placeLayer(dock)
    scene.damageSurface(compositor, dock)
    // A drag over where the dock slid: it may be over the dock now.
    if compositor.*.dragging { data_module.dragMotion(compositor) }
    if compositor.*.verbose && compositor.*.dockOffset == 0 && target == 0 { state.say("dock: shown\n") }
}

// Pointer motion to (x, y) while they show: the thumbnail under it is
// highlighted; ones the dock showed for an icon go once it has left the
// dock and them.
pub fn previewMotion(compositor: *shell.Compositor, x: i32, y: i32) -> void {
    const hover = preview_layout.previewAt(compositor, compositor.*.pointerX, compositor.*.pointerY)
    if hover != compositor.*.previewHover {
        compositor.*.previewHover = hover
        scene.damagePreviews(compositor)
    }
    leaveHoverPreviews(compositor, x, y)
}

// A window's content changed: its thumbnail too.
pub fn previewContentChanged(compositor: *shell.Compositor, address: usize) -> void {
    var index: usize = 0
    while index < compositor.*.previewCount {
        if compositor.*.previewWindows[index] == address {
            scene.damagePreviews(compositor)
            return
        }
        index += 1
    }
}

// Collects exited children; a helper that ended is started again (the
// launcher on the next Super; the dock at once, three times at most when
// it keeps ending within five seconds).
pub fn reapChildren(compositor: *shell.Compositor) -> void {
    // (Every turn of the loop: a log out under way ends here, and the dock
    // hears where its windows went.)
    lock_module.checkLogOut(compositor)
    notifyDock(compositor)
    var status: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    while true {
        const pid = std.linux.syscall4(shell.SYS_wait4, 18446744073709551615, @intFromPtr(&status), 1, 0)
        if pid <= 0 { return }
        xwayland_module.reaped(compositor, pid)
        if pid == compositor.*.greeterPid {
            compositor.*.greeterPid = -1
            compositor.*.greeterClient = 0
            compositor.*.running = false
            if compositor.*.verbose { state.say("greeter: it ended; stopping the greeter compositor\n") }
        }
        if pid == compositor.*.launcherPid {
            compositor.*.launcherPid = -1
            closeChannel(compositor.*.launcherChannel)
            compositor.*.launcherChannel = -1
        }
        if pid == compositor.*.dockPid {
            compositor.*.dockPid = -1
            closeChannel(compositor.*.dockChannel)
            compositor.*.dockChannel = -1
            const now = @intCast(u32, (state.microseconds() / 1000) & 4294967295)
            const quickly = now -% compositor.*.dockStartedAt < 5000
            compositor.*.dockFailures = if quickly { compositor.*.dockFailures + 1 } else { 0 }
            if compositor.*.dockFailures < 3 {
                state.say("dock: it ended; starting it again\n")
                startDock(compositor)
            } else {
                state.say("dock: it keeps ending; not started again\n")
            }
        }
        if pid == compositor.*.topbarPid {
            compositor.*.topbarPid = -1
            closeChannel(compositor.*.topbarChannel)
            compositor.*.topbarChannel = -1
            const now = @intCast(u32, (state.microseconds() / 1000) & 4294967295)
            const quickly = now -% compositor.*.topbarStartedAt < 5000
            compositor.*.topbarFailures = if quickly { compositor.*.topbarFailures + 1 } else { 0 }
            if compositor.*.topbarFailures < 3 {
                state.say("topbar: it ended; starting it again\n")
                startTopbar(compositor)
            } else {
                state.say("topbar: it keeps ending; not started again\n")
            }
        }
    }
}
