// Windows: focus, states (maximized, fullscreen, minimized, snapped to an
// edge), resizing, input from the host, the hotkeys, mapping (part of
// shell.mlx, split from it); workspaces.mlx and tiling.mlx hang off it.
const wl = @import("std.wayland")
const ui = @import("std.ui")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const data = @import("./data.mlx")
const constraints = @import("./pointer.mlx")
const wobble = @import("./wobble.mlx")
const keys = @import("../shared/keys.mlx")
const shell = @import("./shell.mlx")
const protocols_module = @import("./protocols.mlx")
const launching_module = @import("./launching.mlx")
const capture_module = @import("./capture.mlx")
const xwm_module = @import("./xwm.mlx")
const workspaces_module = @import("./workspaces.mlx")
const tiling_module = @import("./tiling.mlx")

// ---------------------------------------------------------------------------
// Focus and xdg configuration

// Sends the toplevel its size (configuredWidth x configuredHeight; 0 x 0
// lets the client choose) and states: resizing (3) during a resize,
// activated (4) with keyboard focus. Until the client acks it and commits,
// resizing asks for no further size.
pub fn configureToplevel(surface: *shell.Surface) -> void {
    // An X window hears it from the window manager.
    if surface.*.xwindow != 0 {
        xwm_module.configure(surface)
        return
    }
    if !surface.*.hasToplevel || !surface.*.hasXdgSurface { return }
    const compositor = surface.*.compositor
    var states: [32]u8 = undefined
    var index: usize = 0
    while index < 32 {
        states[index] = 0
        index += 1
    }
    var count: usize = 0
    if surface.*.resizing {
        states[0] = 3
        count = 1
    }
    if compositor.*.keyboardFocus == state.addressOfSurface(surface) {
        states[count * 4] = 4
        count += 1
    }
    // maximized (1), fullscreen (2).
    if surface.*.maximized {
        states[count * 4] = 1
        count += 1
    }
    if surface.*.fullscreen {
        states[count * 4] = 2
        count += 1
    }
    // Decorated by the compositor: tiled on every edge (tiled_left, right,
    // top, bottom; xdg_toplevel v2+), as tiling compositors such as niri
    // say. Clients then leave out what only a floating window of their own
    // needs: shadows, rounded corners, resize margins, and Firefox (Zen)
    // the space of its own title bar.
    surface.*.tiledSent = protocols_module.compositorDecorates(surface) && wl.server.objectVersion(surface.*.toplevel) >= 2
    if surface.*.tiledSent {
        var tiled: u8 = 5
        while tiled <= 8 {
            states[count * 4] = tiled
            count += 1
            tiled += 1
        }
    }
    var array = shell.emptyArray()
    if count > 0 {
        unsafe { array = wl.ArrayView.{ .pointer = @ptrCast([*]const u8, &states), .length = count * 4 } }
    }
    const toplevel = wl.xdg_toplevel.Resource.fromObject(surface.*.toplevel)
    // The most a window can use: the output without the title bar and the
    // frame (xdg_toplevel v4+; GTK sizes new windows to fit).
    toplevel.sendConfigureBounds(@intCast(i32, compositor.*.width) - compositor.*.reserveLeft - compositor.*.reserveRight - 4, @intCast(i32, compositor.*.height) - compositor.*.reserveTop - compositor.*.reserveBottom - (if compositor.*.titleBars { scene.TITLE_HEIGHT } else { 0 }) - 4)
    toplevel.sendConfigure(surface.*.configuredWidth, surface.*.configuredHeight, array)
    if surface.*.hasDecoration {
        surface.*.decorationSent = protocols_module.decorationMode(surface)
        wl.zxdg_toplevel_decoration_v1.Resource.fromObject(surface.*.decoration).sendConfigure(surface.*.decorationSent)
    }
    const serial = compositor.*.server.nextSerial()
    surface.*.configureSerial = serial
    surface.*.configurePending = true
    wl.xdg_surface.Resource.fromObject(surface.*.xdgSurface).sendConfigure(serial)
}

// ---------------------------------------------------------------------------
// Window states: maximized, fullscreen, minimized

// Where a maximized or fullscreen window's content (its window geometry)
// goes: the whole output, or the work area inside the frame and title bar.
pub fn stateRect(surface: *const shell.Surface) -> ui.Rect {
    const compositor = surface.*.compositor
    if surface.*.fullscreen { return scene.outputRect(compositor) }
    const area = scene.workArea(compositor)
    const title = scene.titleHeight(surface)
    return ui.rect(area.x + 2, area.y + 2 + title, area.width - 4, area.height - 4 - title)
}

// Keeps the window rectangle to go back to (once: going from maximized to
// fullscreen keeps the first).
fn saveRestore(surface: *shell.Surface) -> void {
    if surface.*.maximized || surface.*.fullscreen { return }
    surface.*.hasRestore = true
    surface.*.restoreX = scene.windowX(surface)
    surface.*.restoreY = scene.windowY(surface)
    surface.*.restoreWidth = scene.windowWidth(surface)
    surface.*.restoreHeight = scene.windowHeight(surface)
}

pub fn moveWindowTo(surface: *shell.Surface, x: i32, y: i32) -> void {
    const offset_x = if surface.*.hasGeometry { surface.*.geometryX } else { 0 }
    const offset_y = if surface.*.hasGeometry { surface.*.geometryY } else { 0 }
    if surface.*.x == x - offset_x && surface.*.y == y - offset_y { return }
    scene.damageSurface(surface.*.compositor, surface)
    surface.*.x = x - offset_x
    surface.*.y = y - offset_y
    scene.damageSurface(surface.*.compositor, surface)
}

// Holds a maximized or fullscreen window where its state puts it (on every
// commit: its geometry may change with its size).
pub fn pinState(surface: *shell.Surface) -> void {
    if !surface.*.maximized && !surface.*.fullscreen { return }
    const target = stateRect(surface)
    moveWindowTo(surface, target.x, target.y)
}

// After a state changed: the size and place it means, a configure, the
// stacking (fullscreen goes above panels) and the dock's view.
fn applyState(surface: *shell.Surface) -> void {
    const compositor = surface.*.compositor
    scene.damageSurface(compositor, surface)
    if surface.*.maximized || surface.*.fullscreen {
        const target = stateRect(surface)
        surface.*.configuredWidth = target.width
        surface.*.configuredHeight = target.height
        pinState(surface)
    } else if surface.*.hasRestore {
        surface.*.configuredWidth = surface.*.restoreWidth
        surface.*.configuredHeight = surface.*.restoreHeight
        moveWindowTo(surface, surface.*.restoreX, surface.*.restoreY)
        surface.*.hasRestore = false
    }
    scene.restack(compositor)
    configureToplevel(surface)
    protocols_module.toplevelChanged(surface)
    scene.damageSurface(compositor, surface)
    if compositor.*.verbose {
        state.say(if surface.*.fullscreen { "fullscreen: " } else if surface.*.maximized { "maximize: " } else { "restore: " })
        state.sayTitle(surface)
        state.say("\n")
    }
    // A column that is no longer fullscreen takes its place again.
    if surface.*.tiled && !surface.*.fullscreen { tiling_module.layout(compositor, surface.*.workspace) }
}

// A window: an xdg toplevel, or an X window of Xwayland's.
pub fn isWindow(surface: *const shell.Surface) -> bool { return surface.*.hasToplevel || (surface.*.xwindow != 0 && surface.*.role == state.ROLE_TOPLEVEL) }

// Asks the window to close (xdg: close; X: WM_DELETE_WINDOW).
pub fn closeWindow(surface: *shell.Surface) -> void {
    if surface.*.hasToplevel {
        wl.xdg_toplevel.Resource.fromObject(surface.*.toplevel).sendClose()
    } else if surface.*.xwindow != 0 {
        xwm_module.close(surface)
    }
}

pub fn setMaximized(surface: *shell.Surface, on: bool) -> void {
    if !isWindow(surface) || surface.*.maximized == on { return }
    // A column is never maximized: it takes the strip's whole width instead.
    if surface.*.tiled {
        if on { tiling_module.toggleFull(surface.*.compositor, surface) }
        return
    }
    surface.*.snapped = state.SNAP_NONE
    if on { saveRestore(surface) }
    // What it covers now, before the state changes the decoration.
    scene.damageSurface(surface.*.compositor, surface)
    surface.*.maximized = on
    applyState(surface)
}

pub fn setFullscreen(surface: *shell.Surface, on: bool) -> void {
    if !isWindow(surface) || surface.*.fullscreen == on { return }
    if on { saveRestore(surface) }
    scene.damageSurface(surface.*.compositor, surface)
    surface.*.fullscreen = on
    applyState(surface)
}

// Minimized: hidden, without the pointer or the keyboard, until focused
// again (the dock, a hotkey).
pub fn setMinimized(surface: *shell.Surface, on: bool) -> void {
    if !isWindow(surface) || surface.*.minimized == on { return }
    const compositor = surface.*.compositor
    const address = state.addressOfSurface(surface)
    if !on {
        focus(compositor, address)
        return
    }
    scene.damageSurface(compositor, surface)
    surface.*.minimized = true
    // A minimized column leaves the strip (focusing it brings it back).
    tiling_module.remove(compositor, surface)
    if compositor.*.moving == address {
        wobble.release(surface)
        compositor.*.moving = 0
    }
    if compositor.*.resizing == address { compositor.*.resizing = 0 }
    if compositor.*.pointerFocus != 0 && scene.toplevelOf(compositor.*.pointerFocus) == address { updatePointerFocus(compositor, 0) }
    if compositor.*.keyboardFocus == address {
        compositor.*.keyboardFocus = 0
        focus(compositor, topmostToplevel(compositor))
    }
    protocols_module.toplevelChanged(surface)
    if compositor.*.verbose {
        state.say("minimize: ")
        state.sayTitle(surface)
        state.say("\n")
    }
}

// ---------------------------------------------------------------------------
// Resizing

fn clampSize(value: i32, minimum: i32, maximum: i32) -> i32 {
    var result = value
    if maximum > 0 && result > maximum { result = maximum }
    if result < minimum { result = minimum }
    return result
}

// Asks the toplevel for a new window size, within its limits; with a
// configure still pending, the size waits for the client's next commit.
fn requestSize(surface: *shell.Surface, width: i32, height: i32) -> void {
    const min_width = if surface.*.minWidth > shell.MIN_WIDTH { surface.*.minWidth } else { shell.MIN_WIDTH }
    const min_height = if surface.*.minHeight > shell.MIN_HEIGHT { surface.*.minHeight } else { shell.MIN_HEIGHT }
    surface.*.wantedWidth = clampSize(width, min_width, surface.*.maxWidth)
    surface.*.wantedHeight = clampSize(height, min_height, surface.*.maxHeight)
    if surface.*.configurePending { return }
    if surface.*.wantedWidth == surface.*.configuredWidth && surface.*.wantedHeight == surface.*.configuredHeight { return }
    surface.*.configuredWidth = surface.*.wantedWidth
    surface.*.configuredHeight = surface.*.wantedHeight
    configureToplevel(surface)
}

// Starts resizing the toplevel of `address` by its `edges` (scene.EDGE_*)
// as the pointer moves, until the buttons are released.
pub fn startResize(compositor: *shell.Compositor, address: usize, edges: u32) -> void {
    const toplevel = scene.toplevelOf(address)
    if toplevel == 0 || edges == 0 { return }
    const surface = state.surfaceAt(toplevel)
    dismissPopups(compositor, 0)
    const width = scene.windowWidth(surface)
    const height = scene.windowHeight(surface)
    compositor.*.resizing = toplevel
    compositor.*.resizeEdges = edges
    compositor.*.resizeStartX = compositor.*.pointerX
    compositor.*.resizeStartY = compositor.*.pointerY
    compositor.*.resizeStartWidth = width
    compositor.*.resizeStartHeight = height
    surface.*.snapped = state.SNAP_NONE
    surface.*.resizing = true
    // A column's size is its strip's (tiling.resizeColumn sets its width).
    if !surface.*.tiled {
        // Resizing from the left or top keeps the right or bottom edge put.
        surface.*.anchorEdges = edges & (scene.EDGE_LEFT | scene.EDGE_TOP)
        surface.*.anchorRight = scene.windowX(surface) + width
        surface.*.anchorBottom = scene.windowY(surface) + height
        surface.*.wantedWidth = width
        surface.*.wantedHeight = height
        surface.*.configuredWidth = width
        surface.*.configuredHeight = height
    }
    configureToplevel(surface)
    scene.damageCursor(compositor)
    if compositor.*.verbose {
        state.say("resize: ")
        state.sayTitle(surface)
        state.say("\n")
    }
}

fn resizeMotion(compositor: *shell.Compositor) -> void {
    const surface = state.surfaceAt(compositor.*.resizing)
    const edges = compositor.*.resizeEdges
    const dx = compositor.*.pointerX - compositor.*.resizeStartX
    const dy = compositor.*.pointerY - compositor.*.resizeStartY
    var width = compositor.*.resizeStartWidth
    var height = compositor.*.resizeStartHeight
    if edges & scene.EDGE_RIGHT != 0 { width += dx }
    if edges & scene.EDGE_LEFT != 0 { width -= dx }
    if edges & scene.EDGE_BOTTOM != 0 { height += dy }
    if edges & scene.EDGE_TOP != 0 { height -= dy }
    // A column's border sets its column's width (its height is the strip's).
    if surface.*.tiled {
        if edges & (scene.EDGE_LEFT | scene.EDGE_RIGHT) != 0 { tiling_module.resizeColumn(compositor, surface, width + 2 * scene.frameWidth(surface)) }
        return
    }
    requestSize(surface, width, height)
}

// The last size, without the resizing state.
fn endResize(compositor: *shell.Compositor) -> void {
    const address = compositor.*.resizing
    if address == 0 { return }
    compositor.*.resizing = 0
    const surface = state.surfaceAt(address)
    surface.*.resizing = false
    if !surface.*.tiled {
        surface.*.configuredWidth = surface.*.wantedWidth
        surface.*.configuredHeight = surface.*.wantedHeight
    }
    configureToplevel(surface)
    scene.damageCursor(compositor)
    if compositor.*.verbose {
        state.say("resize done: asked for ")
        state.sayInteger(surface.*.configuredWidth)
        state.say("x")
        state.sayInteger(surface.*.configuredHeight)
        state.say("\n")
    }
}

// After a toplevel commit: the configure it answered is done; while it is
// resized, the kept edges stay put and the next size goes out.
fn resizeCommitted(surface: *shell.Surface) -> void {
    const compositor = surface.*.compositor
    if surface.*.configurePending && surface.*.ackedSerial == surface.*.configureSerial { surface.*.configurePending = false }
    if surface.*.anchorEdges != 0 {
        const offset_x = if surface.*.hasGeometry { surface.*.geometryX } else { 0 }
        const offset_y = if surface.*.hasGeometry { surface.*.geometryY } else { 0 }
        if surface.*.anchorEdges & scene.EDGE_LEFT != 0 { surface.*.x = surface.*.anchorRight - scene.windowWidth(surface) - offset_x }
        if surface.*.anchorEdges & scene.EDGE_TOP != 0 { surface.*.y = surface.*.anchorBottom - scene.windowHeight(surface) - offset_y }
        // Kept until the final size is in.
        if !surface.*.resizing && !surface.*.configurePending { surface.*.anchorEdges = 0 }
    }
    // The log shows every new size of a mapped window.
    if compositor.*.verbose && surface.*.mapped && (scene.windowWidth(surface) != surface.*.loggedWidth || scene.windowHeight(surface) != surface.*.loggedHeight) {
        surface.*.loggedWidth = scene.windowWidth(surface)
        surface.*.loggedHeight = scene.windowHeight(surface)
        state.say("window:")
        sayGeometry(surface)
    }
    if surface.*.resizing && !surface.*.configurePending { requestSize(surface, surface.*.wantedWidth, surface.*.wantedHeight) }
}

pub fn sendKeyboardEnter(compositor: *shell.Compositor, keyboard: *shell.SeatResource, surface: *shell.Surface) -> void {
    const resource = wl.wl_keyboard.Resource.fromObject(keyboard.*.object)
    resource.sendEnter(compositor.*.server.nextSerial(), wl.wl_surface.Resource.fromObject(surface.*.resource), shell.emptyArray())
    resource.sendModifiers(compositor.*.server.nextSerial(), compositor.*.modsDepressed, compositor.*.modsLatched, compositor.*.modsLocked, compositor.*.modsGroup)
}

// Moves keyboard focus to the toplevel at `address` (0 clears it).
pub fn focus(compositor: *shell.Compositor, address: usize) -> void {
    // A window on another workspace (the dock's activate) brings that
    // workspace, which focuses its topmost window first.
    if address != 0 && state.surfaceAt(address).*.role == state.ROLE_TOPLEVEL && state.surfaceAt(address).*.workspace != compositor.*.workspace {
        workspaces_module.switchTo(compositor, state.surfaceAt(address).*.workspace)
    }
    // Focusing a minimized window (the dock, a hotkey) brings it back.
    if address != 0 && state.surfaceAt(address).*.minimized {
        const shown = state.surfaceAt(address)
        shown.*.minimized = false
        scene.damageSurface(compositor, shown)
        protocols_module.toplevelChanged(shown)
        if compositor.*.workspaceTiling[shown.*.workspace] { tiling_module.add(compositor, shown) }
    }
    if address != 0 { scene.raise(compositor, address) }
    if address != 0 && state.surfaceAt(address).*.tiled { tiling_module.reveal(compositor, state.surfaceAt(address)) }
    const old = compositor.*.keyboardFocus
    if old == address { return }
    compositor.*.keyboardFocus = address
    protocols_module.toplevelFocusChanged(compositor)
    xwm_module.focus(compositor, address)
    // The newly focused client's clipboard first, then its keyboard enter.
    data.offerToFocus(compositor)
    var index: usize = 0
    while index < compositor.*.keyboards.length {
        const keyboard = shell.seatResourceAt(state.listAt(compositor.*.keyboards, index))
        if old != 0 && state.sameClient(keyboard.*.object, state.surfaceAt(old).*.resource) {
            wl.wl_keyboard.Resource.fromObject(keyboard.*.object).sendLeave(compositor.*.server.nextSerial(), wl.wl_surface.Resource.fromObject(state.surfaceAt(old).*.resource))
        }
        if address != 0 && state.sameClient(keyboard.*.object, state.surfaceAt(address).*.resource) {
            sendKeyboardEnter(compositor, keyboard, state.surfaceAt(address))
        }
        index += 1
    }
    if old != 0 {
        configureToplevel(state.surfaceAt(old))
        scene.damageSurface(compositor, state.surfaceAt(old))
    }
    if address != 0 {
        const surface = state.surfaceAt(address)
        configureToplevel(surface)
        scene.damageSurface(compositor, surface)
        if compositor.*.verbose {
            state.say("focus: ")
            state.sayTitle(surface)
            state.say("\n")
        }
    }
    constraints.update(compositor)
}

// The topmost window shown (not minimized, on this workspace), or 0.
fn topmostToplevel(compositor: *shell.Compositor) -> usize {
    var index = compositor.*.stack.length
    while index > 0 {
        index -= 1
        const address = state.listAt(compositor.*.stack, index)
        if state.surfaceAt(address).*.role == state.ROLE_TOPLEVEL && !scene.hidden(address) { return address }
    }
    return 0
}

pub fn focusTopmost(compositor: *shell.Compositor) -> void {
    focus(compositor, topmostToplevel(compositor))
}

// The pointer focus for what is under the pointer now (after the windows
// changed under it: a workspace switched, a window moved away).
pub fn refreshPointerFocus(compositor: *shell.Compositor) -> void {
    if !compositor.*.pointerInside || compositor.*.dragging { return }
    updatePointerFocus(compositor, scene.surfaceAtPoint(compositor, compositor.*.pointerX, compositor.*.pointerY))
}

// Lets go of a move or a resize in progress (a workspace switched, tiling
// turned on or off).
pub fn endInteraction(compositor: *shell.Compositor) -> void {
    if compositor.*.moving != 0 {
        wobble.release(state.surfaceAt(compositor.*.moving))
        compositor.*.moving = 0
    }
    if compositor.*.snapZone != state.SNAP_NONE {
        scene.damageRect(compositor, scene.snapRect(compositor, compositor.*.snapZone))
        compositor.*.snapZone = state.SNAP_NONE
    }
    endResize(compositor)
}

// ---------------------------------------------------------------------------
// Aero snap

// Snaps a floating window to `zone`: a half or a quarter of the work area
// (the top edge maximizes); a maximized window snapped keeps the
// rectangle it will go back to.
pub fn snapTo(surface: *shell.Surface, zone: u8) -> void {
    if !isWindow(surface) || surface.*.tiled || zone == state.SNAP_NONE || surface.*.fullscreen { return }
    const compositor = surface.*.compositor
    if zone == state.SNAP_TOP {
        setMaximized(surface, true)
        return
    }
    if surface.*.snapped == state.SNAP_NONE { saveRestore(surface) }
    scene.damageSurface(compositor, surface)
    surface.*.maximized = false
    surface.*.snapped = zone
    const outer = scene.snapRect(compositor, zone)
    const frame = scene.frameWidth(surface)
    const title = scene.titleHeight(surface)
    surface.*.configuredWidth = outer.width - 2 * frame
    surface.*.configuredHeight = outer.height - 2 * frame - title
    moveWindowTo(surface, outer.x + frame, outer.y + frame + title)
    configureToplevel(surface)
    protocols_module.toplevelChanged(surface)
    scene.damageSurface(compositor, surface)
    if compositor.*.verbose {
        state.say("snap: ")
        state.say(snapName(zone))
        state.say(" ")
        state.sayTitle(surface)
        state.say("\nsnapped: ")
        state.sayInteger(outer.width)
        state.say("x")
        state.sayInteger(outer.height)
        state.say(" at ")
        state.sayInteger(outer.x)
        state.say(",")
        state.sayInteger(outer.y)
        state.say("\n")
    }
}

fn snapName(zone: u8) -> []const u8 {
    if zone == state.SNAP_LEFT { return "left" }
    if zone == state.SNAP_RIGHT { return "right" }
    if zone == state.SNAP_TOP_LEFT { return "top-left" }
    if zone == state.SNAP_TOP_RIGHT { return "top-right" }
    if zone == state.SNAP_BOTTOM_LEFT { return "bottom-left" }
    if zone == state.SNAP_BOTTOM_RIGHT { return "bottom-right" }
    return "top"
}

// While a floating window is dragged: the zone its pointer position means
// (the preview follows it).
fn updateSnapZone(compositor: *shell.Compositor, x: i32, y: i32) -> void {
    const dragged = state.surfaceAt(compositor.*.moving)
    var zone = state.SNAP_NONE
    if !dragged.*.tiled && !compositor.*.workspaceTiling[dragged.*.workspace] { zone = scene.snapZoneAt(compositor, x, y) }
    if zone == compositor.*.snapZone { return }
    if compositor.*.snapZone != state.SNAP_NONE { scene.damageRect(compositor, scene.snapRect(compositor, compositor.*.snapZone)) }
    compositor.*.snapZone = zone
    if zone != state.SNAP_NONE { scene.damageRect(compositor, scene.snapRect(compositor, zone)) }
}

fn sendPointerFrame(pointer: *shell.SeatResource) -> void {
    wl.wl_pointer.Resource.fromObject(pointer.*.object).sendFrame()
}

fn updatePointerFocus(compositor: *shell.Compositor, target: usize) -> void {
    const old = compositor.*.pointerFocus
    if old == target { return }
    compositor.*.pointerFocus = target
    compositor.*.cursorSurface = 0
    compositor.*.cursorHidden = false
    // One serial for the enter to every pointer of the client.
    if target != 0 { compositor.*.pointerEnterSerial = compositor.*.server.nextSerial() }
    var index: usize = 0
    while index < compositor.*.pointers.length {
        const pointer = shell.seatResourceAt(state.listAt(compositor.*.pointers, index))
        const resource = wl.wl_pointer.Resource.fromObject(pointer.*.object)
        if old != 0 && state.sameClient(pointer.*.object, state.surfaceAt(old).*.resource) {
            resource.sendLeave(compositor.*.server.nextSerial(), wl.wl_surface.Resource.fromObject(state.surfaceAt(old).*.resource))
            sendPointerFrame(pointer)
        }
        if target != 0 && state.sameClient(pointer.*.object, state.surfaceAt(target).*.resource) {
            const surface = state.surfaceAt(target)
            resource.sendEnter(compositor.*.pointerEnterSerial, wl.wl_surface.Resource.fromObject(surface.*.resource), wl.Fixed.fromInt(compositor.*.pointerX - scene.originX(surface)), wl.Fixed.fromInt(compositor.*.pointerY - scene.originY(surface)))
            sendPointerFrame(pointer)
        }
        index += 1
    }
    constraints.update(compositor)
}

// Sends popup_done to every mapped popup that does not belong to the
// surface `keep` (a window or a layer surface; 0: dismiss all).
fn dismissPopups(compositor: *shell.Compositor, keep: usize) -> void {
    var index: usize = 0
    while index < compositor.*.stack.length {
        const address = state.listAt(compositor.*.stack, index)
        const surface = state.surfaceAt(address)
        if surface.*.role == state.ROLE_POPUP && surface.*.hasPopup && protocols_module.rootAddress(address) != keep {
            wl.xdg_popup.Resource.fromObject(surface.*.popup).sendPopupDone()
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Input from the host (called by host.mlx)

// The pointer moved by (dx, dy) pixels ((raw_dx, raw_dy) before
// acceleration); pointerMotion follows with the new position.
pub fn pointerRelative(compositor: *shell.Compositor, dx: i32, dy: i32, raw_dx: i32, raw_dy: i32) -> void {
    constraints.relativeMotion(compositor, dx, dy, raw_dx, raw_dy)
}

pub fn pointerMotion(compositor: *shell.Compositor, wanted_x: i32, wanted_y: i32) -> void {
    // A lock holds the pointer; a confinement keeps it in its surface.
    if constraints.isLocked(compositor) && compositor.*.pointerInside { return }
    var x = wanted_x
    var y = wanted_y
    constraints.confine(compositor, &x, &y)
    const dx = x - compositor.*.pointerX
    const dy = y - compositor.*.pointerY
    if compositor.*.pointerInside { scene.damageCursor(compositor) }
    compositor.*.pointerX = x
    compositor.*.pointerY = y
    compositor.*.pointerInside = true
    scene.damageCursor(compositor)
    // A drag has the pointer (data.mlx): no pointer events for clients.
    if compositor.*.dragging {
        if compositor.*.pointerFocus != 0 { updatePointerFocus(compositor, 0) }
        data.dragMotion(compositor)
        return
    }
    if compositor.*.resizing != 0 {
        resizeMotion(compositor)
        return
    }
    if compositor.*.moving != 0 {
        const dragged = state.surfaceAt(compositor.*.moving)
        // A column dragged by its title changes places with its neighbours.
        if dragged.*.tiled {
            tiling_module.drag(compositor, dragged, x)
            return
        }
        // Dragging a maximized or fullscreen window takes it out of that
        // state first, its title bar under the pointer.
        if (dragged.*.maximized || dragged.*.fullscreen) && dragged.*.hasRestore {
            dragged.*.restoreX = x - dragged.*.restoreWidth / 2
            dragged.*.restoreY = y + 2 + scene.TITLE_HEIGHT / 2
            scene.damageSurface(compositor, dragged)
            dragged.*.fullscreen = false
            setMaximized(dragged, false)
            if !dragged.*.maximized && !dragged.*.fullscreen { wobble.grab(compositor, dragged, x, y) }
            return
        }
        // A snapped window dragged away is its old size again, under the
        // pointer.
        if dragged.*.snapped != state.SNAP_NONE && dragged.*.hasRestore {
            scene.damageSurface(compositor, dragged)
            dragged.*.snapped = state.SNAP_NONE
            dragged.*.hasRestore = false
            dragged.*.configuredWidth = dragged.*.restoreWidth
            dragged.*.configuredHeight = dragged.*.restoreHeight
            moveWindowTo(dragged, x - dragged.*.restoreWidth / 2, y + 2 + scene.TITLE_HEIGHT / 2)
            configureToplevel(dragged)
            wobble.grab(compositor, dragged, x, y)
            return
        }
        updateSnapZone(compositor, x, y)
        // Interactive move: the window and its popups follow the pointer.
        var index: usize = 0
        while index < compositor.*.stack.length {
            const address = state.listAt(compositor.*.stack, index)
            if scene.toplevelOf(address) == compositor.*.moving {
                const surface = state.surfaceAt(address)
                scene.damageSurface(compositor, surface)
                surface.*.x += dx
                surface.*.y += dy
                // The window bends as it goes (wobble.mlx).
                if address == compositor.*.moving { wobble.moved(compositor, surface, dx, dy) }
                scene.damageSurface(compositor, surface)
            }
            index += 1
        }
        return
    }
    // The bottom edge brings a hidden dock back.
    if compositor.*.dockAutohide && y >= @intCast(i32, compositor.*.height) - 2 && !compositor.*.dockWanted { launching_module.revealDock(compositor) }
    // Over the previews the pointer is the compositor's.
    if compositor.*.previewCount > 0 { launching_module.previewMotion(compositor) }
    if launching_module.onPreviews(compositor, x, y) {
        updatePointerFocus(compositor, 0)
        compositor.*.hoverEdges = 0
        return
    }
    updatePointerFocus(compositor, scene.surfaceAtPoint(compositor, x, y))
    // Over a window's border the cursor shows how it would resize.
    compositor.*.hoverEdges = 0
    if compositor.*.pointerFocus == 0 {
        const bordered = scene.borderAt(compositor, x, y)
        if bordered != 0 { compositor.*.hoverEdges = scene.borderEdges(state.surfaceAt(bordered), x, y) }
    }
    if compositor.*.pointerFocus == 0 { return }
    const surface = state.surfaceAt(compositor.*.pointerFocus)
    var index: usize = 0
    while index < compositor.*.pointers.length {
        const pointer = shell.seatResourceAt(state.listAt(compositor.*.pointers, index))
        if state.sameClient(pointer.*.object, surface.*.resource) {
            wl.wl_pointer.Resource.fromObject(pointer.*.object).sendMotion(compositor.*.time, wl.Fixed.fromInt(x - scene.originX(surface)), wl.Fixed.fromInt(y - scene.originY(surface)))
            sendPointerFrame(pointer)
        }
        index += 1
    }
}

pub fn pointerLeave(compositor: *shell.Compositor) -> void {
    updatePointerFocus(compositor, 0)
    if compositor.*.pointerInside { scene.damageCursor(compositor) }
    compositor.*.pointerInside = false
}

pub fn startMove(compositor: *shell.Compositor, address: usize) -> void {
    const toplevel = scene.toplevelOf(address)
    if toplevel == 0 { return }
    compositor.*.moving = toplevel
    compositor.*.snapZone = state.SNAP_NONE
    wobble.grab(compositor, state.surfaceAt(toplevel), compositor.*.pointerX, compositor.*.pointerY)
    if compositor.*.verbose {
        state.say("move: ")
        state.sayTitle(state.surfaceAt(toplevel))
        state.say("\n")
    }
}

pub fn pointerButton(compositor: *shell.Compositor, button: u32, pressed: bool) -> void {
    if pressed {
        compositor.*.buttonsDown += 1
    } else if compositor.*.buttonsDown > 0 {
        compositor.*.buttonsDown -= 1
    }
    // The buttons coming up end a drag; buttons during one do nothing else.
    if compositor.*.dragging {
        if !pressed && compositor.*.buttonsDown == 0 {
            data.dragRelease(compositor)
            updatePointerFocus(compositor, scene.surfaceAtPoint(compositor, compositor.*.pointerX, compositor.*.pointerY))
        }
        return
    }
    const target = compositor.*.pointerFocus
    if pressed && compositor.*.previewCount > 0 {
        // A thumbnail brings its window forward; anywhere else the
        // previews close (and the click goes on).
        if launching_module.onPreviews(compositor, compositor.*.pointerX, compositor.*.pointerY) {
            const chosen = scene.previewAt(compositor, compositor.*.pointerX, compositor.*.pointerY)
            if chosen < compositor.*.previewCount && button == shell.BTN_LEFT {
                const window = compositor.*.previewWindows[chosen]
                launching_module.hidePreviews(compositor)
                focus(compositor, window)
            }
            compositor.*.swallowedButton = true
            return
        }
        launching_module.hidePreviews(compositor)
    }
    if pressed {
        dismissPopups(compositor, if target == 0 { 0 } else { protocols_module.rootAddress(target) })
        if compositor.*.superDown { compositor.*.superUsed = true }
        if target != 0 { protocols_module.focusFromClick(compositor, target) }
        if target == 0 {
            // A click on the desktop closes the launcher.
            const launcher = protocols_module.launcherSurface(compositor)
            if launcher != 0 { protocols_module.closeLayer(state.surfaceAt(launcher)) }
        }
        if target == 0 && button == shell.BTN_LEFT {
            // Dragging a title bar moves its window.
            const titled = scene.titleAt(compositor, compositor.*.pointerX, compositor.*.pointerY)
            if titled != 0 {
                focus(compositor, titled)
                compositor.*.swallowedButton = true
                // A double click toggles maximize.
                if compositor.*.lastTitleClick == titled && compositor.*.time -% compositor.*.lastTitleClickTime < 400 {
                    compositor.*.lastTitleClick = 0
                    const window = state.surfaceAt(titled)
                    setMaximized(window, !window.*.maximized)
                    return
                }
                compositor.*.lastTitleClick = titled
                compositor.*.lastTitleClickTime = compositor.*.time
                startMove(compositor, titled)
                return
            }
            // Dragging a border resizes its window.
            const bordered = scene.borderAt(compositor, compositor.*.pointerX, compositor.*.pointerY)
            if bordered != 0 {
                focus(compositor, bordered)
                startResize(compositor, bordered, scene.borderEdges(state.surfaceAt(bordered), compositor.*.pointerX, compositor.*.pointerY))
                compositor.*.swallowedButton = true
                return
            }
        }
        if compositor.*.alt && button == shell.BTN_RIGHT && target != 0 {
            // Alt+right-drag resizes from the nearest corner.
            const window = state.surfaceAt(scene.toplevelOf(target))
            var edges = if compositor.*.pointerX < scene.windowX(window) + scene.windowWidth(window) / 2 { scene.EDGE_LEFT } else { scene.EDGE_RIGHT }
            edges = edges | (if compositor.*.pointerY < scene.windowY(window) + scene.windowHeight(window) / 2 { scene.EDGE_TOP } else { scene.EDGE_BOTTOM })
            startResize(compositor, target, edges)
            compositor.*.swallowedButton = true
            return
        }
        if compositor.*.alt && button == shell.BTN_LEFT && target != 0 {
            // Alt+drag moves windows without involving the client.
            startMove(compositor, target)
            compositor.*.swallowedButton = true
            return
        }
    } else {
        if compositor.*.buttonsDown == 0 {
            if compositor.*.moving != 0 && compositor.*.verbose { state.say("move done\n") }
            if compositor.*.moving != 0 { wobble.release(state.surfaceAt(compositor.*.moving)) }
            // Let go at an edge: the window snaps there.
            if compositor.*.moving != 0 && compositor.*.snapZone != state.SNAP_NONE {
                const zone = compositor.*.snapZone
                scene.damageRect(compositor, scene.snapRect(compositor, zone))
                compositor.*.snapZone = state.SNAP_NONE
                snapTo(state.surfaceAt(compositor.*.moving), zone)
            }
            compositor.*.moving = 0
            endResize(compositor)
        }
        if compositor.*.swallowedButton {
            compositor.*.swallowedButton = false
            return
        }
    }
    if target == 0 { return }
    const surface = state.surfaceAt(target)
    const button_state = if pressed { @intFromEnum(wl.wl_pointer.ButtonState.pressed) } else { @intFromEnum(wl.wl_pointer.ButtonState.released) }
    var index: usize = 0
    while index < compositor.*.pointers.length {
        const pointer = shell.seatResourceAt(state.listAt(compositor.*.pointers, index))
        if state.sameClient(pointer.*.object, surface.*.resource) {
            wl.wl_pointer.Resource.fromObject(pointer.*.object).sendButton(compositor.*.server.nextSerial(), compositor.*.time, button, button_state)
            sendPointerFrame(pointer)
        }
        index += 1
    }
}

pub fn pointerAxis(compositor: *shell.Compositor, axis: u32, value: wl.Fixed) -> void {
    // Super and the wheel (or the wheel over the desktop) scroll a tiling
    // workspace's strip of columns.
    if compositor.*.workspaceTiling[compositor.*.workspace] && (compositor.*.superDown || compositor.*.pointerFocus == 0) && compositor.*.moving == 0 {
        if compositor.*.superDown { compositor.*.superUsed = true }
        tiling_module.scroll(compositor, value.toInt() * 8)
        return
    }
    if compositor.*.pointerFocus == 0 { return }
    const surface = state.surfaceAt(compositor.*.pointerFocus)
    var index: usize = 0
    while index < compositor.*.pointers.length {
        const pointer = shell.seatResourceAt(state.listAt(compositor.*.pointers, index))
        if state.sameClient(pointer.*.object, surface.*.resource) {
            wl.wl_pointer.Resource.fromObject(pointer.*.object).sendAxis(compositor.*.time, axis, value)
            sendPointerFrame(pointer)
        }
        index += 1
    }
}

fn cycleFocus(compositor: *shell.Compositor) -> void {
    // Alt+Tab: bring the bottom-most window of this workspace to the front.
    var index: usize = 0
    while index < compositor.*.stack.length {
        const address = state.listAt(compositor.*.stack, index)
        if state.surfaceAt(address).*.role == state.ROLE_TOPLEVEL && !scene.hidden(address) {
            focus(compositor, address)
            return
        }
        index += 1
    }
}

fn closeFocused(compositor: *shell.Compositor) -> void {
    if compositor.*.keyboardFocus == 0 { return }
    closeWindow(state.surfaceAt(compositor.*.keyboardFocus))
}

// The VT a function key switches to with Ctrl+Alt (0: not one).
fn virtualTerminal(key: u32) -> u32 {
    if key >= shell.KEY_F1 && key <= shell.KEY_F10 { return key - shell.KEY_F1 + 1 }
    if key == shell.KEY_F11 { return 11 }
    if key == shell.KEY_F12 { return 12 }
    return 0
}

// The modifiers held now, as desktop-shared/keys.mlx masks them.
fn heldModifiers(compositor: *const shell.Compositor) -> u32 {
    var mask: u32 = 0
    if compositor.*.shift { mask = mask | keys.SHIFT }
    if compositor.*.control { mask = mask | keys.CONTROL }
    if compositor.*.alt { mask = mask | keys.ALT }
    if compositor.*.superDown { mask = mask | keys.SUPER }
    return mask
}

// Runs the hotkey bound to `key` with the modifiers held, if one is.
fn runHotkey(compositor: *shell.Compositor, key: u32) -> bool {
    const modifiers = heldModifiers(compositor)
    var action: usize = 0
    while action < keys.ACTIONS {
        if compositor.*.hotkeyKeys[action] == key && compositor.*.hotkeyModifiers[action] == modifiers {
            const focused = compositor.*.keyboardFocus
            if action == keys.ACTION_TERMINAL {
                launching_module.launch(compositor, compositor.*.terminal)
            } else if action == keys.ACTION_SWITCH {
                cycleFocus(compositor)
            } else if action == keys.ACTION_CLOSE {
                closeFocused(compositor)
            } else if action == keys.ACTION_TILING {
                tiling_module.toggle(compositor, compositor.*.workspace)
            } else if (action == keys.ACTION_LEFT || action == keys.ACTION_RIGHT) && compositor.*.workspaceTiling[compositor.*.workspace] {
                tiling_module.focusNeighbour(compositor, action == keys.ACTION_RIGHT)
            } else if focused != 0 && state.surfaceAt(focused).*.role == state.ROLE_TOPLEVEL {
                const window = state.surfaceAt(focused)
                if action == keys.ACTION_MAXIMIZE {
                    if window.*.tiled { tiling_module.toggleFull(compositor, window) } else { setMaximized(window, !window.*.maximized) }
                }
                if action == keys.ACTION_MINIMIZE { setMinimized(window, true) }
                if action == keys.ACTION_FULLSCREEN { setFullscreen(window, !window.*.fullscreen) }
                if action == keys.ACTION_LEFT { snapTo(window, state.SNAP_LEFT) }
                if action == keys.ACTION_RIGHT { snapTo(window, state.SNAP_RIGHT) }
                if action == keys.ACTION_MOVE_LEFT { tiling_module.moveColumn(compositor, window, false) }
                if action == keys.ACTION_MOVE_RIGHT { tiling_module.moveColumn(compositor, window, true) }
                if action == keys.ACTION_COLUMN_WIDTH { tiling_module.cycleWidth(compositor, window) }
            }
            return true
        }
        action += 1
    }
    return false
}

pub fn keyboardKey(compositor: *shell.Compositor, key: u32, pressed: bool) -> void {
    // A window that inhibits shortcuts gets Super and the hotkeys itself.
    const inhibited = constraints.shortcutsInhibited(compositor)
    // Super pressed and released on its own opens or closes the launcher.
    if inhibited {
        compositor.*.superDown = false
    } else if key == shell.KEY_LEFTMETA || key == shell.KEY_RIGHTMETA {
        if pressed {
            compositor.*.superDown = true
            compositor.*.superUsed = false
        } else if compositor.*.superDown {
            compositor.*.superDown = false
            if !compositor.*.superUsed { protocols_module.toggleLauncher(compositor) }
        }
    } else if pressed && compositor.*.superDown {
        compositor.*.superUsed = true
    }
    if key == shell.KEY_LEFTALT || key == shell.KEY_RIGHTALT { compositor.*.alt = pressed }
    if key == shell.KEY_LEFTSHIFT || key == shell.KEY_RIGHTSHIFT { compositor.*.shift = pressed }
    if key == shell.KEY_LEFTCTRL || key == shell.KEY_RIGHTCTRL { compositor.*.control = pressed }
    if pressed && compositor.*.freestanding && compositor.*.control && compositor.*.alt {
        // Freestanding, the compositor is the one to switch VTs.
        const terminal = virtualTerminal(key)
        if terminal != 0 || key == shell.KEY_BACKSPACE {
            if terminal != 0 { compositor.*.vtRequest = terminal } else { compositor.*.running = false }
            compositor.*.swallowedKey = key
            return
        }
    }
    if pressed && !inhibited && key == shell.KEY_ESC && compositor.*.previewCount > 0 {
        launching_module.hidePreviews(compositor)
        compositor.*.swallowedKey = key
        return
    }
    // Alt+Shift+Q quits; the other hotkeys come from the settings.
    if pressed && compositor.*.alt && compositor.*.shift && key == shell.KEY_Q {
        compositor.*.running = false
        compositor.*.swallowedKey = key
        return
    }
    // Super+1..9: that workspace; with Shift: the focused window goes there.
    if pressed && !inhibited && compositor.*.superDown && !compositor.*.alt && !compositor.*.control && key >= shell.KEY_1 && key <= shell.KEY_9 {
        const workspace = @intCast(usize, key - shell.KEY_1)
        if compositor.*.shift { workspaces_module.moveFocused(compositor, workspace) } else { workspaces_module.switchTo(compositor, workspace) }
        compositor.*.superUsed = true
        compositor.*.swallowedKey = key
        return
    }
    if pressed && !inhibited && keys.modifierOf(key) == 0 && runHotkey(compositor, key) {
        compositor.*.swallowedKey = key
        return
    }
    if !pressed && key == compositor.*.swallowedKey && key != 0 {
        compositor.*.swallowedKey = 0
        return
    }
    if compositor.*.keyboardFocus == 0 { return }
    const surface = state.surfaceAt(compositor.*.keyboardFocus)
    const key_state = if pressed { @intFromEnum(wl.wl_keyboard.KeyState.pressed) } else { @intFromEnum(wl.wl_keyboard.KeyState.released) }
    var index: usize = 0
    while index < compositor.*.keyboards.length {
        const keyboard = shell.seatResourceAt(state.listAt(compositor.*.keyboards, index))
        if state.sameClient(keyboard.*.object, surface.*.resource) {
            wl.wl_keyboard.Resource.fromObject(keyboard.*.object).sendKey(compositor.*.server.nextSerial(), compositor.*.time, key, key_state)
        }
        index += 1
    }
    if compositor.*.verbose && pressed {
        state.say("key ")
        state.sayNumber(@intCast(usize, key))
        state.say(" -> ")
        state.sayTitle(surface)
        state.say("\n")
    }
}

pub fn keyboardModifiers(compositor: *shell.Compositor, depressed: u32, latched: u32, locked: u32, group: u32) -> void {
    compositor.*.modsDepressed = depressed
    compositor.*.modsLatched = latched
    compositor.*.modsLocked = locked
    compositor.*.modsGroup = group
    if compositor.*.keyboardFocus == 0 { return }
    const surface = state.surfaceAt(compositor.*.keyboardFocus)
    var index: usize = 0
    while index < compositor.*.keyboards.length {
        const keyboard = shell.seatResourceAt(state.listAt(compositor.*.keyboards, index))
        if state.sameClient(keyboard.*.object, surface.*.resource) {
            wl.wl_keyboard.Resource.fromObject(keyboard.*.object).sendModifiers(compositor.*.server.nextSerial(), depressed, latched, locked, group)
        }
        index += 1
    }
}

// Sends the host's keymap to every client keyboard (it may arrive after
// clients bound their keyboards).
pub fn broadcastKeymap(compositor: *shell.Compositor) -> void {
    var index: usize = 0
    while index < compositor.*.keyboards.length {
        const keyboard = shell.seatResourceAt(state.listAt(compositor.*.keyboards, index))
        wl.wl_keyboard.Resource.fromObject(keyboard.*.object).sendKeymap(compositor.*.keymapFormat, compositor.*.keymap, compositor.*.keymapSize)
        index += 1
    }
}

// Counts a presented frame; once a second, works out the frames per second
// of the desktop and of each window and redraws the title bars showing them.
fn countFrame(compositor: *shell.Compositor, time: u32) -> void {
    compositor.*.desktopFrames +%= 1
    const elapsed = time -% compositor.*.fpsStart
    if elapsed < 1000 { return }
    const fresh = elapsed > 5000
    compositor.*.desktopFps = if fresh { 0 } else { (compositor.*.desktopFrames * 1000 + elapsed / 2) / elapsed }
    compositor.*.desktopFrames = 0
    compositor.*.fpsStart = time
    if compositor.*.verbose && compositor.*.presentCount > 0 && !fresh {
        state.say("perf: ")
        state.sayNumber(@intCast(usize, compositor.*.desktopFps))
        state.say(" fps, a frame takes ")
        state.sayNumber(compositor.*.presentMicros / compositor.*.presentCount)
        state.say(" us on average (composing ")
        state.sayNumber(compositor.*.renderMicros / compositor.*.presentCount)
        state.say(" us: uploading ")
        state.sayNumber(compositor.*.uploadMicros / compositor.*.presentCount)
        state.say(", GPU ")
        state.sayNumber(compositor.*.gpuMicros / compositor.*.presentCount)
        state.say(", copying out ")
        state.sayNumber(compositor.*.copyMicros / compositor.*.presentCount)
        state.say("), ")
        state.sayNumber(compositor.*.presentMax)
        state.say(" us at most\n")
    }
    compositor.*.presentMicros = 0
    compositor.*.renderMicros = 0
    compositor.*.uploadMicros = 0
    compositor.*.gpuMicros = 0
    compositor.*.copyMicros = 0
    compositor.*.presentMax = 0
    compositor.*.presentCount = 0
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        surface.*.fps = if fresh { 0 } else { (surface.*.fpsFrames * 1000 + elapsed / 2) / elapsed }
        surface.*.fpsFrames = 0
        if compositor.*.showFps && surface.*.role == state.ROLE_TOPLEVEL && surface.*.hasContent { scene.damageTitle(compositor, surface) }
        index += 1
    }
}

// Completes the frame callbacks committed before the last presented frame.
pub fn frameDone(compositor: *shell.Compositor, time: u32) -> void {
    countFrame(compositor, time)
    // Wobbling windows swing on, opening ones grow (and ask for the next
    // frame).
    wobble.advance(compositor)
    launching_module.zoomStep(compositor)
    launching_module.dockStep(compositor, time)
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        var callback: usize = 0
        while callback < surface.*.frameCallbackCount {
            const object = wl.server.Object.{ .client = surface.*.resource.client, .id = surface.*.frameCallbacks[callback] }
            wl.wl_callback.Resource.fromObject(object).sendDone(time)
            callback += 1
        }
        surface.*.frameCallbackCount = 0
        index += 1
    }
    capture_module.framePresented(compositor)
    // X windows the compositor moved tell X where they are.
    xwm_module.sync(compositor)
}

// ---------------------------------------------------------------------------
// Mapping

// For the log: the window's geometry as " WxH at X,Y".
fn sayGeometry(surface: *const shell.Surface) -> void {
    state.say(" ")
    state.sayInteger(scene.windowWidth(surface))
    state.say("x")
    state.sayInteger(scene.windowHeight(surface))
    state.say(" at ")
    state.sayInteger(scene.windowX(surface))
    state.say(",")
    state.sayInteger(scene.windowY(surface))
    state.say("\n")
}

// Maps a surface that has its role and content (xwm.mlx: an X window
// paired after its surface had content).
pub fn mapSurface(surface: *shell.Surface) -> void { map(surface) }

fn map(surface: *shell.Surface) -> void {
    const compositor = surface.*.compositor
    const address = state.addressOfSurface(surface)
    surface.*.mapped = true
    compositor.*.stack = state.listAppend(compositor.*.stack, address)
    scene.restack(compositor)
    if surface.*.role == state.ROLE_TOPLEVEL {
        // A new window opens on the workspace shown.
        if isWindow(surface) { surface.*.workspace = compositor.*.workspace }
        scene.place(compositor, surface)
        if compositor.*.verbose {
            state.say("map: ")
            state.sayTitle(surface)
            state.say("\n")
            state.say("window:")
            sayGeometry(surface)
            surface.*.loggedWidth = scene.windowWidth(surface)
            surface.*.loggedHeight = scene.windowHeight(surface)
        }
        protocols_module.toplevelMapped(compositor, address)
        launching_module.startZoom(compositor, surface)
        if isWindow(surface) && compositor.*.workspaceTiling[surface.*.workspace] { tiling_module.add(compositor, surface) }
        if compositor.*.exclusiveLayer == 0 { focus(compositor, address) }
        if isWindow(surface) { workspaces_module.notifyTopbar(compositor) }
    }
    scene.damageSurface(compositor, surface)
}

// Drops the compositor's references to the surface: the pointer focus,
// the keyboard focus, a move or a resize in progress. Called when it is
// unmapped and again when it is destroyed: a subsurface is never mapped
// yet holds the pointer focus when the pointer is over its content
// (scene.treeAtPoint), and a destroyed surface's memory goes back to the
// page allocator, so a focus left pointing at it would be read from an
// unmapped page on the next motion (a crash in sameClient).
pub fn forget(surface: *shell.Surface) -> void {
    const compositor = surface.*.compositor
    const address = state.addressOfSurface(surface)
    if compositor.*.moving == address {
        wobble.release(surface)
        compositor.*.moving = 0
    }
    if compositor.*.resizing == address { compositor.*.resizing = 0 }
    if compositor.*.pointerFocus == address { updatePointerFocus(compositor, 0) }
    if compositor.*.keyboardFocus == address {
        compositor.*.keyboardFocus = 0
        focus(compositor, topmostToplevel(compositor))
    }
}

pub fn unmap(surface: *shell.Surface) -> void {
    const compositor = surface.*.compositor
    const address = state.addressOfSurface(surface)
    if !surface.*.mapped { return }
    scene.damageSurface(compositor, surface)
    surface.*.zooming = false
    surface.*.mapped = false
    compositor.*.stack = state.listRemove(compositor.*.stack, address)
    if surface.*.role == state.ROLE_TOPLEVEL {
        protocols_module.toplevelUnmapped(compositor, address)
        launching_module.dropPreview(compositor, address)
        // (No configure: the toplevel may be going away.)
        tiling_module.forget(compositor, surface)
        surface.*.snapped = state.SNAP_NONE
        workspaces_module.notifyTopbar(compositor)
    }
    if surface.*.role == state.ROLE_LAYER {
        // To show it again the client starts over (a commit, a configure).
        surface.*.layerConfigureSent = false
        surface.*.layerAcked = false
        if compositor.*.exclusiveLayer == address { compositor.*.exclusiveLayer = 0 }
        protocols_module.updateReserves(compositor)
    }
    forget(surface)
    // Popups of an unmapped window go with it.
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const other = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        if other.*.parent == address {
            other.*.parent = 0
            if other.*.hasPopup { wl.xdg_popup.Resource.fromObject(other.*.popup).sendPopupDone() }
            unmap(other)
        }
        index += 1
    }
}

// Copies an attached shm buffer into the surface and releases it.
fn copyBuffer(surface: *shell.Surface, buffer: *shell.Buffer) -> void {
    const compositor = surface.*.compositor
    const width = @intCast(usize, buffer.*.width)
    const height = @intCast(usize, buffer.*.height)
    const needed = width * height * 4
    if needed > surface.*.pixelCapacity {
        if surface.*.pixelCapacity > 0 { state.release(compositor, surface.*.pixels, surface.*.pixelCapacity) }
        surface.*.pixels = state.allocate(compositor, needed)
        surface.*.pixelCapacity = needed
    }
    if buffer.*.pool.*.memory.address == 0 {
        // A dma-buf the CPU cannot map (only the Vulkan renderer reads
        // those): black instead.
        var index: usize = 0
        while index < needed {
            surface.*.pixels[index] = if index % 4 == 3 { 255 } else { 0 }
            index += 1
        }
        surface.*.pixelWidth = width
        surface.*.pixelHeight = height
        surface.*.hasContent = true
        surface.*.opaque = true
        wl.wl_buffer.Resource.fromObject(buffer.*.resource).sendRelease()
        return
    }
    const source = buffer.*.pool.*.memory.bytes()
    const offset = @intCast(usize, buffer.*.offset)
    const stride = @intCast(usize, buffer.*.stride)
    const xrgb = buffer.*.format == @intFromEnum(wl.wl_shm.Format.xrgb8888)
    // XRGB: the alpha byte is set to 255 on the way. All alpha bytes seen
    // are ANDed to find out whether an ARGB buffer is opaque throughout.
    const alpha_or: u32 = if xrgb { 4278190080 } else { 0 }
    var alpha_and: u32 = 4278190080
    if offset % 4 == 0 && stride % 4 == 0 {
        var from: [*]const u32 = undefined
        var to: [*]u32 = undefined
        unsafe {
            from = @ptrFromInt([*]const u32, @intFromPtr(source) + offset)
            to = @ptrCast([*]u32, surface.*.pixels)
        }
        const stride_pixels = stride / 4
        var row: usize = 0
        while row < height {
            const from_row = row * stride_pixels
            const to_row = row * width
            var column: usize = 0
            while column < width {
                const pixel = from[from_row + column] | alpha_or
                alpha_and = alpha_and & pixel
                to[to_row + column] = pixel
                column += 1
            }
            row += 1
        }
    } else {
        var row: usize = 0
        while row < height {
            var column: usize = 0
            const from = offset + row * stride
            const to = row * width * 4
            while column < width * 4 {
                surface.*.pixels[to + column] = source[from + column]
                column += 1
            }
            column = 3
            while column < width * 4 {
                if xrgb { surface.*.pixels[to + column] = 255 }
                alpha_and = alpha_and & (@intCast(u32, surface.*.pixels[to + column]) << 24)
                column += 4
            }
            row += 1
        }
    }
    surface.*.pixelWidth = width
    surface.*.pixelHeight = height
    surface.*.hasContent = true
    surface.*.opaque = alpha_and == 4278190080
    wl.wl_buffer.Resource.fromObject(buffer.*.resource).sendRelease()
}

// Vulkan: shows an attached buffer in place, releasing the one it replaces.
fn holdBuffer(surface: *shell.Surface, address: usize) -> void {
    if surface.*.current != 0 && surface.*.current != address {
        wl.wl_buffer.Resource.fromObject(shell.bufferAt(surface.*.current).*.resource).sendRelease()
    }
    surface.*.current = address
    const compositor = surface.*.compositor
    compositor.*.commits += 1
    surface.*.contentSerial = compositor.*.commits
    const buffer = shell.bufferAt(address)
    // A buffer attached without damage counts as changed everywhere.
    const changed = if ui.isEmpty(surface.*.pendingDamage) { ui.rect(0, 0, buffer.*.width, buffer.*.height) } else { surface.*.pendingDamage }
    surface.*.uploadDamage = scene.unionRect(surface.*.uploadDamage, changed)
    surface.*.pixelWidth = @intCast(usize, buffer.*.width)
    surface.*.pixelHeight = @intCast(usize, buffer.*.height)
    surface.*.hasContent = true
    surface.*.opaque = buffer.*.format == @intFromEnum(wl.wl_shm.Format.xrgb8888)
}

// Leaves the Vulkan renderer for the CPU one (it failed to compose a
// frame): the buffers surfaces show in place are copied into them and
// released, as the CPU renderer does on commit.
pub fn adoptCpuRenderer(compositor: *shell.Compositor) -> void {
    compositor.*.renderer = 0
    compositor.*.readsTiled = false
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        if surface.*.current != 0 {
            const address = surface.*.current
            surface.*.current = 0
            copyBuffer(surface, shell.bufferAt(address))
        }
        index += 1
    }
    scene.damageAll(compositor)
}

pub fn releaseCurrent(surface: *shell.Surface) -> void {
    if surface.*.current != 0 {
        wl.wl_buffer.Resource.fromObject(shell.bufferAt(surface.*.current).*.resource).sendRelease()
        surface.*.current = 0
    }
}

// A commit: applied now, or, for a subsurface in synchronized mode (it or
// an ancestor subsurface asked for it), kept until the parent's state is
// applied.
pub fn commit(surface: *shell.Surface) -> void {
    if surface.*.role == state.ROLE_SUBSURFACE && synchronized(surface) {
        surface.*.subCached = true
        return
    }
    applyCommit(surface)
    // Window captures waiting for new content (capture.mlx).
    capture_module.contentCommitted(surface.*.compositor)
}

fn synchronized(surface: *shell.Surface) -> bool {
    var current = surface
    var depth: usize = 0
    while current.*.role == state.ROLE_SUBSURFACE && current.*.parent != 0 && depth < 16 {
        if current.*.subSync { return true }
        current = state.surfaceAt(current.*.parent)
        depth += 1
    }
    return false
}

// Applies a surface's pending state, then its subsurfaces' positions and
// the commits they kept for it.
fn applyCommit(surface: *shell.Surface) -> void {
    const compositor = surface.*.compositor
    damageShown(surface)
    if surface.*.hasPendingAttach {
        if surface.*.pendingBuffer == 0 {
            surface.*.hasContent = false
            releaseCurrent(surface)
            unmap(surface)
        } else if compositor.*.renderer != 0 {
            surface.*.fpsFrames +%= 1
            holdBuffer(surface, surface.*.pendingBuffer)
        } else {
            surface.*.fpsFrames +%= 1
            copyBuffer(surface, shell.bufferAt(surface.*.pendingBuffer))
            compositor.*.commits += 1
            surface.*.contentSerial = compositor.*.commits
        }
        surface.*.hasPendingAttach = false
        surface.*.pendingBuffer = 0
    }
    surface.*.pendingDamage = ui.rect(0, 0, 0, 0)
    if surface.*.inputRegionChanged {
        var target: [*]state.RegionOp = undefined
        var source: [*]const state.RegionOp = undefined
        unsafe {
            target = @ptrCast([*]state.RegionOp, &surface.*.inputOps)
            source = @ptrCast([*]const state.RegionOp, &surface.*.pendingInputOps)
        }
        state.copyRegionOps(target, source, surface.*.pendingInputCount)
        surface.*.inputCount = surface.*.pendingInputCount
        surface.*.hasInputRegion = surface.*.hasPendingInputRegion
        surface.*.inputRegionChanged = false
    }
    var index: usize = 0
    while index < surface.*.pendingCallbackCount {
        if surface.*.frameCallbackCount < state.MAX_CALLBACKS {
            surface.*.frameCallbacks[surface.*.frameCallbackCount] = surface.*.pendingCallbacks[index]
            surface.*.frameCallbackCount += 1
        }
        index += 1
    }
    surface.*.pendingCallbackCount = 0
    protocols_module.applyBlur(surface)
    if surface.*.role == state.ROLE_TOPLEVEL {
        resizeCommitted(surface)
        pinState(surface)
        // A column stays where its strip puts it (its geometry may change).
        if surface.*.tiled && surface.*.mapped { tiling_module.place(surface) }
    }
    if surface.*.role == state.ROLE_LAYER { protocols_module.layerCommitted(surface) }
    const has_role = surface.*.role == state.ROLE_TOPLEVEL || surface.*.role == state.ROLE_POPUP
    if has_role && surface.*.configured && surface.*.hasContent && !surface.*.mapped { map(surface) }
    damageShown(surface)
    applyChildren(surface, 0)
}

fn applyChildren(surface: *shell.Surface, depth: usize) -> void {
    if depth >= 16 { return }
    var index: usize = 0
    while index < surface.*.children.length {
        const child = state.surfaceAt(state.listAt(surface.*.children, index))
        if child.*.hasPendingSubPosition {
            damageShown(child)
            child.*.subX = child.*.pendingSubX
            child.*.subY = child.*.pendingSubY
            child.*.hasPendingSubPosition = false
            damageShown(child)
        }
        if child.*.subCached {
            child.*.subCached = false
            applyCommit(child)
        } else {
            applyChildren(child, depth + 1)
        }
        index += 1
    }
}

// Reports what a surface shows as changed: its window when it is mapped,
// the cursor when it is the cursor. (Before and after a change to it.)
pub fn damageShown(surface: *shell.Surface) -> void {
    const compositor = surface.*.compositor
    if compositor.*.previewCount > 0 { launching_module.previewContentChanged(compositor, scene.toplevelOf(state.addressOfSurface(surface))) }
    if surface.*.mapped {
        scene.damageSurface(compositor, surface)
    } else if compositor.*.cursorSurface == state.addressOfSurface(surface) || (compositor.*.dragging && compositor.*.dragIcon == state.addressOfSurface(surface)) {
        scene.damageCursor(compositor)
    } else if surface.*.role == state.ROLE_SUBSURFACE && surfaceRoot(surface).*.mapped {
        scene.damageSurface(compositor, surface)
    }
}

// The surface a subsurface is ultimately part of (itself for any other).
fn surfaceRoot(surface: *shell.Surface) -> *shell.Surface {
    var current = surface
    var depth: usize = 0
    while current.*.role == state.ROLE_SUBSURFACE && current.*.parent != 0 && depth < 16 {
        current = state.surfaceAt(current.*.parent)
        depth += 1
    }
    return current
}

// Whether `candidate` is `surface` or one of the surfaces it is part of.
pub fn isAncestorOrSelf(candidate: usize, surface: usize) -> bool {
    var current = surface
    var depth: usize = 0
    while current != 0 && depth < 16 {
        if current == candidate { return true }
        current = state.surfaceAt(current).*.parent
        depth += 1
    }
    return false
}

// Takes a subsurface out of its parent's list.
pub fn detachFromParent(surface: *shell.Surface) -> void {
    if surface.*.parent == 0 { return }
    const parent = state.surfaceAt(surface.*.parent)
    const address = state.addressOfSurface(surface)
    const index = state.listIndexOf(parent.*.children, address)
    if index >= parent.*.children.length { return }
    if index < parent.*.belowCount { parent.*.belowCount -= 1 }
    parent.*.children = state.listRemove(parent.*.children, address)
}
