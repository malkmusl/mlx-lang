// The freestanding backend on brixOS (the compiler takes this file for
// drm.mlx there): the compositor drives the display and reads the input
// devices through brixOS's own nodes, as drm.mlx does through DRM/KMS and
// evdev on Linux.
//
// - Output: /devices/framebuffer (its geometry read: width, height, pitch,
//   format; its pixels mapped by node_map). Frames are composed on the
//   CPU into memory of our own (entries.composeCpu) and the changed rows
//   copied into the framebuffer (red and blue swapped when it is RGBX;
//   framebuffer.mlx has the loops). The framebuffer is only ever written:
//   it is video memory mapped write-combining, and reading it back takes
//   seconds.
// - Further displays (a machine with a second graphics adapter:
//   /devices/framebuffer1 and on) show the same picture, fitted to their
//   size (std.displays): what a frame changed is named to them after the
//   main display has it, and brought in a slice of the frame's time; the
//   rest when the desktop is at rest (frameWait then does not sleep).
// - Frame pacing: there is no vertical blank to wait for, so a clock of
//   our own stands in for it (framebuffer.frameWait, nextDue). A frame,
//   and with it the clients' frame callbacks, goes out no sooner than a
//   frame's time after the one before was due; what is damaged meanwhile
//   waits and is composed as one frame (the loop sleeps until then:
//   frameWait). On a desktop at rest nothing is held back: the first
//   change, a pointer move, is shown at once.
// - The handover: the first frames are blended over the picture the
//   program before left on the screen (the splash, the greeter's
//   compositor, a session's), which that program handed on in a file
//   (../splash/picture.mlx); without one the first frame is simply drawn.
//   When this compositor ends (stop, also on the terminate event: sentinel
//   ending the greeter's, the init a service), it leaves its last frame
//   the same way.
// - Input: /devices/keyboard (PS/2 scancodes, set 1: the main block's
//   codes are evdev's key codes, the extended ones (0xE0) are mapped) and
//   /devices/mouse (PS/2 packets: buttons, dx, dy). The keymap is
//   xkb.mlx's (without XKB data here: the modifiers tracked for the
//   usual keys, clients given no keymap and typing by their own US
//   layout).
// - No sessions, no VTs: switchTo does nothing.
// - The display's mode can change while the compositor runs (the kernel's
//   display_mode: std.displaymodes): whoever asked for it (the settings
//   program through this compositor, mode_change.mlx; root's `display`
//   tool), and when the kernel puts the mode before back by itself, the
//   display's node says it has changed (its handle's CHANGED, looked at
//   every turn of the loop: the loop wakes at least once a second, five
//   times a second while a mode waits to be kept). Then the picture is
//   mapped anew, the frame made for the new size and the whole desktop
//   laid out for it (entries.outputResized: output_size.mlx), the
//   further displays fitted anew, and the frame drawn whole. While the
//   kernel waits for the mode to be kept, the question whether to keep it
//   is on the screen (mode_question.mlx: its keys and clicks are taken
//   here, before the windows get them), and its answer is carried out
//   (displaymodes.confirm, takeBack). What the display offers goes into
//   the .display file for the settings program (`describe`).
const std = @import("std")
const events = @import("std.events")
const brix = std.os.brix
const evdev = std.linux.evdev
const wl = @import("std.wayland")
const ui = @import("std.ui")
const displays = @import("std.displays")
const displaymodes = @import("std.displaymodes")
const state = @import("./state.mlx")
const entries = @import("./entries.mlx")
const scene = @import("./scene.mlx")
const framebuffer = @import("./framebuffer.mlx")
const kms = @import("./kms.mlx")
const xkb = @import("./xkb.mlx")
const picture = @import("../splash/picture.mlx")
const clock = @import("../shared/clock.mlx")
const mode_question = @import("./mode_question.mlx")
const mode_change = @import("./mode_change.mlx")
const display_module = @import("./display.mlx")

const Compositor = state.Compositor

pub const Backend = struct {
    compositor: *Compositor
    framebuffer: brix.Handle
    keyboard: brix.Handle
    mouse: brix.Handle
    address: usize
    pitch: usize
    swap: bool
    // The further displays, which show the frame too.
    further: displays.Further
    // Our frame (width * height * 4), composed on the CPU.
    frame: [*]u8
    // The previous program's last frame while `fading` (width * height *
    // 4, in our frame's byte order), taken at start from the file that
    // program left (picture.take), not from the framebuffer: the opening
    // crossfade blends the first frames over it, so the splash fades into
    // the greeter and the greeter into the session with no hard cut. Given
    // back when the fade is done.
    previous: [*]u8
    fading: bool
    fadeStart: usize
    // The frame clock (microseconds): a frame's time, and when the next
    // frame may go out (0: none was shown yet).
    frameMicros: usize
    frameDue: usize
    // (For display.mlx, which describes the monitor from it.)
    output: kms.Output
    keyboardState: xkb.Keyboard
    // The scancode before: an extended one under way.
    extended: bool
    // The mouse's packet under way.
    packet: [3]u8
    packetLength: usize
    buttons: u32
    presented: usize
    // The display as the kernel said it last (its size, its mode's
    // state: what is pending, how often it changed), whether it says that
    // much (a kernel from before modes changed at run time does not), its
    // modes (MOST records, read when the file is written) and the askers
    // (mode_change.mlx).
    display: displaymodes.State
    knowsModes: bool
    modes: [*]displaymodes.Mode
    modeCount: usize
    asking: mode_change.Asking
}

fn word(bytes: [*]const u8, at: usize) -> usize {
    var value: usize = 0
    var k: usize = 8
    while k > 0 {
        k -= 1
        value = (value << 8) | @intCast(usize, bytes[at + k])
    }
    return value
}

fn keyboardOf(backend: *Backend) -> *xkb.Keyboard {
    unsafe { return @ptrCast(*xkb.Keyboard, &backend.*.keyboardState) }
}

fn outputOf(backend: *Backend) -> *kms.Output {
    unsafe { return @ptrCast(*kms.Output, &backend.*.output) }
}

// The display opened and mapped; false without one.
fn openDisplay(backend: *Backend) -> bool {
    const opened = brix.open(0, "/devices/framebuffer", brix.Open.READ | brix.Open.WRITE, 0)
    if opened < 0 { return false }
    backend.*.framebuffer = @intCast(u32, opened)
    // The whole record (with the mode's state), else its first words.
    var millihertz: usize = 0
    var width: usize = 0
    var height: usize = 0
    backend.*.knowsModes = displaymodes.state(backend.*.framebuffer, &backend.*.display)
    if backend.*.knowsModes {
        width = backend.*.display.width
        height = backend.*.display.height
        backend.*.pitch = backend.*.display.pitch
        backend.*.swap = backend.*.display.format == 2
        millihertz = backend.*.display.millihertz
    } else {
        var record: [32]u8 = undefined
        if brix.read(backend.*.framebuffer, record[0..32], 0) != 32 { return false }
        const words: [*]const u8 = &record
        width = word(words, 0)
        height = word(words, 8)
        backend.*.pitch = word(words, 16)
        backend.*.swap = word(words, 24) == 2
    }
    if width == 0 || height == 0 { return false }
    const mapped = brix.mapNode(backend.*.framebuffer, 0, backend.*.pitch * height)
    if mapped < 0 { return false }
    backend.*.address = @bitCast(usize, mapped)
    const output = outputOf(backend)
    output.*.width = width
    output.*.height = height
    setRate(output, millihertz)
    output.*.connectorType = 0
    output.*.connectorTypeId = 1
    output.*.modeCount = 0
    output.*.gammaSize = 0
    output.*.temperature = 0
    output.*.flipPending = false
    output.*.needsModeset = false
    return true
}

// The rate the display runs at (the kernel's millihertz; 0, not known:
// sixty a second).
fn setRate(output: *kms.Output, millihertz: usize) -> void {
    const rate = if millihertz >= 1000 && millihertz < 1000000 { millihertz } else { 60000 }
    output.*.millihertz = @intCast(u32, rate)
    output.*.refresh = @intCast(u32, (rate + 500) / 1000)
}

// Set by the terminate event (in the upcall): told to end, the loop ends
// at its next turn (dispatch) and stop() runs.
var terminated: bool = false // (per run)

fn onTerminate(record: events.Record) -> void {
    _ = record
    terminated = true
}

pub fn start(compositor: *Compositor) -> usize {
    const memory = state.allocate(compositor, @sizeOf(Backend))
    const backend: *Backend = unsafe { @ptrCast(*Backend, memory) }
    backend.*.compositor = compositor
    backend.*.extended = false
    backend.*.packetLength = 0
    backend.*.buttons = 0
    backend.*.presented = 0
    backend.*.modeCount = 0
    backend.*.asking.listener = -1
    backend.*.asking.pathLength = 0
    if !openDisplay(backend) {
        state.say("brix: no display (/devices/framebuffer)\n")
        return 0
    }
    unsafe { backend.*.modes = @ptrCast([*]displaymodes.Mode, state.allocate(compositor, displaymodes.MOST * @sizeOf(displaymodes.Mode))) }
    // The settings program asks here for another mode, when the kernel
    // has a driver that changes this display's (the greeter's compositor
    // takes no requests: nobody is logged in to ask).
    if backend.*.knowsModes && backend.*.display.settable && !compositor.*.greeterMode {
        if mode_change.begin(&backend.*.asking, compositor) && compositor.*.verbose {
            state.say("display: another mode is asked for at ")
            state.say(mode_change.pathOf(&backend.*.asking))
            state.say("\n")
        }
    }
    backend.*.frameMicros = 1000000000 / @intCast(usize, outputOf(backend).*.millihertz)
    backend.*.frameDue = 0
    compositor.*.width = outputOf(backend).*.width
    compositor.*.height = outputOf(backend).*.height
    backend.*.frame = state.allocate(compositor, compositor.*.width * compositor.*.height * 4)
    compositor.*.lastFrame = backend.*.frame
    compositor.*.lastFrameStride = compositor.*.width * 4
    // The further displays, when the machine has some: each shows the
    // frame fitted to its size, from the first frame on (until then what
    // was on them stays). The frame as it is composed, its pixels square:
    // where the main monitor stretches a mode of another shape, the
    // further display shows the desktop as it was drawn.
    displays.begin(&backend.*.further, compositor.*.width, compositor.*.height, 0, 0)
    const more = displays.open(&backend.*.further)
    if more != 0 && compositor.*.verbose {
        state.say("brix: ")
        state.sayNumber(more)
        state.say(if more == 1 { " further display shows the same picture\n" } else { " further displays show the same picture\n" })
    }
    // The previous program left its last frame on the display (the splash
    // told to keep its picture, the greeter's compositor, a session's) and
    // handed it on in a file: that is what the first frames fade in from.
    // With no file, or one that is not this display's, there is no fade:
    // the first frame is drawn as it is. (The framebuffer is not read.)
    // (Room for it, as large as the screen, only when one is waiting; a
    // file that is none of ours is removed all the same.)
    backend.*.fading = false
    if picture.waiting(compositor.*.width, compositor.*.height) {
        const previous = state.allocate(compositor, compositor.*.width * compositor.*.height * 4)
        backend.*.fading = picture.take(@intFromPtr(previous), compositor.*.width, compositor.*.height, picture.BLUE_FIRST)
        if backend.*.fading {
            backend.*.previous = previous
        } else {
            state.release(compositor, previous, compositor.*.width * compositor.*.height * 4)
        }
    } else {
        picture.discard()
    }
    if compositor.*.verbose { state.say(if backend.*.fading { "brix: fading in from the picture the program before left\n" } else { "brix: no picture left by a program before\n" }) }
    // Timed from the first composited frame, not here: the compositor's
    // own start-up (Wayland, the first client) can take longer than the
    // fade, which would use up the whole window before anything is drawn.
    backend.*.fadeStart = 0
    compositor.*.pointerX = @intCast(i32, compositor.*.width / 2)
    compositor.*.pointerY = @intCast(i32, compositor.*.height / 2)
    compositor.*.pointerInside = true
    scene.damageAll(compositor)
    _ = xkb.load(keyboardOf(backend), compositor)
    const keyboard = brix.open(0, "/devices/keyboard", brix.Open.READ, 0)
    backend.*.keyboard = if keyboard < 0 { 0 } else { @intCast(u32, keyboard) }
    if keyboard < 0 { state.say("brix: no keyboard (/devices/keyboard)\n") }
    const mouse = brix.open(0, "/devices/mouse", brix.Open.READ, 0)
    backend.*.mouse = if mouse < 0 { 0 } else { @intCast(u32, mouse) }
    if mouse < 0 { state.say("brix: no mouse (/devices/mouse)\n") }
    // Told to end (sentinel ending the greeter's compositor before the
    // session's starts, the init stopping the service), the loop ends and
    // stop() runs, which leaves the picture; the event's default would end
    // the program where it stands.
    _ = events.handle(events.Event.TERMINATE, onTerminate)
    // A mode that waits to be kept already (asked for before this
    // compositor started): the question is on the first frame.
    question(backend)
    return @intFromPtr(memory)
}

pub fn backendAt(address: usize) -> *Backend {
    unsafe { return @ptrFromInt(*Backend, address) }
}

// The display, as kms.Output describes one (display.mlx reads it).
pub fn output(backend: *Backend) -> *kms.Output { return outputOf(backend) }

pub fn stop(backend: *Backend) -> void {
    mode_change.end(&backend.*.asking, backend.*.compositor)
    // Our last frame stays on the screen: it is handed to the program that
    // takes the screen next, from our own memory. Not before a frame of
    // ours was shown, nor while the opening fade runs (the screen is
    // between two pictures then): the next program then starts without one.
    const compositor = backend.*.compositor
    if backend.*.presented > 0 && !backend.*.fading {
        const left = picture.leave(@intFromPtr(backend.*.frame), compositor.*.width, compositor.*.height, compositor.*.width * 4, picture.BLUE_FIRST)
        if compositor.*.verbose { state.say(if left { "brix: the last frame left for the next program\n" } else { "brix: the last frame could not be left for the next program\n" }) }
    }
    if backend.*.keyboard != 0 { _ = brix.close(backend.*.keyboard) }
    if backend.*.mouse != 0 { _ = brix.close(backend.*.mouse) }
    // The further displays keep the last frame too: what still waits is
    // brought before they are let go. What they cost is said.
    if backend.*.further.count != 0 {
        _ = displays.serve(&backend.*.further, @intFromPtr(backend.*.frame), compositor.*.width * 4, 0)
        if compositor.*.verbose {
            state.say("brix: the further displays took ")
            state.sayNumber(backend.*.further.spent / 1000)
            state.say(" ms in ")
            state.sayNumber(backend.*.further.slices)
            state.say(" slices (")
            state.sayNumber(backend.*.further.longest)
            state.say(" us the longest), ")
            state.sayNumber(backend.*.further.pixels)
            state.say(" pixels written\n")
        }
        displays.close(&backend.*.further)
    }
    if backend.*.address != 0 { _ = brix.unmap(backend.*.address, backend.*.pitch * outputOf(backend).*.height) }
    _ = brix.close(backend.*.framebuffer)
}

// ---------------------------------------------------------------------------
// The display's mode while the compositor runs

// The question whether to keep the mode, as the kernel's state says: on
// the screen while a mode waits to be kept (whoever asked for it), gone
// once it is kept or the mode before is back.
fn question(backend: *Backend) -> void {
    const compositor = backend.*.compositor
    const shown = backend.*.display
    if !backend.*.knowsModes || !shown.pending {
        mode_question.hide(compositor)
        return
    }
    const asked = &compositor.*.question
    if asked.*.shown && asked.*.width == shown.width && asked.*.height == shown.height && asked.*.millihertz == shown.millihertz { return }
    mode_question.show(compositor, shown.width, shown.height, shown.millihertz, shown.left, clock.germanLocale(compositor.*.environment))
    if compositor.*.verbose {
        state.say("display: asks whether to keep ")
        state.sayNumber(shown.width)
        state.say("x")
        state.sayNumber(shown.height)
        state.say(" (")
        state.sayNumber(shown.left / 1000000000)
        state.say(" s left)\n")
    }
}

// The display's picture is another one (another size, another place in
// the adapter's memory): mapped anew, and when its size changed, the
// frame made for the new size and the desktop laid out for it.
fn remap(backend: *Backend, now: *const displaymodes.State) -> void {
    const compositor = backend.*.compositor
    const output = outputOf(backend)
    const oldWidth = compositor.*.width
    const oldHeight = compositor.*.height
    // The old mapping is memory the display shows no more: it goes.
    if backend.*.address != 0 { _ = brix.unmap(backend.*.address, backend.*.pitch * output.*.height) }
    backend.*.address = 0
    backend.*.pitch = now.*.pitch
    backend.*.swap = now.*.format == 2
    output.*.width = now.*.width
    output.*.height = now.*.height
    setRate(output, now.*.millihertz)
    // (What wl_output tells the clients of the new mode.)
    compositor.*.outputMillihertz = output.*.millihertz
    backend.*.frameMicros = 1000000000 / @intCast(usize, output.*.millihertz)
    const mapped = brix.mapNode(backend.*.framebuffer, 0, now.*.pitch * now.*.height)
    if mapped >= 0 {
        backend.*.address = @bitCast(usize, mapped)
    } else {
        // (Nothing is copied to the screen until a change maps it again.)
        state.say("brix: the display's new picture cannot be mapped\n")
    }
    if now.*.width != oldWidth || now.*.height != oldHeight {
        // The opening fade is over: its picture is of the old size.
        if backend.*.fading {
            backend.*.fading = false
            state.release(compositor, backend.*.previous, oldWidth * oldHeight * 4)
        }
        state.release(compositor, backend.*.frame, oldWidth * oldHeight * 4)
        compositor.*.width = now.*.width
        compositor.*.height = now.*.height
        backend.*.frame = state.allocate(compositor, now.*.width * now.*.height * 4)
        compositor.*.lastFrame = backend.*.frame
        compositor.*.lastFrameStride = now.*.width * 4
        // The further displays show the frame fitted anew.
        if backend.*.further.count != 0 { refitFurther(backend) }
        entries.outputResized(compositor, oldWidth, oldHeight)
    }
    // The new picture is drawn whole, at once.
    scene.damageAll(compositor)
    backend.*.frameDue = 0
    if compositor.*.verbose {
        state.say("brix: the display is ")
        state.sayNumber(now.*.width)
        state.say("x")
        state.sayNumber(now.*.height)
        state.say(" at ")
        state.sayNumber(@intCast(usize, output.*.millihertz))
        state.say(" millihertz now (pitch ")
        state.sayNumber(now.*.pitch)
        state.say(")\n")
    }
}

// The further displays let go and taken again (each fitted anew to the
// frame's size and its own), the whole frame waiting for them.
fn refitFurther(backend: *Backend) -> void {
    const compositor = backend.*.compositor
    displays.close(&backend.*.further)
    displays.begin(&backend.*.further, compositor.*.width, compositor.*.height, 0, 0)
    _ = displays.open(&backend.*.further)
}

// Reads the display's state (which takes the handle's CHANGED away) and
// follows it: the picture mapped anew when it is another, the question
// shown or taken away, the .display file written again.
fn follow(backend: *Backend) -> void {
    var now: displaymodes.State = undefined
    if !displaymodes.state(backend.*.framebuffer, &now) { return }
    const before = backend.*.display
    backend.*.display = now
    if now.changes != before.changes || now.width != before.width || now.height != before.height || now.pitch != before.pitch {
        remap(backend, &now)
    }
    question(backend)
    display_module.write(backend.*.compositor)
}

// The display's handle says it changed (a cheap look: the handle's
// state); followed.
fn followChanges(backend: *Backend) -> void {
    if !backend.*.knowsModes { return }
    if displaymodes.changed(backend.*.framebuffer) {
        follow(backend)
    } else if backend.*.compositor.*.question.shown {
        // A mode kept by another program (root's `display confirm`, the
        // tool's own question) changes no picture, so the handle does not
        // say it: while the question is up, the kernel is asked whether
        // the mode still waits, and the question goes once it does not.
        var now: displaymodes.State = undefined
        if displaymodes.state(backend.*.framebuffer, &now) && !now.pending { follow(backend) }
    }
    // A further display's own mode changed (root's `display` tool): it
    // shows the frame fitted to its new size.
    var k: usize = 0
    while k < backend.*.further.count {
        const handle = backend.*.further.screens[k].handle
        if handle != 0 && displaymodes.changed(handle) {
            refitFurther(backend)
            if backend.*.compositor.*.verbose { state.say("brix: a further display changed; it shows the frame fitted anew\n") }
            return
        }
        k += 1
    }
}

// The question's answer carried out: kept (the kernel remembers it for
// the next boots) or taken back (the mode before runs again, followed
// like any change).
fn carryOut(backend: *Backend) -> void {
    const compositor = backend.*.compositor
    const answer = compositor.*.question.answer
    if answer == 0 { return }
    compositor.*.question.answer = 0
    const done = if answer == state.QUESTION_KEEP { displaymodes.confirm(backend.*.framebuffer) } else { displaymodes.takeBack(backend.*.framebuffer) }
    if compositor.*.verbose {
        state.say(if answer == state.QUESTION_KEEP { "display: kept" } else { "display: taken back" })
        state.say(if done == 0 { "\n" } else { " (the kernel had nothing pending any more)\n" })
    }
    follow(backend)
}

// An Ask from the settings program: the kernel asked, the change
// followed, the answer told.
fn serveAskers(backend: *Backend) -> void {
    const compositor = backend.*.compositor
    var request: mode_change.Request = undefined
    while mode_change.take(&backend.*.asking, compositor, &request) {
        if compositor.*.verbose {
            state.say("display: asked for ")
            state.sayNumber(request.width)
            state.say("x")
            state.sayNumber(request.height)
            state.say(" at ")
            state.sayNumber(request.millihertz)
            state.say(" millihertz\n")
        }
        const status = displaymodes.ask(backend.*.framebuffer, request.width, request.height, request.millihertz)
        follow(backend)
        if status != 0 && compositor.*.verbose {
            state.say("display: not set: ")
            state.say(mode_change.refusal(status, backend.*.display.last, backend.*.display.lastWhy))
            state.say("\n")
        }
        mode_change.answer(&backend.*.asking, &request, status, &backend.*.display)
    }
}

// What the display offers, for the .display file (display.mlx), from
// `at`; the length after it (at most `capacity`):
//
//     driver = QEMU's adapter          (who sets the display's modes)
//     ask = /temporary/wayland-mlx.modes
//                                      (where to ask: mode_change.mlx;
//                                       none: no change while it runs)
//     pending = 12                     (seconds left to keep the mode)
//     available = 1920x1080@60 60000 own
//                                      (a mode that can be set: its rate
//                                       in millihertz, `own` the
//                                       monitor's, `runs`, `kept` the one
//                                       the next boots set)
//     unavailable = 3840x2160@60 60000 own: more than this output carries
pub fn describe(backend: *Backend, out: [*]u8, at: usize, capacity: usize) -> usize {
    if !backend.*.knowsModes { return at }
    var length = at
    const shown = &backend.*.display
    length = putText(out, length, capacity, "\ndriver = ")
    length = putText(out, length, capacity, driverName(shown.*.driver))
    if mode_change.pathOf(&backend.*.asking).length > 0 {
        length = putText(out, length, capacity, "\nask = ")
        length = putText(out, length, capacity, mode_change.pathOf(&backend.*.asking))
    }
    if shown.*.pending {
        length = putText(out, length, capacity, "\npending = ")
        length = putNumber(out, length, capacity, (shown.*.left + 999999999) / 1000000000)
    }
    backend.*.modeCount = displaymodes.list(backend.*.framebuffer, backend.*.modes[0..displaymodes.MOST])
    var index: usize = 0
    while index < backend.*.modeCount {
        const mode = backend.*.modes[index]
        index += 1
        // (Interlaced and doubled pictures are not offered: no driver
        // here makes them.)
        if mode.interlaced || mode.doubled { continue }
        length = putText(out, length, capacity, if mode.can { "\navailable = " } else { "\nunavailable = " })
        length = putNumber(out, length, capacity, @intCast(usize, mode.width))
        length = putText(out, length, capacity, "x")
        length = putNumber(out, length, capacity, @intCast(usize, mode.height))
        length = putText(out, length, capacity, "@")
        length = putNumber(out, length, capacity, (@intCast(usize, mode.millihertz) + 500) / 1000)
        length = putText(out, length, capacity, " ")
        length = putNumber(out, length, capacity, @intCast(usize, mode.millihertz))
        if mode.own { length = putText(out, length, capacity, " own") }
        if mode.runs { length = putText(out, length, capacity, " runs") }
        if mode.kept { length = putText(out, length, capacity, " kept") }
        if !mode.can {
            length = putText(out, length, capacity, ": ")
            length = putText(out, length, capacity, displaymodes.whyText(mode.why))
        }
    }
    return length
}

fn putText(out: [*]u8, at: usize, capacity: usize, text: []const u8) -> usize {
    if at + text.length > capacity { return at }
    return std.text.append(out, at, capacity, text)
}

fn putNumber(out: [*]u8, at: usize, capacity: usize, value: usize) -> usize {
    if at + 20 > capacity { return at }
    return std.text.appendUnsigned(out, at, at + 20, value)
}

// The display's driver in words (the record's word 112).
fn driverName(driver: usize) -> []const u8 {
    if driver == displaymodes.Driver.QEMU { return "QEMU's adapter" }
    if driver == displaymodes.Driver.RADEON_TMDS { return "Radeon, HDMI or DVI" }
    if driver == displaymodes.Driver.RADEON_OTHER { return "Radeon" }
    if driver == displaymodes.Driver.RADEON_DP { return "Radeon, DisplayPort" }
    return "the firmware's picture"
}


// ---------------------------------------------------------------------------
// The event loop

// The handles to wait on: the keyboard and the mouse.
pub fn handles(backend: *Backend, list: [*]wl.Handle, capacity: usize) -> usize {
    var count: usize = 0
    if backend.*.keyboard != 0 && count < capacity {
        list[count] = wl.Handle.fromDescriptor(@intCast(isize, backend.*.keyboard))
        count += 1
    }
    if backend.*.mouse != 0 && count < capacity {
        list[count] = wl.Handle.fromDescriptor(@intCast(isize, backend.*.mouse))
        count += 1
    }
    // The settings program asking for another mode.
    var asking: [3]isize = undefined
    const askers = mode_change.descriptors(&backend.*.asking, &asking, 0, 3)
    var index: usize = 0
    while index < askers && count < capacity {
        list[count] = wl.Handle.fromDescriptor(asking[index])
        count += 1
        index += 1
    }
    return count
}

// (Told to end: the loop does not wait before dispatch sees it.)
pub fn hasBufferedData(backend: *Backend) -> bool {
    _ = backend
    return terminated
}

fn now() -> u32 { return @intCast(u32, std.time.milliseconds() & 4294967295) }

// Whether `handle` can be read now (the devices' reads would wait).
fn readable(handle: brix.Handle) -> bool {
    var items: [1]brix.WaitItem = undefined
    items[0] = brix.WaitItem.{ .handle = handle, .want = brix.State.READABLE, .seen = 0, .reserved = 0 }
    return brix.wait(items[0..1], brix.clock(brix.Clock.MONOTONIC)) > 0 && items[0].seen & brix.State.READABLE != 0
}

// An extended scancode (after 0xE0) as evdev's key code; 0 for one not
// mapped.
fn extendedKey(code: u8) -> u32 {
    if code == 0x48 { return 103 }
    if code == 0x50 { return 108 }
    if code == 0x4B { return 105 }
    if code == 0x4D { return 106 }
    if code == 0x47 { return 102 }
    if code == 0x4F { return 107 }
    if code == 0x49 { return 104 }
    if code == 0x51 { return 109 }
    if code == 0x52 { return 110 }
    if code == 0x53 { return 111 }
    if code == 0x1C { return 96 }
    if code == 0x1D { return 97 }
    if code == 0x38 { return 100 }
    if code == 0x35 { return 98 }
    if code == 0x5B { return 125 }
    if code == 0x5C { return 126 }
    if code == 0x5D { return 127 }
    return 0
}

fn keyEvent(backend: *Backend, code: u32, pressed: bool) -> void {
    const compositor = backend.*.compositor
    const keyboard = keyboardOf(backend)
    const changed = xkb.key(keyboard, code, pressed)
    // While the question about the display's mode is up, it has the keys
    // pressed (and their releases: mode_question.key).
    if mode_question.key(compositor, code, pressed) { return }
    entries.keyboardKey(compositor, code, pressed)
    if changed { entries.keyboardModifiers(compositor, keyboard.*.depressed, keyboard.*.latched, keyboard.*.locked, keyboard.*.group) }
}

fn readKeyboard(backend: *Backend) -> void {
    var codes: [64]u8 = undefined
    const got = brix.read(backend.*.keyboard, codes[0..64], brix.STREAM)
    if got <= 0 { return }
    backend.*.compositor.*.time = now()
    var k: usize = 0
    while k < @bitCast(usize, got) {
        const byte = codes[k]
        k += 1
        if byte == 0xE0 {
            backend.*.extended = true
            continue
        }
        const pressed = byte & 0x80 == 0
        const scancode = byte & 0x7F
        var code: u32 = 0
        if backend.*.extended {
            backend.*.extended = false
            code = extendedKey(scancode)
        } else {
            code = @intCast(u32, scancode)
        }
        if code != 0 && code < 256 { keyEvent(backend, code, pressed) }
    }
}

fn clamp(value: i32, limit: usize) -> i32 {
    if value < 0 { return 0 }
    if value >= @intCast(i32, limit) { return @intCast(i32, limit) - 1 }
    return value
}

// One packet: the buttons' changes, then the motion.
fn mousePacket(backend: *Backend) -> void {
    const compositor = backend.*.compositor
    const first = backend.*.packet[0]
    var dx: i32 = @intCast(i32, backend.*.packet[1])
    var dy: i32 = @intCast(i32, backend.*.packet[2])
    if first & 0x10 != 0 { dx -= 256 }
    if first & 0x20 != 0 { dy -= 256 }
    // Up on the mouse is down on the screen.
    dy = 0 - dy
    const buttons = @intCast(u32, first & 7)
    var bit: u32 = 0
    while bit < 3 {
        const mask = @intCast(u32, 1) << @intCast(u5, bit)
        const was = backend.*.buttons & mask != 0
        const is = buttons & mask != 0
        if was != is {
            // 0 left, 1 right, 2 middle: evdev's BTN_LEFT, BTN_RIGHT, BTN_MIDDLE.
            const button = if bit == 0 { evdev.BTN_LEFT } else if bit == 1 { evdev.BTN_RIGHT } else { evdev.BTN_MIDDLE }
            const keyboard = keyboardOf(backend)
            if is {
                keyboard.*.pressedButtons = keyboard.*.pressedButtons | (@intCast(u32, 1) << @intCast(u5, button - evdev.BTN_LEFT))
            } else {
                keyboard.*.pressedButtons = keyboard.*.pressedButtons & (4294967295 ^ (@intCast(u32, 1) << @intCast(u5, button - evdev.BTN_LEFT)))
            }
            // (The question about the display's mode takes every click
            // made while it is shown.)
            if !mode_question.button(compositor, button, compositor.*.pointerX, compositor.*.pointerY, is) { entries.pointerButton(compositor, button, is) }
        }
        bit += 1
    }
    backend.*.buttons = buttons
    if dx != 0 || dy != 0 {
        entries.pointerRelative(compositor, dx, dy, dx, dy)
        entries.pointerMotion(compositor, clamp(compositor.*.pointerX + dx, compositor.*.width), clamp(compositor.*.pointerY + dy, compositor.*.height))
        mode_question.motion(compositor, compositor.*.pointerX, compositor.*.pointerY)
    }
}

fn readMouse(backend: *Backend) -> void {
    var bytes: [96]u8 = undefined
    const got = brix.read(backend.*.mouse, bytes[0..96], brix.STREAM)
    if got <= 0 { return }
    backend.*.compositor.*.time = now()
    var k: usize = 0
    while k < @bitCast(usize, got) {
        const byte = bytes[k]
        k += 1
        // A packet starts with bit 3 set: anything else out of step is
        // dropped until one does.
        if backend.*.packetLength == 0 && byte & 0x08 == 0 { continue }
        backend.*.packet[backend.*.packetLength] = byte
        backend.*.packetLength += 1
        if backend.*.packetLength == 3 {
            backend.*.packetLength = 0
            mousePacket(backend)
        }
    }
}

pub fn dispatch(backend: *Backend) -> void {
    if terminated { backend.*.compositor.*.running = false }
    xkb.reloadIfWanted(keyboardOf(backend), backend.*.compositor)
    if backend.*.keyboard != 0 && readable(backend.*.keyboard) { readKeyboard(backend) }
    if backend.*.mouse != 0 && readable(backend.*.mouse) { readMouse(backend) }
    // The display's mode: asked for, changed by anyone, the question's
    // answer and its seconds.
    serveAskers(backend)
    carryOut(backend)
    followChanges(backend)
    mode_question.tick(backend.*.compositor)
}

// How long the opening crossfade from the previous program's frame runs.
const FADE_MS: usize = 300

// How long the loop may wait for a frame's sake, in milliseconds: until
// the frame that is held back for its time is due (present), a second
// when none is.
pub fn frameWait(backend: *Backend) -> isize {
    // (Something waits to be brought to a further display: the loop
    // comes back at once, and present brings a slice of it.)
    if displays.waiting(&backend.*.further) { return 0 }
    // (While a mode waits to be kept: its seconds counted down on the
    // screen, and the kernel taking it back followed at once.)
    const most: isize = if backend.*.compositor.*.question.shown { 200 } else { 1000 }
    if !backend.*.compositor.*.needsRedraw { return most }
    const due = @intCast(isize, (framebuffer.frameWait(backend.*.frameDue, state.microseconds()) + 999) / 1000)
    return if due < most { due } else { most }
}

// A slice of what waits for the further displays, while no frame goes
// out: for `micros` at most, and no longer than until the frame that is
// held back is due.
fn serveAtRest(backend: *Backend, micros: usize) -> void {
    if !displays.waiting(&backend.*.further) { return }
    var slice = micros
    if backend.*.compositor.*.needsRedraw {
        const until = framebuffer.frameWait(backend.*.frameDue, state.microseconds())
        if until < slice { slice = until }
        if slice == 0 { return }
    }
    _ = displays.serve(&backend.*.further, @intFromPtr(backend.*.frame), backend.*.compositor.*.width * 4, slice)
}

// Composes and shows a frame when something changed and its time has
// come.
pub fn present(backend: *Backend) -> void {
    const compositor = backend.*.compositor
    if !compositor.*.needsRedraw {
        serveAtRest(backend, displays.REST_SLICE)
        return
    }
    const start = state.microseconds()
    // Not sooner than a frame's time after the one before was due: what is
    // damaged until then goes into the same frame (the loop wakes when it
    // is due: frameWait).
    if framebuffer.frameWait(backend.*.frameDue, start) != 0 {
        serveAtRest(backend, displays.REST_SLICE)
        return
    }
    backend.*.frameDue = framebuffer.nextDue(backend.*.frameDue, start, backend.*.frameMicros)
    // The opening crossfade: the frame is blended over the previous
    // program's on its way to the screen, the composed weight rising to
    // full over FADE_MS, so a new compositor fades in instead of cutting.
    var weight: usize = 256
    if backend.*.fading {
        const nowMs = std.time.milliseconds()
        if backend.*.fadeStart == 0 { backend.*.fadeStart = nowMs }
        const elapsed = nowMs - backend.*.fadeStart
        if elapsed >= FADE_MS {
            // The fade's last frame is the whole picture at full weight:
            // what the blended frames left on the screen (the previous
            // program's picture, all of it when the first frame after the
            // fade's start comes this late) is drawn over, not only where
            // something changes later. The previous frame has done its
            // part.
            backend.*.fading = false
            state.release(compositor, backend.*.previous, compositor.*.width * compositor.*.height * 4)
            scene.damageAll(compositor)
        } else {
            weight = elapsed * 256 / FADE_MS
        }
    }
    // Our frame is composed in what changed since the last one, also while
    // the fade runs: its memory holds the rest (the first frame is the
    // whole screen's: start damages it).
    var changed: ui.Rect = undefined
    const region = scene.takeDamage(compositor, 0, &changed)
    entries.composeCpu(compositor, backend.*.frame, changed)
    // Into the framebuffer: the changed rows as they are or, while the
    // fade runs, the whole frame at its new weight over the previous
    // picture.
    const composed = state.microseconds()
    const stride = compositor.*.width * 4
    if backend.*.address == 0 {
        // (No picture mapped: the display's new one could not be.)
    } else if weight < 256 {
        framebuffer.fadeRows(backend.*.address, backend.*.pitch, @intFromPtr(backend.*.frame), @intFromPtr(backend.*.previous), stride, scene.outputRect(compositor), weight, backend.*.swap)
    } else {
        framebuffer.copyRows(backend.*.address, backend.*.pitch, @intFromPtr(backend.*.frame), stride, region, backend.*.swap)
    }
    // The further displays: what this frame changed waits for them from
    // here, and a slice of it is brought now, after the main display has
    // its frame (they show the frame as it is, also while the opening
    // fade runs on the main one). Their time counts as the screen's.
    if backend.*.further.count != 0 {
        if !ui.isEmpty(region) { displays.damage(&backend.*.further, @intCast(usize, region.x), @intCast(usize, region.y), @intCast(usize, region.width), @intCast(usize, region.height)) }
        _ = displays.serve(&backend.*.further, @intFromPtr(backend.*.frame), stride, displays.FRAME_SLICE)
    }
    compositor.*.deviceMicros += state.microseconds() - composed
    compositor.*.lastFrame = backend.*.frame
    compositor.*.lastFrameStride = stride
    if backend.*.presented == 0 && compositor.*.verbose { state.say("brix: first frame on screen\n") }
    backend.*.presented += 1
    compositor.*.frames += 1
    // Keep the frames coming until the crossfade is done.
    if backend.*.fading { compositor.*.needsRedraw = true }
    // Counted before the frame is told done: frameDone is where a second's
    // statistics are said and begun again, and this frame's composing and
    // copying are in them already.
    state.countPresent(compositor, start)
    entries.frameDone(compositor, now())
}

// Ctrl+Alt+F<number>: no virtual terminals here.
pub fn switchTo(backend: *Backend, number: u32) -> void {
    _ = backend
    _ = number
}
