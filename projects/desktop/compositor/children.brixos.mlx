// The compositor's children on brixOS (children.mlx's interface, on the
// system's own calls): programs start with process_spawn (std.spawn: the
// program's node, PATH looked up, our input, output and errors as theirs),
// a helper with one end of a channel pair as its own role (Role.OWN;
// MLX_LAUNCHER_FD, MLX_DOCK_FD and MLX_TOPBAR_FD only say there is one:
// projects/desktop/shared/channel.mlx finds it); the children are
// process handles, asked whether they ended at every turn of the loop
// (no SIGCHLD, no waitpid). The greeter needs WAYLAND_SOCKET with a
// descriptor number: not on brixOS yet.
const std = @import("std")
const brix = std.os.brix
const spawn_module = @import("std.spawn")
const state = @import("./state.mlx")
const shell = @import("./shell.mlx")

const MAX_CHILDREN: usize = 64

// The children running (process handles), to reap.
var children: [MAX_CHILDREN]isize = undefined // (per run)
var childCount: usize = 0 // (per run)

pub fn makeChannel(ours: *isize, theirs: *isize) -> bool {
    var ends: [2]u32 = [2]u32{ 0, 0 }
    if brix.channelPair(&ends) < 0 { return false }
    ours.* = @intCast(isize, ends[0])
    theirs.* = @intCast(isize, ends[1])
    return true
}

// (The helper finds its end by its role, not by a number: the variable
// only says there is one.)
pub fn childNumber(theirs: isize) -> usize {
    _ = theirs
    return 0
}

fn hasSlash(program: [*]const u8) -> bool {
    var index: usize = 0
    while program[index] != 0 {
        if program[index] == 47 { return true }
        index += 1
    }
    return false
}

// Runs `program` (looked up in PATH without a slash) with `environment`
// and our input, output, errors and session; `theirs` (-1: none) goes
// along as the child's own role (Role.OWN), closed here. The child's
// process handle, or -1.
pub fn runWith(compositor: *shell.Compositor, program: [*]const u8, environment: [*][*]const u8, theirs: isize) -> isize {
    sayLaunch(compositor, program)
    var length: usize = 0
    while program[length] != 0 { length += 1 }
    var found: [1024]u8 = undefined
    var path: []const u8 = program[0..length]
    if !hasSlash(program) {
        const at = spawn_module.find(path, environment, "", &found, 1024)
        if at == 0 { return cannot(compositor, program, brix.Status.not_found, theirs) }
        path = found[0..at]
    }
    const opened = brix.open(0, path, brix.Open.READ, 0)
    if opened < 0 { return cannot(compositor, program, 0 - opened, theirs) }
    const node = @intCast(u32, opened)
    var arguments: [2][*]const u8 = undefined
    unsafe {
        arguments[0] = program
        arguments[1] = @ptrFromInt([*]const u8, 0)
    }
    var handles: [6]u32 = undefined
    var roles: [6]brix.RoleRecord = undefined
    handles[0] = brix.ofDescriptor(0)
    handles[1] = brix.ofDescriptor(1)
    handles[2] = brix.ofDescriptor(2)
    roles[0] = brix.RoleRecord.{ .role = brix.Role.INPUT, .handle = handles[0] }
    roles[1] = brix.RoleRecord.{ .role = brix.Role.OUTPUT, .handle = handles[1] }
    roles[2] = brix.RoleRecord.{ .role = brix.Role.ERRORS, .handle = handles[2] }
    var count: usize = 3
    const session = brix.handleFor(brix.Role.SESSION)
    if session != 0 {
        handles[count] = session
        roles[count] = brix.RoleRecord.{ .role = brix.Role.SESSION, .handle = session }
        count += 1
    }
    if theirs >= 0 {
        handles[count] = @intCast(u32, theirs)
        roles[count] = brix.RoleRecord.{ .role = brix.Role.OWN, .handle = @intCast(u32, theirs) }
        count += 1
    }
    const begin = brix.Start.{ .arguments = @intFromPtr(&arguments), .environment = @intFromPtr(environment), .roles = @intFromPtr(&roles), .count = count }
    const spawned = brix.spawn(node, &begin, handles[0..count])
    _ = brix.close(node)
    if spawned < 0 { return cannot(compositor, program, 0 - spawned, theirs) }
    if theirs >= 0 { _ = brix.close(@intCast(u32, theirs)) }
    if childCount < MAX_CHILDREN {
        children[childCount] = spawned
        childCount += 1
    }
    return spawned
}

fn cannot(compositor: *shell.Compositor, program: [*]const u8, status: isize, theirs: isize) -> isize {
    _ = compositor
    if theirs >= 0 { _ = brix.close(@intCast(u32, theirs)) }
    state.say("launch: cannot start ")
    var length: usize = 0
    while program[length] != 0 { length += 1 }
    _ = std.io.writeAllBytes(std.io.stdout(), program, length)
    state.say(" (status ")
    state.sayNumber(@bitCast(usize, status))
    state.say(")\n")
    return -1
}

pub fn sayLaunch(compositor: *shell.Compositor, program: [*]const u8) -> void {
    if !compositor.*.verbose { return }
    state.say("launch: ")
    var length: usize = 0
    while program[length] != 0 { length += 1 }
    _ = std.io.writeAllBytes(std.io.stdout(), program, length)
    state.say("\n")
}

// One byte to a helper as a message; false when it is gone (a full
// queue means busy, not gone).
pub fn tell(channel: isize, byte: u8) -> bool {
    var bytes: [1]u8 = [1]u8{ byte }
    var handles: [1]u32 = undefined
    const sent = brix.send(@intCast(u32, channel), bytes[0..1], handles[0..0])
    return sent == 0 || sent == -brix.Status.would_block
}

// Bytes to a helper as one message; whether they were taken (false: it is
// gone, or its queue is full and it gets them on a later turn).
pub fn send(channel: isize, bytes: [*]const u8, length: usize) -> bool {
    var handles: [1]u32 = undefined
    return brix.send(@intCast(u32, channel), bytes[0..length], handles[0..0]) == 0
}

// What a helper sent: the oldest message's bytes (0: it is gone; -11:
// nothing now; a message longer than `capacity` is cut to it).
pub fn receive(channel: isize, into: [*]u8, capacity: usize) -> isize {
    var handles: [4]u32 = undefined
    var sizes: [2]u32 = [2]u32{ 0, 0 }
    const got = brix.receive(@intCast(u32, channel), into[0..capacity], handles[0..4], &sizes)
    if got == -brix.Status.would_block { return -11 }
    if got == -brix.Status.too_large {
        // Taken with a bigger buffer, the first `capacity` kept.
        var big: [1024]u8 = undefined
        if brix.receive(@intCast(u32, channel), big[0..1024], handles[0..4], &sizes) < 0 { return 0 }
        var index: usize = 0
        while index < capacity {
            into[index] = big[index]
            index += 1
        }
        return @intCast(isize, capacity)
    }
    if got < 0 { return 0 }
    var k: usize = 0
    while k < @intCast(usize, sizes[1]) {
        _ = brix.close(handles[k])
        k += 1
    }
    return @intCast(isize, sizes[0])
}

pub fn closeChannel(channel: isize) -> void {
    if channel >= 0 { _ = brix.close(@intCast(u32, channel)) }
}

// The next child that ended (its handle closed), or 0.
pub fn reap() -> isize {
    var index: usize = 0
    while index < childCount {
        const child = spawn_module.Child.{ .id = children[index], .handle = true }
        var ending: spawn_module.Ending = undefined
        if spawn_module.ended(child, &ending) {
            const id = children[index]
            childCount -= 1
            children[index] = children[childCount]
            return id
        }
        index += 1
    }
    return 0
}

pub fn kill(pid: isize) -> void {
    if pid > 0 { _ = spawn_module.kill(spawn_module.Child.{ .id = pid, .handle = true }) }
}
