// The question after the display's mode changed while the compositor
// runs (brixOS: a mode the settings program asked for, or one anybody
// asked the kernel for): on the new picture itself, drawn by the
// compositor and answered to it, so it needs no client to be alive:
//
//     Keep this display mode?
//     1920 × 1080 at 60 Hz. It goes back in 12 s.
//                                   [ Go back ]  [ Keep ]
//
// A card in the middle of the screen in the desktop's look (the colours
// of the window previews' panel and the accent the desktop takes from its
// background), the rest of the screen dimmed. Enter or Keep keeps the
// mode; Escape or Go back brings the mode before back; the keys go to the
// question alone while it is shown, and a click goes to it alone. No
// answer: when the seconds are up the kernel brings the mode before back
// by itself, and the compositor follows that like any change.
//
// What it says and where its parts are is worked out here without
// drawing (tests/491_desktop_mode_change_runtime.mlx holds it); the
// backend (drm.brixos.mlx) shows it, counts the seconds down and carries
// the answer out (state.Question.answer).
const std = @import("std")
const ui = @import("std.ui")
const tt = @import("std.truetype")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")

const Compositor = state.Compositor
const Question = state.Question

// The card's size and the buttons' (pixels), its rounding, the gaps.
pub const CARD_WIDTH: i32 = 440
pub const CARD_HEIGHT: i32 = 132
pub const BUTTON_WIDTH: i32 = 112
pub const BUTTON_HEIGHT: i32 = 30
const RADIUS: i32 = 14
const BUTTON_RADIUS: i32 = 8
const PADDING: i32 = 22
const GAP: i32 = 10

// The colours: the card as the window previews' panel, the text, the
// other button, and how dark the screen around it gets (premultiplied
// black at this alpha).
const CARD_COLOR: u32 = 2105392
const TEXT_COLOR: u32 = 4294967295
const DIM_TEXT_COLOR: u32 = 4290295992
const BUTTON_COLOR: u32 = 3816528
const BUTTON_HOVER_COLOR: u32 = 5000292
const DIM_ALPHA: u32 = 112

// evdev's key codes the question takes.
const KEY_ESC: u32 = 1
const KEY_ENTER: u32 = 28
const KEY_KP_ENTER: u32 = 96
// The pointer's first button (evdev's BTN_LEFT).
const BTN_LEFT: u32 = 272

// The card on a screen of `width` by `height`: in the middle, made
// narrower on a screen narrower than it.
pub fn card(width: usize, height: usize) -> ui.Rect {
    const across = if @intCast(i32, width) - 32 < CARD_WIDTH { @intCast(i32, width) - 32 } else { CARD_WIDTH }
    return ui.rect((@intCast(i32, width) - across) / 2, (@intCast(i32, height) - CARD_HEIGHT) / 2, across, CARD_HEIGHT)
}

// The buttons on the card: Keep at its right, Go back left of it.
pub fn keepButton(width: usize, height: usize) -> ui.Rect {
    const box = card(width, height)
    return ui.rect(box.x + box.width - PADDING - BUTTON_WIDTH, box.y + box.height - PADDING + 4 - BUTTON_HEIGHT, BUTTON_WIDTH, BUTTON_HEIGHT)
}

pub fn backButton(width: usize, height: usize) -> ui.Rect {
    const keep = keepButton(width, height)
    return ui.rect(keep.x - GAP - BUTTON_WIDTH, keep.y, BUTTON_WIDTH, BUTTON_HEIGHT)
}

// The button at (x, y): QUESTION_KEEP, QUESTION_BACK, 0 for none.
pub fn buttonAt(width: usize, height: usize, x: i32, y: i32) -> u8 {
    if ui.contains(keepButton(width, height), x, y) { return state.QUESTION_KEEP }
    if ui.contains(backButton(width, height), x, y) { return state.QUESTION_BACK }
    return 0
}

// The whole seconds until `deadline` from `now` (microseconds), counted
// up: 12 while between 11 and 12 are left; 0 once it has come.
pub fn secondsLeft(deadline: usize, now: usize) -> usize {
    if now >= deadline { return 0 }
    return (deadline - now + 999999) / 1000000
}

fn put(out: [*]u8, at: usize, text: []const u8) -> usize { return std.text.append(out, at, at + text.length, text) }

fn putNumber(out: [*]u8, at: usize, value: usize) -> usize { return std.text.appendUnsigned(out, at, at + 20, value) }

// "60 Hz", or with hundredths where the rate has them ("59.94 Hz").
fn putRate(out: [*]u8, at: usize, millihertz: usize) -> usize {
    // (Cut at the hundredths, as the kernel and its `display` tool say it.)
    const hundredths = millihertz / 10
    var length = putNumber(out, at, hundredths / 100)
    const rest = hundredths % 100
    if rest != 0 {
        out[length] = 46
        out[length + 1] = @intCast(u8, 48 + rest / 10)
        length += 2
        if rest % 10 != 0 {
            out[length] = @intCast(u8, 48 + rest % 10)
            length += 1
        }
    }
    return put(out, length, " Hz")
}

// The question's heading.
pub fn heading(german: bool) -> []const u8 {
    return if german { "Diesen Anzeigemodus behalten?" } else { "Keep this display mode?" }
}

// The line under it: the mode and the seconds left ("1920 × 1080 at 60
// Hz. It goes back in 12 s."), into `out` (at least 96 bytes); its
// length.
pub fn line(question: *const Question, seconds: usize, german: bool, out: [*]u8) -> usize {
    var length = putNumber(out, 0, question.*.width)
    length = put(out, length, " × ")
    length = putNumber(out, length, question.*.height)
    if question.*.millihertz != 0 {
        length = put(out, length, if german { " mit " } else { " at " })
        length = putRate(out, length, question.*.millihertz)
    }
    length = put(out, length, if german { ". Zurück in " } else { ". It goes back in " })
    length = putNumber(out, length, seconds)
    return put(out, length, " s.")
}

pub fn keepLabel(german: bool) -> []const u8 { return if german { "Behalten" } else { "Keep" } }

pub fn backLabel(german: bool) -> []const u8 { return if german { "Zurück" } else { "Go back" } }

// ---------------------------------------------------------------------------
// Shown, counted down, hidden

// The question is shown for `width` by `height` at `millihertz`, which
// the kernel takes back `left` nanoseconds from now unless kept.
pub fn show(compositor: *Compositor, width: usize, height: usize, millihertz: usize, left: usize, german: bool) -> void {
    const question = &compositor.*.question
    const was = question.*.shown
    question.*.shown = true
    question.*.width = width
    question.*.height = height
    question.*.millihertz = millihertz
    question.*.deadline = state.microseconds() + left / 1000
    question.*.seconds = secondsLeft(question.*.deadline, state.microseconds())
    question.*.german = german
    question.*.answer = 0
    question.*.pressed = 0
    question.*.hover = buttonAt(compositor.*.width, compositor.*.height, compositor.*.pointerX, compositor.*.pointerY)
    // The whole screen: it is dimmed around the card.
    if !was { scene.damageAll(compositor) } else { damageCard(compositor) }
}

pub fn hide(compositor: *Compositor) -> void {
    if !compositor.*.question.shown { return }
    compositor.*.question.shown = false
    compositor.*.question.answer = 0
    scene.damageAll(compositor)
}

fn damageCard(compositor: *Compositor) -> void { scene.damageRect(compositor, card(compositor.*.width, compositor.*.height)) }

// Whether the seconds the card says are other ones now (it is drawn
// again then); call at every turn while it is shown.
pub fn tick(compositor: *Compositor) -> void {
    const question = &compositor.*.question
    if !question.*.shown { return }
    const seconds = secondsLeft(question.*.deadline, state.microseconds())
    if seconds == question.*.seconds { return }
    question.*.seconds = seconds
    damageCard(compositor)
}

// ---------------------------------------------------------------------------
// Keys and the pointer

// A key while the question is shown: Enter keeps, Escape goes back, any
// other is held from the windows. A key's release goes where its press
// went: the question's when it took the press (also once it is gone), the
// windows' when the key was held before the question came up (the client
// that has the press repeats the key until it sees it let go). False: the
// windows have it.
pub fn key(compositor: *Compositor, code: u32, pressed: bool) -> bool {
    const question = &compositor.*.question
    const word = @intCast(usize, code / 32)
    const bit = @intCast(u32, 1) << @intCast(u5, code % 32)
    if !pressed {
        if code >= state.QUESTION_KEYS || question.*.keysTaken[word] & bit == 0 { return false }
        question.*.keysTaken[word] = question.*.keysTaken[word] & (4294967295 ^ bit)
        return true
    }
    if !question.*.shown { return false }
    if code < state.QUESTION_KEYS { question.*.keysTaken[word] = question.*.keysTaken[word] | bit }
    if code == KEY_ENTER || code == KEY_KP_ENTER { question.*.answer = state.QUESTION_KEEP }
    if code == KEY_ESC { question.*.answer = state.QUESTION_BACK }
    return true
}

// The pointer moved to (x, y): the button under it lights up.
pub fn motion(compositor: *Compositor, x: i32, y: i32) -> void {
    const question = &compositor.*.question
    if !question.*.shown { return }
    const over = buttonAt(compositor.*.width, compositor.*.height, x, y)
    if over == question.*.hover { return }
    question.*.hover = over
    damageCard(compositor)
}

// A button of the pointer (evdev's code, `button`): a press and release
// on the same button of the card answers; every press is held from the
// windows while the question is shown, and so is its release. A button
// held before the question came up is let go to the windows: what its
// press began (a window moved or resized, a drag, a client's press) ends.
// False: the windows have it.
pub fn button(compositor: *Compositor, button: u32, x: i32, y: i32, pressed: bool) -> bool {
    const question = &compositor.*.question
    const bit = if button >= BTN_LEFT && button < BTN_LEFT + 32 { @intCast(u32, 1) << @intCast(u5, button - BTN_LEFT) } else { 0 }
    if !pressed {
        if bit == 0 || question.*.buttonsTaken & bit == 0 { return false }
        question.*.buttonsTaken = question.*.buttonsTaken & (4294967295 ^ bit)
        if !question.*.shown { return true }
        const over = buttonAt(compositor.*.width, compositor.*.height, x, y)
        if over != 0 && over == question.*.pressed { question.*.answer = over }
        question.*.pressed = 0
        damageCard(compositor)
        return true
    }
    if !question.*.shown { return false }
    question.*.buttonsTaken = question.*.buttonsTaken | bit
    question.*.pressed = buttonAt(compositor.*.width, compositor.*.height, x, y)
    damageCard(compositor)
    return true
}

// ---------------------------------------------------------------------------
// Drawing (on the CPU: scene.composeWith calls it after the windows)

// `text` laid out into compositor.run; its width (0: nothing to draw).
fn layOut(compositor: *Compositor, text: []const u8) -> i32 {
    if !compositor.*.hasText || text.length == 0 { return 0 }
    const run = compositor.*.run
    tt.layoutBytes(compositor.*.atlas, text.pointer, text.length, run)
    if run.*.count == 0 { return 0 }
    var index: usize = 0
    while index < run.*.count {
        const quad = run.*.quads[index]
        const right = quad.x + @intCast(i32, quad.width)
        const bottom = quad.y + @intCast(i32, quad.height)
        if index == 0 || quad.x < run.*.left { run.*.left = quad.x }
        if index == 0 || quad.y < run.*.top { run.*.top = quad.y }
        if index == 0 || right > run.*.right { run.*.right = right }
        if index == 0 || bottom > run.*.bottom { run.*.bottom = bottom }
        index += 1
    }
    return run.*.right
}

// The run laid out last, its pen at (x, y: the baseline), in `color`.
fn drawText(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, x: i32, y: i32, color: u32) -> void {
    const words: [*]u32 = unsafe { @ptrFromInt([*]u32, @intFromPtr(pixels) + (@intCast(usize, clip.y) * compositor.*.width + @intCast(usize, clip.x)) * 4) }
    tt.drawRun(compositor.*.atlas, compositor.*.run, words, @intCast(usize, clip.width), @intCast(usize, clip.height), compositor.*.width, x - clip.x, y - clip.y, color, 0)
}

fn rounded(box: ui.Rect, radius: i32) -> scene.Shape {
    return scene.Shape.{ .x = box.x, .y = box.y, .width = box.width, .height = box.height, .top = radius, .bottom = radius }
}

fn drawButton(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect, box: ui.Rect, label: []const u8, color: u32) -> void {
    const shape = rounded(box, BUTTON_RADIUS)
    scene.fillShape(compositor, pixels, clip, &shape, color)
    const across = layOut(compositor, label)
    if across > 0 { drawText(compositor, pixels, clip, box.x + (box.width - across) / 2, box.y + box.height / 2 + 5, TEXT_COLOR) }
}

// The screen around the card darkened.
fn dim(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect) -> void {
    const target: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    var row = clip.y
    while row < ui.bottom(clip) {
        const line = @intCast(usize, row) * compositor.*.width
        var column = clip.x
        while column < ui.right(clip) {
            const at = line + @intCast(usize, column)
            target[at] = scene.blendPixel(target[at], 0, DIM_ALPHA)
            column += 1
        }
        row += 1
    }
}

pub fn draw(compositor: *Compositor, pixels: [*]u8, clip: ui.Rect) -> void {
    const question = &compositor.*.question
    if !question.*.shown { return }
    dim(compositor, pixels, clip)
    const box = card(compositor.*.width, compositor.*.height)
    if ui.isEmpty(ui.intersect(box, clip)) { return }
    const shape = rounded(box, RADIUS)
    scene.fillShape(compositor, pixels, clip, &shape, CARD_COLOR)
    // The prism's line along the card's top, as the focused window's bar
    // has it: here the accent alone.
    const accent = scene.accentColor(compositor)
    const stripe = rounded(ui.rect(box.x + RADIUS, box.y, box.width - 2 * RADIUS, 3), 1)
    scene.fillShape(compositor, pixels, clip, &stripe, accent & 16777215)
    if layOut(compositor, heading(question.*.german)) > 0 { drawText(compositor, pixels, clip, box.x + PADDING, box.y + PADDING + 14, TEXT_COLOR) }
    var text: [128]u8 = undefined
    const bytes: [*]u8 = &text
    const length = line(question, question.*.seconds, question.*.german, bytes)
    if layOut(compositor, bytes[0..length]) > 0 { drawText(compositor, pixels, clip, box.x + PADDING, box.y + PADDING + 42, DIM_TEXT_COLOR) }
    const keep = keepButton(compositor.*.width, compositor.*.height)
    const back = backButton(compositor.*.width, compositor.*.height)
    drawButton(compositor, pixels, clip, back, backLabel(question.*.german), if question.*.hover == state.QUESTION_BACK { BUTTON_HOVER_COLOR } else { BUTTON_COLOR })
    drawButton(compositor, pixels, clip, keep, keepLabel(question.*.german), accent & 16777215)
}
