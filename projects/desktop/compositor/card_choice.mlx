// The compositor's choice at start on brixOS between the card and the
// processor (card.brixos.mlx), worked out apart from the compositor so
// that the host's tests run it (tests/518): the first frame composed on
// the card held against the processor's, pixel for pixel, and the one
// line of the log that says which composes and why.
const std = @import("std")

// How two frames differ: how many pixels, the first one's place (its
// index in the frame).
pub const Check = struct {
    differ: usize
    first: usize
}

pub fn compare(theirs: [*]const u32, ours: [*]const u32, count: usize) -> Check {
    var check = Check.{ .differ = 0, .first = 0 }
    var k: usize = 0
    while k < count {
        if theirs[k] != ours[k] {
            if check.differ == 0 { check.first = k }
            check.differ += 1
        }
        k += 1
    }
    return check
}

// What the choice came to: the card; no device of our driver at all; a
// device found but refused (`why`: the driver's or std.gpu's words); one
// that opens but the renderer does not start on; one whose first frame
// could not be composed, or is not the processor's.
pub const Outcome = enum(u8) { card, no_device, refused, no_renderer, not_composed, differs }

// A line of the log, made here and said in one write.
pub const LINE_BYTES: usize = 320
pub const Line = struct {
    bytes: [320]u8
    length: usize
}

fn put(line: *Line, text: []const u8) -> void {
    const bytes: [*]u8 = &line.*.bytes
    line.*.length = std.text.append(bytes, line.*.length, LINE_BYTES, text)
}

fn number(line: *Line, value: usize) -> void {
    const bytes: [*]u8 = &line.*.bytes
    line.*.length = std.text.appendUnsigned(bytes, line.*.length, LINE_BYTES, value)
}

// The line for `outcome`: the device's name, the frame's size, how the
// first frame differed, why the device was refused.
pub fn say(line: *Line, outcome: Outcome, name: []const u8, width: usize, height: usize, check: Check, why: []const u8) -> void {
    line.*.length = 0
    if outcome == Outcome.no_device {
        put(line, "renderer: no Vulkan device (no graphics card our driver serves); composing on the processor\n")
        return
    }
    put(line, "renderer: the Vulkan device ")
    put(line, name)
    if outcome == Outcome.card {
        put(line, " composes the desktop: its self-test and the first frame's check passed (")
        number(line, width)
        put(line, "x")
        number(line, height)
        put(line, ", the same as the processor's, pixel for pixel); frames reach the screen by copy through a readback buffer\n")
    } else if outcome == Outcome.refused {
        put(line, " is found; ")
        put(line, why)
        put(line, ": composing on the processor\n")
    } else if outcome == Outcome.no_renderer {
        put(line, " opens, but the Vulkan renderer does not start on it (the line before says why): composing on the processor\n")
    } else if outcome == Outcome.not_composed {
        put(line, " opens, but its first frame could not be composed on it: composing on the processor\n")
    } else {
        put(line, " opens, but its first frame is not the processor's: ")
        number(line, check.differ)
        put(line, " pixels differ, the first at ")
        number(line, if width == 0 { 0 } else { check.first % width })
        put(line, ",")
        number(line, if width == 0 { 0 } else { check.first / width })
        put(line, ": composing on the processor\n")
    }
}

pub fn text(line: *const Line) -> []const u8 { return line.*.bytes[0..line.*.length] }
