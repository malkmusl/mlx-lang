// The monitor, through the kernel's DRM/KMS interface (legacy modesetting
// with dumb buffers), for the DRM backend.
//
// open() finds the first connected connector, takes its preferred mode (or
// the one asked for: wantWidth, wantHeight, wantHertz) and a CRTC that can
// drive it, remembers what that CRTC showed and its gamma table (to restore
// them on exit), and makes two XRGB8888 dumb buffers, mapped for drawing.
// The compositor draws a frame into the back buffer and flips to it with
// DRM_IOCTL_MODE_PAGE_FLIP; the flip-complete event (read from the card)
// says the frame is on screen, which paces frame callbacks to the
// monitor's refresh. After a VT switch the CRTC is set up again (modeset).
// A dumb buffer can be handed out as a dma-buf (exportBuffer, PRIME) for a
// GPU to render into it in place. Night light (setTemperature) scales the
// CRTC's gamma table toward a warmer white: the monitor shows it, every
// frame and screenshot stays as composed, and it costs nothing per frame.
//
// Structure layouts and ioctl numbers are those of <drm/drm_mode.h> on
// 64-bit Linux.

const std = @import("std")
const device = @import("./device.mlx")

const Allocator = std.allocator.Allocator

const SET_MASTER: usize = 25630
const DROP_MASTER: usize = 25631
const GET_CAP: usize = 3222299660
const GETRESOURCES: usize = 3225445536
const GETCONNECTOR: usize = 3226494119
const GETENCODER: usize = 3222561958
const GETCRTC: usize = 3228066977
const SETCRTC: usize = 3228066978
const CREATE_DUMB: usize = 3223348402
const MAP_DUMB: usize = 3222299827
const DESTROY_DUMB: usize = 3221513396
const ADDFB: usize = 3223086254
const RMFB: usize = 3221513391
const PAGE_FLIP: usize = 3222824112
const PRIME_HANDLE_TO_FD: usize = 3222037549
const PRIME_FD_TO_HANDLE: usize = 3222037550
const GEM_CLOSE: usize = 1074291721
const GETGAMMA: usize = 3223348388
const SETGAMMA: usize = 3223348389
const PRIME_CLOEXEC: u32 = 2147483648
const PRIME_RDWR: u32 = 2

const CAP_DUMB_BUFFER: usize = 1
const PAGE_FLIP_EVENT: u32 = 1
const EVENT_FLIP_COMPLETE: u32 = 2
const MODE_TYPE_PREFERRED: u32 = 8
const MODE_FLAG_INTERLACE: u32 = 16
const MODE_FLAG_DOUBLESCAN: u32 = 32
const CONNECTED: u32 = 1
const MODE_SIZE: usize = 68
const CRTC_SIZE: usize = 104
const LUT_SIZE: usize = 32
// The most modes listed for the settings app, the largest gamma table
// taken.
pub const MAX_MODES: usize = 32
const MAX_GAMMA: u32 = 4096
// Night light's white at this temperature is the monitor's own (Kelvin).
pub const NEUTRAL: u32 = 6500

pub const Output = struct {
    card: device.Device
    connector: u32
    // The connector's kind (DRM_MODE_CONNECTOR_*) and number within it:
    // HDMI-A-1, DP-2.
    connectorType: u32
    connectorTypeId: u32
    crtc: u32
    mode: [68]u8
    width: usize
    height: usize
    refresh: u32
    // The highest refresh rate (Hz) to pick (0: no limit); set before
    // probe and open.
    maxRefresh: u32
    // The mode to take, set before probe and open (wantWidth 0: the
    // native one at the highest refresh rate; wantHertz 0: the fastest of
    // that size); wantFound: the connector had it.
    wantWidth: u32
    wantHeight: u32
    wantHertz: u32
    wantFound: bool
    // The mode's refresh rate in millihertz.
    millihertz: u32
    // The connector's progressive modes (pixels, Hz), each once, as the
    // kernel lists them.
    modeCount: usize
    modeWidths: [32]u32
    modeHeights: [32]u32
    modeHertz: [32]u32
    // The CRTC's gamma table: its entries per colour (0: it has none),
    // what it held before us and the one we set (red, then green, then
    // blue: gammaSize u16 each), and the night light's temperature in it
    // (Kelvin; 0: ours untouched).
    gammaSize: u32
    gammaSaved: usize
    gammaRamp: usize
    temperature: u32
    // The two dumb buffers: kernel handle, framebuffer, row pitch, size
    // and our mapping.
    handles: [2]u32
    framebuffers: [2]u32
    pitches: [2]usize
    sizes: [2]usize
    addresses: [2]usize
    // Zero copy: two buffers of the GPU's (dma-bufs it exported) as
    // framebuffers, kernel handle and framebuffer each; shown instead of
    // the dumb buffers while `scanout` is set.
    scanoutHandles: [2]u32
    scanoutFramebuffers: [2]u32
    scanout: bool
    // The buffer to draw the next frame into.
    back: usize
    flipPending: bool
    // The card's events being read (readEvents). A local there would stay
    // allocated for every frame.
    events: [1024]u8
    // The CRTC as it was before us (struct drm_mode_crtc).
    saved: [104]u8
    // The CRTC has to be set up (first frame, after a VT switch).
    needsModeset: bool
    // The negative errno of the last ioctl that failed (0: none).
    lastError: isize
}

fn bytesOf(output: *Output, field: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(output) + field) }
}

fn modeOf(output: *Output) -> [*]u8 { return bytesOf(output, @offsetOf(Output, "mode")) }
fn savedOf(output: *Output) -> [*]u8 { return bytesOf(output, @offsetOf(Output, "saved")) }

fn cardOf(output: *Output) -> *device.Device {
    unsafe { return @ptrFromInt(*device.Device, @intFromPtr(output) + @offsetOf(Output, "card")) }
}

fn call(output: *Output, request: usize, argument: [*]u8, size: usize) -> bool {
    const result = device.ioctl(cardOf(output), request, argument, size)
    if result < 0 { output.*.lastError = result }
    return result >= 0
}

// The errno of the last ioctl that failed, as a positive number.
pub fn lastError(output: *const Output) -> usize {
    if output.*.lastError >= 0 { return 0 }
    return @intCast(usize, 0 - output.*.lastError)
}

fn allocateWords(allocator: Allocator, count: usize) -> [*]u8 {
    const size = if count == 0 { 8 } else { count * 4 }
    return allocator.alloc(size, 8).?
}

// Picks the CRTC for `connector`: its current encoder's, else the first
// one an encoder of it can drive. 0 when none.
fn pickCrtc(output: *Output, connector: [*]u8, encoders: [*]u8, encoder_count: usize, crtcs: [*]u8, crtc_count: usize) -> u32 {
    var encoder: [20]u8 = undefined
    var encoder_bytes: [*]u8 = undefined
    unsafe { encoder_bytes = @ptrCast([*]u8, &encoder) }
    const current = device.load32(connector, 44)
    if current != 0 {
        device.zero(encoder_bytes, 20)
        device.store32(encoder_bytes, 0, current)
        if call(output, GETENCODER, encoder_bytes, 20) && device.load32(encoder_bytes, 8) != 0 { return device.load32(encoder_bytes, 8) }
    }
    var index: usize = 0
    while index < encoder_count {
        device.zero(encoder_bytes, 20)
        device.store32(encoder_bytes, 0, device.load32(encoders, index * 4))
        if call(output, GETENCODER, encoder_bytes, 20) {
            const possible = device.load32(encoder_bytes, 12)
            var crtc: usize = 0
            while crtc < crtc_count && crtc < 32 {
                if possible & (@intCast(u32, 1) << @intCast(u32, crtc)) != 0 { return device.load32(crtcs, crtc * 4) }
                crtc += 1
            }
        }
        index += 1
    }
    return 0
}

// A mode's refresh rate in millihertz, from its pixel clock (kHz) and
// totals (the vrefresh field is rounded).
fn modeMillihertz(modes: [*]const u8, index: usize) -> usize {
    const at = index * MODE_SIZE
    const clock = @intCast(usize, device.load32(modes, at))
    const htotal = @intCast(usize, device.load16(modes, at + 10))
    const vtotal = @intCast(usize, device.load16(modes, at + 20))
    if htotal == 0 || vtotal == 0 { return @intCast(usize, device.load32(modes, at + 24)) * 1000 }
    var rate = clock * 1000000 / (htotal * vtotal)
    // Interlaced modes show half the frames; double scan twice the lines.
    const flags = device.load32(modes, at + 28)
    if flags & MODE_FLAG_INTERLACE != 0 { rate = rate * 2 }
    if flags & MODE_FLAG_DOUBLESCAN != 0 { rate = rate / 2 }
    return rate
}

// Among the modes with the resolution of mode `preferred` (the monitor's
// native one), the one with the highest refresh rate up to `limit` Hz (0:
// any), progressive only: monitors mark a 60 Hz mode preferred even when
// they run at 144 Hz.
fn fastestMode(modes: [*]const u8, count: usize, preferred: usize, limit: u32) -> usize {
    const width = device.load16(modes, preferred * MODE_SIZE + 4)
    const height = device.load16(modes, preferred * MODE_SIZE + 14)
    var chosen = preferred
    var best_hertz: u32 = 0
    var best_rate: usize = 0
    var index: usize = 0
    while index < count {
        const at = index * MODE_SIZE
        const flags = device.load32(modes, at + 28)
        // The kernel's rounded rate first, the exact one between equals.
        const hertz = device.load32(modes, at + 24)
        const rate = modeMillihertz(modes, index)
        const allowed = limit == 0 || hertz <= limit
        const faster = hertz > best_hertz || (hertz == best_hertz && rate > best_rate)
        if device.load16(modes, at + 4) == width && device.load16(modes, at + 14) == height && flags & (MODE_FLAG_INTERLACE | MODE_FLAG_DOUBLESCAN) == 0 && allowed && faster {
            chosen = index
            best_hertz = hertz
            best_rate = rate
        }
        index += 1
    }
    return chosen
}

// The progressive mode of the size asked for (wantWidth, wantHeight) at
// wantHertz (the kernel's rounded rate; 0: any), the fastest of those;
// `count` when there is none.
fn wantedMode(output: *Output, modes: [*]const u8, count: usize) -> usize {
    var chosen = count
    var best_rate: usize = 0
    var index: usize = 0
    while index < count {
        const at = index * MODE_SIZE
        const progressive = device.load32(modes, at + 28) & (MODE_FLAG_INTERLACE | MODE_FLAG_DOUBLESCAN) == 0
        const sized = device.load16(modes, at + 4) == output.*.wantWidth && device.load16(modes, at + 14) == output.*.wantHeight
        const hertz = device.load32(modes, at + 24)
        const rate = modeMillihertz(modes, index)
        if progressive && sized && (output.*.wantHertz == 0 || hertz == output.*.wantHertz) && (chosen == count || rate > best_rate) {
            chosen = index
            best_rate = rate
        }
        index += 1
    }
    return chosen
}

// The connector's progressive modes into output.modeWidths, modeHeights,
// modeHertz, each size and rate once.
fn listModes(output: *Output, modes: [*]const u8, count: usize) -> void {
    output.*.modeCount = 0
    var index: usize = 0
    while index < count && output.*.modeCount < MAX_MODES {
        const at = index * MODE_SIZE
        const width = device.load16(modes, at + 4)
        const height = device.load16(modes, at + 14)
        const hertz = device.load32(modes, at + 24)
        var known = device.load32(modes, at + 28) & (MODE_FLAG_INTERLACE | MODE_FLAG_DOUBLESCAN) != 0
        var other: usize = 0
        while other < output.*.modeCount && !known {
            known = output.*.modeWidths[other] == width && output.*.modeHeights[other] == height && output.*.modeHertz[other] == hertz
            other += 1
        }
        if !known {
            output.*.modeWidths[output.*.modeCount] = width
            output.*.modeHeights[output.*.modeCount] = height
            output.*.modeHertz[output.*.modeCount] = hertz
            output.*.modeCount += 1
        }
        index += 1
    }
}

// Looks at one connector: when it is connected and a CRTC can drive it,
// takes it at its native resolution with the highest refresh rate (see
// fastestMode), or at the mode asked for when it has it. True when taken.
fn tryConnector(output: *Output, allocator: Allocator, id: u32, crtcs: [*]u8, crtc_count: usize) -> bool {
    var connector: [80]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &connector) }
    device.zero(bytes, 80)
    device.store32(bytes, 48, id)
    if !call(output, GETCONNECTOR, bytes, 80) { return false }
    const mode_count = @intCast(usize, device.load32(bytes, 32))
    const encoder_count = @intCast(usize, device.load32(bytes, 40))
    if device.load32(bytes, 60) != CONNECTED || mode_count == 0 { return false }
    const modes = allocator.alloc(mode_count * MODE_SIZE, 8).?
    const encoders = allocateWords(allocator, encoder_count)
    device.store64(bytes, 0, @intFromPtr(encoders))
    device.store64(bytes, 8, @intFromPtr(modes))
    device.store64(bytes, 16, 0)
    device.store64(bytes, 24, 0)
    device.store32(bytes, 36, 0)
    var taken = false
    if call(output, GETCONNECTOR, bytes, 80) {
        // The kernel reports how many it wrote (no more than we had room for).
        var count = @intCast(usize, device.load32(bytes, 32))
        if count > mode_count { count = mode_count }
        var chosen: usize = 0
        var index: usize = 0
        while index < count {
            if device.load32(modes, index * MODE_SIZE + 32) & MODE_TYPE_PREFERRED != 0 {
                chosen = index
                break
            }
            index += 1
        }
        chosen = fastestMode(modes, count, chosen, output.*.maxRefresh)
        output.*.wantFound = false
        if output.*.wantWidth != 0 {
            const wanted = wantedMode(output, modes, count)
            if wanted < count {
                chosen = wanted
                output.*.wantFound = true
            }
        }
        listModes(output, modes, count)
        var usable_encoders = @intCast(usize, device.load32(bytes, 40))
        if usable_encoders > encoder_count { usable_encoders = encoder_count }
        const crtc = pickCrtc(output, bytes, encoders, usable_encoders, crtcs, crtc_count)
        if count > 0 && crtc != 0 {
            const mode = modeOf(output)
            index = 0
            while index < MODE_SIZE {
                mode[index] = modes[chosen * MODE_SIZE + index]
                index += 1
            }
            output.*.connector = id
            output.*.connectorType = device.load32(bytes, 52)
            output.*.connectorTypeId = device.load32(bytes, 56)
            output.*.crtc = crtc
            output.*.width = @intCast(usize, device.load16(modes, chosen * MODE_SIZE + 4))
            output.*.height = @intCast(usize, device.load16(modes, chosen * MODE_SIZE + 14))
            output.*.refresh = device.load32(modes, chosen * MODE_SIZE + 24)
            output.*.millihertz = @intCast(u32, modeMillihertz(modes, chosen))
            taken = true
        }
    }
    allocator.free(modes, mode_count * MODE_SIZE, 8)
    allocator.free(encoders, if encoder_count == 0 { 8 } else { encoder_count * 4 }, 8)
    return taken
}

fn createBuffer(output: *Output, index: usize) -> bool {
    var create: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &create) }
    device.zero(bytes, 32)
    device.store32(bytes, 0, @intCast(u32, output.*.height))
    device.store32(bytes, 4, @intCast(u32, output.*.width))
    device.store32(bytes, 8, 32)
    if !call(output, CREATE_DUMB, bytes, 32) { return false }
    output.*.handles[index] = device.load32(bytes, 16)
    output.*.pitches[index] = @intCast(usize, device.load32(bytes, 20))
    output.*.sizes[index] = device.load64(bytes, 24)

    var framebuffer: [28]u8 = undefined
    var fb_bytes: [*]u8 = undefined
    unsafe { fb_bytes = @ptrCast([*]u8, &framebuffer) }
    device.zero(fb_bytes, 28)
    device.store32(fb_bytes, 4, @intCast(u32, output.*.width))
    device.store32(fb_bytes, 8, @intCast(u32, output.*.height))
    device.store32(fb_bytes, 12, @intCast(u32, output.*.pitches[index]))
    device.store32(fb_bytes, 16, 32)
    device.store32(fb_bytes, 20, 24)
    device.store32(fb_bytes, 24, output.*.handles[index])
    if !call(output, ADDFB, fb_bytes, 28) { return false }
    output.*.framebuffers[index] = device.load32(fb_bytes, 0)

    var map: [16]u8 = undefined
    var map_bytes: [*]u8 = undefined
    unsafe { map_bytes = @ptrCast([*]u8, &map) }
    device.zero(map_bytes, 16)
    device.store32(map_bytes, 0, output.*.handles[index])
    if !call(output, MAP_DUMB, map_bytes, 16) { return false }
    output.*.addresses[index] = device.mapBuffer(cardOf(output), device.load64(map_bytes, 8), output.*.sizes[index])
    return output.*.addresses[index] != 0
}

// Finds the first connected connector with a CRTC to drive it (into
// output.connector, mode, width, height, refresh). False when there is none.
fn findConnector(output: *Output, allocator: Allocator) -> bool {
    var resources: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &resources) }
    device.zero(bytes, 64)
    if !call(output, GETRESOURCES, bytes, 64) { return false }
    const crtc_count = @intCast(usize, device.load32(bytes, 36))
    const connector_count = @intCast(usize, device.load32(bytes, 40))
    const encoder_count = @intCast(usize, device.load32(bytes, 44))
    const crtcs = allocateWords(allocator, crtc_count)
    const connectors = allocateWords(allocator, connector_count)
    const encoders = allocateWords(allocator, encoder_count)
    device.zero(bytes, 64)
    device.store64(bytes, 8, @intFromPtr(crtcs))
    device.store64(bytes, 16, @intFromPtr(connectors))
    device.store64(bytes, 24, @intFromPtr(encoders))
    device.store32(bytes, 36, @intCast(u32, crtc_count))
    device.store32(bytes, 40, @intCast(u32, connector_count))
    device.store32(bytes, 44, @intCast(u32, encoder_count))
    var found = false
    if call(output, GETRESOURCES, bytes, 64) {
        var index: usize = 0
        while index < connector_count && !found {
            found = tryConnector(output, allocator, device.load32(connectors, index * 4), crtcs, crtc_count)
            index += 1
        }
    }
    allocator.free(crtcs, if crtc_count == 0 { 8 } else { crtc_count * 4 }, 8)
    allocator.free(connectors, if connector_count == 0 { 8 } else { connector_count * 4 }, 8)
    allocator.free(encoders, if encoder_count == 0 { 8 } else { encoder_count * 4 }, 8)
    return found
}

// Looks at the card `descriptor` without taking it: whether it has a
// connected monitor, and which (connector, width, height, refresh). The
// descriptor is closed either way.
pub fn probe(output: *Output, descriptor: isize, allocator: Allocator) -> bool {
    device.init(cardOf(output), descriptor, allocator)
    output.*.connector = 0
    output.*.lastError = 0
    const found = findConnector(output, allocator)
    device.deinit(cardOf(output), allocator)
    return found
}

// A connector kind's name (DRM_MODE_CONNECTOR_*).
fn connectorLabel(kind: u32) -> []const u8 {
    if kind == 1 { return "VGA" }
    if kind == 2 { return "DVI-I" }
    if kind == 3 { return "DVI-D" }
    if kind == 4 { return "DVI-A" }
    if kind == 5 { return "Composite" }
    if kind == 6 { return "SVIDEO" }
    if kind == 7 { return "LVDS" }
    if kind == 8 { return "Component" }
    if kind == 9 { return "DIN" }
    if kind == 10 { return "DP" }
    if kind == 11 { return "HDMI-A" }
    if kind == 12 { return "HDMI-B" }
    if kind == 13 { return "TV" }
    if kind == 14 { return "eDP" }
    if kind == 15 { return "Virtual" }
    if kind == 16 { return "DSI" }
    if kind == 17 { return "DPI" }
    if kind == 18 { return "Writeback" }
    if kind == 19 { return "SPI" }
    if kind == 20 { return "USB" }
    return "Unknown"
}

// The connector's name as DRM tools show it (HDMI-A-1, DP-2, eDP-1),
// written to `name` (at least 24 bytes); returns its length.
pub fn connectorName(output: *const Output, name: [*]u8) -> usize {
    const label = connectorLabel(output.*.connectorType)
    var length: usize = 0
    for byte in label {
        name[length] = byte
        length += 1
    }
    name[length] = 45
    length += 1
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = output.*.connectorTypeId
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        name[length] = digits[count]
        length += 1
    }
    return length
}

// Sets `output` up on the card `descriptor` (owned from now on). False
// when it has no connected monitor or cannot show buffers.
pub fn open(output: *Output, descriptor: isize, allocator: Allocator) -> bool {
    device.init(cardOf(output), descriptor, allocator)
    output.*.handles[0] = 0
    output.*.handles[1] = 0
    output.*.framebuffers[0] = 0
    output.*.framebuffers[1] = 0
    output.*.addresses[0] = 0
    output.*.addresses[1] = 0
    output.*.scanoutHandles[0] = 0
    output.*.scanoutHandles[1] = 0
    output.*.scanoutFramebuffers[0] = 0
    output.*.scanoutFramebuffers[1] = 0
    output.*.scanout = false
    output.*.back = 0
    output.*.flipPending = false
    output.*.needsModeset = true
    output.*.lastError = 0
    output.*.connector = 0
    output.*.gammaSize = 0
    output.*.gammaSaved = 0
    output.*.gammaRamp = 0
    output.*.temperature = 0
    // Without logind the first opener is DRM master already, or becomes it.
    var none: [8]u8 = undefined
    var none_bytes: [*]u8 = undefined
    unsafe { none_bytes = @ptrCast([*]u8, &none) }
    const master = device.ioctl(cardOf(output), SET_MASTER, none_bytes, 0)

    var capability: [16]u8 = undefined
    var capability_bytes: [*]u8 = undefined
    unsafe { capability_bytes = @ptrCast([*]u8, &capability) }
    device.zero(capability_bytes, 16)
    device.store64(capability_bytes, 0, CAP_DUMB_BUFFER)
    if !call(output, GET_CAP, capability_bytes, 16) || device.load64(capability_bytes, 8) == 0 { return false }

    if !findConnector(output, allocator) { return false }

    // What the CRTC shows now, for restore().
    device.zero(savedOf(output), CRTC_SIZE)
    device.store32(savedOf(output), 12, output.*.crtc)
    if !call(output, GETCRTC, savedOf(output), CRTC_SIZE) { device.zero(savedOf(output), CRTC_SIZE) }
    saveGamma(output, allocator)

    return createBuffer(output, 0) && createBuffer(output, 1)
}

// The card's descriptor (to wait for flip events).
pub fn descriptor(output: *const Output) -> isize { return output.*.card.descriptor }

// Where the next frame goes: its address and row pitch in bytes.
pub fn backAddress(output: *const Output) -> usize { return output.*.addresses[output.*.back] }
pub fn backPitch(output: *const Output) -> usize { return output.*.pitches[output.*.back] }

// The dumb buffer to draw the next frame into (0 or 1), and any buffer's
// mapping, row pitch and size in bytes.
pub fn backIndex(output: *const Output) -> usize { return output.*.back }
pub fn bufferAddress(output: *const Output, index: usize) -> usize { return output.*.addresses[index] }
pub fn bufferPitch(output: *const Output, index: usize) -> usize { return output.*.pitches[index] }
pub fn bufferSize(output: *const Output, index: usize) -> usize { return output.*.sizes[index] }

// Dumb buffer `index` as a dma-buf (DRM_IOCTL_PRIME_HANDLE_TO_FD), for a
// GPU to import; the caller owns the descriptor. -1 when the card cannot.
pub fn exportBuffer(output: *Output, index: usize) -> isize {
    var prime: [12]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &prime) }
    device.zero(bytes, 12)
    device.store32(bytes, 0, output.*.handles[index])
    device.store32(bytes, 4, PRIME_CLOEXEC | PRIME_RDWR)
    device.store32(bytes, 8, 4294967295)
    if !call(output, PRIME_HANDLE_TO_FD, bytes, 12) { return -1 }
    // An emulated card sends the descriptor with the reply.
    const received = device.takeDescriptor(cardOf(output))
    if received >= 0 { return received }
    return @intCast(isize, device.loadInt(bytes, 8))
}

// Makes the dma-buf `fd` (a GPU's buffer, rows `pitch` bytes apart) the
// framebuffer of slot `index` for zero copy (DRM_IOCTL_PRIME_FD_TO_HANDLE,
// then a framebuffer on the handle). The descriptor stays the caller's.
// False when the card does not take it (the dumb buffers stay in use).
pub fn importScanout(output: *Output, index: usize, fd: i32, pitch: usize) -> bool {
    var prime: [12]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &prime) }
    device.zero(bytes, 12)
    device.store32(bytes, 8, @bitCast(u32, fd))
    if !call(output, PRIME_FD_TO_HANDLE, bytes, 12) { return false }
    output.*.scanoutHandles[index] = device.load32(bytes, 0)
    var framebuffer: [28]u8 = undefined
    var fb_bytes: [*]u8 = undefined
    unsafe { fb_bytes = @ptrCast([*]u8, &framebuffer) }
    device.zero(fb_bytes, 28)
    device.store32(fb_bytes, 4, @intCast(u32, output.*.width))
    device.store32(fb_bytes, 8, @intCast(u32, output.*.height))
    device.store32(fb_bytes, 12, @intCast(u32, pitch))
    device.store32(fb_bytes, 16, 32)
    device.store32(fb_bytes, 20, 24)
    device.store32(fb_bytes, 24, output.*.scanoutHandles[index])
    if !call(output, ADDFB, fb_bytes, 28) { return false }
    output.*.scanoutFramebuffers[index] = device.load32(fb_bytes, 0)
    return true
}

// Shows the GPU's buffers (true) or the dumb buffers (false) from the next
// frame on.
pub fn useScanout(output: *Output, on: bool) -> void {
    output.*.scanout = on && output.*.scanoutFramebuffers[0] != 0 && output.*.scanoutFramebuffers[1] != 0
}

// Takes the zero-copy framebuffers down (the dumb buffers are shown again).
pub fn releaseScanout(output: *Output) -> void {
    output.*.scanout = false
    var index: usize = 0
    while index < 2 {
        var word: [8]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &word) }
        if output.*.scanoutFramebuffers[index] != 0 {
            device.zero(bytes, 8)
            device.store32(bytes, 0, output.*.scanoutFramebuffers[index])
            const removed = call(output, RMFB, bytes, 4)
            output.*.scanoutFramebuffers[index] = 0
        }
        if output.*.scanoutHandles[index] != 0 {
            device.zero(bytes, 8)
            device.store32(bytes, 0, output.*.scanoutHandles[index])
            const closed = call(output, GEM_CLOSE, bytes, 8)
            output.*.scanoutHandles[index] = 0
        }
        index += 1
    }
}

fn setCrtc(output: *Output, framebuffer: u32, mode: [*]const u8, mode_valid: bool) -> bool {
    var crtc: [104]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &crtc) }
    device.zero(bytes, CRTC_SIZE)
    var connectors: [2]u32 = [2]u32{ output.*.connector, 0 }
    unsafe { device.store64(bytes, 0, @intFromPtr(@ptrCast([*]u32, &connectors))) }
    device.store32(bytes, 8, if framebuffer == 0 { 0 } else { 1 })
    device.store32(bytes, 12, output.*.crtc)
    device.store32(bytes, 16, framebuffer)
    device.store32(bytes, 32, if mode_valid { 1 } else { 0 })
    var index: usize = 0
    while index < MODE_SIZE {
        bytes[36 + index] = mode[index]
        index += 1
    }
    return call(output, SETCRTC, bytes, CRTC_SIZE)
}

// ---------------------------------------------------------------------------
// Night light

// The CRTC's gamma table as it was (GETCRTC said how big), kept to build
// ours from and to put back; gammaSize stays 0 when there is none.
fn saveGamma(output: *Output, allocator: Allocator) -> void {
    const size = device.load32(savedOf(output), 28)
    if size == 0 || size > MAX_GAMMA { return }
    const bytes = @intCast(usize, size) * 6
    const saved = allocator.alloc(bytes, 8).?
    const ramp = allocator.alloc(bytes, 8).?
    output.*.gammaSize = size
    output.*.gammaSaved = @intFromPtr(saved)
    output.*.gammaRamp = @intFromPtr(ramp)
    if !lut(output, GETGAMMA, output.*.gammaSaved) {
        allocator.free(saved, bytes, 8)
        allocator.free(ramp, bytes, 8)
        output.*.gammaSize = 0
    }
}

// GETGAMMA or SETGAMMA with the three ramps at `table`.
fn lut(output: *Output, request: usize, table: usize) -> bool {
    var argument: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &argument) }
    const size = @intCast(usize, output.*.gammaSize)
    device.zero(bytes, LUT_SIZE)
    device.store32(bytes, 0, output.*.crtc)
    device.store32(bytes, 4, output.*.gammaSize)
    device.store64(bytes, 8, table)
    device.store64(bytes, 16, table + size * 2)
    device.store64(bytes, 24, table + size * 4)
    return call(output, request, bytes, LUT_SIZE)
}

fn loadGamma(output: *Output, table: usize) -> bool { return lut(output, SETGAMMA, table) }

// A black body's colour at every 500 K from 1000 K (index 0) to 6500 K
// (index 11): green and blue per mille of red (Tanner Helland's fit,
// scaled so that 6500 K is white).
fn knotGreen(index: u32) -> u32 {
    return match index { 0 => 267, 1 => 426, 2 => 539, 3 => 626, 4 => 697, 5 => 758, 6 => 810, 7 => 856, 8 => 897, 9 => 935, 10 => 969, else => 1000 }
}

fn knotBlue(index: u32) -> u32 {
    return match index { 0 => 0, 1 => 0, 2 => 56, 3 => 280, 4 => 440, 5 => 563, 6 => 664, 7 => 750, 8 => 824, 9 => 889, 10 => 947, else => 1000 }
}

// White at `kelvin` (1000 to 6500): green and blue per mille of red,
// between the knots in a straight line.
pub fn whitePoint(kelvin: u32, green: *u32, blue: *u32) -> void {
    var clamped = if kelvin < 1000 { 1000 } else { kelvin }
    if clamped > NEUTRAL { clamped = NEUTRAL }
    const index = (clamped - 1000) / 500
    const part = (clamped - 1000) % 500
    if index >= 11 {
        green.* = 1000
        blue.* = 1000
        return
    }
    green.* = (knotGreen(index) * (500 - part) + knotGreen(index + 1) * part) / 500
    blue.* = (knotBlue(index) * (500 - part) + knotBlue(index + 1) * part) / 500
}

// Night light at `kelvin` (NEUTRAL or above: none): the gamma table the
// CRTC had, its green and blue scaled to that white. False when the CRTC
// has no gamma table or the kernel refused it.
pub fn setTemperature(output: *Output, kelvin: u32) -> bool {
    if output.*.gammaSize == 0 { return false }
    const wanted = if kelvin >= NEUTRAL { 0 } else { kelvin }
    if wanted == output.*.temperature { return true }
    if wanted == 0 {
        output.*.temperature = 0
        return loadGamma(output, output.*.gammaSaved)
    }
    var green: u32 = 0
    var blue: u32 = 0
    whitePoint(wanted, &green, &blue)
    var saved: [*]u8 = undefined
    var ramp: [*]u8 = undefined
    unsafe {
        saved = @ptrFromInt([*]u8, output.*.gammaSaved)
        ramp = @ptrFromInt([*]u8, output.*.gammaRamp)
    }
    const size = @intCast(usize, output.*.gammaSize)
    var index: usize = 0
    while index < size {
        device.store16(ramp, index * 2, device.load16(saved, index * 2))
        device.store16(ramp, (size + index) * 2, device.load16(saved, (size + index) * 2) * green / 1000)
        device.store16(ramp, (size * 2 + index) * 2, device.load16(saved, (size * 2 + index) * 2) * blue / 1000)
        index += 1
    }
    if !loadGamma(output, output.*.gammaRamp) { return false }
    output.*.temperature = wanted
    return true
}

// Shows the back buffer. The first time (and after a VT switch) that sets
// the CRTC up and is on screen at once; otherwise it is a page flip, done
// when its event arrives (true either way when it worked). `shown` is
// true when the frame is already on screen.
pub fn present(output: *Output, shown: *bool) -> bool {
    shown.* = false
    const framebuffer = if output.*.scanout { output.*.scanoutFramebuffers[output.*.back] } else { output.*.framebuffers[output.*.back] }
    if output.*.needsModeset {
        if !setCrtc(output, framebuffer, modeOf(output), true) { return false }
        output.*.needsModeset = false
        output.*.flipPending = false
        output.*.back = 1 - output.*.back
        shown.* = true
        return true
    }
    var flip: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &flip) }
    device.zero(bytes, 24)
    device.store32(bytes, 0, output.*.crtc)
    device.store32(bytes, 4, framebuffer)
    device.store32(bytes, 8, PAGE_FLIP_EVENT)
    device.store64(bytes, 16, @intCast(usize, framebuffer))
    if !call(output, PAGE_FLIP, bytes, 24) { return false }
    output.*.flipPending = true
    output.*.back = 1 - output.*.back
    return true
}

// Reads the card's events. True when a flip completed (the last presented
// frame is on screen); `milliseconds` is its time.
pub fn readEvents(output: *Output, milliseconds: *u32) -> bool {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &output.*.events) }
    var flipped = false
    while true {
        const count = device.read(cardOf(output), bytes, 1024)
        if count <= 0 { break }
        var at: usize = 0
        const total = @bitCast(usize, count)
        while at + 8 <= total {
            const kind = device.load32(bytes, at)
            const length = @intCast(usize, device.load32(bytes, at + 4))
            if length < 8 || at + length > total { break }
            if kind == EVENT_FLIP_COMPLETE && length >= 32 {
                output.*.flipPending = false
                flipped = true
                const seconds = device.load32(bytes, at + 16)
                const microseconds = device.load32(bytes, at + 20)
                milliseconds.* = seconds *% 1000 +% microseconds / 1000
            }
            at += length
        }
    }
    return flipped
}

// After the session comes back to the foreground: the CRTC is set up again
// with the next frame, and no flip is outstanding any more.
pub fn resume(output: *Output) -> void {
    output.*.needsModeset = true
    output.*.flipPending = false
    // The other session may have set a gamma table of its own.
    if output.*.temperature != 0 {
        const kelvin = output.*.temperature
        output.*.temperature = 0
        const set = setTemperature(output, kelvin)
    }
}

// Puts back what the CRTC showed before us, and frees our buffers.
pub fn close(output: *Output, allocator: Allocator) -> void {
    if output.*.temperature != 0 { const restored_gamma = loadGamma(output, output.*.gammaSaved) }
    if output.*.gammaSize != 0 {
        const size = @intCast(usize, output.*.gammaSize) * 6
        unsafe {
            allocator.free(@ptrFromInt([*]u8, output.*.gammaSaved), size, 8)
            allocator.free(@ptrFromInt([*]u8, output.*.gammaRamp), size, 8)
        }
        output.*.gammaSize = 0
    }
    const saved = savedOf(output)
    const saved_framebuffer = device.load32(saved, 16)
    var mode_bytes: [*]const u8 = undefined
    unsafe { mode_bytes = @ptrFromInt([*]const u8, @intFromPtr(saved) + 36) }
    const restored = setCrtc(output, saved_framebuffer, mode_bytes, device.load32(saved, 32) != 0)
    releaseScanout(output)
    var index: usize = 0
    while index < 2 {
        var word: [8]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &word) }
        device.unmap(output.*.addresses[index], output.*.sizes[index])
        if output.*.framebuffers[index] != 0 {
            device.zero(bytes, 8)
            device.store32(bytes, 0, output.*.framebuffers[index])
            const removed = call(output, RMFB, bytes, 4)
        }
        if output.*.handles[index] != 0 {
            device.zero(bytes, 8)
            device.store32(bytes, 0, output.*.handles[index])
            const destroyed = call(output, DESTROY_DUMB, bytes, 4)
        }
        index += 1
    }
    var none: [8]u8 = undefined
    var none_bytes: [*]u8 = undefined
    unsafe { none_bytes = @ptrCast([*]u8, &none) }
    const dropped = device.ioctl(cardOf(output), DROP_MASTER, none_bytes, 0)
    device.deinit(cardOf(output), allocator)
}
