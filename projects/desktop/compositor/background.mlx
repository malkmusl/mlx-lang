// The desktop's background and the colours taken from it, as Material You
// takes them: the wallpaper (settings `wallpaper`: a PNG or JPEG, scaled
// to cover the output) gives the scheme (std.ui.scheme.fromImage: its
// most colourful hues), unless the user chose a colour (`accent-color`),
// which then gives it (fromSeed). Without a wallpaper the background is
// made of the scheme: its tint, dark, with the three prism colours glowing
// from three places (an aurora).
//
// The scheme colours the title bars (scene.mlx: their glass, the prism
// line of the focused one, the buttons) and is written to
// $XDG_CONFIG_HOME/mlx/appearance.conf (accent-color, prism-colors,
// tint-color), which every app of the desktop follows (std.ui.appearance,
// std.ui.theme), so the whole desktop takes its colours from the
// background.
const std = @import("std")
const xdg = @import("std.xdg")
const png = @import("std.png")
const jpeg = @import("std.jpeg")
const ui_scheme = @import("std.ui.scheme")
const state = @import("./state.mlx")

const Compositor = state.Compositor

fn say(text: []const u8) -> void { state.say(text) }

fn wallpaperPath(compositor: *Compositor) -> [*]const u8 { return &compositor.*.wallpaper }

fn hasWallpaper(compositor: *const Compositor) -> bool { return compositor.*.wallpaper[0] != 0 }

// The pixel of the background at (x, y) (the output's).
pub fn pixel(compositor: *const Compositor, x: usize, y: usize) -> u32 {
    if compositor.*.background == 0 || x >= compositor.*.backgroundWidth || y >= compositor.*.backgroundHeight { return 4278190080 }
    const pixels: [*]const u32 = unsafe { @ptrFromInt([*]const u32, compositor.*.background) }
    return pixels[y * compositor.*.backgroundWidth + x]
}

// The background's row `y` from column `x` on, `count` pixels, to `into`
// (an address).
pub fn copyRow(compositor: *const Compositor, into: usize, x: usize, y: usize, count: usize) -> void {
    state.copyPixels(into, compositor.*.background + (y * compositor.*.backgroundWidth + x) * 4, count)
}

// Makes the background and the scheme when they are wanted (the settings
// changed them) or the output's size changed; true when it made them.
pub fn ensure(compositor: *Compositor) -> bool {
    const sized = compositor.*.backgroundWidth == compositor.*.width && compositor.*.backgroundHeight == compositor.*.height
    if compositor.*.background != 0 && sized && !compositor.*.backgroundWanted { return false }
    compositor.*.backgroundWanted = false
    make(compositor)
    return true
}

fn release(compositor: *Compositor) -> void {
    if compositor.*.background == 0 { return }
    unsafe { state.release(compositor, @ptrFromInt([*]u8, compositor.*.background), compositor.*.backgroundWidth * compositor.*.backgroundHeight * 4) }
    compositor.*.background = 0
}

fn make(compositor: *Compositor) -> void {
    release(compositor)
    const width = compositor.*.width
    const height = compositor.*.height
    if width == 0 || height == 0 { return }
    compositor.*.background = @intFromPtr(state.allocate(compositor, width * height * 4))
    compositor.*.backgroundWidth = width
    compositor.*.backgroundHeight = height
    var scheme = ui_scheme.fromSeed(if compositor.*.accentSeed != 0 { compositor.*.accentSeed } else { ui_scheme.DEFAULT_ACCENT })
    var image: png.Image = undefined
    if hasWallpaper(compositor) && load(compositor, &image) {
        if compositor.*.accentSeed == 0 { scheme = ui_scheme.fromImage(image.pixels, image.width, image.height, image.width) }
        cover(compositor, &image)
        png.deinit(&image)
    } else {
        if hasWallpaper(compositor) {
            say("background: cannot read the wallpaper ")
            say(std.text.cString(wallpaperPath(compositor)))
            say("; the colours make it\n")
        }
        aurora(compositor, &scheme)
    }
    const changed = !ui_scheme.same(&scheme, &compositor.*.scheme)
    compositor.*.scheme = scheme
    if changed { publish(compositor) }
    if compositor.*.verbose {
        var text: [8]u8 = undefined
        const bytes: [*]u8 = &text
        say("background: accent ")
        say(bytes[0..ui_scheme.formatColor(scheme.accent, bytes, 0)])
        say(if hasWallpaper(compositor) { " (wallpaper)\n" } else { " (colours)\n" })
    }
}

// The wallpaper, a PNG or a JPEG (by its first bytes), as pixels.
fn load(compositor: *Compositor, image: *png.Image) -> bool {
    const allocator = compositor.*.allocator
    const loaded = std.fs.readFileAlloc(wallpaperPath(compositor), allocator)
    if loaded == null { return false }
    const contents = loaded.?
    var ok = false
    if contents.length > 4 && contents.items[0] == 137 && contents.items[1] == 80 {
        ok = png.decode(image, contents.items, contents.length, allocator) == png.Status.ok
    } else if contents.length > 4 && contents.items[0] == 255 && contents.items[1] == 216 {
        var picture: jpeg.Picture = undefined
        if jpeg.decodeRgba(&picture, contents.items, contents.length, allocator) == jpeg.Status.ok {
            const count = picture.width * picture.height
            const memory = allocator.alloc(count * 4, 16)
            if memory != null {
                const words: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
                var index: usize = 0
                while index < count {
                    const at = index * 4
                    words[index] = 4278190080 | (@intCast(u32, picture.pixels[at]) << 16) | (@intCast(u32, picture.pixels[at + 1]) << 8) | @intCast(u32, picture.pixels[at + 2])
                    index += 1
                }
                image.*.pixels = words
                image.*.width = picture.width
                image.*.height = picture.height
                image.*.allocator = allocator
                ok = true
            }
            jpeg.deinitPicture(&picture)
        }
    }
    std.fs.ArrayList.deinit(contents)
    return ok && image.*.width > 0 && image.*.height > 0
}

// The image scaled to cover the output (cut at the sides or the top and
// bottom, kept in the middle): each pixel the mean of the image's pixels
// its area covers.
fn cover(compositor: *Compositor, image: *const png.Image) -> void {
    const width = compositor.*.backgroundWidth
    const height = compositor.*.backgroundHeight
    // The part of the image shown: the output's shape, as large as fits.
    var part_width = image.*.width
    var part_height = image.*.width * height / width
    if part_height > image.*.height {
        part_height = image.*.height
        part_width = image.*.height * width / height
    }
    if part_width == 0 { part_width = 1 }
    if part_height == 0 { part_height = 1 }
    const left = (image.*.width - part_width) / 2
    const top = (image.*.height - part_height) / 2
    const target: [*]u32 = unsafe { @ptrFromInt([*]u32, compositor.*.background) }
    var y: usize = 0
    while y < height {
        const from_y = top + y * part_height / height
        var to_y = top + (y + 1) * part_height / height
        if to_y <= from_y { to_y = from_y + 1 }
        var x: usize = 0
        while x < width {
            const from_x = left + x * part_width / width
            var to_x = left + (x + 1) * part_width / width
            if to_x <= from_x { to_x = from_x + 1 }
            // The mean of the block (at most 4 x 4 of it, evenly spread).
            const step_y = if to_y - from_y > 4 { (to_y - from_y) / 4 } else { 1 }
            const step_x = if to_x - from_x > 4 { (to_x - from_x) / 4 } else { 1 }
            var red: u32 = 0
            var green: u32 = 0
            var blue: u32 = 0
            var count: u32 = 0
            var sy = from_y
            while sy < to_y {
                var sx = from_x
                while sx < to_x {
                    const source = image.*.pixels[sy * image.*.width + sx]
                    red += (source >> 16) & 255
                    green += (source >> 8) & 255
                    blue += source & 255
                    count += 1
                    sx += step_x
                }
                sy += step_y
            }
            target[y * width + x] = 4278190080 | ((red / count) << 16) | ((green / count) << 8) | (blue / count)
            x += 1
        }
        y += 1
    }
}

// One glow: `color` at `strength` (0 to 255) at the centre (cx, cy),
// fading to nothing at `radius` (squared falloff).
fn glow(red: *u32, green: *u32, blue: *u32, x: i64, y: i64, cx: i64, cy: i64, radius: i64, color: u32, strength: i64) -> void {
    const dx = x - cx
    const dy = y - cy
    const distance = dx * dx + dy * dy
    const reach = radius * radius
    if distance >= reach { return }
    const fall = (reach - distance) * 256 / reach
    const amount = fall * fall / 256 * strength / 255
    red.* += @intCast(u32, @intCast(i64, (color >> 16) & 255) * amount / 256)
    green.* += @intCast(u32, @intCast(i64, (color >> 8) & 255) * amount / 256)
    blue.* += @intCast(u32, @intCast(i64, color & 255) * amount / 256)
}

// The background made of the scheme: its tint, darker towards the bottom,
// lit by the prism's colours from the upper left, the upper right and
// below the middle.
fn aurora(compositor: *Compositor, scheme: *const ui_scheme.Scheme) -> void {
    const width = compositor.*.backgroundWidth
    const height = compositor.*.backgroundHeight
    const target: [*]u32 = unsafe { @ptrFromInt([*]u32, compositor.*.background) }
    const base = ui_scheme.toHsl(scheme.*.tint)
    const top_color = ui_scheme.fromHsl(ui_scheme.Hsl.{ .hue = base.hue, .saturation = base.saturation, .lightness = 140 })
    const bottom_color = ui_scheme.fromHsl(ui_scheme.Hsl.{ .hue = base.hue, .saturation = base.saturation, .lightness = 70 })
    const w = @intCast(i64, width)
    const h = @intCast(i64, height)
    const radius = (if w > h { w } else { h }) * 3 / 5
    var y: usize = 0
    while y < height {
        const row = ui_scheme.mix(top_color, bottom_color, @intCast(i32, y * 1024 / height))
        var x: usize = 0
        while x < width {
            var red = (row >> 16) & 255
            var green = (row >> 8) & 255
            var blue = row & 255
            const px = @intCast(i64, x)
            const py = @intCast(i64, y)
            glow(&red, &green, &blue, px, py, w / 6, h / 5, radius, scheme.*.prism[0], 120)
            glow(&red, &green, &blue, px, py, w * 5 / 6, h / 4, radius, scheme.*.prism[1], 110)
            glow(&red, &green, &blue, px, py, w / 2, h + h / 6, radius, scheme.*.prism[2], 130)
            if red > 255 { red = 255 }
            if green > 255 { green = 255 }
            if blue > 255 { blue = 255 }
            target[y * width + x] = 4278190080 | (red << 16) | (green << 8) | blue
            x += 1
        }
        y += 1
    }
}

// ---------------------------------------------------------------------------
// appearance.conf

fn appendColor(into: [*]u8, at: usize, color: u32) -> usize { return ui_scheme.formatColor(color, into, at) }

fn appendText(into: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        into[index] = byte
        index += 1
    }
    return index
}

fn startsWith(line: []const u8, key: []const u8) -> bool { return line.length >= key.length && std.text.same(line[0..key.length], key) }

fn isSchemeKey(line: []const u8) -> bool { return startsWith(line, "accent-color") || startsWith(line, "prism-colors") || startsWith(line, "tint-color") }

// Writes the scheme into appearance.conf: its other lines (the colour
// scheme) kept, the scheme's three replaced.
fn publish(compositor: *Compositor) -> void {
    var path: [256]u8 = undefined
    const bytes: [*]u8 = &path
    const length = xdg.path(compositor.*.environment, xdg.CONFIG, "/mlx/appearance.conf", bytes, 250)
    if length == 0 { return }
    _ = std.fs.makeParents(bytes[0..length], 493)
    var out: [2048]u8 = undefined
    const text: [*]u8 = &out
    var used: usize = 0
    var old: [1536]u8 = undefined
    const old_bytes: [*]u8 = &old
    const size = std.fs.readFile(bytes, old_bytes, 1536)
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && old_bytes[end] != 10 { end += 1 }
        const line = old_bytes[at..end]
        if line.length > 0 && !isSchemeKey(line) && used + line.length + 1 < 1900 {
            used = appendText(text, used, line)
            used = appendText(text, used, "\n")
        }
        at = end + 1
    }
    const scheme = &compositor.*.scheme
    used = appendText(text, used, "accent-color = ")
    used = appendColor(text, used, scheme.*.accent)
    used = appendText(text, used, "\nprism-colors = ")
    used = appendColor(text, used, scheme.*.prism[0])
    used = appendText(text, used, ",")
    used = appendColor(text, used, scheme.*.prism[1])
    used = appendText(text, used, ",")
    used = appendColor(text, used, scheme.*.prism[2])
    used = appendText(text, used, "\ntint-color = ")
    used = appendColor(text, used, scheme.*.tint)
    used = appendText(text, used, "\n")
    if !std.fs.replaceFile(bytes, text, used, 420) { say("background: cannot write appearance.conf\n") }
}
