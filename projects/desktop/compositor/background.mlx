// The desktop's background and the colours taken from it, as Material You
// takes them: the wallpaper (settings `wallpaper`: a PNG or JPEG, scaled
// to cover the output) gives the scheme (std.ui.scheme.fromImage: its
// most colourful hues), unless the user chose a colour (`accent-color`),
// which then gives it (fromSeed). Without a wallpaper the background is
// made of the scheme: its tint, dark, with the three prism colours glowing
// from three places (an aurora).
//
// The scheme colours the title bars (scene.mlx: their glass, the prism
// line of the focused one, the buttons) and is written to
// $XDG_CONFIG_HOME/mlx/appearance.conf (accent-color, prism-colors,
// tint-color), which every app of the desktop follows (std.ui.appearance,
// std.ui.theme), so the whole desktop takes its colours from the
// background.
const std = @import("std")
const xdg = @import("std.xdg")
const ui_scheme = @import("std.ui.scheme")
const backdrop = @import("../shared/backdrop.mlx")
const state = @import("./state.mlx")

const Compositor = state.Compositor

fn say(text: []const u8) -> void { state.say(text) }

fn wallpaperPath(compositor: *Compositor) -> [*]const u8 { return &compositor.*.wallpaper }

fn hasWallpaper(compositor: *const Compositor) -> bool { return compositor.*.wallpaper[0] != 0 }

// The pixel of the background at (x, y) (the output's).
pub fn pixel(compositor: *const Compositor, x: usize, y: usize) -> u32 {
    if compositor.*.background == 0 || x >= compositor.*.backgroundWidth || y >= compositor.*.backgroundHeight { return 4278190080 }
    const pixels: [*]const u32 = unsafe { @ptrFromInt([*]const u32, compositor.*.background) }
    return pixels[y * compositor.*.backgroundWidth + x]
}

// The background's row `y` from column `x` on, `count` pixels, to `into`
// (an address).
pub fn copyRow(compositor: *const Compositor, into: usize, x: usize, y: usize, count: usize) -> void {
    state.copyPixels(into, compositor.*.background + (y * compositor.*.backgroundWidth + x) * 4, count)
}

// Makes the background and the scheme when they are wanted (the settings
// changed them) or the output's size changed; true when it made them.
pub fn ensure(compositor: *Compositor) -> bool {
    const sized = compositor.*.backgroundWidth == compositor.*.width && compositor.*.backgroundHeight == compositor.*.height
    if compositor.*.background != 0 && sized && !compositor.*.backgroundWanted { return false }
    compositor.*.backgroundWanted = false
    make(compositor)
    return true
}

fn release(compositor: *Compositor) -> void {
    if compositor.*.background == 0 { return }
    unsafe { state.release(compositor, @ptrFromInt([*]u8, compositor.*.background), compositor.*.backgroundWidth * compositor.*.backgroundHeight * 4) }
    compositor.*.background = 0
}

fn make(compositor: *Compositor) -> void {
    release(compositor)
    const width = compositor.*.width
    const height = compositor.*.height
    if width == 0 || height == 0 { return }
    compositor.*.background = @intFromPtr(state.allocate(compositor, width * height * 4))
    compositor.*.backgroundWidth = width
    compositor.*.backgroundHeight = height
    var scheme: ui_scheme.Scheme = undefined
    const pixels: [*]u32 = unsafe { @ptrFromInt([*]u32, compositor.*.background) }
    const used = backdrop.make(pixels, width, height, wallpaperPath(compositor), compositor.*.accentSeed, compositor.*.allocator, &scheme)
    if hasWallpaper(compositor) && !used {
        say("background: cannot read the wallpaper ")
        say(std.text.cString(wallpaperPath(compositor)))
        say("; the colours make it\n")
    }
    scheme.glassAlpha = compositor.*.titleAlpha
    const changed = !ui_scheme.same(&scheme, &compositor.*.scheme)
    compositor.*.scheme = scheme
    if changed { publish(compositor) }
    if compositor.*.verbose {
        var text: [8]u8 = undefined
        const bytes: [*]u8 = &text
        say("background: accent ")
        say(bytes[0..ui_scheme.formatColor(scheme.accent, bytes, 0)])
        say(if used { " (wallpaper)\n" } else { " (colours)\n" })
    }
}

// ---------------------------------------------------------------------------
// appearance.conf

fn appendColor(into: [*]u8, at: usize, color: u32) -> usize { return ui_scheme.formatColor(color, into, at) }

fn appendText(into: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        into[index] = byte
        index += 1
    }
    return index
}

fn startsWith(line: []const u8, key: []const u8) -> bool { return line.length >= key.length && std.text.same(line[0..key.length], key) }

fn isSchemeKey(line: []const u8) -> bool { return startsWith(line, "accent-color") || startsWith(line, "prism-colors") || startsWith(line, "tint-color") || startsWith(line, "glass-alpha") }

// The title bars' opacity changed (settings title-opacity): the glass's
// is published with it, so the apps' sidebars stay as opaque as the bars.
pub fn glassChanged(compositor: *Compositor) -> void {
    if compositor.*.scheme.glassAlpha == compositor.*.titleAlpha { return }
    compositor.*.scheme.glassAlpha = compositor.*.titleAlpha
    publish(compositor)
}

fn startsWithKey(line: []const u8, key: []const u8) -> bool { return line.length >= key.length && std.text.same(line[0..key.length], key) }

// Whether appearance.conf says light (color-scheme = light): the glass
// and the titles follow.
pub fn readLook(compositor: *Compositor) -> bool {
    var path: [256]u8 = undefined
    const bytes: [*]u8 = &path
    const length = xdg.path(compositor.*.environment, xdg.CONFIG, "/mlx/appearance.conf", bytes, 250)
    if length == 0 { return false }
    var text: [1536]u8 = undefined
    const text_bytes: [*]u8 = &text
    const size = std.fs.readFile(bytes, text_bytes, 1536)
    var light = false
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && text_bytes[end] != 10 { end += 1 }
        const line = text_bytes[at..end]
        if startsWithKey(line, "color-scheme") {
            var value = end
            while value > at && text_bytes[value - 1] == 32 { value -= 1 }
            light = value >= at + 5 && std.text.same(text_bytes[value - 5..value], "light")
        }
        at = end + 1
    }
    return light
}

// Writes the scheme into appearance.conf: its other lines (the colour
// scheme) kept, the scheme's three replaced.
fn publish(compositor: *Compositor) -> void {
    var path: [256]u8 = undefined
    const bytes: [*]u8 = &path
    const length = xdg.path(compositor.*.environment, xdg.CONFIG, "/mlx/appearance.conf", bytes, 250)
    if length == 0 { return }
    _ = std.fs.makeParents(bytes[0..length], 493)
    var out: [2048]u8 = undefined
    const text: [*]u8 = &out
    var used: usize = 0
    var old: [1536]u8 = undefined
    const old_bytes: [*]u8 = &old
    const size = std.fs.readFile(bytes, old_bytes, 1536)
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && old_bytes[end] != 10 { end += 1 }
        const line = old_bytes[at..end]
        if line.length > 0 && !isSchemeKey(line) && used + line.length + 1 < 1900 {
            used = appendText(text, used, line)
            used = appendText(text, used, "\n")
        }
        at = end + 1
    }
    const scheme = &compositor.*.scheme
    used = appendText(text, used, "accent-color = ")
    used = appendColor(text, used, scheme.*.accent)
    used = appendText(text, used, "\nprism-colors = ")
    used = appendColor(text, used, scheme.*.prism[0])
    used = appendText(text, used, ",")
    used = appendColor(text, used, scheme.*.prism[1])
    used = appendText(text, used, ",")
    used = appendColor(text, used, scheme.*.prism[2])
    used = appendText(text, used, "\ntint-color = ")
    used = appendColor(text, used, scheme.*.tint)
    used = appendText(text, used, "\nglass-alpha = ")
    used = std.text.appendUnsigned(text, used, used + 4, @intCast(usize, scheme.*.glassAlpha))
    used = appendText(text, used, "\n")
    if !std.fs.replaceFile(bytes, text, used, 420) { say("background: cannot write appearance.conf\n") }
}
