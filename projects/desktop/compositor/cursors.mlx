// The cursors the compositor draws itself, each in a CURSOR_SIZE box (part
// of scene.mlx, split from it; vulkan.mlx copies the same pixels into its
// cursor buffer): the arrow, the resize arrows for each direction, and
// the shapes clients name through cursor-shape (pointer.mlx): an I-beam
// for text, a pointing hand, the four-way arrow for moving, a crosshair,
// a no-entry sign and an hourglass. A pixel is 0 (transparent), 1
// (outline, black) or 2 (fill, white).

pub const CURSOR_SIZE: i32 = 17
pub const CURSOR_ARROW: u32 = 0
pub const CURSOR_HORIZONTAL: u32 = 1
pub const CURSOR_VERTICAL: u32 = 2
pub const CURSOR_DIAGONAL: u32 = 3
pub const CURSOR_ANTIDIAGONAL: u32 = 4
pub const CURSOR_TEXT: u32 = 5
pub const CURSOR_HAND: u32 = 6
pub const CURSOR_MOVE: u32 = 7
pub const CURSOR_CROSSHAIR: u32 = 8
pub const CURSOR_NOT_ALLOWED: u32 = 9
pub const CURSOR_WAIT: u32 = 10
pub const CURSOR_KINDS: u32 = 11

// The built-in arrow: 0 transparent, 1 outline, 2 fill.
pub fn arrowPixel(x: i32, y: i32) -> u8 {
    if y < 0 || x < 0 || y > 16 { return 0 }
    if y <= 11 {
        if x > y { return 0 }
        if x == 0 || x == y || y == 11 { return 1 }
        return 2
    }
    // The tail below the triangle.
    const tail = y - 11
    if x < 4 + tail / 2 || x > 6 + tail / 2 { return 0 }
    if x == 4 + tail / 2 || x == 6 + tail / 2 || y == 16 { return 1 }
    return 2
}

fn absolute(value: i32) -> i32 { return if value < 0 { 0 - value } else { value } }

// A resize cursor: a double arrow through the middle of the box (along x,
// along y, or diagonal).
fn insideResize(kind: u32, x: i32, y: i32) -> bool {
    const u0 = x - CURSOR_SIZE / 2
    const v0 = y - CURSOR_SIZE / 2
    var along = u0
    var across = v0
    var reach: i32 = 8
    if kind == CURSOR_VERTICAL {
        along = v0
        across = u0
    } else if kind == CURSOR_DIAGONAL {
        along = u0 + v0
        across = u0 - v0
        reach = 12
    } else if kind == CURSOR_ANTIDIAGONAL {
        along = u0 - v0
        across = u0 + v0
        reach = 12
    }
    const a = absolute(along)
    const b = absolute(across)
    if a > reach { return false }
    // The shaft, and a head at each end whose tip is `reach` out.
    if b <= 1 { return true }
    return a >= reach / 2 && b <= reach - a
}

// The pointing hand: the index finger up, three fingers folded beside it,
// the palm and the thumb.
fn insideHand(x: i32, y: i32) -> bool {
    if x >= 5 && x <= 7 && y >= 1 && y <= 8 { return y > 1 || x == 6 }
    if y > 14 || x > 13 { return false }
    if x >= 8 && x <= 9 && y >= 6 { return true }
    if x >= 10 && x <= 11 && y >= 7 { return true }
    if x >= 12 && y >= 8 { return y < 14 || x == 12 }
    if x >= 5 && y >= 8 { return y < 14 || x > 5 }
    // The thumb, leaning out.
    return y >= 9 && y <= 12 && x >= 2 && x <= 4 && x - 2 >= y - 10 && x - 2 <= y - 8
}

// Whether (x, y) is filled in a cursor drawn by its outline (all but the
// arrow).
fn inside(kind: u32, x: i32, y: i32) -> bool {
    const u0 = x - CURSOR_SIZE / 2
    const v0 = y - CURSOR_SIZE / 2
    if kind == CURSOR_TEXT {
        // An I-beam with serifs.
        if x == 8 { return y >= 2 && y <= 14 }
        return (y == 2 || y == 14) && x >= 6 && x <= 10
    }
    if kind == CURSOR_HAND { return insideHand(x, y) }
    if kind == CURSOR_MOVE { return insideResize(CURSOR_HORIZONTAL, x, y) || insideResize(CURSOR_VERTICAL, x, y) }
    if kind == CURSOR_CROSSHAIR { return (u0 == 0 && absolute(v0) <= 7) || (v0 == 0 && absolute(u0) <= 7) }
    if kind == CURSOR_NOT_ALLOWED {
        // A ring with a bar across from top left to bottom right.
        const distance = u0 * u0 + v0 * v0
        if distance > 49 { return false }
        return distance >= 25 || absolute(u0 - v0) <= 1
    }
    if kind == CURSOR_WAIT {
        // An hourglass: a bar at the top and the bottom, glass narrowing to
        // the middle between.
        if absolute(v0) == 7 { return absolute(u0) <= 6 }
        if absolute(v0) > 7 { return false }
        const half = if absolute(v0) < 1 { 1 } else { absolute(v0) - 1 }
        return absolute(u0) <= half
    }
    return insideResize(kind, x, y)
}

pub fn cursorPixel(kind: u32, x: i32, y: i32) -> u8 {
    if kind == CURSOR_ARROW { return arrowPixel(x, y) }
    if x < 0 || y < 0 || x >= CURSOR_SIZE || y >= CURSOR_SIZE { return 0 }
    if inside(kind, x, y) { return 2 }
    var dy: i32 = -1
    while dy <= 1 {
        var dx: i32 = -1
        while dx <= 1 {
            const nx = x + dx
            const ny = y + dy
            if nx >= 0 && ny >= 0 && nx < CURSOR_SIZE && ny < CURSOR_SIZE && inside(kind, nx, ny) { return 1 }
            dx += 1
        }
        dy += 1
    }
    return 0
}

// The cursor's hot spot within its box: the arrow's tip, the hand's
// fingertip, else the middle.
pub fn hotspotX(kind: u32) -> i32 {
    if kind == CURSOR_ARROW { return 0 }
    if kind == CURSOR_HAND { return 6 }
    return CURSOR_SIZE / 2
}

pub fn hotspotY(kind: u32) -> i32 {
    if kind == CURSOR_ARROW { return 0 }
    if kind == CURSOR_HAND { return 1 }
    return CURSOR_SIZE / 2
}

pub fn arrowColor(kind: u8) -> u32 {
    if kind == 1 { return 4278190080 }
    if kind == 2 { return 4294967295 }
    return 0
}

// The cursor for a wp_cursor_shape_device_v1 shape (1 to 36): the closest
// the compositor draws; CURSOR_KINDS for none.
pub fn forShape(shape: u32) -> u32 {
    if shape == 4 || shape == 16 || shape == 17 { return CURSOR_HAND }
    if shape == 5 || shape == 6 { return CURSOR_WAIT }
    if shape == 7 || shape == 8 { return CURSOR_CROSSHAIR }
    if shape == 9 || shape == 10 { return CURSOR_TEXT }
    if shape == 13 || shape == 32 || shape == 36 { return CURSOR_MOVE }
    if shape == 14 || shape == 15 { return CURSOR_NOT_ALLOWED }
    if shape == 18 || shape == 25 || shape == 26 || shape == 30 { return CURSOR_HORIZONTAL }
    if shape == 19 || shape == 22 || shape == 27 || shape == 31 { return CURSOR_VERTICAL }
    if shape == 21 || shape == 23 || shape == 29 { return CURSOR_DIAGONAL }
    if shape == 20 || shape == 24 || shape == 28 { return CURSOR_ANTIDIAGONAL }
    if shape >= 1 && shape <= 36 { return CURSOR_ARROW }
    return CURSOR_KINDS
}
