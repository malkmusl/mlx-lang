// The keyboard description for the DRM backend: without a host compositor,
// the compositor makes the xkb keymap its clients get, and tracks the
// modifier state it sends them.
//
// std.xkb compiles the keymap from the XKB data (/usr/share/X11/xkb) for
// the layout in XKB_DEFAULT_LAYOUT, XKB_DEFAULT_VARIANT, XKB_DEFAULT_MODEL
// and XKB_DEFAULT_OPTIONS (what the session launcher exports from the
// system settings; "us" when unset), as libxkbcommon would, and follows
// every key for the serialized modifiers. A keymap can also be given as a
// file (MLX_XKB_KEYMAP, text as `xkbcli compile-keymap` writes it). Without
// either, modifiers are tracked for the usual keys (Shift, Caps Lock,
// Control, Alt, Num Lock, Super, AltGr) with the real modifiers' standard
// bits.

const std = @import("std")
const builtin = @import("builtin")
const wl = @import("std.wayland")
const xkb_model = @import("std.xkb")
const keysym = @import("std.xkb.keysym")
const xkb_parse = @import("std.xkb.parse")
const xkb_compile = @import("std.xkb.compile")
const xkb_write = @import("std.xkb.write")
const xkb_state = @import("std.xkb.state")
const state = @import("./state.mlx")
const device = @import("./device.mlx")

const Compositor = state.Compositor

pub const Keyboard = struct {
    names: keysym.Names
    // The keymap (*xkb.Keymap, 0 without one) and the state on it.
    keymap: usize
    hasState: bool
    state: xkb_state.State
    memory: wl.SharedMemory
    depressed: u32
    latched: u32
    locked: u32
    group: u32
    // Keys (evdev codes below 256) and pointer buttons (bit n: code 272 + n)
    // held down now, to let go of when the session leaves the foreground.
    pressedKeys: [32]u8
    pressedButtons: u32
}

fn namesOf(keyboard: *Keyboard) -> *keysym.Names {
    unsafe { return @ptrCast(*keysym.Names, &keyboard.*.names) }
}

fn keymapOf(keyboard: *Keyboard) -> *xkb_model.Keymap {
    unsafe { return @ptrFromInt(*xkb_model.Keymap, keyboard.*.keymap) }
}

fn stateOf(keyboard: *Keyboard) -> *xkb_state.State {
    unsafe { return @ptrCast(*xkb_state.State, &keyboard.*.state) }
}

// Hands `text` (`length` bytes) to clients as the keymap.
fn publish(keyboard: *Keyboard, compositor: *Compositor, text: [*]const u8, length: usize) -> bool {
    var memory: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&memory, length + 1) { return false }
    const bytes = memory.bytes()
    var index: usize = 0
    while index < length {
        bytes[index] = text[index]
        index += 1
    }
    bytes[length] = 0
    keyboard.*.memory = memory
    compositor.*.keymap = memory.handle
    compositor.*.keymapFormat = 1
    compositor.*.keymapSize = @intCast(u32, length + 1)
    compositor.*.hasKeymap = true
    return true
}

// The state follows the keymap from here on.
fn startState(keyboard: *Keyboard) -> void {
    xkb_state.init(stateOf(keyboard), keymapOf(keyboard))
    keyboard.*.hasState = true
}

// The settings' layout and variant (keyboard-layout, keyboard-variant),
// empty when they name none.
fn settingsLayout(compositor: *Compositor) -> []const u8 { return nameOf(&compositor.*.keyboardLayout) }

fn settingsVariant(compositor: *Compositor) -> []const u8 { return nameOf(&compositor.*.keyboardVariant) }

fn nameOf(name: *const [32]u8) -> []const u8 {
    const bytes: [*]const u8 = name
    var length: usize = 0
    while length < 31 && bytes[length] != 0 { length += 1 }
    return bytes[0..length]
}

// Compiles the keymap for the settings' layout, else the XKB_DEFAULT_*
// names.
fn loadNames(keyboard: *Keyboard, compositor: *Compositor) -> bool {
    var compiler: xkb_compile.Compiler = undefined
    xkb_compile.init(&compiler, compositor.*.allocator, namesOf(keyboard), compositor.*.environment)
    const layout = settingsLayout(compositor)
    const compiled = if layout.length > 0 { xkb_compile.fromNames(&compiler, keymapOf(keyboard), "", "pc105", layout, settingsVariant(compositor), "") } else { xkb_compile.fromEnvironment(&compiler, keymapOf(keyboard), compositor.*.environment) }
    if !compiled {
        state.say("keyboard: no keymap for XKB_DEFAULT_LAYOUT: ")
        state.say(xkb_compile.message(&compiler))
        state.say("\n")
        return false
    }
    const text = xkb_write.keymap(keymapOf(keyboard), compositor.*.allocator)
    const published = publish(keyboard, compositor, text.items, text.length)
    text.deinit()
    if published { startState(keyboard) }
    return published
}

// A keymap file named by MLX_XKB_KEYMAP.
fn loadFile(keyboard: *Keyboard, compositor: *Compositor) -> bool {
    const path = state.environmentValue(compositor.*.environment, "MLX_XKB_KEYMAP")
    if @intFromPtr(path) == 0 { return false }
    return loadPath(keyboard, compositor, path)
}

// brixOS: the system's keymap for the layout (the settings', else
// XKB_DEFAULT_LAYOUT, else us), /system/settings/keyboard/LAYOUT.xkb or,
// with a variant, LAYOUT-VARIANT.xkb, compiled on the host by
// projects/brix/tools/keymap into the boot image (no XKB data there).
fn loadSystem(keyboard: *Keyboard, compositor: *Compositor) -> bool {
    if comptime builtin.os != builtin.Os.brixos { return false }
    var path: [128]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 127, "/system/settings/keyboard/")
    const layout = state.environmentValue(compositor.*.environment, "XKB_DEFAULT_LAYOUT")
    const chosen = settingsLayout(compositor)
    if chosen.length > 0 {
        length = std.text.append(bytes, length, 127, chosen)
        const variant = settingsVariant(compositor)
        if variant.length > 0 {
            length = std.text.append(bytes, length, 127, "-")
            length = std.text.append(bytes, length, 127, variant)
        }
    } else if @intFromPtr(layout) != 0 && layout[0] != 0 {
        var index: usize = 0
        while layout[index] != 0 && length < 100 {
            bytes[length] = layout[index]
            length += 1
            index += 1
        }
    } else {
        length = std.text.append(bytes, length, 127, "us")
    }
    length = std.text.append(bytes, length, 127, ".xkb")
    bytes[length] = 0
    return loadPath(keyboard, compositor, bytes)
}

// The keymap text at `path` (NUL-terminated), published to clients and
// read for the modifiers.
fn loadPath(keyboard: *Keyboard, compositor: *Compositor, path: [*]const u8) -> bool {
    const capacity: usize = 262144
    const buffer = compositor.*.allocator.alloc(capacity, 16).?
    var length = std.fs.readFile(path, buffer, capacity)
    while length > 0 && buffer[length - 1] == 0 { length -= 1 }
    const published = length > 0 && publish(keyboard, compositor, buffer, length)
    // The modifiers follow it when std.xkb reads it.
    if published && xkb_parse.parse(keymapOf(keyboard), buffer[0..length]) { startState(keyboard) }
    compositor.*.allocator.free(buffer, capacity, 16)
    return published
}

// The settings named another keyboard layout (settings.mlx): the keymap is
// made again and handed to every client keyboard. The backends call this
// each turn.
pub fn reloadIfWanted(keyboard: *Keyboard, compositor: *Compositor) -> void {
    if !compositor.*.keymapWanted { return }
    compositor.*.keymapWanted = false
    if keyboard.*.keymap != 0 {
        xkb_model.destroy(keymapOf(keyboard), compositor.*.allocator)
        keyboard.*.keymap = 0
    }
    if !load(keyboard, compositor) { return }
    var index: usize = 0
    while index < compositor.*.keyboards.length {
        const seat: *state.SeatResource = unsafe { @ptrFromInt(*state.SeatResource, state.listAt(compositor.*.keyboards, index)) }
        wl.wl_keyboard.Resource.fromObject(seat.*.object).sendKeymap(compositor.*.keymapFormat, compositor.*.keymap, compositor.*.keymapSize)
        index += 1
    }
    state.say("keyboard: layout changed\n")
}

// Makes the keymap (see the top of the file). False when there is none:
// clients then get no keymap.
pub fn load(keyboard: *Keyboard, compositor: *Compositor) -> bool {
    compositor.*.keymapWanted = false
    keyboard.*.keymap = 0
    keyboard.*.hasState = false
    keyboard.*.depressed = 0
    keyboard.*.latched = 0
    keyboard.*.locked = 0
    keyboard.*.group = 0
    keyboard.*.pressedButtons = 0
    var index: usize = 0
    while index < 32 {
        keyboard.*.pressedKeys[index] = 0
        index += 1
    }
    if !keysym.init(namesOf(keyboard), compositor.*.allocator) {
        state.say("keyboard: no keysym names; no keymap\n")
        return false
    }
    keyboard.*.keymap = @intFromPtr(xkb_model.create(compositor.*.allocator, namesOf(keyboard)))
    if settingsLayout(compositor).length == 0 && loadFile(keyboard, compositor) {
        state.say("keyboard: keymap from MLX_XKB_KEYMAP\n")
        return true
    }
    if loadSystem(keyboard, compositor) {
        if compositor.*.verbose { state.say("keyboard: keymap from /system/settings/keyboard\n") }
        return true
    }
    xkb_model.clear(keymapOf(keyboard), namesOf(keyboard))
    if loadNames(keyboard, compositor) {
        if compositor.*.verbose { state.say("keyboard: xkb keymap from the XKB data (std.xkb)\n") }
        return true
    }
    state.say("keyboard: no keymap (install the XKB data, xkb-data, or set MLX_XKB_KEYMAP)\n")
    return false
}

// The modifier bit a key holds or locks without a keymap (0: none),
// and whether it locks.
fn modifierOf(key: u32, locks: *bool) -> u32 {
    locks.* = false
    if key == 42 || key == 54 { return 1 }
    if key == 58 {
        locks.* = true
        return 2
    }
    if key == 29 || key == 97 { return 4 }
    if key == 56 { return 8 }
    if key == 69 {
        locks.* = true
        return 16
    }
    if key == 125 || key == 126 { return 64 }
    if key == 100 { return 128 }
    return 0
}

// Whether key `code` is held down.
pub fn isPressed(keyboard: *const Keyboard, code: u32) -> bool {
    return (keyboard.*.pressedKeys[@intCast(usize, code / 8)] >> @intCast(u8, code % 8)) & 1 != 0
}

// Follows a key press or release (evdev code). True when the modifiers
// changed (read them from the keyboard).
pub fn key(keyboard: *Keyboard, code: u32, pressed: bool) -> bool {
    if code < 256 {
        const bit = @intCast(u8, 1) << @intCast(u8, code % 8)
        const slot = @intCast(usize, code / 8)
        if pressed {
            keyboard.*.pressedKeys[slot] = keyboard.*.pressedKeys[slot] | bit
        } else {
            keyboard.*.pressedKeys[slot] = keyboard.*.pressedKeys[slot] & (255 ^ bit)
        }
    }
    const before_depressed = keyboard.*.depressed
    const before_latched = keyboard.*.latched
    const before_locked = keyboard.*.locked
    const before_group = keyboard.*.group
    if keyboard.*.hasState {
        const keyboard_state = stateOf(keyboard)
        _ = xkb_state.updateKey(keyboard_state, code + 8, pressed)
        keyboard.*.depressed = xkb_state.depressedMods(keyboard_state)
        keyboard.*.latched = xkb_state.latchedMods(keyboard_state)
        keyboard.*.locked = xkb_state.lockedMods(keyboard_state)
        keyboard.*.group = xkb_state.effectiveGroup(keyboard_state)
    } else {
        var locks = false
        const bit = modifierOf(code, &locks)
        if bit != 0 {
            if locks {
                if pressed { keyboard.*.locked = keyboard.*.locked ^ bit }
            } else if pressed {
                keyboard.*.depressed = keyboard.*.depressed | bit
            } else {
                keyboard.*.depressed = keyboard.*.depressed & (4294967295 ^ bit)
            }
        }
    }
    return keyboard.*.depressed != before_depressed || keyboard.*.latched != before_latched || keyboard.*.locked != before_locked || keyboard.*.group != before_group
}
