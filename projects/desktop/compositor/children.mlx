// The compositor's children on Linux: programs it launches (Alt+Enter's
// terminal, --run, the launcher's choices) and the helpers that stay
// (launcher, dock, top bar, the greeter), each on one end of a socket
// pair it hears them on. brixOS has children.brixos.mlx (process_spawn
// with the helper's channel end as a handle; the compiler picks it for
// that target): the same interface, so launching.mlx is one code.
//
//   children.makeChannel(&ours, &theirs)       a pair; ours non-blocking, not inherited
//   children.childNumber(theirs)               the number the child sees it as
//   children.runWith(compositor, program, environment, theirs)   -> pid, theirs closed here
//   children.tell(channel, byte), children.receive(channel, into, capacity), children.closeChannel(channel)
//   children.reap() -> the next child that ended (0: none); children.kill(pid)
const std = @import("std")
const spawn_module = @import("std.spawn")
const state = @import("./state.mlx")
const shell = @import("./shell.mlx")

const SOCK_STREAM_CLOEXEC: usize = 524289

pub fn makeChannel(ours: *isize, theirs: *isize) -> bool {
    var descriptors: [2]i32 = [2]i32{ -1, -1 }
    if std.linux.syscall4(std.linux.SYS_socketpair, 1, SOCK_STREAM_CLOEXEC, 0, @intFromPtr(&descriptors)) != 0 { return false }
    ours.* = @intCast(isize, descriptors[0])
    theirs.* = @intCast(isize, descriptors[1])
    _ = std.linux.syscall3(std.linux.SYS_fcntl, @bitCast(usize, ours.*), std.linux.F_SETFL, std.linux.O_NONBLOCK)
    return true
}

pub fn childNumber(theirs: isize) -> usize { return @bitCast(usize, theirs) }

// Runs `program` (a path, or a name looked up in PATH) with
// `environment`; `theirs` (-1: none) stays open in the child at its
// number, closed here. The child's pid, or -1.
pub fn runWith(compositor: *shell.Compositor, program: [*]const u8, environment: [*][*]const u8, theirs: isize) -> isize {
    sayLaunch(compositor, program)
    const child = std.linux.process.fork()
    if child == 0 {
        if theirs >= 0 { _ = std.linux.keepOnExec(theirs) }
        var arguments: [2][*]const u8 = undefined
        unsafe {
            arguments[0] = program
            arguments[1] = @ptrFromInt([*]const u8, 0)
            // Without PATH a name runs nowhere.
            spawn_module.execute(program, @ptrCast([*][*]const u8, &arguments), environment, "")
        }
        std.linux.exitGroup(127)
    }
    if theirs >= 0 { std.linux.close(theirs) }
    return if child > 0 { child } else { -1 }
}

pub fn sayLaunch(compositor: *shell.Compositor, program: [*]const u8) -> void {
    if !compositor.*.verbose { return }
    state.say("launch: ")
    var length: usize = 0
    while program[length] != 0 { length += 1 }
    _ = std.io.writeAllBytes(std.io.stdout(), program, length)
    state.say("\n")
}

// One byte to a helper; false when it is gone (never a SIGPIPE:
// MSG_NOSIGNAL; a full buffer, -EAGAIN, means busy, not gone).
pub fn tell(channel: isize, byte: u8) -> bool {
    var bytes: [1]u8 = [1]u8{ byte }
    const sent = std.linux.syscall6(std.linux.SYS_sendto, @bitCast(usize, channel), @intFromPtr(&bytes), 1, std.linux.socket.MSG_DONTWAIT | std.linux.socket.MSG_NOSIGNAL, 0, 0)
    return sent == 1 || sent == -11
}

// What a helper sent: the bytes (0: it is gone; -11: nothing now).
pub fn receive(channel: isize, into: [*]u8, capacity: usize) -> isize {
    const count = std.linux.read(channel, into, capacity)
    if count < 0 && count != -11 { return 0 }
    return count
}

pub fn closeChannel(channel: isize) -> void {
    if channel >= 0 { std.linux.close(channel) }
}

// The next child that ended (reaped), or 0.
pub fn reap() -> isize {
    var status: usize = 0
    const pid = std.linux.process.waitProcess(-1, &status, std.linux.WNOHANG)
    return if pid > 0 { pid } else { 0 }
}

pub fn kill(pid: isize) -> void {
    if pid > 0 { _ = std.linux.process.kill(pid, std.linux.SIGKILL) }
}
