// The primary selection (zwp_primary_selection_device_manager_v1): what was
// last selected in any program, pasted with a middle click. It works as
// the clipboard does (data.mlx) without drags: a client sets a source on
// its device, the client with the keyboard gets the selection as an offer
// when it gains the focus and whenever the selection changes, and reading
// an offer has the source's client write the data into the reader's pipe.
// A greeter compositor does not offer it (shell_table.mlx).
//
// X programs share it as PRIMARY (xwm_selection.mlx): an X program's
// selection comes as an X source (no client of ours: the window manager
// converts it), and every change is told to the X side. Clipboard tools
// see and set it through ext-data-control (data_control.mlx).

const std = @import("std")
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const xwm_selection = @import("./xwm_selection.mlx")
const data_control = @import("./data_control.mlx")

const SYS_fcntl: usize = 72
const F_DUPFD_CLOEXEC: usize = 1030

const Compositor = state.Compositor

// Room for a source's MIME types, each a length byte and its bytes.
const MIME_BYTES: usize = 4096

pub const Source = struct {
    compositor: *Compositor
    resource: wl.server.Object
    mimes: [*]u8
    mimeBytes: usize
    // An X program's PRIMARY (resource: none; xwm_selection reads it).
    x: bool
    // A clipboard tool's (resource: its ext_data_control_source_v1).
    control: bool
}

pub const Device = struct {
    compositor: *Compositor
    resource: wl.server.Object
}

pub const Offer = struct {
    compositor: *Compositor
    resource: wl.server.Object
    // The Source it reads from; 0 once that source is gone.
    source: usize
}

fn sourceAt(address: usize) -> *Source {
    unsafe { return @ptrFromInt(*Source, address) }
}

fn deviceAt(address: usize) -> *Device {
    unsafe { return @ptrFromInt(*Device, address) }
}

fn offerAt(address: usize) -> *Offer {
    unsafe { return @ptrFromInt(*Offer, address) }
}

fn recordOf(context: *anyopaque) -> usize { return @intFromPtr(context) }

fn contextAt(address: usize) -> *anyopaque {
    unsafe { return @ptrFromInt(*anyopaque, address) }
}

fn findSource(compositor: *Compositor, object: wl.server.Object) -> usize {
    var index: usize = 0
    while index < compositor.*.primarySources.length {
        const address = state.listAt(compositor.*.primarySources, index)
        const source = sourceAt(address)
        if source.*.resource.id == object.id && state.sameClient(source.*.resource, object) { return address }
        index += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Offering the selection

// Sends the selection to `device`: a new offer listing the source's MIME
// types, or none when nothing is selected.
fn offerSelection(compositor: *Compositor, device: *Device) -> void {
    const resource = wl.zwp_primary_selection_device_v1.Resource.fromObject(device.*.resource)
    if compositor.*.primarySelection == 0 {
        resource.sendSelection(null)
        return
    }
    const source = sourceAt(compositor.*.primarySelection)
    var offer = resource.sendDataOffer()
    if offer.isNull() { return }
    const memory = state.allocate(compositor, @sizeOf(Offer))
    const address = @intFromPtr(memory)
    const record = offerAt(address)
    record.*.compositor = compositor
    record.*.resource = offer.object
    record.*.source = compositor.*.primarySelection
    compositor.*.primaryOffers = state.listAppend(compositor.*.primaryOffers, address)
    offer.setHandler(onOffer, contextAt(address))
    offer.setDestroyHandler(onOfferDestroyed, contextAt(address))
    var at: usize = 0
    while at < source.*.mimeBytes {
        const length = @intCast(usize, source.*.mimes[at])
        offer.sendOffer(source.*.mimes[at + 1..at + 1 + length])
        at += 1 + length
    }
    resource.sendSelection(&offer)
}

// Gives the client with keyboard focus the primary selection (on every
// device it has). Called with the clipboard's offerToFocus when the focus
// or the selection changed, before the keyboard enter event.
pub fn offerToFocus(compositor: *Compositor) -> void {
    const focused = compositor.*.keyboardFocus
    if focused == 0 || !compositor.*.hasPrimarySelection { return }
    const surface = state.surfaceAt(focused).*.resource
    var index: usize = 0
    while index < compositor.*.primaryDevices.length {
        const device = deviceAt(state.listAt(compositor.*.primaryDevices, index))
        if state.sameClient(device.*.resource, surface) { offerSelection(compositor, device) }
        index += 1
    }
}

// A source's client hears it is no longer the selection.
fn cancelSource(source: *Source) -> void {
    if source.*.x { return }
    if source.*.control {
        wl.ext_data_control_source_v1.Resource.fromObject(source.*.resource).sendCancelled()
    } else {
        wl.zwp_primary_selection_source_v1.Resource.fromObject(source.*.resource).sendCancelled()
    }
}

// Asks a source's client to write its data as `mime` into `fd` (it gets
// a copy).
fn askSource(source: *Source, mime: []const u8, fd: wl.server.Handle) -> void {
    if source.*.control {
        wl.ext_data_control_source_v1.Resource.fromObject(source.*.resource).sendSend(mime, fd)
    } else {
        wl.zwp_primary_selection_source_v1.Resource.fromObject(source.*.resource).sendSend(mime, fd)
    }
}

fn setSelection(compositor: *Compositor, address: usize) -> void {
    const old = compositor.*.primarySelection
    if old == address { return }
    // The replaced source learns that it is no longer the selection.
    if old != 0 { cancelSource(sourceAt(old)) }
    compositor.*.primarySelection = address
    if compositor.*.verbose {
        if address == 0 { state.say("primary selection: cleared\n") } else { state.say("primary selection: set\n") }
    }
    offerToFocus(compositor)
    xwm_selection.primaryChanged(compositor)
    data_control.primaryChanged(compositor)
}

// ---------------------------------------------------------------------------
// The offer

fn onOffer(context: *anyopaque, request: wl.server.Request) -> void {
    const offer = offerAt(recordOf(context))
    if request.opcode != wl.zwp_primary_selection_offer_v1.REQUEST_RECEIVE { return }
    const receive = wl.zwp_primary_selection_offer_v1.decodeRequest(request).receive
    const mime = receive.mime_type
    receiveFrom(offer.*.compositor, offer.*.source, mime.pointer[0..mime.length], receive.fd)
    receive.fd.close()
}

// An offer of the source at `address` read as `mime` into `fd` (the
// caller closes its own): the source's client writes into the pipe
// (sendSend passes a copy) and the reader sees end of file once the
// writer closes it. An X program's is converted into a copy of the pipe.
fn receiveFrom(compositor: *Compositor, address: usize, mime: []const u8, fd: wl.server.Handle) -> void {
    if address == 0 { return }
    if sourceAt(address).*.x {
        const copy = std.linux.syscall3(SYS_fcntl, @bitCast(usize, fd.descriptor), F_DUPFD_CLOEXEC, 0)
        if copy >= 0 { xwm_selection.receivePrimary(compositor, mime, copy) }
    } else {
        askSource(sourceAt(address), mime, fd)
    }
}

fn onOfferDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = recordOf(context)
    const compositor = offerAt(address).*.compositor
    compositor.*.primaryOffers = state.listRemove(compositor.*.primaryOffers, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Offer)) }
}

// ---------------------------------------------------------------------------
// The source

fn onSource(context: *anyopaque, request: wl.server.Request) -> void {
    const source = sourceAt(recordOf(context))
    if request.opcode != wl.zwp_primary_selection_source_v1.REQUEST_OFFER { return }
    const mime = wl.zwp_primary_selection_source_v1.decodeRequest(request).offer.mime_type
    addType(source, mime.pointer[0..mime.length])
}

fn onSourceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    forgetSource(recordOf(context))
}

// A source gone: its offers read nothing more, and a selection of it
// ends.
fn forgetSource(address: usize) -> void {
    const source = sourceAt(address)
    const compositor = source.*.compositor
    compositor.*.primarySources = state.listRemove(compositor.*.primarySources, address)
    var index: usize = 0
    while index < compositor.*.primaryOffers.length {
        const offer = offerAt(state.listAt(compositor.*.primaryOffers, index))
        if offer.*.source == address { offer.*.source = 0 }
        index += 1
    }
    if compositor.*.primarySelection == address {
        compositor.*.primarySelection = 0
        offerToFocus(compositor)
        if !source.*.x { xwm_selection.primaryChanged(compositor) }
        data_control.primaryChanged(compositor)
    }
    state.release(compositor, source.*.mimes, MIME_BYTES)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Source)) }
}

fn newSource(compositor: *Compositor) -> usize {
    const memory = state.allocate(compositor, @sizeOf(Source))
    const address = @intFromPtr(memory)
    const source = sourceAt(address)
    source.*.compositor = compositor
    source.*.mimes = state.allocate(compositor, MIME_BYTES)
    source.*.mimeBytes = 0
    source.*.x = false
    source.*.control = false
    compositor.*.primarySources = state.listAppend(compositor.*.primarySources, address)
    return address
}

fn addType(source: *Source, mime: []const u8) -> void {
    if mime.length == 0 || mime.length > 255 || source.*.mimeBytes + 1 + mime.length > MIME_BYTES { return }
    source.*.mimes[source.*.mimeBytes] = @intCast(u8, mime.length)
    var index: usize = 0
    while index < mime.length {
        source.*.mimes[source.*.mimeBytes + 1 + index] = mime[index]
        index += 1
    }
    source.*.mimeBytes += 1 + mime.length
}

// ---------------------------------------------------------------------------
// X sources (xwm_selection.mlx)

// A source standing for an X program's PRIMARY (its types added with
// addXSourceType); 0 without the primary selection.
pub fn newXSource(compositor: *Compositor) -> usize {
    if !compositor.*.hasPrimarySelection { return 0 }
    const address = newSource(compositor)
    // No client's: an id no object has.
    sourceAt(address).*.resource.id = 0
    sourceAt(address).*.x = true
    return address
}

pub fn addXSourceType(address: usize, mime: []const u8) -> void {
    if address == 0 { return }
    const source = sourceAt(address)
    var at: usize = 0
    while at < source.*.mimeBytes {
        const length = @intCast(usize, source.*.mimes[at])
        if std.text.same(source.*.mimes[at + 1..at + 1 + length], mime) { return }
        at += 1 + length
    }
    addType(source, mime)
}

pub fn setXSelection(compositor: *Compositor, address: usize) -> void {
    if address != 0 { setSelection(compositor, address) }
}

pub fn dropXSource(compositor: *Compositor, address: usize) -> void {
    if address != 0 { forgetSource(address) }
}

// A source's types: a length byte and the type each.
pub fn typesOf(address: usize) -> []const u8 {
    if address == 0 { return "" }
    return sourceAt(address).*.mimes[0..sourceAt(address).*.mimeBytes]
}

// Whether the source at `address` is an X program's.
pub fn isX(address: usize) -> bool {
    return address != 0 && sourceAt(address).*.x
}

// Asks a client's source to write its data as `mime` into `descriptor`
// (a pipe's end; the caller closes its own).
pub fn sendFromSource(compositor: *Compositor, address: usize, mime: []const u8, descriptor: isize) -> void {
    if address == 0 || sourceAt(address).*.x || !state.listContains(compositor.*.primarySources, address) { return }
    askSource(sourceAt(address), mime, wl.server.Handle.fromDescriptor(descriptor))
}

// ---------------------------------------------------------------------------
// Clipboard tools (data_control.mlx)

// A clipboard tool's source made the primary selection, with `types`
// (data.typesOf's form); 0 without the primary selection.
pub fn setControlSource(compositor: *Compositor, resource: wl.server.Object, types: []const u8) -> usize {
    if !compositor.*.hasPrimarySelection { return 0 }
    const address = newSource(compositor)
    const source = sourceAt(address)
    source.*.resource = resource
    source.*.control = true
    var at: usize = 0
    while at < types.length {
        const length = @intCast(usize, types[at])
        addType(source, types[at + 1..at + 1 + length])
        at += 1 + length
    }
    setSelection(compositor, address)
    return address
}

// No primary selection, from a clipboard tool.
pub fn clearFromControl(compositor: *Compositor) -> void {
    if compositor.*.hasPrimarySelection { setSelection(compositor, 0) }
}

pub fn dropControlSource(address: usize) -> void {
    if address != 0 { forgetSource(address) }
}

// An offer of the primary selection for a clipboard tool's `resource`.
pub fn newControlOffer(compositor: *Compositor, resource: wl.server.Object) -> usize {
    const address = @intFromPtr(state.allocate(compositor, @sizeOf(Offer)))
    offerAt(address).*.compositor = compositor
    offerAt(address).*.resource = resource
    offerAt(address).*.source = compositor.*.primarySelection
    compositor.*.primaryOffers = state.listAppend(compositor.*.primaryOffers, address)
    return address
}

pub fn controlReceive(address: usize, mime: []const u8, fd: wl.server.Handle) -> void {
    receiveFrom(offerAt(address).*.compositor, offerAt(address).*.source, mime, fd)
}

pub fn dropControlOffer(address: usize) -> void {
    const compositor = offerAt(address).*.compositor
    compositor.*.primaryOffers = state.listRemove(compositor.*.primaryOffers, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Offer)) }
}

// ---------------------------------------------------------------------------
// The device and the manager

fn onDevice(context: *anyopaque, request: wl.server.Request) -> void {
    const device = deviceAt(recordOf(context))
    const compositor = device.*.compositor
    if request.opcode != wl.zwp_primary_selection_device_v1.REQUEST_SET_SELECTION { return }
    const source = wl.zwp_primary_selection_device_v1.decodeRequest(request).set_selection.source
    // Only the client with the keyboard sets it (one whose window went
    // to the background cannot take it over).
    const focused = compositor.*.keyboardFocus
    if focused == 0 || !state.sameClient(device.*.resource, state.surfaceAt(focused).*.resource) {
        if !source.isNull() { wl.zwp_primary_selection_source_v1.Resource.fromObject(source.object).sendCancelled() }
        return
    }
    setSelection(compositor, if source.isNull() { 0 } else { findSource(compositor, source.object) })
}

fn onDeviceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = recordOf(context)
    const compositor = deviceAt(address).*.compositor
    compositor.*.primaryDevices = state.listRemove(compositor.*.primaryDevices, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Device)) }
}

fn onManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.zwp_primary_selection_device_manager_v1.decodeRequest(request)
    if request.opcode == wl.zwp_primary_selection_device_manager_v1.REQUEST_CREATE_SOURCE {
        const resource = decoded.create_source.id
        const address = newSource(compositor)
        sourceAt(address).*.resource = resource.object
        resource.setHandler(onSource, contextAt(address))
        resource.setDestroyHandler(onSourceDestroyed, contextAt(address))
    } else if request.opcode == wl.zwp_primary_selection_device_manager_v1.REQUEST_GET_DEVICE {
        const resource = decoded.get_device.id
        const memory = state.allocate(compositor, @sizeOf(Device))
        const address = @intFromPtr(memory)
        const device = deviceAt(address)
        device.*.compositor = compositor
        device.*.resource = resource.object
        compositor.*.primaryDevices = state.listAppend(compositor.*.primaryDevices, address)
        resource.setHandler(onDevice, contextAt(address))
        resource.setDestroyHandler(onDeviceDestroyed, contextAt(address))
        // A client that already has focus gets the selection right away.
        const focused = compositor.*.keyboardFocus
        if focused != 0 && state.sameClient(resource.object, state.surfaceAt(focused).*.resource) { offerSelection(compositor, device) }
    }
}

fn bindManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.zwp_primary_selection_device_manager_v1.Resource.fromObject(object).setHandler(onManager, context)
}

pub fn createGlobal(compositor: *Compositor) -> bool {
    compositor.*.primarySources = state.newList(compositor.*.allocator)
    compositor.*.primaryDevices = state.newList(compositor.*.allocator)
    compositor.*.primaryOffers = state.newList(compositor.*.allocator)
    compositor.*.primarySelection = 0
    compositor.*.hasPrimarySelection = true
    const memory: [*]u8 = unsafe { @ptrCast([*]u8, compositor) }
    return compositor.*.server.createGlobal(wl.Interface.zwp_primary_selection_device_manager_v1, 1, bindManager, state.contextOf(memory)) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name (see
// data.mlx; tools/check_compositor_modules.py checks the table).

pub const HANDLER_COUNT: usize = 8

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindManager) }
    if index == 1 { return @intFromPtr(onDevice) }
    if index == 2 { return @intFromPtr(onDeviceDestroyed) }
    if index == 3 { return @intFromPtr(onManager) }
    if index == 4 { return @intFromPtr(onOffer) }
    if index == 5 { return @intFromPtr(onOfferDestroyed) }
    if index == 6 { return @intFromPtr(onSource) }
    if index == 7 { return @intFromPtr(onSourceDestroyed) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "primary.bindManager" }
    if index == 1 { return "primary.onDevice" }
    if index == 2 { return "primary.onDeviceDestroyed" }
    if index == 3 { return "primary.onManager" }
    if index == 4 { return "primary.onOffer" }
    if index == 5 { return "primary.onOfferDestroyed" }
    if index == 6 { return "primary.onSource" }
    if index == 7 { return "primary.onSourceDestroyed" }
    return ""
}
