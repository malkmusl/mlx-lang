// Clipboard tools (ext_data_control_manager_v1, ext-data-control, and
// zwlr_data_control_manager_v1 version 2, the wlr protocol it was made
// from, which wl-clipboard 2.2 speaks): a program without a window of its
// own (wl-copy and wl-paste, clipboard managers) reads and sets the
// selection and the primary selection. Its device hears every change of
// either (an offer listing the types, or none) without having the
// keyboard; its source set as the selection (data.mlx) or the primary
// selection (primary.mlx) is read like a client's, and is told when
// another selection replaces it. A source is used once (`used_source` for
// another set), and takes no more types once used (`invalid_offer`). A
// greeter compositor does not offer it (shell_table.mlx).
//
// The two protocols' requests and events are the same message for
// message, so requests of either are decoded as ext-data-control's and a
// wlr source hears send and cancelled through the same calls; only the
// offers a device is sent are made of its own protocol's interface.
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const data = @import("./data.mlx")
const primary = @import("./primary.mlx")

const Compositor = state.Compositor

// A tool's ext_data_control_source_v1: the data.Source keeping its types
// (the selection's when set as that), the primary.Source made when it is
// set as the primary selection, and whether it was set.
pub const ControlSource = struct {
    compositor: *Compositor
    resource: wl.server.Object
    clipboard: usize
    primary: usize
    used: bool
}

// A device, and whether it is a zwlr_data_control_device_v1.
pub const ControlDevice = struct {
    compositor: *Compositor
    resource: wl.server.Object
    wlr: bool
}

fn sourceAt(address: usize) -> *ControlSource {
    unsafe { return @ptrFromInt(*ControlSource, address) }
}

fn deviceAt(address: usize) -> *ControlDevice {
    unsafe { return @ptrFromInt(*ControlDevice, address) }
}

fn contextAt(address: usize) -> *anyopaque {
    unsafe { return @ptrFromInt(*anyopaque, address) }
}

fn findSource(compositor: *Compositor, object: wl.server.Object) -> usize {
    var index: usize = 0
    while index < compositor.*.controlSources.length {
        const address = state.listAt(compositor.*.controlSources, index)
        const source = sourceAt(address)
        if source.*.resource.id == object.id && state.sameClient(source.*.resource, object) { return address }
        index += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Offers

fn onClipboardOffer(context: *anyopaque, request: wl.server.Request) -> void {
    if request.opcode != wl.ext_data_control_offer_v1.REQUEST_RECEIVE { return }
    const receive = wl.ext_data_control_offer_v1.decodeRequest(request).receive
    const mime = receive.mime_type
    data.controlReceive(@intFromPtr(context), mime.pointer[0..mime.length], receive.fd)
    receive.fd.close()
}

fn onClipboardOfferDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    data.dropControlOffer(@intFromPtr(context))
}

fn onPrimaryOffer(context: *anyopaque, request: wl.server.Request) -> void {
    if request.opcode != wl.ext_data_control_offer_v1.REQUEST_RECEIVE { return }
    const receive = wl.ext_data_control_offer_v1.decodeRequest(request).receive
    const mime = receive.mime_type
    primary.controlReceive(@intFromPtr(context), mime.pointer[0..mime.length], receive.fd)
    receive.fd.close()
}

fn onPrimaryOfferDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    primary.dropControlOffer(@intFromPtr(context))
}

// A new offer of the selection (or the primary selection) watched: its
// record (data.mlx's or primary.mlx's) and handlers.
fn watchOffer(compositor: *Compositor, object: wl.server.Object, primary_selection: bool) -> void {
    if primary_selection {
        const address = primary.newControlOffer(compositor, object)
        wl.server.setHandler(object, onPrimaryOffer, contextAt(address))
        wl.server.setDestroyHandler(object, onPrimaryOfferDestroyed, contextAt(address))
    } else {
        const address = data.newControlOffer(compositor, object)
        wl.server.setHandler(object, onClipboardOffer, contextAt(address))
        wl.server.setDestroyHandler(object, onClipboardOfferDestroyed, contextAt(address))
    }
}

// The types of `types` (data.typesOf's form) as the offer's.
fn sendTypes(device: *ControlDevice, object: wl.server.Object, types: []const u8) -> void {
    var at: usize = 0
    while at < types.length {
        const length = @intCast(usize, types[at])
        const mime = types[at + 1..at + 1 + length]
        if device.*.wlr { wl.zwlr_data_control_offer_v1.Resource.fromObject(object).sendOffer(mime) } else { wl.ext_data_control_offer_v1.Resource.fromObject(object).sendOffer(mime) }
        at += 1 + length
    }
}

// The selection (or the primary selection) to `device`: a new offer of
// its types, or none.
fn offer(compositor: *Compositor, device: *ControlDevice, primary_selection: bool) -> void {
    if primary_selection && !compositor.*.hasPrimarySelection { return }
    const selected = if primary_selection { compositor.*.primarySelection } else { compositor.*.selection }
    const types = if primary_selection { primary.typesOf(selected) } else { data.typesOf(selected) }
    if device.*.wlr {
        const resource = wl.zwlr_data_control_device_v1.Resource.fromObject(device.*.resource)
        // Version 1 knows no primary selection.
        if primary_selection && resource.version() < 2 { return }
        if selected == 0 {
            if primary_selection { resource.sendPrimarySelection(null) } else { resource.sendSelection(null) }
            return
        }
        var made = resource.sendDataOffer()
        if made.isNull() { return }
        watchOffer(compositor, made.object, primary_selection)
        sendTypes(device, made.object, types)
        if primary_selection { resource.sendPrimarySelection(&made) } else { resource.sendSelection(&made) }
        return
    }
    const resource = wl.ext_data_control_device_v1.Resource.fromObject(device.*.resource)
    if selected == 0 {
        if primary_selection { resource.sendPrimarySelection(null) } else { resource.sendSelection(null) }
        return
    }
    var made = resource.sendDataOffer()
    if made.isNull() { return }
    watchOffer(compositor, made.object, primary_selection)
    sendTypes(device, made.object, types)
    if primary_selection { resource.sendPrimarySelection(&made) } else { resource.sendSelection(&made) }
}

// The selection changed (data.mlx): every tool hears of it.
pub fn selectionChanged(compositor: *Compositor) -> void {
    if !compositor.*.hasDataControl { return }
    var index: usize = 0
    while index < compositor.*.controlDevices.length {
        offer(compositor, deviceAt(state.listAt(compositor.*.controlDevices, index)), false)
        index += 1
    }
}

// The primary selection changed (primary.mlx).
pub fn primaryChanged(compositor: *Compositor) -> void {
    if !compositor.*.hasDataControl { return }
    var index: usize = 0
    while index < compositor.*.controlDevices.length {
        offer(compositor, deviceAt(state.listAt(compositor.*.controlDevices, index)), true)
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Sources

fn onSource(context: *anyopaque, request: wl.server.Request) -> void {
    const source = sourceAt(@intFromPtr(context))
    if request.opcode != wl.ext_data_control_source_v1.REQUEST_OFFER { return }
    if source.*.used {
        wl.ext_data_control_source_v1.Resource.fromObject(request.object).postError(@intFromEnum(wl.ext_data_control_source_v1.Error.invalid_offer), "a type offered after the source was set")
        return
    }
    const mime = wl.ext_data_control_source_v1.decodeRequest(request).offer.mime_type
    data.addControlType(source.*.clipboard, mime.pointer[0..mime.length])
}

fn onSourceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = @intFromPtr(context)
    const source = sourceAt(address)
    const compositor = source.*.compositor
    compositor.*.controlSources = state.listRemove(compositor.*.controlSources, address)
    data.dropControlSource(source.*.clipboard)
    primary.dropControlSource(source.*.primary)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(ControlSource)) }
}

// ---------------------------------------------------------------------------
// Devices and the manager

// The source a set_selection names (0 for none), marked used; false when
// it was used before (the device's client broke the protocol).
fn takeSource(compositor: *Compositor, device: wl.server.Object, named: wl.ext_data_control_source_v1.Resource, address: *usize) -> bool {
    address.* = 0
    if named.isNull() { return true }
    const found = findSource(compositor, named.object)
    if found == 0 { return true }
    if sourceAt(found).*.used {
        wl.ext_data_control_device_v1.Resource.fromObject(device).postError(@intFromEnum(wl.ext_data_control_device_v1.Error.used_source), "the source was set before")
        return false
    }
    sourceAt(found).*.used = true
    address.* = found
    return true
}

fn onDevice(context: *anyopaque, request: wl.server.Request) -> void {
    const device = deviceAt(@intFromPtr(context))
    const compositor = device.*.compositor
    const decoded = wl.ext_data_control_device_v1.decodeRequest(request)
    var address: usize = 0
    if request.opcode == wl.ext_data_control_device_v1.REQUEST_SET_SELECTION {
        if !takeSource(compositor, request.object, decoded.set_selection.source, &address) { return }
        if compositor.*.verbose { state.say(if address == 0 { "data control: selection cleared\n" } else { "data control: selection set\n" }) }
        data.setControlSelection(compositor, if address == 0 { 0 } else { sourceAt(address).*.clipboard })
    } else if request.opcode == wl.ext_data_control_device_v1.REQUEST_SET_PRIMARY_SELECTION {
        if !takeSource(compositor, request.object, decoded.set_primary_selection.source, &address) { return }
        if compositor.*.verbose { state.say(if address == 0 { "data control: primary selection cleared\n" } else { "data control: primary selection set\n" }) }
        if address == 0 {
            primary.clearFromControl(compositor)
        } else {
            const source = sourceAt(address)
            source.*.primary = primary.setControlSource(compositor, source.*.resource, data.typesOf(source.*.clipboard))
        }
    }
}

fn onDeviceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = @intFromPtr(context)
    const compositor = deviceAt(address).*.compositor
    compositor.*.controlDevices = state.listRemove(compositor.*.controlDevices, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(ControlDevice)) }
}

fn onManager(context: *anyopaque, request: wl.server.Request) -> void { manage(state.compositorOf(context), request, false) }

fn onWlrManager(context: *anyopaque, request: wl.server.Request) -> void { manage(state.compositorOf(context), request, true) }

fn manage(compositor: *Compositor, request: wl.server.Request, wlr: bool) -> void {
    const decoded = wl.ext_data_control_manager_v1.decodeRequest(request)
    if request.opcode == wl.ext_data_control_manager_v1.REQUEST_CREATE_DATA_SOURCE {
        const resource = decoded.create_data_source.id
        const address = @intFromPtr(state.allocate(compositor, @sizeOf(ControlSource)))
        const source = sourceAt(address)
        source.*.compositor = compositor
        source.*.resource = resource.object
        source.*.clipboard = data.newControlSource(compositor, resource.object)
        source.*.primary = 0
        source.*.used = false
        compositor.*.controlSources = state.listAppend(compositor.*.controlSources, address)
        resource.setHandler(onSource, contextAt(address))
        resource.setDestroyHandler(onSourceDestroyed, contextAt(address))
    } else if request.opcode == wl.ext_data_control_manager_v1.REQUEST_GET_DATA_DEVICE {
        const resource = decoded.get_data_device.id
        const address = @intFromPtr(state.allocate(compositor, @sizeOf(ControlDevice)))
        const device = deviceAt(address)
        device.*.compositor = compositor
        device.*.resource = resource.object
        device.*.wlr = wlr
        compositor.*.controlDevices = state.listAppend(compositor.*.controlDevices, address)
        resource.setHandler(onDevice, contextAt(address))
        resource.setDestroyHandler(onDeviceDestroyed, contextAt(address))
        // What is selected now, right away.
        offer(compositor, device, false)
        offer(compositor, device, true)
    }
}

fn bindManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.ext_data_control_manager_v1.Resource.fromObject(object).setHandler(onManager, context)
}

fn bindWlrManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.zwlr_data_control_manager_v1.Resource.fromObject(object).setHandler(onWlrManager, context)
}

pub fn createGlobals(compositor: *Compositor) -> bool {
    compositor.*.controlSources = state.newList(compositor.*.allocator)
    compositor.*.controlDevices = state.newList(compositor.*.allocator)
    compositor.*.hasDataControl = true
    const memory: [*]u8 = unsafe { @ptrCast([*]u8, compositor) }
    const context = state.contextOf(memory)
    if compositor.*.server.createGlobal(wl.Interface.ext_data_control_manager_v1, 1, bindManager, context) == 0 { return false }
    return compositor.*.server.createGlobal(wl.Interface.zwlr_data_control_manager_v1, 2, bindWlrManager, context) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name: when
// the shell is loaded again (modules.mlx), each resource's handler is
// replaced by the new code's function of the same name. Every function
// passed to setHandler, setDestroyHandler, createGlobal or a client
// handler here must be listed (tools/check_compositor_modules.py checks;
// --fix rewrites this table).

pub const HANDLER_COUNT: usize = 12

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindManager) }
    if index == 1 { return @intFromPtr(bindWlrManager) }
    if index == 2 { return @intFromPtr(onClipboardOffer) }
    if index == 3 { return @intFromPtr(onClipboardOfferDestroyed) }
    if index == 4 { return @intFromPtr(onDevice) }
    if index == 5 { return @intFromPtr(onDeviceDestroyed) }
    if index == 6 { return @intFromPtr(onManager) }
    if index == 7 { return @intFromPtr(onPrimaryOffer) }
    if index == 8 { return @intFromPtr(onPrimaryOfferDestroyed) }
    if index == 9 { return @intFromPtr(onSource) }
    if index == 10 { return @intFromPtr(onSourceDestroyed) }
    if index == 11 { return @intFromPtr(onWlrManager) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "data_control.bindManager" }
    if index == 1 { return "data_control.bindWlrManager" }
    if index == 2 { return "data_control.onClipboardOffer" }
    if index == 3 { return "data_control.onClipboardOfferDestroyed" }
    if index == 4 { return "data_control.onDevice" }
    if index == 5 { return "data_control.onDeviceDestroyed" }
    if index == 6 { return "data_control.onManager" }
    if index == 7 { return "data_control.onPrimaryOffer" }
    if index == 8 { return "data_control.onPrimaryOfferDestroyed" }
    if index == 9 { return "data_control.onSource" }
    if index == 10 { return "data_control.onSourceDestroyed" }
    if index == 11 { return "data_control.onWlrManager" }
    return ""
}
