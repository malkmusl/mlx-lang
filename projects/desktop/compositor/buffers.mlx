// What a commit does with the surface's buffer (part of windows.mlx,
// split from it): the CPU renderer copies it into the surface and releases
// it, the Vulkan renderer shows it in place until the next one; then the
// viewport (wp_viewport, viewport.mlx) crops and scales it to the
// surface's size. On the CPU the scaled pixels are made here, each the
// mean of 4x4 samples spread over the part of the crop it covers, as the
// Vulkan renderer's shrink shader takes them (vulkan.mlx), so both show
// the same pixels.
//
// The CPU renderer's copy is brought up to date only where the client
// says its buffer changed (wl_surface.damage, damage_buffer) when the
// buffer is the size of the one before: a terminal that printed a line
// has a line copied, not its window. The copy is what the client may not
// touch: it is released its buffer at once and draws its next frame into
// it while this one is composed, any number of times.
const wl = @import("std.wayland")
const ui = @import("std.ui")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const shell = @import("./shell.mlx")

const Surface = state.Surface

// The buffer and viewport state of a new surface: none.
pub fn initSurface(surface: *Surface) -> void {
    surface.*.copied = false
    surface.*.translucentRow = 0
    surface.*.transformed = false
    surface.*.viewport = 0
    surface.*.pendingCrop = [4]i32{ -256, -256, -256, -256 }
    surface.*.pendingViewWidth = -1
    surface.*.pendingViewHeight = -1
    surface.*.crop = ui.rect(0, 0, 0, 0)
    surface.*.viewWidth = 0
    surface.*.viewHeight = 0
    surface.*.bufferWidth = 0
    surface.*.bufferHeight = 0
    surface.*.scaledCopy = false
    surface.*.sourceCapacity = 0
    surface.*.scaled = 0
    surface.*.scaledSize = 0
    surface.*.scaledSerial = 0
    surface.*.fractionalScale = 0
}

pub fn releaseSurface(surface: *Surface) -> void {
    if surface.*.sourceCapacity > 0 { state.release(surface.*.compositor, surface.*.sourcePixels, surface.*.sourceCapacity) }
    surface.*.sourceCapacity = 0
}

// The buffer a commit attaches (a null one windows.mlx handles: the
// surface is unmapped), then the viewport state it carries. True when all
// that did to the surface's pixels was to replace `part` of them (the CPU
// renderer's copy brought up to date where the client said its buffer
// changed; no viewport): the rest of them, and their size, are as before.
pub fn commitContent(surface: *Surface, part: *ui.Rect) -> bool {
    const compositor = surface.*.compositor
    var attached = false
    var partial = false
    // What a client that set a buffer scale or transform calls surface
    // coordinates is not the buffer's pixels (neither is applied here): it
    // counts as not having said what changed.
    if surface.*.transformed { surface.*.pendingDamage = ui.rect(0, 0, 0, 0) }
    if surface.*.hasPendingAttach && surface.*.pendingBuffer != 0 {
        surface.*.fpsFrames +%= 1
        if compositor.*.renderer != 0 {
            holdBuffer(surface, surface.*.pendingBuffer)
        } else {
            partial = copyBuffer(surface, shell.bufferAt(surface.*.pendingBuffer), surface.*.pendingDamage, part)
            compositor.*.commits += 1
            surface.*.contentSerial = compositor.*.commits
        }
        attached = true
    }
    surface.*.hasPendingAttach = false
    surface.*.pendingBuffer = 0
    applyView(surface, attached)
    // (A viewport set with this commit made other pixels of all of them.)
    return partial && !surface.*.scaledCopy
}

// The crop and size asked for, applied: checked against the buffer as the
// protocol asks (out_of_buffer for a crop reaching outside it, bad_size
// for a crop of a fraction of a pixel and no size), then the surface's
// size and, on the CPU, its pixels for them.
fn applyView(surface: *Surface, attached: bool) -> void {
    const compositor = surface.*.compositor
    const pending = surface.*.pendingCrop
    var crop = ui.rect(0, 0, 0, 0)
    var width: i32 = 0
    var height: i32 = 0
    if pending[2] != -256 {
        const outside = pending[0] + pending[2] > surface.*.bufferWidth * 256 || pending[1] + pending[3] > surface.*.bufferHeight * 256
        if surface.*.hasContent && outside {
            viewportError(surface, wl.wp_viewport.Error.out_of_buffer, "the source rectangle reaches outside the buffer")
            return
        }
        if surface.*.pendingViewWidth <= 0 && (pending[2] % 256 != 0 || pending[3] % 256 != 0) {
            viewportError(surface, wl.wp_viewport.Error.bad_size, "a source rectangle of a fraction of a pixel needs a destination size")
            return
        }
        // In whole pixels: the crop's top left corner down, its bottom
        // right one up.
        const left = pending[0] / 256
        const top = pending[1] / 256
        crop = ui.rect(left, top, (pending[0] + pending[2] + 255) / 256 - left, (pending[1] + pending[3] + 255) / 256 - top)
        width = pending[2] / 256
        height = pending[3] / 256
    }
    if surface.*.pendingViewWidth > 0 {
        width = surface.*.pendingViewWidth
        height = surface.*.pendingViewHeight
    }
    const same_crop = crop.x == surface.*.crop.x && crop.y == surface.*.crop.y && crop.width == surface.*.crop.width && crop.height == surface.*.crop.height
    const changed = attached || !same_crop || width != surface.*.viewWidth || height != surface.*.viewHeight
    surface.*.crop = crop
    surface.*.viewWidth = width
    surface.*.viewHeight = height
    if !changed || !surface.*.hasContent { return }
    if !attached {
        compositor.*.commits += 1
        surface.*.contentSerial = compositor.*.commits
    }
    if compositor.*.renderer != 0 {
        surface.*.pixelWidth = @intCast(usize, if width > 0 { width } else { surface.*.bufferWidth })
        surface.*.pixelHeight = @intCast(usize, if width > 0 { height } else { surface.*.bufferHeight })
        return
    }
    if width > 0 {
        showView(surface)
    } else if surface.*.scaledCopy {
        // No viewport any more: the buffer's own copy is shown again.
        swapPixels(surface)
        surface.*.pixelWidth = @intCast(usize, surface.*.bufferWidth)
        surface.*.pixelHeight = @intCast(usize, surface.*.bufferHeight)
        surface.*.scaledCopy = false
    }
}

fn viewportError(surface: *Surface, code: wl.wp_viewport.Error, message: []const u8) -> void {
    const record: *state.SurfaceExtension = unsafe { @ptrFromInt(*state.SurfaceExtension, surface.*.viewport) }
    wl.wp_viewport.Resource.fromObject(record.*.resource).postError(@intFromEnum(code), message)
}

// The surface's pixels and its buffer's copy change places.
fn swapPixels(surface: *Surface) -> void {
    const pixels = surface.*.pixels
    const capacity = surface.*.pixelCapacity
    surface.*.pixels = surface.*.sourcePixels
    surface.*.pixelCapacity = surface.*.sourceCapacity
    surface.*.sourcePixels = pixels
    surface.*.sourceCapacity = capacity
}

// CPU: the buffer's copy (moved to sourcePixels the first time) cropped
// and scaled into `pixels`, the view's size.
fn showView(surface: *Surface) -> void {
    const compositor = surface.*.compositor
    if !surface.*.scaledCopy {
        swapPixels(surface)
        surface.*.scaledCopy = true
    }
    const width = @intCast(usize, surface.*.viewWidth)
    const height = @intCast(usize, surface.*.viewHeight)
    const needed = width * height * 4
    if needed > surface.*.pixelCapacity {
        if surface.*.pixelCapacity > 0 { state.release(compositor, surface.*.pixels, surface.*.pixelCapacity) }
        surface.*.pixels = state.allocate(compositor, needed)
        surface.*.pixelCapacity = needed
    }
    const crop = state.viewCrop(surface)
    const stride = @intCast(usize, surface.*.bufferWidth)
    var from: [*]const u32 = undefined
    var to: [*]u32 = undefined
    unsafe {
        from = @ptrCast([*]const u32, surface.*.sourcePixels)
        to = @ptrCast([*]u32, surface.*.pixels)
    }
    const crop_x = @intCast(usize, crop.x)
    const crop_y = @intCast(usize, crop.y)
    const crop_width = @intCast(usize, crop.width)
    const crop_height = @intCast(usize, crop.height)
    if crop_width == width && crop_height == height {
        // Only cropped: rows as they are.
        var row: usize = 0
        while row < height {
            state.copyPixels(@intFromPtr(surface.*.pixels) + row * width * 4, @intFromPtr(surface.*.sourcePixels) + ((crop_y + row) * stride + crop_x) * 4, width)
            row += 1
        }
    } else if crop_width > 0 && crop_height > 0 {
        // Sample k (0-3) across: crop column (x * 8 + 2k + 1) * crop width
        // / (width * 8), and down alike.
        const columns_size = width * 4 * @sizeOf(usize)
        const columns_memory = state.allocate(compositor, columns_size)
        const columns: [*]usize = unsafe { @ptrCast([*]usize, columns_memory) }
        var x: usize = 0
        while x < width {
            var k: usize = 0
            while k < 4 {
                columns[x * 4 + k] = crop_x + (x * 8 + 2 * k + 1) * crop_width / (width * 8)
                k += 1
            }
            x += 1
        }
        var rows: [4]usize = undefined
        var y: usize = 0
        while y < height {
            var k: usize = 0
            while k < 4 {
                rows[k] = (crop_y + (y * 8 + 2 * k + 1) * crop_height / (height * 8)) * stride
                k += 1
            }
            x = 0
            while x < width {
                var alpha: u32 = 0
                var red: u32 = 0
                var green: u32 = 0
                var blue: u32 = 0
                var row: usize = 0
                while row < 4 {
                    var column: usize = 0
                    while column < 4 {
                        const pixel = from[rows[row] + columns[x * 4 + column]]
                        alpha += pixel >> 24
                        red += (pixel >> 16) & 255
                        green += (pixel >> 8) & 255
                        blue += pixel & 255
                        column += 1
                    }
                    row += 1
                }
                to[y * width + x] = (((alpha + 8) >> 4) << 24) | (((red + 8) >> 4) << 16) | (((green + 8) >> 4) << 8) | ((blue + 8) >> 4)
                x += 1
            }
            y += 1
        }
        state.release(compositor, columns_memory, columns_size)
    }
    surface.*.pixelWidth = width
    surface.*.pixelHeight = height
}

// Copies an attached shm buffer into the surface and releases it: all of
// it, or only what `damage` says changed (takePixels; true then, with
// `part` what was replaced).
fn copyBuffer(surface: *Surface, buffer: *shell.Buffer, damage: ui.Rect, part: *ui.Rect) -> bool {
    const width = @intCast(usize, buffer.*.width)
    const height = @intCast(usize, buffer.*.height)
    var partial = false
    if buffer.*.pool.*.memory.address == 0 {
        // A dma-buf the CPU cannot map (only the Vulkan renderer reads
        // those): black instead.
        surface.*.scaledCopy = false
        reserve(surface, width * height * 4)
        state.fillPixels(@intFromPtr(surface.*.pixels), width * height, 4278190080)
        surface.*.pixelWidth = width
        surface.*.pixelHeight = height
        surface.*.hasContent = true
        surface.*.opaque = true
        surface.*.copied = false
    } else {
        const xrgb = buffer.*.format == @intFromEnum(wl.wl_shm.Format.xrgb8888)
        partial = takePixels(surface, buffer.*.pool.*.memory.address + @intCast(usize, buffer.*.offset), width, height, @intCast(usize, buffer.*.stride), xrgb, damage, part)
    }
    surface.*.bufferWidth = buffer.*.width
    surface.*.bufferHeight = buffer.*.height
    wl.wl_buffer.Resource.fromObject(buffer.*.resource).sendRelease()
    return partial
}

// Room in `pixels` for `needed` bytes (what it held is gone when it grows).
fn reserve(surface: *Surface, needed: usize) -> void {
    if needed <= surface.*.pixelCapacity { return }
    const compositor = surface.*.compositor
    if surface.*.pixelCapacity > 0 { state.release(compositor, surface.*.pixels, surface.*.pixelCapacity) }
    surface.*.pixels = state.allocate(compositor, needed)
    surface.*.pixelCapacity = needed
    surface.*.copied = false
}

// A buffer's pixels (`width` x `height` at `source`, rows `stride` bytes
// apart; of an XRGB one the alpha bytes are set to 255) into the surface's
// copy of them. All of them; or, when the copy is of a buffer of this size
// and `damage` (buffer pixels: what the client said changed since; empty:
// it did not say) is a part of it, that part only: the rest of the copy
// stays as it is and the buffer is not read there. True for the latter,
// `part` being what was replaced (all of it otherwise).
//
// Whether the copy is opaque (rows of it are then copied, not blended) is
// read from the copy, as it is stored: all of it, or the part replaced,
// and when that part is opaque now and held the row known not to be
// (`translucentRow`), that row and then the others until one is not. It
// is the answer a whole copy gives.
pub fn takePixels(surface: *Surface, source: usize, width: usize, height: usize, stride: usize, xrgb: bool, damage: ui.Rect, part: *ui.Rect) -> bool {
    const whole = ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height))
    const needed = width * height * 4
    var area = whole
    var partial = false
    if surface.*.hasContent && surface.*.copied && !surface.*.scaledCopy && surface.*.pixelWidth == width && surface.*.pixelHeight == height && surface.*.pixelCapacity >= needed {
        const inside = ui.intersect(damage, whole)
        if !ui.isEmpty(inside) && (inside.width < whole.width || inside.height < whole.height) {
            area = inside
            partial = true
        }
    }
    surface.*.scaledCopy = false
    reserve(surface, needed)
    const left = @intCast(usize, area.x)
    const top = @intCast(usize, area.y)
    const bottom = top + @intCast(usize, area.height)
    const count = @intCast(usize, area.width)
    const pixels = @intFromPtr(surface.*.pixels)
    // Rows are looked at until one is not opaque; the others are copied.
    var opaque = true
    var translucent: usize = 0
    var row = top
    while row < bottom {
        const to = pixels + (row * width + left) * 4
        const from = source + row * stride + left * 4
        if xrgb {
            state.copyPixels(to, from, count)
            state.setAlpha(to, count)
        } else if !opaque {
            state.copyPixels(to, from, count)
        } else if !copyOpaque(to, from, count) {
            opaque = false
            translucent = row
        }
        row += 1
    }
    surface.*.pixelWidth = width
    surface.*.pixelHeight = height
    surface.*.hasContent = true
    surface.*.copied = true
    if !partial || !opaque {
        surface.*.opaque = opaque
        surface.*.translucentRow = translucent
    } else if !surface.*.opaque && surface.*.translucentRow >= top && surface.*.translucentRow < bottom {
        findTranslucent(surface)
    }
    part.* = ui.rect(area.x, area.y, area.width, area.height)
    return partial
}

// Copies `count` pixels from `from` (a client's buffer) to `to` (the
// surface's copy, 4-byte aligned) and says whether all of them are opaque.
// Where both lie alike in 64-bit words, two pixels are copied and their
// alpha bytes ANDed at a time, each word read once (what is judged is what
// was stored); else the row is copied and the copy looked through.
fn copyOpaque(to: usize, from: usize, count: usize) -> bool {
    if (to ^ from) & 7 != 0 {
        state.copyPixels(to, from, count)
        return state.opaquePixels(to, count)
    }
    var target = to
    var origin = from
    var left = count
    var single: u32 = 4278190080
    var one_from: [*]const u32 = undefined
    var one_to: [*]u32 = undefined
    if target % 8 != 0 && left > 0 {
        unsafe {
            one_from = @ptrFromInt([*]const u32, origin)
            one_to = @ptrFromInt([*]u32, target)
        }
        single = one_from[0]
        one_to[0] = single
        target += 4
        origin += 4
        left -= 1
    }
    var read: [*]const u64 = undefined
    var write: [*]u64 = undefined
    unsafe {
        read = @ptrFromInt([*]const u64, origin)
        write = @ptrFromInt([*]u64, target)
    }
    const pair_count = left / 2
    var both: u64 = state.ALPHA_PAIR
    var index: usize = 0
    while index + 4 <= pair_count {
        const a = read[index]
        const b = read[index + 1]
        const c = read[index + 2]
        const d = read[index + 3]
        write[index] = a
        write[index + 1] = b
        write[index + 2] = c
        write[index + 3] = d
        both = both & a & b & c & d
        index += 4
    }
    while index < pair_count {
        const a = read[index]
        write[index] = a
        both = both & a
        index += 1
    }
    if left % 2 != 0 {
        unsafe {
            one_from = @ptrFromInt([*]const u32, origin + pair_count * 8)
            one_to = @ptrFromInt([*]u32, target + pair_count * 8)
        }
        const last = one_from[0]
        one_to[0] = last
        single = single & last
    }
    return both & state.ALPHA_PAIR == state.ALPHA_PAIR && single & 4278190080 == 4278190080
}

// The copy was not opaque, and the row known to hold a translucent pixel
// has opaque ones where it was replaced: whether the copy still is not
// (by that row outside the part replaced, or by any other), and by which
// row.
fn findTranslucent(surface: *Surface) -> void {
    const width = surface.*.pixelWidth
    const pixels = @intFromPtr(surface.*.pixels)
    if !state.opaquePixels(pixels + surface.*.translucentRow * width * 4, width) { return }
    var row: usize = 0
    while row < surface.*.pixelHeight {
        if !state.opaquePixels(pixels + row * width * 4, width) {
            surface.*.translucentRow = row
            return
        }
        row += 1
    }
    surface.*.opaque = true
    surface.*.translucentRow = 0
}

// Vulkan: shows an attached buffer in place, releasing the one it replaces.
fn holdBuffer(surface: *Surface, address: usize) -> void {
    if surface.*.current != 0 && surface.*.current != address {
        wl.wl_buffer.Resource.fromObject(shell.bufferAt(surface.*.current).*.resource).sendRelease()
    }
    surface.*.current = address
    const compositor = surface.*.compositor
    compositor.*.commits += 1
    surface.*.contentSerial = compositor.*.commits
    const buffer = shell.bufferAt(address)
    surface.*.bufferWidth = buffer.*.width
    surface.*.bufferHeight = buffer.*.height
    // A buffer attached without damage counts as changed everywhere.
    const changed = if ui.isEmpty(surface.*.pendingDamage) { ui.rect(0, 0, buffer.*.width, buffer.*.height) } else { surface.*.pendingDamage }
    surface.*.uploadDamage = scene.unionRect(surface.*.uploadDamage, changed)
    surface.*.pixelWidth = @intCast(usize, buffer.*.width)
    surface.*.pixelHeight = @intCast(usize, buffer.*.height)
    surface.*.hasContent = true
    surface.*.opaque = buffer.*.format == @intFromEnum(wl.wl_shm.Format.xrgb8888)
}

// Leaves the Vulkan renderer for the CPU one (it failed to compose a
// frame): the buffers surfaces show in place are copied into them and
// released, as the CPU renderer does on commit.
pub fn adoptCpuRenderer(compositor: *shell.Compositor) -> void {
    compositor.*.renderer = 0
    compositor.*.readsTiled = false
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        if surface.*.current != 0 {
            const address = surface.*.current
            surface.*.current = 0
            var all: ui.Rect = undefined
            _ = copyBuffer(surface, shell.bufferAt(address), ui.rect(0, 0, 0, 0), &all)
            if surface.*.viewWidth > 0 { showView(surface) }
        }
        index += 1
    }
    scene.damageAll(compositor)
}

pub fn releaseCurrent(surface: *Surface) -> void {
    if surface.*.current != 0 {
        wl.wl_buffer.Resource.fromObject(shell.bufferAt(surface.*.current).*.resource).sendRelease()
        surface.*.current = 0
    }
}
