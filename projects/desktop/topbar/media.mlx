// What plays: the MPRIS players on the session bus
// (org.mpris.MediaPlayer2.NAME, their /org/mpris/MediaPlayer2). The bar
// shows the one that started playing last (else one that is paused) as a
// play/pause button and "Title – Artist": the button plays or pauses, the
// text opens a popup with the cover (an mpris:artUrl file:// PNG), the
// title, artist and album, where the track is (a click on the line goes
// there) and previous, play/pause and next; a click on the cover or the
// title brings the player's window up (Raise). The players' properties
// come with GetAll and PropertiesChanged; where the track is is asked
// again every second while the popup is open.
const dbus = @import("std.dbus")
const png = @import("std.png")
const state = @import("./state.mlx")
const bus = @import("./bus.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")

const Bar = state.Bar
const Canvas = state.Canvas
const Player = state.Player

pub const PREFIX: []const u8 = "org.mpris.MediaPlayer2."
pub const PLAYER: []const u8 = "org.mpris.MediaPlayer2.Player"
const ROOT: []const u8 = "org.mpris.MediaPlayer2"
const PATH: []const u8 = "/org/mpris/MediaPlayer2"

// The widget: the button, a gap, the text (at most TEXT_WIDTH).
const BUTTON: i32 = 20
const GAP: i32 = 6
const TEXT_WIDTH: i32 = 240

// The popup.
pub const WIDTH: i32 = 360
pub const HEIGHT: i32 = 150
const COVER: i32 = 104
const PADDING: i32 = 16
const COLUMN: i32 = PADDING + COVER + 16
const LINE_TOP: i32 = 88
const CONTROLS: i32 = 112
const CONTROL: i32 = 32

pub const HIT_PREVIOUS: usize = 1
pub const HIT_PLAY: usize = 2
pub const HIT_NEXT: usize = 3
pub const HIT_RAISE: usize = 4
pub const HIT_SEEK: usize = 5

fn find(bar: *Bar, name: []const u8) -> usize {
    var index: usize = 0
    while index < state.MAX_PLAYERS {
        const player = state.playerAt(bar, index)
        if player.*.used && state.same(state.labelText(&player.*.name), name) { return index }
        index += 1
    }
    return state.NONE
}

fn byOwner(bar: *Bar, owner: []const u8) -> usize {
    var index: usize = 0
    while index < state.MAX_PLAYERS {
        const player = state.playerAt(bar, index)
        if player.*.used && state.same(state.labelText(&player.*.owner), owner) { return index }
        index += 1
    }
    return state.NONE
}

pub fn clear(bar: *Bar) -> void {
    var index: usize = 0
    while index < state.MAX_PLAYERS {
        state.playerAt(bar, index).*.used = false
        index += 1
    }
    dropCover(bar)
    state.barChanged(bar)
}

// A player's name got an owner (`owner`; empty: ask the bus).
pub fn appeared(bar: *Bar, name: []const u8, owner: []const u8) -> void {
    var index = find(bar, name)
    if index == state.NONE {
        index = 0
        while index < state.MAX_PLAYERS && state.playerAt(bar, index).*.used { index += 1 }
        if index == state.MAX_PLAYERS { return }
        const player = state.playerAt(bar, index)
        player.*.used = true
        state.labelSet(&player.*.name, name)
        player.*.owner.length = 0
        state.labelSet(&player.*.identity, name[PREFIX.length..name.length])
        player.*.status = state.STOPPED
        player.*.title.length = 0
        player.*.artist.length = 0
        player.*.album.length = 0
        player.*.art.length = 0
        player.*.trackId.length = 0
        player.*.length = 0
        player.*.position = 0
        player.*.positionAt = state.milliseconds()
        player.*.canNext = false
        player.*.canPrevious = false
        player.*.canPlay = false
        player.*.canPause = false
        player.*.playedAt = 0
        state.say(bar, "topbar: player ")
        state.say(bar, name)
        state.say(bar, "\n")
    }
    const player = state.playerAt(bar, index)
    if owner.length > 0 {
        state.labelSet(&player.*.owner, owner)
    } else {
        bus.callString(bar, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner", name, bus.PURPOSE_PLAYER_OWNER, index)
    }
    bus.getAll(bar, name, PATH, PLAYER, bus.PURPOSE_PLAYER_PROPERTIES, index)
    bus.getProperty(bar, name, PATH, ROOT, "Identity", bus.PURPOSE_PLAYER_IDENTITY, index)
}

pub fn vanished(bar: *Bar, name: []const u8) -> void {
    const index = find(bar, name)
    if index == state.NONE { return }
    state.playerAt(bar, index).*.used = false
    bus.forget(bar, bus.PURPOSE_IGNORE, index)
    state.say(bar, "topbar: player gone ")
    state.say(bar, name)
    state.say(bar, "\n")
    state.barChanged(bar)
    state.popupChanged(bar)
}

// Metadata (a{sv} in a variant of `signature`).
fn metadata(player: *Player, reading: *dbus.Reader, signature: []const u8) -> void {
    if !state.same(signature, "a{sv}") {
        const skipped = dbus.skipValue(reading, signature, 0, 0)
        return
    }
    player.*.title.length = 0
    player.*.artist.length = 0
    player.*.album.length = 0
    player.*.art.length = 0
    player.*.trackId.length = 0
    player.*.length = 0
    const end = bus.arrayEnd(reading, 8)
    while reading.*.position < end && !reading.*.failed {
        dbus.alignTo(reading, 8)
        const key = dbus.readString(reading)
        const inner = dbus.readSignature(reading)
        if state.same(key, "xesam:title") {
            state.labelSet(&player.*.title, bus.valueString(reading, inner))
        } else if state.same(key, "xesam:album") {
            state.labelSet(&player.*.album, bus.valueString(reading, inner))
        } else if state.same(key, "mpris:artUrl") {
            state.labelSet(&player.*.art, bus.valueString(reading, inner))
        } else if state.same(key, "mpris:trackid") {
            state.labelSet(&player.*.trackId, bus.valueString(reading, inner))
        } else if state.same(key, "mpris:length") {
            player.*.length = bus.valueNumber(reading, inner)
        } else if state.same(key, "xesam:artist") && state.same(inner, "as") {
            // Several: "A, B".
            const artists_end = bus.arrayEnd(reading, 4)
            while reading.*.position < artists_end && !reading.*.failed {
                const artist = dbus.readString(reading)
                if player.*.artist.length > 0 { state.labelAdd(&player.*.artist, ", ") }
                state.labelAdd(&player.*.artist, artist)
            }
        } else {
            const skipped = dbus.skipValue(reading, inner, 0, 0)
        }
    }
    reading.*.position = end
}

// Properties (a{sv}) into the player.
fn apply(bar: *Bar, player: *Player, reading: *dbus.Reader) -> void {
    const end = bus.arrayEnd(reading, 8)
    while reading.*.position < end && !reading.*.failed {
        dbus.alignTo(reading, 8)
        const key = dbus.readString(reading)
        const signature = dbus.readSignature(reading)
        if state.same(key, "PlaybackStatus") {
            const status = bus.valueString(reading, signature)
            const before = player.*.status
            player.*.position = estimate(player)
            player.*.positionAt = state.milliseconds()
            player.*.status = if state.same(status, "Playing") { state.PLAYING } else if state.same(status, "Paused") { state.PAUSED } else { state.STOPPED }
            if player.*.status == state.PLAYING && before != state.PLAYING { player.*.playedAt = state.milliseconds() }
        } else if state.same(key, "Metadata") {
            metadata(player, reading, signature)
        } else if state.same(key, "Position") {
            player.*.position = bus.valueNumber(reading, signature)
            player.*.positionAt = state.milliseconds()
        } else if state.same(key, "CanGoNext") {
            player.*.canNext = bus.valueBool(reading, signature)
        } else if state.same(key, "CanGoPrevious") {
            player.*.canPrevious = bus.valueBool(reading, signature)
        } else if state.same(key, "CanPlay") {
            player.*.canPlay = bus.valueBool(reading, signature)
        } else if state.same(key, "CanPause") {
            player.*.canPause = bus.valueBool(reading, signature)
        } else {
            const skipped = dbus.skipValue(reading, signature, 0, 0)
        }
    }
    if !reading.*.failed && bar.*.verbose {
        state.say(bar, "topbar: player ")
        state.say(bar, state.labelText(&player.*.name))
        state.say(bar, if player.*.status == state.PLAYING { " playing \"" } else if player.*.status == state.PAUSED { " paused \"" } else { " stopped \"" })
        state.say(bar, state.labelText(&player.*.title))
        state.say(bar, "\" by ")
        state.say(bar, state.labelText(&player.*.artist))
        state.say(bar, "\n")
    }
    state.barChanged(bar)
    state.popupChanged(bar)
}

pub fn replied(bar: *Bar, purpose: u32, slot: usize, reading: *dbus.Reader) -> void {
    if slot >= state.MAX_PLAYERS { return }
    const player = state.playerAt(bar, slot)
    if !player.*.used { return }
    if purpose == bus.PURPOSE_PLAYER_OWNER {
        const owner = dbus.readString(reading)
        if !reading.*.failed { state.labelSet(&player.*.owner, owner) }
    } else if purpose == bus.PURPOSE_PLAYER_PROPERTIES {
        apply(bar, player, reading)
    } else if purpose == bus.PURPOSE_PLAYER_IDENTITY {
        const identity = bus.variantString(reading)
        if identity.length > 0 { state.labelSet(&player.*.identity, identity) }
        state.popupChanged(bar)
    } else if purpose == bus.PURPOSE_PLAYER_POSITION {
        const signature = dbus.readSignature(reading)
        player.*.position = bus.valueNumber(reading, signature)
        player.*.positionAt = state.milliseconds()
        state.popupChanged(bar)
    }
}

pub fn propertiesChanged(bar: *Bar, sender: []const u8, reading: *dbus.Reader) -> void {
    const index = byOwner(bar, sender)
    if index == state.NONE { return }
    apply(bar, state.playerAt(bar, index), reading)
}

pub fn seeked(bar: *Bar, sender: []const u8, position: i64) -> void {
    const index = byOwner(bar, sender)
    if index == state.NONE { return }
    const player = state.playerAt(bar, index)
    player.*.position = position
    player.*.positionAt = state.milliseconds()
    state.popupChanged(bar)
}

// Where the track is now (microseconds): on from the last word while it
// plays.
fn estimate(player: *Player) -> i64 {
    var position = player.*.position
    if player.*.status == state.PLAYING { position += @intCast(i64, state.milliseconds() - player.*.positionAt) * 1000 }
    if player.*.length > 0 && position > player.*.length { position = player.*.length }
    return if position < 0 { 0 } else { position }
}

// The player the bar shows (NONE: none).
pub fn shown(bar: *Bar) -> usize {
    var best = state.NONE
    var index: usize = 0
    while index < state.MAX_PLAYERS {
        const player = state.playerAt(bar, index)
        if player.*.used && player.*.status != state.STOPPED && player.*.title.length > 0 {
            if best == state.NONE {
                best = index
            } else {
                const other = state.playerAt(bar, best)
                const playing = player.*.status == state.PLAYING
                const other_playing = other.*.status == state.PLAYING
                if (playing && !other_playing) || (playing == other_playing && player.*.playedAt > other.*.playedAt) { best = index }
            }
        }
        index += 1
    }
    return best
}

// Sends the shown player `member` (PlayPause, Next, Previous, Raise).
fn command(bar: *Bar, interface: []const u8, member: []const u8) -> void {
    const index = shown(bar)
    if index == state.NONE { return }
    const player = state.playerAt(bar, index)
    bus.callEmpty(bar, state.labelText(&player.*.name), PATH, interface, member, bus.PURPOSE_IGNORE, 0)
    state.say(bar, "topbar: ")
    state.say(bar, member)
    state.say(bar, " to ")
    state.say(bar, state.labelText(&player.*.name))
    state.say(bar, "\n")
}

// ---------------------------------------------------------------------------
// Glyphs

fn drawPlay(canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    state.fillTriangle(canvas, x + size / 5, y, x + size / 5, y + size, x + size, y + size / 2, color)
}

fn drawPause(canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    const bar_width = size / 3
    canvas_module.fillRoundedRect(canvas, x + size / 8, y, bar_width, size, 1, color)
    canvas_module.fillRoundedRect(canvas, x + size - size / 8 - bar_width, y, bar_width, size, 1, color)
}

// Next (or previous when `back`): two triangles and a bar.
fn drawSkip(canvas: *Canvas, x: i32, y: i32, size: i32, back: bool, color: u32) -> void {
    const half = size / 2
    if back {
        canvas_module.fillRect(canvas, x, y, 2, size, color)
        state.fillTriangle(canvas, x + 2 + half, y, x + 2 + half, y + size, x + 2, y + half, color)
        state.fillTriangle(canvas, x + 2 + size, y, x + 2 + size, y + size, x + 2 + half, y + half, color)
    } else {
        state.fillTriangle(canvas, x, y, x, y + size, x + half, y + half, color)
        state.fillTriangle(canvas, x + half, y, x + half, y + size, x + size, y + half, color)
        canvas_module.fillRect(canvas, x + size, y, 2, size, color)
    }
}

// ---------------------------------------------------------------------------
// The widget on the bar

// "Title – Artist" (or the title alone).
fn caption(player: *Player, out: [*]u8) -> []const u8 {
    var length = state.put(out, 0, state.labelText(&player.*.title))
    if player.*.artist.length > 0 {
        length = state.put(out, length, " – ")
        length = state.put(out, length, state.labelText(&player.*.artist))
    }
    return out[0..length]
}

// Its width on the bar (0: nothing plays), at most `room`.
pub fn widgetWidth(bar: *Bar, room: i32) -> i32 {
    const index = shown(bar)
    if index == state.NONE || room < BUTTON + GAP + 40 { return 0 }
    var text: [600]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var width = text_module.measure(state.textOf(bar), caption(state.playerAt(bar, index), bytes))
    if width > TEXT_WIDTH { width = TEXT_WIDTH }
    var whole = BUTTON + GAP + width + 8
    if whole > room { whole = room }
    return whole
}

pub fn drawWidget(bar: *Bar, canvas: *Canvas, left: i32, width: i32) -> void {
    const index = shown(bar)
    if index == state.NONE || width == 0 { return }
    const player = state.playerAt(bar, index)
    const top = (state.HEIGHT - BUTTON) / 2
    if bar.*.hoverWidget == state.WIDGET_MEDIA && bar.*.pointerX < left + BUTTON + 2 { canvas_module.fillRoundedRect(canvas, left - 2, top - 1, BUTTON + 4, BUTTON + 2, 6, canvas_module.color(40, 255, 255, 255)) }
    if player.*.status == state.PLAYING {
        drawPause(canvas, left + 5, top + 5, 10, state.TEXT_COLOR)
    } else {
        drawPlay(canvas, left + 4, top + 4, 12, state.TEXT_COLOR)
    }
    var text: [600]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const color = if player.*.status == state.PLAYING { state.TEXT_COLOR } else { canvas_module.color(170, 255, 255, 255) }
    text_module.drawText(canvas, state.textOf(bar), caption(player, bytes), left + BUTTON + GAP, (state.HEIGHT - 16) / 2, color, width - BUTTON - GAP - 4)
}

// A click on the widget at `x`: the button plays or pauses (true), the
// text is for the popup (false).
pub fn clickWidget(bar: *Bar, x: i32, left: i32) -> bool {
    if x < left + BUTTON + 2 {
        command(bar, PLAYER, "PlayPause")
        return true
    }
    return false
}

// ---------------------------------------------------------------------------
// The popup

fn dropCover(bar: *Bar) -> void {
    if bar.*.hasCover { png.deinit(state.coverOf(bar)) }
    bar.*.hasCover = false
    state.coverPathOf(bar).*.length = 0
}

fn hexValue(byte: u8) -> u8 {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    return 255
}

// The shown player's cover, when its art is a file:// PNG (loaded once
// per path).
fn loadCover(bar: *Bar, player: *Player) -> void {
    const art = state.labelText(&player.*.art)
    if state.same(art, state.labelText(state.coverPathOf(bar))) { return }
    dropCover(bar)
    state.labelSet(state.coverPathOf(bar), art)
    if !state.startsWith(art, "file://") { return }
    // The path, %XX undone.
    var path: state.Label = undefined
    path.length = 0
    var index: usize = 7
    while index < art.length && path.length < 255 {
        var byte = art[index]
        if byte == 37 && index + 2 < art.length && hexValue(art[index + 1]) < 16 && hexValue(art[index + 2]) < 16 {
            byte = hexValue(art[index + 1]) * 16 + hexValue(art[index + 2])
            index += 2
        }
        path.bytes[path.length] = byte
        path.length += 1
        index += 1
    }
    var image: png.Image = undefined
    if png.loadFile(&image, state.labelPath(&path), bar.*.allocator) != png.Status.ok { return }
    var scaled: png.Image = undefined
    const status = png.scale(&scaled, &image, @intCast(usize, COVER), @intCast(usize, COVER), bar.*.allocator)
    png.deinit(&image)
    if status != png.Status.ok { return }
    bar.*.cover = scaled
    bar.*.hasCover = true
    panel_module.forgetImages(state.panelOf(bar))
}

// The popup opens: the cover, and where the track is.
pub fn opened(bar: *Bar) -> void {
    const index = shown(bar)
    if index == state.NONE { return }
    loadCover(bar, state.playerAt(bar, index))
    poll(bar)
}

// Every second while the popup is open: where the track is.
pub fn poll(bar: *Bar) -> void {
    const index = shown(bar)
    if index == state.NONE { return }
    bus.getProperty(bar, state.labelText(&state.playerAt(bar, index).*.name), PATH, PLAYER, "Position", bus.PURPOSE_PLAYER_POSITION, index)
}

fn controlLeft(which: usize) -> i32 {
    const middle = COLUMN + (WIDTH - PADDING - COLUMN) / 2
    return middle - CONTROL / 2 + (@intCast(i32, which) - 1) * (CONTROL + 12)
}

pub fn hit(x: i32, y: i32) -> usize {
    if y >= CONTROLS && y < CONTROLS + CONTROL {
        var which: usize = 0
        while which < 3 {
            if x >= controlLeft(which) && x < controlLeft(which) + CONTROL { return HIT_PREVIOUS + which }
            which += 1
        }
        return state.NONE
    }
    if y >= LINE_TOP - 6 && y < LINE_TOP + 10 && x >= COLUMN && x < WIDTH - PADDING { return HIT_SEEK }
    if (x >= PADDING && x < PADDING + COVER && y >= PADDING && y < PADDING + COVER) || (x >= COLUMN && y >= PADDING && y < PADDING + 22) { return HIT_RAISE }
    return state.NONE
}

pub fn click(bar: *Bar) -> void {
    const target = bar.*.popupHover
    if target == HIT_PREVIOUS { command(bar, PLAYER, "Previous") }
    if target == HIT_PLAY { command(bar, PLAYER, "PlayPause") }
    if target == HIT_NEXT { command(bar, PLAYER, "Next") }
    if target == HIT_RAISE { command(bar, ROOT, "Raise") }
    if target == HIT_SEEK { seek(bar) }
}

// SetPosition(track, where the pointer is on the line).
fn seek(bar: *Bar) -> void {
    const index = shown(bar)
    if index == state.NONE { return }
    const player = state.playerAt(bar, index)
    if player.*.length <= 0 || player.*.trackId.length == 0 { return }
    var x = bar.*.popupX - COLUMN
    const line = WIDTH - PADDING - COLUMN
    if x < 0 { x = 0 }
    if x > line { x = line }
    const position = player.*.length * @intCast(i64, x) / @intCast(i64, line)
    var body: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 512, false)
    dbus.putString(&writing, state.labelText(&player.*.trackId))
    dbus.pad(&writing, 8)
    dbus.putU32(&writing, @intCast(u32, @bitCast(u64, position) & 4294967295))
    dbus.putU32(&writing, @intCast(u32, @bitCast(u64, position) >> 32))
    bus.call(bar, state.labelText(&player.*.name), PATH, PLAYER, "SetPosition", "ox", bytes, writing.length, bus.PURPOSE_IGNORE, 0)
    player.*.position = position
    player.*.positionAt = state.milliseconds()
    state.popupChanged(bar)
}

// "3:07" into `out`.
fn clockText(microseconds: i64, out: [*]u8) -> []const u8 {
    const seconds = microseconds / 1000000
    var length: usize = 0
    if seconds >= 3600 {
        length = state.putNumber(out, 0, seconds / 3600, 1)
        length = state.put(out, length, ":")
        length = state.putNumber(out, length, seconds % 3600 / 60, 2)
    } else {
        length = state.putNumber(out, 0, seconds / 60, 1)
    }
    length = state.put(out, length, ":")
    length = state.putNumber(out, length, seconds % 60, 2)
    return out[0..length]
}

pub fn draw(bar: *Bar, canvas: *Canvas) -> void {
    canvas_module.clear(canvas, 0)
    canvas_module.fillRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, state.POPUP_RADIUS, state.POPUP_BACKGROUND)
    canvas_module.strokeRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, state.POPUP_RADIUS, 1, canvas_module.color(60, 255, 255, 255))
    const index = shown(bar)
    if index == state.NONE { return }
    const player = state.playerAt(bar, index)
    const dim = canvas_module.color(150, 255, 255, 255)
    // The cover, else a tile with a note.
    if bar.*.hasCover {
        canvas_module.drawImage(canvas, state.coverOf(bar), PADDING, PADDING, COVER, 255)
    } else {
        canvas_module.fillRoundedRect(canvas, PADDING, PADDING, COVER, COVER, 10, canvas_module.color(255, 70, 76, 96))
        const note_x = PADDING + COVER / 2 - 10
        const note_y = PADDING + COVER / 2 - 18
        canvas_module.fillRect(canvas, note_x + 16, note_y, 4, 30, dim)
        canvas_module.fillRect(canvas, note_x + 16, note_y, 14, 4, dim)
        canvas_module.fillRoundedRect(canvas, note_x + 4, note_y + 24, 16, 12, 6, dim)
    }
    const text_width = WIDTH - PADDING - COLUMN
    text_module.drawText(canvas, state.boldOf(bar), state.labelText(&player.*.title), COLUMN, PADDING + 2, state.TEXT_COLOR, text_width)
    text_module.drawText(canvas, state.textOf(bar), state.labelText(&player.*.artist), COLUMN, PADDING + 26, state.TEXT_COLOR, text_width)
    const second = if player.*.album.length > 0 { state.labelText(&player.*.album) } else { state.labelText(&player.*.identity) }
    text_module.drawText(canvas, state.smallOf(bar), second, COLUMN, PADDING + 48, dim, text_width)
    // Where the track is.
    canvas_module.fillRoundedRect(canvas, COLUMN, LINE_TOP, text_width, 4, 2, canvas_module.color(60, 255, 255, 255))
    if player.*.length > 0 {
        const position = estimate(player)
        const done = @intCast(i32, @intCast(i64, text_width) * position / player.*.length)
        canvas_module.fillRoundedRect(canvas, COLUMN, LINE_TOP, done, 4, 2, state.TEXT_COLOR)
        if bar.*.popupHover == HIT_SEEK { canvas_module.fillRoundedRect(canvas, COLUMN + done - 5, LINE_TOP - 3, 10, 10, 5, state.TEXT_COLOR) }
        var time: [24]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &time) }
        text_module.drawText(canvas, state.smallOf(bar), clockText(position, bytes), COLUMN, LINE_TOP + 8, dim, 0)
        const total = clockText(player.*.length, bytes)
        text_module.drawText(canvas, state.smallOf(bar), total, WIDTH - PADDING - text_module.measure(state.smallOf(bar), total), LINE_TOP + 8, dim, 0)
    }
    // Previous, play/pause, next.
    var which: usize = 0
    while which < 3 {
        const left = controlLeft(which)
        const top = CONTROLS
        if bar.*.popupHover == HIT_PREVIOUS + which { canvas_module.fillRoundedRect(canvas, left, top, CONTROL, CONTROL, CONTROL / 2, canvas_module.color(40, 255, 255, 255)) }
        const able = (which == 0 && player.*.canPrevious) || (which == 2 && player.*.canNext) || which == 1
        const color = if able { state.TEXT_COLOR } else { canvas_module.color(70, 255, 255, 255) }
        if which == 1 {
            if player.*.status == state.PLAYING { drawPause(canvas, left + 9, top + 9, 14, color) } else { drawPlay(canvas, left + 9, top + 8, 16, color) }
        } else {
            drawSkip(canvas, left + 7, top + 10, 12, which == 0, color)
        }
        which += 1
    }
}
