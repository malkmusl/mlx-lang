// The popup under the bar (one at a time: the panel's popup menu): the
// calendar, what plays, the volume, the battery, or a tray item's menu.
// It opens under its widget (kept on the screen), a click on the widget
// again closes it, and so does a click anywhere else (the compositor's
// popup_done). The pointer on it and its buttons go to its part.
//
// The popups look like the dock's folder stacks: a dark rounded panel with
// a header (its title, a button at the right: frame) over a line. They
// come in sliding down a little and fading in, and fade out going.
const state = @import("./state.mlx")
const calendar = @import("./calendar.mlx")
const media = @import("./media.mlx")
const sound = @import("./sound.mlx")
const battery = @import("./battery.mlx")
const tray = @import("./tray.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")
const panel_menu = @import("std.ui.wayland.panel_menu")
const apps_module = @import("../shared/apps.mlx")

const Bar = state.Bar
const Canvas = state.Canvas

const BUTTON_LEFT: u32 = 272
const GAP: i32 = 6
const MARGIN: i32 = 8
// The header (its title and button) is this tall, a line under it.
pub const HEADER: i32 = 46
const BUTTON_TOP: i32 = 10
const BUTTON_HEIGHT: i32 = 26
// The header's button (popupHover).
pub const HIT_BUTTON: usize = 99
// How long it takes to come and to go (milliseconds), and how far it
// slides coming.
const COME: usize = 200
const GO: usize = 140
const SLIDE: i32 = 10

pub const BACKGROUND: u32 = 4280164650
pub const PANEL: u32 = 4282006090
pub const WHITE: u32 = 4293981944

// The header button's label for popup `kind` (none: no button).
fn buttonLabel(bar: *Bar, kind: u32) -> []const u8 {
    const german = bar.*.german
    if kind == state.POPUP_CALENDAR { return if german { "Heute" } else { "Today" } }
    if kind == state.POPUP_MEDIA { return if german { "Öffnen" } else { "Open" } }
    if kind == state.POPUP_SOUND { return if german { "Einstellungen" } else { "Settings" } }
    return ""
}

fn buttonWidth(bar: *Bar, label: []const u8) -> i32 { return text_module.measure(state.smallOf(bar), label) + 24 }

// The popup's panel: its background and edge, the header's title and
// button (lit under the pointer), the line under them.
pub fn frame(bar: *Bar, canvas: *Canvas, title: []const u8) -> void {
    const width = @intCast(i32, canvas.*.width)
    const height = @intCast(i32, canvas.*.height)
    canvas_module.clear(canvas, 0)
    canvas_module.fillRoundedRect(canvas, 0, 0, width, height, 14, BACKGROUND)
    canvas_module.strokeRoundedRect(canvas, 0, 0, width, height, 14, 1, canvas_module.color(60, 255, 255, 255))
    const label = buttonLabel(bar, bar.*.popup)
    var title_room = width - 32
    if label.length > 0 {
        const button_width = buttonWidth(bar, label)
        const left = width - 16 - button_width
        title_room = left - 28
        const lit = bar.*.popupHover == HIT_BUTTON
        canvas_module.fillRoundedRect(canvas, left, BUTTON_TOP, button_width, BUTTON_HEIGHT, 8, PANEL)
        if lit {
            const t = state.popupAlong(bar, bar.*.popupLitAt, 120)
            canvas_module.fillRoundedRect(canvas, left, BUTTON_TOP, button_width, BUTTON_HEIGHT, 8, canvas_module.color(@intCast(u32, t * 255 / 1024), 90, 160, 255))
        }
        text_module.drawText(canvas, state.smallOf(bar), label, left + 12, BUTTON_TOP + 6, WHITE, 0)
    }
    text_module.drawText(canvas, state.boldOf(bar), title, 16, 15, WHITE, title_room)
    canvas_module.fillRect(canvas, 12, HEADER - 2, width - 24, 1, canvas_module.color(50, 255, 255, 255))
}

// A light under the pointer in a popup, fading in since it went there.
pub fn light(bar: *Bar, canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, radius: i32) -> void {
    const t = state.popupAlong(bar, bar.*.popupLitAt, 120)
    canvas_module.fillRoundedRect(canvas, x, y, width, height, radius, canvas_module.color(@intCast(u32, 52 * t / 1024 + 4), 255, 255, 255))
}

// A small heading inside a popup ("Ausgabe", "Apps").
pub fn heading(bar: *Bar, canvas: *Canvas, label: []const u8, y: i32) -> void {
    text_module.drawText(canvas, state.smallOf(bar), label, 16, y, canvas_module.color(150, 255, 255, 255), 0)
}

// Slides the drawn popup up by what is left of its coming in and fades it
// (t: 0 to 1024 of the way in).
fn settle(canvas: *Canvas, t: i32) -> void {
    const width = canvas.*.width
    const height = canvas.*.height
    const stride = canvas.*.stride
    const offset = @intCast(usize, (1024 - t) * SLIDE / 1024)
    const alpha = @intCast(u32, t * 255 / 1024)
    const pixels = canvas.*.pixels
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            var pixel: u32 = 0
            if y + offset < height { pixel = pixels[(y + offset) * stride + x] }
            const a = ((pixel >> 24) & 255) * alpha / 255
            const r = ((pixel >> 16) & 255) * alpha / 255
            const g = ((pixel >> 8) & 255) * alpha / 255
            const b = (pixel & 255) * alpha / 255
            pixels[y * stride + x] = (a << 24) | (r << 16) | (g << 8) | b
            x += 1
        }
        y += 1
    }
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const bar = state.barOf(context)
    bar.*.popupMoving = false
    const kind = bar.*.popup
    if kind == state.POPUP_CALENDAR { calendar.draw(bar, canvas) }
    if kind == state.POPUP_MEDIA { media.draw(bar, canvas) }
    if kind == state.POPUP_SOUND { sound.draw(bar, canvas) }
    if kind == state.POPUP_BATTERY { battery.draw(bar, canvas) }
    if kind == state.POPUP_TRAY { tray.drawMenu(bar, canvas) }
    var t = state.popupAlong(bar, bar.*.popupOpenedAt, COME)
    if bar.*.closing {
        t = 1024 - state.popupAlong(bar, bar.*.closingAt, GO)
        bar.*.popupMoving = true
    }
    if t < 1024 { settle(canvas, t) }
    if bar.*.popupMoving { state.fastTicks(bar) }
}

// Opens popup `kind`, `width` x `height`, centred under x = `centre` of
// the bar.
pub fn open(bar: *Bar, kind: u32, centre: i32, width: i32, height: i32) -> void {
    const panel = state.panelOf(bar)
    if bar.*.closing { finish(bar) }
    const bar_width = @intCast(i32, panel.*.width)
    var left = centre - width / 2
    if left + width > bar_width - MARGIN { left = bar_width - MARGIN - width }
    if left < MARGIN { left = MARGIN }
    bar.*.popup = kind
    bar.*.popupHover = state.NONE
    bar.*.dragging = false
    bar.*.popupOpenedAt = state.milliseconds()
    // Anchored at its own top left: the rectangle's bottom right corner.
    if !panel_menu.openMenu(panel, left - 1, 0, 1, state.HEIGHT + GAP, panel_module.PLACE_BOTTOM_RIGHT, @intCast(u32, width), @intCast(u32, height), draw) {
        bar.*.popup = state.POPUP_NONE
        return
    }
    if kind == state.POPUP_MEDIA { media.opened(bar) }
    if kind == state.POPUP_SOUND { sound.opened(bar) }
    if kind == state.POPUP_BATTERY { battery.tick(bar, true) }
    state.say(bar, "topbar: popup ")
    state.say(bar, match kind { 1 => "calendar", 2 => "media", 3 => "sound", 4 => "battery", else => "menu" })
    state.say(bar, "\n")
    state.barChanged(bar)
}

// The popup goes (fading out; it is gone once that is over).
pub fn close(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_NONE || bar.*.closing { return }
    bar.*.closing = true
    bar.*.closingAt = state.milliseconds()
    bar.*.dragging = false
    state.popupChanged(bar)
    state.barChanged(bar)
}

// Gone at once (the faded out one, or for another to come).
fn finish(bar: *Bar) -> void {
    bar.*.closing = false
    bar.*.popup = state.POPUP_NONE
    bar.*.dragging = false
    panel_menu.closeMenu(state.panelOf(bar))
    state.barChanged(bar)
}

// The same size again, at once (what it shows grew or shrank).
pub fn resize(bar: *Bar, centre: i32, width: i32, height: i32) -> void {
    const panel = state.panelOf(bar)
    if bar.*.popup == state.POPUP_NONE || bar.*.closing { return }
    if panel.*.menuWidth == @intCast(usize, width) && panel.*.menuHeight == @intCast(usize, height) { return }
    const kind = bar.*.popup
    const hover = bar.*.popupHover
    panel_menu.closeMenu(panel)
    const bar_width = @intCast(i32, panel.*.width)
    var left = centre - width / 2
    if left + width > bar_width - MARGIN { left = bar_width - MARGIN - width }
    if left < MARGIN { left = MARGIN }
    if !panel_menu.openMenu(panel, left - 1, 0, 1, state.HEIGHT + GAP, panel_module.PLACE_BOTTOM_RIGHT, @intCast(u32, width), @intCast(u32, height), draw) {
        bar.*.popup = state.POPUP_NONE
        return
    }
    bar.*.popup = kind
    bar.*.popupHover = hover
}

// The compositor took it away.
pub fn closed(bar: *Bar) -> void {
    state.say(bar, "topbar: popup closed\n")
    bar.*.popup = state.POPUP_NONE
    bar.*.closing = false
    bar.*.dragging = false
    state.barChanged(bar)
}

fn hitAt(bar: *Bar, x: i32, y: i32) -> usize {
    const kind = bar.*.popup
    const label = buttonLabel(bar, kind)
    if label.length > 0 && y >= BUTTON_TOP && y < BUTTON_TOP + BUTTON_HEIGHT {
        const width = @intCast(i32, state.panelOf(bar).*.menuWidth)
        const left = width - 16 - buttonWidth(bar, label)
        if x >= left && x < width - 16 { return HIT_BUTTON }
    }
    if kind == state.POPUP_CALENDAR { return calendar.hit(x, y) }
    if kind == state.POPUP_MEDIA { return media.hit(x, y) }
    if kind == state.POPUP_SOUND { return sound.hit(bar, x, y) }
    return state.NONE
}

pub fn motion(bar: *Bar, x: i32, y: i32) -> void {
    if bar.*.closing { return }
    bar.*.popupX = x
    bar.*.popupY = y
    if bar.*.popup == state.POPUP_TRAY {
        tray.menuMotion(bar, y)
        return
    }
    if bar.*.dragging && bar.*.popup == state.POPUP_SOUND {
        sound.drag(bar, x)
        return
    }
    const hover = hitAt(bar, x, y)
    if hover != bar.*.popupHover {
        bar.*.popupHover = hover
        bar.*.popupLitAt = state.milliseconds()
        state.popupChanged(bar)
    }
}

pub fn leave(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_TRAY {
        state.menuOf(bar).*.hover = 1 << 40
        state.popupChanged(bar)
        return
    }
    if bar.*.dragging { return }
    bar.*.popupHover = state.NONE
    state.popupChanged(bar)
}

// The header's button: today's month, the player's window, the sound
// settings.
fn pressButton(bar: *Bar) -> void {
    const kind = bar.*.popup
    if kind == state.POPUP_CALENDAR { calendar.goToday(bar) }
    if kind == state.POPUP_MEDIA { media.raise(bar) }
    if kind == state.POPUP_SOUND {
        apps_module.runScript("mlx-settings sound", bar.*.environment)
        state.say(bar, "topbar: sound settings\n")
        close(bar)
    }
}

pub fn button(bar: *Bar, which: u32, pressed: bool) -> void {
    if which != BUTTON_LEFT || bar.*.closing { return }
    const kind = bar.*.popup
    if !pressed {
        if bar.*.dragging {
            bar.*.dragging = false
            state.popupChanged(bar)
        }
        if kind == state.POPUP_TRAY { tray.menuClick(bar) }
        return
    }
    if bar.*.popupHover == HIT_BUTTON {
        pressButton(bar)
        return
    }
    if kind == state.POPUP_CALENDAR { calendar.click(bar) }
    if kind == state.POPUP_MEDIA { media.click(bar) }
    if kind == state.POPUP_SOUND { sound.press(bar) }
}

pub fn wheel(bar: *Bar, steps: i32) -> void {
    if bar.*.closing { return }
    if bar.*.popup == state.POPUP_CALENDAR { calendar.turn(bar, if steps > 0 { 1 } else { -1 }) }
    if bar.*.popup == state.POPUP_SOUND { sound.popupWheel(bar, steps) }
}

// Every tick: a popup that faded out goes.
pub fn step(bar: *Bar) -> void {
    if bar.*.closing && anim_done(bar) { finish(bar) }
    if bar.*.popupMoving { state.popupChanged(bar) }
}

fn anim_done(bar: *Bar) -> bool { return state.milliseconds() - bar.*.closingAt >= GO }

// Every second (the clock's tick): what the popup shows that moves.
pub fn tick(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_MEDIA && !bar.*.closing {
        if media.shown(bar) == state.NONE {
            close(bar)
            return
        }
        media.poll(bar)
        state.popupChanged(bar)
    }
}
