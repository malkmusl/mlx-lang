// The popup under the bar (one at a time: the panel's popup menu): the
// calendar, what plays, the volume, the battery, or a tray item's menu.
// It opens under its widget (kept on the screen), a click on the widget
// again closes it, and so does a click anywhere else (the compositor's
// popup_done). The pointer on it and its buttons go to its part.
const state = @import("./state.mlx")
const calendar = @import("./calendar.mlx")
const media = @import("./media.mlx")
const sound = @import("./sound.mlx")
const battery = @import("./battery.mlx")
const tray = @import("./tray.mlx")
const panel_module = @import("std.ui.wayland.panel")
const panel_menu = @import("std.ui.wayland.panel_menu")

const Bar = state.Bar
const Canvas = state.Canvas

const BUTTON_LEFT: u32 = 272
const GAP: i32 = 4
const MARGIN: i32 = 8

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const bar = state.barOf(context)
    const kind = bar.*.popup
    if kind == state.POPUP_CALENDAR { calendar.draw(bar, canvas) }
    if kind == state.POPUP_MEDIA { media.draw(bar, canvas) }
    if kind == state.POPUP_SOUND { sound.draw(bar, canvas) }
    if kind == state.POPUP_BATTERY { battery.draw(bar, canvas) }
    if kind == state.POPUP_TRAY { tray.drawMenu(bar, canvas) }
}

// Opens popup `kind`, `width` x `height`, centred under x = `centre` of
// the bar.
pub fn open(bar: *Bar, kind: u32, centre: i32, width: i32, height: i32) -> void {
    const panel = state.panelOf(bar)
    const bar_width = @intCast(i32, panel.*.width)
    var left = centre - width / 2
    if left + width > bar_width - MARGIN { left = bar_width - MARGIN - width }
    if left < MARGIN { left = MARGIN }
    bar.*.popup = kind
    bar.*.popupHover = state.NONE
    bar.*.dragging = false
    // Anchored at its own top left: the rectangle's bottom right corner.
    if !panel_menu.openMenu(panel, left - 1, 0, 1, state.HEIGHT + GAP, panel_module.PLACE_BOTTOM_RIGHT, @intCast(u32, width), @intCast(u32, height), draw) {
        bar.*.popup = state.POPUP_NONE
        return
    }
    if kind == state.POPUP_MEDIA { media.opened(bar) }
    if kind == state.POPUP_SOUND { sound.opened(bar) }
    if kind == state.POPUP_BATTERY { battery.tick(bar, true) }
    state.say(bar, "topbar: popup ")
    state.say(bar, match kind { 1 => "calendar", 2 => "media", 3 => "sound", 4 => "battery", else => "menu" })
    state.say(bar, "\n")
    state.barChanged(bar)
}

pub fn close(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_NONE { return }
    bar.*.popup = state.POPUP_NONE
    bar.*.dragging = false
    panel_menu.closeMenu(state.panelOf(bar))
    state.barChanged(bar)
}

// The compositor took it away.
pub fn closed(bar: *Bar) -> void {
    state.say(bar, "topbar: popup closed\n")
    bar.*.popup = state.POPUP_NONE
    bar.*.dragging = false
    state.barChanged(bar)
}

fn hitAt(bar: *Bar, x: i32, y: i32) -> usize {
    const kind = bar.*.popup
    if kind == state.POPUP_CALENDAR { return calendar.hit(x, y) }
    if kind == state.POPUP_MEDIA { return media.hit(x, y) }
    if kind == state.POPUP_SOUND { return sound.hit(x, y) }
    return state.NONE
}

pub fn motion(bar: *Bar, x: i32, y: i32) -> void {
    bar.*.popupX = x
    bar.*.popupY = y
    if bar.*.popup == state.POPUP_TRAY {
        tray.menuMotion(bar, y)
        return
    }
    if bar.*.dragging && bar.*.popup == state.POPUP_SOUND {
        sound.slide(bar, x)
        return
    }
    const hover = hitAt(bar, x, y)
    if hover != bar.*.popupHover {
        bar.*.popupHover = hover
        state.popupChanged(bar)
    }
}

pub fn leave(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_TRAY {
        state.menuOf(bar).*.hover = 1 << 40
        state.popupChanged(bar)
        return
    }
    if bar.*.dragging { return }
    bar.*.popupHover = state.NONE
    state.popupChanged(bar)
}

pub fn button(bar: *Bar, which: u32, pressed: bool) -> void {
    if which != BUTTON_LEFT { return }
    const kind = bar.*.popup
    if !pressed {
        if bar.*.dragging {
            bar.*.dragging = false
            state.popupChanged(bar)
        }
        if kind == state.POPUP_TRAY { tray.menuClick(bar) }
        return
    }
    if kind == state.POPUP_CALENDAR { calendar.click(bar) }
    if kind == state.POPUP_MEDIA { media.click(bar) }
    if kind == state.POPUP_SOUND { sound.press(bar) }
}

pub fn wheel(bar: *Bar, steps: i32) -> void {
    if bar.*.popup == state.POPUP_CALENDAR { calendar.turn(bar, if steps > 0 { 1 } else { -1 }) }
    if bar.*.popup == state.POPUP_SOUND { sound.wheel(bar, steps) }
}

// Every second (the clock's tick): what the popup shows that moves.
pub fn tick(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_MEDIA {
        if media.shown(bar) == state.NONE {
            close(bar)
            return
        }
        media.poll(bar)
        state.popupChanged(bar)
    }
}
