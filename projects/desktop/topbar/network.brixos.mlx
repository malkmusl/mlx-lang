// The control centre's network on brixOS: what the kernel says. Here the
// kernel runs the network (the card's driver, DHCP or the address of the
// file /system/settings/network), so there is no nexus and no bus to ask,
// and no /sys/class/net: every link is a node, /devices/net0 and on,
// whose read gives its state (std.os.brix's networkLink; the record is
// spec/04-stdlib/os/brix.xml's NetworkLink). The settings' Network page
// reads the same (settings/network.brixos.mlx).
//
// The same interface as network.mlx (Linux: nexus over the system bus),
// in whose place the compiler takes this file for brixOS. A read is a few
// calls and never waits, so the bar reads the links on every tick of its
// slow work (once a second), the popup open or not (FOLLOWS), and what
// the tile and the bar's sign show is right without being asked for:
//
//   - a link with a cable and an address: Ethernet, with the address;
//   - else a link with a cable: no address yet (DHCP goes on asking);
//   - else a link: no cable;
//   - no link: the kernel drives no network device of this machine.
//
// The bar and the popup are drawn again only when that is another than
// before. Under a compositor run with --verbose it is then said in a
// line: "horizon: network: net0 connected, 10.0.2.15", "horizon: network:
// net0 no cable", "horizon: network: net0 no address yet", "horizon:
// network: no links".
//
// There is nothing to switch from here and no wireless: a click on the
// tile opens the settings on their Network page.
const std = @import("std")
const brix = std.os.brix
const state = @import("./state.mlx")
const apps_module = @import("../shared/apps.mlx")

const Bar = state.Bar

// The bar reads the network on every tick, not only for the open popup.
pub const FOLLOWS: bool = true

// (The list of Wi-Fi networks is Linux's; control.mlx names these.)
pub const SECURITY_OPEN: u32 = 0
pub const SECURITY_WPA2: u32 = 1
pub const SECURITY_OTHER: u32 = 2

// What control.mlx's tile shows (the same values as its NET_*).
const NET_NONE: u32 = 0
const NET_WIRED: u32 = 1

// How far a link is: its cable out, a cable and no address yet, an
// address. The tile is about the link that is furthest (the first of
// them); 0: there is no link.
const NO_CABLE: usize = 1
const NO_ADDRESS: usize = 2
const CONNECTED: usize = 3

pub fn init(bar: *Bar) -> void {
    bar.*.netClient = 0
    bar.*.netKnown = false
    bar.*.netConnecting = false
    state.labelClear(&bar.*.netJoining)
    bar.*.hasWifi = false
    bar.*.wifiCount = 0
    bar.*.netListOpen = false
    bar.*.netListAt = 0
    bar.*.netClosingAt = 0
    bar.*.netOffline = state.OFFLINE_NO_LINK
    bar.*.netShown = 0
    // The first frame shows what the kernel says now.
    _ = refresh(bar)
}

// "a.b.c.d" after `at`; the new length.
fn putAddress(into: [*]u8, at: usize, capacity: usize, address: [4]u8) -> usize {
    var length = at
    var part: usize = 0
    while part < 4 {
        if part > 0 { length = std.text.appendByte(into, length, capacity, 46) }
        length = std.text.appendUnsigned(into, length, capacity, @intCast(usize, address[part]))
        part += 1
    }
    return length
}

// What the bar shows now, in a line for the compositor's log (a line goes
// out whole: the log is the compositor's too).
fn tell(far: usize, index: usize, address: [4]u8) -> void {
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, "horizon: network: ")
    if far == 0 {
        length = std.text.append(bytes, length, 96, "no links")
    } else {
        length = std.text.append(bytes, length, 96, "net")
        length = std.text.appendUnsigned(bytes, length, 96, index)
        length = std.text.append(bytes, length, 96, if far == CONNECTED { " connected, " } else if far == NO_ADDRESS { " no address yet" } else { " no cable" })
        if far == CONNECTED { length = putAddress(bytes, length, 96, address) }
    }
    length = std.text.append(bytes, length, 96, "\n")
    _ = std.io.writeAll(std.io.stdout(), bytes[0..length])
}

// The links read again from the kernel (net0, net1, ... until one is not
// there), and what the tile and the sign show set from them; true always:
// the kernel answers at once (control.mlx never looks elsewhere).
pub fn refresh(bar: *Bar) -> bool {
    var link: brix.NetworkLink = undefined
    var far: usize = 0
    var shown: usize = 0
    var address: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    var index: usize = 0
    while index < brix.NETWORK_LINKS && brix.networkLink(index, &link) == 0 {
        const stage = if !link.up { NO_CABLE } else if link.configured == brix.NetworkLink.NONE { NO_ADDRESS } else { CONNECTED }
        if stage > far {
            far = stage
            shown = index
            address = link.address
        }
        index += 1
    }
    // The same as before: nothing is touched, nothing drawn again.
    var signature = far + 1 + (shown << 8)
    if far == CONNECTED { signature |= (@intCast(usize, address[0]) << 16) | (@intCast(usize, address[1]) << 24) | (@intCast(usize, address[2]) << 32) | (@intCast(usize, address[3]) << 40) }
    if signature == bar.*.netShown { return true }
    bar.*.netShown = signature
    bar.*.netKind = if far == CONNECTED { NET_WIRED } else { NET_NONE }
    bar.*.netOffline = if far == CONNECTED { state.OFFLINE_UNKNOWN } else if far == NO_ADDRESS { state.OFFLINE_NO_ADDRESS } else if far == NO_CABLE { state.OFFLINE_NO_CABLE } else { state.OFFLINE_NO_LINK }
    // The tile's second line for a connection: its address.
    state.labelClear(&bar.*.netName)
    if far == CONNECTED {
        var text: [16]u8 = undefined
        const bytes: [*]u8 = &text
        state.labelSet(&bar.*.netName, bytes[0..putAddress(bytes, 0, 16, address)])
    }
    if bar.*.tellsNames { tell(far, shown, address) }
    state.barChanged(bar)
    state.popupChanged(bar)
    return true
}

// The settings on their Network page (nothing is switched from the bar
// here, so this is what the tile's click does; there is no network to
// choose).
pub fn openSettings(bar: *Bar, ssid: []const u8) -> void {
    _ = ssid
    apps_module.runScript("control network", bar.*.environment)
    state.say(bar, "topbar: network settings\n")
}

// (A row of Linux's list of Wi-Fi networks: there is none here.)
pub fn choose(bar: *Bar, index: usize) -> bool {
    _ = bar
    _ = index
    return false
}
