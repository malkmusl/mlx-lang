// The batteries: the entries of /sys/class/power_supply (MLX_TOPBAR_POWER
// names another directory, for tests) whose type is Battery, not a
// device's (scope Device: a mouse's, a headset's). Together: the charge
// (energy_now / energy_full, else charge_now / charge_full, else
// capacity), whether one charges or all are full, and the time to empty
// or to full from power_now (current_now). Read every READ milliseconds.
// The bar shows a battery as full as the charge (red under LOW percent), a
// bolt while it charges, and the percent; a click opens a popup that says
// it in words.
const std = @import("std")
const state = @import("./state.mlx")
const anim = @import("../shared/anim.mlx")
const popup = @import("./popup.mlx")
const symbols = @import("../shared/symbols.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")

const Bar = state.Bar
const Canvas = state.Canvas

const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_getdents64: usize = 217
const O_DIRECTORY: usize = 65536
const O_CLOEXEC: usize = 524288
const READ: usize = 30000
const LOW: i32 = 15

pub const WIDTH: i32 = 280
const PADDING: i32 = 16
// Under the header: the battery big and what it does, then the charge as
// a line.
const CONTENT: i32 = 54
const LINE: i32 = CONTENT + 52
pub const HEIGHT: i32 = LINE + 20
// The symbol on the bar.
const SYMBOL: i32 = 24

// A small file of the battery's: its text without the newline, into
// `out` (64 bytes); its length (0: none).
fn readValue(directory: []const u8, name: []const u8, file: []const u8, out: [*]u8) -> usize {
    var path: state.Label = undefined
    path.length = 0
    state.labelAdd(&path, directory)
    state.labelAdd(&path, "/")
    state.labelAdd(&path, name)
    state.labelAdd(&path, "/")
    state.labelAdd(&path, file)
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(state.labelPath(&path)), O_CLOEXEC, 0)
    if descriptor < 0 { return 0 }
    const count = std.linux.syscall3(0, @bitCast(usize, descriptor), @intFromPtr(out), 63)
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    if count <= 0 { return 0 }
    var length = @intCast(usize, count)
    while length > 0 && (out[length - 1] == 10 || out[length - 1] == 32) { length -= 1 }
    return length
}

fn numberOf(directory: []const u8, name: []const u8, file: []const u8) -> i64 {
    var text: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = readValue(directory, name, file, bytes)
    if length == 0 { return -1 }
    var value: i64 = 0
    var index: usize = 0
    while index < length && text[index] >= 48 && text[index] <= 57 {
        value = value * 10 + @intCast(i64, text[index] - 48)
        index += 1
    }
    return if index == 0 { -1 } else { value }
}

fn valueIs(directory: []const u8, name: []const u8, file: []const u8, wanted: []const u8) -> bool {
    var text: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = readValue(directory, name, file, bytes)
    return state.same(bytes[0..length], wanted)
}

// What the batteries add up to.
const Sum = struct {
    count: usize
    now: i64
    full: i64
    power: i64
    percent: i64
    charging: bool
    discharging: bool
}

fn addBattery(directory: []const u8, name: []const u8, sum: *Sum) -> void {
    if !valueIs(directory, name, "type", "Battery") || valueIs(directory, name, "scope", "Device") { return }
    sum.*.count += 1
    var now = numberOf(directory, name, "energy_now")
    var full = numberOf(directory, name, "energy_full")
    var power = numberOf(directory, name, "power_now")
    if now < 0 || full <= 0 {
        now = numberOf(directory, name, "charge_now")
        full = numberOf(directory, name, "charge_full")
        power = numberOf(directory, name, "current_now")
    }
    if now >= 0 && full > 0 {
        sum.*.now += now
        sum.*.full += full
        if power > 0 { sum.*.power += power }
    } else {
        const capacity = numberOf(directory, name, "capacity")
        if capacity >= 0 { sum.*.percent += capacity }
    }
    if valueIs(directory, name, "status", "Charging") { sum.*.charging = true }
    if valueIs(directory, name, "status", "Discharging") { sum.*.discharging = true }
}

// Reads them again when it is time (or at once with `now`).
pub fn tick(bar: *Bar, now: bool) -> void {
    if !now && bar.*.batteryAt != 0 && state.milliseconds() - bar.*.batteryAt < READ { return }
    bar.*.batteryAt = state.milliseconds()
    const root = state.labelText(state.powerRootOf(bar))
    var sum = Sum.{ .count = 0, .now = 0, .full = 0, .power = 0, .percent = 0, .charging = false, .discharging = false }
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(state.labelPath(state.powerRootOf(bar))), O_DIRECTORY | O_CLOEXEC, 0)
    if descriptor >= 0 {
        var buffer: [4096]u8 = undefined
        while true {
            const count = std.linux.syscall3(SYS_getdents64, @bitCast(usize, descriptor), @intFromPtr(&buffer), 4096)
            if count <= 0 { break }
            var at: usize = 0
            while at < @intCast(usize, count) {
                const record = @intCast(usize, buffer[at + 16]) | (@intCast(usize, buffer[at + 17]) << 8)
                var end = at + 19
                while end < at + record && buffer[end] != 0 { end += 1 }
                var bytes: [*]const u8 = undefined
                unsafe { bytes = @ptrCast([*]const u8, &buffer) }
                const name = bytes[at + 19..end]
                if name.length > 0 && name[0] != 46 { addBattery(root, name, &sum) }
                if record == 0 { break }
                at += record
            }
        }
        const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    }
    const before = bar.*.charge
    const before_charging = bar.*.charging
    const before_count = bar.*.batteries
    bar.*.batteries = sum.count
    bar.*.charge = if sum.full > 0 { @intCast(i32, (sum.now * 100 + sum.full / 2) / sum.full) } else if sum.count > 0 { @intCast(i32, sum.percent / @intCast(i64, sum.count)) } else { 0 }
    if bar.*.charge > 100 { bar.*.charge = 100 }
    bar.*.charging = sum.charging
    bar.*.full = sum.count > 0 && !sum.charging && !sum.discharging
    bar.*.minutesLeft = -1
    if sum.power > 0 && sum.full > 0 {
        if sum.charging { bar.*.minutesLeft = (sum.full - sum.now) * 60 / sum.power }
        if sum.discharging { bar.*.minutesLeft = sum.now * 60 / sum.power }
    }
    if before_count == 0 { anim.jump(state.chargeShownOf(bar), bar.*.charge) } else { anim.set(state.chargeShownOf(bar), bar.*.charge, 600) }
    if before != bar.*.charge || before_charging != bar.*.charging || before_count != bar.*.batteries {
        if sum.count > 0 {
            state.say(bar, "topbar: battery ")
            state.sayNumber(bar, @intCast(i64, bar.*.charge))
            state.say(bar, if bar.*.charging { "%, charging\n" } else if bar.*.full { "%, full\n" } else { "%\n" })
        }
        state.barChanged(bar)
        state.popupChanged(bar)
    }
}

fn percentText(bar: *Bar, out: [*]u8) -> []const u8 {
    var length = state.putNumber(out, 0, @intCast(i64, bar.*.charge), 1)
    length = state.put(out, length, " %")
    return out[0..length]
}

// The battery symbol's variant for `charge` (shared/symbols.mlx).
fn variant(bar: *Bar, charge: i32) -> u32 {
    var value = @intCast(u32, if charge < 0 { 0 } else if charge > 100 { 100 } else { charge })
    if bar.*.charging { value += symbols.CHARGING }
    if bar.*.charge < LOW && !bar.*.charging { value += symbols.LOW }
    return value
}

pub fn widgetWidth(bar: *Bar) -> i32 {
    if bar.*.batteries == 0 { return 0 }
    var text: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    return SYMBOL + 4 + text_module.measure(state.textOf(bar), percentText(bar, bytes)) + 10
}

pub fn drawWidget(bar: *Bar, canvas: *Canvas, left: i32) -> void {
    if bar.*.batteries == 0 { return }
    const light = state.glided(bar, state.lightOf(bar, state.WIDGET_BATTERY))
    const lit = if bar.*.popup == state.POPUP_BATTERY { 255 } else { light }
    if lit > 0 { canvas_module.fillRoundedRect(canvas, left, 3, widgetWidth(bar), state.HEIGHT - 6, 6, canvas_module.color(@intCast(u32, lit * 40 / 255), 255, 255, 255)) }
    const charge = state.glided(bar, state.chargeShownOf(bar))
    symbols.draw(state.symbolsOf(bar), canvas, symbols.BATTERY, variant(bar, charge), left + 4, (state.HEIGHT - SYMBOL) / 2, SYMBOL, 4294967295)
    var text: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    text_module.drawText(canvas, state.textOf(bar), percentText(bar, bytes), left + 4 + SYMBOL + 4, (state.HEIGHT - 16) / 2, state.TEXT_COLOR, 0)
}

pub fn draw(bar: *Bar, canvas: *Canvas) -> void {
    const german = bar.*.german
    popup.frame(bar, canvas, if german { "Batterie" } else { "Battery" })
    var text: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const percent = percentText(bar, bytes)
    text_module.drawText(canvas, state.boldOf(bar), percent, WIDTH - PADDING - text_module.measure(state.boldOf(bar), percent), 15, state.TEXT_COLOR, 0)
    symbols.draw(state.symbolsOf(bar), canvas, symbols.BATTERY, variant(bar, bar.*.charge), PADDING, CONTENT + 2, 40, 4294967295)
    // "Wird geladen, voll in 1:20 h" / "Discharging, 3:05 h left".
    var line: [96]u8 = undefined
    var line_bytes: [*]u8 = undefined
    unsafe { line_bytes = @ptrCast([*]u8, &line) }
    var length: usize = 0
    if bar.*.charging {
        length = state.put(line_bytes, 0, if german { "Wird geladen" } else { "Charging" })
        if bar.*.minutesLeft >= 0 { length = state.put(line_bytes, length, if german { ", voll in " } else { ", full in " }) }
    } else if bar.*.full {
        length = state.put(line_bytes, 0, if german { "Vollständig geladen" } else { "Fully charged" })
    } else {
        length = state.put(line_bytes, 0, if german { "Akkubetrieb" } else { "On battery" })
        if bar.*.minutesLeft >= 0 { length = state.put(line_bytes, length, if german { ", noch " } else { ", " }) }
    }
    if bar.*.minutesLeft >= 0 && !bar.*.full {
        length = state.putNumber(line_bytes, length, bar.*.minutesLeft / 60, 1)
        length = state.put(line_bytes, length, ":")
        length = state.putNumber(line_bytes, length, bar.*.minutesLeft % 60, 2)
        length = state.put(line_bytes, length, " h")
        if !bar.*.charging && !german { length = state.put(line_bytes, length, " left") }
    }
    text_module.drawText(canvas, state.textOf(bar), line_bytes[0..length], PADDING + 52, CONTENT + 12, canvas_module.color(200, 255, 255, 255), WIDTH - 2 * PADDING - 52)
    // The charge as a line.
    canvas_module.fillRoundedRect(canvas, PADDING, LINE, WIDTH - 2 * PADDING, 4, 2, canvas_module.color(60, 255, 255, 255))
    const fill = if bar.*.charge < LOW && !bar.*.charging { canvas_module.color(255, 255, 90, 80) } else { state.ACCENT }
    canvas_module.fillRoundedRect(canvas, PADDING, LINE, (WIDTH - 2 * PADDING) * bar.*.charge / 100, 4, 2, fill)
}
