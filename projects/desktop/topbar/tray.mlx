// The tray: StatusNotifierItems, the icons Qt, libappindicator (GTK),
// Electron and others put there. An app registers its item with the
// watcher (bus.mlx: the bar itself, or another program the bar is then a
// host of); the bar shows each item that is not passive as its icon
// (IconPixmap, the size nearest above ICON; else IconName from the item's
// IconThemePath or the icon themes; else the first letter of its title),
// the attention icon while it needs attention. A left click is Activate
// (where it was, on the screen), a middle click SecondaryActivate, a
// right click the item's menu: com.canonical.dbusmenu (GetLayout, shown
// as the bar's popup; a click on an entry sends it Event "clicked"), else
// ContextMenu. An item that says ItemIsMenu shows its menu on a left
// click too. Items go when their connection does.
const dbus = @import("std.dbus")
const png = @import("std.png")
const state = @import("./state.mlx")
const bus = @import("./bus.mlx")
const popup = @import("./popup.mlx")
const apps_module = @import("../shared/apps.mlx")
const menu_module = @import("../shared/menu.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")

const Bar = state.Bar
const Canvas = state.Canvas
const Item = state.Item

pub const ITEM: []const u8 = "org.kde.StatusNotifierItem"
const MENU: []const u8 = "com.canonical.dbusmenu"
const DEFAULT_PATH: []const u8 = "/StatusNotifierItem"
// Each icon's room on the bar.
pub const SLOT: i32 = 26

fn find(bar: *Bar, bus_name: []const u8, path: []const u8) -> usize {
    var index: usize = 0
    while index < state.MAX_ITEMS {
        const item = state.itemAt(bar, index)
        if item.*.used && state.same(state.labelText(&item.*.bus), bus_name) && state.same(state.labelText(&item.*.path), path) { return index }
        index += 1
    }
    return state.NONE
}

pub fn clear(bar: *Bar) -> void {
    var index: usize = 0
    while index < state.MAX_ITEMS {
        state.itemAt(bar, index).*.used = false
        index += 1
    }
    if bar.*.popup == state.POPUP_TRAY { popup.close(bar) }
    state.barChanged(bar)
}

fn remove(bar: *Bar, index: usize) -> void {
    const item = state.itemAt(bar, index)
    item.*.used = false
    bus.forget(bar, bus.PURPOSE_IGNORE, state.MAX_PLAYERS + index)
    bus.itemUnregistered(bar, state.labelText(&item.*.service))
    if bar.*.popup == state.POPUP_TRAY && bar.*.menuItem == index { popup.close(bar) }
    state.say(bar, "topbar: tray item gone ")
    state.say(bar, state.labelText(&item.*.service))
    state.say(bar, "\n")
    state.barChanged(bar)
}

// The pending calls of an item are told apart from a player's by their
// slot: MAX_PLAYERS + the item's index.
fn slotOf(index: usize) -> usize { return state.MAX_PLAYERS + index }

// An item registered: `service` is its bus name (its object then at
// /StatusNotifierItem), an object path on `sender`'s connection, or (from
// another watcher) "NAME/PATH". `announce`: the bar is the watcher (it
// says so on the bus).
pub fn registered(bar: *Bar, service: []const u8, sender: []const u8, announce: bool) -> void {
    var bus_name = service
    var path: []const u8 = DEFAULT_PATH
    if service.length > 0 && service[0] == 47 {
        bus_name = sender
        path = service
    } else {
        var slash: usize = 0
        while slash < service.length && service[slash] != 47 { slash += 1 }
        if slash < service.length {
            bus_name = service[0..slash]
            path = service[slash..service.length]
        }
    }
    if bus_name.length == 0 || find(bar, bus_name, path) != state.NONE { return }
    var index: usize = 0
    while index < state.MAX_ITEMS && state.itemAt(bar, index).*.used { index += 1 }
    if index == state.MAX_ITEMS { return }
    const item = state.itemAt(bar, index)
    item.*.used = true
    state.labelSet(&item.*.bus, bus_name)
    state.labelSet(&item.*.path, path)
    // As the KDE watcher lists them: NAME/PATH.
    state.labelSet(&item.*.service, bus_name)
    state.labelAdd(&item.*.service, path)
    item.*.owner.length = 0
    item.*.id.length = 0
    item.*.title.length = 0
    item.*.status = state.ITEM_ACTIVE
    item.*.iconName.length = 0
    item.*.themePath.length = 0
    item.*.menu.length = 0
    item.*.itemIsMenu = false
    item.*.hasIcon = false
    if bus_name[0] == 58 {
        state.labelSet(&item.*.owner, bus_name)
    } else {
        bus.callString(bar, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner", bus_name, bus.PURPOSE_ITEM_OWNER, slotOf(index))
    }
    bus.getAll(bar, bus_name, path, ITEM, bus.PURPOSE_ITEM_PROPERTIES, slotOf(index))
    state.say(bar, "topbar: tray item ")
    state.say(bar, state.labelText(&item.*.service))
    state.say(bar, "\n")
    if announce { bus.itemRegistered(bar, state.labelText(&item.*.service)) }
}

pub fn unregistered(bar: *Bar, service: []const u8) -> void {
    var index: usize = 0
    while index < state.MAX_ITEMS {
        const item = state.itemAt(bar, index)
        if item.*.used && state.same(state.labelText(&item.*.service), service) { remove(bar, index) }
        index += 1
    }
}

// The connection `name` went (a bus name lost its owner).
pub fn vanished(bar: *Bar, name: []const u8) -> void {
    var index: usize = 0
    while index < state.MAX_ITEMS {
        const item = state.itemAt(bar, index)
        if item.*.used && (state.same(state.labelText(&item.*.bus), name) || state.same(state.labelText(&item.*.owner), name)) { remove(bar, index) }
        index += 1
    }
}

// An item said something changed (NewIcon, NewStatus, ...): its
// properties again.
pub fn changed(bar: *Bar, sender: []const u8, path: []const u8) -> void {
    var index: usize = 0
    while index < state.MAX_ITEMS {
        const item = state.itemAt(bar, index)
        if item.*.used && state.same(state.labelText(&item.*.owner), sender) && (path.length == 0 || state.same(state.labelText(&item.*.path), path)) {
            bus.getAll(bar, state.labelText(&item.*.bus), state.labelText(&item.*.path), ITEM, bus.PURPOSE_ITEM_PROPERTIES, slotOf(index))
        }
        index += 1
    }
}

pub fn replied(bar: *Bar, purpose: u32, slot: usize, reading: *dbus.Reader, failed: bool) -> void {
    if slot < state.MAX_PLAYERS || slot >= state.MAX_PLAYERS + state.MAX_ITEMS { return }
    const index = slot - state.MAX_PLAYERS
    const item = state.itemAt(bar, index)
    if !item.*.used || failed { return }
    if purpose == bus.PURPOSE_ITEM_OWNER {
        const owner = dbus.readString(reading)
        if !reading.*.failed { state.labelSet(&item.*.owner, owner) }
    } else if purpose == bus.PURPOSE_ITEM_PROPERTIES {
        apply(bar, index, reading)
    } else if purpose == bus.PURPOSE_MENU_LAYOUT {
        layout(bar, index, reading)
    }
}

// ---------------------------------------------------------------------------
// Properties and icons

// A pixmap of IconPixmap: where its pixels are in the message and its
// size (width 0: none).
const Pixmap = struct {
    at: usize
    width: i32
    height: i32
}

// The best of an a(iiay) of pixmaps: the smallest at least ICON wide, else
// the largest.
fn pixmaps(reading: *dbus.Reader, signature: []const u8) -> Pixmap {
    var best = Pixmap.{ .at = 0, .width = 0, .height = 0 }
    if !state.same(signature, "a(iiay)") {
        const skipped = dbus.skipValue(reading, signature, 0, 0)
        return best
    }
    const end = bus.arrayEnd(reading, 8)
    const wanted = @intCast(i32, state.ICON)
    while reading.*.position < end && !reading.*.failed {
        dbus.alignTo(reading, 8)
        const width = @bitCast(i32, dbus.readU32(reading))
        const height = @bitCast(i32, dbus.readU32(reading))
        const length = @intCast(usize, dbus.readU32(reading))
        const at = reading.*.position
        reading.*.position += length
        if reading.*.position > reading.*.length { reading.*.failed = true }
        if width > 0 && height > 0 && @intCast(usize, width) * @intCast(usize, height) * 4 <= length && !reading.*.failed {
            const better = best.width == 0 || (width >= wanted && (best.width < wanted || width < best.width)) || (best.width < wanted && width > best.width)
            if better { best = Pixmap.{ .at = at, .width = width, .height = height } }
        }
    }
    reading.*.position = end
    return best
}

// The pixmap (ARGB32 in network order) scaled into the item's icon
// (premultiplied): each pixel the mean of the source pixels it covers.
fn takePixmap(item: *Item, bytes: [*]const u8, pixmap: Pixmap) -> void {
    const pixels = state.itemPixels(item)
    const size = @intCast(i32, state.ICON)
    var y: i32 = 0
    while y < size {
        var x: i32 = 0
        while x < size {
            const from_x = x * pixmap.width / size
            var to_x = (x + 1) * pixmap.width / size
            if to_x <= from_x { to_x = from_x + 1 }
            const from_y = y * pixmap.height / size
            var to_y = (y + 1) * pixmap.height / size
            if to_y <= from_y { to_y = from_y + 1 }
            var alpha: u32 = 0
            var red: u32 = 0
            var green: u32 = 0
            var blue: u32 = 0
            var count: u32 = 0
            var source_y = from_y
            while source_y < to_y {
                var source_x = from_x
                while source_x < to_x {
                    const at = pixmap.at + @intCast(usize, source_y * pixmap.width + source_x) * 4
                    const a = @intCast(u32, bytes[at])
                    alpha += a
                    red += @intCast(u32, bytes[at + 1]) * a / 255
                    green += @intCast(u32, bytes[at + 2]) * a / 255
                    blue += @intCast(u32, bytes[at + 3]) * a / 255
                    count += 1
                    source_x += 1
                }
                source_y += 1
            }
            pixels[@intCast(usize, y * size + x)] = ((alpha / count) << 24) | ((red / count) << 16) | ((green / count) << 8) | (blue / count)
            x += 1
        }
        y += 1
    }
    item.*.hasIcon = true
}

// A PNG scaled into the item's icon; false when `path` is none.
fn takeFile(bar: *Bar, item: *Item, path: *apps_module.Path) -> bool {
    var image: png.Image = undefined
    if png.loadFile(&image, apps_module.pathEnd(path), bar.*.allocator) != png.Status.ok { return false }
    var scaled: png.Image = undefined
    const status = png.scale(&scaled, &image, state.ICON, state.ICON, bar.*.allocator)
    png.deinit(&image)
    if status != png.Status.ok { return false }
    const pixels = state.itemPixels(item)
    var index: usize = 0
    while index < state.ICON * state.ICON {
        pixels[index] = scaled.pixels[index]
        index += 1
    }
    png.deinit(&scaled)
    item.*.hasIcon = true
    return true
}

fn sizeAt(index: usize) -> []const u8 {
    return match index { 0 => "22x22", 1 => "24x24", 2 => "32x32", 3 => "48x48", 4 => "16x16", 5 => "64x64", 6 => "128x128", else => "256x256" }
}

fn kindAt(index: usize) -> []const u8 {
    return match index { 0 => "status", 1 => "apps", 2 => "devices", else => "panel" }
}

// NAME.png under `base` (an icons directory): in the hicolor theme's
// sizes and kinds, or right there.
fn fromIcons(bar: *Bar, item: *Item, base: []const u8, name: []const u8) -> bool {
    var path: apps_module.Path = undefined
    var size: usize = 0
    while size < 8 {
        var kind: usize = 0
        while kind < 4 {
            apps_module.pathClear(&path)
            apps_module.pathAdd(&path, base)
            apps_module.pathAdd(&path, "/hicolor/")
            apps_module.pathAdd(&path, sizeAt(size))
            apps_module.pathAdd(&path, "/")
            apps_module.pathAdd(&path, kindAt(kind))
            apps_module.pathAdd(&path, "/")
            apps_module.pathAdd(&path, name)
            apps_module.pathAdd(&path, ".png")
            if takeFile(bar, item, &path) { return true }
            kind += 1
        }
        size += 1
    }
    apps_module.pathClear(&path)
    apps_module.pathAdd(&path, base)
    apps_module.pathAdd(&path, "/")
    apps_module.pathAdd(&path, name)
    apps_module.pathAdd(&path, ".png")
    return takeFile(bar, item, &path)
}

// IconName: an absolute path, else in the item's IconThemePath, the data
// directories' icons, /usr/share/pixmaps.
fn fromName(bar: *Bar, item: *Item, name: []const u8) -> bool {
    if name.length == 0 { return false }
    var path: apps_module.Path = undefined
    if name[0] == 47 {
        apps_module.pathClear(&path)
        apps_module.pathAdd(&path, name)
        return takeFile(bar, item, &path)
    }
    if item.*.themePath.length > 0 && fromIcons(bar, item, state.labelText(&item.*.themePath), name) { return true }
    var directory: usize = 0
    var base: apps_module.Path = undefined
    while apps_module.dataDirectory(state.appsOf(bar), directory, &base) {
        if base.length > 0 {
            apps_module.pathAdd(&base, "/icons")
            if fromIcons(bar, item, base.bytes[0..base.length], name) { return true }
        }
        directory += 1
    }
    apps_module.pathClear(&path)
    apps_module.pathAdd(&path, "/usr/share/pixmaps/")
    apps_module.pathAdd(&path, name)
    apps_module.pathAdd(&path, ".png")
    return takeFile(bar, item, &path)
}

fn apply(bar: *Bar, index: usize, reading: *dbus.Reader) -> void {
    const item = state.itemAt(bar, index)
    var icon = Pixmap.{ .at = 0, .width = 0, .height = 0 }
    var attention = Pixmap.{ .at = 0, .width = 0, .height = 0 }
    var icon_name: state.Label = undefined
    icon_name.length = 0
    var attention_name: state.Label = undefined
    attention_name.length = 0
    const end = bus.arrayEnd(reading, 8)
    while reading.*.position < end && !reading.*.failed {
        dbus.alignTo(reading, 8)
        const key = dbus.readString(reading)
        const signature = dbus.readSignature(reading)
        if state.same(key, "Id") {
            state.labelSet(&item.*.id, bus.valueString(reading, signature))
        } else if state.same(key, "Title") {
            state.labelSet(&item.*.title, bus.valueString(reading, signature))
        } else if state.same(key, "Status") {
            const status = bus.valueString(reading, signature)
            item.*.status = if state.same(status, "Passive") { state.ITEM_PASSIVE } else if state.same(status, "NeedsAttention") { state.ITEM_ATTENTION } else { state.ITEM_ACTIVE }
        } else if state.same(key, "IconName") {
            state.labelSet(&icon_name, bus.valueString(reading, signature))
        } else if state.same(key, "AttentionIconName") {
            state.labelSet(&attention_name, bus.valueString(reading, signature))
        } else if state.same(key, "IconThemePath") {
            state.labelSet(&item.*.themePath, bus.valueString(reading, signature))
        } else if state.same(key, "Menu") {
            state.labelSet(&item.*.menu, bus.valueString(reading, signature))
        } else if state.same(key, "ItemIsMenu") {
            item.*.itemIsMenu = bus.valueBool(reading, signature)
        } else if state.same(key, "IconPixmap") {
            icon = pixmaps(reading, signature)
        } else if state.same(key, "AttentionIconPixmap") {
            attention = pixmaps(reading, signature)
        } else {
            const skipped = dbus.skipValue(reading, signature, 0, 0)
        }
    }
    if reading.*.failed { return }
    // "/NO_DBUSMENU" (Ayatana) says there is none.
    if state.same(state.labelText(&item.*.menu), "/NO_DBUSMENU") || state.same(state.labelText(&item.*.menu), "/") { item.*.menu.length = 0 }
    item.*.hasIcon = false
    const needs = item.*.status == state.ITEM_ATTENTION
    if needs && attention.width > 0 {
        takePixmap(item, reading.*.bytes, attention)
    } else if needs && fromName(bar, item, state.labelText(&attention_name)) {
    } else if icon.width > 0 {
        takePixmap(item, reading.*.bytes, icon)
    } else {
        const found = fromName(bar, item, state.labelText(&icon_name))
    }
    state.labelSet(&item.*.iconName, state.labelText(&icon_name))
    panel_module.forgetImages(state.panelOf(bar))
    state.say(bar, "topbar: tray item ")
    state.say(bar, state.labelText(&item.*.service))
    state.say(bar, if item.*.hasIcon { " has an icon" } else { " has no icon" })
    state.say(bar, if item.*.status == state.ITEM_PASSIVE { ", passive" } else { "" })
    state.say(bar, if item.*.menu.length > 0 { ", a menu\n" } else { "\n" })
    state.barChanged(bar)
}

// ---------------------------------------------------------------------------
// On the bar

fn shownCount(bar: *Bar) -> i32 {
    var count: i32 = 0
    var index: usize = 0
    while index < state.MAX_ITEMS {
        const item = state.itemAt(bar, index)
        if item.*.used && item.*.status != state.ITEM_PASSIVE { count += 1 }
        index += 1
    }
    return count
}

pub fn widgetWidth(bar: *Bar) -> i32 { return shownCount(bar) * SLOT }

// The item at `x` (the widget at `left`), NONE between them.
pub fn itemUnder(bar: *Bar, x: i32, left: i32) -> usize {
    var slot_left = left
    var index: usize = 0
    while index < state.MAX_ITEMS {
        const item = state.itemAt(bar, index)
        if item.*.used && item.*.status != state.ITEM_PASSIVE {
            if x >= slot_left && x < slot_left + SLOT { return index }
            slot_left += SLOT
        }
        index += 1
    }
    return state.NONE
}

fn slotLeft(bar: *Bar, wanted: usize, left: i32) -> i32 {
    var slot_left = left
    var index: usize = 0
    while index < wanted {
        const item = state.itemAt(bar, index)
        if item.*.used && item.*.status != state.ITEM_PASSIVE { slot_left += SLOT }
        index += 1
    }
    return slot_left
}

pub fn drawWidget(bar: *Bar, canvas: *Canvas, left: i32) -> void {
    const size = @intCast(i32, state.ICON)
    const top = (state.HEIGHT - size) / 2
    var slot_left = left
    var index: usize = 0
    while index < state.MAX_ITEMS {
        const item = state.itemAt(bar, index)
        if item.*.used && item.*.status != state.ITEM_PASSIVE {
            const x = slot_left + (SLOT - size) / 2
            if (bar.*.hoverWidget == state.WIDGET_TRAY && bar.*.hoverItem == index) || (bar.*.popup == state.POPUP_TRAY && bar.*.menuItem == index) {
                canvas_module.fillRoundedRect(canvas, slot_left, (state.HEIGHT - SLOT + 2) / 2, SLOT, SLOT - 2, 6, canvas_module.color(40, 255, 255, 255))
            }
            if item.*.hasIcon {
                const image = png.Image.{ .pixels = state.itemPixels(item), .width = state.ICON, .height = state.ICON, .allocator = bar.*.allocator }
                canvas_module.drawImage(canvas, &image, x, top, size, 255)
            } else {
                // The first letter of its title (or id) on a tile.
                const name = if item.*.title.length > 0 { state.labelText(&item.*.title) } else { state.labelText(&item.*.id) }
                canvas_module.fillRoundedRect(canvas, x + 1, top + 1, size - 2, size - 2, 5, apps_module.tileColor(name))
                if name.length > 0 {
                    var letter: [1]u8 = [1]u8{ name[0] }
                    if letter[0] >= 97 && letter[0] <= 122 { letter[0] -= 32 }
                    var bytes: [*]const u8 = undefined
                    unsafe { bytes = @ptrCast([*]const u8, &letter) }
                    const width = text_module.measure(state.boldOf(bar), bytes[0..1])
                    text_module.drawText(canvas, state.boldOf(bar), bytes[0..1], x + (size - width) / 2, top + 1, state.TEXT_COLOR, 0)
                }
            }
            if item.*.status == state.ITEM_ATTENTION { canvas_module.fillRoundedRect(canvas, x + size - 5, top - 1, 6, 6, 3, canvas_module.color(255, 255, 90, 80)) }
            slot_left += SLOT
        }
        index += 1
    }
}

// A button pressed on item `index` (left: the widget's left).
pub fn press(bar: *Bar, index: usize, button: u32, left: i32) -> void {
    if index >= state.MAX_ITEMS { return }
    const item = state.itemAt(bar, index)
    if !item.*.used { return }
    const x = slotLeft(bar, index, left) + SLOT / 2
    const wants_menu = button == 273 || (button == 272 && item.*.itemIsMenu)
    if wants_menu && item.*.menu.length > 0 {
        askMenu(bar, index)
        return
    }
    var member: []const u8 = "Activate"
    if button == 274 { member = "SecondaryActivate" }
    if wants_menu { member = "ContextMenu" }
    var body: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 16, false)
    dbus.putU32(&writing, @bitCast(u32, x))
    dbus.putU32(&writing, @bitCast(u32, state.HEIGHT))
    bus.call(bar, state.labelText(&item.*.bus), state.labelText(&item.*.path), ITEM, member, "ii", bytes, writing.length, bus.PURPOSE_IGNORE, 0)
    state.say(bar, "topbar: ")
    state.say(bar, member)
    state.say(bar, " to ")
    state.say(bar, state.labelText(&item.*.service))
    state.say(bar, "\n")
}

// ---------------------------------------------------------------------------
// The menu (com.canonical.dbusmenu)

fn askMenu(bar: *Bar, index: usize) -> void {
    const item = state.itemAt(bar, index)
    var body: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    // AboutToShow(0): some fill their menu only then.
    dbus.begin(&writing, bytes, 64, false)
    dbus.putU32(&writing, 0)
    bus.call(bar, state.labelText(&item.*.bus), state.labelText(&item.*.menu), MENU, "AboutToShow", "i", bytes, writing.length, bus.PURPOSE_IGNORE, 0)
    // GetLayout(0, -1, []): the whole tree.
    dbus.begin(&writing, bytes, 64, false)
    dbus.putU32(&writing, 0)
    dbus.putU32(&writing, 4294967295)
    dbus.putU32(&writing, 0)
    bus.call(bar, state.labelText(&item.*.bus), state.labelText(&item.*.menu), MENU, "GetLayout", "iias", bytes, writing.length, bus.PURPOSE_MENU_LAYOUT, slotOf(index))
}

// "_File" is "File" (the underscore marks the access key; "__" is one).
fn labelOf(text: []const u8, out: *state.Label) -> void {
    out.*.length = 0
    var index: usize = 0
    while index < text.length && out.*.length < 255 {
        if text[index] == 95 && index + 1 < text.length && text[index + 1] != 95 {
            index += 1
        } else {
            if text[index] == 95 { index += 1 }
            out.*.bytes[out.*.length] = text[index]
            out.*.length += 1
            index += 1
        }
    }
}

// One entry (ia{sv}av) of the layout into the menu; its children (a
// submenu) after it, indented, `depth` deep.
fn entry(bar: *Bar, reading: *dbus.Reader, depth: usize) -> void {
    const menu = state.menuOf(bar)
    dbus.alignTo(reading, 8)
    const id = dbus.readU32(reading)
    var label: state.Label = undefined
    label.length = 0
    var enabled = true
    var visible = true
    var separator = false
    var toggled = false
    var toggle = false
    const end = bus.arrayEnd(reading, 8)
    while reading.*.position < end && !reading.*.failed {
        dbus.alignTo(reading, 8)
        const key = dbus.readString(reading)
        const signature = dbus.readSignature(reading)
        if state.same(key, "label") {
            labelOf(bus.valueString(reading, signature), &label)
        } else if state.same(key, "enabled") {
            enabled = bus.valueBool(reading, signature)
        } else if state.same(key, "visible") {
            visible = bus.valueBool(reading, signature)
        } else if state.same(key, "type") {
            separator = state.same(bus.valueString(reading, signature), "separator")
        } else if state.same(key, "toggle-type") {
            toggle = bus.valueString(reading, signature).length > 0
        } else if state.same(key, "toggle-state") {
            toggled = bus.valueNumber(reading, signature) == 1
        } else {
            const skipped = dbus.skipValue(reading, signature, 0, 0)
        }
    }
    reading.*.position = end
    if depth > 0 && visible {
        if separator {
            menu_module.separator(menu)
        } else if label.length > 0 {
            var text: state.Label = undefined
            text.length = 0
            var indent: usize = 1
            while indent < depth {
                state.labelAdd(&text, "    ")
                indent += 1
            }
            if toggle { state.labelAdd(&text, if toggled { "• " } else { "   " }) }
            state.labelAdd(&text, state.labelText(&label))
            menu_module.add(menu, state.labelText(&text), if enabled { 1 } else { 0 }, @intCast(usize, id))
            if !enabled { menu_module.dim(menu) }
        }
    }
    // The children: variants of (ia{sv}av).
    const children_end = bus.arrayEnd(reading, 1)
    while reading.*.position < children_end && !reading.*.failed {
        const signature = dbus.readSignature(reading)
        if !state.same(signature, "(ia{sv}av)") {
            const skipped = dbus.skipValue(reading, signature, 0, 0)
        } else if depth < 3 && visible {
            entry(bar, reading, depth + 1)
        } else {
            const skipped = dbus.skipValue(reading, signature, 0, 0)
        }
    }
    reading.*.position = children_end
}

fn layout(bar: *Bar, index: usize, reading: *dbus.Reader) -> void {
    const menu = state.menuOf(bar)
    menu_module.clear(menu)
    const revision = dbus.readU32(reading)
    entry(bar, reading, 0)
    if reading.*.failed || menu.*.count == 0 { return }
    bar.*.menuItem = index
    const left = slotLeft(bar, index, bar.*.widgetLeft[state.WIDGET_TRAY])
    popup.open(bar, state.POPUP_TRAY, left + SLOT / 2, @intCast(i32, menu_module.width(menu, state.textOf(bar))), @intCast(i32, menu_module.height(menu)))
    state.say(bar, "topbar: menu of ")
    state.say(bar, state.labelText(&state.itemAt(bar, index).*.service))
    state.say(bar, " with ")
    state.sayNumber(bar, @intCast(i64, menu.*.count))
    state.say(bar, " entries\n")
}

pub fn drawMenu(bar: *Bar, canvas: *Canvas) -> void { menu_module.draw(state.menuOf(bar), canvas, state.textOf(bar)) }

pub fn menuMotion(bar: *Bar, y: i32) -> void {
    if menu_module.hover(state.menuOf(bar), y) { state.popupChanged(bar) }
}

// A click on an entry: Event(id, "clicked", 0, time).
pub fn menuClick(bar: *Bar) -> void {
    const menu = state.menuOf(bar)
    const chosen = menu.*.hover
    if chosen == menu_module.NONE || chosen >= menu.*.count || menu_module.kindAt(menu, chosen) == 0 { return }
    if bar.*.menuItem >= state.MAX_ITEMS { return }
    const item = state.itemAt(bar, bar.*.menuItem)
    if !item.*.used { return }
    var body: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 64, false)
    dbus.putU32(&writing, @intCast(u32, menu_module.valueAt(menu, chosen)))
    dbus.putString(&writing, "clicked")
    dbus.putSignature(&writing, "i")
    dbus.putU32(&writing, 0)
    dbus.putU32(&writing, @intCast(u32, state.milliseconds() & 4294967295))
    bus.call(bar, state.labelText(&item.*.bus), state.labelText(&item.*.menu), MENU, "Event", "isvu", bytes, writing.length, bus.PURPOSE_IGNORE, 0)
    state.say(bar, "topbar: clicked entry ")
    state.sayNumber(bar, @intCast(i64, menu_module.valueAt(menu, chosen)))
    state.say(bar, " of ")
    state.say(bar, state.labelText(&item.*.service))
    state.say(bar, "\n")
    popup.close(bar)
}
