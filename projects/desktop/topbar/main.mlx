// The top bar of the Mlx desktop, like the menu bar of macOS: a Wayland
// client in the compositor's top layer, along the top edge of the screen,
// keeping that strip free of windows (maximized ones start below it). On
// the left the name of the app whose window is active; in the middle the
// workspaces in use as numbered buttons (a click switches) and a two-part
// button that says whether the current workspace floats its windows or
// tiles them as scrolling columns (a click on the other part switches);
// the lit button and the lit part glide to where they go; the wheel over
// the bar goes to the workspace before or after;
// on the right the date and the time in the local time zone
// (desktop-shared/clock.mlx). The bar is translucent and asks the
// compositor to blur what is behind.
//
//   mlx-topbar
//
// Started by the compositor to stay (MLX_TOPBAR_FD: the end of that
// channel is the compositor going, which ends the bar too; on it the
// compositor sends the workspaces, the bar its clicks: see the
// compositor's workspaces.mlx). MLX_TOPBAR_TIME (seconds since 1970)
// fixes the time, for tests.
const std = @import("std")
const apps_module = @import("../shared/apps.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")
const clock = @import("../shared/clock.mlx")
const timezone = @import("std.timezone")
const crash = @import("std.crash")

const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Panel = panel_module.Panel

pub const HEIGHT: i32 = 30
const PADDING: i32 = 16
const TEXT_COLOR: u32 = 4294967295
// The workspace controls in the middle: a button per workspace, a gap,
// then the two parts of the floating/tiling button.
const WORKSPACES: usize = 9
const BUTTON_WIDTH: i32 = 24
const BUTTON_HEIGHT: i32 = 20
const BUTTON_GAP: i32 = 4
const MODE_GAP: i32 = 10
const MODE_WIDTH: i32 = 28
// The messages on the channel (the compositor's workspaces.mlx).
const MESSAGE_STATE: u8 = 87
const MESSAGE_SWITCH: u8 = 119
const MESSAGE_TILING: u8 = 116
// The lit button glides over ANIMATION milliseconds (ticks every TICK
// while it does); the wheel switches once per notch (WHEEL_NOTCH pixels)
// and at most once per WHEEL_COOLDOWN milliseconds.
const ANIMATION: usize = 220
const TICK: usize = 16
const CLOCK_TICK: usize = 1000
const WHEEL_NOTCH: i32 = 10
const WHEEL_COOLDOWN: usize = 150

const Bar = struct {
    panel: Panel
    apps: apps_module.Apps
    zone: timezone.Zone
    environment: [*][*]const u8
    german: bool
    // The time shown ("So. 27. Sep.  16:05") and the minute it is for.
    time: [48]u8
    timeLength: usize
    minute: i64
    // A fixed time (MLX_TOPBAR_TIME), else 0.
    fixedTime: i64
    // The compositor's channel (MLX_TOPBAR_FD), else -1.
    channel: isize
    // The workspaces as the compositor last said: the current one (from
    // 0), which ones tile (a bit each) and how many windows each has.
    current: usize
    tilingMask: u32
    counts: [WORKSPACES]u8
    // Where the pointer is on the bar (for clicks).
    pointerX: i32
    // The lit workspace button glides from litFrom (x on the bar) since
    // litStart, the lit part of the mode button from modeFrom (0: the
    // floating part, MODE_WIDTH: the tiling part) since modeStart
    // (milliseconds; 0: they stand).
    litFrom: i32
    litStart: usize
    modeFrom: i32
    modeStart: usize
    // The wheel's travel not yet a switch, and when it last switched.
    wheelTravel: i32
    wheelAt: usize
    text: Text
    bold: Text
}

fn barOf(context: *anyopaque) -> *Bar {
    unsafe { return @ptrCast(*Bar, context) }
}

fn panelOf(bar: *Bar) -> *Panel {
    unsafe { return @ptrCast(*Panel, &bar.*.panel) }
}

fn appsOf(bar: *Bar) -> *apps_module.Apps {
    unsafe { return @ptrCast(*apps_module.Apps, &bar.*.apps) }
}

fn zoneOf(bar: *Bar) -> *timezone.Zone {
    unsafe { return @ptrCast(*timezone.Zone, &bar.*.zone) }
}

fn textOf(bar: *Bar) -> *Text {
    unsafe { return @ptrCast(*Text, &bar.*.text) }
}

fn boldOf(bar: *Bar) -> *Text {
    unsafe { return @ptrCast(*Text, &bar.*.bold) }
}

fn timeOf(bar: *Bar) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(bar) + @offsetOf(Bar, "time")) }
    return bytes[0..bar.*.timeLength]
}

// The time again when the minute changed; true when it did.
fn updateTime(bar: *Bar) -> bool {
    const utc = if bar.*.fixedTime != 0 { bar.*.fixedTime } else { timezone.now() }
    const local = utc + timezone.offsetAt(zoneOf(bar), utc)
    const minute = local / 60
    if minute == bar.*.minute { return false }
    bar.*.minute = minute
    const time = timezone.civil(local)
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrFromInt([*]u8, @intFromPtr(bar) + @offsetOf(Bar, "time")) }
    bar.*.timeLength = clock.format(&time, bar.*.german, bytes)
    return true
}

// What the left shows: the active window's app (its desktop entry's name,
// else its app id, else its title), or the desktop's name when no window
// is active.
fn activeName(bar: *Bar) -> []const u8 {
    const panel = panelOf(bar)
    var index: usize = 0
    while index < panel.*.windowCount {
        const window = panel_module.windowAt(panel, index)
        if window.*.live && window.*.activated {
            const app_id = panel_module.appIdOf(window)
            const apps = appsOf(bar)
            if app_id.length > 0 {
                const app = apps_module.find(apps, app_id)
                if app < apps.*.count { return apps_module.nameOf(apps_module.appAt(apps, app)) }
                if apps_module.sameText(app_id, "org.mlx.terminal") { return "Terminal" }
                return app_id
            }
            var title: [*]const u8 = undefined
            unsafe { title = @ptrFromInt([*]const u8, @intFromPtr(window) + @offsetOf(panel_module.Window, "title")) }
            return title[0..window.*.titleLength]
        }
        index += 1
    }
    return "Mlx"
}

// How many workspace buttons show: the ones up to the last with windows,
// the current one, and one more to go to.
fn shownWorkspaces(bar: *Bar) -> usize {
    var last = bar.*.current
    var index: usize = 0
    while index < WORKSPACES {
        if bar.*.counts[index] > 0 && index > last { last = index }
        index += 1
    }
    var shown = last + 2
    if shown > WORKSPACES { shown = WORKSPACES }
    return shown
}

// The controls' whole width, and where they start (centred on the bar).
fn controlsWidth(bar: *Bar) -> i32 {
    const count = @intCast(i32, shownWorkspaces(bar))
    return count * BUTTON_WIDTH + (count - 1) * BUTTON_GAP + MODE_GAP + 2 * MODE_WIDTH
}

fn controlsLeft(bar: *Bar, width: i32) -> i32 { return (width - controlsWidth(bar)) / 2 }

fn buttonLeft(bar: *Bar, width: i32, index: usize) -> i32 {
    return controlsLeft(bar, width) + @intCast(i32, index) * (BUTTON_WIDTH + BUTTON_GAP)
}

fn modeLeft(bar: *Bar, width: i32) -> i32 {
    const count = @intCast(i32, shownWorkspaces(bar))
    return controlsLeft(bar, width) + count * BUTTON_WIDTH + (count - 1) * BUTTON_GAP + MODE_GAP
}

fn tiles(bar: *Bar) -> bool { return (bar.*.tilingMask >> @intCast(u5, bar.*.current)) & 1 != 0 }

// 0 to 1024 of an animation that started at `start`, easing out.
fn progress(start: usize) -> i32 {
    if start == 0 { return 1024 }
    const elapsed = panel_module.milliseconds() - start
    if elapsed >= ANIMATION { return 1024 }
    const left = 1024 - @intCast(i64, elapsed * 1024 / ANIMATION)
    return @intCast(i32, 1024 - left * left / 1024 * left / 1024)
}

fn between(from: i32, to: i32, t: i32) -> i32 { return from + (to - from) * t / 1024 }

// Where the lit workspace button is drawn now, and the lit part of the
// mode button (from the mode button's left).
fn litLeft(bar: *Bar, width: i32) -> i32 { return between(bar.*.litFrom, buttonLeft(bar, width, bar.*.current), progress(bar.*.litStart)) }

fn modeOffset(bar: *Bar) -> i32 { return between(bar.*.modeFrom, if tiles(bar) { MODE_WIDTH } else { 0 }, progress(bar.*.modeStart)) }

// Whether something still glides: then the bar ticks often and draws
// again on each tick.
fn animating(bar: *Bar) -> bool { return progress(bar.*.litStart) < 1024 || progress(bar.*.modeStart) < 1024 }

fn tickFor(bar: *Bar) -> void {
    const panel = panelOf(bar)
    const wanted = if animating(bar) { TICK } else { CLOCK_TICK }
    if panel.*.tickInterval == wanted { return }
    panel.*.tickInterval = wanted
    panel.*.nextTick = 0
}

// The workspace buttons and the floating/tiling button.
fn drawControls(bar: *Bar, canvas: *Canvas, width: i32) -> void {
    const top = (HEIGHT - BUTTON_HEIGHT) / 2
    const dim = canvas_module.color(60, 255, 255, 255)
    const lit = canvas_module.color(230, 255, 255, 255)
    const dark = canvas_module.color(255, 30, 32, 40)
    const count = shownWorkspaces(bar)
    var index: usize = 0
    while index < count {
        canvas_module.fillRoundedRect(canvas, buttonLeft(bar, width, index), top, BUTTON_WIDTH, BUTTON_HEIGHT, 5, dim)
        index += 1
    }
    // The lit button, where it glides; a digit it covers most of is dark.
    const lit_left = litLeft(bar, width)
    canvas_module.fillRoundedRect(canvas, lit_left, top, BUTTON_WIDTH, BUTTON_HEIGHT, 5, lit)
    index = 0
    while index < count {
        const left = buttonLeft(bar, width, index)
        const distance = if lit_left > left { lit_left - left } else { left - lit_left }
        const current = distance < BUTTON_WIDTH / 2
        var digit: [1]u8 = [1]u8{ @intCast(u8, 49 + index) }
        var digit_bytes: [*]const u8 = undefined
        unsafe { digit_bytes = @ptrCast([*]const u8, &digit) }
        const label = digit_bytes[0..1]
        const label_width = text_module.measure(textOf(bar), label)
        text_module.drawText(canvas, textOf(bar), label, left + (BUTTON_WIDTH - label_width) / 2, (HEIGHT - 16) / 2, if current { dark } else { TEXT_COLOR }, 0)
        // A dot under a workspace with windows.
        if bar.*.counts[index] > 0 && !current { canvas_module.fillRoundedRect(canvas, left + BUTTON_WIDTH / 2 - 2, top + BUTTON_HEIGHT - 5, 4, 4, 2, TEXT_COLOR) }
        index += 1
    }
    // The two parts: floating (two windows, one over the other), tiling
    // (two columns side by side); the one in force is lit.
    const mode = modeLeft(bar, width)
    const offset = modeOffset(bar)
    const tiling = offset >= MODE_WIDTH / 2
    canvas_module.fillRoundedRect(canvas, mode, top, 2 * MODE_WIDTH, BUTTON_HEIGHT, 5, dim)
    canvas_module.fillRoundedRect(canvas, mode + offset, top, MODE_WIDTH, BUTTON_HEIGHT, 5, lit)
    const floating_ink = if tiling { TEXT_COLOR } else { dark }
    const tiling_ink = if tiling { dark } else { TEXT_COLOR }
    canvas_module.fillRect(canvas, mode + 7, top + 5, 9, 7, floating_ink)
    canvas_module.fillRect(canvas, mode + 12, top + 9, 9, 7, floating_ink)
    canvas_module.fillRect(canvas, mode + 13, top + 10, 7, 5, if tiling { dim } else { lit })
    canvas_module.fillRect(canvas, mode + MODE_WIDTH + 7, top + 5, 6, 11, tiling_ink)
    canvas_module.fillRect(canvas, mode + MODE_WIDTH + 15, top + 5, 6, 11, tiling_ink)
}

// Sends the compositor a message (MSG_DONTWAIT | MSG_NOSIGNAL).
fn send(bar: *Bar, bytes: [*]const u8, length: usize) -> void {
    if bar.*.channel < 0 { return }
    const sent = std.linux.syscall6(44, @bitCast(usize, bar.*.channel), @intFromPtr(bytes), length, 64 | 16384, 0, 0)
}

// A click at `x` on the bar: a workspace button switches, the other part
// of the mode button turns tiling on or off; true when it hit one.
fn click(bar: *Bar, x: i32, width: i32) -> bool {
    const count = shownWorkspaces(bar)
    var index: usize = 0
    while index < count {
        const left = buttonLeft(bar, width, index)
        if x >= left && x < left + BUTTON_WIDTH {
            var message: [2]u8 = [2]u8{ MESSAGE_SWITCH, @intCast(u8, index) }
            unsafe { send(bar, @ptrCast([*]const u8, &message), 2) }
            return true
        }
        index += 1
    }
    const mode = modeLeft(bar, width)
    if x >= mode && x < mode + 2 * MODE_WIDTH {
        const wants_tiling = x >= mode + MODE_WIDTH
        if wants_tiling != tiles(bar) {
            var message: [3]u8 = [3]u8{ MESSAGE_TILING, @intCast(u8, bar.*.current), if wants_tiling { 1 } else { 0 } }
            unsafe { send(bar, @ptrCast([*]const u8, &message), 3) }
        }
        return true
    }
    return false
}

// The wheel over the bar: a notch down (or right) goes to the next
// workspace, up (or left) to the one before.
fn wheel(bar: *Bar, pixels: i32) -> void {
    if (bar.*.wheelTravel > 0 && pixels < 0) || (bar.*.wheelTravel < 0 && pixels > 0) { bar.*.wheelTravel = 0 }
    bar.*.wheelTravel += pixels
    if bar.*.wheelTravel < WHEEL_NOTCH && bar.*.wheelTravel > 0 - WHEEL_NOTCH { return }
    const forward = bar.*.wheelTravel > 0
    bar.*.wheelTravel = 0
    const now = panel_module.milliseconds()
    if bar.*.wheelAt != 0 && now - bar.*.wheelAt < WHEEL_COOLDOWN { return }
    if forward && bar.*.current + 1 >= WORKSPACES { return }
    if !forward && bar.*.current == 0 { return }
    bar.*.wheelAt = now
    const target = if forward { bar.*.current + 1 } else { bar.*.current - 1 }
    var message: [2]u8 = [2]u8{ MESSAGE_SWITCH, @intCast(u8, target) }
    unsafe { send(bar, @ptrCast([*]const u8, &message), 2) }
}

// A small mark at the left (where macOS has its apple): a ring and a dot.
fn drawMark(canvas: *Canvas, x: i32, y: i32, size: i32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, size, size, size / 2, TEXT_COLOR)
    canvas_module.fillRoundedRect(canvas, x + 2, y + 2, size - 4, size - 4, (size - 4) / 2, canvas_module.color(255, 40, 44, 54))
    canvas_module.fillRoundedRect(canvas, x + size / 2 - 3, y + size / 2 - 3, 6, 6, 3, TEXT_COLOR)
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const bar = barOf(context)
    const width = @intCast(i32, canvas.*.width)
    canvas_module.clear(canvas, canvas_module.color(170, 22, 24, 30))
    canvas_module.fillRect(canvas, 0, HEIGHT - 1, width, 1, canvas_module.color(40, 255, 255, 255))
    const mark = 16
    drawMark(canvas, PADDING, (HEIGHT - mark) / 2, mark)
    text_module.drawText(canvas, boldOf(bar), activeName(bar), PADDING + mark + 14, (HEIGHT - 17) / 2, TEXT_COLOR, controlsLeft(bar, width) - PADDING - mark - 24)
    drawControls(bar, canvas, width)
    const time = timeOf(bar)
    const time_width = text_module.measure(textOf(bar), time)
    text_module.drawText(canvas, textOf(bar), time, width - PADDING - time_width, (HEIGHT - 16) / 2, TEXT_COLOR, 0)
}

// What the compositor sent on the channel: the workspaces (MESSAGE_STATE,
// the current one, the tiling mask in two bytes, nine window counts); its
// end going ends us.
fn listen(bar: *Bar) -> void {
    var bytes: [128]u8 = undefined
    const count = std.linux.syscall3(0, @bitCast(usize, bar.*.channel), @intFromPtr(&bytes), 128)
    if count == 0 {
        panelOf(bar).*.running = false
        return
    }
    if count < 0 { return }
    const length = @intCast(usize, count)
    var index: usize = 0
    while index < length {
        if bytes[index] == MESSAGE_STATE && index + 4 + WORKSPACES <= length {
            // The lit button and part glide from where they are drawn.
            const width = @intCast(i32, panelOf(bar).*.width)
            const lit_was = litLeft(bar, width)
            const mode_was = modeOffset(bar)
            const tiled_before = tiles(bar)
            const current_before = bar.*.current
            bar.*.current = @intCast(usize, bytes[index + 1])
            if bar.*.current >= WORKSPACES { bar.*.current = 0 }
            bar.*.tilingMask = @intCast(u32, bytes[index + 2]) | (@intCast(u32, bytes[index + 3]) << 8)
            if bar.*.current != current_before && width > 0 {
                bar.*.litFrom = lit_was
                bar.*.litStart = panel_module.milliseconds()
            }
            if tiles(bar) != tiled_before {
                bar.*.modeFrom = mode_was
                bar.*.modeStart = panel_module.milliseconds()
            }
            var workspace: usize = 0
            while workspace < WORKSPACES {
                bar.*.counts[workspace] = bytes[index + 4 + workspace]
                workspace += 1
            }
            panelOf(bar).*.dirty = true
            tickFor(bar)
            index += 4 + WORKSPACES
        } else {
            index += 1
        }
    }
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const bar = barOf(context)
    const panel = panelOf(bar)
    if kind == panel_module.EVENT_CONFIGURED {
        // Blur behind the whole bar.
        var rects: [4]i32 = [4]i32{ 0, 0, @intCast(i32, panel.*.width), HEIGHT }
        unsafe { panel_module.setBlur(panel, @ptrCast([*]const i32, &rects), 1) }
    } else if kind == panel_module.EVENT_TICK {
        const gliding = bar.*.litStart != 0 || bar.*.modeStart != 0
        if !animating(bar) {
            bar.*.litStart = 0
            bar.*.modeStart = 0
        }
        tickFor(bar)
        if !updateTime(bar) && !gliding { return }
    } else if kind == panel_module.EVENT_WHEEL {
        wheel(bar, panel.*.wheelPixels)
        return
    } else if kind == panel_module.EVENT_WATCH {
        listen(bar)
        return
    } else if kind == panel_module.EVENT_MOTION {
        bar.*.pointerX = @bitCast(i32, a)
        return
    } else if kind == panel_module.EVENT_BUTTON {
        if a == 272 && b == 1 { const hit = click(bar, bar.*.pointerX, @intCast(i32, panel.*.width)) }
        return
    } else if kind != panel_module.EVENT_WINDOWS {
        return
    }
    panel.*.dirty = true
}

fn numberFrom(text: [*]const u8) -> i64 {
    var value: i64 = 0
    var index: usize = 0
    while text[index] >= 48 && text[index] <= 57 {
        value = value * 10 + @intCast(i64, text[index] - 48)
        index += 1
    }
    return value
}

const Failure = error { NoMemory }

fn noMemory() -> Failure!void { return Failure.NoMemory }

pub fn main(arguments: [][*]const u8) -> !void {
    crash.install()
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Bar), 16)
    if memory == null { return noMemory() }
    var bar: *Bar = undefined
    unsafe { bar = @ptrCast(*Bar, memory.?) }
    bar.*.environment = environment
    bar.*.german = clock.germanLocale(environment)
    bar.*.minute = -1
    bar.*.timeLength = 0
    timezone.load(zoneOf(bar), environment, allocator)
    const fixed = apps_module.environmentValue(environment, "MLX_TOPBAR_TIME")
    bar.*.fixedTime = if @intFromPtr(fixed) != 0 { numberFrom(fixed) } else { 0 }
    const updated = updateTime(bar)
    const channel = apps_module.environmentValue(environment, "MLX_TOPBAR_FD")
    bar.*.channel = if @intFromPtr(channel) != 0 && channel[0] >= 48 && channel[0] <= 57 { @intCast(isize, numberFrom(channel)) } else { -1 }
    bar.*.current = 0
    bar.*.tilingMask = 0
    var workspace: usize = 0
    while workspace < WORKSPACES {
        bar.*.counts[workspace] = 0
        workspace += 1
    }
    bar.*.pointerX = 0
    bar.*.litFrom = 0
    bar.*.litStart = 0
    bar.*.modeFrom = 0
    bar.*.modeStart = 0
    bar.*.wheelTravel = 0
    bar.*.wheelAt = 0
    if !apps_module.init(appsOf(bar), environment, allocator) { return noMemory() }
    apps_module.scan(appsOf(bar))
    const loaded_text = text_module.loadText(textOf(bar), 14, allocator)
    const loaded_bold = text_module.loadText(boldOf(bar), 15, allocator)

    const panel = panelOf(bar)
    panel.*.context = @ptrCast(*anyopaque, bar)
    panel.*.draw = draw
    panel.*.event = onEvent
    const anchor = panel_module.ANCHOR_TOP | panel_module.ANCHOR_LEFT | panel_module.ANCHOR_RIGHT
    try panel_module.open(panel, allocator, arguments, "mlx-topbar", panel_module.LAYER_TOP, anchor, 0, @intCast(u32, HEIGHT), HEIGHT, 0, panel_module.KEYBOARD_NONE, true)
    panel_module.report(panel, "mlx-topbar")
    // The clock is looked at every second (it changes once a minute).
    panel.*.tickInterval = CLOCK_TICK
    panel.*.watch = bar.*.channel
    try panel_module.run(panel)
    panel_module.close(panel)
}
