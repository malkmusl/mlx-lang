// The calendar under the clock (a click on the time): today's date, the
// month with its ISO week numbers, today lit; the arrows (and the wheel)
// go to the month before or after, a click on the month's name back to
// today's. Weeks start on Monday; the names are German or English as the
// clock's.
const state = @import("./state.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const timezone = @import("std.timezone")

const Bar = state.Bar
const Canvas = state.Canvas

const PADDING: i32 = 16
const CELL: i32 = 32
const ROW: i32 = 30
// Where the lines are: today, the month and its arrows, the weekdays,
// the days.
const TODAY: i32 = 14
const MONTH: i32 = 48
const WEEKDAYS: i32 = 82
const GRID: i32 = 104
const ARROW: i32 = 26
pub const WIDTH: i32 = 2 * PADDING + 8 * CELL
pub const HEIGHT: i32 = GRID + 6 * ROW + 12

// What the pointer is over (popupHover): the arrows, the month's name, a
// day (DAY + its cell).
pub const HIT_PREVIOUS: usize = 1
pub const HIT_NEXT: usize = 2
pub const HIT_MONTH: usize = 3
pub const HIT_DAY: usize = 100

fn monthName(month: i64, german: bool) -> []const u8 {
    if german {
        return match month { 1 => "Januar", 2 => "Februar", 3 => "März", 4 => "April", 5 => "Mai", 6 => "Juni", 7 => "Juli", 8 => "August", 9 => "September", 10 => "Oktober", 11 => "November", else => "Dezember" }
    }
    return match month { 1 => "January", 2 => "February", 3 => "March", 4 => "April", 5 => "May", 6 => "June", 7 => "July", 8 => "August", 9 => "September", 10 => "October", 11 => "November", else => "December" }
}

fn weekdayName(weekday: i64, german: bool) -> []const u8 {
    if german {
        return match weekday { 0 => "Sonntag", 1 => "Montag", 2 => "Dienstag", 3 => "Mittwoch", 4 => "Donnerstag", 5 => "Freitag", else => "Samstag" }
    }
    return match weekday { 0 => "Sunday", 1 => "Monday", 2 => "Tuesday", 3 => "Wednesday", 4 => "Thursday", 5 => "Friday", else => "Saturday" }
}

// The column heads: the week, then Monday to Sunday.
fn headName(column: usize, german: bool) -> []const u8 {
    if german {
        return match column { 0 => "KW", 1 => "Mo", 2 => "Di", 3 => "Mi", 4 => "Do", 5 => "Fr", 6 => "Sa", else => "So" }
    }
    return match column { 0 => "Wk", 1 => "Mo", 2 => "Tu", 3 => "We", 4 => "Th", 5 => "Fr", 6 => "Sa", else => "Su" }
}

// Today (local).
fn today(bar: *Bar) -> timezone.Civil { return timezone.civil(bar.*.minute * 60) }

// The day (since 1970) the grid starts on: the Monday on or before the
// month's first.
fn gridStart(bar: *Bar) -> i64 {
    const first = timezone.daysFromCivil(bar.*.calendarYear, bar.*.calendarMonth, 1)
    var weekday = (first + 4) % 7
    if weekday < 0 { weekday += 7 }
    return first - (weekday + 6) % 7
}

// The ISO week of the week starting on `monday`: the week its Thursday is
// in, counted in that Thursday's year.
fn isoWeek(monday: i64) -> i64 {
    const thursday = monday + 3
    const date = timezone.civil(thursday * 86400)
    return (thursday - timezone.daysFromCivil(date.year, 1, 1)) / 7 + 1
}

// The calendar opens on today's month.
pub fn reset(bar: *Bar) -> void {
    const now = today(bar)
    bar.*.calendarYear = now.year
    bar.*.calendarMonth = now.month
}

// The month `steps` on (back when negative).
pub fn turn(bar: *Bar, steps: i64) -> void {
    var month = bar.*.calendarYear * 12 + bar.*.calendarMonth - 1 + steps
    bar.*.calendarYear = month / 12
    bar.*.calendarMonth = month % 12 + 1
    state.popupChanged(bar)
}

fn cellLeft(column: usize) -> i32 { return PADDING + @intCast(i32, column) * CELL }

fn previousLeft() -> i32 { return WIDTH - PADDING - 2 * ARROW - 4 }
fn nextLeft() -> i32 { return WIDTH - PADDING - ARROW }

// What point (x, y) of the popup is over.
pub fn hit(x: i32, y: i32) -> usize {
    if y >= MONTH - 4 && y < MONTH + ARROW - 4 {
        if x >= previousLeft() && x < previousLeft() + ARROW { return HIT_PREVIOUS }
        if x >= nextLeft() && x < nextLeft() + ARROW { return HIT_NEXT }
        if x >= PADDING && x < previousLeft() - 8 { return HIT_MONTH }
        return state.NONE
    }
    if y < GRID || x < PADDING + CELL || x >= PADDING + 8 * CELL { return state.NONE }
    const row = (y - GRID) / ROW
    if row >= 6 { return state.NONE }
    const column = (x - PADDING - CELL) / CELL
    return HIT_DAY + @intCast(usize, row * 7 + column)
}

// A click on what is under the pointer.
pub fn click(bar: *Bar) -> void {
    const target = bar.*.popupHover
    if target == HIT_PREVIOUS { turn(bar, -1) }
    if target == HIT_NEXT { turn(bar, 1) }
    if target == HIT_MONTH {
        reset(bar)
        state.popupChanged(bar)
    }
}

fn centred(canvas: *Canvas, text: *state.Text, label: []const u8, left: i32, width: i32, y: i32, color: u32) -> void {
    const label_width = text_module.measure(text, label)
    text_module.drawText(canvas, text, label, left + (width - label_width) / 2, y, color, 0)
}

fn arrow(canvas: *Canvas, left: i32, top: i32, back: bool, lit: bool) -> void {
    if lit { canvas_module.fillRoundedRect(canvas, left, top, ARROW, ARROW, ARROW / 2, canvas_module.color(40, 255, 255, 255)) }
    const middle_x = left + ARROW / 2
    const middle_y = top + ARROW / 2
    if back {
        state.fillTriangle(canvas, middle_x + 3, middle_y - 5, middle_x + 3, middle_y + 5, middle_x - 4, middle_y, state.TEXT_COLOR)
    } else {
        state.fillTriangle(canvas, middle_x - 3, middle_y - 5, middle_x - 3, middle_y + 5, middle_x + 4, middle_y, state.TEXT_COLOR)
    }
}

pub fn draw(bar: *Bar, canvas: *Canvas) -> void {
    const german = bar.*.german
    const now = today(bar)
    canvas_module.clear(canvas, 0)
    canvas_module.fillRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, state.POPUP_RADIUS, state.POPUP_BACKGROUND)
    canvas_module.strokeRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, state.POPUP_RADIUS, 1, canvas_module.color(60, 255, 255, 255))
    // "Sonntag, 11. Oktober 2026" / "Sunday, 11 October 2026".
    var line: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length = state.put(bytes, 0, weekdayName(now.weekday, german))
    length = state.put(bytes, length, ", ")
    length = state.putNumber(bytes, length, now.day, 1)
    length = state.put(bytes, length, if german { ". " } else { " " })
    length = state.put(bytes, length, monthName(now.month, german))
    length = state.put(bytes, length, " ")
    length = state.putNumber(bytes, length, now.year, 1)
    text_module.drawText(canvas, state.boldOf(bar), bytes[0..length], PADDING, TODAY, state.TEXT_COLOR, WIDTH - 2 * PADDING)
    canvas_module.fillRect(canvas, PADDING, MONTH - 12, WIDTH - 2 * PADDING, 1, canvas_module.color(40, 255, 255, 255))
    // The month and its arrows.
    length = state.put(bytes, 0, monthName(bar.*.calendarMonth, german))
    length = state.put(bytes, length, " ")
    length = state.putNumber(bytes, length, bar.*.calendarYear, 1)
    const shown_today = bar.*.calendarYear == now.year && bar.*.calendarMonth == now.month
    const month_color = if bar.*.popupHover == HIT_MONTH && !shown_today { canvas_module.color(255, 150, 200, 255) } else { state.TEXT_COLOR }
    text_module.drawText(canvas, state.textOf(bar), bytes[0..length], PADDING, MONTH, month_color, previousLeft() - PADDING - 8)
    arrow(canvas, previousLeft(), MONTH - 4, true, bar.*.popupHover == HIT_PREVIOUS)
    arrow(canvas, nextLeft(), MONTH - 4, false, bar.*.popupHover == HIT_NEXT)
    // The heads.
    const dim = canvas_module.color(120, 255, 255, 255)
    var column: usize = 0
    while column < 8 {
        centred(canvas, state.smallOf(bar), headName(column, german), cellLeft(column), CELL, WEEKDAYS, if column == 0 { canvas_module.color(90, 255, 255, 255) } else { dim })
        column += 1
    }
    // The days.
    const start = gridStart(bar)
    const today_days = timezone.daysFromCivil(now.year, now.month, now.day)
    var row: usize = 0
    while row < 6 {
        const top = GRID + @intCast(i32, row) * ROW
        var week: [4]u8 = undefined
        var week_bytes: [*]u8 = undefined
        unsafe { week_bytes = @ptrCast([*]u8, &week) }
        const week_length = state.putNumber(week_bytes, 0, isoWeek(start + @intCast(i64, row) * 7), 1)
        centred(canvas, state.smallOf(bar), week_bytes[0..week_length], cellLeft(0), CELL, top + 8, canvas_module.color(90, 255, 255, 255))
        column = 0
        while column < 7 {
            const days = start + @intCast(i64, row * 7 + column)
            const date = timezone.civil(days * 86400)
            const left = cellLeft(column + 1)
            var number: [4]u8 = undefined
            var number_bytes: [*]u8 = undefined
            unsafe { number_bytes = @ptrCast([*]u8, &number) }
            const number_length = state.putNumber(number_bytes, 0, date.day, 1)
            const inside = date.month == bar.*.calendarMonth
            var color = if inside { state.TEXT_COLOR } else { canvas_module.color(70, 255, 255, 255) }
            if inside && column >= 5 { color = canvas_module.color(170, 255, 255, 255) }
            if days == today_days {
                canvas_module.fillRoundedRect(canvas, left + 2, top + 1, CELL - 4, ROW - 2, (ROW - 2) / 2, state.ACCENT)
                color = state.TEXT_COLOR
            } else if bar.*.popupHover == HIT_DAY + row * 7 + column {
                canvas_module.fillRoundedRect(canvas, left + 2, top + 1, CELL - 4, ROW - 2, (ROW - 2) / 2, canvas_module.color(36, 255, 255, 255))
            }
            centred(canvas, if days == today_days { state.boldOf(bar) } else { state.textOf(bar) }, number_bytes[0..number_length], left, CELL, top + 6, color)
            column += 1
        }
        row += 1
    }
}
