// The control centre (macOS's Control Centre and Notification Centre in
// one). On the bar: toggles, a dot while notifications are unread, a moon
// while Do Not Disturb is on (they grow in and out). A click opens the
// popup, laid out as the other popups (its header's button opens
// mlx-settings):
//
//   - six tiles: the network (what mlx-netd says over the system bus,
//     network.mlx; without it what /sys/class/net, or the directory
//     MLX_TOPBAR_NET names for tests, shows as up; with a Wi-Fi card it
//     opens the list of networks under the tiles), Do Not Disturb, night
//     light (night-light in compositor.conf, which the compositor reads
//     again within half a second), dark mode (the desktop's look for every
//     app, through the portal: look.mlx), locking the screen and a
//     screenshot (mlx-capture into ~/Bilder or ~/Pictures once the popup
//     went, then a notification with it); a tile turned on glows in the
//     accent colour, fading as it turns;
//   - the volume (MLX Audio, as the sound popup's slider; the speaker
//     mutes; the wheel turns it);
//   - what plays (the player the bar shows): its title and artist,
//     previous, play or pause, next;
//   - the notifications mlx-notifyd kept (shared/notices.mlx), newest
//     first: the app's icon, the summary and the body, when it came. One
//     goes with its close button (the ones under it glide up), Clear takes
//     them all (they fade out).
//
// The list comes from mlx-notifyd on MLXIPC (org.mlx.Notifications on
// org.freedesktop.Notifications: List, asked again on its Changed signal),
// and Do Not Disturb and the list's changes go back to it there
// (SetDoNotDisturb, Dismiss, ClearHistory); opening the popup marks the
// notifications read (MarkRead).
const std = @import("std")
const dbus = @import("std.dbus")
const state = @import("./state.mlx")
const bus = @import("./bus.mlx")
const popup = @import("./popup.mlx")
const sound = @import("./sound.mlx")
const media = @import("./media.mlx")
const anim = @import("../shared/anim.mlx")
const symbols = @import("../shared/symbols.mlx")
const notices_module = @import("../shared/notices.mlx")
const config_file = @import("../shared/config_file.mlx")
const look = @import("./look.mlx")
const network = @import("./network.mlx")
const apps_module = @import("../shared/apps.mlx")
const icons = @import("../shared/icons.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const timezone = @import("std.timezone")

const Bar = state.Bar
const Canvas = state.Canvas
const Notice = notices_module.Notice

pub const NAME: []const u8 = "org.freedesktop.Notifications"
const PATH: []const u8 = "/org/freedesktop/Notifications"
pub const OWN: []const u8 = "org.mlx.Notifications"

const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_getdents64: usize = 217
const O_DIRECTORY: usize = 65536
const O_CLOEXEC: usize = 524288

const MESSAGE_LOCK: u8 = 108

pub const WIDGET: i32 = 28

// The popup.
pub const WIDTH: i32 = 360
const PADDING: i32 = 16
const TILES_TOP: i32 = popup.HEADER + 10
const TILE_GAP: i32 = 10
const TILE_WIDTH: i32 = (WIDTH - 2 * PADDING - TILE_GAP) / 2
const TILE_HEIGHT: i32 = 54
const TILE_ICON: i32 = 32
const TILES: usize = 6
const VOLUME_HEIGHT: i32 = 44
const MUTE_SIZE: i32 = 30
const SLIDER_LEFT: i32 = PADDING + MUTE_SIZE + 22
const SLIDER_RIGHT: i32 = WIDTH - PADDING - 16
const MEDIA_HEIGHT: i32 = 56
const MEDIA_BUTTON: i32 = 30
const SECTION: i32 = 30
const NOTICE_ROW: i32 = 62
const NOTICE_ICON: i32 = 32
// A row of the Wi-Fi list under the tiles.
const NET_ROW: i32 = 34
// At most this many notifications show; the others are counted.
const SHOWN: usize = 4
const MORE_HEIGHT: i32 = 24
const NONE_HEIGHT: i32 = 40
const CLOSE_SIZE: i32 = 22
// How long a dismissed one's neighbours glide up, and cleared ones fade.
const GLIDE: usize = 220
const FADE: usize = 200

// What the pointer is over (popupHover).
pub const HIT_TILE: usize = 10
pub const HIT_MUTE: usize = 20
pub const HIT_SLIDER: usize = 21
pub const HIT_PREVIOUS: usize = 30
pub const HIT_PLAY: usize = 31
pub const HIT_NEXT: usize = 32
pub const HIT_MEDIA: usize = 33
pub const HIT_CLEAR: usize = 40
pub const HIT_NET_ROW: usize = 50
pub const HIT_NET_SETTINGS: usize = 60
pub const HIT_NOTICE: usize = 100
pub const HIT_CLOSE: usize = 200

// The tiles.
const TILE_NETWORK: usize = 0
const TILE_DND: usize = 1
const TILE_NIGHT: usize = 2
const TILE_LOOK: usize = 3
const TILE_LOCK: usize = 4
const TILE_SHOT: usize = 5
// The screenshot waits this long for the popup to go (milliseconds).
const SHOT_WAIT: usize = 350
const SYS_mkdir: usize = 83

// What is connected.
pub const NET_NONE: u32 = 0
pub const NET_WIRED: u32 = 1
pub const NET_WIRELESS: u32 = 2

fn noticesOf(bar: *Bar) -> *notices_module.Notices { return state.noticesOf(bar) }

fn tileGlow(bar: *Bar, tile: usize) -> *anim.Glide { return state.glideAt(bar, @offsetOf(Bar, "controlTiles"), tile) }

// Whether tile `tile` is on now.
fn tileOn(bar: *Bar, tile: usize) -> bool {
    if tile == TILE_NETWORK { return bar.*.netKind != NET_NONE }
    if tile == TILE_DND { return noticesOf(bar).*.dnd }
    if tile == TILE_NIGHT { return bar.*.nightLight }
    if tile == TILE_LOOK { return !look.isLight(bar) }
    return false
}

// The tiles glow as they are (at once, or gliding).
fn glowTiles(bar: *Bar, glide: bool) -> void {
    var tile: usize = 0
    while tile < TILES {
        const target: i32 = if tileOn(bar, tile) { 255 } else { 0 }
        if glide { anim.set(tileGlow(bar, tile), target, 200) } else { anim.jump(tileGlow(bar, tile), target) }
        tile += 1
    }
}

// The widget's badges grow in or out: the dot (unread) and the moon.
fn badges(bar: *Bar) -> void {
    const notices = noticesOf(bar)
    const dot: i32 = if notices.*.unread > 0 && !notices.*.dnd { 255 } else { 0 }
    const moon: i32 = if notices.*.dnd { 255 } else { 0 }
    const dot_glide = state.glideAt(bar, @offsetOf(Bar, "controlDot"), 0)
    const moon_glide = state.glideAt(bar, @offsetOf(Bar, "controlMoon"), 0)
    if dot_glide.*.to != dot { anim.set(dot_glide, dot, 220) }
    if moon_glide.*.to != moon { anim.set(moon_glide, moon, 220) }
}

pub fn init(bar: *Bar) -> void {
    notices_module.clear(noticesOf(bar))
    noticesOf(bar).*.dnd = false
    bar.*.nightLight = false
    bar.*.netKind = NET_NONE
    state.labelClear(&bar.*.netName)
    bar.*.removedIndex = state.NONE
    bar.*.removedAt = 0
    bar.*.clearingAt = 0
    network.init(bar)
    const net = apps_module.environmentValue(bar.*.environment, "MLX_TOPBAR_NET")
    state.labelSet(&bar.*.netRoot, if @intFromPtr(net) != 0 { std.text.cString(net) } else { "/sys/class/net" })
    anim.jump(state.glideAt(bar, @offsetOf(Bar, "controlDot"), 0), 0)
    anim.jump(state.glideAt(bar, @offsetOf(Bar, "controlMoon"), 0), 0)
    glowTiles(bar, false)
}

// ---------------------------------------------------------------------------
// What the popup shows

// A small file of an interface's (`file` of `name` under the root) into
// `out` (64 bytes) without its newline; its length.
fn readValue(bar: *Bar, name: []const u8, file: []const u8, out: [*]u8) -> usize {
    var path: state.Label = undefined
    path.length = 0
    state.labelAdd(&path, state.labelText(&bar.*.netRoot))
    state.labelAdd(&path, "/")
    state.labelAdd(&path, name)
    state.labelAdd(&path, "/")
    state.labelAdd(&path, file)
    var length = std.fs.readFile(state.labelPath(&path), out, 63)
    while length > 0 && (out[length - 1] == 10 || out[length - 1] == 32) { length -= 1 }
    return length
}

// Whether `name` (an entry under the root) is a directory there (its
// "wireless" or "phy80211").
fn hasEntry(bar: *Bar, name: []const u8, entry: []const u8) -> bool {
    var path: state.Label = undefined
    path.length = 0
    state.labelAdd(&path, state.labelText(&bar.*.netRoot))
    state.labelAdd(&path, "/")
    state.labelAdd(&path, name)
    state.labelAdd(&path, "/")
    state.labelAdd(&path, entry)
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(state.labelPath(&path)), O_DIRECTORY | O_CLOEXEC, 0)
    if descriptor < 0 { return false }
    _ = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return true
}

// What is connected: the first interface (not loopback) whose operstate
// is up, Wi-Fi when it has a wireless directory; a cable before Wi-Fi.
fn readNetwork(bar: *Bar) -> void {
    const before = bar.*.netKind
    bar.*.netKind = NET_NONE
    state.labelClear(&bar.*.netName)
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(state.labelPath(&bar.*.netRoot)), O_DIRECTORY | O_CLOEXEC, 0)
    if descriptor < 0 { return }
    var buffer: [4096]u8 = undefined
    while true {
        const count = std.linux.syscall3(SYS_getdents64, @bitCast(usize, descriptor), @intFromPtr(&buffer), 4096)
        if count <= 0 { break }
        var at: usize = 0
        while at < @intCast(usize, count) {
            const record = @intCast(usize, buffer[at + 16]) | (@intCast(usize, buffer[at + 17]) << 8)
            var end = at + 19
            while end < at + record && buffer[end] != 0 { end += 1 }
            const bytes: [*]const u8 = &buffer
            const name = bytes[at + 19..end]
            if name.length > 0 && name[0] != 46 && !state.same(name, "lo") {
                var text: [64]u8 = undefined
                const out: [*]u8 = &text
                const length = readValue(bar, name, "operstate", out)
                if state.same(out[0..length], "up") {
                    const kind = if hasEntry(bar, name, "wireless") || hasEntry(bar, name, "phy80211") { NET_WIRELESS } else { NET_WIRED }
                    // A cable wins over Wi-Fi.
                    if bar.*.netKind == NET_NONE || (kind == NET_WIRED && bar.*.netKind == NET_WIRELESS) {
                        bar.*.netKind = kind
                        state.labelSet(&bar.*.netName, name)
                    }
                }
            }
            if record == 0 { break }
            at += record
        }
    }
    _ = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    if before != bar.*.netKind {
        anim.set(tileGlow(bar, TILE_NETWORK), if bar.*.netKind != NET_NONE { 255 } else { 0 }, 200)
        state.popupChanged(bar)
    }
}

fn centre(bar: *Bar) -> i32 { return bar.*.widgetLeft[state.WIDGET_CONTROL] + bar.*.widgetWidth[state.WIDGET_CONTROL] / 2 }

// The popup's height for what it shows now.
pub fn height(bar: *Bar) -> i32 { return listTop(bar) + SECTION + listHeight(bar) + 10 }

fn tilesBottom() -> i32 { return TILES_TOP + 3 * TILE_HEIGHT + 2 * TILE_GAP }

// The Wi-Fi list's rows (a row saying none when there are none) and the
// row to the settings.
fn netRows(bar: *Bar) -> usize { return if bar.*.wifiCount > 0 { bar.*.wifiCount } else { 1 } }

fn netListHeight(bar: *Bar) -> i32 {
    if !bar.*.netListOpen { return 0 }
    return @intCast(i32, netRows(bar) + 1) * NET_ROW + 22
}

fn volumeTop(bar: *Bar) -> i32 { return tilesBottom() + 12 + netListHeight(bar) }

fn hasVolume(bar: *Bar) -> bool { return bar.*.audioUp }

fn mediaTop(bar: *Bar) -> i32 { return volumeTop(bar) + if hasVolume(bar) { VOLUME_HEIGHT + 10 } else { 0 } }

fn hasMedia(bar: *Bar) -> bool { return media.shown(bar) != state.NONE }

fn listTop(bar: *Bar) -> i32 { return mediaTop(bar) + if hasMedia(bar) { MEDIA_HEIGHT + 10 } else { 0 } }

fn shownNotices(bar: *Bar) -> usize {
    const count = noticesOf(bar).*.count
    return if count > SHOWN { SHOWN } else { count }
}

fn listHeight(bar: *Bar) -> i32 {
    const count = noticesOf(bar).*.count
    if count == 0 { return NONE_HEIGHT }
    return @intCast(i32, shownNotices(bar)) * NOTICE_ROW + if count > SHOWN { MORE_HEIGHT } else { 0 }
}

// The popup's size follows what it shows (not while the notifications
// glide: step fits it after).
fn fit(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_CONTROL && bar.*.removedAt == 0 { popup.resize(bar, centre(bar), WIDTH, height(bar)) }
}

// Asks mlx-notifyd for the list (its reply comes to listed).
pub fn refresh(bar: *Bar) -> void { bus.callEmpty(bar, NAME, PATH, OWN, "List", bus.PURPOSE_NOTICES, 0) }

// mlx-notifyd's list came (failed: there is none to ask).
pub fn listed(bar: *Bar, reading: *dbus.Reader, failed: bool) -> void {
    if failed { return }
    // Being cleared: asked again once the list faded out.
    if bar.*.clearingAt != 0 { return }
    const unread_before = noticesOf(bar).*.unread
    const dnd_before = noticesOf(bar).*.dnd
    const count_before = noticesOf(bar).*.count
    if !notices_module.take(reading, noticesOf(bar)) { return }
    // Looked at already: what came while the popup is open is read.
    if bar.*.popup == state.POPUP_CONTROL && !bar.*.closing && noticesOf(bar).*.unread > 0 { markRead(bar) }
    if dnd_before != noticesOf(bar).*.dnd { anim.set(tileGlow(bar, TILE_DND), if noticesOf(bar).*.dnd { 255 } else { 0 }, 200) }
    if unread_before != noticesOf(bar).*.unread || dnd_before != noticesOf(bar).*.dnd || count_before != noticesOf(bar).*.count {
        state.say(bar, "topbar: notifications ")
        state.sayNumber(bar, @intCast(i64, noticesOf(bar).*.count))
        state.say(bar, ", unread ")
        state.sayNumber(bar, @intCast(i64, noticesOf(bar).*.unread))
        state.say(bar, if noticesOf(bar).*.dnd { ", do not disturb\n" } else { "\n" })
    }
    badges(bar)
    state.barChanged(bar)
    state.popupChanged(bar)
    fit(bar)
}

// mlx-notifyd went (or the bus): no list.
pub fn daemonGone(bar: *Bar) -> void {
    notices_module.clear(noticesOf(bar))
    noticesOf(bar).*.dnd = false
    badges(bar)
    state.barChanged(bar)
    state.popupChanged(bar)
    fit(bar)
}

// What is connected: mlx-netd's word, else /sys/class/net's. The tile
// glows when something is.
fn readState(bar: *Bar) -> void {
    const before = bar.*.netKind
    const listed = bar.*.wifiCount
    if !network.refresh(bar) {
        bar.*.netListOpen = false
        readNetwork(bar)
        return
    }
    if before != bar.*.netKind { anim.set(tileGlow(bar, TILE_NETWORK), if bar.*.netKind != NET_NONE { 255 } else { 0 }, 200) }
    state.popupChanged(bar)
    if bar.*.netListOpen && listed != bar.*.wifiCount { fit(bar) }
}

// Every second while the popup is open: the network.
pub fn tick(bar: *Bar) -> void {
    if bar.*.popup == state.POPUP_CONTROL { readState(bar) }
}

// The screenshot: ~/Bilder/Bildschirmfoto 2026-10-11 14.05.09.png (or
// ~/Pictures/Screenshot ...), taken by mlx-capture, then told by
// mlx-notify with the picture as its icon (both through the shell, after
// one another).
fn takeShot(bar: *Bar) -> void {
    const german = bar.*.german
    const home = apps_module.environmentValue(bar.*.environment, "HOME")
    if @intFromPtr(home) == 0 || home[0] == 0 { return }
    var folder: state.Label = undefined
    state.labelSet(&folder, std.text.cString(home))
    state.labelAdd(&folder, if german { "/Bilder" } else { "/Pictures" })
    _ = std.linux.syscall2(SYS_mkdir, @intFromPtr(state.labelPath(&folder)), 493)
    const utc = if bar.*.fixedTime != 0 { bar.*.fixedTime } else { timezone.now() }
    const time = timezone.civil(utc + timezone.offsetAt(state.zoneOf(bar), utc))
    var name: [64]u8 = undefined
    const bytes: [*]u8 = &name
    var length = state.put(bytes, 0, if german { "Bildschirmfoto " } else { "Screenshot " })
    length = state.putNumber(bytes, length, time.year, 4)
    length = state.put(bytes, length, "-")
    length = state.putNumber(bytes, length, time.month, 2)
    length = state.put(bytes, length, "-")
    length = state.putNumber(bytes, length, time.day, 2)
    length = state.put(bytes, length, " ")
    length = state.putNumber(bytes, length, time.hour, 2)
    length = state.put(bytes, length, ".")
    length = state.putNumber(bytes, length, time.minute, 2)
    length = state.put(bytes, length, ".")
    length = state.putNumber(bytes, length, time.second, 2)
    length = state.put(bytes, length, ".png")
    var path: state.Label = undefined
    state.labelSet(&path, state.labelText(&folder))
    state.labelAdd(&path, "/")
    state.labelAdd(&path, bytes[0..length])
    // mlx-capture 'PATH' && mlx-notify -a NAME -i 'PATH' SAVED 'FILE'
    var command: [800]u8 = undefined
    const out: [*]u8 = &command
    var size = state.put(out, 0, "mlx-capture '")
    size = state.put(out, size, state.labelText(&path))
    size = state.put(out, size, if german { "' && mlx-notify -a Bildschirmfoto -i '" } else { "' && mlx-notify -a Screenshot -i '" })
    size = state.put(out, size, state.labelText(&path))
    size = state.put(out, size, if german { "' 'Bildschirmfoto gespeichert' '" } else { "' 'Screenshot saved' '" })
    size = state.put(out, size, bytes[0..length])
    size = state.put(out, size, "'")
    out[size] = 0
    apps_module.spawn(out, bar.*.environment)
    state.say(bar, "topbar: screenshot ")
    state.say(bar, state.labelText(&path))
    state.say(bar, "\n")
}

// Every tick while something moves: the popup takes its new height once
// the ones under a dismissed notification glided up; the cleared list
// faded out goes.
pub fn step(bar: *Bar) -> void {
    if bar.*.shotAt != 0 && std.time.milliseconds() >= bar.*.shotAt {
        bar.*.shotAt = 0
        takeShot(bar)
    }
    if bar.*.removedAt != 0 && std.time.milliseconds() - bar.*.removedAt >= GLIDE {
        bar.*.removedAt = 0
        fit(bar)
        state.popupChanged(bar)
    }
    if bar.*.netClosingAt != 0 && std.time.milliseconds() - bar.*.netClosingAt >= FADE {
        bar.*.netClosingAt = 0
        bar.*.netListOpen = false
        fit(bar)
        state.popupChanged(bar)
    }
    if bar.*.clearingAt != 0 && std.time.milliseconds() - bar.*.clearingAt >= FADE {
        bar.*.clearingAt = 0
        notices_module.clear(noticesOf(bar))
        fit(bar)
        state.popupChanged(bar)
        refresh(bar)
    }
}

fn markRead(bar: *Bar) -> void {
    noticesOf(bar).*.unread = 0
    bus.callEmpty(bar, NAME, PATH, OWN, "MarkRead", bus.PURPOSE_IGNORE, 0)
    badges(bar)
    state.barChanged(bar)
}

// Before the popup opens: what it shows now (its size depends on it).
pub fn prepare(bar: *Bar) -> void {
    bar.*.clearingAt = 0
    bar.*.removedAt = 0
    bar.*.netListOpen = false
    bar.*.netClosingAt = 0
    readState(bar)
    bar.*.nightLight = config_file.isOn(bar.*.environment, "compositor.conf", "night-light", false, bar.*.allocator)
    glowTiles(bar, false)
}

pub fn opened(bar: *Bar) -> void {
    anim.jump(state.volumeShownOf(bar), @intCast(i32, bar.*.volume))
    if hasMedia(bar) { media.opened(bar) }
    if noticesOf(bar).*.unread > 0 { markRead(bar) }
}

// ---------------------------------------------------------------------------
// The widget

pub fn widgetWidth(bar: *Bar) -> i32 { return WIDGET }

pub fn drawWidget(bar: *Bar, canvas: *Canvas, left: i32) -> void {
    const light = state.glided(bar, state.lightOf(bar, state.WIDGET_CONTROL))
    const lit = if bar.*.popup == state.POPUP_CONTROL { 255 } else { light }
    if lit > 0 { canvas_module.fillRoundedRect(canvas, left, 3, WIDGET, state.HEIGHT - 6, 6, state.ink(bar, @intCast(u32, lit * 40 / 255))) }
    state.symbol(bar, canvas, symbols.TOGGLES, 0, left + 5, (state.HEIGHT - 18) / 2, 18)
    // The dot and the moon grow from their middles.
    const dot = state.glided(bar, state.glideAt(bar, @offsetOf(Bar, "controlDot"), 0))
    if dot > 0 {
        const size = 3 + dot * 5 / 255
        canvas_module.fillRoundedRect(canvas, left + WIDGET - 6 - size / 2, 7 - size / 2, size, size, size / 2, state.ACCENT)
    }
    const moon = state.glided(bar, state.glideAt(bar, @offsetOf(Bar, "controlMoon"), 0))
    if moon > 0 {
        const size = 4 + moon * 8 / 255
        symbols.draw(state.symbolsOf(bar), canvas, symbols.MOON, 0, left + WIDGET - 6 - size / 2, 8 - size / 2, size, canvas_module.color(@intCast(u32, moon), 200, 170, 255))
    }
}

// ---------------------------------------------------------------------------
// The popup

fn tileLeft(tile: usize) -> i32 { return PADDING + @intCast(i32, tile % 2) * (TILE_WIDTH + TILE_GAP) }
fn tileTop(tile: usize) -> i32 { return TILES_TOP + @intCast(i32, tile / 2) * (TILE_HEIGHT + TILE_GAP) }

fn mediaButtonLeft(which: usize) -> i32 { return WIDTH - PADDING - 8 - (3 - @intCast(i32, which)) * (MEDIA_BUTTON + 4) }

// Where notification `index` is drawn now (its neighbour dismissed, it
// glides up from a row lower).
fn noticeTop(bar: *Bar, index: usize) -> i32 {
    const top = listTop(bar) + SECTION + @intCast(i32, index) * NOTICE_ROW
    if bar.*.removedAt == 0 || index < bar.*.removedIndex { return top }
    const t = state.popupAlong(bar, bar.*.removedAt, GLIDE)
    return top + NOTICE_ROW * (1024 - t) / 1024
}

fn clearLabel(bar: *Bar) -> []const u8 { return if bar.*.german { "Alle löschen" } else { "Clear all" } }

fn clearLeft(bar: *Bar) -> i32 { return WIDTH - PADDING - text_module.measure(state.smallOf(bar), clearLabel(bar)) - 12 }

pub fn hit(bar: *Bar, x: i32, y: i32) -> usize {
    var tile: usize = 0
    while tile < TILES {
        if x >= tileLeft(tile) && x < tileLeft(tile) + TILE_WIDTH && y >= tileTop(tile) && y < tileTop(tile) + TILE_HEIGHT { return HIT_TILE + tile }
        tile += 1
    }
    if bar.*.netListOpen && bar.*.netClosingAt == 0 && y >= tilesBottom() + 12 && y < volumeTop(bar) - 10 && x >= PADDING && x < WIDTH - PADDING {
        const row = @intCast(usize, (y - tilesBottom() - 18) / NET_ROW)
        if row < netRows(bar) { return if bar.*.wifiCount > 0 { HIT_NET_ROW + row } else { state.NONE } }
        return HIT_NET_SETTINGS
    }
    if hasVolume(bar) && y >= volumeTop(bar) && y < volumeTop(bar) + VOLUME_HEIGHT {
        if x >= PADDING && x < PADDING + MUTE_SIZE + 8 { return HIT_MUTE }
        if x >= SLIDER_LEFT - 8 && x < SLIDER_RIGHT + 8 { return HIT_SLIDER }
        return state.NONE
    }
    if hasMedia(bar) && y >= mediaTop(bar) && y < mediaTop(bar) + MEDIA_HEIGHT {
        var which: usize = 0
        while which < 3 {
            const left = mediaButtonLeft(which)
            if x >= left && x < left + MEDIA_BUTTON { return HIT_PREVIOUS + which }
            which += 1
        }
        return HIT_MEDIA
    }
    const list = listTop(bar)
    if noticesOf(bar).*.count > 0 && y >= list && y < list + SECTION - 6 && x >= clearLeft(bar) && x < WIDTH - PADDING + 4 { return HIT_CLEAR }
    var index: usize = 0
    while index < shownNotices(bar) {
        const top = list + SECTION + @intCast(i32, index) * NOTICE_ROW
        if y >= top && y < top + NOTICE_ROW - 4 && x >= PADDING - 6 && x < WIDTH - PADDING + 6 {
            const close_left = WIDTH - PADDING - CLOSE_SIZE
            if x >= close_left - 4 && y < top + CLOSE_SIZE + 10 { return HIT_CLOSE + index }
            return HIT_NOTICE + index
        }
        index += 1
    }
    return state.NONE
}

// A slider's value for x.
fn along(x: i32) -> u32 {
    var at = x - SLIDER_LEFT
    if at < 0 { at = 0 }
    if at > SLIDER_RIGHT - SLIDER_LEFT { at = SLIDER_RIGHT - SLIDER_LEFT }
    return @intCast(u32, @intCast(i64, at) * 65536 / @intCast(i64, SLIDER_RIGHT - SLIDER_LEFT))
}

// The pointer held on the slider moved to x.
pub fn drag(bar: *Bar, x: i32) -> void { sound.setVolume(bar, along(x)) }

fn setDoNotDisturb(bar: *Bar, on: bool) -> void {
    noticesOf(bar).*.dnd = on
    var body: [8]u8 = undefined
    const bytes: [*]u8 = &body
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 8, false)
    dbus.putBool(&writing, on)
    bus.call(bar, NAME, PATH, OWN, "SetDoNotDisturb", "b", bytes, writing.length, bus.PURPOSE_IGNORE, 0)
    state.say(bar, if on { "topbar: do not disturb on\n" } else { "topbar: do not disturb off\n" })
    anim.set(tileGlow(bar, TILE_DND), if on { 255 } else { 0 }, 200)
    badges(bar)
    state.barChanged(bar)
}

fn setNightLight(bar: *Bar, on: bool) -> void {
    if !config_file.set(bar.*.environment, "compositor.conf", "night-light", if on { "on" } else { "off" }, bar.*.allocator) {
        state.say(bar, "topbar: compositor.conf could not be written\n")
        return
    }
    bar.*.nightLight = on
    state.say(bar, if on { "topbar: night light on\n" } else { "topbar: night light off\n" })
    anim.set(tileGlow(bar, TILE_NIGHT), if on { 255 } else { 0 }, 200)
}

// Notification `index` goes: the bar's copy at once (the ones under it
// glide up, then the popup shrinks), mlx-notifyd's list too.
fn dismiss(bar: *Bar, index: usize) -> void {
    const notices = noticesOf(bar)
    if index >= notices.*.count { return }
    var body: [8]u8 = undefined
    const bytes: [*]u8 = &body
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 8, false)
    dbus.putU32(&writing, notices_module.at(notices, index).*.id)
    bus.call(bar, NAME, PATH, OWN, "Dismiss", "u", bytes, writing.length, bus.PURPOSE_IGNORE, 0)
    state.say(bar, "topbar: dismissed ")
    state.say(bar, notices_module.summaryOf(notices_module.at(notices, index)))
    state.say(bar, "\n")
    notices_module.remove(notices, index)
    bar.*.removedIndex = index
    bar.*.removedAt = std.time.milliseconds()
    bar.*.popupHover = state.NONE
    state.popupChanged(bar)
    state.fastTicks(bar)
}

fn clearAll(bar: *Bar) -> void {
    if noticesOf(bar).*.count == 0 || bar.*.clearingAt != 0 { return }
    bus.callEmpty(bar, NAME, PATH, OWN, "ClearHistory", bus.PURPOSE_IGNORE, 0)
    state.say(bar, "topbar: cleared the notifications\n")
    bar.*.clearingAt = std.time.milliseconds()
    bar.*.popupHover = state.NONE
    state.popupChanged(bar)
    state.fastTicks(bar)
}

pub fn press(bar: *Bar) -> void {
    const target = bar.*.popupHover
    if target == HIT_TILE + TILE_DND { setDoNotDisturb(bar, !noticesOf(bar).*.dnd) }
    if target == HIT_TILE + TILE_NIGHT { setNightLight(bar, !bar.*.nightLight) }
    if target == HIT_TILE + TILE_NETWORK {
        if bar.*.netKnown && bar.*.hasWifi {
            // The list of networks opens (its rows fade in) or closes.
            if bar.*.netListOpen && bar.*.netClosingAt == 0 {
                bar.*.netClosingAt = std.time.milliseconds()
            } else {
                bar.*.netListOpen = true
                bar.*.netClosingAt = 0
                bar.*.netListAt = std.time.milliseconds()
                readState(bar)
                fit(bar)
                state.say(bar, "topbar: networks\n")
            }
            state.fastTicks(bar)
        } else {
            network.openSettings(bar, "")
            popup.close(bar)
        }
    }
    if target >= HIT_NET_ROW && target < HIT_NET_ROW + 6 {
        if network.choose(bar, target - HIT_NET_ROW) { popup.close(bar) } else { fit(bar) }
    }
    if target == HIT_NET_SETTINGS {
        network.openSettings(bar, "")
        popup.close(bar)
    }
    if target == HIT_TILE + TILE_LOOK {
        look.toggle(bar)
        anim.set(tileGlow(bar, TILE_LOOK), if look.isLight(bar) { 0 } else { 255 }, 200)
    }
    if target == HIT_TILE + TILE_SHOT {
        bar.*.shotAt = std.time.milliseconds() + SHOT_WAIT
        popup.close(bar)
        state.fastTicks(bar)
    }
    if target == HIT_TILE + TILE_LOCK {
        var message: [1]u8 = [1]u8{ MESSAGE_LOCK }
        state.send(bar, &message, 1)
        state.say(bar, "topbar: lock\n")
        popup.close(bar)
    }
    if target == HIT_MUTE { sound.setMute(bar, !bar.*.mute) }
    if target == HIT_SLIDER {
        bar.*.dragging = true
        drag(bar, bar.*.popupX)
    }
    if target == HIT_PREVIOUS { media.previous(bar) }
    if target == HIT_PLAY { media.playPause(bar) }
    if target == HIT_NEXT { media.next(bar) }
    if target == HIT_MEDIA {
        media.raise(bar)
        popup.close(bar)
    }
    if target == HIT_CLEAR { clearAll(bar) }
    if target >= HIT_CLOSE && target < HIT_CLOSE + SHOWN { dismiss(bar, target - HIT_CLOSE) }
    state.popupChanged(bar)
}

// The wheel turns the volume.
pub fn popupWheel(bar: *Bar, steps: i32) -> void { sound.wheel(bar, steps) }

// A tile: its symbol in a circle (glowing in the accent colour as far as
// it is on), its name, a word on what it is at.
fn drawTile(bar: *Bar, canvas: *Canvas, tile: usize, symbol: u32, variant: u32, label: []const u8, status: []const u8) -> void {
    const left = tileLeft(tile)
    const top = tileTop(tile)
    canvas_module.fillRoundedRect(canvas, left, top, TILE_WIDTH, TILE_HEIGHT, 12, state.colorsOf(bar).*.panel)
    if bar.*.popupHover == HIT_TILE + tile { popup.light(bar, canvas, left, top, TILE_WIDTH, TILE_HEIGHT, 12) }
    const glow = state.popupGlided(bar, tileGlow(bar, tile))
    const circle_left = left + 10
    const circle_top = top + (TILE_HEIGHT - TILE_ICON) / 2
    canvas_module.fillRoundedRect(canvas, circle_left, circle_top, TILE_ICON, TILE_ICON, TILE_ICON / 2, state.ink(bar, 50))
    if glow > 0 { canvas_module.fillRoundedRect(canvas, circle_left, circle_top, TILE_ICON, TILE_ICON, TILE_ICON / 2, canvas_module.color(@intCast(u32, glow), 90, 160, 255)) }
    state.symbolOn(bar, canvas, symbol, variant, circle_left + 7, circle_top + 7, 18, glow)
    const text_left = circle_left + TILE_ICON + 10
    const room = left + TILE_WIDTH - text_left - 8
    text_module.drawText(canvas, state.textOf(bar), label, text_left, top + 10, state.ink(bar, 255), room)
    text_module.drawText(canvas, state.smallOf(bar), status, text_left, top + 30, state.ink(bar, 150), room)
}

fn drawTiles(bar: *Bar, canvas: *Canvas) -> void {
    const german = bar.*.german
    const notices = noticesOf(bar)
    // The network.
    var net_symbol = symbols.OFFLINE
    var net_label: []const u8 = if german { "Netzwerk" } else { "Network" }
    var net_status: []const u8 = if german { "Nicht verbunden" } else { "Not connected" }
    if bar.*.netKind == NET_WIRED {
        net_symbol = symbols.ETHERNET
        net_label = "Ethernet"
        net_status = state.labelText(&bar.*.netName)
    } else if bar.*.netKind == NET_WIRELESS {
        net_symbol = symbols.WIFI
        net_label = if german { "WLAN" } else { "Wi-Fi" }
        net_status = state.labelText(&bar.*.netName)
    } else if bar.*.netConnecting {
        net_symbol = symbols.WIFI
        net_label = if german { "Verbinde …" } else { "Joining …" }
        net_status = state.labelText(&bar.*.netJoining)
    } else if bar.*.netKnown && bar.*.hasWifi {
        net_symbol = symbols.WIFI
        net_label = if german { "WLAN" } else { "Wi-Fi" }
    }
    drawTile(bar, canvas, TILE_NETWORK, net_symbol, if net_symbol == symbols.WIFI { 4 } else { 0 }, net_label, net_status)
    const on: []const u8 = if german { "An" } else { "On" }
    const off: []const u8 = if german { "Aus" } else { "Off" }
    drawTile(bar, canvas, TILE_DND, symbols.BELL, if notices.*.dnd { symbols.NO_DISTURB } else { 0 }, if german { "Nicht stören" } else { "Do Not Disturb" }, if notices.*.dnd { on } else { off })
    drawTile(bar, canvas, TILE_NIGHT, if bar.*.nightLight { symbols.MOON } else { symbols.SUN }, 0, if german { "Nachtlicht" } else { "Night Light" }, if bar.*.nightLight { on } else { off })
    const dark = !look.isLight(bar)
    drawTile(bar, canvas, TILE_LOOK, symbols.APPEARANCE, 0, if german { "Dunkelmodus" } else { "Dark Mode" }, if dark { on } else { off })
    drawTile(bar, canvas, TILE_LOCK, symbols.LOCK, 0, if german { "Sperren" } else { "Lock" }, "Super+L")
    drawTile(bar, canvas, TILE_SHOT, symbols.CAMERA, 0, if german { "Bildschirmfoto" } else { "Screenshot" }, if german { "Ganzer Bildschirm" } else { "Whole screen" })
}

fn drawVolume(bar: *Bar, canvas: *Canvas) -> void {
    const top = volumeTop(bar)
    const hover = bar.*.popupHover
    canvas_module.fillRoundedRect(canvas, PADDING, top, WIDTH - 2 * PADDING, VOLUME_HEIGHT, 12, state.colorsOf(bar).*.panel)
    if hover == HIT_MUTE { popup.light(bar, canvas, PADDING + 4, top + 4, MUTE_SIZE + 4, VOLUME_HEIGHT - 8, 8) }
    const volume = state.popupGlided(bar, state.volumeShownOf(bar))
    state.symbol(bar, canvas, symbols.SPEAKER, sound.waves(volume, bar.*.mute), PADDING + 10, top + (VOLUME_HEIGHT - 22) / 2, 22)
    sound.slider(bar, canvas, SLIDER_LEFT, SLIDER_RIGHT, top + VOLUME_HEIGHT / 2, volume, hover == HIT_SLIDER, bar.*.mute, 16)
}

fn drawMedia(bar: *Bar, canvas: *Canvas) -> void {
    const index = media.shown(bar)
    if index == state.NONE { return }
    const player = state.playerAt(bar, index)
    const top = mediaTop(bar)
    const hover = bar.*.popupHover
    canvas_module.fillRoundedRect(canvas, PADDING, top, WIDTH - 2 * PADDING, MEDIA_HEIGHT, 12, state.colorsOf(bar).*.panel)
    if hover == HIT_MEDIA { popup.light(bar, canvas, PADDING, top, WIDTH - 2 * PADDING, MEDIA_HEIGHT, 12) }
    // The cover (when the media popup loaded one), else a note.
    const art = 40
    const art_top = top + (MEDIA_HEIGHT - art) / 2
    if bar.*.hasCover {
        canvas_module.drawImage(canvas, state.coverOf(bar), PADDING + 8, art_top, art, 255)
    } else {
        canvas_module.fillRoundedRect(canvas, PADDING + 8, art_top, art, art, 8, state.ink(bar, 60))
        state.symbol(bar, canvas, symbols.NOTE, 0, PADDING + 18, art_top + 10, 20)
    }
    const text_left = PADDING + 8 + art + 10
    const room = mediaButtonLeft(0) - text_left - 6
    text_module.drawText(canvas, state.textOf(bar), state.labelText(&player.*.title), text_left, top + 10, state.ink(bar, 255), room)
    const second: []const u8 = if player.*.artist.length > 0 { state.labelText(&player.*.artist) } else { state.labelText(&player.*.identity) }
    text_module.drawText(canvas, state.smallOf(bar), second, text_left, top + 30, state.ink(bar, 150), room)
    var which: usize = 0
    while which < 3 {
        const left = mediaButtonLeft(which)
        const button_top = top + (MEDIA_HEIGHT - MEDIA_BUTTON) / 2
        if hover == HIT_PREVIOUS + which { popup.light(bar, canvas, left, button_top, MEDIA_BUTTON, MEDIA_BUTTON, MEDIA_BUTTON / 2) }
        var symbol = symbols.PREVIOUS
        if which == 1 { symbol = if player.*.status == state.PLAYING { symbols.PAUSE } else { symbols.PLAY } }
        if which == 2 { symbol = symbols.NEXT }
        state.symbol(bar, canvas, symbol, 0, left + 6, button_top + 6, 18)
        which += 1
    }
}

// When notification `notice` came: "now", "5 min ago", the time today,
// else the date.
fn ago(bar: *Bar, notice: *const Notice, out: [*]u8) -> []const u8 {
    const german = bar.*.german
    const now = if bar.*.fixedTime != 0 { bar.*.fixedTime } else { timezone.now() }
    const seconds = now - notice.*.time
    var length: usize = 0
    if seconds < 60 {
        length = state.put(out, 0, if german { "jetzt" } else { "now" })
    } else if seconds < 3600 {
        if german { length = state.put(out, 0, "vor ") }
        length = state.putNumber(out, length, seconds / 60, 1)
        length = state.put(out, length, if german { " Min." } else { " min ago" })
    } else {
        const local = notice.*.time + timezone.offsetAt(state.zoneOf(bar), notice.*.time)
        const today = (now + timezone.offsetAt(state.zoneOf(bar), now)) / 86400
        const time = timezone.civil(local)
        if local / 86400 == today {
            length = state.putNumber(out, 0, time.hour, 2)
            length = state.put(out, length, ":")
            length = state.putNumber(out, length, time.minute, 2)
        } else {
            length = state.putNumber(out, 0, time.day, 1)
            length = state.put(out, length, ".")
            length = state.putNumber(out, length, time.month, 1)
            length = state.put(out, length, ".")
        }
    }
    return out[0..length]
}

// The app's icon (its desktop entry's, by the icon or the app's name),
// else a tile with its first letter.
fn noticeIcon(bar: *Bar, canvas: *Canvas, notice: *const Notice, x: i32, y: i32) -> void {
    const apps = state.appsOf(bar)
    var found = apps_module.find(apps, notices_module.iconOf(notice))
    if found >= apps.*.count { found = apps_module.find(apps, notices_module.appOf(notice)) }
    if found < apps.*.count {
        const app = apps_module.appAt(apps, found)
        if apps_module.loadIcon(apps, app, @intCast(usize, NOTICE_ICON)) {
            canvas_module.drawImage(canvas, apps_module.imageOf(app), x, y, NOTICE_ICON, 255)
            return
        }
    }
    const name = notices_module.appOf(notice)
    canvas_module.fillRoundedRect(canvas, x, y, NOTICE_ICON, NOTICE_ICON, 8, apps_module.tileColor(name))
    if name.length > 0 {
        var letter: [1]u8 = [1]u8{ name[0] }
        if letter[0] >= 97 && letter[0] <= 122 { letter[0] -= 32 }
        const bytes: [*]const u8 = &letter
        const width = text_module.measure(state.boldOf(bar), bytes[0..1])
        text_module.drawText(canvas, state.boldOf(bar), bytes[0..1], x + (NOTICE_ICON - width) / 2, y + (NOTICE_ICON - 17) / 2, state.ink(bar, 255), 0)
    }
}

fn drawNotice(bar: *Bar, canvas: *Canvas, index: usize) -> void {
    const notice = notices_module.at(noticesOf(bar), index)
    const top = noticeTop(bar, index)
    const hover = bar.*.popupHover
    const lit = hover == HIT_NOTICE + index || hover == HIT_CLOSE + index
    canvas_module.fillRoundedRect(canvas, PADDING - 6, top, WIDTH - 2 * PADDING + 12, NOTICE_ROW - 6, 12, state.colorsOf(bar).*.panel)
    if lit { popup.light(bar, canvas, PADDING - 6, top, WIDTH - 2 * PADDING + 12, NOTICE_ROW - 6, 12) }
    noticeIcon(bar, canvas, notice, PADDING + 2, top + 10)
    const text_left = PADDING + NOTICE_ICON + 12
    var when_bytes: [32]u8 = undefined
    const out: [*]u8 = &when_bytes
    const when = ago(bar, notice, out)
    const when_width = text_module.measure(state.smallOf(bar), when)
    const right = WIDTH - PADDING - 4
    // The close button takes the time's place under the pointer.
    if lit {
        const close_left = WIDTH - PADDING - CLOSE_SIZE
        const close_top = top + 6
        canvas_module.fillRoundedRect(canvas, close_left, close_top, CLOSE_SIZE, CLOSE_SIZE, CLOSE_SIZE / 2, if hover == HIT_CLOSE + index { canvas_module.color(255, 110, 110, 120) } else { state.ink(bar, 90) })
        state.symbol(bar, canvas, symbols.CLOSE, 0, close_left + 5, close_top + 5, 12)
    } else {
        text_module.drawText(canvas, state.smallOf(bar), when, right - when_width, top + 9, state.ink(bar, 130), 0)
    }
    const title_room = right - when_width - 8 - text_left
    text_module.drawText(canvas, state.boldOf(bar), notices_module.summaryOf(notice), text_left, top + 7, state.ink(bar, 255), title_room)
    // The body (else the app's name), one line.
    const body = notices_module.bodyOf(notice)
    const second = if body.length > 0 { body } else { notices_module.appOf(notice) }
    text_module.drawText(canvas, state.smallOf(bar), second, text_left, top + 30, state.ink(bar, 170), right - text_left)
}

fn drawList(bar: *Bar, canvas: *Canvas) -> void {
    const german = bar.*.german
    const notices = noticesOf(bar)
    const list = listTop(bar)
    canvas_module.fillRect(canvas, 12, list - 6, WIDTH - 24, 1, state.ink(bar, 50))
    popup.heading(bar, canvas, if german { "Mitteilungen" } else { "Notifications" }, list + 6)
    if notices.*.count == 0 {
        text_module.drawText(canvas, state.smallOf(bar), if german { "Keine Mitteilungen" } else { "No notifications" }, PADDING, list + SECTION + 10, state.ink(bar, 140), 0)
        return
    }
    // Clear all, at the heading's right.
    const left = clearLeft(bar)
    if bar.*.popupHover == HIT_CLEAR { popup.light(bar, canvas, left - 2, list + 1, WIDTH - PADDING - left + 6, SECTION - 8, 8) }
    text_module.drawText(canvas, state.smallOf(bar), clearLabel(bar), left + 4, list + 6, state.link(bar), 0)
    // Cleared: they fade out.
    var opacity: u32 = 255
    if bar.*.clearingAt != 0 {
        const t = state.popupAlong(bar, bar.*.clearingAt, FADE)
        opacity = @intCast(u32, (1024 - t) * 255 / 1024)
        bar.*.popupMoving = true
    }
    canvas_module.setOpacity(canvas, opacity)
    var index: usize = 0
    while index < shownNotices(bar) {
        drawNotice(bar, canvas, index)
        index += 1
    }
    if notices.*.count > SHOWN {
        var more: [48]u8 = undefined
        const bytes: [*]u8 = &more
        var length: usize = 0
        if german { length = state.put(bytes, 0, "und ") }
        length = state.putNumber(bytes, length, @intCast(i64, notices.*.count - SHOWN), 1)
        length = state.put(bytes, length, if german { " weitere" } else { " more" })
        text_module.drawText(canvas, state.smallOf(bar), bytes[0..length], PADDING, list + SECTION + @intCast(i32, SHOWN) * NOTICE_ROW + 2, state.ink(bar, 140), 0)
    }
    canvas_module.setOpacity(canvas, 255)
}

// The Wi-Fi networks under the tiles: each with its signal, a lock when it
// needs a passphrase first, a check when joined (or what is going on with
// it), then the row to the settings. They fade in, and out when closed.
fn drawNetworks(bar: *Bar, canvas: *Canvas) -> void {
    if !bar.*.netListOpen { return }
    const german = bar.*.german
    var opacity = state.popupAlong(bar, bar.*.netListAt, FADE)
    if bar.*.netClosingAt != 0 { opacity = 1024 - state.popupAlong(bar, bar.*.netClosingAt, FADE) }
    canvas_module.setOpacity(canvas, @intCast(u32, opacity * 255 / 1024))
    const top = tilesBottom() + 12
    const height = netListHeight(bar) - 10
    canvas_module.fillRoundedRect(canvas, PADDING, top, WIDTH - 2 * PADDING, height, 12, state.colorsOf(bar).*.panel)
    // The rows slide down a little as they come.
    const slide = (1024 - opacity) * 6 / 1024
    var row: usize = 0
    while row < netRows(bar) {
        const y = top + 6 + slide + @intCast(i32, row) * NET_ROW
        if bar.*.wifiCount == 0 {
            text_module.drawText(canvas, state.smallOf(bar), if german { "Keine Netze in Reichweite" } else { "No networks in sight" }, PADDING + 12, y + 9, state.ink(bar, 140), 0)
        } else {
            const wifi = state.wifiAt(bar, row)
            if bar.*.popupHover == HIT_NET_ROW + row { popup.light(bar, canvas, PADDING + 4, y, WIDTH - 2 * PADDING - 8, NET_ROW - 2, 8) }
            const bars: u32 = if wifi.*.signal >= 75 { 4 } else if wifi.*.signal >= 50 { 3 } else if wifi.*.signal >= 25 { 2 } else { 1 }
            state.symbol(bar, canvas, symbols.WIFI, bars, PADDING + 10, y + 7, 18)
            const right = WIDTH - PADDING - 12
            var note: []const u8 = ""
            if wifi.*.joining { note = if german { "Verbinde …" } else { "Joining …" } }
            if wifi.*.refused && !wifi.*.joining { note = if german { "Passwort falsch" } else { "Wrong passphrase" } }
            const note_width = if note.length > 0 { text_module.measure(state.smallOf(bar), note) + 8 } else { 0 }
            var marks: i32 = 0
            if wifi.*.connected {
                state.symbol(bar, canvas, symbols.CHECK, 0, right - 16, y + 8, 16)
                marks = 22
            } else if wifi.*.security != network.SECURITY_OPEN && !wifi.*.saved {
                state.symbol(bar, canvas, symbols.LOCK, 0, right - 14, y + 9, 14)
                marks = 20
            }
            if note.length > 0 { text_module.drawText(canvas, state.smallOf(bar), note, right - marks - note_width + 4, y + 9, state.ink(bar, 150), 0) }
            const text_left = PADDING + 36
            text_module.drawText(canvas, state.textOf(bar), state.labelText(&wifi.*.ssid), text_left, y + 8, state.ink(bar, if wifi.*.security == network.SECURITY_OTHER { 140 } else { 255 }), right - marks - note_width - text_left - 4)
        }
        row += 1
    }
    // The settings.
    const settings_y = top + 6 + slide + @intCast(i32, netRows(bar)) * NET_ROW
    if bar.*.popupHover == HIT_NET_SETTINGS { popup.light(bar, canvas, PADDING + 4, settings_y, WIDTH - 2 * PADDING - 8, NET_ROW - 2, 8) }
    canvas_module.fillRect(canvas, PADDING + 10, settings_y - 2, WIDTH - 2 * PADDING - 20, 1, state.ink(bar, 40))
    text_module.drawText(canvas, state.smallOf(bar), if german { "Netzwerkeinstellungen …" } else { "Network settings …" }, PADDING + 12, settings_y + 9, state.link(bar), 0)
    canvas_module.setOpacity(canvas, 255)
}

pub fn draw(bar: *Bar, canvas: *Canvas) -> void {
    popup.frame(bar, canvas, if bar.*.german { "Kontrollzentrum" } else { "Control Centre" })
    drawTiles(bar, canvas)
    drawNetworks(bar, canvas)
    if hasVolume(bar) { drawVolume(bar, canvas) }
    if hasMedia(bar) { drawMedia(bar, canvas) }
    drawList(bar, canvas)
}
