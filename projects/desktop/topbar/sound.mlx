// The volume: MLX Audio's output, through std.audio (STATUS and SET, which
// take the MLXIPC permission audio.control; unsandboxed apps have it).
// While MLX Audio runs (org.mlx.Audio has an owner on the bus) the bar
// shows a speaker with as many waves as it is loud, crossed out when
// muted: the wheel over it turns the volume by 5%, a middle click mutes,
// a click opens a popup with the output's name, a slider (click or drag)
// and the mute switch. The state is asked every POLL milliseconds, every
// POLL_OPEN while the popup is open (mlx-settings may change it too).
const std = @import("std")
const audio = @import("std.audio")
const state = @import("./state.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")

const Bar = state.Bar
const Canvas = state.Canvas

pub const WIDGET: i32 = 28
const POLL: usize = 3000
const POLL_OPEN: usize = 500
const STATE_SIZE: usize = 32768
const STEP: u32 = 3277
const MAXIMUM: u32 = 65536

pub const WIDTH: i32 = 300
pub const HEIGHT: i32 = 124
const PADDING: i32 = 16
const SLIDER_TOP: i32 = 52
const SLIDER_LEFT: i32 = PADDING + 30
const SLIDER_RIGHT: i32 = WIDTH - PADDING - 48
const SWITCH_TOP: i32 = 86

pub const HIT_SLIDER: usize = 1
pub const HIT_MUTE: usize = 2

fn connection(bar: *Bar) -> *audio.Audio {
    unsafe { return @ptrFromInt(*audio.Audio, bar.*.audio) }
}

// org.mlx.Audio got (or lost) its owner.
pub fn ownerChanged(bar: *Bar, owned: bool) -> void {
    bar.*.audioOwned = owned
    if !owned {
        if bar.*.audioUp { audio.disconnect(connection(bar)) }
        bar.*.audioUp = false
        state.barChanged(bar)
        return
    }
    if bar.*.audioUp { return }
    if bar.*.audio == 0 {
        const memory = bar.*.allocator.alloc(@sizeOf(audio.Audio), 16)
        const buffer = bar.*.allocator.alloc(STATE_SIZE, 16)
        if memory == null || buffer == null { return }
        bar.*.audio = @intFromPtr(memory.?)
        bar.*.soundState = buffer.?
    }
    bar.*.audioUp = audio.connect(connection(bar), bar.*.allocator, bar.*.environment) == audio.OK
    if !bar.*.audioUp { return }
    state.say(bar, "topbar: MLX Audio\n")
    bar.*.soundAt = 0
    poll(bar)
}

fn number(text: []const u8) -> u32 {
    var value: u32 = 0
    for byte in text {
        if byte >= 48 && byte <= 57 { value = value * 10 + @intCast(u32, byte - 48) }
    }
    return value
}

// The field `index` of a tab-separated value.
fn part(text: []const u8, index: usize) -> []const u8 {
    var at: usize = 0
    var field: usize = 0
    while field < index {
        while at < text.length && text[at] != 9 { at += 1 }
        if at < text.length { at += 1 }
        field += 1
    }
    var end = at
    while end < text.length && text[end] != 9 { end += 1 }
    return text[at..end]
}

// STATE's lines: the volume, mute, and the output's name (its device's
// label; for "auto" the first card's).
fn parse(bar: *Bar, text: []const u8) -> void {
    var spec: []const u8 = text[0..0]
    var first: []const u8 = text[0..0]
    var chosen: []const u8 = text[0..0]
    var at: usize = 0
    // Two passes: the output spec comes before or after the devices.
    var pass: usize = 0
    while pass < 2 {
        at = 0
        while at < text.length {
            var end = at
            while end < text.length && text[end] != 10 { end += 1 }
            const line = text[at..end]
            var equals: usize = 0
            while equals + 2 < line.length && !(line[equals] == 32 && line[equals + 1] == 61 && line[equals + 2] == 32) { equals += 1 }
            if equals + 2 < line.length {
                const key = line[0..equals]
                const value = line[equals + 3..line.length]
                if pass == 0 {
                    if state.same(key, "volume") { bar.*.volume = number(value) }
                    if state.same(key, "mute") { bar.*.mute = state.same(value, "1") }
                    if state.same(key, "output") { spec = value }
                } else if state.same(key, "device") && state.same(part(value, 0), "p") {
                    if first.length == 0 { first = part(value, 2) }
                    if spec.length > 5 && state.same(spec[5..spec.length], part(value, 1)) { chosen = part(value, 2) }
                }
            }
            at = end + 1
        }
        pass += 1
    }
    const output = state.outputOf(bar)
    if chosen.length > 0 {
        state.labelSet(output, chosen)
    } else if state.same(spec, "null") {
        state.labelSet(output, if bar.*.german { "Keine Ausgabe" } else { "No output" })
    } else if first.length > 0 {
        state.labelSet(output, first)
    } else {
        state.labelSet(output, "MLX Audio")
    }
}

// Asks for the state when it is time (or `now`).
pub fn tick(bar: *Bar) -> void {
    if !bar.*.audioUp { return }
    const every = if bar.*.popup == state.POPUP_SOUND { POLL_OPEN } else { POLL }
    if bar.*.soundAt != 0 && state.milliseconds() - bar.*.soundAt < every { return }
    poll(bar)
}

fn poll(bar: *Bar) -> void {
    bar.*.soundAt = state.milliseconds()
    const volume = bar.*.volume
    const mute = bar.*.mute
    const length = audio.status(connection(bar), bar.*.soundState, STATE_SIZE, 500)
    if length == 0 {
        if !connection(bar).*.connected {
            bar.*.audioUp = false
            state.barChanged(bar)
        }
        return
    }
    parse(bar, bar.*.soundState[0..length])
    if volume != bar.*.volume || mute != bar.*.mute {
        state.barChanged(bar)
        state.popupChanged(bar)
    }
}

pub fn setVolume(bar: *Bar, value: u32) -> void {
    if !bar.*.audioUp { return }
    var volume = value
    if volume > MAXIMUM { volume = MAXIMUM }
    bar.*.volume = volume
    if !audio.set(connection(bar), audio.SET_VOLUME, volume, 0, "") { bar.*.audioUp = false }
    if bar.*.mute && volume > 0 { setMute(bar, false) }
    state.say(bar, "topbar: volume ")
    state.sayNumber(bar, @intCast(i64, (volume * 100 + 32768) / 65536))
    state.say(bar, "%\n")
    state.barChanged(bar)
    state.popupChanged(bar)
}

pub fn setMute(bar: *Bar, mute: bool) -> void {
    if !bar.*.audioUp { return }
    bar.*.mute = mute
    if !audio.set(connection(bar), audio.SET_MUTE, if mute { 1 } else { 0 }, 0, "") { bar.*.audioUp = false }
    state.say(bar, if mute { "topbar: muted\n" } else { "topbar: not muted\n" })
    state.barChanged(bar)
    state.popupChanged(bar)
}

// The wheel over the speaker: a notch up is louder.
pub fn wheel(bar: *Bar, steps: i32) -> void {
    if steps < 0 {
        setVolume(bar, bar.*.volume + STEP)
    } else if bar.*.volume > STEP {
        setVolume(bar, bar.*.volume - STEP)
    } else {
        setVolume(bar, 0)
    }
}

pub fn widgetWidth(bar: *Bar) -> i32 { return if bar.*.audioUp { WIDGET } else { 0 } }

pub fn drawWidget(bar: *Bar, canvas: *Canvas, left: i32) -> void {
    if !bar.*.audioUp { return }
    if bar.*.hoverWidget == state.WIDGET_SOUND || bar.*.popup == state.POPUP_SOUND { canvas_module.fillRoundedRect(canvas, left, 3, WIDGET, state.HEIGHT - 6, 6, canvas_module.color(40, 255, 255, 255)) }
    drawGlyph(canvas, left + 4, (state.HEIGHT - 16) / 2, bar.*.volume, bar.*.mute, state.TEXT_COLOR)
}

// The speaker's waves as arcs: rows of the right halves of rings.
fn drawGlyph(canvas: *Canvas, x: i32, y: i32, volume: u32, mute: bool, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y + 5, 4, 6, color)
    state.fillTriangle(canvas, x + 3, y + 8, x + 9, y + 1, x + 9, y + 15, color)
    canvas_module.fillRect(canvas, x + 3, y + 5, 4, 6, color)
    if mute {
        var step: i32 = 0
        while step < 7 {
            canvas_module.fillRect(canvas, x + 12 + step, y + 4 + step, 2, 2, color)
            canvas_module.fillRect(canvas, x + 18 - step, y + 4 + step, 2, 2, color)
            step += 1
        }
        return
    }
    const waves = if volume == 0 { 0 } else if volume < 22000 { 1 } else if volume < 44000 { 2 } else { 3 }
    var wave: i32 = 0
    while wave < waves {
        // An arc around (x + 6, y + 8) of radius 6, 10, 14, two pixels
        // thick, as far up and down as it goes right (rows of it).
        const radius = 6 + wave * 4
        const inside = radius - 2
        var row = 0 - radius
        while row <= radius {
            var outer: i32 = 0
            while (outer + 1) * (outer + 1) + row * row <= radius * radius { outer += 1 }
            var inner: i32 = 0
            while inner * inner + row * row < inside * inside { inner += 1 }
            const steep = if row < 0 { 0 - row } else { row }
            if steep > inner { inner = steep }
            if outer >= inner { canvas_module.fillRect(canvas, x + 6 + inner, y + 8 + row, outer - inner + 1, 1, color) }
            row += 1
        }
        wave += 1
    }
}

// ---------------------------------------------------------------------------
// The popup

pub fn opened(bar: *Bar) -> void { poll(bar) }

pub fn hit(x: i32, y: i32) -> usize {
    if y >= SLIDER_TOP - 10 && y < SLIDER_TOP + 14 && x >= SLIDER_LEFT - 8 && x < SLIDER_RIGHT + 8 { return HIT_SLIDER }
    if y >= SWITCH_TOP - 4 && y < SWITCH_TOP + 26 && x >= PADDING && x < WIDTH - PADDING { return HIT_MUTE }
    return state.NONE
}

// The slider where the pointer is.
pub fn slide(bar: *Bar, x: i32) -> void {
    var at = x - SLIDER_LEFT
    if at < 0 { at = 0 }
    if at > SLIDER_RIGHT - SLIDER_LEFT { at = SLIDER_RIGHT - SLIDER_LEFT }
    setVolume(bar, @intCast(u32, @intCast(i64, at) * @intCast(i64, MAXIMUM) / @intCast(i64, SLIDER_RIGHT - SLIDER_LEFT)))
}

pub fn press(bar: *Bar) -> void {
    if bar.*.popupHover == HIT_SLIDER {
        bar.*.dragging = true
        slide(bar, bar.*.popupX)
    } else if bar.*.popupHover == HIT_MUTE {
        setMute(bar, !bar.*.mute)
    }
}

pub fn draw(bar: *Bar, canvas: *Canvas) -> void {
    canvas_module.clear(canvas, 0)
    canvas_module.fillRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, state.POPUP_RADIUS, state.POPUP_BACKGROUND)
    canvas_module.strokeRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, state.POPUP_RADIUS, 1, canvas_module.color(60, 255, 255, 255))
    const dim = canvas_module.color(150, 255, 255, 255)
    text_module.drawText(canvas, state.boldOf(bar), if bar.*.german { "Lautstärke" } else { "Sound" }, PADDING, 14, state.TEXT_COLOR, 0)
    const output = state.labelText(state.outputOf(bar))
    const output_width = text_module.measure(state.smallOf(bar), output)
    const output_left = if WIDTH - PADDING - output_width > 120 { WIDTH - PADDING - output_width } else { 120 }
    text_module.drawText(canvas, state.smallOf(bar), output, output_left, 17, dim, WIDTH - PADDING - output_left)
    // The slider: a speaker, the line, the percent.
    drawGlyph(canvas, PADDING, SLIDER_TOP - 6, bar.*.volume, bar.*.mute, state.TEXT_COLOR)
    const length = SLIDER_RIGHT - SLIDER_LEFT
    var volume = bar.*.volume
    if volume > MAXIMUM { volume = MAXIMUM }
    const done = @intCast(i32, @intCast(i64, length) * @intCast(i64, volume) / @intCast(i64, MAXIMUM))
    canvas_module.fillRoundedRect(canvas, SLIDER_LEFT, SLIDER_TOP, length, 4, 2, canvas_module.color(60, 255, 255, 255))
    canvas_module.fillRoundedRect(canvas, SLIDER_LEFT, SLIDER_TOP, done, 4, 2, if bar.*.mute { dim } else { state.ACCENT })
    const knob = if bar.*.popupHover == HIT_SLIDER || bar.*.dragging { 16 } else { 14 }
    canvas_module.fillRoundedRect(canvas, SLIDER_LEFT + done - knob / 2, SLIDER_TOP + 2 - knob / 2, knob, knob, knob / 2, state.TEXT_COLOR)
    var percent: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &percent) }
    var count = state.putNumber(bytes, 0, @intCast(i64, (volume * 100 + 32768) / 65536), 1)
    count = state.put(bytes, count, " %")
    text_module.drawText(canvas, state.textOf(bar), bytes[0..count], SLIDER_RIGHT + 14, SLIDER_TOP - 7, state.TEXT_COLOR, 0)
    // The mute switch.
    if bar.*.popupHover == HIT_MUTE { canvas_module.fillRoundedRect(canvas, PADDING - 6, SWITCH_TOP - 4, WIDTH - 2 * PADDING + 12, 30, 8, canvas_module.color(30, 255, 255, 255)) }
    text_module.drawText(canvas, state.textOf(bar), if bar.*.german { "Stumm" } else { "Mute" }, PADDING, SWITCH_TOP + 3, state.TEXT_COLOR, 0)
    const switch_left = WIDTH - PADDING - 40
    canvas_module.fillRoundedRect(canvas, switch_left, SWITCH_TOP, 40, 22, 11, if bar.*.mute { state.ACCENT } else { canvas_module.color(70, 255, 255, 255) })
    canvas_module.fillRoundedRect(canvas, if bar.*.mute { switch_left + 20 } else { switch_left + 2 }, SWITCH_TOP + 2, 18, 18, 9, state.TEXT_COLOR)
}
