// The volume: MLX Audio's output, through std.audio (STATUS and SET, which
// take the MLXIPC permission audio.control; unsandboxed apps have it).
// While MLX Audio runs (org.mlx.Audio has an owner on the bus) the bar
// shows a speaker with as many waves as it is loud, crossed out when
// muted: the wheel over it turns the volume by 5%, a middle click mutes.
//
// A click opens the popup, laid out as the dock's folder stacks: under
// its header (its button opens mlx-settings' Sound page) the output's
// volume (the speaker mutes, the slider is clicked or dragged), the
// outputs to choose from (automatic or a sound card), and the apps MLX
// Audio knows as a grid of their icons with their names, each with its
// own slider; a click on an app's icon mutes it, the wheel over it turns
// it. The state is asked every POLL milliseconds, every POLL_OPEN while
// the popup is open (mlx-settings may change it too).
const std = @import("std")
const audio = @import("std.audio")
const state = @import("./state.mlx")
const anim = @import("../shared/anim.mlx")
const popup = @import("./popup.mlx")
const symbols = @import("../shared/symbols.mlx")
const apps_module = @import("../shared/apps.mlx")
const icons = @import("../shared/icons.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")

const Bar = state.Bar
const Canvas = state.Canvas

pub const WIDGET: i32 = 28
const POLL: usize = 3000
const POLL_OPEN: usize = 500
const STATE_SIZE: usize = 32768
const STEP: u32 = 3277
const MAXIMUM: u32 = 65536

// The popup.
pub const WIDTH: i32 = 360
const PADDING: i32 = 16
const MASTER_TOP: i32 = 56
const MUTE_SIZE: i32 = 30
const SLIDER_LEFT: i32 = PADDING + MUTE_SIZE + 14
const SLIDER_RIGHT: i32 = WIDTH - PADDING - 52
const SLIDER_Y: i32 = MASTER_TOP + 14
const SECTION: i32 = 22
const ROW: i32 = 30
const COLUMNS: i32 = 4
const CELL_WIDTH: i32 = (WIDTH - 2 * PADDING) / COLUMNS
const CELL_HEIGHT: i32 = 96
const ICON: i32 = 40
const NONE_HEIGHT: i32 = 40

// What the pointer is over (popupHover).
pub const HIT_SLIDER: usize = 1
pub const HIT_MUTE: usize = 2
pub const HIT_DEVICE: usize = 100
pub const HIT_APP: usize = 200
pub const HIT_APP_SLIDER: usize = 300

fn connection(bar: *Bar) -> *audio.Audio {
    unsafe { return @ptrFromInt(*audio.Audio, bar.*.audio) }
}

// org.mlx.Audio got (or lost) its owner.
pub fn ownerChanged(bar: *Bar, owned: bool) -> void {
    bar.*.audioOwned = owned
    if !owned {
        if bar.*.audioUp { audio.disconnect(connection(bar)) }
        bar.*.audioUp = false
        state.barChanged(bar)
        return
    }
    if bar.*.audioUp { return }
    if bar.*.audio == 0 {
        const memory = bar.*.allocator.alloc(@sizeOf(audio.Audio), 16)
        const buffer = bar.*.allocator.alloc(STATE_SIZE, 16)
        if memory == null || buffer == null { return }
        bar.*.audio = @intFromPtr(memory.?)
        bar.*.soundState = buffer.?
    }
    bar.*.audioUp = audio.connect(connection(bar), bar.*.allocator, bar.*.environment) == audio.OK
    if !bar.*.audioUp { return }
    state.say(bar, "topbar: MLX Audio\n")
    bar.*.soundAt = 0
    poll(bar)
    anim.jump(state.volumeShownOf(bar), @intCast(i32, bar.*.volume))
}

fn number(text: []const u8) -> u32 {
    var value: u32 = 0
    for byte in text {
        if byte >= 48 && byte <= 57 { value = value * 10 + @intCast(u32, byte - 48) }
    }
    return value
}

// The field `index` of a tab-separated value.
fn part(text: []const u8, index: usize) -> []const u8 {
    var at: usize = 0
    var field: usize = 0
    while field < index {
        while at < text.length && text[at] != 9 { at += 1 }
        if at < text.length { at += 1 }
        field += 1
    }
    var end = at
    while end < text.length && text[end] != 9 { end += 1 }
    return text[at..end]
}

fn findApp(bar: *Bar, name: []const u8) -> usize {
    var index: usize = 0
    while index < bar.*.soundAppCount {
        if state.same(state.labelText(&state.soundAppAt(bar, index).*.name), name) { return index }
        index += 1
    }
    return state.NONE
}

// STATE's lines: the volume and mute, the output asked for and the
// playback devices, the apps (and which of them play).
fn parse(bar: *Bar, text: []const u8) -> void {
    bar.*.deviceCount = 0
    bar.*.soundAppCount = 0
    state.labelClear(&bar.*.outputSpec)
    var at: usize = 0
    // Twice: apps first, then their streams.
    var pass: usize = 0
    while pass < 2 {
        at = 0
        while at < text.length {
            var end = at
            while end < text.length && text[end] != 10 { end += 1 }
            const line = text[at..end]
            var equals: usize = 0
            while equals + 2 < line.length && !(line[equals] == 32 && line[equals + 1] == 61 && line[equals + 2] == 32) { equals += 1 }
            if equals + 2 < line.length {
                const key = line[0..equals]
                const value = line[equals + 3..line.length]
                if pass == 0 {
                    if state.same(key, "volume") { bar.*.volume = number(value) }
                    if state.same(key, "mute") { bar.*.mute = state.same(value, "1") }
                    if state.same(key, "output") { state.labelSet(&bar.*.outputSpec, value) }
                    if state.same(key, "device") && state.same(part(value, 0), "p") && bar.*.deviceCount < 8 {
                        const device = state.deviceAt(bar, bar.*.deviceCount)
                        state.labelSet(&device.*.name, part(value, 1))
                        state.labelSet(&device.*.label, part(value, 2))
                        bar.*.deviceCount += 1
                    }
                    if state.same(key, "app") && bar.*.soundAppCount < 16 {
                        const app = state.soundAppAt(bar, bar.*.soundAppCount)
                        state.labelSet(&app.*.name, part(value, 0))
                        app.*.volume = number(part(value, 1))
                        app.*.mute = state.same(part(value, 2), "1")
                        app.*.playing = false
                        bar.*.soundAppCount += 1
                    }
                } else if state.same(key, "stream") && state.same(part(value, 2), "play") {
                    const index = findApp(bar, part(value, 1))
                    if index != state.NONE {
                        state.soundAppAt(bar, index).*.playing = true
                    } else if bar.*.soundAppCount < 16 {
                        // Playing without settings of its own yet.
                        const app = state.soundAppAt(bar, bar.*.soundAppCount)
                        state.labelSet(&app.*.name, part(value, 1))
                        app.*.volume = MAXIMUM
                        app.*.mute = false
                        app.*.playing = true
                        bar.*.soundAppCount += 1
                    }
                }
            }
            at = end + 1
        }
        pass += 1
    }
    // The output's name: its card's label (for "auto" the first card's).
    const spec = state.labelText(&bar.*.outputSpec)
    const output = state.outputOf(bar)
    state.labelSet(output, "MLX Audio")
    if bar.*.deviceCount > 0 { state.labelSet(output, state.labelText(&state.deviceAt(bar, 0).*.label)) }
    if state.same(spec, "null") { state.labelSet(output, if bar.*.german { "Keine Ausgabe" } else { "No output" }) }
    var index: usize = 0
    while index < bar.*.deviceCount {
        const device = state.deviceAt(bar, index)
        if spec.length > 5 && state.same(spec[5..spec.length], state.labelText(&device.*.name)) { state.labelSet(output, state.labelText(&device.*.label)) }
        index += 1
    }
}

// Asks for the state when it is time.
pub fn tick(bar: *Bar) -> void {
    if !bar.*.audioUp { return }
    const every = if bar.*.popup == state.POPUP_SOUND { POLL_OPEN } else { POLL }
    if bar.*.soundAt != 0 && state.milliseconds() - bar.*.soundAt < every { return }
    poll(bar)
}

fn poll(bar: *Bar) -> void {
    bar.*.soundAt = state.milliseconds()
    const length = audio.status(connection(bar), bar.*.soundState, STATE_SIZE, 500)
    if length == 0 {
        if !connection(bar).*.connected {
            bar.*.audioUp = false
            state.barChanged(bar)
        }
        return
    }
    parse(bar, bar.*.soundState[0..length])
    if !bar.*.dragging { anim.set(state.volumeShownOf(bar), @intCast(i32, bar.*.volume), 200) }
    state.barChanged(bar)
    state.popupChanged(bar)
    // The popup grows or shrinks with the outputs and apps.
    if bar.*.popup == state.POPUP_SOUND { popup.resize(bar, bar.*.widgetLeft[state.WIDGET_SOUND] + bar.*.widgetWidth[state.WIDGET_SOUND] / 2, WIDTH, height(bar)) }
}

fn percentOf(volume: u32) -> i64 { return @intCast(i64, (volume * 100 + 32768) / 65536) }

pub fn setVolume(bar: *Bar, value: u32) -> void {
    if !bar.*.audioUp { return }
    var volume = value
    if volume > MAXIMUM { volume = MAXIMUM }
    bar.*.volume = volume
    if bar.*.dragging { anim.jump(state.volumeShownOf(bar), @intCast(i32, volume)) } else { anim.set(state.volumeShownOf(bar), @intCast(i32, volume), 160) }
    if !audio.set(connection(bar), audio.SET_VOLUME, volume, 0, "") { bar.*.audioUp = false }
    if bar.*.mute && volume > 0 { setMute(bar, false) }
    state.say(bar, "topbar: volume ")
    state.sayNumber(bar, percentOf(volume))
    state.say(bar, "%\n")
    state.barChanged(bar)
    state.popupChanged(bar)
}

pub fn setMute(bar: *Bar, mute: bool) -> void {
    if !bar.*.audioUp { return }
    bar.*.mute = mute
    if !audio.set(connection(bar), audio.SET_MUTE, if mute { 1 } else { 0 }, 0, "") { bar.*.audioUp = false }
    state.say(bar, if mute { "topbar: muted\n" } else { "topbar: not muted\n" })
    state.barChanged(bar)
    state.popupChanged(bar)
}

fn setAppVolume(bar: *Bar, index: usize, value: u32) -> void {
    if !bar.*.audioUp || index >= bar.*.soundAppCount { return }
    const app = state.soundAppAt(bar, index)
    var volume = value
    if volume > MAXIMUM { volume = MAXIMUM }
    app.*.volume = volume
    if !audio.set(connection(bar), audio.SET_APP_VOLUME, volume, 0, state.labelText(&app.*.name)) { bar.*.audioUp = false }
    state.say(bar, "topbar: volume of ")
    state.say(bar, state.labelText(&app.*.name))
    state.say(bar, " ")
    state.sayNumber(bar, percentOf(volume))
    state.say(bar, "%\n")
    state.popupChanged(bar)
}

fn setAppMute(bar: *Bar, index: usize, mute: bool) -> void {
    if !bar.*.audioUp || index >= bar.*.soundAppCount { return }
    const app = state.soundAppAt(bar, index)
    app.*.mute = mute
    if !audio.set(connection(bar), audio.SET_APP_MUTE, if mute { 1 } else { 0 }, 0, state.labelText(&app.*.name)) { bar.*.audioUp = false }
    state.say(bar, if mute { "topbar: muted " } else { "topbar: not muted " })
    state.say(bar, state.labelText(&app.*.name))
    state.say(bar, "\n")
    state.popupChanged(bar)
}

// Output `index` (0: automatic, 1 + i: device i).
fn chooseOutput(bar: *Bar, index: usize) -> void {
    if !bar.*.audioUp { return }
    var spec: state.Label = undefined
    state.labelSet(&spec, "auto")
    if index > 0 && index <= bar.*.deviceCount {
        state.labelSet(&spec, "alsa:")
        state.labelAdd(&spec, state.labelText(&state.deviceAt(bar, index - 1).*.name))
    }
    if !audio.set(connection(bar), audio.SET_OUTPUT, 0, 0, state.labelText(&spec)) { bar.*.audioUp = false }
    state.labelSet(&bar.*.outputSpec, state.labelText(&spec))
    state.say(bar, "topbar: output ")
    state.say(bar, state.labelText(&spec))
    state.say(bar, "\n")
    state.popupChanged(bar)
    bar.*.soundAt = 0
}

// The wheel over the speaker: a notch up is louder.
pub fn wheel(bar: *Bar, steps: i32) -> void {
    if steps < 0 {
        setVolume(bar, bar.*.volume + STEP)
    } else if bar.*.volume > STEP {
        setVolume(bar, bar.*.volume - STEP)
    } else {
        setVolume(bar, 0)
    }
}

pub fn widgetWidth(bar: *Bar) -> i32 { return if bar.*.audioUp { WIDGET } else { 0 } }

// The speaker's waves for `volume`.
fn waves(volume: i32, mute: bool) -> u32 {
    if mute { return symbols.MUTED }
    if volume <= 0 { return 0 }
    if volume < 21845 { return 1 }
    if volume < 43690 { return 2 }
    return 3
}

pub fn drawWidget(bar: *Bar, canvas: *Canvas, left: i32) -> void {
    if !bar.*.audioUp { return }
    const light = state.glided(bar, state.lightOf(bar, state.WIDGET_SOUND))
    const lit = if bar.*.popup == state.POPUP_SOUND { 255 } else { light }
    if lit > 0 { canvas_module.fillRoundedRect(canvas, left, 3, WIDGET, state.HEIGHT - 6, 6, canvas_module.color(@intCast(u32, lit * 40 / 255), 255, 255, 255)) }
    const volume = state.glided(bar, state.volumeShownOf(bar))
    symbols.draw(state.symbolsOf(bar), canvas, symbols.SPEAKER, waves(volume, bar.*.mute), left + 4, (state.HEIGHT - 20) / 2, 20, 4294967295)
}

// ---------------------------------------------------------------------------
// The popup

fn devicesTop() -> i32 { return MASTER_TOP + 44 }

fn rowsOfDevices(bar: *Bar) -> i32 { return @intCast(i32, bar.*.deviceCount) + 1 }

fn appsTop(bar: *Bar) -> i32 { return devicesTop() + SECTION + rowsOfDevices(bar) * ROW + 10 }

fn appRows(bar: *Bar) -> i32 { return (@intCast(i32, bar.*.soundAppCount) + COLUMNS - 1) / COLUMNS }

pub fn height(bar: *Bar) -> i32 {
    const apps = if bar.*.soundAppCount == 0 { NONE_HEIGHT } else { appRows(bar) * CELL_HEIGHT }
    return appsTop(bar) + SECTION + apps + 8
}

// Before the popup opens: the state now (its size depends on it).
pub fn prepare(bar: *Bar) -> void {
    if bar.*.audioUp { poll(bar) }
}

pub fn opened(bar: *Bar) -> void { anim.jump(state.volumeShownOf(bar), @intCast(i32, bar.*.volume)) }

fn cellLeft(index: usize) -> i32 { return PADDING + @intCast(i32, index % 4) * CELL_WIDTH }
fn cellTop(bar: *Bar, index: usize) -> i32 { return appsTop(bar) + SECTION + @intCast(i32, index / 4) * CELL_HEIGHT }

pub fn hit(bar: *Bar, x: i32, y: i32) -> usize {
    if y >= MASTER_TOP && y < MASTER_TOP + MUTE_SIZE {
        if x >= PADDING && x < PADDING + MUTE_SIZE { return HIT_MUTE }
        if x >= SLIDER_LEFT - 8 && x < SLIDER_RIGHT + 8 { return HIT_SLIDER }
        return state.NONE
    }
    const rows_top = devicesTop() + SECTION
    if y >= rows_top && y < rows_top + rowsOfDevices(bar) * ROW && x >= PADDING && x < WIDTH - PADDING { return HIT_DEVICE + @intCast(usize, (y - rows_top) / ROW) }
    var index: usize = 0
    while index < bar.*.soundAppCount {
        const left = cellLeft(index)
        const top = cellTop(bar, index)
        if x >= left && x < left + CELL_WIDTH && y >= top && y < top + CELL_HEIGHT {
            return if y >= top + 66 { HIT_APP_SLIDER + index } else { HIT_APP + index }
        }
        index += 1
    }
    return state.NONE
}

// A slider's value for x on a line from `from` to `to`.
fn along(x: i32, from: i32, to: i32) -> u32 {
    var at = x - from
    if at < 0 { at = 0 }
    if at > to - from { at = to - from }
    return @intCast(u32, @intCast(i64, at) * @intCast(i64, MAXIMUM) / @intCast(i64, to - from))
}

// The pointer held on a slider moved to x.
pub fn drag(bar: *Bar, x: i32) -> void {
    const target = bar.*.popupHover
    if target == HIT_SLIDER { setVolume(bar, along(x, SLIDER_LEFT, SLIDER_RIGHT)) }
    if target >= HIT_APP_SLIDER && target < HIT_APP_SLIDER + 16 {
        const index = target - HIT_APP_SLIDER
        const left = cellLeft(index)
        setAppVolume(bar, index, along(x, left + 12, left + CELL_WIDTH - 12))
    }
}

pub fn press(bar: *Bar) -> void {
    const target = bar.*.popupHover
    if target == HIT_SLIDER || (target >= HIT_APP_SLIDER && target < HIT_APP_SLIDER + 16) {
        bar.*.dragging = true
        drag(bar, bar.*.popupX)
    } else if target == HIT_MUTE {
        setMute(bar, !bar.*.mute)
    } else if target >= HIT_DEVICE && target < HIT_DEVICE + 9 {
        chooseOutput(bar, target - HIT_DEVICE)
    } else if target >= HIT_APP && target < HIT_APP + 16 {
        const index = target - HIT_APP
        if index < bar.*.soundAppCount { setAppMute(bar, index, !state.soundAppAt(bar, index).*.mute) }
    }
}

// The wheel in the popup: over an app it turns that app, else the output.
pub fn popupWheel(bar: *Bar, steps: i32) -> void {
    const target = bar.*.popupHover
    var index = state.NONE
    if target >= HIT_APP && target < HIT_APP + 16 { index = target - HIT_APP }
    if target >= HIT_APP_SLIDER && target < HIT_APP_SLIDER + 16 { index = target - HIT_APP_SLIDER }
    if index == state.NONE || index >= bar.*.soundAppCount {
        wheel(bar, steps)
        return
    }
    const volume = state.soundAppAt(bar, index).*.volume
    if steps < 0 {
        setAppVolume(bar, index, volume + STEP)
    } else {
        setAppVolume(bar, index, if volume > STEP { volume - STEP } else { 0 })
    }
}

// A slider from `left` to `right` at y, `value` of MAXIMUM along, lit
// (bigger knob) when `lit`, dim when `off`.
fn slider(canvas: *Canvas, left: i32, right: i32, y: i32, value: i32, lit: bool, off: bool, knob: i32) -> void {
    const length = right - left
    var at = value
    if at > @intCast(i32, MAXIMUM) { at = @intCast(i32, MAXIMUM) }
    if at < 0 { at = 0 }
    const done = @intCast(i32, @intCast(i64, length) * @intCast(i64, at) / @intCast(i64, MAXIMUM))
    canvas_module.fillRoundedRect(canvas, left, y - 2, length, 4, 2, canvas_module.color(60, 255, 255, 255))
    canvas_module.fillRoundedRect(canvas, left, y - 2, done, 4, 2, if off { canvas_module.color(150, 255, 255, 255) } else { state.ACCENT })
    const size = if lit { knob + 2 } else { knob }
    canvas_module.fillRoundedRect(canvas, left + done - size / 2, y - size / 2, size, size, size / 2, state.TEXT_COLOR)
}

// An app's icon (its desktop entry's, else a tile with its first letter).
fn appIcon(bar: *Bar, canvas: *Canvas, name: []const u8, x: i32, y: i32, faded: bool) -> void {
    const apps = state.appsOf(bar)
    const found = apps_module.find(apps, name)
    const opacity: u32 = if faded { 110 } else { 255 }
    if found < apps.*.count {
        const app = apps_module.appAt(apps, found)
        if apps_module.loadIcon(apps, app, @intCast(usize, ICON)) {
            canvas_module.drawImage(canvas, apps_module.imageOf(app), x, y, ICON, opacity)
            return
        }
    }
    canvas_module.setOpacity(canvas, opacity)
    canvas_module.fillRoundedRect(canvas, x, y, ICON, ICON, 10, apps_module.tileColor(name))
    if name.length > 0 {
        var letter: [1]u8 = [1]u8{ name[0] }
        if letter[0] >= 97 && letter[0] <= 122 { letter[0] -= 32 }
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrCast([*]const u8, &letter) }
        const width = text_module.measure(state.boldOf(bar), bytes[0..1])
        text_module.drawText(canvas, state.boldOf(bar), bytes[0..1], x + (ICON - width) / 2, y + (ICON - 17) / 2, state.TEXT_COLOR, 0)
    }
    canvas_module.setOpacity(canvas, 255)
}

pub fn draw(bar: *Bar, canvas: *Canvas) -> void {
    const german = bar.*.german
    popup.frame(bar, canvas, if german { "Ton" } else { "Sound" })
    const hover = bar.*.popupHover
    // The output's volume.
    if hover == HIT_MUTE { popup.light(bar, canvas, PADDING - 2, MASTER_TOP - 2, MUTE_SIZE + 4, MUTE_SIZE + 4, 8) }
    const volume = state.popupGlided(bar, state.volumeShownOf(bar))
    symbols.draw(state.symbolsOf(bar), canvas, symbols.SPEAKER, waves(volume, bar.*.mute), PADDING + 3, MASTER_TOP + 3, 24, 4294967295)
    slider(canvas, SLIDER_LEFT, SLIDER_RIGHT, SLIDER_Y, volume, hover == HIT_SLIDER || (bar.*.dragging && hover == HIT_SLIDER), bar.*.mute, 16)
    var percent: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &percent) }
    var count = state.putNumber(bytes, 0, percentOf(@intCast(u32, if volume < 0 { 0 } else { volume })), 1)
    count = state.put(bytes, count, " %")
    text_module.drawText(canvas, state.textOf(bar), bytes[0..count], SLIDER_RIGHT + 16, SLIDER_Y - 8, state.TEXT_COLOR, 0)
    // The outputs.
    popup.heading(bar, canvas, if german { "Ausgabe" } else { "Output" }, devicesTop())
    const spec = state.labelText(&bar.*.outputSpec)
    var row: usize = 0
    while row < bar.*.deviceCount + 1 {
        const top = devicesTop() + SECTION + @intCast(i32, row) * ROW
        if hover == HIT_DEVICE + row { popup.light(bar, canvas, PADDING - 6, top, WIDTH - 2 * PADDING + 12, ROW - 2, 8) }
        var label: []const u8 = if german { "Automatisch" } else { "Automatic" }
        var chosen = state.same(spec, "auto") || spec.length == 0
        if row > 0 {
            const device = state.deviceAt(bar, row - 1)
            label = state.labelText(&device.*.label)
            chosen = spec.length > 5 && state.same(spec[5..spec.length], state.labelText(&device.*.name))
        }
        if chosen { symbols.draw(state.symbolsOf(bar), canvas, symbols.CHECK, 0, PADDING, top + 6, 16, state.ACCENT) }
        text_module.drawText(canvas, state.textOf(bar), label, PADDING + 26, top + 6, state.TEXT_COLOR, WIDTH - 2 * PADDING - 26)
        row += 1
    }
    // The apps, as a stack's grid.
    canvas_module.fillRect(canvas, 12, appsTop(bar) - 6, WIDTH - 24, 1, canvas_module.color(50, 255, 255, 255))
    popup.heading(bar, canvas, "Apps", appsTop(bar))
    if bar.*.soundAppCount == 0 {
        text_module.drawText(canvas, state.smallOf(bar), if german { "Gerade spielt keine App Ton." } else { "No app plays sound right now." }, PADDING, appsTop(bar) + SECTION + 8, canvas_module.color(140, 255, 255, 255), 0)
        return
    }
    var index: usize = 0
    while index < bar.*.soundAppCount {
        const app = state.soundAppAt(bar, index)
        const left = cellLeft(index)
        const top = cellTop(bar, index)
        if hover == HIT_APP + index || hover == HIT_APP_SLIDER + index { popup.light(bar, canvas, left + 3, top + 2, CELL_WIDTH - 6, CELL_HEIGHT - 4, 10) }
        const name = state.labelText(&app.*.name)
        appIcon(bar, canvas, name, left + (CELL_WIDTH - ICON) / 2, top + 8, app.*.mute)
        if app.*.mute { symbols.draw(state.symbolsOf(bar), canvas, symbols.SPEAKER, symbols.MUTED, left + (CELL_WIDTH + ICON) / 2 - 12, top + 34, 18, 4294967295) }
        if app.*.playing { canvas_module.fillRoundedRect(canvas, left + CELL_WIDTH / 2 - 2, top + 3, 4, 4, 2, state.ACCENT) }
        var shown: [100]u8 = undefined
        var shown_bytes: [*]u8 = undefined
        unsafe { shown_bytes = @ptrCast([*]u8, &shown) }
        const fitted = icons.fitText(state.smallOf(bar), name, CELL_WIDTH - 8, shown_bytes)
        text_module.drawText(canvas, state.smallOf(bar), fitted, left + (CELL_WIDTH - text_module.measure(state.smallOf(bar), fitted)) / 2, top + 52, state.TEXT_COLOR, 0)
        slider(canvas, left + 12, left + CELL_WIDTH - 12, top + 80, @intCast(i32, app.*.volume), hover == HIT_APP_SLIDER + index, app.*.mute, 10)
        index += 1
    }
}
