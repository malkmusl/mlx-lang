// The look, dark or light: the color-scheme of org.freedesktop.appearance
// that the portal (mlx-capture --portal, org.freedesktop.portal.Desktop)
// keeps on MLXIPC, as GTK, Qt and Firefox follow it. The bar asks it when
// it comes on the bus (Settings.ReadOne), hears it change (SettingChanged)
// and changes it from the control centre's tile
// (org.mlx.Appearance.SetColorScheme). The bar, its popups and the
// control centre then glide to the other colours (shared/palette.mlx)
// over CHANGE milliseconds. The bar also follows appearance.conf, which
// the portal writes (std.ui.appearance, as every other app of the desktop
// does): a scheme switched while the bar was not on the bus, or without
// the portal, comes that way.
const dbus = @import("std.dbus")
const state = @import("./state.mlx")
const bus = @import("./bus.mlx")
const anim = @import("../shared/anim.mlx")
const palette = @import("../shared/palette.mlx")
const panel_module = @import("std.ui.wayland.panel")
const appearance = @import("std.ui.appearance")

const Bar = state.Bar

pub const PORTAL: []const u8 = "org.freedesktop.portal.Desktop"
const PATH: []const u8 = "/org/freedesktop/portal/desktop"
pub const SETTINGS: []const u8 = "org.freedesktop.portal.Settings"
const OWN: []const u8 = "org.mlx.Appearance"
const NAMESPACE: []const u8 = "org.freedesktop.appearance"
const CHANGE: usize = 450

pub fn init(bar: *Bar) -> void {
    bar.*.scheme = palette.SCHEME_DARK
    bar.*.fileSeen = false
    anim.jump(state.themeOf(bar), 0)
    bar.*.colors = palette.at(0)
}

pub fn isLight(bar: *Bar) -> bool { return bar.*.scheme == palette.SCHEME_LIGHT }

// appearance.conf as the panel follows it: a change there is the look's
// (at once the first time).
pub fn follow(bar: *Bar) -> void {
    const light = appearance.isLight(panel_module.appearanceOf(state.panelOf(bar)))
    if bar.*.fileSeen && light == bar.*.fileLight { return }
    const first = !bar.*.fileSeen
    bar.*.fileSeen = true
    bar.*.fileLight = light
    if light != isLight(bar) { set(bar, if light { palette.SCHEME_LIGHT } else { palette.SCHEME_DARK }, first) }
}

// The look is `scheme` now (gliding there unless `at_once`).
pub fn set(bar: *Bar, scheme: u32, at_once: bool) -> void {
    const before = bar.*.scheme
    bar.*.scheme = scheme
    const target: i32 = if scheme == palette.SCHEME_LIGHT { palette.LIGHT } else { 0 }
    if at_once { anim.jump(state.themeOf(bar), target) } else if state.themeOf(bar).*.to != target { anim.set(state.themeOf(bar), target, CHANGE) }
    if before != scheme {
        state.say(bar, if scheme == palette.SCHEME_LIGHT { "topbar: look light\n" } else { "topbar: look dark\n" })
    }
    // Every symbol is drawn anew in the other ink.
    state.barChanged(bar)
    state.popupChanged(bar)
    state.fastTicks(bar)
}

// Asks the portal (its reply comes to replied).
pub fn ask(bar: *Bar) -> void {
    var body: [128]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 128, false)
    dbus.putString(&writing, NAMESPACE)
    dbus.putString(&writing, "color-scheme")
    bus.call(bar, PORTAL, PATH, SETTINGS, "ReadOne", "ss", bytes, writing.length, bus.PURPOSE_APPEARANCE, 0)
}

// A variant holding the scheme (u); false when it is not one.
fn schemeOf(reading: *dbus.Reader, scheme: *u32) -> bool {
    const signature = dbus.readSignature(reading)
    if !state.same(signature, "u") { return false }
    scheme.* = dbus.readU32(reading)
    return !reading.*.failed
}

// The portal answered (at once: the bar was just started or reconnected).
pub fn replied(bar: *Bar, reading: *dbus.Reader, failed: bool) -> void {
    var scheme: u32 = 0
    if failed || !schemeOf(reading, &scheme) { return }
    set(bar, scheme, true)
}

// SettingChanged(namespace, key, value).
pub fn changed(bar: *Bar, reading: *dbus.Reader) -> void {
    const namespace = dbus.readString(reading)
    const key = dbus.readString(reading)
    if reading.*.failed || !state.same(namespace, NAMESPACE) || !state.same(key, "color-scheme") { return }
    var scheme: u32 = 0
    if schemeOf(reading, &scheme) { set(bar, scheme, false) }
}

// The control centre's tile: the other look, for everyone.
pub fn toggle(bar: *Bar) -> void {
    const scheme = if isLight(bar) { palette.SCHEME_DARK } else { palette.SCHEME_LIGHT }
    set(bar, scheme, false)
    var body: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 8, false)
    dbus.putU32(&writing, scheme)
    bus.call(bar, PORTAL, PATH, OWN, "SetColorScheme", "u", bytes, writing.length, bus.PURPOSE_IGNORE, 0)
}
