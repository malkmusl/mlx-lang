// The session menu under the mark at the bar's left (where macOS has its
// apple menu): the user's name in its header, then the settings, locking
// the screen, logging out, restarting the machine and shutting it down.
// The last three ask first: the list slides aside for "All apps will
// quit" and Cancel and Log Out (Restart, Shut Down). All four go to the
// compositor on the bar's channel ('l', 'q', 'r', 'p': its lock.mlx runs
// the screen locker, or closes the windows and ends the session; for a
// restart or a shut down it then asks the login service, which decides
// whether this user may and has the init end the system).
const std = @import("std")
const state = @import("./state.mlx")
const popup = @import("./popup.mlx")
const channel_module = @import("../shared/channel.mlx")
const symbols = @import("../shared/symbols.mlx")
const apps_module = @import("../shared/apps.mlx")
const palette = @import("../shared/palette.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")

const Bar = state.Bar
const Canvas = state.Canvas

const PADDING: i32 = 8
const ROW: i32 = 36
const ROWS: usize = 5
const SYMBOL: i32 = 18
pub const WIDTH: i32 = 270
pub const HEIGHT: i32 = popup.HEADER + PADDING * 2 + ROW * 5
// The question slides in over this long (milliseconds), this far.
const TURN: usize = 240
const SLIDE: i32 = 40
// The question (two lines, then its buttons) stands in the middle of the
// room under the header.
const QUESTION_TOP: i32 = popup.HEADER + (HEIGHT - popup.HEADER - 112) / 2
const BUTTON_TOP: i32 = QUESTION_TOP + 66
const BUTTON_HEIGHT: i32 = 32
// The question's buttons take a click only once the question has been
// there this long (milliseconds): they come to stand where the rows
// were, and the second click of a double click on "Restart …" would
// else answer the question before anyone read it.
const ANSWER_AFTER: usize = 500

// What the pointer is over (popupHover): a row of the list (in its
// order), or a button of the question.
pub const HIT_SETTINGS: usize = 1
pub const HIT_LOCK: usize = 2
pub const HIT_LOG_OUT: usize = 3
pub const HIT_RESTART: usize = 4
pub const HIT_SHUT_DOWN: usize = 5
pub const HIT_CANCEL: usize = 6
pub const HIT_CONFIRM: usize = 7

const MESSAGE_LOCK: u8 = 108
const MESSAGE_LOG_OUT: u8 = 113
const MESSAGE_RESTART: u8 = 114
const MESSAGE_SHUT_DOWN: u8 = 112

// The list again (the menu opens on it).
pub fn reset(bar: *Bar) -> void {
    bar.*.sessionAsking = false
    bar.*.sessionTurnedAt = 0
    bar.*.sessionQuestion = HIT_LOG_OUT
}

fn rowLabel(bar: *Bar, row: usize) -> []const u8 {
    if bar.*.german { return match row { 0 => "Einstellungen …", 1 => "Bildschirm sperren", 2 => "Abmelden …", 3 => "Neu starten …", else => "Ausschalten …" } }
    return match row { 0 => "Settings …", 1 => "Lock Screen", 2 => "Log Out …", 3 => "Restart …", else => "Shut Down …" }
}

fn rowSymbol(row: usize) -> u32 { return match row { 0 => symbols.TOGGLES, 1 => symbols.LOCK, 2 => symbols.LOG_OUT, 3 => symbols.RESTART, else => symbols.POWER } }

// The question for what was chosen (`what`: HIT_LOG_OUT, HIT_RESTART or
// HIT_SHUT_DOWN), and the word on the button that does it.
fn questionOf(bar: *Bar, what: usize) -> []const u8 {
    if bar.*.german { return if what == HIT_RESTART { "Wirklich neu starten?" } else if what == HIT_SHUT_DOWN { "Wirklich ausschalten?" } else { "Wirklich abmelden?" } }
    return if what == HIT_RESTART { "Restart now?" } else if what == HIT_SHUT_DOWN { "Shut down now?" } else { "Log out now?" }
}

fn confirmLabel(bar: *Bar, what: usize) -> []const u8 {
    if bar.*.german { return if what == HIT_RESTART { "Neu starten" } else if what == HIT_SHUT_DOWN { "Ausschalten" } else { "Abmelden" } }
    return if what == HIT_RESTART { "Restart" } else if what == HIT_SHUT_DOWN { "Shut Down" } else { "Log Out" }
}

fn questionSymbol(what: usize) -> u32 { return if what == HIT_RESTART { symbols.RESTART } else if what == HIT_SHUT_DOWN { symbols.POWER } else { symbols.LOG_OUT } }

// One byte to the compositor on the bar's channel, as the system has the
// channel (shared/channel.mlx: a socket pair on Linux, a channel on
// brixOS, where a Linux send does not reach it).
fn tell(bar: *Bar, message: u8) -> void {
    if bar.*.channel < 0 { return }
    var bytes: [1]u8 = [1]u8{ message }
    _ = channel_module.send(bar.*.channel, bytes[0..1])
}

fn rowTop(row: usize) -> i32 { return popup.HEADER + PADDING + @intCast(i32, row) * ROW }

fn cancelLeft() -> i32 { return 16 }
fn confirmLeft() -> i32 { return WIDTH / 2 + 4 }
fn buttonWidth() -> i32 { return WIDTH / 2 - 20 }

// What point (x, y) of the popup is over.
pub fn hit(bar: *Bar, x: i32, y: i32) -> usize {
    if bar.*.sessionAsking {
        if y < BUTTON_TOP || y >= BUTTON_TOP + BUTTON_HEIGHT { return state.NONE }
        if x >= cancelLeft() && x < cancelLeft() + buttonWidth() { return HIT_CANCEL }
        if x >= confirmLeft() && x < confirmLeft() + buttonWidth() { return HIT_CONFIRM }
        return state.NONE
    }
    if x < PADDING || x >= WIDTH - PADDING || y < rowTop(0) { return state.NONE }
    const row = @intCast(usize, (y - rowTop(0)) / ROW)
    if row >= ROWS { return state.NONE }
    return HIT_SETTINGS + row
}

// Over to the question, or back to the list.
fn ask(bar: *Bar, asking: bool) -> void {
    bar.*.sessionAsking = asking
    bar.*.sessionTurnedAt = std.time.milliseconds()
    bar.*.popupHover = state.NONE
    state.popupChanged(bar)
}

pub fn click(bar: *Bar) -> void {
    const target = bar.*.popupHover
    // (A click that comes with the question is none on its buttons.)
    if (target == HIT_CANCEL || target == HIT_CONFIRM) && std.time.milliseconds() - bar.*.sessionTurnedAt < ANSWER_AFTER { return }
    if target == HIT_SETTINGS {
        apps_module.runScript("control", bar.*.environment)
        state.say(bar, "topbar: settings\n")
        popup.close(bar)
    } else if target == HIT_LOCK {
        tell(bar, MESSAGE_LOCK)
        state.say(bar, "topbar: lock\n")
        popup.close(bar)
    } else if target == HIT_LOG_OUT || target == HIT_RESTART || target == HIT_SHUT_DOWN {
        bar.*.sessionQuestion = target
        ask(bar, true)
    } else if target == HIT_CANCEL {
        ask(bar, false)
    } else if target == HIT_CONFIRM {
        const what = bar.*.sessionQuestion
        tell(bar, if what == HIT_RESTART { MESSAGE_RESTART } else if what == HIT_SHUT_DOWN { MESSAGE_SHUT_DOWN } else { MESSAGE_LOG_OUT })
        state.say(bar, if what == HIT_RESTART { "topbar: restart\n" } else if what == HIT_SHUT_DOWN { "topbar: shut down\n" } else { "topbar: log out\n" })
        popup.close(bar)
    }
}

// The user's name for the header ($USER, else "Session").
fn userName(bar: *Bar) -> []const u8 {
    const user = apps_module.environmentValue(bar.*.environment, "USER")
    if @intFromPtr(user) == 0 || user[0] == 0 { return if bar.*.german { "Sitzung" } else { "Session" } }
    var length: usize = 0
    while user[length] != 0 && length < 32 { length += 1 }
    return user[0..length]
}

// The list `shift` pixels to the side, at `opacity`.
fn drawList(bar: *Bar, canvas: *Canvas, shift: i32, opacity: u32, lit: bool) -> void {
    canvas_module.setOpacity(canvas, opacity)
    const dim = state.ink(bar, 120)
    var row: usize = 0
    while row < ROWS {
        const top = rowTop(row)
        if lit && bar.*.popupHover == HIT_SETTINGS + row { popup.light(bar, canvas, PADDING + shift, top, WIDTH - 2 * PADDING, ROW, 8) }
        state.symbol(bar, canvas, rowSymbol(row), 0, 18 + shift, top + (ROW - SYMBOL) / 2, SYMBOL)
        text_module.drawText(canvas, state.textOf(bar), rowLabel(bar, row), 48 + shift, top + 9, state.ink(bar, 255), 0)
        if row == 1 {
            const hint = "Super+L"
            text_module.drawText(canvas, state.smallOf(bar), hint, WIDTH - 18 - text_module.measure(state.smallOf(bar), hint) + shift, top + 11, dim, 0)
        }
        // A line between the settings and the session's own, and one
        // between the session's and the machine's.
        if row == 0 || row == 2 { canvas_module.fillRect(canvas, 16 + shift, top + ROW, WIDTH - 32, 1, state.ink(bar, 30)) }
        row += 1
    }
    canvas_module.setOpacity(canvas, 255)
}

fn button(bar: *Bar, canvas: *Canvas, left: i32, label: []const u8, accent: bool, lit: bool) -> void {
    const fill = if accent { state.accent() } else { state.colorsOf(bar).*.panel }
    const ink = if accent { palette.ON_ACCENT } else { state.ink(bar, 255) }
    canvas_module.fillRoundedRect(canvas, left, BUTTON_TOP, buttonWidth(), BUTTON_HEIGHT, 9, fill)
    if lit { popup.light(bar, canvas, left, BUTTON_TOP, buttonWidth(), BUTTON_HEIGHT, 9) }
    const width = text_module.measure(state.textOf(bar), label)
    text_module.drawText(canvas, state.textOf(bar), label, left + (buttonWidth() - width) / 2, BUTTON_TOP + 8, ink, 0)
}

// The question `shift` pixels to the side, at `opacity`.
fn drawQuestion(bar: *Bar, canvas: *Canvas, shift: i32, opacity: u32, lit: bool) -> void {
    canvas_module.setOpacity(canvas, opacity)
    const german = bar.*.german
    const what = bar.*.sessionQuestion
    state.symbol(bar, canvas, questionSymbol(what), 0, 18 + shift, QUESTION_TOP + 14, SYMBOL)
    text_module.drawText(canvas, state.boldOf(bar), questionOf(bar, what), 48 + shift, QUESTION_TOP + 14, state.ink(bar, 255), 0)
    text_module.drawText(canvas, state.smallOf(bar), if german { "Alle Apps werden beendet." } else { "All apps will quit." }, 48 + shift, QUESTION_TOP + 38, state.ink(bar, 170), 0)
    button(bar, canvas, cancelLeft() + shift, if german { "Abbrechen" } else { "Cancel" }, false, lit && bar.*.popupHover == HIT_CANCEL)
    button(bar, canvas, confirmLeft() + shift, confirmLabel(bar, what), true, lit && bar.*.popupHover == HIT_CONFIRM)
    canvas_module.setOpacity(canvas, 255)
}

pub fn draw(bar: *Bar, canvas: *Canvas) -> void {
    popup.frame(bar, canvas, userName(bar))
    // The list goes out to the left as the question comes in from the
    // right (and back): the old one in the first half, the new one in the
    // second.
    const t = state.popupAlong(bar, bar.*.sessionTurnedAt, TURN)
    const asking = bar.*.sessionAsking
    if t < 1024 {
        if t < 512 {
            const opacity = @intCast(u32, (512 - t) * 255 / 512)
            const shift = 0 - SLIDE * t / 512
            if asking { drawList(bar, canvas, shift, opacity, false) } else { drawQuestion(bar, canvas, 0 - shift, opacity, false) }
        } else {
            const opacity = @intCast(u32, (t - 512) * 255 / 512)
            const shift = SLIDE * (1024 - t) / 512
            if asking { drawQuestion(bar, canvas, shift, opacity, false) } else { drawList(bar, canvas, 0 - shift, opacity, false) }
        }
        return
    }
    if asking { drawQuestion(bar, canvas, 0, 255, true) } else { drawList(bar, canvas, 0, 255, true) }
}
