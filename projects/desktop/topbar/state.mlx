// The top bar's state, shared by its parts: main.mlx (the bar, its
// workspace controls, the input and the popups), calendar.mlx (the month
// under the clock), bus.mlx (the session bus), media.mlx (MPRIS players),
// tray.mlx (StatusNotifierItem icons and their menus), sound.mlx (MLX
// Audio's volume), battery.mlx (/sys/class/power_supply), session.mlx
// (the session menu), control.mlx (the control centre and the
// notifications) and look.mlx (dark or light: the colours come from
// shared/palette.mlx, gliding when the look changes).
const std = @import("std")
const dbus = @import("std.dbus")
const png = @import("std.png")
const apps_module = @import("../shared/apps.mlx")
const menu_module = @import("../shared/menu.mlx")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")
const timezone = @import("std.timezone")
const symbols_module = @import("../shared/symbols.mlx")
const anim = @import("../shared/anim.mlx")
const topbar_items = @import("../shared/topbar_items.mlx")
const notices_module = @import("../shared/notices.mlx")
const palette = @import("../shared/palette.mlx")

pub const Allocator = std.allocator.Allocator
pub const Canvas = canvas_module.Canvas
pub const Text = text_module.Text
pub const Panel = panel_module.Panel

pub const HEIGHT: i32 = 30
pub const PADDING: i32 = 16
pub const TEXT_COLOR: u32 = 4294967295
pub const WORKSPACES: usize = 9
pub const NONE: usize = 1 << 40

// The popup open under the bar (one at a time).
pub const POPUP_NONE: u32 = 0
pub const POPUP_CALENDAR: u32 = 1
pub const POPUP_MEDIA: u32 = 2
pub const POPUP_SOUND: u32 = 3
pub const POPUP_BATTERY: u32 = 4
pub const POPUP_TRAY: u32 = 5
pub const POPUP_SESSION: u32 = 6
pub const POPUP_CONTROL: u32 = 7

// The widgets on the right (shared/topbar_items.mlx's items: the user
// orders and hides them; by default from the right edge in): the clock,
// the control centre, the battery, the volume, the tray's icons and
// what plays (shared/topbar_items.mlx's numbers).
pub const WIDGET_CLOCK: usize = 0
pub const WIDGET_BATTERY: usize = 1
pub const WIDGET_SOUND: usize = 2
pub const WIDGET_TRAY: usize = 3
pub const WIDGET_MEDIA: usize = 4
pub const WIDGET_CONTROL: usize = 5
pub const WIDGETS: usize = 6

// A popup's look (as the dock's menus).
pub const POPUP_BACKGROUND: u32 = 4280165674
pub const POPUP_RADIUS: i32 = 12
pub const ACCENT: u32 = 4284129535

// Text kept in a fixed place.
pub const Label = struct {
    bytes: [256]u8
    length: usize
}

pub fn labelText(label: *const Label) -> []const u8 {
    const bytes: [*]const u8 = &label.*.bytes
    return bytes[0..label.*.length]
}

// The label to change: a field's address (&item.*.title) is typed const.
fn changing(given: *const Label) -> *Label {
    unsafe { return @ptrCast(*Label, given) }
}

pub fn labelSet(given: *const Label, text: []const u8) -> void {
    const label = changing(given)
    var length: usize = 0
    for byte in text {
        if length < 255 {
            label.*.bytes[length] = byte
            length += 1
        }
    }
    label.*.length = length
}

pub fn labelAdd(given: *const Label, text: []const u8) -> void {
    const label = changing(given)
    for byte in text {
        if label.*.length < 255 {
            label.*.bytes[label.*.length] = byte
            label.*.length += 1
        }
    }
}

pub fn labelClear(given: *const Label) -> void { changing(given).*.length = 0 }

// The label with a NUL after it (for paths).
pub fn labelPath(given: *const Label) -> [*]const u8 {
    const label = changing(given)
    label.*.bytes[label.*.length] = 0
    return &label.*.bytes
}

pub fn same(first: []const u8, second: []const u8) -> bool { return apps_module.sameText(first, second) }

pub fn startsWith(text: []const u8, prefix: []const u8) -> bool { return text.length >= prefix.length && same(text[0..prefix.length], prefix) }

// ---------------------------------------------------------------------------
// MPRIS players

pub const MAX_PLAYERS: usize = 8
pub const STOPPED: u32 = 0
pub const PAUSED: u32 = 1
pub const PLAYING: u32 = 2

pub const Player = struct {
    used: bool
    // Its bus name (org.mpris.MediaPlayer2.NAME) and the connection that
    // owns it (its signals come from that), its name for people.
    name: Label
    owner: Label
    identity: Label
    status: u32
    title: Label
    artist: Label
    album: Label
    // mpris:artUrl (a file:// one is shown when it is a PNG), and
    // mpris:trackid (SetPosition names it).
    art: Label
    trackId: Label
    // Microseconds: the track's length, and where it was at positionAt
    // (milliseconds; it goes on from there while it plays).
    length: i64
    position: i64
    positionAt: usize
    canNext: bool
    canPrevious: bool
    canPlay: bool
    canPause: bool
    // When it last started playing (the bar shows the latest).
    playedAt: usize
}

// ---------------------------------------------------------------------------
// StatusNotifierItems

pub const MAX_ITEMS: usize = 12
// An item's icon, ICON x ICON pixels.
pub const ICON: usize = 20
pub const ITEM_PASSIVE: u32 = 0
pub const ITEM_ACTIVE: u32 = 1
pub const ITEM_ATTENTION: u32 = 2

pub const Item = struct {
    used: bool
    // What it registered (a bus name, or an object path on the caller's
    // connection), the connection and the object, and the connection's
    // unique name (its signals come from that).
    service: Label
    bus: Label
    path: Label
    owner: Label
    id: Label
    title: Label
    status: u32
    iconName: Label
    themePath: Label
    // Its com.canonical.dbusmenu object (length 0: none), and whether a
    // click asks for the menu rather than Activate.
    menu: Label
    itemIsMenu: bool
    // Its icon (premultiplied 0xAARRGGBB), from IconPixmap or IconName.
    pixels: [400]u32
    hasIcon: bool
}

pub fn itemPixels(item: *Item) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, @intFromPtr(item) + @offsetOf(Item, "pixels")) }
}

// ---------------------------------------------------------------------------
// The session bus

// A call whose reply the bar waits for: what it was for (bus.mlx's
// PURPOSE_*) and the player or item it was about.
pub const Pending = struct {
    serial: u32
    purpose: u32
    slot: usize
}

pub const MAX_PENDING: usize = 48

// A Wi-Fi network in the control centre's list (network.mlx): its SSID,
// signal (0 to 100), security (network.SECURITY_*), and whether it is
// saved, joined, being joined, refused for its passphrase.
pub const WifiRow = struct {
    ssid: Label
    signal: u32
    security: u32
    saved: bool
    connected: bool
    joining: bool
    refused: bool
}

// An app MLX Audio knows: its name (MLXIPC's app id), volume (65536 is
// 100%), mute, and whether it plays now.
pub const SoundApp = struct {
    name: Label
    volume: u32
    mute: bool
    playing: bool
}

// A playback device: its name (pcmC0D0p) and label.
pub const Device = struct {
    name: Label
    label: Label
}

pub const Bar = struct {
    panel: Panel
    apps: apps_module.Apps
    zone: timezone.Zone
    environment: [*][*]const u8
    allocator: Allocator
    german: bool
    // Lines on stderr for the checks (MLX_TOPBAR_VERBOSE).
    verbose: bool
    // The time shown ("So. 27. Sep.  16:05") and the minute it is for.
    time: [48]u8
    timeLength: usize
    minute: i64
    // A fixed time (MLX_TOPBAR_TIME), else 0.
    fixedTime: i64
    // The compositor's channel (MLX_TOPBAR_FD), else -1.
    channel: isize
    // The workspaces as the compositor last said: the current one (from
    // 0), which ones tile (a bit each) and how many windows each has.
    current: usize
    tilingMask: u32
    counts: [9]u8
    // Where the pointer is on the bar (for clicks; -1: not on it).
    pointerX: i32
    // The lit workspace button glides from litFrom (x on the bar) since
    // litStart, the lit part of the mode button from modeFrom (0: the
    // floating part, MODE_WIDTH: the tiling part) since modeStart
    // (milliseconds; 0: they stand).
    litFrom: i32
    litStart: usize
    modeFrom: i32
    modeStart: usize
    // The wheel's travel not yet a switch, and when it last switched.
    wheelTravel: i32
    wheelAt: usize
    // When the slow work (the bus, the sound, the batteries) was last
    // done.
    slowAt: usize
    text: Text
    bold: Text
    small: Text
    // The widgets' order and which are shown (~/.config/mlx/topbar.conf),
    // and when the file last changed.
    arrangement: topbar_items.Items
    arrangementSignature: usize
    // Where each widget on the right is (x on the bar; width 0: not
    // shown), and the one under the pointer (the tray icon among them).
    widgetLeft: [6]i32
    widgetWidth: [6]i32
    layoutChanged: bool
    // The next layout puts widgets where they go without gliding (the
    // first one).
    layoutJump: bool
    hoverWidget: usize
    hoverItem: usize
    // The popup open (POPUP_*), what in it is under the pointer (each
    // popup's own numbers) and where the pointer is on it; a slider held.
    popup: u32
    popupHover: usize
    popupX: i32
    popupY: i32
    dragging: bool
    // The month the calendar shows.
    calendarYear: i64
    calendarMonth: i64
    // The session bus: connected, when it was last tried, the calls
    // waiting for replies.
    bus: dbus.Client
    busUp: bool
    busTried: usize
    pending: [48]Pending
    // The StatusNotifierWatcher is ours (we own the name), else another
    // program's (its items are listed by it).
    watcherOurs: bool
    hostRegistered: bool
    players: [8]Player
    items: [12]Item
    // The tray menu open (com.canonical.dbusmenu): its entries' values are
    // the menu's ids; the item it is of.
    menu: menu_module.Menu
    menuItem: usize
    // MLX Audio: whether org.mlx.Audio has an owner, the connection
    // (std.audio.Audio's address, 0: none), the output's volume (65536 is
    // 100%), mute and name, and when the state was asked last.
    audioOwned: bool
    audio: usize
    audioUp: bool
    volume: u32
    mute: bool
    output: Label
    soundAt: usize
    soundState: [*]u8
    // The batteries (MLX_TOPBAR_POWER or /sys/class/power_supply): how
    // many, the charge in percent, charging or full, the minutes left
    // (to empty or full; -1: unknown), and when they were read.
    powerRoot: Label
    batteries: usize
    charge: i32
    charging: bool
    full: bool
    minutesLeft: i64
    batteryAt: usize
    // The cover of the player shown (art: the path it was loaded from).
    cover: png.Image
    hasCover: bool
    coverPath: Label
    // The symbols drawn (shared/symbols.mlx).
    symbols: symbols_module.Cache
    // Animations: each widget's place, width, how much it shows (0 to
    // 255) and how lit it is under the pointer; each tray item's light.
    widgetPlace: [6]anim.Glide
    widgetSize: [6]anim.Glide
    widgetShown: [6]anim.Glide
    widgetLight: [6]anim.Glide
    itemLight: [12]anim.Glide
    // Something still moves on the bar, or in the popup.
    moving: bool
    popupMoving: bool
    // The popup came (or goes, closing) since these milliseconds; what is
    // under the pointer in it lit since popupLitAt.
    popupOpenedAt: usize
    closing: bool
    closingAt: usize
    popupLitAt: usize
    // The time shown before the last change, fading out since timeAt.
    timeBefore: [48]u8
    timeBeforeLength: usize
    timeAt: usize
    // The session menu asks before logging out (since sessionTurnedAt);
    // the mark's light under the pointer.
    sessionAsking: bool
    sessionTurnedAt: usize
    markLight: anim.Glide
    // The calendar's month turned (to the next: 1, before: -1) at.
    turnedAt: usize
    turnedWay: i32
    // The volume and the charge as drawn (they glide to the real ones).
    volumeShown: anim.Glide
    chargeShown: anim.Glide
    // What played before the track changed, fading out since captionAt.
    captionBefore: Label
    captionNow: Label
    captionNext: Label
    captionAt: usize
    // MLX Audio's apps (playing or with settings), their volumes and
    // mute, which ones play now; its playback devices.
    soundApps: [16]SoundApp
    soundAppCount: usize
    devices: [8]Device
    deviceCount: usize
    outputSpec: Label
    // The control centre: mlx-notifyd's notifications (shared/notices.mlx);
    // the tiles' glow (0 to 255: off to
    // on); the widget's dot (unread) and moon (Do Not Disturb) as they
    // grow; night light; what is connected (control.mlx's NET_*), its
    // interface and where interfaces are looked for; the notification
    // dismissed (the ones from removedIndex glide up since removedAt);
    // all cleared at (they fade out; 0: not).
    notices: notices_module.Notices
    controlTiles: [6]anim.Glide
    controlDot: anim.Glide
    controlMoon: anim.Glide
    nightLight: bool
    netKind: u32
    netName: Label
    netRoot: Label
    // mlx-netd on the system bus (network.mlx): its client (a dbus.Client;
    // 0: none), whether it answers, whether a Wi-Fi card is there and the
    // networks it sees; the list under the tiles, open since netListAt
    // (its rows fade in), closing since netClosingAt (0: not). The Wi-Fi
    // network being joined (netConnecting) is netJoining, whatever the
    // tile shows.
    netClient: usize
    netKnown: bool
    netConnecting: bool
    netJoining: Label
    hasWifi: bool
    wifis: [6]WifiRow
    wifiCount: usize
    netListOpen: bool
    netListAt: usize
    netClosingAt: usize
    removedIndex: usize
    removedAt: usize
    clearingAt: usize
    // The look: the color-scheme in force (palette.SCHEME_*), how light
    // it is drawn (0 to palette.LIGHT, gliding), the colours of the
    // drawing under way.
    scheme: u32
    theme: anim.Glide
    // What appearance.conf said last (look.follow), once read.
    fileSeen: bool
    fileLight: bool
    colors: palette.Palette
    // A screenshot is taken at shotAt (milliseconds; 0: none), once the
    // popup went.
    shotAt: usize
}

pub fn wifiAt(bar: *Bar, index: usize) -> *WifiRow {
    unsafe { return @ptrFromInt(*WifiRow, @intFromPtr(bar) + @offsetOf(Bar, "wifis") + index * @sizeOf(WifiRow)) }
}

pub fn soundAppAt(bar: *Bar, index: usize) -> *SoundApp {
    unsafe { return @ptrFromInt(*SoundApp, @intFromPtr(bar) + @offsetOf(Bar, "soundApps") + index * @sizeOf(SoundApp)) }
}

pub fn deviceAt(bar: *Bar, index: usize) -> *Device {
    unsafe { return @ptrFromInt(*Device, @intFromPtr(bar) + @offsetOf(Bar, "devices") + index * @sizeOf(Device)) }
}

// The colours of the drawing under way.
pub fn colorsOf(bar: *Bar) -> *palette.Palette {
    unsafe { return @ptrCast(*palette.Palette, &bar.*.colors) }
}

pub fn themeOf(bar: *Bar) -> *anim.Glide { return glideAt(bar, @offsetOf(Bar, "theme"), 0) }

// The colours for the bar (popup: for the popup) as the look is now.
pub fn paint(bar: *Bar, for_popup: bool) -> void {
    const t = if for_popup { popupGlided(bar, themeOf(bar)) } else { glided(bar, themeOf(bar)) }
    bar.*.colors = palette.at(t)
}

// The ink (text, symbols) at `alpha`: what says less, and the light under
// the pointer.
pub fn ink(bar: *Bar, alpha: u32) -> u32 { return palette.ink(colorsOf(bar), alpha) }

// A link's colour (a light blue on dark, a deeper one on light).
pub fn link(bar: *Bar) -> u32 { return palette.mix(canvas_module.color(255, 150, 200, 255), canvas_module.color(255, 40, 110, 220), colorsOf(bar).*.t) }

// Symbol `symbol` in the ink.
pub fn symbol(bar: *Bar, canvas: *Canvas, symbol_id: u32, variant: u32, x: i32, y: i32, size: i32) -> void {
    palette.symbol(colorsOf(bar), symbolsOf(bar), canvas, symbol_id, variant, x, y, size)
}

// The same at `opacity` (0 to 255).
pub fn symbolFaded(bar: *Bar, canvas: *Canvas, symbol_id: u32, variant: u32, x: i32, y: i32, size: i32, opacity: u32) -> void {
    const before = canvas.*.opacity
    canvas_module.setOpacity(canvas, before * opacity / 255)
    symbol(bar, canvas, symbol_id, variant, x, y, size)
    canvas_module.setOpacity(canvas, before)
}

// The same on something lit in the accent colour as far as `on` (0 to
// 255): white there, the ink elsewhere.
pub fn symbolOn(bar: *Bar, canvas: *Canvas, symbol_id: u32, variant: u32, x: i32, y: i32, size: i32, on: i32) -> void {
    const amount = @intCast(u32, if on < 0 { 0 } else if on > 255 { 255 } else { on })
    if amount < 255 { symbolFaded(bar, canvas, symbol_id, variant, x, y, size, 255 - amount) }
    if amount > 0 {
        const before = canvas.*.opacity
        canvas_module.setOpacity(canvas, before * amount / 255)
        symbols_module.draw(symbolsOf(bar), canvas, symbol_id, variant, x, y, size, palette.ON_ACCENT)
        canvas_module.setOpacity(canvas, before)
    }
}

pub fn noticesOf(bar: *Bar) -> *notices_module.Notices {
    unsafe { return @ptrCast(*notices_module.Notices, &bar.*.notices) }
}

pub fn arrangementOf(bar: *Bar) -> *topbar_items.Items {
    unsafe { return @ptrCast(*topbar_items.Items, &bar.*.arrangement) }
}

pub fn symbolsOf(bar: *Bar) -> *symbols_module.Cache {
    unsafe { return @ptrCast(*symbols_module.Cache, &bar.*.symbols) }
}

pub fn glideAt(bar: *Bar, field: usize, index: usize) -> *anim.Glide {
    unsafe { return @ptrFromInt(*anim.Glide, @intFromPtr(bar) + field + index * @sizeOf(anim.Glide)) }
}

pub fn placeOf(bar: *Bar, widget: usize) -> *anim.Glide { return glideAt(bar, @offsetOf(Bar, "widgetPlace"), widget) }
pub fn sizeOf(bar: *Bar, widget: usize) -> *anim.Glide { return glideAt(bar, @offsetOf(Bar, "widgetSize"), widget) }
pub fn shownOf(bar: *Bar, widget: usize) -> *anim.Glide { return glideAt(bar, @offsetOf(Bar, "widgetShown"), widget) }
pub fn lightOf(bar: *Bar, widget: usize) -> *anim.Glide { return glideAt(bar, @offsetOf(Bar, "widgetLight"), widget) }
pub fn itemLightOf(bar: *Bar, item: usize) -> *anim.Glide { return glideAt(bar, @offsetOf(Bar, "itemLight"), item) }

pub fn volumeShownOf(bar: *Bar) -> *anim.Glide {
    unsafe { return @ptrCast(*anim.Glide, &bar.*.volumeShown) }
}

pub fn chargeShownOf(bar: *Bar) -> *anim.Glide {
    unsafe { return @ptrCast(*anim.Glide, &bar.*.chargeShown) }
}

// A glide's value now, noting on the bar that it still moves.
pub fn glided(bar: *Bar, glide: *const anim.Glide) -> i32 {
    if anim.moving(glide) { bar.*.moving = true }
    return anim.value(glide)
}

// The same for a transition since `start`.
pub fn along(bar: *Bar, start: usize, duration: usize) -> i32 {
    const t = anim.progress(start, duration)
    if t < 1024 { bar.*.moving = true }
    return t
}

// The same in the popup.
pub fn popupAlong(bar: *Bar, start: usize, duration: usize) -> i32 {
    const t = anim.progress(start, duration)
    if t < 1024 { bar.*.popupMoving = true }
    return t
}

pub fn popupGlided(bar: *Bar, glide: *const anim.Glide) -> i32 {
    if anim.moving(glide) { bar.*.popupMoving = true }
    return anim.value(glide)
}

pub fn barOf(context: *anyopaque) -> *Bar {
    unsafe { return @ptrCast(*Bar, context) }
}

