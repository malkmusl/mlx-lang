// Ticks every 16 milliseconds (something moves; the bar goes back to
// ticking every second once nothing does).
pub fn fastTicks(bar: *Bar) -> void {
    const panel = panelOf(bar)
    if panel.*.tickInterval == 16 { return }
    panel.*.tickInterval = 16
    panel.*.nextTick = 0
}

// The popup is to be drawn again.
pub fn popupChanged(bar: *Bar) -> void { panelOf(bar).*.menuDirty = true }

// The bar is to be drawn again.
pub fn barChanged(bar: *Bar) -> void { panelOf(bar).*.dirty = true }

// Sends the compositor a message on the bar's channel (MSG_DONTWAIT |
// MSG_NOSIGNAL; nothing without a channel).
pub fn send(bar: *Bar, bytes: [*]const u8, length: usize) -> void {
    if bar.*.channel < 0 { return }
    _ = std.linux.syscall6(44, @bitCast(usize, bar.*.channel), @intFromPtr(bytes), length, 64 | 16384, 0, 0)
}

pub fn markLightOf(bar: *Bar) -> *anim.Glide { return glideAt(bar, @offsetOf(Bar, "markLight"), 0) }

// A line on stderr when verbose.
pub fn say(bar: *Bar, text: []const u8) -> void {
    if !bar.*.verbose { return }
    _ = std.io.writeAll(std.io.stderr(), text)
}

pub fn sayNumber(bar: *Bar, value: i64) -> void {
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = &digits
    say(bar, bytes[0..std.text.appendSigned(bytes, 0, 24, @intCast(isize, value))])
}

// Decimal text of `value` into `out` (at least 24 bytes); its length.
pub fn putNumber(out: [*]u8, at: usize, value: i64, width: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { 0 - value } else { value }
    while rest > 0 || count < width {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var index = at
    if value < 0 {
        out[index] = 45
        index += 1
    }
    while count > 0 {
        count -= 1
        out[index] = digits[count]
        index += 1
    }
    return index
}

pub fn put(out: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        out[index] = byte
        index += 1
    }
    return index
}
