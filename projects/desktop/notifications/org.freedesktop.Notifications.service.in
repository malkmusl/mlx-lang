# MLX Notifications (beacon), started by synapse (MLXIPC) when an
# app first sends a notification or the top bar's control centre first
# asks. It lives in PREFIX/share/mlx/dbus-1/services, where only MLXIPC
# looks (mlx-session passes --services).
[D-BUS Service]
Name=org.freedesktop.Notifications
Exec=@BINDIR@/beacon
