// mlx-notify: sends a desktop notification
// (org.freedesktop.Notifications.Notify), as notify-send does.
//
//   mlx-notify [-a APP] [-i ICON] [-u low|normal|critical] [-t MS]
//              [-A KEY=LABEL]... [-r ID] [-p] [-w] SUMMARY [BODY]
//
// -a names the app, -i gives an icon (a name or a path), -u the urgency,
// -t the timeout in milliseconds (0: it stays), -A an action (a button;
// KEY "default" is a click on the notification), -r the id of one to
// replace; -p prints the id it got, -w waits until it closes and prints
// the key of the action chosen (nothing when it closed otherwise).
const std = @import("std")
const dbus = @import("std.dbus")

const NAME: []const u8 = "org.freedesktop.Notifications"
const PATH: []const u8 = "/org/freedesktop/Notifications"
const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const SIZE: usize = 16384
const MAX_ACTIONS: usize = 8

const Failure = error { Usage, NoMemory, NoBus, NoServer }

fn fail(failure: Failure) -> Failure!void { return failure }

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn number(text: []const u8) -> i64 {
    var value: i64 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return -1 }
        value = value * 10 + @intCast(i64, byte - 48)
    }
    return value
}

fn print(text: []const u8) -> void {
    const written = std.io.writeAll(std.io.stdout(), text)
}

fn printNumber(value: u32) -> void {
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[11 - count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    const bytes: [*]const u8 = &digits
    print(bytes[12 - count..12])
}

fn usage() -> Failure!void {
    const written = std.io.writeAll(std.io.stderr(), "usage: mlx-notify [-a APP] [-i ICON] [-u low|normal|critical] [-t MS] [-A KEY=LABEL]... [-r ID] [-p] [-w] SUMMARY [BODY]\n")
    return fail(Failure.Usage)
}

// Waits for the reply to `serial`; false when there was none (or an
// error).
fn awaitReply(client: *dbus.Client, serial: u32, header: *dbus.Header) -> bool {
    const started = std.time.milliseconds()
    while std.time.milliseconds() - started < 10000 {
        if dbus.next(client, header, 500) {
            if header.*.hasReplySerial && header.*.replySerial == serial { return header.*.kind == dbus.METHOD_RETURN }
        } else if client.*.closed {
            return false
        }
    }
    return false
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    const out = allocator.alloc(SIZE, 16)
    if memory == null || out == null { return fail(Failure.NoMemory) }
    var client: *dbus.Client = undefined
    unsafe { client = @ptrCast(*dbus.Client, memory.?) }
    var app: []const u8 = "mlx-notify"
    var icon: []const u8 = ""
    var urgency: u8 = 1
    var timeout: i32 = -1
    var replaces: u32 = 0
    var print_id = false
    var wait = false
    var actions: [8][]const u8 = undefined
    var action_count: usize = 0
    var summary: []const u8 = ""
    var body: []const u8 = ""
    var positional: usize = 0
    var index: usize = 1
    while index < arguments.length {
        const argument = cString(arguments[index])
        const has_value = index + 1 < arguments.length
        if same(argument, "-a") && has_value {
            index += 1
            app = cString(arguments[index])
        } else if same(argument, "-i") && has_value {
            index += 1
            icon = cString(arguments[index])
        } else if same(argument, "-u") && has_value {
            index += 1
            const level = cString(arguments[index])
            urgency = if same(level, "low") { 0 } else if same(level, "critical") { 2 } else { 1 }
        } else if same(argument, "-t") && has_value {
            index += 1
            timeout = @intCast(i32, number(cString(arguments[index])))
        } else if same(argument, "-r") && has_value {
            index += 1
            replaces = @intCast(u32, number(cString(arguments[index])))
        } else if same(argument, "-A") && has_value && action_count < MAX_ACTIONS {
            index += 1
            actions[action_count] = cString(arguments[index])
            action_count += 1
        } else if same(argument, "-p") {
            print_id = true
        } else if same(argument, "-w") {
            wait = true
        } else if argument.length > 1 && argument[0] == 45 {
            return usage()
        } else {
            if positional == 0 { summary = argument } else if positional == 1 { body = argument }
            positional += 1
        }
        index += 1
    }
    if positional == 0 { return usage() }
    if !dbus.connectSession(client, allocator, environment) { return fail(Failure.NoBus) }
    var header: dbus.Header = undefined
    var writing: dbus.Writer = undefined
    if wait {
        // The server's signals.
        dbus.begin(&writing, out.?, SIZE, false)
        dbus.putString(&writing, "type='signal',interface='org.freedesktop.Notifications'")
        const added = dbus.call(client, BUS, BUS_PATH, BUS, "AddMatch", "s", out.?, writing.length)
        if !awaitReply(client, added, &header) { return fail(Failure.NoBus) }
    }
    dbus.begin(&writing, out.?, SIZE, false)
    dbus.putString(&writing, app)
    dbus.putU32(&writing, replaces)
    dbus.putString(&writing, icon)
    dbus.putString(&writing, summary)
    dbus.putString(&writing, body)
    // The actions: KEY=LABEL as key, label (just KEY: the key as label).
    const list = dbus.beginArray(&writing, 4)
    var action: usize = 0
    while action < action_count {
        const text = actions[action]
        var equals: usize = 0
        while equals < text.length && text[equals] != 61 { equals += 1 }
        dbus.putString(&writing, text[0..equals])
        dbus.putString(&writing, if equals < text.length { text[equals + 1..text.length] } else { text })
        action += 1
    }
    dbus.endArray(&writing, list, 4)
    const hints = dbus.beginArray(&writing, 8)
    dbus.pad(&writing, 8)
    dbus.putString(&writing, "urgency")
    dbus.putSignature(&writing, "y")
    dbus.putByte(&writing, urgency)
    dbus.endArray(&writing, hints, 8)
    dbus.putU32(&writing, @bitCast(u32, timeout))
    const serial = dbus.call(client, NAME, PATH, NAME, "Notify", "susssasa{sv}i", out.?, writing.length)
    if !awaitReply(client, serial, &header) { return fail(Failure.NoServer) }
    var reading = dbus.reader(dbus.bodyOf(client, &header), header.bodyLength, header.big)
    const id = dbus.readU32(&reading)
    if print_id {
        printNumber(id)
        print("\n")
    }
    if !wait { return }
    // Until it closes: the action chosen, if one was.
    while true {
        if !dbus.next(client, &header, 1000) {
            if client.*.closed { return }
            continue
        }
        if header.kind != dbus.SIGNAL { continue }
        var signal = dbus.reader(dbus.bodyOf(client, &header), header.bodyLength, header.big)
        const which = dbus.readU32(&signal)
        if which != id { continue }
        if same(header.member, "ActionInvoked") {
            print(dbus.readString(&signal))
            print("\n")
        } else if same(header.member, "NotificationClosed") {
            return
        }
    }
}
