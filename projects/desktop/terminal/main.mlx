// mlx-terminal: the terminal emulator of the Mlx desktop, a window
// (std.ui.host) around std.terminal: it runs a shell on a pseudo-terminal
// (std.terminal.pty), draws the screen with the monospaced TrueType font
// of std.ui.text (std.truetype, any size) through std.ui.terminal, and
// sends what is typed as the compositor's keymap says it (std.xkb through
// the host: any layout, AltGr, Ctrl on any key) encoded as xterm does
// (std.terminal.keys). TERM is xterm-256color. The window follows the size
// its compositor configures, in whole cells, and the shell learns each new
// size (TIOCSWINSZ). The wheel and Shift+Page Up/Down scroll through the
// history; the title follows the program's (OSC 0 and 2).
//
//     mlx4 projects/desktop/terminal/main.mlx -o mlx-terminal
//     ./mlx-terminal                       # $SHELL, else mlx-sh beside it or installed, else /bin/sh
//     ./mlx-terminal /bin/bash -l          # another program (absolute path)
//     ./mlx-terminal --font-size 18        # or MLX_TERMINAL_FONT_SIZE
//     ./mlx-terminal --columns 120 --rows 40
//
// projects/desktop/compositor launches it with Alt+Enter. The same
// std.terminal and std.ui.terminal draw the console without a compositor
// (projects/desktop/console) and a terminal pane in any std.ui app.
const std = @import("std")
const ui = @import("std.ui")
const app = @import("std.ui.app")
const host = @import("std.ui.host")
const text = @import("std.ui.text")
const ui_terminal = @import("std.ui.terminal")
const terminal = @import("std.terminal")
const pty = @import("std.terminal.pty")
const crash = @import("std.crash")

const DEFAULT_COLUMNS: usize = 80
const DEFAULT_ROWS: usize = 24
const DEFAULT_FONT_HEIGHT: i32 = 15
const HISTORY_LINES: usize = 5000
const PADDING: i32 = 6
const READ_CAPACITY: usize = 65536

const Terminal = struct {
    host: *host.Host
    screen: terminal.Screen
    mono: text.Text
    view: ui_terminal.View
    child: pty.Child
    hasChild: bool
    fontHeight: i32
    columns: usize
    rows: usize
    width: i32
    height: i32
    status: u8
    input: [READ_CAPACITY]u8
}

fn terminalOf(context: *anyopaque) -> *Terminal {
    unsafe { return @ptrCast(*Terminal, context) }
}

fn screenOf(terminal_state: *Terminal) -> *terminal.Screen {
    unsafe { return @ptrCast(*terminal.Screen, &terminal_state.*.screen) }
}

fn viewOf(terminal_state: *Terminal) -> *ui_terminal.View {
    unsafe { return @ptrCast(*ui_terminal.View, &terminal_state.*.view) }
}

fn monoOf(terminal_state: *Terminal) -> *text.Text {
    unsafe { return @ptrCast(*text.Text, &terminal_state.*.mono) }
}

fn childOf(terminal_state: *Terminal) -> *pty.Child {
    unsafe { return @ptrCast(*pty.Child, &terminal_state.*.child) }
}

fn inputOf(terminal_state: *Terminal) -> [*]u8 {
    unsafe { return @ptrCast([*]u8, &terminal_state.*.input) }
}

fn named(value: std.string.String, name: []const u8) -> bool { return std.string.eql(value, std.string.fromSlice(name)) }

fn number(value: std.string.String, fallback: usize) -> usize {
    const parsed = std.parse.unsigned(value)
    return if parsed.valid && parsed.value > 0 { parsed.value } else { fallback }
}

// What the program sees after the pty's reports and the screen's changes.
fn afterOutput(terminal_state: *Terminal) -> void {
    const screen = screenOf(terminal_state)
    var reply: [terminal.RESPONSE_CAPACITY]u8 = undefined
    var reply_bytes: [*]u8 = undefined
    unsafe { reply_bytes = @ptrCast([*]u8, &reply) }
    const owed = terminal.takeResponses(screen, reply_bytes, terminal.RESPONSE_CAPACITY)
    if owed > 0 && terminal_state.*.hasChild { pty.write(childOf(terminal_state), reply_bytes, owed) }
    if terminal.takeTitleChange(screen) {
        const title = terminal.titleText(screen)
        host.setTitle(terminal_state.*.host, if title.length > 0 { title } else { "Mlx Terminal" })
    }
    const rang = terminal.takeBell(screen)
    if terminal.takeDirty(screen) { host.redraw(terminal_state.*.host) }
}

// The program wrote: everything waiting, into the screen; the program
// ended: the window closes.
fn readOutput(terminal_state: *Terminal) -> void {
    if !terminal_state.*.hasChild { return }
    const child = childOf(terminal_state)
    const buffer = inputOf(terminal_state)
    var more = true
    while more {
        const got = pty.read(child, buffer, READ_CAPACITY)
        if got > 0 {
            terminal.feed(screenOf(terminal_state), buffer[0..@bitCast(usize, got)])
        } else if got == pty.EAGAIN {
            more = false
        } else {
            // 0 or EIO: the program closed its side.
            more = false
            const status = pty.wait(child)
            terminal_state.*.status = if status == null { 0 } else { @intCast(u8, status.? & 255) }
            host.quit(terminal_state.*.host)
        }
    }
    afterOutput(terminal_state)
}

fn draw(context: *anyopaque, canvas: *app.Canvas) -> void {
    const terminal_state = terminalOf(context)
    if canvas.*.width == 0 || canvas.*.height == 0 { return }
    ui_terminal.draw(viewOf(terminal_state), canvas, ui.rect(0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height)))
}

// The window's size in cells changed: the screen and the program follow.
fn configured(terminal_state: *Terminal, width: i32, height: i32) -> void {
    terminal_state.*.width = width
    terminal_state.*.height = height
    const view = viewOf(terminal_state)
    const columns = ui_terminal.columnsFor(view, width)
    const rows = ui_terminal.rowsFor(view, height)
    if columns != terminal_state.*.columns || rows != terminal_state.*.rows {
        terminal_state.*.columns = columns
        terminal_state.*.rows = rows
        const resized = terminal.resize(screenOf(terminal_state), columns, rows)
        if terminal_state.*.hasChild { pty.resize(childOf(terminal_state), @intCast(u16, columns), @intCast(u16, rows)) }
    }
    host.redraw(terminal_state.*.host)
}

// The window is whole cells: a configured size is rounded down to them
// (the compositor places the smaller window), as xterm does.
fn sizeRule(context: *anyopaque, width: *u32, height: *u32) -> void {
    const view = viewOf(terminalOf(context))
    if width.* > 0 { width.* = @intCast(u32, ui_terminal.pixelWidth(view, ui_terminal.columnsFor(view, @intCast(i32, width.*)))) }
    if height.* > 0 { height.* = @intCast(u32, ui_terminal.pixelHeight(view, ui_terminal.rowsFor(view, @intCast(i32, height.*)))) }
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const terminal_state = terminalOf(context)
    const own_host = terminal_state.*.host
    if kind == app.EVENT_CONFIGURED {
        configured(terminal_state, @intCast(i32, a), b)
    } else if kind == app.EVENT_WATCH {
        readOutput(terminal_state)
    } else if kind == app.EVENT_KEY {
        viewOf(terminal_state).*.focused = true
        if b != 0 {
            var bytes: [16]u8 = undefined
            var bytes_pointer: [*]u8 = undefined
            unsafe { bytes_pointer = @ptrCast([*]u8, &bytes) }
            const length = ui_terminal.key(viewOf(terminal_state), a, host.modifiers(own_host), host.typed(own_host), host.plainTyped(own_host), bytes_pointer)
            if length > 0 && terminal_state.*.hasChild { pty.write(childOf(terminal_state), bytes_pointer, length) }
            if terminal.takeDirty(screenOf(terminal_state)) { host.redraw(own_host) }
        }
    } else if kind == app.EVENT_WHEEL {
        if a == 0 {
            ui_terminal.wheel(viewOf(terminal_state), b)
            if terminal.takeDirty(screenOf(terminal_state)) { host.redraw(own_host) }
        }
    } else if kind == app.EVENT_KEYBOARD_LEAVE {
        viewOf(terminal_state).*.focused = false
        host.redraw(own_host)
    } else if kind == app.EVENT_CLOSED {
        host.quit(own_host)
    }
}

// The program's environment: ours, with TERM and COLORTERM for a
// 256-colour, direct-colour xterm.
fn programEnvironment(entries: [*][*]const u8, allocator: std.allocator.Allocator) -> ?[*][*]const u8 {
    var count: usize = 0
    while @intFromPtr(entries[count]) != 0 { count += 1 }
    const memory = allocator.alloc((count + 3) * @sizeOf([*]const u8), 8)
    if memory == null { return null }
    var result: [*][*]const u8 = undefined
    unsafe { result = @ptrCast([*][*]const u8, memory.?) }
    var used: usize = 0
    var index: usize = 0
    while index < count {
        const entry = std.process.fromCString(entries[index])
        if !std.string.startsWith(entry, std.string.fromSlice("TERM=")) && !std.string.startsWith(entry, std.string.fromSlice("COLORTERM=")) {
            result[used] = entries[index]
            used += 1
        }
        index += 1
    }
    unsafe {
        result[used] = @ptrCast([*]const u8, "TERM=xterm-256color")
        result[used + 1] = @ptrCast([*]const u8, "COLORTERM=truecolor")
        result[used + 2] = @ptrFromInt([*]const u8, 0)
    }
    return result
}

// The shell: $SHELL, else mlx-sh beside this program or where it is
// installed, else /bin/sh.
var shell_path: [4096]u8 = undefined

fn defaultShell(entries: [*][*]const u8) -> [*]const u8 {
    const shell = std.process.environmentFrom(entries, "SHELL")
    if shell != null && shell.?.length > 0 { return shell.?.pointer }
    var candidate: [*]const u8 = undefined
    var own: [*]u8 = undefined
    unsafe {
        own = @ptrCast([*]u8, &shell_path)
        candidate = @ptrCast([*]const u8, "/proc/self/exe")
    }
    const got = std.fs.readLink(candidate, own, 4000)
    if got > 0 {
        var length = @bitCast(usize, got)
        while length > 0 && own[length - 1] != 47 { length -= 1 }
        length = std.text.append(own, length, 4000, "mlx-sh")
        own[length] = 0
        if std.fs.exists(own) { return own }
    }
    unsafe { candidate = @ptrCast([*]const u8, "/usr/local/bin/mlx-sh") }
    if std.fs.exists(candidate) { return candidate }
    unsafe { candidate = @ptrCast([*]const u8, "/usr/bin/mlx-sh") }
    if std.fs.exists(candidate) { return candidate }
    unsafe { candidate = @ptrCast([*]const u8, "/bin/sh") }
    return candidate
}

const Failure = error { Usage, NoMemory, NoFont, NoProgram }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    const said = std.io.eprintln(message)
    return failure
}

pub fn main(arguments: [][*]const u8) -> !void {
    const reporting = crash.install()
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Terminal), 16)
    if memory == null { try fail("mlx-terminal: out of memory", Failure.NoMemory) }
    var terminal_state: *Terminal = undefined
    unsafe { terminal_state = @ptrCast(*Terminal, memory.?) }
    const entries = std.process.environmentEntries(arguments)
    var font_height: usize = @intCast(usize, DEFAULT_FONT_HEIGHT)
    const from_environment = std.process.environmentFrom(entries, "MLX_TERMINAL_FONT_SIZE")
    if from_environment != null { font_height = number(from_environment.?, font_height) }
    var columns = DEFAULT_COLUMNS
    var rows = DEFAULT_ROWS
    const count = std.process.count(arguments)
    var index: usize = 1
    var program_at: usize = 0
    while index < count && program_at == 0 {
        const option = std.process.argument(arguments, index)
        const has_value = index + 1 < count
        if named(option, "--font-size") && has_value {
            font_height = number(std.process.argument(arguments, index + 1), font_height)
            index += 2
        } else if named(option, "--columns") && has_value {
            columns = number(std.process.argument(arguments, index + 1), columns)
            index += 2
        } else if named(option, "--rows") && has_value {
            rows = number(std.process.argument(arguments, index + 1), rows)
            index += 2
        } else if option.length > 0 && option.pointer[0] == 45 {
            try fail("usage: mlx-terminal [--font-size PIXELS] [--columns N] [--rows N] [PROGRAM ARGUMENTS...]", Failure.Usage)
        } else {
            program_at = index
        }
    }
    if font_height < 6 { font_height = 6 }
    if font_height > 96 { font_height = 96 }
    if columns > terminal.MAX_COLUMNS { columns = terminal.MAX_COLUMNS }
    if rows > terminal.MAX_ROWS { rows = terminal.MAX_ROWS }
    terminal_state.*.fontHeight = @intCast(i32, font_height)
    if !text.loadMonoText(monoOf(terminal_state), @intCast(u32, font_height), allocator) { try fail("mlx-terminal: no TrueType font found (DejaVu Sans Mono, Liberation Mono or Noto Sans Mono)", Failure.NoFont) }
    if !terminal.init(screenOf(terminal_state), allocator, columns, rows, HISTORY_LINES) { try fail("mlx-terminal: out of memory for the screen", Failure.NoMemory) }
    ui_terminal.init(viewOf(terminal_state), screenOf(terminal_state), monoOf(terminal_state), terminal_state.*.fontHeight, PADDING)
    terminal_state.*.columns = columns
    terminal_state.*.rows = rows
    terminal_state.*.hasChild = false
    terminal_state.*.status = 0
    const view = viewOf(terminal_state)
    terminal_state.*.width = ui_terminal.pixelWidth(view, columns)
    terminal_state.*.height = ui_terminal.pixelHeight(view, rows)
    const options = host.Options.{ .title = "Mlx Terminal", .appId = "org.mlx.terminal", .width = @intCast(u32, terminal_state.*.width), .height = @intCast(u32, terminal_state.*.height), .minWidth = ui_terminal.pixelWidth(view, 10), .minHeight = ui_terminal.pixelHeight(view, 2) }
    const created = host.create(options, @ptrCast(*anyopaque, terminal_state), draw, onEvent)
    if created == null { try fail("mlx-terminal: out of memory for the window", Failure.NoMemory) }
    terminal_state.*.host = created.?
    host.setSizeRule(terminal_state.*.host, sizeRule)
    try host.open(terminal_state.*.host, arguments)
    // The program: the arguments after the options, or the shell.
    const environment = programEnvironment(entries, allocator)
    if environment == null { try fail("mlx-terminal: out of memory", Failure.NoMemory) }
    var argv: [64][*]const u8 = undefined
    var argv_pointer: [*][*]const u8 = undefined
    unsafe { argv_pointer = @ptrCast([*][*]const u8, &argv) }
    var argc: usize = 0
    if program_at != 0 {
        while program_at + argc < count && argc < 63 {
            unsafe { argv[argc] = @ptrCast([*]const u8, arguments[program_at + argc]) }
            argc += 1
        }
    } else {
        argv[0] = defaultShell(entries)
        argc = 1
    }
    unsafe { argv[argc] = @ptrFromInt([*]const u8, 0) }
    if !pty.spawn(childOf(terminal_state), argv[0], argv_pointer, environment.?, @intCast(u16, columns), @intCast(u16, rows)) { try fail("mlx-terminal: the program could not be started", Failure.NoProgram) }
    terminal_state.*.hasChild = true
    host.watchDescriptor(terminal_state.*.host, childOf(terminal_state).*.master)
    try host.run(terminal_state.*.host)
    pty.hangUp(childOf(terminal_state))
}
