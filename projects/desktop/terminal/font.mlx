// 8x8 bitmap glyphs for ASCII 32..126, from font8x8_basic by Daniel Hepper
// (public domain; derived from the public-domain IBM VGA fonts by Marcel
// Sondaar): https://github.com/dhepper/font8x8
//
// Each glyph packs its 8 rows into a u64, row 0 in the lowest byte. Within
// a row, bit 0 is the leftmost pixel.

pub const WIDTH: usize = 8
pub const HEIGHT: usize = 8

pub fn glyph(character: u8) -> u64 {
