// What Pulsar shows, on brixOS (the native interface; processes.mlx is the
// compatibility path elsewhere): the processes from process_list, the
// machine from system_info, a process ended through a handle of
// process_open and event_send (TERMINATE, or KILL when forced).
const std = @import("std")
const brix = std.os.brix
const model = @import("./model.mlx")

pub const Process = model.Process
pub const System = model.System

pub fn system(into: *System) -> bool {
    var info: brix.SystemInfo = undefined
    if brix.systemInfo(&info) < 0 { return false }
    into.*.memory = @intCast(u64, info.memory)
    into.*.free = @intCast(u64, info.free)
    into.*.processors = @intCast(u32, if info.processors > 0 { info.processors } else { 1 })
    into.*.uptime = @intCast(u64, info.uptime)
    return true
}

// The processes into `into` (at most `capacity`); their count.
pub fn list(into: [*]Process, capacity: usize) -> usize {
    var records: [64]brix.ProcessRecord = undefined
    const pointer: [*]brix.ProcessRecord = &records
    const got = brix.processList(pointer, 64)
    if got < 0 { return 0 }
    var count = @bitCast(usize, got)
    if count > 64 { count = 64 }
    if count > capacity { count = capacity }
    var index: usize = 0
    while index < count {
        const record = records[index]
        var length: usize = 0
        while length < 32 && record.name[length] != 0 {
            into[index].name[length] = record.name[length]
            length += 1
        }
        into[index].nameLength = length
        into[index].pid = record.pid
        into[index].parent = record.parent
        into[index].user = record.user
        into[index].state = if record.state == brix.ProcessState.RUNNING { model.RUNNING } else if record.state == brix.ProcessState.READY { model.READY } else if record.state == brix.ProcessState.STOPPED { model.STOPPED } else if record.state == brix.ProcessState.ENDED { model.ENDED } else { model.SLEEPING }
        into[index].cpuTime = record.cpuTime
        into[index].memory = record.memory
        index += 1
    }
    return count
}

// Ends the process `pid` (TERMINATE: it may tidy up; `force`: KILL);
// false when it may not (another user's) or is gone.
pub fn end(pid: u32, force: bool) -> bool {
    const handle = brix.processOpen(pid)
    if handle < 0 { return false }
    const sent = brix.sendEvent(@intCast(brix.Handle, handle), if force { brix.Event.KILL } else { brix.Event.TERMINATE })
    _ = brix.close(@intCast(brix.Handle, handle))
    return sent >= 0
}

// The accounts (name for a user id): brixOS's own settings.
pub fn usersPath() -> [*]const u8 { return "/system/settings/users\x00".pointer }
