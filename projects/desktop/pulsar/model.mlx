// What Pulsar knows of a process and of the machine, whichever system it
// runs on (processes.brixos.mlx natively, processes.mlx elsewhere).

// A process's state.
pub const RUNNING: u8 = 1
pub const READY: u8 = 2
pub const SLEEPING: u8 = 3
pub const STOPPED: u8 = 4
pub const ENDED: u8 = 5

pub const Process = struct {
    pid: u32
    parent: u32
    user: u32
    state: u8
    // The processor time it used (nanoseconds) and the memory it holds
    // (bytes).
    cpuTime: u64
    memory: u64
    // Its program's name.
    name: [32]u8
    nameLength: usize
}

pub const System = struct {
    // Bytes of memory, and free of them.
    memory: u64
    free: u64
    processors: u32
    // Nanoseconds since the start.
    uptime: u64
}
