// pulsar: the desktop's task manager. What runs, what it takes and how the
// machine fares, in the desktop's colours (std.ui.scheme: the prism of
// the wallpaper): a header of the window's glass with four cards (the
// processors' load with its last minute as a curve, the memory, the
// processes, the time since the start), and the processes as a table set
// into it, sorted by any column (a click on its head; again: the other
// way), each with its load as a bar. A process chosen (a click, the
// arrow keys) is ended with End process (it may tidy up) or Force quit
// (Delete and Shift+Delete).
//
// On brixOS the figures come from the kernel's native calls
// (process_list, system_info; process_open and event_send end a
// process: processes.brixos.mlx); elsewhere from /proc (processes.mlx).
// Ending another user's process is not allowed (the kernel says no; root
// may end any).
//
//     mlx4 projects/desktop/pulsar/main.mlx -o pulsar
const std = @import("std")
const crash = @import("std.crash")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const theme_module = @import("std.ui.theme")
const scheme_module = @import("std.ui.scheme")
const controls = @import("std.ui.controls")
const sidebar_module = @import("std.ui.sidebar")
const host_module = @import("std.ui.host")
const clock = @import("../shared/clock.mlx")
const model = @import("./model.mlx")
const processes = @import("./processes.mlx")

const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Host = host_module.Host
const Process = model.Process

const MAX: usize = 256
// The load's history: a sample a second.
const HISTORY: usize = 60
// Logical pixels.
const HEADER: i32 = 156
const ROW: i32 = 30
const TABLE_TOP: i32 = 40
const FOOTER: i32 = 56
const PAD: i32 = 18

// The columns (sort keys).
const BY_NAME: u8 = 0
const BY_PID: u8 = 1
const BY_USER: u8 = 2
const BY_STATE: u8 = 3
const BY_CPU: u8 = 4
const BY_MEMORY: u8 = 5
const COLUMNS: usize = 6

// Widget ids (view regions).
const ID_ROW: usize = 1000
const ID_HEAD: usize = 2000
const ID_END: usize = 3000
const ID_FORCE: usize = 3001

const KEY_ESCAPE: u32 = 1
const KEY_UP: u32 = 103
const KEY_DOWN: u32 = 108
const KEY_DELETE: u32 = 111
const KEY_PAGE_UP: u32 = 104
const KEY_PAGE_DOWN: u32 = 109

const Pulsar = struct {
    host: *Host
    ready: bool
    german: bool
    scale: i32
    fontScale: i32
    title: Text
    body: Text
    small: Text
    big: Text
    ui: view.Ui
    theme: theme_module.Theme
    // The processes now, and in the order shown (indices).
    list: [256]Process
    count: usize
    order: [256]usize
    // Each one's load (per mille of a processor) since the sample before.
    load: [256]u32
    // The sample before: each process's processor time by pid, and when.
    previousPid: [256]u32
    previousTime: [256]u64
    previousCount: usize
    previousAt: u64
    system: model.System
    // The machine's load (per mille of all processors), a second each, and
    // the memory in use (per mille).
    history: [60]u32
    historyCount: usize
    total: u32
    running: usize
    // The process chosen (its pid; 0: none), the column sorted by and
    // whether the other way.
    chosen: u32
    sortBy: u8
    descending: bool
    // How far the table is scrolled (pixels).
    scroll: i32
    // What the last ending said (0: nothing; 1 ended; 2 refused).
    said: u8
    // The accounts: names by user id.
    userIds: [64]u32
    userNames: [64][24]u8
    userLengths: [64]usize
    userCount: usize
}

fn titleOf(p: *Pulsar) -> *Text { unsafe { return @ptrCast(*Text, &p.*.title) } }
fn bodyOf(p: *Pulsar) -> *Text { unsafe { return @ptrCast(*Text, &p.*.body) } }
fn smallOf(p: *Pulsar) -> *Text { unsafe { return @ptrCast(*Text, &p.*.small) } }
fn bigOf(p: *Pulsar) -> *Text { unsafe { return @ptrCast(*Text, &p.*.big) } }
fn uiOf(p: *Pulsar) -> *view.Ui { unsafe { return @ptrCast(*view.Ui, &p.*.ui) } }
fn themeOf(p: *Pulsar) -> *theme_module.Theme { unsafe { return @ptrCast(*theme_module.Theme, &p.*.theme) } }
fn stateOf(context: *anyopaque) -> *Pulsar { unsafe { return @ptrCast(*Pulsar, context) } }

fn idOf(item: usize) -> u64 { return @intCast(u64, item) + 1 }
fn px(p: *Pulsar, value: i32) -> i32 { return value * p.*.scale }
fn tr(p: *Pulsar, english: []const u8, german: []const u8) -> []const u8 { return if p.*.german { german } else { english } }
fn redraw(p: *Pulsar) -> void { host_module.redraw(p.*.host) }

// ---------------------------------------------------------------------------
// The figures

fn nameOf(process: *const Process) -> []const u8 {
    const bytes: [*]const u8 = &process.*.name
    return bytes[0..process.*.nameLength]
}

// The accounts file (name:x:uid:...) into the names by user id.
fn readUsers(p: *Pulsar) -> void {
    p.*.userCount = 0
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    const size = std.fs.readFile(processes.usersPath(), bytes, 8192)
    var at: usize = 0
    while at < size && p.*.userCount < 64 {
        var end = at
        while end < size && bytes[end] != 10 { end += 1 }
        // name, password, uid.
        var colon = at
        while colon < end && bytes[colon] != 58 { colon += 1 }
        var second = colon + 1
        while second < end && bytes[second] != 58 { second += 1 }
        var uid: u32 = 0
        var digit = second + 1
        var any = false
        while digit < end && bytes[digit] >= 48 && bytes[digit] <= 57 {
            uid = uid * 10 + @intCast(u32, bytes[digit] - 48)
            digit += 1
            any = true
        }
        if any && colon > at {
            const slot = p.*.userCount
            var length: usize = 0
            while at + length < colon && length < 24 {
                p.*.userNames[slot][length] = bytes[at + length]
                length += 1
            }
            p.*.userLengths[slot] = length
            p.*.userIds[slot] = uid
            p.*.userCount += 1
        }
        at = end + 1
    }
}

fn userName(p: *Pulsar, uid: u32, into: [*]u8) -> []const u8 {
    var index: usize = 0
    while index < p.*.userCount {
        if p.*.userIds[index] == uid {
            const bytes: [*]const u8 = &p.*.userNames[index]
            return bytes[0..p.*.userLengths[index]]
        }
        index += 1
    }
    return into[0..std.text.appendUnsigned(into, 0, 12, @intCast(usize, uid))]
}

// Takes a sample: the machine and the processes, each one's load since
// the sample before.
fn sample(p: *Pulsar) -> void {
    const now = @intCast(u64, std.time.milliseconds()) * 1000000
    _ = processes.system(&p.*.system)
    const list_pointer: [*]Process = &p.*.list
    p.*.count = processes.list(list_pointer, MAX)
    const elapsed = if p.*.previousAt != 0 && now > p.*.previousAt { now - p.*.previousAt } else { 0 }
    var used: u64 = 0
    p.*.running = 0
    var index: usize = 0
    while index < p.*.count {
        const process = &p.*.list[index]
        if process.*.state == model.RUNNING || process.*.state == model.READY { p.*.running += 1 }
        p.*.load[index] = 0
        var before: usize = 0
        while before < p.*.previousCount {
            if p.*.previousPid[before] == process.*.pid {
                if elapsed > 0 && process.*.cpuTime >= p.*.previousTime[before] {
                    const spent = process.*.cpuTime - p.*.previousTime[before]
                    used += spent
                    const permille = spent * 1000 / elapsed
                    p.*.load[index] = @intCast(u32, if permille > 64000 { 64000 } else { permille })
                }
                break
            }
            before += 1
        }
        index += 1
    }
    // This sample for the next.
    index = 0
    while index < p.*.count {
        p.*.previousPid[index] = p.*.list[index].pid
        p.*.previousTime[index] = p.*.list[index].cpuTime
        index += 1
    }
    p.*.previousCount = p.*.count
    if elapsed > 0 {
        const all = elapsed * @intCast(u64, p.*.system.processors)
        const permille = used * 1000 / all
        p.*.total = @intCast(u32, if permille > 1000 { 1000 } else { permille })
        if p.*.historyCount == HISTORY {
            var shift: usize = 1
            while shift < HISTORY {
                p.*.history[shift - 1] = p.*.history[shift]
                shift += 1
            }
            p.*.historyCount -= 1
        }
        p.*.history[p.*.historyCount] = p.*.total
        p.*.historyCount += 1
    }
    p.*.previousAt = now
    sortList(p)
}

// Whether the process at `a` goes before the one at `b` in the order
// sorted by.
fn before(p: *Pulsar, a: usize, b: usize) -> bool {
    const x = &p.*.list[a]
    const y = &p.*.list[b]
    var less = false
    var same = false
    if p.*.sortBy == BY_NAME {
        const left = nameOf(x)
        const right = nameOf(y)
        var at: usize = 0
        while at < left.length && at < right.length && left[at] == right[at] { at += 1 }
        if at < left.length && at < right.length {
            less = left[at] < right[at]
        } else {
            less = left.length < right.length
            same = left.length == right.length
        }
    } else if p.*.sortBy == BY_PID {
        less = x.*.pid < y.*.pid
        same = x.*.pid == y.*.pid
    } else if p.*.sortBy == BY_USER {
        less = x.*.user < y.*.user
        same = x.*.user == y.*.user
    } else if p.*.sortBy == BY_STATE {
        less = x.*.state < y.*.state
        same = x.*.state == y.*.state
    } else if p.*.sortBy == BY_CPU {
        // Busiest first unless turned round.
        less = p.*.load[a] > p.*.load[b] || (p.*.load[a] == p.*.load[b] && x.*.cpuTime > y.*.cpuTime)
        same = p.*.load[a] == p.*.load[b] && x.*.cpuTime == y.*.cpuTime
    } else {
        less = x.*.memory > y.*.memory
        same = x.*.memory == y.*.memory
    }
    if same { return x.*.pid < y.*.pid }
    return if p.*.descending { !less } else { less }
}

fn sortList(p: *Pulsar) -> void {
    var index: usize = 0
    while index < p.*.count {
        p.*.order[index] = index
        index += 1
    }
    // Insertion sort (a few hundred at most).
    index = 1
    while index < p.*.count {
        const item = p.*.order[index]
        var at = index
        while at > 0 && before(p, item, p.*.order[at - 1]) {
            p.*.order[at] = p.*.order[at - 1]
            at -= 1
        }
        p.*.order[at] = item
        index += 1
    }
}

// The position of the chosen process in the order (count: none).
fn chosenPosition(p: *Pulsar) -> usize {
    var position: usize = 0
    while position < p.*.count {
        if p.*.list[p.*.order[position]].pid == p.*.chosen { return position }
        position += 1
    }
    return p.*.count
}

fn endChosen(p: *Pulsar, force: bool) -> void {
    if p.*.chosen == 0 { return }
    p.*.said = if processes.end(p.*.chosen, force) { 1 } else { 2 }
    sample(p)
}

// ---------------------------------------------------------------------------
// Words

fn appendText(into: [*]u8, at: usize, text: []const u8) -> usize { return std.text.append(into, at, 60, text) }

fn appendNumber(into: [*]u8, at: usize, value: u64) -> usize { return std.text.appendUnsigned(into, at, at + 20, @intCast(usize, value)) }

// Bytes as KiB, MiB or GiB (one decimal from MiB on).
fn bytesText(into: [*]u8, at: usize, value: u64) -> usize {
    var length = at
    if value < 1024 * 1024 {
        length = appendNumber(into, length, value / 1024)
        return appendText(into, length, " KiB")
    }
    const unit: u64 = if value < 1024 * 1024 * 1024 { 1024 * 1024 } else { 1024 * 1024 * 1024 }
    const tenths = value * 10 / unit
    length = appendNumber(into, length, tenths / 10)
    if tenths < 1000 {
        length = appendText(into, length, ".")
        length = appendNumber(into, length, tenths % 10)
    }
    return appendText(into, length, if unit == 1024 * 1024 { " MiB" } else { " GiB" })
}

// Per mille as a percentage with one decimal under ten.
fn percentText(into: [*]u8, at: usize, permille: u32) -> usize {
    var length = appendNumber(into, at, @intCast(u64, permille / 10))
    if permille < 100 {
        length = appendText(into, length, ".")
        length = appendNumber(into, length, @intCast(u64, permille % 10))
    }
    return appendText(into, length, " %")
}

// Nanoseconds as "3 h 12 min", "4 min 2 s" or "12 s".
fn durationText(into: [*]u8, at: usize, nanoseconds: u64) -> usize {
    const seconds = nanoseconds / 1000000000
    var length = at
    if seconds >= 86400 {
        length = appendNumber(into, length, seconds / 86400)
        length = appendText(into, length, " d ")
        length = appendNumber(into, length, seconds % 86400 / 3600)
        return appendText(into, length, " h")
    }
    if seconds >= 3600 {
        length = appendNumber(into, length, seconds / 3600)
        length = appendText(into, length, " h ")
        length = appendNumber(into, length, seconds % 3600 / 60)
        return appendText(into, length, " min")
    }
    if seconds >= 60 {
        length = appendNumber(into, length, seconds / 60)
        length = appendText(into, length, " min ")
        length = appendNumber(into, length, seconds % 60)
        return appendText(into, length, " s")
    }
    length = appendNumber(into, length, seconds)
    return appendText(into, length, " s")
}

fn stateText(p: *Pulsar, state: u8) -> []const u8 {
    if state == model.RUNNING { return tr(p, "Running", "Läuft") }
    if state == model.READY { return tr(p, "Ready", "Bereit") }
    if state == model.STOPPED { return tr(p, "Stopped", "Angehalten") }
    if state == model.ENDED { return tr(p, "Ended", "Beendet") }
    return tr(p, "Sleeping", "Wartet")
}

// ---------------------------------------------------------------------------
// Drawing

// The prism's gradient at `t` (0 to 1024), at `alpha`.
fn prismAt(t: i32, alpha: u32) -> u32 {
    const at = if t < 0 { 0 } else if t > 1024 { 1024 } else { t }
    const color = if at < 512 { scheme_module.mix(scheme_module.prism(0), scheme_module.prism(1), at * 2) } else { scheme_module.mix(scheme_module.prism(1), scheme_module.prism(2), (at - 512) * 2) }
    return canvas_module.color(alpha, (color >> 16) & 255, (color >> 8) & 255, color & 255)
}

// A horizontal stripe of the prism: `width` x `height` at (x, y), the
// gradient across `span` pixels from x (so bars of one width agree).
fn prismStripe(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, span: i32, alpha: u32) -> void {
    if width <= 0 || height <= 0 { return }
    const step: i32 = 3
    var at: i32 = 0
    while at < width {
        const piece = if width - at < step { width - at } else { step }
        canvas_module.fillRect(canvas, x + at, y, piece, height, prismAt(if span > 0 { at * 1024 / span } else { 0 }, alpha))
        at += step
    }
}

// A card on the header's glass: a pale glass of its own, a prism line
// along its top.
fn card(p: *Pulsar, canvas: *Canvas, area: ui.Rect) -> void {
    const s = p.*.scale
    const light = host_module.lightness(p.*.host) >= 512
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, px(p, 14), if light { canvas_module.color(150, 255, 255, 255) } else { canvas_module.color(26, 255, 255, 255) })
    canvas_module.strokeRoundedRect(canvas, area.x, area.y, area.width, area.height, px(p, 14), s, if light { canvas_module.color(30, 0, 0, 0) } else { canvas_module.color(30, 255, 255, 255) })
    prismStripe(canvas, area.x + px(p, 14), area.y, area.width - px(p, 28), 2 * s, area.width - px(p, 28), 230)
}

// The processors' load: the value and its last minute as a curve filled
// with the prism.
fn cpuCard(p: *Pulsar, canvas: *Canvas, area: ui.Rect) -> void {
    const theme = themeOf(p)
    card(p, canvas, area)
    controls.label(uiOf(p), smallOf(p), tr(p, "Processors", "Prozessoren"), area.x + px(p, 14), area.y + px(p, 12), theme.*.dim, area.width)
    var buffer: [64]u8 = undefined
    const bytes: [*]u8 = &buffer
    const length = percentText(bytes, 0, p.*.total)
    text_module.drawText(canvas, bigOf(p), bytes[0..length], area.x + px(p, 14), area.y + px(p, 28), theme.*.text, 0)
    var cores: [32]u8 = undefined
    const core_bytes: [*]u8 = &cores
    var core_length = appendNumber(core_bytes, 0, @intCast(u64, p.*.system.processors))
    core_length = appendText(core_bytes, core_length, if p.*.system.processors == 1 { tr(p, " core", " Kern") } else { tr(p, " cores", " Kerne") })
    const core_text = core_bytes[0..core_length]
    text_module.drawText(canvas, smallOf(p), core_text, area.x + area.width - px(p, 14) - text_module.measure(smallOf(p), core_text), area.y + px(p, 12), theme.*.dim, 0)
    // The curve: a column a sample, the newest at the right.
    const graph = ui.rect(area.x + px(p, 14), area.y + px(p, 62), area.width - px(p, 28), area.height - px(p, 72))
    if graph.width <= 0 || graph.height <= 0 { return }
    const column = graph.width / @intCast(i32, HISTORY)
    if column <= 0 { return }
    var index: usize = 0
    while index < p.*.historyCount {
        const x = graph.x + graph.width - @intCast(i32, p.*.historyCount - index) * column
        const value = @intCast(i32, p.*.history[index])
        const height = if value * graph.height / 1000 < s1(p) { s1(p) } else { value * graph.height / 1000 }
        const t = (x - graph.x) * 1024 / graph.width
        canvas_module.fillRect(canvas, x, graph.y + graph.height - height, column, height, prismAt(t, 90))
        canvas_module.fillRect(canvas, x, graph.y + graph.height - height, column, px(p, 2), prismAt(t, 255))
        index += 1
    }
}

fn s1(p: *Pulsar) -> i32 { return p.*.scale }

// The memory: what is in use of all, as a bar of the prism.
fn memoryCard(p: *Pulsar, canvas: *Canvas, area: ui.Rect) -> void {
    const theme = themeOf(p)
    card(p, canvas, area)
    controls.label(uiOf(p), smallOf(p), tr(p, "Memory", "Arbeitsspeicher"), area.x + px(p, 14), area.y + px(p, 12), theme.*.dim, area.width)
    const total = p.*.system.memory
    const used = if total > p.*.system.free { total - p.*.system.free } else { 0 }
    var buffer: [64]u8 = undefined
    const bytes: [*]u8 = &buffer
    const length = bytesText(bytes, 0, used)
    text_module.drawText(canvas, bigOf(p), bytes[0..length], area.x + px(p, 14), area.y + px(p, 28), theme.*.text, 0)
    var of: [64]u8 = undefined
    const of_bytes: [*]u8 = &of
    var of_length = appendText(of_bytes, 0, tr(p, "of ", "von "))
    of_length = bytesText(of_bytes, of_length, total)
    text_module.drawText(canvas, smallOf(p), of_bytes[0..of_length], area.x + px(p, 14), area.y + px(p, 64), theme.*.dim, 0)
    const bar = ui.rect(area.x + px(p, 14), area.y + area.height - px(p, 22), area.width - px(p, 28), px(p, 8))
    canvas_module.fillRoundedRect(canvas, bar.x, bar.y, bar.width, bar.height, bar.height / 2, canvas_module.color(40, 255, 255, 255))
    const filled = if total > 0 { @intCast(i32, used * @intCast(u64, bar.width) / total) } else { 0 }
    prismStripe(canvas, bar.x, bar.y, filled, bar.height, bar.width, 255)
}

// A figure and what it is.
fn numberCard(p: *Pulsar, canvas: *Canvas, area: ui.Rect, label: []const u8, value: []const u8, note: []const u8) -> void {
    const theme = themeOf(p)
    card(p, canvas, area)
    controls.label(uiOf(p), smallOf(p), label, area.x + px(p, 14), area.y + px(p, 12), theme.*.dim, area.width)
    text_module.drawText(canvas, bigOf(p), value, area.x + px(p, 14), area.y + px(p, 28), theme.*.text, 0)
    controls.label(uiOf(p), smallOf(p), note, area.x + px(p, 14), area.y + px(p, 64), theme.*.dim, area.width - px(p, 28))
}

// The columns' places: each one's left (x) and width.
fn columnsFor(p: *Pulsar, left: i32, width: i32, xs: *[6]i32, widths: *[6]i32) -> void {
    widths.*[BY_PID] = px(p, 64)
    widths.*[BY_USER] = px(p, 90)
    widths.*[BY_STATE] = px(p, 90)
    widths.*[BY_CPU] = px(p, 130)
    widths.*[BY_MEMORY] = px(p, 96)
    const fixed = widths.*[BY_PID] + widths.*[BY_USER] + widths.*[BY_STATE] + widths.*[BY_CPU] + widths.*[BY_MEMORY]
    widths.*[BY_NAME] = if width - fixed > px(p, 120) { width - fixed } else { px(p, 120) }
    xs.*[BY_NAME] = left
    xs.*[BY_PID] = xs.*[BY_NAME] + widths.*[BY_NAME]
    xs.*[BY_USER] = xs.*[BY_PID] + widths.*[BY_PID]
    xs.*[BY_STATE] = xs.*[BY_USER] + widths.*[BY_USER]
    xs.*[BY_CPU] = xs.*[BY_STATE] + widths.*[BY_STATE]
    xs.*[BY_MEMORY] = xs.*[BY_CPU] + widths.*[BY_CPU]
}

fn columnName(p: *Pulsar, column: usize) -> []const u8 {
    return match column {
        0 => tr(p, "Process", "Prozess"),
        1 => "PID",
        2 => tr(p, "User", "Benutzer"),
        3 => tr(p, "State", "Zustand"),
        4 => "CPU",
        else => tr(p, "Memory", "Speicher")
    }
}

// The table: its heads (a click sorts), its rows (a click chooses).
fn drawTable(p: *Pulsar, canvas: *Canvas, area: ui.Rect) -> void {
    const theme = themeOf(p)
    const context = uiOf(p)
    var xs: [6]i32 = undefined
    var widths: [6]i32 = undefined
    columnsFor(p, area.x + px(p, PAD), area.width - px(p, PAD * 2), &xs, &widths)
    // The heads.
    var column: usize = 0
    while column < COLUMNS {
        const head = ui.rect(xs[column] - px(p, 6), area.y + px(p, 8), widths[column], px(p, 26))
        view.region(context, idOf(ID_HEAD + column), head)
        if view.isHover(context, idOf(ID_HEAD + column)) { canvas_module.fillRoundedRect(canvas, head.x, head.y, head.width, head.height, px(p, 7), theme.*.hover) }
        const sorted = @intCast(usize, p.*.sortBy) == column
        const name = columnName(p, column)
        controls.label(context, smallOf(p), name, xs[column], controls.textTop(smallOf(p), head.y, head.height), if sorted { theme.*.accent } else { theme.*.dim }, widths[column])
        if sorted {
            // The direction: a small triangle after the name.
            const mark_x = xs[column] + text_module.measure(smallOf(p), name) + px(p, 6)
            const mark_y = head.y + head.height / 2
            var row: i32 = 0
            while row < px(p, 4) {
                const half = if p.*.descending { row } else { px(p, 4) - 1 - row }
                canvas_module.fillRect(canvas, mark_x + px(p, 4) - half, mark_y - px(p, 2) + row, half * 2 + 1, 1, theme.*.accent)
                row += 1
            }
        }
        if view.takeClick(context, idOf(ID_HEAD + column)) {
            if sorted { p.*.descending = !p.*.descending } else {
                p.*.sortBy = @intCast(u8, column)
                p.*.descending = false
            }
            sortList(p)
        }
        column += 1
    }
    // The rows, under the heads, clipped to the table.
    const rows = ui.rect(area.x, area.y + px(p, TABLE_TOP), area.width, area.height - px(p, TABLE_TOP))
    // Scrolled by whole rows; only whole rows are drawn (what is drawn
    // here is not cut at the table's edge).
    const fitting = rows.height / px(p, ROW)
    const most = (@intCast(i32, p.*.count) - fitting) * px(p, ROW)
    if p.*.scroll > most { p.*.scroll = most }
    if p.*.scroll < 0 { p.*.scroll = 0 }
    p.*.scroll = p.*.scroll / px(p, ROW) * px(p, ROW)
    view.pushClip(context, rows)
    var position: usize = 0
    while position < p.*.count {
        const y = rows.y + @intCast(i32, position) * px(p, ROW) - p.*.scroll
        if y < rows.y || y + px(p, ROW) > ui.bottom(rows) {
            position += 1
            continue
        }
        const index = p.*.order[position]
        const process = &p.*.list[index]
        const row_area = ui.rect(area.x + px(p, 8), y, area.width - px(p, 16), px(p, ROW - 2))
        const row_id = idOf(ID_ROW + position)
        view.region(context, row_id, row_area)
        const chosen = process.*.pid == p.*.chosen
        if chosen {
            const accent = theme.*.accent
            canvas_module.fillRoundedRect(canvas, row_area.x, row_area.y, row_area.width, row_area.height, px(p, 8), canvas_module.color(70, (accent >> 16) & 255, (accent >> 8) & 255, accent & 255))
        } else if view.isHover(context, row_id) {
            canvas_module.fillRoundedRect(canvas, row_area.x, row_area.y, row_area.width, row_area.height, px(p, 8), theme.*.hover)
        }
        if view.takeClick(context, row_id) {
            p.*.chosen = process.*.pid
            p.*.said = 0
        }
        const text_y = controls.textTop(bodyOf(p), row_area.y, row_area.height)
        // The name, with a dot in the prism's colour for its state.
        const dot = px(p, 8)
        const dot_color = if process.*.state == model.RUNNING || process.*.state == model.READY { prismAt(200, 255) } else if process.*.state == model.STOPPED { prismAt(900, 255) } else { theme.*.disabled }
        canvas_module.fillRoundedRect(canvas, xs[BY_NAME], row_area.y + (row_area.height - dot) / 2, dot, dot, dot / 2, dot_color)
        var fallback: [24]u8 = undefined
        const fallback_bytes: [*]u8 = &fallback
        var name = nameOf(process)
        if name.length == 0 {
            const length = appendNumber(fallback_bytes, appendText(fallback_bytes, 0, "pid "), @intCast(u64, process.*.pid))
            name = fallback_bytes[0..length]
        }
        controls.label(context, bodyOf(p), name, xs[BY_NAME] + px(p, 16), text_y, theme.*.text, widths[BY_NAME] - px(p, 24))
        var buffer: [64]u8 = undefined
        const bytes: [*]u8 = &buffer
        var length = appendNumber(bytes, 0, @intCast(u64, process.*.pid))
        controls.label(context, bodyOf(p), bytes[0..length], xs[BY_PID], text_y, theme.*.dim, widths[BY_PID])
        controls.label(context, bodyOf(p), userName(p, process.*.user, bytes), xs[BY_USER], text_y, theme.*.dim, widths[BY_USER] - px(p, 8))
        controls.label(context, bodyOf(p), stateText(p, process.*.state), xs[BY_STATE], text_y, theme.*.dim, widths[BY_STATE] - px(p, 8))
        // The load: a bar of the prism and the figure.
        const load = p.*.load[index]
        const bar_width = px(p, 56)
        const bar_y = row_area.y + (row_area.height - px(p, 6)) / 2
        canvas_module.fillRoundedRect(canvas, xs[BY_CPU], bar_y, bar_width, px(p, 6), px(p, 3), canvas_module.color(36, 255, 255, 255))
        const per_core = if load > 1000 { 1000 } else { load }
        prismStripe(canvas, xs[BY_CPU], bar_y, @intCast(i32, per_core) * bar_width / 1000, px(p, 6), bar_width, 255)
        length = percentText(bytes, 0, load)
        controls.label(context, bodyOf(p), bytes[0..length], xs[BY_CPU] + bar_width + px(p, 8), text_y, theme.*.text, widths[BY_CPU] - bar_width - px(p, 8))
        length = bytesText(bytes, 0, process.*.memory)
        controls.label(context, bodyOf(p), bytes[0..length], xs[BY_MEMORY], text_y, theme.*.text, widths[BY_MEMORY])
        position += 1
    }
    view.popClip(context)
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const p = stateOf(context)
    if !p.*.ready { return }
    const lightness = host_module.lightness(p.*.host)
    p.*.theme = theme_module.scaled(theme_module.at(lightness), p.*.scale)
    const theme = themeOf(p)
    const widgets = uiOf(p)
    view.begin(widgets, canvas)
    const width = host_module.width(p.*.host)
    const height = host_module.height(p.*.host)
    canvas_module.clear(canvas, 0)
    // The header: the window's glass (as its title bar above), the cards.
    const header = px(p, HEADER)
    sidebar_module.glass(widgets, ui.rect(0, 0, width, header))
    var title: [96]u8 = undefined
    const title_bytes: [*]u8 = &title
    var title_length = appendNumber(title_bytes, 0, @intCast(u64, p.*.count))
    title_length = appendText(title_bytes, title_length, tr(p, " processes, ", " Prozesse, "))
    title_length = appendNumber(title_bytes, title_length, @intCast(u64, p.*.running))
    title_length = appendText(title_bytes, title_length, tr(p, " running", " laufen"))
    text_module.drawText(canvas, titleOf(p), "Pulsar", px(p, PAD), px(p, 10), theme.*.text, 0)
    controls.label(widgets, smallOf(p), title_bytes[0..title_length], px(p, PAD) + text_module.measure(titleOf(p), "Pulsar") + px(p, 12), px(p, 16), theme.*.dim, width / 2)
    const cards_top = px(p, 44)
    const card_height = header - cards_top - px(p, 14)
    const gap = px(p, 12)
    const card_width = (width - px(p, PAD * 2) - gap * 3) / 4
    if card_width > 0 {
        cpuCard(p, canvas, ui.rect(px(p, PAD), cards_top, card_width, card_height))
        memoryCard(p, canvas, ui.rect(px(p, PAD) + card_width + gap, cards_top, card_width, card_height))
        var count_text: [32]u8 = undefined
        const count_bytes: [*]u8 = &count_text
        const count_length = appendNumber(count_bytes, 0, @intCast(u64, p.*.count))
        var note: [64]u8 = undefined
        const note_bytes: [*]u8 = &note
        var note_length = appendNumber(note_bytes, 0, @intCast(u64, p.*.running))
        note_length = appendText(note_bytes, note_length, tr(p, " running now", " laufen gerade"))
        numberCard(p, canvas, ui.rect(px(p, PAD) + (card_width + gap) * 2, cards_top, card_width, card_height), tr(p, "Processes", "Prozesse"), count_bytes[0..count_length], note_bytes[0..note_length])
        var up: [32]u8 = undefined
        const up_bytes: [*]u8 = &up
        const up_length = durationText(up_bytes, 0, p.*.system.uptime)
        numberCard(p, canvas, ui.rect(px(p, PAD) + (card_width + gap) * 3, cards_top, card_width, card_height), tr(p, "Up for", "Läuft seit"), up_bytes[0..up_length], tr(p, "since the start", "seit dem Start"))
    }
    // The table, a card set into the glass, and its footer.
    const footer = px(p, FOOTER)
    sidebar_module.card(widgets, ui.rect(0, header, width, height - header))
    drawTable(p, canvas, ui.rect(0, header, width, height - header - footer))
    const footer_y = height - footer
    canvas_module.fillRect(canvas, px(p, PAD), footer_y, width - px(p, PAD * 2), s1(p), theme.*.divider)
    const chosen = chosenPosition(p) < p.*.count
    const end_label = tr(p, "End process", "Prozess beenden")
    const force_label = tr(p, "Force quit", "Sofort beenden")
    const button_height = px(p, 32)
    const button_y = footer_y + (footer - button_height) / 2
    const end_width = controls.buttonWidth(widgets, bodyOf(p), end_label)
    const force_width = controls.buttonWidth(widgets, bodyOf(p), force_label)
    const end_x = width - px(p, PAD) - end_width
    const force_x = end_x - px(p, 10) - force_width
    if controls.button(widgets, idOf(ID_FORCE), ui.rect(force_x, button_y, force_width, button_height), force_label, controls.BUTTON_NORMAL, chosen) { endChosen(p, true) }
    if controls.button(widgets, idOf(ID_END), ui.rect(end_x, button_y, end_width, button_height), end_label, controls.BUTTON_PRIMARY, chosen) { endChosen(p, false) }
    // What is chosen, or what the last ending said.
    var status: [96]u8 = undefined
    const status_bytes: [*]u8 = &status
    var status_length: usize = 0
    var status_color = theme.*.dim
    if p.*.said == 2 {
        status_length = appendText(status_bytes, 0, tr(p, "Not allowed: another user's process", "Nicht erlaubt: Prozess eines anderen Benutzers"))
        status_color = theme.*.danger
    } else if p.*.said == 1 {
        status_length = appendText(status_bytes, 0, tr(p, "Told to end", "Zum Beenden aufgefordert"))
    } else if chosen {
        const process = &p.*.list[p.*.order[chosenPosition(p)]]
        status_length = appendText(status_bytes, 0, nameOf(process))
        status_length = appendText(status_bytes, status_length, tr(p, " has used ", " hat bisher "))
        status_length = durationText(status_bytes, status_length, process.*.cpuTime)
        status_length = appendText(status_bytes, status_length, tr(p, " of processor time", " Prozessorzeit gebraucht"))
    } else {
        status_length = appendText(status_bytes, 0, tr(p, "Choose a process to end it", "Einen Prozess wählen, um ihn zu beenden"))
    }
    controls.label(widgets, smallOf(p), status_bytes[0..status_length], px(p, PAD), controls.textTop(smallOf(p), footer_y, footer), status_color, force_x - px(p, PAD * 2))
    if view.end(widgets) { redraw(p) }
}

// ---------------------------------------------------------------------------
// Events

fn layOut(context: *anyopaque) -> void {
    var nowhere = view.layoutCanvas()
    draw(context, &nowhere)
}

// Moves the choice `by` places in the order, keeping it in sight.
fn moveChoice(p: *Pulsar, by: i32) -> void {
    if p.*.count == 0 { return }
    var position = @intCast(i32, chosenPosition(p))
    if position >= @intCast(i32, p.*.count) { position = if by > 0 { -1 } else { @intCast(i32, p.*.count) } }
    position += by
    if position < 0 { position = 0 }
    if position >= @intCast(i32, p.*.count) { position = @intCast(i32, p.*.count) - 1 }
    p.*.chosen = p.*.list[p.*.order[@intCast(usize, position)]].pid
    p.*.said = 0
    const top = position * px(p, ROW)
    const visible = host_module.height(p.*.host) - px(p, HEADER + TABLE_TOP + FOOTER)
    if top < p.*.scroll { p.*.scroll = top }
    if top + px(p, ROW) > p.*.scroll + visible { p.*.scroll = top + px(p, ROW) - visible }
}

fn fitScale(p: *Pulsar) -> void {
    const scale = host_module.scale(p.*.host)
    p.*.scale = scale
    if scale == p.*.fontScale { return }
    if p.*.fontScale != 0 {
        text_module.unloadText(titleOf(p))
        text_module.unloadText(bodyOf(p))
        text_module.unloadText(smallOf(p))
        text_module.unloadText(bigOf(p))
    }
    p.*.fontScale = scale
    const factor = @intCast(u32, scale)
    const allocator = std.heap.allocator()
    _ = text_module.loadText(titleOf(p), 20 * factor, allocator)
    _ = text_module.loadText(bodyOf(p), 13 * factor, allocator)
    _ = text_module.loadText(smallOf(p), 12 * factor, allocator)
    _ = text_module.loadText(bigOf(p), 26 * factor, allocator)
    p.*.theme = theme_module.scaled(theme_module.dark(), scale)
    view.init(uiOf(p), themeOf(p), bodyOf(p), smallOf(p), bodyOf(p))
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const p = stateOf(context)
    if !p.*.ready { return }
    if kind == ui_app.EVENT_CLOSED {
        host_module.quit(p.*.host)
        return
    }
    if kind == ui_app.EVENT_CONFIGURED {
        fitScale(p)
        // Blur behind the whole window: the header's glass, the table's
        // translucent card.
        var rects: [4]i32 = [4]i32{ 0, 0, host_module.width(p.*.host), host_module.height(p.*.host) }
        host_module.setBlur(p.*.host, &rects, 1)
        redraw(p)
        return
    }
    if kind == ui_app.EVENT_TICK {
        sample(p)
        redraw(p)
        return
    }
    if kind == ui_app.EVENT_KEY {
        if b == 0 { return }
        if a == KEY_ESCAPE { host_module.quit(p.*.host) }
        if a == KEY_UP { moveChoice(p, -1) }
        if a == KEY_DOWN { moveChoice(p, 1) }
        if a == KEY_PAGE_UP { moveChoice(p, -10) }
        if a == KEY_PAGE_DOWN { moveChoice(p, 10) }
        if a == KEY_DELETE && b == 1 { endChosen(p, host_module.modifiers(p.*.host) & 1 != 0) }
        redraw(p)
        return
    }
    const widgets = uiOf(p)
    if ui_app.pressing(kind, a, b) { layOut(context) }
    const fed = ui_app.feed(widgets, kind, a, b)
    if fed == ui_app.FEED_CLICK { layOut(context) }
    if kind == ui_app.EVENT_WHEEL && a == 0 {
        var pixels = host_module.wheelPixels(p.*.host)
        if pixels == 0 { pixels = b * px(p, ROW * 3) }
        p.*.scroll += pixels
        redraw(p)
        return
    }
    if fed != ui_app.FEED_NONE { redraw(p) }
}

pub fn main(arguments: [][*]const u8) -> !void {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(Pulsar), 16)
    if memory == null { return }
    const p: *Pulsar = unsafe { @ptrCast(*Pulsar, memory.?) }
    p.*.ready = false
    p.*.scale = 1
    p.*.fontScale = 0
    p.*.count = 0
    p.*.previousCount = 0
    p.*.previousAt = 0
    p.*.historyCount = 0
    p.*.total = 0
    p.*.running = 0
    p.*.chosen = 0
    p.*.sortBy = BY_CPU
    p.*.descending = false
    p.*.scroll = 0
    p.*.said = 0
    p.*.system = model.System.{ .memory = 0, .free = 0, .processors = 1, .uptime = 0 }
    const host = host_module.create(host_module.Options.{ .title = "Pulsar", .appId = "org.mlx.pulsar", .width = 900, .height = 620, .minWidth = 640, .minHeight = 420 }, p, draw, onEvent)
    if host == null { return }
    p.*.host = host.?
    try host_module.open(p.*.host, arguments)
    p.*.german = clock.germanLocale(host_module.environment(p.*.host))
    readUsers(p)
    fitScale(p)
    host_module.setTitle(p.*.host, tr(p, "Task Manager", "Aufgabenverwaltung"))
    // A first sample, and the next soon after: the loads need two.
    sample(p)
    host_module.setTick(p.*.host, 1000)
    p.*.ready = true
    redraw(p)
    try host_module.run(p.*.host)
}
