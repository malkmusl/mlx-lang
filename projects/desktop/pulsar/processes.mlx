// What Pulsar shows, on Linux (the compatibility path; brixOS's native one
// is processes.brixos.mlx): /proc's figures, a process ended by kill(2)
// (SIGTERM, or SIGKILL when forced).
const std = @import("std")
const model = @import("./model.mlx")

pub const Process = model.Process
pub const System = model.System

// The clock ticks of /proc/PID/stat a second (USER_HZ).
const TICKS: u64 = 100

// A file's start into `into` (at most `capacity` bytes); its length.
fn readFile(path: [*]const u8, into: [*]u8, capacity: usize) -> usize {
    const size = std.fs.readFile(path, into, capacity)
    return if size > capacity { capacity } else { size }
}

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

// The number at `at` in `text` (after spaces), moving `at` past it.
fn number(text: []const u8, at: *usize) -> u64 {
    while at.* < text.length && (text[at.*] == 32 || text[at.*] == 9) { at.* += 1 }
    var value: u64 = 0
    while at.* < text.length && isDigit(text[at.*]) {
        value = value * 10 + @intCast(u64, text[at.*] - 48)
        at.* += 1
    }
    return value
}

// The value of the line starting with `key` in `text` (a number of kB for
// /proc/meminfo).
fn keyed(text: []const u8, key: []const u8) -> u64 {
    var at: usize = 0
    while at + key.length < text.length {
        if (at == 0 || text[at - 1] == 10) && std.text.same(text[at..at + key.length], key) {
            var from = at + key.length
            return number(text, &from)
        }
        at += 1
    }
    return 0
}

pub fn system(into: *System) -> bool {
    var buffer: [4096]u8 = undefined
    const bytes: [*]u8 = &buffer
    const size = readFile("/proc/meminfo\x00".pointer, bytes, 4096)
    if size == 0 { return false }
    into.*.memory = keyed(bytes[0..size], "MemTotal:") * 1024
    into.*.free = keyed(bytes[0..size], "MemAvailable:") * 1024
    // The processors: the "cpuN" lines of /proc/stat.
    const stat_size = readFile("/proc/stat\x00".pointer, bytes, 4096)
    var processors: u32 = 0
    var at: usize = 0
    while at + 4 < stat_size {
        if (at == 0 || bytes[at - 1] == 10) && bytes[at] == 99 && bytes[at + 1] == 112 && bytes[at + 2] == 117 && isDigit(bytes[at + 3]) { processors += 1 }
        at += 1
    }
    into.*.processors = if processors > 0 { processors } else { 1 }
    const uptime_size = readFile("/proc/uptime\x00".pointer, bytes, 64)
    var from: usize = 0
    const seconds = number(bytes[0..uptime_size], &from)
    var hundredths: u64 = 0
    if from < uptime_size && bytes[from] == 46 {
        from += 1
        hundredths = number(bytes[0..uptime_size], &from)
    }
    into.*.uptime = seconds * 1000000000 + hundredths * 10000000
    return true
}

// One process from /proc/PID (its directory's path, NUL-terminated, in
// `path` with `length` bytes before the NUL); false when it went.
fn one(path: [*]u8, length: usize, into: *Process) -> bool {
    var buffer: [2048]u8 = undefined
    const bytes: [*]u8 = &buffer
    _ = std.text.append(path, length, 250, "/stat")
    path[length + 5] = 0
    const size = readFile(path, bytes, 2048)
    if size == 0 { return false }
    const text = bytes[0..size]
    // "PID (NAME) S PPID ...": the name is between the first ( and the
    // last ).
    var open: usize = 0
    while open < size && bytes[open] != 40 { open += 1 }
    var close = size
    while close > open && bytes[close - 1] != 41 { close -= 1 }
    if close <= open + 1 { return false }
    close -= 1
    var at: usize = 0
    into.*.pid = @intCast(u32, number(text, &at))
    var name_length: usize = 0
    while open + 1 + name_length < close && name_length < 32 {
        into.*.name[name_length] = bytes[open + 1 + name_length]
        name_length += 1
    }
    into.*.nameLength = name_length
    at = close + 2
    const state = if at < size { bytes[at] } else { 83 }
    into.*.state = if state == 82 { model.RUNNING } else if state == 84 || state == 116 { model.STOPPED } else if state == 90 || state == 88 { model.ENDED } else { model.SLEEPING }
    at += 1
    into.*.parent = @intCast(u32, number(text, &at))
    // Fields 5 to 13, then utime (14) and stime (15).
    var field: usize = 5
    while field < 14 {
        _ = number(text, &at)
        // (Fields may be negative: a sign is skipped.)
        while at < size && bytes[at] == 45 { at += 1 }
        field += 1
    }
    const ticks = number(text, &at) + number(text, &at)
    into.*.cpuTime = ticks * (1000000000 / TICKS)
    // The resident pages (statm's second field).
    _ = std.text.append(path, length, 250, "/statm")
    path[length + 6] = 0
    const statm_size = readFile(path, bytes, 256)
    var statm_at: usize = 0
    _ = number(bytes[0..statm_size], &statm_at)
    into.*.memory = number(bytes[0..statm_size], &statm_at) * 4096
    // The user (status's "Uid:").
    _ = std.text.append(path, length, 250, "/status")
    path[length + 7] = 0
    const status_size = readFile(path, bytes, 2048)
    into.*.user = @intCast(u32, keyed(bytes[0..status_size], "Uid:"))
    return true
}

// The processes into `into` (at most `capacity`); their count.
pub fn list(into: [*]Process, capacity: usize) -> usize {
    const handle = std.linux.syscall3(std.linux.SYS_open, @intFromPtr("/proc\x00".pointer), std.linux.O_DIRECTORY | std.linux.O_CLOEXEC, 0)
    if handle < 0 { return 0 }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    var reader = std.fs.entries(std.fs.File.{ .descriptor = handle }, bytes, 8192)
    var entry: std.fs.Entry = undefined
    var count: usize = 0
    while count < capacity && std.fs.nextEntry(&reader, &entry) {
        const name = entry.name.pointer[0..entry.name.length]
        if name.length == 0 || !isDigit(name[0]) { continue }
        var path: [256]u8 = undefined
        const path_bytes: [*]u8 = &path
        var length = std.text.append(path_bytes, 0, 250, "/proc/")
        length = std.text.append(path_bytes, length, 250, name)
        if one(path_bytes, length, &into[count]) { count += 1 }
    }
    std.linux.close(handle)
    return count
}

// Ends the process `pid` (SIGTERM; `force`: SIGKILL); false when it may
// not, or is gone.
pub fn end(pid: u32, force: bool) -> bool {
    return std.linux.process.kill(@intCast(isize, pid), if force { 9 } else { 15 }) == 0
}

// The accounts (name for a user id).
pub fn usersPath() -> [*]const u8 { return "/etc/passwd\x00".pointer }
