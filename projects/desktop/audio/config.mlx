// What MLX Audio keeps between runs: ~/.config/mlx/audio.conf
// ($XDG_CONFIG_HOME respected), written whole whenever mlx-settings
// changes something:
//
//   output = auto            auto, alsa:pcmC1D0p, null, file:PATH.wav
//   input = auto             auto, alsa:NAME, none, sine:HZ, file:PATH.wav
//   volume = 100             percent (up to 150)
//   mute = off
//   input-volume = 100
//   input-mute = off
//   sink = music <tab> output <tab> 100 <tab> off
//                            a virtual sink: where its mix goes (output or
//                            none), its volume and mute (routing.mlx)
//   app = firefox <tab> 80 <tab> off <tab> music
//                            an app's volume, mute and sink (empty: the
//                            default one)
//
// --output and --input given to mlx-audiod win over the file.
const std = @import("std")
const state = @import("./state.mlx")
const devices = @import("./devices.mlx")
const routing = @import("./routing.mlx")

const O_CLOEXEC: usize = 524288

fn append(server: *state.Server, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length && server.*.configPathLength < 240 {
        server.*.configPath[server.*.configPathLength] = text[index]
        server.*.configPathLength += 1
        index += 1
    }
    server.*.configPath[server.*.configPathLength] = 0
}

fn pathOf(server: *state.Server) -> [*]const u8 {
    return &server.*.configPath
}

// Finds the file's path (0 length: no home).
pub fn locate(server: *state.Server) -> void {
    server.*.configPathLength = 0
    const config = std.process.environmentFrom(server.*.environment, "XDG_CONFIG_HOME")
    if config != null && config.?.length > 0 {
        append(server, std.string.asSlice(config.?))
    } else {
        const home = std.process.environmentFrom(server.*.environment, "HOME")
        if home == null || home.?.length == 0 { return }
        append(server, std.string.asSlice(home.?))
        append(server, "/.config")
    }
    append(server, "/mlx/audio.conf")
}

fn percent(text: []const u8, fallback: u32) -> u32 {
    if text.length == 0 || text.length > 3 { return fallback }
    var value: u32 = 0
    var index: usize = 0
    while index < text.length {
        if text[index] < 48 || text[index] > 57 { return fallback }
        value = value * 10 + @intCast(u32, text[index] - 48)
        index += 1
    }
    if value > 150 { value = 150 }
    return value * 65536 / 100
}

fn switchOf(text: []const u8) -> bool { return std.text.same(text, "on") || std.text.same(text, "yes") || std.text.same(text, "true") || std.text.same(text, "1") }

// The tab-separated field `index` of `text` (empty when there is none).
fn field(text: []const u8, index: usize) -> []const u8 {
    var at: usize = 0
    var count: usize = 0
    while count < index {
        while at < text.length && text[at] != 9 { at += 1 }
        if at >= text.length { return text[0..0] }
        at += 1
        count += 1
    }
    var end = at
    while end < text.length && text[end] != 9 { end += 1 }
    return std.text.trimmed(text[at..end])
}

// "sink = NAME <tab> output|none <tab> PERCENT <tab> on|off".
fn loadSink(server: *state.Server, value: []const u8) -> void {
    const name = field(value, 0)
    if !routing.addSink(server, name, if std.text.same(field(value, 1), "none") { state.TO_NOTHING } else { state.TO_OUTPUT }) { return }
    const sink = routing.sinkAt(server, routing.findSink(server, name) - 1)
    sink.*.volume = percent(field(value, 2), sink.*.volume)
    sink.*.mute = switchOf(field(value, 3))
}

// "app = NAME <tab> PERCENT <tab> on|off <tab> SINK".
fn loadApp(server: *state.Server, value: []const u8) -> void {
    const slot = routing.appFor(server, field(value, 0))
    if slot == state.MAX_APPS { return }
    const app = routing.appAt(server, slot)
    app.*.volume = percent(field(value, 1), app.*.volume)
    app.*.mute = switchOf(field(value, 2))
    const sink = field(value, 3)
    if sink.length > 0 { _ = routing.setAppSink(server, field(value, 0), sink) }
}

// Reads the file (what it leaves out stays as it is).
pub fn load(server: *state.Server) -> void {
    if server.*.configPathLength == 0 { return }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    const file = std.fs.open(pathOf(server), O_CLOEXEC, 0)
    if file.descriptor < 0 { return }
    const got = std.fs.read(file, bytes, 8192)
    _ = std.fs.close(file)
    if got <= 0 { return }
    const length = @intCast(usize, got)
    var at: usize = 0
    while at < length {
        var end = at
        while end < length && buffer[end] != 10 { end += 1 }
        const line = std.text.trimmed(bytes[at..end])
        var equals: usize = 0
        while equals < line.length && line[equals] != 61 { equals += 1 }
        if line.length > 0 && line[0] != 35 && equals < line.length {
            const key = std.text.trimmed(line[0..equals])
            const value = std.text.trimmed(line[equals + 1..line.length])
            if std.text.same(key, "output") && value.length > 0 { devices.setOutputSpec(server, value) }
            if std.text.same(key, "input") && value.length > 0 { devices.setInputSpec(server, value) }
            if std.text.same(key, "volume") { server.*.master = percent(value, server.*.master) }
            if std.text.same(key, "mute") { server.*.mute = switchOf(value) }
            if std.text.same(key, "input-volume") { server.*.inputVolume = percent(value, server.*.inputVolume) }
            if std.text.same(key, "input-mute") { server.*.inputMute = switchOf(value) }
            if std.text.same(key, "sink") { loadSink(server, value) }
            if std.text.same(key, "app") { loadApp(server, value) }
        }
        at = end + 1
    }
}

fn put(bytes: [*]u8, at: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && at + index < 8000 {
        bytes[at + index] = text[index]
        index += 1
    }
    return at + index
}

fn putPercent(bytes: [*]u8, at: usize, volume: u32) -> usize {
    var value = (volume * 100 + 32768) / 65536
    var digits: [4]u8 = undefined
    var count: usize = 0
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value = value / 10
        if value == 0 { break }
    }
    var length = at
    while count > 0 {
        count -= 1
        bytes[length] = digits[count]
        length += 1
    }
    return length
}

// Writes the file whole (as NAME.new, renamed over it).
pub fn save(server: *state.Server) -> void {
    if server.*.configPathLength == 0 { return }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    var length = put(bytes, 0, "# MLX Audio (mlx-settings writes this file).\noutput = ")
    length = put(bytes, length, devices.outputSpec(server))
    length = put(bytes, length, "\ninput = ")
    length = put(bytes, length, devices.inputSpec(server))
    length = put(bytes, length, "\nvolume = ")
    length = putPercent(bytes, length, server.*.master)
    length = put(bytes, length, if server.*.mute { "\nmute = on\ninput-volume = " } else { "\nmute = off\ninput-volume = " })
    length = putPercent(bytes, length, server.*.inputVolume)
    length = put(bytes, length, if server.*.inputMute { "\ninput-mute = on\n" } else { "\ninput-mute = off\n" })
    var slot: usize = 0
    while slot < state.MAX_SINKS {
        const sink = routing.sinkAt(server, slot)
        if sink.*.used {
            length = put(bytes, length, "sink = ")
            length = put(bytes, length, routing.sinkName(sink))
            length = put(bytes, length, if sink.*.target == state.TO_OUTPUT { "\toutput\t" } else { "\tnone\t" })
            length = putPercent(bytes, length, sink.*.volume)
            length = put(bytes, length, if sink.*.mute { "\ton\n" } else { "\toff\n" })
        }
        slot += 1
    }
    slot = 0
    while slot < state.MAX_APPS {
        const app = routing.appAt(server, slot)
        if app.*.used && routing.customized(app) {
            length = put(bytes, length, "app = ")
            length = put(bytes, length, routing.appName(app))
            length = put(bytes, length, "\t")
            length = putPercent(bytes, length, app.*.volume)
            length = put(bytes, length, if app.*.mute { "\ton\t" } else { "\toff\t" })
            length = put(bytes, length, routing.appSinkName(app))
            length = put(bytes, length, "\n")
        }
        slot += 1
    }
    // The directory (~/.config/mlx) may not be there yet.
    var directory: [256]u8 = undefined
    const directory_bytes: [*]u8 = &directory
    var end = server.*.configPathLength
    while end > 0 && server.*.configPath[end - 1] != 47 { end -= 1 }
    var index: usize = 0
    while index + 1 < end {
        directory[index] = server.*.configPath[index]
        // Each directory on the way (mkdir -p).
        if server.*.configPath[index] == 47 && index > 0 {
            directory[index] = 0
            _ = std.fs.makeDir(directory_bytes, 493)
            directory[index] = 47
        }
        index += 1
    }
    directory[index] = 0
    _ = std.fs.makeDir(directory_bytes, 493)
    var temporary: [264]u8 = undefined
    const temporary_bytes: [*]u8 = &temporary
    index = 0
    while index < server.*.configPathLength {
        temporary[index] = server.*.configPath[index]
        index += 1
    }
    const suffix = ".new"
    var at: usize = 0
    while at < 4 {
        temporary[index + at] = suffix[at]
        at += 1
    }
    temporary[index + 4] = 0
    // O_WRONLY | O_CREAT | O_TRUNC
    const file = std.fs.open(temporary_bytes, 577, 420)
    if file.descriptor < 0 { return }
    const written = std.fs.writeAllBytes(file, bytes, length)
    _ = std.fs.close(file)
    if written { _ = std.fs.rename(temporary_bytes, pathOf(server)) }
}
