// What MLX Audio keeps between runs: ~/.config/mlx/audio.conf
// ($XDG_CONFIG_HOME respected), written whole whenever mlx-settings
// changes something:
//
//   output = auto            auto, alsa:pcmC1D0p, null, file:PATH.wav
//   input = auto             auto, alsa:NAME, none, sine:HZ, file:PATH.wav
//   volume = 100             percent (up to 150)
//   mute = off
//   input-volume = 100
//   input-mute = off
//
// --output and --input given to mlx-audiod win over the file.
const std = @import("std")
const state = @import("./state.mlx")
const devices = @import("./devices.mlx")

const O_CLOEXEC: usize = 524288

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn trimmed(text: []const u8) -> []const u8 {
    var start: usize = 0
    var end = text.length
    while start < end && (text[start] == 32 || text[start] == 9) { start += 1 }
    while end > start && (text[end - 1] == 32 || text[end - 1] == 9 || text[end - 1] == 13) { end -= 1 }
    return text[start..end]
}

fn append(server: *state.Server, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length && server.*.configPathLength < 240 {
        server.*.configPath[server.*.configPathLength] = text[index]
        server.*.configPathLength += 1
        index += 1
    }
    server.*.configPath[server.*.configPathLength] = 0
}

fn pathOf(server: *state.Server) -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, &server.*.configPath) }
}

// Finds the file's path (0 length: no home).
pub fn locate(server: *state.Server) -> void {
    server.*.configPathLength = 0
    const config = std.process.environmentFrom(server.*.environment, "XDG_CONFIG_HOME")
    if config != null && config.?.length > 0 {
        append(server, std.string.asSlice(config.?))
    } else {
        const home = std.process.environmentFrom(server.*.environment, "HOME")
        if home == null || home.?.length == 0 { return }
        append(server, std.string.asSlice(home.?))
        append(server, "/.config")
    }
    append(server, "/mlx/audio.conf")
}

fn percent(text: []const u8, fallback: u32) -> u32 {
    if text.length == 0 || text.length > 3 { return fallback }
    var value: u32 = 0
    var index: usize = 0
    while index < text.length {
        if text[index] < 48 || text[index] > 57 { return fallback }
        value = value * 10 + @intCast(u32, text[index] - 48)
        index += 1
    }
    if value > 150 { value = 150 }
    return value * 65536 / 100
}

fn switchOf(text: []const u8) -> bool { return same(text, "on") || same(text, "yes") || same(text, "true") || same(text, "1") }

// Reads the file (what it leaves out stays as it is).
pub fn load(server: *state.Server) -> void {
    if server.*.configPathLength == 0 { return }
    var buffer: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    const file = std.fs.open(pathOf(server), O_CLOEXEC, 0)
    if file.descriptor < 0 { return }
    const got = std.fs.read(file, bytes, 4096)
    const closed = std.fs.close(file)
    if got <= 0 { return }
    const length = @intCast(usize, got)
    var at: usize = 0
    while at < length {
        var end = at
        while end < length && buffer[end] != 10 { end += 1 }
        const line = trimmed(bytes[at..end])
        var equals: usize = 0
        while equals < line.length && line[equals] != 61 { equals += 1 }
        if line.length > 0 && line[0] != 35 && equals < line.length {
            const key = trimmed(line[0..equals])
            const value = trimmed(line[equals + 1..line.length])
            if same(key, "output") && value.length > 0 { devices.setOutputSpec(server, value) }
            if same(key, "input") && value.length > 0 { devices.setInputSpec(server, value) }
            if same(key, "volume") { server.*.master = percent(value, server.*.master) }
            if same(key, "mute") { server.*.mute = switchOf(value) }
            if same(key, "input-volume") { server.*.inputVolume = percent(value, server.*.inputVolume) }
            if same(key, "input-mute") { server.*.inputMute = switchOf(value) }
        }
        at = end + 1
    }
}

fn put(bytes: [*]u8, at: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && at + index < 4000 {
        bytes[at + index] = text[index]
        index += 1
    }
    return at + index
}

fn putPercent(bytes: [*]u8, at: usize, volume: u32) -> usize {
    var value = (volume * 100 + 32768) / 65536
    var digits: [4]u8 = undefined
    var count: usize = 0
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value = value / 10
        if value == 0 { break }
    }
    var length = at
    while count > 0 {
        count -= 1
        bytes[length] = digits[count]
        length += 1
    }
    return length
}

// Writes the file whole (as NAME.new, renamed over it).
pub fn save(server: *state.Server) -> void {
    if server.*.configPathLength == 0 { return }
    var buffer: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var length = put(bytes, 0, "# MLX Audio (mlx-settings writes this file).\noutput = ")
    length = put(bytes, length, devices.outputSpec(server))
    length = put(bytes, length, "\ninput = ")
    length = put(bytes, length, devices.inputSpec(server))
    length = put(bytes, length, "\nvolume = ")
    length = putPercent(bytes, length, server.*.master)
    length = put(bytes, length, if server.*.mute { "\nmute = on\ninput-volume = " } else { "\nmute = off\ninput-volume = " })
    length = putPercent(bytes, length, server.*.inputVolume)
    length = put(bytes, length, if server.*.inputMute { "\ninput-mute = on\n" } else { "\ninput-mute = off\n" })
    // The directory (~/.config/mlx) may not be there yet.
    var directory: [256]u8 = undefined
    var directory_bytes: [*]u8 = undefined
    unsafe { directory_bytes = @ptrCast([*]u8, &directory) }
    var end = server.*.configPathLength
    while end > 0 && server.*.configPath[end - 1] != 47 { end -= 1 }
    var index: usize = 0
    while index + 1 < end {
        directory[index] = server.*.configPath[index]
        // Each directory on the way (mkdir -p).
        if server.*.configPath[index] == 47 && index > 0 {
            directory[index] = 0
            const parent = std.fs.makeDir(directory_bytes, 493)
            directory[index] = 47
        }
        index += 1
    }
    directory[index] = 0
    const made = std.fs.makeDir(directory_bytes, 493)
    var temporary: [264]u8 = undefined
    var temporary_bytes: [*]u8 = undefined
    unsafe { temporary_bytes = @ptrCast([*]u8, &temporary) }
    index = 0
    while index < server.*.configPathLength {
        temporary[index] = server.*.configPath[index]
        index += 1
    }
    const suffix = ".new"
    var at: usize = 0
    while at < 4 {
        temporary[index + at] = suffix[at]
        at += 1
    }
    temporary[index + 4] = 0
    // O_WRONLY | O_CREAT | O_TRUNC
    const file = std.fs.open(temporary_bytes, 577, 420)
    if file.descriptor < 0 { return }
    const written = std.fs.writeAllBytes(file, bytes, length)
    const closed = std.fs.close(file)
    if written { const renamed = std.fs.rename(temporary_bytes, pathOf(server)) }
}
