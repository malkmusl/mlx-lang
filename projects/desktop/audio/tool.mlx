// mlx-audio: MLX Audio from the command line, on std.audio (MLXIPC; no
// libc, no PipeWire).
//
//   mlx-audio play FILE.wav        plays a WAVE file (8, 16, 24 or 32 bits,
//                                  or float; any rate and channels)
//   mlx-audio tone HZ SECONDS      plays a tone
//   mlx-audio record FILE.wav SECONDS
//                                  records (16-bit; --rate HZ, --channels N)
//   mlx-audio streams              what plays and records now
//   mlx-audio volume PERCENT       the output's volume
//
//   --volume PERCENT               the stream's volume (play, tone)
//   --latency MS                   how much the server buffers (default 100)
//
// A stream the app may not have (audio.play, audio.record in
// ~/.config/mlx/ipc.conf) is refused, and it says so.
const std = @import("std")
const audio = @import("std.audio")
const wav = @import("std.wav")
const crash = @import("std.crash")

const Failure = error { Usage, NoServer, Refused, NoFile, Lost }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    if message.length > 0 { const said = std.io.eprintln(message) }
    return failure
}

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn number(text: std.string.String) -> u32 {
    var value: u32 = 0
    var index: usize = 0
    while index < text.length && text.pointer[index] >= 48 && text.pointer[index] <= 57 {
        value = value * 10 + @intCast(u32, text.pointer[index] - 48)
        index += 1
    }
    return value
}

fn sayNumber(value: usize) -> void { const ignored = std.io.writeUnsigned(std.io.stdout(), value) }

// The stream refused, or open: says why it was refused.
fn opened(connection: *audio.Audio, stream: u32) -> !void {
    if stream == 0 { return fail("mlx-audio: MLX Audio went", Failure.Lost) }
    const reason = audio.refusal(connection, stream)
    if reason == audio.DENIED { return fail("mlx-audio: refused: this app may not (MLXIPC permissions, ~/.config/mlx/ipc.conf)", Failure.Refused) }
    if reason != 0 { return fail("mlx-audio: refused: the stream is not one MLX Audio takes", Failure.Refused) }
}

fn readFile(path: [*]const u8, allocator: std.allocator.Allocator, length: *usize) -> usize {
    const file = std.fs.open(path, 524288, 0)
    if file.descriptor < 0 { return 0 }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(file, &status) != 0 || status.size <= 0 {
        const closed = std.fs.close(file)
        return 0
    }
    const size = @intCast(usize, status.size)
    const memory = allocator.alloc(size, 16)
    if memory == null { return 0 }
    var done: usize = 0
    while done < size {
        var at: [*]u8 = undefined
        unsafe { at = @ptrFromInt([*]u8, @intFromPtr(memory.?) + done) }
        const got = std.fs.read(file, at, size - done)
        if got <= 0 { break }
        done += @intCast(usize, got)
    }
    const closed = std.fs.close(file)
    length.* = done
    return @intFromPtr(memory.?)
}

fn play(connection: *audio.Audio, path: std.string.String, volume: u32, latency: u32, allocator: std.allocator.Allocator) -> !void {
    var length: usize = 0
    const address = readFile(path.pointer, allocator, &length)
    if address == 0 { return fail("mlx-audio: the file could not be read", Failure.NoFile) }
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrFromInt([*]u8, address) }
    var info: wav.Info = undefined
    if !wav.parse(bytes, length, &info) { return fail("mlx-audio: not a WAVE file this plays", Failure.NoFile) }
    var data: [*]u8 = undefined
    unsafe { data = @ptrFromInt([*]u8, address + info.dataStart) }
    var data_length = info.dataLength
    var format = audio.S16
    if info.format == wav.FORMAT_FLOAT {
        format = audio.F32
    } else if info.bits == 32 {
        format = audio.S32
    } else if info.bits != 16 {
        // 8 and 24 bits: to 16, in place (never longer).
        const size = @intCast(usize, info.bits / 8)
        const count = data_length / size
        var index: usize = 0
        while index < count {
            var value: i32 = 0
            if size == 1 {
                value = (@intCast(i32, data[index]) - 128) * 256
            } else {
                value = @intCast(i32, data[index * 3 + 1]) | (@intCast(i32, data[index * 3 + 2]) << 8)
                if value >= 32768 { value -= 65536 }
            }
            const bits = @bitCast(u32, value)
            data[index * 2] = @intCast(u8, bits & 255)
            data[index * 2 + 1] = @intCast(u8, (bits >> 8) & 255)
            index += 1
        }
        data_length = count * 2
    }
    const stream = audio.openStream(connection, audio.PLAY, format, info.channels, info.rate, latency, std.string.asSlice(path))
    try opened(connection, stream)
    if volume != 65536 { const set = audio.setVolume(connection, stream, volume) }
    if !audio.write(connection, stream, data, data_length) || !audio.drain(connection, stream) { return fail("mlx-audio: MLX Audio went", Failure.Lost) }
    audio.closeStream(connection, stream)
}

fn tone(connection: *audio.Audio, hertz: u32, seconds: u32, volume: u32, latency: u32, allocator: std.allocator.Allocator) -> !void {
    const rate: u32 = 48000
    const frames = @intCast(usize, rate * seconds)
    const memory = allocator.alloc(frames * 2 + 2, 16)
    if memory == null { return fail("mlx-audio: out of memory", Failure.Lost) }
    const bytes = memory.?
    // A sine by rotation: (c, s) turns by the angle per frame (floats).
    const angle: f32 = 6.2831853 * @floatFromInt(f32, hertz) / @floatFromInt(f32, rate)
    // cos and sin of a small angle (series).
    const square = angle * angle
    const turn_cos: f32 = 1.0 - square / 2.0 + square * square / 24.0
    const turn_sin: f32 = angle - square * angle / 6.0 + square * square * angle / 120.0
    var c: f32 = 1.0
    var s: f32 = 0.0
    var index: usize = 0
    while index < frames {
        const scaled = s * 16000.0
        const sample: i32 = @intFromFloat(i32, scaled)
        const bits = @bitCast(u32, sample)
        bytes[index * 2] = @intCast(u8, bits & 255)
        bytes[index * 2 + 1] = @intCast(u8, (bits >> 8) & 255)
        const next_c = c * turn_cos - s * turn_sin
        const next_s = s * turn_cos + c * turn_sin
        c = next_c
        s = next_s
        index += 1
    }
    const stream = audio.openStream(connection, audio.PLAY, audio.S16, 1, rate, latency, "tone")
    try opened(connection, stream)
    if volume != 65536 { const set = audio.setVolume(connection, stream, volume) }
    if !audio.write(connection, stream, bytes, frames * 2) || !audio.drain(connection, stream) { return fail("mlx-audio: MLX Audio went", Failure.Lost) }
    audio.closeStream(connection, stream)
}

fn record(connection: *audio.Audio, path: std.string.String, seconds: u32, rate: u32, channels: u32, allocator: std.allocator.Allocator) -> !void {
    const frame = @intCast(usize, channels) * 2
    const wanted = @intCast(usize, rate * seconds) * frame
    const memory = allocator.alloc(wav.HEADER_SIZE + wanted, 16)
    if memory == null { return fail("mlx-audio: out of memory", Failure.Lost) }
    const bytes = memory.?
    const stream = audio.openStream(connection, audio.RECORD, audio.S16, channels, rate, 100, std.string.asSlice(path))
    try opened(connection, stream)
    var have: usize = 0
    var quiet: usize = 0
    while have < wanted && quiet < 50 {
        var at: [*]u8 = undefined
        unsafe { at = @ptrFromInt([*]u8, @intFromPtr(bytes) + wav.HEADER_SIZE + have) }
        const got = audio.read(connection, stream, at, wanted - have, 100)
        if got == 0 { quiet += 1 } else { quiet = 0 }
        have += got
    }
    audio.closeStream(connection, stream)
    wav.writeHeader(bytes, rate, channels, wav.FORMAT_PCM, 16, have)
    // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC.
    const file = std.fs.open(path.pointer, 1 | 64 | 512 | 524288, 420)
    if file.descriptor < 0 || !std.fs.writeAllBytes(file, bytes, wav.HEADER_SIZE + have) { return fail("mlx-audio: the file could not be written", Failure.NoFile) }
    const closed = std.fs.close(file)
    say("recorded ")
    sayNumber(have / frame)
    say(" frames\n")
}

fn streams(connection: *audio.Audio) -> !void {
    var buffer: [32768]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    const length = audio.list(connection, bytes, 32768)
    say(bytes[0..length])
}

const USAGE: []const u8 = "usage: mlx-audio play FILE.wav | tone HZ SECONDS | record FILE.wav SECONDS | streams | volume PERCENT  [--volume PERCENT] [--latency MS] [--rate HZ] [--channels N]"

pub fn main(arguments: [][*]const u8) -> !void {
    const installed = crash.install()
    const allocator = std.page_allocator.init()
    var words: [4]std.string.String = undefined
    var word_count: usize = 0
    var volume: u32 = 65536
    var latency: u32 = 100
    var rate: u32 = 48000
    var channels: u32 = 2
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if named(argument, "--volume") && index + 1 < count {
            index += 1
            volume = number(std.process.argument(arguments, index)) * 65536 / 100
        } else if named(argument, "--latency") && index + 1 < count {
            index += 1
            latency = number(std.process.argument(arguments, index))
        } else if named(argument, "--rate") && index + 1 < count {
            index += 1
            rate = number(std.process.argument(arguments, index))
        } else if named(argument, "--channels") && index + 1 < count {
            index += 1
            channels = number(std.process.argument(arguments, index))
        } else if word_count < 4 {
            words[word_count] = argument
            word_count += 1
        }
        index += 1
    }
    if word_count == 0 { return fail(USAGE, Failure.Usage) }
    const memory = allocator.alloc(@sizeOf(audio.Audio), 16)
    var connection: *audio.Audio = undefined
    unsafe { connection = @ptrCast(*audio.Audio, memory.?) }
    const connected = audio.connect(connection, allocator, std.process.environmentEntries(arguments))
    if connected == audio.NO_BUS { return fail("mlx-audio: no session bus (MLX Audio runs on MLXIPC: mlx-ipcd)", Failure.NoServer) }
    if connected == audio.NOT_ALLOWED { return fail("mlx-audio: this app may not talk to MLX Audio (MLXIPC permissions)", Failure.Refused) }
    if connected != audio.OK { return fail("mlx-audio: MLX Audio is not running (mlx-audiod)", Failure.NoServer) }
    const command = words[0]
    if named(command, "play") && word_count > 1 {
        try play(connection, words[1], volume, latency, allocator)
    } else if named(command, "tone") && word_count > 2 {
        try tone(connection, number(words[1]), number(words[2]), volume, latency, allocator)
    } else if named(command, "record") && word_count > 2 {
        try record(connection, words[1], number(words[2]), rate, channels, allocator)
    } else if named(command, "streams") {
        try streams(connection)
    } else if named(command, "volume") && word_count > 1 {
        if !audio.setVolume(connection, 0, number(words[1]) * 65536 / 100) { return fail("mlx-audio: MLX Audio went", Failure.Lost) }
    } else {
        return fail(USAGE, Failure.Usage)
    }
    audio.disconnect(connection)
}
