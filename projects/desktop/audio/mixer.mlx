// The mix: what playing streams sent goes, converted to the device's rate
// and stereo, into each stream's ring; a period at a time the rings are
// mixed (each at its volume and its app's) into their sinks, the virtual
// sinks into the default one (each at its volume), and that at the
// output's volume into the device's format; streams are asked (REQUEST)
// for what keeps their ring at its latency; and each period of input goes,
// converted, to the recording streams (RECORDED), as does each sink's mix
// to the streams recording its monitor (routing.mlx).
const std = @import("std")
const audio = @import("std.audio")
const state = @import("./state.mlx")
const samples = @import("./samples.mlx")
const devices = @import("./devices.mlx")
const protocol = @import("./protocol.mlx")
const alsa = @import("./alsa.mlx")
const routing = @import("./routing.mlx")
const pulse = @import("./pulse.mlx")

pub fn streamAt(server: *state.Server, index: usize) -> *state.Stream {
    unsafe { return @ptrCast(*state.Stream, &server.*.streams[index]) }
}

fn resamplerOf(stream: *state.Stream) -> *state.Resampler {
    unsafe { return @ptrCast(*state.Resampler, &stream.*.resampler) }
}

fn ringPush(stream: *state.Stream, left: i32, right: i32) -> void {
    if stream.*.filled >= stream.*.capacity { return }
    const at = (stream.*.start + stream.*.filled) % stream.*.capacity
    stream.*.ring[at * 2] = left
    stream.*.ring[at * 2 + 1] = right
    stream.*.filled += 1
}

fn pushFrame(server: *state.Server, stream: *state.Stream, left: i32, right: i32) -> void {
    if stream.*.rate == server.*.rate {
        ringPush(stream, left, right)
        return
    }
    var made: [64]i32 = undefined
    var out: [*]i32 = undefined
    unsafe { out = @ptrCast([*]i32, &made) }
    const count = samples.resample(resamplerOf(stream), left, right, out, 32)
    var index: usize = 0
    while index < count {
        ringPush(stream, made[index * 2], made[index * 2 + 1])
        index += 1
    }
}

// The server's rate changed (another output): each stream's conversion
// and latency again (a ring too small for it is made anew, empty).
pub fn retuneStreams(server: *state.Server) -> void {
    var slot: usize = 0
    while slot < state.MAX_STREAMS {
        const stream = streamAt(server, slot)
        if stream.*.used && stream.*.state == state.OPEN {
            if stream.*.direction == audio.PLAY {
                samples.startResampler(resamplerOf(stream), stream.*.rate, server.*.rate)
                var target = @intCast(usize, @intCast(u64, stream.*.latency) * @intCast(u64, server.*.rate) / 1000)
                if target < server.*.period * 2 { target = server.*.period * 2 }
                stream.*.target = target
                if target * 2 + 256 > stream.*.capacity {
                    const memory = server.*.allocator.alloc((target * 2 + 256) * 8, 16)
                    if memory != null {
                        var old: [*]u8 = undefined
                        unsafe { old = @ptrCast([*]u8, stream.*.ring) }
                        server.*.allocator.free(old, stream.*.capacity * 8, 16)
                        unsafe { stream.*.ring = @ptrCast([*]i32, memory.?) }
                        stream.*.capacity = target * 2 + 256
                        stream.*.start = 0
                        stream.*.filled = 0
                    }
                }
            } else {
                samples.startResampler(resamplerOf(stream), server.*.rate, stream.*.rate)
            }
        }
        slot += 1
    }
}

// DATA: `length` bytes of the stream's samples (a frame may be split
// across messages).
pub fn feed(server: *state.Server, stream: *state.Stream, bytes: [*]const u8, length: usize) -> void {
    const size = stream.*.frameBytes
    var left: i32 = 0
    var right: i32 = 0
    var at: usize = 0
    if stream.*.carryLength > 0 {
        while stream.*.carryLength < size && at < length {
            stream.*.carry[stream.*.carryLength] = bytes[at]
            stream.*.carryLength += 1
            at += 1
        }
        if stream.*.carryLength == size {
            var carried: [*]const u8 = undefined
            unsafe { carried = @ptrCast([*]const u8, &stream.*.carry) }
            samples.decodeFrame(carried, 0, stream.*.format, stream.*.channels, &left, &right)
            pushFrame(server, stream, left, right)
            stream.*.carryLength = 0
        }
    }
    while at + size <= length {
        samples.decodeFrame(bytes, at, stream.*.format, stream.*.channels, &left, &right)
        pushFrame(server, stream, left, right)
        at += size
    }
    while at < length {
        stream.*.carry[stream.*.carryLength] = bytes[at]
        stream.*.carryLength += 1
        at += 1
    }
    stream.*.requested = if length < stream.*.requested { stream.*.requested - length } else { 0 }
    // A PulseAudio stream starts once it has its prebuf (and is not
    // corked).
    if stream.*.pulse { pulse.fed(server, stream, length) } else { stream.*.started = true }
}

// Asks a playing stream for what fills its ring to its latency.
pub fn requestMore(server: *state.Server, stream: *state.Stream) -> void {
    if stream.*.state != state.OPEN || stream.*.direction != audio.PLAY || stream.*.filled >= stream.*.target { return }
    const frames = stream.*.target - stream.*.filled
    // In the stream's frames and bytes.
    const wanted = @intCast(usize, @intCast(u64, frames) * @intCast(u64, stream.*.rate) / @intCast(u64, server.*.rate)) * stream.*.frameBytes
    if wanted <= stream.*.requested { return }
    const more = (wanted - stream.*.requested) / stream.*.frameBytes * stream.*.frameBytes
    // Not in crumbs: at least a period's worth (a PulseAudio stream's
    // minreq).
    var least = @intCast(usize, @intCast(u64, server.*.period) * @intCast(u64, stream.*.rate) / @intCast(u64, server.*.rate)) * stream.*.frameBytes
    if stream.*.pulse { least = @intCast(usize, stream.*.minreq) }
    if more < least && stream.*.requested > 0 { return }
    if more == 0 { return }
    protocol.sendStreamValue(server, stream, audio.REQUEST, @intCast(u32, more))
    stream.*.requested += more
}

fn clear(mix: [*]i32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        mix[index] = 0
        index += 1
    }
}

// A period of a sink's mix to the streams recording its monitor.
fn monitor(server: *state.Server, sink: usize, mix: [*]const i32, frames: usize) -> void {
    var slot: usize = 0
    while slot < state.MAX_STREAMS {
        const stream = streamAt(server, slot)
        if stream.*.used && stream.*.state == state.OPEN && stream.*.direction == audio.RECORD && stream.*.monitor && stream.*.sink == sink { protocol.sendRecorded(server, stream, mix, frames) }
        slot += 1
    }
}

// Mixes a period of the playing streams into their sinks, the sinks into
// the default one, and that into server.encoded.
pub fn mixPeriod(server: *state.Server) -> void {
    const frames = server.*.period
    clear(server.*.mix, frames * 2)
    var slot: usize = 0
    while slot < state.MAX_SINKS {
        const sink = routing.sinkAt(server, slot)
        if sink.*.used { clear(sink.*.mix, frames * 2) }
        slot += 1
    }
    var index: usize = 0
    slot = 0
    while slot < state.MAX_STREAMS {
        const stream = streamAt(server, slot)
        if stream.*.used && stream.*.state == state.OPEN && stream.*.direction == audio.PLAY && stream.*.started && !stream.*.corked {
            var count = stream.*.filled
            if count > frames { count = frames }
            if count < frames && !stream.*.draining { stream.*.underruns += 1 }
            const volume = routing.gainOf(server, stream)
            const mix = routing.mixOf(server, stream.*.sink)
            index = 0
            while index < count {
                const at = (stream.*.start + index) % stream.*.capacity
                mix[index * 2] += @intCast(i32, @intCast(i64, stream.*.ring[at * 2]) * volume / 65536)
                mix[index * 2 + 1] += @intCast(i32, @intCast(i64, stream.*.ring[at * 2 + 1]) * volume / 65536)
                index += 1
            }
            stream.*.start = (stream.*.start + count) % stream.*.capacity
            stream.*.filled -= count
            if stream.*.pulse { pulse.consumed(server, stream, count, frames) }
            if stream.*.draining && stream.*.filled == 0 {
                stream.*.draining = false
                stream.*.started = false
                protocol.sendStreamValue(server, stream, audio.DRAINED, 0)
            }
        }
        slot += 1
    }
    // The virtual sinks: their monitors, then into the default sink.
    slot = 0
    while slot < state.MAX_SINKS {
        const sink = routing.sinkAt(server, slot)
        if sink.*.used {
            monitor(server, slot + 1, sink.*.mix, frames)
            if sink.*.target == state.TO_OUTPUT && !sink.*.mute {
                const gain = @intCast(i64, sink.*.volume)
                index = 0
                while index < frames * 2 {
                    server.*.mix[index] += @intCast(i32, @intCast(i64, sink.*.mix[index]) * gain / 65536)
                    index += 1
                }
            }
        }
        slot += 1
    }
    monitor(server, state.DEFAULT_SINK, server.*.mix, frames)
    const master = if server.*.mute { 0 } else { @intCast(i64, server.*.master) }
    const encoding = devices.outputOf(server).*.encoding
    const size = samples.bytesOf(encoding)
    index = 0
    while index < frames * 2 {
        const value = samples.clamp(@intCast(i64, server.*.mix[index]) * master / 65536)
        samples.encode(server.*.encoded, index * size, encoding, value)
        index += 1
    }
}

// A period of input to the recording streams (at the input's volume).
pub fn distribute(server: *state.Server, frames: usize) -> void {
    if server.*.inputMute || server.*.inputVolume != 65536 {
        const volume = if server.*.inputMute { 0 } else { @intCast(i64, server.*.inputVolume) }
        var index: usize = 0
        while index < frames * 2 {
            server.*.captured[index] = samples.clamp(@intCast(i64, server.*.captured[index]) * volume / 65536)
            index += 1
        }
    }
    var slot: usize = 0
    while slot < state.MAX_STREAMS {
        const stream = streamAt(server, slot)
        if stream.*.used && stream.*.state == state.OPEN && stream.*.direction == audio.RECORD && !stream.*.monitor { protocol.sendRecorded(server, stream, server.*.captured, frames) }
        slot += 1
    }
}

fn requestAll(server: *state.Server) -> void {
    var slot: usize = 0
    while slot < state.MAX_STREAMS {
        const stream = streamAt(server, slot)
        if stream.*.used { requestMore(server, stream) }
        slot += 1
    }
}

// One period played (and recorded, unless a sound card records on its
// own pace).
fn period(server: *state.Server) -> void {
    mixPeriod(server)
    const played = devices.play(server, server.*.encoded, server.*.period)
    if devices.inputOf(server).*.kind != state.ALSA {
        devices.generate(server, server.*.captured, server.*.period)
        distribute(server, server.*.period)
    }
}

// The timer fired `count` times: as many periods (a few at most when the
// server fell behind).
pub fn timerPeriods(server: *state.Server, count: usize) -> void {
    var left = count
    if left > 10 { left = 10 }
    while left > 0 {
        period(server)
        left -= 1
    }
    requestAll(server)
}

// The sound card has room: periods until it is full (a period it took
// only in part is finished first).
pub fn cardWritable(server: *state.Server) -> void {
    const device = devices.outputOf(server)
    alsa.takeWakes(device)
    const frame = samples.bytesOf(device.*.encoding) * 2
    var rounds: usize = 0
    while rounds < 16 {
        if server.*.encodedFrames == 0 {
            mixPeriod(server)
            server.*.encodedFrames = server.*.period
            server.*.encodedStart = 0
            if devices.inputOf(server).*.kind != state.ALSA {
                devices.generate(server, server.*.captured, server.*.period)
                distribute(server, server.*.period)
            }
        }
        var at: [*]u8 = undefined
        unsafe { at = @ptrFromInt([*]u8, @intFromPtr(server.*.encoded) + server.*.encodedStart * frame) }
        const xruns = device.*.xruns
        const took = alsa.write(device, at, server.*.encodedFrames)
        // Full; or it ran dry and was prepared again (then it has room).
        if took == 0 && device.*.xruns == xruns { break }
        server.*.encodedStart += took
        server.*.encodedFrames -= took
        rounds += 1
    }
    requestAll(server)
}

// The sound card recorded: to the recording streams.
pub fn cardReadable(server: *state.Server) -> void {
    alsa.takeWakes(devices.inputOf(server))
    // What the card has, a period at a time.
    var rounds: usize = 0
    while rounds < 8 {
        const frames = devices.record(server, server.*.captured, state.MAX_PERIOD)
        if frames == 0 { break }
        distribute(server, frames)
        rounds += 1
    }
}
