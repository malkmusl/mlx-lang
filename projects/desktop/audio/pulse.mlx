// MLX Audio speaks PulseAudio's native protocol: mlx-audiod listens on
// $XDG_RUNTIME_DIR/pulse/native, where libpulse looks (and Flatpak hands
// to apps with --socket=pulseaudio), so the programs that only speak
// PulseAudio (Firefox, Chromium and Electron apps, SDL games, mpv, VLC,
// GStreamer, Wine, pactl and pavucontrol) play and record through MLX
// Audio, as they would through pipewire-pulse. Their streams are the
// server's like any other: mixed, routed (routing.mlx), shown in the
// Sound settings and allowed by MLXIPC: the socket's peer process
// (SO_PEERCRED) is the app (std.appid), and the bus is asked about it
// (org.mlx.IPC.CheckProcess) before a stream opens; the answer about
// audio.control decides whether the app may change the server (volumes
// of sinks and of other apps' streams, moving them).
//
// A packet is a descriptor of five big-endian u32 (length, channel, the
// offset's two halves, flags) and its payload: on channel -1 a command
// (a tagstruct, tagstruct.mlx: command, tag, arguments), on a stream's
// channel its samples. Shared memory is not offered, so the samples come
// in the packets. What the server says about itself, its sinks and
// sources, and the commands that change them are pulse_info.mlx's.
const std = @import("std")
const dbus = @import("std.dbus")
const audio = @import("std.audio")
const appid = @import("std.appid")
const state = @import("./state.mlx")
const ts = @import("./tagstruct.mlx")
const samples = @import("./samples.mlx")
const mixer = @import("./mixer.mlx")
const protocol = @import("./protocol.mlx")
const routing = @import("./routing.mlx")
const info = @import("./pulse_info.mlx")

// The protocol version spoken (PulseAudio 15 and later).
pub const VERSION: u32 = 35
pub const INVALID: u32 = 4294967295
pub const DESCRIPTOR: usize = 20
// The most a packet the server sends may hold.
pub const MESSAGE_SIZE: usize = 65536
// The most bytes a stream queues.
const MAX_LENGTH: u32 = 4194304

// Commands.
pub const COMMAND_ERROR: u32 = 0
pub const COMMAND_REPLY: u32 = 2
const CREATE_PLAYBACK_STREAM: u32 = 3
const DELETE_PLAYBACK_STREAM: u32 = 4
const CREATE_RECORD_STREAM: u32 = 5
const DELETE_RECORD_STREAM: u32 = 6
const AUTH: u32 = 8
const SET_CLIENT_NAME: u32 = 9
const LOOKUP_SINK: u32 = 10
const LOOKUP_SOURCE: u32 = 11
const DRAIN_PLAYBACK_STREAM: u32 = 12
const STAT: u32 = 13
const GET_PLAYBACK_LATENCY: u32 = 14
const GET_SERVER_INFO: u32 = 20
const GET_SINK_INFO: u32 = 21
const GET_SINK_INFO_LIST: u32 = 22
const GET_SOURCE_INFO: u32 = 23
const GET_SOURCE_INFO_LIST: u32 = 24
const GET_MODULE_INFO_LIST: u32 = 26
const GET_CLIENT_INFO: u32 = 27
const GET_CLIENT_INFO_LIST: u32 = 28
const GET_SINK_INPUT_INFO: u32 = 29
const GET_SINK_INPUT_INFO_LIST: u32 = 30
const GET_SOURCE_OUTPUT_INFO: u32 = 31
const GET_SOURCE_OUTPUT_INFO_LIST: u32 = 32
const GET_SAMPLE_INFO_LIST: u32 = 34
const SUBSCRIBE: u32 = 35
const SET_SINK_VOLUME: u32 = 36
const SET_SINK_INPUT_VOLUME: u32 = 37
const SET_SOURCE_VOLUME: u32 = 38
const SET_SINK_MUTE: u32 = 39
const SET_SOURCE_MUTE: u32 = 40
const CORK_PLAYBACK_STREAM: u32 = 41
const FLUSH_PLAYBACK_STREAM: u32 = 42
const TRIGGER_PLAYBACK_STREAM: u32 = 43
const SET_DEFAULT_SINK: u32 = 44
const SET_DEFAULT_SOURCE: u32 = 45
const SET_PLAYBACK_STREAM_NAME: u32 = 46
const SET_RECORD_STREAM_NAME: u32 = 47
const KILL_SINK_INPUT: u32 = 49
const KILL_SOURCE_OUTPUT: u32 = 50
const GET_RECORD_LATENCY: u32 = 57
const CORK_RECORD_STREAM: u32 = 58
const FLUSH_RECORD_STREAM: u32 = 59
const PREBUF_PLAYBACK_STREAM: u32 = 60
const REQUEST: u32 = 61
const UNDERFLOW: u32 = 63
const PLAYBACK_STREAM_KILLED: u32 = 64
const RECORD_STREAM_KILLED: u32 = 65
const SUBSCRIBE_EVENT: u32 = 66
const MOVE_SINK_INPUT: u32 = 67
const MOVE_SOURCE_OUTPUT: u32 = 68
const SET_SINK_INPUT_MUTE: u32 = 69
const SUSPEND_SINK: u32 = 70
const SUSPEND_SOURCE: u32 = 71
const SET_PLAYBACK_STREAM_BUFFER_ATTR: u32 = 72
const SET_RECORD_STREAM_BUFFER_ATTR: u32 = 73
const UPDATE_PLAYBACK_STREAM_SAMPLE_RATE: u32 = 74
const UPDATE_RECORD_STREAM_SAMPLE_RATE: u32 = 75
const UPDATE_RECORD_STREAM_PROPLIST: u32 = 80
const UPDATE_PLAYBACK_STREAM_PROPLIST: u32 = 81
const UPDATE_CLIENT_PROPLIST: u32 = 82
const REMOVE_RECORD_STREAM_PROPLIST: u32 = 83
const REMOVE_PLAYBACK_STREAM_PROPLIST: u32 = 84
const REMOVE_CLIENT_PROPLIST: u32 = 85
const STARTED: u32 = 86
const EXTENSION: u32 = 87
const GET_CARD_INFO: u32 = 88
const GET_CARD_INFO_LIST: u32 = 89
const SET_SOURCE_OUTPUT_VOLUME: u32 = 98
const SET_SOURCE_OUTPUT_MUTE: u32 = 99

// Errors.
pub const ERR_ACCESS: u32 = 1
pub const ERR_COMMAND: u32 = 2
pub const ERR_INVALID: u32 = 3
pub const ERR_NOENTITY: u32 = 5
pub const ERR_PROTOCOL: u32 = 7
pub const ERR_VERSION: u32 = 17
pub const ERR_NOTSUPPORTED: u32 = 19
pub const ERR_NOEXTENSION: u32 = 21

// Sample formats.
pub const FORMAT_U8: u8 = 0
pub const FORMAT_S16LE: u8 = 3
pub const FORMAT_FLOAT32LE: u8 = 5
pub const FORMAT_S32LE: u8 = 7
pub const FORMAT_S24LE: u8 = 9
pub const FORMAT_S24_32LE: u8 = 11

// Subscription facilities and event types.
pub const FACILITY_SINK: u32 = 0
pub const FACILITY_SOURCE: u32 = 1
pub const FACILITY_SINK_INPUT: u32 = 2
pub const FACILITY_SOURCE_OUTPUT: u32 = 3
pub const FACILITY_CLIENT: u32 = 5
pub const FACILITY_SERVER: u32 = 7
pub const EVENT_NEW: u32 = 0
pub const EVENT_CHANGE: u32 = 16
pub const EVENT_REMOVE: u32 = 32

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn copy(target: [*]u8, capacity: usize, text: []const u8) -> usize {
    var length: usize = 0
    while length < text.length && length < capacity {
        target[length] = text[length]
        length += 1
    }
    return length
}

fn advance(bytes: [*]u8, count: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(bytes) + count) }
}

fn advanceConst(bytes: [*]const u8, count: usize) -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, @intFromPtr(bytes) + count) }
}

pub fn clientOf(peer: *state.Peer) -> *state.PulseClient {
    unsafe { return @ptrCast(*state.PulseClient, &peer.*.client) }
}

fn streamOf(address: usize) -> *state.Stream {
    unsafe { return @ptrFromInt(*state.Stream, address) }
}

pub fn clientName(peer: *state.Peer) -> []const u8 {
    const client = clientOf(peer)
    if !peer.*.pulse || client.*.nameLength == 0 { return protocol.appOf(peer) }
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &client.*.name) }
    return bytes[0..client.*.nameLength]
}

// ---------------------------------------------------------------------------
// The socket

fn pathOf(server: *state.Server) -> [*]u8 {
    unsafe { return @ptrCast([*]u8, &server.*.pulsePath) }
}

// Listens on $XDG_RUNTIME_DIR/pulse/native; false (said) when another
// server has it or there is no runtime directory.
pub fn start(server: *state.Server) -> bool {
    server.*.pulseListener = -1
    server.*.pulsePathLength = 0
    server.*.nextClient = 0
    const runtime = std.process.environmentFrom(server.*.environment, "XDG_RUNTIME_DIR")
    if runtime == null || runtime.?.length == 0 || runtime.?.length > 200 { return false }
    const path = pathOf(server)
    var length = copy(path, 200, std.string.asSlice(runtime.?))
    length += copy(advance(path, length), 8, "/pulse")
    path[length] = 0
    const made = std.fs.makeDir(path, 448)
    length += copy(advance(path, length), 8, "/native")
    path[length] = 0
    server.*.pulsePathLength = length
    // A server that answers there (PulseAudio, pipewire-pulse) keeps it.
    const probe = dbus.connect(path[0..length])
    if probe >= 0 {
        dbus.closeDescriptor(probe)
        const said = std.io.eprintln("mlx-audiod: another PulseAudio server has $XDG_RUNTIME_DIR/pulse/native; PulseAudio apps play through it, not through MLX Audio")
        server.*.pulsePathLength = 0
        return false
    }
    const unlinked = std.linux.syscall1(87, @intFromPtr(path))
    const listener = dbus.listen(path[0..length])
    if listener < 0 {
        const said = std.io.eprintln("mlx-audiod: cannot listen on $XDG_RUNTIME_DIR/pulse/native")
        server.*.pulsePathLength = 0
        return false
    }
    server.*.pulseListener = listener
    const watched = dbus.watch(server.*.eventLoop, listener, state.PULSE, false)
    protocol.say(server, "audio: PulseAudio apps at ")
    protocol.say(server, path[0..length])
    protocol.say(server, "\n")
    return true
}

// The socket goes with the server.
pub fn stop(server: *state.Server) -> void {
    if server.*.pulseListener < 0 { return }
    dbus.closeDescriptor(server.*.pulseListener)
    server.*.pulseListener = -1
    const unlinked = std.linux.syscall1(87, @intFromPtr(pathOf(server)))
}

// The connections waiting at the socket.
pub fn acceptAll(server: *state.Server) -> void {
    while true {
        const descriptor = dbus.accept(server.*.pulseListener)
        if descriptor < 0 { return }
        addClient(server, descriptor)
    }
}

fn addClient(server: *state.Server, descriptor: isize) -> void {
    if server.*.peerCount >= state.MAX_PEERS {
        dbus.closeDescriptor(descriptor)
        return
    }
    const memory = server.*.allocator.alloc(@sizeOf(state.Peer), 16)
    if memory == null {
        dbus.closeDescriptor(descriptor)
        return
    }
    var peer: *state.Peer = undefined
    unsafe { peer = @ptrCast(*state.Peer, memory.?) }
    if !dbus.open(protocol.channelOf(peer), server.*.allocator, descriptor) {
        dbus.closeDescriptor(descriptor)
        server.*.allocator.free(memory.?, @sizeOf(state.Peer), 16)
        return
    }
    peer.*.descriptor = descriptor
    peer.*.pulse = true
    peer.*.dead = false
    peer.*.watchingOutput = false
    peer.*.control = state.CONTROL_UNKNOWN
    peer.*.controlSerial = 0
    peer.*.index = server.*.nextClient
    server.*.nextClient += 1
    // Who it is: the process at the socket's other end.
    var pid: u32 = 0
    var uid: u32 = 0
    var gid: u32 = 0
    if !dbus.peerCredentials(descriptor, &pid, &uid, &gid) { pid = 0 }
    peer.*.pid = pid
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &peer.*.app) }
    var sandboxed = false
    peer.*.appLength = appid.identify(pid, bytes, 128, &sandboxed)
    peer.*.sandboxed = sandboxed
    unsafe { bytes = @ptrCast([*]u8, &peer.*.unique) }
    var length = copy(bytes, 8, "pulse:")
    length += decimal(advance(bytes, length), @intCast(usize, pid))
    peer.*.uniqueLength = length
    const client = clientOf(peer)
    client.*.version = 0
    client.*.authorized = false
    client.*.authTag = INVALID
    client.*.subscriptions = 0
    client.*.nameLength = 0
    client.*.dataLeft = 0
    client.*.dataChannel = INVALID
    server.*.peers[server.*.peerCount] = @intFromPtr(memory.?)
    server.*.peerCount += 1
    const watched = dbus.watch(server.*.eventLoop, descriptor, @intFromPtr(memory.?), false)
    protocol.say(server, "audio: ")
    protocol.say(server, protocol.appOf(peer))
    protocol.say(server, " connected (PulseAudio, process ")
    protocol.sayNumber(server, @intCast(usize, pid))
    protocol.say(server, ")\n")
}

fn decimal(out: [*]u8, value: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var length: usize = 0
    while count > 0 {
        count -= 1
        out[length] = digits[count]
        length += 1
    }
    return length
}

// A PulseAudio client left: its streams went with it (protocol.dropPeer).
pub fn clientGone(server: *state.Server, peer: *state.Peer) -> void { event(server, FACILITY_CLIENT, EVENT_REMOVE, peer.*.index) }

// ---------------------------------------------------------------------------
// Packets

pub fn messageOf(server: *state.Server) -> [*]u8 { return server.*.pulseMessage }

// A command packet's tagstruct begun in the message buffer.
pub fn begin(server: *state.Server, writing: *ts.Writer, command: u32, tag: u32) -> void {
    ts.begin(writing, advance(server.*.pulseMessage, DESCRIPTOR), MESSAGE_SIZE)
    ts.putU32(writing, command)
    ts.putU32(writing, tag)
}

pub fn beginReply(server: *state.Server, writing: *ts.Writer, tag: u32) -> void { begin(server, writing, COMMAND_REPLY, tag) }

fn descriptor(bytes: [*]u8, length: usize, channel: u32) -> void {
    ts.store32(bytes, 0, @intCast(u32, length))
    ts.store32(bytes, 4, channel)
    ts.store32(bytes, 8, 0)
    ts.store32(bytes, 12, 0)
    ts.store32(bytes, 16, 0)
}

// Sends the tagstruct built in the message buffer; a client whose
// connection is full is dropped (it lost a command it waits for).
pub fn send(server: *state.Server, peer: *state.Peer, writing: *const ts.Writer) -> void {
    if writing.*.failed {
        peer.*.dead = true
        return
    }
    const bytes = server.*.pulseMessage
    descriptor(bytes, writing.*.length, INVALID)
    if !protocol.sendTo(server, peer, bytes, DESCRIPTOR + writing.*.length) { peer.*.dead = true }
}

pub fn sendError(server: *state.Server, peer: *state.Peer, tag: u32, code: u32) -> void {
    var writing: ts.Writer = undefined
    begin(server, &writing, COMMAND_ERROR, tag)
    ts.putU32(&writing, code)
    send(server, peer, &writing)
}

// A reply with nothing in it.
pub fn ack(server: *state.Server, peer: *state.Peer, tag: u32) -> void {
    var writing: ts.Writer = undefined
    beginReply(server, &writing, tag)
    send(server, peer, &writing)
}

// SUBSCRIBE_EVENT to every client that subscribed to the facility.
pub fn event(server: *state.Server, facility: u32, kind: u32, index: u32) -> void {
    var at: usize = 0
    while at < server.*.peerCount {
        const peer = protocol.peerAt(server.*.peers[at])
        if peer.*.pulse && !peer.*.dead && clientOf(peer).*.subscriptions & (@intCast(u32, 1) << facility) != 0 {
            var writing: ts.Writer = undefined
            begin(server, &writing, SUBSCRIBE_EVENT, INVALID)
            ts.putU32(&writing, facility | kind)
            ts.putU32(&writing, index)
            send(server, peer, &writing)
        }
        at += 1
    }
}

// The server's sinks, sources and settings changed (mlx-settings, a
// switched output).
pub fn changed(server: *state.Server) -> void {
    event(server, FACILITY_SINK, EVENT_CHANGE, 0)
    event(server, FACILITY_SOURCE, EVENT_CHANGE, 0)
    event(server, FACILITY_SERVER, EVENT_CHANGE, INVALID)
}

// ---------------------------------------------------------------------------
// Reading

// What a client sent: commands whole, samples as they come.
pub fn readable(server: *state.Server, peer: *state.Peer) -> void {
    const channel = protocol.channelOf(peer)
    const received = dbus.receive(channel)
    if received == 0 || (received < 0 && received != dbus.EAGAIN) {
        peer.*.dead = true
        return
    }
    const client = clientOf(peer)
    while !peer.*.dead {
        const available = dbus.buffered(channel)
        const bytes = dbus.input(channel)
        if client.*.dataLeft > 0 {
            if available == 0 { return }
            var piece = available
            if piece > client.*.dataLeft { piece = client.*.dataLeft }
            samplesIn(server, peer, client.*.dataChannel, bytes, piece)
            client.*.dataLeft -= piece
            dbus.consume(channel, piece, 0)
        } else {
            if available < DESCRIPTOR { return }
            const length = @intCast(usize, ts.load32(bytes, 0))
            const stream_channel = ts.load32(bytes, 4)
            const flags = ts.load32(bytes, 16)
            if stream_channel == INVALID {
                if length > MESSAGE_SIZE {
                    peer.*.dead = true
                    return
                }
                if available < DESCRIPTOR + length { return }
                command(server, peer, advanceConst(bytes, DESCRIPTOR), length)
                dbus.consume(channel, DESCRIPTOR + length, 0)
            } else {
                // Samples in shared memory were never offered.
                if flags & 4278190080 != 0 {
                    peer.*.dead = true
                    return
                }
                client.*.dataChannel = stream_channel
                client.*.dataLeft = length
                dbus.consume(channel, DESCRIPTOR, 0)
            }
        }
    }
}

// Samples for a playing stream.
fn samplesIn(server: *state.Server, peer: *state.Peer, channel: u32, bytes: [*]const u8, length: usize) -> void {
    const address = findStream(server, peer, channel)
    if address == 0 { return }
    const stream = streamOf(address)
    if stream.*.state != state.OPEN || stream.*.direction != audio.PLAY { return }
    mixer.feed(server, stream, bytes, length)
}

// The client's stream on `channel` (0: none).
pub fn findStream(server: *state.Server, peer: *state.Peer, channel: u32) -> usize {
    if channel >= @intCast(u32, state.MAX_STREAMS) { return 0 }
    const stream = mixer.streamAt(server, @intCast(usize, channel))
    if !stream.*.used || !stream.*.pulse || stream.*.peer != @intFromPtr(peer) { return 0 }
    return @intFromPtr(stream)
}

// A stream by its sink input or source output index (any app's).
pub fn streamByIndex(server: *state.Server, index: u32, direction: u32) -> usize {
    if index >= @intCast(u32, state.MAX_STREAMS) { return 0 }
    const stream = mixer.streamAt(server, @intCast(usize, index))
    if !stream.*.used || stream.*.state != state.OPEN || stream.*.direction != direction { return 0 }
    return @intFromPtr(stream)
}

fn command(server: *state.Server, peer: *state.Peer, bytes: [*]const u8, length: usize) -> void {
    var reading = ts.reader(bytes, length)
    const kind = ts.readU32(&reading)
    const tag = ts.readU32(&reading)
    if reading.failed {
        peer.*.dead = true
        return
    }
    const client = clientOf(peer)
    if kind == AUTH {
        auth(server, peer, tag, &reading)
        return
    }
    if !client.*.authorized {
        sendError(server, peer, tag, ERR_ACCESS)
        return
    }
    if kind == SET_CLIENT_NAME || kind == UPDATE_CLIENT_PROPLIST {
        if kind == UPDATE_CLIENT_PROPLIST { const mode = ts.readU32(&reading) }
        var start: usize = 0
        ts.readProplist(&reading, &start)
        if reading.failed {
            sendError(server, peer, tag, ERR_PROTOCOL)
            return
        }
        const name = ts.property(bytes, start, reading.position, "application.name")
        if name.length > 0 {
            var target: [*]u8 = undefined
            unsafe { target = @ptrCast([*]u8, &client.*.name) }
            client.*.nameLength = copy(target, 96, name)
        }
        if kind == SET_CLIENT_NAME {
            var writing: ts.Writer = undefined
            beginReply(server, &writing, tag)
            ts.putU32(&writing, peer.*.index)
            send(server, peer, &writing)
            event(server, FACILITY_CLIENT, EVENT_NEW, peer.*.index)
        } else {
            ack(server, peer, tag)
            event(server, FACILITY_CLIENT, EVENT_CHANGE, peer.*.index)
        }
    } else if kind == CREATE_PLAYBACK_STREAM || kind == CREATE_RECORD_STREAM {
        createStream(server, peer, tag, &reading, bytes, kind == CREATE_RECORD_STREAM)
    } else if kind == DELETE_PLAYBACK_STREAM || kind == DELETE_RECORD_STREAM {
        const address = findStream(server, peer, ts.readU32(&reading))
        if address == 0 {
            sendError(server, peer, tag, ERR_NOENTITY)
            return
        }
        protocol.freeStream(server, streamOf(address))
        ack(server, peer, tag)
    } else if kind == DRAIN_PLAYBACK_STREAM || kind == CORK_PLAYBACK_STREAM || kind == FLUSH_PLAYBACK_STREAM || kind == TRIGGER_PLAYBACK_STREAM || kind == PREBUF_PLAYBACK_STREAM || kind == CORK_RECORD_STREAM || kind == FLUSH_RECORD_STREAM {
        control(server, peer, kind, tag, &reading)
    } else if kind == GET_PLAYBACK_LATENCY || kind == GET_RECORD_LATENCY {
        latency(server, peer, kind == GET_RECORD_LATENCY, tag, &reading)
    } else if kind == SET_PLAYBACK_STREAM_BUFFER_ATTR || kind == SET_RECORD_STREAM_BUFFER_ATTR {
        bufferAttributes(server, peer, kind == SET_RECORD_STREAM_BUFFER_ATTR, tag, &reading)
    } else if kind == UPDATE_PLAYBACK_STREAM_SAMPLE_RATE || kind == UPDATE_RECORD_STREAM_SAMPLE_RATE {
        const address = findStream(server, peer, ts.readU32(&reading))
        const rate = ts.readU32(&reading)
        if address == 0 || rate < 8000 || rate > 192000 {
            sendError(server, peer, tag, if address == 0 { ERR_NOENTITY } else { ERR_INVALID })
            return
        }
        const stream = streamOf(address)
        stream.*.rate = rate
        if stream.*.direction == audio.PLAY { samples.startResampler(resamplerOf(stream), rate, server.*.rate) } else { samples.startResampler(resamplerOf(stream), server.*.rate, rate) }
        ack(server, peer, tag)
    } else if kind == SET_PLAYBACK_STREAM_NAME || kind == SET_RECORD_STREAM_NAME {
        const address = findStream(server, peer, ts.readU32(&reading))
        const name = ts.readString(&reading)
        if address != 0 { setName(streamOf(address), name) }
        ack(server, peer, tag)
    } else if kind == UPDATE_PLAYBACK_STREAM_PROPLIST || kind == UPDATE_RECORD_STREAM_PROPLIST {
        const address = findStream(server, peer, ts.readU32(&reading))
        const mode = ts.readU32(&reading)
        var start: usize = 0
        ts.readProplist(&reading, &start)
        if address != 0 && !reading.failed {
            const name = ts.property(bytes, start, reading.position, "media.name")
            if name.length > 0 { setName(streamOf(address), name) }
        }
        ack(server, peer, tag)
    } else if kind == REMOVE_PLAYBACK_STREAM_PROPLIST || kind == REMOVE_RECORD_STREAM_PROPLIST || kind == REMOVE_CLIENT_PROPLIST {
        ack(server, peer, tag)
    } else if kind == SUBSCRIBE {
        client.*.subscriptions = ts.readU32(&reading)
        ack(server, peer, tag)
    } else if kind == GET_SERVER_INFO {
        info.serverInfo(server, peer, tag)
    } else if kind == GET_SINK_INFO || kind == GET_SINK_INFO_LIST {
        info.sinks(server, peer, tag, &reading, kind == GET_SINK_INFO_LIST)
    } else if kind == GET_SOURCE_INFO || kind == GET_SOURCE_INFO_LIST {
        info.sources(server, peer, tag, &reading, kind == GET_SOURCE_INFO_LIST)
    } else if kind == GET_SINK_INPUT_INFO || kind == GET_SINK_INPUT_INFO_LIST {
        info.streams(server, peer, tag, &reading, audio.PLAY, kind == GET_SINK_INPUT_INFO_LIST)
    } else if kind == GET_SOURCE_OUTPUT_INFO || kind == GET_SOURCE_OUTPUT_INFO_LIST {
        info.streams(server, peer, tag, &reading, audio.RECORD, kind == GET_SOURCE_OUTPUT_INFO_LIST)
    } else if kind == GET_CLIENT_INFO || kind == GET_CLIENT_INFO_LIST {
        info.clients(server, peer, tag, &reading, kind == GET_CLIENT_INFO_LIST)
    } else if kind == GET_MODULE_INFO_LIST || kind == GET_SAMPLE_INFO_LIST || kind == GET_CARD_INFO_LIST {
        ack(server, peer, tag)
    } else if kind == GET_CARD_INFO {
        sendError(server, peer, tag, ERR_NOENTITY)
    } else if kind == LOOKUP_SINK || kind == LOOKUP_SOURCE {
        info.lookup(server, peer, tag, &reading, kind == LOOKUP_SOURCE)
    } else if kind == SET_SINK_VOLUME || kind == SET_SINK_MUTE || kind == SET_SOURCE_VOLUME || kind == SET_SOURCE_MUTE {
        info.setDevice(server, peer, tag, &reading, kind == SET_SOURCE_VOLUME || kind == SET_SOURCE_MUTE, kind == SET_SINK_MUTE || kind == SET_SOURCE_MUTE)
    } else if kind == SET_SINK_INPUT_VOLUME || kind == SET_SINK_INPUT_MUTE || kind == SET_SOURCE_OUTPUT_VOLUME || kind == SET_SOURCE_OUTPUT_MUTE {
        info.setStream(server, peer, tag, &reading, if kind == SET_SINK_INPUT_VOLUME || kind == SET_SINK_INPUT_MUTE { audio.PLAY } else { audio.RECORD }, kind == SET_SINK_INPUT_MUTE || kind == SET_SOURCE_OUTPUT_MUTE)
    } else if kind == MOVE_SINK_INPUT || kind == MOVE_SOURCE_OUTPUT {
        info.move(server, peer, tag, &reading, if kind == MOVE_SINK_INPUT { audio.PLAY } else { audio.RECORD })
    } else if kind == KILL_SINK_INPUT || kind == KILL_SOURCE_OUTPUT {
        info.kill(server, peer, tag, &reading, if kind == KILL_SINK_INPUT { audio.PLAY } else { audio.RECORD })
    } else if kind == SET_DEFAULT_SINK || kind == SET_DEFAULT_SOURCE || kind == SUSPEND_SINK || kind == SUSPEND_SOURCE {
        // One sink and one source are the defaults; suspending is the
        // server's business.
        ack(server, peer, tag)
    } else if kind == STAT {
        var writing: ts.Writer = undefined
        beginReply(server, &writing, tag)
        var index: usize = 0
        while index < 5 {
            ts.putU32(&writing, 0)
            index += 1
        }
        send(server, peer, &writing)
    } else if kind == EXTENSION {
        sendError(server, peer, tag, ERR_NOEXTENSION)
    } else {
        sendError(server, peer, tag, ERR_COMMAND)
    }
}

// ---------------------------------------------------------------------------
// Authentication

// AUTH(u32 version, bytes cookie): the cookie is not needed (the socket's
// peer is known); the reply waits for the bus's answer about
// audio.control.
fn auth(server: *state.Server, peer: *state.Peer, tag: u32, reading: *ts.Reader) -> void {
    const client = clientOf(peer)
    const asked = ts.readU32(reading) & 65535
    if reading.*.failed || asked < 13 {
        sendError(server, peer, tag, ERR_VERSION)
        return
    }
    client.*.version = if asked < VERSION { asked } else { VERSION }
    client.*.authTag = tag
    peer.*.control = state.CONTROL_CHECKING
    peer.*.controlSerial = protocol.askBus(server, peer, "audio.control")
    if peer.*.controlSerial == 0 {
        peer.*.control = state.CONTROL_DENIED
        authorized(server, peer)
    }
}

// The bus answered about audio.control: AUTH's reply (the version spoken,
// no shared memory).
pub fn authorized(server: *state.Server, peer: *state.Peer) -> void {
    const client = clientOf(peer)
    if client.*.authorized || client.*.authTag == INVALID { return }
    client.*.authorized = true
    var writing: ts.Writer = undefined
    beginReply(server, &writing, client.*.authTag)
    ts.putU32(&writing, VERSION)
    send(server, peer, &writing)
    client.*.authTag = INVALID
}

// ---------------------------------------------------------------------------
// Streams

fn resamplerOf(stream: *state.Stream) -> *state.Resampler {
    unsafe { return @ptrCast(*state.Resampler, &stream.*.resampler) }
}

fn setName(stream: *state.Stream, name: []const u8) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &stream.*.name) }
    stream.*.nameLength = copy(bytes, 64, name)
}

// PulseAudio's sample format in the server's encodings (INVALID: one it
// does not take).
fn encodingOf(format: u8) -> u32 {
    if format == FORMAT_S16LE { return audio.S16 }
    if format == FORMAT_FLOAT32LE { return audio.F32 }
    if format == FORMAT_S32LE { return audio.S32 }
    if format == FORMAT_U8 { return state.U8 }
    if format == FORMAT_S24LE { return state.S24 }
    if format == FORMAT_S24_32LE { return state.S24_32 }
    return INVALID
}

// The format a stream of the server's own protocol has, for the lists.
pub fn formatOf(stream: *state.Stream) -> u8 {
    if stream.*.pulse { return stream.*.pulseFormat }
    if stream.*.format == audio.S32 { return FORMAT_S32LE }
    if stream.*.format == audio.F32 { return FORMAT_FLOAT32LE }
    return FORMAT_S16LE
}

fn bytesPerSecond(stream: *state.Stream) -> u64 { return @intCast(u64, stream.*.rate) * @intCast(u64, stream.*.frameBytes) }

// `bytes` of the stream in microseconds.
pub fn usecOf(stream: *state.Stream, bytes: u64) -> u64 {
    const rate = bytesPerSecond(stream)
    if rate == 0 { return 0 }
    return bytes * 1000000 / rate
}

fn msBytes(stream: *state.Stream, milliseconds: u64) -> u32 {
    const bytes = bytesPerSecond(stream) * milliseconds / 1000
    return @intCast(u32, bytes / @intCast(u64, stream.*.frameBytes) * @intCast(u64, stream.*.frameBytes))
}

fn frameDown(stream: *state.Stream, bytes: u32) -> u32 {
    const frame = @intCast(u32, stream.*.frameBytes)
    return bytes / frame * frame
}

// A period of the server in the stream's bytes (at least a frame).
fn periodBytes(server: *state.Server, stream: *state.Stream) -> u32 {
    const frames = @intCast(u64, server.*.period) * @intCast(u64, stream.*.rate) / @intCast(u64, server.*.rate) + 1
    return @intCast(u32, frames * @intCast(u64, stream.*.frameBytes))
}

// The buffer's sizes as asked (INVALID: the default), made sensible:
// PulseAudio's defaults (2 s queued, 20 ms requests, playing starts once
// all but a request is there), within what the server can do.
fn settleAttributes(server: *state.Server, stream: *state.Stream, maxlength: u32, tlength: u32, prebuf: u32, minreq: u32, fragsize: u32) -> void {
    var most = maxlength
    if most == INVALID || most > MAX_LENGTH { most = MAX_LENGTH }
    // The ring holds at most four seconds.
    const ring = msBytes(stream, 4000)
    if most > ring { most = ring }
    stream.*.maxLength = frameDown(stream, most)
    const least = periodBytes(server, stream) * 2
    if stream.*.direction == audio.PLAY {
        var target = tlength
        if target == INVALID { target = msBytes(stream, 2000) }
        if target > stream.*.maxLength { target = stream.*.maxLength }
        if target < least { target = least }
        stream.*.tlength = frameDown(stream, target)
        var request = minreq
        if request == INVALID { request = msBytes(stream, 20) }
        if request < periodBytes(server, stream) { request = periodBytes(server, stream) }
        if request > stream.*.tlength / 2 { request = stream.*.tlength / 2 }
        stream.*.minreq = frameDown(stream, request)
        if stream.*.minreq == 0 { stream.*.minreq = @intCast(u32, stream.*.frameBytes) }
        var start = prebuf
        if start == INVALID || start > stream.*.tlength - stream.*.minreq { start = stream.*.tlength - stream.*.minreq }
        stream.*.prebuf = frameDown(stream, start)
        stream.*.fragsize = 0
        // The ring's latency (protocol.open's target): tlength.
        stream.*.latency = @intCast(u32, usecOf(stream, @intCast(u64, stream.*.tlength)) / 1000 + 1)
    } else {
        var fragment = fragsize
        if fragment == INVALID { fragment = msBytes(stream, 2000) }
        if fragment > stream.*.maxLength { fragment = stream.*.maxLength }
        if fragment < periodBytes(server, stream) { fragment = periodBytes(server, stream) }
        stream.*.fragsize = frameDown(stream, fragment)
        stream.*.tlength = 0
        stream.*.prebuf = 0
        stream.*.minreq = 0
        stream.*.latency = 100
    }
}

// The sink a playback stream asked for (by name or index) as routing
// names it, or where a record stream records from, into `out`: its
// length, NO_TARGET when there is no such device.
const NO_TARGET: usize = 1099511627776

fn targetOf(server: *state.Server, record: bool, index: u32, name: []const u8, out: [*]u8) -> usize {
    if record {
        if name.length > 0 {
            if same(name, info.SOURCE_NAME) || same(name, "@DEFAULT_SOURCE@") { return 0 }
            if same(name, info.MONITOR_NAME) || same(name, "@DEFAULT_MONITOR@") { return copy(out, 16, "monitor") }
            if name.length > 8 && same(name[name.length - 8..name.length], ".monitor") && routing.findSink(server, name[0..name.length - 8]) != routing.NO_SINK {
                var length = copy(out, 8, "monitor:")
                return length + copy(advance(out, length), 32, name[0..name.length - 8])
            }
            return NO_TARGET
        }
        if index == INVALID || index == 0 { return 0 }
        if index == 1 { return copy(out, 16, "monitor") }
        const slot = @intCast(usize, index - 2)
        if slot >= state.MAX_SINKS || !routing.sinkAt(server, slot).*.used { return NO_TARGET }
        var length = copy(out, 8, "monitor:")
        return length + copy(advance(out, length), 32, routing.sinkName(routing.sinkAt(server, slot)))
    }
    if name.length > 0 {
        if same(name, info.SINK_NAME) || same(name, "@DEFAULT_SINK@") { return 0 }
        if routing.findSink(server, name) == routing.NO_SINK { return NO_TARGET }
        return copy(out, 32, name)
    }
    if index == INVALID || index == 0 { return 0 }
    const slot = @intCast(usize, index - 1)
    if slot >= state.MAX_SINKS || !routing.sinkAt(server, slot).*.used { return NO_TARGET }
    return copy(out, 32, routing.sinkName(routing.sinkAt(server, slot)))
}

// CREATE_PLAYBACK_STREAM and CREATE_RECORD_STREAM: the stream waits for
// the bus's answer (protocol.askPermission); opened() replies.
fn createStream(server: *state.Server, peer: *state.Peer, tag: u32, reading: *ts.Reader, bytes: [*]const u8, record: bool) -> void {
    const version = clientOf(peer).*.version
    var spec: ts.SampleSpec = undefined
    ts.readSampleSpec(reading, &spec)
    var map: [32]u8 = undefined
    var map_bytes: [*]u8 = undefined
    unsafe { map_bytes = @ptrCast([*]u8, &map) }
    const map_length = ts.readChannelMap(reading, map_bytes)
    const device_index = ts.readU32(reading)
    const device_name = ts.readString(reading)
    const maxlength = ts.readU32(reading)
    const corked = ts.readBool(reading)
    var tlength = INVALID
    var prebuf = INVALID
    var minreq = INVALID
    var fragsize = INVALID
    var volume: u32 = 65536
    if !record {
        tlength = ts.readU32(reading)
        prebuf = ts.readU32(reading)
        minreq = ts.readU32(reading)
        const sync = ts.readU32(reading)
        volume = ts.readCvolume(reading)
    } else {
        fragsize = ts.readU32(reading)
    }
    // no_remap, no_remix, fix_format, fix_rate, fix_channels, dont_move,
    // variable_rate.
    var index: usize = 0
    while index < 7 {
        const flag = ts.readBool(reading)
        index += 1
    }
    const muted = ts.readBool(reading)
    const adjust = ts.readBool(reading)
    var start: usize = 0
    ts.readProplist(reading, &start)
    const properties_end = reading.*.position
    if record { const direct = ts.readU32(reading) }
    var volume_set = false
    if version >= 14 {
        if !record { volume_set = ts.readBool(reading) }
        const early = ts.readBool(reading)
    }
    if version >= 15 {
        if !record { const muted_set = ts.readBool(reading) }
        const inhibit = ts.readBool(reading)
        const fail_suspend = ts.readBool(reading)
    }
    if reading.*.failed {
        sendError(server, peer, tag, ERR_PROTOCOL)
        return
    }
    const encoding = encodingOf(spec.format)
    if encoding == INVALID || spec.channels < 1 || spec.channels > 32 || spec.rate < 8000 || spec.rate > 192000 || (map_length != 0 && map_length != @intCast(usize, spec.channels)) {
        sendError(server, peer, tag, if encoding == INVALID { ERR_NOTSUPPORTED } else { ERR_INVALID })
        return
    }
    var slot: usize = state.MAX_STREAMS
    index = 0
    while index < state.MAX_STREAMS {
        if !mixer.streamAt(server, index).*.used {
            slot = index
            break
        }
        index += 1
    }
    if slot == state.MAX_STREAMS {
        sendError(server, peer, tag, ERR_NOTSUPPORTED)
        return
    }
    var target: [48]u8 = undefined
    var target_bytes: [*]u8 = undefined
    unsafe { target_bytes = @ptrCast([*]u8, &target) }
    const target_length = targetOf(server, record, device_index, device_name, target_bytes)
    if target_length == NO_TARGET {
        sendError(server, peer, tag, ERR_NOENTITY)
        return
    }
    const stream = mixer.streamAt(server, slot)
    stream.*.used = true
    stream.*.peer = @intFromPtr(peer)
    stream.*.id = @intCast(u32, slot)
    stream.*.direction = if record { audio.RECORD } else { audio.PLAY }
    stream.*.format = encoding
    stream.*.channels = @intCast(u32, spec.channels)
    stream.*.rate = spec.rate
    stream.*.frameBytes = samples.bytesOf(encoding) * @intCast(usize, spec.channels)
    stream.*.pulse = true
    stream.*.pulseFormat = spec.format
    index = 0
    while index < map_length {
        stream.*.map[index] = map[index]
        index += 1
    }
    stream.*.mapLength = map_length
    const name = ts.property(bytes, start, properties_end, "media.name")
    setName(stream, if name.length > 0 { name } else { if record { "Recording" } else { "Playback" } })
    stream.*.volume = if !record && volume_set { info.linearOf(volume) } else { 65536 }
    stream.*.muted = muted
    stream.*.state = state.CHECKING
    stream.*.capacity = 0
    stream.*.start = 0
    stream.*.filled = 0
    stream.*.requested = 0
    stream.*.carryLength = 0
    stream.*.draining = false
    stream.*.started = false
    stream.*.underruns = 0
    stream.*.corked = corked
    stream.*.written = 0
    stream.*.playingFor = 0
    stream.*.createTag = tag
    stream.*.drainTag = state.NO_TAG
    stream.*.underflowed = false
    settleAttributes(server, stream, maxlength, tlength, prebuf, minreq, fragsize)
    if !routing.place(server, stream, protocol.appOf(peer), target_bytes[0..target_length]) {
        stream.*.used = false
        sendError(server, peer, tag, ERR_NOENTITY)
        return
    }
    protocol.askPermission(server, stream)
}

// The ring a playing stream needs beyond its latency's: what its
// maxlength holds (frames of the server).
pub fn ringFrames(server: *state.Server, stream: *state.Stream) -> usize {
    return @intCast(usize, @intCast(u64, stream.*.maxLength) / @intCast(u64, stream.*.frameBytes) * @intCast(u64, server.*.rate) / @intCast(u64, stream.*.rate))
}

// The bus allowed it (protocol.open made its ring): the reply the
// creation waited for.
pub fn opened(server: *state.Server, stream: *state.Stream) -> void {
    const peer = protocol.peerAt(stream.*.peer)
    const version = clientOf(peer).*.version
    const record = stream.*.direction == audio.RECORD
    var writing: ts.Writer = undefined
    beginReply(server, &writing, stream.*.createTag)
    stream.*.createTag = state.NO_TAG
    ts.putU32(&writing, stream.*.id)
    ts.putU32(&writing, stream.*.id)
    if !record {
        // Wanted at once: all of tlength.
        ts.putU32(&writing, stream.*.tlength)
        stream.*.requested = @intCast(usize, stream.*.tlength)
        ts.putU32(&writing, stream.*.maxLength)
        ts.putU32(&writing, stream.*.tlength)
        ts.putU32(&writing, stream.*.prebuf)
        ts.putU32(&writing, stream.*.minreq)
    } else {
        ts.putU32(&writing, stream.*.maxLength)
        ts.putU32(&writing, stream.*.fragsize)
    }
    ts.putSampleSpec(&writing, stream.*.pulseFormat, @intCast(u8, stream.*.channels), stream.*.rate)
    if stream.*.mapLength > 0 {
        var map: [*]const u8 = undefined
        unsafe { map = @ptrCast([*]const u8, &stream.*.map) }
        ts.putChannelMap(&writing, map, stream.*.mapLength)
    } else {
        ts.putDefaultChannelMap(&writing, @intCast(usize, stream.*.channels))
    }
    if record {
        const source = info.sourceIndexOf(stream)
        ts.putU32(&writing, source)
        info.putSourceName(&writing, server, source)
    } else {
        ts.putU32(&writing, info.sinkIndexOf(stream))
        ts.putString(&writing, info.sinkNameOf(server, info.sinkIndexOf(stream)))
    }
    ts.putBool(&writing, false)
    ts.putUsec(&writing, usecOf(stream, @intCast(u64, if record { stream.*.fragsize } else { stream.*.tlength })))
    if !record || version >= 22 { ts.putPcmFormat(&writing) }
    send(server, peer, &writing)
    event(server, if record { FACILITY_SOURCE_OUTPUT } else { FACILITY_SINK_INPUT }, EVENT_NEW, stream.*.id)
    // A stream with nothing to wait for plays as data comes.
    if !record { startIfReady(server, stream) }
}

// The bus refused it (creating: the error; open: it is killed).
pub fn refused(server: *state.Server, stream: *state.Stream) -> void {
    const peer = protocol.peerAt(stream.*.peer)
    if stream.*.createTag != state.NO_TAG {
        sendError(server, peer, stream.*.createTag, ERR_ACCESS)
        stream.*.createTag = state.NO_TAG
        return
    }
    killed(server, stream)
}

fn killed(server: *state.Server, stream: *state.Stream) -> void {
    var writing: ts.Writer = undefined
    begin(server, &writing, if stream.*.direction == audio.PLAY { PLAYBACK_STREAM_KILLED } else { RECORD_STREAM_KILLED }, INVALID)
    ts.putU32(&writing, stream.*.id)
    send(server, protocol.peerAt(stream.*.peer), &writing)
}

// A stream went (deleted, its app left, refused): who subscribed hears.
pub fn streamGone(server: *state.Server, stream: *state.Stream) -> void {
    if stream.*.state != state.OPEN { return }
    event(server, if stream.*.direction == audio.PLAY { FACILITY_SINK_INPUT } else { FACILITY_SOURCE_OUTPUT }, EVENT_REMOVE, @intCast(u32, slotOf(server, stream)))
}

fn slotOf(server: *state.Server, stream: *state.Stream) -> usize {
    return (@intFromPtr(stream) - @intFromPtr(mixer.streamAt(server, 0))) / @sizeOf(state.Stream)
}

// What the mixer tells a stream (protocol.sendStreamValue): more wanted,
// drained, ended.
pub fn streamValue(server: *state.Server, stream: *state.Stream, kind: u32, value: u32) -> void {
    const peer = protocol.peerAt(stream.*.peer)
    if kind == audio.REQUEST {
        var writing: ts.Writer = undefined
        begin(server, &writing, REQUEST, INVALID)
        ts.putU32(&writing, stream.*.id)
        ts.putU32(&writing, value)
        send(server, peer, &writing)
    } else if kind == audio.DRAINED {
        if stream.*.drainTag != state.NO_TAG {
            ack(server, peer, stream.*.drainTag)
            stream.*.drainTag = state.NO_TAG
        }
    } else if kind == audio.ENDED {
        killed(server, stream)
    }
}

// The bytes a playing stream has queued (its ring and a split frame).
pub fn queuedBytes(server: *state.Server, stream: *state.Stream) -> u64 {
    const frames = @intCast(u64, stream.*.filled) * @intCast(u64, stream.*.rate) / @intCast(u64, server.*.rate)
    return frames * @intCast(u64, stream.*.frameBytes) + @intCast(u64, stream.*.carryLength)
}

// The stream's read index: what it wrote less what waits.
pub fn readIndex(server: *state.Server, stream: *state.Stream) -> u64 {
    const queued = queuedBytes(server, stream)
    if queued > stream.*.written { return 0 }
    return stream.*.written - queued
}

fn startIfReady(server: *state.Server, stream: *state.Stream) -> void {
    if stream.*.started || stream.*.corked || stream.*.state != state.OPEN { return }
    const queued = queuedBytes(server, stream)
    if queued == 0 || queued < @intCast(u64, stream.*.prebuf) { return }
    stream.*.started = true
    stream.*.underflowed = false
    stream.*.playingFor = 0
    var writing: ts.Writer = undefined
    begin(server, &writing, STARTED, INVALID)
    ts.putU32(&writing, stream.*.id)
    send(server, protocol.peerAt(stream.*.peer), &writing)
}

// Samples came (mixer.feed): counted, and playing starts once there are
// enough (prebuf).
pub fn fed(server: *state.Server, stream: *state.Stream, length: usize) -> void {
    stream.*.written += @intCast(u64, length)
    startIfReady(server, stream)
}

// The mixer took `count` of a period's `frames` from the stream: counted;
// short of a period it ran dry (UNDERFLOW), and waits for prebuf again.
pub fn consumed(server: *state.Server, stream: *state.Stream, count: usize, frames: usize) -> void {
    stream.*.playingFor += @intCast(u64, count) * @intCast(u64, stream.*.rate) / @intCast(u64, server.*.rate) * @intCast(u64, stream.*.frameBytes)
    if count >= frames || stream.*.draining || stream.*.underflowed { return }
    stream.*.underflowed = true
    if stream.*.prebuf > 0 { stream.*.started = false }
    var writing: ts.Writer = undefined
    begin(server, &writing, UNDERFLOW, INVALID)
    ts.putU32(&writing, stream.*.id)
    if clientOf(protocol.peerAt(stream.*.peer)).*.version >= 23 { ts.putS64(&writing, @intCast(i64, stream.*.written)) }
    send(server, protocol.peerAt(stream.*.peer), &writing)
}

// DRAIN, CORK, FLUSH, TRIGGER and PREBUF.
fn control(server: *state.Server, peer: *state.Peer, kind: u32, tag: u32, reading: *ts.Reader) -> void {
    const address = findStream(server, peer, ts.readU32(reading))
    if address == 0 {
        sendError(server, peer, tag, ERR_NOENTITY)
        return
    }
    const stream = streamOf(address)
    if kind == DRAIN_PLAYBACK_STREAM {
        if stream.*.direction != audio.PLAY || stream.*.drainTag != state.NO_TAG {
            sendError(server, peer, tag, ERR_INVALID)
            return
        }
        if stream.*.filled == 0 {
            ack(server, peer, tag)
            return
        }
        // What is there plays out, prebuf or not.
        stream.*.drainTag = tag
        stream.*.draining = true
        stream.*.started = true
        return
    }
    if kind == CORK_PLAYBACK_STREAM || kind == CORK_RECORD_STREAM {
        stream.*.corked = ts.readBool(reading)
        if reading.*.failed {
            sendError(server, peer, tag, ERR_PROTOCOL)
            return
        }
        ack(server, peer, tag)
        if stream.*.direction == audio.PLAY { startIfReady(server, stream) }
        return
    }
    if kind == FLUSH_PLAYBACK_STREAM && stream.*.direction == audio.PLAY {
        stream.*.filled = 0
        stream.*.start = 0
        stream.*.carryLength = 0
        stream.*.requested = 0
        if stream.*.prebuf > 0 { stream.*.started = false }
        ack(server, peer, tag)
        mixer.requestMore(server, stream)
        return
    }
    if kind == TRIGGER_PLAYBACK_STREAM {
        if stream.*.filled > 0 { stream.*.started = true }
    } else if kind == PREBUF_PLAYBACK_STREAM {
        stream.*.started = false
    }
    ack(server, peer, tag)
}

fn now(seconds: *u32, microseconds: *u32) -> void {
    var time: [2]usize = [2]usize{ 0, 0 }
    const result = std.linux.syscall2(228, 0, @intFromPtr(&time))
    seconds.* = @intCast(u32, time[0] & 4294967295)
    microseconds.* = @intCast(u32, time[1] / 1000)
}

// The device's latency after the mix: what is mixed and not yet heard.
pub fn deviceUsec(server: *state.Server) -> u64 {
    return @intCast(u64, server.*.period) * 2 * 1000000 / @intCast(u64, server.*.rate)
}

// GET_PLAYBACK_LATENCY and GET_RECORD_LATENCY: where the stream is, for
// the app's clock (pa_stream_get_time).
fn latency(server: *state.Server, peer: *state.Peer, record: bool, tag: u32, reading: *ts.Reader) -> void {
    const address = findStream(server, peer, ts.readU32(reading))
    var seconds: u32 = 0
    var microseconds: u32 = 0
    ts.readTimeval(reading, &seconds, &microseconds)
    if address == 0 || reading.*.failed {
        sendError(server, peer, tag, if address == 0 { ERR_NOENTITY } else { ERR_PROTOCOL })
        return
    }
    const stream = streamOf(address)
    var writing: ts.Writer = undefined
    beginReply(server, &writing, tag)
    var now_seconds: u32 = 0
    var now_microseconds: u32 = 0
    now(&now_seconds, &now_microseconds)
    if !record {
        ts.putUsec(&writing, deviceUsec(server))
        ts.putUsec(&writing, 0)
        ts.putBool(&writing, stream.*.started && !stream.*.corked)
        ts.putTimeval(&writing, seconds, microseconds)
        ts.putTimeval(&writing, now_seconds, now_microseconds)
        ts.putS64(&writing, @intCast(i64, stream.*.written))
        ts.putS64(&writing, @intCast(i64, readIndex(server, stream)))
        ts.putU64(&writing, 0)
        ts.putU64(&writing, stream.*.playingFor)
    } else {
        ts.putUsec(&writing, 0)
        ts.putUsec(&writing, @intCast(u64, server.*.period) * 1000000 / @intCast(u64, server.*.rate))
        ts.putBool(&writing, !stream.*.corked)
        ts.putTimeval(&writing, seconds, microseconds)
        ts.putTimeval(&writing, now_seconds, now_microseconds)
        ts.putS64(&writing, @intCast(i64, stream.*.written))
        ts.putS64(&writing, @intCast(i64, stream.*.written))
    }
    send(server, peer, &writing)
}

// SET_PLAYBACK_STREAM_BUFFER_ATTR and SET_RECORD_STREAM_BUFFER_ATTR: the
// sizes settled again, and said back.
fn bufferAttributes(server: *state.Server, peer: *state.Peer, record: bool, tag: u32, reading: *ts.Reader) -> void {
    const address = findStream(server, peer, ts.readU32(reading))
    const maxlength = ts.readU32(reading)
    var tlength = INVALID
    var prebuf = INVALID
    var minreq = INVALID
    var fragsize = INVALID
    if record {
        fragsize = ts.readU32(reading)
    } else {
        tlength = ts.readU32(reading)
        prebuf = ts.readU32(reading)
        minreq = ts.readU32(reading)
    }
    if address == 0 || reading.*.failed {
        sendError(server, peer, tag, if address == 0 { ERR_NOENTITY } else { ERR_PROTOCOL })
        return
    }
    const stream = streamOf(address)
    const old_capacity = stream.*.capacity
    settleAttributes(server, stream, maxlength, tlength, prebuf, minreq, fragsize)
    if !record {
        var target = @intCast(usize, @intCast(u64, stream.*.latency) * @intCast(u64, server.*.rate) / 1000)
        if target < server.*.period * 2 { target = server.*.period * 2 }
        // A smaller ring than the new sizes need stays: what does not fit
        // is dropped (as when an app writes past maxlength).
        if target * 2 + 256 > old_capacity { target = (old_capacity - 256) / 2 }
        stream.*.target = target
    }
    var writing: ts.Writer = undefined
    beginReply(server, &writing, tag)
    ts.putU32(&writing, stream.*.maxLength)
    if record {
        ts.putU32(&writing, stream.*.fragsize)
    } else {
        ts.putU32(&writing, stream.*.tlength)
        ts.putU32(&writing, stream.*.prebuf)
        ts.putU32(&writing, stream.*.minreq)
    }
    ts.putUsec(&writing, usecOf(stream, @intCast(u64, if record { stream.*.fragsize } else { stream.*.tlength })))
    send(server, peer, &writing)
    if !record { mixer.requestMore(server, stream) }
}

// Recorded samples to a record stream (protocol.sendRecorded): `frames`
// frames of the server's rate, stereo, in the stream's rate, channels and
// format, at its volume; nothing while it is corked.
pub fn sendRecorded(server: *state.Server, stream: *state.Stream, input: [*]const i32, frames: usize) -> void {
    if stream.*.corked { return }
    const bytes = server.*.pulseMessage
    const size = stream.*.frameBytes
    const room = MESSAGE_SIZE / size
    var count: usize = 0
    var index: usize = 0
    var made: [64]i32 = undefined
    var made_bytes: [*]i32 = undefined
    unsafe { made_bytes = @ptrCast([*]i32, &made) }
    const volume = if stream.*.muted { @intCast(i64, 0) } else { @intCast(i64, stream.*.volume) }
    while index < frames {
        var produced: usize = 1
        if stream.*.rate == server.*.rate {
            made[0] = input[index * 2]
            made[1] = input[index * 2 + 1]
        } else {
            produced = samples.resample(resamplerOf(stream), input[index * 2], input[index * 2 + 1], made_bytes, 32)
        }
        var each: usize = 0
        while each < produced && count < room {
            const left = samples.clamp(@intCast(i64, made[each * 2]) * volume / 65536)
            const right = samples.clamp(@intCast(i64, made[each * 2 + 1]) * volume / 65536)
            samples.encodeFrame(bytes, DESCRIPTOR + count * size, stream.*.format, stream.*.channels, left, right)
            count += 1
            each += 1
        }
        index += 1
    }
    if count == 0 { return }
    descriptor(bytes, count * size, stream.*.id)
    // A client that does not read loses samples, not its connection.
    const sent = protocol.sendTo(server, protocol.peerAt(stream.*.peer), bytes, DESCRIPTOR + count * size)
    if sent { stream.*.written += @intCast(u64, count * size) }
}
