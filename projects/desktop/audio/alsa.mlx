// Sound cards through the kernel's ALSA PCM interface (/dev/snd/pcmC*D*p
// and ...c), without alsa-lib: hardware parameters (interleaved, 16 or
// 32 bits, stereo, the server's rate when the card has it), software
// parameters, then frames written (playing) or read (recording) with
// ioctls. The descriptor is non-blocking: the event loop watches it and
// moves a period whenever the card has room (or has one).
//
// The layouts and numbers are the kernel's (include/uapi/sound/asound.h,
// x86_64): snd_pcm_hw_params is 608 bytes (masks from 4, intervals from
// 260, rmask at 512), snd_pcm_sw_params 136, snd_xferi 24.
//
// When the device's path is a Unix socket, the card is emulated by a test
// harness (tools/fake_alsa.py), and the same ioctls travel as frames (as
// the compositor's DRM card does, projects/desktop/compositor/device.mlx):
//
//   hello:    u32 kind (3), u32 length (8), i64 0, or -EBUSY when the
//             card is taken
//   request:  u32 kind (1), u32 length, u64 request, the argument's
//             bytes, then (WRITEI_FRAMES) the frames written
//   reply:    u32 kind (1), u32 length, i64 result, the argument's bytes
//             back, then (READI_FRAMES) the frames read
//   wake:     u32 kind (2), u32 length (0): the card has room (or a
//             period recorded); the event loop then watches the socket for
//             reading, where a real card is polled for writing.
const std = @import("std")
const audio = @import("std.audio")
const dbus = @import("std.dbus")
const state = @import("./state.mlx")

const SYS_ioctl: usize = 16
const SYS_open: usize = 2
const SYS_close: usize = 3

const HW_PARAMS: usize = 3261088017
const SW_PARAMS: usize = 3230155027
const PREPARE: usize = 16704
const START: usize = 16706
const DROP: usize = 16707
const WRITEI_FRAMES: usize = 1075331408
const READI_FRAMES: usize = 2149073233

const PARAM_ACCESS: usize = 0
const PARAM_FORMAT: usize = 1
const PARAM_SUBFORMAT: usize = 2
const PARAM_SAMPLE_BITS: usize = 8
const PARAM_FRAME_BITS: usize = 9
const PARAM_CHANNELS: usize = 10
const PARAM_RATE: usize = 11
const PARAM_PERIOD_SIZE: usize = 13
const PARAM_PERIODS: usize = 15
const PARAM_BUFFER_SIZE: usize = 17

const ACCESS_RW_INTERLEAVED: u32 = 3
const FORMAT_S16_LE: u32 = 2
const FORMAT_S32_LE: u32 = 10
const PCM_VERSION: u32 = 131089

const EAGAIN: isize = -11
const EPIPE: isize = -32
const ESTRPIPE: isize = -86
pub const EBUSY: isize = -16

const S_IFMT: u32 = 61440
const S_IFSOCK: u32 = 49152
const FRAME_IOCTL: u32 = 1
const FRAME_WAKE: u32 = 2
const FRAME_HELLO: u32 = 3

fn store32(bytes: [*]u8, at: usize, value: u32) -> void { audio.store32(bytes, at, value) }
fn load32(bytes: [*]const u8, at: usize) -> u32 { return audio.load32(bytes, at) }

fn store64(bytes: [*]u8, at: usize, value: u64) -> void {
    store32(bytes, at, @intCast(u32, value & 4294967295))
    store32(bytes, at + 4, @intCast(u32, value >> 32))
}

fn ioctl(descriptor: isize, request: usize, argument: usize) -> isize {
    return std.linux.syscall3(SYS_ioctl, @bitCast(usize, descriptor), request, argument)
}

// ---------------------------------------------------------------------------
// An emulated card's frames

fn advance(bytes: [*]u8, count: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(bytes) + count) }
}

fn sendAll(descriptor: isize, bytes: [*]const u8, length: usize) -> bool {
    var done: usize = 0
    while done < length {
        // sendto(..., MSG_NOSIGNAL)
        const sent = std.linux.syscall6(44, @bitCast(usize, descriptor), @intFromPtr(bytes) + done, length - done, 16384, 0, 0)
        if sent <= 0 { return false }
        done += @intCast(usize, sent)
    }
    return true
}

fn receiveAll(descriptor: isize, bytes: [*]u8, length: usize) -> bool {
    var done: usize = 0
    while done < length {
        const got = std.linux.syscall3(0, @bitCast(usize, descriptor), @intFromPtr(bytes) + done, length - done)
        if got <= 0 { return false }
        done += @intCast(usize, got)
    }
    return true
}

// The next frame that is not a wake: its kind and length (the header
// read; the payload not).
fn nextFrame(descriptor: isize, kind: *u32, length: *usize) -> bool {
    var header: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &header) }
    while true {
        if !receiveAll(descriptor, bytes, 8) { return false }
        kind.* = load32(bytes, 0)
        length.* = @intCast(usize, load32(bytes, 4))
        if kind.* != FRAME_WAKE { return true }
        var skipped: [64]u8 = undefined
        var rest = length.*
        while rest > 0 {
            const part = if rest > 64 { 64 } else { rest }
            unsafe { if !receiveAll(descriptor, @ptrCast([*]u8, &skipped), part) { return false } }
            rest -= part
        }
    }
    return false
}

// An ioctl to the emulated card: the `size` bytes at `argument` go out
// (and `extra` after them) and come back changed; `back` takes what the
// reply carries after them. The result, or a negative errno.
fn emulatedIoctl(device: *state.Device, request: usize, argument: [*]u8, size: usize, extra: [*]const u8, extra_length: usize, back: [*]u8, back_capacity: usize) -> isize {
    var header: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &header) }
    store32(bytes, 0, FRAME_IOCTL)
    store32(bytes, 4, @intCast(u32, 8 + size + extra_length))
    store64(bytes, 8, @intCast(u64, request))
    const descriptor = device.*.descriptor
    if !sendAll(descriptor, bytes, 16) || !sendAll(descriptor, argument, size) || !sendAll(descriptor, extra, extra_length) { return -5 }
    var kind: u32 = 0
    var length: usize = 0
    if !nextFrame(descriptor, &kind, &length) || kind != FRAME_IOCTL || length < 8 + size { return -5 }
    if !receiveAll(descriptor, bytes, 8) || !receiveAll(descriptor, argument, size) { return -5 }
    const rest = length - 8 - size
    if rest > back_capacity { return -5 }
    if rest > 0 && !receiveAll(descriptor, back, rest) { return -5 }
    const result = @bitCast(isize, @intCast(usize, load32(bytes, 0)) | (@intCast(usize, load32(bytes, 4)) << 32))
    return result
}

// Takes the wakes that came (the event loop's readiness); the card's
// frames come only as replies, so nothing else waits on the socket.
pub fn takeWakes(device: *state.Device) -> void {
    if !device.*.emulated { return }
    var bytes: [256]u8 = undefined
    // recvfrom(..., MSG_DONTWAIT)
    while std.linux.syscall6(45, @bitCast(usize, device.*.descriptor), @intFromPtr(&bytes), 256, 64, 0, 0) > 0 {}
}

// The ioctl, to the card or its emulation.
fn control(device: *state.Device, request: usize, argument: [*]u8, size: usize) -> isize {
    if device.*.emulated {
        var nothing: [1]u8 = [1]u8{ 0 }
        unsafe { return emulatedIoctl(device, request, argument, size, @ptrCast([*]const u8, &nothing), 0, @ptrCast([*]u8, &nothing), 0) }
    }
    return ioctl(device.*.descriptor, request, @intFromPtr(argument))
}

// Opens `path`: a sound card's device node, or the socket of an emulated
// one (its hello read). The descriptor, or a negative errno.
fn openDevice(device: *state.Device, path: [*]const u8) -> isize {
    var status: std.fs.Stat = undefined
    device.*.emulated = std.fs.status(path, &status) == 0 && status.mode & S_IFMT == S_IFSOCK
    if !device.*.emulated {
        // O_RDWR | O_NONBLOCK | O_CLOEXEC.
        return std.linux.syscall3(SYS_open, @intFromPtr(path), 2 | 2048 | 524288, 0)
    }
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    const descriptor = dbus.connect(path[0..length])
    if descriptor < 0 { return descriptor }
    // Blocking: an ioctl waits for its reply.
    const flags = std.linux.syscall2(72, @bitCast(usize, descriptor), 3)
    const set = std.linux.syscall3(72, @bitCast(usize, descriptor), 4, @bitCast(usize, flags) & 18446744073709549567)
    var kind: u32 = 0
    var hello: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &hello) }
    if !nextFrame(descriptor, &kind, &length) || kind != FRAME_HELLO || length != 8 || !receiveAll(descriptor, bytes, 8) {
        dbus.closeDescriptor(descriptor)
        return -5
    }
    if load32(bytes, 0) != 0 {
        dbus.closeDescriptor(descriptor)
        return EBUSY
    }
    return descriptor
}

// Everything allowed: what the card then narrows down.
fn initParams(params: [*]u8) -> void {
    var index: usize = 0
    while index < 608 {
        params[index] = 0
        index += 1
    }
    // The three masks: all bits.
    index = 4
    while index < 4 + 3 * 32 {
        params[index] = 255
        index += 1
    }
    // The intervals: 0 to the largest.
    var interval: usize = 0
    while interval < 12 {
        store32(params, 260 + interval * 12 + 4, 4294967295)
        interval += 1
    }
    store32(params, 512, 4294967295)
    store32(params, 520, 4294967295)
}

fn setMask(params: [*]u8, param: usize, bit: u32) -> void {
    const at = 4 + param * 32
    var index: usize = 0
    while index < 32 {
        params[at + index] = 0
        index += 1
    }
    const word = at + @intCast(usize, bit / 32) * 4
    store32(params, word, load32(params, word) | (@intCast(u32, 1) << (bit % 32)))
}

fn setInterval(params: [*]u8, param: usize, low: u32, high: u32) -> void {
    const at = 260 + (param - 8) * 12
    store32(params, at, low)
    store32(params, at + 4, high)
    // integer
    store32(params, at + 8, 4)
}

fn intervalOf(params: [*]const u8, param: usize) -> u32 { return load32(params, 260 + (param - 8) * 12) }

// One try at the hardware parameters: true when the card took them.
fn tryParams(device: *state.Device, params: [*]u8, format: u32, bits: u32, rate: u32, period: usize) -> bool {
    initParams(params)
    setMask(params, PARAM_ACCESS, ACCESS_RW_INTERLEAVED)
    setMask(params, PARAM_FORMAT, format)
    setMask(params, PARAM_SUBFORMAT, 0)
    setInterval(params, PARAM_SAMPLE_BITS, bits, bits)
    setInterval(params, PARAM_FRAME_BITS, bits * 2, bits * 2)
    setInterval(params, PARAM_CHANNELS, 2, 2)
    setInterval(params, PARAM_RATE, rate, rate)
    if period > 0 {
        setInterval(params, PARAM_PERIOD_SIZE, @intCast(u32, period), @intCast(u32, period))
        setInterval(params, PARAM_PERIODS, 4, 8)
    }
    return control(device, HW_PARAMS, params, 608) == 0
}

// Opens the PCM device at `path` (NUL-terminated) for playing or
// recording at `rate` (or 48000 or 44100 when the card lacks it), in
// periods near `period` frames: 0, or a negative errno (EBUSY: another
// program has it; ENOENT: no such card).
pub fn open(device: *state.Device, path: [*]const u8, capture: bool, rate: u32, period: usize) -> isize {
    const descriptor = openDevice(device, path)
    if descriptor < 0 { return descriptor }
    device.*.descriptor = descriptor
    var params: [608]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &params) }
    const rates = [3]u32{ rate, 48000, 44100 }
    const periods = [4]usize{ period, 512, 1024, 0 }
    var done = false
    var encoding = audio.S16
    var format_index: usize = 0
    while format_index < 2 && !done {
        const format = if format_index == 0 { FORMAT_S16_LE } else { FORMAT_S32_LE }
        const bits: u32 = if format_index == 0 { 16 } else { 32 }
        var rate_index: usize = 0
        while rate_index < 3 && !done {
            var period_index: usize = 0
            while period_index < 4 && !done {
                if tryParams(device, bytes, format, bits, rates[rate_index], periods[period_index]) {
                    done = true
                    encoding = if format_index == 0 { audio.S16 } else { audio.S32 }
                }
                period_index += 1
            }
            rate_index += 1
        }
        format_index += 1
    }
    if !done {
        const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
        return -22
    }
    device.*.encoding = encoding
    device.*.channels = 2
    device.*.rate = intervalOf(bytes, PARAM_RATE)
    device.*.period = @intCast(usize, intervalOf(bytes, PARAM_PERIOD_SIZE))
    device.*.buffer = @intCast(usize, intervalOf(bytes, PARAM_BUFFER_SIZE))
    // Software parameters: wake when a period fits, start once half the
    // buffer is there (playing) or at once (recording), never stop on our
    // own.
    var software: [136]u8 = undefined
    var soft: [*]u8 = undefined
    unsafe { soft = @ptrCast([*]u8, &software) }
    var index: usize = 0
    while index < 136 {
        software[index] = 0
        index += 1
    }
    store32(soft, 4, 1)
    store64(soft, 16, @intCast(u64, device.*.period))
    store64(soft, 24, 1)
    store64(soft, 32, if capture { 1 } else { @intCast(u64, device.*.buffer / 2) })
    store64(soft, 40, @intCast(u64, device.*.buffer))
    var boundary = @intCast(u64, device.*.buffer)
    while boundary * 2 <= 2147483647 { boundary = boundary * 2 }
    store64(soft, 64, boundary)
    store32(soft, 72, PCM_VERSION)
    var nothing: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    var none: [*]u8 = undefined
    unsafe { none = @ptrCast([*]u8, &nothing) }
    if control(device, SW_PARAMS, soft, 136) != 0 || control(device, PREPARE, none, 0) != 0 {
        const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
        return -22
    }
    if capture { const started = control(device, START, none, 0) }
    device.*.kind = state.ALSA
    return 0
}

// Moves `frames` frames between `bytes` and the card: how many went, 0
// when it has no room (or nothing) now; an underrun or overrun is
// recovered from (and counted).
fn transfer(device: *state.Device, bytes: [*]u8, frames: usize, capture: bool) -> usize {
    var transfer_record: [24]u8 = undefined
    var record: [*]u8 = undefined
    unsafe { record = @ptrCast([*]u8, &transfer_record) }
    store64(record, 0, 0)
    store64(record, 8, @intCast(u64, @intFromPtr(bytes)))
    store64(record, 16, @intCast(u64, frames))
    var result: isize = 0
    if device.*.emulated {
        const size = frameBytesOf(device) * frames
        if capture {
            var nothing: [1]u8 = [1]u8{ 0 }
            unsafe { result = emulatedIoctl(device, READI_FRAMES, record, 24, @ptrCast([*]const u8, &nothing), 0, bytes, size) }
        } else {
            result = emulatedIoctl(device, WRITEI_FRAMES, record, 24, bytes, size, bytes, 0)
        }
    } else {
        result = ioctl(device.*.descriptor, if capture { READI_FRAMES } else { WRITEI_FRAMES }, @intFromPtr(record))
    }
    if result == 0 { return @intCast(usize, load32(record, 0)) }
    if result == EPIPE || result == ESTRPIPE {
        device.*.xruns += 1
        var nothing: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
        var none: [*]u8 = undefined
        unsafe { none = @ptrCast([*]u8, &nothing) }
        const prepared = control(device, PREPARE, none, 0)
        if capture { const started = control(device, START, none, 0) }
    }
    return 0
}

// The bytes of a frame (stereo).
fn frameBytesOf(device: *state.Device) -> usize { return if device.*.encoding == audio.S16 { 4 } else { 8 } }

pub fn write(device: *state.Device, bytes: [*]u8, frames: usize) -> usize { return transfer(device, bytes, frames, false) }
pub fn read(device: *state.Device, bytes: [*]u8, frames: usize) -> usize { return transfer(device, bytes, frames, true) }

pub fn close(device: *state.Device) -> void {
    var nothing: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    var none: [*]u8 = undefined
    unsafe { none = @ptrCast([*]u8, &nothing) }
    const dropped = control(device, DROP, none, 0)
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, device.*.descriptor))
}
