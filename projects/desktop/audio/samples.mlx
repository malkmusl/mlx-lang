// Samples: decoding the formats streams and files come in into the mix's
// frames (stereo, in the 16-bit range, in i32), encoding them back,
// linear resampling, and a tone. Integer arithmetic throughout (floats
// only for F32 samples).
const std = @import("std")
const audio = @import("std.audio")
const state = @import("./state.mlx")

pub fn bytesOf(encoding: u32) -> usize {
    if encoding == state.U8 { return 1 }
    if encoding == audio.S16 { return 2 }
    if encoding == state.S24 { return 3 }
    return 4
}

fn signed16(low: u8, high: u8) -> i32 {
    const value = @intCast(i32, low) | (@intCast(i32, high) << 8)
    if value >= 32768 { return value - 65536 }
    return value
}

pub fn clamp(value: i64) -> i32 {
    if value > 32767 { return 32767 }
    if value < -32768 { return -32768 }
    return @intCast(i32, value)
}

// The sample at `bytes[at]` in `encoding`, in the 16-bit range.
pub fn decode(bytes: [*]const u8, at: usize, encoding: u32) -> i32 {
    if encoding == audio.S16 { return signed16(bytes[at], bytes[at + 1]) }
    if encoding == audio.S32 { return signed16(bytes[at + 2], bytes[at + 3]) }
    if encoding == state.S24 { return signed16(bytes[at + 1], bytes[at + 2]) }
    if encoding == state.U8 { return (@intCast(i32, bytes[at]) - 128) << 8 }
    // F32.
    const bits = @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) | (@intCast(u32, bytes[at + 2]) << 16) | (@intCast(u32, bytes[at + 3]) << 24)
    var value: f32 = @bitCast(f32, bits)
    if value != value { return 0 }
    if value > 1.0 { value = 1.0 }
    if value < -1.0 { value = -1.0 }
    const scaled = value * 32767.0
    const sample: i32 = @intFromFloat(i32, scaled)
    return sample
}

// Writes `sample` (16-bit range) at `bytes[at]` in `encoding` (S16, S32
// or F32).
pub fn encode(bytes: [*]u8, at: usize, encoding: u32, sample: i32) -> void {
    if encoding == audio.S16 {
        const value = @bitCast(u32, sample)
        bytes[at] = @intCast(u8, value & 255)
        bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
        return
    }
    var value: u32 = 0
    if encoding == audio.S32 {
        value = @bitCast(u32, sample * 65536)
    } else {
        const real: f32 = @floatFromInt(f32, sample) / 32768.0
        value = @bitCast(u32, real)
    }
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 2] = @intCast(u8, (value >> 16) & 255)
    bytes[at + 3] = @intCast(u8, value >> 24)
}

// The frame at `bytes[at]` (`channels` samples): its left and right (a
// single channel goes to both; more than two: the first two).
pub fn decodeFrame(bytes: [*]const u8, at: usize, encoding: u32, channels: u32, left: *i32, right: *i32) -> void {
    left.* = decode(bytes, at, encoding)
    if channels == 1 {
        right.* = left.*
    } else {
        right.* = decode(bytes, at + bytesOf(encoding), encoding)
    }
}

// Writes a frame of `channels` (one: the mean of left and right; more
// than two: silence in the others).
pub fn encodeFrame(bytes: [*]u8, at: usize, encoding: u32, channels: u32, left: i32, right: i32) -> void {
    const size = bytesOf(encoding)
    if channels == 1 {
        encode(bytes, at, encoding, (left + right) / 2)
        return
    }
    encode(bytes, at, encoding, left)
    encode(bytes, at + size, encoding, right)
    var channel: u32 = 2
    while channel < channels {
        encode(bytes, at + @intCast(usize, channel) * size, encoding, 0)
        channel += 1
    }
}

// ---------------------------------------------------------------------------
// Resampling

pub fn startResampler(resampler: *state.Resampler, from: u32, to: u32) -> void {
    resampler.*.step = @intCast(u32, @intCast(u64, from) * 65536 / @intCast(u64, to))
    resampler.*.position = 0
    resampler.*.previousLeft = 0
    resampler.*.previousRight = 0
    resampler.*.primed = false
}

fn between(from: i32, to: i32, position: u32) -> i32 {
    return @intCast(i32, @intCast(i64, from) + (@intCast(i64, to - from) * @intCast(i64, position)) / 65536)
}

// Takes one input frame and writes the output frames it completes into
// `out` (interleaved; at most `most`): how many.
pub fn resample(resampler: *state.Resampler, left: i32, right: i32, out: [*]i32, most: usize) -> usize {
    if !resampler.*.primed {
        resampler.*.previousLeft = left
        resampler.*.previousRight = right
        resampler.*.primed = true
        return 0
    }
    var count: usize = 0
    while resampler.*.position < 65536 && count < most {
        out[count * 2] = between(resampler.*.previousLeft, left, resampler.*.position)
        out[count * 2 + 1] = between(resampler.*.previousRight, right, resampler.*.position)
        count += 1
        resampler.*.position += resampler.*.step
    }
    if resampler.*.position >= 65536 { resampler.*.position -= 65536 } else { resampler.*.position = 0 }
    resampler.*.previousLeft = left
    resampler.*.previousRight = right
    return count
}

// ---------------------------------------------------------------------------
// A tone

// The sine of `phase` (a full turn is 2^32), at half the 16-bit range
// (Bhaskara's approximation, within 0.2%).
pub fn sine(phase: u32) -> i32 {
    const half = phase >> 31
    // Where in its half wave, of 65536.
    const t = @intCast(i64, (phase & 2147483647) >> 15)
    const q = t * (65536 - t)
    const value = (16 * q * 16384) / (5 * 4294967296 - 4 * q)
    if half == 1 { return @intCast(i32, 0 - value) }
    return @intCast(i32, value)
}
