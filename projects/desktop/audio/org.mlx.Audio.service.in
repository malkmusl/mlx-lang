# MLX Audio, started by mlx-ipcd (MLXIPC) when an app first asks for it.
# It lives in PREFIX/share/mlx/dbus-1/services, where only MLXIPC looks
# (mlx-session passes --services): on another session bus MLX Audio could
# not check its apps' permissions.
[D-BUS Service]
Name=org.mlx.Audio
Exec=@BINDIR@/mlx-audiod
