# ALSA programs play and record through MLX Audio: its PulseAudio socket,
# by ALSA's pulse plugin, MLX Audio's own (projects/desktop/libpulse,
# alsa.mlx; it carries its own PulseAudio client, so it needs neither
# libpulse0 nor alsa-plugins). The installer puts this file in
# /etc/alsa/conf.d after the other sound servers' defaults
# (99-zz-mlx-audio.conf: pipewire-alsa's 99-pipewire-default.conf comes
# first), with @ALSA_PLUGIN@ the plugin's path.
pcm_type.pulse {
    lib "@ALSA_PLUGIN@"
}
ctl_type.pulse {
    lib "@ALSA_PLUGIN@"
}
pcm.!default {
    type pulse
    hint {
        show on
        description "MLX Audio"
    }
}
ctl.!default {
    type pulse
}
# (Replacing alsa-plugins' own pulse device, when its configuration is
# there.)
pcm.!pulse {
    type pulse
    hint {
        show on
        description "MLX Audio"
    }
}
ctl.!pulse {
    type pulse
}
