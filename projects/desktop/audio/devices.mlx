// Where the mix goes and where recordings come from:
//
//   output  auto (the first sound card), alsa[:pcmC1D0p], file:PATH.wav
//           (the mix, 16-bit stereo, written as it plays), null (played
//           to nobody, at the real pace)
//   input   auto (the first sound card's capture), alsa[:NAME], sine:HZ
//           (a tone), file:PATH.wav (looped), none (silence)
//
// A sound card paces the server itself (the event loop moves a period
// whenever it has room); otherwise a timer does, a period at a time. A
// card that is missing or busy (PipeWire or PulseAudio has it: who, is
// said) is tried again every 2 seconds, playing to nobody meanwhile, so a
// card that comes or is freed is taken. mlx-settings switches them while
// they play (switchOutput, switchInput).
const std = @import("std")
const audio = @import("std.audio")
const wav = @import("std.wav")
const state = @import("./state.mlx")
const samples = @import("./samples.mlx")
const alsa = @import("./alsa.mlx")
const mixer = @import("./mixer.mlx")
const dbus = @import("std.dbus")

const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_write: usize = 1
const SYS_pwrite: usize = 18
const SYS_lseek: usize = 8
const O_WRONLY: usize = 1
const O_CREAT: usize = 64
const O_TRUNC: usize = 512
const O_CLOEXEC: usize = 524288

pub fn outputOf(server: *state.Server) -> *state.Device {
    unsafe { return @ptrCast(*state.Device, &server.*.output) }
}

pub fn inputOf(server: *state.Server) -> *state.Device {
    unsafe { return @ptrCast(*state.Device, &server.*.input) }
}

fn resamplerOf(device: *state.Device) -> *state.Resampler {
    unsafe { return @ptrCast(*state.Resampler, &device.*.resampler) }
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    var index: usize = 0
    while index < prefix.length {
        if text[index] != prefix[index] { return false }
        index += 1
    }
    return true
}

fn same(first: []const u8, second: []const u8) -> bool { return first.length == second.length && startsWith(first, second) }

fn say(server: *state.Server, text: []const u8) -> void {
    if server.*.verbose { const ignored = std.io.writeAll(std.io.stdout(), text) }
}

fn sayNumber(server: *state.Server, value: usize) -> void {
    if server.*.verbose { const ignored = std.io.writeUnsigned(std.io.stdout(), value) }
}

// `text` NUL-terminated into the device's path.
fn setPath(device: *state.Device, first: []const u8, second: []const u8) -> [*]const u8 {
    var length: usize = 0
    var index: usize = 0
    while index < first.length && length < 250 {
        device.*.path[length] = first[index]
        length += 1
        index += 1
    }
    index = 0
    while index < second.length && length < 250 {
        device.*.path[length] = second[index]
        length += 1
        index += 1
    }
    device.*.path[length] = 0
    device.*.pathLength = length
    unsafe { return @ptrCast([*]const u8, &device.*.path) }
}

fn reset(device: *state.Device) -> void {
    device.*.kind = state.NONE
    device.*.descriptor = -1
    device.*.emulated = false
    device.*.hertz = 0
    device.*.encoding = audio.S16
    device.*.channels = 2
    device.*.period = 0
    device.*.buffer = 0
    device.*.pathLength = 0
    device.*.written = 0
    device.*.dataLength = 0
    device.*.position = 0
    device.*.pendingCount = 0
    device.*.phase = 0
    device.*.phaseStep = 0
    device.*.xruns = 0
}

// Where the sound cards are: /dev/snd and /proc/asound, or what
// MLX_SND_DIR and MLX_ASOUND_DIR say (tests: tools/fake_alsa.py).
fn sndDirectory(server: *state.Server) -> []const u8 {
    const value = std.process.environmentFrom(server.*.environment, "MLX_SND_DIR")
    if value != null && value.?.length > 0 { return std.string.asSlice(value.?) }
    return "/dev/snd"
}

fn asoundDirectory(server: *state.Server) -> []const u8 {
    const value = std.process.environmentFrom(server.*.environment, "MLX_ASOUND_DIR")
    if value != null && value.?.length > 0 { return std.string.asSlice(value.?) }
    return "/proc/asound"
}

// Whether `name` is a PCM device "pcmC<card>D<device><p|c>" of the kind
// wanted (playback "p", capture "c").
fn isPcm(name: []const u8, capture: bool) -> bool {
    if name.length < 8 || !startsWith(name, "pcmC") { return false }
    const last = name[name.length - 1]
    return last == (if capture { 99 } else { 112 })
}

// The card number of a PCM device's name.
fn cardOf(name: []const u8) -> u32 { return parseNumber(name[4..name.length]) }

// The device number (after "D").
fn deviceOf(name: []const u8) -> u32 {
    var at: usize = 4
    while at < name.length && name[at] != 68 { at += 1 }
    if at + 1 >= name.length { return 0 }
    return parseNumber(name[at + 1..name.length])
}

// The PCM devices of the kind wanted, each followed by a NUL, sorted by
// name; their total length.
fn pcmNames(server: *state.Server, capture: bool, out: [*]u8, capacity: usize) -> usize {
    var path: [256]u8 = undefined
    var path_bytes: [*]u8 = undefined
    unsafe { path_bytes = @ptrCast([*]u8, &path) }
    const directory = sndDirectory(server)
    var length = copyText(path_bytes, 0, directory)
    path[length] = 0
    const handle = std.linux.syscall3(SYS_open, @intFromPtr(path_bytes), 65536 | O_CLOEXEC, 0)
    if handle < 0 { return 0 }
    var buffer: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var reader = std.fs.entries(std.fs.File.{ .descriptor = handle }, bytes, 4096)
    var entry: std.fs.Entry = undefined
    var total: usize = 0
    while std.fs.nextEntry(&reader, &entry) {
        const name = std.string.asSlice(entry.name)
        if isPcm(name, capture) && total + name.length + 1 <= capacity {
            // Insertion in order.
            var at: usize = 0
            while at < total {
                var end = at
                while out[end] != 0 { end += 1 }
                if before(name, out[at..end]) { break }
                at = end + 1
            }
            var move = total
            while move > at {
                move -= 1
                out[move + name.length + 1] = out[move]
            }
            var index: usize = 0
            while index < name.length {
                out[at + index] = name[index]
                index += 1
            }
            out[at + name.length] = 0
            total += name.length + 1
        }
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, handle))
    return total
}

fn before(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

fn copyText(target: [*]u8, at: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && at + index < 250 {
        target[at + index] = text[index]
        index += 1
    }
    return at + index
}

// The first line of a small file, trimmed, into `out`: its length.
fn firstLine(path: [*]const u8, out: [*]u8, capacity: usize) -> usize {
    const file = std.fs.open(path, O_CLOEXEC, 0)
    if file.descriptor < 0 { return 0 }
    const got = std.fs.read(file, out, capacity)
    const closed = std.fs.close(file)
    if got <= 0 { return 0 }
    var length: usize = 0
    while length < @intCast(usize, got) && out[length] != 10 { length += 1 }
    while length > 0 && out[length - 1] == 32 { length -= 1 }
    return length
}

// What a PCM device is called: "<card id>: <its name>" from the
// asound directory, or the device's own name.
pub fn labelOf(server: *state.Server, name: []const u8, out: [*]u8, capacity: usize) -> usize {
    var path: [300]u8 = undefined
    var path_bytes: [*]u8 = undefined
    unsafe { path_bytes = @ptrCast([*]u8, &path) }
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    const card_length = numberText(digit_bytes, cardOf(name))
    var length = copyText(path_bytes, 0, asoundDirectory(server))
    length = copyText(path_bytes, length, "/card")
    length = copyText(path_bytes, length, digit_bytes[0..card_length])
    const card_end = length
    length = copyText(path_bytes, length, "/id")
    path[length] = 0
    var id: [64]u8 = undefined
    var id_bytes: [*]u8 = undefined
    unsafe { id_bytes = @ptrCast([*]u8, &id) }
    const id_length = firstLine(path_bytes, id_bytes, 63)
    // card<N>/pcm<D><p|c>/info: "name: ..." on one of its lines.
    length = copyText(path_bytes, card_end, "/pcm")
    length = copyText(path_bytes, length, digit_bytes[0..numberText(digit_bytes, deviceOf(name))])
    length = copyText(path_bytes, length, name[name.length - 1..name.length])
    length = copyText(path_bytes, length, "/info")
    path[length] = 0
    var info: [1024]u8 = undefined
    var info_bytes: [*]u8 = undefined
    unsafe { info_bytes = @ptrCast([*]u8, &info) }
    var info_length: usize = 0
    const file = std.fs.open(path_bytes, O_CLOEXEC, 0)
    if file.descriptor >= 0 {
        const got = std.fs.read(file, info_bytes, 1024)
        const closed = std.fs.close(file)
        if got > 0 { info_length = @intCast(usize, got) }
    }
    var pcm_name: []const u8 = info_bytes[0..0]
    var at: usize = 0
    while at < info_length {
        var end = at
        while end < info_length && info[end] != 10 { end += 1 }
        if startsWith(info_bytes[at..end], "name: ") { pcm_name = info_bytes[at + 6..end] }
        at = end + 1
    }
    if id_length == 0 && pcm_name.length == 0 { return copyLimited(out, 0, capacity, name) }
    var made = copyLimited(out, 0, capacity, id_bytes[0..id_length])
    if pcm_name.length > 0 {
        if made > 0 { made = copyLimited(out, made, capacity, ": ") }
        made = copyLimited(out, made, capacity, pcm_name)
    }
    return made
}

fn copyLimited(target: [*]u8, at: usize, capacity: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length && at + index < capacity {
        target[at + index] = text[index]
        index += 1
    }
    return at + index
}

fn numberText(out: [*]u8, value: u32) -> usize {
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var length: usize = 0
    while count > 0 {
        count -= 1
        out[length] = digits[count]
        length += 1
    }
    return length
}

// Lists the cards' devices of a kind for the Sound settings: lines
// "device = <p|c>\t<name>\t<label>\n" appended at `at`; the new end.
pub fn listCards(server: *state.Server, capture: bool, out: [*]u8, at: usize, capacity: usize) -> usize {
    var names: [2048]u8 = undefined
    var names_bytes: [*]u8 = undefined
    unsafe { names_bytes = @ptrCast([*]u8, &names) }
    const total = pcmNames(server, capture, names_bytes, 2048)
    var label: [160]u8 = undefined
    var label_bytes: [*]u8 = undefined
    unsafe { label_bytes = @ptrCast([*]u8, &label) }
    var length = at
    var start: usize = 0
    while start < total && length + 300 < capacity {
        var end = start
        while names[end] != 0 { end += 1 }
        const name = names_bytes[start..end]
        length = copyLimited(out, length, capacity, if capture { "device = c\t" } else { "device = p\t" })
        length = copyLimited(out, length, capacity, name)
        length = copyLimited(out, length, capacity, "\t")
        length = copyLimited(out, length, capacity, label_bytes[0..labelOf(server, name, label_bytes, 160)])
        length = copyLimited(out, length, capacity, "\n")
        start = end + 1
    }
    return length
}

// Who has `path` open (a process's name from /proc), into the server's
// holder; told when a card is busy.
fn findHolder(server: *state.Server, path: []const u8) -> void {
    server.*.holderLength = 0
    var proc_path: [*]const u8 = undefined
    unsafe { proc_path = @ptrCast([*]const u8, "/proc") }
    const proc = std.linux.syscall3(SYS_open, @intFromPtr(proc_path), 65536 | O_CLOEXEC, 0)
    if proc < 0 { return }
    var buffer: [8192]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var reader = std.fs.entries(std.fs.File.{ .descriptor = proc }, bytes, 8192)
    var entry: std.fs.Entry = undefined
    var link: [300]u8 = undefined
    var link_bytes: [*]u8 = undefined
    unsafe { link_bytes = @ptrCast([*]u8, &link) }
    var target: [300]u8 = undefined
    var target_bytes: [*]u8 = undefined
    unsafe { target_bytes = @ptrCast([*]u8, &target) }
    while server.*.holderLength == 0 && std.fs.nextEntry(&reader, &entry) {
        const pid = std.string.asSlice(entry.name)
        if pid.length > 0 && pid[0] >= 49 && pid[0] <= 57 {
            var length = copyText(link_bytes, 0, "/proc/")
            length = copyText(link_bytes, length, pid)
            const pid_end = length
            length = copyText(link_bytes, length, "/fd")
            link[length] = 0
            const fds = std.linux.syscall3(SYS_open, @intFromPtr(link_bytes), 65536 | O_CLOEXEC, 0)
            if fds >= 0 {
                var fd_buffer: [4096]u8 = undefined
                var fd_bytes: [*]u8 = undefined
                unsafe { fd_bytes = @ptrCast([*]u8, &fd_buffer) }
                var fd_reader = std.fs.entries(std.fs.File.{ .descriptor = fds }, fd_bytes, 4096)
                var fd_entry: std.fs.Entry = undefined
                while server.*.holderLength == 0 && std.fs.nextEntry(&fd_reader, &fd_entry) {
                    var at = copyText(link_bytes, length, "/")
                    at = copyText(link_bytes, at, std.string.asSlice(fd_entry.name))
                    link[at] = 0
                    const got = std.fs.readLink(link_bytes, target_bytes, 299)
                    if got > 0 && same(target_bytes[0..@intCast(usize, got)], path) {
                        var comm = copyText(link_bytes, pid_end, "/comm")
                        link[comm] = 0
                        var name: [*]u8 = undefined
                        unsafe { name = @ptrCast([*]u8, &server.*.holder) }
                        server.*.holderLength = firstLine(link_bytes, name, 63)
                    }
                }
                const closed_fds = std.linux.syscall1(SYS_close, @bitCast(usize, fds))
            }
        }
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, proc))
}

// Opens a card's PCM device for playing or recording: `name` (pcmC1D0p,
// or a path), or the first there is. 0, or a negative errno: the first
// card's problem (EBUSY, and who has it), ENOENT when there is none.
fn openCard(server: *state.Server, device: *state.Device, name: []const u8, capture: bool) -> isize {
    if name.length > 0 {
        const path = if name[0] == 47 { setPath(device, name, "") } else { setPath(device, sndDirectory(server), "/") }
        if name[0] != 47 { const appended = appendPath(device, name) }
        const result = alsa.open(device, path, capture, server.*.rate, server.*.period)
        if result == alsa.EBUSY { findHolder(server, device.*.path[0..device.*.pathLength]) }
        return result
    }
    var names: [2048]u8 = undefined
    var names_bytes: [*]u8 = undefined
    unsafe { names_bytes = @ptrCast([*]u8, &names) }
    const total = pcmNames(server, capture, names_bytes, 2048)
    var first_problem: isize = -2
    var start: usize = 0
    while start < total {
        var end = start
        while names[end] != 0 { end += 1 }
        const path = setPath(device, sndDirectory(server), "/")
        const appended = appendPath(device, names_bytes[start..end])
        const result = alsa.open(device, path, capture, server.*.rate, server.*.period)
        if result == 0 { return 0 }
        if first_problem == -2 {
            first_problem = result
            if result == alsa.EBUSY { findHolder(server, device.*.path[0..device.*.pathLength]) }
        }
        start = end + 1
    }
    return first_problem
}

fn appendPath(device: *state.Device, text: []const u8) -> [*]const u8 {
    var length = device.*.pathLength
    var index: usize = 0
    while index < text.length && length < 250 {
        device.*.path[length] = text[index]
        length += 1
        index += 1
    }
    device.*.path[length] = 0
    device.*.pathLength = length
    unsafe { return @ptrCast([*]const u8, &device.*.path) }
}

// Reads the file at `path` (NUL-terminated) whole into allocated memory:
// its length, 0 when it cannot.
fn readWhole(server: *state.Server, path: [*]const u8, device: *state.Device) -> usize {
    const file = std.fs.open(path, O_CLOEXEC, 0)
    if file.descriptor < 0 { return 0 }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(file, &status) != 0 || status.size <= 0 || status.size > 268435456 {
        const closed = std.fs.close(file)
        return 0
    }
    const size = @intCast(usize, status.size)
    const memory = server.*.allocator.alloc(size, 16)
    if memory == null { return 0 }
    var length: usize = 0
    while length < size {
        var at: [*]u8 = undefined
        unsafe { at = @ptrFromInt([*]u8, @intFromPtr(memory.?) + length) }
        const got = std.fs.read(file, at, size - length)
        if got <= 0 { break }
        length += @intCast(usize, got)
    }
    const closed = std.fs.close(file)
    device.*.data = memory.?
    return length
}

fn parseNumber(text: []const u8) -> u32 {
    var value: u32 = 0
    var index: usize = 0
    while index < text.length && text[index] >= 48 && text[index] <= 57 {
        value = value * 10 + @intCast(u32, text[index] - 48)
        index += 1
    }
    return value
}

pub fn outputSpec(server: *state.Server) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &server.*.outputSpec) }
    return bytes[0..server.*.outputSpecLength]
}

pub fn inputSpec(server: *state.Server) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &server.*.inputSpec) }
    return bytes[0..server.*.inputSpecLength]
}

pub fn setOutputSpec(server: *state.Server, spec: []const u8) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &server.*.outputSpec) }
    server.*.outputSpecLength = copyLimited(bytes, 0, 159, spec)
}

pub fn setInputSpec(server: *state.Server, spec: []const u8) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &server.*.inputSpec) }
    server.*.inputSpecLength = copyLimited(bytes, 0, 159, spec)
}

// Whether a spec names a card (auto, alsa, alsa:NAME).
pub fn wantsCard(spec: []const u8) -> bool { return same(spec, "auto") || startsWith(spec, "alsa") }

fn tell(server: *state.Server, what: []const u8, problem: isize) -> void {
    say(server, "audio: ")
    say(server, what)
    if problem == alsa.EBUSY {
        say(server, ": the sound card is busy")
        if server.*.holderLength > 0 {
            say(server, " (")
            var bytes: [*]const u8 = undefined
            unsafe { bytes = @ptrCast([*]const u8, &server.*.holder) }
            say(server, bytes[0..server.*.holderLength])
            say(server, " has it)")
        }
        say(server, "; trying again every 2 s\n")
    } else {
        say(server, ": no sound card; trying again every 2 s\n")
    }
}

// Opens the output the spec asks for: a card (else, for now, nobody: its
// problem kept, the card tried again), a file, or nobody. False when the
// spec is not one, or a file cannot be written.
pub fn openOutput(server: *state.Server) -> bool {
    const spec = outputSpec(server)
    const device = outputOf(server)
    reset(device)
    server.*.outputProblem = 0
    if wantsCard(spec) {
        const name = if startsWith(spec, "alsa:") { spec[5..spec.length] } else { spec[0..0] }
        const result = openCard(server, device, name, false)
        if result == 0 {
            server.*.rate = device.*.rate
            server.*.period = if device.*.period > state.MAX_PERIOD { state.MAX_PERIOD } else { device.*.period }
            say(server, "audio: playing to ")
            say(server, device.*.path[0..device.*.pathLength])
            say(server, " at ")
            sayNumber(server, @intCast(usize, device.*.rate))
            say(server, " Hz, periods of ")
            sayNumber(server, device.*.period)
            say(server, " frames\n")
            return true
        }
        reset(device)
        device.*.kind = state.NULL
        server.*.outputProblem = result
        tell(server, "playing to nobody", result)
        return true
    }
    if same(spec, "null") {
        device.*.kind = state.NULL
        return true
    }
    if startsWith(spec, "file:") {
        const path = setPath(device, spec[5..spec.length], "")
        // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC.
        const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(path), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 420)
        if descriptor < 0 {
            const said = std.io.eprintln("mlx-audiod: the output file could not be written")
            return false
        }
        device.*.kind = state.FILE
        device.*.descriptor = descriptor
        writeFileHeader(device, server.*.rate)
        // The samples follow the header (which is written in place, again
        // and again, as they grow).
        const moved = std.linux.syscall3(SYS_lseek, @bitCast(usize, descriptor), wav.HEADER_SIZE, 0)
        return true
    }
    const said = std.io.eprintln("mlx-audiod: an output is auto, alsa[:NAME], file:PATH.wav or null")
    return false
}

// Opens the input the spec asks for (a card, else silence for now).
pub fn openInput(server: *state.Server) -> bool {
    const spec = inputSpec(server)
    const device = inputOf(server)
    reset(device)
    server.*.inputProblem = 0
    if wantsCard(spec) {
        const name = if startsWith(spec, "alsa:") { spec[5..spec.length] } else { spec[0..0] }
        const result = openCard(server, device, name, true)
        if result == 0 {
            say(server, "audio: recording from ")
            say(server, device.*.path[0..device.*.pathLength])
            say(server, "\n")
            samples.startResampler(resamplerOf(device), device.*.rate, server.*.rate)
            return true
        }
        reset(device)
        server.*.inputProblem = result
        tell(server, "recording silence", result)
        return true
    }
    if same(spec, "none") { return true }
    if startsWith(spec, "sine:") {
        device.*.kind = state.SINE
        device.*.hertz = parseNumber(spec[5..spec.length])
        retune(server)
        return true
    }
    if startsWith(spec, "file:") {
        const path = setPath(device, spec[5..spec.length], "")
        const length = readWhole(server, path, device)
        var info: wav.Info = undefined
        if length == 0 || !wav.parse(device.*.data, length, &info) {
            const said = std.io.eprintln("mlx-audiod: the input file is not a WAVE file this reads")
            return false
        }
        device.*.kind = state.FILE
        device.*.position = info.dataStart
        device.*.dataLength = info.dataStart + info.dataLength
        device.*.fileChannels = info.channels
        device.*.fileRate = info.rate
        device.*.fileEncoding = if info.format == wav.FORMAT_FLOAT { audio.F32 } else if info.bits == 8 { state.U8 } else if info.bits == 16 { audio.S16 } else if info.bits == 24 { state.S24 } else { audio.S32 }
        device.*.fileFrame = samples.bytesOf(device.*.fileEncoding) * @intCast(usize, info.channels)
        // Its first frame, again and again from dataStart.
        device.*.buffer = info.dataStart
        samples.startResampler(resamplerOf(device), info.rate, server.*.rate)
        return true
    }
    const said = std.io.eprintln("mlx-audiod: an input is auto, alsa[:NAME], sine:HZ, file:PATH.wav or none")
    return false
}

// After the server's rate changed (another output): every stream's and
// device's conversion again.
pub fn retune(server: *state.Server) -> void {
    const input = inputOf(server)
    if input.*.kind == state.SINE { input.*.phaseStep = @intCast(u32, (@intCast(u64, input.*.hertz) << 32) / @intCast(u64, server.*.rate)) }
    if input.*.kind == state.FILE { samples.startResampler(resamplerOf(input), input.*.fileRate, server.*.rate) }
    if input.*.kind == state.ALSA { samples.startResampler(resamplerOf(input), input.*.rate, server.*.rate) }
}

// Watches what paces the server: the sound card (its descriptor; an
// emulated one for reading), else the timer; the card being recorded
// from; the retry timer while a card is missing or busy.
pub fn arm(server: *state.Server) -> void {
    const output = outputOf(server)
    if output.*.kind == state.ALSA {
        const watching = dbus.watch(server.*.eventLoop, output.*.descriptor, state.CARD_OUT, !output.*.emulated)
        // Its buffer filled at once (a card has room until it is full).
        mixer.cardWritable(server)
    } else {
        // CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC.
        server.*.timer = std.linux.syscall2(283, 1, 526336)
        const nanoseconds = @intCast(u64, server.*.period) * 1000000000 / @intCast(u64, server.*.rate)
        setTimer(server.*.timer, nanoseconds)
        const watching = dbus.watch(server.*.eventLoop, server.*.timer, state.TIMER, false)
    }
    const input = inputOf(server)
    if input.*.kind == state.ALSA { const watching = dbus.watch(server.*.eventLoop, input.*.descriptor, state.CARD_IN, false) }
    const retrying = server.*.outputProblem != 0 || server.*.inputProblem != 0
    setTimer(server.*.retryTimer, if retrying { 2000000000 } else { 0 })
}

fn setTimer(timer: isize, nanoseconds: u64) -> void {
    var spec: [4]u64 = [4]u64{ nanoseconds / 1000000000, nanoseconds % 1000000000, nanoseconds / 1000000000, nanoseconds % 1000000000 }
    const set = std.linux.syscall4(286, @bitCast(usize, timer), 0, @intFromPtr(&spec), 0)
}

// Stops watching the output and input (before they change).
pub fn disarm(server: *state.Server) -> void {
    const output = outputOf(server)
    if output.*.kind == state.ALSA {
        const unwatched = dbus.unwatch(server.*.eventLoop, output.*.descriptor)
    } else if server.*.timer >= 0 {
        const unwatched = dbus.unwatch(server.*.eventLoop, server.*.timer)
        dbus.closeDescriptor(server.*.timer)
        server.*.timer = -1
    }
    const input = inputOf(server)
    if input.*.kind == state.ALSA { const unwatched = dbus.unwatch(server.*.eventLoop, input.*.descriptor) }
}

fn closeOutput(server: *state.Server) -> void {
    const output = outputOf(server)
    if output.*.kind == state.ALSA { alsa.close(output) }
    if output.*.kind == state.FILE {
        writeFileHeader(output, server.*.rate)
        const closed = std.linux.syscall1(SYS_close, @bitCast(usize, output.*.descriptor))
    }
    output.*.kind = state.NONE
    server.*.encodedFrames = 0
}

fn closeInput(server: *state.Server) -> void {
    const input = inputOf(server)
    if input.*.kind == state.ALSA { alsa.close(input) }
    if input.*.kind == state.FILE && input.*.dataLength > 0 { server.*.allocator.free(input.*.data, input.*.dataLength, 16) }
    input.*.kind = state.NONE
}

// Another output (mlx-settings, or the card that came back): the streams
// carry on at the new device's rate. False when the spec is not one.
pub fn switchOutput(server: *state.Server, spec: []const u8) -> bool {
    disarm(server)
    closeOutput(server)
    setOutputSpec(server, spec)
    const opened = openOutput(server)
    if !opened {
        setOutputSpec(server, "null")
        const fallback = openOutput(server)
    }
    retune(server)
    mixer.retuneStreams(server)
    arm(server)
    return opened
}

pub fn switchInput(server: *state.Server, spec: []const u8) -> bool {
    disarm(server)
    closeInput(server)
    setInputSpec(server, spec)
    const opened = openInput(server)
    if !opened {
        setInputSpec(server, "none")
        const fallback = openInput(server)
    }
    arm(server)
    return opened
}

// The retry timer: the cards that were missing or busy, again.
pub fn retry(server: *state.Server) -> void {
    var expirations: u64 = 0
    const read = std.linux.syscall3(0, @bitCast(usize, server.*.retryTimer), @intFromPtr(&expirations), 8)
    if server.*.outputProblem != 0 {
        var probe: state.Device = undefined
        reset(&probe)
        const spec = outputSpec(server)
        const result = openCard(server, &probe, if startsWith(spec, "alsa:") { spec[5..spec.length] } else { spec[0..0] }, false)
        if result == 0 {
            alsa.close(&probe)
            say(server, "audio: the sound card is free now\n")
            var again: [160]u8 = undefined
            var again_bytes: [*]u8 = undefined
            unsafe { again_bytes = @ptrCast([*]u8, &again) }
            const length = copyLimited(again_bytes, 0, 159, spec)
            const switched = switchOutput(server, again_bytes[0..length])
        }
    }
    if server.*.inputProblem != 0 {
        var probe: state.Device = undefined
        reset(&probe)
        const spec = inputSpec(server)
        const result = openCard(server, &probe, if startsWith(spec, "alsa:") { spec[5..spec.length] } else { spec[0..0] }, true)
        if result == 0 {
            alsa.close(&probe)
            var again: [160]u8 = undefined
            var again_bytes: [*]u8 = undefined
            unsafe { again_bytes = @ptrCast([*]u8, &again) }
            const length = copyLimited(again_bytes, 0, 159, spec)
            const switched = switchInput(server, again_bytes[0..length])
        }
    }
}

fn writeFileHeader(device: *state.Device, rate: u32) -> void {
    var header: [44]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &header) }
    wav.writeHeader(bytes, rate, 2, wav.FORMAT_PCM, 16, device.*.written)
    const written = std.linux.syscall4(SYS_pwrite, @bitCast(usize, device.*.descriptor), @intFromPtr(bytes), 44, 0)
}

// Plays `frames` frames of the device's bytes: how many it took (a sound
// card may take fewer, or none, when it is full).
pub fn play(server: *state.Server, bytes: [*]u8, frames: usize) -> usize {
    const device = outputOf(server)
    if device.*.kind == state.ALSA { return alsa.write(device, bytes, frames) }
    if device.*.kind == state.FILE {
        const length = frames * 4
        const written = std.linux.syscall3(SYS_write, @bitCast(usize, device.*.descriptor), @intFromPtr(bytes), length)
        if written > 0 { device.*.written += @intCast(usize, written) }
        // The header follows about once a second, so that the file is
        // whole even when the server is killed.
        server.*.periods += 1
        if server.*.periods % 100 == 0 { writeFileHeader(device, server.*.rate) }
    }
    return frames
}

// A period of input into `out` (interleaved stereo) from a tone, a file
// or nothing.
pub fn generate(server: *state.Server, out: [*]i32, frames: usize) -> void {
    const device = inputOf(server)
    var index: usize = 0
    if device.*.kind == state.SINE {
        while index < frames {
            const value = samples.sine(device.*.phase)
            out[index * 2] = value
            out[index * 2 + 1] = value
            device.*.phase +%= device.*.phaseStep
            index += 1
        }
        return
    }
    if device.*.kind == state.FILE {
        while index < frames {
            if device.*.pendingCount == 0 {
                var left: i32 = 0
                var right: i32 = 0
                samples.decodeFrame(device.*.data, device.*.position, device.*.fileEncoding, device.*.fileChannels, &left, &right)
                device.*.position += device.*.fileFrame
                if device.*.position + device.*.fileFrame > device.*.dataLength { device.*.position = device.*.buffer }
                var pending: [*]i32 = undefined
                unsafe { pending = @ptrCast([*]i32, &device.*.pending) }
                device.*.pendingCount = samples.resample(resamplerOf(device), left, right, pending, 32)
                device.*.pendingAt = 0
            }
            if device.*.pendingCount > 0 {
                const at = device.*.pendingAt
                out[index * 2] = device.*.pending[at * 2]
                out[index * 2 + 1] = device.*.pending[at * 2 + 1]
                device.*.pendingAt += 1
                device.*.pendingCount -= 1
                index += 1
            }
        }
        return
    }
    while index < frames * 2 {
        out[index] = 0
        index += 1
    }
}

// What the sound card recorded (up to `most` frames of its own), in the
// server's rate, into `out`: how many frames.
pub fn record(server: *state.Server, out: [*]i32, most: usize) -> usize {
    const device = inputOf(server)
    var frames = device.*.period
    if frames > 2048 { frames = 2048 }
    const got = alsa.read(device, server.*.recorded, frames)
    const size = samples.bytesOf(device.*.encoding) * 2
    var count: usize = 0
    var index: usize = 0
    var left: i32 = 0
    var right: i32 = 0
    while index < got {
        samples.decodeFrame(server.*.recorded, index * size, device.*.encoding, 2, &left, &right)
        if device.*.rate == server.*.rate {
            if count < most {
                out[count * 2] = left
                out[count * 2 + 1] = right
                count += 1
            }
        } else {
            var made: [64]i32 = undefined
            var made_bytes: [*]i32 = undefined
            unsafe { made_bytes = @ptrCast([*]i32, &made) }
            const produced = samples.resample(resamplerOf(device), left, right, made_bytes, 32)
            var each: usize = 0
            while each < produced && count < most {
                out[count * 2] = made[each * 2]
                out[count * 2 + 1] = made[each * 2 + 1]
                count += 1
                each += 1
            }
        }
        index += 1
    }
    return count
}

pub fn close(server: *state.Server) -> void {
    closeOutput(server)
    closeInput(server)
}
