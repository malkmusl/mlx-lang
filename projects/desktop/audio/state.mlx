// The records of mlx-audiod (MLX Audio): the server, its peers (the apps'
// MLXIPC channels), their streams, the devices it plays to and records
// from. They live here, apart from the modules that use them, because
// those modules import one another.
const std = @import("std")
const dbus = @import("std.dbus")

pub const MAX_PEERS: usize = 64
pub const MAX_STREAMS: usize = 64
pub const MAX_ASKED: usize = 32
// The most frames a period has (a sound card may choose large ones).
pub const MAX_PERIOD: usize = 8192

// Event tokens below any peer's address.
pub const BUS: usize = 1
pub const TIMER: usize = 2
pub const SIGNALS: usize = 3
pub const CARD_OUT: usize = 4
pub const CARD_IN: usize = 5
pub const RETRY: usize = 6

// Whether a peer may control the server (audio.control: volumes, devices,
// other apps' streams), as the bus said.
pub const CONTROL_UNKNOWN: u8 = 0
pub const CONTROL_CHECKING: u8 = 1
pub const CONTROL_ALLOWED: u8 = 2
pub const CONTROL_DENIED: u8 = 3

// Linear resampling of interleaved stereo frames (16-bit range, in i32):
// `step` is how far the input moves per output frame (16.16), `position`
// where the next output frame lies after `previous` (16.16, below 1).
pub const Resampler = struct {
    step: u32
    position: u32
    previousLeft: i32
    previousRight: i32
    primed: bool
}

// What a stream is waiting for.
pub const CHECKING: u8 = 0
pub const OPEN: u8 = 1

pub const Stream = struct {
    used: bool
    peer: usize
    id: u32
    direction: u32
    format: u32
    channels: u32
    rate: u32
    latency: u32
    frameBytes: usize
    name: [64]u8
    nameLength: usize
    // 65536 is 100%.
    volume: u32
    state: u8
    // The serial of the org.mlx.IPC.Check the stream waits for.
    checkSerial: u32
    // Playing: the device's frames to play, interleaved stereo.
    ring: [*]i32
    capacity: usize
    start: usize
    filled: usize
    // The frames the stream keeps buffered (its latency).
    target: usize
    // Bytes asked for (REQUEST) and not yet sent.
    requested: usize
    // The bytes of a frame that came split across messages.
    carry: [32]u8
    carryLength: usize
    resampler: Resampler
    draining: bool
    started: bool
    underruns: usize
}

pub const Peer = struct {
    descriptor: isize
    connection: dbus.Connection
    // Who it is, as the bus said (org.mlx.IPC.Peer.Connected).
    unique: [64]u8
    uniqueLength: usize
    app: [128]u8
    appLength: usize
    dead: bool
    watchingOutput: bool
    control: u8
    controlSerial: u32
}

// An app's last answer from the bus for a permission (the Sound settings
// list them).
pub const Asked = struct {
    app: [128]u8
    appLength: usize
    record: bool
    allowed: bool
}

// Device kinds.
pub const NONE: u8 = 0
pub const NULL: u8 = 1
pub const FILE: u8 = 2
pub const ALSA: u8 = 3
pub const SINE: u8 = 4

// Sample encodings of devices and files (the protocol's S16, S32 and F32
// are 0, 1 and 2).
pub const U8: u32 = 10
pub const S24: u32 = 11

pub const Device = struct {
    kind: u8
    descriptor: isize
    // A sound card emulated by a test harness (alsa.mlx).
    emulated: bool
    // Its encoding (S16 or S32 for ALSA, S16 for files) and channels.
    encoding: u32
    channels: u32
    rate: u32
    // Frames per period, and in the device's buffer (ALSA).
    period: usize
    buffer: usize
    path: [256]u8
    pathLength: usize
    // A file being written: the bytes of samples so far.
    written: usize
    // A file being read (looped): its samples and how they are encoded.
    data: [*]u8
    dataLength: usize
    position: usize
    fileEncoding: u32
    fileChannels: u32
    fileRate: u32
    fileFrame: usize
    resampler: Resampler
    // Frames the resampler made and the period had no room for.
    pending: [64]i32
    pendingCount: usize
    pendingAt: usize
    // A tone: its pitch, phase and how far it moves per frame (of 2^32).
    hertz: u32
    phase: u32
    phaseStep: u32
    // Underruns and overruns (ALSA).
    xruns: usize
}

pub const Server = struct {
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    bus: dbus.Client
    eventLoop: isize
    running: bool
    verbose: bool
    peers: [64]usize
    peerCount: usize
    streams: [64]Stream
    // The device's rate and period (frames); the mix is stereo.
    rate: u32
    period: usize
    output: Device
    input: Device
    // The output's volume (65536 is 100%) and the input's.
    master: u32
    mute: bool
    inputVolume: u32
    inputMute: bool
    // What was asked for (--output, --input, audio.conf, mlx-settings):
    // auto, alsa[:NAME], file:PATH, null, sine:HZ, none.
    outputSpec: [160]u8
    outputSpecLength: usize
    inputSpec: [160]u8
    inputSpecLength: usize
    // Why the output plays to nobody (the input records silence) though a
    // card was asked for: 0, or a negative errno (EBUSY, ENOENT); and who
    // has the card when it is busy.
    outputProblem: isize
    inputProblem: isize
    holder: [64]u8
    holderLength: usize
    // Tries the cards again while there is a problem.
    retryTimer: isize
    // ~/.config/mlx/audio.conf (NUL-terminated).
    configPath: [256]u8
    configPathLength: usize
    asked: [32]Asked
    askedCount: usize
    // A period of the mix and of the input, interleaved stereo.
    mix: [*]i32
    captured: [*]i32
    // The device's bytes of a period, and what of it the sound card has
    // not taken yet.
    encoded: [*]u8
    encodedStart: usize
    encodedFrames: usize
    // A period the sound card recorded, in its own format.
    recorded: [*]u8
    // Where messages to peers are built.
    message: [*]u8
    // The timer that paces the output when it is not a sound card.
    timer: isize
    periods: usize
}
