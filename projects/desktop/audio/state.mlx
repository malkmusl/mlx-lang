// The records of mlx-audiod (MLX Audio): the server, its peers (the apps'
// MLXIPC channels and PulseAudio connections), their streams, the sinks they play to, what is kept
// for each app, the devices it plays to and records from. They live here, apart from the modules that use them, because
// those modules import one another.
const std = @import("std")
const dbus = @import("std.dbus")

pub const MAX_PEERS: usize = 64
pub const MAX_STREAMS: usize = 64
pub const MAX_ASKED: usize = 32
// Virtual sinks, and apps with settings of their own.
pub const MAX_SINKS: usize = 8
pub const MAX_APPS: usize = 32
// A stream's sink: the default one (the output's mix), or a virtual
// sink's slot + 1.
pub const DEFAULT_SINK: usize = 0
// The most frames a period has (a sound card may choose large ones).
pub const MAX_PERIOD: usize = 8192

// Event tokens below any peer's address.
pub const BUS: usize = 1
pub const TIMER: usize = 2
pub const SIGNALS: usize = 3
pub const CARD_OUT: usize = 4
pub const CARD_IN: usize = 5
pub const RETRY: usize = 6
// The PulseAudio socket (pulse.mlx).
pub const PULSE: usize = 7

// Whether a peer may control the server (audio.control: volumes, devices,
// other apps' streams), as the bus said.
pub const CONTROL_UNKNOWN: u8 = 0
pub const CONTROL_CHECKING: u8 = 1
pub const CONTROL_ALLOWED: u8 = 2
pub const CONTROL_DENIED: u8 = 3

// Linear resampling of interleaved stereo frames (16-bit range, in i32):
// `step` is how far the input moves per output frame (16.16), `position`
// where the next output frame lies after `previous` (16.16, below 1).
pub const Resampler = struct {
    step: u32
    position: u32
    previousLeft: i32
    previousRight: i32
    primed: bool
}

// What a stream is waiting for.
pub const CHECKING: u8 = 0
pub const OPEN: u8 = 1

pub const Stream = struct {
    used: bool
    peer: usize
    id: u32
    direction: u32
    format: u32
    channels: u32
    rate: u32
    latency: u32
    frameBytes: usize
    name: [64]u8
    nameLength: usize
    // 65536 is 100%.
    volume: u32
    state: u8
    // The serial of the org.mlx.IPC.Check the stream waits for.
    checkSerial: u32
    // Playing: the device's frames to play, interleaved stereo.
    ring: [*]i32
    capacity: usize
    start: usize
    filled: usize
    // The frames the stream keeps buffered (its latency).
    target: usize
    // Bytes asked for (REQUEST) and not yet sent.
    requested: usize
    // The bytes of a frame that came split across messages.
    carry: [32]u8
    carryLength: usize
    resampler: Resampler
    draining: bool
    started: bool
    underruns: usize
    // Playing: the sink it plays to (DEFAULT_SINK or a virtual sink's
    // slot + 1), named by the app when it opened (else its app's route
    // decides, and moves it). Recording: from the input, or from a sink's
    // monitor (what plays to it: desktop audio from the default sink's).
    sink: usize
    sinkNamed: bool
    monitor: bool
    // Its app's settings (routing.appAt; MAX_APPS: none).
    appSlot: usize
    // Muted on its own (a PulseAudio app's sink input).
    muted: bool
    // A PulseAudio stream (pulse.mlx): its sample format and channel map
    // as the app gave them, its buffer's sizes (bytes), whether it is
    // corked, the bytes the app wrote (its write index), how many of them
    // played since it started, the reply its creation and its DRAIN wait
    // for (NO_TAG: none), and whether an underflow was told.
    pulse: bool
    pulseFormat: u8
    map: [32]u8
    mapLength: usize
    maxLength: u32
    tlength: u32
    prebuf: u32
    minreq: u32
    fragsize: u32
    corked: bool
    written: u64
    playingFor: u64
    createTag: u32
    drainTag: u32
    underflowed: bool
}

// No reply waits (Stream.createTag, drainTag).
pub const NO_TAG: u32 = 4294967295

// Sink targets: the mix of a virtual sink goes into the default sink's
// (the output), or nowhere (it is only heard through its monitor).
pub const TO_OUTPUT: u8 = 0
pub const TO_NOTHING: u8 = 1

// A virtual sink (mlx-audio sink add): streams routed to it mix into it;
// recording streams can take its monitor.
pub const Sink = struct {
    used: bool
    name: [32]u8
    nameLength: usize
    target: u8
    volume: u32
    mute: bool
    // A period of its mix, interleaved stereo (MAX_PERIOD frames).
    mix: [*]i32
}

// What MLX Audio keeps for an app (by its MLXIPC name): a volume and mute
// over all its streams, and the sink its streams play to.
pub const App = struct {
    used: bool
    name: [128]u8
    nameLength: usize
    volume: u32
    mute: bool
    // The sink's name (empty: the default one).
    sink: [32]u8
    sinkLength: usize
}

// What pulse.mlx keeps for a PulseAudio connection.
pub const PulseClient = struct {
    // The protocol version agreed on, and the AUTH reply waiting for the
    // bus's answer about audio.control.
    version: u32
    authorized: bool
    authTag: u32
    // The events it subscribed to.
    subscriptions: u32
    // Its application.name.
    name: [96]u8
    nameLength: usize
    // A data frame coming in pieces: its stream's channel and the bytes
    // still to come.
    dataChannel: u32
    dataLeft: usize
}

pub const Peer = struct {
    descriptor: isize
    connection: dbus.Connection
    // Its index among the server's clients (PulseAudio's client index).
    index: u32
    // A PulseAudio connection (pulse.mlx) rather than an MLXIPC channel:
    // the process at its other end (SO_PEERCRED), and its protocol state.
    pulse: bool
    pid: u32
    sandboxed: bool
    client: PulseClient
    // Who it is, as the bus said (org.mlx.IPC.Peer.Connected).
    unique: [64]u8
    uniqueLength: usize
    app: [128]u8
    appLength: usize
    dead: bool
    watchingOutput: bool
    control: u8
    controlSerial: u32
}

// An app's last answer from the bus for a permission (the Sound settings
// list them).
pub const Asked = struct {
    app: [128]u8
    appLength: usize
    // ASK_PLAY, ASK_RECORD or ASK_MONITOR.
    kind: u8
    allowed: bool
}

// The permissions a stream needs: audio.play, audio.record (the input),
// audio.monitor (what plays to a sink).
pub const ASK_PLAY: u8 = 0
pub const ASK_RECORD: u8 = 1
pub const ASK_MONITOR: u8 = 2

// Device kinds.
pub const NONE: u8 = 0
pub const NULL: u8 = 1
pub const FILE: u8 = 2
pub const ALSA: u8 = 3
pub const SINE: u8 = 4

// Sample encodings of devices and files (the protocol's S16, S32 and F32
// are 0, 1 and 2).
pub const U8: u32 = 10
pub const S24: u32 = 11
// 24 bits in the low three bytes of four (PulseAudio's S24_32LE).
pub const S24_32: u32 = 12

pub const Device = struct {
    kind: u8
    descriptor: isize
    // A sound card emulated by a test harness (alsa.mlx).
    emulated: bool
    // Its encoding (S16 or S32 for ALSA, S16 for files) and channels.
    encoding: u32
    channels: u32
    rate: u32
    // Frames per period, and in the device's buffer (ALSA).
    period: usize
    buffer: usize
    path: [256]u8
    pathLength: usize
    // A file being written: the bytes of samples so far.
    written: usize
    // A file being read (looped): its samples and how they are encoded.
    data: [*]u8
    dataLength: usize
    position: usize
    fileEncoding: u32
    fileChannels: u32
    fileRate: u32
    fileFrame: usize
    resampler: Resampler
    // Frames the resampler made and the period had no room for.
    pending: [64]i32
    pendingCount: usize
    pendingAt: usize
    // A tone: its pitch, phase and how far it moves per frame (of 2^32).
    hertz: u32
    phase: u32
    phaseStep: u32
    // Underruns and overruns (ALSA).
    xruns: usize
}

pub const Server = struct {
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    bus: dbus.Client
    eventLoop: isize
    running: bool
    verbose: bool
    peers: [64]usize
    peerCount: usize
    streams: [64]Stream
    // The device's rate and period (frames); the mix is stereo.
    rate: u32
    period: usize
    output: Device
    input: Device
    // The output's volume (65536 is 100%) and the input's.
    master: u32
    mute: bool
    inputVolume: u32
    inputMute: bool
    // What was asked for (--output, --input, audio.conf, mlx-settings):
    // auto, alsa[:NAME], file:PATH, null, sine:HZ, none.
    outputSpec: [160]u8
    outputSpecLength: usize
    inputSpec: [160]u8
    inputSpecLength: usize
    // Why the output plays to nobody (the input records silence) though a
    // card was asked for: 0, or a negative errno (EBUSY, ENOENT); and who
    // has the card when it is busy.
    outputProblem: isize
    inputProblem: isize
    holder: [64]u8
    holderLength: usize
    // Tries the cards again while there is a problem.
    retryTimer: isize
    // ~/.config/mlx/audio.conf (NUL-terminated).
    configPath: [256]u8
    configPathLength: usize
    asked: [32]Asked
    askedCount: usize
    sinks: [8]Sink
    apps: [32]App
    // "monitor:" and a sink's name, as STATE says where a stream records.
    monitorLabel: [48]u8
    // A period of the mix and of the input, interleaved stereo.
    mix: [*]i32
    captured: [*]i32
    // The device's bytes of a period, and what of it the sound card has
    // not taken yet.
    encoded: [*]u8
    encodedStart: usize
    encodedFrames: usize
    // A period the sound card recorded, in its own format.
    recorded: [*]u8
    // Where messages to peers are built.
    message: [*]u8
    // The timer that paces the output when it is not a sound card.
    timer: isize
    periods: usize
    // The PulseAudio socket ($XDG_RUNTIME_DIR/pulse/native; -1: none),
    // its path (NUL-terminated), where its packets are built, and the
    // next client index.
    pulseListener: isize
    pulsePath: [256]u8
    pulsePathLength: usize
    pulseMessage: [*]u8
    nextClient: u32
}
