// Where sound goes: sinks and what is kept for each app.
//
// Every playing stream plays to a sink. The default sink is the output's
// mix; virtual sinks (mlx-audio sink add NAME) mix their streams apart and
// pass the mix on to the default sink (TO_OUTPUT) or to nothing
// (TO_NOTHING: only heard through the monitor). Each sink has a monitor: a
// recording stream can take what plays to it instead of the input (the
// default sink's monitor is the desktop's sound, for screen recordings;
// MLXIPC's permission audio.monitor). The monitor is the mix before the
// sink's volume, so turning the speakers down or muting them does not
// change a recording.
//
// An app (by its MLXIPC name) has a volume and mute over all its streams
// and a route: the sink its streams play to unless a stream named one when
// it opened. Changing the route moves its streams at once.
const std = @import("std")
const audio = @import("std.audio")
const state = @import("./state.mlx")

// findSink's answer for a name there is no sink of.
pub const NO_SINK: usize = 1 << 20

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn copy(target: [*]u8, capacity: usize, text: []const u8) -> usize {
    var length: usize = 0
    while length < text.length && length < capacity {
        target[length] = text[length]
        length += 1
    }
    return length
}

pub fn sinkAt(server: *state.Server, slot: usize) -> *state.Sink {
    unsafe { return @ptrCast(*state.Sink, &server.*.sinks[slot]) }
}

pub fn appAt(server: *state.Server, slot: usize) -> *state.App {
    unsafe { return @ptrCast(*state.App, &server.*.apps[slot]) }
}

fn streamAt(server: *state.Server, slot: usize) -> *state.Stream {
    unsafe { return @ptrCast(*state.Stream, &server.*.streams[slot]) }
}

pub fn sinkName(sink: *state.Sink) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &sink.*.name) }
    return bytes[0..sink.*.nameLength]
}

pub fn appName(app: *state.App) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &app.*.name) }
    return bytes[0..app.*.nameLength]
}

pub fn appSinkName(app: *state.App) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &app.*.sink) }
    return bytes[0..app.*.sinkLength]
}

pub fn init(server: *state.Server) -> void {
    var slot: usize = 0
    while slot < state.MAX_SINKS {
        sinkAt(server, slot).*.used = false
        slot += 1
    }
    slot = 0
    while slot < state.MAX_APPS {
        appAt(server, slot).*.used = false
        slot += 1
    }
}

// A name a sink may have: 1 to 31 letters, digits, '-', '_' or '.', not
// "default".
pub fn validName(name: []const u8) -> bool {
    if name.length == 0 || name.length > 31 || same(name, "default") { return false }
    for byte in name {
        const letter = (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
        const digit = byte >= 48 && byte <= 57
        if !letter && !digit && byte != 45 && byte != 95 && byte != 46 { return false }
    }
    return true
}

// The sink of that name: DEFAULT_SINK for "" and "default", a virtual
// sink's slot + 1, or NO_SINK.
pub fn findSink(server: *state.Server, name: []const u8) -> usize {
    if name.length == 0 || same(name, "default") { return state.DEFAULT_SINK }
    var slot: usize = 0
    while slot < state.MAX_SINKS {
        const sink = sinkAt(server, slot)
        if sink.*.used && same(sinkName(sink), name) { return slot + 1 }
        slot += 1
    }
    return NO_SINK
}

// A sink's name as STATE and the logs show it.
pub fn labelOf(server: *state.Server, sink: usize) -> []const u8 {
    if sink == state.DEFAULT_SINK || sink > state.MAX_SINKS { return "default" }
    return sinkName(sinkAt(server, sink - 1))
}

// The mix a stream on `sink` adds to (the default sink's when that sink
// went).
pub fn mixOf(server: *state.Server, sink: usize) -> [*]i32 {
    if sink == state.DEFAULT_SINK || sink > state.MAX_SINKS || !sinkAt(server, sink - 1).*.used { return server.*.mix }
    return sinkAt(server, sink - 1).*.mix
}

// Adds a virtual sink (or changes where an existing one goes); false when
// the name is not one a sink may have or there is no room.
pub fn addSink(server: *state.Server, name: []const u8, target: u8) -> bool {
    if !validName(name) { return false }
    const found = findSink(server, name)
    if found != NO_SINK {
        sinkAt(server, found - 1).*.target = target
        return true
    }
    var slot: usize = 0
    while slot < state.MAX_SINKS {
        const sink = sinkAt(server, slot)
        if !sink.*.used {
            const memory = server.*.allocator.alloc(state.MAX_PERIOD * 8, 16)
            if memory == null { return false }
            unsafe { sink.*.mix = @ptrCast([*]i32, memory.?) }
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &sink.*.name) }
            sink.*.nameLength = copy(bytes, 31, name)
            sink.*.target = target
            sink.*.volume = 65536
            sink.*.mute = false
            sink.*.used = true
            // Apps routed to it (from audio.conf, or before it went) come
            // back to it.
            rerouteAll(server)
            return true
        }
        slot += 1
    }
    return false
}

// Removes a virtual sink: its streams play to the default sink, and so do
// new streams of the apps routed to it.
pub fn removeSink(server: *state.Server, name: []const u8) -> bool {
    const found = findSink(server, name)
    if found == NO_SINK || found == state.DEFAULT_SINK { return false }
    const sink = sinkAt(server, found - 1)
    sink.*.used = false
    var memory: [*]u8 = undefined
    unsafe { memory = @ptrCast([*]u8, sink.*.mix) }
    server.*.allocator.free(memory, state.MAX_PERIOD * 8, 16)
    var slot: usize = 0
    while slot < state.MAX_STREAMS {
        const stream = streamAt(server, slot)
        if stream.*.used && stream.*.sink == found { stream.*.sink = state.DEFAULT_SINK }
        slot += 1
    }
    return true
}

// The app's settings' slot, MAX_APPS when it has none.
pub fn findApp(server: *state.Server, name: []const u8) -> usize {
    var slot: usize = 0
    while slot < state.MAX_APPS {
        const app = appAt(server, slot)
        if app.*.used && same(appName(app), name) { return slot }
        slot += 1
    }
    return state.MAX_APPS
}

// The app's settings' slot, made (at 100%, on the default sink) when it
// had none; MAX_APPS when there is no room.
pub fn appFor(server: *state.Server, name: []const u8) -> usize {
    const found = findApp(server, name)
    if found != state.MAX_APPS || name.length == 0 { return found }
    var slot: usize = 0
    while slot < state.MAX_APPS {
        const app = appAt(server, slot)
        if !app.*.used {
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &app.*.name) }
            app.*.nameLength = copy(bytes, 128, name)
            app.*.volume = 65536
            app.*.mute = false
            app.*.sinkLength = 0
            app.*.used = true
            return slot
        }
        slot += 1
    }
    return state.MAX_APPS
}

// A playing stream's sink by its app's route (when it named none).
pub fn route(server: *state.Server, stream: *state.Stream) -> void {
    if stream.*.sinkNamed || stream.*.direction != audio.PLAY { return }
    stream.*.sink = state.DEFAULT_SINK
    if stream.*.appSlot >= state.MAX_APPS { return }
    const found = findSink(server, appSinkName(appAt(server, stream.*.appSlot)))
    if found != NO_SINK { stream.*.sink = found }
}

fn rerouteAll(server: *state.Server) -> void {
    var slot: usize = 0
    while slot < state.MAX_STREAMS {
        const stream = streamAt(server, slot)
        if stream.*.used { route(server, stream) }
        slot += 1
    }
}

// Routes the app's streams to `sink` (its name; "" or "default": the
// default sink) from now on; false when there is no such sink.
pub fn setAppSink(server: *state.Server, name: []const u8, sink: []const u8) -> bool {
    if findSink(server, sink) == NO_SINK { return false }
    const slot = appFor(server, name)
    if slot == state.MAX_APPS { return false }
    const app = appAt(server, slot)
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &app.*.sink) }
    app.*.sinkLength = if same(sink, "default") { 0 } else { copy(bytes, 31, sink) }
    rerouteAll(server)
    return true
}

// What a playing stream's samples are multiplied by (65536 is 100%): its
// own volume and its app's.
pub fn gainOf(server: *state.Server, stream: *state.Stream) -> i64 {
    var gain = @intCast(i64, stream.*.volume)
    if stream.*.appSlot < state.MAX_APPS {
        const app = appAt(server, stream.*.appSlot)
        if app.*.mute { return 0 }
        gain = gain * @intCast(i64, app.*.volume) / 65536
    }
    return gain
}

// A new stream's app settings and sink. `target`: the sink it named
// (playing) or where it records from ("", "input", "monitor",
// "monitor:NAME"). False when there is no such sink.
pub fn place(server: *state.Server, stream: *state.Stream, app: []const u8, target: []const u8) -> bool {
    stream.*.appSlot = appFor(server, app)
    stream.*.sink = state.DEFAULT_SINK
    stream.*.sinkNamed = false
    stream.*.monitor = false
    if stream.*.direction == audio.PLAY {
        if target.length > 0 {
            const found = findSink(server, target)
            if found == NO_SINK { return false }
            stream.*.sink = found
            stream.*.sinkNamed = true
            return true
        }
        route(server, stream)
        return true
    }
    if target.length == 0 || same(target, "input") { return true }
    if same(target, "monitor") {
        stream.*.monitor = true
        return true
    }
    if target.length > 8 && same(target[0..8], "monitor:") {
        const found = findSink(server, target[8..target.length])
        if found == NO_SINK { return false }
        stream.*.monitor = true
        stream.*.sink = found
        return true
    }
    return false
}

// Moves a playing stream to `sink` (it stays there whatever its app's
// route); false when there is no such sink.
pub fn moveStream(server: *state.Server, stream: *state.Stream, sink: []const u8) -> bool {
    const found = findSink(server, sink)
    if found == NO_SINK || stream.*.direction != audio.PLAY { return false }
    stream.*.sink = found
    stream.*.sinkNamed = found != state.DEFAULT_SINK
    if !stream.*.sinkNamed { route(server, stream) }
    return true
}

// Whether the app's settings are other than the defaults (kept in
// audio.conf).
pub fn customized(app: *state.App) -> bool { return app.*.volume != 65536 || app.*.mute || app.*.sinkLength > 0 }
