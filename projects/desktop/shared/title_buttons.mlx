// The buttons of the compositor's title bars: close, minimize and maximize,
// each shown or not, on the left or the right, in the order the user puts
// them (control, Windows). One line of ~/.config/mlx/compositor.conf:
//
//     title-buttons = minimize,maximize,close        (all on the right)
//     title-buttons = close,minimize,maximize:       (all on the left)
//     title-buttons = close:maximize                 (one on each side)
//     title-buttons = none                           (no buttons)
//
// Names before a `:` go on the left (from the edge inwards), names after
// it, or all of them without one, on the right (from the left outwards).
// A name given twice counts once. The compositor (settings.mlx) and the
// settings app read it alike.
const std = @import("std")

pub const NONE: u8 = 0
pub const CLOSE: u8 = 1
pub const MINIMIZE: u8 = 2
pub const MAXIMIZE: u8 = 3
pub const BUTTONS: usize = 3

pub const Layout = struct {
    left: [3]u8
    right: [3]u8
    leftCount: usize
    rightCount: usize
}

// Minimize, maximize and close on the right.
pub fn defaults(layout: *Layout) -> void {
    layout.*.leftCount = 0
    layout.*.right[0] = MINIMIZE
    layout.*.right[1] = MAXIMIZE
    layout.*.right[2] = CLOSE
    layout.*.rightCount = 3
}

pub fn name(kind: u8) -> []const u8 {
    return match kind { 1 => "close", 2 => "minimize", else => "maximize" }
}

pub fn label(kind: u8, german: bool) -> []const u8 {
    if german { return match kind { 1 => "Schließen", 2 => "Minimieren", else => "Maximieren" } }
    return match kind { 1 => "Close", 2 => "Minimize", else => "Maximize" }
}

fn kindOf(word: []const u8) -> u8 {
    if std.text.same(word, "close") { return CLOSE }
    if std.text.same(word, "minimize") { return MINIMIZE }
    if std.text.same(word, "maximize") { return MAXIMIZE }
    return NONE
}

// Whether `kind` is in the layout already.
pub fn has(layout: *const Layout, kind: u8) -> bool {
    var index: usize = 0
    while index < layout.*.leftCount {
        if layout.*.left[index] == kind { return true }
        index += 1
    }
    index = 0
    while index < layout.*.rightCount {
        if layout.*.right[index] == kind { return true }
        index += 1
    }
    return false
}

fn add(layout: *Layout, kind: u8, left: bool) -> void {
    if kind == NONE || has(layout, kind) { return }
    if left {
        layout.*.left[layout.*.leftCount] = kind
        layout.*.leftCount += 1
    } else {
        layout.*.right[layout.*.rightCount] = kind
        layout.*.rightCount += 1
    }
}

// `text` into `layout`; false (the layout as it was) when a name is not a
// button's.
pub fn parse(text: []const u8, layout: *Layout) -> bool {
    var parsed: Layout = undefined
    parsed.leftCount = 0
    parsed.rightCount = 0
    if std.text.same(text, "none") || std.text.same(text, "off") {
        layout.* = parsed
        return true
    }
    var colon = false
    var index: usize = 0
    while index < text.length {
        if text[index] == 58 { colon = true }
        index += 1
    }
    // Without a `:` everything goes on the right.
    var left = colon
    var start: usize = 0
    index = 0
    while index <= text.length {
        if index == text.length || text[index] == 44 || text[index] == 58 {
            const word = std.text.trimmed(text[start..index])
            if word.length > 0 {
                const kind = kindOf(word)
                if kind == NONE { return false }
                add(&parsed, kind, left)
            }
            if index < text.length && text[index] == 58 { left = false }
            start = index + 1
        }
        index += 1
    }
    layout.* = parsed
    return true
}

fn append(into: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        into[index] = byte
        index += 1
    }
    return index
}

// The layout as the file has it (at most 34 bytes), from `at`; the end.
pub fn write(layout: *const Layout, into: [*]u8, at: usize) -> usize {
    if layout.*.leftCount == 0 && layout.*.rightCount == 0 { return append(into, at, "none") }
    var length = at
    var index: usize = 0
    while index < layout.*.leftCount {
        if index > 0 { length = append(into, length, ",") }
        length = append(into, length, name(layout.*.left[index]))
        index += 1
    }
    if layout.*.leftCount > 0 { length = append(into, length, ":") }
    index = 0
    while index < layout.*.rightCount {
        if index > 0 { length = append(into, length, ",") }
        length = append(into, length, name(layout.*.right[index]))
        index += 1
    }
    return length
}

// ---------------------------------------------------------------------------
// Arranging: the settings app shows the buttons as one row of places, the
// left side's then the right side's, and moves them a place at a time.

// Where `kind` is: its side and place, false when it is not shown.
pub fn find(layout: *const Layout, kind: u8, left: *bool, place: *usize) -> bool {
    var index: usize = 0
    while index < layout.*.leftCount {
        if layout.*.left[index] == kind {
            left.* = true
            place.* = index
            return true
        }
        index += 1
    }
    index = 0
    while index < layout.*.rightCount {
        if layout.*.right[index] == kind {
            left.* = false
            place.* = index
            return true
        }
        index += 1
    }
    return false
}

fn removeAt(items: *[3]u8, count: *usize, place: usize) -> void {
    var index = place
    while index + 1 < count.* {
        items.*[index] = items.*[index + 1]
        index += 1
    }
    count.* -= 1
}

fn insertAt(items: *[3]u8, count: *usize, place: usize, kind: u8) -> void {
    var index = count.*
    while index > place {
        items.*[index] = items.*[index - 1]
        index -= 1
    }
    items.*[place] = kind
    count.* += 1
}

// Shows `kind` (on the right, at its end) or hides it.
pub fn toggle(layout: *Layout, kind: u8) -> void {
    var left = false
    var place: usize = 0
    if find(layout, kind, &left, &place) {
        if left { removeAt(&layout.*.left, &layout.*.leftCount, place) } else { removeAt(&layout.*.right, &layout.*.rightCount, place) }
        return
    }
    add(layout, kind, false)
}

// Moves `kind` a place to the left (`towardsLeft`) or to the right; past
// the end of its side it goes over to the other side.
pub fn move(layout: *Layout, kind: u8, towards_left: bool) -> void {
    var left = false
    var place: usize = 0
    if !find(layout, kind, &left, &place) { return }
    if left {
        if towards_left {
            if place == 0 { return }
            layout.*.left[place] = layout.*.left[place - 1]
            layout.*.left[place - 1] = kind
        } else if place + 1 < layout.*.leftCount {
            layout.*.left[place] = layout.*.left[place + 1]
            layout.*.left[place + 1] = kind
        } else {
            removeAt(&layout.*.left, &layout.*.leftCount, place)
            insertAt(&layout.*.right, &layout.*.rightCount, 0, kind)
        }
        return
    }
    if towards_left {
        if place > 0 {
            layout.*.right[place] = layout.*.right[place - 1]
            layout.*.right[place - 1] = kind
        } else {
            removeAt(&layout.*.right, &layout.*.rightCount, place)
            insertAt(&layout.*.left, &layout.*.leftCount, layout.*.leftCount, kind)
        }
    } else if place + 1 < layout.*.rightCount {
        layout.*.right[place] = layout.*.right[place + 1]
        layout.*.right[place + 1] = kind
    }
}
