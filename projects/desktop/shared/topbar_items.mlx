// The top bar's items on the right, in the order the user put them
// (mlx-settings, Top bar): $XDG_CONFIG_HOME/mlx/topbar.conf
// (~/.config/mlx/topbar.conf), a line an item from left to right,
// "name = on" or "name = off" (hidden). An item the file does not name
// stands where it does by default, shown. The top bar reads the file
// again within a second of a change.
const std = @import("std")
const conf = @import("std.conf")
const apps_module = @import("./apps.mlx")
const pins = @import("./pins.mlx")

const Path = apps_module.Path

pub const FILE: []const u8 = "topbar.conf"

// The items (the top bar's WIDGET_* numbers).
pub const CLOCK: usize = 0
pub const BATTERY: usize = 1
pub const SOUND: usize = 2
pub const TRAY: usize = 3
pub const MEDIA: usize = 4
pub const CONTROL: usize = 5
pub const ITEMS: usize = 6

const MISSING: usize = 255

pub const Items = struct {
    // The items from left to right, and whether each one (by its number)
    // is shown.
    order: [8]u8
    shown: [8]bool
}

// The item at `position` (from the left).
pub fn at(items: *const Items, position: usize) -> usize { return @intCast(usize, items.*.order[position]) }

pub fn isShown(items: *const Items, item: usize) -> bool { return items.*.shown[item] }

// The name in the file.
pub fn name(item: usize) -> []const u8 {
    return match item { 0 => "clock", 1 => "battery", 2 => "sound", 3 => "tray", 4 => "media", else => "control" }
}

pub fn label(item: usize, german: bool) -> []const u8 {
    if german {
        return match item { 0 => "Uhr und Kalender", 1 => "Akku", 2 => "Lautstärke", 3 => "Statussymbole", 4 => "Medien", else => "Kontrollzentrum" }
    }
    return match item { 0 => "Clock and calendar", 1 => "Battery", 2 => "Sound", 3 => "Status icons", 4 => "Media", else => "Control centre" }
}

pub fn note(item: usize, german: bool) -> []const u8 {
    if german {
        return match item {
            0 => "Datum und Uhrzeit, ein Klick zeigt den Kalender",
            1 => "Ladestand, nur mit Akku sichtbar",
            2 => "Lautstärke, Ausgabe und Apps",
            3 => "Symbole der Apps im Hintergrund",
            4 => "Was gerade spielt, mit Steuerung",
            else => "Schalter, Lautstärke und Mitteilungen"
        }
    }
    return match item {
        0 => "Date and time, a click shows the calendar",
        1 => "Charge, shown only with a battery",
        2 => "Volume, output and apps",
        3 => "Icons of apps in the background",
        4 => "What is playing, with controls",
        else => "Switches, volume and notifications"
    }
}

// The item at `position` by default: the media, the tray, the sound, the
// battery, the control centre, the clock.
fn defaultAt(position: usize) -> usize {
    return match position { 0 => MEDIA, 1 => TRAY, 2 => SOUND, 3 => BATTERY, 4 => CONTROL, else => CLOCK }
}

// The default order, all shown.
pub fn defaults(items: *Items) -> void {
    var position: usize = 0
    while position < ITEMS {
        items.*.order[position] = @intCast(u8, defaultAt(position))
        items.*.shown[position] = true
        position += 1
    }
}

// Where `item` stands (from the left).
pub fn positionOf(items: *const Items, item: usize) -> usize {
    var position: usize = 0
    while position < ITEMS {
        if at(items, position) == item { return position }
        position += 1
    }
    return 0
}

// Moves the item at `position` one place left (`left`) or right; false at
// the end.
pub fn move(items: *Items, position: usize, left: bool) -> bool {
    if left && position == 0 { return false }
    if !left && position + 1 >= ITEMS { return false }
    const other = if left { position - 1 } else { position + 1 }
    const item = items.*.order[position]
    items.*.order[position] = items.*.order[other]
    items.*.order[other] = item
    return true
}

fn itemNamed(text: []const u8) -> usize {
    var item: usize = 0
    while item < ITEMS {
        if apps_module.sameText(text, name(item)) { return item }
        item += 1
    }
    return MISSING
}

// The items as `text` (the file) says.
pub fn parse(items: *Items, text: []const u8) -> void {
    var placed: [8]bool = undefined
    var item: usize = 0
    while item < ITEMS {
        placed[item] = false
        items.*.shown[item] = true
        item += 1
    }
    var count: usize = 0
    var lines = conf.lines(text)
    var entry: conf.Entry = undefined
    while conf.next(&lines, &entry) {
        const named = itemNamed(entry.key)
        if named != MISSING && !placed[named] {
            placed[named] = true
            items.*.order[count] = @intCast(u8, named)
            items.*.shown[named] = !apps_module.sameText(entry.value, "off")
            count += 1
        }
    }
    // The ones not named, before the first default follower that is.
    var position: usize = 0
    while position < ITEMS {
        const missing = defaultAt(position)
        if !placed[missing] {
            var at_position = count
            var later = position + 1
            while later < ITEMS && at_position == count {
                const follower = defaultAt(later)
                if placed[follower] { at_position = positionOf(items, follower) }
                later += 1
            }
            var moving = count
            while moving > at_position {
                items.*.order[moving] = items.*.order[moving - 1]
                moving -= 1
            }
            items.*.order[at_position] = @intCast(u8, missing)
            placed[missing] = true
            count += 1
        }
        position += 1
    }
}

// Reads the file (the defaults without one).
pub fn read(environment: [*][*]const u8, allocator: std.allocator.Allocator, items: *Items) -> void {
    defaults(items)
    var file_path: Path = undefined
    if !pins.path(environment, FILE, &file_path) { return }
    const loaded = std.fs.readFileAlloc(apps_module.pathEnd(&file_path), allocator)
    if loaded == null { return }
    const contents = loaded.?
    parse(items, contents.items[0..contents.length])
    std.fs.ArrayList.deinit(contents)
}

// When the file last changed (1: there is none).
pub fn signature(environment: [*][*]const u8) -> usize {
    var file_path: Path = undefined
    if !pins.path(environment, FILE, &file_path) { return 1 }
    var status: std.fs.Stat = undefined
    if std.fs.status(apps_module.pathEnd(&file_path), &status) != 0 { return 1 }
    return @bitCast(usize, status.modifiedSeconds) *% 1000000007 +% @bitCast(usize, status.modifiedNanoseconds) +% @bitCast(usize, status.size)
}

fn add(text: [*]u8, at_byte: usize, part: []const u8) -> usize {
    var length = at_byte
    for byte in part {
        text[length] = byte
        length += 1
    }
    return length
}

// Writes the file whole (topbar.conf.new renamed over it); false when it
// could not be written.
pub fn write(environment: [*][*]const u8, items: *const Items) -> bool {
    var file_path: Path = undefined
    if !pins.path(environment, FILE, &file_path) { return false }
    // ~/.config/mlx (and ~/.config) may not be there yet.
    _ = std.fs.makeParents(file_path.bytes[0..file_path.length], 493)
    var bytes: [512]u8 = undefined
    const text: [*]u8 = &bytes
    var length = add(text, 0, "# The top bar's items from left to right (mlx-settings writes this file).\n")
    var position: usize = 0
    while position < ITEMS {
        const item = at(items, position)
        length = add(text, length, name(item))
        length = add(text, length, if items.*.shown[item] { " = on\n" } else { " = off\n" })
        position += 1
    }
    return std.fs.replaceFile(apps_module.pathEnd(&file_path), text, length, 420)
}
