// The channel between a desktop helper (launcher, dock, top bar) and the
// compositor: on Linux one end of a socket pair, its descriptor number
// in MLX_LAUNCHER_FD, MLX_DOCK_FD or MLX_TOPBAR_FD; on brixOS one end of
// a channel pair, the helper's handle in its own role (std.os.brix
// Role.OWN, the variable then only says there is one). The reads are
// without waiting (the helper's loop watches the channel), a message's
// bytes on brixOS, a stream's on Linux.
//
//   const channel = channel_module.fromValue(environmentValue(environment, "MLX_DOCK_FD"))   // -1: none
//   const count = channel_module.read(channel, &bytes, capacity)   // 0: the compositor is gone; -11: nothing now
//   channel_module.send(channel, bytes)                             // false: it is gone
//
// A compositor run with --verbose hands that on to its helpers
// (MLX_DESKTOP_VERBOSE=1 in their environment): they then say in a line
// each what they show for an app (its name, its id, its icon's file).
//
//   if channel_module.verbose(environment) { say("orbit: shows ...\n") }
const std = @import("std")
const builtin = @import("builtin")
const brix = std.os.brix

// Whether the compositor asked its helpers to say what they show.
pub fn verbose(environment: [*][*]const u8) -> bool {
    const value = std.process.environmentFrom(environment, "MLX_DESKTOP_VERBOSE")
    return value != null && value.?.length > 0 && value.?.pointer[0] == 49
}

// The channel the variable's value names (null or empty: none).
pub fn fromValue(value: [*]const u8) -> isize {
    if @intFromPtr(value) == 0 || value[0] < 48 || value[0] > 57 { return -1 }
    if comptime builtin.os == builtin.Os.brixos {
        const handle = brix.handleFor(brix.Role.OWN)
        return if handle == 0 { -1 } else { @intCast(isize, handle) }
    }
    var descriptor: isize = 0
    var index: usize = 0
    while value[index] >= 48 && value[index] <= 57 {
        descriptor = descriptor * 10 + @intCast(isize, value[index] - 48)
        index += 1
    }
    return descriptor
}

pub fn read(channel: isize, into: [*]u8, capacity: usize) -> isize {
    if comptime builtin.os == builtin.Os.brixos {
        var handles: [4]u32 = undefined
        var sizes: [2]u32 = [2]u32{ 0, 0 }
        const got = brix.receive(@intCast(u32, channel), into[0..capacity], handles[0..4], &sizes)
        if got == -brix.Status.would_block { return -11 }
        if got < 0 { return 0 }
        var k: usize = 0
        while k < @intCast(usize, sizes[1]) {
            _ = brix.close(handles[k])
            k += 1
        }
        return @intCast(isize, sizes[0])
    }
    const count = std.fs.read(std.fs.File.{ .descriptor = channel }, into, capacity)
    if count < 0 && count != -11 { return 0 }
    return count
}

// Sends `bytes` (one message on brixOS; never a SIGPIPE on Linux); false
// when the compositor is gone (a full queue is busy, not gone).
pub fn send(channel: isize, bytes: []const u8) -> bool {
    if comptime builtin.os == builtin.Os.brixos {
        var handles: [1]u32 = undefined
        const sent = brix.send(@intCast(u32, channel), bytes, handles[0..0])
        return sent == 0 || sent == -brix.Status.would_block
    }
    const sent = std.linux.syscall6(std.linux.SYS_sendto, @bitCast(usize, channel), @intFromPtr(bytes.pointer), bytes.length, std.linux.socket.MSG_DONTWAIT | std.linux.socket.MSG_NOSIGNAL, 0, 0)
    return sent > 0 || sent == -11
}
