// The applications a dock and a launcher offer: app bundles (NAME.app
// under DATA/apps, holding app.ini and its own icon.png: the desktop's own
// form, brixOS has them in /system/share/apps) and desktop entries
// (freedesktop.org .desktop files, what foreign software brings) from
// $XDG_DATA_HOME/applications (~/.local/share/applications) and every
// $XDG_DATA_DIRS/applications (/usr/local/share and /usr/share), their
// icons, and starting them.
//
// An entry counts when it is Type=Application with an Exec line and is not
// NoDisplay or Hidden; the first one with a given file name wins, the
// user's first. The name is Name[LANG] when the language of LANG (or
// LC_ALL, LC_MESSAGES) has one, else Name. Exec field codes (%f, %U, ...)
// are dropped. Icons are PNGs: a bundle's icon.png, an absolute Icon path,
// or NAME.png in the hicolor theme (the size closest above the one wanted
// first) under the same data directories, or in /usr/share/pixmaps.
//
// Which app a window, a pin or a program's name stands for is asked in one
// place, find: the dock, the launcher and the top bar all go through it,
// so they agree on an app's name and icon. An app's id is what its program
// gives its windows (the Wayland app id): Id= in a bundle's app.ini
// ("org.mlx.files"), a desktop entry's file name without ".desktop".
const std = @import("std")
const png = @import("std.png")
const platform = @import("std.platform")
const spawn_module = @import("std.spawn")

const Allocator = std.allocator.Allocator

pub const MAX_APPS: usize = 1024

// The app id of the Mlx terminal (vector's windows have it); a dock pins
// it as "terminal".
pub const TERMINAL_ID: []const u8 = "org.mlx.terminal"

pub const App = struct {
    // The app's id: what its program gives its windows (Id=, else the
    // entry's file name).
    id: [96]u8
    idLength: usize
    // The entry's own name (NAME of NAME.app or NAME.desktop), and
    // whether it is a bundle.
    file: [96]u8
    fileLength: usize
    bundle: bool
    name: [96]u8
    nameLength: usize
    exec: [512]u8
    execLength: usize
    icon: [160]u8
    iconLength: usize
    wmClass: [96]u8
    wmClassLength: usize
    // The types of file it opens (MimeType=: "text/plain;image/*;"), for
    // the default apps (defaults.mlx).
    types: [256]u8
    typesLength: usize
    terminal: bool
    // The icon at the size it was last loaded (iconSize 0: not tried yet;
    // hasImage false: none found).
    image: png.Image
    hasImage: bool
    iconSize: usize
}

pub const Apps = struct {
    list: [*]App
    count: usize
    allocator: Allocator
    // Where to look, from the environment.
    home: [*]const u8
    dataHome: [*]const u8
    dataDirs: [*]const u8
    language: [8]u8
    languageLength: usize
}

pub fn appAt(apps: *Apps, index: usize) -> *App {
    unsafe { return @ptrFromInt(*App, @intFromPtr(apps.*.list) + index * @sizeOf(App)) }
}

pub fn nameOf(app: *const App) -> []const u8 { return sliceOf(@intFromPtr(app) + @offsetOf(App, "name"), app.*.nameLength) }
pub fn idOf(app: *const App) -> []const u8 { return sliceOf(@intFromPtr(app) + @offsetOf(App, "id"), app.*.idLength) }
pub fn fileOf(app: *const App) -> []const u8 { return sliceOf(@intFromPtr(app) + @offsetOf(App, "file"), app.*.fileLength) }
pub fn wmClassOf(app: *const App) -> []const u8 { return sliceOf(@intFromPtr(app) + @offsetOf(App, "wmClass"), app.*.wmClassLength) }
pub fn execOf(app: *const App) -> []const u8 { return sliceOf(@intFromPtr(app) + @offsetOf(App, "exec"), app.*.execLength) }
pub fn typesOf(app: *const App) -> []const u8 { return sliceOf(@intFromPtr(app) + @offsetOf(App, "types"), app.*.typesLength) }

// How well the app takes files of `type` (a MIME type): 2 when its
// MimeType names it, 1 when it names its kind ("text/*" for text/x-csrc),
// 0 when it does not take it.
pub fn takesType(app: *const App, type_: []const u8) -> u8 {
    const types = typesOf(app)
    var slash: usize = 0
    while slash < type_.length && type_[slash] != 47 { slash += 1 }
    var best: u8 = 0
    var start: usize = 0
    var at: usize = 0
    while at <= types.length {
        if at == types.length || types[at] == 59 {
            const one = types[start..at]
            if sameText(one, type_) { return 2 }
            if one.length == slash + 2 && slash < type_.length && one[slash] == 47 && one[slash + 1] == 42 && sameText(one[0..slash], type_[0..slash]) { best = 1 }
            start = at + 1
        }
        at += 1
    }
    return best
}

fn sliceOf(address: usize, length: usize) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address) }
    return bytes[0..length]
}

// The value of `name` in a NUL-terminated environment list (0 when unset).
pub fn environmentValue(environment: [*][*]const u8, name: []const u8) -> [*]const u8 {
    const value = std.process.environmentFrom(environment, name)
    if value != null { return value.?.pointer }
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

// Whether `text` equals `other` ignoring ASCII case.
pub fn sameText(text: []const u8, other: []const u8) -> bool {
    if text.length != other.length { return false }
    var index: usize = 0
    while index < text.length {
        if std.ascii.toLower(text[index]) != std.ascii.toLower(other[index]) { return false }
        index += 1
    }
    return true
}

// Whether `text` contains `part`, ignoring ASCII case.
pub fn containsText(text: []const u8, part: []const u8) -> bool {
    if part.length == 0 { return true }
    if part.length > text.length { return false }
    var start: usize = 0
    while start + part.length <= text.length {
        var index: usize = 0
        while index < part.length && std.ascii.toLower(text[start + index]) == std.ascii.toLower(part[index]) { index += 1 }
        if index == part.length { return true }
        start += 1
    }
    return false
}

// A path builder with room for any path we make.
pub const Path = struct {
    bytes: [1024]u8
    length: usize
}

pub fn pathClear(path: *Path) -> void { path.*.length = 0 }

pub fn pathAdd(path: *Path, text: []const u8) -> void {
    for byte in text {
        if path.*.length < 1022 {
            path.*.bytes[path.*.length] = byte
            path.*.length += 1
        }
    }
}

pub fn pathAddC(path: *Path, text: [*]const u8) -> void {
    var index: usize = 0
    while text[index] != 0 && path.*.length < 1022 {
        path.*.bytes[path.*.length] = text[index]
        path.*.length += 1
        index += 1
    }
}

pub fn pathEnd(path: *Path) -> [*]const u8 {
    path.*.bytes[path.*.length] = 0
    unsafe { return @ptrCast([*]const u8, path) }
}

fn exists(path: [*]const u8) -> bool {
    return std.fs.exists(path)
}

// Where to look, from the environment of this program.
pub fn init(apps: *Apps, environment: [*][*]const u8, allocator: Allocator) -> bool {
    apps.*.allocator = allocator
    apps.*.count = 0
    const memory = allocator.alloc(MAX_APPS * @sizeOf(App), 16)
    if memory == null { return false }
    unsafe { apps.*.list = @ptrCast([*]App, memory.?) }
    apps.*.home = environmentValue(environment, "HOME")
    apps.*.dataHome = environmentValue(environment, "XDG_DATA_HOME")
    apps.*.dataDirs = environmentValue(environment, "XDG_DATA_DIRS")
    apps.*.languageLength = 0
    var language = environmentValue(environment, "LC_ALL")
    if @intFromPtr(language) == 0 || language[0] == 0 { language = environmentValue(environment, "LC_MESSAGES") }
    if @intFromPtr(language) == 0 || language[0] == 0 { language = environmentValue(environment, "LANG") }
    if @intFromPtr(language) != 0 {
        // "de_DE.UTF-8": the language, "de".
        while language[apps.*.languageLength] >= 97 && language[apps.*.languageLength] <= 122 && apps.*.languageLength < 7 {
            apps.*.language[apps.*.languageLength] = language[apps.*.languageLength]
            apps.*.languageLength += 1
        }
    }
    return true
}

// The data directories: the user's first ($XDG_DATA_HOME, else
// ~/.local/share), then $XDG_DATA_DIRS (else /usr/local/share:/usr/share).
// Writes directory `index` into `path`; false past the last.
pub fn dataDirectory(apps: *Apps, index: usize, path: *Path) -> bool {
    pathClear(path)
    if index == 0 {
        if @intFromPtr(apps.*.dataHome) != 0 && apps.*.dataHome[0] != 0 {
            pathAddC(path, apps.*.dataHome)
            return true
        }
        if @intFromPtr(apps.*.home) == 0 { return true }
        pathAddC(path, apps.*.home)
        pathAdd(path, "/.local/share")
        return true
    }
    var dirs: [*]const u8 = unsafe { @ptrCast([*]const u8, "/usr/local/share:/usr/share") }
    if @intFromPtr(apps.*.dataDirs) != 0 && apps.*.dataDirs[0] != 0 { dirs = apps.*.dataDirs }
    var wanted = index - 1
    var position: usize = 0
    while true {
        const start = position
        while dirs[position] != 0 && dirs[position] != 58 { position += 1 }
        if wanted == 0 {
            if position == start { return false }
            var at = start
            while at < position {
                if path.*.length < 1000 {
                    path.*.bytes[path.*.length] = dirs[at]
                    path.*.length += 1
                }
                at += 1
            }
            return true
        }
        if dirs[position] == 0 { return false }
        position += 1
        wanted -= 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Desktop entries

fn copyValue(target: [*]u8, capacity: usize, line: [*]const u8, start: usize, end: usize) -> usize {
    var length: usize = 0
    var index = start
    while index < end && length < capacity {
        target[length] = line[index]
        length += 1
        index += 1
    }
    return length
}

fn isTrue(line: [*]const u8, start: usize, end: usize) -> bool {
    return end - start >= 4 && line[start] == 116 && line[start + 1] == 114 && line[start + 2] == 117 && line[start + 3] == 101
}

// Exec without field codes: %f %F %u %U %i %c %k (and the deprecated ones)
// go, %% is a %. Into `target` (room for `capacity` bytes); its length.
fn stripCodes(target: [*]u8, capacity: usize, line: [*]const u8, start: usize, end: usize) -> usize {
    var length: usize = 0
    var index = start
    while index < end && length < capacity {
        if line[index] == 37 && index + 1 < end {
            if line[index + 1] == 37 {
                target[length] = 37
                length += 1
            }
            index += 2
        } else {
            target[length] = line[index]
            length += 1
            index += 1
        }
    }
    while length > 0 && target[length - 1] == 32 { length -= 1 }
    return length
}

fn copyExec(app: *App, line: [*]const u8, start: usize, end: usize) -> void {
    const target: [*]u8 = &app.*.exec
    app.*.execLength = stripCodes(target, 510, line, start, end)
}

// Reads one entry (the file NAME.desktop, or app.ini of the bundle
// NAME.app) into the next slot; false when it does not count. Its id is
// what its Id= says, else NAME.
fn readEntry(apps: *Apps, path: [*]const u8, name: [*]const u8, name_length: usize, bundle: bool) -> bool {
    if apps.*.count >= MAX_APPS { return false }
    const loaded = std.fs.readFileAlloc(path, apps.*.allocator)
    if loaded == null { return false }
    const contents = loaded.?
    const app = appAt(apps, apps.*.count)
    app.*.fileLength = copyValue(&app.*.file, 96, name, 0, name_length)
    app.*.idLength = copyValue(&app.*.id, 96, name, 0, name_length)
    app.*.bundle = bundle
    app.*.nameLength = 0
    app.*.execLength = 0
    app.*.iconLength = 0
    app.*.wmClassLength = 0
    app.*.typesLength = 0
    app.*.terminal = false
    app.*.hasImage = false
    app.*.iconSize = 0
    var localized = false
    var application = false
    var hidden = false
    var in_entry = false
    const text = contents.items
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        const line: [*]const u8 = text + at
        // (Without the carriage return of a file written elsewhere.)
        const length = if end > at && text[end - 1] == 13 { end - at - 1 } else { end - at }
        if length > 0 && line[0] == 91 {
            in_entry = std.text.startsWith(line[0..length], "[Desktop Entry]")
        } else if in_entry {
            var equals: usize = 0
            while equals < length && line[equals] != 61 { equals += 1 }
            if equals < length {
                const value_start = equals + 1
                if std.text.startsWith(line[0..length], "Name=") && !localized {
                    app.*.nameLength = copyValue(&app.*.name, 96, line, value_start, length)
                } else if std.text.startsWith(line[0..length], "Name[") && apps.*.languageLength > 0 && equals == 5 + apps.*.languageLength + 1 {
                    // Name[de]= (not Name[de_AT]=).
                    var same = true
                    var index: usize = 0
                    while index < apps.*.languageLength {
                        if line[5 + index] != apps.*.language[index] { same = false }
                        index += 1
                    }
                    if same {
                        app.*.nameLength = copyValue(&app.*.name, 96, line, value_start, length)
                        localized = true
                    }
                } else if std.text.startsWith(line[0..length], "Exec=") {
                    copyExec(app, line, value_start, length)
                } else if std.text.startsWith(line[0..length], "Icon=") {
                    app.*.iconLength = copyValue(&app.*.icon, 160, line, value_start, length)
                } else if std.text.startsWith(line[0..length], "MimeType=") {
                    app.*.typesLength = copyValue(&app.*.types, 256, line, value_start, length)
                } else if std.text.startsWith(line[0..length], "StartupWMClass=") {
                    app.*.wmClassLength = copyValue(&app.*.wmClass, 96, line, value_start, length)
                } else if std.text.startsWith(line[0..length], "Id=") {
                    // (Without blanks around it: a window's app id has
                    // none, and the two must be the same.)
                    var from = value_start
                    var to = length
                    while from < to && (line[from] == 32 || line[from] == 9) { from += 1 }
                    while to > from && (line[to - 1] == 32 || line[to - 1] == 9) { to -= 1 }
                    if to > from { app.*.idLength = copyValue(&app.*.id, 96, line, from, to) }
                } else if std.text.startsWith(line[0..length], "Type=") {
                    application = std.text.startsWith(line[0..length], "Type=Application")
                } else if std.text.startsWith(line[0..length], "NoDisplay=") || std.text.startsWith(line[0..length], "Hidden=") {
                    if isTrue(line, value_start, length) { hidden = true }
                } else if std.text.startsWith(line[0..length], "Terminal=") {
                    app.*.terminal = isTrue(line, value_start, length)
                }
            }
        }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
    return application && !hidden && app.*.execLength > 0 && app.*.nameLength > 0
}

// Whether an entry with this file name was read already (the user's, or
// a data directory's before this one).
fn known(apps: *Apps, name: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < apps.*.count {
        const app = appAt(apps, index)
        if app.*.fileLength == length {
            var same = true
            var at: usize = 0
            while at < length {
                if app.*.file[at] != name[at] { same = false }
                at += 1
            }
            if same { return true }
        }
        index += 1
    }
    return false
}

// The program an Exec line names (its first token, after the last slash):
// so a .desktop and a bundle for the same program are not both shown.
// (Two desktop entries may start one program and both count: an office
// suite's parts, a browser and its private window.)
fn execProgram(app: *const App) -> []const u8 {
    const exec = execOf(app)
    var end: usize = 0
    while end < exec.length && exec[end] != 32 && exec[end] != 9 { end += 1 }
    var start = end
    while start > 0 && exec[start - 1] != 47 { start -= 1 }
    return exec[start..end]
}

// Whether an entry read before is for the same app as `candidate`, a
// desktop entry: a bundle that starts the same program, or any entry with
// the same id.
fn programKnown(apps: *Apps, candidate: *const App) -> bool {
    const want = execProgram(candidate)
    var index: usize = 0
    while index < apps.*.count {
        const other = appAt(apps, index)
        if other.*.bundle && want.length > 0 && sameText(execProgram(other), want) { return true }
        if sameText(idOf(other), idOf(candidate)) { return true }
        index += 1
    }
    return false
}

// An app's icon set to an absolute path (a bundle's own icon.png).
fn setIconPath(app: *App, path: [*]const u8) -> void {
    var n: usize = 0
    while path[n] != 0 && n < 159 {
        app.*.icon[n] = path[n]
        n += 1
    }
    app.*.iconLength = n
}

// A bundle directory: NAME.app holding app.ini (the [Desktop Entry]
// format) and its own icon.png. Like a macOS .app, so one directory
// replaces a .desktop file and a theme icon.
fn scanBundles(apps: *Apps, directory: *Path) -> void {
    const base_length = directory.*.length
    const handle = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(pathEnd(directory)), std.linux.O_DIRECTORY | std.linux.O_CLOEXEC, 0)
    if handle < 0 { return }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    var reader = std.fs.entries(std.fs.File.{ .descriptor = handle }, bytes, 8192)
    var entry: std.fs.Entry = undefined
    while std.fs.nextEntry(&reader, &entry) {
        const name = entry.name.pointer
        const length = entry.name.length
        // NAME.app: a bundle.
        if length > 4 && name[length - 4] == 46 && name[length - 3] == 97 && name[length - 2] == 112 && name[length - 1] == 112 && !known(apps, name, length - 4) {
            if apps.*.count >= MAX_APPS { break }
            directory.*.length = base_length
            pathAdd(directory, "/")
            pathAdd(directory, name[0..length])
            pathAdd(directory, "/app.ini")
            if readEntry(apps, pathEnd(directory), name, length - 4, true) {
                // The bundle ships its own icon.
                directory.*.length = base_length
                pathAdd(directory, "/")
                pathAdd(directory, name[0..length])
                pathAdd(directory, "/icon.png")
                if exists(pathEnd(directory)) { setIconPath(appAt(apps, apps.*.count), pathEnd(directory)) }
                apps.*.count += 1
            }
        }
    }
    directory.*.length = base_length
    std.linux.close(handle)
}

fn scanDirectory(apps: *Apps, directory: *Path) -> void {
    const base_length = directory.*.length
    const handle = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(pathEnd(directory)), std.linux.O_DIRECTORY | std.linux.O_CLOEXEC, 0)
    if handle < 0 { return }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = &buffer
    var reader = std.fs.entries(std.fs.File.{ .descriptor = handle }, bytes, 8192)
    var entry: std.fs.Entry = undefined
    while std.fs.nextEntry(&reader, &entry) {
        const name = entry.name.pointer
        const length = entry.name.length
        // NAME.desktop: its id is NAME (unless it names another).
        if length > 8 && name[length - 8] == 46 && name[length - 7] == 100 && name[length - 1] == 112 && !known(apps, name, length - 8) {
            directory.*.length = base_length
            pathAdd(directory, "/")
            pathAdd(directory, name[0..length])
            if readEntry(apps, pathEnd(directory), name, length - 8, false) && !programKnown(apps, appAt(apps, apps.*.count)) { apps.*.count += 1 }
        }
    }
    directory.*.length = base_length
    std.linux.close(handle)
}

fn nameBefore(first: *const App, second: *const App) -> bool {
    var index: usize = 0
    while index < first.*.nameLength && index < second.*.nameLength {
        const a = std.ascii.toLower(first.*.name[index])
        const b = std.ascii.toLower(second.*.name[index])
        if a != b { return a < b }
        index += 1
    }
    return first.*.nameLength < second.*.nameLength
}

// Reads every desktop entry, sorted by name.
pub fn scan(apps: *Apps) -> void {
    apps.*.count = 0
    var path: Path = undefined
    // App bundles first ($XDG_DATA_DIRS/apps/NAME.app): they win over a
    // .desktop for the same program.
    var index: usize = 0
    while dataDirectory(apps, index, &path) {
        if path.length > 0 {
            pathAdd(&path, "/apps")
            scanBundles(apps, &path)
        }
        index += 1
    }
    index = 0
    while dataDirectory(apps, index, &path) {
        if path.length > 0 {
            pathAdd(&path, "/applications")
            scanDirectory(apps, &path)
        }
        index += 1
    }
    // Insertion sort by name (a few hundred entries).
    var swap: App = undefined
    var sorted: usize = 1
    while sorted < apps.*.count {
        var at = sorted
        while at > 0 && nameBefore(appAt(apps, at), appAt(apps, at - 1)) {
            copyApp(&swap, appAt(apps, at))
            copyApp(appAt(apps, at), appAt(apps, at - 1))
            copyApp(appAt(apps, at - 1), &swap)
            at -= 1
        }
        sorted += 1
    }
}

fn copyApp(target: *App, source: *const App) -> void {
    var to: [*]u8 = undefined
    var from: [*]const u8 = undefined
    unsafe {
        to = @ptrCast([*]u8, target)
        from = @ptrCast([*]const u8, source)
    }
    var index: usize = 0
    while index < @sizeOf(App) {
        to[index] = from[index]
        index += 1
    }
}

// A number that changes when an application directory changes (an app
// installed or removed adds or takes away a file there): their
// modification times. Cheap: one stat per directory.
pub fn signature(apps: *Apps) -> usize {
    var value: usize = 17
    var path: Path = undefined
    var index: usize = 0
    while dataDirectory(apps, index, &path) {
        if path.length > 0 {
            const base = path.length
            pathAdd(&path, "/applications")
            var status: std.fs.Stat = undefined
            if std.fs.status(pathEnd(&path), &status) == 0 {
                value = value *% 31 +% @bitCast(usize, status.modifiedSeconds)
                value = value *% 31 +% @bitCast(usize, status.modifiedNanoseconds)
            } else {
                value = value *% 31 +% 1
            }
            path.length = base
            pathAdd(&path, "/apps")
            if std.fs.status(pathEnd(&path), &status) == 0 {
                value = value *% 31 +% @bitCast(usize, status.modifiedSeconds)
                value = value *% 31 +% @bitCast(usize, status.modifiedNanoseconds)
            } else {
                value = value *% 31 +% 3
            }
        }
        index += 1
    }
    return value
}

// Reads the entries again (their icons are loaded again as they are asked
// for).
pub fn rescan(apps: *Apps) -> void {
    var index: usize = 0
    while index < apps.*.count {
        const app = appAt(apps, index)
        if app.*.hasImage { png.deinit(imageOf(app)) }
        app.*.hasImage = false
        index += 1
    }
    scan(apps)
}

// The app `name` stands for: the one way from a name to an entry, for a
// window's app id, a pin and a program's name alike (ignoring case). An
// entry answers to its id ("org.mlx.files": what its program gives its
// windows), then to its file name ("Polaris" of Polaris.app) and its
// StartupWMClass ("polaris", the program), then to the last part of a
// reverse-DNS id ("nautilus" for org.gnome.Nautilus). A name no entry
// answers to is tried without the desktop entry's suffix
// ("firefox.desktop": some programs give their windows that, some pins
// were written so). Returns the index, or count when no entry does.
pub fn find(apps: *Apps, name: []const u8) -> usize {
    const found = findNamed(apps, name)
    if found < apps.*.count || name.length <= 8 || !sameText(name[name.length - 8..name.length], ".desktop") { return found }
    return findNamed(apps, name[0..name.length - 8])
}

fn findNamed(apps: *Apps, name: []const u8) -> usize {
    if name.length == 0 { return apps.*.count }
    var index: usize = 0
    while index < apps.*.count {
        if sameText(idOf(appAt(apps, index)), name) { return index }
        index += 1
    }
    index = 0
    while index < apps.*.count {
        const app = appAt(apps, index)
        if sameText(fileOf(app), name) || (app.*.wmClassLength > 0 && sameText(wmClassOf(app), name)) { return index }
        index += 1
    }
    index = 0
    while index < apps.*.count {
        const app = appAt(apps, index)
        const id = idOf(app)
        var dot = id.length
        while dot > 0 && id[dot - 1] != 46 { dot -= 1 }
        if dot > 0 && sameText(id[dot..id.length], name) { return index }
        index += 1
    }
    return apps.*.count
}

// What to call the app `name` stands for (a window's app id): its entry's
// Name; without an entry the Mlx terminal is "Terminal" and anything else
// goes by `name` itself.
pub fn nameFor(apps: *Apps, name: []const u8) -> []const u8 {
    const app = find(apps, name)
    if app < apps.*.count { return nameOf(appAt(apps, app)) }
    if sameText(name, TERMINAL_ID) { return "Terminal" }
    return name
}

// ---------------------------------------------------------------------------
// Icons

pub fn imageOf(app: *App) -> *png.Image {
    unsafe { return @ptrCast(*png.Image, &app.*.image) }
}

fn iconSizeAt(index: usize) -> usize {
    return match index {
        0 => 64, 1 => 48, 2 => 96, 3 => 128, 4 => 256, 5 => 512, 6 => 32, 7 => 24, 8 => 22,
        else => 16
    }
}

fn tryIcon(app: *App, path: *Path, size: usize, allocator: Allocator) -> bool {
    var image: png.Image = undefined
    if png.loadFile(&image, pathEnd(path), allocator) != png.Status.ok { return false }
    var scaled: png.Image = undefined
    const status = png.scale(&scaled, &image, size, size, allocator)
    png.deinit(&image)
    if status != png.Status.ok { return false }
    app.*.image = scaled
    app.*.hasImage = true
    return true
}

// The file the app's icon was read from ("" before loadIcon found one):
// the same file whoever asks, a bundle's icon.png or the theme's.
pub fn iconFileOf(app: *const App) -> []const u8 {
    if !app.*.hasImage || app.*.iconLength == 0 || app.*.icon[0] != 47 { return "" }
    return sliceOf(@intFromPtr(app) + @offsetOf(App, "icon"), app.*.iconLength)
}

// The theme's file for the icon was found: it is the app's icon from now
// on (the search takes the same file whatever size is wanted).
fn keepIconPath(app: *App, path: *Path) -> void {
    if path.*.length < 160 { setIconPath(app, pathEnd(path)) }
}

// Loads the app's icon at `size` pixels (once per size); false when it has
// none we can read.
pub fn loadIcon(apps: *Apps, app: *App, size: usize) -> bool {
    if app.*.iconSize == size { return app.*.hasImage }
    if app.*.hasImage { png.deinit(imageOf(app)) }
    app.*.hasImage = false
    app.*.iconSize = size
    if app.*.iconLength == 0 { return false }
    const icon = sliceOf(@intFromPtr(app) + @offsetOf(App, "icon"), app.*.iconLength)
    var path: Path = undefined
    if icon[0] == 47 {
        pathClear(&path)
        pathAdd(&path, icon)
        return tryIcon(app, &path, size, apps.*.allocator)
    }
    var directory: usize = 0
    var base: Path = undefined
    while dataDirectory(apps, directory, &base) {
        if base.length > 0 {
            var index: usize = 0
            while index < 10 {
                const pixels = iconSizeAt(index)
                pathClear(&path)
                pathAdd(&path, base.bytes[0..base.length])
                pathAdd(&path, "/icons/hicolor/")
                appendNumber(&path, pixels)
                pathAdd(&path, "x")
                appendNumber(&path, pixels)
                pathAdd(&path, "/apps/")
                pathAdd(&path, icon)
                pathAdd(&path, ".png")
                if exists(pathEnd(&path)) && tryIcon(app, &path, size, apps.*.allocator) {
                    keepIconPath(app, &path)
                    return true
                }
                index += 1
            }
        }
        directory += 1
    }
    pathClear(&path)
    pathAdd(&path, "/usr/share/pixmaps/")
    pathAdd(&path, icon)
    pathAdd(&path, ".png")
    if !exists(pathEnd(&path)) || !tryIcon(app, &path, size, apps.*.allocator) { return false }
    keepIconPath(app, &path)
    return true
}

fn appendNumber(path: *Path, value: usize) -> void {
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = &digits
    pathAdd(path, bytes[0..std.text.appendUnsigned(bytes, 0, 24, value)])
}

// ---------------------------------------------------------------------------
// Starting

// Runs `command` with /bin/sh -c (inside `terminal`, a program name or
// path, when it is not 0, for programs that want one), detached: in a
// session of its own, and reaped at once (it is a grandchild).
pub fn run(command: []const u8, terminal: [*]const u8, environment: [*][*]const u8) -> void {
    var line: Path = undefined
    pathClear(&line)
    pathAdd(&line, "exec ")
    if @intFromPtr(terminal) != 0 {
        // exec TERMINAL /bin/sh -c 'COMMAND' (a ' in it as '\'').
        pathAddC(&line, terminal)
        pathAdd(&line, " /bin/sh -c '")
        for byte in command {
            if byte == 39 { pathAdd(&line, "'\\''") }
            if byte != 39 && line.length < 1020 {
                line.bytes[line.length] = byte
                line.length += 1
            }
        }
        pathAdd(&line, "'")
    } else {
        pathAdd(&line, command)
    }
    spawn(pathEnd(&line), environment)
}

// Runs a shell script (several commands, `||`) the same way.
pub fn runScript(script: []const u8, environment: [*][*]const u8) -> void {
    var line: Path = undefined
    pathClear(&line)
    pathAdd(&line, script)
    spawn(pathEnd(&line), environment)
}

// Runs the NUL-terminated shell command `text` the same way (for commands
// longer than a Path holds).
pub fn spawn(text: [*]const u8, environment: [*][*]const u8) -> void {
    var arguments: [4][*]const u8 = undefined
    var options: spawn_module.Options = undefined
    unsafe {
        arguments[0] = @ptrCast([*]const u8, platform.SHELL)
        arguments[1] = @ptrCast([*]const u8, "-c")
        arguments[2] = text
        arguments[3] = @ptrFromInt([*]const u8, 0)
        options = spawn_module.options(arguments[0], @ptrCast([*][*]const u8, &arguments), environment)
    }
    // A session of its own, and no child of ours (nobody waits for it).
    options.newSession = true
    options.detach = true
    _ = spawn_module.start(&options)
}

// Starts the app (in `terminal` when it wants one). The Mlx terminal's
// entry starts `terminal` itself (what the compositor names,
// $MLX_TERMINAL: the one its own key opens), so the dock and the launcher
// start the same program for it.
pub fn launch(app: *const App, terminal: [*]const u8, environment: [*][*]const u8) -> void {
    const none: [*]const u8 = unsafe { @ptrFromInt([*]const u8, 0) }
    if @intFromPtr(terminal) != 0 && terminal[0] != 0 && sameText(idOf(app), TERMINAL_ID) {
        var length: usize = 0
        while terminal[length] != 0 { length += 1 }
        run(terminal[0..length], none, environment)
        return
    }
    run(execOf(app), if app.*.terminal { terminal } else { none }, environment)
}

// Starts the app with the file at `path` (after its command, quoted for
// the shell), as a double click on the file does.
pub fn launchWith(app: *const App, path: []const u8, terminal: [*]const u8, environment: [*][*]const u8) -> void {
    const none: [*]const u8 = unsafe { @ptrFromInt([*]const u8, 0) }
    var line: Path = undefined
    pathClear(&line)
    pathAdd(&line, execOf(app))
    pathAdd(&line, " '")
    for byte in path {
        if byte == 39 { pathAdd(&line, "'\\''") }
        if byte != 39 && line.length < 1020 {
            line.bytes[line.length] = byte
            line.length += 1
        }
    }
    pathAdd(&line, "'")
    run(line.bytes[0..line.length], if app.*.terminal { terminal } else { none }, environment)
}

// ---------------------------------------------------------------------------
// The desktop entry file and its actions

// The path of what stands for the app among the files into `path`: its
// bundle (DATA/apps/NAME.app, a directory) or its desktop entry
// (DATA/applications/NAME.desktop), in the first data directory that has
// it; false when none has. This is what is dragged to pin an app.
pub fn entryPath(apps: *Apps, app: *const App, path: *Path) -> bool {
    var index: usize = 0
    while dataDirectory(apps, index, path) {
        if path.*.length > 0 {
            pathAdd(path, if app.*.bundle { "/apps/" } else { "/applications/" })
            pathAdd(path, fileOf(app))
            // (A bundle is there when its app.ini is.)
            const bundle_end = path.*.length + 4
            pathAdd(path, if app.*.bundle { ".app/app.ini" } else { ".desktop" })
            if exists(pathEnd(path)) {
                if app.*.bundle { path.*.length = bundle_end }
                return true
            }
        }
        index += 1
    }
    return false
}

// The path of the file the app's entry is written in (a bundle's app.ini,
// or the desktop entry itself) into `path`; false when there is none.
pub fn entryFile(apps: *Apps, app: *const App, path: *Path) -> bool {
    if !entryPath(apps, app, path) { return false }
    if app.*.bundle { pathAdd(path, "/app.ini") }
    return true
}

// The app whose own entry is at `path` (what entryPath gives for it: its
// bundle's directory, with a slash at its end or its app.ini named, or
// its desktop entry file); count when the path is no app's entry. For
// what was dragged: two entries may answer to one name (find takes the
// first), a path is one entry's only, and a file elsewhere that merely
// has such a name is none.
pub fn findEntry(apps: *Apps, path: []const u8) -> usize {
    var end = path.length
    if end > 8 && std.text.same(path[end - 8..end], "/app.ini") { end -= 8 }
    while end > 1 && path[end - 1] == 47 { end -= 1 }
    var entry: Path = undefined
    var index: usize = 0
    while index < apps.*.count {
        const app = appAt(apps, index)
        // (Only an entry whose own name ends the path is looked up.)
        const file = fileOf(app)
        const suffix: usize = if app.*.bundle { 4 } else { 8 }
        const tail = file.length + suffix
        if end > tail && path[end - tail - 1] == 47 && std.text.same(path[end - tail..end - suffix], file) && entryPath(apps, app, &entry) && std.text.same(path[0..end], entry.bytes[0..entry.length]) { return index }
        index += 1
    }
    return apps.*.count
}

// What a desktop entry offers besides starting it ([Desktop Action NAME]
// groups: "New Window", "New Private Window"), with their commands.
pub const MAX_ACTIONS: usize = 6
const ACTION_NAME: usize = 64
const ACTION_EXEC: usize = 384

pub const Actions = struct {
    count: usize
    names: [384]u8
    nameLengths: [6]usize
    execs: [2304]u8
    execLengths: [6]usize
}

pub fn actionName(actions: *const Actions, index: usize) -> []const u8 {
    return sliceOf(@intFromPtr(actions) + @offsetOf(Actions, "names") + index * ACTION_NAME, actions.*.nameLengths[index])
}

pub fn actionExec(actions: *const Actions, index: usize) -> []const u8 {
    return sliceOf(@intFromPtr(actions) + @offsetOf(Actions, "execs") + index * ACTION_EXEC, actions.*.execLengths[index])
}

// Reads the app's actions (in the order of the file; Name[LANG] as for the
// app's name); none when its file cannot be read.
pub fn loadActions(apps: *Apps, app: *const App, actions: *Actions) -> void {
    actions.*.count = 0
    var path: Path = undefined
    if !entryFile(apps, app, &path) { return }
    const loaded = std.fs.readFileAlloc(pathEnd(&path), apps.*.allocator)
    if loaded == null { return }
    const contents = loaded.?
    const text = contents.items
    // The group being read (an action slot), and whether its name was
    // localized.
    var current = MAX_ACTIONS
    var localized = false
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        const line: [*]const u8 = text + at
        var length = end - at
        while length > 0 && (line[length - 1] == 13 || line[length - 1] == 32) { length -= 1 }
        if length > 0 && line[0] == 91 {
            current = MAX_ACTIONS
            // A group whose action has a name and a command counts.
            if actions.*.count < MAX_ACTIONS && std.text.startsWith(line[0..length], "[Desktop Action ") {
                current = actions.*.count
                actions.*.nameLengths[current] = 0
                actions.*.execLengths[current] = 0
                localized = false
                actions.*.count += 1
            }
        } else if current < MAX_ACTIONS {
            var equals: usize = 0
            while equals < length && line[equals] != 61 { equals += 1 }
            if equals < length {
                const names: [*]u8 = unsafe { @ptrCast([*]u8, actions) + @offsetOf(Actions, "names") + current * ACTION_NAME }
                const execs: [*]u8 = unsafe { @ptrCast([*]u8, actions) + @offsetOf(Actions, "execs") + current * ACTION_EXEC }
                if std.text.startsWith(line[0..length], "Name=") && !localized {
                    actions.*.nameLengths[current] = copyValue(names, ACTION_NAME, line, equals + 1, length)
                } else if std.text.startsWith(line[0..length], "Name[") && apps.*.languageLength > 0 && equals == 5 + apps.*.languageLength + 1 {
                    var same = true
                    var index: usize = 0
                    while index < apps.*.languageLength {
                        if line[5 + index] != apps.*.language[index] { same = false }
                        index += 1
                    }
                    if same {
                        actions.*.nameLengths[current] = copyValue(names, ACTION_NAME, line, equals + 1, length)
                        localized = true
                    }
                } else if std.text.startsWith(line[0..length], "Exec=") {
                    actions.*.execLengths[current] = stripCodes(execs, ACTION_EXEC - 2, line, equals + 1, length)
                }
            }
        }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
    // Without a name or a command an action is dropped.
    var kept: usize = 0
    var index: usize = 0
    while index < actions.*.count {
        if actions.*.nameLengths[index] > 0 && actions.*.execLengths[index] > 0 {
            if kept != index {
                var byte: usize = 0
                while byte < ACTION_NAME {
                    actions.*.names[kept * ACTION_NAME + byte] = actions.*.names[index * ACTION_NAME + byte]
                    byte += 1
                }
                byte = 0
                while byte < ACTION_EXEC {
                    actions.*.execs[kept * ACTION_EXEC + byte] = actions.*.execs[index * ACTION_EXEC + byte]
                    byte += 1
                }
                actions.*.nameLengths[kept] = actions.*.nameLengths[index]
                actions.*.execLengths[kept] = actions.*.execLengths[index]
            }
            kept += 1
        }
        index += 1
    }
    actions.*.count = kept
}

// Runs action `index` of the app (in `terminal` when the app wants one).
pub fn runAction(app: *const App, actions: *const Actions, index: usize, terminal: [*]const u8, environment: [*][*]const u8) -> void {
    if index >= actions.*.count { return }
    const none: [*]const u8 = unsafe { @ptrFromInt([*]const u8, 0) }
    run(actionExec(actions, index), if app.*.terminal { terminal } else { none }, environment)
}

// The color of an app's tile when it has no icon (from its name).
pub fn tileColor(name: []const u8) -> u32 {
    var hash: u32 = 2166136261
    for byte in name { hash = (hash ^ @intCast(u32, byte)) *% 16777619 }
    return match hash % 6 {
        0 => 4282154168, 1 => 4290005830, 2 => 4283215696, 3 => 4292241438, 4 => 4287646649,
        else => 4278235830
    }
}
