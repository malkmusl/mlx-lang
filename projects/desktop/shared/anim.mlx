// Animations of the desktop's panels (the top bar, the settings): values
// that glide to where they go (a widget's place and width, how lit it is
// under the pointer, a slider's knob, a row moving up or down) and how far
// along a transition is, easing out. Whatever still moves when a panel is
// drawn says so, and it then ticks often and draws again until nothing
// does.
const panel_module = @import("std.ui.wayland.panel")

pub const Glide = struct {
    from: i32
    to: i32
    // When it set off (milliseconds; 0: it stands at `to`), and for how
    // long it goes.
    start: usize
    duration: usize
}

pub fn now() -> usize { return panel_module.milliseconds() }

// 0 to 1024 of a transition that started at `start` and takes `duration`
// milliseconds, easing out (1024 once it is over, or when start is 0).
pub fn progress(start: usize, duration: usize) -> i32 {
    if start == 0 || duration == 0 { return 1024 }
    const elapsed = now() - start
    if elapsed >= duration { return 1024 }
    const left = 1024 - @intCast(i64, elapsed * 1024 / duration)
    return @intCast(i32, 1024 - left * left / 1024 * left / 1024)
}

pub fn between(from: i32, to: i32, t: i32) -> i32 { return from + (to - from) * t / 1024 }

// Stands at `value`.
pub fn jump(glide: *Glide, value: i32) -> void {
    glide.*.from = value
    glide.*.to = value
    glide.*.start = 0
}

// Where it is now.
pub fn value(glide: *const Glide) -> i32 { return between(glide.*.from, glide.*.to, progress(glide.*.start, glide.*.duration)) }

// Goes to `target` from where it is now, over `duration` milliseconds.
pub fn set(glide: *Glide, target: i32, duration: usize) -> void {
    if target == glide.*.to { return }
    glide.*.from = value(glide)
    glide.*.to = target
    glide.*.start = now()
    glide.*.duration = duration
}

pub fn moving(glide: *const Glide) -> bool { return progress(glide.*.start, glide.*.duration) < 1024 }
