// The desktop's backdrop: the wallpaper scaled to cover a screen, or, without
// one, a picture made of the desktop's colours (std.ui.scheme: their tint,
// dark, with the three prism colours glowing from three places, an
// aurora); and the scheme the wallpaper gives. The compositor draws it as
// its background (compositor/background.mlx); the locker (umbra) and the
// greeter (aurora) draw it blurred behind their glass card, so locking and
// logging in look like the desktop.
//
// The wallpaper and the chosen colour are the user's compositor.conf's
// (`wallpaper`, `accent-color`; settings readConfig), else the system's:
// SYSTEM_CONFIG, the same keys (what the greeter shows, and the desktop of
// a user who chose none).
const std = @import("std")
const builtin = @import("builtin")
const xdg = @import("std.xdg")
const png = @import("std.png")
const jpeg = @import("std.jpeg")
const ui_scheme = @import("std.ui.scheme")

const Allocator = std.allocator.Allocator

// The wallpaper and the colour of a compositor.conf.
pub const Config = struct {
    // NUL-terminated, empty: none.
    wallpaper: [256]u8
    // 0: from the wallpaper.
    seed: u32
}

fn startsWith(line: []const u8, key: []const u8) -> bool { return line.length >= key.length && std.text.same(line[0..key.length], key) }

// The value of a "key = value" line, trimmed.
fn valueOf(line: []const u8) -> []const u8 {
    var at: usize = 0
    while at < line.length && line[at] != 61 { at += 1 }
    if at >= line.length { return line[0..0] }
    return std.text.trimmed(line[at + 1..line.length])
}

// $HOME (NUL-terminated; 0: none).
fn homeOf(environment: [*][*]const u8) -> [*]const u8 {
    var index: usize = 0
    while @intFromPtr(environment[index]) != 0 {
        const entry = environment[index]
        if entry[0] == 72 && entry[1] == 79 && entry[2] == 77 && entry[3] == 69 && entry[4] == 61 {
            const value: [*]const u8 = entry + 5
            return value
        }
        index += 1
    }
    return unsafe { @ptrFromInt([*]const u8, 0) }
}

// The system's desktop settings: brixOS keeps them with its other
// settings; elsewhere (the compatibility path) under /etc.
pub fn systemConfigPath() -> [*]const u8 {
    if comptime builtin.os == builtin.Os.brixos { return "/system/settings/desktop.conf\x00".pointer }
    return "/etc/mlx/desktop.conf\x00".pointer
}

// Reads `wallpaper` and `accent-color` from $XDG_CONFIG_HOME/mlx/
// compositor.conf (~/ in the path is the home folder); when it names
// neither, from the system's (systemConfigPath).
pub fn readConfig(environment: [*][*]const u8, config: *Config) -> void {
    config.*.wallpaper[0] = 0
    config.*.seed = 0
    var path: [256]u8 = undefined
    const bytes: [*]u8 = &path
    const length = xdg.path(environment, xdg.CONFIG, "/mlx/compositor.conf", bytes, 250)
    if length > 0 { readFile(bytes, environment, config) }
    if config.*.wallpaper[0] == 0 && config.*.seed == 0 { readFile(systemConfigPath(), environment, config) }
}

// The system's alone (the compositor reads the user's itself).
pub fn readSystemConfig(environment: [*][*]const u8, config: *Config) -> void {
    config.*.wallpaper[0] = 0
    config.*.seed = 0
    readFile(systemConfigPath(), environment, config)
}

fn readFile(bytes: [*]const u8, environment: [*][*]const u8, config: *Config) -> void {
    var text: [4096]u8 = undefined
    const text_bytes: [*]u8 = &text
    const size = std.fs.readFile(bytes, text_bytes, 4096)
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && text_bytes[end] != 10 { end += 1 }
        const line = text_bytes[at..end]
        if startsWith(line, "wallpaper") {
            const value = valueOf(line)
            var written: usize = 0
            var from: usize = 0
            if value.length >= 2 && value[0] == 126 && value[1] == 47 {
                const home = homeOf(environment)
                var index: usize = 0
                while @intFromPtr(home) != 0 && home[index] != 0 && index < 200 {
                    config.*.wallpaper[written] = home[index]
                    written += 1
                    index += 1
                }
                from = 1
            }
            if !std.text.same(value, "none") && written + value.length - from < 255 {
                var index = from
                while index < value.length {
                    config.*.wallpaper[written] = value[index]
                    written += 1
                    index += 1
                }
                config.*.wallpaper[written] = 0
            } else {
                config.*.wallpaper[0] = 0
            }
        }
        if startsWith(line, "accent-color") {
            var color: u32 = 0
            if ui_scheme.parseColor(valueOf(line), &color) { config.*.seed = color }
        }
        at = end + 1
    }
}

// The backdrop for a screen of `width` x `height` into `pixels` (rows
// `width` apart, opaque 0xAARRGGBB): the wallpaper at `wallpaper` (NUL-
// terminated, empty: none) covering it, else the aurora of the colours;
// the scheme into `scheme` (from `seed` when it is not 0, else from the
// wallpaper, else the default). True when the wallpaper was used.
pub fn make(pixels: [*]u32, width: usize, height: usize, wallpaper: [*]const u8, seed: u32, allocator: Allocator, scheme: *ui_scheme.Scheme) -> bool {
    scheme.* = ui_scheme.fromSeed(if seed != 0 { seed } else { ui_scheme.DEFAULT_ACCENT })
    var image: png.Image = undefined
    if wallpaper[0] != 0 && load(wallpaper, allocator, &image) {
        if seed == 0 { scheme.* = ui_scheme.fromImage(image.pixels, image.width, image.height, image.width) }
        cover(pixels, width, height, &image)
        png.deinit(&image)
        return true
    }
    aurora(pixels, width, height, scheme)
    return false
}

// The wallpaper, a PNG or a JPEG (by its first bytes), as pixels.
pub fn load(path: [*]const u8, allocator: Allocator, image: *png.Image) -> bool {
    const loaded = std.fs.readFileAlloc(path, allocator)
    if loaded == null { return false }
    const contents = loaded.?
    var ok = false
    if contents.length > 4 && contents.items[0] == 137 && contents.items[1] == 80 {
        ok = png.decode(image, contents.items, contents.length, allocator) == png.Status.ok
    } else if contents.length > 4 && contents.items[0] == 255 && contents.items[1] == 216 {
        var picture: jpeg.Picture = undefined
        if jpeg.decodeRgba(&picture, contents.items, contents.length, allocator) == jpeg.Status.ok {
            const count = picture.width * picture.height
            const memory = allocator.alloc(count * 4, 16)
            if memory != null {
                const words: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
                var index: usize = 0
                while index < count {
                    const at = index * 4
                    words[index] = 4278190080 | (@intCast(u32, picture.pixels[at]) << 16) | (@intCast(u32, picture.pixels[at + 1]) << 8) | @intCast(u32, picture.pixels[at + 2])
                    index += 1
                }
                image.*.pixels = words
                image.*.width = picture.width
                image.*.height = picture.height
                image.*.allocator = allocator
                ok = true
            }
            jpeg.deinitPicture(&picture)
        }
    }
    std.fs.ArrayList.deinit(contents)
    return ok && image.*.width > 0 && image.*.height > 0
}

// The image scaled to cover the screen (cut at the sides or the top and
// bottom, kept in the middle): each pixel the mean of (up to 4 x 4 of) the
// image's pixels its area covers.
pub fn cover(target: [*]u32, width: usize, height: usize, image: *const png.Image) -> void {
    var part_width = image.*.width
    var part_height = image.*.width * height / width
    if part_height > image.*.height {
        part_height = image.*.height
        part_width = image.*.height * width / height
    }
    if part_width == 0 { part_width = 1 }
    if part_height == 0 { part_height = 1 }
    const left = (image.*.width - part_width) / 2
    const top = (image.*.height - part_height) / 2
    var y: usize = 0
    while y < height {
        const from_y = top + y * part_height / height
        var to_y = top + (y + 1) * part_height / height
        if to_y <= from_y { to_y = from_y + 1 }
        var x: usize = 0
        while x < width {
            const from_x = left + x * part_width / width
            var to_x = left + (x + 1) * part_width / width
            if to_x <= from_x { to_x = from_x + 1 }
            const step_y = if to_y - from_y > 4 { (to_y - from_y) / 4 } else { 1 }
            const step_x = if to_x - from_x > 4 { (to_x - from_x) / 4 } else { 1 }
            var red: u32 = 0
            var green: u32 = 0
            var blue: u32 = 0
            var count: u32 = 0
            var sy = from_y
            while sy < to_y {
                var sx = from_x
                while sx < to_x {
                    const source = image.*.pixels[sy * image.*.width + sx]
                    red += (source >> 16) & 255
                    green += (source >> 8) & 255
                    blue += source & 255
                    count += 1
                    sx += step_x
                }
                sy += step_y
            }
            target[y * width + x] = 4278190080 | ((red / count) << 16) | ((green / count) << 8) | (blue / count)
            x += 1
        }
        y += 1
    }
}

fn glow(red: *u32, green: *u32, blue: *u32, x: i64, y: i64, cx: i64, cy: i64, radius: i64, color: u32, strength: i64) -> void {
    const dx = x - cx
    const dy = y - cy
    const distance = dx * dx + dy * dy
    const reach = radius * radius
    if distance >= reach { return }
    const fall = (reach - distance) * 256 / reach
    const amount = fall * fall / 256 * strength / 255
    red.* += @intCast(u32, @intCast(i64, (color >> 16) & 255) * amount / 256)
    green.* += @intCast(u32, @intCast(i64, (color >> 8) & 255) * amount / 256)
    blue.* += @intCast(u32, @intCast(i64, color & 255) * amount / 256)
}

// The picture made of the scheme: its tint, darker towards the bottom,
// lit by the prism's colours from the upper left, the upper right and
// below the middle.
pub fn aurora(target: [*]u32, width: usize, height: usize, scheme: *const ui_scheme.Scheme) -> void {
    const base = ui_scheme.toHsl(scheme.*.tint)
    const top_color = ui_scheme.fromHsl(ui_scheme.Hsl.{ .hue = base.hue, .saturation = base.saturation, .lightness = 140 })
    const bottom_color = ui_scheme.fromHsl(ui_scheme.Hsl.{ .hue = base.hue, .saturation = base.saturation, .lightness = 70 })
    const w = @intCast(i64, width)
    const h = @intCast(i64, height)
    const radius = (if w > h { w } else { h }) * 3 / 5
    var y: usize = 0
    while y < height {
        const row = ui_scheme.mix(top_color, bottom_color, @intCast(i32, y * 1024 / height))
        var x: usize = 0
        while x < width {
            var red = (row >> 16) & 255
            var green = (row >> 8) & 255
            var blue = row & 255
            const px = @intCast(i64, x)
            const py = @intCast(i64, y)
            glow(&red, &green, &blue, px, py, w / 6, h / 5, radius, scheme.*.prism[0], 120)
            glow(&red, &green, &blue, px, py, w * 5 / 6, h / 4, radius, scheme.*.prism[1], 110)
            glow(&red, &green, &blue, px, py, w / 2, h + h / 6, radius, scheme.*.prism[2], 130)
            if red > 255 { red = 255 }
            if green > 255 { green = 255 }
            if blue > 255 { blue = 255 }
            target[y * width + x] = 4278190080 | (red << 16) | (green << 8) | blue
            x += 1
        }
        y += 1
    }
}

// One box blur pass over `count` values `step` apart (the ends repeated).
fn boxPass(source: [*]const u32, target: [*]u32, start: usize, count: usize, step: usize, radius: usize) -> void {
    var red: u32 = 0
    var green: u32 = 0
    var blue: u32 = 0
    const window = @intCast(u32, radius * 2 + 1)
    var offset: usize = 0
    while offset < radius * 2 + 1 {
        const at = if offset < radius { 0 } else if offset - radius < count { offset - radius } else { count - 1 }
        const pixel = source[start + at * step]
        red += (pixel >> 16) & 255
        green += (pixel >> 8) & 255
        blue += pixel & 255
        offset += 1
    }
    var index: usize = 0
    while index < count {
        target[start + index * step] = 4278190080 | ((red / window) << 16) | ((green / window) << 8) | (blue / window)
        const leaving = source[start + (if index >= radius { index - radius } else { 0 }) * step]
        const entering = source[start + (if index + radius + 1 < count { index + radius + 1 } else { count - 1 }) * step]
        red = red - ((leaving >> 16) & 255) + ((entering >> 16) & 255)
        green = green - ((leaving >> 8) & 255) + ((entering >> 8) & 255)
        blue = blue - (leaving & 255) + (entering & 255)
        index += 1
    }
}

// Blurs the picture (three box blurs of `radius` across and down: close to
// a Gaussian), with a picture of the same size to work in, and darkens it
// to `keep` of 256 (what lies on it reads better).
pub fn blur(pixels: [*]u32, scratch: [*]u32, width: usize, height: usize, radius: usize, keep: u32) -> void {
    if width == 0 || height == 0 { return }
    var pass: usize = 0
    while pass < 3 {
        var row: usize = 0
        while row < height {
            boxPass(pixels, scratch, row * width, width, 1, radius)
            row += 1
        }
        var column: usize = 0
        while column < width {
            boxPass(scratch, pixels, column, height, width, radius)
            column += 1
        }
        pass += 1
    }
    var index: usize = 0
    while index < width * height {
        const pixel = pixels[index]
        pixels[index] = 4278190080 | ((((pixel >> 16) & 255) * keep / 256) << 16) | ((((pixel >> 8) & 255) * keep / 256) << 8) | ((pixel & 255) * keep / 256)
        index += 1
    }
}

// ---------------------------------------------------------------------------
// The backdrop of a full-screen surface (the locker, the greeter): made
// once a size, a quarter of the screen's resolution, blurred and a little
// darker, and drawn scaled over the canvas. It is square (the side of the
// screen's longer side, centred), as std.ui.canvas draws an image the same
// on the CPU and the GPU at a square size.

const canvas_module = @import("std.ui.canvas")

pub const Backdrop = struct {
    image: png.Image
    ready: bool
    // The screen size it was made for.
    width: i32
    height: i32
    scheme: ui_scheme.Scheme
}

pub fn initBackdrop(backdrop: *Backdrop) -> void {
    backdrop.*.ready = false
    backdrop.*.width = 0
    backdrop.*.height = 0
}

// A light veil over the backdrop in the light look (`lightness`, 0 dark
// to 1024 light), so a pale card stands on it as a dark one on the dark.
pub fn veil(canvas: *canvas_module.Canvas, width: i32, height: i32, lightness: i32) -> void {
    if lightness <= 0 { return }
    const amount = @intCast(u32, (if lightness > 1024 { 1024 } else { lightness }) * 120 / 1024)
    canvas_module.fillRect(canvas, 0, 0, width, height, canvas_module.color(amount, 240, 242, 248))
}

// Draws the backdrop over the canvas (`width` x `height`), making it first
// when the size changed: the wallpaper and the colour of the user's
// compositor.conf (readConfig). When the program has no desktop colours
// yet (no appearance.conf: the greeter), it takes the backdrop's
// (std.ui.scheme.setFallback): drawn again, everything matches it.
pub fn drawBackdrop(backdrop: *Backdrop, canvas: *canvas_module.Canvas, environment: [*][*]const u8, width: i32, height: i32, allocator: Allocator) -> void {
    const side = if width > height { width } else { height }
    if side <= 0 { return }
    if !backdrop.*.ready || backdrop.*.width != width || backdrop.*.height != height {
        if backdrop.*.ready { png.deinit(&backdrop.*.image) }
        backdrop.*.ready = false
        const size = @intCast(usize, if side / 4 > 16 { side / 4 } else { 16 })
        const memory = allocator.alloc(size * size * 4, 16)
        const scratch = allocator.alloc(size * size * 4, 16)
        if memory == null || scratch == null { return }
        const pixels: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
        const work: [*]u32 = unsafe { @ptrCast([*]u32, scratch.?) }
        var config: Config = undefined
        readConfig(environment, &config)
        const path: [*]const u8 = &config.wallpaper
        _ = make(pixels, size, size, path, config.seed, allocator, &backdrop.*.scheme)
        blur(pixels, work, size, size, 6, 200)
        allocator.free(scratch.?, size * size * 4, 16)
        backdrop.*.image.pixels = pixels
        backdrop.*.image.width = size
        backdrop.*.image.height = size
        backdrop.*.image.allocator = allocator
        backdrop.*.ready = true
        backdrop.*.width = width
        backdrop.*.height = height
        ui_scheme.setFallback(&backdrop.*.scheme)
    }
    canvas_module.drawImageRect(canvas, &backdrop.*.image, (width - side) / 2, (height - side) / 2, side, side, 255)
}
