// A context menu for the dock, the launcher and the file manager: a list
// of entries (a label, what it does as a kind and a value) with
// separators, drawn into a popup (panel.openMenu) or into the window at a
// place (drawAt), the entry under the pointer lit, its sizes times
// `scale` (a screen's density).
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")

const Canvas = canvas_module.Canvas
const Text = text_module.Text

pub const MAX_ENTRIES: usize = 14
pub const NONE: usize = 1 << 40
const LABEL: usize = 64
const ROW: i32 = 30
const GAP: i32 = 9
const PADDING: i32 = 6
const MIN_WIDTH: i32 = 190
const RADIUS: i32 = 12

pub const Entry = struct {
    label: [64]u8
    labelLength: usize
    kind: u32
    value: usize
    // A line above it.
    separated: bool
}

pub const Menu = struct {
    entries: [14]Entry
    count: usize
    hover: usize
    pendingSeparator: bool
    scale: i32
}

pub fn clear(menu: *Menu) -> void {
    menu.*.count = 0
    menu.*.hover = NONE
    menu.*.pendingSeparator = false
    menu.*.scale = 1
}

// Its sizes for `scale` pixels a logical pixel (after clear).
pub fn setScale(menu: *Menu, scale: i32) -> void { menu.*.scale = if scale > 0 { scale } else { 1 } }

fn entryAt(menu: *Menu, index: usize) -> *Entry {
    unsafe { return @ptrFromInt(*Entry, @intFromPtr(menu) + @offsetOf(Menu, "entries") + index * @sizeOf(Entry)) }
}

pub fn labelOf(entry: *const Entry) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(entry) + @offsetOf(Entry, "label")) }
    return bytes[0..entry.*.labelLength]
}

pub fn add(menu: *Menu, label: []const u8, kind: u32, value: usize) -> void {
    if menu.*.count >= MAX_ENTRIES { return }
    const entry = entryAt(menu, menu.*.count)
    entry.*.labelLength = 0
    for byte in label {
        if entry.*.labelLength < LABEL {
            entry.*.label[entry.*.labelLength] = byte
            entry.*.labelLength += 1
        }
    }
    entry.*.kind = kind
    entry.*.value = value
    entry.*.separated = menu.*.pendingSeparator && menu.*.count > 0
    menu.*.pendingSeparator = false
    menu.*.count += 1
}

// A line before the next entry.
pub fn separator(menu: *Menu) -> void { menu.*.pendingSeparator = true }

fn top(menu: *Menu, index: usize) -> i32 {
    const scale = menu.*.scale
    var y = PADDING * scale
    var at: usize = 0
    while at < index {
        y += ROW * scale
        if entryAt(menu, at + 1).*.separated { y += GAP * scale }
        at += 1
    }
    return y
}

pub fn width(menu: *Menu, text: *Text) -> u32 {
    var widest = MIN_WIDTH * menu.*.scale
    var index: usize = 0
    while index < menu.*.count {
        const needed = text_module.measure(text, labelOf(entryAt(menu, index))) + 40 * menu.*.scale
        if needed > widest { widest = needed }
        index += 1
    }
    return @intCast(u32, widest)
}

pub fn height(menu: *Menu) -> u32 {
    if menu.*.count == 0 { return 0 }
    return @intCast(u32, top(menu, menu.*.count - 1) + (ROW + PADDING) * menu.*.scale)
}

// The entry at menu point y, NONE between entries.
pub fn at(menu: *Menu, y: i32) -> usize {
    var index: usize = 0
    while index < menu.*.count {
        const row = top(menu, index)
        if y >= row && y < row + ROW * menu.*.scale { return index }
        index += 1
    }
    return NONE
}

// Moves the lit entry to the one at y; true when it changed.
pub fn hover(menu: *Menu, y: i32) -> bool {
    const index = at(menu, y)
    if index == menu.*.hover { return false }
    menu.*.hover = index
    return true
}

pub fn kindAt(menu: *Menu, index: usize) -> u32 { return entryAt(menu, index).*.kind }
pub fn valueAt(menu: *Menu, index: usize) -> usize { return entryAt(menu, index).*.value }

// The whole popup's canvas.
pub fn draw(menu: *Menu, canvas: *Canvas, text: *Text) -> void {
    canvas_module.clear(canvas, 0)
    drawAt(menu, canvas, text, 0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height))
}

// At (x, y) of a window's canvas, `w` x `h` (width and height).
pub fn drawAt(menu: *Menu, canvas: *Canvas, text: *Text, x: i32, y: i32, w: i32, h: i32) -> void {
    const scale = menu.*.scale
    const padding = PADDING * scale
    const row = ROW * scale
    canvas_module.fillRoundedRect(canvas, x, y, w, h, RADIUS * scale, canvas_module.color(255, 30, 33, 42))
    canvas_module.strokeRoundedRect(canvas, x, y, w, h, RADIUS * scale, scale, canvas_module.color(60, 255, 255, 255))
    var index: usize = 0
    while index < menu.*.count {
        const entry = entryAt(menu, index)
        const entry_y = y + top(menu, index)
        if entry.*.separated { canvas_module.fillRect(canvas, x + 12 * scale, entry_y - GAP * scale / 2 - scale, w - 24 * scale, scale, canvas_module.color(50, 255, 255, 255)) }
        if index == menu.*.hover { canvas_module.fillRoundedRect(canvas, x + padding, entry_y, w - padding * 2, row, 8 * scale, canvas_module.color(255, 90, 160, 255)) }
        text_module.drawText(canvas, text, labelOf(entry), x + 18 * scale, entry_y + 8 * scale, canvas_module.color(255, 240, 242, 248), w - 30 * scale)
        index += 1
    }
}
