// The default apps: which app opens a file of each type, as the user
// chose it. The desktop's own (brixOS has no xdg-open, and our apps do
// not need one): the choices are lines "TYPE = APP_ID" in the user's
// $XDG_CONFIG_HOME/mlx/defaults.conf, over the system's
// (/system/settings/defaults.conf on brixOS, /etc/mlx/defaults.conf
// elsewhere); a TYPE is a MIME type ("text/markdown") or a kind of them
// ("text/*", for each text type no line names). A type no line names
// goes to the app whose bundle says it takes it (MimeType=: the one
// naming the type before one naming its kind, a bundle before a desktop
// entry). Polaris opens files so (a double click; Open with ... and
// Always open ... in its menu), Control sets them (Apps, Default apps).
// Off brixOS, a file no app takes goes to xdg-open: the gateway to the
// foreign desktop's handlers.
//
//     const index = defaults.appFor(&apps, environment, defaults.typeOf(path))
//     defaults.choose(environment, "text/*", "org.mlx.comet")
//     _ = defaults.open(&apps, environment, path, terminal)
const std = @import("std")
const builtin = @import("builtin")
const xdg = @import("std.xdg")
const mime = @import("std.http.mime")
const apps_module = @import("./apps.mlx")

const Apps = apps_module.Apps

pub const ID_CAPACITY: usize = 96
const FILE_CAPACITY: usize = 8192

// The kinds of file Control lists, each with the type its choice is kept
// under and one of its types to find the apps that take it by.
pub const KINDS: usize = 7
pub fn kindType(kind: usize) -> []const u8 {
    return match kind { 0 => "text/*", 1 => "inode/directory", 2 => "text/html", 3 => "image/*", 4 => "audio/*", 5 => "video/*", else => "application/pdf" }
}
pub fn kindSample(kind: usize) -> []const u8 {
    return match kind { 0 => "text/plain", 1 => "inode/directory", 2 => "text/html", 3 => "image/png", 4 => "audio/mpeg", 5 => "video/mp4", else => "application/pdf" }
}
pub fn kindName(kind: usize, german: bool) -> []const u8 {
    if german { return match kind { 0 => "Text und Code", 1 => "Ordner", 2 => "Webseiten", 3 => "Bilder", 4 => "Musik", 5 => "Videos", else => "PDF-Dokumente" } }
    return match kind { 0 => "Text and code", 1 => "Folders", 2 => "Web pages", 3 => "Images", 4 => "Music", 5 => "Videos", else => "PDF documents" }
}

// What files of `type` are called, for a menu ("Markdown", "Text").
pub fn typeName(type_: []const u8, german: bool) -> []const u8 {
    if std.text.same(type_, "inode/directory") { return if german { "Ordner" } else { "Folders" } }
    if std.text.same(type_, "text/markdown") { return "Markdown" }
    if std.text.same(type_, "text/html") { return if german { "Webseiten" } else { "Web pages" } }
    if std.text.same(type_, "text/csv") { return "CSV" }
    if std.text.same(type_, "text/x-csrc") { return if german { "C-Quellen" } else { "C sources" } }
    if std.text.same(type_, "application/json") { return "JSON" }
    if std.text.same(type_, "application/pdf") { return "PDF" }
    if std.text.startsWith(type_, "text/") { return "Text" }
    if std.text.startsWith(type_, "image/") { return if german { "Bilder" } else { "Images" } }
    if std.text.startsWith(type_, "audio/") { return if german { "Musik" } else { "Music" } }
    if std.text.startsWith(type_, "video/") { return "Videos" }
    return if german { "Dateien dieser Art" } else { "Files of this kind" }
}

// The type of the file at `path` (NUL-terminated): inode/directory for a
// folder, else by its name, else by its first bytes (text/plain for text;
// application/octet-stream for anything else).
pub fn typeOf(path: [*]const u8) -> []const u8 {
    var status: std.fs.Stat = undefined
    if std.fs.status(path, &status) == 0 && (status.mode & 0o170000) == 0o040000 { return "inode/directory" }
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    var uncertain = false
    const named = mime.byName(mime.baseName(path[0..length]), &uncertain)
    if named.length > 0 { return named }
    var head: [512]u8 = undefined
    const bytes: [*]u8 = &head
    const got = std.fs.readFile(path, bytes, 512)
    if mime.isText(bytes[0..got]) { return "text/plain" }
    return "application/octet-stream"
}

// The system's choices: with brixOS's other settings; elsewhere (the
// compatibility path) under /etc.
fn systemPath() -> [*]const u8 {
    if comptime builtin.os == builtin.Os.brixos { return "/system/settings/defaults.conf\x00".pointer }
    return "/etc/mlx/defaults.conf\x00".pointer
}

// The user's file into `into` (NUL-terminated); its length, 0 without a
// home.
fn userPath(environment: [*][*]const u8, into: [*]u8, capacity: usize) -> usize {
    return xdg.path(environment, xdg.CONFIG, "/mlx/defaults.conf", into, capacity)
}

fn trimmed(text: []const u8) -> []const u8 {
    var from: usize = 0
    var to = text.length
    while from < to && (text[from] == 32 || text[from] == 9) { from += 1 }
    while to > from && (text[to - 1] == 32 || text[to - 1] == 9 || text[to - 1] == 13) { to -= 1 }
    return text[from..to]
}

// The app `text` (a defaults file) names for `key`, into `into`; its
// length (0: none).
fn idIn(text: []const u8, key: []const u8, into: [*]u8) -> usize {
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        at = end + 1
        var equals: usize = 0
        while equals < line.length && line[equals] != 61 { equals += 1 }
        if equals >= line.length || line.length == 0 || line[0] == 35 { continue }
        if !std.text.same(trimmed(line[0..equals]), key) { continue }
        const value = trimmed(line[equals + 1..line.length])
        var length: usize = 0
        while length < value.length && length < ID_CAPACITY {
            into[length] = value[length]
            length += 1
        }
        return length
    }
    return 0
}

// The kind of `type` ("text/*" of "text/plain") into `into`; its length.
fn kindOf(type_: []const u8, into: [*]u8) -> usize {
    var slash: usize = 0
    while slash < type_.length && type_[slash] != 47 { slash += 1 }
    if slash >= type_.length || slash + 2 > 60 { return 0 }
    var index: usize = 0
    while index <= slash {
        into[index] = type_[index]
        index += 1
    }
    into[index] = 42
    return index + 1
}

// The app chosen for `type` (the user's line for it, the user's for its
// kind, the system's for it, the system's for its kind) into `into`; its
// id's length (0: none chosen).
pub fn chosen(environment: [*][*]const u8, type_: []const u8, into: [*]u8) -> usize {
    var kind: [64]u8 = undefined
    const kind_bytes: [*]u8 = &kind
    const kind_length = kindOf(type_, kind_bytes)
    var text: [8192]u8 = undefined
    const text_bytes: [*]u8 = &text
    var path: [1024]u8 = undefined
    const path_bytes: [*]u8 = &path
    if userPath(environment, path_bytes, 1000) > 0 {
        const size = std.fs.readFile(path_bytes, text_bytes, FILE_CAPACITY)
        var length = idIn(text_bytes[0..size], type_, into)
        if length == 0 && kind_length > 0 { length = idIn(text_bytes[0..size], kind_bytes[0..kind_length], into) }
        if length > 0 { return length }
    }
    const size = std.fs.readFile(systemPath(), text_bytes, FILE_CAPACITY)
    var length = idIn(text_bytes[0..size], type_, into)
    if length == 0 && kind_length > 0 { length = idIn(text_bytes[0..size], kind_bytes[0..kind_length], into) }
    return length
}

// Makes `id` the user's app for `type` (a type, or a kind: "image/*"):
// its line in the user's defaults.conf, the others kept; false when it
// cannot be written.
pub fn choose(environment: [*][*]const u8, type_: []const u8, id: []const u8) -> bool {
    var path: [1024]u8 = undefined
    const path_bytes: [*]u8 = &path
    const path_length = userPath(environment, path_bytes, 1000)
    if path_length == 0 { return false }
    _ = std.fs.makeParents(path_bytes[0..path_length], 493)
    var old: [8192]u8 = undefined
    const old_bytes: [*]u8 = &old
    const size = std.fs.readFile(path_bytes, old_bytes, FILE_CAPACITY)
    var out: [8448]u8 = undefined
    const text: [*]u8 = &out
    var used: usize = 0
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && old_bytes[end] != 10 { end += 1 }
        const line = old_bytes[at..end]
        at = end + 1
        var equals: usize = 0
        while equals < line.length && line[equals] != 61 { equals += 1 }
        if equals < line.length && std.text.same(trimmed(line[0..equals]), type_) { continue }
        if line.length == 0 || used + line.length + 1 > 8000 { continue }
        used = std.text.append(text, used, 8000, line)
        used = std.text.append(text, used, 8001, "\n")
    }
    if used == 0 { used = std.text.append(text, 0, 8000, "# The default apps (Control: Apps; Polaris: Always open with): TYPE = APP_ID.\n") }
    used = std.text.append(text, used, 8300, type_)
    used = std.text.append(text, used, 8300, " = ")
    used = std.text.append(text, used, 8400, id)
    used = std.text.append(text, used, 8401, "\n")
    return std.fs.replaceFile(path_bytes, text, used, 420)
}

// The apps that take `type`, the best first (those naming it, then those
// naming its kind; bundles before desktop entries), into `into` (indices
// in `apps`, at most `capacity`); their count.
pub fn candidates(apps: *Apps, type_: []const u8, into: [*]usize, capacity: usize) -> usize {
    var count: usize = 0
    var pass: usize = 0
    while pass < 4 {
        // 0: named, bundle; 1: named, entry; 2: kind, bundle; 3: kind, entry.
        const want: u8 = if pass < 2 { 2 } else { 1 }
        const bundle = pass % 2 == 0
        var index: usize = 0
        while index < apps.*.count && count < capacity {
            const app = apps_module.appAt(apps, index)
            if app.*.bundle == bundle && apps_module.takesType(app, type_) == want {
                into[count] = index
                count += 1
            }
            index += 1
        }
        pass += 1
    }
    return count
}

// The index in `apps` of the app that opens files of `type`: the one
// chosen, else the best that takes it; apps.count when none does.
pub fn appFor(apps: *Apps, environment: [*][*]const u8, type_: []const u8) -> usize {
    var id: [96]u8 = undefined
    const id_bytes: [*]u8 = &id
    const length = chosen(environment, type_, id_bytes)
    if length > 0 {
        const found = apps_module.find(apps, id_bytes[0..length])
        if found < apps.*.count { return found }
    }
    var best: [1]usize = undefined
    const best_bytes: [*]usize = &best
    if candidates(apps, type_, best_bytes, 1) == 1 { return best[0] }
    return apps.*.count
}

// Opens the file at `path` (NUL-terminated) with its default app; off
// brixOS, one no app of ours takes goes to xdg-open. False when nothing
// opens it.
pub fn open(apps: *Apps, environment: [*][*]const u8, path: [*]const u8, terminal: [*]const u8) -> bool {
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    const index = appFor(apps, environment, typeOf(path))
    if index < apps.*.count {
        apps_module.launchWith(apps_module.appAt(apps, index), path[0..length], terminal, environment)
        return true
    }
    if comptime builtin.os == builtin.Os.brixos { return false }
    var line: apps_module.Path = undefined
    apps_module.pathClear(&line)
    apps_module.pathAdd(&line, "xdg-open '")
    for byte in path[0..length] {
        if byte == 39 { apps_module.pathAdd(&line, "'\\''") } else if line.length < 1020 {
            line.bytes[line.length] = byte
            line.length += 1
        }
    }
    apps_module.pathAdd(&line, "'")
    const none: [*]const u8 = unsafe { @ptrFromInt([*]const u8, 0) }
    apps_module.run(line.bytes[0..line.length], none, environment)
    return true
}
