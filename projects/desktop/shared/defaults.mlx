// The default apps: which app opens a file, by its name's extension. No
// list of kinds can know every extension that lands on the system, so the
// user decides each one when it first comes: a file whose extension has
// no app is opened through Polaris's Open with popup, whose "Always use
// for .EXT files" makes its choice the default. The desktop's own (brixOS
// has no xdg-open, and our apps need none): the choices are lines
// ".EXT = APP_ID" ("." alone: files without an extension) in the user's
// $XDG_CONFIG_HOME/mlx/defaults.conf, over the system's
// (/system/settings/defaults.conf on brixOS, /etc/mlx/defaults.conf
// elsewhere). The apps the popup recommends are those whose bundle says
// it takes the file's type (MimeType= in app.ini: naming the type, then
// its kind, "text/*"); Control's Apps page lists the extensions chosen,
// to change or forget them.
//
//     const index = defaults.appForFile(&apps, environment, path)   // apps.count: ask
//     defaults.choose(environment, defaults.extensionOf(name), "org.mlx.comet")
const std = @import("std")
const builtin = @import("builtin")
const xdg = @import("std.xdg")
const mime = @import("std.http.mime")
const apps_module = @import("./apps.mlx")

const Apps = apps_module.Apps

pub const ID_CAPACITY: usize = 96
pub const EXTENSION_CAPACITY: usize = 24
const FILE_CAPACITY: usize = 8192

// The extension of `name` (a file's name or path), with its dot: ".md",
// "." for a name without one (a leading dot alone, ".bashrc", is none);
// written lowercase into `into` (EXTENSION_CAPACITY bytes); its length.
pub fn extensionOf(name: []const u8, into: [*]u8) -> usize {
    var start = name.length
    while start > 0 && name[start - 1] != 47 { start -= 1 }
    const base = name[start..name.length]
    var dot = base.length
    while dot > 0 && base[dot - 1] != 46 { dot -= 1 }
    if dot <= 1 || base.length - dot + 1 >= EXTENSION_CAPACITY {
        into[0] = 46
        return 1
    }
    var length: usize = 0
    var at = dot - 1
    while at < base.length {
        const byte = base[at]
        into[length] = if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
        length += 1
        at += 1
    }
    return length
}

// The type of the file at `path` (NUL-terminated): inode/directory for a
// folder, else by its name, else by its first bytes (text/plain for text;
// application/octet-stream for anything else). It ranks the apps the
// popup offers.
pub fn typeOf(path: [*]const u8) -> []const u8 {
    var status: std.fs.Stat = undefined
    if std.fs.status(path, &status) == 0 && (status.mode & 0o170000) == 0o040000 { return "inode/directory" }
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    var uncertain = false
    const named = mime.byName(mime.baseName(path[0..length]), &uncertain)
    if named.length > 0 { return named }
    var head: [512]u8 = undefined
    const bytes: [*]u8 = &head
    const got = std.fs.readFile(path, bytes, 512)
    if mime.isText(bytes[0..got]) { return "text/plain" }
    return "application/octet-stream"
}

// The system's choices: with brixOS's other settings; elsewhere (the
// compatibility path) under /etc.
pub fn systemPath() -> [*]const u8 {
    if comptime builtin.os == builtin.Os.brixos { return "/system/settings/defaults.conf\x00".pointer }
    return "/etc/mlx/defaults.conf\x00".pointer
}

// The user's file into `into` (NUL-terminated); its length, 0 without a
// home.
pub fn userPath(environment: [*][*]const u8, into: [*]u8, capacity: usize) -> usize {
    return xdg.path(environment, xdg.CONFIG, "/mlx/defaults.conf", into, capacity)
}

pub fn trimmed(text: []const u8) -> []const u8 {
    var from: usize = 0
    var to = text.length
    while from < to && (text[from] == 32 || text[from] == 9) { from += 1 }
    while to > from && (text[to - 1] == 32 || text[to - 1] == 9 || text[to - 1] == 13) { to -= 1 }
    return text[from..to]
}

// A line of a defaults file: its key and its app (false: a comment, a
// blank line or one without "=").
pub fn splitLine(line: []const u8, key: *[]const u8, id: *[]const u8) -> bool {
    var equals: usize = 0
    while equals < line.length && line[equals] != 61 { equals += 1 }
    if equals >= line.length || trimmed(line).length == 0 || trimmed(line)[0] == 35 { return false }
    key.* = trimmed(line[0..equals])
    id.* = trimmed(line[equals + 1..line.length])
    return key.*.length > 0 && id.*.length > 0
}

// The app `text` (a defaults file) names for `key`, into `into`; its
// length (0: none).
fn idIn(text: []const u8, wanted: []const u8, into: [*]u8) -> usize {
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        at = end + 1
        var key: []const u8 = ""
        var id: []const u8 = ""
        if !splitLine(line, &key, &id) || !std.text.same(key, wanted) { continue }
        var length: usize = 0
        while length < id.length && length < ID_CAPACITY {
            into[length] = id[length]
            length += 1
        }
        return length
    }
    return 0
}

// The app chosen for `extension` (the user's line, else the system's)
// into `into`; its id's length (0: none chosen). `mine` says whether it
// is the user's.
pub fn chosen(environment: [*][*]const u8, extension: []const u8, into: [*]u8, mine: *bool) -> usize {
    var text: [8192]u8 = undefined
    const text_bytes: [*]u8 = &text
    var path: [1024]u8 = undefined
    const path_bytes: [*]u8 = &path
    mine.* = false
    if userPath(environment, path_bytes, 1000) > 0 {
        const size = std.fs.readFile(path_bytes, text_bytes, FILE_CAPACITY)
        const length = idIn(text_bytes[0..size], extension, into)
        if length > 0 {
            mine.* = true
            return length
        }
    }
    const size = std.fs.readFile(systemPath(), text_bytes, FILE_CAPACITY)
    return idIn(text_bytes[0..size], extension, into)
}

// Writes the user's file again: its lines but `extension`'s, and
// `extension = id` when `id` is not empty; false when it cannot be
// written.
fn rewrite(environment: [*][*]const u8, extension: []const u8, id: []const u8) -> bool {
    var path: [1024]u8 = undefined
    const path_bytes: [*]u8 = &path
    const path_length = userPath(environment, path_bytes, 1000)
    if path_length == 0 { return false }
    _ = std.fs.makeParents(path_bytes[0..path_length], 493)
    var old: [8192]u8 = undefined
    const old_bytes: [*]u8 = &old
    const size = std.fs.readFile(path_bytes, old_bytes, FILE_CAPACITY)
    var out: [8448]u8 = undefined
    const text: [*]u8 = &out
    var used: usize = 0
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && old_bytes[end] != 10 { end += 1 }
        const line = old_bytes[at..end]
        at = end + 1
        var key: []const u8 = ""
        var value: []const u8 = ""
        if splitLine(line, &key, &value) && std.text.same(key, extension) { continue }
        if line.length == 0 || used + line.length + 1 > 8000 { continue }
        used = std.text.append(text, used, 8000, line)
        used = std.text.append(text, used, 8001, "\n")
    }
    if used == 0 { used = std.text.append(text, 0, 8000, "# The default apps by extension (Polaris: Open with; Control: Apps): .EXT = APP_ID.\n") }
    if id.length > 0 {
        used = std.text.append(text, used, 8300, extension)
        used = std.text.append(text, used, 8300, " = ")
        used = std.text.append(text, used, 8400, id)
        used = std.text.append(text, used, 8401, "\n")
    }
    return std.fs.replaceFile(path_bytes, text, used, 420)
}

// Makes `id` the user's app for files ending in `extension`.
pub fn choose(environment: [*][*]const u8, extension: []const u8, id: []const u8) -> bool {
    if id.length == 0 { return false }
    return rewrite(environment, extension, id)
}

// Forgets the user's app for `extension` (the system's, if it has one,
// counts again).
pub fn forget(environment: [*][*]const u8, extension: []const u8) -> bool { return rewrite(environment, extension, "") }

// The apps for a file of `type`, into `into` (indices in `apps`, at most
// `capacity`): those that take it first, the best first (naming it, then
// its kind; bundles before desktop entries), then every other app by
// name. Their count; `recommended` gets how many take it.
pub fn ranked(apps: *Apps, type_: []const u8, into: [*]usize, capacity: usize, recommended: *usize) -> usize {
    var count: usize = 0
    var pass: usize = 0
    while pass < 4 {
        // 0: named, bundle; 1: named, entry; 2: kind, bundle; 3: kind, entry.
        const want: u8 = if pass < 2 { 2 } else { 1 }
        const bundle = pass % 2 == 0
        var index: usize = 0
        while index < apps.*.count && count < capacity {
            const app = apps_module.appAt(apps, index)
            if app.*.bundle == bundle && apps_module.takesType(app, type_) == want {
                into[count] = index
                count += 1
            }
            index += 1
        }
        pass += 1
    }
    recommended.* = count
    var index: usize = 0
    while index < apps.*.count && count < capacity {
        if apps_module.takesType(apps_module.appAt(apps, index), type_) == 0 {
            into[count] = index
            count += 1
        }
        index += 1
    }
    return count
}

// The index in `apps` of the app chosen for the file at `path` (its
// extension's, an installed app); apps.count when none is: the user is
// asked.
pub fn appForFile(apps: *Apps, environment: [*][*]const u8, path: []const u8) -> usize {
    var extension: [24]u8 = undefined
    const extension_bytes: [*]u8 = &extension
    const extension_length = extensionOf(path, extension_bytes)
    var id: [96]u8 = undefined
    const id_bytes: [*]u8 = &id
    var mine = false
    const length = chosen(environment, extension_bytes[0..extension_length], id_bytes, &mine)
    if length == 0 { return apps.*.count }
    return apps_module.find(apps, id_bytes[0..length])
}
