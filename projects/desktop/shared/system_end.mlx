// Asking for the machine to be restarted or shut down, as a program of the
// desktop does: the compositor for its session (the top bar's session
// menu), the greeter at the login screen. The request goes to the login
// service (sentinel: org.mlx.Login on the system bus, in MLXIPC's own
// format, std.ipc), which decides who may (the user who holds the seat:
// projects/desktop/login/power.mlx) and has the init end the system. The
// asker needs no right of its own, and gets none. Before something is
// given up for the request (a session's windows), `may` asks whether it
// would be done at all.
//
//     if system_end.may(environment) != system_end.ACCEPTED { ... nothing is given up ... }
//     if system_end.ask(environment, system_end.RESTART) == system_end.ACCEPTED { ... the session ends ... }
const std = @import("std")
const ipc = @import("std.ipc")

// What is asked for.
pub const RESTART: u8 = 1
pub const SHUT_DOWN: u8 = 2

// The answer: the login service does it; it says this asker may not; or
// there was no answer (no bus, no login service on it).
pub const ACCEPTED: u8 = 0
pub const REFUSED: u8 = 1
pub const UNAVAILABLE: u8 = 2

pub const NAME: []const u8 = "org.mlx.Login"
pub const PATH: []const u8 = "/org/mlx/Login"
pub const INTERFACE: []const u8 = "org.mlx.Login"
const DENIED: []const u8 = "org.freedesktop.DBus.Error.AccessDenied"
// The login service asks the bus about the caller before it answers
// (milliseconds).
const PATIENCE: isize = 10000

// The login service's method for `kind`, and the one that only answers
// whether it would do either for this asker.
pub fn member(kind: u8) -> []const u8 { return if kind == RESTART { "Restart" } else { "PowerOff" } }
pub const MAY: []const u8 = "MayEndSystem"

// Asks on `client`, a connection to the system bus the asker has.
pub fn askOn(client: *ipc.Client, kind: u8) -> u8 { return callOn(client, member(kind)) }

// One of the login service's methods (they all answer with a boolean)
// called on `client`.
fn callOn(client: *ipc.Client, method: []const u8) -> u8 {
    const serial = ipc.call(client, NAME, PATH, INTERFACE, method, "", ipc.nothingBody(), 0)
    var reply: ipc.Message = undefined
    if serial == 0 || !ipc.waitReply(client, serial, &reply, PATIENCE) { return UNAVAILABLE }
    if reply.kind == ipc.ERROR { return if std.text.same(reply.errorName, DENIED) { REFUSED } else { UNAVAILABLE } }
    if reply.kind != ipc.REPLY || !std.text.same(reply.signature, "b") { return UNAVAILABLE }
    var reading = ipc.reader(ipc.bodyOf(client, &reply), reply.bodyLength)
    const taken = ipc.readBool(&reading)
    if reading.failed { return UNAVAILABLE }
    return if taken { ACCEPTED } else { REFUSED }
}

// Asks on a connection of its own to the system bus `environment` names
// (DBUS_SYSTEM_BUS_ADDRESS, else MLXIPC's).
pub fn ask(environment: [*][*]const u8, kind: u8) -> u8 { return call(environment, member(kind)) }

// Whether the login service would restart the machine or shut it down
// for this asker, with nothing done: ACCEPTED, REFUSED (this asker may
// not) or UNAVAILABLE (no login service answers, or it has no init to
// ask).
pub fn may(environment: [*][*]const u8) -> u8 { return call(environment, MAY) }

fn call(environment: [*][*]const u8, method: []const u8) -> u8 {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(ipc.Client), 16)
    if memory == null { return UNAVAILABLE }
    var client: *ipc.Client = undefined
    unsafe { client = @ptrCast(*ipc.Client, memory.?) }
    var answer = UNAVAILABLE
    if ipc.connectClient(client, allocator, ipc.systemPath(environment, ipc.MLX_SYSTEM_BUS)) {
        answer = callOn(client, method)
        ipc.disconnect(client, allocator)
    }
    allocator.free(memory.?, @sizeOf(ipc.Client), 16)
    return answer
}
