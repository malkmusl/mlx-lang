// One setting of a "key = value" file under $XDG_CONFIG_HOME/mlx
// (~/.config/mlx), read or changed on its own: the top bar's control
// centre turns night light on and off in compositor.conf this way, the
// rest of the file as it was (the compositor reads it again within half a
// second), and the portal keeps the look in appearance.conf. The file is
// written whole and renamed into place.
const std = @import("std")
const apps_module = @import("./apps.mlx")
const pins = @import("./pins.mlx")

const Path = apps_module.Path

const CAPACITY: usize = 16384

// The key of a "key = value" line (empty for a comment or another line).
fn keyOf(line: []const u8) -> []const u8 {
    const text = std.text.trimmed(line)
    if text.length == 0 || text[0] == 35 { return text[0..0] }
    var equals: usize = 0
    while equals < text.length && text[equals] != 61 { equals += 1 }
    if equals == text.length { return text[0..0] }
    return std.text.trimmed(text[0..equals])
}

fn valueOf(line: []const u8) -> []const u8 {
    const text = std.text.trimmed(line)
    var equals: usize = 0
    while equals < text.length && text[equals] != 61 { equals += 1 }
    if equals >= text.length { return text[0..0] }
    return std.text.trimmed(text[equals + 1..text.length])
}

// 1 when `key` in file `name` says `wanted`, 0 when it says another
// value, 2 when the file does not have it.
fn says(environment: [*][*]const u8, name: []const u8, key: []const u8, wanted: []const u8, allocator: std.allocator.Allocator) -> u32 {
    var file_path: Path = undefined
    if !pins.path(environment, name, &file_path) { return 2 }
    const loaded = std.fs.readFileAlloc(apps_module.pathEnd(&file_path), allocator)
    if loaded == null { return 2 }
    const contents = loaded.?
    const text = contents.items[0..contents.length]
    var result: u32 = 2
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[start..end]
        if apps_module.sameText(keyOf(line), key) { result = if apps_module.sameText(valueOf(line), wanted) { 1 } else { 0 } }
        start = end + 1
    }
    std.fs.ArrayList.deinit(contents)
    return result
}

// Whether `key` in file `name` says "on" (`fallback` without it).
pub fn isOn(environment: [*][*]const u8, name: []const u8, key: []const u8, fallback: bool, allocator: std.allocator.Allocator) -> bool {
    const answer = says(environment, name, key, "on", allocator)
    return if answer == 2 { fallback } else { answer == 1 }
}

// Whether `key` in file `name` says `wanted` (false without it).
pub fn equals(environment: [*][*]const u8, name: []const u8, key: []const u8, wanted: []const u8, allocator: std.allocator.Allocator) -> bool {
    return says(environment, name, key, wanted, allocator) == 1
}

fn add(text: [*]u8, at: usize, part: []const u8) -> usize {
    var length = at
    for byte in part {
        if length < CAPACITY {
            text[length] = byte
            length += 1
        }
    }
    return length
}

// Sets `key` in file `name` to `value` (its line replaced, else added at
// the end); false when the file could not be written.
pub fn set(environment: [*][*]const u8, name: []const u8, key: []const u8, value: []const u8, allocator: std.allocator.Allocator) -> bool {
    var file_path: Path = undefined
    if !pins.path(environment, name, &file_path) { return false }
    const memory = allocator.alloc(CAPACITY, 16)
    if memory == null { return false }
    const text = memory.?
    var length: usize = 0
    var found = false
    const loaded = std.fs.readFileAlloc(apps_module.pathEnd(&file_path), allocator)
    if loaded != null {
        const contents = loaded.?
        const old = contents.items[0..contents.length]
        var start: usize = 0
        while start < old.length {
            var end = start
            while end < old.length && old[end] != 10 { end += 1 }
            const line = old[start..end]
            if apps_module.sameText(keyOf(line), key) {
                length = add(text, length, key)
                length = add(text, length, " = ")
                length = add(text, length, value)
                found = true
            } else {
                length = add(text, length, line)
            }
            length = add(text, length, "\n")
            start = end + 1
        }
        std.fs.ArrayList.deinit(contents)
    }
    // The folders above it (~/.config, ~/.config/mlx) may not be there yet.
    _ = std.fs.makeParents(file_path.bytes[0..file_path.length], 493)
    if !found {
        length = add(text, length, key)
        length = add(text, length, " = ")
        length = add(text, length, value)
        length = add(text, length, "\n")
    }
    const written = length < CAPACITY && std.fs.replaceFile(apps_module.pathEnd(&file_path), text, length, 420)
    allocator.free(text, CAPACITY, 16)
    return written
}
