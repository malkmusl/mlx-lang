// The desktop's dates and times as text: the top bar's clock and the file
// manager's dates, with German names when the desktop's language is German
// (the language mlx-settings chose, else LC_ALL, LC_TIME, LANG), else
// English. The time itself is std.timezone's.
const std = @import("std")
const timezone = @import("std.timezone")

fn put(out: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        out[index] = byte
        index += 1
    }
    return index
}

fn putNumber(out: [*]u8, at: usize, value: i64, width: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { -value } else { value }
    while rest > 0 || count < width {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var index = at
    while count > 0 {
        count -= 1
        out[index] = digits[count]
        index += 1
    }
    return index
}

fn weekdayName(weekday: i64, german: bool) -> []const u8 {
    if german {
        return match weekday { 0 => "So.", 1 => "Mo.", 2 => "Di.", 3 => "Mi.", 4 => "Do.", 5 => "Fr.", else => "Sa." }
    }
    return match weekday { 0 => "Sun", 1 => "Mon", 2 => "Tue", 3 => "Wed", 4 => "Thu", 5 => "Fri", else => "Sat" }
}

fn monthName(month: i64, german: bool) -> []const u8 {
    if german {
        return match month { 1 => "Jan.", 2 => "Feb.", 3 => "März", 4 => "Apr.", 5 => "Mai", 6 => "Juni", 7 => "Juli", 8 => "Aug.", 9 => "Sep.", 10 => "Okt.", 11 => "Nov.", else => "Dez." }
    }
    return match month { 1 => "Jan", 2 => "Feb", 3 => "Mar", 4 => "Apr", 5 => "May", 6 => "Jun", 7 => "Jul", 8 => "Aug", 9 => "Sep", 10 => "Oct", 11 => "Nov", else => "Dec" }
}

// The language chosen in mlx-settings (language = de, en or system in
// $XDG_CONFIG_HOME/mlx/compositor.conf).
pub const LANGUAGE_SYSTEM: u8 = 0
pub const LANGUAGE_GERMAN: u8 = 1
pub const LANGUAGE_ENGLISH: u8 = 2

pub fn chosenLanguage(environment: [*][*]const u8) -> u8 {
    var path: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var length: usize = 0
    const config = std.process.environmentFrom(environment, "XDG_CONFIG_HOME")
    if config != null && config.?.length > 0 {
        length = put(bytes, 0, config.?.pointer[0..config.?.length])
    } else {
        const home = std.process.environmentFrom(environment, "HOME")
        if home == null || home.?.length == 0 || home.?.length > 400 { return LANGUAGE_SYSTEM }
        length = put(bytes, 0, home.?.pointer[0..home.?.length])
        length = put(bytes, length, "/.config")
    }
    if length > 460 { return LANGUAGE_SYSTEM }
    length = put(bytes, length, "/mlx/compositor.conf")
    bytes[length] = 0
    const file = std.fs.open(bytes, 0, 0)
    if !std.fs.isValid(file) { return LANGUAGE_SYSTEM }
    var buffer: [4096]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    const read = std.fs.read(file, text, 4096)
    const closed = std.fs.close(file)
    if read <= 0 { return LANGUAGE_SYSTEM }
    const size = @intCast(usize, read)
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[at..end])
        if line.length > 8 && std.text.same(line[0..8], "language") {
            var equals: usize = 8
            while equals < line.length && line[equals] != 61 { equals += 1 }
            if equals < line.length {
                const value = std.text.trimmed(line[equals + 1..line.length])
                if std.text.same(value, "de") { return LANGUAGE_GERMAN }
                if std.text.same(value, "en") { return LANGUAGE_ENGLISH }
            }
        }
        at = end + 1
    }
    return LANGUAGE_SYSTEM
}

// Whether the locale's language (LC_ALL, LC_TIME, LANG) is German.
pub fn systemGerman(environment: [*][*]const u8) -> bool {
    const all = std.process.environmentFrom(environment, "LC_ALL")
    if all != null && all.?.length > 0 { return isGerman(all.?) }
    const time = std.process.environmentFrom(environment, "LC_TIME")
    if time != null && time.?.length > 0 { return isGerman(time.?) }
    const language = std.process.environmentFrom(environment, "LANG")
    return language != null && isGerman(language.?)
}

// Whether the desktop's language is German: chosen in mlx-settings, else
// the locale's.
pub fn germanLocale(environment: [*][*]const u8) -> bool {
    const chosen = chosenLanguage(environment)
    if chosen != LANGUAGE_SYSTEM { return chosen == LANGUAGE_GERMAN }
    return systemGerman(environment)
}

fn isGerman(locale: std.string.String) -> bool {
    return locale.length >= 2 && locale.pointer[0] == 100 && locale.pointer[1] == 101
}

// The date and time as the top bar shows them ("So. 27. Sep. 16:05" or
// "Sun 27 Sep 16:05") into `out` (at least 32 bytes); its length.
pub fn format(time: *const timezone.Civil, german: bool, out: [*]u8) -> usize {
    var length = put(out, 0, weekdayName(time.*.weekday, german))
    length = put(out, length, " ")
    length = putNumber(out, length, time.*.day, 1)
    if german { length = put(out, length, ".") }
    length = put(out, length, " ")
    length = put(out, length, monthName(time.*.month, german))
    length = put(out, length, "  ")
    length = putNumber(out, length, time.*.hour, 2)
    length = put(out, length, ":")
    return putNumber(out, length, time.*.minute, 2)
}

// A file's time as the file manager lists it: "Today, 16:05" ("Heute,
// 16:05"), "Yesterday, 16:05" ("Gestern, 16:05"), else "27 Sep 2026,
// 16:05" ("27. Sep. 2026, 16:05"); `days`: how many days ago it was (0
// today). Into `out` (at least 32 bytes); its length.
pub fn formatDate(time: *const timezone.Civil, days: i64, german: bool, out: [*]u8) -> usize {
    var length: usize = 0
    if days == 0 {
        length = put(out, 0, if german { "Heute" } else { "Today" })
    } else if days == 1 {
        length = put(out, 0, if german { "Gestern" } else { "Yesterday" })
    } else {
        length = putNumber(out, 0, time.*.day, 1)
        if german { length = put(out, length, ".") }
        length = put(out, length, " ")
        length = put(out, length, monthName(time.*.month, german))
        length = put(out, length, " ")
        length = putNumber(out, length, time.*.year, 4)
    }
    length = put(out, length, ", ")
    length = putNumber(out, length, time.*.hour, 2)
    length = put(out, length, ":")
    return putNumber(out, length, time.*.minute, 2)
}
