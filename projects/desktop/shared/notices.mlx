// The notifications the desktop keeps: mlx-notifyd holds them, the top
// bar's control centre shows them, both on MLXIPC (the session bus):
// org.mlx.Notifications.List() on org.freedesktop.Notifications answers
// with SIGNATURE, whether Do Not Disturb is on, how many are unread and
// the notifications newest first, each (id, app name, summary, body,
// icon, time in seconds since 1970); its Changed() signal says the list
// changed. Tabs and line ends inside a field become spaces.
const std = @import("std")
const dbus = @import("std.dbus")

pub const SIGNATURE: []const u8 = "bua(ussssx)"
pub const MAX: usize = 32
const APP: usize = 48
const SUMMARY: usize = 96
const BODY: usize = 240
const ICON: usize = 128

pub const Notice = struct {
    id: u32
    time: i64
    app: [48]u8
    appLength: usize
    summary: [96]u8
    summaryLength: usize
    body: [240]u8
    bodyLength: usize
    icon: [128]u8
    iconLength: usize
}

pub const Notices = struct {
    count: usize
    dnd: bool
    unread: usize
    items: [32]Notice
}

pub fn at(notices: *Notices, index: usize) -> *Notice {
    unsafe { return @ptrFromInt(*Notice, @intFromPtr(notices) + @offsetOf(Notices, "items") + index * @sizeOf(Notice)) }
}

fn field(notice: *const Notice, offset: usize, length: usize) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(notice) + offset) }
    return bytes[0..length]
}

pub fn appOf(notice: *const Notice) -> []const u8 { return field(notice, @offsetOf(Notice, "app"), notice.*.appLength) }
pub fn summaryOf(notice: *const Notice) -> []const u8 { return field(notice, @offsetOf(Notice, "summary"), notice.*.summaryLength) }
pub fn bodyOf(notice: *const Notice) -> []const u8 { return field(notice, @offsetOf(Notice, "body"), notice.*.bodyLength) }
pub fn iconOf(notice: *const Notice) -> []const u8 { return field(notice, @offsetOf(Notice, "icon"), notice.*.iconLength) }

// Copies `text` into the field at `offset` (`capacity` bytes), tabs and
// line ends as spaces, cut at a character's start; its length.
fn keep(notice: *Notice, offset: usize, capacity: usize, text: []const u8) -> usize {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrFromInt([*]u8, @intFromPtr(notice) + offset) }
    var length = if text.length < capacity { text.length } else { capacity }
    // Not in the middle of a UTF-8 sequence.
    while length > 0 && length < text.length && (text[length] & 192) == 128 { length -= 1 }
    var index: usize = 0
    while index < length {
        const byte = text[index]
        bytes[index] = if byte == 9 || byte == 10 || byte == 13 { 32 } else { byte }
        index += 1
    }
    return length
}

// Fills `notice` in.
pub fn set(notice: *Notice, id: u32, time: i64, app: []const u8, summary: []const u8, body: []const u8, icon: []const u8) -> void {
    notice.*.id = id
    notice.*.time = time
    notice.*.appLength = keep(notice, @offsetOf(Notice, "app"), APP, app)
    notice.*.summaryLength = keep(notice, @offsetOf(Notice, "summary"), SUMMARY, summary)
    notice.*.bodyLength = keep(notice, @offsetOf(Notice, "body"), BODY, body)
    notice.*.iconLength = keep(notice, @offsetOf(Notice, "icon"), ICON, icon)
}

pub fn clear(notices: *Notices) -> void {
    notices.*.count = 0
    notices.*.unread = 0
}

// The index of notification `id` (count: none).
pub fn find(notices: *Notices, id: u32) -> usize {
    var index: usize = 0
    while index < notices.*.count {
        if at(notices, index).*.id == id { return index }
        index += 1
    }
    return notices.*.count
}

// Room for a new one at the front (the oldest falls off); it is returned.
pub fn push(notices: *Notices) -> *Notice {
    var index = if notices.*.count < MAX { notices.*.count } else { MAX - 1 }
    while index > 0 {
        at(notices, index).* = at(notices, index - 1).*
        index -= 1
    }
    if notices.*.count < MAX { notices.*.count += 1 }
    return at(notices, 0)
}

pub fn remove(notices: *Notices, index: usize) -> void {
    if index >= notices.*.count { return }
    var moving = index
    while moving + 1 < notices.*.count {
        at(notices, moving).* = at(notices, moving + 1).*
        moving += 1
    }
    notices.*.count -= 1
    if notices.*.unread > notices.*.count { notices.*.unread = notices.*.count }
}

// The list into `writing` as SIGNATURE.
pub fn put(writing: *dbus.Writer, notices: *Notices) -> void {
    dbus.putBool(writing, notices.*.dnd)
    dbus.putU32(writing, @intCast(u32, notices.*.unread))
    const list = dbus.beginArray(writing, 8)
    var index: usize = 0
    while index < notices.*.count {
        const notice = at(notices, index)
        dbus.pad(writing, 8)
        dbus.putU32(writing, notice.*.id)
        dbus.putString(writing, appOf(notice))
        dbus.putString(writing, summaryOf(notice))
        dbus.putString(writing, bodyOf(notice))
        dbus.putString(writing, iconOf(notice))
        dbus.pad(writing, 8)
        const time = @bitCast(u64, notice.*.time)
        dbus.putU32(writing, @intCast(u32, time & 4294967295))
        dbus.putU32(writing, @intCast(u32, time >> 32))
        index += 1
    }
    dbus.endArray(writing, list, 8)
}

fn readI64(reading: *dbus.Reader) -> i64 {
    dbus.alignTo(reading, 8)
    const first = @intCast(u64, dbus.readU32(reading))
    const second = @intCast(u64, dbus.readU32(reading))
    return @bitCast(i64, if reading.*.big { (first << 32) | second } else { (second << 32) | first })
}

// The list from a reply of SIGNATURE (false when it is not one).
pub fn take(reading: *dbus.Reader, notices: *Notices) -> bool {
    clear(notices)
    notices.*.dnd = dbus.readBool(reading)
    notices.*.unread = @intCast(usize, dbus.readU32(reading))
    const length = dbus.readU32(reading)
    dbus.alignTo(reading, 8)
    const end = reading.*.position + @intCast(usize, length)
    while reading.*.position < end && !reading.*.failed {
        dbus.alignTo(reading, 8)
        const id = dbus.readU32(reading)
        const app = dbus.readString(reading)
        const summary = dbus.readString(reading)
        const body = dbus.readString(reading)
        const icon = dbus.readString(reading)
        const time = readI64(reading)
        if reading.*.failed { break }
        if notices.*.count < MAX {
            set(at(notices, notices.*.count), id, time, app, summary, body, icon)
            notices.*.count += 1
        }
    }
    if notices.*.unread > notices.*.count { notices.*.unread = notices.*.count }
    return !reading.*.failed
}
