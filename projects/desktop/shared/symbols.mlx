// The desktop's symbols (the top bar's, its popups', the control
// centre's): a speaker, a battery, Wi-Fi, a network cable, a bell,
// toggles, a lock, log out, power, play and pause, previous and next,
// chevrons, a note, a moon and a sun, a clock, the tray's dots, the look
// (a circle half dark) and a camera. Each
// is drawn smooth with std.ui.vector on a 24 x 24 grid scaled to the size
// asked, once, into an image kept in a Cache, and then drawn as an image
// on any canvas (CPU or GPU).
//
// A symbol has a variant: the speaker's loudness (0 to 3, MUTED), the
// battery's charge (0 to 100, + CHARGING, + LOW), Wi-Fi's strength (0 to
// 4, OFF), the bell's NO_DISTURB.
const std = @import("std")
const png = @import("std.png")
const vector = @import("std.ui.vector")
const canvas_module = @import("std.ui.canvas")

const Allocator = std.allocator.Allocator
const Canvas = canvas_module.Canvas
const Shape = vector.Shape

pub const SPEAKER: u32 = 1
pub const BATTERY: u32 = 2
pub const WIFI: u32 = 3
pub const ETHERNET: u32 = 4
pub const BELL: u32 = 5
pub const TOGGLES: u32 = 6
pub const LOCK: u32 = 7
pub const LOG_OUT: u32 = 8
pub const POWER: u32 = 9
pub const PLAY: u32 = 10
pub const PAUSE: u32 = 11
pub const NEXT: u32 = 12
pub const PREVIOUS: u32 = 13
pub const CHEVRON_LEFT: u32 = 14
pub const CHEVRON_RIGHT: u32 = 15
pub const NOTE: u32 = 16
pub const MOON: u32 = 17
pub const SUN: u32 = 18
pub const MARK: u32 = 19
pub const OFFLINE: u32 = 20
pub const CHEVRON_DOWN: u32 = 21
pub const CLOSE: u32 = 22
pub const CHECK: u32 = 23
pub const CHEVRON_UP: u32 = 24
pub const CLOCK: u32 = 25
pub const TRAY: u32 = 26
pub const APPEARANCE: u32 = 27
pub const CAMERA: u32 = 28

// Variants.
pub const MUTED: u32 = 100
pub const CHARGING: u32 = 1000
pub const LOW: u32 = 2000
pub const OFF: u32 = 100
pub const NO_DISTURB: u32 = 1

const ENTRIES: usize = 64

pub const Entry = struct {
    key: u64
    image: png.Image
    capacity: usize
    used: usize
}

pub const Cache = struct {
    entries: [64]Entry
    clock: usize
    allocator: Allocator
    // An image was drawn anew where another was: GPU canvases must
    // forget the images they uploaded (std.ui.wayland.panel.forgetImages).
    replaced: bool
}

pub fn init(cache: *Cache, allocator: Allocator) -> void {
    cache.*.clock = 0
    cache.*.allocator = allocator
    cache.*.replaced = false
    var index: usize = 0
    while index < ENTRIES {
        const entry = entryAt(cache, index)
        entry.*.key = 0
        entry.*.capacity = 0
        entry.*.used = 0
        index += 1
    }
}

fn entryAt(cache: *Cache, index: usize) -> *Entry {
    unsafe { return @ptrFromInt(*Entry, @intFromPtr(cache) + @offsetOf(Cache, "entries") + index * @sizeOf(Entry)) }
}

fn keyOf(symbol: u32, variant: u32, size: usize, color: u32) -> u64 {
    return (@intCast(u64, symbol) << 56) | (@intCast(u64, variant & 65535) << 40) | (@intCast(u64, size & 255) << 32) | @intCast(u64, color)
}

// The symbol's image, drawn when it is not kept yet (null without
// memory). `color` is 0xAARRGGBB, not premultiplied.
pub fn image(cache: *Cache, symbol: u32, variant: u32, size: usize, color: u32) -> ?*png.Image {
    const key = keyOf(symbol, variant, size, color)
    cache.*.clock += 1
    var oldest: usize = 0
    var index: usize = 0
    while index < ENTRIES {
        const entry = entryAt(cache, index)
        if entry.*.key == key {
            entry.*.used = cache.*.clock
            unsafe { return @ptrCast(*png.Image, &entry.*.image) }
        }
        if entry.*.used < entryAt(cache, oldest).*.used { oldest = index }
        index += 1
    }
    const entry = entryAt(cache, oldest)
    if entry.*.key != 0 { cache.*.replaced = true }
    const bytes = size * size * 4
    if entry.*.capacity < bytes {
        if entry.*.capacity > 0 {
            unsafe { cache.*.allocator.free(@ptrCast([*]u8, entry.*.image.pixels), entry.*.capacity, 16) }
        }
        const memory = cache.*.allocator.alloc(bytes, 16)
        if memory == null {
            entry.*.capacity = 0
            entry.*.key = 0
            return null
        }
        unsafe { entry.*.image.pixels = @ptrCast([*]u32, memory.?) }
        entry.*.capacity = bytes
    }
    entry.*.image.width = size
    entry.*.image.height = size
    entry.*.image.allocator = cache.*.allocator
    var pixel: usize = 0
    while pixel < size * size {
        entry.*.image.pixels[pixel] = 0
        pixel += 1
    }
    entry.*.key = key
    entry.*.used = cache.*.clock
    var picture: *png.Image = undefined
    unsafe { picture = @ptrCast(*png.Image, &entry.*.image) }
    var shape: Shape = undefined
    if vector.begin(&shape, size, size, cache.*.allocator) {
        render(&shape, picture, symbol, variant, vector.toFloat(@intCast(i64, size)) / 24.0, color)
        vector.end(&shape)
    }
    return picture
}

// Draws the symbol at (x, y), `size` pixels square.
pub fn draw(cache: *Cache, canvas: *Canvas, symbol: u32, variant: u32, x: i32, y: i32, size: i32, color: u32) -> void {
    if size <= 0 { return }
    const picture = image(cache, symbol, variant, @intCast(usize, size), color)
    if picture == null { return }
    canvas_module.drawImage(canvas, picture.?, x, y, size, 255)
}

// ---------------------------------------------------------------------------
// The drawings, on a 24 x 24 grid times `k`.

// The colour with its alpha times `amount` / 255.
fn fade(color: u32, amount: u32) -> u32 { return (((color >> 24) & 255) * amount / 255 << 24) | (color & 16777215) }

fn dim(color: u32) -> u32 { return fade(color, 80) }

fn render(shape: *Shape, picture: *png.Image, symbol: u32, variant: u32, k: f64, color: u32) -> void {
    if symbol == SPEAKER { speaker(shape, picture, variant, k, color) }
    if symbol == BATTERY { battery(shape, picture, variant, k, color) }
    if symbol == WIFI { wifi(shape, picture, variant, k, color) }
    if symbol == ETHERNET { ethernet(shape, picture, k, color) }
    if symbol == OFFLINE { offline(shape, picture, k, color) }
    if symbol == BELL { bell(shape, picture, variant, k, color) }
    if symbol == TOGGLES { toggles(shape, picture, k, color) }
    if symbol == LOCK { lock(shape, picture, k, color) }
    if symbol == LOG_OUT { logOut(shape, picture, k, color) }
    if symbol == POWER { power(shape, picture, k, color) }
    if symbol == PLAY { vector.triangle(shape, 7.0 * k, 4.5 * k, 7.0 * k, 19.5 * k, 19.5 * k, 12.0 * k) }
    if symbol == PAUSE {
        vector.roundedRect(shape, 6.0 * k, 4.5 * k, 4.2 * k, 15.0 * k, 1.2 * k)
        vector.roundedRect(shape, 13.8 * k, 4.5 * k, 4.2 * k, 15.0 * k, 1.2 * k)
    }
    if symbol == NEXT || symbol == PREVIOUS { skip(shape, symbol == PREVIOUS, k) }
    if symbol == CHEVRON_LEFT { chevron(shape, 15.0, 6.0, 9.0, 12.0, 15.0, 18.0, k) }
    if symbol == CHEVRON_RIGHT { chevron(shape, 9.0, 6.0, 15.0, 12.0, 9.0, 18.0, k) }
    if symbol == CHEVRON_DOWN { chevron(shape, 6.0, 9.0, 12.0, 15.0, 18.0, 9.0, k) }
    if symbol == CHEVRON_UP { chevron(shape, 6.0, 15.0, 12.0, 9.0, 18.0, 15.0, k) }
    if symbol == CLOSE {
        vector.line(shape, 6.5 * k, 6.5 * k, 17.5 * k, 17.5 * k, 2.0 * k, true)
        vector.paint(shape, picture, color)
        vector.line(shape, 17.5 * k, 6.5 * k, 6.5 * k, 17.5 * k, 2.0 * k, true)
    }
    if symbol == CHECK {
        vector.line(shape, 5.5 * k, 12.5 * k, 10.0 * k, 17.0 * k, 2.2 * k, true)
        vector.paint(shape, picture, color)
        vector.line(shape, 10.0 * k, 17.0 * k, 18.5 * k, 7.0 * k, 2.2 * k, true)
    }
    if symbol == NOTE { note(shape, picture, k, color) }
    if symbol == CLOCK {
        vector.ring(shape, 12.0 * k, 12.0 * k, 9.0 * k, 2.0 * k)
        vector.paint(shape, picture, color)
        vector.line(shape, 12.0 * k, 12.0 * k, 12.0 * k, 7.0 * k, 2.0 * k, true)
        vector.paint(shape, picture, color)
        vector.line(shape, 12.0 * k, 12.0 * k, 15.5 * k, 14.0 * k, 2.0 * k, true)
    }
    if symbol == TRAY {
        vector.circle(shape, 5.0 * k, 12.0 * k, 2.4 * k)
        vector.paint(shape, picture, color)
        vector.circle(shape, 12.0 * k, 12.0 * k, 2.4 * k)
        vector.paint(shape, picture, color)
        vector.circle(shape, 19.0 * k, 12.0 * k, 2.4 * k)
    }
    if symbol == MOON {
        vector.circle(shape, 12.0 * k, 12.0 * k, 8.5 * k)
        vector.paint(shape, picture, color)
        vector.circle(shape, 16.5 * k, 8.0 * k, 7.0 * k)
        vector.erase(shape, picture)
        return
    }
    if symbol == SUN { sun(shape, picture, k, color) }
    if symbol == APPEARANCE {
        // The left half of the disc, then the ring around it.
        vector.circle(shape, 12.0 * k, 12.0 * k, 7.0 * k)
        vector.paint(shape, picture, color)
        vector.roundedRect(shape, 12.0 * k, 0.0, 12.0 * k, 24.0 * k, 0.0)
        vector.erase(shape, picture)
        vector.ring(shape, 12.0 * k, 12.0 * k, 9.0 * k, 2.0 * k)
    }
    if symbol == CAMERA {
        vector.roundedRect(shape, 2.5 * k, 7.0 * k, 19.0 * k, 13.0 * k, 2.5 * k)
        vector.paint(shape, picture, color)
        vector.roundedRect(shape, 8.0 * k, 4.5 * k, 8.0 * k, 4.0 * k, 1.2 * k)
        vector.paint(shape, picture, color)
        vector.circle(shape, 12.0 * k, 13.5 * k, 4.6 * k)
        vector.erase(shape, picture)
        vector.circle(shape, 12.0 * k, 13.5 * k, 2.8 * k)
    }
    if symbol == MARK {
        vector.ring(shape, 12.0 * k, 12.0 * k, 10.0 * k, 2.2 * k)
        vector.paint(shape, picture, color)
        vector.circle(shape, 12.0 * k, 12.0 * k, 4.0 * k)
    }
    vector.paint(shape, picture, color)
}

fn chevron(shape: *Shape, ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, k: f64) -> void {
    vector.line(shape, ax * k, ay * k, bx * k, by * k, 2.2 * k, true)
    vector.line(shape, bx * k, by * k, cx * k, cy * k, 2.2 * k, true)
}

// A speaker: its box and cone, then as many waves as it is loud (0 to 3)
// or a cross when muted.
fn speaker(shape: *Shape, picture: *png.Image, variant: u32, k: f64, color: u32) -> void {
    var points: [12]f64 = [12]f64{ 2.5, 9.0, 6.5, 9.0, 12.0, 4.0, 12.0, 20.0, 6.5, 15.0, 2.5, 15.0 }
    var index: usize = 0
    while index < 12 {
        points[index] = points[index] * k
        index += 1
    }
    unsafe { vector.polygon(shape, @ptrCast([*]const f64, &points), 6) }
    vector.paint(shape, picture, color)
    if variant == MUTED {
        vector.line(shape, 15.5 * k, 9.0 * k, 21.5 * k, 15.0 * k, 2.0 * k, true)
        vector.paint(shape, picture, color)
        vector.line(shape, 21.5 * k, 9.0 * k, 15.5 * k, 15.0 * k, 2.0 * k, true)
        vector.paint(shape, picture, color)
        return
    }
    var wave: u32 = 0
    while wave < 3 {
        const radius = 4.5 + vector.toFloat(@intCast(i64, wave)) * 3.8
        vector.arc(shape, 12.0 * k, 12.0 * k, radius * k, 1.9 * k, -48.0, 48.0, true)
        vector.paint(shape, picture, if wave < variant { color } else { dim(color) })
        wave += 1
    }
}

// A battery: its outline and knob, filled as far as it is charged (red
// when LOW), a bolt while it charges.
fn battery(shape: *Shape, picture: *png.Image, given: u32, k: f64, color: u32) -> void {
    var variant = given
    const low = variant >= LOW
    if low { variant -= LOW }
    const charging = variant >= CHARGING
    if charging { variant -= CHARGING }
    if variant > 100 { variant = 100 }
    vector.roundedFrame(shape, 1.5 * k, 6.5 * k, 18.5 * k, 11.0 * k, 3.0 * k, 1.5 * k)
    vector.paint(shape, picture, fade(color, 170))
    vector.roundedRect(shape, 20.8 * k, 9.8 * k, 1.8 * k, 4.4 * k, 0.9 * k)
    vector.paint(shape, picture, fade(color, 170))
    const level = vector.toFloat(@intCast(i64, variant)) / 100.0
    if level > 0.0 {
        const fill = if low && !charging { 4294924880 } else { color }
        vector.roundedRect(shape, 3.5 * k, 8.5 * k, 14.5 * k * level, 7.0 * k, 1.6 * k)
        vector.paint(shape, picture, fill)
    }
    if charging {
        var bolt: [12]f64 = [12]f64{ 12.2, 4.5, 6.8, 12.8, 10.4, 12.8, 9.0, 19.5, 14.6, 11.2, 11.0, 11.2 }
        var index: usize = 0
        while index < 12 {
            bolt[index] = bolt[index] * k
            index += 1
        }
        // A clear edge around it, then the bolt.
        var edge: [12]f64 = [12]f64{ 13.6, 3.0, 4.6, 14.2, 8.6, 14.2, 7.0, 22.0, 16.8, 9.8, 12.8, 9.8 }
        index = 0
        while index < 12 {
            edge[index] = edge[index] * k
            index += 1
        }
        unsafe { vector.polygon(shape, @ptrCast([*]const f64, &edge), 6) }
        vector.erase(shape, picture)
        unsafe { vector.polygon(shape, @ptrCast([*]const f64, &bolt), 6) }
        vector.paint(shape, picture, 4294955530)
    }
}

// Wi-Fi: a dot and three arcs, as many lit as it is strong (0 to 4: the
// dot is the first); OFF: dim with a slash.
fn wifi(shape: *Shape, picture: *png.Image, variant: u32, k: f64, color: u32) -> void {
    const off = variant == OFF
    vector.circle(shape, 12.0 * k, 18.5 * k, 2.0 * k)
    vector.paint(shape, picture, if !off && variant >= 1 { color } else { dim(color) })
    var wave: u32 = 0
    while wave < 3 {
        const radius = 6.2 + vector.toFloat(@intCast(i64, wave)) * 4.6
        vector.arc(shape, 12.0 * k, 19.5 * k, radius * k, 2.2 * k, 45.0, 135.0, true)
        vector.paint(shape, picture, if !off && variant >= wave + 2 { color } else { dim(color) })
        wave += 1
    }
    if off {
        vector.line(shape, 4.0 * k, 3.5 * k, 20.0 * k, 20.5 * k, 2.6 * k, true)
        vector.erase(shape, picture)
        vector.line(shape, 4.5 * k, 4.0 * k, 19.5 * k, 20.0 * k, 1.8 * k, true)
        vector.paint(shape, picture, color)
    }
}

// A cable's network: three boxes joined.
fn ethernet(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.roundedRect(shape, 8.5 * k, 2.5 * k, 7.0 * k, 5.5 * k, 1.3 * k)
    vector.paint(shape, picture, color)
    vector.roundedRect(shape, 2.0 * k, 16.0 * k, 7.0 * k, 5.5 * k, 1.3 * k)
    vector.paint(shape, picture, color)
    vector.roundedRect(shape, 15.0 * k, 16.0 * k, 7.0 * k, 5.5 * k, 1.3 * k)
    vector.paint(shape, picture, color)
    vector.line(shape, 12.0 * k, 8.0 * k, 12.0 * k, 12.0 * k, 1.6 * k, false)
    vector.paint(shape, picture, color)
    vector.line(shape, 5.5 * k, 12.0 * k, 18.5 * k, 12.0 * k, 1.6 * k, true)
    vector.paint(shape, picture, color)
    vector.line(shape, 5.5 * k, 12.0 * k, 5.5 * k, 16.0 * k, 1.6 * k, false)
    vector.paint(shape, picture, color)
    vector.line(shape, 18.5 * k, 12.0 * k, 18.5 * k, 16.0 * k, 1.6 * k, false)
    vector.paint(shape, picture, color)
}

// No network: a globe crossed out.
fn offline(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.ring(shape, 12.0 * k, 12.0 * k, 8.5 * k, 1.8 * k)
    vector.paint(shape, picture, dim(color))
    vector.line(shape, 5.0 * k, 5.0 * k, 19.0 * k, 19.0 * k, 2.0 * k, true)
    vector.paint(shape, picture, color)
}

// A bell (crossed out for NO_DISTURB).
fn bell(shape: *Shape, picture: *png.Image, variant: u32, k: f64, color: u32) -> void {
    vector.moveTo(shape, 12.0 * k, 3.0 * k)
    vector.cubicTo(shape, 16.6 * k, 3.0 * k, 18.0 * k, 6.8 * k, 18.0 * k, 10.5 * k)
    vector.lineTo(shape, 18.0 * k, 14.2 * k)
    vector.lineTo(shape, 20.2 * k, 17.0 * k)
    vector.lineTo(shape, 3.8 * k, 17.0 * k)
    vector.lineTo(shape, 6.0 * k, 14.2 * k)
    vector.lineTo(shape, 6.0 * k, 10.5 * k)
    vector.cubicTo(shape, 6.0 * k, 6.8 * k, 7.4 * k, 3.0 * k, 12.0 * k, 3.0 * k)
    vector.close(shape)
    vector.paint(shape, picture, color)
    vector.ellipse(shape, 12.0 * k, 18.6 * k, 2.6 * k, 2.4 * k, false)
    vector.paint(shape, picture, color)
    if variant == NO_DISTURB {
        vector.line(shape, 3.5 * k, 3.0 * k, 20.5 * k, 21.0 * k, 3.4 * k, true)
        vector.erase(shape, picture)
        vector.line(shape, 4.0 * k, 3.5 * k, 20.0 * k, 20.5 * k, 1.8 * k, true)
        vector.paint(shape, picture, color)
    }
}

// The control centre: two switches.
fn toggles(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.roundedFrame(shape, 2.5 * k, 3.5 * k, 19.0 * k, 7.5 * k, 3.75 * k, 1.6 * k)
    vector.paint(shape, picture, color)
    vector.circle(shape, 17.75 * k, 7.25 * k, 2.4 * k)
    vector.paint(shape, picture, color)
    vector.roundedFrame(shape, 2.5 * k, 13.0 * k, 19.0 * k, 7.5 * k, 3.75 * k, 1.6 * k)
    vector.paint(shape, picture, color)
    vector.circle(shape, 6.25 * k, 16.75 * k, 2.4 * k)
}

fn lock(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.arc(shape, 12.0 * k, 9.5 * k, 4.5 * k, 2.0 * k, 0.0, 180.0, false)
    vector.paint(shape, picture, color)
    vector.rect(shape, 6.5 * k, 9.5 * k, 2.0 * k, 2.0 * k)
    vector.paint(shape, picture, color)
    vector.rect(shape, 15.5 * k, 9.5 * k, 2.0 * k, 2.0 * k)
    vector.paint(shape, picture, color)
    vector.roundedRect(shape, 5.0 * k, 11.0 * k, 14.0 * k, 10.0 * k, 2.2 * k)
    vector.paint(shape, picture, color)
    vector.circle(shape, 12.0 * k, 15.2 * k, 1.6 * k)
    vector.erase(shape, picture)
    vector.rect(shape, 11.3 * k, 15.5 * k, 1.4 * k, 3.0 * k)
    vector.erase(shape, picture)
}

// Log out: a door frame open to the right and an arrow out of it.
fn logOut(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.line(shape, 12.0 * k, 4.0 * k, 5.0 * k, 4.0 * k, 2.0 * k, true)
    vector.paint(shape, picture, color)
    vector.line(shape, 5.0 * k, 4.0 * k, 5.0 * k, 20.0 * k, 2.0 * k, true)
    vector.paint(shape, picture, color)
    vector.line(shape, 5.0 * k, 20.0 * k, 12.0 * k, 20.0 * k, 2.0 * k, true)
    vector.paint(shape, picture, color)
    vector.line(shape, 10.0 * k, 12.0 * k, 20.0 * k, 12.0 * k, 2.0 * k, true)
    vector.paint(shape, picture, color)
    chevron(shape, 16.0, 8.0, 20.0, 12.0, 16.0, 16.0, k)
}

fn power(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.arc(shape, 12.0 * k, 13.0 * k, 8.0 * k, 2.2 * k, 125.0, 415.0, true)
    vector.paint(shape, picture, color)
    vector.line(shape, 12.0 * k, 3.0 * k, 12.0 * k, 11.5 * k, 2.2 * k, true)
}

// Next (or previous): two triangles and a bar.
fn skip(shape: *Shape, back: bool, k: f64) -> void {
    if back {
        vector.roundedRect(shape, 2.5 * k, 6.0 * k, 2.2 * k, 12.0 * k, 1.0 * k)
        vector.triangle(shape, 12.5 * k, 6.0 * k, 12.5 * k, 18.0 * k, 4.6 * k, 12.0 * k)
        vector.triangle(shape, 20.5 * k, 6.0 * k, 20.5 * k, 18.0 * k, 12.5 * k, 12.0 * k)
    } else {
        vector.triangle(shape, 3.5 * k, 6.0 * k, 3.5 * k, 18.0 * k, 11.5 * k, 12.0 * k)
        vector.triangle(shape, 11.5 * k, 6.0 * k, 11.5 * k, 18.0 * k, 19.4 * k, 12.0 * k)
        vector.roundedRect(shape, 19.3 * k, 6.0 * k, 2.2 * k, 12.0 * k, 1.0 * k)
    }
}

fn note(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.ellipse(shape, 8.0 * k, 17.5 * k, 3.6 * k, 3.0 * k, false)
    vector.paint(shape, picture, color)
    vector.rect(shape, 9.8 * k, 5.0 * k, 2.0 * k, 12.5 * k)
    vector.paint(shape, picture, color)
    vector.moveTo(shape, 9.8 * k, 4.0 * k)
    vector.lineTo(shape, 18.5 * k, 2.5 * k)
    vector.lineTo(shape, 18.5 * k, 6.5 * k)
    vector.lineTo(shape, 9.8 * k, 8.0 * k)
    vector.close(shape)
}

fn sun(shape: *Shape, picture: *png.Image, k: f64, color: u32) -> void {
    vector.circle(shape, 12.0 * k, 12.0 * k, 4.2 * k)
    vector.paint(shape, picture, color)
    var ray: i64 = 0
    while ray < 8 {
        const angle = vector.toFloat(ray) * vector.pi() / 4.0
        const c = vector.cosine(angle)
        const s = vector.sine(angle)
        vector.line(shape, (12.0 + 7.0 * c) * k, (12.0 + 7.0 * s) * k, (12.0 + 9.5 * c) * k, (12.0 + 9.5 * s) * k, 2.0 * k, true)
        vector.paint(shape, picture, color)
        ray += 1
    }
}
