// The desktop's colours in its two looks, dark and light, and anywhere
// between them: a change of look glides (the top bar, its popups and the
// notifications' bubbles draw with the palette `at` their glide's value).
// The look is the color-scheme of org.freedesktop.appearance, which the
// portal (mlx-capture --portal, appearance.mlx) keeps and tells on MLXIPC.
//
// The colours are premultiplied, as std.ui.canvas draws them (its
// color()). Symbols are drawn in the ink of both looks, each as strongly
// as its look is in force (two kept images, no new one for each step of a
// glide).
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const symbols = @import("./symbols.mlx")

const Canvas = canvas_module.Canvas

// org.freedesktop.appearance color-scheme values.
pub const SCHEME_DEFAULT: u32 = 0
pub const SCHEME_DARK: u32 = 1
pub const SCHEME_LIGHT: u32 = 2

// 0: dark, LIGHT: light.
pub const LIGHT: i32 = 1024

pub const ACCENT: u32 = 4284129535
// White, for what is drawn on the accent colour.
pub const ON_ACCENT: u32 = 4294967295
const DARK_INK: u32 = 4294967295
const LIGHT_INK: u32 = 4280032804

pub const Palette = struct {
    // How light (0 dark to LIGHT).
    t: i32
    // The bar (translucent) and its bottom line.
    bar: u32
    barLine: u32
    // A popup's or a bubble's background, its edge, a panel in it (tiles,
    // buttons, rows), a line between its parts.
    popup: u32
    edge: u32
    panel: u32
    line: u32
    // Text and symbols, and the same straight (not premultiplied: ink()
    // makes it fainter).
    ink: u32
    straightInk: u32
}

pub fn at(t: i32) -> Palette {
    const straight = theme_module.mix(DARK_INK, LIGHT_INK, t)
    return Palette.{
        .t = t,
        .bar = theme_module.mix(canvas_module.color(170, 22, 24, 30), canvas_module.color(196, 244, 244, 248), t),
        .barLine = theme_module.mix(canvas_module.color(40, 255, 255, 255), canvas_module.color(36, 0, 0, 0), t),
        .popup = theme_module.mix(canvas_module.color(255, 30, 33, 42), canvas_module.color(255, 246, 246, 249), t),
        .edge = theme_module.mix(canvas_module.color(60, 255, 255, 255), canvas_module.color(40, 0, 0, 0), t),
        .panel = theme_module.mix(canvas_module.color(255, 58, 58, 74), canvas_module.color(255, 228, 229, 236), t),
        .line = theme_module.mix(canvas_module.color(50, 255, 255, 255), canvas_module.color(34, 0, 0, 0), t),
        .ink = straight,
        .straightInk = straight,
    }
}

// The ink at `alpha` (0 to 255): what says less, and the light under the
// pointer.
pub fn ink(palette: *const Palette, alpha: u32) -> u32 { return canvas_module.premultiplied((alpha << 24) | (palette.*.straightInk & 16777215)) }

// Symbol `symbol` in the ink, `size` pixels square at (x, y).
pub fn symbol(palette: *const Palette, cache: *symbols.Cache, canvas: *Canvas, symbol_id: u32, variant: u32, x: i32, y: i32, size: i32) -> void {
    symbolBetween(palette, cache, canvas, symbol_id, variant, x, y, size, DARK_INK, LIGHT_INK)
}

// The same in `dark` in the dark look and `light` in the light one.
pub fn symbolBetween(palette: *const Palette, cache: *symbols.Cache, canvas: *Canvas, symbol_id: u32, variant: u32, x: i32, y: i32, size: i32, dark: u32, light: u32) -> void {
    const t = palette.*.t
    if t <= 0 || dark == light {
        symbols.draw(cache, canvas, symbol_id, variant, x, y, size, dark)
        return
    }
    if t >= LIGHT {
        symbols.draw(cache, canvas, symbol_id, variant, x, y, size, light)
        return
    }
    const opacity = canvas.*.opacity
    canvas_module.setOpacity(canvas, opacity * @intCast(u32, LIGHT - t) / @intCast(u32, LIGHT))
    symbols.draw(cache, canvas, symbol_id, variant, x, y, size, dark)
    canvas_module.setOpacity(canvas, opacity * @intCast(u32, t) / @intCast(u32, LIGHT))
    symbols.draw(cache, canvas, symbol_id, variant, x, y, size, light)
    canvas_module.setOpacity(canvas, opacity)
}
