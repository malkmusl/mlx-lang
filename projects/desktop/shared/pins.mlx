// What is pinned to the dock, one entry per line in the dock's order:
// APPS ($XDG_CONFIG_HOME/mlx/dock, ~/.config/mlx/dock), desktop entry ids
// ("terminal" for the Mlx terminal), and FOLDERS (mlx/dock-folders),
// paths ("~/Downloads"). The dock reads them (and writes what it shows
// when one is missing); the launcher and the dock's menu change them, and
// the dock takes the change in within a second.
const std = @import("std")
const apps_module = @import("./apps.mlx")

const Path = apps_module.Path

pub const APPS: []const u8 = "dock"
pub const FOLDERS: []const u8 = "dock-folders"

pub const MAX_PINS: usize = 48
const ID: usize = 256

pub const Pins = struct {
    ids: [12288]u8
    lengths: [48]usize
    count: usize
}

const SYS_mkdir: usize = 83
const O_WRONLY_CREATE_TRUNCATE: usize = 577

pub fn idAt(pins: *const Pins, index: usize) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(pins) + @offsetOf(Pins, "ids") + index * ID) }
    return bytes[0..pins.*.lengths[index]]
}

fn directory(environment: [*][*]const u8, path: *Path) -> bool {
    apps_module.pathClear(path)
    const config = apps_module.environmentValue(environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] != 0 {
        apps_module.pathAddC(path, config)
    } else {
        const home = apps_module.environmentValue(environment, "HOME")
        if @intFromPtr(home) == 0 { return false }
        apps_module.pathAddC(path, home)
        apps_module.pathAdd(path, "/.config")
    }
    apps_module.pathAdd(path, "/mlx")
    return true
}

// File `name`'s path (APPS or FOLDERS) into `into`; false without a home.
pub fn path(environment: [*][*]const u8, name: []const u8, into: *Path) -> bool {
    if !directory(environment, into) { return false }
    apps_module.pathAdd(into, "/")
    apps_module.pathAdd(into, name)
    return true
}

// The index of `id` (any case), count when it is not pinned.
pub fn find(pins: *const Pins, id: []const u8) -> usize {
    var index: usize = 0
    while index < pins.*.count {
        if apps_module.sameText(idAt(pins, index), id) { return index }
        index += 1
    }
    return pins.*.count
}

// Pins `id` at `at` (at most at the end); nothing when it is pinned.
pub fn insert(pins: *Pins, id: []const u8, at: usize) -> void {
    if id.length == 0 || id.length > ID || pins.*.count >= MAX_PINS || find(pins, id) < pins.*.count { return }
    const position = if at < pins.*.count { at } else { pins.*.count }
    var index = pins.*.count
    while index > position {
        var byte: usize = 0
        while byte < ID {
            pins.*.ids[index * ID + byte] = pins.*.ids[(index - 1) * ID + byte]
            byte += 1
        }
        pins.*.lengths[index] = pins.*.lengths[index - 1]
        index -= 1
    }
    var byte: usize = 0
    while byte < id.length {
        pins.*.ids[position * ID + byte] = id[byte]
        byte += 1
    }
    pins.*.lengths[position] = id.length
    pins.*.count += 1
}

pub fn remove(pins: *Pins, index: usize) -> void {
    if index >= pins.*.count { return }
    var at = index
    while at + 1 < pins.*.count {
        var byte: usize = 0
        while byte < ID {
            pins.*.ids[at * ID + byte] = pins.*.ids[(at + 1) * ID + byte]
            byte += 1
        }
        pins.*.lengths[at] = pins.*.lengths[at + 1]
        at += 1
    }
    pins.*.count -= 1
}

// Reads the file; false when there is none (pins is then empty).
pub fn read(environment: [*][*]const u8, name: []const u8, allocator: std.allocator.Allocator, pins: *Pins) -> bool {
    pins.*.count = 0
    var file_path: Path = undefined
    if !path(environment, name, &file_path) { return false }
    const file = std.fs.open(apps_module.pathEnd(&file_path), 0, 0)
    if !std.fs.isValid(file) { return false }
    const contents = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    const text = contents.items
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        var start = at
        while start < end && (text[start] == 32 || text[start] == 9) { start += 1 }
        var stop = end
        while stop > start && (text[stop - 1] == 32 || text[stop - 1] == 9 || text[stop - 1] == 13) { stop -= 1 }
        if stop > start && text[start] != 35 { insert(pins, text[start..stop], pins.*.count) }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
    return true
}

// Writes the file whole (NAME.new renamed over it); false when it could
// not be written.
pub fn write(environment: [*][*]const u8, name: []const u8, pins: *const Pins) -> bool {
    var file_path: Path = undefined
    if !directory(environment, &file_path) { return false }
    const made = std.linux.syscall2(SYS_mkdir, @intFromPtr(apps_module.pathEnd(&file_path)), 493)
    apps_module.pathAdd(&file_path, "/")
    apps_module.pathAdd(&file_path, name)
    const final_length = file_path.length
    apps_module.pathAdd(&file_path, ".new")
    var text: [12400]u8 = undefined
    var length: usize = 0
    var index: usize = 0
    while index < pins.*.count {
        for byte in idAt(pins, index) {
            text[length] = byte
            length += 1
        }
        text[length] = 10
        length += 1
        index += 1
    }
    const file = std.fs.open(apps_module.pathEnd(&file_path), O_WRONLY_CREATE_TRUNCATE, 420)
    if !std.fs.isValid(file) { return false }
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &text) }
    const written = std.fs.writeAllBytes(file, bytes, length)
    const closed = std.fs.close(file)
    var final_path: Path = undefined
    apps_module.pathClear(&final_path)
    apps_module.pathAdd(&final_path, file_path.bytes[0..final_length])
    return written && std.fs.rename(apps_module.pathEnd(&file_path), apps_module.pathEnd(&final_path))
}

// The desktop entry id a dropped text/uri-list names: the file name of its
// first file:// URI without ".desktop" (an empty slice when it names none).
pub fn idFromUri(data: []const u8) -> []const u8 {
    var end: usize = 0
    while end < data.length && data[end] != 13 && data[end] != 10 { end += 1 }
    if end < 8 { return data[0..0] }
    var start = end
    while start > 0 && data[start - 1] != 47 { start -= 1 }
    if end - start > 8 && apps_module.sameText(data[end - 8..end], ".desktop") { return data[start..end - 8] }
    return data[0..0]
}
