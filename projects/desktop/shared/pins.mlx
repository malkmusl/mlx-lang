// What is pinned to the dock, one entry per line in the dock's order:
// APPS ($XDG_CONFIG_HOME/mlx/dock, ~/.config/mlx/dock: in a brixOS
// session /users/NAME/.config/mlx/dock, beside the desktop's other
// settings), the apps' ids ("org.mlx.files"; "terminal" for the Mlx
// terminal; any name apps.find knows an app by), and FOLDERS
// (mlx/dock-folders), paths ("~/Downloads"). The dock reads them (and
// writes what it shows when one is missing); the launcher and the dock's
// menu change them, and the dock takes the change in within a second.
const std = @import("std")
const xdg = @import("std.xdg")
const apps_module = @import("./apps.mlx")

const Path = apps_module.Path

pub const APPS: []const u8 = "dock"
pub const FOLDERS: []const u8 = "dock-folders"
// The word that pins the Mlx terminal.
pub const TERMINAL: []const u8 = "terminal"

pub const MAX_PINS: usize = 48
const ID: usize = 256

pub const Pins = struct {
    ids: [12288]u8
    lengths: [48]usize
    count: usize
}

pub fn idAt(pins: *const Pins, index: usize) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, pins) + @offsetOf(Pins, "ids") + index * ID }
    return bytes[0..pins.*.lengths[index]]
}

fn directory(environment: [*][*]const u8, path: *Path) -> bool {
    const bytes: [*]u8 = &path.*.bytes
    path.*.length = xdg.path(environment, xdg.CONFIG, "/mlx", bytes, 1023)
    return path.*.length > 0
}

// File `name`'s path (APPS or FOLDERS) into `into`; false without a home.
pub fn path(environment: [*][*]const u8, name: []const u8, into: *Path) -> bool {
    if !directory(environment, into) { return false }
    apps_module.pathAdd(into, "/")
    apps_module.pathAdd(into, name)
    return true
}

// The index of `id` (any case), count when it is not pinned.
pub fn find(pins: *const Pins, id: []const u8) -> usize {
    var index: usize = 0
    while index < pins.*.count {
        if apps_module.sameText(idAt(pins, index), id) { return index }
        index += 1
    }
    return pins.*.count
}

// The app a pin names (its index; count when it is not installed): what
// apps.find says, "terminal" being the Mlx terminal's entry.
pub fn appOf(apps: *apps_module.Apps, id: []const u8) -> usize {
    return apps_module.find(apps, if apps_module.sameText(id, TERMINAL) { apps_module.TERMINAL_ID } else { id })
}

// The pin that names app `app` (count when none does): by the app each
// pin stands for, so "Polaris", "polaris" and "org.mlx.files" are one pin.
pub fn findApp(pins: *const Pins, apps: *apps_module.Apps, app: usize) -> usize {
    var index: usize = 0
    while index < pins.*.count {
        if appOf(apps, idAt(pins, index)) == app { return index }
        index += 1
    }
    return pins.*.count
}

// Pins `id` at `at` (at most at the end); nothing when it is pinned.
pub fn insert(pins: *Pins, id: []const u8, at: usize) -> void {
    if id.length == 0 || id.length > ID || pins.*.count >= MAX_PINS || find(pins, id) < pins.*.count { return }
    const position = if at < pins.*.count { at } else { pins.*.count }
    var index = pins.*.count
    while index > position {
        var byte: usize = 0
        while byte < ID {
            pins.*.ids[index * ID + byte] = pins.*.ids[(index - 1) * ID + byte]
            byte += 1
        }
        pins.*.lengths[index] = pins.*.lengths[index - 1]
        index -= 1
    }
    var byte: usize = 0
    while byte < id.length {
        pins.*.ids[position * ID + byte] = id[byte]
        byte += 1
    }
    pins.*.lengths[position] = id.length
    pins.*.count += 1
}

pub fn remove(pins: *Pins, index: usize) -> void {
    if index >= pins.*.count { return }
    var at = index
    while at + 1 < pins.*.count {
        var byte: usize = 0
        while byte < ID {
            pins.*.ids[at * ID + byte] = pins.*.ids[(at + 1) * ID + byte]
            byte += 1
        }
        pins.*.lengths[at] = pins.*.lengths[at + 1]
        at += 1
    }
    pins.*.count -= 1
}

// Unpins app `app`: every pin that stands for it goes (an older file may
// name one app twice: "terminal" and "Vector", "Polaris" and
// "org.mlx.files").
pub fn removeApp(pins: *Pins, apps: *apps_module.Apps, app: usize) -> void {
    var index = findApp(pins, apps, app)
    while index < pins.*.count {
        remove(pins, index)
        index = findApp(pins, apps, app)
    }
}

// Reads the file; false when there is none (pins is then empty).
pub fn read(environment: [*][*]const u8, name: []const u8, allocator: std.allocator.Allocator, pins: *Pins) -> bool {
    pins.*.count = 0
    var file_path: Path = undefined
    if !path(environment, name, &file_path) { return false }
    const read = std.fs.readFileAlloc(apps_module.pathEnd(&file_path), allocator)
    if read == null { return false }
    const contents = read.?
    const text = contents.items
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        var start = at
        while start < end && (text[start] == 32 || text[start] == 9) { start += 1 }
        var stop = end
        while stop > start && (text[stop - 1] == 32 || text[stop - 1] == 9 || text[stop - 1] == 13) { stop -= 1 }
        if stop > start && text[start] != 35 { insert(pins, text[start..stop], pins.*.count) }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
    return true
}

// Writes the file whole (NAME.new renamed over it); false when it could
// not be written.
pub fn write(environment: [*][*]const u8, name: []const u8, pins: *const Pins) -> bool {
    var file_path: Path = undefined
    if !path(environment, name, &file_path) { return false }
    // The folders above it may not be there yet (a first session: no
    // ~/.config, no ~/.config/mlx).
    _ = std.fs.makeParents(file_path.bytes[0..file_path.length], 493)
    var text: [12400]u8 = undefined
    var length: usize = 0
    var index: usize = 0
    while index < pins.*.count {
        for byte in idAt(pins, index) {
            text[length] = byte
            length += 1
        }
        text[length] = 10
        length += 1
        index += 1
    }
    const bytes: [*]const u8 = &text
    return std.fs.replaceFile(apps_module.pathEnd(&file_path), bytes, length, 420)
}

// The entry a dropped text/uri-list names, by its file name (apps.find
// knows the app by it): of its first file:// URI, NAME of a bundle
// NAME.app (the directory, or its app.ini) or of NAME.desktop; an empty
// slice when it names neither.
pub fn idFromUri(data: []const u8) -> []const u8 {
    var end: usize = 0
    while end < data.length && data[end] != 13 && data[end] != 10 { end += 1 }
    // (A bundle's directory may end in a slash, or its app.ini be named.)
    if end > 8 && apps_module.sameText(data[end - 8..end], "/app.ini") { end -= 8 }
    while end > 0 && data[end - 1] == 47 { end -= 1 }
    if end < 8 { return data[0..0] }
    var start = end
    while start > 0 && data[start - 1] != 47 { start -= 1 }
    if end - start > 8 && apps_module.sameText(data[end - 8..end], ".desktop") { return data[start..end - 8] }
    if end - start > 4 && apps_module.sameText(data[end - 4..end], ".app") { return data[start..end - 4] }
    return data[0..0]
}
