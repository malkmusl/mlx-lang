// The desktop's look for an app: the std.ui.theme made from the accent
// colour chosen in mlx-settings (accent-color = RRGGBB in
// $XDG_CONFIG_HOME/mlx/compositor.conf; the default seed without one),
// the dark palette, at the screen's scale. Every desktop app takes its
// theme from here, so a change of the accent in the settings reaches
// them all when they start.
const std = @import("std")
const theme_module = @import("std.ui.theme")

fn put(bytes: [*]u8, at: usize, text: []const u8) -> usize {
    var index: usize = 0
    while index < text.length {
        bytes[at + index] = text[index]
        index += 1
    }
    return at + text.length
}

fn hexValue(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(u32, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(u32, byte - 55) }
    return 16
}

// `text` as RRGGBB (a # before it allowed); `fallback` when it is not.
pub fn parseColor(text: []const u8, fallback: u32) -> u32 {
    var start: usize = 0
    if text.length > 0 && text[0] == 35 { start = 1 }
    if text.length - start != 6 { return fallback }
    var value: u32 = 0
    var index = start
    while index < text.length {
        const digit = hexValue(text[index])
        if digit > 15 { return fallback }
        value = (value << 4) | digit
        index += 1
    }
    return value
}

// The accent chosen in mlx-settings (0xRRGGBB), the default seed without
// one.
pub fn accent(environment: [*][*]const u8) -> u32 {
    var path: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var length: usize = 0
    const config = std.process.environmentFrom(environment, "XDG_CONFIG_HOME")
    if config != null && config.?.length > 0 {
        length = put(bytes, 0, config.?.pointer[0..config.?.length])
    } else {
        const home = std.process.environmentFrom(environment, "HOME")
        if home == null || home.?.length == 0 || home.?.length > 400 { return theme_module.DEFAULT_SEED }
        length = put(bytes, 0, home.?.pointer[0..home.?.length])
        length = put(bytes, length, "/.config")
    }
    if length > 460 { return theme_module.DEFAULT_SEED }
    length = put(bytes, length, "/mlx/compositor.conf")
    bytes[length] = 0
    const file = std.fs.open(bytes, 0, 0)
    if !std.fs.isValid(file) { return theme_module.DEFAULT_SEED }
    var buffer: [4096]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    const read = std.fs.read(file, text, 4096)
    const closed = std.fs.close(file)
    if read <= 0 { return theme_module.DEFAULT_SEED }
    const size = @intCast(usize, read)
    var at: usize = 0
    while at < size {
        var end = at
        while end < size && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[at..end])
        if line.length > 12 && std.text.same(line[0..12], "accent-color") {
            var equals: usize = 12
            while equals < line.length && line[equals] != 61 { equals += 1 }
            if equals < line.length { return parseColor(std.text.trimmed(line[equals + 1..line.length]), theme_module.DEFAULT_SEED) }
        }
        at = end + 1
    }
    return theme_module.DEFAULT_SEED
}

// The desktop's palette (dark) for the chosen accent.
pub fn palette(environment: [*][*]const u8) -> theme_module.Theme {
    return theme_module.fromSeed(accent(environment), true)
}

// The same at `scale` pixels a logical pixel.
pub fn theme(environment: [*][*]const u8, scale: i32) -> theme_module.Theme {
    return theme_module.scaled(palette(environment), scale)
}
