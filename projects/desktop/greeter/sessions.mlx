// Wayland login sessions offered by mlx-greeter. Entries come from
// XDG_DATA_HOME/wayland-sessions and XDG_DATA_DIRS/wayland-sessions, in
// that precedence order. Only an Exec that is one executable is kept:
// mlx-login performs execve directly and never interprets shell text.
const std = @import("std")

const SYS_open: usize = 2
const SYS_close: usize = 3
const O_DIRECTORY: usize = 65536
const O_CLOEXEC: usize = 524288

pub const MAX_SESSIONS: usize = 32

pub const Session = struct {
    id: [96]u8
    idLength: usize
    name: [128]u8
    nameLength: usize
    command: [256]u8
    commandLength: usize
}

pub const Sessions = struct {
    list: [MAX_SESSIONS]Session
    count: usize
    environment: [*][*]const u8
    allocator: std.allocator.Allocator
    language: [8]u8
    languageLength: usize
}

const Path = struct { bytes: [1024]u8, length: usize }

fn bytesAt(address: usize) -> [*]u8 { unsafe { return @ptrFromInt([*]u8, address) } }
fn textAt(address: usize, length: usize) -> []const u8 { unsafe { return @ptrFromInt([*]const u8, address)[0..length] } }

pub fn sessionAt(sessions: *Sessions, index: usize) -> *Session {
    unsafe { return @ptrFromInt(*Session, @intFromPtr(sessions) + @offsetOf(Sessions, "list") + index * @sizeOf(Session)) }
}

pub fn idOf(session: *const Session) -> []const u8 { return textAt(@intFromPtr(session) + @offsetOf(Session, "id"), session.*.idLength) }
pub fn nameOf(session: *const Session) -> []const u8 { return textAt(@intFromPtr(session) + @offsetOf(Session, "name"), session.*.nameLength) }
pub fn commandOf(session: *const Session) -> []const u8 { return textAt(@intFromPtr(session) + @offsetOf(Session, "command"), session.*.commandLength) }

fn environmentValue(environment: [*][*]const u8, name: []const u8) -> [*]const u8 {
    const value = std.process.environmentFrom(environment, name)
    if value != null { return value.?.pointer }
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

pub fn init(sessions: *Sessions, environment: [*][*]const u8, allocator: std.allocator.Allocator) -> bool {
    sessions.*.count = 0
    sessions.*.environment = environment
    sessions.*.allocator = allocator
    sessions.*.languageLength = 0
    var locale = environmentValue(environment, "LC_ALL")
    if @intFromPtr(locale) == 0 || locale[0] == 0 { locale = environmentValue(environment, "LC_MESSAGES") }
    if @intFromPtr(locale) == 0 || locale[0] == 0 { locale = environmentValue(environment, "LANG") }
    if @intFromPtr(locale) != 0 {
        while sessions.*.languageLength < 7 {
            const byte = locale[sessions.*.languageLength]
            if byte < 97 || byte > 122 { break }
            sessions.*.language[sessions.*.languageLength] = byte
            sessions.*.languageLength += 1
        }
    }
    return true
}

fn clear(path: *Path) -> void { path.*.length = 0 }

fn add(path: *Path, value: []const u8) -> void {
    var index: usize = 0
    while index < value.length && path.*.length < 1022 {
        path.*.bytes[path.*.length] = value[index]
        path.*.length += 1
        index += 1
    }
}

fn addC(path: *Path, value: [*]const u8) -> void {
    var index: usize = 0
    while value[index] != 0 && path.*.length < 1022 {
        path.*.bytes[path.*.length] = value[index]
        path.*.length += 1
        index += 1
    }
}

fn end(path: *Path) -> [*]const u8 {
    path.*.bytes[path.*.length] = 0
    unsafe { return @ptrCast([*]const u8, path) }
}

// The user's data directory first, then each system data directory.
fn dataDirectory(sessions: *Sessions, wanted: usize, path: *Path) -> bool {
    clear(path)
    if wanted == 0 {
        const home = environmentValue(sessions.*.environment, "XDG_DATA_HOME")
        if @intFromPtr(home) != 0 && home[0] != 0 {
            addC(path, home)
        } else {
            const user_home = environmentValue(sessions.*.environment, "HOME")
            if @intFromPtr(user_home) != 0 { addC(path, user_home) }
            add(path, "/.local/share")
        }
        return true
    }
    var dirs = environmentValue(sessions.*.environment, "XDG_DATA_DIRS")
    if @intFromPtr(dirs) == 0 || dirs[0] == 0 { unsafe { dirs = @ptrCast([*]const u8, "/usr/local/share:/usr/share") } }
    var remaining = wanted - 1
    var position: usize = 0
    while true {
        const start = position
        while dirs[position] != 0 && dirs[position] != 58 { position += 1 }
        if remaining == 0 {
            if position == start { return false }
            var at = start
            while at < position {
                path.*.bytes[path.*.length] = dirs[at]
                path.*.length += 1
                at += 1
            }
            return true
        }
        if dirs[position] == 0 { return false }
        position += 1
        remaining -= 1
    }
    return false
}

fn begins(line: [*]const u8, length: usize, prefix: []const u8) -> bool {
    if length < prefix.length { return false }
    var index: usize = 0
    while index < prefix.length {
        if line[index] != prefix[index] { return false }
        index += 1
    }
    return true
}

fn value(target: [*]u8, capacity: usize, line: [*]const u8, start: usize, stop: usize) -> usize {
    var written: usize = 0
    var index = start
    while index < stop && line[index] != 13 && written < capacity {
        target[written] = line[index]
        written += 1
        index += 1
    }
    return written
}

fn truth(line: [*]const u8, start: usize, stop: usize) -> bool {
    return stop >= start + 4 && line[start] == 116 && line[start + 1] == 114 && line[start + 2] == 117 && line[start + 3] == 101
}

fn safeCommand(command: []const u8) -> bool {
    if command.length == 0 { return false }
    for byte in command {
        if byte == 0 || byte == 9 || byte == 10 || byte == 13 || byte == 32 || byte == 37 { return false }
    }
    return true
}

fn known(sessions: *Sessions, id: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < sessions.*.count {
        const item = sessionAt(sessions, index)
        if item.*.idLength == length {
            var at: usize = 0
            while at < length && item.*.id[at] == id[at] { at += 1 }
            if at == length { return true }
        }
        index += 1
    }
    return false
}

fn readEntry(sessions: *Sessions, path: [*]const u8, id: [*]const u8, idLength: usize) -> bool {
    if sessions.*.count >= MAX_SESSIONS { return false }
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return false }
    const contents = std.fs.readToEndAlloc(file, sessions.*.allocator)
    const closed = std.fs.close(file)
    const item = sessionAt(sessions, sessions.*.count)
    item.*.idLength = value(bytesAt(@intFromPtr(item) + @offsetOf(Session, "id")), 96, id, 0, idLength)
    item.*.nameLength = 0
    item.*.commandLength = 0
    var localized = false
    var application = false
    var hidden = false
    var inEntry = false
    var at: usize = 0
    while at < contents.length {
        var stop = at
        while stop < contents.length && contents.items[stop] != 10 { stop += 1 }
        var line: [*]const u8 = undefined
        unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(contents.items) + at) }
        const length = stop - at
        if length > 0 && line[0] == 91 {
            inEntry = begins(line, length, "[Desktop Entry]")
        } else if inEntry {
            var equals: usize = 0
            while equals < length && line[equals] != 61 { equals += 1 }
            if equals < length {
                const start = equals + 1
                if begins(line, length, "Name=") && !localized {
                    item.*.nameLength = value(bytesAt(@intFromPtr(item) + @offsetOf(Session, "name")), 128, line, start, length)
                } else if begins(line, length, "Name[") && sessions.*.languageLength > 0 && equals == 5 + sessions.*.languageLength + 1 {
                    var same = true
                    var index: usize = 0
                    while index < sessions.*.languageLength {
                        if line[5 + index] != sessions.*.language[index] { same = false }
                        index += 1
                    }
                    if same {
                        item.*.nameLength = value(bytesAt(@intFromPtr(item) + @offsetOf(Session, "name")), 128, line, start, length)
                        localized = true
                    }
                } else if begins(line, length, "Exec=") {
                    item.*.commandLength = value(bytesAt(@intFromPtr(item) + @offsetOf(Session, "command")), 256, line, start, length)
                } else if begins(line, length, "Type=") {
                    application = begins(line, length, "Type=Application")
                } else if begins(line, length, "Hidden=") || begins(line, length, "NoDisplay=") {
                    if truth(line, start, length) { hidden = true }
                }
            }
        }
        at = stop + 1
    }
    std.fs.ArrayList.deinit(contents)
    return application && !hidden && item.*.nameLength > 0 && safeCommand(commandOf(item))
}

fn scanDirectory(sessions: *Sessions, directory: *Path) -> void {
    const base = directory.*.length
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(end(directory)), O_DIRECTORY | O_CLOEXEC, 0)
    if descriptor < 0 { return }
    var storage: [8192]u8 = undefined
    var storageBytes: [*]u8 = undefined
    unsafe { storageBytes = @ptrCast([*]u8, &storage) }
    var reader = std.fs.entries(std.fs.File.{ .descriptor = descriptor }, storageBytes, 8192)
    var entry: std.fs.Entry = undefined
    while std.fs.nextEntry(&reader, &entry) {
        const name = entry.name.pointer
        const length = entry.name.length
        if length > 8 && name[length - 8] == 46 && name[length - 7] == 100 && name[length - 1] == 112 && !known(sessions, name, length - 8) {
            directory.*.length = base
            add(directory, "/")
            add(directory, name[0..length])
            if readEntry(sessions, end(directory), name, length - 8) { sessions.*.count += 1 }
        }
    }
    directory.*.length = base
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

fn before(first: *const Session, second: *const Session) -> bool {
    var index: usize = 0
    while index < first.*.nameLength && index < second.*.nameLength {
        const a = std.ascii.toLower(first.*.name[index])
        const b = std.ascii.toLower(second.*.name[index])
        if a != b { return a < b }
        index += 1
    }
    return first.*.nameLength < second.*.nameLength
}

fn copy(target: *Session, source: *const Session) -> void {
    var to: [*]u8 = undefined
    var from: [*]const u8 = undefined
    unsafe {
        to = @ptrCast([*]u8, target)
        from = @ptrCast([*]const u8, source)
    }
    var index: usize = 0
    while index < @sizeOf(Session) {
        to[index] = from[index]
        index += 1
    }
}

pub fn scan(sessions: *Sessions) -> void {
    sessions.*.count = 0
    var path: Path = undefined
    var directory: usize = 0
    while dataDirectory(sessions, directory, &path) {
        if path.length > 0 {
            add(&path, "/wayland-sessions")
            scanDirectory(sessions, &path)
        }
        directory += 1
    }
    var temporary: Session = undefined
    var sorted: usize = 1
    while sorted < sessions.*.count {
        var at = sorted
        while at > 0 && before(sessionAt(sessions, at), sessionAt(sessions, at - 1)) {
            copy(&temporary, sessionAt(sessions, at))
            copy(sessionAt(sessions, at), sessionAt(sessions, at - 1))
            copy(sessionAt(sessions, at - 1), &temporary)
            at -= 1
        }
        sorted += 1
    }
}
