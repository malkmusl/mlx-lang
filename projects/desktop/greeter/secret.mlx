// Password-field helpers shared by mlx-greeter's UI and its focused
// check. The clear operation overwrites the complete fixed storage, not
// merely the bytes that happened to be typed.
const field = @import("std.ui.field")

pub fn mask(typed: *field.Field, shown: *field.Field) -> void {
    var index: usize = 0
    while index < typed.*.length {
        shown.*.bytes[index] = 42
        index += 1
    }
    shown.*.length = typed.*.length
    shown.*.cursor = typed.*.cursor
    shown.*.anchor = typed.*.anchor
    shown.*.scroll = typed.*.scroll
}

pub fn wipe(typed: *field.Field, shown: *field.Field) -> void {
    var index: usize = 0
    while index < field.CAPACITY {
        typed.*.bytes[index] = 0
        shown.*.bytes[index] = 0
        index += 1
    }
    field.clear(typed)
    field.clear(shown)
}
