// mlx-greeter: the one client shown by mlx-compositor --greeter. It gets
// accounts and starts a selected Wayland session through org.mlx.Login on
// MLXIPC's system bus. No account file or password hash is read here.
//
//     mlx4 projects/desktop/greeter/main.mlx -o mlx-greeter
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const controls = @import("std.ui.controls")
const field = @import("std.ui.field")
const host_module = @import("std.ui.host")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const view = @import("std.ui.view")
const clock = @import("../shared/clock.mlx")
const login_module = @import("./login.mlx")
const secret = @import("./secret.mlx")
const sessions_module = @import("./sessions.mlx")

const Canvas = canvas_module.Canvas
const Host = host_module.Host
const Text = text_module.Text

const WIDTH: i32 = 760
const HEIGHT: i32 = 520
const ID_USER: u64 = 100
const ID_SESSION: u64 = 300
const ID_PASSWORD: u64 = 500
const ID_LOGIN: u64 = 501

const Failure = error { NoMemory, NoDisplay }

const Greeter = struct {
    host: *Host
    ready: bool
    german: bool
    scale: i32
    fontScale: i32
    service: login_module.Service
    users: login_module.Users
    sessions: sessions_module.Sessions
    selectedUser: usize
    selectedSession: usize
    password: field.Field
    shown: field.Field
    problem: [192]u8
    problemLength: usize
    title: Text
    body: Text
    small: Text
    widgets: view.Ui
    theme: theme_module.Theme
}

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    const ignored = std.io.eprintln(message)
    return failure
}

fn stateOf(context: *anyopaque) -> *Greeter { unsafe { return @ptrCast(*Greeter, context) } }
fn uiOf(greeter: *Greeter) -> *view.Ui { unsafe { return @ptrCast(*view.Ui, &greeter.*.widgets) } }
fn themeOf(greeter: *Greeter) -> *theme_module.Theme { unsafe { return @ptrCast(*theme_module.Theme, &greeter.*.theme) } }
fn titleOf(greeter: *Greeter) -> *Text { unsafe { return @ptrCast(*Text, &greeter.*.title) } }
fn bodyOf(greeter: *Greeter) -> *Text { unsafe { return @ptrCast(*Text, &greeter.*.body) } }
fn smallOf(greeter: *Greeter) -> *Text { unsafe { return @ptrCast(*Text, &greeter.*.small) } }
fn passwordOf(greeter: *Greeter) -> *field.Field { unsafe { return @ptrCast(*field.Field, &greeter.*.password) } }
fn shownOf(greeter: *Greeter) -> *field.Field { unsafe { return @ptrCast(*field.Field, &greeter.*.shown) } }
fn serviceOf(greeter: *Greeter) -> *login_module.Service { unsafe { return @ptrFromInt(*login_module.Service, @intFromPtr(greeter) + @offsetOf(Greeter, "service")) } }
fn usersOf(greeter: *Greeter) -> *login_module.Users { unsafe { return @ptrFromInt(*login_module.Users, @intFromPtr(greeter) + @offsetOf(Greeter, "users")) } }
fn sessionsOf(greeter: *Greeter) -> *sessions_module.Sessions { unsafe { return @ptrFromInt(*sessions_module.Sessions, @intFromPtr(greeter) + @offsetOf(Greeter, "sessions")) } }

fn bytesAt(address: usize) -> [*]u8 { unsafe { return @ptrFromInt([*]u8, address) } }
fn problemOf(greeter: *Greeter) -> []const u8 { return bytesAt(@intFromPtr(greeter) + @offsetOf(Greeter, "problem"))[0..greeter.*.problemLength] }
fn tr(greeter: *Greeter, english: []const u8, german: []const u8) -> []const u8 { return if greeter.*.german { german } else { english } }
fn px(greeter: *Greeter, value: i32) -> i32 { return value * greeter.*.scale }

fn copy(target: [*]u8, capacity: usize, value: []const u8) -> usize {
    var index: usize = 0
    while index < value.length && index < capacity {
        target[index] = value[index]
        index += 1
    }
    return index
}

fn setProblem(greeter: *Greeter, message: []const u8) -> void {
    greeter.*.problemLength = copy(bytesAt(@intFromPtr(greeter) + @offsetOf(Greeter, "problem")), 192, message)
}

fn redraw(greeter: *Greeter) -> void { host_module.redraw(greeter.*.host) }

fn fitScale(greeter: *Greeter) -> void {
    const scale = host_module.scale(greeter.*.host)
    greeter.*.scale = scale
    if greeter.*.fontScale == scale { return }
    if greeter.*.fontScale != 0 {
        text_module.unloadText(titleOf(greeter))
        text_module.unloadText(bodyOf(greeter))
        text_module.unloadText(smallOf(greeter))
    }
    greeter.*.fontScale = scale
    const factor = @intCast(u32, scale)
    const allocator = std.page_allocator.init()
    const loadedTitle = text_module.loadText(titleOf(greeter), 22 * factor, allocator)
    const loadedBody = text_module.loadText(bodyOf(greeter), 14 * factor, allocator)
    const loadedSmall = text_module.loadText(smallOf(greeter), 12 * factor, allocator)
    greeter.*.theme = theme_module.scaled(theme_module.dark(), scale)
    view.init(uiOf(greeter), themeOf(greeter), bodyOf(greeter), smallOf(greeter), bodyOf(greeter))
}

fn selectedUser(greeter: *Greeter) -> []const u8 {
    if greeter.*.selectedUser >= greeter.*.users.count { return "" }
    const user = login_module.userAt(usersOf(greeter), greeter.*.selectedUser)
    return login_module.nameOf(user)
}

fn selectedCommand(greeter: *Greeter) -> []const u8 {
    if greeter.*.selectedSession >= greeter.*.sessions.count { return "" }
    const session = sessions_module.sessionAt(sessionsOf(greeter), greeter.*.selectedSession)
    return sessions_module.commandOf(session)
}

fn submit(greeter: *Greeter) -> void {
    if selectedUser(greeter).length == 0 {
        setProblem(greeter, tr(greeter, "Choose an account.", "Wähle ein Konto aus."))
        secret.wipe(passwordOf(greeter), shownOf(greeter))
        return
    }
    if selectedCommand(greeter).length == 0 {
        setProblem(greeter, tr(greeter, "No Wayland session is installed.", "Keine Wayland-Sitzung ist installiert."))
        secret.wipe(passwordOf(greeter), shownOf(greeter))
        return
    }
    greeter.*.problemLength = 0
    const user = selectedUser(greeter)
    const password = field.text(passwordOf(greeter))
    const command = selectedCommand(greeter)
    const result = login_module.login(serviceOf(greeter), user, password, command)
    secret.wipe(passwordOf(greeter), shownOf(greeter))
    if result == login_module.LOGIN_STARTED {
        // The greeter compositor can now give the seat to the session.
        host_module.quit(greeter.*.host)
    } else if result == login_module.LOGIN_DENIED {
        setProblem(greeter, tr(greeter, "The password is not correct.", "Das Passwort ist nicht korrekt."))
        view.setFocus(uiOf(greeter), ID_PASSWORD)
    } else {
        setProblem(greeter, tr(greeter, "The login service is not available.", "Der Anmeldedienst ist nicht erreichbar."))
        view.setFocus(uiOf(greeter), ID_PASSWORD)
    }
}

fn layOut(context: *anyopaque) -> void {
    var nowhere = view.layoutCanvas()
    draw(context, &nowhere)
}

fn drawAccountMark(canvas: *Canvas, x: i32, y: i32, size: i32, color: u32, background: u32) -> void {
    const head = size / 3
    canvas_module.fillRoundedRect(canvas, x + (size - head) / 2, y + size / 8, head, head, head / 2, color)
    canvas_module.fillRoundedRect(canvas, x + size / 5, y + size / 2, size * 3 / 5, size * 2 / 5, size / 5, color)
    canvas_module.fillRect(canvas, x + size / 5, y + size * 4 / 5, size * 3 / 5, size / 5, background)
}

fn drawUsers(greeter: *Greeter, left: i32, top: i32, width: i32, bottom: i32) -> void {
    const widgets = uiOf(greeter)
    const theme = themeOf(greeter)
    controls.label(widgets, bodyOf(greeter), tr(greeter, "Account", "Konto"), left, top, theme.*.dim, width)
    var y = top + px(greeter, 28)
    var index: usize = 0
    while index < greeter.*.users.count && y + px(greeter, 34) <= bottom {
        const user = login_module.userAt(usersOf(greeter), index)
        var label = login_module.realNameOf(user)
        if label.length == 0 { label = login_module.nameOf(user) }
        if controls.radioRow(widgets, ID_USER + @intCast(u64, index), ui.rect(left, y, width, px(greeter, 34)), label, greeter.*.selectedUser == index) {
            greeter.*.selectedUser = index
            greeter.*.problemLength = 0
            secret.wipe(passwordOf(greeter), shownOf(greeter))
            view.setFocus(widgets, ID_PASSWORD)
        }
        y += px(greeter, 36)
        index += 1
    }
    if greeter.*.users.count == 0 {
        controls.label(widgets, smallOf(greeter), tr(greeter, "No accounts found", "Keine Konten gefunden"), left, y, theme.*.danger, width)
    } else if index < greeter.*.users.count {
        controls.label(widgets, smallOf(greeter), tr(greeter, "More accounts are available", "Weitere Konten sind vorhanden"), left, bottom - px(greeter, 18), theme.*.dim, width)
    }
}

fn drawForm(greeter: *Greeter, left: i32, top: i32, width: i32) -> void {
    const widgets = uiOf(greeter)
    const theme = themeOf(greeter)
    var y = top
    controls.label(widgets, bodyOf(greeter), tr(greeter, "Session", "Sitzung"), left, y, theme.*.dim, width)
    y += px(greeter, 25)
    var index: usize = 0
    while index < greeter.*.sessions.count && index < 4 {
        const item = sessions_module.sessionAt(sessionsOf(greeter), index)
        if controls.radioRow(widgets, ID_SESSION + @intCast(u64, index), ui.rect(left, y, width, px(greeter, 31)), sessions_module.nameOf(item), greeter.*.selectedSession == index) {
            greeter.*.selectedSession = index
            greeter.*.problemLength = 0
        }
        y += px(greeter, 32)
        index += 1
    }
    if greeter.*.sessions.count == 0 {
        controls.label(widgets, smallOf(greeter), tr(greeter, "No Wayland session installed", "Keine Wayland-Sitzung installiert"), left, y, theme.*.danger, width)
        y += px(greeter, 34)
    }
    y += px(greeter, 15)
    controls.label(widgets, bodyOf(greeter), tr(greeter, "Password", "Passwort"), left, y, theme.*.dim, width)
    y += px(greeter, 25)
    secret.mask(passwordOf(greeter), shownOf(greeter))
    const fieldArea = ui.rect(left, y, width, px(greeter, 40))
    const clicked = field.textField(widgets, ID_PASSWORD, fieldArea, shownOf(greeter), tr(greeter, "Password", "Passwort"), false)
    passwordOf(greeter).*.cursor = shownOf(greeter).*.cursor
    passwordOf(greeter).*.anchor = shownOf(greeter).*.anchor
    y += px(greeter, 51)
    const problem = problemOf(greeter)
    if problem.length > 0 {
        controls.label(widgets, smallOf(greeter), problem, left, y, theme.*.danger, width)
    }
    y += px(greeter, 36)
    const label = tr(greeter, "Log in", "Anmelden")
    const buttonWidth = controls.buttonWidth(widgets, bodyOf(greeter), label) + px(greeter, 20)
    if controls.button(widgets, ID_LOGIN, ui.rect(left + width - buttonWidth, y, buttonWidth, px(greeter, 38)), label, controls.BUTTON_PRIMARY, greeter.*.users.count > 0 && greeter.*.sessions.count > 0) { submit(greeter) }
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const greeter = stateOf(context)
    if !greeter.*.ready { return }
    greeter.*.theme = theme_module.scaled(theme_module.at(host_module.lightness(greeter.*.host)), greeter.*.scale)
    const widgets = uiOf(greeter)
    const theme = themeOf(greeter)
    view.begin(widgets, canvas)
    const width = host_module.width(greeter.*.host)
    const height = host_module.height(greeter.*.host)
    canvas_module.fillRect(canvas, 0, 0, width, height, theme.*.background)
    const cardWidth = if width - px(greeter, 48) < px(greeter, 700) { width - px(greeter, 48) } else { px(greeter, 700) }
    const cardHeight = if height - px(greeter, 48) < px(greeter, 450) { height - px(greeter, 48) } else { px(greeter, 450) }
    const cardX = (width - cardWidth) / 2
    const cardY = (height - cardHeight) / 2
    canvas_module.fillRoundedRect(canvas, cardX, cardY, cardWidth, cardHeight, px(greeter, 12), theme.*.panel)
    const padding = px(greeter, 30)
    const mark = px(greeter, 52)
    drawAccountMark(canvas, cardX + padding, cardY + padding, mark, theme.*.accent, theme.*.panel)
    const headingX = cardX + padding + mark + px(greeter, 18)
    controls.label(widgets, titleOf(greeter), tr(greeter, "Welcome", "Willkommen"), headingX, cardY + padding + px(greeter, 2), theme.*.text, cardWidth - padding * 2 - mark)
    controls.label(widgets, smallOf(greeter), tr(greeter, "Choose an account and start your desktop.", "Konto wählen und Arbeitsfläche starten."), headingX, cardY + padding + px(greeter, 31), theme.*.dim, cardWidth - padding * 2 - mark)
    const contentTop = cardY + padding + px(greeter, 78)
    const contentBottom = cardY + cardHeight - padding
    const usersWidth = cardWidth * 2 / 5 - padding
    drawUsers(greeter, cardX + padding, contentTop, usersWidth, contentBottom)
    const divider = cardX + padding + usersWidth + px(greeter, 18)
    canvas_module.fillRect(canvas, divider, contentTop, 1, contentBottom - contentTop, theme.*.divider)
    drawForm(greeter, divider + px(greeter, 24), contentTop, cardX + cardWidth - padding - divider - px(greeter, 24))
    if view.end(widgets) { redraw(greeter) }
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const greeter = stateOf(context)
    if !greeter.*.ready { return }
    if kind == ui_app.EVENT_CLOSED {
        secret.wipe(passwordOf(greeter), shownOf(greeter))
        host_module.quit(greeter.*.host)
        return
    }
    if kind == ui_app.EVENT_CONFIGURED {
        fitScale(greeter)
        redraw(greeter)
        return
    }
    if kind == ui_app.EVENT_KEY && b != 0 && view.hasFocus(uiOf(greeter), ID_PASSWORD) {
        const result = field.fieldKey(passwordOf(greeter), a, host_module.modifiers(greeter.*.host), host_module.typed(greeter.*.host))
        if result == field.KEY_SUBMIT { submit(greeter) }
        redraw(greeter)
        return
    }
    if ui_app.pressing(kind, a, b) { layOut(context) }
    const fed = ui_app.feed(uiOf(greeter), kind, a, b)
    if fed == ui_app.FEED_CLICK { layOut(context) }
    if (kind == ui_app.EVENT_MOTION || kind == ui_app.EVENT_LEAVE) && fed == ui_app.FEED_NONE { return }
    redraw(greeter)
}

fn options() -> host_module.Options {
    return host_module.Options.{ .title = "Login", .appId = "org.mlx.greeter", .width = @intCast(u32, WIDTH), .height = @intCast(u32, HEIGHT), .minWidth = 560, .minHeight = 420 }
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Greeter), 16)
    if memory == null { return fail("mlx-greeter: no memory", Failure.NoMemory) }
    var greeter: *Greeter = undefined
    unsafe { greeter = @ptrCast(*Greeter, memory.?) }
    greeter.*.ready = false
    greeter.*.scale = 1
    greeter.*.fontScale = 0
    greeter.*.selectedUser = 0
    greeter.*.selectedSession = 0
    greeter.*.problemLength = 0
    field.clear(passwordOf(greeter))
    field.clear(shownOf(greeter))
    const host = host_module.create(options(), @ptrCast(*anyopaque, greeter), draw, onEvent)
    if host == null { return fail("mlx-greeter: no memory", Failure.NoMemory) }
    greeter.*.host = host.?
    try host_module.open(greeter.*.host, arguments)
    // The greeter fills the screen; the compositor sizes it to the output.
    host_module.setFullscreen(greeter.*.host, true)
    const environment = host_module.environment(greeter.*.host)
    greeter.*.german = clock.germanLocale(environment)
    login_module.init(serviceOf(greeter), environment)
    const initialized = sessions_module.init(sessionsOf(greeter), environment, allocator)
    sessions_module.scan(sessionsOf(greeter))
    if !login_module.listUsers(serviceOf(greeter), usersOf(greeter)) {
        greeter.*.users.count = 0
        setProblem(greeter, tr(greeter, "The login service is not available.", "Der Anmeldedienst ist nicht erreichbar."))
    }
    fitScale(greeter)
    host_module.setTitle(greeter.*.host, tr(greeter, "Login", "Anmeldung"))
    greeter.*.ready = true
    view.setFocus(uiOf(greeter), ID_PASSWORD)
    redraw(greeter)
    defer login_module.close(serviceOf(greeter))
    defer secret.wipe(passwordOf(greeter), shownOf(greeter))
    try host_module.run(greeter.*.host)
}
