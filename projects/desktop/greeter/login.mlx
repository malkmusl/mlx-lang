// The small org.mlx.Login client used by aurora, on MLXIPC's system bus,
// in MLXIPC's own native format (std.ipc) -- native first; the bus
// bridges to the login service whichever format it speaks. This is not a
// dependency on dbus-daemon or libdbus. Account data is copied out of the
// receive buffer before another message can replace it. A Login call's
// body and both outgoing buffers are overwritten once sent.
const std = @import("std")
const ipc = @import("std.ipc")

const NAME: []const u8 = "org.mlx.Login"
const PATH: []const u8 = "/org/mlx/Login"
const INTERFACE: []const u8 = "org.mlx.Login"

pub const MAX_USERS: usize = 64

pub const LOGIN_UNAVAILABLE: u8 = 0
pub const LOGIN_DENIED: u8 = 1
pub const LOGIN_STARTED: u8 = 2

pub const User = struct {
    name: [64]u8
    nameLength: usize
    realName: [128]u8
    realNameLength: usize
    home: [256]u8
    homeLength: usize
    shell: [256]u8
    shellLength: usize
}

pub const Users = struct { list: [MAX_USERS]User, count: usize }

pub const Service = struct {
    client: ipc.Client
    connected: bool
    environment: [*][*]const u8
}

fn bytesAt(address: usize) -> [*]u8 { unsafe { return @ptrFromInt([*]u8, address) } }
fn textAt(address: usize, length: usize) -> []const u8 { unsafe { return @ptrFromInt([*]const u8, address)[0..length] } }

pub fn userAt(users: *Users, index: usize) -> *User {
    unsafe { return @ptrFromInt(*User, @intFromPtr(users) + @offsetOf(Users, "list") + index * @sizeOf(User)) }
}

pub fn nameOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "name"), user.*.nameLength) }
pub fn realNameOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "realName"), user.*.realNameLength) }
pub fn homeOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "home"), user.*.homeLength) }
pub fn shellOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "shell"), user.*.shellLength) }

fn copy(target: [*]u8, capacity: usize, value: []const u8) -> usize {
    var index: usize = 0
    while index < value.length && index < capacity {
        target[index] = value[index]
        index += 1
    }
    return index
}

// Decodes ListUsers()'s a(ssss), independently testable with synthetic
// bytes. Native encoding: the array header is an element count, the
// structs follow with no padding. A malformed reply is rejected whole.
pub fn parseUsers(body: [*]const u8, length: usize, users: *Users) -> bool {
    users.*.count = 0
    var reading = ipc.reader(body, length)
    const count = ipc.readArray(&reading)
    if reading.failed { return false }
    var index: usize = 0
    while index < count {
        const name = ipc.readString(&reading)
        const realName = ipc.readString(&reading)
        const home = ipc.readString(&reading)
        const shell = ipc.readString(&reading)
        if reading.failed || name.length == 0 || name.length > 64 || realName.length > 128 || home.length > 256 || shell.length > 256 {
            users.*.count = 0
            return false
        }
        if users.*.count < MAX_USERS {
            const user = userAt(users, users.*.count)
            user.*.nameLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "name")), 64, name)
            user.*.realNameLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "realName")), 128, realName)
            user.*.homeLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "home")), 256, home)
            user.*.shellLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "shell")), 256, shell)
            users.*.count += 1
        }
        index += 1
    }
    if reading.failed {
        users.*.count = 0
        return false
    }
    return true
}

pub fn init(service: *Service, environment: [*][*]const u8) -> void {
    service.*.connected = false
    service.*.environment = environment
}

// The system bus's address: DBUS_SYSTEM_BUS_ADDRESS's unix:path=, else
// MLXIPC's system bus (the address is shared; the wire is native).
fn busPath(service: *Service) -> []const u8 { return ipc.systemPath(service.*.environment, ipc.MLX_SYSTEM_BUS) }

fn clientOf(service: *Service) -> *ipc.Client { unsafe { return @ptrCast(*ipc.Client, &service.*.client) } }

pub fn connect(service: *Service) -> bool {
    if service.*.connected { ipc.disconnect(clientOf(service), std.heap.allocator()) }
    service.*.connected = ipc.connectClient(clientOf(service), std.heap.allocator(), busPath(service))
    return service.*.connected
}

pub fn close(service: *Service) -> void {
    if service.*.connected { ipc.disconnect(clientOf(service), std.heap.allocator()) }
    service.*.connected = false
}

fn noBody() -> [*]const u8 { unsafe { return @ptrCast([*]const u8, "") } }

// ListUsers() -> a(ssss): the accounts a person may log in as.
pub fn listUsers(service: *Service, users: *Users) -> bool {
    users.*.count = 0
    if !service.*.connected && !connect(service) { return false }
    const client = clientOf(service)
    const serial = ipc.call(client, NAME, PATH, INTERFACE, "ListUsers", "", noBody(), 0)
    var reply: ipc.Message = undefined
    if serial == 0 || !ipc.waitReply(client, serial, &reply, 5000) || reply.kind != ipc.REPLY || !std.text.same(reply.signature, "a(ssss)") { return false }
    return parseUsers(ipc.bodyOf(client, &reply), reply.bodyLength, users)
}

fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

// Login(user, password, session) -> b: whether the session started. The
// password is wiped from every buffer once the call is sent.
pub fn login(service: *Service, user: []const u8, password: []const u8, session: []const u8) -> u8 {
    if !service.*.connected && !connect(service) { return LOGIN_UNAVAILABLE }
    const client = clientOf(service)
    var body: [1024]u8 = undefined
    const bodyBytes: [*]u8 = &body
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, bodyBytes, 1024)
    ipc.putString(&writing, user)
    ipc.putString(&writing, password)
    ipc.putString(&writing, session)
    if writing.failed {
        wipe(bodyBytes, 1024)
        return LOGIN_UNAVAILABLE
    }
    const serial = ipc.call(client, NAME, PATH, INTERFACE, "Login", "sss", bodyBytes, writing.length)
    // The password lives only until the call is sent; wipe every copy.
    wipe(bodyBytes, 1024)
    wipe(client.*.out, ipc.MAX_MESSAGE)
    wipe(ipc.connectionOf(client).*.output, ipc.MAX_MESSAGE)
    var reply: ipc.Message = undefined
    if serial == 0 || !ipc.waitReply(client, serial, &reply, 10000) || reply.kind != ipc.REPLY || !std.text.same(reply.signature, "b") { return LOGIN_UNAVAILABLE }
    var reading = ipc.reader(ipc.bodyOf(client, &reply), reply.bodyLength)
    const accepted = ipc.readBool(&reading)
    if reading.failed { return LOGIN_UNAVAILABLE }
    return if accepted { LOGIN_STARTED } else { LOGIN_DENIED }
}
