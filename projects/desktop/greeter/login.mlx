// The small org.mlx.Login client used by mlx-greeter on MLXIPC's system
// bus. std.dbus is the repository's libc-free wire codec used by MLXIPC,
// not a dependency on dbus-daemon or libdbus. Account data is copied out
// of the receive buffer before another message can replace it. A Login
// call's body and both outgoing buffers are overwritten once sent.
const std = @import("std")
const dbus = @import("std.dbus")

const NAME: []const u8 = "org.mlx.Login"
const PATH: []const u8 = "/org/mlx/Login"
const INTERFACE: []const u8 = "org.mlx.Login"

pub const MAX_USERS: usize = 64

pub const LOGIN_UNAVAILABLE: u8 = 0
pub const LOGIN_DENIED: u8 = 1
pub const LOGIN_STARTED: u8 = 2

pub const User = struct {
    name: [64]u8
    nameLength: usize
    realName: [128]u8
    realNameLength: usize
    home: [256]u8
    homeLength: usize
    shell: [256]u8
    shellLength: usize
}

pub const Users = struct { list: [MAX_USERS]User, count: usize }

pub const Service = struct {
    client: dbus.Client
    connected: bool
    environment: [*][*]const u8
}

fn bytesAt(address: usize) -> [*]u8 { unsafe { return @ptrFromInt([*]u8, address) } }
fn textAt(address: usize, length: usize) -> []const u8 { unsafe { return @ptrFromInt([*]const u8, address)[0..length] } }

pub fn userAt(users: *Users, index: usize) -> *User {
    unsafe { return @ptrFromInt(*User, @intFromPtr(users) + @offsetOf(Users, "list") + index * @sizeOf(User)) }
}

pub fn nameOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "name"), user.*.nameLength) }
pub fn realNameOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "realName"), user.*.realNameLength) }
pub fn homeOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "home"), user.*.homeLength) }
pub fn shellOf(user: *const User) -> []const u8 { return textAt(@intFromPtr(user) + @offsetOf(User, "shell"), user.*.shellLength) }

fn copy(target: [*]u8, capacity: usize, value: []const u8) -> usize {
    var index: usize = 0
    while index < value.length && index < capacity {
        target[index] = value[index]
        index += 1
    }
    return index
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    var index: usize = 0
    while index < prefix.length {
        if text[index] != prefix[index] { return false }
        index += 1
    }
    return true
}

// Decodes ListUsers()'s a(ssss), independently testable with synthetic
// bytes. A malformed or overlong reply is rejected as a whole.
pub fn parseUsers(body: [*]const u8, length: usize, big: bool, users: *Users) -> bool {
    users.*.count = 0
    var reading = dbus.reader(body, length, big)
    const arrayLength = @intCast(usize, dbus.readU32(&reading))
    dbus.alignTo(&reading, 8)
    if reading.failed || reading.position + arrayLength > length { return false }
    const arrayEnd = reading.position + arrayLength
    while reading.position < arrayEnd {
        dbus.alignTo(&reading, 8)
        if reading.position >= arrayEnd { break }
        const name = dbus.readString(&reading)
        const realName = dbus.readString(&reading)
        const home = dbus.readString(&reading)
        const shell = dbus.readString(&reading)
        if reading.failed || reading.position > arrayEnd || name.length == 0 || name.length > 64 || realName.length > 128 || home.length > 256 || shell.length > 256 {
            users.*.count = 0
            return false
        }
        if users.*.count < MAX_USERS {
            const user = userAt(users, users.*.count)
            user.*.nameLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "name")), 64, name)
            user.*.realNameLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "realName")), 128, realName)
            user.*.homeLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "home")), 256, home)
            user.*.shellLength = copy(bytesAt(@intFromPtr(user) + @offsetOf(User, "shell")), 256, shell)
            users.*.count += 1
        }
    }
    if reading.failed || reading.position != arrayEnd {
        users.*.count = 0
        return false
    }
    return true
}

pub fn init(service: *Service, environment: [*][*]const u8) -> void {
    service.*.connected = false
    service.*.environment = environment
}

fn busPath(service: *Service) -> []const u8 {
    const found = std.process.environmentFrom(service.*.environment, "DBUS_SYSTEM_BUS_ADDRESS")
    if found != null {
        const address = std.string.asSlice(found.?)
        if startsWith(address, "unix:path=") {
            var stop: usize = 10
            while stop < address.length && address[stop] != 44 && address[stop] != 59 { stop += 1 }
            return address[10..stop]
        }
    }
    return "/run/mlx/bus"
}

fn clientOf(service: *Service) -> *dbus.Client { unsafe { return @ptrCast(*dbus.Client, &service.*.client) } }

fn connect(service: *Service) -> bool {
    if service.*.connected && !clientOf(service).*.closed { return true }
    if service.*.connected { dbus.disconnect(clientOf(service), std.page_allocator.init()) }
    service.*.connected = dbus.connectClient(clientOf(service), std.page_allocator.init(), busPath(service))
    return service.*.connected
}

pub fn close(service: *Service) -> void {
    if service.*.connected { dbus.disconnect(clientOf(service), std.page_allocator.init()) }
    service.*.connected = false
}

fn noBody() -> [*]const u8 { unsafe { return @ptrCast([*]const u8, "") } }

pub fn listUsers(service: *Service, users: *Users) -> bool {
    users.*.count = 0
    if !connect(service) { return false }
    const client = clientOf(service)
    const serial = dbus.call(client, NAME, PATH, INTERFACE, "ListUsers", "", noBody(), 0)
    var reply: dbus.Header = undefined
    if serial == 0 || !dbus.waitReply(client, serial, &reply, 5000) || reply.kind != dbus.METHOD_RETURN || !same(reply.signature, "a(ssss)") { return false }
    return parseUsers(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big, users)
}

fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

pub fn login(service: *Service, user: []const u8, password: []const u8, session: []const u8) -> u8 {
    if user.length == 0 || user.length > 64 || password.length > 512 || session.length == 0 || session.length > 256 || !connect(service) { return LOGIN_UNAVAILABLE }
    var body: [1024]u8 = undefined
    var bodyBytes: [*]u8 = undefined
    unsafe { bodyBytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bodyBytes, 1024, false)
    dbus.putString(&writing, user)
    dbus.putString(&writing, password)
    dbus.putString(&writing, session)
    if writing.failed {
        wipe(bodyBytes, 1024)
        return LOGIN_UNAVAILABLE
    }
    const client = clientOf(service)
    const serial = dbus.call(client, NAME, PATH, INTERFACE, "Login", "sss", bodyBytes, writing.length)
    wipe(bodyBytes, 1024)
    // dbus.send has flushed a copy into the transport before returning.
    // Do not leave the marshalled password in either reusable page.
    wipe(client.*.out, dbus.MAX_MESSAGE)
    wipe(dbus.connectionOf(client).*.output, dbus.MAX_MESSAGE)
    var reply: dbus.Header = undefined
    if serial == 0 || !dbus.waitReply(client, serial, &reply, 10000) || reply.kind != dbus.METHOD_RETURN || !same(reply.signature, "b") { return LOGIN_UNAVAILABLE }
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    const accepted = dbus.readBool(&reading)
    if reading.failed { return LOGIN_UNAVAILABLE }
    return if accepted { LOGIN_STARTED } else { LOGIN_DENIED }
}
