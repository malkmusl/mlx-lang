// mlx-login's children on brixOS, natively: the daemon branches
// (process_branch), the branch takes the identity (identity_set), its
// directory (directory_set) and a group of its own (group_join), then
// replaces itself with the program (process_replace); a stream pair that
// closes on the replace reports a failure before it (a byte), success
// as its end. The directories a child gets are made here (node_make) and
// given to it (node_own).
const std = @import("std")
const brix = @import("std").os.brix
const activation = @import("../ipc/activation.mlx")
const spawn_module = @import("std.spawn")

pub fn failed(report: u32) -> void {
    var byte: [1]u8 = [1]u8{ 1 }
    _ = brix.write(report, byte[0..1], brix.STREAM)
    brix.exit(127)
}

// The program `path` names (an absolute path, or one found in PATH)
// opened; 0 when none is.
pub fn program(path: []const u8, environment: [*][*]const u8) -> u32 {
    var found: [1024]u8 = undefined
    var name = path
    if path.length == 0 || path[0] != 47 {
        const at = spawn_module.find(path, environment, activation.searchPath(), &found, 1024)
        if at == 0 { return 0 }
        name = found[0..at]
    }
    const opened = brix.open(0, name, brix.Open.READ, 0)
    return if opened < 0 { 0 } else { @intCast(u32, opened) }
}

// Replaces this branch with `node`'s program (its arguments and
// environment), the identity `user`:`group` in `directory`; back only
// when that failed.
pub fn become(user: u32, group: u32, directory: []const u8, node: u32, arguments: [*][*]const u8, environment: [*][*]const u8, report: u32) -> void {
    const home = brix.open(0, directory, brix.Open.READ, 0)
    if home < 0 || brix.setDirectory(@intCast(u32, home)) < 0 { failed(report) }
    _ = brix.close(@intCast(u32, home))
    if brix.joinGroup(0, 0) < 0 { failed(report) }
    if brix.setIdentity(@intCast(usize, user), @intCast(usize, group)) < 0 { failed(report) }
    const begin = brix.Start.{ .arguments = @intFromPtr(arguments), .environment = @intFromPtr(environment), .roles = 0, .count = 0 }
    _ = brix.replace(node, &begin)
    failed(report)
}

// Waits for the branch's report: started (its end, no byte) or not
// (then it is waited for).
pub fn started(child: spawn_module.Child, report: u32) -> bool {
    var byte: [1]u8 = undefined
    const got = brix.read(report, byte[0..1], brix.STREAM)
    _ = brix.close(report)
    if got == 0 { return true }
    _ = spawn_module.wait(child)
    return false
}

// `path` a directory with `mode`, `uid`:`gid`'s (one there already is
// given to them).
pub fn ownedDirectory(path: []const u8, mode: usize, uid: u32, gid: u32) -> bool {
    const made = brix.make(0, path, brix.NodeKind.DIRECTORY, mode, "")
    if made < 0 && made != -brix.Status.exists { return false }
    const opened = brix.open(0, path, brix.Open.READ, 0)
    if opened < 0 { return false }
    const owned = brix.own(@intCast(u32, opened), @intCast(usize, uid), @intCast(usize, gid))
    _ = brix.close(@intCast(u32, opened))
    return owned >= 0
}
