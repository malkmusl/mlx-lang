// The small org.freedesktop.login1 surface the MLX compositor needs.
// mlx-login owns it on MLXIPC's system bus so the compositor can obtain
// device descriptors after it has dropped root and route authorized power
// requests to mlx-init. This is deliberately a one-seat, one-session
// service; it is not a general logind clone.
const std = @import("std")
const dbus = @import("std.dbus")
const init_linux = @import("../../init/linux.mlx")

pub const NAME: []const u8 = "org.freedesktop.login1"
const MANAGER_PATH: []const u8 = "/org/freedesktop/login1"
const SESSION_PATH: []const u8 = "/org/freedesktop/login1/session/seat0"
const SEAT_PATH: []const u8 = "/org/freedesktop/login1/seat/seat0"
const MANAGER: []const u8 = "org.freedesktop.login1.Manager"
const SESSION: []const u8 = "org.freedesktop.login1.Session"
const SEAT: []const u8 = "org.freedesktop.login1.Seat"
const BUS_NAME: []const u8 = "org.freedesktop.DBus"
const IPC_PATH: []const u8 = "/org/mlx/IPC"
const IPC_INTERFACE: []const u8 = "org.mlx.IPC"

const SYS_ioctl: usize = 16
const SYS_close: usize = 3
const SYS_rt_sigprocmask: usize = 14
const SYS_fork: usize = 57
const SYS_kill: usize = 62
const SYS_exit_group: usize = 231
const O_CLOEXEC: usize = 524288
const O_NOCTTY: usize = 256
const VT_ACTIVATE: usize = 22022
const VT_WAITACTIVE: usize = 22023
const FILE_KIND: u32 = 61440
const CHARACTER_DEVICE: u32 = 8192
const CONTROLLER_MOST: usize = 128
const PENDING_MOST: usize = 4
const DEVICE_MOST: usize = 32
const CONTROL_PENDING: u8 = 1
const POWEROFF_PENDING: u8 = 2
const REBOOT_PENDING: u8 = 3

const Pending = struct {
    used: bool
    check: u32
    kind: u8
    serial: u32
    flags: u8
    generation: u32
    sender: [CONTROLLER_MOST]u8
    senderLength: usize
}

const Device = struct {
    used: bool
    major: u32
    minor: u32
}

pub const State = struct {
    controller: [CONTROLLER_MOST]u8
    controllerLength: usize
    ttyPath: []const u8
    initControlPath: []const u8
    allowTestDevice: bool
    activeVT: u32
    generation: u32
    watcherPid: isize
    pending: [PENDING_MOST]Pending
    devices: [DEVICE_MOST]Device
}

fn bytesAt(state: *State, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(state) + offset) }
}

fn pendingAt(state: *State, index: usize) -> *Pending {
    unsafe { return @ptrFromInt(*Pending, @intFromPtr(state) + @offsetOf(State, "pending") + index * @sizeOf(Pending)) }
}

fn deviceAt(state: *State, index: usize) -> *Device {
    unsafe { return @ptrFromInt(*Device, @intFromPtr(state) + @offsetOf(State, "devices") + index * @sizeOf(Device)) }
}

fn pendingBytes(pending: *Pending) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(pending) + @offsetOf(Pending, "sender")) }
}

fn pendingSender(pending: *Pending) -> []const u8 { return pendingBytes(pending)[0..pending.*.senderLength] }

fn controller(state: *State) -> []const u8 {
    return bytesAt(state, @offsetOf(State, "controller"))[0..state.*.controllerLength]
}

fn noDescriptors() -> [*]const isize {
    var result: [*]const isize = undefined
    unsafe { result = @ptrFromInt([*]const isize, 8) }
    return result
}

pub fn init(state: *State, ttyPath: []const u8, allowTestDevice: bool, environment: [*][*]const u8) -> void {
    state.*.controllerLength = 0
    state.*.ttyPath = ttyPath
    const configuredControl = std.process.environmentFrom(environment, "MLX_INIT_CONTROL")
    state.*.initControlPath = if configuredControl == null || configuredControl.?.length == 0 { "/run/mlx/init" } else { std.string.asSlice(configuredControl.?) }
    state.*.allowTestDevice = allowTestDevice
    state.*.activeVT = 1
    state.*.generation = 1
    state.*.watcherPid = -1
    var index: usize = 0
    while index < PENDING_MOST {
        pendingAt(state, index).*.used = false
        index += 1
    }
    index = 0
    while index < DEVICE_MOST {
        deviceAt(state, index).*.used = false
        index += 1
    }
}

fn errorReply(client: *dbus.Client, call: *const dbus.Header, name: []const u8, message: []const u8) -> void {
    var header = dbus.newHeader(dbus.ERROR, 0)
    header.errorName = name
    header.replySerial = call.*.serial
    header.hasReplySerial = true
    header.destination = call.*.sender
    header.signature = "s"
    var body: [512]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &body), 512, call.*.big) }
    dbus.putString(&writing, message)
    unsafe { const sent = dbus.send(client, &header, @ptrCast([*]const u8, &body), writing.length, noDescriptors(), 0) }
}

fn emptyReply(client: *dbus.Client, call: *const dbus.Header) -> void {
    var body: [1]u8 = [1]u8{ 0 }
    unsafe { const sent = dbus.reply(client, call, "", @ptrCast([*]const u8, &body), 0, noDescriptors(), 0) }
}

fn pathReply(client: *dbus.Client, call: *const dbus.Header) -> void {
    var body: [128]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &body), 128, call.*.big) }
    dbus.putString(&writing, SESSION_PATH)
    unsafe { const sent = dbus.reply(client, call, "o", @ptrCast([*]const u8, &body), writing.length, noDescriptors(), 0) }
}

fn stringReply(client: *dbus.Client, call: *const dbus.Header, value: []const u8) -> void {
    var body: [64]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &body), 64, call.*.big) }
    dbus.putString(&writing, value)
    unsafe { const sent = dbus.reply(client, call, "s", @ptrCast([*]const u8, &body), writing.length, noDescriptors(), 0) }
}

fn isController(state: *State, call: *const dbus.Header) -> bool {
    return state.*.controllerLength > 0 && std.text.same(controller(state), call.*.sender)
}

fn requireController(state: *State, client: *dbus.Client, call: *const dbus.Header) -> bool {
    if isController(state, call) { return true }
    errorReply(client, call, "org.freedesktop.DBus.Error.AccessDenied", "TakeControl from the authorized compositor first")
    return false
}

fn parseNone(call: *const dbus.Header) -> bool { return call.*.signature.length == 0 }

fn parseBool(call: *const dbus.Header, body: [*]const u8, value: *bool) -> bool {
    if !std.text.same(call.*.signature, "b") { return false }
    var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
    value.* = dbus.readBool(&reading)
    return !reading.failed
}

fn parseTwoU32(call: *const dbus.Header, body: [*]const u8, first: *u32, second: *u32) -> bool {
    if !std.text.same(call.*.signature, "uu") { return false }
    var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
    first.* = dbus.readU32(&reading)
    second.* = dbus.readU32(&reading)
    return !reading.failed
}

fn powerAvailable(state: *State) -> bool {
    if state.*.initControlPath.length == 0 || state.*.initControlPath.length > 107 { return false }
    // The control protocol explicitly drops clients that close without a
    // request. This probe distinguishes a listener from a stale socket.
    const descriptor = init_linux.connect(state.*.initControlPath)
    if descriptor < 0 { return false }
    init_linux.close(descriptor)
    return true
}

fn requestPower(state: *State, kind: u8) -> bool {
    if kind != POWEROFF_PENDING && kind != REBOOT_PENDING { return false }
    // sockaddr_un has 108 bytes including its family and terminating NUL.
    if state.*.initControlPath.length == 0 || state.*.initControlPath.length > 107 { return false }
    const descriptor = init_linux.connect(state.*.initControlPath)
    if descriptor < 0 { return false }
    const sent = init_linux.writeAll(descriptor, if kind == POWEROFF_PENDING { "poweroff\n" } else { "reboot\n" })
    var response: [64]u8 = undefined
    var length: usize = 0
    var complete = false
    while sent && !complete && length < 64 {
        const received = init_linux.read(descriptor, unsafe { @ptrCast([*]u8, &response) } + length, 64 - length)
        if received <= 0 {
            complete = true
        } else {
            const before = length
            length += @bitCast(usize, received)
            var index = before
            while index < length {
                if response[index] == 10 { complete = true }
                index += 1
            }
        }
    }
    init_linux.close(descriptor)
    return sent && std.text.same(std.text.trimmed(response[0..length]), "ok")
}

fn askPower(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8, kind: u8) -> void {
    var interactive = false
    if !parseBool(call, body, &interactive) || call.*.sender.length == 0 || call.*.sender.length > CONTROLLER_MOST {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "PowerOff and Reboot take one boolean")
        return
    }
    var slot: usize = 0
    while slot < PENDING_MOST && pendingAt(state, slot).*.used { slot += 1 }
    if slot == PENDING_MOST {
        errorReply(client, call, "org.freedesktop.login1.OperationInProgress", "too many power operations await authorization")
        return
    }
    const pending = pendingAt(state, slot)
    pending.*.kind = kind
    pending.*.serial = call.*.serial
    pending.*.flags = call.*.flags
    pending.*.generation = 0
    pending.*.senderLength = std.text.append(pendingBytes(pending), 0, CONTROLLER_MOST, call.*.sender)
    var message: [256]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &message), 256, false) }
    dbus.putString(&writing, pendingSender(pending))
    dbus.putString(&writing, "login.power")
    pending.*.check = dbus.call(client, BUS_NAME, IPC_PATH, IPC_INTERFACE, "Check", "ss", unsafe { @ptrCast([*]const u8, &message) }, writing.length)
    if pending.*.check == 0 {
        pending.*.senderLength = 0
        errorReply(client, call, "org.freedesktop.DBus.Error.AccessDenied", "the bus could not authorize login.power")
        return
    }
    pending.*.used = true
}

fn managerCall(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8, activePid: isize) -> void {
    if std.text.same(call.*.member, "CanPowerOff") || std.text.same(call.*.member, "CanReboot") {
        if !parseNone(call) {
            errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "CanPowerOff and CanReboot take no arguments")
        } else {
            stringReply(client, call, if powerAvailable(state) { "yes" } else { "no" })
        }
        return
    }
    if std.text.same(call.*.member, "PowerOff") || std.text.same(call.*.member, "Reboot") {
        askPower(state, client, call, body, if std.text.same(call.*.member, "PowerOff") { POWEROFF_PENDING } else { REBOOT_PENDING })
        return
    }
    var valid = false
    if std.text.same(call.*.member, "GetSession") && std.text.same(call.*.signature, "s") {
        var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
        const id = dbus.readString(&reading)
        valid = !reading.failed && std.text.same(id, "mlx")
    } else if std.text.same(call.*.member, "GetSessionByPID") && std.text.same(call.*.signature, "u") {
        var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
        const pid = dbus.readU32(&reading)
        valid = !reading.failed && activePid > 0 && @intCast(usize, pid) == @bitCast(usize, activePid)
    } else {
        errorReply(client, call, "org.freedesktop.DBus.Error.UnknownMethod", "mlx-login: no such login1 manager method")
        return
    }
    if !valid {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "invalid login session query")
    } else if activePid <= 0 {
        errorReply(client, call, "org.freedesktop.login1.NoSessionForPID", "there is no active MLX session")
    } else {
        pathReply(client, call)
    }
}

fn askControl(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8, activePid: isize) -> void {
    if activePid <= 0 {
        errorReply(client, call, "org.freedesktop.login1.NoSessionForPID", "there is no active MLX session")
        return
    }
    if !std.text.same(call.*.signature, "b") || call.*.sender.length == 0 || call.*.sender.length > CONTROLLER_MOST {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "TakeControl takes one boolean")
        return
    }
    var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
    const force = dbus.readBool(&reading)
    if reading.failed {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "TakeControl takes one boolean")
        return
    }
    var slot: usize = 0
    while slot < PENDING_MOST && pendingAt(state, slot).*.used { slot += 1 }
    if slot == PENDING_MOST {
        errorReply(client, call, "org.freedesktop.login1.SessionBusy", "too many controllers await authorization")
        return
    }
    const pending = pendingAt(state, slot)
    pending.*.kind = CONTROL_PENDING
    pending.*.serial = call.*.serial
    pending.*.flags = call.*.flags
    pending.*.generation = state.*.generation
    pending.*.senderLength = std.text.append(pendingBytes(pending), 0, CONTROLLER_MOST, call.*.sender)
    var message: [256]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &message), 256, false) }
    dbus.putString(&writing, pendingSender(pending))
    dbus.putString(&writing, "login.device")
    pending.*.check = dbus.call(client, BUS_NAME, IPC_PATH, IPC_INTERFACE, "Check", "ss", @ptrCast([*]const u8, &message), writing.length)
    if pending.*.check == 0 {
        errorReply(client, call, "org.freedesktop.DBus.Error.AccessDenied", "the bus could not authorize login.device")
        return
    }
    pending.*.used = true
}

pub fn answered(state: *State, client: *dbus.Client, reply: *const dbus.Header, active: bool) -> bool {
    var index: usize = 0
    while index < PENDING_MOST {
        const pending = pendingAt(state, index)
        if pending.*.used && pending.*.check == reply.*.replySerial {
            var allowed = false
            if reply.*.kind == dbus.METHOD_RETURN && std.text.same(reply.*.sender, BUS_NAME) && std.text.same(reply.*.signature, "b") {
                var reading = dbus.reader(dbus.bodyOf(client, reply), reply.*.bodyLength, reply.*.big)
                allowed = dbus.readBool(&reading) && !reading.failed
            }
            var call = dbus.newHeader(dbus.METHOD_CALL, pending.*.serial)
            call.flags = pending.*.flags
            call.sender = pendingSender(pending)
            if pending.*.kind == CONTROL_PENDING {
                if !allowed {
                    errorReply(client, &call, "org.freedesktop.DBus.Error.AccessDenied", "this app may not control session devices (login.device)")
                } else if !active || pending.*.generation != state.*.generation {
                    errorReply(client, &call, "org.freedesktop.login1.NoSessionForPID", "the MLX session ended while authorization was pending")
                } else if state.*.controllerLength > 0 && !std.text.same(controller(state), call.sender) {
                    errorReply(client, &call, "org.freedesktop.login1.SessionBusy", "another compositor controls the session")
                } else {
                    state.*.controllerLength = std.text.append(bytesAt(state, @offsetOf(State, "controller")), 0, CONTROLLER_MOST, call.sender)
                    emptyReply(client, &call)
                }
            } else if !allowed {
                errorReply(client, &call, "org.freedesktop.DBus.Error.AccessDenied", "this app may not power off or reboot (login.power)")
            } else if requestPower(state, pending.*.kind) {
                emptyReply(client, &call)
            } else {
                errorReply(client, &call, "org.freedesktop.DBus.Error.Failed", "mlx-init did not accept the power request")
            }
            pending.*.used = false
            pending.*.senderLength = 0
            return true
        }
        index += 1
    }
    return false
}

fn addUnsigned(target: [*]u8, at: usize, value: u32) -> usize {
    var digits: [16]u8 = undefined
    var count: usize = 0
    var left = value
    if left == 0 {
        target[at] = 48
        return at + 1
    }
    while left > 0 {
        digits[count] = @intCast(u8, left % 10) + 48
        count += 1
        left = left / 10
    }
    var written = at
    while count > 0 {
        count -= 1
        target[written] = digits[count]
        written += 1
    }
    return written
}

fn deviceMajor(number: usize) -> u32 {
    return @intCast(u32, ((number >> 8) & 4095) | ((number >> 32) & 4294963200))
}

fn deviceMinor(number: usize) -> u32 {
    return @intCast(u32, (number & 255) | ((number >> 12) & 4294967040))
}

fn isSeatDevice(state: *State, major: u32, minor: u32) -> bool {
    // Linux input and DRM devices are the only character-device classes
    // the compositor owns. In particular, never proxy /dev/mem, kmsg,
    // raw block devices, or arbitrary privileged character devices.
    if major == 13 || major == 226 { return true }
    return state.*.allowTestDevice && major == 1 && minor == 3
}

fn openDevice(state: *State, major: u32, minor: u32) -> isize {
    if !isSeatDevice(state, major, minor) { return -1 }
    var path: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var at = std.text.append(bytes, 0, 64, "/dev/char/")
    at = addUnsigned(bytes, at, major)
    bytes[at] = 58
    at += 1
    at = addUnsigned(bytes, at, minor)
    bytes[at] = 0
    var file = std.fs.open(bytes, std.fs.READ_WRITE | O_CLOEXEC | O_NOCTTY, 0)
    if file.descriptor < 0 { file = std.fs.open(bytes, std.fs.READ_ONLY | O_CLOEXEC | O_NOCTTY, 0) }
    if file.descriptor < 0 { return -1 }
    var status: std.fs.Stat = undefined
    const valid = std.fs.fileStatus(file, &status) == 0 && status.mode & FILE_KIND == CHARACTER_DEVICE && deviceMajor(status.specialDevice) == major && deviceMinor(status.specialDevice) == minor
    if !valid {
        const closed = std.fs.close(file)
        return -1
    }
    return file.descriptor
}

fn rememberDevice(state: *State, major: u32, minor: u32) -> bool {
    var empty = DEVICE_MOST
    var index: usize = 0
    while index < DEVICE_MOST {
        const device = deviceAt(state, index)
        if device.*.used && device.*.major == major && device.*.minor == minor { return true }
        if !device.*.used && empty == DEVICE_MOST { empty = index }
        index += 1
    }
    if empty < DEVICE_MOST {
        const device = deviceAt(state, empty)
        device.*.used = true
        device.*.major = major
        device.*.minor = minor
        return true
    }
    return false
}

fn forgetDevice(state: *State, major: u32, minor: u32) -> void {
    var index: usize = 0
    while index < DEVICE_MOST {
        const device = deviceAt(state, index)
        if device.*.used && device.*.major == major && device.*.minor == minor { device.*.used = false }
        index += 1
    }
}

fn takeDevice(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8) -> void {
    if !requireController(state, client, call) { return }
    var major: u32 = 0
    var minor: u32 = 0
    if !parseTwoU32(call, body, &major, &minor) {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "TakeDevice takes (uu)")
        return
    }
    const descriptor = openDevice(state, major, minor)
    if descriptor < 0 {
        errorReply(client, call, "org.freedesktop.login1.DeviceNotTaken", "the character device could not be opened")
        return
    }
    if !rememberDevice(state, major, minor) {
        const closed = std.fs.close(std.fs.File.{ .descriptor = descriptor })
        errorReply(client, call, "org.freedesktop.login1.DeviceNotTaken", "too many session devices are already tracked")
        return
    }
    var result: [16]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &result), 16, call.*.big) }
    dbus.putU32(&writing, 0)
    dbus.putBool(&writing, false)
    var descriptors: [1]isize = [1]isize{ descriptor }
    unsafe { const sent = dbus.reply(client, call, "hb", @ptrCast([*]const u8, &result), writing.length, @ptrCast([*]const isize, &descriptors), 1) }
}

fn releaseDevice(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8) -> void {
    if !requireController(state, client, call) { return }
    var major: u32 = 0
    var minor: u32 = 0
    if !parseTwoU32(call, body, &major, &minor) {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "the device method takes (uu)")
        return
    }
    if std.text.same(call.*.member, "ReleaseDevice") { forgetDevice(state, major, minor) }
    emptyReply(client, call)
}

fn sendPause(client: *dbus.Client, destination: []const u8, major: u32, minor: u32) -> void {
    var body: [64]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &body), 64, false) }
    dbus.putU32(&writing, major)
    dbus.putU32(&writing, minor)
    // SwitchTo is a synchronous compositor call, so it cannot answer a
    // cooperative "pause" before the call returns. "force" says the
    // service has already made the transition and needs no acknowledgement.
    dbus.putString(&writing, "force")
    var header = dbus.newHeader(dbus.SIGNAL, 0)
    header.path = SESSION_PATH
    header.interface = SESSION
    header.member = "PauseDevice"
    header.signature = "uus"
    header.destination = destination
    unsafe { const sent = dbus.send(client, &header, @ptrCast([*]const u8, &body), writing.length, noDescriptors(), 0) }
}

fn sendResume(state: *State, client: *dbus.Client, destination: []const u8, major: u32, minor: u32) -> void {
    const descriptor = openDevice(state, major, minor)
    if descriptor < 0 { return }
    var body: [16]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &body), 16, false) }
    dbus.putU32(&writing, major)
    dbus.putU32(&writing, minor)
    dbus.putU32(&writing, 0)
    var header = dbus.newHeader(dbus.SIGNAL, 0)
    header.path = SESSION_PATH
    header.interface = SESSION
    header.member = "ResumeDevice"
    header.signature = "uuh"
    header.destination = destination
    var descriptors: [1]isize = [1]isize{ descriptor }
    unsafe { const sent = dbus.send(client, &header, @ptrCast([*]const u8, &body), writing.length, @ptrCast([*]const isize, &descriptors), 1) }
}

fn signalDevices(state: *State, client: *dbus.Client, pause: bool) -> void {
    const destination = controller(state)
    var index: usize = 0
    while index < DEVICE_MOST {
        const device = deviceAt(state, index)
        if device.*.used {
            if pause { sendPause(client, destination, device.*.major, device.*.minor) } else { sendResume(state, client, destination, device.*.major, device.*.minor) }
        }
        index += 1
    }
}

fn stopWatcher(state: *State) -> void {
    if state.*.watcherPid > 0 {
        const killed = std.linux.syscall2(SYS_kill, @bitCast(usize, state.*.watcherPid), 15)
        state.*.watcherPid = -1
    }
}

fn clearControl(state: *State) -> void {
    state.*.controllerLength = 0
    stopWatcher(state)
    var index: usize = 0
    while index < DEVICE_MOST {
        deviceAt(state, index).*.used = false
        index += 1
    }
}

// After the kernel has activated another VT, a tiny root child waits in
// VT_WAITACTIVE for the session VT. Its SIGCHLD wakes the parent's normal
// event loop, which then sends ResumeDevice with fresh descriptors.
fn startWatcher(state: *State, client: *dbus.Client, descriptor: isize) -> bool {
    stopWatcher(state)
    const pid = std.linux.syscall0(SYS_fork)
    if pid == 0 {
        const closedBus = std.linux.syscall1(SYS_close, @bitCast(usize, dbus.descriptorOfClient(client)))
        var none: usize = 0
        const unblocked = std.linux.syscall4(SYS_rt_sigprocmask, 2, @intFromPtr(&none), 0, 8)
        const waited = std.linux.syscall3(SYS_ioctl, @bitCast(usize, descriptor), VT_WAITACTIVE, 1)
        const closedTTY = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
        const exited = std.linux.syscall1(SYS_exit_group, if waited == 0 { 0 } else { 1 })
    }
    if pid < 0 { return false }
    state.*.watcherPid = pid
    return true
}

// Called for non-session children reaped by main.mlx.
pub fn childEnded(state: *State, client: *dbus.Client, pid: isize, status: usize) -> void {
    if pid != state.*.watcherPid { return }
    state.*.watcherPid = -1
    const succeeded = status & 127 == 0 && (status >> 8) & 255 == 0
    if succeeded {
        state.*.activeVT = 1
        if state.*.controllerLength > 0 { signalDevices(state, client, false) }
    }
}

fn switchTo(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8) -> void {
    if !requireController(state, client, call) { return }
    if !std.text.same(call.*.signature, "u") {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "SwitchTo takes one VT number")
        return
    }
    var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
    const number = dbus.readU32(&reading)
    if reading.failed || number == 0 || number > 63 {
        errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "the VT number is outside 1..63")
        return
    }
    const leaving = state.*.activeVT == 1 && number != 1
    const returning = state.*.activeVT != 1 && number == 1
    if leaving { signalDevices(state, client, true) }
    const virtual = std.text.same(state.*.ttyPath, "none")
    var switched = virtual
    if !virtual {
        var path: [512]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &path) }
        if state.*.ttyPath.length + 1 < 512 {
            const length = std.text.append(bytes, 0, 511, state.*.ttyPath)
            bytes[length] = 0
            const tty = std.fs.open(bytes, std.fs.READ_ONLY | O_CLOEXEC | O_NOCTTY, 0)
            if tty.descriptor >= 0 {
                switched = std.linux.syscall3(SYS_ioctl, @bitCast(usize, tty.descriptor), VT_ACTIVATE, @intCast(usize, number)) == 0 &&
                    std.linux.syscall3(SYS_ioctl, @bitCast(usize, tty.descriptor), VT_WAITACTIVE, @intCast(usize, number)) == 0
                if switched && leaving && !startWatcher(state, client, tty.descriptor) {
                    const restored = std.linux.syscall3(SYS_ioctl, @bitCast(usize, tty.descriptor), VT_ACTIVATE, 1)
                    switched = false
                }
                const closed = std.fs.close(tty)
            }
        }
    }
    if switched {
        state.*.activeVT = number
        if returning && (virtual || state.*.watcherPid < 0) { signalDevices(state, client, false) }
        emptyReply(client, call)
    } else {
        // Pause was advisory until VT_ACTIVATE succeeded. Restore the
        // descriptors when the kernel kept this session active.
        if leaving { signalDevices(state, client, false) }
        errorReply(client, call, "org.freedesktop.login1.VTSwitchFailed", "the kernel refused VT_ACTIVATE")
    }
}

fn sessionCall(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8, activePid: isize) -> void {
    if std.text.same(call.*.member, "TakeControl") {
        askControl(state, client, call, body, activePid)
    } else if std.text.same(call.*.member, "ReleaseControl") {
        if !parseNone(call) {
            errorReply(client, call, "org.freedesktop.DBus.Error.InvalidArgs", "ReleaseControl takes no arguments")
        } else if requireController(state, client, call) {
            clearControl(state)
            emptyReply(client, call)
        }
    } else if std.text.same(call.*.member, "TakeDevice") {
        takeDevice(state, client, call, body)
    } else if std.text.same(call.*.member, "ReleaseDevice") || std.text.same(call.*.member, "PauseDeviceComplete") {
        releaseDevice(state, client, call, body)
    } else {
        errorReply(client, call, "org.freedesktop.DBus.Error.UnknownMethod", "mlx-login: no such login1 session method")
    }
}

// Handles one login1 call. False means it belonged to another service.
pub fn called(state: *State, client: *dbus.Client, call: *const dbus.Header, body: [*]const u8, activePid: isize) -> bool {
    if call.*.kind != dbus.METHOD_CALL { return false }
    if std.text.same(call.*.path, MANAGER_PATH) && std.text.same(call.*.interface, MANAGER) {
        managerCall(state, client, call, body, activePid)
        return true
    }
    if std.text.same(call.*.path, SESSION_PATH) && std.text.same(call.*.interface, SESSION) {
        sessionCall(state, client, call, body, activePid)
        return true
    }
    if std.text.same(call.*.path, SEAT_PATH) && std.text.same(call.*.interface, SEAT) {
        if std.text.same(call.*.member, "SwitchTo") { switchTo(state, client, call, body) } else { errorReply(client, call, "org.freedesktop.DBus.Error.UnknownMethod", "mlx-login: no such login1 seat method") }
        return true
    }
    return false
}

pub fn sessionEnded(state: *State) -> void {
    clearControl(state)
    state.*.activeVT = 1
    state.*.generation +%= 1
    if state.*.generation == 0 { state.*.generation = 1 }
}

// A unique bus name disappeared. A dead compositor must not keep the
// session controller capability or block a replacement compositor.
pub fn nameChanged(state: *State, name: []const u8, old: []const u8, new: []const u8) -> void {
    if new.length != 0 { return }
    if state.*.controllerLength > 0 && std.text.same(controller(state), name) { clearControl(state) }
    var index: usize = 0
    while index < PENDING_MOST {
        const pending = pendingAt(state, index)
        if pending.*.used && std.text.same(pendingSender(pending), name) {
            pending.*.used = false
            pending.*.senderLength = 0
        }
        index += 1
    }
}
