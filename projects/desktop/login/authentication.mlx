// Password verification for mlx-login. The configured shadow file is
// treated as hostile input even though production keeps it root-only:
// symlinks, non-regular files, non-root ownership, writable permissions,
// oversized records and unsupported hashes all fail closed.
const std = @import("std")
const crypt = @import("std.crypt")

const REGULAR_FILE: u32 = 32768
const FILE_KIND: u32 = 61440
const GROUP_OR_OTHER_WRITABLE: u32 = 18
const PATH_MOST: usize = 512
const RECORD_MOST: usize = 8192
const PASSWORD_MOST: usize = 1024

fn same(first: [*]const u8, start: usize, end: usize, second: []const u8) -> bool {
    if end - start != second.length { return false }
    var index: usize = 0
    while index < second.length {
        if first[start + index] != second[index] { return false }
        index += 1
    }
    return true
}

fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

fn closeAndWipe(file: isize, bytes: [*]u8) -> void {
    wipe(bytes, RECORD_MOST)
    const ignored = std.linux.syscall1(std.linux.SYS_close, @bitCast(usize, file))
}

// Checks one complete shadow record. `matched` tells the caller that this
// was the requested user even when the account is locked or malformed.
fn record(bytes: [*]u8, start: usize, end: usize, user: []const u8, password: []const u8, matched: *bool) -> bool {
    var first = start
    while first < end && bytes[first] != 58 { first += 1 }
    if first == end || !same(bytes, start, first, user) { return false }
    matched.* = true
    var second = first + 1
    while second < end && bytes[second] != 58 { second += 1 }
    const length = second - first - 1
    if length == 0 || length > crypt.MOST { return false }
    const hash = bytes[first + 1..second]
    if hash[0] == 33 || hash[0] == 42 { return false }
    return crypt.verify(password, hash)
}

// True only for a supported, matching hash in the configured shadow file.
// No error is distinguished from a wrong password at this boundary.
pub fn check(path: []const u8, user: []const u8, password: []const u8) -> bool {
    if path.length == 0 || path.length >= PATH_MOST || user.length == 0 || user.length > 64 || password.length > PASSWORD_MOST { return false }
    var name: [PATH_MOST]u8 = undefined
    var index: usize = 0
    while index < path.length {
        if path[index] == 0 { return false }
        name[index] = path[index]
        index += 1
    }
    name[index] = 0
    const file = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(&name), std.linux.O_RDONLY | std.linux.O_CLOEXEC | std.linux.O_NOFOLLOW, 0)
    if file < 0 { return false }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(std.fs.File.{ .descriptor = file }, &status) != 0 || status.mode & FILE_KIND != REGULAR_FILE || status.user != 0 || status.mode & GROUP_OR_OTHER_WRITABLE != 0 {
        const ignored = std.linux.syscall1(std.linux.SYS_close, @bitCast(usize, file))
        return false
    }
    var buffer: [RECORD_MOST]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var used: usize = 0
    while true {
        var got = std.linux.syscall3(std.linux.SYS_read, @bitCast(usize, file), @intFromPtr(bytes) + used, RECORD_MOST - used)
        while got == std.linux.EINTR { got = std.linux.syscall3(std.linux.SYS_read, @bitCast(usize, file), @intFromPtr(bytes) + used, RECORD_MOST - used) }
        if got < 0 {
            closeAndWipe(file, bytes)
            return false
        }
        const filled = used + @bitCast(usize, got)
        var start: usize = 0
        while start < filled {
            var end = start
            while end < filled && bytes[end] != 10 { end += 1 }
            if end == filled { break }
            var matched = false
            const allowed = record(bytes, start, end, user, password, &matched)
            if matched {
                closeAndWipe(file, bytes)
                return allowed
            }
            start = end + 1
        }
        const remaining = filled - start
        if got == 0 {
            var matched = false
            const allowed = if remaining > 0 { record(bytes, start, filled, user, password, &matched) } else { false }
            closeAndWipe(file, bytes)
            return matched && allowed
        }
        if remaining == RECORD_MOST {
            closeAndWipe(file, bytes)
            return false
        }
        index = 0
        while index < remaining {
            bytes[index] = bytes[start + index]
            index += 1
        }
        used = remaining
    }
    return false
}
