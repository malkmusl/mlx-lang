// The accounts a person may log in as, read from /etc/passwd (which is
// world-readable: it holds no secrets, only the name, uid, gid, full
// name, home and login shell of each account). The password hashes are
// in /etc/shadow, which only the daemon, as root, reads when it checks a
// password (main.mlx, authenticate).
//
// A login account is one with a real shell (not /usr/sbin/nologin or
// /bin/false) and a uid in the human range (>= 1000, below the nobody
// account at 65534), plus root. That is the list the greeter offers.
const std = @import("std")

const SYS_open: usize = 2
const SYS_read: usize = 0
const SYS_close: usize = 3
const O_RDONLY: usize = 0

pub const MAX_USERS: usize = 64
pub const NAME_MOST: usize = 64
pub const PATH_MOST: usize = 256

pub const User = struct {
    name: [NAME_MOST]u8
    nameLength: usize
    // The full name (the GECOS field up to its first comma), for the
    // greeter; the account name when it is empty.
    realName: [NAME_MOST]u8
    realNameLength: usize
    home: [PATH_MOST]u8
    homeLength: usize
    shell: [PATH_MOST]u8
    shellLength: usize
    uid: u32
    gid: u32
}

pub const Users = struct {
    list: [MAX_USERS]User
    count: usize
}

// The account at `index` (Mlx has no &array[i]; the pointer is computed).
pub fn userAt(users: *Users, index: usize) -> *User {
    unsafe { return @ptrFromInt(*User, @intFromPtr(&users.*.list) + index * @sizeOf(User)) }
}

pub fn nameOf(user: *const User) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &user.*.name) }
    return bytes[0..user.*.nameLength]
}

pub fn realNameOf(user: *const User) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &user.*.realName) }
    return bytes[0..user.*.realNameLength]
}

pub fn homeOf(user: *const User) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &user.*.home) }
    return bytes[0..user.*.homeLength]
}

pub fn shellOf(user: *const User) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &user.*.shell) }
    return bytes[0..user.*.shellLength]
}

fn copyField(target: [*]u8, capacity: usize, source: [*]const u8, start: usize, end: usize) -> usize {
    var length: usize = 0
    var index = start
    while index < end && length < capacity {
        target[length] = source[index]
        length += 1
        index += 1
    }
    return length
}

// A decimal field (uid or gid) between `start` and `end`.
fn number(source: [*]const u8, start: usize, end: usize) -> u32 {
    var value: u32 = 0
    var index = start
    while index < end && source[index] >= 48 && source[index] <= 57 {
        value = value * 10 + @intCast(u32, source[index] - 48)
        index += 1
    }
    return value
}

// Whether a shell is a real login shell (not one of the accounts that
// may not log in).
fn loginShell(source: [*]const u8, start: usize, end: usize) -> bool {
    const length = end - start
    if length == 0 { return false }
    if endsWith(source, start, end, "/nologin") { return false }
    if endsWith(source, start, end, "/false") { return false }
    return true
}

fn endsWith(source: [*]const u8, start: usize, end: usize, suffix: []const u8) -> bool {
    if end - start < suffix.length { return false }
    var index: usize = 0
    while index < suffix.length {
        if source[end - suffix.length + index] != suffix[index] { return false }
        index += 1
    }
    return true
}

// The seven colon-separated fields of one /etc/passwd line into `user`;
// false when the line is not a login account.
fn parseLine(source: [*]const u8, start: usize, end: usize, user: *User) -> bool {
    // The field boundaries: fields[i] is where field i starts, fields[7]
    // is `end`.
    var fields: [8]usize = undefined
    fields[0] = start
    var found: usize = 1
    var index = start
    while index < end && found < 8 {
        if source[index] == 58 {
            fields[found] = index + 1
            found += 1
        }
        index += 1
    }
    if found < 7 { return false }
    fields[7] = end + 1
    // name:x:uid:gid:gecos:home:shell
    const uid = number(source, fields[2], fields[3] - 1)
    const gid = number(source, fields[3], fields[4] - 1)
    const shellStart = fields[6]
    const shellEnd = end
    if !loginShell(source, shellStart, shellEnd) { return false }
    // Humans and root; the service accounts in between are left out.
    if uid != 0 && (uid < 1000 || uid >= 65534) { return false }
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &user.*.name) }
    user.*.nameLength = copyField(bytes, NAME_MOST, source, fields[0], fields[1] - 1)
    if user.*.nameLength == 0 { return false }
    unsafe { bytes = @ptrCast([*]u8, &user.*.home) }
    user.*.homeLength = copyField(bytes, PATH_MOST, source, fields[5], fields[6] - 1)
    unsafe { bytes = @ptrCast([*]u8, &user.*.shell) }
    user.*.shellLength = copyField(bytes, PATH_MOST, source, shellStart, shellEnd)
    // The GECOS field up to its first comma; the account name otherwise.
    var realEnd = fields[5] - 1
    var at = fields[4]
    while at < realEnd && source[at] != 44 { at += 1 }
    unsafe { bytes = @ptrCast([*]u8, &user.*.realName) }
    if at > fields[4] {
        user.*.realNameLength = copyField(bytes, NAME_MOST, source, fields[4], at)
    } else {
        user.*.realNameLength = copyField(bytes, NAME_MOST, source, fields[0], fields[1] - 1)
    }
    user.*.uid = uid
    user.*.gid = gid
    return true
}

// Reads /etc/passwd into `users` (the login accounts only): how many, or
// 0 when the file could not be read.
pub fn load(users: *Users) -> usize {
    users.*.count = 0
    var path: [12]u8 = [12]u8{ 47, 101, 116, 99, 47, 112, 97, 115, 115, 119, 100, 0 }
    var pathBytes: [*]const u8 = undefined
    unsafe { pathBytes = @ptrCast([*]const u8, &path) }
    const file = std.linux.syscall3(SYS_open, @intFromPtr(pathBytes), O_RDONLY, 0)
    if file < 0 { return 0 }
    var buffer: [65536]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var filled: usize = 0
    while filled < 65536 {
        const got = std.linux.syscall3(SYS_read, @bitCast(usize, file), @intFromPtr(bytes) + filled, 65536 - filled)
        if got <= 0 { break }
        filled += @bitCast(usize, got)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, file))
    var start: usize = 0
    while start < filled && users.*.count < MAX_USERS {
        var end = start
        while end < filled && bytes[end] != 10 { end += 1 }
        if end > start && bytes[start] != 35 {
            if parseLine(bytes, start, end, userAt(users, users.*.count)) { users.*.count += 1 }
        }
        start = end + 1
    }
    return users.*.count
}

// The account named `name`, or MAX_USERS when there is none.
pub fn find(users: *Users, name: []const u8) -> usize {
    var index: usize = 0
    while index < users.*.count {
        if same(nameOf(userAt(users, index)), name) { return index }
        index += 1
    }
    return MAX_USERS
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}
