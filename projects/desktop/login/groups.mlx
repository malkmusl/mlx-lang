// Supplementary groups for a login session, read without libc from the
// configured group file. The primary gid is always first and duplicate
// memberships are collapsed before setgroups(2).
const std = @import("std")

const PATH_MOST: usize = 512
const RECORD_MOST: usize = 8192
const REGULAR_FILE: u32 = 32768
const FILE_KIND: u32 = 61440
const GROUP_OR_OTHER_WRITABLE: u32 = 18

fn same(bytes: [*]const u8, start: usize, end: usize, text: []const u8) -> bool {
    if end - start != text.length { return false }
    var index: usize = 0
    while index < text.length {
        if bytes[start + index] != text[index] { return false }
        index += 1
    }
    return true
}

fn number(bytes: [*]const u8, start: usize, end: usize, value: *u32) -> bool {
    if start == end { return false }
    var result: usize = 0
    var index = start
    while index < end {
        if bytes[index] < 48 || bytes[index] > 57 { return false }
        result = result * 10 + @intCast(usize, bytes[index] - 48)
        if result > 4294967295 { return false }
        index += 1
    }
    value.* = @intCast(u32, result)
    return true
}

fn contains(groups: [*]u32, count: usize, gid: u32) -> bool {
    var index: usize = 0
    while index < count {
        if groups[index] == gid { return true }
        index += 1
    }
    return false
}

fn member(bytes: [*]const u8, start: usize, end: usize, user: []const u8) -> bool {
    var at = start
    while at <= end {
        var stop = at
        while stop < end && bytes[stop] != 44 { stop += 1 }
        if same(bytes, at, stop, user) { return true }
        at = stop + 1
    }
    return false
}

fn record(bytes: [*]const u8, start: usize, end: usize, user: []const u8, groups: [*]u32, count: *usize, capacity: usize) -> void {
    var first = start
    while first < end && bytes[first] != 58 { first += 1 }
    var second = first + 1
    while second < end && bytes[second] != 58 { second += 1 }
    var third = second + 1
    while third < end && bytes[third] != 58 { third += 1 }
    if first == end || second == end || third == end || !member(bytes, third + 1, end, user) { return }
    var gid: u32 = 0
    if number(bytes, second + 1, third, &gid) && !contains(groups, count.*, gid) && count.* < capacity {
        groups[count.*] = gid
        count.* += 1
    }
}

// Loads `user`'s groups and includes `primary`. False means the file could
// not be trusted or read completely; callers must not retain root groups.
pub fn load(path: []const u8, user: []const u8, primary: u32, groups: [*]u32, count: *usize, capacity: usize) -> bool {
    count.* = 0
    if capacity == 0 || path.length == 0 || path.length >= PATH_MOST || user.length == 0 { return false }
    groups[0] = primary
    count.* = 1
    var name: [PATH_MOST]u8 = undefined
    var index: usize = 0
    while index < path.length {
        if path[index] == 0 { return false }
        name[index] = path[index]
        index += 1
    }
    name[index] = 0
    const file = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(&name), std.linux.O_RDONLY | std.linux.O_CLOEXEC | std.linux.O_NOFOLLOW, 0)
    if file < 0 { return false }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(std.fs.File.{ .descriptor = file }, &status) != 0 || status.mode & FILE_KIND != REGULAR_FILE || status.user != 0 || status.mode & GROUP_OR_OTHER_WRITABLE != 0 {
        const ignored = std.linux.syscall1(std.linux.SYS_close, @bitCast(usize, file))
        return false
    }
    var buffer: [RECORD_MOST]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var used: usize = 0
    while true {
        var got = std.linux.syscall3(std.linux.SYS_read, @bitCast(usize, file), @intFromPtr(bytes) + used, RECORD_MOST - used)
        while got == std.linux.EINTR { got = std.linux.syscall3(std.linux.SYS_read, @bitCast(usize, file), @intFromPtr(bytes) + used, RECORD_MOST - used) }
        if got < 0 {
            const ignored = std.linux.syscall1(std.linux.SYS_close, @bitCast(usize, file))
            count.* = 0
            return false
        }
        const filled = used + @bitCast(usize, got)
        var start: usize = 0
        while start < filled {
            var end = start
            while end < filled && bytes[end] != 10 { end += 1 }
            if end == filled { break }
            if end > start && bytes[start] != 35 { record(bytes, start, end, user, groups, count, capacity) }
            start = end + 1
        }
        const remaining = filled - start
        if got == 0 {
            if remaining > 0 && bytes[start] != 35 { record(bytes, start, filled, user, groups, count, capacity) }
            const ignored = std.linux.syscall1(std.linux.SYS_close, @bitCast(usize, file))
            return true
        }
        if remaining == RECORD_MOST {
            const ignored = std.linux.syscall1(std.linux.SYS_close, @bitCast(usize, file))
            count.* = 0
            return false
        }
        index = 0
        while index < remaining {
            bytes[index] = bytes[start + index]
            index += 1
        }
        used = remaining
    }
    return false
}
