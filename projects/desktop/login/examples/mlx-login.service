# mlx-login under systemd. The installer makes this unit the
# display-manager.service alias only when explicitly asked with --enable.
[Unit]
Description=MLX login and seat service
Documentation=file://@DOCDIR@/README.md
Requires=mlx-ipcd.service
After=mlx-ipcd.service

[Service]
ExecStart=@BINDIR@/mlx-login --greeter @BINDIR@/mlx-compositor @BINDIR@/mlx-greeter
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical.target
Alias=display-manager.service
