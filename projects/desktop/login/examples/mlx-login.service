# mlx-login under systemd. The installer makes this unit the
# display-manager.service alias only when explicitly asked with --enable.
[Unit]
Description=MLX login and seat service
Documentation=file://@DOCDIR@/README.md
Requires=mlx-ipcd.service
# The greeter compositor owns tty1.  Without an explicit conflict the
# distribution getty starts a moment later and steals the same VT.
Conflicts=getty@tty1.service
After=mlx-ipcd.service getty@tty1.service

[Service]
ExecStart=@BINDIR@/mlx-login --greeter @BINDIR@/mlx-compositor @BINDIR@/mlx-greeter
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical.target
Alias=display-manager.service
