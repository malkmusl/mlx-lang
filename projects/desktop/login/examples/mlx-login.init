# mlx-login under mlx-init (projects/init): the login and seat service,
# after the system bus and the optional network daemon. Installed as
# /etc/mlx/init/services/mlx-login.service.
description = MLX login and seat service
exec = @BINDIR@/mlx-login --greeter @BINDIR@/mlx-compositor @BINDIR@/mlx-greeter
after = mlx-ipcd mlx-netd
