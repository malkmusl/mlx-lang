// mlx-login: the desktop's login service, the replacement for a display
// manager (SDDM, GDM) and for the part of systemd-logind that starts a
// user's session. It runs as root, owns org.mlx.Login on the MLXIPC
// system bus (mlx-ipcd --system), and the greeter (mlx-greeter, the
// compositor in greeter mode) talks to it over that bus. No PAM, no
// logind, no libc.
//
//     mlx4 projects/desktop/login/main.mlx -o mlx-login
//     mlx-login --verbose              (as root; from its systemd unit)
//
// The bus methods (org.mlx.Login, path /org/mlx/Login):
//
//     ListUsers() -> a(ssss)            name, full name, home, shell, for
//                                       each login account of /etc/passwd
//     Login(s user, s password, s session) -> b
//                                       checks the password and, on a
//                                       match, starts `session` as `user`;
//                                       true when the session began
//     Unlock(s user, s password) -> b   checks the password of the user
//                                       who already has the seat (the lock
//                                       screen asks this); never starts
//                                       anything
//
// What this file does NOT contain, and why: the two steps that need
// root's power are left as the functions `authenticate` and
// `startSession` below, each a stub that returns NOT_CONFIGURED with a
// full description of how to fill it in. They read /etc/shadow and change
// the process's user; writing that belongs to whoever runs this on their
// own machine, not to this scaffold. Everything around them -- the bus,
// the accounts, the greeter protocol, the failure delays -- is here and
// works, so the daemon builds, owns its name and answers ListUsers today;
// Login and Unlock answer with an error until the two functions are
// filled in.
const std = @import("std")
const dbus = @import("std.dbus")
const crash = @import("std.crash")
const crypt = @import("std.crypt")
const users_module = @import("./users.mlx")

const SYS_read: usize = 0
const SYS_nanosleep: usize = 35
const SYS_rt_sigprocmask: usize = 14
const SYS_signalfd4: usize = 289
const SYS_getuid: usize = 102

const LOGIN_NAME: []const u8 = "org.mlx.Login"
const LOGIN_PATH: []const u8 = "/org/mlx/Login"
const LOGIN_INTERFACE: []const u8 = "org.mlx.Login"

// How long a wrong password holds the answer back, to slow guessing
// (milliseconds). The daemon sleeps this long before every "no".
const FAILURE_DELAY_MS: usize = 2000

const Failure = error { Usage, NotRoot, NoBus, NoMemory }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    if message.length > 0 { const said = std.io.eprintln(message) }
    return failure
}

// What a login attempt comes to.
const DENIED: u8 = 0
const ALLOWED: u8 = 1
const NOT_CONFIGURED: u8 = 2

const Login = struct {
    client: dbus.Client
    users: users_module.Users
    environment: [*][*]const u8
    verbose: bool
    running: bool
    // Who holds the seat now (empty: nobody logged in). Unlock checks the
    // password of this user only.
    active: [users_module.NAME_MOST]u8
    activeLength: usize
}

fn clientOf(login: *Login) -> *dbus.Client {
    unsafe { return @ptrCast(*dbus.Client, &login.*.client) }
}

fn usersOf(login: *Login) -> *users_module.Users {
    unsafe { return @ptrCast(*users_module.Users, &login.*.users) }
}

fn say(login: *Login, text: []const u8) -> void {
    if login.*.verbose { const ignored = std.io.writeAll(std.io.stdout(), text) }
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// Sleeps `milliseconds` (the delay after a wrong password).
fn sleep(milliseconds: usize) -> void {
    var spec: [2]usize = [2]usize{ milliseconds / 1000, (milliseconds % 1000) * 1000000 }
    const slept = std.linux.syscall2(SYS_nanosleep, @intFromPtr(&spec), 0)
}

// ===========================================================================
// THE TWO PRIVILEGED STEPS -- fill these in on your own machine.
//
// They are the only places that read a password hash or change the
// process's user. The rest of mlx-login never touches either, so these
// two functions are the whole of what a login needs that this scaffold
// leaves out. Each returns NOT_CONFIGURED as it stands, which makes Login
// and Unlock answer with org.mlx.Login.Error.NotConfigured.
// ===========================================================================

// STEP 1 -- CHECK THE PASSWORD.
//
// Return ALLOWED when `password` is `user`'s password, DENIED when it is
// not, and keep NOT_CONFIGURED until this is written.
//
// How to write it (no libc needed; everything is a std call):
//
//   1. Open /etc/shadow (std.linux.syscall3 SYS_open, O_RDONLY). Only
//      root can; the daemon is root. If the open fails, return DENIED.
//   2. Read the file into a stack buffer (as users.mlx reads
//      /etc/passwd) and find the line that starts with `user` followed
//      by ':'. Its second colon-separated field is the stored hash.
//   3. A field of "" means no password is set (depending on policy,
//      refuse: return DENIED). A field starting with '!' or '*' is a
//      locked account: return DENIED.
//   4. Return `if crypt.verify(password, hash) { ALLOWED } else { DENIED }`.
//      std.crypt.verify already handles $y$ (yescrypt, Ubuntu's default),
//      $6$, $5$ and does the comparison in constant time.
//   5. Wipe the buffer that held the hash and the password bytes
//      afterwards (crypt.sha2.wipe, or a plain loop to 0): they are the
//      secret.
//
// Keep the shadow buffer out of any log and never put the hash or the
// password in a reply or an error message.
fn authenticate(login: *Login, user: []const u8, password: []const u8) -> u8 {
    // Leave this line until the body above is written.
    return NOT_CONFIGURED
}

// STEP 2 -- START THE SESSION AS THE USER.
//
// `index` is the account in login.*.users (already looked up).
// `session` is the command the greeter asked to run (the compositor, or
// what a .desktop session entry names). Return ALLOWED once the session
// has been started, DENIED when it could not be, NOT_CONFIGURED until
// written.
//
// How to write it:
//
//   1. fork (std.linux.syscall0 SYS_fork). The parent records the child
//      as the seat's session (set login.*.active to the user's name) and
//      returns ALLOWED; everything from here is the child.
//   2. In the child, become a session leader: SYS_setsid (112).
//   3. Drop to the user, GROUPS FIRST, then gid, then uid -- the order
//      matters, since after setuid you may no longer change the others:
//        - SYS_setgroups (116) with the user's supplementary groups (read
//          them from /etc/group: the groups whose member list contains
//          the name; the user's own gid too). Without this a logged-in
//          user would keep root's groups.
//        - SYS_setgid (106) with user.gid.
//        - SYS_setuid (105) with user.uid.
//      Check each return value; if any fails, _exit non-zero (do NOT go
//      on as root).
//   4. Build the environment for the session: HOME=user's home,
//      USER and LOGNAME=name, SHELL=user's shell,
//      PATH=/usr/local/bin:/usr/bin:/bin, XDG_RUNTIME_DIR=/run/mlx/user/<uid>
//      (make that directory 0700 owned by the user before dropping
//      privilege), XDG_SESSION_TYPE=wayland, and the seat variables the
//      session wants (XDG_SEAT=seat0, XDG_VTNR of the VT the greeter was
//      on). Keep it small and explicit; do not pass root's environment on.
//   5. chdir to the user's home (SYS_chdir 80).
//   6. execve `session` (projects/desktop/ipc/activation.mlx has `execute`,
//      which looks a program up in PATH and execve's it -- reuse it).
//      execve only returns on failure; then _exit non-zero.
//
// The seat (the VT, the DRM card, the input devices) is handed to the
// session's compositor the way it already expects: the compositor's
// logind client (projects/desktop/compositor/logind.mlx) asks
// org.freedesktop.login1 on the system bus for the devices and VT
// switching. A fuller mlx-login answers that interface too (TakeControl,
// TakeDevice, SwitchTo); until then, run the session's compositor on a
// VT it opens directly, as it does now without logind.
fn startSession(login: *Login, index: usize, session: []const u8) -> u8 {
    // Leave this line until the body above is written.
    return NOT_CONFIGURED
}

// ===========================================================================
// The bus side: it never sees a password beyond handing it to
// authenticate, and never a uid change beyond calling startSession.
// ===========================================================================

fn notConfigured(login: *Login, call: *const dbus.Header) -> void {
    sendError(login, call, "org.mlx.Login.Error.NotConfigured", "mlx-login: the password check or the session start is not configured on this machine (projects/desktop/login/main.mlx: authenticate, startSession)")
}

fn sendError(login: *Login, call: *const dbus.Header, name: []const u8, message: []const u8) -> void {
    var header = dbus.newHeader(dbus.ERROR, 0)
    header.errorName = name
    header.replySerial = call.*.serial
    header.hasReplySerial = true
    header.destination = call.*.sender
    header.signature = "s"
    var body: [512]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &body), 512, call.*.big) }
    dbus.putString(&writing, message)
    var nothing: [1]isize = [1]isize{ 0 }
    unsafe { const sent = dbus.send(clientOf(login), &header, @ptrCast([*]const u8, &body), writing.length, @ptrCast([*]const isize, &nothing), 0) }
}

fn replyBool(login: *Login, call: *const dbus.Header, value: bool) -> void {
    var body: [8]u8 = undefined
    var writing: dbus.Writer = undefined
    unsafe { dbus.begin(&writing, @ptrCast([*]u8, &body), 8, call.*.big) }
    dbus.putBool(&writing, value)
    var header = dbus.newHeader(dbus.METHOD_RETURN, 0)
    header.replySerial = call.*.serial
    header.hasReplySerial = true
    header.destination = call.*.sender
    header.signature = "b"
    var nothing: [1]isize = [1]isize{ 0 }
    unsafe { const sent = dbus.send(clientOf(login), &header, @ptrCast([*]const u8, &body), writing.length, @ptrCast([*]const isize, &nothing), 0) }
}

// ListUsers() -> a(ssss): the login accounts.
fn listUsers(login: *Login, call: *const dbus.Header) -> void {
    const memory = std.page_allocator.init().alloc(dbus.MAX_MESSAGE, 16)
    if memory == null {
        sendError(login, call, "org.mlx.Login.Error.NoMemory", "out of memory")
        return
    }
    var body: [*]u8 = undefined
    unsafe { body = @ptrCast([*]u8, memory.?) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, body, dbus.MAX_MESSAGE, call.*.big)
    const array = dbus.beginArray(&writing, 8)
    var index: usize = 0
    while index < login.*.users.count {
        const user = users_module.userAt(usersOf(login), index)
        dbus.pad(&writing, 8)
        dbus.putString(&writing, users_module.nameOf(user))
        dbus.putString(&writing, users_module.realNameOf(user))
        dbus.putString(&writing, users_module.homeOf(user))
        dbus.putString(&writing, users_module.shellOf(user))
        index += 1
    }
    dbus.endArray(&writing, array, 8)
    var header = dbus.newHeader(dbus.METHOD_RETURN, 0)
    header.replySerial = call.*.serial
    header.hasReplySerial = true
    header.destination = call.*.sender
    header.signature = "a(ssss)"
    var nothing: [1]isize = [1]isize{ 0 }
    unsafe { const sent = dbus.send(clientOf(login), &header, body, writing.length, @ptrCast([*]const isize, &nothing), 0) }
    std.page_allocator.init().free(memory.?, dbus.MAX_MESSAGE, 16)
}

// Login(user, password, session): check, then start.
fn handleLogin(login: *Login, call: *const dbus.Header, body: [*]const u8) -> void {
    var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
    const user = dbus.readString(&reading)
    const password = dbus.readString(&reading)
    const session = dbus.readString(&reading)
    if reading.failed {
        sendError(login, call, "org.freedesktop.DBus.Error.InvalidArgs", "Login takes (sss)")
        return
    }
    const index = users_module.find(usersOf(login), user)
    if index >= login.*.users.count {
        sleep(FAILURE_DELAY_MS)
        say(login, "login: no such account\n")
        replyBool(login, call, false)
        return
    }
    const checked = authenticate(login, user, password)
    if checked == NOT_CONFIGURED {
        notConfigured(login, call)
        return
    }
    if checked != ALLOWED {
        sleep(FAILURE_DELAY_MS)
        say(login, "login: wrong password\n")
        replyBool(login, call, false)
        return
    }
    const started = startSession(login, index, session)
    if started == NOT_CONFIGURED {
        notConfigured(login, call)
        return
    }
    replyBool(login, call, started == ALLOWED)
}

// Unlock(user, password): the lock screen, for the user who has the seat.
fn unlock(login: *Login, call: *const dbus.Header, body: [*]const u8) -> void {
    var reading = dbus.reader(body, call.*.bodyLength, call.*.big)
    const user = dbus.readString(&reading)
    const password = dbus.readString(&reading)
    if reading.failed {
        sendError(login, call, "org.freedesktop.DBus.Error.InvalidArgs", "Unlock takes (ss)")
        return
    }
    var active: [*]const u8 = undefined
    unsafe { active = @ptrCast([*]const u8, &login.*.active) }
    if login.*.activeLength == 0 || !same(active[0..login.*.activeLength], user) {
        sleep(FAILURE_DELAY_MS)
        replyBool(login, call, false)
        return
    }
    const checked = authenticate(login, user, password)
    if checked == NOT_CONFIGURED {
        notConfigured(login, call)
        return
    }
    if checked != ALLOWED { sleep(FAILURE_DELAY_MS) }
    replyBool(login, call, checked == ALLOWED)
}

fn dispatch(login: *Login) -> void {
    var header: dbus.Header = undefined
    while dbus.next(clientOf(login), &header, 0) {
        const body = dbus.bodyOf(clientOf(login), &header)
        if header.kind == dbus.METHOD_CALL && same(header.interface, LOGIN_INTERFACE) {
            if same(header.member, "ListUsers") {
                listUsers(login, &header)
            } else if same(header.member, "Login") {
                handleLogin(login, &header, body)
            } else if same(header.member, "Unlock") {
                unlock(login, &header, body)
            } else if header.flags & dbus.NO_REPLY_EXPECTED == 0 {
                sendError(login, &header, "org.freedesktop.DBus.Error.UnknownMethod", "mlx-login: no such method")
            }
        }
    }
    if login.*.client.closed { login.*.running = false }
}

fn connectName(login: *Login) -> bool {
    // The system bus: DBUS_SYSTEM_BUS_ADDRESS, else /run/mlx/bus.
    var path: [256]u8 = undefined
    var pathBytes: [*]u8 = undefined
    unsafe { pathBytes = @ptrCast([*]u8, &path) }
    var length: usize = 0
    const address = std.process.environmentFrom(login.*.environment, "DBUS_SYSTEM_BUS_ADDRESS")
    if address != null {
        const text = std.string.asSlice(address.?)
        var at: usize = 0
        if text.length > 10 { at = 10 }
        while at < text.length && length + 1 < 256 {
            pathBytes[length] = text[at]
            length += 1
            at += 1
        }
    } else {
        const fixed = "/run/mlx/bus"
        while length < fixed.length {
            pathBytes[length] = fixed[length]
            length += 1
        }
    }
    if !dbus.connectClient(clientOf(login), std.page_allocator.init(), pathBytes[0..length]) { return false }
    // RequestName(org.mlx.Login, DO_NOT_QUEUE): body (su).
    var requestBody: [64]u8 = undefined
    var requestBytes: [*]u8 = undefined
    unsafe { requestBytes = @ptrCast([*]u8, &requestBody) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, requestBytes, 64, false)
    dbus.putString(&writing, LOGIN_NAME)
    dbus.putU32(&writing, 4)
    const serial = dbus.call(clientOf(login), "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "RequestName", "su", requestBytes, writing.length)
    var reply: dbus.Header = undefined
    if serial == 0 || !dbus.waitReply(clientOf(login), serial, &reply, 5000) { return false }
    return reply.kind == dbus.METHOD_RETURN
}

fn run(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    var verbose = false
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if std.string.eql(argument, std.string.fromSlice("--verbose")) {
            verbose = true
        } else {
            try fail("usage: mlx-login [--verbose]", Failure.Usage)
        }
        index += 1
    }
    if std.linux.syscall0(SYS_getuid) != 0 {
        try fail("mlx-login: must run as root (it reads /etc/shadow and starts sessions)", Failure.NotRoot)
    }
    const memory = allocator.alloc(@sizeOf(Login), 16)
    if memory == null { try fail("mlx-login: out of memory", Failure.NoMemory) }
    var login: *Login = undefined
    unsafe { login = @ptrCast(*Login, memory.?) }
    login.*.environment = std.process.environmentEntries(arguments)
    login.*.verbose = verbose
    login.*.running = true
    login.*.activeLength = 0
    const found = users_module.load(usersOf(login))
    say(login, "login: read the accounts of /etc/passwd\n")
    if !connectName(login) {
        try fail("mlx-login: could not own org.mlx.Login on the system bus (is mlx-ipcd --system running?)", Failure.NoBus)
    }
    say(login, "login: org.mlx.Login on the system bus; waiting for the greeter\n")
    dispatch(login)
    while login.*.running {
        if dbus.waitReady(dbus.descriptorOfClient(clientOf(login)), false, -1) > 0 { dispatch(login) }
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    const installed = crash.install()
    try run(arguments)
}
