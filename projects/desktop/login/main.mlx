// sentinel: the desktop's login service, the replacement for a display
// manager (SDDM, GDM) and for the part of systemd-logind that starts a
// user's session. It runs as root, owns org.mlx.Login on the MLXIPC
// system bus (synapse --system), and the greeter (aurora, the
// compositor in greeter mode) talks to it over that bus. No PAM, no
// logind, no libc.
//
//     mlx4 projects/desktop/login/main.mlx -o sentinel
//     sentinel --verbose              (as root; from its systemd unit)
//
// The bus methods (org.mlx.Login, path /org/mlx/Login):
//
//     ListUsers() -> a(ssss)            name, full name, home, shell, from
//                                       the configured passwd file
//     Login(s user, s password, s session) -> b
//                                       checks the password and, on a
//                                       match, starts `session` as `user`;
//                                       true when the session began
//     Unlock(s user, s password) -> b   checks the password of the user
//                                       who already has the seat (the lock
//                                       screen asks this), for that user
//                                       alone; never starts anything
//
// Login and Unlock first ask MLXIPC for login.session. Unlock then asks
// the bus who the caller is: the user the kernel named when the caller
// connected (the channel's peer on brixOS, the socket's credentials on
// Linux), never a name the caller gives. Only the person who holds the
// seat (or root) has their password checked. Password hashes are checked
// in authentication.mlx without libc and every copied password is wiped.
// session.mlx starts the process only after dropping every root
// credential and reports exec failure to the parent.
const std = @import("std")
const builtin = @import("builtin")
const brix = @import("std").os.brix
const ipc = @import("std.ipc")
const crash = @import("std.crash")
const authentication = @import("./authentication.mlx")
const greeter_module = @import("./greeter.mlx")
const login1 = @import("./login1.mlx")
const power = @import("./power.mlx")
const session_module = @import("./session.mlx")
const spawn_module = @import("std.spawn")
const users_module = @import("./users.mlx")

const LOGIN_NAME: []const u8 = "org.mlx.Login"
const LOGIN_PATH: []const u8 = "/org/mlx/Login"
const LOGIN_INTERFACE: []const u8 = "org.mlx.Login"
const BUS_NAME: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const IPC_PATH: []const u8 = "/org/mlx/IPC"
const IPC_INTERFACE: []const u8 = "org.mlx.IPC"

// How long a wrong password holds the answer back, to slow guessing
// (milliseconds). The daemon sleeps this long before every "no".
const FAILURE_DELAY_MS: usize = 2000

const Failure = error { Usage, NotRoot, NoBus, NoMemory, NoSignals, NoGreeter }

fn fail(message: []const u8, failure: Failure) -> Failure!void {
    if message.length > 0 { const said = std.io.eprintln(message) }
    return failure
}

// What a login attempt comes to.
const DENIED: u8 = 0
const ALLOWED: u8 = 1

const LOGIN_CALL: u8 = 1
const UNLOCK_CALL: u8 = 2
// What a waiting call asked the bus last: whether its app may
// (org.mlx.IPC.Check), then, for Unlock, who its caller is.
const ASKED_PERMISSION: u8 = 1
const ASKED_CALLER: u8 = 2
const PENDING_MOST: usize = 8
const PASSWORD_MOST: usize = 1024
const SESSION_MOST: usize = 256
const SENDER_MOST: usize = 128

// A protected call waits here while MLXIPC decides login.session (and,
// for Unlock, names the caller's user). Its password is a bounded copy
// because the bus receive buffer may be reused before the bus answers;
// release wipes every byte on every outcome.
const Pending = struct {
    used: bool
    // The serial of the question the bus has now, and which one it is.
    check: u32
    asked: u8
    kind: u8
    serial: u32
    flags: u8
    sender: [SENDER_MOST]u8
    senderLength: usize
    user: [users_module.NAME_MOST]u8
    userLength: usize
    password: [PASSWORD_MOST]u8
    passwordLength: usize
    session: [SESSION_MOST]u8
    sessionLength: usize
}

const Login = struct {
    client: ipc.Client
    login1State: login1.State
    users: users_module.Users
    environment: [*][*]const u8
    // The command-line slice points into argv, which lives for the
    // process. Authentication reads this path for every protected attempt.
    shadowPath: []const u8
    groupPath: []const u8
    runtimeRoot: []const u8
    verbose: bool
    running: bool
    // Who holds the seat now (empty: nobody logged in). Unlock checks the
    // password of this user only, and only for a caller who is this user.
    active: [users_module.NAME_MOST]u8
    activeLength: usize
    activeUid: u32
    // The session (Linux: its pid; brixOS: its process handle).
    session: spawn_module.Child
    // The compositor that owns the seat while no person is logged in.
    // Empty commands disable lifecycle management (useful to isolated
    // clients and checks that exercise only the bus API).
    greeterCompositor: []const u8
    greeterProgram: []const u8
    greeterUid: u32
    greeterGid: u32
    greeter: spawn_module.Child
    pending: [PENDING_MOST]Pending
}

fn clientOf(login: *Login) -> *ipc.Client {
    unsafe { return @ptrCast(*ipc.Client, &login.*.client) }
}

fn usersOf(login: *Login) -> *users_module.Users {
    unsafe { return @ptrCast(*users_module.Users, &login.*.users) }
}

fn login1Of(login: *Login) -> *login1.State {
    unsafe { return @ptrFromInt(*login1.State, @intFromPtr(login) + @offsetOf(Login, "login1State")) }
}

fn pendingAt(login: *Login, index: usize) -> *Pending {
    unsafe { return @ptrFromInt(*Pending, @intFromPtr(login) + @offsetOf(Login, "pending") + index * @sizeOf(Pending)) }
}

fn pendingBytes(pending: *Pending, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(pending) + offset) }
}

fn senderOf(pending: *Pending) -> []const u8 { return pendingBytes(pending, @offsetOf(Pending, "sender"))[0..pending.*.senderLength] }
fn pendingUser(pending: *Pending) -> []const u8 { return pendingBytes(pending, @offsetOf(Pending, "user"))[0..pending.*.userLength] }
fn pendingPassword(pending: *Pending) -> []const u8 { return pendingBytes(pending, @offsetOf(Pending, "password"))[0..pending.*.passwordLength] }
fn pendingSession(pending: *Pending) -> []const u8 { return pendingBytes(pending, @offsetOf(Pending, "session"))[0..pending.*.sessionLength] }

fn wipe(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 0
        index += 1
    }
}

fn wipeSlice(value: []const u8) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrFromInt([*]u8, @intFromPtr(value)) }
    wipe(bytes, value.length)
}

fn release(pending: *Pending) -> void {
    wipe(pendingBytes(pending, @offsetOf(Pending, "user")), users_module.NAME_MOST)
    wipe(pendingBytes(pending, @offsetOf(Pending, "password")), PASSWORD_MOST)
    wipe(pendingBytes(pending, @offsetOf(Pending, "session")), SESSION_MOST)
    pending.*.userLength = 0
    pending.*.passwordLength = 0
    pending.*.sessionLength = 0
    pending.*.used = false
}

fn say(login: *Login, text: []const u8) -> void {
    if login.*.verbose { const ignored = std.io.writeAll(std.io.stdout(), text) }
}

// Sleeps `milliseconds` (the delay after a wrong password).
fn sleep(milliseconds: usize) -> void {
    var spec: [2]usize = [2]usize{ milliseconds / 1000, (milliseconds % 1000) * 1000000 }
    const slept = std.linux.syscall2(std.linux.SYS_nanosleep, @intFromPtr(&spec), 0)
}

fn busAddress(login: *Login) -> []const u8 {
    const configured = std.process.environmentFrom(login.*.environment, "DBUS_SYSTEM_BUS_ADDRESS")
    return if configured == null { "unix:path=/run/mlx/bus" } else { std.string.asSlice(configured.?) }
}

fn greeterConfigured(login: *Login) -> bool { return login.*.greeterCompositor.length > 0 && login.*.greeterProgram.length > 0 }

fn seatPid(login: *Login) -> isize {
    if login.*.session.started() { return login.*.session.id }
    return if login.*.greeter.started() { login.*.greeter.id } else { -1 }
}

fn startGreeter(login: *Login) -> bool {
    if !greeterConfigured(login) || login.*.activeLength > 0 || login.*.greeter.started() { return true }
    var config = greeter_module.Config.{
        .compositor = login.*.greeterCompositor,
        .program = login.*.greeterProgram,
        .runtimeRoot = login.*.runtimeRoot,
        .busAddress = busAddress(login),
        .environment = login.*.environment,
        .busDescriptor = ipc.descriptorOfClient(clientOf(login)),
        .uid = login.*.greeterUid,
        .gid = login.*.greeterGid
    }
    const child = greeter_module.start(&config)
    if !child.started() {
        say(login, "login: greeter could not be started\n")
        return false
    }
    login.*.greeter = child
    say(login, "login: greeter started\n")
    return true
}

fn stopGreeter(login: *Login) -> void {
    if !login.*.greeter.started() { return }
    const child = login.*.greeter
    login.*.greeter = spawn_module.Child.none()
    // Revoke the old compositor before the user's compositor can ask for
    // control; waiting for NameOwnerChanged would leave a race here.
    login1.sessionEnded(login1Of(login))
    greeter_module.stop(child)
    say(login, "login: greeter stopped\n")
}

// ===========================================================================
// THE TWO PRIVILEGED STEPS.
//
// They are the only places that read a password hash or change the
// process's user.
// ===========================================================================

// STEP 1 -- CHECK THE PASSWORD.
//
// authentication.mlx opens the configured shadow file without following
// a final symlink, verifies its ownership and mode, streams bounded
// records, rejects empty/locked/unsupported hashes and wipes its buffer.
fn authenticate(login: *Login, user: []const u8, password: []const u8) -> u8 {
    return if authentication.check(login.*.shadowPath, user, password) { ALLOWED } else { DENIED }
}

// STEP 2 -- START THE SESSION AS THE USER.
//
// `index` is the account already looked up; `session` is one executable.
// session.mlx loads supplementary groups, creates the private runtime
// directory, forks, calls setsid, setgroups, setgid and setuid in that
// order, builds an explicit environment, changes home and reuses MLXIPC's
// PATH-aware exec helper. A close-on-exec pipe makes failures synchronous.
fn startSession(login: *Login, index: usize, session: []const u8) -> u8 {
    if login.*.activeLength > 0 { return DENIED }
    const user = users_module.userAt(usersOf(login), index)
    const child = session_module.start(user, session, login.*.groupPath, login.*.runtimeRoot, busAddress(login), login.*.environment, ipc.descriptorOfClient(clientOf(login)))
    if !child.started() { return DENIED }
    login.*.activeLength = std.text.append(unsafe { @ptrCast([*]u8, &login.*.active) }, 0, users_module.NAME_MOST, users_module.nameOf(user))
    login.*.activeUid = user.*.uid
    login.*.session = child
    say(login, "login: session started\n")
    return ALLOWED
}

// ===========================================================================
// The bus side: it never sees a password beyond handing it to
// authenticate, and never a uid change beyond calling startSession.
// ===========================================================================

fn sendError(login: *Login, call: *const ipc.Message, name: []const u8, message: []const u8) -> void {
    const sent = ipc.replyError(clientOf(login), call, name, message)
}

fn replyBool(login: *Login, call: *const ipc.Message, value: bool) -> void {
    var body: [8]u8 = undefined
    var writing: ipc.Writer = undefined
    unsafe { ipc.begin(&writing, @ptrCast([*]u8, &body), 8) }
    ipc.putBool(&writing, value)
    var nothing: [1]isize = [1]isize{ 0 }
    unsafe { const sent = ipc.reply(clientOf(login), call, "b", unsafe { @ptrCast([*]const u8, &body) }, writing.length, @ptrCast([*]const isize, &nothing), 0) }
}

// ListUsers() -> a(ssss): the login accounts.
fn listUsers(login: *Login, call: *const ipc.Message) -> void {
    const memory = std.heap.allocator().alloc(ipc.MAX_MESSAGE, 16)
    if memory == null {
        sendError(login, call, "org.mlx.Login.Error.NoMemory", "out of memory")
        return
    }
    var body: [*]u8 = undefined
    unsafe { body = @ptrCast([*]u8, memory.?) }
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, body, ipc.MAX_MESSAGE)
    const array = ipc.beginArray(&writing)
    var index: usize = 0
    while index < login.*.users.count {
        const user = users_module.userAt(usersOf(login), index)
        ipc.putString(&writing, users_module.nameOf(user))
        ipc.putString(&writing, users_module.realNameOf(user))
        ipc.putString(&writing, users_module.homeOf(user))
        ipc.putString(&writing, users_module.shellOf(user))
        index += 1
    }
    ipc.endArray(&writing, array, login.*.users.count)
    var nothing: [1]isize = [1]isize{ 0 }
    unsafe { const sent = ipc.reply(clientOf(login), call, "a(ssss)", body, writing.length, @ptrCast([*]const isize, &nothing), 0) }
    std.heap.allocator().free(memory.?, ipc.MAX_MESSAGE, 16)
}

// Performs a call only after MLXIPC allowed login.session. `caller` is
// the user the bus says an Unlock's caller is (Login does not ask).
fn perform(login: *Login, call: *const ipc.Message, pending: *Pending, caller: u32) -> void {
    const user = pendingUser(pending)
    if pending.*.kind == LOGIN_CALL {
        if login.*.activeLength > 0 {
            replyBool(login, call, false)
            return
        }
        const index = users_module.find(usersOf(login), user)
        if index >= login.*.users.count {
            sleep(FAILURE_DELAY_MS)
            say(login, "login: credentials refused\n")
            replyBool(login, call, false)
            return
        }
        const checked = authenticate(login, user, pendingPassword(pending))
        if checked != ALLOWED {
            sleep(FAILURE_DELAY_MS)
            say(login, "login: credentials refused\n")
            replyBool(login, call, false)
            return
        }
        stopGreeter(login)
        const started = startSession(login, index, pendingSession(pending))
        if started != ALLOWED && !startGreeter(login) { login.*.running = false }
        replyBool(login, call, started == ALLOWED)
        return
    }
    // Unlock: the caller must name the person who holds the seat and be
    // that person (root may ask for them). Anyone else gets the slow "no"
    // of a wrong password, and no password is checked for them.
    var active: [*]const u8 = undefined
    unsafe { active = @ptrCast([*]const u8, &login.*.active) }
    if login.*.activeLength == 0 || !std.text.same(active[0..login.*.activeLength], user) {
        sleep(FAILURE_DELAY_MS)
        replyBool(login, call, false)
        return
    }
    if caller != 0 && caller != login.*.activeUid {
        sleep(FAILURE_DELAY_MS)
        say(login, "login: unlock refused: the caller is not the session's user\n")
        replyBool(login, call, false)
        return
    }
    const checked = authenticate(login, user, pendingPassword(pending))
    if checked != ALLOWED { sleep(FAILURE_DELAY_MS) }
    say(login, if checked == ALLOWED { "login: unlock allowed\n" } else { "login: unlock refused\n" })
    replyBool(login, call, checked == ALLOWED)
}

fn sessionGone(login: *Login) -> void {
    wipe(unsafe { @ptrCast([*]u8, &login.*.active) }, users_module.NAME_MOST)
    login.*.activeLength = 0
    login.*.activeUid = 0
    login.*.session = spawn_module.Child.none()
    login1.sessionEnded(login1Of(login))
    say(login, "login: session ended; the seat is free\n")
    if !startGreeter(login) { login.*.running = false }
}

fn greeterGone(login: *Login) -> void {
    login.*.greeter = spawn_module.Child.none()
    login1.sessionEnded(login1Of(login))
    say(login, "login: greeter ended\n")
    if login.*.activeLength == 0 {
        sleep(500)
        if !startGreeter(login) { login.*.running = false }
    }
}

// The children that ended: the session, the greeter (Linux: also
// login1's VT watcher, by wait4).
fn reapSession(login: *Login) -> void {
    if comptime builtin.os == builtin.Os.brixos {
        var ending: spawn_module.Ending = undefined
        if login.*.session.started() && spawn_module.ended(login.*.session, &ending) { sessionGone(login) }
        if login.*.greeter.started() && spawn_module.ended(login.*.greeter, &ending) { greeterGone(login) }
        return
    }
    var status: usize = 0
    var pid = std.linux.syscall4(std.linux.SYS_wait4, 18446744073709551615, @intFromPtr(&status), 1, 0)
    while pid > 0 {
        if login.*.session.started() && pid == login.*.session.id {
            sessionGone(login)
        } else if login.*.greeter.started() && pid == login.*.greeter.id {
            greeterGone(login)
        } else {
            login1.childEnded(login1Of(login), clientOf(login), pid, status)
        }
        pid = std.linux.syscall4(std.linux.SYS_wait4, 18446744073709551615, @intFromPtr(&status), 1, 0)
    }
}

// Asks MLXIPC about login.session. Arguments are copied before the Check
// call and the password in the receive buffer is wiped immediately.
fn askPermission(login: *Login, call: *const ipc.Message, body: [*]const u8, kind: u8) -> void {
    const wanted = if kind == LOGIN_CALL { "sss" } else { "ss" }
    if !std.text.same(call.*.signature, wanted) {
        sendError(login, call, "org.freedesktop.DBus.Error.InvalidArgs", if kind == LOGIN_CALL { "Login takes (sss)" } else { "Unlock takes (ss)" })
        return
    }
    var reading = ipc.reader(body, call.*.bodyLength)
    const user = ipc.readString(&reading)
    const password = ipc.readString(&reading)
    var session: []const u8 = ""
    if kind == LOGIN_CALL { session = ipc.readString(&reading) }
    if reading.failed || user.length == 0 || user.length > users_module.NAME_MOST || password.length > PASSWORD_MOST || session.length > SESSION_MOST || call.*.sender.length == 0 || call.*.sender.length > SENDER_MOST {
        wipeSlice(password)
        sendError(login, call, "org.freedesktop.DBus.Error.InvalidArgs", if kind == LOGIN_CALL { "Login takes bounded (sss) values" } else { "Unlock takes bounded (ss) values" })
        return
    }
    var slot: usize = 0
    while slot < PENDING_MOST && pendingAt(login, slot).*.used { slot += 1 }
    if slot == PENDING_MOST {
        wipeSlice(password)
        sendError(login, call, "org.mlx.Login.Error.Busy", "too many login requests wait for the bus")
        return
    }
    const pending = pendingAt(login, slot)
    pending.*.kind = kind
    pending.*.serial = call.*.serial
    pending.*.flags = call.*.flags
    pending.*.senderLength = std.text.append(pendingBytes(pending, @offsetOf(Pending, "sender")), 0, SENDER_MOST, call.*.sender)
    pending.*.userLength = std.text.append(pendingBytes(pending, @offsetOf(Pending, "user")), 0, users_module.NAME_MOST, user)
    pending.*.passwordLength = std.text.append(pendingBytes(pending, @offsetOf(Pending, "password")), 0, PASSWORD_MOST, password)
    pending.*.sessionLength = std.text.append(pendingBytes(pending, @offsetOf(Pending, "session")), 0, SESSION_MOST, session)
    wipeSlice(password)
    var message: [256]u8 = undefined
    var writing: ipc.Writer = undefined
    unsafe { ipc.begin(&writing, @ptrCast([*]u8, &message), 256) }
    ipc.putString(&writing, senderOf(pending))
    ipc.putString(&writing, "login.session")
    pending.*.check = ipc.call(clientOf(login), BUS_NAME, IPC_PATH, IPC_INTERFACE, "Check", "ss", unsafe { @ptrCast([*]const u8, &message) }, writing.length)
    pending.*.asked = ASKED_PERMISSION
    if pending.*.check == 0 {
        release(pending)
        sendError(login, call, "org.freedesktop.DBus.Error.AccessDenied", "the bus could not authorize login.session")
        return
    }
    pending.*.used = true
}

// Asks the bus which user the waiting Unlock's caller is. The bus knows
// from the kernel (the peer of the caller's channel on brixOS, its
// socket's credentials on Linux), so no name the caller gives and no
// variable of its environment decides whose password is checked. False
// when the question could not be sent.
fn askCaller(login: *Login, pending: *Pending) -> bool {
    var message: [160]u8 = undefined
    var writing: ipc.Writer = undefined
    unsafe { ipc.begin(&writing, @ptrCast([*]u8, &message), 160) }
    ipc.putString(&writing, senderOf(pending))
    pending.*.check = ipc.call(clientOf(login), BUS_NAME, BUS_PATH, BUS_NAME, "GetConnectionUnixUser", "s", unsafe { @ptrCast([*]const u8, &message) }, writing.length)
    pending.*.asked = ASKED_CALLER
    return pending.*.check != 0
}

// The bus answered a waiting call's question: whether its app may use
// login.session, then (Unlock) who its caller is. Anything but a plain
// answer from the bus itself refuses the call.
fn permissionAnswered(login: *Login, reply: *const ipc.Message) -> bool {
    var slot: usize = 0
    while slot < PENDING_MOST {
        const pending = pendingAt(login, slot)
        if pending.*.used && pending.*.check == reply.*.replySerial {
            const fromBus = reply.*.kind == ipc.REPLY && std.text.same(reply.*.sender, BUS_NAME)
            var call = ipc.newMessage(ipc.CALL, pending.*.serial)
            call.flags = pending.*.flags
            call.sender = senderOf(pending)
            if pending.*.asked == ASKED_CALLER {
                var known = false
                var caller: u32 = 0
                if fromBus && std.text.same(reply.*.signature, "u") {
                    var reading = ipc.reader(ipc.bodyOf(clientOf(login), reply), reply.*.bodyLength)
                    caller = ipc.readU32(&reading)
                    known = !reading.failed
                }
                if known {
                    perform(login, &call, pending, caller)
                } else {
                    sendError(login, &call, "org.freedesktop.DBus.Error.AccessDenied", "the bus could not name the caller's user")
                    say(login, "login: unlock refused: the caller's user is not known\n")
                }
                release(pending)
                return true
            }
            var allowed = false
            if fromBus && std.text.same(reply.*.signature, "b") {
                var reading = ipc.reader(ipc.bodyOf(clientOf(login), reply), reply.*.bodyLength)
                allowed = ipc.readBool(&reading) && !reading.failed
            }
            if !allowed {
                sendError(login, &call, "org.freedesktop.DBus.Error.AccessDenied", "this app may not start or unlock a session (login.session)")
                say(login, "login: login.session refused\n")
            } else if pending.*.kind == UNLOCK_CALL {
                // The call waits on, now for its caller's user.
                if askCaller(login, pending) { return true }
                sendError(login, &call, "org.freedesktop.DBus.Error.AccessDenied", "the bus could not name the caller's user")
                say(login, "login: unlock refused: the caller's user is not known\n")
            } else {
                perform(login, &call, pending, 0)
            }
            release(pending)
            return true
        }
        slot += 1
    }
    return false
}

// Who holds the seat: the person logged in, else the greeter's user while
// the greeter runs (-1: nobody). The one user who may have the machine
// restarted or shut down (power.mlx).
fn seatUser(login: *Login) -> isize {
    if login.*.activeLength > 0 {
        var active: [*]const u8 = undefined
        unsafe { active = @ptrCast([*]const u8, &login.*.active) }
        const index = users_module.find(usersOf(login), active[0..login.*.activeLength])
        return if index < login.*.users.count { @intCast(isize, users_module.userAt(usersOf(login), index).*.uid) } else { -1 }
    }
    return if login.*.greeter.started() { @intCast(isize, login.*.greeterUid) } else { -1 }
}

// The machine restarted or shut down, as power.mlx allowed: the seat's
// compositor ends first (told to, it leaves its last frame for the
// shutdown's screen), then the init is asked. The init stops this service
// with the others; when it does not take the request the seat is the
// greeter's again.
fn endSystem(login: *Login, kind: u8) -> void {
    stopGreeter(login)
    if login.*.session.started() {
        const child = login.*.session
        login.*.session = spawn_module.Child.none()
        wipe(unsafe { @ptrCast([*]u8, &login.*.active) }, users_module.NAME_MOST)
        login.*.activeLength = 0
        login.*.activeUid = 0
        login1.sessionEnded(login1Of(login))
        greeter_module.stop(child)
        say(login, "login: session stopped\n")
    }
    if power.request(kind, login.*.environment) {
        say(login, if kind == power.RESTART { "login: the init restarts the machine\n" } else { "login: the init powers the machine off\n" })
    } else {
        say(login, "login: the init did not take the request\n")
        if !startGreeter(login) { login.*.running = false }
    }
}

fn dispatch(login: *Login) -> void {
    reapSession(login)
    var header: ipc.Message = undefined
    while ipc.next(clientOf(login), &header, 0) {
        // Restart and power off (power.mlx): the calls and the bus's
        // answers about who called. An allowed one ends the system.
        const asked = power.message(clientOf(login), &header, seatUser(login), login.*.environment, login.*.verbose)
        if asked == power.RESTART || asked == power.POWER_OFF { endSystem(login, asked) }
        if asked != power.NOT_MINE { continue }
        const body = ipc.bodyOf(clientOf(login), &header)
        if header.kind == ipc.CALL && std.text.same(header.path, LOGIN_PATH) && std.text.same(header.interface, LOGIN_INTERFACE) {
            if std.text.same(header.member, "ListUsers") {
                listUsers(login, &header)
            } else if std.text.same(header.member, "Login") {
                askPermission(login, &header, body, LOGIN_CALL)
            } else if std.text.same(header.member, "Unlock") {
                askPermission(login, &header, body, UNLOCK_CALL)
            } else if header.flags & ipc.NO_REPLY_EXPECTED == 0 {
                sendError(login, &header, "org.freedesktop.DBus.Error.UnknownMethod", "sentinel: no such method")
            }
        } else if header.kind == ipc.CALL && login1.called(login1Of(login), clientOf(login), &header, body, seatPid(login)) {
            // login1 answered it.
        } else if header.kind == ipc.SIGNAL && std.text.same(header.path, BUS_PATH) && std.text.same(header.interface, BUS_NAME) && std.text.same(header.member, "NameOwnerChanged") && std.text.same(header.signature, "sss") {
            var reading = ipc.reader(body, header.bodyLength)
            const name = ipc.readString(&reading)
            const old = ipc.readString(&reading)
            const new = ipc.readString(&reading)
            if !reading.failed { login1.nameChanged(login1Of(login), name, old, new) }
        } else if (header.kind == ipc.REPLY || header.kind == ipc.ERROR) && header.replySerial != 0 {
            const handled = permissionAnswered(login, &header)
            if !handled { const ignored = login1.answered(login1Of(login), clientOf(login), &header, seatPid(login) > 0) }
        }
    }
    if login.*.client.closed { login.*.running = false }
}

fn requestName(login: *Login, name: []const u8) -> bool {
    var requestBody: [64]u8 = undefined
    var requestBytes: [*]u8 = undefined
    unsafe { requestBytes = @ptrCast([*]u8, &requestBody) }
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, requestBytes, 64)
    ipc.putString(&writing, name)
    ipc.putU32(&writing, 4)
    const serial = ipc.call(clientOf(login), BUS_NAME, BUS_PATH, BUS_NAME, "RequestName", "su", requestBytes, writing.length)
    var reply: ipc.Message = undefined
    if serial == 0 || !ipc.waitReply(clientOf(login), serial, &reply, 5000) { return false }
    if reply.kind != ipc.REPLY || !std.text.same(reply.sender, BUS_NAME) || !std.text.same(reply.signature, "u") { return false }
    var reading = ipc.reader(ipc.bodyOf(clientOf(login), &reply), reply.bodyLength)
    return ipc.readU32(&reading) == 1 && !reading.failed
}

fn watchOwners(login: *Login) -> bool {
    const rule = "type='signal',sender='org.freedesktop.DBus',interface='org.freedesktop.DBus',member='NameOwnerChanged'"
    var body: [256]u8 = undefined
    var writing: ipc.Writer = undefined
    unsafe { ipc.begin(&writing, @ptrCast([*]u8, &body), 256) }
    ipc.putString(&writing, rule)
    const serial = ipc.call(clientOf(login), BUS_NAME, BUS_PATH, BUS_NAME, "AddMatch", "s", unsafe { @ptrCast([*]const u8, &body) }, writing.length)
    var reply: ipc.Message = undefined
    if serial == 0 || !ipc.waitReply(clientOf(login), serial, &reply, 5000) { return false }
    return reply.kind == ipc.REPLY && std.text.same(reply.sender, BUS_NAME)
}

fn connectName(login: *Login) -> bool {
    // The system bus: DBUS_SYSTEM_BUS_ADDRESS, else /run/mlx/bus.
    var path: [256]u8 = undefined
    var pathBytes: [*]u8 = undefined
    unsafe { pathBytes = @ptrCast([*]u8, &path) }
    var length: usize = 0
    const address = std.process.environmentFrom(login.*.environment, "DBUS_SYSTEM_BUS_ADDRESS")
    if address != null {
        const text = std.string.asSlice(address.?)
        var at: usize = 0
        if text.length > 10 { at = 10 }
        while at < text.length && length + 1 < 256 {
            pathBytes[length] = text[at]
            length += 1
            at += 1
        }
    } else {
        const fixed = "/run/mlx/bus"
        while length < fixed.length {
            pathBytes[length] = fixed[length]
            length += 1
        }
    }
    if !ipc.connectClient(clientOf(login), std.heap.allocator(), pathBytes[0..length]) { return false }
    return requestName(login, LOGIN_NAME) && requestName(login, login1.NAME) && watchOwners(login)
}

// SIGCHLD must wake the daemon even when nobody calls the bus: that is
// what releases the seat and lets the greeter lifecycle start again.
fn signalDescriptor() -> isize {
    // brixOS: no signal descriptor; the wait looks at the children each
    // turn instead (its one wait takes a deadline).
    if comptime builtin.os == builtin.Os.brixos { return -1 }
    var mask: u64 = (1 << 1) | (1 << 14) | (1 << 16)
    const blocked = std.linux.syscall4(std.linux.SYS_rt_sigprocmask, 0, @intFromPtr(&mask), 0, 8)
    if blocked != 0 { return -1 }
    return std.linux.syscall4(std.linux.SYS_signalfd4, 18446744073709551615, @intFromPtr(&mask), 8, 526336)
}

fn takeSignal(descriptor: isize) -> u32 {
    var information: [128]u8 = undefined
    const count = std.fs.read(std.fs.File.{ .descriptor = descriptor }, &information, 128)
    if count < 128 { return 0 }
    return @intCast(u32, information[0]) | (@intCast(u32, information[1]) << 8)
}

fn ready(entry: u64) -> bool { return (entry >> 48) & 25 != 0 }

fn wait(login: *Login, signals: isize) -> void {
    if comptime builtin.os == builtin.Os.brixos {
        // The native wait: the bus, and the children's ends.
        var items: [3]brix.WaitItem = undefined
        items[0] = brix.WaitItem.{ .handle = @intCast(u32, @bitCast(usize, ipc.descriptorOfClient(clientOf(login))) & 0xFFFFFFFF), .want = brix.State.READABLE | brix.State.PEER_GONE, .seen = 0, .reserved = 0 }
        var count: usize = 1
        if login.*.session.started() {
            items[count] = brix.WaitItem.{ .handle = @intCast(u32, login.*.session.id), .want = brix.State.ENDED, .seen = 0, .reserved = 0 }
            count += 1
        }
        if login.*.greeter.started() {
            items[count] = brix.WaitItem.{ .handle = @intCast(u32, login.*.greeter.id), .want = brix.State.ENDED, .seen = 0, .reserved = 0 }
            count += 1
        }
        const woken = brix.wait(items[0..count], brix.FOREVER)
        reapSession(login)
        if login.*.running && woken > 0 && items[0].seen & (brix.State.READABLE | brix.State.PEER_GONE) != 0 { dispatch(login) }
        return
    }
    var entries: [2]u64 = undefined
    entries[0] = @intCast(u64, @bitCast(u32, @intCast(i32, ipc.descriptorOfClient(clientOf(login))))) | (1 << 32)
    entries[1] = @intCast(u64, @bitCast(u32, @intCast(i32, signals))) | (1 << 32)
    const waited = std.linux.syscall3(std.linux.SYS_poll, @intFromPtr(&entries), 2, 18446744073709551615)
    if waited < 0 { return }
    if ready(entries[1]) {
        var number = takeSignal(signals)
        while number != 0 {
            if number == 17 {
                reapSession(login)
            } else if number == 2 || number == 15 {
                login.*.running = false
            }
            number = takeSignal(signals)
        }
    }
    if login.*.running && ready(entries[0]) { dispatch(login) }
}

fn parseId(text: []const u8, value: *u32) -> bool {
    if text.length == 0 { return false }
    var result: u32 = 0
    var index: usize = 0
    while index < text.length {
        if text[index] < 48 || text[index] > 57 { return false }
        const digit = @intCast(u32, text[index] - 48)
        if result > 429496729 || result == 429496729 && digit > 5 { return false }
        result = result * 10 + digit
        index += 1
    }
    if result == 0 { return false }
    value.* = result
    return true
}

fn run(arguments: [][*]const u8) -> !void {
    const allocator = std.heap.allocator()
    var verbose = false
    var passwdPath: []const u8 = "/etc/passwd"
    var shadowPath: []const u8 = "/etc/shadow"
    var groupPath: []const u8 = "/etc/group"
    var runtimeRoot: []const u8 = "/run/mlx/user"
    var ttyPath: []const u8 = "/dev/tty0"
    var allowTestDevice = false
    var greeterCompositor: []const u8 = ""
    var greeterProgram: []const u8 = ""
    var greeterUid: u32 = 65534
    var greeterGid: u32 = 65534
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if std.string.eql(argument, std.string.fromSlice("--verbose")) {
            verbose = true
        } else if std.string.eql(argument, std.string.fromSlice("--passwd")) && index + 1 < count {
            index += 1
            passwdPath = std.string.asSlice(std.process.argument(arguments, index))
        } else if std.string.eql(argument, std.string.fromSlice("--shadow")) && index + 1 < count {
            index += 1
            shadowPath = std.string.asSlice(std.process.argument(arguments, index))
        } else if std.string.eql(argument, std.string.fromSlice("--group")) && index + 1 < count {
            index += 1
            groupPath = std.string.asSlice(std.process.argument(arguments, index))
        } else if std.string.eql(argument, std.string.fromSlice("--runtime-dir")) && index + 1 < count {
            index += 1
            runtimeRoot = std.string.asSlice(std.process.argument(arguments, index))
        } else if std.string.eql(argument, std.string.fromSlice("--tty")) && index + 1 < count {
            index += 1
            ttyPath = std.string.asSlice(std.process.argument(arguments, index))
        } else if std.string.eql(argument, std.string.fromSlice("--test-device-null")) {
            allowTestDevice = true
        } else if std.string.eql(argument, std.string.fromSlice("--greeter")) && index + 2 < count {
            index += 1
            greeterCompositor = std.string.asSlice(std.process.argument(arguments, index))
            index += 1
            greeterProgram = std.string.asSlice(std.process.argument(arguments, index))
        } else if std.string.eql(argument, std.string.fromSlice("--greeter-uid")) && index + 1 < count {
            index += 1
            if !parseId(std.string.asSlice(std.process.argument(arguments, index)), &greeterUid) { try fail("sentinel: --greeter-uid needs a nonzero numeric uid", Failure.Usage) }
        } else if std.string.eql(argument, std.string.fromSlice("--greeter-gid")) && index + 1 < count {
            index += 1
            if !parseId(std.string.asSlice(std.process.argument(arguments, index)), &greeterGid) { try fail("sentinel: --greeter-gid needs a nonzero numeric gid", Failure.Usage) }
        } else {
            try fail("usage: sentinel [--verbose] [--passwd FILE] [--shadow FILE] [--group FILE] [--runtime-dir DIR] [--tty FILE|none] [--test-device-null] [--greeter COMPOSITOR PROGRAM] [--greeter-uid UID] [--greeter-gid GID]", Failure.Usage)
        }
        index += 1
    }
    if passwdPath.length == 0 || passwdPath.length >= users_module.DATABASE_PATH_MOST || shadowPath.length == 0 || shadowPath.length >= users_module.DATABASE_PATH_MOST || groupPath.length == 0 || groupPath.length >= users_module.DATABASE_PATH_MOST || runtimeRoot.length == 0 || runtimeRoot.length >= users_module.DATABASE_PATH_MOST || ttyPath.length == 0 || ttyPath.length >= users_module.DATABASE_PATH_MOST || greeterCompositor.length >= users_module.DATABASE_PATH_MOST || greeterProgram.length >= users_module.DATABASE_PATH_MOST || (greeterCompositor.length == 0) != (greeterProgram.length == 0) {
        try fail("sentinel: account database path is empty or too long", Failure.Usage)
    }
    if std.process.userId() != 0 {
        try fail("sentinel: must run as root (it owns the system service and will read the configured shadow file and start sessions)", Failure.NotRoot)
    }
    const memory = allocator.alloc(@sizeOf(Login), 16)
    if memory == null { try fail("sentinel: out of memory", Failure.NoMemory) }
    var login: *Login = undefined
    unsafe { login = @ptrCast(*Login, memory.?) }
    login.*.environment = std.process.environmentEntries(arguments)
    login.*.shadowPath = shadowPath
    login.*.groupPath = groupPath
    login.*.runtimeRoot = runtimeRoot
    login.*.verbose = verbose
    login.*.running = true
    login.*.activeLength = 0
    login.*.activeUid = 0
    login.*.session = spawn_module.Child.none()
    login.*.greeterCompositor = greeterCompositor
    login.*.greeterProgram = greeterProgram
    login.*.greeterUid = greeterUid
    login.*.greeterGid = greeterGid
    login.*.greeter = spawn_module.Child.none()
    login1.init(login1Of(login), ttyPath, allowTestDevice, login.*.environment)
    var pendingIndex: usize = 0
    while pendingIndex < PENDING_MOST {
        release(pendingAt(login, pendingIndex))
        pendingIndex += 1
    }
    const ignored = users_module.load(usersOf(login), passwdPath)
    say(login, "login: read the configured account list\n")
    const signals = signalDescriptor()
    if signals < 0 && comptime builtin.os != builtin.Os.brixos { try fail("sentinel: could not create the signal descriptor", Failure.NoSignals) }
    if !connectName(login) {
        try fail("sentinel: could not own org.mlx.Login on the system bus (is synapse --system running?)", Failure.NoBus)
    }
    say(login, "login: org.mlx.Login and org.freedesktop.login1 on the system bus; waiting for the greeter\n")
    if !startGreeter(login) { try fail("sentinel: could not start the greeter compositor", Failure.NoGreeter) }
    dispatch(login)
    while login.*.running { wait(login, signals) }
    stopGreeter(login)
    if signals >= 0 { _ = std.fs.closeResult(signals) }
}

pub fn main(arguments: [][*]const u8) -> !void {
    const installed = crash.install()
    try run(arguments)
}
