// mlx-initctl: asks mlx-init, over its control socket, for the services'
// state or a change.
//
//     mlx4 projects/init/tool.mlx -o mlx-initctl
//     mlx-initctl status
//     mlx-initctl start NAME | stop NAME | restart NAME
//     mlx-initctl reload
//     mlx-initctl poweroff | reboot | halt
//
// The socket is /run/mlx/init, or --control PATH, or $MLX_INIT_CONTROL
// (set for every service the init starts). The exit status is 0 when the
// init answered "ok", 1 when it answered an error or did not answer.
const std = @import("std")
const crash = @import("std.crash")
const linux = @import("./linux.mlx")

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn usage() -> u8 {
    const said = std.io.eprintln("usage: mlx-initctl [--control PATH] status | start NAME | stop NAME | restart NAME | reload | poweroff | reboot | halt")
    return 2
}

// The next tab-separated field of `line` from `at`.
fn field(line: []const u8, at: *usize) -> []const u8 {
    const start = at.*
    while at.* < line.length && line[at.*] != 9 { at.* += 1 }
    const value = line[start..at.*]
    if at.* < line.length { at.* += 1 }
    return value
}

fn pad(into: [*]u8, at: usize, capacity: usize, value: []const u8, width: usize) -> usize {
    var length = std.text.append(into, at, capacity, value)
    var padding = value.length
    while padding < width {
        length = std.text.append(into, length, capacity, " ")
        padding += 1
    }
    return length
}

// The status lines as a table.
fn printStatus(text: []const u8) -> void {
    var line_bytes: [1024]u8 = undefined
    var line: [*]u8 = undefined
    unsafe { line = @ptrCast([*]u8, &line_bytes) }
    var length = pad(line, 0, 1024, "SERVICE", 20)
    length = pad(line, length, 1024, "STATE", 12)
    length = pad(line, length, 1024, "PID", 8)
    length = pad(line, length, 1024, "RESTARTS", 10)
    length = pad(line, length, 1024, "UP", 8)
    length = std.text.append(line, length, 1024, "DESCRIPTION\n")
    const header = linux.writeAll(1, line[0..length])
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        const row = text[start..end]
        start = end + 1
        if row.length == 0 || std.text.same(row, "ok") { continue }
        var at: usize = 0
        const name = field(row, &at)
        const state = field(row, &at)
        const pid = field(row, &at)
        const restarts = field(row, &at)
        const seconds = field(row, &at)
        const description = row[at..row.length]
        length = pad(line, 0, 1024, name, 20)
        length = pad(line, length, 1024, state, 12)
        length = pad(line, length, 1024, if std.text.same(pid, "0") { "-" } else { pid }, 8)
        length = pad(line, length, 1024, restarts, 10)
        var up: [24]u8 = undefined
        var up_bytes: [*]u8 = undefined
        unsafe { up_bytes = @ptrCast([*]u8, &up) }
        var up_length: usize = 0
        if std.text.same(pid, "0") {
            up_length = std.text.append(up_bytes, 0, 24, "-")
        } else {
            up_length = std.text.append(up_bytes, 0, 24, seconds)
            up_length = std.text.append(up_bytes, up_length, 24, "s")
        }
        length = pad(line, length, 1024, up_bytes[0..up_length], 8)
        length = std.text.append(line, length, 1024, description)
        length = std.text.append(line, length, 1024, "\n")
        const wrote = linux.writeAll(1, line[0..length])
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const reporting = crash.install()
    const count = std.process.count(arguments)
    var control: []const u8 = "/run/mlx/init"
    const from_environment = std.process.environment(arguments, "MLX_INIT_CONTROL")
    if from_environment != null { control = std.string.asSlice(from_environment.?) }
    var index: usize = 1
    var verb: []const u8 = ""
    var target: []const u8 = ""
    while index < count {
        const argument = std.process.argument(arguments, index)
        if named(argument, "--control") && index + 1 < count {
            control = std.string.asSlice(std.process.argument(arguments, index + 1))
            index += 1
        } else if verb.length == 0 {
            verb = std.string.asSlice(argument)
        } else if target.length == 0 {
            target = std.string.asSlice(argument)
        } else {
            return usage()
        }
        index += 1
    }
    const needs_target = std.text.same(verb, "start") || std.text.same(verb, "stop") || std.text.same(verb, "restart")
    const plain = std.text.same(verb, "status") || std.text.same(verb, "reload") || std.text.same(verb, "poweroff") || std.text.same(verb, "reboot") || std.text.same(verb, "halt")
    if !(needs_target && target.length > 0) && !(plain && target.length == 0) { return usage() }
    const socket = linux.connect(control)
    if socket < 0 {
        const said = std.io.eprintln("mlx-initctl: the init does not listen (is it running? --control PATH)")
        return 1
    }
    var request_bytes: [512]u8 = undefined
    var request: [*]u8 = undefined
    unsafe { request = @ptrCast([*]u8, &request_bytes) }
    var length = std.text.append(request, 0, 512, verb)
    if target.length > 0 {
        length = std.text.append(request, length, 512, " ")
        length = std.text.append(request, length, 512, target)
    }
    length = std.text.append(request, length, 512, "\n")
    if !linux.writeAll(socket, request[0..length]) {
        const said = std.io.eprintln("mlx-initctl: could not send the request")
        return 1
    }
    var reply_bytes: [65536]u8 = undefined
    var reply: [*]u8 = undefined
    unsafe { reply = @ptrCast([*]u8, &reply_bytes) }
    var received: usize = 0
    var more = true
    while more && received + 1 < 65536 {
        const got = linux.read(socket, @ptrFromInt([*]u8, @intFromPtr(reply) + received), 65535 - received)
        if got <= 0 { more = false } else { received += @bitCast(usize, got) }
    }
    linux.close(socket)
    const text = reply[0..received]
    // The last line is the verdict.
    var last_start = received
    while last_start > 0 && (last_start == received || text[last_start - 1] != 10) {
        last_start -= 1
        if last_start > 0 && text[last_start - 1] == 10 { break }
    }
    var last_end = received
    while last_end > last_start && text[last_end - 1] == 10 { last_end -= 1 }
    const verdict = text[last_start..last_end]
    if std.text.same(verb, "status") && std.text.same(verdict, "ok") {
        printStatus(text[0..last_start])
        return 0
    }
    if std.text.same(verdict, "ok") { return 0 }
    const said = std.io.eprint("mlx-initctl: ")
    const reason = std.io.eprintln(if verdict.length == 0 { "no answer from the init" } else { verdict })
    return 1
}
