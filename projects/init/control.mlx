// The control socket (/run/mlx/init): mlx-initctl connects, sends one
// request line and reads the reply until the init closes the connection.
//
//     status                 NAME TAB STATE TAB PID TAB RESTARTS TAB SECONDS
//                            TAB DESCRIPTION, one line per service, then "ok"
//     start NAME, stop NAME, restart NAME
//     reload                 the services directory again
//     poweroff, reboot, halt
//
// Every other reply is "ok" or "error: WHY". A client that sends nothing
// is dropped when it hangs up; at most MAX_CLIENTS wait at a time.
const std = @import("std")
const linux = @import("./linux.mlx")
const config = @import("./config.mlx")
const supervise = @import("./supervise.mlx")

const State = config.State
const Service = config.Service

// Event tokens: the listener, the signals, then the clients.
pub const LISTENER: usize = 1
pub const SIGNALS: usize = 2
pub const CLIENT_BASE: usize = 16

pub fn isClient(token: usize) -> bool { return token >= CLIENT_BASE && token < CLIENT_BASE + config.MAX_CLIENTS }

fn clientAt(state: *State, index: usize) -> *config.ControlClient {
    var pointer: *config.ControlClient = undefined
    unsafe { pointer = @ptrCast(*config.ControlClient, &state.*.clients[index]) }
    return pointer
}

// Listens at the control path (root only), watched by the event loop.
pub fn listen(state: *State) -> bool {
    const listener = linux.listen(config.controlPath(state), 8)
    if listener < 0 { return false }
    const restricted = linux.chmod(config.controlPath(state), 384)
    state.*.listener = listener
    var index: usize = 0
    while index < config.MAX_CLIENTS {
        clientAt(state, index).*.used = false
        index += 1
    }
    return linux.watch(state.*.eventLoop, listener, LISTENER)
}

// Takes every waiting connection.
pub fn accept(state: *State) -> void {
    var more = true
    while more {
        const descriptor = linux.accept(state.*.listener)
        if descriptor < 0 {
            more = false
        } else {
            var index: usize = 0
            var placed = false
            while index < config.MAX_CLIENTS && !placed {
                const client = clientAt(state, index)
                if !client.*.used {
                    client.*.used = true
                    client.*.descriptor = descriptor
                    client.*.length = 0
                    placed = linux.watch(state.*.eventLoop, descriptor, CLIENT_BASE + index)
                    if !placed { client.*.used = false }
                }
                index += 1
            }
            if !placed { linux.close(descriptor) }
        }
    }
}

fn drop(state: *State, client: *config.ControlClient) -> void {
    linux.unwatch(state.*.eventLoop, client.*.descriptor)
    linux.close(client.*.descriptor)
    client.*.used = false
}

// A client's socket is readable: its request line, when complete, is
// answered and the connection closed.
pub fn readable(state: *State, token: usize) -> void {
    const client = clientAt(state, token - CLIENT_BASE)
    if !client.*.used { return }
    var buffer: [*]u8 = undefined
    unsafe { buffer = @ptrCast([*]u8, &client.*.buffer) }
    const got = linux.read(client.*.descriptor, config.offset(buffer, client.*.length), 255 - client.*.length)
    if got > 0 { client.*.length += @bitCast(usize, got) }
    var complete = got <= 0 || client.*.length >= 255
    var index: usize = 0
    while index < client.*.length {
        if buffer[index] == 10 {
            client.*.length = index
            complete = true
        }
        index += 1
    }
    if !complete { return }
    const request = std.text.trimmed(buffer[0..client.*.length])
    if request.length > 0 { handle(state, client.*.descriptor, request) }
    drop(state, client)
}

fn stateName(service: *const Service) -> []const u8 {
    if service.*.state == config.WAITING { return "waiting" }
    if service.*.state == config.STARTING { return "starting" }
    if service.*.state == config.RUNNING { return "running" }
    if service.*.state == config.DONE { return "done" }
    if service.*.state == config.STOPPING { return "stopping" }
    if service.*.state == config.RESTARTING { return "restarting" }
    if service.*.wanted && service.*.lastStatus != 0 { return "failed" }
    if service.*.disabled && !service.*.wanted { return "disabled" }
    return "stopped"
}

// Whether `left` sorts before `right` (bytes).
fn before(left: []const u8, right: []const u8) -> bool {
    var index: usize = 0
    while index < left.length && index < right.length {
        if left[index] != right[index] { return left[index] < right[index] }
        index += 1
    }
    return left.length < right.length
}

// The service after `previous` in name order (the first for null); null
// when none is left.
fn nextByName(state: *State, previous: ?*Service) -> ?*Service {
    var best: ?*Service = null
    var index: usize = 0
    while index < state.*.count {
        const service = config.serviceAt(state, index)
        const above = previous == null || before(config.name(previous.?), config.name(service))
        if above && (best == null || before(config.name(service), config.name(best.?))) { best = service }
        index += 1
    }
    return best
}

// The status lines into the scratch area, in name order; their length.
fn status(state: *State) -> usize {
    const into = config.scratch(state)
    const capacity = config.SCRATCH_CAPACITY
    const at = std.time.milliseconds()
    var length: usize = 0
    var current = nextByName(state, null)
    while current != null {
        const service = current.?
        length = std.text.append(into, length, capacity, config.name(service))
        length = std.text.append(into, length, capacity, "\t")
        length = std.text.append(into, length, capacity, stateName(service))
        length = std.text.append(into, length, capacity, "\t")
        length = std.text.appendUnsigned(into, length, capacity, if service.*.pid > 0 { @intCast(usize, service.*.pid) } else { 0 })
        length = std.text.append(into, length, capacity, "\t")
        length = std.text.appendUnsigned(into, length, capacity, service.*.restarts)
        length = std.text.append(into, length, capacity, "\t")
        const since: usize = if service.*.pid > 0 && at >= service.*.startedAt { (at - service.*.startedAt) / 1000 } else { 0 }
        length = std.text.appendUnsigned(into, length, capacity, since)
        length = std.text.append(into, length, capacity, "\t")
        length = std.text.append(into, length, capacity, config.description(service))
        length = std.text.append(into, length, capacity, "\n")
        current = nextByName(state, service)
    }
    return length
}

fn reply(descriptor: isize, text: []const u8) -> void {
    const wrote = linux.writeAll(descriptor, text)
}

fn replyAbout(descriptor: isize, first: []const u8, second: []const u8) -> void {
    var line: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length = std.text.append(bytes, 0, 512, first)
    length = std.text.append(bytes, length, 512, second)
    length = std.text.append(bytes, length, 512, "\n")
    const wrote = linux.write(descriptor, bytes, length)
}

// The request word and its argument (the rest of the line).
fn word(request: []const u8) -> []const u8 {
    var end: usize = 0
    while end < request.length && request[end] != 32 { end += 1 }
    return request[0..end]
}

fn argument(request: []const u8) -> []const u8 {
    var start: usize = 0
    while start < request.length && request[start] != 32 { start += 1 }
    while start < request.length && request[start] == 32 { start += 1 }
    return std.text.trimmed(request[start..request.length])
}

fn handle(state: *State, descriptor: isize, request: []const u8) -> void {
    const verb = word(request)
    const target = argument(request)
    if std.text.same(verb, "status") {
        const length = status(state)
        const text = config.scratch(state)
        reply(descriptor, text[0..length])
        reply(descriptor, "ok\n")
        return
    }
    if std.text.same(verb, "reload") {
        const defined = config.load(state)
        supervise.tick(state)
        reply(descriptor, "ok\n")
        return
    }
    if std.text.same(verb, "poweroff") || std.text.same(verb, "reboot") || std.text.same(verb, "halt") {
        reply(descriptor, "ok\n")
        state.*.action = if std.text.same(verb, "poweroff") { config.ACTION_POWEROFF } else if std.text.same(verb, "reboot") { config.ACTION_REBOOT } else { config.ACTION_HALT }
        state.*.running = false
        config.sayWith("", verb, false, 0)
        return
    }
    if std.text.same(verb, "start") || std.text.same(verb, "stop") || std.text.same(verb, "restart") {
        if target.length == 0 {
            reply(descriptor, "error: which service?\n")
            return
        }
        const found = config.find(state, target)
        if found == null {
            replyAbout(descriptor, "error: no such service: ", target)
            return
        }
        const service = found.?
        if std.text.same(verb, "start") {
            if !supervise.requestStart(state, service) {
                replyAbout(descriptor, "error: already running: ", target)
                return
            }
        } else if std.text.same(verb, "stop") {
            supervise.requestStop(state, service)
        } else {
            supervise.requestRestart(state, service)
        }
        supervise.tick(state)
        reply(descriptor, "ok\n")
        return
    }
    replyAbout(descriptor, "error: unknown request: ", verb)
}
