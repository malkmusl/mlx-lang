// Supervision: starting the services in their order (`after`, `ready`),
// reaping what ends, starting again after a pause that grows while a
// service keeps failing, and stopping on request (SIGTERM to the
// service's process group, SIGKILL once its stop-timeout is over).
const std = @import("std")
const linux = @import("./linux.mlx")
const spawn_module = @import("std.spawn")
const config = @import("./config.mlx")
const accounts = @import("./accounts.mlx")
const logs = @import("./logs.mlx")

const Service = config.Service
const State = config.State

const FIRST_DELAY: usize = 1000
const MAX_DELAY: usize = 30000
// A service that ran this long before it ended starts again after the
// first delay, not a longer one.
const STABLE_RUN: usize = 60000
// How often a service's ready path or socket is looked for.
const READY_POLL: usize = 100
const MAX_ARGUMENTS: usize = 64
const MAX_ENVIRONMENT: usize = 48
// /usr/bin/mlx: the MLX programs (tools/lib/mlx_layout.sh), after the
// distribution's own.
const SEARCH_PATH: []const u8 = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/bin/mlx"

const RunIdentity = struct {
    account: accounts.User
    group: u32
    hasUser: bool
    hasGroup: bool
    valid: bool
}

const ChildSetup = struct {
    identity: RunIdentity
    log: [*]const u8
    logLength: usize
    output: isize
}

// Whether every service named in `after` runs (or, a oneshot, finished).
// A name nobody defines is said once and does not hold the service up.
fn dependenciesMet(state: *State, service: *Service) -> bool {
    const list = config.after(service)
    var start: usize = 0
    while start < list.length {
        while start < list.length && list[start] == 32 { start += 1 }
        var end = start
        while end < list.length && list[end] != 32 { end += 1 }
        if end > start {
            const found = config.find(state, list[start..end])
            if found == null {
                if !service.*.warned {
                    config.sayAbout(service, "waits for a service that is not defined (after)", false, 0)
                    service.*.warned = true
                }
            } else {
                const dependency = found.?
                if dependency.*.state != config.RUNNING && dependency.*.state != config.DONE { return false }
            }
        }
        start = end
    }
    return true
}

fn advance(bytes: [*]u8, by: usize) -> [*]const u8 {
    const result: [*]const u8 = bytes + by
    return result
}

// The command line as argv: words split at blanks, double quotes keeping
// theirs; the words NUL-terminated in `storage`, `items` ended by null.
fn splitCommand(line: []const u8, storage: [*]u8, capacity: usize, items: [*][*]const u8) -> usize {
    var count: usize = 0
    var used: usize = 0
    var at: usize = 0
    while at < line.length && count + 1 < MAX_ARGUMENTS {
        while at < line.length && (line[at] == 32 || line[at] == 9) { at += 1 }
        if at >= line.length { break }
        items[count] = advance(storage, used)
        var quoted = false
        while at < line.length && (quoted || (line[at] != 32 && line[at] != 9)) {
            if line[at] == 34 {
                quoted = !quoted
            } else if used + 1 < capacity {
                storage[used] = line[at]
                used += 1
            }
            at += 1
        }
        storage[used] = 0
        used += 1
        count += 1
    }
    unsafe { items[count] = @ptrFromInt([*]const u8, 0) }
    return count
}

fn addEntry(storage: [*]u8, capacity: usize, used: usize, items: [*][*]const u8, count: *usize, key: []const u8, value: []const u8) -> usize {
    if used + key.length + value.length + 1 > capacity || count.* + 1 >= MAX_ENVIRONMENT { return used }
    items[count.*] = advance(storage, used)
    var at = std.text.append(storage, used, capacity, key)
    at = std.text.append(storage, at, capacity, value)
    storage[at] = 0
    count.* += 1
    return at + 1
}

// The service's environment: PATH, its account, TERM, where the init
// listens, then its own `env` entries.
fn buildEnvironment(state: *State, service: *Service, storage: [*]u8, capacity: usize, items: [*][*]const u8, identity: *const RunIdentity) -> usize {
    var count: usize = 0
    var used = addEntry(storage, capacity, 0, items, &count, "PATH=", SEARCH_PATH)
    const home = if identity.*.hasUser && identity.*.account.homeLength > 0 { accounts.homeOf(&identity.*.account) } else { "/" }
    used = addEntry(storage, capacity, used, items, &count, "HOME=", home)
    if identity.*.hasUser {
        used = addEntry(storage, capacity, used, items, &count, "USER=", config.user(service))
        used = addEntry(storage, capacity, used, items, &count, "LOGNAME=", config.user(service))
    }
    used = addEntry(storage, capacity, used, items, &count, "TERM=", "linux")
    used = addEntry(storage, capacity, used, items, &count, "MLX_INIT_CONTROL=", config.controlPath(state))
    const own = config.environment(service)
    var start: usize = 0
    while start < own.length {
        var end = start
        while end < own.length && own[end] != 0 { end += 1 }
        if end > start { used = addEntry(storage, capacity, used, items, &count, own[start..end], "") }
        start = end + 1
    }
    unsafe { items[count] = @ptrFromInt([*]const u8, 0) }
    return count
}

fn identityFor(service: *Service) -> RunIdentity {
    const hasUser = config.user(service).length > 0
    const hasGroup = config.group(service).length > 0
    var account = accounts.User.{ .identifier = linux.effectiveUser(), .group = linux.effectiveGroup(), .home = undefined, .homeLength = 0, .valid = true }
    if hasUser {
        account = accounts.user(config.user(service))
        if !account.valid { return RunIdentity.{ .account = account, .group = 0, .hasUser = true, .hasGroup = hasGroup, .valid = false } }
    }
    var group = account.group
    if hasGroup {
        const requested = accounts.group(config.group(service))
        if !requested.valid { return RunIdentity.{ .account = account, .group = 0, .hasUser = hasUser, .hasGroup = true, .valid = false } }
        group = requested.identifier
    }
    const currentUser = linux.effectiveUser()
    const currentGroup = linux.effectiveGroup()
    const targetUser = if hasUser { account.identifier } else { currentUser }
    // A non-root init may keep its own identity, but must never silently run
    // a service under the wrong account when setuid/setgid cannot work.
    const permitted = currentUser == 0 || (targetUser == currentUser && group == currentGroup)
    return RunIdentity.{ .account = account, .group = group, .hasUser = hasUser, .hasGroup = hasGroup, .valid = permitted }
}

fn applyIdentity(service: *Service, identity: *const RunIdentity) -> bool {
    if !identity.*.hasUser && !identity.*.hasGroup { return true }
    if linux.effectiveUser() == 0 && !linux.clearGroups() {
        config.sayAbout(service, "could not clear supplementary groups", false, 0)
        return false
    }
    if !linux.setGroup(identity.*.group) {
        config.sayAbout(service, "could not set its group", false, 0)
        return false
    }
    if identity.*.hasUser && !linux.setUser(identity.*.account.identifier) {
        config.sayAbout(service, "could not set its user", false, 0)
        return false
    }
    return true
}

// Where the service's output goes without `log` or `stdio`:
// LOGDIR/NAME.log.
fn logPath(state: *State, service: *Service, into: [*]u8, capacity: usize) -> usize {
    const own = config.log(service)
    if own.length > 0 { return std.text.append(into, 0, capacity, own) }
    var length = std.text.append(into, 0, capacity, config.logDirectory(state))
    length = std.text.append(into, length, capacity, "/")
    length = std.text.append(into, length, capacity, config.name(service))
    return std.text.append(into, length, capacity, ".log")
}

// The child's side: a session of its own, stdio on its terminal or its
// log, then the program.
fn child(state: *State, service: *Service, arguments: [*][*]const u8, environment: [*][*]const u8, setup: *const ChildSetup) -> void {
    std.linux.process.unblockAllSignals()
    _ = std.linux.process.setSession()
    const terminal_path = config.stdio(service)
    if terminal_path.length > 0 {
        const terminal = linux.open(terminal_path, std.linux.O_RDWR | std.linux.O_NOCTTY, 0)
        if terminal >= 0 {
            _ = std.linux.ioctl(terminal, std.linux.tty.TIOCSCTTY, 0)
            _ = std.linux.dup2(terminal, 0)
            _ = std.linux.dup2(terminal, 1)
            _ = std.linux.dup2(terminal, 2)
            if terminal > 2 { std.linux.close(terminal) }
        }
    } else if !std.text.same(setup.*.log[0..setup.*.logLength], "console") {
        const input = linux.open("/dev/null", std.linux.O_RDONLY, 0)
        if input >= 0 {
            _ = std.linux.dup2(input, 0)
            if input > 2 { std.linux.close(input) }
        }
        const output = if setup.*.output >= 0 { setup.*.output } else { linux.open(setup.*.log[0..setup.*.logLength], std.linux.O_WRONLY | std.linux.O_CREAT | std.linux.O_APPEND, 420) }
        if output >= 0 {
            _ = std.linux.dup2(output, 1)
            _ = std.linux.dup2(output, 2)
            if output > 2 { std.linux.close(output) }
        }
    }
    if !applyIdentity(service, &setup.*.identity) { std.linux.exitGroup(126) }
    // Looked up along SEARCH_PATH when it has no slash.
    spawn_module.executeIn(arguments[0], arguments, environment, SEARCH_PATH)
    config.sayAbout(service, "cannot run its program", false, 0)
    std.linux.exitGroup(127)
}

// Starts the service's process and notes it: running at once, or starting
// until its ready path appears (a oneshot: until it ends).
fn spawn(state: *State, service: *Service, at: usize) -> void {
    var storage: [config.LINE_CAPACITY + MAX_ARGUMENTS]u8 = undefined
    var items: [MAX_ARGUMENTS][*]const u8 = undefined
    var environment_storage: [2048]u8 = undefined
    var environment_items: [MAX_ENVIRONMENT][*]const u8 = undefined
    var storage_bytes: [*]u8 = undefined
    var items_pointer: [*][*]const u8 = undefined
    var environment_bytes: [*]u8 = undefined
    var environment_pointer: [*][*]const u8 = undefined
    unsafe {
        storage_bytes = &storage
        items_pointer = @ptrCast([*][*]const u8, &items)
        environment_bytes = &environment_storage
        environment_pointer = @ptrCast([*][*]const u8, &environment_items)
    }
    const count = splitCommand(config.exec(service), storage_bytes, config.LINE_CAPACITY + MAX_ARGUMENTS, items_pointer)
    if count == 0 {
        config.sayAbout(service, "has nothing to run (no exec line)", false, 0)
        service.*.wanted = false
        service.*.state = config.STOPPED
        return
    }
    var identity = identityFor(service)
    if !identity.valid {
        config.sayAbout(service, "has an unknown or unavailable user/group and is not started", false, 0)
        service.*.wanted = false
        service.*.state = config.STOPPED
        return
    }
    _ = buildEnvironment(state, service, environment_bytes, 2048, environment_pointer, &identity)
    var log: [config.PATH_CAPACITY + config.NAME_CAPACITY + 8]u8 = undefined
    const log_bytes: [*]u8 = &log
    const log_length = logPath(state, service, log_bytes, config.PATH_CAPACITY + config.NAME_CAPACITY + 8)
    const relay = logs.start(state, service)
    service.*.loggerPid = relay.pid
    var setup = ChildSetup.{ .identity = identity, .log = log_bytes, .logLength = log_length, .output = relay.writer }
    const pid = std.linux.process.fork()
    if pid < 0 {
        if relay.writer >= 0 { std.linux.close(relay.writer) }
        config.sayAbout(service, "could not be started (fork failed), trying again later", false, 0)
        service.*.delay = if service.*.delay == 0 { FIRST_DELAY } else { service.*.delay }
        service.*.restartAt = at + service.*.delay
        service.*.state = config.RESTARTING
        return
    }
    if pid == 0 { child(state, service, items_pointer, environment_pointer, &setup) }
    if relay.writer >= 0 { std.linux.close(relay.writer) }
    service.*.pid = pid
    service.*.startedAt = at
    service.*.killed = false
    state.*.sequence += 1
    service.*.order = state.*.sequence
    if service.*.oneshot || service.*.readyLength > 0 { service.*.state = config.STARTING } else { service.*.state = config.RUNNING }
    if state.*.verbose { config.sayAbout(service, "started, pid ", true, @intCast(usize, pid)) }
}

fn byPid(state: *State, pid: isize) -> ?*Service {
    var index: usize = 0
    while index < state.*.count {
        const service = config.serviceAt(state, index)
        if service.*.pid == pid { return service }
        index += 1
    }
    return null
}

fn byLoggerPid(state: *State, pid: isize) -> ?*Service {
    var index: usize = 0
    while index < state.*.count {
        const service = config.serviceAt(state, index)
        if service.*.loggerPid == pid { return service }
        index += 1
    }
    return null
}

fn smaller(left: usize, right: usize) -> usize { return if left < right { left } else { right } }

// A service's process ended: stopped (by request, or for a restart), a
// oneshot finished, or it is to run again after its pause.
fn ended(state: *State, service: *Service, status: usize, at: usize) -> void {
    service.*.pid = 0
    service.*.lastStatus = status
    if service.*.state == config.STOPPING {
        service.*.state = config.STOPPED
        if service.*.wanted {
            // A restart: at once.
            service.*.delay = 0
            if state.*.verbose { config.sayAbout(service, "stopped, starting again", false, 0) }
        } else {
            config.sayAbout(service, "stopped", false, 0)
        }
        return
    }
    if service.*.oneshot && status == 0 {
        service.*.state = config.DONE
        if state.*.verbose { config.sayAbout(service, "finished", false, 0) }
        return
    }
    const ran = at - service.*.startedAt
    if status == 0 { config.sayAbout(service, "ended", false, 0) } else { config.sayAbout(service, "ended with status ", true, status) }
    if !service.*.wanted || service.*.restart == config.RESTART_NEVER || (service.*.restart == config.RESTART_ON_FAILURE && status == 0) {
        service.*.state = config.STOPPED
        return
    }
    if ran >= STABLE_RUN || service.*.delay == 0 { service.*.delay = FIRST_DELAY } else { service.*.delay = smaller(service.*.delay * 2, MAX_DELAY) }
    service.*.restartAt = at + service.*.delay
    service.*.restarts += 1
    service.*.state = config.RESTARTING
    config.sayAbout(service, "starting again in ms: ", true, service.*.delay)
}

// Reaps every ended child: the services' processes, and orphans that came
// to PID 1.
pub fn reapAll(state: *State) -> void {
    const at = std.time.milliseconds()
    var more = true
    while more {
        var raw: usize = 0
        const pid = std.linux.process.waitProcess(-1, &raw, std.linux.WNOHANG)
        if pid <= 0 {
            more = false
        } else {
            const found = byPid(state, pid)
            if found == null {
                const logger = byLoggerPid(state, pid)
                if logger != null {
                    logger.?.*.loggerPid = 0
                } else if state.*.verbose {
                    config.sayWith("reaped a process of nobody's, pid ", "", true, @intCast(usize, pid))
                }
            } else {
                ended(state, found.?, std.linux.process.exitStatus(raw), at)
            }
        }
    }
}

// SIGTERM to the service's process group; stopping from now.
fn terminate(service: *Service, at: usize) -> void {
    _ = std.linux.process.kill(0 - service.*.pid, std.linux.SIGTERM)
    service.*.state = config.STOPPING
    service.*.stoppingSince = at
    service.*.killed = false
}

// A plain readiness value keeps the original path-exists contract. A
// `socket:` value requires a successful Unix stream connection, so a stale
// socket inode or an unrelated file cannot release dependent services.
fn ready(service: *Service) -> bool {
    const specification = config.ready(service)
    const prefix: []const u8 = "socket:"
    if specification.length >= prefix.length && std.text.same(specification[0..prefix.length], prefix) {
        const path = std.text.trimmed(specification[prefix.length..specification.length])
        if path.length == 0 || path.length > 107 { return false }
        const connection = linux.tryConnect(path)
        if connection < 0 { return false }
        std.linux.close(connection)
        return true
    }
    return linux.exists(specification)
}

// Moves every service along: stops what is not wanted, kills what did not
// stop in time, starts what may start (its dependencies met, its pause
// over), and takes a starting service as running once its ready path is
// there or its ready-timeout is over. Starting one service can let others
// start, so it goes round until nothing changes.
pub fn tick(state: *State) -> void {
    const at = std.time.milliseconds()
    var changed = true
    while changed {
        changed = false
        var index: usize = 0
        while index < state.*.count {
            const service = config.serviceAt(state, index)
            if service.*.state == config.STOPPING {
                if !service.*.killed && at - service.*.stoppingSince >= service.*.stopTimeout {
                    _ = std.linux.process.kill(0 - service.*.pid, std.linux.SIGKILL)
                    service.*.killed = true
                    config.sayAbout(service, "did not stop in time, killed", false, 0)
                }
            } else if !service.*.wanted {
                if service.*.pid > 0 {
                    terminate(service, at)
                } else if service.*.state == config.WAITING || service.*.state == config.RESTARTING {
                    service.*.state = config.STOPPED
                }
            } else if service.*.loggerPid == 0 && (service.*.state == config.STOPPED || service.*.state == config.WAITING || (service.*.state == config.RESTARTING && at >= service.*.restartAt)) {
                if dependenciesMet(state, service) {
                    spawn(state, service, at)
                    changed = true
                } else if service.*.state != config.WAITING {
                    service.*.state = config.WAITING
                }
            } else if service.*.state == config.STARTING && !service.*.oneshot {
                if service.*.readyLength == 0 || ready(service) {
                    service.*.state = config.RUNNING
                    changed = true
                    if state.*.verbose { config.sayAbout(service, "ready", false, 0) }
                } else if at - service.*.startedAt >= service.*.readyTimeout {
                    service.*.state = config.RUNNING
                    changed = true
                    config.sayAbout(service, "not ready in time (its ready path or socket did not answer), taken as running", false, 0)
                }
            }
            index += 1
        }
    }
}

// How long the loop may wait for events: until the next pause ends, the
// next stop-timeout, or the next look for a ready path; -1 for ever.
pub fn nextTimeout(state: *State) -> isize {
    const at = std.time.milliseconds()
    var timeout: isize = -1
    var index: usize = 0
    while index < state.*.count {
        const service = config.serviceAt(state, index)
        var due: usize = 18446744073709551615
        if service.*.state == config.RESTARTING {
            due = if service.*.restartAt > at { service.*.restartAt - at } else { 0 }
        } else if service.*.state == config.STOPPING && !service.*.killed {
            const deadline = service.*.stoppingSince + service.*.stopTimeout
            due = if deadline > at { deadline - at } else { 0 }
        } else if service.*.state == config.STARTING && !service.*.oneshot {
            due = READY_POLL
        }
        if due != 18446744073709551615 && (timeout < 0 || due < @intCast(usize, timeout)) { timeout = @intCast(isize, due) }
        index += 1
    }
    return timeout
}

// A request to start: wanted from now (a pause is cut short); the next
// tick starts it.
pub fn requestStart(state: *State, service: *Service) -> bool {
    if service.*.state == config.RUNNING || service.*.state == config.STARTING || service.*.state == config.DONE { return false }
    service.*.wanted = true
    service.*.restartAt = 0
    return true
}

// A request to stop: not wanted from now; its process gets SIGTERM.
pub fn requestStop(state: *State, service: *Service) -> void {
    service.*.wanted = false
    if service.*.pid > 0 && service.*.state != config.STOPPING { terminate(service, std.time.milliseconds()) }
}

// A request to restart: its process gets SIGTERM and, wanted still, the
// service starts again as soon as it has ended.
pub fn requestRestart(state: *State, service: *Service) -> void {
    service.*.wanted = true
    service.*.restartAt = 0
    if service.*.pid > 0 {
        if service.*.state != config.STOPPING { terminate(service, std.time.milliseconds()) }
    } else if service.*.state == config.DONE {
        service.*.state = config.STOPPED
    }
}

pub fn anyRunning(state: *State) -> bool {
    var index: usize = 0
    while index < state.*.count {
        const service = config.serviceAt(state, index)
        if service.*.pid > 0 || service.*.loggerPid > 0 { return true }
        index += 1
    }
    return false
}

fn namesDependency(service: *Service, wanted: []const u8) -> bool {
    const list = config.after(service)
    var start: usize = 0
    while start < list.length {
        while start < list.length && list[start] == 32 { start += 1 }
        var end = start
        while end < list.length && list[end] != 32 { end += 1 }
        if end > start && std.text.same(list[start..end], wanted) { return true }
        start = end
    }
    return false
}

// A dependency stays up while any service that declared `after` it is still
// alive. This is based on the declared graph, not incidental fork order.
fn hasRunningDependent(state: *State, dependency: *Service) -> bool {
    var index: usize = 0
    while index < state.*.count {
        const candidate = config.serviceAt(state, index)
        if candidate.*.pid > 0 && namesDependency(candidate, config.name(dependency)) { return true }
        index += 1
    }
    return false
}

fn stopDeadline(service: *Service) -> void {
    if service.*.pid <= 0 || service.*.state != config.STOPPING || service.*.killed { return }
    if std.time.milliseconds() - service.*.stoppingSince >= service.*.stopTimeout {
        const sent = std.linux.process.kill(0 - service.*.pid, std.linux.SIGKILL)
        service.*.killed = true
        config.sayAbout(service, "did not stop in time, killed", false, 0)
    }
}

// Stops every service for shutdown in dependency phases. A service is sent
// SIGTERM only after all live services that name it in `after` have exited;
// each selected service is reaped before its dependency is considered.
pub fn stopAll(state: *State) -> void {
    const began = std.time.milliseconds()
    var index: usize = 0
    while index < state.*.count {
        const service = config.serviceAt(state, index)
        service.*.wanted = false
        if service.*.pid == 0 && (service.*.state == config.WAITING || service.*.state == config.RESTARTING) { service.*.state = config.STOPPED }
        index += 1
    }
    while anyRunning(state) && std.time.milliseconds() - began < 60000 {
        var latest: usize = 0
        var pick: ?*Service = null
        index = 0
        while index < state.*.count {
            const service = config.serviceAt(state, index)
            if service.*.pid > 0 && !hasRunningDependent(state, service) && service.*.order >= latest {
                latest = service.*.order
                pick = service
            }
            index += 1
        }
        // A dependency cycle has no leaf. Break it deterministically by
        // stopping the most recently started member, then continue normally.
        if pick == null {
            index = 0
            while index < state.*.count {
                const service = config.serviceAt(state, index)
                if service.*.pid > 0 && service.*.order >= latest {
                    latest = service.*.order
                    pick = service
                }
                index += 1
            }
            if pick == null {
                // Only relays are left; let them drain their pipes before
                // the init exits and loses the last log records.
                std.linux.sleepMilliseconds(50)
                reapAll(state)
                continue
            }
            config.say("dependency cycle while stopping services; breaking it by start order")
        }
        const selected = pick.?
        if selected.*.state != config.STOPPING { terminate(selected, std.time.milliseconds()) }
        while selected.*.pid > 0 && std.time.milliseconds() - began < 60000 {
            stopDeadline(selected)
            std.linux.sleepMilliseconds(50)
            reapAll(state)
        }
        while selected.*.loggerPid > 0 && std.time.milliseconds() - began < 60000 {
            std.linux.sleepMilliseconds(50)
            reapAll(state)
        }
    }
    // The minute-wide bound is a last-resort safety valve. Do not leave
    // service groups behind when mlx-init itself is not PID 1.
    if anyRunning(state) {
        index = 0
        while index < state.*.count {
            const service = config.serviceAt(state, index)
            if service.*.pid > 0 { const sent = std.linux.process.kill(0 - service.*.pid, std.linux.SIGKILL) }
            if service.*.loggerPid > 0 { const sentLogger = std.linux.process.kill(service.*.loggerPid, std.linux.SIGKILL) }
            index += 1
        }
        var waited: usize = 0
        while anyRunning(state) && waited < 2000 {
            std.linux.sleepMilliseconds(50)
            reapAll(state)
            waited += 50
        }
    }
}
