// The end: the services stopped in the reverse order of their starts,
// then (as PID 1) every other process, the disks synced, the file systems
// unmounted and the root made read-only, and the kernel asked to power
// off, reboot or halt. Not PID 1, the init ends once its services have.
const std = @import("std")
const linux = @import("./linux.mlx")
const config = @import("./config.mlx")
const supervise = @import("./supervise.mlx")
const mounts = @import("./mounts.mlx")

const State = config.State

// SIGTERM, a pause, SIGKILL to every process left (PID 1 only).
fn killEverything(state: *State) -> void {
    const terminated = linux.kill(-1, linux.SIGTERM)
    var waited: usize = 0
    while waited < 2000 {
        linux.sleepMilliseconds(100)
        supervise.reapAll(state)
        waited += 100
    }
    const killed = linux.kill(-1, linux.SIGKILL)
    linux.sleepMilliseconds(100)
    supervise.reapAll(state)
}

pub fn shutdown(state: *State) -> void {
    config.say("stopping the services")
    supervise.stopAll(state)
    if !state.*.pid1 {
        config.say("services stopped, ending (not PID 1: nothing to power off)")
        return
    }
    config.say("stopping everything else")
    killEverything(state)
    linux.sync()
    mounts.unmountAll(state)
    linux.sync()
    var command = linux.REBOOT_POWER_OFF
    if state.*.action == config.ACTION_REBOOT {
        config.say("rebooting")
        command = linux.REBOOT_RESTART
    } else if state.*.action == config.ACTION_HALT {
        config.say("halting")
        command = linux.REBOOT_HALT
    } else {
        config.say("powering off")
    }
    const result = linux.reboot(command)
    config.sayFailed("the kernel did not take the reboot call", "", result)
    // PID 1 must not exit; nothing is left to do.
    var forever = true
    while forever { linux.sleepMilliseconds(1000) }
}
