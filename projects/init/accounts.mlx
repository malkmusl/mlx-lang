// Account-name resolution for service definitions. The init cannot rely on
// libc's NSS helpers, so the small passwd and group formats it needs are read
// directly. A missing or malformed account is never treated as root.
const std = @import("std")
const linux = @import("./linux.mlx")

const DATABASE_CAPACITY: usize = 65536
pub const HOME_CAPACITY: usize = 256

pub const User = struct {
    identifier: u32
    group: u32
    home: [HOME_CAPACITY]u8
    homeLength: usize
    valid: bool
}

pub const Group = struct {
    identifier: u32
    valid: bool
}

fn bytesOf(array: *const [HOME_CAPACITY]u8) -> [*]const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, array) }
    return bytes
}

pub fn homeOf(user: *const User) -> []const u8 {
    return bytesOf(&user.*.home)[0..user.*.homeLength]
}

fn invalidUser() -> User {
    return User.{ .identifier = 0, .group = 0, .home = undefined, .homeLength = 0, .valid = false }
}

fn invalidGroup() -> Group { return Group.{ .identifier = 0, .valid = false } }

fn same(source: [*]const u8, start: usize, end: usize, wanted: []const u8) -> bool {
    if end - start != wanted.length { return false }
    var index: usize = 0
    while index < wanted.length {
        if source[start + index] != wanted[index] { return false }
        index += 1
    }
    return true
}

fn number(source: [*]const u8, start: usize, end: usize, result: *u32) -> bool {
    if start == end { return false }
    var value: usize = 0
    var index = start
    while index < end {
        if source[index] < 48 || source[index] > 57 { return false }
        value = value * 10 + @intCast(usize, source[index] - 48)
        if value > 4294967295 { return false }
        index += 1
    }
    result.* = @intCast(u32, value)
    return true
}

// Reads the complete database. Truncation is a failure because a requested
// account might otherwise be mistaken for a missing one.
fn load(path: []const u8, buffer: [*]u8) -> usize {
    const file = linux.open(path, std.linux.O_RDONLY | std.linux.O_CLOEXEC, 0)
    if file < 0 { return 0 }
    var length: usize = 0
    while length < DATABASE_CAPACITY {
        var got = std.linux.read(file, unsafe { @ptrFromInt([*]u8, @intFromPtr(buffer) + length) }, DATABASE_CAPACITY - length)
        while got == std.linux.EINTR { got = std.linux.read(file, unsafe { @ptrFromInt([*]u8, @intFromPtr(buffer) + length) }, DATABASE_CAPACITY - length) }
        if got < 0 {
            std.linux.close(file)
            return 0
        }
        if got == 0 { break }
        length += @bitCast(usize, got)
    }
    if length == DATABASE_CAPACITY {
        var extra: [1]u8 = undefined
        var got = std.linux.read(file, unsafe { @ptrCast([*]u8, &extra) }, 1)
        while got == std.linux.EINTR { got = std.linux.read(file, unsafe { @ptrCast([*]u8, &extra) }, 1) }
        if got != 0 { length = 0 }
    }
    std.linux.close(file)
    return length
}

fn nextField(source: [*]const u8, end: usize, at: *usize, start: *usize, stop: *usize) -> bool {
    if at.* > end { return false }
    start.* = at.*
    while at.* < end && source[at.*] != 58 { at.* += 1 }
    stop.* = at.*
    if at.* < end { at.* += 1 }
    return true
}

fn userLine(source: [*]const u8, start: usize, end: usize, wanted: []const u8) -> User {
    var at = start
    var fieldStart: usize = 0
    var fieldEnd: usize = 0
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) || !same(source, fieldStart, fieldEnd, wanted) { return invalidUser() }
    // password
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) { return invalidUser() }
    // uid and gid
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) { return invalidUser() }
    var uid: u32 = 0
    if !number(source, fieldStart, fieldEnd, &uid) { return invalidUser() }
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) { return invalidUser() }
    var gid: u32 = 0
    if !number(source, fieldStart, fieldEnd, &gid) { return invalidUser() }
    // gecos, then home
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) { return invalidUser() }
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) { return invalidUser() }
    var result = User.{ .identifier = uid, .group = gid, .home = undefined, .homeLength = 0, .valid = true }
    var homeBytes: [*]u8 = undefined
    unsafe { homeBytes = @ptrCast([*]u8, &result.home) }
    var index = fieldStart
    while index < fieldEnd && result.homeLength < HOME_CAPACITY {
        homeBytes[result.homeLength] = source[index]
        result.homeLength += 1
        index += 1
    }
    return result
}

pub fn user(wanted: []const u8) -> User {
    if wanted.length == 0 { return invalidUser() }
    var buffer: [DATABASE_CAPACITY]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    const length = load("/etc/passwd", bytes)
    var start: usize = 0
    while start < length {
        var end = start
        while end < length && bytes[end] != 10 { end += 1 }
        if end > start && bytes[start] != 35 {
            const found = userLine(bytes, start, end, wanted)
            if found.valid { return found }
        }
        start = end + 1
    }
    return invalidUser()
}

fn groupLine(source: [*]const u8, start: usize, end: usize, wanted: []const u8) -> Group {
    var at = start
    var fieldStart: usize = 0
    var fieldEnd: usize = 0
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) || !same(source, fieldStart, fieldEnd, wanted) { return invalidGroup() }
    // password, then gid
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) { return invalidGroup() }
    if !nextField(source, end, &at, &fieldStart, &fieldEnd) { return invalidGroup() }
    var gid: u32 = 0
    if !number(source, fieldStart, fieldEnd, &gid) { return invalidGroup() }
    return Group.{ .identifier = gid, .valid = true }
}

pub fn group(wanted: []const u8) -> Group {
    if wanted.length == 0 { return invalidGroup() }
    var buffer: [DATABASE_CAPACITY]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    const length = load("/etc/group", bytes)
    var start: usize = 0
    while start < length {
        var end = start
        while end < length && bytes[end] != 10 { end += 1 }
        if end > start && bytes[start] != 35 {
            const found = groupLine(bytes, start, end, wanted)
            if found.valid { return found }
        }
        start = end + 1
    }
    return invalidGroup()
}
