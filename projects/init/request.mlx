// One request to the init (impulse) on its control, and its answer: what
// impulsectl sends for the person at a terminal, and what the login
// service (projects/desktop/login) sends to have the machine restarted or
// powered off.
//
// On brixOS the control is a FIFO (/temporary/init/control) that only its
// owner, the system, may write: the request goes there as one line with
// the name of a FIFO of the asker's own in front, on which the answer
// comes. On Linux it is a socket (/run/mlx/init): the request's line goes
// there and the answer comes back on it.
//
//     var reply: [256]u8 = undefined
//     const got = request.send(request.place(environment), "reboot", "", &reply, 256)
//     if got >= 0 && request.accepted(reply[0..@bitCast(usize, got)]) { ... }
const std = @import("std")
const builtin = @import("builtin")

// Why a request got no answer: the asker's FIFO could not be made (the
// init is not running, or this is not the system asking), the init does
// not listen, the request could not be written.
pub const NO_REPLY_NODE: isize = -1
pub const NOT_LISTENING: isize = -2
pub const NOT_SENT: isize = -3

// Where the init listens: what $MLX_INIT_CONTROL of `environment` names
// (the init sets it for every service it starts), else its usual place.
pub fn place(environment: [*][*]const u8) -> []const u8 {
    const named = std.process.environmentFrom(environment, "MLX_INIT_CONTROL")
    if named != null && named.?.length > 0 { return std.string.asSlice(named.?) }
    return if comptime builtin.os == builtin.Os.brixos { "/temporary/init/control" } else { "/run/mlx/init" }
}

// Whether an init listens at `control` for this asker: the FIFO is there
// and may be written (brixOS), the socket takes a connection (Linux; the
// init drops one that closes without a request). Asked before something
// is given up for a request, a session say.
pub fn listens(control: []const u8) -> bool {
    if comptime builtin.os == builtin.Os.brixos {
        const brix = std.os.brix
        const asks = brix.open(0, control, brix.Open.WRITE, 0)
        if asks < 0 { return false }
        _ = brix.close(@intCast(u32, asks))
        return true
    }
    if control.length == 0 || control.length > 107 { return false }
    const socket = std.linux.socket.connectUnix(control, false, std.linux.socket.SOCK_CLOEXEC)
    if socket < 0 { return false }
    std.linux.close(socket)
    return true
}

// `verb` (and `target`, when it has one) sent to the init at `control`,
// its answer read into `reply` (at most `capacity` bytes): how many bytes
// came (status lines, then "ok" or "error: WHY"; 0: it said nothing), or
// one of the failures above.
pub fn send(control: []const u8, verb: []const u8, target: []const u8, reply: [*]u8, capacity: usize) -> isize {
    var request_bytes: [512]u8 = undefined
    const request: [*]u8 = &request_bytes
    var length: usize = 0
    var received: usize = 0
    if comptime builtin.os == builtin.Os.brixos {
        const brix = std.os.brix
        // Our FIFO for the answer, named by the clock.
        var own_bytes: [64]u8 = undefined
        const own: [*]u8 = &own_bytes
        var own_length = std.text.append(own, 0, 64, "/temporary/init/reply.")
        own_length = std.text.appendUnsigned(own, own_length, 64, brix.clock(brix.Clock.MONOTONIC))
        if brix.make(0, own[0..own_length], brix.NodeKind.FIFO, 0x180, "") < 0 { return NO_REPLY_NODE }
        const answers = brix.open(0, own[0..own_length], brix.Open.READ, 0)
        const asks = brix.open(0, control, brix.Open.WRITE, 0)
        if answers < 0 || asks < 0 {
            if answers >= 0 { _ = brix.close(@intCast(u32, answers)) }
            if asks >= 0 { _ = brix.close(@intCast(u32, asks)) }
            _ = brix.remove(0, own[0..own_length])
            return NOT_LISTENING
        }
        length = std.text.append(request, 0, 512, own[0..own_length])
        length = std.text.append(request, length, 512, " ")
        length = std.text.append(request, length, 512, verb)
        if target.length > 0 {
            length = std.text.append(request, length, 512, " ")
            length = std.text.append(request, length, 512, target)
        }
        length = std.text.append(request, length, 512, "\n")
        const written = brix.write(@intCast(u32, asks), request[0..length], brix.STREAM)
        _ = brix.close(@intCast(u32, asks))
        if written < 0 {
            _ = brix.close(@intCast(u32, answers))
            _ = brix.remove(0, own[0..own_length])
            return NOT_SENT
        }
        var more = true
        while more && received < capacity {
            const got = brix.read(@intCast(u32, answers), reply[received..capacity], brix.STREAM)
            if got <= 0 { more = false } else { received += @bitCast(usize, got) }
        }
        _ = brix.close(@intCast(u32, answers))
        _ = brix.remove(0, own[0..own_length])
        return @intCast(isize, received)
    }
    // (sockaddr_un holds 107 bytes of a path.)
    if control.length == 0 || control.length > 107 { return NOT_LISTENING }
    const socket = std.linux.socket.connectUnix(control, false, std.linux.socket.SOCK_CLOEXEC)
    if socket < 0 { return NOT_LISTENING }
    length = std.text.append(request, 0, 512, verb)
    if target.length > 0 {
        length = std.text.append(request, length, 512, " ")
        length = std.text.append(request, length, 512, target)
    }
    length = std.text.append(request, length, 512, "\n")
    if !std.linux.writeAll(socket, request[0..length]) {
        std.linux.close(socket)
        return NOT_SENT
    }
    var more = true
    while more && received < capacity {
        const got = std.linux.read(socket, reply + received, capacity - received)
        if got <= 0 { more = false } else { received += @bitCast(usize, got) }
    }
    std.linux.close(socket)
    return @intCast(isize, received)
}

// The answer's last line: the init's verdict ("ok", or "error: WHY").
pub fn verdict(text: []const u8) -> []const u8 {
    var end = text.length
    while end > 0 && text[end - 1] == 10 { end -= 1 }
    var start = end
    while start > 0 && text[start - 1] != 10 { start -= 1 }
    return text[start..end]
}

// Whether the init took the request.
pub fn accepted(text: []const u8) -> bool { return std.text.same(verdict(text), "ok") }
