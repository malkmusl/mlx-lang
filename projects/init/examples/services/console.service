# The Mlx console on the first virtual terminal: the framebuffer as the
# screen, the keyboards from /dev/input, mlx-sh on a pty (projects/console).
# This is an opt-in rescue console.  Starting it beside mlx-login would make
# two graphics programs own tty1, so the greeter boot set leaves it disabled.
# Once enabled explicitly, it starts again when the shell exits and writes
# its own messages to the tty.
description = Mlx console
exec = /usr/bin/mlx/mlx-console --tty /dev/tty1
stdio = /dev/tty1
after = mlx-ipcd
disabled = yes
