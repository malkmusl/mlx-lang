# The Mlx console on the first virtual terminal: the framebuffer as the
# screen, the keyboards from /dev/input, mlx-sh on a pty (projects/console).
# Started again when the shell exits. Messages of the console itself go to
# the tty.
description = Mlx console
exec = /usr/bin/mlx-console --tty /dev/tty1
stdio = /dev/tty1
after = mlx-ipcd
