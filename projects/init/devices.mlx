// Device discovery for mlx-init. The kernel sends hotplug records on the
// kobject uevent Netlink family. Opening that socket before the sysfs walk
// closes the race between coldplug and a device appearing while booting.
//
// Only the three desktop device classes managed here are changed. DEVNAME
// comes from the kernel, but it is still treated as untrusted before it is
// joined to /dev: absolute paths, empty components and dot components are
// rejected. The groups come from /etc/group rather than fixed distribution
// specific numbers.
const std = @import("std")
const linux = @import("./linux.mlx")

pub const EVENTS: usize = 3

const SYS_socket: usize = 41
const SYS_bind: usize = 49
const NETLINK_KOBJECT_UEVENT: usize = 15
const AF_NETLINK: usize = 16
const SOCK_DGRAM: usize = 2
const SOCK_NONBLOCK: usize = 2048
const SOCK_CLOEXEC: usize = 524288
const NO_GROUP: usize = 18446744073709551615
const ROOT_CAPACITY: usize = 1024
const EVENT_CAPACITY: usize = 16384
const GROUP_FILE_CAPACITY: usize = 65536
const WALK_CAPACITY: usize = 8192

const Address = struct {
    family: u16
    pad: u16
    port: u32
    groups: u32
}

pub const Manager = struct {
    descriptor: isize
    devRoot: [ROOT_CAPACITY]u8
    devRootLength: usize
    videoGroup: usize
    inputGroup: usize
    audioGroup: usize
}

fn rootBytes(manager: *const Manager) -> []const u8 {
    var pointer: [*]const u8 = undefined
    unsafe { pointer = @ptrCast([*]const u8, &manager.*.devRoot) }
    return pointer[0..manager.*.devRootLength]
}

fn same(left: []const u8, right: []const u8) -> bool { return std.text.same(left, right) }

fn starts(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    return same(text[0..prefix.length], prefix)
}

fn digits(text: []const u8) -> ?usize {
    if text.length == 0 { return null }
    var value: usize = 0
    for byte in text {
        if byte < 48 || byte > 57 { return null }
        const digit = @intCast(usize, byte - 48)
        if value > (NO_GROUP - digit) / 10 { return null }
        value = value * 10 + digit
    }
    return value
}

// The numeric id of `wanted` in a traditional group file.
fn groupId(text: []const u8, wanted: []const u8) -> ?usize {
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        var line = text[start..end]
        if line.length > 0 && line[line.length - 1] == 13 { line = line[0..line.length - 1] }
        start = end + 1
        if line.length == 0 || line[0] == 35 { continue }
        var first: usize = 0
        while first < line.length && line[first] != 58 { first += 1 }
        if first == line.length || !same(line[0..first], wanted) { continue }
        var second = first + 1
        while second < line.length && line[second] != 58 { second += 1 }
        if second == line.length { continue }
        var third = second + 1
        while third < line.length && line[third] != 58 { third += 1 }
        const parsed = digits(line[second + 1..third])
        if parsed != null { return parsed }
    }
    return null
}

fn readFile(path: []const u8, into: [*]u8, capacity: usize) -> usize {
    const file = linux.open(path, std.linux.O_RDONLY | std.linux.O_CLOEXEC, 0)
    if file < 0 { return 0 }
    var length: usize = 0
    while length < capacity {
        var target: [*]u8 = undefined
        unsafe { target = @ptrFromInt([*]u8, @intFromPtr(into) + length) }
        const got = std.linux.read(file, target, capacity - length)
        if got <= 0 { break }
        length += @bitCast(usize, got)
    }
    std.linux.close(file)
    return length
}

fn loadGroups(manager: *Manager, group_file: []const u8) -> void {
    manager.*.videoGroup = NO_GROUP
    manager.*.inputGroup = NO_GROUP
    manager.*.audioGroup = NO_GROUP
    var storage: [GROUP_FILE_CAPACITY]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &storage) }
    const length = readFile(group_file, bytes, GROUP_FILE_CAPACITY)
    const video = groupId(bytes[0..length], "video")
    const input = groupId(bytes[0..length], "input")
    const audio = groupId(bytes[0..length], "audio")
    if video != null { manager.*.videoGroup = video.? }
    if input != null { manager.*.inputGroup = input.? }
    if audio != null { manager.*.audioGroup = audio.? }
}

pub fn initialize(manager: *Manager, dev_root: []const u8, group_file: []const u8) -> void {
    manager.*.descriptor = -1
    var root: [*]u8 = undefined
    unsafe { root = @ptrCast([*]u8, &manager.*.devRoot) }
    manager.*.devRootLength = 0
    if dev_root.length < ROOT_CAPACITY {
        manager.*.devRootLength = std.text.append(root, 0, ROOT_CAPACITY, dev_root)
    }
    loadGroups(manager, group_file)
}

// A property from either a NUL-separated live event or a newline-separated
// sysfs uevent file.
fn property(record: []const u8, key: []const u8) -> []const u8 {
    var start: usize = 0
    while start < record.length {
        var end = start
        while end < record.length && record[end] != 0 && record[end] != 10 { end += 1 }
        var line = record[start..end]
        if line.length > 0 && line[line.length - 1] == 13 { line = line[0..line.length - 1] }
        if line.length > key.length && line[key.length] == 61 && same(line[0..key.length], key) {
            return line[key.length + 1..line.length]
        }
        start = end + 1
    }
    return ""
}

fn safeName(name: []const u8) -> bool {
    if name.length == 0 || name[0] == 47 { return false }
    var start: usize = 0
    while start < name.length {
        var end = start
        while end < name.length && name[end] != 47 { end += 1 }
        const part = name[start..end]
        if part.length == 0 || same(part, ".") || same(part, "..") { return false }
        start = end + 1
    }
    return name[name.length - 1] != 47
}

fn groupFor(manager: *const Manager, name: []const u8) -> usize {
    if starts(name, "dri/") { return manager.*.videoGroup }
    if starts(name, "input/") { return manager.*.inputGroup }
    if starts(name, "snd/") { return manager.*.audioGroup }
    return NO_GROUP
}

fn applyName(manager: *Manager, name: []const u8) -> bool {
    if !safeName(name) { return false }
    const group = groupFor(manager, name)
    if group == NO_GROUP { return false }
    const root = rootBytes(manager)
    if root.length + name.length + 2 > ROOT_CAPACITY * 2 { return false }
    var path_storage: [ROOT_CAPACITY * 2]u8 = undefined
    var path: [*]u8 = undefined
    unsafe { path = @ptrCast([*]u8, &path_storage) }
    var length = std.text.append(path, 0, ROOT_CAPACITY * 2, root)
    if length == 0 || path[length - 1] != 47 { length = std.text.append(path, length, ROOT_CAPACITY * 2, "/") }
    length = std.text.append(path, length, ROOT_CAPACITY * 2, name)
    path[length] = 0
    // Keeping the uid leaves devtmpfs' root ownership intact. chown can
    // clear mode bits, so chmod deliberately follows it.
    const owned = std.fs.changeOwner(path, NO_GROUP, group, false)
    const restricted = std.fs.chmod(path, 432)
    return owned && restricted
}

// Applies one live or synthetic uevent. Remove events never touch a path
// that may already have been reused for another device.
pub fn applyEvent(manager: *Manager, record: []const u8) -> bool {
    const action = property(record, "ACTION")
    if action.length > 0 && !same(action, "add") && !same(action, "change") && !same(action, "bind") { return false }
    return applyName(manager, property(record, "DEVNAME"))
}

fn joined(base: []const u8, name: []const u8, into: [*]u8, capacity: usize) -> usize {
    if base.length + name.length + 2 > capacity { return 0 }
    var length = std.text.append(into, 0, capacity, base)
    if length == 0 || into[length - 1] != 47 { length = std.text.append(into, length, capacity, "/") }
    length = std.text.append(into, length, capacity, name)
    into[length] = 0
    return length
}

// Replays the device descriptions already present in the three relevant
// sysfs classes. Class entries are normally symlinks, so their uevent file is
// opened explicitly instead of recursively following arbitrary links.
fn scanClass(manager: *Manager, sys_root: []const u8, class_name: []const u8) -> usize {
    var class_storage: [ROOT_CAPACITY * 2]u8 = undefined
    var class_path: [*]u8 = undefined
    unsafe { class_path = @ptrCast([*]u8, &class_storage) }
    var relative_storage: [ROOT_CAPACITY]u8 = undefined
    var relative: [*]u8 = undefined
    unsafe { relative = @ptrCast([*]u8, &relative_storage) }
    var relative_length = std.text.append(relative, 0, ROOT_CAPACITY, "class/")
    relative_length = std.text.append(relative, relative_length, ROOT_CAPACITY, class_name)
    const class_length = joined(sys_root, relative[0..relative_length], class_path, ROOT_CAPACITY * 2)
    if class_length == 0 { return 0 }
    const directory = linux.open(class_path[0..class_length], std.linux.O_RDONLY | std.linux.O_DIRECTORY | std.linux.O_CLOEXEC, 0)
    if directory < 0 { return 0 }
    var names: [WALK_CAPACITY]u8 = undefined
    var names_pointer: [*]u8 = undefined
    unsafe { names_pointer = @ptrCast([*]u8, &names) }
    var reader = std.fs.entries(std.fs.File.{ .descriptor = directory }, names_pointer, WALK_CAPACITY)
    var entry: std.fs.Entry = undefined
    var changed: usize = 0
    while std.fs.nextEntry(&reader, &entry) {
        if std.fs.isDotName(entry.name) { continue }
        var entry_storage: [ROOT_CAPACITY * 2]u8 = undefined
        var entry_path: [*]u8 = undefined
        unsafe { entry_path = @ptrCast([*]u8, &entry_storage) }
        const entry_length = joined(class_path[0..class_length], std.string.asSlice(entry.name), entry_path, ROOT_CAPACITY * 2)
        if entry_length == 0 { continue }
        var event_storage: [ROOT_CAPACITY * 2]u8 = undefined
        var event_path: [*]u8 = undefined
        unsafe { event_path = @ptrCast([*]u8, &event_storage) }
        const event_length = joined(entry_path[0..entry_length], "uevent", event_path, ROOT_CAPACITY * 2)
        if event_length == 0 { continue }
        var record_storage: [EVENT_CAPACITY]u8 = undefined
        var record: [*]u8 = undefined
        unsafe { record = @ptrCast([*]u8, &record_storage) }
        const amount = readFile(event_path[0..event_length], record, EVENT_CAPACITY)
        if amount > 0 && applyEvent(manager, record[0..amount]) { changed += 1 }
    }
    std.linux.close(directory)
    return changed
}

pub fn coldplug(manager: *Manager, sys_root: []const u8) -> usize {
    var changed = scanClass(manager, sys_root, "drm")
    changed += scanClass(manager, sys_root, "input")
    changed += scanClass(manager, sys_root, "sound")
    return changed
}

// Starts listening before coldplug. The caller adds descriptor() to epoll.
pub fn openEvents(manager: *Manager) -> bool {
    const descriptor = std.linux.syscall3(SYS_socket, AF_NETLINK, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, NETLINK_KOBJECT_UEVENT)
    if descriptor < 0 { return false }
    var address = Address.{ .family = @intCast(u16, AF_NETLINK), .pad = 0, .port = 0, .groups = 1 }
    if std.linux.syscall3(SYS_bind, @bitCast(usize, descriptor), @intFromPtr(&address), 12) != 0 {
        std.linux.close(descriptor)
        return false
    }
    manager.*.descriptor = descriptor
    return true
}

pub fn descriptor(manager: *const Manager) -> isize { return manager.*.descriptor }

pub fn close(manager: *Manager) -> void {
    if manager.*.descriptor >= 0 { std.linux.close(manager.*.descriptor) }
    manager.*.descriptor = -1
}

// Drains all queued datagrams; malformed and unrelated records are ignored.
pub fn readable(manager: *Manager) -> usize {
    if manager.*.descriptor < 0 { return 0 }
    var storage: [EVENT_CAPACITY]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &storage) }
    var changed: usize = 0
    var amount = std.linux.read(manager.*.descriptor, bytes, EVENT_CAPACITY)
    while amount > 0 {
        if applyEvent(manager, bytes[0..@bitCast(usize, amount)]) { changed += 1 }
        amount = std.linux.read(manager.*.descriptor, bytes, EVENT_CAPACITY)
    }
    return changed
}
