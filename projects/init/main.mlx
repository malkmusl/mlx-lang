// mlx-init: the init of MLX/Linux, PID 1, written in Mlx without libc. As
// PID 1 it mounts /proc, /sys, /dev (with pts and shm) and /run, mounts
// what the mounts file lists, sets the hostname, applies coldplug device
// permissions, watches kernel uevents, and starts the services defined in
// the services directory (config.mlx says how), in their order.
// Then it supervises them (supervise.mlx): ended ones are started again
// after a pause that grows while they keep failing, orphans are reaped,
// and requests come in over the control socket (control.mlx), from
// mlx-initctl: status, start, stop, restart, reload, poweroff, reboot,
// halt. The shutdown (power.mlx) stops dependents before their dependencies,
// kills what is left, syncs, unmounts, and hands over to the kernel.
//
//     mlx4 projects/init/main.mlx -o mlx-init
//     mlx4 projects/init/tool.mlx -o mlx-initctl
//     tools/check_init.sh                      the end-to-end check
//
// Not PID 1 (started by hand or by a test), it supervises the same way,
// without the mounts, the hostname and the reboot: a shutdown request or
// SIGTERM stops the services and ends it.
//
// Options:
//     --services DIR    the NAME.service files (default /etc/mlx/init/services)
//     --mounts FILE     fstab (default /etc/fstab)
//     --fsck PROGRAM    checker for nonzero fstab passes (default
//                       /sbin/fsck; `none` disables checking)
//     --hostname FILE   the hostname (default /etc/hostname; PID 1 only)
//     --control PATH    the control socket (default /run/mlx/init)
//     --log DIR         persistent logs, DIR/NAME.log (default /var/log/mlx)
//     --runtime-log DIR early fallback logs (default /run/mlx/log)
//     --log-size BYTES  rotate at this size (default 1048576, four backups)
//     --verbose         say every start, stop, ready and reaping
//
// Signals: SIGCHLD reaps, SIGHUP reads the services again, SIGINT
// (Ctrl-Alt-Del) and SIGTERM reboot, SIGUSR1 halts, SIGUSR2 powers off
// (not PID 1: each of the four ends the init).
const std = @import("std")
const crash = @import("std.crash")
const turns_module = @import("std.turns")
const linux = @import("./linux.mlx")
const config = @import("./config.mlx")
const supervise = @import("./supervise.mlx")
const mounts = @import("./mounts.mlx")
const control = @import("./control.mlx")
const power = @import("./power.mlx")
const devices = @import("./devices.mlx")

const State = config.State

fn named(text: std.string.String, name: []const u8) -> bool { return std.string.eql(text, std.string.fromSlice(name)) }

fn usage() -> u8 {
    _ = std.io.eprintln("usage: mlx-init [--services DIR] [--mounts FILE] [--fsck PROGRAM|none] [--hostname FILE] [--control PATH] [--log DIR] [--runtime-log DIR] [--log-size BYTES] [--verbose]")
    return 2
}

fn positiveNumber(text: std.string.String) -> usize {
    const value = std.string.asSlice(text)
    if value.length == 0 { return 0 }
    var result: usize = 0
    for byte in value {
        if byte < 48 || byte > 57 { return 0 }
        result = result * 10 + @intCast(usize, byte - 48)
    }
    return result
}

// /etc/hostname's first line as the hostname.
fn setHostname(state: *State) -> void {
    const size = config.readFile(state, config.hostnameFile(state))
    if size == 0 { return }
    const text = config.scratch(state)
    var end: usize = 0
    while end < size && text[end] != 10 { end += 1 }
    const name = std.text.trimmed(text[0..end])
    if name.length == 0 || name[0] == 35 { return }
    if linux.setHostname(name) != 0 {
        config.sayWith("could not set the hostname ", name, false, 0)
    } else if state.*.verbose {
        config.sayWith("hostname ", name, false, 0)
    }
}

// What a signal asks for.
fn onSignal(state: *State, signal: usize) -> void {
    if signal == std.linux.SIGCHLD {
        supervise.reapAll(state)
    } else if signal == std.linux.SIGHUP {
        config.say("reading the services again (SIGHUP)")
        _ = config.load(state)
    } else if signal == std.linux.SIGINT || signal == std.linux.SIGTERM {
        state.*.action = if state.*.pid1 { config.ACTION_REBOOT } else { config.ACTION_EXIT }
        state.*.running = false
    } else if signal == std.linux.SIGUSR1 {
        state.*.action = if state.*.pid1 { config.ACTION_HALT } else { config.ACTION_EXIT }
        state.*.running = false
    } else if signal == std.linux.SIGUSR2 {
        state.*.action = if state.*.pid1 { config.ACTION_POWEROFF } else { config.ACTION_EXIT }
        state.*.running = false
    }
}

fn serve(state: *State, device_manager: *devices.Manager) -> void {
    var events: std.linux.event.Events = undefined
    // What the loop keeps was made before the turns' mark; each turn
    // releases what came after it.
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    while state.*.running {
        turns_module.turn(&turns)
        const count = std.linux.event.waitEvents(state.*.eventLoop, &events, supervise.nextTimeout(state))
        var index: usize = 0
        while count > 0 && index < @intCast(usize, count) {
            const token = std.linux.event.eventToken(&events, index)
            if token == control.LISTENER {
                control.accept(state)
            } else if token == control.SIGNALS {
                var signal = std.linux.event.readSignal(state.*.signals)
                while signal != 0 {
                    onSignal(state, @intCast(usize, signal))
                    signal = std.linux.event.readSignal(state.*.signals)
                }
            } else if token == devices.EVENTS {
                const changed = devices.readable(device_manager)
            } else if control.isClient(token) {
                control.readable(state, token)
            }
            index += 1
        }
        if state.*.running { supervise.tick(state) }
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(State), 16)
    if memory == null {
        config.say("out of memory")
        return 1
    }
    const state: *State = unsafe { @ptrCast(*State, memory.?) }
    state.*.count = 0
    state.*.sequence = 0
    state.*.verbose = false
    state.*.running = true
    state.*.action = config.ACTION_NONE
    state.*.listener = -1
    state.*.signals = -1
    state.*.eventLoop = -1
    var clientIndex: usize = 0
    while clientIndex < config.MAX_CLIENTS {
        var client: *config.ControlClient = undefined
        unsafe { client = @ptrCast(*config.ControlClient, &state.*.clients[clientIndex]) }
        client.*.used = false
        client.*.descriptor = -1
        clientIndex += 1
    }
    config.setServicesDirectory(state, "/etc/mlx/init/services")
    config.setMountsFile(state, "/etc/fstab")
    config.setHostnameFile(state, "/etc/hostname")
    config.setControlPath(state, "/run/mlx/init")
    config.setLogDirectory(state, "/var/log/mlx")
    config.setRuntimeLogDirectory(state, "/run/mlx/log")
    state.*.logRotateSize = 1048576
    var fsckProgram: []const u8 = "/sbin/fsck"
    const argument_count = std.process.count(arguments)
    var index: usize = 1
    while index < argument_count {
        const option = std.process.argument(arguments, index)
        const has_value = index + 1 < argument_count
        if named(option, "--verbose") {
            state.*.verbose = true
        } else if named(option, "--services") && has_value {
            config.setServicesDirectory(state, std.string.asSlice(std.process.argument(arguments, index + 1)))
            index += 1
        } else if named(option, "--mounts") && has_value {
            config.setMountsFile(state, std.string.asSlice(std.process.argument(arguments, index + 1)))
            index += 1
        } else if named(option, "--fsck") && has_value {
            fsckProgram = std.string.asSlice(std.process.argument(arguments, index + 1))
            if fsckProgram.length == 0 { return usage() }
            index += 1
        } else if named(option, "--hostname") && has_value {
            config.setHostnameFile(state, std.string.asSlice(std.process.argument(arguments, index + 1)))
            index += 1
        } else if named(option, "--control") && has_value {
            config.setControlPath(state, std.string.asSlice(std.process.argument(arguments, index + 1)))
            index += 1
        } else if named(option, "--log") && has_value {
            config.setLogDirectory(state, std.string.asSlice(std.process.argument(arguments, index + 1)))
            index += 1
        } else if named(option, "--runtime-log") && has_value {
            config.setRuntimeLogDirectory(state, std.string.asSlice(std.process.argument(arguments, index + 1)))
            index += 1
        } else if named(option, "--log-size") && has_value {
            state.*.logRotateSize = positiveNumber(std.process.argument(arguments, index + 1))
            if state.*.logRotateSize == 0 { return usage() }
            index += 1
        } else {
            return usage()
        }
        index += 1
    }
    state.*.pid1 = std.linux.getpid() == 1
    var device_manager: devices.Manager = undefined
    devices.initialize(&device_manager, "/dev", "/etc/group")
    if state.*.pid1 {
        config.say("MLX/Linux init starting")
        _ = std.linux.syscall1(std.linux.SYS_umask, 18)
        _ = linux.changeDirectory("/")
        mounts.early()
        // Ctrl-Alt-Del comes as SIGINT instead of a reboot at once.
        _ = linux.reboot(linux.REBOOT_CAD_OFF)
        setHostname(state)
    }
    if state.*.pid1 {
        if !mounts.checkFileSystems(state, fsckProgram) {
            // A failed check must never be followed by mounts or services.
            // Use the normal shutdown path so already mounted file systems
            // are synced and made read-only before the machine halts.
            config.say("boot stopped after a file-system check failure")
            state.*.action = config.ACTION_HALT
            power.shutdown(state)
            return 1
        }
        mounts.fromFile(state)
        if !devices.openEvents(&device_manager) {
            config.say("could not listen for kernel device events")
        }
        const changed = devices.coldplug(&device_manager, "/sys")
        if state.*.verbose { config.sayWith("device permissions applied during coldplug: ", "", true, changed) }
    }
    _ = std.fs.makeDirectories(config.logDirectory(state), 493)
    _ = std.fs.makeDirectories(config.runtimeLogDirectory(state), 493)
    _ = std.fs.makeParents(config.controlPath(state), 493)
    // The signals come through a descriptor, blocked otherwise (the
    // children unblock them before they run their programs).
    const signals = std.linux.process.signalBit(std.linux.SIGCHLD) | std.linux.process.signalBit(std.linux.SIGHUP) | std.linux.process.signalBit(std.linux.SIGINT) | std.linux.process.signalBit(std.linux.SIGTERM) | std.linux.process.signalBit(std.linux.SIGUSR1) | std.linux.process.signalBit(std.linux.SIGUSR2)
    state.*.signals = std.linux.event.signalDescriptor(signals)
    state.*.eventLoop = std.linux.event.createEventLoop()
    if state.*.signals < 0 || state.*.eventLoop < 0 {
        config.say("no signal descriptor or event loop from the kernel")
        return 1
    }
    _ = std.linux.event.watch(state.*.eventLoop, state.*.signals, control.SIGNALS, false)
    if devices.descriptor(&device_manager) >= 0 && !std.linux.event.watch(state.*.eventLoop, devices.descriptor(&device_manager), devices.EVENTS, false) {
        config.say("could not watch kernel device events")
        devices.close(&device_manager)
    }
    if !control.listen(state) { config.sayWith("could not listen at ", config.controlPath(state), false, 0) }
    const defined = config.load(state)
    config.sayWith("services defined: ", "", true, defined)
    supervise.tick(state)
    serve(state, &device_manager)
    devices.close(&device_manager)
    power.shutdown(state)
    return 0
}
