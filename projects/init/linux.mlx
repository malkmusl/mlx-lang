// The system calls the init needs beyond std.linux: the mounts, the
// hostname and the reboot, and paths given as Mlx slices (made
// NUL-terminated here, in buffers of their own). Descriptors, processes,
// signals, sockets and the event loop are std.linux's. Nothing here needs
// libc.
const std = @import("std")

// mount(2) flags.
pub const MS_RDONLY: usize = 1
pub const MS_NOSUID: usize = 2
pub const MS_NODEV: usize = 4
pub const MS_NOEXEC: usize = 8
pub const MS_SYNCHRONOUS: usize = 16
pub const MS_REMOUNT: usize = 32
pub const MS_NOATIME: usize = 1024
pub const MS_NODIRATIME: usize = 2048
pub const MS_BIND: usize = 4096
pub const MS_RELATIME: usize = 2097152
pub const MS_STRICTATIME: usize = 16777216
pub const MNT_DETACH: usize = 2

// reboot(2).
pub const REBOOT_MAGIC1: usize = 4276215469
pub const REBOOT_MAGIC2: usize = 672274793
pub const REBOOT_RESTART: usize = 19088743
pub const REBOOT_HALT: usize = 3454992675
pub const REBOOT_POWER_OFF: usize = 1126301404
pub const REBOOT_CAD_OFF: usize = 0

pub const PATH_CAPACITY: usize = 1024

fn pathPointer(buffer: *const [PATH_CAPACITY]u8) -> [*]u8 {
    const pointer: [*]u8 = unsafe { @ptrCast([*]u8, buffer) }
    return pointer
}

pub fn open(path: []const u8, flags: usize, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.open(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path), flags, mode)
}

pub fn makeDirectory(path: []const u8, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.makeDirectory(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path), mode)
}

pub fn unlink(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.unlink(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path))
}

pub fn chmod(path: []const u8, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.chmod(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path), mode)
}

pub fn changeDirectory(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.chdir(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path))
}

pub fn exists(path: []const u8) -> bool {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.fs.exists(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path))
}

// The file system type (f_type) of what is mounted at `path`, or -1.
pub fn fileSystemType(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    var result: std.fs.FileSystemStat = undefined
    if std.fs.fileSystemStatus(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path), &result) != 0 { return -1 }
    return result.fileSystemType
}

pub fn mount(source: []const u8, target: []const u8, kind: []const u8, flags: usize, data: []const u8) -> isize {
    var source_buffer: [PATH_CAPACITY]u8 = undefined
    var target_buffer: [PATH_CAPACITY]u8 = undefined
    var kind_buffer: [64]u8 = undefined
    var data_buffer: [256]u8 = undefined
    const kind_pointer: [*]u8 = &kind_buffer
    const data_pointer: [*]u8 = &data_buffer
    return std.linux.syscall5(std.linux.SYS_mount, @intFromPtr(std.text.zeroTerminated(pathPointer(&source_buffer), PATH_CAPACITY, source)), @intFromPtr(std.text.zeroTerminated(pathPointer(&target_buffer), PATH_CAPACITY, target)), @intFromPtr(std.text.zeroTerminated(kind_pointer, 64, kind)), flags, @intFromPtr(std.text.zeroTerminated(data_pointer, 256, data)))
}

pub fn unmount(target: []const u8, flags: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall2(std.linux.SYS_umount2, @intFromPtr(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, target)), flags)
}

pub fn setHostname(name: []const u8) -> isize {
    const pointer: [*]const u8 = name.pointer
    return std.linux.syscall2(std.linux.SYS_sethostname, @intFromPtr(pointer), name.length)
}

pub fn sync() -> void {
    _ = std.linux.syscall0(std.linux.SYS_sync)
}

pub fn reboot(command: usize) -> isize {
    return std.linux.syscall4(std.linux.SYS_reboot, REBOOT_MAGIC1, REBOOT_MAGIC2, command, 0)
}

// A listening Unix stream socket at `path` (a stale socket there is
// removed), non-blocking; negative when it could not be made.
pub fn listen(path: []const u8, backlog: usize) -> isize {
    _ = unlink(path)
    return std.linux.socket.listenUnix(path, false, std.linux.socket.SOCK_NONBLOCK | std.linux.socket.SOCK_CLOEXEC, backlog)
}
