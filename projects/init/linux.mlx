// The system calls the init needs beyond std: processes and signals, the
// mounts and the reboot, Unix sockets and epoll. Numbers for x86_64, and
// thin wrappers that take Mlx slices (NUL-terminated here, in buffers of
// their own). Nothing here needs libc.
const std = @import("std")

pub const SYS_read: usize = 0
pub const SYS_write: usize = 1
pub const SYS_open: usize = 2
pub const SYS_close: usize = 3
pub const SYS_rt_sigprocmask: usize = 14
pub const SYS_ioctl: usize = 16
pub const SYS_dup2: usize = 33
pub const SYS_nanosleep: usize = 35
pub const SYS_getpid: usize = 39
pub const SYS_socket: usize = 41
pub const SYS_connect: usize = 42
pub const SYS_bind: usize = 49
pub const SYS_listen: usize = 50
pub const SYS_fork: usize = 57
pub const SYS_execve: usize = 59
pub const SYS_wait4: usize = 61
pub const SYS_kill: usize = 62
pub const SYS_chdir: usize = 80
pub const SYS_mkdir: usize = 83
pub const SYS_unlink: usize = 87
pub const SYS_chmod: usize = 90
pub const SYS_umask: usize = 95
pub const SYS_setsid: usize = 112
pub const SYS_statfs: usize = 137
pub const SYS_sync: usize = 162
pub const SYS_mount: usize = 165
pub const SYS_umount2: usize = 166
pub const SYS_reboot: usize = 169
pub const SYS_sethostname: usize = 170
pub const SYS_exit_group: usize = 231
pub const SYS_epoll_wait: usize = 232
pub const SYS_epoll_ctl: usize = 233
pub const SYS_accept4: usize = 288
pub const SYS_signalfd4: usize = 289
pub const SYS_epoll_create1: usize = 291

pub const O_RDONLY: usize = 0
pub const O_WRONLY: usize = 1
pub const O_RDWR: usize = 2
pub const O_CREAT: usize = 64
pub const O_NOCTTY: usize = 256
pub const O_APPEND: usize = 1024
pub const O_DIRECTORY: usize = 65536
pub const O_CLOEXEC: usize = 524288

pub const SIGHUP: usize = 1
pub const SIGINT: usize = 2
pub const SIGKILL: usize = 9
pub const SIGUSR1: usize = 10
pub const SIGUSR2: usize = 12
pub const SIGTERM: usize = 15
pub const SIGCHLD: usize = 17

pub const EPOLLIN: u32 = 1
pub const EPOLLERR: u32 = 8
pub const EPOLLHUP: u32 = 16
// An epoll_event is packed on x86_64: the flags (u32), then the token (u64).
pub const EVENT_SIZE: usize = 12
pub const MAX_EVENTS: usize = 32

// mount(2) flags.
pub const MS_RDONLY: usize = 1
pub const MS_NOSUID: usize = 2
pub const MS_NODEV: usize = 4
pub const MS_NOEXEC: usize = 8
pub const MS_SYNCHRONOUS: usize = 16
pub const MS_REMOUNT: usize = 32
pub const MS_NOATIME: usize = 1024
pub const MS_NODIRATIME: usize = 2048
pub const MS_BIND: usize = 4096
pub const MS_RELATIME: usize = 2097152
pub const MS_STRICTATIME: usize = 16777216
pub const MNT_DETACH: usize = 2

// reboot(2).
pub const REBOOT_MAGIC1: usize = 4276215469
pub const REBOOT_MAGIC2: usize = 672274793
pub const REBOOT_RESTART: usize = 19088743
pub const REBOOT_HALT: usize = 3454992675
pub const REBOOT_POWER_OFF: usize = 1126301404
pub const REBOOT_CAD_OFF: usize = 0

pub const TIOCSCTTY: usize = 21518

pub const PATH_CAPACITY: usize = 1024

// `text` NUL-terminated in `into` (truncated to fit); the pointer to pass.
pub fn cString(into: [*]u8, capacity: usize, text: []const u8) -> [*]const u8 {
    var length: usize = 0
    for byte in text {
        if length + 1 < capacity {
            into[length] = byte
            length += 1
        }
    }
    into[length] = 0
    return into
}

fn pathPointer(buffer: *const [PATH_CAPACITY]u8) -> [*]u8 {
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, buffer) }
    return pointer
}

pub fn open(path: []const u8, flags: usize, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall3(SYS_open, @intFromPtr(cString(pathPointer(&buffer), PATH_CAPACITY, path)), flags, mode)
}

pub fn close(descriptor: isize) -> void {
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

pub fn read(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    return std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), @intFromPtr(into), capacity)
}

pub fn write(descriptor: isize, bytes: [*]const u8, length: usize) -> isize {
    return std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(bytes), length)
}

// Writes all of `text`, as far as the descriptor takes it.
pub fn writeAll(descriptor: isize, text: []const u8) -> bool {
    var pointer: [*]const u8 = undefined
    unsafe { pointer = @ptrCast([*]const u8, text) }
    var done: usize = 0
    while done < text.length {
        const wrote = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(pointer) + done, text.length - done)
        if wrote <= 0 { return false }
        done += @bitCast(usize, wrote)
    }
    return true
}

pub fn makeDirectory(path: []const u8, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall2(SYS_mkdir, @intFromPtr(cString(pathPointer(&buffer), PATH_CAPACITY, path)), mode)
}

pub fn unlink(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall1(SYS_unlink, @intFromPtr(cString(pathPointer(&buffer), PATH_CAPACITY, path)))
}

pub fn chmod(path: []const u8, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall2(SYS_chmod, @intFromPtr(cString(pathPointer(&buffer), PATH_CAPACITY, path)), mode)
}

pub fn changeDirectory(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall1(SYS_chdir, @intFromPtr(cString(pathPointer(&buffer), PATH_CAPACITY, path)))
}

pub fn exists(path: []const u8) -> bool {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.fs.exists(cString(pathPointer(&buffer), PATH_CAPACITY, path))
}

// The file system type (f_type) of what is mounted at `path`, or -1.
pub fn fileSystemType(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    var result: std.fs.FileSystemStat = undefined
    if std.fs.fileSystemStatus(cString(pathPointer(&buffer), PATH_CAPACITY, path), &result) != 0 { return -1 }
    return result.fileSystemType
}

pub fn fork() -> isize { return std.linux.syscall0(SYS_fork) }

pub fn getPid() -> isize { return std.linux.syscall0(SYS_getpid) }

pub fn setSession() -> isize { return std.linux.syscall0(SYS_setsid) }

pub fn dup2(from: isize, to: usize) -> isize {
    return std.linux.syscall2(SYS_dup2, @bitCast(usize, from), to)
}

pub fn exit(status: usize) -> void {
    const ended = std.linux.syscall1(SYS_exit_group, status)
}

// The next ended child (WNOHANG): its pid, with the raw wait status in
// `status`; 0 when none has ended, negative without children.
pub fn reap(status: *usize) -> isize {
    var raw: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    const pid = std.linux.syscall4(SYS_wait4, 18446744073709551615, @intFromPtr(&raw), 1, 0)
    status.* = @intCast(usize, raw[0]) | (@intCast(usize, raw[1]) << 8)
    return pid
}

// An exit code, or 128 plus the signal, from a raw wait status.
pub fn exitStatus(raw: usize) -> usize {
    if raw & 127 == 0 { return (raw >> 8) & 255 }
    return 128 + (raw & 127)
}

// kill(2); a negative pid is a process group.
pub fn kill(pid: isize, signal: usize) -> isize {
    return std.linux.syscall2(SYS_kill, @bitCast(usize, pid), signal)
}

pub fn execute(program: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8) -> isize {
    return std.linux.syscall3(SYS_execve, @intFromPtr(program), @intFromPtr(arguments), @intFromPtr(environment))
}

pub fn blockSignals(mask: usize) -> void {
    var blocked: [2]usize = [2]usize{ mask, 0 }
    const masked = std.linux.syscall4(SYS_rt_sigprocmask, 0, @intFromPtr(&blocked), 0, 8)
}

pub fn unblockAllSignals() -> void {
    var none: [2]usize = [2]usize{ 0, 0 }
    const unblocked = std.linux.syscall4(SYS_rt_sigprocmask, 2, @intFromPtr(&none), 0, 8)
}

// A descriptor delivering the (blocked) signals in `mask`, non-blocking.
pub fn signalDescriptor(mask: usize) -> isize {
    var blocked: [2]usize = [2]usize{ mask, 0 }
    return std.linux.syscall4(SYS_signalfd4, 18446744073709551615, @intFromPtr(&blocked), 8, 526336)
}

// The next signal from a signal descriptor, or 0.
pub fn readSignal(descriptor: isize) -> usize {
    var record: [128]u8 = undefined
    if read(descriptor, @ptrCast([*]u8, &record), 128) != 128 { return 0 }
    return @intCast(usize, record[0]) | (@intCast(usize, record[1]) << 8)
}

pub fn bit(signal: usize) -> usize { return 1 << (signal - 1) }

pub fn mount(source: []const u8, target: []const u8, kind: []const u8, flags: usize, data: []const u8) -> isize {
    var source_buffer: [PATH_CAPACITY]u8 = undefined
    var target_buffer: [PATH_CAPACITY]u8 = undefined
    var kind_buffer: [64]u8 = undefined
    var data_buffer: [256]u8 = undefined
    var kind_pointer: [*]u8 = undefined
    var data_pointer: [*]u8 = undefined
    unsafe {
        kind_pointer = @ptrCast([*]u8, &kind_buffer)
        data_pointer = @ptrCast([*]u8, &data_buffer)
    }
    return std.linux.syscall5(SYS_mount, @intFromPtr(cString(pathPointer(&source_buffer), PATH_CAPACITY, source)), @intFromPtr(cString(pathPointer(&target_buffer), PATH_CAPACITY, target)), @intFromPtr(cString(kind_pointer, 64, kind)), flags, @intFromPtr(cString(data_pointer, 256, data)))
}

pub fn unmount(target: []const u8, flags: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall2(SYS_umount2, @intFromPtr(cString(pathPointer(&buffer), PATH_CAPACITY, target)), flags)
}

pub fn setHostname(name: []const u8) -> isize {
    var pointer: [*]const u8 = undefined
    unsafe { pointer = @ptrCast([*]const u8, name) }
    return std.linux.syscall2(SYS_sethostname, @intFromPtr(pointer), name.length)
}

pub fn sync() -> void {
    const synced = std.linux.syscall0(SYS_sync)
}

pub fn reboot(command: usize) -> isize {
    return std.linux.syscall4(SYS_reboot, REBOOT_MAGIC1, REBOOT_MAGIC2, command, 0)
}

pub fn sleepMilliseconds(milliseconds: usize) -> void {
    var duration: [2]usize = [2]usize{ milliseconds / 1000, (milliseconds % 1000) * 1000000 }
    const slept = std.linux.syscall2(SYS_nanosleep, @intFromPtr(&duration), 0)
}

pub fn ioctl(descriptor: isize, request: usize, argument: usize) -> isize {
    return std.linux.syscall3(SYS_ioctl, @bitCast(usize, descriptor), request, argument)
}

// sockaddr_un: the family (AF_UNIX) then the path, NUL-terminated.
fn unixAddress(address: *const [110]u8, path: []const u8) -> usize {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, address) }
    bytes[0] = 1
    bytes[1] = 0
    var length: usize = 0
    for byte in path {
        if length + 3 < 110 {
            bytes[2 + length] = byte
            length += 1
        }
    }
    bytes[2 + length] = 0
    return 3 + length
}

// A listening Unix stream socket at `path` (a stale socket there is
// removed), non-blocking; negative when it could not be made.
pub fn listen(path: []const u8, backlog: usize) -> isize {
    const removed = unlink(path)
    const socket = std.linux.syscall3(SYS_socket, 1, 1 | 2048 | 524288, 0)
    if socket < 0 { return socket }
    var address: [110]u8 = undefined
    const size = unixAddress(&address, path)
    if std.linux.syscall3(SYS_bind, @bitCast(usize, socket), @intFromPtr(&address), size) != 0 {
        close(socket)
        return -1
    }
    if std.linux.syscall2(SYS_listen, @bitCast(usize, socket), backlog) != 0 {
        close(socket)
        return -1
    }
    return socket
}

// The next connection on a listening socket, non-blocking; negative when
// none waits.
pub fn accept(listener: isize) -> isize {
    return std.linux.syscall4(SYS_accept4, @bitCast(usize, listener), 0, 0, 2048 | 524288)
}

// A blocking connection to the Unix stream socket at `path`.
pub fn connect(path: []const u8) -> isize {
    const socket = std.linux.syscall3(SYS_socket, 1, 1 | 524288, 0)
    if socket < 0 { return socket }
    var address: [110]u8 = undefined
    const size = unixAddress(&address, path)
    if std.linux.syscall3(SYS_connect, @bitCast(usize, socket), @intFromPtr(&address), size) != 0 {
        close(socket)
        return -1
    }
    return socket
}

pub fn eventLoop() -> isize { return std.linux.syscall1(SYS_epoll_create1, 524288) }

pub fn watch(loop: isize, descriptor: isize, token: usize) -> bool {
    var event: [EVENT_SIZE]u8 = undefined
    event[0] = 1
    event[1] = 0
    event[2] = 0
    event[3] = 0
    var index: usize = 0
    while index < 8 {
        event[4 + index] = @intCast(u8, (token >> (index * 8)) & 255)
        index += 1
    }
    return std.linux.syscall4(SYS_epoll_ctl, @bitCast(usize, loop), 1, @bitCast(usize, descriptor), @intFromPtr(&event)) == 0
}

pub fn unwatch(loop: isize, descriptor: isize) -> void {
    var event: [EVENT_SIZE]u8 = undefined
    const removed = std.linux.syscall4(SYS_epoll_ctl, @bitCast(usize, loop), 2, @bitCast(usize, descriptor), @intFromPtr(&event))
}

// Waits for events (up to MAX_EVENTS into `events`, EVENT_SIZE bytes
// each); their number, or negative (EINTR among others).
pub fn waitEvents(loop: isize, events: [*]u8, timeout_milliseconds: isize) -> isize {
    return std.linux.syscall4(SYS_epoll_wait, @bitCast(usize, loop), @intFromPtr(events), MAX_EVENTS, @bitCast(usize, timeout_milliseconds))
}

pub fn eventFlags(events: [*]const u8, index: usize) -> u32 {
    const at = index * EVENT_SIZE
    return @intCast(u32, events[at]) | (@intCast(u32, events[at + 1]) << 8) | (@intCast(u32, events[at + 2]) << 16) | (@intCast(u32, events[at + 3]) << 24)
}

pub fn eventToken(events: [*]const u8, index: usize) -> usize {
    const at = index * EVENT_SIZE + 4
    var token: usize = 0
    var offset: usize = 0
    while offset < 8 {
        token |= @intCast(usize, events[at + offset]) << (offset * 8)
        offset += 1
    }
    return token
}
