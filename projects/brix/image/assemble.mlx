// The boot code assembled by mlx-cc's assembler (compiler/cc/asm.mlx:
// AT&T text, top-level assembly) into an image: a text's bytes placed at
// an offset, its relocations resolved against where it will run
// (`origin`: a label's address is origin + its offset) and against the
// kernel's symbols (`externals`: _start, brix_trap, brix_ap).
const std = @import("std")
const base = @import("../../../compiler/cc/base.mlx")
const assembler = @import("../../../compiler/cc/asm.mlx")

pub const External = struct {
    name: []const u8
    address: usize
}

// Why the last `place` failed.
var problemText: []const u8 = undefined // (per run)

pub fn problem() -> []const u8 { return problemText }

// The assembler's memory (once).
pub fn init() -> bool {
    problemText = ""
    return base.init()
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

// `text` assembled into `image` at `at` (at most `limit` bytes), to run
// at `origin`; false (and `problem`) when it does not assemble, does
// not fit, or names a symbol not among `externals`.
pub fn place(image: [*]u8, at: usize, limit: usize, text: []const u8, origin: usize, externals: []const External) -> bool {
    if !assembler.assembleFile(text) {
        problemText = assembler.problem()
        return false
    }
    if assembler.codeLength > limit {
        problemText = "the code does not fit"
        return false
    }
    var k: usize = 0
    while k < assembler.codeLength {
        image[at + k] = base.get8(assembler.code + k)
        k += 1
    }
    var r = assembler.relocations
    while r != 0 {
        const offset = base.getWord(r)
        const kind = base.getWord(r + 8)
        const nameLength = base.getWord(r + 24)
        const addend = base.getWord(r + 32)
        var value = origin + addend
        if nameLength != 0 {
            const name = base.bytes(base.getWord(r + 16), nameLength)
            var found = false
            for external in externals {
                if same(external.name, name) {
                    value = external.address + addend
                    found = true
                }
            }
            if !found {
                problemText = "a symbol the code names is not known"
                return false
            }
        }
        if kind == assembler.R_64 {
            put(image, at + offset, value, 8)
        } else if kind == assembler.R_32 || kind == assembler.R_32S {
            if value >> 32 != 0 && (kind == assembler.R_32 || value >> 31 != 0x1FFFFFFFF) {
                problemText = "an address does not fit 32 bits"
                return false
            }
            put(image, at + offset, value, 4)
        } else if kind == assembler.R_16 {
            if value >> 16 != 0 {
                problemText = "an address does not fit 16 bits"
                return false
            }
            put(image, at + offset, value, 2)
        } else {
            problemText = "a relocation of a kind the boot code cannot have"
            return false
        }
        r = base.getWord(r + 40)
    }
    return true
}

fn put(image: [*]u8, at: usize, value: usize, size: usize) -> void {
    var k: usize = 0
    while k < size {
        image[at + k] = @intCast(u8, (value >> @intCast(u6, 8 * k)) & 255)
        k += 1
    }
}

// The offset of label `name` in the text last placed; null when it has
// none.
pub fn offsetOf(name: []const u8) -> ?usize {
    var s = assembler.fileSymbols
    while s != 0 {
        if same(base.bytes(base.getWord(s), base.getWord(s + 8)), name) { return base.getWord(s + 16) }
        s = base.getWord(s + 48)
    }
    return null
}

// The bytes the text last placed has.
pub fn length() -> usize { return assembler.codeLength }

// An assembly text put together: lines, and `.set NAME, VALUE` lines
// for the layout's numbers.
pub const Text = struct {
    bytes: [*]u8
    length: usize
    capacity: usize

    pub fn init(self: *Self) -> bool {
        self.*.capacity = 65536
        self.*.length = 0
        const memory = std.heap.allocator().alloc(self.*.capacity, 16)
        if memory == null { return false }
        self.*.bytes = memory.?
        return true
    }

    pub fn add(self: *Self, text: []const u8) -> void {
        if self.*.length + text.length > self.*.capacity {
            var bigger = self.*.capacity * 2
            while bigger < self.*.length + text.length { bigger *= 2 }
            const memory = std.heap.allocator().alloc(bigger, 16)
            if memory == null { return }
            var k: usize = 0
            while k < self.*.length {
                memory.?[k] = self.*.bytes[k]
                k += 1
            }
            self.*.bytes = memory.?
            self.*.capacity = bigger
        }
        var k: usize = 0
        while k < text.length {
            self.*.bytes[self.*.length + k] = text[k]
            k += 1
        }
        self.*.length += text.length
    }

    pub fn line(self: *Self, text: []const u8) -> void {
        self.add(text)
        self.add("\n")
    }

    pub fn lines(self: *Self, list: []const []const u8) -> void {
        for text in list { self.line(text) }
    }

    pub fn hex(self: *Self, value: usize) -> void {
        var buffer: [18]u8 = undefined
        buffer[0] = '0'
        buffer[1] = 'x'
        var digits: usize = 1
        while digits < 16 && (value >> @intCast(u6, 4 * digits)) != 0 { digits += 1 }
        var k: usize = 0
        while k < digits {
            const d = (value >> @intCast(u6, 4 * (digits - 1 - k))) & 15
            buffer[2 + k] = if d < 10 { @intCast(u8, 48 + d) } else { @intCast(u8, 87 + d) }
            k += 1
        }
        self.add(buffer[0..2 + digits])
    }

    pub fn decimal(self: *Self, value: usize) -> void {
        var buffer: [20]u8 = undefined
        var n = value
        var count: usize = 0
        while true {
            buffer[19 - count] = @intCast(u8, 48 + n % 10)
            count += 1
            n /= 10
            if n == 0 { break }
        }
        self.add(buffer[20 - count..20])
    }

    // `.set NAME, VALUE`.
    pub fn set(self: *Self, name: []const u8, value: usize) -> void {
        self.add(".set ")
        self.add(name)
        self.add(", ")
        self.hex(value)
        self.add("\n")
    }

    // `.org OFFSET`.
    pub fn org(self: *Self, offset: usize) -> void {
        self.add(".org ")
        self.hex(offset)
        self.add("\n")
    }

    pub fn text(self: *const Self) -> []const u8 { return self.*.bytes[0..self.*.length] }
}
