// A byte assembler for brix-image's blob: bytes written at a position of
// the image, labels, and rel8/rel32 references to labels resolved at the
// end (finish). The instructions are spelled as their bytes where they
// are used (blob.mlx), each with its mnemonic beside it.
pub const MAX_LABELS: usize = 64
pub const MAX_FIXUPS: usize = 512

pub const Asm = struct {
    image: [*]u8
    at: usize
    labels: [MAX_LABELS]usize
    defined: [MAX_LABELS]bool
    fixupAt: [MAX_FIXUPS]usize
    fixupLabel: [MAX_FIXUPS]usize
    fixupWidth: [MAX_FIXUPS]usize
    fixups: usize
    failed: bool
    // The virtual address of image offset 0 (absolute references, width 8).
    origin: usize
}

pub fn put64(image: [*]u8, at: usize, value: usize) -> void {
    var k: usize = 0
    while k < 8 {
        image[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 255)
        k += 1
    }
}

pub fn put32(image: [*]u8, at: usize, value: usize) -> void {
    var k: usize = 0
    while k < 4 {
        image[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 255)
        k += 1
    }
}

pub fn put16(image: [*]u8, at: usize, value: usize) -> void {
    image[at] = @intCast(u8, value & 255)
    image[at + 1] = @intCast(u8, (value >> 8) & 255)
}

pub fn init(a: *Asm, image: [*]u8, at: usize, origin: usize) -> void {
    a.*.image = image
    a.*.at = at
    a.*.origin = origin
    a.*.fixups = 0
    a.*.failed = false
    var k: usize = 0
    while k < MAX_LABELS {
        a.*.defined[k] = false
        k += 1
    }
}

pub fn byte(a: *Asm, value: usize) -> void {
    a.*.image[a.*.at] = @intCast(u8, value & 255)
    a.*.at += 1
}

pub fn bytes2(a: *Asm, b0: usize, b1: usize) -> void {
    byte(a, b0)
    byte(a, b1)
}

pub fn bytes3(a: *Asm, b0: usize, b1: usize, b2: usize) -> void {
    byte(a, b0)
    byte(a, b1)
    byte(a, b2)
}

pub fn bytes4(a: *Asm, b0: usize, b1: usize, b2: usize, b3: usize) -> void {
    byte(a, b0)
    byte(a, b1)
    byte(a, b2)
    byte(a, b3)
}

pub fn imm32(a: *Asm, value: usize) -> void {
    put32(a.*.image, a.*.at, value)
    a.*.at += 4
}

pub fn imm64(a: *Asm, value: usize) -> void {
    put64(a.*.image, a.*.at, value)
    a.*.at += 8
}

pub fn label(a: *Asm, id: usize) -> void { labelAt(a, id, a.*.at) }

// A label at an image offset (data the code refers to).
pub fn labelAt(a: *Asm, id: usize, offset: usize) -> void {
    a.*.labels[id] = offset
    a.*.defined[id] = true
}

// The label's virtual address as an 8-byte immediate.
pub fn absolute(a: *Asm, id: usize) -> void { refAfter(a, id, 8, 0) }

// A reference to `id` as a displacement from the end of the field
// (`width` 1 or 4 bytes) just after it: what jumps, calls and RIP-relative
// operands take. `extra` bytes of the instruction come after the field
// (an immediate after a RIP-relative operand).
pub fn ref(a: *Asm, id: usize, width: usize) -> void { refAfter(a, id, width, 0) }

pub fn refAfter(a: *Asm, id: usize, width: usize, extra: usize) -> void {
    if a.*.fixups == MAX_FIXUPS {
        a.*.failed = true
        return
    }
    a.*.fixupAt[a.*.fixups] = a.*.at
    a.*.fixupLabel[a.*.fixups] = id + (extra << 16)
    a.*.fixupWidth[a.*.fixups] = width
    a.*.fixups += 1
    a.*.at += width
}

// The references resolved; false when one names an undefined label or
// does not reach.
pub fn finish(a: *Asm) -> bool {
    if a.*.failed { return false }
    var k: usize = 0
    while k < a.*.fixups {
        const id = a.*.fixupLabel[k] & 0xffff
        const extra = a.*.fixupLabel[k] >> 16
        if !a.*.defined[id] { return false }
        const width = a.*.fixupWidth[k]
        if width == 8 {
            put64(a.*.image, a.*.fixupAt[k], a.*.origin + a.*.labels[id])
            k += 1
            continue
        }
        const from = a.*.fixupAt[k] + width + extra
        const to = a.*.labels[id]
        const displacement = @bitCast(isize, to) - @bitCast(isize, from)
        if width == 1 {
            if displacement < -128 || displacement > 127 { return false }
            a.*.image[a.*.fixupAt[k]] = @intCast(u8, @bitCast(usize, displacement) & 255)
        } else {
            put32(a.*.image, a.*.fixupAt[k], @bitCast(usize, displacement) & 0xffffffff)
        }
        k += 1
    }
    return true
}
