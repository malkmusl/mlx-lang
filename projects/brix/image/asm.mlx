// A byte assembler for brix-image's blob: bytes written at a position of
// the image, labels, and rel8/rel32 references to labels resolved at the
// end (finish). The instructions are spelled as their bytes where they
// are used (blob.mlx), each with its mnemonic beside it.
pub const Asm = struct {
    pub const MAX_LABELS: usize = 64
    pub const MAX_FIXUPS: usize = 512

    image: [*]u8
    at: usize
    labels: [MAX_LABELS]usize
    defined: [MAX_LABELS]bool
    fixupAt: [MAX_FIXUPS]usize
    fixupLabel: [MAX_FIXUPS]usize
    fixupWidth: [MAX_FIXUPS]usize
    fixups: usize
    failed: bool
    // The virtual address of image offset 0 (absolute references, width 8).
    origin: usize

    // Little-endian values into a byte array.
    pub fn put64(image: [*]u8, at: usize, value: usize) -> void {
        var k: usize = 0
        while k < 8 {
            image[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 255)
            k += 1
        }
    }

    pub fn put32(image: [*]u8, at: usize, value: usize) -> void {
        var k: usize = 0
        while k < 4 {
            image[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 255)
            k += 1
        }
    }

    pub fn put16(image: [*]u8, at: usize, value: usize) -> void {
        image[at] = @intCast(u8, value & 255)
        image[at + 1] = @intCast(u8, (value >> 8) & 255)
    }

    pub fn init(self: *Self, image: [*]u8, at: usize, origin: usize) -> void {
        self.*.image = image
        self.*.at = at
        self.*.origin = origin
        self.*.fixups = 0
        self.*.failed = false
        var k: usize = 0
        while k < MAX_LABELS {
            self.*.defined[k] = false
            k += 1
        }
    }

    pub fn byte(self: *Self, value: usize) -> void {
        self.*.image[self.*.at] = @intCast(u8, value & 255)
        self.*.at += 1
    }

    pub fn bytes2(self: *Self, b0: usize, b1: usize) -> void {
        self.byte(b0)
        self.byte(b1)
    }

    pub fn bytes3(self: *Self, b0: usize, b1: usize, b2: usize) -> void {
        self.byte(b0)
        self.byte(b1)
        self.byte(b2)
    }

    pub fn bytes4(self: *Self, b0: usize, b1: usize, b2: usize, b3: usize) -> void {
        self.byte(b0)
        self.byte(b1)
        self.byte(b2)
        self.byte(b3)
    }

    pub fn imm32(self: *Self, value: usize) -> void {
        put32(self.*.image, self.*.at, value)
        self.*.at += 4
    }

    pub fn imm64(self: *Self, value: usize) -> void {
        put64(self.*.image, self.*.at, value)
        self.*.at += 8
    }

    pub fn label(self: *Self, id: usize) -> void { self.labelAt(id, self.*.at) }

    // A label at an image offset (data the code refers to).
    pub fn labelAt(self: *Self, id: usize, offset: usize) -> void {
        self.*.labels[id] = offset
        self.*.defined[id] = true
    }

    // The label's virtual address as an 8-byte immediate.
    pub fn absolute(self: *Self, id: usize) -> void { self.refAfter(id, 8, 0) }

    // A reference to `id` as a displacement from the end of the field
    // (`width` 1 or 4 bytes) just after it: what jumps, calls and
    // RIP-relative operands take. `extra` bytes of the instruction come
    // after the field (an immediate after a RIP-relative operand).
    pub fn ref(self: *Self, id: usize, width: usize) -> void { self.refAfter(id, width, 0) }

    pub fn refAfter(self: *Self, id: usize, width: usize, extra: usize) -> void {
        if self.*.fixups == MAX_FIXUPS {
            self.*.failed = true
            return
        }
        self.*.fixupAt[self.*.fixups] = self.*.at
        self.*.fixupLabel[self.*.fixups] = id + (extra << 16)
        self.*.fixupWidth[self.*.fixups] = width
        self.*.fixups += 1
        self.*.at += width
    }

    // The references resolved; false when one names an undefined label or
    // does not reach.
    pub fn finish(self: *Self) -> bool {
        if self.*.failed { return false }
        var k: usize = 0
        while k < self.*.fixups {
            const id = self.*.fixupLabel[k] & 0xffff
            const extra = self.*.fixupLabel[k] >> 16
            if !self.*.defined[id] { return false }
            const width = self.*.fixupWidth[k]
            if width == 8 {
                put64(self.*.image, self.*.fixupAt[k], self.*.origin + self.*.labels[id])
                k += 1
                continue
            }
            const from = self.*.fixupAt[k] + width + extra
            const to = self.*.labels[id]
            const displacement = @bitCast(isize, to) - @bitCast(isize, from)
            if width == 1 {
                if displacement < -128 || displacement > 127 { return false }
                self.*.image[self.*.fixupAt[k]] = @intCast(u8, @bitCast(usize, displacement) & 255)
            } else {
                put32(self.*.image, self.*.fixupAt[k], @bitCast(usize, displacement) & 0xffffffff)
            }
            k += 1
        }
        return true
    }
}
