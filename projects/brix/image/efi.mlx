// brix-image's EFI application (OUT ending in .efi): the Multiboot image
// in a PE32+ file that a UEFI firmware starts (EFI/BOOT/BOOTX64.EFI), and
// a loader in front of it that does what a Multiboot loader does:
//
// - efiMain (64-bit, the firmware's calls by Microsoft's convention): the
//   display (LocateProtocol: the Graphics Output Protocol; the monitor's
//   own mode set when its EDID names one the firmware has and is not in,
//   or the mode the image was built for; then the mode's framebuffer
//   into the payload's boot info), the memory map (GetMemoryMap), from it the end of the memory below 4 GiB
//   the kernel may use (mem_upper), the boot services left
//   (ExitBootServices, again with a new map when it changed), a GDT of
//   its own (a 32-bit code and a data segment), a far return to code32.
// - code32: paging and long mode off, the image copied to where Multiboot
//   would have loaded it (BLOB_PHYS), the Multiboot information (memory)
//   at MBI, then the blob's entry as a Multiboot loader enters it (EAX
//   the magic, EBX the information).
//
// The code is position-independent (the firmware loads the file where it
// likes, below 4 GiB): its references are RIP-relative; everything is in
// one section. It is AT&T assembly (mlx-cc's assembler, assemble.mlx).
const std = @import("std")
const layout = @import("../layout.mlx")
const assemble = @import("./assemble.mlx")
const Bytes = @import("./bytes.mlx").Bytes

const HEADERS: usize = 0x200
const SECTION_RVA: usize = 0x1000
const MEMMAP_SIZE: usize = 32768
// Where the Multiboot information goes (below 1 MiB, nothing else there).
const MBI: usize = 0x9000
// Where the Multiboot memory map goes (just past the MBI, which is small):
// an entry per usable UEFI range (size 20, base, length, type 1: RAM),
// so EFI boots see all of RAM, not only what is below the memory hole.
const MMAP_PHYS: usize = 0x9100
const MMAP_MAX: usize = 200
// Where the memory map and the image are in the section (after the code
// and its data, which this is room for: they are past 0x800 bytes). Code
// that outgrows it stops brix-image (".org goes back: MEMMAP_AT").
const MEMMAP_AT: usize = 0x1000

fn up(value: usize, to: usize) -> usize { return (value + to - 1) & ~(to - 1) }

const CODE = [_][]const u8{
    // ---- efiMain(image handle: rcx, system table: rdx) ----
    "pushq %rbx",
    "pushq %rsi",
    "pushq %rdi",
    "pushq %rbp",
    "subq $0x48, %rsp", // (aligned; shadow space, a fifth argument)
    "movq %rcx, image_handle(%rip)",
    "movq %rdx, system_table(%rip)",
    "movq 96(%rdx), %rbx", // the boot services
    // The ACPI tables' root (the RSDP): a UEFI firmware names it in its
    // configuration table (entries of a GUID and a pointer: the ACPI 2.0
    // one, else the 1.0 one), not in the BIOS area; into the payload's
    // boot info for the kernel (smp.mlx finds the processors by it).
    "movq 104(%rdx), %rcx", // NumberOfTableEntries
    "movq 112(%rdx), %rsi", // ConfigurationTable
    "leaq payload(%rip), %rdi",
    "acpi:",
    "testq %rcx, %rcx",
    "jz acpidone",
    "movq (%rsi), %rax",
    "movq 8(%rsi), %rdx",
    "movabs $0x11d3e4f18868e871, %r8", // 8868e871-e4f1-11d3-bc22-0080c73c8881
    "cmpq %r8, %rax",
    "jne acpiold",
    "movabs $0x81883cc7800022bc, %r8",
    "cmpq %r8, %rdx",
    "jne acpinext",
    "movq 16(%rsi), %rax",
    "movq %rax, RSDP(%rdi)",
    "jmp acpidone", // (the 2.0 one is the one to use)
    "acpiold:",
    "movabs $0x11d32d88eb9d2d30, %r8", // eb9d2d30-2d88-11d3-9a16-0090273fc14d
    "cmpq %r8, %rax",
    "jne acpinext",
    "movabs $0x4dc13f279000169a, %r8",
    "cmpq %r8, %rdx",
    "jne acpinext",
    "movq 16(%rsi), %rax",
    "movq %rax, RSDP(%rdi)",
    "acpinext:",
    "addq $24, %rsi",
    "subq $1, %rcx",
    "jmp acpi",
    "acpidone:",
    // The display (the Graphics Output Protocol's mode: its framebuffer,
    // 32-bit pixels, blue first (1) or red first (2)) into the payload's
    // boot info; none when the firmware has none the kernel can use.
    "leaq gop_guid(%rip), %rcx",
    "xorq %rdx, %rdx",
    "leaq gop(%rip), %r8",
    "call *320(%rbx)", // LocateProtocol
    "testq %rax, %rax",
    "jnz nogop",
    // The mode the firmware left is whatever its setup screen liked,
    // often not the monitor's own (a picture the monitor stretches, the
    // wrong shape). First what it is, for the kernel to say.
    "leaq payload(%rip), %rdi",
    "movq gop(%rip), %rax",
    "movq 24(%rax), %rax", // Mode
    "testq %rax, %rax",
    "jz nogop",
    "movq 8(%rax), %rax", // Info
    "movl 4(%rax), %ecx",
    "movq %rcx, FIRMWARE_WIDTH(%rdi)",
    "movl 8(%rax), %ecx",
    "movq %rcx, FIRMWARE_HEIGHT(%rdi)",
    // Then what the monitor says of itself: its EDID, whose first
    // detailed timing is the mode it prefers. The monitor of THIS
    // display: the EDID Active protocol on a handle whose Graphics Output
    // Protocol is the one in use, or shows the same picture's memory (the
    // console's own output stands in front of a card's, and the EDID is
    // on the card's output). Another display's does not count: a server
    // board's management controller has one of its own. The firmware's
    // graphics outputs are counted for the kernel to say.
    "movl $2, %ecx", // ByProtocol
    "leaq gop_guid(%rip), %rdx",
    "xorq %r8, %r8",
    "leaq handle_count(%rip), %r9",
    "leaq handles(%rip), %rax",
    "movq %rax, 32(%rsp)",
    "call *312(%rbx)", // LocateHandleBuffer
    "testq %rax, %rax",
    "jnz noedid",
    "movq handle_count(%rip), %rax",
    "movq %rax, DISPLAYS(%rdi)",
    "shlq $3, %rax",
    "movq handles(%rip), %rsi",
    "movq %rsi, handle_at(%rip)",
    "addq %rsi, %rax",
    "movq %rax, handles_end(%rip)",
    "nexthandle:",
    "movq handle_at(%rip), %rsi",
    "movq handles_end(%rip), %rax",
    "cmpq %rax, %rsi",
    "jae noedid",
    "movq (%rsi), %rcx", // the handle
    "leaq gop_guid(%rip), %rdx",
    "leaq probe(%rip), %r8",
    "call *152(%rbx)", // HandleProtocol
    "testq %rax, %rax",
    "jnz otherhandle",
    "movq probe(%rip), %rax",
    "movq gop(%rip), %rcx",
    "cmpq %rcx, %rax",
    "je ourhandle",
    "movq 24(%rax), %rax", // its Mode
    "testq %rax, %rax",
    "jz otherhandle",
    "movq 24(%rax), %rax", // its FrameBufferBase
    "testq %rax, %rax",
    "jz otherhandle",
    "movq 24(%rcx), %rcx", // ours
    "testq %rcx, %rcx",
    "jz otherhandle",
    "movq 24(%rcx), %rcx",
    "cmpq %rcx, %rax",
    "jne otherhandle",
    "ourhandle:",
    "movq (%rsi), %rcx",
    "leaq edid_guid(%rip), %rdx",
    "leaq edid(%rip), %r8",
    "call *152(%rbx)", // HandleProtocol
    "testq %rax, %rax",
    "jnz otherhandle",
    "movq edid(%rip), %rax",
    "testq %rax, %rax",
    "jz otherhandle",
    "cmpl $128, (%rax)", // SizeOfEdid
    "jb otherhandle",
    "movq 8(%rax), %rsi", // Edid
    "testq %rsi, %rsi",
    "jz otherhandle",
    "movzwl 54(%rsi), %eax", // (a pixel clock of 0: no timing there)
    "testl %eax, %eax",
    "jz otherhandle",
    "movzbl 56(%rsi), %eax", // horizontal active: 8 bits, and 4 more
    "movzbl 58(%rsi), %ecx", // in the high half of the byte after next
    "andl $0xF0, %ecx",
    "shll $4, %ecx",
    "orl %ecx, %eax",
    "movzbl 59(%rsi), %edx", // vertical active, the same way
    "movzbl 61(%rsi), %ecx",
    "andl $0xF0, %ecx",
    "shll $4, %ecx",
    "orl %ecx, %edx",
    // (An interlaced timing counts the lines of one field: the picture
    // has twice as many, and the screen's shape is the picture's.)
    "movzbl 71(%rsi), %ecx",
    "andl $0x80, %ecx",
    "jz progressive",
    "shll $1, %edx",
    "progressive:",
    "movq %rax, MONITOR_WIDTH(%rdi)",
    "movq %rdx, MONITOR_HEIGHT(%rdi)",
    "jmp noedid",
    "otherhandle:",
    "addq $8, handle_at(%rip)",
    "jmp nexthandle",
    "noedid:",
    // The mode wanted: the one the image was built for (DISPLAY_WIDTH by
    // DISPLAY_HEIGHT; DISPLAY_WIDTH all ones: the firmware's stays, come
    // what may), else the monitor's own; neither: none.
    "movq $0, mode_by(%rip)",
    "movq $DISPLAY_WIDTH, %rax",
    "movq $DISPLAY_HEIGHT, %rdx",
    "cmpq $-1, %rax",
    "je nowant",
    "movq $2, mode_by(%rip)", // (the image's)
    "testq %rax, %rax",
    "jnz wanted",
    "movq $1, mode_by(%rip)", // (the monitor's)
    "movq MONITOR_WIDTH(%rdi), %rax",
    "movq MONITOR_HEIGHT(%rdi), %rdx",
    "jmp wanted",
    "nowant:",
    "xorq %rax, %rax",
    "xorq %rdx, %rdx",
    "wanted:",
    "movq %rax, want_width(%rip)",
    "movq %rdx, want_height(%rip)",
    "movq %rax, WANTED_WIDTH(%rdi)", // (for the kernel: the screen's shape)
    "movq %rdx, WANTED_HEIGHT(%rdi)",
    // The firmware's modes (QueryMode, 0 to MaxMode - 1) with pixels the
    // kernel can use: each into the boot info for the kernel to say (the
    // first MODE_ROOM), and among them the one of the size wanted, and
    // of those no wider and no higher than it the one that shows most of
    // a picture of the wanted shape: the larger of width times the wanted
    // height and height times the wanted width is what a mode has too
    // much of, the smaller what counts; of two that count alike the one
    // with fewer pixels is stretched less (1280x960 before 1280x1024 on
    // a monitor of 3840x1080).
    "movq $-1, exact_index(%rip)",
    "movq $-1, best_index(%rip)",
    "movq $0, best_key(%rip)",
    "movq $0, best_pixels(%rip)",
    "movq $0, mode_index(%rip)",
    "nextmode:",
    "movq gop(%rip), %rcx",
    "movq 24(%rcx), %rax",
    "movl (%rax), %eax", // MaxMode
    "cmpq %rax, mode_index(%rip)",
    "jae modesdone",
    "movq mode_index(%rip), %rdx",
    "leaq info_size(%rip), %r8",
    "leaq info(%rip), %r9",
    "call *(%rcx)", // QueryMode(gop, number, &size, &info)
    "testq %rax, %rax",
    "jnz skipmode",
    "movq info(%rip), %rcx",
    "cmpl $1, 12(%rcx)", // PixelFormat
    "ja skipmode",
    "movl 4(%rcx), %eax", // its width
    "movl 8(%rcx), %edx", // and height
    "movq MODES(%rdi), %r8",
    "cmpq $MODE_ROOM, %r8",
    "jae listed",
    "movq %rax, %r9",
    "shlq $32, %r9",
    "orq %rdx, %r9",
    "shlq $3, %r8",
    "leaq MODE_LIST(%rdi), %rcx",
    "addq %r8, %rcx",
    "movq %r9, (%rcx)",
    "addq $1, MODES(%rdi)",
    "listed:",
    "movq want_width(%rip), %r8",
    "movq want_height(%rip), %r9",
    "cmpq %r8, %rax",
    "jne fits",
    "cmpq %r9, %rdx",
    "jne fits",
    "movq mode_index(%rip), %rcx",
    "movq %rcx, exact_index(%rip)",
    "fits:",
    "cmpq %r8, %rax",
    "ja skipmode",
    "cmpq %r9, %rdx",
    "ja skipmode",
    "movq %rax, %rcx",
    "imulq %r9, %rcx", // its width times the wanted height
    "imulq %rdx, %r8", // its height times the wanted width
    "cmpq %r8, %rcx",
    "jbe keyed",
    "movq %r8, %rcx",
    "keyed:",
    "imulq %rdx, %rax", // its pixels
    "movq best_key(%rip), %r8",
    "cmpq %r8, %rcx",
    "jb skipmode",
    "ja better",
    "movq best_pixels(%rip), %r8",
    "cmpq %r8, %rax",
    "jae skipmode",
    "better:",
    "movq %rcx, best_key(%rip)",
    "movq %rax, best_pixels(%rip)",
    "movq mode_index(%rip), %rcx",
    "movq %rcx, best_index(%rip)",
    "skipmode:",
    "addq $1, mode_index(%rip)",
    "jmp nextmode",
    "modesdone:",
    // The mode set: the one wanted when the firmware has it (on the
    // monitor's word not a picture of fewer pixels than the firmware's:
    // that only when the image names it); when it has not, the nearest
    // to it found above, if that shows more of the wanted shape than the
    // firmware's own mode does. Else, and when the firmware refuses, its
    // mode stays.
    "movq want_width(%rip), %rax",
    "testq %rax, %rax",
    "jz modeset",
    "movq want_height(%rip), %rdx",
    "testq %rdx, %rdx",
    "jz modeset",
    "movq FIRMWARE_WIDTH(%rdi), %r8",
    "movq FIRMWARE_HEIGHT(%rdi), %r9",
    "movq exact_index(%rip), %rcx",
    "cmpq $-1, %rcx",
    "je nearest",
    "cmpq %r8, %rax", // (the mode it is in already?)
    "jne notyet",
    "cmpq %r9, %rdx",
    "je modeset",
    "notyet:",
    "imulq %rdx, %rax", // the pixels wanted
    "imulq %r9, %r8", // the firmware's
    "cmpq $1, mode_by(%rip)",
    "jne setexact",
    "cmpq %r8, %rax",
    "jb modeset",
    "setexact:",
    "movq exact_index(%rip), %rdx",
    "jmp setmode",
    "nearest:",
    "movq best_index(%rip), %rdx",
    "cmpq $-1, %rdx",
    "je modeset",
    "movq want_height(%rip), %rax",
    "imulq %rax, %r8", // the firmware's width times the wanted height
    "movq want_width(%rip), %rax",
    "imulq %rax, %r9", // its height times the wanted width
    "cmpq %r9, %r8",
    "jbe ownkeyed",
    "movq %r9, %r8",
    "ownkeyed:",
    "movq best_key(%rip), %rax",
    "cmpq %r8, %rax",
    "jbe modeset",
    "addq $2, mode_by(%rip)", // (the nearest to the monitor's, the image's)
    "setmode:",
    "movq gop(%rip), %rcx",
    "call *8(%rcx)", // SetMode(gop, number)
    "leaq payload(%rip), %rdi",
    "testq %rax, %rax",
    "jz didset",
    "movq %rax, MODE_REFUSED(%rdi)",
    "jmp modeset",
    "didset:",
    "movq mode_by(%rip), %rax",
    "movq %rax, MODE_BY(%rdi)",
    "modeset:",
    "movq gop(%rip), %rax",
    "movq 24(%rax), %rax", // Mode
    "testq %rax, %rax",
    "jz nogop",
    "movq 8(%rax), %rdx", // Info
    "cmpl $1, 12(%rdx)", // PixelFormat: 0 RGBX, 1 BGRX (others: no pixels)
    "ja nogop",
    "movq 24(%rax), %rcx", // FrameBufferBase
    "testq %rcx, %rcx",
    "jz nogop",
    "leaq payload(%rip), %rdi",
    "movq %rcx, FB_ADDRESS(%rdi)",
    "movl 4(%rdx), %eax", // HorizontalResolution
    "movq %rax, FB_WIDTH(%rdi)",
    "movl 8(%rdx), %eax", // VerticalResolution
    "movq %rax, FB_HEIGHT(%rdi)",
    "movl 32(%rdx), %eax", // PixelsPerScanLine
    "shll $2, %eax",
    "movq %rax, FB_PITCH(%rdi)",
    "movl $2, %eax",
    "subl 12(%rdx), %eax",
    "movq %rax, FB_FORMAT(%rdi)",
    "nogop:",
    "retry:",
    "movq $MEMMAP_SIZE, map_size(%rip)",
    "leaq map_size(%rip), %rcx",
    "leaq memmap(%rip), %rdx",
    "leaq map_key(%rip), %r8",
    "leaq descriptor_size(%rip), %r9",
    "leaq descriptor_version(%rip), %rax",
    "movq %rax, 32(%rsp)",
    "call *56(%rbx)", // GetMemoryMap
    "testq %rax, %rax",
    "jnz fail",
    // The highest end of the usable memory below 4 GiB.
    "leaq memmap(%rip), %rsi",
    "movq map_size(%rip), %rcx",
    "xorq %rdi, %rdi",
    "movq $MMAP_PHYS, %r10", // where the next Multiboot mmap entry goes
    "xorq %r11, %r11", // how many there are
    "loop:",
    "movl (%rsi), %eax", // the type
    "cmpl $7, %eax", // conventional
    "je usable",
    "testl %eax, %eax", // reserved
    "jz next",
    "cmpl $4, %eax", // the loader's, the boot services'
    "ja next",
    "usable:",
    // A Multiboot mmap entry (size 20, base, length, type 1), while there
    // is room; the kernel reads these (memory.mlx readMap).
    "cmpq $MMAP_MAX, %r11",
    "jae skipentry",
    "movl $20, (%r10)",
    "movq 8(%rsi), %rax", // PhysicalStart
    "movq %rax, 4(%r10)",
    "movq 24(%rsi), %rax", // NumberOfPages
    "shlq $12, %rax",
    "movq %rax, 12(%r10)",
    "movl $1, 20(%r10)",
    "addq $24, %r10",
    "incq %r11",
    "skipentry:",
    "movq 24(%rsi), %rax", // pages
    "shlq $12, %rax",
    "addq 8(%rsi), %rax", // its start
    "movabs $0x100000000, %rdx", // 4 GiB
    "cmpq %rdx, %rax",
    "ja next",
    "cmpq %rdi, %rax",
    "jbe next",
    "movq %rax, %rdi",
    "next:",
    "addq descriptor_size(%rip), %rsi",
    "subq descriptor_size(%rip), %rcx",
    "ja loop",
    "subq $0x100000, %rdi", // 1 MiB
    "shrq $10, %rdi", // KiB
    "movq %rdi, mem_upper(%rip)",
    // The memory map's length in bytes (24 per entry), kept for code32.
    "movq %r11, %rax",
    "imulq $24, %rax",
    "movq %rax, mmap_length(%rip)",
    // The boot services left (a new map when this one is old).
    "movq image_handle(%rip), %rcx",
    "movq map_key(%rip), %rdx",
    "call *232(%rbx)", // ExitBootServices
    "testq %rax, %rax",
    "jnz retry",
    // The firmware's no more: our GDT, then 32-bit code.
    "cli",
    "leaq gdt(%rip), %rax",
    "movq %rax, gdtr_base(%rip)",
    "lgdt gdtr(%rip)",
    "leaq payload(%rip), %rsi",
    "movl $PAYLOAD_SIZE, %ecx",
    "movq mem_upper(%rip), %rdx",
    "movq mmap_length(%rip), %rdi", // code32: MBI + 44
    "leaq code32(%rip), %rax",
    "pushq $0x08", // the 32-bit code segment
    "pushq %rax",
    "lretq",
    "fail:",
    "addq $0x48, %rsp",
    "popq %rbp",
    "popq %rdi",
    "popq %rsi",
    "popq %rbx",
    "ret", // (the error to the firmware)
    // ---- code32 (esi: the image, ecx: its size, edx: mem_upper) ----
    ".code32",
    "code32:",
    "movw $0x10, %ax",
    "movw %ax, %ds",
    "movw %ax, %es",
    "movw %ax, %ss",
    "movl %cr0, %eax",
    "andl $0x7FFFFFFF, %eax", // ~PG
    "movl %eax, %cr0", // (paging off: out of long mode)
    "movl %ecx, %ebp",
    "movl %edx, %ebx",
    "movl $0xC0000080, %ecx", // EFER
    "rdmsr",
    "andl $0xFFFFFEFF, %eax", // ~LME
    "wrmsr",
    "movl $0x41, MBI", // flags: memory (1) and the memory map (0x40)
    "movl $640, MBI + 4", // mem_lower
    "movl %ebx, MBI + 8", // mem_upper
    "movl %edi, MBI + 44", // mmap_length (before edi is the copy's target)
    "movl $MMAP_PHYS, MBI + 48", // mmap_addr
    "movl $BLOB, %edi",
    "movl %ebp, %ecx",
    "cld",
    "rep movsb",
    "movl $0x2BADB002, %eax", // Multiboot's magic
    "movl $MBI, %ebx",
    "movl $BLOB_ENTRY, %ecx", // the blob's entry
    "jmp *%ecx",
    // ---- data ----
    ".balign 16, 0",
    "gdt:",
    ".quad 0",
    ".quad 0x00CF9A000000FFFF",
    ".quad 0x00CF92000000FFFF",
    ".balign 16, 0",
    ".skip 6",
    "gdtr:",
    ".word 23",
    "gdtr_base:",
    ".quad 0",
    ".balign 8, 0",
    "image_handle: .quad 0",
    "system_table: .quad 0",
    "map_size: .quad 0",
    "map_key: .quad 0",
    "descriptor_size: .quad 0",
    "descriptor_version: .quad 0",
    "mem_upper: .quad 0",
    "mmap_length: .quad 0",
    "gop: .quad 0",
    "edid: .quad 0",
    "handles: .quad 0",
    "handle_count: .quad 0",
    "handle_at: .quad 0",
    "handles_end: .quad 0",
    "probe: .quad 0",
    "mode_by: .quad 0",
    "exact_index: .quad 0",
    "best_index: .quad 0",
    "best_key: .quad 0",
    "best_pixels: .quad 0",
    "want_width: .quad 0",
    "want_height: .quad 0",
    "mode_index: .quad 0",
    "info_size: .quad 0",
    "info: .quad 0",
    "edid_guid:", // EFI_EDID_ACTIVE_PROTOCOL_GUID (bd8c1056-9f36-44ec-92a8-a6337f817986)
    ".long 0xbd8c1056",
    ".word 0x9f36",
    ".word 0x44ec",
    ".byte 0x92",
    ".byte 0xa8",
    ".byte 0xa6",
    ".byte 0x33",
    ".byte 0x7f",
    ".byte 0x81",
    ".byte 0x79",
    ".byte 0x86",
    "gop_guid:", // EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID
    ".long 0x9042a9de",
    ".word 0x23dc",
    ".word 0x4a38",
    ".byte 0x96",
    ".byte 0xfb",
    ".byte 0x7a",
    ".byte 0xde",
    ".byte 0xd0",
    ".byte 0x80",
    ".byte 0x51",
    ".byte 0x6a",
    ".org MEMMAP_AT",
    "memmap:",
    ".org MEMMAP_AT + MEMMAP_SIZE",
    "payload:"
}

// The display mode an image may be built for instead of the monitor's own:
// none (the monitor's, when it says one and the firmware has it), or the
// firmware's whatever it is.
pub const DISPLAY_MONITOR: usize = 0
pub const DISPLAY_FIRMWARE: usize = 0xFFFFFFFFFFFFFFFF

// The PE32+ file of the Multiboot image `payload` (`size` bytes, loaded at
// BLOB_PHYS, entered at its code32): its bytes and their count, or null.
// The loader sets the display mode `displayWidth` by `displayHeight` when
// the firmware has it (DISPLAY_MONITOR: the monitor's own; DISPLAY_FIRMWARE:
// none, the firmware's stays).
pub fn build(payload: [*]const u8, size: usize, total: *usize, displayWidth: usize, displayHeight: usize) -> ?[*]u8 {
    // The section: code, data, the memory map's room, the image.
    const payloadAt: usize = MEMMAP_AT + MEMMAP_SIZE
    const sectionSize = up(payloadAt + size, 0x200)
    const fileSize = HEADERS + sectionSize
    const memory = std.heap.allocator().alloc(fileSize, 4096)
    if memory == null { return null }
    const file = memory.?
    var k: usize = 0
    while k < fileSize {
        file[k] = 0
        k += 1
    }
    // The headers: DOS (MZ, the PE header's place), PE, COFF, the
    // optional header (PE32+), one section.
    file[0] = 77
    file[1] = 90
    Bytes.put32(file, 0x3C, 0x40)
    Bytes.put32(file, 0x40, 0x4550)
    Bytes.put16(file, 0x44, 0x8664)
    Bytes.put16(file, 0x46, 1)
    Bytes.put16(file, 0x54, 240)
    Bytes.put16(file, 0x56, 0x22)
    const optional: usize = 0x58
    Bytes.put16(file, optional, 0x20B)
    Bytes.put32(file, optional + 4, sectionSize)
    Bytes.put32(file, optional + 16, SECTION_RVA)
    Bytes.put32(file, optional + 20, SECTION_RVA)
    Bytes.put64(file, optional + 24, 0x10000000)
    Bytes.put32(file, optional + 32, 0x1000)
    Bytes.put32(file, optional + 36, 0x200)
    Bytes.put32(file, optional + 56, up(SECTION_RVA + sectionSize, 0x1000))
    Bytes.put32(file, optional + 60, HEADERS)
    Bytes.put16(file, optional + 68, 10)
    Bytes.put64(file, optional + 72, 0x10000)
    Bytes.put64(file, optional + 80, 0x10000)
    Bytes.put32(file, optional + 108, 16)
    const section: usize = optional + 240
    file[section] = 46
    file[section + 1] = 116
    file[section + 2] = 101
    file[section + 3] = 120
    file[section + 4] = 116
    Bytes.put32(file, section + 8, sectionSize)
    Bytes.put32(file, section + 12, SECTION_RVA)
    Bytes.put32(file, section + 16, sectionSize)
    Bytes.put32(file, section + 20, HEADERS)
    Bytes.put32(file, section + 36, 0xE0000060)

    // The section's code and data (relative references only: assembled
    // at 0).
    var t: assemble.Text = undefined
    if !t.init() { return null }
    t.set("MEMMAP_SIZE", MEMMAP_SIZE)
    t.set("MEMMAP_AT", MEMMAP_AT)
    t.set("PAYLOAD_SIZE", size)
    t.set("MBI", MBI)
    t.set("MMAP_PHYS", MMAP_PHYS)
    t.set("MMAP_MAX", MMAP_MAX)
    t.set("BLOB", layout.Memory.BLOB)
    t.set("BLOB_ENTRY", layout.Memory.BLOB + layout.Blob.CODE32)
    t.set("FB_ADDRESS", layout.Blob.BOOT_INFO + layout.Info.FB_ADDRESS)
    t.set("FB_WIDTH", layout.Blob.BOOT_INFO + layout.Info.FB_WIDTH)
    t.set("FB_HEIGHT", layout.Blob.BOOT_INFO + layout.Info.FB_HEIGHT)
    t.set("FB_PITCH", layout.Blob.BOOT_INFO + layout.Info.FB_PITCH)
    t.set("FB_FORMAT", layout.Blob.BOOT_INFO + layout.Info.FB_FORMAT)
    t.set("RSDP", layout.Blob.BOOT_INFO + layout.Info.RSDP)
    t.set("MONITOR_WIDTH", layout.Blob.BOOT_INFO + layout.Info.MONITOR_WIDTH)
    t.set("MONITOR_HEIGHT", layout.Blob.BOOT_INFO + layout.Info.MONITOR_HEIGHT)
    t.set("FIRMWARE_WIDTH", layout.Blob.BOOT_INFO + layout.Info.FIRMWARE_WIDTH)
    t.set("FIRMWARE_HEIGHT", layout.Blob.BOOT_INFO + layout.Info.FIRMWARE_HEIGHT)
    t.set("MODE_BY", layout.Blob.BOOT_INFO + layout.Info.MODE_BY)
    t.set("DISPLAYS", layout.Blob.BOOT_INFO + layout.Info.DISPLAYS)
    t.set("MODES", layout.Blob.BOOT_INFO + layout.Info.MODES)
    t.set("MODE_LIST", layout.Blob.BOOT_INFO + layout.Info.MODE_LIST)
    t.set("MODE_ROOM", layout.Info.MODE_ROOM)
    t.set("MODE_REFUSED", layout.Blob.BOOT_INFO + layout.Info.MODE_REFUSED)
    t.set("WANTED_WIDTH", layout.Blob.BOOT_INFO + layout.Info.WANTED_WIDTH)
    t.set("WANTED_HEIGHT", layout.Blob.BOOT_INFO + layout.Info.WANTED_HEIGHT)
    t.set("DISPLAY_WIDTH", displayWidth)
    t.set("DISPLAY_HEIGHT", displayHeight)
    t.lines(CODE[0..CODE.length])
    const none = [_]assemble.External{}
    if !assemble.place(file, HEADERS, payloadAt, t.text(), 0, none[0..none.length]) { return null }
    k = 0
    while k < size {
        file[HEADERS + payloadAt + k] = payload[k]
        k += 1
    }
    total.* = fileSize
    return file
}
