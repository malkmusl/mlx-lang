// brix-image's EFI application (OUT ending in .efi): the Multiboot image
// in a PE32+ file that a UEFI firmware starts (EFI/BOOT/BOOTX64.EFI), and
// a loader in front of it that does what a Multiboot loader does:
//
// - efiMain (64-bit, the firmware's calls by Microsoft's convention): the
//   memory map (GetMemoryMap), from it the end of the memory below 4 GiB
//   the kernel may use (mem_upper), the boot services left
//   (ExitBootServices, again with a new map when it changed), a GDT of
//   its own (a 32-bit code and a data segment), a far return to code32.
// - code32: paging and long mode off, the image copied to where Multiboot
//   would have loaded it (BLOB_PHYS), the Multiboot information (memory)
//   at MBI, then the blob's entry as a Multiboot loader enters it (EAX
//   the magic, EBX the information).
//
// The code is position-independent (the firmware loads the file where it
// likes, below 4 GiB); everything is in one section.
const std = @import("std")
const layout = @import("../layout.mlx")
const Asm = @import("./asm.mlx").Asm

const Label = struct {
    const RETRY: usize = 0
    const LOOP: usize = 1
    const USABLE: usize = 2
    const NEXT: usize = 3
    const DONE: usize = 4
    const FAIL: usize = 5
    const CODE32: usize = 6
    const GDT: usize = 7
    const GDTR: usize = 8
    const GDTR_BASE: usize = 9
    const IMAGE_HANDLE: usize = 10
    const SYSTEM_TABLE: usize = 11
    const MAP_SIZE: usize = 12
    const MAP_KEY: usize = 13
    const DESC_SIZE: usize = 14
    const DESC_VERSION: usize = 15
    const MEM_UPPER: usize = 16
    const MEMMAP: usize = 17
    const PAYLOAD: usize = 18
}

const HEADERS: usize = 0x200
const SECTION_RVA: usize = 0x1000
const MEMMAP_SIZE: usize = 32768
// Where the Multiboot information goes (below 1 MiB, nothing else there).
const MBI: usize = 0x9000

fn up(value: usize, to: usize) -> usize { return (value + to - 1) & ~(to - 1) }

// The PE32+ file of the Multiboot image `payload` (`size` bytes, loaded at
// BLOB_PHYS, entered at its code32): its bytes and their count, or null.
pub fn build(payload: [*]const u8, size: usize, total: *usize) -> ?[*]u8 {
    // The section: code, data, the memory map's room, the image.
    const payloadAt: usize = 0x400
    const sectionSize = up(payloadAt + MEMMAP_SIZE + size, 0x200)
    const fileSize = HEADERS + sectionSize
    const memory = std.heap.allocator().alloc(fileSize, 4096)
    if memory == null { return null }
    const file = memory.?
    var k: usize = 0
    while k < fileSize {
        file[k] = 0
        k += 1
    }
    // The headers: DOS (MZ, the PE header's place), PE, COFF, the
    // optional header (PE32+), one section.
    file[0] = 77
    file[1] = 90
    Asm.put32(file, 0x3C, 0x40)
    Asm.put32(file, 0x40, 0x4550)
    Asm.put16(file, 0x44, 0x8664)
    Asm.put16(file, 0x46, 1)
    Asm.put16(file, 0x54, 240)
    Asm.put16(file, 0x56, 0x22)
    const optional: usize = 0x58
    Asm.put16(file, optional, 0x20B)
    Asm.put32(file, optional + 4, sectionSize)
    Asm.put32(file, optional + 16, SECTION_RVA)
    Asm.put32(file, optional + 20, SECTION_RVA)
    Asm.put64(file, optional + 24, 0x10000000)
    Asm.put32(file, optional + 32, 0x1000)
    Asm.put32(file, optional + 36, 0x200)
    Asm.put32(file, optional + 56, up(SECTION_RVA + sectionSize, 0x1000))
    Asm.put32(file, optional + 60, HEADERS)
    Asm.put16(file, optional + 68, 10)
    Asm.put64(file, optional + 72, 0x10000)
    Asm.put64(file, optional + 80, 0x10000)
    Asm.put32(file, optional + 108, 16)
    const section: usize = optional + 240
    file[section] = 46
    file[section + 1] = 116
    file[section + 2] = 101
    file[section + 3] = 120
    file[section + 4] = 116
    Asm.put32(file, section + 8, sectionSize)
    Asm.put32(file, section + 12, SECTION_RVA)
    Asm.put32(file, section + 16, sectionSize)
    Asm.put32(file, section + 20, HEADERS)
    Asm.put32(file, section + 36, 0xE0000060)

    // The section's bytes, assembled where they are in the file (the
    // references are relative: their distances are the loaded ones).
    var a: Asm = undefined
    a.init(file, HEADERS, 0)
    const base = HEADERS
    // ---- efiMain(image handle: rcx, system table: rdx) ----
    a.byte(0x53) // push rbx
    a.byte(0x56) // push rsi
    a.byte(0x57) // push rdi
    a.byte(0x55) // push rbp
    a.bytes4(0x48, 0x83, 0xEC, 0x48) // sub rsp, 0x48 (aligned; shadow space, a fifth argument)
    a.bytes3(0x48, 0x89, 0x0D) // mov [image handle], rcx
    a.ref(Label.IMAGE_HANDLE, 4)
    a.bytes3(0x48, 0x89, 0x15) // mov [system table], rdx
    a.ref(Label.SYSTEM_TABLE, 4)
    a.bytes4(0x48, 0x8B, 0x5A, 0x60) // mov rbx, [rdx + 96] (the boot services)
    a.label(Label.RETRY)
    a.bytes3(0x48, 0xC7, 0x05) // mov qword [map size], MEMMAP_SIZE
    a.refAfter(Label.MAP_SIZE, 4, 4)
    a.imm32(MEMMAP_SIZE)
    a.bytes3(0x48, 0x8D, 0x0D) // lea rcx, [map size]
    a.ref(Label.MAP_SIZE, 4)
    a.bytes3(0x48, 0x8D, 0x15) // lea rdx, [memory map]
    a.ref(Label.MEMMAP, 4)
    a.bytes3(0x4C, 0x8D, 0x05) // lea r8, [map key]
    a.ref(Label.MAP_KEY, 4)
    a.bytes3(0x4C, 0x8D, 0x0D) // lea r9, [descriptor size]
    a.ref(Label.DESC_SIZE, 4)
    a.bytes3(0x48, 0x8D, 0x05) // lea rax, [descriptor version]
    a.ref(Label.DESC_VERSION, 4)
    a.bytes4(0x48, 0x89, 0x44, 0x24) // mov [rsp + 32], rax
    a.byte(0x20)
    a.bytes3(0xFF, 0x53, 0x38) // call [rbx + 56] (GetMemoryMap)
    a.bytes3(0x48, 0x85, 0xC0) // test rax, rax
    a.bytes2(0x0F, 0x85) // jnz fail
    a.ref(Label.FAIL, 4)
    // The highest end of the usable memory below 4 GiB.
    a.bytes3(0x48, 0x8D, 0x35) // lea rsi, [memory map]
    a.ref(Label.MEMMAP, 4)
    a.bytes3(0x48, 0x8B, 0x0D) // mov rcx, [map size]
    a.ref(Label.MAP_SIZE, 4)
    a.bytes3(0x48, 0x31, 0xFF) // xor rdi, rdi
    a.label(Label.LOOP)
    a.bytes2(0x8B, 0x06) // mov eax, [rsi] (the type)
    a.bytes3(0x83, 0xF8, 0x07) // cmp eax, 7 (conventional)
    a.byte(0x74) // je usable
    a.ref(Label.USABLE, 1)
    a.bytes2(0x85, 0xC0) // test eax, eax (reserved)
    a.byte(0x74) // jz next
    a.ref(Label.NEXT, 1)
    a.bytes3(0x83, 0xF8, 0x04) // cmp eax, 4 (loader's, boot services')
    a.byte(0x77) // ja next
    a.ref(Label.NEXT, 1)
    a.label(Label.USABLE)
    a.bytes4(0x48, 0x8B, 0x46, 0x18) // mov rax, [rsi + 24] (pages)
    a.bytes4(0x48, 0xC1, 0xE0, 0x0C) // shl rax, 12
    a.bytes4(0x48, 0x03, 0x46, 0x08) // add rax, [rsi + 8] (its start)
    a.bytes2(0x48, 0xBA) // mov rdx, 4 GiB
    a.imm64(0x100000000)
    a.bytes3(0x48, 0x39, 0xD0) // cmp rax, rdx
    a.byte(0x77) // ja next
    a.ref(Label.NEXT, 1)
    a.bytes3(0x48, 0x39, 0xF8) // cmp rax, rdi
    a.byte(0x76) // jbe next
    a.ref(Label.NEXT, 1)
    a.bytes3(0x48, 0x89, 0xC7) // mov rdi, rax
    a.label(Label.NEXT)
    a.bytes3(0x48, 0x03, 0x35) // add rsi, [descriptor size]
    a.ref(Label.DESC_SIZE, 4)
    a.bytes3(0x48, 0x2B, 0x0D) // sub rcx, [descriptor size]
    a.ref(Label.DESC_SIZE, 4)
    a.bytes2(0x0F, 0x87) // ja loop
    a.ref(Label.LOOP, 4)
    a.label(Label.DONE)
    a.bytes3(0x48, 0x81, 0xEF) // sub rdi, 1 MiB
    a.imm32(0x100000)
    a.bytes4(0x48, 0xC1, 0xEF, 0x0A) // shr rdi, 10 (KiB)
    a.bytes3(0x48, 0x89, 0x3D) // mov [mem upper], rdi
    a.ref(Label.MEM_UPPER, 4)
    // The boot services left (a new map when this one is old).
    a.bytes3(0x48, 0x8B, 0x0D) // mov rcx, [image handle]
    a.ref(Label.IMAGE_HANDLE, 4)
    a.bytes3(0x48, 0x8B, 0x15) // mov rdx, [map key]
    a.ref(Label.MAP_KEY, 4)
    a.bytes2(0xFF, 0x93) // call [rbx + 232] (ExitBootServices)
    a.imm32(232)
    a.bytes3(0x48, 0x85, 0xC0) // test rax, rax
    a.bytes2(0x0F, 0x85) // jnz retry
    a.ref(Label.RETRY, 4)
    // The firmware's no more: our GDT, then 32-bit code.
    a.byte(0xFA) // cli
    a.bytes3(0x48, 0x8D, 0x05) // lea rax, [gdt]
    a.ref(Label.GDT, 4)
    a.bytes3(0x48, 0x89, 0x05) // mov [gdtr base], rax
    a.ref(Label.GDTR_BASE, 4)
    a.bytes3(0x0F, 0x01, 0x15) // lgdt [gdtr]
    a.ref(Label.GDTR, 4)
    a.bytes3(0x48, 0x8D, 0x35) // lea rsi, [payload]
    a.ref(Label.PAYLOAD, 4)
    a.byte(0xB9) // mov ecx, its size
    a.imm32(size)
    a.bytes3(0x48, 0x8B, 0x15) // mov rdx, [mem upper]
    a.ref(Label.MEM_UPPER, 4)
    a.bytes3(0x48, 0x8D, 0x05) // lea rax, [code32]
    a.ref(Label.CODE32, 4)
    a.bytes2(0x6A, 0x08) // push 0x08 (the 32-bit code segment)
    a.byte(0x50) // push rax
    a.bytes2(0x48, 0xCB) // retfq
    a.label(Label.FAIL)
    a.bytes4(0x48, 0x83, 0xC4, 0x48) // add rsp, 0x48
    a.byte(0x5D) // pop rbp
    a.byte(0x5F) // pop rdi
    a.byte(0x5E) // pop rsi
    a.byte(0x5B) // pop rbx
    a.byte(0xC3) // ret (the error to the firmware)

    // ---- code32 (esi: the image, ecx: its size, edx: mem_upper) ----
    a.label(Label.CODE32)
    a.bytes4(0x66, 0xB8, 0x10, 0x00) // mov ax, 0x10
    a.bytes2(0x8E, 0xD8) // mov ds, ax
    a.bytes2(0x8E, 0xC0) // mov es, ax
    a.bytes2(0x8E, 0xD0) // mov ss, ax
    a.bytes3(0x0F, 0x20, 0xC0) // mov eax, cr0
    a.byte(0x25) // and eax, ~PG
    a.imm32(0x7FFFFFFF)
    a.bytes3(0x0F, 0x22, 0xC0) // mov cr0, eax (paging off: out of long mode)
    a.bytes2(0x89, 0xCD) // mov ebp, ecx
    a.bytes2(0x89, 0xD3) // mov ebx, edx
    a.byte(0xB9) // mov ecx, EFER
    a.imm32(0xC0000080)
    a.bytes2(0x0F, 0x32) // rdmsr
    a.byte(0x25) // and eax, ~LME
    a.imm32(0xFFFFFEFF)
    a.bytes2(0x0F, 0x30) // wrmsr
    a.bytes2(0xC7, 0x05) // mov dword [MBI], 1 (flags: memory)
    a.imm32(MBI)
    a.imm32(1)
    a.bytes2(0xC7, 0x05) // mov dword [MBI + 4], 640 (mem_lower)
    a.imm32(MBI + 4)
    a.imm32(640)
    a.bytes2(0x89, 0x1D) // mov [MBI + 8], ebx (mem_upper)
    a.imm32(MBI + 8)
    a.byte(0xBF) // mov edi, BLOB_PHYS
    a.imm32(layout.Memory.BLOB)
    a.bytes2(0x89, 0xE9) // mov ecx, ebp
    a.byte(0xFC) // cld
    a.bytes2(0xF3, 0xA4) // rep movsb
    a.byte(0xB8) // mov eax, Multiboot's magic
    a.imm32(0x2BADB002)
    a.byte(0xBB) // mov ebx, MBI
    a.imm32(MBI)
    a.byte(0xB9) // mov ecx, the blob's entry
    a.imm32(layout.Memory.BLOB + layout.Blob.CODE32)
    a.bytes2(0xFF, 0xE1) // jmp ecx

    // ---- data ----
    a.at = up(a.at, 16)
    a.label(Label.GDT)
    Asm.put64(file, a.at, 0)
    Asm.put64(file, a.at + 8, 0x00CF9A000000FFFF)
    Asm.put64(file, a.at + 16, 0x00CF92000000FFFF)
    a.at += 24
    a.at = up(a.at, 16) + 6
    a.label(Label.GDTR)
    Asm.put16(file, a.at, 23)
    a.labelAt(Label.GDTR_BASE, a.at + 2)
    a.at += 10
    a.at = up(a.at, 8)
    a.labelAt(Label.IMAGE_HANDLE, a.at)
    a.labelAt(Label.SYSTEM_TABLE, a.at + 8)
    a.labelAt(Label.MAP_SIZE, a.at + 16)
    a.labelAt(Label.MAP_KEY, a.at + 24)
    a.labelAt(Label.DESC_SIZE, a.at + 32)
    a.labelAt(Label.DESC_VERSION, a.at + 40)
    a.labelAt(Label.MEM_UPPER, a.at + 48)
    a.at += 56
    if a.at > base + payloadAt { return null }
    a.labelAt(Label.MEMMAP, base + payloadAt)
    a.labelAt(Label.PAYLOAD, base + payloadAt + MEMMAP_SIZE)
    if !a.finish() { return null }
    k = 0
    while k < size {
        file[base + payloadAt + MEMMAP_SIZE + k] = payload[k]
        k += 1
    }
    total.* = fileSize
    return file
}
