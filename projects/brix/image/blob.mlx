// brix-image's boot blob: the Multiboot header, the boot info, the GDT,
// TSS and IDT, and the code, assembled into the image's first MiB (it is
// loaded at BLOB_PHYS). The code:
//
// - code32: the Multiboot entry (32-bit protected mode, paging off): the
//   page tables (the first GiB in 2 MiB pages, at 0 and at the kernel's
//   higher half), PAE, long mode and SYSCALL enabled, paging on, the GDT,
//   a far jump to code64.
// - code64: on to the higher half, the GDT and a CS of it again, the IDT,
//   the TSS, the SYSCALL MSRs (the kernel's selectors, the entry, flags
//   masked: IF, TF, DF, AC), SSE and write protection (CR0.WP, for copy
//   on write) on, the boot stack, then the kernel's
//   _start with its arena (rdi, rsi).
// - syscall: SYSCALL's entry. From user mode (a return address in the
//   lower half): the trap stack, a trap frame (vector 0x80) and the
//   common trap path. From the kernel: one of its operations (layout.Op:
//   port I/O, control registers, MSRs, the time-stamp counter, entering
//   user mode), then back by
//   the saved flags and return address.
// - stubs and trapCommon: a stub per vector pushes a zero error code
//   where the CPU pushes none and its vector; the common path pushes the
//   registers (the frame: r15 .. rax, vector, error, rip, cs, rflags,
//   rsp, ss), loads the kernel's arena registers (r14, r15) and calls the
//   kernel's brix_trap with the frame, then returns by IRETQ (also to user
//   mode after a system call).
const layout = @import("../layout.mlx")
const Asm = @import("./asm.mlx").Asm

// Labels.
const Label = struct {
    pub const LOOP: usize = 0
    pub const SYSCALL: usize = 1
    pub const KOP: usize = 2
    pub const KRET: usize = 3
    pub const TRAP: usize = 4
    pub const USER_RSP: usize = 5
    pub const TRAP_STACK: usize = 6
    pub const NEXT: usize = 7
    // Operation skips: SKIP + n.
    pub const SKIP: usize = 20
}

// The vectors with an error code the CPU pushes.
fn hasErrorCode(vector: usize) -> bool {
    return vector == 8 || (vector >= 10 && vector <= 14) || vector == 17 || vector == 21 || vector == 29 || vector == 30
}

// 0, or what did not fit: 1 code32, 2 code64 and the trap path, 3 a
// reference.
pub fn build(image: [*]u8, entry: usize, trap: usize, kernelSize: usize, archivePhys: usize, archiveSize: usize) -> u8 {
    const phys = layout.Memory.BLOB
    var state: Asm = undefined
    const a = &state
    a.init(image, layout.Blob.CODE32, layout.Memory.KERNEL_VIRTUAL + phys)

    // The Multiboot header: magic, flags (modules page aligned, memory
    // information, the load addresses below), checksum, header, load,
    // load end (0: the whole file), bss end (none), entry.
    const magic: usize = 0x1BADB002
    const flags: usize = 0x00010003
    Asm.put32(image, layout.Blob.HEADER, magic)
    Asm.put32(image, layout.Blob.HEADER + 4, flags)
    Asm.put32(image, layout.Blob.HEADER + 8, (0x100000000 - magic - flags) & 0xffffffff)
    Asm.put32(image, layout.Blob.HEADER + 12, phys)
    Asm.put32(image, layout.Blob.HEADER + 16, phys)
    Asm.put32(image, layout.Blob.HEADER + 20, 0)
    Asm.put32(image, layout.Blob.HEADER + 24, 0)
    Asm.put32(image, layout.Blob.HEADER + 28, phys + layout.Blob.CODE32)

    // The boot info.
    const info = layout.Blob.BOOT_INFO
    Asm.put64(image, info + layout.Info.KERNEL_PHYS, layout.Memory.KERNEL)
    Asm.put64(image, info + layout.Info.KERNEL_SIZE, kernelSize)
    Asm.put64(image, info + layout.Info.ARCHIVE_PHYS, archivePhys)
    Asm.put64(image, info + layout.Info.ARCHIVE_SIZE, archiveSize)
    Asm.put64(image, info + layout.Info.ARENA_BASE, layout.Memory.KERNEL_VIRTUAL + layout.Memory.ARENA)
    Asm.put64(image, info + layout.Info.ARENA_END, layout.Memory.KERNEL_VIRTUAL + layout.Memory.ARENA + layout.Memory.ARENA_SIZE)
    Asm.put64(image, info + layout.Info.FREE_PHYS, layout.Memory.FREE)
    Asm.put64(image, info + layout.Info.TRAP_STACK, layout.Blob.virtual(layout.Blob.TRAP_STACK_TOP))
    Asm.put64(image, info + layout.Info.TSS, layout.Blob.virtual(layout.Blob.TSS))

    // The GDT: null, kernel code (64-bit), kernel data, user code 32
    // (SYSRET's base), user data, user code (64-bit), the TSS (16 bytes).
    Asm.put64(image, layout.Blob.GDT + 0x08, 0x00AF9A000000FFFF)
    Asm.put64(image, layout.Blob.GDT + 0x10, 0x00CF92000000FFFF)
    Asm.put64(image, layout.Blob.GDT + 0x18, 0x00CFFA000000FFFF)
    Asm.put64(image, layout.Blob.GDT + 0x20, 0x00CFF2000000FFFF)
    Asm.put64(image, layout.Blob.GDT + 0x28, 0x00AFFA000000FFFF)
    const tss = layout.Blob.virtual(layout.Blob.TSS)
    const tssLow = 103 | ((tss & 0xffff) << 16) | (((tss >> 16) & 0xff) << 32) | (0x89 << 40) | (((tss >> 24) & 0xff) << 56)
    Asm.put64(image, layout.Blob.GDT + 0x30, tssLow)
    Asm.put64(image, layout.Blob.GDT + 0x38, tss >> 32)
    Asm.put16(image, layout.Blob.GDTR32, 0x3F)
    Asm.put32(image, layout.Blob.GDTR32 + 2, phys + layout.Blob.GDT)
    Asm.put16(image, layout.Blob.GDTR64, 0x3F)
    Asm.put64(image, layout.Blob.GDTR64 + 2, layout.Blob.virtual(layout.Blob.GDT))
    // The TSS: rsp0 (the trap stack), no I/O map.
    Asm.put64(image, layout.Blob.TSS + 4, layout.Blob.virtual(layout.Blob.TRAP_STACK_TOP))
    Asm.put16(image, layout.Blob.TSS + 102, 104)
    // The IDT: interrupt gates (kernel code, DPL 0) to the stubs.
    Asm.put16(image, layout.Blob.IDTR, 4095)
    Asm.put64(image, layout.Blob.IDTR + 2, layout.Blob.virtual(layout.Blob.IDT))
    var vector: usize = 0
    while vector < 256 {
        const handler = layout.Blob.virtual(layout.Blob.STUBS + vector * 16)
        const gate = layout.Blob.IDT + vector * 16
        Asm.put16(image, gate, handler & 0xffff)
        Asm.put16(image, gate + 2, layout.Selector.KERNEL_CODE)
        image[gate + 4] = 0
        image[gate + 5] = 0x8E
        Asm.put16(image, gate + 6, (handler >> 16) & 0xffff)
        Asm.put32(image, gate + 8, (handler >> 32) & 0xffffffff)
        Asm.put32(image, gate + 12, 0)
        vector += 1
    }
    a.labelAt(Label.USER_RSP, info + layout.Info.USER_RSP)
    a.labelAt(Label.TRAP_STACK, info + layout.Info.TRAP_STACK)

    // ---- code32 ----
    a.byte(0xFA) // cli
    a.bytes2(0x89, 0x1D) // mov [mbi], ebx
    a.imm32(phys + info + layout.Info.MBI)
    a.byte(0xBF) // mov edi, PD
    a.imm32(phys + layout.Blob.PD)
    a.byte(0xB8) // mov eax, 0x83 (present, writable, 2 MiB)
    a.imm32(0x83)
    a.byte(0xB9) // mov ecx, 512
    a.imm32(512)
    a.label(Label.LOOP)
    a.bytes2(0x89, 0x07) // mov [edi], eax
    a.byte(0x05) // add eax, 0x200000
    a.imm32(0x200000)
    a.bytes3(0x83, 0xC7, 0x08) // add edi, 8
    a.byte(0xE2) // loop Label.LOOP
    a.ref(Label.LOOP, 1)
    a.bytes2(0xC7, 0x05) // mov dword [PDPT], PD | 3
    a.imm32(phys + layout.Blob.PDPT)
    a.imm32(phys + layout.Blob.PD + 3)
    a.bytes2(0xC7, 0x05) // mov dword [PML4], PDPT | 3
    a.imm32(phys + layout.Blob.PML4)
    a.imm32(phys + layout.Blob.PDPT + 3)
    a.bytes2(0xC7, 0x05) // mov dword [PML4 + 256 * 8], PDPT | 3
    a.imm32(phys + layout.Blob.PML4 + 256 * 8)
    a.imm32(phys + layout.Blob.PDPT + 3)
    a.byte(0xB8) // mov eax, PML4
    a.imm32(phys + layout.Blob.PML4)
    a.bytes3(0x0F, 0x22, 0xD8) // mov cr3, eax
    a.bytes3(0x0F, 0x20, 0xE0) // mov eax, cr4
    a.bytes3(0x83, 0xC8, 0x20) // or eax, 0x20 (PAE)
    a.bytes3(0x0F, 0x22, 0xE0) // mov cr4, eax
    a.byte(0xB9) // mov ecx, IA32_EFER
    a.imm32(0xC0000080)
    a.bytes2(0x0F, 0x32) // rdmsr
    a.byte(0x0D) // or eax, 0x101 (SCE, LME)
    a.imm32(0x101)
    a.bytes2(0x0F, 0x30) // wrmsr
    a.bytes3(0x0F, 0x20, 0xC0) // mov eax, cr0
    a.byte(0x0D) // or eax, 0x80000001 (PG, PE)
    a.imm32(0x80000001)
    a.bytes3(0x0F, 0x22, 0xC0) // mov cr0, eax
    a.bytes3(0x0F, 0x01, 0x15) // lgdt [GDTR32]
    a.imm32(phys + layout.Blob.GDTR32)
    a.byte(0xEA) // jmp far 0x08:code64
    a.imm32(phys + layout.Blob.CODE64)
    Asm.put16(image, a.*.at, layout.Selector.KERNEL_CODE)
    a.*.at += 2
    if a.*.at > layout.Blob.CODE64 { return 1 }

    // ---- code64 (still at the identity mapping) ----
    a.*.at = layout.Blob.CODE64
    a.bytes4(0x66, 0xB8, 0x10, 0x00) // mov ax, 0x10
    a.bytes2(0x8E, 0xD8) // mov ds, ax
    a.bytes2(0x8E, 0xC0) // mov es, ax
    a.bytes2(0x8E, 0xD0) // mov ss, ax
    a.bytes2(0x31, 0xC0) // xor eax, eax
    a.bytes2(0x8E, 0xE0) // mov fs, ax
    a.bytes2(0x8E, 0xE8) // mov gs, ax
    a.bytes2(0x48, 0xB8) // mov rax, Label.NEXT (higher half)
    a.absolute(Label.NEXT)
    a.bytes2(0xFF, 0xE0) // jmp rax
    a.label(Label.NEXT)
    a.bytes2(0x48, 0xB8) // mov rax, GDTR64
    a.imm64(layout.Blob.virtual(layout.Blob.GDTR64))
    a.bytes3(0x0F, 0x01, 0x10) // lgdt [rax]
    a.bytes2(0x6A, 0x08) // push 8
    a.bytes3(0x48, 0x8D, 0x05) // lea rax, [rip + 3]
    a.imm32(3)
    a.byte(0x50) // push rax
    a.bytes2(0x48, 0xCB) // retfq
    a.bytes2(0x48, 0xB8) // mov rax, IDTR
    a.imm64(layout.Blob.virtual(layout.Blob.IDTR))
    a.bytes3(0x0F, 0x01, 0x18) // lidt [rax]
    a.bytes4(0x66, 0xB8, layout.Selector.TSS, 0x00) // mov ax, 0x30
    a.bytes3(0x0F, 0x00, 0xD8) // ltr ax
    a.byte(0xB9) // mov ecx, IA32_STAR
    a.imm32(0xC0000081)
    a.bytes2(0x31, 0xC0) // xor eax, eax
    a.byte(0xBA) // mov edx, 0x00180008 (SYSRET's base 0x18, SYSCALL's 0x08)
    a.imm32(0x00180008)
    a.bytes2(0x0F, 0x30) // wrmsr
    a.byte(0xB9) // mov ecx, IA32_LSTAR
    a.imm32(0xC0000082)
    a.bytes2(0x48, 0xB8) // mov rax, Label.SYSCALL
    a.absolute(Label.SYSCALL)
    a.bytes3(0x48, 0x89, 0xC2) // mov rdx, rax
    a.bytes4(0x48, 0xC1, 0xEA, 0x20) // shr rdx, 32
    a.bytes2(0x0F, 0x30) // wrmsr
    a.byte(0xB9) // mov ecx, IA32_FMASK
    a.imm32(0xC0000084)
    a.byte(0xB8) // mov eax, IF | TF | DF | AC
    a.imm32(0x40700)
    a.bytes2(0x31, 0xD2) // xor edx, edx
    a.bytes2(0x0F, 0x30) // wrmsr
    a.bytes3(0x0F, 0x20, 0xC0) // mov rax, cr0
    a.bytes4(0x48, 0x83, 0xE0, 0xFB) // and rax, ~4 (EM)
    a.bytes4(0x48, 0x83, 0xC8, 0x02) // or rax, 2 (MP)
    a.bytes2(0x48, 0x0D) // or rax, 0x10000 (WP: the kernel's writes respect read-only pages too, copy on write)
    a.imm32(0x10000)
    a.bytes3(0x0F, 0x22, 0xC0) // mov cr0, rax
    a.bytes3(0x0F, 0x20, 0xE0) // mov rax, cr4
    a.bytes2(0x48, 0x0D) // or rax, 0x600 (OSFXSR, OSXMMEXCPT)
    a.imm32(0x600)
    a.bytes3(0x0F, 0x22, 0xE0) // mov cr4, rax
    a.bytes2(0x48, 0xBC) // mov rsp, boot stack
    a.imm64(layout.Blob.virtual(layout.Blob.BOOT_STACK_TOP))
    a.bytes2(0x48, 0xBF) // mov rdi, arena
    a.imm64(layout.Memory.KERNEL_VIRTUAL + layout.Memory.ARENA)
    a.bytes2(0x48, 0xBE) // mov rsi, arena end
    a.imm64(layout.Memory.KERNEL_VIRTUAL + layout.Memory.ARENA + layout.Memory.ARENA_SIZE)
    a.bytes2(0x48, 0xB8) // mov rax, _start
    a.imm64(entry)
    a.bytes2(0xFF, 0xD0) // call rax
    a.bytes3(0xFA, 0xF4, 0xEB) // cli; hlt; jmp to the hlt
    a.byte(0xFD)

    // ---- syscall ----
    a.label(Label.SYSCALL)
    a.bytes3(0x48, 0x85, 0xC9) // test rcx, rcx
    a.bytes2(0x0F, 0x88) // js Label.KOP (the kernel's operations)
    a.ref(Label.KOP, 4)
    a.bytes3(0x48, 0x89, 0x25) // mov [user rsp], rsp
    a.ref(Label.USER_RSP, 4)
    a.bytes3(0x48, 0x8B, 0x25) // mov rsp, [trap stack]
    a.ref(Label.TRAP_STACK, 4)
    a.bytes2(0x6A, layout.Selector.USER_DATA) // push ss
    a.bytes2(0xFF, 0x35) // push [user rsp]
    a.ref(Label.USER_RSP, 4)
    a.bytes2(0x41, 0x53) // push r11 (rflags)
    a.bytes2(0x6A, layout.Selector.USER_CODE) // push cs
    a.byte(0x51) // push rcx (rip)
    a.bytes2(0x6A, 0x00) // push 0 (error)
    a.byte(0x68) // push 0x80 (vector)
    a.imm32(layout.Vector.SYSCALL)
    a.byte(0xE9) // jmp Label.TRAP
    a.ref(Label.TRAP, 4)

    // The kernel's operations (rdx kept; rax the result).
    a.label(Label.KOP)
    a.byte(0x52) // push rdx
    var op: usize = 1
    while op <= layout.Op.COUNT {
        a.bytes4(0x48, 0x83, 0xF8, op) // cmp rax, op
        a.byte(0x75) // jne skip
        a.ref(Label.SKIP + op, 1)
        if op == layout.Op.OUTB {
            a.bytes3(0x48, 0x89, 0xFA) // mov rdx, rdi
            a.bytes3(0x48, 0x89, 0xF0) // mov rax, rsi
            a.byte(0xEE) // out dx, al
        } else if op == layout.Op.INB {
            a.bytes3(0x48, 0x89, 0xFA) // mov rdx, rdi
            a.bytes2(0x31, 0xC0) // xor eax, eax
            a.byte(0xEC) // in al, dx
        } else if op == layout.Op.WAIT {
            a.bytes3(0xFB, 0xF4, 0xFA) // sti; hlt; cli
        } else if op == layout.Op.READ_CR2 {
            a.bytes3(0x0F, 0x20, 0xD0) // mov rax, cr2
        } else if op == layout.Op.WRITE_CR3 {
            a.bytes3(0x0F, 0x22, 0xDF) // mov cr3, rdi
        } else if op == layout.Op.READ_CR3 {
            a.bytes3(0x0F, 0x20, 0xD8) // mov rax, cr3
        } else if op == layout.Op.INVLPG {
            a.bytes3(0x0F, 0x01, 0x3F) // invlpg [rdi]
        } else if op == layout.Op.WRMSR {
            a.byte(0x51) // push rcx
            a.bytes2(0x89, 0xF9) // mov ecx, edi
            a.bytes2(0x89, 0xF0) // mov eax, esi
            a.bytes3(0x48, 0x89, 0xF2) // mov rdx, rsi
            a.bytes4(0x48, 0xC1, 0xEA, 0x20) // shr rdx, 32
            a.bytes2(0x0F, 0x30) // wrmsr
            a.byte(0x59) // pop rcx
        } else if op == layout.Op.ENTER_USER {
            // An IRETQ frame: ss, rsp (rsi), rflags (IF), cs, rip (rdi).
            a.bytes2(0x6A, layout.Selector.USER_DATA) // push ss
            a.byte(0x56) // push rsi
            a.byte(0x68) // push 0x202
            a.imm32(0x202)
            a.bytes2(0x6A, layout.Selector.USER_CODE) // push cs
            a.byte(0x57) // push rdi
            // Every register zero.
            a.bytes2(0x31, 0xC0)
            a.bytes2(0x31, 0xDB)
            a.bytes2(0x31, 0xC9)
            a.bytes2(0x31, 0xD2)
            a.bytes2(0x31, 0xF6)
            a.bytes2(0x31, 0xFF)
            a.bytes2(0x31, 0xED)
            a.bytes3(0x45, 0x31, 0xC0)
            a.bytes3(0x45, 0x31, 0xC9)
            a.bytes3(0x45, 0x31, 0xD2)
            a.bytes3(0x45, 0x31, 0xDB)
            a.bytes3(0x45, 0x31, 0xE4)
            a.bytes3(0x45, 0x31, 0xED)
            a.bytes3(0x45, 0x31, 0xF6)
            a.bytes3(0x45, 0x31, 0xFF)
            a.bytes2(0x48, 0xCF) // iretq
        } else if op == layout.Op.OUTW {
            a.bytes3(0x48, 0x89, 0xFA) // mov rdx, rdi
            a.bytes3(0x48, 0x89, 0xF0) // mov rax, rsi
            a.bytes2(0x66, 0xEF) // out dx, ax
        } else if op == layout.Op.OUTL {
            a.bytes3(0x48, 0x89, 0xFA) // mov rdx, rdi
            a.bytes3(0x48, 0x89, 0xF0) // mov rax, rsi
            a.byte(0xEF) // out dx, eax
        } else if op == layout.Op.INL {
            a.bytes3(0x48, 0x89, 0xFA) // mov rdx, rdi
            a.byte(0xED) // in eax, dx
        } else if op == layout.Op.INW {
            a.bytes3(0x48, 0x89, 0xFA) // mov rdx, rdi
            a.bytes2(0x31, 0xC0) // xor eax, eax
            a.bytes2(0x66, 0xED) // in ax, dx
        } else if op == layout.Op.RDTSC {
            a.bytes2(0x0F, 0x31) // rdtsc
            a.bytes4(0x48, 0xC1, 0xE2, 0x20) // shl rdx, 32
            a.bytes3(0x48, 0x09, 0xD0) // or rax, rdx
        }
        a.byte(0xE9) // jmp Label.KRET
        a.ref(Label.KRET, 4)
        a.label(Label.SKIP + op)
        op += 1
    }
    a.label(Label.KRET)
    a.byte(0x5A) // pop rdx
    a.bytes2(0x41, 0x53) // push r11
    a.byte(0x9D) // popfq
    a.bytes2(0xFF, 0xE1) // jmp rcx

    // ---- the common trap path ----
    a.label(Label.TRAP)
    a.byte(0x50) // push rax
    a.byte(0x53) // push rbx
    a.byte(0x51) // push rcx
    a.byte(0x52) // push rdx
    a.byte(0x56) // push rsi
    a.byte(0x57) // push rdi
    a.byte(0x55) // push rbp
    var r: usize = 0
    while r < 8 {
        a.bytes2(0x41, 0x50 + r) // push r8 .. r15
        r += 1
    }
    a.bytes3(0x48, 0x89, 0xE7) // mov rdi, rsp
    // The SSE registers kept (the kernel's code uses them too).
    a.bytes3(0x48, 0x81, 0xEC) // sub rsp, 512
    a.imm32(512)
    a.bytes4(0x0F, 0xAE, 0x04, 0x24) // fxsave [rsp]
    a.bytes2(0x49, 0xBE) // mov r14, arena
    a.imm64(layout.Memory.KERNEL_VIRTUAL + layout.Memory.ARENA)
    a.bytes2(0x49, 0xBF) // mov r15, arena end
    a.imm64(layout.Memory.KERNEL_VIRTUAL + layout.Memory.ARENA + layout.Memory.ARENA_SIZE)
    a.bytes2(0x48, 0xB8) // mov rax, brix_trap
    a.imm64(trap)
    a.bytes2(0xFF, 0xD0) // call rax
    a.bytes4(0x0F, 0xAE, 0x0C, 0x24) // fxrstor [rsp]
    a.bytes3(0x48, 0x81, 0xC4) // add rsp, 512
    a.imm32(512)
    r = 8
    while r > 0 {
        r -= 1
        a.bytes2(0x41, 0x58 + r) // pop r15 .. r8
    }
    a.byte(0x5D) // pop rbp
    a.byte(0x5F) // pop rdi
    a.byte(0x5E) // pop rsi
    a.byte(0x5A) // pop rdx
    a.byte(0x59) // pop rcx
    a.byte(0x5B) // pop rbx
    a.byte(0x58) // pop rax
    a.bytes4(0x48, 0x83, 0xC4, 0x10) // add rsp, 16
    a.bytes2(0x48, 0xCF) // iretq
    if a.*.at > layout.Blob.IDT { return 2 }

    // ---- the stubs ----
    vector = 0
    while vector < 256 {
        a.*.at = layout.Blob.STUBS + vector * 16
        if !hasErrorCode(vector) { a.bytes2(0x6A, 0x00) } // push 0
        a.byte(0x68) // push vector
        a.imm32(vector)
        a.byte(0xE9) // jmp Label.TRAP
        a.ref(Label.TRAP, 4)
        vector += 1
    }
    return if a.finish() { 0 } else { 3 }
}
