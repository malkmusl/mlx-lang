// brix-image's boot blob: the Multiboot header, the boot info, the GDT,
// TSS and IDT, and the code, assembled into the image's first MiB (it is
// loaded at BLOB_PHYS). The code:
//
// - code32: the Multiboot entry (32-bit protected mode, paging off): the
//   page tables (the first GiB in 2 MiB pages, at 0 and at the kernel's
//   higher half), PAE, long mode and SYSCALL enabled, paging on, the GDT,
//   a far jump to code64.
// - code64: on to the higher half, the GDT and a CS of it again, the IDT,
//   the TSS, the SYSCALL MSRs (the kernel's selectors, the entry, flags
//   masked: IF, TF, DF, AC), SSE on, the boot stack, then the kernel's
//   _start with its arena (rdi, rsi).
// - syscall: SYSCALL's entry. From user mode (a return address in the
//   lower half): the trap stack, a trap frame (vector 0x80) and the
//   common trap path. From the kernel: one of its operations (layout.OP_*:
//   port I/O, control registers, MSRs, entering user mode), then back by
//   the saved flags and return address.
// - stubs and trapCommon: a stub per vector pushes a zero error code
//   where the CPU pushes none and its vector; the common path pushes the
//   registers (the frame: r15 .. rax, vector, error, rip, cs, rflags,
//   rsp, ss), loads the kernel's arena registers (r14, r15) and calls the
//   kernel's brix_trap with the frame, then returns by IRETQ (also to user
//   mode after a system call).
const layout = @import("../layout.mlx")
const asm_module = @import("./asm.mlx")

const Asm = asm_module.Asm

// Labels.
const L_LOOP: usize = 0
const L_SYSCALL: usize = 1
const L_KOP: usize = 2
const L_KRET: usize = 3
const L_TRAP: usize = 4
const L_USER_RSP: usize = 5
const L_TRAP_STACK: usize = 6
const L_NEXT: usize = 7
const L_GDTR64: usize = 8
const L_IDTR: usize = 9
// Operation skips: L_SKIP + n.
const L_SKIP: usize = 20

fn b(a: *Asm, value: usize) -> void { asm_module.byte(a, value) }

// The vectors with an error code the CPU pushes.
fn hasErrorCode(vector: usize) -> bool {
    return vector == 8 || (vector >= 10 && vector <= 14) || vector == 17 || vector == 21 || vector == 29 || vector == 30
}

// 0, or what did not fit: 1 code32, 2 code64 and the trap path, 3 a
// reference.
pub fn build(image: [*]u8, entry: usize, trap: usize, kernelSize: usize, archivePhys: usize, archiveSize: usize) -> u8 {
    const phys = layout.BLOB_PHYS
    var state: Asm = undefined
    const a = &state
    asm_module.init(a, image, layout.CODE32, layout.KERNEL_VIRTUAL + phys)

    // The Multiboot header: magic, flags (modules page aligned, memory
    // information, the load addresses below), checksum, header, load,
    // load end (0: the whole file), bss end (none), entry.
    const magic: usize = 0x1BADB002
    const flags: usize = 0x00010003
    asm_module.put32(image, layout.HEADER, magic)
    asm_module.put32(image, layout.HEADER + 4, flags)
    asm_module.put32(image, layout.HEADER + 8, (0x100000000 - magic - flags) & 0xffffffff)
    asm_module.put32(image, layout.HEADER + 12, phys)
    asm_module.put32(image, layout.HEADER + 16, phys)
    asm_module.put32(image, layout.HEADER + 20, 0)
    asm_module.put32(image, layout.HEADER + 24, 0)
    asm_module.put32(image, layout.HEADER + 28, phys + layout.CODE32)

    // The boot info.
    const info = layout.BOOT_INFO
    asm_module.put64(image, info + layout.INFO_KERNEL_PHYS, layout.KERNEL_PHYS)
    asm_module.put64(image, info + layout.INFO_KERNEL_SIZE, kernelSize)
    asm_module.put64(image, info + layout.INFO_ARCHIVE_PHYS, archivePhys)
    asm_module.put64(image, info + layout.INFO_ARCHIVE_SIZE, archiveSize)
    asm_module.put64(image, info + layout.INFO_ARENA_BASE, layout.KERNEL_VIRTUAL + layout.ARENA_PHYS)
    asm_module.put64(image, info + layout.INFO_ARENA_END, layout.KERNEL_VIRTUAL + layout.ARENA_PHYS + layout.ARENA_SIZE)
    asm_module.put64(image, info + layout.INFO_FREE_PHYS, layout.FREE_PHYS)
    asm_module.put64(image, info + layout.INFO_TRAP_STACK, layout.blobVirtual(layout.TRAP_STACK_TOP))
    asm_module.put64(image, info + layout.INFO_TSS, layout.blobVirtual(layout.TSS))

    // The GDT: null, kernel code (64-bit), kernel data, user code 32
    // (SYSRET's base), user data, user code (64-bit), the TSS (16 bytes).
    asm_module.put64(image, layout.GDT + 0x08, 0x00AF9A000000FFFF)
    asm_module.put64(image, layout.GDT + 0x10, 0x00CF92000000FFFF)
    asm_module.put64(image, layout.GDT + 0x18, 0x00CFFA000000FFFF)
    asm_module.put64(image, layout.GDT + 0x20, 0x00CFF2000000FFFF)
    asm_module.put64(image, layout.GDT + 0x28, 0x00AFFA000000FFFF)
    const tss = layout.blobVirtual(layout.TSS)
    const tssLow = 103 | ((tss & 0xffff) << 16) | (((tss >> 16) & 0xff) << 32) | (0x89 << 40) | (((tss >> 24) & 0xff) << 56)
    asm_module.put64(image, layout.GDT + 0x30, tssLow)
    asm_module.put64(image, layout.GDT + 0x38, tss >> 32)
    asm_module.put16(image, layout.GDTR32, 0x3F)
    asm_module.put32(image, layout.GDTR32 + 2, phys + layout.GDT)
    asm_module.put16(image, layout.GDTR64, 0x3F)
    asm_module.put64(image, layout.GDTR64 + 2, layout.blobVirtual(layout.GDT))
    // The TSS: rsp0 (the trap stack), no I/O map.
    asm_module.put64(image, layout.TSS + 4, layout.blobVirtual(layout.TRAP_STACK_TOP))
    asm_module.put16(image, layout.TSS + 102, 104)
    // The IDT: interrupt gates (kernel code, DPL 0) to the stubs.
    asm_module.put16(image, layout.IDTR, 4095)
    asm_module.put64(image, layout.IDTR + 2, layout.blobVirtual(layout.IDT))
    var vector: usize = 0
    while vector < 256 {
        const handler = layout.blobVirtual(layout.STUBS + vector * 16)
        const gate = layout.IDT + vector * 16
        asm_module.put16(image, gate, handler & 0xffff)
        asm_module.put16(image, gate + 2, layout.KERNEL_CODE)
        image[gate + 4] = 0
        image[gate + 5] = 0x8E
        asm_module.put16(image, gate + 6, (handler >> 16) & 0xffff)
        asm_module.put32(image, gate + 8, (handler >> 32) & 0xffffffff)
        asm_module.put32(image, gate + 12, 0)
        vector += 1
    }
    asm_module.labelAt(a, L_USER_RSP, info + layout.INFO_USER_RSP)
    asm_module.labelAt(a, L_TRAP_STACK, info + layout.INFO_TRAP_STACK)

    // ---- code32 ----
    b(a, 0xFA) // cli
    asm_module.bytes2(a, 0x89, 0x1D) // mov [mbi], ebx
    asm_module.imm32(a, phys + info + layout.INFO_MBI)
    b(a, 0xBF) // mov edi, PD
    asm_module.imm32(a, phys + layout.PD)
    b(a, 0xB8) // mov eax, 0x83 (present, writable, 2 MiB)
    asm_module.imm32(a, 0x83)
    b(a, 0xB9) // mov ecx, 512
    asm_module.imm32(a, 512)
    asm_module.label(a, L_LOOP)
    asm_module.bytes2(a, 0x89, 0x07) // mov [edi], eax
    b(a, 0x05) // add eax, 0x200000
    asm_module.imm32(a, 0x200000)
    asm_module.bytes3(a, 0x83, 0xC7, 0x08) // add edi, 8
    b(a, 0xE2) // loop L_LOOP
    asm_module.ref(a, L_LOOP, 1)
    asm_module.bytes2(a, 0xC7, 0x05) // mov dword [PDPT], PD | 3
    asm_module.imm32(a, phys + layout.PDPT)
    asm_module.imm32(a, phys + layout.PD + 3)
    asm_module.bytes2(a, 0xC7, 0x05) // mov dword [PML4], PDPT | 3
    asm_module.imm32(a, phys + layout.PML4)
    asm_module.imm32(a, phys + layout.PDPT + 3)
    asm_module.bytes2(a, 0xC7, 0x05) // mov dword [PML4 + 256 * 8], PDPT | 3
    asm_module.imm32(a, phys + layout.PML4 + 256 * 8)
    asm_module.imm32(a, phys + layout.PDPT + 3)
    b(a, 0xB8) // mov eax, PML4
    asm_module.imm32(a, phys + layout.PML4)
    asm_module.bytes3(a, 0x0F, 0x22, 0xD8) // mov cr3, eax
    asm_module.bytes3(a, 0x0F, 0x20, 0xE0) // mov eax, cr4
    asm_module.bytes3(a, 0x83, 0xC8, 0x20) // or eax, 0x20 (PAE)
    asm_module.bytes3(a, 0x0F, 0x22, 0xE0) // mov cr4, eax
    b(a, 0xB9) // mov ecx, IA32_EFER
    asm_module.imm32(a, 0xC0000080)
    asm_module.bytes2(a, 0x0F, 0x32) // rdmsr
    b(a, 0x0D) // or eax, 0x101 (SCE, LME)
    asm_module.imm32(a, 0x101)
    asm_module.bytes2(a, 0x0F, 0x30) // wrmsr
    asm_module.bytes3(a, 0x0F, 0x20, 0xC0) // mov eax, cr0
    b(a, 0x0D) // or eax, 0x80000001 (PG, PE)
    asm_module.imm32(a, 0x80000001)
    asm_module.bytes3(a, 0x0F, 0x22, 0xC0) // mov cr0, eax
    asm_module.bytes3(a, 0x0F, 0x01, 0x15) // lgdt [GDTR32]
    asm_module.imm32(a, phys + layout.GDTR32)
    b(a, 0xEA) // jmp far 0x08:code64
    asm_module.imm32(a, phys + layout.CODE64)
    asm_module.put16(image, a.*.at, layout.KERNEL_CODE)
    a.*.at += 2
    if a.*.at > layout.CODE64 { return 1 }

    // ---- code64 (still at the identity mapping) ----
    a.*.at = layout.CODE64
    asm_module.bytes4(a, 0x66, 0xB8, 0x10, 0x00) // mov ax, 0x10
    asm_module.bytes2(a, 0x8E, 0xD8) // mov ds, ax
    asm_module.bytes2(a, 0x8E, 0xC0) // mov es, ax
    asm_module.bytes2(a, 0x8E, 0xD0) // mov ss, ax
    asm_module.bytes2(a, 0x31, 0xC0) // xor eax, eax
    asm_module.bytes2(a, 0x8E, 0xE0) // mov fs, ax
    asm_module.bytes2(a, 0x8E, 0xE8) // mov gs, ax
    asm_module.bytes2(a, 0x48, 0xB8) // mov rax, L_NEXT (higher half)
    asm_module.absolute(a, L_NEXT)
    asm_module.bytes2(a, 0xFF, 0xE0) // jmp rax
    asm_module.label(a, L_NEXT)
    asm_module.bytes2(a, 0x48, 0xB8) // mov rax, GDTR64
    asm_module.imm64(a, layout.blobVirtual(layout.GDTR64))
    asm_module.bytes3(a, 0x0F, 0x01, 0x10) // lgdt [rax]
    asm_module.bytes2(a, 0x6A, 0x08) // push 8
    asm_module.bytes3(a, 0x48, 0x8D, 0x05) // lea rax, [rip + 3]
    asm_module.imm32(a, 3)
    b(a, 0x50) // push rax
    asm_module.bytes2(a, 0x48, 0xCB) // retfq
    asm_module.bytes2(a, 0x48, 0xB8) // mov rax, IDTR
    asm_module.imm64(a, layout.blobVirtual(layout.IDTR))
    asm_module.bytes3(a, 0x0F, 0x01, 0x18) // lidt [rax]
    asm_module.bytes4(a, 0x66, 0xB8, layout.TSS_SELECTOR, 0x00) // mov ax, 0x30
    asm_module.bytes3(a, 0x0F, 0x00, 0xD8) // ltr ax
    b(a, 0xB9) // mov ecx, IA32_STAR
    asm_module.imm32(a, 0xC0000081)
    asm_module.bytes2(a, 0x31, 0xC0) // xor eax, eax
    b(a, 0xBA) // mov edx, 0x00180008 (SYSRET's base 0x18, SYSCALL's 0x08)
    asm_module.imm32(a, 0x00180008)
    asm_module.bytes2(a, 0x0F, 0x30) // wrmsr
    b(a, 0xB9) // mov ecx, IA32_LSTAR
    asm_module.imm32(a, 0xC0000082)
    asm_module.bytes2(a, 0x48, 0xB8) // mov rax, L_SYSCALL
    asm_module.absolute(a, L_SYSCALL)
    asm_module.bytes3(a, 0x48, 0x89, 0xC2) // mov rdx, rax
    asm_module.bytes4(a, 0x48, 0xC1, 0xEA, 0x20) // shr rdx, 32
    asm_module.bytes2(a, 0x0F, 0x30) // wrmsr
    b(a, 0xB9) // mov ecx, IA32_FMASK
    asm_module.imm32(a, 0xC0000084)
    b(a, 0xB8) // mov eax, IF | TF | DF | AC
    asm_module.imm32(a, 0x40700)
    asm_module.bytes2(a, 0x31, 0xD2) // xor edx, edx
    asm_module.bytes2(a, 0x0F, 0x30) // wrmsr
    asm_module.bytes3(a, 0x0F, 0x20, 0xC0) // mov rax, cr0
    asm_module.bytes4(a, 0x48, 0x83, 0xE0, 0xFB) // and rax, ~4 (EM)
    asm_module.bytes4(a, 0x48, 0x83, 0xC8, 0x02) // or rax, 2 (MP)
    asm_module.bytes3(a, 0x0F, 0x22, 0xC0) // mov cr0, rax
    asm_module.bytes3(a, 0x0F, 0x20, 0xE0) // mov rax, cr4
    asm_module.bytes2(a, 0x48, 0x0D) // or rax, 0x600 (OSFXSR, OSXMMEXCPT)
    asm_module.imm32(a, 0x600)
    asm_module.bytes3(a, 0x0F, 0x22, 0xE0) // mov cr4, rax
    asm_module.bytes2(a, 0x48, 0xBC) // mov rsp, boot stack
    asm_module.imm64(a, layout.blobVirtual(layout.BOOT_STACK_TOP))
    asm_module.bytes2(a, 0x48, 0xBF) // mov rdi, arena
    asm_module.imm64(a, layout.KERNEL_VIRTUAL + layout.ARENA_PHYS)
    asm_module.bytes2(a, 0x48, 0xBE) // mov rsi, arena end
    asm_module.imm64(a, layout.KERNEL_VIRTUAL + layout.ARENA_PHYS + layout.ARENA_SIZE)
    asm_module.bytes2(a, 0x48, 0xB8) // mov rax, _start
    asm_module.imm64(a, entry)
    asm_module.bytes2(a, 0xFF, 0xD0) // call rax
    asm_module.bytes3(a, 0xFA, 0xF4, 0xEB) // cli; hlt; jmp to the hlt
    b(a, 0xFD)

    // ---- syscall ----
    asm_module.label(a, L_SYSCALL)
    asm_module.bytes3(a, 0x48, 0x85, 0xC9) // test rcx, rcx
    asm_module.bytes2(a, 0x0F, 0x88) // js L_KOP (the kernel's operations)
    asm_module.ref(a, L_KOP, 4)
    asm_module.bytes3(a, 0x48, 0x89, 0x25) // mov [user rsp], rsp
    asm_module.ref(a, L_USER_RSP, 4)
    asm_module.bytes3(a, 0x48, 0x8B, 0x25) // mov rsp, [trap stack]
    asm_module.ref(a, L_TRAP_STACK, 4)
    asm_module.bytes2(a, 0x6A, layout.USER_DATA) // push ss
    asm_module.bytes2(a, 0xFF, 0x35) // push [user rsp]
    asm_module.ref(a, L_USER_RSP, 4)
    asm_module.bytes2(a, 0x41, 0x53) // push r11 (rflags)
    asm_module.bytes2(a, 0x6A, layout.USER_CODE) // push cs
    b(a, 0x51) // push rcx (rip)
    asm_module.bytes2(a, 0x6A, 0x00) // push 0 (error)
    b(a, 0x68) // push 0x80 (vector)
    asm_module.imm32(a, layout.SYSCALL_VECTOR)
    b(a, 0xE9) // jmp L_TRAP
    asm_module.ref(a, L_TRAP, 4)

    // The kernel's operations (rdx kept; rax the result).
    asm_module.label(a, L_KOP)
    b(a, 0x52) // push rdx
    var op: usize = 1
    while op <= layout.OP_COUNT {
        asm_module.bytes4(a, 0x48, 0x83, 0xF8, op) // cmp rax, op
        b(a, 0x75) // jne skip
        asm_module.ref(a, L_SKIP + op, 1)
        if op == layout.OP_OUTB {
            asm_module.bytes3(a, 0x48, 0x89, 0xFA) // mov rdx, rdi
            asm_module.bytes3(a, 0x48, 0x89, 0xF0) // mov rax, rsi
            b(a, 0xEE) // out dx, al
        } else if op == layout.OP_INB {
            asm_module.bytes3(a, 0x48, 0x89, 0xFA) // mov rdx, rdi
            asm_module.bytes2(a, 0x31, 0xC0) // xor eax, eax
            b(a, 0xEC) // in al, dx
        } else if op == layout.OP_WAIT {
            asm_module.bytes3(a, 0xFB, 0xF4, 0xFA) // sti; hlt; cli
        } else if op == layout.OP_READ_CR2 {
            asm_module.bytes3(a, 0x0F, 0x20, 0xD0) // mov rax, cr2
        } else if op == layout.OP_WRITE_CR3 {
            asm_module.bytes3(a, 0x0F, 0x22, 0xDF) // mov cr3, rdi
        } else if op == layout.OP_READ_CR3 {
            asm_module.bytes3(a, 0x0F, 0x20, 0xD8) // mov rax, cr3
        } else if op == layout.OP_INVLPG {
            asm_module.bytes3(a, 0x0F, 0x01, 0x3F) // invlpg [rdi]
        } else if op == layout.OP_WRMSR {
            b(a, 0x51) // push rcx
            asm_module.bytes2(a, 0x89, 0xF9) // mov ecx, edi
            asm_module.bytes2(a, 0x89, 0xF0) // mov eax, esi
            asm_module.bytes3(a, 0x48, 0x89, 0xF2) // mov rdx, rsi
            asm_module.bytes4(a, 0x48, 0xC1, 0xEA, 0x20) // shr rdx, 32
            asm_module.bytes2(a, 0x0F, 0x30) // wrmsr
            b(a, 0x59) // pop rcx
        } else if op == layout.OP_ENTER_USER {
            // An IRETQ frame: ss, rsp (rsi), rflags (IF), cs, rip (rdi).
            asm_module.bytes2(a, 0x6A, layout.USER_DATA) // push ss
            b(a, 0x56) // push rsi
            b(a, 0x68) // push 0x202
            asm_module.imm32(a, 0x202)
            asm_module.bytes2(a, 0x6A, layout.USER_CODE) // push cs
            b(a, 0x57) // push rdi
            // Every register zero.
            asm_module.bytes2(a, 0x31, 0xC0)
            asm_module.bytes2(a, 0x31, 0xDB)
            asm_module.bytes2(a, 0x31, 0xC9)
            asm_module.bytes2(a, 0x31, 0xD2)
            asm_module.bytes2(a, 0x31, 0xF6)
            asm_module.bytes2(a, 0x31, 0xFF)
            asm_module.bytes2(a, 0x31, 0xED)
            asm_module.bytes3(a, 0x45, 0x31, 0xC0)
            asm_module.bytes3(a, 0x45, 0x31, 0xC9)
            asm_module.bytes3(a, 0x45, 0x31, 0xD2)
            asm_module.bytes3(a, 0x45, 0x31, 0xDB)
            asm_module.bytes3(a, 0x45, 0x31, 0xE4)
            asm_module.bytes3(a, 0x45, 0x31, 0xED)
            asm_module.bytes3(a, 0x45, 0x31, 0xF6)
            asm_module.bytes3(a, 0x45, 0x31, 0xFF)
            asm_module.bytes2(a, 0x48, 0xCF) // iretq
        } else if op == layout.OP_OUTW {
            asm_module.bytes3(a, 0x48, 0x89, 0xFA) // mov rdx, rdi
            asm_module.bytes3(a, 0x48, 0x89, 0xF0) // mov rax, rsi
            asm_module.bytes2(a, 0x66, 0xEF) // out dx, ax
        } else if op == layout.OP_OUTL {
            asm_module.bytes3(a, 0x48, 0x89, 0xFA) // mov rdx, rdi
            asm_module.bytes3(a, 0x48, 0x89, 0xF0) // mov rax, rsi
            b(a, 0xEF) // out dx, eax
        } else if op == layout.OP_INL {
            asm_module.bytes3(a, 0x48, 0x89, 0xFA) // mov rdx, rdi
            b(a, 0xED) // in eax, dx
        } else if op == layout.OP_RDTSC {
            asm_module.bytes2(a, 0x0F, 0x31) // rdtsc
            asm_module.bytes4(a, 0x48, 0xC1, 0xE2, 0x20) // shl rdx, 32
            asm_module.bytes3(a, 0x48, 0x09, 0xD0) // or rax, rdx
        }
        b(a, 0xE9) // jmp L_KRET
        asm_module.ref(a, L_KRET, 4)
        asm_module.label(a, L_SKIP + op)
        op += 1
    }
    asm_module.label(a, L_KRET)
    b(a, 0x5A) // pop rdx
    asm_module.bytes2(a, 0x41, 0x53) // push r11
    b(a, 0x9D) // popfq
    asm_module.bytes2(a, 0xFF, 0xE1) // jmp rcx

    // ---- the common trap path ----
    asm_module.label(a, L_TRAP)
    b(a, 0x50) // push rax
    b(a, 0x53) // push rbx
    b(a, 0x51) // push rcx
    b(a, 0x52) // push rdx
    b(a, 0x56) // push rsi
    b(a, 0x57) // push rdi
    b(a, 0x55) // push rbp
    var r: usize = 0
    while r < 8 {
        asm_module.bytes2(a, 0x41, 0x50 + r) // push r8 .. r15
        r += 1
    }
    asm_module.bytes3(a, 0x48, 0x89, 0xE7) // mov rdi, rsp
    // The SSE registers kept (the kernel's code uses them too).
    asm_module.bytes3(a, 0x48, 0x81, 0xEC) // sub rsp, 512
    asm_module.imm32(a, 512)
    asm_module.bytes4(a, 0x0F, 0xAE, 0x04, 0x24) // fxsave [rsp]
    asm_module.bytes2(a, 0x49, 0xBE) // mov r14, arena
    asm_module.imm64(a, layout.KERNEL_VIRTUAL + layout.ARENA_PHYS)
    asm_module.bytes2(a, 0x49, 0xBF) // mov r15, arena end
    asm_module.imm64(a, layout.KERNEL_VIRTUAL + layout.ARENA_PHYS + layout.ARENA_SIZE)
    asm_module.bytes2(a, 0x48, 0xB8) // mov rax, brix_trap
    asm_module.imm64(a, trap)
    asm_module.bytes2(a, 0xFF, 0xD0) // call rax
    asm_module.bytes4(a, 0x0F, 0xAE, 0x0C, 0x24) // fxrstor [rsp]
    asm_module.bytes3(a, 0x48, 0x81, 0xC4) // add rsp, 512
    asm_module.imm32(a, 512)
    r = 8
    while r > 0 {
        r -= 1
        asm_module.bytes2(a, 0x41, 0x58 + r) // pop r15 .. r8
    }
    b(a, 0x5D) // pop rbp
    b(a, 0x5F) // pop rdi
    b(a, 0x5E) // pop rsi
    b(a, 0x5A) // pop rdx
    b(a, 0x59) // pop rcx
    b(a, 0x5B) // pop rbx
    b(a, 0x58) // pop rax
    asm_module.bytes4(a, 0x48, 0x83, 0xC4, 0x10) // add rsp, 16
    asm_module.bytes2(a, 0x48, 0xCF) // iretq
    if a.*.at > layout.IDT { return 2 }

    // ---- the stubs ----
    vector = 0
    while vector < 256 {
        a.*.at = layout.STUBS + vector * 16
        if !hasErrorCode(vector) { asm_module.bytes2(a, 0x6A, 0x00) } // push 0
        b(a, 0x68) // push vector
        asm_module.imm32(a, vector)
        b(a, 0xE9) // jmp L_TRAP
        asm_module.ref(a, L_TRAP, 4)
        vector += 1
    }
    return if asm_module.finish(a) { 0 } else { 3 }
}
