// The other processors' trampoline (layout.Ap), assembled into the blob at
// Blob.AP; the kernel (smp.mlx) copies it to Ap.START and sends each
// processor INIT and startup IPIs with its page: real mode, then
// protected mode (a GDT of its own), PAE and the boot page tables, long
// mode, the counter of started processors up by one (the old count + 1
// is the processor's number, in ebx), then on in the blob's code64 at
// Info.NEXT (the kernel's GDT, IDT, its TSS, SYSCALL, then brix_ap).
const layout = @import("../layout.mlx")
const assemble = @import("./assemble.mlx")

const CODE = [_][]const u8{
    // ---- 16-bit, at START (CS = START / 16) ----
    ".code16",
    "cli",
    "xorw %ax, %ax",
    "movw %ax, %ds",
    "lgdtl gdtr",
    "movl %cr0, %eax",
    "orb $1, %al", // PE
    "movl %eax, %cr0",
    "ljmpl $0x08, $code32",
    // ---- 32-bit ----
    ".org AP_CODE32",
    ".code32",
    "code32:",
    "movw $0x10, %ax",
    "movw %ax, %ds",
    "movw %ax, %es",
    "movw %ax, %ss",
    "movl %cr4, %eax",
    "orl $0x620, %eax", // PAE, OSFXSR, OSXMMEXCPT
    "movl %eax, %cr4",
    "movl $PML4, %eax", // the boot PML4
    "movl %eax, %cr3",
    "movl $0xC0000080, %ecx", // EFER
    "rdmsr",
    "orl $0x101, %eax", // LME, SCE
    "wrmsr",
    "movl %cr0, %eax",
    "orl $0x80010002, %eax", // PG, WP, MP
    // ~EM, and ~CD, ~NW: INIT leaves a processor with its caches off
    // (CR0 0x60000010), and one started so runs a hundred times slower
    // than the first on a real machine (an emulator does not show it).
    "andl $0x9FFFFFFB, %eax",
    "movl %eax, %cr0", // (long mode, compatibility)
    "ljmpl $0x18, $code64",
    // ---- 64-bit ----
    ".org AP_CODE64",
    ".code64",
    "code64:",
    "movl $1, %eax",
    "lock xaddl %eax, started",
    "leal 1(%rax), %ebx", // the processor's number
    "movq INFO_NEXT, %rax",
    "jmp *%rax",
    // The GDT: null, 32-bit code (0x08), data (0x10), 64-bit code (0x18).
    ".org AP_GDT",
    "gdt:",
    ".quad 0",
    ".quad 0x00CF9A000000FFFF",
    ".quad 0x00CF92000000FFFF",
    ".quad 0x00AF9A000000FFFF",
    ".org AP_GDTR",
    "gdtr:",
    ".word 31",
    ".long gdt",
    ".org AP_STARTED",
    "started:",
    ".long 0"
}

pub fn build(image: [*]u8) -> bool {
    var t: assemble.Text = undefined
    if !t.init() { return false }
    t.set("AP_CODE32", layout.Ap.CODE32)
    t.set("AP_CODE64", layout.Ap.CODE64)
    t.set("AP_GDT", layout.Ap.GDT)
    t.set("AP_GDTR", layout.Ap.GDTR)
    t.set("AP_STARTED", layout.Ap.STARTED)
    t.set("PML4", layout.Memory.BLOB + layout.Blob.PML4)
    t.set("INFO_NEXT", layout.Memory.BLOB + layout.Blob.BOOT_INFO + layout.Info.NEXT)
    t.lines(CODE[0..CODE.length])
    const none = [_]assemble.External{}
    return assemble.place(image, layout.Blob.AP, layout.Ap.SIZE, t.text(), layout.Ap.START, none[0..none.length])
}
