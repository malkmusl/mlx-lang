// The other processors' trampoline (layout.Ap), assembled into the blob at
// Blob.AP; the kernel (smp.mlx) copies it to Ap.START and sends each
// processor INIT and startup IPIs with its page: real mode, then
// protected mode (a GDT of its own), PAE and the boot page tables, long
// mode, the counter of started processors up by one, then halted with
// interrupts off (the kernel does not run on them yet).
const layout = @import("../layout.mlx")
const Asm = @import("./asm.mlx").Asm

pub fn build(image: [*]u8) -> bool {
    const at = layout.Blob.AP
    const start = layout.Ap.START
    const pml4 = layout.Memory.BLOB + layout.Blob.PML4
    var a: Asm = undefined
    a.init(image, at + layout.Ap.CODE16, 0)
    // ---- 16-bit, at START (CS = START / 16) ----
    a.byte(0xFA) // cli
    a.bytes2(0x31, 0xC0) // xor ax, ax
    a.bytes2(0x8E, 0xD8) // mov ds, ax
    a.bytes4(0x66, 0x0F, 0x01, 0x16) // lgdt [GDTR] (a 32-bit base)
    Asm.put16(image, a.at, start + layout.Ap.GDTR)
    a.at += 2
    a.bytes3(0x0F, 0x20, 0xC0) // mov eax, cr0
    a.bytes2(0x0C, 0x01) // or al, 1 (PE)
    a.bytes3(0x0F, 0x22, 0xC0) // mov cr0, eax
    a.bytes2(0x66, 0xEA) // jmp dword 0x08:CODE32
    a.imm32(start + layout.Ap.CODE32)
    Asm.put16(image, a.at, 0x08)
    a.at += 2
    if a.at > at + layout.Ap.CODE32 { return false }
    // ---- 32-bit ----
    a.at = at + layout.Ap.CODE32
    a.bytes4(0x66, 0xB8, 0x10, 0x00) // mov ax, 0x10
    a.bytes2(0x8E, 0xD8) // mov ds, ax
    a.bytes2(0x8E, 0xC0) // mov es, ax
    a.bytes2(0x8E, 0xD0) // mov ss, ax
    a.bytes3(0x0F, 0x20, 0xE0) // mov eax, cr4
    a.byte(0x0D) // or eax, PAE | OSFXSR | OSXMMEXCPT
    a.imm32(0x620)
    a.bytes3(0x0F, 0x22, 0xE0) // mov cr4, eax
    a.byte(0xB8) // mov eax, the boot PML4
    a.imm32(pml4)
    a.bytes3(0x0F, 0x22, 0xD8) // mov cr3, eax
    a.byte(0xB9) // mov ecx, EFER
    a.imm32(0xC0000080)
    a.bytes2(0x0F, 0x32) // rdmsr
    a.byte(0x0D) // or eax, LME | SCE
    a.imm32(0x101)
    a.bytes2(0x0F, 0x30) // wrmsr
    a.bytes3(0x0F, 0x20, 0xC0) // mov eax, cr0
    a.byte(0x0D) // or eax, PG | WP | MP
    a.imm32(0x80010002)
    a.byte(0x25) // and eax, ~EM
    a.imm32(0xFFFFFFFB)
    a.bytes3(0x0F, 0x22, 0xC0) // mov cr0, eax (long mode, compatibility)
    a.byte(0xEA) // jmp 0x18:CODE64
    a.imm32(start + layout.Ap.CODE64)
    Asm.put16(image, a.at, 0x18)
    a.at += 2
    if a.at > at + layout.Ap.CODE64 { return false }
    // ---- 64-bit ----
    a.at = at + layout.Ap.CODE64
    a.bytes2(0x48, 0xB8) // mov rax, STARTED
    a.imm64(start + layout.Ap.STARTED)
    a.bytes3(0xF0, 0xFF, 0x00) // lock inc dword [rax]
    a.byte(0xFA) // cli
    a.byte(0xF4) // hlt
    a.bytes2(0xEB, 0xFC) // jmp back to the cli
    if a.at > at + layout.Ap.GDT { return false }
    // The GDT: null, 32-bit code (0x08), data (0x10), 64-bit code (0x18).
    Asm.put64(image, at + layout.Ap.GDT, 0)
    Asm.put64(image, at + layout.Ap.GDT + 8, 0x00CF9A000000FFFF)
    Asm.put64(image, at + layout.Ap.GDT + 16, 0x00CF92000000FFFF)
    Asm.put64(image, at + layout.Ap.GDT + 24, 0x00AF9A000000FFFF)
    Asm.put16(image, at + layout.Ap.GDTR, 31)
    Asm.put32(image, at + layout.Ap.GDTR + 2, start + layout.Ap.GDT)
    Asm.put32(image, at + layout.Ap.STARTED, 0)
    return true
}
