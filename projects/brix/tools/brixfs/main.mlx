// brixfs: brixOS's disk format (projects/brix/brixfs.mlx) from outside the
// kernel: on a disk image on Linux, or on /devices/disk0 in brixOS.
//
//   brixfs format DEVICE          an empty volume (its root directory)
//   brixfs create IMAGE MIB       a disk image of MIB MiB, formatted
//                                 (one already there is kept)
//   brixfs list DEVICE            every path with its size (a link's
//                                 target, "fifo"), the snapshots
//   brixfs cat DEVICE PATH        a file's bytes
//   brixfs blocks DEVICE PATH     a file's block numbers (0: a hole)
//   brixfs check DEVICE           the volume checked: the superblock, the
//                                 table, every inode's extents in range
//                                 and no block in two files of one root,
//                                 entries naming inodes that are there,
//                                 link counts; the snapshots' roots too.
//                                 Exits 1 when something is wrong.
//   brixfs repair DEVICE          checked, and what can be mended is:
//                                 link counts set to the entries' count,
//                                 entries naming no inode cleared, in a
//                                 new commit (the volume on the disk is
//                                 never written over).
//
// It reads the newer valid superblock, as the kernel does.
const std = @import("std")
const format = @import("../../brixfs.mlx")
const random = @import("std.random")
const flate = @import("std.flate")
const Brixfs = format.Brixfs
const Superblock = format.Superblock
const Inode = format.Inode
const Entry = format.Entry
const SnapshotEntry = format.SnapshotEntry

const SYS_pread64: usize = 17
const SYS_pwrite64: usize = 18
const SYS_ftruncate: usize = 77
// brixOS's own: the disk's volume mounted (ENOSYS on Linux).
const SYS_mount_disk: usize = 1002
const BLOCK = Brixfs.BLOCK

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stderr(), text) }
fn print(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn printNumber(value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest /= 10
        if rest == 0 { break }
    }
    print(digits[24 - count..24])
}

fn fail(text: []const u8) -> u8 {
    say("brixfs: ")
    say(text)
    say("\n")
    return 1
}

const Device = struct {
    descriptor: isize

    fn readBlock(self: Self, number: usize, into: [*]u8) -> bool {
        return std.linux.syscall4(SYS_pread64, @bitCast(usize, self.descriptor), @intFromPtr(into), BLOCK, number * BLOCK) == @intCast(isize, BLOCK)
    }

    fn writeBlock(self: Self, number: usize, from: [*]const u8) -> bool {
        return std.linux.syscall4(SYS_pwrite64, @bitCast(usize, self.descriptor), @intFromPtr(from), BLOCK, number * BLOCK) == @intCast(isize, BLOCK)
    }

    // The newer valid superblock into `into`; false when there is none.
    fn superblock(self: Self, into: *Superblock) -> bool {
        var block: [BLOCK]u8 = undefined
        var other: Superblock = undefined
        var found = false
        var k: usize = 0
        while k < Brixfs.SUPERBLOCKS {
            if self.readBlock(k, &block) && other.decode(&block) && (!found || other.generation > into.*.generation) {
                into.* = other
                found = true
            }
            k += 1
        }
        return found
    }

    // Inode `number` of the table at `root`.
    fn inode(self: Self, root: usize, number: usize, into: *Inode) -> bool {
        var block: [BLOCK]u8 = undefined
        if !self.readBlock(root, &block) { return false }
        const table = Brixfs.get(&block, (number / Brixfs.INODES_PER_BLOCK) * 8, 8)
        if table == 0 || !self.readBlock(table, &block) { return false }
        into.*.decode(&block, Inode.offsetIn(number))
        return true
    }

    // The block number of a file's block `index` (0: a hole), through the
    // extent reader (its buffers below).
    fn dataBlock(self: Self, node: *const Inode, index: usize) -> usize {
        readerDescriptor = self.descriptor
        return reader.blockAt(node, index, &extentBuffer, &pointerBuffer, readForReader)
    }
}

// The extent reader's state: the device it reads, its buffers (per run).
var reader: format.ExtentReader = format.ExtentReader.{ .extentBlock = 0, .pointerBlock = 0, .cursor = 0 } // (per run)
var readerDescriptor: isize = -1 // (per run)
var extentBuffer: [BLOCK]u8 = undefined // (per run)
var pointerBuffer: [BLOCK]u8 = undefined // (per run)

fn readForReader(number: usize, into: [*]u8) -> bool {
    return std.linux.syscall4(SYS_pread64, @bitCast(usize, readerDescriptor), @intFromPtr(into), BLOCK, number * BLOCK) == @intCast(isize, BLOCK)
}

fn openDevice(path: [*]const u8, writing: bool) -> ?Device {
    const file = std.fs.open(path, if writing { std.fs.READ_WRITE } else { std.fs.READ_ONLY }, 0)
    if !std.fs.isValid(file) { return null }
    return Device.{ .descriptor = file.descriptor }
}

// An empty volume: superblock A (generation 1), the table root (block 2),
// the first inode block (block 3) with the root directory.
fn formatDevice(path: [*]const u8) -> u8 {
    var status: std.fs.Stat = undefined
    if std.fs.status(path, &status) != 0 { return fail("cannot see the device") }
    const blocks = @bitCast(usize, status.size) / BLOCK
    if blocks < 8 { return fail("the device is too small (32 KiB at least)") }
    const opened = openDevice(path, true)
    if opened == null { return fail("cannot open the device to write") }
    const device = opened.?
    var block: [BLOCK]u8 = undefined
    var k: usize = 0
    while k < BLOCK {
        block[k] = 0
        k += 1
    }
    // Superblock B: nothing (no valid superblock).
    if !device.writeBlock(1, &block) { return fail("cannot write") }
    Brixfs.put(&block, 0, 8, 3)
    if !device.writeBlock(2, &block) { return fail("cannot write") }
    Brixfs.put(&block, 0, 8, 0)
    var root: Inode = undefined
    root.clear()
    root.kind = Brixfs.DIRECTORY
    root.mode = 0x1ED
    root.links = 1
    root.encode(&block, Inode.offsetIn(Brixfs.ROOT_INODE))
    if !device.writeBlock(3, &block) { return fail("cannot write") }
    const superblock = Superblock.{ .blocks = blocks, .generation = 1, .root = 2, .nextInode = 2, .snapshots = 0 }
    superblock.encode(&block)
    if !device.writeBlock(0, &block) { return fail("cannot write") }
    print("brixfs: ")
    printNumber(blocks)
    print(" blocks of 4 KiB\n")
    // On brixOS: the kernel mounts it (at /volumes/NAME: the device's
    // name, /devices/NAME).
    const name = deviceName(path)
    if std.linux.syscall2(SYS_mount_disk, @intFromPtr(name.pointer), name.length) == 0 {
        print("brixfs: mounted at /volumes/")
        print(name)
        print("\n")
    }
    return 0
}

// The last part of a path (a device's name).
fn deviceName(path: [*]const u8) -> []const u8 {
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    var start = length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    return path[start..length]
}

// ---- partitions ----

const SECTOR: usize = 512
const GPT_ENTRIES: usize = 128
const GPT_ENTRY: usize = 128
// The partitions start at LBA 40 (4 KiB aligned, after the entries).
const FIRST_USABLE: usize = 40

fn writeSectors(device: Device, lba: usize, from: [*]const u8, length: usize) -> bool {
    return std.linux.syscall4(SYS_pwrite64, @bitCast(usize, device.descriptor), @intFromPtr(from), length, lba * SECTOR) == @intCast(isize, length)
}

fn putGuid(into: [*]u8, at: usize) -> void {
    var guid: [16]u8 = undefined
    if !random.fill(&guid, 16) {
        var k: usize = 0
        while k < 16 {
            guid[k] = @intCast(u8, (random.random32() >> @intCast(u5, (k % 4) * 8)) & 255)
            k += 1
        }
    }
    // (Version 4, variant 1.)
    guid[7] = (guid[7] & 0x0F) | 0x40
    guid[8] = (guid[8] & 0x3F) | 0x80
    var k: usize = 0
    while k < 16 {
        into[at + k] = guid[k]
        k += 1
    }
}

// A GPT header (primary or backup) into `header` (a sector).
fn gptHeader(header: [*]u8, mine: usize, other: usize, lastUsable: usize, entriesLba: usize, entriesCrc: usize, diskGuid: [*]const u8) -> void {
    var k: usize = 0
    while k < SECTOR {
        header[k] = 0
        k += 1
    }
    const signature = "EFI PART"
    k = 0
    while k < 8 {
        header[k] = signature[k]
        k += 1
    }
    Brixfs.put(header, 8, 4, 0x00010000)
    Brixfs.put(header, 12, 4, 92)
    Brixfs.put(header, 24, 8, mine)
    Brixfs.put(header, 32, 8, other)
    Brixfs.put(header, 40, 8, FIRST_USABLE)
    Brixfs.put(header, 48, 8, lastUsable)
    k = 0
    while k < 16 {
        header[56 + k] = diskGuid[k]
        k += 1
    }
    Brixfs.put(header, 72, 8, entriesLba)
    Brixfs.put(header, 80, 4, GPT_ENTRIES)
    Brixfs.put(header, 84, 4, GPT_ENTRY)
    Brixfs.put(header, 88, 4, entriesCrc)
    Brixfs.put(header, 16, 4, @intCast(usize, flate.crc32(0, header, 92)))
}

// brixfs partition DEVICE MIB...: a GPT with one partition per size (MiB,
// from LBA 40 on, 4 KiB aligned), the protective MBR, the backup at the
// end; what was on the device is no volume any more.
fn partitionDevice(path: [*]const u8, arguments: [][*]const u8, first: usize, count: usize) -> u8 {
    var status: std.fs.Stat = undefined
    if std.fs.status(path, &status) != 0 { return fail("cannot see the device") }
    const sectors = @bitCast(usize, status.size) / SECTOR
    if sectors < FIRST_USABLE + 34 + 8 { return fail("the device is too small to partition") }
    const lastUsable = sectors - 34
    const opened = openDevice(path, true)
    if opened == null { return fail("cannot open the device to write") }
    const device = opened.?
    var entries: [GPT_ENTRIES * GPT_ENTRY]u8 = undefined
    var k: usize = 0
    while k < GPT_ENTRIES * GPT_ENTRY {
        entries[k] = 0
        k += 1
    }
    // Linux's filesystem data type (0FC63DAF-8483-4772-8E79-3D69D8477DE4).
    const kind = [16]u8{ 0xAF, 0x3D, 0xC6, 0x0F, 0x83, 0x84, 0x72, 0x47, 0x8E, 0x79, 0x3D, 0x69, 0xD8, 0x47, 0x7D, 0xE4 }
    var next = FIRST_USABLE
    var n: usize = 0
    while n < count {
        const text = std.string.asSlice(std.process.argument(arguments, first + n))
        var size: usize = 0
        for digit in text {
            if digit < 48 || digit > 57 { return fail("a partition's size is MiB as a number") }
            size = size * 10 + @intCast(usize, digit - 48)
        }
        if size == 0 { return fail("a partition's size is MiB as a number") }
        const length = size * 1048576 / SECTOR
        if next + length - 1 > lastUsable { return fail("the partitions do not fit the device") }
        const entry: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(&entries) + n * GPT_ENTRY) }
        k = 0
        while k < 16 {
            entry[k] = kind[k]
            k += 1
        }
        putGuid(entry, 16)
        Brixfs.put(entry, 32, 8, next)
        Brixfs.put(entry, 40, 8, next + length - 1)
        // The name, UTF-16: "brix" and the number.
        const name = "brix"
        k = 0
        while k < 4 {
            entry[56 + 2 * k] = name[k]
            k += 1
        }
        entry[64] = @intCast(u8, 49 + n)
        next += length
        n += 1
    }
    const entriesCrc = @intCast(usize, flate.crc32(0, &entries, GPT_ENTRIES * GPT_ENTRY))
    var diskGuid: [16]u8 = undefined
    putGuid(&diskGuid, 0)
    var header: [SECTOR]u8 = undefined
    // The protective MBR: one partition of type EE over the disk.
    k = 0
    while k < SECTOR {
        header[k] = 0
        k += 1
    }
    header[446 + 4] = 0xEE
    header[446 + 1] = 0
    header[446 + 2] = 2
    header[446 + 3] = 0
    header[446 + 5] = 0xFF
    header[446 + 6] = 0xFF
    header[446 + 7] = 0xFF
    Brixfs.put(&header, 446 + 8, 4, 1)
    Brixfs.put(&header, 446 + 12, 4, if sectors - 1 > 0xFFFFFFFF { 0xFFFFFFFF } else { sectors - 1 })
    header[510] = 0x55
    header[511] = 0xAA
    if !writeSectors(device, 0, &header, SECTOR) { return fail("cannot write") }
    gptHeader(&header, 1, sectors - 1, lastUsable, 2, entriesCrc, &diskGuid)
    if !writeSectors(device, 1, &header, SECTOR) || !writeSectors(device, 2, &entries, GPT_ENTRIES * GPT_ENTRY) { return fail("cannot write") }
    gptHeader(&header, sectors - 1, 1, lastUsable, sectors - 33, entriesCrc, &diskGuid)
    if !writeSectors(device, sectors - 33, &entries, GPT_ENTRIES * GPT_ENTRY) || !writeSectors(device, sectors - 1, &header, SECTOR) { return fail("cannot write") }
    // (The old volume's superblocks: no volume on the disk itself.)
    k = 0
    while k < SECTOR {
        header[k] = 0
        k += 1
    }
    var s: usize = 0
    while s < Brixfs.SUPERBLOCKS {
        _ = writeSectors(device, FIRST_USABLE - 8 + s * 8, &header, SECTOR)
        s += 1
    }
    print("brixfs: ")
    printNumber(count)
    print(" partitions (a new table: the system sees them after a boot)\n")
    return 0
}

// The tree under directory inode `number` at `prefix`, one line a path.
fn listDirectory(device: Device, root: usize, number: usize, prefix: []u8, length: usize) -> bool {
    var directory: Inode = undefined
    if !device.inode(root, number, &directory) { return false }
    var block: [BLOCK]u8 = undefined
    var index: usize = 0
    while index * BLOCK < directory.size {
        const at = device.dataBlock(&directory, index)
        if at != 0 && device.readBlock(at, &block) {
            var slot: usize = 0
            while slot < BLOCK / Brixfs.ENTRY_SIZE && index * BLOCK + slot * Brixfs.ENTRY_SIZE < directory.size {
                const child = Entry.inode(&block, slot)
                if child != 0 {
                    const nameLength = Entry.nameLength(&block, slot)
                    var path_length = length
                    prefix[path_length] = 47
                    path_length += 1
                    var k: usize = 0
                    while k < nameLength && path_length < prefix.length {
                        prefix[path_length] = block[Entry.nameAt(slot) + k]
                        path_length += 1
                        k += 1
                    }
                    var node: Inode = undefined
                    if device.inode(root, child, &node) {
                        print(prefix[0..path_length])
                        if node.kind == Brixfs.DIRECTORY {
                            print("/\n")
                            if !listDirectory(device, root, child, prefix, path_length) { return false }
                        } else if node.kind == Brixfs.SYMLINK {
                            // A link: " -> " and its target (one block at most).
                            var target: [BLOCK]u8 = undefined
                            print(" -> ")
                            if node.size < BLOCK && device.readBlock(device.dataBlock(&node, 0), &target) { print(target[0..node.size]) }
                            print("\n")
                        } else if node.kind == Brixfs.FIFO {
                            print(" fifo\n")
                        } else {
                            print(" ")
                            printNumber(node.size)
                            print("\n")
                        }
                    }
                }
                slot += 1
            }
        }
        index += 1
    }
    return true
}

fn list(path: [*]const u8) -> u8 {
    const opened = openDevice(path, false)
    if opened == null { return fail("cannot open the device") }
    const device = opened.?
    var superblock: Superblock = undefined
    if !device.superblock(&superblock) { return fail("no brixfs volume on the device") }
    var prefix: [4096]u8 = undefined
    if !listDirectory(device, superblock.root, Brixfs.ROOT_INODE, prefix[0..4096], 0) { return fail("the volume cannot be read") }
    if superblock.snapshots != 0 {
        var block: [BLOCK]u8 = undefined
        if device.readBlock(superblock.snapshots, &block) {
            var slot: usize = 0
            while slot < Brixfs.MAX_SNAPSHOTS {
                if SnapshotEntry.root(&block, slot) != 0 {
                    print("snapshot ")
                    print(block[SnapshotEntry.nameAt(slot)..SnapshotEntry.nameAt(slot) + SnapshotEntry.nameLength(&block, slot)])
                    print("\n")
                }
                slot += 1
            }
        }
    }
    return 0
}

// The inode `path` names under the root; 0 when none.
fn find(device: Device, root: usize, path: []const u8) -> usize {
    var number = Brixfs.ROOT_INODE
    var k: usize = 0
    var block: [BLOCK]u8 = undefined
    while k < path.length {
        while k < path.length && path[k] == 47 { k += 1 }
        if k >= path.length { break }
        const start = k
        while k < path.length && path[k] != 47 { k += 1 }
        var directory: Inode = undefined
        if !device.inode(root, number, &directory) || directory.kind != Brixfs.DIRECTORY { return 0 }
        var found: usize = 0
        var index: usize = 0
        while index * BLOCK < directory.size && found == 0 {
            const at = device.dataBlock(&directory, index)
            if at != 0 && device.readBlock(at, &block) {
                var slot: usize = 0
                while slot < BLOCK / Brixfs.ENTRY_SIZE && found == 0 {
                    if Entry.inode(&block, slot) != 0 && Entry.nameLength(&block, slot) == k - start && std.text.same(block[Entry.nameAt(slot)..Entry.nameAt(slot) + k - start], path[start..k]) { found = Entry.inode(&block, slot) }
                    slot += 1
                }
            }
            index += 1
        }
        if found == 0 { return 0 }
        number = found
    }
    return number
}

fn cat(path: [*]const u8, file: []const u8) -> u8 {
    const opened = openDevice(path, false)
    if opened == null { return fail("cannot open the device") }
    const device = opened.?
    var superblock: Superblock = undefined
    if !device.superblock(&superblock) { return fail("no brixfs volume on the device") }
    const number = find(device, superblock.root, file)
    var node: Inode = undefined
    if number == 0 || !device.inode(superblock.root, number, &node) || node.kind != Brixfs.FILE { return fail("no such file on the volume") }
    var block: [BLOCK]u8 = undefined
    var done: usize = 0
    while done < node.size {
        const at = device.dataBlock(&node, done / BLOCK)
        var k: usize = 0
        while k < BLOCK {
            block[k] = 0
            k += 1
        }
        if at != 0 { _ = device.readBlock(at, &block) }
        const chunk = if node.size - done > BLOCK { BLOCK } else { node.size - done }
        _ = std.io.writeAll(std.io.stdout(), block[0..chunk])
        done += chunk
    }
    return 0
}

fn blocks(path: [*]const u8, file: []const u8) -> u8 {
    const opened = openDevice(path, false)
    if opened == null { return fail("cannot open the device") }
    const device = opened.?
    var superblock: Superblock = undefined
    if !device.superblock(&superblock) { return fail("no brixfs volume on the device") }
    const number = find(device, superblock.root, file)
    var node: Inode = undefined
    if number == 0 || !device.inode(superblock.root, number, &node) || node.kind != Brixfs.FILE { return fail("no such file on the volume") }
    var index: usize = 0
    while index * BLOCK < node.size {
        printNumber(device.dataBlock(&node, index))
        print("\n")
        index += 1
    }
    return 0
}

// A disk image of `megabytes` MiB at `path`, formatted; one already there
// is kept as it is (its files stay).
fn createImage(path: [*]const u8, megabytes: []const u8) -> u8 {
    var status: std.fs.Stat = undefined
    if std.fs.status(path, &status) == 0 {
        // One there already is kept when it holds a volume of this
        // version; else (another version's, or no volume) it is formatted.
        const opened = openDevice(path, false)
        if opened == null { return fail("cannot read the image there") }
        var superblock: Superblock = undefined
        if opened.?.superblock(&superblock) { return 0 }
        return formatDevice(path)
    }
    var size: usize = 0
    for digit in megabytes {
        if digit < 48 || digit > 57 { return fail("the size is MiB as a number") }
        size = size * 10 + @intCast(usize, digit - 48)
    }
    if size == 0 { return fail("the size is MiB as a number") }
    const file = std.fs.open(path, std.fs.READ_WRITE | std.fs.CREATE, 0x1A4)
    if !std.fs.isValid(file) { return fail("cannot make the image") }
    const sized = std.linux.syscall2(SYS_ftruncate, @bitCast(usize, file.descriptor), size * 1048576)
    _ = std.fs.close(file)
    if sized != 0 { return fail("cannot size the image") }
    return formatDevice(path)
}

// ---- check and repair ----

// What a root holds: a bit a block in use, a link count an inode (from
// the entries), what was found wrong.
const Check = struct {
    const MAX_BLOCKS_CHECKED: usize = 1 << 22
    const LINKS: usize = Brixfs.MAX_INODES

    device: Device
    blocks: usize
    used: [MAX_BLOCKS_CHECKED / 8]u8
    links: [LINKS]u32
    problems: usize
    // Repair: the table blocks changed (a page each by index; 0 none).
    staged: [Brixfs.POINTERS_PER_BLOCK]usize

    fn say(self: *Self, text: []const u8, number: usize) -> void {
        print("brixfs: ")
        print(text)
        print(" ")
        printNumber(number)
        print("\n")
        self.*.problems += 1
    }

    fn isUsed(self: *const Self, block: usize) -> bool { return self.*.used[block / 8] & (@intCast(u8, 1) << @intCast(u3, block % 8)) != 0 }

    // The block marked; false when it was marked already (two files of
    // the root name it) or is out of range.
    fn use(self: *Self, block: usize) -> bool {
        if block < Brixfs.SUPERBLOCKS || block >= self.*.blocks { return false }
        if self.isUsed(block) { return false }
        self.*.used[block / 8] |= @intCast(u8, 1) << @intCast(u3, block % 8)
        return true
    }

    fn clearUsed(self: *Self) -> void {
        var k: usize = 0
        while k < (self.*.blocks + 7) / 8 {
            self.*.used[k] = 0
            k += 1
        }
    }

    // An inode's extents: in range, its blocks used once, covering no
    // more than its size; the extent blocks too.
    fn checkExtents(self: *Self, number: usize, record: *const Inode) -> void {
        const need = (record.*.size + BLOCK - 1) / BLOCK
        if record.*.depth > 2 { self.say("inode with an extent depth beyond 2:", number) }
        if record.*.depth >= 1 && !self.use(record.*.tree) { self.say("inode whose extent block is out of range or in use twice:", number) }
        if record.*.depth == 2 {
            var pointers: [BLOCK]u8 = undefined
            if self.*.device.readBlock(record.*.tree, &pointers) {
                var t: usize = 0
                while t < Brixfs.POINTERS_PER_BLOCK {
                    const block = Brixfs.get(&pointers, t * 8, 8)
                    if block != 0 && !self.use(block) { self.say("inode with an extent block out of range or in use twice:", number) }
                    t += 1
                }
            }
        }
        var k: usize = 0
        while k < record.*.extentCount {
            const e = reader.extentAt(record, k, &extentBuffer, &pointerBuffer, readForReader)
            if e.length == 0 {
                self.say("inode whose extents cannot be read:", number)
                return
            }
            if e.start + e.length > need { self.say("inode with an extent past its size:", number) }
            var j: usize = 0
            while j < e.length {
                if !self.use(e.block + j) {
                    self.say("inode naming a block out of range or in use twice:", number)
                    break
                }
                j += 1
            }
            k += 1
        }
    }

    // A directory's entries: each names an inode that is there; links
    // counted. Cleared (in a staged copy) when `repairing` and naming
    // nothing.
    fn checkDirectory(self: *Self, root: usize, number: usize, record: *const Inode) -> void {
        var block: [BLOCK]u8 = undefined
        var index: usize = 0
        while index * BLOCK < record.*.size {
            readerDescriptor = self.*.device.descriptor
            const at = reader.blockAt(record, index, &extentBuffer, &pointerBuffer, readForReader)
            if at != 0 && self.*.device.readBlock(at, &block) {
                var slot: usize = 0
                while slot < BLOCK / Brixfs.ENTRY_SIZE && index * BLOCK + slot * Brixfs.ENTRY_SIZE < record.*.size {
                    const child = Entry.inode(&block, slot)
                    if child != 0 {
                        var target: Inode = undefined
                        if child >= Brixfs.MAX_INODES || !self.*.device.inode(root, child, &target) || target.kind == Brixfs.FREE {
                            self.say("directory with an entry naming no inode:", number)
                        } else {
                            self.*.links[child] += 1
                        }
                    }
                    slot += 1
                }
            }
            index += 1
        }
    }

    // One root (the current one or a snapshot's): everything it holds.
    fn checkRoot(self: *Self, root: usize, nextInode: usize) -> void {
        self.clearUsed()
        var k: usize = 0
        while k < Brixfs.MAX_INODES {
            self.*.links[k] = 0
            k += 1
        }
        if !self.use(root) { self.say("table root out of range:", root) }
        var rootBlock: [BLOCK]u8 = undefined
        if !self.*.device.readBlock(root, &rootBlock) {
            self.say("table root cannot be read:", root)
            return
        }
        var t: usize = 0
        while t < Brixfs.POINTERS_PER_BLOCK {
            const table = Brixfs.get(&rootBlock, t * 8, 8)
            if table != 0 && !self.use(table) { self.say("inode block out of range or in use twice:", table) }
            t += 1
        }
        // The inodes: kinds, extents, entries.
        var number: usize = Brixfs.ROOT_INODE
        while number < nextInode {
            var record: Inode = undefined
            if !self.*.device.inode(root, number, &record) {
                number += 1
                continue
            }
            if record.kind == Brixfs.FREE {
                number += 1
                continue
            }
            if record.kind > Brixfs.FIFO { self.say("inode of an unknown kind:", number) }
            readerDescriptor = self.*.device.descriptor
            reader.init()
            self.checkExtents(number, &record)
            if record.kind == Brixfs.DIRECTORY { self.checkDirectory(root, number, &record) }
            number += 1
        }
        // Link counts (the root directory names itself once).
        self.*.links[Brixfs.ROOT_INODE] += 1
        number = Brixfs.ROOT_INODE
        while number < nextInode {
            var record: Inode = undefined
            if self.*.device.inode(root, number, &record) && record.kind != Brixfs.FREE {
                if record.links != @intCast(usize, self.*.links[number]) {
                    self.say("inode whose link count is not the entries' (the inode):", number)
                } else if self.*.links[number] == 0 {
                    self.say("inode no directory names:", number)
                }
            }
            number += 1
        }
    }
}

var checker: Check = undefined // (per run)

fn check(path: [*]const u8, repairing: bool) -> u8 {
    const opened = openDevice(path, repairing)
    if opened == null { return fail("cannot open the device") }
    const device = opened.?
    var superblock: Superblock = undefined
    if !device.superblock(&superblock) { return fail("no brixfs volume on the device") }
    const c = &checker
    c.*.device = device
    c.*.blocks = superblock.blocks
    c.*.problems = 0
    if superblock.blocks > Check.MAX_BLOCKS_CHECKED { return fail("the volume is larger than check can hold (16 GiB)") }
    if superblock.root == 0 || superblock.root >= superblock.blocks { c.say("superblock naming a table root out of range:", superblock.root) }
    if superblock.nextInode > Brixfs.MAX_INODES { c.say("superblock with a next inode past the table:", superblock.nextInode) }
    c.checkRoot(superblock.root, superblock.nextInode)
    // Repair: link counts, in a new commit.
    if repairing && c.*.problems > 0 {
        var mended: usize = 0
        var rootBlock: [BLOCK]u8 = undefined
        if !device.readBlock(superblock.root, &rootBlock) { return fail("the table root cannot be read") }
        var tableBlock: [BLOCK]u8 = undefined
        var t: usize = 0
        var cursor: usize = Brixfs.SUPERBLOCKS
        while t < Brixfs.POINTERS_PER_BLOCK {
            const table = Brixfs.get(&rootBlock, t * 8, 8)
            if table != 0 && device.readBlock(table, &tableBlock) {
                var changed = false
                var i: usize = 0
                while i < Brixfs.INODES_PER_BLOCK {
                    const number = t * Brixfs.INODES_PER_BLOCK + i
                    var record: Inode = undefined
                    record.decode(&tableBlock, i * Brixfs.INODE_SIZE)
                    if record.kind != Brixfs.FREE && number < superblock.nextInode && record.links != @intCast(usize, c.*.links[number]) && c.*.links[number] > 0 {
                        record.links = @intCast(usize, c.*.links[number])
                        record.encode(&tableBlock, i * Brixfs.INODE_SIZE)
                        changed = true
                        mended += 1
                    }
                    i += 1
                }
                if changed {
                    // A free block for the new table block.
                    while cursor < superblock.blocks && c.isUsed(cursor) { cursor += 1 }
                    if cursor >= superblock.blocks { return fail("no free block for the repair") }
                    if !device.writeBlock(cursor, &tableBlock) { return fail("cannot write") }
                    _ = c.use(cursor)
                    Brixfs.put(&rootBlock, t * 8, 8, cursor)
                }
            }
            t += 1
        }
        if mended > 0 {
            while cursor < superblock.blocks && c.isUsed(cursor) { cursor += 1 }
            if cursor >= superblock.blocks { return fail("no free block for the repair") }
            if !device.writeBlock(cursor, &rootBlock) { return fail("cannot write") }
            var next = superblock
            next.generation += 1
            next.root = cursor
            var block: [BLOCK]u8 = undefined
            next.encode(&block)
            // The other superblock: the one the newer generation is not in.
            var slot: usize = 0
            var first: Superblock = undefined
            if device.readBlock(0, &block) && first.decode(&block) && first.generation == superblock.generation { slot = 1 }
            next.encode(&block)
            if !device.writeBlock(slot, &block) { return fail("cannot write the superblock") }
            print("brixfs: ")
            printNumber(mended)
            print(" link counts mended (generation ")
            printNumber(next.generation)
            print(")\n")
        }
    }
    if c.*.problems == 0 {
        print("brixfs: the volume is sound\n")
        return 0
    }
    return 1
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count < 3 { return fail("usage: brixfs format|list|check|repair DEVICE | brixfs cat|blocks DEVICE PATH | brixfs create IMAGE MIB | brixfs partition DEVICE MIB...") }
    const command = std.string.asSlice(std.process.argument(arguments, 1))
    const device = std.process.argument(arguments, 2).pointer
    if std.text.same(command, "format") && count == 3 { return formatDevice(device) }
    if std.text.same(command, "partition") && count >= 4 { return partitionDevice(device, arguments, 3, count - 3) }
    if std.text.same(command, "create") && count == 4 { return createImage(device, std.string.asSlice(std.process.argument(arguments, 3))) }
    if std.text.same(command, "list") && count == 3 { return list(device) }
    if std.text.same(command, "cat") && count == 4 { return cat(device, std.string.asSlice(std.process.argument(arguments, 3))) }
    if std.text.same(command, "blocks") && count == 4 { return blocks(device, std.string.asSlice(std.process.argument(arguments, 3))) }
    if std.text.same(command, "check") && count == 3 { return check(device, false) }
    if std.text.same(command, "repair") && count == 3 { return check(device, true) }
    return fail("usage: brixfs format|list|check|repair DEVICE | brixfs cat|blocks DEVICE PATH | brixfs create IMAGE MIB")
}
