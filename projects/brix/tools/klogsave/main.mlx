// klogsave: write the kernel log (/devices/klog) to boot.log on every
// mounted brixfs volume, so the hardware bring-up messages survive the
// boot and are reachable from the host (with the brixfs reader/driver)
// even without a terminal. A oneshot the init runs at boot. Read-only
// volumes (an ext2 mount) and the boot archive are skipped; writing fails
// cleanly there.
//
// The log of the boot before is kept beside it as boot.previous.log (the
// boot.log that is there is renamed before the new one is written): after
// a boot that ended with a dark screen (a trial of the GPU driver's mode
// setting, say) the next boot's boot.previous.log says what the kernel
// said then. Run again in the same boot (by hand, to save what the kernel
// said since), klogsave writes boot.log anew and leaves boot.previous.log
// the boot before's.
//
// Beside the log goes gpu.rom, when the graphics driver read the card's
// video BIOS ROM at boot (/devices/gpurom): the ROM's bytes as they are,
// to be fetched from the volume and sent when the network is not there
// (logserve gives the same bytes as /gpu.rom when it is).
const std = @import("std")
const crash = @import("std.crash")
const brix = std.os.brix

const CAPACITY: usize = 1 << 18 // 256 KiB, the console's log buffer size

var logBuffer: [CAPACITY]u8 = undefined // (per run)
var pathBuffer: [256]u8 = undefined // (per run)
var previousBuffer: [256]u8 = undefined // (per run)
var oldBuffer: [4096]u8 = undefined // (per run)
// A video BIOS ROM is 255 blocks of 512 bytes at most.
const ROM_CAPACITY: usize = 1 << 17
var romBuffer: [ROM_CAPACITY]u8 = undefined // (per run)

// The graphics card's ROM as the kernel read it into romBuffer; how many
// bytes (0: the kernel has none).
fn readRom() -> usize {
    const file = std.fs.open("/devices/gpurom\x00".pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return 0 }
    var total: usize = 0
    while total < ROM_CAPACITY {
        const into = unsafe { @ptrFromInt([*]u8, @intFromPtr(&romBuffer) + total) }
        const got = std.fs.read(file, into, ROM_CAPACITY - total)
        if got <= 0 { break }
        total += @intCast(usize, got)
    }
    _ = std.fs.close(file)
    return total
}

// The whole kernel log into logBuffer; how many bytes.
fn readLog() -> usize {
    const file = std.fs.open("/devices/klog\x00".pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return 0 }
    var total: usize = 0
    while total < CAPACITY {
        const into = unsafe { @ptrFromInt([*]u8, @intFromPtr(&logBuffer) + total) }
        const got = std.fs.read(file, into, CAPACITY - total)
        if got <= 0 { break }
        total += @intCast(usize, got)
    }
    _ = std.fs.close(file)
    return total
}

fn same(name: std.string.String, text: []const u8) -> bool {
    if name.length != text.length { return false }
    var k: usize = 0
    while k < text.length {
        if name.pointer[k] != text[k] { return false }
        k += 1
    }
    return true
}

// Whether the boot.log at `path` is one to keep as the boot before's: it
// has something in it and is not this boot's own. The kernel's log only
// grows, so a boot.log written earlier in this boot is the beginning of
// the log as it is now (its first `length` bytes are in logBuffer);
// another boot's is longer than that or differs somewhere (the volume's
// generation that the kernel says when it mounts it, the times it
// measures).
fn worthKeeping(path: [*]const u8, length: usize) -> bool {
    const file = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return false }
    var at: usize = 0
    var empty = true
    var own = true
    while own {
        const into: [*]u8 = &oldBuffer
        const got = std.fs.read(file, into, 4096)
        if got <= 0 { break }
        const count = @intCast(usize, got)
        empty = false
        if at + count > length {
            own = false
        } else {
            var k: usize = 0
            while k < count {
                if oldBuffer[k] != logBuffer[at + k] { own = false }
                k += 1
            }
            at += count
        }
    }
    _ = std.fs.close(file)
    return !empty && !own
}

// Builds "/volumes/NAME" and `suffix` ("/boot.log") into `into`
// (NUL-terminated); its length, or 0 when it would not fit.
fn buildPath(into: *[256]u8, name: std.string.String, suffix: []const u8) -> usize {
    const prefix = "/volumes/"
    if prefix.length + name.length + suffix.length + 1 > 256 { return 0 }
    var at: usize = 0
    var k: usize = 0
    while k < prefix.length {
        into.*[at] = prefix[k]
        at += 1
        k += 1
    }
    k = 0
    while k < name.length {
        into.*[at] = name.pointer[k]
        at += 1
        k += 1
    }
    k = 0
    while k < suffix.length {
        into.*[at] = suffix[k]
        at += 1
        k += 1
    }
    into.*[at] = 0
    return at
}

pub fn main(arguments: [][*]const u8) -> u8 {
    crash.install()
    _ = arguments
    const length = readLog()
    if length == 0 {
        _ = std.io.print("klogsave: the kernel log is empty\n")
        return 1
    }
    const handle = std.fs.open("/volumes\x00".pointer, std.linux.O_DIRECTORY, 0).descriptor
    if handle < 0 {
        _ = std.io.print("klogsave: no /volumes\n")
        return 1
    }
    var buffer: [4096]u8 = undefined
    const bytes: [*]u8 = &buffer
    var reader = std.fs.entries(std.fs.File.{ .descriptor = handle }, bytes, 4096)
    var entry: std.fs.Entry = undefined
    var written: usize = 0
    const romLength = readRom()
    while std.fs.nextEntry(&reader, &entry) {
        const name = entry.name
        if std.fs.isDotName(name) || same(name, "boot") { continue }
        const pathLength = buildPath(&pathBuffer, name, "/boot.log")
        const previousLength = buildPath(&previousBuffer, name, "/boot.previous.log")
        if pathLength == 0 || previousLength == 0 { continue }
        const path: [*]const u8 = &pathBuffer
        const source: [*]const u8 = &logBuffer
        // The boot before's log kept (node_rename: what the new name
        // named is replaced; nothing to keep on a volume without a
        // boot.log or with this boot's own, nothing kept on one that
        // cannot be written).
        const kept = worthKeeping(path, length) && brix.rename(0, pathBuffer[0..pathLength], 0, previousBuffer[0..previousLength]) >= 0
        const out = std.fs.open(path, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 0x1A4)
        if !std.fs.isValid(out) { continue }
        if std.fs.writeAllBytes(out, source, length) {
            _ = std.fs.syncFile(out, false)
            written += 1
            _ = std.io.print("klogsave: wrote ")
            _ = std.io.printString(std.string.fromParts(path, pathLength))
            _ = std.io.print(if kept { " (the boot before's log is boot.previous.log beside it)\n" } else { "\n" })
        }
        _ = std.fs.close(out)
        // The card's ROM beside it (the path's buffer is the log's no
        // more).
        const romPath = buildPath(&pathBuffer, name, "/gpu.rom")
        if romLength != 0 && romPath != 0 {
            const rom = std.fs.open(path, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 0x1A4)
            if std.fs.isValid(rom) {
                const bytes: [*]const u8 = &romBuffer
                if std.fs.writeAllBytes(rom, bytes, romLength) {
                    _ = std.fs.syncFile(rom, false)
                    _ = std.io.print("klogsave: wrote ")
                    _ = std.io.printString(std.string.fromParts(path, romPath))
                    _ = std.io.print(" (the graphics card's video BIOS ROM as the kernel read it)\n")
                }
                _ = std.fs.close(rom)
            }
        }
    }
    _ = std.fs.close(std.fs.File.{ .descriptor = handle })
    if written == 0 {
        _ = std.io.print("klogsave: no writable brixfs volume\n")
        return 1
    }
    return 0
}
