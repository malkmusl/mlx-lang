// objects: brixOS's own processes, nodes, streams and channels
// (std.os.brix), a line each, for tools/check_brix.sh: a file made,
// written and read by position, a directory made and listed, a link and
// a FIFO; a stream; a channel carrying bytes and a handle; a branch that
// exits, one ended by an event; a program spawned with exactly the
// handles given. No Linux numbers but the descriptor 1 a program gets,
// and brixOS's own layout (/temporary; /tmp is the Linux layer's).
const std = @import("std")
const brix = std.os.brix

fn say(text: []const u8) -> void { _ = brix.write(brix.ofDescriptor(1), text, brix.STREAM) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn line(text: []const u8, value: usize) -> void {
    say(text)
    say(" ")
    number(value)
    say("\n")
}

fn status(result: isize) -> usize { return if result < 0 { @bitCast(usize, -result) } else { 0 } }

fn handle(result: isize) -> u32 { return if result < 0 { 0 } else { @intCast(u32, result) } }

// Waits until the process ended (the state, not polling).
fn awaitEnd(process: u32) -> void {
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = process, .want = brix.State.ENDED, .seen = 0, .reserved = 0 } }
    _ = brix.wait(items[0..1], brix.FOREVER)
}

pub fn main() -> u8 {
    say("objects\n")
    // Nodes.
    _ = brix.remove(0, "/temporary/objects")
    line("make a directory", status(brix.make(0, "/temporary/objects", brix.NodeKind.DIRECTORY, 0x1ED, "")))
    const directory = handle(brix.open(0, "/temporary/objects", brix.Open.READ, 0))
    const file = handle(brix.open(directory, "a.txt", brix.Open.READ | brix.Open.WRITE | brix.Open.CREATE, 0x1A4))
    _ = brix.write(file, "native file", 0)
    var info = brix.NodeInfo.{ .kind = 0, .mode = 0, .links = 0, .reserved = 0, .size = 0, .modified = 0, .number = 0 }
    _ = brix.nodeInfo(file, &info)
    line("file kind", @intCast(usize, info.kind))
    line("file size", @intCast(usize, info.size))
    line("open it again exclusively (exists)", status(brix.open(directory, "a.txt", brix.Open.READ | brix.Open.CREATE | brix.Open.EXCLUSIVE, 0x1A4)))
    line("a link", status(brix.make(directory, "to-a", brix.NodeKind.LINK, 0, "a.txt")))
    line("a fifo", status(brix.make(directory, "pipe", brix.NodeKind.FIFO, 0x1A4, "")))
    const through = handle(brix.open(directory, "to-a", brix.Open.READ, 0))
    var word: [6]u8 = undefined
    _ = brix.read(through, word[0..6], 0)
    say(word[0..6])
    say(" (through the link)\n")
    var entries: [256]u8 = undefined
    const listed = brix.list(directory, entries[0..256], 0)
    if listed < 0 { line("list failed", status(listed)) }
    var at: usize = 0
    var names: usize = 0
    while listed > 0 && at < @bitCast(usize, listed) {
        const length = @intCast(usize, entries[at + 12])
        say("  entry ")
        say(entries[at + 16..at + 16 + length])
        line(" kind", @intCast(usize, entries[at + 8]))
        names += 1
        at += (16 + length + 7) & ~@intCast(usize, 7)
    }
    line("entries", names)
    line("remove a full directory (not empty)", status(brix.remove(0, "/temporary/objects")))
    line("open a missing one (not found)", status(brix.open(directory, "missing", brix.Open.READ, 0)))

    // A stream.
    var ends: [2]u32 = [2]u32{ 0, 0 }
    _ = brix.streamPair(&ends)
    _ = brix.write(ends[1], "streamed", brix.STREAM)
    var streamed: [8]u8 = undefined
    _ = brix.read(ends[0], streamed[0..8], brix.STREAM)
    say(streamed[0..8])
    say("\n")

    // A channel: bytes and the file's handle; the handle leaves.
    var pair: [2]u32 = [2]u32{ 0, 0 }
    _ = brix.channelPair(&pair)
    var given: [1]u32 = [1]u32{ file }
    line("send", status(brix.send(pair[0], "hello channel", given[0..1])))
    line("the sent handle here (invalid handle)", status(brix.write(file, "x", 0)))
    var bytes: [64]u8 = undefined
    var got: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    var sizes: [2]u32 = [2]u32{ 0, 0 }
    line("receive", status(brix.receive(pair[1], bytes[0..64], got[0..4], &sizes)))
    say(bytes[0..@intCast(usize, sizes[0])])
    say("\n")
    line("handles received", @intCast(usize, sizes[1]))
    var again: [11]u8 = undefined
    _ = brix.read(got[0], again[0..11], 0)
    say(again[0..11])
    say(" (through the received handle)\n")
    line("receive again (would block)", status(brix.receive(pair[1], bytes[0..64], got[0..4], &sizes)))
    _ = brix.close(pair[0])
    line("receive after the peer closed (peer gone)", status(brix.receive(pair[1], bytes[0..64], got[0..4], &sizes)))

    // A branch that exits.
    var change = brix.Change.{ .what = 0, .value = 0, .detail = 0, .reserved = 0 }
    const child = brix.branch()
    if child == 0 { brix.exit(5) }
    awaitEnd(handle(child))
    _ = brix.change(handle(child), &change)
    line("the branch exited", @intCast(usize, change.what))
    line("with", @intCast(usize, change.value))

    // One ended by an event.
    const other = brix.branch()
    if other == 0 {
        var hold: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = ends[0], .want = brix.State.READABLE, .seen = 0, .reserved = 0 } }
        while true { _ = brix.wait(hold[0..1], brix.FOREVER) }
    }
    line("nothing yet (would block)", status(brix.change(handle(other), &change)))
    _ = brix.sendEvent(handle(other), brix.Event.TERMINATE)
    awaitEnd(handle(other))
    _ = brix.change(handle(other), &change)
    line("the other ended by an event", @intCast(usize, change.what))
    line("of kind (terminate)", @intCast(usize, change.value))

    // A program spawned with exactly these handles: output to the
    // stream, errors to ours.
    const program = handle(brix.open(0, "/system/programs/echo", brix.Open.READ, 0))
    var arguments: [3]usize = [3]usize{ @intFromPtr("echo"), @intFromPtr("spawned"), 0 }
    var environment: [1]usize = [1]usize{ 0 }
    const start = brix.Start.{ .arguments = @intFromPtr(&arguments), .environment = @intFromPtr(&environment) }
    var handles: [3]u32 = [3]u32{ ends[0], ends[1], brix.ofDescriptor(2) }
    const spawned = handle(brix.spawn(program, &start, handles[0..3]))
    awaitEnd(spawned)
    _ = brix.change(spawned, &change)
    line("the spawned echo exited", @intCast(usize, change.what))
    line("with", @intCast(usize, change.value))
    var echoed: [8]u8 = undefined
    _ = brix.read(ends[0], echoed[0..8], brix.STREAM)
    say(echoed[0..8])
    return 0
}
