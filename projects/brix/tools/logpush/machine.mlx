// This machine as logpush sees it: the kernel log, the log klogsave kept
// of the boot before, the graphics card's ROM, the clock, the network
// link's state. On brixOS these are the system's own (std.os.brix: the
// link's record /devices/net0, the device nodes); built for another
// system (the host, to try the program's other parts there) there is no
// kernel log to give and the network is not asked about.
const std = @import("std")
const builtin = @import("builtin")
const brix = std.os.brix
const upload = @import("./upload.mlx")

pub const LOG_CAPACITY: usize = 1 << 18 // the kernel's log holds 256 KiB
pub const ROM_CAPACITY: usize = 1 << 17 // a video BIOS ROM is 255 blocks of 512 bytes at most

var logBuffer: [LOG_CAPACITY]u8 = undefined // (per run)
var previousBuffer: [LOG_CAPACITY]u8 = undefined // (per run)
var romBuffer: [ROM_CAPACITY]u8 = undefined // (per run)
var previousFrom: [96]u8 = undefined // (per run)
var previousFromLength: usize = 0 // (per run)

// The file at `path` (NUL-terminated) into `into`, `capacity` bytes of
// it at most: how many.
fn readInto(path: [*]const u8, into: [*]u8, capacity: usize) -> usize {
    const file = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return 0 }
    var total: usize = 0
    while total < capacity {
        const room: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(into) + total) }
        const got = std.fs.read(file, room, capacity - total)
        if got <= 0 { break }
        total += @intCast(usize, got)
    }
    _ = std.fs.close(file)
    return total
}

// The kernel log as it is now ("" when there is none to read).
pub fn kernelLog() -> []const u8 {
    const length = readInto("/devices/klog\x00".pointer, &logBuffer, LOG_CAPACITY)
    return logBuffer[0..length]
}

// The graphics card's ROM as the kernel read it at boot ("" when it
// read none).
pub fn rom() -> []const u8 {
    const length = readInto("/devices/gpurom\x00".pointer, &romBuffer, ROM_CAPACITY)
    return romBuffer[0..length]
}

// "/volumes/NAME" and `suffix` into `into` (NUL-terminated); false when
// it does not fit.
fn volumePath(into: *[256]u8, name: []const u8, suffix: []const u8) -> bool {
    const prefix = "/volumes/"
    if prefix.length + name.length + suffix.length + 1 > 256 { return false }
    var n = std.text.append(into, 0, 255, prefix)
    n = std.text.append(into, n, 255, name)
    n = std.text.append(into, n, 255, suffix)
    into.*[n] = 0
    return true
}

// Whether `saved` is this boot's own log as klogsave wrote it: the
// kernel's log only grows, so one written earlier in this boot is the
// beginning of the log as it is now (`log`); another boot's is longer or
// differs somewhere.
pub fn ownLog(saved: []const u8, log: []const u8) -> bool {
    if saved.length == 0 || saved.length > log.length { return false }
    var k: usize = 0
    while k < saved.length {
        if saved[k] != log[k] { return false }
        k += 1
    }
    return true
}

// The log of the boot before, from the first brixfs volume that has
// one ("" when none has): klogsave writes boot.log at every boot and
// keeps the one that was there as boot.previous.log. Where boot.log is
// not this boot's own (klogsave has not run in this boot, or could not
// write), it is itself the last boot's that was saved. `log`: the kernel
// log as it is now.
pub fn previousLog(log: []const u8) -> []const u8 {
    previousFromLength = 0
    const directory = std.fs.open("/volumes\x00".pointer, std.fs.DIRECTORY, 0)
    if !std.fs.isValid(directory) { return "" }
    var listing: [4096]u8 = undefined
    const bytes: [*]u8 = &listing
    var reader = std.fs.entries(directory, bytes, 4096)
    var entry: std.fs.Entry = undefined
    var length: usize = 0
    while length == 0 && std.fs.nextEntry(&reader, &entry) {
        const name = std.string.asSlice(entry.name)
        if std.fs.isDotName(entry.name) || std.text.same(name, "boot") || name.length > 64 { continue }
        var path: [256]u8 = undefined
        if !volumePath(&path, name, "/boot.log") { continue }
        const pointer: [*]const u8 = &path
        length = readInto(pointer, &previousBuffer, LOG_CAPACITY)
        var file: []const u8 = "boot.log of "
        if length == 0 || ownLog(previousBuffer[0..length], log) {
            length = 0
            file = "boot.previous.log of "
            if volumePath(&path, name, "/boot.previous.log") { length = readInto(pointer, &previousBuffer, LOG_CAPACITY) }
        }
        if length > 0 {
            previousFromLength = std.text.append(&previousFrom, 0, 96, file)
            previousFromLength = std.text.append(&previousFrom, previousFromLength, 96, name)
        }
    }
    _ = std.fs.close(directory)
    return previousBuffer[0..length]
}

// Where previousLog's log is from: the file's name and the volume's
// ("boot.previous.log of disk0").
pub fn previousLogFrom() -> []const u8 { return previousFrom[0..previousFromLength] }

// Seconds since 1970 by the system's clock (0 when it gives none).
pub fn now() -> usize {
    const moment = std.time.realtime()
    return if moment.seconds < 0 { 0 } else { @bitCast(usize, moment.seconds) }
}

// Milliseconds since the boot.
pub fn uptime() -> usize { return std.time.monotonicNanoseconds() / 1000000 }

// The boot's date and time, seconds since 1970: the clock less the time
// since the boot, to the nearest second (the two are read one after the
// other, a moment apart: rounded, every run of one boot says the same).
pub fn bootTime() -> usize {
    const since = std.time.monotonicNanoseconds()
    const moment = std.time.realtime()
    if moment.seconds < 0 { return 0 }
    const clock = @bitCast(usize, moment.seconds) * 1000000000 + @bitCast(usize, moment.nanoseconds)
    if clock < since { return 0 }
    return (clock - since + 500000000) / 1000000000
}

// What stands in the way of the network on this machine's side: nothing
// when a link has an address.
pub fn trouble() -> upload.Trouble {
    if comptime builtin.os != builtin.Os.brixos { return upload.Trouble.none }
    var index: usize = 0
    var anyUp = false
    while index < brix.NETWORK_LINKS {
        var link: brix.NetworkLink = undefined
        const read = brix.networkLink(index, &link)
        if read == -brix.Status.not_found { break }
        // (A record that cannot be read says nothing: not held against
        // the network.)
        if read < 0 { return upload.Trouble.none }
        if link.configured != brix.NetworkLink.NONE && (link.address[0] != 0 || link.address[1] != 0 || link.address[2] != 0 || link.address[3] != 0) { return upload.Trouble.none }
        if link.up { anyUp = true }
        index += 1
    }
    if index == 0 { return upload.Trouble.noDevice }
    return if anyUp { upload.Trouble.noAddress } else { upload.Trouble.linkDown }
}

// Whether the system's random numbers are fit for a TLS key: brixOS's
// kernel says whether its generator is keyed from the processor's own
// source (system_info; a kernel that does not say is taken at its word:
// no). Another system's are its own affair.
pub fn randomFit() -> bool {
    if comptime builtin.os != builtin.Os.brixos { return true }
    var info: brix.SystemInfo = undefined
    return brix.systemInfo(&info) >= 0 && info.randomFit != 0
}

pub fn sleep(milliseconds: usize) -> void { _ = std.time.sleepNanoseconds(milliseconds * 1000000) }
