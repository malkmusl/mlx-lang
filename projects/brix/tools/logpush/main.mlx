// logpush: this machine's kernel log handed over by the machine itself,
// into a private GitHub repository of its owner's, so that a boot whose
// screen stays dark can still be read by the one who looks into it.
//
//   logpush         now, by hand: the kernel log as it is at this moment
//   logpush boot    the service's run (logpush.service): waits in the
//                   background for the network's address, uploads, uploads
//                   once more two minutes later when the log has grown,
//                   and stays to upload when it is asked to
//
// What a run uploads, each as a new file (names.mlx has the names):
//   - the kernel log (/devices/klog), named by the boot's date and the
//     seconds since;
//   - the log of the boot before, when klogsave kept one on a brixfs
//     volume (boot.previous.log): once a boot;
//   - the graphics card's ROM (/devices/gpurom), when the kernel read one
//     and the repository does not have it yet.
// Each is said in a line; what did not work is said with its reason.
//
// The settings are /system/settings/logpush: the repository's name and a
// token for it (settings.mlx). The builder of an image puts them there
// from a file of their own that is in no repository (the build takes
// logpush.local in beside it when it is there; projects/brix/README.md);
// an image without them uploads nothing, and the service says so once
// and ends. The token is read from that file by this program and goes
// into the request's header over TLS, nowhere else: not into an
// argument, the environment, a line or a log. The kernel lets only the
// system's user read the file. So `logpush` by hand uploads itself where
// it may read the settings (root's shell), and asks the service to where
// it may not (the terminal of the person logged in): ask.mlx.
//
// The service's waits: for an address 90 seconds at most, looking twice
// a second (DHCP answers seconds after the boot); then five tries at
// most, 5, 10, 20 and 40 seconds apart, for what may pass (no name
// server yet, no answer, GitHub's side); what will not pass (a token
// that is not taken, no such repository, a certificate that is not
// trusted, a clock that is not set) is said once and not tried again.
// A try after the first uploads only what the tries before it did not
// get through: the kernel log once it is uploaded is not uploaded again
// for the sake of the log of the boot before or the ROM.
// All of it happens in the service's own process, which waits in one
// place for the time and for askers: the boot and the session wait for
// nothing.
const std = @import("std")
const crash = @import("std.crash")
const turns_module = @import("std.turns")
const settings_module = @import("./settings.mlx")
const line_module = @import("./line.mlx")
const upload = @import("./upload.mlx")
const machine = @import("./machine.mlx")
const said = @import("./said.mlx")
const ask = @import("./ask.mlx")

const Line = line_module.Line

pub const SETTINGS: []const u8 = "/system/settings/logpush"
// The service: how long it waits for an address, how often it looks.
const ADDRESS_WAIT: usize = 90000
const LOOK: usize = 500
// How many tries a run of the service has, the pause before the second,
// and the longest a step on the network may take.
const TRIES: usize = 5
const FIRST_PAUSE: usize = 5000
const STEP: isize = 20000
// How long the service waits for an asker at a time once its own
// uploads are done (nothing happens when the time passes: it waits on).
const IDLE: usize = 3600000

var settings: settings_module.Settings = undefined // (per run)
// The service's listener for askers (0: none), the asker whose upload is
// under way (0: none: the service's own), and when the last asked upload
// ended (milliseconds of the clock that only goes on; 0: none yet).
var listener: usize = 0 // (per run)
var asker: usize = 0 // (per run)
var lastAsked: usize = 0 // (per run)

// A line: to the terminal or the service's log, and to who asked.
fn write(context: usize, line: []const u8) -> void {
    _ = context
    _ = std.io.writeAll(std.io.stdout(), line)
    _ = std.io.writeAll(std.io.stdout(), "\n")
    if asker != 0 { ask.tell(asker, line) }
}

var out: line_module.Out = undefined // (per run)

// What an upload got through so far, from one try of it to the next
// (upload.Went): the service's own upload of the boot, and an upload by
// hand or for an asker (which may come between two tries of the
// service's own, and must not undo what those keep).
var ownWent: upload.Went = undefined // (per run)
var otherWent: upload.Went = undefined // (per run)

// The settings read from their file; what became of the reading.
fn readSettings() -> settings_module.Read {
    var path: [64]u8 = undefined
    const read = settings_module.load(std.text.zeroTerminated(&path, 64, SETTINGS), &settings)
    out.token = settings.tokenText()
    return read
}

// The token is not kept between two uploads: the service stays for
// hours, and reads it again when it uploads.
fn forgetToken() -> void {
    settings.forget()
    out.token = ""
}

// One try of an upload of what there is now; `length`: how long the
// kernel log was; `went`: what the tries before of this upload got
// through, and what this one does. The settings are read for it and
// their token forgotten after it.
fn once(length: *usize, went: *upload.Went) -> upload.Result {
    var line: Line = undefined
    line.init()
    const read = readSettings()
    if said.ofSettings(&line, read, &settings, SETTINGS, false) {
        out.say(&line)
        forgetToken()
        return upload.Result.stop
    }
    const log = machine.kernelLog()
    // (How long the log was that this upload's file holds: a later try
    // that leaves the kernel log alone leaves this as it is.)
    if !went.*.klog { length.* = log.length }
    if log.length == 0 {
        said.noLog(&line)
        out.say(&line)
        forgetToken()
        return upload.Result.stop
    }
    const previous = machine.previousLog(log)
    const run = upload.Run.{ .settings = &settings, .klog = log, .previous = previous, .previousFrom = machine.previousLogFrom(), .rom = machine.rom(), .now = machine.now(), .boot = machine.bootTime(), .uptime = machine.uptime(), .randomFit = machine.randomFit(), .trouble = machine.trouble, .out = &out, .timeoutMs = STEP, .roots = null, .went = went }
    const result = upload.run(&run)
    forgetToken()
    return result
}

// An asker's upload: its lines go to the asker too, then how it ended.
fn serve(channel: usize, line: *Line) -> void {
    asker = channel
    var code: u8 = 1
    const now = std.time.milliseconds()
    if lastAsked != 0 && now < lastAsked + ask.PAUSE {
        line.init()
        said.tooSoon(line, (lastAsked + ask.PAUSE - now + 999) / 1000)
        out.say(line)
    } else {
        var length: usize = 0
        otherWent.nothing()
        if once(&length, &otherWent) == upload.Result.done { code = 0 }
        lastAsked = std.time.milliseconds() | 1
    }
    asker = 0
    ask.finish(channel, code)
}

// The service waits `milliseconds`, and uploads for who asks meanwhile.
// Each wait is a turn (std.turns): `line` is from before the turns
// began, and nothing else outlives a turn but numbers and the modules'
// data.
fn pause(turns: *turns_module.Turns, line: *Line, milliseconds: usize) -> void {
    const end = std.time.milliseconds() + milliseconds
    while true {
        turns_module.turn(turns)
        const now = std.time.milliseconds()
        if now >= end { return }
        const channel = ask.next(listener, end - now)
        if channel != 0 { serve(channel, line) }
    }
}

// One upload of the service's own, tried again after growing pauses
// while what stands in its way may pass; each try leaves alone what the
// tries before got through (ownWent, which the caller sets).
fn withTries(turns: *turns_module.Turns, line: *Line, length: *usize) -> upload.Result {
    var wait = FIRST_PAUSE
    var attempt: usize = 1
    while true {
        turns_module.turn(turns)
        const result = once(length, &ownWent)
        if result != upload.Result.again || attempt == TRIES { return result }
        line.init()
        said.again(line, wait / 1000, attempt + 1, TRIES)
        out.say(line)
        pause(turns, line, wait)
        wait *= 2
        attempt += 1
    }
    return upload.Result.stop
}

// How long the kernel log was at the service's first upload, and at its
// second.
var firstLength: usize = 0 // (per run)
var secondLength: usize = 0 // (per run)

// The service's own uploads of a boot: when the network has an address,
// and once more a while later; 0 when both went.
fn bootUploads(turns: *turns_module.Turns, line: *Line) -> u8 {
    var waited: usize = 0
    while true {
        turns_module.turn(turns)
        const trouble = machine.trouble()
        if trouble == upload.Trouble.none { break }
        if trouble == upload.Trouble.noDevice || waited >= ADDRESS_WAIT {
            line.init()
            said.noAddress(line, ADDRESS_WAIT / 1000, trouble)
            out.say(line)
            return 1
        }
        pause(turns, line, LOOK)
        waited += LOOK
    }
    ownWent.nothing()
    const first = withTries(turns, line, &firstLength)
    // (Without the kernel log uploaded there is no first upload for a
    // second one to follow.)
    if !ownWent.klog { return 1 }
    const firstCode: u8 = if first == upload.Result.done { 0 } else { 1 }
    // Once more a while later (two minutes, or what the settings say):
    // what is tried on this machine happens during the boot and after
    // it. The kernel log anew when it has grown; and, with it or alone,
    // what the first upload could not get through (the log of the boot
    // before, the ROM: what it did get through is not asked for again).
    if settings.again == 0 { return firstCode }
    pause(turns, line, settings.again * 1000)
    const grown = machine.kernelLog().length > firstLength
    if !grown && first == upload.Result.done {
        line.init()
        said.notGrown(line, settings.again)
        out.say(line)
        return 0
    }
    ownWent.klog = !grown
    return if withTries(turns, line, &secondLength) == upload.Result.done { 0 } else { 1 }
}

// The service's run.
fn service() -> u8 {
    var line: Line = undefined
    line.init()
    listener = ask.listen()
    // Each turn of the waits and tries releases the values it made
    // (std.turns: a program that runs on and on must, the compiler keeps
    // a turn's records and arrays in an arena that only grows). What
    // outlives a turn is in the modules' data or was made before this,
    // as `line` was.
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, true, false)
    const code = bootUploads(&turns, &line)
    // Then it stays for who asks (a system without a listener for them:
    // it ends).
    if listener == 0 { return code }
    while true { pause(&turns, &line, IDLE) }
    return code
}

fn sayLine(line: []const u8) -> void {
    _ = std.io.writeAll(std.io.stdout(), line)
    _ = std.io.writeAll(std.io.stdout(), "\n")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    out.context = 0
    out.write = write
    out.token = ""
    const count = std.process.count(arguments)
    var booting = false
    if count == 2 && std.text.same(std.string.asSlice(std.process.argument(arguments, 1)), "boot") {
        booting = true
    } else if count != 1 {
        _ = std.io.writeAll(std.io.stdout(), said.USAGE)
        return 1
    }
    // The settings looked at once at the start: whether there are any to
    // go by (each upload reads them again for itself).
    const read = readSettings()
    var code: u8 = 1
    var line: Line = undefined
    line.init()
    // By hand where the settings are not this user's to read: the
    // service is asked, and says what it does.
    if !booting && read == settings_module.Read.denied {
        const asked = ask.ask(sayLine, &code)
        if asked == ask.Asked.answered { return code }
        said.notAsked(&line, SETTINGS, asked == ask.Asked.silent)
        out.say(&line)
        return 1
    }
    if said.ofSettings(&line, read, &settings, SETTINGS, booting) {
        out.say(&line)
        forgetToken()
        // (An image without settings is as the build makes it: no error
        // of the service's.)
        return if booting && read == settings_module.Read.missing { 0 } else { 1 }
    }
    forgetToken()
    if booting {
        code = service()
    } else {
        var length: usize = 0
        otherWent.nothing()
        code = if once(&length, &otherWent) == upload.Result.done { 0 } else { 1 }
    }
    return code
}
