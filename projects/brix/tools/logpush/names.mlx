// The names logpush gives what it uploads. A file that is in a
// repository already can only be replaced by one who names its checksum,
// so every upload is a file of its own name, and the names sort by time
// and say what they are:
//
//     MACHINE/2026-11-17T20-41-07Z/klog-0000031.482s.txt
//         the kernel log as it was 31.482 seconds after the boot of that
//         date and time (UTC, the system's clock): the directory is the
//         boot, the seconds make two uploads of one boot two files (to
//         the millisecond: the service's second upload and one by hand
//         have met in one second)
//     MACHINE/2026-11-17T20-41-07Z/previous-boot-klog.txt
//         the log of the boot before, as klogsave kept it: once a boot
//     MACHINE/gpu-rom-1a2b3c4d5e6f7a8b.rom
//         the graphics card's ROM, named by its bytes (the first 16 hex
//         digits of their SHA-256): the same ROM is the same name at
//         every boot, and a name that is there is not uploaded again
const std = @import("std")
const hash = @import("std.crypto.hash")
const Line = @import("./line.mlx").Line

// A clock that says less than this (2026-01-01, before this program was
// written) is not set.
pub const CLOCK_FLOOR: usize = 1767225600

pub fn clockSet(seconds: usize) -> bool { return seconds >= CLOCK_FLOOR }

// The date of `seconds` since 1970 as 2026-11-17, added to `line`; with
// `time`, T20-41-07Z after it (hyphens, not colons: a path's part).
pub fn stamp(line: *Line, seconds: usize, time: bool) -> void {
    const days = seconds / 86400
    const inDay = seconds % 86400
    // (The proleptic Gregorian calendar, from the days since 1970.)
    const z = days + 719468
    const era = z / 146097
    const doe = z - era * 146097
    const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    const doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    const mp = (5 * doy + 2) / 153
    const day = doy - (153 * mp + 2) / 5 + 1
    const month = if mp < 10 { mp + 3 } else { mp - 9 }
    const year = yoe + era * 400 + (if month <= 2 { 1 } else { 0 })
    line.padded(year, 4)
    line.add("-")
    line.padded(month, 2)
    line.add("-")
    line.padded(day, 2)
    if !time { return }
    line.add("T")
    line.padded(inDay / 3600, 2)
    line.add("-")
    line.padded(inDay % 3600 / 60, 2)
    line.add("-")
    line.padded(inDay % 60, 2)
    line.add("Z")
}

// MACHINE/BOOT: a boot's directory.
fn bootDirectory(line: *Line, machine: []const u8, boot: usize) -> void {
    line.add(machine)
    line.add("/")
    stamp(line, boot, true)
}

// The kernel log's path, `uptime` milliseconds after the boot of `boot`.
pub fn klog(line: *Line, machine: []const u8, boot: usize, uptime: usize) -> void {
    bootDirectory(line, machine, boot)
    line.add("/klog-")
    line.padded(uptime / 1000, 7)
    line.add(".")
    line.padded(uptime % 1000, 3)
    line.add("s.txt")
}

// The path of the log of the boot before.
pub fn previous(line: *Line, machine: []const u8, boot: usize) -> void {
    bootDirectory(line, machine, boot)
    line.add("/previous-boot-klog.txt")
}

// The ROM's path: named by the bytes.
pub fn rom(line: *Line, machine: []const u8, bytes: []const u8) -> void {
    var digest: [32]u8 = undefined
    hash.digest(hash.Algorithm.sha256, bytes, &digest)
    line.add(machine)
    line.add("/gpu-rom-")
    const digits = "0123456789abcdef"
    var k: usize = 0
    while k < 8 {
        line.add(digits[@intCast(usize, digest[k] >> 4)..@intCast(usize, digest[k] >> 4) + 1])
        line.add(digits[@intCast(usize, digest[k] & 15)..@intCast(usize, digest[k] & 15) + 1])
        k += 1
    }
    line.add(".rom")
}
