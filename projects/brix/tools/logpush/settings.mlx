// logpush's settings: where the logs go and the token that lets them in.
// A text of a few lines (/system/settings/logpush; the image's builder
// puts it there, see main.mlx):
//
//     OWNER/NAME                      the repository, on the first line
//     TOKEN                           its token, on the second
//     machine NAME                    this machine's name in the paths
//                                     (else "brix")
//     branch NAME                     the branch (else the repository's
//                                     own)
//     again SECONDS                   the service's second upload of a
//                                     boot comes this long after its
//                                     first (else 120; 0: there is none)
//     api https://HOST                another host than api.github.com
//                                     (TLS that verifies all the same)
//     test-endpoint http://HOST:PORT  a test's endpoint without TLS:
//                                     taken only with a token that
//                                     begins with "test-"
//
// Empty lines and lines that begin with # say nothing; a line may end
// with CR LF, and blanks around what it says do not count. The first two
// lines that say something are the repository and the token; the others
// may follow in any order.
//
// The token is a secret. Nothing here gives a line of the settings back
// in a text for a person: a line that is wrong is named by its number
// (a token put on the wrong line would be said otherwise). Only what was
// checked letter for letter to be a name (the repository, the machine,
// the branch, the other host) is ever said.
const std = @import("std")

pub const REPOSITORY: usize = 141
pub const TOKEN: usize = 256
pub const MACHINE: usize = 40
pub const BRANCH: usize = 100
pub const API: usize = 200
// The settings' text is read whole or not at all.
pub const TEXT: usize = 4096

pub const DEFAULT_API: []const u8 = "https://api.github.com"
pub const DEFAULT_MACHINE: []const u8 = "brix"
// The service's second upload of a boot: this many seconds after its
// first; what the settings may say instead (a day at most).
pub const DEFAULT_AGAIN: usize = 120
pub const LEAST_AGAIN: usize = 10
pub const MOST_AGAIN: usize = 86400
// What a token begins with that a test endpoint without TLS takes.
pub const TEST_TOKEN: []const u8 = "test-"

pub const Verdict = enum(u8) {
    ok,
    // Nothing in it says anything.
    empty,
    // The repository alone.
    noToken,
    // The line `line` is not OWNER/NAME.
    badRepository,
    // The line `line` is no token (a blank or another character no token
    // has in it, or longer than one is).
    badToken,
    // The line `line` is none of the further lines, or what follows its
    // word is not what that line takes.
    badLine,
    // A test endpoint without TLS and a token that is not a test's.
    testToken
}

pub const Settings = struct {
    verdict: Verdict
    // The line a bad* verdict speaks of (the first is 1).
    line: usize
    repository: [REPOSITORY]u8
    repositoryLength: usize
    token: [TOKEN]u8
    tokenLength: usize
    machine: [MACHINE]u8
    machineLength: usize
    // (0: the repository's own branch.)
    branch: [BRANCH]u8
    branchLength: usize
    // The API's address without a slash at its end: "https://HOST",
    // "https://HOST:PORT/PREFIX", or a test endpoint's "http://HOST:PORT".
    api: [API]u8
    apiLength: usize
    // The address is a test endpoint's, without TLS.
    plain: bool
    // The seconds from the service's first upload of a boot to its
    // second (0: no second one).
    again: usize

    pub fn repositoryText(self: *const Self) -> []const u8 { return self.*.repository[0..self.*.repositoryLength] }
    pub fn tokenText(self: *const Self) -> []const u8 { return self.*.token[0..self.*.tokenLength] }
    pub fn machineText(self: *const Self) -> []const u8 { return self.*.machine[0..self.*.machineLength] }
    pub fn branchText(self: *const Self) -> []const u8 { return self.*.branch[0..self.*.branchLength] }
    pub fn apiText(self: *const Self) -> []const u8 { return self.*.api[0..self.*.apiLength] }

    // The host of the API's address, with its port when it names one
    // ("api.github.com", "10.0.2.2:8123"): for a line about it.
    pub fn hostText(self: *const Self) -> []const u8 {
        const text = self.apiText()
        var from: usize = 0
        while from + 2 < text.length && !(text[from] == 47 && text[from + 1] == 47) { from += 1 }
        from = if from + 2 < text.length { from + 2 } else { 0 }
        var to = from
        while to < text.length && text[to] != 47 { to += 1 }
        return text[from..to]
    }

    // The host alone, without a port: whose name the certificate must
    // be, and what a name server is asked for.
    pub fn hostName(self: *const Self) -> []const u8 {
        const host = self.hostText()
        var colon: usize = 0
        while colon < host.length && host[colon] != 58 { colon += 1 }
        return host[0..colon]
    }

    // The token's bytes overwritten: when the program has no more use for
    // them.
    pub fn forget(self: *Self) -> void {
        var k: usize = 0
        while k < TOKEN {
            self.*.token[k] = 0
            k += 1
        }
        self.*.tokenLength = 0
    }
}

fn isLetter(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }
fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }
// What a name is made of here: letters, digits, the dot, the hyphen and
// the underscore.
fn isNameByte(byte: u8) -> bool { return isLetter(byte) || isDigit(byte) || byte == 46 || byte == 45 || byte == 95 }

// A name of `most` bytes at most that is not "." or "..".
fn isName(text: []const u8, most: usize) -> bool {
    if text.length == 0 || text.length > most { return false }
    if std.text.same(text, ".") || std.text.same(text, "..") { return false }
    for byte in text {
        if !isNameByte(byte) { return false }
    }
    return true
}

// OWNER/NAME: two names with one slash between them.
pub fn isRepository(text: []const u8) -> bool {
    var slash: usize = 0
    while slash < text.length && text[slash] != 47 { slash += 1 }
    if slash >= text.length { return false }
    return isName(text[0..slash], 39) && isName(text[slash + 1..text.length], 100)
}

// A token: printable ASCII without a blank, a quote or a backslash (what
// GitHub gives out is letters, digits and underscores), 255 bytes at
// most.
pub fn isToken(text: []const u8) -> bool {
    if text.length == 0 || text.length >= TOKEN { return false }
    for byte in text {
        if byte <= 32 || byte >= 127 || byte == 34 || byte == 92 { return false }
    }
    return true
}

// A branch's name: names with slashes between them.
fn isBranch(text: []const u8) -> bool {
    if text.length == 0 || text.length > BRANCH { return false }
    var start: usize = 0
    var at: usize = 0
    while at <= text.length {
        if at == text.length || text[at] == 47 {
            if !isName(text[start..at], BRANCH) { return false }
            start = at + 1
        }
        at += 1
    }
    return true
}

// "SCHEME://HOST", "SCHEME://HOST:PORT", with or without a path of names
// after it (a slash at its end is left out): how much of `text` it is, 0
// when `text` is none. The host is a name (dots in it) or an address.
fn addressLength(text: []const u8, scheme: []const u8) -> usize {
    if !std.text.startsWith(text, scheme) { return 0 }
    var at = scheme.length
    const host = at
    while at < text.length && isNameByte(text[at]) && text[at] != 95 { at += 1 }
    if at == host || text[host] == 46 || text[host] == 45 { return 0 }
    if at < text.length && text[at] == 58 {
        at += 1
        const port = at
        var value: usize = 0
        while at < text.length && isDigit(text[at]) && at - port < 5 {
            value = value * 10 + @intCast(usize, text[at] - 48)
            at += 1
        }
        if at == port || value == 0 || value > 65535 { return 0 }
    }
    // The path: /NAME as often as it comes.
    while at < text.length && text[at] == 47 {
        var end = at + 1
        while end < text.length && isNameByte(text[end]) { end += 1 }
        if end == at + 1 {
            // (A slash at the very end.)
            if end == text.length { return at }
            return 0
        }
        if std.text.same(text[at + 1..end], ".") || std.text.same(text[at + 1..end], "..") { return 0 }
        at = end
    }
    return if at == text.length { at } else { 0 }
}

fn copy(into: [*]u8, text: []const u8) -> usize {
    var k: usize = 0
    while k < text.length {
        into[k] = text[k]
        k += 1
    }
    return text.length
}

// What follows the word `word` and a blank on `line`; false when the
// line does not begin so.
fn after(line: []const u8, word: []const u8, rest: *[]const u8) -> bool {
    if !std.text.startsWith(line, word) || line.length <= word.length { return false }
    if line[word.length] != 32 && line[word.length] != 9 { return false }
    rest.* = std.text.trimmed(line[word.length..line.length])
    return true
}

// The settings `text` says, into `into`; `into.verdict` says whether it
// is whole, and what is wrong with it otherwise.
pub fn parse(text: []const u8, into: *Settings) -> void {
    into.*.verdict = Verdict.empty
    into.*.line = 0
    into.*.repositoryLength = 0
    into.*.tokenLength = 0
    into.*.machineLength = copy(&into.*.machine, DEFAULT_MACHINE)
    into.*.branchLength = 0
    into.*.apiLength = copy(&into.*.api, DEFAULT_API)
    into.*.plain = false
    into.*.again = DEFAULT_AGAIN
    var at: usize = 0
    // (A text an editor marked as UTF-8 at its very start.)
    if text.length >= 3 && text[0] == 0xEF && text[1] == 0xBB && text[2] == 0xBF { at = 3 }
    var number: usize = 0
    var said: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = std.text.trimmed(text[at..end])
        at = end + 1
        number += 1
        if line.length == 0 || line[0] == 35 { continue }
        said += 1
        if said == 1 {
            if !isRepository(line) {
                into.*.verdict = Verdict.badRepository
                into.*.line = number
                return
            }
            into.*.repositoryLength = copy(&into.*.repository, line)
            into.*.verdict = Verdict.noToken
            continue
        }
        if said == 2 {
            if !isToken(line) {
                into.*.verdict = Verdict.badToken
                into.*.line = number
                return
            }
            into.*.tokenLength = copy(&into.*.token, line)
            into.*.verdict = Verdict.ok
            continue
        }
        var rest: []const u8 = ""
        var good = false
        if after(line, "machine", &rest) {
            good = isName(rest, MACHINE)
            if good { into.*.machineLength = copy(&into.*.machine, rest) }
        } else if after(line, "branch", &rest) {
            good = isBranch(rest)
            if good { into.*.branchLength = copy(&into.*.branch, rest) }
        } else if after(line, "again", &rest) {
            var value: usize = 0
            good = rest.length > 0 && rest.length <= 5
            for digit in rest {
                if !isDigit(digit) { good = false }
                value = value * 10 + @intCast(usize, digit -% 48)
            }
            good = good && (value == 0 || (value >= LEAST_AGAIN && value <= MOST_AGAIN))
            if good { into.*.again = value }
        } else if after(line, "api", &rest) {
            const length = addressLength(rest, "https://")
            good = length != 0 && length <= API
            if good {
                into.*.apiLength = copy(&into.*.api, rest[0..length])
                into.*.plain = false
            }
        } else if after(line, "test-endpoint", &rest) {
            const length = addressLength(rest, "http://")
            good = length != 0 && length <= API
            if good {
                into.*.apiLength = copy(&into.*.api, rest[0..length])
                into.*.plain = true
            }
        }
        if !good {
            into.*.verdict = Verdict.badLine
            into.*.line = number
            return
        }
    }
    // Without TLS everyone on the way reads the token: only one that is
    // no secret goes that way, whatever the settings say.
    if into.*.verdict == Verdict.ok && into.*.plain && !std.text.startsWith(into.tokenText(), TEST_TOKEN) { into.*.verdict = Verdict.testToken }
}

// What became of reading the settings' file.
pub const Read = enum(u8) {
    ok,
    // There is no such file.
    missing,
    // There is one, and this program's user may not read it.
    denied,
    // It could not be read, or is longer than settings are.
    unreadable
}

const ENOENT: isize = -2
const EACCES: isize = -13

var fileText: [TEXT + 1]u8 = undefined // (per run)

// The settings of the file at `path` (NUL-terminated) into `into`; when
// the file is read, `into.verdict` says what it holds.
pub fn load(path: [*]const u8, into: *Settings) -> Read {
    const file = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        if file.descriptor == ENOENT { return Read.missing }
        if file.descriptor == EACCES { return Read.denied }
        return Read.unreadable
    }
    var total: usize = 0
    var failed = false
    while total <= TEXT {
        const room: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(&fileText) + total) }
        const got = std.fs.read(file, room, TEXT + 1 - total)
        if got < 0 { failed = true }
        if got <= 0 { break }
        total += @intCast(usize, got)
    }
    _ = std.fs.close(file)
    if failed || total > TEXT {
        wipe()
        return Read.unreadable
    }
    parse(fileText[0..total], into)
    wipe()
    return Read.ok
}

// The file's text is not kept: the token stands in `into` alone.
fn wipe() -> void {
    var k: usize = 0
    while k <= TEXT {
        fileText[k] = 0
        k += 1
    }
}
