// What logpush says: one line at a time, put together here and given to
// where the lines go (the terminal, the service's log, a test's list).
//
// Every line goes out through `Out.say`, and that looks the line over for
// the token first: wherever the token stands in it, or a piece of the
// token of PIECE bytes and more, "[token]" goes out in its place. No line
// is written to put the token there; this is for the text of others that
// a line may carry (what a server answered) and for a mistake in a line
// written later.
const std = @import("std")

pub const CAPACITY: usize = 480
// A piece of the token this long and longer is not let out either (a
// token shorter than this is looked for whole).
pub const PIECE: usize = 8
const MARK: []const u8 = "[token]"

pub const Line = struct {
    bytes: [CAPACITY]u8
    length: usize

    pub fn init(self: *Self) -> void { self.*.length = 0 }
    pub fn add(self: *Self, text: []const u8) -> void { self.*.length = std.text.append(&self.*.bytes, self.*.length, CAPACITY, text) }
    pub fn number(self: *Self, value: usize) -> void { self.*.length = std.text.appendUnsigned(&self.*.bytes, self.*.length, CAPACITY, value) }

    // `value` with `digits` digits at least, zeros before it.
    pub fn padded(self: *Self, value: usize, digits: usize) -> void {
        var width: usize = 1
        var rest = value / 10
        while rest != 0 {
            width += 1
            rest /= 10
        }
        while width < digits {
            self.add("0")
            width += 1
        }
        self.number(value)
    }

    // A text of someone else's (a server's words): what is not printable
    // ASCII as "?", and no more than `most` bytes of it.
    pub fn foreign(self: *Self, text: []const u8, most: usize) -> void {
        var k: usize = 0
        while k < text.length && k < most {
            const byte = text[k]
            self.*.length = std.text.appendByte(&self.*.bytes, self.*.length, CAPACITY, if byte >= 32 && byte < 127 { byte } else { 63 })
            k += 1
        }
        if k < text.length { self.add("...") }
    }

    pub fn text(self: *const Self) -> []const u8 { return self.*.bytes[0..self.*.length] }
}

// How many bytes of `text` from `at` on stand somewhere in `token` as
// they are (the longest such run).
fn sharedAt(text: []const u8, at: usize, token: []const u8) -> usize {
    var longest: usize = 0
    var from: usize = 0
    while from < token.length {
        var run: usize = 0
        while at + run < text.length && from + run < token.length && text[at + run] == token[from + run] { run += 1 }
        if run > longest { longest = run }
        from += 1
    }
    return longest
}

// `text` into `into` (CAPACITY bytes) with every piece of `token` taken
// out of it; the length. Whether anything was taken out: `found`.
pub fn scrub(text: []const u8, token: []const u8, into: [*]u8, found: *bool) -> usize {
    found.* = false
    const least = if token.length < PIECE { token.length } else { PIECE }
    var length: usize = 0
    var at: usize = 0
    while at < text.length {
        const shared = if least == 0 { 0 } else { sharedAt(text, at, token) }
        if least != 0 && shared >= least {
            length = std.text.append(into, length, CAPACITY, MARK)
            at += shared
            found.* = true
        } else {
            length = std.text.appendByte(into, length, CAPACITY, text[at])
            at += 1
        }
    }
    return length
}

// Where the lines go.
pub const Out = struct {
    context: usize
    write: fn(context: usize, line: []const u8) -> void
    // The token no line may carry ("" while there is none yet).
    token: []const u8

    // The line, looked over, to where the lines go; the line is empty
    // again.
    pub fn say(self: *const Self, line: *Line) -> void {
        var clean: [CAPACITY]u8 = undefined
        var found = false
        const length = scrub(line.text(), self.*.token, &clean, &found)
        self.*.write(self.*.context, clean[0..length])
        line.init()
    }
}
