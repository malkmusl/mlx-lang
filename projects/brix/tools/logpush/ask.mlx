// An upload asked of the service. The settings hold a token and are the
// system's user's alone to read, so `logpush` typed by the person logged
// in (their terminal is their own user's) cannot upload by itself. It
// asks the service instead, which runs as the system's user and stays
// after its boot uploads for this: over a listener node,
// /temporary/logpush (brixOS's own: who opens the node gets a channel
// to whoever listens). The asker sends nothing; the service uploads what
// it always uploads, to where its settings say, and sends back the
// lines it says, each a message, then how it ended. Nothing of the
// settings crosses the channel.
//
// A message is one byte that says what it is, then its text: "L" and a
// line; "E" and the exit code as a digit.
//
// Everyone on the machine may ask: an upload gives an asker nothing but
// the lines, and takes the kernel log, which everyone on the machine
// reads anyway, to its owner's repository. So that asking cannot become
// thousands of uploads, the service answers one asker at a time and none
// within PAUSE of the upload before (said to the asker).
const std = @import("std")
const builtin = @import("builtin")
const brix = std.os.brix

pub const PATH: []const u8 = "/temporary/logpush"
// The least time between two uploads that were asked for (milliseconds).
pub const PAUSE: usize = 3000
// How long an asker waits for the service's next line (an upload's steps
// on the network take 20 seconds each at most, a few of them a line).
const PATIENCE: usize = 150000
const LINE: usize = 512

// The listener made (one a run of the service before left is taken
// away first): its handle, 0 when the system has none to give.
pub fn listen() -> usize {
    if comptime builtin.os != builtin.Os.brixos { return 0 }
    _ = brix.remove(0, PATH)
    // (Everyone may open it, whatever the service's mask for new files.)
    const mask = brix.setUmask(0)
    const made = brix.listen(0, PATH, 0x1B6)
    _ = brix.setUmask(mask)
    return if made <= 0 { 0 } else { @bitCast(usize, made) }
}

// Waits `milliseconds` at most for an asker: its channel's handle, 0
// when the time passed without one. Without a listener it is the wait
// alone.
pub fn next(listener: usize, milliseconds: usize) -> usize {
    if comptime builtin.os != builtin.Os.brixos {
        _ = std.time.sleepNanoseconds(milliseconds * 1000000)
        return 0
    }
    const deadline = brix.clock(brix.Clock.MONOTONIC) + milliseconds * 1000000
    if listener == 0 {
        _ = std.time.sleepNanoseconds(milliseconds * 1000000)
        return 0
    }
    while true {
        var items: [1]brix.WaitItem = undefined
        items[0] = brix.WaitItem.{ .handle = @intCast(u32, listener), .want = brix.State.READABLE, .seen = 0, .reserved = 0 }
        const result = brix.wait(items[0..1], deadline)
        if result == -brix.Status.interrupted { continue }
        if result <= 0 { return 0 }
        var bytes: [4]u8 = undefined
        var handles: [1]u32 = [1]u32{ 0 }
        var sizes: [2]u32 = [2]u32{ 0, 0 }
        const got = brix.receive(@intCast(u32, listener), bytes[0..4], handles[0..1], &sizes)
        if got >= 0 && sizes[1] == 1 && handles[0] != 0 { return @intCast(usize, handles[0]) }
        // (What came was no asker: waited on.)
        if brix.clock(brix.Clock.MONOTONIC) >= deadline { return 0 }
    }
    return 0
}

fn message(asker: usize, kind: u8, text: []const u8) -> void {
    if comptime builtin.os != builtin.Os.brixos { return }
    var bytes: [LINE]u8 = undefined
    bytes[0] = kind
    const length = std.text.append(&bytes, 1, LINE, text)
    var none: [1]u32 = [1]u32{ 0 }
    // (An asker that went away, or takes nothing: its loss.)
    _ = brix.send(@intCast(u32, asker), bytes[0..length], none[0..0])
}

// A line of the service's to the asker.
pub fn tell(asker: usize, line: []const u8) -> void { message(asker, 76, line) }

// The asker is told how it ended, and let go.
pub fn finish(asker: usize, code: u8) -> void {
    if comptime builtin.os != builtin.Os.brixos { return }
    const digit = [1]u8{ 48 + code % 10 }
    message(asker, 69, digit[0..1])
    _ = brix.close(@intCast(u32, asker))
}

pub const Asked = enum(u8) {
    // The service answered: its lines were said, `code` is how it ended.
    answered,
    // Nobody listens: the service is not running.
    nobody,
    // The service is there and did not answer to the end.
    silent
}

// Asks the service for an upload: each line it says given to `say`, the
// way it ended into `code`.
pub fn ask(say: fn(line: []const u8) -> void, code: *u8) -> Asked {
    code.* = 1
    if comptime builtin.os != builtin.Os.brixos { return Asked.nobody }
    const opened = brix.open(0, PATH, brix.Open.READ, 0)
    if opened < 0 { return if opened == -brix.Status.would_block { Asked.silent } else { Asked.nobody } }
    const channel = @intCast(u32, opened)
    var result = Asked.silent
    while true {
        var items: [1]brix.WaitItem = undefined
        items[0] = brix.WaitItem.{ .handle = channel, .want = brix.State.READABLE | brix.State.PEER_GONE, .seen = 0, .reserved = 0 }
        const waited = brix.wait(items[0..1], brix.clock(brix.Clock.MONOTONIC) + PATIENCE * 1000000)
        if waited == -brix.Status.interrupted { continue }
        if waited <= 0 { break }
        var bytes: [LINE]u8 = undefined
        var handles: [1]u32 = [1]u32{ 0 }
        var sizes: [2]u32 = [2]u32{ 0, 0 }
        const got = brix.receive(channel, bytes[0..LINE], handles[0..1], &sizes)
        if got < 0 { break }
        const length = @intCast(usize, sizes[0])
        if length >= 2 && bytes[0] == 69 {
            code.* = if bytes[1] >= 48 && bytes[1] <= 57 { bytes[1] - 48 } else { 1 }
            result = Asked.answered
            break
        }
        if length >= 1 && bytes[0] == 76 { say(bytes[1..length]) }
    }
    _ = brix.close(channel)
    return result
}
