// What logpush asks of GitHub's REST API, as its documentation gives it
// ("Create or update file contents", "Get repository content"):
//
//     PUT API/repos/OWNER/NAME/contents/PATH
//     Authorization: Bearer TOKEN
//     Accept: application/vnd.github+json
//     X-GitHub-Api-Version: 2022-11-28
//     User-Agent: brix-logpush                (GitHub answers no request
//                                              without one)
//     Content-Type: application/json
//
//     {"message":"...","content":"BASE64","branch":"..."}
//
// makes the file PATH with the bytes the base64 stands for, as one
// commit with that message (on the branch named, else the repository's
// own); a GET of the same address says whether there is such a file
// (200) or not (404); a GET of API/repos/OWNER/NAME ("Get a repository")
// gives the repository's record, with "private": true or false in it.
// A path here is made of names, digits, dots,
// hyphens and slashes (names.mlx, the settings' names checked), so it
// goes into the address as it is.
//
// The header lines hold the token: they are made in a place of the
// caller's and go to std.http.client alone.
const std = @import("std")
const base64 = @import("std.base64")
const json = @import("std.json")

pub const AGENT: []const u8 = "brix-logpush"
pub const API_VERSION: []const u8 = "2022-11-28"
// Room for the address of a path's contents, and for the header lines.
pub const URL: usize = 640
pub const HEADERS: usize = 512

// API/repos/REPOSITORY/contents/PATH into `into` (URL bytes), or, for
// no path, API/repos/REPOSITORY: the repository itself. Its length, 0
// when it does not fit.
pub fn url(into: [*]u8, api: []const u8, repository: []const u8, path: []const u8) -> usize {
    if api.length + 7 + repository.length + 10 + path.length > URL { return 0 }
    var n = std.text.append(into, 0, URL, api)
    n = std.text.append(into, n, URL, "/repos/")
    n = std.text.append(into, n, URL, repository)
    if path.length == 0 { return n }
    n = std.text.append(into, n, URL, "/contents/")
    return std.text.append(into, n, URL, path)
}

// The header lines of a request with `token` into `into` (HEADERS
// bytes), each ended by CR LF; `sending`: the request has a JSON body.
// The length, 0 when they do not fit.
pub fn headers(into: [*]u8, token: []const u8, sending: bool) -> usize {
    if token.length + 180 > HEADERS { return 0 }
    var n = std.text.append(into, 0, HEADERS, "User-Agent: ")
    n = std.text.append(into, n, HEADERS, AGENT)
    n = std.text.append(into, n, HEADERS, "\r\nAccept: application/vnd.github+json\r\nAuthorization: Bearer ")
    n = std.text.append(into, n, HEADERS, token)
    n = std.text.append(into, n, HEADERS, "\r\nX-GitHub-Api-Version: ")
    n = std.text.append(into, n, HEADERS, API_VERSION)
    n = std.text.append(into, n, HEADERS, "\r\n")
    if sending { n = std.text.append(into, n, HEADERS, "Content-Type: application/json\r\n") }
    return n
}

// A request's body: bytes of the program's heap, given back by `free`.
pub const Body = struct {
    bytes: [*]u8
    length: usize
    capacity: usize

    pub fn init(self: *Self) -> void {
        self.*.length = 0
        self.*.capacity = 0
    }

    pub fn free(self: *Self) -> void {
        if self.*.capacity > 0 { std.heap.allocator().free(self.*.bytes, self.*.capacity, 1) }
        self.init()
    }

    pub fn text(self: *const Self) -> []const u8 {
        if self.*.length == 0 { return "" }
        return self.*.bytes[0..self.*.length]
    }

    fn add(self: *Self, value: []const u8) -> void { self.*.length = std.text.append(self.*.bytes, self.*.length, self.*.capacity, value) }

    // `value` as a JSON string, quotes and all.
    fn string(self: *Self, value: []const u8) -> void {
        const room: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(self.*.bytes) + self.*.length) }
        const written = json.escapeString(std.string.fromParts(value.pointer, value.length), room, self.*.capacity - self.*.length)
        if written > 0 { self.*.length += @bitCast(usize, written) }
    }

    // {"message":MESSAGE,"content":the base64 of CONTENT} and, when
    // `branch` names one, ,"branch":BRANCH before the brace; false when
    // the heap has no room for it.
    pub fn make(self: *Self, message: []const u8, content: []const u8, branch: []const u8) -> bool {
        self.free()
        const encoded = base64.encodedLength(base64.Encoding.base64, content.length, true)
        // (A JSON string is six times its text at most, and the quotes.)
        const capacity = 64 + 6 * message.length + encoded + 6 * branch.length
        const memory = std.heap.allocator().alloc(capacity, 1)
        if memory == null { return false }
        self.*.bytes = memory.?
        self.*.capacity = capacity
        self.add("{\"message\":")
        self.string(message)
        self.add(",\"content\":\"")
        const room: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(self.*.bytes) + self.*.length) }
        self.*.length += base64.encode(base64.Encoding.base64, content, room, true)
        self.add("\"")
        if branch.length > 0 {
            self.add(",\"branch\":")
            self.string(branch)
        }
        self.add("}")
        return true
    }
}
