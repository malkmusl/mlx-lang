// What GitHub's answer to a request means for logpush, and how it is said
// in plain words. The status decides (the documentation's: 201 a file
// made, 200 one replaced or found, 401 the token is not taken, 403 it
// may not do this, 404 nothing there or nothing the token may see, 409 a
// conflict, 410 the API version asked for is no longer served, 422 the
// request is not taken); the answer's body is JSON with GitHub's own
// sentence in "message", which is said after the reason where it can be
// read, and left out where the body is no JSON.
const std = @import("std")
const json = @import("std.json")
const Line = @import("./line.mlx").Line
const request = @import("./request.mlx")

pub const Verdict = enum(u8) {
    // The file is made (a PUT), or is there (a GET).
    done,
    // There is no such file (a GET's 404).
    absent,
    // It did not work now and may later: worth another try.
    again,
    // It did not work and will not as things are.
    stop
}

// What the status `status` of the answer to a request means; `asking`:
// the request was a GET that asks whether a file is there.
pub fn verdict(status: u32, asking: bool) -> Verdict {
    if status == 200 || status == 201 { return Verdict.done }
    if status == 404 && asking { return Verdict.absent }
    // (GitHub's side, a limit that passes, a change at the same moment.)
    if status >= 500 || status == 429 || status == 409 || status == 408 { return Verdict.again }
    return Verdict.stop
}

// The longest of GitHub's own sentence that is said.
const MESSAGE: usize = 160

// The text of "message" in the JSON object `body` into `into` (MESSAGE
// bytes): its length, 0 when the body is no JSON object or has none.
pub fn message(body: []const u8, into: [*]u8) -> usize {
    if body.length == 0 { return 0 }
    var tokenizer: json.Tokenizer = undefined
    json.initAt(&tokenizer, body.pointer, body.length)
    var token: json.Token = undefined
    var length: usize = 0
    var wanted = false
    while json.next(&tokenizer, &token) {
        if json.depth(&tokenizer) == 1 && token.kind == json.TokenKind.key {
            wanted = length == 0 && json.equals(token.value, "message")
        } else if wanted {
            wanted = false
            if token.kind == json.TokenKind.string {
                // (Decoded where its escapes are good and it fits; a
                // sentence too long for the room is not said.)
                const decoded = json.decodeString(token.value, into, MESSAGE)
                if decoded > 0 { length = @bitCast(usize, decoded) }
            }
        }
    }
    // (A body that is not JSON to its end is none: its words are not
    // said.)
    if json.failed(&tokenizer) { return 0 }
    return length
}

// What a repository's record says of who may read it.
pub const Privacy = enum(u8) {
    private,
    // Everyone reads it.
    public,
    // The record does not say (or is no JSON object).
    unsaid
}

// "private" of the JSON object `body`: true, false, or not said.
pub fn privacy(body: []const u8) -> Privacy {
    if body.length == 0 { return Privacy.unsaid }
    var tokenizer: json.Tokenizer = undefined
    json.initAt(&tokenizer, body.pointer, body.length)
    var token: json.Token = undefined
    var found = Privacy.unsaid
    var wanted = false
    while json.next(&tokenizer, &token) {
        if json.depth(&tokenizer) == 1 && token.kind == json.TokenKind.key {
            wanted = found == Privacy.unsaid && json.equals(token.value, "private")
        } else if wanted {
            wanted = false
            if token.kind == json.TokenKind.trueValue { found = Privacy.private }
            if token.kind == json.TokenKind.falseValue { found = Privacy.public }
        }
    }
    if json.failed(&tokenizer) { return Privacy.unsaid }
    return found
}

// Why a request with the status `status` did not do what it should, in
// plain words, added to `line`; GitHub's own sentence from `body` after
// it. `repository`: the settings' (a checked name).
pub fn reason(line: *Line, status: u32, body: []const u8, repository: []const u8) -> void {
    line.number(@intCast(usize, status))
    line.add(": ")
    if status == 401 {
        line.add("GitHub does not take the token (mistyped, expired or revoked): the settings need a new one")
    } else if status == 403 {
        line.add("the token may not do this (it needs \"Contents: Read and write\" for ")
        line.add(repository)
        line.add("), or GitHub's limit of requests is reached")
    } else if status == 404 {
        line.add("no repository ")
        line.add(repository)
        line.add(", or the token may not see it")
    } else if status == 409 {
        line.add("GitHub says the branch changed at the same moment")
    } else if status == 410 {
        // (GitHub answers so to a request whose X-GitHub-Api-Version it
        // no longer serves: request.API_VERSION, which it keeps for 24
        // months after a newer one came, 2022-11-28 until 2028-03-10.)
        line.add("GitHub no longer takes the API version this logpush speaks (")
        line.add(request.API_VERSION)
        line.add("): an image with a newer logpush is needed")
    } else if status == 422 {
        line.add("GitHub does not take the file (one of this name is there already, or the branch is not there)")
    } else if status == 429 {
        line.add("too many requests for GitHub at the moment")
    } else if status >= 500 {
        line.add("GitHub's side failed")
    } else if status >= 300 && status < 400 {
        line.add("GitHub points elsewhere (the repository was renamed or moved: the settings need its name of now)")
    } else {
        line.add("an answer logpush does not know")
    }
    var said: [MESSAGE]u8 = undefined
    const length = message(body, &said)
    if length > 0 {
        line.add("; GitHub: \"")
        line.foreign(said[0..length], MESSAGE)
        line.add("\"")
    }
}
