// The lines logpush says of its settings and of the service's waits
// (main.mlx says them; what an upload says is upload.mlx's). None of
// them gives a line of the settings back: a line that is wrong is named
// by its number.
const std = @import("std")
const settings_module = @import("./settings.mlx")
const upload = @import("./upload.mlx")
const Line = @import("./line.mlx").Line

const Settings = settings_module.Settings
const Read = settings_module.Read
const Verdict = settings_module.Verdict

// What is said of settings that cannot be gone by, into `line`; false
// (and nothing said) when they are good. `path`: the settings' file;
// `service`: the service's run, where an image without settings is as
// it should be.
pub fn ofSettings(line: *Line, read: Read, settings: *const Settings, path: []const u8, service: bool) -> bool {
    if read == Read.missing {
        line.add("logpush: no settings (")
        line.add(path)
        line.add("): nothing is uploaded from this machine")
        if !service { line.add("; projects/brix/README.md says how an image gets them") }
    } else if read == Read.denied {
        line.add("logpush: the settings (")
        line.add(path)
        line.add(") hold a token and are the system's alone to read: this shell is not the system's (root's)")
    } else if read == Read.unreadable {
        line.add("logpush: the settings (")
        line.add(path)
        line.add(") cannot be read, or are longer than settings are")
    } else if settings.*.verdict == Verdict.empty {
        line.add("logpush: the settings are empty: their first line is the repository (OWNER/NAME), their second the token")
    } else if settings.*.verdict == Verdict.noToken {
        line.add("logpush: the settings have no token: it is their second line")
    } else if settings.*.verdict == Verdict.badRepository {
        line.add("logpush: line ")
        line.number(settings.*.line)
        line.add(" of the settings is not a repository's name (OWNER/NAME)")
    } else if settings.*.verdict == Verdict.badToken {
        line.add("logpush: line ")
        line.number(settings.*.line)
        line.add(" of the settings is not a token (it has a blank or a character no token has)")
    } else if settings.*.verdict == Verdict.badLine {
        line.add("logpush: line ")
        line.number(settings.*.line)
        line.add(" of the settings is none logpush knows (after the repository and the token: machine NAME, branch NAME, again SECONDS, api https://HOST, test-endpoint http://HOST:PORT)")
    } else if settings.*.verdict == Verdict.testToken {
        line.add("logpush: the settings name a test endpoint without TLS, which takes a test's token only (one that begins with test-): nothing is sent")
    } else {
        return false
    }
    return true
}

// There is no kernel log to upload.
pub fn noLog(line: *Line) -> void { line.add("logpush: nothing was uploaded: there is no kernel log to read here (/devices/klog)") }

// The service: no address came in `seconds`.
pub fn noAddress(line: *Line, seconds: usize, trouble: upload.Trouble) -> void {
    if trouble == upload.Trouble.noDevice {
        line.add("logpush: nothing is uploaded: this machine has no network device")
        return
    }
    line.add("logpush: nothing is uploaded: this machine has no address after ")
    line.number(seconds)
    line.add(if trouble == upload.Trouble.linkDown { " s (the network link is down: no cable, or nothing at its other end)" } else { " s (no DHCP server answers)" })
}

// The service: another try in `seconds`, the try number `attempt` of
// `tries`.
pub fn again(line: *Line, seconds: usize, attempt: usize, tries: usize) -> void {
    line.add("logpush: trying again in ")
    line.number(seconds)
    line.add(" s (try ")
    line.number(attempt)
    line.add(" of ")
    line.number(tries)
    line.add(")")
}

// The service to an asker who comes right after an upload that was asked
// for: when it uploads again.
pub fn tooSoon(line: *Line, seconds: usize) -> void {
    line.add("logpush: an upload was made a moment ago: asked again in ")
    line.number(seconds)
    line.add(" s, the service uploads again")
}

// By hand, where the settings are not this user's to read and the
// service did not do it either: there is none (`silent`: there is one,
// and it did not answer to the end).
pub fn notAsked(line: *Line, path: []const u8, silent: bool) -> void {
    if silent {
        line.add("logpush: the service that uploads did not answer to the end (it is at an upload that takes long, or it is gone): /temporary/logs/logpush.log has what it said")
        return
    }
    line.add("logpush: the settings (")
    line.add(path)
    line.add(") hold a token and are the system's alone to read, and the service that uploads for everyone else is not running (it ends at once in an image without settings: /temporary/logs/logpush.log has what it said)")
}

// The service: nothing new for the second upload.
pub fn notGrown(line: *Line, seconds: usize) -> void {
    line.add("logpush: the kernel log has not grown in ")
    line.number(seconds)
    line.add(" s: nothing more to upload")
}

pub const USAGE: []const u8 = "usage: logpush         upload the kernel log as it is now (and, when not there yet, the log of the boot before and the graphics card's ROM)\n       logpush boot    the service's run: when the network has an address, once more two minutes later, and then whenever it is asked\n"
