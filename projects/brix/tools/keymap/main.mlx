// keymap: an xkb keymap compiled from the host's XKB data (std.xkb) and
// written as text (as `xkbcli compile-keymap` writes it), for the boot
// image: brixOS has no XKB data, its compositor reads the keymap from
// /system/settings/keyboard/LAYOUT.xkb and hands it to its clients
// (projects/desktop/compositor/xkb.mlx).
//
//   keymap LAYOUT [VARIANT] OUT      e.g. keymap us mlx-out/bin/brix/keymap/us.xkb
//
// The data comes from XKB_CONFIG_ROOT, else /usr/share/X11/xkb; the
// model is pc105, no options. Exit 1 with the compiler's word when the
// data is missing.
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")
const xkb_compile = @import("std.xkb.compile")
const xkb_write = @import("std.xkb.write")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stderr(), text) }

fn argument(arguments: [][*]const u8, index: usize) -> []const u8 {
    const pointer = arguments[index]
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 && arguments.length != 4 {
        say("usage: keymap LAYOUT [VARIANT] OUT\n")
        return 2
    }
    const variant: []const u8 = if arguments.length == 4 { argument(arguments, 2) } else { "" }
    const out = arguments.length - 1
    const allocator = std.heap.allocator()
    const environment = std.process.environmentEntries(arguments)
    var names: keysym.Names = undefined
    if !keysym.init(&names, allocator) {
        say("keymap: no keysym names\n")
        return 1
    }
    const keymap = xkb.create(allocator, &names)
    var compiler: xkb_compile.Compiler = undefined
    xkb_compile.init(&compiler, allocator, &names, environment)
    if !xkb_compile.fromNames(&compiler, keymap, "", "pc105", argument(arguments, 1), variant, "") {
        say("keymap: ")
        say(xkb_compile.message(&compiler))
        say("\n")
        return 1
    }
    const text = xkb_write.keymap(keymap, allocator)
    if !std.fs.writeFile(arguments[out], text.items, text.length, 420) {
        say("keymap: cannot write ")
        say(argument(arguments, out))
        say("\n")
        return 1
    }
    return 0
}
