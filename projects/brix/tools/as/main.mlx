// as USER[:GROUP] PROGRAM [ARGUMENT ...]: the program as that user (and
// group; numbers), found in PATH: setgid, setuid, then it runs in this
// process. Only the system's user (0) may become another; 126 when the
// user cannot be taken or the program cannot run, 127 when there is no
// such program.
const std = @import("std")
const spawn = @import("std.spawn")

const SYS_setuid: usize = 105
const SYS_setgid: usize = 106

fn say(text: []const u8) -> void { _ = std.linux.write(2, text.pointer, text.length) }

fn number(text: []const u8, into: *usize) -> bool {
    if text.length == 0 { return false }
    var value: usize = 0
    for digit in text {
        if digit < 48 || digit > 57 { return false }
        value = value * 10 + @intCast(usize, digit - 48)
    }
    into.* = value
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count < 3 {
        say("usage: as USER[:GROUP] PROGRAM [ARGUMENT ...]\n")
        return 126
    }
    const who = std.string.asSlice(std.process.argument(arguments, 1))
    var colon = who.length
    var k: usize = 0
    while k < who.length {
        if who[k] == 58 && colon == who.length { colon = k }
        k += 1
    }
    var user: usize = 0
    var group: usize = 0
    if !number(who[0..colon], &user) || (colon < who.length && !number(who[colon + 1..who.length], &group)) {
        say("as: the user is a number (USER or USER:GROUP)\n")
        return 126
    }
    if std.linux.syscall1(SYS_setgid, group) != 0 || std.linux.syscall1(SYS_setuid, user) != 0 {
        say("as: cannot become that user\n")
        return 126
    }
    const program = std.process.argument(arguments, 2).pointer
    const argv = unsafe { @ptrFromInt([*][*]const u8, @intFromPtr(arguments.pointer) + 2 * 8) }
    const environment = std.process.environmentEntries(arguments)
    spawn.execute(program, argv, environment, spawn.DEFAULT_PATH)
    say("as: cannot run ")
    say(std.string.asSlice(std.process.argument(arguments, 2)))
    say("\n")
    return 127
}
