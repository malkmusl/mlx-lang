// The machine's figures in words (system_info's record), given piece by
// piece to `say`: what sysinfo writes to its output and logserve puts on
// its /system page. `words` is how many of the record's words the kernel
// has (what system_info gave back): a line whose figures an older kernel
// does not say is left out.
const std = @import("std")
const brix = std.os.brix

pub const Say = fn(text: []const u8) -> void

fn number(say: Say, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

pub fn write(say: Say, info: *const brix.SystemInfo, words: usize) -> void {
    say("memory: ")
    number(say, info.*.memory / (1024 * 1024))
    say(" MiB, ")
    number(say, info.*.free / (1024 * 1024))
    say(" free\nprocessors: ")
    number(say, info.*.processors)
    say("\nuptime: ")
    number(say, info.*.uptime / 1000000000)
    say(".")
    number(say, (info.*.uptime / 100000000) % 10)
    say(" s\npage faults: ")
    number(say, info.*.pageFaults)
    say(", system calls: ")
    number(say, info.*.systemCalls)
    say(", switches: ")
    number(say, info.*.switches)
    say("\ndevice interrupts: ")
    number(say, info.*.deviceInterrupts)
    say("\n")
    // How long processors that had something to run waited for the
    // kernel while another held it: where a program stutters behind
    // another's call, it shows here. (A kernel that does not say: no
    // line.)
    if info.*.processors > 1 && words >= 13 {
        say("waits for the kernel: ")
        milliseconds(say, info.*.kernelWaits)
        say(" in all; the longest ")
        milliseconds(say, info.*.longestWait)
        holder(say, info.*.longestWait, info.*.longestWaitHolder)
        say("; in the last 10 to 20 s ")
        milliseconds(say, info.*.recentWait)
        holder(say, info.*.recentWait, info.*.recentWaitHolder)
        say("\n")
        if words >= 14 {
            say("idle processors' waits for the kernel: ")
            milliseconds(say, info.*.idleWaits)
            say("\n")
        }
    }
}

// Nanoseconds as milliseconds with three decimals.
fn milliseconds(say: Say, nanoseconds: usize) -> void {
    const micro = nanoseconds / 1000
    number(say, micro / 1000)
    say(".")
    const rest = micro % 1000
    if rest < 100 { say("0") }
    if rest < 10 { say("0") }
    number(say, rest)
    say(" ms")
}

// What held the kernel for most of a wait (system_info's word for it).
fn holder(say: Say, wait: usize, what: usize) -> void {
    if wait == 0 { return }
    const low = what & 0xFFFFFFFF
    if low == brix.SystemInfo.HELD_IDLE {
        say(" (behind a processor looking for work)")
        return
    }
    if what >> 32 == 0 {
        say(" (behind an idle processor's")
    } else {
        say(" (behind process ")
        number(say, what >> 32)
    }
    if low & brix.SystemInfo.HELD_BY_CALL != 0 {
        // (brixOS's own calls are numbered from 0x4000, the Linux
        // layer's below.)
        const call = low & 0x7FFFFFFF
        if call >= 0x4000 {
            say(" in brixOS call ")
            number(say, call - 0x4000)
        } else {
            say(" in Linux call ")
            number(say, call)
        }
    } else if low < 32 {
        say(" at fault ")
        number(say, low)
    } else if low == 32 {
        say(" timer tick")
    } else if low == 240 {
        say(" own timer")
    } else if low == 241 {
        say(" wake-up")
    } else {
        say(" interrupt ")
        number(say, low)
    }
    say(")")
}
