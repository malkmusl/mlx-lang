// sysinfo: the machine as the kernel sees it (system_info, call 52):
// the memory and what is free of it, the processors, the uptime, and
// what the kernel did since the boot: page faults served, system
// calls, switches between processes (where a run's time goes), and the
// interrupts the devices sent as messages (0 where the network device and
// the USB controllers are only looked at on the timer tick). With more
// than one processor: how long processors that had something to run
// waited for the kernel while another held it, the longest such wait and
// the longest of the last ten to twenty seconds, each with what held the
// kernel for most of it; and, apart, the waits of processors that had
// nothing to run (their ticks queue behind whoever is in the kernel and
// delay nobody).
//
//   sysinfo
//
//   memory: 2047 MiB, 1831 free
//   processors: 2
//   uptime: 12.4 s
//   page faults: 183042, system calls: 91320, switches: 4410
//   device interrupts: 2210
//   waits for the kernel: 41.220 ms in all; the longest 2.104 ms (behind process 7 in brixOS call 17); in the last 10 to 20 s 0.310 ms (behind process 3 at fault 14)
//   idle processors' waits for the kernel: 12.007 ms
const std = @import("std")
const brix = std.os.brix
const crash = @import("std.crash")
// The figures in words (logserve's /system page says the same).
const report = @import("./report.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    _ = arguments
    var info: brix.SystemInfo = undefined
    const words = brix.systemInfo(&info)
    if words < 0 {
        _ = std.io.writeAll(std.io.stderr(), "sysinfo: no system_info (not brixOS?)\n")
        return 1
    }
    report.write(say, &info, @bitCast(usize, words))
    return 0
}
