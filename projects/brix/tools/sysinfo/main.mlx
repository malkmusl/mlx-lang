// sysinfo: the machine as the kernel sees it (system_info, call 52):
// the memory and what is free of it, the processors, the uptime, and
// what the kernel did since the boot: page faults served, system
// calls, switches between processes (where a run's time goes), and the
// interrupts the devices sent as messages (0 where the network device and
// the USB controllers are only looked at on the timer tick).
//
//   sysinfo
//
//   memory: 2047 MiB, 1831 free
//   processors: 2
//   uptime: 12.4 s
//   page faults: 183042, system calls: 91320, switches: 4410
//   device interrupts: 2210
const std = @import("std")
const brix = std.os.brix
const crash = @import("std.crash")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    _ = arguments
    var info: brix.SystemInfo = undefined
    if brix.systemInfo(&info) < 0 {
        _ = std.io.writeAll(std.io.stderr(), "sysinfo: no system_info (not brixOS?)\n")
        return 1
    }
    say("memory: ")
    number(info.memory / (1024 * 1024))
    say(" MiB, ")
    number(info.free / (1024 * 1024))
    say(" free\nprocessors: ")
    number(info.processors)
    say("\nuptime: ")
    number(info.uptime / 1000000000)
    say(".")
    number((info.uptime / 100000000) % 10)
    say(" s\npage faults: ")
    number(info.pageFaults)
    say(", system calls: ")
    number(info.systemCalls)
    say(", switches: ")
    number(info.switches)
    say("\ndevice interrupts: ")
    number(info.deviceInterrupts)
    say("\n")
    return 0
}
