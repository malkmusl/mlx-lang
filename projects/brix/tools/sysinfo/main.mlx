// sysinfo: the machine as the kernel sees it (system_info, call 52):
// the memory and what is free of it, the processors, the uptime, and
// what the kernel did since the boot: page faults served, system
// calls, switches between processes (where a run's time goes), and the
// interrupts the devices sent as messages (0 where the network device and
// the USB controllers are only looked at on the timer tick). With more
// than one processor: how long processors that had something to run
// waited for the kernel while another held it, the longest such wait and
// the longest of the last ten to twenty seconds, each with what held the
// kernel for most of it; and, apart, the waits of processors that had
// nothing to run (their ticks queue behind whoever is in the kernel and
// delay nobody).
//
//   sysinfo
//
//   memory: 2047 MiB, 1831 free
//   processors: 2
//   uptime: 12.4 s
//   page faults: 183042, system calls: 91320, switches: 4410
//   device interrupts: 2210
//   waits for the kernel: 41.220 ms in all; the longest 2.104 ms (behind process 7 in brixOS call 17); in the last 10 to 20 s 0.310 ms (behind process 3 at fault 14)
//   idle processors' waits for the kernel: 12.007 ms
const std = @import("std")
const brix = std.os.brix
const crash = @import("std.crash")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    _ = arguments
    var info: brix.SystemInfo = undefined
    const words = brix.systemInfo(&info)
    if words < 0 {
        _ = std.io.writeAll(std.io.stderr(), "sysinfo: no system_info (not brixOS?)\n")
        return 1
    }
    say("memory: ")
    number(info.memory / (1024 * 1024))
    say(" MiB, ")
    number(info.free / (1024 * 1024))
    say(" free\nprocessors: ")
    number(info.processors)
    say("\nuptime: ")
    number(info.uptime / 1000000000)
    say(".")
    number((info.uptime / 100000000) % 10)
    say(" s\npage faults: ")
    number(info.pageFaults)
    say(", system calls: ")
    number(info.systemCalls)
    say(", switches: ")
    number(info.switches)
    say("\ndevice interrupts: ")
    number(info.deviceInterrupts)
    say("\n")
    // How long processors that had something to run waited for the
    // kernel while another held it: where a program stutters behind
    // another's call, it shows here. (A kernel that does not say: no
    // line.)
    if info.processors > 1 && words >= 13 {
        say("waits for the kernel: ")
        milliseconds(info.kernelWaits)
        say(" in all; the longest ")
        milliseconds(info.longestWait)
        holder(info.longestWait, info.longestWaitHolder)
        say("; in the last 10 to 20 s ")
        milliseconds(info.recentWait)
        holder(info.recentWait, info.recentWaitHolder)
        say("\n")
        if words >= 14 {
            say("idle processors' waits for the kernel: ")
            milliseconds(info.idleWaits)
            say("\n")
        }
    }
    return 0
}

// Nanoseconds as milliseconds with three decimals.
fn milliseconds(nanoseconds: usize) -> void {
    const micro = nanoseconds / 1000
    number(micro / 1000)
    say(".")
    const rest = micro % 1000
    if rest < 100 { say("0") }
    if rest < 10 { say("0") }
    number(rest)
    say(" ms")
}

// What held the kernel for most of a wait (system_info's word for it).
fn holder(wait: usize, what: usize) -> void {
    if wait == 0 { return }
    const low = what & 0xFFFFFFFF
    if low == brix.SystemInfo.HELD_IDLE {
        say(" (behind a processor looking for work)")
        return
    }
    if what >> 32 == 0 {
        say(" (behind an idle processor's")
    } else {
        say(" (behind process ")
        number(what >> 32)
    }
    if low & brix.SystemInfo.HELD_BY_CALL != 0 {
        // (brixOS's own calls are numbered from 0x4000, the Linux
        // layer's below.)
        const call = low & 0x7FFFFFFF
        if call >= 0x4000 {
            say(" in brixOS call ")
            number(call - 0x4000)
        } else {
            say(" in Linux call ")
            number(call)
        }
    } else if low < 32 {
        say(" at fault ")
        number(low)
    } else if low == 32 {
        say(" timer tick")
    } else if low == 240 {
        say(" own timer")
    } else if low == 241 {
        say(" wake-up")
    } else {
        say(" interrupt ")
        number(low)
    }
    say(")")
}
