// vkinfo's listing (main.mlx): the Vulkan devices as vulkaninfo lists
// them, with our driver offered over a card interface (brixOS's on brixOS;
// the host's card for a look on the host).
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const gpucard = @import("std.gpucard")
const driver = @import("../../vulkan/driver.mlx")
const selftest = @import("../../vulkan/selftest.mlx")
const card = @import("../../vulkan/card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }
fn sayNumber(value: usize) -> void { _ = std.io.writeUnsigned(std.io.stdout(), value) }
fn sayC(text: [*]const u8) -> void { _ = std.io.writeString(std.io.stdout(), std.process.fromCString(text)) }

// The hex digits of `value`, without 0x.
fn sayHexDigits(value: usize) -> void {
    const digits = "0123456789abcdef"
    var text: [16]u8 = undefined
    var length: usize = 0
    var rest = value
    while true {
        text[length] = digits[rest & 0xF]
        length += 1
        rest = rest >> 4
        if rest == 0 { break }
    }
    while length > 0 {
        length -= 1
        say(text[length..length + 1])
    }
}

fn sayHex(value: usize) -> void {
    say("0x")
    sayHexDigits(value)
}

fn sayVersion(version: u32) -> void {
    sayNumber(@intCast(usize, vk.apiVersionMajor(version)))
    say(".")
    sayNumber(@intCast(usize, vk.apiVersionMinor(version)))
    say(".")
    sayNumber(@intCast(usize, vk.apiVersionPatch(version)))
}

fn sayMiB(bytes: u64) -> void {
    sayNumber(@intCast(usize, bytes) / (1024 * 1024))
    say(" MiB")
}

fn deviceType(kind: vk.PhysicalDeviceType) -> []const u8 {
    if kind == vk.PhysicalDeviceType.integratedGpu { return "PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU" }
    if kind == vk.PhysicalDeviceType.discreteGpu { return "PHYSICAL_DEVICE_TYPE_DISCRETE_GPU" }
    if kind == vk.PhysicalDeviceType.virtualGpu { return "PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU" }
    if kind == vk.PhysicalDeviceType.cpu { return "PHYSICAL_DEVICE_TYPE_CPU" }
    return "PHYSICAL_DEVICE_TYPE_OTHER"
}

// The card behind a device of our driver: its node's record.
fn sayCard(physical: vk.PhysicalDevice) -> void {
    const record = driver.recordOf(physical).*
    say("    card               = /devices/gpu")
    sayNumber(driver.cardOf(physical))
    if record.pci != 0xFFFFFFFF {
        say(" at ")
        const bus = @intCast(usize, record.pci) >> 8
        if bus < 16 { say("0") }
        sayHexDigits(bus)
        say(":")
        const slot = (@intCast(usize, record.pci) >> 3) & 0x1F
        if slot < 16 { say("0") }
        sayHexDigits(slot)
        say(".")
        sayNumber(@intCast(usize, record.pci) & 7)
    }
    say(": ")
    sayMiB(record.memory)
    if gpucard.computeUnits(&record) != 0 {
        say(", ")
        sayNumber(gpucard.computeUnits(&record))
        say(" compute units in ")
        sayNumber(@intCast(usize, record.shaderEngines))
        say(" shader engines")
    }
    say("\n")
}

fn describeDevice(commands: *const vk.InstanceCommands, physical: vk.PhysicalDevice, index: usize, ours: bool) -> void {
    var properties = vk.PhysicalDeviceProperties.init()
    var driverRecord = vk.PhysicalDeviceDriverProperties.init()
    var properties2 = vk.PhysicalDeviceProperties2.init()
    properties2.pNext = &driverRecord
    if commands.*.vkGetPhysicalDeviceProperties2 != 0 {
        vk.getPhysicalDeviceProperties2(commands, physical, &properties2)
        properties = properties2.properties
    } else {
        vk.getPhysicalDeviceProperties(commands, physical, &properties)
    }
    say("GPU")
    sayNumber(index)
    say(":\n    apiVersion         = ")
    sayVersion(properties.apiVersion)
    say("\n    driverVersion      = ")
    sayVersion(properties.driverVersion)
    say("\n    vendorID           = ")
    sayHex(@intCast(usize, properties.vendorID))
    say("\n    deviceID           = ")
    sayHex(@intCast(usize, properties.deviceID))
    say("\n    deviceType         = ")
    say(deviceType(properties.deviceType))
    say("\n    deviceName         = ")
    sayC(&properties.deviceName)
    say("\n")
    if driverRecord.driverName[0] != 0 {
        say("    driverName         = ")
        sayC(&driverRecord.driverName)
        say("\n    driverInfo         = ")
        sayC(&driverRecord.driverInfo)
        say("\n")
    }
    if ours { sayCard(physical) }
    var count: u32 = 0
    vk.getPhysicalDeviceQueueFamilyProperties(commands, physical, &count, null)
    var families: [8]vk.QueueFamilyProperties = undefined
    if count > 8 { count = 8 }
    vk.getPhysicalDeviceQueueFamilyProperties(commands, physical, &count, &families)
    var k: u32 = 0
    while k < count {
        const family = families[k]
        say("    queue family ")
        sayNumber(@intCast(usize, k))
        say("     = ")
        sayNumber(@intCast(usize, family.queueCount))
        say(if family.queueCount == 1 { " queue," } else { " queues," })
        if family.queueFlags & vk.QUEUE_GRAPHICS_BIT != 0 { say(" graphics") }
        if family.queueFlags & vk.QUEUE_COMPUTE_BIT != 0 { say(" compute") }
        if family.queueFlags & vk.QUEUE_TRANSFER_BIT != 0 { say(" transfer") }
        if family.timestampValidBits == 0 { say(", no timestamps") }
        say("\n")
        k += 1
    }
    var memory = vk.PhysicalDeviceMemoryProperties.init()
    vk.getPhysicalDeviceMemoryProperties(commands, physical, &memory)
    k = 0
    while k < memory.memoryHeapCount {
        say("    memory heap ")
        sayNumber(@intCast(usize, k))
        say("      = ")
        sayMiB(memory.memoryHeaps[k].size)
        if memory.memoryHeaps[k].flags & vk.MEMORY_HEAP_DEVICE_LOCAL_BIT != 0 { say(", device local") }
        say("\n")
        k += 1
    }
    k = 0
    while k < memory.memoryTypeCount {
        const flags = memory.memoryTypes[k].propertyFlags
        say("    memory type ")
        sayNumber(@intCast(usize, k))
        say("      = heap ")
        sayNumber(@intCast(usize, memory.memoryTypes[k].heapIndex))
        if flags & vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT != 0 { say(", device local") }
        if flags & vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT != 0 { say(", host visible") }
        if flags & vk.MEMORY_PROPERTY_HOST_COHERENT_BIT != 0 { say(", coherent") }
        if flags & vk.MEMORY_PROPERTY_HOST_CACHED_BIT != 0 { say(", cached") }
        say("\n")
        k += 1
    }
    var features: vk.PhysicalDeviceFeatures = undefined
    vk.getPhysicalDeviceFeatures(commands, physical, &features)
    const words: [*]const u32 = unsafe { @ptrCast([*]const u32, &features) }
    var on: usize = 0
    var w: usize = 0
    while w < @sizeOf(vk.PhysicalDeviceFeatures) / 4 {
        if words[w] != 0 { on += 1 }
        w += 1
    }
    say("    features           = ")
    if on == 0 { say("none") } else { sayNumber(on) }
    say("\n")
    // Whether a device with the one compute queue can be made.
    var queue = vk.DeviceQueueCreateInfo.init()
    var priority: f32 = 1.0
    queue.queueFamilyIndex = 0
    queue.queueCount = 1
    queue.pQueuePriorities = unsafe { @ptrCast([*]const f32, &priority) }
    var info = vk.DeviceCreateInfo.init()
    info.queueCreateInfoCount = 1
    info.pQueueCreateInfos = unsafe { @ptrCast([*]const vk.DeviceQueueCreateInfo, &queue) }
    var device: vk.Device = 0
    const made = vk.createDevice(commands, physical, &info, null, &device)
    say("    a device           = ")
    if made == vk.Result.success {
        say(if ours { "made (its self-test passed) and given back\n" } else { "made and given back\n" })
        var deviceCommands: vk.DeviceCommands = undefined
        vk.loadDeviceCommands(&deviceCommands, device, commands.*.vkGetDeviceProcAddr)
        if deviceCommands.vkDestroyDevice != 0 { vk.destroyDevice(&deviceCommands, device, null) }
    } else if ours && driver.refusal() == driver.Refusal.NO_ENGINE {
        say("not yet: no engine of the card takes commands (")
        say(gpucard.whyText(driver.recordOf(physical).*.why))
        say(")\n")
    } else if ours && driver.refusal() == driver.Refusal.SELF_TEST {
        say("refused: ")
        say(driver.refusalText(driver.refusal()))
        if selftest.last.outcome == selftest.Outcome.wrong {
            say(" (word ")
            sayNumber(selftest.last.word)
            say(" is ")
            sayHex(@intCast(usize, selftest.last.got))
            say(", the processor's ")
            sayHex(@intCast(usize, selftest.last.wanted))
            say(")")
        } else {
            say(" (")
            say(selftest.last.step)
            say(")")
        }
        say("\n")
    } else if ours && driver.refusal() != driver.Refusal.NONE {
        say("refused: ")
        say(driver.refusalText(driver.refusal()))
        say("\n")
    } else {
        const code = @intFromEnum(made)
        say("refused (VkResult ")
        if code < 0 { say("-") }
        sayNumber(@intCast(usize, if code < 0 { -code } else { code }))
        say(")\n")
    }
}

// The line said when no device is found, by how many card nodes there
// are: none, or cards our driver does not serve (only Polaris 10).
pub fn noDevice(cards: usize) -> []const u8 {
    if cards == 0 { return "vkinfo: no Vulkan device: this machine has no graphics card our driver serves (no /devices/gpu0) and no other driver\n" }
    return "vkinfo: no Vulkan device: /devices/gpu0 is a card our driver does not serve (it serves the Polaris 10 cards), and there is no other driver\n"
}

// The listing, with the driver offered over `interface`; the status.
pub fn run(interface: card.Card, arguments: [][*]const u8) -> u8 {
    const allocator = std.heap.allocator()
    _ = driver.offer(interface)
    var manifests: loader.Manifests = undefined
    const found = loader.findDrivers(&manifests, arguments, allocator)
    var devices: usize = 0
    var index: usize = 0
    while index < found {
        const manifest = loader.manifestAt(&manifests, index)
        index += 1
        var opened: loader.Driver = undefined
        if loader.openDriver(&opened, manifest, allocator) != loader.Status.ok { continue }
        const ours = manifest.*.builtIn != 0
        say("Vulkan driver ")
        sayC(loader.manifestPath(manifest))
        say(": instance ")
        sayVersion(opened.apiVersion)
        say(", loader interface ")
        sayNumber(@intCast(usize, opened.interfaceVersion))
        say("\n")
        var application = vk.ApplicationInfo.init()
        application.apiVersion = vk.API_VERSION_1_1
        var create = vk.InstanceCreateInfo.init()
        create.pApplicationInfo = &application
        var instance: vk.Instance = 0
        if vk.createInstance(opened.global, &create, null, &instance) != vk.Result.success {
            say("    the instance could not be made\n")
            continue
        }
        var commands: vk.InstanceCommands = undefined
        vk.loadInstanceCommands(&commands, instance, opened.getInstanceProcAddr)
        var count: u32 = 0
        _ = vk.enumeratePhysicalDevices(&commands, instance, &count, null)
        var physical: [8]vk.PhysicalDevice = undefined
        if count > 8 { count = 8 }
        _ = vk.enumeratePhysicalDevices(&commands, instance, &count, &physical)
        var k: u32 = 0
        while k < count {
            describeDevice(&commands, physical[k], devices, ours)
            devices += 1
            k += 1
        }
        vk.destroyInstance(&commands, instance, null)
        loader.closeDriver(&opened)
    }
    if devices == 0 {
        const count = interface.count
        say(noDevice(count()))
        return 1
    }
    return 0
}
