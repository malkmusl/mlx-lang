// vkinfo: the Vulkan devices of this system, as vulkaninfo lists them:
// the drivers std.vulkan.loader finds (on brixOS our own, linked in and
// offered over the system's graphics cards, /devices/gpuN), each device's
// properties, the driver's stage, its queue family, memory and features,
// and whether a device can be made on it.
//
//     vkinfo        the list; status 0, or 1 when there is no device
//
// Without a card the driver serves (QEMU's display, a machine without an
// RX 580) it says so in one line.
const native = @import("../../vulkan/card_brix.mlx")
const listing = @import("./listing.mlx")

pub fn main(arguments: [][*]const u8) -> u8 { return listing.run(native.interface(), arguments) }
