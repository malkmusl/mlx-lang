// events: brixOS's events (std.os.brix), a line each, for
// tools/check_brix.sh: a claimed kind waits in the queue, the upcall runs
// for one and goes back, a wait it interrupts ends with interrupted, an
// unclaimed kind takes its default action, a fault comes through the
// upcall. The events are sent by Linux's kill here: the Linux layer turns
// a signal into its event (its number as the detail).
const std = @import("std")
const brix = std.os.brix
const linux = std.os.linux

const SYS_mmap: usize = 9
const SYS_pipe: usize = 22
const SYS_pause: usize = 34
const SYS_nanosleep: usize = 35
const SYS_getpid: usize = 39
const SYS_fork: usize = 57
const SYS_wait4: usize = 61
const SYS_kill: usize = 62
const SYS_exit_group: usize = 231
const SIGUSR1: usize = 10
const SIGUSR2: usize = 12
const SIGTERM: usize = 15
const STACK: usize = 65536

// What the upcall saw (per run).
var upcalls: usize = 0 // (per run)
var lastKind: u32 = 0 // (per run)
var lastDetail: u32 = 0 // (per run)
var faulting: bool = false // (per run)

fn say(text: []const u8) -> void { _ = brix.write(brix.ofDescriptor(1), text, brix.STREAM) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn line(text: []const u8, value: usize) -> void {
    say(text)
    say(" ")
    number(value)
    say("\n")
}

fn pid() -> usize { return @bitCast(usize, linux.syscall0(SYS_getpid)) }

fn kill(target: usize, signal: usize) -> void { _ = linux.syscall2(SYS_kill, target, signal) }

fn sleepMs(ms: usize) -> void {
    var time: [2]usize = [2]usize{ 0, ms * 1000000 }
    _ = linux.syscall2(SYS_nanosleep, @intFromPtr(&time), 0)
}

fn stack() -> usize { return @bitCast(usize, linux.syscall6(SYS_mmap, 0, STACK, 3, 0x22, @bitCast(usize, @intCast(isize, -1)), 0)) }

fn reap(child: isize) -> usize {
    var status: u32 = 0
    var result = linux.syscall4(SYS_wait4, @bitCast(usize, child), @intFromPtr(&status), 0, 0)
    while result == -4 { result = linux.syscall4(SYS_wait4, @bitCast(usize, child), @intFromPtr(&status), 0, 0) }
    return @intCast(usize, status)
}

// The upcall: the events it was run for, taken; then back.
export fn onUpcall(context: usize) -> void {
    var records: [4]brix.EventRecord = undefined
    const taken = brix.take(records[0..4])
    if taken > 0 {
        upcalls += 1
        lastKind = records[0].kind
        lastDetail = records[0].detail & 0xFF
    }
    if faulting && lastKind == brix.Event.FAULT {
        line("fault through the upcall, exception", @intCast(usize, lastDetail))
        brix.exit(9)
    }
    brix.upcallReturn(context)
}

fn upcallEntry() -> usize { return unsafe { @intFromPtr(onUpcall) } }

pub fn main() -> u8 {
    say("events\n")
    // A claimed kind waits in the queue.
    _ = brix.claim(brix.Event.bit(brix.Event.USER))
    kill(pid(), SIGUSR1)
    var records: [4]brix.EventRecord = undefined
    const taken = brix.take(records[0..4])
    line("queued", @bitCast(usize, taken))
    line("its kind (user)", @intCast(usize, records[0].kind))
    line("its signal", @intCast(usize, records[0].detail & 0xFF))
    say(if @intCast(usize, records[0].sender) == pid() { "sent by itself\n" } else { "sent by another\n" })

    // The upcall runs for it, and goes back.
    _ = brix.upcall(upcallEntry(), stack(), STACK)
    kill(pid(), SIGUSR2)
    line("upcalls", upcalls)
    line("the upcall's signal", @intCast(usize, lastDetail))

    // A wait the upcall interrupts ends with interrupted.
    var ends: [2]u32 = [2]u32{ 0, 0 }
    _ = linux.syscall1(SYS_pipe, @intFromPtr(&ends))
    const parent = pid()
    var child = linux.syscall0(SYS_fork)
    if child == 0 {
        sleepMs(200)
        kill(parent, SIGUSR1)
        _ = linux.syscall1(SYS_exit_group, 0)
    }
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = brix.ofDescriptor(@intCast(isize, ends[0])), .want = brix.State.READABLE, .seen = 0, .reserved = 0 } }
    const waited = brix.wait(items[0..1], brix.FOREVER)
    line("wait interrupted", @bitCast(usize, -waited))
    line("upcalls", upcalls)
    _ = reap(child)

    // An unclaimed kind takes its default: terminate ends the child.
    child = linux.syscall0(SYS_fork)
    if child == 0 {
        _ = brix.claim(brix.Event.bit(brix.Event.INTERRUPT))
        while true { _ = linux.syscall0(SYS_pause) }
    }
    sleepMs(200)
    kill(@bitCast(usize, child), SIGTERM)
    line("child ended by signal", reap(child) & 127)

    // A fault comes through the upcall.
    child = linux.syscall0(SYS_fork)
    if child == 0 {
        faulting = true
        _ = brix.claim(brix.Event.bit(brix.Event.FAULT))
        _ = brix.upcall(upcallEntry(), stack(), STACK)
        const nowhere = unsafe { @ptrFromInt(*volatile usize, 16) }
        nowhere.* = 1
        say("no fault\n")
        _ = linux.syscall1(SYS_exit_group, 0)
    }
    line("faulting child exited", reap(child) >> 8)
    return 0
}
