// signals: what Linux's x86-64 signals do, step by step, a line each. Its
// output on the host and in brixOS must be the same (tools/check_brix.sh):
// a handler and its return (registers kept), masks and pending signals,
// sigtimedwait, ignored and default actions, EINTR and SA_RESTART,
// sigsuspend, a fault caught on the alternate stack.
const std = @import("std")
const linux = std.linux

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_mmap: usize = 9
const SYS_rt_sigaction: usize = 13
const SYS_rt_sigprocmask: usize = 14
const SYS_pipe: usize = 22
const SYS_pause: usize = 34
const SYS_nanosleep: usize = 35
const SYS_getpid: usize = 39
const SYS_fork: usize = 57
const SYS_exit_group: usize = 231
const SYS_wait4: usize = 61
const SYS_kill: usize = 62
const SYS_rt_sigpending: usize = 127
const SYS_rt_sigtimedwait: usize = 128
const SYS_rt_sigsuspend: usize = 130
const SYS_sigaltstack: usize = 131

const SIGUSR1: usize = 10
const SIGSEGV: usize = 11
const SIGUSR2: usize = 12
const SIGTERM: usize = 15
const SIG_BLOCK: usize = 0
const SIG_UNBLOCK: usize = 1
const SIG_IGN: usize = 1
const SA_SIGINFO: usize = 4
const SA_ONSTACK: usize = 0x08000000
const SA_RESTORER: usize = 0x04000000
const SA_RESTART: usize = 0x10000000
const EINTR: isize = -4

// What the handler saw (per run).
var caught: usize = 0 // (per run)
var lastSignal: usize = 0 // (per run)
var lastSender: usize = 0 // (per run)
var onAlternate: bool = false // (per run)
var alternateBase: usize = 0 // (per run)
// The restorer: `mov eax, 15; syscall` in a page of its own (an Mlx
// function would move the stack pointer rt_sigreturn reads).
var restorer: usize = 0 // (per run)

fn say(text: []const u8) -> void { _ = linux.syscall3(SYS_write, 1, @intFromPtr(text.pointer), text.length) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    _ = linux.syscall3(SYS_write, 1, @intFromPtr(&digits) + at, 20 - at)
}

fn line(text: []const u8, value: usize) -> void {
    say(text)
    say(" ")
    number(value)
    say("\n")
}

fn bit(signal: usize) -> usize {
    const one: usize = 1
    return one << @intCast(u6, signal - 1)
}

export fn onSignal(signal: usize, info: usize, context: usize) -> void {
    caught += 1
    lastSignal = signal
    lastSender = @intCast(usize, unsafe { @ptrFromInt(*const u32, info + 16) }.*)
    const sp = @intFromPtr(&signal)
    onAlternate = alternateBase != 0 && sp >= alternateBase && sp < alternateBase + 65536
    _ = context
}

export fn onFault(signal: usize, info: usize, context: usize) -> void {
    _ = info
    _ = context
    const sp = @intFromPtr(&signal)
    const alternate = alternateBase != 0 && sp >= alternateBase && sp < alternateBase + 65536
    line(if alternate { "fault on the alternate stack" } else { "fault on the program's stack" }, signal)
    _ = linux.syscall1(SYS_exit_group, 7)
}

fn handle(signal: usize, handler: usize, flags: usize) -> void {
    var action: [4]usize = [4]usize{ handler, flags | SA_RESTORER | SA_SIGINFO, restorer, 0 }
    _ = linux.syscall4(SYS_rt_sigaction, signal, @intFromPtr(&action), 0, 8)
}

fn handler() -> usize { return unsafe { @intFromPtr(onSignal) } }

fn mask(how: usize, set: usize) -> usize {
    var given = set
    var old: usize = 0
    _ = linux.syscall4(SYS_rt_sigprocmask, how, @intFromPtr(&given), @intFromPtr(&old), 8)
    return old
}

fn pid() -> usize { return @bitCast(usize, linux.syscall0(SYS_getpid)) }

fn kill(target: usize, signal: usize) -> isize { return linux.syscall2(SYS_kill, target, signal) }

fn sleepMs(ms: usize) -> void {
    var time: [2]usize = [2]usize{ 0, ms * 1000000 }
    _ = linux.syscall2(SYS_nanosleep, @intFromPtr(&time), 0)
}

// The child's wait status.
fn reap(child: isize) -> usize {
    var status: u32 = 0
    var result = linux.syscall4(SYS_wait4, @bitCast(usize, child), @intFromPtr(&status), 0, 0)
    while result == EINTR { result = linux.syscall4(SYS_wait4, @bitCast(usize, child), @intFromPtr(&status), 0, 0) }
    return @intCast(usize, status)
}

pub fn main() -> u8 {
    const page = @bitCast(usize, linux.syscall6(SYS_mmap, 0, 4096, 7, 0x22, @bitCast(usize, @intCast(isize, -1)), 0))
    const code = unsafe { @ptrFromInt([*]u8, page) }
    const bytes: [7]u8 = [7]u8{ 0xB8, 15, 0, 0, 0, 0x0F, 0x05 }
    var k: usize = 0
    while k < 7 {
        code[k] = bytes[k]
        k += 1
    }
    restorer = page

    // A handler, and the registers after it (a decimal in the SSE
    // registers, a count in the general ones).
    handle(SIGUSR1, handler(), 0)
    var x: f64 = 1.5
    var count: usize = 40
    _ = kill(pid(), SIGUSR1)
    x = x * 2.0
    count += 2
    line("handler ran", caught)
    line("its signal", lastSignal)
    say(if lastSender == pid() { "sent by itself\n" } else { "sent by another\n" })
    say(if x == 3.0 && count == 42 { "registers kept\n" } else { "registers lost\n" })

    // Blocked: pending until unblocked.
    _ = mask(SIG_BLOCK, bit(SIGUSR2))
    handle(SIGUSR2, handler(), 0)
    _ = kill(pid(), SIGUSR2)
    line("while blocked", caught)
    var pending: usize = 0
    _ = linux.syscall2(SYS_rt_sigpending, @intFromPtr(&pending), 8)
    say(if pending & bit(SIGUSR2) != 0 { "pending\n" } else { "not pending\n" })
    _ = mask(SIG_UNBLOCK, bit(SIGUSR2))
    line("unblocked", caught)
    line("its signal", lastSignal)

    // sigtimedwait takes a blocked one.
    _ = mask(SIG_BLOCK, bit(SIGUSR2))
    _ = kill(pid(), SIGUSR2)
    var set = bit(SIGUSR2)
    var info: [16]usize = undefined
    const taken = linux.syscall4(SYS_rt_sigtimedwait, @intFromPtr(&set), @intFromPtr(&info), 0, 8)
    line("sigtimedwait", @bitCast(usize, taken))
    _ = mask(SIG_UNBLOCK, bit(SIGUSR2))
    line("handler after it", caught)

    // Ignored.
    var ignore: [4]usize = [4]usize{ SIG_IGN, 0, 0, 0 }
    _ = linux.syscall4(SYS_rt_sigaction, SIGUSR2, @intFromPtr(&ignore), 0, 8)
    _ = kill(pid(), SIGUSR2)
    line("ignored", caught)

    // The default action ends a child.
    var child = linux.syscall0(SYS_fork)
    if child == 0 {
        var defaults: [4]usize = [4]usize{ 0, 0, 0, 0 }
        _ = linux.syscall4(SYS_rt_sigaction, SIGTERM, @intFromPtr(&defaults), 0, 8)
        _ = kill(pid(), SIGTERM)
        say("not ended\n")
        _ = linux.syscall1(SYS_exit_group, 0)
    }
    line("ended by signal", reap(child) & 127)

    // pause ends with EINTR after a handler.
    child = linux.syscall0(SYS_fork)
    if child == 0 {
        const result = linux.syscall0(SYS_pause)
        line("pause", @bitCast(usize, -result))
        line("child's handler ran", caught)
        _ = linux.syscall1(SYS_exit_group, 3)
    }
    sleepMs(200)
    _ = kill(@bitCast(usize, child), SIGUSR1)
    line("child exited", reap(child) >> 8)

    // A read on a pipe: EINTR without SA_RESTART, made again with it.
    var ends: [2]u32 = [2]u32{ 0, 0 }
    _ = linux.syscall1(SYS_pipe, @intFromPtr(&ends))
    child = linux.syscall0(SYS_fork)
    if child == 0 {
        var byte: [1]u8 = [1]u8{ 0 }
        var result = linux.syscall3(SYS_read, @intCast(usize, ends[0]), @intFromPtr(&byte), 1)
        line("read without SA_RESTART", @bitCast(usize, -result))
        handle(SIGUSR1, handler(), SA_RESTART)
        result = linux.syscall3(SYS_read, @intCast(usize, ends[0]), @intFromPtr(&byte), 1)
        line("read with SA_RESTART", @bitCast(usize, result))
        line("handlers", caught)
        _ = linux.syscall1(SYS_exit_group, 0)
    }
    sleepMs(200)
    _ = kill(@bitCast(usize, child), SIGUSR1)
    sleepMs(200)
    _ = kill(@bitCast(usize, child), SIGUSR1)
    sleepMs(200)
    _ = linux.syscall3(SYS_write, @intCast(usize, ends[1]), @intFromPtr(&ends), 1)
    _ = reap(child)

    // sigsuspend: the mask it gives until a handler ran, the one before
    // after.
    _ = mask(SIG_BLOCK, bit(SIGUSR1))
    const parent = pid()
    child = linux.syscall0(SYS_fork)
    if child == 0 {
        sleepMs(200)
        _ = kill(parent, SIGUSR1)
        _ = linux.syscall1(SYS_exit_group, 0)
    }
    const before = caught
    var none: usize = 0
    const suspended = linux.syscall2(SYS_rt_sigsuspend, @intFromPtr(&none), 8)
    line("sigsuspend", @bitCast(usize, -suspended))
    line("handlers during it", caught - before)
    say(if mask(SIG_BLOCK, 0) & bit(SIGUSR1) != 0 { "mask back\n" } else { "mask lost\n" })
    _ = reap(child)
    _ = mask(SIG_UNBLOCK, bit(SIGUSR1))

    // A fault caught on the alternate stack.
    child = linux.syscall0(SYS_fork)
    if child == 0 {
        alternateBase = @bitCast(usize, linux.syscall6(SYS_mmap, 0, 65536, 3, 0x22, @bitCast(usize, @intCast(isize, -1)), 0))
        var stack: [3]usize = [3]usize{ alternateBase, 0, 65536 }
        _ = linux.syscall2(SYS_sigaltstack, @intFromPtr(&stack), 0)
        handle(SIGSEGV, unsafe { @intFromPtr(onFault) }, SA_ONSTACK)
        const nowhere = unsafe { @ptrFromInt(*volatile usize, 16) }
        nowhere.* = 1
        say("no fault\n")
        _ = linux.syscall1(SYS_exit_group, 0)
    }
    line("faulting child exited", reap(child) >> 8)
    return 0
}
