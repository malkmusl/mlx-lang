// snapshot: brixOS's snapshots of a tree. A snapshot is a copy whose
// files share their pages with the originals (copy on write: nothing is
// copied until one side writes), taken at once whatever its size.
//
//   snapshot SOURCE DESTINATION      a snapshot that can be changed
//   snapshot -r SOURCE DESTINATION   a read-only one (changes fail, EROFS)
//   snapshot -d SNAPSHOT             take a snapshot out (read-only too)
//
// A snapshot may go inside its source (`snapshot / /users/root/before`).
// Restoring is a snapshot back (of the read-only one: a changeable copy).
const std = @import("std")
const crash = @import("std.crash")

// brixOS's system calls (past Linux's numbers).
const SYS_snapshot: usize = 1000
const SYS_remove_snapshot: usize = 1001
const READ_ONLY: usize = 1

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stderr(), text) }

fn usage() -> u8 {
    say("usage: snapshot [-r] SOURCE DESTINATION | snapshot -d SNAPSHOT\n")
    return 2
}

// Why a call failed, from its -errno.
fn reason(result: isize) -> []const u8 {
    if result == -2 { return "no such file or directory" }
    if result == -17 { return "the destination exists" }
    if result == -20 { return "not a directory on the way" }
    if result == -28 { return "no room (nodes or memory)" }
    if result == -30 { return "read-only (a read-only snapshot)" }
    if result == -38 { return "not brixOS (no snapshots here)" }
    return "failed"
}

fn fail(what: []const u8, result: isize) -> u8 {
    say("snapshot: ")
    say(what)
    say(": ")
    say(reason(result))
    say("\n")
    return 1
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const count = std.process.count(arguments)
    if count < 3 { return usage() }
    const first = std.process.argument(arguments, 1)
    const option = first.length == 2 && first.pointer[0] == 45
    if option && first.pointer[1] == 100 {
        if count != 3 { return usage() }
        const path = std.process.argument(arguments, 2)
        const result = std.linux.syscall1(SYS_remove_snapshot, @intFromPtr(path.pointer))
        return if result < 0 { fail(path.pointer[0..path.length], result) } else { 0 }
    }
    const readOnly = option && first.pointer[1] == 114
    if option && !readOnly { return usage() }
    const at: usize = if readOnly { 2 } else { 1 }
    if count != at + 2 { return usage() }
    const source = std.process.argument(arguments, at)
    const destination = std.process.argument(arguments, at + 1)
    const result = std.linux.syscall3(SYS_snapshot, @intFromPtr(source.pointer), @intFromPtr(destination.pointer), if readOnly { READ_ONLY } else { 0 })
    return if result < 0 { fail(destination.pointer[0..destination.length], result) } else { 0 }
}
