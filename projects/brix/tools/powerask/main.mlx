// powerask: asks the login service to restart the machine or to shut it
// down, the way a program of the desktop does
// (projects/desktop/shared/system_end.mlx: org.mlx.Login on the system
// bus), and says the answer. For tools/check_brix_session.sh, which runs
// it from the serial console's shell: root, but not the user who holds
// the seat, so the login service refuses it.
//
//     powerask restart | poweroff       (DBUS_SYSTEM_BUS_ADDRESS names the bus)
const std = @import("std")
const system_end = @import("../../../desktop/shared/system_end.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

pub fn main(arguments: [][*]const u8) -> u8 {
    var kind: u8 = 0
    if std.process.count(arguments) == 2 {
        const verb = std.string.asSlice(std.process.argument(arguments, 1))
        if std.text.same(verb, "restart") { kind = system_end.RESTART }
        if std.text.same(verb, "poweroff") { kind = system_end.SHUT_DOWN }
    }
    if kind == 0 {
        say("usage: powerask restart | poweroff\n")
        return 2
    }
    const answer = system_end.ask(std.process.environmentEntries(arguments), kind)
    if answer == system_end.ACCEPTED {
        say("powerask: accepted\n")
        return 0
    }
    say(if answer == system_end.REFUSED { "powerask: refused\n" } else { "powerask: no answer from the login service\n" })
    return 1
}
