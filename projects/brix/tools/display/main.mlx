// display: a display's modes from a shell, through the native interface
// (std.displaymodes; spec/04-stdlib/os/brix.xml, <Displays>): what the
// monitor offers, the mode that runs, another one set.
//
//   display                    every display and its modes
//   display 1920x1080          the display set to that size (of the rates
//   display 1920x1080@60       listed for it the one nearest to 60 Hz when
//                              none is named), and the question whether
//                              it is seen: Enter within the time keeps it,
//                              anything else, or no answer, brings the mode
//                              before back
//   display ask 1920x1080      the mode set and left pending (for a script;
//                              the kernel takes it back unless it is
//                              confirmed in time)
//   display confirm            the pending mode stays, and is what the next
//                              boots set
//   display back               the pending mode taken back
//   display state              one line: what runs, what is pending
//   display wait               waits until the display has changed, then
//                              the line of its state
//   -d N before any of them    display N instead of the main one
//   -m after that              the display's pixels are mapped first, as
//                              the program that draws on it does (it then
//                              is the one that may ask when the display's
//                              node is its user's; the kernel's console
//                              leaves that display: for
//                              tools/check_brix_modes.sh)
//
// Root may ask, and the program that draws on the display. Exits 0 when
// what was asked for was done, 1 when it was refused or failed (a line
// says why), 2 for a wrong call.
const std = @import("std")
const brix = std.os.brix
const modes = @import("std.displaymodes")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

// "1920x1080 at 60.00 Hz"; without the rate where none is known.
fn sayMode(width: usize, height: usize, millihertz: usize, interlaced: bool) -> void {
    number(width)
    say("x")
    number(height)
    if interlaced { say(" interlaced") }
    if millihertz == 0 { return }
    say(" at ")
    number(millihertz / 1000)
    const hundredths = millihertz % 1000 / 10
    say(if hundredths < 10 { ".0" } else { "." })
    number(hundredths)
    say(" Hz")
}

fn driverName(kind: usize) -> []const u8 {
    if kind == modes.Driver.QEMU { return "QEMU's adapter" }
    if kind == modes.Driver.RADEON_TMDS { return "the Radeon's driver (HDMI or DVI)" }
    if kind == modes.Driver.RADEON_OTHER { return "the Radeon's driver, which sets no mode on this output" }
    if kind == modes.Driver.RADEON_DP { return "the Radeon's driver (DisplayPort)" }
    return "no driver: as the firmware left it"
}

var list: [modes.MOST]modes.Mode = undefined

// The line of a display's state: "display 0: 1024x768, pitch 4096, at
// 60.00 Hz; nothing pending", or with what is pending and for how long.
fn sayState(state: *const modes.State) -> void {
    say("display ")
    number(state.*.number)
    say(": ")
    sayMode(state.*.width, state.*.height, state.*.millihertz, false)
    say(", pitch ")
    number(state.*.pitch)
    say(", change ")
    number(state.*.changes)
    if state.*.pending {
        say("; pending, ")
        number((state.*.left + 999999999) / 1000000000)
        say(" s left to confirm")
    } else {
        say("; nothing pending")
    }
    if state.*.remembered { say("; a mode is remembered for the next boots") }
    say("\n")
}

fn sayStatus(status: isize) -> void {
    const code = -status
    if code == brix.Status.no_right {
        say("display: not allowed: root may change a display's mode, and the program that draws on it\n")
    } else if code == brix.Status.busy {
        say("display: a mode is pending: `display confirm` keeps it, `display back` takes it back\n")
    } else if code == brix.Status.not_found {
        say("display: there is no such mode, or nothing is pending\n")
    } else if code == brix.Status.unsupported {
        say("display: that mode cannot be set")
    } else if code == brix.Status.io_error {
        say("display: the change failed (the kernel's log says where)")
    } else {
        say("display: the kernel answered ")
        number(@bitCast(usize, code))
        say("\n")
    }
}

// After a request that was refused or failed: why, from the display's
// state.
fn sayWhy(handle: brix.Handle, status: isize) -> void {
    sayStatus(status)
    const code = -status
    if code != brix.Status.unsupported && code != brix.Status.io_error { return }
    var state: modes.State = undefined
    if !modes.state(handle, &state) {
        say("\n")
        return
    }
    if code == brix.Status.unsupported {
        say(": ")
        say(modes.whyText(state.lastWhy))
        say("\n")
    } else {
        say(if state.last == modes.Last.FAILED_BACK { "; the mode before runs\n" } else { "; what the display shows now is not known\n" })
    }
}

// A decimal number at `text[at.*..]`, `at.*` moved behind it; false when
// there is none.
fn parse(text: []const u8, at: *usize, into: *usize) -> bool {
    var value: usize = 0
    var digits: usize = 0
    while at.* < text.length && text[at.*] >= 48 && text[at.*] <= 57 && digits < 6 {
        value = value * 10 + @intCast(usize, text[at.*] - 48)
        at.* += 1
        digits += 1
    }
    into.* = value
    return digits != 0
}

// "1920x1080", "1920x1080@60", "1920x1080@59.94": the size, and the rate
// in frames in a thousand seconds (0: none named). False for anything
// else.
fn parseMode(text: []const u8, width: *usize, height: *usize, millihertz: *usize) -> bool {
    var at: usize = 0
    millihertz.* = 0
    if !parse(text, &at, width) || at >= text.length || text[at] != 120 { return false }
    at += 1
    if !parse(text, &at, height) { return false }
    if at == text.length { return true }
    if text[at] != 64 { return false }
    at += 1
    var whole: usize = 0
    if !parse(text, &at, &whole) { return false }
    millihertz.* = whole * 1000
    if at < text.length && text[at] == 46 {
        at += 1
        var scale: usize = 100
        while at < text.length && text[at] >= 48 && text[at] <= 57 {
            millihertz.* += @intCast(usize, text[at] - 48) * scale
            scale = scale / 10
            at += 1
        }
    }
    return at == text.length && millihertz.* != 0
}

// The rate to ask for: the listed mode of that size that can be set
// whose rate is nearest to the one named (within a Hz), or, with none
// named, nearest to 60 Hz; 0 (any rate) when the size is not listed (a
// driver that makes any size is asked for the size as such).
fn rateFor(handle: brix.Handle, width: usize, height: usize, named: usize) -> usize {
    const count = modes.list(handle, list[0..])
    const wanted = if named != 0 { named } else { 60000 }
    var best: usize = 0
    var off: usize = 0
    var k: usize = 0
    while k < count {
        const m = &list[k]
        if @intCast(usize, m.*.width) == width && @intCast(usize, m.*.height) == height && m.*.can && m.*.millihertz != 0 {
            const rate = @intCast(usize, m.*.millihertz)
            const by = if rate > wanted { rate - wanted } else { wanted - rate }
            if (named == 0 || by <= 1000) && (best == 0 || by < off) {
                best = rate
                off = by
            }
        }
        k += 1
    }
    return if best != 0 { best } else { named }
}

fn listAll(only: usize, all: bool) -> u8 {
    var shown: usize = 0
    var which: usize = if all { 0 } else { only }
    while which < 8 {
        const opened = modes.open(which)
        if opened < 0 { break }
        const handle = @intCast(brix.Handle, opened)
        var state: modes.State = undefined
        if modes.state(handle, &state) {
            shown += 1
            const count = modes.list(handle, list[0..])
            say("display ")
            number(state.number)
            say(if which == 0 { " (the main one): " } else { ": " })
            sayMode(state.width, state.height, state.millihertz, false)
            say(", ")
            say(driverName(state.driver))
            if state.anySize { say(" (it makes any other size its memory holds too)") }
            if state.pending {
                say("; pending, ")
                number((state.left + 999999999) / 1000000000)
                say(" s left to confirm")
            }
            say("\n")
            var k: usize = 0
            while k < count {
                const m = &list[k]
                say("  ")
                sayMode(@intCast(usize, m.*.width), @intCast(usize, m.*.height), @intCast(usize, m.*.millihertz), m.*.interlaced)
                if m.*.runs { say("  runs now") }
                if m.*.own { say("  the monitor's own") }
                if m.*.kept { say("  set at the next boots") }
                if m.*.before { say("  comes back unless the pending one is confirmed") }
                if !m.*.can && state.settable {
                    say("  cannot be set: ")
                    say(modes.whyText(m.*.why))
                    if m.*.why == modes.Why.TOO_FAST && m.*.limit != 0 {
                        say(" (")
                        number(@intCast(usize, m.*.limit) / 1000)
                        say(" MHz at most)")
                    }
                }
                say("\n")
                k += 1
            }
            if !state.settable {
                say("  none of them can be set while the system runs: ")
                say(modes.whyText(if state.driver == modes.Driver.FIRMWARE { modes.Why.NO_DRIVER } else { modes.Why.OUTPUT }))
                say("\n")
            }
        }
        _ = brix.close(handle)
        if !all { break }
        which += 1
    }
    if shown == 0 {
        say("display: no display (/devices/framebuffer), or a kernel that does not list modes\n")
        return 1
    }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    var first: usize = 1
    var which: usize = 0
    var named = false
    if count >= 3 && std.text.same(std.string.asSlice(std.process.argument(arguments, 1)), "-d") {
        var at: usize = 0
        const text = std.string.asSlice(std.process.argument(arguments, 2))
        if !parse(text, &at, &which) || at != text.length || which > 7 {
            say("usage: display [-d N] [-m] [WIDTHxHEIGHT[@HZ] | ask WIDTHxHEIGHT[@HZ] | confirm | back | state | wait]\n")
            return 2
        }
        first = 3
        named = true
    }
    var mapped = false
    if count > first && std.text.same(std.string.asSlice(std.process.argument(arguments, first)), "-m") {
        mapped = true
        first += 1
    }
    if count == first { return listAll(which, !named) }
    const verb = std.string.asSlice(std.process.argument(arguments, first))
    const opened = modes.open(which)
    if opened < 0 {
        say("display: no such display\n")
        return 1
    }
    const handle = @intCast(brix.Handle, opened)
    var state: modes.State = undefined
    if !modes.state(handle, &state) {
        say("display: this kernel does not list a display's modes\n")
        return 1
    }
    if mapped && brix.mapNode(handle, 0, state.pitch * state.height) < 0 {
        say("display: the display's pixels could not be mapped\n")
        return 1
    }
    if std.text.same(verb, "state") && count == first + 1 {
        sayState(&state)
        return 0
    }
    if std.text.same(verb, "wait") && count == first + 1 {
        _ = modes.waitChanged(handle, brix.FOREVER)
        _ = modes.state(handle, &state)
        sayState(&state)
        return 0
    }
    if std.text.same(verb, "confirm") && count == first + 1 {
        const status = modes.confirm(handle)
        if status < 0 {
            sayWhy(handle, status)
            return 1
        }
        _ = modes.state(handle, &state)
        say("display: confirmed: ")
        sayMode(state.width, state.height, state.millihertz, false)
        say(" stays\n")
        return 0
    }
    if std.text.same(verb, "back") && count == first + 1 {
        const status = modes.takeBack(handle)
        if status < 0 {
            sayWhy(handle, status)
            return 1
        }
        _ = modes.state(handle, &state)
        say("display: taken back: ")
        sayMode(state.width, state.height, state.millihertz, false)
        say(" runs again\n")
        return 0
    }
    const asking = std.text.same(verb, "ask") && count == first + 2
    var width: usize = 0
    var height: usize = 0
    var millihertz: usize = 0
    const text = if asking { std.string.asSlice(std.process.argument(arguments, first + 1)) } else { verb }
    if (!asking && count != first + 1) || !parseMode(text, &width, &height, &millihertz) {
        say("usage: display [-d N] [-m] [WIDTHxHEIGHT[@HZ] | ask WIDTHxHEIGHT[@HZ] | confirm | back | state | wait]\n")
        return 2
    }
    const status = modes.ask(handle, width, height, rateFor(handle, width, height, millihertz))
    if status < 0 {
        sayWhy(handle, status)
        return 1
    }
    _ = modes.state(handle, &state)
    if !state.pending {
        say("display: ")
        sayMode(state.width, state.height, state.millihertz, false)
        say(" runs already\n")
        return 0
    }
    say("display: ")
    sayMode(state.width, state.height, state.millihertz, false)
    say(" runs now")
    if asking {
        say("; `display confirm` within ")
        number((state.left + 999999999) / 1000000000)
        say(" s keeps it, else the mode before comes back\n")
        return 0
    }
    // The question, on the terminal the program was started from: Enter
    // while the time runs keeps the mode.
    say(". Can you read this? Press Enter within ")
    number((state.left + 999999999) / 1000000000)
    say(" seconds to keep it; anything else, or no answer, brings the mode before back.\n")
    const input = brix.handleFor(brix.Role.INPUT)
    var items = [1]brix.WaitItem{ brix.WaitItem.{ .handle = input, .want = brix.State.READABLE, .seen = 0, .reserved = 0 } }
    const until = brix.clock(brix.Clock.MONOTONIC) + state.left
    var answered = false
    var kept = false
    if input != 0 && brix.wait(items[0..1], until) > 0 {
        var line: [64]u8 = undefined
        const got = brix.read(input, line[0..64], brix.STREAM)
        answered = got > 0
        kept = got == 1 && line[0] == 10
    }
    if kept {
        const confirmed = modes.confirm(handle)
        if confirmed < 0 {
            sayWhy(handle, confirmed)
            return 1
        }
        say("display: kept; the next boots set it too\n")
        return 0
    }
    if answered { _ = modes.takeBack(handle) }
    // (Without an answer the kernel takes it back when the time is over.)
    _ = modes.waitChanged(handle, until + 2000000000)
    _ = modes.state(handle, &state)
    say("display: not kept: ")
    sayMode(state.width, state.height, state.millihertz, false)
    say(" runs again\n")
    return 1
}
