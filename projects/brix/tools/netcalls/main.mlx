// netcalls: brixOS's own socket calls (std.os.brix), a line each, for
// tools/check_brix_net.sh: a stream socket listening on our own address,
// another connecting to it (the connection made through the stack's
// loopback), the one wait on their states, bytes both ways, the peer
// closing; a datagram socket sending to itself; a ping socket's echo to
// the gateway; and the links' state as the kernel gives it (a read of
// /devices/net0, std.os.brix's networkLink): driver, hardware address,
// cable, address, gateway, name server, the frames counted.
// `netcalls links` says the links' state alone.
const std = @import("std")
const brix = std.os.brix

fn say(text: []const u8) -> void { _ = brix.write(brix.ofDescriptor(1), text, brix.STREAM) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn line(text: []const u8, value: usize) -> void {
    say(text)
    say(" ")
    number(value)
    say("\n")
}

fn status(result: isize) -> usize { return if result < 0 { @bitCast(usize, -result) } else { 0 } }

fn address(ip: [4]u8) -> void {
    var k: usize = 0
    while k < 4 {
        if k > 0 { say(".") }
        number(@intCast(usize, ip[k]))
        k += 1
    }
}

fn hexByte(value: u8) -> void {
    const digits = "0123456789abcdef"
    var two: [2]u8 = undefined
    two[0] = digits[@intCast(usize, value >> 4)]
    two[1] = digits[@intCast(usize, value & 15)]
    say(two[0..2])
}

// Every link's state (net0, net1, ... until one is not there), then what
// the node itself is: its record's bytes and length word, its kind, a
// read at a position, a write refused.
fn links() -> void {
    var index: usize = 0
    while index < brix.NETWORK_LINKS {
        var link: brix.NetworkLink = undefined
        const result = brix.networkLink(index, &link)
        say(if result < 0 { "no link net" } else { "link net" })
        number(index)
        if result < 0 {
            line(":", status(result))
            break
        }
        say(": ")
        say(link.driver[0..link.driverLength])
        say(" ")
        var k: usize = 0
        while k < 6 {
            if k > 0 { say(":") }
            hexByte(link.hardware[k])
            k += 1
        }
        say(if link.up { " up\n" } else { " no cable\n" })
        line("speed", @intCast(usize, link.speed))
        say(if link.configured == brix.NetworkLink.DHCP { "configured by DHCP" } else if link.configured == brix.NetworkLink.SETTINGS { "configured from the settings" } else { "not configured" })
        say(if link.asking { " (DHCP is asking)\n" } else { "\n" })
        say("address ")
        address(link.address)
        say(" mask ")
        address(link.mask)
        say("\ngateway ")
        address(link.gateway)
        say(" name server ")
        address(link.nameServer)
        say("\nframes received ")
        number(link.received)
        line(" sent", link.sent)
        index += 1
    }
    const opened = brix.open(0, "/devices/net0", brix.Open.READ | brix.Open.WRITE, 0)
    if opened < 0 { return }
    const node = @intCast(brix.Handle, opened)
    var record: [128]u8 = undefined
    const got = brix.read(node, record[0..128], 0)
    say("record: ")
    number(@bitCast(usize, got))
    say(" bytes, its length word ")
    number(@intCast(usize, record[0]) | (@intCast(usize, record[1]) << 8))
    var info: brix.NodeInfo = undefined
    _ = brix.nodeInfo(node, &info)
    line(", kind", @intCast(usize, info.kind))
    var four: [4]u8 = undefined
    line("read at 32", @bitCast(usize, brix.read(node, four[0..4], 32)))
    say("there: ")
    address(four)
    say("\n")
    line("read past the end", @bitCast(usize, brix.read(node, four[0..4], 64)))
    line("write refused", status(brix.write(node, "x", 0)))
    _ = brix.close(node)
}

// Waits until `handle` shows one of `want` (a second at most): the state seen.
fn until(handle: brix.Handle, want: u32) -> u32 {
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = handle, .want = want, .seen = 0, .reserved = 0 } }
    _ = brix.wait(items[0..1], brix.clock(brix.Clock.MONOTONIC) + 1000000000)
    return items[0].seen
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length > 1 && std.text.same(std.text.cString(arguments[1]), "links") {
        links()
        say("done\n")
        return 0
    }
    say("socket calls\n")
    // Our own address, from a socket's info.
    const probe = brix.socketOpen(brix.SocketKind.DATAGRAM)
    if probe < 0 {
        line("no network", status(probe))
        return 1
    }
    var info: brix.SocketInfo = undefined
    _ = brix.socketInfo(@intCast(brix.Handle, probe), &info)
    const own = info.local.address
    _ = brix.close(@intCast(brix.Handle, probe))

    // A stream socket listening on port 4711, one connecting to it.
    const listener = @intCast(brix.Handle, brix.socketOpen(brix.SocketKind.STREAM))
    var kind = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
    _ = brix.info(listener, &kind)
    line("socket kind", @intCast(usize, kind.kind))
    line("bind 4711", status(brix.socketBind(listener, 4711)))
    line("listen", status(brix.socketListen(listener)))
    const client = @intCast(brix.Handle, brix.socketOpen(brix.SocketKind.STREAM))
    const to = brix.SocketAddress.{ .address = own, .port = 4711 }
    line("connect", status(brix.socketConnect(client, &to)))
    line("client writable (connected)", @intCast(usize, until(client, brix.State.WRITABLE | brix.State.PEER_GONE) & (brix.State.WRITABLE | brix.State.PEER_GONE)))
    line("listener readable (a connection waits)", @intCast(usize, until(listener, brix.State.READABLE) & brix.State.READABLE))
    var peer: brix.SocketAddress = undefined
    const accepted = brix.socketAccept(listener, &peer)
    line("accept", status(accepted))
    const server = @intCast(brix.Handle, accepted)
    say(if peer.address[0] == own[0] && peer.address[3] == own[3] { "the peer is ourselves\n" } else { "the peer is someone else\n" })
    line("send hello", @bitCast(usize, brix.socketSend(client, "hello", null)))
    _ = until(server, brix.State.READABLE)
    var buffer: [32]u8 = undefined
    const got = brix.socketReceive(server, buffer[0..32], null)
    line("received", @bitCast(usize, got))
    say(buffer[0..@bitCast(usize, got)])
    say("\n")
    line("answer", @bitCast(usize, brix.write(server, "world", brix.STREAM)))
    _ = until(client, brix.State.READABLE)
    line("read", @bitCast(usize, brix.read(client, buffer[0..32], brix.STREAM)))
    _ = brix.close(server)
    line("client sees the end (peer gone)", @intCast(usize, until(client, brix.State.PEER_GONE) & brix.State.PEER_GONE))
    line("receive at the end", @bitCast(usize, brix.socketReceive(client, buffer[0..32], null)))
    _ = brix.close(client)
    _ = brix.close(listener)

    // A datagram to ourselves.
    const datagram = @intCast(brix.Handle, brix.socketOpen(brix.SocketKind.DATAGRAM))
    line("bind 4712", status(brix.socketBind(datagram, 4712)))
    const self = brix.SocketAddress.{ .address = own, .port = 4712 }
    line("datagram sent", @bitCast(usize, brix.socketSend(datagram, "ping?", &self)))
    _ = until(datagram, brix.State.READABLE)
    var from: brix.SocketAddress = undefined
    line("datagram received", @bitCast(usize, brix.socketReceive(datagram, buffer[0..32], &from)))
    line("from port", @intCast(usize, from.port))
    _ = brix.close(datagram)

    // An echo to the gateway (QEMU's user network answers).
    const ping = @intCast(brix.Handle, brix.socketOpen(brix.SocketKind.PING))
    var echo: [16]u8 = undefined
    var k: usize = 0
    while k < 16 {
        echo[k] = 0
        k += 1
    }
    echo[0] = 8
    echo[7] = 1
    const gateway = brix.SocketAddress.{ .address = [4]u8{ 10, 0, 2, 2 }, .port = 0 }
    line("echo sent", @bitCast(usize, brix.socketSend(ping, echo[0..16], &gateway)))
    const seen = until(ping, brix.State.READABLE)
    line("echo answered", @intCast(usize, seen & brix.State.READABLE))
    const reply = brix.socketReceive(ping, buffer[0..32], &from)
    line("reply bytes", @bitCast(usize, reply))
    say(if reply >= 8 && buffer[0] == 0 { "an echo reply\n" } else { "not an echo reply\n" })
    // (From the gateway it was sent to: a ping socket's destination is
    // the address alone, its port 0.)
    say("echo from ")
    address(from.address)
    say("\n")
    _ = brix.close(ping)
    links()
    say("done\n")
    return 0
}
