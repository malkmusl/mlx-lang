// An HTTP request's head as logserve reads it: the request line (a
// method, a target, HTTP/1.0 or 1.1) and header lines up to an empty
// line, all within LIMIT bytes. Only the method and the target's path
// count; the headers are not looked at, and nothing after the head is
// read as a request (no connection is kept for a second one).
const std = @import("std")

// The most bytes a request's head may have.
pub const LIMIT: usize = 2048
// The longest method there is a word for.
const METHOD: usize = 16

pub const Verdict = enum(u8) {
    // The head has not ended yet: more bytes are waited for.
    more,
    // GET or HEAD: `path` is answered.
    served,
    // Another method: refused.
    otherMethod,
    // Not an HTTP/1 request.
    malformed,
    // No end of the head within LIMIT bytes.
    tooLong,
}

pub const Request = struct {
    verdict: Verdict
    // HEAD: the answer's head alone.
    headOnly: bool
    // (Parts of the bytes read; empty where the verdict has none.)
    method: []const u8
    // The target up to its query: what is looked up among the pages.
    path: []const u8
}

fn verdict(what: Verdict) -> Request {
    return Request.{ .verdict = what, .headOnly = false, .method = "", .path = "" }
}

fn isUpper(byte: u8) -> bool { return byte >= 65 && byte <= 90 }

// Where the head ends in `bytes` (after its empty line: CR LF CR LF, or
// bare line feeds as a person types them), or 0 when it does not yet.
fn headEnd(bytes: []const u8) -> usize {
    var k: usize = 0
    while k < bytes.length {
        if bytes[k] == 10 {
            if k + 1 < bytes.length && bytes[k + 1] == 10 { return k + 2 }
            if k + 2 < bytes.length && bytes[k + 1] == 13 && bytes[k + 2] == 10 { return k + 3 }
        }
        k += 1
    }
    return 0
}

// What the bytes read so far are.
pub fn read(bytes: []const u8) -> Request {
    // What cannot become a method is refused at once (a TLS greeting,
    // say), without waiting for a line's end.
    var k: usize = 0
    while k < bytes.length && bytes[k] != 32 {
        if !isUpper(bytes[k]) || k >= METHOD { return verdict(Verdict.malformed) }
        k += 1
    }
    if headEnd(bytes) == 0 { return verdict(if bytes.length >= LIMIT { Verdict.tooLong } else { Verdict.more }) }
    // The request line: METHOD, a blank, the target, a blank, HTTP/1.x.
    var end: usize = 0
    while bytes[end] != 10 { end += 1 }
    if end > 0 && bytes[end - 1] == 13 { end -= 1 }
    const line = bytes[0..end]
    var first: usize = 0
    while first < line.length && line[first] != 32 { first += 1 }
    var second = first + 1
    while second < line.length && line[second] != 32 { second += 1 }
    if first == 0 || second >= line.length || second == first + 1 { return verdict(Verdict.malformed) }
    const version = line[second + 1..line.length]
    if version.length != 8 || !std.text.startsWith(version, "HTTP/1.") || (version[7] != 48 && version[7] != 49) { return verdict(Verdict.malformed) }
    const method = line[0..first]
    const target = line[first + 1..second]
    var cut: usize = 0
    while cut < target.length && target[cut] != 63 && target[cut] != 35 { cut += 1 }
    const head = std.text.same(method, "HEAD")
    if !head && !std.text.same(method, "GET") {
        return Request.{ .verdict = Verdict.otherMethod, .headOnly = false, .method = method, .path = target[0..cut] }
    }
    // (A target that is not a path, a proxy's http://..., is not served.)
    if target[0] != 47 { return verdict(Verdict.malformed) }
    return Request.{ .verdict = Verdict.served, .headOnly = head, .method = method, .path = target[0..cut] }
}
