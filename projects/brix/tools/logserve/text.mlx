// A text that grows as its parts are added: an answer's bytes (the kernel
// log is a quarter of a megabyte, /all several of that), from the
// program's heap and given back when the answer has gone.
const std = @import("std")

pub const Text = struct {
    bytes: [*]u8
    length: usize
    // The bytes there is room for (0: nothing taken from the heap yet).
    capacity: usize
    // The heap had no more: what was added since is missing.
    short: bool

    pub fn init(self: *Self) -> void {
        self.*.length = 0
        self.*.capacity = 0
        self.*.short = false
    }

    pub fn deinit(self: *Self) -> void {
        if self.*.capacity > 0 { std.heap.allocator().free(self.*.bytes, self.*.capacity, 1) }
        self.init()
    }

    // Room for `more` bytes after those there are; false when the heap
    // has none.
    pub fn reserve(self: *Self, more: usize) -> bool {
        if self.*.length + more <= self.*.capacity { return true }
        var wanted: usize = if self.*.capacity == 0 { 4096 } else { self.*.capacity * 2 }
        while wanted < self.*.length + more { wanted *= 2 }
        const grown = std.heap.allocator().alloc(wanted, 1)
        if grown == null {
            self.*.short = true
            return false
        }
        var k: usize = 0
        while k < self.*.length {
            grown.?[k] = self.*.bytes[k]
            k += 1
        }
        if self.*.capacity > 0 { std.heap.allocator().free(self.*.bytes, self.*.capacity, 1) }
        self.*.bytes = grown.?
        self.*.capacity = wanted
        return true
    }

    pub fn add(self: *Self, text: []const u8) -> void {
        if !self.reserve(text.length) { return }
        var k: usize = 0
        while k < text.length {
            self.*.bytes[self.*.length + k] = text[k]
            k += 1
        }
        self.*.length += text.length
    }

    pub fn number(self: *Self, value: usize) -> void {
        var digits: [20]u8 = undefined
        var at: usize = 20
        var rest = value
        while true {
            at -= 1
            digits[at] = @intCast(u8, 48 + rest % 10)
            rest = rest / 10
            if rest == 0 { break }
        }
        self.add(digits[at..20])
    }

    // An IPv4 address as a.b.c.d.
    pub fn address(self: *Self, ip: [4]u8) -> void {
        var k: usize = 0
        while k < 4 {
            if k > 0 { self.add(".") }
            self.number(@intCast(usize, ip[k]))
            k += 1
        }
    }

    // The bytes there are.
    pub fn slice(self: *const Self) -> []const u8 {
        if self.*.length == 0 { return "" }
        return self.*.bytes[0..self.*.length]
    }
}
