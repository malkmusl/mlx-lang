// What logserve gives, each a text made when it is asked for: the kernel
// log (/devices/klog), its "gpu:" lines, the logs klogsave wrote to the
// mounted volumes, the machine's figures (system_info, as sysinfo says
// them) with the network links' records in words, a page that lists
// these, and all of them in one text. The pages are these fixed ones: a
// request's path is looked up among their names and never opened as a
// file.
const std = @import("std")
const brix = std.os.brix
const Text = @import("./text.mlx").Text
const report = @import("../sysinfo/report.mlx")

pub const Page = enum(u8) { none, index, all, klog, gpu, bootLog, previousLog, system }

const KLOG = "/devices/klog\x00"
const VOLUMES = "/volumes\x00"
const BOOT_LOG = "boot.log"
const PREVIOUS_LOG = "boot.previous.log"
// The most of a file that is given: a megabyte (the kernel's log, and so
// a saved one, is a quarter of that at most), read a piece at a time.
const FILE_LIMIT: usize = 1 << 20
const PIECE: usize = 65536
// What was read of a file: nothing (it cannot be opened), all of it, or
// its first megabyte.
const Read = enum(u8) { none, whole, cut }
// The most volumes whose saved logs are given.
const MAX_SAVED: usize = 8
const PATH: usize = 256

// The page a request's path names; `none` for every other path.
pub fn find(path: []const u8) -> Page {
    if std.text.same(path, "/") { return Page.index }
    if std.text.same(path, "/all") { return Page.all }
    if std.text.same(path, "/klog") { return Page.klog }
    if std.text.same(path, "/gpu") { return Page.gpu }
    if std.text.same(path, "/boot.log") { return Page.bootLog }
    if std.text.same(path, "/boot.previous.log") { return Page.previousLog }
    if std.text.same(path, "/system") { return Page.system }
    return Page.none
}

// What a browser is told the page is.
pub fn kind(page: Page) -> []const u8 {
    return if page == Page.index { "text/html; charset=utf-8" } else { "text/plain; charset=utf-8" }
}

// The page's text into `into`: true, or false when there is nothing of
// it on this machine (the text says so then).
pub fn build(page: Page, into: *Text) -> bool {
    if page == Page.index {
        index(into)
        return true
    }
    if page == Page.all {
        all(into)
        return true
    }
    if page == Page.klog {
        if addFile(into, KLOG.pointer) != Read.none { return true }
        into.add("no kernel log here: /devices/klog cannot be opened\n")
        return false
    }
    if page == Page.gpu {
        var log: Text = undefined
        log.init()
        const there = addFile(&log, KLOG.pointer) != Read.none
        if there && gpuLines(log.slice(), into) == 0 { into.add("(no line of the kernel log begins with \"gpu:\": the graphics driver found no card of its own at boot)\n") }
        if !there { into.add("no kernel log here: /devices/klog cannot be opened\n") }
        // (A log the heap had no room for: the answer is not whole.)
        if log.short { into.*.short = true }
        log.deinit()
        return there
    }
    if page == Page.bootLog { return saved(into, BOOT_LOG) }
    if page == Page.previousLog { return saved(into, PREVIOUS_LOG) }
    if page == Page.system {
        system(into)
        return true
    }
    into.add("logserve has no such page. It has: / /all /gpu /klog /boot.log /boot.previous.log /system\n")
    return false
}

fn index(into: *Text) -> void {
    into.add("<!doctype html>\n<title>brixOS: this machine's logs</title>\n<pre>\n")
    into.add("brixOS: this machine's logs (logserve, read-only)\n\n")
    into.add("<a href=\"/all\">/all</a>                everything below in one text: the one to copy and send\n")
    into.add("<a href=\"/gpu\">/gpu</a>                the kernel log's lines that begin with \"gpu:\" (the graphics driver's read-out)\n")
    into.add("<a href=\"/klog\">/klog</a>               the kernel log, whole\n")
    into.add("<a href=\"/boot.log\">/boot.log</a>           the kernel log as klogsave wrote it to the disk at this boot\n")
    into.add("<a href=\"/boot.previous.log\">/boot.previous.log</a>  the same of the boot before\n")
    into.add("<a href=\"/system\">/system</a>             memory, processors, uptime, the kernel's counts; the network links\n")
    into.add("</pre>\n")
}

// The file at `path` (NUL-terminated) added to `into`, FILE_LIMIT bytes
// of it at most.
fn addFile(into: *Text, path: [*]const u8) -> Read {
    const file = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return Read.none }
    var taken: usize = 0
    while taken < FILE_LIMIT {
        const piece = if FILE_LIMIT - taken < PIECE { FILE_LIMIT - taken } else { PIECE }
        if !into.reserve(piece) { break }
        const room = unsafe { @ptrFromInt([*]u8, @intFromPtr(into.*.bytes) + into.*.length) }
        const got = std.fs.read(file, room, piece)
        if got <= 0 { break }
        into.*.length += @bitCast(usize, got)
        taken += @bitCast(usize, got)
    }
    // (More of it after the megabyte: one byte says so.)
    var one: [1]u8 = undefined
    const more = taken == FILE_LIMIT && std.fs.read(file, &one, 1) > 0
    _ = std.fs.close(file)
    return if more { Read.cut } else { Read.whole }
}

// The lines of `log` that begin with "gpu:" added to `into`; how many.
pub fn gpuLines(log: []const u8, into: *Text) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < log.length {
        var end = at
        while end < log.length && log[end] != 10 { end += 1 }
        if std.text.startsWith(log[at..end], "gpu:") {
            into.add(log[at..end])
            into.add("\n")
            count += 1
        }
        at = end + 1
    }
    return count
}

// A saved log's path (NUL-terminated) and its length.
const Saved = struct {
    path: [PATH]u8
    length: usize
}

// Whether the directory at `path` (NUL-terminated) has a file called
// `name`: a file of its own, not a link that leads somewhere else, nor a
// directory.
fn hasFile(path: [*]const u8, name: []const u8) -> bool {
    const directory = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(directory) { return false }
    var listed: [4096]u8 = undefined
    const records: [*]u8 = &listed
    var reader = std.fs.entries(directory, records, 4096)
    var entry: std.fs.Entry = undefined
    var found = false
    while !found && std.fs.nextEntry(&reader, &entry) {
        found = entry.kind == std.fs.ENTRY_FILE && std.text.same(entry.name.pointer[0..entry.name.length], name)
    }
    _ = std.fs.close(directory)
    return found
}

// The files called `name` at the top of the mounted volumes
// (/volumes/*/NAME: where klogsave writes): their paths into `found`;
// how many there are.
fn savedLogs(name: []const u8, found: *[MAX_SAVED]Saved) -> usize {
    const directory = std.fs.open(VOLUMES.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(directory) { return 0 }
    var listed: [4096]u8 = undefined
    const records: [*]u8 = &listed
    var reader = std.fs.entries(directory, records, 4096)
    var entry: std.fs.Entry = undefined
    var count: usize = 0
    while count < MAX_SAVED && std.fs.nextEntry(&reader, &entry) {
        const volume = entry.name
        if std.fs.isDotName(volume) || 9 + volume.length + 1 + name.length + 1 > PATH { continue }
        const path: [*]u8 = &found.*[count].path
        var length = std.text.append(path, 0, PATH, "/volumes/")
        length = std.text.append(path, length, PATH, volume.pointer[0..volume.length])
        path[length] = 0
        if !hasFile(path, name) { continue }
        length = std.text.append(path, length, PATH, "/")
        length = std.text.append(path, length, PATH, name)
        path[length] = 0
        found.*[count].length = length
        count += 1
    }
    _ = std.fs.close(directory)
    return count
}

// A line's end where the text's last line has none.
fn endLine(into: *Text) -> void {
    if into.*.length > 0 && into.*.bytes[into.*.length - 1] != 10 { into.add("\n") }
}

// The page of a saved log: the file as it is; where more than one
// volume has it, each after a line that names it.
fn saved(into: *Text, name: []const u8) -> bool {
    var found: [MAX_SAVED]Saved = undefined
    const count = savedLogs(name, &found)
    if count == 0 {
        into.add("no ")
        into.add(name)
        into.add(" on a mounted volume (klogsave writes the boot's logs to the brixfs volumes)\n")
        return false
    }
    var k: usize = 0
    while k < count {
        if count > 1 {
            endLine(into)
            into.add("==== ")
            into.add(found[k].path[0..found[k].length])
            into.add(" ====\n")
        }
        _ = addFile(into, &found[k].path)
        k += 1
    }
    return true
}

// Where sysinfo's report goes (it says its pieces to a function).
var reportInto: *Text = undefined // (per run)
fn reportSay(text: []const u8) -> void { reportInto.add(text) }

// The machine's figures and its network links.
fn system(into: *Text) -> void {
    var info: brix.SystemInfo = undefined
    const words = brix.systemInfo(&info)
    if words < 0 {
        into.add("no system_info here (this is not brixOS)\n")
    } else {
        reportInto = into
        report.write(reportSay, &info, @bitCast(usize, words))
    }
    var index: usize = 0
    while index < brix.NETWORK_LINKS {
        var link: brix.NetworkLink = undefined
        if brix.networkLink(index, &link) < 0 { break }
        linkWords(into, index, &link)
        index += 1
    }
    if index == 0 { into.add("no network link (/devices/net0 is not there)\n") }
}

fn hexByte(into: *Text, value: u8) -> void {
    const digits = "0123456789abcdef"
    var two: [2]u8 = undefined
    two[0] = digits[@intCast(usize, value >> 4)]
    two[1] = digits[@intCast(usize, value & 15)]
    into.add(two[0..2])
}

fn linkName(into: *Text, index: usize) -> void {
    into.add("net")
    into.number(index)
    into.add(": ")
}

// "none" for an address of 0.0.0.0 (a gateway or a name server the
// configuration came without).
fn addressOrNone(into: *Text, address: [4]u8) -> void {
    if address[0] == 0 && address[1] == 0 && address[2] == 0 && address[3] == 0 { into.add("none") } else { into.address(address) }
}

// A network link's record in words: the device and its cable, the
// address and where it is from, the frames counted.
pub fn linkWords(into: *Text, index: usize, link: *const brix.NetworkLink) -> void {
    linkName(into, index)
    into.add(link.*.driver[0..link.*.driverLength])
    into.add(", hardware address ")
    var k: usize = 0
    while k < 6 {
        if k > 0 { into.add(":") }
        hexByte(into, link.*.hardware[k])
        k += 1
    }
    if !link.*.up {
        into.add(", no cable\n")
    } else if link.*.speed == 0 {
        into.add(", cable connected\n")
    } else {
        into.add(", cable connected, ")
        into.number(@intCast(usize, link.*.speed))
        into.add(" Mbit/s\n")
    }
    linkName(into, index)
    if link.*.configured == brix.NetworkLink.NONE {
        into.add(if link.*.asking { "no address yet (DHCP is asking)\n" } else { "no address\n" })
    } else {
        into.add("address ")
        into.address(link.*.address)
        into.add(", netmask ")
        into.address(link.*.mask)
        into.add(", gateway ")
        addressOrNone(into, link.*.gateway)
        into.add(", name server ")
        addressOrNone(into, link.*.nameServer)
        into.add(if link.*.configured == brix.NetworkLink.DHCP { " (by DHCP)\n" } else { " (from /system/settings/network)\n" })
    }
    linkName(into, index)
    into.number(link.*.received)
    into.add(" frames received, ")
    into.number(link.*.sent)
    into.add(" sent\n")
}

// Whether `log` is the first bytes of `whole` (a log saved at boot is
// the beginning of the kernel's log as it is now).
pub fn isStartOf(log: []const u8, whole: []const u8) -> bool {
    return log.length <= whole.length && std.text.same(log, whole[0..log.length])
}

fn heading(into: *Text, name: []const u8, what: []const u8) -> void {
    endLine(into)
    into.add("==== ")
    into.add(name)
    into.add(": ")
    into.add(what)
}

// The saved logs called `name` as parts of the one text: each after a
// heading with its path and size; one that is the beginning of the
// kernel's log `klog` is named and not repeated.
fn savedParts(into: *Text, page: []const u8, name: []const u8, klog: []const u8) -> void {
    var found: [MAX_SAVED]Saved = undefined
    const count = savedLogs(name, &found)
    if count == 0 {
        heading(into, page, "none on a mounted volume ====\n")
        return
    }
    var k: usize = 0
    while k < count {
        var log: Text = undefined
        log.init()
        const read = addFile(&log, &found[k].path)
        heading(into, page, found[k].path[0..found[k].length])
        into.add(" (")
        into.number(log.length)
        if klog.length > 0 && log.length > 0 && isStartOf(log.slice(), klog) {
            into.add(" bytes: the kernel log's first bytes above, not repeated) ====\n")
        } else {
            into.add(if read == Read.cut { " bytes: its first megabyte) ====\n" } else { " bytes) ====\n" })
            into.add(log.slice())
        }
        if log.short { into.*.short = true }
        log.deinit()
        k += 1
    }
}

// Everything in one text, a heading line before each part and a line
// at the end (a copy that lacks it was cut short).
fn all(into: *Text) -> void {
    var klog: Text = undefined
    klog.init()
    const read = addFile(&klog, KLOG.pointer)
    heading(into, "/system", "the machine and its network links ====\n")
    system(into)
    var lines: Text = undefined
    lines.init()
    const count = gpuLines(klog.slice(), &lines)
    heading(into, "/gpu", "the kernel log's lines that begin with \"gpu:\" (")
    into.number(count)
    into.add(") ====\n")
    into.add(lines.slice())
    if lines.short { into.*.short = true }
    lines.deinit()
    if read != Read.none {
        heading(into, "/klog", "the kernel log (")
        into.number(klog.length)
        into.add(if read == Read.cut { " bytes: its first megabyte) ====\n" } else { " bytes) ====\n" })
        into.add(klog.slice())
    } else {
        heading(into, "/klog", "no kernel log here (/devices/klog cannot be opened) ====\n")
    }
    savedParts(into, "/boot.log", BOOT_LOG, klog.slice())
    savedParts(into, "/boot.previous.log", PREVIOUS_LOG, "")
    if klog.short { into.*.short = true }
    klog.deinit()
    endLine(into)
    into.add("==== end ====\n")
}
