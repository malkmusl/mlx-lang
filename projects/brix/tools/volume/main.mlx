// volume: the volume a path is on, as the kernel keeps it (volume_info,
// call 56): its size and what is free, and what the store did on it since
// it was mounted. How a large disk is doing shows here: the mount's time,
// the commits', and whether the free blocks are found by walking the
// whole volume.
//
//   volume [PATH]           (PATH: the working directory unless named)
//
//   /volumes/disk0: brixfs, 131072000 blocks of 4096 bytes, 131068053 free (generation 7)
//   mounted in 48.2 ms; 6 commits, the last 0.4 ms, the longest 11.9 ms
//   its roots walked 1 times, the last in 26.1 ms; 148 blocks read, 2204 written
//   a commit frees what it replaced
//
//   volume --figures PATH   the same as name=value words on one line (times
//                           in microseconds), for a script
//   volume --ask N PATH     the size and the free room asked N times, once
//                           by volume_info and once by the Linux layer's
//                           statfs: how long each took (given up after 20
//                           seconds; the questions are counted)
//   volume --check PATH     user 0: what changed is committed, the free
//                           blocks are found again by a walk over every
//                           root and compared with what the store held.
//                           Exits 1 when a block in use was not held.
const std = @import("std")
const brix = std.os.brix
const crash = @import("std.crash")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

// Nanoseconds as milliseconds with a tenth.
fn milliseconds(nanoseconds: usize) -> void {
    number(nanoseconds / 1000000)
    say(".")
    number((nanoseconds / 100000) % 10)
    say(" ms")
}

fn word(name: []const u8, value: usize) -> void {
    say(name)
    say("=")
    number(value)
    say(" ")
}

fn fail(text: []const u8) -> u8 {
    _ = std.io.writeAll(std.io.stderr(), "volume: ")
    _ = std.io.writeAll(std.io.stderr(), text)
    _ = std.io.writeAll(std.io.stderr(), "\n")
    return 1
}

fn usage() -> u8 {
    _ = std.io.writeAll(std.io.stderr(), "usage: volume [PATH] | volume --figures PATH | volume --ask N PATH | volume --check PATH\n")
    return 2
}

fn ask(path: []const u8, into: *brix.VolumeInfo, flags: usize) -> bool {
    into.*.unreached = 0
    into.*.unheld = 0
    return brix.volumeInfo(0, path, into, flags) >= 17
}

// The question N times, each way: what a program that shows the free
// room pays for it.
fn askMany(path: []const u8, times: usize) -> u8 {
    const limit: usize = 20000000000
    var info: brix.VolumeInfo = undefined
    var start = brix.clock(brix.Clock.MONOTONIC)
    var asked: usize = 0
    while asked < times && brix.clock(brix.Clock.MONOTONIC) - start < limit {
        if !ask(path, &info, 0) { return fail("the kernel has no volume_info (not brixOS?), or the path names nothing") }
        asked += 1
    }
    say("volume_info: asked ")
    number(asked)
    say(" of ")
    number(times)
    say(" times in ")
    number((brix.clock(brix.Clock.MONOTONIC) - start) / 1000)
    say(" us\n")
    var status: std.fs.FileSystemStat = undefined
    start = brix.clock(brix.Clock.MONOTONIC)
    var answered: usize = 0
    while answered < times && brix.clock(brix.Clock.MONOTONIC) - start < limit {
        if std.linux.syscall2(std.linux.SYS_statfs, @intFromPtr(path.pointer), @intFromPtr(&status)) != 0 { return fail("statfs does not answer") }
        answered += 1
    }
    say("statfs: asked ")
    number(answered)
    say(" of ")
    number(times)
    say(" times in ")
    number((brix.clock(brix.Clock.MONOTONIC) - start) / 1000)
    say(" us\n")
    if status.blocks != info.blocks || status.blocksFree != info.free { return fail("statfs and volume_info do not say the same") }
    return if asked == times && answered == times { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const count = std.process.count(arguments)
    var mode: []const u8 = ""
    var at: usize = 1
    if count > 1 {
        const first = std.string.asSlice(std.process.argument(arguments, 1))
        if first.length > 2 && first[0] == 45 && first[1] == 45 {
            mode = first
            at = 2
        }
    }
    var times: usize = 0
    if std.text.same(mode, "--ask") {
        if count != 4 { return usage() }
        for digit in std.string.asSlice(std.process.argument(arguments, 2)) {
            if digit < 48 || digit > 57 { return usage() }
            times = times * 10 + @intCast(usize, digit - 48)
        }
        at = 3
    } else if mode.length > 0 && !std.text.same(mode, "--figures") && !std.text.same(mode, "--check") {
        return usage()
    }
    if count > at + 1 || (mode.length > 0 && count != at + 1) { return usage() }
    // (The path is NUL-terminated: an argument, or these two bytes.)
    const here = [2]u8{ 46, 0 }
    var path: []const u8 = here[0..1]
    if count > at { path = std.string.asSlice(std.process.argument(arguments, at)) }
    if std.text.same(mode, "--ask") { return askMany(path, times) }
    var info: brix.VolumeInfo = undefined
    if std.text.same(mode, "--check") {
        const words = brix.volumeInfo(0, path, &info, brix.VolumeInfo.CHECK)
        if words == -brix.Status.no_right { return fail("only user 0 may have a volume walked") }
        if words < 19 { return fail("the volume cannot be checked (no brixfs volume, no memory for a second map, or a block that cannot be read)") }
        if info.kind != brix.VolumeInfo.BRIXFS { return fail("no brixfs volume there") }
        say("checked: ")
        number(info.unreached)
        say(" blocks held that no root reaches, ")
        number(info.unheld)
        say(" reached and not held; ")
        number(info.free)
        say(" of ")
        number(info.blocks)
        say(" free\n")
        return if info.unheld == 0 { 0 } else { 1 }
    }
    if !ask(path, &info, 0) { return fail("the kernel has no volume_info (not brixOS?), or the path names nothing") }
    if std.text.same(mode, "--figures") {
        word("kind", info.kind)
        word("blocks", info.blocks)
        word("free", info.free)
        word("generation", info.generation)
        word("exact", info.exact)
        word("mount_us", info.mountTime / 1000)
        word("commits", info.commits)
        word("commit_us", info.commitTime / 1000)
        word("longest_commit_us", info.longestCommit / 1000)
        word("walks", info.walks)
        word("walk_us", info.walkTime / 1000)
        word("read", info.blocksRead)
        say("written=")
        number(info.blocksWritten)
        say("\n")
        return 0
    }
    say(path)
    say(if info.kind == brix.VolumeInfo.BRIXFS { ": brixfs, " } else { ": memory, " })
    number(info.blocks)
    say(" blocks of ")
    number(info.blockSize)
    say(" bytes, ")
    number(info.free)
    say(" free")
    if info.kind != brix.VolumeInfo.BRIXFS {
        say("\n")
        return 0
    }
    say(" (generation ")
    number(info.generation)
    say(if info.readOnly != 0 { ", read-only)\nmounted in " } else { ")\nmounted in " })
    milliseconds(info.mountTime)
    say("; ")
    number(info.commits)
    say(" commits, the last ")
    milliseconds(info.commitTime)
    say(", the longest ")
    milliseconds(info.longestCommit)
    say("\nits roots walked ")
    number(info.walks)
    say(" times, the last in ")
    milliseconds(info.walkTime)
    say("; ")
    number(info.blocksRead)
    say(" blocks read, ")
    number(info.blocksWritten)
    say(" written\n")
    say(if info.exact != 0 { "a commit frees what it replaced\n" } else { "the free blocks are found by a walk over every root after each commit (snapshots without memory for their map, or a volume brixfs check should see)\n" })
    return 0
}
