// native: brixOS's own calls (std.os.brix), a line each, for
// tools/check_brix.sh: a handle's kind and rights, the one wait (on an
// empty pipe until its deadline, then readable, then the writer gone),
// streaming and positioned reads and writes, a closed handle, the clock,
// the network link a machine without a network device has none of, the
// processes (process_list: this one among them, running, by its name;
// process_open: a handle to itself, none to a pid no process has); it
// ends by process_exit with 7. The pipe and the file come from the Linux
// layer: a descriptor's handle is its number plus one.
const std = @import("std")
const brix = std.os.brix
const linux = std.os.linux

const SYS_pipe: usize = 22
const SYS_getpid: usize = 39
const SYS_openat: usize = 257
const AT_FDCWD: usize = 0xFFFFFFFFFFFFFF9C
const CREATE_READ_WRITE: usize = 0x242

fn say(text: []const u8) -> void { _ = brix.write(brix.ofDescriptor(1), text, brix.STREAM) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn line(text: []const u8, value: usize) -> void {
    say(text)
    say(" ")
    number(value)
    say("\n")
}

fn status(result: isize) -> usize { return if result < 0 { @bitCast(usize, -result) } else { 0 } }

pub fn main() -> u8 {
    say("native calls\n")
    var info = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
    _ = brix.info(brix.ofDescriptor(1), &info)
    line("output kind (session)", @intCast(usize, info.kind))
    say(if info.rights & brix.Rights.WRITE != 0 { "output writable\n" } else { "output not writable\n" })

    var ends: [2]u32 = [2]u32{ 0, 0 }
    _ = linux.syscall1(SYS_pipe, @intFromPtr(&ends))
    const reader = brix.ofDescriptor(@intCast(isize, ends[0]))
    const writer = brix.ofDescriptor(@intCast(isize, ends[1]))
    _ = brix.info(reader, &info)
    line("pipe kind (stream)", @intCast(usize, info.kind))

    // An empty pipe: no wait, then a wait of 50 ms.
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = reader, .want = brix.State.READABLE | brix.State.PEER_GONE, .seen = 0, .reserved = 0 } }
    var figures: brix.SystemInfo = undefined
    line("system info words", @bitCast(usize, brix.systemInfo(&figures)))
    say(if figures.memory >= 128 * 1024 * 1024 && figures.free < figures.memory && figures.processors >= 1 { "memory, free and processors make sense\n" } else { "the system figures are off\n" })
    line("wait now (timed out)", status(brix.wait(items[0..1], 0)))
    const before = brix.clock(brix.Clock.MONOTONIC)
    const waited = brix.wait(items[0..1], before + 50000000)
    const elapsed = brix.clock(brix.Clock.MONOTONIC) - before
    line("wait 50 ms (timed out)", status(waited))
    say(if elapsed >= 50000000 { "the deadline held\n" } else { "the deadline was early\n" })

    _ = brix.write(writer, "x", brix.STREAM)
    line("ready after a write", @bitCast(usize, brix.wait(items[0..1], brix.FOREVER)))
    line("seen (readable)", @intCast(usize, items[0].seen))
    var byte: [1]u8 = [1]u8{ 0 }
    line("read", @bitCast(usize, brix.read(reader, byte[0..1], brix.STREAM)))
    say(if byte[0] == 120 { "it was x\n" } else { "it was not x\n" })
    _ = brix.close(writer)
    _ = brix.wait(items[0..1], brix.FOREVER)
    line("seen after the writer closed (readable, peer gone)", @intCast(usize, items[0].seen))

    // Positioned writes and reads: no cursor in the kernel.
    const descriptor = linux.syscall4(SYS_openat, AT_FDCWD, @intFromPtr("/tmp/native.txt"), CREATE_READ_WRITE, 420)
    const file = brix.ofDescriptor(descriptor)
    _ = brix.write(file, "hello world", 0)
    _ = brix.write(file, "brix!", 6)
    var five: [5]u8 = undefined
    _ = brix.read(file, five[0..5], 6)
    say(five[0..5])
    say("\n")
    var start: [5]u8 = undefined
    _ = brix.read(file, start[0..5], 0)
    say(start[0..5])
    say("\n")
    _ = brix.info(file, &info)
    line("file kind (node)", @intCast(usize, info.kind))

    // The writer's slot holds the file now; its old handle stays invalid.
    line("the closed writer's handle (invalid handle)", status(brix.close(writer)))
    say(if brix.ofDescriptor(@intCast(isize, ends[1])) == file { "the file is in the writer's slot\n" } else { "the file is elsewhere\n" })
    say(if file != writer { "under another handle\n" } else { "under the same handle\n" })
    _ = brix.close(file)
    line("close twice (invalid handle)", status(brix.close(file)))
    line("read from a closed handle (invalid handle)", status(brix.read(file, byte[0..1], 0)))
    say(if brix.clock(brix.Clock.REAL_TIME) > 1700000000000000000 { "real time after 2023\n" } else { "real time before 2023\n" })
    // The start block's roles (flux gives us its 0, 1, 2 and its session).
    var records: [16]brix.RoleRecord = undefined
    line("start roles", @intCast(usize, brix.startRoles(records[0..16])))
    say(if brix.handleFor(brix.Role.INPUT) == brix.ofDescriptor(0) { "input is descriptor 0\n" } else { "input is elsewhere\n" })
    say(if brix.handleFor(brix.Role.OUTPUT) == brix.ofDescriptor(1) { "output is descriptor 1\n" } else { "output is elsewhere\n" })
    say(if brix.handleFor(brix.Role.ERRORS) == brix.ofDescriptor(2) { "errors is descriptor 2\n" } else { "errors is elsewhere\n" })
    const session = brix.handleFor(brix.Role.SESSION)
    _ = brix.info(session, &info)
    line("session kind (session)", @intCast(usize, info.kind))
    say(if brix.handleFor(brix.Role.DIRECTORY) == 0 { "no directory role\n" } else { "a directory role\n" })
    // This machine has no network device the kernel drives: no link, no
    // /devices/net0 (tools/check_brix_net.sh reads one that is there).
    var link: brix.NetworkLink = undefined
    line("no network link (not found)", status(brix.networkLink(0, &link)))
    // The processes: this one among them, running, named native.
    var listed: [64]brix.ProcessRecord = undefined
    const pointer: [*]brix.ProcessRecord = &listed
    const count = brix.processList(pointer, 64)
    say(if count >= 2 { "itself and its shell at least\n" } else { "too few processes\n" })
    const own = @intCast(u32, linux.syscall0(SYS_getpid))
    var found = false
    var index: usize = 0
    while count > 0 && index < @bitCast(usize, count) && index < 64 {
        const record = listed[index]
        if record.pid == own {
            found = true
            say(if record.state == brix.ProcessState.RUNNING { "itself, running\n" } else { "itself, not running\n" })
            say(if record.name[0] == 110 && record.name[1] == 97 && record.name[5] == 101 && record.name[6] == 0 { "named native\n" } else { "named otherwise\n" })
            say(if record.memory > 0 && record.parent != 0 { "with memory and a parent\n" } else { "without memory or a parent\n" })
        }
        index += 1
    }
    if !found { say("not listed\n") }
    const self_handle = brix.processOpen(own)
    say(if self_handle > 0 { "a handle to itself\n" } else { "no handle to itself\n" })
    if self_handle > 0 { _ = brix.close(@intCast(brix.Handle, self_handle)) }
    line("no such process (not found)", status(brix.processOpen(999999)))
    brix.exit(7)
    return 0
}
