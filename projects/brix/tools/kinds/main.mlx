// kinds: brixOS's other objects (std.os.brix), a line each, for
// tools/check_brix.sh: a node renamed, a tree snapshot by handle, timers
// (periodic, once), a memory object shared with a branch, groups put in
// front of the session and sent an event; std.spawn on them (a program
// found where brixOS keeps them, its output captured; one ended by an
// event).
const std = @import("std")
const spawn = @import("std.spawn")
const brix = std.os.brix

fn say(text: []const u8) -> void { _ = brix.write(brix.ofDescriptor(1), text, brix.STREAM) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn line(text: []const u8, value: usize) -> void {
    say(text)
    say(" ")
    number(value)
    say("\n")
}

fn status(result: isize) -> usize { return if result < 0 { @bitCast(usize, -result) } else { 0 } }

fn handle(result: isize) -> u32 { return if result < 0 { 0 } else { @intCast(u32, result) } }

fn yes(value: bool) -> usize { return if value { 1 } else { 0 } }

fn stateOf(h: u32) -> u32 {
    var info = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
    _ = brix.info(h, &info)
    return info.state
}

fn kindOf(h: u32) -> usize {
    var info = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
    _ = brix.info(h, &info)
    return @intCast(usize, info.kind)
}

fn awaitEnd(process: u32) -> void {
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = process, .want = brix.State.ENDED, .seen = 0, .reserved = 0 } }
    _ = brix.wait(items[0..1], brix.FOREVER)
}

pub fn main() -> u8 {
    say("kinds\n")
    // A rename.
    _ = brix.make(0, "/temporary/kinds", brix.NodeKind.DIRECTORY, 0x1ED, "")
    const directory = handle(brix.open(0, "/temporary/kinds", brix.Open.READ, 0))
    const file = handle(brix.open(directory, "a.txt", brix.Open.READ | brix.Open.WRITE | brix.Open.CREATE, 0x1A4))
    _ = brix.write(file, "renamed file", 0)
    _ = brix.close(file)
    line("rename", status(brix.rename(directory, "a.txt", directory, "b.txt")))
    line("the old name (not found)", status(brix.open(directory, "a.txt", brix.Open.READ, 0)))
    var bytes: [12]u8 = undefined
    const renamed = handle(brix.open(directory, "b.txt", brix.Open.READ, 0))
    _ = brix.read(renamed, bytes[0..12], 0)
    say(bytes[0..12])
    say("\n")
    _ = brix.make(directory, "inner", brix.NodeKind.DIRECTORY, 0x1ED, "")
    line("a file onto a directory (is a directory)", status(brix.rename(directory, "b.txt", directory, "inner")))
    line("a directory under itself (invalid)", status(brix.rename(directory, "inner", directory, "inner/deeper")))

    // A snapshot of the directory, by its handle.
    line("snapshot", status(brix.snapshot(directory, 0, "/temporary/kinds-copy", brix.Snapshot.READ_ONLY)))
    const copy = handle(brix.open(0, "/temporary/kinds-copy/b.txt", brix.Open.READ, 0))
    var copied: [12]u8 = undefined
    _ = brix.read(copy, copied[0..12], 0)
    say(copied[0..12])
    say(" (in the snapshot)\n")
    line("written in the snapshot (read only)", status(brix.open(0, "/temporary/kinds-copy/b.txt", brix.Open.WRITE, 0)))
    line("the same name again (exists)", status(brix.snapshot(directory, 0, "/temporary/kinds-copy", 0)))

    // A timer every 10 ms, first in 30 ms.
    const started = brix.clock(brix.Clock.MONOTONIC)
    const periodic = handle(brix.timer(started + 30000000, 10000000))
    line("timer kind", kindOf(periodic))
    line("readable before its deadline", yes(stateOf(periodic) & brix.State.READABLE != 0))
    var count: [8]u8 = undefined
    const got = brix.read(periodic, count[0..8], brix.STREAM)
    line("read (bytes)", @bitCast(usize, got))
    line("waited for it", yes(brix.clock(brix.Clock.MONOTONIC) - started >= 30000000))
    line("expired at least once", yes(count[0] >= 1))
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = periodic, .want = brix.State.READABLE, .seen = 0, .reserved = 0 } }
    line("waited for again", @bitCast(usize, brix.wait(items[0..1], brix.FOREVER)))
    _ = brix.read(periodic, count[0..8], brix.STREAM)
    line("expired again", yes(count[0] >= 1))
    const once = handle(brix.timer(brix.clock(brix.Clock.MONOTONIC), 0))
    line("once: read (bytes)", @bitCast(usize, brix.read(once, count[0..8], brix.STREAM)))
    line("once: again (no more)", @bitCast(usize, brix.read(once, count[0..8], brix.STREAM)))
    line("a write to a timer (no right)", status(brix.write(once, "x", brix.STREAM)))

    // A memory object, shared with a branch.
    const object = handle(brix.memoryObject(8192))
    line("memory kind", kindOf(object))
    const mapped = brix.mapObject(object, 0, 8192, brix.Map.WRITE)
    const base = @bitCast(usize, mapped)
    const shared = unsafe { @ptrFromInt([*]u8, base) }
    line("zeroed", @intCast(usize, shared[100]))
    const child = brix.branch()
    if child == 0 {
        const text = "from the branch"
        var k: usize = 0
        while k < text.length {
            shared[k] = text[k]
            shared[4096 + k] = text[k]
            k += 1
        }
        brix.exit(0)
    }
    awaitEnd(handle(child))
    say(shared[0..15])
    say(" (the branch wrote it)\n")
    const second = brix.mapObject(object, 4096, 4096, 0)
    const page = unsafe { @ptrFromInt([*]u8, @bitCast(usize, second)) }
    say(page[0..15])
    say(" (its second page, mapped again)\n")
    line("past its end (invalid)", status(brix.mapObject(object, 8192, 4096, 0)))
    _ = brix.close(object)
    say(shared[0..15])
    say(" (still mapped after its handle closed)\n")

    // Groups and the session.
    const session = brix.ofDescriptor(0)
    line("session kind", kindOf(session))
    const mine = handle(brix.joinGroup(0, 0))
    line("own group in front", status(brix.front(session, mine)))
    line("group kind", kindOf(mine))
    line("in front", yes(stateOf(mine) & brix.State.FRONT != 0))
    var hold: [2]u32 = [2]u32{ 0, 0 }
    _ = brix.streamPair(&hold)
    const other = brix.branch()
    if other == 0 {
        var waiting: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = hold[0], .want = brix.State.READABLE, .seen = 0, .reserved = 0 } }
        while true { _ = brix.wait(waiting[0..1], brix.FOREVER) }
    }
    const theirs = handle(brix.joinGroup(handle(other), 0))
    line("the branch's own group in front", yes(stateOf(theirs) & brix.State.FRONT != 0))
    line("put in front", status(brix.front(session, theirs)))
    line("now in front", yes(stateOf(theirs) & brix.State.FRONT != 0))
    line("ours still", yes(stateOf(mine) & brix.State.FRONT != 0))
    line("ours back", status(brix.front(session, mine)))
    line("an event to their group", status(brix.sendEvent(theirs, brix.Event.TERMINATE)))
    awaitEnd(handle(other))
    var change = brix.Change.{ .what = 0, .value = 0, .detail = 0, .reserved = 0 }
    _ = brix.change(handle(other), &change)
    line("the branch ended by an event", @intCast(usize, change.what))
    line("of kind (terminate)", @intCast(usize, change.value))
    line("their group ended", yes(stateOf(theirs) & brix.State.ENDED != 0))
    line("an event to it (not found)", status(brix.sendEvent(theirs, brix.Event.TERMINATE)))
    line("a group in front of a file (wrong kind)", status(brix.front(directory, mine)))

    // std.spawn: no PATH, so std looks where brixOS keeps its programs.
    var argv: [3]usize = [3]usize{ @intFromPtr("echo"), @intFromPtr("by std.spawn"), 0 }
    var empty: [1]usize = [1]usize{ 0 }
    const arguments = unsafe { @ptrFromInt([*][*]const u8, @intFromPtr(&argv)) }
    const environment = unsafe { @ptrFromInt([*][*]const u8, @intFromPtr(&empty)) }
    var options = spawn.options(unsafe { @ptrCast([*]const u8, "echo") }, arguments, environment)
    options.searchPath = true
    var output: [64]u8 = undefined
    var ending = spawn.Ending.lost()
    const captured = spawn.capture(&options, false, &output, 64, &ending)
    if captured > 0 { say(output[0..@bitCast(usize, captured)]) }
    line("its ending", ending.status())
    var sleeper: [3]usize = [3]usize{ @intFromPtr("sleep"), @intFromPtr("5"), 0 }
    options = spawn.options(unsafe { @ptrCast([*]const u8, "sleep") }, unsafe { @ptrFromInt([*][*]const u8, @intFromPtr(&sleeper)) }, environment)
    options.searchPath = true
    const sleeping = spawn.start(&options)
    line("started by a handle", yes(sleeping.started() && sleeping.handle))
    line("asked to end", yes(spawn.terminate(sleeping)))
    const stopped = spawn.wait(sleeping)
    line("ended by an event", yes(!stopped.exited))
    line("of kind (terminate)", stopped.code)
    return 0
}
