// gpucalls: the native calls of a graphics card's context (std.gpucard;
// spec/04-stdlib/os/brix.xml, calls 80 to 85) asked of the kernel as they
// are, a line each, for tools/check_brix_vulkan.sh: how many cards there
// are, a context asked of the first, and each call on no handle, on a
// made-up one and on a handle that is no context (a node's), with the
// status the kernel answers (negated).
const std = @import("std")
const gpucard = @import("std.gpucard")
const brix = std.os.brix

fn say(text: []const u8) -> void { _ = brix.write(brix.ofDescriptor(1), text, brix.STREAM) }

fn number(value: isize) -> void {
    var digits: [21]u8 = undefined
    var at: usize = 21
    var rest: usize = if value < 0 { @intCast(usize, -value) } else { @intCast(usize, value) }
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    if value < 0 {
        at -= 1
        digits[at] = 45
    }
    say(digits[at..21])
}

fn line(text: []const u8, value: isize) -> void {
    say("gpucalls: ")
    say(text)
    say(" ")
    number(value)
    say("\n")
}

// Each of the six calls on `handle`.
fn calls(what: []const u8, handle: u32) -> void {
    say("gpucalls: ")
    say(what)
    say(":")
    const results = [_]isize{ gpucard.memory(handle, 4096, gpucard.Memory.CARD), gpucard.memoryOf(handle, 0x10000, 4096), gpucard.map(handle, 0, 0, 4096, 0x200000, gpucard.Access.READ), gpucard.unmap(handle, 0x200000, 4096), gpucard.submit(handle, unsafe { @ptrFromInt([*]const gpucard.Stream, 8) }[0..0], 0), gpucard.fence(handle) }
    for result in results {
        say(" ")
        number(result)
    }
    say("\n")
}

pub fn main() -> u8 {
    line("cards", @intCast(isize, gpucard.count()))
    var device: gpucard.Device = undefined
    line("describe gpu0", gpucard.describe(0, &device))
    line("open gpu0", gpucard.open(0))
    calls("no handle", 0)
    calls("made-up handle", 0x7F0301)
    const node = brix.open(0, "/devices/null", brix.Open.READ, 0)
    if node > 0 {
        calls("a node's handle", @intCast(u32, node))
        _ = brix.close(@intCast(u32, node))
    }
    // The number after the last: no such call.
    line("call 86", brix.call1(brix.NATIVE_BASE + 86, 0))
    return 0
}
