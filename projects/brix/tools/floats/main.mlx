// floats: a long computation in the SSE registers, its result's bits in
// hexadecimal. Run twice at once in brixOS (tools/check_brix.sh), both
// must print what the host prints: every process keeps its own registers
// across the timer's preemptions.
const std = @import("std")

const ROUNDS: usize = 10000000

pub fn main() -> u8 {
    var x: f64 = 0.5
    var sum: f64 = 0.0
    var product: f64 = 1.0
    var k: usize = 0
    while k < ROUNDS {
        x = x * 1.0000001 + 0.25
        if x > 1000.0 { x = x / 1024.0 }
        sum = sum + x * 0.75 - product
        product = product * 0.9999999 + @floatFromInt(f64, k & 7) / 64.0
        k += 1
    }
    var line: [17]u8 = undefined
    var bits = @bitCast(u64, sum + product)
    var at: usize = 16
    while at > 0 {
        at -= 1
        line[at] = "0123456789abcdef"[@intCast(usize, bits & 15)]
        bits = bits >> 4
    }
    line[16] = 10
    _ = std.io.writeAll(std.io.stdout(), line[0..17])
    return 0
}
