// screen: what mlx-console would draw, compared with a screen dump
// (tools/check_brix_console.sh): the terminal's content given is drawn
// by the same code (std.terminal, std.ui.terminal) with the same font at
// the same size into a canvas of the dump's size, and the two are
// compared pixel by pixel.
//
//   screen DUMP.ppm FONT.ttf SIZE TEXT      "same", or how many pixels differ (exit 1)
//
// TEXT is what the terminal was fed (\n for a newline: the console's
// terminal turns it into a carriage return and a line feed); the cursor
// is drawn as in a focused console.
const std = @import("std")
const crash = @import("std.crash")
const ui = @import("std.ui")
const terminal = @import("std.terminal")
const ui_terminal = @import("std.ui.terminal")
const text_module = @import("std.ui.text")
const canvas_module = @import("std.ui.canvas")

fn say(text: []const u8) -> void { _ = std.linux.write(2, text.pointer, text.length) }

fn sayNumber(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn parseNumber(text: []const u8, at: *usize) -> usize {
    var value: usize = 0
    while at.* < text.length && text[at.*] >= 48 && text[at.*] <= 57 {
        value = value * 10 + @intCast(usize, text[at.*] - 48)
        at.* += 1
    }
    return value
}

var screen: terminal.Screen = undefined // (per run)
var view: ui_terminal.View = undefined // (per run)
var mono: text_module.Text = undefined // (per run)

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    if std.process.count(arguments) != 5 {
        say("usage: screen DUMP.ppm FONT.ttf SIZE TEXT\n")
        return 2
    }
    const allocator = std.heap.allocator()
    const dumpPath = std.process.argument(arguments, 1)
    const fontPath = std.process.argument(arguments, 2)
    var sizeAt: usize = 0
    const fontSize = parseNumber(std.string.asSlice(std.process.argument(arguments, 3)), &sizeAt)
    const given = std.string.asSlice(std.process.argument(arguments, 4))
    // The dump: P6, width, height, 255, then RGB bytes.
    const dump = std.fs.readFileAlloc(dumpPath.pointer, allocator)
    if dump == null {
        say("screen: cannot read the dump\n")
        return 2
    }
    const list = dump.?
    const bytes: []const u8 = list.items[0..list.length]
    if bytes.length < 16 || bytes[0] != 80 || bytes[1] != 54 { 
        say("screen: not a P6 dump\n")
        return 2
    }
    var at: usize = 3
    const width = parseNumber(bytes, &at)
    at += 1
    const height = parseNumber(bytes, &at)
    at += 1
    _ = parseNumber(bytes, &at)
    at += 1
    if width == 0 || height == 0 || at + width * height * 3 > bytes.length {
        say("screen: a dump of an odd size\n")
        return 2
    }
    // The terminal as the console draws it.
    if !text_module.loadFontFile(&mono, fontPath.pointer, @intCast(u32, fontSize), allocator) {
        say("screen: no font\n")
        return 2
    }
    ui_terminal.init(&view, &screen, &mono, @intCast(i32, fontSize), 0)
    var columns = ui_terminal.columnsFor(&view, @intCast(i32, width))
    var rows = ui_terminal.rowsFor(&view, @intCast(i32, height))
    if columns < 2 { columns = 2 }
    if rows < 1 { rows = 1 }
    if !terminal.init(&screen, allocator, columns, rows, 100) {
        say("screen: out of memory\n")
        return 2
    }
    view.focused = true
    // "\n" fed as "\r\n", as the kernel's terminal translates it.
    var k: usize = 0
    while k < given.length {
        if given[k] == 92 && k + 1 < given.length && given[k + 1] == 110 {
            terminal.feed(&screen, "\r\n")
            k += 2
            continue
        }
        terminal.feed(&screen, given[k..k + 1])
        k += 1
    }
    const memory = allocator.alloc(width * height * 4, 16)
    if memory == null { return 2 }
    var canvas: canvas_module.Canvas = undefined
    canvas.pixels = unsafe { @ptrCast([*]u32, memory.?) }
    canvas.width = width
    canvas.height = height
    canvas.stride = width
    canvas.swapRedBlue = false
    canvas.device = 0
    canvas.opacity = 255
    ui_terminal.draw(&view, &canvas, ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
    var differing: usize = 0
    var firstX: usize = 0
    var firstY: usize = 0
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const pixel = @intCast(usize, canvas.pixels[y * width + x])
            const r = @intCast(usize, bytes[at + (y * width + x) * 3])
            const g = @intCast(usize, bytes[at + (y * width + x) * 3 + 1])
            const b = @intCast(usize, bytes[at + (y * width + x) * 3 + 2])
            if ((pixel >> 16) & 255) != r || ((pixel >> 8) & 255) != g || (pixel & 255) != b {
                if differing == 0 {
                    firstX = x
                    firstY = y
                }
                differing += 1
            }
            x += 1
        }
        y += 1
    }
    if differing == 0 {
        say("same\n")
        return 0
    }
    sayNumber(differing)
    say(" pixels differ, the first at ")
    sayNumber(firstX)
    say(",")
    sayNumber(firstY)
    say("\n")
    return 1
}
