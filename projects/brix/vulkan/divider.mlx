// The self-test's second kernel (selftest.mlx): division by a variable,
// which the desktop's kernels do on their first frame (the blur by its
// window, the warp by the size, the paint kernel: the study's 8.2 (b),
// the second reading's silent need 1, "the self-test must cover it").
// Our compiler divides as Mesa does (nir_lower_idiv.c emit_udiv: a
// v_rcp_f32 and two refinements), and that is exact only if the card's
// reciprocal is close enough: the host's is not the card's (the study's
// 11.14), and one unit in the last place too high gives wrong quotients
// among these pairs (2 / 3, 7 / 7, 255 / 255, ...; tests/509). So the
// card's own answers are held against the processor's before a device is
// given out.
//
//     layout(local_size_x = 64) in;
//     layout(set = 0, binding = 0) buffer Data { uint w[]; };
//     void main() {
//         uint i = gl_GlobalInvocationID.x * 4;
//         w[i + 2] = w[i] / w[i + 1];
//         w[i + 3] = w[i] % w[i + 1];
//     }
const builder = @import("std.spirv.builder")
const compute = @import("std.spirv.compute")
const spv = @import("std.spirv.core")

pub const LOCAL_SIZE: u32 = 64

// The pairs: each dividend with each divisor, four words a pair (the
// dividend, the divisor, then the quotient and the remainder the kernel
// writes): 64 pairs, one work group.
pub const PAIRS: usize = 64

const DIVIDENDS = [16]u32{ 0, 1, 2, 3, 7, 255, 256, 65521, 65536, 65537, 1000003, 2147483629, 2147483647, 2147483648, 4294967294, 4294967295 }
const DIVISORS = [4]u32{ 3, 7, 255, 65521 }

pub fn dividend(pair: usize) -> u32 { return DIVIDENDS[pair / 4] }

pub fn divisor(pair: usize) -> u32 { return DIVISORS[pair % 4] }

pub fn build(b: *builder.Builder) -> void {
    var common: compute.Kernel = undefined
    compute.declare(b, &common, 0, 1, false)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    _ = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const base = builder.binary(b, spv.Op.iMul, common.uint, x, compute.constant(b, &common, 4))
    const n = compute.load(b, &common, common.buffers[0], base)
    const d = compute.load(b, &common, common.buffers[0], builder.binary(b, spv.Op.iAdd, common.uint, base, compute.constant(b, &common, 1)))
    const quotient = compute.element(b, &common, common.buffers[0], builder.binary(b, spv.Op.iAdd, common.uint, base, compute.constant(b, &common, 2)))
    builder.store(b, quotient, builder.binary(b, spv.Op.uDiv, common.uint, n, d))
    const remainder = compute.element(b, &common, common.buffers[0], builder.binary(b, spv.Op.iAdd, common.uint, base, compute.constant(b, &common, 3)))
    builder.store(b, remainder, builder.binary(b, spv.Op.uMod, common.uint, n, d))
    builder.returnVoid(b)
    builder.functionEnd(b)
    compute.finish(b, &common, main, LOCAL_SIZE, 1)
}
