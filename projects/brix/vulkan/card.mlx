// The driver's one interface to the kernel (the study's 8.1): the calls of
// brixOS's native interface for a graphics card (spec/04-stdlib/os/
// brix.xml, <GpuDevices>; std.gpucard), as a record of functions with two
// implementations:
//   card_brix.mlx  brixOS's: the native calls themselves;
//   card_host.mlx  a card on the host, for host programs and the tests: the
//                  same calls, statuses and record, answered in the
//                  process (the later stages execute the streams' packets
//                  there and run the shaders in wave.mlx).
// The driver never calls the kernel another way, so everything it does
// can be run on the host first.
//
// Every function answers as a native call does: a value (0 or more), or a
// brixOS Status negated (std.os.brix.Status).
const gpucard = @import("std.gpucard")

pub const Device = gpucard.Device

pub const Card = struct {
    // How many cards there are (/devices/gpu0 and on).
    count: fn() -> usize
    // Card `index`'s record.
    describe: fn(usize, *gpucard.Device) -> isize
    // A context on card `index`: its handle.
    open: fn(usize) -> isize
    // The record of the context's card, read through the context.
    describeContext: fn(u32, *gpucard.Device) -> isize
    // The context's handle closed (the last one ends it).
    close: fn(u32) -> isize
    // The calls on a context (std.gpucard's), refused by brixOS's kernel
    // for now; the host card answers them when its record lists a compute
    // ring.
    memory: fn(u32, usize, usize) -> isize
    memoryOf: fn(u32, usize, usize) -> isize
    map: fn(u32, u32, usize, usize, usize, usize) -> isize
    unmap: fn(u32, usize, usize) -> isize
    // The streams by their address and count, and the fence (0: none).
    submit: fn(u32, usize, usize, u32) -> isize
    fence: fn(u32) -> isize
    // A memory handle's first `size` bytes mapped for the processor
    // (memory_map_object, writable): their address.
    mapMemory: fn(u32, usize) -> isize
    // That mapping let go (memory_unmap).
    unmapMemory: fn(usize, usize) -> isize
    // A memory or fence handle closed.
    release: fn(u32) -> isize
    // The one wait (std.os.brix.wait) on `count` WaitItems at the address,
    // for at most `timeout` nanoseconds from now (FOREVER: no end): how
    // many are ready, or timed_out.
    wait: fn(usize, usize, u64) -> isize
}
