// Our Vulkan driver for the RX 580 (Polaris 10, GFX8), its stages (a), the
// driver is found and its device listed, and (b), compute (the study's
// 8.2 (a) and (b)): this file is the loader/driver interface, the
// instance, the physical device and the device; the device's commands are
// memory.mlx's (memory, buffers), pipeline.mlx's (shader modules,
// descriptor set layouts, pools and sets, pipeline layouts, compute
// pipelines), commands.mlx's (command pools and buffers, the recorded
// commands), queue.mlx's (the preamble, submits, fences, waits) and
// selftest.mlx's (the doubler at every vkCreateDevice).
//
// HOW IT IS REACHED. x86_64 writes no shared objects, so the driver is a
// module of the program that uses it (the study's decision 3): the program
// offers it to std.vulkan.loader (`offer`, with the card interface it is to
// use: card_brix.mlx on brixOS, card_host.mlx on the host), and the
// loader's native path lists it first when it has a device, opens it by its
// entry points (vk_icdNegotiateLoaderICDInterfaceVersion,
// vk_icdGetInstanceProcAddr, vk_icdGetPhysicalDeviceProcAddr) and
// negotiates the interface as with any driver (std.vulkan.icd). Everything
// after that is plain std.vulkan.
//
// WHAT IT ANSWERS. The instance answers Vulkan 1.1's instance-level
// commands, all of them queries: the version, the instance's extensions and
// layers (none), the physical devices and their groups, the properties,
// features, memory, queue family, format, image format and sparse format
// queries and their ...2 forms, the external buffer, fence and semaphore
// properties, the device's extensions and layers (none); vkCreateDevice,
// and on the device the commands of stage (b): Vulkan 1.0's base and
// compute parts as far as std.gpu calls them (the study's 8.2 (b):
// vkDestroyDevice, vkGetDeviceQueue, vkDeviceWaitIdle, vkQueueSubmit,
// vkQueueWaitIdle; memory: vkAllocateMemory, vkFreeMemory, vkMapMemory,
// vkUnmapMemory, vkBindBufferMemory, vkGetBufferMemoryRequirements;
// vkCreateBuffer, vkDestroyBuffer; vkCreateShaderModule and its destroy;
// descriptor set layouts, pools (create, destroy, reset) and sets
// (allocate, update); pipeline layouts; vkCreateComputePipelines,
// vkDestroyPipeline; command pools (create, destroy) and buffers
// (allocate, free, reset, begin, end); vkCmdBindPipeline,
// vkCmdBindDescriptorSets, vkCmdPushConstants, vkCmdDispatch,
// vkCmdPipelineBarrier, vkCmdCopyBuffer, vkCmdFillBuffer; fences
// (create, destroy, reset, wait, status)). Every other command is not
// exported: vkGetInstanceProcAddr and vkGetDeviceProcAddr answer 0 for
// it, never a wrong function (the study's 7.1), and std.vulkan's loaders
// leave its slot 0.
//
// WHAT THE DEVICE SAYS: only what works. Its version is 1.1, as the
// study's 8.2 has it from stage (b) (std.gpu asks for 1.1; the device's
// own commands of 1.1 are not among the stage's and are not exported);
// every feature is false, also
// robustBufferAccess, 1.0's one required feature (the registry's), until
// the card has shown that it checks a buffer's range (the study's 5.2 and
// 11.5); no format has a feature and no image format is supported until
// stage (c); one queue family, compute and transfer, one queue, no
// timestamps; memory as the card's record gives it, in the four types the
// reference has for a card with memory of its own (radv_physical_device.c:
// radv_physical_device_init_mem_types), on up to three heaps (the card's
// memory the processor does not reach, the system's memory the card
// reaches while its GART is on, the card's memory the processor reaches
// less the display's picture), a heap without bytes left out; the
// limits are the reference's for this generation (radv_get_physical_device_
// properties), the card's own, which later stages keep or narrow. The
// driver's information string (VkPhysicalDeviceDriverProperties, filled
// when chained to vkGetPhysicalDeviceProperties2) names the stage.
// vkCreateDevice answers VK_ERROR_INITIALIZATION_FAILED while the card's
// record lists no ring of a compute engine (brixOS's kernel starts none
// yet), or does not count the compute units and shader engines a
// dispatch's COMPUTE_RESOURCE_LIMITS depends on (the study's silent need
// 4); on a card that lists one it opens a context on the card, which the
// device holds until vkDestroyDevice, builds the queue's preamble, and
// runs the self-test (selftest.mlx): when the doubler's words are not the
// processor's the device is not made either, and `refusal` with
// selftest.last says the first wrong word.
//
// The cards it serves are the Polaris 10 cards: the device numbers
// Linux's amdgpu_drv.c lists as CHIP_POLARIS10, each (tools/
// check_vulkan_driver.py holds them against it); any other card's node is
// passed over.
const std = @import("std")
const vk = @import("std.vulkan")
const icd = @import("std.vulkan.icd")
const loader = @import("std.vulkan.loader")
const gpucard = @import("std.gpucard")
const card = @import("./card.mlx")
const device = @import("./device.mlx")
const memory = @import("./memory.mlx")
const pipeline = @import("./pipeline.mlx")
const commands = @import("./commands.mlx")
const queue = @import("./queue.mlx")
const selftest = @import("./selftest.mlx")

// The driver's name for the loader ("builtin:brix-radeon").
pub const NAME = "brix-radeon"
// The stage, as the driver's information string says it.
pub const INFO = "stage (b): compute, std.gpu's commands; no images, no graphics yet"
pub const DRIVER_NAME = "brixOS Radeon (our own)"

// The versions: the instance's, the device's, and the driver's own (its
// minor number is the stage: 1 for (a), 2 for (b)).
pub const INSTANCE_VERSION: u32 = vk.API_VERSION_1_1 | vk.HEADER_VERSION
pub const DEVICE_VERSION: u32 = vk.API_VERSION_1_1 | vk.HEADER_VERSION
pub const DRIVER_VERSION: u32 = 2 << 12

// The loader/driver interface this driver implements (std.vulkan.icd).
pub const INTERFACE_VERSION: u32 = 5

// The most physical devices an instance lists.
pub const MOST_DEVICES: usize = 8

const VENDOR_AMD: u32 = 0x1002

// ---------------------------------------------------------------------------
// The card interface the driver uses

// The driver uses `interface` for the cards from now on (no loader: a
// test's way in).
pub fn use(interface: card.Card) -> void { device.use(interface) }

fn available() -> bool { return device.haveCard && cardCount() > 0 }

// The driver offered to std.vulkan.loader over `interface`; false when
// the loader holds as many drivers as it takes.
pub fn offer(interface: card.Card) -> bool {
    use(interface)
    const entry = loader.BuiltIn.{
        .name = NAME,
        .negotiate = @intFromPtr(negotiateEntry),
        .getInstanceProcAddr = @intFromPtr(getInstanceProcAddr),
        .getPhysicalDeviceProcAddr = @intFromPtr(getPhysicalDeviceProcAddr),
        .apiVersion = INSTANCE_VERSION,
        .available = @intFromPtr(available),
    }
    return loader.offer(&entry)
}

fn cardCount() -> usize { return device.cardCount() }

fn cardDescribe(index: usize, into: *gpucard.Device) -> isize { return device.cardDescribe(index, into) }

fn cardOpen(index: usize) -> isize { return device.cardOpen(index) }

fn cardClose(context: u32) -> isize { return device.cardClose(context) }

// The Polaris 10 cards' device numbers (amdgpu_drv.c, CHIP_POLARIS10).
const POLARIS10 = [_]u32{ 0x67C0, 0x67C1, 0x67C2, 0x67C4, 0x67C7, 0x67C8, 0x67C9, 0x67CA, 0x67CC, 0x67CF, 0x67D0, 0x67DF, 0x6FDF }

// Whether the driver serves the card a record describes.
pub fn serves(record: *const gpucard.Device) -> bool {
    if record.*.vendor != VENDOR_AMD { return false }
    for number in POLARIS10 {
        if record.*.device == number { return true }
    }
    return false
}

// ---------------------------------------------------------------------------
// The objects (each dispatchable one starts with the loader's word)

pub const PhysicalDeviceObject = struct {
    header: icd.DispatchableHeader
    // The card's index among the nodes, and its record.
    card: usize
    record: gpucard.Device
}

pub const InstanceObject = struct {
    header: icd.DispatchableHeader
    // The version the application asked for (0: 1.0).
    apiVersion: u32
    deviceCount: usize
    devices: [MOST_DEVICES]PhysicalDeviceObject
}

pub const QueueObject = device.QueueObject

pub const DeviceObject = device.DeviceObject

// ---------------------------------------------------------------------------
// Host memory: the application's callbacks when it gives them, else the
// program's heap

fn allocate(callbacks: ?*const vk.AllocationCallbacks, size: usize, scope: vk.SystemAllocationScope) -> usize { return device.allocate(callbacks, size, scope) }

fn release(callbacks: ?*const vk.AllocationCallbacks, address: usize, size: usize) -> void { device.release(callbacks, address, size) }

fn zero(address: usize, size: usize) -> void { device.zero(address, size) }

// `text` into a fixed array of `capacity` bytes, NUL after it.
fn copyName(into: [*]u8, capacity: usize, text: []const u8) -> void {
    var k: usize = 0
    while k < capacity {
        into[k] = if k < text.length && k + 1 < capacity { text[k] } else { 0 }
        k += 1
    }
}

// Whether the C string `name` is `text`.
fn same(name: [*]const u8, text: []const u8) -> bool {
    var k: usize = 0
    while k < text.length {
        if name[k] != text[k] { return false }
        k += 1
    }
    return name[text.length] == 0
}

fn instanceOf(handle: vk.Instance) -> *InstanceObject { return unsafe { @ptrFromInt(*InstanceObject, handle) } }

fn physicalOf(handle: vk.PhysicalDevice) -> *PhysicalDeviceObject { return unsafe { @ptrFromInt(*PhysicalDeviceObject, handle) } }

fn deviceOf(handle: vk.Device) -> *DeviceObject { return unsafe { @ptrFromInt(*DeviceObject, handle) } }

// ---------------------------------------------------------------------------
// The two-call pattern: `available` things, `count` asked for (with the
// array) or answered (without it)

// How many to write when the caller's array holds `asked` and there are
// `available`.
fn written(asked: u32, have: usize) -> u32 {
    if @intCast(usize, asked) < have { return asked }
    return @intCast(u32, have)
}

// ---------------------------------------------------------------------------
// The loader/driver interface

// vk_icdNegotiateLoaderICDInterfaceVersion.
fn negotiateEntry(version: *u32) -> vk.Result { return icd.negotiate(version, INTERFACE_VERSION) }

// The negotiation as the loader sees it (a test's way in).
pub fn negotiate(version: *u32) -> vk.Result { return negotiateEntry(version) }

// The commands that need no instance (vkGetInstanceProcAddr with a null
// instance answers these alone).
fn globalCommand(name: [*]const u8) -> usize {
    if same(name, "vkGetInstanceProcAddr") { return @intFromPtr(getInstanceProcAddr) }
    if same(name, "vkCreateInstance") { return @intFromPtr(createInstance) }
    if same(name, "vkEnumerateInstanceVersion") { return @intFromPtr(enumerateInstanceVersion) }
    if same(name, "vkEnumerateInstanceExtensionProperties") { return @intFromPtr(enumerateInstanceExtensionProperties) }
    if same(name, "vkEnumerateInstanceLayerProperties") { return @intFromPtr(enumerateInstanceLayerProperties) }
    return 0
}

// The commands whose first parameter is a physical device.
fn physicalDeviceCommand(name: [*]const u8) -> usize {
    if same(name, "vkGetPhysicalDeviceProperties") { return @intFromPtr(getPhysicalDeviceProperties) }
    if same(name, "vkGetPhysicalDeviceProperties2") { return @intFromPtr(getPhysicalDeviceProperties2) }
    if same(name, "vkGetPhysicalDeviceFeatures") { return @intFromPtr(getPhysicalDeviceFeatures) }
    if same(name, "vkGetPhysicalDeviceFeatures2") { return @intFromPtr(getPhysicalDeviceFeatures2) }
    if same(name, "vkGetPhysicalDeviceMemoryProperties") { return @intFromPtr(getPhysicalDeviceMemoryProperties) }
    if same(name, "vkGetPhysicalDeviceMemoryProperties2") { return @intFromPtr(getPhysicalDeviceMemoryProperties2) }
    if same(name, "vkGetPhysicalDeviceQueueFamilyProperties") { return @intFromPtr(getPhysicalDeviceQueueFamilyProperties) }
    if same(name, "vkGetPhysicalDeviceQueueFamilyProperties2") { return @intFromPtr(getPhysicalDeviceQueueFamilyProperties2) }
    if same(name, "vkGetPhysicalDeviceFormatProperties") { return @intFromPtr(getPhysicalDeviceFormatProperties) }
    if same(name, "vkGetPhysicalDeviceFormatProperties2") { return @intFromPtr(getPhysicalDeviceFormatProperties2) }
    if same(name, "vkGetPhysicalDeviceImageFormatProperties") { return @intFromPtr(getPhysicalDeviceImageFormatProperties) }
    if same(name, "vkGetPhysicalDeviceImageFormatProperties2") { return @intFromPtr(getPhysicalDeviceImageFormatProperties2) }
    if same(name, "vkGetPhysicalDeviceSparseImageFormatProperties") { return @intFromPtr(getPhysicalDeviceSparseImageFormatProperties) }
    if same(name, "vkGetPhysicalDeviceSparseImageFormatProperties2") { return @intFromPtr(getPhysicalDeviceSparseImageFormatProperties2) }
    if same(name, "vkGetPhysicalDeviceExternalBufferProperties") { return @intFromPtr(getPhysicalDeviceExternalBufferProperties) }
    if same(name, "vkGetPhysicalDeviceExternalFenceProperties") { return @intFromPtr(getPhysicalDeviceExternalFenceProperties) }
    if same(name, "vkGetPhysicalDeviceExternalSemaphoreProperties") { return @intFromPtr(getPhysicalDeviceExternalSemaphoreProperties) }
    if same(name, "vkEnumerateDeviceExtensionProperties") { return @intFromPtr(enumerateDeviceExtensionProperties) }
    if same(name, "vkEnumerateDeviceLayerProperties") { return @intFromPtr(enumerateDeviceLayerProperties) }
    if same(name, "vkCreateDevice") { return @intFromPtr(createDevice) }
    return 0
}

// The commands whose first parameter is a device (or one of its objects).
fn deviceCommand(name: [*]const u8) -> usize {
    if same(name, "vkGetDeviceProcAddr") { return @intFromPtr(getDeviceProcAddr) }
    if same(name, "vkDestroyDevice") { return @intFromPtr(destroyDevice) }
    if same(name, "vkGetDeviceQueue") { return @intFromPtr(getDeviceQueue) }
    if same(name, "vkDeviceWaitIdle") { return @intFromPtr(queue.deviceWaitIdle) }
    if same(name, "vkQueueSubmit") { return @intFromPtr(queue.queueSubmit) }
    if same(name, "vkQueueWaitIdle") { return @intFromPtr(queue.queueWaitIdle) }
    if same(name, "vkCreateFence") { return @intFromPtr(queue.createFence) }
    if same(name, "vkDestroyFence") { return @intFromPtr(queue.destroyFence) }
    if same(name, "vkResetFences") { return @intFromPtr(queue.resetFences) }
    if same(name, "vkWaitForFences") { return @intFromPtr(queue.waitForFences) }
    if same(name, "vkGetFenceStatus") { return @intFromPtr(queue.getFenceStatus) }
    if same(name, "vkAllocateMemory") { return @intFromPtr(memory.allocateMemory) }
    if same(name, "vkFreeMemory") { return @intFromPtr(memory.freeMemory) }
    if same(name, "vkMapMemory") { return @intFromPtr(memory.mapMemory) }
    if same(name, "vkUnmapMemory") { return @intFromPtr(memory.unmapMemory) }
    if same(name, "vkCreateBuffer") { return @intFromPtr(memory.createBuffer) }
    if same(name, "vkDestroyBuffer") { return @intFromPtr(memory.destroyBuffer) }
    if same(name, "vkGetBufferMemoryRequirements") { return @intFromPtr(memory.getBufferMemoryRequirements) }
    if same(name, "vkBindBufferMemory") { return @intFromPtr(memory.bindBufferMemory) }
    if same(name, "vkCreateShaderModule") { return @intFromPtr(pipeline.createShaderModule) }
    if same(name, "vkDestroyShaderModule") { return @intFromPtr(pipeline.destroyShaderModule) }
    if same(name, "vkCreateDescriptorSetLayout") { return @intFromPtr(pipeline.createDescriptorSetLayout) }
    if same(name, "vkDestroyDescriptorSetLayout") { return @intFromPtr(pipeline.destroyDescriptorSetLayout) }
    if same(name, "vkCreatePipelineLayout") { return @intFromPtr(pipeline.createPipelineLayout) }
    if same(name, "vkDestroyPipelineLayout") { return @intFromPtr(pipeline.destroyPipelineLayout) }
    if same(name, "vkCreateComputePipelines") { return @intFromPtr(pipeline.createComputePipelines) }
    if same(name, "vkDestroyPipeline") { return @intFromPtr(pipeline.destroyPipeline) }
    if same(name, "vkCreateDescriptorPool") { return @intFromPtr(pipeline.createDescriptorPool) }
    if same(name, "vkDestroyDescriptorPool") { return @intFromPtr(pipeline.destroyDescriptorPool) }
    if same(name, "vkResetDescriptorPool") { return @intFromPtr(pipeline.resetDescriptorPool) }
    if same(name, "vkAllocateDescriptorSets") { return @intFromPtr(pipeline.allocateDescriptorSets) }
    if same(name, "vkUpdateDescriptorSets") { return @intFromPtr(pipeline.updateDescriptorSets) }
    if same(name, "vkCreateCommandPool") { return @intFromPtr(commands.createCommandPool) }
    if same(name, "vkDestroyCommandPool") { return @intFromPtr(commands.destroyCommandPool) }
    if same(name, "vkAllocateCommandBuffers") { return @intFromPtr(commands.allocateCommandBuffers) }
    if same(name, "vkFreeCommandBuffers") { return @intFromPtr(commands.freeCommandBuffers) }
    if same(name, "vkResetCommandBuffer") { return @intFromPtr(commands.resetCommandBuffer) }
    if same(name, "vkBeginCommandBuffer") { return @intFromPtr(commands.beginCommandBuffer) }
    if same(name, "vkEndCommandBuffer") { return @intFromPtr(commands.endCommandBuffer) }
    if same(name, "vkCmdBindPipeline") { return @intFromPtr(commands.cmdBindPipeline) }
    if same(name, "vkCmdBindDescriptorSets") { return @intFromPtr(commands.cmdBindDescriptorSets) }
    if same(name, "vkCmdPushConstants") { return @intFromPtr(commands.cmdPushConstants) }
    if same(name, "vkCmdDispatch") { return @intFromPtr(commands.cmdDispatch) }
    if same(name, "vkCmdPipelineBarrier") { return @intFromPtr(commands.cmdPipelineBarrier) }
    if same(name, "vkCmdCopyBuffer") { return @intFromPtr(commands.cmdCopyBuffer) }
    if same(name, "vkCmdFillBuffer") { return @intFromPtr(commands.cmdFillBuffer) }
    return 0
}

// The device's commands this stage exports, by name (a test's look at
// the table: 46).
pub const DEVICE_COMMANDS = [_][]const u8{ "vkGetDeviceProcAddr", "vkDestroyDevice", "vkGetDeviceQueue", "vkDeviceWaitIdle", "vkQueueSubmit", "vkQueueWaitIdle", "vkCreateFence", "vkDestroyFence", "vkResetFences", "vkWaitForFences", "vkGetFenceStatus", "vkAllocateMemory", "vkFreeMemory", "vkMapMemory", "vkUnmapMemory", "vkCreateBuffer", "vkDestroyBuffer", "vkGetBufferMemoryRequirements", "vkBindBufferMemory", "vkCreateShaderModule", "vkDestroyShaderModule", "vkCreateDescriptorSetLayout", "vkDestroyDescriptorSetLayout", "vkCreatePipelineLayout", "vkDestroyPipelineLayout", "vkCreateComputePipelines", "vkDestroyPipeline", "vkCreateDescriptorPool", "vkDestroyDescriptorPool", "vkResetDescriptorPool", "vkAllocateDescriptorSets", "vkUpdateDescriptorSets", "vkCreateCommandPool", "vkDestroyCommandPool", "vkAllocateCommandBuffers", "vkFreeCommandBuffers", "vkResetCommandBuffer", "vkBeginCommandBuffer", "vkEndCommandBuffer", "vkCmdBindPipeline", "vkCmdBindDescriptorSets", "vkCmdPushConstants", "vkCmdDispatch", "vkCmdPipelineBarrier", "vkCmdCopyBuffer", "vkCmdFillBuffer" }

// vk_icdGetInstanceProcAddr and vkGetInstanceProcAddr: with a null
// instance the global commands alone; with an instance every command the
// driver has.
fn getInstanceProcAddr(instance: vk.Instance, name: ?[*]const u8) -> usize {
    if name == null { return 0 }
    const asked = name.?
    const global = globalCommand(asked)
    if global != 0 || instance == 0 { return global }
    if same(asked, "vkDestroyInstance") { return @intFromPtr(destroyInstance) }
    if same(asked, "vkEnumeratePhysicalDevices") { return @intFromPtr(enumeratePhysicalDevices) }
    if same(asked, "vkEnumeratePhysicalDeviceGroups") { return @intFromPtr(enumeratePhysicalDeviceGroups) }
    const physical = physicalDeviceCommand(asked)
    if physical != 0 { return physical }
    return deviceCommand(asked)
}

// The entry the loader takes (a test's way in).
pub fn instanceProcAddr() -> usize { return @intFromPtr(getInstanceProcAddr) }

// vk_icdGetPhysicalDeviceProcAddr: the commands of a physical device.
fn getPhysicalDeviceProcAddr(instance: vk.Instance, name: ?[*]const u8) -> usize {
    if name == null || instance == 0 { return 0 }
    return physicalDeviceCommand(name.?)
}

pub fn physicalDeviceProcAddr() -> usize { return @intFromPtr(getPhysicalDeviceProcAddr) }

// vkGetDeviceProcAddr: the device's commands.
fn getDeviceProcAddr(given: vk.Device, name: ?[*]const u8) -> usize {
    if name == null || given == 0 { return 0 }
    return deviceCommand(name.?)
}

// ---------------------------------------------------------------------------
// The instance

fn enumerateInstanceVersion(version: *u32) -> vk.Result {
    version.* = INSTANCE_VERSION
    return vk.Result.success
}

// No instance extension; a layer's: there is no layer.
fn enumerateInstanceExtensionProperties(layer: ?[*]const u8, count: *u32, properties: ?[*]vk.ExtensionProperties) -> vk.Result {
    if layer != null { return vk.Result.errorLayerNotPresent }
    count.* = 0
    return vk.Result.success
}

fn enumerateInstanceLayerProperties(count: *u32, properties: ?[*]vk.LayerProperties) -> vk.Result {
    count.* = 0
    return vk.Result.success
}

fn createInstance(info: *const vk.InstanceCreateInfo, callbacks: ?*const vk.AllocationCallbacks, instance: *vk.Instance) -> vk.Result {
    if info.*.sType != vk.StructureType.instanceCreateInfo { return vk.Result.errorInitializationFailed }
    if info.*.enabledLayerCount != 0 { return vk.Result.errorLayerNotPresent }
    if info.*.enabledExtensionCount != 0 { return vk.Result.errorExtensionNotPresent }
    const address = allocate(callbacks, @sizeOf(InstanceObject), vk.SystemAllocationScope.instance)
    if address == 0 { return vk.Result.errorOutOfHostMemory }
    const made = instanceOf(address)
    icd.initDispatchable(&made.*.header)
    made.*.apiVersion = 0
    if info.*.pApplicationInfo != null { made.*.apiVersion = info.*.pApplicationInfo.?.*.apiVersion }
    made.*.deviceCount = 0
    // The cards the driver serves, in the order of their nodes.
    if device.haveCard {
        const cards = cardCount()
        var index: usize = 0
        while index < cards && made.*.deviceCount < MOST_DEVICES {
            const physical = &made.*.devices[made.*.deviceCount]
            if cardDescribe(index, &physical.*.record) == 0 && serves(&physical.*.record) {
                icd.initDispatchable(&physical.*.header)
                physical.*.card = index
                made.*.deviceCount += 1
            }
            index += 1
        }
    }
    instance.* = address
    return vk.Result.success
}

fn destroyInstance(instance: vk.Instance, callbacks: ?*const vk.AllocationCallbacks) -> void {
    if instance == 0 { return }
    release(callbacks, instance, @sizeOf(InstanceObject))
}

fn physicalHandle(made: *InstanceObject, index: usize) -> vk.PhysicalDevice { return @intFromPtr(&made.*.devices[index]) }

fn enumeratePhysicalDevices(instance: vk.Instance, count: *u32, devices: ?[*]vk.PhysicalDevice) -> vk.Result {
    const made = instanceOf(instance)
    if devices == null {
        count.* = @intCast(u32, made.*.deviceCount)
        return vk.Result.success
    }
    const put = written(count.*, made.*.deviceCount)
    var k: usize = 0
    while k < @intCast(usize, put) {
        devices.?[k] = physicalHandle(made, k)
        k += 1
    }
    count.* = put
    return if @intCast(usize, put) < made.*.deviceCount { vk.Result.incomplete } else { vk.Result.success }
}

// Each physical device is a group of its own.
fn enumeratePhysicalDeviceGroups(instance: vk.Instance, count: *u32, groups: ?[*]vk.PhysicalDeviceGroupProperties) -> vk.Result {
    const made = instanceOf(instance)
    if groups == null {
        count.* = @intCast(u32, made.*.deviceCount)
        return vk.Result.success
    }
    const put = written(count.*, made.*.deviceCount)
    var k: usize = 0
    while k < @intCast(usize, put) {
        const group = &groups.?[k]
        group.*.physicalDeviceCount = 1
        var slot: usize = 0
        while slot < 32 {
            group.*.physicalDevices[slot] = if slot == 0 { physicalHandle(made, k) } else { 0 }
            slot += 1
        }
        group.*.subsetAllocation = vk.FALSE
        k += 1
    }
    count.* = put
    return if @intCast(usize, put) < made.*.deviceCount { vk.Result.incomplete } else { vk.Result.success }
}

// ---------------------------------------------------------------------------
// The physical device

fn properties(physical: *const PhysicalDeviceObject, into: *vk.PhysicalDeviceProperties) -> void {
    zero(@intFromPtr(into), @sizeOf(vk.PhysicalDeviceProperties))
    const record = &physical.*.record
    into.*.apiVersion = DEVICE_VERSION
    into.*.driverVersion = DRIVER_VERSION
    into.*.vendorID = record.*.vendor
    into.*.deviceID = record.*.device
    into.*.deviceType = vk.PhysicalDeviceType.discreteGpu
    // "AMD " and the card's name.
    var name: [64]u8 = undefined
    const prefix = "AMD "
    var length: usize = 0
    while length < prefix.length {
        name[length] = prefix[length]
        length += 1
    }
    const own = gpucard.nameOf(record)
    var k: usize = 0
    while k < own.length && length < 63 {
        name[length] = own[k]
        length += 1
        k += 1
    }
    const bytes: [*]const u8 = &name
    copyName(&into.*.deviceName, 256, bytes[0..length])
    // The cache's identity: ours, the stage, the card.
    const uuid = "brix-radeon-b-"
    k = 0
    while k < 16 {
        into.*.pipelineCacheUUID[k] = if k < uuid.length { uuid[k] } else { 0 }
        k += 1
    }
    into.*.pipelineCacheUUID[14] = @intCast(u8, (record.*.device >> 8) & 0xFF)
    into.*.pipelineCacheUUID[15] = @intCast(u8, record.*.device & 0xFF)
    limits(&into.*.limits)
}

// The reference's limits for this generation (radv_get_physical_device_
// properties at mesa-24.0.0, with radv_constants.h's numbers and
// radv_max_descriptor_set_size's (2^31 - 16 x 24 - 4 MiB x 64) / 224);
// no timestamps yet.
fn limits(into: *vk.PhysicalDeviceLimits) -> void {
    const descriptors: u32 = 8388606
    const all: u32 = 0xFFFFFFFF
    const samples: u32 = 0xF
    into.*.maxImageDimension1D = 16384
    into.*.maxImageDimension2D = 16384
    into.*.maxImageDimension3D = 2048
    into.*.maxImageDimensionCube = 16384
    into.*.maxImageArrayLayers = 2048
    into.*.maxTexelBufferElements = all
    into.*.maxUniformBufferRange = all
    into.*.maxStorageBufferRange = all
    into.*.maxPushConstantsSize = 256
    into.*.maxMemoryAllocationCount = all
    into.*.maxSamplerAllocationCount = 65536
    into.*.bufferImageGranularity = 1
    into.*.sparseAddressSpaceSize = 0xFFFFFFFC
    into.*.maxBoundDescriptorSets = 32
    into.*.maxPerStageDescriptorSamplers = descriptors
    into.*.maxPerStageDescriptorUniformBuffers = descriptors
    into.*.maxPerStageDescriptorStorageBuffers = descriptors
    into.*.maxPerStageDescriptorSampledImages = descriptors
    into.*.maxPerStageDescriptorStorageImages = descriptors
    into.*.maxPerStageDescriptorInputAttachments = descriptors
    into.*.maxPerStageResources = descriptors
    into.*.maxDescriptorSetSamplers = descriptors
    into.*.maxDescriptorSetUniformBuffers = descriptors
    into.*.maxDescriptorSetUniformBuffersDynamic = 16
    into.*.maxDescriptorSetStorageBuffers = descriptors
    into.*.maxDescriptorSetStorageBuffersDynamic = 8
    into.*.maxDescriptorSetSampledImages = descriptors
    into.*.maxDescriptorSetStorageImages = descriptors
    into.*.maxDescriptorSetInputAttachments = descriptors
    into.*.maxVertexInputAttributes = 32
    into.*.maxVertexInputBindings = 32
    into.*.maxVertexInputAttributeOffset = all
    into.*.maxVertexInputBindingStride = 2048
    into.*.maxVertexOutputComponents = 128
    into.*.maxTessellationGenerationLevel = 64
    into.*.maxTessellationPatchSize = 32
    into.*.maxTessellationControlPerVertexInputComponents = 128
    into.*.maxTessellationControlPerVertexOutputComponents = 128
    into.*.maxTessellationControlPerPatchOutputComponents = 120
    into.*.maxTessellationControlTotalOutputComponents = 4096
    into.*.maxTessellationEvaluationInputComponents = 128
    into.*.maxTessellationEvaluationOutputComponents = 128
    into.*.maxGeometryShaderInvocations = 127
    into.*.maxGeometryInputComponents = 64
    into.*.maxGeometryOutputComponents = 128
    into.*.maxGeometryOutputVertices = 256
    into.*.maxGeometryTotalOutputComponents = 1024
    into.*.maxFragmentInputComponents = 128
    into.*.maxFragmentOutputAttachments = 8
    into.*.maxFragmentDualSrcAttachments = 1
    into.*.maxFragmentCombinedOutputResources = descriptors
    // (max_shared_size: 65536 from GFX7 on.)
    into.*.maxComputeSharedMemorySize = 65536
    into.*.maxComputeWorkGroupCount[0] = 65535
    into.*.maxComputeWorkGroupCount[1] = 65535
    into.*.maxComputeWorkGroupCount[2] = 65535
    into.*.maxComputeWorkGroupInvocations = 1024
    into.*.maxComputeWorkGroupSize[0] = 1024
    into.*.maxComputeWorkGroupSize[1] = 1024
    into.*.maxComputeWorkGroupSize[2] = 1024
    into.*.subPixelPrecisionBits = 8
    into.*.subTexelPrecisionBits = 8
    into.*.mipmapPrecisionBits = 8
    into.*.maxDrawIndexedIndexValue = all
    into.*.maxDrawIndirectCount = all
    into.*.maxSamplerLodBias = 16.0
    into.*.maxSamplerAnisotropy = 16.0
    into.*.maxViewports = 16
    into.*.maxViewportDimensions[0] = 16384
    into.*.maxViewportDimensions[1] = 16384
    into.*.viewportBoundsRange[0] = -32768.0
    into.*.viewportBoundsRange[1] = 32767.0
    into.*.viewportSubPixelBits = 8
    into.*.minMemoryMapAlignment = 4096
    into.*.minTexelBufferOffsetAlignment = 4
    into.*.minUniformBufferOffsetAlignment = 4
    into.*.minStorageBufferOffsetAlignment = 4
    into.*.minTexelOffset = -32
    into.*.maxTexelOffset = 31
    into.*.minTexelGatherOffset = -32
    into.*.maxTexelGatherOffset = 31
    into.*.minInterpolationOffset = -2.0
    into.*.maxInterpolationOffset = 2.0
    into.*.subPixelInterpolationOffsetBits = 8
    into.*.maxFramebufferWidth = 16384
    into.*.maxFramebufferHeight = 16384
    into.*.maxFramebufferLayers = 1024
    into.*.framebufferColorSampleCounts = samples
    into.*.framebufferDepthSampleCounts = samples
    into.*.framebufferStencilSampleCounts = samples
    into.*.framebufferNoAttachmentsSampleCounts = samples
    into.*.maxColorAttachments = 8
    into.*.sampledImageColorSampleCounts = samples
    into.*.sampledImageIntegerSampleCounts = samples
    into.*.sampledImageDepthSampleCounts = samples
    into.*.sampledImageStencilSampleCounts = samples
    into.*.storageImageSampleCounts = samples
    into.*.maxSampleMaskWords = 1
    // No timestamps at this stage (the queue family's valid bits are 0):
    // a period of one nanosecond stands in.
    into.*.timestampComputeAndGraphics = vk.FALSE
    into.*.timestampPeriod = 1.0
    into.*.maxClipDistances = 8
    into.*.maxCullDistances = 8
    into.*.maxCombinedClipAndCullDistances = 8
    into.*.discreteQueuePriorities = 2
    into.*.pointSizeRange[0] = 0.0
    into.*.pointSizeRange[1] = 8191.875
    into.*.lineWidthRange[0] = 0.0
    into.*.lineWidthRange[1] = 8.0
    into.*.pointSizeGranularity = 0.125
    into.*.lineWidthGranularity = 0.125
    into.*.strictLines = vk.FALSE
    into.*.standardSampleLocations = vk.TRUE
    into.*.optimalBufferCopyOffsetAlignment = 1
    into.*.optimalBufferCopyRowPitchAlignment = 1
    into.*.nonCoherentAtomSize = 64
}

fn getPhysicalDeviceProperties(handle: vk.PhysicalDevice, into: *vk.PhysicalDeviceProperties) -> void { properties(physicalOf(handle), into) }

// The driver's own record, when the caller chains one.
fn driverProperties(into: *vk.PhysicalDeviceDriverProperties) -> void {
    // (Khronos registers driver numbers; this driver has none, so 0.)
    into.*.driverID = @enumFromInt(vk.DriverId, @intCast(i32, 0))
    copyName(&into.*.driverName, 256, DRIVER_NAME)
    copyName(&into.*.driverInfo, 256, INFO)
    into.*.conformanceVersion.major = 0
    into.*.conformanceVersion.minor = 0
    into.*.conformanceVersion.subminor = 0
    into.*.conformanceVersion.patch = 0
}

// A chained structure's type and its next.
const Chained = struct {
    sType: vk.StructureType
    pNext: ?*anyopaque
}

fn getPhysicalDeviceProperties2(handle: vk.PhysicalDevice, into: *vk.PhysicalDeviceProperties2) -> void {
    properties(physicalOf(handle), &into.*.properties)
    var next = into.*.pNext
    while next != null {
        const chained: *Chained = unsafe { @ptrCast(*Chained, next.?) }
        if chained.*.sType == vk.StructureType.physicalDeviceDriverProperties { driverProperties(unsafe { @ptrCast(*vk.PhysicalDeviceDriverProperties, next.?) }) }
        next = chained.*.pNext
    }
}

// Every feature false.
fn getPhysicalDeviceFeatures(handle: vk.PhysicalDevice, into: *vk.PhysicalDeviceFeatures) -> void { zero(@intFromPtr(into), @sizeOf(vk.PhysicalDeviceFeatures)) }

fn getPhysicalDeviceFeatures2(handle: vk.PhysicalDevice, into: *vk.PhysicalDeviceFeatures2) -> void { zero(@intFromPtr(&into.*.features), @sizeOf(vk.PhysicalDeviceFeatures)) }

// The heaps: the card's memory the processor does not reach, the system's
// memory the card reaches, the card's memory the processor reaches less
// the display's picture. The types: device local; host visible and
// coherent; the same and cached; device local, host visible and coherent.
// A heap is there only when it has bytes (the reference keeps the first
// only when it is not a small remainder beside the reachable part: at
// least a ninth of it), and the system's memory only while the card
// reaches it (the record's flag: its GART is on); a type goes with its
// heap, and device-local memory falls to the reachable part when there
// is no other (radv_physical_device_init_mem_types).
fn memoryProperties(physical: *const PhysicalDeviceObject, into: *vk.PhysicalDeviceMemoryProperties) -> void {
    zero(@intFromPtr(into), @sizeOf(vk.PhysicalDeviceMemoryProperties))
    const record = &physical.*.record
    const own = @intCast(usize, record.*.memory)
    const reached = @intCast(usize, record.*.visible)
    const picture = @intCast(usize, record.*.picture)
    const hidden = if own > reached && (own - reached) * 9 >= reached { own - reached } else { 0 }
    const system = if record.*.flags & gpucard.Flag.SYSTEM_MEMORY != 0 { @intCast(usize, record.*.system) } else { 0 }
    const open = if reached > picture { reached - picture } else { 0 }
    const none: u32 = 0xFFFFFFFF
    var hiddenAt = none
    var systemAt = none
    var openAt = none
    var heaps: u32 = 0
    if hidden != 0 {
        hiddenAt = heaps
        into.*.memoryHeaps[heaps].size = @intCast(u64, hidden)
        into.*.memoryHeaps[heaps].flags = vk.MEMORY_HEAP_DEVICE_LOCAL_BIT
        heaps += 1
    }
    if system != 0 {
        systemAt = heaps
        into.*.memoryHeaps[heaps].size = @intCast(u64, system)
        into.*.memoryHeaps[heaps].flags = 0
        heaps += 1
    }
    if open != 0 {
        openAt = heaps
        into.*.memoryHeaps[heaps].size = @intCast(u64, open)
        into.*.memoryHeaps[heaps].flags = vk.MEMORY_HEAP_DEVICE_LOCAL_BIT
        heaps += 1
    }
    into.*.memoryHeapCount = heaps
    var types: u32 = 0
    if hiddenAt != none || openAt != none {
        into.*.memoryTypes[types].propertyFlags = vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT
        into.*.memoryTypes[types].heapIndex = if hiddenAt != none { hiddenAt } else { openAt }
        types += 1
    }
    if systemAt != none {
        into.*.memoryTypes[types].propertyFlags = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT
        into.*.memoryTypes[types].heapIndex = systemAt
        into.*.memoryTypes[types + 1].propertyFlags = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT | vk.MEMORY_PROPERTY_HOST_CACHED_BIT
        into.*.memoryTypes[types + 1].heapIndex = systemAt
        types += 2
    }
    if openAt != none {
        into.*.memoryTypes[types].propertyFlags = vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT | vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT
        into.*.memoryTypes[types].heapIndex = openAt
        types += 1
    }
    into.*.memoryTypeCount = types
}

fn getPhysicalDeviceMemoryProperties(handle: vk.PhysicalDevice, into: *vk.PhysicalDeviceMemoryProperties) -> void { memoryProperties(physicalOf(handle), into) }

fn getPhysicalDeviceMemoryProperties2(handle: vk.PhysicalDevice, into: *vk.PhysicalDeviceMemoryProperties2) -> void { memoryProperties(physicalOf(handle), &into.*.memoryProperties) }

// The one queue family: compute and transfer, one queue, no timestamps.
pub const FAMILIES: usize = 1

fn family(into: *vk.QueueFamilyProperties) -> void {
    into.*.queueFlags = vk.QUEUE_COMPUTE_BIT | vk.QUEUE_TRANSFER_BIT
    into.*.queueCount = 1
    into.*.timestampValidBits = 0
    into.*.minImageTransferGranularity.width = 1
    into.*.minImageTransferGranularity.height = 1
    into.*.minImageTransferGranularity.depth = 1
}

fn getPhysicalDeviceQueueFamilyProperties(handle: vk.PhysicalDevice, count: *u32, families: ?[*]vk.QueueFamilyProperties) -> void {
    if families == null {
        count.* = @intCast(u32, FAMILIES)
        return
    }
    const put = written(count.*, FAMILIES)
    if put > 0 { family(&families.?[0]) }
    count.* = put
}

fn getPhysicalDeviceQueueFamilyProperties2(handle: vk.PhysicalDevice, count: *u32, families: ?[*]vk.QueueFamilyProperties2) -> void {
    if families == null {
        count.* = @intCast(u32, FAMILIES)
        return
    }
    const put = written(count.*, FAMILIES)
    if put > 0 { family(&families.?[0].queueFamilyProperties) }
    count.* = put
}

// No format has a feature until stage (c).
fn getPhysicalDeviceFormatProperties(handle: vk.PhysicalDevice, format: vk.Format, into: *vk.FormatProperties) -> void { zero(@intFromPtr(into), @sizeOf(vk.FormatProperties)) }

fn getPhysicalDeviceFormatProperties2(handle: vk.PhysicalDevice, format: vk.Format, into: *vk.FormatProperties2) -> void { zero(@intFromPtr(&into.*.formatProperties), @sizeOf(vk.FormatProperties)) }

// No image is supported until stage (c).
fn getPhysicalDeviceImageFormatProperties(handle: vk.PhysicalDevice, format: vk.Format, kind: vk.ImageType, tiling: vk.ImageTiling, usage: vk.ImageUsageFlags, flags: vk.ImageCreateFlags, into: *vk.ImageFormatProperties) -> vk.Result {
    zero(@intFromPtr(into), @sizeOf(vk.ImageFormatProperties))
    return vk.Result.errorFormatNotSupported
}

fn getPhysicalDeviceImageFormatProperties2(handle: vk.PhysicalDevice, info: *const vk.PhysicalDeviceImageFormatInfo2, into: *vk.ImageFormatProperties2) -> vk.Result {
    zero(@intFromPtr(&into.*.imageFormatProperties), @sizeOf(vk.ImageFormatProperties))
    return vk.Result.errorFormatNotSupported
}

// No sparse images.
fn getPhysicalDeviceSparseImageFormatProperties(handle: vk.PhysicalDevice, format: vk.Format, kind: vk.ImageType, samples: vk.SampleCountFlagBits, usage: vk.ImageUsageFlags, tiling: vk.ImageTiling, count: *u32, into: ?[*]vk.SparseImageFormatProperties) -> void { count.* = 0 }

fn getPhysicalDeviceSparseImageFormatProperties2(handle: vk.PhysicalDevice, info: *const vk.PhysicalDeviceSparseImageFormatInfo2, count: *u32, into: ?[*]vk.SparseImageFormatProperties2) -> void { count.* = 0 }

// No external memory, fence or semaphore handle of any type.
fn getPhysicalDeviceExternalBufferProperties(handle: vk.PhysicalDevice, info: *const vk.PhysicalDeviceExternalBufferInfo, into: *vk.ExternalBufferProperties) -> void { zero(@intFromPtr(&into.*.externalMemoryProperties), @sizeOf(vk.ExternalMemoryProperties)) }

fn getPhysicalDeviceExternalFenceProperties(handle: vk.PhysicalDevice, info: *const vk.PhysicalDeviceExternalFenceInfo, into: *vk.ExternalFenceProperties) -> void {
    into.*.exportFromImportedHandleTypes = 0
    into.*.compatibleHandleTypes = 0
    into.*.externalFenceFeatures = 0
}

fn getPhysicalDeviceExternalSemaphoreProperties(handle: vk.PhysicalDevice, info: *const vk.PhysicalDeviceExternalSemaphoreInfo, into: *vk.ExternalSemaphoreProperties) -> void {
    into.*.exportFromImportedHandleTypes = 0
    into.*.compatibleHandleTypes = 0
    into.*.externalSemaphoreFeatures = 0
}

// No device extension; a layer's: there is no layer.
fn enumerateDeviceExtensionProperties(handle: vk.PhysicalDevice, layer: ?[*]const u8, count: *u32, into: ?[*]vk.ExtensionProperties) -> vk.Result {
    if layer != null { return vk.Result.errorLayerNotPresent }
    count.* = 0
    return vk.Result.success
}

fn enumerateDeviceLayerProperties(handle: vk.PhysicalDevice, count: *u32, into: ?[*]vk.LayerProperties) -> vk.Result {
    count.* = 0
    return vk.Result.success
}

// Whether any of the features is asked for (every one is false here).
fn asksFeature(features: *const vk.PhysicalDeviceFeatures) -> bool {
    const words: [*]const u32 = unsafe { @ptrCast([*]const u32, features) }
    var k: usize = 0
    while k < @sizeOf(vk.PhysicalDeviceFeatures) / 4 {
        if words[k] != 0 { return true }
        k += 1
    }
    return false
}

// Why vkCreateDevice refused, for the program that wants to say it
// (`refusal`): 0 none; else what the card's record says.
var lastRefusal: u32 = 0 // (per run)

pub const Refusal = struct {
    pub const NONE: u32 = 0
    // No ring of a compute engine takes commands (the record's `why`).
    pub const NO_ENGINE: u32 = 1
    pub const NO_CONTEXT: u32 = 2
    // The record does not count the compute units and shader engines.
    pub const NO_COUNTS: u32 = 3
    // The card's memory for the queue's preamble or its fence not had.
    pub const NO_MEMORY: u32 = 4
    // The self-test failed (selftest.last says how).
    pub const SELF_TEST: u32 = 5
}

// The refusal in a line's words.
pub fn refusalText(why: u32) -> []const u8 {
    if why == Refusal.NO_ENGINE { return "no compute engine takes commands" }
    if why == Refusal.NO_CONTEXT { return "no context on the card could be opened" }
    if why == Refusal.NO_COUNTS { return "the card's record does not count its compute units" }
    if why == Refusal.NO_MEMORY { return "the card's memory for the queue was not had" }
    if why == Refusal.SELF_TEST { return selftest.outcomeText(selftest.last.outcome) }
    return "none"
}

pub fn refusal() -> u32 { return lastRefusal }

fn createDevice(handle: vk.PhysicalDevice, info: *const vk.DeviceCreateInfo, callbacks: ?*const vk.AllocationCallbacks, into: *vk.Device) -> vk.Result {
    lastRefusal = Refusal.NONE
    if info.*.sType != vk.StructureType.deviceCreateInfo { return vk.Result.errorInitializationFailed }
    if info.*.enabledExtensionCount != 0 { return vk.Result.errorExtensionNotPresent }
    if info.*.pEnabledFeatures != null && asksFeature(info.*.pEnabledFeatures.?) { return vk.Result.errorFeatureNotPresent }
    var next = info.*.pNext
    while next != null {
        const chained: *const Chained = unsafe { @ptrCast(*const Chained, next.?) }
        if chained.*.sType == vk.StructureType.physicalDeviceFeatures2 {
            const features: *const vk.PhysicalDeviceFeatures2 = unsafe { @ptrCast(*const vk.PhysicalDeviceFeatures2, next.?) }
            if asksFeature(&features.*.features) { return vk.Result.errorFeatureNotPresent }
        }
        next = chained.*.pNext
    }
    // The one family's one queue.
    var k: usize = 0
    while k < @intCast(usize, info.*.queueCreateInfoCount) {
        const asked = &info.*.pQueueCreateInfos.?[k]
        if asked.*.queueFamilyIndex != 0 || asked.*.queueCount != 1 { return vk.Result.errorInitializationFailed }
        k += 1
    }
    const physical = physicalOf(handle)
    if physical.*.record.computeRings == 0 {
        lastRefusal = Refusal.NO_ENGINE
        return vk.Result.errorInitializationFailed
    }
    const computeUnits = @intCast(u32, gpucard.computeUnits(&physical.*.record))
    if computeUnits == 0 || physical.*.record.shaderEngines == 0 {
        lastRefusal = Refusal.NO_COUNTS
        return vk.Result.errorInitializationFailed
    }
    const opened = cardOpen(physical.*.card)
    if opened < 0 {
        lastRefusal = Refusal.NO_CONTEXT
        // (too_many: the kernel's contexts are all taken.)
        return if opened == -21 { vk.Result.errorTooManyObjects } else { vk.Result.errorInitializationFailed }
    }
    const address = allocate(callbacks, @sizeOf(DeviceObject), vk.SystemAllocationScope.device)
    if address == 0 {
        _ = cardClose(@intCast(u32, opened))
        return vk.Result.errorOutOfHostMemory
    }
    const made = deviceOf(address)
    icd.initDispatchable(&made.*.header)
    made.*.physical = handle
    made.*.context = @intCast(u32, opened)
    icd.initDispatchable(&made.*.queue.header)
    made.*.queue.device = address
    made.*.queue.family = 0
    made.*.queue.index = 0
    made.*.computeUnits = computeUnits
    made.*.shaderEngines = physical.*.record.shaderEngines
    memoryProperties(physical, &made.*.memory)
    // The driver's own blocks in the system's memory when the card
    // reaches it, else in the part of the card's the processor reaches.
    const systemHeap = (physical.*.record.flags & gpucard.Flag.SYSTEM_MEMORY) != 0 && physical.*.record.system != 0
    made.*.ownFlags = gpucard.Memory.PROCESSOR | gpucard.Memory.ZEROED | (if systemHeap { gpucard.Memory.SYSTEM } else { gpucard.Memory.CARD | gpucard.Memory.WRITE_COMBINED })
    device.spaceInit(&made.*.low, device.FIRST_ADDRESS, device.LOW_END)
    device.spaceInit(&made.*.high, device.LOW_END, device.ADDRESS_END)
    made.*.lastFence = 0
    made.*.lost = false
    const fence = device.cardFence(made.*.context)
    made.*.ownFence = if fence > 0 { @intCast(u32, fence) } else { 0 }
    if fence <= 0 || !queue.buildPreamble(made) {
        lastRefusal = Refusal.NO_MEMORY
        destroyDevice(address, callbacks)
        return vk.Result.errorInitializationFailed
    }
    // The self-test, before the device is the program's.
    if !selftest.run(address) {
        lastRefusal = Refusal.SELF_TEST
        destroyDevice(address, callbacks)
        return vk.Result.errorInitializationFailed
    }
    into.* = address
    return vk.Result.success
}

// The card (its node's number) a physical device of this driver is, and
// its record as the driver read it.
pub fn cardOf(physical: vk.PhysicalDevice) -> usize { return physicalOf(physical).*.card }

pub fn recordOf(physical: vk.PhysicalDevice) -> *const gpucard.Device { return &physicalOf(physical).*.record }

// The context on the card a device holds (a test's look).
pub fn contextOf(given: vk.Device) -> u32 { return deviceOf(given).*.context }

fn destroyDevice(handle: vk.Device, callbacks: ?*const vk.AllocationCallbacks) -> void {
    if handle == 0 { return }
    const made = deviceOf(handle)
    device.dropBlock(made, &made.*.preamble)
    if made.*.ownFence != 0 { _ = device.cardRelease(made.*.ownFence) }
    _ = cardClose(made.*.context)
    release(callbacks, handle, @sizeOf(DeviceObject))
}

fn getDeviceQueue(given: vk.Device, family_index: u32, index: u32, into: *vk.Queue) -> void {
    if family_index != 0 || index != 0 {
        into.* = 0
        return
    }
    into.* = @intFromPtr(&deviceOf(given).*.queue)
}
