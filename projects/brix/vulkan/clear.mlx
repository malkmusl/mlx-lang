// The driver's clear (stage (c)): a colour attachment is cleared by a
// drawn rectangle, the study's choice for this stage (RADV's meta clear
// draws too, radv_meta_clear.c; CLEAR_STATE resets registers, not
// pixels). Its two shaders, written with std.spirv.builder and compiled by
// our compiler like any other (render.mlx makes the pipeline, one for
// each colour target, when a clear first needs it):
//
//   vertex:   layout(location = 0) in vec2 corner;
//             void main() { gl_Position = vec4(corner, 0.0, 1.0); }
//   fragment: layout(push_constant) uniform Push { vec4 colour; } push;
//             layout(location = TARGET) out vec4 colour;
//             void main() { colour = push.colour; }
//
// The rectangle is the viewport and the scissor of the draw, its corners
// (-1, -1) .. (1, 1) a strip of two triangles: so exactly the pixels whose
// centres the rectangle holds are written (the fill rule's edges on the
// rectangle's own).
const std = @import("std")
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")

fn ids(list: []const u32) -> [*]const u32 { return list.pointer }

fn construct(b: *builder.Builder, type_id: u32, parts: []const u32) -> u32 {
    const id = builder.newId(b)
    var operands: [6]u32 = undefined
    operands[0] = type_id
    operands[1] = id
    var k: usize = 0
    while k < parts.length {
        operands[2 + k] = parts[k]
        k += 1
    }
    builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.compositeConstruct, ids(operands[0..]), 2 + parts.length)
    return id
}

pub const MOST_WORDS: usize = 1024

var made: [MOST_WORDS]u32 = undefined // (per run)

fn finish(b: *builder.Builder, into: []u32) -> usize {
    const count = builder.wordCount(b)
    if count > into.length {
        builder.deinit(b)
        return 0
    }
    unsafe { builder.writeWords(b, @ptrCast([*]u32, into.pointer)) }
    builder.deinit(b)
    return count
}

// The vertex shader's words into `into`: how many (0: too many).
pub fn vertex(into: []u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, std.page_allocator.init(), spv.version(1, 3))
    builder.capability(&b, spv.Capability.shader)
    builder.memoryModel(&b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    const void_type = builder.typeVoid(&b)
    const function_type = builder.typeFunction(&b, void_type, null, 0)
    const float = builder.typeFloat(&b, 32)
    const vec2 = builder.typeVector(&b, float, 2)
    const vec4 = builder.typeVector(&b, float, 4)
    const zero = builder.constant(&b, float, 0)
    const one = builder.constant(&b, float, 0x3F800000)
    const corner = builder.variable(&b, builder.typePointer(&b, spv.StorageClass.input, vec2), spv.StorageClass.input)
    const position = builder.variable(&b, builder.typePointer(&b, spv.StorageClass.output, vec4), spv.StorageClass.output)
    builder.decorateValue(&b, corner, spv.Decoration.location, 0)
    builder.decorateBuiltIn(&b, position, spv.BuiltIn.position)
    const main = builder.function(&b, void_type, spv.FUNCTION_CONTROL_NONE, function_type)
    _ = builder.label(&b)
    const xy = builder.load(&b, vec2, corner)
    const parts = [4]u32{ builder.compositeExtract(&b, float, xy, 0), builder.compositeExtract(&b, float, xy, 1), zero, one }
    builder.store(&b, position, construct(&b, vec4, parts[0..]))
    builder.returnVoid(&b)
    builder.functionEnd(&b)
    const interfaces = [2]u32{ corner, position }
    builder.entryPoint(&b, spv.ExecutionModel.vertex, main, "main", ids(interfaces[0..]), 2)
    return finish(&b, into)
}

// The fragment shader of colour target `target`.
pub fn fragment(target: u32, into: []u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, std.page_allocator.init(), spv.version(1, 3))
    builder.capability(&b, spv.Capability.shader)
    builder.memoryModel(&b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    const void_type = builder.typeVoid(&b)
    const function_type = builder.typeFunction(&b, void_type, null, 0)
    const float = builder.typeFloat(&b, 32)
    const vec4 = builder.typeVector(&b, float, 4)
    const int = builder.typeInt(&b, 32, true)
    const index0 = builder.constant(&b, int, 0)
    const members = [1]u32{ vec4 }
    const block = builder.typeStruct(&b, ids(members[0..]), 1)
    builder.memberDecorateValue(&b, block, 0, spv.Decoration.offset, 0)
    builder.decorate(&b, block, spv.Decoration.block)
    const push = builder.variable(&b, builder.typePointer(&b, spv.StorageClass.pushConstant, block), spv.StorageClass.pushConstant)
    const push_vec4 = builder.typePointer(&b, spv.StorageClass.pushConstant, vec4)
    const colour = builder.variable(&b, builder.typePointer(&b, spv.StorageClass.output, vec4), spv.StorageClass.output)
    builder.decorateValue(&b, colour, spv.Decoration.location, target)
    const main = builder.function(&b, void_type, spv.FUNCTION_CONTROL_NONE, function_type)
    _ = builder.label(&b)
    const chain = [1]u32{ index0 }
    const value = builder.load(&b, vec4, builder.accessChain(&b, push_vec4, push, ids(chain[0..]), 1))
    builder.store(&b, colour, value)
    builder.returnVoid(&b)
    builder.functionEnd(&b)
    const interfaces = [2]u32{ colour, push }
    builder.entryPoint(&b, spv.ExecutionModel.fragment, main, "main", ids(interfaces[0..]), 1)
    builder.executionMode(&b, main, spv.ExecutionMode.originUpperLeft, null, 0)
    return finish(&b, into)
}
