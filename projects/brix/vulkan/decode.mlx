// The words of the RX 580's shader code (GFX8) back into instructions
// (encode.mlx's records), and an instruction as text in the syntax LLVM's
// disassembler writes for this card (llvm-mc -triple=amdgcn -mcpu=tonga):
// the interpreter's front, the driver's disassembler, and what
// tools/check_gcn_encoding.sh holds against llvm-mc.
//
// The layouts are encode.mlx's (Mesa's aco_assembler.cpp for GFX8) read
// backwards: a word is told by its fixed bits, then each field is taken
// where the encoder puts it. A word that is no instruction of this
// generation (a format the card has not, a number isa.mlx does not list)
// decodes to nothing.

const isa = @import("./isa.mlx")
const encode = @import("./encode.mlx")

const Inst = encode.Inst
const Form = encode.Form

fn bits(word: u32, low: u32, count: u32) -> u32 { return (word >> low) & ((@intCast(u32, 1) << count) - 1) }
fn reg(value: u32) -> u16 { return @intCast(u16, value) }

fn known(format: isa.Format, number: u32) -> bool {
    if number > 0xFFFF { return false }
    return encode.find(isa.Op.{ .format = format, .number = @intCast(u16, number) }) != isa.COUNT
}

// Whether the instruction's own form carries a literal word after it.
fn takesLiteral(inst: *const Inst) -> bool {
    const i = inst.*
    const f = i.op.format
    if f == isa.Format.sop2 || f == isa.Format.sopc { return i.src0 == encode.LITERAL || i.src1 == encode.LITERAL }
    if f == isa.Format.sop1 { return i.src0 == encode.LITERAL }
    if f == isa.Format.sopk { return i.op.number == isa.S_SETREG_IMM32_B32.number }
    if (f == isa.Format.vop1 || f == isa.Format.vop2 || f == isa.Format.vopc) && i.form == Form.native {
        if f == isa.Format.vop2 {
            const n = i.op.number
            // v_madmk and v_madak take their constant K as a literal word
            // (aco_opcodes.py: src(1, 1, 1), the K the literal).
            if n == isa.V_MADMK_F32.number || n == isa.V_MADAK_F32.number || n == isa.V_MADMK_F16.number || n == isa.V_MADAK_F16.number { return true }
        }
        return i.src0 == encode.LITERAL
    }
    return false
}

// The instruction at `code[at..]` into `inst`: its length in words, or 0
// when the words are not an instruction of this generation (or end too
// soon).
pub fn decode(code: []const u32, at: usize, inst: *Inst) -> usize {
    if at >= code.length { return 0 }
    const count = code.length - at
    const w = code[at]
    var i = encode.blank(isa.S_NOP)
    var length: usize = 1
    if (w >> 31) == 0 {
        const top = bits(w, 25, 7)
        if top == 0x3F {
            i.op = isa.Op.{ .format = isa.Format.vop1, .number = reg(bits(w, 9, 8)) }
            i.dst = reg(bits(w, 17, 8))
            // v_readfirstlane_b32 writes a scalar register; the others a
            // vector one.
            if i.op.number != isa.V_READFIRSTLANE_B32.number { i.dst += encode.VGPR }
            i.src0 = reg(bits(w, 0, 9))
        } else if top == 0x3E {
            i.op = isa.Op.{ .format = isa.Format.vopc, .number = reg(bits(w, 17, 8)) }
            i.dst = encode.VCC
            i.src0 = reg(bits(w, 0, 9))
            i.src1 = encode.VGPR + reg(bits(w, 9, 8))
        } else {
            i.op = isa.Op.{ .format = isa.Format.vop2, .number = reg(bits(w, 25, 6)) }
            i.dst = encode.VGPR + reg(bits(w, 17, 8))
            i.src0 = reg(bits(w, 0, 9))
            i.src1 = encode.VGPR + reg(bits(w, 9, 8))
        }
        if !known(i.op.format, @intCast(u32, i.op.number)) { return 0 }
        if i.src0 == encode.DPP_SOURCE || i.src0 == encode.SDWA_SOURCE {
            if count < 2 { return 0 }
            const x = code[at + 1]
            if i.src0 == encode.DPP_SOURCE {
                i.form = Form.dpp
                i.src0 = encode.VGPR + reg(bits(x, 0, 8))
                i.extra = bits(x, 8, 9)
                i.mods = bits(x, 28, 4) | bits(x, 24, 4) << 4 | bits(x, 21, 1) << 8 | bits(x, 20, 1) << 9 | bits(x, 23, 1) << 10 | bits(x, 22, 1) << 11
                if bits(x, 19, 1) != 0 { i.flags |= encode.BOUND_CTRL }
            } else {
                i.form = Form.sdwa
                i.src0 = encode.VGPR + reg(bits(x, 0, 8))
                i.extra = bits(x, 16, 3) << 8 | bits(x, 19, 1) << 11 | bits(x, 24, 3) << 16 | bits(x, 27, 1) << 19
                i.mods = bits(x, 21, 1) | bits(x, 20, 1) << 1 | bits(x, 29, 1) << 2 | bits(x, 28, 1) << 3
                if i.op.format != isa.Format.vopc {
                    i.extra |= bits(x, 8, 3) | bits(x, 11, 2) << 3
                    i.mods |= bits(x, 14, 2) << 4
                    if bits(x, 13, 1) != 0 { i.flags |= encode.CLAMP }
                }
            }
            length = 2
        } else if takesLiteral(&i) {
            if count < 2 { return 0 }
            i.literal = code[at + 1]
            length = 2
        }
        inst.* = i
        return length
    }
    if (w >> 30) == 2 {
        const nine = bits(w, 23, 9)
        if nine == 0x17D {
            i.op = isa.Op.{ .format = isa.Format.sop1, .number = reg(bits(w, 8, 8)) }
            i.dst = reg(bits(w, 16, 7))
            i.src0 = reg(bits(w, 0, 8))
        } else if nine == 0x17E {
            i.op = isa.Op.{ .format = isa.Format.sopc, .number = reg(bits(w, 16, 7)) }
            i.src0 = reg(bits(w, 0, 8))
            i.src1 = reg(bits(w, 8, 8))
        } else if nine == 0x17F {
            i.op = isa.Op.{ .format = isa.Format.sopp, .number = reg(bits(w, 16, 7)) }
            i.imm = bits(w, 0, 16)
        } else if bits(w, 28, 4) == 0xB {
            i.op = isa.Op.{ .format = isa.Format.sopk, .number = reg(bits(w, 23, 5)) }
            i.dst = reg(bits(w, 16, 7))
            i.imm = bits(w, 0, 16)
        } else {
            i.op = isa.Op.{ .format = isa.Format.sop2, .number = reg(bits(w, 23, 7)) }
            i.dst = reg(bits(w, 16, 7))
            i.src0 = reg(bits(w, 0, 8))
            i.src1 = reg(bits(w, 8, 8))
        }
        if !known(i.op.format, @intCast(u32, i.op.number)) { return 0 }
        if takesLiteral(&i) {
            if count < 2 { return 0 }
            i.literal = code[at + 1]
            if i.op.format == isa.Format.sopk { i.src0 = encode.LITERAL }
            length = 2
        }
        inst.* = i
        return length
    }
    // VINTRP is one word; the other formats two.
    const six = bits(w, 26, 6)
    if six == 0x35 {
        i.op = isa.Op.{ .format = isa.Format.vintrp, .number = reg(bits(w, 16, 2)) }
        if !known(i.op.format, @intCast(u32, i.op.number)) { return 0 }
        i.dst = encode.VGPR + reg(bits(w, 18, 8))
        i.extra = bits(w, 10, 6) | bits(w, 8, 2) << 8
        if i.op.number == isa.V_INTERP_MOV_F32.number {
            i.src0 = reg(bits(w, 0, 2))
        } else {
            i.src0 = encode.VGPR + reg(bits(w, 0, 8))
        }
        inst.* = i
        return 1
    }
    if count < 2 { return 0 }
    const x = code[at + 1]
    if six == 0x30 {
        i.op = isa.Op.{ .format = isa.Format.smem, .number = reg(bits(w, 18, 8)) }
        i.dst = reg(bits(w, 6, 7))
        i.src0 = reg(bits(w, 0, 6) << 1)
        if bits(w, 16, 1) != 0 { i.flags |= encode.GLC }
        if bits(w, 17, 1) != 0 {
            i.flags |= encode.IMM
            i.imm = bits(x, 0, 20)
        } else {
            i.src1 = reg(bits(x, 0, 7))
        }
    } else if six == 0x34 {
        const number = bits(w, 16, 10)
        if known(isa.Format.vop3, number) {
            i.op = isa.Op.{ .format = isa.Format.vop3, .number = reg(number) }
        } else if number < 0x100 {
            i.op = isa.Op.{ .format = isa.Format.vopc, .number = reg(number) }
            i.form = Form.vop3
        } else if number < 0x140 {
            i.op = isa.Op.{ .format = isa.Format.vop2, .number = reg(number - 0x100) }
            i.form = Form.vop3
        } else if number < 0x1C0 {
            i.op = isa.Op.{ .format = isa.Format.vop1, .number = reg(number - 0x140) }
            i.form = Form.vop3
        } else if number >= 0x270 && number < 0x274 {
            i.op = isa.Op.{ .format = isa.Format.vintrp, .number = reg(number - 0x270) }
            i.form = Form.vop3
        } else {
            return 0
        }
        if !known(i.op.format, @intCast(u32, i.op.number)) { return 0 }
        i.dst = reg(bits(w, 0, 8))
        const scalarDestination = i.op.format == isa.Format.vopc || (i.op.format == isa.Format.vop1 && i.op.number == isa.V_READFIRSTLANE_B32.number) || (i.op.format == isa.Format.vop3 && i.op.number == isa.V_READLANE_B32_E64.number)
        if !scalarDestination { i.dst += encode.VGPR }
        if encode.hasSecondDestination(i.op) {
            i.dst2 = reg(bits(w, 8, 7))
        } else {
            i.mods = bits(w, 8, 3)
        }
        if bits(w, 15, 1) != 0 { i.flags |= encode.CLAMP }
        i.src0 = reg(bits(x, 0, 9))
        i.src1 = reg(bits(x, 9, 9))
        i.src2 = reg(bits(x, 18, 9))
        i.mods |= bits(x, 27, 2) << 6 | bits(x, 29, 3) << 3
    } else if six == 0x36 {
        i.op = isa.Op.{ .format = isa.Format.ds, .number = reg(bits(w, 17, 8)) }
        if bits(w, 16, 1) != 0 { i.flags |= encode.GDS }
        i.imm = bits(w, 0, 16)
        i.dst = encode.VGPR + reg(bits(x, 24, 8))
        i.src2 = encode.VGPR + reg(bits(x, 16, 8))
        i.src1 = encode.VGPR + reg(bits(x, 8, 8))
        i.src0 = encode.VGPR + reg(bits(x, 0, 8))
    } else if six == 0x38 || six == 0x3A {
        if six == 0x38 {
            i.op = isa.Op.{ .format = isa.Format.mubuf, .number = reg(bits(w, 18, 7)) }
            if bits(w, 17, 1) != 0 { i.flags |= encode.SLC }
            if bits(w, 16, 1) != 0 { i.flags |= encode.LDS }
        } else {
            i.op = isa.Op.{ .format = isa.Format.mtbuf, .number = reg(bits(w, 15, 4)) }
            i.extra = bits(w, 19, 7)
            if bits(x, 22, 1) != 0 { i.flags |= encode.SLC }
        }
        if bits(w, 14, 1) != 0 { i.flags |= encode.GLC }
        if bits(w, 13, 1) != 0 { i.flags |= encode.IDXEN }
        if bits(w, 12, 1) != 0 { i.flags |= encode.OFFEN }
        i.imm = bits(w, 0, 12)
        i.src2 = reg(bits(x, 24, 8))
        if bits(x, 23, 1) != 0 { i.flags |= encode.TFE }
        i.src1 = reg(bits(x, 16, 5) << 2)
        i.dst = encode.VGPR + reg(bits(x, 8, 8))
        i.src0 = encode.VGPR + reg(bits(x, 0, 8))
    } else if six == 0x3C {
        i.op = isa.Op.{ .format = isa.Format.mimg, .number = reg(bits(w, 18, 7) | bits(w, 0, 1) << 7) }
        if bits(w, 25, 1) != 0 { i.flags |= encode.SLC }
        if bits(w, 17, 1) != 0 { i.flags |= encode.LWE }
        if bits(w, 16, 1) != 0 { i.flags |= encode.TFE }
        if bits(w, 15, 1) != 0 { i.flags |= encode.R128 }
        if bits(w, 14, 1) != 0 { i.flags |= encode.DA }
        if bits(w, 13, 1) != 0 { i.flags |= encode.GLC }
        if bits(w, 12, 1) != 0 { i.flags |= encode.UNORM }
        i.extra = bits(w, 8, 4)
        i.src2 = reg(bits(x, 21, 5) << 2)
        i.src1 = reg(bits(x, 16, 5) << 2)
        i.dst = encode.VGPR + reg(bits(x, 8, 8))
        i.src0 = encode.VGPR + reg(bits(x, 0, 8))
    } else if six == 0x37 {
        i.op = isa.Op.{ .format = isa.Format.flat, .number = reg(bits(w, 18, 7)) }
        if bits(w, 16, 1) != 0 { i.flags |= encode.GLC }
        if bits(w, 17, 1) != 0 { i.flags |= encode.SLC }
        if bits(w, 13, 1) != 0 { i.flags |= encode.LDS }
        if bits(w, 0, 13) != 0 { return 0 }
        i.dst = encode.VGPR + reg(bits(x, 24, 8))
        if bits(x, 23, 1) != 0 { i.flags |= encode.TFE }
        i.src1 = encode.VGPR + reg(bits(x, 8, 8))
        i.src0 = encode.VGPR + reg(bits(x, 0, 8))
    } else if six == 0x31 {
        i.op = isa.Op.{ .format = isa.Format.exp, .number = 0 }
        if bits(w, 12, 1) != 0 { i.flags |= encode.VALID_MASK }
        if bits(w, 11, 1) != 0 { i.flags |= encode.DONE }
        if bits(w, 10, 1) != 0 { i.flags |= encode.COMPRESSED }
        i.imm = bits(w, 4, 6)
        i.extra = bits(w, 0, 4)
        i.src0 = encode.VGPR + reg(bits(x, 0, 8))
        i.src1 = encode.VGPR + reg(bits(x, 8, 8))
        i.src2 = encode.VGPR + reg(bits(x, 16, 8))
        i.src3 = encode.VGPR + reg(bits(x, 24, 8))
        inst.* = i
        return 2
    } else {
        return 0
    }
    if !known(i.op.format, @intCast(u32, i.op.number)) { return 0 }
    inst.* = i
    return 2
}

// ---------------------------------------------------------------------------
// Text

pub const Text = struct {
    bytes: [200]u8
    length: usize
}

pub fn clear(t: *Text) -> void { t.*.length = 0 }

fn put(t: *Text, text: []const u8) -> void {
    for byte in text {
        if t.*.length < 200 {
            t.*.bytes[t.*.length] = byte
            t.*.length += 1
        }
    }
}

fn putDecimal(t: *Text, value: u32) -> void {
    var digits: [10]u8 = undefined
    var at: usize = 10
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    put(t, digits[at..10])
}

fn putSigned(t: *Text, value: i32) -> void {
    if value < 0 {
        put(t, "-")
        putDecimal(t, @intCast(u32, 0 - value))
    } else {
        putDecimal(t, @intCast(u32, value))
    }
}

fn putHex(t: *Text, value: u32) -> void {
    put(t, "0x")
    var digits: [8]u8 = undefined
    var at: usize = 8
    var rest = value
    while true {
        at -= 1
        const digit = @intCast(u8, rest & 15)
        digits[at] = if digit < 10 { 48 + digit } else { 87 + digit }
        rest = rest >> 4
        if rest == 0 { break }
    }
    put(t, digits[at..8])
}

pub fn name(op: isa.Op) -> []const u8 {
    const at = encode.find(op)
    if at == isa.COUNT {
        if op.format == isa.Format.exp { return "exp" }
        return "?"
    }
    const where = isa.NAME_AT[at]
    const start = @intCast(usize, where >> 8)
    return isa.NAMES[start..start + @intCast(usize, where & 255)]
}

// A run of `size` registers from `first` (an operand number), as LLVM
// writes it.
fn putRegisters(t: *Text, first: u16, size: u32, literal: u32) -> void {
    if first >= encode.VGPR {
        const n = @intCast(u32, first - encode.VGPR)
        if size == 1 {
            put(t, "v")
            putDecimal(t, n)
        } else {
            put(t, "v[")
            putDecimal(t, n)
            put(t, ":")
            putDecimal(t, n + size - 1)
            put(t, "]")
        }
        return
    }
    const r = @intCast(u32, first)
    if r < 102 {
        if size == 1 {
            put(t, "s")
            putDecimal(t, r)
        } else {
            put(t, "s[")
            putDecimal(t, r)
            put(t, ":")
            putDecimal(t, r + size - 1)
            put(t, "]")
        }
        return
    }
    if r >= 112 && r <= 123 {
        if size == 1 {
            put(t, "ttmp")
            putDecimal(t, r - 112)
        } else {
            put(t, "ttmp[")
            putDecimal(t, r - 112)
            put(t, ":")
            putDecimal(t, r - 112 + size - 1)
            put(t, "]")
        }
        return
    }
    if r >= 128 && r <= 192 {
        putDecimal(t, r - 128)
        return
    }
    if r >= 193 && r <= 208 {
        put(t, "-")
        putDecimal(t, r - 192)
        return
    }
    if r == 255 {
        putHex(t, literal)
        return
    }
    put(t, special(r, size))
}

// The names LLVM gives the special registers and the constants.
fn special(r: u32, size: u32) -> []const u8 {
    const pair = size == 2
    if r == 102 { return if pair { "flat_scratch" } else { "flat_scratch_lo" } }
    if r == 103 { return "flat_scratch_hi" }
    if r == 106 { return if pair { "vcc" } else { "vcc_lo" } }
    if r == 107 { return "vcc_hi" }
    if r == 108 { return if pair { "tba" } else { "tba_lo" } }
    if r == 109 { return "tba_hi" }
    if r == 110 { return if pair { "tma" } else { "tma_lo" } }
    if r == 111 { return "tma_hi" }
    if r == 124 { return "m0" }
    if r == 126 { return if pair { "exec" } else { "exec_lo" } }
    if r == 127 { return "exec_hi" }
    if r == 240 { return "0.5" }
    if r == 241 { return "-0.5" }
    if r == 242 { return "1.0" }
    if r == 243 { return "-1.0" }
    if r == 244 { return "2.0" }
    if r == 245 { return "-2.0" }
    if r == 246 { return "4.0" }
    if r == 247 { return "-4.0" }
    if r == 248 { return "0.15915494" }
    if r == 251 { return "src_vccz" }
    if r == 252 { return "src_execz" }
    if r == 253 { return "src_scc" }
    if r == 254 { return "src_lds_direct" }
    return "?"
}

// The size in registers of the instruction's definition or operand `which`
// as aco_opcodes.py has it (1 when it says nothing: a byte that is a
// register's number is that register's own one, vcc and exec two).
fn sizeOf(word: u32, which: u32) -> u32 {
    if word == 0xFFFFFFFF { return 1 }
    const b = (word >> (8 * which)) & 255
    if b == 0 { return 1 }
    if b <= 8 { return b }
    if b == @intCast(u32, encode.VCC) || b == @intCast(u32, encode.EXEC_HI) { return 2 }
    return 1
}

fn comma(t: *Text) -> void { put(t, ", ") }

fn putSource(t: *Text, i: *const Inst, operand: u16, size: u32, which: u32) -> void {
    const neg = ((i.*.mods >> 3) >> which) & 1
    const abs = (i.*.mods >> which) & 1
    if i.*.form == Form.vop3 || i.*.op.format == isa.Format.vop3 {
        if neg != 0 { put(t, "-") }
        if abs != 0 { put(t, "|") }
    }
    putRegisters(t, operand, size, i.*.literal)
    if i.*.form == Form.vop3 || i.*.op.format == isa.Format.vop3 {
        if abs != 0 { put(t, "|") }
    }
}

// How many registers a memory instruction moves, by its name's end
// (dword, dwordx2 .. x4, b64, b96, b128).
fn dataSize(text: []const u8) -> u32 {
    if endsWith(text, "x2") || endsWith(text, "b64") || endsWith(text, "_xy") { return 2 }
    if endsWith(text, "x3") || endsWith(text, "b96") || endsWith(text, "_xyz") { return 3 }
    if endsWith(text, "x4") || endsWith(text, "b128") || endsWith(text, "_xyzw") { return 4 }
    if endsWith(text, "x8") { return 8 }
    if endsWith(text, "x16") { return 16 }
    return 1
}

fn endsWith(text: []const u8, tail: []const u8) -> bool {
    if tail.length > text.length { return false }
    var k: usize = 0
    while k < tail.length {
        if text[text.length - tail.length + k] != tail[k] { return false }
        k += 1
    }
    return true
}

fn startsWith(text: []const u8, head: []const u8) -> bool {
    if head.length > text.length { return false }
    var k: usize = 0
    while k < head.length {
        if text[k] != head[k] { return false }
        k += 1
    }
    return true
}

// `inst` as LLVM's disassembler writes it for this card: the mnemonic as
// isa.mlx names it (tools/check_gcn_encoding.sh knows LLVM's other names
// for a few), the operands, the modifiers. Exact for what the compiler
// emits; the other formats are written as far as needed to read them.
pub fn text(inst: *const Inst, t: *Text) -> void {
    const i = inst.*
    const at = encode.find(i.op)
    var defs: u32 = 0xFFFFFFFF
    var ops: u32 = 0xFFFFFFFF
    if at != isa.COUNT {
        defs = isa.DEFS[at]
        ops = isa.OPS[at]
    }
    const n = name(i.op)
    put(t, n)
    if i.op.format == isa.Format.sop2 {
        put(t, " ")
        putRegisters(t, i.dst, sizeOf(defs, 0), 0)
        comma(t)
        putRegisters(t, i.src0, sizeOf(ops, 0), i.literal)
        comma(t)
        putRegisters(t, i.src1, sizeOf(ops, 1), i.literal)
    } else if i.op.format == isa.Format.sop1 {
        put(t, " ")
        if (defs & 255) != 0 && (defs & 255) != @intCast(u32, encode.SCC) {
            putRegisters(t, i.dst, sizeOf(defs, 0), 0)
            comma(t)
        }
        putRegisters(t, i.src0, sizeOf(ops, 0), i.literal)
    } else if i.op.format == isa.Format.sopc {
        put(t, " ")
        putRegisters(t, i.src0, sizeOf(ops, 0), i.literal)
        comma(t)
        putRegisters(t, i.src1, sizeOf(ops, 1), i.literal)
    } else if i.op.format == isa.Format.sopk {
        put(t, " ")
        putRegisters(t, i.dst, 1, 0)
        comma(t)
        putHex(t, i.imm)
    } else if i.op.format == isa.Format.sopp {
        if i.op.number == isa.S_WAITCNT.number {
            const vm = i.imm & encode.WAIT_VM_MASK
            const exp = (i.imm >> encode.WAIT_EXP_SHIFT) & encode.WAIT_EXP_MASK
            const lgkm = (i.imm >> encode.WAIT_LGKM_SHIFT) & encode.WAIT_LGKM_MASK
            var first = true
            put(t, " ")
            if vm != encode.WAIT_VM_MASK {
                put(t, "vmcnt(")
                putDecimal(t, vm)
                put(t, ")")
                first = false
            }
            if exp != encode.WAIT_EXP_MASK {
                if !first { put(t, " ") }
                put(t, "expcnt(")
                putDecimal(t, exp)
                put(t, ")")
                first = false
            }
            if lgkm != encode.WAIT_LGKM_MASK {
                if !first { put(t, " ") }
                put(t, "lgkmcnt(")
                putDecimal(t, lgkm)
                put(t, ")")
            }
        } else if i.op.number != isa.S_ENDPGM.number && i.op.number != isa.S_ENDPGM_SAVED.number {
            put(t, " ")
            if startsWith(n, "s_branch") || startsWith(n, "s_cbranch") {
                var value: i32 = @intCast(i32, i.imm)
                if value >= 32768 { value -= 65536 }
                putSigned(t, value)
            } else {
                putDecimal(t, i.imm)
            }
        }
    } else if i.op.format == isa.Format.smem {
        put(t, " ")
        putRegisters(t, i.dst, dataSize(n), 0)
        comma(t)
        if startsWith(n, "s_buffer") { putRegisters(t, i.src0, 4, 0) } else { putRegisters(t, i.src0, 2, 0) }
        comma(t)
        if (i.flags & encode.IMM) != 0 { putHex(t, i.imm) } else { putRegisters(t, i.src1, 1, 0) }
        if (i.flags & encode.GLC) != 0 { put(t, " glc") }
    } else if i.op.format == isa.Format.vop1 || i.op.format == isa.Format.vop2 || i.op.format == isa.Format.vopc || i.op.format == isa.Format.vop3 {
        textVector(&i, t, defs, ops)
    } else if i.op.format == isa.Format.vintrp {
        put(t, " ")
        putRegisters(t, i.dst, 1, 0)
        comma(t)
        if i.op.number == isa.V_INTERP_MOV_F32.number {
            if i.src0 == 0 { put(t, "p10") } else if i.src0 == 1 { put(t, "p20") } else { put(t, "p0") }
        } else {
            putRegisters(t, i.src0, 1, 0)
        }
        put(t, ", attr")
        putDecimal(t, i.extra & 0x3F)
        const channel = (i.extra >> 8) & 3
        if channel == 0 { put(t, ".x") } else if channel == 1 { put(t, ".y") } else if channel == 2 { put(t, ".z") } else { put(t, ".w") }
    } else if i.op.format == isa.Format.ds {
        put(t, " ")
        putRegisters(t, i.dst, dataSize(n), 0)
        comma(t)
        putRegisters(t, i.src0, 1, 0)
        if (i.imm & 0xFFFF) != 0 {
            put(t, " offset:")
            putDecimal(t, i.imm & 0xFFFF)
        }
        if (i.flags & encode.GDS) != 0 { put(t, " gds") }
    } else if i.op.format == isa.Format.mubuf || i.op.format == isa.Format.mtbuf {
        put(t, " ")
        putRegisters(t, i.dst, dataSize(n), 0)
        comma(t)
        if (i.flags & (encode.OFFEN | encode.IDXEN)) == (encode.OFFEN | encode.IDXEN) {
            putRegisters(t, i.src0, 2, 0)
        } else if (i.flags & (encode.OFFEN | encode.IDXEN)) != 0 {
            putRegisters(t, i.src0, 1, 0)
        } else {
            put(t, "off")
        }
        comma(t)
        putRegisters(t, i.src1, 4, 0)
        comma(t)
        putRegisters(t, i.src2, 1, i.literal)
        if (i.flags & encode.IDXEN) != 0 { put(t, " idxen") }
        if (i.flags & encode.OFFEN) != 0 { put(t, " offen") }
        if i.imm != 0 {
            put(t, " offset:")
            putDecimal(t, i.imm)
        }
        if (i.flags & encode.GLC) != 0 { put(t, " glc") }
        if (i.flags & encode.SLC) != 0 { put(t, " slc") }
        if (i.flags & encode.LDS) != 0 { put(t, " lds") }
        if (i.flags & encode.TFE) != 0 { put(t, " tfe") }
    } else if i.op.format == isa.Format.mimg {
        put(t, " ")
        putRegisters(t, i.dst, @intCast(u32, @popCount(i.extra)), 0)
        comma(t)
        putRegisters(t, i.src0, 1, 0)
        comma(t)
        putRegisters(t, i.src1, 8, 0)
        comma(t)
        putRegisters(t, i.src2, 4, 0)
        put(t, " dmask:")
        putHex(t, i.extra)
    } else if i.op.format == isa.Format.flat {
        put(t, " ")
        putRegisters(t, i.dst, dataSize(n), 0)
        comma(t)
        putRegisters(t, i.src0, 2, 0)
    } else if i.op.format == isa.Format.exp {
        put(t, " target")
        putDecimal(t, i.imm)
        comma(t)
        putRegisters(t, i.src0, 1, 0)
        comma(t)
        putRegisters(t, i.src1, 1, 0)
        comma(t)
        putRegisters(t, i.src2, 1, 0)
        comma(t)
        putRegisters(t, i.src3, 1, 0)
        if (i.flags & encode.DONE) != 0 { put(t, " done") }
        if (i.flags & encode.VALID_MASK) != 0 { put(t, " vm") }
    }
}

fn textVector(i: *const Inst, t: *Text, defs: u32, ops: u32) -> void {
    const f = i.*.op.format
    if i.*.form == Form.vop3 { put(t, "_e64") }
    if i.*.form == Form.sdwa { put(t, "_sdwa") }
    if i.*.form == Form.dpp { put(t, "_dpp") }
    const vop3 = i.*.form == Form.vop3 || f == isa.Format.vop3
    put(t, " ")
    // The destination: a VOPC instruction's is vcc natively and a scalar
    // pair in the VOP3 form; a VOP3b instruction's second one follows.
    if f == isa.Format.vopc {
        if vop3 { putRegisters(t, i.*.dst, 2, 0) } else { put(t, "vcc") }
    } else {
        putRegisters(t, i.*.dst, sizeOf(defs, 0), 0)
        if encode.hasSecondDestination(i.*.op) {
            comma(t)
            if vop3 { putRegisters(t, i.*.dst2, 2, 0) } else { put(t, "vcc") }
        }
    }
    // The sources the file names (a byte that is vcc is the carry or mask
    // the instruction reads: vcc natively, a scalar pair in the VOP3 form).
    var count: u32 = 0
    while count < 3 && ((ops >> (8 * count)) & 255) != 0 && ops != 0xFFFFFFFF {
        count += 1
    }
    if ops == 0xFFFFFFFF { count = 2 }
    var which: u32 = 0
    while which < count {
        const b = (ops >> (8 * which)) & 255
        var operand = i.*.src0
        if which == 1 { operand = i.*.src1 }
        if which == 2 { operand = i.*.src2 }
        comma(t)
        if b == @intCast(u32, encode.VCC) {
            if vop3 { putRegisters(t, operand, 2, 0) } else { put(t, "vcc") }
        } else if b == @intCast(u32, encode.M0) || b == @intCast(u32, encode.EXEC_HI) || b == @intCast(u32, encode.SCC) {
            put(t, "?")
        } else {
            putSource(t, i, operand, sizeOf(ops, which), which)
        }
        which += 1
    }
    if vop3 {
        if (i.*.flags & encode.CLAMP) != 0 { put(t, " clamp") }
        const omod = (i.*.mods >> 6) & 3
        if omod == 1 { put(t, " mul:2") }
        if omod == 2 { put(t, " mul:4") }
        if omod == 3 { put(t, " div:2") }
    }
}
