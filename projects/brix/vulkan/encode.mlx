// An instruction of the RX 580's shader cores (GFX8) as a record of ours,
// and its words: what the driver's compiler writes, the interpreter and
// the disassembler read (decode.mlx), and tests/495 holds against the
// words LLVM's assembler gives for the same instructions.
//
// Every layout below is Mesa mesa-24.0.0's src/amd/compiler/
// aco_assembler.cpp, emit_instruction, read for gfx_level == GFX8 (the
// line of each format is named); the register numbers and constants are
// its aco_ir.h; the wait word is aco_ir.cpp's wait_imm::pack.
// tools/check_gcn_isa.py holds every one of these numbers against those
// files, and tools/check_gcn_encoding.sh every instruction the compiler
// can emit against the host's llvm-mc.
//
// AN OPERAND is one number for everything an instruction can read, as
// the card's 9-bit source fields have it: 0 to 101 the scalar registers,
// the special ones below, 128 to 208 the integers 0 to 64 and -1 to -16,
// 240 to 247 eight floats, 255 "the literal word that follows", and 256 +
// n the vector register n. A destination uses the same numbers (a vector
// destination is 256 + n too), so that the decoder gives back what the
// encoder was given.

const isa = @import("./isa.mlx")

// aco_ir.h: the special registers.
pub const FLAT_SCR_LO: u16 = 102
pub const FLAT_SCR_HI: u16 = 103
pub const VCC: u16 = 106
pub const VCC_HI: u16 = 107
pub const TBA: u16 = 108
pub const TMA: u16 = 110
pub const TTMP0: u16 = 112
pub const M0: u16 = 124
pub const EXEC: u16 = 126
pub const EXEC_HI: u16 = 127
pub const SCC: u16 = 253
// aco_ir.h, Operand's constructors: 0 to 64 at 128 + v, -1 to -16 at
// 192 - v, the floats 0.5, -0.5, 1.0, -1.0, 2.0, -2.0, 4.0, -4.0 at 240
// to 247, 1/(2 pi) at 248 (GFX8 and later), the literal at 255.
pub const INT_ZERO: u16 = 128
pub const INT_MAX: u16 = 192
pub const INT_MINUS_ONE: u16 = 193
pub const INT_MINUS_SIXTEEN: u16 = 208
pub const FLOAT_HALF: u16 = 240
pub const FLOAT_INV_2PI: u16 = 248
pub const LITERAL: u16 = 255
pub const VGPR: u16 = 256
// aco_assembler.cpp: the source field that says "the operand is in the
// second word" for SDWA (249) and DPP (250).
pub const SDWA_SOURCE: u16 = 249
pub const DPP_SOURCE: u16 = 250

// The fixed bits of each format (aco_assembler.cpp, emit_instruction).
pub const SOP2_ENCODING: u32 = 0x80000000      // (0b10 << 30)
pub const SOPK_ENCODING: u32 = 0xB0000000      // (0b1011 << 28)
pub const SOP1_ENCODING: u32 = 0xBE800000      // (0b101111101 << 23)
pub const SOPC_ENCODING: u32 = 0xBF000000      // (0b101111110 << 23)
pub const SOPP_ENCODING: u32 = 0xBF800000      // (0b101111111 << 23)
pub const SMEM_ENCODING: u32 = 0xC0000000      // (0b110000 << 26), GFX8 and GFX9
pub const VOP1_ENCODING: u32 = 0x7E000000      // (0b0111111 << 25)
pub const VOPC_ENCODING: u32 = 0x7C000000      // (0b0111110 << 25)
pub const VOP3_ENCODING: u32 = 0xD0000000      // (0b110100 << 26), GFX9 and before
pub const VINTRP_ENCODING: u32 = 0xD4000000    // (0b110101 << 26), GFX8 and GFX9
pub const DS_ENCODING: u32 = 0xD8000000        // (0b110110 << 26)
pub const MUBUF_ENCODING: u32 = 0xE0000000     // (0b111000 << 26)
pub const MTBUF_ENCODING: u32 = 0xE8000000     // (0b111010 << 26)
pub const MIMG_ENCODING: u32 = 0xF0000000      // (0b111100 << 26)
pub const FLAT_ENCODING: u32 = 0xDC000000      // (0b110111 << 26)
pub const EXP_ENCODING: u32 = 0xC4000000       // (0b110001 << 26), GFX8 and GFX9
// A VOP2, VOP1, VOPC or VINTRP instruction in the VOP3 form: its number
// plus these (aco_assembler.cpp, the VOP3 case; VOP1 0x140 on GFX8 and GFX9).
pub const VOP3_FROM_VOP2: u16 = 0x100
pub const VOP3_FROM_VOP1: u16 = 0x140
pub const VOP3_FROM_VOPC: u16 = 0
pub const VOP3_FROM_VINTRP: u16 = 0x270

// What else an instruction says, as bits of `flags`.
pub const GLC: u32 = 1
pub const SLC: u32 = 2
pub const OFFEN: u32 = 4
pub const IDXEN: u32 = 8
pub const TFE: u32 = 16
pub const LDS: u32 = 32
pub const GDS: u32 = 64
pub const CLAMP: u32 = 128
// A scalar load's offset is the immediate (`imm`), not a register (`src1`).
pub const IMM: u32 = 256
pub const DONE: u32 = 512
pub const VALID_MASK: u32 = 1024
pub const COMPRESSED: u32 = 2048
pub const UNORM: u32 = 4096
pub const DA: u32 = 8192
pub const R128: u32 = 16384
pub const LWE: u32 = 32768
// DPP: the bound control and the bit written into the instruction for it.
pub const BOUND_CTRL: u32 = 65536

// How a VOP1, VOP2 or VOPC instruction is written.
pub const Form = enum(u8) {
    native,
    vop3,
    sdwa,
    dpp,
}

// One instruction. What each field means depends on the format:
//   SOP2, SOP1, SOPC, SOPK: dst, src0, src1; SOPK's and SOPP's 16 bits in
//                           imm
//   SMEM     dst the data (first register), src0 the base pair's first
//            register; with IMM the byte offset in imm, else the offset's
//            register in src1
//   VOP1/2/C dst, src0, src1 (src2 in the VOP3 form, and the VOP3 form's
//            second destination, a carry or a comparison's pair, in dst2;
//            a VOPC instruction's destination is dst: vcc natively)
//   VOP3     dst, dst2 (the VOP3b ones: a scalar pair), src0 to src2;
//            mods: abs bits 0-2, neg bits 3-5, omod bits 6-7
//   VINTRP   dst, src0 (v_interp_mov: 0 to 2, the parameter), extra the
//            attribute | channel << 8
//   DS       dst, src0 the address, src1 and src2 the data, imm offset0 |
//            offset1 << 8
//   MUBUF    dst the data, src0 the address register, src1 the resource's
//            first register, src2 the scalar offset; imm the offset; MTBUF
//            also extra: data format | number format << 4
//   MIMG     dst the data, src0 the first address register, src1 the
//            resource, src2 the sampler, extra the component mask
//   FLAT     dst the loaded data, src0 the address pair's first, src1 the
//            stored data
//   EXP      src0 to src3, imm the target, extra the enabled components
// DPP: extra dpp_ctrl, mods row_mask | bank_mask << 4 | abs0 << 8 | neg0 <<
// 9 | abs1 << 10 | neg1 << 11. SDWA: extra dst_sel | dst_unused << 3 |
// src0_sel << 8 | src0 sext << 11 | src1_sel << 16 | src1 sext << 19; mods
// abs0 | neg0 << 1 | abs1 << 2 | neg1 << 3 | omod << 4.
pub const Inst = struct {
    op: isa.Op
    form: Form
    dst: u16
    dst2: u16
    src0: u16
    src1: u16
    src2: u16
    src3: u16
    literal: u32
    imm: u32
    flags: u32
    mods: u32
    extra: u32
}

pub fn blank(op: isa.Op) -> Inst {
    return Inst.{ .op = op, .form = Form.native, .dst = 0, .dst2 = 0, .src0 = 0, .src1 = 0, .src2 = 0, .src3 = 0, .literal = 0, .imm = 0, .flags = 0, .mods = 0, .extra = 0 }
}

// Where `op` is in isa's table, or COUNT when this generation has no such
// instruction. The table is in the order of its codes.
pub fn find(op: isa.Op) -> usize {
    const code = @intCast(u32, @intFromEnum(op.format)) << 16 | @intCast(u32, op.number)
    var low: usize = 0
    var high: usize = isa.COUNT
    while low < high {
        const middle = (low + high) / 2
        if isa.CODE[middle] < code {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low < isa.COUNT && isa.CODE[low] == code { return low }
    return isa.COUNT
}

pub fn isVgpr(operand: u16) -> bool { return operand >= VGPR && operand < VGPR + 256 }
pub fn isSgpr(operand: u16) -> bool { return operand < 128 }
// An inline constant: the integers and the floats.
pub fn isInline(operand: u16) -> bool {
    return (operand >= INT_ZERO && operand <= INT_MINUS_SIXTEEN) || (operand >= FLOAT_HALF && operand <= FLOAT_INV_2PI)
}

// The operand for an integer, or LITERAL when it is none of the inline
// ones (the caller then puts the value into `literal`).
pub fn constant(value: u32) -> u16 {
    if value <= 64 { return INT_ZERO + @intCast(u16, value) }
    if value >= 0xFFFFFFF0 { return INT_MAX + @intCast(u16, 0 -% value) }
    return LITERAL
}

// The wait word of s_waitcnt (aco_ir.cpp, wait_imm::pack, before GFX9): vm
// in bits 3:0, exp in 6:4, lgkm in 11:8; a counter not waited for is all
// ones in its field (15, 7, 15).
pub const WAIT_VM_MASK: u32 = 0xF
pub const WAIT_EXP_SHIFT: u32 = 4
pub const WAIT_EXP_MASK: u32 = 0x7
pub const WAIT_LGKM_SHIFT: u32 = 8
pub const WAIT_LGKM_MASK: u32 = 0xF

pub fn waitWord(vm: u32, exp: u32, lgkm: u32) -> u32 {
    return (lgkm & WAIT_LGKM_MASK) << WAIT_LGKM_SHIFT | (exp & WAIT_EXP_MASK) << WAIT_EXP_SHIFT | (vm & WAIT_VM_MASK)
}

fn field(value: u16, bits: u32) -> u32 { return @intCast(u32, value) & ((@intCast(u32, 1) << bits) - 1) }

fn uses(inst: *const Inst, operand: u16) -> bool {
    return inst.*.src0 == operand || inst.*.src1 == operand || inst.*.src2 == operand
}

// The words of `inst` into `out` (room for 3 or more): their count, or 0 when the
// instruction cannot be written (this generation has no such instruction,
// a register out of its field's range, a literal where none may stand).
pub fn encode(inst: *const Inst, out: []u32) -> usize {
    if out.length < 3 { return 0 }
    const i = inst.*
    if i.op.format != isa.Format.exp && find(i.op) == isa.COUNT { return 0 }
    const number = @intCast(u32, i.op.number)
    var count: usize = 1
    var literal = false
    if i.op.format == isa.Format.sop2 {
        // aco_assembler.cpp: Format::SOP2
        if i.dst > 127 || i.src0 > 255 || i.src1 > 255 { return 0 }
        out[0] = SOP2_ENCODING | number << 23 | field(i.dst, 7) << 16 | field(i.src1, 8) << 8 | field(i.src0, 8)
        literal = i.src0 == LITERAL || i.src1 == LITERAL
    } else if i.op.format == isa.Format.sopk {
        // Format::SOPK
        if i.dst > 127 { return 0 }
        out[0] = SOPK_ENCODING | number << 23 | field(i.dst, 7) << 16 | (i.imm & 0xFFFF)
        // s_setreg_imm32_b32 takes a literal word besides (aco_opcodes.py)
        literal = i.src0 == LITERAL
    } else if i.op.format == isa.Format.sop1 {
        // Format::SOP1
        if i.dst > 127 || i.src0 > 255 { return 0 }
        out[0] = SOP1_ENCODING | field(i.dst, 7) << 16 | number << 8 | field(i.src0, 8)
        literal = i.src0 == LITERAL
    } else if i.op.format == isa.Format.sopc {
        // Format::SOPC
        if i.src0 > 255 || i.src1 > 255 { return 0 }
        out[0] = SOPC_ENCODING | number << 16 | field(i.src1, 8) << 8 | field(i.src0, 8)
        literal = i.src0 == LITERAL || i.src1 == LITERAL
    } else if i.op.format == isa.Format.sopp {
        // Format::SOPP
        out[0] = SOPP_ENCODING | number << 16 | (i.imm & 0xFFFF)
    } else if i.op.format == isa.Format.smem {
        // Format::SMEM, GFX8: the immediate bit 17, glc 16, the data
        // register << 6, the base pair's first register >> 1; the
        // second word the offset in bytes (20 bits) or the offset's
        // register. GFX8 has no soffset beside an immediate.
        if i.dst > 127 || i.src0 > 127 || (i.src0 & 1) != 0 { return 0 }
        var word = SMEM_ENCODING | number << 18 | field(i.dst, 7) << 6 | (field(i.src0, 7) >> 1)
        if (i.flags & GLC) != 0 { word |= 1 << 16 }
        if (i.flags & IMM) != 0 {
            if i.imm > 0xFFFFF { return 0 }
            word |= 1 << 17
            out[1] = i.imm
        } else {
            if i.src1 > 127 { return 0 }
            out[1] = @intCast(u32, i.src1)
        }
        out[0] = word
        return 2
    } else if i.op.format == isa.Format.vop2 || i.op.format == isa.Format.vop1 || i.op.format == isa.Format.vopc {
        return encodeVector(inst, out)
    } else if i.op.format == isa.Format.vop3 {
        return encodeVop3(inst, out, number)
    } else if i.op.format == isa.Format.vintrp {
        if i.form == Form.vop3 { return encodeVop3(inst, out, number + @intCast(u32, VOP3_FROM_VINTRP)) }
        // Format::VINTRP, GFX8: (0b110101 << 26), the destination << 18,
        // the opcode << 16, attribute << 10, channel << 8, the source
        // (v_interp_mov: its parameter, 0 to 2).
        if !isVgpr(i.dst) { return 0 }
        var source: u32 = 0
        if i.op.number == isa.V_INTERP_MOV_F32.number {
            if i.src0 > 2 { return 0 }
            source = @intCast(u32, i.src0)
        } else {
            if !isVgpr(i.src0) { return 0 }
            source = field(i.src0, 8)
        }
        out[0] = VINTRP_ENCODING | field(i.dst, 8) << 18 | number << 16 | (i.extra & 0x3F) << 10 | ((i.extra >> 8) & 3) << 8 | source
    } else if i.op.format == isa.Format.ds {
        // Format::DS, GFX8: opcode << 17, gds << 16, offset1 << 8,
        // offset0; second word: the destination << 24, data1 << 16,
        // data0 << 8, the address (8-bit vector register numbers).
        var word = DS_ENCODING | number << 17 | (i.imm & 0xFFFF)
        if (i.flags & GDS) != 0 { word |= 1 << 16 }
        out[0] = word
        out[1] = field(i.dst, 8) << 24 | field(i.src2, 8) << 16 | field(i.src1, 8) << 8 | field(i.src0, 8)
        return 2
    } else if i.op.format == isa.Format.mubuf {
        // Format::MUBUF, GFX8: opcode << 18, slc 17, lds 16, glc 14,
        // idxen 13, offen 12, the 12-bit offset; second word: soffset
        // << 24, tfe 23, the resource's first register >> 2 << 16, the
        // data << 8, the address.
        if i.src1 > 127 || (i.src1 & 3) != 0 || i.src2 > 255 || i.imm > 0xFFF { return 0 }
        var word = MUBUF_ENCODING | number << 18 | i.imm
        word |= memoryFlags(i.flags)
        if (i.flags & LDS) != 0 { word |= 1 << 16 }
        out[0] = word
        var second = field(i.src2, 8) << 24 | (field(i.src1, 7) >> 2) << 16 | field(i.dst, 8) << 8 | field(i.src0, 8)
        if (i.flags & TFE) != 0 { second |= 1 << 23 }
        out[1] = second
        return 2
    } else if i.op.format == isa.Format.mtbuf {
        // Format::MTBUF, GFX8: the format (dfmt | nfmt << 4) << 19,
        // opcode << 15, glc 14, idxen 13, offen 12, the offset; second
        // word as MUBUF's with slc at 22.
        if i.src1 > 127 || (i.src1 & 3) != 0 || i.src2 > 255 || i.imm > 0xFFF || i.extra > 0x7F { return 0 }
        var word = MTBUF_ENCODING | i.extra << 19 | number << 15 | i.imm
        if (i.flags & GLC) != 0 { word |= 1 << 14 }
        if (i.flags & IDXEN) != 0 { word |= 1 << 13 }
        if (i.flags & OFFEN) != 0 { word |= 1 << 12 }
        out[0] = word
        var second = field(i.src2, 8) << 24 | (field(i.src1, 7) >> 2) << 16 | field(i.dst, 8) << 8 | field(i.src0, 8)
        if (i.flags & TFE) != 0 { second |= 1 << 23 }
        if (i.flags & SLC) != 0 { second |= 1 << 22 }
        out[1] = second
        return 2
    } else if i.op.format == isa.Format.mimg {
        // Format::MIMG before GFX10: slc 25, opcode << 18 (7 bits; the
        // eighth at bit 0), lwe 17, tfe 16, a16/r128 15, da 14, glc 13,
        // unorm 12, dmask << 8; second word: the sampler's first
        // register >> 2 << 21, the resource's >> 2 << 16, the data << 8,
        // the address.
        if i.src1 > 127 || (i.src1 & 3) != 0 || i.src2 > 127 || (i.src2 & 3) != 0 || i.extra > 0xF { return 0 }
        var word = MIMG_ENCODING | (number & 0x7F) << 18 | ((number >> 7) & 1) | i.extra << 8
        if (i.flags & SLC) != 0 { word |= 1 << 25 }
        if (i.flags & LWE) != 0 { word |= 1 << 17 }
        if (i.flags & TFE) != 0 { word |= 1 << 16 }
        if (i.flags & R128) != 0 { word |= 1 << 15 }
        if (i.flags & DA) != 0 { word |= 1 << 14 }
        if (i.flags & GLC) != 0 { word |= 1 << 13 }
        if (i.flags & UNORM) != 0 { word |= 1 << 12 }
        out[0] = word
        out[1] = (field(i.src2, 7) >> 2) << 21 | (field(i.src1, 7) >> 2) << 16 | field(i.dst, 8) << 8 | field(i.src0, 8)
        return 2
    } else if i.op.format == isa.Format.flat {
        // Format::FLAT, GFX8: opcode << 18, slc 17, glc 16, lds 13, the
        // offset 0; second word: the destination << 24, the data << 8,
        // the address pair's first register.
        var word = FLAT_ENCODING | number << 18
        if (i.flags & GLC) != 0 { word |= 1 << 16 }
        if (i.flags & SLC) != 0 { word |= 1 << 17 }
        if (i.flags & LDS) != 0 { word |= 1 << 13 }
        out[0] = word
        var second = field(i.dst, 8) << 24 | field(i.src1, 8) << 8 | field(i.src0, 8)
        if (i.flags & TFE) != 0 { second |= 1 << 23 }
        out[1] = second
        return 2
    } else if i.op.format == isa.Format.exp {
        // Format::EXP, GFX8: valid mask 12, done 11, compressed 10, the
        // target << 4, the enabled components; second word: the four
        // vector registers.
        var word = EXP_ENCODING | (i.imm & 0x3F) << 4 | (i.extra & 0xF)
        if (i.flags & VALID_MASK) != 0 { word |= 1 << 12 }
        if (i.flags & DONE) != 0 { word |= 1 << 11 }
        if (i.flags & COMPRESSED) != 0 { word |= 1 << 10 }
        out[0] = word
        out[1] = field(i.src3, 8) << 24 | field(i.src2, 8) << 16 | field(i.src1, 8) << 8 | field(i.src0, 8)
        return 2
    }
    if literal {
        out[count] = i.literal
        count += 1
    }
    return count
}

fn memoryFlags(flags: u32) -> u32 {
    var word: u32 = 0
    if (flags & SLC) != 0 { word |= 1 << 17 }
    if (flags & GLC) != 0 { word |= 1 << 14 }
    if (flags & IDXEN) != 0 { word |= 1 << 13 }
    if (flags & OFFEN) != 0 { word |= 1 << 12 }
    return word
}

// VOP1, VOP2, VOPC in their own forms, as SDWA, as DPP, or in the VOP3 form.
fn encodeVector(inst: *const Inst, out: []u32) -> usize {
    const i = inst.*
    var number = @intCast(u32, i.op.number)
    if i.form == Form.vop3 {
        if i.op.format == isa.Format.vop2 { number += @intCast(u32, VOP3_FROM_VOP2) }
        if i.op.format == isa.Format.vop1 { number += @intCast(u32, VOP3_FROM_VOP1) }
        return encodeVop3(inst, out, number)
    }
    var source = i.src0
    if i.form == Form.sdwa { source = SDWA_SOURCE }
    if i.form == Form.dpp { source = DPP_SOURCE }
    if source > 511 { return 0 }
    var word: u32 = 0
    if i.op.format == isa.Format.vop2 {
        // Format::VOP2: opcode << 25, the destination << 17, the second
        // source (a vector register) << 9, the first source.
        if !isVgpr(i.dst) || !isVgpr(i.src1) { return 0 }
        word = number << 25 | field(i.dst, 8) << 17 | field(i.src1, 8) << 9 | field(source, 9)
    } else if i.op.format == isa.Format.vop1 {
        // Format::VOP1: (0b0111111 << 25), the destination << 17, opcode
        // << 9, the source. v_readfirstlane_b32 writes a scalar register.
        word = VOP1_ENCODING | field(i.dst, 8) << 17 | number << 9 | field(source, 9)
    } else {
        // Format::VOPC: (0b0111110 << 25), opcode << 17, the second source
        // << 9, the first; the result goes to vcc.
        if !isVgpr(i.src1) { return 0 }
        word = VOPC_ENCODING | number << 17 | field(i.src1, 8) << 9 | field(source, 9)
    }
    out[0] = word
    if i.form == Form.dpp {
        // the DPP word (aco_assembler.cpp, isDPP16): row_mask << 28,
        // bank_mask << 24, abs1 23, neg1 22, abs0 21, neg0 20, bound_ctrl
        // 19, dpp_ctrl << 8, the first source's vector register.
        if !isVgpr(i.src0) { return 0 }
        var dpp = (i.mods & 0xF) << 28 | ((i.mods >> 4) & 0xF) << 24 | (i.extra & 0x1FF) << 8 | field(i.src0, 8)
        if (i.mods & 0x100) != 0 { dpp |= 1 << 21 }
        if (i.mods & 0x200) != 0 { dpp |= 1 << 20 }
        if (i.mods & 0x400) != 0 { dpp |= 1 << 23 }
        if (i.mods & 0x800) != 0 { dpp |= 1 << 22 }
        if (i.flags & BOUND_CTRL) != 0 { dpp |= 1 << 19 }
        out[1] = dpp
        return 2
    }
    if i.form == Form.sdwa {
        // the SDWA word (aco_assembler.cpp, isSDWA, GFX8): dst_sel << 8,
        // dst_unused << 11, clamp 13, omod << 14 (VOPC: none of these),
        // src0_sel << 16, sext0 19, neg0 20, abs0 21, src1_sel << 24,
        // sext1 27, neg1 28, abs1 29, the first source's register. On GFX8
        // the sources are vector registers (the "is a scalar" bits 23 and
        // 31 are GFX9's).
        if !isVgpr(i.src0) { return 0 }
        var sdwa = (i.extra & 0x7) << 8 | ((i.extra >> 3) & 0x3) << 11 | ((i.extra >> 8) & 0x7) << 16 | ((i.extra >> 16) & 0x7) << 24 | field(i.src0, 8)
        if i.op.format == isa.Format.vopc { sdwa = ((i.extra >> 8) & 0x7) << 16 | ((i.extra >> 16) & 0x7) << 24 | field(i.src0, 8) }
        if (i.extra & 0x800) != 0 { sdwa |= 1 << 19 }
        if (i.extra & 0x80000) != 0 { sdwa |= 1 << 27 }
        if (i.mods & 1) != 0 { sdwa |= 1 << 21 }
        if (i.mods & 2) != 0 { sdwa |= 1 << 20 }
        if (i.mods & 4) != 0 { sdwa |= 1 << 29 }
        if (i.mods & 8) != 0 { sdwa |= 1 << 28 }
        if i.op.format != isa.Format.vopc {
            sdwa |= ((i.mods >> 4) & 3) << 14
            if (i.flags & CLAMP) != 0 { sdwa |= 1 << 13 }
        }
        out[1] = sdwa
        return 2
    }
    // v_madmk and v_madak carry their constant K as a literal word
    // (aco_opcodes.py: src(1, 1, 1), K the literal)
    const n = i.op.number
    const constantK = i.op.format == isa.Format.vop2 && (n == isa.V_MADMK_F32.number || n == isa.V_MADAK_F32.number || n == isa.V_MADMK_F16.number || n == isa.V_MADAK_F16.number)
    if i.src0 == LITERAL || constantK {
        out[1] = i.literal
        return 2
    }
    return 1
}

// Whether `op` is one of the VOP3b instructions, which write a scalar pair
// besides their result (a carry, the scale's flag): the ones whose second
// definition aco_opcodes.py names as vcc (dst(1, VCC)); in the VOP3 form
// that pair is any scalar pair, in bits 14:8 where the others have abs.
pub fn hasSecondDestination(op: isa.Op) -> bool {
    const at = find(op)
    if at == isa.COUNT || isa.DEFS[at] == 0xFFFFFFFF { return false }
    return ((isa.DEFS[at] >> 8) & 0xFF) == @intCast(u32, VCC)
}

// The VOP3 form (aco_assembler.cpp, isVOP3, GFX8): (0b110100 << 26), the
// opcode << 16, clamp 15, abs << 8, the second (scalar) destination << 8 for
// VOP3b, the destination; second word: the sources at 0, 9 and 18, omod <<
// 27, neg << 29. On GFX8 a VOP3 instruction takes no literal word.
fn encodeVop3(inst: *const Inst, out: []u32, number: u32) -> usize {
    const i = inst.*
    if i.dst > 511 || i.src0 > 511 || i.src1 > 511 || i.src2 > 511 { return 0 }
    if uses(inst, LITERAL) { return 0 }
    var word = VOP3_ENCODING | number << 16 | field(i.dst, 8)
    if (i.flags & CLAMP) != 0 { word |= 1 << 15 }
    if hasSecondDestination(i.op) {
        if i.dst2 > 127 { return 0 }
        word |= field(i.dst2, 7) << 8
    } else {
        word |= (i.mods & 7) << 8
    }
    out[0] = word
    out[1] = field(i.src0, 9) | field(i.src1, 9) << 9 | field(i.src2, 9) << 18 | ((i.mods >> 6) & 3) << 27 | ((i.mods >> 3) & 7) << 29
    return 2
}
