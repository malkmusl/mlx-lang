// The driver's interface to the kernel on brixOS (card.mlx): the native
// calls for a graphics card, through std.gpucard.
const gpucard = @import("std.gpucard")
const card = @import("./card.mlx")

fn count() -> usize { return gpucard.count() }

fn describe(index: usize, into: *gpucard.Device) -> isize { return gpucard.describe(index, into) }

fn open(index: usize) -> isize { return gpucard.open(index) }

fn describeContext(context: u32, into: *gpucard.Device) -> isize { return gpucard.describeContext(context, into) }

fn close(context: u32) -> isize { return gpucard.close(context) }

fn memory(context: u32, size: usize, flags: usize) -> isize { return gpucard.memory(context, size, flags) }

fn memoryOf(context: u32, address: usize, size: usize) -> isize { return gpucard.memoryOf(context, address, size) }

fn map(context: u32, memory_handle: u32, offset: usize, size: usize, address: usize, flags: usize) -> isize { return gpucard.map(context, memory_handle, offset, size, address, flags) }

fn unmap(context: u32, address: usize, size: usize) -> isize { return gpucard.unmap(context, address, size) }

fn submit(context: u32, streams: usize, count_of_streams: usize, fence_handle: u32) -> isize {
    const first: [*]const gpucard.Stream = unsafe { @ptrFromInt([*]const gpucard.Stream, streams) }
    return gpucard.submit(context, first[0..count_of_streams], fence_handle)
}

fn fence(context: u32) -> isize { return gpucard.fence(context) }

// brixOS's implementation of the interface.
pub fn interface() -> card.Card {
    return card.Card.{ .count = count, .describe = describe, .open = open, .describeContext = describeContext, .close = close, .memory = memory, .memoryOf = memoryOf, .map = map, .unmap = unmap, .submit = submit, .fence = fence }
}
