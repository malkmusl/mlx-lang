// The driver's images, image views, render passes and framebuffers
// (stage (c), the study's 8.2 (c)).
//
// AN IMAGE of this stage is a linear colour image: 2D, one mip level, one
// layer, one sample, VK_IMAGE_TILING_LINEAR, R8G8B8A8_UNORM or
// B8G8R8A8_UNORM (the formats the colour block takes here, as
// driver.mlx's format list says). Its layout is the one the card's
// address library gives a linear aligned surface (Mesa's addrlib, src/amd/
// addrlib/src/r800: egbaddrlib.cpp ComputeSurfaceAlignmentsLinear, the
// base at the pipe interleave, the height one row; siaddrlib.cpp
// HwlGetPitchAlignmentLinear, the row a multiple of max(8, 64 / bytes a
// pixel) pixels, 16 here; HwlGetSizeAdjustmentLinear, the row grown by
// that until the image is a multiple of 64 pixels): so CB_COLOR0_PITCH's
// tiles of 8 pixels and _SLICE's of 64 come out whole (radv_initialise_
// color_surface's TILE_MAX = nblk_x / 8 - 1 and nblk_x * nblk_y / 64 - 1)
// and _BASE takes the address >> 8. vkGetImageSubresourceLayout says
// it. The colour target names the tile mode table's entry
// LINEAR_TILE_MODE (below).
//
// A RENDER PASS is kept as what dynamic rendering needs (render.mlx): one
// subpass, its colour attachments with their load and store operations,
// no input, resolve or depth attachments; the dependencies from and to
// VK_SUBPASS_EXTERNAL become the barriers at its start and its end
// (vkCmdBeginRenderPass, vkCmdEndRenderPass), each a memory barrier with
// the implicit dependency of the specification added as Mesa's render
// pass of the runtime adds it to every pass (src/vulkan/runtime/
// vk_render_pass.c, which RADV's render passes are: at the start
// ALL_COMMANDS with the attachments' reads and writes as the target, at
// the end ALL_COMMANDS with the colour and depth writes as the source).
// vkCreateRenderPass2 (the
// extension VK_KHR_create_renderpass2) makes the same object. A
// FRAMEBUFFER is its image views and size.
const std = @import("std")
const vk = @import("std.vulkan")
const device = @import("./device.mlx")
const memory = @import("./memory.mlx")

const DeviceObject = device.DeviceObject

// The tile mode table's entry of a linear colour target: the kernel's
// table (projects/brix/kernel/gpu_compute.mlx TILE_MODES, Linux's
// gfx_v8_0.c tiling table for Polaris 10, modearray[8]) has ARRAY_MODE
// ARRAY_LINEAR_ALIGNED there; tools/check_vulkan_driver.py holds it. The
// record does not carry the table (amdgpu's info ioctl gives RADV the
// kernel's table, ac_gpu_info.c si_tile_mode_array): both sides are built
// from this tree.
pub const LINEAR_TILE_MODE: u32 = 8

// The image's layout's granules (above): the row's alignment in pixels
// (32 bits a pixel), the image's (sliceAlignInPixel: 64 pixels, the pipe
// interleave's 256 bytes being 64 pixels too), the base's (Polaris 10's
// pipe interleave: GB_ADDR_CONFIG's PIPE_INTERLEAVE_SIZE 0 in Linux's
// gfx_v8_0.c, 256 bytes).
pub const PITCH_PIXELS: u32 = 16
pub const SLICE_PIXELS: u32 = 64
pub const BASE_ALIGNMENT: u64 = 256
pub const MOST_EXTENT: u32 = 16384

pub const ImageObject = struct {
    format: vk.Format
    width: u32
    height: u32
    // The row in pixels, the rows counted, the bytes.
    pitch: u32
    rows: u32
    size: u64
    usage: u32
    // Bound memory (0: none), its card address.
    memory: usize
    address: u64
}

pub const ImageViewObject = struct {
    image: usize
    format: vk.Format
}

pub const MOST_ATTACHMENTS: usize = 8

pub const RenderPassObject = struct {
    attachmentCount: u32
    formats: [8]vk.Format
    loadOps: [8]vk.AttachmentLoadOp
    // The subpass's colour attachments (ATTACHMENT_UNUSED: none).
    colourCount: u32
    colours: [8]u32
    // The dependencies from and to VK_SUBPASS_EXTERNAL.
    beginSource: u32
    beginTarget: u32
    beginSourceAccess: u32
    beginTargetAccess: u32
    endSource: u32
    endTarget: u32
    endSourceAccess: u32
    endTargetAccess: u32
}

pub const FramebufferObject = struct {
    pass: usize
    count: u32
    views: [8]usize
    width: u32
    height: u32
}

pub fn imageOf(handle: vk.Image) -> *ImageObject { return unsafe { @ptrFromInt(*ImageObject, handle) } }
pub fn viewOf(handle: vk.ImageView) -> *ImageViewObject { return unsafe { @ptrFromInt(*ImageViewObject, handle) } }
pub fn passOf(handle: vk.RenderPass) -> *RenderPassObject { return unsafe { @ptrFromInt(*RenderPassObject, handle) } }
pub fn framebufferOf(handle: vk.Framebuffer) -> *FramebufferObject { return unsafe { @ptrFromInt(*FramebufferObject, handle) } }

// Whether `format` is a colour format of this stage.
pub fn colourFormat(format: vk.Format) -> bool { return format == vk.Format.r8g8b8a8Unorm || format == vk.Format.b8g8r8a8Unorm }

// The usages a linear image of this stage takes.
pub const USAGES: u32 = vk.IMAGE_USAGE_TRANSFER_SRC_BIT | vk.IMAGE_USAGE_COLOR_ATTACHMENT_BIT

fn roundUp(value: u32, to: u32) -> u32 { return (value + to - 1) / to * to }

// ---------------------------------------------------------------------------
// Images

pub fn createImage(handle: vk.Device, info: *const vk.ImageCreateInfo, callbacks: ?*const vk.AllocationCallbacks, into: *vk.Image) -> vk.Result {
    into.* = 0
    const e = info.*.extent
    if info.*.flags != 0 || info.*.imageType != vk.ImageType.type2d || !colourFormat(info.*.format) || info.*.tiling != vk.ImageTiling.linear || info.*.mipLevels != 1 || info.*.arrayLayers != 1 || info.*.samples != vk.SAMPLE_COUNT_1_BIT { return vk.Result.errorUnknown }
    if e.depth != 1 || e.width == 0 || e.height == 0 || e.width > MOST_EXTENT || e.height > MOST_EXTENT || (info.*.usage & ~USAGES) != 0 || info.*.usage == 0 { return vk.Result.errorUnknown }
    const address = device.allocate(callbacks, @sizeOf(ImageObject), vk.SystemAllocationScope.object)
    if address == 0 { return vk.Result.errorOutOfHostMemory }
    const made = imageOf(address)
    made.*.format = info.*.format
    made.*.width = e.width
    made.*.height = e.height
    // (HwlGetSizeAdjustmentLinear: the row grown, not the height)
    var pitch = roundUp(e.width, PITCH_PIXELS)
    while (pitch * e.height) % SLICE_PIXELS != 0 { pitch += PITCH_PIXELS }
    made.*.pitch = pitch
    made.*.rows = e.height
    made.*.size = @intCast(u64, made.*.pitch) * @intCast(u64, made.*.rows) * 4
    made.*.usage = info.*.usage
    made.*.memory = 0
    made.*.address = 0
    into.* = address
    return vk.Result.success
}

pub fn destroyImage(handle: vk.Device, given: vk.Image, callbacks: ?*const vk.AllocationCallbacks) -> void {
    if given == 0 { return }
    device.release(callbacks, given, @sizeOf(ImageObject))
}

fn everyType(owner: *const DeviceObject) -> u32 { return if owner.*.memory.memoryTypeCount >= 32 { 0xFFFFFFFF } else { (@intCast(u32, 1) << @intCast(u5, owner.*.memory.memoryTypeCount)) - 1 } }

pub fn getImageMemoryRequirements(handle: vk.Device, given: vk.Image, into: *vk.MemoryRequirements) -> void {
    const made = imageOf(given)
    into.*.size = made.*.size
    into.*.alignment = BASE_ALIGNMENT
    into.*.memoryTypeBits = everyType(device.deviceOf(handle))
}

pub fn bindImageMemory(handle: vk.Device, given: vk.Image, backing: vk.DeviceMemory, offset: vk.DeviceSize) -> vk.Result {
    const made = imageOf(given)
    const m = memory.memoryOf(backing)
    if offset % BASE_ALIGNMENT != 0 || offset >= m.*.size || made.*.size > m.*.size - offset { return vk.Result.errorOutOfDeviceMemory }
    made.*.memory = backing
    made.*.address = m.*.block.address + offset
    return vk.Result.success
}

pub fn getImageSubresourceLayout(handle: vk.Device, given: vk.Image, subresource: *const vk.ImageSubresource, into: *vk.SubresourceLayout) -> void {
    const made = imageOf(given)
    into.*.offset = 0
    into.*.size = made.*.size
    into.*.rowPitch = @intCast(u64, made.*.pitch) * 4
    into.*.arrayPitch = made.*.size
    into.*.depthPitch = made.*.size
}

// ---------------------------------------------------------------------------
// Vulkan 1.1's forms (with VkMemoryDedicatedRequirements: no dedicated
// allocation wanted or needed)

const Chained = struct {
    sType: vk.StructureType
    pNext: ?*anyopaque
}

fn dedicated(next: ?*anyopaque) -> void {
    var at = next
    while at != null {
        const chained: *Chained = unsafe { @ptrCast(*Chained, at.?) }
        if chained.*.sType == vk.StructureType.memoryDedicatedRequirements {
            const words: [*]u32 = unsafe { @ptrCast([*]u32, at.?) }
            // prefersDedicatedAllocation, requiresDedicatedAllocation
            words[4] = vk.FALSE
            words[5] = vk.FALSE
        }
        at = chained.*.pNext
    }
}

pub fn getImageMemoryRequirements2(handle: vk.Device, info: *const vk.ImageMemoryRequirementsInfo2, into: *vk.MemoryRequirements2) -> void {
    getImageMemoryRequirements(handle, info.*.image, &into.*.memoryRequirements)
    dedicated(into.*.pNext)
}

pub fn getBufferMemoryRequirements2(handle: vk.Device, info: *const vk.BufferMemoryRequirementsInfo2, into: *vk.MemoryRequirements2) -> void {
    memory.getBufferMemoryRequirements(handle, info.*.buffer, &into.*.memoryRequirements)
    dedicated(into.*.pNext)
}

pub fn bindImageMemory2(handle: vk.Device, count: u32, infos: ?[*]const vk.BindImageMemoryInfo) -> vk.Result {
    var k: usize = 0
    while k < @intCast(usize, count) {
        const result = bindImageMemory(handle, infos.?[k].image, infos.?[k].memory, infos.?[k].memoryOffset)
        if result != vk.Result.success { return result }
        k += 1
    }
    return vk.Result.success
}

pub fn bindBufferMemory2(handle: vk.Device, count: u32, infos: ?[*]const vk.BindBufferMemoryInfo) -> vk.Result {
    var k: usize = 0
    while k < @intCast(usize, count) {
        const result = memory.bindBufferMemory(handle, infos.?[k].buffer, infos.?[k].memory, infos.?[k].memoryOffset)
        if result != vk.Result.success { return result }
        k += 1
    }
    return vk.Result.success
}

// ---------------------------------------------------------------------------
// Image views

pub fn createImageView(handle: vk.Device, info: *const vk.ImageViewCreateInfo, callbacks: ?*const vk.AllocationCallbacks, into: *vk.ImageView) -> vk.Result {
    into.* = 0
    const r = info.*.subresourceRange
    const c = info.*.components
    const identity = (c.r == vk.ComponentSwizzle.identity || c.r == vk.ComponentSwizzle.r) && (c.g == vk.ComponentSwizzle.identity || c.g == vk.ComponentSwizzle.g) && (c.b == vk.ComponentSwizzle.identity || c.b == vk.ComponentSwizzle.b) && (c.a == vk.ComponentSwizzle.identity || c.a == vk.ComponentSwizzle.a)
    if info.*.image == 0 || info.*.viewType != vk.ImageViewType.type2d || info.*.format != imageOf(info.*.image).*.format || !identity || r.aspectMask != vk.IMAGE_ASPECT_COLOR_BIT || r.baseMipLevel != 0 || r.baseArrayLayer != 0 || (r.levelCount != 1 && r.levelCount != vk.REMAINING_MIP_LEVELS) || (r.layerCount != 1 && r.layerCount != vk.REMAINING_ARRAY_LAYERS) { return vk.Result.errorUnknown }
    const address = device.allocate(callbacks, @sizeOf(ImageViewObject), vk.SystemAllocationScope.object)
    if address == 0 { return vk.Result.errorOutOfHostMemory }
    viewOf(address).*.image = info.*.image
    viewOf(address).*.format = info.*.format
    into.* = address
    return vk.Result.success
}

pub fn destroyImageView(handle: vk.Device, given: vk.ImageView, callbacks: ?*const vk.AllocationCallbacks) -> void {
    if given == 0 { return }
    device.release(callbacks, given, @sizeOf(ImageViewObject))
}

// ---------------------------------------------------------------------------
// Render passes

fn newPass(callbacks: ?*const vk.AllocationCallbacks) -> usize {
    const address = device.allocate(callbacks, @sizeOf(RenderPassObject), vk.SystemAllocationScope.object)
    if address == 0 { return 0 }
    const p = passOf(address)
    p.*.attachmentCount = 0
    p.*.colourCount = 0
    p.*.beginSource = 0
    p.*.beginTarget = 0
    p.*.beginSourceAccess = 0
    p.*.beginTargetAccess = 0
    p.*.endSource = 0
    p.*.endTarget = 0
    p.*.endSourceAccess = 0
    p.*.endTargetAccess = 0
    return address
}

// A dependency of the subpass: from or to VK_SUBPASS_EXTERNAL.
fn depend(p: *RenderPassObject, source: u32, target: u32, sourceStages: u32, targetStages: u32, sourceAccess: u32, targetAccess: u32) -> bool {
    if source == vk.SUBPASS_EXTERNAL && target == 0 {
        p.*.beginSource |= sourceStages
        p.*.beginTarget |= targetStages
        p.*.beginSourceAccess |= sourceAccess
        p.*.beginTargetAccess |= targetAccess
        return true
    }
    if source == 0 && target == vk.SUBPASS_EXTERNAL {
        p.*.endSource |= sourceStages
        p.*.endTarget |= targetStages
        p.*.endSourceAccess |= sourceAccess
        p.*.endTargetAccess |= targetAccess
        return true
    }
    // (The subpass on itself: a barrier inside it, which this stage does
    // not record.)
    return source == 0 && target == 0
}

// The implicit dependencies from and to VK_SUBPASS_EXTERNAL, added to
// those the pass gives (vk_render_pass.c: the first subpass's begin, the
// last subpass's end).
fn implicitDependencies(p: *RenderPassObject) -> void {
    p.*.beginTarget |= vk.PIPELINE_STAGE_ALL_COMMANDS_BIT
    p.*.beginTargetAccess |= vk.ACCESS_INPUT_ATTACHMENT_READ_BIT | vk.ACCESS_COLOR_ATTACHMENT_READ_BIT | vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT | vk.ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | vk.ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT
    p.*.endSource |= vk.PIPELINE_STAGE_ALL_COMMANDS_BIT
    p.*.endSourceAccess |= vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT | vk.ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT
}

fn attachment(p: *RenderPassObject, format: vk.Format, samples: u32, loadOp: vk.AttachmentLoadOp) -> bool {
    if p.*.attachmentCount >= @intCast(u32, MOST_ATTACHMENTS) || !colourFormat(format) || samples != vk.SAMPLE_COUNT_1_BIT { return false }
    p.*.formats[p.*.attachmentCount] = format
    p.*.loadOps[p.*.attachmentCount] = loadOp
    p.*.attachmentCount += 1
    return true
}

pub fn createRenderPass(handle: vk.Device, info: *const vk.RenderPassCreateInfo, callbacks: ?*const vk.AllocationCallbacks, into: *vk.RenderPass) -> vk.Result {
    into.* = 0
    if info.*.subpassCount != 1 || info.*.flags != 0 { return vk.Result.errorUnknown }
    const s = &info.*.pSubpasses.?[0]
    if s.*.inputAttachmentCount != 0 || s.*.pResolveAttachments != null || s.*.pDepthStencilAttachment != null || s.*.colorAttachmentCount > @intCast(u32, MOST_ATTACHMENTS) || s.*.flags != 0 { return vk.Result.errorUnknown }
    const address = newPass(callbacks)
    if address == 0 { return vk.Result.errorOutOfHostMemory }
    const p = passOf(address)
    var ok = true
    var k: usize = 0
    while k < @intCast(usize, info.*.attachmentCount) {
        const a = &info.*.pAttachments.?[k]
        if !attachment(p, a.*.format, a.*.samples, a.*.loadOp) { ok = false }
        k += 1
    }
    k = 0
    while k < @intCast(usize, s.*.colorAttachmentCount) {
        p.*.colours[k] = s.*.pColorAttachments.?[k].attachment
        if p.*.colours[k] != vk.ATTACHMENT_UNUSED && p.*.colours[k] >= p.*.attachmentCount { ok = false }
        k += 1
    }
    p.*.colourCount = s.*.colorAttachmentCount
    k = 0
    while k < @intCast(usize, info.*.dependencyCount) {
        const d = &info.*.pDependencies.?[k]
        if !depend(p, d.*.srcSubpass, d.*.dstSubpass, d.*.srcStageMask, d.*.dstStageMask, d.*.srcAccessMask, d.*.dstAccessMask) { ok = false }
        k += 1
    }
    if !ok {
        device.release(callbacks, address, @sizeOf(RenderPassObject))
        return vk.Result.errorUnknown
    }
    implicitDependencies(p)
    into.* = address
    return vk.Result.success
}

pub fn createRenderPass2(handle: vk.Device, info: *const vk.RenderPassCreateInfo2, callbacks: ?*const vk.AllocationCallbacks, into: *vk.RenderPass) -> vk.Result {
    into.* = 0
    if info.*.subpassCount != 1 || info.*.flags != 0 || info.*.correlatedViewMaskCount != 0 { return vk.Result.errorUnknown }
    const s = &info.*.pSubpasses.?[0]
    if s.*.inputAttachmentCount != 0 || s.*.pResolveAttachments != null || s.*.pDepthStencilAttachment != null || s.*.colorAttachmentCount > @intCast(u32, MOST_ATTACHMENTS) || s.*.flags != 0 || s.*.viewMask != 0 { return vk.Result.errorUnknown }
    const address = newPass(callbacks)
    if address == 0 { return vk.Result.errorOutOfHostMemory }
    const p = passOf(address)
    var ok = true
    var k: usize = 0
    while k < @intCast(usize, info.*.attachmentCount) {
        const a = &info.*.pAttachments.?[k]
        if !attachment(p, a.*.format, a.*.samples, a.*.loadOp) { ok = false }
        k += 1
    }
    k = 0
    while k < @intCast(usize, s.*.colorAttachmentCount) {
        p.*.colours[k] = s.*.pColorAttachments.?[k].attachment
        if p.*.colours[k] != vk.ATTACHMENT_UNUSED && p.*.colours[k] >= p.*.attachmentCount { ok = false }
        k += 1
    }
    p.*.colourCount = s.*.colorAttachmentCount
    k = 0
    while k < @intCast(usize, info.*.dependencyCount) {
        const d = &info.*.pDependencies.?[k]
        if !depend(p, d.*.srcSubpass, d.*.dstSubpass, d.*.srcStageMask, d.*.dstStageMask, d.*.srcAccessMask, d.*.dstAccessMask) { ok = false }
        k += 1
    }
    if !ok {
        device.release(callbacks, address, @sizeOf(RenderPassObject))
        return vk.Result.errorUnknown
    }
    implicitDependencies(p)
    into.* = address
    return vk.Result.success
}

pub fn destroyRenderPass(handle: vk.Device, given: vk.RenderPass, callbacks: ?*const vk.AllocationCallbacks) -> void {
    if given == 0 { return }
    device.release(callbacks, given, @sizeOf(RenderPassObject))
}

// Any area renders as fast as any other (no tiles of the card's that
// would favour one).
pub fn getRenderAreaGranularity(handle: vk.Device, given: vk.RenderPass, into: *vk.Extent2D) -> void {
    into.*.width = 1
    into.*.height = 1
}

pub fn createFramebuffer(handle: vk.Device, info: *const vk.FramebufferCreateInfo, callbacks: ?*const vk.AllocationCallbacks, into: *vk.Framebuffer) -> vk.Result {
    into.* = 0
    if info.*.flags != 0 || info.*.layers != 1 || info.*.attachmentCount > @intCast(u32, MOST_ATTACHMENTS) || info.*.renderPass == 0 || info.*.attachmentCount != passOf(info.*.renderPass).*.attachmentCount { return vk.Result.errorUnknown }
    const address = device.allocate(callbacks, @sizeOf(FramebufferObject), vk.SystemAllocationScope.object)
    if address == 0 { return vk.Result.errorOutOfHostMemory }
    const f = framebufferOf(address)
    f.*.pass = info.*.renderPass
    f.*.count = info.*.attachmentCount
    f.*.width = info.*.width
    f.*.height = info.*.height
    var k: usize = 0
    while k < @intCast(usize, info.*.attachmentCount) {
        f.*.views[k] = info.*.pAttachments.?[k]
        k += 1
    }
    into.* = address
    return vk.Result.success
}

pub fn destroyFramebuffer(handle: vk.Device, given: vk.Framebuffer, callbacks: ?*const vk.AllocationCallbacks) -> void {
    if given == 0 { return }
    device.release(callbacks, given, @sizeOf(FramebufferObject))
}
