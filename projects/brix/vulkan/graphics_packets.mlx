// The packets and registers of the graphics ring (GFX8): what our
// driver's stage (c) writes into a graphics stream and what the host card
// (card_draw.mlx) reads out of it. The study's 4.2 (the graphics
// preamble), 4.4 (a draw) and 4.5 (the vertex buffers), with packets.mlx's
// compute part beside it.
//
// Every number here is from Linux v6.6 (drivers/gpu/drm/amd/amdgpu/vid.h,
// include/asic_reg/gca/gfx_8_0_d.h, gfx_8_0_sh_mask.h and gfx_8_0_enum.h)
// and Mesa mesa-24.0.0 (src/amd/common/sid.h, src/amd/registers/gfx8.json,
// and the places of src/amd/vulkan named beside a number); none is from
// memory. tools/check_vulkan_driver.py holds each against those files.
// A REGISTER is named by its byte offset, a FIELD as REGISTER__FIELD by
// its mask (gfx8.json's bits), a value of a field's enum by its number.

// ---------------------------------------------------------------------------
// Packets (sid.h PKT3_x; vid.h PACKET3_x the same numbers)

pub const PKT3_CLEAR_STATE: u32 = 0x12
pub const PKT3_DRAW_INDEX_2: u32 = 0x27
pub const PKT3_CONTEXT_CONTROL: u32 = 0x28
pub const PKT3_INDEX_TYPE: u32 = 0x2A
pub const PKT3_DRAW_INDEX_AUTO: u32 = 0x2D
pub const PKT3_NUM_INSTANCES: u32 = 0x2F
pub const PKT3_PFP_SYNC_ME: u32 = 0x42
pub const PKT3_SURFACE_SYNC: u32 = 0x43
pub const PKT3_EVENT_WRITE_EOP: u32 = 0x47

// CONTEXT_CONTROL's two words (sid.h CC0_UPDATE_LOAD_ENABLES(1),
// CC1_UPDATE_SHADOW_ENABLES(1): bit 31 each; radv_emit_graphics).
pub const CC0_UPDATE_LOAD_ENABLES: u32 = 0x80000000
pub const CC1_UPDATE_SHADOW_ENABLES: u32 = 0x80000000

// SET_SH_REG's offset word with an index (radv_cs.h radeon_set_sh_reg_idx
// on GFX8: the index in bits 28 and up; RADV writes SPI_SHADER_PGM_RSRC3_PS
// with index 3, what it selects is not said: the study's 12.2).
pub const SH_REG_INDEX_SHIFT: u32 = 28
pub const RSRC3_INDEX: u32 = 3
// SET_UCONFIG_REG's index for VGT_PRIMITIVE_TYPE (radv_cs.h radeon_set_
// uconfig_reg_idx with 1; on GFX8 the packet is SET_UCONFIG_REG).
pub const PRIMITIVE_TYPE_INDEX: u32 = 1

// The events (gfx8.json's VGT_EVENT_TYPE) and EVENT_WRITE's index (sid.h:
// 4 for the *S_PARTIAL_FLUSH events, 5 for the TS events, 0 the others).
pub const VS_PARTIAL_FLUSH: u32 = 15
pub const PS_PARTIAL_FLUSH: u32 = 16
pub const PIPELINESTAT_START: u32 = 25
pub const FLUSH_AND_INV_CB_DATA_TS: u32 = 45
pub const FLUSH_AND_INV_DB_META: u32 = 44
pub const FLUSH_AND_INV_CB_META: u32 = 46
pub const EVENT_INDEX_TS: u32 = 5
pub const EVENT_INDEX_OTHER: u32 = 0

// SURFACE_SYNC's size word over all of memory and its poll interval
// (si_cmd_buffer.c radv_emit_acquire_mem, !is_mec: CP_COHER_CNTL,
// 0xffffffff, base 0, 0x0000000A).
pub const SURFACE_SIZE_ALL: u32 = 0xFFFFFFFF
pub const SURFACE_POLL: u32 = 0x0000000A

// CP_COHER_CNTL's colour actions (gfx8.json): CB0 .. CB7_DEST_BASE_ENA
// (bits 6 to 13), CB_ACTION_ENA.
pub const CP_COHER_CNTL__CB0_DEST_BASE_ENA: u32 = 0x40
pub const CP_COHER_CNTL__CB_DEST_BASE_ALL: u32 = 0x3FC0
pub const CP_COHER_CNTL__CB_ACTION_ENA: u32 = 0x2000000
// The depth block's actions (gfx8.json: DB_DEST_BASE_ENA, DB_ACTION_ENA):
// RADV's FLUSH_AND_INV_DB on GFX8 (a transfer or memory write's barrier
// asks it); there is no depth target at this stage.
pub const CP_COHER_CNTL__DB_DEST_BASE_ENA: u32 = 0x4000
pub const CP_COHER_CNTL__DB_ACTION_ENA: u32 = 0x4000000

// EVENT_WRITE_EOP's second word on GFX8 with nothing written (sid.h
// EOP_DST_SEL(EOP_DST_SEL_MEM) | EOP_DATA_SEL(EOP_DATA_SEL_DISCARD)) and
// its data-select field.
pub const EOP_DATA_SEL: u32 = 0xE0000000
pub const EOP_DST_SEL: u32 = 0x30000

// The draw initiator's source select (gfx8.json VGT_DRAW_INITIATOR
// SOURCE_SELECT: DI_SRC_SEL_DMA 0, DI_SRC_SEL_AUTO_INDEX 2) and NOT_EOP.
pub const DI_SRC_SEL_DMA: u32 = 0
pub const DI_SRC_SEL_AUTO_INDEX: u32 = 2
pub const VGT_DRAW_INITIATOR__SOURCE_SELECT: u32 = 0x3
pub const VGT_DRAW_INITIATOR__NOT_EOP: u32 = 0x20

// INDEX_TYPE (VGT_INDEX_TYPE's INDEX_TYPE: VGT_INDEX_16 0, VGT_INDEX_32 1).
pub const VGT_INDEX_16: u32 = 0
pub const VGT_INDEX_32: u32 = 1

