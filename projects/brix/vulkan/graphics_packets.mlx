pub const ES_VERTS_PER_SUBGRP: u32 = 64
pub const GS_PRIMS_PER_SUBGRP: u32 = 4
// The PA_SC_EDGERULE the clear state gives (Linux clearstate_vi.h:
// 0xAA99AAAA; RADV writes 0xAAAAAAAA only without a clear state, so on
// GFX8 the clear state's stands): the card's tie rule for a pixel on an
// edge, which the host card's model of the fill rule stands for (the
// rule's bits are not in the sources: the study's 11.9).
pub const EDGE_RULE: u32 = 0xAA99AAAA

// Polaris 10's raster configuration (ac_gpu_info.c ac_get_raster_config,
// CHIP_POLARIS10: 4 shader engines, 8 render back ends).
pub const RASTER_CONFIG_POLARIS10: u32 = 0x16000012
pub const RASTER_CONFIG_1_POLARIS10: u32 = 0x0000002A

// A tile mode table entry's ARRAY_MODE (gfx8.json GB_TILE_MODE0's
// ARRAY_MODE [5:2], ARRAY_LINEAR_ALIGNED 1): a linear colour target names
// the entry that has it.
pub const GB_TILE_MODE__ARRAY_MODE: u32 = 0x3C
pub const ARRAY_LINEAR_ALIGNED: u32 = 1
pub const TILE_MODES: usize = 32
