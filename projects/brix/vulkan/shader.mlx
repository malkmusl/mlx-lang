// The shader compiler of our Vulkan driver for the RX 580 (GFX8), as the
// driver will use it: a SPIR-V compute shader in, the card's words and the
// facts the driver writes into the dispatch's registers out. It runs on
// the host too, which is how it is proven (tests/497: each of std.gpu's
// kernels compiled and run in wave.mlx's interpreter against what the
// processor computes).
//
//     var facts: shader.Facts = undefined
//     var failure: shader.Failure = undefined
//     if !shader.compile(spirvWords, allocator, codeWords, &facts, &failure) { ... }
//
// The parts: shader_ir.mlx reads the module (std.spirv.module validates it
// first) into the intermediate form, lowers division and marks uniform and
// varying values; shader_code.mlx selects instructions, lays out control
// flow on the exec mask, gives registers, inserts the waits and wait
// states and assembles. What this stage takes and refuses is said at the
// head of shader_ir.mlx; a refusal names the SPIR-V opcode and the word
// where it stands.
//
// The resource words the driver writes (the study's 4.3 A) from the facts:
// COMPUTE_PGM_RSRC2 gets USER_SGPR `userSgprs`, TGID_X_EN .. TGID_Z_EN and
// TIDIG_COMP_CNT `localIdComponents` (the field positions are Mesa's
// registers/gfx8.json); COMPUTE_NUM_THREAD_X .. Z the group size; RSRC1's
// counts come from `vgprs` and `sgprs` by RADV's formula
// (radv_postprocess_binary_config), which is the next stage's to write.

const module = @import("std.spirv.module")
const ir = @import("./shader_ir.mlx")
const code = @import("./shader_code.mlx")

pub const Facts = code.Facts

// Why a shader was refused, and where.
pub const Failure = struct {
    kind: ir.Failure
    // The SPIR-V opcode and its word offset in the module (0 when the
    // failure is not one instruction's).
    opcode: u32
    offset: usize
}

pub fn failureText(kind: ir.Failure) -> []const u8 {
    if kind == ir.Failure.none { return "none" }
    if kind == ir.Failure.invalid { return "the module is not valid SPIR-V" }
    if kind == ir.Failure.notCompute { return "not one GLCompute entry point" }
    if kind == ir.Failure.tooLarge { return "too large for the compiler's tables" }
    if kind == ir.Failure.unsupported { return "an instruction this stage of the driver does not have" }
    if kind == ir.Failure.structure { return "control flow this stage does not take (a break, a switch, a loop whose condition is not at its top)" }
    if kind == ir.Failure.undefinedValue { return "a value read before it is written" }
    if kind == ir.Failure.registers { return "more registers than the card has (no spilling at this stage)" }
    if kind == ir.Failure.interface { return "a stage's inputs or outputs this stage of the driver does not take" }
    if kind == ir.Failure.loopBoolean { return "a boolean made in a loop's header is read after the loop (not at this stage)" }
    return "the program does not fit"
}

// Compiles `spirv` into `words`: true with `facts` filled, or false with
// `failure` saying why.
pub fn compile(spirv: []const u32, allocator: module.Allocator, words: []u32, facts: *Facts, failure: *Failure) -> bool {
    failure.*.kind = ir.Failure.none
    failure.*.opcode = 0
    failure.*.offset = 0
    if !ir.read(spirv, allocator) {
        failure.*.kind = ir.failure
        failure.*.opcode = ir.failureOpcode
        failure.*.offset = ir.failureOffset
        return false
    }
    if !code.generate(words, facts) {
        failure.*.kind = code.failed
        return false
    }
    return true
}
