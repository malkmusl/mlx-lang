// The card's command packets and the registers a compute stream sets
// (GFX8): what our driver writes into a stream and what the host card
// (card_run.mlx) reads out of it. The study's 4.1 to 4.3 and 7.6.
//
// Every number here is from Linux v6.6 (drivers/gpu/drm/amd/amdgpu/vid.h,
// include/asic_reg/gca/gfx_8_0_d.h and gfx_8_0_sh_mask.h) and Mesa
// mesa-24.0.0 (src/amd/common/sid.h, src/amd/registers/gfx8.json, and the
// places of src/amd/vulkan named beside a number); none is from memory.
// tools/check_vulkan_driver.py holds each against those files.
//
// A REGISTER is named by its byte offset (gfx_8_0_d.h's mm number times
// 4); a FIELD as REGISTER__FIELD by its mask (gfx_8_0_sh_mask.h's _MASK,
// gfx8.json's bits).

// ---------------------------------------------------------------------------
// Packets

// The type-3 packet's header (sid.h PKT3, vid.h PACKET3): 3 << 30, the
// count of words after the header less one << 16, the opcode << 8; bit 1
// marks a packet as compute's (sid.h PKT3_SHADER_TYPE_S), which RADV sets
// on DISPATCH_DIRECT and ACQUIRE_MEM of a compute ring alone (the study's
// 4.1); bit 0 is the predicate, which our streams never set.
pub const TYPE3: u32 = 0xC0000000
pub const COMPUTE_BIT: u32 = 0x2
pub const PREDICATE_BIT: u32 = 0x1

pub fn header(opcode: u32, count: u32, compute: bool) -> u32 {
    return TYPE3 | ((count & 0x3FFF) << 16) | ((opcode & 0xFF) << 8) | (if compute { COMPUTE_BIT } else { 0 })
}

// The header's parts.
pub fn kindOf(word: u32) -> u32 { return word >> 30 }
pub fn countOf(word: u32) -> u32 { return (word >> 16) & 0x3FFF }
pub fn opcodeOf(word: u32) -> u32 { return (word >> 8) & 0xFF }

// The one-word padding no-op (sid.h PKT3_NOP_PAD, "header-only version":
// PKT3(PKT3_NOP, 0x3fff, 0)), the only packet whose count does not count.
pub const NOP_PAD: u32 = 0xFFFF1000

// A stream's length is a multiple of 8 words (ac_gpu_info.c: the
// compute engine's ib_pad_dw_mask 7; radv_amdgpu_cs_finalize pads with
// NOP_PAD).
pub const PAD_WORDS: usize = 8

// The opcodes (sid.h PKT3_x, vid.h PACKET3_x: the same numbers).
pub const PKT3_NOP: u32 = 0x10
pub const PKT3_DISPATCH_DIRECT: u32 = 0x15
pub const PKT3_INDIRECT_BUFFER: u32 = 0x3F
pub const PKT3_EVENT_WRITE: u32 = 0x46
pub const PKT3_RELEASE_MEM: u32 = 0x49
pub const PKT3_DMA_DATA: u32 = 0x50
pub const PKT3_ACQUIRE_MEM: u32 = 0x58
pub const PKT3_SET_CONFIG_REG: u32 = 0x68
pub const PKT3_SET_CONTEXT_REG: u32 = 0x69
pub const PKT3_SET_SH_REG: u32 = 0x76
pub const PKT3_SET_UCONFIG_REG: u32 = 0x79

// The four ranges the SET_*_REG packets write, in bytes: the packet's
// first word is (offset - start) >> 2. Linux's ends (vid.h PACKET3_SET_
// x_REG_START and _END, in words), which for the context and user config
// ranges are narrower than Mesa's (sid.h SI_CONTEXT_REG_END 0x30000,
// CIK_UCONFIG_REG_END 0x40000): the narrower is taken.
pub const CONFIG_START: usize = 0x8000
pub const CONFIG_END: usize = 0xB000
pub const SH_START: usize = 0xB000
pub const SH_END: usize = 0xC000
pub const CONTEXT_START: usize = 0x28000
pub const CONTEXT_END: usize = 0x29000
pub const UCONFIG_START: usize = 0x30000
pub const UCONFIG_END: usize = 0x31000

// An event of EVENT_WRITE's one word (VGT_EVENT_INITIATOR's EVENT_TYPE;
// sid.h EVENT_INDEX at bit 8): CS_PARTIAL_FLUSH, index 4 ("*S_PARTIAL_
// FLUSH", vid.h): wait for the compute shaders that run.
pub const CS_PARTIAL_FLUSH: u32 = 7
pub const EVENT_INDEX_PARTIAL: u32 = 4
pub fn event(kind: u32, index: u32) -> u32 { return kind | (index << 8) }

// ACQUIRE_MEM on a compute ring (si_cmd_buffer.c radv_emit_acquire_mem,
// is_mec): CP_COHER_CNTL, the size 0xffffffff and its high part 0xff (the
// whole of memory), the base 0 and its high part 0, the poll interval 10.
pub const COHER_SIZE_ALL: u32 = 0xFFFFFFFF
pub const COHER_SIZE_HI_ALL: u32 = 0xFF
pub const COHER_POLL: u32 = 0x0000000A

// CP_COHER_CNTL's actions (bytes 0x301F0).
pub const CP_COHER_CNTL: usize = 0x301F0
pub const CP_COHER_CNTL__TC_WB_ACTION_ENA: u32 = 0x40000
pub const CP_COHER_CNTL__TCL1_ACTION_ENA: u32 = 0x400000
pub const CP_COHER_CNTL__TC_ACTION_ENA: u32 = 0x800000
pub const CP_COHER_CNTL__SH_KCACHE_ACTION_ENA: u32 = 0x8000000
pub const CP_COHER_CNTL__SH_ICACHE_ACTION_ENA: u32 = 0x20000000

// DMA_DATA (the processor's copy engine, CP DMA; vid.h's words): the
// control word, the source's address or the data, the source's high
// word, the destination's address, its high word, the command word.
pub const DMA_DATA__CP_SYNC: u32 = 0x80000000
// SRC_SEL [30:29]: 0 the source address in memory, 2 the data word, 3
// the source address through L2; DST_SEL [21:20]: 0 the destination in
// memory, 3 through L2.
pub const DMA_DATA__SRC_SEL: u32 = 0x60000000
pub const DMA_DATA__DST_SEL: u32 = 0x300000
pub const SRC_SEL_ADDRESS: u32 = 0
pub const SRC_SEL_DATA: u32 = 2
pub const SRC_SEL_L2: u32 = 3
pub const DST_SEL_ADDRESS: u32 = 0
pub const DST_SEL_L2: u32 = 3
// The command word: BYTE_COUNT [20:0], DIS_WC [21] (RADV's
// DISABLE_WR_CONFIRM of this generation), RAW_WAIT [30].
pub const DMA_DATA__BYTE_COUNT: u32 = 0x1FFFFF
pub const DMA_DATA__DIS_WC: u32 = 0x200000
pub const DMA_DATA__RAW_WAIT: u32 = 0x40000000
// The most bytes a packet moves: the count's field rounded down to 32
// (si_cmd_buffer.c cp_dma_max_byte_count, SI_CPDMA_ALIGNMENT 32).
pub const DMA_MOST_BYTES: usize = 2097120

// ---------------------------------------------------------------------------
// The compute registers (bytes)

pub const COMPUTE_DISPATCH_INITIATOR: usize = 0xB800
pub const COMPUTE_START_X: usize = 0xB810
pub const COMPUTE_START_Y: usize = 0xB814
pub const COMPUTE_START_Z: usize = 0xB818
pub const COMPUTE_NUM_THREAD_X: usize = 0xB81C
pub const COMPUTE_NUM_THREAD_Y: usize = 0xB820
pub const COMPUTE_NUM_THREAD_Z: usize = 0xB824
pub const COMPUTE_PIPELINESTAT_ENABLE: usize = 0xB828
pub const COMPUTE_PGM_LO: usize = 0xB830
pub const COMPUTE_PGM_HI: usize = 0xB834
pub const COMPUTE_PGM_RSRC1: usize = 0xB848
pub const COMPUTE_PGM_RSRC2: usize = 0xB84C
pub const COMPUTE_RESOURCE_LIMITS: usize = 0xB854
pub const COMPUTE_STATIC_THREAD_MGMT_SE0: usize = 0xB858
pub const COMPUTE_STATIC_THREAD_MGMT_SE1: usize = 0xB85C
pub const COMPUTE_TMPRING_SIZE: usize = 0xB860
pub const COMPUTE_STATIC_THREAD_MGMT_SE2: usize = 0xB864
pub const COMPUTE_STATIC_THREAD_MGMT_SE3: usize = 0xB868
pub const COMPUTE_USER_DATA_0: usize = 0xB900

// COMPUTE_DISPATCH_INITIATOR: the shader on, its first group at 0, 0, 0,
// waves started in any order (radv_device.c: 0x45 for a dispatch without
// offsets).
pub const COMPUTE_DISPATCH_INITIATOR__COMPUTE_SHADER_EN: u32 = 0x1
pub const COMPUTE_DISPATCH_INITIATOR__FORCE_START_AT_000: u32 = 0x4
pub const COMPUTE_DISPATCH_INITIATOR__ORDER_MODE: u32 = 0x40

pub const COMPUTE_NUM_THREAD_X__NUM_THREAD_FULL: u32 = 0xFFFF
pub const COMPUTE_NUM_THREAD_X__NUM_THREAD_PARTIAL: u32 = 0xFFFF0000
pub const COMPUTE_PGM_HI__DATA: u32 = 0xFF
pub const COMPUTE_PIPELINESTAT_ENABLE__PIPELINESTAT_ENABLE: u32 = 0x1

pub const COMPUTE_PGM_RSRC1__VGPRS: u32 = 0x3F
pub const COMPUTE_PGM_RSRC1__SGPRS: u32 = 0x3C0
pub const COMPUTE_PGM_RSRC1__PRIORITY: u32 = 0xC00
pub const COMPUTE_PGM_RSRC1__FLOAT_MODE: u32 = 0xFF000
pub const COMPUTE_PGM_RSRC1__PRIV: u32 = 0x100000
pub const COMPUTE_PGM_RSRC1__DX10_CLAMP: u32 = 0x200000
pub const COMPUTE_PGM_RSRC1__DEBUG_MODE: u32 = 0x400000
pub const COMPUTE_PGM_RSRC1__IEEE_MODE: u32 = 0x800000
pub const COMPUTE_PGM_RSRC1__BULKY: u32 = 0x1000000
pub const COMPUTE_PGM_RSRC1__CDBG_USER: u32 = 0x2000000
// The scalar registers RSRC1's SGPRS counts beyond those a shader
// addresses: VCC's two (aco_live_var_analysis.cpp get_extra_sgprs on GFX8
// without XNACK; get_sgpr_alloc adds them, get_addr_sgpr_from_waves takes
// them off again).
pub const VCC_SGPRS: u32 = 2
// FLOAT_MODE: 16- and 64-bit denormals kept, 32-bit ones flushed, round
// to nearest (gfx8.json FLOAT_MODE's FP_16_64_DENORMS): what the
// interpreter does (wave.mlx flushes 32-bit denormals) and the division's
// v_rcp_f32 assumes.
pub const FP_16_64_DENORMS: u32 = 192

pub const COMPUTE_PGM_RSRC2__SCRATCH_EN: u32 = 0x1
pub const COMPUTE_PGM_RSRC2__USER_SGPR: u32 = 0x3E
pub const COMPUTE_PGM_RSRC2__TRAP_PRESENT: u32 = 0x40
pub const COMPUTE_PGM_RSRC2__TGID_X_EN: u32 = 0x80
pub const COMPUTE_PGM_RSRC2__TGID_Y_EN: u32 = 0x100
pub const COMPUTE_PGM_RSRC2__TGID_Z_EN: u32 = 0x200
pub const COMPUTE_PGM_RSRC2__TG_SIZE_EN: u32 = 0x400
pub const COMPUTE_PGM_RSRC2__TIDIG_COMP_CNT: u32 = 0x1800
pub const COMPUTE_PGM_RSRC2__EXCP_EN_MSB: u32 = 0x6000
pub const COMPUTE_PGM_RSRC2__LDS_SIZE: u32 = 0xFF8000
pub const COMPUTE_PGM_RSRC2__EXCP_EN: u32 = 0x7F000000

pub const COMPUTE_RESOURCE_LIMITS__WAVES_PER_SH: u32 = 0x3FF
pub const COMPUTE_RESOURCE_LIMITS__TG_PER_CU: u32 = 0xF000
pub const COMPUTE_RESOURCE_LIMITS__LOCK_THRESHOLD: u32 = 0x3F0000
pub const COMPUTE_RESOURCE_LIMITS__SIMD_DEST_CNTL: u32 = 0x400000
pub const COMPUTE_RESOURCE_LIMITS__FORCE_SIMD_DIST: u32 = 0x800000
pub const COMPUTE_RESOURCE_LIMITS__CU_GROUP_COUNT: u32 = 0x7000000

pub const COMPUTE_STATIC_THREAD_MGMT_SE0__SH0_CU_EN: u32 = 0xFFFF
pub const COMPUTE_STATIC_THREAD_MGMT_SE0__SH1_CU_EN: u32 = 0xFFFF0000

// A buffer's descriptor (the study's 4.5; radv_descriptor_set.c
// write_buffer_descriptor): its address low, BASE_ADDRESS_HI, the range
// rounded up to 4, and word 3 with the selects X, Y, Z, W, the number
// format FLOAT and the data format 32 (SQ_BUF_RSRC_WORD3's fields,
// gfx8.json's SQ_SEL_X 4 .. SQ_SEL_W 7, BUF_NUM_FORMAT_FLOAT 7,
// BUF_DATA_FORMAT_32 4).
pub const SQ_BUF_RSRC_WORD1__BASE_ADDRESS_HI: u32 = 0xFFFF
// (gfx8.json SQ_BUF_RSRC_WORD1's STRIDE [29:16]: a vertex buffer's)
pub const SQ_BUF_RSRC_WORD1__STRIDE: u32 = 0x3FFF0000
pub const SQ_BUF_RSRC_WORD3__DST_SEL_X: u32 = 0x7
pub const SQ_BUF_RSRC_WORD3__DST_SEL_Y: u32 = 0x38
pub const SQ_BUF_RSRC_WORD3__DST_SEL_Z: u32 = 0x1C0
pub const SQ_BUF_RSRC_WORD3__DST_SEL_W: u32 = 0xE00
pub const SQ_BUF_RSRC_WORD3__NUM_FORMAT: u32 = 0x7000
pub const SQ_BUF_RSRC_WORD3__DATA_FORMAT: u32 = 0x78000
pub const SQ_SEL_X: u32 = 4
pub const SQ_SEL_Y: u32 = 5
pub const SQ_SEL_Z: u32 = 6
pub const SQ_SEL_W: u32 = 7
pub const BUF_NUM_FORMAT_FLOAT: u32 = 7
pub const BUF_DATA_FORMAT_32: u32 = 4
pub const DESCRIPTOR_BYTES: usize = 16

// `value` put into the field `mask` names, and read out of it.
pub fn put(mask: u32, value: u32) -> u32 {
    var shift: u32 = 0
    while shift < 32 && ((mask >> @intCast(u5, shift)) & 1) == 0 { shift += 1 }
    if shift == 32 { return 0 }
    return (value << @intCast(u5, shift)) & mask
}

pub fn get(word: u32, mask: u32) -> u32 {
    var shift: u32 = 0
    while shift < 32 && ((mask >> @intCast(u5, shift)) & 1) == 0 { shift += 1 }
    if shift == 32 { return 0 }
    return (word & mask) >> @intCast(u5, shift)
}

// The descriptor's word 3.
// A vertex buffer's word 3 (radv_write_vertex_descriptors before GFX10:
// DST_SEL X, Y, Z, W, NUM_FORMAT UINT (gfx8.json BUF_NUM_FORMAT_UINT 4),
// DATA_FORMAT 32).
pub const BUF_NUM_FORMAT_UINT: u32 = 4

pub fn vertexWord3() -> u32 { return put(SQ_BUF_RSRC_WORD3__DST_SEL_X, SQ_SEL_X) | put(SQ_BUF_RSRC_WORD3__DST_SEL_Y, SQ_SEL_Y) | put(SQ_BUF_RSRC_WORD3__DST_SEL_Z, SQ_SEL_Z) | put(SQ_BUF_RSRC_WORD3__DST_SEL_W, SQ_SEL_W) | put(SQ_BUF_RSRC_WORD3__NUM_FORMAT, BUF_NUM_FORMAT_UINT) | put(SQ_BUF_RSRC_WORD3__DATA_FORMAT, BUF_DATA_FORMAT_32) }

pub fn bufferWord3() -> u32 {
    return put(SQ_BUF_RSRC_WORD3__DST_SEL_X, SQ_SEL_X) | put(SQ_BUF_RSRC_WORD3__DST_SEL_Y, SQ_SEL_Y) | put(SQ_BUF_RSRC_WORD3__DST_SEL_Z, SQ_SEL_Z) | put(SQ_BUF_RSRC_WORD3__DST_SEL_W, SQ_SEL_W) | put(SQ_BUF_RSRC_WORD3__NUM_FORMAT, BUF_NUM_FORMAT_FLOAT) | put(SQ_BUF_RSRC_WORD3__DATA_FORMAT, BUF_DATA_FORMAT_32)
}

// COMPUTE_RESOURCE_LIMITS for a work group of `waves` waves on a card of
// `computeUnits` compute units in `shaderEngines` shader engines
// (ac_gpu_info.c ac_get_compute_resource_limits, GFX7 and later, no
// limit of waves, one group a compute unit): SIMD_DEST_CNTL when the
// waves are a multiple of 4, FORCE_SIMD_DIST when the compute units of an
// engine are not a multiple of 4 and the group is one wave. Both counts
// are the card's record's (the study's silent need 4): 0 when it says
// none.
pub fn resourceLimits(waves: u32, computeUnits: u32, shaderEngines: u32) -> u32 {
    var limits: u32 = if waves % 4 == 0 { COMPUTE_RESOURCE_LIMITS__SIMD_DEST_CNTL } else { 0 }
    if shaderEngines != 0 {
        const perEngine = computeUnits / shaderEngines
        if perEngine % 4 != 0 && waves == 1 { limits |= COMPUTE_RESOURCE_LIMITS__FORCE_SIMD_DIST }
    }
    return limits
}
