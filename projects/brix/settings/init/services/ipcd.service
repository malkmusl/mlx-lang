# The system bus: MLXIPC's mlx-ipcd (projects/desktop/ipc) on the
# listener node /temporary/bus. DBUS_SYSTEM_BUS_ADDRESS=unix:path=/temporary/bus
# names it to the login and the greeter; mlx-login owns org.mlx.Login on it.
description = the system bus (mlx-ipcd)
exec = mlx-ipcd --verbose --system --address /temporary/bus
restart = on-failure
