# The system bus: MLXIPC's synapse (projects/desktop/ipc) on the
# listener node /temporary/bus. DBUS_SYSTEM_BUS_ADDRESS=unix:path=/temporary/bus
# names it to the login and the greeter; sentinel owns org.mlx.Login on it.
description = the system bus (synapse)
exec = synapse --verbose --system --address /temporary/bus
restart = on-failure
