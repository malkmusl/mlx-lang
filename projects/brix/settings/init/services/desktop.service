# The desktop on the screen: kepler (projects/desktop/compositor,
# its brixOS backend: /devices/framebuffer, /devices/keyboard,
# /devices/mouse) with its Wayland listener at /temporary/wayland-mlx;
# Alt+Enter opens vector (flux on a session pair). It takes the
# screen from the boot splash (screen = yes). Without a display it ends at
# once and is not started again. mlx-console is the alternative
# (console.service, disabled). Disabled: the login (login.service) has
# the screen and starts this desktop as the person who logged in; enable
# this one (and disable the login) for the desktop as root without a
# login, or console.service for the plain virtual console.
description = kepler on the screen
exec = kepler
disabled = yes
screen = yes
restart = on-failure
after = serial-shell
env = XDG_RUNTIME_DIR=/temporary
# The desktop entries the launcher and the dock offer (/system/share/applications).
env = XDG_DATA_DIRS=/system/share
