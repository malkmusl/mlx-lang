# A oneshot run at boot: copy the kernel log (/devices/klog) to boot.log on
# every mounted brixfs volume, so the hardware bring-up messages survive
# the boot and are reachable from the host (with the brixfs reader/driver)
# without a terminal. Read-only volumes are skipped.
description = save the kernel log to the brixfs volumes
exec = klogsave
type = oneshot
restart = no
