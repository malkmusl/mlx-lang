# The virtual console on the screen (/devices/framebuffer and
# /devices/keyboard): mlx-sh on a session pair. It takes the screen from
# the boot splash (screen = yes: the splash is told to quit first, leaving
# its picture until the console draws). Without a display it ends at once
# and is not started again.
description = mlx-console on the screen
exec = mlx-console
screen = yes
restart = on-failure
after = serial-shell
