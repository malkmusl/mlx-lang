# The login (projects/desktop/login, mlx-login): it starts the greeter
# (mlx-compositor --greeter mlx-greeter, dropped to uid 65534) on the
# screen after the boot splash (screen = yes), logs a person in by the
# accounts of /system/settings (users, shadow, groups: the account brix
# with the password brix, root's the same; change them), then starts
# the session of /system/share/wayland-sessions (the desktop) as that
# person in /users/NAME (made at the first login), and the greeter again
# when the session ends. No VT on brixOS (--tty none); the runtime
# directories are /temporary/users/UID.
description = mlx-login: the greeter, then the person's session
exec = mlx-login --verbose --tty none --greeter /system/programs/mlx-compositor /system/programs/mlx-greeter --passwd /system/settings/users --shadow /system/settings/shadow --group /system/settings/groups --runtime-dir /temporary/users
screen = yes
restart = on-failure
after = ipcd
env = DBUS_SYSTEM_BUS_ADDRESS=unix:path=/temporary/bus
env = XDG_DATA_DIRS=/system/share
