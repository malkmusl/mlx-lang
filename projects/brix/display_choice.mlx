// What the GPU's driver does with the display at a boot: a choice made in
// the one image, at boot, and not by building another image. It says how
// far the driver goes, and nothing else: which output the monitor is on
// and what kind of signal it takes is never chosen, the driver reads
// that at every boot.
//
// This is the pure part of it, shared by the three that go by it:
// brix-image writes the EFI loader's keys, its lines and the variable's
// name out of this file (image/efi.mlx's choice part), the kernel's
// driver works the choice out with it (kernel/gpu.mlx), and
// tests/482_display_choice_runtime.mlx holds every combination on the
// host, and runs the loader's part there too.
//
// THE CHOICE:
// - native: the monitor's own mode is set by the driver where its plan
//   is complete; where it is not, a line says why and the firmware's
//   picture stays. What the image does by itself.
// - firmware: the firmware's picture is kept: no register of the display
//   is written and no table of the card's is run.
// - rehearsal: the firmware's own mode set again: through the card's
//   tables where the output is one whose mode set runs them (HDMI,
//   DVI); on a DisplayPort output the firmware's own link taken down
//   and trained again at its own rate and lanes. The first thing to try
//   on a card.
// - ask: the monitor only asked, nothing set: on a DisplayPort output
//   what the monitor says of itself over its AUX channel is read and
//   said in the log (the step before a link is trained). The firmware's
//   picture is kept; nothing of the card is written but the AUX
//   channel's own words, which a transaction needs. On another output
//   there is nothing to ask and it is as `firmware`.
//
// WHERE IT COMES FROM, the first of these that names one:
// (a) a key at this start, read by the EFI loader from the firmware's
//     keyboard: F firmware, N native, R rehearsal, A ask, either case;
// (b) what a key at an earlier start left in the machine: F and N are
//     remembered (a UEFI variable, NAME under GUID, one byte: the key's
//     letter; written only when it changes), R and A hold for their one
//     boot and leave what is remembered alone;
// (c) the image's file settings/gpu, whose first word is one of the four
//     names (for an image built with a fixed choice; the build's own has
//     no such file);
// (d) native.
// The loader decides nothing: it hands the kernel what it found, in one
// word of the boot information (layout.Info.CHOICE: `Word` below), and
// the kernel works the choice out here (`decide`). A loader from before
// this leaves the word 0, and under Multiboot there is no loader of ours:
// then (c) and (d).

pub const Choice = enum(u8) {
    // (Not one: what a key, a remembered byte or a word that names none
    // gives.)
    none,
    native,
    firmware,
    rehearsal,
    ask
}

pub const Source = enum(u8) {
    // Nothing named one: (d).
    by_default,
    // A key at this start.
    key,
    // A key at an earlier start, remembered in the machine.
    remembered,
    // The image's settings/gpu.
    image
}

// The keys, by their letters (upper case).
pub const KEYS = "FNRA"

// The variable F and N are remembered in: its name (the loader writes it
// as 16-bit characters), the GUID it is under (ours:
// 4e1050e5-03af-4698-8f99-584a105df8f3, as its bytes lie in memory) and
// its attributes (non-volatile, for the boot services and at run time,
// so that an operating system or the firmware's shell can look at it).
pub const NAME = "BrixDisplay"
pub const GUID = [_]u8{ 0xe5, 0x50, 0x10, 0x4e, 0xaf, 0x03, 0x98, 0x46, 0x8f, 0x99, 0x58, 0x4a, 0x10, 0x5d, 0xf8, 0xf3 }
pub const ATTRIBUTES: usize = 7

// How the loader looks for a key: every key the firmware has kept is
// read first (the last of ours counts); when none of ours was among
// them it looks again every SLICE milliseconds for WAIT milliseconds at
// most, which is what a boot without a key takes longer by. READS: how
// many keys it reads at most (a firmware that never runs out of them
// must not keep it).
pub const WAIT: usize = 300
pub const SLICE: usize = 10
pub const READS: usize = 256

// The word the loader hands over.
pub const Word = struct {
    // The key taken at this start: its letter (0: none).
    pub const KEY: usize = 0xFF
    // What the machine remembered when the loader came, before it wrote
    // anything: the variable's first byte, and how many bytes it has
    // (MANY: that or more; 0: there is no variable).
    pub const BYTE_SHIFT: usize = 8
    pub const SIZE_SHIFT: usize = 16
    pub const MANY: usize = 255
    // A loader that knows of the choice ran: the word is never 0 from
    // one, and means nothing without this.
    pub const LOOKED: usize = 0x01000000
    // The firmware has no console input, or none that reads a key.
    pub const NO_KEYBOARD: usize = 0x02000000
    // Reading a key gave an error (not "no key").
    pub const KEYBOARD_FAILED: usize = 0x04000000
    // The firmware has no run-time services, or none that read and write
    // a variable.
    pub const NO_STORE: usize = 0x08000000
    // Reading the variable gave an error (not "there is none").
    pub const READ_FAILED: usize = 0x10000000
    // The loader wrote the variable at this start and the firmware took
    // it; or the firmware refused.
    pub const WROTE: usize = 0x20000000
    pub const REFUSED: usize = 0x40000000
    // How long the loader looked for a key: the processor's counter's
    // ticks, 2^TICKS_UNIT of them a count, TICKS_MOST counts at most.
    pub const TICKS_SHIFT: usize = 32
    pub const TICKS_UNIT: usize = 16
    pub const TICKS_MOST: usize = 0xFFFFFF
    // The firmware's status of what failed last (the variable's, else
    // the keyboard's): its lowest byte.
    pub const STATUS_SHIFT: usize = 56

    // The word put together, as the loader does it.
    pub fn of(key: u8, size: usize, byte: u8, flags: usize, ticks: usize, status: usize) -> usize {
        const count = ticks >> @intCast(u6, TICKS_UNIT)
        return @intCast(usize, key) | (@intCast(usize, byte) << @intCast(u6, BYTE_SHIFT)) | ((if size > MANY { MANY } else { size }) << @intCast(u6, SIZE_SHIFT)) | LOOKED | flags | ((if count > TICKS_MOST { TICKS_MOST } else { count }) << @intCast(u6, TICKS_SHIFT)) | ((status & 0xFF) << @intCast(u6, STATUS_SHIFT))
    }
}

// The key a character of the firmware's keyboard is: its letter, upper
// case; 0 when it is none of ours.
pub fn keyOf(character: usize) -> u8 {
    var k: usize = 0
    while k < KEYS.length {
        const letter = @intCast(usize, KEYS[k])
        if character == letter || character == letter + 32 { return KEYS[k] }
        k += 1
    }
    return 0
}

// The choice a key gives.
pub fn ofKey(key: u8) -> Choice {
    if key == 'F' { return Choice.firmware }
    if key == 'N' { return Choice.native }
    if key == 'R' { return Choice.rehearsal }
    if key == 'A' { return Choice.ask }
    return Choice.none
}

// The byte a key is remembered by (0: it holds for its one boot and
// nothing is remembered).
pub fn kept(key: u8) -> u8 {
    if key == 'F' || key == 'N' { return key }
    return 0
}

// The choice the machine remembers: the variable has `size` bytes, the
// first is `byte`. One byte that is a remembered key's letter; anything
// else is none (no variable, or something this version did not write).
pub fn ofKept(size: usize, byte: u8) -> Choice {
    if size != 1 || kept(byte) != byte { return Choice.none }
    return ofKey(byte)
}

// What the loader writes into the variable after the key `key`, the
// variable being `size` bytes with the first `byte`: the key's byte when
// it is one that is remembered and the variable is not just that
// already; 0: nothing is written.
pub fn toWrite(key: u8, size: usize, byte: u8) -> u8 {
    const wanted = kept(key)
    if wanted == 0 { return 0 }
    if size == 1 && byte == wanted { return 0 }
    return wanted
}

fn begins(text: []const u8, word: []const u8) -> bool {
    if text.length < word.length { return false }
    var k: usize = 0
    while k < word.length {
        if text[k] != word[k] { return false }
        k += 1
    }
    if text.length == word.length { return true }
    const after = text[word.length]
    return after == 10 || after == 13 || after == 32 || after == 9
}

// The choice the image's settings/gpu names: its first word (the word,
// then the file's or a line's end or a blank), one of the four names;
// anything else, "native-off" too, names none.
pub fn ofText(text: []const u8) -> Choice {
    if begins(text, "native") { return Choice.native }
    if begins(text, "firmware") { return Choice.firmware }
    if begins(text, "rehearsal") { return Choice.rehearsal }
    if begins(text, "ask") { return Choice.ask }
    return Choice.none
}

// Whether the driver may write the display's registers and run the
// card's tables at a boot of this choice.
pub fn writes(choice: Choice) -> bool { return choice == Choice.native || choice == Choice.rehearsal }

// Whether the driver may talk to a DisplayPort monitor over its AUX
// channel at a boot of this choice (which writes the channel's own
// registers): every choice but the one that keeps the firmware's
// picture untouched.
pub fn asks(choice: Choice) -> bool { return choice == Choice.native || choice == Choice.rehearsal || choice == Choice.ask }

// What became of remembering the key of this start.
pub const Kept = enum(u8) {
    // There was nothing to remember (no key, or R or A).
    nothing,
    // The machine held it already: nothing was written.
    held,
    // Written at this start.
    written,
    // The firmware did not take it.
    refused,
    // The firmware gave the loader no variable store.
    no_store
}

// The choice of a boot and what the log says of it.
pub const Decision = struct {
    choice: Choice
    source: Source
    // The key of this start (0: none) and what became of remembering it.
    key: u8
    kept: Kept
    // A loader of ours looked (the rest is false and 0 without one).
    looked: bool
    // It had a keyboard to read, and whether reading it failed.
    keyboard: bool
    keyboardFailed: bool
    // It had a variable store, and whether reading it failed.
    store: bool
    readFailed: bool
    // The machine remembers something that is no choice: how many bytes
    // and the first.
    garbage: bool
    size: usize
    byte: u8
    // The image's settings/gpu says something that names none.
    imageUnknown: bool
    // The firmware's status of what failed last, and how long the loader
    // looked for a key (the processor's counter's ticks).
    status: usize
    ticks: usize
}

// The choice from the loader's word and the image's settings/gpu (its
// bytes; none: no such file).
pub fn decide(word: usize, image: []const u8) -> Decision {
    var d = Decision.{ .choice = Choice.native, .source = Source.by_default, .key = 0, .kept = Kept.nothing, .looked = word & Word.LOOKED != 0, .keyboard = false, .keyboardFailed = false, .store = false, .readFailed = false, .garbage = false, .size = 0, .byte = 0, .imageUnknown = false, .status = 0, .ticks = 0 }
    var remembered = Choice.none
    if d.looked {
        d.keyboard = word & Word.NO_KEYBOARD == 0
        d.keyboardFailed = word & Word.KEYBOARD_FAILED != 0
        d.store = word & Word.NO_STORE == 0
        d.readFailed = word & Word.READ_FAILED != 0
        d.status = word >> @intCast(u6, Word.STATUS_SHIFT)
        d.ticks = ((word >> @intCast(u6, Word.TICKS_SHIFT)) & Word.TICKS_MOST) << @intCast(u6, Word.TICKS_UNIT)
        // (Only a letter of ours, as the loader writes it, is a key.)
        const taken = @intCast(u8, word & Word.KEY)
        if d.keyboard && keyOf(@intCast(usize, taken)) == taken { d.key = taken }
        if d.store {
            d.size = (word >> @intCast(u6, Word.SIZE_SHIFT)) & 0xFF
            d.byte = @intCast(u8, (word >> @intCast(u6, Word.BYTE_SHIFT)) & 0xFF)
            remembered = ofKept(d.size, d.byte)
            d.garbage = d.size != 0 && remembered == Choice.none
        }
    }
    const named = ofText(image)
    d.imageUnknown = image.length != 0 && named == Choice.none
    if d.key != 0 {
        d.choice = ofKey(d.key)
        d.source = Source.key
        if kept(d.key) != 0 {
            if !d.store {
                d.kept = Kept.no_store
            } else if word & Word.REFUSED != 0 {
                d.kept = Kept.refused
            } else if word & Word.WROTE != 0 {
                d.kept = Kept.written
            } else if toWrite(d.key, d.size, d.byte) == 0 {
                d.kept = Kept.held
            } else {
                // (It was to be written and the loader does not say that
                // it was: not known to be remembered.)
                d.kept = Kept.refused
            }
        }
    } else if remembered != Choice.none {
        d.choice = remembered
        d.source = Source.remembered
    } else if named != Choice.none {
        d.choice = named
        d.source = Source.image
    }
    return d
}

fn decimal(write: fn([]const u8) -> void, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    write(digits[at..20])
}

fn letter(write: fn([]const u8) -> void, key: u8) -> void {
    const one = [_]u8{ key }
    write(one[0..1])
}

// What a firmware's status means, where it is one a keyboard or a
// variable store gives ("": another).
fn statusName(status: usize) -> []const u8 {
    if status == 2 { return "invalid parameter" }
    if status == 3 { return "unsupported" }
    if status == 7 { return "device error" }
    if status == 8 { return "write protected" }
    if status == 9 { return "out of resources" }
    if status == 15 { return "access denied" }
    if status == 26 { return "security violation" }
    return ""
}

fn sayStatus(write: fn([]const u8) -> void, status: usize) -> void {
    write(" (status ")
    decimal(write, status)
    if statusName(status).length != 0 {
        write(": ")
        write(statusName(status))
    }
    write(")")
}

// What the choice is, in the log's words.
pub fn what(choice: Choice) -> []const u8 {
    if choice == Choice.firmware { return "the firmware's picture is kept" }
    if choice == Choice.rehearsal { return "the firmware's own mode set again by the card's tables" }
    if choice == Choice.ask { return "the monitor only asked, nothing set: the firmware's picture is kept" }
    return "the monitor's own mode"
}

// The choice said in the log: one line with what this boot does, why,
// and the key that changes it ("gpu: this boot: the monitor's own mode
// (the default; F while the machine starts keeps the firmware's
// picture)"); `card`: there is a card of ours for it to count on. Then a
// line for each thing that is not as it should be: something remembered
// that is no choice, a word in the image that names none, a firmware
// without a keyboard or a variable store for the loader, or one that
// refused.
pub fn say(write: fn([]const u8) -> void, d: *const Decision, card: bool) -> void {
    write(if card { "gpu: this boot: " } else { "gpu: no card of ours to set a mode on; this boot: " })
    write(what(d.*.choice))
    write(" (")
    if d.*.source == Source.key {
        letter(write, d.*.key)
        write(" was pressed at this start")
        if d.*.kept == Kept.held || d.*.kept == Kept.written {
            write(" and is remembered")
        } else if d.*.kept == Kept.nothing {
            write(" and holds for this boot only")
        } else {
            write("; the machine does not remember it, so it holds for this boot only")
        }
    } else if d.*.source == Source.remembered {
        letter(write, d.*.byte)
        write(" was pressed at an earlier start and is remembered")
    } else if d.*.source == Source.image {
        write("the image's settings/gpu says so")
    } else {
        write("the default")
    }
    // (The key that changes it, where a loader of ours reads keys.)
    if d.*.looked && d.*.keyboard {
        if d.*.choice == Choice.native {
            write("; F while the machine starts keeps the firmware's picture")
        } else if d.*.choice == Choice.firmware {
            write(if d.*.source == Source.image { "; N while the machine starts sets the monitor's own mode" } else { "; N sets the monitor's own mode again" })
        }
    }
    write(")\n")
    if !d.*.looked { return }
    if d.*.garbage {
        write("gpu: what the machine remembers is no choice of ours (")
        decimal(write, d.*.size)
        if d.*.size == 1 {
            // (Of more bytes than one the loader does not have the first.)
            const hex = "0123456789abcdef"
            const first = @intCast(usize, d.*.byte)
            write(" byte, 0x")
            write(hex[first >> 4..(first >> 4) + 1])
            write(hex[first & 15..(first & 15) + 1])
        } else {
            write(if d.*.size == Word.MANY { " bytes or more" } else { " bytes" })
        }
        write("): it is passed over; F or N while the machine starts writes it anew\n")
    }
    if d.*.imageUnknown { write("gpu: the image's settings/gpu names none of native, firmware, rehearsal and ask: it is passed over\n") }
    if !d.*.keyboard {
        write("gpu: the firmware gave the loader no keyboard to read: a key while the machine starts is not seen on this machine\n")
    } else if d.*.keyboardFailed {
        write("gpu: the firmware's keyboard answered the loader with an error")
        // (The status is the variable's when that failed too.)
        if !d.*.readFailed && d.*.kept != Kept.refused { sayStatus(write, d.*.status) }
        write(": a key while the machine starts may not be seen\n")
    }
    if !d.*.store {
        write("gpu: the firmware gave the loader no variable store: F and N hold for one boot only on this machine\n")
        return
    }
    if d.*.kept == Kept.refused {
        write("gpu: the firmware's variable store did not take ")
        letter(write, d.*.key)
        write(" to remember")
        sayStatus(write, d.*.status)
        write("\n")
    } else if d.*.readFailed {
        write("gpu: the firmware's variable store did not give the loader what is remembered")
        sayStatus(write, d.*.status)
        write(": this boot goes on without it\n")
    }
}

// How long the loader looked for a key (`milliseconds`: d.ticks by the
// kernel's clock) and whether it wrote the key down, for the log alone;
// nothing where no loader of ours read keys.
pub fn sayWait(write: fn([]const u8) -> void, d: *const Decision, milliseconds: usize) -> void {
    if !d.*.looked || !d.*.keyboard { return }
    write("gpu: the loader looked for a key for ")
    decimal(write, milliseconds)
    write(" ms")
    if d.*.key != 0 {
        write(" and took ")
        letter(write, d.*.key)
        if d.*.kept == Kept.written { write(" (written into the machine now)") }
        if d.*.kept == Kept.held { write(" (the machine held it already: nothing was written)") }
        write("\n")
    } else {
        write(" and saw none of F, N, R and A\n")
    }
}

// What the loader says on the firmware's console when it took the key
// `key` (nothing without a key): what the key gave, and whether the
// machine remembers it (`remembered`: it held it or took it; a key that
// is not remembered says the same either way).
pub fn loaderLine(key: u8, remembered: bool) -> []const u8 {
    if key == 'F' { return if remembered { "brixOS: display: the firmware's picture is kept (F), remembered" } else { "brixOS: display: the firmware's picture is kept (F), for this start only: the firmware does not remember it" } }
    if key == 'N' { return if remembered { "brixOS: display: the monitor's own mode (N), remembered" } else { "brixOS: display: the monitor's own mode (N), for this start only: the firmware does not remember it" } }
    if key == 'R' { return "brixOS: display: the firmware's own mode set again by the card's tables (R), for this start only" }
    if key == 'A' { return "brixOS: display: the monitor only asked (A), for this start only" }
    return ""
}
