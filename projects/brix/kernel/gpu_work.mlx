// The programs' work on a Radeon (a Polaris 10, the RX 580): what the
// native calls 80 to 85 on a context of the card do (spec/04-stdlib/os/
// brix.xml, <GpuDevices>; native/gpucalls.mlx turns handles into the
// numbers used here, and the host's tests call this file as the kernel
// does: tests/517 and 518). Built on the address spaces' interface
// (gpu_space.mlx) and the ring's (gpu_ring.mlx), on compute ring 0 as
// stage 5 left it, at a boot whose stage 7 passed (V1): the Vulkan
// driver's study 3.5 and 3.6 (/tmp/brix-next/gpu-vulkan-driver.verified.md)
// and the kernel's study 2, 4, 5.8 to 5.11 and 9 (gpu-accel-kernel.
// verified.md), from Linux 6.6's amdgpu_gem.c, amdgpu_vm.c, amdgpu_cs.c,
// amdgpu_ib.c, amdgpu_job.c, amdgpu_fence.c and gfx_v8_0.c.
//
// MEMORY (gpu_memory, gpu_memory_of). Two kinds of buffer:
// - the card's memory: whole pages from the part of it the processor does
//   not reach (beyond the aperture's 256 MiB: the display's picture and
//   the kernel's own part, the GART's table and the address spaces'
//   tables, are inside the aperture; the study's 2.5), handed out first
//   fit, a buffer of 2 MiB or more on a 2 MiB boundary (Linux's fragment,
//   the study's 3.3). The processor never maps it: there is no way to it
//   but the card. It is cleared by the card (DMA_DATA fills on compute
//   ring 0, in the kernel's address space, before any later work of
//   anybody's on the ring) whether ZEROED is asked or not: a program never
//   sees another's bytes.
// - the system's memory: frames, zeroed, held for the card while the
//   buffer lives, mapped snooped for the card (Linux's 0x67/0x77 for
//   cached pages) and mapped for the processor by memory_map_object
//   (the frames shared, so a mapping outlives the buffer as the spec
//   says). gpu_memory_of holds a process's own pages the same way (pages
//   it may write: native/gpucalls.mlx's pin makes a page shared
//   copy-on-write its own first and refuses one it may only read).
// So the memory types the processor maps are the system's; the card's
// memory is the device-local type alone (the record says how much of each
// a program may have: gpu_record.mlx).
// Each buffer counts to the process that made it, against a limit per
// process and one in all. It is freed when the last handle and the last
// mapping are gone and the ring has passed every submission that could
// still touch it (the newest fence of a context that had it mapped when
// the mapping went); memory a hung ring may still touch is never freed.
//
// MAPPING (gpu_map, gpu_unmap): a buffer at the card address the driver
// chose in the context's own address space (its space of the card's 1
// to 7, taken when the context is made), page for page with the rights
// asked, checked: whole pages, the range of the buffer, at or above 2 MiB
// (the bottom 2 MiB are the kernel's, Linux's AMDGPU_VA_RESERVED_SIZE)
// and below the space's 64 GiB, not over another mapping of the context.
// A mapping is valid for every later submit of the context until it is
// unmapped; every submit flushes the space in front of its streams.
//
// SUBMIT (gpu_submit): streams of the compute engine only (the copy queue
// is DMA_DATA on the compute ring, as the driver's stage b uses it); each
// must lie in one mapping of the context that allows execute, in the
// system's memory (the kernel reads it). THE KERNEL LOOKS INTO A STREAM
// (the Vulkan study's 3.6, decision 5): its words are copied, packet by
// packet, into the context's copy area (the kernel's own pages, mapped
// read and execute in the bottom 2 MiB of the context's space, where the
// program cannot write them), and every packet is checked once it is
// copied, on the copy (each word of the program's read once: what was
// judged is what runs):
// only the packets the driver's compute streams have, each kept to memory
// and its register range (NOP; SET_SH_REG within the shader registers,
// never COMPUTE_VMID, the one among them that names an address space;
// EVENT_WRITE; ACQUIRE_MEM; DISPATCH_DIRECT; DMA_DATA from memory or a
// word to memory by address, never a register, GDS or a select vid.h does
// not name; RELEASE_MEM without an interrupt; WRITE_DATA to memory;
// WAIT_REG_MEM on memory).
// A select field is read whole, up to the next field vid.h names, so that
// a bit no source gives a meaning to is refused too. Anything else (a
// register written by number, another indirect buffer, a packet 0) and
// the submit is refused with invalid, nothing run. The copy is what runs, so a program that
// changes its words after the call changes nothing the card reads. Then
// the copies of all its streams, one after the other, run as one indirect
// buffer in the context's space on compute ring 0, through ring.submitIn
// (the switch and the flush in front when the ring last ran another space,
// gpu_space.mlx; every submit flushes). The buffer is a program's: run in
// its space, it reaches no other memory, and a privileged register or
// instruction in it is the card's own fault (the graphics block's fault
// interrupts are on since stage 7's V1).
//
// FENCES (gpu_fence; the one wait): a fence is readable once the ring has
// passed the fence of the submit it was last given to, peer_gone when the
// context was lost before. The card's interrupt (its MSI: `interrupted`)
// takes the interrupt ring's entries (the end of pipe, a fault), and a
// process waiting is woken by that; the timer's tick looks as well
// (Linux's amdgpu_fence_fallback), and keeps the watchdog.
//
// A LOST CONTEXT: a fault in its address space (sources 146 and 147, told
// to it by gpu_space.mlx's collect), a privileged register or instruction
// of its stream (sources 184 and 185: Linux's gfx_v8_0_fault takes it as
// a hang of the job), or the ring that hangs in its work. Its pending
// fences end peer_gone, its later calls answer peer_gone, the work it gave
// the ring still runs (its memory waits for it); the other contexts go on.
// THE WATCHDOG: work in flight and the ring's fence not moved for
// HANG_NS (10 s: Linux's job timeout for the graphics and copy rings;
// its compute one is 60 s, which a desktop composing on this ring cannot
// wait). Linux's way back for a compute ring of this card is the
// graphics block's soft reset (gfx_v8_0_pre_soft_reset, _soft_reset,
// _post_soft_reset; gfx_v8_0's compute rings have no soft recovery), and
// it writes GMCON_DEBUG (the memory controller's) and SRBM_SOFT_RESET's
// GRBM and SEM bits, whose reach the sources do not say (the kernel
// study's 1.3 and 10, item 10): it cannot be shown not to touch the
// display, so it is not done. The ring is left down until the next boot,
// said in one line; every context with work on it is lost, and their
// spaces and memory are kept until the way down; the record lists no
// compute ring any more (why 4), and submits answer unsupported.
//
// RIGHTS AND LIMITS: who opens a context is the node's matter
// (/devices/gpu0: its user, given to the person at the seat by the login,
// and root: gpu_programs.mlx); a process has at most CONTEXTS_PER_PROCESS
// contexts, the card HANDED (7) that run (one address space each), and
// at most FENCES_PER_PROCESS fences and MAPPINGS_PER_PROCESS mappings (so
// that one program cannot take what the others need), too_many beyond. A
// context that ends with work in flight keeps its space, its memory and
// its number (gpu_offer.mlx keeps it: `inUse`) until the ring has passed
// that work, then gives them back.
//
// What the card is reached by: the engines' hands (registers, the
// aperture, the clock, the log), the memory set aside for the card, and
// `Hands` below (frames; a process's pages: `Pin`). Nothing here is the
// kernel's process or descriptor machinery, so the host builds it.
const engines = @import("./gpu_engines.mlx")
const loaded = @import("./gpu_smc_sdma.mlx")
const compute = @import("./gpu_compute.mlx")
const ring = @import("./gpu_ring.mlx")
const spaces = @import("./gpu_space.mlx")
const Status = @import("./status.mlx").Status

// ---- The calls' numbers (spec/04-stdlib/os/brix.xml, std.gpucard).
// The first of the six (NATIVE_BASE + 80: gpu_memory), and a stream's
// record's bytes.
pub const FIRST_CALL: usize = 80
pub const STREAM_BYTES: usize = 24
// gpu_memory's flags.
pub const CARD: usize = 1
pub const SYSTEM: usize = 2
pub const EITHER: usize = 3
pub const PROCESSOR: usize = 0x10
pub const WRITE_COMBINED: usize = 0x20
pub const ZEROED: usize = 0x40
pub const LOW: usize = 0x80
pub const SHAREABLE: usize = 0x100
pub const KNOWN_FLAGS: usize = EITHER | PROCESSOR | WRITE_COMBINED | ZEROED | LOW | SHAREABLE
// gpu_map's rights.
pub const READ: usize = 1
pub const WRITE: usize = 2
pub const EXECUTE: usize = 4
// A stream's engine.
pub const GRAPHICS: usize = 0
pub const COMPUTE: usize = 1
pub const COPY: usize = 2
// A fence's state as the one wait sees it (the spec's <States>).
pub const READABLE: u32 = 0x1
pub const PEER_GONE: u32 = 0x4

// ---- The packets a stream may have (vid.h; the driver's packets.mlx).
pub const PACKET3_NOP: usize = 0x10
pub const PACKET3_DISPATCH_DIRECT: usize = 0x15
pub const PACKET3_WRITE_DATA: usize = 0x37
pub const PACKET3_WAIT_REG_MEM: usize = 0x3C
pub const PACKET3_EVENT_WRITE: usize = 0x46
pub const PACKET3_RELEASE_MEM: usize = 0x49
pub const PACKET3_DMA_DATA: usize = 0x50
pub const PACKET3_ACQUIRE_MEM: usize = 0x58
pub const PACKET3_SET_SH_REG: usize = 0x76
// The shader registers SET_SH_REG names (vid.h: PACKET3_SET_SH_REG_START
// 0x2c00, _END 0x3000), and the one of them a program's stream may not
// write: the address space its dispatches run in (gfx_8_0_d.h).
pub const PACKET3_SET_SH_REG_START: usize = 0x2C00
pub const PACKET3_SET_SH_REG_END: usize = 0x3000
pub const COMPUTE_VMID: usize = 0x2E14
// WRITE_DATA's destination (vid.h: bits 8 up to WR_ONE_ADDR's 16; 1
// memory, 2 L2, 5 memory direct; 0 a register, 3 GDS), WAIT_REG_MEM's
// memory space (bits 4 and 5, Mesa's sid.h: 1 memory, 0 a register) and
// operation (bits 6 and 7: 1 writes registers), DMA_DATA's destination
// (bits 20 to 24, up to DST_CACHE_POLICY's 25: 0 and 3 an address, 1 GDS)
// and source (bits 29 and 30: 0 and 3 an address, 2 the data word, 1 GDS)
// and the register address spaces of its command word (vid.h).
pub const WRITE_DATA_DST_SEL_MASK: usize = 0xFF00
pub const WAIT_REG_MEM_MEM_SPACE_MASK: usize = 0x30
pub const WAIT_REG_MEM_MEM_SPACE: usize = 0x10
pub const WAIT_REG_MEM_OPERATION_MASK: usize = 0xC0
pub const DMA_DATA_DST_SEL_MASK: usize = 0x1F00000
pub const DMA_DATA_DST_SEL_SHIFT: u6 = 20
pub const DMA_DATA_SRC_SEL_MASK: usize = 0x60000000
pub const DMA_DATA_SRC_SEL_SHIFT: u6 = 29
pub const DMA_DATA_SRC_SEL_DATA: usize = 0x40000000
pub const DMA_DATA_CP_SYNC: usize = 0x80000000
pub const DMA_DATA_CMD_SAS: usize = 0x4000000
pub const DMA_DATA_CMD_DAS: usize = 0x8000000
// RELEASE_MEM's interrupt select in its second word after the header
// (vid.h's INT_SEL, bits 24 up to DATA_SEL's 29: 1 an interrupt alone, 2
// one when the write is confirmed).
pub const RELEASE_MEM_INT_SEL_SHIFT: u6 = 24
pub const RELEASE_MEM_INT_SEL_MASK: usize = 0x1F
// The kernel's own fill a packet: 511 pages, under the copy engine's most
// bytes a packet (the study's 7.6: 2 097 120; vid.h's BYTE_COUNT is 21
// bits).
pub const FILL_BYTES: usize = 511 * 4096
pub const FILL_PACKET_WORDS: usize = 7

// ---- This driver's own numbers.
pub const PAGE: usize = 4096
// The tables' sizes.
pub const MOST_CONTEXTS: usize = 64
pub const MOST_MEMORY: usize = 1024
pub const MOST_MAPPINGS: usize = 2048
pub const MOST_FENCES: usize = 512
pub const MOST_QUEUED: usize = 64
pub const MOST_STREAMS: usize = 64
pub const MOST_RANGES: usize = 512
pub const MOST_OWNERS: usize = 64
// A process's contexts; the memory objects a process may make; its fences
// and its mappings (an eighth of the card's each: the seven contexts the
// address spaces allow never take them all, whoever holds them).
pub const CONTEXTS_PER_PROCESS: usize = 4
pub const MEMORY_PER_PROCESS: usize = 512
pub const FENCES_PER_PROCESS: usize = MOST_FENCES / 8
pub const MAPPINGS_PER_PROCESS: usize = MOST_MAPPINGS / 8
// The card's addresses a program may use: from 2 MiB to the space's end
// (gpu_engines.mlx's MAX_PFN pages: 64 GiB).
pub const FIRST_ADDRESS: usize = spaces.AMDGPU_VA_RESERVED_SIZE
pub const ADDRESS_END: usize = engines.MAX_PFN * PAGE
// A large buffer's card memory on a 2 MiB boundary (Linux's default
// fragment: amdgpu_vm_adjust_size's 9).
pub const FRAGMENT: usize = 0x200000
// The context's copy area: 1 MiB from 1 MiB of its space (the bottom 2
// MiB are the kernel's; the first MiB stays unmapped, so that a stray
// small address faults), its copies on 256 bytes.
pub const COPY_AT: usize = 0x100000
pub const COPY_BYTES: usize = 0x100000
pub const COPY_ALIGN: usize = 256
// A list page of a system buffer's frames: 511 frames, then the next list
// page (0: none).
pub const LIST_FRAMES: usize = 511
// The watchdog's bound (nanoseconds), and how long a submit waits for its
// context's copy area to come free (the ring passing its older work).
pub const HANG_NS: usize = 10000000000
pub const ROOM_WAIT_NS: usize = 50000000
// Why the record lists no compute ring once the ring was left down (the
// spec's why 4).
pub const WHY_RING_DOWN: u32 = 4
// (No such thing.)
pub const NONE: usize = 0xFFFFFFFFFFFFFFFF

// What memory a buffer is.
pub const Kind = enum(u8) { card, system, user }

// A stream as gpu_submit's records give it (24 bytes: engine u32, flags
// u32, the card address of its words u64, how many words u64).
pub const Stream = struct {
    engine: u32
    flags: u32
    address: u64
    words: u64
}

// Stream record `n` of `bytes` (the process's memory, as the call gives
// it: engine u32, flags u32, address u64, words u64, the lowest byte
// first).
pub fn streamOf(bytes: [*]const u8, n: usize) -> Stream {
    const at = n * STREAM_BYTES
    return Stream.{ .engine = @intCast(u32, little(bytes, at, 4)), .flags = @intCast(u32, little(bytes, at + 4, 4)), .address = @intCast(u64, little(bytes, at + 8, 8)), .words = @intCast(u64, little(bytes, at + 16, 8)) }
}

fn little(bytes: [*]const u8, at: usize, count: usize) -> usize {
    var value: usize = 0
    var k = count
    while k > 0 {
        k -= 1
        value = (value << 8) | @intCast(usize, bytes[at + k])
    }
    return value
}

// What the kernel lends the calls beside the engines' hands: a zeroed
// frame of the system's memory for the card (its physical address, below
// 2^40; 0: none), a frame let go (one holder less), the kernel's address
// of a frame's bytes. (gpu_memory_of is given its own hand: a process's
// page at an address held for the card.)
pub const Hands = struct {
    frame: fn() -> usize
    free: fn(usize) -> void
    view: fn(usize) -> usize
}

// A page of process `caller` at an address, held for the card: its frame
// (one holder more), 0 when the process has none there.
pub const Pin = fn(usize, usize) -> usize

fn noPin(caller: usize, address: usize) -> usize { return 0 }

pub const Context = struct {
    used: bool
    // The process that made it, its address space of the card (NONE:
    // none), whether it was lost and why, whether its last handle went
    // and it waits for its work to end.
    owner: usize
    space: usize
    lost: bool
    why: []const u8
    ending: bool
    // Its submits; its copy area (a system buffer, NONE: not yet) and
    // where the next copy goes in it; the faults of its space seen.
    submits: usize
    copies: usize
    head: usize
    faultsSeen: usize
}

pub const Memory = struct {
    used: bool
    kind: Kind
    flags: usize
    // Its bytes (whole pages); the card's memory's offset, or the first
    // list page of its frames.
    size: usize
    offset: usize
    list: usize
    // Who made it (the process it counts to), the handles and the card
    // mappings that hold it, the newest ring fence that may still touch
    // it (NONE: none), whether it is the kernel's own (a copy area).
    owner: usize
    holders: usize
    mappings: usize
    busy: usize
    own: bool
}

pub const Mapping = struct {
    used: bool
    context: usize
    memory: usize
    address: usize
    size: usize
    offset: usize
    flags: usize
}

pub const Fence = struct {
    used: bool
    context: usize
    // The process it counts to.
    owner: usize
    // The ring's fence of the submit it was last given to (NONE: none),
    // whether the ring passed it, whether the context was lost first; its
    // handles.
    sequence: usize
    done: bool
    gone: bool
    holders: usize
}

// A submit in flight on the ring, in the ring's order.
pub const Queued = struct {
    context: usize
    fence: usize
    // Its copies' place in the context's copy area.
    start: usize
    end: usize
}

// What each process has: contexts, memory objects, bytes of each kind,
// fences, mappings.
pub const Owner = struct {
    used: bool
    process: usize
    contexts: usize
    objects: usize
    card: usize
    system: usize
    fences: usize
    mappings: usize
}

pub const Work = struct {
    hands: Hands
    // The card's parts it runs on, once `serve` found them (a boot whose
    // stage 7 passed); whether the calls are served, whether compute ring
    // 0 was left down.
    e: *engines.Engines
    l: *loaded.Loaded
    c: *compute.Compute
    s: *spaces.Spaces
    serving: bool
    down: bool
    // The card's memory for programs: [cardStart, cardEnd) as offsets in
    // the card's memory, its free runs (sorted), what is handed out.
    cardStart: usize
    cardEnd: usize
    freeStart: [MOST_RANGES]usize
    freeEnd: [MOST_RANGES]usize
    freeCount: usize
    cardUsed: usize
    // The system's memory for programs: the limit in all and per process,
    // and what is held (copy areas included).
    systemMost: usize
    systemUsed: usize
    processMost: usize
    contexts: [MOST_CONTEXTS]Context
    memories: [MOST_MEMORY]Memory
    mappings: [MOST_MAPPINGS]Mapping
    fences: [MOST_FENCES]Fence
    owners: [MOST_OWNERS]Owner
    // The submits in flight, oldest first (a ring of them).
    queue: [MOST_QUEUED]Queued
    first: usize
    queued: usize
    // The watchdog: the ring's fence word last looked at, and when it was
    // seen to move (or work began).
    lastDone: usize
    movedAt: usize
    // The ring's privileged faults seen; the ring's fence and its count of
    // end-of-pipe entries when the calls began to be served, both taken
    // with the ring idle (whether they were: `counted`), by which a fault
    // is told to the submit it came in; counts for the log and the tests.
    privSeen: usize
    fencesAt: usize
    entriesAt: usize
    counted: bool
    lostCount: usize
    submitted: usize
    refusedStreams: usize
    filled: usize
}

// ---- Reaching the card.

fn rd(w: *Work, number: usize) -> usize {
    const read = w.*.e.*.hands.read
    return @intCast(usize, read(number))
}

fn say(w: *Work, text: []const u8) -> void {
    const write = w.*.e.*.hands.say
    write(text)
}

fn now(w: *Work) -> usize {
    const clock = w.*.e.*.hands.now
    return clock()
}

fn pause(w: *Work, microseconds: usize) -> void {
    const wait = w.*.e.*.hands.pause
    wait(microseconds)
}

fn frame(w: *Work) -> usize {
    const take = w.*.hands.frame
    return take()
}

fn letGo(w: *Work, physical: usize) -> void {
    const free = w.*.hands.free
    free(physical)
}

fn view(w: *Work, physical: usize) -> usize {
    const at = w.*.hands.view
    return at(physical)
}

fn word32(w: *Work, physical: usize, at: usize) -> usize {
    const bytes = view(w, physical)
    return @intCast(usize, unsafe { @ptrFromInt(*u32, bytes + at) }.*)
}

fn setWord32(w: *Work, physical: usize, at: usize, value: usize) -> void {
    const bytes = view(w, physical)
    const place: *u32 = unsafe { @ptrFromInt(*u32, bytes + at) }
    place.* = @intCast(u32, value & 0xFFFFFFFF)
}

fn word64(w: *Work, physical: usize, at: usize) -> usize {
    const bytes = view(w, physical)
    return unsafe { @ptrFromInt(*usize, bytes + at) }.*
}

fn setWord64(w: *Work, physical: usize, at: usize, value: usize) -> void {
    const bytes = view(w, physical)
    const place: *usize = unsafe { @ptrFromInt(*usize, bytes + at) }
    place.* = value
}

fn decimal(w: *Work, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(w, digits[at..20])
}

fn hex(w: *Work, value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(w, text[0..2 + digits])
}

fn ringOf(w: *Work) -> *ring.Ring { return &w.*.c.*.compute }

// Whether compute ring 0 has room for `words` more and its padding.
fn ringRoom(w: *Work, words: usize) -> bool { return ring.room(w.*.e, ringOf(w)) >= words + ring.RING_ALIGN }

// The ring's fence word as the card last wrote it.
fn fenceWord(w: *Work) -> usize {
    const read = w.*.e.*.hands.memoryRead
    return @intCast(usize, read(ringOf(w).*.record + ring.FENCE_SLOT))
}

// Whether the ring has passed fence `value`.
fn passed(w: *Work, value: usize) -> bool {
    if value == NONE { return true }
    return ring.passed(w.*.e, ringOf(w), value)
}

// The later of two fences (NONE: none), as the ring's 32-bit numbers
// count from its last one sent.
fn later(w: *Work, a: usize, b: usize) -> usize {
    if a == NONE { return b }
    if b == NONE { return a }
    const sent = ringOf(w).*.sent
    return if (sent -% a) & 0xFFFFFFFF <= (sent -% b) & 0xFFFFFFFF { a } else { b }
}

// ---- The start.

// Nothing served, nothing held. `hands` lent; the limit of the system's
// memory for programs in all (bytes).
pub fn begin(w: *Work, hands: *const Hands, systemMost: usize) -> void {
    w.*.hands = hands.*
    w.*.serving = false
    w.*.down = false
    w.*.cardStart = 0
    w.*.cardEnd = 0
    w.*.freeCount = 0
    w.*.cardUsed = 0
    w.*.systemMost = systemMost
    w.*.systemUsed = 0
    w.*.processMost = 0
    var k: usize = 0
    while k < MOST_CONTEXTS {
        w.*.contexts[k].used = false
        k += 1
    }
    k = 0
    while k < MOST_MEMORY {
        w.*.memories[k].used = false
        k += 1
    }
    k = 0
    while k < MOST_MAPPINGS {
        w.*.mappings[k].used = false
        k += 1
    }
    k = 0
    while k < MOST_FENCES {
        w.*.fences[k].used = false
        k += 1
    }
    k = 0
    while k < MOST_OWNERS {
        w.*.owners[k].used = false
        k += 1
    }
    w.*.first = 0
    w.*.queued = 0
    w.*.lastDone = 0
    w.*.movedAt = 0
    w.*.privSeen = 0
    w.*.fencesAt = 0
    w.*.entriesAt = 0
    w.*.counted = false
    w.*.lostCount = 0
    w.*.submitted = 0
    w.*.refusedStreams = 0
    w.*.filled = 0
}

// The calls served on the card the stages brought up at this boot, when
// compute ring 0 runs (stage 5's G4) and stage 7's V1 passed (the address
// spaces are there, proved): the card's memory beyond the aperture for
// programs. Whether they are served; said in one line either way.
pub fn serve(w: *Work, e: *engines.Engines, l: *loaded.Loaded, c: *compute.Compute, s: *spaces.Spaces, v1: engines.Outcome) -> bool {
    w.*.e = e
    w.*.l = l
    w.*.c = c
    w.*.s = s
    w.*.serving = false
    if c.*.g4 != engines.Outcome.passed || !c.*.compute.up || v1 != engines.Outcome.passed || !s.*.up { return false }
    const view = e.*.card.view
    const bytes = e.*.found.vramBytes
    if bytes <= view { return false }
    w.*.cardStart = view
    w.*.cardEnd = bytes
    w.*.freeStart[0] = view
    w.*.freeEnd[0] = bytes
    w.*.freeCount = 1
    // A process may have half of each.
    w.*.processMost = (bytes - view) / 2
    w.*.lastDone = fenceWord(w)
    w.*.movedAt = now(w)
    w.*.privSeen = c.*.compute.faults
    // (Every fence on compute ring 0 from here on is this file's, each
    // with its end-of-pipe entry, and a program's stream raises none:
    // `allowed` refuses RELEASE_MEM's INT_SEL.)
    ring.entries(e, l, &c.*.compute)
    w.*.fencesAt = c.*.compute.sent
    w.*.entriesAt = c.*.compute.entries
    w.*.counted = fenceWord(w) == c.*.compute.sent & 0xFFFFFFFF
    w.*.serving = true
    say(w, "gpu: programs' work on compute ring 0: ")
    decimal(w, (bytes - view) / (1024 * 1024))
    say(w, " MiB of the card's memory and ")
    decimal(w, w.*.systemMost / (1024 * 1024))
    say(w, " MiB of the system's for programs, address spaces 1 to ")
    decimal(w, spaces.HANDED)
    say(w, ", streams checked and copied\n")
    return true
}

// Whether the calls are served now (the record lists the compute ring).
pub fn served(w: *const Work) -> bool { return w.*.serving && !w.*.down }

// ---- Owners.

fn ownerOf(w: *Work, process: usize) -> usize {
    var free = NONE
    var k: usize = 0
    while k < MOST_OWNERS {
        if w.*.owners[k].used && w.*.owners[k].process == process { return k }
        if !w.*.owners[k].used && free == NONE { free = k }
        k += 1
    }
    if free == NONE { return NONE }
    w.*.owners[free] = Owner.{ .used = true, .process = process, .contexts = 0, .objects = 0, .card = 0, .system = 0, .fences = 0, .mappings = 0 }
    return free
}

fn forgetOwner(w: *Work, at: usize) -> void {
    const o = &w.*.owners[at]
    if o.*.contexts == 0 && o.*.objects == 0 && o.*.card == 0 && o.*.system == 0 && o.*.fences == 0 && o.*.mappings == 0 { o.*.used = false }
}

// What process `process` holds now: its contexts, objects, bytes of the
// card's memory and of the system's (the tests' and the log's).
pub fn holding(w: *Work, process: usize) -> Owner {
    var k: usize = 0
    while k < MOST_OWNERS {
        if w.*.owners[k].used && w.*.owners[k].process == process { return w.*.owners[k] }
        k += 1
    }
    return Owner.{ .used = false, .process = process, .contexts = 0, .objects = 0, .card = 0, .system = 0, .fences = 0, .mappings = 0 }
}

// ---- The card's memory for programs.

// `size` bytes (whole pages) at a multiple of `alignment`, first fit: the
// offset, NONE when no run holds them.
fn cardTake(w: *Work, size: usize, alignment: usize) -> usize {
    var k: usize = 0
    while k < w.*.freeCount {
        const at = (w.*.freeStart[k] + alignment - 1) & ~(alignment - 1)
        if at < w.*.freeEnd[k] && w.*.freeEnd[k] - at >= size {
            const before = at - w.*.freeStart[k]
            const after = w.*.freeEnd[k] - (at + size)
            if before != 0 && after != 0 {
                if w.*.freeCount == MOST_RANGES { return NONE }
                var j = w.*.freeCount
                while j > k + 1 {
                    w.*.freeStart[j] = w.*.freeStart[j - 1]
                    w.*.freeEnd[j] = w.*.freeEnd[j - 1]
                    j -= 1
                }
                w.*.freeStart[k + 1] = at + size
                w.*.freeEnd[k + 1] = w.*.freeEnd[k]
                w.*.freeEnd[k] = at
                w.*.freeCount += 1
            } else if before != 0 {
                w.*.freeEnd[k] = at
            } else if after != 0 {
                w.*.freeStart[k] = at + size
            } else {
                var j = k
                while j + 1 < w.*.freeCount {
                    w.*.freeStart[j] = w.*.freeStart[j + 1]
                    w.*.freeEnd[j] = w.*.freeEnd[j + 1]
                    j += 1
                }
                w.*.freeCount -= 1
            }
            return at
        }
        k += 1
    }
    return NONE
}

// `size` bytes at `at` given back, joined to the runs beside them.
fn cardGive(w: *Work, at: usize, size: usize) -> void {
    var k: usize = 0
    while k < w.*.freeCount && w.*.freeStart[k] < at { k += 1 }
    const joinsBefore = k > 0 && w.*.freeEnd[k - 1] == at
    const joinsAfter = k < w.*.freeCount && w.*.freeStart[k] == at + size
    if joinsBefore && joinsAfter {
        w.*.freeEnd[k - 1] = w.*.freeEnd[k]
        var j = k
        while j + 1 < w.*.freeCount {
            w.*.freeStart[j] = w.*.freeStart[j + 1]
            w.*.freeEnd[j] = w.*.freeEnd[j + 1]
            j += 1
        }
        w.*.freeCount -= 1
    } else if joinsBefore {
        w.*.freeEnd[k - 1] = at + size
    } else if joinsAfter {
        w.*.freeStart[k] = at
    } else if w.*.freeCount < MOST_RANGES {
        var j = w.*.freeCount
        while j > k {
            w.*.freeStart[j] = w.*.freeStart[j - 1]
            w.*.freeEnd[j] = w.*.freeEnd[j - 1]
            j -= 1
        }
        w.*.freeStart[k] = at
        w.*.freeEnd[k] = at + size
        w.*.freeCount += 1
    }
}

// The card's memory free for programs now (bytes).
pub fn cardFree(w: *const Work) -> usize {
    var bytes: usize = 0
    var k: usize = 0
    while k < w.*.freeCount {
        bytes += w.*.freeEnd[k] - w.*.freeStart[k]
        k += 1
    }
    return bytes
}

// `size` bytes of the card's memory at `offset` cleared by the card: the
// DMA_DATA fills (a word to memory, the card's address of the memory: in
// the kernel's address space the card's memory is reached as it is) in
// compute ring 0 itself, the last one waiting for the copy engine, a fence
// after them. Whether the ring took them.
// The packets go in batches as the ring has room (its 2048 words hold
// some 240 of them, 480 MiB: a larger buffer is cleared batch after batch,
// each committed, the card taking them meanwhile); the wait for room
// ends when the ring has not moved for ROOM_WAIT_NS.
fn fill(w: *Work, offset: usize, size: usize) -> bool {
    const r = ringOf(w)
    if !r.*.up || r.*.refused || r.*.hung { return false }
    const start = w.*.e.*.found.vramStart + offset
    var done: usize = 0
    while done < size {
        // (The ring's room for a packet and the fence: the card passing
        // older work, a little while from its last move.)
        var since = now(w)
        var seen = ring.readPointer(w.*.e, r)
        while !ringRoom(w, FILL_PACKET_WORDS + ring.FRAME_WORDS) && now(w) - since < ROOM_WAIT_NS {
            pause(w, 100)
            ring.entries(w.*.e, w.*.l, r)
            const pointer = ring.readPointer(w.*.e, r)
            if pointer != seen {
                seen = pointer
                since = now(w)
            }
        }
        if !ringRoom(w, FILL_PACKET_WORDS + ring.FRAME_WORDS) {
            // (What was given stays on the ring: it clears a run the
            // caller gives back, before anything later on the ring.)
            if done != 0 { ring.commit(w.*.e, w.*.l, r) }
            return false
        }
        var batch = (ring.room(w.*.e, r) - ring.RING_ALIGN - ring.FRAME_WORDS) / FILL_PACKET_WORDS
        while batch > 0 && done < size {
            const bytes = if size - done > FILL_BYTES { FILL_BYTES } else { size - done }
            const target = start + done
            const sync: usize = if done + bytes == size { DMA_DATA_CP_SYNC } else { 0 }
            ring.emit(w.*.l, r, ring.packet3(PACKET3_DMA_DATA, 5))
            ring.emit(w.*.l, r, DMA_DATA_SRC_SEL_DATA | sync)
            ring.emit(w.*.l, r, 0)
            ring.emit(w.*.l, r, 0)
            ring.emit(w.*.l, r, target & 0xFFFFFFFF)
            ring.emit(w.*.l, r, target >> 32)
            ring.emit(w.*.l, r, bytes)
            done += bytes
            batch -= 1
        }
        if done == size {
            r.*.sent += 1
            ring.fence(w.*.l, r, r.*.sent, true)
            r.*.context = ring.NONE
        }
        ring.commit(w.*.e, w.*.l, r)
    }
    w.*.filled += 1
    return true
}

// ---- A system buffer's frames: list pages of LIST_FRAMES frames each,
// the next list page's address in the last word.

// Frame `page` of the buffer whose first list page is `list`.
fn frameOf(w: *Work, list: usize, page: usize) -> usize {
    var at = list
    var rest = page
    while rest >= LIST_FRAMES {
        at = word64(w, at, LIST_FRAMES * 8)
        rest -= LIST_FRAMES
        if at == 0 { return 0 }
    }
    return word64(w, at, rest * 8)
}

// The frames of `pages` pages and their list pages let go.
fn freeFrames(w: *Work, list: usize, pages: usize) -> void {
    var at = list
    var left = pages
    while at != 0 {
        var k: usize = 0
        while k < LIST_FRAMES && k < left {
            const held = word64(w, at, k * 8)
            if held != 0 { letGo(w, held) }
            k += 1
        }
        left = if left > LIST_FRAMES { left - LIST_FRAMES } else { 0 }
        const next = word64(w, at, LIST_FRAMES * 8)
        letGo(w, at)
        at = next
    }
}

// The list of `pages` frames: new zeroed ones, or (`address` not NONE)
// the pages of process `caller` from `address` on, held: the first list
// page, 0 when a frame was not had (nothing kept), NONE when a page of the
// process's was not there.
fn makeFrames(w: *Work, pages: usize, pin: Pin, caller: usize, address: usize) -> usize {
    const first = frame(w)
    if first == 0 { return 0 }
    var at = first
    var k: usize = 0
    while k < pages {
        if k > 0 && k % LIST_FRAMES == 0 {
            const next = frame(w)
            if next == 0 {
                freeFrames(w, first, k)
                return 0
            }
            setWord64(w, at, LIST_FRAMES * 8, next)
            at = next
        }
        var got: usize = 0
        if address == NONE {
            got = frame(w)
        } else {
            got = pin(caller, address + k * PAGE)
        }
        if got == 0 {
            freeFrames(w, first, k)
            return if address == NONE { 0 } else { NONE }
        }
        setWord64(w, at, (k % LIST_FRAMES) * 8, got)
        k += 1
    }
    return first
}

// ---- Memory.

fn freeMemory(w: *Work) -> usize {
    var k: usize = 0
    while k < MOST_MEMORY {
        if !w.*.memories[k].used { return k }
        k += 1
    }
    return NONE
}

// Memory `m`'s backing given back when nothing can still touch it: no
// handle, no mapping, the ring past its newest fence. Whether it went.
fn tryFree(w: *Work, m: usize) -> bool {
    const o = &w.*.memories[m]
    if !o.*.used || o.*.holders != 0 || o.*.mappings != 0 || !passed(w, o.*.busy) { return false }
    if o.*.kind == Kind.card {
        cardGive(w, o.*.offset, o.*.size)
        w.*.cardUsed -= o.*.size
    } else {
        freeFrames(w, o.*.list, o.*.size / PAGE)
        w.*.systemUsed -= o.*.size
    }
    const at = ownerOf(w, o.*.owner)
    if at != NONE {
        if o.*.kind == Kind.card { w.*.owners[at].card -= o.*.size } else { w.*.owners[at].system -= o.*.size }
        if !o.*.own { w.*.owners[at].objects -= 1 }
        forgetOwner(w, at)
    }
    o.*.used = false
    return true
}

// A new memory object counted to process `process`: its index, or a
// Status. Its frames new, or `caller`'s own pages from `address`.
fn makeMemory(w: *Work, process: usize, kind: Kind, flags: usize, pages: usize, own: bool, pin: Pin, caller: usize, address: usize) -> isize {
    const at = ownerOf(w, process)
    if at == NONE { return Status.too_many }
    const o = &w.*.owners[at]
    const bytes = pages * PAGE
    if !own && o.*.objects >= MEMORY_PER_PROCESS { return Status.too_many }
    if kind == Kind.card && (o.*.card + bytes > w.*.processMost || w.*.cardUsed + bytes > w.*.cardEnd - w.*.cardStart) { return Status.no_memory }
    if kind != Kind.card && (o.*.system + bytes > w.*.systemMost / 2 || w.*.systemUsed + bytes > w.*.systemMost) { return Status.no_memory }
    const m = freeMemory(w)
    if m == NONE { return Status.too_many }
    var offset: usize = 0
    var list: usize = 0
    if kind == Kind.card {
        offset = cardTake(w, bytes, if bytes >= FRAGMENT { FRAGMENT } else { PAGE })
        if offset == NONE { return Status.no_memory }
        if !fill(w, offset, bytes) {
            cardGive(w, offset, bytes)
            return Status.busy
        }
        w.*.cardUsed += bytes
        o.*.card += bytes
    } else {
        list = makeFrames(w, pages, pin, caller, address)
        if list == 0 { return Status.no_memory }
        if list == NONE { return Status.bad_address }
        w.*.systemUsed += bytes
        o.*.system += bytes
    }
    if !own { o.*.objects += 1 }
    w.*.memories[m] = Memory.{ .used = true, .kind = kind, .flags = flags, .size = bytes, .offset = offset, .list = list, .owner = process, .holders = 1, .mappings = 0, .busy = NONE, .own = own }
    // (The fill is the ring's newest work: nothing may reuse the run
    // before it.)
    if kind == Kind.card { w.*.memories[m].busy = ringOf(w).*.sent }
    return @intCast(isize, m)
}

// ---- Contexts.

fn contextOf(w: *Work, k: usize) -> *Context { return &w.*.contexts[k] }

// The calls' common checks for context `k`: served (unsupported), not
// lost (peer_gone). 0, or a Status.
fn usable(w: *Work, k: usize) -> isize {
    if k >= MOST_CONTEXTS || !w.*.contexts[k].used { return Status.invalid_handle }
    if !w.*.serving { return Status.unsupported }
    if w.*.contexts[k].lost { return Status.peer_gone }
    if w.*.contexts[k].space == NONE { return Status.unsupported }
    return 0
}

// A new context `k` (gpu_offer.mlx's number of it) of process `process`:
// its address space taken when the calls are served. 0, or too_many (the
// process has CONTEXTS_PER_PROCESS, or every address space is held).
pub fn open(w: *Work, k: usize, process: usize) -> isize {
    // (A number whose context still waits for its work is not free:
    // gpu_offer.mlx keeps it until `inUse` says the context ended.)
    if k >= MOST_CONTEXTS || w.*.contexts[k].used { return Status.too_many }
    const at = ownerOf(w, process)
    if at == NONE || w.*.owners[at].contexts >= CONTEXTS_PER_PROCESS {
        if at != NONE { forgetOwner(w, at) }
        return Status.too_many
    }
    var space = NONE
    if w.*.serving && !w.*.down {
        space = spaces.take(w.*.e, w.*.s, k)
        if space == spaces.NONE {
            forgetOwner(w, at)
            return Status.too_many
        }
    }
    w.*.owners[at].contexts += 1
    w.*.contexts[k] = Context.{ .used = true, .owner = process, .space = space, .lost = false, .why = "", .ending = false, .submits = 0, .copies = NONE, .head = 0, .faultsSeen = 0 }
    return 0
}

// Whether context number `k` is in use here: open, or ended by its last
// handle and waiting for the ring to pass its work.
pub fn inUse(w: *const Work, k: usize) -> bool { return k < MOST_CONTEXTS && w.*.contexts[k].used }

// Context `k`'s address space (NONE: none).
pub fn spaceOf(w: *const Work, k: usize) -> usize { return if k < MOST_CONTEXTS && w.*.contexts[k].used { w.*.contexts[k].space } else { NONE } }

// Whether context `k` is lost.
pub fn lost(w: *const Work, k: usize) -> bool { return k < MOST_CONTEXTS && w.*.contexts[k].used && w.*.contexts[k].lost }

// Context `k` lost: its pending fences end peer_gone, its later calls
// answer peer_gone, its work on the ring still runs; said in one line.
fn lose(w: *Work, k: usize, why: []const u8) -> void {
    const x = contextOf(w, k)
    if !x.*.used || x.*.lost { return }
    x.*.lost = true
    x.*.why = why
    w.*.lostCount += 1
    var f: usize = 0
    while f < MOST_FENCES {
        const fence = &w.*.fences[f]
        // (A fence whose end the kernel had not taken yet is pending: the
        // faults come before the fences in `take`, so the submit that
        // faulted ends peer_gone. So does one never given to a submit:
        // nothing would make it readable, and a wait on it must end.)
        if fence.*.used && fence.*.context == k && !fence.*.done { fence.*.gone = true }
        f += 1
    }
    say(w, "gpu: context ")
    decimal(w, k)
    say(w, " (process ")
    decimal(w, x.*.owner)
    say(w, ") lost: ")
    say(w, why)
    say(w, "\n")
}

// The newest fence of context `k`'s work in flight (NONE: none).
fn newestOf(w: *Work, k: usize) -> usize {
    var newest = NONE
    var n: usize = 0
    while n < w.*.queued {
        const q = &w.*.queue[(w.*.first + n) % MOST_QUEUED]
        if q.*.context == k { newest = q.*.fence }
        n += 1
    }
    return newest
}

// Mapping `at` taken out: its pages unmapped from the space, its memory
// busy until the context's newest work has passed.
fn unmapAt(w: *Work, at: usize) -> void {
    const g = &w.*.mappings[at]
    const x = contextOf(w, g.*.context)
    if x.*.space != NONE {
        var page: usize = 0
        while page < g.*.size / PAGE {
            _ = spaces.unmap(w.*.e, w.*.s, x.*.space, g.*.address + page * PAGE)
            page += 1
        }
    }
    const o = &w.*.memories[g.*.memory]
    o.*.mappings -= 1
    o.*.busy = later(w, o.*.busy, newestOf(w, g.*.context))
    g.*.used = false
    const owner = ownerOf(w, x.*.owner)
    if owner != NONE {
        w.*.owners[owner].mappings -= 1
        forgetOwner(w, owner)
    }
    _ = tryFree(w, g.*.memory)
}

// Context `k`'s end once its work has passed: its mappings out, its copy
// area and its space given back, its owner told. Whether it ended (false:
// its work did not end yet, or never will: the ring is down).
fn finish(w: *Work, k: usize) -> bool {
    const x = contextOf(w, k)
    retire(w)
    if newestOf(w, k) != NONE || (x.*.space != NONE && !spaces.idle(w.*.e, w.*.s, x.*.space)) { return false }
    var at: usize = 0
    while at < MOST_MAPPINGS {
        if w.*.mappings[at].used && w.*.mappings[at].context == k { unmapAt(w, at) }
        at += 1
    }
    if x.*.copies != NONE {
        if x.*.space != NONE {
            var page: usize = 0
            while page < COPY_BYTES / PAGE {
                _ = spaces.unmap(w.*.e, w.*.s, x.*.space, COPY_AT + page * PAGE)
                page += 1
            }
        }
        w.*.memories[x.*.copies].mappings = 0
        w.*.memories[x.*.copies].holders = 0
        _ = tryFree(w, x.*.copies)
        x.*.copies = NONE
    }
    if x.*.space != NONE {
        _ = spaces.give(w.*.e, w.*.s, x.*.space)
        x.*.space = NONE
    }
    // Its fences that another handle still holds: readable when the ring
    // passed their submit (all of its work has), else peer_gone; and no
    // context's any more (its number may be another's next).
    var f: usize = 0
    while f < MOST_FENCES {
        const fence = &w.*.fences[f]
        if fence.*.used && fence.*.context == k {
            _ = fenceState(w, f)
            if !fence.*.done { fence.*.gone = true }
            fence.*.context = NONE
        }
        f += 1
    }
    const o = ownerOf(w, x.*.owner)
    if o != NONE {
        w.*.owners[o].contexts -= 1
        forgetOwner(w, o)
    }
    x.*.used = false
    return true
}

// Context `k`'s last handle went (or its process ended): it ends now when
// nothing of its work is in flight, else once the ring has passed it.
pub fn end(w: *Work, k: usize) -> void {
    if k >= MOST_CONTEXTS || !w.*.contexts[k].used { return }
    w.*.contexts[k].ending = true
    if !finish(w, k) && w.*.down {
        // (Its work will not end: its space emptied, kept with its memory
        // until the way down.)
        if w.*.contexts[k].space != NONE { _ = spaces.empty(w.*.e, w.*.s, w.*.contexts[k].space) }
    }
}

// How many contexts there are, and of them how many wait for their work
// to end (the tests' look).
pub fn living(w: *const Work) -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < MOST_CONTEXTS {
        if w.*.contexts[k].used { count += 1 }
        k += 1
    }
    return count
}

// ---- The calls.

// gpu_memory: `size` bytes (whole pages) of memory for the card with
// `flags`, made by context `k`, counted to its process: the object's
// index, or a Status. The card's memory when CARD is asked (alone, or
// with SYSTEM as "either": the card's first) and the processor is not to
// map it; the system's when SYSTEM alone is asked, or "either" with the
// processor's mapping. The card's memory that the processor would map is
// no program's (no_memory: that heap has nothing). LOW asks nothing of
// the kernel: the driver chooses the card's addresses a buffer is put at.
pub fn memory(w: *Work, k: usize, size: usize, flags: usize) -> isize {
    const ok = usable(w, k)
    if ok < 0 { return ok }
    if size == 0 || flags & ~KNOWN_FLAGS != 0 || flags & EITHER == 0 { return Status.invalid }
    if size > ADDRESS_END { return Status.no_memory }
    const pages = (size + PAGE - 1) / PAGE
    if flags & EITHER == CARD && flags & PROCESSOR != 0 { return Status.no_memory }
    const card = flags & CARD != 0 && flags & PROCESSOR == 0
    // (The card's memory is cleared by the ring: none while it is down.)
    if card && w.*.down { return Status.unsupported }
    return makeMemory(w, contextOf(w, k).*.owner, if card { Kind.card } else { Kind.system }, flags, pages, false, noPin, 0, NONE)
}

// gpu_memory_of: the pages of the calling process (`caller`, as `pin`
// names it) at `address` (`size` bytes, both on pages) held for the card
// while the object lives, counted to the context's process: its index, or
// a Status (bad_address: a page the process does not have).
pub fn memoryOf(w: *Work, k: usize, pin: Pin, caller: usize, address: usize, size: usize) -> isize {
    const ok = usable(w, k)
    if ok < 0 { return ok }
    if size == 0 || address % PAGE != 0 || size % PAGE != 0 { return Status.invalid }
    if size > ADDRESS_END { return Status.no_memory }
    return makeMemory(w, contextOf(w, k).*.owner, Kind.user, SYSTEM | PROCESSOR, size / PAGE, false, pin, caller, address)
}

// The object's size, kind and flags, and its frame `page` (a system or a
// process's buffer; 0 for the card's memory): what memory_map_object
// maps for the processor.
pub fn sizeOf(w: *const Work, m: usize) -> usize { return w.*.memories[m].size }

pub fn mappable(w: *const Work, m: usize) -> bool { return w.*.memories[m].kind != Kind.card }

pub fn flagsOf(w: *const Work, m: usize) -> usize { return w.*.memories[m].flags }

pub fn pageOf(w: *Work, m: usize, page: usize) -> usize {
    const o = &w.*.memories[m]
    if o.*.kind == Kind.card || page >= o.*.size / PAGE { return 0 }
    return frameOf(w, o.*.list, page)
}

// One more handle holds memory `m`; one less (the last of all, with no
// mapping and nothing in flight, frees it).
pub fn retainMemory(w: *Work, m: usize) -> void {
    if m < MOST_MEMORY && w.*.memories[m].used { w.*.memories[m].holders += 1 }
}

pub fn releaseMemory(w: *Work, m: usize) -> void {
    if m >= MOST_MEMORY || !w.*.memories[m].used || w.*.memories[m].holders == 0 { return }
    w.*.memories[m].holders -= 1
    _ = tryFree(w, m)
}

// How many memory objects there are (the tests' look).
pub fn objects(w: *const Work) -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < MOST_MEMORY {
        if w.*.memories[k].used { count += 1 }
        k += 1
    }
    return count
}

// A mapped page's word for the address space's table: what kind of page
// and its address.
fn pageFor(w: *Work, o: *const Memory, page: usize) -> usize {
    if o.*.kind == Kind.card { return o.*.offset + page * PAGE }
    return frameOf(w, o.*.list, page)
}

// gpu_unmap's and gpu_map's statuses from the space's answer.
fn statusOf(m: spaces.Mapped) -> isize {
    if m == spaces.Mapped.already { return Status.exists }
    if m == spaces.Mapped.no_room { return Status.no_memory }
    if m == spaces.Mapped.does_not_hold { return Status.io_error }
    if m == spaces.Mapped.kept { return Status.peer_gone }
    if m == spaces.Mapped.not_on_a_page { return Status.invalid }
    return Status.bad_address
}

// gpu_map: `size` bytes of memory `m` from `offset` at card address
// `address` of context `k`'s space with `flags` (read 1, write 2,
// execute 4). 0, or a Status.
pub fn map(w: *Work, k: usize, m: usize, offset: usize, size: usize, address: usize, flags: usize) -> isize {
    const ok = usable(w, k)
    if ok < 0 { return ok }
    if m >= MOST_MEMORY || !w.*.memories[m].used { return Status.invalid_handle }
    if flags == 0 || flags & ~(READ | WRITE | EXECUTE) != 0 { return Status.invalid }
    if size == 0 || offset % PAGE != 0 || size % PAGE != 0 || address % PAGE != 0 { return Status.invalid }
    const o = &w.*.memories[m]
    if offset > o.*.size || size > o.*.size - offset { return Status.invalid }
    if address < FIRST_ADDRESS || address > ADDRESS_END || size > ADDRESS_END - address { return Status.bad_address }
    var free = NONE
    var at: usize = 0
    while at < MOST_MAPPINGS {
        const g = &w.*.mappings[at]
        if g.*.used {
            if g.*.context == k && address < g.*.address + g.*.size && g.*.address < address + size { return Status.exists }
        } else if free == NONE {
            free = at
        }
        at += 1
    }
    if free == NONE { return Status.too_many }
    const x = contextOf(w, k)
    const owner = ownerOf(w, x.*.owner)
    if owner == NONE || w.*.owners[owner].mappings >= MAPPINGS_PER_PROCESS { return Status.too_many }
    const kind = if o.*.kind == Kind.card { spaces.Memory.card } else { spaces.Memory.system }
    var page: usize = 0
    while page < size / PAGE {
        const answer = spaces.map(w.*.e, w.*.s, x.*.space, address + page * PAGE, kind, pageFor(w, o, offset / PAGE + page), flags)
        if answer != spaces.Mapped.done {
            // (A part mapped is taken out again.)
            while page > 0 {
                page -= 1
                _ = spaces.unmap(w.*.e, w.*.s, x.*.space, address + page * PAGE)
            }
            return statusOf(answer)
        }
        page += 1
    }
    w.*.mappings[free] = Mapping.{ .used = true, .context = k, .memory = m, .address = address, .size = size, .offset = offset, .flags = flags }
    o.*.mappings += 1
    w.*.owners[owner].mappings += 1
    return 0
}

// gpu_unmap: the mapping of context `k` at `address`, `size` bytes, as it
// was made, taken out. 0, or not_found.
pub fn unmap(w: *Work, k: usize, address: usize, size: usize) -> isize {
    const ok = usable(w, k)
    if ok < 0 { return ok }
    var at: usize = 0
    while at < MOST_MAPPINGS {
        const g = &w.*.mappings[at]
        if g.*.used && g.*.context == k && g.*.address == address && g.*.size == size {
            unmapAt(w, at)
            return 0
        }
        at += 1
    }
    return Status.not_found
}

// How many mappings there are (the tests' look).
pub fn mapped(w: *const Work) -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < MOST_MAPPINGS {
        if w.*.mappings[k].used { count += 1 }
        k += 1
    }
    return count
}

// gpu_fence: a fence of context `k`: its index, or a Status.
pub fn fence(w: *Work, k: usize) -> isize {
    const ok = usable(w, k)
    if ok < 0 { return ok }
    const process = contextOf(w, k).*.owner
    const owner = ownerOf(w, process)
    if owner == NONE || w.*.owners[owner].fences >= FENCES_PER_PROCESS { return Status.too_many }
    var f: usize = 0
    while f < MOST_FENCES {
        if !w.*.fences[f].used {
            w.*.fences[f] = Fence.{ .used = true, .context = k, .owner = process, .sequence = NONE, .done = false, .gone = false, .holders = 1 }
            w.*.owners[owner].fences += 1
            return @intCast(isize, f)
        }
        f += 1
    }
    return Status.too_many
}

pub fn fenceContext(w: *const Work, f: usize) -> usize { return w.*.fences[f].context }

pub fn retainFence(w: *Work, f: usize) -> void {
    if f < MOST_FENCES && w.*.fences[f].used { w.*.fences[f].holders += 1 }
}

pub fn releaseFence(w: *Work, f: usize) -> void {
    if f >= MOST_FENCES || !w.*.fences[f].used || w.*.fences[f].holders == 0 { return }
    w.*.fences[f].holders -= 1
    if w.*.fences[f].holders == 0 {
        w.*.fences[f].used = false
        const owner = ownerOf(w, w.*.fences[f].owner)
        if owner != NONE {
            w.*.owners[owner].fences -= 1
            forgetOwner(w, owner)
        }
    }
}

// Fence `f`'s state for the one wait: readable once the ring passed its
// submit, peer_gone when its context was lost (or ended) first.
pub fn fenceState(w: *Work, f: usize) -> u32 {
    if f >= MOST_FENCES || !w.*.fences[f].used { return 0 }
    const fence = &w.*.fences[f]
    if fence.*.done { return READABLE }
    if fence.*.gone { return PEER_GONE }
    if fence.*.sequence != NONE && w.*.serving && passed(w, fence.*.sequence) {
        fence.*.done = true
        return READABLE
    }
    return 0
}

// How many fences there are (the tests' look).
pub fn fenceCount(w: *const Work) -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < MOST_FENCES {
        if w.*.fences[k].used { count += 1 }
        k += 1
    }
    return count
}

// ---- A submit.

// The submits in flight whose fence the ring passed taken off the queue
// (oldest first), their fences done.
fn retire(w: *Work) -> void {
    while w.*.queued > 0 {
        const q = &w.*.queue[w.*.first]
        if !passed(w, q.*.fence) { return }
        w.*.first = (w.*.first + 1) % MOST_QUEUED
        w.*.queued -= 1
    }
}

// Where `bytes` of copies fit in context `k`'s copy area now (between its
// head and its oldest work in flight): their offset, NONE when they do not.
// The head never comes to rest on the oldest copy in flight: a head equal
// to it would say the area is empty when it is full, and the next copies
// would be written over ones the ring has not run (from the middle of a
// packet, any word of a program's would be a header to the card).
fn roomFor(w: *Work, k: usize, bytes: usize) -> usize {
    const x = contextOf(w, k)
    var oldest = NONE
    var n: usize = 0
    while n < w.*.queued {
        const q = &w.*.queue[(w.*.first + n) % MOST_QUEUED]
        if q.*.context == k {
            oldest = q.*.start
            break
        }
        n += 1
    }
    if oldest == NONE {
        x.*.head = 0
        return if bytes <= COPY_BYTES { 0 } else { NONE }
    }
    if x.*.head >= oldest {
        if COPY_BYTES - x.*.head >= bytes { return x.*.head }
        if oldest > bytes { return 0 }
        return NONE
    }
    if oldest - x.*.head > bytes { return x.*.head }
    return NONE
}

// The copy area of context `k`, made at its first submit: COPY_BYTES of
// the system's memory, mapped read and execute at COPY_AT of its space.
// Whether it is there.
fn copyArea(w: *Work, k: usize) -> bool {
    const x = contextOf(w, k)
    if x.*.copies != NONE { return true }
    const made = makeMemory(w, x.*.owner, Kind.system, SYSTEM, COPY_BYTES / PAGE, true, noPin, 0, NONE)
    if made < 0 { return false }
    const m = @bitCast(usize, made)
    var page: usize = 0
    while page < COPY_BYTES / PAGE {
        const answer = spaces.mapReserved(w.*.e, w.*.s, x.*.space, COPY_AT + page * PAGE, spaces.Memory.system, frameOf(w, w.*.memories[m].list, page), READ | EXECUTE)
        if answer != spaces.Mapped.done {
            while page > 0 {
                page -= 1
                _ = spaces.unmap(w.*.e, w.*.s, x.*.space, COPY_AT + page * PAGE)
            }
            w.*.memories[m].holders = 0
            _ = tryFree(w, m)
            return false
        }
        page += 1
    }
    w.*.memories[m].mappings = 1
    x.*.copies = m
    return true
}

// The mapping of context `k` that holds `count` bytes from card address
// `address` with the execute right, in memory the kernel reads (NONE:
// none).
fn streamMapping(w: *Work, k: usize, address: usize, count: usize) -> usize {
    var at: usize = 0
    while at < MOST_MAPPINGS {
        const g = &w.*.mappings[at]
        if g.*.used && g.*.context == k && address >= g.*.address && address - g.*.address < g.*.size && count <= g.*.size - (address - g.*.address) {
            if g.*.flags & EXECUTE == 0 || w.*.memories[g.*.memory].kind == Kind.card { return NONE }
            return at
        }
        at += 1
    }
    return NONE
}

// Word `index` of a stream that lies in mapping `g` from card address
// `address`.
fn streamWord(w: *Work, g: *const Mapping, address: usize, index: usize) -> usize {
    const o = &w.*.memories[g.*.memory]
    const byte = g.*.offset + (address - g.*.address) + index * 4
    return word32(w, frameOf(w, o.*.list, byte / PAGE), byte % PAGE)
}

// Word `index` from byte `at` of the copy area whose first list page is
// `list`: what the card will read there.
fn copyWord(w: *Work, list: usize, at: usize, index: usize) -> usize {
    const byte = at + index * 4
    return word32(w, frameOf(w, list, byte / PAGE), byte % PAGE)
}

// Whether the packet already copied to byte `at` of the copy area whose
// first list page is `list` (its header `header`, its `count` words after
// it) is one a program's compute stream may have. It is judged on the
// copy, the words the card will run (Linux's parse_cs as well: the
// buffer copied first, the copy parsed: amdgpu_cs.c, amdgpu_cs_patch_ibs),
// never on the program's memory, which the program (another of its
// threads, a process it shares the memory with, the card itself running
// its earlier work) may change between a look and a copy.
fn allowed(w: *Work, list: usize, at: usize, header: usize, count: usize) -> bool {
    const op = (header >> 8) & 0xFF
    if op == PACKET3_NOP || op == PACKET3_EVENT_WRITE || op == PACKET3_ACQUIRE_MEM || op == PACKET3_DISPATCH_DIRECT { return true }
    if op == PACKET3_RELEASE_MEM {
        // Its words as the ring's own fence has them (vid.h: the event,
        // then DST_SEL, INT_SEL, DATA_SEL), and no interrupt: the end of
        // pipe of a program's own packet would be the kernel's interrupt
        // to take, as many a stream as it likes (the kernel's frame after
        // the stream raises the one the fence needs).
        if count != 6 { return false }
        return (copyWord(w, list, at, 2) >> RELEASE_MEM_INT_SEL_SHIFT) & RELEASE_MEM_INT_SEL_MASK == 0
    }
    if op == PACKET3_SET_SH_REG {
        // The registers named lie in the shader registers, COMPUTE_VMID
        // not among them; the offset word read whole (a bit above the
        // offset, which no source gives a meaning to, names no register
        // of the range).
        if count < 2 { return false }
        const first = PACKET3_SET_SH_REG_START + copyWord(w, list, at, 1)
        const last = first + (count - 2)
        return last < PACKET3_SET_SH_REG_END && (COMPUTE_VMID < first || COMPUTE_VMID > last)
    }
    if op == PACKET3_WRITE_DATA {
        // To memory alone (1, 2, 5), never a register (0) or GDS (3).
        if count < 4 { return false }
        const target = (copyWord(w, list, at, 1) & WRITE_DATA_DST_SEL_MASK) >> 8
        return target == 1 || target == 2 || target == 5
    }
    if op == PACKET3_WAIT_REG_MEM {
        // On memory (never a register), and a wait alone.
        if count != 6 { return false }
        const control = copyWord(w, list, at, 1)
        return control & WAIT_REG_MEM_MEM_SPACE_MASK == WAIT_REG_MEM_MEM_SPACE && control & WAIT_REG_MEM_OPERATION_MASK == 0
    }
    if op == PACKET3_DMA_DATA {
        // From an address or the data word, to an address; the addresses
        // memory's, not the registers'.
        if count != 6 { return false }
        const control = copyWord(w, list, at, 1)
        const command = copyWord(w, list, at, 6)
        const target = (control & DMA_DATA_DST_SEL_MASK) >> DMA_DATA_DST_SEL_SHIFT
        const source = (control & DMA_DATA_SRC_SEL_MASK) >> DMA_DATA_SRC_SEL_SHIFT
        if (target != 0 && target != 3) || source == 1 { return false }
        return command & (DMA_DATA_CMD_SAS | DMA_DATA_CMD_DAS) == 0
    }
    return false
}

// Stream `s` of context `k` copied and checked into its copy area from
// byte `at`: how many words, or NONE (a packet a program's stream may not
// have, or one that runs past the stream's end; `w.refusedStreams` counts
// them).
fn copyStream(w: *Work, k: usize, g: *const Mapping, s: *const Stream, at: usize) -> usize {
    const x = contextOf(w, k)
    const list = w.*.memories[x.*.copies].list
    const address = @intCast(usize, s.*.address)
    const words = @intCast(usize, s.*.words)
    var n: usize = 0
    while n < words {
        // Each word of the program's read once: into the copy, and what
        // is judged is the copy.
        const header = streamWord(w, g, address, n)
        const byte = at + n * 4
        setWord32(w, frameOf(w, list, byte / PAGE), byte % PAGE, header)
        var length: usize = 1
        if header == ring.nop() {
            length = 1
        } else if header >> 30 == 2 {
            // (A filler of packet 2: one word.)
            length = 1
        } else if header >> 30 == 3 {
            const count = ((header >> 16) & 0x3FFF) + 1
            if n + 1 + count > words {
                w.*.refusedStreams += 1
                return NONE
            }
            var j: usize = 1
            while j <= count {
                const place = at + (n + j) * 4
                setWord32(w, frameOf(w, list, place / PAGE), place % PAGE, streamWord(w, g, address, n + j))
                j += 1
            }
            if !allowed(w, list, byte, header, count) {
                w.*.refusedStreams += 1
                return NONE
            }
            length = count + 1
        } else {
            w.*.refusedStreams += 1
            return NONE
        }
        n += length
    }
    return words
}

// gpu_submit: `count` streams (`streams`, the kernel's copy of the
// records) of context `k` run in order on compute ring 0, fence `f`
// (NONE: none) readable when they are done. The context's submit number,
// or a Status.
pub fn submit(w: *Work, k: usize, streams: [*]const Stream, count: usize, f: usize) -> isize {
    const ok = usable(w, k)
    if ok < 0 { return ok }
    const r = ringOf(w)
    if w.*.down || r.*.hung { return Status.unsupported }
    if f != NONE && (f >= MOST_FENCES || !w.*.fences[f].used) { return Status.invalid_handle }
    if f != NONE && w.*.fences[f].context != k { return Status.invalid }
    if count == 0 || count > MOST_STREAMS { return Status.invalid }
    var total: usize = 0
    var n: usize = 0
    while n < count {
        const s = &streams[n]
        if @intCast(usize, s.*.engine) != COMPUTE || s.*.flags != 0 || s.*.words == 0 { return Status.invalid }
        const address = @intCast(usize, s.*.address)
        const words = @intCast(usize, s.*.words)
        if address & 3 != 0 || words > ring.IB_LENGTH_MOST || streamMapping(w, k, address, words * 4) == NONE { return Status.bad_address }
        total += words
        n += 1
    }
    if total > ring.IB_LENGTH_MOST || total * 4 > COPY_BYTES { return Status.invalid }
    if !copyArea(w, k) { return Status.no_memory }
    // The room: the ring passing the context's older work, a little while.
    const bytes = (total * 4 + COPY_ALIGN - 1) / COPY_ALIGN * COPY_ALIGN
    retire(w)
    var at = roomFor(w, k, bytes)
    const started = now(w)
    while (at == NONE || w.*.queued == MOST_QUEUED || !ringRoom(w, ring.SPACE_FRAME_WORDS)) && now(w) - started < ROOM_WAIT_NS {
        pause(w, 100)
        ring.entries(w.*.e, w.*.l, r)
        retire(w)
        at = roomFor(w, k, bytes)
    }
    if at == NONE || w.*.queued == MOST_QUEUED || !ringRoom(w, ring.SPACE_FRAME_WORDS) { return Status.busy }
    // The streams copied and checked, one after the other.
    var place = at
    n = 0
    while n < count {
        const s = &streams[n]
        const g = &w.*.mappings[streamMapping(w, k, @intCast(usize, s.*.address), @intCast(usize, s.*.words) * 4)]
        const copied = copyStream(w, k, g, s, place)
        if copied == NONE { return Status.invalid }
        place += copied * 4
        n += 1
    }
    @fence(seq_cst)
    const x = contextOf(w, k)
    const idleBefore = w.*.queued == 0
    const sequence = spaces.submit(w.*.e, w.*.l, w.*.s, r, x.*.space, COPY_AT + at, total, false)
    if sequence == spaces.NONE { return Status.busy }
    w.*.queue[(w.*.first + w.*.queued) % MOST_QUEUED] = Queued.{ .context = k, .fence = sequence, .start = at, .end = at + bytes }
    w.*.queued += 1
    x.*.head = at + bytes
    x.*.submits += 1
    w.*.submitted += 1
    if idleBefore {
        w.*.lastDone = fenceWord(w)
        w.*.movedAt = now(w)
    }
    if f != NONE {
        w.*.fences[f].sequence = sequence
        w.*.fences[f].done = false
        w.*.fences[f].gone = false
    }
    return @intCast(isize, x.*.submits)
}

// ---- What the card tells.

// The oldest submit in flight (its context; NONE: none): the one the ring
// runs now.
fn running(w: *Work) -> usize {
    retire(w)
    if w.*.queued == 0 { return NONE }
    return w.*.queue[w.*.first].context
}

// The interrupt ring's entries taken (the card's MSI, and the tick):
// faults told to their contexts, fences done, ended contexts finished,
// memory freed that nothing can touch now.
pub fn interrupted(w: *Work) -> void {
    if !w.*.serving { return }
    const r = ringOf(w)
    ring.entries(w.*.e, w.*.l, r)
    take(w)
}

// The context whose submit privileged fault `n` of compute ring 0 came in
// (NONE: none in flight). The entry names the ring, not the submit; but
// the fences before the fault came before it in the interrupt ring, each
// with its entry, and a submit's own flush fence comes before its stream:
// so the submit is the first in flight whose fence had not come when the
// fault did, whether the card stopped there or went on. (Without those
// counts, a fault older than the ring keeps or a start with the ring not
// idle: the oldest in flight.)
fn faulter(w: *Work, n: usize) -> usize {
    const r = ringOf(w)
    if w.*.queued == 0 { return NONE }
    if !w.*.counted || r.*.faults - n > ring.FAULTS { return w.*.queue[w.*.first].context }
    const come = (w.*.fencesAt + r.*.faultAfter[n % ring.FAULTS] - w.*.entriesAt) & 0xFFFFFFFF
    var q: usize = 0
    while q < w.*.queued {
        const at = &w.*.queue[(w.*.first + q) % MOST_QUEUED]
        const ahead = (at.*.fence -% come) & 0xFFFFFFFF
        if ahead != 0 && ahead < 0x80000000 { return at.*.context }
        q += 1
    }
    return NONE
}

fn take(w: *Work) -> void {
    const r = ringOf(w)
    // A privileged register or instruction: told to the submit it came in
    // (`faulter`), before `retire` takes the submits that ended off the
    // queue.
    while w.*.privSeen != r.*.faults {
        const k = faulter(w, w.*.privSeen)
        w.*.privSeen += 1
        if k != NONE { lose(w, k, "a privileged register or instruction in its stream (the card's own fault)") }
    }
    // The memory controller's faults, each told to its space's context.
    if r.*.spaceFaults != 0 { _ = spaces.collect(w.*.e, w.*.s, r) }
    var k: usize = 0
    while k < MOST_CONTEXTS {
        const x = &w.*.contexts[k]
        if x.*.used && x.*.space != NONE && w.*.s.*.faults[x.*.space] != x.*.faultsSeen {
            x.*.faultsSeen = w.*.s.*.faults[x.*.space]
            lose(w, k, "a fault in its address space")
        }
        k += 1
    }
    retire(w)
    var f: usize = 0
    while f < MOST_FENCES {
        _ = fenceState(w, f)
        f += 1
    }
    k = 0
    while k < MOST_CONTEXTS {
        if w.*.contexts[k].used && w.*.contexts[k].ending { _ = finish(w, k) }
        k += 1
    }
    var m: usize = 0
    while m < MOST_MEMORY {
        if w.*.memories[m].used { _ = tryFree(w, m) }
        m += 1
    }
}

// The timer's tick: the entries looked at (Linux's fence fallback), and
// the watchdog: work in flight whose fence has not moved for HANG_NS
// leaves the ring down.
pub fn tick(w: *Work) -> void {
    if !w.*.serving || w.*.down { return }
    interrupted(w)
    const r = ringOf(w)
    const word = fenceWord(w)
    if w.*.queued == 0 || word != w.*.lastDone {
        w.*.lastDone = word
        w.*.movedAt = now(w)
        return
    }
    if now(w) - w.*.movedAt < HANG_NS { return }
    leaveDown(w)
}

// Compute ring 0 left down: no new work on it, every context with work in
// flight lost, their spaces emptied and kept; said.
fn leaveDown(w: *Work) -> void {
    const r = ringOf(w)
    w.*.down = true
    r.*.hung = true
    const guilty = running(w)
    say(w, "gpu: compute ring 0 has not moved for ")
    decimal(w, HANG_NS / 1000000000)
    say(w, " s (fence ")
    hex(w, fenceWord(w))
    say(w, " of ")
    hex(w, r.*.sent)
    say(w, "; ")
    ring.sayState(w.*.e, r)
    say(w, "): it stays down until the next boot; Linux's way back for it, the graphics block's soft reset, writes words whose reach on the display the sources do not say\n")
    if guilty != NONE { lose(w, guilty, "compute ring 0 hung in its work") }
    var n: usize = 0
    while n < w.*.queued {
        const q = &w.*.queue[(w.*.first + n) % MOST_QUEUED]
        lose(w, q.*.context, "its work was behind the work that hung")
        n += 1
    }
    var k: usize = 0
    while k < MOST_CONTEXTS {
        const x = &w.*.contexts[k]
        if x.*.used && x.*.lost && x.*.space != NONE && !spaces.idle(w.*.e, w.*.s, x.*.space) { _ = spaces.empty(w.*.e, w.*.s, x.*.space) }
        k += 1
    }
}

// Whether the ring was left down.
pub fn ringDown(w: *const Work) -> bool { return w.*.down }

// ---- The way down.

// Before the stages' way down (the processors halted after this): every
// context lost, nothing new taken. The spaces are given back by stage 7's
// way down.
pub fn stop(w: *Work) -> void {
    if !w.*.serving { return }
    var k: usize = 0
    while k < MOST_CONTEXTS {
        if w.*.contexts[k].used { lose(w, k, "the system goes down") }
        k += 1
    }
    w.*.serving = false
}
