// What a kernel operation answers when it fails (spec/04-stdlib/os/
// brix.xml, <Status>). The core returns -(BASE + code): apart from the
// Linux layer's errno (below it in size) and from wait.BLOCKED, so each
// layer turns it into its own at its edge: native calls -code
// (native/calls.mlx), Linux's -errno (linux/errno.mlx).
pub const Status = struct {
    const BASE: isize = 0x10000

    pub const invalid_handle: isize = -65537
    pub const wrong_kind: isize = -65538
    pub const no_right: isize = -65539
    pub const would_block: isize = -65540
    pub const timed_out: isize = -65541
    pub const not_found: isize = -65542
    pub const exists: isize = -65543
    pub const no_memory: isize = -65544
    pub const bad_address: isize = -65545
    pub const invalid: isize = -65546
    pub const peer_gone: isize = -65547
    pub const interrupted: isize = -65548
    pub const not_directory: isize = -65549
    pub const is_directory: isize = -65550
    pub const not_empty: isize = -65551
    pub const read_only: isize = -65552
    pub const too_large: isize = -65553
    pub const unsupported: isize = -65554
    pub const busy: isize = -65555
    pub const denied: isize = -65556
    pub const too_many: isize = -65557
    pub const link_loop: isize = -65558
    pub const no_space: isize = -65559
    pub const io_error: isize = -65560
    pub const cross_volume: isize = -65561
    pub const name_too_long: isize = -65562
    const LAST: isize = -65562

    // Whether `result` is a Status (not a value, an errno, or BLOCKED).
    pub fn isStatus(result: isize) -> bool { return result <= invalid_handle && result >= LAST }

    // Its code (1 for invalid_handle, ...), as the native calls give it.
    pub fn code(result: isize) -> isize { return -result - BASE }
}
