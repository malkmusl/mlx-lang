// PCI: the configuration space by the I/O ports 0xCF8/0xCFC (mechanism
// #1), the devices of bus 0 found by their vendor and device.
const Port = @import("./cpu.mlx").Port

pub const Pci = struct {
    const ADDRESS: usize = 0xCF8
    const DATA: usize = 0xCFC
    const ENABLE: usize = 0x80000000
    pub const NONE: usize = 0xFFFFFFFF
    // Configuration registers.
    pub const VENDOR_DEVICE: usize = 0x00
    pub const COMMAND: usize = 0x04
    pub const HEADER_TYPE: usize = 0x0C
    pub const BAR0: usize = 0x10
    // COMMAND's bits: I/O space, bus mastering (the device's DMA).
    pub const IO_SPACE: usize = 0x1
    pub const BUS_MASTER: usize = 0x4

    // The configuration address of bus 0's `device`, `function`.
    pub fn at(device: usize, function: usize) -> usize { return ENABLE | (device << 11) | (function << 8) }

    pub fn read(address: usize, register: usize) -> usize {
        Port.out32(ADDRESS, address | (register & 0xFC))
        return Port.in32(DATA)
    }

    pub fn write(address: usize, register: usize, value: usize) -> void {
        Port.out32(ADDRESS, address | (register & 0xFC))
        Port.out32(DATA, value)
    }

    // The device `vendor`:`device` on bus 0: its configuration address,
    // NONE when there is none.
    pub fn find(vendor: usize, device: usize) -> usize {
        var slot: usize = 0
        while slot < 32 {
            var function: usize = 0
            while function < 8 {
                const address = at(slot, function)
                const id = read(address, VENDOR_DEVICE)
                if id == (device << 16 | vendor) { return address }
                // Only function 0 unless the device has more.
                if function == 0 && (id & 0xFFFF == 0xFFFF || read(address, HEADER_TYPE) & 0x800000 == 0) { break }
                function += 1
            }
            slot += 1
        }
        return NONE
    }

    // The I/O port base of an I/O BAR; 0 when it is a memory BAR.
    pub fn ioBase(address: usize, bar: usize) -> usize {
        const value = read(address, BAR0 + bar * 4)
        if value & 1 == 0 { return 0 }
        return value & 0xFFFC
    }

    // I/O space and bus mastering on (the device may then do DMA).
    pub fn enable(address: usize) -> void { write(address, COMMAND, (read(address, COMMAND) & 0xFFFF) | IO_SPACE | BUS_MASTER) }
}
