// Traps: the boot blob's common trap path calls brix_trap with the frame
// it made. System calls go to the system, page faults of the program's
// regions get their page; the program's other faults end it, the
// kernel's halt the processor.
const cpu = @import("./cpu.mlx")
const console = @import("./console.mlx")
const process = @import("./process.mlx")
const system = @import("./system.mlx")
const shell = @import("./shell.mlx")
const frame_module = @import("./frame.mlx")
const Frame = frame_module.Frame
const Exception = frame_module.Exception

export fn brix_trap(address: usize) -> void {
    const frame = Frame.at(address)
    const p = process.current()
    if frame.isSystemCall() {
        const outcome = system.system().handle(frame, p)
        if outcome.exit {
            console.out.write("brixOS: the shell exited (")
            console.out.decimal(outcome.status)
            console.out.write(")\n")
            shell.restart(frame)
        }
        return
    }
    if frame.*.vector == Exception.PAGE_FAULT && frame.fromUser() && p.fault(cpu.Cpu.faultAddress()) { return }
    // An interrupt (none is unmasked yet).
    if frame.*.vector >= Exception.COUNT { return }
    frame.report()
    if frame.fromUser() {
        console.out.write("brixOS: the shell was stopped\n")
        shell.restart(frame)
        return
    }
    while true { cpu.Cpu.wait() }
}
