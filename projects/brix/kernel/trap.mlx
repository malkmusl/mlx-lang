// Traps: the boot blob's common trap path calls brix_trap with the frame
// it made. System calls go to the system; a call that waits, or a
// process that ends, lets the next process run (its registers into the
// frame). Interrupts: the timer, in user mode, ends the time slice; the
// serial line's bytes go to the terminal (Ctrl-C: SIGINT to the
// foreground group). Page faults in a process's regions get their page;
// its other faults raise their signal (SIGSEGV, SIGILL, ...); the
// kernel's halt the processor. On the way back to user mode the
// process's signals are delivered: its handler, or the default action
// (a process ended: the next one runs; the shell is started again).
const cpu = @import("./cpu.mlx")
const console = @import("./console.mlx")
const scheduler = @import("./scheduler.mlx")
const system = @import("./linux/system.mlx")
const native = @import("./native/calls.mlx")
const call = @import("./call.mlx")
const status_module = @import("./status.mlx")
const shell = @import("./shell.mlx")
const wait = @import("./wait.mlx")
const frame_module = @import("./frame.mlx")
const Frame = frame_module.Frame
const Exception = frame_module.Exception
const Process = @import("./process.mlx").Process
const Status = scheduler.Status
const terminal = @import("./terminal.mlx")
const Irq = @import("./interrupts.mlx").Irq
const signals = @import("./signals.mlx")
const Signal = signals.Signal
const Signals = signals.Signals

export fn brix_trap(address: usize) -> void {
    const frame = Frame.at(address)
    handle(frame)
    // Back to user mode: the signals the process can take now.
    deliver(frame)
}

fn handle(frame: *Frame) -> void {
    const table = scheduler.processes()
    const p = table.running()
    if frame.isSystemCall() {
        const number = frame.*.rax
        // brixOS's own calls, or Linux's (the translation layer).
        if native.isNative(number) {
            after(frame, p, number, native.calls().handle(frame, p))
        } else {
            after(frame, p, number, system.system().handle(frame, p))
        }
        return
    }
    // A page fault in a process's memory (also the kernel's, writing to
    // a copy-on-write page of the process for a system call).
    if frame.*.vector == Exception.PAGE_FAULT && p.fault(cpu.Cpu.faultAddress(), frame.*.code & Exception.WRITE != 0) { return }
    const irq = Irq.of(frame.*.vector)
    if irq < Irq.COUNT {
        interrupt(frame, irq)
        return
    }
    if frame.*.vector >= Exception.COUNT { return }
    // A fault of the program: its signal (SIGSEGV, SIGILL, SIGFPE, ...),
    // which its handler may take; a report on the console when it ends
    // the program.
    if frame.fromUser() {
        const number = signals.ofException(frame.*.vector)
        const address = if frame.*.vector == Exception.PAGE_FAULT { cpu.Cpu.faultAddress() } else { frame.*.rip }
        p.*.signals.force(number, address)
        if !p.*.signals.caught(number) { frame.report() }
        return
    }
    frame.report()
    while true { cpu.Cpu.wait() }
}

// What follows a system call: the process goes on, waits (the next one
// runs), or ended.
fn after(frame: *Frame, p: *Process, number: usize, outcome: call.Outcome) -> void {
    const table = scheduler.processes()
    match outcome.kind {
        .done => {},
        .replaced => {},
        .blocked => next(frame, table.suspend(frame, outcome.waiting, number)),
        .yielded => next(frame, table.suspend(frame, wait.Wait.none(), number)),
        .exited => end(frame, p, outcome.status),
        .ended => next(frame, table.switchTo(frame))
    }
}

// The signals of the process returning to user mode in `frame`: its
// handler runs (on a frame on its stack), or the default action: nothing,
// the process stops (job control) or ends, and the next one runs, whose
// signals come in turn. The first process, the shell, is ended only by
// its faults (it starts again) and never stops.
fn deliver(frame: *Frame) -> void {
    const table = scheduler.processes()
    while frame.fromUser() {
        const p = table.running()
        const fault = p.*.signals.faulted()
        const number = p.*.signals.take()
        if number == 0 {
            p.*.signals.inCall = false
            return
        }
        if p.*.signals.caught(number) {
            const call = frame.*.rax
            p.*.signals.endCall(frame, number, call == system.Number.PAUSE || call == system.Number.RT_SIGSUSPEND)
            // A native call says so in its own status.
            if native.isNative(call) && frame.*.rax == @bitCast(usize, @intCast(isize, -4)) { frame.*.rax = @bitCast(usize, -status_module.Status.code(status_module.Status.interrupted)) }
            const base = p.*.signals.place(frame, number)
            if base != 0 && p.prepare(base, Signals.extent(base)) {
                p.*.signals.enter(frame, number, base)
                return
            }
            // No room for the frame (or no restorer): the program ends
            // as by SIGSEGV.
            end(frame, p, Status.killed(Signal.SEGV))
        } else if fault == number {
            end(frame, p, Status.killed(number))
        } else if p.*.pid == scheduler.Scheduler.FIRST_PID || p.*.signals.ignoredNow(number) {
            // Nothing (the shell neither ends nor stops by a signal).
        } else if p.*.signals.stopsNow(number) {
            p.*.signals.inCall = false
            next(frame, table.stop(frame, number))
        } else {
            end(frame, p, Status.killed(number))
        }
    }
}

// An interrupt: in the kernel (it waits in the idle loop) only taken
// note of; in user mode, the running process may give way.
fn interrupt(frame: *Frame, irq: usize) -> void {
    if Irq.spurious(irq) { return }
    const table = scheduler.processes()
    if irq == Irq.TIMER {
        Irq.acknowledge(irq)
        if frame.fromUser() { next(frame, table.preempt(frame)) }
        return
    }
    if irq == Irq.SERIAL {
        terminal.serialConsole().receive()
        Irq.acknowledge(irq)
        // Ctrl-C, Ctrl-\, Ctrl-Z: their signals to the foreground group
        // (delivered on the way back to user mode; in the idle loop, the
        // scheduler sends them).
        if frame.fromUser() { table.terminalSignals() }
        return
    }
    Irq.acknowledge(irq)
}

// The process `p` ended with `status`: the next one runs, or the shell
// starts again when it was the shell.
fn end(frame: *Frame, p: *Process, status: usize) -> void {
    if p.*.pid == scheduler.Scheduler.FIRST_PID {
        console.out.write("brixOS: the shell ended (")
        console.out.decimal(if status & 127 == 0 { status >> 8 } else { 128 + (status & 127) })
        console.out.write(")\n")
        shell.restart(frame)
        return
    }
    const table = scheduler.processes()
    table.terminate(p, status)
    next(frame, table.switchTo(frame))
}

// After a switch: when no process could run, the shell starts over.
fn next(frame: *Frame, switched: bool) -> void {
    if !switched { shell.restart(frame) }
}
