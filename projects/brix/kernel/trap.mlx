// Traps: the boot blob's stubs call brix_trap with the frame they made
// (layout: r15 .. rax, vector, error code, rip, cs, rflags, rsp, ss).
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const console = @import("./console.mlx")
const process = @import("./process.mlx")
const system = @import("./system.mlx")
const files = @import("./files.mlx")
const tty = @import("./tty.mlx")

pub const Frame = struct {
    r15: usize
    r14: usize
    r13: usize
    r12: usize
    r11: usize
    r10: usize
    r9: usize
    r8: usize
    rbp: usize
    rdi: usize
    rsi: usize
    rdx: usize
    rcx: usize
    rbx: usize
    rax: usize
    vector: usize
    code: usize
    rip: usize
    cs: usize
    rflags: usize
    rsp: usize
    ss: usize
}

fn name(vector: usize) -> []const u8 {
    if vector == 0 { return "divide error" }
    if vector == 1 { return "debug" }
    if vector == 2 { return "NMI" }
    if vector == 3 { return "breakpoint" }
    if vector == 4 { return "overflow" }
    if vector == 5 { return "bound range" }
    if vector == 6 { return "invalid opcode (a failed runtime check)" }
    if vector == 7 { return "no FPU" }
    if vector == 8 { return "double fault" }
    if vector == 10 { return "invalid TSS" }
    if vector == 11 { return "segment not present" }
    if vector == 12 { return "stack fault" }
    if vector == 13 { return "general protection" }
    if vector == 14 { return "page fault" }
    if vector == 16 { return "x87 error" }
    if vector == 17 { return "alignment check" }
    if vector == 18 { return "machine check" }
    if vector == 19 { return "SIMD error" }
    return "vector"
}

export fn brix_trap(address: usize) -> void {
    const frame: *Frame = unsafe { @ptrFromInt(*Frame, address) }
    const user = frame.*.cs & 3 == 3
    if frame.*.vector == layout.SYSCALL_VECTOR && user {
        const result = system.call(frame.*.rax, frame.*.rdi, frame.*.rsi, frame.*.rdx, frame.*.r10, frame.*.r8, frame.*.r9)
        if result.exit {
            console.write("brixOS: the shell exited (")
            console.decimal(result.status)
            console.write(")\n")
            restart(frame)
            return
        }
        frame.*.rax = @bitCast(usize, result.value)
        return
    }
    if frame.*.vector == 14 && user && process.fault(cpu.readCr2()) { return }
    if frame.*.vector >= 32 { return }
    if user {
        report(frame)
        console.write("brixOS: the shell was stopped\n")
        restart(frame)
        return
    }
    crash(frame)
}

// The program to run (and to run again when it ends): mlx-sh from the
// boot archive.
pub fn start() -> bool {
    files.init()
    tty.init()
    cpu.wrmsr(0xC0000100, 0)
    var arguments: [1][*]const u8 = undefined
    var environment: [6][*]const u8 = undefined
    unsafe {
        arguments[0] = @ptrCast([*]const u8, "mlx-sh\x00")
        environment[0] = @ptrCast([*]const u8, "HOME=/\x00")
        environment[1] = @ptrCast([*]const u8, "PATH=/\x00")
        environment[2] = @ptrCast([*]const u8, "PWD=/\x00")
        environment[3] = @ptrCast([*]const u8, "TERM=vt100\x00")
        environment[4] = @ptrCast([*]const u8, "USER=root\x00")
        environment[5] = @ptrCast([*]const u8, "SHELL=/mlx-sh\x00")
    }
    return process.load(arguments[0], 6, &arguments, 1, &environment, 6)
}

// The trap returns to a fresh start of the program.
fn restart(frame: *Frame) -> void {
    if !start() {
        console.write("brixOS: mlx-sh cannot start again\n")
        while true { cpu.wait() }
    }
    frame.*.r15 = 0
    frame.*.r14 = 0
    frame.*.r13 = 0
    frame.*.r12 = 0
    frame.*.r11 = 0
    frame.*.r10 = 0
    frame.*.r9 = 0
    frame.*.r8 = 0
    frame.*.rbp = 0
    frame.*.rdi = 0
    frame.*.rsi = 0
    frame.*.rdx = 0
    frame.*.rcx = 0
    frame.*.rbx = 0
    frame.*.rax = 0
    frame.*.rip = process.entry()
    frame.*.cs = layout.USER_CODE
    frame.*.rflags = 0x202
    frame.*.rsp = process.stack()
    frame.*.ss = layout.USER_DATA
}

// A trap nothing handles: what and where, then the processor halted.
pub fn crash(frame: *Frame) -> void {
    report(frame)
    while true { cpu.wait() }
}

fn report(frame: *Frame) -> void {
    console.write("\nbrixOS: ")
    console.write(name(frame.*.vector))
    console.write(" (")
    console.decimal(frame.*.vector)
    console.write(")")
    console.write(" at ")
    console.hex(frame.*.rip)
    console.write(if frame.*.cs & 3 == 3 { " (user)" } else { " (kernel)" })
    console.write(", error ")
    console.hex(frame.*.code)
    if frame.*.vector == 14 {
        console.write(", address ")
        console.hex(cpu.readCr2())
    }
    console.write("\n  rax ")
    console.hex(frame.*.rax)
    console.write(" rbx ")
    console.hex(frame.*.rbx)
    console.write(" rcx ")
    console.hex(frame.*.rcx)
    console.write(" rdx ")
    console.hex(frame.*.rdx)
    console.write("\n  rsi ")
    console.hex(frame.*.rsi)
    console.write(" rdi ")
    console.hex(frame.*.rdi)
    console.write(" rbp ")
    console.hex(frame.*.rbp)
    console.write(" rsp ")
    console.hex(frame.*.rsp)
    console.write("\n")
}
