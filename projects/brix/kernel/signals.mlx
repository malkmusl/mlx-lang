// Signals as Linux's x86-64 programs know them: what a process does with
// each (rt_sigaction: the default, ignore, or a handler), which it blocks
// (rt_sigprocmask), which wait for it (pending), its alternate stack
// (sigaltstack). A signal is delivered on the way back to user mode: the
// default action, or the handler on a frame as Linux builds it
// (rt_sigframe: the return address to the restorer, the ucontext with the
// registers and the mask, the siginfo, the SSE registers), which
// rt_sigreturn takes back.
const Frame = @import("./frame.mlx").Frame
const Sse = @import("./frame.mlx").Sse
const Bytes = @import("./bytes.mlx").Bytes
const layout = @import("../layout.mlx")
const Errno = @import("./linux/errno.mlx").Errno

// The numbers (Linux's), and what each does by default.
pub const Signal = struct {
    pub const ILL: usize = 4
    pub const TRAP: usize = 5
    pub const BUS: usize = 7
    pub const FPE: usize = 8
    pub const KILL: usize = 9
    pub const SEGV: usize = 11
    pub const CHLD: usize = 17
    pub const CONT: usize = 18
    pub const STOP: usize = 19
    pub const TSTP: usize = 20
    pub const TTIN: usize = 21
    pub const TTOU: usize = 22
    pub const URG: usize = 23
    pub const WINCH: usize = 28
    // 1 to 64.
    pub const COUNT: usize = 65

    pub fn valid(number: usize) -> bool { return number >= 1 && number < COUNT }

    pub fn bit(number: usize) -> usize {
        const one: usize = 1
        return one << @intCast(u6, number - 1)
    }

    // Neither caught, blocked nor ignored.
    pub fn unblockable() -> usize { return bit(KILL) | bit(STOP) }

    // Ignored by default.
    pub fn ignoredByDefault(number: usize) -> bool { return number == CHLD || number == CONT || number == URG || number == WINCH }

    // Stopping by default (job control).
    pub fn stopsByDefault(number: usize) -> bool { return number == STOP || number == TSTP || number == TTIN || number == TTOU }

    pub fn stops() -> usize { return bit(STOP) | bit(TSTP) | bit(TTIN) | bit(TTOU) }
}

// The signal a processor exception raises in user mode.
pub fn ofException(vector: usize) -> usize {
    if vector == 0 || vector == 16 || vector == 19 { return Signal.FPE }
    if vector == 1 || vector == 3 { return Signal.TRAP }
    if vector == 6 { return Signal.ILL }
    if vector == 17 { return Signal.BUS }
    return Signal.SEGV
}

// sigaction's fields (the kernel's layout: 32 bytes).
pub const Action = struct {
    pub const DEFAULT: usize = 0
    pub const IGNORE: usize = 1
    pub const SIZE: usize = 32
    // Flags.
    pub const ONSTACK: usize = 0x08000000
    pub const RESTORER: usize = 0x04000000
    pub const RESTART: usize = 0x10000000
    pub const NODEFER: usize = 0x40000000
    pub const RESETHAND: usize = 0x80000000

    handler: usize
    flags: usize
    restorer: usize
    mask: usize
}

// sigprocmask's how.
pub const BLOCK: usize = 0
pub const UNBLOCK: usize = 1
pub const SET_MASK: usize = 2

// A process's signals.
pub const Signals = struct {
    // stack_t's flags.
    pub const ON_STACK: usize = 1
    pub const DISABLE: usize = 2
    pub const MIN_STACK: usize = 2048
    // The frame (rt_sigframe): the return address, the ucontext (flags,
    // link, stack_t, sigcontext of 256 bytes, the mask), the siginfo.
    const UCONTEXT: usize = 8
    const SIGCONTEXT: usize = UCONTEXT + 40
    const MASK: usize = UCONTEXT + 296
    const INFO: usize = UCONTEXT + 304
    const INFO_SIZE: usize = 128
    pub const FRAME_SIZE: usize = INFO + INFO_SIZE
    const RED_ZONE: usize = 128
    const ALIGN_64: usize = 0xFFFFFFFFFFFFFFC0
    const ALIGN_16: usize = 0xFFFFFFFFFFFFFFF0
    // TF and DF, clear in a handler.
    const TRAP_DIRECTION: usize = 0x500
    // The flags a handler's return may set (CF PF AF ZF SF TF DF OF, AC).
    const USER_FLAGS: usize = 0x40DD5
    const IF_FLAG: usize = 0x202
    // siginfo's si_code.
    pub const FROM_USER: usize = 0
    pub const FROM_KERNEL: usize = 0x80

    actions: [Signal.COUNT]Action
    pending: usize
    blocked: usize
    // rt_sigsuspend's mask is in effect: the one before is `kept`, put
    // back when a handler returns.
    suspended: bool
    kept: usize
    // The process waits in a system call (its registers at the SYSCALL,
    // to make it again): a handler without SA_RESTART ends it with EINTR.
    inCall: bool
    // sigaltstack.
    stackBase: usize
    stackSize: usize
    // Who sent each pending signal (the siginfo's pid), and a fault's
    // address.
    senders: [Signal.COUNT]u32
    faultAddress: usize
    // The signal the last fault raised.
    forced: usize

    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < Signal.COUNT {
            self.*.actions[k] = Action.{ .handler = Action.DEFAULT, .flags = 0, .restorer = 0, .mask = 0 }
            self.*.senders[k] = 0
            k += 1
        }
        self.*.pending = 0
        self.*.blocked = 0
        self.*.suspended = false
        self.*.kept = 0
        self.*.inCall = false
        self.*.stackBase = 0
        self.*.stackSize = 0
        self.*.faultAddress = 0
        self.*.forced = 0
    }

    // A fork's child: the actions, the mask and the alternate stack;
    // nothing pending.
    pub fn inherit(self: *Self, parent: *const Self) -> void {
        self.init()
        var k: usize = 0
        while k < Signal.COUNT {
            self.*.actions[k] = parent.*.actions[k]
            k += 1
        }
        self.*.blocked = if parent.*.suspended { parent.*.kept } else { parent.*.blocked }
        self.*.stackBase = parent.*.stackBase
        self.*.stackSize = parent.*.stackSize
    }

    // execve: handlers back to the default (ignored signals stay
    // ignored), no alternate stack; the mask and what is pending stay.
    pub fn exec(self: *Self) -> void {
        var k: usize = 1
        while k < Signal.COUNT {
            const a = &self.*.actions[k]
            if a.*.handler != Action.IGNORE { a.*.handler = Action.DEFAULT }
            a.*.flags = 0
            a.*.restorer = 0
            a.*.mask = 0
            k += 1
        }
        self.*.stackBase = 0
        self.*.stackSize = 0
    }

    fn ignores(self: *const Self, number: usize) -> bool {
        const handler = self.*.actions[number].handler
        return handler == Action.IGNORE || (handler == Action.DEFAULT && Signal.ignoredByDefault(number))
    }

    // Whether delivering `number` does nothing (it is ignored).
    pub fn ignoredNow(self: *const Self, number: usize) -> bool { return self.ignores(number) }

    // Whether delivering `number` stops the process (the default of
    // job control's signals).
    pub fn stopsNow(self: *const Self, number: usize) -> bool { return self.*.actions[number].handler == Action.DEFAULT && Signal.stopsByDefault(number) }

    // The signal a fault raised that is still pending; 0 when none is.
    pub fn faulted(self: *const Self) -> usize {
        if self.*.forced == 0 || self.*.pending & Signal.bit(self.*.forced) == 0 { return 0 }
        return self.*.forced
    }

    // `number` sent by `sender` (0: the kernel): pending, unless it is
    // ignored and not blocked (then it is lost, as on Linux).
    pub fn post(self: *Self, number: usize, sender: usize) -> void {
        if !Signal.valid(number) { return }
        // A continuation drops the stops that wait, a stop the
        // continuation.
        if number == Signal.CONT { self.*.pending &= ~Signal.stops() }
        if Signal.stopsByDefault(number) { self.*.pending &= ~Signal.bit(Signal.CONT) }
        if self.ignores(number) && self.*.blocked & Signal.bit(number) == 0 { return }
        self.*.pending |= Signal.bit(number)
        self.*.senders[number] = @intCast(u32, sender)
    }

    // A fault's signal: it cannot be ignored or blocked (the default
    // action then: the process ends).
    pub fn force(self: *Self, number: usize, address: usize) -> void {
        const a = &self.*.actions[number]
        if a.*.handler == Action.IGNORE || self.*.blocked & Signal.bit(number) != 0 {
            a.*.handler = Action.DEFAULT
            self.*.blocked &= ~Signal.bit(number)
        }
        self.*.pending |= Signal.bit(number)
        self.*.senders[number] = 0
        self.*.faultAddress = address
        self.*.forced = number
    }

    // The signals that can be delivered now.
    pub fn deliverable(self: *const Self) -> usize { return self.*.pending & ~(self.*.blocked & ~Signal.unblockable()) }

    // The lowest deliverable signal, taken out of what is pending; 0 when
    // none is.
    pub fn take(self: *Self) -> usize {
        const ready = self.deliverable()
        if ready == 0 { return 0 }
        var number: usize = 1
        while ready & Signal.bit(number) == 0 { number += 1 }
        self.*.pending &= ~Signal.bit(number)
        if number == self.*.forced { self.*.forced = 0 }
        return number
    }

    // The lowest pending signal of `set`, taken out; 0 when none is
    // (rt_sigtimedwait).
    pub fn takeOf(self: *Self, set: usize) -> usize {
        const ready = self.*.pending & set
        if ready == 0 { return 0 }
        var number: usize = 1
        while ready & Signal.bit(number) == 0 { number += 1 }
        self.*.pending &= ~Signal.bit(number)
        return number
    }

    pub fn setMask(self: *Self, mask: usize) -> void { self.*.blocked = mask & ~Signal.unblockable() }

    // rt_sigaction's new action for `number`; an ignored one drops what
    // is pending of it.
    pub fn setAction(self: *Self, number: usize, action: Action) -> void {
        self.*.actions[number] = action
        if self.ignores(number) { self.*.pending &= ~Signal.bit(number) }
    }

    // rt_sigsuspend: `mask` until a handler runs.
    pub fn suspend(self: *Self, mask: usize) -> void {
        if self.*.suspended { return }
        self.*.kept = self.*.blocked
        self.setMask(mask)
        self.*.suspended = true
    }

    pub fn onStack(self: *const Self, sp: usize) -> bool { return self.*.stackSize != 0 && sp > self.*.stackBase && sp <= self.*.stackBase + self.*.stackSize }

    // Whether `number` has a handler that can run (one with a restorer to
    // return by).
    pub fn caught(self: *const Self, number: usize) -> bool {
        const a = self.*.actions[number]
        return a.handler != Action.DEFAULT && a.handler != Action.IGNORE
    }

    // Before a handler of `number` runs: the system call the process
    // waited in ends with EINTR, unless the handler restarts it (`always`:
    // pause and sigsuspend, which a handler always ends).
    pub fn endCall(self: *Self, frame: *Frame, number: usize, always: bool) -> void {
        if !self.*.inCall { return }
        self.*.inCall = false
        if always || self.*.actions[number].flags & Action.RESTART == 0 {
            frame.*.rax = @bitCast(usize, Errno.EINTR)
            frame.*.rip += 2
        }
    }

    // Where the frame for a handler of `number` goes (its SSE registers
    // above it: `extent` bytes from there): below the
    // red zone, or at the top of the alternate stack (SA_ONSTACK, when
    // not on it yet); 0 when the handler has no restorer.
    pub fn place(self: *const Self, frame: *const Frame, number: usize) -> usize {
        const action = self.*.actions[number]
        if action.flags & Action.RESTORER == 0 { return 0 }
        var sp = frame.*.rsp - RED_ZONE
        if action.flags & Action.ONSTACK != 0 && self.*.stackSize != 0 && !self.onStack(frame.*.rsp) { sp = self.*.stackBase + self.*.stackSize }
        const sse = (sp - Sse.SIZE) & ALIGN_64
        return ((sse - FRAME_SIZE) & ALIGN_16) - 8
    }

    // The bytes of a frame at `base`, its SSE registers included.
    pub fn extent(base: usize) -> usize { return sseOf(base) + Sse.SIZE - base }

    fn sseOf(base: usize) -> usize { return (base + 8 + FRAME_SIZE + 63) & ALIGN_64 }

    // The handler of `number` runs on return (`frame`: the process's
    // registers), its frame at `base` (place's, writable).
    pub fn enter(self: *Self, frame: *Frame, number: usize, base: usize) -> void {
        const action = self.*.actions[number]
        const sse = sseOf(base)
        const f = Bytes.pointer(base)
        Bytes.fill(f, FRAME_SIZE, 0)
        Bytes.write64(f, 0, action.restorer)
        // uc_stack.
        Bytes.write64(f, UCONTEXT + 16, self.*.stackBase)
        Bytes.write32(f, UCONTEXT + 24, if self.*.stackSize == 0 { DISABLE } else if self.onStack(base) { ON_STACK } else { 0 })
        Bytes.write64(f, UCONTEXT + 32, self.*.stackSize)
        // The sigcontext: r8 to r15, rdi, rsi, rbp, rbx, rdx, rax, rcx,
        // rsp, rip, eflags, cs gs fs ss, err, trapno, oldmask, cr2, the
        // SSE registers' address.
        const c = SIGCONTEXT
        Bytes.write64(f, c + 0, frame.*.r8)
        Bytes.write64(f, c + 8, frame.*.r9)
        Bytes.write64(f, c + 16, frame.*.r10)
        Bytes.write64(f, c + 24, frame.*.r11)
        Bytes.write64(f, c + 32, frame.*.r12)
        Bytes.write64(f, c + 40, frame.*.r13)
        Bytes.write64(f, c + 48, frame.*.r14)
        Bytes.write64(f, c + 56, frame.*.r15)
        Bytes.write64(f, c + 64, frame.*.rdi)
        Bytes.write64(f, c + 72, frame.*.rsi)
        Bytes.write64(f, c + 80, frame.*.rbp)
        Bytes.write64(f, c + 88, frame.*.rbx)
        Bytes.write64(f, c + 96, frame.*.rdx)
        Bytes.write64(f, c + 104, frame.*.rax)
        Bytes.write64(f, c + 112, frame.*.rcx)
        Bytes.write64(f, c + 120, frame.*.rsp)
        Bytes.write64(f, c + 128, frame.*.rip)
        Bytes.write64(f, c + 136, frame.*.rflags)
        Bytes.write16(f, c + 144, frame.*.cs)
        Bytes.write16(f, c + 150, frame.*.ss)
        Bytes.write64(f, c + 152, frame.*.code)
        Bytes.write64(f, c + 160, frame.*.vector)
        const mask = if self.*.suspended { self.*.kept } else { self.*.blocked }
        Bytes.write64(f, c + 168, mask)
        Bytes.write64(f, c + 176, self.*.faultAddress)
        Bytes.write64(f, c + 184, sse)
        Bytes.write64(f, MASK, mask)
        // The siginfo: signo, errno, code, then the sender's pid (or the
        // fault's address).
        Bytes.write32(f, INFO, number)
        const sender = @intCast(usize, self.*.senders[number])
        Bytes.write32(f, INFO + 8, if sender == 0 { FROM_KERNEL } else { FROM_USER })
        if sender != 0 { Bytes.write32(f, INFO + 16, sender) } else { Bytes.write64(f, INFO + 16, self.*.faultAddress) }
        Bytes.copy(Bytes.pointer(sse), frame.sse(), Sse.SIZE)
        // The handler: (number, siginfo, ucontext), returning to the
        // restorer; the default SSE state, DF and TF clear.
        frame.*.rsp = base
        frame.*.rip = action.handler
        frame.*.rdi = number
        frame.*.rsi = base + INFO
        frame.*.rdx = base + UCONTEXT
        frame.*.rax = 0
        frame.*.rflags = frame.*.rflags & ~TRAP_DIRECTION
        Sse.reset(frame.sse())
        self.*.suspended = false
        var during = self.*.blocked | action.mask
        if action.flags & Action.NODEFER == 0 { during |= Signal.bit(number) }
        self.setMask(during)
        if action.flags & Action.RESETHAND != 0 { self.*.actions[number].handler = Action.DEFAULT }
    }

    // rt_sigreturn's frame: the ucontext at `frame.rsp` (the handler
    // returned past the return address); FRAME_SIZE - 8 bytes from there.
    pub fn frameOf(frame: *const Frame) -> usize { return frame.*.rsp - UCONTEXT + 8 }

    // The address of the SSE registers the frame at `uc` keeps.
    pub fn savedSse(uc: usize) -> usize { return Bytes.read64(Bytes.pointer(uc), SIGCONTEXT - UCONTEXT + 184) }

    // rt_sigreturn: the registers, the SSE registers (when `sseReadable`)
    // and the mask the frame at `uc` (frameOf's, readable) holds.
    pub fn leave(self: *Self, frame: *Frame, uc: usize, sseReadable: bool) -> void {
        const f = Bytes.pointer(uc - UCONTEXT)
        const c = SIGCONTEXT
        frame.*.r8 = Bytes.read64(f, c + 0)
        frame.*.r9 = Bytes.read64(f, c + 8)
        frame.*.r10 = Bytes.read64(f, c + 16)
        frame.*.r11 = Bytes.read64(f, c + 24)
        frame.*.r12 = Bytes.read64(f, c + 32)
        frame.*.r13 = Bytes.read64(f, c + 40)
        frame.*.r14 = Bytes.read64(f, c + 48)
        frame.*.r15 = Bytes.read64(f, c + 56)
        frame.*.rdi = Bytes.read64(f, c + 64)
        frame.*.rsi = Bytes.read64(f, c + 72)
        frame.*.rbp = Bytes.read64(f, c + 80)
        frame.*.rbx = Bytes.read64(f, c + 88)
        frame.*.rdx = Bytes.read64(f, c + 96)
        frame.*.rax = Bytes.read64(f, c + 104)
        frame.*.rcx = Bytes.read64(f, c + 112)
        frame.*.rsp = Bytes.read64(f, c + 120)
        frame.*.rip = Bytes.read64(f, c + 128)
        frame.*.rflags = (Bytes.read64(f, c + 136) & USER_FLAGS) | IF_FLAG
        frame.*.cs = layout.Selector.USER_CODE
        frame.*.ss = layout.Selector.USER_DATA
        if sseReadable {
            Bytes.copy(frame.sse(), Bytes.pointer(Bytes.read64(f, c + 184)), Sse.SIZE)
            // A MXCSR with reserved bits set would fault in FXRSTOR.
            Bytes.write32(frame.sse(), 24, Bytes.read32(frame.sse(), 24) & 0xFFFF)
        } else {
            Sse.reset(frame.sse())
        }
        self.setMask(Bytes.read64(f, MASK))
    }
}
