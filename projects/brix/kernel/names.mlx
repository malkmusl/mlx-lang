// Changes of the tree by name: a directory and a name in it on each side.
// The core's, for both interfaces: the native node_rename and snapshot
// (native/nodes.mlx), Linux's rename and SNAPSHOT (linux/filecalls.mlx).
const vfs = @import("./vfs.mlx")
const volume = @import("./volume.mlx")
const Status = @import("./status.mlx").Status

const Vfs = vfs.Vfs

pub fn isDot(name: []const u8) -> bool { return (name.length == 1 && name[0] == 46) || (name.length == 2 && name[0] == 46 && name[1] == 46) }

// read_only when `directory` is part of a read-only snapshot, else 0.
pub fn changeable(directory: usize) -> isize { return if vfs.fileSystem().node(directory).*.readOnly { Status.read_only } else { 0 } }

// `oldName` in `from` becomes `newName` in `to`; what `newName` named is
// replaced (a directory by a directory, when empty), unless `noReplace`.
pub fn rename(from: usize, oldName: []const u8, to: usize, newName: []const u8, noReplace: bool) -> isize {
    const tree = vfs.fileSystem()
    if oldName.length == 0 || newName.length == 0 || isDot(oldName) || isDot(newName) { return Status.busy }
    const source = tree.lookup(from, oldName.pointer, oldName.length)
    if source == Vfs.NONE { return Status.not_found }
    if changeable(from) < 0 || changeable(to) < 0 { return Status.read_only }
    if !tree.permits(from, Vfs.WRITE) || !tree.permits(to, Vfs.WRITE) { return Status.denied }
    const sourceIsDirectory = tree.node(source).isDirectory()
    // A directory does not go under itself.
    if sourceIsDirectory && tree.isUnder(to, source) { return Status.invalid }
    const existing = tree.lookup(to, newName.pointer, newName.length)
    if existing == source { return 0 }
    if existing != Vfs.NONE {
        if noReplace { return Status.exists }
        const target = tree.node(existing)
        if sourceIsDirectory && !target.isDirectory() { return Status.not_directory }
        if !sourceIsDirectory && target.isDirectory() { return Status.is_directory }
        if target.isDirectory() && !tree.isEmpty(existing) { return Status.not_empty }
        const removed = tree.unlink(to, newName.pointer, newName.length)
        if removed < 0 { return removed }
    }
    const linked = tree.link(to, newName.pointer, newName.length, source)
    if linked < 0 { return linked }
    return tree.unlink(from, oldName.pointer, oldName.length)
}

// A copy of the tree `source` named `name` in `directory`, its files
// sharing their pages with the originals; read-only when `readOnly`. The
// disk's volume into /volumes: a snapshot on the disk (an old root kept),
// read-only only.
pub fn snapshot(source: usize, directory: usize, name: []const u8, readOnly: bool) -> isize {
    const tree = vfs.fileSystem()
    if name.length == 0 || isDot(name) { return Status.exists }
    if tree.lookup(directory, name.pointer, name.length) != Vfs.NONE { return Status.exists }
    if volume.store().isCurrentRoot(source) && directory == tree.lookup(Vfs.ROOT, "volumes".pointer, 7) {
        if !readOnly { return Status.invalid }
        return volume.store().snapshot(name.pointer, name.length)
    }
    if changeable(directory) < 0 { return Status.read_only }
    if !tree.permits(directory, Vfs.WRITE) { return Status.denied }
    const made = tree.cloneTree(source, readOnly)
    if made == Vfs.NONE { return Status.no_space }
    const linked = tree.link(directory, name.pointer, name.length, made)
    if linked < 0 { tree.removeTree(made) }
    return linked
}
