// Linux's error numbers, as system calls return them (negated): the Linux
// layer's own, and the core's Status turned into them (ofStatus).
const Status = @import("../status.mlx").Status

pub const Errno = struct {
    pub const EPERM: isize = -1
    pub const ENOENT: isize = -2
    pub const ESRCH: isize = -3
    pub const EINTR: isize = -4
    pub const EIO: isize = -5
    pub const ENOEXEC: isize = -8
    pub const EBADF: isize = -9
    pub const ECHILD: isize = -10
    pub const EAGAIN: isize = -11
    pub const ENOMEM: isize = -12
    pub const EACCES: isize = -13
    pub const EFAULT: isize = -14
    pub const ENODEV: isize = -19
    pub const ENOTDIR: isize = -20
    pub const EISDIR: isize = -21
    pub const EINVAL: isize = -22
    pub const ENFILE: isize = -23
    pub const EMFILE: isize = -24
    pub const ENOTTY: isize = -25
    pub const ESPIPE: isize = -29
    pub const EROFS: isize = -30
    pub const EPIPE: isize = -32
    pub const ERANGE: isize = -34
    pub const ENAMETOOLONG: isize = -36
    pub const ELOOP: isize = -40
    pub const ENOSYS: isize = -38
    pub const EEXIST: isize = -17
    pub const EXDEV: isize = -18
    pub const EBUSY: isize = -16
    pub const EFBIG: isize = -27
    pub const ENOSPC: isize = -28
    pub const ENOTEMPTY: isize = -39
    pub const ETIMEDOUT: isize = -110

    // A core Status as Linux's error number (a result that is no Status
    // stays as it is).
    pub fn ofStatus(result: isize) -> isize {
        if !Status.isStatus(result) { return result }
        if result == Status.invalid_handle || result == Status.no_right { return EBADF }
        if result == Status.wrong_kind { return ESPIPE }
        if result == Status.would_block { return EAGAIN }
        if result == Status.timed_out { return ETIMEDOUT }
        if result == Status.not_found { return ENOENT }
        if result == Status.exists { return EEXIST }
        if result == Status.no_memory { return ENOMEM }
        if result == Status.bad_address { return EFAULT }
        if result == Status.peer_gone { return EPIPE }
        if result == Status.interrupted { return EINTR }
        if result == Status.not_directory { return ENOTDIR }
        if result == Status.is_directory { return EISDIR }
        if result == Status.not_empty { return ENOTEMPTY }
        if result == Status.read_only { return EROFS }
        if result == Status.too_large { return EFBIG }
        if result == Status.unsupported { return ENOSYS }
        if result == Status.busy { return EBUSY }
        if result == Status.denied { return EACCES }
        if result == Status.too_many { return EMFILE }
        if result == Status.link_loop { return ELOOP }
        if result == Status.no_space { return ENOSPC }
        if result == Status.io_error { return EIO }
        if result == Status.cross_volume { return EXDEV }
        if result == Status.name_too_long { return ENAMETOOLONG }
        return EINVAL
    }
}
