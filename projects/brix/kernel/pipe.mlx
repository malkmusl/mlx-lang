// Pipes: a ring buffer each, with the number of descriptors that read and
// write it (a pipe whose writers are gone reads as its end, one whose
// readers are gone fails writes with EPIPE). A FIFO's pipe starts with
// neither: until its first writer a read waits, until its first reader a
// write does.

pub const Pipe = struct {
    pub const CAPACITY: usize = 4096

    buffer: [CAPACITY]u8
    head: usize
    count: usize
    readers: usize
    writers: usize
    // Whether it had a reader, a writer (a FIFO's pipe waits for them).
    hadReader: bool
    hadWriter: bool
    // The FIFO it is the pipe of (its node + 1; 0: pipe(2)'s).
    fifo: usize

    pub fn isFree(self: *const Self) -> bool { return self.*.readers == 0 && self.*.writers == 0 }

    // Whether a read would not wait: bytes, or no writer left.
    pub fn readable(self: *const Self) -> bool { return self.*.count > 0 || self.ended() }

    // Whether a write would not wait: room for a reader, or no reader left.
    pub fn writable(self: *const Self) -> bool { return self.broken() || (self.*.readers > 0 && self.*.count < CAPACITY) }

    // The writers gone (reads see the end), the readers gone (writes fail).
    pub fn ended(self: *const Self) -> bool { return self.*.writers == 0 && self.*.hadWriter }

    pub fn broken(self: *const Self) -> bool { return self.*.readers == 0 && self.*.hadReader }

    pub fn read(self: *Self, into: [*]u8, capacity: usize) -> usize {
        var done: usize = 0
        while done < capacity && self.*.count > 0 {
            into[done] = self.*.buffer[self.*.head]
            self.*.head = (self.*.head + 1) % CAPACITY
            self.*.count -= 1
            done += 1
        }
        return done
    }

    pub fn write(self: *Self, from: [*]const u8, length: usize) -> usize {
        var done: usize = 0
        while done < length && self.*.count < CAPACITY {
            self.*.buffer[(self.*.head + self.*.count) % CAPACITY] = from[done]
            self.*.count += 1
            done += 1
        }
        return done
    }
}

pub const Pipes = struct {
    pub const MAX: usize = 32

    pipes: [MAX]Pipe
    // Counts every change of a pipe (and of the terminal's input), for
    // poll's waits.
    events: usize

    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.pipes[k].head = 0
            self.*.pipes[k].count = 0
            self.*.pipes[k].readers = 0
            self.*.pipes[k].writers = 0
            self.*.pipes[k].fifo = 0
            k += 1
        }
        self.*.events = 0
    }

    // A new pipe with one reader and one writer: its index, MAX when
    // every pipe is in use.
    pub fn create(self: *Self) -> usize {
        var k: usize = 0
        while k < MAX {
            const pipe = &self.*.pipes[k]
            if pipe.isFree() {
                pipe.*.head = 0
                pipe.*.count = 0
                pipe.*.readers = 1
                pipe.*.writers = 1
                pipe.*.hadReader = true
                pipe.*.hadWriter = true
                pipe.*.fifo = 0
                return k
            }
            k += 1
        }
        return MAX
    }

    // The pipe of the FIFO `node` (the one it has while open, else a new
    // one with no reader and no writer yet); MAX when none is free.
    pub fn ofFifo(self: *Self, node: usize, current: usize) -> usize {
        if current != 0 && !self.*.pipes[current - 1].isFree() && self.*.pipes[current - 1].fifo == node + 1 { return current - 1 }
        var k: usize = 0
        while k < MAX {
            const pipe = &self.*.pipes[k]
            if pipe.isFree() {
                pipe.*.head = 0
                pipe.*.count = 0
                pipe.*.hadReader = false
                pipe.*.hadWriter = false
                pipe.*.fifo = node + 1
                return k
            }
            k += 1
        }
        return MAX
    }

    pub fn at(self: *Self, index: usize) -> *Pipe { return &self.*.pipes[index] }

    pub fn changed(self: *Self) -> void { self.*.events += 1 }
}

var all: Pipes = undefined // (per run)

pub fn table() -> *Pipes { return &all }
