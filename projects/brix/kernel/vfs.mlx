// The file system: one tree of nodes in memory (a tmpfs). brixOS's own
// layout, by what things are rather than by Unix's history:
//
//   /system/programs   the boot archive's programs (nodes over its bytes,
//                      copied into pages of their own when written)
//   /system/settings   the system's settings (users, groups)
//   /devices           console, tty, null, zero, disk0 (a virtio disk)
//   /users/root        the user's home
//   /temporary         scratch space
//   /volumes           the disks' volumes (brixfs, volume.mlx): disk0,
//                      and its snapshots by their names; or disk0 as
//                      ext2 (ext2.mlx, read-only)
//
// (Linux programs' /dev, /tmp, /etc/passwd and /proc/self/exe are mapped
// onto these by the system call layer, filecalls.mlx; they are not in the
// tree.)
//
// A node's data is in pages (4 KiB frames): DIRECT of them by the node,
// then a page of 512 page addresses (indirect), then a page of 512 such
// pages (double indirect): up to about 1 GiB a file. A directory's data is
// its entries, ENTRY_SIZE bytes each (the node, the name's length, the
// name); a free entry has node 0. Nodes live while a directory names them
// (links) or a descriptor holds them (opens).
const layout = @import("../layout.mlx")
const memory = @import("./memory.mlx")
const archive = @import("./archive.mlx")
const clock = @import("./clock.mlx")
const Bytes = @import("./bytes.mlx").Bytes
const Status = @import("./status.mlx").Status
const volume = @import("./volume.mlx")
const ext2 = @import("./ext2.mlx")
const Page = memory.Page

// A symbolic link holds its target as its data; a FIFO (named pipe) a
// pipe while it is open.
pub const NodeKind = enum(u8) { free, directory, file, archive, terminal, null_device, zero_device, disk, symlink, fifo }

// A node's room in its chunk (@sizeOf(Node) fits it).
pub const NODE_SIZE: usize = 256

pub const Node = struct {
    pub const DIRECT: usize = 12

    kind: NodeKind
    // Permission bits (and set-id, sticky).
    mode: usize
    links: usize
    opens: usize
    size: usize
    // A directory's parent (the root's is itself).
    parent: usize
    blocks: [DIRECT]usize
    indirect: usize
    doubleIndirect: usize
    // The archive's file (kind archive).
    archiveIndex: usize
    // A FIFO's pipe while it is open (its index + 1; 0: none).
    pipe: usize
    // Seconds since 1970.
    accessed: usize
    modified: usize
    changed: usize
    // Its owner and group (users and groups by number, 0 the system's).
    user: usize
    group: usize
    // A directory's index of its entries by name (a frame of hash slots
    // naming entry slots; 0: none, made at the first lookup of a big
    // directory, dropped with its entries).
    index: usize
    // Part of a read-only snapshot: neither it nor (a directory) what it
    // names changes.
    readOnly: bool
    // On a disk: its view of a volume (1 on; 0: memory only), its inode
    // there, whether its data was read from the disk yet, and what changed
    // since the last commit (its inode, its data).
    volume: usize
    diskInode: usize
    loaded: bool
    dirty: bool
    dataDirty: bool

    pub fn isDirectory(self: *const Self) -> bool { return self.*.kind == NodeKind.directory }

    pub fn isLink(self: *const Self) -> bool { return self.*.kind == NodeKind.symlink }

    // Whether its data is pages of its own (a file, a directory, a link).
    pub fn hasPages(self: *const Self) -> bool { return self.*.kind == NodeKind.file || self.*.kind == NodeKind.directory || self.*.kind == NodeKind.symlink }

    // Whether it holds bytes (a file, or an archive's file).
    pub fn isRegular(self: *const Self) -> bool { return self.*.kind == NodeKind.file || self.*.kind == NodeKind.archive }
}

pub const Vfs = struct {
    // Nodes come in chunks of a page (NODES_PER_CHUNK each), made as
    // they are needed: the table has no fixed size (CHUNKS pages at the
    // most, 65536 nodes; the budget, below, keeps it a cache).
    pub const NODES_PER_CHUNK: usize = 16
    pub const CHUNKS: usize = 4096
    pub const NAME_MAX: usize = 59
    pub const ENTRY_SIZE: usize = 64
    pub const ROOT: usize = 1
    pub const NONE: usize = 0
    const ENTRIES_PER_PAGE: usize = 4096 / 64
    const ADDRESSES_PER_PAGE: usize = 512
    // A data page's slot holds its address and, in its low bit, whether
    // it changed since its node was last committed to a disk (only a
    // disk's nodes are marked).
    const CHANGED: usize = 1
    const ADDRESS: usize = ~(Page.SIZE - 1)

    chunks: [CHUNKS]usize
    // How many nodes the chunks hold (node indices below it are valid).
    count: usize
    // Whose calls these are (the running process's user and group; the
    // kernel's own are the system's, 0): what permits checks.
    actorUser: usize
    actorGroup: usize
    console: usize

    // ---- nodes ----

    pub fn node(self: *Self, index: usize) -> *Node {
        return unsafe { @ptrFromInt(*Node, layout.Memory.virtual(self.*.chunks[index / NODES_PER_CHUNK]) + (index % NODES_PER_CHUNK) * NODE_SIZE) }
    }

    // How many nodes there are (free ones among them); indices below it
    // name nodes.
    pub fn nodeCount(self: *const Self) -> usize { return self.*.count }

    // One chunk of nodes more (free); false when memory is out or the
    // table cannot grow further.
    fn grow(self: *Self) -> bool {
        const chunk = self.*.count / NODES_PER_CHUNK
        if chunk >= CHUNKS { return false }
        const frame = memory.allFrames().allocate()
        if frame == 0 { return false }
        self.*.chunks[chunk] = frame
        self.*.count += NODES_PER_CHUNK
        var k = self.*.count - NODES_PER_CHUNK
        while k < self.*.count {
            self.node(k).*.kind = NodeKind.free
            k += 1
        }
        return true
    }

    // How many nodes the tree keeps loaded at the most before idle time
    // lets clean ones read from a disk go (a cache: a node for every 256
    // KiB of memory, 512 at least); more are made when programs hold them.
    pub fn nodeBudget(self: *const Self) -> usize {
        const scaled = memory.allFrames().totalBytes() / (256 * 1024)
        return if scaled < 512 { 512 } else { scaled }
    }

    // How many nodes are in use.
    pub fn usedNodes(self: *Self) -> usize {
        var used: usize = 0
        var k: usize = ROOT
        while k < self.*.count {
            if self.node(k).*.kind != NodeKind.free { used += 1 }
            k += 1
        }
        return used
    }

    fn now() -> usize { return clock.system().realtime() / clock.Clock.NANOSECONDS }

    // A new node of `kind` (no links yet); NONE when memory is out.
    pub fn create(self: *Self, kind: NodeKind, mode: usize) -> usize {
        var k: usize = ROOT
        while k <= self.*.count {
            if k == self.*.count && !self.grow() { return NONE }
            const n = self.node(k)
            if n.*.kind == NodeKind.free {
                n.*.kind = kind
                n.*.mode = mode & 0xFFF
                n.*.links = 0
                n.*.opens = 0
                n.*.size = 0
                n.*.parent = k
                var b: usize = 0
                while b < Node.DIRECT {
                    n.*.blocks[b] = 0
                    b += 1
                }
                n.*.indirect = 0
                n.*.doubleIndirect = 0
                n.*.archiveIndex = 0
                n.*.user = 0
                n.*.group = 0
                n.*.index = 0
                n.*.pipe = 0
                n.*.readOnly = false
                n.*.volume = 0
                n.*.diskInode = 0
                n.*.loaded = true
                n.*.dirty = false
                n.*.dataDirty = false
                const time = now()
                n.*.accessed = time
                n.*.modified = time
                n.*.changed = time
                return k
            }
            k += 1
        }
        return NONE
    }

    // A descriptor holds the node, or lets it go; a node no directory
    // names and no descriptor holds is freed.
    pub fn retain(self: *Self, index: usize) -> void { self.node(index).*.opens += 1 }

    pub fn release(self: *Self, index: usize) -> void {
        const n = self.node(index)
        if n.*.opens > 0 { n.*.opens -= 1 }
        self.collect(index)
    }

    fn collect(self: *Self, index: usize) -> void {
        const n = self.node(index)
        if n.*.links != 0 || n.*.opens != 0 || n.*.kind == NodeKind.free { return }
        // A disk's node is gone from the disk at the next commit.
        if n.*.volume != 0 && n.*.volume != ext2.Ext2Volume.VOLUME { volume.store().forget(index) }
        self.freeData(index)
        n.*.kind = NodeKind.free
    }

    // ---- a disk's nodes ----

    // A node of a disk whose data was not read yet is read now.
    pub fn ready(self: *Self, index: usize) -> void {
        const n = self.node(index)
        if n.*.volume != 0 && !n.*.loaded {
            n.*.loaded = true
            if n.*.volume == ext2.Ext2Volume.VOLUME {
                ext2.volume().load(index)
            } else {
                volume.store().load(index)
            }
        }
    }

    // A node of a disk changed (its data too when `data`): it goes to
    // the disk at the next commit.
    pub fn touch(self: *Self, index: usize, data: bool) -> void {
        const n = self.node(index)
        if n.*.volume == 0 || n.*.volume == ext2.Ext2Volume.VOLUME { return }
        n.*.dirty = true
        if data { n.*.dataDirty = true }
        volume.store().changed()
    }

    // The page of block `which` for data read from a disk (made).
    pub fn pageForLoad(self: *Self, index: usize, which: usize) -> usize { return self.block(index, which, true) }

    // The page of block `which` (0: a hole), for writing it to a disk.
    pub fn pageOf(self: *Self, index: usize, which: usize) -> usize { return self.block(index, which, false) }

    // Whether block `which` changed since the node was committed; its
    // mark taken off (it is on the disk now) when `clear`.
    pub fn pageChanged(self: *Self, index: usize, which: usize, clear: bool) -> bool {
        const slot = self.blockSlot(index, which, false)
        if slot == null || slot.?.* & CHANGED == 0 { return false }
        if clear { slot.?.* &= ADDRESS }
        return true
    }

    // A disk's node's data dropped from memory (read again when used).
    pub fn unloadData(self: *Self, index: usize) -> void {
        const n = self.node(index)
        const size = n.*.size
        self.freeBlocks(index, 0)
        n.*.size = size
        n.*.loaded = false
        self.dropIndex(index)
    }

    // `name` in a directory for `target` as it was read from a disk: no
    // link counted, nothing changed.
    pub fn attach(self: *Self, directory: usize, name: [*]const u8, length: usize, target: usize) -> bool {
        var record: [ENTRY_SIZE]u8 = undefined
        Bytes.fill(&record, ENTRY_SIZE, 0)
        Bytes.write32(&record, 0, target)
        record[4] = @intCast(u8, length)
        Bytes.copy(unsafe { @ptrFromInt([*]u8, @intFromPtr(&record) + 5) }, name, length)
        const d = self.node(directory)
        const at = d.*.size
        const page = self.block(directory, at / Page.SIZE, true)
        if page == 0 { return false }
        Bytes.copy(Bytes.pointer(layout.Memory.virtual(page) + at % Page.SIZE), &record, ENTRY_SIZE)
        d.*.size = at + ENTRY_SIZE
        if self.node(target).*.isDirectory() { self.node(target).*.parent = directory }
        self.indexEntry(directory, at / ENTRY_SIZE, name, length)
        return true
    }

    // The entry of `directory` named `name` names `target` from now on
    // (a disk's directory in the memory-only tree's place: the system
    // booted from the disk): the node it named, or NONE when there is no
    // such entry. Links are not counted (the caller keeps or retires the
    // old node; the target stays named where it is).
    pub fn graft(self: *Self, directory: usize, name: []const u8, target: usize) -> usize {
        var slot: usize = 0
        while slot < self.slotCount(directory) {
            var entryName: [*]const u8 = undefined
            var entryLength: usize = 0
            const found = self.entry(directory, slot, &entryName, &entryLength)
            if found != NONE && sameName(entryName, entryLength, name.pointer, name.length) {
                const page = self.block(directory, slot / ENTRIES_PER_PAGE, false)
                Bytes.write32(Bytes.pointer(layout.Memory.virtual(page) + (slot % ENTRIES_PER_PAGE) * ENTRY_SIZE), 0, target)
                if self.node(target).*.isDirectory() { self.node(target).*.parent = directory }
                return found
            }
            slot += 1
        }
        return NONE
    }

    // A memory-only node nothing names any more goes, with its tree.
    pub fn retire(self: *Self, index: usize) -> void {
        self.removeTree(index)
        self.node(index).*.links = 0
        self.collect(index)
    }

    // The entry of `directory` naming `target` cleared, nothing else
    // (a view of a disk taken out of /volumes).
    pub fn detach(self: *Self, directory: usize, target: usize) -> void {
        var slot: usize = 0
        while slot < self.slotCount(directory) {
            var name: [*]const u8 = undefined
            var length: usize = 0
            if self.entry(directory, slot, &name, &length) == target {
                const page = self.block(directory, slot / ENTRIES_PER_PAGE, false)
                Bytes.write32(Bytes.pointer(layout.Memory.virtual(page) + (slot % ENTRIES_PER_PAGE) * ENTRY_SIZE), 0, 0)
                return
            }
            slot += 1
        }
    }

    // A node of a view of a disk dropped from the tree as it is (the
    // view is taken out; nothing of the disk changes).
    pub fn drop(self: *Self, index: usize) -> void {
        const n = self.node(index)
        n.*.volume = 0
        n.*.links = 0
        n.*.opens = 0
        self.freeData(index)
        n.*.kind = NodeKind.free
    }

    // A node of the memory-only tree (and what a directory of it names)
    // becomes a node of view `view` of a disk: archive programs become
    // files, devices cannot; 0 or -errno.
    fn adopt(self: *Self, index: usize, view: usize) -> isize {
        const n = self.node(index)
        if n.*.volume == view { return 0 }
        if n.*.volume != 0 { return Status.cross_volume }
        if n.*.kind == NodeKind.archive && !self.copyUp(index) { return Status.no_space }
        if !n.hasPages() && n.*.kind != NodeKind.fifo { return Status.cross_volume }
        const number = volume.store().newInode()
        if number == 0 { return Status.no_space }
        n.*.volume = view
        n.*.diskInode = number
        n.*.loaded = true
        self.touch(index, true)
        if n.*.isDirectory() {
            var slot: usize = 0
            while slot < self.slotCount(index) {
                var name: [*]const u8 = undefined
                var length: usize = 0
                const child = self.entry(index, slot, &name, &length)
                if child != NONE {
                    const adopted = self.adopt(child, view)
                    if adopted < 0 { return adopted }
                }
                slot += 1
            }
        }
        return 0
    }

    // ---- data ----

    fn slots(page: usize) -> [*]usize { return unsafe { @ptrFromInt([*]usize, layout.Memory.virtual(page)) } }

    // Where the page address of block `which` of the node is (in the
    // node, or in an address page, made when `create`); null when there
    // is no such place (or memory is out).
    fn blockSlot(self: *Self, index: usize, which: usize, create: bool) -> ?*usize {
        const n = self.node(index)
        if which < Node.DIRECT { return &n.*.blocks[which] }
        var rest = which - Node.DIRECT
        if rest < ADDRESSES_PER_PAGE {
            if !addressPage(&n.*.indirect, create) { return null }
            return &slots(n.*.indirect)[rest]
        }
        rest -= ADDRESSES_PER_PAGE
        if rest >= ADDRESSES_PER_PAGE * ADDRESSES_PER_PAGE { return null }
        if !addressPage(&n.*.doubleIndirect, create) { return null }
        const middle = &slots(n.*.doubleIndirect)[rest / ADDRESSES_PER_PAGE]
        if !addressPage(middle, create) { return null }
        return &slots(middle.*)[rest % ADDRESSES_PER_PAGE]
    }

    // An address page at `place`, made when there is none and `create`.
    fn addressPage(place: *usize, create: bool) -> bool {
        if place.* == 0 {
            if !create { return false }
            place.* = memory.allFrames().allocate()
        }
        return place.* != 0
    }

    // The page holding block `which` of the node's data; 0 when there is
    // none (a hole, or memory is out when `create`). It may be shared
    // with other files: only for reading.
    fn block(self: *Self, index: usize, which: usize, create: bool) -> usize {
        const slot = self.blockSlot(index, which, create)
        if slot == null { return 0 }
        if slot.?.* == 0 && create { slot.?.* = memory.allFrames().allocate() }
        return slot.?.* & ADDRESS
    }

    // The mark of a disk's node's changed pages.
    fn changeMark(self: *Self, index: usize) -> usize { return if self.node(index).*.volume != 0 { CHANGED } else { 0 } }

    // The page of block `which` to write to: the node's own (a page it
    // shares is copied first: copy on write); 0 when memory is out.
    fn writableBlock(self: *Self, index: usize, which: usize) -> usize {
        const slot = self.blockSlot(index, which, true)
        if slot == null { return 0 }
        const frames = memory.allFrames()
        var frame = slot.?.* & ADDRESS
        if frame == 0 {
            frame = frames.allocate()
            if frame == 0 { return 0 }
        } else if frames.holderCount(frame) > 1 {
            const copy = frames.allocate()
            if copy == 0 { return 0 }
            Bytes.copyWords(layout.Memory.virtual(copy), layout.Memory.virtual(frame), Page.SIZE)
            frames.free(frame)
            frame = copy
        }
        slot.?.* = frame | self.changeMark(index)
        return frame
    }

    // Block `which` of the node becomes `page` (shared: one more holds
    // it; 0 for a hole), what it was let go; false when it cannot.
    fn shareBlock(self: *Self, index: usize, which: usize, page: usize) -> bool {
        const frames = memory.allFrames()
        const slot = self.blockSlot(index, which, page != 0)
        if slot == null { return page == 0 }
        if page != 0 && !frames.share(page) { return false }
        if slot.?.* != 0 { frames.free(slot.?.* & ADDRESS) }
        slot.?.* = if page == 0 { 0 } else { page | self.changeMark(index) }
        return true
    }

    // The pages of blocks `from` on freed (a truncation, or the node's
    // end).
    fn freeBlocks(self: *Self, index: usize, from: usize) -> void {
        const n = self.node(index)
        const frames = memory.allFrames()
        var which = from
        while which < Node.DIRECT {
            if n.*.blocks[which] != 0 { frames.free(n.*.blocks[which] & ADDRESS) }
            n.*.blocks[which] = 0
            which += 1
        }
        if n.*.indirect != 0 {
            const start = if from > Node.DIRECT { from - Node.DIRECT } else { 0 }
            freeTable(n.*.indirect, start)
            if start == 0 {
                frames.free(n.*.indirect)
                n.*.indirect = 0
            }
        }
        if n.*.doubleIndirect != 0 {
            const base = Node.DIRECT + ADDRESSES_PER_PAGE
            const start = if from > base { from - base } else { 0 }
            const entries = slots(n.*.doubleIndirect)
            var middle = start / ADDRESSES_PER_PAGE
            while middle < ADDRESSES_PER_PAGE {
                if entries[middle] != 0 {
                    const first = if middle == start / ADDRESSES_PER_PAGE { start % ADDRESSES_PER_PAGE } else { 0 }
                    freeTable(entries[middle], first)
                    if first == 0 {
                        frames.free(entries[middle])
                        entries[middle] = 0
                    }
                }
                middle += 1
            }
            if start == 0 {
                frames.free(n.*.doubleIndirect)
                n.*.doubleIndirect = 0
            }
        }
    }

    // The pages an address page names from `from` on freed.
    fn freeTable(table: usize, from: usize) -> void {
        const entries = slots(table)
        var k = from
        while k < ADDRESSES_PER_PAGE {
            if entries[k] != 0 {
                memory.allFrames().free(entries[k] & ADDRESS)
                entries[k] = 0
            }
            k += 1
        }
    }

    fn freeData(self: *Self, index: usize) -> void {
        const n = self.node(index)
        if n.hasPages() { self.freeBlocks(index, 0) }
        n.*.size = 0
        self.dropIndex(index)
    }

    // Up to `length` bytes of the node's data from `offset` into `into`:
    // how many there were.
    pub fn read(self: *Self, index: usize, offset: usize, into: [*]u8, length: usize) -> usize {
        self.ready(index)
        const n = self.node(index)
        if offset >= n.*.size { return 0 }
        const count = if length > n.*.size - offset { n.*.size - offset } else { length }
        if n.*.kind == NodeKind.archive {
            Bytes.copy(into, unsafe { @ptrFromInt([*]const u8, @intFromPtr(archive.Archive.boot().file(n.*.archiveIndex).data) + offset) }, count)
            return count
        }
        var done: usize = 0
        while done < count {
            const at = offset + done
            const within = at % Page.SIZE
            var chunk = Page.SIZE - within
            if chunk > count - done { chunk = count - done }
            const page = self.block(index, at / Page.SIZE, false)
            const target: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(into) + done) }
            if page == 0 {
                Bytes.fill(target, chunk, 0)
            } else {
                Bytes.copy(target, Bytes.pointer(layout.Memory.virtual(page) + within), chunk)
            }
            done += chunk
        }
        n.*.accessed = now()
        return count
    }

    // An archive's file as a file of pages (copyUp), to map them; false
    // when memory is out.
    pub fn ownPages(self: *Self, index: usize) -> bool { return self.copyUp(index) }

    // An archive's file becomes a file of pages of its own, with the same
    // bytes (before its first change); false when memory is out.
    fn copyUp(self: *Self, index: usize) -> bool {
        const n = self.node(index)
        const source = archive.Archive.boot().file(n.*.archiveIndex)
        n.*.kind = NodeKind.file
        var done: usize = 0
        while done < source.size {
            const page = self.block(index, done / Page.SIZE, true)
            if page == 0 { return false }
            const chunk = if source.size - done > Page.SIZE { Page.SIZE } else { source.size - done }
            Bytes.copy(Bytes.pointer(layout.Memory.virtual(page)), unsafe { @ptrFromInt([*]const u8, @intFromPtr(source.data) + done) }, chunk)
            done += chunk
        }
        return true
    }

    // `length` bytes from `from` into the node's data at `offset`: how
    // many went in, or -errno.
    pub fn write(self: *Self, index: usize, offset: usize, from: [*]const u8, length: usize) -> isize {
        self.ready(index)
        self.touch(index, true)
        const n = self.node(index)
        if n.*.kind == NodeKind.archive && !self.copyUp(index) { return Status.no_space }
        if offset + length > (Node.DIRECT + ADDRESSES_PER_PAGE + ADDRESSES_PER_PAGE * ADDRESSES_PER_PAGE) * Page.SIZE { return Status.too_large }
        var done: usize = 0
        while done < length {
            const at = offset + done
            const within = at % Page.SIZE
            var chunk = Page.SIZE - within
            if chunk > length - done { chunk = length - done }
            const page = self.writableBlock(index, at / Page.SIZE)
            if page == 0 { break }
            Bytes.copy(Bytes.pointer(layout.Memory.virtual(page) + within), unsafe { @ptrFromInt([*]const u8, @intFromPtr(from) + done) }, chunk)
            done += chunk
        }
        if offset + done > n.*.size { n.*.size = offset + done }
        const time = now()
        n.*.modified = time
        n.*.changed = time
        if done == 0 && length > 0 { return Status.no_space }
        return @intCast(isize, done)
    }

    // The node's size set to `size` (pages past it freed, a longer one
    // reads zeros); 0 or -errno.
    pub fn truncate(self: *Self, index: usize, size: usize) -> isize {
        self.ready(index)
        self.touch(index, true)
        const n = self.node(index)
        if n.*.kind == NodeKind.archive && !self.copyUp(index) { return Status.no_space }
        if size < n.*.size {
            self.freeBlocks(index, Page.up(size) / Page.SIZE)
            // The rest of the last page reads zeros.
            if size % Page.SIZE != 0 {
                const page = if self.block(index, size / Page.SIZE, false) == 0 { 0 } else { self.writableBlock(index, size / Page.SIZE) }
                if page != 0 { Bytes.fill(Bytes.pointer(layout.Memory.virtual(page) + size % Page.SIZE), Page.SIZE - size % Page.SIZE, 0) }
            }
        }
        n.*.size = size
        const time = now()
        n.*.modified = time
        n.*.changed = time
        return 0
    }

    // `length` bytes of `from`'s data from `fromOffset` into `to`'s at
    // `toOffset` (copy_file_range, a clone): whole pages are shared (copy
    // on write: the first write to either copies the page), the rest is
    // copied. How many, or -errno.
    pub fn copyRange(self: *Self, from: usize, fromOffset: usize, to: usize, toOffset: usize, length: usize) -> isize {
        self.ready(from)
        self.ready(to)
        self.touch(to, true)
        const source = self.node(from)
        const target = self.node(to)
        if target.*.kind == NodeKind.archive && !self.copyUp(to) { return Status.no_space }
        var done: usize = 0
        var buffer: [512]u8 = undefined
        while done < length {
            const at = fromOffset + done
            const into = toOffset + done
            if at >= source.*.size { break }
            const left = if length - done < source.*.size - at { length - done } else { source.*.size - at }
            // A whole page (or the source's last, at or past the target's
            // end): shared.
            if source.*.kind == NodeKind.file && at % Page.SIZE == 0 && into % Page.SIZE == 0 && (left >= Page.SIZE || into + left >= target.*.size) {
                const chunk = if left > Page.SIZE { Page.SIZE } else { left }
                if self.shareBlock(to, into / Page.SIZE, self.block(from, at / Page.SIZE, false)) {
                    done += chunk
                    if into + chunk > target.*.size { target.*.size = into + chunk }
                    continue
                }
            }
            const chunk = if left > 512 { 512 } else { left }
            const read = self.read(from, at, &buffer, chunk)
            const written = self.write(to, into, &buffer, read)
            if written < 0 { return if done > 0 { @intCast(isize, done) } else { written } }
            done += @bitCast(usize, written)
            if @bitCast(usize, written) < chunk { break }
        }
        const time = now()
        target.*.modified = time
        target.*.changed = time
        return @intCast(isize, done)
    }

    // ---- directories ----

    // The entry `slot` of a directory: its node (NONE when free), and its
    // name into `name` (the length into `length`).
    pub fn entry(self: *Self, directory: usize, slot: usize, name: *[*]const u8, length: *usize) -> usize {
        self.ready(directory)
        const page = self.block(directory, slot / ENTRIES_PER_PAGE, false)
        if page == 0 { return NONE }
        const at = Bytes.pointer(layout.Memory.virtual(page) + (slot % ENTRIES_PER_PAGE) * ENTRY_SIZE)
        const found = Bytes.read32(at, 0)
        length.* = @intCast(usize, at[4])
        name.* = unsafe { @ptrFromInt([*]const u8, @intFromPtr(at) + 5) }
        return found
    }

    // How many entry slots the directory has (used or not).
    pub fn slotCount(self: *Self, directory: usize) -> usize {
        self.ready(directory)
        return self.node(directory).*.size / ENTRY_SIZE
    }

    fn sameName(a: [*]const u8, aLength: usize, b: [*]const u8, bLength: usize) -> bool {
        if aLength != bLength { return false }
        var k: usize = 0
        while k < aLength {
            if a[k] != b[k] { return false }
            k += 1
        }
        return true
    }

    // The node a directory names `name`; NONE when none ("." and ".."
    // too).
    // ---- a directory's index ----

    // Directories with this many entry slots or more are looked up by an
    // index: hash slots (u32, an entry slot + 1; 0 free) in frames, two
    // for each entry slot rounded up to a power of two, probed in order;
    // an entry that went leaves a slot naming an empty entry behind
    // (the name does not match: the probing goes on), and an index that
    // grew long chains is made again. Index slot 0 holds the entry
    // count the index was made for (its capacity follows from it).
    const INDEX_FROM: usize = 64
    const INDEX_MAX_FRAMES: usize = 64

    fn hashName(name: [*]const u8, length: usize) -> usize {
        var hash: usize = 0xCBF29CE484222325
        var k: usize = 0
        while k < length {
            hash = (hash ^ @intCast(usize, name[k])) *% 0x100000001B3
            k += 1
        }
        return hash
    }

    // How many hash slots the index of a directory with `slots` entry
    // slots has (0: too big).
    fn indexCapacity(slots: usize) -> usize {
        var capacity: usize = 1024
        while capacity < slots * 2 && capacity < INDEX_MAX_FRAMES * 1024 { capacity *= 2 }
        return if capacity < slots * 2 { 0 } else { capacity }
    }

    fn indexSlots(self: *Self, directory: usize) -> [*]u32 { return unsafe { @ptrFromInt([*]u32, layout.Memory.virtual(self.node(directory).*.index)) } }

    // The entry slots the index was made for.
    fn indexedSlots(self: *Self, directory: usize) -> usize { return @intCast(usize, self.indexSlots(directory)[0]) }

    pub fn dropIndex(self: *Self, directory: usize) -> void {
        const n = self.node(directory)
        if n.*.index == 0 { return }
        const frames = memory.allFrames()
        const pages = indexCapacity(self.indexedSlots(directory)) / 1024
        var k: usize = 0
        while k < pages {
            frames.free(n.*.index + k * Page.SIZE)
            k += 1
        }
        n.*.index = 0
    }

    // The directory's index made from its entries (none when memory is
    // out or it is too big).
    fn buildIndex(self: *Self, directory: usize) -> void {
        const slots = self.slotCount(directory)
        const capacity = indexCapacity(slots)
        if capacity == 0 { return }
        const frame = memory.allFrames().allocateContiguous(capacity / 1024)
        if frame == 0 { return }
        self.node(directory).*.index = frame
        const table = self.indexSlots(directory)
        var k: usize = 0
        while k < capacity {
            table[k] = 0
            k += 1
        }
        table[0] = @intCast(u32, slots)
        var slot: usize = 0
        while slot < slots {
            var name: [*]const u8 = undefined
            var length: usize = 0
            if self.entry(directory, slot, &name, &length) != NONE { self.indexEntry(directory, slot, name, length) }
            slot += 1
        }
    }

    // Entry `slot` named `name` into the index (when there is one); a
    // chain longer than 32, or a slot past what the index was made for,
    // drops the index (made again at a lookup).
    fn indexEntry(self: *Self, directory: usize, slot: usize, name: [*]const u8, length: usize) -> void {
        const n = self.node(directory)
        if n.*.index == 0 { return }
        const capacity = indexCapacity(self.indexedSlots(directory))
        if slot * 2 >= capacity {
            self.dropIndex(directory)
            return
        }
        const table = self.indexSlots(directory)
        var at = hashName(name, length) & (capacity - 1)
        if at == 0 { at = 1 }
        var probes: usize = 0
        while table[at] != 0 {
            probes += 1
            if probes > 32 {
                self.dropIndex(directory)
                return
            }
            at = (at + 1) & (capacity - 1)
            if at == 0 { at = 1 }
        }
        table[at] = @intCast(u32, slot + 1)
    }

    // The entry named `name`, by the index (which is there).
    fn lookupIndexed(self: *Self, directory: usize, name: [*]const u8, length: usize) -> usize {
        const capacity = indexCapacity(self.indexedSlots(directory))
        const table = self.indexSlots(directory)
        var at = hashName(name, length) & (capacity - 1)
        if at == 0 { at = 1 }
        var probes: usize = 0
        while table[at] != 0 && probes <= capacity {
            const slot = @intCast(usize, table[at]) - 1
            var entryName: [*]const u8 = undefined
            var entryLength: usize = 0
            const found = self.entry(directory, slot, &entryName, &entryLength)
            if found != NONE && sameName(entryName, entryLength, name, length) { return found }
            probes += 1
            at = (at + 1) & (capacity - 1)
            if at == 0 { at = 1 }
        }
        return NONE
    }

    pub fn lookup(self: *Self, directory: usize, name: [*]const u8, length: usize) -> usize {
        if length == 1 && name[0] == 46 { return directory }
        if length == 2 && name[0] == 46 && name[1] == 46 { return self.node(directory).*.parent }
        if self.slotCount(directory) >= INDEX_FROM {
            if self.node(directory).*.index == 0 { self.buildIndex(directory) }
            if self.node(directory).*.index != 0 { return self.lookupIndexed(directory, name, length) }
        }
        var slot: usize = 0
        while slot < self.slotCount(directory) {
            var entryName: [*]const u8 = undefined
            var entryLength: usize = 0
            const found = self.entry(directory, slot, &entryName, &entryLength)
            if found != NONE && sameName(entryName, entryLength, name, length) { return found }
            slot += 1
        }
        return NONE
    }

    // `name` in `directory` for the node `target` (a link more); 0 or
    // -errno.
    pub fn link(self: *Self, directory: usize, name: [*]const u8, length: usize, target: usize) -> isize {
        if length > NAME_MAX { return Status.name_too_long }
        if length == 0 { return Status.not_found }
        if self.lookup(directory, name, length) != NONE { return Status.exists }
        // Onto a disk: a new node (and its tree) becomes the disk's.
        const view = self.node(directory).*.volume
        if self.node(target).*.volume != view {
            if self.node(target).*.links != 0 { return Status.cross_volume }
            const adopted = self.adopt(target, view)
            if adopted < 0 { return adopted }
        }
        // A free slot, or one more at the end.
        var slot: usize = 0
        while slot < self.slotCount(directory) {
            var entryName: [*]const u8 = undefined
            var entryLength: usize = 0
            if self.entry(directory, slot, &entryName, &entryLength) == NONE { break }
            slot += 1
        }
        var record: [ENTRY_SIZE]u8 = undefined
        Bytes.fill(&record, ENTRY_SIZE, 0)
        Bytes.write32(&record, 0, target)
        record[4] = @intCast(u8, length)
        Bytes.copy(unsafe { @ptrFromInt([*]u8, @intFromPtr(&record) + 5) }, name, length)
        self.indexEntry(directory, slot, name, length)
        const written = self.write(directory, slot * ENTRY_SIZE, &record, ENTRY_SIZE)
        if written < 0 { return written }
        const t = self.node(target)
        t.*.links += 1
        t.*.changed = now()
        if t.*.isDirectory() { t.*.parent = directory }
        self.touch(target, false)
        return 0
    }

    // The entry `name` of `directory` taken out (a link less; the node
    // freed when nothing holds it); 0 or -errno.
    pub fn unlink(self: *Self, directory: usize, name: [*]const u8, length: usize) -> isize {
        var slot: usize = 0
        while slot < self.slotCount(directory) {
            var entryName: [*]const u8 = undefined
            var entryLength: usize = 0
            const found = self.entry(directory, slot, &entryName, &entryLength)
            if found != NONE && sameName(entryName, entryLength, name, length) {
                const page = self.block(directory, slot / ENTRIES_PER_PAGE, false)
                Bytes.write32(Bytes.pointer(layout.Memory.virtual(page) + (slot % ENTRIES_PER_PAGE) * ENTRY_SIZE), 0, 0)
                const t = self.node(found)
                t.*.links -= 1
                t.*.changed = now()
                self.node(directory).*.modified = now()
                self.touch(directory, true)
                if t.*.links > 0 { self.touch(found, false) }
                self.collect(found)
                return 0
            }
            slot += 1
        }
        return Status.not_found
    }

    pub fn isEmpty(self: *Self, directory: usize) -> bool {
        var slot: usize = 0
        while slot < self.slotCount(directory) {
            var entryName: [*]const u8 = undefined
            var entryLength: usize = 0
            if self.entry(directory, slot, &entryName, &entryLength) != NONE { return false }
            slot += 1
        }
        return true
    }

    // Whether `node` is `ancestor` or lies under it.
    pub fn isUnder(self: *Self, node_index: usize, ancestor: usize) -> bool {
        var at = node_index
        var steps: usize = 0
        while steps < self.*.count {
            if at == ancestor { return true }
            if at == ROOT { return false }
            at = self.node(at).*.parent
            steps += 1
        }
        return false
    }

    // A new directory `name` in `directory`; its node, or -errno.
    pub fn makeDirectory(self: *Self, directory: usize, name: []const u8, mode: usize) -> isize {
        const made = self.create(NodeKind.directory, mode)
        if made == NONE { return Status.no_space }
        const linked = self.link(directory, name.pointer, name.length, made)
        if linked < 0 {
            self.collect(made)
            return linked
        }
        return @intCast(isize, made)
    }

    // ---- snapshots ----

    // A copy of the tree at `source` that names no node of it: new
    // directories, files that share their pages with the originals (copy
    // on write: a write to either copies the page), the same devices and
    // archive programs; read-only throughout when `readOnly`. It is built
    // before anything names it (so a snapshot may go inside its source).
    // Its node; NONE when nodes or memory ran out (nothing is left over).
    pub fn cloneTree(self: *Self, source: usize, readOnly: bool) -> usize {
        const original = self.node(source)
        const made = self.create(original.*.kind, original.*.mode)
        if made == NONE { return NONE }
        const copy = self.node(made)
        copy.*.archiveIndex = original.*.archiveIndex
        if original.*.kind == NodeKind.archive || original.*.kind == NodeKind.disk { copy.*.size = original.*.size }
        if original.*.kind == NodeKind.file || original.*.kind == NodeKind.symlink {
            const copied = self.copyRange(source, 0, made, 0, original.*.size)
            if copied < 0 || @bitCast(usize, copied) != original.*.size {
                self.collect(made)
                return NONE
            }
        }
        if original.*.kind == NodeKind.directory {
            // Held while it is built (no directory names it yet).
            copy.*.opens += 1
            var slot: usize = 0
            while slot < self.slotCount(source) {
                var name: [*]const u8 = undefined
                var length: usize = 0
                const child = self.entry(source, slot, &name, &length)
                if child != NONE {
                    const cloned = self.cloneTree(child, readOnly)
                    if cloned == NONE || self.link(made, name, length, cloned) < 0 {
                        if cloned != NONE { self.removeTree(cloned) }
                        self.removeTree(made)
                        copy.*.opens -= 1
                        self.collect(made)
                        return NONE
                    }
                }
                slot += 1
            }
            copy.*.opens -= 1
        }
        copy.*.accessed = original.*.accessed
        copy.*.modified = original.*.modified
        copy.*.changed = original.*.changed
        copy.*.readOnly = readOnly
        return made
    }

    // What a directory names, all of it, let go (each node freed when
    // nothing else holds it); the directory itself stays as it is held.
    pub fn removeTree(self: *Self, directory: usize) -> void {
        if !self.node(directory).*.isDirectory() {
            self.collect(directory)
            return
        }
        var slot: usize = 0
        while slot < self.slotCount(directory) {
            var name: [*]const u8 = undefined
            var length: usize = 0
            const child = self.entry(directory, slot, &name, &length)
            if child != NONE {
                if self.node(child).*.isDirectory() { self.removeTree(child) }
                _ = self.unlink(directory, name, length)
            }
            slot += 1
        }
        self.collect(directory)
    }

    // ---- paths ----

    // Links followed from one path at most (more: ELOOP).
    const MAX_LINKS: usize = 40

    // The node `path` names, from `base` when it is relative, symbolic
    // links followed (the last component's too); -errno.
    pub fn resolve(self: *Self, base: usize, path: [*]const u8) -> isize { return self.walk(base, path, textLength(path), true, 0) }

    // The same, a link as the last component is that link (lstat,
    // readlink).
    pub fn resolveLink(self: *Self, base: usize, path: [*]const u8) -> isize { return self.walk(base, path, textLength(path), false, 0) }

    fn textLength(text: [*]const u8) -> usize {
        var k: usize = 0
        while text[k] != 0 { k += 1 }
        return k
    }

    // The node path[0..end] names from `base` (from the root when it
    // starts with '/'): every component a directory's entry, links in the
    // middle followed, the last one when `followLast` or a '/' follows
    // it; -errno.
    fn walk(self: *Self, base: usize, path: [*]const u8, end: usize, followLast: bool, depth: usize) -> isize {
        var at: usize = if end > 0 && path[0] == 47 { ROOT } else { base }
        var k: usize = 0
        while true {
            while k < end && path[k] == 47 { k += 1 }
            if k >= end { break }
            const start = k
            while k < end && path[k] != 47 { k += 1 }
            if !self.node(at).*.isDirectory() { return Status.not_directory }
            if !self.permits(at, EXECUTE) { return Status.denied }
            const next = self.lookup(at, unsafe { @ptrFromInt([*]const u8, @intFromPtr(path) + start) }, k - start)
            if next == NONE { return Status.not_found }
            if self.node(next).*.isLink() && (followLast || k < end) { return self.follow(at, next, path, k, end, followLast, depth) }
            at = next
        }
        return @intCast(isize, at)
    }

    // The walk on through the link `link` of `directory`: its target, then
    // what is left of the path (path[from..end]), as one path in a page
    // of its own.
    fn follow(self: *Self, directory: usize, link: usize, path: [*]const u8, from: usize, end: usize, followLast: bool, depth: usize) -> isize {
        if depth >= MAX_LINKS { return Status.link_loop }
        self.ready(link)
        const size = self.node(link).*.size
        if size == 0 { return Status.not_found }
        if size + end - from >= Page.SIZE { return Status.name_too_long }
        const frame = memory.allFrames().allocate()
        if frame == 0 { return Status.no_memory }
        const joined = Bytes.pointer(layout.Memory.virtual(frame))
        _ = self.read(link, 0, joined, size)
        Bytes.copy(unsafe { @ptrFromInt([*]u8, @intFromPtr(joined) + size) }, unsafe { @ptrFromInt([*]const u8, @intFromPtr(path) + from) }, end - from)
        const found = self.walk(directory, joined, size + end - from, followLast, depth + 1)
        memory.allFrames().free(frame)
        return found
    }

    // The directory that would hold the last component of `path` (its
    // node, or -errno), the component into `name` (empty for "/").
    pub fn resolveParent(self: *Self, base: usize, path: [*]const u8, name: *[]const u8) -> isize {
        var end = textLength(path)
        while end > 1 && path[end - 1] == 47 { end -= 1 }
        var start = end
        while start > 0 && path[start - 1] != 47 { start -= 1 }
        name.* = path[start..end]
        if end - start > NAME_MAX { return Status.name_too_long }
        // The directory part, as a path of its own.
        const at = self.walk(base, path, start, true, 0)
        if at < 0 { return at }
        if !self.node(@bitCast(usize, at)).*.isDirectory() { return Status.not_directory }
        return at
    }

    // The path of the directory `directory` into `into` (NUL-terminated):
    // its length, or 0 when it does not fit.
    pub fn pathOf(self: *Self, directory: usize, into: [*]u8, capacity: usize) -> usize {
        if capacity < 2 { return 0 }
        // Built from the end of `into`, then moved to its start.
        var at = capacity - 1
        into[at] = 0
        var current = directory
        var steps: usize = 0
        while current != ROOT && steps < self.*.count {
            const parent = self.node(current).*.parent
            var slot: usize = 0
            var found = false
            while slot < self.slotCount(parent) && !found {
                var entryName: [*]const u8 = undefined
                var entryLength: usize = 0
                if self.entry(parent, slot, &entryName, &entryLength) == current {
                    if at < entryLength + 1 { return 0 }
                    at -= entryLength
                    Bytes.copy(unsafe { @ptrFromInt([*]u8, @intFromPtr(into) + at) }, entryName, entryLength)
                    at -= 1
                    into[at] = 47
                    found = true
                }
                slot += 1
            }
            if !found { return 0 }
            current = parent
            steps += 1
        }
        if current == ROOT && at == capacity - 1 {
            at -= 1
            into[at] = 47
        }
        const length = capacity - 1 - at
        var k: usize = 0
        while k <= length {
            into[k] = into[at + k]
            k += 1
        }
        return length
    }

    // ---- the tree at boot ----

    fn addDirectory(self: *Self, parent: usize, name: []const u8, mode: usize) -> usize {
        const made = self.makeDirectory(parent, name, mode)
        return if made < 0 { NONE } else { @bitCast(usize, made) }
    }

    // A device `name` in /devices (one found after boot: a disk) of
    // `size` bytes.
    pub fn addDevice(self: *Self, name: []const u8, kind: NodeKind, size: usize) -> void {
        const devices = self.lookup(ROOT, "devices".pointer, 7)
        if devices == NONE { return }
        const made = self.device(devices, name, kind)
        if made != NONE { self.node(made).*.size = size }
    }

    fn device(self: *Self, parent: usize, name: []const u8, kind: NodeKind) -> usize {
        const made = self.create(kind, 0x1B6)
        if made != NONE { _ = self.link(parent, name.pointer, name.length, made) }
        return made
    }

    // A file `name` in `parent` holding `text`.
    fn addFile(self: *Self, parent: usize, name: []const u8, mode: usize, text: []const u8) -> void {
        const made = self.create(NodeKind.file, mode)
        if made == NONE { return }
        _ = self.write(made, 0, text.pointer, text.length)
        _ = self.link(parent, name.pointer, name.length, made)
    }

    // The tree at boot (the layout above).
    // Permission bits, as a mode has them for the owner, the group, the
    // rest.
    pub const READ: usize = 4
    pub const WRITE: usize = 2
    pub const EXECUTE: usize = 1

    pub fn setActor(self: *Self, user: usize, group: usize) -> void {
        self.*.actorUser = user
        self.*.actorGroup = group
    }

    // Whether the actor may do `wanted` (READ, WRITE, EXECUTE, or several)
    // with the node: the system's user may everything but run a file no
    // bit lets anyone run; others as the node's mode says for its owner,
    // its group or the rest.
    pub fn permits(self: *Self, index: usize, wanted: usize) -> bool {
        const n = self.node(index)
        if self.*.actorUser == 0 { return wanted & EXECUTE == 0 || n.*.isDirectory() || n.*.mode & 0x49 != 0 }
        var bits = n.*.mode
        if n.*.user == self.*.actorUser {
            bits = n.*.mode >> 6
        } else if n.*.group == self.*.actorGroup {
            bits = n.*.mode >> 3
        }
        return bits & wanted == wanted
    }

    // The node's owner and group.
    pub fn own(self: *Self, index: usize, user: usize, group: usize) -> void {
        self.node(index).*.user = user
        self.node(index).*.group = group
    }

    pub fn init(self: *Self) -> void {
        self.*.count = 0
        self.*.actorUser = 0
        self.*.actorGroup = 0
        _ = self.grow()
        // Node 0 is no node.
        self.node(NONE).*.kind = NodeKind.directory
        const root = self.create(NodeKind.directory, 0x1ED)
        self.node(root).*.links = 1
        self.node(root).*.parent = ROOT
        const system = self.addDirectory(ROOT, "system", 0x1ED)
        const bin = self.addDirectory(system, "programs", 0x1ED)
        const files = archive.Archive.boot()
        var f: usize = 0
        while f < files.count() {
            const made = self.create(NodeKind.archive, 0x1ED)
            if made != NONE {
                self.node(made).*.archiveIndex = f
                self.node(made).*.size = files.file(f).size
                _ = self.link(bin, files.name(f), files.nameLength(f), made)
            }
            f += 1
        }
        const settings = self.addDirectory(system, "settings", 0x1ED)
        self.addFile(settings, "users", 0x1A4, "root:x:0:0:root:/users/root:/system/programs/mlx-sh\n")
        self.addFile(settings, "groups", 0x1A4, "root:x:0:\n")
        const dev = self.addDirectory(ROOT, "devices", 0x1ED)
        self.*.console = self.device(dev, "console", NodeKind.terminal)
        _ = self.device(dev, "tty", NodeKind.terminal)
        _ = self.device(dev, "null", NodeKind.null_device)
        _ = self.device(dev, "zero", NodeKind.zero_device)
        _ = self.addDirectory(ROOT, "temporary", 0x3FF)
        const volumes = self.addDirectory(ROOT, "volumes", 0x1ED)
        if volumes != NONE { self.node(volumes).*.readOnly = true }
        const users = self.addDirectory(ROOT, "users", 0x1ED)
        _ = self.addDirectory(users, "root", 0x1C0)
    }
}

var tree: Vfs = undefined // (per run)

pub fn fileSystem() -> *Vfs { return &tree }
