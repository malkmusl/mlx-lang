// Time: the time-stamp counter, its rate measured against the PIT's
// channel 2 at boot (10 ms, polled), and the wall clock the CMOS clock
// gave then.
const cpu = @import("./cpu.mlx")

var hertz: usize = 1000000000 // (per run)
var bootCounter: usize = 0 // (per run)
var bootSeconds: usize = 0 // (per run)

fn cmos(register: usize) -> usize {
    cpu.outb(0x70, register)
    return cpu.inb(0x71)
}

fn fromBcd(value: usize, bcd: bool) -> usize {
    if !bcd { return value }
    return (value >> 4) * 10 + (value & 15)
}

// Days from 1970-01-01 to the date (the proleptic Gregorian calendar).
fn days(year: usize, month: usize, day: usize) -> usize {
    const y = if month <= 2 { year - 1 } else { year }
    const era = y / 400
    const yoe = y - era * 400
    const m = if month > 2 { month - 3 } else { month + 9 }
    const doy = (153 * m + 2) / 5 + day - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn readCmos() -> usize {
    while cmos(0x0A) & 0x80 != 0 {}
    const status = cmos(0x0B)
    const bcd = status & 4 == 0
    const second = fromBcd(cmos(0x00), bcd)
    const minute = fromBcd(cmos(0x02), bcd)
    var hourByte = cmos(0x04)
    const pm = hourByte & 0x80 != 0
    hourByte &= 0x7F
    var hour = fromBcd(hourByte, bcd)
    if status & 2 == 0 {
        if hour == 12 { hour = 0 }
        if pm { hour += 12 }
    }
    const day = fromBcd(cmos(0x07), bcd)
    const month = fromBcd(cmos(0x08), bcd)
    const year = 2000 + fromBcd(cmos(0x09), bcd)
    return days(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
}

pub fn init() -> void {
    // Channel 2, one shot of 11932 ticks (10 ms at 1.193182 MHz), its
    // output on port 0x61 bit 5; the speaker off.
    cpu.outb(0x61, (cpu.inb(0x61) & 0xFD) | 1)
    cpu.outb(0x43, 0xB0)
    cpu.outb(0x42, 11932 & 255)
    cpu.outb(0x42, 11932 >> 8)
    const gate = cpu.inb(0x61) & 0xFE
    cpu.outb(0x61, gate)
    cpu.outb(0x61, gate | 1)
    const start = cpu.rdtsc()
    var spins: usize = 0
    while cpu.inb(0x61) & 0x20 == 0 && spins < 100000000 { spins += 1 }
    const elapsed = cpu.rdtsc() - start
    if elapsed > 1000 { hertz = elapsed * 100 }
    bootSeconds = readCmos()
    bootCounter = cpu.rdtsc()
}

pub fn rate() -> usize { return hertz }

// Nanoseconds since boot.
pub fn monotonic() -> usize {
    const ticks = cpu.rdtsc() - bootCounter
    const seconds = ticks / hertz
    return seconds * 1000000000 + (ticks % hertz) * 1000000000 / hertz
}

// Nanoseconds since 1970.
pub fn realtime() -> usize { return bootSeconds * 1000000000 + monotonic() }
