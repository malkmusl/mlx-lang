// Time: the time-stamp counter, its rate measured against the PIT's
// channel 2 at boot (10 ms, polled), and the wall clock the CMOS clock
// gave then.
const cpu = @import("./cpu.mlx")
const Port = cpu.Port

// The PIT (8254): channel 2, gated by port 0x61, its output readable
// there.
pub const Pit = struct {
    pub const HERTZ: usize = 1193182
    const GATE: usize = 0x61
    const COMMAND: usize = 0x43
    const CHANNEL2: usize = 0x42

    // Time-stamp counter ticks in 10 ms (one shot of 11932 PIT ticks); 0
    // when the channel's output never came.
    pub fn ticksIn10ms() -> usize {
        const count = HERTZ / 100
        Port.out8(GATE, (Port.in8(GATE) & 0xFD) | 1) // gate on, speaker off
        Port.out8(COMMAND, 0xB0) // channel 2, both bytes, mode 0
        Port.out8(CHANNEL2, count & 255)
        Port.out8(CHANNEL2, count >> 8)
        const gate = Port.in8(GATE) & 0xFE
        Port.out8(GATE, gate)
        Port.out8(GATE, gate | 1)
        const start = cpu.Cpu.timestamp()
        var spins: usize = 0
        while Port.in8(GATE) & 0x20 == 0 {
            spins += 1
            if spins > 100000000 { return 0 }
        }
        return cpu.Cpu.timestamp() - start
    }
}

// The CMOS real-time clock.
pub const Cmos = struct {
    const SECOND: usize = 0x00
    const MINUTE: usize = 0x02
    const HOUR: usize = 0x04
    const DAY: usize = 0x07
    const MONTH: usize = 0x08
    const YEAR: usize = 0x09
    const STATUS_A: usize = 0x0A
    const STATUS_B: usize = 0x0B

    fn read(register: usize) -> usize {
        Port.out8(0x70, register)
        return Port.in8(0x71)
    }

    fn decode(value: usize, bcd: bool) -> usize {
        if !bcd { return value }
        return (value >> 4) * 10 + (value & 15)
    }

    // Days from 1970-01-01 to the date (the proleptic Gregorian calendar).
    pub fn days(year: usize, month: usize, day: usize) -> usize {
        const y = if month <= 2 { year - 1 } else { year }
        const era = y / 400
        const yoe = y - era * 400
        const m = if month > 2 { month - 3 } else { month + 9 }
        const doy = (153 * m + 2) / 5 + day - 1
        const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
        return era * 146097 + doe - 719468
    }

    // Seconds since 1970 (the clock kept in UTC).
    pub fn seconds() -> usize {
        // (An update under way: over in two milliseconds on a clock that
        // is there; one that is not reads as all ones, for ever.)
        var polls: usize = 0
        while read(STATUS_A) & 0x80 != 0 && polls < 100000 { polls += 1 }
        const status = read(STATUS_B)
        const bcd = status & 4 == 0
        const second = decode(read(SECOND), bcd)
        const minute = decode(read(MINUTE), bcd)
        const hourByte = read(HOUR)
        var hour = decode(hourByte & 0x7F, bcd)
        if status & 2 == 0 {
            if hour == 12 { hour = 0 }
            if hourByte & 0x80 != 0 { hour += 12 }
        }
        const day = decode(read(DAY), bcd)
        const month = decode(read(MONTH), bcd)
        const year = 2000 + decode(read(YEAR), bcd)
        return days(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
    }
}

pub const Clock = struct {
    pub const NANOSECONDS: usize = 1000000000

    hertz: usize
    bootCounter: usize
    bootSeconds: usize
    // Nanoseconds a tick of the counter, times 2^shift: below 2^32, so
    // that it times half a count of ticks fits 64 bits (shift is 32 for
    // a counter of a GHz and more, less for a slower one).
    scale: usize
    shift: usize

    pub fn calibrate(self: *Self) -> void {
        const ticks = Pit.ticksIn10ms()
        self.*.hertz = if ticks > 1000 { ticks * 100 } else { NANOSECONDS }
        self.*.shift = 32
        self.*.scale = (NANOSECONDS << 32) / self.*.hertz
        while self.*.scale >> 32 != 0 {
            self.*.shift -= 1
            self.*.scale = (NANOSECONDS << self.*.shift) / self.*.hertz
        }
        self.*.bootSeconds = Cmos.seconds()
        self.*.bootCounter = cpu.Cpu.timestamp()
    }

    pub fn rate(self: *const Self) -> usize { return self.*.hertz }

    // Nanoseconds since boot: the counter's ticks times the scale, the
    // upper and the lower half of the ticks each on its own (the whole
    // product does not fit 64 bits after a few seconds). No division: the
    // kernel reads the clock on every entry, and three 64-bit divisions
    // were most of what a reading cost.
    pub fn monotonic(self: *const Self) -> usize { return self.nanoseconds(cpu.Cpu.timestamp() - self.*.bootCounter) }

    // The nanoseconds `ticks` of the counter take.
    pub fn nanoseconds(self: *const Self, ticks: usize) -> usize {
        return (((ticks >> 32) * self.*.scale) << (32 - self.*.shift)) + (((ticks & 0xFFFFFFFF) * self.*.scale) >> self.*.shift)
    }

    // Nanoseconds since 1970.
    pub fn realtime(self: *const Self) -> usize { return self.*.bootSeconds * NANOSECONDS + self.monotonic() }
}

// The end of a wait for a device, in real time: a driver polls until what
// it waits for is there or the deadline has passed. (A count of polls is no
// measure: a register read takes a fraction of a microsecond on one
// machine and several in a virtual one, so the same count is a blink here
// and minutes there.) After Clock.calibrate.
pub const Deadline = struct {
    until: usize

    pub fn after(milliseconds: usize) -> Deadline { return Deadline.{ .until = clock.monotonic() + milliseconds * 1000000 } }

    pub fn passed(self: Self) -> bool { return clock.monotonic() >= self.until }
}

// Waits (the processor busy) for `microseconds`: what a device asks for
// between two steps.
pub fn pause(microseconds: usize) -> void {
    const until = clock.monotonic() + microseconds * 1000
    while clock.monotonic() < until {}
}

var clock: Clock = undefined // (per run)

pub fn system() -> *Clock { return &clock }
