// A process's descriptors: the terminal (0, 1 and 2 at the start), the
// boot archive's files (read only, all in the root directory), the root
// directory, and the ends of pipes.
const archive = @import("./archive.mlx")
const terminal = @import("./terminal.mlx")
const pipes = @import("./pipe.mlx")
const wait = @import("./wait.mlx")
const Bytes = @import("./bytes.mlx").Bytes
const Errno = @import("./errno.mlx").Errno
const clock = @import("./clock.mlx")

pub const Kind = enum(u8) { none, terminal, file, directory, pipe_read, pipe_write }

pub const Descriptor = struct {
    kind: Kind
    // The archive's file (kind file), the pipe (its ends).
    index: usize
    offset: usize
    closeOnExec: bool
}

// What a path names: the root, a file of the archive, or nothing.
pub const Path = struct {
    pub const ROOT: isize = -1000

    // "/" is the root, "/NAME", "./NAME" and "NAME" an archive file: its
    // index, ROOT, or ENOENT.
    pub fn lookup(path: [*]const u8) -> isize {
        var start: usize = 0
        while path[start] == 47 { start += 1 }
        if path[start] == 46 && path[start + 1] == 47 {
            start += 2
            while path[start] == 47 { start += 1 }
        }
        var end = start
        while path[end] != 0 { end += 1 }
        while end > start && path[end - 1] == 47 { end -= 1 }
        if end == start || (end == start + 1 && path[start] == 46) { return ROOT }
        const files = archive.Archive.boot()
        const found = files.find(unsafe { @ptrFromInt([*]const u8, @intFromPtr(path) + start) }, end - start)
        if found == files.count() { return Errno.ENOENT }
        return @intCast(isize, found)
    }
}

// A struct stat (Linux x86-64, 144 bytes).
pub const Status = struct {
    pub const SIZE: usize = 144
    const S_IFCHR_0620: usize = 0x2190
    const S_IFREG_0755: usize = 0x81ED
    const S_IFDIR_0755: usize = 0x41ED
    const S_IFIFO_0600: usize = 0x1180

    pub fn fill(into: [*]u8, kind: Kind, item: usize, size: usize) -> void {
        Bytes.fill(into, SIZE, 0)
        const mode = match kind {
            .terminal => S_IFCHR_0620,
            .directory => S_IFDIR_0755,
            .file => S_IFREG_0755,
            .pipe_read => S_IFIFO_0600,
            .pipe_write => S_IFIFO_0600,
            .none => 0
        }
        Bytes.write64(into, 0, 1) // st_dev
        Bytes.write64(into, 8, item + 2) // st_ino
        Bytes.write64(into, 16, 1) // st_nlink
        Bytes.write32(into, 24, mode) // st_mode
        if kind == Kind.terminal { Bytes.write64(into, 40, 0x400) } // st_rdev (tty0)
        Bytes.write64(into, 48, size)
        Bytes.write64(into, 56, 4096) // st_blksize
        Bytes.write64(into, 64, (size + 511) / 512)
        // Every time: when brixOS started.
        const booted = clock.system().bootTime()
        Bytes.write64(into, 72, booted) // st_atime
        Bytes.write64(into, 88, booted) // st_mtime
        Bytes.write64(into, 104, booted) // st_ctime
    }

    // A struct statx (256 bytes) for the same.
    pub const STATX_SIZE: usize = 256
    const STATX_BASIC_STATS: usize = 0x7FF

    pub fn fillStatx(into: [*]u8, kind: Kind, item: usize, size: usize) -> void {
        var plain: [SIZE]u8 = undefined
        fill(&plain, kind, item, size)
        Bytes.fill(into, STATX_SIZE, 0)
        Bytes.write32(into, 0, STATX_BASIC_STATS) // stx_mask
        Bytes.write32(into, 4, 4096) // stx_blksize
        Bytes.write32(into, 16, 1) // stx_nlink
        Bytes.write16(into, 28, Bytes.read32(&plain, 24)) // stx_mode
        Bytes.write64(into, 32, Bytes.read64(&plain, 8)) // stx_ino
        Bytes.write64(into, 40, size)
        Bytes.write64(into, 48, (size + 511) / 512)
        if kind == Kind.terminal { Bytes.write32(into, 128, 4) } // stx_rdev_major (tty)
        const booted = clock.system().bootTime()
        Bytes.write64(into, 64, booted) // stx_atime
        Bytes.write64(into, 80, booted) // stx_btime
        Bytes.write64(into, 96, booted) // stx_ctime
        Bytes.write64(into, 112, booted) // stx_mtime
    }

    // The kind, item and size `path` names, into a struct stat or statx.
    pub fn ofPathAs(path: [*]const u8, into: [*]u8, statx: bool) -> isize {
        const found = Path.lookup(path)
        if found < 0 && found != Path.ROOT { return found }
        const isRoot = found == Path.ROOT
        const index = if isRoot { 0 } else { @bitCast(usize, found) }
        const kind = if isRoot { Kind.directory } else { Kind.file }
        const item = if isRoot { 0 } else { index + 1 }
        const size = if isRoot { 0 } else { archive.Archive.boot().file(index).size }
        if statx { fillStatx(into, kind, item, size) } else { fill(into, kind, item, size) }
        return 0
    }

    pub fn ofPath(path: [*]const u8, into: [*]u8) -> isize {
        const found = Path.lookup(path)
        if found == Path.ROOT {
            fill(into, Kind.directory, 0, 0)
            return 0
        }
        if found < 0 { return found }
        const index = @bitCast(usize, found)
        fill(into, Kind.file, index + 1, archive.Archive.boot().file(index).size)
        return 0
    }
}

pub const Descriptors = struct {
    pub const MAX: usize = 64
    const O_ACCMODE: usize = 3
    const O_CREAT: usize = 0x40
    const O_DIRECTORY: usize = 0x10000
    const O_CLOEXEC: usize = 0x80000
    const DT_DIR: u8 = 4
    const DT_REG: u8 = 8

    slots: [MAX]Descriptor

    // 0, 1 and 2 on the terminal, the rest closed.
    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.slots[k].kind = if k < 3 { Kind.terminal } else { Kind.none }
            self.*.slots[k].index = 0
            self.*.slots[k].offset = 0
            self.*.slots[k].closeOnExec = false
            k += 1
        }
    }

    // One more descriptor of what `d` is (a pipe counts its ends).
    fn retain(d: *const Descriptor) -> void {
        if d.*.kind == Kind.pipe_read { pipes.table().at(d.*.index).*.readers += 1 }
        if d.*.kind == Kind.pipe_write { pipes.table().at(d.*.index).*.writers += 1 }
    }

    fn release(d: *const Descriptor) -> void {
        if d.*.kind == Kind.pipe_read { pipes.table().at(d.*.index).*.readers -= 1 }
        if d.*.kind == Kind.pipe_write { pipes.table().at(d.*.index).*.writers -= 1 }
        if d.*.kind == Kind.pipe_read || d.*.kind == Kind.pipe_write { pipes.table().changed() }
    }

    // `to` becomes a copy of `from` (what `to` was closed first).
    fn place(self: *Self, to: usize, from: *const Descriptor, closeOnExec: bool) -> void {
        retain(from)
        const slot = &self.*.slots[to]
        if slot.*.kind != Kind.none { release(slot) }
        slot.*.kind = from.*.kind
        slot.*.index = from.*.index
        slot.*.offset = from.*.offset
        slot.*.closeOnExec = closeOnExec
    }

    // The descriptors of `other` (a fork's child gets its parent's).
    pub fn copyFrom(self: *Self, other: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.slots[k].kind = Kind.none
            if other.*.slots[k].kind != Kind.none { self.place(k, &other.*.slots[k], other.*.slots[k].closeOnExec) }
            k += 1
        }
    }

    // Every descriptor closed (a process ends).
    pub fn closeAll(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            _ = self.close(@intCast(isize, k))
            k += 1
        }
    }

    // Those marked close-on-exec closed (execve).
    pub fn closeOnExec(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            if self.*.slots[k].closeOnExec { _ = self.close(@intCast(isize, k)) }
            k += 1
        }
    }

    // The open descriptor `fd`; null when it is not one.
    pub fn get(self: *Self, fd: isize) -> ?*Descriptor {
        if fd < 0 || fd >= @intCast(isize, MAX) { return null }
        const slot = &self.*.slots[@bitCast(usize, fd)]
        if slot.*.kind == Kind.none { return null }
        return slot
    }

    pub fn kindOf(self: *Self, fd: isize) -> Kind {
        const slot = self.get(fd)
        if slot == null { return Kind.none }
        return slot.?.*.kind
    }

    fn lowestFree(self: *Self, from: usize) -> isize {
        var k = from
        while k < MAX {
            if self.*.slots[k].kind == Kind.none { return @intCast(isize, k) }
            k += 1
        }
        return Errno.EMFILE
    }

    pub fn open(self: *Self, path: [*]const u8, flags: usize) -> isize {
        const found = Path.lookup(path)
        if found < 0 && found != Path.ROOT { return found }
        const isDirectory = found == Path.ROOT
        if flags & O_ACCMODE != 0 || flags & O_CREAT != 0 { return if isDirectory { Errno.EISDIR } else { Errno.EROFS } }
        if flags & O_DIRECTORY != 0 && !isDirectory { return Errno.ENOTDIR }
        const fd = self.lowestFree(0)
        if fd < 0 { return fd }
        const slot = &self.*.slots[@bitCast(usize, fd)]
        slot.*.kind = if isDirectory { Kind.directory } else { Kind.file }
        slot.*.index = if isDirectory { 0 } else { @bitCast(usize, found) }
        slot.*.offset = 0
        slot.*.closeOnExec = flags & O_CLOEXEC != 0
        return fd
    }

    // A new pipe: its read end at fds[0], its write end at fds[1].
    pub fn pipe(self: *Self, fds: *[2]isize, flags: usize) -> isize {
        const readEnd = self.lowestFree(0)
        if readEnd < 0 { return readEnd }
        self.*.slots[@bitCast(usize, readEnd)].kind = Kind.pipe_read
        const writeEnd = self.lowestFree(0)
        self.*.slots[@bitCast(usize, readEnd)].kind = Kind.none
        if writeEnd < 0 { return writeEnd }
        const index = pipes.table().create()
        if index == pipes.Pipes.MAX { return Errno.ENFILE }
        const ends = [2]isize{ readEnd, writeEnd }
        var k: usize = 0
        while k < 2 {
            const slot = &self.*.slots[@bitCast(usize, ends[k])]
            slot.*.kind = if k == 0 { Kind.pipe_read } else { Kind.pipe_write }
            slot.*.index = index
            slot.*.offset = 0
            slot.*.closeOnExec = flags & O_CLOEXEC != 0
            fds.*[k] = ends[k]
            k += 1
        }
        return 0
    }

    pub fn close(self: *Self, fd: isize) -> isize {
        const slot = self.get(fd)
        if slot == null { return Errno.EBADF }
        release(slot.?)
        slot.?.*.kind = Kind.none
        return 0
    }

    // A copy of `fd` at the lowest free number from `from` on.
    pub fn duplicate(self: *Self, fd: isize, from: usize, closeOnExec: bool) -> isize {
        const slot = self.get(fd)
        if slot == null { return Errno.EBADF }
        const copy = self.lowestFree(from)
        if copy < 0 { return copy }
        self.place(@bitCast(usize, copy), slot.?, closeOnExec)
        return copy
    }

    // A copy of `fd` as `to` (closing what `to` was).
    pub fn duplicateTo(self: *Self, fd: isize, to: isize) -> isize {
        const slot = self.get(fd)
        if slot == null || to < 0 || to >= @intCast(isize, MAX) { return Errno.EBADF }
        if fd != to { self.place(@bitCast(usize, to), slot.?, false) }
        return to
    }

    // A read: the bytes, 0 at the end, -errno, or wait.BLOCKED with what
    // to wait for in `waiting`.
    pub fn read(self: *Self, fd: isize, into: [*]u8, capacity: usize, waiting: *wait.Wait) -> isize {
        const slot = self.get(fd)
        if slot == null { return Errno.EBADF }
        const d = slot.?
        if d.*.kind == Kind.terminal {
            const result = terminal.serialConsole().read(into, capacity)
            if result == wait.BLOCKED { waiting.* = wait.Wait.on(wait.WaitKind.terminal, 0, 0) }
            return result
        }
        if d.*.kind == Kind.pipe_read {
            const end = pipes.table().at(d.*.index)
            if capacity == 0 { return 0 }
            if end.*.count == 0 {
                if end.*.writers == 0 { return 0 }
                waiting.* = wait.Wait.on(wait.WaitKind.pipe_read, @intCast(isize, d.*.index), 0)
                return wait.BLOCKED
            }
            pipes.table().changed()
            return @intCast(isize, end.read(into, capacity))
        }
        if d.*.kind == Kind.directory { return Errno.EISDIR }
        if d.*.kind != Kind.file { return Errno.EBADF }
        return readFile(d, into, capacity)
    }

    fn readFile(d: *Descriptor, into: [*]u8, capacity: usize) -> isize {
        const file = archive.Archive.boot().file(d.*.index)
        var count: usize = 0
        while count < capacity && d.*.offset < file.size {
            into[count] = file.data[d.*.offset]
            d.*.offset += 1
            count += 1
        }
        return @intCast(isize, count)
    }

    // A write: the bytes taken, -errno, or wait.BLOCKED (a full pipe).
    pub fn write(self: *Self, fd: isize, from: [*]const u8, length: usize, waiting: *wait.Wait) -> isize {
        const slot = self.get(fd)
        if slot == null { return Errno.EBADF }
        const d = slot.?
        if d.*.kind == Kind.terminal {
            terminal.serialConsole().write(from, length)
            return @intCast(isize, length)
        }
        if d.*.kind == Kind.pipe_write {
            const end = pipes.table().at(d.*.index)
            if end.*.readers == 0 { return Errno.EPIPE }
            if length == 0 { return 0 }
            if end.*.count == pipes.Pipe.CAPACITY {
                waiting.* = wait.Wait.on(wait.WaitKind.pipe_write, @intCast(isize, d.*.index), 0)
                return wait.BLOCKED
            }
            pipes.table().changed()
            return @intCast(isize, end.write(from, length))
        }
        return Errno.EBADF
    }

    pub fn seek(self: *Self, fd: isize, to: isize, whence: usize) -> isize {
        const slot = self.get(fd)
        if slot == null { return Errno.EBADF }
        const d = slot.?
        if d.*.kind != Kind.file && d.*.kind != Kind.directory { return Errno.ESPIPE }
        if whence > 2 { return Errno.EINVAL }
        var base: isize = 0
        if whence == 1 { base = @intCast(isize, d.*.offset) }
        if whence == 2 && d.*.kind == Kind.file { base = @intCast(isize, archive.Archive.boot().file(d.*.index).size) }
        const position = base + to
        if position < 0 { return Errno.EINVAL }
        d.*.offset = @bitCast(usize, position)
        return position
    }

    pub fn status(self: *Self, fd: isize, into: [*]u8) -> isize { return self.statusAs(fd, into, false) }

    // fstat's struct stat, or statx's.
    pub fn statusAs(self: *Self, fd: isize, into: [*]u8, statx: bool) -> isize {
        const slot = self.get(fd)
        if slot == null { return Errno.EBADF }
        const d = slot.?
        const size = if d.*.kind == Kind.file { archive.Archive.boot().file(d.*.index).size } else { 0 }
        const item = if d.*.kind == Kind.file { d.*.index + 1 } else { 0 }
        if statx { Status.fillStatx(into, d.*.kind, item, size) } else { Status.fill(into, d.*.kind, item, size) }
        return 0
    }

    // Whether `fd` could be read (POLLIN) or written (POLLOUT) without
    // waiting.
    pub fn readable(self: *Self, fd: isize) -> bool {
        const slot = self.get(fd)
        if slot == null { return false }
        const d = slot.?
        if d.*.kind == Kind.terminal { return terminal.serialConsole().pending() }
        if d.*.kind == Kind.pipe_read { return pipes.table().at(d.*.index).readable() }
        return d.*.kind == Kind.file || d.*.kind == Kind.directory
    }

    pub fn writable(self: *Self, fd: isize) -> bool {
        const slot = self.get(fd)
        if slot == null { return false }
        const d = slot.?
        if d.*.kind == Kind.pipe_write { return pipes.table().at(d.*.index).writable() }
        return d.*.kind == Kind.terminal
    }

    // getdents64 on the root: ".", "..", then the archive's files.
    pub fn entries(self: *Self, fd: isize, into: [*]u8, capacity: usize) -> isize {
        const slot = self.get(fd)
        if slot == null { return Errno.EBADF }
        const d = slot.?
        if d.*.kind != Kind.directory { return Errno.ENOTDIR }
        const files = archive.Archive.boot()
        var used: usize = 0
        while d.*.offset < files.count() + 2 {
            const at = d.*.offset
            var name: [*]const u8 = undefined
            var nameLength: usize = 0
            if at < 2 {
                name = unsafe { @ptrCast([*]const u8, "..") }
                nameLength = at + 1
            } else {
                name = files.name(at - 2)
                nameLength = files.nameLength(at - 2)
            }
            // d_ino, d_off, d_reclen, d_type, the name and its NUL, to 8.
            const size = (19 + nameLength + 1 + 7) / 8 * 8
            if used + size > capacity {
                if used == 0 { return Errno.EINVAL }
                break
            }
            const entry: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(into) + used) }
            Bytes.fill(entry, size, 0)
            Bytes.write64(entry, 0, at + 1)
            Bytes.write64(entry, 8, at + 1)
            Bytes.write16(entry, 16, size)
            entry[18] = if at < 2 { DT_DIR } else { DT_REG }
            Bytes.copy(unsafe { @ptrFromInt([*]u8, @intFromPtr(entry) + 19) }, name, nameLength)
            used += size
            d.*.offset += 1
        }
        return @intCast(isize, used)
    }
}
