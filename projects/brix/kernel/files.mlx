// Descriptors: the terminal (0, 1 and 2 at the start), the boot archive's
// files (read only, all in the root directory) and the root directory.
const archive = @import("./archive.mlx")
const tty = @import("./tty.mlx")

pub const MAX: usize = 64
pub const NONE: u8 = 0
pub const TERMINAL: u8 = 1
pub const FILE: u8 = 2
pub const DIRECTORY: u8 = 3

pub const ENOENT: isize = -2
pub const EBADF: isize = -9
pub const EINVAL: isize = -22
pub const EMFILE: isize = -24
pub const ENOTTY: isize = -25
pub const EROFS: isize = -30
pub const ENOTDIR: isize = -20
pub const EISDIR: isize = -21

var kind: [MAX]u8 = undefined // (per run)
var index: [MAX]usize = undefined // (per run)
var offset: [MAX]usize = undefined // (per run)
var closeOnExec: [MAX]bool = undefined // (per run)

pub fn init() -> void {
    var k: usize = 0
    while k < MAX {
        kind[k] = NONE
        index[k] = 0
        offset[k] = 0
        closeOnExec[k] = false
        k += 1
    }
    kind[0] = TERMINAL
    kind[1] = TERMINAL
    kind[2] = TERMINAL
}

fn valid(fd: isize) -> bool { return fd >= 0 && fd < @intCast(isize, MAX) && kind[@bitCast(usize, fd)] != NONE }

pub fn kindOf(fd: isize) -> u8 {
    if !valid(fd) { return NONE }
    return kind[@bitCast(usize, fd)]
}

fn lowestFree(from: usize) -> isize {
    var k = from
    while k < MAX {
        if kind[k] == NONE { return @intCast(isize, k) }
        k += 1
    }
    return EMFILE
}

// A path: "/" is the root, "/NAME", "./NAME" and "NAME" an archive file.
// The file's index, MAX for the root, -ENOENT.
pub fn lookup(path: [*]const u8) -> isize {
    var start: usize = 0
    while path[start] == 47 { start += 1 }
    if path[start] == 46 && path[start + 1] == 47 {
        start += 2
        while path[start] == 47 { start += 1 }
    }
    var end = start
    while path[end] != 0 { end += 1 }
    while end > start && path[end - 1] == 47 { end -= 1 }
    if end == start || (end == start + 1 && path[start] == 46) { return @intCast(isize, MAX) }
    var k: usize = 0
    while k < archive.count() {
        if archive.nameLength(k) == end - start {
            const name = archive.name(k)
            var j: usize = 0
            while j < end - start && name[j] == path[start + j] { j += 1 }
            if j == end - start { return @intCast(isize, k) }
        }
        k += 1
    }
    return ENOENT
}

pub fn open(path: [*]const u8, flags: usize) -> isize {
    const found = lookup(path)
    if found < 0 { return found }
    if flags & 3 != 0 || flags & 0x40 != 0 { return if found == @intCast(isize, MAX) { EISDIR } else { EROFS } }
    const isDirectory = found == @intCast(isize, MAX)
    if flags & 0x10000 != 0 && !isDirectory { return ENOTDIR }
    const fd = lowestFree(0)
    if fd < 0 { return fd }
    const slot = @bitCast(usize, fd)
    kind[slot] = if isDirectory { DIRECTORY } else { FILE }
    index[slot] = @bitCast(usize, found)
    offset[slot] = 0
    closeOnExec[slot] = flags & 0x80000 != 0
    return fd
}

pub fn close(fd: isize) -> isize {
    if !valid(fd) { return EBADF }
    kind[@bitCast(usize, fd)] = NONE
    return 0
}

pub fn duplicate(fd: isize, from: usize, cloexec: bool) -> isize {
    if !valid(fd) { return EBADF }
    const copy = lowestFree(from)
    if copy < 0 { return copy }
    copyTo(@bitCast(usize, fd), @bitCast(usize, copy))
    closeOnExec[@bitCast(usize, copy)] = cloexec
    return copy
}

fn copyTo(from: usize, to: usize) -> void {
    kind[to] = kind[from]
    index[to] = index[from]
    offset[to] = offset[from]
    closeOnExec[to] = false
}

pub fn duplicateTo(fd: isize, to: isize) -> isize {
    if !valid(fd) || to < 0 || to >= @intCast(isize, MAX) { return EBADF }
    if fd != to { copyTo(@bitCast(usize, fd), @bitCast(usize, to)) }
    return to
}

pub fn setCloseOnExec(fd: isize, value: bool) -> void {
    if valid(fd) { closeOnExec[@bitCast(usize, fd)] = value }
}

pub fn getCloseOnExec(fd: isize) -> bool { return valid(fd) && closeOnExec[@bitCast(usize, fd)] }

pub fn read(fd: isize, into: [*]u8, capacity: usize) -> isize {
    if !valid(fd) { return EBADF }
    const slot = @bitCast(usize, fd)
    if kind[slot] == TERMINAL { return @intCast(isize, tty.read(into, capacity)) }
    if kind[slot] == DIRECTORY { return EISDIR }
    const file = archive.file(index[slot])
    var count: usize = 0
    while count < capacity && offset[slot] < file.size {
        into[count] = file.data[offset[slot]]
        offset[slot] += 1
        count += 1
    }
    return @intCast(isize, count)
}

pub fn write(fd: isize, from: [*]const u8, length: usize) -> isize {
    if !valid(fd) { return EBADF }
    if kind[@bitCast(usize, fd)] != TERMINAL { return EBADF }
    tty.write(from, length)
    return @intCast(isize, length)
}

pub fn seek(fd: isize, to: isize, whence: usize) -> isize {
    if !valid(fd) { return EBADF }
    const slot = @bitCast(usize, fd)
    if kind[slot] == TERMINAL { return -29 }
    var base: isize = 0
    if whence == 1 { base = @intCast(isize, offset[slot]) }
    if whence == 2 { base = if kind[slot] == FILE { @intCast(isize, archive.file(index[slot]).size) } else { 0 } }
    if whence > 2 { return EINVAL }
    const position = base + to
    if position < 0 { return EINVAL }
    offset[slot] = @bitCast(usize, position)
    return position
}

fn put64(into: [*]u8, at: usize, value: usize) -> void {
    var k: usize = 0
    while k < 8 {
        into[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 255)
        k += 1
    }
}

// A struct stat (144 bytes) for the kind of thing and its size.
pub fn fillStatus(into: [*]u8, what: u8, item: usize, size: usize) -> void {
    var k: usize = 0
    while k < 144 {
        into[k] = 0
        k += 1
    }
    var mode: usize = 0x81ED
    if what == TERMINAL { mode = 0x2190 }
    if what == DIRECTORY { mode = 0x41ED }
    put64(into, 0, 1)
    put64(into, 8, item + 2)
    put64(into, 16, 1)
    into[24] = @intCast(u8, mode & 255)
    into[25] = @intCast(u8, mode >> 8)
    if what == TERMINAL { put64(into, 40, 0x400) }
    put64(into, 48, size)
    put64(into, 56, 4096)
    put64(into, 64, (size + 511) / 512)
}

pub fn status(fd: isize, into: [*]u8) -> isize {
    if !valid(fd) { return EBADF }
    const slot = @bitCast(usize, fd)
    const size = if kind[slot] == FILE { archive.file(index[slot]).size } else { 0 }
    fillStatus(into, kind[slot], index[slot], size)
    return 0
}

pub fn statusOf(path: [*]const u8, into: [*]u8) -> isize {
    const found = lookup(path)
    if found < 0 { return found }
    if found == @intCast(isize, MAX) {
        fillStatus(into, DIRECTORY, MAX, 0)
    } else {
        fillStatus(into, FILE, @bitCast(usize, found), archive.file(@bitCast(usize, found)).size)
    }
    return 0
}

// getdents64 on the root: ".", "..", then the archive's files.
pub fn entries(fd: isize, into: [*]u8, capacity: usize) -> isize {
    if !valid(fd) { return EBADF }
    const slot = @bitCast(usize, fd)
    if kind[slot] != DIRECTORY { return ENOTDIR }
    var used: usize = 0
    while offset[slot] < archive.count() + 2 {
        const at = offset[slot]
        var nameLength: usize = 0
        var name: [*]const u8 = undefined
        if at == 0 {
            name = unsafe { @ptrCast([*]const u8, ".") }
            nameLength = 1
        } else if at == 1 {
            name = unsafe { @ptrCast([*]const u8, "..") }
            nameLength = 2
        } else {
            name = archive.name(at - 2)
            nameLength = archive.nameLength(at - 2)
        }
        const size = (19 + nameLength + 1 + 7) / 8 * 8
        if used + size > capacity {
            if used == 0 { return EINVAL }
            break
        }
        put64(into, used, at + 1)
        put64(into, used + 8, at + 1)
        into[used + 16] = @intCast(u8, size & 255)
        into[used + 17] = @intCast(u8, size >> 8)
        into[used + 18] = if at < 2 { 4 } else { 8 }
        var k: usize = 0
        while k < nameLength {
            into[used + 19 + k] = name[k]
            k += 1
        }
        k = 19 + nameLength
        while k < size {
            into[used + k] = 0
            k += 1
        }
        used += size
        offset[slot] += 1
    }
    return @intCast(isize, used)
}
