// The display controller of a Polaris card (DCE 11.2) read out: what the
// firmware left running, said in the kernel's log decoded and raw, checked
// for whether it fits together, and what the next stage would write for a
// picture of the size the controller shows (the monitor's own when the
// firmware runs the monitor's timing; the monitor's EDID is not read here,
// so the log says the size and leaves that to its reader). Nothing here
// writes to the card: the card is reached through `Card`, which can only
// read a register, so the same code reads a table of numbers in a test
// built for the host (tests/452_gpu_display_readout_runtime.mlx).
// (The stage after this one: edid.mlx reads the monitor's own timing,
// gpu_mode.mlx plans the monitor's own mode from this read-out for both
// situations below, step by step, and gpu_set.mlx carries a plan out when
// the image asks. The "next stage" and "would set" lines here stay as
// they were said before those were there. And for what (b) needs on a
// TMDS output (HDMI, DVI): gpu_rom.mlx reads the card's video BIOS ROM,
// which says which connector an encoder's block is, atom.mlx runs the
// ROM's tables that set a pixel clock's PLL and a transmitter,
// gpu_blocks.mlx fills what those tables are told, and gpu_mode.mlx's
// plan for that output has their runs among its steps.)
//
// Two things can be found on the machine (an RX 580 whose firmware offers
// only small pictures, 1280x960 the loader's, on a monitor of 3840x1080):
// (a) the controller runs the monitor's own timing and the card's scaler
//     makes the small picture large: a picture of the monitor's size then
//     needs only the surface, the viewport, the scaler and the line
//     buffer set on the running controller (`plan` says with what);
// (b) the controller runs the small picture's timing and the monitor
//     stretches it: then the pixel clock, the timing and the link have to
//     be set, which is not here (gpu_mode.mlx plans it).
//
// The register numbers are Linux 6.6's, each one looked up in its headers
// (none is from memory): drivers/gpu/drm/amd/include/asic_reg/dce/
// dce_11_2_d.h for the numbers and dce_11_2_sh_mask.h for the fields,
// amdgpu/vid.h for where controller 1 to 5 and the encoders have theirs
// (CRTCn_REGISTER_OFFSET, DIGn_REGISTER_OFFSET), gmc/gmc_8_1_d.h for
// MC_VM_FB_LOCATION. What a field means is from amdgpu/dce_v11_0.c
// (dce_v11_0_crtc_do_set_base) and the display core's dce110 code
// (dce110_timing_generator.c, dce_transform.c, dce_link_encoder.c,
// dce_stream_encoder.c, dce_clock_source.c). The names are the headers'
// without their "mm". The machine's read-out still has to confirm them:
// `check` holds the decoded numbers against one another and against the
// firmware's picture, and no conclusion is drawn from numbers that do not
// fit.
//
// Only registers are read whose reading changes nothing. Left out, though
// they lie in the same blocks: the colour table's data (DC_LUT_SEQ_COLOR,
// DC_LUT_PWL_DATA, DC_LUT_30_COLOR at 0x1a7a to 0x1a7c: a read moves the
// table's index on) and, being windows onto something else by an index
// as well, the scaler's coefficient memory (SCL_COEF_RAM_SELECT and
// SCL_COEF_RAM_TAP_DATA, 0x1b40 and 0x1b41) and the blocks' test
// registers (an index and a data register each).

pub const CONTROLLERS: usize = 6

// Where controller n has its registers: controller 0's numbers plus this
// (vid.h, CRTC0_REGISTER_OFFSET to CRTC5_REGISTER_OFFSET).
pub const OFFSETS = [_]usize{ 0x0, 0x200, 0x400, 0x2600, 0x2800, 0x2A00 }

// The primary surface (the header's DCP block).
pub const GRPH_ENABLE: usize = 0x1A00
pub const GRPH_CONTROL: usize = 0x1A01
pub const GRPH_PRIMARY_SURFACE_ADDRESS: usize = 0x1A04
pub const GRPH_PITCH: usize = 0x1A06
pub const GRPH_PRIMARY_SURFACE_ADDRESS_HIGH: usize = 0x1A07
pub const GRPH_X_START: usize = 0x1A0B
pub const GRPH_Y_START: usize = 0x1A0C
pub const GRPH_X_END: usize = 0x1A0D
pub const GRPH_Y_END: usize = 0x1A0E
// The line buffer (LB) the surface's rows pass through, the scaler (SCL)
// with the viewport and the borders.
pub const LB_MEMORY_CTRL: usize = 0x1AC1
pub const SCL_MODE: usize = 0x1B42
pub const SCL_TAP_CONTROL: usize = 0x1B43
pub const SCL_BYPASS_CONTROL: usize = 0x1B45
pub const SCL_HORZ_FILTER_SCALE_RATIO: usize = 0x1B49
pub const SCL_VERT_FILTER_SCALE_RATIO: usize = 0x1B4C
pub const VIEWPORT_START: usize = 0x1B5C
pub const VIEWPORT_SIZE: usize = 0x1B5D
pub const EXT_OVERSCAN_LEFT_RIGHT: usize = 0x1B5E
pub const EXT_OVERSCAN_TOP_BOTTOM: usize = 0x1B5F
// The timing (CRTC).
pub const CRTC_H_TOTAL: usize = 0x1B80
pub const CRTC_H_BLANK_START_END: usize = 0x1B81
pub const CRTC_H_SYNC_A: usize = 0x1B82
pub const CRTC_H_SYNC_A_CNTL: usize = 0x1B83
pub const CRTC_V_TOTAL: usize = 0x1B87
pub const CRTC_V_BLANK_START_END: usize = 0x1B8D
pub const CRTC_V_SYNC_A: usize = 0x1B8E
pub const CRTC_V_SYNC_A_CNTL: usize = 0x1B8F
pub const CRTC_CONTROL: usize = 0x1B9C
pub const CRTC_BLANK_CONTROL: usize = 0x1B9D
pub const CRTC_INTERLACE_CONTROL: usize = 0x1B9E
pub const CRTC_STATUS_FRAME_COUNT: usize = 0x1BA6

// Not at the controllers' offsets. Whether a controller shows the VGA's
// picture instead of its surface (D1VGA_CONTROL to D6VGA_CONTROL):
pub const VGA_CONTROL = [_]usize{ 0xCC, 0xCE, 0xF8, 0xF9, 0xFA, 0xFB }
// Where a controller's pixel clock comes from, four registers each from
// 0x140 on: CRTCn_PIXEL_RATE_CNTL, DP_DTOn_PHASE, DP_DTOn_MODULO,
// CRTCn_PHYPLL_PIXEL_RATE_CNTL.
pub const CRTC0_PIXEL_RATE_CNTL: usize = 0x140
pub const DP_DTO0_PHASE: usize = 0x141
pub const DP_DTO0_MODULO: usize = 0x142
pub const CRTC0_PHYPLL_PIXEL_RATE_CNTL: usize = 0x143
// How many buffers a controller's rows are read from memory through, a
// register each from PIPE0_DMIF_BUFFER_CONTROL on.
pub const PIPE0_DMIF_BUFFER_CONTROL: usize = 0x321
// Where the card's memory lies in the card's own addresses (the memory
// controller's; a surface's address is one of these): its first and last
// 16 MiB in the low and the high half.
pub const MC_VM_FB_LOCATION: usize = 0x809

// The encoders (DIG): seven back ends (a link each) and six front ends (a
// stream each), a back end and a front end in one block (vid.h,
// DIG0_REGISTER_OFFSET to DIG6_REGISTER_OFFSET on 0x4a00). A front end
// names the controller it takes its picture from, a back end the front
// ends it sends.
pub const BACK_ENDS: usize = 7
pub const FRONT_ENDS: usize = 6
pub const DIG = [_]usize{ 0x4A00, 0x4B00, 0x4C00, 0x4D00, 0x4E00, 0x4F00, 0x5400 }
pub const DIG_FE_CNTL: usize = 0x00
pub const HDMI_CONTROL: usize = 0x09
pub const DIG_BE_CNTL: usize = 0x47
pub const DIG_BE_EN_CNTL: usize = 0x48
pub const DP_LINK_CNTL: usize = 0xA0
pub const DP_PIXEL_FORMAT: usize = 0xA1
pub const DP_CONFIG: usize = 0xA3
pub const DP_VID_STREAM_CNTL: usize = 0xA4
pub const DP_VID_TIMING: usize = 0xA8
pub const DP_VID_N: usize = 0xA9
pub const DP_VID_M: usize = 0xAA

// What a back end sends (DIG_BE_CNTL's DIG_MODE, as dce110_link_encoder_
// setup writes it).
pub const MODE_DISPLAYPORT: usize = 0
pub const MODE_LVDS: usize = 1
pub const MODE_DVI: usize = 2
pub const MODE_HDMI: usize = 3
pub const MODE_DISPLAYPORT_MST: usize = 5

// A controller's registers that the raw dump lists, first and last of each
// run, as controller 0 has them; every number in a run is a register the
// header names. The surface (GRPH_ENABLE to GRPH_PIPE_OUTSTANDING_
// REQUEST_LIMIT, without GRPH_SURFACE_COUNTER_CONTROL at 0x1a0f, which
// says nothing of the picture):
const SURFACE_RUNS = [_]usize{ 0x1A00, 0x1A0E, 0x1A10, 0x1A1C }
// The line buffer's format, memory and height, the memory interface's
// arbitration and watermarks (DPG_PIPE_ARBITRATION_CONTROL1 to
// DPG_PIPE_STUTTER_CONTROL_NONLPTCH), the scaler from SCL_MODE on, its
// update word, the viewport and the borders, the blender's control:
const SCALER_RUNS = [_]usize{ 0x1AC0, 0x1AC3, 0x1B30, 0x1B37, 0x1B42, 0x1B4F, 0x1B51, 0x1B51, 0x1B5B, 0x1B5F, 0x1B6D, 0x1B6D }
// The timing from CRTC_H_TOTAL to CRTC_V_SYNC_B_CNTL, CRTC_CONTROL to
// CRTC_STATUS_HV_COUNT, the update locks, CRTC_MASTER_EN, and the
// formatter's control and bit depth:
const TIMING_RUNS = [_]usize{ 0x1B80, 0x1B91, 0x1B9C, 0x1BA8, 0x1BB5, 0x1BB6, 0x1BBD, 0x1BBE, 0x1BC2, 0x1BC2, 0x1BEE, 0x1BEE, 0x1BF2, 0x1BF2 }

// An encoder block's registers that the raw dump lists (not runs: the
// blocks hold much that is of no use here).
const DIG_LISTED = [_]usize{ DIG_FE_CNTL, HDMI_CONTROL, DIG_BE_CNTL, DIG_BE_EN_CNTL, DP_LINK_CNTL, DP_PIXEL_FORMAT, DP_CONFIG, DP_VID_STREAM_CNTL, DP_VID_TIMING, DP_VID_N, DP_VID_M }

// The card as this file reaches it: a register read by its number (a
// dword offset, as the headers count), a clock, and the log.
pub const Card = struct {
    read: fn(usize) -> u32
    // Nanoseconds, only ever more (for the frames counted in a second).
    now: fn() -> usize
    write: fn([]const u8) -> void

    pub fn reg(self: *const Self, number: usize) -> usize {
        const read = self.*.read
        return @intCast(usize, read(number))
    }

    pub fn time(self: *const Self) -> usize {
        const now = self.*.now
        return now()
    }

    pub fn say(self: *const Self, text: []const u8) -> void {
        const write = self.*.write
        write(text)
    }

    pub fn decimal(self: *const Self, value: usize) -> void {
        var digits: [20]u8 = undefined
        var at: usize = 20
        var rest = value
        while true {
            at -= 1
            digits[at] = @intCast(u8, 48 + rest % 10)
            rest = rest / 10
            if rest == 0 { break }
        }
        self.say(digits[at..20])
    }

    // `digits` hex digits of a number, the highest first.
    pub fn hexDigits(self: *const Self, value: usize, digits: usize) -> void {
        var text: [16]u8 = undefined
        var k: usize = 0
        while k < digits && k < 16 {
            const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
            text[k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
            k += 1
        }
        self.say(text[0..k])
    }

    pub fn hex(self: *const Self, value: usize) -> void {
        var digits: usize = 1
        while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
        self.say("0x")
        self.hexDigits(value, digits)
    }

    // A label and a number after it: decimal, hex ("0x1f"), a size
    // ("3840x1080"), two places ("3952..112").
    pub fn field(self: *const Self, label: []const u8, value: usize) -> void {
        self.say(label)
        self.decimal(value)
    }

    pub fn fieldHex(self: *const Self, label: []const u8, value: usize) -> void {
        self.say(label)
        self.hex(value)
    }

    pub fn size(self: *const Self, label: []const u8, width: usize, height: usize) -> void {
        self.field(label, width)
        self.field("x", height)
    }

    pub fn span(self: *const Self, label: []const u8, from: usize, to: usize) -> void {
        self.field(label, from)
        self.field("..", to)
    }

    // "gpu: controller 2".
    pub fn controller(self: *const Self, index: usize) -> void { self.field("gpu: controller ", index) }
}

// What the kernel knows of the card's memory and of the firmware's picture
// without the display controller: how much of the card's memory the
// processor reaches (the aperture in the kernel's view), and the picture
// the loader was given, when it lies in this card's aperture (a width of 0:
// it does not, or there is none): where, how many bytes, its size in
// pixels and the pixels from one row to the next.
pub const Memory = struct {
    aperture: usize
    pictureOffset: usize
    pictureBytes: usize
    pictureWidth: usize
    pictureHeight: usize
    picturePitch: usize
}

// The encoder a controller's picture leaves the card by.
pub const Encoder = struct {
    found: bool
    backEnd: usize
    frontEnd: usize
    mode: usize
    // A DisplayPort link's lanes, whether its training is complete and its
    // video stream is on.
    lanes: usize
    trained: bool
    stream: bool
}

// How fast a controller runs, counted on its frame counter against the
// clock: frames in nanoseconds (0 frames: nothing counted), and what
// follows from the totals.
pub const Rate = struct {
    frames: usize
    nanoseconds: usize
    // Frames in a thousand seconds, and the pixel clock in kHz.
    millihertz: usize
    kilohertz: usize
}

// One controller, decoded.
pub const Controller = struct {
    index: usize
    // CRTC_CONTROL as read; on: its CRTC_MASTER_EN (a word of all ones is
    // a block that does not answer, taken as off).
    control: usize
    on: bool
    vga: bool
    blanked: bool
    interlaced: bool
    // The timing, in pixels and lines: the totals, where the blanking
    // starts and ends, the sync pulse (and whether it is the low one),
    // and the size shown between the blankings.
    hTotal: usize
    hBlankStart: usize
    hBlankEnd: usize
    hSyncStart: usize
    hSyncEnd: usize
    hSyncLow: bool
    vTotal: usize
    vBlankStart: usize
    vBlankEnd: usize
    vSyncStart: usize
    vSyncEnd: usize
    vSyncLow: bool
    width: usize
    height: usize
    // The primary surface: on, its control word (GRPH_DEPTH 2 is 32 bits
    // a pixel, GRPH_FORMAT 0 with it eight bits a colour, GRPH_ARRAY_MODE
    // 0 and 1 rows one after another), its address among the card's own,
    // the pixels from row to row, and the part of it in use.
    surfaceOn: bool
    surfaceControl: usize
    depth: usize
    format: usize
    arrayMode: usize
    address: usize
    pitch: usize
    xStart: usize
    yStart: usize
    xEnd: usize
    yEnd: usize
    // The viewport: the part of the surface that is shown.
    viewportX: usize
    viewportY: usize
    viewportWidth: usize
    viewportHeight: usize
    // The scaler: its mode (0: off, the viewport goes out as it is) and
    // the prescaler bit beside it in the same word (SCL_PSCL_EN: the
    // display core sets and clears it with the mode), SCL_BYPASS_MODE, the
    // filters' taps, the ratios (picture to shown, in 2^-24), and the
    // borders it leaves around what it makes.
    scalerMode: usize
    prescaler: bool
    scalerBypass: usize
    hTaps: usize
    vTaps: usize
    hRatio: usize
    vRatio: usize
    left: usize
    right: usize
    top: usize
    bottom: usize
    // The line buffer's memory (LB_MEMORY_CTRL's LB_MEMORY_CONFIG: 0 all
    // three pieces of it, 1 and 2 less, for narrower rows; and its
    // LB_MEMORY_SIZE) and the buffers the rows are read through
    // (DMIF_BUFFERS_ALLOCATED).
    lineBuffer: usize
    lineBufferSize: usize
    buffers: usize
    // The pixel clock's source: CRTCn_PIXEL_RATE_CNTL (its DP_DTOn_ENABLE:
    // the clock is made for a DisplayPort link, phase over modulo of a
    // reference) and CRTCn_PHYPLL_PIXEL_RATE_CNTL.
    rateControl: usize
    dto: bool
    dtoPhase: usize
    dtoModulo: usize
    phyPll: usize
    encoder: Encoder
    rate: Rate

    // The size the scaler has to fill: what is shown less the borders.
    pub fn filledWidth(self: *const Self) -> usize { return less(self.*.width, self.*.left + self.*.right) }

    pub fn filledHeight(self: *const Self) -> usize { return less(self.*.height, self.*.top + self.*.bottom) }

    pub fn surfaceWidth(self: *const Self) -> usize { return less(self.*.xEnd, self.*.xStart) }

    pub fn surfaceHeight(self: *const Self) -> usize { return less(self.*.yEnd, self.*.yStart) }

    // Where in the card's memory (counted from `base`) the first pixel
    // shown lies: the viewport's start in the surface.
    pub fn firstShown(self: *const Self, base: usize) -> usize {
        return less(self.*.address, base) + (self.*.viewportY * self.*.pitch + self.*.viewportX) * 4
    }

    // Whether the viewport is the size to fill (amdgpu makes a viewport's
    // height even: a line more or less is the same).
    fn fills(self: *const Self) -> bool {
        return self.*.viewportWidth == self.filledWidth() && less(self.*.viewportHeight, self.filledHeight()) <= 1 && less(self.filledHeight(), self.*.viewportHeight) <= 1
    }
}

// What does not fit in a controller's numbers (`check`).
pub const Fault = enum(u8) { none, memory, vga, totals, no_surface, extent, depth, tiled, pitch, address, viewport, picture, scaler }

// What a controller shows.
pub const Shows = enum(u8) {
    // Nothing: it is off.
    off,
    // The monitor's timing, the picture made larger or smaller by the
    // card's scaler (a).
    scaled,
    // A timing larger than the picture, which stands in borders (the
    // same for the next stage as scaled).
    bordered,
    // The picture as it is: the timing is the picture's (b).
    as_it_is,
    // Its numbers do not fit together: nothing is concluded.
    not_plausible
}

// What the next stage would write for a picture of the size a controller
// shows (situation a): a surface in the aperture after the firmware's
// picture, shown whole, the scaler off (SCL_MODE's mode and its prescaler
// bit both 0, as dce_transform.c's setup_scaling_configuration leaves them
// for a picture that is not scaled), the line buffer wide enough.
pub const Plan = struct {
    // Whether there is room in the aperture.
    fits: bool
    width: usize
    height: usize
    // Pixels from row to row (a multiple of 64, as amdgpu aligns it).
    pitch: usize
    // Where in the aperture, how many bytes, and the card's own address
    // of it (GRPH_PRIMARY_SURFACE_ADDRESS_HIGH and _ADDRESS, the
    // secondary ones the same).
    offset: usize
    bytes: usize
    address: usize
    // GRPH_CONTROL, kept: the new picture is drawn as the firmware's is.
    control: usize
    // LB_MEMORY_CONFIG: all of the line buffer's memory, which rows of
    // 2560 pixels and more need (dce_v11_0_line_buffer_adjust; the display
    // core takes all of it always).
    lineBuffer: usize
}

// The whole read-out, kept for the next stage.
pub const Readout = struct {
    // The card's memory among its own addresses (MC_VM_FB_LOCATION, raw
    // and as first and last address).
    location: usize
    base: usize
    top: usize
    controllers: [CONTROLLERS]Controller
    shows: [CONTROLLERS]Shows
    faults: [CONTROLLERS]Fault
    // How many controllers are on, and whether the numbers of all of
    // them fit.
    on: usize
    plausible: bool
}

// a - b, 0 when b is the larger.
fn less(a: usize, b: usize) -> usize { return if a > b { a - b } else { 0 } }

// Whether two ratios are the same but for their last bits (a part in 256).
fn near(a: usize, b: usize) -> bool { return less(a, b) + less(b, a) <= b / 256 + 1 }

// The size between two blankings: from where one ends to where the next
// starts, around the total when the counter starts anew in between.
fn active(start: usize, end: usize, total: usize) -> usize {
    if start >= end { return start - end }
    return less(total, end - start)
}

// The encoder that takes controller `index`: the back end that is on
// (DIG_BE_EN_CNTL's DIG_ENABLE) and sends a front end (DIG_BE_CNTL's
// DIG_FE_SOURCE_SELECT, a bit each) whose source (DIG_FE_CNTL's
// DIG_SOURCE_SELECT) is the controller.
fn encoderOf(card: *const Card, index: usize) -> Encoder {
    var found = Encoder.{ .found = false, .backEnd = 0, .frontEnd = 0, .mode = 0, .lanes = 0, .trained = false, .stream = false }
    var back: usize = 0
    while back < BACK_ENDS {
        const enabled = card.reg(DIG[back] + DIG_BE_EN_CNTL)
        const control = card.reg(DIG[back] + DIG_BE_CNTL)
        if enabled != 0xFFFFFFFF && enabled & 1 != 0 && control != 0xFFFFFFFF {
            var front: usize = 0
            while front < FRONT_ENDS {
                if (control >> @intCast(u6, 8 + front)) & 1 != 0 && card.reg(DIG[front] + DIG_FE_CNTL) & 7 == index {
                    found.found = true
                    found.backEnd = back
                    found.frontEnd = front
                    found.mode = (control >> 16) & 7
                    found.lanes = (card.reg(DIG[back] + DP_CONFIG) & 3) + 1
                    found.trained = card.reg(DIG[back] + DP_LINK_CNTL) & 0x10 != 0
                    found.stream = card.reg(DIG[front] + DP_VID_STREAM_CNTL) & 1 != 0
                    return found
                }
                front += 1
            }
        }
        back += 1
    }
    return found
}

// How long the frame counter is waited for to move at all, and how long
// frames are counted at most (nanoseconds); and how many are enough.
pub const FIRST_FRAME: usize = 100000000
pub const COUNTED: usize = 250000000
pub const FRAMES: usize = 8

// Controller `index`'s frames counted against the clock: from one change
// of CRTC_STATUS_FRAME_COUNT (24 bits) to the eighth frame after it, or as
// many as come in a quarter of a second. Nothing counted when the counter
// does not move in a tenth of a second, runs away (it is no frame counter
// then), or the clock stands.
pub fn rateOf(card: *const Card, index: usize, hTotal: usize, vTotal: usize) -> Rate {
    var rate = Rate.{ .frames = 0, .nanoseconds = 0, .millihertz = 0, .kilohertz = 0 }
    const counter = OFFSETS[index] + CRTC_STATUS_FRAME_COUNT
    const began = card.time()
    var last = card.reg(counter) & 0xFFFFFF
    var first: usize = 0
    var latest: usize = 0
    var frames: usize = 0
    var counting = false
    var spins: usize = 0
    while spins < 100000000 {
        spins += 1
        const count = card.reg(counter) & 0xFFFFFF
        const now = card.time()
        if count != last {
            if counting {
                frames += (count + 0x1000000 - last) & 0xFFFFFF
            } else {
                counting = true
                first = now
            }
            last = count
            latest = now
            if frames > 1000 { return rate }
            if frames >= FRAMES { break }
        }
        if !counting && less(now, began) > FIRST_FRAME { return rate }
        if counting && less(now, first) > COUNTED { break }
    }
    const elapsed = less(latest, first)
    if frames == 0 || elapsed < 1000000 { return rate }
    rate.frames = frames
    rate.nanoseconds = elapsed
    rate.millihertz = frames * 1000000000000 / elapsed
    rate.kilohertz = frames * hTotal * vTotal * 1000000 / elapsed
    return rate
}

// Controller `index` read and decoded. One that is off has only its
// control words read: every other number of it stays 0.
pub fn read(card: *const Card, index: usize, into: *Controller) -> void {
    const bytes = unsafe { @ptrCast([*]u8, into) }
    var k: usize = 0
    while k < @sizeOf(Controller) {
        bytes[k] = 0
        k += 1
    }
    const at = OFFSETS[index]
    into.*.index = index
    into.*.control = card.reg(at + CRTC_CONTROL)
    into.*.on = into.*.control != 0xFFFFFFFF && into.*.control & 1 != 0
    const vga = card.reg(VGA_CONTROL[index])
    into.*.vga = vga != 0xFFFFFFFF && vga & 1 != 0
    if !into.*.on { return }

    // The timing. The registers hold the totals less one, and the
    // blankings and the sync as places of the controller's own counters
    // (dce110_timing_generator_program_blanking).
    into.*.hTotal = (card.reg(at + CRTC_H_TOTAL) & 0x3FFF) + 1
    into.*.vTotal = (card.reg(at + CRTC_V_TOTAL) & 0x3FFF) + 1
    const hBlank = card.reg(at + CRTC_H_BLANK_START_END)
    into.*.hBlankStart = hBlank & 0x3FFF
    into.*.hBlankEnd = (hBlank >> 16) & 0x3FFF
    const vBlank = card.reg(at + CRTC_V_BLANK_START_END)
    into.*.vBlankStart = vBlank & 0x3FFF
    into.*.vBlankEnd = (vBlank >> 16) & 0x3FFF
    const hSync = card.reg(at + CRTC_H_SYNC_A)
    into.*.hSyncStart = hSync & 0x3FFF
    into.*.hSyncEnd = (hSync >> 16) & 0x3FFF
    const vSync = card.reg(at + CRTC_V_SYNC_A)
    into.*.vSyncStart = vSync & 0x3FFF
    into.*.vSyncEnd = (vSync >> 16) & 0x3FFF
    into.*.hSyncLow = card.reg(at + CRTC_H_SYNC_A_CNTL) & 1 != 0
    into.*.vSyncLow = card.reg(at + CRTC_V_SYNC_A_CNTL) & 1 != 0
    into.*.width = active(into.*.hBlankStart, into.*.hBlankEnd, into.*.hTotal)
    into.*.height = active(into.*.vBlankStart, into.*.vBlankEnd, into.*.vTotal)
    into.*.blanked = card.reg(at + CRTC_BLANK_CONTROL) & 0x100 != 0
    into.*.interlaced = card.reg(at + CRTC_INTERLACE_CONTROL) & 1 != 0

    // The surface (dce_v11_0_crtc_do_set_base writes these).
    into.*.surfaceOn = card.reg(at + GRPH_ENABLE) & 1 != 0
    into.*.surfaceControl = card.reg(at + GRPH_CONTROL)
    into.*.depth = into.*.surfaceControl & 3
    into.*.format = (into.*.surfaceControl >> 8) & 7
    into.*.arrayMode = (into.*.surfaceControl >> 20) & 15
    into.*.address = ((card.reg(at + GRPH_PRIMARY_SURFACE_ADDRESS_HIGH) & 0xFF) << 32) | (card.reg(at + GRPH_PRIMARY_SURFACE_ADDRESS) & 0xFFFFFF00)
    into.*.pitch = card.reg(at + GRPH_PITCH) & 0x7FFF
    into.*.xStart = card.reg(at + GRPH_X_START) & 0x3FFF
    into.*.yStart = card.reg(at + GRPH_Y_START) & 0x3FFF
    into.*.xEnd = card.reg(at + GRPH_X_END) & 0x7FFF
    into.*.yEnd = card.reg(at + GRPH_Y_END) & 0x7FFF

    // The viewport (x and width in the upper half) and the scaler
    // (dce_transform.c: the taps are stored less one).
    const start = card.reg(at + VIEWPORT_START)
    into.*.viewportX = (start >> 16) & 0x3FFF
    into.*.viewportY = start & 0x3FFF
    const extent = card.reg(at + VIEWPORT_SIZE)
    into.*.viewportWidth = (extent >> 16) & 0x3FFF
    into.*.viewportHeight = extent & 0x3FFF
    const scaler = card.reg(at + SCL_MODE)
    into.*.scalerMode = scaler & 3
    into.*.prescaler = scaler & 0x10 != 0
    into.*.scalerBypass = card.reg(at + SCL_BYPASS_CONTROL) & 3
    const taps = card.reg(at + SCL_TAP_CONTROL)
    into.*.vTaps = (taps & 7) + 1
    into.*.hTaps = ((taps >> 8) & 15) + 1
    into.*.hRatio = card.reg(at + SCL_HORZ_FILTER_SCALE_RATIO) & 0x3FFFFFF
    into.*.vRatio = card.reg(at + SCL_VERT_FILTER_SCALE_RATIO) & 0x3FFFFFF
    const sides = card.reg(at + EXT_OVERSCAN_LEFT_RIGHT)
    into.*.left = (sides >> 16) & 0x1FFF
    into.*.right = sides & 0x1FFF
    const ends = card.reg(at + EXT_OVERSCAN_TOP_BOTTOM)
    into.*.top = (ends >> 16) & 0x1FFF
    into.*.bottom = ends & 0x1FFF
    const lineMemory = card.reg(at + LB_MEMORY_CTRL)
    into.*.lineBuffer = (lineMemory >> 20) & 3
    into.*.lineBufferSize = lineMemory & 0x1FFF
    into.*.buffers = card.reg(PIPE0_DMIF_BUFFER_CONTROL + index) & 7

    // The pixel clock's source, the encoder, and the frames in a second.
    into.*.rateControl = card.reg(CRTC0_PIXEL_RATE_CNTL + index * 4)
    into.*.dto = into.*.rateControl & 0x10 != 0
    into.*.dtoPhase = card.reg(DP_DTO0_PHASE + index * 4)
    into.*.dtoModulo = card.reg(DP_DTO0_MODULO + index * 4)
    into.*.phyPll = card.reg(CRTC0_PHYPLL_PIXEL_RATE_CNTL + index * 4)
    into.*.encoder = encoderOf(card, index)
    into.*.rate = rateOf(card, index, into.*.hTotal, into.*.vTotal)
}

// What does not fit in a controller's numbers: against one another, the
// card's memory (`base` to `top` among its own addresses, `memory.aperture`
// bytes of it reached by the processor) and the firmware's picture, which
// the processor draws 32 bits a pixel in rows. `Fault.none`: they fit.
pub fn check(c: *const Controller, memory: *const Memory, base: usize, top: usize) -> Fault {
    // (A location word of nothing or of all ones gives 16 MiB.)
    if top <= base || top - base < 0x1000000 { return Fault.memory }
    if c.*.vga { return Fault.vga }
    if c.*.width == 0 || c.*.height == 0 || c.*.hTotal <= c.*.width || c.*.vTotal <= c.*.height { return Fault.totals }
    if !c.*.surfaceOn { return Fault.no_surface }
    const width = c.surfaceWidth()
    const height = c.surfaceHeight()
    if width == 0 || height == 0 { return Fault.extent }
    if c.*.depth != 2 { return Fault.depth }
    if c.*.arrayMode > 1 { return Fault.tiled }
    if c.*.pitch < width { return Fault.pitch }
    if c.*.address < base || c.*.address > top { return Fault.address }
    if c.*.address - base + c.*.pitch * 4 * c.*.yEnd > memory.*.aperture { return Fault.address }
    if c.*.viewportWidth == 0 || c.*.viewportHeight == 0 { return Fault.viewport }
    if c.*.viewportX + c.*.viewportWidth > c.*.xEnd || c.*.viewportY + c.*.viewportHeight > c.*.yEnd + 1 { return Fault.viewport }
    // What is shown has to be the picture the processor draws: its first
    // pixel, the length of its rows and its size (the surface may be the
    // larger one).
    if memory.*.pictureWidth != 0 {
        if c.firstShown(base) != memory.*.pictureOffset || c.*.pitch != memory.*.picturePitch { return Fault.picture }
        if c.*.viewportWidth != memory.*.pictureWidth || c.*.viewportHeight < memory.*.pictureHeight || c.*.viewportHeight > memory.*.pictureHeight + 1 { return Fault.picture }
    }
    if c.filledWidth() == 0 || c.filledHeight() == 0 { return Fault.scaler }
    if c.*.scalerMode == 0 && !c.fills() { return Fault.scaler }
    return Fault.none
}

// What a controller whose numbers fit shows.
fn shown(c: *const Controller) -> Shows {
    if !c.fills() { return Shows.scaled }
    if c.*.left + c.*.right + c.*.top + c.*.bottom != 0 { return Shows.bordered }
    return Shows.as_it_is
}

// Where a new surface is put: on a boundary of this many bytes, and its
// rows on one of this many pixels.
pub const PLACED: usize = 1024 * 1024
pub const ROW: usize = 64

// What would be written so that controller `c` shows a picture of the size
// of its timing, with nothing scaled: the surface after the one shown now
// and after the firmware's picture as the kernel was given it, whichever
// ends later (the surface may be the taller one, and the console draws on
// the picture).
pub fn plan(c: *const Controller, memory: *const Memory, base: usize) -> Plan {
    return planFor(c, memory, base, c.*.width, c.*.height)
}

// The same for a picture of `width` by `height` (another timing's size:
// gpu_mode.mlx plans the monitor's own with it).
pub fn planFor(c: *const Controller, memory: *const Memory, base: usize, width: usize, height: usize) -> Plan {
    var after = less(c.*.address, base) + c.*.pitch * 4 * c.*.yEnd
    const picture = memory.*.pictureOffset + memory.*.pictureBytes
    if memory.*.pictureWidth != 0 && picture > after { after = picture }
    const pitch = (width + ROW - 1) / ROW * ROW
    const offset = (after + PLACED - 1) / PLACED * PLACED
    const bytes = pitch * 4 * height
    return Plan.{
        .fits = offset + bytes <= memory.*.aperture,
        .width = width,
        .height = height,
        .pitch = pitch,
        .offset = offset,
        .bytes = bytes,
        .address = base + offset,
        .control = c.*.surfaceControl,
        .lineBuffer = 0,
    }
}

pub fn modeName(mode: usize) -> []const u8 {
    if mode == MODE_DISPLAYPORT { return "DisplayPort" }
    if mode == MODE_LVDS { return "LVDS" }
    if mode == MODE_DVI { return "TMDS (DVI)" }
    if mode == MODE_HDMI { return "TMDS (HDMI)" }
    if mode == MODE_DISPLAYPORT_MST { return "DisplayPort (several streams)" }
    return "a mode not known here"
}

pub fn isDisplayPort(mode: usize) -> bool { return mode == MODE_DISPLAYPORT || mode == MODE_DISPLAYPORT_MST }

// A controller that is on, said in the log: the timing, the surface, the
// viewport and the scaler, the encoder, the pixel clock.
fn describe(card: *const Card, c: *const Controller, base: usize) -> void {
    card.controller(c.*.index)
    card.fieldHex(" is on (control ", c.*.control)
    card.size("): ", c.*.width, c.*.height)
    card.size(" of ", c.*.hTotal, c.*.vTotal)
    card.span(", h blank ", c.*.hBlankStart, c.*.hBlankEnd)
    card.span(" sync ", c.*.hSyncStart, c.*.hSyncEnd)
    card.say(if c.*.hSyncLow { " -" } else { " +" })
    card.span(", v blank ", c.*.vBlankStart, c.*.vBlankEnd)
    card.span(" sync ", c.*.vSyncStart, c.*.vSyncEnd)
    card.say(if c.*.vSyncLow { " -" } else { " +" })
    if c.*.interlaced { card.say(", interlaced") }
    if c.*.blanked { card.say(", blanked") }
    if c.*.vga { card.say(", in VGA mode") }
    card.say("\n")

    card.controller(c.*.index)
    card.fieldHex(if c.*.surfaceOn { " surface on at " } else { " surface off at " }, c.*.address)
    if c.*.address >= base {
        card.fieldHex(" (", c.*.address - base)
        card.say(" of the card's memory)")
    }
    card.field(", pitch ", c.*.pitch)
    card.span(", x ", c.*.xStart, c.*.xEnd)
    card.span(", y ", c.*.yStart, c.*.yEnd)
    card.fieldHex(", control ", c.*.surfaceControl)
    card.field(" (depth ", c.*.depth)
    card.field(", format ", c.*.format)
    card.field(", array mode ", c.*.arrayMode)
    card.say(")\n")

    card.controller(c.*.index)
    card.field(" viewport ", c.*.viewportX)
    card.field(",", c.*.viewportY)
    card.size(" ", c.*.viewportWidth, c.*.viewportHeight)
    card.size(" to fill ", c.filledWidth(), c.filledHeight())
    card.field(", borders left ", c.*.left)
    card.field(" right ", c.*.right)
    card.field(" top ", c.*.top)
    card.field(" bottom ", c.*.bottom)
    card.say("\n")

    // The scaler's ratios beside what the two sizes give (the viewport
    // over what it fills, in 2^-24): three registers that say the same
    // are numbers that are right.
    card.controller(c.*.index)
    card.field(" scaler mode ", c.*.scalerMode)
    card.say(if c.*.scalerMode == 0 { " (off" } else { " (on" })
    card.say(if c.*.prescaler { ", prescaler on)" } else { ")" })
    card.field(", bypass ", c.*.scalerBypass)
    card.size(", taps ", c.*.hTaps, c.*.vTaps)
    card.fieldHex(", ratios ", c.*.hRatio)
    card.fieldHex(" ", c.*.vRatio)
    if c.*.scalerMode != 0 && c.filledWidth() != 0 && c.filledHeight() != 0 {
        const hGiven = (c.*.viewportWidth << 24) / c.filledWidth()
        const vGiven = (c.*.viewportHeight << 24) / c.filledHeight()
        if near(c.*.hRatio, hGiven) && near(c.*.vRatio, vGiven) {
            card.say(" (as the sizes give)")
        } else {
            card.fieldHex(" (the sizes give ", hGiven)
            card.fieldHex(" ", vGiven)
            card.say(")")
        }
    }
    card.field(", line buffer config ", c.*.lineBuffer)
    card.field(" size ", c.*.lineBufferSize)
    card.field(", DMIF buffers ", c.*.buffers)
    card.say("\n")

    card.controller(c.*.index)
    if c.*.encoder.found {
        card.field(" goes out by DIG ", c.*.encoder.backEnd)
        card.field(" (front end ", c.*.encoder.frontEnd)
        card.say("): ")
        card.say(modeName(c.*.encoder.mode))
        if isDisplayPort(c.*.encoder.mode) {
            card.field(", ", c.*.encoder.lanes)
            card.say(if c.*.encoder.lanes == 1 { " lane" } else { " lanes" })
            card.say(if c.*.encoder.trained { ", trained" } else { ", not trained" })
            card.say(if c.*.encoder.stream { ", stream on" } else { ", stream off" })
        }
        card.say("\n")
    } else {
        card.say(": no encoder that is on takes its picture (the DIG registers may be misplaced)\n")
    }

    // The pixel clock is not read from the card: it is a PLL's, and where
    // the PLL has its dividers is not known here. It is measured instead,
    // when the frame counter runs.
    card.controller(c.*.index)
    if c.*.rate.frames != 0 {
        const part = c.*.rate.millihertz % 1000
        card.field(" counts ", c.*.rate.millihertz / 1000)
        card.say(if part < 10 { ".00" } else if part < 100 { ".0" } else { "." })
        card.decimal(part)
        card.field(" frames a second: a pixel clock of ", c.*.rate.kilohertz)
        card.say(" kHz (measured; the PLL is not read, its registers are not known here)\n")
    } else {
        card.say(": the pixel clock is not read (the PLL's registers are not known here) and not measured (no frames counted)\n")
    }
    if c.*.dto {
        card.controller(c.*.index)
        card.field(" clock made for DisplayPort: phase ", c.*.dtoPhase)
        card.field(" of modulo ", c.*.dtoModulo)
        if c.*.rate.frames != 0 && c.*.dtoPhase != 0 && c.*.rate.kilohertz < 4000000 {
            card.field(" (of a reference of ", c.*.rate.kilohertz * c.*.dtoModulo / c.*.dtoPhase)
            card.say(" kHz, by the measured clock)")
        }
        card.say("\n")
    }
}

// What does not fit, in words, for the line that says the read-out is not
// plausible.
fn sayFault(card: *const Card, c: *const Controller, memory: *const Memory, fault: Fault, base: usize, top: usize) -> void {
    if fault == Fault.memory {
        card.fieldHex("the card's memory at ", base)
        card.fieldHex(" to ", top)
        card.say(" is none")
        return
    }
    card.field("controller ", c.*.index)
    if fault == Fault.vga {
        card.say(" is in VGA mode, its surface is not what it shows")
    } else if fault == Fault.totals {
        card.size(" shows ", c.*.width, c.*.height)
        card.size(" of totals ", c.*.hTotal, c.*.vTotal)
    } else if fault == Fault.no_surface {
        card.say(" is on with its surface off")
    } else if fault == Fault.extent {
        card.span(": a surface of no size, x ", c.*.xStart, c.*.xEnd)
        card.span(", y ", c.*.yStart, c.*.yEnd)
    } else if fault == Fault.depth {
        card.field(": a surface of depth ", c.*.depth)
        card.say(", not the 32 bits a pixel the picture is drawn in")
    } else if fault == Fault.tiled {
        card.field(": a surface in tiles (array mode ", c.*.arrayMode)
        card.say("), not the rows the picture is drawn in")
    } else if fault == Fault.pitch {
        card.field(": a pitch of ", c.*.pitch)
        card.field(" for a surface ", c.surfaceWidth())
        card.say(" wide")
    } else if fault == Fault.address {
        card.fieldHex(": the surface at ", c.*.address)
        card.field(" is not in the ", memory.*.aperture / (1024 * 1024))
        card.fieldHex(" MiB from ", base)
    } else if fault == Fault.viewport {
        card.field(": a viewport ", c.*.viewportX)
        card.field(",", c.*.viewportY)
        card.size(" ", c.*.viewportWidth, c.*.viewportHeight)
        card.size(" on a surface of ", c.*.xEnd, c.*.yEnd)
    } else if fault == Fault.picture {
        card.size(": the viewport shows ", c.*.viewportWidth, c.*.viewportHeight)
        card.field(", pitch ", c.*.pitch)
        card.fieldHex(", from ", c.firstShown(base))
        card.size(" of the memory; the firmware's picture is ", memory.*.pictureWidth, memory.*.pictureHeight)
        card.field(", pitch ", memory.*.picturePitch)
        card.fieldHex(", at ", memory.*.pictureOffset)
    } else {
        card.size(": the scaler is off, yet a picture of ", c.*.viewportWidth, c.*.viewportHeight)
        card.size(" is to fill ", c.filledWidth(), c.filledHeight())
    }
}

fn notPlausible(card: *const Card) -> void { card.say("gpu: the read-out is not plausible (") }

fn needsCorrecting(card: *const Card) -> void { card.say("): the register map needs correcting\n") }

// What the next stage would write for `c`, as "gpu: would set" lines.
fn sayPlan(card: *const Card, c: *const Controller, memory: *const Memory, base: usize) -> void {
    const p = plan(c, memory, base)
    if !p.fits {
        card.size("gpu: would set nothing: a picture of ", p.width, p.height)
        card.fieldHex(" at ", p.offset)
        card.say(" does not fit the aperture\n")
        return
    }
    card.size("gpu: would set a picture of ", p.width, p.height)
    card.field(if memory.*.pictureWidth != 0 { " after the firmware's: " } else { " after the one shown: " }, p.bytes / 1024)
    card.fieldHex(" KiB at ", p.offset)
    card.say(" of the aperture\n")
    card.fieldHex("gpu: would set surface address ", p.address)
    card.field(", pitch ", p.pitch)
    card.field(", x 0..", p.width)
    card.field(", y 0..", p.height)
    card.fieldHex(", control ", p.control)
    card.say(" as it is\n")
    card.size("gpu: would set viewport 0,0 ", p.width, p.height)
    card.field(", scaler mode 0 (off, its prescaler bit too), borders 0, line buffer config ", p.lineBuffer)
    card.say("\n")
}

// What a controller whose numbers fit shows, and what the next stage
// would have to set for it.
fn conclude(card: *const Card, c: *const Controller, shows: Shows, memory: *const Memory, base: usize) -> void {
    card.controller(c.*.index)
    if shows == Shows.as_it_is {
        card.size(" shows a picture of ", c.*.viewportWidth, c.*.viewportHeight)
        card.size(" as it is: the monitor is sent ", c.*.width, c.*.height)
        card.say("\ngpu: next stage: another size needs the pixel clock (a PLL), the timing and the link (")
        card.say(if !c.*.encoder.found { "not found" } else if isDisplayPort(c.*.encoder.mode) { "DisplayPort, to be trained" } else { "a TMDS clock" })
        card.say(") set: not there yet\n")
        return
    }
    card.size(" shows ", c.*.width, c.*.height)
    if shows == Shows.scaled {
        card.size(" from a picture of ", c.*.viewportWidth, c.*.viewportHeight)
        card.say(": the card scales\n")
    } else {
        card.size(" with a picture of ", c.*.viewportWidth, c.*.viewportHeight)
        card.say(" inside borders: the card adds them\n")
    }
    if c.*.interlaced {
        card.say("gpu: next stage: nothing planned for an interlaced timing\n")
        return
    }
    // (The size is the timing's. Whether that is the monitor's own the
    // kernel does not know, it does not read the monitor's EDID: a timing
    // of another size than the monitor's is situation (b) for the rest.)
    card.size("gpu: next stage: a picture of ", c.*.width, c.*.height)
    card.say(" on the running controller (surface, viewport, scaler off, line buffer; clock, timing and link only for another size)\n")
    sayPlan(card, c, memory, base)
}

// The display controller read out and said in the log: the card's memory,
// every controller that is on, those that are off, and for each one that
// is on what it shows and what the next stage would have to set; or that
// the numbers do not fit. The decoded state is left in `into`.
pub fn report(card: *const Card, memory: *const Memory, into: *Readout) -> void {
    into.*.location = card.reg(MC_VM_FB_LOCATION)
    into.*.base = (into.*.location & 0xFFFF) << 24
    into.*.top = (((into.*.location >> 16) & 0xFFFF) << 24) | 0xFFFFFF
    into.*.on = 0
    into.*.plausible = true
    card.fieldHex("gpu: the card's memory is ", into.*.base)
    card.fieldHex(" to ", into.*.top)
    card.fieldHex(" of its own addresses (fb_location ", into.*.location)
    card.say(")\n")

    var n: usize = 0
    while n < CONTROLLERS {
        read(card, n, &into.*.controllers[n])
        into.*.shows[n] = Shows.off
        into.*.faults[n] = Fault.none
        if into.*.controllers[n].on {
            into.*.on += 1
            describe(card, &into.*.controllers[n], into.*.base)
        }
        n += 1
    }
    if into.*.on < CONTROLLERS {
        card.say("gpu: controllers off:")
        n = 0
        while n < CONTROLLERS {
            if !into.*.controllers[n].on { card.field(" ", n) }
            n += 1
        }
        card.say("\n")
    }
    if into.*.on == 0 {
        // A picture on the screen with no controller on is a register map
        // that is wrong; none on a card that shows nothing is as it is.
        if memory.*.pictureWidth != 0 {
            into.*.plausible = false
            notPlausible(card)
            card.say("no controller is on, yet the firmware shows a picture")
            needsCorrecting(card)
        }
        return
    }

    // First whether all of it fits; a conclusion only then.
    n = 0
    while n < CONTROLLERS {
        const c = &into.*.controllers[n]
        if c.*.on {
            into.*.faults[n] = check(c, memory, into.*.base, into.*.top)
            if into.*.faults[n] != Fault.none {
                into.*.shows[n] = Shows.not_plausible
                into.*.plausible = false
                notPlausible(card)
                sayFault(card, c, memory, into.*.faults[n], into.*.base, into.*.top)
                needsCorrecting(card)
            }
        }
        n += 1
    }
    if !into.*.plausible { return }
    n = 0
    while n < CONTROLLERS {
        const c = &into.*.controllers[n]
        if c.*.on {
            into.*.shows[n] = shown(c)
            conclude(card, c, into.*.shows[n], memory, into.*.base)
        }
        n += 1
    }
}

// The raw dump's lines, eight values to a line, a register's number before
// the first of a line and wherever the numbers do not go on by one:
// "gpu: raw 4b00: 00000400 4b09: 00000000 4b47: 10000200 00000101 ...".
const Dump = struct {
    card: *const Card
    next: usize
    onLine: usize

    fn put(self: *Self, number: usize) -> void {
        const card = self.*.card
        const value = card.reg(number)
        if self.*.onLine >= 8 { self.end() }
        if self.*.onLine == 0 { card.say("gpu: raw") }
        if self.*.onLine == 0 || number != self.*.next {
            card.say(" ")
            card.hexDigits(number, 4)
            card.say(":")
        }
        card.say(" ")
        card.hexDigits(value, 8)
        self.*.onLine += 1
        self.*.next = number + 1
    }

    fn end(self: *Self) -> void {
        if self.*.onLine != 0 { self.*.card.say("\n") }
        self.*.onLine = 0
    }

    // The registers `numbers` lists, each `at` more, and the line ended.
    fn list(self: *Self, numbers: []const usize, at: usize) -> void {
        var k: usize = 0
        while k < numbers.length {
            self.put(at + numbers[k])
            k += 1
        }
        self.end()
    }

    // The same for runs, the first and the last number of each.
    fn runs(self: *Self, pairs: []const usize, at: usize) -> void {
        var k: usize = 0
        while k + 1 < pairs.length {
            var number = pairs[k]
            while number <= pairs[k + 1] {
                self.put(at + number)
                number += 1
            }
            k += 2
        }
        self.end()
    }
}

// The registers read, as numbers and values, for the log alone: where the
// memory is and the VGA words, the buffers and the pixel clock words, every
// controller's control word, the encoders, and the runs of each controller that is on
// (of all six when none is, or when what was read does not fit: a wrong
// number is then looked for).
pub fn dump(card: *const Card, readout: *const Readout) -> void {
    var lines = Dump.{ .card = card, .next = 0, .onLine = 0 }
    lines.put(MC_VM_FB_LOCATION)
    lines.list(VGA_CONTROL[0..], 0)
    var n: usize = 0
    while n < CONTROLLERS {
        lines.put(PIPE0_DMIF_BUFFER_CONTROL + n)
        n += 1
    }
    lines.end()
    n = 0
    while n < CONTROLLERS * 4 {
        lines.put(CRTC0_PIXEL_RATE_CNTL + n)
        n += 1
    }
    lines.end()
    n = 0
    while n < CONTROLLERS {
        lines.put(OFFSETS[n] + CRTC_CONTROL)
        n += 1
    }
    lines.end()
    n = 0
    while n < BACK_ENDS {
        lines.list(DIG_LISTED[0..], DIG[n])
        n += 1
    }
    const all = readout.*.on == 0 || !readout.*.plausible
    n = 0
    while n < CONTROLLERS {
        if all || readout.*.controllers[n].on {
            lines.runs(SURFACE_RUNS[0..], OFFSETS[n])
            lines.runs(SCALER_RUNS[0..], OFFSETS[n])
            lines.runs(TIMING_RUNS[0..], OFFSETS[n])
        }
        n += 1
    }
}
