// A 16550 UART (COM1 is the kernel's console): 115200 baud, 8N1; output
// polled, input by its receive interrupt (IRQ 4) once the kernel turns it
// on (receiveInterrupts).
const Port = @import("./cpu.mlx").Port

pub const Uart = struct {
    pub const COM1: usize = 0x3F8
    // Registers, from the port.
    const DATA: usize = 0
    const INTERRUPTS: usize = 1
    const FIFO: usize = 2
    const LINE_CONTROL: usize = 3
    const MODEM_CONTROL: usize = 4
    const LINE_STATUS: usize = 5

    port: usize

    pub fn init(self: Self) -> void {
        Port.out8(self.port + INTERRUPTS, 0x00) // no interrupts
        Port.out8(self.port + LINE_CONTROL, 0x80) // the divisor follows
        Port.out8(self.port + DATA, 0x01) // 115200 baud
        Port.out8(self.port + INTERRUPTS, 0x00)
        Port.out8(self.port + LINE_CONTROL, 0x03) // 8 bits, no parity, one stop bit
        Port.out8(self.port + FIFO, 0xC7) // FIFOs on, cleared, 14-byte threshold
        Port.out8(self.port + MODEM_CONTROL, 0x03) // DTR, RTS
    }

    // An interrupt when bytes have come (OUT2 lets it out to the
    // interrupt controller).
    pub fn receiveInterrupts(self: Self) -> void {
        Port.out8(self.port + MODEM_CONTROL, 0x0B) // DTR, RTS, OUT2
        Port.out8(self.port + INTERRUPTS, 0x01) // received data available
    }

    // A byte out once the transmitter has room. A line whose transmitter
    // never has (a port that is not a UART, or one held by something
    // else) is given up for good after a wait, not waited for at every
    // byte: the kernel's messages go to its log and the screen as well.
    pub fn put(self: Self, byte: u8) -> void {
        if stuck { return }
        var polls: usize = 0
        while Port.in8(self.port + LINE_STATUS) & 0x20 == 0 {
            polls += 1
            if polls > PATIENCE {
                stuck = true
                return
            }
        }
        Port.out8(self.port + DATA, @intCast(usize, byte))
        last = byte
    }

    // A byte when one has come.
    pub fn ready(self: Self) -> bool { return Port.in8(self.port + LINE_STATUS) & 0x01 != 0 }

    pub fn get(self: Self) -> u8 {
        while !self.ready() {}
        return @intCast(u8, Port.in8(self.port + DATA))
    }
}

pub const com1 = Uart.{ .port = Uart.COM1 }

// How often the transmitter is asked before the line is given up (a byte
// takes 87 microseconds at 115200 baud: this is hundreds of times that,
// counted in port reads because the clock is not set yet when the first
// messages go out).
const PATIENCE: usize = 200000
var stuck = false // (per run)

// The byte that went out last, whoever sent it (the kernel's messages, a
// program's output): whether the line stands in the middle of a line of
// text (console.freshLine).
var last: u8 = 10 // (per run)

pub fn midLine() -> bool { return last != 10 }
