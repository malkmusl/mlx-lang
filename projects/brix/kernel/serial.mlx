// COM1 (16550 UART at 0x3F8): the kernel's console. 115200 baud, 8N1,
// polled (no interrupts).
const cpu = @import("./cpu.mlx")

const PORT: usize = 0x3F8

pub fn init() -> void {
    cpu.outb(PORT + 1, 0x00) // no interrupts
    cpu.outb(PORT + 3, 0x80) // the divisor follows
    cpu.outb(PORT + 0, 0x01) // 115200 baud
    cpu.outb(PORT + 1, 0x00)
    cpu.outb(PORT + 3, 0x03) // 8 bits, no parity, one stop bit
    cpu.outb(PORT + 2, 0xC7) // FIFOs on, cleared, 14-byte threshold
    cpu.outb(PORT + 4, 0x03) // DTR, RTS
}

pub fn put(byte: u8) -> void {
    while cpu.inb(PORT + 5) & 0x20 == 0 {}
    cpu.outb(PORT, @intCast(usize, byte))
}

// A byte when one has come.
pub fn ready() -> bool { return cpu.inb(PORT + 5) & 0x01 != 0 }

pub fn get() -> u8 {
    while !ready() {}
    return @intCast(u8, cpu.inb(PORT))
}
