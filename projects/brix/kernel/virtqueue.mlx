// A virtqueue of a legacy virtio device (the split ring in pages of its
// own: the descriptor table, the available ring, the used ring on a page
// boundary): descriptors taken from a free list and chained, a chain
// submitted (the available ring, the device notified) and the used ring
// read for the chains the device finished.
const memory = @import("./memory.mlx")
const Port = @import("./cpu.mlx").Port
const Bytes = @import("./bytes.mlx").Bytes
const layout = @import("../layout.mlx")
const Page = memory.Page

pub const Virtqueue = struct {
    // Registers, from the I/O BAR.
    const QUEUE_PFN: usize = 0x08
    const QUEUE_SIZE: usize = 0x0C
    const QUEUE_SELECT: usize = 0x0E
    const QUEUE_NOTIFY: usize = 0x10
    // Descriptor flags.
    pub const NEXT: usize = 1
    pub const DEVICE_WRITES: usize = 2
    pub const NONE: usize = 0xFFFF

    port: usize
    index: usize
    size: usize
    // The queue (physical), and where its used ring is in it.
    queue: usize
    usedOffset: usize
    availableIndex: usize
    lastUsed: usize
    // The free descriptors, chained through their next fields.
    freeHead: usize
    freeCount: usize

    // Queue `index` of the device at `port` made: its pages, the device
    // told; false when it has none or memory is out.
    pub fn init(self: *Self, port: usize, index: usize) -> bool {
        self.*.port = port
        self.*.index = index
        Port.out16(port + QUEUE_SELECT, index)
        const size = Port.in16(port + QUEUE_SIZE)
        if size == 0 { return false }
        self.*.size = size
        self.*.usedOffset = Page.up(16 * size + 6 + 2 * size)
        const pages = (self.*.usedOffset + Page.up(6 + 8 * size)) / Page.SIZE
        self.*.queue = memory.allFrames().allocateContiguous(pages)
        if self.*.queue == 0 { return false }
        Port.out32(port + QUEUE_PFN, self.*.queue / Page.SIZE)
        self.*.availableIndex = 0
        self.*.lastUsed = 0
        // Every descriptor free, chained.
        var k: usize = 0
        while k < size {
            self.set(k, 0, 0, 0, if k + 1 < size { k + 1 } else { NONE })
            k += 1
        }
        self.*.freeHead = 0
        self.*.freeCount = size
        return true
    }

    fn bytes(self: *const Self) -> [*]u8 { return Bytes.pointer(layout.Memory.virtual(self.*.queue)) }

    pub fn set(self: *Self, index: usize, address: usize, length: usize, flags: usize, next: usize) -> void {
        const d = self.bytes()
        Bytes.write64(d, index * 16, address)
        Bytes.write32(d, index * 16 + 8, length)
        Bytes.write16(d, index * 16 + 12, flags)
        Bytes.write16(d, index * 16 + 14, if next == NONE { 0 } else { next })
    }

    fn nextOf(self: *const Self, index: usize) -> usize { return Bytes.read16(self.bytes(), index * 16 + 14) }
    fn flagsOf(self: *const Self, index: usize) -> usize { return Bytes.read16(self.bytes(), index * 16 + 12) }

    // A free descriptor: (whether there was one, which).
    pub fn take(self: *Self) -> (bool, usize) {
        if self.*.freeCount == 0 { return -> (false, 0) }
        const index = self.*.freeHead
        self.*.freeHead = if self.*.freeCount == 1 { NONE } else { self.nextOf(index) }
        self.*.freeCount -= 1
        return -> (true, index)
    }

    // The chain from `head` free again.
    pub fn give(self: *Self, head: usize) -> void {
        var index = head
        while true {
            const last = self.flagsOf(index) & NEXT == 0
            const following = self.nextOf(index)
            self.set(index, 0, 0, 0, self.*.freeHead)
            self.*.freeHead = index
            self.*.freeCount += 1
            if last { return }
            index = following
        }
    }

    // The chain at `head` to the device.
    pub fn submit(self: *Self, head: usize) -> void {
        const q = self.bytes()
        const available = 16 * self.*.size
        Bytes.write16(q, available + 4 + 2 * (self.*.availableIndex % self.*.size), head)
        self.*.availableIndex = (self.*.availableIndex + 1) & 0xFFFF
        Bytes.write16(q, available + 2, self.*.availableIndex)
        Port.out16(self.*.port + QUEUE_NOTIFY, self.*.index)
    }

    // Whether the device finished a chain (the used ring moved).
    pub fn hasUsed(self: *const Self) -> bool { return Bytes.read16(self.bytes(), self.*.usedOffset + 2) != self.*.lastUsed }

    // The next chain the device finished: (whether there is one, its
    // head, the bytes the device wrote).
    pub fn used(self: *Self) -> (bool, usize, usize) {
        if !self.hasUsed() { return -> (false, 0, 0) }
        const q = self.bytes()
        const at = self.*.usedOffset + 4 + 8 * (self.*.lastUsed % self.*.size)
        const head = Bytes.read32(q, at)
        const length = Bytes.read32(q, at + 4)
        self.*.lastUsed = (self.*.lastUsed + 1) & 0xFFFF
        return -> (true, head, length)
    }
}
