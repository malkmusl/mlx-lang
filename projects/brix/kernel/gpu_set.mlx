// A plan for the monitor's own mode (gpu_mode.mlx) carried out on a
// Polaris card's display controller: the only place where a register of
// the display is written, and only when the image asks for it (`asked`:
// settings/gpu says "native"; gpu.mlx hands the card's write over).
// Without that, with a plan that is not complete, nothing is written and
// the firmware's picture stays as it is.
//
// Carried out the careful way:
// - first every register the plan writes is read (the firmware's values,
//   for the way back), and the new picture's memory is cleared;
// - each write is read back, and each wait has its time: a word that does
//   not hold what was written, or a state that does not come, ends it;
// - afterwards the controller's frame counter must run at the rate the
//   plan gives, and the memory interface must not say that it ran dry
//   (DMIF_STATUS's DMIF_UNDERFLOW) where it did not say so before. (The
//   headers name the bit; Linux does not use it, so whether it stays set
//   or clears when read is not known. It is read once right after the
//   last step and judged by a second read after the frames were counted:
//   if reading clears it, what happened while the controller was being
//   changed does not count, only what goes on with the new picture.)
// - when any of that fails the firmware's state is put back: the plan's
//   steps gone through again, those that make the output quiet (the
//   stream stopped, the controller blanked) and those that are only on
//   the way (a lock, a mark set chosen) done as planned, every other
//   write with the firmware's value of its register (for the urgency
//   marks, which are four sets behind one word, what each set held when
//   it was written), the waits and pauses as planned. Then the registers
//   are read against the firmware's values once more and the frames
//   counted, and the log says what came back.
//
// Built for the host too, against a card that is a table
// (tests/460_gpu_mode_set_runtime.mlx).
//
// A TMDS OUTPUT'S PLAN has steps that are runs of the card's own firmware
// tables (the pixel clock's PLL, the transmitter, the timing, the
// controller's start and stop: gpu_mode.mlx's head) among its writes. It
// is carried out by `attemptWith`, which is lent the interpreter with the
// card's ROM open and the card as a table reaches it (`Tables`: gpu.mlx's
// hands, which take a write only when the image asks). The same care,
// and more:
// - a field is set in the word as it stands at that moment (a table may
//   have written the word in between), and read back;
// - a table's run is given its block as the plan worked it out, and its
//   answer is looked at: a table that does not run to its end (the
//   interpreter says how it ended and where), or runs to it and wrote
//   nothing, ends the change. So does a state that does not follow a
//   table (the transmitter's, the controller's), a clock source or timing
//   words that are not what the table was told, and frames that do not
//   count at the plan's rate while the transmitter is still off: the PLL
//   cannot be read, it is measured there, before the monitor is sent
//   anything;
// - the way back is the plan's own (`plan.back`: the same sequence
//   towards the firmware's state, the tables told the firmware's timing,
//   mode and clock). Nothing of it is gone through when no table of the
//   output's has written anything yet: then the registers the plan wrote
//   get the firmware's values and that is all (and the display engine's
//   clock its own again, if it was raised). On the way back only two
//   things end it early: a table that does not run to its end (what it
//   left is not known, and nothing more is run), and frames counted at
//   another rate than the firmware's (the transmitter is then not turned
//   on for a clock that is known to be wrong). A check of ours that
//   fails there is said and the way goes on: such a check may be wrong
//   about a table that did its work, and a way back that stopped at it
//   would cost the picture. So too when no frames at all are counted
//   with the transmitter off: the firmware's own timing is sent all the
//   same. But a way back that went on so has not shown that the output
//   is as the firmware had it (a transmitter whose state did not come on
//   may be off): its last line then says that the firmware's state is
//   not known to be back and how many such things there were, and says
//   "back" only when none was met and the frames count as before;
// - what cannot be read back is said as such: the PLL's and the PHY's
//   own settings are what the tables made for the firmware's clock as it
//   was measured, not what the firmware had. Every register a table
//   wrote is noted by its number and listed in the log (not what it
//   held before: a read in the middle of a table's own writes could be
//   one the table does not expect);
// - the log (not the screen, which is dark meanwhile) says each table's
//   run, each state waited for and how long it took, the frames counted
//   and the timing's words as the table left them;
// - how long it can take is bounded whatever the card does (a state is
//   waited for a tenth of a second at most, a table is given two seconds
//   and no more), and said before the first write: so many seconds at
//   most there, so many more for the way back (`longest`).
// WITH THE SETTING OFF NO TABLE IS RUN, not with hands that cannot write
// either: such a run would end at the table's first write and say little
// (the plan already says every block), it would still read registers of
// the card nobody here has seen read, and the tables as a whole can be
// run where nothing is at stake: the ROM is handed over as a file at
// every boot (/devices/gpurom), for tools/check_atom_reference.sh on the
// host.
const scanout = @import("./gpu_display.mlx")
const mode = @import("./gpu_mode.mlx")
const atom = @import("./atom.mlx")
const blocks = @import("./gpu_blocks.mlx")
const videorom = @import("./gpu_rom.mlx")

// What the kernel lends for a change: a display register written (its
// number as the headers count, as for a read), and `bytes` of the
// aperture from `offset` cleared (the new picture's memory).
pub const Hands = struct {
    write: fn(usize, u32) -> void
    clear: fn(usize, usize) -> void
}

// What the kernel lends beside for a plan with table runs: the
// interpreter with the card's ROM open, the card as a table reaches it,
// and a switch for what is said: for the log alone from here on (true),
// or for the screen too (false).
pub const Tables = struct {
    machine: *atom.Atom
    hands: atom.Hands
    aside: fn(bool) -> void
}

pub const Outcome = enum(u8) {
    // Nothing was written: not asked for, or the plan is not complete.
    untouched,
    // The plan is carried out and the controller runs with it.
    done,
    // It failed and the firmware's state is back.
    back,
    // It failed and not every register took the firmware's value again.
    astray,
    // It failed, and the way back ended before its end: the output is as
    // that left it.
    lost,
    // It failed; the way back came to its end and every register this
    // driver wrote has the firmware's value again, but something the way
    // back looked for was not there (a state that did not come after its
    // table, clock or timing words that are not the firmware's, a table
    // that wrote nothing, the frames at the end): whether the output is as
    // the firmware had it is not known, and it is not said to be.
    unsure
}

// Why it failed: a write that did not hold, a state that did not come, the
// frames or the memory interface after the change; and of a plan with
// table runs: a table's run, the timing's words after their table, the
// frames counted with the transmitter still off.
pub const Reason = enum(u8) { none, read_back, wait, frames, underflow, table, timing, clock }

pub const Result = struct {
    outcome: Outcome
    reason: Reason
    // The step it failed at (for read_back and wait), and what was read
    // there.
    step: usize
    read: usize
    // Writes made on the way there, and on the way back.
    writes: usize
    writesBack: usize
    // Registers that do not hold the firmware's value after the way back.
    astray: usize
    // The frames counted after the change (or after the way back).
    rate: scanout.Rate
    // Tables run on the way there and on the way back, and how the last
    // run ended.
    runs: usize
    runsBack: usize
    run: atom.Result
    // How many things on the way back were not as they should be while
    // the way went on (each is said in the log where it was met).
    doubts: usize
    // How long a plan with table runs could take at most, and its way
    // back after it (nanoseconds; said in whole seconds before the first
    // write).
    longest: usize
    longestBack: usize
}

// The firmware's value of each step's register (a write step's: read
// before the first write of all), and for a banked write what the word
// held just before it was written.
const Kept = struct {
    first: [mode.STEPS]usize
    banked: [mode.STEPS]usize
    bankedRead: [mode.STEPS]bool
}

var kept: Kept = undefined // (per run)

fn less(a: usize, b: usize) -> usize { return if a > b { a - b } else { 0 } }

// One register written and read back: whether the bits `mask` hold what
// was written (`read`: what the word says).
fn writeChecked(card: *const scanout.Card, hands: *const Hands, register: usize, value: usize, mask: usize, read: *usize) -> bool {
    const write = hands.*.write
    write(register, @intCast(u32, value & 0xFFFFFFFF))
    read.* = card.reg(register)
    return read.* & mask == value & mask
}

// Until the bits `mask` of a register are `value`, `time` nanoseconds at
// most (and a count of looks at most, should the clock stand); no time:
// one look.
fn waitFor(card: *const scanout.Card, register: usize, mask: usize, value: usize, time: usize, read: *usize) -> bool {
    const began = card.time()
    var looks: usize = 0
    while looks < 100000000 {
        looks += 1
        read.* = card.reg(register)
        if read.* & mask == value & mask { return true }
        if time == 0 { return false }
        if less(card.time(), began) > time { return false }
    }
    return false
}

fn pause(card: *const scanout.Card, time: usize) -> void {
    const began = card.time()
    var looks: usize = 0
    while looks < 100000000 && less(card.time(), began) <= time { looks += 1 }
}

// The frames a controller counts against the plan's rate: within a
// fiftieth of it.
fn framesRun(card: *const scanout.Card, plan: *const mode.Plan, rate: *scanout.Rate) -> bool {
    rate.* = scanout.rateOf(card, plan.*.controller, plan.*.hTotal, plan.*.vTotal)
    if rate.*.frames == 0 { return false }
    return less(rate.*.millihertz, plan.*.millihertz) + less(plan.*.millihertz, rate.*.millihertz) <= plan.*.millihertz / 50
}

fn sayRate(card: *const scanout.Card, rate: *const scanout.Rate) -> void {
    const part = rate.*.millihertz % 1000
    card.field("", rate.*.millihertz / 1000)
    card.say(if part < 10 { ".00" } else if part < 100 { ".0" } else { "." })
    card.decimal(part)
}

// The firmware's state put back after the steps up to `reached` were gone
// into (`quiet`: whether a step that makes the output quiet was among
// them: then the steps that wake it are gone through too, to the plan's
// end). How many registers do not hold the firmware's value afterwards.
fn putBack(card: *const scanout.Card, hands: *const Hands, plan: *const mode.Plan, reached: usize, quiet: bool, result: *Result) -> void {
    const end = if quiet { plan.*.count } else { reached + 1 }
    var read: usize = 0
    var k: usize = 0
    while k < end && k < plan.*.count {
        const step = &plan.*.steps[k]
        if step.*.kind == mode.Kind.pause {
            pause(card, step.*.time)
        } else if step.*.kind == mode.Kind.wait {
            _ = waitFor(card, step.*.register, step.*.mask, step.*.value, step.*.time, &read)
        } else {
            var value = kept.first[k]
            var skip = false
            if step.*.phase == mode.Phase.quiet || step.*.transient {
                value = step.*.value
            } else if step.*.banked {
                value = kept.banked[k]
                skip = !kept.bankedRead[k]
            }
            if !skip {
                _ = writeChecked(card, hands, step.*.register, value, step.*.mask, &read)
                result.*.writesBack += 1
            }
        }
        k += 1
    }
    // What is there now against what the firmware had, a register at a
    // time under all the bits the plan's writes to it are read back by (a
    // banked word says only the set that is chosen: left out). One that
    // differs is written once more (a word that was only on the way when
    // the plan ended early, a mark set left chosen; or a write that did
    // not hold); one that differs still is said.
    result.*.astray = 0
    k = 0
    while k < plan.*.count {
        const step = &plan.*.steps[k]
        if step.*.kind == mode.Kind.write && !step.*.banked {
            var mask: usize = 0
            var first = true
            var j: usize = 0
            while j < plan.*.count {
                if plan.*.steps[j].kind == mode.Kind.write && plan.*.steps[j].register == step.*.register {
                    if j < k { first = false }
                    mask = mask | plan.*.steps[j].mask
                }
                j += 1
            }
            if first && card.reg(step.*.register) & mask != kept.first[k] & mask {
                result.*.writesBack += 1
                if !writeChecked(card, hands, step.*.register, kept.first[k], mask, &read) {
                    result.*.astray += 1
                    card.say("gpu: ")
                    card.hexDigits(step.*.register, 4)
                    card.say(" holds ")
                    card.hexDigits(read, 8)
                    card.say(", the firmware had ")
                    card.hexDigits(kept.first[k], 8)
                    card.say("\n")
                }
            }
        }
        k += 1
    }
}

// The plan carried out, or nothing done: see the head. `asked`: whether
// the image asks for the monitor's own mode. What happened is said in the
// log and left in `result`; true when the controller runs the plan's
// picture.
pub fn attempt(card: *const scanout.Card, hands: *const Hands, plan: *const mode.Plan, asked: bool, result: *Result) -> bool {
    return attemptWith(card, hands, null, plan, asked, result)
}

// The same, lent the card's tables too (none: a plan with table runs is
// not carried out).
pub fn attemptWith(card: *const scanout.Card, hands: *const Hands, lent: ?*const Tables, plan: *const mode.Plan, asked: bool, result: *Result) -> bool {
    result.*.outcome = Outcome.untouched
    result.*.reason = Reason.none
    result.*.step = 0
    result.*.read = 0
    result.*.writes = 0
    result.*.writesBack = 0
    result.*.astray = 0
    result.*.rate = scanout.Rate.{ .frames = 0, .nanoseconds = 0, .millihertz = 0, .kilohertz = 0 }
    result.*.runs = 0
    result.*.runsBack = 0
    result.*.doubts = 0
    result.*.longest = 0
    result.*.longestBack = 0
    result.*.run = atom.Result.{ .end = atom.End.done, .table = 0, .offset = 0, .opcode = 0, .space = atom.Space.register, .register = 0, .value = 0, .steps = 0, .reads = 0, .writes = 0, .calls = 0, .waited = 0, .odd = 0, .oddKind = atom.Odd.none, .oddTable = 0, .oddOffset = 0 }
    if !asked {
        card.say("gpu: nothing is written to the card (the image does not ask for the monitor's own mode: settings/gpu)\n")
        return false
    }
    const wish = if plan.*.rehearsal { "gpu: the image asks for the firmware's own mode to be set again by the card's tables (settings/gpu)" } else { "gpu: the image asks for the monitor's own mode (settings/gpu)" }
    if !plan.*.complete || plan.*.count > mode.STEPS {
        card.say(wish)
        card.say(", but the plan is not complete: nothing is written to the card\n")
        return false
    }
    if plan.*.situation == mode.Situation.tmds {
        if lent == null {
            card.say(wish)
            card.say(", but the card's tables are not lent: nothing is written to the card\n")
            return false
        }
        return change(card, hands, lent.?, plan, result)
    }
    card.field("gpu: the image asks for the monitor's own mode (settings/gpu): carrying out the plan's ", plan.*.writes)
    card.say(" writes\n")

    // The firmware's values, and whether the memory interface says it ran
    // dry before anything is changed.
    var k: usize = 0
    while k < plan.*.count {
        kept.first[k] = 0
        kept.banked[k] = 0
        kept.bankedRead[k] = false
        if plan.*.steps[k].kind == mode.Kind.write {
            // (A register written more than once: its first step's
            // value, read before any write.)
            var j: usize = 0
            var found = false
            while j < k && !found {
                if plan.*.steps[j].kind == mode.Kind.write && plan.*.steps[j].register == plan.*.steps[k].register {
                    kept.first[k] = kept.first[j]
                    found = true
                }
                j += 1
            }
            if !found { kept.first[k] = card.reg(plan.*.steps[k].register) }
        }
        k += 1
    }
    const dryBefore = card.reg(mode.DMIF_STATUS) & mode.DMIF_STATUS__DMIF_UNDERFLOW != 0
    const clear = hands.*.clear
    clear(plan.*.offset, plan.*.bytes)

    var quiet = false
    var failed = false
    k = 0
    while k < plan.*.count && !failed {
        const step = &plan.*.steps[k]
        if step.*.phase == mode.Phase.quiet { quiet = true }
        if step.*.kind == mode.Kind.pause {
            pause(card, step.*.time)
        } else if step.*.kind == mode.Kind.wait {
            if !waitFor(card, step.*.register, step.*.mask, step.*.value, step.*.time, &result.*.read) {
                result.*.reason = Reason.wait
                failed = true
            }
        } else {
            if step.*.banked {
                kept.banked[k] = card.reg(step.*.register)
                kept.bankedRead[k] = true
            }
            result.*.writes += 1
            if !writeChecked(card, hands, step.*.register, step.*.value, step.*.mask, &result.*.read) {
                result.*.reason = Reason.read_back
                failed = true
            }
        }
        if failed { result.*.step = k } else { k += 1 }
    }
    if !failed { _ = card.reg(mode.DMIF_STATUS) }
    if failed {
        card.field("gpu: step ", result.*.step + 1)
        card.field(" of ", plan.*.count)
        card.say(if result.*.reason == Reason.wait { " did not come: " } else { " did not hold: " })
        mode.sayStep(card, plan, &plan.*.steps[result.*.step], "")
        card.say(", read ")
        card.hexDigits(result.*.read, 8)
        card.say("\n")
    } else if !framesRun(card, plan, &result.*.rate) {
        result.*.reason = Reason.frames
        result.*.step = plan.*.count - 1
        failed = true
        card.controller(plan.*.controller)
        if result.*.rate.frames == 0 {
            card.say(" counts no frames after the change")
        } else {
            card.say(" counts ")
            sayRate(card, &result.*.rate)
            card.field(" frames a second after the change, not the ", plan.*.millihertz / 1000)
            card.say(" planned")
        }
        card.say("\n")
    } else if !dryBefore && card.reg(mode.DMIF_STATUS) & mode.DMIF_STATUS__DMIF_UNDERFLOW != 0 {
        result.*.reason = Reason.underflow
        result.*.step = plan.*.count - 1
        failed = true
        card.say("gpu: the memory interface ran dry after the change (DMIF_STATUS says an underflow)\n")
    }
    if !failed {
        result.*.outcome = Outcome.done
        card.controller(plan.*.controller)
        card.size(" shows a picture of ", plan.*.width, plan.*.height)
        card.say(" as it is, ")
        sayRate(card, &result.*.rate)
        card.field(" frames a second: the monitor's own mode is set (", result.*.writes)
        card.say(" writes, each read back)\n")
        return true
    }

    card.say("gpu: putting the firmware's state back\n")
    putBack(card, hands, plan, result.*.step, quiet, result)
    // (The rate the firmware's timing ran at is not the plan's when the
    // plan changed the timing: the frames are counted and said, not
    // judged.)
    result.*.rate = scanout.rateOf(card, plan.*.controller, plan.*.hTotal, plan.*.vTotal)
    if result.*.astray == 0 {
        result.*.outcome = Outcome.back
        card.field("gpu: the firmware's state is back (", result.*.writesBack)
        card.say(" writes)")
    } else {
        result.*.outcome = Outcome.astray
        card.field("gpu: the firmware's state is NOT all back: ", result.*.astray)
        card.say(if result.*.astray == 1 { " register differs" } else { " registers differ" })
    }
    card.say(if result.*.rate.frames != 0 { "; the controller counts frames\n" } else { "; the controller counts no frames\n" })
    return false
}

// ---- A plan with table runs (a TMDS output's): the file's head says how
// it is carried out.

// The firmware's value of every register such a plan writes itself, on
// the way there or back, each read before the first write of all; the
// four sets of urgency marks by their order, each read just before it is
// written.
const REGISTERS: usize = 256
const SETS: usize = 8

const Firmware = struct {
    register: [REGISTERS]usize
    value: [REGISTERS]usize
    count: usize
    banked: [SETS]usize
    bankedRead: [SETS]bool
}

var firmware: Firmware = undefined // (per run)

// The registers the card's tables wrote, in the order of their first
// write (the first NOTED of them; `beyond`: writes to others). Their
// numbers alone: what a register held before is not read, a read in the
// middle of a table's own writes could be one the table does not expect.
const NOTED: usize = 384

const Noted = struct {
    register: [NOTED]usize
    count: usize
    beyond: usize
}

var noted: Noted = undefined // (per run)

// The kernel's hands for the tables, behind the ones that note.
var lentHands: atom.Hands = undefined // (per run)

fn notedWrite(number: usize, value: u32) -> bool {
    var k: usize = 0
    while k < noted.count && noted.register[k] != number { k += 1 }
    if k == noted.count {
        if noted.count < NOTED {
            noted.register[k] = number
            noted.count += 1
        } else {
            noted.beyond += 1
        }
    }
    const write = lentHands.write
    return write(number, value)
}

// What a change has come to: how many sets of marks this pass has gone
// through, whether a table of the output's own has written anything
// (then the way back is the whole one), whether the display engine's
// clock's table has.
const Progress = struct {
    sets: usize
    outputWritten: bool
    clockRaised: bool
}

var progress: Progress = undefined // (per run)

// How a step went: as it should; not as it should (on the way there the
// change ends; on the way back it is said and the way goes on); or so
// that either way ends there.
const Went = enum(u8) { well, wrong, ended }

fn firstOf(register: usize) -> usize {
    var k: usize = 0
    while k < firmware.count {
        if firmware.register[k] == register { return firmware.value[k] }
        k += 1
    }
    return 0
}

// A register's firmware value read and kept, once; false when there is
// no room for another.
fn keep(card: *const scanout.Card, register: usize) -> bool {
    var k: usize = 0
    while k < firmware.count {
        if firmware.register[k] == register { return true }
        k += 1
    }
    if firmware.count >= REGISTERS { return false }
    firmware.register[firmware.count] = register
    firmware.value[firmware.count] = card.reg(register)
    firmware.count += 1
    return true
}

fn keepAll(card: *const scanout.Card, steps: []const mode.Step) -> bool {
    var k: usize = 0
    while k < steps.length {
        if steps[k].kind == mode.Kind.write && !steps[k].banked && !keep(card, steps[k].register) { return false }
        k += 1
    }
    return true
}

fn milliseconds(card: *const scanout.Card, began: usize) -> usize { return less(card.time(), began) / 1000000 }

// How long steps can take at most, in nanoseconds, whatever the card
// does: every state's time and every pause; for a table its limit and
// one wait of its own on top (atom.mlx looks at the limit before each
// instruction, and the longest wait an instruction can ask for is 255
// ms); for the frames what gpu_display.mlx's rateOf takes (a tenth of a
// second for a first frame, a quarter to count them). The reads and
// writes themselves take no time worth counting.
const TABLE_WAIT: usize = 255000000
const FRAMES_TIME: usize = 350000000

fn longest(steps: []const mode.Step) -> usize {
    const limits = atom.Limits.usual()
    var time: usize = 0
    var k: usize = 0
    while k < steps.length {
        const step = &steps[k]
        if step.*.kind == mode.Kind.wait || step.*.kind == mode.Kind.pause { time += step.*.time }
        if step.*.kind == mode.Kind.table { time += limits.time + TABLE_WAIT }
        if step.*.kind == mode.Kind.frames { time += FRAMES_TIME }
        k += 1
    }
    return time
}

// Nanoseconds as whole seconds, the next one up.
fn seconds(time: usize) -> usize { return (time + 999999999) / 1000000000 }

// A write of a plan with table runs: the word as planned, or (on the way
// back, for a step that is neither one that makes the output quiet nor
// one on the way) what the firmware had; a field into the word as it
// stands. Read back.
fn writeStep(card: *const scanout.Card, hands: *const Hands, step: *const mode.Step, backwards: bool, result: *Result) -> Went {
    var value = step.*.value
    if step.*.banked {
        const set = progress.sets
        progress.sets += 1
        if set >= SETS { return Went.well }
        if backwards {
            // (A set that was not come to on the way there holds what it
            // held.)
            if !firmware.bankedRead[set] { return Went.well }
            value = firmware.banked[set]
        } else {
            firmware.banked[set] = card.reg(step.*.register)
            firmware.bankedRead[set] = true
        }
    } else if backwards && step.*.phase != mode.Phase.quiet && !step.*.transient {
        value = firstOf(step.*.register)
    }
    var word = value
    if step.*.live { word = (card.reg(step.*.register) & ~step.*.mask) | (value & step.*.mask) }
    if backwards { result.*.writesBack += 1 } else { result.*.writes += 1 }
    if writeChecked(card, hands, step.*.register, word, step.*.mask, &result.*.read) { return Went.well }
    result.*.reason = Reason.read_back
    return Went.wrong
}

// One of the card's tables run with its block (the other one, when the
// card says so at that moment), its answer said in the log.
fn runStep(card: *const scanout.Card, lent: *const Tables, plan: *const mode.Plan, step: *const mode.Step, at: usize, backwards: bool, result: *Result) -> Went {
    var which = step.*.block
    if step.*.other < mode.BLOCKS && card.reg(step.*.pick) & step.*.pickMask == step.*.pickValue { which = step.*.other }
    if which >= mode.BLOCKS {
        result.*.reason = Reason.table
        return Went.ended
    }
    const block = &plan.*.blocks[which]
    var params: [blocks.WORDS]u32 = block.*.words
    const limits = atom.Limits.usual()
    var hands = lent.*.hands
    hands.write = notedWrite
    const before = noted.count
    const machine = lent.*.machine
    const done = machine.run(&hands, block.*.table, params[0..], &limits, &result.*.run)
    const run = &result.*.run
    if backwards { result.*.runsBack += 1 } else { result.*.runs += 1 }
    if run.*.writes != 0 && !backwards {
        if at >= plan.*.outputAt { progress.outputWritten = true } else { progress.clockRaised = true }
    }
    card.say("gpu: table ")
    card.say(blocks.tableName(block.*.table))
    card.say(" (")
    card.say(step.*.name)
    card.say(") ")
    card.say(atom.endName(run.*.end))
    if !done {
        card.fieldHex(" at ", run.*.offset)
        card.field(" of the ROM (opcode ", run.*.opcode)
        card.say(")")
        if run.*.end == atom.End.refused || run.*.end == atom.End.unreachable {
            card.fieldHex(": register ", run.*.register)
            card.fieldHex(", the word ", run.*.value)
        }
    }
    card.field(": ", run.*.steps)
    card.field(" instructions, ", run.*.reads)
    card.field(" reads, ", run.*.writes)
    card.field(" writes (", noted.count - before)
    card.field(" registers not written before), ", run.*.waited)
    card.say(" us waited")
    if run.*.odd != 0 {
        card.field("; it went on after ", run.*.odd)
        card.say(" things Linux's interpreter goes on after too")
    }
    // (The display clock's table says what it set; one that wrote
    // nothing has set nothing.)
    if done && run.*.writes != 0 && block.*.table == videorom.Command.SetDCEClock && block.byte(blocks.SET_DCE_CLOCK_PARAMETERS_V2_1__ucDCEClkType) == blocks.DCE_CLOCK_TYPE_DISPCLK {
        card.field("; it answers ", @intCast(usize, params[0]) * 10)
        card.say(" kHz")
    }
    card.say("\n")
    if !done {
        result.*.reason = Reason.table
        return Went.ended
    }
    if run.*.writes == 0 {
        result.*.reason = Reason.table
        return Went.wrong
    }
    return Went.well
}

// The frames counted while the transmitter is off, against the rate the
// controller is to run at: the plan's, or on the way back the firmware's
// as it was counted. No frames at all: not as it should be, and said so
// (on the way back the way goes on: the file's head); frames at another
// rate: the PLL does not give the clock, and either way ends.
fn framesStep(card: *const scanout.Card, plan: *const mode.Plan, backwards: bool, result: *Result) -> Went {
    const tm = &plan.*.tmds
    const hTotal = if backwards { tm.*.was.hTotal } else { plan.*.hTotal }
    const vTotal = if backwards { tm.*.was.vTotal } else { plan.*.vTotal }
    const wanted = if backwards { tm.*.wasMillihertz } else { plan.*.millihertz }
    const asked = if backwards { tm.*.clockBack } else { plan.*.timing.clock }
    result.*.rate = scanout.rateOf(card, plan.*.controller, hTotal, vTotal)
    card.controller(plan.*.controller)
    if result.*.rate.frames == 0 {
        card.say(" runs but counts no frames with the output off: the clock is not judged here")
        card.say(if backwards { "; the firmware's own timing is sent all the same\n" } else { ", nothing is sent\n" })
        result.*.reason = Reason.clock
        return Went.wrong
    }
    card.say(" counts ")
    sayRate(card, &result.*.rate)
    card.field(" frames a second with the output still off: the PLL gives ", result.*.rate.kilohertz)
    card.field(" kHz (asked for: ", asked)
    card.say(" kHz)\n")
    if less(result.*.rate.millihertz, wanted) + less(wanted, result.*.rate.millihertz) <= wanted / 50 { return Went.well }
    result.*.reason = Reason.clock
    return Went.ended
}

// The controller's timing words read and held against what the timing's
// table was told; said in full, as planned or not.
fn timingStep(card: *const scanout.Card, plan: *const mode.Plan, backwards: bool, result: *Result) -> Went {
    const told = if backwards { &plan.*.tmds.was } else { &plan.*.timing }
    const wanted = mode.timingWords(told)
    const at = scanout.OFFSETS[plan.*.controller]
    var words: [mode.TIMING_WORDS]usize = undefined
    var same = true
    var k: usize = 0
    while k < mode.TIMING_WORDS {
        words[k] = card.reg(at + wanted.register[k]) & wanted.mask[k]
        if words[k] != wanted.value[k] & wanted.mask[k] {
            if same { result.*.read = words[k] }
            same = false
        }
        k += 1
    }
    card.say("gpu: the timing's table left ")
    mode.sayTimingWords(card, &words)
    if same {
        card.say(" (as it was told)\n")
        return Went.well
    }
    card.say("; it was told ")
    mode.sayTimingWords(card, &wanted.value)
    card.say("\n")
    result.*.reason = Reason.timing
    return Went.wrong
}

// One step of a plan with table runs.
fn carry(card: *const scanout.Card, hands: *const Hands, lent: *const Tables, plan: *const mode.Plan, step: *const mode.Step, at: usize, backwards: bool, result: *Result) -> Went {
    if step.*.gateMask != 0 && card.reg(step.*.gate) & step.*.gateMask != step.*.gateValue {
        card.say("gpu: left out, the card being as it is: ")
        card.say(step.*.name)
        card.say("\n")
        return Went.well
    }
    if step.*.kind == mode.Kind.pause {
        pause(card, step.*.time)
        return Went.well
    }
    if step.*.kind == mode.Kind.write { return writeStep(card, hands, step, backwards, result) }
    if step.*.kind == mode.Kind.table { return runStep(card, lent, plan, step, at, backwards, result) }
    if step.*.kind == mode.Kind.frames { return framesStep(card, plan, backwards, result) }
    if step.*.kind == mode.Kind.timing { return timingStep(card, plan, backwards, result) }
    if step.*.kind == mode.Kind.look {
        card.say("gpu: ")
        card.hexDigits(step.*.register, 4)
        card.say(" reads ")
        card.hexDigits(card.reg(step.*.register), 8)
        card.say(" (")
        card.say(step.*.name)
        card.say(")\n")
        return Went.well
    }
    const began = card.time()
    const came = waitFor(card, step.*.register, step.*.mask, step.*.value, step.*.time, &result.*.read)
    card.say("gpu: ")
    card.hexDigits(step.*.register, 4)
    card.say(" & ")
    card.hexDigits(step.*.mask, 8)
    card.say(if came { " is " } else { " is not " })
    card.hexDigits(step.*.value, 8)
    if step.*.time != 0 { card.field(" after ", milliseconds(card, began)) }
    card.say(if step.*.time != 0 { " ms (" } else { " (" })
    card.say(step.*.name)
    if !came {
        card.say("): it reads ")
        card.hexDigits(result.*.read, 8)
        card.say("\n")
        result.*.reason = Reason.wait
        return Went.wrong
    }
    card.say(")\n")
    return Went.well
}

// The steps `from` to `until` of the way back gone through; false when
// the way ended there (the step it ended at is said).
fn goBack(card: *const scanout.Card, hands: *const Hands, lent: *const Tables, plan: *const mode.Plan, from: usize, until: usize, result: *Result) -> bool {
    var k = from
    while k < until && k < plan.*.backCount {
        const step = &plan.*.back[k]
        const went = carry(card, hands, lent, plan, step, k, true, result)
        if went == Went.ended {
            card.field("gpu: the way back ends at its step ", k + 1)
            card.field(" of ", plan.*.backCount)
            card.say(": ")
            mode.sayStep(card, plan, step, "")
            card.say("\n")
            return false
        }
        // (A write that did not hold is judged at the end, register by
        // register; frames that did not count with the transmitter off,
        // by the frames counted at the end.)
        if went == Went.wrong && step.*.kind != mode.Kind.write && step.*.kind != mode.Kind.frames {
            result.*.doubts += 1
            card.say("gpu: on the way back, not as it should be (the way goes on): ")
            mode.sayStep(card, plan, step, "")
            card.say("\n")
        }
        k += 1
    }
    return true
}

// Every register the plan writes itself held against what the firmware
// had, under all the bits the plan's writes to it are read back by; one
// that differs is given those bits again, and said when it still
// differs. How many do.
fn sweep(card: *const scanout.Card, hands: *const Hands, plan: *const mode.Plan, result: *Result) -> void {
    result.*.astray = 0
    var n: usize = 0
    while n < firmware.count {
        const register = firmware.register[n]
        var mask: usize = 0
        var k: usize = 0
        while k < plan.*.count {
            if plan.*.steps[k].kind == mode.Kind.write && !plan.*.steps[k].banked && plan.*.steps[k].register == register { mask = mask | plan.*.steps[k].mask }
            k += 1
        }
        k = 0
        while k < plan.*.backCount {
            if plan.*.back[k].kind == mode.Kind.write && !plan.*.back[k].banked && plan.*.back[k].register == register { mask = mask | plan.*.back[k].mask }
            k += 1
        }
        const now = card.reg(register)
        if now & mask != firmware.value[n] & mask {
            var read: usize = 0
            result.*.writesBack += 1
            if !writeChecked(card, hands, register, (now & ~mask) | (firmware.value[n] & mask), mask, &read) {
                result.*.astray += 1
                card.say("gpu: ")
                card.hexDigits(register, 4)
                card.say(" holds ")
                card.hexDigits(read, 8)
                card.say(", the firmware had ")
                card.hexDigits(firmware.value[n], 8)
                card.say("\n")
            }
        }
        n += 1
    }
}

// The registers the tables wrote, for the log: their numbers, twelve to a
// line. (Held beside what the same ROM's tables write on the host, they
// say whether the tables took the same way here.)
fn sayNoted(card: *const scanout.Card) -> void {
    card.field("gpu: the card's tables wrote ", noted.count)
    card.say(if noted.count == 1 { " register" } else { " registers" })
    if noted.beyond != 0 { card.field(" and more (writes not noted: ", noted.beyond) }
    card.say(if noted.beyond != 0 { ")\n" } else { "\n" })
    var k: usize = 0
    while k < noted.count {
        if k % 12 == 0 { card.say("gpu: written by the tables:") }
        card.say(" ")
        card.hexDigits(noted.register[k], 4)
        k += 1
        if k % 12 == 0 || k == noted.count { card.say("\n") }
    }
}

fn reasonText(reason: Reason) -> []const u8 {
    return match reason {
        .none => "nothing",
        .read_back => "a write did not hold",
        .wait => "a state did not come",
        .frames => "the frames after the change",
        .underflow => "the memory interface ran dry",
        .table => "a table's run",
        .timing => "the timing's words are not what their table was told",
        .clock => "the frames counted with the output off"
    }
}

// A plan with table runs carried out: the file's head. True when the
// controller runs the plan's picture.
fn change(card: *const scanout.Card, hands: *const Hands, lent: *const Tables, plan: *const mode.Plan, result: *Result) -> bool {
    const aside = lent.*.aside
    const tm = &plan.*.tmds
    firmware.count = 0
    var set: usize = 0
    while set < SETS {
        firmware.banked[set] = 0
        firmware.bankedRead[set] = false
        set += 1
    }
    noted.count = 0
    noted.beyond = 0
    lentHands = lent.*.hands
    progress = Progress.{ .sets = 0, .outputWritten = false, .clockRaised = false }
    const steps = plan.*.steps[0..plan.*.count]
    const back = plan.*.back[0..plan.*.backCount]
    if !keepAll(card, steps) || !keepAll(card, back) {
        card.say("gpu: the plan writes more registers than their firmware values can be kept of: nothing is written to the card\n")
        return false
    }
    const dryBefore = card.reg(mode.DMIF_STATUS) & mode.DMIF_STATUS__DMIF_UNDERFLOW != 0
    if !plan.*.rehearsal {
        const clear = hands.*.clear
        clear(plan.*.offset, plan.*.bytes)
    }
    card.say(if plan.*.rehearsal { "gpu: the image asks for the firmware's own mode to be set again by the card's tables (settings/gpu): carrying out the plan's " } else { "gpu: the image asks for the monitor's own mode (settings/gpu): carrying out the plan's " })
    card.field("", plan.*.runs)
    card.field(" table runs and ", plan.*.writes)
    // (How long at most: the steps' own times and the frames counted
    // after them; the way back's likewise.)
    result.*.longest = longest(steps) + FRAMES_TIME
    result.*.longestBack = longest(back) + FRAMES_TIME
    card.field(" writes; the screen is dark meanwhile, ", seconds(result.*.longest))
    card.field(" s at most (and ", seconds(result.*.longestBack))
    card.say(" s more at most if the firmware's state has to be put back)\n")

    aside(true)
    var k: usize = 0
    var went = Went.well
    while k < plan.*.count && went == Went.well {
        went = carry(card, hands, lent, plan, &plan.*.steps[k], k, false, result)
        if went == Went.well { k += 1 }
    }
    var failed = went != Went.well
    result.*.step = if failed { k } else { plan.*.count - 1 }
    if !failed {
        _ = card.reg(mode.DMIF_STATUS)
        if !framesRun(card, plan, &result.*.rate) {
            result.*.reason = Reason.frames
            failed = true
        } else if !dryBefore && card.reg(mode.DMIF_STATUS) & mode.DMIF_STATUS__DMIF_UNDERFLOW != 0 {
            result.*.reason = Reason.underflow
            failed = true
        }
    }
    sayNoted(card)
    aside(false)
    if !failed {
        result.*.outcome = Outcome.done
        card.controller(plan.*.controller)
        if plan.*.rehearsal {
            card.say(" runs the firmware's own mode again, set by the card's tables, ")
        } else {
            card.size(" shows a picture of ", plan.*.width, plan.*.height)
            card.say(" as it is, ")
        }
        sayRate(card, &result.*.rate)
        card.say(if plan.*.rehearsal { " frames a second: the picture is where it was (" } else { " frames a second: the monitor's own mode is set (" })
        card.field("", result.*.runs)
        card.field(" table runs, ", result.*.writes)
        card.say(" writes, each read back)\n")
        return true
    }

    if result.*.reason == Reason.frames {
        card.controller(plan.*.controller)
        if result.*.rate.frames == 0 {
            card.say(" counts no frames after the change")
        } else {
            card.say(" counts ")
            sayRate(card, &result.*.rate)
            card.field(" frames a second after the change, not the ", plan.*.millihertz / 1000)
            card.say(" planned")
        }
        card.say("\n")
    } else if result.*.reason == Reason.underflow {
        card.say("gpu: the memory interface ran dry after the change (DMIF_STATUS says an underflow)\n")
    } else {
        card.field("gpu: step ", result.*.step + 1)
        card.field(" of ", plan.*.count)
        card.say(" failed (")
        card.say(reasonText(result.*.reason))
        if result.*.reason == Reason.table {
            card.say(": it ")
            card.say(if result.*.run.end == atom.End.done { "ran to its end and wrote nothing" } else { atom.endName(result.*.run.end) })
        }
        card.say("): ")
        mode.sayStep(card, plan, &plan.*.steps[result.*.step], "")
        if result.*.reason == Reason.read_back || result.*.reason == Reason.wait {
            card.say(", read ")
            card.hexDigits(result.*.read, 8)
        }
        card.say("\n")
    }

    // The way back: all of it once a table of the output's has written
    // anything, else the registers alone.
    card.say("gpu: putting the firmware's state back")
    card.say(if progress.outputWritten { " (the same steps, the card's tables told the firmware's timing and clock)\n" } else { " (nothing of the output was changed by a table yet: the registers alone)\n" })
    aside(true)
    progress.sets = 0
    // (Why the change failed stays what the result says, whatever the
    // way back meets.)
    const reason = result.*.reason
    const read = result.*.read
    const run = result.*.run
    var whole = true
    if progress.outputWritten {
        whole = goBack(card, hands, lent, plan, 0, plan.*.backPicture, result)
        _ = goBack(card, hands, lent, plan, plan.*.backPicture, plan.*.backMarks, result)
    }
    _ = goBack(card, hands, lent, plan, plan.*.backMarks, plan.*.backClock, result)
    sweep(card, hands, plan, result)
    // (After a table that did not run to its end no other is run. The
    // clock's two tables are run under the scratch words as Linux has
    // them, which that part of the way writes and gives back: the
    // registers are gone over once more after it.)
    if progress.clockRaised && whole {
        whole = goBack(card, hands, lent, plan, plan.*.backClock, plan.*.backCount, result)
        sweep(card, hands, plan, result)
    }
    result.*.rate = scanout.rateOf(card, plan.*.controller, tm.*.was.hTotal, tm.*.was.vTotal)
    result.*.reason = reason
    result.*.read = read
    result.*.run = run
    aside(false)
    // The firmware's state is said to be back only when the way back came
    // to its end, every register took the firmware's value, everything
    // the way back looked for was there (the transmitter on after its
    // table, the controller running, its clock and timing words as told)
    // and the controller counts frames as it did before. A way back that
    // went on after one of its checks did not hold (the file's head says
    // why it goes on) has not shown that; so it says what is known, and
    // no more.
    const asBefore = result.*.rate.frames != 0 && less(result.*.rate.millihertz, tm.*.wasMillihertz) + less(tm.*.wasMillihertz, result.*.rate.millihertz) <= tm.*.wasMillihertz / 50
    if !whole {
        result.*.outcome = Outcome.lost
        card.field("gpu: the way back did not come to its end: the output is left as that left it until a restart; the registers this driver wrote have the firmware's values again (", result.*.writesBack)
        card.say(" writes)")
        if result.*.astray != 0 { card.field(", but for ", result.*.astray) }
    } else if result.*.astray != 0 {
        result.*.outcome = Outcome.astray
        card.field("gpu: the firmware's state is NOT all back: ", result.*.astray)
        card.say(if result.*.astray == 1 { " register differs" } else { " registers differ" })
    } else {
        const sure = result.*.doubts == 0 && asBefore
        result.*.outcome = if sure { Outcome.back } else { Outcome.unsure }
        card.say(if sure { "gpu: the firmware's state is back (" } else { "gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (" })
        card.field("", result.*.writesBack)
        card.say(" writes")
        if result.*.runsBack != 0 && progress.outputWritten {
            card.field(", ", result.*.runsBack)
            card.size(" table runs told the firmware's ", tm.*.was.width, tm.*.was.height)
            card.field(" at ", tm.*.clockBack)
            card.say(" kHz: the PLL's and the transmitter's own settings are the tables' for that, they cannot be read")
        } else if result.*.runsBack != 0 {
            // (Nothing of the output was run: these were the display
            // engine's clock's two.)
            card.field(", ", result.*.runsBack)
            card.say(" table runs for the display engine's clock as it was")
        }
        card.say(")")
        if result.*.doubts != 0 {
            card.field(", but ", result.*.doubts)
            card.say(if result.*.doubts == 1 { " thing on the way back was not as it should be (said in the log)" } else { " things on the way back were not as they should be (said in the log)" })
        }
    }
    if result.*.rate.frames == 0 {
        card.say("; the controller counts no frames\n")
    } else {
        card.say("; the controller counts frames (")
        sayRate(card, &result.*.rate)
        card.say(if asBefore { " a second, as before)\n" } else { " a second, which is not the rate of before)\n" })
    }
    return false
}
