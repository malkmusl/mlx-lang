// Channels (spec/04-stdlib/os/brix.xml, channel_pair/send/receive): two
// ends, each with a queue of messages for it: bytes and handles, which
// move from the sender's table into the message and from there into the
// receiver's. An end's descriptor holds the channel's index * 2 + its
// side; an end lives while descriptors name it, and the channel while an
// end does.
const files = @import("./files.mlx")

pub const Message = struct {
    pub const BYTES: usize = 1024
    pub const HANDLES: usize = 4

    length: usize
    count: usize
    bytes: [BYTES]u8
    handles: [HANDLES]files.Descriptor
}

pub const Channel = struct {
    // Messages waiting at each end.
    pub const QUEUE: usize = 16

    used: bool
    // Descriptors naming each end.
    opens: [2]usize
    // Messages for each end (sent from the other): a ring.
    queues: [2][QUEUE]Message
    heads: [2]usize
    counts: [2]usize

    pub fn hasMessage(self: *const Self, side: usize) -> bool { return self.*.counts[side] > 0 }

    pub fn peerOpen(self: *const Self, side: usize) -> bool { return self.*.opens[1 - side] > 0 }

    // Room for a message from `side` to the other end.
    pub fn hasRoom(self: *const Self, side: usize) -> bool { return self.*.counts[1 - side] < QUEUE }

    // The slot of the next message for the other end of `side`.
    pub fn slotFor(self: *Self, side: usize) -> *Message {
        const to = 1 - side
        const k = (self.*.heads[to] + self.*.counts[to]) % QUEUE
        return &self.*.queues[to][k]
    }

    pub fn sent(self: *Self, side: usize) -> void { self.*.counts[1 - side] += 1 }

    // The oldest message for `side`.
    pub fn first(self: *Self, side: usize) -> *Message { return &self.*.queues[side][self.*.heads[side]] }

    pub fn received(self: *Self, side: usize) -> void {
        self.*.heads[side] = (self.*.heads[side] + 1) % QUEUE
        self.*.counts[side] -= 1
    }
}

pub const Channels = struct {
    pub const MAX: usize = 32

    channels: [MAX]Channel

    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.channels[k].used = false
            k += 1
        }
    }

    // A new channel, each end opened once; MAX when none is free.
    pub fn create(self: *Self) -> usize {
        var k: usize = 0
        while k < MAX {
            const c = &self.*.channels[k]
            if !c.*.used {
                c.*.used = true
                var side: usize = 0
                while side < 2 {
                    c.*.opens[side] = 1
                    c.*.heads[side] = 0
                    c.*.counts[side] = 0
                    side += 1
                }
                return k
            }
            k += 1
        }
        return MAX
    }

    pub fn at(self: *Self, end: usize) -> *Channel { return &self.*.channels[end / 2] }

    pub fn retain(self: *Self, end: usize) -> void { self.at(end).*.opens[end % 2] += 1 }

    // One descriptor of `end` less; the channel goes with its last end,
    // and the handles in its messages with it.
    pub fn release(self: *Self, end: usize) -> void {
        const c = self.at(end)
        c.*.opens[end % 2] -= 1
        if c.*.opens[0] > 0 || c.*.opens[1] > 0 { return }
        var side: usize = 0
        while side < 2 {
            while c.*.counts[side] > 0 {
                const m = c.first(side)
                var h: usize = 0
                while h < m.*.count {
                    files.Descriptors.dropMoved(&m.*.handles[h])
                    h += 1
                }
                c.received(side)
            }
            side += 1
        }
        c.*.used = false
    }
}

var all: Channels = undefined // (per run)

pub fn table() -> *Channels { return &all }
