// The plan for the monitor's own mode on a Polaris card (DCE 11.2): from
// what the display controller was read to run (gpu_display.mlx) and the
// monitor's own timing (edid.mlx), the list of what would be written, in
// order, each word worked out beforehand. Nothing here writes: the card is
// reached through gpu_display's `Card`, which can only read. The plan is
// made and said at every boot; carrying it out is gpu_set.mlx's, and only
// when the image asks (settings/gpu).
//
// Two situations (gpu_display.mlx's head):
// (a) the controller runs the monitor's own timing and the card scales
//     the firmware's small picture: a surface of the timing's size, the
//     viewport, the scaler off, the line buffer, on the running
//     controller;
// (b) the controller runs the small picture's timing: the pixel clock,
//     the timing and what (a) sets. Only by DisplayPort, and only when the
//     link the firmware trained has room for the new clock: on this
//     controller a DisplayPort stream's pixel clock is made by a DTO (a
//     phase over a modulo of a reference clock), which is a register; the
//     link's own clock and its training are the PHY's, set by the card's
//     firmware tables (Linux runs them by an interpreter; not here). A
//     TMDS output's pixel clock is a PLL's, set the same way: not here.
//
// The order and the locks are Linux 6.6's display core for this
// controller (drivers/gpu/drm/amd/display/dc), function by function as
// the steps below name them, with the older amdgpu/dce_v11_0.c where the
// display core leaves a word alone that the firmware set for narrow rows.
// Where Linux hands a step to the card's firmware tables, the registers
// are written directly, by what its own code says they hold, and the step
// says so. Every register number and field is from Linux's headers
// (asic_reg/dce/dce_11_2_d.h and dce_11_2_sh_mask.h), each looked up and
// held against them by tools/check_gpu_registers.py.
//
// Left as the firmware has them: the surface's pixel format and tiling
// (GRPH_CONTROL, GRPH_SWAP_CNTL: the new picture is drawn as the old one
// is), the colour path, the line buffer's pixel depth, the stream's pixel
// format, the stutter and memory clock marks, and the link.
const scanout = @import("./gpu_display.mlx")
const edid = @import("./edid.mlx")

// A controller's registers beyond the read-out's (controller 0's numbers).
pub const GRPH_SECONDARY_SURFACE_ADDRESS: usize = 0x1A05
pub const GRPH_SECONDARY_SURFACE_ADDRESS_HIGH: usize = 0x1A08
pub const GRPH_SURFACE_OFFSET_X: usize = 0x1A09
pub const GRPH_SURFACE_OFFSET_Y: usize = 0x1A0A
pub const GRPH_UPDATE: usize = 0x1A11
pub const GRPH_FLIP_CONTROL: usize = 0x1A12
pub const LB_DESKTOP_HEIGHT: usize = 0x1AC3
pub const DPG_PIPE_ARBITRATION_CONTROL1: usize = 0x1B30
pub const DPG_WATERMARK_MASK_CONTROL: usize = 0x1B32
pub const DPG_PIPE_URGENCY_CONTROL: usize = 0x1B33
pub const SCL_F_SHARP_CONTROL: usize = 0x1B53
pub const CRTC_V_TOTAL_MIN: usize = 0x1B88
pub const CRTC_V_TOTAL_MAX: usize = 0x1B89
pub const CRTC_COUNT_CONTROL: usize = 0x1BA9
pub const CRTC_START_LINE_CONTROL: usize = 0x1BB3
pub const CRTC_DOUBLE_BUFFER_CONTROL: usize = 0x1BB6
// Whether the memory interface ran dry (one word for all controllers).
pub const DMIF_STATUS: usize = 0x2F7
// In an encoder's block, beside the read-out's.
pub const DP_STEER_FIFO: usize = 0xA5

// The fields written and looked at: the header's masks (REGISTER__FIELD
// there).
const DPG_WATERMARK_MASK_CONTROL__URGENCY_WATERMARK_MASK: usize = 0x700
const DPG_PIPE_URGENCY_CONTROL__URGENCY_LOW_WATERMARK: usize = 0xFFFF
const DPG_PIPE_URGENCY_CONTROL__URGENCY_HIGH_WATERMARK: usize = 0xFFFF0000
const DPG_PIPE_ARBITRATION_CONTROL1__PIXEL_DURATION: usize = 0xFFFF
const CRTC_DOUBLE_BUFFER_CONTROL__CRTC_BLANK_DATA_DOUBLE_BUFFER_EN: usize = 0x10000
const CRTC_BLANK_CONTROL__CRTC_BLANK_DATA_EN: usize = 0x100
const CRTC_BLANK_CONTROL__CRTC_CURRENT_BLANK_STATE: usize = 0x1
const PIPE0_DMIF_BUFFER_CONTROL__DMIF_BUFFERS_ALLOCATED: usize = 0x7
const PIPE0_DMIF_BUFFER_CONTROL__DMIF_BUFFERS_ALLOCATION_COMPLETED: usize = 0x10
const LB_MEMORY_CTRL__LB_MEMORY_CONFIG: usize = 0x300000
const LB_DESKTOP_HEIGHT__DESKTOP_HEIGHT: usize = 0x7FFF
const SCL_F_SHARP_CONTROL__SCL_HF_SHARP_SCALE_FACTOR: usize = 0x7
const SCL_F_SHARP_CONTROL__SCL_HF_SHARP_EN: usize = 0x10
const SCL_F_SHARP_CONTROL__SCL_VF_SHARP_SCALE_FACTOR: usize = 0x700
const SCL_F_SHARP_CONTROL__SCL_VF_SHARP_EN: usize = 0x1000
const EXT_OVERSCAN_LEFT_RIGHT__EXT_OVERSCAN_LEFT: usize = 0x1FFF0000
const EXT_OVERSCAN_LEFT_RIGHT__EXT_OVERSCAN_RIGHT: usize = 0x1FFF
const EXT_OVERSCAN_TOP_BOTTOM__EXT_OVERSCAN_TOP: usize = 0x1FFF0000
const EXT_OVERSCAN_TOP_BOTTOM__EXT_OVERSCAN_BOTTOM: usize = 0x1FFF
const SCL_BYPASS_CONTROL__SCL_BYPASS_MODE: usize = 0x3
const SCL_MODE__SCL_MODE: usize = 0x3
const SCL_MODE__SCL_PSCL_EN: usize = 0x10
const VIEWPORT_START__VIEWPORT_X_START: usize = 0x3FFF0000
const VIEWPORT_START__VIEWPORT_Y_START: usize = 0x3FFF
const VIEWPORT_SIZE__VIEWPORT_WIDTH: usize = 0x3FFF0000
const VIEWPORT_SIZE__VIEWPORT_HEIGHT: usize = 0x3FFF
const GRPH_UPDATE__GRPH_UPDATE_LOCK: usize = 0x10000
const GRPH_UPDATE__GRPH_SURFACE_UPDATE_PENDING: usize = 0x4
const GRPH_ENABLE__GRPH_ENABLE: usize = 0x1
const GRPH_SURFACE_OFFSET_X__GRPH_SURFACE_OFFSET_X: usize = 0x3FFF
const GRPH_SURFACE_OFFSET_Y__GRPH_SURFACE_OFFSET_Y: usize = 0x3FFF
const GRPH_X_START__GRPH_X_START: usize = 0x3FFF
const GRPH_Y_START__GRPH_Y_START: usize = 0x3FFF
const GRPH_X_END__GRPH_X_END: usize = 0x7FFF
const GRPH_Y_END__GRPH_Y_END: usize = 0x7FFF
const GRPH_PITCH__GRPH_PITCH: usize = 0x7FFF
const GRPH_FLIP_CONTROL__GRPH_SURFACE_UPDATE_H_RETRACE_EN: usize = 0x1
const GRPH_PRIMARY_SURFACE_ADDRESS_HIGH__GRPH_PRIMARY_SURFACE_ADDRESS_HIGH: usize = 0xFF
const GRPH_PRIMARY_SURFACE_ADDRESS__GRPH_PRIMARY_SURFACE_ADDRESS: usize = 0xFFFFFF00
const GRPH_SECONDARY_SURFACE_ADDRESS_HIGH__GRPH_SECONDARY_SURFACE_ADDRESS_HIGH: usize = 0xFF
const GRPH_SECONDARY_SURFACE_ADDRESS__GRPH_SECONDARY_SURFACE_ADDRESS: usize = 0xFFFFFF00
const CRTC_H_TOTAL__CRTC_H_TOTAL: usize = 0x3FFF
const CRTC_V_TOTAL__CRTC_V_TOTAL: usize = 0x3FFF
const CRTC_V_TOTAL_MAX__CRTC_V_TOTAL_MAX: usize = 0x3FFF
const CRTC_V_TOTAL_MIN__CRTC_V_TOTAL_MIN: usize = 0x3FFF
const CRTC_H_BLANK_START_END__CRTC_H_BLANK_START: usize = 0x3FFF
const CRTC_H_BLANK_START_END__CRTC_H_BLANK_END: usize = 0x3FFF0000
const CRTC_V_BLANK_START_END__CRTC_V_BLANK_START: usize = 0x3FFF
const CRTC_V_BLANK_START_END__CRTC_V_BLANK_END: usize = 0x3FFF0000
const CRTC_H_SYNC_A__CRTC_H_SYNC_A_START: usize = 0x3FFF
const CRTC_H_SYNC_A__CRTC_H_SYNC_A_END: usize = 0x3FFF0000
const CRTC_V_SYNC_A__CRTC_V_SYNC_A_START: usize = 0x3FFF
const CRTC_V_SYNC_A__CRTC_V_SYNC_A_END: usize = 0x3FFF0000
const CRTC_H_SYNC_A_CNTL__CRTC_H_SYNC_A_POL: usize = 0x1
const CRTC_V_SYNC_A_CNTL__CRTC_V_SYNC_A_POL: usize = 0x1
const CRTC_COUNT_CONTROL__CRTC_HORZ_COUNT_BY2_EN: usize = 0x1
const CRTC_START_LINE_CONTROL__CRTC_PROGRESSIVE_START_LINE_EARLY: usize = 0x1
const CRTC_START_LINE_CONTROL__CRTC_INTERLACE_START_LINE_EARLY: usize = 0x2
const CRTC_START_LINE_CONTROL__CRTC_PREFETCH_EN: usize = 0x4
const CRTC_START_LINE_CONTROL__CRTC_LEGACY_REQUESTOR_EN: usize = 0x100
const CRTC_START_LINE_CONTROL__CRTC_ADVANCED_START_LINE_POSITION: usize = 0xFF000
const CRTC_CONTROL__CRTC_HBLANK_EARLY_CONTROL: usize = 0x700000
const DP_VID_STREAM_CNTL__DP_VID_STREAM_ENABLE: usize = 0x1
const DP_VID_STREAM_CNTL__DP_VID_STREAM_DIS_DEFER: usize = 0x300
const DP_VID_STREAM_CNTL__DP_VID_STREAM_STATUS: usize = 0x10000
const DP_STEER_FIFO__DP_STEER_FIFO_RESET: usize = 0x1
const DP_VID_TIMING__DP_VID_M_N_GEN_EN: usize = 0x100
const DP_VID_N__DP_VID_N: usize = 0xFFFFFF
const DP_VID_M__DP_VID_M: usize = 0xFFFFFF
const DIG_FE_CNTL__DIG_START: usize = 0x400
const DP_DTO0_PHASE__DP_DTO0_PHASE: usize = 0xFFFFFFFF
const DP_PIXEL_FORMAT__DP_COMPONENT_DEPTH: usize = 0x7000000
pub const DMIF_STATUS__DMIF_UNDERFLOW: usize = 0x10000000

// Linux's "safe" urgency mark (dce110_hw_sequencer.c, MAX_WATERMARK): the
// rows are asked for with urgency whatever the buffer holds.
const MAX_WATERMARK: usize = 0xFFFF
// The N that M is given for (dce110_stream_encoder_dp_unblank).
const VID_N: usize = 0x8000
// A DisplayPort link's symbol clocks in kHz (a tenth of a lane's bit rate:
// 1.62, 2.7, 5.4 and 8.1 Gbit/s; Linux's link rates 0x06, 0x0A, 0x14 and
// 0x1E times 27 MHz, dc_dp_types.h).
const LINK_CLOCKS = [_]usize{ 162000, 270000, 540000, 810000 }

// Waits, in nanoseconds: for a blanking, a buffer allocation, a surface or
// a stream's state to be taken (a frame or two; Linux waits 100 ms for a
// blank, 30 ms for a stream to stop); what a monitor is given to see that
// the stream is gone (dce110_blank_stream's 60 ms); and what the encoder's
// logic is given before the stream starts (dp_unblank's 100 us).
const TAKEN: usize = 100000000
const STREAM_GONE: usize = 60000000
const ENCODER_PRIMED: usize = 100000

pub const STEPS: usize = 96

pub const Kind = enum(u8) { write, wait, pause }

// What a step is for, which says how it is done again when the firmware's
// state is put back (gpu_set.mlx): one that makes the output quiet (the
// stream stopped, the controller blanked) is done the same; one that
// changes or wakes is done with the firmware's value.
pub const Phase = enum(u8) { quiet, change, wake }

pub const Step = struct {
    kind: Kind
    phase: Phase
    // A write that is only on the way to others (a lock taken and let go,
    // a mark set chosen, the M and N generator held, the encoder's FIFO
    // brought in step): done the same when the firmware's state is put
    // back.
    transient: bool
    // A write to a word that stands for several (the urgency marks of the
    // set chosen before it): what it held is read just before it is
    // written.
    banked: bool
    register: usize
    // A write: the word, and the bits of it that what is read back is
    // held against (none: a bit that may clear itself). A wait: the bits
    // looked at and what they are to become.
    value: usize
    mask: usize
    // A wait: how long at most; a pause: how long (nanoseconds).
    time: usize
    // What it is, for the log.
    name: []const u8
}

pub const Situation = enum(u8) {
    // Nothing to plan.
    none,
    // (a): the controller runs the monitor's own timing.
    scaled,
    // (b): the timing has to be set, the monitor is on DisplayPort.
    displayport,
    // (b) on an output whose clock is a PLL's.
    tmds
}

// Why a plan is not complete (nothing would be written).
pub const Missing = enum(u8) {
    nothing,
    not_plausible,
    // The picture the kernel draws on is not in this card's memory (the
    // firmware's console is another adapter's, or there is none): the
    // monitor whose EDID the loader passed on is that picture's, not
    // known to be this card's, and there is no picture here to replace.
    elsewhere,
    no_controller,
    several,
    interlaced,
    // The controller shows the picture as it is and the monitor's own
    // timing is not known: there is nothing to go to.
    no_monitor,
    // The controller shows the monitor's own size unscaled already.
    already,
    no_room,
    no_frames,
    no_encoder,
    tmds,
    several_streams,
    not_trained,
    no_dto,
    no_clock,
    no_link_rate,
    link_too_slow,
    sync_elsewhere,
    too_large
}

// A DisplayPort link as the firmware trained it.
pub const Link = struct {
    lanes: usize
    // The symbol clock in kHz (0: not known), and M and N it was derived
    // from.
    clock: usize
    m: usize
    n: usize
    // Bits a pixel on the link, and the pixel clock (kHz) it has room
    // for: lanes times symbols times eight bits, over the bits a pixel.
    bits: usize
    room: usize
}

pub const Plan = struct {
    situation: Situation
    missing: Missing
    complete: bool
    controller: usize
    // The picture planned: its size, the pixels from row to row, where in
    // the aperture and how many bytes, the card's own address of it.
    width: usize
    height: usize
    pitch: usize
    offset: usize
    bytes: usize
    address: usize
    // (b): the timing to set, the pixel clock now (kHz) and how it is
    // known, the DTO's phase now and planned, the link.
    timing: edid.Timing
    clockNow: usize
    clockMeasured: bool
    phaseNow: usize
    phase: usize
    link: Link
    // The frames in a thousand seconds and the totals the controller is
    // to run with afterwards (what the frame counter is held against).
    millihertz: usize
    hTotal: usize
    vTotal: usize
    steps: [STEPS]Step
    count: usize
    // How many of the steps are writes.
    writes: usize
}

fn less(a: usize, b: usize) -> usize { return if a > b { a - b } else { 0 } }

// Whether `a` is `b` but for a part in `part`.
fn near(a: usize, b: usize, part: usize) -> bool { return less(a, b) + less(b, a) <= b / part }

// The steps as they are put together: what a register holds as the plan
// goes on is what the plan's last write to it gave, else what the card
// says now.
const Builder = struct {
    card: *const scanout.Card
    plan: *Plan
    phase: Phase

    fn now(self: *const Self, register: usize) -> usize {
        const plan = self.*.plan
        var k = plan.*.count
        while k > 0 {
            k -= 1
            if plan.*.steps[k].kind == Kind.write && plan.*.steps[k].register == register { return plan.*.steps[k].value }
        }
        return self.*.card.reg(register)
    }

    fn add(self: *Self, kind: Kind, register: usize, value: usize, mask: usize, time: usize, name: []const u8) -> *Step {
        const plan = self.*.plan
        // (A plan longer than the room is none: `count` says so.)
        const at = if plan.*.count < STEPS { plan.*.count } else { STEPS - 1 }
        plan.*.steps[at] = Step.{ .kind = kind, .phase = self.*.phase, .transient = false, .banked = false, .register = register, .value = value, .mask = mask, .time = time, .name = name }
        plan.*.count += 1
        if kind == Kind.write { plan.*.writes += 1 }
        return &plan.*.steps[at]
    }

    // The whole word written, `mask` of it read back.
    fn put(self: *Self, register: usize, value: usize, mask: usize, name: []const u8) -> *Step {
        return self.add(Kind.write, register, value, mask, 0, name)
    }

    // The bits `mask` of the word set to `bits`, the others as they are.
    fn update(self: *Self, register: usize, mask: usize, bits: usize, name: []const u8) -> *Step {
        return self.add(Kind.write, register, (self.now(register) & ~mask) | (bits & mask), mask, 0, name)
    }

    fn wait(self: *Self, register: usize, mask: usize, value: usize, name: []const u8) -> void {
        _ = self.add(Kind.wait, register, value, mask, TAKEN, name)
    }

    fn pause(self: *Self, time: usize, name: []const u8) -> void {
        _ = self.add(Kind.pause, 0, 0, 0, time, name)
    }
}

// The urgency marks at their highest in all four sets, so that rows three
// times as long do not run the buffer dry on marks the firmware worked out
// for narrow ones. Linux before it changes what a controller shows:
// dce110_prepare_bandwidth -> dce110_set_safe_displaymarks ->
// dce112_mi_program_display_marks -> program_urgency_watermark for the
// sets 0 to 3 (dce_mem_input.c): the set chosen in
// DPG_WATERMARK_MASK_CONTROL, then both marks in DPG_PIPE_URGENCY_CONTROL.
// (Its stutter and memory clock marks are left: neither is in use here.)
fn safeMarks(b: *Builder, at: usize) -> void {
    var set: usize = 0
    while set < 4 {
        const chosen = b.update(at + DPG_WATERMARK_MASK_CONTROL, DPG_WATERMARK_MASK_CONTROL__URGENCY_WATERMARK_MASK, set << 8, "an urgency mark set chosen")
        chosen.*.transient = true
        const marks = b.put(at + DPG_PIPE_URGENCY_CONTROL, MAX_WATERMARK | (MAX_WATERMARK << 16), DPG_PIPE_URGENCY_CONTROL__URGENCY_LOW_WATERMARK | DPG_PIPE_URGENCY_CONTROL__URGENCY_HIGH_WATERMARK, "its urgency marks at their highest")
        marks.*.banked = true
        set += 1
    }
}

// The mark set that was chosen, chosen again (dce_v11_0_program_watermarks
// ends so: "restore original selection").
fn marksChosen(b: *Builder, at: usize, original: usize) -> void {
    _ = b.put(at + DPG_WATERMARK_MASK_CONTROL, original, DPG_WATERMARK_MASK_CONTROL__URGENCY_WATERMARK_MASK, "the urgency mark set chosen as it was")
}

// The controller's picture blanked, from a frame's start, and waited for:
// dce110_tg_set_blank(true) (dce110_timing_generator.c) and
// hwss_wait_for_blank_complete (dc_hw_sequencer.c), as dce110_enable_
// stream_timing and dce110_reset_hw_ctx_wrap do before anything of a
// controller is set ("otherwise CRTC will be hung in bad state").
fn blank(b: *Builder, at: usize) -> void {
    const state = CRTC_BLANK_CONTROL__CRTC_BLANK_DATA_EN | CRTC_BLANK_CONTROL__CRTC_CURRENT_BLANK_STATE
    _ = b.put(at + CRTC_DOUBLE_BUFFER_CONTROL, CRTC_DOUBLE_BUFFER_CONTROL__CRTC_BLANK_DATA_DOUBLE_BUFFER_EN, CRTC_DOUBLE_BUFFER_CONTROL__CRTC_BLANK_DATA_DOUBLE_BUFFER_EN, "blanking to be taken at a frame's start")
    _ = b.put(at + scanout.CRTC_BLANK_CONTROL, CRTC_BLANK_CONTROL__CRTC_BLANK_DATA_EN, CRTC_BLANK_CONTROL__CRTC_BLANK_DATA_EN, "the controller's picture blanked")
    b.wait(at + scanout.CRTC_BLANK_CONTROL, state, state, "until it is blank")
}

// The picture shown again: dce110_tg_set_blank(false), as program_surface_
// visibility does at the end of dce110_apply_ctx_for_surface; then until a
// frame has begun with it.
fn unblank(b: *Builder, at: usize) -> void {
    _ = b.put(at + CRTC_DOUBLE_BUFFER_CONTROL, CRTC_DOUBLE_BUFFER_CONTROL__CRTC_BLANK_DATA_DOUBLE_BUFFER_EN, CRTC_DOUBLE_BUFFER_CONTROL__CRTC_BLANK_DATA_DOUBLE_BUFFER_EN, "blanking to be taken at a frame's start")
    _ = b.put(at + scanout.CRTC_BLANK_CONTROL, 0, CRTC_BLANK_CONTROL__CRTC_BLANK_DATA_EN, "the controller's picture shown")
    b.wait(at + scanout.CRTC_BLANK_CONTROL, CRTC_BLANK_CONTROL__CRTC_CURRENT_BLANK_STATE, 0, "until it is shown")
}

// The buffers a controller's rows are read from memory through, by the
// rows' length, and the wait for them: dce_v11_0_line_buffer_adjust
// (amdgpu/dce_v11_0.c: two below 2560 pixels, four from there on a card
// that is no APU's; the display core's dce_mi_allocate_dmif writes the
// word the same way, and not at all when the number is there already).
fn buffers(b: *Builder, index: usize, width: usize) -> void {
    const register = scanout.PIPE0_DMIF_BUFFER_CONTROL + index
    const wanted: usize = if width < 2560 { 2 } else { 4 }
    if b.now(register) & PIPE0_DMIF_BUFFER_CONTROL__DMIF_BUFFERS_ALLOCATED == wanted { return }
    _ = b.update(register, PIPE0_DMIF_BUFFER_CONTROL__DMIF_BUFFERS_ALLOCATED, wanted, "the buffers the rows are read through")
    b.wait(register, PIPE0_DMIF_BUFFER_CONTROL__DMIF_BUFFERS_ALLOCATION_COMPLETED, PIPE0_DMIF_BUFFER_CONTROL__DMIF_BUFFERS_ALLOCATION_COMPLETED, "until they are given")
}

// The scaler off and the whole of a surface of `width` by `height` shown:
// dce_transform_set_scaler (dce_transform.c) for a picture that is not
// scaled, in its order: all of the line buffer's memory (as the firmware's
// word but for LB_MEMORY_CONFIG, the way dce_v11_0_line_buffer_adjust sets
// it), no sharpening, program_overscan with no borders, setup_scaling_
// configuration's bypass (SCL_BYPASS_CONTROL 0, SCL_MODE and its prescaler
// bit 0), program_viewport.
fn scalerOff(b: *Builder, at: usize, width: usize, height: usize) -> void {
    const sharp = SCL_F_SHARP_CONTROL__SCL_HF_SHARP_SCALE_FACTOR | SCL_F_SHARP_CONTROL__SCL_HF_SHARP_EN | SCL_F_SHARP_CONTROL__SCL_VF_SHARP_SCALE_FACTOR | SCL_F_SHARP_CONTROL__SCL_VF_SHARP_EN
    _ = b.update(at + scanout.LB_MEMORY_CTRL, LB_MEMORY_CTRL__LB_MEMORY_CONFIG, 0, "all of the line buffer's memory")
    _ = b.put(at + SCL_F_SHARP_CONTROL, 0, sharp, "no sharpening")
    _ = b.put(at + scanout.EXT_OVERSCAN_LEFT_RIGHT, 0, EXT_OVERSCAN_LEFT_RIGHT__EXT_OVERSCAN_LEFT | EXT_OVERSCAN_LEFT_RIGHT__EXT_OVERSCAN_RIGHT, "no borders left and right")
    _ = b.put(at + scanout.EXT_OVERSCAN_TOP_BOTTOM, 0, EXT_OVERSCAN_TOP_BOTTOM__EXT_OVERSCAN_TOP | EXT_OVERSCAN_TOP_BOTTOM__EXT_OVERSCAN_BOTTOM, "no borders above and below")
    _ = b.put(at + scanout.SCL_BYPASS_CONTROL, 0, SCL_BYPASS_CONTROL__SCL_BYPASS_MODE, "the scaler's bypass word")
    _ = b.update(at + scanout.SCL_MODE, SCL_MODE__SCL_MODE | SCL_MODE__SCL_PSCL_EN, 0, "the scaler off, its prescaler too")
    _ = b.put(at + scanout.VIEWPORT_START, 0, VIEWPORT_START__VIEWPORT_X_START | VIEWPORT_START__VIEWPORT_Y_START, "the viewport from the surface's corner")
    _ = b.put(at + scanout.VIEWPORT_SIZE, (width << 16) | height, VIEWPORT_SIZE__VIEWPORT_WIDTH | VIEWPORT_SIZE__VIEWPORT_HEIGHT, "the viewport's size")
}

// The surface: its extent and rows, then its address, all of it between
// GRPH_UPDATE's lock taken and let go so that the controller takes them
// at one frame's start, and the wait until it has. The extent as
// dce_mi_program_surface_config writes it (dce_mem_input.c: GRPH_ENABLE,
// program_size_and_rotation), with the offsets and LB_DESKTOP_HEIGHT that
// dce_v11_0_crtc_do_set_base sets beside them; the address as
// dce_mi_program_surface_flip_and_addr does (the lock, the update at a
// frame's start, "high register MUST be programmed first", the lock let
// go), with the secondary address beside the primary as do_set_base
// writes both. (The display core takes the lock around the address alone:
// here the extent is inside it too, to be taken with the address.)
fn surface(b: *Builder, at: usize, p: *const scanout.Plan) -> void {
    const high = p.*.address >> 32
    const low = p.*.address & GRPH_PRIMARY_SURFACE_ADDRESS__GRPH_PRIMARY_SURFACE_ADDRESS
    const held = b.update(at + GRPH_UPDATE, GRPH_UPDATE__GRPH_UPDATE_LOCK, GRPH_UPDATE__GRPH_UPDATE_LOCK, "the surface's words held")
    held.*.transient = true
    _ = b.update(at + scanout.GRPH_ENABLE, GRPH_ENABLE__GRPH_ENABLE, 1, "the surface on")
    _ = b.put(at + GRPH_SURFACE_OFFSET_X, 0, GRPH_SURFACE_OFFSET_X__GRPH_SURFACE_OFFSET_X, "no offset across")
    _ = b.put(at + GRPH_SURFACE_OFFSET_Y, 0, GRPH_SURFACE_OFFSET_Y__GRPH_SURFACE_OFFSET_Y, "no offset down")
    _ = b.put(at + scanout.GRPH_X_START, 0, GRPH_X_START__GRPH_X_START, "the surface's first column")
    _ = b.put(at + scanout.GRPH_Y_START, 0, GRPH_Y_START__GRPH_Y_START, "its first row")
    _ = b.put(at + scanout.GRPH_X_END, p.*.width, GRPH_X_END__GRPH_X_END, "its width")
    _ = b.put(at + scanout.GRPH_Y_END, p.*.height, GRPH_Y_END__GRPH_Y_END, "its height")
    _ = b.put(at + scanout.GRPH_PITCH, p.*.pitch, GRPH_PITCH__GRPH_PITCH, "the pixels from row to row")
    _ = b.put(at + LB_DESKTOP_HEIGHT, p.*.height, LB_DESKTOP_HEIGHT__DESKTOP_HEIGHT, "the line buffer's count of rows")
    _ = b.update(at + GRPH_FLIP_CONTROL, GRPH_FLIP_CONTROL__GRPH_SURFACE_UPDATE_H_RETRACE_EN, 0, "the surface taken at a frame's start")
    _ = b.put(at + scanout.GRPH_PRIMARY_SURFACE_ADDRESS_HIGH, high, GRPH_PRIMARY_SURFACE_ADDRESS_HIGH__GRPH_PRIMARY_SURFACE_ADDRESS_HIGH, "the surface's address, upper part")
    _ = b.put(at + GRPH_SECONDARY_SURFACE_ADDRESS_HIGH, high, GRPH_SECONDARY_SURFACE_ADDRESS_HIGH__GRPH_SECONDARY_SURFACE_ADDRESS_HIGH, "the second address, upper part")
    _ = b.put(at + scanout.GRPH_PRIMARY_SURFACE_ADDRESS, low, GRPH_PRIMARY_SURFACE_ADDRESS__GRPH_PRIMARY_SURFACE_ADDRESS, "the surface's address")
    _ = b.put(at + GRPH_SECONDARY_SURFACE_ADDRESS, low, GRPH_SECONDARY_SURFACE_ADDRESS__GRPH_SECONDARY_SURFACE_ADDRESS, "the second address")
    const let = b.update(at + GRPH_UPDATE, GRPH_UPDATE__GRPH_UPDATE_LOCK, 0, "the surface's words let go")
    let.*.transient = true
    b.wait(at + GRPH_UPDATE, GRPH_UPDATE__GRPH_SURFACE_UPDATE_PENDING, 0, "until the controller has taken them")
}

// A DisplayPort stream stopped: dce110_blank_stream (dce110_hw_sequencer.c)
// -> dce110_stream_encoder_dp_blank (dce_stream_encoder.c): the stop put
// off to the next frame's end (DP_VID_STREAM_DIS_DEFER 2), the stream
// disabled, the wait for DP_VID_STREAM_STATUS, and only then the encoder
// taken off the controller's timing (DP_STEER_FIFO_RESET: "must be done
// after the polling"); and the 60 ms a monitor is given to see it. The
// link itself stays up, sending its idle pattern.
fn streamOff(b: *Builder, front: usize) -> void {
    _ = b.update(front + scanout.DP_VID_STREAM_CNTL, DP_VID_STREAM_CNTL__DP_VID_STREAM_DIS_DEFER, 2 << 8, "the stream to stop at a frame's end")
    _ = b.update(front + scanout.DP_VID_STREAM_CNTL, DP_VID_STREAM_CNTL__DP_VID_STREAM_ENABLE, 0, "the stream stopped")
    b.wait(front + scanout.DP_VID_STREAM_CNTL, DP_VID_STREAM_CNTL__DP_VID_STREAM_STATUS, 0, "until it has stopped")
    _ = b.update(front + DP_STEER_FIFO, DP_STEER_FIFO__DP_STEER_FIFO_RESET, 1, "the encoder off the controller's timing")
    b.pause(STREAM_GONE, "the monitor sees the stream gone")
}

// The stream started again with M for the new pixel clock:
// dce110_unblank_stream -> dce110_stream_encoder_dp_unblank: the M and N
// generator held, N 0x8000 and M (N times the pixel clock over the link's
// symbol clock) as its first values, the generator on, DIG_START to bring
// the encoder's FIFO in step, the encoder on the controller's timing
// again, 100 us, the stream enabled; then until it runs.
fn streamOn(b: *Builder, front: usize, m: usize) -> void {
    const held = b.update(front + scanout.DP_VID_TIMING, DP_VID_TIMING__DP_VID_M_N_GEN_EN, 0, "M and N held")
    held.*.transient = true
    _ = b.update(front + scanout.DP_VID_N, DP_VID_N__DP_VID_N, VID_N, "N")
    _ = b.update(front + scanout.DP_VID_M, DP_VID_M__DP_VID_M, m, "M for the new pixel clock")
    _ = b.update(front + scanout.DP_VID_TIMING, DP_VID_TIMING__DP_VID_M_N_GEN_EN, DP_VID_TIMING__DP_VID_M_N_GEN_EN, "M and N measured from there")
    // (Linux only ever writes this bit as 1, each time the FIFO is to be
    // brought in step: it may clear itself, so what is read back is not
    // held against what was written. And it is written as 1 on the way
    // back too, not with what the firmware's word read: the FIFO has to
    // come in step with the timing that was put back.)
    const started = b.update(front + scanout.DIG_FE_CNTL, DIG_FE_CNTL__DIG_START, DIG_FE_CNTL__DIG_START, "the encoder's FIFO in step")
    started.*.mask = 0
    started.*.transient = true
    _ = b.update(front + DP_STEER_FIFO, DP_STEER_FIFO__DP_STEER_FIFO_RESET, 0, "the encoder on the controller's timing")
    b.pause(ENCODER_PRIMED, "the encoder takes a few lines")
    _ = b.update(front + scanout.DP_VID_STREAM_CNTL, DP_VID_STREAM_CNTL__DP_VID_STREAM_ENABLE, 1, "the stream started")
    b.wait(front + scanout.DP_VID_STREAM_CNTL, DP_VID_STREAM_CNTL__DP_VID_STREAM_STATUS, DP_VID_STREAM_CNTL__DP_VID_STREAM_STATUS, "until it runs")
}

// The controller's timing. The totals and the blankings as
// dce110_timing_generator_program_blanking writes them (the totals less
// one, with CRTC_V_TOTAL_MAX and _MIN the same; the counters begin with
// the sync pulse: a blanking ends after the pulse and the back porch, and
// starts the size shown later), a vertical front porch of one line at
// least (apply_front_porch_workaround). The sync pulse (from the counter's
// 0 to its length, CRTC_x_SYNC_A; CRTC_x_SYNC_A_CNTL's bit set for a low
// pulse: "0 for positive, 1 for negative", enable_reset_trigger) is what
// Linux leaves to the firmware's table (program_timing_generator ->
// bp->funcs->program_crtc_timing): written here by what the blankings'
// own arithmetic and the read-out of the firmware's timing say. Then, as
// program_timing_generator goes on: no pixel counted twice
// (program_horz_count_by_2) and when the rows are asked for
// (enable_advanced_request: the start line 3 lines early without
// prefetch when pulse and front porch are 3 lines or fewer, else 4 with).
fn timing(b: *Builder, at: usize, t: *const edid.Timing) -> void {
    const vFront = if t.*.vFront == 0 { 1 } else { t.*.vFront }
    const hBlankEnd = t.*.hTotal - t.*.width - t.*.hFront
    const vBlankEnd = t.*.vTotal - t.*.height - vFront
    _ = b.update(at + scanout.CRTC_H_TOTAL, CRTC_H_TOTAL__CRTC_H_TOTAL, t.*.hTotal - 1, "the timing: pixels in a line, less one")
    _ = b.update(at + scanout.CRTC_V_TOTAL, CRTC_V_TOTAL__CRTC_V_TOTAL, t.*.vTotal - 1, "lines in a frame, less one")
    _ = b.update(at + CRTC_V_TOTAL_MAX, CRTC_V_TOTAL_MAX__CRTC_V_TOTAL_MAX, t.*.vTotal - 1, "the most lines a frame may have")
    _ = b.update(at + CRTC_V_TOTAL_MIN, CRTC_V_TOTAL_MIN__CRTC_V_TOTAL_MIN, t.*.vTotal - 1, "the fewest")
    _ = b.update(at + scanout.CRTC_H_BLANK_START_END, CRTC_H_BLANK_START_END__CRTC_H_BLANK_START | CRTC_H_BLANK_START_END__CRTC_H_BLANK_END, (hBlankEnd << 16) | (hBlankEnd + t.*.width), "where a line's blanking starts and ends")
    _ = b.update(at + scanout.CRTC_V_BLANK_START_END, CRTC_V_BLANK_START_END__CRTC_V_BLANK_START | CRTC_V_BLANK_START_END__CRTC_V_BLANK_END, (vBlankEnd << 16) | (vBlankEnd + t.*.height), "where a frame's blanking starts and ends")
    _ = b.update(at + scanout.CRTC_H_SYNC_A, CRTC_H_SYNC_A__CRTC_H_SYNC_A_START | CRTC_H_SYNC_A__CRTC_H_SYNC_A_END, t.*.hSync << 16, "a line's sync pulse")
    _ = b.update(at + scanout.CRTC_H_SYNC_A_CNTL, CRTC_H_SYNC_A_CNTL__CRTC_H_SYNC_A_POL, if t.*.hPositive { 0 } else { 1 }, "whether it is the low one")
    _ = b.update(at + scanout.CRTC_V_SYNC_A, CRTC_V_SYNC_A__CRTC_V_SYNC_A_START | CRTC_V_SYNC_A__CRTC_V_SYNC_A_END, t.*.vSync << 16, "a frame's sync pulse")
    _ = b.update(at + scanout.CRTC_V_SYNC_A_CNTL, CRTC_V_SYNC_A_CNTL__CRTC_V_SYNC_A_POL, if t.*.vPositive { 0 } else { 1 }, "whether it is the low one")
    _ = b.update(at + CRTC_COUNT_CONTROL, CRTC_COUNT_CONTROL__CRTC_HORZ_COUNT_BY2_EN, 0, "no pixel counted twice")
    const short = t.*.vSync + vFront <= 3
    const early = CRTC_START_LINE_CONTROL__CRTC_PROGRESSIVE_START_LINE_EARLY | CRTC_START_LINE_CONTROL__CRTC_INTERLACE_START_LINE_EARLY
    const line = if short { (3 << 12) | early } else { (4 << 12) | CRTC_START_LINE_CONTROL__CRTC_PREFETCH_EN | early }
    _ = b.update(at + CRTC_START_LINE_CONTROL, CRTC_START_LINE_CONTROL__CRTC_ADVANCED_START_LINE_POSITION | CRTC_START_LINE_CONTROL__CRTC_LEGACY_REQUESTOR_EN | CRTC_START_LINE_CONTROL__CRTC_PREFETCH_EN | early, line, "when the rows are asked for")
}

// The firmware's link, from the stream's words: the lanes (the read-out's),
// the symbol clock from M and N (M over N is the pixel clock over the
// symbol clock, dp_unblank; the PHY's own words for the rate are not in
// the headers by a name that could be trusted), taken as the standard rate
// it is within a fiftieth of; the bits a pixel from DP_PIXEL_FORMAT's
// DP_COMPONENT_DEPTH (0: six bits a colour, 1: eight, 2: ten, 3: twelve,
// 4: sixteen; dce_11_2_enum.h).
fn linkOf(card: *const scanout.Card, c: *const scanout.Controller, clock: usize) -> Link {
    const front = scanout.DIG[c.*.encoder.frontEnd]
    var link = Link.{ .lanes = c.*.encoder.lanes, .clock = 0, .m = card.reg(front + scanout.DP_VID_M) & DP_VID_M__DP_VID_M, .n = card.reg(front + scanout.DP_VID_N) & DP_VID_N__DP_VID_N, .bits = 0, .room = 0 }
    const depth = (card.reg(front + scanout.DP_PIXEL_FORMAT) & DP_PIXEL_FORMAT__DP_COMPONENT_DEPTH) >> 24
    link.bits = if depth == 0 { 18 } else if depth == 1 { 24 } else if depth == 2 { 30 } else if depth == 3 { 36 } else if depth == 4 { 48 } else { 0 }
    if link.m == 0 || link.n == 0 || clock == 0 { return link }
    const symbols = clock * link.n / link.m
    for standard in LINK_CLOCKS {
        if near(symbols, standard, 50) { link.clock = standard }
    }
    if link.clock != 0 && link.bits != 0 { link.room = link.lanes * link.clock * 8 / link.bits }
    return link
}

// The plan for what `readout` holds and the monitor `monitor` (its own
// timing, or none), put into `plan`: the situation, whether it is
// complete, and the steps. `memory` is what the kernel knows of the
// aperture and the firmware's picture (as for the read-out).
pub fn make(card: *const scanout.Card, readout: *const scanout.Readout, memory: *const scanout.Memory, monitor: *const edid.Monitor, plan: *Plan) -> void {
    plan.*.situation = Situation.none
    plan.*.missing = Missing.nothing
    plan.*.complete = false
    plan.*.controller = 0
    plan.*.width = 0
    plan.*.height = 0
    plan.*.pitch = 0
    plan.*.offset = 0
    plan.*.bytes = 0
    plan.*.address = 0
    plan.*.timing = monitor.*.timing
    plan.*.clockNow = 0
    plan.*.clockMeasured = false
    plan.*.phaseNow = 0
    plan.*.phase = 0
    plan.*.link = Link.{ .lanes = 0, .clock = 0, .m = 0, .n = 0, .bits = 0, .room = 0 }
    plan.*.millihertz = 0
    plan.*.hTotal = 0
    plan.*.vTotal = 0
    plan.*.count = 0
    plan.*.writes = 0
    const known = monitor.*.state == edid.State.found

    if !readout.*.plausible {
        plan.*.missing = Missing.not_plausible
        return
    }
    if memory.*.pictureWidth == 0 {
        plan.*.missing = Missing.elsewhere
        return
    }
    if readout.*.on == 0 {
        plan.*.missing = Missing.no_controller
        return
    }
    if readout.*.on > 1 {
        plan.*.missing = Missing.several
        return
    }
    var index: usize = 0
    while index < scanout.CONTROLLERS && !readout.*.controllers[index].on { index += 1 }
    const c = &readout.*.controllers[index]
    const at = scanout.OFFSETS[index]
    plan.*.controller = index
    if c.*.interlaced {
        plan.*.missing = Missing.interlaced
        return
    }

    // Which situation: the monitor's own size when it is known, else the
    // size the controller's timing has.
    const shows = readout.*.shows[index]
    const width = if known { monitor.*.width } else { c.*.width }
    const height = if known { monitor.*.height } else { c.*.height }
    const sameTiming = c.*.width == width && c.*.height == height
    if !sameTiming {
        plan.*.situation = if !c.*.encoder.found || scanout.isDisplayPort(c.*.encoder.mode) { Situation.displayport } else { Situation.tmds }
    } else if shows == scanout.Shows.as_it_is {
        plan.*.missing = if known { Missing.already } else { Missing.no_monitor }
        return
    } else {
        plan.*.situation = Situation.scaled
    }

    // Where the new picture goes.
    const place = scanout.planFor(c, memory, readout.*.base, width, height)
    plan.*.width = place.width
    plan.*.height = place.height
    plan.*.pitch = place.pitch
    plan.*.offset = place.offset
    plan.*.bytes = place.bytes
    plan.*.address = place.address
    if !place.fits {
        plan.*.missing = Missing.no_room
        return
    }
    if width > 0x3FFF || height > 0x3FFF || place.pitch > 0x7FFF {
        plan.*.missing = Missing.too_large
        return
    }

    var b = Builder.{ .card = card, .plan = plan, .phase = Phase.change }
    const marks = card.reg(at + DPG_WATERMARK_MASK_CONTROL)

    if plan.*.situation == Situation.scaled {
        // (a). What is held against the frame counter afterwards is what
        // it counted before: without that there is nothing to hold.
        if c.*.rate.frames == 0 {
            plan.*.missing = Missing.no_frames
            return
        }
        plan.*.millihertz = c.*.rate.millihertz
        plan.*.hTotal = c.*.hTotal
        plan.*.vTotal = c.*.vTotal
        safeMarks(&b, at)
        b.phase = Phase.quiet
        blank(&b, at)
        b.phase = Phase.change
        buffers(&b, index, width)
        scalerOff(&b, at, width, height)
        surface(&b, at, &place)
        b.phase = Phase.wake
        unblank(&b, at)
        marksChosen(&b, at, marks)
        plan.*.complete = plan.*.count <= STEPS
        return
    }

    // (b). What has to be there for the timing to be set by registers
    // alone.
    if !c.*.encoder.found {
        plan.*.missing = Missing.no_encoder
        return
    }
    if plan.*.situation == Situation.tmds {
        plan.*.missing = Missing.tmds
        return
    }
    if c.*.encoder.mode == scanout.MODE_DISPLAYPORT_MST {
        plan.*.missing = Missing.several_streams
        return
    }
    if !c.*.encoder.trained || !c.*.encoder.stream {
        plan.*.missing = Missing.not_trained
        return
    }
    if !c.*.dto || c.*.dtoPhase == 0 || c.*.dtoModulo == 0 {
        plan.*.missing = Missing.no_dto
        return
    }
    // The pixel clock now. Linux and the card's firmware agree that the
    // DTO's modulo is the reference clock in Hz, so that the phase is the
    // pixel clock in Hz (dce_clock_source.c, get_pixel_clk_frequency_
    // 100hz; dcn31_program_pix_clk writes "phase = target clock, modulo =
    // reference clock"): taken so when the measured clock says the same
    // within a hundredth, and the new phase is then the new clock in Hz.
    // When it does not, the phase is brought to the new clock by the
    // measured one; with nothing measured the clock is not known.
    const t = &monitor.*.timing
    plan.*.phaseNow = c.*.dtoPhase
    const measured = c.*.rate.frames != 0 && c.*.rate.kilohertz != 0
    if measured && near(c.*.dtoPhase / 1000, c.*.rate.kilohertz, 100) {
        plan.*.clockNow = c.*.dtoPhase / 1000
        plan.*.phase = t.*.clock * 1000
    } else if measured {
        plan.*.clockNow = c.*.rate.kilohertz
        plan.*.clockMeasured = true
        plan.*.phase = c.*.dtoPhase * t.*.clock / c.*.rate.kilohertz
    } else {
        plan.*.missing = Missing.no_clock
        return
    }
    if plan.*.phase == 0 || plan.*.phase > DP_DTO0_PHASE__DP_DTO0_PHASE || plan.*.phase >= c.*.dtoModulo {
        plan.*.missing = Missing.no_clock
        return
    }
    plan.*.link = linkOf(card, c, plan.*.clockNow)
    if plan.*.link.clock == 0 || plan.*.link.room == 0 {
        plan.*.missing = Missing.no_link_rate
        return
    }
    if t.*.clock > plan.*.link.room {
        plan.*.missing = Missing.link_too_slow
        return
    }
    // The firmware's own sync pulses begin its counters: what the planned
    // timing's words rest on.
    if c.*.hSyncStart != 0 || c.*.vSyncStart != 0 {
        plan.*.missing = Missing.sync_elsewhere
        return
    }
    if t.*.hTotal > 0x4000 || t.*.vTotal > 0x4000 {
        plan.*.missing = Missing.too_large
        return
    }
    plan.*.millihertz = t.millihertz()
    plan.*.hTotal = t.*.hTotal
    plan.*.vTotal = t.*.vTotal
    const front = scanout.DIG[c.*.encoder.frontEnd]
    const lanes = plan.*.link.lanes
    // DisplayPort's early blanking: the size shown over the lanes' count,
    // what is left, or the lanes' count when nothing is (dce110_enable_
    // stream: "enable early control to avoid corruption on DP monitor").
    const early = if lanes != 0 && t.*.width % lanes != 0 { t.*.width % lanes } else { lanes }

    safeMarks(&b, at)
    b.phase = Phase.quiet
    streamOff(&b, front)
    blank(&b, at)
    b.phase = Phase.change
    // The pixel clock: the DTO's phase for the new clock, its modulo as it
    // is. (Linux hands the clock to the firmware's SetPixelClock table on
    // this controller, dce112_program_pix_clk; that the table writes these
    // two words is what get_pixel_clk_frequency_100hz reads back.)
    _ = b.put(scanout.DP_DTO0_PHASE + index * 4, plan.*.phase, DP_DTO0_PHASE__DP_DTO0_PHASE, "the pixel clock: the DTO's phase")
    timing(&b, at, t)
    _ = b.update(at + scanout.CRTC_CONTROL, CRTC_CONTROL__CRTC_HBLANK_EARLY_CONTROL, early << 20, "DisplayPort's early blanking")
    b.phase = Phase.wake
    streamOn(&b, front, VID_N * t.*.clock / plan.*.link.clock)
    b.phase = Phase.change
    // A pixel's duration for the memory interface (dce_mi_allocate_dmif:
    // 10^9 over the clock in kHz).
    _ = b.update(at + DPG_PIPE_ARBITRATION_CONTROL1, DPG_PIPE_ARBITRATION_CONTROL1__PIXEL_DURATION, 1000000000 / t.*.clock, "a pixel's duration")
    buffers(&b, index, width)
    scalerOff(&b, at, width, height)
    surface(&b, at, &place)
    b.phase = Phase.wake
    unblank(&b, at)
    marksChosen(&b, at, marks)
    plan.*.complete = plan.*.count <= STEPS
}

fn missingText(missing: Missing) -> []const u8 {
    if missing == Missing.not_plausible { return "the read-out is not plausible" }
    if missing == Missing.elsewhere { return "the picture the kernel draws on is not this card's" }
    if missing == Missing.no_controller { return "no controller is on" }
    if missing == Missing.several { return "more than one controller is on: one monitor only for now" }
    if missing == Missing.interlaced { return "the controller runs an interlaced timing" }
    if missing == Missing.no_monitor { return "the card sends the picture as it is and the monitor's own timing is not known" }
    if missing == Missing.already { return "the controller shows the monitor's own mode as it is" }
    if missing == Missing.no_room { return "the picture does not fit the aperture" }
    if missing == Missing.no_frames { return "no frames were counted: there is nothing to hold a change against" }
    if missing == Missing.no_encoder { return "the encoder the picture goes out by was not found" }
    if missing == Missing.tmds { return "HDMI: the TMDS clock's PLL must be set, not there yet" }
    if missing == Missing.several_streams { return "the link carries several streams: not there yet" }
    if missing == Missing.not_trained { return "the link is not trained or its stream is off: it must be trained, not there yet" }
    if missing == Missing.no_dto { return "the pixel clock is not made by the DTO: not there yet" }
    if missing == Missing.no_clock { return "the pixel clock is not known (no frames counted, or a phase that cannot be)" }
    if missing == Missing.no_link_rate { return "the link's rate is not known from M and N" }
    if missing == Missing.link_too_slow { return "the link is too slow: it must be trained again, not there yet" }
    if missing == Missing.sync_elsewhere { return "the firmware's sync pulses do not begin the controller's counters: the timing's words would be guesses" }
    if missing == Missing.too_large { return "the size is more than the controller's words hold" }
    return "nothing"
}

// "2.70": a symbol clock in kHz as the lanes' bit rate in Gbit/s.
fn sayRate(card: *const scanout.Card, clock: usize) -> void {
    const hundredths = clock / 1000 % 100
    card.field("", clock / 100000)
    card.field(if hundredths < 10 { ".0" } else { "." }, hundredths)
}

// The plan said in the log: what the situation is, for (b) what the link
// has room for, how much would be written or what is missing.
pub fn say(card: *const scanout.Card, plan: *const Plan) -> void {
    if plan.*.situation == Situation.none {
        card.say("gpu: plan: nothing to set (")
        card.say(missingText(plan.*.missing))
        card.say(")\n")
        return
    }
    if plan.*.situation == Situation.scaled {
        card.say("gpu: plan (a): the controller runs this timing already; ")
    } else {
        const link = &plan.*.link
        if link.*.room != 0 {
            card.field("gpu: plan (b, DisplayPort): the link has ", link.*.lanes)
            card.say(if link.*.lanes == 1 { " lane at " } else { " lanes at " })
            sayRate(card, link.*.clock)
            card.fieldHex(" Gbit/s (by M ", link.*.m)
            card.fieldHex(" over N ", link.*.n)
            card.field("), room for ", link.*.room)
            card.field(" kHz at ", link.*.bits)
            card.field(" bits: ", plan.*.timing.clock)
            card.say(if plan.*.timing.clock <= link.*.room { " kHz fits\n" } else { " kHz does not fit\n" })
        } else if plan.*.situation == Situation.displayport && link.*.m != 0 {
            card.fieldHex("gpu: plan (b, DisplayPort): M ", link.*.m)
            card.fieldHex(" and N ", link.*.n)
            card.field(" with a pixel clock of ", plan.*.clockNow)
            card.say(" kHz give no rate a link has\n")
        }
        card.say(if plan.*.situation == Situation.tmds { "gpu: plan (b): " } else { "gpu: plan (b, DisplayPort): " })
    }
    if !plan.*.complete {
        card.say("nothing would be set: ")
        card.say(missingText(plan.*.missing))
        card.say("\n")
        return
    }
    if plan.*.situation == Situation.displayport {
        card.field("the pixel clock from ", plan.*.clockNow)
        card.field(" to ", plan.*.timing.clock)
        card.field(" kHz (the DTO's phase from ", plan.*.phaseNow)
        card.field(" to ", plan.*.phase)
        card.say(if plan.*.clockMeasured { ", by the measured clock), " } else { "), " })
        card.say("the timing, the stream stopped and started, ")
    }
    card.size("a picture of ", plan.*.width, plan.*.height)
    card.fieldHex(" at ", plan.*.offset)
    card.field(" of the aperture, the scaler off: ", plan.*.writes)
    card.say(" writes would do it\n")
}

// Every step, for the log alone: "gpu: would write 1b9d = 00000100 (the
// controller's picture blanked)", "gpu: would wait for 1b9d & 00000101 =
// 00000101 (until it is blank)", "gpu: would wait 60000 us (...)".
pub fn list(card: *const scanout.Card, plan: *const Plan) -> void {
    if !plan.*.complete { return }
    var k: usize = 0
    while k < plan.*.count {
        const step = &plan.*.steps[k]
        sayStep(card, step, "gpu: would ")
        card.say("\n")
        k += 1
    }
}

// One step in words after `before`: "write 1b9d = 00000100 (...)".
pub fn sayStep(card: *const scanout.Card, step: *const Step, before: []const u8) -> void {
    card.say(before)
    if step.*.kind == Kind.write {
        card.say("write ")
        card.hexDigits(step.*.register, 4)
        card.say(" = ")
        card.hexDigits(step.*.value, 8)
    } else if step.*.kind == Kind.wait {
        card.say("wait for ")
        card.hexDigits(step.*.register, 4)
        card.say(" & ")
        card.hexDigits(step.*.mask, 8)
        card.say(" = ")
        card.hexDigits(step.*.value, 8)
    } else {
        card.field("wait ", step.*.time / 1000)
        card.say(" us")
    }
    card.say(" (")
    card.say(step.*.name)
    card.say(")")
}
