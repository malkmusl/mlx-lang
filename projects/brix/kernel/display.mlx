// The display: a linear framebuffer, found as the EFI loader left it
// (GOP's: the boot info's FB_* fields) or, under a Multiboot loader
// (QEMU's -kernel), set up on the Bochs VBE adapter (QEMU's -vga std:
// PCI 1234:1111, its linear framebuffer at BAR0, its mode through the
// DISPI index and data ports). The pixels are 32 bits, blue first
// (BGRX). /devices/framebuffer gives programs its geometry (a read) and
// its pixels (node_map); the kernel itself writes nothing on it: the
// console on it is a program (mlx-console).
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const Pci = @import("./pci.mlx").Pci

const Port = cpu.Port

pub const Display = struct {
    pub const FORMAT_NONE: usize = 0
    pub const FORMAT_BGRX: usize = 1
    pub const FORMAT_RGBX: usize = 2

    // The Bochs adapter and its DISPI registers.
    const VENDOR: usize = 0x1234
    const DEVICE: usize = 0x1111
    const INDEX: usize = 0x1CE
    const DATA: usize = 0x1CF
    const ID: usize = 0
    const XRES: usize = 1
    const YRES: usize = 2
    const BPP: usize = 3
    const ENABLE: usize = 4
    const VIRT_WIDTH: usize = 6
    const ENABLED_LFB: usize = 0x41
    const WIDTH: usize = 1024
    const HEIGHT: usize = 768
    const MEMORY_SPACE: usize = 2

    // The framebuffer's physical address, its size in pixels, the bytes
    // from one row to the next, the pixel format; whether there is one.
    address: usize
    width: usize
    height: usize
    pitch: usize
    format: usize
    present: bool
    firmware: bool
    // The shape of the screen the picture is shown on, as a width and a
    // height (a picture that large has square pixels on it): the
    // monitor's own mode when it says one, else the mode the loader
    // looked for, else the picture's own size. Where the picture is of
    // another shape the monitor stretches it, and a program that wants a
    // circle round on the screen draws for this shape.
    shapeWidth: usize
    shapeHeight: usize

    // The bytes of the geometry a program reads (describe).
    pub const RECORD: usize = 48

    fn dispi(index: usize, value: usize) -> void {
        Port.out16(INDEX, index)
        Port.out16(DATA, value)
    }

    fn dispiRead(index: usize) -> usize {
        Port.out16(INDEX, index)
        return Port.in16(DATA)
    }

    // The display from the boot info (the EFI loader's GOP), else the
    // Bochs adapter in a mode of its own; false when there is none.
    pub fn init(self: *Self) -> bool {
        self.*.present = false
        self.*.firmware = false
        const given = cpu.BootInfo.get(layout.Info.FB_ADDRESS)
        if given != 0 {
            self.*.address = given
            self.*.width = cpu.BootInfo.get(layout.Info.FB_WIDTH)
            self.*.height = cpu.BootInfo.get(layout.Info.FB_HEIGHT)
            self.*.pitch = cpu.BootInfo.get(layout.Info.FB_PITCH)
            self.*.format = cpu.BootInfo.get(layout.Info.FB_FORMAT)
            self.*.present = self.*.width > 0 && self.*.height > 0 && self.*.pitch > 0
            self.*.firmware = self.*.present
            self.*.shapeWidth = self.*.width
            self.*.shapeHeight = self.*.height
            if !shaped(self, cpu.BootInfo.get(layout.Info.MONITOR_WIDTH), cpu.BootInfo.get(layout.Info.MONITOR_HEIGHT)) {
                _ = shaped(self, cpu.BootInfo.get(layout.Info.WANTED_WIDTH), cpu.BootInfo.get(layout.Info.WANTED_HEIGHT))
            }
            return self.*.present
        }
        const pci = Pci.find(VENDOR, DEVICE)
        if pci == Pci.NONE { return false }
        const bar = Pci.read(pci, Pci.BAR0)
        if bar & 1 != 0 { return false }
        self.*.address = bar & 0xFFFFFFF0
        if self.*.address == 0 { return false }
        if dispiRead(ID) & 0xFFF0 != 0xB0C0 { return false }
        Pci.write(pci, Pci.COMMAND, (Pci.read(pci, Pci.COMMAND) & 0xFFFF) | MEMORY_SPACE)
        dispi(ENABLE, 0)
        dispi(XRES, WIDTH)
        dispi(YRES, HEIGHT)
        dispi(BPP, 32)
        dispi(VIRT_WIDTH, WIDTH)
        dispi(ENABLE, ENABLED_LFB)
        self.*.width = WIDTH
        self.*.height = HEIGHT
        self.*.pitch = WIDTH * 4
        self.*.format = FORMAT_BGRX
        self.*.shapeWidth = WIDTH
        self.*.shapeHeight = HEIGHT
        self.*.present = true
        return true
    }

    // Takes `wide` by `high` as the screen's shape when it is one (a
    // mode's size, no more than eight times as wide as high or the
    // reverse); false when it is none.
    fn shaped(self: *Self, wide: usize, high: usize) -> bool {
        if wide == 0 || high == 0 || wide > 65535 || high > 65535 || wide > high * 8 || high > wide * 8 { return false }
        self.*.shapeWidth = wide
        self.*.shapeHeight = high
        return true
    }

    // The bytes the framebuffer takes.
    pub fn size(self: *const Self) -> usize { return self.*.pitch * self.*.height }

    // Another picture as the display: the GPU's driver has set the
    // monitor's own mode (gpu.mlx), its pixels at `address`, 32 bits each
    // in the order they had. It is shown as it is: the screen's shape is
    // the picture's own.
    pub fn retake(self: *Self, address: usize, width: usize, height: usize, pitch: usize) -> void {
        self.*.address = address
        self.*.width = width
        self.*.height = height
        self.*.pitch = pitch
        self.*.firmware = false
        self.*.shapeWidth = width
        self.*.shapeHeight = height
    }

    // The geometry as a program reads it from /devices/framebuffer: six
    // words (RECORD bytes), width, height, pitch (bytes), format, and the
    // screen's shape as a width and a height (the picture's own where it
    // is shown as it is).
    pub fn describe(self: *const Self, into: [*]u8) -> void {
        var k: usize = 0
        while k < RECORD / 8 {
            const value = if k == 0 { self.*.width } else if k == 1 { self.*.height } else if k == 2 { self.*.pitch } else if k == 3 { self.*.format } else if k == 4 { self.*.shapeWidth } else { self.*.shapeHeight }
            var b: usize = 0
            while b < 8 {
                into[k * 8 + b] = @intCast(u8, (value >> @intCast(u6, b * 8)) & 0xFF)
                b += 1
            }
            k += 1
        }
    }
}

var display: Display = undefined // (per run)

pub fn screen() -> *Display { return &display }
