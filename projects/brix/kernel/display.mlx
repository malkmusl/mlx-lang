// The displays: linear framebuffers, found as the EFI loader left them
// (the firmware's graphics outputs, GOP's: the boot info's FB_* fields
// for the first and a record for every further one, displays.mlx) or,
// under a Multiboot loader (QEMU's -kernel), one set up on the Bochs VBE
// adapter (QEMU's -vga std: PCI 1234:1111, its linear framebuffer at
// BAR0, its mode through the DISPI index and data ports). The pixels are
// 32 bits, blue first (BGRX) unless the firmware's are red first.
//
// One of them is the main display (displays.mlx has the rule, and an
// image's settings/display may name it): /devices/framebuffer gives
// programs its geometry (a read) and its pixels (node_map), as it did
// when there was one display. The others are /devices/framebuffer1,
// /devices/framebuffer2 and so on, in the same manner. `screen` is the
// main one. The kernel itself writes its console on every one of them
// (fbcon.mlx) until a program maps it.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const Pci = @import("./pci.mlx").Pci
const displays = @import("./displays.mlx")
const archive = @import("./archive.mlx")

const Port = cpu.Port

pub const Display = struct {
    pub const FORMAT_NONE: usize = 0
    pub const FORMAT_BGRX: usize = 1
    pub const FORMAT_RGBX: usize = 2

    // The Bochs adapter and its DISPI registers.
    const VENDOR: usize = 0x1234
    const DEVICE: usize = 0x1111
    const INDEX: usize = 0x1CE
    const DATA: usize = 0x1CF
    const ID: usize = 0
    const XRES: usize = 1
    const YRES: usize = 2
    const BPP: usize = 3
    const ENABLE: usize = 4
    const VIRT_WIDTH: usize = 6
    const ENABLED_LFB: usize = 0x41
    const WIDTH: usize = 1024
    const HEIGHT: usize = 768
    const MEMORY_SPACE: usize = 2

    // The framebuffer's physical address, its size in pixels, the bytes
    // from one row to the next, the pixel format; whether there is one.
    address: usize
    width: usize
    height: usize
    pitch: usize
    format: usize
    present: bool
    firmware: bool
    // The shape of the screen the picture is shown on, as a width and a
    // height (a picture that large has square pixels on it): the
    // monitor's own mode when it says one, else the mode the loader
    // looked for, else the picture's own size. Where the picture is of
    // another shape the monitor stretches it, and a program that wants a
    // circle round on the screen draws for this shape.
    shapeWidth: usize
    shapeHeight: usize
    // Which of the kernel's displays this is (from 0, the loader's
    // order: the log's "display N"), and its node's name in /devices
    // ("framebuffer" for the main one, "framebuffer1" and so on for the
    // others).
    number: usize
    name: [16]u8
    nameLength: usize
    // The PCI adapter whose memory the picture is in (its configuration
    // address, vendor and device; Pci.NONE and zeros when it is no
    // display adapter's memory).
    adapter: usize
    vendor: usize
    device: usize
    // What the loader said of it (displays.Found): the monitor's own
    // mode, the firmware's, whose mode the loader set, a refusal; the
    // monitor's EDID (in the kernel's view; 0 bytes: none); which of the
    // firmware's outputs, and whether it is the firmware's first.
    monitorWidth: usize
    monitorHeight: usize
    firmwareWidth: usize
    firmwareHeight: usize
    modeBy: usize
    refused: usize
    edid: usize
    edidBytes: usize
    output: usize
    first: bool

    // The bytes of the geometry a program reads (describe).
    pub const RECORD: usize = 80

    fn dispi(index: usize, value: usize) -> void {
        Port.out16(INDEX, index)
        Port.out16(DATA, value)
    }

    fn dispiRead(index: usize) -> usize {
        Port.out16(INDEX, index)
        return Port.in16(DATA)
    }

    // The Bochs adapter in a mode of its own (no display came from the
    // loader); false when there is none.
    fn bochs(self: *Self) -> bool {
        const pci = Pci.find(VENDOR, DEVICE)
        if pci == Pci.NONE { return false }
        const bar = Pci.read(pci, Pci.BAR0)
        if bar & 1 != 0 { return false }
        self.*.address = bar & 0xFFFFFFF0
        if self.*.address == 0 { return false }
        if dispiRead(ID) & 0xFFF0 != 0xB0C0 { return false }
        Pci.write(pci, Pci.COMMAND, (Pci.read(pci, Pci.COMMAND) & 0xFFFF) | MEMORY_SPACE)
        dispi(ENABLE, 0)
        dispi(XRES, WIDTH)
        dispi(YRES, HEIGHT)
        dispi(BPP, 32)
        dispi(VIRT_WIDTH, WIDTH)
        dispi(ENABLE, ENABLED_LFB)
        self.*.width = WIDTH
        self.*.height = HEIGHT
        self.*.pitch = WIDTH * 4
        self.*.format = FORMAT_BGRX
        self.*.shapeWidth = WIDTH
        self.*.shapeHeight = HEIGHT
        self.*.present = true
        return true
    }

    // The bytes the framebuffer takes.
    pub fn size(self: *const Self) -> usize { return self.*.pitch * self.*.height }

    // Its node's name in /devices.
    pub fn nodeName(self: *const Self) -> []const u8 {
        const bytes: [*]const u8 = &self.*.name
        return bytes[0..self.*.nameLength]
    }

    // Another picture as this display: the GPU's driver has set the
    // monitor's own mode (gpu.mlx), its pixels at `address`, 32 bits each
    // in the order they had. It is shown as it is: the screen's shape is
    // the picture's own.
    pub fn retake(self: *Self, address: usize, width: usize, height: usize, pitch: usize) -> void {
        self.*.address = address
        self.*.width = width
        self.*.height = height
        self.*.pitch = pitch
        self.*.firmware = false
        self.*.shapeWidth = width
        self.*.shapeHeight = height
    }

    // The geometry as a program reads it from the display's node: ten
    // words (RECORD bytes): width, height, pitch (bytes), format, the
    // screen's shape as a width and a height (the picture's own where it
    // is shown as it is); then the display's number, how many displays
    // there are, and its adapter's PCI vendor and device (0: not known).
    // A program that reads fewer bytes gets the first of them.
    pub fn describe(self: *const Self, into: [*]u8) -> void {
        var k: usize = 0
        while k < RECORD / 8 {
            const value = if k == 0 { self.*.width } else if k == 1 { self.*.height } else if k == 2 { self.*.pitch } else if k == 3 { self.*.format } else if k == 4 { self.*.shapeWidth } else if k == 5 { self.*.shapeHeight } else if k == 6 { self.*.number } else if k == 7 { total } else if k == 8 { self.*.vendor } else { self.*.device }
            var b: usize = 0
            while b < 8 {
                into[k * 8 + b] = @intCast(u8, (value >> @intCast(u6, b * 8)) & 0xFF)
                b += 1
            }
            k += 1
        }
    }
}

// The displays (the loader's order), how many, and which is the main one
// and why (displays.By). With none, the first record is one that is not
// present.
var all: [displays.MAX]Display = undefined // (per run)
var total: usize = 0 // (per run)
var mainAt: usize = 0 // (per run)
var mainBy: usize = 0 // (per run)
var found: displays.List = undefined // (per run)
var wanted: displays.Named = undefined // (per run)
var wantedMissing = false // (per run)

// The main display (one that is not present when there is none).
pub fn screen() -> *Display { return &all[mainAt] }

pub fn count() -> usize { return total }

// Display `number` (below count()).
pub fn at(number: usize) -> *Display { return &all[number] }

// Why the main display is the main one (displays.By), what the image's
// settings/display names (displays.Named), and whether it names a
// display that is not there.
pub fn chosenBy() -> usize { return mainBy }
pub fn named() -> *const displays.Named { return &wanted }
pub fn namedMissing() -> bool { return wantedMissing }

// What the loader said beyond the displays themselves: the firmware's
// graphics outputs in all, those passed over for their pixels, the
// displays there was no record for, the records that were no picture's.
pub fn list() -> *const displays.List { return &found }

// The display whose picture begins in the memory [base, base + bytes) (a
// card's aperture: its driver asks which display is its own); one that
// is not present when none does.
var none: Display = undefined // (per run)

pub fn inMemory(base: usize, bytes: usize) -> *Display {
    var k: usize = 0
    while k < total {
        if all[k].present && all[k].address >= base && all[k].address < base + bytes { return &all[k] }
        k += 1
    }
    none.present = false
    none.address = 0
    none.width = 0
    none.height = 0
    none.pitch = 0
    return &none
}

fn blobWord(offset: usize) -> usize { return unsafe { @ptrFromInt(*const usize, layout.Blob.virtual(offset)) }.* }

// The PCI functions of the display class (every bus looked through for
// them once, when the displays are found).
const ADAPTERS: usize = 16
var adapters: [ADAPTERS]usize = undefined // (per run)
var adapterCount: usize = 0 // (per run)

fn findAdapters() -> void {
    adapterCount = 0
    while adapterCount < ADAPTERS {
        const function = Pci.findClass(0x030000, 0xFF0000, adapterCount)
        if function == Pci.NONE { break }
        adapters[adapterCount] = function
        adapterCount += 1
    }
}

// The display adapter whose memory holds `address`: of the adapters'
// memory BARs the one that begins nearest below it, when the address is
// inside that BAR (its size asked of the device, pci.mlx). Pci.NONE when
// it is no such adapter's memory.
fn adapterOf(address: usize) -> usize {
    var best: usize = Pci.NONE
    var bestBar: usize = 0
    var bestBase: usize = 0
    var n: usize = 0
    while n < adapterCount {
        const function = adapters[n]
        var bar: usize = 0
        while bar < 6 {
            const raw = Pci.read(function, Pci.BAR0 + bar * 4)
            if raw & 1 == 0 {
                const base = Pci.memBase(function, bar)
                if base != 0 && base <= address && (best == Pci.NONE || base > bestBase) {
                    best = function
                    bestBar = bar
                    bestBase = base
                }
                // (A 64-bit BAR takes the next register too.)
                if raw & 0x6 == 0x4 { bar += 1 }
            }
            bar += 1
        }
        n += 1
    }
    if best == Pci.NONE { return Pci.NONE }
    const size = Pci.memSize(best, bestBar)
    if size == 0 || address - bestBase >= size { return Pci.NONE }
    return best
}

// The node's name of the display that is the `place`-th of those that
// are not the main one (from 1), or the main one's (0).
fn nameAs(d: *Display, place: usize) -> void {
    const stem = "framebuffer"
    var k: usize = 0
    while k < stem.length {
        d.*.name[k] = stem[k]
        k += 1
    }
    if place != 0 {
        d.*.name[k] = @intCast(u8, 48 + place % 10)
        k += 1
    }
    d.*.nameLength = k
}

// The displays found: the loader's (each with its adapter looked up),
// else the Bochs adapter in a mode of its own; the main one chosen
// (displays.choose, with the image's settings/display). False when there
// is none.
pub fn find() -> bool {
    total = 0
    mainAt = 0
    mainBy = displays.By.ONLY
    wantedMissing = false
    all[0].present = false
    all[0].firmware = false
    displays.read(blobWord, &found)
    if found.count != 0 { findAdapters() }
    var k: usize = 0
    while k < found.count {
        const f = &found.items[k]
        const d = &all[k]
        d.*.address = f.*.address
        d.*.width = f.*.width
        d.*.height = f.*.height
        d.*.pitch = f.*.pitch
        d.*.format = f.*.format
        d.*.present = true
        d.*.firmware = true
        d.*.shapeWidth = f.*.shapeWidth
        d.*.shapeHeight = f.*.shapeHeight
        d.*.number = k
        d.*.monitorWidth = f.*.monitorWidth
        d.*.monitorHeight = f.*.monitorHeight
        d.*.firmwareWidth = f.*.firmwareWidth
        d.*.firmwareHeight = f.*.firmwareHeight
        d.*.modeBy = f.*.modeBy
        d.*.refused = f.*.refused
        d.*.edid = layout.Blob.virtual(f.*.edidAt)
        d.*.edidBytes = f.*.edidBytes
        d.*.output = f.*.output
        d.*.first = f.*.first
        d.*.adapter = adapterOf(d.*.address)
        d.*.vendor = 0
        d.*.device = 0
        if d.*.adapter != Pci.NONE {
            const id = Pci.read(d.*.adapter, Pci.VENDOR_DEVICE)
            d.*.vendor = id & 0xFFFF
            d.*.device = (id >> 16) & 0xFFFF
        }
        f.*.vendor = d.*.vendor
        f.*.device = d.*.device
        k += 1
    }
    total = found.count
    if total == 0 {
        const d = &all[0]
        if !d.bochs() { return false }
        d.*.number = 0
        d.*.monitorWidth = 0
        d.*.monitorHeight = 0
        d.*.firmwareWidth = 0
        d.*.firmwareHeight = 0
        d.*.modeBy = 0
        d.*.refused = 0
        d.*.edid = 0
        d.*.edidBytes = 0
        d.*.output = 0
        d.*.first = true
        d.*.adapter = Pci.find(Display.VENDOR, Display.DEVICE)
        d.*.vendor = Display.VENDOR
        d.*.device = Display.DEVICE
        total = 1
    }
    // The main one: the image's word (the boot archive's settings/display,
    // whatever / is mounted from: the image that was started says it),
    // else the rule.
    const file = archive.Archive.boot().find("settings/display")
    wanted = displays.named(file.data[0..file.size])
    if found.count != 0 {
        const choice = displays.choose(&found, &wanted)
        mainAt = choice.index
        mainBy = choice.by
        wantedMissing = choice.missing
    } else {
        wantedMissing = wanted.kind != displays.Named.NONE && !(wanted.kind == displays.Named.NUMBER && wanted.number == 0) && !(wanted.kind == displays.Named.ADAPTER && wanted.vendor == Display.VENDOR && wanted.device == Display.DEVICE)
    }
    // Their nodes' names: the main one's, then the others' by their
    // order.
    var place: usize = 1
    k = 0
    while k < total {
        if k == mainAt {
            nameAs(&all[k], 0)
        } else {
            nameAs(&all[k], place)
            place += 1
        }
        k += 1
    }
    return true
}
