// Physical frames (4 KiB) and page tables. Frames come from FREE_PHYS to
// the end of memory (the Multiboot information's, within the mapped GiB);
// freed ones are kept on a list. Page tables are reached through the
// kernel's view of physical memory.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")

pub const PAGE: usize = 4096
pub const PRESENT: usize = 1
pub const WRITABLE: usize = 2
pub const USER: usize = 4
pub const HUGE: usize = 0x80

var nextFrame: usize = 0 // (per run)
var endFrame: usize = 0 // (per run)
var freeList: usize = 0 // (per run)
var freeCount: usize = 0 // (per run)

// Memory from the Multiboot information (mem_upper: KiB above 1 MiB).
pub fn init() -> void {
    nextFrame = cpu.bootInfo(layout.INFO_FREE_PHYS)
    var end: usize = 128 * 1024 * 1024
    const mbi = cpu.bootInfo(layout.INFO_MBI)
    if mbi != 0 {
        const flags: *u32 = unsafe { @ptrFromInt(*u32, cpu.physical(mbi)) }
        if flags.* & 1 != 0 {
            const upper: *u32 = unsafe { @ptrFromInt(*u32, cpu.physical(mbi + 8)) }
            end = 0x100000 + @intCast(usize, upper.*) * 1024
        }
    }
    if end > layout.MAPPED_LIMIT { end = layout.MAPPED_LIMIT }
    endFrame = end & ~(PAGE - 1)
}

pub fn totalBytes() -> usize { return endFrame }
pub fn freeBytes() -> usize { return endFrame - nextFrame + freeCount * PAGE }

fn zeroFrame(frame: usize) -> void {
    const words: [*]usize = unsafe { @ptrFromInt([*]usize, cpu.physical(frame)) }
    var k: usize = 0
    while k < PAGE / 8 {
        words[k] = 0
        k += 1
    }
}

// A zeroed frame's physical address; 0 when memory is out.
pub fn allocate() -> usize {
    var frame: usize = 0
    if freeList != 0 {
        frame = freeList
        const next: *usize = unsafe { @ptrFromInt(*usize, cpu.physical(frame)) }
        freeList = next.*
        freeCount -= 1
    } else if nextFrame < endFrame {
        frame = nextFrame
        nextFrame += PAGE
    } else {
        return 0
    }
    zeroFrame(frame)
    return frame
}

pub fn free(frame: usize) -> void {
    const next: *usize = unsafe { @ptrFromInt(*usize, cpu.physical(frame)) }
    next.* = freeList
    freeList = frame
    freeCount += 1
}

fn entries(table: usize) -> [*]usize { return unsafe { @ptrFromInt([*]usize, cpu.physical(table)) } }

// An address space: a new PML4 with the kernel's half (entry 256 of the
// boot tables) in it; 0 when memory is out.
pub fn newSpace() -> usize {
    const pml4 = allocate()
    if pml4 == 0 { return 0 }
    const boot = entries(layout.BLOB_PHYS + layout.PML4)
    entries(pml4)[256] = boot[256]
    return pml4
}

// The table `index` of `table` points to, made when `create`; 0 when
// there is none.
fn next(table: usize, index: usize, create: bool) -> usize {
    const slots = entries(table)
    if slots[index] & PRESENT == 0 {
        if !create { return 0 }
        const fresh = allocate()
        if fresh == 0 { return 0 }
        slots[index] = fresh | PRESENT | WRITABLE | USER
    }
    return slots[index] & 0x000FFFFFFFFFF000
}

// Maps the page at `address` of the space to `frame` with `flags`; false
// when memory for a table is out.
pub fn map(space: usize, address: usize, frame: usize, flags: usize) -> bool {
    const pdpt = next(space, (address >> 39) & 511, true)
    if pdpt == 0 { return false }
    const pd = next(pdpt, (address >> 30) & 511, true)
    if pd == 0 { return false }
    const pt = next(pd, (address >> 21) & 511, true)
    if pt == 0 { return false }
    entries(pt)[(address >> 12) & 511] = (frame & 0x000FFFFFFFFFF000) | flags | PRESENT
    return true
}

// The frame the page at `address` is mapped to; 0 when none.
pub fn translate(space: usize, address: usize) -> usize {
    const pdpt = next(space, (address >> 39) & 511, false)
    if pdpt == 0 { return 0 }
    const pd = next(pdpt, (address >> 30) & 511, false)
    if pd == 0 { return 0 }
    const pt = next(pd, (address >> 21) & 511, false)
    if pt == 0 { return 0 }
    const entry = entries(pt)[(address >> 12) & 511]
    if entry & PRESENT == 0 { return 0 }
    return entry & 0x000FFFFFFFFFF000
}

// A fresh zeroed page at `address` (user, writable); false when memory is
// out.
pub fn back(space: usize, address: usize) -> bool {
    const frame = allocate()
    if frame == 0 { return false }
    if !map(space, address & ~(PAGE - 1), frame, PRESENT | WRITABLE | USER) {
        free(frame)
        return false
    }
    return true
}

// Every user page and table of the space freed, the PML4 too.
pub fn freeSpace(space: usize) -> void {
    var i: usize = 0
    while i < 256 {
        const pdpt = next(space, i, false)
        if pdpt != 0 {
            var j: usize = 0
            while j < 512 {
                const pd = next(pdpt, j, false)
                if pd != 0 {
                    var k: usize = 0
                    while k < 512 {
                        const pt = next(pd, k, false)
                        if pt != 0 {
                            var l: usize = 0
                            while l < 512 {
                                const entry = entries(pt)[l]
                                if entry & PRESENT != 0 { free(entry & 0x000FFFFFFFFFF000) }
                                l += 1
                            }
                            free(pt)
                        }
                        k += 1
                    }
                    free(pd)
                }
                j += 1
            }
            free(pdpt)
        }
        i += 1
    }
    free(space)
}

// The page at `address` unmapped and its frame freed (when it had one).
pub fn release(space: usize, address: usize) -> void {
    const pdpt = next(space, (address >> 39) & 511, false)
    if pdpt == 0 { return }
    const pd = next(pdpt, (address >> 30) & 511, false)
    if pd == 0 { return }
    const pt = next(pd, (address >> 21) & 511, false)
    if pt == 0 { return }
    const slots = entries(pt)
    const index = (address >> 12) & 511
    if slots[index] & PRESENT == 0 { return }
    free(slots[index] & 0x000FFFFFFFFFF000)
    slots[index] = 0
    cpu.invlpg(address)
}
