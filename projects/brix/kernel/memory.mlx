// Physical frames (4 KiB) and address spaces. Frames come from
// Memory.FREE to the end of memory (the Multiboot information's; beyond
// the GiB the boot tables map, the kernel maps the rest itself at its
// start, a page directory of 2 MiB pages a GiB under the boot PDPT that
// every space shares); freed ones are kept on a list. A frame can be shared
// (by address spaces after a fork, by files): it counts who holds it and
// is free when the last one lets it go; a shared page is copied when one
// of them writes to it (copy on write). Page tables are reached through
// the kernel's view of physical memory.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const Bytes = @import("./bytes.mlx").Bytes

pub const Page = struct {
    pub const SIZE: usize = 4096
    pub const PRESENT: usize = 1
    pub const WRITABLE: usize = 2
    pub const USER: usize = 4
    // An available bit of an entry: the page is shared, written only
    // after a copy (it is mapped read-only).
    pub const COPY_ON_WRITE: usize = 0x200
    // Another: the page is a memory object's, shared by every space that
    // maps it (a copy of the space shares it as it is, never copied).
    pub const SHARED: usize = 0x400
    // A device's page (the framebuffer): not a frame, never freed, kept as
    // it is by a copy.
    pub const DEVICE: usize = 0x800
    // The frame's address in an entry.
    pub const ADDRESS: usize = 0x000FFFFFFFFFF000

    pub fn down(value: usize) -> usize { return value & ~(SIZE - 1) }
    pub fn up(value: usize) -> usize { return (value + SIZE - 1) & ~(SIZE - 1) }
}

// A run of RAM the kernel hands out (physical, page-aligned).
pub const Span = struct {
    start: usize
    end: usize
}

pub const Frames = struct {
    // A frame is held by at most this many (sharing more copies it).
    pub const MAX_HOLDERS: usize = 0xFFFF
    pub const MAX_SPANS: usize = 8

    // The RAM from Memory.FREE on, in spans (the Multiboot memory map's
    // available regions: the one below the hole under 4 GiB, and the ones
    // above it; without a map, one span to mem_upper's end), the span
    // `next` is in, and the end of the last.
    spans: [MAX_SPANS]Span
    spanCount: usize
    span: usize
    next: usize
    end: usize
    // The RAM in all (the kernel's own part before FREE included).
    total: usize
    freeList: usize
    freeCount: usize
    // How many hold each frame (a u16 per frame, in frames of their own).
    holders: [*]u16

    // Memory from the Multiboot information: mem_upper (KiB above 1 MiB),
    // and the memory map (flag 6) where the loader gives one: the RAM
    // above the hole under 4 GiB is there alone.
    pub fn init(self: *Self) -> void {
        var id: usize = 0
        while id < layout.Memory.MAX_CPUS {
            active[id] = 0
            id += 1
        }
        self.*.next = cpu.BootInfo.get(layout.Info.FREE_PHYS)
        self.*.freeList = 0
        self.*.freeCount = 0
        self.*.spanCount = 0
        var end: usize = 128 * 1024 * 1024
        const mbi = cpu.BootInfo.get(layout.Info.MBI)
        if mbi != 0 {
            const info = Bytes.pointer(layout.Memory.virtual(mbi))
            const flags = Bytes.read32(info, 0)
            if flags & 1 != 0 { end = 0x100000 + Bytes.read32(info, 8) * 1024 }
            if flags & 64 != 0 { self.readMap(Bytes.read32(info, 48), Bytes.read32(info, 44)) }
        }
        if self.*.spanCount == 0 { self.addSpan(self.*.next, Page.down(end)) }
        // (Only what the kernel's view reaches.)
        var k: usize = 0
        while k < self.*.spanCount {
            if self.*.spans[k].start >= layout.Memory.MAPPED_LIMIT {
                self.*.spanCount = k
                break
            }
            if self.*.spans[k].end > layout.Memory.MAPPED_LIMIT { self.*.spans[k].end = layout.Memory.MAPPED_LIMIT }
            k += 1
        }
        self.*.end = self.*.spans[self.*.spanCount - 1].end
        self.*.span = 0
        self.*.next = self.*.spans[0].start
        self.*.total = self.*.spans[0].start
        k = 0
        while k < self.*.spanCount {
            self.*.total += self.*.spans[k].end - self.*.spans[k].start
            k += 1
        }
        self.mapRest()
        // The counts first, taken from the start of the free frames.
        const countBytes = Page.up(self.*.end / Page.SIZE * 2)
        self.*.holders = unsafe { @ptrFromInt([*]u16, layout.Memory.virtual(self.*.next)) }
        Bytes.zeroWords(layout.Memory.virtual(self.*.next), countBytes)
        self.*.next += countBytes
    }

    // The Multiboot memory map at `address` (`length` bytes): entries of
    // a size, a base, a length and a type (1: RAM), the RAM from the
    // free frames on as spans.
    fn readMap(self: *Self, address: usize, length: usize) -> void {
        var at: usize = 0
        while at + 24 <= length {
            const entry = Bytes.pointer(layout.Memory.virtual(address + at))
            const size = Bytes.read32(entry, 0)
            if size < 20 { return }
            if Bytes.read32(entry, 20) == 1 {
                const base = Bytes.read64(entry, 4)
                const bytes = Bytes.read64(entry, 12)
                var start = Page.up(base)
                const stop = Page.down(base + bytes)
                if start < self.*.next { start = self.*.next }
                if start < stop { self.addSpan(start, stop) }
            }
            at += size + 4
        }
    }

    fn addSpan(self: *Self, start: usize, stop: usize) -> void {
        if self.*.spanCount > 0 && self.*.spans[self.*.spanCount - 1].end == start {
            self.*.spans[self.*.spanCount - 1].end = stop
            return
        }
        if self.*.spanCount == MAX_SPANS { return }
        self.*.spans[self.*.spanCount] = Span.{ .start = start, .end = stop }
        self.*.spanCount += 1
    }

    // The RAM beyond the first GiB in the kernel's view: for each GiB
    // with some, a page directory (a frame from the start of the free
    // ones) of 2 MiB pages under the boot PDPT, entries another mapping
    // made (the local APIC's) left as they are; nothing for the hole.
    fn mapRest(self: *Self) -> void {
        const pdpt = Bytes.pointer(layout.Memory.virtual(layout.Memory.BLOB + layout.Blob.PDPT))
        var k: usize = 0
        while k < self.*.spanCount {
            var physical = self.*.spans[k].start & ~(layout.Memory.HUGE - 1)
            if physical < layout.Memory.GIB { physical = layout.Memory.GIB }
            while physical < self.*.spans[k].end {
                const gib = physical / layout.Memory.GIB
                if Bytes.read64(pdpt, gib * 8) & Page.PRESENT == 0 {
                    const directory = self.*.next
                    self.*.next += Page.SIZE
                    Bytes.zeroWords(layout.Memory.virtual(directory), Page.SIZE)
                    Bytes.write64(pdpt, gib * 8, directory | Page.PRESENT | Page.WRITABLE)
                }
                const table = Bytes.pointer(layout.Memory.virtual(Bytes.read64(pdpt, gib * 8) & Page.ADDRESS))
                const slot = (physical / layout.Memory.HUGE) % 512
                // Present, writable, a 2 MiB page.
                if Bytes.read64(table, slot * 8) & Page.PRESENT == 0 { Bytes.write64(table, slot * 8, physical | 0x83) }
                physical += layout.Memory.HUGE
            }
            k += 1
        }
    }

    // How many hold the frame.
    pub fn holderCount(self: *const Self, frame: usize) -> usize { return @intCast(usize, self.*.holders[frame / Page.SIZE]) }

    // One more holds the frame; false when it is held by too many (the
    // caller copies it instead).
    pub fn share(self: *Self, frame: usize) -> bool {
        const at = frame / Page.SIZE
        if @intCast(usize, self.*.holders[at]) >= MAX_HOLDERS { return false }
        self.*.holders[at] += 1
        return true
    }

    pub fn totalBytes(self: *const Self) -> usize { return self.*.total }

    // What has never been handed out (the current span's rest and the
    // spans after it) and what came back.
    pub fn freeBytes(self: *const Self) -> usize {
        var bytes = self.*.freeCount * Page.SIZE
        if self.*.span < self.*.spanCount && self.*.next < self.*.spans[self.*.span].end { bytes += self.*.spans[self.*.span].end - self.*.next }
        var k = self.*.span + 1
        while k < self.*.spanCount {
            bytes += self.*.spans[k].end - self.*.spans[k].start
            k += 1
        }
        return bytes
    }

    // `next` into the next span when its own is used up; false when
    // none is left.
    fn advance(self: *Self) -> bool {
        while self.*.next >= self.*.spans[self.*.span].end {
            if self.*.span + 1 >= self.*.spanCount { return false }
            self.*.span += 1
            self.*.next = self.*.spans[self.*.span].start
        }
        return true
    }

    // A zeroed frame's physical address; 0 when memory is out.
    pub fn allocate(self: *Self) -> usize {
        var frame: usize = 0
        if self.*.freeList != 0 {
            frame = self.*.freeList
            self.*.freeList = Bytes.read64(Bytes.pointer(layout.Memory.virtual(frame)), 0)
            self.*.freeCount -= 1
        } else if self.advance() {
            frame = self.*.next
            self.*.next += Page.SIZE
        } else {
            return 0
        }
        Bytes.zeroWords(layout.Memory.virtual(frame), Page.SIZE)
        self.*.holders[frame / Page.SIZE] = 1
        return frame
    }

    // `count` frames one after the other (for a device that wants them
    // so), zeroed: the first one's address; 0 when there are not that
    // many left in one piece.
    pub fn allocateContiguous(self: *Self, count: usize) -> usize {
        if !self.advance() { return 0 }
        // (In one span: the next one when the rest of this is too short,
        // the rest left as it is; a device asks early, from a big span.)
        if self.*.spans[self.*.span].end - self.*.next < count * Page.SIZE {
            if self.*.span + 1 >= self.*.spanCount || self.*.spans[self.*.span + 1].end - self.*.spans[self.*.span + 1].start < count * Page.SIZE { return 0 }
            self.*.span += 1
            self.*.next = self.*.spans[self.*.span].start
        }
        const first = self.*.next
        self.*.next += count * Page.SIZE
        var k: usize = 0
        while k < count {
            Bytes.zeroWords(layout.Memory.virtual(first + k * Page.SIZE), Page.SIZE)
            self.*.holders[(first + k * Page.SIZE) / Page.SIZE] = 1
            k += 1
        }
        return first
    }

    // A holder lets the frame go; it is free when it was the last.
    pub fn free(self: *Self, frame: usize) -> void {
        const at = frame / Page.SIZE
        if self.*.holders[at] > 1 {
            self.*.holders[at] -= 1
            return
        }
        self.*.holders[at] = 0
        Bytes.write64(Bytes.pointer(layout.Memory.virtual(frame)), 0, self.*.freeList)
        self.*.freeList = frame
        self.*.freeCount += 1
    }
}

// A device's memory (a controller's registers, the framebuffer) in the
// kernel's view: the 2 MiB pages that hold it, in a page directory for
// their GiB under the boot PDPT (which every address space shares). Memory
// below 511 GiB is at Memory.virtual(physical), as RAM is; memory beyond
// (a 64-bit BAR the firmware put high: above what the PDPT reaches at
// that offset) is given pages of a window, the PDPT's last GiB. The
// drivers map their registers uncached; the framebuffer is written
// through a write-combining mapping (page-attribute entry 1, which
// `Device.attributes` makes so on each processor): without it every pixel
// is a bus write of its own, and a screen of them takes a noticeable part
// of a second on a real machine.
pub const Device = struct {
    // An entry's caching bits: PWT | PCD (page-attribute entry 3,
    // uncached), PWT alone (entry 1, write-combining).
    pub const UNCACHED: usize = 0x18
    pub const WRITE_COMBINING: usize = 0x08
    const HUGE_PAGE: usize = 0x83 // present, writable, a 2 MiB page
    const PAT: usize = 0x277
    // The table at reset but for entry 1 (write-through, which nothing
    // here uses): write-combining (01).
    const PAT_VALUE: usize = 0x0007040600070106
    // The window: the boot PDPT's last GiB, 512 pages of 2 MiB.
    const WINDOW_GIB: usize = 511
    const WINDOW_PAGES: usize = 512

    // This processor's page-attribute table (each one has its own: the
    // first at boot, the others as they come into the kernel).
    pub fn attributes() -> void { cpu.Msr.write(PAT, PAT_VALUE) }

    fn pdpt() -> [*]u8 { return Bytes.pointer(layout.Memory.virtual(layout.Memory.BLOB + layout.Blob.PDPT)) }

    // The page directory of `gib` under the boot PDPT, made when there is
    // none; 0 when memory is out.
    fn directory(gib: usize) -> usize {
        const entry = Bytes.read64(pdpt(), gib * 8)
        if entry & Page.PRESENT != 0 { return layout.Memory.virtual(entry & Page.ADDRESS) }
        const made = frames.allocate()
        if made == 0 { return 0 }
        Bytes.write64(pdpt(), gib * 8, made | Page.PRESENT | Page.WRITABLE)
        return layout.Memory.virtual(made)
    }

    // The 2 MiB page at `physical` in the entry `slot` of the directory
    // at `table`, seen at `address`.
    fn enter(table: usize, slot: usize, physical: usize, caching: usize, address: usize) -> void {
        const entries = Bytes.pointer(table)
        const wanted = physical | HUGE_PAGE | caching
        const now = Bytes.read64(entries, slot * 8)
        if now == wanted { return }
        Bytes.write64(entries, slot * 8, wanted)
        // (An entry that was there may be in this processor's translation
        // cache.)
        if now & Page.PRESENT != 0 { cpu.Cpu.invalidatePage(address) }
    }

    // Maps [physical, physical + bytes) with `caching`: where `physical`
    // is in the kernel's view, 0 when memory or the window is out.
    pub fn map(physical: usize, bytes: usize, caching: usize) -> usize {
        if bytes == 0 { return 0 }
        const first = physical & ~(layout.Memory.HUGE - 1)
        const end = physical + bytes
        if end <= WINDOW_GIB * layout.Memory.GIB {
            var page = first
            while page < end {
                const gib = page / layout.Memory.GIB
                // (A GiB that is one 1 GiB page is in view already; its
                // entry is no directory's.)
                if Bytes.read64(pdpt(), gib * 8) & (Page.PRESENT | 0x80) != (Page.PRESENT | 0x80) {
                    const table = directory(gib)
                    if table == 0 { return 0 }
                    enter(table, (page / layout.Memory.HUGE) % 512, page, caching, layout.Memory.virtual(page))
                }
                page += layout.Memory.HUGE
            }
            return layout.Memory.virtual(physical)
        }
        const pages = (end - first + layout.Memory.HUGE - 1) / layout.Memory.HUGE
        if windowUsed + pages > WINDOW_PAGES { return 0 }
        const table = directory(WINDOW_GIB)
        if table == 0 { return 0 }
        const start = layout.Memory.virtual(WINDOW_GIB * layout.Memory.GIB + windowUsed * layout.Memory.HUGE)
        var k: usize = 0
        while k < pages {
            enter(table, windowUsed + k, first + k * layout.Memory.HUGE, caching, start + k * layout.Memory.HUGE)
            k += 1
        }
        windowUsed += pages
        return start + (physical - first)
    }
}

// The window's pages handed out.
var windowUsed: usize = 0 // (per run)

var frames: Frames = undefined // (per run)
// The space each processor has loaded (its root; 0: unknown, the boot
// tables), for Space.activate.
var active: [layout.Memory.MAX_CPUS]usize = undefined // (per run)

pub fn allFrames() -> *Frames { return &frames }

// Processor `id` counts no space as loaded: its next activation writes
// CR3 (the scheduler, for a process that ran on another processor).
pub fn forgetActive(id: usize) -> void {
    if id < layout.Memory.MAX_CPUS { active[id] = 0 }
}

// An address space: its PML4 (physical), the kernel's half (entry 256 of
// the boot tables) in it. The lower half is the program's.
pub const Space = struct {
    root: usize

    // A new space; its root is 0 when memory is out.
    pub fn create() -> Space {
        const root = frames.allocate()
        if root != 0 { entries(root)[256] = entries(layout.Memory.BLOB + layout.Blob.PML4)[256] }
        return Space.{ .root = root }
    }

    // The boot page tables: the kernel's half, and the first GiB at 0
    // (the space in use while a process's own is freed).
    pub fn boot() -> Space { return Space.{ .root = layout.Memory.BLOB + layout.Blob.PML4 } }

    pub fn isValid(self: Self) -> bool { return self.root != 0 }

    // The processor uses this space from now on (nothing to do when it
    // does already: writing CR3 drops every TLB entry, and a process
    // that goes on after a system call or a tick is in its space still).
    pub fn activate(self: Self) -> void {
        const id = cpu.Cpu.id()
        if id < layout.Memory.MAX_CPUS && active[id] == self.root { return }
        if id < layout.Memory.MAX_CPUS { active[id] = self.root }
        cpu.Cpu.usePageTables(self.root)
    }

    fn entries(table: usize) -> [*]usize { return unsafe { @ptrFromInt([*]usize, layout.Memory.virtual(table)) } }

    // The table `index` of `table` points to, made when `create`; 0 when
    // there is none.
    fn next(table: usize, index: usize, create: bool) -> usize {
        const slots = entries(table)
        if slots[index] & Page.PRESENT == 0 {
            if !create { return 0 }
            const fresh = frames.allocate()
            if fresh == 0 { return 0 }
            slots[index] = fresh | Page.PRESENT | Page.WRITABLE | Page.USER
        }
        return slots[index] & Page.ADDRESS
    }

    // The page table entry of `address`; null without the tables (made
    // first when `create`).
    fn entry(self: Self, address: usize, create: bool) -> ?*usize {
        const pdpt = next(self.root, (address >> 39) & 511, create)
        if pdpt == 0 { return null }
        const pd = next(pdpt, (address >> 30) & 511, create)
        if pd == 0 { return null }
        const pt = next(pd, (address >> 21) & 511, create)
        if pt == 0 { return null }
        return &entries(pt)[(address >> 12) & 511]
    }

    // Maps the page at `address` to `frame` with `flags`; false when
    // memory for a table is out.
    pub fn map(self: Self, address: usize, frame: usize, flags: usize) -> bool {
        const slot = self.entry(address, true)
        if slot == null { return false }
        slot.?.* = (frame & Page.ADDRESS) | flags | Page.PRESENT
        return true
    }

    // The frame the page at `address` is mapped to; 0 when none.
    pub fn translate(self: Self, address: usize) -> usize {
        const slot = self.entry(address, false)
        if slot == null || slot.?.* & Page.PRESENT == 0 { return 0 }
        return slot.?.* & Page.ADDRESS
    }

    // A fresh zeroed page at `address` (user, writable); false when
    // memory is out.
    pub fn back(self: Self, address: usize) -> bool {
        const frame = frames.allocate()
        if frame == 0 { return false }
        if !self.map(Page.down(address), frame, Page.PRESENT | Page.WRITABLE | Page.USER) {
            frames.free(frame)
            return false
        }
        return true
    }

    // The page at `address` unmapped and its frame freed (when it had
    // one).
    pub fn release(self: Self, address: usize) -> void {
        if self.drop(address) { cpu.Cpu.invalidatePage(address) }
    }

    // The same without the processor told: whether there was a page (the
    // caller then has the processor forget it, or all of the space's:
    // flush).
    pub fn drop(self: Self, address: usize) -> bool {
        const slot = self.entry(address, false)
        if slot == null || slot.?.* & Page.PRESENT == 0 { return false }
        if slot.?.* & Page.DEVICE == 0 { frames.free(slot.?.* & Page.ADDRESS) }
        slot.?.* = 0
        return true
    }

    // `length` bytes from `from` into the space at `address`, pages made as
    // needed (through the kernel's view of their frames, whichever space
    // is in use); false when memory is out.
    pub fn write(self: Self, address: usize, from: [*]const u8, length: usize) -> bool {
        var done: usize = 0
        while done < length {
            const at = address + done
            var frame = self.translate(at)
            if frame == 0 {
                if !self.back(at) { return false }
                frame = self.translate(at)
            }
            const offset = at & (Page.SIZE - 1)
            var chunk = Page.SIZE - offset
            if chunk > length - done { chunk = length - done }
            Bytes.copy(Bytes.pointer(layout.Memory.virtual(frame) + offset), unsafe { @ptrFromInt([*]const u8, @intFromPtr(from) + done) }, chunk)
            done += chunk
        }
        return true
    }

    pub fn writeWord(self: Self, address: usize, value: usize) -> bool {
        var bytes: [8]u8 = undefined
        Bytes.write64(&bytes, 0, value)
        return self.write(address, &bytes, 8)
    }

    // A copy of the lower half that shares its pages (a fork's child):
    // every writable page becomes read-only and copy-on-write in both
    // spaces (the caller makes the processor forget the old mappings);
    // the root is 0 when memory is out (what was made is freed again).
    pub fn clone(self: Self) -> Space {
        const copy = Space.create()
        if !copy.isValid() { return copy }
        var i: usize = 0
        while i < 256 {
            const pdpt = next(self.root, i, false)
            if pdpt != 0 {
                var j: usize = 0
                while j < 512 {
                    const pd = next(pdpt, j, false)
                    if pd != 0 {
                        var k: usize = 0
                        while k < 512 {
                            const pt = next(pd, k, false)
                            if pt != 0 && !shareTable(copy, pt, (i << 39) | (j << 30) | (k << 21)) {
                                copy.destroy()
                                return Space.{ .root = 0 }
                            }
                            k += 1
                        }
                    }
                    j += 1
                }
            }
            i += 1
        }
        // This space's pages are read-only now where they were writable:
        // the TLB of a processor that has it loaded must forget them.
        self.flush()
        return copy
    }

    // The TLB dropped on a processor that has this space loaded (after
    // entries of it were narrowed while it was in use).
    pub fn flush(self: Self) -> void {
        const id = cpu.Cpu.id()
        if id < layout.Memory.MAX_CPUS && active[id] == self.root { cpu.Cpu.usePageTables(self.root) }
    }

    // The pages of the page table `pt` (mapping from `base` on) shared
    // with `into`, copy-on-write (copied when too many share one).
    fn shareTable(into: Space, pt: usize, base: usize) -> bool {
        var l: usize = 0
        while l < 512 {
            const slot = &entries(pt)[l]
            const value = slot.*
            if value & Page.PRESENT != 0 {
                const frame = value & Page.ADDRESS
                var flags = value & (Page.SIZE - 1)
                if flags & Page.DEVICE != 0 {
                    // A device's page: the same mapping, no frame to share.
                    if !into.map(base | (l << 12), frame, flags) { return false }
                } else if flags & Page.SHARED != 0 {
                    // A memory object's page stays shared, as writable as
                    // it was.
                    if !frames.share(frame) { return false }
                    if !into.map(base | (l << 12), frame, flags) {
                        frames.free(frame)
                        return false
                    }
                } else if frames.share(frame) {
                    if flags & Page.WRITABLE != 0 {
                        flags = (flags & ~Page.WRITABLE) | Page.COPY_ON_WRITE
                        slot.* = frame | flags
                    }
                    if !into.map(base | (l << 12), frame, flags) {
                        frames.free(frame)
                        return false
                    }
                } else {
                    const copy = frames.allocate()
                    if copy == 0 { return false }
                    Bytes.copyWords(layout.Memory.virtual(copy), layout.Memory.virtual(frame), Page.SIZE)
                    if !into.map(base | (l << 12), copy, flags) {
                        frames.free(copy)
                        return false
                    }
                }
            }
            l += 1
        }
        return true
    }

    // A write to the copy-on-write page at `address`: the page becomes
    // the space's own (copied when others still hold it) and writable.
    // False when the page is not copy-on-write (or memory is out).
    pub fn copyOnWrite(self: Self, address: usize) -> bool {
        const slot = self.entry(address, false)
        if slot == null { return false }
        const value = slot.?.*
        if value & Page.PRESENT == 0 || value & Page.COPY_ON_WRITE == 0 { return false }
        const frame = value & Page.ADDRESS
        const flags = (value & (Page.SIZE - 1) & ~Page.COPY_ON_WRITE) | Page.WRITABLE
        if frames.holderCount(frame) == 1 {
            slot.?.* = frame | flags
        } else {
            const copy = frames.allocate()
            if copy == 0 { return false }
            Bytes.copyWords(layout.Memory.virtual(copy), layout.Memory.virtual(frame), Page.SIZE)
            slot.?.* = copy | flags
            frames.free(frame)
        }
        cpu.Cpu.invalidatePage(address)
        return true
    }

    // Every page and table of the lower half freed, the PML4 too.
    pub fn destroy(self: Self) -> void {
        // (Its root frame may serve a new space: no processor counts it
        // as in use from here on.)
        var id: usize = 0
        while id < layout.Memory.MAX_CPUS {
            if active[id] == self.root { active[id] = 0 }
            id += 1
        }
        var i: usize = 0
        while i < 256 {
            const pdpt = next(self.root, i, false)
            if pdpt != 0 {
                var j: usize = 0
                while j < 512 {
                    const pd = next(pdpt, j, false)
                    if pd != 0 {
                        var k: usize = 0
                        while k < 512 {
                            const pt = next(pd, k, false)
                            if pt != 0 {
                                var l: usize = 0
                                while l < 512 {
                                    const value = entries(pt)[l]
                                    if value & Page.PRESENT != 0 && value & Page.DEVICE == 0 { frames.free(value & Page.ADDRESS) }
                                    l += 1
                                }
                                frames.free(pt)
                            }
                            k += 1
                        }
                        frames.free(pd)
                    }
                    j += 1
                }
                frames.free(pdpt)
            }
            i += 1
        }
        frames.free(self.root)
    }
}
