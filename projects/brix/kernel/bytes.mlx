// Little-endian values in memory: the boot archive, ELF files, the
// program's memory (once the kernel prepared it), the kernel's view of a
// frame.
pub const Bytes = struct {
    // The bytes at an address.
    pub fn pointer(address: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, address) } }

    pub fn read16(bytes: [*]const u8, at: usize) -> usize { return @intCast(usize, bytes[at]) | (@intCast(usize, bytes[at + 1]) << 8) }
    pub fn read32(bytes: [*]const u8, at: usize) -> usize { return read16(bytes, at) | (read16(bytes, at + 2) << 16) }
    pub fn read64(bytes: [*]const u8, at: usize) -> usize { return read32(bytes, at) | (read32(bytes, at + 4) << 32) }

    pub fn write16(bytes: [*]u8, at: usize, value: usize) -> void {
        bytes[at] = @intCast(u8, value & 255)
        bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    }

    pub fn write32(bytes: [*]u8, at: usize, value: usize) -> void {
        write16(bytes, at, value & 0xFFFF)
        write16(bytes, at + 2, (value >> 16) & 0xFFFF)
    }

    pub fn write64(bytes: [*]u8, at: usize, value: usize) -> void {
        write32(bytes, at, value & 0xFFFFFFFF)
        write32(bytes, at + 4, value >> 32)
    }

    // `length` bytes set to `value`. Zeros (a fresh page, a table, a
    // buffer) are copied from a page of them, a block at a time; any
    // other value goes a word at a time.
    pub fn fill(bytes: [*]u8, length: usize, value: u8) -> void {
        var to = @intFromPtr(bytes)
        var left = length
        if value == 0 && left >= 64 {
            const none = zeroPage()
            while left >= 4096 {
                block4096(to).* = block4096(none).*
                to += 4096
                left -= 4096
            }
            while left >= 512 {
                block512(to).* = block512(none).*
                to += 512
                left -= 512
            }
            while left >= 64 {
                block64(to).* = block64(none).*
                to += 64
                left -= 64
            }
        }
        const word = @intCast(usize, value) * 0x0101010101010101
        while left >= 8 {
            words(to)[0] = word
            to += 8
            left -= 8
        }
        const rest = pointer(to)
        var k: usize = 0
        while k < left {
            rest[k] = value
            k += 1
        }
    }

    // `length` bytes from one place to another that does not overlap it
    // (none of the kernel's copies does): by blocks, each the processor's
    // own block move, then words, then the last bytes. (A byte at a time
    // this was eleven instructions for each: 1.7 GiB a second, a page in
    // 2 us, where the block move takes 25 ns.)
    pub fn copy(into: [*]u8, from: [*]const u8, length: usize) -> void {
        var to = @intFromPtr(into)
        var at = @intFromPtr(from)
        var left = length
        while left >= 4096 {
            block4096(to).* = block4096(at).*
            to += 4096
            at += 4096
            left -= 4096
        }
        while left >= 512 {
            block512(to).* = block512(at).*
            to += 512
            at += 512
            left -= 512
        }
        while left >= 64 {
            block64(to).* = block64(at).*
            to += 64
            at += 64
            left -= 64
        }
        while left >= 8 {
            words(to)[0] = words(at)[0]
            to += 8
            at += 8
            left -= 8
        }
        const target = pointer(to)
        const source = pointer(at)
        var k: usize = 0
        while k < left {
            target[k] = source[k]
            k += 1
        }
    }

    // Zeros over a page (or any number of bytes). (A word at a time,
    // with the count divided anew for every word, a page took 1.3-1.6 us:
    // most of a page fault's time. Now 25-45 ns.)
    pub fn zeroWords(into: usize, length: usize) -> void { fill(pointer(into), length, 0) }

    // A page (or any number of bytes) at once.
    pub fn copyWords(into: usize, from: usize, length: usize) -> void { copy(pointer(into), pointer(from), length) }

    // The length of a NUL-terminated string.
    pub fn length(text: [*]const u8) -> usize {
        var n: usize = 0
        while text[n] != 0 { n += 1 }
        return n
    }

    // The CRC-32 (IEEE, as zlib's and the GPT's) of `length` bytes.
    pub fn crc32(bytes: [*]const u8, length: usize) -> usize {
        var crc: usize = 0xFFFFFFFF
        var k: usize = 0
        while k < length {
            crc ^= @intCast(usize, bytes[k])
            var bit: usize = 0
            while bit < 8 {
                crc = (crc >> 1) ^ (if crc & 1 != 0 { 0xEDB88320 } else { 0 })
                bit += 1
            }
            k += 1
        }
        return crc ^ 0xFFFFFFFF
    }
}

// Blocks of bytes: one assigned to another is the processor's block move
// (rep movsb), not a loop.
const Block4096 = struct { bytes: [4096]u8 }
const Block512 = struct { bytes: [512]u8 }
const Block64 = struct { bytes: [64]u8 }

// A page of zeros, to copy from: made at the first use (what a variable
// holds before it is written is not for the kernel to count on).
var zeros: Block4096 = undefined // (per run)
var zerosMade: bool = false // (per run)

fn zeroPage() -> usize {
    const address = @intFromPtr(&zeros)
    if !zerosMade {
        const page = words(address)
        var k: usize = 0
        while k < 512 {
            page[k] = 0
            k += 1
        }
        zerosMade = true
    }
    return address
}

fn block4096(address: usize) -> *Block4096 { return unsafe { @ptrFromInt(*Block4096, address) } }
fn block512(address: usize) -> *Block512 { return unsafe { @ptrFromInt(*Block512, address) } }
fn block64(address: usize) -> *Block64 { return unsafe { @ptrFromInt(*Block64, address) } }
fn words(address: usize) -> [*]usize { return unsafe { @ptrFromInt([*]usize, address) } }
