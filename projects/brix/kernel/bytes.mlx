// Little-endian values in memory: the boot archive, ELF files, the
// program's memory (once the kernel prepared it), the kernel's view of a
// frame.
pub const Bytes = struct {
    // The bytes at an address.
    pub fn pointer(address: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, address) } }

    pub fn read16(bytes: [*]const u8, at: usize) -> usize { return @intCast(usize, bytes[at]) | (@intCast(usize, bytes[at + 1]) << 8) }
    pub fn read32(bytes: [*]const u8, at: usize) -> usize { return read16(bytes, at) | (read16(bytes, at + 2) << 16) }
    pub fn read64(bytes: [*]const u8, at: usize) -> usize { return read32(bytes, at) | (read32(bytes, at + 4) << 32) }

    pub fn write16(bytes: [*]u8, at: usize, value: usize) -> void {
        bytes[at] = @intCast(u8, value & 255)
        bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    }

    pub fn write32(bytes: [*]u8, at: usize, value: usize) -> void {
        write16(bytes, at, value & 0xFFFF)
        write16(bytes, at + 2, (value >> 16) & 0xFFFF)
    }

    pub fn write64(bytes: [*]u8, at: usize, value: usize) -> void {
        write32(bytes, at, value & 0xFFFFFFFF)
        write32(bytes, at + 4, value >> 32)
    }

    pub fn fill(bytes: [*]u8, length: usize, value: u8) -> void {
        var k: usize = 0
        while k < length {
            bytes[k] = value
            k += 1
        }
    }

    pub fn copy(into: [*]u8, from: [*]const u8, length: usize) -> void {
        var k: usize = 0
        while k < length {
            into[k] = from[k]
            k += 1
        }
    }

    // Zeros over a page (or any multiple of 8 bytes), a word at a time.
    pub fn zeroWords(into: usize, length: usize) -> void {
        const target: [*]usize = unsafe { @ptrFromInt([*]usize, into) }
        var k: usize = 0
        while k < length / 8 {
            target[k] = 0
            k += 1
        }
    }

    // A page (or any multiple of 8 bytes) at once, a word at a time.
    pub fn copyWords(into: usize, from: usize, length: usize) -> void {
        const target: [*]usize = unsafe { @ptrFromInt([*]usize, into) }
        const source: [*]const usize = unsafe { @ptrFromInt([*]const usize, from) }
        var k: usize = 0
        while k < length / 8 {
            target[k] = source[k]
            k += 1
        }
    }

    // The length of a NUL-terminated string.
    pub fn length(text: [*]const u8) -> usize {
        var n: usize = 0
        while text[n] != 0 { n += 1 }
        return n
    }

    // The CRC-32 (IEEE, as zlib's and the GPT's) of `length` bytes.
    pub fn crc32(bytes: [*]const u8, length: usize) -> usize {
        var crc: usize = 0xFFFFFFFF
        var k: usize = 0
        while k < length {
            crc ^= @intCast(usize, bytes[k])
            var bit: usize = 0
            while bit < 8 {
                crc = (crc >> 1) ^ (if crc & 1 != 0 { 0xEDB88320 } else { 0 })
                bit += 1
            }
            k += 1
        }
        return crc ^ 0xFFFFFFFF
    }
}
