// A graphics card as programs see it: the record a read of /devices/gpuN
// gives (spec/04-stdlib/os/brix.xml, <GpuDevices>), little-endian, its own
// length first as the network link's record has it. The kernel makes it
// from what its driver read of the card (gpu_programs.mlx); the Vulkan
// driver's card on the host (projects/brix/vulkan/card_host.mlx) makes the
// same bytes from facts a test gives it, so that the driver reads one form
// on both; std.gpucard reads it. Nothing is imported here: the kernel and
// host programs build this file alike.

// The record's bytes, which is also its first word: a later kernel's
// record may be longer (its new fields after these), and a program reads
// what it knows of it.
pub const RECORD: usize = 136

// The flags.
pub const Flag = struct {
    // The firmware started the card: its registers answer as a started
    // card's. Without it nothing of the card is known but what its PCI
    // configuration and its ROM say.
    pub const STARTED: u32 = 0x1
    // The firmware's picture (the kernel's console) is in this card's
    // memory: `picture` bytes of the part the processor reaches are the
    // display's, no program's.
    pub const PICTURE: u32 = 0x2
    // The ROM's numbers of the graphics block are known (the four counts).
    pub const ROM_COUNTS: u32 = 0x4
    // The card reaches the system's memory (its GART is on): `system`
    // bytes of it.
    pub const SYSTEM_MEMORY: u32 = 0x8
}

// Why no engine of the card takes a program's commands (`why`; 0: one
// does, the rings say how many).
pub const Why = struct {
    pub const NONE: u32 = 0
    // The kernel reads the card and starts none of its engines yet.
    pub const NOT_STARTED_YET: u32 = 1
    // The firmware did not start the card: the kernel leaves it alone.
    pub const CARD_NOT_STARTED: u32 = 2
    // The kernel knows the engines of another card (a Polaris 10) alone.
    pub const OTHER_CARD: u32 = 3
}

// What the record says.
pub const Facts = struct {
    flags: u32
    // PCI: the vendor and device, the revision, and where the card sits
    // (bus << 8 | device << 3 | function, as 21:00.0 is 0x2100).
    vendor: u32
    device: u32
    revision: u32
    pci: u32
    // The graphics block's version as the ROM gives it (major << 8 |
    // minor: the RX 580's ROM says 8.1, 0x801); 0: not known.
    graphics: u32
    // The ROM's counts: shader engines, shader arrays an engine, compute
    // units an array (at most), render back ends an engine.
    shaderEngines: u32
    arraysPerEngine: u32
    computeUnitsPerArray: u32
    renderBackendsPerEngine: u32
    // The ROM's default clocks, kHz (0: not known).
    engineClock: u32
    memoryClock: u32
    // The rings that take a program's commands now, by engine, and why
    // there are none.
    computeRings: u32
    graphicsRings: u32
    copyRings: u32
    why: u32
    // The card's own memory, of it what the processor reaches (the
    // aperture), of that what the firmware's picture takes, and the
    // system's memory the card reaches (its GART), in bytes.
    memory: usize
    visible: usize
    picture: usize
    system: usize
    // The card's name (at most 31 bytes).
    name: []const u8
}

fn put32(into: [*]u8, at: usize, value: usize) -> void {
    into[at] = @intCast(u8, value & 0xFF)
    into[at + 1] = @intCast(u8, (value >> 8) & 0xFF)
    into[at + 2] = @intCast(u8, (value >> 16) & 0xFF)
    into[at + 3] = @intCast(u8, (value >> 24) & 0xFF)
}

fn put64(into: [*]u8, at: usize, value: usize) -> void {
    put32(into, at, value & 0xFFFFFFFF)
    put32(into, at + 4, value >> 32)
}

// The record of `facts` into `into` (RECORD bytes).
pub fn encode(facts: *const Facts, into: [*]u8) -> void {
    var k: usize = 0
    while k < RECORD {
        into[k] = 0
        k += 1
    }
    put32(into, 0, RECORD)
    put32(into, 4, @intCast(usize, facts.*.flags))
    put32(into, 8, @intCast(usize, facts.*.vendor))
    put32(into, 12, @intCast(usize, facts.*.device))
    put32(into, 16, @intCast(usize, facts.*.revision))
    put32(into, 20, @intCast(usize, facts.*.pci))
    put32(into, 24, @intCast(usize, facts.*.graphics))
    put32(into, 28, @intCast(usize, facts.*.shaderEngines))
    put32(into, 32, @intCast(usize, facts.*.arraysPerEngine))
    put32(into, 36, @intCast(usize, facts.*.computeUnitsPerArray))
    put32(into, 40, @intCast(usize, facts.*.renderBackendsPerEngine))
    put32(into, 44, @intCast(usize, facts.*.engineClock))
    put32(into, 48, @intCast(usize, facts.*.memoryClock))
    put32(into, 52, @intCast(usize, facts.*.computeRings))
    put32(into, 56, @intCast(usize, facts.*.graphicsRings))
    put32(into, 60, @intCast(usize, facts.*.copyRings))
    put64(into, 64, facts.*.memory)
    put64(into, 72, facts.*.visible)
    put64(into, 80, facts.*.picture)
    put64(into, 88, facts.*.system)
    k = 0
    while k < facts.*.name.length && k < 31 {
        into[96 + k] = facts.*.name[k]
        k += 1
    }
    put32(into, 128, @intCast(usize, facts.*.why))
}

// The bytes of the record from `offset` on into `into`, at most
// `capacity`: how many (0 at its end). A read of a node goes so.
pub fn readAt(facts: *const Facts, offset: usize, into: [*]u8, capacity: usize) -> usize {
    if offset >= RECORD { return 0 }
    var record: [RECORD]u8 = undefined
    encode(facts, &record)
    var count = RECORD - offset
    if count > capacity { count = capacity }
    var k: usize = 0
    while k < count {
        into[k] = record[offset + k]
        k += 1
    }
    return count
}
