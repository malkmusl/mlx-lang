// System calls: Linux's numbers and conventions (rax the number, rdi,
// rsi, rdx, r10, r8, r9 the arguments, rax the result or -errno), the
// part a shell and its programs on a serial terminal need: processes
// (fork, execve, wait4, exit, kill), pipes, the terminal, the archive's
// files, memory, time. Signals other than those that end a process, and
// SIGCHLD for sigtimedwait, are taken and never come.
const cpu = @import("./cpu.mlx")
const console = @import("./console.mlx")
const process = @import("./process.mlx")
const scheduler = @import("./scheduler.mlx")
const wait = @import("./wait.mlx")
const pipe = @import("./pipe.mlx")
const files = @import("./files.mlx")
const vfs = @import("./vfs.mlx")
const FileCalls = @import("./filecalls.mlx").FileCalls
const terminal = @import("./terminal.mlx")
const clock = @import("./clock.mlx")
const Frame = @import("./frame.mlx").Frame
const Bytes = @import("./bytes.mlx").Bytes
const Errno = @import("./errno.mlx").Errno
const Process = process.Process
const NANOSECONDS = clock.Clock.NANOSECONDS

// Linux x86-64's system call numbers (those brixOS answers).
pub const Number = struct {
    pub const READ: usize = 0
    pub const WRITE: usize = 1
    pub const CLOSE: usize = 3
    pub const POLL: usize = 7
    pub const LSEEK: usize = 8
    pub const MMAP: usize = 9
    pub const MPROTECT: usize = 10
    pub const MUNMAP: usize = 11
    pub const BRK: usize = 12
    pub const RT_SIGACTION: usize = 13
    pub const RT_SIGPROCMASK: usize = 14
    pub const IOCTL: usize = 16
    pub const READV: usize = 19
    pub const WRITEV: usize = 20
    pub const PIPE: usize = 22
    pub const SCHED_YIELD: usize = 24
    pub const MADVISE: usize = 28
    pub const DUP: usize = 32
    pub const DUP2: usize = 33
    pub const NANOSLEEP: usize = 35
    pub const GETPID: usize = 39
    pub const CLONE: usize = 56
    pub const FORK: usize = 57
    pub const VFORK: usize = 58
    pub const EXECVE: usize = 59
    pub const EXIT: usize = 60
    pub const WAIT4: usize = 61
    pub const KILL: usize = 62
    pub const UNAME: usize = 63
    pub const FCNTL: usize = 72
    pub const UMASK: usize = 95
    pub const GETTIMEOFDAY: usize = 96
    pub const GETRLIMIT: usize = 97
    pub const GETUID: usize = 102
    pub const GETGID: usize = 104
    pub const SETUID: usize = 105
    pub const SETGID: usize = 106
    pub const GETEUID: usize = 107
    pub const GETEGID: usize = 108
    pub const SETPGID: usize = 109
    pub const GETPPID: usize = 110
    pub const GETPGRP: usize = 111
    pub const SETSID: usize = 112
    pub const GETPGID: usize = 121
    pub const GETSID: usize = 124
    pub const RT_SIGTIMEDWAIT: usize = 128
    pub const RT_SIGSUSPEND: usize = 130
    pub const SIGALTSTACK: usize = 131
    pub const ARCH_PRCTL: usize = 158
    pub const GETTID: usize = 186
    pub const TKILL: usize = 200
    pub const TIME: usize = 201
    pub const SET_TID_ADDRESS: usize = 218
    pub const CLOCK_GETTIME: usize = 228
    pub const CLOCK_GETRES: usize = 229
    pub const CLOCK_NANOSLEEP: usize = 230
    pub const EXIT_GROUP: usize = 231
    pub const TGKILL: usize = 234
    pub const PPOLL: usize = 271
    pub const SET_ROBUST_LIST: usize = 273
    pub const DUP3: usize = 292
    pub const PIPE2: usize = 293
    pub const PRLIMIT64: usize = 302
    pub const GETXATTR: usize = 191
    pub const LGETXATTR: usize = 192
    pub const FGETXATTR: usize = 193
    pub const LISTXATTR: usize = 194
    pub const LLISTXATTR: usize = 195
    pub const FLISTXATTR: usize = 196
    pub const SPLICE: usize = 275
    pub const COPY_FILE_RANGE: usize = 326
    pub const SENDFILE: usize = 40
    pub const GETRANDOM: usize = 318
    pub const RSEQ: usize = 334
    pub const CLONE3: usize = 435
    pub const LIMIT: usize = 512
}

// What became of a system call besides its result.
pub const OutcomeKind = enum(u8) {
    // The result is in rax; the process goes on.
    done,
    // The process waits (for `waiting`) and makes the call again.
    blocked,
    // The process lets another run first (sched_yield).
    yielded,
    // The process exited (`status`, a wait status).
    exited,
    // The process ended by a signal during the call (it is a zombie now).
    ended,
    // execve: the frame holds the new program's start.
    replaced
}

pub const Outcome = struct {
    kind: OutcomeKind
    waiting: wait.Wait
    status: usize
}

// The arguments of a call, in order.
const Arguments = struct {
    a1: usize
    a2: usize
    a3: usize
    a4: usize
    a5: usize
    a6: usize

    fn of(frame: *const Frame) -> Arguments { return Arguments.{ .a1 = frame.*.rdi, .a2 = frame.*.rsi, .a3 = frame.*.rdx, .a4 = frame.*.r10, .a5 = frame.*.r8, .a6 = frame.*.r9 } }

    fn fd(self: Self) -> isize { return @bitCast(isize, self.a1) }
}

// A xorshift generator for getrandom and AT_RANDOM (not for secrets).
pub const Random = struct {
    state: usize

    pub fn next(self: *Self) -> usize {
        self.*.state ^= self.*.state << 13
        self.*.state ^= self.*.state >> 7
        self.*.state ^= self.*.state << 17
        return self.*.state
    }
}

pub const System = struct {
    const MAP_FIXED: usize = 0x10
    const MAP_ANONYMOUS: usize = 0x20
    const MAP_FIXED_NOREPLACE: usize = 0x100000
    const ARCH_SET_FS: usize = 0x1002
    const POLLIN: usize = 1
    const POLLOUT: usize = 4
    const POLLNVAL: usize = 0x20
    const F_DUPFD: usize = 0
    const F_GETFD: usize = 1
    const F_SETFD: usize = 2
    const F_GETFL: usize = 3
    const F_SETFL: usize = 4
    const F_DUPFD_CLOEXEC: usize = 1030
    const TCGETS: usize = 0x5401
    const TCSETS: usize = 0x5402
    const TCSETSW: usize = 0x5403
    const TCSETSF: usize = 0x5404
    const TIOCSCTTY: usize = 0x540E
    const TIOCGPGRP: usize = 0x540F
    const TIOCSPGRP: usize = 0x5410
    const TIOCGWINSZ: usize = 0x5413
    const TIOCSWINSZ: usize = 0x5414
    const FIONBIO: usize = 0x5421
    const TIOCGSID: usize = 0x5429
    const ROWS: usize = 24
    const COLUMNS: usize = 80

    const WNOHANG: usize = 1
    const CLONE_THREAD: usize = 0x10000
    const SIGINFO_SIZE: usize = 128

    random: Random
    unknownSeen: [Number.LIMIT]bool
    // The call in progress: what became of it, and whether the wait it
    // made before ended by its deadline.
    outcome: Outcome
    timedOut: bool

    pub fn init(self: *Self) -> void {
        Bytes.fill(unsafe { @ptrCast([*]u8, &self.*.unknownSeen) }, Number.LIMIT, 0)
        self.*.random = Random.{ .state = cpu.Cpu.timestamp() | 1 }
    }

    // The call in `frame` for `p`: its result in rax, unless the program
    // ended (the outcome says).
    pub fn handle(self: *Self, frame: *Frame, p: *Process) -> Outcome {
        const number = frame.*.rax
        self.*.outcome = Outcome.{ .kind = OutcomeKind.done, .waiting = wait.Wait.none(), .status = 0 }
        self.*.timedOut = p.*.timedOut
        p.*.timedOut = false
        if number == Number.EXIT || number == Number.EXIT_GROUP {
            self.*.outcome.kind = OutcomeKind.exited
            self.*.outcome.status = scheduler.Status.exited(frame.*.rdi)
            return self.*.outcome
        }
        const result = self.call(p, frame, number, Arguments.of(frame))
        // Ctrl-C typed while the terminal was read.
        if terminal.serialConsole().takeInterrupt() { scheduler.processes().interruptForeground() }
        if p.*.state == process.State.zombie || p.*.state == process.State.free {
            self.*.outcome.kind = OutcomeKind.ended
            return self.*.outcome
        }
        if result == wait.BLOCKED && self.*.outcome.kind == OutcomeKind.done { self.*.outcome.kind = OutcomeKind.blocked }
        if self.*.outcome.kind == OutcomeKind.done { frame.*.rax = @bitCast(usize, result) }
        if self.*.outcome.kind == OutcomeKind.yielded { frame.*.rax = 0 }
        return self.*.outcome
    }

    // The call waits for `w` (it is made again when that holds).
    fn block(self: *Self, w: wait.Wait) -> isize {
        self.*.outcome.kind = OutcomeKind.blocked
        self.*.outcome.waiting = w
        return wait.BLOCKED
    }

    fn deadlineAfter(nanoseconds: isize) -> usize {
        if nanoseconds < 0 { return 0 }
        return clock.system().monotonic() + @bitCast(usize, nanoseconds)
    }

    fn call(self: *Self, p: *Process, frame: *Frame, number: usize, a: Arguments) -> isize {
        if FileCalls.handles(number) { return FileCalls.call(p, number, a.a1, a.a2, a.a3, a.a4, a.a5) }
        const fd = a.fd()
        if number == Number.READ {
            if !p.prepare(a.a2, a.a3) { return Errno.EFAULT }
            return p.*.files.read(fd, Bytes.pointer(a.a2), a.a3, &self.*.outcome.waiting)
        }
        if number == Number.WRITE {
            if !p.prepare(a.a2, a.a3) { return Errno.EFAULT }
            return p.*.files.write(fd, Bytes.pointer(a.a2), a.a3, &self.*.outcome.waiting)
        }
        if number == Number.CLOSE { return p.*.files.close(fd) }
        if number == Number.POLL { return self.poll(p, a.a1, a.a2, if @bitCast(isize, a.a3) < 0 { -1 } else { @bitCast(isize, a.a3 * 1000000) }) }
        if number == Number.PPOLL { return self.poll(p, a.a1, a.a2, timespec(p, a.a3)) }
        if number == Number.LSEEK { return p.*.files.seek(fd, @bitCast(isize, a.a2), a.a3) }
        if number == Number.MMAP {
            if a.a4 & MAP_ANONYMOUS == 0 { return Errno.ENODEV }
            return p.mmap(a.a1, a.a2, a.a4 & (MAP_FIXED | MAP_FIXED_NOREPLACE) != 0)
        }
        if number == Number.MPROTECT || number == Number.MADVISE { return 0 }
        if number == Number.MUNMAP { return p.munmap(a.a1, a.a2) }
        if number == Number.BRK { return @bitCast(isize, p.brk(a.a1)) }
        if number == Number.RT_SIGACTION { return zeroOut(p, a.a3, 32) }
        if number == Number.RT_SIGPROCMASK { return zeroOut(p, a.a3, 8) }
        if number == Number.IOCTL { return ioctl(p, fd, a.a2, a.a3) }
        if number == Number.READV { return self.vector(p, fd, a.a2, a.a3, true) }
        if number == Number.WRITEV { return self.vector(p, fd, a.a2, a.a3, false) }
        if number == Number.SCHED_YIELD {
            self.*.outcome.kind = OutcomeKind.yielded
            return 0
        }
        if number == Number.DUP { return p.*.files.duplicate(fd, 0, false) }
        if number == Number.DUP2 { return p.*.files.duplicateTo(fd, @bitCast(isize, a.a2)) }
        if number == Number.DUP3 {
            if fd == @bitCast(isize, a.a2) { return Errno.EINVAL }
            return p.*.files.duplicateTo(fd, @bitCast(isize, a.a2))
        }
        if number == Number.NANOSLEEP || number == Number.CLOCK_NANOSLEEP {
            if self.*.timedOut { return 0 }
            const nanoseconds = timespec(p, if number == Number.NANOSLEEP { a.a1 } else { a.a3 })
            if nanoseconds <= 0 { return 0 }
            return self.block(wait.Wait.on(wait.WaitKind.sleep, 0, deadlineAfter(nanoseconds)))
        }
        if number == Number.GETPID || number == Number.GETTID { return @intCast(isize, p.*.pid) }
        if number == Number.GETPPID { return @intCast(isize, p.*.parentPid) }
        if number == Number.GETPGRP { return @intCast(isize, p.*.group) }
        if number == Number.GETPGID { return groupOf(p, a.a1) }
        if number == Number.SETPGID { return setGroup(p, a.a1, a.a2) }
        if number == Number.SETSID {
            p.*.group = p.*.pid
            return @intCast(isize, p.*.pid)
        }
        if number == Number.GETSID { return @intCast(isize, scheduler.Scheduler.FIRST_PID) }
        if number == Number.GETUID || number == Number.GETGID || number == Number.GETEUID || number == Number.GETEGID { return 0 }
        if number == Number.SETUID || number == Number.SETGID { return 0 }
        if number == Number.UMASK {
            const old = p.*.umask
            p.*.umask = a.a1 & 0x1FF
            return @intCast(isize, old)
        }
        if number == Number.FORK || number == Number.VFORK { return fork(frame) }
        if number == Number.CLONE {
            // A fork by clone (SIGCHLD, maybe CLONE_VM | CLONE_VFORK); no
            // threads yet.
            if a.a1 & CLONE_THREAD != 0 || a.a1 & 255 != scheduler.Signal.CHLD { return Errno.ENOSYS }
            return fork(frame)
        }
        // (clone3 is tried first by some programs; they fall back to clone.)
        if number == Number.CLONE3 { return Errno.ENOSYS }
        if number == Number.EXECVE { return self.execute(p, frame, a.a1, a.a2, a.a3) }
        if number == Number.PIPE || number == Number.PIPE2 { return makePipe(p, a.a1, if number == Number.PIPE2 { a.a2 } else { 0 }) }
        if number == Number.WAIT4 { return self.waitChild(p, @bitCast(isize, a.a1), a.a2, a.a3) }
        if number == Number.KILL { return scheduler.processes().signal(p, @bitCast(isize, a.a1), a.a2) }
        if number == Number.TKILL { return scheduler.processes().signal(p, @bitCast(isize, a.a1), a.a2) }
        if number == Number.TGKILL { return scheduler.processes().signal(p, @bitCast(isize, a.a2), a.a3) }
        if number == Number.UNAME { return uname(p, a.a1) }
        if number == Number.FCNTL { return fcntl(p, fd, a.a2, a.a3) }
        if number == Number.GETTIMEOFDAY {
            if a.a1 == 0 { return 0 }
            if !p.prepare(a.a1, 16) { return Errno.EFAULT }
            const now = clock.system().realtime()
            Bytes.write64(Bytes.pointer(a.a1), 0, now / NANOSECONDS)
            Bytes.write64(Bytes.pointer(a.a1), 8, now % NANOSECONDS / 1000)
            return 0
        }
        if number == Number.GETRLIMIT { return limits(p, a.a2) }
        if number == Number.PRLIMIT64 { return limits(p, a.a4) }
        if number == Number.RT_SIGTIMEDWAIT { return self.takeSignal(p, a.a1, a.a2, a.a3) }
        if number == Number.RT_SIGSUSPEND { return Errno.EINTR }
        if number == Number.SIGALTSTACK || number == Number.SET_ROBUST_LIST || number == Number.RSEQ { return 0 }
        if number == Number.SET_TID_ADDRESS { return 1 }
        if number == Number.ARCH_PRCTL {
            if a.a1 != ARCH_SET_FS { return Errno.EINVAL }
            p.*.fsBase = a.a2
            cpu.Msr.write(cpu.Msr.FS_BASE, a.a2)
            return 0
        }
        if number == Number.TIME {
            const seconds = clock.system().realtime() / NANOSECONDS
            if a.a1 != 0 && p.prepare(a.a1, 8) { Bytes.write64(Bytes.pointer(a.a1), 0, seconds) }
            return @bitCast(isize, seconds)
        }
        if number == Number.CLOCK_GETTIME { return clockTime(p, a.a1, a.a2) }
        if number == Number.CLOCK_GETRES {
            if a.a2 != 0 && p.prepare(a.a2, 16) {
                Bytes.write64(Bytes.pointer(a.a2), 0, 0)
                Bytes.write64(Bytes.pointer(a.a2), 8, 1)
            }
            return 0
        }
        if number == Number.GETRANDOM { return self.randomBytes(p, a.a1, a.a2) }
        // No extended attributes (EOPNOTSUPP).
        if number >= Number.GETXATTR && number <= Number.FLISTXATTR { return -95 }
        // Copies inside the kernel: the program copies by read and write.
        if number == Number.SPLICE || number == Number.COPY_FILE_RANGE || number == Number.SENDFILE { return Errno.EINVAL }
        self.sayUnknown(number)
        return Errno.ENOSYS
    }

    // A call brixOS lacks, said once on the console.
    fn sayUnknown(self: *Self, number: usize) -> void {
        if number >= Number.LIMIT || self.*.unknownSeen[number] { return }
        self.*.unknownSeen[number] = true
        console.out.write("[brixOS: system call ")
        console.out.decimal(number)
        console.out.write(" not there]\n")
    }

    // ---- processes ----

    fn fork(frame: *Frame) -> isize {
        const pid = scheduler.processes().fork(frame)
        if pid == 0 { return Errno.ENOMEM }
        return @intCast(isize, pid)
    }

    // A NULL-terminated array of string pointers in the process's memory
    // (argv, envp), checked; its count is MAX_STRINGS + 1 when it is not
    // the process's or too long.
    fn strings(p: *Process, address: usize) -> process.Strings {
        const bad = process.Strings.{ .items = unsafe { @ptrFromInt([*]const [*]const u8, 8) }, .count = Process.MAX_STRINGS + 1 }
        if address == 0 { return process.Strings.{ .items = unsafe { @ptrFromInt([*]const [*]const u8, 8) }, .count = 0 } }
        var count: usize = 0
        while true {
            if count > Process.MAX_STRINGS || !p.prepare(address + count * 8, 8) { return bad }
            const item = Bytes.read64(Bytes.pointer(address + count * 8), 0)
            if item == 0 { break }
            if !p.prepareString(item) { return bad }
            count += 1
        }
        return process.Strings.{ .items = unsafe { @ptrFromInt([*]const [*]const u8, address) }, .count = count }
    }

    // execve: the archive's program `path` replaces the process's (its
    // descriptors stay, but those marked close-on-exec).
    fn execute(self: *Self, p: *Process, frame: *Frame, path: usize, argv: usize, envp: usize) -> isize {
        const E2BIG: isize = -7
        const found = FileCalls.resolve(p, -100, path)
        if found < 0 { return found }
        const tree = vfs.fileSystem()
        const program = tree.node(@bitCast(usize, found))
        if program.isDirectory() { return Errno.EACCES }
        if !program.isRegular() { return Errno.EACCES }
        // The directory that names it, for /proc/self/exe.
        var name: []const u8 = undefined
        const directory = if FileCalls.isSelfExePath(p, path) { @intCast(isize, p.*.programDirectory) } else { FileCalls.parentOf(p, path, &name) }
        const arguments = strings(p, argv)
        const environment = strings(p, envp)
        if arguments.count > Process.MAX_STRINGS || environment.count > Process.MAX_STRINGS { return E2BIG }
        const loaded = p.load(@bitCast(usize, found), arguments, environment)
        if loaded == process.Loaded.missing { return Errno.ENOENT }
        if loaded == process.Loaded.not_a_program { return Errno.ENOEXEC }
        if loaded == process.Loaded.no_memory { return Errno.ENOMEM }
        p.*.files.closeOnExec()
        p.setProgram(@bitCast(usize, found), if directory < 0 { vfs.Vfs.NONE } else { @bitCast(usize, directory) })
        p.*.fsBase = 0
        cpu.Msr.write(cpu.Msr.FS_BASE, 0)
        frame.startAt(p.*.entry, p.*.stack)
        self.*.outcome.kind = OutcomeKind.replaced
        return 0
    }

    // wait4: a child that ended (its pid, its status written), 0 with
    // WNOHANG when none did yet, ECHILD when there is none to wait for;
    // else it waits.
    fn waitChild(self: *Self, p: *Process, pid: isize, statusAddress: usize, options: usize) -> isize {
        const table = scheduler.processes()
        const ended = table.child(p, pid)
        if ended != null {
            if statusAddress != 0 {
                if !p.prepare(statusAddress, 4) { return Errno.EFAULT }
                Bytes.write32(Bytes.pointer(statusAddress), 0, ended.?.*.status)
            }
            const found = ended.?.*.pid
            ended.?.*.state = process.State.free
            return @intCast(isize, found)
        }
        if !table.hasChild(p, pid) { return Errno.ECHILD }
        if options & WNOHANG != 0 { return 0 }
        return self.block(wait.Wait.on(wait.WaitKind.child, pid, 0))
    }

    // rt_sigtimedwait: SIGCHLD when a child ended since it was last taken
    // (the only signal that comes); EAGAIN when the timeout passes.
    fn takeSignal(self: *Self, p: *Process, setAddress: usize, infoAddress: usize, timeoutAddress: usize) -> isize {
        if !p.prepare(setAddress, 8) { return Errno.EFAULT }
        const set = Bytes.read64(Bytes.pointer(setAddress), 0)
        const one: usize = 1
        const chld = one << @intCast(u6, scheduler.Signal.CHLD - 1)
        if set & chld != 0 && p.*.childSignal {
            p.*.childSignal = false
            if infoAddress != 0 {
                if !p.prepare(infoAddress, SIGINFO_SIZE) { return Errno.EFAULT }
                Bytes.fill(Bytes.pointer(infoAddress), SIGINFO_SIZE, 0)
                Bytes.write32(Bytes.pointer(infoAddress), 0, scheduler.Signal.CHLD)
            }
            return @intCast(isize, scheduler.Signal.CHLD)
        }
        if self.*.timedOut { return Errno.EAGAIN }
        const nanoseconds = timespec(p, timeoutAddress)
        if nanoseconds == 0 { return Errno.EAGAIN }
        return self.block(wait.Wait.on(wait.WaitKind.signal, 0, deadlineAfter(nanoseconds)))
    }

    fn groupOf(p: *Process, pid: usize) -> isize {
        if pid == 0 || pid == p.*.pid { return @intCast(isize, p.*.group) }
        const other = scheduler.processes().find(pid)
        if other == null { return Errno.ESRCH }
        return @intCast(isize, other.?.*.group)
    }

    fn setGroup(p: *Process, pid: usize, group: usize) -> isize {
        var target = p
        if pid != 0 && pid != p.*.pid {
            const other = scheduler.processes().find(pid)
            if other == null { return Errno.ESRCH }
            target = other.?
        }
        target.*.group = if group == 0 { target.*.pid } else { group }
        return 0
    }

    fn makePipe(p: *Process, address: usize, flags: usize) -> isize {
        if !p.prepare(address, 8) { return Errno.EFAULT }
        var ends = [2]isize{ 0, 0 }
        const result = p.*.files.pipe(&ends, flags)
        if result < 0 { return result }
        Bytes.write32(Bytes.pointer(address), 0, @bitCast(usize, ends[0]))
        Bytes.write32(Bytes.pointer(address), 4, @bitCast(usize, ends[1]))
        return 0
    }

    fn randomBytes(self: *Self, p: *Process, address: usize, length: usize) -> isize {
        if !p.prepare(address, length) { return Errno.EFAULT }
        const into = Bytes.pointer(address)
        var k: usize = 0
        while k < length {
            into[k] = @intCast(u8, (self.*.random.next() >> 24) & 255)
            k += 1
        }
        return @bitCast(isize, length)
    }

    fn zeroOut(p: *Process, address: usize, length: usize) -> isize {
        if address == 0 { return 0 }
        if !p.prepare(address, length) { return Errno.EFAULT }
        Bytes.fill(Bytes.pointer(address), length, 0)
        return 0
    }

    // A struct timespec as nanoseconds; -1 for none (wait forever).
    fn timespec(p: *Process, address: usize) -> isize {
        if address == 0 { return -1 }
        if !p.prepare(address, 16) { return 0 }
        const at = Bytes.pointer(address)
        return @bitCast(isize, Bytes.read64(at, 0) * NANOSECONDS + Bytes.read64(at, 8))
    }

    // poll's struct pollfd array: readiness now, else it waits for the
    // terminal, a pipe or the timeout.
    fn poll(self: *Self, p: *Process, address: usize, count: usize, nanoseconds: isize) -> isize {
        if !p.prepare(address, count * 8) { return Errno.EFAULT }
        var ready: isize = 0
        var k: usize = 0
        while k < count {
            const entry = Bytes.pointer(address + k * 8)
            const fd = @intCast(isize, @bitCast(i32, @intCast(u32, Bytes.read32(entry, 0))))
            const events = Bytes.read16(entry, 4)
            var revents: usize = 0
            if fd >= 0 {
                if p.*.files.kindOf(fd) == files.Kind.none {
                    revents = POLLNVAL
                } else {
                    if events & POLLIN != 0 && p.*.files.readable(fd) { revents |= POLLIN }
                    if events & POLLOUT != 0 && p.*.files.writable(fd) { revents |= POLLOUT }
                }
            }
            Bytes.write16(entry, 6, revents)
            if revents != 0 { ready += 1 }
            k += 1
        }
        if ready > 0 || nanoseconds == 0 || self.*.timedOut { return ready }
        return self.block(wait.Wait.on(wait.WaitKind.poll, @bitCast(isize, pipe.table().*.events), deadlineAfter(nanoseconds)))
    }

    fn uname(p: *Process, address: usize) -> isize {
        const FIELD: usize = 65
        if !p.prepare(address, FIELD * 6) { return Errno.EFAULT }
        Bytes.fill(Bytes.pointer(address), FIELD * 6, 0)
        copyText(address, "brixOS")
        copyText(address + FIELD, "brix")
        copyText(address + FIELD * 2, "0.1")
        copyText(address + FIELD * 3, "#1")
        copyText(address + FIELD * 4, "x86_64")
        return 0
    }

    fn copyText(address: usize, text: []const u8) -> void { Bytes.copy(Bytes.pointer(address), text.pointer, text.length) }

    fn ioctl(p: *Process, fd: isize, request: usize, argument: usize) -> isize {
        if p.*.files.kindOf(fd) == files.Kind.none { return Errno.EBADF }
        const node = p.*.files.nodeOf(fd)
        if node == vfs.Vfs.NONE || vfs.fileSystem().node(node).*.kind != vfs.NodeKind.terminal { return Errno.ENOTTY }
        const tty = terminal.serialConsole()
        if request == TCGETS {
            if !p.prepare(argument, terminal.Terminal.TERMIOS_SIZE) { return Errno.EFAULT }
            tty.getAttributes(Bytes.pointer(argument))
            return 0
        }
        if request == TCSETS || request == TCSETSW || request == TCSETSF {
            if !p.prepare(argument, terminal.Terminal.TERMIOS_SIZE) { return Errno.EFAULT }
            tty.setAttributes(Bytes.pointer(argument))
            return 0
        }
        if request == TIOCGWINSZ {
            if !p.prepare(argument, 8) { return Errno.EFAULT }
            Bytes.write64(Bytes.pointer(argument), 0, ROWS | (COLUMNS << 16))
            return 0
        }
        if request == TIOCGPGRP || request == TIOCGSID {
            if !p.prepare(argument, 4) { return Errno.EFAULT }
            Bytes.write32(Bytes.pointer(argument), 0, if request == TIOCGPGRP { scheduler.processes().*.foreground } else { scheduler.Scheduler.FIRST_PID })
            return 0
        }
        if request == TIOCSPGRP {
            if !p.prepare(argument, 4) { return Errno.EFAULT }
            scheduler.processes().*.foreground = Bytes.read32(Bytes.pointer(argument), 0)
            return 0
        }
        if request == TIOCSCTTY || request == TIOCSWINSZ || request == FIONBIO { return 0 }
        return Errno.EINVAL
    }

    // readv and writev.
    fn vector(self: *Self, p: *Process, fd: isize, address: usize, count: usize, reading: bool) -> isize {
        if !p.prepare(address, count * 16) { return Errno.EFAULT }
        var total: isize = 0
        var k: usize = 0
        while k < count {
            const base = Bytes.read64(Bytes.pointer(address), k * 16)
            const length = Bytes.read64(Bytes.pointer(address), k * 16 + 8)
            if length > 0 {
                if !p.prepare(base, length) { return Errno.EFAULT }
                const done = if reading { p.*.files.read(fd, Bytes.pointer(base), length, &self.*.outcome.waiting) } else { p.*.files.write(fd, Bytes.pointer(base), length, &self.*.outcome.waiting) }
                if done == wait.BLOCKED && total > 0 { return total }
                if done < 0 { return if total > 0 { total } else { done } }
                total += done
                if reading && @bitCast(usize, done) < length { return total }
            }
            k += 1
        }
        return total
    }

    fn fcntl(p: *Process, fd: isize, command: usize, argument: usize) -> isize {
        const slot = p.*.files.get(fd)
        if slot == null { return Errno.EBADF }
        if command == F_DUPFD { return p.*.files.duplicate(fd, argument, false) }
        if command == F_DUPFD_CLOEXEC { return p.*.files.duplicate(fd, argument, true) }
        if command == F_GETFD { return if slot.?.*.closeOnExec { 1 } else { 0 } }
        if command == F_SETFD {
            slot.?.*.closeOnExec = argument & 1 != 0
            return 0
        }
        if command == F_GETFL { return @intCast(isize, slot.?.*.flags) }
        if command == F_SETFL { return 0 }
        return Errno.EINVAL
    }

    fn limits(p: *Process, old: usize) -> isize {
        if old == 0 { return 0 }
        if !p.prepare(old, 16) { return Errno.EFAULT }
        Bytes.fill(Bytes.pointer(old), 16, 0xFF)
        return 0
    }

    fn clockTime(p: *Process, which: usize, address: usize) -> isize {
        const CLOCK_REALTIME: usize = 0
        const CLOCK_REALTIME_COARSE: usize = 5
        const CLOCK_REALTIME_ALARM: usize = 8
        if !p.prepare(address, 16) { return Errno.EFAULT }
        const time = clock.system()
        const now = if which == CLOCK_REALTIME || which == CLOCK_REALTIME_COARSE || which == CLOCK_REALTIME_ALARM { time.realtime() } else { time.monotonic() }
        Bytes.write64(Bytes.pointer(address), 0, now / NANOSECONDS)
        Bytes.write64(Bytes.pointer(address), 8, now % NANOSECONDS)
        return 0
    }
}

var calls: System = undefined // (per run)

pub fn system() -> *System { return &calls }
