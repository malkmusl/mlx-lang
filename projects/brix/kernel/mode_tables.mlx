// The timings a monitor names without writing them out. A monitor's EDID
// writes its own mode as a detailed timing (edid.mlx reads those); the
// other modes it offers it mostly names: a bit of its established
// timings, a two-byte code for a size and a rate (a standard timing), or
// a video code of CTA-861 in an extension block. What such a name means,
// the pixel clock and where the sync pulses lie, is in the standards'
// tables, and these are they (display_modes.mlx looks a name up here).
//
// The numbers are not from memory: the tables are Linux 6.6's
// (drivers/gpu/drm/drm_edid.c), row for row in Linux's order, and
// tools/check_display_modes.py holds every number here against that
// file (and writes the rows out of it: `--print`):
//   DMT            drm_dmt_modes: VESA's monitor timings. A standard
//                  timing's size and rate, and an established timing of
//                  the third kind, is looked up here.
//   ESTABLISHED    edid_est_modes: the base block's established timings,
//                  row k for bit k of the three bytes read as Linux reads
//                  them (byte 35, byte 36 above it, bit 7 of byte 37 as
//                  bit 16).
//   ESTABLISHED_3  est3_modes: the established timings of the third kind
//                  (the descriptor 0xF7, six bytes from its sixth: row k
//                  for bit 7 - k % 8 of byte k / 8), each a size, a rate
//                  and whether it is DMT's timing with reduced blanking.
//   CTA            edid_cea_modes_1: CTA-861's video codes, row k for
//                  code CTA_FIRST + k (1 to 127; the codes from 193 on,
//                  pictures of 5120 pixels across and more, are not
//                  here).
//
// A row of DMT, ESTABLISHED and CTA is ten numbers, as Linux's
// drm_display_mode has them: the pixel clock in kHz; across: the size
// shown, where the sync pulse begins, where it ends, the total; down the
// same four; the flags (Linux's values: the pulses' polarities,
// interlaced, a line's pixels sent twice). For an interlaced row the
// numbers down are the whole frame's (both fields), as Linux keeps them.
//
// Nothing of the kernel's is used here: built for the host too
// (tests/489_display_modes_runtime.mlx).

// A row's numbers, by their place.
pub const ROW: usize = 10
pub const CLOCK: usize = 0
pub const H_SIZE: usize = 1
pub const H_SYNC_START: usize = 2
pub const H_SYNC_END: usize = 3
pub const H_TOTAL: usize = 4
pub const V_SIZE: usize = 5
pub const V_SYNC_START: usize = 6
pub const V_SYNC_END: usize = 7
pub const V_TOTAL: usize = 8
pub const FLAGS: usize = 9

// The flags (include/uapi/drm/drm_mode.h's values): the horizontal sync
// pulse the high one, the low one; the vertical one likewise; an
// interlaced picture; every line shown twice; every pixel sent twice.
pub const PHSYNC: usize = 0x1
pub const NHSYNC: usize = 0x2
pub const PVSYNC: usize = 0x4
pub const NVSYNC: usize = 0x8
pub const INTERLACE: usize = 0x10
pub const DBLSCAN: usize = 0x20
pub const DBLCLK: usize = 0x1000

// The video code of CTA's first row.
pub const CTA_FIRST: usize = 1

// A row of ESTABLISHED_3: the size across and down, the rate in Hz, 1 for
// the timing with reduced blanking.
pub const ROW_3: usize = 4

