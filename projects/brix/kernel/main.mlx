// brixOS's kernel: started by the boot blob (projects/brix/image) in long
// mode, in the higher half, with its arena; the serial console, memory,
// the clock, then flux in user mode.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const serial = @import("./serial.mlx")
const interrupts = @import("./interrupts.mlx")
const console = @import("./console.mlx")
const memory = @import("./memory.mlx")
const clock = @import("./clock.mlx")
const system = @import("./linux/system.mlx")
const scheduler = @import("./scheduler.mlx")
const vfs = @import("./vfs.mlx")
const disk = @import("./disk.mlx")
const pci = @import("./pci.mlx")
const block = @import("./block.mlx")
const volume = @import("./volume.mlx")
const ext2 = @import("./ext2.mlx")
const smp = @import("./smp.mlx")
const power = @import("./power.mlx")
const display = @import("./display.mlx")
const displays = @import("./displays.mlx")
const keyboard = @import("./keyboard.mlx")
const mouse = @import("./mouse.mlx")
const usb = @import("./usb.mlx")
const gpu = @import("./gpu.mlx")
const counters = @import("./counters.mlx")
const netdev = @import("./netdev.mlx")
const stack = @import("./net/stack.mlx")
const settings = @import("./net/settings.mlx")
const dhcp = @import("./net/dhcp.mlx")
const link = @import("./net/link.mlx")
const shell = @import("./shell.mlx")
// brix_trap, which the boot blob calls.
const trap = @import("./trap.mlx")

// How long the boot waits for a network link that is not up yet
// (nanoseconds).
const LINK_WAIT: usize = 500000000

// The system on the disk: its /system, /users and /temporary in the
// memory-only tree's place (the same nodes as /volumes/disk0's), the
// boot archive's /system kept at /volumes/boot. False when the disk
// lacks one of them.
fn bootFromDisk(root: usize) -> bool {
    const tree = vfs.fileSystem()
    const system = tree.lookup(root, "system".pointer, 6)
    const users = tree.lookup(root, "users".pointer, 5)
    const temporary = tree.lookup(root, "temporary".pointer, 9)
    if system == vfs.Vfs.NONE || users == vfs.Vfs.NONE || temporary == vfs.Vfs.NONE { return false }
    const volumes = tree.lookup(vfs.Vfs.ROOT, "volumes".pointer, 7)
    const oldSystem = tree.graft(vfs.Vfs.ROOT, "system", system)
    if oldSystem != vfs.Vfs.NONE { _ = tree.attach(volumes, "boot".pointer, 4, oldSystem) }
    const oldUsers = tree.graft(vfs.Vfs.ROOT, "users", users)
    if oldUsers != vfs.Vfs.NONE { tree.retire(oldUsers) }
    const oldTemporary = tree.graft(vfs.Vfs.ROOT, "temporary", temporary)
    if oldTemporary != vfs.Vfs.NONE { tree.retire(oldTemporary) }
    return true
}

// A short name for a PCI class code (class, subclass, interface).
fn className(code: usize) -> []const u8 {
    if code == 0x010601 { return "AHCI" }
    if code == 0x010802 { return "NVMe" }
    if code >> 8 == 0x0106 { return "SATA" }
    if code >> 8 == 0x0101 { return "IDE" }
    if code >> 8 == 0x0200 { return "Ethernet" }
    if code == 0x0C0330 { return "xHCI" }
    if code == 0x0C0320 { return "EHCI" }
    if code == 0x0C0300 { return "UHCI" }
    if code >> 8 == 0x0300 { return "VGA" }
    if code == 0x060000 { return "host bridge" }
    if code == 0x060100 { return "ISA bridge" }
    if code == 0x060400 { return "PCI bridge" }
    if code == 0x0C0500 { return "SMBus" }
    if code == 0x010000 { return "SCSI" }
    return "device"
}

// Every PCI function on every bus, with its vendor, device and class: what
// is actually on the board (virtio in a VM, or AHCI, NVMe, the Intel NIC
// and xHCI on real hardware), the ground the drivers stand on.
fn dumpPci() -> void {
    const Pci = pci.Pci
    const out = console.out
    var bus: usize = 0
    while bus < 256 {
        var slot: usize = 0
        while slot < 32 {
            var function: usize = 0
            while function < 8 {
                const address = Pci.atBus(bus, slot, function)
                const id = Pci.read(address, Pci.VENDOR_DEVICE)
                if id & 0xFFFF != 0xFFFF {
                    const code = Pci.classCode(address)
                    out.write("pci: ")
                    out.hexByte(bus)
                    out.write(":")
                    out.hexByte(slot)
                    out.write(".")
                    out.decimal(function)
                    out.write(" ")
                    out.hex(id & 0xFFFF)
                    out.write(":")
                    out.hex(id >> 16)
                    out.write(" ")
                    out.hex(code)
                    out.write(" ")
                    out.write(className(code))
                    out.write("\n")
                }
                if function == 0 && (id & 0xFFFF == 0xFFFF || Pci.read(address, Pci.HEADER_TYPE) & 0x800000 == 0) { break }
                function += 1
            }
            slot += 1
        }
        bus += 1
    }
}

// Four hex digits (a PCI vendor or device).
fn hexWord(value: usize) -> void {
    console.out.hexByte((value >> 8) & 0xFF)
    console.out.hexByte(value & 0xFF)
}

// Whose mode the loader set on a display instead of the firmware's, when
// it set one (after `prefix`, a line).
fn sayLoader(shown: *const display.Display, prefix: []const u8) -> void {
    const out = console.out
    const by = shown.*.modeBy
    if by == 0 { return }
    out.write(prefix)
    out.write("the loader set this mode, ")
    out.write(if by == layout.Info.MODE_IMAGE { "the one the image names (settings/display)" } else if by == layout.Info.MODE_MONITOR { "the monitor's own" } else if by == layout.Info.MODE_NEAR_IMAGE { "the nearest the firmware has to the one the image names" } else { "the nearest the firmware has to the monitor's own" })
    out.write("; the firmware's was ")
    out.decimal(shown.*.firmwareWidth)
    out.write("x")
    out.decimal(shown.*.firmwareHeight)
    out.write("\n")
}

// The displays, a line each: which is which (its number, its size, where
// its memory is and which PCI adapter's memory that is, its node for
// programs), and which is the main one and why; before them what the
// firmware offered that is no display of its own. A machine with a
// monitor on each of two adapters is told apart by these lines.
fn sayDisplays() -> void {
    const out = console.out
    const found = display.list()
    if found.*.outputs > 1 || found.*.unusable != 0 || found.*.beyond != 0 || found.*.dropped != 0 {
        out.write("brixOS: the firmware offers ")
        out.decimal(found.*.outputs)
        out.write(" graphics outputs: ")
        out.decimal(display.count())
        out.write(if display.count() == 1 { " display" } else { " displays" })
        if found.*.unusable != 0 {
            out.write(", ")
            out.decimal(found.*.unusable)
            out.write(" without pixels the kernel can use (passed over)")
        }
        if found.*.beyond != 0 {
            out.write(", ")
            out.decimal(found.*.beyond)
            out.write(" more than there is room for (left as they are)")
        }
        if found.*.dropped != 0 {
            out.write(", ")
            out.decimal(found.*.dropped)
            out.write(" whose record is no picture's (left out)")
        }
        out.write("\n")
    }
    const wanted = display.named()
    if wanted.*.kind == displays.Named.UNREADABLE {
        out.write("brixOS: settings/display's line \"main\" names no display (a number, or a PCI vendor and device as 1002:67df): the rule decides\n")
    } else if display.namedMissing() {
        out.write("brixOS: settings/display names a main display that is not there: the rule decides\n")
    }
    var k: usize = 0
    while k < display.count() {
        const shown = display.at(k)
        out.write("brixOS: display ")
        out.decimal(k)
        out.write(": ")
        out.decimal(shown.*.width)
        out.write("x")
        out.decimal(shown.*.height)
        out.write(" at ")
        out.hex(shown.*.address)
        if shown.*.adapter != pci.Pci.NONE {
            out.write(", PCI ")
            out.hexByte((shown.*.adapter >> 16) & 0xFF)
            out.write(":")
            out.hexByte((shown.*.adapter >> 11) & 0x1F)
            out.write(".")
            out.decimal((shown.*.adapter >> 8) & 7)
            out.write(" ")
            hexWord(shown.*.vendor)
            out.write(":")
            hexWord(shown.*.device)
        } else {
            out.write(", no PCI display adapter's memory")
        }
        // (What its monitor says its own mode is, when the firmware
        // passed that on: the rule for the main display goes by it.)
        if shown.*.monitorWidth != 0 && shown.*.monitorHeight != 0 {
            out.write(", its monitor says ")
            out.decimal(shown.*.monitorWidth)
            out.write("x")
            out.decimal(shown.*.monitorHeight)
        }
        out.write(", /devices/")
        out.write(shown.nodeName())
        if k == display.screen().*.number {
            out.write(", the main display (")
            out.write(displays.reason(display.chosenBy()))
            out.write(")")
        }
        out.write("\n")
        // (A further display's own lines: the main one's are above.)
        if k != display.screen().*.number && shown.*.firmware {
            var prefix: [32]u8 = undefined
            const text = "brixOS: display N: "
            var c: usize = 0
            while c < text.length {
                prefix[c] = if text[c] == 78 { @intCast(u8, 48 + k % 10) } else { text[c] }
                c += 1
            }
            const bytes: [*]const u8 = &prefix
            sayLoader(shown, bytes[0..text.length])
            if shown.*.monitorWidth != 0 && shown.*.monitorHeight != 0 && (shown.*.monitorWidth != shown.*.width || shown.*.monitorHeight != shown.*.height) {
                out.write(bytes[0..text.length])
                out.write("its monitor's own mode is ")
                out.decimal(shown.*.monitorWidth)
                out.write("x")
                out.decimal(shown.*.monitorHeight)
                out.write(", which was not set\n")
            }
            if shown.*.refused != 0 {
                out.write(bytes[0..text.length])
                out.write("the firmware refused the mode the loader asked for (status ")
                out.hex(shown.*.refused)
                out.write(")\n")
            }
        }
        k += 1
    }
}

pub fn main() -> u8 {
    smp.lock(0)
    serial.com1.init()
    const out = console.out
    out.write("brixOS: kernel at ")
    out.hex(cpu.BootInfo.get(layout.Info.KERNEL_PHYS))
    out.write(", ")
    out.decimal(cpu.BootInfo.get(layout.Info.KERNEL_SIZE) / 1024)
    out.write(" KiB\n")
    // The displays (the firmware's, or the Bochs adapter set up here) and
    // the keyboard, before the file system names them.
    if display.find() {
        const shown = display.screen()
        out.write("brixOS: display ")
        out.decimal(shown.*.width)
        out.write("x")
        out.decimal(shown.*.height)
        out.write(" pitch ")
        out.decimal(shown.*.pitch)
        out.write(" format ")
        out.decimal(shown.*.format)
        out.write(" at ")
        out.hex(shown.*.address)
        out.write(if shown.*.firmware { " (the firmware's)\n" } else { " (Bochs VBE)\n" })
        // What the EFI loader found and did, for the log: the mode the
        // firmware was in and whose mode the loader set instead; what the
        // monitor of this display says its own mode is (its EDID; the
        // loader sets it when the firmware has such a mode and it is no
        // smaller picture). When the
        // picture is not the monitor's own mode, it is one the monitor
        // stretches to its shape: said, with the way to ask for a mode by
        // name. These lines are the main display's (the one above); the
        // others' are with the list of the displays below.
        if shown.*.firmware {
            sayLoader(shown, "brixOS: ")
            const wide = shown.*.monitorWidth
            const high = shown.*.monitorHeight
            if wide == 0 || high == 0 {
                out.write("brixOS: this display's monitor does not say its own mode (no EDID from the firmware)\n")
            } else if wide != shown.*.width || high != shown.*.height {
                out.write("brixOS: the monitor's own mode is ")
                out.decimal(wide)
                out.write("x")
                out.decimal(high)
                out.write(", which was not set (the firmware lacks it, or it is a smaller picture; settings/display in the image names a mode to try)\n")
            }
            // The screen's shape where the picture is of another (the
            // monitor stretches it): /devices/framebuffer says it, and a
            // program that draws for it is round on the screen.
            if shown.*.shapeWidth * shown.*.height != shown.*.shapeHeight * shown.*.width {
                out.write("brixOS: the picture is shown on a screen of the shape ")
                out.decimal(shown.*.shapeWidth)
                out.write(":")
                out.decimal(shown.*.shapeHeight)
                // (Whose word it is: the monitor's when the shape is its
                // mode's; one the kernel did not take as a shape leaves
                // the image's.)
                out.write(if shown.*.shapeWidth == wide && shown.*.shapeHeight == high { " (the monitor's own mode)" } else { " (the mode the image names)" })
                out.write("; /devices/framebuffer says so to the programs that draw for it\n")
            }
            if shown.*.refused != 0 {
                out.write("brixOS: the firmware refused the mode the loader asked for (status ")
                out.hex(shown.*.refused)
                out.write(")\n")
            }
            // (The firmware's modes: what a monitor's own mode, or one
            // named, is chosen from. The loader lists the first
            // display's.)
            const modes = cpu.BootInfo.get(layout.Info.MODES)
            if modes != 0 && shown.*.first {
                out.write("brixOS: the firmware's modes:")
                var k: usize = 0
                while k < modes && k < layout.Info.MODE_ROOM {
                    const mode = cpu.BootInfo.get(layout.Info.MODE_LIST + k * 8)
                    out.write(" ")
                    out.decimal(mode >> 32)
                    out.write("x")
                    out.decimal(mode & 0xFFFFFFFF)
                    k += 1
                }
                out.write("\n")
            }
        }
        sayDisplays()
    }
    keyboard.ps2().init()
    mouse.aux().init()
    // The timer, the serial line's and the keyboard's interrupts, above
    // the processor's exceptions (they come once user mode runs: the
    // kernel keeps them off).
    interrupts.Irq.init()
    memory.allFrames().init()
    // The framebuffer console: the boot log on screen (replayed from the log
    // buffer, then live) for a machine with no serial line. A graphical
    // program taking the framebuffer turns it off (fbcon); in an image with
    // no graphical session it stays on screen to read or photograph.
    memory.Device.attributes()
    _ = console.enableFramebuffer()
    counters.init()
    clock.system().calibrate()
    system.system().init()
    if @sizeOf(vfs.Node) > vfs.NODE_SIZE {
        out.write("brixOS: a node does not fit its chunk\n")
        return 1
    }
    vfs.fileSystem().init()
    // The disks and their partitions: /devices/NAME (diskN, diskNpM),
    // each one's volume at /volumes/NAME (brixfs, or ext2 read-only); the
    // first with a system on it is the system.
    // (The full PCI listing, dumpPci(), is left out here: it is only a
    // diagnostic dump, and each driver reports the device it claims; a
    // marker makes the point it reaches visible on the framebuffer console.)
    out.write("brixOS: probing storage\n")
    disk.probeAll()
    block.probe()
    var which: usize = 0
    var booted = false
    while which < block.count() {
        const b = block.at(which)
        const name = b.nameText()
        vfs.fileSystem().addDisk(name, which, b.*.size)
        if b.*.whole {
            const d = disk.at(b.*.disk)
            out.write("brixOS: /devices/")
            out.write(name)
            out.write(", ")
            out.decimal(d.sizeInBytes() / 1024)
            out.write(" KiB (")
            out.write(d.driver())
            if b.*.partitioned { out.write(", partitioned") }
            out.write(")")
            out.write(if d.readOnly() { ", read-only\n" } else { "\n" })
        } else {
            out.write("brixOS: /devices/")
            out.write(name)
            out.write(", ")
            out.decimal(b.*.size / 1024)
            out.write(" KiB (a partition)\n")
        }
        const store = volume.storeAt(which)
        if b.*.whole && b.*.partitioned {
            // (The partitions' volumes, not the disk's.)
        } else if store.mount(which) {
            out.write("brixOS: /volumes/")
            out.write(name)
            out.write(" (brixfs, generation ")
            out.decimal(store.*.superblock.generation)
            out.write(")\n")
            if !booted && store.hasSystem() && bootFromDisk(store.rootNode()) {
                booted = true
                out.write("brixOS: / from /volumes/")
                out.write(name)
                out.write(" (the boot archive at /volumes/boot)\n")
            }
        } else if ext2.volumeAt(which).mount(which) {
            out.write("brixOS: /volumes/")
            out.write(name)
            out.write(" (ext2, read-only)\n")
        }
        which += 1
    }
    // The network: /devices/net0 (virtio in a VM, an Intel igb NIC on real
    // hardware; a read of the node gives the link's state, net/link.mlx),
    // the stack on it with the settings' addresses or DHCP's (none until
    // then); resolv.conf for programs that look names up. Without a
    // device the stack is there all the same: the machine reaches itself
    // (127.0.0.0/8).
    out.write("brixOS: probing network\n")
    if netdev.probe() {
        out.write("brixOS: /devices/net0, ")
        stack.writeMac(netdev.mac(), out)
        out.write(" (")
        out.write(netdev.driver())
        if netdev.irq() != netdev.NO_IRQ {
            out.write(", IRQ ")
            out.decimal(netdev.irq())
        } else if netdev.signalled() {
            out.write(", message-signalled")
        } else {
            out.write(", polled")
        }
        out.write(")\n")
        vfs.fileSystem().addNetworkLink("net0", link.RECORD)
    }
    stack.init()
    if stack.configuration().*.up {
        // A link that is still coming up is waited for, half a second at
        // most (a card started a moment ago is agreeing with its partner
        // at the cable's other end: QEMU's igb takes a third of a second),
        // so that DHCP's first question and the first programs find it
        // up. Without the wait a ping typed at the first prompt said once
        // that the link is down, and a connection asked in that moment
        // was refused. A machine whose cable is out boots that half
        // second later when its address is fixed; one that asks DHCP
        // waited as long for an answer before, and waits for the link in
        // its place now. A link that takes longer is said when it comes
        // (stack.tick looks, here and on every tick of the timer later).
        // Then the link's line in the log, as it is.
        const linked = netdev.linked()
        const linkUntil = clock.system().monotonic() + LINK_WAIT
        const mark = smp.arenaMark()
        while !netdev.linked() && clock.system().monotonic() < linkUntil {
            smp.arenaRelease(mark)
            stack.tick()
        }
        if netdev.linked() == linked { stack.sayLink() }
        // A static configuration from the settings, else DHCP (waited for
        // up to half a second here while its question can go; later
        // answers still count).
        if !settings.read() {
            dhcp.start()
            const until = clock.system().monotonic() + 500000000
            while netdev.linked() && !dhcp.bound() && dhcp.running() && clock.system().monotonic() < until {
                stack.poll()
                stack.tick()
            }
        }
        settings.writeResolvConf()
        if stack.configured() {
            stack.say()
        } else {
            // (DHCP has not answered yet: the stack has no address, and
            // the link's record says none. DHCP goes on asking; when it
            // is answered, the same line as above says so then.)
            out.write("brixOS: net0 has no address yet (DHCP is asking)\n")
        }
        dhcp.announce()
    }
    // USB: an xHCI controller's keyboards and mice (real hardware has no
    // PS/2 i8042), enumerated at boot and polled on the timer tick.
    out.write("brixOS: probing usb\n")
    _ = usb.probe()
    // The GPU: an AMD Radeon found, its apertures recorded and its display
    // controller read (the first steps of a native amdgpu driver). The
    // monitor's own mode is set here only when the image asks for it
    // (settings/gpu); the display then is another picture from here on.
    // That comes this late on purpose: the console is on the firmware's
    // picture from the start, so that a machine without a serial line
    // shows everything up to here and what the driver says; when the mode
    // is set, the console moves to the new picture (console.
    // reshapeFramebuffer), and no program has mapped the framebuffer yet
    // (shell.start is below), nor is another processor running.
    out.write("brixOS: probing gpu\n")
    _ = gpu.probe()
    out.write("brixOS: ")
    out.decimal(memory.allFrames().totalBytes() / (1024 * 1024))
    out.write(" MiB (")
    out.decimal(memory.allFrames().freeBytes() / (1024 * 1024))
    out.write(" free), ")
    out.decimal(clock.system().rate() / 1000000)
    out.write(" MHz\n")
    // The other processors started: they come into the kernel (brix_ap)
    // once this one lets go of it, below.
    out.write("brixOS: starting processors\n")
    smp.start()
    const cpus = smp.processors()
    if cpus.*.count > 1 {
        out.write("brixOS: ")
        out.decimal(cpus.*.count)
        out.write(" processors, ")
        out.decimal(cpus.*.started)
        out.write(" more started\n")
    }
    // How this machine is powered off and restarted (ACPI's tables),
    // said now: at the end there may be nobody to read it.
    power.look()
    if !shell.start() {
        out.write("brixOS: no impulse or flux in the boot archive\n")
        return 1
    }
    serial.com1.receiveInterrupts()
    const p = scheduler.current()
    smp.unlock()
    cpu.Cpu.enterUser(p.*.entry, p.*.stack)
    return 0
}
