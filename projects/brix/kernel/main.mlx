// brixOS's kernel: started by the boot blob (projects/brix/image) in long
// mode, in the higher half, with its arena; the serial console, memory,
// the clock, then mlx-sh in user mode.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const serial = @import("./serial.mlx")
const interrupts = @import("./interrupts.mlx")
const console = @import("./console.mlx")
const memory = @import("./memory.mlx")
const clock = @import("./clock.mlx")
const system = @import("./linux/system.mlx")
const scheduler = @import("./scheduler.mlx")
const vfs = @import("./vfs.mlx")
const virtio = @import("./virtio.mlx")
const volume = @import("./volume.mlx")
const ext2 = @import("./ext2.mlx")
const smp = @import("./smp.mlx")
const virtionet = @import("./virtionet.mlx")
const stack = @import("./net/stack.mlx")
const shell = @import("./shell.mlx")
// brix_trap, which the boot blob calls.
const trap = @import("./trap.mlx")

// The system on the disk: its /system, /users and /temporary in the
// memory-only tree's place (the same nodes as /volumes/disk0's), the
// boot archive's /system kept at /volumes/boot. False when the disk
// lacks one of them.
fn bootFromDisk(root: usize) -> bool {
    const tree = vfs.fileSystem()
    const system = tree.lookup(root, "system".pointer, 6)
    const users = tree.lookup(root, "users".pointer, 5)
    const temporary = tree.lookup(root, "temporary".pointer, 9)
    if system == vfs.Vfs.NONE || users == vfs.Vfs.NONE || temporary == vfs.Vfs.NONE { return false }
    const volumes = tree.lookup(vfs.Vfs.ROOT, "volumes".pointer, 7)
    const oldSystem = tree.graft(vfs.Vfs.ROOT, "system", system)
    if oldSystem != vfs.Vfs.NONE { _ = tree.attach(volumes, "boot".pointer, 4, oldSystem) }
    const oldUsers = tree.graft(vfs.Vfs.ROOT, "users", users)
    if oldUsers != vfs.Vfs.NONE { tree.retire(oldUsers) }
    const oldTemporary = tree.graft(vfs.Vfs.ROOT, "temporary", temporary)
    if oldTemporary != vfs.Vfs.NONE { tree.retire(oldTemporary) }
    return true
}

// /system/settings/network read (address, netmask, gateway, nameserver
// lines), /system/settings/resolv.conf written for the name server.
fn networkSettings() -> void {
    const tree = vfs.fileSystem()
    const system = tree.resolve(vfs.Vfs.ROOT, "/system\x00".pointer)
    if system < 0 { return }
    var directory = tree.lookup(@bitCast(usize, system), "settings".pointer, 8)
    if directory == vfs.Vfs.NONE {
        directory = tree.create(vfs.NodeKind.directory, 493)
        if directory == vfs.Vfs.NONE || !tree.attach(@bitCast(usize, system), "settings".pointer, 8, directory) { return }
    }
    const file = tree.lookup(directory, "network".pointer, 7)
    if file != vfs.Vfs.NONE {
        var text: [512]u8 = undefined
        const length = tree.read(file, 0, &text, 512)
        stack.settings(text[0..length])
    }
    var line: [40]u8 = undefined
    const prefix = "nameserver "
    var k: usize = 0
    while k < prefix.length {
        line[k] = prefix[k]
        k += 1
    }
    var length = prefix.length
    const server = stack.configuration().*.nameServer
    var part: usize = 0
    while part < 4 {
        if part > 0 {
            line[length] = 46
            length += 1
        }
        const value = @intCast(usize, server[part])
        if value >= 100 {
            line[length] = @intCast(u8, 48 + value / 100)
            length += 1
        }
        if value >= 10 {
            line[length] = @intCast(u8, 48 + (value / 10) % 10)
            length += 1
        }
        line[length] = @intCast(u8, 48 + value % 10)
        length += 1
        part += 1
    }
    line[length] = 10
    length += 1
    var node = tree.lookup(directory, "resolv.conf".pointer, 11)
    if node == vfs.Vfs.NONE {
        node = tree.create(vfs.NodeKind.file, 420)
        if node == vfs.Vfs.NONE || !tree.attach(directory, "resolv.conf".pointer, 11, node) { return }
    }
    _ = tree.write(node, 0, &line, length)
}

pub fn main() -> u8 {
    smp.lock(0)
    serial.com1.init()
    const out = console.out
    out.write("brixOS: kernel at ")
    out.hex(cpu.BootInfo.get(layout.Info.KERNEL_PHYS))
    out.write(", ")
    out.decimal(cpu.BootInfo.get(layout.Info.KERNEL_SIZE) / 1024)
    out.write(" KiB\n")
    // The timer and the serial line's interrupts, above the processor's
    // exceptions (they come once user mode runs: the kernel keeps them off).
    interrupts.Irq.init()
    memory.allFrames().init()
    clock.system().calibrate()
    system.system().init()
    if @sizeOf(vfs.Node) > vfs.NODE_SIZE {
        out.write("brixOS: a node does not fit its chunk\n")
        return 1
    }
    vfs.fileSystem().init()
    // The disks: /devices/diskN, each one's volume at /volumes/diskN
    // (brixfs, or ext2 read-only); the first with a system on it is the
    // system.
    const disks = virtio.probeAll()
    var which: usize = 0
    var booted = false
    while which < disks {
        const disk = virtio.diskAt(which)
        vfs.fileSystem().addDisk(which, disk.sizeInBytes())
        out.write("brixOS: /devices/disk")
        out.decimal(which)
        out.write(", ")
        out.decimal(disk.sizeInBytes() / 1024)
        out.write(" KiB (virtio")
        if disk.*.irq != virtio.VirtioBlock.NO_IRQ {
            out.write(", IRQ ")
            out.decimal(disk.*.irq)
        }
        out.write(")")
        out.write(if disk.*.readOnly { ", read-only\n" } else { "\n" })
        const store = volume.storeAt(which)
        if store.mount(which) {
            out.write("brixOS: /volumes/disk")
            out.decimal(which)
            out.write(" (brixfs, generation ")
            out.decimal(store.*.superblock.generation)
            out.write(")\n")
            if !booted && store.hasSystem() && bootFromDisk(store.rootNode()) {
                booted = true
                out.write("brixOS: / from /volumes/disk")
                out.decimal(which)
                out.write(" (the boot archive at /volumes/boot)\n")
            }
        } else if ext2.volumeAt(which).mount(which) {
            out.write("brixOS: /volumes/disk")
            out.decimal(which)
            out.write(" (ext2, read-only)\n")
        }
        which += 1
    }
    // The network: /devices/net0 (virtio), the stack on it with the
    // settings' addresses (or QEMU's user network's); /etc/resolv.conf
    // for programs that look names up.
    if virtionet.device().probe() {
        const net = virtionet.device()
        out.write("brixOS: /devices/net0, ")
        stack.writeMac(net.*.mac, out)
        out.write(" (virtio")
        if net.*.irq != virtionet.VirtioNet.NO_IRQ {
            out.write(", IRQ ")
            out.decimal(net.*.irq)
        }
        out.write(")\n")
        vfs.fileSystem().addDevice("net0", vfs.NodeKind.null_device, 0)
    }
    stack.init()
    if stack.configuration().*.up {
        networkSettings()
        out.write("brixOS: net0 is ")
        stack.writeIp(stack.configuration().*.address, out)
        out.write(", gateway ")
        stack.writeIp(stack.configuration().*.gateway, out)
        out.write(", name server ")
        stack.writeIp(stack.configuration().*.nameServer, out)
        out.write("\n")
    }
    out.write("brixOS: ")
    out.decimal(memory.allFrames().totalBytes() / (1024 * 1024))
    out.write(" MiB (")
    out.decimal(memory.allFrames().freeBytes() / (1024 * 1024))
    out.write(" free), ")
    out.decimal(clock.system().rate() / 1000000)
    out.write(" MHz\n")
    // The other processors started: they come into the kernel (brix_ap)
    // once this one lets go of it, below.
    smp.start()
    const cpus = smp.processors()
    if cpus.*.count > 1 {
        out.write("brixOS: ")
        out.decimal(cpus.*.count)
        out.write(" processors, ")
        out.decimal(cpus.*.started)
        out.write(" more started\n")
    }
    if !shell.start() {
        out.write("brixOS: no mlx-sh in the boot archive\n")
        return 1
    }
    serial.com1.receiveInterrupts()
    const p = scheduler.current()
    smp.unlock()
    cpu.Cpu.enterUser(p.*.entry, p.*.stack)
    return 0
}
