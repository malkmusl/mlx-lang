// brixOS's kernel: started by the boot blob (projects/brix/image) in long
// mode, in the higher half, with its arena; the serial console, memory,
// the clock, then mlx-sh in user mode.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const serial = @import("./serial.mlx")
const interrupts = @import("./interrupts.mlx")
const console = @import("./console.mlx")
const memory = @import("./memory.mlx")
const clock = @import("./clock.mlx")
const system = @import("./linux/system.mlx")
const scheduler = @import("./scheduler.mlx")
const vfs = @import("./vfs.mlx")
const virtio = @import("./virtio.mlx")
const volume = @import("./volume.mlx")
const ext2 = @import("./ext2.mlx")
const smp = @import("./smp.mlx")
const shell = @import("./shell.mlx")
// brix_trap, which the boot blob calls.
const trap = @import("./trap.mlx")

// The system on the disk: its /system, /users and /temporary in the
// memory-only tree's place (the same nodes as /volumes/disk0's), the
// boot archive's /system kept at /volumes/boot. False when the disk
// lacks one of them.
fn bootFromDisk(root: usize) -> bool {
    const tree = vfs.fileSystem()
    const system = tree.lookup(root, "system".pointer, 6)
    const users = tree.lookup(root, "users".pointer, 5)
    const temporary = tree.lookup(root, "temporary".pointer, 9)
    if system == vfs.Vfs.NONE || users == vfs.Vfs.NONE || temporary == vfs.Vfs.NONE { return false }
    const volumes = tree.lookup(vfs.Vfs.ROOT, "volumes".pointer, 7)
    const oldSystem = tree.graft(vfs.Vfs.ROOT, "system", system)
    if oldSystem != vfs.Vfs.NONE { _ = tree.attach(volumes, "boot".pointer, 4, oldSystem) }
    const oldUsers = tree.graft(vfs.Vfs.ROOT, "users", users)
    if oldUsers != vfs.Vfs.NONE { tree.retire(oldUsers) }
    const oldTemporary = tree.graft(vfs.Vfs.ROOT, "temporary", temporary)
    if oldTemporary != vfs.Vfs.NONE { tree.retire(oldTemporary) }
    return true
}

pub fn main() -> u8 {
    serial.com1.init()
    const out = console.out
    out.write("brixOS: kernel at ")
    out.hex(cpu.BootInfo.get(layout.Info.KERNEL_PHYS))
    out.write(", ")
    out.decimal(cpu.BootInfo.get(layout.Info.KERNEL_SIZE) / 1024)
    out.write(" KiB\n")
    // The timer and the serial line's interrupts, above the processor's
    // exceptions (they come once user mode runs: the kernel keeps them off).
    interrupts.Irq.init()
    memory.allFrames().init()
    clock.system().calibrate()
    system.system().init()
    vfs.fileSystem().init()
    const disk = virtio.disk()
    if disk.probe() {
        vfs.fileSystem().addDevice("disk0", vfs.NodeKind.disk, disk.sizeInBytes())
        out.write("brixOS: /devices/disk0, ")
        out.decimal(disk.sizeInBytes() / 1024)
        out.write(" KiB (virtio")
        if disk.*.irq != virtio.VirtioBlock.NO_IRQ {
            out.write(", IRQ ")
            out.decimal(disk.*.irq)
        }
        out.write(")")
        out.write(if disk.*.readOnly { ", read-only\n" } else { "\n" })
        const disk0 = volume.store()
        if disk0.mount() {
            out.write("brixOS: /volumes/disk0 (brixfs, generation ")
            out.decimal(disk0.*.superblock.generation)
            out.write(")\n")
            if disk0.hasSystem() && bootFromDisk(disk0.rootNode()) { out.write("brixOS: / from /volumes/disk0 (the boot archive at /volumes/boot)\n") }
        } else if ext2.volume().mount() {
            out.write("brixOS: /volumes/disk0 (ext2, read-only)\n")
        }
        if disk.*.interrupts > 0 { out.write("brixOS: disk0 answers by interrupt\n") }
    }
    out.write("brixOS: ")
    out.decimal(memory.allFrames().totalBytes() / (1024 * 1024))
    out.write(" MiB (")
    out.decimal(memory.allFrames().freeBytes() / (1024 * 1024))
    out.write(" free), ")
    out.decimal(clock.system().rate() / 1000000)
    out.write(" MHz\n")
    // The other processors started (they wait, halted).
    smp.start()
    const cpus = smp.processors()
    if cpus.*.count > 1 {
        out.write("brixOS: ")
        out.decimal(cpus.*.count)
        out.write(" processors, ")
        out.decimal(cpus.*.started)
        out.write(" more started (halted)\n")
    }
    if !shell.start() {
        out.write("brixOS: no mlx-sh in the boot archive\n")
        return 1
    }
    serial.com1.receiveInterrupts()
    const p = scheduler.current()
    cpu.Cpu.enterUser(p.*.entry, p.*.stack)
    return 0
}
