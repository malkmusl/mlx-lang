// brixOS's kernel: started by the boot blob (projects/brix/image) in long
// mode, in the higher half, with its arena; the serial console first.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const serial = @import("./serial.mlx")
const console = @import("./console.mlx")
const trap_module = @import("./trap.mlx")
const memory = @import("./memory.mlx")
const clock = @import("./clock.mlx")
const system = @import("./system.mlx")
const process = @import("./process.mlx")

pub fn main() -> u8 {
    serial.init()
    console.write("brixOS: kernel at ")
    console.hex(cpu.bootInfo(layout.INFO_KERNEL_PHYS))
    console.write(", ")
    console.decimal(cpu.bootInfo(layout.INFO_KERNEL_SIZE) / 1024)
    console.write(" KiB\n")
    // The legacy interrupt controllers masked (no IRQ reaches a vector of
    // the CPU's exceptions).
    cpu.outb(0x21, 0xFF)
    cpu.outb(0xA1, 0xFF)
    memory.init()
    clock.init()
    system.init()
    console.write("brixOS: ")
    console.decimal(memory.totalBytes() / (1024 * 1024))
    console.write(" MiB, ")
    console.decimal(clock.rate() / 1000000)
    console.write(" MHz\n")
    if !trap_module.start() {
        console.write("brixOS: no mlx-sh in the boot archive\n")
        return 1
    }
    cpu.enterUser(process.entry(), process.stack())
    return 0
}
