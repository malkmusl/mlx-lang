// The parameter blocks of the card's firmware tables that a TMDS output's
// change runs (gpu_mode.mlx plans the runs, gpu_set.mlx makes them through
// atom.mlx's interpreter): what each table is told, byte for byte as Linux
// 6.6's display core tells it on this controller (DCE 11.2). Each block is
// worked out here from plain numbers, before anything is run, so that the
// plan can say it in the log and a test can hold it against the bytes
// worked out by hand (tests/475_gpu_tmds_blocks_runtime.mlx).
//
// The layouts are atombios.h's packed structures (drivers/gpu/drm/amd/
// include/atombios.h), each offset below named STRUCTURE__field and held
// against that file by tools/check_gpu_registers.py, as are the numbers
// named as that file names them. How a field is filled is the display
// core's (display/dc/bios/command_table.c, with the helper for this
// controller, bios/dce112/command_table_helper_dce112.c), function by
// function as each block below says. A block is as long as its structure;
// the interpreter gives a table zeroes behind it (Linux hands a called
// table whatever lies behind the structure on its stack).
//
// A table's block depends on the table's revision: only the revisions
// Linux's display core fills on this controller are filled here, and a
// plan for a ROM whose table has another one is not complete (`filled`).
const videorom = @import("./gpu_rom.mlx")
const edid = @import("./edid.mlx")

// The longest block's words (SetCRTC_UsingDTDTiming's 24 bytes).
pub const WORDS: usize = 6

pub const Block = struct {
    // The table's place in the ROM's list (gpu_rom.mlx's Command), how
    // many bytes the structure has, and the bytes as 32-bit words, the
    // lowest byte first (as atom.mlx's `run` takes them).
    table: usize
    bytes: usize
    words: [WORDS]u32

    pub fn byte(self: *const Self, at: usize) -> usize {
        return (@intCast(usize, self.*.words[at / 4]) >> @intCast(u6, (at % 4) * 8)) & 0xFF
    }
}

// SetPixelClock, content revision 7 (PIXEL_CLOCK_PARAMETERS_V7).
pub const PIXEL_CLOCK_PARAMETERS_V7__ulPixelClock: usize = 0
pub const PIXEL_CLOCK_PARAMETERS_V7__ucPpll: usize = 4
pub const PIXEL_CLOCK_PARAMETERS_V7__ucTransmitterID: usize = 5
pub const PIXEL_CLOCK_PARAMETERS_V7__ucEncoderMode: usize = 6
pub const PIXEL_CLOCK_PARAMETERS_V7__ucMiscInfo: usize = 7
pub const PIXEL_CLOCK_PARAMETERS_V7__ucCRTC: usize = 8
pub const PIXEL_CLOCK_PARAMETERS_V7__ucDeepColorRatio: usize = 9
pub const PIXEL_CLOCK_PARAMETERS_V7__size: usize = 16
// The transmitter's table (DIG1TransmitterControl, which Linux calls
// UNIPHYTransmitterControl), content revision 6.
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucPhyId: usize = 0
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucAction: usize = 1
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucDigMode: usize = 2
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucLaneNum: usize = 3
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ulSymClock: usize = 4
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucHPDSel: usize = 8
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucDigEncoderSel: usize = 9
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucConnObjId: usize = 10
pub const DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__size: usize = 16
// DIGxEncoderControl, content revision 5, told a stream.
pub const ENCODER_STREAM_SETUP_PARAMETERS_V5__ucDigId: usize = 0
pub const ENCODER_STREAM_SETUP_PARAMETERS_V5__ucAction: usize = 1
pub const ENCODER_STREAM_SETUP_PARAMETERS_V5__ucDigMode: usize = 2
pub const ENCODER_STREAM_SETUP_PARAMETERS_V5__ucLaneNum: usize = 3
pub const ENCODER_STREAM_SETUP_PARAMETERS_V5__ulPixelClock: usize = 4
pub const ENCODER_STREAM_SETUP_PARAMETERS_V5__ucBitPerColor: usize = 8
pub const ENCODER_STREAM_SETUP_PARAMETERS_V5__size: usize = 12
// EnableCRTC.
pub const ENABLE_CRTC_PARAMETERS__ucCRTC: usize = 0
pub const ENABLE_CRTC_PARAMETERS__ucEnable: usize = 1
pub const ENABLE_CRTC_PARAMETERS__size: usize = 4
// SetCRTC_UsingDTDTiming.
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_Size: usize = 0
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_Blanking_Time: usize = 2
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_Size: usize = 4
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_Blanking_Time: usize = 6
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_SyncOffset: usize = 8
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_SyncWidth: usize = 10
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_SyncOffset: usize = 12
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_SyncWidth: usize = 14
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__susModeMiscInfo: usize = 16
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__ucCRTC: usize = 20
pub const SET_CRTC_USING_DTD_TIMING_PARAMETERS__size: usize = 24
// SetDCEClock, revision 2.1.
pub const SET_DCE_CLOCK_PARAMETERS_V2_1__ulDCEClkFreq: usize = 0
pub const SET_DCE_CLOCK_PARAMETERS_V2_1__ucDCEClkType: usize = 4
pub const SET_DCE_CLOCK_PARAMETERS_V2_1__ucDCEClkSrc: usize = 5
pub const SET_DCE_CLOCK_PARAMETERS_V2_1__size: usize = 8

// What the fields are given (atombios.h's names and numbers).
pub const ATOM_ENCODER_MODE_DVI: usize = 2
pub const ATOM_ENCODER_MODE_HDMI: usize = 3
pub const ATOM_TRANSMITTER_DIGMODE_V6_DVI: usize = 2
pub const ATOM_TRANSMITTER_DIGMODE_V6_HDMI: usize = 3
pub const ATOM_TRANSMITTER_ACTION_DISABLE: usize = 0
pub const ATOM_TRANSMITTER_ACTION_ENABLE: usize = 1
pub const ATOM_ENCODER_CMD_STREAM_SETUP: usize = 0x0F
pub const PANEL_8BIT_PER_COLOR: usize = 0x02
pub const ATOM_DISABLE: usize = 0
pub const ATOM_ENABLE: usize = 1
pub const ATOM_COMBOPHY_PLL0: usize = 20
pub const ATOM_GCK_DFS: usize = 8
pub const DCE_CLOCK_TYPE_DISPCLK: usize = 0
pub const DCE_CLOCK_TYPE_DPREFCLK: usize = 1
pub const ATOM_HSYNC_POLARITY: usize = 0x02
pub const ATOM_VSYNC_POLARITY: usize = 0x04

// A TMDS link has four lanes (dce110_link_encoder_enable_tmds_output and
// the stream encoder's set_stream_attribute: LANE_COUNT_FOUR; eight only
// for two DVI links, which no plan here asks for).
pub const LANES: usize = 4

// The content revision each table's block is filled for: what Linux's
// display core fills on this controller (init_set_pixel_clock's 7 with
// the DCE 11.2 helper's values, init_transmitter_control's 6,
// init_dig_encoder_control's 5, init_enable_crtc's 1, init_set_crtc_
// timing's 3, init_set_dce_clock's 1); 0: no block is filled for the
// table here.
pub fn revisionFilled(table: usize) -> usize {
    if table == videorom.Command.SetPixelClock { return 7 }
    if table == videorom.Command.DIG1TransmitterControl { return 6 }
    if table == videorom.Command.DIGxEncoderControl { return 5 }
    if table == videorom.Command.EnableCRTC { return 1 }
    if table == videorom.Command.SetCRTC_UsingDTDTiming { return 3 }
    if table == videorom.Command.SetDCEClock { return 1 }
    return 0
}

// Whether the block for `table` is the one a table of `revision` (format
// * 256 + content, as atom.mlx gives it) takes. Linux's display core
// looks at the content revision alone.
pub fn filled(table: usize, revision: usize) -> bool {
    return revision != 0 && revisionFilled(table) != 0 && revision & 0xFF == revisionFilled(table)
}

// A table's name for the log.
pub fn tableName(table: usize) -> []const u8 {
    if table == videorom.Command.SetPixelClock { return "SetPixelClock" }
    if table == videorom.Command.DIG1TransmitterControl { return "UNIPHYTransmitterControl" }
    if table == videorom.Command.DIGxEncoderControl { return "DIGxEncoderControl" }
    if table == videorom.Command.EnableCRTC { return "EnableCRTC" }
    if table == videorom.Command.SetCRTC_UsingDTDTiming { return "SetCRTC_UsingDTDTiming" }
    if table == videorom.Command.SetDCEClock { return "SetDCEClock" }
    return "a table not known here"
}

fn empty(table: usize, bytes: usize) -> Block {
    return Block.{ .table = table, .bytes = bytes, .words = [_]u32{ 0, 0, 0, 0, 0, 0 } }
}

fn set8(block: *Block, at: usize, value: usize) -> void {
    const shift = @intCast(u6, (at % 4) * 8)
    const word = @intCast(usize, block.*.words[at / 4])
    block.*.words[at / 4] = @intCast(u32, (word & ~(@intCast(usize, 0xFF) << shift)) | ((value & 0xFF) << shift))
}

fn set16(block: *Block, at: usize, value: usize) -> void {
    set8(block, at, value)
    set8(block, at + 1, value >> 8)
}

fn set32(block: *Block, at: usize, value: usize) -> void {
    set16(block, at, value)
    set16(block, at + 2, value >> 16)
}

// The encoder object a back end's transmitter is, by its low byte (the
// pairs UNIPHY A and B, C and D, E and F: translate_encoder_to_transmitter
// in dc/link/link_factory.c read the other way), which SetPixelClock is
// told as ucTransmitterID. Back end 6 (UNIPHY G) has no PLL of its own
// for a TMDS clock (dce112_resource.c's find_matching_pll has no case for
// it): the plan refuses it before a block is asked for.
pub fn encoderOf(backEnd: usize) -> usize {
    if backEnd < 2 { return videorom.ENCODER_OBJECT_ID_INTERNAL_UNIPHY }
    if backEnd < 4 { return videorom.ENCODER_OBJECT_ID_INTERNAL_UNIPHY1 }
    return videorom.ENCODER_OBJECT_ID_INTERNAL_UNIPHY2
}

// SetPixelClock for a TMDS output: the PLL of back end `backEnd` (the
// PHY's own: ATOM_COMBOPHY_PLL0 and the five after it, find_matching_pll
// with clock_source_id_to_atom) set for `clock` kHz, and controller
// `index` put on it. set_pixel_clock_v7, filled from dce112_program_
// pix_clk: the clock in units of 100 Hz, not multiplied (eight bits a
// colour); the encoder mode 2 for DVI and 3 for HDMI signalling
// (dal_cmd_table_helper_encoder_mode_bp_to_atom); no flag (the reference
// is the crystal, which is flag value 0; one link; no 4:2:0; the PLL not
// forced); no deep colour ratio.
pub fn pixelClock(clock: usize, backEnd: usize, hdmi: bool, index: usize) -> Block {
    var block = empty(videorom.Command.SetPixelClock, PIXEL_CLOCK_PARAMETERS_V7__size)
    set32(&block, PIXEL_CLOCK_PARAMETERS_V7__ulPixelClock, clock * 10)
    set8(&block, PIXEL_CLOCK_PARAMETERS_V7__ucPpll, ATOM_COMBOPHY_PLL0 + backEnd)
    set8(&block, PIXEL_CLOCK_PARAMETERS_V7__ucTransmitterID, encoderOf(backEnd))
    set8(&block, PIXEL_CLOCK_PARAMETERS_V7__ucEncoderMode, if hdmi { ATOM_ENCODER_MODE_HDMI } else { ATOM_ENCODER_MODE_DVI })
    set8(&block, PIXEL_CLOCK_PARAMETERS_V7__ucMiscInfo, 0)
    set8(&block, PIXEL_CLOCK_PARAMETERS_V7__ucCRTC, index)
    set8(&block, PIXEL_CLOCK_PARAMETERS_V7__ucDeepColorRatio, 0)
    return block
}

// The transmitter of back end `backEnd` turned on for `clock` kHz, or off.
// transmitter_control_v1_6, filled from dce110_link_encoder_enable_tmds_
// output and dce110_link_encoder_disable_output: the PHY's number is the
// back end's (phy_id_to_atom); on: four lanes and the clock in units of
// 10 kHz; off: no lanes and no clock, and the mode the output has at
// that moment; the hot plug line 1 to 6, or 0 for none (hpd_sel_to_atom);
// no front end named (dig_encoder_sel_to_atom gives 0: the driver puts
// the front end on the back end itself); the connector's kind as the
// ROM's object table numbers it.
pub fn transmitter(backEnd: usize, on: bool, hdmi: bool, clock: usize, hotPlugLine: usize, connector: usize) -> Block {
    var block = empty(videorom.Command.DIG1TransmitterControl, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__size)
    set8(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucPhyId, backEnd)
    set8(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucAction, if on { ATOM_TRANSMITTER_ACTION_ENABLE } else { ATOM_TRANSMITTER_ACTION_DISABLE })
    set8(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucDigMode, if hdmi { ATOM_TRANSMITTER_DIGMODE_V6_HDMI } else { ATOM_TRANSMITTER_DIGMODE_V6_DVI })
    set8(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucLaneNum, if on { LANES } else { 0 })
    set32(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ulSymClock, if on { clock / 10 } else { 0 })
    set8(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucHPDSel, hotPlugLine)
    set8(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucDigEncoderSel, 0)
    set8(&block, DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6__ucConnObjId, connector)
    return block
}

// Front end `frontEnd` told its stream. encoder_control_digx_v5, filled
// from the stream encoder's hdmi_set_stream_attribute or dvi_set_stream_
// attribute: the action "stream setup" (encoder_action_to_atom), the
// mode, four lanes, the clock in units of 10 kHz; the colour depth 2
// (eight bits) for HDMI and none for DVI, whose caller names no depth.
pub fn stream(frontEnd: usize, hdmi: bool, clock: usize) -> Block {
    var block = empty(videorom.Command.DIGxEncoderControl, ENCODER_STREAM_SETUP_PARAMETERS_V5__size)
    set8(&block, ENCODER_STREAM_SETUP_PARAMETERS_V5__ucDigId, frontEnd)
    set8(&block, ENCODER_STREAM_SETUP_PARAMETERS_V5__ucAction, ATOM_ENCODER_CMD_STREAM_SETUP)
    set8(&block, ENCODER_STREAM_SETUP_PARAMETERS_V5__ucDigMode, if hdmi { ATOM_ENCODER_MODE_HDMI } else { ATOM_ENCODER_MODE_DVI })
    set8(&block, ENCODER_STREAM_SETUP_PARAMETERS_V5__ucLaneNum, LANES)
    set32(&block, ENCODER_STREAM_SETUP_PARAMETERS_V5__ulPixelClock, clock / 10)
    set8(&block, ENCODER_STREAM_SETUP_PARAMETERS_V5__ucBitPerColor, if hdmi { PANEL_8BIT_PER_COLOR } else { 0 })
    return block
}

// Controller `index` started or stopped (enable_crtc_v1; the
// controller is passed by its number, ATOM_CRTC1 being 0).
pub fn controller(index: usize, on: bool) -> Block {
    var block = empty(videorom.Command.EnableCRTC, ENABLE_CRTC_PARAMETERS__size)
    set8(&block, ENABLE_CRTC_PARAMETERS__ucCRTC, index)
    set8(&block, ENABLE_CRTC_PARAMETERS__ucEnable, if on { ATOM_ENABLE } else { ATOM_DISABLE })
    return block
}

// Whether a timing's numbers fit the timing block's fields (16 bits
// each).
pub fn timingFits(t: *const edid.Timing) -> bool {
    return t.*.width <= 0xFFFF && t.*.hTotal - t.*.width <= 0xFFFF && t.*.hFront <= 0xFFFF && t.*.hSync <= 0xFFFF && t.*.height <= 0xFFFF && t.*.vTotal - t.*.height <= 0xFFFF && t.*.vFront <= 0xFFFF && t.*.vSync <= 0xFFFF
}

// Controller `index`'s timing. set_crtc_using_dtd_timing_v3, filled
// from dce110_timing_generator_program_timing_generator: the sizes, the
// blankings (total less size), the front porches as the timing has them
// (the display core's "one line at least" does not reach this block: a
// timing without a front porch is refused by the plan, not changed), the
// pulses, and a bit each for a pulse that is the low one. No borders, no
// interlace, no pixel counted twice.
pub fn timing(t: *const edid.Timing, index: usize) -> Block {
    var block = empty(videorom.Command.SetCRTC_UsingDTDTiming, SET_CRTC_USING_DTD_TIMING_PARAMETERS__size)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_Size, t.*.width)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_Blanking_Time, t.*.hTotal - t.*.width)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_Size, t.*.height)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_Blanking_Time, t.*.vTotal - t.*.height)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_SyncOffset, t.*.hFront)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usH_SyncWidth, t.*.hSync)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_SyncOffset, t.*.vFront)
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__usV_SyncWidth, t.*.vSync)
    var flags: usize = 0
    if !t.*.hPositive { flags = flags | ATOM_HSYNC_POLARITY }
    if !t.*.vPositive { flags = flags | ATOM_VSYNC_POLARITY }
    set16(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__susModeMiscInfo, flags)
    set8(&block, SET_CRTC_USING_DTD_TIMING_PARAMETERS__ucCRTC, index)
    return block
}

// The display engine's clock asked for (`clock` kHz, from the card's own
// divider: ATOM_GCK_DFS), and the DisplayPort reference clock set again
// after it, which Linux never leaves out (dce112_set_clock: two calls of
// set_dce_clock_v2_1; the second with no frequency, "VBIOS will determine
// DPREFCLK frequency"). The first table answers with the clock it set, in
// the same field.
pub fn engineClock(clock: usize) -> Block {
    var block = empty(videorom.Command.SetDCEClock, SET_DCE_CLOCK_PARAMETERS_V2_1__size)
    set32(&block, SET_DCE_CLOCK_PARAMETERS_V2_1__ulDCEClkFreq, clock / 10)
    set8(&block, SET_DCE_CLOCK_PARAMETERS_V2_1__ucDCEClkType, DCE_CLOCK_TYPE_DISPCLK)
    set8(&block, SET_DCE_CLOCK_PARAMETERS_V2_1__ucDCEClkSrc, ATOM_GCK_DFS)
    return block
}

pub fn referenceClock() -> Block {
    var block = empty(videorom.Command.SetDCEClock, SET_DCE_CLOCK_PARAMETERS_V2_1__size)
    set8(&block, SET_DCE_CLOCK_PARAMETERS_V2_1__ucDCEClkType, DCE_CLOCK_TYPE_DPREFCLK)
    set8(&block, SET_DCE_CLOCK_PARAMETERS_V2_1__ucDCEClkSrc, ATOM_GCK_DFS)
    return block
}
