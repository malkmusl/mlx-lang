// The boot image's file archive (brix-image): "BRIXFS01", the count, per
// file its name (48 bytes), offset and size.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")

pub const File = struct {
    data: [*]const u8
    size: usize
}

fn base() -> [*]const u8 { return unsafe { @ptrFromInt([*]const u8, cpu.physical(cpu.bootInfo(layout.INFO_ARCHIVE_PHYS))) } }

fn word(bytes: [*]const u8, at: usize) -> usize {
    var value: usize = 0
    var k: usize = 0
    while k < 8 {
        value |= @intCast(usize, bytes[at + k]) << @intCast(u6, k * 8)
        k += 1
    }
    return value
}

pub fn count() -> usize {
    const bytes = base()
    if bytes[0] != 66 || bytes[1] != 82 { return 0 }
    return word(bytes, 8)
}

// The name of file `index` (NUL padded).
pub fn name(index: usize) -> [*]const u8 {
    const bytes = base()
    return unsafe { @ptrFromInt([*]const u8, @intFromPtr(bytes) + 16 + index * 64) }
}

pub fn nameLength(index: usize) -> usize {
    const text = name(index)
    var length: usize = 0
    while length < 48 && text[length] != 0 { length += 1 }
    return length
}

pub fn file(index: usize) -> File {
    const bytes = base()
    const record = 16 + index * 64
    return File.{ .data = unsafe { @ptrFromInt([*]const u8, @intFromPtr(bytes) + word(bytes, record + 48)) }, .size = word(bytes, record + 56) }
}

// The file named `wanted` (its length `length`); false when none.
pub fn find(wanted: [*]const u8, length: usize, out: *File) -> bool {
    var index: usize = 0
    while index < count() {
        if nameLength(index) == length {
            const text = name(index)
            var k: usize = 0
            while k < length && text[k] == wanted[k] { k += 1 }
            if k == length {
                out.* = file(index)
                return true
            }
        }
        index += 1
    }
    return false
}
