// The boot image's file archive (brix-image): "BRIXFS01", the count, per
// file a record of its name (NAME_CAPACITY bytes, NUL padded), offset and size.
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const Bytes = @import("./bytes.mlx").Bytes

pub const File = struct {
    data: [*]const u8
    size: usize
}

pub const Archive = struct {
    pub const NAME_CAPACITY: usize = 72
    const RECORDS: usize = 16
    const RECORD_SIZE: usize = NAME_CAPACITY + 16

    base: [*]const u8

    // The archive brix-image put after the kernel.
    pub fn boot() -> Archive { return Archive.{ .base = Bytes.pointer(layout.Memory.virtual(cpu.BootInfo.get(layout.Info.ARCHIVE_PHYS))) } }

    pub fn count(self: Self) -> usize {
        if self.base[0] != 66 || self.base[1] != 82 { return 0 }
        return Bytes.read64(self.base, 8)
    }

    fn record(index: usize) -> usize { return RECORDS + index * RECORD_SIZE }

    pub fn name(self: Self, index: usize) -> [*]const u8 { return unsafe { @ptrFromInt([*]const u8, @intFromPtr(self.base) + record(index)) } }

    pub fn nameLength(self: Self, index: usize) -> usize {
        const text = self.name(index)
        var length: usize = 0
        while length < NAME_CAPACITY && text[length] != 0 { length += 1 }
        return length
    }

    pub fn file(self: Self, index: usize) -> File {
        const at = record(index)
        return File.{ .data = unsafe { @ptrFromInt([*]const u8, @intFromPtr(self.base) + Bytes.read64(self.base, at + NAME_CAPACITY)) }, .size = Bytes.read64(self.base, at + NAME_CAPACITY + 8) }
    }
}
