// Generates the kernel's built-in console font (projects/brix/kernel/font/
// data.mlx): DejaVu Sans Mono rasterized once, on the host, into an 8x16
// bitmap per printable ASCII character (0x20..0x7E), one bit per pixel,
// the high bit the leftmost pixel. The kernel draws its log on the
// framebuffer with it (fbcon.mlx), so a headless machine with no serial
// line still shows the hardware bring-up on screen.
//
//   mlx-font-generate FONT.ttf > projects/brix/kernel/font/data.mlx
//
// (A preview of a few glyphs goes to stderr so the cell metrics can be
// checked by eye.)
const std = @import("std")
const tt = @import("std.truetype")
const heap = @import("std.heap")
const crash = @import("std.crash")

const CELL_W: usize = 8
const CELL_H: usize = 16
const FIRST: usize = 0x20
const LAST: usize = 0x7E
const COUNT: usize = LAST - FIRST + 1
// The baseline row in the cell (rows above it hold the glyph body, the
// four below hold descenders) and the pixel height to rasterize at.
const BASELINE: usize = 12
const PIXEL_H: u32 = 14

var cell: [CELL_H]u8 = undefined

// Rasterizes `codepoint` into `cell` (one bit per pixel). Returns false
// only on an allocation failure.
fn renderGlyph(font: *const tt.Font, scale: f64, codepoint: usize) -> bool {
    var row: usize = 0
    while row < CELL_H {
        cell[row] = 0
        row += 1
    }
    const glyph = tt.glyphIndex(font, @intCast(u32, codepoint))
    var bitmap: tt.Bitmap = undefined
    if !tt.rasterize(font, glyph, scale, heap.allocator(), &bitmap) { return false }
    if bitmap.width == 0 || bitmap.height == 0 { return true } // space: blank cell
    var y: usize = 0
    while y < bitmap.height {
        const cellRow = @intCast(isize, BASELINE) + @intCast(isize, bitmap.top) + @intCast(isize, y)
        if cellRow >= 0 && cellRow < @intCast(isize, CELL_H) {
            var x: usize = 0
            while x < bitmap.width {
                const cellCol = bitmap.left + @intCast(i32, x)
                if cellCol >= 0 && cellCol < @intCast(i32, CELL_W) {
                    const coverage = bitmap.pixels[y * bitmap.width + x]
                    if coverage >= 128 {
                        const shift = @intCast(u6, 7 - @intCast(usize, cellCol))
                        var bit: usize = 1
                        bit = bit << shift
                        cell[@intCast(usize, cellRow)] |= @intCast(u8, bit)
                    }
                }
                x += 1
            }
        }
        y += 1
    }
    return true
}

fn preview(codepoint: usize) -> void {
    _ = std.io.eprint("glyph '")
    var one: [1]u8 = [1]u8{ @intCast(u8, codepoint) }
    _ = std.io.writeAllBytes(std.io.stderr(), &one, 1)
    _ = std.io.eprint("':\n")
    var row: usize = 0
    while row < CELL_H {
        var col: usize = 0
        while col < CELL_W {
            const on = (cell[row] >> @intCast(u3, 7 - col)) & 1
            _ = std.io.eprint(if on != 0 { "#" } else { "." })
            col += 1
        }
        _ = std.io.eprint("\n")
        row += 1
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    crash.install()
    if std.process.count(arguments) < 2 {
        _ = std.io.eprint("usage: mlx-font-generate FONT.ttf > data.mlx\n")
        return 1
    }
    const path = std.process.argument(arguments, 1).pointer
    var font: tt.Font = undefined
    if tt.loadFile(&font, path, heap.allocator()) != tt.Status.ok {
        _ = std.io.eprint("cannot load the font\n")
        return 1
    }
    const scale = tt.scaleForPixelHeight(&font, PIXEL_H)

    _ = std.io.print("// Generated by projects/brix/kernel/font/generate.mlx from DejaVu\n")
    _ = std.io.print("// Sans Mono: an 8x16 bitmap per printable ASCII character, one bit\n")
    _ = std.io.print("// per pixel, the high bit the leftmost pixel. Do not edit by hand;\n")
    _ = std.io.print("// regenerate with mlx-font-generate.\n")
    _ = std.io.print("pub const CELL_W: usize = 8\n")
    _ = std.io.print("pub const CELL_H: usize = 16\n")
    _ = std.io.print("pub const FIRST: usize = 0x20\n")
    _ = std.io.print("pub const COUNT: usize = ")
    _ = std.io.writeUnsigned(std.io.stdout(), COUNT)
    _ = std.io.print("\n")
    _ = std.io.print("pub const GLYPHS = [")
    _ = std.io.writeUnsigned(std.io.stdout(), COUNT * CELL_H)
    _ = std.io.print("]u8{\n")

    var codepoint = FIRST
    while codepoint <= LAST {
        if !renderGlyph(&font, scale, codepoint) {
            _ = std.io.eprint("allocation failed\n")
            return 1
        }
        if codepoint == 0x41 || codepoint == 0x67 || codepoint == 0x30 || codepoint == 0x3A { preview(codepoint) }
        _ = std.io.print("    ")
        var row: usize = 0
        while row < CELL_H {
            _ = std.io.print("0x")
            const high = (cell[row] >> 4) & 0xF
            const low = cell[row] & 0xF
            var hx: [2]u8 = [2]u8{ hex(high), hex(low) }
            _ = std.io.printString(std.string.fromParts(&hx, 2))
            _ = std.io.print(",")
            row += 1
        }
        _ = std.io.print(" // ")
        var one: [1]u8 = [1]u8{ @intCast(u8, codepoint) }
        _ = std.io.printString(std.string.fromParts(&one, 1))
        _ = std.io.print("\n")
        codepoint += 1
    }
    _ = std.io.print("}\n")
    return 0
}

fn hex(value: u8) -> u8 {
    if value < 10 { return @intCast(u8, 48 + value) }
    return @intCast(u8, 97 + value - 10)
}
