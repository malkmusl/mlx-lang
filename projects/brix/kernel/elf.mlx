// An x86-64 ELF program in a file of the file system: a static one (what
// mlx4 and mlx-ld write), or a shared object (ET_DYN: a position-
// independent program, or the dynamic loader a program's PT_INTERP
// names, mlxlibc); its entry, its loadable segments, and their bytes
// copied into an address space.
const vfs = @import("./vfs.mlx")
const memory = @import("./memory.mlx")
const Bytes = @import("./bytes.mlx").Bytes

pub const Segment = struct {
    offset: usize
    address: usize
    fileSize: usize
    memorySize: usize
}

pub const Elf = struct {
    pub const HEADER_SIZE: usize = 56
    const FILE_HEADER_SIZE: usize = 64
    const PT_LOAD: usize = 1
    const PT_INTERP: usize = 3
    const ET_EXEC: usize = 2
    const ET_DYN: usize = 3
    const CHUNK: usize = 512

    node: usize
    size: usize
    header: [FILE_HEADER_SIZE]u8

    // The program in the file `node`.
    pub fn open(node: usize) -> Elf {
        var elf: Elf = undefined
        elf.node = node
        elf.size = vfs.fileSystem().node(node).*.size
        Bytes.fill(&elf.header, FILE_HEADER_SIZE, 0)
        _ = vfs.fileSystem().read(node, 0, &elf.header, FILE_HEADER_SIZE)
        return elf
    }

    // An executable or a shared object for x86-64 (ELF64, little endian,
    // ET_EXEC or ET_DYN).
    pub fn isProgram(self: *const Self) -> bool {
        if self.*.size < FILE_HEADER_SIZE { return false }
        const d: [*]const u8 = &self.*.header
        if d[0] != 0x7F || d[1] != 69 || d[2] != 76 || d[3] != 70 || d[4] != 2 || d[5] != 1 { return false }
        const kind = Bytes.read16(d, 16)
        if (kind != ET_EXEC && kind != ET_DYN) || Bytes.read16(d, 18) != 62 { return false }
        return self.headerOffset() + self.headerCount() * HEADER_SIZE <= self.*.size
    }

    // Position-independent (ET_DYN): loaded wherever the kernel puts it,
    // its addresses relative to that.
    pub fn isShared(self: *const Self) -> bool { return Bytes.read16(&self.*.header, 16) == ET_DYN }

    // The path its PT_INTERP names (NUL-terminated in `into`): its length,
    // 0 when it names none (or one longer than `capacity` - 1).
    pub fn interpreter(self: *const Self, into: [*]u8, capacity: usize) -> usize {
        var k: usize = 0
        while k < self.headerCount() {
            var bytes: [HEADER_SIZE]u8 = undefined
            _ = vfs.fileSystem().read(self.*.node, self.headerOffset() + k * HEADER_SIZE, &bytes, HEADER_SIZE)
            if Bytes.read32(&bytes, 0) == PT_INTERP {
                const offset = Bytes.read64(&bytes, 8)
                var length = Bytes.read64(&bytes, 32)
                if length == 0 || length >= capacity || offset + length > self.*.size { return 0 }
                _ = vfs.fileSystem().read(self.*.node, offset, into, length)
                // (The size counts its NUL.)
                while length > 0 && into[length - 1] == 0 { length -= 1 }
                into[length] = 0
                return length
            }
            k += 1
        }
        return 0
    }

    pub fn entry(self: *const Self) -> usize { return Bytes.read64(&self.*.header, 24) }
    pub fn headerOffset(self: *const Self) -> usize { return Bytes.read64(&self.*.header, 32) }
    pub fn headerCount(self: *const Self) -> usize { return Bytes.read16(&self.*.header, 56) }

    // Program header `index` into `into`; whether it is a loadable
    // segment.
    pub fn segment(self: *const Self, index: usize, into: *Segment) -> bool {
        var bytes: [HEADER_SIZE]u8 = undefined
        _ = vfs.fileSystem().read(self.*.node, self.headerOffset() + index * HEADER_SIZE, &bytes, HEADER_SIZE)
        into.*.offset = Bytes.read64(&bytes, 8)
        into.*.address = Bytes.read64(&bytes, 16)
        into.*.fileSize = Bytes.read64(&bytes, 32)
        into.*.memorySize = Bytes.read64(&bytes, 40)
        return Bytes.read32(&bytes, 0) == PT_LOAD
    }

    // `length` bytes of the file from `offset` into `target` at `address`;
    // false when memory is out.
    pub fn copy(self: *const Self, offset: usize, length: usize, target: memory.Space, address: usize) -> bool {
        var buffer: [CHUNK]u8 = undefined
        var done: usize = 0
        while done < length {
            const chunk = if length - done > CHUNK { CHUNK } else { length - done }
            _ = vfs.fileSystem().read(self.*.node, offset + done, &buffer, chunk)
            if !target.write(address + done, &buffer, chunk) { return false }
            done += chunk
        }
        return true
    }
}
