// A static x86-64 ELF program (what mlx4 and mlx-ld write): its entry and
// its loadable segments.
const Bytes = @import("./bytes.mlx").Bytes

pub const Segment = struct {
    offset: usize
    address: usize
    fileSize: usize
    memorySize: usize
}

pub const Elf = struct {
    pub const HEADER_SIZE: usize = 56
    const PT_LOAD: usize = 1

    data: [*]const u8
    size: usize

    // An executable for x86-64 (ELF64, little endian, ET_EXEC).
    pub fn isProgram(self: Self) -> bool {
        if self.size < 64 { return false }
        const d = self.data
        if d[0] != 0x7F || d[1] != 69 || d[2] != 76 || d[3] != 70 || d[4] != 2 || d[5] != 1 { return false }
        if Bytes.read16(d, 16) != 2 || Bytes.read16(d, 18) != 62 { return false }
        return self.headerOffset() + self.headerCount() * HEADER_SIZE <= self.size
    }

    pub fn entry(self: Self) -> usize { return Bytes.read64(self.data, 24) }
    pub fn headerOffset(self: Self) -> usize { return Bytes.read64(self.data, 32) }
    pub fn headerCount(self: Self) -> usize { return Bytes.read16(self.data, 56) }

    pub fn isLoadable(self: Self, index: usize) -> bool { return Bytes.read32(self.data, self.headerOffset() + index * HEADER_SIZE) == PT_LOAD }

    pub fn segment(self: Self, index: usize) -> Segment {
        const at = self.headerOffset() + index * HEADER_SIZE
        return Segment.{ .offset = Bytes.read64(self.data, at + 8), .address = Bytes.read64(self.data, at + 16), .fileSize = Bytes.read64(self.data, at + 32), .memorySize = Bytes.read64(self.data, at + 40) }
    }

    // The bytes of the file from `offset` on.
    pub fn bytesAt(self: Self, offset: usize) -> [*]const u8 { return unsafe { @ptrFromInt([*]const u8, @intFromPtr(self.data) + offset) } }
}
