// What a monitor says of itself (its EDID, as the EFI loader got it from
// the firmware: the base block and the first extension block), read for
// the monitor's own timing: the numbers the GPU's driver needs to send the
// monitor its own mode (gpu_mode.mlx), where the firmware only offers
// smaller ones. And, for an output whose clock has a limit (a TMDS link:
// HDMI or DVI signalling), what else the EDID offers (`offer`): every
// plain timing of the monitor's own size, should the one taken not fit
// the link, and whether the monitor says it is an HDMI one and up to
// which clock.
//
// The layout is the standard's (VESA E-EDID 1.4; the extension blocks'
// CTA-861 and DisplayID 1.3 and 2.0), held against Linux 6.6's reading of
// it (drivers/gpu/drm/drm_edid.c: drm_mode_detailed, drm_mode_displayid_
// detailed; drm_displayid.c):
// - the base block: eight bytes of header, the sum of all 128 bytes 0 in
//   eight bits, four descriptors of 18 bytes from byte 54, one a detailed
//   timing when its first two bytes (the pixel clock in 10 kHz) are not 0;
//   the first of them is the mode the monitor prefers: its own; one for
//   an interlaced picture or for stereo glasses (the last byte's bit 7,
//   bits 6 and 5) is not one to send a plain picture with;
// - a CTA-861 extension (tag 2): detailed timings of the same 18 bytes
//   from the offset its byte 2 names to the block's end;
// - a DisplayID extension (tag 0x70): a section of data blocks, of which
//   type I (tag 3, the clock in 10 kHz) and type VII (tag 0x22, in kHz)
//   are detailed timings of 20 bytes, every number stored less one
//   (their options byte: bit 4 interlaced, bits 6 and 5 as 1 stereo
//   only);
// - a CTA-861 extension of revision 3 and later has data blocks from its
//   byte 4 to where its timings begin (cea_db_collection_size), each a
//   byte of tag (the upper three bits) and length (the lower five) and
//   that many bytes: a vendor's block (tag 3) begins with the vendor's
//   number in three bytes, the lowest first; HDMI's is 0x000C03 with five
//   bytes at least (cea_db_is_hdmi_vsdb), and says in its byte 7, when it
//   has seven, the monitor's highest TMDS clock in 5 MHz and in the one
//   before it the deeper colours it takes (drm_parse_hdmi_vsdb_video,
//   drm_parse_hdmi_deep_color_info); the HDMI Forum's is 0xC45DD8 with
//   seven bytes at least (its byte 5 the highest character rate in 5 MHz,
//   bit 7 of its byte 6 that the monitor has the status and control
//   channel that scrambling is switched by: drm_parse_hdmi_forum_scds).
//   The extension's own byte 3 says with bit 5 that the monitor takes
//   YCbCr 4:4:4.
//
// The monitor's own size is its preferred timing's (the base block's
// first, else the extension's first). Of the timings of that size the one
// to use is the least demanding: the lowest refresh rate of at least 50
// Hz, so that the link and the pixel clock have the most room (a monitor
// of 144 Hz lists 60 Hz for the same picture).
//
// Nothing of the kernel's is used here: the file is built for the host
// too (tests/459_edid_timing_runtime.mlx; `offer` in tests/475_gpu_tmds_
// blocks_runtime.mlx).

pub const BLOCK: usize = 128
// How many timings of the monitor's own size are kept for an output to
// choose from.
pub const OWN: usize = 8

// One detailed timing: the pixel clock in kHz, and across and down the
// size shown, the total, how long after the picture the sync pulse
// begins (the front porch) and how long it is, and whether the pulse is
// the high one.
pub const Timing = struct {
    clock: usize
    width: usize
    hTotal: usize
    hFront: usize
    hSync: usize
    hPositive: bool
    height: usize
    vTotal: usize
    vFront: usize
    vSync: usize
    vPositive: bool
    interlaced: bool
    // For a picture of two views (stereo glasses): the monitor expects
    // the views in turn or side by side, not a plain picture.
    stereo: bool

    // Frames in a thousand seconds.
    pub fn millihertz(self: *const Self) -> usize {
        const frame = self.*.hTotal * self.*.vTotal
        if frame == 0 { return 0 }
        return self.*.clock * 1000000 / frame
    }

    // Whether the numbers are a timing at all: a picture, blanking that
    // holds the porch and the pulse, a clock.
    pub fn sound(self: *const Self) -> bool {
        if self.*.clock == 0 || self.*.width == 0 || self.*.height == 0 { return false }
        if self.*.hSync == 0 || self.*.vSync == 0 { return false }
        if self.*.hTotal < self.*.width + self.*.hFront + self.*.hSync { return false }
        return self.*.vTotal >= self.*.height + self.*.vFront + self.*.vSync
    }
}

// What was found.
pub const State = enum(u8) {
    // No EDID was given (the firmware has none for this display).
    none,
    // The bytes are no EDID: the header is not there.
    no_header,
    // The base block's bytes do not add up.
    bad_checksum,
    // An EDID without a detailed timing: the monitor's own size is not
    // known.
    no_timing,
    // The own size is known, but every timing of it is interlaced or
    // for stereo.
    interlaced,
    // `timing` is the monitor's own.
    found
}

// What the extension block is.
pub const Extension = enum(u8) { none, bad_checksum, cta, displayid, other }

pub const Monitor = struct {
    state: State
    // The monitor's own size (0: not known).
    width: usize
    height: usize
    // The timing to send it, when state is found.
    timing: Timing
    // How many detailed timings the EDID has in all and of the own size,
    // and what its extension block is.
    timings: usize
    ofOwnSize: usize
    extension: Extension
}

fn none() -> Timing {
    return Timing.{ .clock = 0, .width = 0, .hTotal = 0, .hFront = 0, .hSync = 0, .hPositive = false, .height = 0, .vTotal = 0, .vFront = 0, .vSync = 0, .vPositive = false, .interlaced = false, .stereo = false }
}

// Whether `count` bytes from `at` add up to 0 in eight bits.
fn addsUp(bytes: []const u8, at: usize, count: usize) -> bool {
    var sum: usize = 0
    var k: usize = 0
    while k < count {
        sum += @intCast(usize, bytes[at + k])
        k += 1
    }
    return sum & 0xFF == 0
}

fn byte(bytes: []const u8, at: usize) -> usize { return @intCast(usize, bytes[at]) }

fn word(bytes: []const u8, at: usize) -> usize { return byte(bytes, at) | (byte(bytes, at + 1) << 8) }

// The 18 bytes at `at` as a detailed timing (drm_mode_detailed): twelve
// bits each for the sizes and the blankings, ten for the horizontal porch
// and pulse, six for the vertical ones; the last byte's bit 7 interlaced,
// its bits 6 and 5 stereo when either is set (bit 0 then says which
// kind), and, for separate digital sync (bits 4 and 3), bit 2 the vertical
// and bit 1 the horizontal pulse's being the high one.
fn detailed(bytes: []const u8, at: usize) -> Timing {
    var t = none()
    t.clock = word(bytes, at) * 10
    t.width = byte(bytes, at + 2) | ((byte(bytes, at + 4) & 0xF0) << 4)
    t.hTotal = t.width + (byte(bytes, at + 3) | ((byte(bytes, at + 4) & 0x0F) << 8))
    t.height = byte(bytes, at + 5) | ((byte(bytes, at + 7) & 0xF0) << 4)
    t.vTotal = t.height + (byte(bytes, at + 6) | ((byte(bytes, at + 7) & 0x0F) << 8))
    const high = byte(bytes, at + 11)
    t.hFront = byte(bytes, at + 8) | ((high & 0xC0) << 2)
    t.hSync = byte(bytes, at + 9) | ((high & 0x30) << 4)
    t.vFront = (byte(bytes, at + 10) >> 4) | ((high & 0x0C) << 2)
    t.vSync = (byte(bytes, at + 10) & 0x0F) | ((high & 0x03) << 4)
    const flags = byte(bytes, at + 17)
    t.interlaced = flags & 0x80 != 0
    t.stereo = flags & 0x60 != 0
    if flags & 0x18 == 0x18 {
        t.vPositive = flags & 0x04 != 0
        t.hPositive = flags & 0x02 != 0
    } else if flags & 0x18 == 0x10 {
        // (Composite digital sync: one pulse, its polarity in bit 1.)
        t.hPositive = flags & 0x02 != 0
    }
    return t
}

// The 20 bytes at `at` as a DisplayID detailed timing (drm_mode_displayid_
// detailed): every number less one, the clock in three bytes (in 10 kHz,
// in kHz for type VII), bit 7 of the porches' upper bytes the pulses'
// being the high ones, bit 4 of the options byte interlaced, its bits 6
// and 5 as 1 a timing for stereo alone (as 2: for either, taken).
fn detailedDisplayId(bytes: []const u8, at: usize, kilohertz: bool) -> Timing {
    var t = none()
    const clock = (byte(bytes, at) | (byte(bytes, at + 1) << 8) | (byte(bytes, at + 2) << 16)) + 1
    t.clock = if kilohertz { clock } else { clock * 10 }
    t.interlaced = byte(bytes, at + 3) & 0x10 != 0
    t.stereo = byte(bytes, at + 3) & 0x60 == 0x20
    t.width = word(bytes, at + 4) + 1
    t.hTotal = t.width + word(bytes, at + 6) + 1
    t.hFront = (word(bytes, at + 8) & 0x7FFF) + 1
    t.hPositive = byte(bytes, at + 9) & 0x80 != 0
    t.hSync = word(bytes, at + 10) + 1
    t.height = word(bytes, at + 12) + 1
    t.vTotal = t.height + word(bytes, at + 14) + 1
    t.vFront = (word(bytes, at + 16) & 0x7FFF) + 1
    t.vPositive = byte(bytes, at + 17) & 0x80 != 0
    t.vSync = word(bytes, at + 18) + 1
    return t
}

// The timings as they are gone through: the first one names the own size,
// and of those of that size the best so far is kept.
const Search = struct {
    monitor: *Monitor
    best: Timing
    // The best's frames in a thousand seconds (0: none yet).
    rate: usize
    onlyInterlaced: bool
    // Where every plain timing of the own size is kept beside (none: they
    // are not asked for).
    list: ?*Offer

    fn take(self: *Self, t: *const Timing) -> void {
        if !t.sound() { return }
        const m = self.*.monitor
        m.*.timings += 1
        if m.*.width == 0 {
            m.*.width = t.*.width
            m.*.height = t.*.height
        }
        if t.*.width != m.*.width || t.*.height != m.*.height { return }
        m.*.ofOwnSize += 1
        if t.*.interlaced || t.*.stereo { return }
        self.*.onlyInterlaced = false
        if self.*.list != null && self.*.list.?.*.count < OWN {
            const list = self.*.list.?
            list.*.timings[list.*.count] = t.*
            list.*.count += 1
        }
        const rate = t.millihertz()
        if self.*.rate == 0 || better(rate, self.*.rate) {
            self.*.best = t.*
            self.*.rate = rate
        }
    }
}

// Whether a timing of `rate` (frames in a thousand seconds) is the one to
// take before one of `kept`: at least 50 Hz and the lower of such; below
// that only when there is nothing else, and then the higher.
pub fn better(rate: usize, kept: usize) -> bool {
    if rate >= 50000 { return kept < 50000 || rate < kept }
    return kept < 50000 && rate > kept
}

// The EDID in `bytes` (none, the base block, or the base block and as
// many of its extension blocks as there are bytes for) read: the
// monitor's own size and the timing to send it.
pub fn read(bytes: []const u8) -> Monitor { return scan(bytes, null) }

fn scan(bytes: []const u8, list: ?*Offer) -> Monitor {
    var m = Monitor.{ .state = State.none, .width = 0, .height = 0, .timing = none(), .timings = 0, .ofOwnSize = 0, .extension = Extension.none }
    if bytes.length < BLOCK { return m }
    var k: usize = 0
    while k < 8 {
        const wanted: u8 = if k == 0 || k == 7 { 0 } else { 0xFF }
        if bytes[k] != wanted {
            m.state = State.no_header
            return m
        }
        k += 1
    }
    if !addsUp(bytes, 0, BLOCK) {
        m.state = State.bad_checksum
        return m
    }
    var search = Search.{ .monitor = &m, .best = none(), .rate = 0, .onlyInterlaced = true, .list = list }
    k = 0
    while k < 4 {
        const at = 54 + k * 18
        if word(bytes, at) != 0 {
            const t = detailed(bytes, at)
            search.take(&t)
        }
        k += 1
    }
    // The extension blocks, as many as the base block says there are and
    // the loader passed on. (What the first one is, is kept for the log;
    // a later one that does not add up is left out without a word.)
    var number: usize = 1
    while number <= byte(bytes, 126) && (number + 1) * BLOCK <= bytes.length {
        const ext = number * BLOCK
        var kind = Extension.other
        if !addsUp(bytes, ext, BLOCK) {
            kind = Extension.bad_checksum
        } else if bytes[ext] == 0x02 {
            kind = Extension.cta
            // (An offset of 0: no timings; below 4 it is no offset.)
            var at = ext + byte(bytes, ext + 2)
            if at >= ext + 4 {
                while at + 18 <= ext + BLOCK - 1 && word(bytes, at) != 0 {
                    const t = detailed(bytes, at)
                    search.take(&t)
                    at += 18
                }
            }
        } else if bytes[ext] == 0x70 {
            // The section: its revision, how many bytes of data blocks,
            // two more bytes, the blocks, and a checksum of its own.
            const length = byte(bytes, ext + 2)
            if ext + 5 + length + 1 <= ext + BLOCK - 1 && addsUp(bytes, ext + 1, 4 + length + 1) {
                kind = Extension.displayid
                var at = ext + 5
                const end = ext + 5 + length
                while at + 3 <= end {
                    const tag = bytes[at]
                    const size = byte(bytes, at + 2)
                    if at + 3 + size > end { break }
                    if tag == 0x03 || tag == 0x22 {
                        var one = at + 3
                        while one + 20 <= at + 3 + size {
                            const t = detailedDisplayId(bytes, one, tag == 0x22)
                            search.take(&t)
                            one += 20
                        }
                    }
                    at += 3 + size
                }
            } else {
                kind = Extension.bad_checksum
            }
        }
        if number == 1 { m.extension = kind }
        number += 1
    }
    if m.width == 0 {
        m.state = State.no_timing
    } else if search.rate == 0 {
        m.state = State.interlaced
    } else {
        m.state = State.found
        m.timing = search.best
    }
    return m
}

// What the EDID offers beside the timing taken: every plain timing of the
// monitor's own size (the first OWN of them, in the EDID's order), how
// many extension blocks the EDID has and how many of them were there to
// be read, and what the data blocks of its CTA extensions say of HDMI:
// whether the HDMI vendor's block is there (the monitor is an HDMI one;
// without it Linux sends DVI signalling: dc/link/link_detection.c,
// "HDMI-DVI Dongle"), the highest TMDS clock the monitor names for itself
// in kHz (0: none named), whether it takes more than eight bits a colour
// or YCbCr 4:4:4 (Linux's display core would send those; this driver
// sends RGB at eight bits), and the HDMI Forum's block's highest
// character rate in kHz (0: no such block or none named) with whether
// the monitor has the channel scrambling is switched by.
pub const Offer = struct {
    timings: [OWN]Timing
    count: usize
    extensions: usize
    given: usize
    hdmi: bool
    limit: usize
    deep: bool
    ycbcr: bool
    forumLimit: usize
    scdc: bool
}

// An offer of nothing (no EDID was read for one).
pub fn nothing() -> Offer {
    var o: Offer = undefined
    o.count = 0
    o.extensions = 0
    o.given = 0
    o.hdmi = false
    o.limit = 0
    o.deep = false
    o.ycbcr = false
    o.forumLimit = 0
    o.scdc = false
    return o
}

pub fn offer(bytes: []const u8) -> Offer {
    var o = nothing()
    const m = scan(bytes, &o)
    if m.state == State.none || m.state == State.no_header || m.state == State.bad_checksum { return o }
    o.extensions = byte(bytes, 126)
    var number: usize = 1
    while number <= o.extensions && (number + 1) * BLOCK <= bytes.length {
        const ext = number * BLOCK
        o.given += 1
        // A CTA extension of revision 3 and later that adds up: its data
        // blocks from byte 4 to where the timings begin.
        const end = byte(bytes, ext + 2)
        if addsUp(bytes, ext, BLOCK) && bytes[ext] == 0x02 && byte(bytes, ext + 1) >= 3 && end >= 4 && end <= 127 {
            if byte(bytes, ext + 3) & 0x20 != 0 { o.ycbcr = true }
            var at: usize = 4
            while at < end {
                const tag = byte(bytes, ext + at) >> 5
                const length = byte(bytes, ext + at) & 0x1F
                if at + 1 + length > end { break }
                const block = ext + at
                if tag == 3 && length >= 3 {
                    const vendor = byte(bytes, block + 1) | (byte(bytes, block + 2) << 8) | (byte(bytes, block + 3) << 16)
                    if vendor == 0x000C03 && length >= 5 {
                        o.hdmi = true
                        if length >= 6 && byte(bytes, block + 6) & 0x70 != 0 { o.deep = true }
                        if length >= 7 { o.limit = byte(bytes, block + 7) * 5000 }
                    } else if vendor == 0xC45DD8 && length >= 7 {
                        o.forumLimit = byte(bytes, block + 5) * 5000
                        o.scdc = byte(bytes, block + 6) & 0x80 != 0
                    }
                }
                at += 1 + length
            }
        }
        number += 1
    }
    return o
}

// A number in decimal, through `write`.
fn decimal(write: fn([]const u8) -> void, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    write(digits[at..20])
}

fn field(write: fn([]const u8) -> void, label: []const u8, value: usize) -> void {
    write(label)
    decimal(write, value)
}

// A timing as the log says it: "3840x1080 at 60.00 Hz: pixel clock 266640
// kHz, h 3840 4000 (front 48 sync 32 +), v 1080 1111 (front 3 sync 10 -)".
pub fn sayTiming(write: fn([]const u8) -> void, t: *const Timing) -> void {
    const rate = t.millihertz()
    field(write, "", t.*.width)
    field(write, "x", t.*.height)
    field(write, " at ", rate / 1000)
    const hundredths = rate % 1000 / 10
    field(write, if hundredths < 10 { ".0" } else { "." }, hundredths)
    field(write, " Hz: pixel clock ", t.*.clock)
    field(write, " kHz, h ", t.*.width)
    field(write, " ", t.*.hTotal)
    field(write, " (front ", t.*.hFront)
    field(write, " sync ", t.*.hSync)
    write(if t.*.hPositive { " +)" } else { " -)" })
    field(write, ", v ", t.*.height)
    field(write, " ", t.*.vTotal)
    field(write, " (front ", t.*.vFront)
    field(write, " sync ", t.*.vSync)
    write(if t.*.vPositive { " +)" } else { " -)" })
}

// What the EDID gave, as a line of the log; nothing when there was no
// EDID at all (`m.state` none: the caller knows whether that is worth a
// line).
pub fn say(write: fn([]const u8) -> void, m: *const Monitor) -> void {
    if m.*.state == State.none { return }
    if m.*.state == State.no_header {
        write("gpu: the monitor's EDID is none (its first bytes are not an EDID's): its own timing is not known\n")
    } else if m.*.state == State.bad_checksum {
        write("gpu: the monitor's EDID does not add up (a wrong checksum): its own timing is not taken from it\n")
    } else if m.*.state == State.no_timing {
        write("gpu: the monitor's EDID has no detailed timing: its own timing is not known\n")
    } else if m.*.state == State.interlaced {
        field(write, "gpu: the monitor's EDID has only interlaced or stereo timings of its own size, ", m.*.width)
        field(write, "x", m.*.height)
        write(": none is taken\n")
    } else {
        write("gpu: the monitor's own timing is ")
        sayTiming(write, &m.*.timing)
        if m.*.ofOwnSize > 1 {
            field(write, " (the least demanding of ", m.*.ofOwnSize)
            write(" of that size)")
        }
        write("\n")
    }
    if m.*.extension == Extension.bad_checksum { write("gpu: the EDID's extension block does not add up: left out\n") }
}

// What the EDID says of HDMI, as a line of the log (for a monitor whose
// own timing was found): "gpu: the monitor says it is an HDMI one, up to
// 300 MHz", with what it offers beyond plain pictures, or that it has no
// HDMI block; and that blocks of the EDID were not passed on, when there
// are more than were read.
pub fn sayOffer(write: fn([]const u8) -> void, m: *const Monitor, o: *const Offer) -> void {
    if m.*.state != State.found { return }
    if o.*.hdmi {
        write("gpu: the monitor says it is an HDMI one")
        if o.*.limit != 0 {
            field(write, ", up to ", o.*.limit / 1000)
            write(" MHz")
        } else {
            write(" and names no highest clock")
        }
        if o.*.forumLimit != 0 {
            field(write, " (", o.*.forumLimit / 1000)
            write(if o.*.scdc { " MHz with scrambling, which is not built here)" } else { " MHz by the HDMI Forum's block)" })
        }
        if o.*.deep || o.*.ycbcr {
            write("; it offers")
            if o.*.ycbcr { write(" YCbCr 4:4:4") }
            if o.*.deep { write(if o.*.ycbcr { " and more than 8 bits a colour" } else { " more than 8 bits a colour" }) }
            write(" and is sent RGB at 8 bits")
        }
        write("\n")
    } else {
        write("gpu: the monitor's EDID has no HDMI block: DVI signalling, 165 MHz at most\n")
    }
    if o.*.extensions > o.*.given {
        field(write, "gpu: the monitor's EDID has ", o.*.extensions)
        field(write, if o.*.extensions == 1 { " extension block, the loader passed on " } else { " extension blocks, the loader passed on " }, o.*.given)
        write(": what the others say is not known\n")
    }
}
