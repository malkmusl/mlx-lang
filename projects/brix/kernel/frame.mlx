// A trap frame, as the boot blob's common trap path makes it on the trap
// stack: the registers it pushed (r15 first), the vector and error code
// the stub pushed, then what the processor pushed (or the SYSCALL entry,
// for a system call).
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const console = @import("./console.mlx")
const Bytes = @import("./bytes.mlx").Bytes

pub const Frame = struct {
    r15: usize
    r14: usize
    r13: usize
    r12: usize
    r11: usize
    r10: usize
    r9: usize
    r8: usize
    rbp: usize
    rdi: usize
    rsi: usize
    rdx: usize
    rcx: usize
    rbx: usize
    rax: usize
    vector: usize
    code: usize
    rip: usize
    cs: usize
    rflags: usize
    rsp: usize
    ss: usize

    // RFLAGS for user mode: IF and the reserved bit 1.
    const USER_FLAGS: usize = 0x202

    // The frame at the address the trap path gives.
    pub fn at(address: usize) -> *Frame { return unsafe { @ptrFromInt(*Frame, address) } }

    // The SSE registers the trap path keeps (FXSAVE's image) below the
    // frame; they are the interrupted code's, restored on return.
    pub fn sse(self: *const Self) -> [*]u8 { return Bytes.pointer(@intFromPtr(self) - Sse.SIZE) }

    pub fn fromUser(self: *const Self) -> bool { return self.*.cs & 3 == 3 }

    pub fn isSystemCall(self: *const Self) -> bool { return self.*.vector == layout.Vector.SYSCALL && self.fromUser() }

    // On return, user mode at `entry` with the stack at `stack`, every
    // register zero, the SSE registers too (a program's start).
    pub fn startAt(self: *Self, entry: usize, stack: usize) -> void {
        self.setStart(entry, stack)
        Sse.reset(self.sse())
    }

    // The registers of a program's start (a frame kept in a process,
    // which has its SSE registers apart).
    pub fn setStart(self: *Self, entry: usize, stack: usize) -> void {
        self.*.r15 = 0
        self.*.r14 = 0
        self.*.r13 = 0
        self.*.r12 = 0
        self.*.r11 = 0
        self.*.r10 = 0
        self.*.r9 = 0
        self.*.r8 = 0
        self.*.rbp = 0
        self.*.rdi = 0
        self.*.rsi = 0
        self.*.rdx = 0
        self.*.rcx = 0
        self.*.rbx = 0
        self.*.rax = 0
        self.*.vector = 0
        self.*.code = 0
        self.*.rip = entry
        self.*.cs = layout.Selector.USER_CODE
        self.*.rflags = USER_FLAGS
        self.*.rsp = stack
        self.*.ss = layout.Selector.USER_DATA
    }

    // What and where, on the console.
    pub fn report(self: *const Self) -> void {
        const out = console.out
        out.write("\nbrixOS: ")
        out.write(Exception.name(self.*.vector))
        out.write(" (")
        out.decimal(self.*.vector)
        out.write(") at ")
        out.hex(self.*.rip)
        out.write(if self.fromUser() { " (user)" } else { " (kernel)" })
        out.write(", processor ")
        out.decimal(cpu.Cpu.id())
        out.write(", error ")
        out.hex(self.*.code)
        if self.*.vector == Exception.PAGE_FAULT {
            out.write(", address ")
            out.hex(cpu.Cpu.faultAddress())
        }
        out.write("\n  rax ")
        out.hex(self.*.rax)
        out.write(" rbx ")
        out.hex(self.*.rbx)
        out.write(" rcx ")
        out.hex(self.*.rcx)
        out.write(" rdx ")
        out.hex(self.*.rdx)
        out.write("\n  rsi ")
        out.hex(self.*.rsi)
        out.write(" rdi ")
        out.hex(self.*.rdi)
        out.write(" rbp ")
        out.hex(self.*.rbp)
        out.write(" rsp ")
        out.hex(self.*.rsp)
        out.write("\n  r8 ")
        out.hex(self.*.r8)
        out.write(" r9 ")
        out.hex(self.*.r9)
        out.write(" r10 ")
        out.hex(self.*.r10)
        out.write(" r11 ")
        out.hex(self.*.r11)
        out.write("\n  r12 ")
        out.hex(self.*.r12)
        out.write(" r13 ")
        out.hex(self.*.r13)
        out.write(" r14 ")
        out.hex(self.*.r14)
        out.write(" r15 ")
        out.hex(self.*.r15)
        out.write("\n")
        // In the kernel: the callers, by the frame pointers (the kernel
        // at Memory.KERNEL, linked at LINK_BASE: the symbol table names
        // the "link" addresses).
        if self.fromUser() { return }
        var rbp = self.*.rbp
        var depth: usize = 0
        while depth < 16 && rbp >= layout.Memory.KERNEL_VIRTUAL + layout.Memory.KERNEL && rbp < layout.Memory.KERNEL_VIRTUAL + layout.Memory.MAPPED_LIMIT {
            const back = unsafe { @ptrFromInt(*const usize, rbp + 8) }.*
            if back < layout.Memory.KERNEL_VIRTUAL + layout.Memory.KERNEL { break }
            out.write("  from ")
            out.hex(back)
            out.write(" (link ")
            out.hex(back - layout.Memory.KERNEL_VIRTUAL - layout.Memory.KERNEL + layout.Memory.LINK_BASE)
            out.write(")\n")
            rbp = unsafe { @ptrFromInt(*const usize, rbp) }.*
            depth += 1
        }
    }
}

// The SSE registers (x87, MXCSR, XMM0 to XMM15) as FXSAVE writes them.
pub const Sse = struct {
    pub const SIZE: usize = 512
    const CONTROL_WORD: usize = 0
    const MXCSR: usize = 24

    // A program's start: every exception masked, round to nearest,
    // registers zero.
    pub fn reset(area: [*]u8) -> void {
        Bytes.fill(area, SIZE, 0)
        Bytes.write16(area, CONTROL_WORD, 0x037F)
        Bytes.write32(area, MXCSR, 0x1F80)
    }
}

// The processor's exceptions (vectors 0 to 31).
pub const Exception = struct {
    pub const NMI: usize = 2
    pub const INVALID_OPCODE: usize = 6
    pub const PAGE_FAULT: usize = 14
    // A page fault's error code: the page was there (the access was not
    // allowed), the access was a write.
    pub const PRESENT: usize = 1
    pub const WRITE: usize = 2
    pub const COUNT: usize = 32

    pub fn name(vector: usize) -> []const u8 {
        if vector == 0 { return "divide error" }
        if vector == 1 { return "debug" }
        if vector == 2 { return "NMI" }
        if vector == 3 { return "breakpoint" }
        if vector == 4 { return "overflow" }
        if vector == 5 { return "bound range" }
        if vector == INVALID_OPCODE { return "invalid opcode (a failed runtime check)" }
        if vector == 7 { return "no FPU" }
        if vector == 8 { return "double fault" }
        if vector == 10 { return "invalid TSS" }
        if vector == 11 { return "segment not present" }
        if vector == 12 { return "stack fault" }
        if vector == 13 { return "general protection" }
        if vector == PAGE_FAULT { return "page fault" }
        if vector == 16 { return "x87 error" }
        if vector == 17 { return "alignment check" }
        if vector == 18 { return "machine check" }
        if vector == 19 { return "SIMD error" }
        if vector == layout.Vector.SYSCALL { return "system call" }
        return "vector"
    }
}
