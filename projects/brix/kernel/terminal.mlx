// The serial line as a terminal: the termios a program sets (TCSETS) and
// what it means here. Output: OPOST with ONLCR turns "\n" into "\r\n".
// Input: canonical mode (ICANON) edits a line (ECHO, erase, kill, EOF)
// and gives it at its end; raw mode gives the bytes as they come. ICRNL
// turns the carriage return a terminal sends for Enter into "\n".
const serial = @import("./serial.mlx")
const Bytes = @import("./bytes.mlx").Bytes

pub const Terminal = struct {
    // struct termios (Linux's kernel layout): four flag words, the line
    // discipline, the control characters.
    pub const TERMIOS_SIZE: usize = 36
    pub const LINE_CAPACITY: usize = 1024
    const INPUT_FLAGS: usize = 0
    const OUTPUT_FLAGS: usize = 4
    const CONTROL_FLAGS: usize = 8
    const LOCAL_FLAGS: usize = 12
    const CHARACTERS: usize = 17
    const ICRNL: usize = 0x100
    const OPOST: usize = 0x1
    const ONLCR: usize = 0x4
    const ICANON: usize = 0x2
    const ECHO: usize = 0x8
    const VINTR: usize = 0
    const VQUIT: usize = 1
    const VERASE: usize = 2
    const VKILL: usize = 3
    const VEOF: usize = 4
    const VMIN: usize = 6
    const BACKSPACE: u8 = 8

    uart: serial.Uart
    termios: [TERMIOS_SIZE]u8
    line: [LINE_CAPACITY]u8
    lineLength: usize
    lineReady: usize
    lineGiven: usize

    // A cooked terminal on `uart`: ICRNL IXON, OPOST ONLCR, B38400 CS8
    // CREAD, ISIG ICANON ECHO ECHOE ECHOK ECHOCTL ECHOKE IEXTEN, the
    // usual characters.
    pub fn init(self: *Self, uart: serial.Uart) -> void {
        self.*.uart = uart
        Bytes.fill(&self.*.termios, TERMIOS_SIZE, 0)
        Bytes.write32(&self.*.termios, INPUT_FLAGS, 0x500)
        Bytes.write32(&self.*.termios, OUTPUT_FLAGS, 0x5)
        Bytes.write32(&self.*.termios, CONTROL_FLAGS, 0xBF)
        Bytes.write32(&self.*.termios, LOCAL_FLAGS, 0x8A3B)
        self.*.termios[CHARACTERS + VINTR] = 3
        self.*.termios[CHARACTERS + VQUIT] = 28
        self.*.termios[CHARACTERS + VERASE] = 127
        self.*.termios[CHARACTERS + VKILL] = 21
        self.*.termios[CHARACTERS + VEOF] = 4
        self.*.termios[CHARACTERS + VMIN] = 1
        self.*.lineLength = 0
        self.*.lineReady = 0
        self.*.lineGiven = 0
    }

    fn flags(self: *const Self, which: usize) -> usize { return Bytes.read32(&self.*.termios, which) }

    fn character(self: *const Self, which: usize) -> u8 { return self.*.termios[CHARACTERS + which] }

    pub fn getAttributes(self: *const Self, into: [*]u8) -> void { Bytes.copy(into, &self.*.termios, TERMIOS_SIZE) }

    pub fn setAttributes(self: *Self, from: [*]const u8) -> void { Bytes.copy(&self.*.termios, from, TERMIOS_SIZE) }

    pub fn write(self: *const Self, bytes: [*]const u8, length: usize) -> void {
        const translate = self.flags(OUTPUT_FLAGS) & (OPOST | ONLCR) == (OPOST | ONLCR)
        var k: usize = 0
        while k < length {
            if bytes[k] == 10 && translate { self.*.uart.put(13) }
            self.*.uart.put(bytes[k])
            k += 1
        }
    }

    fn input(self: *const Self) -> u8 {
        const byte = self.*.uart.get()
        if byte == 13 && self.flags(INPUT_FLAGS) & ICRNL != 0 { return 10 }
        return byte
    }

    fn rubOut(self: *const Self, echo: bool) -> void {
        if !echo { return }
        self.*.uart.put(BACKSPACE)
        self.*.uart.put(32)
        self.*.uart.put(BACKSPACE)
    }

    // A line edited in canonical mode; false at EOF on an empty line.
    fn editLine(self: *Self) -> bool {
        self.*.lineLength = 0
        self.*.lineReady = 0
        self.*.lineGiven = 0
        const echo = self.flags(LOCAL_FLAGS) & ECHO != 0
        while true {
            const byte = self.input()
            if byte == self.character(VERASE) || byte == BACKSPACE {
                if self.*.lineLength > 0 {
                    self.*.lineLength -= 1
                    self.rubOut(echo)
                }
                continue
            }
            if byte == self.character(VKILL) {
                while self.*.lineLength > 0 {
                    self.*.lineLength -= 1
                    self.rubOut(echo)
                }
                continue
            }
            if byte == self.character(VEOF) {
                if self.*.lineLength == 0 { return false }
                break
            }
            if self.*.lineLength < LINE_CAPACITY - 1 {
                self.*.line[self.*.lineLength] = byte
                self.*.lineLength += 1
                if echo {
                    if byte == 10 { self.*.uart.put(13) }
                    self.*.uart.put(byte)
                }
            }
            if byte == 10 { break }
        }
        self.*.lineReady = self.*.lineLength
        return true
    }

    // Bytes for a read of at most `capacity` (at least one: it waits; 0
    // at EOF).
    pub fn read(self: *Self, into: [*]u8, capacity: usize) -> usize {
        if capacity == 0 { return 0 }
        if self.flags(LOCAL_FLAGS) & ICANON == 0 {
            into[0] = self.input()
            var count: usize = 1
            while count < capacity && self.*.uart.ready() {
                into[count] = self.input()
                count += 1
            }
            return count
        }
        if self.*.lineGiven >= self.*.lineReady && !self.editLine() { return 0 }
        var count: usize = 0
        while count < capacity && self.*.lineGiven < self.*.lineReady {
            into[count] = self.*.line[self.*.lineGiven]
            self.*.lineGiven += 1
            count += 1
        }
        return count
    }

    // Whether a read would give bytes now.
    pub fn pending(self: *const Self) -> bool { return self.*.lineGiven < self.*.lineReady || self.*.uart.ready() }
}

var console: Terminal = undefined // (per run)

// The terminal on the serial console.
pub fn serialConsole() -> *Terminal { return &console }
