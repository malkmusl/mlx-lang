// The processor's privileged instructions, which mlx4 does not emit: the
// kernel asks the boot blob's SYSCALL entry for them (from ring 0, told by
// a return address in the higher half; layout.OP_*). A SYSCALL keeps every
// register but rax (the result), rcx and r11.
const layout = @import("../layout.mlx")

extern("syscall") fn op1(number: usize, a1: usize) -> isize {}
extern("syscall") fn op2(number: usize, a1: usize, a2: usize) -> isize {}

pub fn outb(port: usize, value: usize) -> void { _ = op2(layout.OP_OUTB, port, value & 0xff) }
pub fn outw(port: usize, value: usize) -> void { _ = op2(layout.OP_OUTW, port, value & 0xffff) }
pub fn outl(port: usize, value: usize) -> void { _ = op2(layout.OP_OUTL, port, value & 0xffffffff) }
pub fn inb(port: usize) -> usize { return @bitCast(usize, op1(layout.OP_INB, port)) & 0xff }
pub fn inl(port: usize) -> usize { return @bitCast(usize, op1(layout.OP_INL, port)) & 0xffffffff }

// Interrupts on until the next one (sti; hlt; cli).
pub fn wait() -> void { _ = op1(layout.OP_WAIT, 0) }

pub fn readCr2() -> usize { return @bitCast(usize, op1(layout.OP_READ_CR2, 0)) }
pub fn readCr3() -> usize { return @bitCast(usize, op1(layout.OP_READ_CR3, 0)) }
pub fn writeCr3(value: usize) -> void { _ = op1(layout.OP_WRITE_CR3, value) }
pub fn invlpg(address: usize) -> void { _ = op1(layout.OP_INVLPG, address) }
pub fn wrmsr(msr: usize, value: usize) -> void { _ = op2(layout.OP_WRMSR, msr, value) }

// User mode at `rip` with the stack at `rsp` (every register zero,
// interrupts on); it does not come back (traps and system calls come to
// brix_trap).
pub fn enterUser(rip: usize, rsp: usize) -> void { _ = op2(layout.OP_ENTER_USER, rip, rsp) }

// The kernel's view of physical memory (all of the first GiB).
pub fn physical(address: usize) -> usize { return layout.KERNEL_VIRTUAL + address }

// The boot info's field at `offset` (layout.INFO_*), and setting it.
pub fn bootInfo(offset: usize) -> usize {
    const field: *usize = unsafe { @ptrFromInt(*usize, layout.blobVirtual(layout.BOOT_INFO + offset)) }
    return field.*
}

pub fn setBootInfo(offset: usize, value: usize) -> void {
    const field: *usize = unsafe { @ptrFromInt(*usize, layout.blobVirtual(layout.BOOT_INFO + offset)) }
    field.* = value
}

// The time-stamp counter.
pub fn rdtsc() -> usize { return @bitCast(usize, op1(layout.OP_RDTSC, 0)) }
