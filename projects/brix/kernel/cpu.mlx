// The processor's privileged instructions, which mlx4 does not emit: the
// kernel asks the boot blob's SYSCALL entry for them (from ring 0, told by
// a return address in the higher half; layout.Op). A SYSCALL keeps every
// register but rax (the result), rcx and r11.
const layout = @import("../layout.mlx")

extern("syscall") fn op1(number: usize, a1: usize) -> isize {}
extern("syscall") fn op2(number: usize, a1: usize, a2: usize) -> isize {}

// I/O ports.
pub const Port = struct {
    pub fn out8(port: usize, value: usize) -> void { _ = op2(layout.Op.OUTB, port, value & 0xff) }
    pub fn out16(port: usize, value: usize) -> void { _ = op2(layout.Op.OUTW, port, value & 0xffff) }
    pub fn out32(port: usize, value: usize) -> void { _ = op2(layout.Op.OUTL, port, value & 0xffffffff) }
    pub fn in8(port: usize) -> usize { return @bitCast(usize, op1(layout.Op.INB, port)) & 0xff }
    pub fn in16(port: usize) -> usize { return @bitCast(usize, op1(layout.Op.INW, port)) & 0xffff }
    pub fn in32(port: usize) -> usize { return @bitCast(usize, op1(layout.Op.INL, port)) & 0xffffffff }
}

pub const Cpu = struct {
    // Interrupts on until the next one (sti; hlt; cli).
    pub fn wait() -> void { _ = op1(layout.Op.WAIT, 0) }

    // The address of the last page fault.
    pub fn faultAddress() -> usize { return @bitCast(usize, op1(layout.Op.READ_CR2, 0)) }

    // The page tables in use (CR3), and switching them.
    pub fn pageTables() -> usize { return @bitCast(usize, op1(layout.Op.READ_CR3, 0)) }
    pub fn usePageTables(root: usize) -> void { _ = op1(layout.Op.WRITE_CR3, root) }

    pub fn invalidatePage(address: usize) -> void { _ = op1(layout.Op.INVLPG, address) }

    // The time-stamp counter.
    pub fn timestamp() -> usize { return @bitCast(usize, op1(layout.Op.RDTSC, 0)) }

    // User mode at `rip` with the stack at `rsp` (every register zero,
    // interrupts on); it does not come back (traps and system calls come
    // to brix_trap).
    pub fn enterUser(rip: usize, rsp: usize) -> void { _ = op2(layout.Op.ENTER_USER, rip, rsp) }

    // User mode from the trap frame whose SSE area is at `sse` (the
    // frame above it): the trap path's return; it does not come back.
    pub fn resume(sse: usize) -> void { _ = op1(layout.Op.RESUME, sse) }

    // This processor's number (0: the one that booted).
    pub fn id() -> usize { return @bitCast(usize, op1(layout.Op.CPU_ID, 0)) }

    // Between two looks of a loop that waits for another processor (the
    // kernel lock): the processor's own pause, which also gives the other
    // half of its core the time.
    pub fn relax() -> void { _ = op1(layout.Op.PAUSE, 0) }

    // What the processor says of itself for `leaf` and `subleaf` (CPUID):
    // its ECX above 32 bits, its EBX below; identifyMore: its EDX above,
    // its EAX below.
    pub fn identify(leaf: usize, subleaf: usize) -> usize { return @bitCast(usize, op2(layout.Op.CPUID, leaf, subleaf)) }
    pub fn identifyMore(leaf: usize, subleaf: usize) -> usize { return @bitCast(usize, op2(layout.Op.CPUID_AD, leaf, subleaf)) }

    // The highest leaf the processor answers (a higher one asked for gives
    // another leaf's words: not to be believed).
    fn leaves() -> usize { return identifyMore(0, 0) & 0xFFFFFFFF }

    // Whether the processor has a random number generator (RDRAND: leaf
    // 1, ECX bit 30) and lets its source be read (RDSEED: leaf 7, EBX bit
    // 18).
    pub fn hasRandom() -> bool { return leaves() >= 1 && ((identify(1, 0) >> 62) & 1) != 0 }
    pub fn hasRandomSource() -> bool { return leaves() >= 7 && ((identify(7, 0) >> 18) & 1) != 0 }

    // Four random words of the processor's into `into`: of its source
    // where it has one (RDSEED), else of its generator (RDRAND); each
    // asked for again a few times when the processor has none ready.
    // Whether it gave all four.
    pub fn randomWords(into: *[4]usize) -> bool {
        const source = hasRandomSource()
        if !source && !hasRandom() { return false }
        var k: usize = 0
        while k < 4 {
            var value: usize = 0
            var tries: usize = 0
            while value == 0 && tries < 64 {
                value = @bitCast(usize, op1(if source { layout.Op.RDSEED } else { layout.Op.RDRAND }, 0))
                if value == 0 { relax() }
                tries += 1
            }
            if value == 0 { return false }
            into.*[k] = value
            k += 1
        }
        return true
    }

    // This processor stopped for good (interrupts off, halted): at the
    // system's end. It does not come back.
    pub fn stop() -> void { _ = op1(layout.Op.STOP, 0) }

    // This processor reset by a fault it cannot take: the last way to
    // restart the machine. It does not come back.
    pub fn tripleFault() -> void { _ = op1(layout.Op.TRIPLE_FAULT, 0) }
}

// Model-specific registers.
pub const Msr = struct {
    pub const FS_BASE: usize = 0xC0000100

    // The local APIC's base and state (bit 10: x2APIC mode; bit 11: on).
    pub const APIC_BASE: usize = 0x1B

    pub fn write(msr: usize, value: usize) -> void { _ = op2(layout.Op.WRMSR, msr, value) }

    pub fn read(msr: usize) -> usize { return @bitCast(usize, op1(layout.Op.RDMSR, msr)) }
}

// The boot info the blob filled in (fields: layout.Info).
pub const BootInfo = struct {
    fn field(offset: usize) -> *usize { return unsafe { @ptrFromInt(*usize, layout.Blob.virtual(layout.Blob.BOOT_INFO + offset)) } }

    pub fn get(offset: usize) -> usize { return field(offset).* }

    // A field of this processor's block (layout.PerCpu).
    pub fn perCpu(offset: usize) -> usize {
        return unsafe { @ptrFromInt(*usize, layout.Blob.perCpuOf(Cpu.id()) + offset) }.*
    }
}
