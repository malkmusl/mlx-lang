// The processor's privileged instructions, which mlx4 does not emit: the
// kernel asks the boot blob's SYSCALL entry for them (from ring 0, told by
// a return address in the higher half; layout.Op). A SYSCALL keeps every
// register but rax (the result), rcx and r11.
const layout = @import("../layout.mlx")

extern("syscall") fn op1(number: usize, a1: usize) -> isize {}
extern("syscall") fn op2(number: usize, a1: usize, a2: usize) -> isize {}

// I/O ports.
pub const Port = struct {
    pub fn out8(port: usize, value: usize) -> void { _ = op2(layout.Op.OUTB, port, value & 0xff) }
    pub fn out16(port: usize, value: usize) -> void { _ = op2(layout.Op.OUTW, port, value & 0xffff) }
    pub fn out32(port: usize, value: usize) -> void { _ = op2(layout.Op.OUTL, port, value & 0xffffffff) }
    pub fn in8(port: usize) -> usize { return @bitCast(usize, op1(layout.Op.INB, port)) & 0xff }
    pub fn in16(port: usize) -> usize { return @bitCast(usize, op1(layout.Op.INW, port)) & 0xffff }
    pub fn in32(port: usize) -> usize { return @bitCast(usize, op1(layout.Op.INL, port)) & 0xffffffff }
}

pub const Cpu = struct {
    // Interrupts on until the next one (sti; hlt; cli).
    pub fn wait() -> void { _ = op1(layout.Op.WAIT, 0) }

    // The address of the last page fault.
    pub fn faultAddress() -> usize { return @bitCast(usize, op1(layout.Op.READ_CR2, 0)) }

    // The page tables in use (CR3), and switching them.
    pub fn pageTables() -> usize { return @bitCast(usize, op1(layout.Op.READ_CR3, 0)) }
    pub fn usePageTables(root: usize) -> void { _ = op1(layout.Op.WRITE_CR3, root) }

    pub fn invalidatePage(address: usize) -> void { _ = op1(layout.Op.INVLPG, address) }

    // The time-stamp counter.
    pub fn timestamp() -> usize { return @bitCast(usize, op1(layout.Op.RDTSC, 0)) }

    // User mode at `rip` with the stack at `rsp` (every register zero,
    // interrupts on); it does not come back (traps and system calls come
    // to brix_trap).
    pub fn enterUser(rip: usize, rsp: usize) -> void { _ = op2(layout.Op.ENTER_USER, rip, rsp) }
}

// Model-specific registers.
pub const Msr = struct {
    pub const FS_BASE: usize = 0xC0000100

    pub fn write(msr: usize, value: usize) -> void { _ = op2(layout.Op.WRMSR, msr, value) }
}

// The boot info the blob filled in (fields: layout.Info).
pub const BootInfo = struct {
    fn field(offset: usize) -> *usize { return unsafe { @ptrFromInt(*usize, layout.Blob.virtual(layout.Blob.BOOT_INFO + offset)) } }

    pub fn get(offset: usize) -> usize { return field(offset).* }
}
