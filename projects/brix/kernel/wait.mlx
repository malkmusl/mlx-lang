// What a blocked process waits for. A system call that has to wait
// leaves the process at its SYSCALL instruction (it makes the call again
// when it runs next), so no process needs a kernel stack of its own; the
// scheduler wakes it when the condition holds.
pub const WaitKind = enum(u8) {
    none,
    // A child ended (target: the pid waited for, -1 any).
    child,
    // A signal came (SIGCHLD), or the deadline passed.
    signal,
    // The terminal has input.
    terminal,
    // A pipe (target) can be read, or written.
    pipe_read,
    pipe_write,
    // poll: the terminal or a pipe changed (target: the pipes' event
    // count when it began), or the deadline passed.
    poll,
    // The deadline passed.
    sleep
}

pub const Wait = struct {
    kind: WaitKind
    target: isize
    // Nanoseconds since boot; 0 for none.
    deadline: usize

    pub fn none() -> Wait { return Wait.{ .kind = WaitKind.none, .target = 0, .deadline = 0 } }

    pub fn on(kind: WaitKind, target: isize, deadline: usize) -> Wait { return Wait.{ .kind = kind, .target = target, .deadline = deadline } }
}

// What a descriptor's read or write gives when it has to wait (never
// seen by a program: the call is made again).
pub const BLOCKED: isize = -100000
