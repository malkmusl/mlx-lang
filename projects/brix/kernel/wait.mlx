// What a blocked process waits for. A system call that has to wait
// leaves the process at its SYSCALL instruction (it makes the call again
// when it runs next), so no process needs a kernel stack of its own; the
// scheduler wakes it when the condition holds.
pub const WaitKind = enum(u8) {
    none,
    // A child ended, or (options: WUNTRACED, WCONTINUED) stopped or went
    // on (target: the pid waited for, -1 any).
    child,
    // A signal of a set (target) is pending, or the deadline passed
    // (rt_sigtimedwait).
    signal,
    // Only a signal ends it (pause, rt_sigsuspend).
    pause,
    // The terminal has input.
    terminal,
    // A pipe (target) can be read, or written.
    pipe_read,
    pipe_write,
    // poll: the terminal or a pipe changed (target: the pipes' event
    // count when it began), or the deadline passed.
    poll,
    // The deadline passed.
    sleep,
    // A native wait: a handle of the process's waitItems reached a state
    // it wants, or the deadline passed.
    handles
}

// A handle a native wait watches and the state bits it wants.
pub const HandleWait = struct {
    pub const MAX: usize = 16

    handle: u32
    want: u32
}

pub const Wait = struct {
    kind: WaitKind
    target: isize
    // Nanoseconds since boot; 0 for none.
    deadline: usize
    // wait4's options, for a child.
    options: usize

    pub fn none() -> Wait { return Wait.{ .kind = WaitKind.none, .target = 0, .deadline = 0, .options = 0 } }

    pub fn on(kind: WaitKind, target: isize, deadline: usize) -> Wait { return Wait.{ .kind = kind, .target = target, .deadline = deadline, .options = 0 } }

    pub fn child(target: isize, options: usize) -> Wait { return Wait.{ .kind = WaitKind.child, .target = target, .deadline = 0, .options = options } }
}

// What a descriptor's read or write gives when it has to wait (never
// seen by a program: the call is made again).
pub const BLOCKED: isize = -100000
