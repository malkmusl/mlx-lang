// The PS/2 mouse (the i8042 controller's second port, the auxiliary
// device): its packets (three bytes each: buttons and sign bits, dx, dy,
// as a standard mouse sends them, the first with bit 3 set) come by IRQ
// 12 into a ring of bytes, which /devices/mouse gives to a program that
// reads it (the compositor decodes them; a packet's start is told by bit
// 3). The bytes of either port arrive at the same data port: keyboard.mlx
// drains it and hands the auxiliary ones here.
const cpu = @import("./cpu.mlx")
const wait = @import("./wait.mlx")

const Port = cpu.Port

pub const Mouse = struct {
    const DATA: usize = 0x60
    const STATUS: usize = 0x64
    const COMMAND: usize = 0x64
    const OUTPUT_FULL: usize = 1
    const INPUT_FULL: usize = 2
    const AUX_DATA: usize = 0x20
    const READ_CONFIGURATION: usize = 0x20
    const WRITE_CONFIGURATION: usize = 0x60
    const ENABLE_AUX: usize = 0xA8
    const TO_AUX: usize = 0xD4
    const SET_DEFAULTS: usize = 0xF6
    const ENABLE_REPORTING: usize = 0xF4
    const CAPACITY: usize = 768

    ring: [CAPACITY]u8
    head: usize
    count: usize
    present: bool

    fn waitToWrite() -> void {
        var spins: usize = 0
        while Port.in8(STATUS) & INPUT_FULL != 0 && spins < 100000 { spins += 1 }
    }

    fn waitToRead() -> bool {
        var spins: usize = 0
        while Port.in8(STATUS) & OUTPUT_FULL == 0 && spins < 100000 { spins += 1 }
        return Port.in8(STATUS) & OUTPUT_FULL != 0
    }

    // A byte to the mouse (through the controller); its answer, or 0.
    fn tell(byte: usize) -> usize {
        waitToWrite()
        Port.out8(COMMAND, TO_AUX)
        waitToWrite()
        Port.out8(DATA, byte)
        if !waitToRead() { return 0 }
        return Port.in8(DATA)
    }

    // The auxiliary port on, its interrupt on in the controller's
    // configuration, the mouse at its defaults and reporting.
    pub fn init(self: *Self) -> void {
        self.*.head = 0
        self.*.count = 0
        self.*.present = false
        if Port.in8(STATUS) == 0xFF { return }
        waitToWrite()
        Port.out8(COMMAND, ENABLE_AUX)
        waitToWrite()
        Port.out8(COMMAND, READ_CONFIGURATION)
        if !waitToRead() { return }
        var configuration = Port.in8(DATA)
        configuration = (configuration | 0x02) & ~@intCast(usize, 0x20)
        waitToWrite()
        Port.out8(COMMAND, WRITE_CONFIGURATION)
        waitToWrite()
        Port.out8(DATA, configuration)
        const defaults = tell(SET_DEFAULTS)
        const reporting = tell(ENABLE_REPORTING)
        self.*.present = defaults == 0xFA && reporting == 0xFA
        // Leftovers of the answers.
        self.*.head = 0
        self.*.count = 0
    }

    // A byte from the auxiliary port (the oldest dropped when the ring is
    // full: whole packets go with it, the reader syncs on bit 3).
    pub fn push(self: *Self, byte: u8) -> void {
        if self.*.count == CAPACITY {
            self.*.head = (self.*.head + 3) % CAPACITY
            self.*.count -= 3
        }
        self.*.ring[(self.*.head + self.*.count) % CAPACITY] = byte
        self.*.count += 1
    }

    pub fn pending(self: *const Self) -> bool { return self.*.count > 0 }

    // Up to `capacity` bytes; wait.BLOCKED when there are none.
    pub fn read(self: *Self, into: [*]u8, capacity: usize) -> isize {
        if self.*.count == 0 { return wait.BLOCKED }
        var got: usize = 0
        while got < capacity && self.*.count > 0 {
            into[got] = self.*.ring[self.*.head]
            self.*.head = (self.*.head + 1) % CAPACITY
            self.*.count -= 1
            got += 1
        }
        return @intCast(isize, got)
    }
}

var mouse: Mouse = undefined // (per run)

pub fn aux() -> *Mouse { return &mouse }
