// ---- Linux's numbers that are no register.
// The card's addresses are 40 bits wide; the GART is 256 MiB on a 4 GiB
// boundary below the hole (gmc_v8_0_sw_init, gmc_v8_0_mc_init,
// amdgpu_gmc_gart_location, amdgpu_gmc.h).
pub const MC_MASK: usize = 0xFFFFFFFFFF
pub const AMDGPU_GMC_HOLE_START: usize = 0x0000800000000000
pub const GART_BYTES: usize = 0x10000000
pub const FOUR_GB: usize = 0x100000000
// A page of the card and a table entry (amdgpu_gart.h; 8 bytes each,
// gmc_v8_0_gart_init), the bits of an entry (amdgpu_vm.h) and the part of
// it that is the address (amdgpu_gmc_set_pte_pde).
pub const AMDGPU_GPU_PAGE_SIZE: usize = 4096
pub const ENTRY_BYTES: usize = 8
pub const AMDGPU_PTE_VALID: usize = 0x1
pub const AMDGPU_PTE_SYSTEM: usize = 0x2
pub const AMDGPU_PTE_SNOOPED: usize = 0x4
pub const AMDGPU_PTE_EXECUTABLE: usize = 0x10
pub const AMDGPU_PTE_READABLE: usize = 0x20
pub const AMDGPU_PTE_WRITEABLE: usize = 0x40
pub const PTE_ADDRESS: usize = 0x0000FFFFFFFFF000
// How long Linux waits for a block, in microseconds (amdgpu.h).
pub const AMDGPU_MAX_USEC_TIMEOUT: usize = 100000
// The programs' address spaces as Linux sizes them for this machine (64
// GiB, two levels, a page table of 1024 entries: block size 10, fragment
// size 9: gmc_v8_0_sw_init's amdgpu_vm_adjust_size(64, 9, 1, 40)); the
// sizes are this driver's choice within what the registers hold, Linux's
// for the tests to be comparable.
pub const MAX_PFN: usize = 0x1000000
pub const BLOCK_SIZE: usize = 10
pub const FRAGMENT_SIZE: usize = 9
// The settings gmc_v8_0_gart_enable gives the two caches.
pub const SYSTEM_ACCESS_MODE: usize = 3
pub const EFFECTIVE_L2_QUEUE_SIZE: usize = 7
pub const CONTEXT1_IDENTITY_ACCESS_MODE: usize = 1
// The AGP range made empty (gmc_v8_0_mc_program).
pub const AGP_EMPTY: usize = 0x0FFFFFFF
// The interrupt ring: 64 KiB (tonga_ih_sw_init), an entry of 16 bytes
// (tonga_ih_decode_iv), 31 entries in one go (AMDGPU_IH_MAX_NUM_IVS less
// one: amdgpu_ih_process's loop).
pub const IH_RING_BYTES: usize = 65536
pub const IH_ENTRY_BYTES: usize = 16
pub const AMDGPU_IH_MAX_NUM_IVS: usize = 32
// The SMC runs firmware of the driver's when its program counter is at
// or above this (smu7_is_smc_ram_running), and the fuse word whose bit 0
// says the card has AVFS (polaris10_is_hw_avfs_present: SMU_EFUSE_0 +
// 49 * 4).
pub const SMC_RAM_RUNNING: usize = 0x20100
pub const AVFS_FUSE_WORD: usize = 49
// The address configuration's golden word, whose row size the memory's
// columns decide (gfx_v8_0.c, gfx_v8_0_gpu_early_init).
pub const TONGA_GB_ADDR_CONFIG_GOLDEN: usize = 0x22011003
// The version of the register list polaris10_mc.bin would load (its last
// pair: the file's own ucode_version).
pub const MC_LIST_VERSION: usize = 0x03B4DC40

// The memory controller's golden words for Polaris 10 (gmc_v8_0.c,
// golden_settings_polaris10_a11): register, mask, value, as Linux's table
// has them in its order.
pub const GOLDEN_MEMORY = [_]usize{ MC_ARB_WTM_GRPWT_RD, 0x00000003, 0x00000000, VM_PRT_APERTURE0_LOW_ADDR, 0x0FFFFFFF, 0x0FFFFFFF, VM_PRT_APERTURE1_LOW_ADDR, 0x0FFFFFFF, 0x0FFFFFFF, VM_PRT_APERTURE2_LOW_ADDR, 0x0FFFFFFF, 0x0FFFFFFF, VM_PRT_APERTURE3_LOW_ADDR, 0x0FFFFFFF, 0x0FFFFFFF }
// The graphics block's and the copy engines' golden registers, read and
// said at S0 (the later stages write them): gfx_v8_0.c's
// golden_settings_polaris10_a11 and polaris10_golden_common_all, and
// sdma_v3_0.c's golden_settings_polaris10_a11, each register in its
// table's order (CG_ACLK_CNTL beside them is the SMC's).
pub const GOLDEN_GRAPHICS = [_]usize{ gmc_8_1.ATC_MISC_CG, gfx_8_0.CB_HW_CONTROL, gfx_8_0.CB_HW_CONTROL_2, gfx_8_0.CB_HW_CONTROL_3, gfx_8_0.DB_DEBUG2, gfx_8_0.PA_SC_ENHANCE, gfx_8_0.PA_SC_LINE_STIPPLE_STATE, gfx_8_0.PA_SC_RASTER_CONFIG, gfx_8_0.PA_SC_RASTER_CONFIG_1, gfx_8_0.RLC_CGCG_CGLS_CTRL, gfx_8_0.RLC_CGCG_CGLS_CTRL_3D, gfx_8_0.SQ_CONFIG, gfx_8_0.TA_CNTL_AUX, gfx_8_0.TCC_CTRL, gfx_8_0.TCP_ADDR_CONFIG, gfx_8_0.TCP_CHAN_STEER_HI, gfx_8_0.VGT_RESET_DEBUG }
pub const GOLDEN_COMMON = [_]usize{ gfx_8_0.GRBM_GFX_INDEX, gfx_8_0.PA_SC_RASTER_CONFIG, gfx_8_0.PA_SC_RASTER_CONFIG_1, gfx_8_0.GB_ADDR_CONFIG, gfx_8_0.SPI_RESOURCE_RESERVE_CU_0, gfx_8_0.SPI_RESOURCE_RESERVE_CU_1, gfx_8_0.SPI_RESOURCE_RESERVE_EN_CU_0, gfx_8_0.SPI_RESOURCE_RESERVE_EN_CU_1 }
pub const GOLDEN_COPY = [_]usize{ oss_3_0.SDMA0_CHICKEN_BITS, oss_3_0.SDMA0_CLK_CTRL, oss_3_0.SDMA0_GFX_IB_CNTL, oss_3_0.SDMA0_RLC0_IB_CNTL, oss_3_0.SDMA0_RLC1_IB_CNTL, oss_3_0.SDMA1_CHICKEN_BITS, oss_3_0.SDMA1_CLK_CTRL, oss_3_0.SDMA1_GFX_IB_CNTL, oss_3_0.SDMA1_RLC0_IB_CNTL, oss_3_0.SDMA1_RLC1_IB_CNTL }

// The data table of the ROM that says the graphics block's numbers (its
// place in ATOM_MASTER_LIST_OF_DATA_TABLES), the fields read from it
// (ATOM_GFX_INFO_V2_1: after the table's header) and the firmware
// information's default clocks (ATOM_FIRMWARE_INFO_V2_2, 10 kHz).
pub const GFX_Info: usize = 14
pub const ATOM_GFX_INFO_V2_1__GfxIpMinVer: usize = 4
pub const ATOM_GFX_INFO_V2_1__size: usize = 12
pub const ATOM_FIRMWARE_INFO_V2_2__ulDefaultEngineClock: usize = 8
pub const ATOM_FIRMWARE_INFO_V2_2__ulDefaultMemoryClock: usize = 12

// The firmware files' common header (amdgpu_ucode.h,
// common_firmware_header) and the further words read of some.
pub const HEADER__size_bytes: usize = 0
pub const HEADER__header_version_major: usize = 8
pub const HEADER__header_version_minor: usize = 10
pub const HEADER__ucode_version: usize = 16
pub const HEADER__ucode_size_bytes: usize = 20
pub const HEADER__ucode_array_offset_bytes: usize = 24
pub const HEADER__size: usize = 32
pub const GFX_HEADER__jt_offset: usize = 36
pub const GFX_HEADER__jt_size: usize = 40
// The SMC's RAM the firmware's image is put into (smu7_smumgr.c).
pub const SMU7_SMC_SIZE: usize = 0x20000

// ---- This driver's own numbers.
// The driver's part of the aperture: its top this many bytes (the display
// keeps what is below), and how much of it M1 proves (the study's 8.3
// lists what the stages put there: about 1.5 MiB).
pub const DRIVER_PART: usize = 64 * 1024 * 1024
pub const PROVED: usize = 2 * 1024 * 1024
// Where in the driver's part the GART's table is (its start) and the
// default page (after the table).
pub const TABLE_AT: usize = 0
pub const DEFAULT_PAGE_AT: usize = GART_BYTES / AMDGPU_GPU_PAGE_SIZE * ENTRY_BYTES
// The pages of the dma piece the GART maps (gpu.mlx's DMA_PAGES).
pub const DMA_PAGES: usize = 2048
// The word beyond the aperture M1 tries: at 4 GiB of the card's memory.
pub const BEYOND_AT: usize = 0x100000000
// How long I1 watches the ring, how often, and how many entries in that
// time are a storm.
pub const SILENT_FOR: usize = 1000000000
pub const LOOK_EVERY: usize = 1000
pub const STORM: usize = 4096
// A rate off by more than this (thousandths) fails the watch.
pub const RATE_SLACK: usize = 10
// What the scratch register is given to show that the card takes a write
// after a step (as gpu.mlx's report gives it at boot).
pub const SCRATCH_TRIAL: usize = 0xCAFEBABE
// The entries of the register table kept for the way back.
pub const KEPT: usize = 256
// (No such thing.)
pub const NONE: usize = 0xFFFFFFFFFFFFFFFF

// The card as the steps reach it. gpu.mlx lends the real card; a test
// lends a table.
pub const Hands = struct {
    // A register by its number, read and written.
    read: fn(usize) -> u32
    write: fn(usize, u32) -> void
    // The clock (nanoseconds, only ever more), a pause (microseconds), the
    // log, and the log kept off the screen (true) or let back.
    now: fn() -> usize
    pause: fn(usize) -> void
    say: fn([]const u8) -> void
    aside: fn(bool) -> void
    // The aperture in the kernel's view: a 64-bit word by its byte offset.
    vramRead: fn(usize) -> usize
    vramWrite: fn(usize, usize) -> void
    // Memory of the system's for the card: whole pages, zeroed, by its
    // physical address (0: none left), and a 32-bit word of it read by
    // its physical address (what the card wrote there).
    dma: fn(usize) -> usize
    memoryRead: fn(usize) -> u32
    // The PCI command word; the card's interrupt routed as a message
    // (whether it could be), and how many messages have come.
    command: fn() -> usize
    route: fn() -> bool
    interrupts: fn() -> usize
    // Whether the card's message has come to this processor and waits
    // there to be taken: while the kernel starts it runs with interrupts
    // off, and a message that comes then is not taken (counted) until
    // the first program runs.
    waiting: fn() -> bool
    // A firmware file of the boot archive by its name (empty: none).
    file: fn([]const u8) -> []const u8
}

// What the card is and where things are, from gpu.mlx: the PCI device and
// revision, the aperture's bytes in the kernel's view, the picture the
// kernel's console is on (its offset and bytes in the aperture; 0 bytes:
// it is on no picture of this card's), the dma piece (physical, pages),
// the ROM's interpreter (null: none).
pub const Card = struct {
    device: usize
    revision: usize
    view: usize
    pictureOffset: usize
    pictureBytes: usize
    dmaBase: usize
    dmaPages: usize
    rom: ?*const atom.Atom
}

// ---- What S0 reads.

// The nine firmware files this card takes (amdgpu_cgs.c, gfx_v8_0.c,
// sdma_v3_0.c; the SMC's by the card's key: `smcFile`), what their header
// version must be (amdgpu_ucode.h's kinds) and how each is checked.
pub const FILES = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin" }
pub const FILE_MAJOR = [_]usize{ 1, 1, 1, 1, 2, 1, 1 }
pub const FILE_MINOR = [_]usize{ 0, 0, 0, 0, 0, 1, 1 }
pub const MEC_FILE: usize = 3
pub const SMC_KICKER = "polaris10_k_smc.bin"
pub const SMC_KICKER2 = "polaris10_k2_smc.bin"
pub const SMC_PLAIN = "polaris10_smc.bin"
pub const SMC_SOFT_KEY = "polaris10_smc_sk.bin"

// A file's check (3.1, ours beyond Linux's length check).
pub const Holds = enum(u8) { yes, missing, length, header, payload, jump_table, smc_size }

pub const File = struct {
    name: []const u8
    holds: Holds
    version: usize
}

pub const Found = struct {
    // The card answers as one the firmware started, and is a Polaris 10.
    started: bool
    polaris10: bool
    memsize: usize
    location: usize
    vramBytes: usize
    vramStart: usize
    vramEnd: usize
    // The memory adds up (the location's top is its base and size), and
    // the GART's place by Linux's rule lies beside it.
    sane: bool
    gartStart: usize
    gartEnd: usize
    gartFits: bool
    scratch7: usize
    // The SMC.
    smcClock: usize
    counter: usize
    counterAgain: usize
    smcFirmware: usize
    events: usize
    flags: usize
    reset: usize
    status: usize
    fuse: usize
    smcRunning: bool
    smcFile: []const u8
    // The memory controller and the GART's words.
    apertureLow: usize
    apertureHigh: usize
    apertureDefault: usize
    agpBase: usize
    agpTop: usize
    agpBottom: usize
    l1: usize
    l2: [4]usize
    context0: usize
    context1: usize
    faultStatus: [2]usize
    faultAddress: [2]usize
    faultClient: [2]usize
    fbEnable: usize
    arbiter: usize
    sequencer: usize
    misc0: usize
    training: usize
    ramcfg: usize
    listVersion: usize
    hdpFlush: usize
    hdpMisc: usize
    hostPathNonZero: usize
    hostPathFirst: usize
    hostPathValue: usize
    // The interrupt ring's words.
    ihControl: usize
    interruptControl: usize
    ihDoorbell: usize
    // The engines.
    me: usize
    mec: usize
    rlc: usize
    rlcStatus: usize
    grbm: usize
    grbm2: usize
    sdmaHalt: [2]usize
    sdmaStatus: [2]usize
    sdmaRing: [2]usize
    doorbells: usize
    pqStatus: usize
    spmVmid: usize
    schedulers: usize
    kiqActive: usize
    computeActive: usize
    // The address configuration: worked out, and the three words that
    // hold it now (the graphics block's, the host path's, the display's).
    addressConfig: usize
    gbAddrConfig: usize
    hdpAddrConfig: usize
    dmifAddrCalc: usize
    vgaHdp: usize
    vgaRender: usize
    // Temperature and fan.
    temperature: usize
    fanMode: usize
    fanDuty: usize
    fanMost: usize
    tach: usize
    thermalInt: usize
    thermalCtrl: usize
    pciCommand: usize
    // The ROM's numbers (found: false when it has no GFX_Info).
    gfxFound: bool
    gfx: [8]usize
    engineClock: usize
    memoryClock: usize
    // The firmware files, in the order the SMC would load them.
    files: [8]File
    filesHold: bool
}

// The register table kept for the way back: each register a step wrote,
// with what it held before, in the order written.
pub const Kept = struct {
    register: [KEPT]usize
    value: [KEPT]usize
    count: usize
    // More was to be kept than there is room for: the step stops.
    full: bool
}

// The picture as the watch saw it.
pub const Picture = struct {
    // There is one of the kernel's on this card, shown by `controller`.
    shown: bool
    controller: usize
    hTotal: usize
    vTotal: usize
    millihertz: usize
    dry: bool
    sum: usize
}

// How a step ended.
pub const Outcome = enum(u8) { not_tried, passed, refused, failed }

// Everything the stages do, and what they found.
pub const Engines = struct {
    hands: Hands
    card: Card
    found: Found
    kept: Kept
    // How far this boot goes (engine_choice.mlx's stage).
    stage: usize
    // Each step's outcome.
    s0: Outcome
    m1: Outcome
    m2: Outcome
    i1: Outcome
    // The aperture's division: the display's part ends at `limit`.
    limit: usize
    // The GART's table and the default page (card addresses, and their
    // offsets in the aperture), the dummy page (physical).
    table: usize
    tableAt: usize
    defaultPage: usize
    defaultAt: usize
    dummy: usize
    // The interrupt ring (physical), its pointer page, what it took in.
    ring: usize
    pointers: usize
    readPointer: usize
    entries: usize
    sources: [8]usize
    sourcesCount: usize
    routed: bool
    // A card found running was halted at this boot.
    quieted: bool
    began: usize
    // The interrupt ring is up (for the way down).
    ringUp: bool
}

// ---- Reaching the card.

fn rd(e: *Engines, number: usize) -> usize {
    const read = e.*.hands.read
    return @intCast(usize, read(number))
}

fn wr(e: *Engines, number: usize, value: usize) -> void {
    const write = e.*.hands.write
    write(number, @intCast(u32, value & 0xFFFFFFFF))
}

fn say(e: *Engines, text: []const u8) -> void {
    const write = e.*.hands.say
    write(text)
}

fn now(e: *Engines) -> usize {
    const clock = e.*.hands.now
    return clock()
}

fn pause(e: *Engines, microseconds: usize) -> void {
    const wait = e.*.hands.pause
    wait(microseconds)
}

fn aside(e: *Engines, on: bool) -> void {
    const put = e.*.hands.aside
    put(on)
}

fn vramRead(e: *Engines, offset: usize) -> usize {
    const read = e.*.hands.vramRead
    return read(offset)
}

fn vramWrite(e: *Engines, offset: usize, value: usize) -> void {
    const write = e.*.hands.vramWrite
    write(offset, value)
}

fn memoryRead(e: *Engines, physical: usize) -> usize {
    const read = e.*.hands.memoryRead
    return @intCast(usize, read(physical))
}

// A register written by a step: what it held kept first (the way back).
fn set(e: *Engines, number: usize, value: usize) -> void {
    if e.*.kept.count >= KEPT {
        e.*.kept.full = true
        return
    }
    e.*.kept.register[e.*.kept.count] = number
    e.*.kept.value[e.*.kept.count] = rd(e, number)
    e.*.kept.count += 1
    wr(e, number, value)
}

// A field's value placed by its mask.
fn field(mask: usize, value: usize) -> usize {
    var shift: usize = 0
    while shift < 32 && (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (value << @intCast(u6, shift)) & mask
}

// A field's value read by its mask.
fn get(value: usize, mask: usize) -> usize {
    var shift: usize = 0
    while shift < 32 && (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (value & mask) >> @intCast(u6, shift)
}

// The registers a step wrote put back as they were, last first, down to
// `mark`.
fn putBack(e: *Engines, mark: usize) -> usize {
    var count: usize = 0
    while e.*.kept.count > mark {
        e.*.kept.count -= 1
        wr(e, e.*.kept.register[e.*.kept.count], e.*.kept.value[e.*.kept.count])
        count += 1
    }
    return count
}

// A word of the SMC's (its index and data pair; the index is put back by
// the caller's step, `smcDone`).
fn smc(e: *Engines, address: usize) -> usize {
    wr(e, SMC_IND_INDEX_11, address)
    return rd(e, SMC_IND_DATA_11)
}

// ---- The log's words.

fn decimal(e: *Engines, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(e, digits[at..20])
}

fn hex(e: *Engines, value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(e, text[0..2 + digits])
}

fn num(e: *Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    decimal(e, value)
}

fn word(e: *Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    hex(e, value)
}

// Bytes as MiB, with a tenth where they are no whole MiB ("205.8 MiB").
fn size(e: *Engines, bytes: usize) -> void {
    const tenths = bytes * 10 / (1024 * 1024)
    decimal(e, tenths / 10)
    if bytes % (1024 * 1024) != 0 {
        say(e, ".")
        decimal(e, tenths % 10)
    }
    say(e, " MiB")
}

// Millihertz as "59.98 Hz".
fn hertz(e: *Engines, millihertz: usize) -> void {
    decimal(e, millihertz / 1000)
    say(e, ".")
    const hundredths = (millihertz % 1000) / 10
    if hundredths < 10 { say(e, "0") }
    decimal(e, hundredths)
    say(e, " Hz")
}

// 10 kHz as "300.00 MHz".
fn megahertz(e: *Engines, tens: usize) -> void {
    decimal(e, tens / 100)
    say(e, ".")
    if tens % 100 < 10 { say(e, "0") }
    decimal(e, tens % 100)
    say(e, " MHz")
}

// " (12 ms)" after a step's line.
fn took(e: *Engines) -> void {
    const ms = (now(e) - e.*.began) / 1000000
    num(e, " (", ms)
    say(e, " ms)\n")
}

// ---- The start.

// The record anew for a card (nothing tried yet).
pub fn begin(e: *Engines, hands: *const Hands, card: *const Card, stage: usize) -> void {
    e.*.hands = hands.*
    e.*.card = card.*
    e.*.kept.count = 0
    e.*.kept.full = false
    e.*.stage = stage
    e.*.s0 = Outcome.not_tried
    e.*.m1 = Outcome.not_tried
    e.*.m2 = Outcome.not_tried
    e.*.i1 = Outcome.not_tried
    e.*.limit = card.*.view
    e.*.table = 0
    e.*.tableAt = 0
    e.*.defaultPage = 0
    e.*.defaultAt = 0
    e.*.dummy = 0
    e.*.ring = 0
    e.*.pointers = 0
    e.*.readPointer = 0
    e.*.entries = 0
    e.*.sourcesCount = 0
    e.*.routed = false
    e.*.quieted = false
    e.*.began = 0
    e.*.ringUp = false
}

// Whether a PCI device is a Polaris 10 (amdgpu_drv.c's list: 0x67C0 to
// 0x67DF and 0x6FDF): the card whose numbers these are.
pub fn polaris10(device: usize) -> bool { return (device >= 0x67C0 && device <= 0x67DF) || device == 0x6FDF }

// Linux's ASICID_IS_P20 and _P30 (amdgpu.h): which SMC file a card with
// the hard key takes.
pub fn kickerP20(device: usize, revision: usize) -> bool {
    if device == 0x67DF { return revision == 0xE3 || revision == 0xE4 || revision == 0xE5 || revision == 0xE7 || revision == 0xEF }
    if device == 0x6FDF { return revision == 0xE7 || revision == 0xEF || revision == 0xFF }
    return false
}

pub fn kickerP30(device: usize, revision: usize) -> bool { return device == 0x67DF && (revision == 0xE1 || revision == 0xF7) }

// The aperture's part the display may use at a boot that goes to `stage`:
// all of the view at stage 0 (nothing changes for it), else the view less
// the driver's top 64 MiB (0: the view is too small to divide).
pub fn displayLimit(view: usize, stage: usize) -> usize {
    if stage == 0 { return view }
    if view < 2 * DRIVER_PART { return 0 }
    return view - DRIVER_PART
}

// The GART's place by Linux's rule (amdgpu_gmc_gart_location) for VRAM
// at `start` .. `end`: its first card address.
pub fn gartPlace(start: usize, end: usize) -> usize {
    const most = if MC_MASK < AMDGPU_GMC_HOLE_START - 1 { MC_MASK } else { AMDGPU_GMC_HOLE_START - 1 }
    const before = start
    const above = (end + 1 + FOUR_GB - 1) / FOUR_GB * FOUR_GB
    const after = if most + 1 > above { most + 1 - above } else { 0 }
    var bytes = GART_BYTES
    const larger = if before > after { before } else { after }
    if bytes > larger { bytes = larger }
    var at: usize = 0
    if (before >= bytes && before < after) || after < bytes {
        at = 0
    } else {
        at = most - bytes + 1
    }
    return at & ~(FOUR_GB - 1)
}

// The address configuration word the graphics block will be given, from
// MC_ARB_RAMCFG's NOOFCOLS (gfx_v8_0_gpu_early_init): the golden word with
// its row size 1, 2 or 4 KiB.
pub fn addressConfig(ramcfg: usize) -> usize {
    const columns = get(ramcfg, MC_ARB_RAMCFG__NOOFCOLS)
    var row = 4 * (@intCast(usize, 1) << @intCast(u6, 8 + columns)) / 1024
    if row > 4 { row = 4 }
    const rowField: usize = if row == 4 { 2 } else if row == 2 { 1 } else { 0 }
    return (TONGA_GB_ADDR_CONFIG_GOLDEN & ~GB_ADDR_CONFIG__ROW_SIZE) | field(GB_ADDR_CONFIG__ROW_SIZE, rowField)
}

fn le(bytes: []const u8, at: usize, count: usize) -> usize {
    var value: usize = 0
    var k: usize = 0
    while k < count {
        value |= @intCast(usize, bytes[at + k]) << @intCast(u6, 8 * k)
        k += 1
    }
    return value
}

// A firmware file checked (3.1): its length is its header's (Linux's one
// check), its header version the kind's, its payload inside it; MEC's jump
// table ends its payload; an SMC image fits the SMC's RAM.
pub fn checkFile(name: []const u8, bytes: []const u8, major: usize, minor: usize, mec: bool, smcImage: bool) -> File {
    var f = File.{ .name = name, .holds = Holds.yes, .version = 0 }
    if bytes.length == 0 {
        f.holds = Holds.missing
        return f
    }
    if bytes.length < HEADER__size || le(bytes, HEADER__size_bytes, 4) != bytes.length {
        f.holds = Holds.length
        return f
    }
    f.version = le(bytes, HEADER__ucode_version, 4)
    if le(bytes, HEADER__header_version_major, 2) != major || le(bytes, HEADER__header_version_minor, 2) != minor {
        f.holds = Holds.header
        return f
    }
    const payload = le(bytes, HEADER__ucode_size_bytes, 4)
    const at = le(bytes, HEADER__ucode_array_offset_bytes, 4)
    if at + payload > bytes.length || payload == 0 {
        f.holds = Holds.payload
        return f
    }
    if mec && (bytes.length < GFX_HEADER__jt_size + 4 || (le(bytes, GFX_HEADER__jt_offset, 4) + le(bytes, GFX_HEADER__jt_size, 4)) * 4 != payload) {
        f.holds = Holds.jump_table
        return f
    }
    if smcImage && (payload % 4 != 0 || payload > SMU7_SMC_SIZE) {
        f.holds = Holds.smc_size
        return f
    }
    return f
}

fn holdsText(h: Holds) -> []const u8 {
    if h == Holds.missing { return "is not in the boot archive" }
    if h == Holds.length { return "is not as long as its header says" }
    if h == Holds.header { return "has a header of another version" }
    if h == Holds.payload { return "has its payload outside it" }
    if h == Holds.jump_table { return "has a jump table that does not end its payload" }
    return "has an image that does not fit the SMC's RAM"
}

// ---- S0: the card read and described.

// The ROM's numbers: GFX_Info's eight and the firmware information's two
// default clocks.
fn readRom(e: *Engines) -> void {
    const f = &e.*.found
    f.*.gfxFound = false
    f.*.engineClock = 0
    f.*.memoryClock = 0
    if e.*.card.rom == null { return }
    const machine = e.*.card.rom.?
    const image = machine.*.rom
    const table = machine.dataTable(GFX_Info)
    if table != 0 && table + ATOM_GFX_INFO_V2_1__size <= image.length && le(image, table, 2) >= ATOM_GFX_INFO_V2_1__size {
        f.*.gfxFound = true
        var k: usize = 0
        while k < 8 {
            f.*.gfx[k] = @intCast(usize, image[table + ATOM_GFX_INFO_V2_1__GfxIpMinVer + k])
            k += 1
        }
    }
    const info = machine.dataTable(videorom.Data.FirmwareInfo)
    if info != 0 && info + ATOM_FIRMWARE_INFO_V2_2__ulDefaultMemoryClock + 4 <= image.length {
        f.*.engineClock = le(image, info + ATOM_FIRMWARE_INFO_V2_2__ulDefaultEngineClock, 4)
        f.*.memoryClock = le(image, info + ATOM_FIRMWARE_INFO_V2_2__ulDefaultMemoryClock, 4)
    }
}

// Everything S0 reads. The three index words it writes (the SMC's, the
// IO debug index, the queue selector) are put back as they were found.
fn read(e: *Engines) -> void {
    const f = &e.*.found
    f.*.memsize = rd(e, CONFIG_MEMSIZE)
    f.*.location = rd(e, MC_VM_FB_LOCATION)
    // Some boards have garbage in the size's upper half (gmc_v8_0_mc_init).
    var megabytes = f.*.memsize
    if megabytes & 0xFFFF0000 != 0 && megabytes & 0xFFFF != 0 { megabytes = megabytes & 0xFFFF }
    f.*.vramBytes = megabytes * 1024 * 1024
    f.*.vramStart = (f.*.location & MC_VM_FB_LOCATION__FB_BASE) << 24
    f.*.vramEnd = f.*.vramStart + f.*.vramBytes - 1
    const top = ((get(f.*.location, MC_VM_FB_LOCATION__FB_TOP) + 1) << 24) - 1
    f.*.sane = megabytes != 0 && megabytes & 0xFFFF0000 == 0 && f.*.vramEnd <= MC_MASK && top == f.*.vramEnd
    f.*.gartStart = gartPlace(f.*.vramStart, f.*.vramEnd)
    f.*.gartEnd = f.*.gartStart + GART_BYTES - 1
    f.*.gartFits = f.*.sane && (f.*.gartEnd < f.*.vramStart || f.*.gartStart > f.*.vramEnd) && f.*.gartEnd <= MC_MASK
    f.*.scratch7 = rd(e, BIOS_SCRATCH_7)

    // The SMC (its index put back afterwards).
    const smcIndex = rd(e, SMC_IND_INDEX_11)
    f.*.smcClock = smc(e, ixSMC_SYSCON_CLOCK_CNTL_0)
    f.*.counter = smc(e, ixSMC_PC_C)
    f.*.smcFirmware = smc(e, ixSMU_FIRMWARE)
    f.*.events = smc(e, ixRCU_UC_EVENTS)
    f.*.flags = smc(e, ixFIRMWARE_FLAGS)
    f.*.reset = smc(e, ixSMC_SYSCON_RESET_CNTL)
    f.*.status = smc(e, ixSMU_STATUS)
    f.*.fuse = smc(e, ixSMU_EFUSE_0 + AVFS_FUSE_WORD * 4)
    f.*.temperature = get(smc(e, ixCG_MULT_THERMAL_STATUS), CG_MULT_THERMAL_STATUS__CTF_TEMP)
    f.*.fanMode = get(smc(e, ixCG_FDO_CTRL2), CG_FDO_CTRL2__FDO_PWM_MODE)
    f.*.fanDuty = get(smc(e, ixCG_THERMAL_STATUS), CG_THERMAL_STATUS__FDO_PWM_DUTY)
    f.*.fanMost = get(smc(e, ixCG_FDO_CTRL1), CG_FDO_CTRL1__FMAX_DUTY100)
    f.*.tach = smc(e, ixCG_TACH_STATUS)
    f.*.thermalInt = smc(e, ixCG_THERMAL_INT)
    f.*.thermalCtrl = smc(e, ixCG_THERMAL_CTRL)
    f.*.counterAgain = smc(e, ixSMC_PC_C)
    wr(e, SMC_IND_INDEX_11, smcIndex)
    f.*.smcRunning = f.*.smcClock & SMC_SYSCON_CLOCK_CNTL_0__ck_disable == 0 && f.*.counterAgain >= SMC_RAM_RUNNING
    const key = f.*.smcFirmware & SMU_FIRMWARE__SMU_SEL != 0
    if !key {
        f.*.smcFile = SMC_SOFT_KEY
    } else if kickerP20(e.*.card.device, e.*.card.revision) {
        f.*.smcFile = SMC_KICKER
    } else if kickerP30(e.*.card.device, e.*.card.revision) {
        f.*.smcFile = SMC_KICKER2
    } else {
        f.*.smcFile = SMC_PLAIN
    }

    // The memory controller, the GART's words, the host path.
    f.*.apertureLow = rd(e, MC_VM_SYSTEM_APERTURE_LOW_ADDR)
    f.*.apertureHigh = rd(e, MC_VM_SYSTEM_APERTURE_HIGH_ADDR)
    f.*.apertureDefault = rd(e, MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR)
    f.*.agpBase = rd(e, MC_VM_AGP_BASE)
    f.*.agpTop = rd(e, MC_VM_AGP_TOP)
    f.*.agpBottom = rd(e, MC_VM_AGP_BOT)
    f.*.l1 = rd(e, MC_VM_MX_L1_TLB_CNTL)
    f.*.l2[0] = rd(e, VM_L2_CNTL)
    f.*.l2[1] = rd(e, VM_L2_CNTL2)
    f.*.l2[2] = rd(e, VM_L2_CNTL3)
    f.*.l2[3] = rd(e, VM_L2_CNTL4)
    f.*.context0 = rd(e, VM_CONTEXT0_CNTL)
    f.*.context1 = rd(e, VM_CONTEXT1_CNTL)
    f.*.faultStatus[0] = rd(e, VM_CONTEXT0_PROTECTION_FAULT_STATUS)
    f.*.faultStatus[1] = rd(e, VM_CONTEXT1_PROTECTION_FAULT_STATUS)
    f.*.faultAddress[0] = rd(e, VM_CONTEXT0_PROTECTION_FAULT_ADDR)
    f.*.faultAddress[1] = rd(e, VM_CONTEXT1_PROTECTION_FAULT_ADDR)
    f.*.faultClient[0] = rd(e, VM_CONTEXT0_PROTECTION_FAULT_MCCLIENT)
    f.*.faultClient[1] = rd(e, VM_CONTEXT1_PROTECTION_FAULT_MCCLIENT)
    f.*.fbEnable = rd(e, BIF_FB_EN)
    f.*.arbiter = rd(e, MC_ARB_WTM_GRPWT_RD)
    f.*.sequencer = rd(e, MC_SEQ_SUP_CNTL)
    f.*.misc0 = rd(e, MC_SEQ_MISC0)
    f.*.training = rd(e, MC_SEQ_TRAIN_WAKEUP_CNTL)
    f.*.ramcfg = rd(e, MC_ARB_RAMCFG)
    const debugIndex = rd(e, MC_SEQ_IO_DEBUG_INDEX)
    wr(e, MC_SEQ_IO_DEBUG_INDEX, ixMC_IO_DEBUG_UP_159)
    f.*.listVersion = rd(e, MC_SEQ_IO_DEBUG_DATA)
    wr(e, MC_SEQ_IO_DEBUG_INDEX, debugIndex)
    f.*.hdpFlush = rd(e, HDP_REG_COHERENCY_FLUSH_CNTL)
    f.*.hdpMisc = rd(e, HDP_MISC_CNTL)
    f.*.hostPathNonZero = 0
    f.*.hostPathFirst = NONE
    f.*.hostPathValue = 0
    var surface: usize = 0
    while surface < HDP_SURFACES {
        var k: usize = 0
        while k < HDP_SURFACE_WORDS {
            const number = HDP_SURFACE_FIRST + HDP_SURFACE_STEP * surface + k
            const value = rd(e, number)
            if value != 0 {
                if f.*.hostPathNonZero == 0 {
                    f.*.hostPathFirst = number
                    f.*.hostPathValue = value
                }
                f.*.hostPathNonZero += 1
            }
            k += 1
        }
        surface += 1
    }

    // The interrupt ring's words, the engines' halt and status words, the
    // queues (each selected in turn, the selector put back).
    f.*.ihControl = rd(e, IH_RB_CNTL)
    f.*.interruptControl = rd(e, INTERRUPT_CNTL)
    f.*.ihDoorbell = rd(e, IH_DOORBELL_RPTR)
    f.*.me = rd(e, CP_ME_CNTL)
    f.*.mec = rd(e, CP_MEC_CNTL)
    f.*.rlc = rd(e, RLC_CNTL)
    f.*.rlcStatus = rd(e, RLC_STAT)
    f.*.grbm = rd(e, GRBM_STATUS)
    f.*.grbm2 = rd(e, GRBM_STATUS2)
    f.*.sdmaHalt[0] = rd(e, SDMA0_F32_CNTL)
    f.*.sdmaHalt[1] = rd(e, SDMA1_F32_CNTL)
    f.*.sdmaStatus[0] = rd(e, SDMA0_STATUS_REG)
    f.*.sdmaStatus[1] = rd(e, SDMA1_STATUS_REG)
    f.*.sdmaRing[0] = rd(e, SDMA0_GFX_RB_CNTL)
    f.*.sdmaRing[1] = rd(e, SDMA1_GFX_RB_CNTL)
    f.*.doorbells = rd(e, BIF_DOORBELL_APER_EN)
    f.*.pqStatus = rd(e, CP_PQ_STATUS)
    f.*.spmVmid = rd(e, RLC_SPM_VMID)
    f.*.schedulers = rd(e, RLC_CP_SCHEDULERS)
    const selector = rd(e, SRBM_GFX_CNTL)
    wr(e, SRBM_GFX_CNTL, queue(2, 1, 0))
    f.*.kiqActive = rd(e, CP_HQD_ACTIVE)
    wr(e, SRBM_GFX_CNTL, queue(1, 0, 0))
    f.*.computeActive = rd(e, CP_HQD_ACTIVE)
    wr(e, SRBM_GFX_CNTL, selector)

    // The address configuration and the words that hold one now.
    f.*.addressConfig = addressConfig(f.*.ramcfg)
    f.*.gbAddrConfig = rd(e, GB_ADDR_CONFIG)
    f.*.hdpAddrConfig = rd(e, HDP_ADDR_CONFIG)
    f.*.dmifAddrCalc = rd(e, DMIF_ADDR_CALC)
    f.*.vgaHdp = rd(e, VGA_HDP_CONTROL)
    f.*.vgaRender = rd(e, VGA_RENDER_CONTROL)
    const command = e.*.hands.command
    f.*.pciCommand = command()
    readRom(e)

    // The nine files.
    const file = e.*.hands.file
    f.*.filesHold = true
    var k: usize = 0
    while k < FILES.length {
        f.*.files[k] = checkFile(FILES[k], file(FILES[k]), FILE_MAJOR[k], FILE_MINOR[k], k == MEC_FILE, false)
        if f.*.files[k].holds != Holds.yes { f.*.filesHold = false }
        k += 1
    }
    f.*.files[FILES.length] = checkFile(f.*.smcFile, file(f.*.smcFile), 1, 0, false, true)
    if f.*.files[FILES.length].holds != Holds.yes { f.*.filesHold = false }
}

// The queue selector's word for micro engine `me`, pipe, queue
// (vi_srbm_select).
pub fn queue(me: usize, pipe: usize, number: usize) -> usize { return field(SRBM_GFX_CNTL__MEID, me) | field(SRBM_GFX_CNTL__PIPEID, pipe) | field(SRBM_GFX_CNTL__QUEUEID, number) }

// What of the card is on from a start before this one (the study's 8.7):
// each kind, as a bit.
pub const ON_RING: usize = 0x1
pub const ON_COPY: usize = 0x2
pub const ON_QUEUES: usize = 0x4
pub const ON_PROCESSORS: usize = 0x8
pub const ON_RLC: usize = 0x10
pub const ON_DOORBELLS: usize = 0x20
pub const ON_GART: usize = 0x40
pub const ON_SMC: usize = 0x80

pub fn left(f: *const Found) -> usize {
    var on: usize = 0
    if f.*.ihControl & (IH_RB_CNTL__RB_ENABLE | IH_RB_CNTL__ENABLE_INTR) != 0 { on |= ON_RING }
    if f.*.sdmaHalt[0] & SDMA0_F32_CNTL__HALT == 0 || f.*.sdmaHalt[1] & SDMA0_F32_CNTL__HALT == 0 || f.*.sdmaRing[0] & SDMA0_GFX_RB_CNTL__RB_ENABLE != 0 || f.*.sdmaRing[1] & SDMA0_GFX_RB_CNTL__RB_ENABLE != 0 { on |= ON_COPY }
    if f.*.kiqActive & CP_HQD_ACTIVE__ACTIVE != 0 || f.*.computeActive & CP_HQD_ACTIVE__ACTIVE != 0 { on |= ON_QUEUES }
    const meHalted = CP_ME_CNTL__ME_HALT | CP_ME_CNTL__PFP_HALT | CP_ME_CNTL__CE_HALT
    const mecHalted = CP_MEC_CNTL__MEC_ME1_HALT | CP_MEC_CNTL__MEC_ME2_HALT
    if f.*.me & meHalted != meHalted || f.*.mec & mecHalted != mecHalted { on |= ON_PROCESSORS }
    if f.*.rlc & RLC_CNTL__RLC_ENABLE_F32 != 0 { on |= ON_RLC }
    if f.*.doorbells & BIF_DOORBELL_APER_EN__BIF_DOORBELL_APER_EN != 0 { on |= ON_DOORBELLS }
    if f.*.context0 & VM_CONTEXT0_CNTL__ENABLE_CONTEXT != 0 { on |= ON_GART }
    if f.*.smcRunning { on |= ON_SMC }
    return on
}

fn yesNo(e: *Engines, on: bool, yes: []const u8, no: []const u8) -> void { say(e, if on { yes } else { no }) }

// One of a list said, after a blank or a comma.
fn item(e: *Engines, items: *usize, text: []const u8) -> void {
    say(e, if items.* == 0 { " " } else { ", " })
    say(e, text)
    items.* += 1
}

// What S0 read, for the log alone (the step's own line is `sayFound`).
fn sayDetails(e: *Engines) -> void {
    const f = &e.*.found
    if f.*.gfxFound {
        num(e, "gpu: the card's ROM: ", f.*.gfx[2])
        num(e, " shader engines, ", f.*.gfx[5])
        num(e, " shader array each, ", f.*.gfx[4])
        num(e, " compute units an array (", f.*.gfx[2] * f.*.gfx[5] * f.*.gfx[4])
        num(e, "), ", f.*.gfx[6])
        num(e, " render back ends an engine, ", f.*.gfx[3])
        num(e, " tile pipes, ", f.*.gfx[7])
        num(e, " texture channel caches (graphics IP ", f.*.gfx[1])
        num(e, ".", f.*.gfx[0])
        say(e, ")")
    } else {
        say(e, "gpu: the card's ROM has no GFX_Info: the graphics block's numbers are not known")
    }
    if f.*.engineClock != 0 {
        say(e, "; default clocks: core ")
        megahertz(e, f.*.engineClock)
        say(e, ", memory ")
        megahertz(e, f.*.memoryClock)
    }
    say(e, "\n")
    word(e, "gpu: SMC: clock control ", f.*.smcClock)
    yesNo(e, f.*.smcClock & SMC_SYSCON_CLOCK_CNTL_0__ck_disable == 0, " (clock on)", " (clock off)")
    word(e, ", program counter ", f.*.counter)
    word(e, " then ", f.*.counterAgain)
    yesNo(e, f.*.smcRunning, " (firmware in its RAM runs)", " (its ROM: no firmware of a driver's runs)")
    word(e, ", reset ", f.*.reset)
    word(e, ", status ", f.*.status)
    word(e, ", firmware word ", f.*.smcFirmware)
    num(e, " (protected mode ", get(f.*.smcFirmware, SMU_FIRMWARE__SMU_MODE))
    num(e, ", key ", get(f.*.smcFirmware, SMU_FIRMWARE__SMU_SEL))
    say(e, ": its file is ")
    say(e, f.*.smcFile)
    word(e, "), events ", f.*.events)
    word(e, ", firmware flags ", f.*.flags)
    say(e, "\n")
    word(e, "gpu: SMC: AVFS fuse ", f.*.fuse & 1)
    word(e, " (word ", f.*.fuse)
    yesNo(e, f.*.fuse & 1 != 0, "): Linux would write its default levels before loading the engines' firmware; this driver does not yet\n", "): the card has no AVFS\n")
    num(e, "gpu: memory: ", f.*.vramBytes / (1024 * 1024))
    word(e, " MiB at ", f.*.vramStart)
    word(e, "..", f.*.vramEnd)
    word(e, " of the card's addresses (location ", f.*.location)
    word(e, ", size word ", f.*.memsize)
    yesNo(e, f.*.sane, ")", "): THEY DO NOT ADD UP")
    word(e, "; system aperture ", f.*.apertureLow)
    word(e, "..", f.*.apertureHigh)
    word(e, " default ", f.*.apertureDefault)
    word(e, "; AGP base ", f.*.agpBase)
    word(e, " top ", f.*.agpTop)
    word(e, " bottom ", f.*.agpBottom)
    word(e, "; aperture access ", f.*.fbEnable)
    word(e, "; scratch 7 ", f.*.scratch7)
    yesNo(e, f.*.scratch7 & ATOM_S7_ASIC_INIT_COMPLETE_MASK != 0, " (started by the firmware)\n", " (the firmware's start is not marked)\n")
    word(e, "gpu: memory controller: sequencer ", f.*.sequencer)
    yesNo(e, f.*.sequencer & MC_SEQ_SUP_CNTL__RUN != 0, " (runs)", " (DOES NOT RUN)")
    word(e, ", kind ", f.*.misc0)
    yesNo(e, f.*.misc0 & MC_SEQ_MISC0__MT__MASK == MC_SEQ_MISC0__MT__GDDR5, " (GDDR5)", "")
    word(e, ", training ", f.*.training)
    yesNo(e, f.*.training & (MC_SEQ_TRAIN_WAKEUP_CNTL__TRAIN_DONE_D0 | MC_SEQ_TRAIN_WAKEUP_CNTL__TRAIN_DONE_D1) != 0, " (trained)", "")
    word(e, ", register list version ", f.*.listVersion)
    word(e, "; the firmware's microcode is kept (Linux would load ", MC_LIST_VERSION)
    yesNo(e, f.*.listVersion == MC_LIST_VERSION, ": the same)\n", ")\n")
    num(e, "gpu: memory columns field ", get(f.*.ramcfg, MC_ARB_RAMCFG__NOOFCOLS))
    word(e, ": address configuration ", f.*.addressConfig)
    word(e, " (the graphics block has ", f.*.gbAddrConfig)
    word(e, ", the host path ", f.*.hdpAddrConfig)
    word(e, "; DMIF_ADDR_CALC ", f.*.dmifAddrCalc)
    say(e, ", the display's, is written only by stage 6, and only where it differs)\n")
    word(e, "gpu: GART: L1 TLB control ", f.*.l1)
    word(e, ", L2 ", f.*.l2[0])
    word(e, " ", f.*.l2[1])
    word(e, " ", f.*.l2[2])
    word(e, " ", f.*.l2[3])
    word(e, ", address space 0 ", f.*.context0)
    word(e, ", 1 ", f.*.context1)
    yesNo(e, f.*.context0 & VM_CONTEXT0_CNTL__ENABLE_CONTEXT != 0, " (on)", " (off)")
    word(e, "; faults: 0 status ", f.*.faultStatus[0])
    word(e, " address ", f.*.faultAddress[0])
    word(e, ", 1 status ", f.*.faultStatus[1])
    word(e, " address ", f.*.faultAddress[1])
    word(e, "; arbiter's read group 0 ", f.*.arbiter & MC_ARB_WTM_GRPWT_RD__GRP0)
    word(e, "; host path flush ", f.*.hdpFlush)
    word(e, ", its control ", f.*.hdpMisc)
    say(e, "\n")
    if f.*.hostPathNonZero == 0 {
        say(e, "gpu: the host path's 160 surface words are all 0\n")
    } else {
        num(e, "gpu: the host path's surface words: ", f.*.hostPathNonZero)
        word(e, " are not 0, the first ", f.*.hostPathFirst)
        word(e, " is ", f.*.hostPathValue)
        say(e, ": left alone, step M2 is refused\n")
    }
    word(e, "gpu: interrupt ring control ", f.*.ihControl)
    yesNo(e, f.*.ihControl & IH_RB_CNTL__RB_ENABLE != 0, " (on)", " (off)")
    word(e, ", interrupt control ", f.*.interruptControl)
    word(e, ", its doorbell ", f.*.ihDoorbell)
    word(e, "; PCI command ", f.*.pciCommand)
    yesNo(e, f.*.pciCommand & 0x4 != 0, " (bus mastering on)\n", " (bus mastering off)\n")
    word(e, "gpu: engines: ME ", f.*.me)
    word(e, ", MEC ", f.*.mec)
    word(e, ", RLC ", f.*.rlc)
    word(e, " status ", f.*.rlcStatus)
    word(e, ", GRBM status ", f.*.grbm)
    word(e, " and ", f.*.grbm2)
    word(e, ", copy engines ", f.*.sdmaHalt[0])
    word(e, " ", f.*.sdmaHalt[1])
    word(e, " status ", f.*.sdmaStatus[0])
    word(e, " ", f.*.sdmaStatus[1])
    word(e, " rings ", f.*.sdmaRing[0])
    word(e, " ", f.*.sdmaRing[1])
    word(e, "; queues: KIQ ", f.*.kiqActive)
    word(e, " compute 0 ", f.*.computeActive)
    word(e, "; doorbells ", f.*.doorbells)
    word(e, ", queue status ", f.*.pqStatus)
    word(e, "; SPM VMID ", f.*.spmVmid)
    word(e, ", schedulers ", f.*.schedulers)
    say(e, "\n")
    word(e, "gpu: the VGA words: VGA_HDP_CONTROL ", f.*.vgaHdp)
    word(e, ", VGA_RENDER_CONTROL ", f.*.vgaRender)
    const linux = f.*.vgaHdp & VGA_HDP_CONTROL__VGA_MEMORY_DISABLE != 0 && f.*.vgaRender & VGA_RENDER_CONTROL__VGA_VSTATUS_CNTL == 0
    yesNo(e, linux, " (as Linux leaves them)\n", " (Linux would lock the VGA aperture out: these stages write no register of the display's)\n")
    sayGolden(e)
    num(e, "gpu: ", f.*.temperature)
    num(e, " C; fan mode ", f.*.fanMode)
    num(e, ", duty ", f.*.fanDuty)
    num(e, " of ", f.*.fanMost)
    word(e, ", period ", f.*.tach)
    word(e, "; thermal limits: CTF ", get(f.*.thermalInt, CG_THERMAL_INT__DIG_THERM_CTF))
    word(e, ", high ", get(f.*.thermalInt, CG_THERMAL_INT__DIG_THERM_INTH))
    word(e, ", low ", get(f.*.thermalInt, CG_THERMAL_INT__DIG_THERM_INTL))
    word(e, ", control ", f.*.thermalCtrl)
    say(e, "\n")
    say(e, "gpu: firmware:")
    var k: usize = 0
    while k <= FILES.length {
        say(e, " ")
        say(e, f.*.files[k].name)
        if f.*.files[k].holds == Holds.yes || f.*.files[k].version != 0 { word(e, " ", f.*.files[k].version) }
        k += 1
    }
    say(e, if f.*.filesHold { ": the nine files hold\n" } else { "\n" })
    k = 0
    while k <= FILES.length {
        if f.*.files[k].holds != Holds.yes {
            say(e, "gpu: firmware: ")
            say(e, f.*.files[k].name)
            say(e, " ")
            say(e, holdsText(f.*.files[k].holds))
            say(e, "\n")
        }
        k += 1
    }
    word(e, "gpu: GART by Linux's rule: 256 MiB at ", f.*.gartStart)
    word(e, "..", f.*.gartEnd)
    say(e, if f.*.gartFits { ", beside the card's memory\n" } else { ": IT OVERLAPS THE CARD'S MEMORY\n" })
}

// The golden registers' present values (the later stages' writes), in
// Linux's tables' order, for the log alone.
fn sayGolden(e: *Engines) -> void {
    say(e, "gpu: golden words as found, memory:")
    var k: usize = 0
    while k < GOLDEN_MEMORY.length {
        word(e, " ", GOLDEN_MEMORY[k])
        word(e, "=", rd(e, GOLDEN_MEMORY[k]))
        k += 3
    }
    say(e, "\ngpu: golden words as found, graphics:")
    for number in GOLDEN_GRAPHICS {
        word(e, " ", number)
        word(e, "=", rd(e, number))
    }
    say(e, "\ngpu: golden words as found, common:")
    for number in GOLDEN_COMMON {
        word(e, " ", number)
        word(e, "=", rd(e, number))
    }
    const smcIndex = rd(e, SMC_IND_INDEX_11)
    word(e, " CG_ACLK_CNTL=", smc(e, ixCG_ACLK_CNTL))
    wr(e, SMC_IND_INDEX_11, smcIndex)
    say(e, "\ngpu: golden words as found, copy engines:")
    for number in GOLDEN_COPY {
        word(e, " ", number)
        word(e, "=", rd(e, number))
    }
    say(e, "\n")
}

// S0's own line: the card as found, in short.
fn sayFound(e: *Engines) -> void {
    const f = &e.*.found
    say(e, "gpu: step S0: card as found: SMC clock ")
    yesNo(e, f.*.smcClock & SMC_SYSCON_CLOCK_CNTL_0__ck_disable == 0, "on", "off")
    word(e, ", program counter ", f.*.counterAgain)
    yesNo(e, f.*.smcRunning, " (firmware running)", " (its ROM; firmware not running)")
    num(e, ", protected mode ", get(f.*.smcFirmware, SMU_FIRMWARE__SMU_MODE))
    num(e, ", key ", get(f.*.smcFirmware, SMU_FIRMWARE__SMU_SEL))
    say(e, " -> ")
    say(e, f.*.smcFile)
    word(e, "; memory controller ", f.*.sequencer)
    yesNo(e, f.*.sequencer & MC_SEQ_SUP_CNTL__RUN != 0, " runs", " DOES NOT RUN")
    yesNo(e, f.*.context0 & VM_CONTEXT0_CNTL__ENABLE_CONTEXT != 0, ", GART on", ", GART off")
    const on = left(f)
    yesNo(e, on & (ON_PROCESSORS | ON_COPY | ON_QUEUES) == 0, "; engines halted (ME ", "; engines NOT HALTED (ME ")
    hex(e, f.*.me)
    word(e, ", MEC ", f.*.mec)
    word(e, ", SDMA ", f.*.sdmaHalt[0])
    word(e, " ", f.*.sdmaHalt[1])
    say(e, ")")
    if f.*.gfxFound {
        num(e, "; ", f.*.gfx[2])
        num(e, " shader engines, ", f.*.gfx[2] * f.*.gfx[5] * f.*.gfx[4])
        say(e, " compute units by the ROM")
    }
    num(e, "; ", f.*.temperature)
    say(e, " C")
    say(e, if f.*.filesHold { "; nine firmware files in order" } else { "; FIRMWARE FILES MISSING OR DAMAGED (the lines above)" })
    took(e)
}

// What a start before this one left on, said; at a boot beyond stage 0
// halted first (by registers alone, the study's 8.7: the queues
// deactivated as Linux's pre-reset does, the processors' halt bits, the
// copy engines halted, the interrupt ring off, the doorbells off). The
// GART and a running SMC are taken over as they are; the RLC is left
// running (it reads no memory of ours).
fn quiet(e: *Engines) -> void {
    const f = &e.*.found
    const on = left(f)
    if on == 0 { return }
    say(e, if e.*.stage == 0 { "gpu: the card was left running by a start before this one:" } else { "gpu: step S0: the card was left running by a start before this one:" })
    var items: usize = 0
    if on & ON_RING != 0 {
        item(e, &items, "interrupt ring on (")
        hex(e, f.*.ihControl)
        say(e, ")")
    }
    if on & ON_COPY != 0 { item(e, &items, "copy engines running") }
    if on & ON_QUEUES != 0 { item(e, &items, "compute queues active") }
    if on & ON_PROCESSORS != 0 { item(e, &items, "processors running") }
    if on & ON_RLC != 0 { item(e, &items, "RLC running") }
    if on & ON_DOORBELLS != 0 { item(e, &items, "doorbells on") }
    if on & ON_GART != 0 { item(e, &items, "GART on") }
    if on & ON_SMC != 0 { item(e, &items, "SMC firmware running") }
    if e.*.stage == 0 {
        say(e, "; nothing is halted at stage 0: 1 or 2 held while the machine starts halts it first\n")
        return
    }
    if on & ON_RING != 0 {
        wr(e, IH_RB_CNTL, rd(e, IH_RB_CNTL) & ~(IH_RB_CNTL__RB_ENABLE | IH_RB_CNTL__ENABLE_INTR))
        wr(e, IH_RB_RPTR, 0)
        wr(e, IH_RB_WPTR, 0)
        pause(e, 1000)
    }
    if on & ON_COPY != 0 {
        var engine: usize = 0
        while engine < 2 {
            const at = engine * (SDMA1_CNTL - SDMA0_CNTL)
            wr(e, SDMA0_CNTL + at, rd(e, SDMA0_CNTL + at) & ~SDMA0_CNTL__AUTO_CTXSW_ENABLE)
            wr(e, SDMA0_GFX_RB_CNTL + at, rd(e, SDMA0_GFX_RB_CNTL + at) & ~SDMA0_GFX_RB_CNTL__RB_ENABLE)
            wr(e, SDMA0_GFX_IB_CNTL + at, rd(e, SDMA0_GFX_IB_CNTL + at) & ~SDMA0_GFX_IB_CNTL__IB_ENABLE)
            wr(e, SDMA0_F32_CNTL + at, rd(e, SDMA0_F32_CNTL + at) | SDMA0_F32_CNTL__HALT)
            engine += 1
        }
    }
    var stuck = false
    if on & ON_QUEUES != 0 {
        const selector = rd(e, SRBM_GFX_CNTL)
        const which = [_]usize{ queue(2, 1, 0), queue(1, 0, 0) }
        for select in which {
            wr(e, SRBM_GFX_CNTL, select)
            if rd(e, CP_HQD_ACTIVE) & CP_HQD_ACTIVE__ACTIVE != 0 {
                wr(e, CP_HQD_DEQUEUE_REQUEST, (rd(e, CP_HQD_DEQUEUE_REQUEST) & ~CP_HQD_DEQUEUE_REQUEST__DEQUEUE_REQ) | field(CP_HQD_DEQUEUE_REQUEST__DEQUEUE_REQ, 2))
                var waited: usize = 0
                while rd(e, CP_HQD_ACTIVE) & CP_HQD_ACTIVE__ACTIVE != 0 && waited < AMDGPU_MAX_USEC_TIMEOUT {
                    pause(e, 1)
                    waited += 1
                }
                if waited >= AMDGPU_MAX_USEC_TIMEOUT { stuck = true }
            }
            wr(e, CP_HQD_DEQUEUE_REQUEST, 0)
            wr(e, CP_HQD_PQ_RPTR, 0)
            wr(e, CP_HQD_PQ_WPTR, 0)
        }
        wr(e, SRBM_GFX_CNTL, selector)
    }
    if on & (ON_PROCESSORS | ON_QUEUES) != 0 {
        wr(e, CP_MEC_CNTL, CP_MEC_CNTL__MEC_ME1_HALT | CP_MEC_CNTL__MEC_ME2_HALT)
        wr(e, CP_ME_CNTL, rd(e, CP_ME_CNTL) | CP_ME_CNTL__ME_HALT | CP_ME_CNTL__PFP_HALT | CP_ME_CNTL__CE_HALT)
    }
    if on & ON_DOORBELLS != 0 { wr(e, BIF_DOORBELL_APER_EN, rd(e, BIF_DOORBELL_APER_EN) & ~BIF_DOORBELL_APER_EN__BIF_DOORBELL_APER_EN) }
    e.*.quieted = true
    word(e, ": all halted now (interrupt ring ", rd(e, IH_RB_CNTL))
    word(e, ", copy engines ", rd(e, SDMA0_F32_CNTL))
    word(e, " ", rd(e, SDMA1_F32_CNTL))
    word(e, ", ME ", rd(e, CP_ME_CNTL))
    word(e, ", MEC ", rd(e, CP_MEC_CNTL))
    word(e, ", doorbells ", rd(e, BIF_DOORBELL_APER_EN))
    say(e, if stuck { "; a queue did not let go in 100 ms" } else { "" })
    say(e, "), the GART and the SMC are taken over as they are\n")
}

// S0. Whether a stage beyond it may follow.
pub fn found(e: *Engines) -> bool {
    e.*.began = now(e)
    const f = &e.*.found
    f.*.started = false
    f.*.polaris10 = polaris10(e.*.card.device)
    const memsize = rd(e, CONFIG_MEMSIZE)
    f.*.started = memsize != 0 && memsize != 0xFFFFFFFF
    if !f.*.started {
        e.*.s0 = Outcome.refused
        say(e, "gpu: the card's engines are left alone: the firmware has not started the card\n")
        return false
    }
    if !f.*.polaris10 {
        e.*.s0 = Outcome.refused
        say(e, "gpu: the card's engines are not read: this driver knows their registers for a Polaris 10 (RX 470, 480, 570, 580) alone\n")
        return false
    }
    aside(e, true)
    read(e)
    sayDetails(e)
    aside(e, false)
    sayFound(e)
    e.*.s0 = Outcome.passed
    quiet(e)
    if !f.*.sane {
        e.*.s0 = Outcome.refused
        word(e, "gpu: step S0: the card's memory does not add up (location ", f.*.location)
        word(e, ", size word ", f.*.memsize)
        say(e, "): no stage beyond 0 runs\n")
        return false
    }
    if !f.*.gartFits {
        e.*.s0 = Outcome.refused
        word(e, "gpu: step S0: the GART's place by Linux's rule (", f.*.gartStart)
        say(e, ") is not beside the card's memory: no stage beyond 0 runs\n")
        return false
    }
    return true
}

// ---- The watch on the picture (the study's 8.2).

// The controller that shows the kernel's console (its surface lies in the
// console's part of the aperture), its frames in a short while, the memory
// interface's underflow bit, and a sum over the picture's memory.
pub fn look(e: *Engines, into: *Picture) -> void {
    into.*.shown = false
    into.*.millihertz = 0
    into.*.dry = false
    into.*.sum = 0
    if e.*.card.pictureBytes == 0 { return }
    const from = e.*.found.vramStart + e.*.card.pictureOffset
    var n: usize = 0
    while n < scanout.CONTROLLERS && !into.*.shown {
        const at = scanout.OFFSETS[n]
        const control = rd(e, at + scanout.CRTC_CONTROL)
        if control != 0xFFFFFFFF && control & 1 != 0 && rd(e, at + scanout.GRPH_ENABLE) & 1 != 0 {
            const address = ((rd(e, at + scanout.GRPH_PRIMARY_SURFACE_ADDRESS_HIGH) & 0xFF) << 32) | (rd(e, at + scanout.GRPH_PRIMARY_SURFACE_ADDRESS) & 0xFFFFFF00)
            if address >= from && address < from + e.*.card.pictureBytes {
                into.*.shown = true
                into.*.controller = n
                into.*.hTotal = (rd(e, at + scanout.CRTC_H_TOTAL) & 0x3FFF) + 1
                into.*.vTotal = (rd(e, at + scanout.CRTC_V_TOTAL) & 0x3FFF) + 1
            }
        }
        n += 1
    }
    if !into.*.shown { return }
    const card = scanout.Card.{ .read = e.*.hands.read, .now = e.*.hands.now, .write = e.*.hands.say }
    const rate = scanout.rateOf(&card, into.*.controller, into.*.hTotal, into.*.vTotal)
    into.*.millihertz = rate.millihertz
    into.*.dry = rd(e, DMIF_STATUS) & DMIF_STATUS__DMIF_UNDERFLOW != 0
    var sum: usize = 0
    var at = e.*.card.pictureOffset & ~@intCast(usize, 7)
    const end = e.*.card.pictureOffset + e.*.card.pictureBytes
    while at + 8 <= end {
        sum = (sum ^ vramRead(e, at)) *% 0x100000001B3
        at += 8
    }
    into.*.sum = sum
}

// The picture after a step held against before it: what changed (none:
// it is as it was).
pub const Change = enum(u8) { none, gone, frames, dry, memory }

pub fn changed(before: *const Picture, after: *const Picture) -> Change {
    if !before.*.shown { return Change.none }
    if !after.*.shown { return Change.gone }
    const apart = if before.*.millihertz > after.*.millihertz { before.*.millihertz - after.*.millihertz } else { after.*.millihertz - before.*.millihertz }
    if apart * 1000 > before.*.millihertz * RATE_SLACK { return Change.frames }
    if after.*.dry && !before.*.dry { return Change.dry }
    if after.*.sum != before.*.sum { return Change.memory }
    return Change.none
}

pub fn sayChange(e: *Engines, change: Change, before: *const Picture, after: *const Picture) -> void {
    if change == Change.gone {
        say(e, "the console's picture is no longer shown")
    } else if change == Change.frames {
        say(e, "the picture's frames: ")
        hertz(e, before.*.millihertz)
        say(e, " before, ")
        hertz(e, after.*.millihertz)
        say(e, " after")
    } else if change == Change.dry {
        say(e, "the memory interface ran dry (DMIF_STATUS says an underflow)")
    } else {
        word(e, "the picture's memory changed (sum ", before.*.sum)
        word(e, " then ", after.*.sum)
        say(e, ")")
    }
}

// "picture 59.98 Hz before and after, same sum" in a step's line.
pub fn sayWatch(e: *Engines, before: *const Picture) -> void {
    if !before.*.shown {
        say(e, "; no picture of the kernel's on this card to watch")
        return
    }
    say(e, "; picture ")
    hertz(e, before.*.millihertz)
    say(e, " before and after, same sum")
}

// The card still answers as it did (0xffffffff: it is gone).
// After a step (the study's 8.2, "alive"): CONFIG_MEMSIZE still what it
// was (all ones: the card is gone), the scratch register takes a value
// (and is put back), the block's status words said in the log.
pub fn alive(e: *Engines, step: []const u8) -> bool {
    if rd(e, CONFIG_MEMSIZE) != e.*.found.memsize { return false }
    const was = rd(e, SCRATCH_REG0)
    wr(e, SCRATCH_REG0, SCRATCH_TRIAL)
    const took = rd(e, SCRATCH_REG0)
    wr(e, SCRATCH_REG0, was)
    say(e, "gpu: after step ")
    say(e, step)
    word(e, ": the scratch register takes ", took)
    word(e, ", GRBM status ", rd(e, GRBM_STATUS))
    word(e, ", SRBM status ", rd(e, SRBM_STATUS))
    word(e, " and ", rd(e, SRBM_STATUS2))
    say(e, "\n")
    return took == SCRATCH_TRIAL
}

// ---- M1: the aperture divided, the driver's memory proved.

pub fn pattern(offset: usize) -> usize { return (offset + 1) *% 0x9E3779B97F4A7C15 }

// A 32-bit word of the card's memory through the index window
// (amdgpu_device_mm_access: the offset's low 31 bits with the aperture
// bit, its upper bits into MM_INDEX_HI).
fn windowRead(e: *Engines, offset: usize) -> usize {
    wr(e, MM_INDEX, (offset & MM_INDEX__MM_OFFSET) | MM_INDEX__MM_APER)
    wr(e, MM_INDEX_HI, offset >> 31)
    return rd(e, MM_DATA)
}

fn windowWrite(e: *Engines, offset: usize, value: usize) -> void {
    wr(e, MM_INDEX, (offset & MM_INDEX__MM_OFFSET) | MM_INDEX__MM_APER)
    wr(e, MM_INDEX_HI, offset >> 31)
    wr(e, MM_DATA, value)
}

// Where the picture a running controller shows ends in the aperture
// (bytes from its start); 0 for one that shows nothing in it.
fn surfaceEnd(e: *Engines, n: usize) -> usize {
    const at = scanout.OFFSETS[n]
    const control = rd(e, at + scanout.CRTC_CONTROL)
    if control == 0xFFFFFFFF || control & 1 == 0 || rd(e, at + scanout.GRPH_ENABLE) & 1 == 0 { return 0 }
    const address = ((rd(e, at + scanout.GRPH_PRIMARY_SURFACE_ADDRESS_HIGH) & 0xFF) << 32) | (rd(e, at + scanout.GRPH_PRIMARY_SURFACE_ADDRESS) & 0xFFFFFF00)
    const base = e.*.found.vramStart
    if address < base || address >= base + e.*.card.view { return 0 }
    return address - base + (rd(e, at + scanout.GRPH_PITCH) & 0x7FFF) * 4 * (rd(e, at + scanout.GRPH_Y_END) & 0x7FFF)
}

// M1. Whether it passed.
pub fn divide(e: *Engines) -> bool {
    e.*.began = now(e)
    const view = e.*.card.view
    const limit = displayLimit(view, 1)
    if limit == 0 {
        e.*.m1 = Outcome.refused
        say(e, "gpu: step M1 refused: the aperture in the kernel's view is ")
        size(e, view)
        say(e, ", too small to give the driver 64 MiB of it\n")
        return false
    }
    var n: usize = 0
    while n < scanout.CONTROLLERS {
        const end = surfaceEnd(e, n)
        if end > limit {
            e.*.m1 = Outcome.refused
            num(e, "gpu: step M1 refused: controller ", n)
            say(e, "'s picture reaches to ")
            size(e, end)
            say(e, " of the aperture, into the driver's part from ")
            size(e, limit)
            say(e, "\n")
            return false
        }
        n += 1
    }
    if e.*.card.pictureBytes != 0 && e.*.card.pictureOffset + e.*.card.pictureBytes > limit {
        e.*.m1 = Outcome.refused
        say(e, "gpu: step M1 refused: the kernel's display reaches to ")
        size(e, e.*.card.pictureOffset + e.*.card.pictureBytes)
        say(e, " of the aperture, into the driver's part from ")
        size(e, limit)
        say(e, "\n")
        return false
    }
    e.*.limit = limit
    const sequencer = rd(e, MC_SEQ_SUP_CNTL)
    if sequencer & MC_SEQ_SUP_CNTL__RUN == 0 {
        e.*.m1 = Outcome.failed
        word(e, "gpu: step M1 failed: the memory controller's sequencer does not run (", sequencer)
        say(e, "): the driver's memory is not tried\n")
        return false
    }
    aside(e, true)
    var before: Picture = undefined
    look(e, &before)
    // The pattern, every word of the driver's first PROVED bytes, read
    // back; then nothing, read back.
    var wrong = NONE
    var wrongValue: usize = 0
    var wrongWanted: usize = 0
    var at = limit
    while at < limit + PROVED {
        vramWrite(e, at, pattern(at))
        at += 8
    }
    @fence(seq_cst)
    at = limit
    while at < limit + PROVED && wrong == NONE {
        const value = vramRead(e, at)
        if value != pattern(at) {
            wrong = at
            wrongValue = value
            wrongWanted = pattern(at)
        }
        at += 8
    }
    at = limit
    while at < limit + PROVED {
        vramWrite(e, at, 0)
        at += 8
    }
    @fence(seq_cst)
    at = limit
    while at < limit + PROVED && wrong == NONE {
        const value = vramRead(e, at)
        if value != 0 {
            wrong = at
            wrongValue = value
            wrongWanted = 0
        }
        at += 8
    }
    // One word beyond the aperture by the index window, read back and put
    // back (the window's two index words as they were found).
    const vram = e.*.found.vramBytes
    var beyond = NONE
    if vram >= BEYOND_AT + AMDGPU_GPU_PAGE_SIZE {
        beyond = BEYOND_AT
    } else if vram > view + AMDGPU_GPU_PAGE_SIZE {
        beyond = vram - AMDGPU_GPU_PAGE_SIZE
    }
    var windowWrong = false
    var windowValue: usize = 0
    if beyond != NONE {
        const index = rd(e, MM_INDEX)
        const high = rd(e, MM_INDEX_HI)
        const was = windowRead(e, beyond)
        const trial = pattern(beyond) & 0xFFFFFFFF
        windowWrite(e, beyond, trial)
        windowValue = windowRead(e, beyond)
        windowWrite(e, beyond, was)
        if windowValue != trial || windowRead(e, beyond) != was { windowWrong = true }
        wr(e, MM_INDEX, index)
        wr(e, MM_INDEX_HI, high)
    }
    const living = alive(e, "M1")
    var after: Picture = undefined
    look(e, &after)
    aside(e, false)
    if wrong != NONE || windowWrong || !living {
        e.*.m1 = Outcome.failed
        say(e, "gpu: step M1 failed: ")
        if wrong != NONE {
            say(e, "the card's memory at ")
            size(e, limit)
            word(e, " + ", wrong - limit)
            word(e, " of the aperture reads ", wrongValue)
            word(e, " where ", wrongWanted)
            say(e, " was written")
        } else if windowWrong {
            word(e, "the word at ", beyond)
            word(e, " of the card's memory reads ", windowValue)
            say(e, " by the index window, not what was written")
        } else {
            say(e, "the card no longer answers as it did")
        }
        say(e, "; nothing else was written\n")
        return false
    }
    const minded = changed(&before, &after)
    if minded != Change.none {
        e.*.m1 = Outcome.failed
        say(e, "gpu: step M1 failed: ")
        sayChange(e, minded, &before, &after)
        say(e, "; nothing else was written\n")
        return false
    }
    e.*.m1 = Outcome.passed
    say(e, "gpu: step M1: the aperture is the display's up to ")
    size(e, limit)
    say(e, " and the driver's from there; ")
    size(e, PROVED)
    say(e, " of it written, read back and cleared")
    if beyond != NONE {
        say(e, "; a word at ")
        size(e, beyond)
        say(e, " of the card's memory reads back by the index window")
    } else {
        say(e, "; the card's memory has nothing beyond the aperture")
    }
    sayWatch(e, &before)
    took(e)
    return true
}

// ---- M2: the GART on.

// The memory controller idle as far as a picture being read lets it be
// (MCB_BUSY is the display's reading too: not waited for), within
// Linux's 100 ms; said, and gone on from either way, as Linux does.
// `sample`: the busy bits looked at a thousand times over a millisecond
// first and the counts said.
fn idle(e: *Engines, sample: bool) -> void {
    if sample {
        var display: usize = 0
        var others: usize = 0
        var k: usize = 0
        while k < 1000 {
            const status = rd(e, SRBM_STATUS)
            if status & SRBM_STATUS__MCB_BUSY != 0 { display += 1 }
            if status & (SRBM_STATUS__MCB_NON_DISPLAY_BUSY | SRBM_STATUS__MCC_BUSY | SRBM_STATUS__MCD_BUSY | SRBM_STATUS__VMC_BUSY | SRBM_STATUS__VMC1_BUSY) != 0 { others += 1 }
            pause(e, 1)
            k += 1
        }
        num(e, "gpu: memory controller busy bits over 1 ms: display ", display)
        num(e, " of 1000, others ", others)
        say(e, " of 1000\n")
    }
    const busy = SRBM_STATUS__MCB_NON_DISPLAY_BUSY | SRBM_STATUS__MCC_BUSY | SRBM_STATUS__MCD_BUSY | SRBM_STATUS__VMC_BUSY | SRBM_STATUS__VMC1_BUSY
    var waited: usize = 0
    var status = rd(e, SRBM_STATUS)
    while status & busy != 0 && waited < AMDGPU_MAX_USEC_TIMEOUT {
        pause(e, 1)
        waited += 1
        status = rd(e, SRBM_STATUS)
    }
    if status & busy != 0 {
        word(e, "gpu: the memory controller is not idle after 100 ms (", status)
        say(e, "): Linux goes on, so does the step\n")
    }
}

// What a GART entry holds: a page of the dma piece (valid, system,
// snooped, executable, readable, writeable: what Linux writes for a page
// of the system's mapped cached), else the dummy page with no flag.
pub fn entry(e: *const Engines, k: usize) -> usize {
    if k < e.*.card.dmaPages && k < DMA_PAGES {
        return ((e.*.card.dmaBase + k * AMDGPU_GPU_PAGE_SIZE) & PTE_ADDRESS) | AMDGPU_PTE_VALID | AMDGPU_PTE_SYSTEM | AMDGPU_PTE_SNOOPED | AMDGPU_PTE_EXECUTABLE | AMDGPU_PTE_READABLE | AMDGPU_PTE_WRITEABLE
    }
    return e.*.dummy & PTE_ADDRESS
}

// The entries read back through the index window too: what the card's
// own way to its memory sees.
pub const WINDOW_ENTRIES = [_]usize{ 0, DMA_PAGES - 1, DMA_PAGES, GART_BYTES / AMDGPU_GPU_PAGE_SIZE - 1 }

// The value each kept register was given (beside what it held).
var given: [KEPT]usize = undefined

// The registers a step wrote read back (the last write of each), but for
// those that are commands or pointers; the first that differs (NONE:
// none).
fn readBack(e: *Engines, mark: usize) -> usize {
    var k = e.*.kept.count
    while k > mark {
        k -= 1
        const number = e.*.kept.register[k]
        var later = false
        var j = k + 1
        while j < e.*.kept.count {
            if e.*.kept.register[j] == number { later = true }
            j += 1
        }
        const command = number == VM_L2_CNTL2 || number == IH_RB_RPTR || number == IH_RB_WPTR
        if !later && !command && rd(e, number) != given[k] { return k }
    }
    return NONE
}

fn put(e: *Engines, number: usize, value: usize) -> void {
    if e.*.kept.count < KEPT { given[e.*.kept.count] = value & 0xFFFFFFFF }
    set(e, number, value)
}

fn alter(e: *Engines, number: usize, clear: usize, value: usize) -> void { put(e, number, (rd(e, number) & ~clear) | value) }

// Only where it differs: a register put to `value`, said with what it was.
fn whereDiffers(e: *Engines, number: usize, value: usize) -> void {
    const was = rd(e, number)
    if was == value { return }
    put(e, number, value)
    word(e, "gpu: ", number)
    word(e, " was ", was)
    word(e, " now ", value)
    say(e, "\n")
}

// Why a step failed, for its line: the words and up to three numbers.
const Why = struct {
    text: []const u8
    number: usize
    value: usize
    wanted: usize
}

fn none() -> Why { return Why.{ .text = "", .number = NONE, .value = NONE, .wanted = NONE } }

fn sayWhy(e: *Engines, why: *const Why) -> void {
    say(e, why.*.text)
    if why.*.number != NONE { hex(e, why.*.number) }
    if why.*.value != NONE {
        word(e, " (", why.*.value)
        if why.*.wanted != NONE { word(e, ", not ", why.*.wanted) }
        say(e, ")")
    }
}

// M2. Whether it passed.
pub fn gart(e: *Engines) -> bool {
    e.*.began = now(e)
    const f = &e.*.found
    if e.*.m1 != Outcome.passed {
        e.*.m2 = Outcome.refused
        say(e, "gpu: step M2 refused: the aperture is not divided (step M1)\n")
        return false
    }
    if f.*.hostPathNonZero != 0 {
        e.*.m2 = Outcome.refused
        word(e, "gpu: step M2 refused: the host path's surface word ", f.*.hostPathFirst)
        word(e, " is ", f.*.hostPathValue)
        say(e, " (Linux writes 0 there without looking): left alone\n")
        return false
    }
    const access = rd(e, BIF_FB_EN)
    if access & (BIF_FB_EN__FB_READ_EN | BIF_FB_EN__FB_WRITE_EN) != BIF_FB_EN__FB_READ_EN | BIF_FB_EN__FB_WRITE_EN {
        e.*.m2 = Outcome.refused
        word(e, "gpu: step M2 refused: the processor's access to the aperture reads ", access)
        say(e, ", not as a card whose picture the processor draws has it\n")
        return false
    }
    if e.*.card.dmaBase == 0 || e.*.card.dmaPages < DMA_PAGES || e.*.card.dmaBase + DMA_PAGES * AMDGPU_GPU_PAGE_SIZE > MC_MASK + 1 {
        e.*.m2 = Outcome.refused
        say(e, "gpu: step M2 refused: the memory set aside for the card is missing or beyond the card's 40 bits\n")
        return false
    }
    const allocate = e.*.hands.dma
    e.*.dummy = allocate(AMDGPU_GPU_PAGE_SIZE)
    if e.*.dummy == 0 || e.*.dummy < e.*.card.dmaBase || e.*.dummy >= e.*.card.dmaBase + DMA_PAGES * AMDGPU_GPU_PAGE_SIZE {
        e.*.m2 = Outcome.refused
        e.*.dummy = 0
        say(e, "gpu: step M2 refused: no page of the memory set aside for the card is left for the dummy page\n")
        return false
    }
    e.*.tableAt = e.*.limit + TABLE_AT
    e.*.table = f.*.vramStart + e.*.tableAt
    e.*.defaultAt = e.*.limit + DEFAULT_PAGE_AT
    e.*.defaultPage = f.*.vramStart + e.*.defaultAt
    const mark = e.*.kept.count
    aside(e, true)
    var before: Picture = undefined
    look(e, &before)

    // Linux's gmc_v8_0_hw_init up to the GART: the golden words (read,
    // the mask cleared, the value set: written only where that differs),
    // the host path's words (all 0 already: S0 looked), the wait, the
    // system aperture, the AGP words, the wait again, the aperture's
    // access (read only, above), the host path's control.
    var k: usize = 0
    while k < GOLDEN_MEMORY.length {
        const number = GOLDEN_MEMORY[k]
        const mask = GOLDEN_MEMORY[k + 1]
        const value = if mask == 0xFFFFFFFF { GOLDEN_MEMORY[k + 2] } else { (rd(e, number) & ~mask) | GOLDEN_MEMORY[k + 2] }
        whereDiffers(e, number, value)
        k += 3
    }
    whereDiffers(e, HDP_REG_COHERENCY_FLUSH_CNTL, 0)
    idle(e, true)
    whereDiffers(e, MC_VM_SYSTEM_APERTURE_LOW_ADDR, f.*.vramStart >> 12)
    whereDiffers(e, MC_VM_SYSTEM_APERTURE_HIGH_ADDR, f.*.vramEnd >> 12)
    whereDiffers(e, MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR, e.*.defaultPage >> 12)
    whereDiffers(e, MC_VM_AGP_BASE, 0)
    whereDiffers(e, MC_VM_AGP_TOP, AGP_EMPTY)
    whereDiffers(e, MC_VM_AGP_BOT, AGP_EMPTY)
    idle(e, false)
    const misc = rd(e, HDP_MISC_CNTL)
    whereDiffers(e, HDP_MISC_CNTL, misc & ~HDP_MISC_CNTL__FLUSH_INVALIDATE_CACHE)

    // The default page cleared, the table filled (every entry: the dma
    // piece's pages at the first 2048, the dummy page with no flag at the
    // rest), and the host path flushed so that the card sees it
    // (vi_flush_hdp: written and read back).
    k = 0
    while k < AMDGPU_GPU_PAGE_SIZE {
        vramWrite(e, e.*.defaultAt + k, 0)
        k += 8
    }
    const entries = GART_BYTES / AMDGPU_GPU_PAGE_SIZE
    k = 0
    while k < entries {
        vramWrite(e, e.*.tableAt + k * ENTRY_BYTES, entry(e, k))
        k += 1
    }
    @fence(seq_cst)
    wr(e, HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
    _ = rd(e, HDP_MEM_COHERENCY_FLUSH_CNTL)

    // gmc_v8_0_gart_enable's twenty steps, in its order.
    alter(e, MC_VM_MX_L1_TLB_CNTL, MC_VM_MX_L1_TLB_CNTL__ENABLE_L1_TLB | MC_VM_MX_L1_TLB_CNTL__ENABLE_L1_FRAGMENT_PROCESSING | MC_VM_MX_L1_TLB_CNTL__SYSTEM_ACCESS_MODE | MC_VM_MX_L1_TLB_CNTL__ENABLE_ADVANCED_DRIVER_MODEL | MC_VM_MX_L1_TLB_CNTL__SYSTEM_APERTURE_UNMAPPED_ACCESS, MC_VM_MX_L1_TLB_CNTL__ENABLE_L1_TLB | MC_VM_MX_L1_TLB_CNTL__ENABLE_L1_FRAGMENT_PROCESSING | field(MC_VM_MX_L1_TLB_CNTL__SYSTEM_ACCESS_MODE, SYSTEM_ACCESS_MODE) | MC_VM_MX_L1_TLB_CNTL__ENABLE_ADVANCED_DRIVER_MODEL)
    const l2 = VM_L2_CNTL__ENABLE_L2_CACHE | VM_L2_CNTL__ENABLE_L2_FRAGMENT_PROCESSING | VM_L2_CNTL__ENABLE_L2_PTE_CACHE_LRU_UPDATE_BY_WRITE | VM_L2_CNTL__ENABLE_L2_PDE0_CACHE_LRU_UPDATE_BY_WRITE | VM_L2_CNTL__ENABLE_DEFAULT_PAGE_OUT_TO_SYSTEM_MEMORY
    alter(e, VM_L2_CNTL, l2 | VM_L2_CNTL__EFFECTIVE_L2_QUEUE_SIZE | VM_L2_CNTL__CONTEXT1_IDENTITY_ACCESS_MODE, l2 | field(VM_L2_CNTL__EFFECTIVE_L2_QUEUE_SIZE, EFFECTIVE_L2_QUEUE_SIZE) | field(VM_L2_CNTL__CONTEXT1_IDENTITY_ACCESS_MODE, CONTEXT1_IDENTITY_ACCESS_MODE))
    alter(e, VM_L2_CNTL2, 0, VM_L2_CNTL2__INVALIDATE_ALL_L1_TLBS | VM_L2_CNTL2__INVALIDATE_L2_CACHE)
    alter(e, VM_L2_CNTL3, VM_L2_CNTL3__L2_CACHE_BIGK_ASSOCIATIVITY | VM_L2_CNTL3__BANK_SELECT | VM_L2_CNTL3__L2_CACHE_BIGK_FRAGMENT_SIZE, VM_L2_CNTL3__L2_CACHE_BIGK_ASSOCIATIVITY | field(VM_L2_CNTL3__BANK_SELECT, FRAGMENT_SIZE) | field(VM_L2_CNTL3__L2_CACHE_BIGK_FRAGMENT_SIZE, FRAGMENT_SIZE))
    const taps = VM_L2_CNTL4__VMC_TAP_CONTEXT0_PDE_REQUEST_PHYSICAL | VM_L2_CNTL4__VMC_TAP_CONTEXT0_PDE_REQUEST_SHARED | VM_L2_CNTL4__VMC_TAP_CONTEXT0_PDE_REQUEST_SNOOP | VM_L2_CNTL4__VMC_TAP_CONTEXT0_PTE_REQUEST_PHYSICAL | VM_L2_CNTL4__VMC_TAP_CONTEXT0_PTE_REQUEST_SHARED | VM_L2_CNTL4__VMC_TAP_CONTEXT0_PTE_REQUEST_SNOOP | VM_L2_CNTL4__VMC_TAP_CONTEXT1_PDE_REQUEST_PHYSICAL | VM_L2_CNTL4__VMC_TAP_CONTEXT1_PDE_REQUEST_SHARED | VM_L2_CNTL4__VMC_TAP_CONTEXT1_PDE_REQUEST_SNOOP | VM_L2_CNTL4__VMC_TAP_CONTEXT1_PTE_REQUEST_PHYSICAL | VM_L2_CNTL4__VMC_TAP_CONTEXT1_PTE_REQUEST_SHARED | VM_L2_CNTL4__VMC_TAP_CONTEXT1_PTE_REQUEST_SNOOP
    alter(e, VM_L2_CNTL4, taps, 0)
    put(e, VM_CONTEXT0_PAGE_TABLE_START_ADDR, f.*.gartStart >> 12)
    put(e, VM_CONTEXT0_PAGE_TABLE_END_ADDR, f.*.gartEnd >> 12)
    put(e, VM_CONTEXT0_PAGE_TABLE_BASE_ADDR, e.*.table >> 12)
    put(e, VM_CONTEXT0_PROTECTION_FAULT_DEFAULT_ADDR, (e.*.dummy >> 12) & 0xFFFFFFFF)
    put(e, VM_CONTEXT0_CNTL2, 0)
    alter(e, VM_CONTEXT0_CNTL, VM_CONTEXT0_CNTL__ENABLE_CONTEXT | VM_CONTEXT0_CNTL__PAGE_TABLE_DEPTH | VM_CONTEXT0_CNTL__RANGE_PROTECTION_FAULT_ENABLE_DEFAULT, VM_CONTEXT0_CNTL__ENABLE_CONTEXT | VM_CONTEXT0_CNTL__RANGE_PROTECTION_FAULT_ENABLE_DEFAULT)
    put(e, VM_L2_CONTEXT1_IDENTITY_APERTURE_LOW_ADDR, 0)
    put(e, VM_L2_CONTEXT1_IDENTITY_APERTURE_HIGH_ADDR, 0)
    put(e, VM_L2_CONTEXT_IDENTITY_PHYSICAL_OFFSET, 0)
    put(e, VM_CONTEXT1_PAGE_TABLE_START_ADDR, 0)
    put(e, VM_CONTEXT1_PAGE_TABLE_END_ADDR, MAX_PFN - 1)
    var space: usize = 1
    while space < 16 {
        put(e, if space < 8 { VM_CONTEXT0_PAGE_TABLE_BASE_ADDR + space } else { VM_CONTEXT8_PAGE_TABLE_BASE_ADDR + space - 8 }, e.*.table >> 12)
        space += 1
    }
    put(e, VM_CONTEXT1_PROTECTION_FAULT_DEFAULT_ADDR, (e.*.dummy >> 12) & 0xFFFFFFFF)
    put(e, VM_CONTEXT1_CNTL2, VM_CONTEXT1_CNTL2__ENABLE_INTERRUPT_PROCESSING_FOR_SUBSEQUENT_FAULTS_PER_CONTEXT)
    const faults = VM_CONTEXT1_CNTL__RANGE_PROTECTION_FAULT_ENABLE_DEFAULT | VM_CONTEXT1_CNTL__DUMMY_PAGE_PROTECTION_FAULT_ENABLE_DEFAULT | VM_CONTEXT1_CNTL__PDE0_PROTECTION_FAULT_ENABLE_DEFAULT | VM_CONTEXT1_CNTL__VALID_PROTECTION_FAULT_ENABLE_DEFAULT | VM_CONTEXT1_CNTL__READ_PROTECTION_FAULT_ENABLE_DEFAULT | VM_CONTEXT1_CNTL__WRITE_PROTECTION_FAULT_ENABLE_DEFAULT | VM_CONTEXT1_CNTL__EXECUTE_PROTECTION_FAULT_ENABLE_DEFAULT
    alter(e, VM_CONTEXT1_CNTL, VM_CONTEXT1_CNTL__ENABLE_CONTEXT | VM_CONTEXT1_CNTL__PAGE_TABLE_DEPTH | faults | VM_CONTEXT1_CNTL__PAGE_TABLE_BLOCK_SIZE, VM_CONTEXT1_CNTL__ENABLE_CONTEXT | field(VM_CONTEXT1_CNTL__PAGE_TABLE_DEPTH, 1) | faults | field(VM_CONTEXT1_CNTL__PAGE_TABLE_BLOCK_SIZE, BLOCK_SIZE - 9))
    alter(e, VM_CONTEXT1_CNTL, faults, faults)
    const responseBefore = rd(e, VM_INVALIDATE_RESPONSE)
    wr(e, VM_INVALIDATE_REQUEST, 1)
    const responseAfter = rd(e, VM_INVALIDATE_RESPONSE)
    pause(e, 1000)
    const responseLater = rd(e, VM_INVALIDATE_RESPONSE)
    word(e, "gpu: flush of address space 0: response ", responseBefore)
    word(e, " -> ", responseAfter)
    word(e, " -> ", responseLater)
    say(e, "\n")

    // The self-test: every word as written, no fault in either address
    // space, the table as written (through the aperture; four entries
    // through the index window too: the card's own way to its memory),
    // the card alive, the picture as it was.
    var why = none()
    if !alive(e, "M2") { why.text = "the card no longer answers as it did" }
    if why.text.length == 0 && e.*.kept.full { why.text = "more registers were to be kept than there is room for" }
    if why.text.length == 0 {
        const differs = readBack(e, mark)
        if differs != NONE {
            why.text = "a register does not hold what was written: "
            why.number = e.*.kept.register[differs]
            why.value = rd(e, why.number)
            why.wanted = given[differs]
        }
    }
    var context: usize = 0
    while context < 2 && why.text.length == 0 {
        const status = rd(e, VM_CONTEXT0_PROTECTION_FAULT_STATUS + context)
        const page = rd(e, VM_CONTEXT0_PROTECTION_FAULT_ADDR + context)
        if status != 0 || page != 0 {
            why.text = if context == 0 { "a fault in address space 0 at page " } else { "a fault in address space 1 at page " }
            why.number = page
            why.value = status
        }
        context += 1
    }
    k = 0
    while k < entries && why.text.length == 0 {
        const value = vramRead(e, e.*.tableAt + k * ENTRY_BYTES)
        if value != entry(e, k) {
            why.text = "the GART's table reads back otherwise at entry "
            why.number = k
            why.value = value
            why.wanted = entry(e, k)
        }
        k += 1
    }
    if why.text.length == 0 {
        const index = rd(e, MM_INDEX)
        const high = rd(e, MM_INDEX_HI)
        for which in WINDOW_ENTRIES {
            const at = e.*.tableAt + which * ENTRY_BYTES
            const value = windowRead(e, at) | (windowRead(e, at + 4) << 32)
            if why.text.length == 0 && value != entry(e, which) {
                why.text = "the card does not see the GART's entry "
                why.number = which
                why.value = value
                why.wanted = entry(e, which)
            }
        }
        wr(e, MM_INDEX, index)
        wr(e, MM_INDEX_HI, high)
    }
    var after: Picture = undefined
    look(e, &after)
    aside(e, false)
    const minded = changed(&before, &after)
    if why.text.length != 0 || minded != Change.none {
        e.*.m2 = Outcome.failed
        // The way back (the study's 2.4, "turning it off", with the
        // firmware's words): every register the step wrote as it was,
        // last first: the address spaces off before the caches.
        const back = putBack(e, mark)
        say(e, "gpu: step M2 failed: ")
        if why.text.length != 0 {
            sayWhy(e, &why)
        } else {
            sayChange(e, minded, &before, &after)
        }
        num(e, "; the GART's words put back as the firmware had them (", back)
        say(e, " registers)\n")
        return false
    }
    e.*.m2 = Outcome.passed
    word(e, "gpu: step M2: GART 256 MiB at ", f.*.gartStart)
    word(e, ", its table at ", e.*.table)
    say(e, " (")
    size(e, e.*.tableAt)
    num(e, " of the aperture), ", DMA_PAGES)
    num(e, " of ", entries)
    say(e, " entries map ")
    size(e, DMA_PAGES * AMDGPU_GPU_PAGE_SIZE)
    word(e, " at ", e.*.card.dmaBase)
    word(e, "; system aperture ", f.*.vramStart)
    word(e, "..", f.*.vramEnd)
    say(e, if f.*.apertureLow == f.*.vramStart >> 12 && f.*.apertureHigh == f.*.vramEnd >> 12 { " (as found)" } else { " (set)" })
    say(e, "; no fault")
    sayWatch(e, &before)
    took(e)
    return true
}

// ---- I1: the interrupt ring.

// The handler's body (amdgpu_ih_process, tonga_ih_get_wptr, its
// decoding, tonga_ih_set_rptr without a doorbell): the entries from the
// read pointer to the write pointer the card wrote back taken, 31 at a
// time, the read pointer told after each run, again while the card wrote
// more; an overflow handled as Linux does.
fn entriesTaken(e: *Engines) -> void {
    var rounds: usize = 0
    while rounds < IH_RING_BYTES / IH_ENTRY_BYTES {
        rounds += 1
        var pointer = memoryRead(e, e.*.pointers)
        if pointer & IH_RB_WPTR__RB_OVERFLOW != 0 {
            pointer = rd(e, IH_RB_WPTR)
            if pointer & IH_RB_WPTR__RB_OVERFLOW != 0 {
                pointer = pointer & ~IH_RB_WPTR__RB_OVERFLOW
                e.*.readPointer = (pointer + IH_ENTRY_BYTES) & (IH_RING_BYTES - 1)
                wr(e, IH_RB_CNTL, rd(e, IH_RB_CNTL) | IH_RB_CNTL__WPTR_OVERFLOW_CLEAR)
            }
        }
        pointer = pointer & (IH_RING_BYTES - 1)
        if pointer == e.*.readPointer { return }
        var count = AMDGPU_IH_MAX_NUM_IVS
        while e.*.readPointer != pointer && count > 1 {
            count -= 1
            const source = memoryRead(e, e.*.ring + e.*.readPointer) & 0xFF
            var known = false
            var k: usize = 0
            while k < e.*.sourcesCount {
                if e.*.sources[k] == source { known = true }
                k += 1
            }
            if !known && e.*.sourcesCount < 8 {
                e.*.sources[e.*.sourcesCount] = source
                e.*.sourcesCount += 1
            }
            e.*.entries += 1
            e.*.readPointer = (e.*.readPointer + IH_ENTRY_BYTES) & (IH_RING_BYTES - 1)
        }
        wr(e, IH_RB_RPTR, e.*.readPointer)
    }
}

// The ring off (tonga_ih_irq_disable: both enables cleared, the pointers
// 0, a millisecond).
fn ringOff(e: *Engines) -> void {
    wr(e, IH_RB_CNTL, rd(e, IH_RB_CNTL) & ~(IH_RB_CNTL__RB_ENABLE | IH_RB_CNTL__ENABLE_INTR))
    wr(e, IH_RB_RPTR, 0)
    wr(e, IH_RB_WPTR, 0)
    pause(e, 1000)
}

// I1. Whether it passed.
pub fn interrupts(e: *Engines) -> bool {
    e.*.began = now(e)
    if e.*.m2 != Outcome.passed || e.*.dummy == 0 {
        e.*.i1 = Outcome.refused
        say(e, "gpu: step I1 refused: the GART is not on (step M2), whose dummy page the ring is given\n")
        return false
    }
    const command = e.*.hands.command
    const pci = command()
    if pci & 0x4 == 0 {
        e.*.i1 = Outcome.refused
        word(e, "gpu: step I1 refused: the card's bus mastering is off (PCI command ", pci)
        say(e, "): it may not write the system's memory\n")
        return false
    }
    const allocate = e.*.hands.dma
    e.*.ring = allocate(IH_RING_BYTES)
    e.*.pointers = allocate(AMDGPU_GPU_PAGE_SIZE)
    if e.*.ring == 0 || e.*.pointers == 0 || e.*.ring + IH_RING_BYTES > MC_MASK + 1 || e.*.pointers > MC_MASK {
        e.*.i1 = Outcome.refused
        say(e, "gpu: step I1 refused: no room for the ring in the memory set aside for the card\n")
        return false
    }
    const mark = e.*.kept.count
    e.*.readPointer = 0
    e.*.entries = 0
    e.*.sourcesCount = 0
    aside(e, true)
    var before: Picture = undefined
    look(e, &before)
    const counted = e.*.hands.interrupts
    const waiting = e.*.hands.waiting
    const route = e.*.hands.route
    e.*.routed = route()
    const taken = counted()
    // (A message of this card's that waits already cannot tell whether
    // one comes now.)
    const waitedBefore = waiting()

    // tonga_ih_irq_init, in its order.
    alter(e, IH_RB_CNTL, IH_RB_CNTL__RB_ENABLE | IH_RB_CNTL__ENABLE_INTR, 0)
    put(e, IH_RB_RPTR, 0)
    put(e, IH_RB_WPTR, 0)
    put(e, INTERRUPT_CNTL2, (e.*.dummy >> 8) & 0xFFFFFFFF)
    alter(e, INTERRUPT_CNTL, INTERRUPT_CNTL__IH_DUMMY_RD_OVERRIDE | INTERRUPT_CNTL__IH_REQ_NONSNOOP_EN, 0)
    put(e, IH_RB_BASE, (e.*.ring >> 8) & 0xFFFFFFFF)
    var bits: usize = 0
    while (@intCast(usize, 1) << @intCast(u6, bits)) < IH_RING_BYTES / 4 { bits += 1 }
    var control = IH_RB_CNTL__WPTR_OVERFLOW_CLEAR | field(IH_RB_CNTL__RB_SIZE, bits) | IH_RB_CNTL__WPTR_WRITEBACK_ENABLE | field(IH_RB_CNTL__MC_VMID, 0)
    if e.*.routed { control |= IH_RB_CNTL__RPTR_REARM }
    put(e, IH_RB_CNTL, control)
    put(e, IH_RB_WPTR_ADDR_LO, e.*.pointers & 0xFFFFFFFF)
    put(e, IH_RB_WPTR_ADDR_HI, (e.*.pointers >> 32) & IH_RB_WPTR_ADDR_HI__ADDR)
    put(e, IH_RB_RPTR, 0)
    put(e, IH_RB_WPTR, 0)
    alter(e, IH_DOORBELL_RPTR, IH_DOORBELL_RPTR__ENABLE, 0)
    alter(e, IH_RB_CNTL, 0, IH_RB_CNTL__RB_ENABLE | IH_RB_CNTL__ENABLE_INTR)
    e.*.ringUp = true

    // The self-test (the study's 4.7): every word as written (the
    // control word but for its bit 31, a command, and the write pointer's
    // address but for its two low bits, which it does not keep), then a
    // second of looking with the handler's body run at every look: the
    // ring stays empty unless a source was on already, every entry that
    // comes is taken and has its interrupt, none of it a storm.
    var why = none()
    if !alive(e, "I1") { why.text = "the card no longer answers as it did" }
    if why.text.length == 0 && e.*.kept.full { why.text = "more registers were to be kept than there is room for" }
    if why.text.length == 0 {
        const differs = readBack(e, mark)
        if differs != NONE {
            const number = e.*.kept.register[differs]
            const value = rd(e, number)
            const wanted = given[differs]
            const fine = (number == IH_RB_CNTL && value == wanted & ~IH_RB_CNTL__WPTR_OVERFLOW_CLEAR) || (number == IH_RB_WPTR_ADDR_LO && value == wanted & IH_RB_WPTR_ADDR_LO__ADDR)
            if !fine {
                why.text = "a register does not hold what was written: "
                why.number = number
                why.value = value
                why.wanted = wanted
            }
        }
    }
    if why.text.length == 0 {
        const started = now(e)
        while now(e) - started < SILENT_FOR && e.*.entries <= STORM {
            entriesTaken(e)
            pause(e, LOOK_EVERY)
        }
        entriesTaken(e)
        const pointer = rd(e, IH_RB_WPTR)
        const written = memoryRead(e, e.*.pointers)
        if e.*.entries > STORM {
            why.text = "a storm: more entries in a second than the ring holds"
            why.value = e.*.entries
        } else if pointer & (IH_RING_BYTES - 1) != written & (IH_RING_BYTES - 1) {
            why.text = "the card does not write its write pointer back where it was told"
            why.value = written
            why.wanted = pointer
        } else if rd(e, SRBM_STATUS) & SRBM_STATUS__IH_BUSY != 0 {
            why.text = "the interrupt ring stays busy"
            why.value = rd(e, SRBM_STATUS)
        } else if e.*.routed && e.*.entries != 0 && counted() == taken && !waitedBefore && !waiting() {
            why.text = "entries came and their interrupt did not"
            why.value = e.*.entries
        }
    }
    var after: Picture = undefined
    look(e, &after)
    aside(e, false)
    const minded = changed(&before, &after)
    if why.text.length != 0 || minded != Change.none {
        e.*.i1 = Outcome.failed
        // The way back: the ring off as Linux turns it off, then every
        // register the step wrote as it was, last first.
        ringOff(e)
        const back = putBack(e, mark)
        e.*.ringUp = false
        say(e, "gpu: step I1 failed: ")
        if why.text.length != 0 {
            sayWhy(e, &why)
        } else {
            sayChange(e, minded, &before, &after)
        }
        num(e, "; the interrupt ring is off again, its words as the firmware had them (", back)
        say(e, " registers)\n")
        return false
    }
    e.*.i1 = Outcome.passed
    num(e, "gpu: step I1: interrupt ring of ", IH_RING_BYTES / IH_ENTRY_BYTES)
    word(e, " entries at ", e.*.ring)
    word(e, " (bus address), control ", rd(e, IH_RB_CNTL))
    word(e, ", pointers ", e.*.readPointer)
    word(e, " and ", rd(e, IH_RB_WPTR) & (IH_RING_BYTES - 1))
    say(e, " after 1 s, ")
    if e.*.entries != 0 {
        num(e, "entries: ", e.*.entries)
        say(e, " (sources")
        var k: usize = 0
        while k < e.*.sourcesCount {
            num(e, " ", e.*.sources[k])
            k += 1
        }
        say(e, "), ")
    } else {
        say(e, "no entry, ")
    }
    num(e, "interrupts taken: ", counted() - taken)
    say(e, if e.*.routed { "" } else { " (none can come: the card has neither MSI nor MSI-X)" })
    if e.*.routed && !waitedBefore && waiting() { say(e, ", one waits at the processor (interrupts are off while the kernel starts)") }
    if e.*.routed && waitedBefore { say(e, ", one of the card's waited at the processor before the ring came up (a new one cannot be told from it)") }
    word(e, ", idle (status ", rd(e, IH_STATUS))
    say(e, ")")
    sayWatch(e, &before)
    took(e)
    return true
}

// ---- The stages of a boot, and the way down.

// The stages up to `e.stage`, each only after the one before it passed.
pub fn run(e: *Engines) -> void {
    if !found(e) { return }
    if e.*.stage < 1 { return }
    if !divide(e) { return }
    if !gart(e) { return }
    if e.*.stage < 2 { return }
    _ = interrupts(e)
}

// The way down (the study's 8.7, Z): what reads the system's memory
// stopped (the interrupt ring), the GART left on (nothing reads through
// it). Nothing when no stage brought anything up.
pub fn stop(e: *Engines) -> void {
    if !e.*.ringUp { return }
    ringOff(e)
    e.*.ringUp = false
    word(e, "gpu: stopped for the way down: interrupt ring off (", rd(e, IH_RB_CNTL))
    say(e, "); the GART stays on\n")
}
