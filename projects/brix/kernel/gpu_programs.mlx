// The graphics card for programs (spec/04-stdlib/os/brix.xml,
// <GpuDevices>; the Vulkan driver's study, section 3.5, its stage (a)):
// the card gpu.mlx took is the node /devices/gpu0, whose read gives its
// record (gpu_record.mlx: what it is, where it sits on PCI, its memory, the
// ROM's counts of its graphics block, the rings that take a program's
// commands and why there are none); everyone may read it. node_open of
// the node with the write flag gives a handle of the kind gpu, which is
// the process's context on the card: its address space on the card and
// its place in compute ring 0's work. Closing every handle of it (or the
// process ending) ends it, once the ring has passed its work. The calls
// on a context (native/gpucalls.mlx) are served by gpu_work.mlx at a boot
// whose engines came up to stage 7 (the digit 7 held at start; the record
// then lists compute ring 0); at any other boot they are refused with
// unsupported, as before. Opening the node to write is for its user (the
// person at the seat: the login gives them the node, as it gives the
// displays) and root: the node is 0644, root's at boot. The record and
// the contexts' table are worked out in gpu_offer.mlx, which the host's
// tests run.
//
// One line in the log says what programs are offered (the study's 11.1).
// A machine without such a card (QEMU) has no /devices/gpu0.
const gpu = @import("./gpu.mlx")
const offering = @import("./gpu_offer.mlx")
const record = @import("./gpu_record.mlx")
const work = @import("./gpu_work.mlx")
const vfs = @import("./vfs.mlx")
const console = @import("./console.mlx")
const Pci = @import("./pci.mlx").Pci
const Status = @import("./status.mlx").Status

const VENDOR_AMD: usize = 0x1002

// The cards offered (gpu.mlx takes one: /devices/gpu0).
pub const MOST_CARDS: usize = 1

var cardCount: usize = 0 // (per run)
var cards: [MOST_CARDS]record.Facts = undefined // (per run)
// Where each card sits on PCI, looked up once.
var places: [MOST_CARDS]usize = undefined // (per run)

// The contexts on the cards.
pub const MOST_CONTEXTS: usize = offering.MOST_CONTEXTS

var contexts: offering.Contexts = undefined // (per run)

// How many cards are offered.
pub fn count() -> usize { return cardCount }

// Card `index`'s facts.
pub fn facts(index: usize) -> *const record.Facts { return &cards[index] }

// Where the card whose registers are at `registers` (BAR5, physical)
// sits on PCI (bus << 8 | device << 3 | function), or 0xFFFFFFFF.
fn placeOf(registers: usize) -> usize {
    var pass: usize = 0
    while pass < 2 {
        var n: usize = 0
        while n < 64 {
            const address = Pci.findClass(if pass == 0 { 0x030000 } else { 0x038000 }, 0xFFFF00, n)
            n += 1
            if address == Pci.NONE { break }
            if Pci.read(address, 0) & 0xFFFF != VENDOR_AMD { continue }
            if Pci.memBase(address, 5) == registers { return (address >> 8) & 0xFFFF }
        }
        pass += 1
    }
    return 0xFFFFFFFF
}

// The facts of card `index` (the one gpu.mlx took) as they are now: what
// it and the engines' first look read, and the display's picture where a
// mode change has put it.
fn gather(index: usize) -> void {
    const g = gpu.device()
    const card = offering.Card.{ .present = g.*.present, .vendor = VENDOR_AMD, .device = g.*.device, .revision = g.*.revision, .pci = places[index], .visible = g.*.vramSize, .picture = g.*.consoleBytes, .name = g.name() }
    offering.gather(&card, gpu.enginesRead(), &cards[index])
    offering.served(gpu.programsWork(), &cards[index])
}

fn say(text: []const u8) -> void { console.out.write(text) }

fn sayPci(place: usize) -> void {
    console.out.hexByte((place >> 8) & 0xFF)
    say(":")
    console.out.hexByte((place >> 3) & 0x1F)
    say(".")
    console.out.decimal(place & 0x7)
}

// The card offered to programs, after gpu.mlx's probe: its node made and
// its line said. Nothing when gpu.mlx took no card.
pub fn offer() -> void {
    cardCount = 0
    contexts.reset()
    if gpu.device().*.registers == 0 { return }
    places[0] = placeOf(gpu.device().*.registersPhysical)
    gather(0)
    cardCount = 1
    vfs.fileSystem().addGpu("gpu0", 0, record.RECORD)
    const c = &cards[0]
    say("gpu: /devices/gpu0 for programs: ")
    say(c.*.name)
    if c.*.pci != 0xFFFFFFFF {
        say(" at ")
        sayPci(@intCast(usize, c.*.pci))
    }
    // (One line, short: the kernel's log breaks a line after about 160
    // characters.)
    if c.*.memory != 0 {
        say(", ")
        console.out.decimal(c.*.memory / (1024 * 1024))
        say(" MiB")
    }
    if c.*.flags & record.Flag.ROM_COUNTS != 0 {
        say(", ")
        console.out.decimal(@intCast(usize, c.*.shaderEngines * c.*.arraysPerEngine * c.*.computeUnitsPerArray))
        say(" compute units")
    }
    if c.*.why == record.Why.CARD_NOT_STARTED {
        say("; not started by the firmware: no engine runs\n")
    } else if c.*.why == record.Why.OTHER_CARD {
        say("; not a Polaris 10: no engine runs\n")
    } else if c.*.computeRings != 0 {
        say("; compute ring 0 takes their commands\n")
    } else {
        say("; no engine takes commands at this boot\n")
    }
}

// A read of card `index`'s node from `offset`: the bytes put into `into`,
// of the record as things are at that moment.
pub fn read(index: usize, offset: usize, into: [*]u8, capacity: usize) -> usize {
    if index >= cardCount { return 0 }
    gather(index)
    return record.readAt(&cards[index], offset, into, capacity)
}

// A new context on card `index` for process `process`: its number, or a
// Status (too_many: every context is taken, the process has its most, or
// every address space is held). Its one holder is the descriptor made for
// it.
pub fn begin(index: usize, process: usize) -> isize {
    // (Numbers kept for contexts whose work has ended since are free.)
    contexts.reclaim(gpu.programsWork())
    const which = contexts.begin(index)
    if which == MOST_CONTEXTS { return Status.too_many }
    const opened = work.open(gpu.programsWork(), which, process)
    if opened < 0 {
        contexts.release(which)
        return opened
    }
    return @intCast(isize, which)
}

// The card of context `which`.
pub fn cardOf(which: usize) -> usize { return contexts.cardOf(which) }

// One more descriptor holds context `which` (a duplicate, a handle sent,
// a branch).
pub fn retain(which: usize) -> void { contexts.retain(which) }

// A descriptor of context `which` closed: the last one ends it (its card
// state once the ring has passed its work: gpu_work.mlx), its number kept
// until then.
pub fn release(which: usize) -> void {
    if which >= MOST_CONTEXTS || !contexts.used[which] { return }
    contexts.release(which)
    if !contexts.used[which] {
        work.end(gpu.programsWork(), which)
        if work.inUse(gpu.programsWork(), which) { contexts.keep(which) }
    }
}

// The programs' work on the card (native/gpucalls.mlx).
pub fn programs() -> *work.Work { return gpu.programsWork() }

// A memory object's or a fence's handle more or less (files.mlx).
pub fn retainMemory(which: usize) -> void { work.retainMemory(gpu.programsWork(), which) }

pub fn releaseMemory(which: usize) -> void { work.releaseMemory(gpu.programsWork(), which) }

pub fn retainFence(which: usize) -> void { work.retainFence(gpu.programsWork(), which) }

pub fn releaseFence(which: usize) -> void { work.releaseFence(gpu.programsWork(), which) }

// A fence's state for the one wait (native/objects.mlx).
pub fn fenceState(which: usize) -> u32 { return work.fenceState(gpu.programsWork(), which) }

// How many contexts there are (the tests' and the log's).
pub fn living() -> usize { return contexts.living() }
