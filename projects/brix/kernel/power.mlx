// The system's end, asked for by the first process (system_power, call
// 50): every volume committed, then the machine halted (0), powered off
// (1: ACPI's sleep register as QEMU's and the PIIX4/ICH9 chipsets have it)
// or restarted (2: the keyboard controller's reset line, else the reset
// control register). Only the first process may ask (the init).
const cpu = @import("./cpu.mlx")
const smp = @import("./smp.mlx")
const console = @import("./console.mlx")
const volume = @import("./volume.mlx")
const scheduler = @import("./scheduler.mlx")
const Process = @import("./process.mlx").Process
const Status = @import("./status.mlx").Status

pub const HALT: usize = 0
pub const POWEROFF: usize = 1
pub const REBOOT: usize = 2

// PM1a_CNT of the PIIX4 (QEMU's pc) and the ICH9 (q35): PM base 0x600.
const PM1A_CONTROL: usize = 0x604
// SLP_EN with SLP_TYP 0 (S5 in QEMU's tables).
const SLEEP: usize = 0x2000
// The old Bochs/QEMU port as well.
const BOCHS_PM1A_CONTROL: usize = 0xB004
const KEYBOARD_COMMAND: usize = 0x64
const KEYBOARD_RESET: usize = 0xFE
const RESET_CONTROL: usize = 0xCF9
const FULL_RESET: usize = 0x06

// (The timer's work goes on at each interrupt, from inside the kernel:
// what a round of it makes in the arena is let go, as the idle loop does.)
fn stop() -> void {
    const mark = smp.arenaMark()
    while true {
        smp.arenaRelease(mark)
        cpu.Cpu.wait()
    }
}

pub fn act(p: *Process, kind: usize) -> isize {
    if p.*.pid != scheduler.Scheduler.FIRST_PID { return Status.no_right }
    if kind > REBOOT { return Status.invalid }
    _ = volume.commitAll()
    if kind == POWEROFF {
        console.out.write("brixOS: powering off\n")
        cpu.Port.out16(PM1A_CONTROL, SLEEP)
        cpu.Port.out16(BOCHS_PM1A_CONTROL, SLEEP)
    } else if kind == REBOOT {
        console.out.write("brixOS: restarting\n")
        cpu.Port.out8(KEYBOARD_COMMAND, KEYBOARD_RESET)
        cpu.Port.out8(RESET_CONTROL, FULL_RESET)
    } else {
        console.out.write("brixOS: halted\n")
    }
    stop()
    return 0
}
