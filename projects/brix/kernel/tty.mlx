// The serial line as a terminal: the termios a program sets (TCSETS) and
// what it means here. Output: OPOST with ONLCR turns "\n" into "\r\n".
// Input: canonical mode (ICANON) edits a line (ECHO, erase, kill) and
// gives it at its end; raw mode gives the bytes as they come. ICRNL turns
// the carriage return a terminal sends for Enter into "\n".
const serial = @import("./serial.mlx")

pub const TERMIOS_SIZE: usize = 36
const ICRNL: u32 = 0x100
const OPOST: u32 = 0x1
const ONLCR: u32 = 0x4
const ICANON: u32 = 0x2
const ECHO: u32 = 0x8
const VERASE: usize = 2
const VKILL: usize = 3
const VEOF: usize = 4

var termios: [TERMIOS_SIZE]u8 = undefined
var line: [1024]u8 = undefined
var lineLength: usize = 0
var lineReady: usize = 0
var lineGiven: usize = 0

fn word(at: usize) -> u32 {
    return @intCast(u32, termios[at]) | (@intCast(u32, termios[at + 1]) << 8) | (@intCast(u32, termios[at + 2]) << 16) | (@intCast(u32, termios[at + 3]) << 24)
}

fn setWord(at: usize, value: u32) -> void {
    termios[at] = @intCast(u8, value & 255)
    termios[at + 1] = @intCast(u8, (value >> 8) & 255)
    termios[at + 2] = @intCast(u8, (value >> 16) & 255)
    termios[at + 3] = @intCast(u8, (value >> 24) & 255)
}

// A cooked terminal: ICRNL IXON, OPOST ONLCR, B38400 CS8 CREAD, ISIG
// ICANON ECHO ECHOE ECHOK ECHOCTL ECHOKE IEXTEN, the usual characters.
pub fn init() -> void {
    var k: usize = 0
    while k < TERMIOS_SIZE {
        termios[k] = 0
        k += 1
    }
    setWord(0, 0x500)
    setWord(4, 0x5)
    setWord(8, 0xBF)
    setWord(12, 0x8A3B)
    const cc = 17
    termios[cc + 0] = 3
    termios[cc + 1] = 28
    termios[cc + VERASE] = 127
    termios[cc + VKILL] = 21
    termios[cc + VEOF] = 4
    termios[cc + 6] = 1
    lineLength = 0
    lineReady = 0
    lineGiven = 0
}

pub fn getAttributes(into: [*]u8) -> void {
    var k: usize = 0
    while k < TERMIOS_SIZE {
        into[k] = termios[k]
        k += 1
    }
}

pub fn setAttributes(from: [*]const u8) -> void {
    var k: usize = 0
    while k < TERMIOS_SIZE {
        termios[k] = from[k]
        k += 1
    }
}

pub fn write(bytes: [*]const u8, length: usize) -> void {
    const translate = word(4) & (OPOST | ONLCR) == (OPOST | ONLCR)
    var k: usize = 0
    while k < length {
        if bytes[k] == 10 && translate { serial.put(13) }
        serial.put(bytes[k])
        k += 1
    }
}

fn input() -> u8 {
    var byte = serial.get()
    if byte == 13 && word(0) & ICRNL != 0 { byte = 10 }
    return byte
}

// Bytes for a read of at most `capacity` (at least one: it waits).
pub fn read(into: [*]u8, capacity: usize) -> usize {
    if capacity == 0 { return 0 }
    if word(12) & ICANON == 0 {
        var count: usize = 0
        into[0] = input()
        count = 1
        while count < capacity && serial.ready() {
            into[count] = input()
            count += 1
        }
        return count
    }
    // Canonical: a line, edited.
    if lineGiven >= lineReady {
        lineLength = 0
        lineReady = 0
        lineGiven = 0
        const echo = word(12) & ECHO != 0
        while true {
            const byte = input()
            if byte == termios[17 + VERASE] || byte == 8 {
                if lineLength > 0 {
                    lineLength -= 1
                    if echo {
                        serial.put(8)
                        serial.put(32)
                        serial.put(8)
                    }
                }
                continue
            }
            if byte == termios[17 + VKILL] {
                while lineLength > 0 {
                    lineLength -= 1
                    if echo {
                        serial.put(8)
                        serial.put(32)
                        serial.put(8)
                    }
                }
                continue
            }
            if byte == termios[17 + VEOF] {
                if lineLength == 0 { return 0 }
                break
            }
            if lineLength < 1023 {
                line[lineLength] = byte
                lineLength += 1
                if echo {
                    if byte == 10 { serial.put(13) }
                    serial.put(byte)
                }
            }
            if byte == 10 { break }
        }
        lineReady = lineLength
    }
    var count: usize = 0
    while count < capacity && lineGiven < lineReady {
        into[count] = line[lineGiven]
        lineGiven += 1
        count += 1
    }
    return count
}

// Whether a read would give bytes now.
pub fn pending() -> bool { return lineGiven < lineReady || serial.ready() }
