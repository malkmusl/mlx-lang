// Memory objects (spec/04-stdlib/os/brix.xml, memory_object and
// memory_map_object): pages of their own, zeroed when made, that every
// process mapping the object shares (a fork keeps them shared, they are
// never copied on write). The object holds each frame once, each mapping
// once more; the frames go when the last handle and the last mapping
// let them go.
const memory = @import("./memory.mlx")

const Page = memory.Page

pub const MemoryObject = struct {
    // The most pages an object has (1 MiB).
    pub const PAGES: usize = 256

    // Handles naming it (0: the slot is free).
    opens: usize
    pages: usize
    frames: [PAGES]usize

    pub fn size(self: *const Self) -> usize { return self.*.pages * Page.SIZE }
}

pub const MemoryObjects = struct {
    pub const MAX: usize = 16

    objects: [MAX]MemoryObject

    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.objects[k].opens = 0
            k += 1
        }
    }

    // A new object of `pages` pages (held once); MAX when no slot is
    // free or memory is out.
    pub fn create(self: *Self, pages: usize) -> usize {
        var k: usize = 0
        while k < MAX {
            const m = &self.*.objects[k]
            if m.*.opens == 0 {
                var made: usize = 0
                while made < pages {
                    const frame = memory.allFrames().allocate()
                    if frame == 0 {
                        while made > 0 {
                            made -= 1
                            memory.allFrames().free(m.*.frames[made])
                        }
                        return MAX
                    }
                    m.*.frames[made] = frame
                    made += 1
                }
                m.*.opens = 1
                m.*.pages = pages
                return k
            }
            k += 1
        }
        return MAX
    }

    pub fn at(self: *Self, index: usize) -> *MemoryObject { return &self.*.objects[index] }

    pub fn retain(self: *Self, index: usize) -> void { self.*.objects[index].opens += 1 }

    // One handle less; the object's own hold on its frames goes with the
    // last (mappings keep theirs).
    pub fn release(self: *Self, index: usize) -> void {
        const m = &self.*.objects[index]
        m.*.opens -= 1
        if m.*.opens > 0 { return }
        var k: usize = 0
        while k < m.*.pages {
            memory.allFrames().free(m.*.frames[k])
            k += 1
        }
    }
}

var all: MemoryObjects = undefined // (per run)

pub fn table() -> *MemoryObjects { return &all }
