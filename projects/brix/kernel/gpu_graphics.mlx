// Stage 6 toward a Radeon that takes commands (a Polaris 10, the RX 580),
// on top of stage 5 (gpu_compute.mlx): the graphics ring. The study's step
// G5 (/tmp/brix-next/gpu-accel-kernel.verified.md 5.3, 5.6, 5.7, 5.8, 5.10,
// 5.11, 8.4 G5, as its second reading corrected them), built from Linux
// 6.6's gfx_v8_0.c, with its self-test, its one line in the log and its
// way back. The ring is driven through gpu_ring.mlx.
//
// THE STEP (../engine_choice.mlx: the digit 6):
// 6  G5  the two words of gfx_v8_0_constants_init that stage 5 leaves out
//        because the picture's way goes through them: the host path's
//        HDP_ADDR_CONFIG and the display's DMIF_ADDR_CALC, in Linux's
//        order, each written only when it does not hold the address
//        configuration already (S0's word), with the picture watched
//        around those two writes alone first; then the graphics ring as
//        gfx_v8_0_cp_gfx_resume starts it (its registers, its doorbell,
//        the processor's three words, PFP, ME and CE unhalted, the first
//        submission: the clear state of clearstate_vi.h, the raster
//        configuration, CLEAR_STATE, the constant engine's partition:
//        stage 5's own code, which its second trial runs too, and not run
//        twice when that trial ran); Linux's ring test; the read pointer
//        the ring writes back come to its write pointer; the ring's
//        end-of-pipe interrupt on (CP_INT_CNTL_RING0's
//        TIME_STAMP_INT_ENABLE, gfx_v8_0_set_gfx_eop_interrupt_state);
//        Linux's indirect buffer test on the ring framed as Linux frames
//        it there (38 words: the surface sync, the conditional execution,
//        the host path's flush by the pre-fetch parser, the buffer, the
//        invalidate, the end of pipe twice, the first one below the fence
//        and without an interrupt). Proved by the two words and the ring's
//        registers reading back, the scratch register, the buffer's word,
//        the fence, the interrupt ring's entry of source 181 with ring id
//        0, and the interrupt.
// A step that fails halts the graphics processors and puts its own
// registers back, last first; the steps before it stay up.
//
// THE DISPLAY'S TWO WORDS are the only display-side words any step of the
// engines writes: how many were written is counted and said in the line.
//
// THE WAY DOWN (`stop`, before stage 5's): the graphics ring's pointers
// said, its end-of-pipe interrupt and its doorbell off; stage 5's way down
// then halts its processors with the others'.
//
// The numbers are Linux 6.6's (gfx_8_0_d.h, gfx_8_0_sh_mask.h, oss_3_0_d.h,
// dce_11_2_d.h, gfx_v8_0.c): tools/check_gpu_registers.py holds every one
// of them against those files. tests/506 lends a card that is a table.
const engines = @import("./gpu_engines.mlx")
const loaded = @import("./gpu_smc_sdma.mlx")
const compute = @import("./gpu_compute.mlx")
const ring = @import("./gpu_ring.mlx")
const clear = @import("./gpu_clear_state.mlx")

// ---- The registers beside stage 5's (gfx_8_0_d.h).
// The ring's doorbell's enable (gfx_v8_0_set_cpg_door_bell's field).
pub const CP_RB_DOORBELL_CONTROL__DOORBELL_EN: usize = 0x40000000

// ---- Linux's numbers that are no register.
// The graphics ring's end-of-pipe entry (gfx_v8_0_eop_irq's reading: micro
// engine 0).
pub const GRAPHICS_ID: usize = 0x00
// The words of the first submission that are not the clear state's runs
// (gfx_v8_0_get_csb_size: begin 2, context control 3, the raster
// configuration 4, end 2, CLEAR_STATE 2; cp_gfx_start: SET_BASE 4 more).
pub const CSB_FRAME_WORDS: usize = 13
pub const SET_BASE_WORDS: usize = 4

// ---- This driver's own numbers.
// Where the indirect buffer test's buffer lies in stage 5's buffers' page,
// and its word in the write-back page (stage 5's records and its own word
// below these; 32 bytes apart, as Linux's write-back slots are).
pub const BUFFER_AT: usize = 256
pub const TEST_AT: usize = 288
// (No such thing.)
pub const NONE: usize = 0xFFFFFFFFFFFFFFFF

// What stage 6 did and keeps.
pub const Graphics = struct {
    g5: engines.Outcome
    // The two display-side words as found, and how many were written
    // (each only when it did not hold the address configuration).
    hdpWas: usize
    dmifWas: usize
    displayWrites: usize
    // The step started the ring (false: stage 5's second trial had), the
    // scratch test's microseconds, the wait's end, the fence, the entries
    // and interrupts it brought.
    started: bool
    scratch: usize
    how: ring.Waited
    fence: usize
    entries: usize
    interrupts: usize
    // The temperature before the step.
    before: usize
}

// ---- Reaching the card.

fn rd(e: *engines.Engines, number: usize) -> usize {
    const read = e.*.hands.read
    return @intCast(usize, read(number))
}

fn wr(e: *engines.Engines, number: usize, value: usize) -> void {
    const write = e.*.hands.write
    write(number, @intCast(u32, value & 0xFFFFFFFF))
}

fn say(e: *engines.Engines, text: []const u8) -> void {
    const write = e.*.hands.say
    write(text)
}

fn now(e: *engines.Engines) -> usize {
    const clock = e.*.hands.now
    return clock()
}

fn pause(e: *engines.Engines, microseconds: usize) -> void {
    const wait = e.*.hands.pause
    wait(microseconds)
}

fn aside(e: *engines.Engines, on: bool) -> void {
    const put = e.*.hands.aside
    put(on)
}

fn memoryRead(e: *engines.Engines, physical: usize) -> usize {
    const read = e.*.hands.memoryRead
    return @intCast(usize, read(physical))
}

fn memoryWrite(l: *loaded.Loaded, physical: usize, value: usize) -> void {
    const write = l.*.more.memoryWrite
    write(physical, @intCast(u32, value & 0xFFFFFFFF))
}

// A field's value placed by its mask.
fn field(mask: usize, value: usize) -> usize {
    var shift: usize = 0
    while shift < 32 && (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (value << @intCast(u6, shift)) & mask
}

// log2 of a power of two (order_base_2).
fn order(value: usize) -> usize {
    var bits: usize = 0
    while (@intCast(usize, 1) << @intCast(u6, bits)) < value { bits += 1 }
    return bits
}

// ---- The log's words.

fn decimal(e: *engines.Engines, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(e, digits[at..20])
}

fn hex(e: *engines.Engines, value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(e, text[0..2 + digits])
}

fn num(e: *engines.Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    decimal(e, value)
}

fn word(e: *engines.Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    hex(e, value)
}

// The card's temperature, the SMC's index put back as it was.
fn temperature(e: *engines.Engines) -> usize {
    const index = rd(e, engines.SMC_IND_INDEX_11)
    const degrees = loaded.temperature(e)
    wr(e, engines.SMC_IND_INDEX_11, index)
    return degrees
}

// "; 41 C before, 41 C after" in the step's line.
fn degrees(e: *engines.Engines, g: *Graphics, after: usize) -> void {
    num(e, "; ", g.*.before)
    num(e, " C before, ", after)
    say(e, " C after")
}

// " (12 ms)" after the step's line.
fn took(e: *engines.Engines) -> void {
    num(e, " (", (now(e) - e.*.began) / 1000000)
    say(e, " ms)\n")
}

// Whether a fault was kept in address space 0 since the GART came on.
fn faulted(e: *engines.Engines) -> bool { return rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS) != 0 || rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR) != 0 }

// The halt bits of the graphics processors (gfx_v8_0_cp_gfx_enable(false)),
// 50 us after.
fn halt(e: *engines.Engines) -> void {
    wr(e, engines.CP_ME_CNTL, rd(e, engines.CP_ME_CNTL) | engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT)
    pause(e, 50)
}

// ---- The start.

// The record anew (nothing tried yet).
pub fn begin(g: *Graphics) -> void {
    g.*.g5 = engines.Outcome.not_tried
    g.*.hdpWas = NONE
    g.*.dmifWas = NONE
    g.*.displayWrites = 0
    g.*.started = false
    g.*.scratch = 0
    g.*.how = ring.Waited.late
    g.*.fence = 0
    g.*.entries = 0
    g.*.interrupts = 0
    g.*.before = 0
}

// The words of the first submission (gfx_v8_0_get_csb_size and the
// partition after it): the clear state's runs with their two words each,
// and the rest.
pub fn firstWords() -> usize {
    var count = CSB_FRAME_WORDS
    var run: usize = 0
    while run < clear.RUN_COUNT.length {
        count += 2 + clear.RUN_COUNT[run]
        run += 1
    }
    return count + SET_BASE_WORDS
}

// The ring's registers as gfx_v8_0_cp_gfx_resume leaves them (the pointers
// and the doorbell's word, which the card moves, left out); the first that
// does not hold (NONE: none).
fn ringHolds(e: *engines.Engines, r: *const ring.Ring) -> usize {
    const size = order(compute.RING_BYTES / 8)
    const control = field(compute.CP_RB0_CNTL__RB_BUFSZ, size) | field(compute.CP_RB0_CNTL__RB_BLKSZ, size - 2) | field(compute.CP_RB0_CNTL__MTYPE, 3) | field(compute.CP_RB0_CNTL__MIN_IB_AVAILSZ, 1)
    const rptr = r.*.recordAddress + ring.RPTR_SLOT
    const wptr = r.*.recordAddress + ring.WPTR_SLOT
    const base = r.*.address >> 8
    const numbers = [_]usize{ compute.CP_RB_WPTR_DELAY, compute.CP_RB_VMID, compute.CP_RB0_CNTL, compute.CP_RB0_RPTR_ADDR, compute.CP_RB0_RPTR_ADDR_HI, compute.CP_RB_WPTR_POLL_ADDR_LO, compute.CP_RB_WPTR_POLL_ADDR_HI, compute.CP_RB0_BASE, compute.CP_RB0_BASE_HI, compute.CP_RB_DOORBELL_RANGE_LOWER, compute.CP_RB_DOORBELL_RANGE_UPPER, compute.CP_MAX_CONTEXT, compute.CP_ENDIAN_SWAP, compute.CP_DEVICE_ID }
    const values = [_]usize{ 0, 0, control, rptr & 0xFFFFFFFF, (rptr >> 32) & 0xFF, wptr & 0xFFFFFFFF, wptr >> 32, base & 0xFFFFFFFF, base >> 32, field(compute.CP_RB_DOORBELL_RANGE_LOWER__DOORBELL_RANGE_LOWER, compute.AMDGPU_DOORBELL_GFX_RING0), compute.CP_RB_DOORBELL_RANGE_UPPER__DOORBELL_RANGE_UPPER, compute.MAX_CONTEXT, 0, compute.DEVICE_ID }
    var k: usize = 0
    while k < numbers.length {
        if rd(e, numbers[k]) != values[k] { return numbers[k] }
        k += 1
    }
    const doorbell = rd(e, compute.CP_RB_DOORBELL_CONTROL)
    if doorbell & CP_RB_DOORBELL_CONTROL__DOORBELL_EN == 0 || (doorbell & compute.CP_RB_DOORBELL_CONTROL__DOORBELL_OFFSET) >> 2 != compute.AMDGPU_DOORBELL_GFX_RING0 { return compute.CP_RB_DOORBELL_CONTROL }
    if rd(e, engines.CP_ME_CNTL) & (engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT) != 0 { return engines.CP_ME_CNTL }
    return NONE
}

// "HDP_ADDR_CONFIG 0x22011003 as found" or "... 0x0 -> 0x22011003".
fn sayWord(e: *engines.Engines, name: []const u8, was: usize, now: usize) -> void {
    say(e, name)
    hex(e, was)
    if was == now {
        say(e, " as found")
    } else {
        word(e, " -> ", now)
    }
}

// ---- G5.

// G5. Whether it passed.
pub fn graphicsRing(e: *engines.Engines, l: *loaded.Loaded, c: *compute.Compute, g: *Graphics) -> bool {
    e.*.began = now(e)
    if c.*.g4 != engines.Outcome.passed || !c.*.compute.up {
        g.*.g5 = engines.Outcome.refused
        say(e, "gpu: step G5 refused: the compute ring's end of pipe and its interrupt are not proved (step G4)\n")
        return false
    }
    if c.*.graphics.up && (c.*.graphics.refused || c.*.graphics.hung) {
        g.*.g5 = engines.Outcome.refused
        say(e, "gpu: step G5 refused: the graphics ring takes no new work now (the temperature's mark, or it did not come to a fence)\n")
        return false
    }
    g.*.before = temperature(e)
    if g.*.before >= loaded.MARK {
        g.*.g5 = engines.Outcome.refused
        num(e, "gpu: step G5 refused: the card is at ", g.*.before)
        num(e, " C (no step begins at ", loaded.MARK)
        say(e, " C or more)\n")
        return false
    }
    const mark = c.*.count
    c.*.full = false
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)
    const r = &c.*.graphics
    const counted = e.*.hands.interrupts
    const waiting = e.*.hands.waiting
    const taken = counted()
    const waitedBefore = waiting()
    const entriesBefore = r.*.entries
    var why: []const u8 = ""
    var value = NONE
    var sayRing = false
    var minded = engines.Change.none
    var between: engines.Picture = undefined
    var watched = false

    // gfx_v8_0_constants_init's two words: the host path's, then the
    // display's, each only where it differs; the picture watched around
    // these two writes alone.
    const config = e.*.found.addressConfig
    g.*.hdpWas = rd(e, engines.HDP_ADDR_CONFIG)
    g.*.dmifWas = rd(e, engines.DMIF_ADDR_CALC)
    g.*.displayWrites = 0
    if g.*.hdpWas != config || g.*.dmifWas != config {
        if g.*.hdpWas != config {
            compute.put(e, c, engines.HDP_ADDR_CONFIG, config)
            g.*.displayWrites += 1
        }
        if g.*.dmifWas != config {
            compute.put(e, c, engines.DMIF_ADDR_CALC, config)
            g.*.displayWrites += 1
        }
        engines.look(e, &between)
        watched = true
        minded = engines.changed(&before, &between)
        if minded == engines.Change.none && (rd(e, engines.HDP_ADDR_CONFIG) != config || rd(e, engines.DMIF_ADDR_CALC) != config) {
            why = "the display's two words do not hold the address configuration written, "
            value = config
        }
    }

    // gfx_v8_0_cp_gfx_resume, unless stage 5's second trial ran it; the
    // ring test; the read pointer come to the write pointer; the
    // registers.
    if why.length == 0 && minded == engines.Change.none {
        g.*.started = !r.*.up
        if g.*.started { compute.graphicsStart(e, l, c) }
        if !ring.ringTest(e, l, r) {
            why = "the graphics ring did not write the scratch register within 100 ms ("
            sayRing = true
        }
        g.*.scratch = r.*.waited
    }
    if why.length == 0 && minded == engines.Change.none {
        var k: usize = 0
        while ring.readPointer(e, r) != r.*.wptr && k < engines.AMDGPU_MAX_USEC_TIMEOUT {
            pause(e, 1)
            k += 1
        }
        if ring.readPointer(e, r) != r.*.wptr {
            why = "the graphics ring's read pointer is not its write pointer ("
            sayRing = true
        }
    }
    if why.length == 0 && minded == engines.Change.none {
        value = ringHolds(e, r)
        if value != NONE { why = "a register of the graphics ring does not hold what cp_gfx_resume wrote: " }
    }

    // The ring's end-of-pipe interrupt, then Linux's indirect buffer test
    // (gfx_v8_0_ring_test_ib on the graphics ring): a write-back word
    // 0xcafedead, five words that write 0xdeadbeef to it, the frame, the
    // fence, the wait (AMDGPU_IB_TEST_TIMEOUT).
    var bad = NONE
    var waited = false
    g.*.fence = NONE
    if why.length == 0 && minded == engines.Change.none {
        compute.put(e, c, loaded.CP_INT_CNTL_RING0, rd(e, loaded.CP_INT_CNTL_RING0) | compute.CP_INT_CNTL_RING0__TIME_STAMP_INT_ENABLE)
        const check = c.*.writeBack + TEST_AT
        memoryWrite(l, check, loaded.TEST_BEFORE)
        const address = ring.gartAddress(e, check)
        const buffer = c.*.buffers + BUFFER_AT
        const words = [_]usize{ ring.packet3(ring.PACKET3_WRITE_DATA, 3), (compute.DST_MEMORY << @intCast(u6, ring.WRITE_DATA_DST_SEL_SHIFT)) | ring.WR_CONFIRM, address & 0xFFFFFFFF, address >> 32, loaded.TEST_WRITTEN }
        var k: usize = 0
        while k < words.length {
            memoryWrite(l, buffer + k * 4, words[k])
            k += 1
        }
        g.*.fence = ring.submit(e, l, r, ring.gartAddress(e, buffer), words.length, 0)
        if g.*.fence == ring.NONE {
            why = "the graphics ring took no submission"
        } else {
            g.*.how = ring.wait(e, l, r, g.*.fence, true, loaded.IB_TEST_TIMEOUT_MS)
            if g.*.how == ring.Waited.done && memoryRead(e, check) != loaded.TEST_WRITTEN {
                why = "the indirect buffer's word reads "
                bad = memoryRead(e, check)
            } else if g.*.how != ring.Waited.done {
                why = "the graphics ring's indirect buffer test did not end: "
                waited = true
            }
        }
    }
    g.*.entries = r.*.entries - entriesBefore
    g.*.interrupts = counted() - taken
    const interrupted = counted() != taken || (!waitedBefore && waiting())
    if why.length == 0 && minded == engines.Change.none && e.*.routed && !interrupted && !waitedBefore { why = "the end-of-pipe entry came and its interrupt did not" }
    const fault = why.length == 0 && minded == engines.Change.none && faulted(e)
    if fault { why = "a fault in address space 0 at page " }
    if why.length == 0 && minded == engines.Change.none && c.*.full { why = "more registers were to be kept than there is room for" }
    const after = temperature(e)
    const living = engines.alive(e, "G5")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    aside(e, false)
    if minded == engines.Change.none { minded = engines.changed(&before, &later) }
    if !living { why = "the card no longer answers as it did" }
    if why.length != 0 || minded != engines.Change.none {
        g.*.g5 = engines.Outcome.failed
        say(e, "gpu: step G5 failed: ")
        if !living {
            say(e, why)
        } else if why.length == 0 {
            if watched && engines.changed(&before, &between) != engines.Change.none {
                say(e, "the picture minded the display's two words: ")
                engines.sayChange(e, minded, &before, &between)
            } else {
                engines.sayChange(e, minded, &before, &later)
            }
        } else if fault {
            say(e, why)
            hex(e, rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR))
            word(e, " (status ", rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS))
            say(e, ")")
        } else if bad != NONE {
            say(e, why)
            hex(e, bad)
            word(e, " where ", loaded.TEST_WRITTEN)
            say(e, " was written")
        } else if waited {
            say(e, why)
            ring.sayWaited(e, r, g.*.how)
        } else if sayRing {
            say(e, why)
            ring.sayState(e, r)
            say(e, ")")
        } else if value != NONE {
            say(e, why)
            hex(e, value)
        } else {
            say(e, why)
        }
        // The way back (5.11): the graphics processors halted, every
        // register the step wrote as it was, the display's words among
        // them.
        halt(e)
        r.*.up = false
        const back = compute.putBack(e, c, mark)
        word(e, "; the graphics processors halted (ME ", rd(e, engines.CP_ME_CNTL))
        num(e, "), the step's words as before it (", back)
        say(e, " registers")
        if g.*.displayWrites != 0 { num(e, ", the display's ", g.*.displayWrites) }
        if g.*.displayWrites != 0 { say(e, " among them") }
        say(e, ")")
        degrees(e, g, after)
        took(e)
        return false
    }
    g.*.g5 = engines.Outcome.passed
    say(e, "gpu: step G5: the graphics ring: ")
    if g.*.started {
        num(e, "started, its clear state taken (", firstWords())
        say(e, " words)")
    } else {
        say(e, "started with its clear state by G3's second trial")
    }
    num(e, ", its scratch test after ", g.*.scratch)
    num(e, " us; an indirect buffer of 5 words ran: memory written, fence ", g.*.fence)
    say(e, " (the end of pipe twice, the first below it without an interrupt), end-of-pipe entry (source ")
    decimal(e, ring.VISLANDS30_IV_SRCID_CP_END_OF_PIPE)
    word(e, ", ring ", GRAPHICS_ID)
    num(e, ") after ", r.*.waited)
    say(e, " us")
    if g.*.entries != 1 { num(e, " (entries: ", g.*.entries) }
    if g.*.entries != 1 { say(e, ")") }
    if !e.*.routed {
        say(e, ", no interrupt (the card has neither MSI nor MSI-X)")
    } else {
        num(e, ", interrupts taken: ", g.*.interrupts)
        if !waitedBefore && waiting() { say(e, ", one waits at the processor (interrupts are off while the kernel starts)") }
        if waitedBefore { say(e, ", one of the card's waited at the processor before (a new one cannot be told from it)") }
    }
    sayWord(e, "; HDP_ADDR_CONFIG ", g.*.hdpWas, config)
    sayWord(e, ", DMIF_ADDR_CALC ", g.*.dmifWas, config)
    if g.*.displayWrites == 0 {
        say(e, ": no display-side word written")
    } else {
        num(e, ": ", g.*.displayWrites)
        say(e, if g.*.displayWrites == 1 { " display-side word written, the picture watched around it" } else { " display-side words written, the picture watched around them" })
    }
    degrees(e, g, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// ---- The way down.

// The graphics ring's part of the way down (stage 5's `stop` follows and
// halts its processors with the others'): its pointers said, its
// end-of-pipe interrupt and its doorbell off. Nothing when it is not up.
pub fn stop(e: *engines.Engines, c: *compute.Compute) -> void {
    if !c.*.graphics.up { return }
    say(e, "gpu: the graphics ring on the way down: ")
    ring.sayState(e, &c.*.graphics)
    wr(e, loaded.CP_INT_CNTL_RING0, rd(e, loaded.CP_INT_CNTL_RING0) & ~compute.CP_INT_CNTL_RING0__TIME_STAMP_INT_ENABLE)
    wr(e, compute.CP_RB_DOORBELL_CONTROL, rd(e, compute.CP_RB_DOORBELL_CONTROL) & ~CP_RB_DOORBELL_CONTROL__DOORBELL_EN)
    say(e, "; its end-of-pipe interrupt and its doorbell off\n")
}
