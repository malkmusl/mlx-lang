// The native calls on streams (a pipe: two ends) and channels (messages
// with handles, which move from the sender's table to the receiver's).
const files = @import("../files.mlx")
const channel = @import("../channel.mlx")
const Process = @import("../process.mlx").Process
const Bytes = @import("../bytes.mlx").Bytes
const Status = @import("../status.mlx").Status
const objects = @import("./objects.mlx")

// stream_pair's flags.
pub const Pair = struct {
    // The ends go when the program is replaced.
    pub const CLOSE_ON_REPLACE: usize = 0x1
}

// stream_pair: a pipe; its read end's handle and its write end's at
// `address` (u32 each).
pub fn streamPair(p: *Process, address: usize, flags: usize) -> isize {
    if !p.prepare(address, 8) { return Status.bad_address }
    var fds: [2]isize = [2]isize{ 0, 0 }
    const made = p.*.files.pipe(&fds, 0)
    if made < 0 { return made }
    if flags & Pair.CLOSE_ON_REPLACE != 0 {
        p.*.files.get(fds[0]).?.*.closeOnExec = true
        p.*.files.get(fds[1]).?.*.closeOnExec = true
    }
    Bytes.write32(Bytes.pointer(address), 0, objects.handleOf(p, fds[0]))
    Bytes.write32(Bytes.pointer(address), 4, objects.handleOf(p, fds[1]))
    return 0
}

// channel_pair: a channel; its two ends' handles at `address`.
pub fn channelPair(p: *Process, address: usize) -> isize {
    if !p.prepare(address, 8) { return Status.bad_address }
    const index = channel.table().create()
    if index == channel.Channels.MAX { return Status.too_many }
    var leaf: [channel.Peer.NAME]u8 = undefined
    var leafBytes: [*]u8 = undefined
    unsafe { leafBytes = @ptrCast([*]u8, &leaf) }
    const leafLength = p.programLeaf(leafBytes, channel.Peer.NAME)
    channel.table().held(index * 2, p.*.pid, p.*.user, p.*.group_id, leafBytes[0..leafLength])
    channel.table().held(index * 2 + 1, p.*.pid, p.*.user, p.*.group_id, leafBytes[0..leafLength])
    const first = p.*.files.openObject(files.Kind.channel, index * 2, files.Open.READ_WRITE)
    if first < 0 {
        channel.table().release(index * 2)
        channel.table().release(index * 2 + 1)
        return first
    }
    const second = p.*.files.openObject(files.Kind.channel, index * 2 + 1, files.Open.READ_WRITE)
    if second < 0 {
        _ = p.*.files.close(first)
        channel.table().release(index * 2 + 1)
        return second
    }
    Bytes.write32(Bytes.pointer(address), 0, objects.handleOf(p, first))
    Bytes.write32(Bytes.pointer(address), 4, objects.handleOf(p, second))
    return 0
}

// The channel end a handle names (or -1).
fn endOf(p: *Process, handle: usize) -> isize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return -1 }
    const slot = p.*.files.get(fd).?
    if slot.*.kind != files.Kind.channel { return -1 }
    return @intCast(isize, slot.*.index)
}

// channel_peer: who holds the other end of `handle` (the process that
// made or opened it: pid, user, group, name length (u32 each), then its
// program's leaf name, up to Peer.NAME bytes).
pub fn peer(p: *Process, handle: usize, address: usize) -> isize {
    const found = endOf(p, handle)
    if found < 0 { return Status.invalid_handle }
    const end = @bitCast(usize, found)
    const c = channel.table().at(end)
    const far = &c.*.peers[1 - end % 2]
    if !p.prepare(address, 16 + channel.Peer.NAME) { return Status.bad_address }
    const into = Bytes.pointer(address)
    Bytes.write32(into, 0, far.*.pid)
    Bytes.write32(into, 4, far.*.user)
    Bytes.write32(into, 8, far.*.group)
    Bytes.write32(into, 12, far.*.nameLength)
    const nameInto = Bytes.pointer(address + 16)
    var k: usize = 0
    while k < far.*.nameLength && k < channel.Peer.NAME {
        nameInto[k] = far.*.name[k]
        k += 1
    }
    return 0
}

// channel_send: `length` bytes and `count` handles (at `list`, which leave
// the sender's table) to the other end.
pub fn send(p: *Process, handle: usize, bytes: usize, length: usize, list: usize, count: usize) -> isize {
    const found = endOf(p, handle)
    if found < 0 { return Status.invalid_handle }
    const end = @bitCast(usize, found)
    const c = channel.table().at(end)
    const side = end % 2
    if !c.peerOpen(side) { return Status.peer_gone }
    if length > channel.Message.BYTES || count > channel.Message.HANDLES { return Status.too_large }
    if !p.prepare(bytes, length) || !p.prepare(list, count * 4) { return Status.bad_address }
    var k: usize = 0
    while k < count {
        const moved = Bytes.read32(Bytes.pointer(list), k * 4)
        if moved == handle || !objects.exists(p, moved) { return Status.invalid_handle }
        k += 1
    }
    if !c.hasRoom(side) { return Status.would_block }
    const m = c.slotFor(side)
    Bytes.copy(&m.*.bytes, Bytes.pointer(bytes), length)
    m.*.length = length
    m.*.count = count
    k = 0
    while k < count {
        const fd = objects.descriptorOf(p, Bytes.read32(Bytes.pointer(list), k * 4))
        _ = p.*.files.takeOut(fd, &m.*.handles[k])
        k += 1
    }
    c.sent(side)
    return 0
}

// channel_receive: the oldest message for this end: its bytes, its
// handles (into the receiver's table; their handles at `list`), and their
// counts at `sizes` (u32 each); would_block when there is none,
// peer_gone when none will come, too_large (sizes written) when it does
// not fit.
pub fn receive(p: *Process, handle: usize, bytes: usize, capacity: usize, list: usize, listCapacity: usize, sizes: usize) -> isize {
    const found = endOf(p, handle)
    if found < 0 { return Status.invalid_handle }
    const end = @bitCast(usize, found)
    const c = channel.table().at(end)
    const side = end % 2
    if !p.prepare(sizes, 8) { return Status.bad_address }
    if !c.hasMessage(side) { return if c.peerOpen(side) { Status.would_block } else { Status.peer_gone } }
    const m = c.first(side)
    Bytes.write32(Bytes.pointer(sizes), 0, m.*.length)
    Bytes.write32(Bytes.pointer(sizes), 4, m.*.count)
    if m.*.length > capacity || m.*.count > listCapacity { return Status.too_large }
    if !p.prepare(bytes, m.*.length) || !p.prepare(list, m.*.count * 4) { return Status.bad_address }
    Bytes.copy(Bytes.pointer(bytes), &m.*.bytes, m.*.length)
    var k: usize = 0
    while k < m.*.count {
        const fd = p.*.files.insert(&m.*.handles[k])
        if fd < 0 {
            files.Descriptors.dropMoved(&m.*.handles[k])
            Bytes.write32(Bytes.pointer(list), k * 4, 0)
        } else {
            Bytes.write32(Bytes.pointer(list), k * 4, objects.handleOf(p, fd))
        }
        k += 1
    }
    c.received(side)
    return 0
}
