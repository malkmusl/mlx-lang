// volume_info (call 56): the volume a path is on, for a program, as words
// at `buffer` (the first `capacity` of them); the count of words there
// are. What a file manager shows under a folder, what `volume` prints,
// and what tells how the store works on a large disk:
//
//    0  its kind: 0 the tree's own (memory), 1 a brixfs volume of a disk
//    1  a block's bytes
//    2  blocks
//    3  free blocks (a count the store keeps: no walk)
//    4  inodes at the most (memory: nodes)
//    5  inode numbers never used yet
//    6  its generation (commits since it was formatted)
//    7  1 when it is read-only
//    8  1 when a commit lets go just what it replaced, 0 when the free
//       blocks are found again by a walk over every root after each
//    9  nanoseconds the mount took
//   10  commits since the mount
//   11  nanoseconds the last commit took
//   12  nanoseconds the longest one took
//   13  walks over every root since the mount (the mount's is one)
//   14  nanoseconds the last walk took
//   15  blocks read from the disk since the mount
//   16  blocks written
//   17  with CHECK: blocks the store held that no root reaches
//   18  with CHECK: blocks a root reaches that the store did not hold
//
// CHECK (flags bit 0, user 0 only: it reads every inode block of the
// volume) commits what changed, finds the free blocks again by a walk
// over every root and compares: word 18 is 0 on a store that works, word
// 17 is room lost until the next walk (after a commit that failed).
const vfs = @import("../vfs.mlx")
const volume = @import("../volume.mlx")
const ext2 = @import("../ext2.mlx")
const memory = @import("../memory.mlx")
const format = @import("../../brixfs.mlx")
const nodes = @import("./nodes.mlx")
const Process = @import("../process.mlx").Process
const Bytes = @import("../bytes.mlx").Bytes
const Status = @import("../status.mlx").Status

pub const WORDS: usize = 19
pub const CHECK: usize = 1

pub fn info(p: *Process, directory: usize, address: usize, length: usize, buffer: usize, capacity: usize, flags: usize) -> isize {
    const base = nodes.directoryOf(p, directory)
    if base < 0 { return base }
    const written = if capacity < WORDS { capacity } else { WORDS }
    if !p.prepare(buffer, written * 8) { return Status.bad_address }
    const frame = nodes.copyPath(p, address, length)
    if frame == 0 { return Status.bad_address }
    const found = vfs.fileSystem().resolve(@bitCast(usize, base), nodes.pathAt(frame))
    memory.allFrames().free(frame)
    if found < 0 { return found }
    var words: [WORDS]usize = undefined
    var k: usize = 0
    while k < WORDS {
        words[k] = 0
        k += 1
    }
    const number = vfs.fileSystem().node(@bitCast(usize, found)).*.volume
    words[1] = memory.Page.SIZE
    if number != 0 && !ext2.isExt2(number) {
        const store = volume.storeOf(number)
        if flags & CHECK != 0 {
            if p.*.user != 0 { return Status.no_right }
            if !store.verify(&words[17], &words[18]) { return Status.no_memory }
        }
        words[0] = 1
        words[2] = store.*.superblock.blocks
        words[3] = store.freeBlocks()
        words[4] = format.Brixfs.MAX_INODES
        words[5] = format.Brixfs.MAX_INODES - store.*.superblock.nextInode
        words[6] = store.*.superblock.generation
        words[7] = if store.*.readOnly { 1 } else { 0 }
        words[8] = if store.*.exact { 1 } else { 0 }
        words[9] = store.*.figures.mountTime
        words[10] = store.*.figures.commits
        words[11] = store.*.figures.commitTime
        words[12] = store.*.figures.longestCommit
        words[13] = store.*.figures.sweeps
        words[14] = store.*.figures.sweepTime
        words[15] = store.*.figures.blocksRead
        words[16] = store.*.figures.blocksWritten
    } else {
        // The tree's own files, in memory (and an ext2 volume's, read
        // into it): its room is memory's.
        const frames = memory.allFrames()
        words[2] = frames.totalBytes() / memory.Page.SIZE
        words[3] = frames.freeBytes() / memory.Page.SIZE
        words[4] = vfs.fileSystem().nodeCount()
    }
    k = 0
    while k < written {
        Bytes.write64(Bytes.pointer(buffer), k * 8, words[k])
        k += 1
    }
    return @intCast(isize, WORDS)
}
