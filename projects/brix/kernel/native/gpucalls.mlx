// The native calls on a graphics card's context (spec/04-stdlib/os/
// brix.xml, <Calls> 80 to 85 and <GpuDevices>; ../gpu_programs.mlx): the
// context is a handle of the kind gpu, which node_open of /devices/gpuN
// with the write flag gives (`open`, from nodes.mlx). A read of it at a
// position gives the card's record, as a read of the node does; a write is
// wrong_kind.
//
// The calls that make the card do something are specified and refused
// for now, whatever their other arguments: the kernel starts none of the
// card's engines yet. Each says invalid_handle for a handle the process
// does not hold, wrong_kind for one that is no context, and unsupported
// for a context:
//   80 gpu_memory(gpu h, size, flags) -> memory h
//   81 gpu_memory_of(gpu h, address, size) -> memory h
//   82 gpu_map(gpu h, memory h, offset, size, card address, flags)
//   83 gpu_unmap(gpu h, card address, size)
//   84 gpu_submit(gpu h, records*, count, fence h or 0) -> sequence
//   85 gpu_fence(gpu h) -> h
const files = @import("../files.mlx")
const cards = @import("../gpu_programs.mlx")
const Process = @import("../process.mlx").Process
const Bytes = @import("../bytes.mlx").Bytes
const Status = @import("../status.mlx").Status
const objects = @import("./objects.mlx")

// The calls, from the first (NATIVE_BASE + FIRST).
pub const FIRST: usize = 80
pub const LAST: usize = 85

// node_open of card `card`'s node with the write flag: a new context and
// a descriptor of it (the caller makes the handle), or too_many. The
// handle reads and writes whatever the open asked: its record is read,
// and the calls on it are what it writes.
pub fn open(p: *Process, card: usize) -> isize {
    if card >= cards.count() { return Status.not_found }
    const which = cards.begin(card)
    if which == cards.MOST_CONTEXTS { return Status.too_many }
    const fd = p.*.files.openObject(files.Kind.gpu, which, files.Open.READ_WRITE)
    if fd < 0 { cards.release(which) }
    return fd
}

// The context `handle` names, or a status: no such handle, or one that is
// no context.
fn contextOf(p: *Process, handle: usize) -> isize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return Status.invalid_handle }
    const slot = p.*.files.get(fd).?
    if slot.*.kind != files.Kind.gpu { return Status.wrong_kind }
    return @intCast(isize, slot.*.index)
}

// A read of a context's descriptor `fd` at `at` (STREAM: from where its
// last streaming read ended): the card's record; a write is wrong_kind.
pub fn transfer(p: *Process, fd: isize, address: usize, length: usize, at: usize, writing: bool) -> isize {
    if writing { return Status.wrong_kind }
    const slot = p.*.files.get(fd).?
    const streaming = at == 0xFFFFFFFFFFFFFFFF
    const from = if streaming { slot.*.offset } else { at }
    const got = cards.read(cards.cardOf(slot.*.index), from, Bytes.pointer(address), length)
    if streaming { slot.*.offset += got }
    return @intCast(isize, got)
}

// Call FIRST + `which` on the context `handle`: refused for now.
pub fn call(p: *Process, which: usize, handle: usize) -> isize {
    if which > LAST - FIRST { return Status.unsupported }
    const context = contextOf(p, handle)
    if context < 0 { return context }
    return Status.unsupported
}
