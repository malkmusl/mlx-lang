// The native calls on processes: spawn (a program in a new process with
// exactly the handles given), branch (a copy-on-write copy of the
// caller), a child's change taken, an event sent. A process handle names
// the process by its pid.
const scheduler = @import("../scheduler.mlx")
const events = @import("../events.mlx")
const files = @import("../files.mlx")
const vfs = @import("../vfs.mlx")
const terminal = @import("../terminal.mlx")
const NodeKind = vfs.NodeKind
const process = @import("../process.mlx")
const Frame = @import("../frame.mlx").Frame
const Sse = @import("../frame.mlx").Sse
const Bytes = @import("../bytes.mlx").Bytes
const Status = @import("../status.mlx").Status
const objects = @import("./objects.mlx")

const Process = process.Process
const State = process.State

// A change record: what (EXITED, ENDED, STOPPED, WENT_ON), the exit
// code or the event's kind, the event's detail, reserved (u32 each).
pub const Changed = struct {
    pub const EXITED: usize = 1
    pub const ENDED: usize = 2
    pub const STOPPED: usize = 3
    pub const WENT_ON: usize = 4
    pub const SIZE: usize = 16
}

// The handles a spawned process may get.
const SPAWN_HANDLES: usize = 16

// The process a handle names (null: none, or not a process handle).
pub fn processOf(p: *Process, handle: usize) -> ?*Process {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return null }
    const slot = p.*.files.get(fd).?
    if slot.*.kind != files.Kind.process { return null }
    return scheduler.processes().find(slot.*.index)
}

// The program node a handle names (a regular file), or a Status.
pub fn programOf(p: *Process, handle: usize) -> isize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return Status.invalid_handle }
    const slot = p.*.files.get(fd).?
    if slot.*.kind != files.Kind.node || !vfs.fileSystem().node(slot.*.index).isRegular() { return Status.wrong_kind }
    if !vfs.fileSystem().permits(slot.*.index, vfs.Vfs.EXECUTE) { return Status.denied }
    return @intCast(isize, slot.*.index)
}

// The directory the program handle `handle` was opened in (NONE when
// not opened by a path): what names the program for /proc/self/exe.
pub fn programDirectoryOf(p: *Process, handle: usize) -> usize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return vfs.Vfs.NONE }
    return p.*.files.get(fd).?.*.directory
}

// A handle to the process `pid` in `p`'s table.
fn handleTo(p: *Process, pid: usize) -> isize {
    const fd = p.*.files.openObject(files.Kind.process, pid, files.Open.READ_WRITE)
    if fd < 0 { return fd }
    return @bitCast(isize, objects.handleOf(p, fd))
}

// The start block at `address`: its arguments and environment.
// The start block at `address` (arguments, environment, the role
// records' address and count: four words): its strings, and its roles
// read into `roles` (role, handle of the caller's, 8 bytes each; `count`
// of them, at most process.MAX_ROLES).
pub fn startOf(p: *Process, address: usize, arguments: *process.Strings, environment: *process.Strings, roles: *[process.MAX_ROLES]process.Role, count: *usize) -> bool {
    if !p.prepare(address, 32) { return false }
    arguments.* = p.strings(Bytes.read64(Bytes.pointer(address), 0))
    environment.* = p.strings(Bytes.read64(Bytes.pointer(address), 8))
    const records = Bytes.read64(Bytes.pointer(address), 16)
    count.* = Bytes.read64(Bytes.pointer(address), 24)
    if count.* > process.MAX_ROLES { return false }
    if count.* > 0 && !p.prepare(records, count.* * 8) { return false }
    var k: usize = 0
    while k < count.* {
        roles.*[k] = process.Role.{ .role = @intCast(u32, Bytes.read32(Bytes.pointer(records), k * 8)), .slot = @intCast(u32, Bytes.read32(Bytes.pointer(records), k * 8 + 4)) }
        k += 1
    }
    return arguments.*.count <= Process.MAX_STRINGS && environment.*.count <= Process.MAX_STRINGS
}

// The roles of a start block (each naming a handle of the caller's) as
// the process `q`'s, where `slotOf` gives the descriptor the handle
// has in `q` (-1: none; the role is left out); none given: the default.
fn applyRoles(q: *Process, roles: *const [process.MAX_ROLES]process.Role, count: usize, slots: *const [process.MAX_ROLES]isize) -> void {
    if count == 0 {
        q.defaultRoles()
        return
    }
    q.*.roleCount = 0
    var k: usize = 0
    while k < count {
        if slots.*[k] >= 0 { q.setRole(roles.*[k].role, @intCast(u32, slots.*[k])) }
        k += 1
    }
    // A directory handle in the directory role is the working directory.
    const directory = q.slotOfRole(process.ROLE_DIRECTORY)
    if directory >= 0 {
        const slot = q.*.files.get(directory)
        if slot != null && slot.?.*.kind == files.Kind.node && vfs.fileSystem().node(slot.?.*.index).isDirectory() { q.setDirectory(slot.?.*.index) }
    }
}

// The roles of a replace's start block as the process's (process_replace).
pub fn applyRolesAfterReplace(p: *Process, roles: *const [process.MAX_ROLES]process.Role, count: usize, slots: *const [process.MAX_ROLES]isize) -> void {
    applyRoles(p, roles, count, slots)
}

// process_start: the caller's roles as (role, handle) records (8 bytes
// each) into `address`, up to `capacity` of them; how many there are.
pub fn start(p: *Process, address: usize, capacity: usize) -> isize {
    var written: usize = 0
    var k: usize = 0
    while k < p.*.roleCount {
        const fd = @intCast(isize, p.*.roles[k].slot)
        const slot = p.*.files.get(fd)
        if slot != null && slot.?.*.kind != files.Kind.none {
            if written < capacity {
                if !p.prepare(address + written * 8, 8) { return Status.bad_address }
                Bytes.write32(Bytes.pointer(address), written * 8, @intCast(usize, p.*.roles[k].role))
                Bytes.write32(Bytes.pointer(address), written * 8 + 4, objects.handleOf(p, fd))
            }
            written += 1
        }
        k += 1
    }
    return @intCast(isize, written)
}

// process_spawn: the program `program` in a new process, a child of `p`,
// in its group and working directory, with exactly `count` handles of
// `p`'s (at `list`): the first is its input, then output, then errors,
// and so on by place. A handle to it, or a Status.
pub fn spawn(p: *Process, program: usize, start: usize, list: usize, count: usize) -> isize {
    const node = programOf(p, program)
    if node < 0 { return node }
    if count > SPAWN_HANDLES { return Status.too_large }
    var arguments: process.Strings = undefined
    var environment: process.Strings = undefined
    var roles: [process.MAX_ROLES]process.Role = undefined
    var roleCount: usize = 0
    if !startOf(p, start, &arguments, &environment, &roles, &roleCount) { return Status.bad_address }
    if !p.prepare(list, count * 4) { return Status.bad_address }
    var k: usize = 0
    while k < count {
        if !objects.exists(p, Bytes.read32(Bytes.pointer(list), k * 4)) { return Status.invalid_handle }
        k += 1
    }
    // A role's handle must be among the handles given: its place there
    // is the child's descriptor for it.
    var roleSlots: [process.MAX_ROLES]isize = undefined
    k = 0
    while k < roleCount {
        roleSlots[k] = -1
        var place: usize = 0
        while place < count {
            if Bytes.read32(Bytes.pointer(list), place * 4) == @intCast(usize, roles[k].slot) { roleSlots[k] = @intCast(isize, place) }
            place += 1
        }
        if roleSlots[k] < 0 { return Status.invalid_handle }
        k += 1
    }
    const table = scheduler.processes()
    const created = table.create(p.*.pid)
    if created == null { return Status.too_many }
    const q = created.?
    q.*.group = p.*.group
    q.*.umask = p.*.umask
    q.*.user = p.*.user
    q.*.group_id = p.*.group_id
    q.setDirectory(p.*.directory)
    q.*.files.closeAll()
    k = 0
    while k < count {
        const fd = objects.descriptorOf(p, Bytes.read32(Bytes.pointer(list), k * 4))
        q.*.files.adoptAt(k, p.*.files.get(fd).?)
        k += 1
    }
    // The strings are read from `p`'s memory while the new space is
    // filled; then `p`'s is the one in use again.
    const loaded = q.load(@bitCast(usize, node), arguments, environment)
    p.*.space.activate()
    if loaded != process.Loaded.done {
        q.*.files.closeAll()
        q.releaseNodes()
        q.*.state = State.free
        return if loaded == process.Loaded.no_memory { Status.no_memory } else { Status.wrong_kind }
    }
    q.setProgram(@bitCast(usize, node), programDirectoryOf(p, program))
    applyRoles(q, &roles, roleCount, &roleSlots)
    q.*.fsBase = 0
    q.*.context.setStart(q.*.entry, q.*.stack)
    Sse.reset(&q.*.sse)
    return handleTo(p, q.*.pid)
}

// identity_set: the caller's user and group, which its children inherit
// (a process of user 0 may take any; another keeps its own: no_right).
pub fn setIdentity(p: *Process, user: usize, group: usize) -> isize {
    const newUser = user & 0xFFFFFFFF
    const newGroup = group & 0xFFFFFFFF
    if p.*.user != 0 && (newUser != p.*.user || newGroup != p.*.group_id) { return Status.no_right }
    p.*.user = newUser
    p.*.group_id = newGroup
    return 0
}

// process_branch: a copy-on-write copy of `p` (its registers in `frame`),
// which gets 0 from the call; `p` gets a handle to it.
pub fn branch(p: *Process, frame: *const Frame) -> isize {
    const pid = scheduler.processes().fork(frame)
    if pid == 0 { return Status.no_memory }
    return handleTo(p, pid)
}

// process_change: what became of the child `handle` names, taken (an
// ended one is gone then); would_block when nothing did.
pub fn change(p: *Process, handle: usize, address: usize) -> isize {
    const found = processOf(p, handle)
    if found == null { return Status.invalid_handle }
    const q = found.?
    if q.*.parentPid != p.*.pid { return Status.denied }
    if !p.prepare(address, Changed.SIZE) { return Status.bad_address }
    const into = Bytes.pointer(address)
    if q.*.state == State.zombie {
        const ending = q.*.ending
        Bytes.write32(into, 0, if ending.exited { Changed.EXITED } else { Changed.ENDED })
        Bytes.write32(into, 4, if ending.exited { ending.code } else { @intCast(usize, ending.kind) })
        Bytes.write32(into, 8, if ending.exited { 0 } else { @intCast(usize, ending.detail) })
        Bytes.write32(into, 12, 0)
        q.*.state = State.free
        return 0
    }
    if q.*.change.what == events.Change.NONE { return Status.would_block }
    const stopped = q.*.change.what == events.Change.STOPPED
    Bytes.write32(into, 0, if stopped { Changed.STOPPED } else { Changed.WENT_ON })
    Bytes.write32(into, 4, @intCast(usize, q.*.change.kind))
    Bytes.write32(into, 8, @intCast(usize, q.*.change.detail))
    Bytes.write32(into, 12, 0)
    q.*.change = events.Change.none()
    return 0
}

// event_send: the event `kind` to the process `handle` names, or to
// every process of the group it names.
pub fn sendEvent(p: *Process, handle: usize, kind: usize) -> isize {
    if kind == 0 || kind >= @intCast(usize, events.Event.COUNT) { return Status.invalid }
    const group = groupOf(p, handle)
    if group >= 0 {
        if !scheduler.processes().groupLives(@bitCast(usize, group)) { return Status.not_found }
        scheduler.processes().sendGroup(@bitCast(usize, group), @intCast(u32, kind), 0)
        return 0
    }
    const found = processOf(p, handle)
    if found == null { return Status.invalid_handle }
    scheduler.processes().send(found.?, @intCast(u32, kind), 0, p.*.pid)
    return 0
}

// The group a group handle names (its number), or -1.
fn groupOf(p: *Process, handle: usize) -> isize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return -1 }
    const slot = p.*.files.get(fd).?
    if slot.*.kind != files.Kind.group { return -1 }
    return @intCast(isize, slot.*.index)
}

// group_join: the process `process` names (0: the caller; else one of
// its children) into the group `group` names (0: a new one, numbered as
// the process); a handle to that group.
pub fn joinGroup(p: *Process, process: usize, group: usize) -> isize {
    var q = p
    if process != 0 {
        const found = processOf(p, process)
        if found == null { return Status.invalid_handle }
        q = found.?
        if q.*.parentPid != p.*.pid { return Status.denied }
        if q.*.state == State.zombie { return Status.not_found }
    }
    var number = q.*.pid
    if group != 0 {
        const named = groupOf(p, group)
        if named < 0 { return Status.invalid_handle }
        if !scheduler.processes().groupLives(@bitCast(usize, named)) { return Status.not_found }
        number = @bitCast(usize, named)
    }
    const fd = p.*.files.openObject(files.Kind.group, number, files.Open.READ_WRITE)
    if fd < 0 { return fd }
    q.*.group = number
    return @bitCast(isize, objects.handleOf(p, fd))
}

// session_front: the group `group` names in front of the session (its
// interrupt, quit and suspend events go to it, it may read the session).
pub fn sessionFront(p: *Process, session: usize, group: usize) -> isize {
    if !objects.exists(p, session) { return Status.invalid_handle }
    if objects.kindOf(p, session) != objects.ObjectKind.SESSION { return Status.wrong_kind }
    const named = groupOf(p, group)
    if named < 0 { return Status.invalid_handle }
    if !scheduler.processes().groupLives(@bitCast(usize, named)) { return Status.not_found }
    terminalOf(p, session).*.foreground = @bitCast(usize, named)
    return 0
}

// The terminal a session or control handle names (the caller checked
// the kind).
pub fn terminalOf(p: *Process, handle: usize) -> *terminal.Terminal {
    const slot = p.*.files.get(objects.descriptorOf(p, handle)).?
    return terminal.at(vfs.fileSystem().node(slot.*.index).*.archiveIndex)
}

// session_pair: a terminal of its own, its control handle and its
// session handle (two nodes without a name) at `address`.
pub fn sessionPair(p: *Process, address: usize) -> isize {
    if !p.prepare(address, 8) { return Status.bad_address }
    const index = terminal.open()
    if index == terminal.NONE { return Status.too_many }
    const tree = vfs.fileSystem()
    const control = tree.create(NodeKind.session_control, 0x1B6)
    const session = tree.create(NodeKind.terminal, 0x1B6)
    if control == vfs.Vfs.NONE || session == vfs.Vfs.NONE {
        terminal.at(index).*.inUse = false
        return Status.no_memory
    }
    tree.node(control).*.archiveIndex = index
    tree.node(session).*.archiveIndex = index
    const controlFd = p.*.files.openNode(control, files.Open.READ_WRITE)
    if controlFd < 0 { return controlFd }
    const sessionFd = p.*.files.openNode(session, files.Open.READ_WRITE)
    if sessionFd < 0 {
        _ = p.*.files.close(controlFd)
        return sessionFd
    }
    Bytes.write32(Bytes.pointer(address), 0, objects.handleOf(p, controlFd))
    Bytes.write32(Bytes.pointer(address), 4, objects.handleOf(p, sessionFd))
    return 0
}

// session_size: the terminal's size in cells (a session or control
// handle), what TIOCGWINSZ answers.
pub fn sessionSize(p: *Process, handle: usize, columns: usize, rows: usize) -> isize {
    if !objects.exists(p, handle) { return Status.invalid_handle }
    const kind = objects.kindOf(p, handle)
    if kind != objects.ObjectKind.SESSION && kind != objects.ObjectKind.STREAM { return Status.wrong_kind }
    const slot = p.*.files.get(objects.descriptorOf(p, handle)).?
    if slot.*.kind != files.Kind.node { return Status.wrong_kind }
    const n = vfs.fileSystem().node(slot.*.index)
    if n.*.kind != NodeKind.terminal && n.*.kind != NodeKind.session_control { return Status.wrong_kind }
    if columns == 0 || rows == 0 || columns > 1000 || rows > 1000 { return Status.invalid }
    terminal.at(n.*.archiveIndex).*.columns = columns
    terminal.at(n.*.archiveIndex).*.rows = rows
    return 0
}
