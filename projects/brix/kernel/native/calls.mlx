// brixOS's own calls (spec/04-stdlib/os/brix.xml, <Calls>): SYSCALL with
// the number at or above NATIVE_BASE; below it, Linux's numbers go to
// the translation layer (linux/system.mlx). The first ones: handles
// (close, duplicate, info), the one wait over handles, reads and writes
// at a position or streaming, the clocks, the end of the process.
const call = @import("../call.mlx")
const wait = @import("../wait.mlx")
const clock = @import("../clock.mlx")
const scheduler = @import("../scheduler.mlx")
const Frame = @import("../frame.mlx").Frame
const Process = @import("../process.mlx").Process
const Bytes = @import("../bytes.mlx").Bytes
const objects = @import("./objects.mlx")
const events = @import("../events.mlx")
const cpu = @import("../cpu.mlx")
const vfs = @import("../vfs.mlx")
const process = @import("../process.mlx")
const processes = @import("./processes.mlx")
const nodes = @import("./nodes.mlx")
const streams = @import("./streams.mlx")
const netcalls = @import("./sockets.mlx")
const timers = @import("./timers.mlx")
const files = @import("../files.mlx")
const Status = @import("../status.mlx").Status

const Outcome = call.Outcome
const OutcomeKind = call.OutcomeKind

pub const NATIVE_BASE: usize = 0x4000

// The calls (NATIVE_BASE + n).
pub const Call = struct {
    pub const HANDLE_CLOSE: usize = 0
    pub const HANDLE_DUPLICATE: usize = 1
    pub const HANDLE_INFO: usize = 2
    pub const WAIT: usize = 3
    pub const READ: usize = 4
    pub const WRITE: usize = 5
    pub const NODE_OPEN: usize = 6
    pub const NODE_INFO: usize = 7
    pub const NODE_MAKE: usize = 8
    pub const NODE_REMOVE: usize = 9
    pub const NODE_RENAME: usize = 10
    pub const NODE_LIST: usize = 11
    pub const STREAM_PAIR: usize = 12
    pub const CHANNEL_PAIR: usize = 13
    pub const CHANNEL_SEND: usize = 14
    pub const CHANNEL_RECEIVE: usize = 15
    pub const MEMORY_MAP: usize = 16
    pub const MEMORY_UNMAP: usize = 17
    pub const MEMORY_OBJECT: usize = 18
    pub const MEMORY_MAP_OBJECT: usize = 19
    pub const PROCESS_SPAWN: usize = 20
    pub const PROCESS_BRANCH: usize = 21
    pub const PROCESS_REPLACE: usize = 22
    pub const PROCESS_EXIT: usize = 23
    pub const PROCESS_CHANGE: usize = 24
    pub const EVENT_SEND: usize = 25
    pub const EVENTS_CLAIM: usize = 26
    pub const EVENTS_TAKE: usize = 27
    pub const UPCALL_SET: usize = 28
    pub const UPCALL_RETURN: usize = 29
    pub const GROUP_JOIN: usize = 30
    pub const SESSION_FRONT: usize = 31
    pub const CLOCK_READ: usize = 32
    pub const TIMER_CREATE: usize = 33
    pub const SNAPSHOT: usize = 34
    pub const HANDLE_OF_DESCRIPTOR: usize = 35
    pub const DIRECTORY_SET: usize = 36
    pub const NODE_PATH: usize = 37
    pub const NODE_MAP: usize = 38
    pub const SOCKET_OPEN: usize = 39
    pub const SOCKET_BIND: usize = 40
    pub const SOCKET_CONNECT: usize = 41
    pub const SOCKET_LISTEN: usize = 42
    pub const SOCKET_ACCEPT: usize = 43
    pub const SOCKET_SEND: usize = 44
    pub const SOCKET_RECEIVE: usize = 45
    pub const SOCKET_INFO: usize = 46
}

// A read or write that streams (no position).
const STREAM: usize = 0xFFFFFFFFFFFFFFFF
// A wait without a deadline.
const FOREVER: usize = 0xFFFFFFFFFFFFFFFF
// A wait item: handle, want, seen, reserved (u32 each).
const ITEM_SIZE: usize = 16
const INFO_SIZE: usize = 16

pub fn isNative(number: usize) -> bool { return number >= NATIVE_BASE }

pub const Native = struct {
    outcome: Outcome
    // The wait this call made before ended by its deadline.
    timedOut: bool

    // The call in `frame` for `p`: its result in rax, unless the process
    // waits or ended (the outcome says).
    pub fn handle(self: *Self, frame: *Frame, p: *Process) -> Outcome {
        self.*.outcome = Outcome.{ .kind = OutcomeKind.done, .waiting = wait.Wait.none(), .status = 0 }
        self.*.timedOut = p.*.timedOut
        p.*.timedOut = false
        vfs.fileSystem().setActor(p.*.user, p.*.group_id)
        const result = self.dispatch(frame, p, frame.*.rax - NATIVE_BASE)
        // A Status goes out as its code, negated.
        if self.*.outcome.kind == OutcomeKind.done { frame.*.rax = @bitCast(usize, if Status.isStatus(result) { -Status.code(result) } else { result }) }
        return self.*.outcome
    }

    fn dispatch(self: *Self, frame: *Frame, p: *Process, number: usize) -> isize {
        const a1 = frame.*.rdi
        const a2 = frame.*.rsi
        const a3 = frame.*.rdx
        const a4 = frame.*.r10
        const a5 = frame.*.r8
        const a6 = frame.*.r9
        if number == Call.HANDLE_CLOSE {
            if !objects.exists(p, a1) { return Status.invalid_handle }
            return (p.*.files.close(objects.descriptorOf(p, a1)))
        }
        if number == Call.HANDLE_DUPLICATE {
            if !objects.exists(p, a1) { return Status.invalid_handle }
            if @intCast(u32, a2 & 0xFFFFFFFF) & ~objects.rightsOf(p, a1) != 0 { return Status.no_right }
            const copy = p.*.files.duplicate(objects.descriptorOf(p, a1), 0, false)
            if copy < 0 { return copy }
            return @bitCast(isize, objects.handleOf(p, copy))
        }
        if number == Call.HANDLE_INFO { return info(p, a1, a2) }
        // The handle of a descriptor the Linux layer opened (while std
        // moves over).
        if number == Call.HANDLE_OF_DESCRIPTOR {
            const fd = @bitCast(isize, a1)
            if p.*.files.get(fd) == null { return Status.invalid_handle }
            return @bitCast(isize, objects.handleOf(p, fd))
        }
        if number == Call.WAIT { return self.waitFor(p, a1, a2, a3) }
        if number == Call.READ || number == Call.WRITE { return self.transfer(p, a1, a2, a3, a4, number == Call.WRITE) }
        if number == Call.PROCESS_EXIT {
            self.*.outcome.kind = OutcomeKind.exited
            self.*.outcome.status = a1
            return 0
        }
        if number == Call.NODE_OPEN { return nodes.open(p, a1, a2, a3, a4, a5) }
        if number == Call.NODE_INFO { return nodes.info(p, a1, a2) }
        // (The kind and the mode in one argument: kind | mode << 8.)
        if number == Call.NODE_MAKE { return nodes.make(p, a1, a2, a3, a4 & 0xFF, a4 >> 8, a5, a6) }
        if number == Call.NODE_REMOVE { return nodes.remove(p, a1, a2, a3) }
        if number == Call.NODE_LIST { return nodes.list(p, a1, a2, a3, a4) }
        if number == Call.NODE_RENAME { return nodes.rename(p, a1, a2, a3, a4, a5, a6) }
        if number == Call.SNAPSHOT { return nodes.snapshot(p, a1, a2, a3, a4, a5) }
        if number == Call.STREAM_PAIR { return streams.streamPair(p, a1, a2) }
        if number == Call.DIRECTORY_SET { return nodes.setDirectory(p, a1) }
        if number == Call.NODE_PATH { return nodes.pathOf(p, a1, a2, a3) }
        if number == Call.NODE_MAP { return nodes.map(p, a1, a2, a3) }
        if number == Call.SOCKET_OPEN { return netcalls.open(p, a1) }
        if number == Call.SOCKET_BIND { return netcalls.bind(p, a1, a2) }
        if number == Call.SOCKET_CONNECT { return netcalls.connect(p, a1, a2) }
        if number == Call.SOCKET_LISTEN { return netcalls.listen(p, a1) }
        if number == Call.SOCKET_ACCEPT { return netcalls.accept(p, a1, a2) }
        if number == Call.SOCKET_SEND { return netcalls.send(p, a1, a2, a3, a4) }
        if number == Call.SOCKET_RECEIVE { return netcalls.receive(p, a1, a2, a3, a4) }
        if number == Call.SOCKET_INFO { return netcalls.info(p, a1, a2) }
        if number == Call.CHANNEL_PAIR { return streams.channelPair(p, a1) }
        if number == Call.CHANNEL_SEND { return streams.send(p, a1, a2, a3, a4, a5) }
        if number == Call.CHANNEL_RECEIVE { return streams.receive(p, a1, a2, a3, a4, a5, a6) }
        if number == Call.MEMORY_MAP { return p.mmap(a1, a2, a3 & 1 != 0) }
        if number == Call.MEMORY_UNMAP { return p.munmap(a1, a2) }
        if number == Call.MEMORY_OBJECT { return timers.memoryObject(p, a1) }
        if number == Call.MEMORY_MAP_OBJECT { return timers.mapObject(p, a1, a2, a3, a4) }
        if number == Call.TIMER_CREATE { return timers.create(p, a1, a2) }
        if number == Call.GROUP_JOIN { return processes.joinGroup(p, a1, a2) }
        if number == Call.SESSION_FRONT { return processes.sessionFront(p, a1, a2) }
        if number == Call.PROCESS_SPAWN { return processes.spawn(p, a1, a2, a3, a4) }
        if number == Call.PROCESS_BRANCH { return processes.branch(p, frame) }
        if number == Call.PROCESS_REPLACE { return self.replace(p, frame, a1, a2) }
        if number == Call.PROCESS_CHANGE { return processes.change(p, a1, a2) }
        if number == Call.EVENT_SEND { return processes.sendEvent(p, a1, a2) }
        if number == Call.EVENTS_CLAIM {
            p.*.events.claim(@intCast(u32, a1 & 0xFFFFFFFF))
            return 0
        }
        if number == Call.EVENTS_TAKE { return takeEvents(p, a1, a2) }
        if number == Call.UPCALL_SET {
            if a1 == 0 || a3 < events.Events.CONTEXT_SIZE + 4096 { return Status.invalid }
            p.*.events.setUpcall(a1, a2, a3)
            return 0
        }
        if number == Call.UPCALL_RETURN {
            if !p.*.events.inUpcall { return Status.invalid }
            if !p.prepare(a1, events.Events.CONTEXT_SIZE) { return Status.bad_address }
            p.*.events.leave(frame, a1)
            self.*.outcome.kind = OutcomeKind.replaced
            return 0
        }
        if number == Call.CLOCK_READ {
            if a1 == 0 { return @bitCast(isize, clock.system().monotonic()) }
            if a1 == 1 { return @bitCast(isize, clock.system().realtime()) }
            return Status.invalid
        }
        return Status.unsupported
    }

    // process_replace: the program `program` runs in the process instead
    // (its handles stay; its events are its own again only once it
    // claims).
    fn replace(self: *Self, p: *Process, frame: *Frame, program: usize, start: usize) -> isize {
        const node = processes.programOf(p, program)
        if node < 0 { return node }
        var arguments: process.Strings = undefined
        var environment: process.Strings = undefined
        if !processes.startOf(p, start, &arguments, &environment) { return Status.bad_address }
        const loaded = p.load(@bitCast(usize, node), arguments, environment)
        if loaded == process.Loaded.no_memory { return Status.no_memory }
        if loaded != process.Loaded.done { return Status.wrong_kind }
        p.setProgram(@bitCast(usize, node), processes.programDirectoryOf(p, program))
        // What is marked close-on-exec goes (the Linux layer's mark, and
        // every process and group handle).
        p.*.files.closeOnExec()
        p.*.fsBase = 0
        cpu.Msr.write(cpu.Msr.FS_BASE, 0)
        p.*.signals.exec()
        p.*.events.replace()
        frame.startAt(p.*.entry, p.*.stack)
        self.*.outcome.kind = OutcomeKind.replaced
        return 0
    }

    // events_take: up to `count` records of the queue (kind, detail,
    // sender, reserved: u32 each), oldest first, taken out.
    fn takeEvents(p: *Process, address: usize, count: usize) -> isize {
        if !p.prepare(address, count * 16) { return Status.bad_address }
        const into = Bytes.pointer(address)
        var taken: usize = 0
        while taken < count && p.*.events.count > 0 {
            const record = p.*.events.removeAt(0)
            Bytes.write32(into, taken * 16, @intCast(usize, record.kind))
            Bytes.write32(into, taken * 16 + 4, @intCast(usize, record.detail))
            Bytes.write32(into, taken * 16 + 8, @intCast(usize, record.sender))
            Bytes.write32(into, taken * 16 + 12, @intCast(usize, record.reserved))
            taken += 1
        }
        return @intCast(isize, taken)
    }

    // handle_info: kind, rights and state of the handle's object.
    fn info(p: *Process, handle: usize, address: usize) -> isize {
        if !objects.exists(p, handle) { return Status.invalid_handle }
        if !p.prepare(address, INFO_SIZE) { return Status.bad_address }
        const into = Bytes.pointer(address)
        const kind = objects.kindOf(p, handle)
        Bytes.write32(into, 0, @intCast(usize, kind))
        Bytes.write32(into, 4, @intCast(usize, objects.rightsOf(p, handle)))
        Bytes.write32(into, 8, @intCast(usize, objects.stateOf(p, handle)))
        Bytes.write32(into, 12, 0)
        return @intCast(isize, kind)
    }

    // wait: the items' states written; the count of those ready, or
    // timed_out; else the process waits (it makes the call again).
    fn waitFor(self: *Self, p: *Process, address: usize, count: usize, deadline: usize) -> isize {
        if count == 0 || count > wait.HandleWait.MAX { return Status.invalid }
        if !p.prepare(address, count * ITEM_SIZE) { return Status.bad_address }
        const items = Bytes.pointer(address)
        var ready: usize = 0
        var k: usize = 0
        while k < count {
            const handle = Bytes.read32(items, k * ITEM_SIZE)
            if !objects.exists(p, handle) { return Status.invalid_handle }
            const seen = objects.stateOf(p, handle)
            Bytes.write32(items, k * ITEM_SIZE + 8, @intCast(usize, seen))
            if @intCast(usize, seen) & Bytes.read32(items, k * ITEM_SIZE + 4) != 0 { ready += 1 }
            k += 1
        }
        if ready > 0 { return @intCast(isize, ready) }
        if deadline == 0 || self.*.timedOut { return Status.timed_out }
        if deadline != FOREVER && clock.system().monotonic() >= deadline { return Status.timed_out }
        k = 0
        while k < count {
            p.*.waitItems[k] = wait.HandleWait.{ .handle = @intCast(u32, Bytes.read32(items, k * ITEM_SIZE)), .want = @intCast(u32, Bytes.read32(items, k * ITEM_SIZE + 4)) }
            k += 1
        }
        p.*.waitCount = count
        self.*.outcome.kind = OutcomeKind.blocked
        self.*.outcome.waiting = wait.Wait.on(wait.WaitKind.handles, 0, if deadline == FOREVER { 0 } else { deadline })
        return wait.BLOCKED
    }

    // read and write: at a position of a node, or streaming (a stream,
    // the session); a stream that has nothing yet makes the process wait.
    fn transfer(self: *Self, p: *Process, handle: usize, address: usize, length: usize, at: usize, writing: bool) -> isize {
        if !objects.exists(p, handle) { return Status.invalid_handle }
        const rights = objects.rightsOf(p, handle)
        if (writing && rights & objects.Rights.WRITE == 0) || (!writing && rights & objects.Rights.READ == 0) { return Status.no_right }
        if !p.prepare(address, length) { return Status.bad_address }
        const fd = objects.descriptorOf(p, handle)
        const kind = p.*.files.get(fd).?.*.kind
        if kind == files.Kind.timer {
            if at != STREAM || writing { return Status.wrong_kind }
            const counted = timers.read(p, p.*.files.get(fd).?.*.index, address, length, &self.*.outcome.waiting)
            if counted == wait.BLOCKED { self.*.outcome.kind = OutcomeKind.blocked }
            return counted
        }
        if kind == files.Kind.process || kind == files.Kind.group || kind == files.Kind.memory || kind == files.Kind.channel { return Status.wrong_kind }
        if at == STREAM && !writing && p.*.files.isTerminal(fd) {
            const behind = self.readBehind(p)
            if behind != 0 { return behind }
        }
        var result: isize = 0
        if at == STREAM {
            result = if writing { p.*.files.write(fd, Bytes.pointer(address), length, &self.*.outcome.waiting) } else { p.*.files.read(fd, Bytes.pointer(address), length, &self.*.outcome.waiting) }
        } else {
            result = p.*.files.transferAt(fd, Bytes.pointer(address), length, at, writing, &self.*.outcome.waiting)
        }
        if result == wait.BLOCKED {
            self.*.outcome.kind = OutcomeKind.blocked
            return result
        }
        return (result)
    }

    // A read of the session's terminal by `p`: 0 when its group is in
    // front. A group behind gets READ_BEHIND and the call waits (the
    // process stops, and reads again when it goes on); io_error when the
    // event would not reach it.
    fn readBehind(self: *Self, p: *Process) -> isize {
        const table = scheduler.processes()
        if p.*.group == table.*.foreground || p.*.pid == scheduler.Scheduler.FIRST_PID { return 0 }
        if !p.*.events.native && p.*.signals.refuses(events.Event.READ_BEHIND) { return Status.io_error }
        table.sendGroup(p.*.group, events.Event.READ_BEHIND, 0)
        self.*.outcome.kind = OutcomeKind.blocked
        self.*.outcome.waiting = wait.Wait.on(wait.WaitKind.pause, 0, 0)
        return wait.BLOCKED
    }
}

var native: Native = undefined // (per run)

pub fn calls() -> *Native { return &native }
