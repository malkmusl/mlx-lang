// What a handle names and the state of its object (spec/04-stdlib/os/
// brix.xml, <Handles> and <States>). The process's descriptor table is
// its table of objects; a handle is (generation << 8) | (slot + 1), so it
// names the slot as it was when the handle was made: a handle kept past
// a close is invalid, whatever the slot holds later. The Linux layer's
// descriptors are the slots' numbers (its own view of the same entries).
const files = @import("../files.mlx")
const pipe = @import("../pipe.mlx")
const vfs = @import("../vfs.mlx")
const Process = @import("../process.mlx").Process

pub const State = struct {
    pub const READABLE: u32 = 0x1
    pub const WRITABLE: u32 = 0x2
    pub const PEER_GONE: u32 = 0x4
    pub const ENDED: u32 = 0x8
    pub const CHANGED: u32 = 0x10
    pub const EVENTS: u32 = 0x20
    pub const FRONT: u32 = 0x40
}

pub const ObjectKind = struct {
    pub const PROCESS: u32 = 1
    pub const GROUP: u32 = 2
    pub const NODE: u32 = 3
    pub const STREAM: u32 = 4
    pub const CHANNEL: u32 = 5
    pub const SESSION: u32 = 6
    pub const MEMORY: u32 = 7
    pub const TIMER: u32 = 8
}

pub const Rights = struct {
    pub const READ: u32 = 0x1
    pub const WRITE: u32 = 0x2
    pub const WAIT: u32 = 0x4
    pub const DUPLICATE: u32 = 0x8
    pub const TRANSFER: u32 = 0x10
    pub const CONTROL: u32 = 0x20
}

// The descriptor `handle` names (-1 for none, or a stale handle).
pub fn descriptorOf(p: *Process, handle: usize) -> isize {
    const slot = handle & 0xFF
    if slot == 0 || slot > files.Descriptors.MAX || handle >> 32 != 0 { return -1 }
    const fd = @intCast(isize, slot - 1)
    if p.*.files.get(fd) == null || @intCast(usize, p.*.files.generationOf(fd)) != handle >> 8 { return -1 }
    return fd
}

// The handle of the open descriptor `fd`.
pub fn handleOf(p: *Process, fd: isize) -> usize { return (@intCast(usize, p.*.files.generationOf(fd)) << 8) | (@bitCast(usize, fd) + 1) }

pub fn exists(p: *Process, handle: usize) -> bool { return descriptorOf(p, handle) >= 0 }

pub fn kindOf(p: *Process, handle: usize) -> u32 {
    const slot = p.*.files.get(descriptorOf(p, handle)).?
    if slot.*.kind != files.Kind.node { return ObjectKind.STREAM }
    if vfs.fileSystem().node(slot.*.index).*.kind == vfs.NodeKind.terminal { return ObjectKind.SESSION }
    return ObjectKind.NODE
}

pub fn rightsOf(p: *Process, handle: usize) -> u32 {
    const slot = p.*.files.get(descriptorOf(p, handle)).?
    var rights = Rights.WAIT | Rights.DUPLICATE | Rights.TRANSFER
    if files.Open.reads(slot.*.flags) { rights |= Rights.READ }
    if files.Open.writes(slot.*.flags) { rights |= Rights.WRITE }
    return rights
}

// The state of `handle`'s object (0 for no handle).
pub fn stateOf(p: *Process, handle: usize) -> u32 {
    const fd = descriptorOf(p, handle)
    if fd < 0 { return 0 }
    const found = p.*.files.get(fd)
    if found == null { return 0 }
    const slot = found.?
    var state: u32 = 0
    if p.*.files.readable(fd) && files.Open.reads(slot.*.flags) { state |= State.READABLE }
    if p.*.files.writable(fd) && files.Open.writes(slot.*.flags) { state |= State.WRITABLE }
    if slot.*.kind != files.Kind.node {
        const end = pipe.table().at(slot.*.index)
        const reading = slot.*.kind == files.Kind.pipe_read || slot.*.kind == files.Kind.pipe_both
        const writing = slot.*.kind == files.Kind.pipe_write || slot.*.kind == files.Kind.pipe_both
        if (reading && end.ended()) || (writing && end.broken()) { state |= State.PEER_GONE }
    }
    return state
}

// Whether a wanted state holds for one of the handles `p` waits for.
pub fn anyReady(p: *Process) -> bool {
    var k: usize = 0
    while k < p.*.waitCount {
        const item = p.*.waitItems[k]
        if stateOf(p, @intCast(usize, item.handle)) & item.want != 0 { return true }
        k += 1
    }
    return false
}
