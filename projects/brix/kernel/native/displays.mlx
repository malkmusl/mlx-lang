// The native calls for a display's modes (spec/04-stdlib/os/brix.xml,
// <Calls> 78 and 79, and <Displays>): on a handle of the display's node
// (/devices/framebuffer, /devices/framebuffer1 and on).
//
// display_modes lists what the display's monitor offers, a record a mode
// (../display_modes.mlx `record`); everyone who may open the node may
// read them. display_mode asks for a mode, confirms the pending one or
// takes it back (../modes.mlx `request`), and that is not everyone's to
// do: the mode of the screen is the session's, as its pixels are. Who
// may:
// - a process of user 0;
// - the process that draws on the display (the last that mapped its
//   pixels with node_map, while it lives: the session's compositor), when
//   the display's node is its user's (node_own: whoever starts a
//   session gives the display to the session's person, as it gives them
//   their directories).
// Everyone else: no_right. The handle needs the write right, as for
// anything that changes what a node stands for.
const Process = @import("../process.mlx").Process
const objects = @import("./objects.mlx")
const files = @import("../files.mlx")
const vfs = @import("../vfs.mlx")
const display = @import("../display.mlx")
const modes = @import("../modes.mlx")
const dm = @import("../display_modes.mlx")
const Status = @import("../status.mlx").Status

// The display a handle names (its number), or a status: no handle, no
// node, no display's node.
fn displayOf(p: *Process, handle: usize) -> isize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return Status.invalid_handle }
    const slot = p.*.files.get(fd).?
    if slot.*.kind != files.Kind.node { return Status.wrong_kind }
    const n = vfs.fileSystem().node(slot.*.index)
    if n.*.kind != vfs.NodeKind.framebuffer || n.*.archiveIndex >= modes.count() { return Status.wrong_kind }
    return @intCast(isize, n.*.archiveIndex)
}

// display_modes: the modes of the display `handle` names, a record of
// dm.RECORD bytes each at `address`, the first `capacity` of them; how
// many there are.
pub fn list(p: *Process, handle: usize, address: usize, capacity: usize) -> isize {
    const which = displayOf(p, handle)
    if which < 0 { return which }
    const number = @bitCast(usize, which)
    const count = modes.modes(number)
    const written = if capacity < count { capacity } else { count }
    if written != 0 && !p.prepare(address, written * dm.RECORD) { return Status.bad_address }
    var k: usize = 0
    while k < written {
        modes.record(number, k, unsafe { @ptrFromInt([*]u8, address + k * dm.RECORD) })
        k += 1
    }
    return @intCast(isize, count)
}

// Whether `p` may change the mode of the display `number`, whose node is
// `node` (the file's head).
fn may(p: *Process, number: usize, node: *const vfs.Node) -> bool {
    if p.*.user == 0 { return true }
    if node.*.user != p.*.user || display.drawer(number) != p.*.pid { return false }
    return true
}

// display_mode: for the display `handle` names, `what` 1: the mode of
// `size` (its width in the lower half, its height in the upper) at
// `rate` frames in a thousand seconds (0: at any rate) asked for; 2: the
// pending mode confirmed; 3: it is taken back. 0, or: no_right (the file's
// head), busy (a mode is pending: it is confirmed or taken back first),
// not_found (the display has no such mode; nothing is pending, a
// confirmation after the time to confirm too: the mode before is back),
// unsupported (the mode cannot be set: the display's record says why),
// io_error (the change failed on the way; the record says whether the
// mode before is back), invalid (no such `what`).
pub fn change(p: *Process, handle: usize, what: usize, size: usize, rate: usize) -> isize {
    const which = displayOf(p, handle)
    if which < 0 { return which }
    const number = @bitCast(usize, which)
    const fd = objects.descriptorOf(p, handle)
    const slot = p.*.files.get(fd).?
    if objects.rightsOf(p, handle) & objects.Rights.WRITE == 0 { return Status.no_right }
    if !may(p, number, vfs.fileSystem().node(slot.*.index)) { return Status.no_right }
    if what != modes.What.ASK && what != modes.What.CONFIRM && what != modes.What.TAKE_BACK { return Status.invalid }
    // (A confirmation after the time to confirm: not_found, the mode
    // before is back, display_modes.mlx's `callStatus`.)
    return dm.callStatus(modes.request(number, what, size & 0xFFFFFFFF, size >> 32, rate & 0xFFFFFFFF))
}
