// The native calls' status codes (spec/04-stdlib/os/brix.xml, <Status>),
// returned negated.
const Errno = @import("../linux/errno.mlx").Errno

pub const Status = struct {
    pub const invalid_handle: isize = -1
    pub const wrong_kind: isize = -2
    pub const no_right: isize = -3
    pub const would_block: isize = -4
    pub const timed_out: isize = -5
    pub const not_found: isize = -6
    pub const exists: isize = -7
    pub const no_memory: isize = -8
    pub const bad_address: isize = -9
    pub const invalid: isize = -10
    pub const peer_gone: isize = -11
    pub const interrupted: isize = -12
    pub const not_directory: isize = -13
    pub const is_directory: isize = -14
    pub const not_empty: isize = -15
    pub const read_only: isize = -16
    pub const too_large: isize = -17
    pub const unsupported: isize = -18
    pub const busy: isize = -19
    pub const denied: isize = -20

    // The core still answers with Linux's error numbers (linux/errno.mlx);
    // until it speaks Status itself, a native call turns a negative
    // answer over here (a value of zero or more stays).
    pub fn ofCore(result: isize) -> isize {
        if result >= 0 { return result }
        if result == Errno.EBADF { return invalid_handle }
        if result == Errno.ESPIPE || result == Errno.ENOTTY { return wrong_kind }
        if result == Errno.EAGAIN { return would_block }
        if result == Errno.ENOENT { return not_found }
        if result == -17 { return exists }
        if result == Errno.ENOMEM || result == Errno.ENFILE || result == Errno.EMFILE { return no_memory }
        if result == Errno.EFAULT { return bad_address }
        if result == Errno.EPIPE { return peer_gone }
        if result == Errno.EINTR { return interrupted }
        if result == Errno.ENOTDIR { return not_directory }
        if result == Errno.EISDIR { return is_directory }
        if result == -39 { return not_empty }
        if result == Errno.EROFS { return read_only }
        if result == Errno.ENAMETOOLONG || result == -7 || result == -27 { return too_large }
        if result == Errno.ENOSYS || result == Errno.ENODEV { return unsupported }
        if result == -16 { return busy }
        if result == Errno.EACCES || result == Errno.EPERM { return denied }
        return invalid
    }
}
