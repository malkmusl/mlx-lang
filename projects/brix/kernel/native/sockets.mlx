// The native calls on sockets (net/api.mlx, net/sockets.mlx): a socket
// handle (ObjectKind.SOCKET) of a kind (stream: TCP; datagram: UDP;
// ping: ICMP echo), bound, connected (a stream's connection is made
// later: the handle's state says WRITABLE, or PEER_GONE), listened on
// and accepted from, sent to and received from (an address and port
// given or taken: a SocketAddress, the IPv4 address's 4 bytes and the
// port as u32), and asked about (socket_info). A call never waits: it
// says would_block, and the program waits on the handle (the one wait).
const files = @import("../files.mlx")
const Process = @import("../process.mlx").Process
const Bytes = @import("../bytes.mlx").Bytes
const Status = @import("../status.mlx").Status
const objects = @import("./objects.mlx")
const stack = @import("../net/stack.mlx")
const sockets = @import("../net/sockets.mlx")
const api = @import("../net/api.mlx")

// socket_open's kinds.
const STREAM: usize = 1
const DATAGRAM: usize = 2
const PING: usize = 3
// A SocketAddress: the address (4 bytes), the port (u32).
const ADDRESS_SIZE: usize = 8
// socket_info's record: local address, peer address, the pending error
// (a Status code), the connection's state.
const INFO_SIZE: usize = 24

// The socket a handle names (its index), or -1.
fn socketOf(p: *Process, handle: usize) -> isize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return -1 }
    const slot = p.*.files.get(fd)
    if slot == null || slot.?.*.kind != files.Kind.socket { return -1 }
    return @intCast(isize, slot.?.*.index)
}

fn readAddress(p: *Process, address: usize, ip: *stack.Ip, port: *usize) -> bool {
    if address == 0 || !p.prepare(address, ADDRESS_SIZE) { return false }
    const a = Bytes.pointer(address)
    stack.readIp(a, 0, ip)
    port.* = Bytes.read32(a, 4) & 0xFFFF
    return true
}

fn writeAddress(p: *Process, address: usize, ip: stack.Ip, port: usize) -> bool {
    if address == 0 { return true }
    if !p.prepare(address, ADDRESS_SIZE) { return false }
    const a = Bytes.pointer(address)
    stack.putIp(a, 0, ip)
    Bytes.write32(a, 4, port)
    return true
}

// socket_open(kind) -> h.
pub fn open(p: *Process, kind: usize) -> isize {
    if kind != STREAM && kind != DATAGRAM && kind != PING { return Status.invalid }
    if !stack.configuration().*.up { return Status.unsupported }
    const index = api.open(if kind == STREAM { sockets.Kind.tcp } else if kind == DATAGRAM { sockets.Kind.udp } else { sockets.Kind.icmp })
    if index < 0 { return index }
    const fd = p.*.files.openSocket(@bitCast(usize, index), files.Open.READ_WRITE)
    if fd < 0 {
        api.release(@bitCast(usize, index))
        return fd
    }
    return @bitCast(isize, objects.handleOf(p, fd))
}

// socket_bind(h, port) (0: one the system picks).
pub fn bind(p: *Process, handle: usize, port: usize) -> isize {
    const index = socketOf(p, handle)
    if index < 0 { return Status.invalid_handle }
    if port > 65535 { return Status.invalid }
    return if sockets.sockets().bind(@bitCast(usize, index), port) { 0 } else { Status.busy }
}

// socket_connect(h, address*) (a stream: the connection begins; the
// handle is WRITABLE once it is made, PEER_GONE when it failed).
pub fn connect(p: *Process, handle: usize, address: usize) -> isize {
    const index = socketOf(p, handle)
    if index < 0 { return Status.invalid_handle }
    var ip: stack.Ip = undefined
    var port: usize = 0
    if !readAddress(p, address, &ip, &port) || port == 0 { return Status.bad_address }
    return api.connect(@bitCast(usize, index), ip, port)
}

// socket_listen(h).
pub fn listen(p: *Process, handle: usize) -> isize {
    const index = socketOf(p, handle)
    if index < 0 { return Status.invalid_handle }
    return api.listen(@bitCast(usize, index))
}

// socket_accept(h, peer* or 0) -> h (would_block: none yet; the
// listener is READABLE when one waits).
pub fn accept(p: *Process, handle: usize, peer: usize) -> isize {
    const index = socketOf(p, handle)
    if index < 0 { return Status.invalid_handle }
    const accepted = api.accept(@bitCast(usize, index))
    if accepted < 0 { return accepted }
    const made = sockets.sockets().at(@bitCast(usize, accepted))
    if !writeAddress(p, peer, made.*.remote, made.*.remotePort) {
        api.release(@bitCast(usize, accepted))
        return Status.bad_address
    }
    const fd = p.*.files.openSocket(@bitCast(usize, accepted), files.Open.READ_WRITE)
    if fd < 0 {
        api.release(@bitCast(usize, accepted))
        return fd
    }
    return @bitCast(isize, objects.handleOf(p, fd))
}

// socket_send(h, data, length, address* or 0) -> count (would_block
// when nothing could be taken).
pub fn send(p: *Process, handle: usize, data: usize, length: usize, address: usize) -> isize {
    const index = socketOf(p, handle)
    if index < 0 { return Status.invalid_handle }
    if !p.prepare(data, length) { return Status.bad_address }
    const s = sockets.sockets().at(@bitCast(usize, index))
    if s.*.kind == sockets.Kind.tcp {
        if !s.*.connected { return if s.*.pendingError != 0 { sockets.sockets().takeError(@bitCast(usize, index)) } else { Status.invalid } }
        return api.sendBytes(@bitCast(usize, index), Bytes.pointer(data), length)
    }
    var ip: stack.Ip = undefined
    var port: usize = 0
    stack.clearIp(&ip)
    if address != 0 && !readAddress(p, address, &ip, &port) { return Status.bad_address }
    return sockets.sockets().sendDatagram(@bitCast(usize, index), ip, port, Bytes.pointer(data), length)
}

// socket_receive(h, data, capacity, from* or 0) -> count (0: the peer
// closed; would_block: nothing yet).
pub fn receive(p: *Process, handle: usize, data: usize, capacity: usize, from: usize) -> isize {
    const index = socketOf(p, handle)
    if index < 0 { return Status.invalid_handle }
    if !p.prepare(data, capacity) { return Status.bad_address }
    const s = sockets.sockets().at(@bitCast(usize, index))
    if s.*.kind == sockets.Kind.tcp {
        const got = api.receiveBytes(@bitCast(usize, index), Bytes.pointer(data), capacity)
        if got >= 0 && !writeAddress(p, from, s.*.remote, s.*.remotePort) { return Status.bad_address }
        return got
    }
    var ip: stack.Ip = undefined
    var port: usize = 0
    const got = sockets.sockets().receiveDatagram(@bitCast(usize, index), Bytes.pointer(data), capacity, &ip, &port)
    if got >= 0 && !writeAddress(p, from, ip, port) { return Status.bad_address }
    return got
}

// socket_info(h, into*): the local and the peer address, the pending
// error (taken), whether it is connected.
pub fn info(p: *Process, handle: usize, into: usize) -> isize {
    const index = socketOf(p, handle)
    if index < 0 { return Status.invalid_handle }
    if !p.prepare(into, INFO_SIZE) { return Status.bad_address }
    const s = sockets.sockets().at(@bitCast(usize, index))
    const a = Bytes.pointer(into)
    stack.putIp(a, 0, stack.configuration().*.address)
    Bytes.write32(a, 4, s.*.localPort)
    stack.putIp(a, 8, s.*.remote)
    Bytes.write32(a, 12, s.*.remotePort)
    const code = sockets.sockets().takeError(@bitCast(usize, index))
    Bytes.write32(a, 16, @bitCast(usize, 0 - code) & 0xFFFFFFFF)
    Bytes.write32(a, 20, if s.*.connected { 1 } else { 0 })
    return 0
}
