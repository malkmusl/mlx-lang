// system_info (call 52): the machine's figures for a program, as words
// at `buffer` (the first `capacity` of them): the memory in bytes and
// what is free of it, the processors running the kernel, the uptime
// (nanoseconds, the monotonic clock), and the kernel's counts since the
// boot (page faults served, system calls, switches between processes,
// the devices' message-signalled interrupts), and the waits for the
// kernel (smp.Waits; nanoseconds): those of processors that had
// something to run summed, the longest of them since the start and what
// held the kernel for most of it (the process's id above 32 bits, 0 for
// a processor that idled; below, 0x80000000 and a system call's number,
// an interrupt's or fault's vector, or 0x7FFFFFFF for the idle loop),
// the longest of the last ten to twenty seconds and its holder, and the
// waits of processors that had nothing to run summed.
// The count of words there are; a program that gives fewer gets the
// first. std.build's runner sizes its jobs by the memory, the sysinfo
// tool says it all.
const memory = @import("../memory.mlx")
const smp = @import("../smp.mlx")
const clock = @import("../clock.mlx")
const counters = @import("../counters.mlx")
const Process = @import("../process.mlx").Process
const Bytes = @import("../bytes.mlx").Bytes
const Status = @import("../status.mlx").Status
const linux_system = @import("../linux/system.mlx")

pub const WORDS: usize = 14

pub fn info(p: *Process, buffer: usize, capacity: usize) -> isize {
    const written = if capacity < WORDS { capacity } else { WORDS }
    if !p.prepare(buffer, written * 8) { return Status.bad_address }
    var words: [WORDS]usize = undefined
    words[0] = memory.allFrames().totalBytes()
    words[1] = memory.allFrames().freeBytes()
    words[2] = smp.processors().*.running
    words[3] = clock.system().monotonic()
    words[4] = counters.all().*.pageFaults
    words[5] = counters.all().*.systemCalls
    words[6] = counters.all().*.switches
    words[7] = counters.all().*.deviceInterrupts
    const waits = smp.waited()
    const recent = waits.recent()
    words[8] = clock.system().nanoseconds(waits.*.total)
    words[9] = clock.system().nanoseconds(waits.*.longest)
    words[10] = waits.*.longestFor
    words[11] = clock.system().nanoseconds(recent.0)
    words[12] = recent.1
    words[13] = clock.system().nanoseconds(waits.*.idle)
    var k: usize = 0
    while k < written {
        Bytes.write64(Bytes.pointer(buffer), k * 8, words[k])
        k += 1
    }
    return @intCast(isize, WORDS)
}

// random_fill: `length` bytes of the kernel's generator at `address` (a
// xorshift seeded from the time-stamp counter: not for secrets); how many.
pub fn randomFill(p: *Process, address: usize, length: usize) -> isize {
    if !p.prepare(address, length) { return Status.bad_address }
    const into = Bytes.pointer(address)
    const generator = &linux_system.system().*.random
    var k: usize = 0
    while k < length {
        into[k] = @intCast(u8, (generator.next() >> 24) & 255)
        k += 1
    }
    return @bitCast(isize, length)
}

// memory_region: where the caller's mapping holding `address` starts and
// ends (two words at `into`); not_found when none holds it.
pub fn memoryRegion(p: *Process, address: usize, into: usize) -> isize {
    if !p.prepare(into, 16) { return Status.bad_address }
    var start: usize = 0
    var end: usize = 0
    if !p.regionOf(address, &start, &end) {
        // Outside the mappings (the program's segments, its break, its
        // stack): the page, when it is there.
        const page = address & ~(memory.Page.SIZE - 1)
        if p.*.space.translate(page) == 0 { return Status.not_found }
        start = page
        end = page + memory.Page.SIZE
    }
    Bytes.write64(Bytes.pointer(into), 0, start)
    Bytes.write64(Bytes.pointer(into), 8, end)
    return 0
}
