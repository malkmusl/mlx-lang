// The native calls on timers and memory objects.
const files = @import("../files.mlx")
const timer = @import("../timer.mlx")
const memoryObjects = @import("../memoryobjects.mlx")
const memory = @import("../memory.mlx")
const wait = @import("../wait.mlx")
const Process = @import("../process.mlx").Process
const Bytes = @import("../bytes.mlx").Bytes
const Status = @import("../status.mlx").Status
const objects = @import("./objects.mlx")

const Page = memory.Page

// memory_map_object's flags.
pub const Map = struct {
    pub const WRITE: usize = 0x1
}

// timer_create: a timer whose first deadline is `deadline` (the monotonic
// clock's nanoseconds), again every `period` (0: once); a handle to it.
pub fn create(p: *Process, deadline: usize, period: usize) -> isize {
    const index = timer.table().create(deadline, period)
    if index == timer.Timers.MAX { return Status.too_many }
    const fd = p.*.files.openObject(files.Kind.timer, index, files.Open.READ_ONLY)
    if fd < 0 {
        timer.table().release(index)
        return fd
    }
    return @bitCast(isize, objects.handleOf(p, fd))
}

// A streaming read of a timer: how many times it expired since the last
// read (u64; 8 bytes), waiting for the next deadline when it has not; 0
// bytes when it will not expire again.
pub fn read(p: *Process, index: usize, address: usize, length: usize, waiting: *wait.Wait) -> isize {
    if length < 8 { return Status.too_large }
    const t = timer.table().at(index)
    if !t.armed() { return 0 }
    const count = t.take()
    if count == 0 {
        waiting.* = wait.Wait.on(wait.WaitKind.pause, 0, t.*.deadline)
        return wait.BLOCKED
    }
    Bytes.write64(Bytes.pointer(address), 0, count)
    return 8
}

// memory_object: a memory object of `size` bytes (in pages), zeroed; a
// handle to it.
pub fn memoryObject(p: *Process, size: usize) -> isize {
    if size == 0 { return Status.invalid }
    const pages = Page.up(size) / Page.SIZE
    if pages > memoryObjects.MemoryObject.PAGES { return Status.too_large }
    const index = memoryObjects.table().create(pages)
    if index == memoryObjects.MemoryObjects.MAX { return Status.no_memory }
    const fd = p.*.files.openObject(files.Kind.memory, index, files.Open.READ_WRITE)
    if fd < 0 {
        memoryObjects.table().release(index)
        return fd
    }
    return @bitCast(isize, objects.handleOf(p, fd))
}

// memory_map_object: `size` bytes of the object from `offset` (a page's
// start) mapped into the caller, shared with every other mapping;
// writable with Map.WRITE (the handle's write right). The address.
pub fn mapObject(p: *Process, handle: usize, offset: usize, size: usize, flags: usize) -> isize {
    const fd = objects.descriptorOf(p, handle)
    if fd < 0 { return Status.invalid_handle }
    const slot = p.*.files.get(fd).?
    if slot.*.kind != files.Kind.memory { return Status.wrong_kind }
    const writable = flags & Map.WRITE != 0
    if writable && objects.rightsOf(p, handle) & objects.Rights.WRITE == 0 { return Status.no_right }
    const m = memoryObjects.table().at(slot.*.index)
    if offset & (Page.SIZE - 1) != 0 || size == 0 || offset >= m.size() || Page.up(size) > m.size() - offset { return Status.invalid }
    const first = offset / Page.SIZE
    return p.mapShared(m.*.frames[first..first + Page.up(size) / Page.SIZE], writable)
}
