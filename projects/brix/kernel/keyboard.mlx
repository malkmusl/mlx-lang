// The PS/2 keyboard (the i8042 controller's first port): its scancodes
// (set 1, as QEMU and the firmware leave the keyboard: a byte a key
// pressed, the same with bit 7 set for released, 0xE0 before the extended
// ones) come by IRQ 1 into a ring, which /devices/keyboard gives to a
// program that reads it (mlx-console decodes them). Nothing is translated
// here.
const cpu = @import("./cpu.mlx")
const wait = @import("./wait.mlx")

const Port = cpu.Port

pub const Keyboard = struct {
    const DATA: usize = 0x60
    const STATUS: usize = 0x64
    const OUTPUT_FULL: usize = 1
    const CAPACITY: usize = 256

    ring: [CAPACITY]u8
    head: usize
    count: usize
    // Whether a controller answered at all.
    present: bool

    // What the controller holds is dropped (the firmware's leftovers).
    pub fn init(self: *Self) -> void {
        self.*.head = 0
        self.*.count = 0
        var drained: usize = 0
        while Port.in8(STATUS) & OUTPUT_FULL != 0 && drained < 64 {
            _ = Port.in8(DATA)
            drained += 1
        }
        self.*.present = Port.in8(STATUS) != 0xFF
    }

    // IRQ 1: the scancodes the controller has into the ring (the oldest
    // dropped when it is full).
    pub fn interrupted(self: *Self) -> void {
        while Port.in8(STATUS) & OUTPUT_FULL != 0 {
            const code = @intCast(u8, Port.in8(DATA))
            if self.*.count == CAPACITY {
                self.*.head = (self.*.head + 1) % CAPACITY
                self.*.count -= 1
            }
            self.*.ring[(self.*.head + self.*.count) % CAPACITY] = code
            self.*.count += 1
        }
    }

    pub fn pending(self: *const Self) -> bool { return self.*.count > 0 }

    // Up to `capacity` scancodes; wait.BLOCKED when there are none.
    pub fn read(self: *Self, into: [*]u8, capacity: usize) -> isize {
        if self.*.count == 0 { return wait.BLOCKED }
        var got: usize = 0
        while got < capacity && self.*.count > 0 {
            into[got] = self.*.ring[self.*.head]
            self.*.head = (self.*.head + 1) % CAPACITY
            self.*.count -= 1
            got += 1
        }
        return @intCast(isize, got)
    }
}

var keyboard: Keyboard = undefined // (per run)

pub fn ps2() -> *Keyboard { return &keyboard }
