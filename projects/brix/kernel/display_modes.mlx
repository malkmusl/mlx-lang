// The modes a display's monitor offers, and a display's mode changed
// while the system runs: asked for by a program, pending until the
// program confirms it, put back by the kernel itself when nobody does.
//
// THE MODES are what the monitor's EDID says, every block of it that is
// there, whoever read it (the firmware through the loader, a driver over
// the monitor's own lines):
// - every detailed timing (edid.mlx's `everyTiming`: the base block's,
//   a CTA-861 extension's, a DisplayID extension's);
// - the established timings: a bit each in the base block's bytes 35 to
//   37, and those of the third kind in a descriptor (0xF7);
// - the standard timings: eight two-byte codes from byte 38, and six
//   more in a descriptor (0xFA), each a size across, a shape and a rate;
// - the video codes a CTA-861 extension's video block names.
// What a bit or a code means is in the standards' tables
// (mode_tables.mlx, Linux 6.6's, each number held against Linux's file),
// read as Linux reads them (drivers/gpu/drm/drm_edid.c: add_established_
// modes, drm_est3_modes, drm_mode_std, drm_mode_find_dmt, svd_to_vic). A
// standard timing whose size and rate VESA's table has no row for is
// listed all the same, without a timing (Linux works one out by a
// formula; that is not built here): a driver that sets a size alone can
// set it, one that sends a monitor a timing cannot, and says so.
// Each mode once (the first of two of one size, rate and kind: a timing
// the monitor writes out before one it names), the largest first.
//
// Each mode says whether the display's driver can set it, and when not,
// why (`Why`: the driver judges, `judge`): more than the output carries,
// a signalling that is not built, not this driver. The mode that runs
// now and the monitor's own are marked.
//
// A CHANGE goes through a driver, behind one seam (`Driver`): the mode
// set (`set`), and the mode before put back (`back`). `State` is a
// display's part of it:
// - `ask`: a mode of the list by its size and rate (or, of a driver that
//   makes any size, a size that is not listed) is set, and is PENDING;
// - `confirm`: it stays, and is what the next boots set (`kept`);
// - `takeBack`: the mode before is put back, by the program;
// - `tick`: the same by the kernel itself when CONFIRM_TIME has passed
//   since the change and nobody confirmed: the net for a mode the
//   monitor does not show (nobody can answer a question they cannot
//   see);
// - a second request while one is pending is refused (busy): first the
//   one that is there is confirmed or taken back.
// A driver's `set` ends in one of four ways (`Set`): done; refused with
// nothing written; failed and the mode before back; failed and not known
// to be back.
//
// Nothing of the kernel's is used here but the numbers of its answers
// (status.mlx): the clock is a number handed in, the driver a record of
// functions, so that a test runs every request on the host (tests/489_
// display_modes_runtime.mlx). kernel/modes.mlx binds it to the displays,
// their drivers, the timer and the native calls.
const edid = @import("./edid.mlx")
const tables = @import("./mode_tables.mlx")
const Status = @import("./status.mlx").Status

// The most modes kept for a display.
pub const MAX: usize = 96
// No mode of the list.
pub const NONE: usize = MAX

// How long a mode a program asked for waits to be confirmed before the
// kernel puts the mode before back: fifteen seconds, in nanoseconds.
pub const CONFIRM_TIME: usize = 15000000000

// Where a mode is from.
pub const Source = struct {
    // A timing the monitor writes out.
    pub const DETAILED: usize = 1
    // A bit of the established timings.
    pub const ESTABLISHED: usize = 2
    // A standard timing's code.
    pub const STANDARD: usize = 3
    // A video code of a CTA-861 extension.
    pub const VIDEO_CODE: usize = 4
    // A size a program asked for, of a driver that makes any size.
    pub const ASKED: usize = 5
    // The mode that runs, which the monitor does not name (the
    // firmware's).
    pub const RUNNING: usize = 6
}

// Why a mode cannot be set (0: it can).
pub const Why = struct {
    pub const NONE: usize = 0
    // No driver of this system sets this display's mode: it is what the
    // firmware left.
    pub const NO_DRIVER: usize = 1
    // The display's driver changes no mode on this kind of output (a
    // DisplayPort output's is not changed while the system runs).
    pub const OUTPUT: usize = 2
    // More than the output carries (`limit`: its most, in kHz).
    pub const TOO_FAST: usize = 3
    // Less than the output sends.
    pub const TOO_SLOW: usize = 4
    // Signalling that is not built: an interlaced picture; every pixel
    // sent twice; a picture for stereo glasses.
    pub const INTERLACED: usize = 5
    pub const DOUBLED: usize = 6
    pub const STEREO: usize = 7
    // The monitor names it by size and rate alone and the standard's
    // table has no timing for it.
    pub const NO_TIMING: usize = 8
    // More than the adapter's memory holds.
    pub const MEMORY: usize = 9
    // Not a size the adapter makes.
    pub const SIZE: usize = 10
    // Another rate of the size that runs, which this driver does not set.
    pub const SAME_SIZE: usize = 11
    // The card is not in a state the driver changes a mode from (the
    // kernel's log says what is missing).
    pub const CARD: usize = 12
}

// The reason in plain words (what the kernel's log says after "cannot be
// set: ").
pub fn whyText(why: usize) -> []const u8 {
    if why == Why.NO_DRIVER { return "this display is as the firmware left it, and no driver of this system sets its mode" }
    if why == Why.OUTPUT { return "the display's driver changes the mode of an HDMI or DVI output only" }
    if why == Why.TOO_FAST { return "more than this output carries" }
    if why == Why.TOO_SLOW { return "less than this output sends" }
    if why == Why.INTERLACED { return "an interlaced picture, which is not built" }
    if why == Why.DOUBLED { return "a picture whose pixels are sent twice, which is not built" }
    if why == Why.STEREO { return "a picture for stereo glasses, which is not built" }
    if why == Why.NO_TIMING { return "the monitor names it by size and rate alone, and the standard's table has no timing for it" }
    if why == Why.MEMORY { return "more than the adapter's memory holds" }
    if why == Why.SIZE { return "not a size this adapter makes" }
    if why == Why.SAME_SIZE { return "another rate of the size that runs, which this driver does not set" }
    if why == Why.CARD { return "the card is not in a state its driver changes a mode from" }
    return "it can be set"
}

pub const Mode = struct {
    width: usize
    height: usize
    // Frames in a thousand seconds (an interlaced picture's fields); 0:
    // not known (a size alone).
    millihertz: usize
    // Its timing, when `timed` (an interlaced one's numbers down are the
    // whole frame's, both fields).
    timing: edid.Timing
    timed: bool
    // Every pixel sent twice (a timing of CTA-861's for old screens).
    doubled: bool
    source: usize
    // The monitor's own mode.
    own: bool
    // Whether the driver can set it (Why.NONE), else why not, and for
    // TOO_FAST the output's most in kHz.
    why: usize
    limit: usize

    pub fn interlaced(self: *const Self) -> bool { return self.*.timed && self.*.timing.interlaced }

    // Whether `other` is the same mode: the size, the rate, the kind.
    pub fn same(self: *const Self, other: *const Mode) -> bool {
        return self.*.width == other.*.width && self.*.height == other.*.height && self.*.millihertz == other.*.millihertz && self.interlaced() == other.interlaced() && self.*.doubled == other.*.doubled
    }
}

fn noTiming() -> edid.Timing {
    return edid.Timing.{ .clock = 0, .width = 0, .hTotal = 0, .hFront = 0, .hSync = 0, .hPositive = false, .height = 0, .vTotal = 0, .vFront = 0, .vSync = 0, .vPositive = false, .interlaced = false, .stereo = false }
}

// A mode that is a size and a rate alone.
pub fn sizeOnly(width: usize, height: usize, millihertz: usize, source: usize) -> Mode {
    return Mode.{ .width = width, .height = height, .millihertz = millihertz, .timing = noTiming(), .timed = false, .doubled = false, .source = source, .own = false, .why = Why.NONE, .limit = 0 }
}

// A timing's rate in frames (fields) in a thousand seconds.
fn rateOf(t: *const edid.Timing) -> usize {
    const rate = t.millihertz()
    return if t.*.interlaced { rate * 2 } else { rate }
}

// A mode of a timing as it is to be sent.
pub fn timedMode(t: *const edid.Timing, source: usize) -> Mode {
    return Mode.{ .width = t.*.width, .height = t.*.height, .millihertz = rateOf(t), .timing = t.*, .timed = true, .doubled = false, .source = source, .own = false, .why = Why.NONE, .limit = 0 }
}

// The tables, by a number: each is reached by its index alone. (A slice
// of another module's constant table, `tables.DMT[0..]`, is made anew in
// the value arena each time it is written, the whole table: a list made
// that way took up to 800 KiB of a processor's 4 MiB arena, which the
// kernel does not give back before it first enters a program.)
const IN_DMT: usize = 0
const IN_ESTABLISHED: usize = 1
const IN_CTA: usize = 2

// Number `at` of table `table`.
fn cell(table: usize, at: usize) -> usize {
    if table == IN_DMT { return @intCast(usize, tables.DMT[at]) }
    if table == IN_ESTABLISHED { return @intCast(usize, tables.ESTABLISHED[at]) }
    return @intCast(usize, tables.CTA[at])
}

// Row `row` of one of the tables (its ten numbers from `at`) as a mode.
fn rowMode(table: usize, row: usize, source: usize) -> Mode {
    const at = row * tables.ROW
    const flags = cell(table, at + tables.FLAGS)
    var t = noTiming()
    t.clock = cell(table, at + tables.CLOCK)
    t.width = cell(table, at + tables.H_SIZE)
    t.hTotal = cell(table, at + tables.H_TOTAL)
    t.hFront = cell(table, at + tables.H_SYNC_START) - t.width
    t.hSync = cell(table, at + tables.H_SYNC_END) - cell(table, at + tables.H_SYNC_START)
    t.hPositive = flags & tables.PHSYNC != 0
    t.height = cell(table, at + tables.V_SIZE)
    t.vTotal = cell(table, at + tables.V_TOTAL)
    t.vFront = cell(table, at + tables.V_SYNC_START) - t.height
    t.vSync = cell(table, at + tables.V_SYNC_END) - cell(table, at + tables.V_SYNC_START)
    t.vPositive = flags & tables.PVSYNC != 0
    t.interlaced = flags & tables.INTERLACE != 0
    var mode = timedMode(&t, source)
    mode.doubled = flags & tables.DBLCLK != 0
    // (Every line shown twice: the picture is half as high as its
    // timing, at the timing's rate. None of the tables' rows is one;
    // should one be, it is listed as what it sends.)
    if flags & tables.DBLSCAN != 0 { mode.millihertz = mode.millihertz / 2 }
    return mode
}

// A table row's rate in whole Hz, rounded as Linux rounds it
// (drm_mode_vrefresh).
fn rowHertz(table: usize, row: usize) -> usize {
    const at = row * tables.ROW
    const flags = cell(table, at + tables.FLAGS)
    var up = cell(table, at + tables.CLOCK) * 1000
    var down = cell(table, at + tables.H_TOTAL) * cell(table, at + tables.V_TOTAL)
    if flags & tables.INTERLACE != 0 { up = up * 2 }
    if flags & tables.DBLSCAN != 0 { down = down * 2 }
    if down == 0 { return 0 }
    return (up + down / 2) / down
}

// Whether a row of VESA's table is a timing with reduced blanking
// (Linux's mode_is_rb).
fn rowReduced(row: usize) -> bool {
    const at = row * tables.ROW
    const width = tables.DMT[at + tables.H_SIZE]
    return tables.DMT[at + tables.H_TOTAL] - width == 160 && tables.DMT[at + tables.H_SYNC_END] - width == 80 && tables.DMT[at + tables.H_SYNC_END] - tables.DMT[at + tables.H_SYNC_START] == 32 && tables.DMT[at + tables.V_SYNC_START] - tables.DMT[at + tables.V_SIZE] == 3
}

// The row of VESA's table for a size, a rate in whole Hz and the kind of
// blanking (Linux's drm_mode_find_dmt); the table's row count when it
// has none.
pub fn findDmt(width: usize, height: usize, hertz: usize, reduced: bool) -> usize {
    const rows = dmtRows()
    var row: usize = 0
    while row < rows {
        const at = row * tables.ROW
        if @intCast(usize, tables.DMT[at + tables.H_SIZE]) == width && @intCast(usize, tables.DMT[at + tables.V_SIZE]) == height && rowHertz(IN_DMT, row) == hertz && rowReduced(row) == reduced { return row }
        row += 1
    }
    return rows
}

pub fn dmtRows() -> usize { return tables.DMT.length / tables.ROW }

pub const List = struct {
    modes: [MAX]Mode
    count: usize
    // What the EDID names that gave no mode: a video code the table has
    // no row for (and a standard timing's code that is none), and modes
    // there was no room for.
    unnamed: usize
    beyond: usize

    pub fn clear(self: *Self) -> void {
        self.*.count = 0
        self.*.unnamed = 0
        self.*.beyond = 0
    }

    // A mode added unless one like it is there (the earlier one stays; a
    // later one with a timing takes the place of one without).
    pub fn add(self: *Self, mode: *const Mode) -> void {
        if mode.*.width == 0 || mode.*.height == 0 { return }
        var k: usize = 0
        while k < self.*.count {
            const had = &self.*.modes[k]
            if had.same(mode) {
                if !had.*.timed && mode.*.timed {
                    const own = had.*.own
                    had.* = mode.*
                    had.*.own = own
                }
                return
            }
            k += 1
        }
        if self.*.count == MAX {
            self.*.beyond += 1
            return
        }
        self.*.modes[self.*.count] = mode.*
        self.*.count += 1
    }

    // The largest first: by the pixels, then the wider, then the higher
    // rate, a whole picture before an interlaced one.
    pub fn sort(self: *Self) -> void {
        var k: usize = 1
        while k < self.*.count {
            const one = self.*.modes[k]
            var at = k
            while at > 0 && before(&one, &self.*.modes[at - 1]) {
                self.*.modes[at] = self.*.modes[at - 1]
                at -= 1
            }
            self.*.modes[at] = one
            k += 1
        }
    }

    // The mode of a size and a rate: one that can be set before one that
    // cannot (two of one size and rate differ in their kind); a rate of
    // 0 asks for the size at any rate: the monitor's own of that size,
    // else the highest that can be set. NONE when there is none.
    pub fn find(self: *const Self, width: usize, height: usize, millihertz: usize) -> usize {
        var found: usize = NONE
        var k: usize = 0
        while k < self.*.count {
            const m = &self.*.modes[k]
            if m.*.width == width && m.*.height == height && (millihertz == 0 || m.*.millihertz == millihertz) {
                if found == NONE {
                    found = k
                } else {
                    const had = &self.*.modes[found]
                    if had.*.why != Why.NONE && m.*.why == Why.NONE {
                        found = k
                    } else if millihertz == 0 && m.*.own && !had.*.own && m.*.why == Why.NONE {
                        found = k
                    }
                }
            }
            k += 1
        }
        return found
    }

    // The mode nearest to one that runs with `millihertz` as counted (a
    // counted rate is a little off the timing's): of that size, within a
    // hundredth of the rate; with no rate known, the monitor's own of
    // that size, else the first. NONE when the size is not listed.
    pub fn nearest(self: *const Self, width: usize, height: usize, millihertz: usize) -> usize {
        var found: usize = NONE
        var off: usize = 0
        var k: usize = 0
        while k < self.*.count {
            const m = &self.*.modes[k]
            if m.*.width == width && m.*.height == height && !m.interlaced() {
                if millihertz == 0 {
                    if found == NONE || (m.*.own && !self.*.modes[found].own) { found = k }
                } else if m.*.millihertz != 0 {
                    const by = if m.*.millihertz > millihertz { m.*.millihertz - millihertz } else { millihertz - m.*.millihertz }
                    if by * 100 <= millihertz && (found == NONE || by < off) {
                        found = k
                        off = by
                    }
                }
            }
            k += 1
        }
        return found
    }
}

fn before(a: *const Mode, b: *const Mode) -> bool {
    const pa = a.*.width * a.*.height
    const pb = b.*.width * b.*.height
    if pa != pb { return pa > pb }
    if a.*.width != b.*.width { return a.*.width > b.*.width }
    if a.*.millihertz != b.*.millihertz { return a.*.millihertz > b.*.millihertz }
    if a.interlaced() != b.interlaced() { return !a.interlaced() }
    return false
}

fn byteAt(bytes: []const u8, at: usize) -> usize { return @intCast(usize, bytes[at]) }

fn addsUp(bytes: []const u8, at: usize, count: usize) -> bool {
    var sum: usize = 0
    var k: usize = 0
    while k < count {
        sum += @intCast(usize, bytes[at + k])
        k += 1
    }
    return sum & 0xFF == 0
}

// Whether the monitor takes timings with reduced blanking, as Linux
// decides it (drm_monitor_supports_rb): from revision 4 on a range
// descriptor (0xFD) that says so (its byte 10 is 4, CVT, and bit 4 of its
// byte 15), before that any monitor with a digital input.
fn takesReduced(bytes: []const u8) -> bool {
    if byteAt(bytes, 19) < 4 { return byteAt(bytes, 20) & 0x80 != 0 }
    var k: usize = 0
    while k < 4 {
        const at = 54 + k * 18
        if byteAt(bytes, at) == 0 && byteAt(bytes, at + 1) == 0 && byteAt(bytes, at + 2) == 0 && byteAt(bytes, at + 3) == 0xFD && byteAt(bytes, at + 10) == 0x04 && byteAt(bytes, at + 15) & 0x10 != 0 { return true }
        k += 1
    }
    return false
}

// A standard timing's two bytes as a mode (Linux's drm_mode_std): the
// size across is the first byte's number times 8 and 248, the shape the
// second's upper two bits (16:10, before revision 3 of the EDID 1:1; 4:3;
// 5:4; 16:9), the rate its lower six and 60. VESA's row for it (the one
// with reduced blanking first for a monitor that takes it), else the size
// and the rate without a timing. Two codes are none (bad_std_timing).
fn standard(bytes: []const u8, first: usize, second: usize, list: *List) -> void {
    if (first == 0 && second == 0) || (first == 1 && second == 1) || (first == 0x20 && second == 0x20) { return }
    var width = first * 8 + 248
    const shape = second >> 6
    const hertz = (second & 0x3F) + 60
    var height = width * 9 / 16
    if shape == 0 {
        height = if byteAt(bytes, 19) < 3 { width } else { width * 10 / 16 }
    } else if shape == 1 {
        height = width * 3 / 4
    } else if shape == 2 {
        height = width * 4 / 5
    }
    // (Linux's "HDTV hack": two codes that mean 1366x768, which the
    // code's steps of eight cannot say. Linux works that one's timing
    // out by a formula; here it is VESA's own row of that size and
    // rate.)
    if hertz == 60 && ((width == 1360 && height == 765) || (width == 1368 && height == 769)) {
        width = 1366
        height = 768
    }
    const rows = dmtRows()
    var row = rows
    if takesReduced(bytes) { row = findDmt(width, height, hertz, true) }
    if row == rows { row = findDmt(width, height, hertz, false) }
    if row != rows {
        const mode = rowMode(IN_DMT, row, Source.STANDARD)
        list.add(&mode)
    } else {
        const mode = sizeOnly(width, height, hertz * 1000, Source.STANDARD)
        list.add(&mode)
    }
}

// The modes the EDID in `bytes` names (none, the base block, or the base
// block and as many of its extension blocks as there are bytes for), into
// `list`, the largest first. Bytes that are no EDID, or whose base block
// does not add up, give none.
pub fn read(bytes: []const u8, list: *List) -> void {
    list.clear()
    const monitor = edid.read(bytes)
    if monitor.state == edid.State.none || monitor.state == edid.State.no_header || monitor.state == edid.State.bad_checksum { return }
    // The timings written out. An interlaced one's numbers down are a
    // field's: the frame's are twice that and a line (as Linux has them
    // for the pictures CTA-861 knows, drm_mode_do_interlace_quirk).
    var timings: [MAX]edid.Timing = undefined
    const written = edid.everyTiming(bytes, timings[0..])
    var k: usize = 0
    while k < written && k < MAX {
        var t = timings[k]
        if t.interlaced {
            t.height = t.height * 2
            t.vTotal = t.vTotal * 2 + 1
            t.vFront = t.vFront * 2
            t.vSync = t.vSync * 2
        }
        var mode = timedMode(&t, Source.DETAILED)
        mode.own = monitor.state == edid.State.found && !t.interlaced && !t.stereo && t.clock == monitor.timing.clock && t.width == monitor.timing.width && t.height == monitor.timing.height && t.hTotal == monitor.timing.hTotal && t.vTotal == monitor.timing.vTotal
        list.add(&mode)
        k += 1
    }
    if written > MAX { list.*.beyond += written - MAX }
    // The established timings: bit k of the three bytes is row k.
    const bits = byteAt(bytes, 35) | (byteAt(bytes, 36) << 8) | ((byteAt(bytes, 37) & 0x80) << 9)
    k = 0
    while k < tables.ESTABLISHED.length / tables.ROW {
        if bits & (@intCast(usize, 1) << @intCast(u6, k)) != 0 {
            const mode = rowMode(IN_ESTABLISHED, k, Source.ESTABLISHED)
            list.add(&mode)
        }
        k += 1
    }
    // The standard timings: eight codes in the base block.
    k = 0
    while k < 8 {
        standard(bytes, byteAt(bytes, 38 + k * 2), byteAt(bytes, 39 + k * 2), list)
        k += 1
    }
    // The base block's descriptors that are no timing: more standard
    // timings (0xFA: six codes from its byte 5), the established timings
    // of the third kind (0xF7: bits from its byte 6, the first row the
    // first byte's highest bit; each a row of VESA's table by its size,
    // rate and blanking, left out when the table has none).
    k = 0
    while k < 4 {
        const at = 54 + k * 18
        if byteAt(bytes, at) == 0 && byteAt(bytes, at + 1) == 0 && byteAt(bytes, at + 2) == 0 {
            const tag = byteAt(bytes, at + 3)
            if tag == 0xFA {
                var c: usize = 0
                while c < 6 {
                    standard(bytes, byteAt(bytes, at + 5 + c * 2), byteAt(bytes, at + 6 + c * 2), list)
                    c += 1
                }
            } else if tag == 0xF7 {
                var m: usize = 0
                while m < tables.ESTABLISHED_3.length / tables.ROW_3 && m < 48 {
                    if byteAt(bytes, at + 6 + m / 8) & (@intCast(usize, 0x80) >> @intCast(u6, m % 8)) != 0 {
                        const row3 = m * tables.ROW_3
                        const row = findDmt(@intCast(usize, tables.ESTABLISHED_3[row3]), @intCast(usize, tables.ESTABLISHED_3[row3 + 1]), @intCast(usize, tables.ESTABLISHED_3[row3 + 2]), tables.ESTABLISHED_3[row3 + 3] != 0)
                        if row != dmtRows() {
                            const mode = rowMode(IN_DMT, row, Source.ESTABLISHED)
                            list.add(&mode)
                        } else {
                            list.*.unnamed += 1
                        }
                    }
                    m += 1
                }
            }
        }
        k += 1
    }
    // The extension blocks that were passed on: a CTA-861 block of
    // revision 3 and later has data blocks from its byte 4 to where its
    // timings begin; a video block (tag 2) is a byte a video code, the
    // code as Linux takes it (svd_to_vic: the upper bit of 1 to 64 marks
    // the monitor's favourite, above that the byte is the code).
    var number: usize = 1
    while number <= byteAt(bytes, 126) && (number + 1) * edid.BLOCK <= bytes.length {
        const ext = number * edid.BLOCK
        const end = byteAt(bytes, ext + 2)
        if addsUp(bytes, ext, edid.BLOCK) && bytes[ext] == 0x02 && byteAt(bytes, ext + 1) >= 3 && end >= 4 && end <= 127 {
            var at: usize = 4
            while at < end {
                const tag = byteAt(bytes, ext + at) >> 5
                const length = byteAt(bytes, ext + at) & 0x1F
                if at + 1 + length > end { break }
                if tag == 2 {
                    var c: usize = 0
                    while c < length {
                        const named = byteAt(bytes, ext + at + 1 + c)
                        const code = if (named >= 1 && named <= 64) || (named >= 129 && named <= 192) { named & 127 } else { named }
                        if code >= tables.CTA_FIRST && code - tables.CTA_FIRST < tables.CTA.length / tables.ROW {
                            const mode = rowMode(IN_CTA, code - tables.CTA_FIRST, Source.VIDEO_CODE)
                            list.add(&mode)
                        } else if code != 0 {
                            list.*.unnamed += 1
                        }
                        c += 1
                    }
                }
                at += 1 + length
            }
        }
        number += 1
    }
    list.sort()
}

// What names a monitor, for a mode remembered for it: its maker's
// letters, its product number and its serial number as its EDID has them
// (bytes 8 to 15), in one word; 0 for bytes that are no EDID.
pub fn monitorName(bytes: []const u8) -> usize {
    if bytes.length < edid.BLOCK { return 0 }
    const monitor = edid.read(bytes[0..edid.BLOCK])
    if monitor.state == edid.State.none || monitor.state == edid.State.no_header || monitor.state == edid.State.bad_checksum { return 0 }
    var name: usize = 0
    var k: usize = 0
    while k < 8 {
        name = (name << 8) | byteAt(bytes, 8 + k)
        k += 1
    }
    return name
}

// How a driver's mode set ended.
pub const Set = enum(u8) {
    // The display runs the mode, and `Picture` says where its picture is.
    done,
    // Not carried out, nothing written: the mode's `why` says why.
    refused,
    // It failed on the way, and the mode before is back.
    back,
    // It failed, and the mode before is not known to be back.
    lost,
    // Not carried out, nothing written: the driver is changing the
    // display already (a Radeon's picture brought to the output its
    // monitor was moved to: gpu_together.mlx). Asked again later.
    busy
}

// A display's picture: where its memory is (a physical address), its size
// in pixels, the bytes from one row to the next.
pub const Picture = struct {
    address: usize
    width: usize
    height: usize
    pitch: usize
}

// The kinds of driver.
pub const Kind = struct {
    // None of ours: the display is as the firmware left it.
    pub const FIRMWARE: usize = 0
    // QEMU's adapter (the Bochs display interface).
    pub const QEMU: usize = 1
    // A Radeon's output with HDMI or DVI signalling.
    pub const RADEON_TMDS: usize = 2
    // A Radeon's other output (one this driver sets no mode on: several
    // streams, a monitor that did not answer): the modes are listed, none
    // is set.
    pub const RADEON_OTHER: usize = 3
    // A Radeon's DisplayPort output.
    pub const RADEON_DP: usize = 4
}

// The seam for drivers. `which` is handed back to every function (the
// driver's own number of the display). `timed`: it sends the monitor a
// timing (a mode without one cannot be set, nor an interlaced one, one
// with its pixels sent twice or for stereo: the same for every such
// driver, judged here); else it sets a size alone. `anySize`: it makes a
// size that is not listed. `judge` says of a mode whether it can be set
// (its `why` and `limit`), writing nothing. `set` sets a mode (which
// `judge` passed), `back` puts back the mode that ran before the last
// `set` that ended done (it is handed that mode as the list had it,
// which may be one without a timing: the driver keeps what it needs to
// go back); both give the picture when they end done.
pub const Driver = struct {
    kind: usize
    which: usize
    timed: bool
    anySize: bool
    judge: fn(usize, *Mode) -> void
    set: fn(usize, *const Mode, *Picture) -> Set
    back: fn(usize, *const Mode, *Picture) -> Set
}

// What a request came to.
pub const Answer = enum(u8) {
    // Nothing was asked yet.
    none,
    // The mode asked for runs now and waits to be confirmed.
    changed,
    // The mode asked for is the one that runs: nothing was done.
    already,
    // The pending mode stays, and is remembered.
    confirmed,
    // The mode before is back (asked for by the program).
    taken_back,
    // The same, done by the kernel itself: nobody confirmed in time.
    timed_out,
    // A change is pending: it is confirmed or taken back first.
    busy,
    // There is no pending change to confirm or take back.
    nothing_pending,
    // The display has no such mode.
    not_listed,
    // The mode cannot be set (`lastWhy` says why); nothing was written.
    refused,
    // The change failed on the way, and the mode before is back.
    failed_back,
    // The change failed, and what the display shows is not known.
    failed_lost
}

// The record's flags.
pub const Flag = struct {
    pub const RUNS: usize = 0x1
    pub const OWN: usize = 0x2
    pub const CAN: usize = 0x4
    pub const INTERLACED: usize = 0x8
    // The mode the next boots set (confirmed last).
    pub const KEPT: usize = 0x10
    // While a change is pending: the mode before, which comes back.
    pub const BEFORE: usize = 0x20
    pub const DOUBLED: usize = 0x40
}

// The bytes of a mode's record (`State.record`).
pub const RECORD: usize = 64
// The words a display's state adds to its node's record
// (`State.describe`).
pub const STATE_WORDS: usize = 6

pub const State = struct {
    driver: Driver
    list: List
    // The mode that runs, and its picture.
    runs: Mode
    picture: Picture
    // A change that waits to be confirmed: the mode before, and when the
    // kernel takes it back (the clock's nanoseconds).
    pending: bool
    before: Mode
    deadline: usize
    // How often the display's picture changed (what a program's handle
    // is held against).
    changes: usize
    // What the last request came to, and why a mode was refused.
    last: Answer
    lastWhy: usize
    // The mode confirmed last: what the next boots set. `keep`: it has
    // been confirmed since the kernel last wrote it down (the kernel's
    // part: modes.mlx writes the file and clears this).
    kept: Mode
    hasKept: bool
    keep: bool

    // The display as it is at boot: its driver, the modes its monitor's
    // EDID names, and what runs (the picture; the rate as the driver
    // knows it, 0: not known; `timing`: the running mode's own, when the
    // driver knows it, else null). A mode that runs and is not among the
    // monitor's is listed too.
    pub fn begin(self: *Self, driver: *const Driver, bytes: []const u8, picture: *const Picture, millihertz: usize, timing: ?*const edid.Timing) -> void {
        self.*.driver = driver.*
        self.*.picture = picture.*
        self.*.pending = false
        self.*.deadline = 0
        self.*.changes = 0
        self.*.last = Answer.none
        self.*.lastWhy = Why.NONE
        self.*.hasKept = false
        self.*.keep = false
        read(bytes, &self.*.list)
        self.running(picture.*.width, picture.*.height, millihertz, timing)
        self.*.before = self.*.runs
        self.*.kept = self.*.runs
        self.judge()
    }

    // The monitor's EDID is another (another monitor was plugged in, or
    // more of its blocks were read): the modes listed anew from `bytes`
    // and judged. What runs, what is pending and what is kept stay as
    // they are; the mode that runs is found in the new list or listed
    // beside it.
    pub fn relist(self: *Self, bytes: []const u8) -> void {
        const runs = self.*.runs
        read(bytes, &self.*.list)
        const at = self.*.list.find(runs.width, runs.height, runs.millihertz)
        if at != NONE && self.*.list.modes[at].interlaced() == runs.interlaced() {
            self.*.runs = self.*.list.modes[at]
        } else {
            self.*.runs.own = false
            self.*.list.add(&self.*.runs)
            self.*.list.sort()
        }
        self.judge()
    }

    // What runs is a mode of this size and rate: the list's nearest, or
    // one added for it.
    pub fn running(self: *Self, width: usize, height: usize, millihertz: usize, timing: ?*const edid.Timing) -> void {
        const at = self.*.list.nearest(width, height, millihertz)
        if at != NONE {
            self.*.runs = self.*.list.modes[at]
            return
        }
        self.*.runs = if timing != null { timedMode(timing.?, Source.RUNNING) } else { sizeOnly(width, height, millihertz, Source.RUNNING) }
        self.*.runs.width = width
        self.*.runs.height = height
        if millihertz != 0 { self.*.runs.millihertz = millihertz }
        self.*.list.add(&self.*.runs)
        self.*.list.sort()
    }

    // One mode judged: what every driver that sends a timing cannot
    // send, then the driver's own word.
    fn judgeOne(self: *const Self, mode: *Mode) -> void {
        mode.*.why = Why.NONE
        mode.*.limit = 0
        if self.*.driver.timed {
            if !mode.*.timed {
                mode.*.why = Why.NO_TIMING
            } else if mode.*.timing.interlaced {
                mode.*.why = Why.INTERLACED
            } else if mode.*.timing.stereo {
                mode.*.why = Why.STEREO
            } else if mode.*.doubled {
                mode.*.why = Why.DOUBLED
            }
            if mode.*.why != Why.NONE { return }
        }
        const judge = self.*.driver.judge
        judge(self.*.driver.which, mode)
    }

    // Every mode of the list judged anew (the driver's word may depend
    // on what runs).
    pub fn judge(self: *Self) -> void {
        var k: usize = 0
        while k < self.*.list.count {
            self.judgeOne(&self.*.list.modes[k])
            k += 1
        }
    }

    fn answer(self: *Self, what: Answer, why: usize) -> Answer {
        self.*.last = what
        self.*.lastWhy = why
        return what
    }

    // The mode `mode` set through the driver: what the display runs and
    // shows afterwards.
    fn carry(self: *Self, mode: *const Mode) -> Set {
        var picture = self.*.picture
        const set = self.*.driver.set
        const result = set(self.*.driver.which, mode, &picture)
        if result == Set.done {
            self.*.runs = mode.*
            self.*.picture = picture
            self.*.changes += 1
            // (A size that was asked for as such is one of the display's
            // modes from now on: the list has what runs.)
            if self.*.list.find(mode.*.width, mode.*.height, mode.*.millihertz) == NONE {
                self.*.list.add(mode)
                self.*.list.sort()
            }
            self.judge()
        } else if result == Set.lost {
            // (What the display shows is not known: programs look again.)
            self.*.changes += 1
        }
        return result
    }

    // The mode a request names: one of the list, or (a rate of 0, a
    // driver that makes any size) the size as such. False when the
    // display has none such. (A size nothing names has no rate: one asked
    // for with a rate is none, or the record would say a rate that was
    // made up.)
    fn named(self: *const Self, width: usize, height: usize, millihertz: usize, mode: *Mode) -> bool {
        const at = self.*.list.find(width, height, millihertz)
        if at != NONE {
            mode.* = self.*.list.modes[at]
            return true
        }
        if !self.*.driver.anySize || width == 0 || height == 0 || millihertz != 0 { return false }
        mode.* = sizeOnly(width, height, millihertz, Source.ASKED)
        return true
    }

    // A program asks for the mode of `width` by `height` at `millihertz`
    // (0: at any rate) at the time `now`.
    pub fn ask(self: *Self, width: usize, height: usize, millihertz: usize, now: usize) -> Answer {
        if self.*.pending { return self.answer(Answer.busy, Why.NONE) }
        var mode: Mode = undefined
        if !self.named(width, height, millihertz, &mode) { return self.answer(Answer.not_listed, Why.NONE) }
        self.judgeOne(&mode)
        if mode.why != Why.NONE { return self.answer(Answer.refused, mode.why) }
        if self.*.runs.same(&mode) || (mode.source == Source.ASKED && mode.millihertz == 0 && self.*.runs.width == width && self.*.runs.height == height) { return self.answer(Answer.already, Why.NONE) }
        const was = self.*.runs
        const result = self.carry(&mode)
        if result == Set.done {
            self.*.before = was
            self.*.pending = true
            self.*.deadline = now + CONFIRM_TIME
            return self.answer(Answer.changed, Why.NONE)
        }
        if result == Set.busy { return self.answer(Answer.busy, Why.NONE) }
        if result == Set.refused { return self.answer(Answer.refused, if mode.why != Why.NONE { mode.why } else { Why.CARD }) }
        return self.answer(if result == Set.back { Answer.failed_back } else { Answer.failed_lost }, Why.NONE)
    }

    // The pending mode stays.
    pub fn confirm(self: *Self) -> Answer {
        if !self.*.pending { return self.answer(Answer.nothing_pending, Why.NONE) }
        self.*.pending = false
        self.*.kept = self.*.runs
        self.*.hasKept = true
        self.*.keep = true
        return self.answer(Answer.confirmed, Why.NONE)
    }

    // The mode before put back: by the program (`byTime` false) or by
    // the kernel itself. The change is pending no more whatever comes of
    // it: a way back that failed is not gone again and again.
    fn goBack(self: *Self, byTime: bool) -> Answer {
        self.*.pending = false
        var picture = self.*.picture
        const back = self.*.driver.back
        const result = back(self.*.driver.which, &self.*.before, &picture)
        if result == Set.busy {
            // (Nothing was written: the change stays pending, and is
            // taken back once the driver is done.)
            self.*.pending = true
            return self.answer(Answer.busy, Why.NONE)
        }
        if result == Set.done {
            self.*.runs = self.*.before
            self.*.picture = picture
            self.*.changes += 1
            self.judge()
            return self.answer(if byTime { Answer.timed_out } else { Answer.taken_back }, Why.NONE)
        }
        self.*.changes += 1
        // (A way back that ends "back" left the pending mode running.)
        return self.answer(if result == Set.lost { Answer.failed_lost } else { Answer.failed_back }, Why.NONE)
    }

    pub fn takeBack(self: *Self) -> Answer {
        if !self.*.pending { return self.answer(Answer.nothing_pending, Why.NONE) }
        return self.goBack(false)
    }

    // The pending mode confirmed at the time `now`: as `confirm` before
    // the time to confirm is over. After it the mode goes back now, as
    // the timer's tick would have taken it back (the tick comes a moment
    // later, or the clock's turn was had elsewhere): whether a late
    // confirmation counts does not depend on when the next tick comes.
    // The answer is then the kernel's own taking back (timed_out).
    pub fn confirmAt(self: *Self, now: usize) -> Answer {
        if self.*.pending && now >= self.*.deadline { return self.goBack(true) }
        return self.confirm()
    }

    // A pending mode taken back by the kernel before its time: the
    // display's driver is to bring the picture to another output, or to
    // set another monitor's timing (gpu_together.mlx), and a mode nobody
    // has confirmed is not carried there. Answered as the kernel's own
    // taking back (timed_out); the kernel's log says why.
    pub fn withdraw(self: *Self) -> Answer {
        if !self.*.pending { return self.answer(Answer.nothing_pending, Why.NONE) }
        return self.goBack(true)
    }

    // The display's driver brought the picture to another output, or set
    // its mode again there (gpu_together.mlx; the picture's memory, size
    // and pitch are as they were): the modes listed anew from what that
    // output's monitor's EDID says (`bytes`), and what runs is the
    // picture's size at `millihertz` (the rate counted; 0: as it was),
    // the list's nearest or one added for it. What is kept stays.
    pub fn moved(self: *Self, bytes: []const u8, millihertz: usize) -> void {
        const rate = if millihertz != 0 { millihertz } else { self.*.runs.millihertz }
        read(bytes, &self.*.list)
        self.running(self.*.picture.width, self.*.picture.height, rate, null)
        self.judge()
    }

    // The clock says `now`: a pending mode nobody confirmed in time is
    // taken back. True when that was done (the answer is in `last`).
    pub fn tick(self: *Self, now: usize) -> bool {
        if !self.*.pending || now < self.*.deadline { return false }
        _ = self.goBack(true)
        return true
    }

    // A mode confirmed at an earlier boot set again at this one: not
    // pending, and kept.
    pub fn restore(self: *Self, width: usize, height: usize, millihertz: usize) -> Answer {
        var mode: Mode = undefined
        if !self.named(width, height, millihertz, &mode) { return self.answer(Answer.not_listed, Why.NONE) }
        self.*.kept = mode
        self.*.hasKept = true
        self.judgeOne(&mode)
        if mode.why != Why.NONE { return self.answer(Answer.refused, mode.why) }
        if self.*.runs.same(&mode) || (mode.source == Source.ASKED && mode.millihertz == 0 && self.*.runs.width == width && self.*.runs.height == height) { return self.answer(Answer.already, Why.NONE) }
        const result = self.carry(&mode)
        if result == Set.done { return self.answer(Answer.confirmed, Why.NONE) }
        if result == Set.refused || result == Set.busy { return self.answer(Answer.refused, if mode.why != Why.NONE { mode.why } else { Why.CARD }) }
        return self.answer(if result == Set.back { Answer.failed_back } else { Answer.failed_lost }, Why.NONE)
    }

    // The remembered mode forgotten (the monitor's own is what the next
    // boots set again).
    pub fn forget(self: *Self) -> void {
        self.*.hasKept = false
        self.*.keep = false
    }

    // Mode `index`'s record, RECORD bytes, every number 32 bits, the
    // lowest byte first: width, height, the rate in frames in a thousand
    // seconds, the flags, why it cannot be set (0: it can), where it is
    // from, then its timing (0 throughout when it has none): the pixel
    // clock in kHz, across the total, the front porch and the sync
    // pulse, down the same three, the pulses' polarities (1: the one
    // across is the high one, 2: the one down); the output's most in kHz
    // where the mode is more than it carries; 0.
    pub fn record(self: *const Self, index: usize, into: [*]u8) -> void {
        const m = &self.*.list.modes[index]
        var flags: usize = 0
        if m.same(&self.*.runs) { flags |= Flag.RUNS }
        if m.*.own { flags |= Flag.OWN }
        if m.*.why == Why.NONE { flags |= Flag.CAN }
        if m.interlaced() { flags |= Flag.INTERLACED }
        if m.*.doubled { flags |= Flag.DOUBLED }
        if self.*.hasKept && m.same(&self.*.kept) { flags |= Flag.KEPT }
        if self.*.pending && m.same(&self.*.before) { flags |= Flag.BEFORE }
        const t = &m.*.timing
        const timed = m.*.timed
        var polarity: usize = 0
        if timed && t.*.hPositive { polarity |= 1 }
        if timed && t.*.vPositive { polarity |= 2 }
        const words = [16]usize{ m.*.width, m.*.height, m.*.millihertz, flags, m.*.why, m.*.source, if timed { t.*.clock } else { 0 }, if timed { t.*.hTotal } else { 0 }, if timed { t.*.hFront } else { 0 }, if timed { t.*.hSync } else { 0 }, if timed { t.*.vTotal } else { 0 }, if timed { t.*.vFront } else { 0 }, if timed { t.*.vSync } else { 0 }, polarity, m.*.limit, 0 }
        var k: usize = 0
        while k < 16 {
            put32(into, k * 4, words[k])
            k += 1
        }
    }

    // What the display's node says beyond its geometry, STATE_WORDS
    // words of 64 bits at `into`: how often the picture changed; the
    // state's bits (1: a change waits to be confirmed; 2: the display
    // has a driver that changes modes; 4: the driver makes sizes that
    // are not listed; 8: a mode is remembered for the next boots); the
    // nanoseconds until a pending change is taken back (0: none is
    // pending); the rate that runs in frames in a thousand seconds (0:
    // not known); the driver's kind; what the last request came to (an
    // Answer) and, above its lowest byte, why a mode was refused.
    pub fn describe(self: *const Self, now: usize, into: [*]u8) -> void {
        var bits: usize = 0
        if self.*.pending { bits |= 1 }
        if self.*.driver.kind == Kind.QEMU || self.*.driver.kind == Kind.RADEON_TMDS { bits |= 2 }
        if self.*.driver.anySize { bits |= 4 }
        if self.*.hasKept { bits |= 8 }
        const left = if self.*.pending && self.*.deadline > now { self.*.deadline - now } else { 0 }
        const last: u8 = @intFromEnum(self.*.last)
        const words = [6]usize{ self.*.changes, bits, left, self.*.runs.millihertz, self.*.driver.kind, @intCast(usize, last) | (self.*.lastWhy << 8) }
        var k: usize = 0
        while k < STATE_WORDS {
            put32(into, k * 8, words[k] & 0xFFFFFFFF)
            put32(into, k * 8 + 4, words[k] >> 32)
            k += 1
        }
    }
}

fn put32(into: [*]u8, at: usize, value: usize) -> void {
    var b: usize = 0
    while b < 4 {
        into[at + b] = @intCast(u8, (value >> @intCast(u6, b * 8)) & 0xFF)
        b += 1
    }
}

// A number in decimal, through `write`.
fn decimal(write: fn([]const u8) -> void, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    write(digits[at..20])
}

// A mode as the log says it: "1920x1080 at 60.00 Hz", "1920x1080
// interlaced at 60.00 Hz", "1024x768" where no rate is known.
pub fn sayMode(write: fn([]const u8) -> void, mode: *const Mode) -> void {
    decimal(write, mode.*.width)
    write("x")
    decimal(write, mode.*.height)
    if mode.interlaced() { write(" interlaced") }
    if mode.*.millihertz == 0 { return }
    write(" at ")
    decimal(write, mode.*.millihertz / 1000)
    const hundredths = mode.*.millihertz % 1000 / 10
    write(if hundredths < 10 { ".0" } else { "." })
    decimal(write, hundredths)
    write(" Hz")
}

// Why a mode cannot be set, as the log says it: the words, and the
// output's most where that is the reason.
pub fn sayWhy(write: fn([]const u8) -> void, why: usize, limit: usize) -> void {
    write(whyText(why))
    if why == Why.TOO_FAST && limit != 0 {
        write(" (")
        decimal(write, limit / 1000)
        write(" MHz at most)")
    }
}

// ---- What is remembered for the next boots: the text of the file the
// kernel keeps it in (modes.mlx reads and writes the file itself). A
// line a display:
//
//     mode 1002:67df 4c2d123478563412 1920x1080@60000
//
// the PCI vendor and device of the display's adapter in hex (four digits
// each), the monitor's name (`monitorName`, sixteen hex digits; all 0 for
// a display whose monitor says nothing of itself), and the mode: its size
// and its rate in frames in a thousand seconds (0: a size alone). A mode
// is remembered for a monitor on an adapter: with another monitor
// plugged in, or the monitor on another card, it does not count. Lines
// that are none of these are passed over and kept as they are.

pub const Kept = struct {
    width: usize
    height: usize
    millihertz: usize
}

fn hexDigit(byte: u8) -> usize {
    if byte >= 48 && byte <= 57 { return @intCast(usize, byte) - 48 }
    if byte >= 97 && byte <= 102 { return @intCast(usize, byte) - 87 }
    if byte >= 65 && byte <= 70 { return @intCast(usize, byte) - 55 }
    return 16
}

// `digits` hex digits of `line` from `at` as a number; false when one of
// them is none.
fn hexAt(line: []const u8, at: usize, digits: usize, into: *usize) -> bool {
    if at + digits > line.length { return false }
    var value: usize = 0
    var k: usize = 0
    while k < digits {
        const digit = hexDigit(line[at + k])
        if digit > 15 { return false }
        value = (value << 4) | digit
        k += 1
    }
    into.* = value
    return true
}

// The decimal number of `line` from `at.*` (one digit at least, nine at
// most), `at.*` moved behind it; false when there is none.
fn decimalAt(line: []const u8, at: *usize, into: *usize) -> bool {
    var value: usize = 0
    var digits: usize = 0
    while at.* < line.length && line[at.*] >= 48 && line[at.*] <= 57 && digits < 9 {
        value = value * 10 + @intCast(usize, line[at.*] - 48)
        at.* += 1
        digits += 1
    }
    into.* = value
    return digits != 0
}

// A line of the file read: whose it is and what it remembers; false when
// it is no such line.
fn readLine(line: []const u8, vendor: *usize, device: *usize, monitor: *usize, kept: *Kept) -> bool {
    const word = "mode "
    if line.length < word.length + 9 + 1 + 16 + 1 { return false }
    var k: usize = 0
    while k < word.length {
        if line[k] != word[k] { return false }
        k += 1
    }
    if !hexAt(line, 5, 4, vendor) || line[9] != 58 || !hexAt(line, 10, 4, device) || line[14] != 32 { return false }
    if !hexAt(line, 15, 16, monitor) || line[31] != 32 { return false }
    var at: usize = 32
    if !decimalAt(line, &at, &kept.*.width) || at >= line.length || line[at] != 120 { return false }
    at += 1
    if !decimalAt(line, &at, &kept.*.height) || at >= line.length || line[at] != 64 { return false }
    at += 1
    if !decimalAt(line, &at, &kept.*.millihertz) { return false }
    while at < line.length {
        if line[at] != 32 && line[at] != 13 && line[at] != 9 { return false }
        at += 1
    }
    return kept.*.width != 0 && kept.*.height != 0
}

// The mode `text` remembers for the monitor `monitor` on the adapter
// `vendor`:`device` (the last such line counts); false when it has none.
pub fn remembered(text: []const u8, vendor: usize, device: usize, monitor: usize, into: *Kept) -> bool {
    var found = false
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        var v: usize = 0
        var d: usize = 0
        var m: usize = 0
        var kept: Kept = undefined
        if readLine(text[at..end], &v, &d, &m, &kept) && v == vendor && d == device && m == monitor {
            into.* = kept
            found = true
        }
        at = end + 1
    }
    return found
}

fn putText(into: []u8, at: *usize, text: []const u8) -> void {
    var k: usize = 0
    while k < text.length {
        if at.* < into.length { into[at.*] = text[k] }
        at.* += 1
        k += 1
    }
}

fn putHex(into: []u8, at: *usize, value: usize, digits: usize) -> void {
    var k: usize = digits
    while k > 0 {
        k -= 1
        const digit = (value >> @intCast(u6, k * 4)) & 15
        const one = [1]u8{ @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit }) }
        putText(into, at, one[0..1])
    }
}

fn putDecimal(into: []u8, at: *usize, value: usize) -> void {
    var digits: [20]u8 = undefined
    var from: usize = 20
    var rest = value
    while true {
        from -= 1
        digits[from] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    putText(into, at, digits[from..20])
}

// What a boot does with a mode that is remembered for a display.
pub const AtBoot = enum(u8) {
    // It is set, in place of the monitor's own.
    set,
    // Nothing is set at this boot; it stays remembered.
    leave,
    // It is not set and is forgotten: the monitor's own mode is what the
    // boots set again.
    forget
}

// The rule. `ownAsked`: the monitor's own mode was asked for by hand at
// this start (the key N while the machine starts): that is the way back
// from a remembered mode that turned out badly, so it wins and the
// remembered mode is forgotten. `sets`: this boot's choice has a driver
// set a mode of its own choosing (not when the firmware's picture is
// kept, the monitor only asked, or the firmware's own mode set again).
pub fn atBoot(ownAsked: bool, sets: bool) -> AtBoot {
    if ownAsked { return AtBoot.forget }
    return if sets { AtBoot.set } else { AtBoot.leave }
}

// Whether a remembered mode that a boot tried to set is forgotten after
// what came of it: when the display was written and the mode did not
// come (tried at every boot, it would darken every start); not when it
// was set, ran already, or could not be set with nothing written (the
// monitor does not name it at this boot, or the card is not in a state
// to set it: another boot may).
pub fn forgottenAfter(answer: Answer) -> bool { return answer == Answer.failed_back || answer == Answer.failed_lost }

// Where a write of the file of remembered modes ended (kernel/modes.mlx
// writes it): on a disk; in memory alone (the system does not run from a
// disk); not at all (no /system, or the file could not be made, written
// or committed).
pub const Written = enum(u8) { disk, memory, not }

// What a boot says of a remembered mode it meant to forget, by where the
// file's write ended (after "the mode remembered for this monitor, ...,
// "): forgotten only where the line is gone from the file the next boots
// read. `byKey`: N was pressed at this start (the monitor's own mode is
// set); else the mode was tried and did not come.
pub fn forgetText(byKey: bool, where: Written) -> []const u8 {
    if where == Written.disk { return if byKey { ", is forgotten, and its own mode is what the boots set again\n" } else { "; it is forgotten, and the next boots set the monitor's own mode\n" } }
    if where == Written.memory { return if byKey { ", is forgotten at this boot; this system does not run from a disk\n" } else { "; it is forgotten at this boot; this system does not run from a disk\n" } }
    return if byKey { ", is not forgotten: /system/settings/display-modes could not be written, so a boot without N sets it again\n" } else { "; it is not forgotten: /system/settings/display-modes could not be written, so the next boots try it again\n" }
}

// The status a program's request comes back with (native call 79,
// display_mode: spec/04-stdlib/os/brix.xml), by what it came to. A
// confirmation that comes after the time to confirm finds the mode before
// back, as the kernel's own taking back would have left it whether or not
// the timer's tick has come yet (`confirmAt`): nothing is pending to be
// confirmed, which is not_found, as a confirmation after the tick finds it.
pub fn callStatus(answer: Answer) -> isize {
    if answer == Answer.changed || answer == Answer.already || answer == Answer.confirmed || answer == Answer.taken_back { return 0 }
    if answer == Answer.busy { return Status.busy }
    if answer == Answer.not_listed || answer == Answer.nothing_pending || answer == Answer.timed_out { return Status.not_found }
    if answer == Answer.refused { return Status.unsupported }
    return Status.io_error
}

// The file's text anew, into `into`: `text` without that display's lines,
// and a line for `mode` at its end (null: none, the mode is forgotten).
// How many bytes it is. When that is more than `into` holds, the lines at
// the file's beginning are left out, one after the other, until it fits:
// the modes confirmed longest ago, of other monitors (each confirmation
// puts its line at the end). More than `into.length` only when the new
// line alone does not fit (then `into` holds its beginning and is not to
// be written).
pub fn remember(text: []const u8, vendor: usize, device: usize, monitor: usize, mode: ?*const Kept, into: []u8) -> usize {
    var lines: usize = 0
    var k: usize = 0
    while k < text.length {
        if text[k] == 10 || k + 1 == text.length { lines += 1 }
        k += 1
    }
    var dropped: usize = 0
    var length = rewrite(text, vendor, device, monitor, mode, into, 0)
    while length > into.length && dropped < lines {
        dropped += 1
        length = rewrite(text, vendor, device, monitor, mode, into, dropped)
    }
    return length
}

// `remember`'s text with the first `drop` lines of `text` left out.
fn rewrite(text: []const u8, vendor: usize, device: usize, monitor: usize, mode: ?*const Kept, into: []u8, drop: usize) -> usize {
    var length: usize = 0
    var line: usize = 0
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        var v: usize = 0
        var d: usize = 0
        var m: usize = 0
        var kept: Kept = undefined
        const theirs = readLine(text[at..end], &v, &d, &m, &kept) && v == vendor && d == device && m == monitor
        if !theirs && end > at && line >= drop {
            putText(into, &length, text[at..end])
            putText(into, &length, "\n")
        }
        line += 1
        at = end + 1
    }
    if mode != null {
        putText(into, &length, "mode ")
        putHex(into, &length, vendor & 0xFFFF, 4)
        putText(into, &length, ":")
        putHex(into, &length, device & 0xFFFF, 4)
        putText(into, &length, " ")
        putHex(into, &length, monitor, 16)
        putText(into, &length, " ")
        putDecimal(into, &length, mode.?.*.width)
        putText(into, &length, "x")
        putDecimal(into, &length, mode.?.*.height)
        putText(into, &length, "@")
        putDecimal(into, &length, mode.?.*.millihertz)
        putText(into, &length, "\n")
    }
    return length
}
