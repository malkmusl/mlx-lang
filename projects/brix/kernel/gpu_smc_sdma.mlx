// Two more hands than gpu_engines.mlx's: a 32-bit word of the system's
// memory written by its physical address, a doorbell written (its index:
// the 32-bit word at four times it in the card's doorbell aperture) and
// how many doorbells the kernel's view holds (0: none).
pub const More = struct {
    memoryWrite: fn(usize, u32) -> void
    doorbell: fn(usize, u32) -> void
    doorbells: usize
}

// What stages 3 and 4 did and keep.
pub const Loaded = struct {
    more: More
    f1: engines.Outcome
    f2: engines.Outcome
    d1: engines.Outcome
    d2: engines.Outcome
    // The registers the steps wrote, with what each held before, in order.
    register: [KEPT]usize
    value: [KEPT]usize
    count: usize
    full: bool
    // F1: the SMC found running, uploaded to, in protected mode; the
    // answer to the start's trigger and whether the wait for an earlier
    // answer ran out; the uploaded payload's words and the version word
    // read back; the program counter twice, the firmware's flags.
    running: bool
    uploaded: bool
    protectedMode: bool
    trigger: usize
    ranOut: bool
    words: usize
    payloadVersion: usize
    headerVersion: usize
    payloadSoftRegisters: usize
    versionWord: usize
    counter: [2]usize
    flags: usize
    status: usize
    // F2: the soft registers' place in the SMC's RAM, the load status, the
    // copies (physical), the engines' words as the SMC left them and as
    // halted again.
    softRegisters: usize
    loadStatus: usize
    copies: usize
    left: [3]usize
    halted: [3]usize
    // The copy engines: the write-back page, their rings (physical), the
    // write pointers (words), the fences counted, whether a NOP covers
    // more than itself, whether each runs, the doorbells.
    writeBack: usize
    ring: [2]usize
    wptr: [2]usize
    fences: [2]usize
    burst: [2]bool
    up: [2]bool
    doorbellsOn: bool
    // D2's pages: the indirect buffers', the copy's source and its target
    // back in the system's memory.
    buffers: usize
    source: usize
    target: usize
    // The trap entries seen in D2 (their ring ids), the other entries.
    traps: [TRAPS]usize
    trapCount: usize
    others: usize
    // How long the last wait took (microseconds) and the temperature
    // before the step.
    waited: usize
    before: usize
    // D1 failed with copy engine 0 not reading its ring and no fault (the
    // case for which Linux's order is tried, gpu_compute.mlx).
    unread: bool
}

// ---- Reaching the card.

fn rd(e: *engines.Engines, number: usize) -> usize {
    const read = e.*.hands.read
    return @intCast(usize, read(number))
}

fn wr(e: *engines.Engines, number: usize, value: usize) -> void {
    const write = e.*.hands.write
    write(number, @intCast(u32, value & 0xFFFFFFFF))
}

fn say(e: *engines.Engines, text: []const u8) -> void {
    const write = e.*.hands.say
    write(text)
}

fn now(e: *engines.Engines) -> usize {
    const clock = e.*.hands.now
    return clock()
}

fn pause(e: *engines.Engines, microseconds: usize) -> void {
    const wait = e.*.hands.pause
    wait(microseconds)
}

fn aside(e: *engines.Engines, on: bool) -> void {
    const put = e.*.hands.aside
    put(on)
}

fn memoryRead(e: *engines.Engines, physical: usize) -> usize {
    const read = e.*.hands.memoryRead
    return @intCast(usize, read(physical))
}

fn memoryWrite(l: *Loaded, physical: usize, value: usize) -> void {
    const write = l.*.more.memoryWrite
    write(physical, @intCast(u32, value & 0xFFFFFFFF))
}

fn vramRead(e: *engines.Engines, offset: usize) -> usize {
    const read = e.*.hands.vramRead
    return read(offset)
}

fn vramWrite(e: *engines.Engines, offset: usize, value: usize) -> void {
    const write = e.*.hands.vramWrite
    write(offset, value)
}

fn dma(e: *engines.Engines, bytes: usize) -> usize {
    const allocate = e.*.hands.dma
    return allocate(bytes)
}

// A field's value placed by its mask, and read by it.
fn field(mask: usize, value: usize) -> usize {
    var shift: usize = 0
    while shift < 32 && (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (value << @intCast(u6, shift)) & mask
}

fn get(value: usize, mask: usize) -> usize {
    var shift: usize = 0
    while shift < 32 && (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (value & mask) >> @intCast(u6, shift)
}

fn le(bytes: []const u8, at: usize) -> usize {
    if at + 4 > bytes.length { return 0 }
    return @intCast(usize, bytes[at]) | (@intCast(usize, bytes[at + 1]) << 8) | (@intCast(usize, bytes[at + 2]) << 16) | (@intCast(usize, bytes[at + 3]) << 24)
}

// A register written by a step: what it held kept first (the way back).
fn put(e: *engines.Engines, l: *Loaded, number: usize, value: usize) -> void {
    if l.*.count >= KEPT {
        l.*.full = true
        wr(e, number, value)
        return
    }
    l.*.register[l.*.count] = number
    l.*.value[l.*.count] = rd(e, number)
    l.*.count += 1
    wr(e, number, value)
}

// The registers the steps wrote put back as they were, last first, down
// to `mark`; how many. Only the copy engines' halt words keep the halt the
// way back gave them: put back as they were (engine 0 ran before D2, the
// SMC may have left an engine unhalted before D1) they would let an engine
// run again, its ring on, in the middle of the way back, and the step's
// line says the engines are halted.
fn putBack(e: *engines.Engines, l: *Loaded, mark: usize) -> usize {
    var count: usize = 0
    while l.*.count > mark {
        l.*.count -= 1
        const number = l.*.register[l.*.count]
        var value = l.*.value[l.*.count]
        if number == engines.SDMA0_F32_CNTL || number == engines.SDMA1_F32_CNTL { value |= engines.SDMA0_F32_CNTL__HALT }
        wr(e, number, value)
        count += 1
    }
    return count
}

// A word of the SMC's (vi_smc_rreg, vi_smc_wreg: the index, then the
// data), a field of one written as PHM_WRITE_VFPF_INDIRECT_FIELD writes
// it (read, then written whole), a field of an ordinary register likewise
// (PHM_WRITE_FIELD).
fn smcRead(e: *engines.Engines, address: usize) -> usize {
    wr(e, engines.SMC_IND_INDEX_11, address)
    return rd(e, engines.SMC_IND_DATA_11)
}

fn smcWrite(e: *engines.Engines, address: usize, value: usize) -> void {
    wr(e, engines.SMC_IND_INDEX_11, address)
    wr(e, engines.SMC_IND_DATA_11, value)
}

fn smcField(e: *engines.Engines, address: usize, mask: usize, value: usize) -> void {
    const was = smcRead(e, address)
    smcWrite(e, address, (was & ~mask) | field(mask, value))
}

fn regField(e: *engines.Engines, number: usize, mask: usize, value: usize) -> void { wr(e, number, (rd(e, number) & ~mask) | field(mask, value)) }

// A word of the SMC's RAM (smu7_read_smc_sram_dword: the index, the auto
// increment off, the data).
fn sram(e: *engines.Engines, address: usize) -> usize {
    wr(e, engines.SMC_IND_INDEX_11, address)
    regField(e, SMC_IND_ACCESS_CNTL, SMC_IND_ACCESS_CNTL__AUTO_INCREMENT_IND_11, 0)
    return rd(e, engines.SMC_IND_DATA_11)
}

// Linux's wait on a word of the SMC's (phm_wait_on_indirect_register and
// its "unequal" twin): the index written once, the data looked at every
// microsecond, a million times at most. Whether it came; the last value
// read in `last`.
fn smcWait(e: *engines.Engines, address: usize, mask: usize, value: usize, equal: bool, last: *usize) -> bool {
    wr(e, engines.SMC_IND_INDEX_11, address)
    var k: usize = 0
    while k < AMD_MAX_USEC_TIMEOUT {
        const read = rd(e, engines.SMC_IND_DATA_11)
        last.* = read
        if (read & mask == value & mask) == equal { return true }
        pause(e, 1)
        k += 1
    }
    return false
}

// The SMC's answer register not 0 (PHM_WAIT_FIELD_UNEQUAL on SMC_RESP_0),
// a million looks at most.
fn answered(e: *engines.Engines) -> bool {
    var k: usize = 0
    while k < AMD_MAX_USEC_TIMEOUT {
        if rd(e, SMC_RESP_0) & SMC_RESP_0__SMC_RESP != 0 { return true }
        pause(e, 1)
        k += 1
    }
    return false
}

// A message with its parameter, as smu7_send_msg_to_smc_with_parameter
// and smu7_send_msg_to_smc send it: the earlier answer waited for (twice,
// as Linux's two functions each wait), the parameter, the answer cleared,
// the message, the answer waited for. Its answer (0: none came); whether
// the wait for the earlier answer ran out goes to `l.ranOut`.
fn message(e: *engines.Engines, l: *Loaded, number: usize, parameter: usize) -> usize {
    l.*.ranOut = !answered(e)
    wr(e, SMC_MSG_ARG_0, parameter)
    _ = answered(e)
    _ = rd(e, SMC_RESP_0)
    wr(e, SMC_RESP_0, 0)
    wr(e, SMC_MESSAGE_0, number)
    if !answered(e) { return 0 }
    return rd(e, SMC_RESP_0) & SMC_RESP_0__SMC_RESP
}

// The card's temperature in degrees (smu7_thermal_get_temperature:
// CG_MULT_THERMAL_STATUS's CTF_TEMP; the index is the caller's to put back).
pub fn temperature(e: *engines.Engines) -> usize { return get(smcRead(e, engines.ixCG_MULT_THERMAL_STATUS), engines.CG_MULT_THERMAL_STATUS__CTF_TEMP) }

// ---- The log's words.

fn decimal(e: *engines.Engines, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(e, digits[at..20])
}

fn hex(e: *engines.Engines, value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(e, text[0..2 + digits])
}

fn num(e: *engines.Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    decimal(e, value)
}

fn word(e: *engines.Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    hex(e, value)
}

// "; 41 C before, 41 C after" in a step's line.
fn degrees(e: *engines.Engines, l: *Loaded, after: usize) -> void {
    num(e, "; ", l.*.before)
    num(e, " C before, ", after)
    say(e, " C after")
}

// " (12 ms)" after a step's line.
fn took(e: *engines.Engines) -> void {
    num(e, " (", (now(e) - e.*.began) / 1000000)
    say(e, " ms)\n")
}

// A step not begun at the mark: said, and whether it may begin.
fn cool(e: *engines.Engines, l: *Loaded, step: []const u8) -> bool {
    const index = rd(e, engines.SMC_IND_INDEX_11)
    l.*.before = temperature(e)
    wr(e, engines.SMC_IND_INDEX_11, index)
    if l.*.before < MARK { return true }
    say(e, "gpu: step ")
    say(e, step)
    num(e, " refused: the card is at ", l.*.before)
    num(e, " C (no step begins at ", MARK)
    say(e, " C or more)\n")
    return false
}

// ---- The start.

// The record anew (nothing tried yet).
pub fn begin(l: *Loaded, more: *const More) -> void {
    l.*.more = more.*
    l.*.f1 = engines.Outcome.not_tried
    l.*.f2 = engines.Outcome.not_tried
    l.*.d1 = engines.Outcome.not_tried
    l.*.d2 = engines.Outcome.not_tried
    l.*.count = 0
    l.*.full = false
    l.*.running = false
    l.*.uploaded = false
    l.*.protectedMode = false
    l.*.trigger = 0
    l.*.ranOut = false
    l.*.words = 0
    l.*.status = 0
    l.*.flags = 0
    l.*.counter[0] = 0
    l.*.counter[1] = 0
    l.*.versionWord = 0
    l.*.softRegisters = 0
    l.*.loadStatus = 0
    l.*.copies = 0
    l.*.writeBack = 0
    l.*.ring[0] = 0
    l.*.ring[1] = 0
    l.*.wptr[0] = 0
    l.*.wptr[1] = 0
    l.*.fences[0] = 0
    l.*.fences[1] = 0
    l.*.burst[0] = false
    l.*.burst[1] = false
    l.*.up[0] = false
    l.*.up[1] = false
    l.*.doorbellsOn = false
    l.*.buffers = 0
    l.*.source = 0
    l.*.target = 0
    l.*.trapCount = 0
    l.*.others = 0
    l.*.waited = 0
    l.*.before = 0
    l.*.unread = false
}

// The SMC's firmware file as the card's key names it (S0 chose it), its
// payload.
fn smcFile(e: *engines.Engines) -> []const u8 {
    const file = e.*.hands.file
    return file(e.*.found.smcFile)
}

fn payloadOf(bytes: []const u8) -> []const u8 {
    const size = le(bytes, engines.HEADER__ucode_size_bytes)
    const at = le(bytes, engines.HEADER__ucode_array_offset_bytes)
    if bytes.length < engines.HEADER__size || at + size > bytes.length { return bytes[0..0] }
    return bytes[at..at + size]
}

// ---- F1: the SMC's firmware.

// The payload into the SMC's RAM (smu7_upload_smc_firmware_data): the
// index at 0x20000, the auto increment on, each 32-bit word of the file as
// it is, the auto increment off.
fn upload(e: *engines.Engines, l: *Loaded, payload: []const u8) -> void {
    wr(e, engines.SMC_IND_INDEX_11, SMU7_FIRMWARE_HEADER_LOCATION)
    regField(e, SMC_IND_ACCESS_CNTL, SMC_IND_ACCESS_CNTL__AUTO_INCREMENT_IND_11, 1)
    var at: usize = 0
    while at + 4 <= payload.length {
        wr(e, engines.SMC_IND_DATA_11, le(payload, at))
        at += 4
    }
    regField(e, SMC_IND_ACCESS_CNTL, SMC_IND_ACCESS_CNTL__AUTO_INCREMENT_IND_11, 0)
    l.*.words = payload.length / 4
    l.*.uploaded = true
}

// F1. Whether it passed.
pub fn smcFirmware(e: *engines.Engines, l: *Loaded) -> bool {
    e.*.began = now(e)
    const f = &e.*.found
    const bytes = smcFile(e)
    const payload = payloadOf(bytes)
    if f.*.files[engines.FILES.length].holds != engines.Holds.yes || payload.length < 64 {
        l.*.f1 = engines.Outcome.refused
        say(e, "gpu: step F1 refused: the SMC's firmware file ")
        say(e, f.*.smcFile)
        say(e, " does not hold (step S0 says why)\n")
        return false
    }
    if le(bytes, SMC_HEADER__ucode_start_addr) != SMU7_FIRMWARE_HEADER_LOCATION {
        l.*.f1 = engines.Outcome.refused
        say(e, "gpu: step F1 refused: ")
        say(e, f.*.smcFile)
        word(e, " is made for the SMC's address ", le(bytes, SMC_HEADER__ucode_start_addr))
        word(e, ", Linux puts it at ", SMU7_FIRMWARE_HEADER_LOCATION)
        say(e, "\n")
        return false
    }
    if !cool(e, l, "F1") {
        l.*.f1 = engines.Outcome.refused
        return false
    }
    l.*.payloadVersion = le(payload, SMU74_Firmware_Header__Version)
    l.*.payloadSoftRegisters = le(payload, SMU74_Firmware_Header__SoftRegisters)
    l.*.headerVersion = le(bytes, engines.HEADER__ucode_version)
    const index = rd(e, engines.SMC_IND_INDEX_11)
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)

    // polaris10_start_smu: only an SMC whose RAM does not run is started
    // (smu7_is_smc_ram_running: its clock on and its program counter in
    // RAM); its mode and key read.
    var why: []const u8 = ""
    var value: usize = NONE
    l.*.running = smcRead(e, engines.ixSMC_SYSCON_CLOCK_CNTL_0) & engines.SMC_SYSCON_CLOCK_CNTL_0__ck_disable == 0 && smcRead(e, engines.ixSMC_PC_C) >= engines.SMC_RAM_RUNNING
    if !l.*.running {
        l.*.protectedMode = get(smcRead(e, engines.ixSMU_FIRMWARE), engines.SMU_FIRMWARE__SMU_MODE) != 0
        _ = smcRead(e, engines.ixSMU_FIRMWARE)
        var last: usize = 0
        if l.*.protectedMode {
            // polaris10_start_smu_in_protection_mode, in its order.
            smcField(e, engines.ixSMC_SYSCON_RESET_CNTL, engines.SMC_SYSCON_RESET_CNTL__rst_reg, 1)
            upload(e, l, payload)
            smcWrite(e, engines.ixSMU_STATUS, 0)
            smcField(e, engines.ixSMC_SYSCON_CLOCK_CNTL_0, engines.SMC_SYSCON_CLOCK_CNTL_0__ck_disable, 0)
            smcField(e, engines.ixSMC_SYSCON_RESET_CNTL, engines.SMC_SYSCON_RESET_CNTL__rst_reg, 0)
            if !smcWait(e, engines.ixRCU_UC_EVENTS, engines.RCU_UC_EVENTS__INTERRUPTS_ENABLED, engines.RCU_UC_EVENTS__INTERRUPTS_ENABLED, true, &last) {
                word(e, "gpu: the SMC's ROM did not say its interrupts are on within 1 s (events ", last)
                say(e, "): Linux goes on, so does the step\n")
            }
            // The start's trigger: its answer said, not judged (Linux does
            // not look at it).
            l.*.trigger = message(e, l, PPSMC_MSG_Test, TEST_TRIGGER)
            word(e, "gpu: the start's trigger (message ", PPSMC_MSG_Test)
            word(e, " with ", TEST_TRIGGER)
            word(e, ") answered ", l.*.trigger)
            say(e, if l.*.ranOut { "; the SMC had answered nothing before it (1 s waited for that, twice, as Linux waits)\n" } else { "\n" })
            if !smcWait(e, engines.ixSMU_STATUS, SMU_STATUS__SMU_DONE, 0, false, &last) {
                why = "the SMC did not end its start within 1 s (status "
                value = last
            }
            l.*.status = smcRead(e, engines.ixSMU_STATUS)
            if why.length == 0 && l.*.status & SMU_STATUS__SMU_PASS == 0 {
                why = "the card did not take the image (status "
                value = l.*.status
            }
            if why.length == 0 {
                smcWrite(e, engines.ixFIRMWARE_FLAGS, 0)
                smcField(e, engines.ixSMC_SYSCON_RESET_CNTL, engines.SMC_SYSCON_RESET_CNTL__rst_reg, 1)
                smcField(e, engines.ixSMC_SYSCON_RESET_CNTL, engines.SMC_SYSCON_RESET_CNTL__rst_reg, 0)
                if !smcWait(e, engines.ixFIRMWARE_FLAGS, engines.FIRMWARE_FLAGS__INTERRUPTS_ENABLED, engines.FIRMWARE_FLAGS__INTERRUPTS_ENABLED, true, &last) {
                    why = "the firmware did not say its interrupts are on within 1 s (flags "
                    value = last
                }
            }
        } else {
            // polaris10_start_smu_in_non_protection_mode, in its order.
            if !smcWait(e, engines.ixRCU_UC_EVENTS, engines.RCU_UC_EVENTS__boot_seq_done, 0, false, &last) {
                word(e, "gpu: the SMC's ROM did not say its start is done within 1 s (events ", last)
                say(e, "): Linux goes on, so does the step\n")
            }
            smcWrite(e, engines.ixFIRMWARE_FLAGS, 0)
            smcField(e, engines.ixSMC_SYSCON_RESET_CNTL, engines.SMC_SYSCON_RESET_CNTL__rst_reg, 1)
            upload(e, l, payload)
            wr(e, engines.SMC_IND_INDEX_11, 0)
            regField(e, SMC_IND_ACCESS_CNTL, SMC_IND_ACCESS_CNTL__AUTO_INCREMENT_IND_11, 0)
            wr(e, engines.SMC_IND_DATA_11, JUMP_ON_START)
            smcField(e, engines.ixSMC_SYSCON_CLOCK_CNTL_0, engines.SMC_SYSCON_CLOCK_CNTL_0__ck_disable, 0)
            smcField(e, engines.ixSMC_SYSCON_RESET_CNTL, engines.SMC_SYSCON_RESET_CNTL__rst_reg, 0)
            if !smcWait(e, engines.ixFIRMWARE_FLAGS, engines.FIRMWARE_FLAGS__INTERRUPTS_ENABLED, engines.FIRMWARE_FLAGS__INTERRUPTS_ENABLED, true, &last) {
                why = "the firmware did not say its interrupts are on within 1 s (flags "
                value = last
            }
        }
    }

    // The self-test (the study's 3.3, "what proves the SMC runs"): its
    // clock on, its program counter in RAM, its firmware's flag, the version
    // word in its RAM the uploaded payload's word 5. Whether the counter
    // moves is looked at and said, not judged: Linux's test of a running
    // SMC (smu7_is_smc_ram_running) asks only for the clock and the counter
    // in RAM, and a firmware waiting for its next message may stand at one
    // place.
    if why.length == 0 {
        const clockWord = smcRead(e, engines.ixSMC_SYSCON_CLOCK_CNTL_0)
        l.*.counter[0] = smcRead(e, engines.ixSMC_PC_C)
        l.*.counter[1] = smcRead(e, engines.ixSMC_PC_C)
        // (A firmware that waits may stay at one place a while: looked at
        // again, every 10 microseconds, a millisecond at most.)
        var looks: usize = 0
        while l.*.counter[1] == l.*.counter[0] && looks < 100 {
            pause(e, 10)
            l.*.counter[1] = smcRead(e, engines.ixSMC_PC_C)
            looks += 1
        }
        l.*.flags = smcRead(e, engines.ixFIRMWARE_FLAGS)
        l.*.versionWord = sram(e, SMU7_FIRMWARE_HEADER_LOCATION + SMU74_Firmware_Header__Version)
        if clockWord & engines.SMC_SYSCON_CLOCK_CNTL_0__ck_disable != 0 {
            why = "the SMC's clock is off (clock control "
            value = clockWord
        } else if l.*.counter[1] < engines.SMC_RAM_RUNNING {
            why = "the SMC's program counter is not in its RAM ("
            value = l.*.counter[1]
        } else if l.*.flags & engines.FIRMWARE_FLAGS__INTERRUPTS_ENABLED == 0 {
            why = "the firmware's flags say its interrupts are off ("
            value = l.*.flags
        } else if !l.*.running && l.*.versionWord != l.*.payloadVersion {
            why = "the version word in the SMC's RAM is not the uploaded one ("
            value = l.*.versionWord
        }
    }
    const after = temperature(e)
    wr(e, engines.SMC_IND_INDEX_11, index)
    const living = engines.alive(e, "F1")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    if (why.length != 0 || minded != engines.Change.none) && !l.*.running {
        // The way back: the SMC held in reset (its clock on), the state
        // Linux's own start passes through.
        smcField(e, engines.ixSMC_SYSCON_RESET_CNTL, engines.SMC_SYSCON_RESET_CNTL__rst_reg, 1)
        wr(e, engines.SMC_IND_INDEX_11, index)
    }
    aside(e, false)
    if why.length != 0 || minded != engines.Change.none {
        l.*.f1 = engines.Outcome.failed
        say(e, "gpu: step F1 failed: ")
        if !living {
            say(e, why)
        } else if why.length != 0 {
            say(e, why)
            if value != NONE {
                hex(e, value)
                say(e, ")")
            }
        } else {
            engines.sayChange(e, minded, &before, &later)
        }
        if l.*.running {
            say(e, "; the SMC was found running and is left so")
        } else {
            say(e, "; the SMC is held in reset")
        }
        degrees(e, l, after)
        took(e)
        return false
    }
    l.*.f1 = engines.Outcome.passed
    if l.*.running {
        say(e, "gpu: step F1: the SMC runs firmware already (found running): nothing uploaded, no trigger sent; program counter ")
    } else {
        say(e, "gpu: step F1: SMC firmware ")
        say(e, f.*.smcFile)
        num(e, " uploaded (", l.*.words)
        if l.*.protectedMode {
            say(e, " words, protected mode), start passed (status ")
            hex(e, l.*.status)
            word(e, ", trigger answered ", l.*.trigger)
            say(e, ")")
        } else {
            say(e, " words, not protected), started from the jump word at 0")
        }
        say(e, ", interrupts enabled; program counter ")
    }
    hex(e, l.*.counter[0])
    word(e, " then ", l.*.counter[1])
    if l.*.counter[0] == l.*.counter[1] { say(e, " (it stood for 1 ms: the firmware may wait; Linux asks only that it is in RAM)") }
    word(e, ", version word in RAM ", l.*.versionWord)
    if l.*.running {
        say(e, if l.*.versionWord == l.*.payloadVersion { " (the same as " } else { " (NOT the same as " })
        say(e, f.*.smcFile)
        word(e, "'s ", l.*.payloadVersion)
        say(e, ")")
    } else {
        word(e, " as uploaded (the file's header says ", l.*.headerVersion)
        say(e, ")")
    }
    degrees(e, l, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// ---- F2: the engines' firmware.

// Where each copy lies from the copies' start (amdgpu_ucode_init_bo: each
// on a page, MEC's jump table on the page after MEC, MEC2's room after
// that), by FILES' index, and how many bytes they take in all.
fn up(bytes: usize) -> usize { return (bytes + 4095) / 4096 * 4096 }

fn places(e: *engines.Engines, into: *[8]usize, jumpTable: *usize) -> usize {
    const file = e.*.hands.file
    var at: usize = 0
    for k in COPY_ORDER {
        const bytes = file(engines.FILES[k])
        const size = le(bytes, engines.HEADER__ucode_size_bytes)
        into.*[k] = at
        if k == engines.MEC_FILE {
            jumpTable.* = at + up(size)
            at += up(le(bytes, engines.GFX_HEADER__jt_size) * 4)
            at += up(size)
            // MEC2's room: its file is not copied (the SMC is not told of
            // it), its place is kept as Linux's.
            at += up(size)
        } else {
            at += up(size)
        }
    }
    return at
}

// The copies written into the system's memory: each payload as it is,
// MEC's jump table once more on its own page (amdgpu_ucode_patch_jt).
fn copyFirmware(e: *engines.Engines, l: *Loaded, at: *const [8]usize, jumpTable: usize) -> void {
    const file = e.*.hands.file
    for k in COPY_ORDER {
        const bytes = file(engines.FILES[k])
        const payload = payloadOf(bytes)
        var n: usize = 0
        while n + 4 <= payload.length {
            memoryWrite(l, l.*.copies + at.*[k] + n, le(payload, n))
            n += 4
        }
        if k == engines.MEC_FILE {
            const first = le(bytes, engines.GFX_HEADER__jt_offset) * 4
            const count = le(bytes, engines.GFX_HEADER__jt_size) * 4
            n = 0
            while n + 4 <= count {
                memoryWrite(l, l.*.copies + jumpTable + n, le(payload, first + n))
                n += 4
            }
        }
    }
}

// The card address of a piece of the dma memory: through the GART, whose
// first entries map the piece page for page (gpu_engines.mlx's M2).
fn gartAddress(e: *engines.Engines, physical: usize) -> usize { return e.*.found.gartStart + physical - e.*.card.dmaBase }

// The list (struct SMU_DRAMData_TOC) as its 32-bit words: the version, the
// entries' count, the nine entries as smu7_populate_single_firmware_entry
// fills them, the rest 0.
fn list(e: *engines.Engines, l: *Loaded, at: *const [8]usize, jumpTable: usize, into: *[86]usize) -> void {
    const file = e.*.hands.file
    var k: usize = 0
    while k < SMU_DRAMData_TOC__size / 4 {
        into.*[k] = 0
        k += 1
    }
    into.*[0] = SMU_DRAMData_TOC_VERSION
    into.*[1] = LIST_KINDS.length
    k = 0
    while k < LIST_KINDS.length {
        const kind = LIST_KINDS[k]
        const index = LIST_FILES[k]
        const bytes = file(engines.FILES[index])
        var address = gartAddress(e, l.*.copies + at.*[index])
        var size = le(bytes, engines.HEADER__ucode_size_bytes)
        if kind == UCODE_ID_CP_MEC { size = le(bytes, engines.GFX_HEADER__jt_offset) * 4 }
        if kind == UCODE_ID_CP_MEC_JT1 || kind == UCODE_ID_CP_MEC_JT2 {
            address = gartAddress(e, l.*.copies + jumpTable)
            size = le(bytes, engines.GFX_HEADER__jt_size) * 4
        }
        const flags = if kind == UCODE_ID_RLC_G || kind == UCODE_ID_CP_MEC { UCODE_FLAG_UNHALT_MASK } else { 0 }
        const w = 2 + k * SMU_Entry__size / 4
        into.*[w] = kind | ((le(bytes, engines.HEADER__ucode_version) & 0xFFFF) << 16)
        into.*[w + 1] = address >> 32
        into.*[w + 2] = address & 0xFFFFFFFF
        into.*[w + 5] = size
        into.*[w + 6] = flags
        k += 1
    }
}

// The engines into the state Linux's own stop leaves them in (the study's
// F2, corrected): the graphics processors halted (gfx_v8_0_cp_gfx_enable,
// _cp_compute_enable, 50 us after each), the RLC stopped
// (gfx_v8_0_rlc_stop: its enable cleared, the four idle interrupts off,
// its serial buses waited for per shader engine and array, the selector
// back to all), the copy engines halted when `copy` (sdma_v3_0_hw_fini).
fn haltEngines(e: *engines.Engines, l: *Loaded, copy: bool) -> void {
    wr(e, engines.CP_ME_CNTL, rd(e, engines.CP_ME_CNTL) | engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT)
    pause(e, 50)
    wr(e, engines.CP_MEC_CNTL, engines.CP_MEC_CNTL__MEC_ME1_HALT | engines.CP_MEC_CNTL__MEC_ME2_HALT)
    pause(e, 50)
    regField(e, engines.RLC_CNTL, engines.RLC_CNTL__RLC_ENABLE_F32, 0)
    const idle = CP_INT_CNTL_RING0__CNTX_BUSY_INT_ENABLE | CP_INT_CNTL_RING0__CNTX_EMPTY_INT_ENABLE | CP_INT_CNTL_RING0__CMP_BUSY_INT_ENABLE | CP_INT_CNTL_RING0__GFX_IDLE_INT_ENABLE
    wr(e, CP_INT_CNTL_RING0, rd(e, CP_INT_CNTL_RING0) & ~idle)
    const f = &e.*.found
    var gone = false
    var se: usize = 0
    while se < f.*.gfx[2] && !gone {
        var sh: usize = 0
        while sh < f.*.gfx[5] && !gone {
            wr(e, GRBM_GFX_INDEX, GRBM_GFX_INDEX__INSTANCE_BROADCAST_WRITES | field(GRBM_GFX_INDEX__SE_INDEX, se) | field(GRBM_GFX_INDEX__SH_INDEX, sh))
            var k: usize = 0
            while k < engines.AMDGPU_MAX_USEC_TIMEOUT && rd(e, RLC_SERDES_CU_MASTER_BUSY) != 0 {
                pause(e, 1)
                k += 1
            }
            if k >= engines.AMDGPU_MAX_USEC_TIMEOUT {
                num(e, "gpu: the RLC's serial bus of shader engine ", se)
                num(e, ", array ", sh)
                say(e, " stayed busy for 100 ms: Linux goes on, so does the step\n")
                gone = true
            }
            sh += 1
        }
        se += 1
    }
    wr(e, GRBM_GFX_INDEX, GRBM_GFX_INDEX__SE_BROADCAST_WRITES | GRBM_GFX_INDEX__INSTANCE_BROADCAST_WRITES | GRBM_GFX_INDEX__SH_BROADCAST_WRITES)
    if !gone {
        const busy = RLC_SERDES_NONCU_MASTER_BUSY__SE_MASTER_BUSY | RLC_SERDES_NONCU_MASTER_BUSY__GC_MASTER_BUSY | RLC_SERDES_NONCU_MASTER_BUSY__TC0_MASTER_BUSY | RLC_SERDES_NONCU_MASTER_BUSY__TC1_MASTER_BUSY
        var k: usize = 0
        while k < engines.AMDGPU_MAX_USEC_TIMEOUT && rd(e, RLC_SERDES_NONCU_MASTER_BUSY) & busy != 0 {
            pause(e, 1)
            k += 1
        }
    }
    if copy { copyStop(e, l, 0, 2) }
}

// F2. Whether it passed.
pub fn engineFirmware(e: *engines.Engines, l: *Loaded) -> bool {
    e.*.began = now(e)
    const f = &e.*.found
    var k: usize = 0
    while k < engines.FILES.length {
        if f.*.files[k].holds != engines.Holds.yes {
            l.*.f2 = engines.Outcome.refused
            say(e, "gpu: step F2 refused: the firmware file ")
            say(e, engines.FILES[k])
            say(e, " does not hold (step S0 says why)\n")
            return false
        }
        k += 1
    }
    if !f.*.gfxFound || f.*.gfx[2] == 0 || f.*.gfx[5] == 0 {
        l.*.f2 = engines.Outcome.refused
        say(e, "gpu: step F2 refused: the card's ROM does not say how many shader engines it has (GFX_Info): the RLC the SMC starts could not be stopped as Linux stops it\n")
        return false
    }
    var at: [8]usize = undefined
    var jumpTable: usize = 0
    const bytes = places(e, &at, &jumpTable)
    if e.*.limit + SMU_BUFFER_AT + SMU_BUFFER_BYTES > e.*.card.view {
        l.*.f2 = engines.Outcome.refused
        say(e, "gpu: step F2 refused: the driver's part of the aperture has no room for the SMC's list and working memory\n")
        return false
    }
    if !cool(e, l, "F2") {
        l.*.f2 = engines.Outcome.refused
        return false
    }
    l.*.copies = dma(e, bytes)
    if l.*.copies == 0 || l.*.copies + bytes > e.*.card.dmaBase + engines.DMA_PAGES * engines.AMDGPU_GPU_PAGE_SIZE {
        l.*.f2 = engines.Outcome.refused
        l.*.copies = 0
        say(e, "gpu: step F2 refused: no room for the firmware's copies in the memory set aside for the card\n")
        return false
    }
    // The soft registers' place, read from the SMC's RAM as Linux reads it
    // (polaris10_start_smu's last words) and held against the file's.
    const index = rd(e, engines.SMC_IND_INDEX_11)
    l.*.softRegisters = sram(e, SMU7_FIRMWARE_HEADER_LOCATION + SMU74_Firmware_Header__SoftRegisters)
    const fromFile = le(payloadOf(smcFile(e)), SMU74_Firmware_Header__SoftRegisters)
    if l.*.softRegisters != fromFile || l.*.softRegisters < SMU7_FIRMWARE_HEADER_LOCATION || l.*.softRegisters + SMU74_SoftRegisters__UcodeLoadStatus + 4 > SMC_RAM_END {
        wr(e, engines.SMC_IND_INDEX_11, index)
        l.*.f2 = engines.Outcome.refused
        word(e, "gpu: step F2 refused: the SMC's RAM says its soft registers are at ", l.*.softRegisters)
        say(e, ", ")
        say(e, f.*.smcFile)
        word(e, " says ", fromFile)
        say(e, ": nothing is asked of it\n")
        return false
    }
    const status = l.*.softRegisters + SMU74_SoftRegisters__UcodeLoadStatus
    const listAt = e.*.limit + LIST_AT
    const bufferAt = e.*.limit + SMU_BUFFER_AT
    const listAddress = f.*.vramStart + listAt
    const bufferAddress = f.*.vramStart + bufferAt
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)
    const was = [_]usize{ rd(e, engines.CP_ME_CNTL), rd(e, engines.CP_MEC_CNTL), rd(e, engines.RLC_CNTL) }

    // smu7_request_smu_load_fw, in its order: the copies
    // (amdgpu_ucode_init_bo), the load status cleared, the working
    // memory's address, the list, its address, LoadUcodes, the wait.
    copyFirmware(e, l, &at, jumpTable)
    @fence(seq_cst)
    smcWrite(e, status, 0)
    var why: []const u8 = ""
    var asked: usize = 0
    var answer: usize = PPSMC_Result_OK
    const messages = [_]usize{ PPSMC_MSG_SMU_DRAM_ADDR_HI, PPSMC_MSG_SMU_DRAM_ADDR_LO, PPSMC_MSG_DRV_DRAM_ADDR_HI, PPSMC_MSG_DRV_DRAM_ADDR_LO, PPSMC_MSG_LoadUcodes }
    const parameters = [_]usize{ bufferAddress >> 32, bufferAddress & 0xFFFFFFFF, listAddress >> 32, listAddress & 0xFFFFFFFF, LOAD_MASK }
    var m: usize = 0
    while m < messages.length && why.length == 0 {
        if m == 2 {
            // The list into its page of the card's memory, and (ours: Linux
            // copies it and goes on) the host path flushed so that what the
            // processor wrote is in the card's memory before the SMC reads
            // it (vi_flush_hdp: written and read back).
            var words: [86]usize = undefined
            list(e, l, &at, jumpTable, &words)
            var w: usize = 0
            while w < SMU_DRAMData_TOC__size / 4 {
                vramWrite(e, listAt + w * 4, words[w] | (words[w + 1] << 32))
                w += 2
            }
            @fence(seq_cst)
            wr(e, engines.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
            _ = rd(e, engines.HDP_MEM_COHERENCY_FLUSH_CNTL)
        }
        answer = message(e, l, messages[m], parameters[m])
        if answer != PPSMC_Result_OK {
            why = "the SMC answered "
            asked = messages[m]
        }
        m += 1
    }
    var last: usize = 0
    var short = false
    const started = now(e)
    if why.length == 0 {
        // smu7_check_fw_load_finish: the status word's index written once,
        // the data looked at every microsecond, a million times at most.
        _ = smcWait(e, status, LOAD_MASK, LOAD_MASK, true, &last)
        l.*.loadStatus = last
        l.*.waited = (now(e) - started) / 1000
        if l.*.loadStatus & LOAD_MASK != LOAD_MASK {
            why = "the SMC did not load every engine"
            short = true
        }
    }
    const faultStatus = rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS)
    const faultPage = rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR)
    if why.length == 0 && (faultStatus != 0 || faultPage != 0) { why = "a fault in address space 0" }
    l.*.left[0] = rd(e, engines.CP_ME_CNTL)
    l.*.left[1] = rd(e, engines.CP_MEC_CNTL)
    l.*.left[2] = rd(e, engines.RLC_CNTL)
    // The engines the SMC unhalted halted again at every boot (the study's
    // F2; stage 5 starts them from there as Linux starts a stopped block:
    // gpu_compute.mlx's head says why); the copy engines too unless stage 4
    // follows; and all of them on a failure.
    const haltedNow = true
    haltEngines(e, l, e.*.stage < 4 || why.length != 0)
    l.*.halted[0] = rd(e, engines.CP_ME_CNTL)
    l.*.halted[1] = rd(e, engines.CP_MEC_CNTL)
    l.*.halted[2] = rd(e, engines.RLC_CNTL)
    const after = temperature(e)
    wr(e, engines.SMC_IND_INDEX_11, index)
    const living = engines.alive(e, "F2")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    if (why.length != 0 || minded != engines.Change.none) && !haltedNow {
        haltEngines(e, l, true)
        l.*.halted[0] = rd(e, engines.CP_ME_CNTL)
        l.*.halted[1] = rd(e, engines.CP_MEC_CNTL)
        l.*.halted[2] = rd(e, engines.RLC_CNTL)
    } else if (why.length != 0 || minded != engines.Change.none) && e.*.stage >= 4 {
        copyStop(e, l, 0, 2)
    }
    aside(e, false)
    if why.length != 0 || minded != engines.Change.none {
        l.*.f2 = engines.Outcome.failed
        say(e, "gpu: step F2 failed: ")
        if !living {
            say(e, why)
        } else if why.length == 0 {
            engines.sayChange(e, minded, &before, &later)
        } else if asked != 0 {
            say(e, why)
            word(e, "", answer)
            word(e, " to message ", asked)
            say(e, if answer == 0 { " (no answer within 1 s)" } else { "" })
        } else if short {
            sayLoaded(e, l.*.loadStatus)
            if faultStatus != 0 || faultPage != 0 {
                word(e, "; a fault in address space 0 at page ", faultPage)
                word(e, " (status ", faultStatus)
                say(e, ")")
            }
            if l.*.loadStatus & LOAD_MASK == 0 {
                word(e, "; the card's AVFS fuse is ", f.*.fuse & 1)
                say(e, if f.*.fuse & 1 != 0 { ": Linux writes its default levels into the SMC before LoadUcodes on such a card (the study's 10, item 7), the next thing to add" } else { ": the study names nothing further for this" })
            }
        } else {
            say(e, why)
            if faultStatus != 0 || faultPage != 0 {
                word(e, " at page ", faultPage)
                word(e, " (status ", faultStatus)
                say(e, ")")
            }
        }
        say(e, "; the engines halted again (ME ")
        hex(e, l.*.halted[0])
        word(e, ", MEC ", l.*.halted[1])
        word(e, ", RLC ", l.*.halted[2])
        say(e, ")")
        degrees(e, l, after)
        took(e)
        return false
    }
    l.*.f2 = engines.Outcome.passed
    say(e, "gpu: step F2: the SMC loaded")
    k = 0
    while k < LOAD_NAMES.length {
        say(e, if k == 0 { " " } else { ", " })
        say(e, LOAD_NAMES[k])
        word(e, " ", f.*.files[LOAD_FILES[k]].version)
        k += 1
    }
    word(e, " (load status ", l.*.loadStatus)
    num(e, ") after ", l.*.waited)
    say(e, " us, reading them through the GART; no fault; it left ME ")
    hex(e, l.*.left[0])
    word(e, ", MEC ", l.*.left[1])
    word(e, ", RLC ", l.*.left[2])
    word(e, " (before: ", was[0])
    word(e, ", ", was[1])
    word(e, ", ", was[2])
    say(e, ")")
    word(e, "; halted again: ME ", l.*.halted[0])
    word(e, ", MEC ", l.*.halted[1])
    word(e, ", RLC ", l.*.halted[2])
    if e.*.stage >= 5 { say(e, " (stage 5 starts them from there)") }
    degrees(e, l, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// "the SMC loaded only RLC, CE (load status 0x40c): not PFP, ..." for a
// status that lacks engines.
fn sayLoaded(e: *engines.Engines, status: usize) -> void {
    if status & LOAD_MASK == 0 {
        word(e, "the SMC loaded nothing within 1 s (load status ", status)
        say(e, ")")
        return
    }
    say(e, "the SMC loaded only")
    var items: usize = 0
    var k: usize = 0
    while k < LOAD_BITS.length {
        if status & LOAD_BITS[k] != 0 {
            say(e, if items == 0 { " " } else { ", " })
            say(e, LOAD_NAMES[k])
            items += 1
        }
        k += 1
    }
    word(e, " within 1 s (load status ", status)
    say(e, "): not")
    items = 0
    k = 0
    while k < LOAD_BITS.length {
        if status & LOAD_BITS[k] == 0 {
            say(e, if items == 0 { " " } else { ", " })
            say(e, LOAD_NAMES[k])
            items += 1
        }
        k += 1
    }
}

// ---- The copy engines.

fn offset(engine: usize) -> usize { return engine * SDMA1_REGISTER_OFFSET }

fn doorbellOf(engine: usize) -> usize { return if engine == 0 { AMDGPU_DOORBELL_sDMA_ENGINE0 } else { AMDGPU_DOORBELL_sDMA_ENGINE1 } }

// The write-back page's words of an engine (physical).
fn slot(l: *Loaded, engine: usize, which: usize) -> usize { return l.*.writeBack + engine * RECORD + which }

// A NOP's header covering `count` words (sdma_v3_0_ring_insert_nop and
// _pad_ib: only the first of a run, only on an engine whose firmware
// knows it).
pub fn burstNop(count: usize) -> usize { return SDMA_OP_NOP | ((count - 1) & SDMA_PKT_NOP_HEADER_count_mask) << @intCast(u6, SDMA_PKT_NOP_HEADER_count_shift) }

// The packets' header words (tonga_sdma_pkt_open.h's macros).
pub fn header(op: usize, subOp: usize) -> usize { return op | subOp << @intCast(u6, SDMA_PKT_HEADER_sub_op_shift) }

pub fn hdpFlushHeader() -> usize { return SDMA_OP_POLL_REGMEM | POLL_HDP_FLUSH << @intCast(u6, SDMA_PKT_POLL_REGMEM_HEADER_hdp_flush_shift) | POLL_FUNC_EQUAL << @intCast(u6, SDMA_PKT_POLL_REGMEM_HEADER_func_shift) }

pub fn pollRetry() -> usize { return POLL_RETRY_COUNT << @intCast(u6, SDMA_PKT_POLL_REGMEM_DW5_retry_count_shift) | POLL_INTERVAL }

pub fn registerWriteHeader() -> usize { return SDMA_OP_SRBM_WRITE | SRBM_WRITE_BYTES << @intCast(u6, SDMA_PKT_SRBM_WRITE_HEADER_byte_en_shift) }

// A word into an engine's ring at its write pointer (amdgpu_ring_write).
fn emit(l: *Loaded, engine: usize, value: usize) -> void {
    memoryWrite(l, l.*.ring[engine] + l.*.wptr[engine] * 4, value)
    l.*.wptr[engine] = (l.*.wptr[engine] + 1) & (SDMA_RING_BYTES / 4 - 1)
}

fn nops(l: *Loaded, engine: usize, count: usize) -> void {
    var k: usize = 0
    while k < count {
        emit(l, engine, if l.*.burst[engine] && k == 0 { burstNop(count) } else { SDMA_OP_NOP })
        k += 1
    }
}

// The write pointer told (sdma_v3_0_ring_set_wptr: in bytes; by its slot
// and doorbell, or by the register).
fn tell(e: *engines.Engines, l: *Loaded, engine: usize) -> void {
    const bytes = l.*.wptr[engine] << 2
    if l.*.doorbellsOn {
        memoryWrite(l, slot(l, engine, WPTR_SLOT), bytes)
        const ring = l.*.more.doorbell
        ring(doorbellOf(engine), @intCast(u32, bytes))
    } else {
        wr(e, SDMA0_GFX_RB_WPTR + offset(engine), bytes)
    }
}

// What was written padded to the ring's 16 words, then told
// (amdgpu_ring_commit).
fn commit(e: *engines.Engines, l: *Loaded, engine: usize) -> void {
    const count = (RING_ALIGN - (l.*.wptr[engine] & (RING_ALIGN - 1))) % RING_ALIGN
    nops(l, engine, count)
    @fence(seq_cst)
    tell(e, l, engine)
}

// The copy engines from `first` to before `last` stopped as
// sdma_v3_0_hw_fini stops them: their context switch off, their ring and
// indirect buffers off, halted.
fn copyStop(e: *engines.Engines, l: *Loaded, first: usize, last: usize) -> void {
    var i = first
    while i < last {
        wr(e, engines.SDMA0_CNTL + offset(i), (rd(e, engines.SDMA0_CNTL + offset(i)) & ~engines.SDMA0_CNTL__AUTO_CTXSW_ENABLE) | SDMA0_CNTL__ATC_L1_ENABLE)
        i += 1
    }
    i = first
    while i < last {
        wr(e, engines.SDMA0_GFX_RB_CNTL + offset(i), rd(e, engines.SDMA0_GFX_RB_CNTL + offset(i)) & ~engines.SDMA0_GFX_RB_CNTL__RB_ENABLE)
        wr(e, engines.SDMA0_GFX_IB_CNTL + offset(i), rd(e, engines.SDMA0_GFX_IB_CNTL + offset(i)) & ~engines.SDMA0_GFX_IB_CNTL__IB_ENABLE)
        i += 1
    }
    i = first
    while i < last {
        wr(e, engines.SDMA0_F32_CNTL + offset(i), rd(e, engines.SDMA0_F32_CNTL + offset(i)) | engines.SDMA0_F32_CNTL__HALT)
        l.*.up[i] = false
        i += 1
    }
}

// The copy engines' golden words, each written where Linux's rule gives
// another value (amdgpu_device_program_register_sequence: the mask cleared,
// the value set), said with what it was.
fn golden(e: *engines.Engines, l: *Loaded) -> usize {
    var changed: usize = 0
    var k: usize = 0
    while k < GOLDEN_COPY_WORDS.length {
        const number = GOLDEN_COPY_WORDS[k]
        const was = rd(e, number)
        const value = (was & ~GOLDEN_COPY_WORDS[k + 1]) | GOLDEN_COPY_WORDS[k + 2]
        if value != was {
            put(e, l, number, value)
            word(e, "gpu: golden ", number)
            word(e, " was ", was)
            word(e, " now ", value)
            say(e, "\n")
            changed += 1
        }
        k += 3
    }
    return changed
}

// sdma_v3_0_start for the engines from `first` to before `last`, in its
// order (the study's 6.2): their context switch off, their rings and
// indirect buffers off and halted, each ring set up (gfx_resume: the ring
// cleared, the sixteen address spaces' two words, the tiling word, the
// ring's size, pointers, addresses, its doorbell or none, the write
// pointer's polling off, the ring and its indirect buffers on), unhalted,
// the context switch on with Linux's phase quantum.
fn copyStart(e: *engines.Engines, l: *Loaded, first: usize, last: usize) -> void {
    var i = first
    while i < last {
        put(e, l, engines.SDMA0_CNTL + offset(i), (rd(e, engines.SDMA0_CNTL + offset(i)) & ~engines.SDMA0_CNTL__AUTO_CTXSW_ENABLE) | SDMA0_CNTL__ATC_L1_ENABLE)
        i += 1
    }
    i = first
    while i < last {
        put(e, l, engines.SDMA0_GFX_RB_CNTL + offset(i), rd(e, engines.SDMA0_GFX_RB_CNTL + offset(i)) & ~engines.SDMA0_GFX_RB_CNTL__RB_ENABLE)
        put(e, l, engines.SDMA0_GFX_IB_CNTL + offset(i), rd(e, engines.SDMA0_GFX_IB_CNTL + offset(i)) & ~engines.SDMA0_GFX_IB_CNTL__IB_ENABLE)
        i += 1
    }
    i = first
    while i < last {
        put(e, l, engines.SDMA0_F32_CNTL + offset(i), rd(e, engines.SDMA0_F32_CNTL + offset(i)) | engines.SDMA0_F32_CNTL__HALT)
        i += 1
    }
    i = first
    while i < last {
        const at = offset(i)
        var w: usize = 0
        while w < SDMA_RING_BYTES / 4 {
            memoryWrite(l, l.*.ring[i] + w * 4, SDMA_OP_NOP)
            w += 1
        }
        var space: usize = 0
        while space < 16 {
            put(e, l, engines.SRBM_GFX_CNTL, field(SRBM_GFX_CNTL__VMID, space))
            put(e, l, SDMA0_GFX_VIRTUAL_ADDR + at, 0)
            put(e, l, SDMA0_GFX_APE1_CNTL + at, 0)
            space += 1
        }
        put(e, l, engines.SRBM_GFX_CNTL, 0)
        put(e, l, SDMA0_TILING_CONFIG + at, e.*.found.addressConfig & TILING_FROM_ADDRESS)
        put(e, l, SDMA0_SEM_WAIT_FAIL_TIMER_CNTL + at, 0)
        var bits: usize = 0
        while (@intCast(usize, 1) << @intCast(u6, bits)) < SDMA_RING_BYTES / 4 { bits += 1 }
        var control = (rd(e, engines.SDMA0_GFX_RB_CNTL + at) & ~SDMA0_GFX_RB_CNTL__RB_SIZE) | field(SDMA0_GFX_RB_CNTL__RB_SIZE, bits)
        put(e, l, engines.SDMA0_GFX_RB_CNTL + at, control)
        l.*.wptr[i] = 0
        put(e, l, SDMA0_GFX_RB_RPTR + at, 0)
        // The write pointer the engine holds is 0 by its register in either
        // case: a doorbell is not the engine's before its doorbell word
        // below, and engine 0 still holds what D1 told it by this register
        // (unhalted, it would run its cleared ring up to there and take the
        // ring test's doorbell for nothing new). Linux writes this register
        // where it uses no doorbell (sdma_v3_0_ring_set_wptr, and
        // use_pollmem in sdma_v3_0_gfx_resume).
        put(e, l, SDMA0_GFX_RB_WPTR + at, 0)
        if l.*.doorbellsOn { tell(e, l, i) }
        put(e, l, SDMA0_GFX_IB_RPTR + at, 0)
        put(e, l, SDMA0_GFX_IB_OFFSET + at, 0)
        const rptr = gartAddress(e, slot(l, i, RPTR_SLOT))
        put(e, l, SDMA0_GFX_RB_RPTR_ADDR_HI + at, rptr >> 32)
        put(e, l, SDMA0_GFX_RB_RPTR_ADDR_LO + at, rptr & 0xFFFFFFFC)
        control |= SDMA0_GFX_RB_CNTL__RPTR_WRITEBACK_ENABLE
        const ring = gartAddress(e, l.*.ring[i])
        put(e, l, SDMA0_GFX_RB_BASE + at, (ring >> 8) & 0xFFFFFFFF)
        put(e, l, SDMA0_GFX_RB_BASE_HI + at, ring >> 40)
        var doorbell = rd(e, SDMA0_GFX_DOORBELL + at)
        if l.*.doorbellsOn {
            doorbell = (doorbell & ~SDMA0_GFX_DOORBELL__OFFSET) | field(SDMA0_GFX_DOORBELL__OFFSET, doorbellOf(i)) | SDMA0_GFX_DOORBELL__ENABLE
        } else {
            doorbell = doorbell & ~SDMA0_GFX_DOORBELL__ENABLE
        }
        put(e, l, SDMA0_GFX_DOORBELL + at, doorbell)
        const wptr = gartAddress(e, slot(l, i, WPTR_SLOT))
        put(e, l, SDMA0_GFX_RB_WPTR_POLL_ADDR_LO + at, wptr & 0xFFFFFFFF)
        put(e, l, SDMA0_GFX_RB_WPTR_POLL_ADDR_HI + at, wptr >> 32)
        put(e, l, SDMA0_GFX_RB_WPTR_POLL_CNTL + at, rd(e, SDMA0_GFX_RB_WPTR_POLL_CNTL + at) & ~SDMA0_GFX_RB_WPTR_POLL_CNTL__ENABLE)
        control |= engines.SDMA0_GFX_RB_CNTL__RB_ENABLE
        put(e, l, engines.SDMA0_GFX_RB_CNTL + at, control)
        put(e, l, engines.SDMA0_GFX_IB_CNTL + at, rd(e, engines.SDMA0_GFX_IB_CNTL + at) | engines.SDMA0_GFX_IB_CNTL__IB_ENABLE)
        i += 1
    }
    i = first
    while i < last {
        put(e, l, engines.SDMA0_F32_CNTL + offset(i), rd(e, engines.SDMA0_F32_CNTL + offset(i)) & ~engines.SDMA0_F32_CNTL__HALT)
        l.*.up[i] = true
        i += 1
    }
    const quantum = field(SDMA0_PHASE0_QUANTUM__VALUE, PHASE_QUANTUM) | field(SDMA0_PHASE0_QUANTUM__UNIT, 0)
    i = first
    while i < last {
        const control = rd(e, engines.SDMA0_CNTL + offset(i)) | engines.SDMA0_CNTL__AUTO_CTXSW_ENABLE | SDMA0_CNTL__ATC_L1_ENABLE
        put(e, l, SDMA0_PHASE0_QUANTUM + offset(i), quantum)
        put(e, l, SDMA0_PHASE1_QUANTUM + offset(i), quantum)
        put(e, l, engines.SDMA0_CNTL + offset(i), control)
        i += 1
    }
}

// Linux's ring test (sdma_v3_0_ring_test_ring): a write-back word set to
// 0xcafedead, five words into the ring (write one word, 0xdeadbeef, to
// it), padded and told; the word looked at every microsecond, 100000 times
// at most. Whether it came (`l.waited`: after how many microseconds).
fn ringTest(e: *engines.Engines, l: *Loaded, engine: usize) -> bool {
    const check = slot(l, engine, RING_TEST_AT)
    memoryWrite(l, check, TEST_BEFORE)
    const address = gartAddress(e, check)
    emit(l, engine, header(SDMA_OP_WRITE, SDMA_SUBOP_WRITE_LINEAR))
    emit(l, engine, address & 0xFFFFFFFF)
    emit(l, engine, address >> 32)
    emit(l, engine, 1)
    emit(l, engine, TEST_WRITTEN)
    commit(e, l, engine)
    var k: usize = 0
    while k < engines.AMDGPU_MAX_USEC_TIMEOUT {
        if memoryRead(e, check) == TEST_WRITTEN {
            l.*.waited = k
            return true
        }
        pause(e, 1)
        k += 1
    }
    l.*.waited = k
    return false
}

// An indirect buffer submitted as amdgpu_ib_schedule submits Linux's test
// (no job): the host path flushed by the engine, NOPs so that the next
// packet ends on 8 words, the indirect buffer (address space 0), the host
// path invalidated by a register write, the fence with the ring's next
// number, the trap; padded and told.
fn submit(e: *engines.Engines, l: *Loaded, engine: usize, buffer: usize, length: usize) -> void {
    const mine = if engine == 0 { GPU_HDP_FLUSH_DONE__SDMA0 } else { GPU_HDP_FLUSH_DONE__SDMA1 }
    emit(l, engine, hdpFlushHeader())
    emit(l, engine, GPU_HDP_FLUSH_DONE << 2)
    emit(l, engine, GPU_HDP_FLUSH_REQ << 2)
    emit(l, engine, mine)
    emit(l, engine, mine)
    emit(l, engine, pollRetry())
    nops(l, engine, (2 -% l.*.wptr[engine]) & (IB_END_ALIGN - 1))
    const address = gartAddress(e, buffer)
    emit(l, engine, header(SDMA_OP_INDIRECT, 0) | IB_VMID << @intCast(u6, SDMA_PKT_INDIRECT_HEADER_vmid_shift))
    emit(l, engine, address & IB_BASE_ALIGN)
    emit(l, engine, address >> 32)
    emit(l, engine, length)
    emit(l, engine, 0)
    emit(l, engine, 0)
    emit(l, engine, registerWriteHeader())
    emit(l, engine, HDP_DEBUG0)
    emit(l, engine, 1)
    l.*.fences[engine] += 1
    const fence = gartAddress(e, slot(l, engine, FENCE_SLOT))
    emit(l, engine, header(SDMA_OP_FENCE, 0))
    emit(l, engine, fence & 0xFFFFFFFF)
    emit(l, engine, fence >> 32)
    emit(l, engine, l.*.fences[engine] & 0xFFFFFFFF)
    emit(l, engine, header(SDMA_OP_TRAP, 0))
    emit(l, engine, 0)
    commit(e, l, engine)
}

// The interrupt ring's entries taken (amdgpu_ih_process as
// gpu_engines.mlx's I1 takes them, the read pointer told by register): a
// copy engine's trap kept with its ring id, others counted.
fn takeEntries(e: *engines.Engines, l: *Loaded) -> void {
    var rounds: usize = 0
    while rounds < engines.IH_RING_BYTES / engines.IH_ENTRY_BYTES {
        rounds += 1
        var pointer = memoryRead(e, e.*.pointers)
        if pointer & engines.IH_RB_WPTR__RB_OVERFLOW != 0 {
            pointer = rd(e, engines.IH_RB_WPTR)
            if pointer & engines.IH_RB_WPTR__RB_OVERFLOW != 0 {
                pointer = pointer & ~engines.IH_RB_WPTR__RB_OVERFLOW
                e.*.readPointer = (pointer + engines.IH_ENTRY_BYTES) & (engines.IH_RING_BYTES - 1)
                wr(e, engines.IH_RB_CNTL, rd(e, engines.IH_RB_CNTL) | engines.IH_RB_CNTL__WPTR_OVERFLOW_CLEAR)
            }
        }
        pointer = pointer & (engines.IH_RING_BYTES - 1)
        if pointer == e.*.readPointer { return }
        var count = engines.AMDGPU_IH_MAX_NUM_IVS
        while e.*.readPointer != pointer && count > 1 {
            count -= 1
            const entry = e.*.ring + e.*.readPointer
            if memoryRead(e, entry) & 0xFF == VISLANDS30_IV_SRCID_SDMA_TRAP {
                if l.*.trapCount < TRAPS { l.*.traps[l.*.trapCount] = memoryRead(e, entry + 8) & 0xFF }
                l.*.trapCount += 1
            } else {
                l.*.others += 1
            }
            e.*.entries += 1
            e.*.readPointer = (e.*.readPointer + engines.IH_ENTRY_BYTES) & (engines.IH_RING_BYTES - 1)
        }
        wr(e, engines.IH_RB_RPTR, e.*.readPointer)
    }
}

// An engine's fence waited for (Linux: the fence by its interrupt, 1000 ms
// at most; here its word looked at, the interrupt ring's entries taken
// meanwhile). Whether it came.
fn fenced(e: *engines.Engines, l: *Loaded, engine: usize) -> bool {
    const started = now(e)
    while true {
        takeEntries(e, l)
        if memoryRead(e, slot(l, engine, FENCE_SLOT)) == l.*.fences[engine] & 0xFFFFFFFF {
            l.*.waited = (now(e) - started) / 1000
            takeEntries(e, l)
            return true
        }
        if now(e) - started > IB_TEST_TIMEOUT_MS * 1000000 { break }
        pause(e, 10)
    }
    l.*.waited = (now(e) - started) / 1000
    return false
}

// What an engine's state words say, for a line that tells why.
fn sayEngine(e: *engines.Engines, l: *Loaded, engine: usize) -> void {
    const at = offset(engine)
    word(e, "read pointer ", memoryRead(e, slot(l, engine, RPTR_SLOT)))
    word(e, " (register ", rd(e, SDMA0_GFX_RB_RPTR + at))
    word(e, "), write pointer ", l.*.wptr[engine] << 2)
    word(e, ", status ", rd(e, engines.SDMA0_STATUS_REG + at))
    word(e, ", ring control ", rd(e, engines.SDMA0_GFX_RB_CNTL + at))
    word(e, ", halt word ", rd(e, engines.SDMA0_F32_CNTL + at))
}

// Whether a fault was kept in address space 0 since the GART came on, and
// its words for the line.
fn faulted(e: *engines.Engines) -> bool { return rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS) != 0 || rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR) != 0 }

fn sayFault(e: *engines.Engines) -> void {
    word(e, "a fault in address space 0 at page ", rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR))
    word(e, " (status ", rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS))
    say(e, ")")
}

// The burst NOP of each engine, by its firmware file's feature version.
fn readBurst(e: *engines.Engines, l: *Loaded) -> void {
    const file = e.*.hands.file
    l.*.burst[0] = le(file(engines.FILES[5]), HEADER__ucode_feature_version) >= BURST_NOP_FEATURE
    l.*.burst[1] = le(file(engines.FILES[6]), HEADER__ucode_feature_version) >= BURST_NOP_FEATURE
}

// ---- D1: copy engine 0, its write pointer by register.

pub fn firstEngine(e: *engines.Engines, l: *Loaded) -> bool {
    e.*.began = now(e)
    if !cool(e, l, "D1") {
        l.*.d1 = engines.Outcome.refused
        return false
    }
    if l.*.writeBack == 0 { l.*.writeBack = dma(e, engines.AMDGPU_GPU_PAGE_SIZE) }
    if l.*.ring[0] == 0 { l.*.ring[0] = dma(e, SDMA_RING_BYTES) }
    const end = e.*.card.dmaBase + engines.DMA_PAGES * engines.AMDGPU_GPU_PAGE_SIZE
    if l.*.writeBack == 0 || l.*.ring[0] == 0 || l.*.writeBack >= end || l.*.ring[0] + SDMA_RING_BYTES > end {
        l.*.d1 = engines.Outcome.refused
        say(e, "gpu: step D1 refused: no room for the ring in the memory set aside for the card\n")
        return false
    }
    readBurst(e, l)
    const mark = l.*.count
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)
    const changed = golden(e, l)
    l.*.doorbellsOn = false
    copyStart(e, l, 0, 1)
    const came = ringTest(e, l, 0)
    var why: []const u8 = ""
    if !came { why = "copy engine 0 did not write within 100 ms" }
    // The read pointer the engine writes back, given the ring test's time
    // to come to the write pointer.
    var rptr = memoryRead(e, slot(l, 0, RPTR_SLOT))
    var k: usize = 0
    while came && rptr != l.*.wptr[0] << 2 && k < engines.AMDGPU_MAX_USEC_TIMEOUT {
        pause(e, 1)
        rptr = memoryRead(e, slot(l, 0, RPTR_SLOT))
        k += 1
    }
    if why.length == 0 && rptr != l.*.wptr[0] << 2 { why = "copy engine 0's read pointer is not its write pointer" }
    const fault = why.length == 0 && faulted(e)
    if fault { why = "a fault" }
    if why.length == 0 && l.*.full { why = "more registers were to be kept than there is room for" }
    const index = rd(e, engines.SMC_IND_INDEX_11)
    const after = temperature(e)
    wr(e, engines.SMC_IND_INDEX_11, index)
    const living = engines.alive(e, "D1")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    aside(e, false)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    l.*.unread = living && !came && rptr == 0 && rd(e, SDMA0_GFX_RB_RPTR) == 0 && !faulted(e)
    if why.length != 0 || minded != engines.Change.none {
        l.*.d1 = engines.Outcome.failed
        say(e, "gpu: step D1 failed: ")
        if !living {
            say(e, why)
        } else if why.length == 0 {
            engines.sayChange(e, minded, &before, &later)
        } else if fault {
            sayFault(e)
        } else {
            say(e, why)
            if !came {
                word(e, " (the word reads ", memoryRead(e, slot(l, 0, RING_TEST_AT)))
                say(e, "; ")
                sayEngine(e, l, 0)
                say(e, ")")
                // (The engine's own read pointer as well: a write-back that
                // lands elsewhere leaves the word 0 with the ring read.)
                if rptr == 0 && rd(e, SDMA0_GFX_RB_RPTR) == 0 && !faulted(e) { say(e, "; it did not read its ring (Linux tells this card's copy engines their write pointer by doorbell, as step D2 does, and starts the graphics block first)") }
            } else if rptr != l.*.wptr[0] << 2 {
                say(e, " (")
                sayEngine(e, l, 0)
                say(e, ")")
            }
        }
        // The way back: the engine stopped, every register the step wrote
        // as it was, last first.
        copyStop(e, l, 0, 1)
        const back = putBack(e, l, mark)
        num(e, "; copy engine 0 halted, its words as before the step (", back)
        say(e, " registers)")
        degrees(e, l, after)
        took(e)
        return false
    }
    l.*.d1 = engines.Outcome.passed
    say(e, "gpu: step D1: copy engine 0 runs: it wrote 0xdeadbeef through the GART after ")
    decimal(e, l.*.waited)
    word(e, " us, read pointer ", rptr)
    word(e, " = write pointer (status ", rd(e, engines.SDMA0_STATUS_REG))
    num(e, "), its write pointer by register; golden words changed: ", changed)
    degrees(e, l, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// ---- D2: both copy engines with their doorbells; Linux's tests, a fill,
// a copy.

// The pattern the copy's source holds.
pub fn copyPattern(k: usize) -> usize { return (k *% 0x9E3779B9 +% 0x01234567) & 0xFFFFFFFF }

pub fn bothEngines(e: *engines.Engines, l: *Loaded) -> bool {
    e.*.began = now(e)
    if l.*.more.doorbells <= AMDGPU_DOORBELL_sDMA_ENGINE1 {
        l.*.d2 = engines.Outcome.refused
        say(e, "gpu: step D2 refused: the card's doorbells are not in the kernel's view\n")
        return false
    }
    if !cool(e, l, "D2") {
        l.*.d2 = engines.Outcome.refused
        return false
    }
    if l.*.ring[1] == 0 { l.*.ring[1] = dma(e, SDMA_RING_BYTES) }
    if l.*.buffers == 0 { l.*.buffers = dma(e, engines.AMDGPU_GPU_PAGE_SIZE) }
    if l.*.source == 0 { l.*.source = dma(e, TRIAL_BYTES) }
    if l.*.target == 0 { l.*.target = dma(e, TRIAL_BYTES) }
    const end = e.*.card.dmaBase + engines.DMA_PAGES * engines.AMDGPU_GPU_PAGE_SIZE
    if l.*.ring[1] == 0 || l.*.buffers == 0 || l.*.source == 0 || l.*.target == 0 || l.*.target + TRIAL_BYTES > end || l.*.ring[1] + SDMA_RING_BYTES > end {
        l.*.d2 = engines.Outcome.refused
        say(e, "gpu: step D2 refused: no room for its rings and pages in the memory set aside for the card\n")
        return false
    }
    if e.*.limit + COPY_AT + TRIAL_BYTES > e.*.card.view {
        l.*.d2 = engines.Outcome.refused
        say(e, "gpu: step D2 refused: no room for its pages in the driver's part of the aperture\n")
        return false
    }
    readBurst(e, l)
    const mark = l.*.count
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)
    const counted = e.*.hands.interrupts
    const waiting = e.*.hands.waiting
    const taken = counted()
    const waitedBefore = waiting()
    l.*.trapCount = 0
    l.*.others = 0
    l.*.fences[0] = 0
    l.*.fences[1] = 0
    memoryWrite(l, slot(l, 0, FENCE_SLOT), 0)
    memoryWrite(l, slot(l, 1, FENCE_SLOT), 0)
    // The pages: the copy's source a pattern, its target back nothing.
    var k: usize = 0
    while k < TRIAL_BYTES / 4 {
        memoryWrite(l, l.*.source + k * 4, copyPattern(k))
        memoryWrite(l, l.*.target + k * 4, 0)
        k += 1
    }

    // The doorbells on (vi_enable_doorbell_aperture), Linux's start of both
    // engines with their doorbells (the golden words of both are D1's),
    // the ring tests, the traps on (sdma_v3_0_set_trap_irq_state, as
    // amdgpu_fence_driver_hw_init asks after the start).
    put(e, l, engines.BIF_DOORBELL_APER_EN, rd(e, engines.BIF_DOORBELL_APER_EN) | engines.BIF_DOORBELL_APER_EN__BIF_DOORBELL_APER_EN)
    l.*.doorbellsOn = true
    copyStart(e, l, 0, 2)
    var why: []const u8 = ""
    var engine: usize = 0
    var bad: usize = NONE
    var badWanted: usize = 0
    // The engine whose words tell why (NONE: none), whether the trap
    // entries were not as wanted, whether their interrupt did not come.
    var stuck: usize = NONE
    var trapsWrong = false
    var silent = false
    var at: usize = 0
    while engine < 2 && why.length == 0 {
        if !ringTest(e, l, engine) {
            why = if engine == 0 { "copy engine 0 did not write by its doorbell within 100 ms (" } else { "copy engine 1 did not write within 100 ms (" }
            stuck = engine
        }
        engine += 1
    }
    engine = 0
    while engine < 2 && why.length == 0 {
        put(e, l, engines.SDMA0_CNTL + offset(engine), rd(e, engines.SDMA0_CNTL + offset(engine)) | SDMA0_CNTL__TRAP_ENABLE)
        engine += 1
    }

    // Linux's indirect buffer test on each (sdma_v3_0_ring_test_ib: its
    // eight words, three of them NOPs).
    engine = 0
    while engine < 2 && why.length == 0 {
        const check = slot(l, engine, IB_TEST_AT)
        memoryWrite(l, check, TEST_BEFORE)
        const address = gartAddress(e, check)
        const buffer = l.*.buffers + (engine * 4 + IB_TEST) * IB_BYTES
        const words = [_]usize{ header(SDMA_OP_WRITE, SDMA_SUBOP_WRITE_LINEAR), address & 0xFFFFFFFF, address >> 32, 1, TEST_WRITTEN, SDMA_OP_NOP, SDMA_OP_NOP, SDMA_OP_NOP }
        k = 0
        while k < words.length {
            memoryWrite(l, buffer + k * 4, words[k])
            k += 1
        }
        submit(e, l, engine, buffer, words.length)
        if !fenced(e, l, engine) {
            why = if engine == 0 { "copy engine 0's indirect buffer test did not end within 1000 ms (" } else { "copy engine 1's indirect buffer test did not end within 1000 ms (" }
            stuck = engine
        } else if memoryRead(e, check) != TEST_WRITTEN {
            why = if engine == 0 { "copy engine 0's indirect buffer test ended, but its word reads " } else { "copy engine 1's indirect buffer test ended, but its word reads " }
            bad = memoryRead(e, check)
            badWanted = TEST_WRITTEN
        }
        engine += 1
    }

    // The fill (ours, by Linux's packet, sdma_v3_0_emit_fill_buffer, in an
    // indirect buffer padded as sdma_v3_0_ring_pad_ib pads): engine 0
    // fills a page of the card's memory.
    const fill = e.*.found.vramStart + e.*.limit + FILL_AT
    if why.length == 0 {
        const buffer = l.*.buffers + IB_FILL * IB_BYTES
        const words = [_]usize{ header(SDMA_OP_CONST_FILL, 0), fill & 0xFFFFFFFF, fill >> 32, FILL_VALUE, TRIAL_BYTES }
        const length = padBuffer(l, 0, buffer, words[0..])
        submit(e, l, 0, buffer, length)
        if !fenced(e, l, 0) {
            why = "copy engine 0's fill did not end within 1000 ms ("
            stuck = 0
        } else {
            at = 0
            while at < TRIAL_BYTES && bad == NONE {
                const value = vramRead(e, e.*.limit + FILL_AT + at)
                if value != FILL_VALUE | (FILL_VALUE << 32) {
                    bad = value
                    badWanted = FILL_VALUE | (FILL_VALUE << 32)
                }
                at += 8
            }
            if bad == NONE && vramRead(e, e.*.limit + FILL_AT + TRIAL_BYTES) != 0 {
                bad = vramRead(e, e.*.limit + FILL_AT + TRIAL_BYTES)
                badWanted = 0
            }
            if bad != NONE { why = "the fill's page of the card's memory reads " }
        }
    }

    // The copy (ours, by Linux's packet, sdma_v3_0_emit_copy_buffer):
    // engine 0 from the system's memory to the card's, engine 1 back to
    // another page of the system's.
    const card = e.*.found.vramStart + e.*.limit + COPY_AT
    var leg: usize = 0
    while leg < 2 && why.length == 0 {
        const buffer = l.*.buffers + (leg * 4 + IB_COPY) * IB_BYTES
        const from = if leg == 0 { gartAddress(e, l.*.source) } else { card }
        const to = if leg == 0 { card } else { gartAddress(e, l.*.target) }
        const words = [_]usize{ header(SDMA_OP_COPY, SDMA_SUBOP_COPY_LINEAR), TRIAL_BYTES, 0, from & 0xFFFFFFFF, from >> 32, to & 0xFFFFFFFF, to >> 32 }
        const length = padBuffer(l, leg, buffer, words[0..])
        submit(e, l, leg, buffer, length)
        if !fenced(e, l, leg) {
            why = if leg == 0 { "copy engine 0's copy into the card's memory did not end within 1000 ms (" } else { "copy engine 1's copy back did not end within 1000 ms (" }
            stuck = leg
        }
        leg += 1
    }
    if why.length == 0 {
        at = 0
        while at < TRIAL_BYTES && bad == NONE {
            const value = vramRead(e, e.*.limit + COPY_AT + at)
            const wanted = copyPattern(at / 4) | (copyPattern(at / 4 + 1) << 32)
            if value != wanted {
                bad = value
                badWanted = wanted
                why = "the copy's page of the card's memory reads "
            }
            at += 8
        }
        at = 0
        while at < TRIAL_BYTES && bad == NONE {
            const value = memoryRead(e, l.*.target + at)
            if value != copyPattern(at / 4) {
                bad = value
                badWanted = copyPattern(at / 4)
                why = "the copy back reads "
            }
            at += 4
        }
    }
    takeEntries(e, l)
    // The trap entries: one a submission, in its order (engine 0's test,
    // engine 1's test, the fill, the two copies), each naming its engine
    // and the ring of the engine's own (sdma_v3_0_process_trap_irq).
    const wanted = [_]usize{ 0, 1, 0, 0, 1 }
    if why.length == 0 {
        trapsWrong = l.*.trapCount != wanted.length
        k = 0
        while k < wanted.length && !trapsWrong {
            if l.*.traps[k] & 0xF != wanted[k] { trapsWrong = true }
            k += 1
        }
        if trapsWrong { why = "trap entries:" }
    }
    const interrupted = counted() != taken || (!waitedBefore && waiting())
    if why.length == 0 && e.*.routed && !interrupted && !waitedBefore {
        why = "entries came and their interrupt did not"
        silent = true
    }
    const fault = why.length == 0 && faulted(e)
    if fault { why = "a fault" }
    if why.length == 0 && l.*.full { why = "more registers were to be kept than there is room for" }
    const index = rd(e, engines.SMC_IND_INDEX_11)
    const after = temperature(e)
    wr(e, engines.SMC_IND_INDEX_11, index)
    const living = engines.alive(e, "D2")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    aside(e, false)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    if why.length != 0 || minded != engines.Change.none {
        l.*.d2 = engines.Outcome.failed
        say(e, "gpu: step D2 failed: ")
        if !living {
            say(e, why)
        } else if why.length == 0 {
            engines.sayChange(e, minded, &before, &later)
        } else if fault {
            sayFault(e)
        } else if bad != NONE {
            say(e, why)
            hex(e, bad)
            word(e, " where ", badWanted)
            say(e, " was written")
        } else if trapsWrong {
            say(e, why)
            sayTraps(e, l)
            say(e, " where 5 were wanted (engines 0 1 0 0 1)")
        } else {
            say(e, why)
            if stuck != NONE {
                sayEngine(e, l, stuck)
                say(e, ")")
            } else if silent {
                num(e, " (", l.*.trapCount)
                say(e, " entries)")
            }
        }
        // The way back: both engines stopped, every register the step wrote
        // as it was (the doorbells off), last first, and stopped once more
        // (engine 0 ran before the step).
        copyStop(e, l, 0, 2)
        const back = putBack(e, l, mark)
        copyStop(e, l, 0, 2)
        l.*.doorbellsOn = false
        num(e, "; both copy engines halted, the doorbells off, their words as before the step (", back)
        say(e, " registers)")
        degrees(e, l, after)
        took(e)
        return false
    }
    l.*.d2 = engines.Outcome.passed
    say(e, "gpu: step D2: copy engines 0 and 1 by their doorbells: ring tests and Linux's indirect buffer test on both; a fill of ")
    decimal(e, TRIAL_BYTES)
    word(e, " bytes in the card's memory reads back (", FILL_VALUE)
    say(e, " as written), a copy system -> card -> system the same; fences ")
    decimal(e, l.*.fences[0])
    num(e, " and ", l.*.fences[1])
    num(e, ", ", l.*.trapCount)
    say(e, " trap entries (source 224, engines")
    sayTraps(e, l)
    say(e, ")")
    if !e.*.routed {
        say(e, ", no interrupt (the card has neither MSI nor MSI-X)")
    } else {
        num(e, ", interrupts taken: ", counted() - taken)
        if !waitedBefore && waiting() { say(e, ", one waits at the processor (interrupts are off while the kernel starts)") }
        if waitedBefore { say(e, ", one of the card's waited at the processor before (a new one cannot be told from it)") }
    }
    degrees(e, l, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// A buffer's words written and padded to 8 (sdma_v3_0_ring_pad_ib); its
// length.
fn padBuffer(l: *Loaded, engine: usize, buffer: usize, words: []const usize) -> usize {
    var k: usize = 0
    while k < words.length {
        memoryWrite(l, buffer + k * 4, words[k])
        k += 1
    }
    const count = (0 -% words.length) & (IB_END_ALIGN - 1)
    var n: usize = 0
    while n < count {
        memoryWrite(l, buffer + (k + n) * 4, if l.*.burst[engine] && n == 0 { burstNop(count) } else { SDMA_OP_NOP })
        n += 1
    }
    return words.length + count
}

fn sayTraps(e: *engines.Engines, l: *Loaded) -> void {
    var k: usize = 0
    while k < l.*.trapCount && k < TRAPS {
        num(e, " ", l.*.traps[k] & 0x3)
        k += 1
    }
    if l.*.trapCount == 0 { say(e, " none") }
}

// ---- The stages of a boot, and the way down.

// Stages 3 and 4 as far as `e.stage`, after stage 2 passed, each step only
// after the one before it passed.
pub fn run(e: *engines.Engines, l: *Loaded) -> void {
    if e.*.stage < 3 || e.*.i1 != engines.Outcome.passed { return }
    if !smcFirmware(e, l) { return }
    if !engineFirmware(e, l) { return }
    if e.*.stage < 4 { return }
    if !firstEngine(e, l) { return }
    _ = bothEngines(e, l)
}

// The way down (the study's 8.7, Z): the copy engines halted, the
// interrupt ring off (gpu_engines.mlx's), the doorbells off; the GART stays
// on.
pub fn stop(e: *engines.Engines, l: *Loaded) -> void {
    if l.*.up[0] || l.*.up[1] {
        copyStop(e, l, 0, 2)
        word(e, "gpu: stopped for the way down: copy engines halted (", rd(e, engines.SDMA0_F32_CNTL))
        word(e, " ", rd(e, engines.SDMA1_F32_CNTL))
        say(e, ")\n")
    }
    engines.stop(e)
    if l.*.doorbellsOn {
        wr(e, engines.BIF_DOORBELL_APER_EN, rd(e, engines.BIF_DOORBELL_APER_EN) & ~engines.BIF_DOORBELL_APER_EN__BIF_DOORBELL_APER_EN)
        l.*.doorbellsOn = false
        say(e, "gpu: stopped for the way down: the doorbells off\n")
    }
}
