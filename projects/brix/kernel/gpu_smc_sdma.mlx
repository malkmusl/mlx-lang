// ---- This driver's own numbers.
// The temperature (degrees C) at which no step begins: the study's first
// mark (7.3).
pub const MARK: usize = 85
// Where in the driver's part of the aperture (gpu_engines.mlx's M1, which
// proved and cleared its first 2 MiB; the GART's table and the default
// page are its first 516 KiB) the SMC's list and its working memory lie,
// the fill's target, a page left between, the copy's target.
pub const LIST_AT: usize = 0x81000
pub const SMU_BUFFER_AT: usize = 0x82000
pub const FILL_AT: usize = LIST_AT + HEADER_BUFFER_BYTES + SMU_BUFFER_BYTES
pub const COPY_AT: usize = FILL_AT + 2 * 4096
// The bytes the fill and the copy cover, and the fill's value (four
// bytes that differ: how the engine takes it is the study's card 15).
pub const TRIAL_BYTES: usize = 4096
pub const FILL_VALUE: usize = 0x11223344
// The write-back page: a 32-byte record per engine (its read pointer, its
// write pointer, its fence), the two tests' words (32 bytes apart, as
