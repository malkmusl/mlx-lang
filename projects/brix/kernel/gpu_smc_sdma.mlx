pub const RECORD: usize = 32
pub const RPTR_SLOT: usize = 0
pub const WPTR_SLOT: usize = 4
pub const FENCE_SLOT: usize = 8
pub const RING_TEST_AT: usize = 64
pub const IB_TEST_AT: usize = 128
// The indirect buffers' page: 256 bytes each (Linux's 256 of the IB test).
pub const IB_BYTES: usize = 256
pub const IB_TEST: usize = 0
pub const IB_FILL: usize = 1
pub const IB_COPY: usize = 2
// The register table kept for the way back.
pub const KEPT: usize = 512
// Trap entries recorded.
pub const TRAPS: usize = 16
// (No such thing.)
pub const NONE: usize = 0xFFFFFFFFFFFFFFFF

