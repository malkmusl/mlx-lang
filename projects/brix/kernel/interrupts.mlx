// Interrupts: the two legacy controllers (8259 PICs) moved to vectors 32
// to 47 (the processor's exceptions are below), the PIT's channel 0 as the
// timer (IRQ 0, HERTZ times a second), the serial line's receiver (IRQ 4);
// every other line masked. The kernel runs with interrupts off (its trap
// gates and SYSCALL clear IF): they come in user mode, or while the kernel
// waits for one (Cpu.wait, the idle loop).
const cpu = @import("./cpu.mlx")
const Port = cpu.Port

pub const Irq = struct {
    // The vector of IRQ 0, and how many there are.
    pub const BASE: usize = 32
    pub const COUNT: usize = 16
    pub const TIMER: usize = 0
    pub const SERIAL: usize = 4
    // Timer interrupts a second (a time slice is one).
    pub const HERTZ: usize = 100

    const MASTER_COMMAND: usize = 0x20
    const MASTER_DATA: usize = 0x21
    const SLAVE_COMMAND: usize = 0xA0
    const SLAVE_DATA: usize = 0xA1
    const END_OF_INTERRUPT: usize = 0x20
    const READ_IN_SERVICE: usize = 0x0B
    const PIT_CHANNEL0: usize = 0x40
    const PIT_COMMAND: usize = 0x43
    const PIT_HERTZ: usize = 1193182

    // The controllers at BASE (ICW1..ICW4: edge triggered, cascaded on
    // IRQ 2, 8086 mode), only the timer and the serial line unmasked; the
    // PIT's channel 0 as a rate generator at HERTZ.
    pub fn init() -> void {
        Port.out8(MASTER_COMMAND, 0x11)
        Port.out8(SLAVE_COMMAND, 0x11)
        Port.out8(MASTER_DATA, BASE)
        Port.out8(SLAVE_DATA, BASE + 8)
        Port.out8(MASTER_DATA, 4)
        Port.out8(SLAVE_DATA, 2)
        Port.out8(MASTER_DATA, 1)
        Port.out8(SLAVE_DATA, 1)
        Port.out8(MASTER_DATA, 0xFF & ~((1 << TIMER) | (1 << SERIAL)))
        Port.out8(SLAVE_DATA, 0xFF)
        const divisor = PIT_HERTZ / HERTZ
        Port.out8(PIT_COMMAND, 0x34) // channel 0, both bytes, mode 2
        Port.out8(PIT_CHANNEL0, divisor & 255)
        Port.out8(PIT_CHANNEL0, divisor >> 8)
    }

    // The IRQ of a vector, or COUNT when it is none.
    pub fn of(vector: usize) -> usize {
        if vector < BASE || vector >= BASE + COUNT { return COUNT }
        return vector - BASE
    }

    // An IRQ 7 or 15 its controller does not have in service is spurious:
    // it takes no end of interrupt (a spurious 15 still takes the
    // master's, which did cascade it).
    pub fn spurious(irq: usize) -> bool {
        if irq == 7 {
            Port.out8(MASTER_COMMAND, READ_IN_SERVICE)
            return Port.in8(MASTER_COMMAND) & 0x80 == 0
        }
        if irq == 15 {
            Port.out8(SLAVE_COMMAND, READ_IN_SERVICE)
            if Port.in8(SLAVE_COMMAND) & 0x80 == 0 {
                Port.out8(MASTER_COMMAND, END_OF_INTERRUPT)
                return true
            }
        }
        return false
    }

    // The end of the interrupt (its controllers may send the next).
    pub fn acknowledge(irq: usize) -> void {
        if irq >= 8 { Port.out8(SLAVE_COMMAND, END_OF_INTERRUPT) }
        Port.out8(MASTER_COMMAND, END_OF_INTERRUPT)
    }
}
