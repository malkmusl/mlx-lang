// ACPI's tables as the firmware left them, read and never run: the RSDP
// (the one a UEFI firmware named through the EFI loader, else the BIOS's),
// the tables its XSDT or RSDT lists, found by their signature (smp.mlx
// reads the MADT's processors); the FADT's registers for the system's end
// (power.mlx: the PM1 control blocks, the reset register, the port that
// turns ACPI mode on); and the sleep types of \_S5 from the DSDT.
//
// There is no AML interpreter here. \_S5 is a name with a package of
// small constants in every table seen, and that one form is read: the
// name, the package op, its length and count, then the values, each a
// byte, a word or the ops for zero and one. Every read stays inside the
// table's own length. A firmware whose \_S5 is computed (a method) is
// said to have none, and the system's end then tries what it knows
// without the tables.
const layout = @import("../layout.mlx")
const memory = @import("./memory.mlx")
const cpu = @import("./cpu.mlx")
const pci = @import("./pci.mlx")
const Bytes = @import("./bytes.mlx").Bytes

// A table's header: its signature (4 bytes), its length (at 4), the rest.
pub const HEADER: usize = 36
// An ACPI table's most bytes (what is taken for one; a server's DSDT is a
// few hundred KiB).
const MAX_TABLE: usize = 0x100000

fn physical(address: usize) -> [*]u8 { return Bytes.pointer(layout.Memory.virtual(address)) }

fn same(bytes: [*]const u8, text: []const u8) -> bool {
    var k: usize = 0
    while k < text.length {
        if bytes[k] != text[k] { return false }
        k += 1
    }
    return true
}

// The firmware's memory at `address` (`length` bytes of its ACPI tables:
// no RAM the kernel hands out, so nothing has put it in the kernel's
// view) where the kernel sees it; 0 when it cannot be.
fn firmware(address: usize, length: usize) -> usize {
    if address == 0 || length == 0 { return 0 }
    return memory.Device.map(address, length, 0)
}

// Whether the `length` bytes at `at` (in the kernel's view) add up to 0,
// as an ACPI structure's do.
fn sums(at: usize, length: usize) -> bool {
    const bytes = Bytes.pointer(at)
    var total: usize = 0
    var k: usize = 0
    while k < length {
        total += @intCast(usize, bytes[k])
        k += 1
    }
    return total & 0xFF == 0
}

// The RSDP, in the kernel's view: the one a UEFI firmware named (the EFI
// loader passes it on: such a firmware keeps none in the BIOS area), else
// the BIOS's, in the EBDA's first KiB or at 0xE0000..0xFFFFF on a 16-byte
// boundary; its checksum right. 0 when there is none.
pub fn root() -> usize {
    const given = cpu.BootInfo.get(layout.Info.RSDP)
    if given != 0 {
        const at = firmware(given, 36)
        if at != 0 && same(Bytes.pointer(at), "RSD PTR ") && sums(at, 20) { return at }
    }
    const ebda = Bytes.read16(physical(0x40E), 0) << 4
    var at = ebda
    while ebda != 0 && at < ebda + 1024 {
        if same(physical(at), "RSD PTR ") && sums(layout.Memory.virtual(at), 20) { return layout.Memory.virtual(at) }
        at += 16
    }
    at = 0xE0000
    while at < 0x100000 {
        if same(physical(at), "RSD PTR ") && sums(layout.Memory.virtual(at), 20) { return layout.Memory.virtual(at) }
        at += 16
    }
    return 0
}

// The ACPI table at the physical `address`, all of it in the kernel's
// view; 0 when there is none (or its length is no table's).
pub fn tableAt(address: usize) -> usize {
    const header = firmware(address, HEADER)
    if header == 0 { return 0 }
    const length = Bytes.read32(Bytes.pointer(header), 4)
    if length < HEADER || length > MAX_TABLE { return 0 }
    return firmware(address, length)
}

// A table's length, as its header says (tableAt looked at it).
pub fn lengthOf(table: usize) -> usize { return Bytes.read32(Bytes.pointer(table), 4) }

// The table `signature` ("APIC", "FACP", "SSDT") among those the RSDP at
// `from` (root's) names, the `nth` of them (0: the first; there are
// several SSDTs): the XSDT's 64-bit entries when it has one (ACPI 2.0; a
// firmware may give no RSDT then), else the RSDT's 32-bit ones. 0 when
// there is none.
pub fn table(from: usize, signature: []const u8, nth: usize) -> usize {
    if from == 0 { return 0 }
    const pointer = Bytes.pointer(from)
    var list: usize = 0
    var width: usize = 8
    if pointer[15] >= 2 { list = tableAt(Bytes.read64(pointer, 24)) }
    if list == 0 {
        list = tableAt(Bytes.read32(pointer, 16))
        width = 4
    }
    if list == 0 { return 0 }
    const entries = Bytes.pointer(list)
    const length = Bytes.read32(entries, 4)
    var seen: usize = 0
    var at: usize = HEADER
    while at + width <= length {
        const address = if width == 8 { Bytes.read64(entries, at) } else { Bytes.read32(entries, at) }
        const found = tableAt(address)
        if found != 0 && same(Bytes.pointer(found), signature) {
            if seen == nth { return found }
            seen += 1
        }
        at += width
    }
    return 0
}

// A register in memory, 8, 16 or 32 bits wide (read and written as one
// access of that width, as a device's register must be).
fn byteAt(address: usize) -> *u8 { return unsafe { @ptrFromInt(*u8, address) } }
fn wordAt(address: usize) -> *u16 { return unsafe { @ptrFromInt(*u16, address) } }
fn longAt(address: usize) -> *u32 { return unsafe { @ptrFromInt(*u32, address) } }

// Where a register the tables name is: in memory, at an I/O port, or in
// the PCI configuration space of a device on bus 0 (ACPI's generic
// address structure knows more; these are what a reset or a sleep
// register is given as).
pub const Space = struct {
    pub const MEMORY: usize = 0
    pub const PORT: usize = 1
    pub const PCI: usize = 2
    pub const NONE: usize = 0xFF
}

// A register the tables name: where, and how many bits wide (8, 16, 32).
pub const Register = struct {
    space: usize
    address: usize
    bits: usize

    pub fn none() -> Register { return Register.{ .space = Space.NONE, .address = 0, .bits = 0 } }

    // An I/O port (the FADT's older, 32-bit fields).
    pub fn port(address: usize, bits: usize) -> Register {
        if address == 0 { return none() }
        return Register.{ .space = Space.PORT, .address = address, .bits = bits }
    }

    // The generic address structure (12 bytes) at `at` of `bytes`: its
    // space and a 64-bit address, read and written `bits` wide (what the
    // register is by ACPI: the width a table gives for a block is the
    // whole block's). None when the address is 0 or the space is not one
    // of Space's.
    pub fn generic(bytes: [*]const u8, at: usize, bits: usize) -> Register {
        const space = @intCast(usize, bytes[at])
        const address = Bytes.read64(bytes, at + 4)
        if address == 0 || space > Space.PCI { return none() }
        return Register.{ .space = space, .address = address, .bits = bits }
    }

    pub fn present(self: Self) -> bool { return self.space != Space.NONE }

    pub fn equals(self: Self, other: Register) -> bool { return self.space == other.space && self.address == other.address }

    // In memory: the register in the kernel's view (uncached); 0 when it
    // cannot be mapped.
    fn mapped(self: Self) -> usize { return memory.Device.map(self.address, 4, memory.Device.UNCACHED) }

    // In the PCI configuration space: the device's address (bus 0; the
    // structure has the device in bits 32..47 and the function in
    // 16..31) and the register's offset there.
    fn device(self: Self) -> usize { return pci.Pci.at((self.address >> 32) & 0x1F, (self.address >> 16) & 0x7) }
    fn offset(self: Self) -> usize { return self.address & 0xFF }

    pub fn read(self: Self) -> usize {
        if self.space == Space.PORT {
            if self.bits == 8 { return cpu.Port.in8(self.address) }
            if self.bits == 16 { return cpu.Port.in16(self.address) }
            return cpu.Port.in32(self.address)
        }
        if self.space == Space.MEMORY {
            const at = self.mapped()
            if at == 0 { return 0 }
            if self.bits == 8 { return @intCast(usize, byteAt(at).*) }
            if self.bits == 16 { return @intCast(usize, wordAt(at).*) }
            return @intCast(usize, longAt(at).*)
        }
        if self.space == Space.PCI {
            const shift = (self.offset() & 3) * 8
            const value = pci.Pci.read(self.device(), self.offset()) >> @intCast(u6, shift)
            return if self.bits == 8 { value & 0xFF } else if self.bits == 16 { value & 0xFFFF } else { value }
        }
        return 0
    }

    pub fn write(self: Self, value: usize) -> void {
        if self.space == Space.PORT {
            if self.bits == 8 { cpu.Port.out8(self.address, value) } else if self.bits == 16 { cpu.Port.out16(self.address, value) } else { cpu.Port.out32(self.address, value) }
        } else if self.space == Space.MEMORY {
            const at = self.mapped()
            if at == 0 { return }
            if self.bits == 8 {
                byteAt(at).* = @intCast(u8, value & 0xFF)
            } else if self.bits == 16 {
                wordAt(at).* = @intCast(u16, value & 0xFFFF)
            } else {
                longAt(at).* = @intCast(u32, value & 0xFFFFFFFF)
            }
        } else if self.space == Space.PCI {
            // (The configuration space is written 32 bits at a time: the
            // register's bits put into what is there.)
            const shift = (self.offset() & 3) * 8
            const mask: usize = if self.bits == 8 { 0xFF } else if self.bits == 16 { 0xFFFF } else { 0xFFFFFFFF }
            const old = pci.Pci.read(self.device(), self.offset())
            pci.Pci.write(self.device(), self.offset(), (old & ~(mask << @intCast(u6, shift))) | ((value & mask) << @intCast(u6, shift)))
        }
    }
}

// What the FADT ("FACP", the fixed description) says of the system's end.
pub const Fixed = struct {
    // Its flags: the reset register is there; no PM1 blocks at all (a
    // hardware-reduced platform sleeps through a register of its own).
    const RESET_SUPPORTED: usize = 0x400
    const HARDWARE_REDUCED: usize = 0x100000

    found: bool
    revision: usize
    // The DSDT's physical address (0: none named).
    dsdt: usize
    // The port a command is written to for the firmware (0: none; ACPI
    // mode is on from the start then) and the command that turns ACPI
    // mode on.
    command: usize
    enable: usize
    // PM1's event blocks (the status register is its first half) and
    // control blocks; b's where a machine has a second.
    event: Register
    control: Register
    controlB: Register
    // The control blocks as the older fields name them, where they differ
    // from the extended ones (a firmware's extended field can be wrong).
    controlOld: Register
    // The reset register and the value written to it.
    reset: Register
    resetValue: usize
    // A hardware-reduced platform's sleep control register.
    reduced: bool
    sleep: Register

    // The register a 32-bit field (at `old`) and, in a table long enough
    // for it, an extended one (at `extended`) name: the extended when it
    // names one, as ACPI says.
    fn block(bytes: [*]const u8, length: usize, old: usize, extended: usize, bits: usize) -> Register {
        if extended + 12 <= length {
            const named = Register.generic(bytes, extended, bits)
            if named.present() && named.space != Space.PCI { return named }
        }
        if old + 4 <= length { return Register.port(Bytes.read32(bytes, old), bits) }
        return Register.none()
    }

    // The FADT among the tables `from` (root's) names, read.
    pub fn read(from: usize) -> Fixed {
        var fixed = Fixed.{ .found = false, .revision = 0, .dsdt = 0, .command = 0, .enable = 0, .event = Register.none(), .control = Register.none(), .controlB = Register.none(), .controlOld = Register.none(), .reset = Register.none(), .resetValue = 0, .reduced = false, .sleep = Register.none() }
        const at = table(from, "FACP", 0)
        if at == 0 { return fixed }
        const bytes = Bytes.pointer(at)
        const length = lengthOf(at)
        // (ACPI 1.0's table: 116 bytes, to its flags.)
        if length < 116 { return fixed }
        fixed.found = true
        fixed.revision = @intCast(usize, bytes[8])
        fixed.dsdt = Bytes.read32(bytes, 40)
        if length >= 148 && Bytes.read64(bytes, 140) != 0 { fixed.dsdt = Bytes.read64(bytes, 140) }
        fixed.command = Bytes.read32(bytes, 48)
        fixed.enable = @intCast(usize, bytes[52])
        const flags = Bytes.read32(bytes, 112)
        fixed.reduced = fixed.revision >= 5 && flags & HARDWARE_REDUCED != 0
        fixed.event = block(bytes, length, 56, 148, 16)
        fixed.control = block(bytes, length, 64, 172, 16)
        fixed.controlB = block(bytes, length, 68, 184, 16)
        fixed.controlOld = Register.port(Bytes.read32(bytes, 64), 16)
        if fixed.controlOld.equals(fixed.control) { fixed.controlOld = Register.none() }
        if length >= 129 && flags & RESET_SUPPORTED != 0 {
            fixed.reset = Register.generic(bytes, 116, 8)
            fixed.resetValue = @intCast(usize, bytes[128])
        }
        if fixed.reduced && length >= 256 { fixed.sleep = Register.generic(bytes, 244, 8) }
        return fixed
    }
}

// AML's encodings, as far as a sleep state's package uses them.
const Aml = struct {
    const ZERO: u8 = 0x00
    const ONE: u8 = 0x01
    const NAME: u8 = 0x08
    const BYTE: u8 = 0x0A
    const WORD: u8 = 0x0B
    const DWORD: u8 = 0x0C
    const PACKAGE: u8 = 0x12
    const ROOT: u8 = 0x5C

    // The constant at `at` of `bytes` (before `end`): whether it is one,
    // its value, and where the next thing begins.
    fn constant(bytes: [*]const u8, at: usize, end: usize) -> (bool, usize, usize) {
        if at >= end { return -> (false, 0, at) }
        const op = bytes[at]
        if op == ZERO { return -> (true, 0, at + 1) }
        if op == ONE { return -> (true, 1, at + 1) }
        if op == BYTE && at + 2 <= end { return -> (true, @intCast(usize, bytes[at + 1]), at + 2) }
        if op == WORD && at + 3 <= end { return -> (true, Bytes.read16(bytes, at + 1), at + 3) }
        if op == DWORD && at + 5 <= end { return -> (true, Bytes.read32(bytes, at + 1), at + 5) }
        return -> (false, 0, at)
    }

    // The package at `at` of `bytes` (a table `length` long): whether it
    // is one whose first two elements are constants, and those. A
    // package: its op, its length (the first byte's top two bits count
    // the bytes that follow it; with none the low six are the length,
    // else the low four are its lowest bits), a count of elements, the
    // elements. The length counts from its own first byte and may not
    // reach beyond the table.
    fn firstTwo(bytes: [*]const u8, at: usize, length: usize) -> (bool, usize, usize) {
        if at + 2 > length || bytes[at] != PACKAGE { return -> (false, 0, 0) }
        const lead = @intCast(usize, bytes[at + 1])
        const more = lead >> 6
        if at + 2 + more > length { return -> (false, 0, 0) }
        var size = if more == 0 { lead & 0x3F } else { lead & 0x0F }
        var k: usize = 0
        while k < more {
            size |= @intCast(usize, bytes[at + 2 + k]) << @intCast(u6, 4 + 8 * k)
            k += 1
        }
        const end = at + 1 + size
        const next = at + 2 + more
        if end > length || next >= end { return -> (false, 0, 0) }
        const count = bytes[next]
        if count < 2 { return -> (false, 0, 0) }
        const first = constant(bytes, next + 1, end)
        if !first.0 { return -> (false, 0, 0) }
        const second = constant(bytes, first.2, end)
        if !second.0 { return -> (false, 0, 0) }
        return -> (true, first.1, second.1)
    }

    // The package the name `name` (four bytes: "_S5_") is given in the
    // AML table at `table`: whether it is found, and its first two
    // values. A name's definition: the name op, the name (after a root
    // prefix or not), then its value.
    fn named(table: usize, name: []const u8) -> (bool, usize, usize) {
        const bytes = Bytes.pointer(table)
        const length = lengthOf(table)
        var at: usize = HEADER + 1
        while at + 4 < length {
            if same(bytes + at, name) && (bytes[at - 1] == NAME || (at >= HEADER + 2 && bytes[at - 1] == ROOT && bytes[at - 2] == NAME)) {
                const values = firstTwo(bytes, at + 4, length)
                if values.0 { return values }
            }
            at += 1
        }
        return -> (false, 0, 0)
    }
}

// The sleep types of the state `name` ("_S5_": soft off) for the PM1a
// and PM1b control registers (three bits each): from the DSDT at the
// physical `dsdt`, else from an SSDT among the tables `from` names;
// whether the state was found.
pub fn sleepTypes(from: usize, dsdt: usize, name: []const u8) -> (bool, usize, usize) {
    const main = tableAt(dsdt)
    if main != 0 && same(Bytes.pointer(main), "DSDT") {
        const values = Aml.named(main, name)
        if values.0 { return -> (true, values.1 & 7, values.2 & 7) }
    }
    var nth: usize = 0
    while nth < 64 {
        const more = table(from, "SSDT", nth)
        if more == 0 { break }
        const values = Aml.named(more, name)
        if values.0 { return -> (true, values.1 & 7, values.2 & 7) }
        nth += 1
    }
    return -> (false, 0, 0)
}
