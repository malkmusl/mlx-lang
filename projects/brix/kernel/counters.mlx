// What the kernel did since the boot, counted for system_info (call 52:
// native/system.mlx) and the sysinfo tool: the page faults it served (a
// page made or copied), the system calls, the switches from one process
// to another, the devices' message-signalled interrupts it took (the
// network device's, the USB controllers', the GPU's: none on a machine
// where they are looked at on the timer tick alone). A word each, counted
// where it happens (trap.mlx, scheduler.mlx); the counts say where a run's
// time goes.
pub const Counters = struct {
    pageFaults: usize
    systemCalls: usize
    switches: usize
    deviceInterrupts: usize
}

var counters: Counters = undefined // (per run)

pub fn init() -> void {
    counters.pageFaults = 0
    counters.systemCalls = 0
    counters.switches = 0
    counters.deviceInterrupts = 0
}

pub fn all() -> *Counters { return &counters }
