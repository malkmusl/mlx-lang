// A text console the kernel draws on the framebuffers, so a machine with no
// serial line still shows the hardware bring-up (the same text console.mlx
// sends to COM1 and the log buffer). White on black, the built-in 8x16
// font (font/data.mlx), scrolling when the screen fills. Off until
// enable(): the displays are set up partway through boot, and on a normal
// boot the splash and the desktop take the framebuffers afterwards -- it is
// the diagnostic path (an image with no graphical session) where the log
// stays on screen to be read or photographed.
//
// Every display has the console (a machine with two graphics adapters
// shows the boot on both monitors, whichever the user sits at): each its
// own grid for its own size, the same text on all of them. A program
// that maps a display's node takes that display; the console goes on on
// the others until they are mapped too.
//
// The framebuffer is only ever written: reading a real adapter's memory
// back is slower than writing it by orders of magnitude (a scroll that
// copied the picture up took seconds a line at 3840x1080). What each cell
// shows is kept in a grid of characters here, and a scroll draws again only
// the cells whose character changes.
const memory = @import("./memory.mlx")
const display = @import("./display.mlx")
const displays = @import("./displays.mlx")
const font = @import("./font/data.mlx")

const WHITE: u32 = 0xFFFFFFFF
const BLACK: u32 = 0x00000000

// The grid's most columns and rows (3840x2160 at 8x16); a larger display
// shows the console in its top left part.
const MAX_COLS: usize = 480
const MAX_ROWS: usize = 135
// A cell that shows nothing (black).
const BLANK: u8 = 0

// A display's console.
const Screen = struct {
    on: bool
    // The framebuffer is in the kernel's view, at `base`; the picture it
    // was made for (the display's address and size then: another one
    // since means the console is to be made anew, reshape).
    mapped: bool
    base: usize
    physical: usize
    bytes: usize
    pitchPx: usize // pixels from one row to the next
    cols: usize
    rows: usize
    curCol: usize
    curRow: usize
    // Made anew a moment ago: what the log holds is drawn on it alone
    // (console.mlx, then `settle`).
    fresh: bool
    // What each cell shows, a row after the other; the screen's first row
    // is the grid's row `top` (a scroll moves `top`, not the rows).
    cells: [MAX_COLS * MAX_ROWS]u8
    top: usize

    fn pixels(self: *const Self) -> [*]u32 { unsafe { return @ptrFromInt([*]u32, self.*.base) } }

    // The grid's index of the screen's cell.
    fn cell(self: *const Self, col: usize, row: usize) -> usize { return ((self.*.top + row) % self.*.rows) * self.*.cols + col }

    // The cell's 8x16 pixels: the character's glyph, or black.
    fn draw(self: *const Self, col: usize, row: usize, code: u8) -> void {
        const fb = self.pixels()
        const originX = col * font.CELL_W
        const originY = row * font.CELL_H
        const printable = code >= @intCast(u8, font.FIRST) && @intCast(usize, code) < font.FIRST + font.COUNT
        const index = if printable { (@intCast(usize, code) - font.FIRST) * font.CELL_H } else { 0 }
        var gy: usize = 0
        while gy < font.CELL_H {
            const line: u8 = if printable { font.GLYPHS[index + gy] } else { 0 }
            const rowBase = (originY + gy) * self.*.pitchPx + originX
            var gx: usize = 0
            while gx < font.CELL_W {
                const lit = (line >> @intCast(u3, 7 - gx)) & 1
                fb[rowBase + gx] = if lit != 0 { WHITE } else { BLACK }
                gx += 1
            }
            gy += 1
        }
    }

    // The grid emptied and the cursor at the top; the screen's pixels are
    // painted black when `paint` (a kernel fault's report is drawn over
    // whatever the screen shows instead: every cell it writes paints
    // itself).
    fn clear(self: *Self, paint: bool) -> void {
        var k: usize = 0
        while k < self.*.cols * self.*.rows {
            self.*.cells[k] = BLANK
            k += 1
        }
        self.*.top = 0
        self.*.curCol = 0
        self.*.curRow = 0
        if !paint { return }
        const fb = self.pixels()
        const height = self.*.rows * font.CELL_H
        const width = self.*.cols * font.CELL_W
        var y: usize = 0
        while y < height {
            const rowBase = y * self.*.pitchPx
            var x: usize = 0
            while x < width {
                fb[rowBase + x] = BLACK
                x += 1
            }
            y += 1
        }
    }

    // The console on the display `shown` as it is now: its framebuffer in
    // the kernel's view, the grid for its size, its part of the screen
    // cleared. False when there is no picture or memory is out.
    fn open(self: *Self, shown: *const display.Display) -> bool {
        self.*.on = false
        self.*.mapped = false
        if !shown.*.present { return false }
        const physical = shown.*.address
        const bytes = shown.*.pitch * shown.*.height
        if physical == 0 || bytes == 0 { return false }
        self.*.base = memory.Device.map(physical, bytes, memory.Device.WRITE_COMBINING)
        if self.*.base == 0 { return false }
        self.*.physical = physical
        self.*.bytes = bytes
        self.*.pitchPx = shown.*.pitch / 4
        self.*.cols = shown.*.width / font.CELL_W
        self.*.rows = shown.*.height / font.CELL_H
        if self.*.cols > MAX_COLS { self.*.cols = MAX_COLS }
        if self.*.rows > MAX_ROWS { self.*.rows = MAX_ROWS }
        if self.*.cols == 0 || self.*.rows == 0 || self.*.pitchPx < self.*.cols * font.CELL_W { return false }
        self.*.mapped = true
        self.clear(true)
        self.*.on = true
        return true
    }

    // Every row a row up, the last one empty: only the cells whose
    // character changes are drawn (none of the framebuffer is read).
    fn scroll(self: *Self) -> void {
        var row: usize = 0
        while row < self.*.rows {
            var col: usize = 0
            while col < self.*.cols {
                const shown = self.*.cells[self.cell(col, row)]
                const wanted: u8 = if row + 1 < self.*.rows { self.*.cells[self.cell(col, row + 1)] } else { BLANK }
                if shown != wanted { self.draw(col, row, wanted) }
                col += 1
            }
            row += 1
        }
        // The grid's first row is its last now, empty.
        var col: usize = 0
        while col < self.*.cols {
            self.*.cells[self.cell(col, 0)] = BLANK
            col += 1
        }
        self.*.top = (self.*.top + 1) % self.*.rows
    }

    fn newline(self: *Self) -> void {
        self.*.curCol = 0
        self.*.curRow += 1
        if self.*.curRow >= self.*.rows {
            self.scroll()
            self.*.curRow = self.*.rows - 1
        }
    }

    // One byte of the kernel's output: "\n" wraps the line, "\r" returns
    // to the start of it, other control bytes are dropped; a printable
    // byte is drawn and the cursor advances, wrapping at the right edge.
    fn put(self: *Self, byte: u8) -> void {
        if byte == 10 {
            self.newline()
            return
        }
        if byte == 13 {
            self.*.curCol = 0
            return
        }
        if byte < 0x20 || byte >= 0x7F { return }
        if self.*.curCol >= self.*.cols { self.newline() }
        self.*.cells[self.cell(self.*.curCol, self.*.curRow)] = byte
        self.draw(self.*.curCol, self.*.curRow, byte)
        self.*.curCol += 1
    }
}

// The displays' consoles (display.at(k)'s is screens[k]); how many
// displays the console has (0 until enable()); and whether what is put
// goes to the consoles made anew alone (reshape, until settle).
var screens: [displays.MAX]Screen = undefined // (per run)
var known: usize = 0 // (per run)
var freshOnly = false // (per run)

// Whether the console draws on the main display (no program has it).
pub fn enabled() -> bool { return known != 0 && screens[display.screen().*.number].on }

// Stops drawing on display `number` (a graphical program has taken its
// framebuffer through node_map; the kernel must not write on it any
// more).
pub fn disable(number: usize) -> void {
    if number < known { screens[number].on = false }
}

// Turns the framebuffer console on, on every display the kernel found;
// false when there is none or memory is out. Each console's part of its
// screen is cleared.
pub fn enable() -> bool {
    if known != 0 { return true }
    var any = false
    var k: usize = 0
    while k < display.count() {
        const s = &screens[k]
        s.*.fresh = false
        if s.open(display.at(k)) { any = true }
        k += 1
    }
    if any { known = display.count() }
    return any
}

// The consoles on new pictures: a display changed under its console (the
// GPU's driver set the monitor's own mode there). Each console that was
// on and whose display is another picture now is made anew for the new
// size and its part of the new picture cleared; what the screen showed is
// the caller's to draw again, and goes to these consoles alone until
// `settle` (console.mlx). False when no console was made anew (none was
// on such a display, or the new picture cannot be had).
pub fn reshape() -> bool {
    var any = false
    var k: usize = 0
    while k < known {
        const shown = display.at(k)
        const s = &screens[k]
        if s.*.on && (s.*.physical != shown.*.address || s.*.bytes != shown.*.pitch * shown.*.height || s.*.pitchPx != shown.*.pitch / 4 || s.*.cols != columnsFor(shown) || s.*.rows != rowsFor(shown)) {
            if s.open(shown) {
                s.*.fresh = true
                any = true
            }
        }
        k += 1
    }
    freshOnly = any
    return any
}

fn columnsFor(shown: *const display.Display) -> usize {
    const cols = shown.*.width / font.CELL_W
    return if cols > MAX_COLS { MAX_COLS } else { cols }
}

fn rowsFor(shown: *const display.Display) -> usize {
    const rows = shown.*.height / font.CELL_H
    return if rows > MAX_ROWS { MAX_ROWS } else { rows }
}

// What is put goes to every console again (after reshape's caller has
// drawn the log on the new ones).
pub fn settle() -> void {
    var k: usize = 0
    while k < known {
        screens[k].fresh = false
        k += 1
    }
    freshOnly = false
}

// The console on every screen again whoever draws there (the kernel
// stopped by a fault of its own: its report is the last thing the screens
// show), from the top on those a program had; false when no display was
// ever the console's.
pub fn takeOver() -> bool {
    var any = false
    var k: usize = 0
    while k < known {
        const s = &screens[k]
        if s.*.mapped {
            any = true
            if !s.*.on {
                s.clear(false)
                s.*.on = true
            }
        }
        k += 1
    }
    return any
}

// Draws one byte of the kernel's output on every display whose console
// is on.
pub fn put(byte: u8) -> void {
    var k: usize = 0
    while k < known {
        const s = &screens[k]
        if s.*.on && (!freshOnly || s.*.fresh) { s.put(byte) }
        k += 1
    }
}
