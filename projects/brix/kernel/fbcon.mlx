// A text console the kernel draws on the framebuffer, so a machine with no
// serial line still shows the hardware bring-up (the same text console.mlx
// sends to COM1 and the log buffer). White on black, the built-in 8x16
// font (font/data.mlx), scrolling when the screen fills. Off until
// enable(): the display is set up partway through boot, and on a normal
// boot the splash and the desktop take the framebuffer afterwards -- it is
// the diagnostic path (an image with no graphical session) where the log
// stays on screen to be read or photographed.
//
// The framebuffer is only ever written: reading a real adapter's memory
// back is slower than writing it by orders of magnitude (a scroll that
// copied the picture up took seconds a line at 3840x1080). What each cell
// shows is kept in a grid of characters here, and a scroll draws again only
// the cells whose character changes.
const layout = @import("../layout.mlx")
const memory = @import("./memory.mlx")
const display = @import("./display.mlx")
const font = @import("./font/data.mlx")

const WHITE: u32 = 0xFFFFFFFF
const BLACK: u32 = 0x00000000

// The grid's most columns and rows (3840x2160 at 8x16); a larger display
// shows the console in its top left part.
const MAX_COLS: usize = 480
const MAX_ROWS: usize = 135
// A cell that shows nothing (black).
const BLANK: u8 = 0

var on = false // (per run)
var mapped = false // the framebuffer is in the kernel's view (per run)
var base: usize = 0 // the framebuffer in the kernel's view (per run)
var pitchPx: usize = 0 // pixels from one row to the next (per run)
var cols: usize = 0 // (per run)
var rows: usize = 0 // (per run)
var curCol: usize = 0 // (per run)
var curRow: usize = 0 // (per run)
// What each cell shows, a row after the other; the screen's first row is
// the grid's row `top` (a scroll moves `top`, not the rows).
var cells: [MAX_COLS * MAX_ROWS]u8 = undefined // (per run)
var top: usize = 0 // (per run)

pub fn enabled() -> bool { return on }

// Stops drawing (a graphical program has taken the framebuffer through
// node_map; the kernel must not write on it any more).
pub fn disable() -> void { on = false }

fn pixels() -> [*]u32 { unsafe { return @ptrFromInt([*]u32, base) } }

// The grid's index of the screen's cell.
fn cell(col: usize, row: usize) -> usize { return ((top + row) % rows) * cols + col }

// The cell's 8x16 pixels: the character's glyph, or black.
fn draw(col: usize, row: usize, code: u8) -> void {
    const fb = pixels()
    const originX = col * font.CELL_W
    const originY = row * font.CELL_H
    const printable = code >= @intCast(u8, font.FIRST) && @intCast(usize, code) < font.FIRST + font.COUNT
    const index = if printable { (@intCast(usize, code) - font.FIRST) * font.CELL_H } else { 0 }
    var gy: usize = 0
    while gy < font.CELL_H {
        const line: u8 = if printable { font.GLYPHS[index + gy] } else { 0 }
        const rowBase = (originY + gy) * pitchPx + originX
        var gx: usize = 0
        while gx < font.CELL_W {
            const lit = (line >> @intCast(u3, 7 - gx)) & 1
            fb[rowBase + gx] = if lit != 0 { WHITE } else { BLACK }
            gx += 1
        }
        gy += 1
    }
}

// The grid emptied and the cursor at the top; the screen's pixels are
// painted black when `paint` (a kernel fault's report is drawn over
// whatever the screen shows instead: every cell it writes paints itself).
fn clear(paint: bool) -> void {
    var k: usize = 0
    while k < cols * rows {
        cells[k] = BLANK
        k += 1
    }
    top = 0
    curCol = 0
    curRow = 0
    if !paint { return }
    const fb = pixels()
    const height = rows * font.CELL_H
    const width = cols * font.CELL_W
    var y: usize = 0
    while y < height {
        const rowBase = y * pitchPx
        var x: usize = 0
        while x < width {
            fb[rowBase + x] = BLACK
            x += 1
        }
        y += 1
    }
}

// Turns the framebuffer console on from the display the kernel found; false
// when there is no display or memory is out. The console's part of the
// screen is cleared.
pub fn enable() -> bool {
    if on { return true }
    const screen = display.screen()
    if !screen.*.present { return false }
    const physical = screen.*.address
    const bytes = screen.*.pitch * screen.*.height
    if physical == 0 || bytes == 0 { return false }
    if !mapped {
        base = memory.Device.map(physical, bytes, memory.Device.WRITE_COMBINING)
        if base == 0 { return false }
        pitchPx = screen.*.pitch / 4
        cols = screen.*.width / font.CELL_W
        rows = screen.*.height / font.CELL_H
        if cols > MAX_COLS { cols = MAX_COLS }
        if rows > MAX_ROWS { rows = MAX_ROWS }
        if cols == 0 || rows == 0 || pitchPx < cols * font.CELL_W { return false }
        mapped = true
    }
    clear(true)
    on = true
    return true
}

// The console on another picture: the display changed under it (the GPU's
// driver set the monitor's own mode). The grid is made anew for the new
// size and its part of the new picture cleared; what the screen showed is
// the caller's to draw again (console.mlx). False when the console was
// not on, or the new picture cannot be had.
pub fn reshape() -> bool {
    if !on { return false }
    on = false
    mapped = false
    return enable()
}

// The console on the screen again whoever draws there (the kernel stopped
// by a fault of its own: its report is the last thing the screen shows),
// from the top; false when the display was never the console's.
pub fn takeOver() -> bool {
    if !mapped { return false }
    if !on {
        clear(false)
        on = true
    }
    return true
}

// Every row a row up, the last one empty: only the cells whose character
// changes are drawn (none of the framebuffer is read).
fn scroll() -> void {
    var row: usize = 0
    while row < rows {
        var col: usize = 0
        while col < cols {
            const shown = cells[cell(col, row)]
            const wanted: u8 = if row + 1 < rows { cells[cell(col, row + 1)] } else { BLANK }
            if shown != wanted { draw(col, row, wanted) }
            col += 1
        }
        row += 1
    }
    // The grid's first row is its last now, empty.
    var col: usize = 0
    while col < cols {
        cells[cell(col, 0)] = BLANK
        col += 1
    }
    top = (top + 1) % rows
}

fn newline() -> void {
    curCol = 0
    curRow += 1
    if curRow >= rows {
        scroll()
        curRow = rows - 1
    }
}

// Draws one byte of the kernel's output. "\n" wraps the line, "\r" returns
// to the start of it, other control bytes are dropped; a printable byte is
// drawn and the cursor advances, wrapping at the right edge.
pub fn put(byte: u8) -> void {
    if !on { return }
    if byte == 10 {
        newline()
        return
    }
    if byte == 13 {
        curCol = 0
        return
    }
    if byte < 0x20 || byte >= 0x7F { return }
    if curCol >= cols { newline() }
    cells[cell(curCol, curRow)] = byte
    draw(curCol, curRow, byte)
    curCol += 1
}
