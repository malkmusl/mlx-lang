// A text console the kernel draws on the framebuffer, so a machine with no
// serial line still shows the hardware bring-up (the same text console.mlx
// sends to COM1 and the log buffer). White on black, the built-in 8x16
// font (font/data.mlx), scrolling when the screen fills. Off until
// enable(): the display is set up partway through boot, and on a normal
// boot the splash and the desktop take the framebuffer afterwards -- it is
// the diagnostic path (an image with no graphical session) where the log
// stays on screen to be read or photographed.
const layout = @import("../layout.mlx")
const memory = @import("./memory.mlx")
const Bytes = @import("./bytes.mlx").Bytes
const display = @import("./display.mlx")
const font = @import("./font/data.mlx")

const Page = memory.Page

const WHITE: u32 = 0xFFFFFFFF
const BLACK: u32 = 0x00000000

var on = false // (per run)
var base: usize = 0 // the framebuffer in the kernel's view (per run)
var widthPx: usize = 0 // (per run)
var heightPx: usize = 0 // (per run)
var pitchPx: usize = 0 // pixels from one row to the next (per run)
var cols: usize = 0 // (per run)
var rows: usize = 0 // (per run)
var curCol: usize = 0 // (per run)
var curRow: usize = 0 // (per run)

pub fn enabled() -> bool { return on }

// Stops drawing (a graphical program has taken the framebuffer through
// node_map; the kernel must not write on it any more).
pub fn disable() -> void { on = false }

fn pixels() -> [*]u32 { unsafe { return @ptrFromInt([*]u32, base) } }

// Maps the 2 MiB pages holding [physical, physical + bytes) uncached in the
// kernel's view (as the device drivers map their registers); false when
// memory is out.
fn mapRangeUncached(physical: usize, bytes: usize) -> bool {
    const pdpt = Bytes.pointer(layout.Memory.virtual(layout.Memory.BLOB + layout.Blob.PDPT))
    var page = (physical >> 21) << 21
    const end = physical + bytes
    while page < end {
        const slot = (page >> 30) & 511
        const entry = Bytes.read64(pdpt, slot * 8)
        // A 1 GiB page already covering this GiB (PS bit): the address is
        // reachable at Memory.virtual(page) as it is; do not overwrite the
        // entry (it is not a page-directory pointer).
        if entry & 1 != 0 && entry & 0x80 != 0 {
            page += 1 << 21
            continue
        }
        if entry & 1 == 0 {
            const directory = memory.allFrames().allocate()
            if directory == 0 { return false }
            Bytes.zeroWords(layout.Memory.virtual(directory), Page.SIZE / 8)
            Bytes.write64(pdpt, slot * 8, directory | 0x3)
        }
        const directory = Bytes.read64(pdpt, slot * 8) & Page.ADDRESS
        // Present, writable, a 2 MiB page, write-through, cache-disabled.
        Bytes.write64(Bytes.pointer(layout.Memory.virtual(directory)), ((page >> 21) & 511) * 8, page | 0x83 | 0x18)
        page += 1 << 21
    }
    return true
}

// Turns the framebuffer console on from the display the kernel found; false
// when there is no display or memory is out. The screen is cleared.
pub fn enable() -> bool {
    if on { return true }
    const screen = display.screen()
    if !screen.*.present { return false }
    const physical = screen.*.address
    const bytes = screen.*.pitch * screen.*.height
    if physical == 0 || bytes == 0 { return false }
    if !mapRangeUncached(physical, bytes) { return false }
    base = layout.Memory.virtual(physical)
    widthPx = screen.*.width
    heightPx = screen.*.height
    pitchPx = screen.*.pitch / 4
    cols = widthPx / font.CELL_W
    rows = heightPx / font.CELL_H
    curCol = 0
    curRow = 0
    if cols == 0 || rows == 0 { return false }
    clear()
    on = true
    return true
}

fn clear() -> void {
    const fb = pixels()
    var i: usize = 0
    const total = pitchPx * heightPx
    while i < total {
        fb[i] = BLACK
        i += 1
    }
}

// Rolls the whole picture up by one text row; the last row is cleared.
fn scroll() -> void {
    const fb = pixels()
    const rowPixels = font.CELL_H * pitchPx
    const top = (heightPx - font.CELL_H) * pitchPx
    var i: usize = 0
    while i < top {
        fb[i] = fb[i + rowPixels]
        i += 1
    }
    while i < heightPx * pitchPx {
        fb[i] = BLACK
        i += 1
    }
}

fn drawGlyph(col: usize, row: usize, code: usize) -> void {
    const fb = pixels()
    const index = (code - font.FIRST) * font.CELL_H
    const originX = col * font.CELL_W
    const originY = row * font.CELL_H
    var gy: usize = 0
    while gy < font.CELL_H {
        const line = font.GLYPHS[index + gy]
        const rowBase = (originY + gy) * pitchPx + originX
        var gx: usize = 0
        while gx < font.CELL_W {
            const lit = (line >> @intCast(u3, 7 - gx)) & 1
            fb[rowBase + gx] = if lit != 0 { WHITE } else { BLACK }
            gx += 1
        }
        gy += 1
    }
}

fn newline() -> void {
    curCol = 0
    curRow += 1
    if curRow >= rows {
        scroll()
        curRow = rows - 1
    }
}

// Draws one byte of the kernel's output. "\n" wraps the line, "\r" returns
// to the start of it, other control bytes are dropped; a printable byte is
// drawn and the cursor advances, wrapping at the right edge.
pub fn put(byte: u8) -> void {
    if !on { return }
    if byte == 10 {
        newline()
        return
    }
    if byte == 13 {
        curCol = 0
        return
    }
    if byte < 0x20 || byte >= 0x7F { return }
    if curCol >= cols { newline() }
    drawGlyph(curCol, curRow, @intCast(usize, byte))
    curCol += 1
}
