// The disks, whatever drives them: virtio-blk in a VM, AHCI (SATA) on
// real hardware. The block layer (block.mlx) and the boot speak to a disk
// through here, so neither one needs to know which driver it is. Each
// driver finds its own disks (virtio.probeAll, ahci.probeAll); probeAll
// here registers them all in order, virtio first.
const virtio = @import("./virtio.mlx")
const ahci = @import("./ahci.mlx")
const nvme = @import("./nvme.mlx")

pub const VIRTIO: u8 = 0
pub const AHCI: u8 = 1
pub const NVME: u8 = 2
pub const MAX: usize = virtio.MAX_DISKS + ahci.MAX_DISKS + nvme.MAX_DISKS

pub const Disk = struct {
    // Which driver, and this disk's index within that driver.
    kind: u8
    index: usize

    pub fn read(self: *const Self, offset: usize, into: [*]u8, length: usize) -> isize {
        if self.*.kind == VIRTIO { return virtio.diskAt(self.*.index).read(offset, into, length) }
        if self.*.kind == AHCI { return ahci.diskAt(self.*.index).read(offset, into, length) }
        return nvme.diskAt(self.*.index).read(offset, into, length)
    }

    pub fn write(self: *const Self, offset: usize, from: [*]const u8, length: usize) -> isize {
        if self.*.kind == VIRTIO { return virtio.diskAt(self.*.index).write(offset, from, length) }
        if self.*.kind == AHCI { return ahci.diskAt(self.*.index).write(offset, from, length) }
        return nvme.diskAt(self.*.index).write(offset, from, length)
    }

    pub fn flush(self: *const Self) -> bool {
        if self.*.kind == VIRTIO { return virtio.diskAt(self.*.index).flush() }
        if self.*.kind == AHCI { return ahci.diskAt(self.*.index).flush() }
        return nvme.diskAt(self.*.index).flush()
    }

    pub fn sizeInBytes(self: *const Self) -> usize {
        if self.*.kind == VIRTIO { return virtio.diskAt(self.*.index).sizeInBytes() }
        if self.*.kind == AHCI { return ahci.diskAt(self.*.index).sizeInBytes() }
        return nvme.diskAt(self.*.index).sizeInBytes()
    }

    pub fn readOnly(self: *const Self) -> bool {
        if self.*.kind == VIRTIO { return virtio.diskAt(self.*.index).*.readOnly }
        if self.*.kind == AHCI { return ahci.diskAt(self.*.index).*.readOnly }
        return nvme.diskAt(self.*.index).*.readOnly
    }

    // What the disk is driven by, for the boot message.
    pub fn driver(self: *const Self) -> []const u8 {
        if self.*.kind == VIRTIO { return "virtio" }
        if self.*.kind == AHCI { return "AHCI" }
        return "NVMe"
    }
}

var disks: [MAX]Disk = undefined // (per run)
var diskCount: usize = 0 // (per run)

pub fn count() -> usize { return diskCount }
pub fn at(index: usize) -> *Disk { return &disks[index] }

fn register(kind: u8, index: usize) -> void {
    if diskCount >= MAX { return }
    disks[diskCount].kind = kind
    disks[diskCount].index = index
    diskCount += 1
}

// Every driver's disks, in order: the ground block.mlx stands on.
pub fn probeAll() -> void {
    diskCount = 0
    const vcount = virtio.probeAll()
    var k: usize = 0
    while k < vcount {
        register(VIRTIO, k)
        k += 1
    }
    const acount = ahci.probeAll()
    k = 0
    while k < acount {
        register(AHCI, k)
        k += 1
    }
    const ncount = nvme.probeAll()
    k = 0
    while k < ncount {
        register(NVME, k)
        k += 1
    }
}
