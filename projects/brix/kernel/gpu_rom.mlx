// The object table (ATOM_OBJECT_HEADER; the offsets in it count from the
// table's start): where the connectors and the display paths lie. An object table (ATOM_OBJECT_TABLE) is a count and objects
// of eight bytes (ATOM_OBJECT): the object's number, where its sources
// and destinations are listed (a count and that many object numbers),
// where its records begin (ATOM_COMMON_RECORD_HEADER: a type and a size,
// ended by type 0xFF or size 0). The display paths
// (ATOM_DISPLAY_OBJECT_PATH_TABLE: a count, then paths) are each
// (ATOM_DISPLAY_OBJECT_PATH) a device tag, the path's size, the
// connector, the GPU and the objects between.
pub const ATOM_OBJECT_HEADER__usConnectorObjectTableOffset: usize = 6
pub const ATOM_OBJECT_HEADER__usDisplayPathTableOffset: usize = 14
pub const ATOM_OBJECT_HEADER__size: usize = 16
pub const ATOM_OBJECT_TABLE__asObjects: usize = 4
pub const ATOM_OBJECT__usObjectID: usize = 0
pub const ATOM_OBJECT__usSrcDstTableOffset: usize = 2
pub const ATOM_OBJECT__usRecordOffset: usize = 4
pub const ATOM_OBJECT__size: usize = 8
pub const ATOM_DISPLAY_OBJECT_PATH_TABLE__asDispPath: usize = 4
pub const ATOM_DISPLAY_OBJECT_PATH__usSize: usize = 2
pub const ATOM_DISPLAY_OBJECT_PATH__usConnObjectId: usize = 4
pub const ATOM_DISPLAY_OBJECT_PATH__usGraphicObjIds: usize = 8
pub const ATOM_I2C_RECORD_TYPE: usize = 1
pub const ATOM_HPD_INT_RECORD_TYPE: usize = 2
pub const ATOM_RECORD_END_TYPE: usize = 0xFF
// (An I2C record: its line in the low four bits of its third byte, bit 7
// for the hardware's own I2C engine; a hot plug record: the pin's number
// in its third byte.)
pub const ATOM_I2C_RECORD__size: usize = 4
pub const ATOM_HPD_INT_RECORD__size: usize = 4

// An object's number (ObjectID.h): what it is, which of several, its
// kind.
pub const OBJECT_ID_MASK: usize = 0x00FF
pub const ENUM_ID_MASK: usize = 0x0700
pub const OBJECT_TYPE_MASK: usize = 0x7000
pub const ENUM_ID_SHIFT: usize = 8
pub const OBJECT_TYPE_SHIFT: usize = 12
pub const GRAPH_OBJECT_TYPE_ENCODER: usize = 0x2
pub const GRAPH_OBJECT_TYPE_CONNECTOR: usize = 0x3
pub const ENCODER_OBJECT_ID_INTERNAL_UNIPHY: usize = 0x1E
pub const ENCODER_OBJECT_ID_INTERNAL_UNIPHY1: usize = 0x20
pub const ENCODER_OBJECT_ID_INTERNAL_UNIPHY2: usize = 0x21
pub const ENCODER_OBJECT_ID_INTERNAL_UNIPHY3: usize = 0x25
pub const CONNECTOR_OBJECT_ID_SINGLE_LINK_DVI_I: usize = 0x01
pub const CONNECTOR_OBJECT_ID_DUAL_LINK_DVI_I: usize = 0x02
pub const CONNECTOR_OBJECT_ID_SINGLE_LINK_DVI_D: usize = 0x03
pub const CONNECTOR_OBJECT_ID_DUAL_LINK_DVI_D: usize = 0x04
pub const CONNECTOR_OBJECT_ID_VGA: usize = 0x05
pub const CONNECTOR_OBJECT_ID_HDMI_TYPE_A: usize = 0x0C
pub const CONNECTOR_OBJECT_ID_HDMI_TYPE_B: usize = 0x0D
pub const CONNECTOR_OBJECT_ID_LVDS: usize = 0x0E
pub const CONNECTOR_OBJECT_ID_DISPLAYPORT: usize = 0x13
pub const CONNECTOR_OBJECT_ID_eDP: usize = 0x14

pub const NONE: usize = 0xFFFFFFFF

// A stretch of memory addresses (no bytes: none).
pub const Stretch = struct {
    from: usize
    bytes: usize
}

// The memory window of a bridge whose configuration's long at
// PCI_MEMORY_BASE is `word` (the base in the low word, the limit in the
// high one; a limit below the base: the bridge passes no memory on).
pub fn windowOf(word: usize) -> Stretch {
    const base = ((word & 0xFFFF) & PCI_MEMORY_RANGE_MASK) << 16
    const limit = ((((word >> 16) & 0xFFFF) & PCI_MEMORY_RANGE_MASK) << 16) | 0xFFFFF
    if limit < base { return Stretch.{ .from = 0, .bytes = 0 } }
    return Stretch.{ .from = base, .bytes = limit + 1 - base }
}

// Whether a ROM of `size` bytes may be switched on at `address`: it lies
// wholly in `window` (the memory the bridge before the card passes on)
// and on none of `taken` (the card's other memories).
pub fn mayAnswer(address: usize, size: usize, window: *const Stretch, taken: []const Stretch) -> bool {
    if size == 0 || window.*.bytes == 0 { return false }
    if address < window.*.from || address + size > window.*.from + window.*.bytes { return false }
    var k: usize = 0
    while k < taken.length {
        if taken[k].bytes != 0 && address < taken[k].from + taken[k].bytes && taken[k].from < address + size { return false }
        k += 1
    }
    return true
}

// The card as the ROM is read from it: a long of its PCI configuration
// read and written; whether the ROM may be switched on at an address
// with a size (`mayAnswer`, with what the kernel knows of the bridge and
// the card); the bytes that lie at a physical address (the expansion
// ROM, when it is switched on) copied out, or false; a register of the
// card read and written by its number.
pub const Bus = struct {
    config: fn(usize) -> usize
    setConfig: fn(usize, usize) -> void
    clear: fn(usize, usize) -> bool
    window: fn(usize, []u8) -> bool
    read: fn(usize) -> u32
    write: fn(usize, u32) -> void
}

pub const Way = enum(u8) { none, vfct, expansion, registers }

// Where the card is on the PCI bus, and its vendor's and its own number.
pub const Place = struct {
    bus: usize
    device: usize
    function: usize
    vendor: usize
    product: usize
}

// What became of a way.
pub const Tried = enum(u8) {
    // Not tried: an earlier way gave the ROM.
    not_tried,
    // There is nothing to read that way: no such table (or none for this
    // card), no address for the ROM, memory answers switched off.
    not_there,
    // What was read does not begin as an AMD video ROM.
    not_a_rom,
    // It begins as one and does not hold (`check` says why).
    does_not_hold,
    read
}

pub const State = enum(u8) {
    // Nothing was looked at.
    none,
    // Not 55 AA at the start; no mark of AMD's at 0x30.
    no_signature,
    no_mark,
    // The length byte is 0, or names more bytes than were read.
    short,
    // The header is not inside the image, or does not say "ATOM".
    outside,
    no_atom,
    // The marks are there and the bytes do not add up to 0.
    bad_sum,
    found
}

pub const Rom = struct {
    state: State
    way: Way
    // The image's bytes (its length byte's count) and what they add up
    // to in eight bits (0 when right).
    size: usize
    sum: usize
    header: usize
    // What names it: the name string, the part number, the date
    // ("2017/04/26 21:55"); each `...Length` characters.
    name: [64]u8
    nameLength: usize
    part: [64]u8
    partLength: usize
    date: [16]u8
    dateLength: usize
    // What became of each way, in the order tried.
    vfct: Tried
    expansion: Tried
    registers: Tried

    // Whether tables of this ROM may be run.
    pub fn sound(self: *const Self) -> bool { return self.*.state == State.found }

    // Whether there are bytes to look at and hand over.
    pub fn kept(self: *const Self) -> bool { return self.*.state == State.found || self.*.state == State.bad_sum }
}

fn byte(bytes: []const u8, at: usize) -> usize { return if at < bytes.length { @intCast(usize, bytes[at]) } else { 0 } }

fn word(bytes: []const u8, at: usize) -> usize { return byte(bytes, at) | (byte(bytes, at + 1) << 8) }

fn long(bytes: []const u8, at: usize) -> usize { return word(bytes, at) | (word(bytes, at + 2) << 16) }

fn same(bytes: []const u8, at: usize, text: []const u8) -> bool {
    if at + text.length > bytes.length { return false }
    var k: usize = 0
    while k < text.length {
        if bytes[at + k] != text[k] { return false }
        k += 1
    }
    return true
}

// How many bytes the image has whose first bytes these are (0x3A of them
// at least): 0 when they do not begin as an AMD video ROM. (amdgpu_read_
// bios_from_rom: 55 AA, the mark, the length byte in blocks of 512.)
pub fn imageSize(first: []const u8) -> usize {
    if first.length < atom.ATOM_ATI_MAGIC_PTR + atom.ATOM_ATI_MAGIC.length { return 0 }
    if peek16(first, 0) != atom.ATOM_BIOS_MAGIC { return 0 }
    if !same(first, atom.ATOM_ATI_MAGIC_PTR, atom.ATOM_ATI_MAGIC) { return 0 }
    return byte(first, OFFSET_TO_ATOM_ROM_IMAGE_SIZE) * 512
}

fn peek16(bytes: []const u8, at: usize) -> usize { return word(bytes, at) }

// The bytes held to be a ROM (the file's head says by what), and what
// names it read out. `rom.way` and the ways' outcomes are left alone.
pub fn check(bytes: []const u8, rom: *Rom) -> State {
    rom.*.size = 0
    rom.*.sum = 0
    rom.*.header = 0
    rom.*.nameLength = 0
    rom.*.partLength = 0
    rom.*.dateLength = 0
    rom.*.state = inspect(bytes, rom)
    if rom.kept() { names(bytes[0..rom.*.size], rom) }
    return rom.*.state
}

fn inspect(bytes: []const u8, rom: *Rom) -> State {
    if bytes.length < OFFSET_TO_ATOM_ROM_HEADER_POINTER + 2 { return State.short }
    if word(bytes, 0) != atom.ATOM_BIOS_MAGIC { return State.no_signature }
    if !same(bytes, atom.ATOM_ATI_MAGIC_PTR, atom.ATOM_ATI_MAGIC) { return State.no_mark }
    const size = byte(bytes, OFFSET_TO_ATOM_ROM_IMAGE_SIZE) * 512
    if size == 0 || size > bytes.length { return State.short }
    rom.*.size = size
    const header = word(bytes, OFFSET_TO_ATOM_ROM_HEADER_POINTER)
    if header == 0 || header + atom.ATOM_ROM_DATA_PTR + 2 > size { return State.outside }
    if !same(bytes, header + atom.ATOM_ROM_MAGIC_PTR, atom.ATOM_ROM_MAGIC) { return State.no_atom }
    rom.*.header = header
    var sum: usize = 0
    var k: usize = 0
    while k < size {
        sum += @intCast(usize, bytes[k])
        k += 1
    }
    rom.*.sum = sum & 0xFF
    if rom.*.sum != 0 { return State.bad_sum }
    return State.found
}

// What names the ROM (atom.c's atom_get_vbios_name, atom_get_vbios_pn and
// atom_get_vbios_date), every read inside the image. The name: after as
// many strings as the byte at 0x2F says, from the place the word at 0x6E
// names, and two bytes of a line's end; blanks at its end left off. The
// part number: the first of those strings, or what stands at 0x80 when
// there are none, up to 43 characters from blank to 'z' (where nothing
// stands, Linux looks for the text "ATOMBIOS" in the first KiB; not
// here). The date:
// "MM/DD/YY HH:MM" at 0x50, said as "20YY/MM/DD HH:MM".
fn names(image: []const u8, rom: *Rom) -> void {
    const strings = byte(image, OFFSET_TO_GET_ATOMBIOS_NUMBER_OF_STRINGS)
    const start = word(image, OFFSET_TO_GET_ATOMBIOS_STRING_START)
    if strings != 0 {
        var at = start
        var passed: usize = 0
        while passed < strings && at < image.length {
            while at < image.length && image[at] != 0 { at += 1 }
            at += 1
            passed += 1
        }
        at += 2
        var length: usize = 0
        while length < STRLEN_LONG - 1 && at + length < image.length && image[at + length] != 0 {
            rom.*.name[length] = printable(image[at + length])
            length += 1
        }
        while length > 0 && rom.*.name[length - 1] == 32 { length -= 1 }
        rom.*.nameLength = length
    }
    var part = if strings != 0 { start } else { OFFSET_TO_VBIOS_PART_NUMBER }
    if byte(image, part) == 0 { part += 1 }
    var count: usize = 0
    while count < BIOS_STRING_LENGTH && part + count < image.length && image[part + count] >= 32 && image[part + count] <= 122 {
        rom.*.part[count] = image[part + count]
        count += 1
    }
    rom.*.partLength = count
    if OFFSET_TO_VBIOS_DATE + 14 <= image.length {
        const from = [_]usize{ 6, 7, 0, 1, 3, 4, 9, 10, 11, 12, 13 }
        const to = [_]usize{ 2, 3, 5, 6, 8, 9, 11, 12, 13, 14, 15 }
        rom.*.date[0] = 50
        rom.*.date[1] = 48
        rom.*.date[4] = 47
        rom.*.date[7] = 47
        rom.*.date[10] = 32
        var k: usize = 0
        while k < 11 {
            rom.*.date[to[k]] = printable(image[OFFSET_TO_VBIOS_DATE + from[k]])
            k += 1
        }
        rom.*.dateLength = 16
    }
}

// A character for the log: what is none becomes a '?'.
fn printable(character: u8) -> u8 { return if character >= 32 && character < 127 { character } else { 63 } }

// Way 1: the ROM image for the card at `bus`:`device`.`function` with the
// numbers `vendor`:`product` out of the ACPI table VFCT's bytes, copied
// into `into`. How many bytes (0: the table has none for this card, or is
// cut short). An image longer than `into` is not passed over: its
// beginning is taken, as much as fits (a firmware may give the whole ROM
// chip, the card's UEFI driver behind the image; ROOM bytes are all an
// image's length byte can name, and `check` holds what was taken).
// (amdgpu_acpi_vfct_bios.)
pub fn fromVfct(table: []const u8, bus: usize, device: usize, function: usize, vendor: usize, product: usize, into: []u8) -> usize {
    if table.length < UEFI_ACPI_VFCT__size { return 0 }
    var offset = long(table, UEFI_ACPI_VFCT__VBIOSImageOffset)
    while offset < table.length {
        const header = offset
        offset += VFCT_IMAGE_HEADER__size
        if offset > table.length { return 0 }
        const length = long(table, header + VFCT_IMAGE_HEADER__ImageLength)
        const image = offset
        offset += length
        if offset > table.length { return 0 }
        if length != 0 && long(table, header + VFCT_IMAGE_HEADER__PCIBus) == bus && long(table, header + VFCT_IMAGE_HEADER__PCIDevice) == device && long(table, header + VFCT_IMAGE_HEADER__PCIFunction) == function && word(table, header + VFCT_IMAGE_HEADER__VendorID) == vendor && word(table, header + VFCT_IMAGE_HEADER__DeviceID) == product {
            const count = if length > into.length { into.length } else { length }
            var k: usize = 0
            while k < count {
                into[k] = table[image + k]
                k += 1
            }
            return count
        }
    }
    return 0
}

// Way 2: the PCI expansion ROM read into `into` (the first image, by its
// length byte). The configuration's word 0x30 is written as the file's
// head says and holds what it held when this returns, whatever happened.
// How many bytes; `tried` says what became of it.
pub fn fromExpansion(bus: *const Bus, into: []u8, tried: *Tried) -> usize {
    const config = bus.*.config
    const setConfig = bus.*.setConfig
    const window = bus.*.window
    tried.* = Tried.not_there
    const held = config(PCI_ROM_ADDRESS) & 0xFFFFFFFF
    const address = held & PCI_ROM_ADDRESS_MASK
    // No address: the firmware assigned none or took it away.
    if address == 0 { return 0 }
    // The card must answer in memory at all (the kernel has switched that
    // on for its registers; it is not switched on here).
    if config(PCI_COMMAND) & PCI_COMMAND_MEMORY == 0 { return 0 }
    // The ROM's size: the address bits that hold when all are set, with
    // the ROM switched off meanwhile.
    setConfig(PCI_ROM_ADDRESS, PCI_ROM_ADDRESS_MASK)
    const mask = config(PCI_ROM_ADDRESS) & PCI_ROM_ADDRESS_MASK
    setConfig(PCI_ROM_ADDRESS, held)
    if mask == 0 { return 0 }
    const size = (0x100000000 - mask) & 0xFFFFFFFF
    if size < 512 { return 0 }
    // An address the firmware did not mean for the ROM is not switched
    // on.
    const clear = bus.*.clear
    if !clear(address, size) { return 0 }
    // Switched on, read, put back.
    setConfig(PCI_ROM_ADDRESS, held | PCI_ROM_ADDRESS_ENABLE)
    var length: usize = 0
    var count: usize = 0
    if window(address, into[0..512]) {
        length = imageSize(into[0..512])
        count = length
        if count > size { count = size }
        if count > into.length { count = into.length }
        if count > 512 && !window(address, into[0..count]) { count = 0 }
    }
    setConfig(PCI_ROM_ADDRESS, held)
    if length == 0 {
        tried.* = Tried.not_a_rom
        return 0
    }
    // (A ROM's beginning was there and the whole of it could not be had:
    // not said to be read.)
    tried.* = if count == 0 { Tried.does_not_hold } else { Tried.read }
    return count
}

// Way 3: the ROM read through the card's ROM registers into `into`, a
// long at a time (vi_read_bios_from_rom: the ROM's index set to 0, then
// its data register read again and again). First the image's start, to
// learn its length, then all of it. The pair's index and the ROM's index
// hold what they held when this returns.
pub fn fromRegisters(bus: *const Bus, into: []u8, tried: *Tried) -> usize {
    const read = bus.*.read
    const write = bus.*.write
    const shown = read(SMC_IND_INDEX_11)
    write(SMC_IND_INDEX_11, @intCast(u32, ROM_INDEX))
    const place = read(SMC_IND_DATA_11)
    var length: usize = 0
    var count: usize = 64
    var pass: usize = 0
    while pass < 2 && count <= into.length {
        write(SMC_IND_INDEX_11, @intCast(u32, ROM_INDEX))
        write(SMC_IND_DATA_11, 0)
        write(SMC_IND_INDEX_11, @intCast(u32, ROM_DATA))
        var k: usize = 0
        while k + 4 <= count {
            const value = @intCast(usize, read(SMC_IND_DATA_11))
            into[k] = @intCast(u8, value & 0xFF)
            into[k + 1] = @intCast(u8, (value >> 8) & 0xFF)
            into[k + 2] = @intCast(u8, (value >> 16) & 0xFF)
            into[k + 3] = @intCast(u8, (value >> 24) & 0xFF)
            k += 4
        }
        if pass == 0 {
            length = imageSize(into[0..64])
            if length == 0 || length > into.length {
                length = 0
                break
            }
            count = length
        }
        pass += 1
    }
    write(SMC_IND_INDEX_11, @intCast(u32, ROM_INDEX))
    write(SMC_IND_DATA_11, place)
    write(SMC_IND_INDEX_11, shown)
    tried.* = if length == 0 { Tried.not_a_rom } else { Tried.read }
    return length
}

// The card's ROM read by the first way that gives one that holds, into
// `image` (ROOM bytes; `work`, as many, is read into on the way): out of
// the firmware's VFCT table `vfct` (no bytes: the firmware has none),
// through the PCI expansion ROM, through the card's ROM registers (only
// when `reachable`: the card's registers are in the kernel's view). A
// ROM with the marks whose bytes do not add up is kept only when no way
// gives a better. `rom` says what was found, by which way, and what
// became of each way.
pub fn read(vfct: []const u8, place: *const Place, bus: *const Bus, reachable: bool, image: []u8, work: []u8, rom: *Rom) -> void {
    rom.*.state = State.none
    rom.*.way = Way.none
    rom.*.size = 0
    rom.*.vfct = Tried.not_tried
    rom.*.expansion = Tried.not_tried
    rom.*.registers = Tried.not_tried
    var byFirmware = Tried.not_tried
    var byExpansion = Tried.not_tried
    var byRegisters = Tried.not_tried
    var seen: Rom = undefined
    var way: usize = 0
    while way < 3 && !rom.sound() {
        var count: usize = 0
        var tried = Tried.not_there
        if way == 0 {
            if vfct.length != 0 { count = fromVfct(vfct, place.*.bus, place.*.device, place.*.function, place.*.vendor, place.*.product, work) }
        } else if way == 1 {
            count = fromExpansion(bus, work, &tried)
        } else if reachable {
            count = fromRegisters(bus, work, &tried)
        }
        if count != 0 {
            _ = check(work[0..count], &seen)
            tried = if seen.sound() { Tried.read } else if seen.state == State.no_signature || seen.state == State.no_mark { Tried.not_a_rom } else { Tried.does_not_hold }
            if seen.sound() || (seen.kept() && !rom.kept()) {
                rom.* = seen
                rom.*.way = if way == 0 { Way.vfct } else if way == 1 { Way.expansion } else { Way.registers }
                var k: usize = 0
                while k < seen.size && k < image.length {
                    image[k] = work[k]
                    k += 1
                }
            }
        }
        if way == 0 {
            byFirmware = tried
        } else if way == 1 {
            byExpansion = tried
        } else {
            byRegisters = tried
        }
        way += 1
    }
    rom.*.vfct = byFirmware
    rom.*.expansion = byExpansion
    rom.*.registers = byRegisters
}

// How many bytes of scratch the ROM asks for its tables (amdgpu_atombios_
// allocate_fb_scratch): what the VRAM_UsageByFirmware table says in KiB,
// 20 KiB when there is no such table, it says 0, or its place is flagged
// as shared with a virtual machine's host.
pub fn scratchBytes(machine: *const atom.Atom) -> usize {
    const table = machine.dataTable(Data.VRAM_UsageByFirmware)
    const image = machine.*.rom
    if table == 0 || table + ATOM_VRAM_USAGE_BY_FIRMWARE__usFirmwareUseInKb + 2 > image.length { return DEFAULT_SCRATCH }
    const place = long(image, table + ATOM_VRAM_USAGE_BY_FIRMWARE__ulStartAddrUsedByFirmware)
    if place & ATOM_VRAM_OPERATION_FLAGS_MASK == ATOM_VRAM_BLOCK_SRIOV_MSG_SHARE_RESERVATION << @intCast(u6, ATOM_VRAM_OPERATION_FLAGS_SHIFT) { return DEFAULT_SCRATCH }
    const bytes = word(image, table + ATOM_VRAM_USAGE_BY_FIRMWARE__usFirmwareUseInKb) * 1024
    return if bytes == 0 { DEFAULT_SCRATCH } else { bytes }
}

// The firmware information: what a pixel clock's maker takes from it,
// in kHz.
pub const Firmware = struct {
    // Whether the table is there and of the format read (2.2); its format
    // and content revision as format * 256 + content.
    found: bool
    revision: usize
    firmwareRevision: usize
    // The PLL's reference (the crystal), what may go into the PLL and
    // come out of it, the display engine's clock, and the reference for
    // DisplayPort when it is not the PLL's (0: it is).
    reference: usize
    inputLeast: usize
    inputMost: usize
    outputLeast: usize
    outputMost: usize
    engine: usize
    displayPortReference: usize
}

pub fn readFirmware(machine: *const atom.Atom, firmware: *Firmware) -> void {
    firmware.* = Firmware.{ .found = false, .revision = 0, .firmwareRevision = 0, .reference = 0, .inputLeast = 0, .inputMost = 0, .outputLeast = 0, .outputMost = 0, .engine = 0, .displayPortReference = 0 }
    const table = machine.dataTable(Data.FirmwareInfo)
    const image = machine.*.rom
    if table == 0 { return }
    firmware.*.revision = (byte(image, table + 2) << 8) | byte(image, table + 3)
    if firmware.*.revision != 0x202 { return }
    if word(image, table) < ATOM_FIRMWARE_INFO_V2_2__size || table + ATOM_FIRMWARE_INFO_V2_2__size > image.length { return }
    firmware.*.found = true
    firmware.*.firmwareRevision = long(image, table + ATOM_FIRMWARE_INFO_V2_2__ulFirmwareRevision)
    firmware.*.reference = word(image, table + ATOM_FIRMWARE_INFO_V2_2__usCoreReferenceClock) * 10
    firmware.*.inputLeast = word(image, table + ATOM_FIRMWARE_INFO_V2_2__usMinPixelClockPLL_Input) * 10
    firmware.*.inputMost = word(image, table + ATOM_FIRMWARE_INFO_V2_2__usMaxPixelClockPLL_Input) * 10
    firmware.*.outputLeast = long(image, table + ATOM_FIRMWARE_INFO_V2_2__ulMinPixelClockPLL_Output) * 10
    firmware.*.outputMost = long(image, table + ATOM_FIRMWARE_INFO_V2_2__ulMaxPixelClockPLL_Output) * 10
    firmware.*.engine = long(image, table + ATOM_FIRMWARE_INFO_V2_2__ulDefaultDispEngineClkFreq) * 10
    firmware.*.displayPortReference = word(image, table + ATOM_FIRMWARE_INFO_V2_2__usUniphyDPModeExtClkFreq) * 10
}

// A connector of the board: its object number and what it is (ObjectID.
// h's CONNECTOR_OBJECT_ID_), the encoder its display path names (0: none)
// and whether the connector's own first source is that encoder, the
// transmitter (0 to 6 for UNIPHY A to G, which is also the DIG block's
// number; NONE for another encoder), the hot plug pin and the DDC line
// as the ROM numbers them (NONE: no record), and whether the line is the
// hardware's own I2C engine's.
pub const Connector = struct {
    object: usize
    kind: usize
    encoder: usize
    agrees: bool
    transmitter: usize
    hotPlug: usize
    ddc: usize
    ddcHardware: bool
}

pub const CONNECTORS: usize = 8

pub const Board = struct {
    // Whether the object table is there and fits together; how many
    // display paths it has and how many of them are connectors here.
    found: bool
    paths: usize
    count: usize
    connectors: [CONNECTORS]Connector

    // The connector that goes out by DIG block `block` (NONE: none does).
    pub fn byBlock(self: *const Self, block: usize) -> usize {
        var k: usize = 0
        while k < self.*.count {
            if self.*.connectors[k].transmitter == block { return k }
            k += 1
        }
        return NONE
    }
}

// The transmitter an encoder object is (translate_encoder_to_transmitter).
pub fn transmitterOf(object: usize) -> usize {
    if (object & OBJECT_TYPE_MASK) >> @intCast(u6, OBJECT_TYPE_SHIFT) != GRAPH_OBJECT_TYPE_ENCODER { return NONE }
    const id = object & OBJECT_ID_MASK
    const which = (object & ENUM_ID_MASK) >> @intCast(u6, ENUM_ID_SHIFT)
    if id == ENCODER_OBJECT_ID_INTERNAL_UNIPHY && (which == 1 || which == 2) { return which - 1 }
    if id == ENCODER_OBJECT_ID_INTERNAL_UNIPHY1 && (which == 1 || which == 2) { return which + 1 }
    if id == ENCODER_OBJECT_ID_INTERNAL_UNIPHY2 && (which == 1 || which == 2) { return which + 3 }
    if id == ENCODER_OBJECT_ID_INTERNAL_UNIPHY3 && which == 1 { return 6 }
    return NONE
}

// The object `object` in the object table at `table` (its count first):
// where its eight bytes lie, 0 when it is not there or the table is not
// inside the image.
fn objectIn(image: []const u8, table: usize, object: usize) -> usize {
    if table + ATOM_OBJECT_TABLE__asObjects > image.length { return 0 }
    const count = byte(image, table)
    var k: usize = 0
    while k < count {
        const at = table + ATOM_OBJECT_TABLE__asObjects + k * ATOM_OBJECT__size
        if at + ATOM_OBJECT__size > image.length { return 0 }
        if word(image, at + ATOM_OBJECT__usObjectID) == object { return at }
        k += 1
    }
    return 0
}

// The record of type `kind` among those from `at` on: where it begins, 0
// when there is none (the records end, or leave the image).
fn recordOf(image: []const u8, at: usize, kind: usize, least: usize) -> usize {
    var offset = at
    var seen: usize = 0
    while seen < 64 && offset + 2 <= image.length {
        const what = byte(image, offset)
        const size = byte(image, offset + 1)
        if what == ATOM_RECORD_END_TYPE || size == 0 { return 0 }
        if what == kind && size >= least && offset + size <= image.length { return offset }
        offset += size
        seen += 1
    }
    return 0
}

pub fn readBoard(machine: *const atom.Atom, board: *Board) -> void {
    board.*.found = false
    board.*.paths = 0
    board.*.count = 0
    const image = machine.*.rom
    const table = machine.dataTable(Data.Object_Header)
    if table == 0 || table + ATOM_OBJECT_HEADER__size > image.length { return }
    const connectors = table + word(image, table + ATOM_OBJECT_HEADER__usConnectorObjectTableOffset)
    const paths = table + word(image, table + ATOM_OBJECT_HEADER__usDisplayPathTableOffset)
    if paths + ATOM_DISPLAY_OBJECT_PATH_TABLE__asDispPath > image.length { return }
    board.*.found = true
    board.*.paths = byte(image, paths)
    var at = paths + ATOM_DISPLAY_OBJECT_PATH_TABLE__asDispPath
    var n: usize = 0
    while n < board.*.paths {
        if at + ATOM_DISPLAY_OBJECT_PATH__usGraphicObjIds > image.length { break }
        const size = word(image, at + ATOM_DISPLAY_OBJECT_PATH__usSize)
        // (A path that is shorter than its own head, or leaves the image:
        // the table is not gone through further.)
        if size < ATOM_DISPLAY_OBJECT_PATH__usGraphicObjIds || at + size > image.length { break }
        const object = word(image, at + ATOM_DISPLAY_OBJECT_PATH__usConnObjectId)
        if (object & OBJECT_TYPE_MASK) >> @intCast(u6, OBJECT_TYPE_SHIFT) == GRAPH_OBJECT_TYPE_CONNECTOR && board.*.count < CONNECTORS {
            const connector = &board.*.connectors[board.*.count]
            connector.* = Connector.{ .object = object, .kind = object & OBJECT_ID_MASK, .encoder = 0, .agrees = false, .transmitter = NONE, .hotPlug = NONE, .ddc = NONE, .ddcHardware = false }
            // The path's encoder: the first of its objects that is a
            // transmitter of the card's own, else its first encoder.
            var k: usize = ATOM_DISPLAY_OBJECT_PATH__usGraphicObjIds
            while k + 2 <= size {
                const between = word(image, at + k)
                if (between & OBJECT_TYPE_MASK) >> @intCast(u6, OBJECT_TYPE_SHIFT) == GRAPH_OBJECT_TYPE_ENCODER {
                    if connector.*.encoder == 0 || (connector.*.transmitter == NONE && transmitterOf(between) != NONE) {
                        connector.*.encoder = between
                        connector.*.transmitter = transmitterOf(between)
                    }
                }
                k += 2
            }
            // The connector's own object: its first source, and its
            // records.
            const own = objectIn(image, connectors, object)
            if own != 0 {
                const sources = table + word(image, own + ATOM_OBJECT__usSrcDstTableOffset)
                if sources + 3 <= image.length && byte(image, sources) != 0 { connector.*.agrees = word(image, sources + 1) == connector.*.encoder }
                const records = table + word(image, own + ATOM_OBJECT__usRecordOffset)
                const pin = recordOf(image, records, ATOM_HPD_INT_RECORD_TYPE, ATOM_HPD_INT_RECORD__size)
                if pin != 0 { connector.*.hotPlug = byte(image, pin + 2) }
                const line = recordOf(image, records, ATOM_I2C_RECORD_TYPE, ATOM_I2C_RECORD__size)
                if line != 0 {
                    connector.*.ddc = byte(image, line + 2) & 0x0F
                    connector.*.ddcHardware = byte(image, line + 2) & 0x80 != 0
                }
            }
            board.*.count += 1
        }
        at += size
        n += 1
    }
}

pub fn connectorName(kind: usize) -> []const u8 {
    if kind == CONNECTOR_OBJECT_ID_HDMI_TYPE_A { return "HDMI" }
    if kind == CONNECTOR_OBJECT_ID_HDMI_TYPE_B { return "HDMI (type B)" }
    if kind == CONNECTOR_OBJECT_ID_DISPLAYPORT { return "DisplayPort" }
    if kind == CONNECTOR_OBJECT_ID_eDP { return "embedded DisplayPort" }
    if kind == CONNECTOR_OBJECT_ID_SINGLE_LINK_DVI_I { return "DVI-I (single link)" }
    if kind == CONNECTOR_OBJECT_ID_DUAL_LINK_DVI_I { return "DVI-I (dual link)" }
    if kind == CONNECTOR_OBJECT_ID_SINGLE_LINK_DVI_D { return "DVI-D (single link)" }
    if kind == CONNECTOR_OBJECT_ID_DUAL_LINK_DVI_D { return "DVI-D (dual link)" }
    if kind == CONNECTOR_OBJECT_ID_VGA { return "VGA" }
    if kind == CONNECTOR_OBJECT_ID_LVDS { return "LVDS" }
    return "another kind"
}

const LETTERS = "ABCDEFG"

fn wayName(way: Way) -> []const u8 {
    return match way {
        .none => "nowhere",
        .vfct => "the firmware's ACPI table VFCT",
        .expansion => "the card's PCI expansion ROM",
        .registers => "the card's ROM registers"
    }
}

fn triedName(tried: Tried) -> []const u8 {
    return match tried {
        .not_tried => "not tried",
        .not_there => "not there",
        .not_a_rom => "no ROM there",
        .does_not_hold => "a ROM that does not hold",
        .read => "read"
    }
}

// Which way gave the ROM, its size and what names it; or why there is
// none.
pub fn sayRom(card: *const scanout.Card, rom: *const Rom) -> void {
    if !rom.kept() {
        card.say("gpu: video BIOS not read (the ACPI table VFCT: ")
        card.say(triedName(rom.*.vfct))
        card.say("; the PCI expansion ROM: ")
        card.say(triedName(rom.*.expansion))
        card.say("; the card's ROM registers: ")
        card.say(triedName(rom.*.registers))
        card.say("): the card's tables cannot be run\n")
        return
    }
    card.say("gpu: video BIOS from ")
    card.say(wayName(rom.*.way))
    card.field(": ", rom.*.size)
    card.say(" bytes, \"")
    card.say(rom.*.name[0..rom.*.nameLength])
    card.say("\", part number ")
    card.say(rom.*.part[0..rom.*.partLength])
    card.say(", of ")
    card.say(rom.*.date[0..rom.*.dateLength])
    card.say("\n")
    if rom.*.state == State.bad_sum {
        card.fieldHex("gpu: video BIOS: its bytes do not add up to 0 (they come to ", rom.*.sum)
        card.say("): it is kept to be looked at, none of its tables is run\n")
    }
}

// A line for each command table a mode set runs: whether the ROM has it,
// and its format and content revision. How many of them it has.
pub fn sayTables(card: *const scanout.Card, machine: *const atom.Atom) -> usize {
    var there: usize = 0
    var k: usize = 0
    while k < NEEDED[0..].length {
        const revision = machine.revision(NEEDED[k])
        card.say("gpu: table ")
        card.say(NEEDED_NAMES[k])
        card.field(" (", NEEDED[k])
        if machine.has(NEEDED[k]) {
            there += 1
            card.field("): there, revision ", revision >> 8)
            card.field(".", revision & 0xFF)
            card.say("\n")
        } else {
            card.say("): not in this ROM\n")
        }
        k += 1
    }
    card.say(if machine.has(Command.ASIC_Init) { "gpu: table ASIC_Init (0): there, and never run (it starts the card anew)\n" } else { "gpu: table ASIC_Init (0): not in this ROM\n" })
    return there
}

pub fn neededTables() -> usize { return NEEDED[0..].length }

pub fn sayFirmware(card: *const scanout.Card, firmware: *const Firmware) -> void {
    if !firmware.*.found {
        if firmware.*.revision == 0 {
            card.say("gpu: firmware information: not in this ROM\n")
        } else {
            card.field("gpu: firmware information of format ", firmware.*.revision >> 8)
            card.field(".", firmware.*.revision & 0xFF)
            card.say(": not read (2.2 is)\n")
        }
        return
    }
    card.field("gpu: firmware information: the pixel clock PLL's reference ", firmware.*.reference)
    card.span(" kHz, into the PLL ", firmware.*.inputLeast, firmware.*.inputMost)
    card.span(" kHz, out of it ", firmware.*.outputLeast, firmware.*.outputMost)
    card.field(" kHz; the display engine's clock ", firmware.*.engine)
    card.say(" kHz; DisplayPort's reference ")
    if firmware.*.displayPortReference == 0 {
        card.say("the PLL's\n")
    } else {
        card.field("", firmware.*.displayPortReference)
        card.say(" kHz\n")
    }
}

// One connector, as "the HDMI connector (transmitter UNIPHY E, DIG 4; hot
// plug pin 3; DDC line 4)".
pub fn sayConnector(card: *const scanout.Card, connector: *const Connector) -> void {
    card.say(connectorName(connector.*.kind))
    if connector.*.transmitter != NONE {
        card.say(" (transmitter UNIPHY ")
        card.say(LETTERS[connector.*.transmitter..connector.*.transmitter + 1])
        card.field(", DIG ", connector.*.transmitter)
    } else if connector.*.encoder != 0 {
        card.fieldHex(" (encoder object ", connector.*.encoder)
        card.say(", not a transmitter of the card's own")
    } else {
        card.say(" (no encoder")
    }
    if connector.*.hotPlug != NONE {
        card.field("; hot plug pin ", connector.*.hotPlug)
    } else {
        card.say("; no hot plug pin")
    }
    if connector.*.ddc != NONE {
        card.field("; DDC line ", connector.*.ddc)
    } else {
        card.say("; no DDC line")
    }
    card.say(")")
}

pub fn sayBoard(card: *const scanout.Card, board: *const Board) -> void {
    if !board.*.found {
        card.say("gpu: the ROM's object table is not there: its connectors are not known\n")
        return
    }
    var k: usize = 0
    while k < board.*.count {
        const connector = &board.*.connectors[k]
        card.field("gpu: connector ", k)
        card.say(": ")
        sayConnector(card, connector)
        if connector.*.encoder != 0 && !connector.*.agrees { card.say(" (the connector's own source is another encoder than its display path's)") }
        card.say("\n")
        k += 1
    }
    if board.*.count == 0 { card.say("gpu: the ROM's object table names no connector\n") }
}
