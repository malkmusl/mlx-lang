// The first process: mlx-init (/system/programs/mlx-init, the init: it
// starts the services, among them the serial console's shell and the
// screen's console) or, when the archive has no init, mlx-sh itself on
// the serial console; in /users/root, started at boot and again when it
// ends (every other process ends with it; the files stay).
const cpu = @import("./cpu.mlx")
const console = @import("./console.mlx")
const scheduler = @import("./scheduler.mlx")
const process = @import("./process.mlx")
const terminal = @import("./terminal.mlx")
const serial = @import("./serial.mlx")
const pipe = @import("./pipe.mlx")
const channel = @import("./channel.mlx")
const timer = @import("./timer.mlx")
const memoryObjects = @import("./memoryobjects.mlx")
const vfs = @import("./vfs.mlx")
const Frame = @import("./frame.mlx").Frame

pub const INIT = "mlx-init"
pub const NAME = "mlx-sh"

// The first program's name: the init when the archive has it.
fn first(bin: usize) -> []const u8 {
    if bin != vfs.Vfs.NONE && vfs.fileSystem().lookup(bin, INIT.pointer, INIT.length) != vfs.Vfs.NONE { return INIT }
    return NAME
}

// Every process gone, then mlx-sh as the first one, with the terminal
// cooked and no pipes; false when it cannot be loaded.
pub fn start() -> bool {
    // Everything goes, but processes running on other processors (they
    // end as usual; the tables they use stay).
    const table = scheduler.processes()
    const survivors = table.freeAllButRunning()
    if survivors == 0 {
        table.init()
        pipe.table().init()
        channel.table().init()
        timer.table().init()
        memoryObjects.table().init()
    }
    terminal.init()
    cpu.Msr.write(cpu.Msr.FS_BASE, 0)
    const created = table.createShell()
    if created == null { return false }
    const p = created.?
    table.makeCurrent(p)
    const tree = vfs.fileSystem()
    const programs = tree.resolve(vfs.Vfs.ROOT, "/system/programs\x00".pointer)
    const home = tree.resolve(vfs.Vfs.ROOT, "/users/root\x00".pointer)
    const bin = if programs < 0 { vfs.Vfs.NONE } else { @bitCast(usize, programs) }
    p.setDirectory(if home < 0 { vfs.Vfs.ROOT } else { @bitCast(usize, home) })
    const name = first(bin)
    if bin != vfs.Vfs.NONE { p.setProgram(tree.lookup(bin, name.pointer, name.length), bin) }
    var arguments: [1][*]const u8 = undefined
    var environment: [6][*]const u8 = undefined
    unsafe {
        arguments[0] = @ptrCast([*]const u8, if name.length == INIT.length { "mlx-init\x00" } else { "mlx-sh\x00" })
        environment[0] = @ptrCast([*]const u8, "HOME=/users/root\x00")
        environment[1] = @ptrCast([*]const u8, "PATH=/system/programs\x00")
        environment[2] = @ptrCast([*]const u8, "PWD=/users/root\x00")
        environment[3] = @ptrCast([*]const u8, "TERM=vt100\x00")
        environment[4] = @ptrCast([*]const u8, "USER=root\x00")
        environment[5] = @ptrCast([*]const u8, "SHELL=/system/programs/mlx-sh\x00")
    }
    const loaded = p.load(p.*.program, process.Strings.{ .items = &arguments, .count = 1 }, process.Strings.{ .items = &environment, .count = 6 })
    // The terminal on 0 is its session too.
    p.setRole(process.ROLE_SESSION, 0)
    return loaded == process.Loaded.done
}

// The trap returns to a fresh start of the shell.
pub fn restart(frame: *Frame) -> void {
    if !start() {
        console.out.write("brixOS: the first process cannot start again\n")
        while true { cpu.Cpu.wait() }
    }
    const p = scheduler.current()
    frame.startAt(p.*.entry, p.*.stack)
}
