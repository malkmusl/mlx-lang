// The first process: mlx-sh from the boot archive on the serial console,
// started at boot and again when it ends (every other process ends with
// it).
const cpu = @import("./cpu.mlx")
const console = @import("./console.mlx")
const scheduler = @import("./scheduler.mlx")
const process = @import("./process.mlx")
const terminal = @import("./terminal.mlx")
const serial = @import("./serial.mlx")
const pipe = @import("./pipe.mlx")
const archive = @import("./archive.mlx")
const Frame = @import("./frame.mlx").Frame

pub const NAME = "mlx-sh"

// Every process gone, then mlx-sh as the first one, with the terminal
// cooked and no pipes; false when it cannot be loaded.
pub fn start() -> bool {
    const table = scheduler.processes()
    var k: usize = 0
    while k < scheduler.Scheduler.MAX {
        const p = &table.*.processes[k]
        if p.*.state != process.State.free {
            p.*.files.closeAll()
            p.releaseMemory()
            p.*.state = process.State.free
        }
        k += 1
    }
    table.init()
    pipe.table().init()
    terminal.serialConsole().init(serial.com1)
    cpu.Msr.write(cpu.Msr.FS_BASE, 0)
    const created = table.create(0)
    if created == null { return false }
    const p = created.?
    table.makeCurrent(p)
    const boot = archive.Archive.boot()
    var arguments: [1][*]const u8 = undefined
    var environment: [6][*]const u8 = undefined
    unsafe {
        arguments[0] = @ptrCast([*]const u8, "mlx-sh\x00")
        environment[0] = @ptrCast([*]const u8, "HOME=/\x00")
        environment[1] = @ptrCast([*]const u8, "PATH=/\x00")
        environment[2] = @ptrCast([*]const u8, "PWD=/\x00")
        environment[3] = @ptrCast([*]const u8, "TERM=vt100\x00")
        environment[4] = @ptrCast([*]const u8, "USER=root\x00")
        environment[5] = @ptrCast([*]const u8, "SHELL=/mlx-sh\x00")
    }
    const loaded = p.load(boot.find(NAME.pointer, NAME.length), process.Strings.{ .items = &arguments, .count = 1 }, process.Strings.{ .items = &environment, .count = 6 })
    return loaded == process.Loaded.done
}

// The trap returns to a fresh start of the shell.
pub fn restart(frame: *Frame) -> void {
    if !start() {
        console.out.write("brixOS: mlx-sh cannot start again\n")
        while true { cpu.Cpu.wait() }
    }
    const p = scheduler.current()
    frame.startAt(p.*.entry, p.*.stack)
}
