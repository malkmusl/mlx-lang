// The displays the loader handed over, and which of them is the main one.
//
// A machine may have more than one graphics adapter (a board's own and a
// card in a slot), and the firmware a graphics output for each. The EFI
// loader writes the first into the boot info's FB_* fields, as it always
// did, and every further one into a page of records (layout.Blob.DISPLAYS,
// layout.More); a Multiboot loader hands over none, and the kernel sets
// the one display up itself (display.mlx). `read` makes the list of them
// from the boot information: the first, then the further ones in the
// firmware's order, each only when its numbers are a picture's.
//
// One of them is the main display: /devices/framebuffer, the one a
// program that knows of one display draws on. `choose` says which:
// - the one the image names (settings/display: a line "main N", N the
//   display's number as the log says it, or "main VVVV:DDDD", the PCI
//   vendor and device of its adapter in hex), when there is such a one;
// - else the one whose monitor names the largest mode of its own (its
//   EDID, as the firmware passed it on: a monitor that says what it is is
//   plugged in, and the larger one is the one to work on; a board's
//   remote console says nothing);
// - else, no monitor saying anything, the one with the largest picture;
// - of several alike, the firmware's first.
//
// Nothing here touches the machine: the boot information comes through a
// function that reads a word of the blob, so that a test runs this file
// on the host against a blob of its own
// (tests/476_boot_displays_runtime.mlx).
const layout = @import("../layout.mlx")

// The most displays the kernel knows: the first and the loader's records.
pub const MAX: usize = 1 + layout.Blob.DISPLAY_ROOM

// A picture's largest side, and the most bytes from one row to the next,
// that count as a display's (anything beyond is no record of a display).
const SIDE: usize = 16384
const PITCH: usize = SIDE * 4 * 2

pub const FORMAT_BGRX: usize = 1
pub const FORMAT_RGBX: usize = 2

// A display as the loader left it.
pub const Found = struct {
    // The framebuffer's physical address, its size in pixels, the bytes
    // from one row to the next, the pixel format (1: BGRX, 2: RGBX).
    address: usize
    width: usize
    height: usize
    pitch: usize
    format: usize
    // What its monitor says its own mode is (0: it did not say), the mode
    // the firmware had it in, whose mode the loader set instead
    // (layout.Info.MODE_*; 0: the firmware's stayed) and the firmware's
    // status when it refused the mode asked for.
    monitorWidth: usize
    monitorHeight: usize
    firmwareWidth: usize
    firmwareHeight: usize
    modeBy: usize
    refused: usize
    // The shape of the screen it is shown on, as a width and a height:
    // the monitor's own mode, else (the first display's) the mode the
    // loader looked for, else the picture's size.
    shapeWidth: usize
    shapeHeight: usize
    // Its monitor's EDID: where in the blob (an offset from its start)
    // and how many bytes (0: none).
    edidAt: usize
    edidBytes: usize
    // Which of the firmware's graphics outputs it is (its place in the
    // firmware's list; the first display's is not written down: 0), and
    // whether it is the firmware's first display (the boot info's own
    // fields).
    output: usize
    first: bool
    // Its adapter's PCI vendor and device (0: not known). Not the
    // loader's word: whoever looks the adapter up fills them in before
    // `choose`.
    vendor: usize
    device: usize
}

pub const List = struct {
    count: usize
    items: [MAX]Found
    // The firmware's graphics outputs in all (0: the loader did not
    // count), those the loader passed over because their pixels are not
    // the kernel's to use, the displays it had no record for, and the
    // records that are no picture's (or an earlier one's picture again):
    // left out here.
    outputs: usize
    unusable: usize
    beyond: usize
    dropped: usize
}

// Whether `wide` by `high` is a screen's shape (a mode's size, no more
// than eight times as wide as high or the reverse).
pub fn isShape(wide: usize, high: usize) -> bool {
    return wide != 0 && high != 0 && wide <= 65535 && high <= 65535 && wide <= high * 8 && high <= wide * 8
}

// The list of the displays the boot information has; `word` reads the
// eight bytes at an offset from the blob's start.
pub fn read(word: fn(usize) -> usize, into: *List) -> void {
    const info = layout.Blob.BOOT_INFO
    into.*.count = 0
    into.*.outputs = word(info + layout.Info.DISPLAYS)
    into.*.unusable = word(info + layout.Info.OUTPUTS_UNUSABLE)
    into.*.beyond = word(info + layout.Info.DISPLAYS_BEYOND)
    into.*.dropped = 0
    // The first display: the boot info's own fields, taken as they
    // always were (a width, a height and a pitch that are not nothing).
    const address = word(info + layout.Info.FB_ADDRESS)
    if address != 0 {
        const f = &into.*.items[0]
        f.*.address = address
        f.*.width = word(info + layout.Info.FB_WIDTH)
        f.*.height = word(info + layout.Info.FB_HEIGHT)
        f.*.pitch = word(info + layout.Info.FB_PITCH)
        f.*.format = word(info + layout.Info.FB_FORMAT)
        f.*.monitorWidth = word(info + layout.Info.MONITOR_WIDTH)
        f.*.monitorHeight = word(info + layout.Info.MONITOR_HEIGHT)
        f.*.firmwareWidth = word(info + layout.Info.FIRMWARE_WIDTH)
        f.*.firmwareHeight = word(info + layout.Info.FIRMWARE_HEIGHT)
        f.*.modeBy = word(info + layout.Info.MODE_BY)
        f.*.refused = word(info + layout.Info.MODE_REFUSED)
        f.*.edidAt = layout.Blob.EDID
        f.*.edidBytes = word(info + layout.Info.EDID_BYTES)
        if f.*.edidBytes > layout.Blob.EDID_ROOM { f.*.edidBytes = layout.Blob.EDID_ROOM }
        f.*.output = 0
        f.*.first = true
        f.*.vendor = 0
        f.*.device = 0
        f.*.shapeWidth = f.*.width
        f.*.shapeHeight = f.*.height
        if isShape(f.*.monitorWidth, f.*.monitorHeight) {
            f.*.shapeWidth = f.*.monitorWidth
            f.*.shapeHeight = f.*.monitorHeight
        } else if isShape(word(info + layout.Info.WANTED_WIDTH), word(info + layout.Info.WANTED_HEIGHT)) {
            f.*.shapeWidth = word(info + layout.Info.WANTED_WIDTH)
            f.*.shapeHeight = word(info + layout.Info.WANTED_HEIGHT)
        }
        if f.*.width > 0 && f.*.height > 0 && f.*.pitch > 0 { into.*.count = 1 }
    }
    // The further ones: as many records as the loader says, no more than
    // there is room for (a count beyond that is no loader's: the rest is
    // counted with the displays there was no record for).
    var records = word(info + layout.Info.MORE_DISPLAYS)
    if records > layout.Blob.DISPLAY_ROOM {
        into.*.beyond += records - layout.Blob.DISPLAY_ROOM
        records = layout.Blob.DISPLAY_ROOM
    }
    var k: usize = 0
    while k < records {
        const at = layout.Blob.DISPLAYS + k * layout.Blob.DISPLAY_RECORD
        const f = &into.*.items[into.*.count]
        f.*.address = word(at + layout.More.ADDRESS)
        f.*.width = word(at + layout.More.WIDTH)
        f.*.height = word(at + layout.More.HEIGHT)
        f.*.pitch = word(at + layout.More.PITCH)
        f.*.format = word(at + layout.More.FORMAT)
        f.*.monitorWidth = word(at + layout.More.MONITOR_WIDTH)
        f.*.monitorHeight = word(at + layout.More.MONITOR_HEIGHT)
        f.*.firmwareWidth = word(at + layout.More.FIRMWARE_WIDTH)
        f.*.firmwareHeight = word(at + layout.More.FIRMWARE_HEIGHT)
        f.*.modeBy = word(at + layout.More.MODE_BY)
        f.*.refused = word(at + layout.More.MODE_REFUSED)
        f.*.edidAt = layout.Blob.DISPLAY_EDIDS + k * layout.Blob.EDID_ROOM
        f.*.edidBytes = word(at + layout.More.EDID_BYTES)
        if f.*.edidBytes > layout.Blob.EDID_ROOM { f.*.edidBytes = layout.Blob.EDID_ROOM }
        f.*.output = word(at + layout.More.OUTPUT)
        f.*.first = false
        f.*.vendor = 0
        f.*.device = 0
        f.*.shapeWidth = f.*.width
        f.*.shapeHeight = f.*.height
        if isShape(f.*.monitorWidth, f.*.monitorHeight) {
            f.*.shapeWidth = f.*.monitorWidth
            f.*.shapeHeight = f.*.monitorHeight
        }
        k += 1
        if !sound(f) || again(into, f) {
            into.*.dropped += 1
        } else {
            into.*.count += 1
        }
    }
}

// Whether a further display's record is a picture's: memory, a size
// within reason, rows that hold their pixels, 32-bit pixels in one of
// the two orders.
fn sound(f: *const Found) -> bool {
    if f.*.address == 0 || f.*.width == 0 || f.*.height == 0 || f.*.width > SIDE || f.*.height > SIDE { return false }
    if f.*.pitch < f.*.width * 4 || f.*.pitch > PITCH || f.*.pitch & 3 != 0 { return false }
    return f.*.format == FORMAT_BGRX || f.*.format == FORMAT_RGBX
}

// Whether the record's memory begins inside a display's that is in the
// list already, or the reverse (the same picture twice).
fn again(list: *const List, f: *const Found) -> bool {
    var k: usize = 0
    while k < list.*.count {
        const other = &list.*.items[k]
        const otherEnd = other.*.address + other.*.pitch * other.*.height
        const end = f.*.address + f.*.pitch * f.*.height
        if f.*.address < otherEnd && other.*.address < end { return true }
        k += 1
    }
    return false
}

// What an image's settings/display says of the main display.
pub const Named = struct {
    pub const NONE: usize = 0
    // By the display's number, or by its adapter's vendor and device.
    pub const NUMBER: usize = 1
    pub const ADAPTER: usize = 2
    // A line "main" whose word is neither.
    pub const UNREADABLE: usize = 3

    kind: usize
    number: usize
    vendor: usize
    device: usize
}

fn blank(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

fn hexDigit(byte: u8) -> usize {
    if byte >= 48 && byte <= 57 { return @intCast(usize, byte) - 48 }
    if byte >= 97 && byte <= 102 { return @intCast(usize, byte) - 87 }
    if byte >= 65 && byte <= 70 { return @intCast(usize, byte) - 55 }
    return 16
}

// The line "main ..." of a settings/display file (the other lines are
// the loader's: the mode): "main 1" names the display by its number,
// "main 1002:67df" by its adapter.
pub fn named(text: []const u8) -> Named {
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        var k = at
        while k < end && blank(text[k]) { k += 1 }
        if k + 4 <= end && text[k] == 109 && text[k + 1] == 97 && text[k + 2] == 105 && text[k + 3] == 110 && (k + 4 == end || blank(text[k + 4])) {
            k += 4
            while k < end && blank(text[k]) { k += 1 }
            var stop = k
            while stop < end && !blank(text[stop]) { stop += 1 }
            return namedBy(text[k..stop])
        }
        at = end + 1
    }
    return Named.{ .kind = Named.NONE, .number = 0, .vendor = 0, .device = 0 }
}

// "N" (decimal) or "VVVV:DDDD" (hex, one to four digits each).
fn namedBy(text: []const u8) -> Named {
    var result = Named.{ .kind = Named.UNREADABLE, .number = 0, .vendor = 0, .device = 0 }
    if text.length == 0 { return result }
    var colon: usize = 0
    while colon < text.length && text[colon] != 58 { colon += 1 }
    if colon == text.length {
        var value: usize = 0
        var k: usize = 0
        while k < text.length {
            if text[k] < 48 || text[k] > 57 || value > 1000 { return result }
            value = value * 10 + @intCast(usize, text[k] - 48)
            k += 1
        }
        result.kind = Named.NUMBER
        result.number = value
        return result
    }
    if colon == 0 || colon > 4 || text.length - colon - 1 == 0 || text.length - colon - 1 > 4 { return result }
    var k: usize = 0
    while k < text.length {
        if k != colon {
            const digit = hexDigit(text[k])
            if digit > 15 { return result }
            if k < colon { result.vendor = result.vendor * 16 + digit } else { result.device = result.device * 16 + digit }
        }
        k += 1
    }
    result.kind = Named.ADAPTER
    return result
}

// Why a display is the main one.
pub const By = struct {
    // There is one display, or none.
    pub const ONLY: usize = 0
    pub const NAMED: usize = 1
    pub const MONITOR: usize = 2
    pub const PICTURE: usize = 3
    // (All alike by the rule: the firmware's first.)
    pub const FIRST: usize = 4
}

pub const Choice = struct {
    index: usize
    by: usize
    // The image names a display that is not there (the rule decided).
    missing: bool
}

fn monitorPixels(f: *const Found) -> usize {
    if !isShape(f.*.monitorWidth, f.*.monitorHeight) { return 0 }
    return f.*.monitorWidth * f.*.monitorHeight
}

// The main display of the list (0 when it is empty), and why.
pub fn choose(list: *const List, wanted: *const Named) -> Choice {
    var choice = Choice.{ .index = 0, .by = By.ONLY, .missing = false }
    if list.*.count <= 1 {
        choice.missing = wanted.*.kind != Named.NONE && !(list.*.count == 1 && matches(list, 0, wanted))
        return choice
    }
    var k: usize = 0
    while k < list.*.count {
        if matches(list, k, wanted) {
            choice.index = k
            choice.by = By.NAMED
            return choice
        }
        k += 1
    }
    choice.missing = wanted.*.kind != Named.NONE
    // The rule: a monitor's own word before a picture's size, the
    // earlier of two alike.
    var best: usize = 0
    k = 1
    while k < list.*.count {
        const a = &list.*.items[k]
        const b = &list.*.items[best]
        const aMonitor = monitorPixels(a)
        const bMonitor = monitorPixels(b)
        if aMonitor != bMonitor {
            if aMonitor > bMonitor { best = k }
        } else if a.*.width * a.*.height > b.*.width * b.*.height {
            best = k
        }
        k += 1
    }
    choice.index = best
    // Why this one: its monitor's word when no other says as much; among
    // those that do, its picture when another's is smaller; else it is
    // the first of several alike.
    const chosen = &list.*.items[best]
    var alike: usize = 0
    var smaller: usize = 0
    k = 0
    while k < list.*.count {
        const other = &list.*.items[k]
        if k != best && monitorPixels(other) == monitorPixels(chosen) {
            alike += 1
            if other.*.width * other.*.height < chosen.*.width * chosen.*.height { smaller += 1 }
        }
        k += 1
    }
    choice.by = if alike == 0 { By.MONITOR } else if smaller == alike { By.PICTURE } else { By.FIRST }
    return choice
}

fn matches(list: *const List, index: usize, wanted: *const Named) -> bool {
    if wanted.*.kind == Named.NUMBER { return wanted.*.number == index }
    if wanted.*.kind == Named.ADAPTER {
        const f = &list.*.items[index]
        return f.*.vendor == wanted.*.vendor && f.*.device == wanted.*.device && (f.*.vendor != 0 || f.*.device != 0)
    }
    return false
}

// The rule's reason in words, for the log.
pub fn reason(by: usize) -> []const u8 {
    if by == By.NAMED { return "named in settings/display" }
    if by == By.MONITOR { return "its monitor names the largest mode of its own" }
    if by == By.PICTURE { return "the largest picture" }
    if by == By.FIRST { return "the firmware's first of those alike" }
    return "the only one"
}
