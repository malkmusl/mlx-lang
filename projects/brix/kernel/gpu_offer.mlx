// What gpu_programs.mlx offers programs of the card, worked out apart from
// the card itself so that the host's tests run it (tests/502, 517): the
// card's record from what gpu.mlx and the engines' first look read, and
// what the calls on a context are served with at this boot
// (gpu_work.mlx), and the table of the contexts programs hold on it.
const record = @import("./gpu_record.mlx")
const engines = @import("./gpu_engines.mlx")
const work = @import("./gpu_work.mlx")

// What gpu.mlx knows of the card it took, at the moment of asking.
pub const Card = struct {
    // The firmware started it (its registers answer as a started card's).
    present: bool
    vendor: usize
    device: usize
    revision: usize
    // Where it sits on PCI (bus << 8 | device << 3 | function), or
    // 0xFFFFFFFF.
    pci: usize
    // The aperture's bytes (BAR0), and what the display's picture takes of
    // it now (a mode change moves and resizes it).
    visible: usize
    picture: usize
    name: []const u8
}

// The record's facts of `card`, with what the engines' first look found
// at this boot (`seen`; null: it read nothing of the card).
pub fn gather(card: *const Card, seen: ?*const engines.Engines, into: *record.Facts) -> void {
    into.*.flags = 0
    into.*.vendor = @intCast(u32, card.*.vendor)
    into.*.device = @intCast(u32, card.*.device)
    into.*.revision = @intCast(u32, card.*.revision)
    into.*.pci = @intCast(u32, card.*.pci)
    into.*.graphics = 0
    into.*.shaderEngines = 0
    into.*.arraysPerEngine = 0
    into.*.computeUnitsPerArray = 0
    into.*.renderBackendsPerEngine = 0
    into.*.engineClock = 0
    into.*.memoryClock = 0
    // No engine takes a program's commands at this stage.
    into.*.computeRings = 0
    into.*.graphicsRings = 0
    into.*.copyRings = 0
    into.*.why = record.Why.CARD_NOT_STARTED
    into.*.memory = 0
    into.*.visible = card.*.visible
    into.*.picture = 0
    into.*.system = 0
    into.*.name = card.*.name
    if !card.*.present { return }
    into.*.flags |= record.Flag.STARTED
    // (A Polaris 10 whose engines this boot did not read, an EDID's
    // reading that did not end, say, is one all the same.)
    into.*.why = if engines.polaris10(card.*.device) { record.Why.NOT_STARTED_YET } else { record.Why.OTHER_CARD }
    if card.*.picture != 0 {
        into.*.flags |= record.Flag.PICTURE
        into.*.picture = card.*.picture
    }
    if seen == null { return }
    const e = seen.?
    const f = &e.*.found
    if !f.*.started || !f.*.polaris10 { return }
    into.*.why = record.Why.NOT_STARTED_YET
    into.*.memory = f.*.vramBytes
    into.*.system = engines.GART_BYTES
    if e.*.m2 == engines.Outcome.passed { into.*.flags |= record.Flag.SYSTEM_MEMORY }
    if f.*.gfxFound {
        // The ROM's GFX_Info from its minor version on: minor, major,
        // shader engines, tile pipes, compute units an array, arrays an
        // engine, render back ends an engine.
        into.*.flags |= record.Flag.ROM_COUNTS
        into.*.graphics = @intCast(u32, (f.*.gfx[1] << 8) | f.*.gfx[0])
        into.*.shaderEngines = @intCast(u32, f.*.gfx[2])
        into.*.computeUnitsPerArray = @intCast(u32, f.*.gfx[4])
        into.*.arraysPerEngine = @intCast(u32, f.*.gfx[5])
        into.*.renderBackendsPerEngine = @intCast(u32, f.*.gfx[6])
    }
    // (The ROM's clocks are in tens of kHz.)
    into.*.engineClock = @intCast(u32, f.*.engineClock * 10)
    into.*.memoryClock = @intCast(u32, f.*.memoryClock * 10)
}

// What the calls on a context are served with now, over what `gather`
// put: compute ring 0 when they are served (stage 5's ring and stage 7's
// address spaces came up at this boot, gpu_work.mlx's `serve`), the flag
// that says what programs may have, and of the system's memory the part
// they may have; on any other boot nothing changes. Why there is no ring
// once it was left down.
pub fn served(w: *const work.Work, into: *record.Facts) -> void {
    if work.served(w) {
        into.*.computeRings = 1
        into.*.why = record.Why.NONE
        into.*.flags |= record.Flag.PROGRAMS
        into.*.system = w.*.systemMost
        return
    }
    if work.ringDown(w) { into.*.why = record.Why.RING_DOWN }
}

// The contexts: whose card each is on, and how many descriptors hold it
// (a duplicate, a branch, a handle sent each add one; the last close ends
// it).
pub const MOST_CONTEXTS: usize = 64

pub const Contexts = struct {
    used: [MOST_CONTEXTS]bool
    card: [MOST_CONTEXTS]usize
    holders: [MOST_CONTEXTS]usize

    // None.
    pub fn reset(self: *Self) -> void {
        var k: usize = 0
        while k < MOST_CONTEXTS {
            self.*.used[k] = false
            self.*.card[k] = 0
            self.*.holders[k] = 0
            k += 1
        }
    }

    // A new context on card `index`: its number, or MOST_CONTEXTS when
    // every one is taken. Its one holder is the descriptor made for it.
    pub fn begin(self: *Self, index: usize) -> usize {
        var k: usize = 0
        while k < MOST_CONTEXTS {
            if !self.*.used[k] {
                self.*.used[k] = true
                self.*.card[k] = index
                self.*.holders[k] = 1
                return k
            }
            k += 1
        }
        return MOST_CONTEXTS
    }

    // The card of context `which`.
    pub fn cardOf(self: *const Self, which: usize) -> usize { return self.*.card[which] }

    // One more descriptor holds context `which`.
    pub fn retain(self: *Self, which: usize) -> void {
        if which < MOST_CONTEXTS && self.*.used[which] { self.*.holders[which] += 1 }
    }

    // A descriptor of context `which` closed: the last one ends it.
    pub fn release(self: *Self, which: usize) -> void {
        if which >= MOST_CONTEXTS || !self.*.used[which] { return }
        self.*.holders[which] -= 1
        if self.*.holders[which] == 0 { self.*.used[which] = false }
    }

    // Context `which`, whose last descriptor went, kept taken while its
    // card state lives on (gpu_work.mlx: its work still in flight), so
    // that no new context gets its number before it ended.
    pub fn keep(self: *Self, which: usize) -> void {
        if which >= MOST_CONTEXTS || self.*.used[which] { return }
        self.*.used[which] = true
        self.*.holders[which] = 0
    }

    // The numbers kept so whose context has ended since, free again.
    pub fn reclaim(self: *Self, w: *const work.Work) -> void {
        var k: usize = 0
        while k < MOST_CONTEXTS {
            if self.*.used[k] && self.*.holders[k] == 0 && !work.inUse(w, k) { self.*.used[k] = false }
            k += 1
        }
    }

    // How many contexts there are.
    pub fn living(self: *const Self) -> usize {
        var alive: usize = 0
        var k: usize = 0
        while k < MOST_CONTEXTS {
            if self.*.used[k] { alive += 1 }
            k += 1
        }
        return alive
    }
}
