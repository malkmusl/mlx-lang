// The system calls on paths and files: Linux's numbers, the path relative
// to the working directory or to a descriptor's directory (AT_FDCWD for
// the working one), the file system of vfs.mlx. /proc/self/exe names the
// program the process runs (a shell runs scripts by it).
const process = @import("./process.mlx")
const files = @import("./files.mlx")
const vfs = @import("./vfs.mlx")
const memory = @import("./memory.mlx")
const clock = @import("./clock.mlx")
const Bytes = @import("./bytes.mlx").Bytes
const Errno = @import("./errno.mlx").Errno
const Process = process.Process
const Vfs = vfs.Vfs
const NodeKind = vfs.NodeKind
const Open = files.Open

// Linux x86-64's numbers of the calls this module answers.
pub const FileNumber = struct {
    pub const OPEN: usize = 2
    pub const STAT: usize = 4
    pub const FSTAT: usize = 5
    pub const LSTAT: usize = 6
    pub const ACCESS: usize = 21
    pub const FSYNC: usize = 74
    pub const FDATASYNC: usize = 75
    pub const TRUNCATE: usize = 76
    pub const FTRUNCATE: usize = 77
    pub const GETCWD: usize = 79
    pub const CHDIR: usize = 80
    pub const FCHDIR: usize = 81
    pub const RENAME: usize = 82
    pub const MKDIR: usize = 83
    pub const RMDIR: usize = 84
    pub const CREAT: usize = 85
    pub const LINK: usize = 86
    pub const UNLINK: usize = 87
    pub const SYMLINK: usize = 88
    pub const READLINK: usize = 89
    pub const CHMOD: usize = 90
    pub const FCHMOD: usize = 91
    pub const CHOWN: usize = 92
    pub const FCHOWN: usize = 93
    pub const LCHOWN: usize = 94
    pub const MKNOD: usize = 133
    pub const STATFS: usize = 137
    pub const FSTATFS: usize = 138
    pub const SYNC: usize = 162
    pub const GETDENTS64: usize = 217
    pub const OPENAT: usize = 257
    pub const MKDIRAT: usize = 258
    pub const MKNODAT: usize = 259
    pub const FCHOWNAT: usize = 260
    pub const NEWFSTATAT: usize = 262
    pub const UNLINKAT: usize = 263
    pub const RENAMEAT: usize = 264
    pub const LINKAT: usize = 265
    pub const SYMLINKAT: usize = 266
    pub const READLINKAT: usize = 267
    pub const FCHMODAT: usize = 268
    pub const FACCESSAT: usize = 269
    pub const UTIMENSAT: usize = 280
    pub const SYNCFS: usize = 306
    pub const RENAMEAT2: usize = 316
    pub const STATX: usize = 332
    pub const FACCESSAT2: usize = 439
}

pub const FileCalls = struct {
    const AT_FDCWD: isize = -100
    const AT_REMOVEDIR: usize = 0x200
    const AT_EMPTY_PATH: usize = 0x1000
    const RENAME_NOREPLACE: usize = 1
    const X_OK: usize = 1
    const EXECUTE_BITS: usize = 0x49
    const UTIME_NOW: usize = 0x3FFFFFFF
    const UTIME_OMIT: usize = 0x3FFFFFFE
    const TMPFS_MAGIC: usize = 0x01021994
    const STATFS_SIZE: usize = 120
    const SELF_EXE = "/proc/self/exe"

    // A descriptor argument (an int: its upper half is not the caller's).
    fn descriptor(value: usize) -> isize { return @intCast(isize, @bitCast(i32, @intCast(u32, value & 0xFFFFFFFF))) }

    pub fn handles(number: usize) -> bool {
        return number == FileNumber.OPEN || number == FileNumber.STAT || number == FileNumber.FSTAT || number == FileNumber.LSTAT || number == FileNumber.ACCESS || (number >= FileNumber.FSYNC && number <= FileNumber.LCHOWN) || number == FileNumber.MKNOD || number == FileNumber.STATFS || number == FileNumber.FSTATFS || number == FileNumber.SYNC || number == FileNumber.GETDENTS64 || (number >= FileNumber.OPENAT && number <= FileNumber.FACCESSAT) || number == FileNumber.UTIMENSAT || number == FileNumber.SYNCFS || number == FileNumber.RENAMEAT2 || number == FileNumber.STATX || number == FileNumber.FACCESSAT2
    }

    pub fn call(p: *Process, number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {
        const fd = descriptor(a1)
        if number == FileNumber.OPEN { return open(p, AT_FDCWD, a1, a2, a3) }
        if number == FileNumber.OPENAT { return open(p, fd, a2, a3, a4) }
        if number == FileNumber.CREAT { return open(p, AT_FDCWD, a1, Open.CREATE | Open.WRITE_ONLY | Open.TRUNCATE, a2) }
        if number == FileNumber.STAT || number == FileNumber.LSTAT { return statusOf(p, AT_FDCWD, a1, 0, a2, false) }
        if number == FileNumber.FSTAT { return statusOfDescriptor(p, fd, a2, false) }
        if number == FileNumber.NEWFSTATAT { return statusOf(p, fd, a2, a4, a3, false) }
        if number == FileNumber.STATX { return statusOf(p, fd, a2, a3, a5, true) }
        if number == FileNumber.ACCESS { return access(p, AT_FDCWD, a1, a2) }
        if number == FileNumber.FACCESSAT || number == FileNumber.FACCESSAT2 { return access(p, fd, a2, a3) }
        if number == FileNumber.GETCWD { return workingDirectory(p, a1, a2) }
        if number == FileNumber.CHDIR { return changeDirectory(p, AT_FDCWD, a1) }
        if number == FileNumber.FCHDIR {
            const node = p.*.files.nodeOf(fd)
            if node == Vfs.NONE { return Errno.EBADF }
            if !vfs.fileSystem().node(node).isDirectory() { return Errno.ENOTDIR }
            p.setDirectory(node)
            return 0
        }
        if number == FileNumber.MKDIR { return makeDirectory(p, AT_FDCWD, a1, a2) }
        if number == FileNumber.MKDIRAT { return makeDirectory(p, fd, a2, a3) }
        if number == FileNumber.RMDIR { return remove(p, AT_FDCWD, a1, true) }
        if number == FileNumber.UNLINK { return remove(p, AT_FDCWD, a1, false) }
        if number == FileNumber.UNLINKAT { return remove(p, fd, a2, a3 & AT_REMOVEDIR != 0) }
        if number == FileNumber.RENAME { return rename(p, AT_FDCWD, a1, AT_FDCWD, a2, 0) }
        if number == FileNumber.RENAMEAT { return rename(p, fd, a2, descriptor(a3), a4, 0) }
        if number == FileNumber.RENAMEAT2 { return rename(p, fd, a2, descriptor(a3), a4, a5) }
        if number == FileNumber.LINK { return link(p, AT_FDCWD, a1, AT_FDCWD, a2) }
        if number == FileNumber.LINKAT { return link(p, fd, a2, descriptor(a3), a4) }
        // No symbolic links, no device files made by programs.
        if number == FileNumber.SYMLINK || number == FileNumber.SYMLINKAT || number == FileNumber.MKNOD || number == FileNumber.MKNODAT { return Errno.EPERM }
        if number == FileNumber.READLINK { return readLink(p, AT_FDCWD, a1, a2, a3) }
        if number == FileNumber.READLINKAT { return readLink(p, fd, a2, a3, a4) }
        if number == FileNumber.TRUNCATE { return truncatePath(p, a1, a2) }
        if number == FileNumber.FTRUNCATE {
            const node = p.*.files.nodeOf(fd)
            if node == Vfs.NONE { return Errno.EBADF }
            return truncateNode(node, a2)
        }
        if number == FileNumber.CHMOD { return changeMode(p, AT_FDCWD, a1, a2) }
        if number == FileNumber.FCHMODAT { return changeMode(p, fd, a2, a3) }
        if number == FileNumber.FCHMOD {
            const node = p.*.files.nodeOf(fd)
            if node == Vfs.NONE { return Errno.EBADF }
            setMode(node, a2)
            return 0
        }
        // One user: owners stay.
        if number == FileNumber.CHOWN || number == FileNumber.LCHOWN { return exists(p, AT_FDCWD, a1) }
        if number == FileNumber.FCHOWNAT { return exists(p, fd, a2) }
        if number == FileNumber.FCHOWN { return if p.*.files.get(fd) == null { Errno.EBADF } else { 0 } }
        if number == FileNumber.UTIMENSAT { return setTimes(p, fd, a2, a3, a4) }
        // Everything is in memory already.
        if number == FileNumber.FSYNC || number == FileNumber.FDATASYNC || number == FileNumber.SYNCFS { return if p.*.files.get(fd) == null { Errno.EBADF } else { 0 } }
        if number == FileNumber.SYNC { return 0 }
        if number == FileNumber.STATFS || number == FileNumber.FSTATFS { return fileSystemStatus(p, a2) }
        if number == FileNumber.GETDENTS64 {
            if !p.prepare(a2, a3) { return Errno.EFAULT }
            return p.*.files.entries(fd, Bytes.pointer(a2), a3)
        }
        return Errno.ENOSYS
    }

    // ---- paths ----

    fn isSelfExe(path: [*]const u8) -> bool {
        var k: usize = 0
        while k < SELF_EXE.length {
            if path[k] != SELF_EXE[k] { return false }
            k += 1
        }
        return path[k] == 0
    }

    // The directory relative paths start from: the working one
    // (AT_FDCWD) or a descriptor's; -errno.
    fn base(p: *Process, dirfd: isize) -> isize {
        if dirfd == AT_FDCWD { return @intCast(isize, p.*.directory) }
        const node = p.*.files.nodeOf(dirfd)
        if node == Vfs.NONE { return Errno.EBADF }
        if !vfs.fileSystem().node(node).isDirectory() { return Errno.ENOTDIR }
        return @intCast(isize, node)
    }

    // The node a path argument names; -errno (EFAULT when it is not the
    // process's).
    pub fn resolve(p: *Process, dirfd: isize, path: usize) -> isize {
        if !p.prepareString(path) { return Errno.EFAULT }
        const text = Bytes.pointer(path)
        if isSelfExe(text) { return if p.*.program == Vfs.NONE { Errno.ENOENT } else { @intCast(isize, p.*.program) } }
        if text[0] == 0 { return Errno.ENOENT }
        const from = if text[0] == 47 { @intCast(isize, Vfs.ROOT) } else { base(p, dirfd) }
        if from < 0 { return from }
        return vfs.fileSystem().resolve(@bitCast(usize, from), text)
    }

    // The directory that would hold a path's last component (its node, or
    // -errno), the component into `name`.
    fn resolveParent(p: *Process, dirfd: isize, path: usize, name: *[]const u8) -> isize {
        if !p.prepareString(path) { return Errno.EFAULT }
        const text = Bytes.pointer(path)
        if text[0] == 0 { return Errno.ENOENT }
        const from = if text[0] == 47 { @intCast(isize, Vfs.ROOT) } else { base(p, dirfd) }
        if from < 0 { return from }
        return vfs.fileSystem().resolveParent(@bitCast(usize, from), text, name)
    }

    // For execve: whether the path is /proc/self/exe, and the directory
    // that names a path's last component.
    pub fn isSelfExePath(p: *Process, path: usize) -> bool { return p.prepareString(path) && isSelfExe(Bytes.pointer(path)) }

    pub fn parentOf(p: *Process, path: usize, name: *[]const u8) -> isize { return resolveParent(p, AT_FDCWD, path, name) }

    fn isDot(name: []const u8) -> bool { return (name.length == 1 && name[0] == 46) || (name.length == 2 && name[0] == 46 && name[1] == 46) }

    // ---- the calls ----

    fn open(p: *Process, dirfd: isize, path: usize, flags: usize, mode: usize) -> isize {
        const tree = vfs.fileSystem()
        var found = resolve(p, dirfd, path)
        if found >= 0 && flags & Open.CREATE != 0 && flags & Open.EXCLUSIVE != 0 { return Vfs.EEXIST }
        if found == Errno.ENOENT && flags & Open.CREATE != 0 {
            var name: []const u8 = undefined
            const directory = resolveParent(p, dirfd, path, &name)
            if directory < 0 { return directory }
            if name.length == 0 || isDot(name) { return Errno.EISDIR }
            const made = tree.create(NodeKind.file, mode & ~p.*.umask)
            if made == Vfs.NONE { return Vfs.ENOSPC }
            const linked = tree.link(@bitCast(usize, directory), name.pointer, name.length, made)
            if linked < 0 {
                tree.retain(made)
                tree.release(made)
                return linked
            }
            found = @intCast(isize, made)
        }
        if found < 0 { return found }
        const node = @bitCast(usize, found)
        const n = tree.node(node)
        if flags & Open.DIRECTORY != 0 && !n.isDirectory() { return Errno.ENOTDIR }
        if n.isDirectory() && Open.writes(flags) { return Errno.EISDIR }
        if flags & Open.TRUNCATE != 0 && Open.writes(flags) && n.isRegular() {
            const truncated = tree.truncate(node, 0)
            if truncated < 0 { return truncated }
        }
        return p.*.files.openNode(node, flags)
    }

    fn statusOf(p: *Process, dirfd: isize, path: usize, flags: usize, address: usize, statx: bool) -> isize {
        const size = if statx { files.Status.STATX_SIZE } else { files.Status.SIZE }
        if !p.prepare(address, size) { return Errno.EFAULT }
        if flags & AT_EMPTY_PATH != 0 && p.prepareString(path) && Bytes.pointer(path)[0] == 0 {
            if dirfd == AT_FDCWD {
                files.Status.ofNode(p.*.directory, Bytes.pointer(address), statx)
                return 0
            }
            return p.*.files.status(dirfd, Bytes.pointer(address), statx)
        }
        const found = resolve(p, dirfd, path)
        if found < 0 { return found }
        files.Status.ofNode(@bitCast(usize, found), Bytes.pointer(address), statx)
        return 0
    }

    fn statusOfDescriptor(p: *Process, fd: isize, address: usize, statx: bool) -> isize {
        if !p.prepare(address, if statx { files.Status.STATX_SIZE } else { files.Status.SIZE }) { return Errno.EFAULT }
        return p.*.files.status(fd, Bytes.pointer(address), statx)
    }

    // access: whether it is there (and, for X_OK, a directory or a file
    // with an execute bit: there is one user, and it may do the rest).
    fn access(p: *Process, dirfd: isize, path: usize, mode: usize) -> isize {
        const found = resolve(p, dirfd, path)
        if found < 0 { return found }
        const n = vfs.fileSystem().node(@bitCast(usize, found))
        if mode & X_OK != 0 && n.isRegular() && n.*.mode & EXECUTE_BITS == 0 { return Errno.EACCES }
        return 0
    }

    fn exists(p: *Process, dirfd: isize, path: usize) -> isize {
        const found = resolve(p, dirfd, path)
        return if found < 0 { found } else { 0 }
    }

    fn workingDirectory(p: *Process, address: usize, capacity: usize) -> isize {
        if !p.prepare(address, capacity) { return Errno.EFAULT }
        const length = vfs.fileSystem().pathOf(p.*.directory, Bytes.pointer(address), capacity)
        if length == 0 { return Errno.ERANGE }
        return @intCast(isize, length + 1)
    }

    fn changeDirectory(p: *Process, dirfd: isize, path: usize) -> isize {
        const found = resolve(p, dirfd, path)
        if found < 0 { return found }
        const node = @bitCast(usize, found)
        if !vfs.fileSystem().node(node).isDirectory() { return Errno.ENOTDIR }
        p.setDirectory(node)
        return 0
    }

    fn makeDirectory(p: *Process, dirfd: isize, path: usize, mode: usize) -> isize {
        var name: []const u8 = undefined
        const directory = resolveParent(p, dirfd, path, &name)
        if directory < 0 { return directory }
        if name.length == 0 || isDot(name) { return Vfs.EEXIST }
        const made = vfs.fileSystem().makeDirectory(@bitCast(usize, directory), name, mode & ~p.*.umask)
        return if made < 0 { made } else { 0 }
    }

    // unlink, or rmdir (`directory`).
    fn remove(p: *Process, dirfd: isize, path: usize, directory: bool) -> isize {
        const tree = vfs.fileSystem()
        var name: []const u8 = undefined
        const parent = resolveParent(p, dirfd, path, &name)
        if parent < 0 { return parent }
        if name.length == 0 { return Vfs.EBUSY }
        if isDot(name) { return if directory { Errno.EINVAL } else { Errno.EISDIR } }
        const target = tree.lookup(@bitCast(usize, parent), name.pointer, name.length)
        if target == Vfs.NONE { return Errno.ENOENT }
        const n = tree.node(target)
        if directory {
            if !n.isDirectory() { return Errno.ENOTDIR }
            if target == Vfs.ROOT { return Vfs.EBUSY }
            if !tree.isEmpty(target) { return Vfs.ENOTEMPTY }
        } else if n.isDirectory() {
            return Errno.EISDIR
        }
        return tree.unlink(@bitCast(usize, parent), name.pointer, name.length)
    }

    fn rename(p: *Process, oldDirfd: isize, oldPath: usize, newDirfd: isize, newPath: usize, flags: usize) -> isize {
        const tree = vfs.fileSystem()
        var oldName: []const u8 = undefined
        var newName: []const u8 = undefined
        const from = resolveParent(p, oldDirfd, oldPath, &oldName)
        if from < 0 { return from }
        const to = resolveParent(p, newDirfd, newPath, &newName)
        if to < 0 { return to }
        if oldName.length == 0 || newName.length == 0 || isDot(oldName) || isDot(newName) { return Vfs.EBUSY }
        const source = tree.lookup(@bitCast(usize, from), oldName.pointer, oldName.length)
        if source == Vfs.NONE { return Errno.ENOENT }
        const sourceIsDirectory = tree.node(source).isDirectory()
        // A directory does not go under itself.
        if sourceIsDirectory && tree.isUnder(@bitCast(usize, to), source) { return Errno.EINVAL }
        const existing = tree.lookup(@bitCast(usize, to), newName.pointer, newName.length)
        if existing == source { return 0 }
        if existing != Vfs.NONE {
            if flags & RENAME_NOREPLACE != 0 { return Vfs.EEXIST }
            const target = tree.node(existing)
            if sourceIsDirectory && !target.isDirectory() { return Errno.ENOTDIR }
            if !sourceIsDirectory && target.isDirectory() { return Errno.EISDIR }
            if target.isDirectory() && !tree.isEmpty(existing) { return Vfs.ENOTEMPTY }
            const removed = tree.unlink(@bitCast(usize, to), newName.pointer, newName.length)
            if removed < 0 { return removed }
        }
        const linked = tree.link(@bitCast(usize, to), newName.pointer, newName.length, source)
        if linked < 0 { return linked }
        return tree.unlink(@bitCast(usize, from), oldName.pointer, oldName.length)
    }

    fn link(p: *Process, oldDirfd: isize, oldPath: usize, newDirfd: isize, newPath: usize) -> isize {
        const found = resolve(p, oldDirfd, oldPath)
        if found < 0 { return found }
        const node = @bitCast(usize, found)
        if vfs.fileSystem().node(node).isDirectory() { return Errno.EPERM }
        var name: []const u8 = undefined
        const directory = resolveParent(p, newDirfd, newPath, &name)
        if directory < 0 { return directory }
        if name.length == 0 || isDot(name) { return Vfs.EEXIST }
        return vfs.fileSystem().link(@bitCast(usize, directory), name.pointer, name.length, node)
    }

    // readlink: only /proc/self/exe is a link (to the program's path).
    fn readLink(p: *Process, dirfd: isize, path: usize, address: usize, capacity: usize) -> isize {
        if !p.prepareString(path) { return Errno.EFAULT }
        if !isSelfExe(Bytes.pointer(path)) {
            const found = resolve(p, dirfd, path)
            return if found < 0 { found } else { Errno.EINVAL }
        }
        if p.*.program == Vfs.NONE { return Errno.ENOENT }
        var buffer: [512]u8 = undefined
        const tree = vfs.fileSystem()
        var length = tree.pathOf(p.*.programDirectory, &buffer, 512)
        if length == 0 { return Errno.ENOENT }
        // The program's name in that directory.
        var slot: usize = 0
        while slot < tree.slotCount(p.*.programDirectory) {
            var name: [*]const u8 = undefined
            var nameLength: usize = 0
            if tree.entry(p.*.programDirectory, slot, &name, &nameLength) == p.*.program && length + 1 + nameLength < 512 {
                if length > 1 {
                    buffer[length] = 47
                    length += 1
                }
                Bytes.copy(unsafe { @ptrFromInt([*]u8, @intFromPtr(&buffer) + length) }, name, nameLength)
                length += nameLength
                break
            }
            slot += 1
        }
        const count = if length > capacity { capacity } else { length }
        if !p.prepare(address, count) { return Errno.EFAULT }
        Bytes.copy(Bytes.pointer(address), &buffer, count)
        return @intCast(isize, count)
    }

    fn truncateNode(node: usize, size: usize) -> isize {
        const n = vfs.fileSystem().node(node)
        if n.isDirectory() { return Errno.EISDIR }
        if !n.isRegular() { return Errno.EINVAL }
        return vfs.fileSystem().truncate(node, size)
    }

    fn truncatePath(p: *Process, path: usize, size: usize) -> isize {
        const found = resolve(p, AT_FDCWD, path)
        if found < 0 { return found }
        return truncateNode(@bitCast(usize, found), size)
    }

    fn setMode(node: usize, mode: usize) -> void {
        const n = vfs.fileSystem().node(node)
        n.*.mode = mode & 0xFFF
        n.*.changed = clock.system().realtime() / clock.Clock.NANOSECONDS
    }

    fn changeMode(p: *Process, dirfd: isize, path: usize, mode: usize) -> isize {
        const found = resolve(p, dirfd, path)
        if found < 0 { return found }
        setMode(@bitCast(usize, found), mode)
        return 0
    }

    // utimensat(dirfd, path or NULL (the descriptor), times or NULL (now)).
    fn setTimes(p: *Process, dirfd: isize, path: usize, times: usize, flags: usize) -> isize {
        _ = flags
        var node: usize = Vfs.NONE
        if path == 0 {
            node = p.*.files.nodeOf(dirfd)
            if node == Vfs.NONE { return Errno.EBADF }
        } else {
            const found = resolve(p, dirfd, path)
            if found < 0 { return found }
            node = @bitCast(usize, found)
        }
        const n = vfs.fileSystem().node(node)
        const now = clock.system().realtime() / clock.Clock.NANOSECONDS
        if times == 0 {
            n.*.accessed = now
            n.*.modified = now
        } else {
            if !p.prepare(times, 32) { return Errno.EFAULT }
            const t = Bytes.pointer(times)
            const accessedNanoseconds = Bytes.read64(t, 8)
            const modifiedNanoseconds = Bytes.read64(t, 24)
            if accessedNanoseconds != UTIME_OMIT { n.*.accessed = if accessedNanoseconds == UTIME_NOW { now } else { Bytes.read64(t, 0) } }
            if modifiedNanoseconds != UTIME_OMIT { n.*.modified = if modifiedNanoseconds == UTIME_NOW { now } else { Bytes.read64(t, 16) } }
        }
        n.*.changed = now
        return 0
    }

    // statfs: the tmpfs's room is memory's.
    fn fileSystemStatus(p: *Process, address: usize) -> isize {
        if !p.prepare(address, STATFS_SIZE) { return Errno.EFAULT }
        const into = Bytes.pointer(address)
        const frames = memory.allFrames()
        Bytes.fill(into, STATFS_SIZE, 0)
        Bytes.write64(into, 0, TMPFS_MAGIC)
        Bytes.write64(into, 8, memory.Page.SIZE)
        Bytes.write64(into, 16, frames.totalBytes() / memory.Page.SIZE)
        Bytes.write64(into, 24, frames.freeBytes() / memory.Page.SIZE)
        Bytes.write64(into, 32, frames.freeBytes() / memory.Page.SIZE)
        Bytes.write64(into, 40, Vfs.MAX_NODES)
        Bytes.write64(into, 64, Vfs.NAME_MAX)
        Bytes.write64(into, 72, memory.Page.SIZE)
        return 0
    }
}
