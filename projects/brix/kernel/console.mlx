// The kernel's messages on the serial line ("\n" as "\r\n").
const serial = @import("./serial.mlx")

pub fn write(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length {
        if text[k] == 10 { serial.put(13) }
        serial.put(text[k])
        k += 1
    }
}

pub fn writeBytes(bytes: [*]const u8, length: usize) -> void {
    var k: usize = 0
    while k < length {
        if bytes[k] == 10 { serial.put(13) }
        serial.put(bytes[k])
        k += 1
    }
}

pub fn decimal(value: usize) -> void {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest /= 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        serial.put(digits[count])
    }
}

pub fn hex(value: usize) -> void {
    write("0x")
    var shift: usize = 64
    var started = false
    while shift > 0 {
        shift -= 4
        const digit = (value >> @intCast(u6, shift)) & 15
        if digit != 0 || started || shift == 0 {
            started = true
            serial.put(@intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit }))
        }
    }
}
