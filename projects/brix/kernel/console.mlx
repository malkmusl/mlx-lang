// The kernel's messages: text, numbers, on a UART ("\n" as "\r\n"). Every
// byte also goes into a ring buffer so the boot log can be read back
// (/devices/klog, a dmesg for the hardware bring-up where the serial line
// is not at hand).
const serial = @import("./serial.mlx")
const fbcon = @import("./fbcon.mlx")

pub const LOG_CAPACITY: usize = 1 << 18 // 256 KiB

var logBuffer: [LOG_CAPACITY]u8 = undefined // (per run)
var logUsed: usize = 0 // (per run)
var uart: serial.Uart = serial.Uart.{ .port = serial.Uart.COM1 } // (per run)

// A byte to the log (raw, so the log keeps plain "\n") and to the UART
// (with "\r" before "\n"). The log keeps the first LOG_CAPACITY bytes --
// the boot messages -- and drops the rest.
fn emit(byte: u8) -> void {
    if (onScreen && !inLogOnly) == hiding { hide(!hiding) }
    if logUsed < LOG_CAPACITY {
        logBuffer[logUsed] = byte
        logUsed += 1
    }
    if inLogOnly { return }
    if byte == 10 { uart.put(13) }
    uart.put(byte)
    if onScreen { fbcon.put(byte) }
}

// Whether the kernel's output goes to its log alone (/devices/klog), not
// to the serial line and the screen: for a note that is nobody's to read
// at the moment it is made and would land in the middle of a program's own
// output there (a program's fault that its handler takes). Gives back
// what it was, to be put back.
var inLogOnly = false // (per run)

pub fn logOnly(enabled: bool) -> bool {
    const was = inLogOnly
    inLogOnly = enabled
    return was
}

// Whether the kernel's output is also drawn on the screen (it is, unless
// a long dump is under way: a driver's registers, say, which belong in the
// log and on the serial line but would scroll what matters off a screen
// of 67 rows). Gives back what it was, to be put back:
//
//     const was = console.screen(false)
//     dump()
//     _ = console.screen(was)
var onScreen = true // (per run)

pub fn screen(enabled: bool) -> bool {
    const was = onScreen
    onScreen = enabled
    return was
}

pub fn logLength() -> usize { return logUsed }

// The parts of the log that were not for the screen (a dump kept off it,
// a note for the log alone): where each begins and ends, so that the log
// drawn again is what the screen showed. (The first HIDDEN of them: what
// comes after is drawn.)
const HIDDEN: usize = 32
var hiddenFrom: [HIDDEN]usize = undefined // (per run)
var hiddenTo: [HIDDEN]usize = undefined // (per run)
var hiddenCount: usize = 0 // (per run)
var hiding = false // (per run)

// A part that is not for the screen begins at the log's end, or ends
// there.
fn hide(begins: bool) -> void {
    hiding = begins
    if begins {
        if hiddenCount < HIDDEN { hiddenFrom[hiddenCount] = logUsed }
    } else if hiddenCount < HIDDEN {
        hiddenTo[hiddenCount] = logUsed
        hiddenCount += 1
    }
}

// The log drawn on the framebuffer console but for the parts that were
// not for the screen.
fn replay() -> void {
    var k: usize = 0
    var part: usize = 0
    while k < logUsed {
        if part < hiddenCount && k >= hiddenFrom[part] {
            if k < hiddenTo[part] { k = hiddenTo[part] }
            part += 1
        } else if part == hiddenCount && hiding && part < HIDDEN && k >= hiddenFrom[part] {
            return
        } else {
            fbcon.put(logBuffer[k])
            k += 1
        }
    }
}

// Turns the framebuffer console on (the diagnostic path, where no graphical
// session takes the screen) and redraws the log collected so far, so the
// whole boot is on screen. False when there is no display.
pub fn enableFramebuffer() -> bool {
    if !fbcon.enable() { return false }
    replay()
    return true
}

// The framebuffer console on a new picture (the display's mode was set
// anew): made anew for its size, and what the screen showed drawn again.
// False when the console was not on the screen (a program draws there, or
// there is no display).
pub fn reshapeFramebuffer() -> bool {
    if !fbcon.reshape() { return false }
    replay()
    return true
}

// The kernel's output on the screen again, whoever draws there (the kernel
// stopped by a fault of its own: what it says then must be seen).
pub fn showOnScreen() -> void {
    onScreen = true
    inLogOnly = false
    _ = fbcon.takeOver()
}

// Whether the kernel's output is drawn on the screen at the moment (no
// program has the display).
pub fn drawn() -> bool { return onScreen && fbcon.enabled() }

// What the log holds from `offset` up to `end`, drawn on the screen: lines
// the kernel said while a program had the display (they went to the log
// and the serial line alone) and that are to be read there now.
pub fn showFrom(offset: usize, end: usize) -> void {
    var k = offset
    while k < end && k < logUsed {
        fbcon.put(logBuffer[k])
        k += 1
    }
}

// Up to `capacity` log bytes from `offset`; how many (0 at the end).
pub fn logRead(offset: usize, into: [*]u8, capacity: usize) -> usize {
    if offset >= logUsed { return 0 }
    var count = logUsed - offset
    if count > capacity { count = capacity }
    var k: usize = 0
    while k < count {
        into[k] = logBuffer[offset + k]
        k += 1
    }
    return count
}

pub const Console = struct {
    uart: serial.Uart

    pub fn write(self: Self, text: []const u8) -> void { self.writeBytes(text.pointer, text.length) }

    pub fn writeBytes(self: Self, bytes: [*]const u8, length: usize) -> void {
        var k: usize = 0
        while k < length {
            emit(bytes[k])
            k += 1
        }
    }

    pub fn decimal(self: Self, value: usize) -> void {
        var digits: [20]u8 = undefined
        var count: usize = 0
        var rest = value
        while true {
            digits[count] = @intCast(u8, 48 + rest % 10)
            count += 1
            rest /= 10
            if rest == 0 { break }
        }
        while count > 0 {
            count -= 1
            emit(digits[count])
        }
    }

    // Two hex digits (a byte, a MAC's part).
    pub fn hexByte(self: Self, value: usize) -> void {
        const high = (value >> 4) & 15
        const low = value & 15
        emit(@intCast(u8, if high < 10 { 48 + high } else { 87 + high }))
        emit(@intCast(u8, if low < 10 { 48 + low } else { 87 + low }))
    }

    pub fn hex(self: Self, value: usize) -> void {
        self.write("0x")
        var shift: usize = 64
        var started = false
        while shift > 0 {
            shift -= 4
            const digit = (value >> @intCast(u6, shift)) & 15
            if digit != 0 || started || shift == 0 {
                started = true
                emit(@intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit }))
            }
        }
    }
}

// The kernel's console: COM1.
pub const out = Console.{ .uart = serial.Uart.{ .port = serial.Uart.COM1 } }
