// The other processors: found in ACPI's MADT (the BIOS's RSDP, its RSDT,
// the APIC table's local APICs), given a trap stack, a TSS and a block
// each (layout.PerCpu), started through the local APIC (INIT, then two
// startup IPIs naming the trampoline's page, layout.Ap) and counted as
// they reach long mode; they go on into the kernel (brix_ap, trap.mlx)
// and run processes of their own, their time slices by their local
// APIC's timer. The kernel runs on one processor at a time (`lock`, the
// kernel lock: taken at every entry, let go while a processor idles);
// the processes run beside each other. An idle processor (halted) is
// woken by an IPI (Vector.WAKE) when a process can run. At most
// layout.Memory.MAX_CPUS run it; the rest stay in the trampoline,
// halted.
const layout = @import("../layout.mlx")
const memory = @import("./memory.mlx")
const clock = @import("./clock.mlx")
const cpu = @import("./cpu.mlx")
const Bytes = @import("./bytes.mlx").Bytes
const console = @import("./console.mlx")
const vfs = @import("./vfs.mlx")

// The local APIC's registers (its page mapped uncached at its physical
// address in the kernel's view).
const LAPIC: usize = 0xFEE00000
const ID: usize = 0x20
const EOI: usize = 0xB0
const SPURIOUS: usize = 0xF0
const ICR_LOW: usize = 0x300
const ICR_HIGH: usize = 0x310
const LVT_TIMER: usize = 0x320
const TIMER_INITIAL: usize = 0x380
const TIMER_CURRENT: usize = 0x390
const TIMER_DIVIDE: usize = 0x3E0
const VERSION: usize = 0x30
const DELIVERY_PENDING: u32 = 0x1000
const TIMER_PERIODIC: u32 = 0x20000
const TIMER_MASKED: u32 = 0x10000
// The processors the firmware may name (a board with two large ones).
const MAX_LISTED: usize = 256
// An ACPI table's most bytes (what is taken for one; they are a few KiB).
const MAX_TABLE: usize = 0x100000
// A trap stack: 64 pages (as the first processor's).
const STACK_PAGES: usize = 64

pub const MAX_CPUS: usize = layout.Memory.MAX_CPUS

// A value for each processor that may run the kernel.
pub fn PerProcessor(comptime T: type) -> type {
    return struct {
        items: [MAX_CPUS]T

        pub fn at(self: *Self, id: usize) -> *T { return &self.*.items[id] }

        pub fn fill(self: *Self, value: T) -> void {
            var k: usize = 0
            while k < MAX_CPUS {
                self.*.items[k] = value
                k += 1
            }
        }
    }
}

pub const Processors = struct {
    // Processors the MADT names (enabled), how many more started (into
    // the trampoline), and how many run the kernel.
    count: usize
    started: usize
    running: usize
    apicIds: [MAX_LISTED]usize
    // The local APIC's timer ticks in 10 ms (a time slice).
    timerTicks: usize
    mapped: bool
}

var found: Processors = undefined // (per run)
// Of the processors running the kernel: whether each idles (halted,
// the kernel let go of), and its local APIC's id (IPIs).
var idle: PerProcessor(bool) = undefined // (per run)
var apic: PerProcessor(usize) = undefined // (per run)

pub fn processors() -> *Processors { return &found }

// The kernel lock: the processor holding it (+ 1; 0: none) and how
// often it took it (an interrupt while it waits inside the kernel takes
// it again).
var lockOwner: usize = 0 // (per run)
var lockDepth: usize = 0 // (per run)
// The processor the kernel runs on (valid while it holds the lock).
var current: usize = 0 // (per run)

pub fn currentCpu() -> usize { return current }

// The kernel taken by processor `id` (waited for when another has it).
pub fn lock(id: usize) -> void {
    if lockOwner == id + 1 {
        lockDepth += 1
        return
    }
    while true {
        const taken = @cmpxchgWeak(usize, &lockOwner, 0, id + 1, acquire, monotonic)
        if taken.0 { break }
    }
    lockDepth = 1
    current = id
}

pub fn unlock() -> void {
    lockDepth -= 1
    if lockDepth == 0 { @atomicStore(usize, &lockOwner, 0, release) }
}

fn physical(address: usize) -> [*]u8 { return Bytes.pointer(layout.Memory.virtual(address)) }

fn same(bytes: [*]const u8, text: []const u8) -> bool {
    var k: usize = 0
    while k < text.length {
        if bytes[k] != text[k] { return false }
        k += 1
    }
    return true
}

// The firmware's memory at `address` (`length` bytes of its ACPI tables:
// no RAM the kernel hands out, so nothing has put it in the kernel's
// view) where the kernel sees it; 0 when it cannot be.
fn firmware(address: usize, length: usize) -> usize {
    if address == 0 || length == 0 { return 0 }
    return memory.Device.map(address, length, 0)
}

// Whether the `length` bytes at `at` (in the kernel's view) add up to 0,
// as an ACPI structure's do.
fn sums(at: usize, length: usize) -> bool {
    const bytes = Bytes.pointer(at)
    var total: usize = 0
    var k: usize = 0
    while k < length {
        total += @intCast(usize, bytes[k])
        k += 1
    }
    return total & 0xFF == 0
}

// The RSDP, in the kernel's view: the one a UEFI firmware named (the EFI
// loader passes it on: such a firmware keeps none in the BIOS area), else
// the BIOS's, in the EBDA's first KiB or at 0xE0000..0xFFFFF on a 16-byte
// boundary; its checksum right. 0 when there is none.
fn rsdp() -> usize {
    const given = cpu.BootInfo.get(layout.Info.RSDP)
    if given != 0 {
        const at = firmware(given, 36)
        if at != 0 && same(Bytes.pointer(at), "RSD PTR ") && sums(at, 20) { return at }
    }
    const ebda = Bytes.read16(physical(0x40E), 0) << 4
    var at = ebda
    while ebda != 0 && at < ebda + 1024 {
        if same(physical(at), "RSD PTR ") && sums(layout.Memory.virtual(at), 20) { return layout.Memory.virtual(at) }
        at += 16
    }
    at = 0xE0000
    while at < 0x100000 {
        if same(physical(at), "RSD PTR ") && sums(layout.Memory.virtual(at), 20) { return layout.Memory.virtual(at) }
        at += 16
    }
    return 0
}

// The ACPI table at the physical `address`, all of it in the kernel's
// view; 0 when there is none (or its length is no table's).
fn acpiTable(address: usize) -> usize {
    const header = firmware(address, 36)
    if header == 0 { return 0 }
    const length = Bytes.read32(Bytes.pointer(header), 4)
    if length < 36 || length > MAX_TABLE { return 0 }
    return firmware(address, length)
}

// The MADT ("APIC") among the tables the RSDP at `root` names: the
// XSDT's 64-bit entries when it has one (ACPI 2.0; a firmware may give
// no RSDT then), else the RSDT's 32-bit ones. 0 when there is none.
fn madtOf(root: usize) -> usize {
    const pointer = Bytes.pointer(root)
    var list: usize = 0
    var width: usize = 8
    if pointer[15] >= 2 { list = acpiTable(Bytes.read64(pointer, 24)) }
    if list == 0 {
        list = acpiTable(Bytes.read32(pointer, 16))
        width = 4
    }
    if list == 0 { return 0 }
    const entries = Bytes.pointer(list)
    const length = Bytes.read32(entries, 4)
    var at: usize = 36
    while at + width <= length {
        const address = if width == 8 { Bytes.read64(entries, at) } else { Bytes.read32(entries, at) }
        const table = acpiTable(address)
        if table != 0 && same(Bytes.pointer(table), "APIC") { return table }
        at += width
    }
    return 0
}

// One more processor the firmware names (its local APIC's id), unless it
// is listed already.
fn list(id: usize) -> void {
    var k: usize = 0
    while k < found.count {
        if found.apicIds[k] == id { return }
        k += 1
    }
    if found.count < MAX_LISTED {
        found.apicIds[found.count] = id
        found.count += 1
    }
}

// How many processors may run the kernel: /system/settings/processors
// (a number; 1: only the first) when the image has it, else all the
// kernel has room for. The way to start a machine on one processor when
// the others are in doubt.
fn allowed() -> usize {
    const tree = vfs.fileSystem()
    const file = tree.resolve(vfs.Vfs.ROOT, "/system/settings/processors\x00".pointer)
    if file < 0 { return MAX_CPUS }
    var text: [16]u8 = undefined
    const length = tree.read(@bitCast(usize, file), 0, &text, 16)
    var value: usize = 0
    var k: usize = 0
    while k < length && text[k] >= 48 && text[k] <= 57 {
        value = value * 10 + @intCast(usize, text[k] - 48)
        k += 1
    }
    if k == 0 || value == 0 { return MAX_CPUS }
    return if value > MAX_CPUS { MAX_CPUS } else { value }
}

fn reg(offset: usize) -> *u32 { return unsafe { @ptrFromInt(*u32, layout.Memory.virtual(LAPIC) + offset) } }

// The local APIC's page in the kernel's view, uncached; false when
// memory is out.
fn mapApic() -> bool {
    if found.mapped { return true }
    if memory.Device.map(LAPIC, memory.Page.SIZE, memory.Device.UNCACHED) == 0 { return false }
    found.mapped = true
    return true
}

fn wait(nanoseconds: usize) -> void {
    const until = clock.system().monotonic() + nanoseconds
    while clock.system().monotonic() < until {}
}

fn send(apic: usize, command: u32) -> void {
    reg(ICR_HIGH).* = @intCast(u32, apic << 24)
    reg(ICR_LOW).* = command
    var tries: usize = 0
    while reg(ICR_LOW).* & DELIVERY_PENDING != 0 && tries < 1000000 { tries += 1 }
}

// The local APIC's timer ticks in 10 ms, measured on this processor
// (the timer counts the bus clock, the same on every one).
fn measureTimer() -> void {
    reg(SPURIOUS).* = 0x100 | @intCast(u32, layout.Vector.SPURIOUS)
    reg(TIMER_DIVIDE).* = 0xB
    reg(LVT_TIMER).* = TIMER_MASKED | @intCast(u32, layout.Vector.LAPIC_TIMER)
    reg(TIMER_INITIAL).* = 0xFFFFFFFF
    wait(10000000)
    const left = @intCast(usize, reg(TIMER_CURRENT).*)
    reg(TIMER_INITIAL).* = 0
    found.timerTicks = 0xFFFFFFFF - left
}

// This processor's local APIC timer: an interrupt (Vector.LAPIC_TIMER)
// every 10 ms, its time slice.
pub fn startTimer() -> void {
    if found.timerTicks == 0 { return }
    reg(SPURIOUS).* = 0x100 | @intCast(u32, layout.Vector.SPURIOUS)
    reg(TIMER_DIVIDE).* = 0xB
    reg(LVT_TIMER).* = TIMER_PERIODIC | @intCast(u32, layout.Vector.LAPIC_TIMER)
    reg(TIMER_INITIAL).* = @intCast(u32, found.timerTicks)
}

// The end of a local APIC interrupt (its timer's, a device's message).
pub fn endOfInterrupt() -> void { reg(EOI).* = 0 }

// This processor's local APIC made ready to take a device's interrupt (a
// message-signalled one: Pci.enableMsi): in the kernel's view, on (its
// spurious vector set), answering there; whether it is, and its id for
// the message's address. Also on a machine where one processor runs
// (the others' start does as much on the way). Not in x2APIC mode.
pub fn localApic() -> (bool, usize) {
    // (Bit 11: the local APIC is on; bit 10: in x2APIC mode.)
    if cpu.Msr.read(cpu.Msr.APIC_BASE) & 0xC00 != 0x800 { return -> (false, 0) }
    if !mapApic() { return -> (false, 0) }
    const version = @intCast(usize, reg(VERSION).*)
    if version == 0 || version == 0xFFFFFFFF { return -> (false, 0) }
    reg(SPURIOUS).* = 0x100 | @intCast(u32, layout.Vector.SPURIOUS)
    return -> (true, @intCast(usize, reg(ID).* >> 24))
}

// Processor `k`'s block and TSS: a trap stack of its own, its share of
// the arena, its number; false when memory is out.
fn prepare(k: usize) -> bool {
    const stack = memory.allFrames().allocateContiguous(STACK_PAGES)
    if stack == 0 { return false }
    const top = layout.Memory.virtual(stack + STACK_PAGES * memory.Page.SIZE)
    const block = Bytes.pointer(layout.Blob.perCpuOf(k))
    Bytes.write64(block, layout.PerCpu.TRAP_STACK, top)
    Bytes.write64(block, layout.PerCpu.USER_RSP, 0)
    Bytes.write64(block, layout.PerCpu.ARENA_BASE, layout.Memory.KERNEL_VIRTUAL + layout.Memory.arenaOf(k))
    Bytes.write64(block, layout.PerCpu.ARENA_END, layout.Memory.KERNEL_VIRTUAL + layout.Memory.arenaOf(k + 1))
    Bytes.write64(block, layout.PerCpu.INDEX, k)
    // Its arena's bump-pointer word (the arena's first, as _start sets
    // the first processor's).
    resetArena(k)
    // Its TSS: rsp0, the trap stack (interrupts from user mode).
    Bytes.write64(Bytes.pointer(layout.Blob.tssOf(k)), 4, top)
    return true
}

// The processors found, the others started (INIT, two startup IPIs),
// waited for up to a second; the first MAX_CPUS - 1 of them come into
// the kernel (brix_ap) once the first processor lets go of it.
pub fn start() -> void {
    idle.fill(false)
    apic.fill(0)
    found.count = 1
    found.started = 0
    found.running = 1
    found.timerTicks = 0
    const out = console.out
    const root = rsdp()
    if root == 0 {
        out.write("brixOS: no ACPI tables found (one processor runs)\n")
        return
    }
    const madt = madtOf(root)
    if madt == 0 {
        out.write("brixOS: the ACPI tables name no processors (one runs)\n")
        return
    }
    // The MADT's entries (a type, a length): a processor's local APIC
    // (type 0: an 8-bit id) or its x2APIC (type 9: a 32-bit id), each
    // enabled. An id of 255 or more needs the x2APIC's way of sending,
    // which is not here: such a processor is counted and left.
    const table = Bytes.pointer(madt)
    const madtLength = Bytes.read32(table, 4)
    found.count = 0
    var beyond: usize = 0
    var at: usize = 44
    while at + 2 <= madtLength {
        const kind = table[at]
        const size = @intCast(usize, table[at + 1])
        if size < 2 || at + size > madtLength { break }
        if kind == 0 && size >= 8 && Bytes.read32(table, at + 4) & 1 != 0 {
            list(@intCast(usize, table[at + 3]))
        } else if kind == 9 && size >= 16 && Bytes.read32(table, at + 8) & 1 != 0 {
            const id = Bytes.read32(table, at + 4)
            if id < 255 { list(id) } else { beyond += 1 }
        }
        at += size
    }
    if beyond != 0 {
        out.write("brixOS: ")
        out.decimal(beyond)
        out.write(" processors are reached by x2APIC only (left alone)\n")
    }
    if found.count < 2 {
        if found.count == 0 { found.count = 1 }
        return
    }
    const limit = allowed()
    if limit < 2 {
        out.write("brixOS: ")
        out.decimal(found.count)
        out.write(" processors; /system/settings/processors lets one run\n")
        return
    }
    // The local APICs where the kernel looks for them, and answering
    // there: a firmware that left them in x2APIC mode has none in memory
    // (the registers read as nothing), and IPIs written there go nowhere.
    if Bytes.read32(table, 36) != LAPIC {
        out.write("brixOS: the local APICs are at ")
        out.hex(Bytes.read32(table, 36))
        out.write(", not where the kernel looks (one processor runs)\n")
        return
    }
    if cpu.Msr.read(cpu.Msr.APIC_BASE) & 0x400 != 0 {
        out.write("brixOS: the firmware left the local APICs in x2APIC mode (one processor runs)\n")
        return
    }
    if !mapApic() { return }
    const version = @intCast(usize, reg(VERSION).*)
    if version == 0 || version == 0xFFFFFFFF {
        out.write("brixOS: the local APIC does not answer in memory (one processor runs)\n")
        return
    }
    measureTimer()
    if found.timerTicks == 0 {
        out.write("brixOS: the local APIC's timer does not count (one processor runs)\n")
        return
    }
    // The blocks of those that will run the kernel.
    var k: usize = 1
    while k < found.count && k < limit {
        if !prepare(k) { return }
        k += 1
    }
    // The trampoline where the startup IPI's vector names it.
    Bytes.copy(physical(layout.Ap.START), physical(layout.Memory.BLOB + layout.Blob.AP), layout.Ap.SIZE)
    const counter = unsafe { @ptrFromInt(*u32, layout.Memory.virtual(layout.Ap.START + layout.Ap.STARTED)) }
    counter.* = 0
    const own = @intCast(usize, reg(ID).* >> 24)
    apic.at(0).* = own
    k = 0
    var others: usize = 0
    while k < found.count && others < limit - 1 {
        const apic = found.apicIds[k]
        if apic != own {
            others += 1
            // INIT, then the startup IPI twice (vector: the page).
            send(apic, 0x4500)
            wait(10000000)
            send(apic, 0x4600 | @intCast(u32, layout.Ap.START >> 12))
            wait(200000)
            send(apic, 0x4600 | @intCast(u32, layout.Ap.START >> 12))
        }
        k += 1
    }
    const until = clock.system().monotonic() + 1000000000
    while @intCast(usize, counter.*) < others && clock.system().monotonic() < until {}
    found.started = @intCast(usize, counter.*)
}

// Processor `k`'s arena emptied: its bump-pointer word (the arena's
// first) at the start again. For a kernel path that does not return to
// its callers (brix_ap entering user mode), whose allocations would
// stay.
pub fn resetArena(k: usize) -> void {
    const base = layout.Memory.KERNEL_VIRTUAL + layout.Memory.arenaOf(k)
    Bytes.write64(Bytes.pointer(base), 0, base + 8)
}

// The processor's arena (mlx4's aggregate arena, loaded into r14 and r15
// at each entry to the kernel; its bump word is the arena's first word):
// where it stands, and back to there (what was made since is let go).
// The idle loop never leaves the kernel, so it releases each round's.
pub fn arenaMark() -> usize {
    return Bytes.read64(Bytes.pointer(layout.Memory.KERNEL_VIRTUAL + layout.Memory.arenaOf(currentCpu())), 0)
}

pub fn arenaRelease(mark: usize) -> void {
    Bytes.write64(Bytes.pointer(layout.Memory.KERNEL_VIRTUAL + layout.Memory.arenaOf(currentCpu())), 0, mark)
}

// Processor `id` runs the kernel from now on (its first entry).
pub fn joined(id: usize) -> void {
    if id + 1 > found.running { found.running = id + 1 }
    apic.at(id).* = @intCast(usize, reg(ID).* >> 24)
}

// Processor `id` idles from now on (`resting`), or no more.
pub fn rest(id: usize, resting: bool) -> void { idle.at(id).* = resting }

// An idle processor other than this one: whether there is one, and
// which.
pub fn idleProcessor() -> (bool, usize) {
    var k: usize = 0
    while k < found.running {
        if k != current && idle.at(k).* { return -> (true, k) }
        k += 1
    }
    return -> (false, 0)
}

// Processor `id` woken (an IPI to its local APIC; it looks for a
// process to run). It counts as awake from now on: one wake-up at a
// time.
pub fn wake(id: usize) -> void {
    if !found.mapped { return }
    idle.at(id).* = false
    send(apic.at(id).*, 0x4000 | @intCast(u32, layout.Vector.WAKE))
}
