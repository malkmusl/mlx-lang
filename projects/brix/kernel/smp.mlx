// The other processors: every one ACPI's MADT lists (acpi.mlx finds the
// table, processors.mlx reads its local APICs and x2APICs: those the
// firmware marks off are not started, nor the "online capable" ones it
// may bring on later, which are counted as Linux counts them), however
// many there are: a 64-core machine runs 64, a board with two large
// processors up to layout.Memory.MAX_CPUS (256). What each one needs is
// made at boot for the processors found, not for the most there could
// be: a trap stack (STACK_PAGES) with a page above it for its block
// (layout.PerCpu) and TSS, a TSS descriptor in a GDT the kernel makes
// for all of them (GDTR64 points at it), and its share of the aggregate
// arena (layout.Memory.arenaShare: the region divided among them, from
// the frames' memory where the region is too small). They are started
// through the local APIC all at once (INIT to each, then two startup
// IPIs naming the trampoline's page, layout.Ap), counted as they reach
// long mode (each says its local APIC id there), and waited for a
// second at most: one that does not answer does not hold the boot up;
// the count is then closed, and one that comes later halts in the
// trampoline. The boot log says "smp: N processors listed, M running"
// and which did not come up. They go on into the kernel (brix_ap,
// trap.mlx) and run processes of their own, their time slices by their
// local APIC's timer, which is stopped while they idle.
//
// The kernel runs on one processor at a time (`lock`, the kernel lock:
// taken at every entry, let go while a processor idles): system calls
// are serialized, the processes run beside each other (a lock of its own
// for each part of the kernel is a later step). An idle processor
// (halted, its timer stopped) is woken by an IPI (Vector.WAKE) when a
// process can run, one for each process that can, not all of them
// (`kickIdle`, `waking`); which are idle is a set of 256 bits
// (processors.Mask), looked through a word at a time.
//
// The local APICs are reached the way the firmware left them: their
// registers in memory at 0xFEE00000 (xAPIC), or as model-specific
// registers (x2APIC: a firmware does that on a machine whose processors'
// ids do not fit eight bits, or when it is told to). A processor that
// comes up in the other mode is put into the first one's.
const layout = @import("../layout.mlx")
const memory = @import("./memory.mlx")
const clock = @import("./clock.mlx")
const cpu = @import("./cpu.mlx")
const acpi = @import("./acpi.mlx")
const Bytes = @import("./bytes.mlx").Bytes
const console = @import("./console.mlx")
const vfs = @import("./vfs.mlx")
const processors_module = @import("./processors.mlx")
const Mask = processors_module.Mask

// The local APIC's registers: offsets in its page (mapped uncached at its
// physical address in the kernel's view); in x2APIC mode register `offset`
// is the model-specific register X2_BASE + offset / 16.
const LAPIC: usize = 0xFEE00000
const X2_BASE: usize = 0x800
// IA32_APIC_BASE's bits: the local APIC is on, and in x2APIC mode.
const APIC_ON: usize = 0x800
const APIC_X2: usize = 0x400
const ID: usize = 0x20
const EOI: usize = 0xB0
// The interrupts raised and not yet taken: 32 vectors a register.
const IRR: usize = 0x200
const SPURIOUS: usize = 0xF0
const ICR_LOW: usize = 0x300
const ICR_HIGH: usize = 0x310
const LVT_TIMER: usize = 0x320
const TIMER_INITIAL: usize = 0x380
const TIMER_CURRENT: usize = 0x390
const TIMER_DIVIDE: usize = 0x3E0
const VERSION: usize = 0x30
const DELIVERY_PENDING: u32 = 0x1000
const TIMER_PERIODIC: u32 = 0x20000
const TIMER_MASKED: u32 = 0x10000
// A trap stack: 64 pages (as the first processor's), and the page above
// it for the processor's block and TSS.
const STACK_PAGES: usize = 64
// How long a processor is waited for after its startup IPIs (the
// clock's nanoseconds): one that has not reached long mode by then is
// left (its place in the count closed).
const START_WAIT: usize = 1000000000
// The processors that did not come up named in the log, at most.
const MISSING_SAID: usize = 8

pub const MAX_CPUS: usize = layout.Memory.MAX_CPUS

// A value for each processor that may run the kernel.
pub fn PerProcessor(comptime T: type) -> type {
    return struct {
        items: [MAX_CPUS]T

        pub fn at(self: *Self, id: usize) -> *T { return &self.*.items[id] }

        pub fn fill(self: *Self, value: T) -> void {
            var k: usize = 0
            while k < MAX_CPUS {
                self.*.items[k] = value
                k += 1
            }
        }
    }
}

pub const Processors = struct {
    // What the MADT lists (the processors to start, by their local APIC
    // ids; those off, those the firmware may bring on, those left), how
    // many processors it lists to start (1 without a table), how many
    // more reached long mode (counted), and how many run the kernel (the
    // first and those).
    listed: processors_module.Listed
    count: usize
    started: usize
    running: usize
    // The local APIC's timer ticks in 10 ms (a time slice).
    timerTicks: usize
    mapped: bool
    // Whether the first processor's local APIC was looked at, answers
    // (IPIs can be sent, a device's message taken), and is in x2APIC
    // mode.
    looked: bool
    usable: bool
    x2: bool
}

var found: Processors = undefined // (per run)
// Of the processors running the kernel: which idle (halted, the kernel
// let go of), which were woken and have not looked for work since (and
// how many), and each one's local APIC id (IPIs), block (its GS base:
// layout.PerCpu) and arena (its base in the kernel's view).
var idle: Mask = undefined // (per run)
var woken: Mask = undefined // (per run)
var waking: usize = 0 // (per run)
var apic: PerProcessor(usize) = undefined // (per run)
var blocks: PerProcessor(usize) = undefined // (per run)
var arenas: PerProcessor(usize) = undefined // (per run)

pub fn processors() -> *Processors { return &found }

// The kernel lock: the processor holding it (+ 1; 0: none) and how
// often it took it (an interrupt while it waits inside the kernel takes
// it again).
//
// A processor that waits only LOOKS at the word until it reads free, and
// tries to take it then (a compare-and-swap asks for the word's cache
// line for itself whether it succeeds or not: the others doing that in
// a loop keep taking the line from the one that holds the lock,
// which then waits for memory at every step of its own work, and from
// each other). Between two looks it pauses (the processor's hint that
// this is a wait: Cpu.relax). The word has a cache line to itself, with
// what the holder is at beside it (a waiting processor reads that too):
// what lies around (the depth, the processor's number, which the holder
// reads all the time) must not travel with it.
const Lock = struct {
    before: [8]usize
    owner: usize
    // What the holder is at (Waits.SYSTEM_CALL and the call's number, an
    // interrupt's or fault's vector, Waits.IDLE; above them the
    // process's id, 0 where the processor idled): told by the trap path
    // and the idle loop, read by a processor that waits.
    work: usize
    after: [6]usize
}

// (With values: the word is read before anything is written to it.)
var kernel: Lock = Lock.{ .before = [8]usize{ 0, 0, 0, 0, 0, 0, 0, 0 }, .owner = 0, .work = 0, .after = [6]usize{ 0, 0, 0, 0, 0, 0 } }
var lockDepth: usize = 0 // (per run)
// The processor the kernel runs on (valid while it holds the lock).
var current: usize = 0 // (per run)

pub fn currentCpu() -> usize { return current }

// How often the processor that holds the kernel took it (1: the entry
// itself; more: a fault or an interrupt inside it).
pub fn depth() -> usize { return lockDepth }

pub fn at(what: usize) -> void { @atomicStore(usize, &kernel.work, what, monotonic) }

// Each processor: whether it is in the idle loop's halt (set before it
// lets the kernel go there, taken back after it has the kernel again):
// an interrupt it takes then is an idle processor's, and so is its wait
// for the kernel.
var halted: PerProcessor(bool) = undefined // (per run)

pub fn halts(id: usize, value: bool) -> void { halted.at(id).* = value }

// Whether the processor that holds the kernel came from its idle halt.
pub fn halting() -> bool { return halted.at(current).* }

// The waits for the kernel, in the counter's ticks: those of processors
// that had something to run summed (`total`), the longest of them since
// the start and in the last one to two WINDOWs, each with what held the
// kernel for the longest stretch of that wait (a wait may see several
// holders); and the waits of processors that had nothing to run, summed
// apart (`idle`: their ticks queue behind whoever is in the kernel and
// delay nobody). A program that stutters while another's call holds the
// kernel (a driver waiting for its device, a long copy) shows here, with
// the call. Nothing is measured where the kernel is free when asked for.
pub const Waits = struct {
    pub const SYSTEM_CALL: usize = 0x80000000
    // The holder was in its idle loop (looking for work, the kernel's
    // own writes to the disk).
    pub const IDLE: usize = 0x7FFFFFFF
    // The holder ends the system and keeps the kernel for good
    // (stopOthers): a processor that waits for it stops instead.
    pub const ENDING: usize = 0x7FFFFFFE
    // The holder has every other processor stand still for a while
    // (holdOthers): a processor that waits for it says that it does.
    pub const HOLDING: usize = 0x7FFFFFFD
    // Seconds a window of the recent figure lasts.
    pub const WINDOW: usize = 10

    total: usize
    idle: usize
    longest: usize
    longestFor: usize
    // The longest of the window that runs and of the one before it, and
    // when (the counter) the running one began.
    now: usize
    nowFor: usize
    before: usize
    beforeFor: usize
    began: usize

    // A new window when the running one is over (`counter`: now).
    fn turn(self: *Self, counter: usize) -> void {
        const window = WINDOW * clock.system().rate()
        if counter - self.*.began < window { return }
        // (Nothing for longer than two windows: the one before is over
        // as well.)
        const old = counter - self.*.began >= 2 * window
        self.*.before = if old { 0 } else { self.*.now }
        self.*.beforeFor = if old { 0 } else { self.*.nowFor }
        self.*.now = 0
        self.*.nowFor = 0
        self.*.began = counter
    }

    // The longest wait of the last one to two windows and its holder.
    pub fn recent(self: *Self) -> (usize, usize) {
        self.turn(cpu.Cpu.timestamp())
        if self.*.before > self.*.now { return -> (self.*.before, self.*.beforeFor) }
        return -> (self.*.now, self.*.nowFor)
    }
}

var waits: Waits = undefined // (per run)

pub fn waited() -> *Waits { return &waits }

// Whether a process may be waiting for a processor (ready, or blocked on
// something that may have come), and the soonest deadline a blocked one
// waits with (0: none): what a processor whose time slice ended reads
// without the kernel's lock (trap.mlx), so that it goes on with its
// process when nothing else could run, and what one that waits for the
// kernel for such a tick looks at to give up the wait (lockForTick).
// Worked out by the scheduler (noteChange, noteNothing) where a time
// slice ended, where a processor found nothing to run, and after every
// other entry of the kernel while it says nothing waits (a call or an
// interrupt is what makes a process ready, or sets a deadline): it is
// never "nothing" while something waits. A deadline is no event: until
// it comes the hint holds, then a tick looks.
var mayRun: bool = true
var quietUntil: usize = 0

// Whether a time slice may end without the kernel: nothing waits to run
// and no wait's deadline has come.
pub fn quietTick() -> bool {
    if @atomicLoad(bool, &mayRun, acquire) { return false }
    const until = @atomicLoad(usize, &quietUntil, acquire)
    return until == 0 || clock.system().monotonic() < until
}

// A process waits to run (until a time slice's end finds otherwise).
pub fn noteChange() -> void { @atomicStore(bool, &mayRun, true, release) }

// Whether the hint says a process may wait to run.
pub fn mayRunHint() -> bool { return @atomicLoad(bool, &mayRun, acquire) }

// What can run, as it is now: nothing more than runs until the soonest
// deadline `until` (0: none).
pub fn noteNothing(until: usize) -> void {
    @atomicStore(usize, &quietUntil, until, release)
    @atomicStore(bool, &mayRun, false, release)
}

// The kernel taken by processor `id` (waited for when another has it).
pub fn lock(id: usize) -> void { _ = take(id, false) }

// The kernel taken by processor `id` for the end of its time slice (from
// user mode); false, without it, when while it waits the scheduler finds
// that nothing waits to run (quietTick): the process goes on. One call
// that might have made a process ready sends every busy processor's next
// tick here; the first that has the kernel finds out, and the others
// leave the queue instead of each taking the kernel to be told the same.
pub fn lockForTick(id: usize) -> bool { return take(id, true) }

fn take(id: usize, tick: bool) -> bool {
    // (Its own number is there only while it holds the lock: a second
    // entry.)
    if @atomicLoad(usize, &kernel.owner, monotonic) == id + 1 {
        lockDepth += 1
        return true
    }
    // While it waits: since when, and under which word of the holder's
    // work the longest stretch of the wait went by (the counter is read
    // when the word changes, not at every look).
    var since: usize = 0
    var word: usize = 0
    var wordSince: usize = 0
    var stretch: usize = 0
    var holder: usize = 0
    while true {
        if @atomicLoad(usize, &kernel.owner, monotonic) == 0 {
            const taken = @cmpxchgWeak(usize, &kernel.owner, 0, id + 1, acquire, monotonic)
            if taken.0 { break }
        }
        const seen = @atomicLoad(usize, &kernel.work, monotonic)
        // (The kernel will not be free again: the system ends.)
        if seen == Waits.ENDING { stopHere() }
        // (The holder wants every other processor still: this one is,
        // while it waits here; it says so once for each such time.)
        if seen == Waits.HOLDING { heldWaiting(id) }
        // (A time slice's end that need not be told after all.)
        if tick && quietTick() { return false }
        if since == 0 {
            since = cpu.Cpu.timestamp()
            wordSince = since
            word = seen
        } else if seen != word {
            const counter = cpu.Cpu.timestamp()
            if counter - wordSince > stretch {
                stretch = counter - wordSince
                holder = word
            }
            word = seen
            wordSince = counter
        }
        cpu.Cpu.relax()
    }
    lockDepth = 1
    current = id
    if since != 0 {
        const counter = cpu.Cpu.timestamp()
        if counter - wordSince > stretch { holder = word }
        noteWait(id, counter - since, holder, counter)
    }
    return true
}

// A wait of processor `id` for the kernel that took `took`, mostly behind
// `holder`. (Not the waits of the start, before the first trap said what
// the holder is at: the other processors wait for the first one's setup.)
fn noteWait(id: usize, took: usize, holder: usize, counter: usize) -> void {
    if holder == 0 { return }
    if halted.at(id).* {
        waits.idle += took
        return
    }
    waits.total += took
    if took > waits.longest {
        waits.longest = took
        waits.longestFor = holder
    }
    waits.turn(counter)
    if took > waits.now {
        waits.now = took
        waits.nowFor = holder
    }
}

pub fn unlock() -> void {
    lockDepth -= 1
    if lockDepth == 0 { @atomicStore(usize, &kernel.owner, 0, release) }
}

fn physical(address: usize) -> [*]u8 { return Bytes.pointer(layout.Memory.virtual(address)) }

fn same(bytes: [*]const u8, text: []const u8) -> bool {
    var k: usize = 0
    while k < text.length {
        if bytes[k] != text[k] { return false }
        k += 1
    }
    return true
}

// How many processors may run the kernel: /system/settings/processors
// (a number; 1: only the first) when the image has it, else all the
// kernel has room for. The way to start a machine on one processor when
// the others are in doubt.
fn allowed() -> usize {
    const tree = vfs.fileSystem()
    const file = tree.resolve(vfs.Vfs.ROOT, "/system/settings/processors\x00".pointer)
    if file < 0 { return MAX_CPUS }
    var text: [16]u8 = undefined
    const length = tree.read(@bitCast(usize, file), 0, &text, 16)
    var value: usize = 0
    var k: usize = 0
    while k < length && text[k] >= 48 && text[k] <= 57 {
        value = value * 10 + @intCast(usize, text[k] - 48)
        k += 1
    }
    if k == 0 || value == 0 { return MAX_CPUS }
    return if value > MAX_CPUS { MAX_CPUS } else { value }
}

fn reg(offset: usize) -> *u32 { return unsafe { @ptrFromInt(*u32, layout.Memory.virtual(LAPIC) + offset) } }

// A register of this processor's local APIC read and written, by the way
// it is reached.
fn get(offset: usize) -> u32 {
    if found.x2 { return @intCast(u32, cpu.Msr.read(X2_BASE + (offset >> 4)) & 0xFFFFFFFF) }
    return reg(offset).*
}

fn put(offset: usize, value: u32) -> void {
    if found.x2 {
        cpu.Msr.write(X2_BASE + (offset >> 4), @intCast(usize, value))
        return
    }
    reg(offset).* = value
}

// This processor's local APIC's id (all 32 bits of the register in x2APIC
// mode, its top eight otherwise).
fn ownId() -> usize {
    const value = @intCast(usize, get(ID))
    return if found.x2 { value } else { value >> 24 }
}

// The local APIC's page in the kernel's view, uncached; false when
// memory is out.
fn mapApic() -> bool {
    if found.mapped { return true }
    if memory.Device.map(LAPIC, memory.Page.SIZE, memory.Device.UNCACHED) == 0 { return false }
    found.mapped = true
    return true
}

// The first processor's local APIC looked at, once: which way it is
// reached, whether it answers there, and on (its spurious vector set).
// False when it is off, not where the kernel looks, or silent.
fn ready() -> bool {
    if found.looked { return found.usable }
    found.looked = true
    found.usable = false
    const base = cpu.Msr.read(cpu.Msr.APIC_BASE)
    if base & APIC_ON == 0 { return false }
    found.x2 = base & APIC_X2 != 0
    if !found.x2 {
        if base & 0xFFFFFF000 != LAPIC { return false }
        if !mapApic() { return false }
    }
    const version = @intCast(usize, get(VERSION))
    if version == 0 || version == 0xFFFFFFFF { return false }
    put(SPURIOUS, 0x100 | @intCast(u32, layout.Vector.SPURIOUS))
    found.usable = true
    return true
}

// This processor's local APIC in the mode the first one's is in (a
// firmware sets them all alike; one that did not would leave a processor
// whose timer and IPIs go nowhere). From x2APIC back to its registers in
// memory only by way of off.
fn adopt() -> void {
    const base = cpu.Msr.read(cpu.Msr.APIC_BASE)
    if found.x2 && base & APIC_X2 == 0 {
        if base & APIC_ON == 0 { cpu.Msr.write(cpu.Msr.APIC_BASE, base | APIC_ON) }
        cpu.Msr.write(cpu.Msr.APIC_BASE, base | APIC_ON | APIC_X2)
    } else if !found.x2 && base & APIC_X2 != 0 {
        cpu.Msr.write(cpu.Msr.APIC_BASE, base & ~(APIC_ON | APIC_X2))
        cpu.Msr.write(cpu.Msr.APIC_BASE, (base & ~APIC_X2) | APIC_ON)
    }
}

fn wait(nanoseconds: usize) -> void {
    const until = clock.system().monotonic() + nanoseconds
    while clock.system().monotonic() < until {}
}

// An IPI to the processor whose local APIC's id is `apic`. In memory: the
// id's eight bits, then the command, waited for until it is delivered; in
// x2APIC mode one register takes both (all 32 bits of the id) and there
// is nothing to wait for.
fn send(apic: usize, command: u32) -> void {
    if found.x2 {
        cpu.Msr.write(X2_BASE + (ICR_LOW >> 4), (apic << 32) | @intCast(usize, command))
        return
    }
    reg(ICR_HIGH).* = @intCast(u32, apic << 24)
    reg(ICR_LOW).* = command
    var tries: usize = 0
    while reg(ICR_LOW).* & DELIVERY_PENDING != 0 && tries < 1000000 { tries += 1 }
}

// The local APIC's timer ticks in 10 ms, measured on this processor
// (the timer counts the bus clock, the same on every one).
fn measureTimer() -> void {
    put(SPURIOUS, 0x100 | @intCast(u32, layout.Vector.SPURIOUS))
    put(TIMER_DIVIDE, 0xB)
    put(LVT_TIMER, TIMER_MASKED | @intCast(u32, layout.Vector.LAPIC_TIMER))
    put(TIMER_INITIAL, 0xFFFFFFFF)
    wait(10000000)
    const left = @intCast(usize, get(TIMER_CURRENT))
    put(TIMER_INITIAL, 0)
    found.timerTicks = 0xFFFFFFFF - left
}

// This processor's local APIC timer: an interrupt (Vector.LAPIC_TIMER)
// every 10 ms, its time slice.
pub fn startTimer() -> void {
    if found.timerTicks == 0 { return }
    put(SPURIOUS, 0x100 | @intCast(u32, layout.Vector.SPURIOUS))
    put(TIMER_DIVIDE, 0xB)
    put(LVT_TIMER, TIMER_PERIODIC | @intCast(u32, layout.Vector.LAPIC_TIMER))
    put(TIMER_INITIAL, @intCast(u32, found.timerTicks))
}

// The end of a local APIC interrupt (its timer's, a device's message).
pub fn endOfInterrupt() -> void { put(EOI, 0) }

// Whether an interrupt of `vector` has come to this processor's local
// APIC and waits to be taken (the kernel runs with interrupts off while
// it starts: a device's message waits here until they are on).
pub fn waiting(vector: usize) -> bool {
    if !ready() { return false }
    return get(IRR + (vector / 32) * 0x10) & (@intCast(u32, 1) << @intCast(u5, vector % 32)) != 0
}

// A time slice, in the clock's nanoseconds (what timerTicks counts).
const SLICE: usize = 10000000
// The shortest wait a timer is set for (what setting it takes).
const SHORTEST: usize = 20000

// The processor whose timer is set for a wait's deadline (+ 1; 0: none),
// and that deadline: one processor wakes for it, not every idle one (seven
// that wake for one process's frame only queue for the kernel to find it
// taken).
var waker: usize = 0 // (per run)
// Each processor: a fire of its timer set for a deadline is still to be
// taken (disarm).
var stale: PerProcessor(bool) = undefined // (per run)
var wakerDeadline: usize = 0 // (per run)

// How `arm` left this processor's timer: as it was, set to fire once for
// a deadline, or stopped while it idles.
pub const Armed = struct {
    pub const NOT: usize = 0
    pub const ONCE: usize = 1
    pub const QUIET: usize = 2
}

// This processor, about to halt with nothing to run, woken at `deadline`
// (the clock's nanoseconds; 0: none): its local APIC's timer set for the
// time until then when that is sooner than a time slice, and no other
// processor's is set for as soon. A process that waits with a deadline (a
// frame's, a sleep's) is found by a processor looking for work, and an
// idle one looks when an interrupt wakes it: the tick alone made every
// such wait a hundredth of a second coarse (thirty frames a second came
// out as 30, 30, 40 ms at best, with one processor as 25 a second).
// The first processor's time slices are the PIT's, its local APIC's timer
// is free for this; another's counts its slices, and is set to fire once
// for the deadline instead. Another processor's timer is stopped while it
// idles with no deadline of its own to wake for (Armed.QUIET): an idle
// processor is woken by an IPI when there is work, and a deadline further
// than a slice away is the first processor's to find (its tick, the PIT,
// looks at every one), so 63 idle processors do not wake a hundred times
// a second each to queue for the kernel and find nothing. How the timer
// was left (Armed): `disarm` after the halt puts it back.
pub fn arm(deadline: usize) -> usize {
    if !found.usable || found.timerTicks == 0 { return Armed.NOT }
    if deadline == 0 { return quiet() }
    const now = clock.system().monotonic()
    if covered(deadline, now) { return quiet() }
    var left: usize = if deadline > now { deadline - now } else { 0 }
    if left >= SLICE { return quiet() }
    if left < SHORTEST { left = SHORTEST }
    const ticks = left * found.timerTicks / SLICE
    if current == 0 { put(TIMER_DIVIDE, 0xB) }
    // (Once, not again and again: a timer left periodic with this short
    // a period fired anew while its first interrupt still waited for the
    // kernel, trap after trap.)
    put(LVT_TIMER, @intCast(u32, layout.Vector.LAPIC_TIMER))
    put(TIMER_INITIAL, @intCast(u32, if ticks == 0 { 1 } else { ticks }))
    waker = current + 1
    wakerDeadline = deadline
    return Armed.ONCE
}

// This processor's time slices stopped while it idles (not the first's:
// its timer counts no slices).
fn quiet() -> usize {
    if current == 0 { return Armed.NOT }
    put(TIMER_INITIAL, 0)
    return Armed.QUIET
}

// Whether another processor's timer is set for a time no later than
// `deadline` and still to come (`now`: the clock): then that one wakes
// and looks, this one need not. (One whose time has passed has woken, or
// went on with a process without its timer: it counts no more.)
fn covered(deadline: usize, now: usize) -> bool {
    return waker != 0 && waker != current + 1 && wakerDeadline <= deadline && wakerDeadline + SLICE > now
}

// After the halt: the deadline is this processor's no more (it looks now,
// and arms again when it halts again), and where `arm` set or stopped
// the timer (`armed`) the first processor's is off again, another's back
// to its slices.
pub fn disarm(armed: usize) -> void {
    if armed != Armed.NOT {
        if current != 0 {
            put(LVT_TIMER, TIMER_PERIODIC | @intCast(u32, layout.Vector.LAPIC_TIMER))
            put(TIMER_INITIAL, @intCast(u32, found.timerTicks))
        } else {
            put(TIMER_INITIAL, 0)
        }
        // A fire that came after the processor woke (by something else,
        // or while it waited for the kernel) is still to be taken: it is
        // no time slice's end (staleTick).
        const vector = layout.Vector.LAPIC_TIMER
        if armed == Armed.ONCE && get(IRR + (vector / 32) * 0x10) & (@intCast(u32, 1) << @intCast(u5, vector % 32)) != 0 { stale.at(current).* = true }
    }
    if waker == current + 1 { waker = 0 }
}

// Processor `id`'s time slice ended while nothing waits to run (trap.mlx,
// without the kernel's lock): its local APIC told the interrupt is over,
// and a fire left over from a deadline's timer taken (it was this one or
// came before: either way no slice's end is owed).
pub fn tickAlone(id: usize) -> void {
    stale.at(id).* = false
    endOfInterrupt()
}

// Whether this processor's timer interrupt, taken now, is one left over
// from a timer set for a deadline (asked once: it is taken note of).
pub fn staleTick() -> bool {
    const was = stale.at(current).*
    stale.at(current).* = false
    return was
}

// This processor goes on with a process while a wait's `deadline` (0:
// none) is less than a time slice away and no processor's timer is set
// for it (this one's was, or the wait is new): an idle one is woken, which
// sets its own on its way back to the halt.
pub fn cover(deadline: usize) -> void {
    if deadline == 0 || !found.usable || found.timerTicks == 0 { return }
    if waker == current + 1 { waker = 0 }
    const now = clock.system().monotonic()
    if covered(deadline, now) || deadline >= now + SLICE { return }
    const other = idleProcessor()
    if other.0 { wake(other.1) }
}

// Whether the devices may raise their interrupts as messages:
// /system/settings/interrupts saying "polled" keeps them looked at on the
// timer tick alone (the way to start a machine whose messages are in
// doubt: they are new on every board).
fn messagesAllowed() -> bool {
    const tree = vfs.fileSystem()
    const file = tree.resolve(vfs.Vfs.ROOT, "/system/settings/interrupts\x00".pointer)
    if file < 0 { return true }
    var text: [8]u8 = undefined
    const length = tree.read(@bitCast(usize, file), 0, &text, 8)
    return !(length >= 6 && same(&text, "polled"))
}

// This processor's local APIC made ready to take a device's interrupt (a
// message-signalled one: Pci.enableMsi, Pci.enableMsix): on (its
// spurious vector set) and answering; whether it is, and its id for the
// message's address. Also on a machine where one processor runs (the
// others' start does as much on the way). A message's address has eight
// bits for the id: a processor whose id does not fit takes none. None
// either when the settings say the devices are to be polled.
pub fn localApic() -> (bool, usize) {
    if !messagesAllowed() { return -> (false, 0) }
    if !ready() { return -> (false, 0) }
    const id = ownId()
    if id >= 255 { return -> (false, 0) }
    return -> (true, id)
}

// The first processor's arena (from the region's start: the boot runs in
// it before `start`), another's as `start` made it.
fn arenaBase(k: usize) -> usize {
    if k == 0 { return layout.Memory.KERNEL_VIRTUAL + layout.Memory.ARENA }
    return arenas.at(k).*
}

// Processor `k`'s (1 to `others`) trap stack, block and TSS (a page above
// the stack) and arena: its share of the region when it is among the
// first `inRegion`, else of the frames' memory. False when memory is out.
fn prepare(k: usize, others: usize, inRegion: usize) -> bool {
    const stack = memory.allFrames().allocateContiguous(STACK_PAGES + 1)
    if stack == 0 { return false }
    const share = layout.Memory.arenaShare(others)
    var arena: usize = 0
    if k <= inRegion {
        arena = layout.Memory.virtual(layout.Memory.arenaOf(k, others))
    } else {
        const frames = memory.allFrames().allocateContiguous(share / memory.Page.SIZE)
        if frames == 0 { return false }
        arena = layout.Memory.virtual(frames)
    }
    const top = layout.Memory.virtual(stack + STACK_PAGES * memory.Page.SIZE)
    const block = Bytes.pointer(top)
    Bytes.write64(block, layout.PerCpu.TRAP_STACK, top)
    Bytes.write64(block, layout.PerCpu.USER_RSP, 0)
    Bytes.write64(block, layout.PerCpu.ARENA_BASE, arena)
    Bytes.write64(block, layout.PerCpu.ARENA_END, arena + share)
    Bytes.write64(block, layout.PerCpu.INDEX, k)
    // Its TSS: rsp0, the trap stack (interrupts from user mode); no I/O
    // map.
    Bytes.write64(block, layout.PerCpu.TSS_AT + 4, top)
    Bytes.write16(block, layout.PerCpu.TSS_AT + 102, 104)
    blocks.at(k).* = top
    arenas.at(k).* = arena
    // Its arena's bump-pointer word (the arena's first, as _start sets
    // the first processor's).
    resetArena(k)
    return true
}

// The GDT of the processors that run the kernel (`count`, the first among
// them): the blob's segments and the first processor's TSS, then a TSS
// descriptor for each other one (selector Selector.TSS + 16 * its
// number), in pages of its own; the blob's GDTR64, which the others load
// on their way in, points at it (the first processor keeps the blob's,
// which it loaded). False when memory is out.
fn makeGdt(count: usize) -> bool {
    const bytes = layout.Selector.TSS + 16 * count
    const table = memory.allFrames().allocateContiguous((bytes + memory.Page.SIZE - 1) / memory.Page.SIZE)
    if table == 0 { return false }
    const gdt = Bytes.pointer(layout.Memory.virtual(table))
    Bytes.copy(gdt, Bytes.pointer(layout.Blob.virtual(layout.Blob.GDT)), layout.Selector.TSS + 16)
    var k: usize = 1
    while k < count {
        const tss = blocks.at(k).* + layout.PerCpu.TSS_AT
        const low = 103 | ((tss & 0xffff) << 16) | (((tss >> 16) & 0xff) << 32) | (0x89 << 40) | (((tss >> 24) & 0xff) << 56)
        Bytes.write64(gdt, layout.Selector.TSS + 16 * k, low)
        Bytes.write64(gdt, layout.Selector.TSS + 16 * k + 8, tss >> 32)
        k += 1
    }
    const gdtr = Bytes.pointer(layout.Blob.virtual(layout.Blob.GDTR64))
    Bytes.write16(gdtr, 0, bytes - 1)
    Bytes.write64(gdtr, 2, layout.Memory.virtual(table))
    return true
}

// The trampoline's words (layout.Ap) in the kernel's view.
fn trampoline32(offset: usize) -> *u32 { return unsafe { @ptrFromInt(*u32, layout.Memory.virtual(layout.Ap.START + offset)) } }

fn trampoline64(offset: usize) -> *usize { return unsafe { @ptrFromInt(*usize, layout.Memory.virtual(layout.Ap.START + offset)) } }

// The processors found, the others started (INIT, two startup IPIs) and
// waited for; they come into the kernel (brix_ap) once the first
// processor lets go of it. As many as the MADT lists to start, fewer
// where /system/settings/processors says so or memory runs out.
pub fn start() -> void {
    idle.clear()
    woken.clear()
    waking = 0
    halted.fill(false)
    stale.fill(false)
    waits = Waits.{ .total = 0, .idle = 0, .longest = 0, .longestFor = 0, .now = 0, .nowFor = 0, .before = 0, .beforeFor = 0, .began = cpu.Cpu.timestamp() }
    apic.fill(0)
    blocks.fill(0)
    arenas.fill(0)
    blocks.at(0).* = layout.Blob.firstPerCpu()
    arenas.at(0).* = arenaBase(0)
    found.listed.clear()
    found.count = 1
    found.started = 0
    found.running = 1
    found.timerTicks = 0
    const out = console.out
    // The local APIC's timer measured where there is one, also on a
    // machine where one processor runs: waits with a deadline are woken
    // by it (arm).
    if ready() { measureTimer() }
    const root = acpi.root()
    if root == 0 {
        out.write("brixOS: no ACPI tables found (one processor runs)\n")
        return
    }
    const madt = acpi.table(root, "APIC", 0)
    if madt == 0 {
        out.write("brixOS: the ACPI tables name no processors (one runs)\n")
        return
    }
    // How the local APICs are reached decides which processors can be
    // (an id of 255 or more in x2APIC mode only), so it is looked at
    // first.
    const answering = ready()
    const table = Bytes.pointer(madt)
    processors_module.read(table, found.x2, &found.listed)
    sayListed()
    found.count = found.listed.count
    if found.count < 2 {
        if found.count == 0 { found.count = 1 }
        return
    }
    const limit = allowed()
    if limit < 2 {
        out.write("brixOS: smp: ")
        out.decimal(found.count)
        out.write(" processors listed, 1 running (/system/settings/processors lets one run)\n")
        return
    }
    // The local APICs on, where the kernel looks for them (in memory, or
    // as model-specific registers), and answering there.
    const base = cpu.Msr.read(cpu.Msr.APIC_BASE)
    if base & APIC_ON == 0 {
        out.write("brixOS: the local APIC is off (one processor runs)\n")
        return
    }
    if !found.x2 && (Bytes.read32(table, 36) != LAPIC || base & 0xFFFFFF000 != LAPIC) {
        out.write("brixOS: the local APICs are at ")
        out.hex(base & 0xFFFFFF000)
        out.write(", not where the kernel looks (one processor runs)\n")
        return
    }
    if !answering {
        out.write("brixOS: the local APIC does not answer (one processor runs)\n")
        return
    }
    if found.x2 { out.write("brixOS: the local APICs are in x2APIC mode\n") }
    if found.timerTicks == 0 {
        out.write("brixOS: the local APIC's timer does not count (one processor runs)\n")
        return
    }
    // The others: every listed one but this one, as many as the settings
    // let run.
    const own = ownId()
    apic.at(0).* = own
    var others = if found.listed.has(own) { found.count - 1 } else { found.count }
    if others > limit - 1 { others = limit - 1 }
    // Their trap stacks, blocks, TSSs and arenas, and the GDT; as many as
    // memory holds.
    const inRegion = layout.Memory.arenasInRegion(others)
    var made: usize = 0
    while made < others && prepare(made + 1, others, inRegion) { made += 1 }
    if made < others {
        out.write("brixOS: smp: memory for ")
        out.decimal(made)
        out.write(" more processors only\n")
    }
    if made == 0 || !makeGdt(made + 1) {
        out.write("brixOS: smp: ")
        out.decimal(found.count)
        out.write(" processors listed, 1 running (no memory for the others)\n")
        return
    }
    // The trampoline where the startup IPI's vector names it: its code,
    // the count (0, open), how many may come, and each one's block.
    Bytes.copy(physical(layout.Ap.START), physical(layout.Memory.BLOB + layout.Blob.AP), layout.Ap.SIZE)
    trampoline32(layout.Ap.ROOM).* = @intCast(u32, made)
    var k: usize = 1
    while k <= made {
        trampoline64(layout.Ap.BLOCKS + 8 * k).* = blocks.at(k).*
        trampoline32(layout.Ap.IDS + 4 * k).* = 0xFFFFFFFF
        k += 1
    }
    const counter = trampoline32(layout.Ap.STARTED)
    @atomicStore(u32, counter, 0, seq_cst)
    // INIT to each of them, then (after the 10 ms the processors take to
    // be ready) the startup IPI twice (vector: the page).
    sendEach(own, made, 0x4500)
    wait(10000000)
    sendEach(own, made, 0x4600 | @intCast(u32, layout.Ap.START >> 12))
    wait(200000)
    sendEach(own, made, 0x4600 | @intCast(u32, layout.Ap.START >> 12))
    // Each one has START_WAIT from its startup IPIs to reach long mode
    // (they were sent together: the last one's time is everyone's); then
    // the count is closed, and one that comes later halts where it is.
    const until = clock.system().monotonic() + START_WAIT
    while @intCast(usize, @atomicLoad(u32, counter, acquire)) < made && clock.system().monotonic() < until { cpu.Cpu.relax() }
    const closed = @intCast(usize, @atomicRmw(u32, counter, or, @intCast(u32, layout.Ap.CLOSED), seq_cst)) & ~layout.Ap.CLOSED
    found.started = if closed < made { closed } else { made }
    found.running = 1 + found.started
    // Each counted one's id (it writes it right after it counted itself:
    // a moment for one counted just before the close).
    const idsUntil = clock.system().monotonic() + 10000000
    k = 1
    while k <= found.started {
        while @atomicLoad(u32, trampoline32(layout.Ap.IDS + 4 * k), acquire) == 0xFFFFFFFF && clock.system().monotonic() < idsUntil { cpu.Cpu.relax() }
        apic.at(k).* = @intCast(usize, @atomicLoad(u32, trampoline32(layout.Ap.IDS + 4 * k), acquire))
        k += 1
    }
    out.write("brixOS: smp: ")
    out.decimal(found.count)
    out.write(" processors listed, ")
    out.decimal(found.running)
    out.write(" running\n")
    sayMissing(own, made)
}

// A command to the first `count` listed processors that are not this one
// (`own`: its local APIC id).
fn sendEach(own: usize, count: usize, command: u32) -> void {
    var sent: usize = 0
    var k: usize = 0
    while k < found.listed.count && sent < count {
        const id = @intCast(usize, found.listed.ids[k])
        if id != own {
            send(id, command)
            sent += 1
        }
        k += 1
    }
}

// Whether processor `id` (its local APIC id) reached long mode (said its
// id in the trampoline).
fn came(id: usize) -> bool {
    var k: usize = 1
    while k <= found.started {
        if apic.at(k).* == id { return true }
        k += 1
    }
    return false
}

// The processors that were started and did not come up, by their local
// APIC ids (MISSING_SAID of them, then how many more).
fn sayMissing(own: usize, count: usize) -> void {
    const out = console.out
    var sent: usize = 0
    var missing: usize = 0
    var k: usize = 0
    while k < found.listed.count && sent < count {
        const id = @intCast(usize, found.listed.ids[k])
        if id != own {
            sent += 1
            if !came(id) {
                if missing < MISSING_SAID {
                    out.write("brixOS: smp: the processor of local APIC id ")
                    out.decimal(id)
                    out.write(" did not come up (left)\n")
                }
                missing += 1
            }
        }
        k += 1
    }
    if missing > MISSING_SAID {
        out.write("brixOS: smp: and ")
        out.decimal(missing - MISSING_SAID)
        out.write(" more did not come up\n")
    }
}

// What the MADT lists besides the processors to start: those off (and of
// them the ones the firmware may bring on while the system runs: brixOS
// does not, as Linux leaves them possible), those reached in x2APIC mode
// only, those past the most the kernel runs.
fn sayListed() -> void {
    const out = console.out
    const listed = &found.listed
    if listed.*.disabled != 0 {
        out.write("brixOS: smp: ")
        out.decimal(listed.*.disabled)
        out.write(" more listed as off (not started; ")
        out.decimal(listed.*.capable)
        out.write(" of them the firmware may bring on later)\n")
    }
    if listed.*.beyond != 0 {
        out.write("brixOS: smp: ")
        out.decimal(listed.*.beyond)
        out.write(" processors are reached by x2APIC only (left alone)\n")
    }
    if listed.*.over != 0 {
        out.write("brixOS: smp: ")
        out.decimal(listed.*.over)
        out.write(" processors past the ")
        out.decimal(MAX_CPUS)
        out.write(" the kernel runs (left alone)\n")
    }
}

// Processor `k`'s arena emptied: its bump-pointer word (the arena's
// first) at the start again. For a kernel path that does not return to
// its callers (brix_ap entering user mode), whose allocations would
// stay.
pub fn resetArena(k: usize) -> void {
    const base = arenaBase(k)
    Bytes.write64(Bytes.pointer(base), 0, base + 8)
}

// The processor's arena (mlx4's aggregate arena, loaded into r14 and r15
// at each entry to the kernel; its bump word is the arena's first word):
// where it stands, and back to there (what was made since is let go).
// The idle loop never leaves the kernel, so it releases each round's.
pub fn arenaMark() -> usize {
    return Bytes.read64(Bytes.pointer(arenaBase(currentCpu())), 0)
}

pub fn arenaRelease(mark: usize) -> void {
    Bytes.write64(Bytes.pointer(arenaBase(currentCpu())), 0, mark)
}

// Processor `id` runs the kernel from now on (its first entry).
pub fn joined(id: usize) -> void {
    if id + 1 > found.running { found.running = id + 1 }
    adopt()
    apic.at(id).* = ownId()
}

// Processor `id` idles from now on (`resting`), or no more: one that was
// woken has looked for work (`waking` counts one fewer).
pub fn rest(id: usize, resting: bool) -> void {
    if resting {
        idle.set(id)
        return
    }
    idle.unset(id)
    if woken.has(id) {
        woken.unset(id)
        waking -= 1
    }
}

// An idle processor other than this one: whether there is one, and
// which (the lowest; a word of the set at a time).
pub fn idleProcessor() -> (bool, usize) { return idle.firstBut(current) }

// How many processors were woken and have not looked for work yet: a
// process that can run has one of them coming already.
pub fn wakingCount() -> usize { return waking }

// Processor `id` woken (an IPI to its local APIC; it looks for a
// process to run). It counts as awake from now on, and as coming for a
// process until it has looked (`rest`).
pub fn wake(id: usize) -> void {
    if !found.usable { return }
    idle.unset(id)
    if !woken.has(id) {
        woken.set(id)
        waking += 1
    }
    send(apic.at(id).*, 0x4000 | @intCast(u32, layout.Vector.WAKE))
}

// How many processors stopped at the system's end (stopHere).
var stopped: usize = 0 // (per run)

// This processor stopped for good, at the system's end: counted, then
// halted with interrupts off. It asks for nothing of the kernel (whose
// holder is the processor that ends the system) and does not come back.
pub fn stopHere() -> void {
    _ = @atomicRmw(usize, &stopped, add, 1, monotonic)
    cpu.Cpu.stop()
    while true {}
}

// The system ends, on this processor, which keeps the kernel from now
// on: every other one that runs the kernel is stopped. One in a program
// or in its idle halt takes the IPI (Vector.STOP; trap.mlx brings it to
// stopHere before it asks for the kernel); one that waits for the kernel
// with its interrupts off sees what the holder is at (Waits.ENDING).
// Waited for up to a fifth of a second; how many did not say they
// stopped (none, on a machine that is well).
pub fn stopOthers() -> usize {
    at(Waits.ENDING)
    const others = found.running - 1
    if others == 0 { return 0 }
    if found.usable {
        var k: usize = 0
        while k < found.running {
            if k != current { send(apic.at(k).*, 0x4000 | @intCast(u32, layout.Vector.STOP)) }
            k += 1
        }
    }
    const until = clock.system().monotonic() + 200000000
    while @atomicLoad(usize, &stopped, monotonic) < others && clock.system().monotonic() < until { cpu.Cpu.relax() }
    const now = @atomicLoad(usize, &stopped, monotonic)
    return if now < others { others - now } else { 0 }
}

// ---- Every other processor held where it is for a while, and let go
// again: for a display's mode set while the system runs (gpu.mlx). The
// kernel itself runs on one processor at a time anyway (`lock`); what is
// held beside is the programs on the other processors, which would go on
// drawing and calling while the card is half set.
//
// The processor that holds the kernel asks (`holdOthers`): every other
// one that runs the kernel is sent an IPI (Vector.HOLD; trap.mlx brings
// it to `holdHere` before it asks for the kernel), and stays there, its
// interrupts off, until the holder lets go (`releaseOthers`). One that
// waits for the kernel at that moment, its interrupts off, stands still
// already and says so when it sees what the holder is at
// (Waits.HOLDING); the IPI reaches it later, when the hold is over, and
// does nothing then. A stop that ends again, and one with a bound: a held
// processor goes on by itself after HOLD_MOST, whatever became of the
// holder.

// The hold that is on (counted from 1; 0: none), how many processors
// said they stand still for it, and what the holder's work word was
// before.
var holdOn: usize = 0
var holdCount: usize = 0
var holdSaid: usize = 0
var holdWork: usize = 0
// Each processor: the last hold it said it stands still for.
var holdSeen: PerProcessor(usize) = undefined // (per run)
// Whether holds are taken yet (`armHold`, once the processors are
// found).
var holdArmed = false

// The longest a processor is held, in seconds: more than the longest a
// mode set and its way back can take (gpu_set.mlx bounds each at 22 s on
// the card it was built on).
pub const HOLD_MOST: usize = 60

// From now on `holdOthers` holds (called once `start` has run: before
// that no other processor runs anything).
pub fn armHold() -> void {
    holdSeen.fill(0)
    holdArmed = true
}

// Every other processor that runs the kernel held where it is, from now
// until `releaseOthers`. Waited for a fifth of a second at most; how many
// did not say that they stand still (none, on a machine that is well).
// For the processor that holds the kernel.
pub fn holdOthers() -> usize {
    if !holdArmed { return 0 }
    holdWork = @atomicLoad(usize, &kernel.work, monotonic)
    holdCount += 1
    @atomicStore(usize, &holdSaid, 0, monotonic)
    @atomicStore(usize, &holdOn, holdCount, monotonic)
    at(Waits.HOLDING)
    const others = found.running - 1
    if others == 0 { return 0 }
    if found.usable {
        var k: usize = 0
        while k < found.running {
            if k != current { send(apic.at(k).*, 0x4000 | @intCast(u32, layout.Vector.HOLD)) }
            k += 1
        }
    }
    const until = clock.system().monotonic() + 200000000
    while @atomicLoad(usize, &holdSaid, monotonic) < others && clock.system().monotonic() < until { cpu.Cpu.relax() }
    const now = @atomicLoad(usize, &holdSaid, monotonic)
    return if now < others { others - now } else { 0 }
}

// The held processors go on.
pub fn releaseOthers() -> void {
    if !holdArmed { return }
    @atomicStore(usize, &holdOn, 0, monotonic)
    at(holdWork)
}

// This processor says, once, that it stands still for the hold that is
// on.
fn heldSay(id: usize, number: usize) -> void {
    if holdSeen.at(id).* == number { return }
    holdSeen.at(id).* = number
    _ = @atomicRmw(usize, &holdSaid, add, 1, monotonic)
}

// This processor waits for the kernel while its holder has everything
// stand still (`lock`).
fn heldWaiting(id: usize) -> void {
    const number = @atomicLoad(usize, &holdOn, monotonic)
    if number != 0 { heldSay(id, number) }
}

// This processor held (the IPI, taken with its interrupts off, before it
// asks for the kernel): it stays here until the hold is over, or
// HOLD_MOST seconds, and then goes on with what it was at. An IPI that
// comes when no hold is on (the hold ended while this processor waited
// for the kernel) only ends.
pub fn holdHere() -> void {
    const number = @atomicLoad(usize, &holdOn, monotonic)
    if number != 0 {
        heldSay(cpu.Cpu.id(), number)
        const most = HOLD_MOST * clock.system().rate()
        const began = cpu.Cpu.timestamp()
        while @atomicLoad(usize, &holdOn, monotonic) == number && cpu.Cpu.timestamp() - began < most { cpu.Cpu.relax() }
    }
    endOfInterrupt()
}
