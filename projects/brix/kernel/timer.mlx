// Timers (spec/04-stdlib/os/brix.xml, timer_create): a deadline on the
// monotonic clock and a period (0: once). A timer's handle is readable
// once its deadline passed; a read takes how many times it expired since
// the last read and sets the next deadline (none after a timer that
// fires once). A timer lives while handles name it.
const clock = @import("./clock.mlx")

pub const Timer = struct {
    pub const NEVER: usize = 0xFFFFFFFFFFFFFFFF

    // Handles naming it (0: the slot is free).
    opens: usize
    deadline: usize
    period: usize

    pub fn expired(self: *const Self) -> bool { return self.*.deadline != NEVER && clock.system().monotonic() >= self.*.deadline }

    // Whether it will expire again (a deadline is set).
    pub fn armed(self: *const Self) -> bool { return self.*.deadline != NEVER }

    // How many times it expired up to now, taken (0: not yet); the next
    // deadline set from the period.
    pub fn take(self: *Self) -> usize {
        if !self.expired() { return 0 }
        if self.*.period == 0 {
            self.*.deadline = NEVER
            return 1
        }
        const count = (clock.system().monotonic() - self.*.deadline) / self.*.period + 1
        self.*.deadline += count * self.*.period
        return count
    }
}

pub const Timers = struct {
    pub const MAX: usize = 32

    timers: [MAX]Timer

    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.timers[k].opens = 0
            k += 1
        }
    }

    // A new timer (held once); MAX when none is free.
    pub fn create(self: *Self, deadline: usize, period: usize) -> usize {
        var k: usize = 0
        while k < MAX {
            const t = &self.*.timers[k]
            if t.*.opens == 0 {
                t.*.opens = 1
                t.*.deadline = deadline
                t.*.period = period
                return k
            }
            k += 1
        }
        return MAX
    }

    pub fn at(self: *Self, index: usize) -> *Timer { return &self.*.timers[index] }

    pub fn retain(self: *Self, index: usize) -> void { self.*.timers[index].opens += 1 }

    pub fn release(self: *Self, index: usize) -> void { self.*.timers[index].opens -= 1 }
}

var all: Timers = undefined // (per run)

pub fn table() -> *Timers { return &all }
