// The processes and which one runs. A process runs until it waits (a
// system call that blocks), ends, yields, or its time slice is over (the
// timer's interrupt in user mode); then the next one that can go on runs
// (round robin). When none can, the processor halts until an interrupt
// (the timer, the serial line).
const console = @import("./console.mlx")
const cpu = @import("./cpu.mlx")
const clock = @import("./clock.mlx")
const terminal = @import("./terminal.mlx")
const pipe = @import("./pipe.mlx")
const process = @import("./process.mlx")
const wait = @import("./wait.mlx")
const signals_module = @import("./signals.mlx")
const volume = @import("./volume.mlx")
const frame_module = @import("./frame.mlx")
const Frame = frame_module.Frame
const Sse = frame_module.Sse
const Bytes = @import("./bytes.mlx").Bytes
const Process = process.Process
const State = process.State
const WaitKind = wait.WaitKind

pub const Signal = signals_module.Signal

// The wait status of a process that exited with `code`, or was ended by
// `signal`.
pub const Status = struct {
    pub fn exited(code: usize) -> usize { return (code & 255) << 8 }
    pub fn killed(signal: usize) -> usize { return signal & 127 }
}

pub const Scheduler = struct {
    pub const MAX: usize = 16
    // The process brixOS starts (the shell); its end starts it again.
    pub const FIRST_PID: usize = 1

    processes: [MAX]Process
    current: usize
    nextPid: usize
    // The terminal's foreground process group (tcsetpgrp).
    foreground: usize

    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.processes[k].state = State.free
            self.*.processes[k].pid = 0
            k += 1
        }
        self.*.current = 0
        self.*.nextPid = FIRST_PID
        self.*.foreground = FIRST_PID
    }

    pub fn running(self: *Self) -> *Process { return &self.*.processes[self.*.current] }

    // The process `pid`; null when there is none.
    pub fn find(self: *Self, pid: usize) -> ?*Process {
        var k: usize = 0
        while k < MAX {
            const p = &self.*.processes[k]
            if p.*.state != State.free && p.*.pid == pid { return p }
            k += 1
        }
        return null
    }

    // A new process (a child of `parentPid`); null when the table is full.
    pub fn create(self: *Self, parentPid: usize) -> ?*Process {
        var k: usize = 0
        while k < MAX {
            const p = &self.*.processes[k]
            if p.*.state == State.free {
                p.init(self.*.nextPid, parentPid)
                self.*.nextPid += 1
                return p
            }
            k += 1
        }
        return null
    }

    // The first process: `p` runs from now on.
    pub fn makeCurrent(self: *Self, p: *Process) -> void {
        var k: usize = 0
        while k < MAX {
            if &self.*.processes[k] == p { self.*.current = k }
            k += 1
        }
    }

    // fork: a copy of the running process, ready to run; its pid, or 0
    // when there is no room or memory.
    pub fn fork(self: *Self, frame: *const Frame) -> usize {
        const parent = self.running()
        const created = self.create(parent.*.pid)
        if created == null { return 0 }
        const child = created.?
        const forked = child.forkFrom(parent, frame)
        // The parent's pages are read-only now (copy-on-write): the
        // processor forgets the mappings it had.
        parent.*.space.activate()
        if !forked {
            child.*.files.closeAll()
            child.releaseNodes()
            child.*.state = State.free
            return 0
        }
        return child.*.pid
    }

    // `p` ends with the wait status `status`: its memory and descriptors
    // go, its children are nobody's, its parent hears of it (and waits
    // for it), or it is gone at once when it has none.
    pub fn terminate(self: *Self, p: *Process, status: usize) -> void {
        p.*.files.closeAll()
        p.releaseNodes()
        p.releaseMemory()
        p.*.status = status
        p.*.state = State.zombie
        var k: usize = 0
        while k < MAX {
            const child = &self.*.processes[k]
            if child.*.state != State.free && child.*.parentPid == p.*.pid {
                child.*.parentPid = 0
                if child.*.state == State.zombie { child.*.state = State.free }
            }
            k += 1
        }
        if p.*.parentPid != 0 {
            const parent = self.find(p.*.parentPid)
            if parent != null {
                parent.?.*.signals.post(Signal.CHLD, p.*.pid)
                p.*.change = 0
                return
            }
        }
        p.*.state = State.free
    }

    // A child of `p` that ended (a zombie) among those `pid` names (-1
    // and 0: any, below -1: of that group, else that one); null when none
    // did.
    pub fn child(self: *Self, p: *Process, pid: isize) -> ?*Process {
        var k: usize = 0
        while k < MAX {
            const q = &self.*.processes[k]
            if q.*.state != State.free && q.*.parentPid == p.*.pid && matches(q, pid) && q.*.state == State.zombie { return q }
            k += 1
        }
        return null
    }

    // wait4's options for stops and continuations.
    pub const UNTRACED: usize = 2
    pub const CONTINUED: usize = 8

    // A child of `p` among those `pid` names that stopped (UNTRACED) or
    // went on (CONTINUED) since its parent last asked; null when none did.
    pub fn changed(self: *Self, p: *Process, pid: isize, options: usize) -> ?*Process {
        var k: usize = 0
        while k < MAX {
            const q = &self.*.processes[k]
            if q.*.state != State.free && q.*.state != State.zombie && q.*.parentPid == p.*.pid && matches(q, pid) && q.*.change != 0 {
                const stop = q.*.change & 0xFF == 0x7F
                if (stop && options & UNTRACED != 0) || (!stop && options & CONTINUED != 0) { return q }
            }
            k += 1
        }
        return null
    }

    // The running process stops by `number` (its registers in `frame`
    // kept): its parent hears of it; the next process runs.
    pub fn stop(self: *Self, frame: *Frame, number: usize) -> bool {
        const p = self.running()
        p.*.context = frame.*
        Bytes.copy(&p.*.sse, frame.sse(), Sse.SIZE)
        p.*.state = State.stopped
        p.*.change = (number << 8) | 0x7F
        self.tellParent(p)
        return self.switchTo(frame)
    }

    // A stopped `q` goes on where it stopped (SIGCONT).
    fn resume(self: *Self, q: *Process) -> void {
        if q.*.state != State.stopped { return }
        q.*.state = State.ready
        q.*.change = 0xFFFF
        self.tellParent(q)
    }

    // SIGCHLD to the parent of `p`, when it has one.
    fn tellParent(self: *Self, p: *Process) -> void {
        if p.*.parentPid == 0 { return }
        const parent = self.find(p.*.parentPid)
        if parent != null { parent.?.*.signals.post(Signal.CHLD, p.*.pid) }
    }

    // `number` (from `sender`, 0 the kernel) to `q`: pending; SIGCONT
    // makes a stopped process go on, SIGKILL makes it run to end.
    fn send(self: *Self, q: *Process, number: usize, sender: usize) -> void {
        q.*.signals.post(number, sender)
        if number == Signal.CONT { self.resume(q) }
        if number == Signal.KILL && q.*.state == State.stopped { q.*.state = State.ready }
    }

    fn alive(q: *const Process) -> bool { return q.*.state == State.ready || q.*.state == State.blocked || q.*.state == State.stopped }

    // Whether `p` has a child among those `pid` names.
    pub fn hasChild(self: *Self, p: *Process, pid: isize) -> bool {
        var k: usize = 0
        while k < MAX {
            const q = &self.*.processes[k]
            if q.*.state != State.free && q.*.parentPid == p.*.pid && matches(q, pid) { return true }
            k += 1
        }
        return false
    }

    fn matches(q: *const Process, pid: isize) -> bool {
        if pid > 0 { return q.*.pid == @bitCast(usize, pid) }
        if pid < -1 { return q.*.group == @bitCast(usize, -pid) }
        return true
    }

    // `signal` to the processes `pid` names (kill's: one, -1 every one
    // but the first, 0 the sender's group, below -1 a group): pending for
    // each, delivered when it runs next; 0, or -3 (ESRCH) when it names
    // none, -22 (EINVAL) for a number that is no signal.
    pub fn signal(self: *Self, sender: *Process, pid: isize, number: usize) -> isize {
        if number != 0 && !Signal.valid(number) { return -22 }
        var found = false
        var k: usize = 0
        while k < MAX {
            const q = &self.*.processes[k]
            if alive(q) {
                var hit = false
                if pid > 0 { hit = q.*.pid == @bitCast(usize, pid) }
                if pid == 0 { hit = q.*.group == sender.*.group }
                if pid == -1 { hit = q.*.pid != FIRST_PID }
                if pid < -1 { hit = q.*.group == @bitCast(usize, -pid) }
                if hit {
                    found = true
                    if number != 0 { self.send(q, number, sender.*.pid) }
                }
            }
            k += 1
        }
        return if found { 0 } else { -3 }
    }

    // `number` from the kernel to the process group `group`.
    pub fn signalGroup(self: *Self, group: usize, number: usize) -> void {
        var k: usize = 0
        while k < MAX {
            const q = &self.*.processes[k]
            if alive(q) && q.*.group == group { self.send(q, number, 0) }
            k += 1
        }
    }

    // The signals the terminal's characters asked for (Ctrl-C, Ctrl-\,
    // Ctrl-Z) to its foreground group.
    pub fn terminalSignals(self: *Self) -> void {
        while true {
            const number = terminal.serialConsole().takeSignal()
            if number == 0 { return }
            self.signalGroup(self.*.foreground, number)
        }
    }

    // Whether what `p` waits for holds now (a deadline that passed is
    // told by timedOut), or a signal can be delivered to it.
    fn canGo(self: *Self, p: *Process) -> bool {
        if p.*.signals.deliverable() != 0 { return true }
        const w = p.*.waitingFor
        if w.deadline != 0 && clock.system().monotonic() >= w.deadline {
            p.*.timedOut = true
            return true
        }
        if w.kind == WaitKind.none { return true }
        if w.kind == WaitKind.child { return self.child(p, w.target) != null || self.changed(p, w.target, w.options) != null || !self.hasChild(p, w.target) }
        if w.kind == WaitKind.signal { return p.*.signals.pending & @bitCast(usize, w.target) != 0 }
        if w.kind == WaitKind.pause { return false }
        if w.kind == WaitKind.terminal { return terminal.serialConsole().pending() }
        if w.kind == WaitKind.pipe_read { return pipe.table().at(@bitCast(usize, w.target)).readable() }
        if w.kind == WaitKind.pipe_write { return pipe.table().at(@bitCast(usize, w.target)).writable() }
        if w.kind == WaitKind.poll { return terminal.serialConsole().pending() || pipe.table().*.events != @bitCast(usize, w.target) }
        return false
    }

    // Whether `p`'s wait can end without another process (the terminal,
    // the clock; a signal from the terminal).
    fn wakesAlone(p: *const Process) -> bool {
        const kind = p.*.waitingFor.kind
        return p.*.waitingFor.deadline != 0 || kind == WaitKind.terminal || kind == WaitKind.poll || kind == WaitKind.pause
    }

    // The running process stops here (its registers are in `frame`):
    // blocked on `w` (at its SYSCALL, to make the call again), or ready
    // (it yields). Then the next process runs.
    pub fn suspend(self: *Self, frame: *Frame, w: wait.Wait, number: usize) -> bool {
        const p = self.running()
        p.*.context = frame.*
        Bytes.copy(&p.*.sse, frame.sse(), Sse.SIZE)
        if w.kind == WaitKind.none {
            p.*.state = State.ready
        } else {
            p.*.context.rip -= 2
            p.*.context.rax = number
            p.*.waitingFor = w
            p.*.state = State.blocked
            p.*.signals.inCall = true
        }
        return self.switchTo(frame)
    }

    // The time slice of the running process is over (the timer, in user
    // mode): it is ready, and the next one runs (itself when no other can).
    pub fn preempt(self: *Self, frame: *Frame) -> bool { return self.suspend(frame, wait.Wait.none(), 0) }

    // The next process that can go on into `frame` (its registers, memory
    // and FS base in use): the one after the running one first. While none
    // can, the processor waits for an interrupt (the terminal's signals go
    // to the foreground group). False
    // when none ever can (every one waits for another): the caller starts
    // over.
    pub fn switchTo(self: *Self, frame: *Frame) -> bool {
        while true {
            self.terminalSignals()
            var anyAlone = false
            var step: usize = 1
            while step <= MAX {
                const k = (self.*.current + step) % MAX
                const p = &self.*.processes[k]
                if p.*.state == State.blocked {
                    if self.canGo(p) {
                        p.*.state = State.ready
                        p.*.waitingFor = wait.Wait.none()
                    } else if wakesAlone(p) {
                        anyAlone = true
                    }
                }
                if p.*.state == State.ready {
                    self.*.current = k
                    frame.* = p.*.context
                    Bytes.copy(frame.sse(), &p.*.sse, Sse.SIZE)
                    p.*.space.activate()
                    cpu.Msr.write(cpu.Msr.FS_BASE, p.*.fsBase)
                    return true
                }
                step += 1
            }
            if !anyAlone {
                console.out.write("brixOS: every process waits for another\n")
                return false
            }
            // Idle: what changed goes to the disk; what is not needed
            // leaves memory; then the processor halts until an interrupt
            // (the timer's next tick at the latest).
            volume.store().commitAll()
            volume.store().trim()
            cpu.Cpu.wait()
        }
        return false
    }
}

var table: Scheduler = undefined // (per run)

pub fn processes() -> *Scheduler { return &table }

// The process running.
pub fn current() -> *Process { return table.running() }
