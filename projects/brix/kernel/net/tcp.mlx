// TCP: a connection per TCP socket (sockets.mlx): active open (SYN,
// SYN+ACK, ACK), passive open for a listening socket (what is asked of
// it waits in halfopen.mlx's table, without a socket, until the peer's
// ACK makes it a connection in the listener's queue), data in segments
// of MSS bytes within the peer's window from a send ring (sent again
// after a timeout, doubling, given up after RETRIES), data received in
// order into the socket's ring (out of order: dropped, acknowledged
// again), the window the ring's room, FIN both ways, RST. Options: only
// the MSS. No selective acknowledgement, no slow start (the window
// alone paces), no delayed acknowledgement.
const layout = @import("../../layout.mlx")
const clock = @import("../clock.mlx")
const Bytes = @import("../bytes.mlx").Bytes
const stack = @import("./stack.mlx")
const sockets = @import("./sockets.mlx")
const Status = @import("../status.mlx").Status
const limits = @import("./limits.mlx")
const rings = @import("./rings.mlx")
const halfopen = @import("./halfopen.mlx")

pub const State = enum(u8) { closed, listen, syn_sent, established, fin_wait_1, fin_wait_2, close_wait, closing, last_ack, time_wait }

const FIN: usize = 1
const SYN: usize = 2
const RST: usize = 4
const PSH: usize = 8
const ACK: usize = 16
const HEADER: usize = 20
pub const MSS: usize = 1460
const SEND_RING: usize = limits.RING
const SECOND: usize = 1000000000
const FIRST_RTO: usize = SECOND
const MAX_RTO: usize = 8 * SECOND
const RETRIES: usize = 10
const TIME_WAIT: usize = 2 * SECOND
// A connection its program let go of has this long, from the peer's last
// step on, for what is left of it (see letGo).
const ORPHAN_TIME: usize = 20 * SECOND
// A listener's connections made and not yet accepted. Each holds a
// socket and its two rings (32 KiB): a program that answers eight
// clients at a time (logserve) has twice as many waiting behind them.
// With the queue full a SYN gets no answer (the peer asks again a second
// later, and by then the program may have taken a connection from the
// queue), and an ACK that would make a connection is dropped (its
// SYN+ACK goes again by its clock, and the peer's answer to that tries
// once more). It was 4, counted together with what was only asked: four
// SYNs nobody followed up kept a listener deaf for over a minute.
const MAX_PENDING: usize = 16
const ECONNREFUSED: isize = -111
const ECONNRESET: isize = -104
const ETIMEDOUT: isize = -110

fn mask(v: usize) -> usize { return v & 0xFFFFFFFF }
// Whether sequence number `a` is after `b`.
fn after(a: usize, b: usize) -> bool { return a != b && mask(a -% b) < 0x80000000 }
fn afterOrAt(a: usize, b: usize) -> bool { return a == b || after(a, b) }

pub const Connection = struct {
    socket: usize
    state: State
    localPort: usize
    remote: stack.Ip
    remotePort: usize
    iss: usize
    sndUna: usize
    sndNxt: usize
    rcvNxt: usize
    peerWindow: usize
    mss: usize
    // The send ring (physical pages): the bytes from sndUna on, `count`
    // of them (unacknowledged first, then unsent).
    ring: usize
    head: usize
    count: usize
    // A FIN wanted after the data, and sent (it takes a sequence number).
    finQueued: bool
    finSent: bool
    // The retransmission: when (0: nothing in flight), how long, how often.
    rtoDeadline: usize
    rto: usize
    retries: usize
    timeWaitDeadline: usize
    // When a connection nobody holds any more is given up (0: it is
    // somebody's, or not a connection yet).
    orphanDeadline: usize
    // The window we last told was small.
    windowClosed: bool
    // push is running (a segment to ourselves comes back into the
    // connection before push goes on: no second push then).
    pushing: bool
    // A listener's connections established, not yet accepted.
    pending: [MAX_PENDING]usize
    pendingCount: usize

    fn bytes(self: *const Self) -> [*]u8 { return Bytes.pointer(layout.Memory.virtual(self.*.ring)) }

    pub fn init(self: *Self, socket: usize) -> bool {
        self.*.socket = socket
        self.*.state = State.closed
        self.*.ring = rings.take()
        if self.*.ring == 0 { return false }
        self.*.head = 0
        self.*.count = 0
        self.*.finQueued = false
        self.*.finSent = false
        self.*.rtoDeadline = 0
        self.*.rto = FIRST_RTO
        self.*.retries = 0
        self.*.timeWaitDeadline = 0
        self.*.orphanDeadline = 0
        self.*.windowClosed = false
        self.*.pushing = false
        self.*.pendingCount = 0
        self.*.peerWindow = MSS
        self.*.mss = MSS
        return true
    }

    pub fn deinit(self: *Self) -> void {
        rings.give(self.*.ring)
        self.*.ring = 0
        self.*.state = State.closed
    }

    pub fn done(self: *const Self) -> bool { return self.*.state == State.closed }

    fn window(self: *Self) -> usize {
        const room = sockets.sockets().at(self.*.socket).room()
        self.*.windowClosed = room < 2 * MSS
        return if room > 65535 { 65535 } else { room }
    }

    // A segment to the peer: `flags`, sequence number `seq`, `length`
    // bytes of data already at the payload area after the header.
    fn segment(self: *Self, flags: usize, seq: usize, length: usize) -> bool {
        const h = stack.payloadArea()
        var headerLength: usize = HEADER
        if flags & SYN != 0 {
            // The MSS option.
            h[20] = 2
            h[21] = 4
            stack.putBe16(h, 22, MSS)
            headerLength = 24
        }
        stack.putBe16(h, 0, self.*.localPort)
        stack.putBe16(h, 2, self.*.remotePort)
        stack.putBe32(h, 4, mask(seq))
        stack.putBe32(h, 8, if flags & ACK != 0 { mask(self.*.rcvNxt) } else { 0 })
        h[12] = @intCast(u8, (headerLength / 4) << 4)
        h[13] = @intCast(u8, flags)
        stack.putBe16(h, 14, self.window())
        stack.putBe16(h, 16, 0)
        stack.putBe16(h, 18, 0)
        const total = headerLength + length
        stack.putBe16(h, 16, stack.checksum(h, total, stack.pseudoSum(stack.sourceFor(self.*.remote), self.*.remote, stack.PROTOCOL_TCP, total)))
        return stack.send(stack.PROTOCOL_TCP, self.*.remote, total)
    }

    // A reset for a segment of no connection (no socket: window 0).
    fn segmentStray(self: *Self, flags: usize, seq: usize) -> bool {
        const h = stack.payloadArea()
        stack.putBe16(h, 0, self.*.localPort)
        stack.putBe16(h, 2, self.*.remotePort)
        stack.putBe32(h, 4, mask(seq))
        stack.putBe32(h, 8, if flags & ACK != 0 { mask(self.*.rcvNxt) } else { 0 })
        h[12] = @intCast(u8, (HEADER / 4) << 4)
        h[13] = @intCast(u8, flags)
        stack.putBe16(h, 14, 0)
        stack.putBe16(h, 16, 0)
        stack.putBe16(h, 18, 0)
        stack.putBe16(h, 16, stack.checksum(h, HEADER, stack.pseudoSum(stack.sourceFor(self.*.remote), self.*.remote, stack.PROTOCOL_TCP, HEADER)))
        return stack.send(stack.PROTOCOL_TCP, self.*.remote, HEADER)
    }

    fn arm(self: *Self) -> void {
        if self.*.rtoDeadline == 0 { self.*.rtoDeadline = clock.system().monotonic() + self.*.rto }
    }

    // The connection opened to `remote`:`port` from `localPort` (the SYN
    // sent; it is established when the SYN+ACK comes).
    pub fn open(self: *Self, localPort: usize, remote: stack.Ip, port: usize) -> isize {
        if self.*.state != State.closed { return Status.invalid }
        // A connection is to one host: an address that is everyone's
        // (255.255.255.255, the subnet's last) or a group's is refused
        // (RFC 1122, 4.2.3.10). Taken, its SYN went to every host on the
        // wire, to everyone's hardware address, again and again.
        if stack.manyHosts(remote) { return Status.invalid }
        // What cannot leave the machine as it is (no device, the link
        // down, no address, no gateway to it) fails now, with the status
        // that says so. Begun all the same, its SYN was tried again and
        // again for over a minute, and the program heard nothing for as
        // long as it cared to wait.
        if !stack.reaches(remote) { return Status.unreachable }
        self.*.localPort = localPort
        self.*.remote = remote
        self.*.remotePort = port
        self.*.iss = mask(clock.system().monotonic() / 64)
        self.*.sndUna = self.*.iss
        self.*.sndNxt = mask(self.*.iss + 1)
        self.*.rcvNxt = 0
        self.*.state = State.syn_sent
        self.*.rto = FIRST_RTO
        self.*.retries = 0
        _ = self.segment(SYN, self.*.iss, 0)
        self.arm()
        return 0
    }

    pub fn listen(self: *Self, port: usize) -> void {
        self.*.localPort = port
        self.*.state = State.listen
        self.*.pendingCount = 0
    }

    pub fn hasPending(self: *const Self) -> bool { return self.*.pendingCount > 0 }

    // The next established connection of a listener: its socket's index,
    // or would_block.
    pub fn takePending(self: *Self) -> isize {
        if self.*.pendingCount == 0 { return Status.would_block }
        const index = self.*.pending[0]
        var k: usize = 1
        while k < self.*.pendingCount {
            self.*.pending[k - 1] = self.*.pending[k]
            k += 1
        }
        self.*.pendingCount -= 1
        sockets.sockets().at(index).*.holders = 1
        return @intCast(isize, index)
    }

    fn unsent(self: *const Self) -> usize { return self.*.count - mask(self.*.sndNxt -% self.*.sndUna) + (if self.*.finSent { 1 } else { 0 }) }

    pub fn sendRoom(self: *const Self) -> usize { return SEND_RING - self.*.count }

    // `length` bytes from `data` into the send ring and on their way: how
    // many were taken, would_block when none fit, peer_gone when the
    // connection takes no more.
    pub fn send(self: *Self, data: [*]const u8, length: usize) -> isize {
        if self.*.state != State.established && self.*.state != State.close_wait { return Status.peer_gone }
        if self.*.finQueued { return Status.peer_gone }
        const room = self.sendRoom()
        if room == 0 { return Status.would_block }
        const taken = if length > room { room } else { length }
        const b = self.bytes()
        var k: usize = 0
        while k < taken {
            b[(self.*.head + self.*.count + k) % SEND_RING] = data[k]
            k += 1
        }
        self.*.count += taken
        self.push()
        return @intCast(isize, taken)
    }

    // `length` bytes of the ring from `from` (an offset from sndUna) to
    // the payload area after the header.
    fn copyOut(self: *const Self, from: usize, length: usize) -> void {
        const b = self.bytes()
        const into = Bytes.pointer(@intFromPtr(stack.payloadArea()) + HEADER)
        var k: usize = 0
        while k < length {
            into[k] = b[(self.*.head + from + k) % SEND_RING]
            k += 1
        }
    }

    // What can go now: segments of unsent bytes within the peer's
    // window, then the FIN when every byte went.
    fn push(self: *Self) -> void {
        if self.*.state != State.established && self.*.state != State.close_wait && self.*.state != State.fin_wait_1 && self.*.state != State.closing && self.*.state != State.last_ack { return }
        if self.*.pushing { return }
        self.*.pushing = true
        while true {
            const inFlight = mask(self.*.sndNxt -% self.*.sndUna)
            if inFlight > self.*.count || self.*.count - inFlight == 0 || inFlight >= self.*.peerWindow { break }
            const left = self.*.count - inFlight
            var chunk = if left > self.*.mss { self.*.mss } else { left }
            if chunk > self.*.peerWindow - inFlight { chunk = self.*.peerWindow - inFlight }
            self.copyOut(inFlight, chunk)
            // (The sequence number moves first: the segment's answer may
            // come back before segment returns, to ourselves.)
            const seq = self.*.sndNxt
            self.*.sndNxt = mask(seq + chunk)
            if !self.segment(ACK | (if chunk == left { PSH } else { 0 }), seq, chunk) {
                self.*.sndNxt = seq
                // (It could not go: the device is busy, or the address
                // was given up meanwhile. The timer tries again:
                // nothing else would.)
                self.arm()
                break
            }
            self.arm()
        }
        if self.*.finQueued && !self.*.finSent && self.*.count == mask(self.*.sndNxt -% self.*.sndUna) {
            const seq = self.*.sndNxt
            self.*.finSent = true
            self.*.sndNxt = mask(seq + 1)
            self.*.state = if self.*.state == State.close_wait { State.last_ack } else { State.fin_wait_1 }
            if self.segment(FIN | ACK, seq, 0) {
                self.arm()
            } else {
                self.*.finSent = false
                self.*.sndNxt = seq
                self.*.state = if self.*.state == State.last_ack { State.close_wait } else { State.established }
                self.arm()
            }
        }
        self.*.pushing = false
    }

    // The socket's last descriptor went (or shutdown): the data still
    // goes, then the FIN; a connection not yet made is dropped.
    pub fn close(self: *Self) -> void {
        if self.*.state == State.established || self.*.state == State.close_wait {
            self.*.finQueued = true
            self.push()
            return
        }
        if self.*.state == State.listen {
            // What was asked of it and not made yet, and the connections
            // waiting to be accepted, go.
            half.dropPort(self.*.localPort)
            var k: usize = 0
            while k < self.*.pendingCount {
                connections[self.*.pending[k]].abort()
                connections[self.*.pending[k]].deinit()
                sockets.sockets().drop(self.*.pending[k])
                k += 1
            }
            self.*.pendingCount = 0
            self.*.state = State.closed
            return
        }
        if self.*.state == State.syn_sent { self.abort() }
    }

    // The socket's last descriptor went and the connection is not over:
    // what is left of it (the send ring's rest and the FIN to go, the
    // peer's own FIN to come) has ORPHAN_TIME from each step the peer
    // takes; a connection that stands still that long with nothing on its
    // way is reset (tick). Nobody is left to close such a connection: a
    // peer that got its answer and never closed its side, or one that
    // took no more of it, kept the socket for good, and 31 such peers
    // were every socket the machine has. (What is on its way and not
    // acknowledged ends with the retransmissions, as before.)
    pub fn letGo(self: *Self) -> void { self.*.orphanDeadline = clock.system().monotonic() + ORPHAN_TIME }

    // The connection reset (RST to the peer when one was made).
    fn abort(self: *Self) -> void {
        if self.*.state != State.closed && self.*.state != State.listen && self.*.state != State.syn_sent { _ = self.segment(RST | ACK, self.*.sndNxt, 0) }
        self.*.state = State.closed
        self.*.rtoDeadline = 0
    }

    // The window told again when it was small and the reader made room.
    pub fn windowOpened(self: *Self) -> void {
        if self.*.windowClosed && (self.*.state == State.established || self.*.state == State.fin_wait_1 || self.*.state == State.fin_wait_2) {
            _ = self.segment(ACK, self.*.sndNxt, 0)
        }
    }

    // The connection is over: the socket hears; nobody's, it goes.
    fn finishedNow(self: *Self) -> void {
        self.*.state = State.closed
        self.*.rtoDeadline = 0
        sockets.sockets().changed(self.*.socket)
        if sockets.sockets().holdersOf(self.*.socket) == 0 {
            // (Nobody's yet: a listener may hold it as pending.)
            forget(self.*.socket)
            self.deinit()
            sockets.sockets().drop(self.*.socket)
        }
    }

    // The peer's acknowledgement `ack` (and its window): the bytes it
    // covers leave the ring.
    fn acknowledged(self: *Self, ack: usize, peerWindow: usize) -> void {
        self.*.peerWindow = peerWindow
        if !after(ack, self.*.sndUna) || after(ack, self.*.sndNxt) { return }
        var covered = mask(ack -% self.*.sndUna)
        var finAcked = false
        if self.*.finSent && ack == self.*.sndNxt {
            covered -= 1
            finAcked = true
        }
        if covered > self.*.count { covered = self.*.count }
        self.*.head = (self.*.head + covered) % SEND_RING
        self.*.count -= covered
        self.*.sndUna = ack
        self.*.retries = 0
        self.*.rto = FIRST_RTO
        self.*.rtoDeadline = if ack == self.*.sndNxt { 0 } else { clock.system().monotonic() + self.*.rto }
        if covered > 0 { sockets.sockets().roomMade(self.*.socket) }
        if self.*.orphanDeadline != 0 { self.letGo() }
        if finAcked {
            if self.*.state == State.fin_wait_1 { self.*.state = State.fin_wait_2 }
            if self.*.state == State.closing { self.enterTimeWait() }
            if self.*.state == State.last_ack { self.finishedNow() }
        }
    }

    fn enterTimeWait(self: *Self) -> void {
        self.*.state = State.time_wait
        self.*.rtoDeadline = 0
        self.*.timeWaitDeadline = clock.system().monotonic() + TIME_WAIT
    }

    // A segment for this connection.
    fn take(self: *Self, seq: usize, ack: usize, flags: usize, peerWindow: usize, data: [*]const u8, length: usize, options: [*]const u8, optionsLength: usize) -> void {
        if flags & RST != 0 {
            if self.*.state == State.syn_sent {
                if flags & ACK != 0 && ack == self.*.sndNxt { self.fail(ECONNREFUSED) }
                return
            }
            // Only a reset within what we take counts (anyone can send one
            // for a pair of ports).
            if mask(seq -% self.*.rcvNxt) > limits.RING { return }
            self.fail(ECONNRESET)
            return
        }
        if self.*.state == State.syn_sent {
            if flags & SYN == 0 || flags & ACK == 0 || ack != self.*.sndNxt { return }
            self.*.rcvNxt = mask(seq + 1)
            self.*.mss = mssOf(options, optionsLength)
            self.acknowledged(ack, peerWindow)
            self.*.state = State.established
            _ = self.segment(ACK, self.*.sndNxt, 0)
            sockets.Sockets.established(self.*.socket)
            return
        }
        if flags & ACK == 0 { return }
        if self.*.state == State.time_wait {
            if flags & FIN != 0 { _ = self.segment(ACK, self.*.sndNxt, 0) }
            return
        }
        self.acknowledged(ack, peerWindow)
        if self.*.state == State.closed { return }
        // Data for a socket its program has let go of: nobody reads it, the
        // ring would fill and the socket stay for good. Reset.
        if length > 0 && self.*.finQueued && sockets.sockets().holdersOf(self.*.socket) == 0 {
            self.abort()
            self.finishedNow()
            return
        }
        // Data in order, into the socket; otherwise the acknowledgement
        // says what is wanted.
        var consumed: usize = 0
        if length > 0 {
            if seq == self.*.rcvNxt {
                consumed = sockets.Sockets.deliverBytes(self.*.socket, data, length)
                self.*.rcvNxt = mask(self.*.rcvNxt + consumed)
            }
            _ = self.segment(ACK, self.*.sndNxt, 0)
        }
        if flags & FIN != 0 && mask(seq + consumed) == self.*.rcvNxt && consumed == length {
            self.*.rcvNxt = mask(self.*.rcvNxt + 1)
            sockets.Sockets.peerClosed(self.*.socket)
            if self.*.state == State.established { self.*.state = State.close_wait }
            if self.*.state == State.fin_wait_1 { self.*.state = State.closing }
            if self.*.state == State.fin_wait_2 { self.enterTimeWait() }
            _ = self.segment(ACK, self.*.sndNxt, 0)
        }
        self.push()
    }

    fn fail(self: *Self, code: isize) -> void {
        sockets.Sockets.failed(self.*.socket, code)
        self.finishedNow()
    }

    // The retransmission timer (every tick): what the peer did not
    // acknowledge in time, sent again; given up after RETRIES.
    fn tick(self: *Self, now: usize) -> void {
        if self.*.state == State.time_wait && now >= self.*.timeWaitDeadline {
            self.finishedNow()
            return
        }
        if self.*.orphanDeadline != 0 && self.*.rtoDeadline == 0 && self.*.state != State.time_wait && now >= self.*.orphanDeadline {
            self.abort()
            self.finishedNow()
            return
        }
        if self.*.rtoDeadline == 0 || now < self.*.rtoDeadline { return }
        self.*.retries += 1
        if self.*.retries > RETRIES {
            self.fail(ETIMEDOUT)
            return
        }
        self.*.rto = if self.*.rto * 2 > MAX_RTO { MAX_RTO } else { self.*.rto * 2 }
        self.*.rtoDeadline = now + self.*.rto
        if self.*.state == State.syn_sent {
            _ = self.segment(SYN, self.*.iss, 0)
            return
        }
        const inFlight = mask(self.*.sndNxt -% self.*.sndUna)
        const dataInFlight = if self.*.finSent && inFlight > 0 { inFlight - 1 } else { inFlight }
        if dataInFlight > 0 {
            const chunk = if dataInFlight > self.*.mss { self.*.mss } else { dataInFlight }
            self.copyOut(0, chunk)
            _ = self.segment(ACK | PSH, self.*.sndUna, chunk)
        } else if self.*.finSent {
            _ = self.segment(FIN | ACK, mask(self.*.sndNxt -% 1), 0)
        } else {
            // Nothing in flight: what could not go when it was pushed.
            self.*.rtoDeadline = 0
            self.push()
        }
    }
}

var connections: [limits.MAX_SOCKETS]Connection = undefined // (per run)
// The reset for a segment of no connection is made in this one (static:
// a local Connection took 200 bytes of the aggregate arena a segment).
var stray: Connection = undefined // (per run)
// What is asked of the listeners and not made yet.
var half: halfopen.Table = undefined // (per run)

// The largest segment a peer takes, as its SYN's options say (ours where
// they say none, or more).
fn mssOf(options: [*]const u8, length: usize) -> usize {
    var at: usize = 0
    while at < length {
        const kind = options[at]
        if kind == 0 { break }
        if kind == 1 {
            at += 1
            continue
        }
        if at + 1 >= length { break }
        const size = @intCast(usize, options[at + 1])
        if size < 2 || at + size > length { break }
        if kind == 2 && size == 4 {
            const mss = stack.be16(options, at + 2)
            if mss >= 536 && mss < MSS { return mss }
        }
        at += size
    }
    return MSS
}

// The SYN+ACK of record `h`: our sequence number, the peer's next, the
// MSS option, the window a new connection's empty ring has; from the
// address the peer spoke to.
fn answer(h: *const halfopen.HalfOpen) -> void {
    const p = stack.payloadArea()
    const remote = stack.getIp(&h.*.remote, 0)
    stack.putBe16(p, 0, h.*.port)
    stack.putBe16(p, 2, h.*.remotePort)
    stack.putBe32(p, 4, mask(h.*.iss))
    stack.putBe32(p, 8, mask(h.*.theirs))
    p[12] = @intCast(u8, ((HEADER + 4) / 4) << 4)
    p[13] = @intCast(u8, SYN | ACK)
    stack.putBe16(p, 14, if limits.RING > 65535 { 65535 } else { limits.RING })
    stack.putBe16(p, 16, 0)
    stack.putBe16(p, 18, 0)
    p[20] = 2
    p[21] = 4
    stack.putBe16(p, 22, MSS)
    stack.putBe16(p, 16, stack.checksum(p, HEADER + 4, stack.pseudoSum(stack.sourceFor(remote), remote, stack.PROTOCOL_TCP, HEADER + 4)))
    _ = stack.send(stack.PROTOCOL_TCP, remote, HEADER + 4)
}

// A SYN for the listener at socket `listener`: a record of what is asked
// (halfopen.mlx: with the table full the one that waited longest gives
// way) and the SYN+ACK from it; no socket yet. With the listener's queue
// full the SYN gets no answer.
fn asked(listener: usize, port: usize, source: stack.Ip, sourcePort: usize, seq: usize, peerWindow: usize, options: [*]const u8, optionsLength: usize) -> void {
    if connections[listener].pendingCount >= MAX_PENDING { return }
    const now = clock.system().monotonic()
    const index = half.begin(port, &source, sourcePort, mask(now / 64), mask(seq + 1), mssOf(options, optionsLength), peerWindow, now)
    answer(half.at(index))
}

// The peer answered the SYN+ACK of record `found`: the connection is
// made (a socket and its rings taken now) and put in the queue of the
// listener at socket `listener`, and the record is over. Its socket's
// index; sockets.MAX when the queue is full or there is no socket or no
// memory for it: the record stays, its SYN+ACK goes again by its clock,
// and the peer's answer to that tries once more.
fn make(listener: usize, found: usize) -> usize {
    const l = &connections[listener]
    if l.*.pendingCount >= MAX_PENDING { return sockets.MAX }
    const h = half.at(found)
    const remote = stack.getIp(&h.*.remote, 0)
    const opened = sockets.sockets().openAccepted(h.*.port, remote, h.*.remotePort)
    if opened < 0 { return sockets.MAX }
    const index = @bitCast(usize, opened)
    const c = &connections[index]
    if !c.init(index) {
        sockets.sockets().abandon(index)
        return sockets.MAX
    }
    c.*.localPort = h.*.port
    c.*.remote = remote
    c.*.remotePort = h.*.remotePort
    c.*.iss = h.*.iss
    c.*.sndUna = mask(h.*.iss + 1)
    c.*.sndNxt = mask(h.*.iss + 1)
    c.*.rcvNxt = h.*.theirs
    c.*.mss = h.*.mss
    c.*.peerWindow = h.*.window
    c.*.state = State.established
    half.drop(found)
    l.*.pending[l.*.pendingCount] = index
    l.*.pendingCount += 1
    sockets.sockets().roomMade(listener)
    sockets.Sockets.established(index)
    return index
}

// Socket `index` out of every listener's pending connections (it goes
// before it was accepted: accept must not hand out a slot that is free,
// or someone else's by then).
fn forget(index: usize) -> void {
    var l: usize = 0
    while l < limits.MAX_SOCKETS {
        const c = &connections[l]
        if c.*.state == State.listen {
            var k: usize = 0
            while k < c.*.pendingCount {
                if c.*.pending[k] == index {
                    var j = k + 1
                    while j < c.*.pendingCount {
                        c.*.pending[j - 1] = c.*.pending[j]
                        j += 1
                    }
                    c.*.pendingCount -= 1
                } else {
                    k += 1
                }
            }
        }
        l += 1
    }
}

pub fn connectionAt(index: usize) -> *Connection { return &connections[index] }

pub fn init() -> void {
    var k: usize = 0
    while k < limits.MAX_SOCKETS {
        connections[k].state = State.closed
        k += 1
    }
    half.init()
}

// A segment from the stack: to its connection, or to a listener (a SYN:
// a connection is asked; the ACK that follows our SYN+ACK: it is made),
// or answered with a reset.
pub fn receive(source: stack.Ip, destination: stack.Ip, bytes: [*]const u8, length: usize) -> void {
    if length < HEADER { return }
    if stack.checksum(bytes, length, stack.pseudoSum(source, destination, stack.PROTOCOL_TCP, length)) != 0 { return }
    const sourcePort = stack.be16(bytes, 0)
    const port = stack.be16(bytes, 2)
    const seq = stack.be32(bytes, 4)
    const ack = stack.be32(bytes, 8)
    const headerLength = @intCast(usize, bytes[12] >> 4) * 4
    if headerLength < HEADER || headerLength > length { return }
    const flags = @intCast(usize, bytes[13])
    const peerWindow = stack.be16(bytes, 14)
    const data = Bytes.pointer(@intFromPtr(bytes) + headerLength)
    const dataLength = length - headerLength
    const options = Bytes.pointer(@intFromPtr(bytes) + HEADER)
    const table = sockets.sockets()
    var k: usize = 0
    while k < sockets.MAX {
        const s = table.at(k)
        if s.*.kind == sockets.Kind.tcp && !s.*.listening && connections[k].state != State.closed && s.*.localPort == port && s.*.remotePort == sourcePort && stack.same(s.*.remote, source) {
            connections[k].take(seq, ack, flags, peerWindow, data, dataLength, options, headerLength - HEADER)
            return
        }
        k += 1
    }
    const listener = sockets.Sockets.listenerFor(port)
    if listener != sockets.MAX {
        const found = half.find(port, &source, sourcePort)
        if flags & RST != 0 {
            // The peer takes back what it asked (with the number we
            // expect of it: anyone can send a reset for a pair of ports).
            if found != halfopen.MAX && seq == half.at(found).*.theirs { half.drop(found) }
            return
        }
        if flags & SYN != 0 && flags & ACK == 0 {
            asked(listener, port, source, sourcePort, seq, peerWindow, options, headerLength - HEADER)
            return
        }
        if found != halfopen.MAX && flags & SYN == 0 && flags & ACK != 0 && ack == mask(half.at(found).*.iss + 1) {
            // The peer's answer to our SYN+ACK (one that is not in
            // order: let pass). The connection made takes the segment,
            // with the data it may carry.
            if seq != half.at(found).*.theirs { return }
            const made = make(listener, found)
            if made != sockets.MAX { connections[made].take(seq, ack, flags, peerWindow, data, dataLength, options, headerLength - HEADER) }
            return
        }
    }
    // Nobody's: a reset (unless it was one).
    if flags & RST == 0 {
        stray.localPort = port
        stray.remote = source
        stray.remotePort = sourcePort
        stray.rcvNxt = mask(seq + dataLength + (if flags & SYN != 0 { 1 } else { 0 }))
        stray.socket = sockets.MAX
        if flags & ACK != 0 {
            _ = stray.segmentStray(RST, ack)
        } else {
            _ = stray.segmentStray(RST | ACK, 0)
        }
    }
}

// The timers of every connection.
pub fn tick() -> void {
    const now = clock.system().monotonic()
    var k: usize = 0
    while k < sockets.MAX {
        const s = sockets.sockets().at(k)
        if s.*.kind == sockets.Kind.tcp && !s.*.listening { connections[k].tick(now) }
        k += 1
    }
    // What is asked and not made yet: the SYN+ACK again, or the end.
    if half.count > 0 {
        k = 0
        while k < halfopen.MAX {
            if half.due(k, now) == halfopen.Step.again { answer(half.at(k)) }
            k += 1
        }
    }
}
