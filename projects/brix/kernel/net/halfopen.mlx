// TCP connections asked of a listener and not made yet: the peer's SYN
// came, the SYN+ACK went, and its ACK is waited for. Each is a record in
// this table, the machine's one, and nothing else: no socket and no ring
// until the ACK comes (tcp.mlx makes the connection then). A peer that
// asks and never answers costs a record for seven seconds.
//
// The rules: a SYN takes a free record; with none free, the record that
// has waited longest gives way to it (it is the one least likely to be
// answered still; its peer, if it is there after all, asks again and
// gets a record anew), never the newcomer. The SYN+ACK goes again after
// one second and after two more, and four seconds after that the record
// is dropped without a word. A SYN that comes again finds its record,
// and is answered again from it.
//
// This file knows no kernel (the clock is the caller's), so the same
// code runs in a test built for the host
// (tests/465_tcp_half_open_runtime.mlx); tcp.mlx is the kernel's side.

// The records. A listener's queue of connections made and not yet
// accepted is 16 (tcp.mlx); four times that may be on their way.
pub const MAX: usize = 64
pub const SECOND: usize = 1000000000
// The SYN+ACKs a record sends in all, the pause after the first (it
// doubles): at 0, 1 and 3 seconds, the end at 7.
pub const ANSWERS: usize = 3
const FIRST_WAIT: usize = SECOND

pub const HalfOpen = struct {
    used: bool
    // The listener's port, and who asked.
    port: usize
    remote: [4]u8
    remotePort: usize
    // Our first sequence number (the SYN+ACK's), and the peer's next
    // (its SYN's and one).
    iss: usize
    theirs: usize
    // What the peer's SYN said: the largest segment it takes, its window.
    mss: usize
    window: usize
    // When the SYN came, when the SYN+ACK goes again (or the record
    // ends), and how many went.
    since: usize
    again: usize
    answers: usize
}

// What the clock does to a record: nothing yet; its SYN+ACK goes again;
// it is over.
pub const Step = enum(u8) { none, again, gone }

pub const Table = struct {
    slots: [MAX]HalfOpen
    count: usize

    pub fn init(self: *Self) -> void {
        var k: usize = 0
        while k < MAX {
            self.*.slots[k].used = false
            self.*.slots[k].since = 0
            k += 1
        }
        self.*.count = 0
    }

    pub fn at(self: *Self, index: usize) -> *HalfOpen { return &self.*.slots[index] }

    // The record of the connection `remote`:`remotePort` asked of the
    // listener on `port`: its index, or MAX.
    pub fn find(self: *const Self, port: usize, remote: [*]const u8, remotePort: usize) -> usize {
        if self.*.count == 0 { return MAX }
        var k: usize = 0
        while k < MAX {
            const h = &self.*.slots[k]
            if h.*.used && h.*.port == port && h.*.remotePort == remotePort && h.*.remote[0] == remote[0] && h.*.remote[1] == remote[1] && h.*.remote[2] == remote[2] && h.*.remote[3] == remote[3] { return k }
            k += 1
        }
        return MAX
    }

    // The place a new record takes: a free one, else the one that has
    // waited longest.
    pub fn place(self: *const Self) -> usize {
        var oldest: usize = 0
        var k: usize = 0
        while k < MAX {
            if !self.*.slots[k].used { return k }
            if self.*.slots[k].since < self.*.slots[oldest].since { oldest = k }
            k += 1
        }
        return oldest
    }

    // A SYN from `remote`:`remotePort` for the listener on `port`, at
    // `now`: its record (the index), made with `iss` as our sequence
    // number, or the one it has already when the same SYN came again
    // (the peer's number is the same: nothing of the record changes, its
    // clock neither). The caller sends the SYN+ACK from the record.
    pub fn begin(self: *Self, port: usize, remote: [*]const u8, remotePort: usize, iss: usize, theirs: usize, mss: usize, window: usize, now: usize) -> usize {
        var index = self.find(port, remote, remotePort)
        if index != MAX && self.*.slots[index].theirs == theirs { return index }
        // (Another SYN from the same port: the peer began anew, and the
        // record with it.)
        if index == MAX {
            index = self.place()
            if !self.*.slots[index].used { self.*.count += 1 }
        }
        const h = &self.*.slots[index]
        h.*.used = true
        h.*.port = port
        h.*.remote[0] = remote[0]
        h.*.remote[1] = remote[1]
        h.*.remote[2] = remote[2]
        h.*.remote[3] = remote[3]
        h.*.remotePort = remotePort
        h.*.iss = iss
        h.*.theirs = theirs
        h.*.mss = mss
        h.*.window = window
        h.*.since = now
        h.*.again = now + FIRST_WAIT
        h.*.answers = 1
        return index
    }

    pub fn drop(self: *Self, index: usize) -> void {
        if !self.*.slots[index].used { return }
        self.*.slots[index].used = false
        self.*.count -= 1
    }

    // The listener on `port` closed: nobody is left to take what was
    // asked of it.
    pub fn dropPort(self: *Self, port: usize) -> void {
        var k: usize = 0
        while k < MAX {
            if self.*.slots[k].used && self.*.slots[k].port == port { self.drop(k) }
            k += 1
        }
    }

    // The clock for record `index` at `now`: Step.again when its SYN+ACK
    // is to go once more (counted here, the next pause twice as long),
    // Step.gone when it has waited out its time (dropped here).
    pub fn due(self: *Self, index: usize, now: usize) -> Step {
        const h = &self.*.slots[index]
        if !h.*.used || now < h.*.again { return Step.none }
        if h.*.answers >= ANSWERS {
            self.drop(index)
            return Step.gone
        }
        h.*.again = now + (FIRST_WAIT << @intCast(u6, h.*.answers))
        h.*.answers += 1
        return Step.again
    }
}
