// The network: Ethernet frames of the device (virtionet.mlx), ARP (a
// table of the neighbours' addresses, requests when one is missing),
// IPv4 (one address, netmask and gateway: a packet goes to a neighbour
// of the subnet or to the gateway; no fragments), ICMP (echo answered;
// echo requests sent, the replies counted) and the dispatch to UDP and
// TCP (udp.mlx, tcp.mlx). The configuration is QEMU's user network's by
// default (10.0.2.15/24, gateway 10.0.2.2, name server 10.0.2.3) or
// /system/settings/network's (address, netmask, gateway, nameserver),
// else DHCP's (dhcp.mlx); `source` says which it is, for the link's
// record (link.mlx).
const console = @import("../console.mlx")
const clock = @import("../clock.mlx")
const netdev = @import("../netdev.mlx")
const Bytes = @import("../bytes.mlx").Bytes
const udp = @import("./udp.mlx")
const tcp = @import("./tcp.mlx")
const sockets = @import("./sockets.mlx")
const dhcp = @import("./dhcp.mlx")

pub const Ip = [4]u8
pub const Mac = [6]u8

pub const ETHERNET_HEADER: usize = 14
pub const IP_HEADER: usize = 20
pub const TYPE_IPV4: usize = 0x0800
pub const TYPE_ARP: usize = 0x0806
pub const PROTOCOL_ICMP: u8 = 1
pub const PROTOCOL_TCP: u8 = 6
pub const PROTOCOL_UDP: u8 = 17
// The most an IP payload may be (the frame's 1514 less the headers).
pub const MAX_PAYLOAD: usize = 1514 - ETHERNET_HEADER - IP_HEADER

// Where the configuration's address came from: nowhere yet (the
// addresses are the defaults while DHCP asks), DHCP, or the settings
// file. The link's record gives these numbers to programs.
pub const Source = struct {
    pub const NONE: usize = 0
    pub const DHCP: usize = 1
    pub const SETTINGS: usize = 2
}

pub const Config = struct {
    up: bool
    source: usize
    address: Ip
    mask: Ip
    gateway: Ip
    nameServer: Ip
}

pub const Neighbour = struct {
    valid: bool
    ip: Ip
    mac: Mac
    // When it was learnt (nanoseconds since boot).
    when: usize
}

const MAX_NEIGHBOURS: usize = 16
// A neighbour is asked again after this long.
const NEIGHBOUR_LIFE: usize = 600 * 1000000000

var config: Config = undefined // (per run)
var neighbours: [MAX_NEIGHBOURS]Neighbour = undefined // (per run)
// A frame being made (Ethernet, IP, the payload), and a packet to
// ourselves on its way in.
var frame: [2048]u8 = undefined // (per run)
var loopback: [2048]u8 = undefined // (per run)
// Echo replies that came (the boot's self-test, ping).
var echoReplies: usize = 0 // (per run)
var lastEchoFrom: Ip = undefined // (per run)

pub fn configuration() -> *Config { return &config }
pub fn echoRepliesSeen() -> usize { return echoReplies }
pub fn lastEchoSource() -> Ip { return lastEchoFrom }

pub fn same(a: Ip, b: Ip) -> bool { return a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3] }

pub fn ipOf(a: u8, b: u8, c: u8, d: u8) -> Ip { return [4]u8{ a, b, c, d } }

// The network up with QEMU's user network's addresses (the settings
// file may change them: settings).
pub fn init() -> void {
    config.up = netdev.present()
    config.source = Source.NONE
    config.address = ipOf(10, 0, 2, 15)
    config.mask = ipOf(255, 255, 255, 0)
    config.gateway = ipOf(10, 0, 2, 2)
    config.nameServer = ipOf(10, 0, 2, 3)
    var k: usize = 0
    while k < MAX_NEIGHBOURS {
        neighbours[k].valid = false
        k += 1
    }
    echoReplies = 0
    sockets.sockets().init()
    udp.init()
    tcp.init()
    if config.up { arpRequest(config.gateway) }
}

// The settings' text (address, netmask, gateway, nameserver lines) taken
// over: whether it gave an address.
pub fn settings(text: []const u8) -> bool {
    var given = false
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        var space: usize = 0
        while space < line.length && line[space] != 32 { space += 1 }
        if space < line.length {
            const key = line[0..space]
            var value: Ip = undefined
            if parseIp(line[space + 1..line.length], &value) {
                if sameText(key, "address") {
                    config.address = value
                    config.source = Source.SETTINGS
                    given = true
                }
                if sameText(key, "netmask") { config.mask = value }
                if sameText(key, "gateway") { config.gateway = value }
                if sameText(key, "nameserver") { config.nameServer = value }
            }
        }
        at = end + 1
    }
    return given
}

fn sameText(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

// "a.b.c.d" (blanks around it ignored).
pub fn parseIp(text: []const u8, into: *Ip) -> bool {
    var part: usize = 0
    var value: usize = 0
    var digits: usize = 0
    var k: usize = 0
    while k < text.length {
        const c = text[k]
        if c >= 48 && c <= 57 {
            value = value * 10 + @intCast(usize, c - 48)
            digits += 1
            if value > 255 { return false }
        } else if c == 46 {
            if digits == 0 || part == 3 { return false }
            into.*[part] = @intCast(u8, value)
            part += 1
            value = 0
            digits = 0
        } else if c != 32 && c != 9 && c != 13 {
            return false
        }
        k += 1
    }
    if part != 3 || digits == 0 { return false }
    into.*[3] = @intCast(u8, value)
    return true
}

pub fn writeIp(ip: Ip, out: console.Console) -> void {
    out.decimal(@intCast(usize, ip[0]))
    out.write(".")
    out.decimal(@intCast(usize, ip[1]))
    out.write(".")
    out.decimal(@intCast(usize, ip[2]))
    out.write(".")
    out.decimal(@intCast(usize, ip[3]))
}

pub fn writeMac(mac: Mac, out: console.Console) -> void {
    var k: usize = 0
    while k < 6 {
        if k > 0 { out.write(":") }
        out.hexByte(@intCast(usize, mac[k]))
        k += 1
    }
}

// ---- byte order ----

pub fn be16(bytes: [*]const u8, at: usize) -> usize { return (@intCast(usize, bytes[at]) << 8) | @intCast(usize, bytes[at + 1]) }
pub fn be32(bytes: [*]const u8, at: usize) -> usize { return (be16(bytes, at) << 16) | be16(bytes, at + 2) }
pub fn putBe16(bytes: [*]u8, at: usize, value: usize) -> void {
    bytes[at] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 1] = @intCast(u8, value & 255)
}
pub fn putBe32(bytes: [*]u8, at: usize, value: usize) -> void {
    putBe16(bytes, at, (value >> 16) & 0xFFFF)
    putBe16(bytes, at + 2, value & 0xFFFF)
}
pub fn putIp(bytes: [*]u8, at: usize, ip: Ip) -> void {
    bytes[at] = ip[0]
    bytes[at + 1] = ip[1]
    bytes[at + 2] = ip[2]
    bytes[at + 3] = ip[3]
}
pub fn getIp(bytes: [*]const u8, at: usize) -> Ip { return [4]u8{ bytes[at], bytes[at + 1], bytes[at + 2], bytes[at + 3] } }
// The same into `into` (no value on the way: an Ip that is returned and
// then assigned to a var is a copy from the aggregate arena each time).
pub fn readIp(bytes: [*]const u8, at: usize, into: *Ip) -> void {
    into.*[0] = bytes[at]
    into.*[1] = bytes[at + 1]
    into.*[2] = bytes[at + 2]
    into.*[3] = bytes[at + 3]
}
pub fn clearIp(into: *Ip) -> void {
    into.*[0] = 0
    into.*[1] = 0
    into.*[2] = 0
    into.*[3] = 0
}

// The Internet checksum of `length` bytes, folded, starting from
// `initial` (a pseudo-header's sum, for TCP and UDP).
pub fn checksum(bytes: [*]const u8, length: usize, initial: usize) -> usize {
    var sum = initial
    var k: usize = 0
    while k + 1 < length {
        sum += be16(bytes, k)
        k += 2
    }
    if k < length { sum += @intCast(usize, bytes[k]) << 8 }
    while sum >> 16 != 0 { sum = (sum & 0xFFFF) + (sum >> 16) }
    return (~sum) & 0xFFFF
}

// The pseudo-header's sum for TCP or UDP (added as the checksum's
// `initial`, not folded).
pub fn pseudoSum(source: Ip, destination: Ip, protocol: u8, length: usize) -> usize {
    return be16(&source, 0) + be16(&source, 2) + be16(&destination, 0) + be16(&destination, 2) + @intCast(usize, protocol) + length
}

// ---- Ethernet ----

fn sendFrame(destination: *const Mac, kind: usize, length: usize) -> bool {
    const f: [*]u8 = &frame
    var k: usize = 0
    while k < 6 {
        f[k] = destination.*[k]
        f[6 + k] = netdev.macByte(k)
        k += 1
    }
    putBe16(f, 12, kind)
    var total = ETHERNET_HEADER + length
    if total < 60 {
        Bytes.fill(Bytes.pointer(@intFromPtr(f) + total), 60 - total, 0)
        total = 60
    }
    return netdev.transmit(f, total)
}

// A frame from the device.
pub fn receive(bytes: [*]const u8, length: usize) -> void {
    if length < ETHERNET_HEADER { return }
    const kind = be16(bytes, 12)
    const payload = Bytes.pointer(@intFromPtr(bytes) + ETHERNET_HEADER)
    if kind == TYPE_ARP { arpReceive(payload, length - ETHERNET_HEADER) }
    if kind == TYPE_IPV4 { ipReceive(payload, length - ETHERNET_HEADER) }
}

// ---- ARP ----

// Static data (a module-level const array is built where it is used, and
// a var copy of it comes from the aggregate arena).
var broadcastMac: Mac = [6]u8{ 255, 255, 255, 255, 255, 255 } // (constant)
var noMac: Mac = [6]u8{ 0, 0, 0, 0, 0, 0 } // (constant)
pub var BROADCAST_IP: Ip = [4]u8{ 255, 255, 255, 255 } // (constant)
// An ARP message is made in a frame of its own: `frame` may hold a packet
// its maker has filled (neighbour asks from inside sendFrom).
var arpFrame: [64]u8 = undefined // (per run)

// An ARP message (`operation` 1: a request, 2: a reply) to `destination`.
fn arpSend(operation: usize, destination: *const Mac, targetMac: *const Mac, targetIp: Ip) -> void {
    const f: [*]u8 = &arpFrame
    var k: usize = 0
    while k < 6 {
        f[k] = destination.*[k]
        f[6 + k] = netdev.macByte(k)
        f[22 + k] = netdev.macByte(k)
        f[32 + k] = targetMac.*[k]
        k += 1
    }
    putBe16(f, 12, TYPE_ARP)
    putBe16(f, 14, 1) // Ethernet
    putBe16(f, 16, TYPE_IPV4)
    f[18] = 6
    f[19] = 4
    putBe16(f, 20, operation)
    putIp(f, 28, config.address)
    putIp(f, 38, targetIp)
    Bytes.fill(Bytes.pointer(@intFromPtr(f) + 42), 18, 0)
    _ = netdev.transmit(f, 60)
}

fn learn(ip: Ip, mac: Mac) -> void {
    var free: usize = MAX_NEIGHBOURS
    var oldest: usize = 0
    var k: usize = 0
    while k < MAX_NEIGHBOURS {
        if neighbours[k].valid && same(neighbours[k].ip, ip) {
            neighbours[k].mac = mac
            neighbours[k].when = clock.system().monotonic()
            return
        }
        if !neighbours[k].valid && free == MAX_NEIGHBOURS { free = k }
        if neighbours[k].when < neighbours[oldest].when { oldest = k }
        k += 1
    }
    const slot = if free < MAX_NEIGHBOURS { free } else { oldest }
    neighbours[slot].valid = true
    neighbours[slot].ip = ip
    neighbours[slot].mac = mac
    neighbours[slot].when = clock.system().monotonic()
}

// The neighbour's address: (whether it is known, its slot). Unknown:
// asked for (the packet is dropped; the sender tries again).
fn neighbour(ip: Ip) -> (bool, usize) {
    var k: usize = 0
    while k < MAX_NEIGHBOURS {
        if neighbours[k].valid && same(neighbours[k].ip, ip) {
            if clock.system().monotonic() - neighbours[k].when > NEIGHBOUR_LIFE { arpRequest(ip) }
            return -> (true, k)
        }
        k += 1
    }
    arpRequest(ip)
    return -> (false, 0)
}

fn arpRequest(ip: Ip) -> void { arpSend(1, &broadcastMac, &noMac, ip) }

// A neighbour's hardware address asked for ahead of the first packet to
// it (DHCP: the gateway it gave).
pub fn askFor(ip: Ip) -> void { arpRequest(ip) }

fn known(ip: Ip) -> bool {
    var k: usize = 0
    while k < MAX_NEIGHBOURS {
        if neighbours[k].valid && same(neighbours[k].ip, ip) { return true }
        k += 1
    }
    return false
}

fn arpReceive(bytes: [*]const u8, length: usize) -> void {
    if length < 28 || be16(bytes, 2) != TYPE_IPV4 || bytes[4] != 6 || bytes[5] != 4 { return }
    const operation = be16(bytes, 6)
    var senderMac: Mac = undefined
    var k: usize = 0
    while k < 6 {
        senderMac[k] = bytes[8 + k]
        k += 1
    }
    const senderIp = getIp(bytes, 14)
    const targetIp = getIp(bytes, 24)
    // Only what is said to us, or about a neighbour we already have, is
    // kept: with every broadcast request of a busy network learnt, the
    // gateway is pushed out of the table's 16 places again and again.
    if same(targetIp, config.address) || known(senderIp) { learn(senderIp, senderMac) }
    if operation == 1 && same(targetIp, config.address) {
        // A request for our address: the reply.
        arpSend(2, &senderMac, &senderMac, senderIp)
    }
}

// ---- IPv4 ----

var identification: usize = 0 // (per run)

// Whether `ip` is on our subnet.
fn local(ip: Ip) -> bool {
    var k: usize = 0
    while k < 4 {
        if (ip[k] & config.mask[k]) != (config.address[k] & config.mask[k]) { return false }
        k += 1
    }
    return true
}

// Room for a packet's payload in the frame being made (after the IP
// header): the caller fills it, then `send`s.
pub fn payloadArea() -> [*]u8 { return Bytes.pointer(@intFromPtr(&frame) + ETHERNET_HEADER + IP_HEADER) }

// The payload (`length` bytes at payloadArea) sent to `destination` as
// `protocol`; false when it is too long, the neighbour is unknown yet,
// or the device is busy.
pub fn send(protocol: u8, destination: Ip, length: usize) -> bool { return sendFrom(config.address, protocol, destination, length) }

// The same from `source` (0.0.0.0 while DHCP runs).
pub fn sendFrom(source: Ip, protocol: u8, destination: Ip, length: usize) -> bool {
    if !config.up || length > MAX_PAYLOAD { return false }
    const hop = if local(destination) || same(destination, ipOf(255, 255, 255, 255)) { destination } else { config.gateway }
    var mac: *const Mac = &broadcastMac
    if !same(hop, ipOf(255, 255, 255, 255)) && !same(destination, config.address) {
        const found = neighbour(hop)
        if !found.0 { return false }
        mac = &neighbours[found.1].mac
    }
    const h: [*]u8 = Bytes.pointer(@intFromPtr(&frame) + ETHERNET_HEADER)
    h[0] = 0x45
    h[1] = 0
    putBe16(h, 2, IP_HEADER + length)
    putBe16(h, 4, identification & 0xFFFF)
    identification += 1
    putBe16(h, 6, 0x4000) // don't fragment
    h[8] = 64
    h[9] = protocol
    putBe16(h, 10, 0)
    putIp(h, 12, source)
    putIp(h, 16, destination)
    putBe16(h, 10, checksum(h, IP_HEADER, 0))
    if same(destination, config.address) {
        // To ourselves: taken in at once (from a copy: the receiver's
        // answers use the frame).
        Bytes.copy(&loopback, h, IP_HEADER + length)
        ipReceive(&loopback, IP_HEADER + length)
        return true
    }
    return sendFrame(mac, TYPE_IPV4, IP_HEADER + length)
}

fn ipReceive(bytes: [*]const u8, length: usize) -> void {
    if length < IP_HEADER || bytes[0] >> 4 != 4 { return }
    const headerLength = @intCast(usize, bytes[0] & 15) * 4
    const total = be16(bytes, 2)
    if headerLength < IP_HEADER || total < headerLength || total > length { return }
    if checksum(bytes, headerLength, 0) != 0 { return }
    // A fragment: not taken.
    if be16(bytes, 6) & 0x3FFF != 0 { return }
    const destination = getIp(bytes, 16)
    if !same(destination, config.address) && !same(destination, ipOf(255, 255, 255, 255)) { return }
    const source = getIp(bytes, 12)
    const protocol = bytes[9]
    const payload = Bytes.pointer(@intFromPtr(bytes) + headerLength)
    const payloadLength = total - headerLength
    if protocol == PROTOCOL_ICMP { icmpReceive(source, payload, payloadLength) }
    if protocol == PROTOCOL_UDP { udp.receive(source, destination, payload, payloadLength) }
    if protocol == PROTOCOL_TCP { tcp.receive(source, destination, payload, payloadLength) }
}

// ---- ICMP ----

fn icmpReceive(source: Ip, bytes: [*]const u8, length: usize) -> void {
    if length < 8 || checksum(bytes, length, 0) != 0 { return }
    if bytes[0] == 8 && bytes[1] == 0 {
        // An echo request: the reply, the data as it came.
        const reply = payloadArea()
        Bytes.copy(reply, bytes, length)
        reply[0] = 0
        putBe16(reply, 2, 0)
        putBe16(reply, 2, checksum(reply, length, 0))
        _ = send(PROTOCOL_ICMP, source, length)
        // (Nothing more is read of `bytes`: a request of our own came
        // in the loopback's copy, which holds the reply by now, and read
        // on as one, the reply was given to its ping socket twice.)
        return
    }
    if bytes[0] == 0 && bytes[1] == 0 {
        echoReplies += 1
        lastEchoFrom = source
        // A ping socket's (its identifier).
        sockets.Sockets.deliverDatagram(sockets.Kind.icmp, be16(bytes, 4), source, 0, bytes, length)
        return
    }
    if (bytes[0] == 3 || bytes[0] == 11) && length >= 8 + IP_HEADER + 8 {
        // A router's or a host's word that a packet was not delivered
        // (destination unreachable, time exceeded): the packet's IP
        // header and first 8 bytes follow. About an echo request of
        // ours: to its ping socket (the identifier in those bytes),
        // which reads the message as it came and can say why there is
        // no answer.
        const about = Bytes.pointer(@intFromPtr(bytes) + 8)
        const header = @intCast(usize, about[0] & 15) * 4
        if header >= IP_HEADER && length >= 8 + header + 8 && about[9] == PROTOCOL_ICMP && about[header] == 8 && same(getIp(about, 12), config.address) {
            sockets.Sockets.deliverDatagram(sockets.Kind.icmp, be16(about, header + 4), source, 0, bytes, length)
        }
    }
}

// An echo request a ping socket sends (`message`: the ICMP message as
// the program made it; the identifier becomes the socket's port, the
// checksum is made here).
pub fn sendEcho(identifier: usize, destination: Ip, message: [*]const u8, length: usize) -> bool {
    if length < 8 || length > MAX_PAYLOAD { return false }
    const request = payloadArea()
    Bytes.copy(request, message, length)
    request[0] = 8
    request[1] = 0
    putBe16(request, 2, 0)
    putBe16(request, 4, identifier)
    putBe16(request, 2, checksum(request, length, 0))
    // 127.0.0.0/8 is this machine and never goes onto the wire (it went
    // to the gateway). The stack has one address and no loopback one:
    // the request goes to that address, the stack's way to itself, and
    // the reply comes from it.
    if destination[0] == 127 { return send(PROTOCOL_ICMP, config.address, length) }
    return send(PROTOCOL_ICMP, destination, length)
}

// The timers (every tick of the first processor's timer).
pub fn tick() -> void {
    tcp.tick()
    dhcp.tick()
}

// An echo request (`identifier`, `sequence`, 32 bytes of data) to
// `destination`; false when it could not go.
pub fn ping(destination: Ip, identifier: usize, sequence: usize) -> bool {
    const request = payloadArea()
    request[0] = 8
    request[1] = 0
    putBe16(request, 2, 0)
    putBe16(request, 4, identifier)
    putBe16(request, 6, sequence)
    var k: usize = 0
    while k < 32 {
        request[8 + k] = @intCast(u8, 48 + k % 10)
        k += 1
    }
    putBe16(request, 2, checksum(request, 40, 0))
    return send(PROTOCOL_ICMP, destination, 40)
}

// The device's frames taken in now (where the stack waits for an
// answer without the interrupt: the boot's self-test).
pub fn poll() -> void { netdev.receive() }
