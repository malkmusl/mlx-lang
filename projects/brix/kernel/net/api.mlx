// What a call does to a socket (sockets.mlx) and, for a TCP socket, its
// connection (tcp.mlx, at the same index): opened, connected, listened
// on, accepted, sent to, received from, let go. (The two modules do not
// import each other; this one joins them.)
const stack = @import("./stack.mlx")
const sockets = @import("./sockets.mlx")
const tcp = @import("./tcp.mlx")
const Status = @import("../status.mlx").Status

pub const Kind = sockets.Kind

fn table() -> *sockets.Sockets { return sockets.sockets() }

// A socket of `kind`: its index, or a Status.
pub fn open(kind: Kind) -> isize {
    const index = table().open(kind)
    if index < 0 { return index }
    if kind == Kind.tcp && !tcp.connectionAt(@bitCast(usize, index)).init(@bitCast(usize, index)) {
        table().abandon(@bitCast(usize, index))
        return Status.no_memory
    }
    return index
}

pub fn retain(index: usize) -> void { table().retain(index) }

// A descriptor let go: the last one closes the socket (a TCP connection
// takes its leave: the socket stays until it is done).
pub fn release(index: usize) -> void {
    if !table().release(index) { return }
    if table().at(index).*.kind == Kind.tcp {
        const c = tcp.connectionAt(index)
        c.close()
        // (The close may end the connection at once, through the
        // loopback: the socket is gone then.)
        if table().at(index).*.kind == Kind.free { return }
        if !c.done() {
            // (Nobody's from now on: it ends within its time, or is reset.)
            c.letGo()
            return
        }
        c.deinit()
    }
    table().drop(index)
}

// The socket connected to `remote`:`port` (UDP: its peer; TCP: the
// connection opened, made when the handshake ends); Status codes.
pub fn connect(index: usize, remote: stack.Ip, port: usize) -> isize {
    if !table().setPeer(index, remote, port) { return Status.too_many }
    const s = table().at(index)
    if s.*.kind != Kind.tcp { return 0 }
    return tcp.connectionAt(index).open(s.*.localPort, remote, port)
}

pub fn listen(index: usize) -> isize {
    const s = table().at(index)
    if s.*.kind != Kind.tcp || s.*.localPort == 0 { return Status.invalid }
    table().setListening(index)
    tcp.connectionAt(index).listen(s.*.localPort)
    return 0
}

// The next connection of a listening socket: a new socket's index, or
// would_block.
pub fn accept(index: usize) -> isize {
    if !table().at(index).*.listening { return Status.invalid }
    return tcp.connectionAt(index).takePending()
}

// Bytes to the stream: how many were taken into the send ring (at least
// one), would_block when it is full, peer_gone when the connection is
// closed.
pub fn sendBytes(index: usize, data: [*]const u8, length: usize) -> isize {
    const s = table().at(index)
    if s.*.pendingError != 0 { return table().takeError(index) }
    return tcp.connectionAt(index).send(data, length)
}

// Bytes of the stream into `into` (sockets.receiveBytes), the connection
// told of the room made.
pub fn receiveBytes(index: usize, into: [*]u8, capacity: usize) -> isize {
    const got = table().receiveBytes(index, into, capacity)
    if got > 0 { tcp.connectionAt(index).windowOpened() }
    return got
}

pub fn shutdown(index: usize) -> void {
    if table().at(index).*.kind == Kind.tcp { tcp.connectionAt(index).close() }
}

pub fn readable(index: usize) -> bool {
    const s = table().at(index)
    if s.*.kind != Kind.tcp { return s.*.count >= sockets.RECORD }
    if s.*.listening { return tcp.connectionAt(index).hasPending() }
    return s.*.count > 0 || s.*.peerClosed || s.*.pendingError != 0
}

pub fn writable(index: usize) -> bool {
    const s = table().at(index)
    if s.*.kind != Kind.tcp { return true }
    if s.*.pendingError != 0 { return true }
    return s.*.connected && tcp.connectionAt(index).sendRoom() > 0
}
