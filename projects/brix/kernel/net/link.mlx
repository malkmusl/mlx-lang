// A network link as programs see it: /devices/net0 is a node whose read
// gives the link's record (spec/04-stdlib/os/brix.xml, <NetworkLink>):
// what the device says (its hardware address, its driver, whether the
// cable is in, its speed, the frames it took and sent) and what the stack
// has for it (the address with its mask, the gateway, the name server,
// whether DHCP or the settings file gave them, and how long DHCP's lease
// still runs). There is one link (netdev.mlx's one device); a machine
// without a network device has no node. files.mlx serves the read.
const netdev = @import("../netdev.mlx")
const Bytes = @import("../bytes.mlx").Bytes
const stack = @import("./stack.mlx")
const dhcp = @import("./dhcp.mlx")

// The record's bytes, which is also its first word: a later kernel's
// record may be longer, and a program reads what it knows of it. (It was
// 64 bytes before the lease's two words: a program that asks for 64 gets
// those, as they were.)
pub const RECORD: usize = 72

// The flags: the link is up; DHCP is asking for an address.
const LINK_UP: usize = 0x1
const ASKING: usize = 0x2

// The record into `into` (RECORD bytes), as things are now. Without an
// address (DHCP has not answered, or its lease ended) the four addresses
// are 0.0.0.0, as the stack has them; so is a gateway or a name server
// the configuration came without.
pub fn describe(into: [*]u8) -> void {
    Bytes.fill(into, RECORD, 0)
    const config = stack.configuration()
    var flags: usize = 0
    if netdev.linkUp() { flags |= LINK_UP }
    if dhcp.running() { flags |= ASKING }
    Bytes.write32(into, 0, RECORD)
    Bytes.write32(into, 4, flags)
    Bytes.write32(into, 8, config.*.source)
    Bytes.write32(into, 12, netdev.speed())
    var k: usize = 0
    while k < 6 {
        into[16 + k] = netdev.macByte(k)
        k += 1
    }
    const driver = netdev.driver()
    k = 0
    while k < driver.length && k < 8 {
        into[24 + k] = driver[k]
        k += 1
    }
    stack.putIp(into, 32, config.*.address)
    stack.putIp(into, 36, config.*.mask)
    stack.putIp(into, 40, config.*.gateway)
    stack.putIp(into, 44, config.*.nameServer)
    Bytes.write64(into, 48, netdev.received())
    Bytes.write64(into, 56, netdev.sent())
    // DHCP's lease: the seconds it still runs and the seconds it was
    // given for (0: no lease; all ones: one that does not end).
    Bytes.write32(into, 64, dhcp.leaseLeft())
    Bytes.write32(into, 68, dhcp.leaseTime())
}
