// UDP: datagram sockets (sockets.mlx's) with a local port, a queue of
// the datagrams received (their source and the bytes; RING bytes in
// all) and datagrams sent through the stack.
const stack = @import("./stack.mlx")
const Bytes = @import("../bytes.mlx").Bytes

pub fn init() -> void {}

// A datagram for one of the sockets (sockets.mlx takes it), or for DHCP
// (`dhcpOnly`: for nothing else, while the stack has no address).
pub fn receive(source: stack.Ip, destination: stack.Ip, bytes: [*]const u8, length: usize, dhcpOnly: bool) -> void {
    if length < 8 { return }
    const sourcePort = stack.be16(bytes, 0)
    const port = stack.be16(bytes, 2)
    const dataLength = stack.be16(bytes, 4)
    if dataLength < 8 || dataLength > length { return }
    if stack.be16(bytes, 6) != 0 && stack.checksum(bytes, dataLength, stack.pseudoSum(source, destination, stack.PROTOCOL_UDP, dataLength)) != 0 { return }
    if port == dhcp.CLIENT_PORT && sourcePort == 67 {
        dhcp.receive(Bytes.pointer(@intFromPtr(bytes) + 8), dataLength - 8)
        return
    }
    if dhcpOnly { return }
    sockets.Sockets.deliverDatagram(sockets.Kind.udp, port, source, sourcePort, Bytes.pointer(@intFromPtr(bytes) + 8), dataLength - 8)
}

// `length` bytes from `data` to `destination`:`port` from `sourcePort`;
// false when it could not go (no address to send from among the
// reasons: only this machine itself, 127.0.0.0/8, is reached without
// one).
pub fn send(sourcePort: usize, destination: stack.Ip, port: usize, data: [*]const u8, length: usize) -> bool {
    if !stack.configured() && !stack.itself(destination) { return false }
    return sendFrom(stack.sourceFor(destination), sourcePort, destination, port, data, length)
}

// The same from `source` (DHCP: 0.0.0.0 while it has no address).
pub fn sendFrom(source: stack.Ip, sourcePort: usize, destination: stack.Ip, port: usize, data: [*]const u8, length: usize) -> bool {
    if length + 8 > stack.MAX_PAYLOAD { return false }
    const d = stack.payloadArea()
    stack.putBe16(d, 0, sourcePort)
    stack.putBe16(d, 2, port)
    stack.putBe16(d, 4, length + 8)
    stack.putBe16(d, 6, 0)
    var k: usize = 0
    while k < length {
        d[8 + k] = data[k]
        k += 1
    }
    var sum = stack.checksum(d, length + 8, stack.pseudoSum(source, destination, stack.PROTOCOL_UDP, length + 8))
    if sum == 0 { sum = 0xFFFF }
    stack.putBe16(d, 6, sum)
    return stack.sendFrom(source, stack.PROTOCOL_UDP, destination, length + 8)
}

const sockets = @import("./sockets.mlx")
const dhcp = @import("./dhcp.mlx")
