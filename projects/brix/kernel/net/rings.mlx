// The rings' memory: a socket's receive ring and a connection's send ring
// are RING bytes each, in frames one after the other. The kernel hands
// frames out in a run only from the memory it never used before
// (memory.Frames.allocateContiguous), and what is given back comes back
// frame by frame: a ring that was freed was lost for every later ring.
// Each socket opened took 16 KiB, each TCP connection 32 KiB of the
// machine's unused memory for good, and after as many connections as that
// memory had rings (5000 on a machine of 256 MiB: three minutes of
// requests to a listening program) no socket could be opened any more,
// though the memory counted as free. A ring let go is kept here for the
// next socket instead. There are never more rings than two a socket, so
// the ones kept are a megabyte at most.
const memory = @import("../memory.mlx")
const layout = @import("../../layout.mlx")
const Bytes = @import("../bytes.mlx").Bytes
const limits = @import("./limits.mlx")
const Page = memory.Page

const PAGES: usize = limits.RING / Page.SIZE
// A receive ring and a send ring a socket.
const MAX_KEPT: usize = 2 * limits.MAX_SOCKETS

var kept: [MAX_KEPT]usize = undefined // (per run)
var keptCount: usize = 0 // (per run)

// A ring's memory, zeroed (its physical address); 0 when memory is out.
pub fn take() -> usize {
    if keptCount == 0 { return memory.allFrames().allocateContiguous(PAGES) }
    keptCount -= 1
    const ring = kept[keptCount]
    Bytes.zeroWords(layout.Memory.virtual(ring), limits.RING)
    return ring
}

// A ring's memory let go: kept for the next ring.
pub fn give(ring: usize) -> void {
    if ring == 0 { return }
    if keptCount < MAX_KEPT {
        kept[keptCount] = ring
        keptCount += 1
        return
    }
    // (More than there can be: back to the frames.)
    var k: usize = 0
    while k < PAGES {
        memory.allFrames().free(ring + k * Page.SIZE)
        k += 1
    }
}
