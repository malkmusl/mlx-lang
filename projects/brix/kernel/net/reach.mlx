// What this machine reaches, worked out from its configuration alone:
// whether four bytes are a netmask, which addresses are everyone's or a
// group's (no one host's), and whether a packet to a destination can
// leave the machine as things are (and when not, what stands in the
// way). This file knows no kernel, so the same code runs in a test built
// for the host (tests/464_net_reach_runtime.mlx); stack.mlx is the
// kernel's side.
// Addresses are four bytes in network order.

// Whether `mask` is a netmask: one bits at the front, zero bits behind
// them, and not zero bits alone (0.0.0.0 would make every address a
// neighbour). 255.255.255.255 is one: a machine with only itself on its
// subnet.
pub fn maskValid(mask: [*]const u8) -> bool {
    const bits = (@intCast(usize, mask[0]) << 24) | (@intCast(usize, mask[1]) << 16) | (@intCast(usize, mask[2]) << 8) | @intCast(usize, mask[3])
    if bits == 0 { return false }
    // (The zero bits, as a number: one less than a power of two when
    // they are all at the end.)
    const rest = (~bits) & 0xFFFFFFFF
    return rest & (rest + 1) == 0
}

// Whether `ip` is 255.255.255.255: everyone on the wire.
pub fn all(ip: [*]const u8) -> bool { return ip[0] == 255 && ip[1] == 255 && ip[2] == 255 && ip[3] == 255 }

// Whether `ip` is a group's address, or of what lies beyond the groups
// (224.0.0.0 and above: multicast, and the addresses kept back, with
// 255.255.255.255 among them): no one host has it.
pub fn group(ip: [*]const u8) -> bool { return ip[0] >= 224 }

// Whether `ip` is the address for everyone on the subnet of `address`
// and `mask`: the subnet's last, its host bits all ones. A subnet of one
// or two addresses (255.255.255.255, 255.255.255.254) has none.
pub fn subnetAll(address: [*]const u8, mask: [*]const u8, ip: [*]const u8) -> bool {
    if mask[0] == 255 && mask[1] == 255 && mask[2] == 255 && mask[3] >= 254 { return false }
    var k: usize = 0
    while k < 4 {
        if (ip[k] & mask[k]) != (address[k] & mask[k]) { return false }
        if (ip[k] | mask[k]) != 255 { return false }
        k += 1
    }
    return true
}

// Whether `ip` is on the subnet of `address` and `mask`.
pub fn local(address: [*]const u8, mask: [*]const u8, ip: [*]const u8) -> bool {
    var k: usize = 0
    while k < 4 {
        if (ip[k] & mask[k]) != (address[k] & mask[k]) { return false }
        k += 1
    }
    return true
}

// The way a packet takes, or what stands in it: there is no network
// device; its link is down (no cable, or no partner at its end); the
// machine has no address; the destination is not on the own subnet and
// there is no gateway.
pub const Way = enum(u8) { open, no_device, link_down, no_address, no_gateway }

// The way to `destination` for a machine with a device or none
// (`device`), its link up or down (`link`), with or without an address
// (`configured`; then `address`, `mask` and `gateway`, 0.0.0.0 for no
// gateway). 127.0.0.0/8 and the machine's own address are the machine
// itself, which needs none of them. The first thing in the way is said:
// the device before the link, the link before the address (an address
// often is missing because the link is down).
pub fn way(device: bool, link: bool, configured: bool, address: [*]const u8, mask: [*]const u8, gateway: [*]const u8, destination: [*]const u8) -> Way {
    if destination[0] == 127 { return Way.open }
    if configured && destination[0] == address[0] && destination[1] == address[1] && destination[2] == address[2] && destination[3] == address[3] { return Way.open }
    if !device { return Way.no_device }
    if !link { return Way.link_down }
    if !configured { return Way.no_address }
    if all(destination) || local(address, mask, destination) { return Way.open }
    if gateway[0] == 0 && gateway[1] == 0 && gateway[2] == 0 && gateway[3] == 0 { return Way.no_gateway }
    return Way.open
}
