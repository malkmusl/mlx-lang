// DHCP (RFC 2131), the client: DISCOVER broadcast from 0.0.0.0 (sent
// again every second, five times), the OFFER's address asked for with a
// REQUEST, the ACK's address, netmask, router and name server taken as
// the configuration (resolv.conf written again). The lease is not
// renewed (QEMU's user network gives long ones).
const clock = @import("../clock.mlx")
const netdev = @import("../netdev.mlx")
const stack = @import("./stack.mlx")
const udp = @import("./udp.mlx")
const settings = @import("./settings.mlx")

pub const CLIENT_PORT: usize = 68
const SERVER_PORT: usize = 67
const DISCOVER: u8 = 1
const OFFER: u8 = 2
const REQUEST: u8 = 3
const ACK: u8 = 5
const MAGIC: usize = 0x63825363
const SECOND: usize = 1000000000
const TRIES: usize = 5

pub const State = enum(u8) { idle, discovering, requesting, bound, given_up }

var state: State = State.idle // (per run)
var xid: usize = 0 // (per run)
var deadline: usize = 0 // (per run)
var tries: usize = 0 // (per run)
var offered: stack.Ip = undefined // (per run)
var server: stack.Ip = undefined // (per run)

pub fn bound() -> bool { return state == State.bound }
pub fn running() -> bool { return state == State.discovering || state == State.requesting }

pub fn start() -> void {
    xid = clock.system().monotonic() & 0xFFFFFFFF
    tries = 0
    state = State.discovering
    discover()
}

// A message's fixed part and the options' start into `m`: the length so
// far.
fn message(m: [*]u8, kind: u8) -> usize {
    var k: usize = 0
    while k < 240 {
        m[k] = 0
        k += 1
    }
    m[0] = 1 // a request
    m[1] = 1 // Ethernet
    m[2] = 6
    stack.putBe32(m, 4, xid)
    stack.putBe16(m, 10, 0x8000) // broadcast the answer
    const mac = netdev.mac()
    k = 0
    while k < 6 {
        m[28 + k] = mac[k]
        k += 1
    }
    stack.putBe32(m, 236, MAGIC)
    m[240] = 53
    m[241] = 1
    m[242] = kind
    return 243
}

fn discover() -> void {
    var m: [320]u8 = undefined
    var length = message(&m, DISCOVER)
    m[length] = 55 // what is wanted: subnet mask, router, name server
    m[length + 1] = 3
    m[length + 2] = 1
    m[length + 3] = 3
    m[length + 4] = 6
    m[length + 5] = 255
    length += 6
    _ = udp.sendFrom(stack.ipOf(0, 0, 0, 0), CLIENT_PORT, stack.BROADCAST_IP, SERVER_PORT, &m, length)
    deadline = clock.system().monotonic() + SECOND
    tries += 1
}

fn request() -> void {
    var m: [320]u8 = undefined
    var length = message(&m, REQUEST)
    m[length] = 50 // the address asked for
    m[length + 1] = 4
    stack.putIp(&m, length + 2, offered)
    m[length + 6] = 54 // the server
    m[length + 7] = 4
    stack.putIp(&m, length + 8, server)
    m[length + 12] = 255
    length += 13
    _ = udp.sendFrom(stack.ipOf(0, 0, 0, 0), CLIENT_PORT, stack.BROADCAST_IP, SERVER_PORT, &m, length)
    deadline = clock.system().monotonic() + SECOND
    tries += 1
}

// A message on port 68.
pub fn receive(bytes: [*]const u8, length: usize) -> void {
    if !running() || length < 244 || bytes[0] != 2 || stack.be32(bytes, 4) != xid || stack.be32(bytes, 236) != MAGIC { return }
    var kind: u8 = 0
    // (Filled in place: `var mask = config.mask` and `mask = getIp(...)`
    // each took 8 bytes of the aggregate arena, the latter per option.)
    const now = stack.configuration()
    var mask: stack.Ip = undefined
    var router: stack.Ip = undefined
    var nameServer: stack.Ip = undefined
    var serverId: stack.Ip = undefined
    stack.readIp(&now.*.mask, 0, &mask)
    stack.readIp(&now.*.gateway, 0, &router)
    stack.readIp(&now.*.nameServer, 0, &nameServer)
    stack.clearIp(&serverId)
    var at: usize = 240
    while at + 1 < length {
        const option = bytes[at]
        if option == 255 { break }
        if option == 0 {
            at += 1
            continue
        }
        const size = @intCast(usize, bytes[at + 1])
        if at + 2 + size > length { break }
        if option == 53 && size == 1 { kind = bytes[at + 2] }
        if option == 1 && size == 4 { stack.readIp(bytes, at + 2, &mask) }
        if option == 3 && size >= 4 { stack.readIp(bytes, at + 2, &router) }
        if option == 6 && size >= 4 { stack.readIp(bytes, at + 2, &nameServer) }
        if option == 54 && size == 4 { stack.readIp(bytes, at + 2, &serverId) }
        at += 2 + size
    }
    if state == State.discovering && kind == OFFER {
        offered = stack.getIp(bytes, 16)
        server = serverId
        state = State.requesting
        tries = 0
        request()
        return
    }
    if state == State.requesting && kind == ACK {
        const config = stack.configuration()
        config.*.address = stack.getIp(bytes, 16)
        config.*.mask = mask
        config.*.gateway = router
        config.*.nameServer = nameServer
        config.*.source = stack.Source.DHCP
        state = State.bound
        // The gateway's hardware address asked for now: the first packet
        // through it would be dropped for want of it (a connect's first
        // second, the first name looked up).
        stack.askFor(config.*.gateway)
        settings.writeResolvConf()
    }
}

// Every tick: a message sent again when its answer did not come.
pub fn tick() -> void {
    if !running() || clock.system().monotonic() < deadline { return }
    if tries >= TRIES {
        // Not for good: a switch port may take half a minute to forward
        // (spanning tree), a link seconds to come up. From the start
        // again after a pause.
        state = State.discovering
        tries = 0
        deadline = clock.system().monotonic() + 10 * SECOND
        return
    }
    if state == State.discovering { discover() } else { request() }
}
