// DHCP in the kernel: the client (lease.mlx, which knows no kernel) on
// the kernel's clock and the stack's UDP. What the client says is done
// here: an answer's address, netmask, router and name server become the
// stack's configuration (resolv.conf written again), a lease that ended
// or was refused takes the address away again (the stack has none then
// and sends nothing but the client's own messages), and each of the two
// is said in the kernel's log once the boot has said its line. The
// client's timers run on the timer's tick (stack.tick): nothing waits.
// When the link comes up (the stack says so: linkCame) the client begins
// again: while an address is asked for, the next DISCOVER goes at once;
// with an address, its lease is asked for anew, of everyone (the cable
// may be in another network now).
const clock = @import("../clock.mlx")
const console = @import("../console.mlx")
const netdev = @import("../netdev.mlx")
const stack = @import("./stack.mlx")
const udp = @import("./udp.mlx")
const settings = @import("./settings.mlx")
const lease = @import("./lease.mlx")

pub const CLIENT_PORT: usize = lease.CLIENT_PORT

var client: lease.Client = undefined // (per run)
// Whether the client runs (not with a static configuration).
var started = false // (per run)
// Whether the boot has said its line: from then on a change is said.
var announced = false // (per run)

fn now() -> usize { return clock.system().monotonic() }

// The client's message as UDP from port 68 to the server's port 67.
fn send(message: [*]const u8, length: usize, source: [*]const u8, destination: [*]const u8) -> void {
    _ = udp.sendFrom(stack.getIp(source, 0), CLIENT_PORT, stack.getIp(destination, 0), lease.SERVER_PORT, message, length)
}

// Whether DHCP gave the address the stack has.
pub fn bound() -> bool { return started && client.has() }
// Whether DHCP is asking for an address (there is none).
pub fn running() -> bool { return started && client.asking() }

// The seconds the lease still runs and the seconds it was given for: 0
// without a lease, 0xFFFFFFFF for one that does not end.
pub fn leaseLeft() -> usize { return if started { client.left() } else { 0 } }
pub fn leaseTime() -> usize { return if bound() { client.leaseTime } else { 0 } }

pub fn start() -> void {
    var mac: [6]u8 = undefined
    var k: usize = 0
    while k < 6 {
        mac[k] = netdev.macByte(k)
        k += 1
    }
    client.init(lease.Outside.{ .now = now, .send = send }, &mac)
    started = true
    client.start()
}

// The link came up.
pub fn linkCame() -> void {
    if started { client.linkUp() }
}

// The boot has said what the link's address is, or that there is none
// yet: what changes from now on is said when it changes.
pub fn announce() -> void { announced = true }

// What the client's last step did, done to the stack and said.
fn apply(change: lease.Change) -> void {
    if change == lease.Change.configured {
        stack.configure(stack.Source.DHCP, &client.address, &client.mask, &client.router, &client.nameServer)
        settings.writeResolvConf()
        if announced {
            console.freshLine()
            stack.say()
        }
    }
    if change == lease.Change.lost {
        if announced {
            console.freshLine()
            console.out.write("brixOS: net0 gave up ")
            stack.writeIp(stack.configuration().*.address, console.out)
            console.out.write(if client.reason == lease.Reason.refused { ": the DHCP server took it back" } else { ": its lease ran out" })
            console.out.write(" (DHCP is asking)\n")
        }
        stack.unconfigure()
        settings.writeResolvConf()
    }
}

// A message on port 68.
pub fn receive(bytes: [*]const u8, length: usize) -> void {
    if !started { return }
    apply(client.receive(bytes, length))
}

// Every tick: the client's timers.
pub fn tick() -> void {
    if !started { return }
    apply(client.tick())
}
