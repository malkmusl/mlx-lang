// The network's settings files: /system/settings/network read (address,
// netmask, gateway, nameserver lines: a static configuration, then no
// DHCP), /system/settings/resolv.conf written for programs that look
// names up (std.net.dns reads it at std.platform.RESOLV_CONF; the Linux
// layer shows the same file as /etc/resolv.conf). Without a name server
// the file is there and empty: no name is looked up.
const vfs = @import("../vfs.mlx")
const stack = @import("./stack.mlx")

// The settings directory (made when the archive has none); NONE when
// there is no /system.
fn settingsDirectory() -> usize {
    const tree = vfs.fileSystem()
    const system = tree.resolve(vfs.Vfs.ROOT, "/system\x00".pointer)
    if system < 0 { return vfs.Vfs.NONE }
    const directory = tree.lookup(@bitCast(usize, system), "settings".pointer, 8)
    if directory != vfs.Vfs.NONE { return directory }
    // (Linked, as resolv.conf below: a node no directory's link counts
    // is freed when the last program that opened it lets it go.)
    const made = tree.makeDirectory(@bitCast(usize, system), "settings", 493)
    return if made < 0 { vfs.Vfs.NONE } else { @bitCast(usize, made) }
}

// The network file's settings taken over: whether it gave an address
// (a static configuration).
pub fn read() -> bool {
    const tree = vfs.fileSystem()
    const directory = settingsDirectory()
    if directory == vfs.Vfs.NONE { return false }
    const file = tree.lookup(directory, "network".pointer, 7)
    if file == vfs.Vfs.NONE { return false }
    const length = tree.read(file, 0, &text, 512)
    return stack.settings(text[0..length])
}

// The files' text (static: as locals they came from the aggregate arena).
var text: [512]u8 = undefined // (per run)
var line: [40]u8 = undefined // (per run)

fn decimal(into: [*]u8, at: usize, value: usize) -> usize {
    var length = at
    if value >= 100 {
        into[length] = @intCast(u8, 48 + value / 100)
        length += 1
    }
    if value >= 10 {
        into[length] = @intCast(u8, 48 + (value / 10) % 10)
        length += 1
    }
    into[length] = @intCast(u8, 48 + value % 10)
    return length + 1
}

// resolv.conf with the name server of the configuration (no line when
// there is none).
pub fn writeResolvConf() -> void {
    const tree = vfs.fileSystem()
    const directory = settingsDirectory()
    if directory == vfs.Vfs.NONE { return }
    var length: usize = 0
    const server = stack.configuration().*.nameServer
    if server[0] != 0 || server[1] != 0 || server[2] != 0 || server[3] != 0 {
        const prefix = "nameserver "
        while length < prefix.length {
            line[length] = prefix[length]
            length += 1
        }
        var part: usize = 0
        while part < 4 {
            if part > 0 {
                line[length] = 46
                length += 1
            }
            length = decimal(&line, length, @intCast(usize, server[part]))
            part += 1
        }
        line[length] = 10
        length += 1
    }
    var node = tree.lookup(directory, "resolv.conf".pointer, 11)
    if node == vfs.Vfs.NONE {
        // A link of the directory's, counted (attach is for what a disk
        // already names: with it the file had no link, and was freed
        // when the first program that read it closed it: an empty
        // resolv.conf from then on, no name looked up any more).
        node = tree.create(vfs.NodeKind.file, 420)
        if node == vfs.Vfs.NONE { return }
        if tree.link(directory, "resolv.conf".pointer, 11, node) < 0 {
            tree.release(node)
            return
        }
    } else {
        tree.truncate(node, 0)
    }
    _ = tree.write(node, 0, &line, length)
}
