// spaces 1 to 7 (gmc_v8_0_early_init's shared aperture, its bits 63:48),
// the base of the others (init_compute_vmid's DEFAULT_SH_MEM_BASES, twice),
// where those begin (first_kfd_vmid) and how many there are
// (AMDGPU_NUM_VMID).
pub const MTYPE_NC: usize = gfx_8_0.MTYPE.MTYPE_NC
pub const MTYPE_CC: usize = gfx_8_0.MTYPE.MTYPE_CC
pub const MTYPE_UC: usize = gfx_8_0.MTYPE.MTYPE_UC
pub const SH_MEM_ALIGNMENT_MODE_UNALIGNED: usize = gfx_8_0.SH_MEM_ALIGNMENT_MODE.SH_MEM_ALIGNMENT_MODE_UNALIGNED
pub const SH_MEM_ADDRESS_MODE_HSA64: usize = gfx_8_0.SH_MEM_ADDRESS_MODE.SH_MEM_ADDRESS_MODE_HSA64
pub const SHARED_APERTURE_BASES: usize = 0x2000
pub const DEFAULT_SH_MEM_BASES: usize = 0x6000
pub const FIRST_KFD_VMID: usize = 8
pub const AMDGPU_NUM_VMID: usize = 16
// The RLC's SPM address space (gfx_v8_0_rlc_init: "init spm vmid with
// 0xf").
pub const SPM_VMID: usize = 0xF
// The queues: the KIQ is micro engine 2, pipe 1, queue 0
// (amdgpu_gfx_kiq_acquire on two compute processors), compute ring 0 micro
// engine 1, pipe 0, queue 0 (gfx_v8_0_sw_init's spread); their doorbells
// (amdgpu_doorbell.h, legacy: the KIQ's, the compute rings' first and
// eighth, the graphics ring's).
pub const KIQ_ME: usize = 2
pub const KIQ_PIPE: usize = 1
pub const KIQ_QUEUE: usize = 0
pub const RING0_ME: usize = 1
pub const RING0_PIPE: usize = 0
pub const RING0_QUEUE: usize = 0
pub const AMDGPU_DOORBELL_KIQ: usize = 0x000
pub const AMDGPU_DOORBELL_MEC_RING0: usize = 0x010
pub const AMDGPU_DOORBELL_MEC_RING7: usize = 0x017
pub const AMDGPU_DOORBELL_GFX_RING0: usize = 0x020
// A queue's end-of-pipe buffer (GFX8_MEC_HPD_SIZE), a ring of 1024 words
// asked twice over (amdgpu_ring_init: rounded to a power of two, in bytes),
// a queue descriptor's first word, its preload size, the descriptor's
// allocation (struct vi_mqd_allocation: the descriptor, then two words,
// then the two masks).
pub const GFX8_MEC_HPD_SIZE: usize = 4096
pub const RING_BYTES: usize = 1024 * 4 * 2
pub const MQD_HEADER: usize = 0xC0310800
pub const PRELOAD_SIZE: usize = 0x53
pub const vi_mqd_allocation__dynamic_cu_mask: usize = 2056
pub const vi_mqd_allocation__dynamic_rb_mask: usize = 2060
pub const vi_mqd_allocation__size: usize = 2064
// The descriptor's words this driver fills (struct vi_mqd: every field 32
// bits; the word's index).
pub const vi_mqd__header: usize = 0
pub const vi_mqd__compute_pipelinestat_enable: usize = 11
pub const vi_mqd__compute_static_thread_mgmt_se0: usize = 23
pub const vi_mqd__compute_static_thread_mgmt_se1: usize = 24
pub const vi_mqd__compute_static_thread_mgmt_se2: usize = 26
pub const vi_mqd__compute_static_thread_mgmt_se3: usize = 27
pub const vi_mqd__compute_misc_reserved: usize = 32
pub const vi_mqd__dynamic_cu_mask_addr_lo: usize = 126
pub const vi_mqd__dynamic_cu_mask_addr_hi: usize = 127
pub const vi_mqd__cp_mqd_base_addr_lo: usize = 128
pub const vi_mqd__cp_mqd_base_addr_hi: usize = 129
pub const vi_mqd__cp_hqd_active: usize = 130
pub const vi_mqd__cp_hqd_vmid: usize = 131
pub const vi_mqd__cp_hqd_persistent_state: usize = 132
pub const vi_mqd__cp_hqd_quantum: usize = 135
pub const vi_mqd__cp_hqd_pq_base_lo: usize = 136
pub const vi_mqd__cp_hqd_pq_base_hi: usize = 137
pub const vi_mqd__cp_hqd_pq_rptr: usize = 138
pub const vi_mqd__cp_hqd_pq_rptr_report_addr_lo: usize = 139
pub const vi_mqd__cp_hqd_pq_rptr_report_addr_hi: usize = 140
pub const vi_mqd__cp_hqd_pq_wptr_poll_addr_lo: usize = 141
pub const vi_mqd__cp_hqd_pq_wptr_poll_addr_hi: usize = 142
pub const vi_mqd__cp_hqd_pq_doorbell_control: usize = 143
pub const vi_mqd__cp_hqd_pq_wptr: usize = 144
pub const vi_mqd__cp_hqd_pq_control: usize = 145
pub const vi_mqd__cp_hqd_ib_control: usize = 149
pub const vi_mqd__cp_hqd_iq_timer: usize = 150
pub const vi_mqd__cp_mqd_control: usize = 162
pub const vi_mqd__cp_hqd_eop_base_addr_lo: usize = 165
pub const vi_mqd__cp_hqd_eop_base_addr_hi: usize = 166
pub const vi_mqd__cp_hqd_eop_control: usize = 167
pub const vi_mqd__cp_hqd_eop_rptr: usize = 168
pub const vi_mqd__cp_hqd_eop_wptr: usize = 169
pub const vi_mqd__cp_hqd_eop_done_events: usize = 170
pub const vi_mqd__cp_hqd_ctx_save_base_addr_lo: usize = 171
pub const vi_mqd__cp_hqd_ctx_save_base_addr_hi: usize = 172
pub const vi_mqd__cp_hqd_ctx_save_control: usize = 173
pub const vi_mqd__cp_hqd_cntl_stack_offset: usize = 174
pub const vi_mqd__cp_hqd_cntl_stack_size: usize = 175
pub const vi_mqd__cp_hqd_wg_state_offset: usize = 176
pub const vi_mqd__cp_hqd_ctx_save_size: usize = 177
pub const vi_mqd__cp_hqd_error: usize = 179
pub const vi_mqd__cp_hqd_eop_wptr_mem: usize = 180
pub const vi_mqd__cp_hqd_eop_dones: usize = 181
// The graphics ring's start (gfx_v8_0_cp_gfx_start: the contexts the CP
// keeps, max_hw_contexts less one; the device word; the constant engine's
// partition) and CONTEXT_CONTROL's two words.
pub const MAX_CONTEXT: usize = 7
pub const DEVICE_ID: usize = 1
pub const CE_PARTITION: usize = 0x8000
pub const CONTEXT_CONTROL_WORD: usize = 0x80000000
// The idle state of the block (gfx_v8_0_is_idle: GRBM_STATUS2 reads this).
pub const IDLE_STATUS2: usize = 0x8
// UNMAP_QUEUES' action "reset queues" (gfx_v8_0_kcq_disable).
pub const RESET_QUEUES: usize = 1
// The indirect buffer test's write: to memory (5), confirmed
// (gfx_v8_0_ring_test_ib).
pub const DST_MEMORY: usize = 5
// The end-of-pipe entry of compute ring 0 (gfx_v8_0_eop_irq's reading).
pub const RING0_ID: usize = 0x04

// ---- This driver's own numbers.
// The temperature at which every ring stops (the study's second mark).
pub const STOP_MARK: usize = 95
// How often the watch looks (nanoseconds).
pub const WATCH_EVERY: usize = 1000000000
// The registers the steps wrote, kept for the way back.
pub const KEPT: usize = 1024
// The write-back page: a ring's record each (gpu_ring.mlx's RECORD), the
// indirect buffer test's word.
pub const KIQ_RECORD: usize = 0
pub const RING0_RECORD: usize = 32
pub const GRAPHICS_RECORD: usize = 64
pub const IB_TEST_AT: usize = 256
// The most shader engines, arrays a engine and compute units an array the
// selectors and words here hold (GRBM_GFX_INDEX's fields, the words'
// masks).
pub const MOST_ENGINES: usize = 4
pub const MOST_ARRAYS: usize = 2
pub const MOST_UNITS: usize = 16
// (No such thing.)
pub const NONE: usize = 0xFFFFFFFFFFFFFFFF

// What stage 5 did and keeps.
pub const Compute = struct {
    g1: engines.Outcome
    g2: engines.Outcome
    g3: engines.Outcome
    g4: engines.Outcome
    // The registers the steps wrote, what each held before, what it was
    // given and the queue selector it was written under, in order.
    register: [KEPT]usize
    value: [KEPT]usize
    given: [KEPT]usize
    selected: [KEPT]usize
    count: usize
    full: bool
    // G1: the SMC's clock divider word as it was (NONE: not written), the
    // golden words changed, the render back ends (their mask, how many),
    // the compute units in all and per shader engine, whether the raster
    // configuration was written, what shader engine 0's reads back.
    aclk: usize
    golden: usize
    backendMask: usize
    backends: usize
    units: usize
    perEngine: [MOST_ENGINES]usize
    raster: bool
    rasterRead: [2]usize
    // G2: the RLC's control, status and GRBM_STATUS2 before and after, the
    // SPM word before, how long the serial buses took, which stayed busy.
    rlcBefore: [3]usize
    rlcAfter: [3]usize
    spmVmid: usize
    serdes: usize
    busy: usize
    // The rings and their memory (physical): the write-back page, each
    // ring's words, the queues' descriptors and end-of-pipe buffers (KIQ,
    // ring 0), the indirect buffers' page.
    writeBack: usize
    rings: [3]usize
    mqd: [2]usize
    eop: [2]usize
    buffers: usize
    kiq: ring.Ring
    compute: ring.Ring
    graphics: ring.Ring
    // G3: the second trial ran (the graphics ring before the map); the map
    // was taken; the microseconds of the map, of the three ring tests.
    second: bool
    mapped: bool
    mapWaited: usize
    kiqWaited: usize
    ringWaited: usize
    graphicsWaited: usize
    // G4: the wait's end, its time.
    how: ring.Waited
    // The temperature before a step; the watch: on, when it last looked,
    // the mark the card is at (0, 1, 2), the last reading, the rings it
    // stopped.
    before: usize
    watchLast: usize
    watchMark: usize
    watchDegrees: usize
    stopped: bool
}

// ---- Reaching the card.

fn rd(e: *engines.Engines, number: usize) -> usize {
    const read = e.*.hands.read
    return @intCast(usize, read(number))
}

fn wr(e: *engines.Engines, number: usize, value: usize) -> void {
    const write = e.*.hands.write
    write(number, @intCast(u32, value & 0xFFFFFFFF))
}

fn say(e: *engines.Engines, text: []const u8) -> void {
    const write = e.*.hands.say
    write(text)
}

fn now(e: *engines.Engines) -> usize {
    const clock = e.*.hands.now
    return clock()
}

fn pause(e: *engines.Engines, microseconds: usize) -> void {
    const wait = e.*.hands.pause
    wait(microseconds)
}

fn aside(e: *engines.Engines, on: bool) -> void {
    const put = e.*.hands.aside
    put(on)
}

fn memoryRead(e: *engines.Engines, physical: usize) -> usize {
    const read = e.*.hands.memoryRead
    return @intCast(usize, read(physical))
}

fn memoryWrite(l: *loaded.Loaded, physical: usize, value: usize) -> void {
    const write = l.*.more.memoryWrite
    write(physical, @intCast(u32, value & 0xFFFFFFFF))
}

fn dma(e: *engines.Engines, bytes: usize) -> usize {
    const allocate = e.*.hands.dma
    return allocate(bytes)
}

// A field's value placed by its mask, and read by it.
fn field(mask: usize, value: usize) -> usize {
    var shift: usize = 0
    while shift < 32 && (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (value << @intCast(u6, shift)) & mask
}

fn get(value: usize, mask: usize) -> usize {
    var shift: usize = 0
    while shift < 32 && (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (value & mask) >> @intCast(u6, shift)
}

// The bits set in a word.
fn ones(value: usize) -> usize {
    var count: usize = 0
    var rest = value
    while rest != 0 {
        count += rest & 1
        rest = rest >> 1
    }
    return count
}

// log2 of a power of two (order_base_2).
fn order(value: usize) -> usize {
    var bits: usize = 0
    while (@intCast(usize, 1) << @intCast(u6, bits)) < value { bits += 1 }
    return bits
}

// A register written by a step: what it held kept first, with what it was
// given and the queue selector it was written under (the way back, the
// read-back).
pub fn put(e: *engines.Engines, c: *Compute, number: usize, value: usize) -> void {
    if c.*.count >= KEPT {
        c.*.full = true
        wr(e, number, value)
        return
    }
    c.*.register[c.*.count] = number
    c.*.value[c.*.count] = rd(e, number)
    c.*.given[c.*.count] = value & 0xFFFFFFFF
    c.*.selected[c.*.count] = rd(e, engines.SRBM_GFX_CNTL)
    c.*.count += 1
    wr(e, number, value)
}

// A field of a register written by a step (WREG32_FIELD: read, the field
// set, written).
fn putField(e: *engines.Engines, c: *Compute, number: usize, mask: usize, value: usize) -> void { put(e, c, number, (rd(e, number) & ~mask) | field(mask, value)) }

// The registers the steps wrote put back as they were, last first, down to
// `mark`; how many. The processors' halt words keep their halt and the
// RLC's control word stays off: put back as they were they could let a
// processor run its queues, or the RLC, in the middle of the way back.
pub fn putBack(e: *engines.Engines, c: *Compute, mark: usize) -> usize {
    var count: usize = 0
    while c.*.count > mark {
        c.*.count -= 1
        const number = c.*.register[c.*.count]
        var value = c.*.value[c.*.count]
        if number == engines.CP_MEC_CNTL { value = engines.CP_MEC_CNTL__MEC_ME1_HALT | engines.CP_MEC_CNTL__MEC_ME2_HALT }
        if number == engines.CP_ME_CNTL { value |= engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT }
        if number == engines.RLC_CNTL { value &= ~engines.RLC_CNTL__RLC_ENABLE_F32 }
        wr(e, number, value)
        count += 1
    }
    return count
}

// The registers a step wrote from `mark` on read back, each under the
// queue selector it was written under, the last value given to a register
// alone (the selectors and the SMC's pair are not held); the first that
// does not hold (NONE: none). The selector is left at 0.
pub fn readBack(e: *engines.Engines, c: *Compute, mark: usize) -> usize {
    var k = mark
    var bad = NONE
    var current: usize = 0
    while k < c.*.count && bad == NONE {
        const number = c.*.register[k]
        var later = false
        var j = k + 1
        while j < c.*.count {
            if c.*.register[j] == number && c.*.selected[j] == c.*.selected[k] { later = true }
            j += 1
        }
        if !later && number != engines.SRBM_GFX_CNTL && number != loaded.GRBM_GFX_INDEX {
            if c.*.selected[k] != current {
                current = c.*.selected[k]
                wr(e, engines.SRBM_GFX_CNTL, current)
            }
            if rd(e, number) != c.*.given[k] { bad = k }
        }
        k += 1
    }
    if current != 0 { wr(e, engines.SRBM_GFX_CNTL, 0) }
    return bad
}

// ---- The log's words.

fn decimal(e: *engines.Engines, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(e, digits[at..20])
}

fn hex(e: *engines.Engines, value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(e, text[0..2 + digits])
}

fn num(e: *engines.Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    decimal(e, value)
}

fn word(e: *engines.Engines, label: []const u8, value: usize) -> void {
    say(e, label)
    hex(e, value)
}

// "; 41 C before, 41 C after" in a step's line.
fn degrees(e: *engines.Engines, c: *Compute, after: usize) -> void {
    num(e, "; ", c.*.before)
    num(e, " C before, ", after)
    say(e, " C after")
}

// " (12 ms)" after a step's line.
fn took(e: *engines.Engines) -> void {
    num(e, " (", (now(e) - e.*.began) / 1000000)
    say(e, " ms)\n")
}

// The card's temperature, the SMC's index put back as it was.
fn temperature(e: *engines.Engines) -> usize {
    const index = rd(e, engines.SMC_IND_INDEX_11)
    const degrees = loaded.temperature(e)
    wr(e, engines.SMC_IND_INDEX_11, index)
    return degrees
}

// A step not begun at the mark: said, and whether it may begin.
fn cool(e: *engines.Engines, c: *Compute, step: []const u8) -> bool {
    c.*.before = temperature(e)
    if c.*.before < loaded.MARK { return true }
    say(e, "gpu: step ")
    say(e, step)
    num(e, " refused: the card is at ", c.*.before)
    num(e, " C (no step begins at ", loaded.MARK)
    say(e, " C or more)\n")
    return false
}

// A word of the SMC's (its index and data pair), the index put back.
fn smcRead(e: *engines.Engines, address: usize) -> usize {
    const index = rd(e, engines.SMC_IND_INDEX_11)
    wr(e, engines.SMC_IND_INDEX_11, address)
    const value = rd(e, engines.SMC_IND_DATA_11)
    wr(e, engines.SMC_IND_INDEX_11, index)
    return value
}

fn smcWrite(e: *engines.Engines, address: usize, value: usize) -> void {
    const index = rd(e, engines.SMC_IND_INDEX_11)
    wr(e, engines.SMC_IND_INDEX_11, address)
    wr(e, engines.SMC_IND_DATA_11, value)
    wr(e, engines.SMC_IND_INDEX_11, index)
}

// Whether a fault was kept in address space 0 since the GART came on, and
// its words for a line.
fn faulted(e: *engines.Engines) -> bool { return rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS) != 0 || rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR) != 0 }

fn sayFault(e: *engines.Engines) -> void {
    word(e, "a fault in address space 0 at page ", rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR))
    word(e, " (status ", rd(e, engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS))
    say(e, ")")
}

// The shader engine and array selector (gfx_v8_0_select_se_sh, every
// instance): one of them, or all (the rest value).
fn select(e: *engines.Engines, se: usize, sh: usize) -> void { wr(e, loaded.GRBM_GFX_INDEX, loaded.GRBM_GFX_INDEX__INSTANCE_BROADCAST_WRITES | field(loaded.GRBM_GFX_INDEX__SE_INDEX, se) | field(loaded.GRBM_GFX_INDEX__SH_INDEX, sh)) }

fn selectAll(e: *engines.Engines) -> void { wr(e, loaded.GRBM_GFX_INDEX, loaded.GRBM_GFX_INDEX__SE_BROADCAST_WRITES | loaded.GRBM_GFX_INDEX__INSTANCE_BROADCAST_WRITES | loaded.GRBM_GFX_INDEX__SH_BROADCAST_WRITES) }

// The queue selector (vi_srbm_select) for an address space alone.
fn space(n: usize) -> usize { return field(loaded.SRBM_GFX_CNTL__VMID, n) }

// ---- The start.

// The record anew (nothing tried yet).
pub fn begin(c: *Compute) -> void {
    c.*.g1 = engines.Outcome.not_tried
    c.*.g2 = engines.Outcome.not_tried
    c.*.g3 = engines.Outcome.not_tried
    c.*.g4 = engines.Outcome.not_tried
    c.*.count = 0
    c.*.full = false
    c.*.aclk = NONE
    c.*.golden = 0
    c.*.backendMask = 0
    c.*.backends = 0
    c.*.units = 0
    var k: usize = 0
    while k < MOST_ENGINES {
        c.*.perEngine[k] = 0
        k += 1
    }
    c.*.raster = false
    c.*.rasterRead[0] = 0
    c.*.rasterRead[1] = 0
    c.*.spmVmid = 0
    c.*.serdes = 0
    c.*.busy = NONE
    c.*.writeBack = 0
    c.*.rings[0] = 0
    c.*.rings[1] = 0
    c.*.rings[2] = 0
    c.*.mqd[0] = 0
    c.*.mqd[1] = 0
    c.*.eop[0] = 0
    c.*.eop[1] = 0
    c.*.buffers = 0
    c.*.kiq.up = false
    c.*.compute.up = false
    c.*.graphics.up = false
    c.*.second = false
    c.*.mapped = false
    c.*.mapWaited = 0
    c.*.kiqWaited = 0
    c.*.ringWaited = 0
    c.*.graphicsWaited = 0
    c.*.how = ring.Waited.late
    c.*.before = 0
    c.*.watchLast = 0
    c.*.watchMark = 0
    c.*.watchDegrees = 0
    c.*.stopped = false
}

// The ROM's numbers of the block the steps go by (GFX_Info): shader
// engines, arrays an engine, compute units an array, render back ends an
// engine; whether they are there and within what the selectors and words
// hold.
fn numbersHold(e: *engines.Engines) -> bool {
    const f = &e.*.found
    if !f.*.gfxFound { return false }
    const se = f.*.gfx[2]
    const sh = f.*.gfx[5]
    const cu = f.*.gfx[4]
    const rb = f.*.gfx[6]
    return se != 0 && sh != 0 && cu != 0 && rb != 0 && se <= MOST_ENGINES && sh <= MOST_ARRAYS && cu <= MOST_UNITS && rb % sh == 0 && rb / sh <= 8
}

// ---- G1: the graphics block's settings.

// One golden table by Linux's rule (amdgpu_device_program_register_sequence
// on this family: a full mask writes the value; otherwise the mask cleared
// and the value ORed as it is), each word written only where the rule
// gives another value than the register holds, said with what it was.
fn goldenTable(e: *engines.Engines, c: *Compute, rows: []const usize) -> void {
    var k: usize = 0
    while k + 2 < rows.length {
        const number = rows[k]
        const was = rd(e, number)
        const value = if rows[k + 1] == 0xFFFFFFFF { rows[k + 2] } else { (was & ~rows[k + 1]) | rows[k + 2] }
        if value != was {
            put(e, c, number, value)
            word(e, "gpu: golden ", number)
            word(e, " was ", was)
            word(e, " now ", value)
            say(e, "\n")
            c.*.golden += 1
        }
        k += 3
    }
}

// gfx_v8_0_setup_rb: the render back ends each shader engine and array has
// (CC_ and GC_USER_RB_BACKEND_DISABLE, the field cleared bits), the raster
// configuration written when all are there, then each engine's words read
// as Linux keeps them (shader engine 0's, which the graphics ring's first
// submission sends).
fn backends(e: *engines.Engines, c: *Compute) -> void {
    const f = &e.*.found
    const se = f.*.gfx[2]
    const sh = f.*.gfx[5]
    const width = f.*.gfx[6] / sh
    var mask: usize = 0
    var i: usize = 0
    while i < se {
        var j: usize = 0
        while j < sh {
            select(e, i, j)
            const disabled = get(rd(e, CC_RB_BACKEND_DISABLE) | rd(e, GC_USER_RB_BACKEND_DISABLE), CC_RB_BACKEND_DISABLE__BACKEND_DISABLE)
            const active = ~disabled & ((@intCast(usize, 1) << @intCast(u6, width)) - 1)
            mask |= active << @intCast(u6, (i * sh + j) * width)
            j += 1
        }
        i += 1
    }
    selectAll(e)
    c.*.backendMask = mask
    c.*.backends = ones(mask)
    const pipes = if f.*.gfx[6] * se < 16 { f.*.gfx[6] * se } else { 16 }
    c.*.raster = mask == 0 || c.*.backends >= pipes
    if c.*.raster {
        put(e, c, PA_SC_RASTER_CONFIG, RASTER_CONFIG)
        put(e, c, PA_SC_RASTER_CONFIG_1, RASTER_CONFIG_1)
    }
    i = 0
    while i < se {
        var j: usize = 0
        while j < sh {
            select(e, i, j)
            _ = rd(e, CC_RB_BACKEND_DISABLE)
            _ = rd(e, GC_USER_RB_BACKEND_DISABLE)
            const raster = rd(e, PA_SC_RASTER_CONFIG)
            const raster1 = rd(e, PA_SC_RASTER_CONFIG_1)
            if i == 0 && j == 0 {
                c.*.rasterRead[0] = raster
                c.*.rasterRead[1] = raster1
            }
            j += 1
        }
        i += 1
    }
    selectAll(e)
}

// gfx_v8_0_get_cu_info: the compute units each shader engine and array has
// (CC_ and GC_USER_SHADER_ARRAY_CONFIG, the inactive field's cleared bits);
// only reads (no unit is disabled by a module option here).
fn units(e: *engines.Engines, c: *Compute) -> void {
    const f = &e.*.found
    const se = f.*.gfx[2]
    const sh = f.*.gfx[5]
    const cu = f.*.gfx[4]
    c.*.units = 0
    var i: usize = 0
    while i < se {
        c.*.perEngine[i] = 0
        var j: usize = 0
        while j < sh {
            select(e, i, j)
            const inactive = get(rd(e, CC_GC_SHADER_ARRAY_CONFIG) | rd(e, GC_USER_SHADER_ARRAY_CONFIG), CC_GC_SHADER_ARRAY_CONFIG__INACTIVE_CUS)
            const active = ones(~inactive & ((@intCast(usize, 1) << @intCast(u6, cu)) - 1))
            c.*.perEngine[i] += active
            c.*.units += active
            j += 1
        }
        i += 1
    }
    selectAll(e)
}

// The global data store's four words of address space n (gfx_v8_0.c's
// amdgpu_gds_reg_offset) set to 0.
fn noStore(e: *engines.Engines, c: *Compute, n: usize) -> void {
    put(e, c, GDS_VMID0_BASE + 2 * n, 0)
    put(e, c, GDS_VMID0_SIZE + 2 * n, 0)
    put(e, c, GDS_GWS_VMID0 + n, 0)
    put(e, c, GDS_OA_VMID0 + n, 0)
}

// gfx_v8_0_constants_init in its order but for DMIF_ADDR_CALC and
// HDP_ADDR_CONFIG (stage 6's): the read timeout, the address
// configuration (S0's word), the tiling words, the render back ends and
// their raster configuration, the compute units, the static memory word,
// the shader memory words of address spaces 0 to 7 (Linux's id_mgr count,
// the first of the other subsystem's) and 8 to 15 (init_compute_vmid's,
// with their global data store), the store of 1 to 15 (init_gds_vmid), and
// with every shader engine selected the FIFO sizes and the arbiter's
// order.
fn constants(e: *engines.Engines, c: *Compute) -> void {
    putField(e, c, GRBM_CNTL, GRBM_CNTL__READ_TIMEOUT, 0xFF)
    put(e, c, engines.GB_ADDR_CONFIG, e.*.found.addressConfig)
    var k: usize = 0
    while k < TILE_MODES.length {
        put(e, c, GB_TILE_MODE0 + k, TILE_MODES[k])
        k += 1
    }
    k = 0
    while k < MACROTILE_MODES.length {
        if k != MACROTILE_SKIPPED { put(e, c, GB_MACROTILE_MODE0 + k, MACROTILE_MODES[k]) }
        k += 1
    }
    backends(e, c)
    units(e, c)
    put(e, c, SH_STATIC_MEM_CONFIG, field(SH_STATIC_MEM_CONFIG__SWIZZLE_ENABLE, SWIZZLE_ENABLE) | field(SH_STATIC_MEM_CONFIG__ELEMENT_SIZE, ELEMENT_SIZE) | field(SH_STATIC_MEM_CONFIG__INDEX_STRIDE, INDEX_STRIDE))
    var n: usize = 0
    while n < FIRST_KFD_VMID {
        put(e, c, engines.SRBM_GFX_CNTL, space(n))
        const kind = if n == 0 { MTYPE_UC } else { MTYPE_NC }
        put(e, c, SH_MEM_CONFIG, field(SH_MEM_CONFIG__DEFAULT_MTYPE, kind) | field(SH_MEM_CONFIG__APE1_MTYPE, MTYPE_UC) | field(SH_MEM_CONFIG__ALIGNMENT_MODE, SH_MEM_ALIGNMENT_MODE_UNALIGNED))
        put(e, c, SH_MEM_BASES, if n == 0 { 0 } else { SHARED_APERTURE_BASES })
        put(e, c, SH_MEM_APE1_BASE, 1)
        put(e, c, SH_MEM_APE1_LIMIT, 0)
        n += 1
    }
    put(e, c, engines.SRBM_GFX_CNTL, 0)
    n = FIRST_KFD_VMID
    while n < AMDGPU_NUM_VMID {
        put(e, c, engines.SRBM_GFX_CNTL, space(n))
        put(e, c, SH_MEM_CONFIG, field(SH_MEM_CONFIG__ADDRESS_MODE, SH_MEM_ADDRESS_MODE_HSA64) | field(SH_MEM_CONFIG__ALIGNMENT_MODE, SH_MEM_ALIGNMENT_MODE_UNALIGNED) | field(SH_MEM_CONFIG__DEFAULT_MTYPE, MTYPE_CC) | SH_MEM_CONFIG__PRIVATE_ATC)
        put(e, c, SH_MEM_APE1_BASE, 1)
        put(e, c, SH_MEM_APE1_LIMIT, 0)
        put(e, c, SH_MEM_BASES, DEFAULT_SH_MEM_BASES | (DEFAULT_SH_MEM_BASES << 16))
        n += 1
    }
    put(e, c, engines.SRBM_GFX_CNTL, 0)
    n = FIRST_KFD_VMID
    while n < AMDGPU_NUM_VMID {
        noStore(e, c, n)
        n += 1
    }
    n = 1
    while n < AMDGPU_NUM_VMID {
        noStore(e, c, n)
        n += 1
    }
    selectAll(e)
    put(e, c, PA_SC_FIFO_SIZE, field(PA_SC_FIFO_SIZE__SC_FRONTEND_PRIM_FIFO_SIZE, SC_FRONTEND_PRIM_FIFO_SIZE) | field(PA_SC_FIFO_SIZE__SC_BACKEND_PRIM_FIFO_SIZE, SC_BACKEND_PRIM_FIFO_SIZE) | field(PA_SC_FIFO_SIZE__SC_HIZ_TILE_FIFO_SIZE, SC_HIZ_TILE_FIFO_SIZE) | field(PA_SC_FIFO_SIZE__SC_EARLYZ_TILE_FIFO_SIZE, SC_EARLYZ_TILE_FIFO_SIZE))
    var priority = rd(e, SPI_ARB_PRIORITY)
    priority = (priority & ~SPI_ARB_PRIORITY__PIPE_ORDER_TS0) | field(SPI_ARB_PRIORITY__PIPE_ORDER_TS0, PIPE_ORDER)
    priority = (priority & ~SPI_ARB_PRIORITY__PIPE_ORDER_TS1) | field(SPI_ARB_PRIORITY__PIPE_ORDER_TS1, PIPE_ORDER)
    priority = (priority & ~SPI_ARB_PRIORITY__PIPE_ORDER_TS2) | field(SPI_ARB_PRIORITY__PIPE_ORDER_TS2, PIPE_ORDER)
    priority = (priority & ~SPI_ARB_PRIORITY__PIPE_ORDER_TS3) | field(SPI_ARB_PRIORITY__PIPE_ORDER_TS3, PIPE_ORDER)
    put(e, c, SPI_ARB_PRIORITY, priority)
}

// G1. Whether it passed.
pub fn settings(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> bool {
    e.*.began = now(e)
    if !numbersHold(e) {
        c.*.g1 = engines.Outcome.refused
        say(e, "gpu: step G1 refused: the card's ROM does not give the graphics block's numbers (GFX_Info), or gives more shader engines, arrays or units than its selectors hold\n")
        return false
    }
    if !cool(e, c, "G1") {
        c.*.g1 = engines.Outcome.refused
        return false
    }
    const mark = c.*.count
    c.*.golden = 0
    c.*.full = false
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)

    // gfx_v8_0_init_golden_registers for Polaris 10: the two tables, then
    // the SMC's clock divider (its word kept for the way back).
    goldenTable(e, c, GOLDEN_GRAPHICS_WORDS[0..])
    goldenTable(e, c, GOLDEN_COMMON_WORDS[0..])
    const aclk = smcRead(e, engines.ixCG_ACLK_CNTL)
    const divided = (aclk & ~CG_ACLK_CNTL__ACLK_DIVIDER) | field(CG_ACLK_CNTL__ACLK_DIVIDER, ACLK_DIVIDER)
    if divided != aclk {
        c.*.aclk = aclk
        smcWrite(e, engines.ixCG_ACLK_CNTL, divided)
        word(e, "gpu: golden: the SMC's clock divider word was ", aclk)
        word(e, " now ", divided)
        say(e, "\n")
        c.*.golden += 1
    }
    constants(e, c)

    // The self-test: every register read back; the clock divider word;
    // compute units and render back ends there.
    var why: []const u8 = ""
    var bad = NONE
    if c.*.full { why = "more registers were to be kept than there is room for" }
    if why.length == 0 {
        bad = readBack(e, c, mark)
        if bad != NONE { why = "a register does not hold what was written: " }
    }
    if why.length == 0 && smcRead(e, engines.ixCG_ACLK_CNTL) != divided { why = "the SMC's clock divider word does not hold what was written" }
    if why.length == 0 && c.*.units == 0 { why = "the card says it has no compute unit" }
    if why.length == 0 && c.*.backends == 0 { why = "the card says it has no render back end" }
    const after = temperature(e)
    const living = engines.alive(e, "G1")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    aside(e, false)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    if why.length != 0 || minded != engines.Change.none {
        c.*.g1 = engines.Outcome.failed
        say(e, "gpu: step G1 failed: ")
        if !living || (why.length != 0 && bad == NONE) {
            say(e, why)
        } else if why.length != 0 {
            say(e, why)
            hex(e, c.*.register[bad])
            word(e, " reads ", rd(e, c.*.register[bad]))
            word(e, " where ", c.*.given[bad])
            say(e, " was written")
            if c.*.selected[bad] != 0 { word(e, " (queue selector ", c.*.selected[bad]) }
            if c.*.selected[bad] != 0 { say(e, ")") }
        } else {
            engines.sayChange(e, minded, &before, &later)
        }
        // The way back: every register as it was, last first, the clock
        // divider word, the selectors at rest.
        const back = putBack(e, c, mark)
        if c.*.aclk != NONE { smcWrite(e, engines.ixCG_ACLK_CNTL, c.*.aclk) }
        c.*.aclk = NONE
        selectAll(e)
        wr(e, engines.SRBM_GFX_CNTL, 0)
        num(e, "; the block's words as before the step (", back)
        say(e, " registers)")
        degrees(e, c, after)
        took(e)
        return false
    }
    c.*.g1 = engines.Outcome.passed
    const f = &e.*.found
    num(e, "gpu: step G1: the graphics block's settings: golden words changed: ", c.*.golden)
    say(e, " (said above); its constants as Linux sets them but DMIF_ADDR_CALC and HDP_ADDR_CONFIG (stage 6 writes them): address configuration ")
    hex(e, f.*.addressConfig)
    num(e, ", tiling words ", TILE_MODES.length)
    num(e, " and ", MACROTILE_MODES.length - 1)
    num(e, "; ", c.*.units)
    num(e, " compute units in ", f.*.gfx[2])
    say(e, " shader engines (")
    var i: usize = 0
    while i < f.*.gfx[2] {
        num(e, if i == 0 { "" } else { " " }, c.*.perEngine[i])
        i += 1
    }
    num(e, "); ", c.*.backends)
    num(e, " of ", f.*.gfx[6] * f.*.gfx[2])
    say(e, " render back ends")
    if c.*.raster {
        word(e, " (raster configuration ", RASTER_CONFIG)
        word(e, " ", RASTER_CONFIG_1)
        say(e, ")")
    } else {
        word(e, " (mask ", c.*.backendMask)
        say(e, ": the raster configuration of a card with fewer is not built; it matters for drawing, stage 6)")
    }
    num(e, "; ", c.*.count - mark)
    say(e, " registers written, each read back")
    degrees(e, c, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// ---- G2: the RLC.

// gfx_v8_0_wait_for_rlc_serdes: each shader engine's and array's serial bus
// of the compute units idle, then the others', a microsecond a look,
// 100000 looks at most each; how long it took. A bus that stays busy is
// said and the rest not waited for, as Linux does (`c.busy`: which).
fn serdes(e: *engines.Engines, c: *Compute) -> void {
    const started = now(e)
    const f = &e.*.found
    c.*.busy = NONE
    var i: usize = 0
    while i < f.*.gfx[2] && c.*.busy == NONE {
        var j: usize = 0
        while j < f.*.gfx[5] && c.*.busy == NONE {
            select(e, i, j)
            var k: usize = 0
            while k < engines.AMDGPU_MAX_USEC_TIMEOUT && rd(e, loaded.RLC_SERDES_CU_MASTER_BUSY) != 0 {
                pause(e, 1)
                k += 1
            }
            if k >= engines.AMDGPU_MAX_USEC_TIMEOUT { c.*.busy = i * MOST_ARRAYS + j }
            j += 1
        }
        i += 1
    }
    selectAll(e)
    if c.*.busy == NONE {
        const mask = loaded.RLC_SERDES_NONCU_MASTER_BUSY__SE_MASTER_BUSY | loaded.RLC_SERDES_NONCU_MASTER_BUSY__GC_MASTER_BUSY | loaded.RLC_SERDES_NONCU_MASTER_BUSY__TC0_MASTER_BUSY | loaded.RLC_SERDES_NONCU_MASTER_BUSY__TC1_MASTER_BUSY
        var k: usize = 0
        while k < engines.AMDGPU_MAX_USEC_TIMEOUT && rd(e, loaded.RLC_SERDES_NONCU_MASTER_BUSY) & mask != 0 {
            pause(e, 1)
            k += 1
        }
        if k >= engines.AMDGPU_MAX_USEC_TIMEOUT { c.*.busy = MOST_ENGINES * MOST_ARRAYS }
    }
    c.*.serdes = (now(e) - started) / 1000
}

// The four idle interrupts of CP_INT_CNTL_RING0
// (gfx_v8_0_enable_gui_idle_interrupt).
fn idleBits() -> usize { return loaded.CP_INT_CNTL_RING0__CNTX_BUSY_INT_ENABLE | loaded.CP_INT_CNTL_RING0__CNTX_EMPTY_INT_ENABLE | loaded.CP_INT_CNTL_RING0__CMP_BUSY_INT_ENABLE | loaded.CP_INT_CNTL_RING0__GFX_IDLE_INT_ENABLE }

// gfx_v8_0_rlc_stop: its enable cleared, the idle interrupts off, the
// serial buses waited for (by `put` when `kept`).
fn rlcStop(e: *engines.Engines, c: *Compute, kept: bool) -> void {
    if kept {
        putField(e, c, engines.RLC_CNTL, engines.RLC_CNTL__RLC_ENABLE_F32, 0)
        put(e, c, loaded.CP_INT_CNTL_RING0, rd(e, loaded.CP_INT_CNTL_RING0) & ~idleBits())
    } else {
        wr(e, engines.RLC_CNTL, rd(e, engines.RLC_CNTL) & ~engines.RLC_CNTL__RLC_ENABLE_F32)
        wr(e, loaded.CP_INT_CNTL_RING0, rd(e, loaded.CP_INT_CNTL_RING0) & ~idleBits())
    }
    serdes(e, c)
}

// G2. Whether it passed.
pub fn rlc(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> bool {
    e.*.began = now(e)
    if c.*.g1 != engines.Outcome.passed {
        c.*.g2 = engines.Outcome.refused
        say(e, "gpu: step G2 refused: the graphics block's settings are not made (step G1)\n")
        return false
    }
    if !cool(e, c, "G2") {
        c.*.g2 = engines.Outcome.refused
        return false
    }
    const mark = c.*.count
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)
    c.*.rlcBefore[0] = rd(e, engines.RLC_CNTL)
    c.*.rlcBefore[1] = rd(e, engines.RLC_STAT)
    c.*.rlcBefore[2] = rd(e, engines.GRBM_STATUS2)
    // gfx_v8_0_rlc_init's write, then gfx_v8_0_rlc_resume: stopped, reset
    // (a pulse of GRBM_SOFT_RESET's RLC bit: not kept, it ends as it
    // began), nothing of power gating on this card, started.
    c.*.spmVmid = rd(e, engines.RLC_SPM_VMID)
    putField(e, c, engines.RLC_SPM_VMID, RLC_SPM_VMID__RLC_SPM_VMID, SPM_VMID)
    rlcStop(e, c, true)
    wr(e, GRBM_SOFT_RESET, rd(e, GRBM_SOFT_RESET) | GRBM_SOFT_RESET__SOFT_RESET_RLC)
    pause(e, 50)
    wr(e, GRBM_SOFT_RESET, rd(e, GRBM_SOFT_RESET) & ~GRBM_SOFT_RESET__SOFT_RESET_RLC)
    pause(e, 50)
    putField(e, c, engines.RLC_CNTL, engines.RLC_CNTL__RLC_ENABLE_F32, 1)
    put(e, c, loaded.CP_INT_CNTL_RING0, rd(e, loaded.CP_INT_CNTL_RING0) | idleBits())
    pause(e, 50)
    c.*.rlcAfter[0] = rd(e, engines.RLC_CNTL)
    c.*.rlcAfter[1] = rd(e, engines.RLC_STAT)
    c.*.rlcAfter[2] = rd(e, engines.GRBM_STATUS2)

    // The self-test: the RLC enabled, its SPM word, the buses idle, the
    // reset bit let go.
    var why: []const u8 = ""
    var value = NONE
    if c.*.rlcAfter[0] & engines.RLC_CNTL__RLC_ENABLE_F32 == 0 {
        why = "the RLC does not run (control "
        value = c.*.rlcAfter[0]
    } else if get(rd(e, engines.RLC_SPM_VMID), RLC_SPM_VMID__RLC_SPM_VMID) != SPM_VMID {
        why = "the SPM address space word does not hold (it reads "
        value = rd(e, engines.RLC_SPM_VMID)
    } else if c.*.busy == MOST_ENGINES * MOST_ARRAYS {
        why = "the RLC's serial buses besides the compute units' stayed busy for 100 ms ("
        value = rd(e, loaded.RLC_SERDES_NONCU_MASTER_BUSY)
    } else if c.*.busy != NONE {
        why = "the RLC's serial bus of shader engine "
    } else if rd(e, GRBM_SOFT_RESET) & GRBM_SOFT_RESET__SOFT_RESET_RLC != 0 {
        why = "the RLC's reset bit stays set ("
        value = rd(e, GRBM_SOFT_RESET)
    }
    if why.length == 0 && c.*.full { why = "more registers were to be kept than there is room for" }
    const after = temperature(e)
    const living = engines.alive(e, "G2")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    aside(e, false)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    if why.length != 0 || minded != engines.Change.none {
        c.*.g2 = engines.Outcome.failed
        say(e, "gpu: step G2 failed: ")
        if !living {
            say(e, why)
        } else if why.length != 0 && value == NONE && c.*.busy != NONE && c.*.busy < MOST_ENGINES * MOST_ARRAYS {
            num(e, why, c.*.busy / MOST_ARRAYS)
            num(e, ", array ", c.*.busy % MOST_ARRAYS)
            say(e, ", of its compute units, stayed busy for 100 ms")
        } else if why.length != 0 {
            say(e, why)
            if value != NONE {
                hex(e, value)
                say(e, ")")
            }
        } else {
            engines.sayChange(e, minded, &before, &later)
        }
        // The way back (the study's G2: stop): the RLC stopped, its words
        // as before.
        rlcStop(e, c, false)
        const back = putBack(e, c, mark)
        word(e, "; the RLC stopped (control ", rd(e, engines.RLC_CNTL))
        num(e, "), its words as before the step (", back)
        say(e, " registers)")
        degrees(e, c, after)
        took(e)
        return false
    }
    c.*.g2 = engines.Outcome.passed
    word(e, "gpu: step G2: RLC stopped, reset and started: control ", c.*.rlcAfter[0])
    word(e, " (was ", c.*.rlcBefore[0])
    word(e, "), status ", c.*.rlcAfter[1])
    word(e, " (was ", c.*.rlcBefore[1])
    word(e, "), GRBM status 2 ", c.*.rlcAfter[2])
    word(e, " (was ", c.*.rlcBefore[2])
    num(e, "), serdes idle after ", c.*.serdes)
    word(e, " us; SPM VMID ", c.*.spmVmid)
    word(e, " -> ", rd(e, engines.RLC_SPM_VMID))
    degrees(e, c, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// ---- G3: the compute processor, the KIQ, compute ring 0.

// A queue's descriptor word written into its memory.
fn mqdSet(l: *loaded.Loaded, c: *Compute, which: usize, w: usize, value: usize) -> void { memoryWrite(l, c.*.mqd[which] + w * 4, value) }

fn mqdGet(e: *engines.Engines, c: *Compute, which: usize, w: usize) -> usize { return memoryRead(e, c.*.mqd[which] + w * 4) }

// A queue's descriptor made, its queue selected (kiq_init_queue and
// kcq_init_queue: the allocation cleared, the two masks; gfx_v8_0_mqd_init
// in its order, several fields from what the queue's registers read now).
fn mqdInit(e: *engines.Engines, l: *loaded.Loaded, c: *Compute, which: usize, r: *ring.Ring) -> void {
    const mqd = c.*.mqd[which]
    var k: usize = 0
    while k < engines.AMDGPU_GPU_PAGE_SIZE {
        memoryWrite(l, mqd + k, 0)
        k += 4
    }
    memoryWrite(l, mqd + vi_mqd_allocation__dynamic_cu_mask, 0xFFFFFFFF)
    memoryWrite(l, mqd + vi_mqd_allocation__dynamic_rb_mask, 0xFFFFFFFF)
    const address = ring.gartAddress(e, mqd)
    mqdSet(l, c, which, vi_mqd__header, MQD_HEADER)
    mqdSet(l, c, which, vi_mqd__compute_pipelinestat_enable, 1)
    mqdSet(l, c, which, vi_mqd__compute_static_thread_mgmt_se0, 0xFFFFFFFF)
    mqdSet(l, c, which, vi_mqd__compute_static_thread_mgmt_se1, 0xFFFFFFFF)
    mqdSet(l, c, which, vi_mqd__compute_static_thread_mgmt_se2, 0xFFFFFFFF)
    mqdSet(l, c, which, vi_mqd__compute_static_thread_mgmt_se3, 0xFFFFFFFF)
    mqdSet(l, c, which, vi_mqd__compute_misc_reserved, 3)
    mqdSet(l, c, which, vi_mqd__dynamic_cu_mask_addr_lo, (address + vi_mqd_allocation__dynamic_cu_mask) & 0xFFFFFFFF)
    mqdSet(l, c, which, vi_mqd__dynamic_cu_mask_addr_hi, (address + vi_mqd_allocation__dynamic_cu_mask) >> 32)
    const eop = ring.gartAddress(e, c.*.eop[which]) >> 8
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_base_addr_lo, eop & 0xFFFFFFFF)
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_base_addr_hi, eop >> 32)
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_control, (rd(e, CP_HQD_EOP_CONTROL) & ~CP_HQD_EOP_CONTROL__EOP_SIZE) | field(CP_HQD_EOP_CONTROL__EOP_SIZE, order(GFX8_MEC_HPD_SIZE / 4) - 1))
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_doorbell_control, rd(e, CP_HQD_PQ_DOORBELL_CONTROL) | CP_HQD_PQ_DOORBELL_CONTROL__DOORBELL_EN)
    mqdSet(l, c, which, vi_mqd__cp_mqd_base_addr_lo, address & 0xFFFFFFFC)
    mqdSet(l, c, which, vi_mqd__cp_mqd_base_addr_hi, address >> 32)
    mqdSet(l, c, which, vi_mqd__cp_mqd_control, rd(e, CP_MQD_CONTROL) & ~CP_MQD_CONTROL__VMID)
    const base = r.*.address >> 8
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_base_lo, base & 0xFFFFFFFF)
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_base_hi, base >> 32)
    var control = rd(e, CP_HQD_PQ_CONTROL)
    control = (control & ~CP_HQD_PQ_CONTROL__QUEUE_SIZE) | field(CP_HQD_PQ_CONTROL__QUEUE_SIZE, order(r.*.words) - 1)
    control = (control & ~CP_HQD_PQ_CONTROL__RPTR_BLOCK_SIZE) | field(CP_HQD_PQ_CONTROL__RPTR_BLOCK_SIZE, order(engines.AMDGPU_GPU_PAGE_SIZE / 4) - 1)
    control = control & ~(CP_HQD_PQ_CONTROL__UNORD_DISPATCH | CP_HQD_PQ_CONTROL__ROQ_PQ_IB_FLIP)
    control = control | CP_HQD_PQ_CONTROL__PRIV_STATE | CP_HQD_PQ_CONTROL__KMD_QUEUE
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_control, control)
    const rptr = r.*.recordAddress + ring.RPTR_SLOT
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_rptr_report_addr_lo, rptr & 0xFFFFFFFC)
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_rptr_report_addr_hi, (rptr >> 32) & 0xFFFF)
    const wptr = r.*.recordAddress + ring.WPTR_SLOT
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_wptr_poll_addr_lo, wptr & 0xFFFFFFFC)
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_wptr_poll_addr_hi, (wptr >> 32) & 0xFFFF)
    var doorbell = rd(e, CP_HQD_PQ_DOORBELL_CONTROL)
    doorbell = (doorbell & ~CP_HQD_PQ_DOORBELL_CONTROL__DOORBELL_OFFSET) | field(CP_HQD_PQ_DOORBELL_CONTROL__DOORBELL_OFFSET, r.*.doorbell)
    doorbell = (doorbell | CP_HQD_PQ_DOORBELL_CONTROL__DOORBELL_EN) & ~(CP_HQD_PQ_DOORBELL_CONTROL__DOORBELL_SOURCE | CP_HQD_PQ_DOORBELL_CONTROL__DOORBELL_HIT)
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_doorbell_control, doorbell)
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_wptr, 0)
    mqdSet(l, c, which, vi_mqd__cp_hqd_pq_rptr, rd(e, engines.CP_HQD_PQ_RPTR))
    mqdSet(l, c, which, vi_mqd__cp_hqd_vmid, 0)
    mqdSet(l, c, which, vi_mqd__cp_hqd_persistent_state, (rd(e, CP_HQD_PERSISTENT_STATE) & ~CP_HQD_PERSISTENT_STATE__PRELOAD_SIZE) | field(CP_HQD_PERSISTENT_STATE__PRELOAD_SIZE, PRELOAD_SIZE))
    mqdSet(l, c, which, vi_mqd__cp_hqd_ib_control, (rd(e, CP_HQD_IB_CONTROL) & ~(CP_HQD_IB_CONTROL__MIN_IB_AVAIL_SIZE | CP_HQD_IB_CONTROL__MTYPE)) | field(CP_HQD_IB_CONTROL__MIN_IB_AVAIL_SIZE, 3) | field(CP_HQD_IB_CONTROL__MTYPE, 3))
    mqdSet(l, c, which, vi_mqd__cp_hqd_iq_timer, (rd(e, CP_HQD_IQ_TIMER) & ~CP_HQD_IQ_TIMER__MTYPE) | field(CP_HQD_IQ_TIMER__MTYPE, 3))
    mqdSet(l, c, which, vi_mqd__cp_hqd_ctx_save_control, (rd(e, CP_HQD_CTX_SAVE_CONTROL) & ~CP_HQD_CTX_SAVE_CONTROL__MTYPE) | field(CP_HQD_CTX_SAVE_CONTROL__MTYPE, 3))
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_rptr, rd(e, CP_HQD_EOP_RPTR))
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_wptr, rd(e, CP_HQD_EOP_WPTR))
    mqdSet(l, c, which, vi_mqd__cp_hqd_ctx_save_base_addr_lo, rd(e, CP_HQD_CTX_SAVE_BASE_ADDR_LO))
    mqdSet(l, c, which, vi_mqd__cp_hqd_ctx_save_base_addr_hi, rd(e, CP_HQD_CTX_SAVE_BASE_ADDR_HI))
    mqdSet(l, c, which, vi_mqd__cp_hqd_cntl_stack_offset, rd(e, CP_HQD_CNTL_STACK_OFFSET))
    mqdSet(l, c, which, vi_mqd__cp_hqd_cntl_stack_size, rd(e, CP_HQD_CNTL_STACK_SIZE))
    mqdSet(l, c, which, vi_mqd__cp_hqd_wg_state_offset, rd(e, CP_HQD_WG_STATE_OFFSET))
    mqdSet(l, c, which, vi_mqd__cp_hqd_ctx_save_size, rd(e, CP_HQD_CTX_SAVE_SIZE))
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_done_events, rd(e, CP_HQD_EOP_EVENTS))
    mqdSet(l, c, which, vi_mqd__cp_hqd_error, rd(e, CP_HQD_ERROR))
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_wptr_mem, rd(e, CP_HQD_EOP_WPTR_MEM))
    mqdSet(l, c, which, vi_mqd__cp_hqd_eop_dones, rd(e, CP_HQD_EOP_DONES))
    mqdSet(l, c, which, vi_mqd__cp_hqd_quantum, rd(e, CP_HQD_QUANTUM))
    if r.*.kind == ring.Kind.kiq { mqdSet(l, c, which, vi_mqd__cp_hqd_active, 1) }
}

// The descriptor's word of a queue register (word 128 + k is register
// CP_MQD_BASE_ADDR + k).
fn mqdWordOf(number: usize) -> usize { return number - CP_MQD_BASE_ADDR + vi_mqd__cp_mqd_base_addr_lo }

// gfx_v8_0_mqd_commit: the queue's registers written from its descriptor
// by the driver (the KIQ's), in Linux's order: the write pointer's polling
// off, CP_HQD_VMID to CP_HQD_EOP_CONTROL, the end-of-pipe pointers, the
// events to the error word, and last the descriptor's address and
// "activate the HQD".
fn mqdCommit(e: *engines.Engines, c: *Compute, which: usize) -> void {
    put(e, c, CP_PQ_WPTR_POLL_CNTL, rd(e, CP_PQ_WPTR_POLL_CNTL) & ~CP_PQ_WPTR_POLL_CNTL__EN)
    var number = CP_HQD_VMID
    while number <= CP_HQD_EOP_CONTROL {
        put(e, c, number, mqdGet(e, c, which, mqdWordOf(number)))
        number += 1
    }
    put(e, c, CP_HQD_EOP_RPTR, mqdGet(e, c, which, vi_mqd__cp_hqd_eop_rptr))
    put(e, c, CP_HQD_EOP_WPTR, mqdGet(e, c, which, vi_mqd__cp_hqd_eop_wptr))
    put(e, c, CP_HQD_EOP_WPTR_MEM, mqdGet(e, c, which, vi_mqd__cp_hqd_eop_wptr_mem))
    number = CP_HQD_EOP_EVENTS
    while number <= CP_HQD_ERROR {
        put(e, c, number, mqdGet(e, c, which, mqdWordOf(number)))
        number += 1
    }
    number = CP_MQD_BASE_ADDR
    while number <= engines.CP_HQD_ACTIVE {
        put(e, c, number, mqdGet(e, c, which, mqdWordOf(number)))
        number += 1
    }
}

// The memory the rings take (once a boot), whether there is room: the
// write-back page, three rings, two descriptors, two end-of-pipe buffers,
// the indirect buffers' page.
fn memory(e: *engines.Engines, c: *Compute) -> bool {
    if c.*.writeBack == 0 { c.*.writeBack = dma(e, engines.AMDGPU_GPU_PAGE_SIZE) }
    var k: usize = 0
    while k < 3 {
        if c.*.rings[k] == 0 { c.*.rings[k] = dma(e, RING_BYTES) }
        k += 1
    }
    k = 0
    while k < 2 {
        if c.*.mqd[k] == 0 { c.*.mqd[k] = dma(e, engines.AMDGPU_GPU_PAGE_SIZE) }
        if c.*.eop[k] == 0 { c.*.eop[k] = dma(e, GFX8_MEC_HPD_SIZE) }
        k += 1
    }
    if c.*.buffers == 0 { c.*.buffers = dma(e, engines.AMDGPU_GPU_PAGE_SIZE) }
    const end = e.*.card.dmaBase + engines.DMA_PAGES * engines.AMDGPU_GPU_PAGE_SIZE
    return c.*.writeBack != 0 && c.*.rings[0] != 0 && c.*.rings[1] != 0 && c.*.rings[2] != 0 && c.*.mqd[0] != 0 && c.*.mqd[1] != 0 && c.*.eop[0] != 0 && c.*.eop[1] != 0 && c.*.buffers != 0 && c.*.buffers + engines.AMDGPU_GPU_PAGE_SIZE <= end && c.*.rings[2] + RING_BYTES <= end && c.*.eop[1] + GFX8_MEC_HPD_SIZE <= end
}

// The KIQ's first submission (gfx_v8_0_kiq_kcq_enable for compute ring 0
// alone): SET_RESOURCES with ring 0's bit as the queue mask, MAP_QUEUES
// with ring 0's doorbell, queue, pipe, micro engine, descriptor and write
// pointer's address; committed.
fn mapQueue(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> void {
    const k = &c.*.kiq
    const r = &c.*.compute
    // A queue's bit: micro engine index x 32 + pipe x 8 + queue
    // (amdgpu_gfx_mec_queue_to_bit).
    const bit = (r.*.me - 1) * 32 + r.*.pipe * 8 + r.*.queue
    const mask = @intCast(usize, 1) << @intCast(u6, bit)
    ring.emit(l, k, ring.packet3(ring.PACKET3_SET_RESOURCES, 6))
    ring.emit(l, k, 0)
    ring.emit(l, k, mask & 0xFFFFFFFF)
    ring.emit(l, k, mask >> 32)
    ring.emit(l, k, 0)
    ring.emit(l, k, 0)
    ring.emit(l, k, 0)
    ring.emit(l, k, 0)
    const mqd = ring.gartAddress(e, c.*.mqd[1])
    const wptr = r.*.recordAddress + ring.WPTR_SLOT
    const me: usize = if r.*.me == 1 { 0 } else { 1 }
    ring.emit(l, k, ring.packet3(ring.PACKET3_MAP_QUEUES, 5))
    ring.emit(l, k, @intCast(usize, 1) << @intCast(u6, ring.PACKET3_MAP_QUEUES_NUM_QUEUES_SHIFT))
    ring.emit(l, k, (r.*.doorbell << @intCast(u6, ring.PACKET3_MAP_QUEUES_DOORBELL_OFFSET_SHIFT)) | (r.*.queue << @intCast(u6, ring.PACKET3_MAP_QUEUES_QUEUE_SHIFT)) | (r.*.pipe << @intCast(u6, ring.PACKET3_MAP_QUEUES_PIPE_SHIFT)) | (me << @intCast(u6, ring.PACKET3_MAP_QUEUES_ME_SHIFT)))
    ring.emit(l, k, mqd & 0xFFFFFFFF)
    ring.emit(l, k, mqd >> 32)
    ring.emit(l, k, wptr & 0xFFFFFFFF)
    ring.emit(l, k, wptr >> 32)
    ring.commit(e, l, k)
}

// Whether the map was taken: ring 0's queue active (looked at with it
// selected), 100 ms at most (`c.mapWaited`: microseconds). The KIQ's read
// pointer is not waited for: Linux never waits on the read pointer a
// queue writes back, and how often the card writes it is the card's (a
// failure says it, with the KIQ's state).
fn mapTaken(e: *engines.Engines, c: *Compute) -> bool {
    const started = now(e)
    var k: usize = 0
    while k < engines.AMDGPU_MAX_USEC_TIMEOUT {
        wr(e, engines.SRBM_GFX_CNTL, engines.queue(RING0_ME, RING0_PIPE, RING0_QUEUE))
        const active = rd(e, engines.CP_HQD_ACTIVE)
        wr(e, engines.SRBM_GFX_CNTL, 0)
        if active & engines.CP_HQD_ACTIVE__ACTIVE != 0 {
            c.*.mapWaited = (now(e) - started) / 1000
            return true
        }
        pause(e, 100)
        k += 100
    }
    c.*.mapWaited = (now(e) - started) / 1000
    return false
}

// The graphics ring started (the second trial; gfx_v8_0_cp_gfx_resume and
// gfx_v8_0_cp_gfx_start without stage 6's DMIF_ADDR_CALC and
// HDP_ADDR_CONFIG): its registers, its doorbell, the ring cleared, the
// command processor's three words, PFP, ME and CE unhalted, the first
// submission (the clear state, the raster configuration as shader engine
// 0 reads it, the constant engine's partition).
pub fn graphicsStart(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> void {
    const g = &c.*.graphics
    put(e, c, CP_RB_WPTR_DELAY, 0)
    put(e, c, CP_RB_VMID, 0)
    const size = order(RING_BYTES / 8)
    const control = field(CP_RB0_CNTL__RB_BUFSZ, size) | field(CP_RB0_CNTL__RB_BLKSZ, size - 2) | field(CP_RB0_CNTL__MTYPE, 3) | field(CP_RB0_CNTL__MIN_IB_AVAILSZ, 1)
    put(e, c, CP_RB0_CNTL, control)
    put(e, c, CP_RB0_CNTL, control | CP_RB0_CNTL__RB_RPTR_WR_ENA)
    g.*.wptr = 0
    put(e, c, ring.CP_RB0_WPTR, 0)
    const rptr = g.*.recordAddress + ring.RPTR_SLOT
    put(e, c, CP_RB0_RPTR_ADDR, rptr & 0xFFFFFFFF)
    put(e, c, CP_RB0_RPTR_ADDR_HI, (rptr >> 32) & 0xFF)
    const wptr = g.*.recordAddress + ring.WPTR_SLOT
    put(e, c, CP_RB_WPTR_POLL_ADDR_LO, wptr & 0xFFFFFFFF)
    put(e, c, CP_RB_WPTR_POLL_ADDR_HI, wptr >> 32)
    pause(e, 1000)
    put(e, c, CP_RB0_CNTL, control)
    const base = g.*.address >> 8
    put(e, c, CP_RB0_BASE, base & 0xFFFFFFFF)
    put(e, c, CP_RB0_BASE_HI, base >> 32)
    var doorbell = rd(e, CP_RB_DOORBELL_CONTROL)
    doorbell = (doorbell & ~CP_RB_DOORBELL_CONTROL__DOORBELL_OFFSET) | field(CP_RB_DOORBELL_CONTROL__DOORBELL_OFFSET, AMDGPU_DOORBELL_GFX_RING0)
    doorbell = (doorbell & ~CP_RB_DOORBELL_CONTROL__DOORBELL_HIT) | CP_RB_DOORBELL_CONTROL__DOORBELL_EN
    put(e, c, CP_RB_DOORBELL_CONTROL, doorbell)
    put(e, c, CP_RB_DOORBELL_RANGE_LOWER, field(CP_RB_DOORBELL_RANGE_LOWER__DOORBELL_RANGE_LOWER, AMDGPU_DOORBELL_GFX_RING0))
    put(e, c, CP_RB_DOORBELL_RANGE_UPPER, CP_RB_DOORBELL_RANGE_UPPER__DOORBELL_RANGE_UPPER)
    ring.clear(l, g)
    put(e, c, CP_MAX_CONTEXT, MAX_CONTEXT)
    put(e, c, CP_ENDIAN_SWAP, 0)
    put(e, c, CP_DEVICE_ID, DEVICE_ID)
    put(e, c, engines.CP_ME_CNTL, rd(e, engines.CP_ME_CNTL) & ~(engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT))
    pause(e, 50)
    g.*.up = true
    ring.emit(l, g, ring.packet3(ring.PACKET3_PREAMBLE_CNTL, 0))
    ring.emit(l, g, ring.PACKET3_PREAMBLE_BEGIN_CLEAR_STATE)
    ring.emit(l, g, ring.packet3(ring.PACKET3_CONTEXT_CONTROL, 1))
    ring.emit(l, g, CONTEXT_CONTROL_WORD)
    ring.emit(l, g, CONTEXT_CONTROL_WORD)
    var at: usize = 0
    var run: usize = 0
    while run < clear.RUN_FIRST.length {
        ring.emit(l, g, ring.packet3(ring.PACKET3_SET_CONTEXT_REG, clear.RUN_COUNT[run]))
        ring.emit(l, g, clear.RUN_FIRST[run] - ring.PACKET3_SET_CONTEXT_REG_START)
        var k: usize = 0
        while k < clear.RUN_COUNT[run] {
            ring.emit(l, g, @intCast(usize, clear.VALUES[at]))
            at += 1
            k += 1
        }
        run += 1
    }
    ring.emit(l, g, ring.packet3(ring.PACKET3_SET_CONTEXT_REG, 2))
    ring.emit(l, g, PA_SC_RASTER_CONFIG - ring.PACKET3_SET_CONTEXT_REG_START)
    ring.emit(l, g, c.*.rasterRead[0])
    ring.emit(l, g, c.*.rasterRead[1])
    ring.emit(l, g, ring.packet3(ring.PACKET3_PREAMBLE_CNTL, 0))
    ring.emit(l, g, ring.PACKET3_PREAMBLE_END_CLEAR_STATE)
    ring.emit(l, g, ring.packet3(ring.PACKET3_CLEAR_STATE, 0))
    ring.emit(l, g, 0)
    ring.emit(l, g, ring.packet3(ring.PACKET3_SET_BASE, 2))
    ring.emit(l, g, ring.CE_PARTITION_BASE << @intCast(u6, ring.PACKET3_BASE_INDEX_SHIFT))
    ring.emit(l, g, CE_PARTITION)
    ring.emit(l, g, CE_PARTITION)
    ring.commit(e, l, g)
}

// A queue let go by registers (gfx_v8_0_deactivate_hqd with 2, as Linux's
// pre-reset does; the study's 8.7): when active, a dequeue asked and
// waited for, 100000 microseconds at most; then, active or not, the
// request and both pointers 0. Whether it let go.
fn deactivate(e: *engines.Engines, me: usize, pipe: usize, queue: usize) -> bool {
    var free = true
    wr(e, engines.SRBM_GFX_CNTL, engines.queue(me, pipe, queue))
    if rd(e, engines.CP_HQD_ACTIVE) & engines.CP_HQD_ACTIVE__ACTIVE != 0 {
        wr(e, engines.CP_HQD_DEQUEUE_REQUEST, (rd(e, engines.CP_HQD_DEQUEUE_REQUEST) & ~engines.CP_HQD_DEQUEUE_REQUEST__DEQUEUE_REQ) | field(engines.CP_HQD_DEQUEUE_REQUEST__DEQUEUE_REQ, 2))
        var k: usize = 0
        while rd(e, engines.CP_HQD_ACTIVE) & engines.CP_HQD_ACTIVE__ACTIVE != 0 && k < engines.AMDGPU_MAX_USEC_TIMEOUT {
            pause(e, 1)
            k += 1
        }
        free = k < engines.AMDGPU_MAX_USEC_TIMEOUT
    }
    wr(e, engines.CP_HQD_DEQUEUE_REQUEST, 0)
    wr(e, engines.CP_HQD_PQ_RPTR, 0)
    wr(e, engines.CP_HQD_PQ_WPTR, 0)
    wr(e, engines.SRBM_GFX_CNTL, 0)
    return free
}

// The compute queues taken back through the KIQ (gfx_v8_0_kcq_disable for
// ring 0: UNMAP_QUEUES "reset queues", then the KIQ's ring test). Whether
// the KIQ answered.
fn unmap(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> bool {
    const k = &c.*.kiq
    ring.emit(l, k, ring.packet3(ring.PACKET3_UNMAP_QUEUES, 4))
    ring.emit(l, k, (RESET_QUEUES << @intCast(u6, ring.PACKET3_UNMAP_QUEUES_ACTION_SHIFT)) | (@intCast(usize, 1) << @intCast(u6, ring.PACKET3_UNMAP_QUEUES_NUM_QUEUES_SHIFT)))
    ring.emit(l, k, c.*.compute.doorbell << @intCast(u6, ring.PACKET3_UNMAP_QUEUES_DOORBELL_OFFSET0_SHIFT))
    ring.emit(l, k, 0)
    ring.emit(l, k, 0)
    ring.emit(l, k, 0)
    return ring.ringTest(e, l, k)
}

// The processors halted (gfx_v8_0_cp_enable(false): the graphics
// processors' three bits, both compute processors', 50 us after each).
fn halt(e: *engines.Engines) -> void {
    wr(e, engines.CP_ME_CNTL, rd(e, engines.CP_ME_CNTL) | engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT)
    pause(e, 50)
    wr(e, engines.CP_MEC_CNTL, engines.CP_MEC_CNTL__MEC_ME1_HALT | engines.CP_MEC_CNTL__MEC_ME2_HALT)
    pause(e, 50)
}

// One trial of G3 (`second`: with the graphics ring before the map), from
// `mark`; the reason it did not pass ("" when it did) and the value that
// tells it (NONE: none), `which` the ring whose state tells it (NONE:
// none).
fn trial(e: *engines.Engines, l: *loaded.Loaded, c: *Compute, second: bool, value: *usize, which: *usize) -> []const u8 {
    value.* = NONE
    which.* = NONE
    c.*.second = second
    c.*.mapped = false
    ring.begin(e, &c.*.kiq, ring.Kind.kiq, KIQ_ME, KIQ_PIPE, KIQ_QUEUE, c.*.rings[0], RING_BYTES / 4, c.*.writeBack + KIQ_RECORD, AMDGPU_DOORBELL_KIQ)
    ring.begin(e, &c.*.compute, ring.Kind.compute, RING0_ME, RING0_PIPE, RING0_QUEUE, c.*.rings[1], RING_BYTES / 4, c.*.writeBack + RING0_RECORD, AMDGPU_DOORBELL_MEC_RING0)
    ring.begin(e, &c.*.graphics, ring.Kind.graphics, 0, 0, 0, c.*.rings[2], RING_BYTES / 4, c.*.writeBack + GRAPHICS_RECORD, AMDGPU_DOORBELL_GFX_RING0)
    ring.clear(l, &c.*.kiq)
    ring.clear(l, &c.*.compute)
    var k: usize = 0
    while k < 2 {
        var b: usize = 0
        while b < GFX8_MEC_HPD_SIZE {
            memoryWrite(l, c.*.eop[k] + b, 0)
            b += 4
        }
        k += 1
    }
    // gfx_v8_0_cp_resume: the idle interrupts off; the KIQ
    // (gfx_v8_0_kiq_resume: named to the RLC, its descriptor, its
    // registers from it with its queue selected).
    put(e, c, loaded.CP_INT_CNTL_RING0, rd(e, loaded.CP_INT_CNTL_RING0) & ~idleBits())
    var schedulers = rd(e, engines.RLC_CP_SCHEDULERS) & 0xFFFFFF00
    schedulers |= (KIQ_ME << 5) | (KIQ_PIPE << 3) | KIQ_QUEUE
    put(e, c, engines.RLC_CP_SCHEDULERS, schedulers)
    put(e, c, engines.RLC_CP_SCHEDULERS, schedulers | 0x80)
    put(e, c, engines.SRBM_GFX_CNTL, engines.queue(KIQ_ME, KIQ_PIPE, KIQ_QUEUE))
    mqdInit(e, l, c, 0, &c.*.kiq)
    mqdCommit(e, c, 0)
    put(e, c, engines.SRBM_GFX_CNTL, 0)
    c.*.kiq.up = true
    // The second trial: the graphics ring (gfx_v8_0_cp_gfx_resume, in
    // Linux's order between the KIQ and the compute queues).
    if second { graphicsStart(e, l, c) }
    // gfx_v8_0_kcq_resume: the compute processor unhalted, ring 0's
    // descriptor with its queue selected, the doorbells' range and on, the
    // KIQ's first submission.
    put(e, c, engines.CP_MEC_CNTL, 0)
    pause(e, 50)
    put(e, c, engines.SRBM_GFX_CNTL, engines.queue(RING0_ME, RING0_PIPE, RING0_QUEUE))
    mqdInit(e, l, c, 1, &c.*.compute)
    put(e, c, engines.SRBM_GFX_CNTL, 0)
    put(e, c, CP_MEC_DOORBELL_RANGE_LOWER, AMDGPU_DOORBELL_KIQ << 2)
    put(e, c, CP_MEC_DOORBELL_RANGE_UPPER, AMDGPU_DOORBELL_MEC_RING7 << 2)
    put(e, c, engines.CP_PQ_STATUS, rd(e, engines.CP_PQ_STATUS) | CP_PQ_STATUS__DOORBELL_ENABLE)
    mapQueue(e, l, c)
    c.*.mapped = mapTaken(e, c)
    if !c.*.mapped {
        which.* = 0
        return "the KIQ did not take the map within 100 ms (compute ring 0's queue is not active; KIQ: "
    }
    c.*.compute.up = true
    // gfx_v8_0_cp_test_all_rings: the graphics ring (the second trial's),
    // the KIQ, the compute ring; then the idle interrupts on again.
    if second {
        if !ring.ringTest(e, l, &c.*.graphics) {
            which.* = 2
            return "the graphics ring did not write the scratch register within 100 ms ("
        }
        c.*.graphicsWaited = c.*.graphics.waited
    }
    if !ring.ringTest(e, l, &c.*.kiq) {
        which.* = 0
        return "the KIQ did not write the scratch register within 100 ms ("
    }
    c.*.kiqWaited = c.*.kiq.waited
    if !ring.ringTest(e, l, &c.*.compute) {
        which.* = 1
        return "compute ring 0 did not write the scratch register within 100 ms ("
    }
    c.*.ringWaited = c.*.compute.waited
    // The read pointer ring 0 writes back, given the test's time to come to
    // its write pointer.
    k = 0
    while ring.readPointer(e, &c.*.compute) != c.*.compute.wptr && k < engines.AMDGPU_MAX_USEC_TIMEOUT {
        pause(e, 1)
        k += 1
    }
    if ring.readPointer(e, &c.*.compute) != c.*.compute.wptr {
        which.* = 1
        return "compute ring 0's read pointer is not its write pointer ("
    }
    put(e, c, loaded.CP_INT_CNTL_RING0, rd(e, loaded.CP_INT_CNTL_RING0) | idleBits())
    if c.*.full { return "more registers were to be kept than there is room for" }
    return ""
}

// G3's way back: ring 0 taken back through the KIQ when the KIQ answers,
// the queues let go by registers, the processors halted, every register
// the step wrote as it was. How many registers.
fn queuesBack(e: *engines.Engines, l: *loaded.Loaded, c: *Compute, mark: usize, kiqAnswers: bool) -> usize {
    if kiqAnswers && c.*.mapped { _ = unmap(e, l, c) }
    _ = deactivate(e, RING0_ME, RING0_PIPE, RING0_QUEUE)
    _ = deactivate(e, KIQ_ME, KIQ_PIPE, KIQ_QUEUE)
    halt(e)
    c.*.kiq.up = false
    c.*.compute.up = false
    c.*.graphics.up = false
    return putBack(e, c, mark)
}

// The ring that tells why, said.
fn sayRing(e: *engines.Engines, c: *Compute, which: usize) -> void {
    if which == 0 { ring.sayState(e, &c.*.kiq) }
    if which == 1 { ring.sayState(e, &c.*.compute) }
    if which == 2 { ring.sayState(e, &c.*.graphics) }
}

// G3. Whether it passed.
pub fn queues(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> bool {
    e.*.began = now(e)
    if c.*.g2 != engines.Outcome.passed {
        c.*.g3 = engines.Outcome.refused
        say(e, "gpu: step G3 refused: the RLC is not started (step G2)\n")
        return false
    }
    if !l.*.doorbellsOn || l.*.more.doorbells <= AMDGPU_DOORBELL_GFX_RING0 {
        c.*.g3 = engines.Outcome.refused
        say(e, "gpu: step G3 refused: the KIQ and the compute rings are told their write pointer by doorbell, and the doorbells are not on (step D2)\n")
        return false
    }
    if !memory(e, c) {
        c.*.g3 = engines.Outcome.refused
        say(e, "gpu: step G3 refused: no room for the rings, their descriptors and buffers in the memory set aside for the card\n")
        return false
    }
    if !cool(e, c, "G3") {
        c.*.g3 = engines.Outcome.refused
        return false
    }
    const mark = c.*.count
    c.*.full = false
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)
    var value: usize = NONE
    var which: usize = NONE
    var why = trial(e, l, c, false, &value, &which)
    var second = false
    if why.length != 0 && !c.*.mapped && !faulted(e) {
        // The study's second trial: what the first wrote put back, then
        // Linux's order with the graphics ring before the map.
        say(e, "gpu: the KIQ did not take the map: KIQ ")
        ring.sayState(e, &c.*.kiq)
        say(e, "; everything of the trial put back, the second trial (Linux's order with the graphics ring and its clear state before the map) follows\n")
        _ = queuesBack(e, l, c, mark, false)
        second = true
        why = trial(e, l, c, true, &value, &which)
    }
    var fault = false
    if why.length == 0 && faulted(e) {
        why = "a fault"
        fault = true
    }
    const after = temperature(e)
    const living = engines.alive(e, "G3")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    aside(e, false)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    if why.length != 0 || minded != engines.Change.none {
        c.*.g3 = engines.Outcome.failed
        say(e, "gpu: step G3 failed: ")
        if !living {
            say(e, why)
        } else if why.length == 0 {
            engines.sayChange(e, minded, &before, &later)
        } else if fault {
            sayFault(e)
        } else {
            say(e, why)
            if which != NONE {
                sayRing(e, c, which)
                say(e, ")")
            }
        }
        if second { say(e, "; in the second trial (the graphics ring before the map) as well") }
        // The way back (5.11): the KIQ asked to take ring 0 back when it
        // answers, the queues let go, the processors halted, every register
        // as before.
        const back = queuesBack(e, l, c, mark, c.*.mapped && which != 0)
        word(e, "; the processors halted (ME ", rd(e, engines.CP_ME_CNTL))
        word(e, ", MEC ", rd(e, engines.CP_MEC_CNTL))
        num(e, "), the queues let go, their words as before the step (", back)
        say(e, " registers)")
        degrees(e, c, after)
        took(e)
        return false
    }
    c.*.g3 = engines.Outcome.passed
    say(e, "gpu: step G3: KIQ (2.1.0) answers after ")
    decimal(e, c.*.kiqWaited)
    say(e, " us; compute ring 0 (1.0.0) mapped through it after ")
    decimal(e, c.*.mapWaited)
    num(e, " us and answers after ", c.*.ringWaited)
    say(e, " us, its doorbell ")
    hex(e, AMDGPU_DOORBELL_MEC_RING0)
    if second {
        num(e, "; in the second trial: the graphics ring and its clear state first (it answers after ", c.*.graphicsWaited)
        say(e, " us), as Linux's order has it")
    } else {
        say(e, "; Linux's order without the graphics ring")
    }
    degrees(e, c, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// ---- G4: an indirect buffer, its fence at the end of the pipe, its
// interrupt.

// G4. Whether it passed.
pub fn endOfPipe(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> bool {
    e.*.began = now(e)
    if c.*.g3 != engines.Outcome.passed || !c.*.compute.up {
        c.*.g4 = engines.Outcome.refused
        say(e, "gpu: step G4 refused: compute ring 0 does not run (step G3)\n")
        return false
    }
    if c.*.compute.refused || c.*.compute.hung {
        c.*.g4 = engines.Outcome.refused
        say(e, "gpu: step G4 refused: compute ring 0 takes no new work now (the temperature's mark, or it did not come to a fence)\n")
        return false
    }
    if !cool(e, c, "G4") {
        c.*.g4 = engines.Outcome.refused
        return false
    }
    const mark = c.*.count
    c.*.full = false
    aside(e, true)
    var before: engines.Picture = undefined
    engines.look(e, &before)
    const counted = e.*.hands.interrupts
    const waiting = e.*.hands.waiting
    const taken = counted()
    const waitedBefore = waiting()
    const r = &c.*.compute
    const entriesBefore = r.*.entries
    // The end-of-pipe interrupt of micro engine 1's pipe 0
    // (gfx_v8_0_set_compute_eop_interrupt_state, as
    // amdgpu_fence_driver_hw_init asks before the tests).
    put(e, c, CP_ME1_PIPE0_INT_CNTL, rd(e, CP_ME1_PIPE0_INT_CNTL) | CP_INT_CNTL_RING0__TIME_STAMP_INT_ENABLE)
    // Linux's indirect buffer test (gfx_v8_0_ring_test_ib): a write-back
    // word 0xcafedead; five words that write 0xdeadbeef to it; the frame,
    // the fence, the wait (1000 ms, AMDGPU_IB_TEST_TIMEOUT).
    const check = c.*.writeBack + IB_TEST_AT
    memoryWrite(l, check, loaded.TEST_BEFORE)
    const address = ring.gartAddress(e, check)
    const buffer = c.*.buffers
    const words = [_]usize{ ring.packet3(ring.PACKET3_WRITE_DATA, 3), (DST_MEMORY << @intCast(u6, ring.WRITE_DATA_DST_SEL_SHIFT)) | ring.WR_CONFIRM, address & 0xFFFFFFFF, address >> 32, loaded.TEST_WRITTEN }
    var k: usize = 0
    while k < words.length {
        memoryWrite(l, buffer + k * 4, words[k])
        k += 1
    }
    var why: []const u8 = ""
    var bad = NONE
    const fence = ring.submit(e, l, r, ring.gartAddress(e, buffer), words.length, 0)
    if fence == ring.NONE {
        why = "compute ring 0 took no submission"
    } else {
        c.*.how = ring.wait(e, l, r, fence, true, loaded.IB_TEST_TIMEOUT_MS)
        if c.*.how == ring.Waited.done && memoryRead(e, check) != loaded.TEST_WRITTEN {
            why = "the indirect buffer's word reads "
            bad = memoryRead(e, check)
        } else if c.*.how != ring.Waited.done {
            why = "compute ring 0's indirect buffer test did not end: "
        }
    }
    const interrupted = counted() != taken || (!waitedBefore && waiting())
    if why.length == 0 && e.*.routed && !interrupted && !waitedBefore { why = "the end-of-pipe entry came and its interrupt did not" }
    const fault = why.length == 0 && faulted(e)
    if fault { why = "a fault" }
    if why.length == 0 && c.*.full { why = "more registers were to be kept than there is room for" }
    const after = temperature(e)
    const living = engines.alive(e, "G4")
    var later: engines.Picture = undefined
    engines.look(e, &later)
    aside(e, false)
    const minded = engines.changed(&before, &later)
    if !living { why = "the card no longer answers as it did" }
    if why.length != 0 || minded != engines.Change.none {
        c.*.g4 = engines.Outcome.failed
        say(e, "gpu: step G4 failed: ")
        if !living {
            say(e, why)
        } else if why.length == 0 {
            engines.sayChange(e, minded, &before, &later)
        } else if bad != NONE {
            say(e, why)
            hex(e, bad)
            word(e, " where ", loaded.TEST_WRITTEN)
            say(e, " was written")
        } else if fence != ring.NONE && c.*.how != ring.Waited.done {
            say(e, why)
            ring.sayWaited(e, r, c.*.how)
        } else if fault {
            sayFault(e)
        } else {
            say(e, why)
        }
        // The way back: the interrupt's word as it was; a ring that did not
        // come to its fence takes no new work.
        const back = putBack(e, c, mark)
        num(e, "; the end-of-pipe interrupt's word as before (", back)
        say(e, if r.*.hung { " registers); compute ring 0 takes no new work" } else { " registers)" })
        degrees(e, c, after)
        took(e)
        return false
    }
    c.*.g4 = engines.Outcome.passed
    num(e, "gpu: step G4: an indirect buffer of ", words.length)
    num(e, " words ran on compute ring 0: memory written, fence ", fence)
    num(e, ", end-of-pipe entry (source ", ring.VISLANDS30_IV_SRCID_CP_END_OF_PIPE)
    word(e, ", ring ", RING0_ID)
    num(e, ") after ", r.*.waited)
    say(e, " us")
    if r.*.entries - entriesBefore != 1 { num(e, " (entries: ", r.*.entries - entriesBefore) }
    if r.*.entries - entriesBefore != 1 { say(e, ")") }
    if !e.*.routed {
        say(e, ", no interrupt (the card has neither MSI nor MSI-X)")
    } else {
        num(e, ", interrupts taken: ", counted() - taken)
        if !waitedBefore && waiting() { say(e, ", one waits at the processor (interrupts are off while the kernel starts)") }
        if waitedBefore { say(e, ", one of the card's waited at the processor before (a new one cannot be told from it)") }
    }
    degrees(e, c, after)
    engines.sayWatch(e, &before)
    took(e)
    return true
}

// ---- The stages of a boot, the way down, the watch.

// Stages 3 to 5 as far as `e.stage`, after stage 2 passed, each step only
// after the one before it passed; D1's second order when the digit asks
// for 5 or more.
pub fn run(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> void {
    if e.*.stage < 3 || e.*.i1 != engines.Outcome.passed { return }
    if !loaded.smcFirmware(e, l) {
        if l.*.f1 == engines.Outcome.failed {
            num(e, "gpu: the card's temperature is watched by the kernel from now on, once a second (the SMC is held in reset): ", temperature(e))
            say(e, " C now\n")
        }
        return
    }
    if !loaded.engineFirmware(e, l) { return }
    if e.*.stage < 4 { return }
    if !loaded.firstEngine(e, l) {
        if e.*.stage < 5 || !l.*.unread { return }
        say(e, "gpu: copy engine 0 did not read its ring: Linux's order follows, the graphics block's settings and the RLC first (G1 and G2), then D1 once more\n")
        if !settings(e, l, c) { return }
        if !rlc(e, l, c) { return }
        if !loaded.firstEngine(e, l) {
            say(e, "gpu: D1 failed in Linux's order as well (G1 and G2 first)\n")
            return
        }
        say(e, "gpu: D1 passed in Linux's order (G1 and G2 first): the copy engines need the graphics block started on this card\n")
    }
    if !loaded.bothEngines(e, l) { return }
    if e.*.stage < 5 { return }
    if c.*.g1 != engines.Outcome.passed && !settings(e, l, c) { return }
    if c.*.g2 != engines.Outcome.passed && !rlc(e, l, c) { return }
    if !queues(e, l, c) { return }
    _ = endOfPipe(e, l, c)
}

// Whether the block lets go: GRBM_STATUS's GUI_ACTIVE clear and
// GRBM_STATUS2 at its idle word (gfx_v8_0_is_idle), 100 ms at most.
fn idle(e: *engines.Engines) -> bool {
    var k: usize = 0
    while k < engines.AMDGPU_MAX_USEC_TIMEOUT {
        if rd(e, engines.GRBM_STATUS) & GRBM_STATUS__GUI_ACTIVE == 0 && rd(e, engines.GRBM_STATUS2) == IDLE_STATUS2 { return true }
        pause(e, 1)
        k += 1
    }
    return false
}

// The way down (the study's 8.7, Z, and 5.11): ring 0 taken back through
// the KIQ while the KIQ answers, the block let go idle, a queue still
// active let go by registers, the processors halted, the RLC stopped; then
// stages 2 to 4's way down. Nothing of stage 5's when it brought nothing
// up.
pub fn stop(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> void {
    const running = c.*.kiq.up || c.*.compute.up || c.*.graphics.up
    if running || c.*.g2 == engines.Outcome.passed {
        var unmapped = false
        if c.*.kiq.up && c.*.compute.up && !c.*.kiq.hung { unmapped = unmap(e, l, c) }
        const settled = idle(e)
        // A queue still active is let go while the compute processor runs
        // (a dequeue is the processor's to carry out), then the processors
        // are halted: gfx_v8_0_pre_soft_reset's order and the study's 8.7.
        // Both queues are asked, whatever the first answers.
        const ring0Free = deactivate(e, RING0_ME, RING0_PIPE, RING0_QUEUE)
        const kiqFree = deactivate(e, KIQ_ME, KIQ_PIPE, KIQ_QUEUE)
        const free = ring0Free && kiqFree
        halt(e)
        rlcStop(e, c, false)
        c.*.kiq.up = false
        c.*.compute.up = false
        c.*.graphics.up = false
        say(e, "gpu: stopped for the way down: ")
        if running { say(e, if unmapped { "compute ring 0 taken back through the KIQ, " } else { "compute ring 0 not taken back (the KIQ did not answer), " }) }
        say(e, if settled { "the block idle, " } else { "the block not idle after 100 ms, " })
        word(e, "processors halted (ME ", rd(e, engines.CP_ME_CNTL))
        word(e, ", MEC ", rd(e, engines.CP_MEC_CNTL))
        say(e, if free { "), the queues let go" } else { "), a queue did not let go in 100 ms" })
        word(e, ", RLC off (", rd(e, engines.RLC_CNTL))
        say(e, ")\n")
    }
    loaded.stop(e, l)
}

// The watch (the study's 7.3): once a second, after a failed F1 or while
// any ring runs, the temperature read; at the first mark no ring takes new
// work (and again below it), at the second every ring is stopped by its
// halt bits until the next boot; each crossing said. Called from the
// timer's tick.
pub fn heat(e: *engines.Engines, l: *loaded.Loaded, c: *Compute) -> void {
    const rings = l.*.up[0] || l.*.up[1] || c.*.kiq.up || c.*.compute.up || c.*.graphics.up
    if !(l.*.f1 == engines.Outcome.failed || rings) || c.*.stopped { return }
    const at = now(e)
    if c.*.watchLast != 0 && at - c.*.watchLast < WATCH_EVERY { return }
    c.*.watchLast = at
    const degrees = temperature(e)
    c.*.watchDegrees = degrees
    if degrees >= STOP_MARK {
        halt(e)
        var engine: usize = 0
        while engine < 2 {
            const offset = engine * loaded.SDMA1_REGISTER_OFFSET
            wr(e, engines.SDMA0_F32_CNTL + offset, rd(e, engines.SDMA0_F32_CNTL + offset) | engines.SDMA0_F32_CNTL__HALT)
            engine += 1
        }
        c.*.stopped = true
        c.*.watchMark = 2
        c.*.compute.refused = true
        c.*.graphics.refused = true
        num(e, "gpu: the card is at ", degrees)
        num(e, " C, the second mark (", STOP_MARK)
        say(e, " C): every ring stopped until the next boot\n")
        return
    }
    if degrees >= loaded.MARK && c.*.watchMark == 0 {
        c.*.watchMark = 1
        c.*.compute.refused = true
        c.*.graphics.refused = true
        num(e, "gpu: the card is at ", degrees)
        num(e, " C, the first mark (", loaded.MARK)
        say(e, " C): no ring takes new work\n")
        return
    }
    if degrees < loaded.MARK && c.*.watchMark == 1 {
        c.*.watchMark = 0
        c.*.compute.refused = false
        c.*.graphics.refused = false
        num(e, "gpu: the card is at ", degrees)
        num(e, " C again, below the first mark (", loaded.MARK)
        say(e, " C): the rings take work again\n")
    }
}
