// The processors as the firmware lists them (ACPI's MADT: acpi.mlx finds
// the table, smp.mlx starts what is read here) and sets of processors
// (Mask). Nothing here touches the machine: tests/528_smp_processors_runtime.mlx
// builds it for the host and reads tables made there.
//
// The MADT's entries the kernel reads (the others are an interrupt
// controller's, an override, a non-maskable line):
// - type 0, a processor's local APIC: its ACPI id (byte 2), its local
//   APIC's id (byte 3: eight bits; 0xFF names nobody), its flags (bytes 4
//   to 7);
// - type 9, its x2APIC: its id (bytes 4 to 7, all 32 bits; 0xFFFFFFFF
//   names nobody), its flags (bytes 8 to 11).
// Flags: bit 0, the processor is there and on (started at boot); bit 1,
// "online capable" (ACPI 6.3, a table of revision 5 or later): one that is
// off may be brought on while the system runs. As Linux counts them, an
// off processor of an older table, or one online capable, is one more
// the system may have (possible, not present); an off one that is not
// online capable is none. brixOS adds no processor while it runs: those
// are counted (`capable`) and not started.
//
// A processor named twice (a type 0 and a type 9 entry for the same id:
// a firmware that lists the x2APIC of every processor too) is one. An id
// of 255 or more is reached in x2APIC mode only: while the local APICs
// are in their xAPIC mode such a processor is counted (`beyond`) and left.
// MAX at most (256: two large processors' threads); more are counted
// (`over`).
pub const MAX: usize = 256

pub const Listed = struct {
    // The local APIC ids of the processors to start, in the table's
    // order, each once.
    ids: [MAX]u32
    count: usize
    // Entries of processors that are off, and of those the ones the
    // system may bring on while it runs (not started here).
    disabled: usize
    capable: usize
    // Processors on whose id needs x2APIC mode, which the local APICs are
    // not in; processors past MAX; entries of a processor named already.
    beyond: usize
    over: usize
    twice: usize

    pub fn clear(self: *Self) -> void {
        self.*.count = 0
        self.*.disabled = 0
        self.*.capable = 0
        self.*.beyond = 0
        self.*.over = 0
        self.*.twice = 0
    }

    // Whether `id` is listed.
    pub fn has(self: *const Self, id: usize) -> bool {
        var k: usize = 0
        while k < self.*.count {
            if @intCast(usize, self.*.ids[k]) == id { return true }
            k += 1
        }
        return false
    }

    // One more processor that is on (its local APIC's id).
    fn add(self: *Self, id: usize) -> void {
        if self.has(id) {
            self.*.twice += 1
            return
        }
        if self.*.count >= MAX {
            self.*.over += 1
            return
        }
        self.*.ids[self.*.count] = @intCast(u32, id)
        self.*.count += 1
    }
}

pub const ENABLED: usize = 1
pub const ONLINE_CAPABLE: usize = 2
// Where the entries begin (after the header, the local APICs' address and
// the table's flags), and the revision from which ONLINE_CAPABLE is told.
pub const ENTRIES: usize = 44
pub const CAPABLE_REVISION: usize = 5

fn read32(table: [*]const u8, at: usize) -> usize {
    return @intCast(usize, table[at]) | (@intCast(usize, table[at + 1]) << 8) | (@intCast(usize, table[at + 2]) << 16) | (@intCast(usize, table[at + 3]) << 24)
}

// The processors of the MADT at `table` (its length is the header's; an
// entry that reaches beyond it ends the reading), `x2`: whether the local
// APICs are in x2APIC mode (then every id is reached).
pub fn read(table: [*]const u8, x2: bool, into: *Listed) -> void {
    into.clear()
    const length = read32(table, 4)
    const revision = @intCast(usize, table[8])
    var at: usize = ENTRIES
    while at + 2 <= length {
        const kind = table[at]
        const size = @intCast(usize, table[at + 1])
        if size < 2 || at + size > length { break }
        var id: usize = 0
        var flags: usize = 0
        var named = false
        if kind == 0 && size >= 8 {
            id = @intCast(usize, table[at + 3])
            flags = read32(table, at + 4)
            named = id != 0xFF
        } else if kind == 9 && size >= 16 {
            id = read32(table, at + 4)
            flags = read32(table, at + 8)
            named = id != 0xFFFFFFFF
        }
        if named {
            if flags & ENABLED != 0 {
                if id >= 255 && !x2 {
                    into.*.beyond += 1
                } else {
                    into.add(id)
                }
            } else {
                into.*.disabled += 1
                if revision < CAPABLE_REVISION || flags & ONLINE_CAPABLE != 0 { into.*.capable += 1 }
            }
        }
        at += size
    }
}

// A set of processors (by their numbers, 0 to MAX - 1): which idle, which
// are to be told something. Four words, whatever the count.
pub const WORDS: usize = MAX / 64

pub const Mask = struct {
    words: [WORDS]usize

    pub fn clear(self: *Self) -> void {
        var k: usize = 0
        while k < WORDS {
            self.*.words[k] = 0
            k += 1
        }
    }

    fn bit(k: usize) -> usize { return @intCast(usize, 1) << @intCast(u6, k % 64) }

    pub fn set(self: *Self, k: usize) -> void { self.*.words[k / 64] |= bit(k) }

    pub fn unset(self: *Self, k: usize) -> void { self.*.words[k / 64] &= ~bit(k) }

    pub fn has(self: *const Self, k: usize) -> bool { return self.*.words[k / 64] & bit(k) != 0 }

    // How many are in it.
    pub fn count(self: *const Self) -> usize {
        var total: usize = 0
        var k: usize = 0
        while k < WORDS {
            var word = self.*.words[k]
            while word != 0 {
                word &= word - 1
                total += 1
            }
            k += 1
        }
        return total
    }

    // The lowest number in it other than `not` (MAX or more: none
    // excepted): whether there is one, and which. A word at a time.
    pub fn firstBut(self: *const Self, not: usize) -> (bool, usize) {
        var k: usize = 0
        while k < WORDS {
            var word = self.*.words[k]
            if not / 64 == k { word &= ~bit(not) }
            if word != 0 { return -> (true, k * 64 + lowest(word)) }
            k += 1
        }
        return -> (false, 0)
    }
}

// The number of the lowest bit set in `word` (not 0).
pub fn lowest(word: usize) -> usize {
    var n: usize = 0
    var v = word
    if v & 0xFFFFFFFF == 0 {
        n += 32
        v = v >> 32
    }
    if v & 0xFFFF == 0 {
        n += 16
        v = v >> 16
    }
    if v & 0xFF == 0 {
        n += 8
        v = v >> 8
    }
    if v & 0xF == 0 {
        n += 4
        v = v >> 4
    }
    if v & 0x3 == 0 {
        n += 2
        v = v >> 2
    }
    if v & 0x1 == 0 { n += 1 }
    return n
}
