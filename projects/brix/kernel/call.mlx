// What became of a system call besides its result: the same for the
// native calls (native/) and Linux's (linux/), so the trap path treats
// both alike.
const wait = @import("./wait.mlx")

// What became of a system call besides its result.
pub const OutcomeKind = enum(u8) {
    // The result is in rax; the process goes on.
    done,
    // The process waits (for `waiting`) and makes the call again.
    blocked,
    // The process lets another run first.
    yielded,
    // The process exited (`status`, its wait status).
    exited,
    // The process ended during the call (it is a zombie now).
    ended,
    // The frame holds the process's registers anew (a new program's
    // start, a return from a handler or upcall).
    replaced
}

pub const Outcome = struct {
    kind: OutcomeKind
    waiting: wait.Wait
    status: usize
}

