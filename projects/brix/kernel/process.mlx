// The one process: a static ELF program from the boot archive (mlx-sh)
// in its own address space. Its memory: the program's segments, the break
// after them, anonymous mappings from MMAP_BASE up, the stack under
// STACK_TOP; all but the segments are pages made on first touch (a page
// fault in one of the regions, or the kernel preparing a range it is
// given).
const layout = @import("../layout.mlx")
const cpu = @import("./cpu.mlx")
const memory = @import("./memory.mlx")
const archive = @import("./archive.mlx")

pub const PAGE: usize = 4096
pub const STACK_TOP: usize = 0x7FFFFFFFF000
pub const STACK_SIZE: usize = 8 * 1024 * 1024
pub const MMAP_BASE: usize = 0x100000000000
pub const USER_LIMIT: usize = 0x800000000000
const MAX_REGIONS: usize = 256

var space: usize = 0 // (per run)
var entryPoint: usize = 0 // (per run)
var stackPointer: usize = 0 // (per run)
var breakStart: usize = 0 // (per run)
var breakEnd: usize = 0 // (per run)
var mmapNext: usize = 0 // (per run)
var programHeaders: usize = 0 // (per run)
var programHeaderCount: usize = 0 // (per run)
var regionStart: [MAX_REGIONS]usize = undefined // (per run)
var regionEnd: [MAX_REGIONS]usize = undefined // (per run)
var regionCount: usize = 0 // (per run)

pub fn entry() -> usize { return entryPoint }
pub fn stack() -> usize { return stackPointer }

fn pageDown(value: usize) -> usize { return value & ~(PAGE - 1) }
fn pageUp(value: usize) -> usize { return (value + PAGE - 1) & ~(PAGE - 1) }

fn read16(bytes: [*]const u8, at: usize) -> usize { return @intCast(usize, bytes[at]) | (@intCast(usize, bytes[at + 1]) << 8) }
fn read32(bytes: [*]const u8, at: usize) -> usize { return read16(bytes, at) | (read16(bytes, at + 2) << 16) }
fn read64(bytes: [*]const u8, at: usize) -> usize { return read32(bytes, at) | (read32(bytes, at + 4) << 32) }

// ---- regions ----

fn inRegion(address: usize) -> bool {
    if address >= breakStart && address < breakEnd { return true }
    if address >= STACK_TOP - STACK_SIZE && address < STACK_TOP { return true }
    var k: usize = 0
    while k < regionCount {
        if address >= regionStart[k] && address < regionEnd[k] { return true }
        k += 1
    }
    return false
}

fn addRegion(start: usize, end: usize) -> bool {
    if regionCount == MAX_REGIONS { return false }
    regionStart[regionCount] = start
    regionEnd[regionCount] = end
    regionCount += 1
    return true
}

// [start, end) out of the regions (cutting or splitting them) and its
// pages freed.
fn removeRange(start: usize, end: usize) -> void {
    var k: usize = 0
    while k < regionCount {
        const a = regionStart[k]
        const b = regionEnd[k]
        if end <= a || start >= b {
            k += 1
            continue
        }
        // The pages of the overlap, those that were touched.
        var page = if start > a { start } else { a }
        const last = if end < b { end } else { b }
        while page < last {
            memory.release(space, page)
            page += PAGE
        }
        if start <= a && end >= b {
            regionCount -= 1
            regionStart[k] = regionStart[regionCount]
            regionEnd[k] = regionEnd[regionCount]
            continue
        }
        if start <= a {
            regionStart[k] = end
        } else if end >= b {
            regionEnd[k] = start
        } else {
            regionEnd[k] = start
            _ = addRegion(end, b)
        }
        k += 1
    }
}

// A page fault at `address`: true when it is in a region and has its
// page now.
pub fn fault(address: usize) -> bool {
    if address >= USER_LIMIT || !inRegion(address) { return false }
    if memory.translate(space, address) != 0 { return false }
    return memory.back(space, address)
}

// [address, address + length) usable by the kernel for the program:
// below the kernel's half, and every page mapped (made now when in a
// region).
pub fn prepare(address: usize, length: usize) -> bool {
    if length == 0 { return true }
    if address >= USER_LIMIT || length > USER_LIMIT - address { return false }
    var page = pageDown(address)
    while page < address + length {
        if memory.translate(space, page) == 0 {
            if !inRegion(page) || !memory.back(space, page) { return false }
        }
        page += PAGE
    }
    return true
}

// ---- system calls on memory ----

pub fn mmap(address: usize, length: usize, fixed: bool) -> isize {
    if length == 0 { return -22 }
    const size = pageUp(length)
    var start: usize = 0
    if fixed {
        if address & (PAGE - 1) != 0 || address >= USER_LIMIT || size > USER_LIMIT - address { return -22 }
        start = address
        removeRange(start, start + size)
    } else {
        start = mmapNext
        mmapNext += size + PAGE
    }
    if !addRegion(start, start + size) { return -12 }
    return @bitCast(isize, start)
}

pub fn munmap(address: usize, length: usize) -> isize {
    if address & (PAGE - 1) != 0 || address >= USER_LIMIT { return -22 }
    removeRange(address, address + pageUp(length))
    return 0
}

pub fn brk(wanted: usize) -> usize {
    if wanted < breakStart || wanted >= MMAP_BASE { return breakEnd }
    const end = pageUp(wanted)
    if end < breakEnd {
        var page = end
        while page < breakEnd {
            memory.release(space, page)
            page += PAGE
        }
    }
    breakEnd = end
    return wanted
}

// ---- loading ----

// `length` bytes from `from` into the space at `address` (pages made as
// needed, through the kernel's view of their frames).
fn copyInto(target: usize, address: usize, from: [*]const u8, length: usize) -> bool {
    var done: usize = 0
    while done < length {
        const at = address + done
        var frame = memory.translate(target, at)
        if frame == 0 {
            if !memory.back(target, at) { return false }
            frame = memory.translate(target, at)
        }
        const offset = at & (PAGE - 1)
        var chunk = PAGE - offset
        if chunk > length - done { chunk = length - done }
        const into: [*]u8 = unsafe { @ptrFromInt([*]u8, cpu.physical(frame) + offset) }
        var k: usize = 0
        while k < chunk {
            into[k] = from[done + k]
            k += 1
        }
        done += chunk
    }
    return true
}

fn putWord(target: usize, address: usize, value: usize) -> bool {
    var bytes: [8]u8 = undefined
    var k: usize = 0
    while k < 8 {
        bytes[k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 255)
        k += 1
    }
    return copyInto(target, address, &bytes, 8)
}

fn length(text: [*]const u8) -> usize {
    var n: usize = 0
    while text[n] != 0 { n += 1 }
    return n
}

// The stack the program starts with: argc, argv, envp, the auxiliary
// vector, then the strings and 16 random bytes at the top.
fn buildStack(target: usize, arguments: [*]const [*]const u8, argumentCount: usize, environment: [*]const [*]const u8, environmentCount: usize) -> usize {
    var top = STACK_TOP - 16
    var pointers: [32]usize = undefined
    var k: usize = 0
    while k < argumentCount + environmentCount && k < 32 {
        const text = if k < argumentCount { arguments[k] } else { environment[k - argumentCount] }
        const n = length(text) + 1
        top -= n
        _ = copyInto(target, top, text, n)
        pointers[k] = top
        k += 1
    }
    const total = k
    top -= top % 16
    top -= 16
    const random = top
    var seed = cpu.rdtsc() | 1
    var r: usize = 0
    while r < 2 {
        seed ^= seed << 13
        seed ^= seed >> 7
        seed ^= seed << 17
        _ = putWord(target, random + r * 8, seed)
        r += 1
    }
    // argc, argv + NULL, envp + NULL, 8 auxiliary pairs (16 words).
    const words = 1 + argumentCount + 1 + environmentCount + 1 + 16
    top -= words * 8
    top -= top % 16
    var at = top
    _ = putWord(target, at, argumentCount)
    at += 8
    k = 0
    while k < argumentCount && k < total {
        _ = putWord(target, at, pointers[k])
        at += 8
        k += 1
    }
    _ = putWord(target, at, 0)
    at += 8
    while k < total {
        _ = putWord(target, at, pointers[k])
        at += 8
        k += 1
    }
    _ = putWord(target, at, 0)
    at += 8
    const aux = [16]usize{ 3, programHeaders, 4, 56, 5, programHeaderCount, 6, PAGE, 9, entryPoint, 11, 0, 25, random, 0, 0 }
    var a: usize = 0
    while a < 16 {
        _ = putWord(target, at, aux[a])
        at += 8
        a += 1
    }
    return top
}

// The program `name` loaded into a new address space, which becomes the
// current one (the old one freed); false when it is not in the archive,
// is no static x86-64 ELF program, or memory is out.
pub fn load(name: [*]const u8, nameLength: usize, arguments: [*]const [*]const u8, argumentCount: usize, environment: [*]const [*]const u8, environmentCount: usize) -> bool {
    var file: archive.File = undefined
    if !archive.find(name, nameLength, &file) { return false }
    const elf = file.data
    if file.size < 64 || elf[0] != 0x7F || elf[1] != 69 || elf[2] != 76 || elf[3] != 70 { return false }
    if elf[4] != 2 || read16(elf, 18) != 62 || read16(elf, 16) != 2 { return false }
    const target = memory.newSpace()
    if target == 0 { return false }
    const phoff = read64(elf, 32)
    const phnum = read16(elf, 56)
    var highest: usize = 0
    var headers: usize = 0
    var k: usize = 0
    while k < phnum {
        const ph = phoff + k * 56
        if read32(elf, ph) == 1 {
            const offset = read64(elf, ph + 8)
            const address = read64(elf, ph + 16)
            const fileSize = read64(elf, ph + 32)
            const memorySize = read64(elf, ph + 40)
            if offset + fileSize > file.size || address >= MMAP_BASE {
                memory.freeSpace(target)
                return false
            }
            if offset == 0 { headers = address + phoff }
            if !copyInto(target, address, unsafe { @ptrFromInt([*]const u8, @intFromPtr(elf) + offset) }, fileSize) {
                memory.freeSpace(target)
                return false
            }
            // The rest of the segment: zero pages (copyInto makes them).
            var page = pageUp(address + fileSize)
            while page < address + memorySize {
                if memory.translate(target, page) == 0 && !memory.back(target, page) {
                    memory.freeSpace(target)
                    return false
                }
                page += PAGE
            }
            if address + memorySize > highest { highest = address + memorySize }
        }
        k += 1
    }
    entryPoint = read64(elf, 24)
    programHeaders = headers
    programHeaderCount = phnum
    breakStart = pageUp(highest)
    breakEnd = breakStart
    mmapNext = MMAP_BASE
    regionCount = 0
    stackPointer = buildStack(target, arguments, argumentCount, environment, environmentCount)
    const old = space
    space = target
    cpu.writeCr3(target)
    if old != 0 { memory.freeSpace(old) }
    return true
}
