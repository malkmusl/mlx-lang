// The network device, whatever drives it: virtio-net in a VM, an Intel
// igb NIC on real hardware. The stack (net/stack.mlx), DHCP and the boot
// speak to the one active device through here, so none of them needs to
// know which driver it is. probe() tries each driver in turn and keeps the
// first that answers, virtio first.
//
// The link (a cable with a partner at its other end) is looked at on
// every tick of the timer (look), which is how its going and coming are
// noticed: one read of the device's status a hundredth of a second, for
// either driver, with or without an interrupt of the device's (a card's
// own interrupt for a link change would bring the news at most that
// hundredth sooner, on the cards that have one, and be a second way to
// the same place). What is sent goes by the last look: with the link
// down a frame is not handed to the device at all, but dropped here at
// once and counted.
const virtionet = @import("./virtionet.mlx")
const igb = @import("./igb.mlx")

pub const NO_IRQ: usize = 0xFF
const NONE: usize = 0
const VIRTIO: usize = 1
const IGB: usize = 2

var active: usize = NONE // (per run)
// The link as it was at the last look, and the frames not sent since it
// went down.
var linkSeen: bool = false // (per run)
var unsent: usize = 0 // (per run)

// What a look at the link found: as before, or that it came or went.
pub const Change = enum(u8) { none, up, down }

// The first network device, made ready; whether there is one.
pub fn probe() -> bool {
    unsent = 0
    if virtionet.device().probe() {
        active = VIRTIO
    } else if igb.probe() {
        active = IGB
    } else {
        active = NONE
    }
    linkSeen = linkUp()
    return active != NONE
}

pub fn present() -> bool { return active != NONE }

// What the device is driven by, for the boot message.
pub fn driver() -> []const u8 {
    if active == VIRTIO { return "virtio" }
    if active == IGB { return "igb" }
    return "none"
}

// The hardware address (a copy).
pub fn mac() -> [6]u8 {
    if active == IGB { return igb.device().*.mac }
    return virtionet.device().*.mac
}

pub fn macByte(k: usize) -> u8 {
    if active == IGB { return igb.device().*.mac[k] }
    return virtionet.device().*.mac[k]
}

// Whether the link is up: a cable with a partner at its other end.
pub fn linkUp() -> bool {
    if active == VIRTIO { return virtionet.device().linkUp() }
    if active == IGB { return igb.device().linkUp() }
    return false
}

// Whether the link was up at the last look.
pub fn linked() -> bool { return linkSeen }

// The link looked at (every tick of the timer): whether it came or went
// since the last look. A driver with something to do on the tick, or
// when the link returns, does it here.
pub fn look() -> Change {
    if active == NONE { return Change.none }
    if active == IGB { igb.device().tick() }
    const now = linkUp()
    if now == linkSeen { return Change.none }
    linkSeen = now
    if !now { return Change.down }
    // (What the driver gives up of its ring was not sent either.)
    if active == IGB { unsent += igb.device().linkCame() }
    return Change.up
}

// The frames that were not sent because the link was down (dropped here,
// or left in the device's ring when it went), since they were last asked
// for.
pub fn takeUnsent() -> usize {
    const count = unsent
    unsent = 0
    return count
}

// The link's speed in megabits a second; 0 when the device does not say
// (virtio) or the link is down.
pub fn speed() -> usize {
    if active == IGB { return igb.device().speed() }
    return 0
}

// Whether the link sends and receives at once (a device that does not
// say: yes).
pub fn fullDuplex() -> bool {
    if active == IGB { return igb.device().fullDuplex() }
    return true
}

// The frames received and sent since the boot.
pub fn received() -> usize {
    if active == VIRTIO { return virtionet.device().*.received }
    if active == IGB { return igb.device().*.received }
    return 0
}

pub fn sent() -> usize {
    if active == VIRTIO { return virtionet.device().*.sent }
    if active == IGB { return igb.device().*.sent }
    return 0
}

// The device's interrupt line, or NO_IRQ when it is polled.
pub fn irq() -> usize {
    if active == VIRTIO { return virtionet.device().*.irq }
    return NO_IRQ
}

// `frame` to the wire; false when it did not go: the link is down (the
// frame is dropped, and counted), or the device has no room for it now.
pub fn transmit(frame: [*]const u8, length: usize) -> bool {
    if !linkSeen {
        if active != NONE { unsent += 1 }
        return false
    }
    if active == VIRTIO { return virtionet.device().transmit(frame, length) }
    if active == IGB { return igb.device().transmit(frame, length) }
    return false
}

pub fn receive() -> void {
    if active == VIRTIO { virtionet.device().receive() }
    if active == IGB { igb.device().receive() }
}

pub fn interrupted() -> bool {
    if active == VIRTIO { return virtionet.device().interrupted() }
    return false
}

// Whether the device raises a message-signalled interrupt
// (layout.Vector.NET) instead of a line's, and that message taken.
pub fn signalled() -> bool { return active == IGB && igb.device().*.signalled }

pub fn message() -> void {
    if active == IGB { igb.device().interrupted() }
}
