// The network device, whatever drives it: virtio-net in a VM, an Intel
// igb NIC on real hardware. The stack (net/stack.mlx), DHCP and the boot
// speak to the one active device through here, so none of them needs to
// know which driver it is. probe() tries each driver in turn and keeps the
// first that answers, virtio first.
const virtionet = @import("./virtionet.mlx")
const igb = @import("./igb.mlx")

pub const NO_IRQ: usize = 0xFF
const NONE: usize = 0
const VIRTIO: usize = 1
const IGB: usize = 2

var active: usize = NONE // (per run)

// The first network device, made ready; whether there is one.
pub fn probe() -> bool {
    if virtionet.device().probe() {
        active = VIRTIO
        return true
    }
    if igb.probe() {
        active = IGB
        return true
    }
    active = NONE
    return false
}

pub fn present() -> bool { return active != NONE }

// What the device is driven by, for the boot message.
pub fn driver() -> []const u8 {
    if active == VIRTIO { return "virtio" }
    if active == IGB { return "igb" }
    return "none"
}

// The hardware address (a copy).
pub fn mac() -> [6]u8 {
    if active == IGB { return igb.device().*.mac }
    return virtionet.device().*.mac
}

pub fn macByte(k: usize) -> u8 {
    if active == IGB { return igb.device().*.mac[k] }
    return virtionet.device().*.mac[k]
}

// The device's interrupt line, or NO_IRQ when it is polled.
pub fn irq() -> usize {
    if active == VIRTIO { return virtionet.device().*.irq }
    return NO_IRQ
}

pub fn transmit(frame: [*]const u8, length: usize) -> bool {
    if active == VIRTIO { return virtionet.device().transmit(frame, length) }
    if active == IGB { return igb.device().transmit(frame, length) }
    return false
}

pub fn receive() -> void {
    if active == VIRTIO { virtionet.device().receive() }
    if active == IGB { igb.device().receive() }
}

pub fn interrupted() -> bool {
    if active == VIRTIO { return virtionet.device().interrupted() }
    return false
}
