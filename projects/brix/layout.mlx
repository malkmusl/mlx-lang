// brixOS's memory layout, shared by the kernel and brix-image (which lays
// the boot image out by it). Physical addresses unless the name says
// virtual; the kernel sees all of memory at Memory.KERNEL_VIRTUAL +
// physical (the first GiB by the boot tables, the rest mapped by the
// kernel at its start, in 2 MiB pages).

// Where things are in memory.
pub const Memory = struct {
    // Where the image is loaded (the Multiboot load address), where the
    // kernel's segments go, and the address mlx4 links programs at.
    pub const BLOB: usize = 0x100000
    pub const KERNEL: usize = 0x200000
    pub const LINK_BASE: usize = 0x400000
    pub const KERNEL_VIRTUAL: usize = 0xFFFF800000000000
    // The kernel and the boot archive have the memory up to the kernel's
    // aggregate arena (mlx4's r14/r15, at 64 MiB); after it the frames the
    // kernel hands out, to the end of memory (128 MiB at least; at most
    // MAPPED_LIMIT: what the boot PDPT reaches with a u16 count a frame
    // in 32 MiB of counts).
    pub const ARENA: usize = 0x4000000
    pub const ARENA_SIZE: usize = 0x2000000
    pub const FREE: usize = 0x6000000
    pub const GIB: usize = 0x40000000
    pub const HUGE: usize = 0x200000
    pub const MAPPED_LIMIT: usize = 64 * GIB
    // The processors that run the kernel (more stay halted), each with
    // its share of the arena.
    pub const MAX_CPUS: usize = 8
    pub const ARENA_PER_CPU: usize = ARENA_SIZE / MAX_CPUS

    // Processor `cpu`'s arena.
    pub fn arenaOf(cpu: usize) -> usize { return ARENA + cpu * ARENA_PER_CPU }

    // The kernel's view of physical memory (all of it, to MAPPED_LIMIT).
    pub fn virtual(physical: usize) -> usize { return KERNEL_VIRTUAL + physical }
}

// The blob's parts, as offsets from Memory.BLOB.
pub const Blob = struct {
    pub const HEADER: usize = 0x000
    pub const BOOT_INFO: usize = 0x040
    pub const GDTR32: usize = 0x260
    pub const GDTR64: usize = 0x270
    pub const IDTR: usize = 0x300
    pub const CODE32: usize = 0x400
    pub const CODE64: usize = 0x500
    pub const IDT: usize = 0x1000
    pub const STUBS: usize = 0x2000
    // The GDT (a TSS descriptor per processor), the processors' TSSs
    // (TSS_SIZE each) and their blocks (PerCpu, PERCPU_SIZE each; the
    // kernel's GS base).
    pub const GDT: usize = 0x3000
    pub const TSS: usize = 0x3400
    pub const TSS_SIZE: usize = 0x80
    pub const PERCPU: usize = 0x5000
    pub const PERCPU_SIZE: usize = 0x40
    // The other processors' start (smp.mlx copies it to Ap.START).
    pub const AP: usize = 0x7000
    pub const PML4: usize = 0x8000
    pub const PDPT: usize = 0x9000
    pub const PD: usize = 0xA000
    pub const BOOT_STACK_TOP: usize = 0x40000
    pub const TRAP_STACK_TOP: usize = 0x80000

    // Where a part of the blob is in the kernel's view.
    pub fn virtual(offset: usize) -> usize { return Memory.KERNEL_VIRTUAL + Memory.BLOB + offset }

    // Processor `cpu`'s TSS and block, in the kernel's view.
    pub fn tssOf(cpu: usize) -> usize { return virtual(TSS + cpu * TSS_SIZE) }
    pub fn perCpuOf(cpu: usize) -> usize { return virtual(PERCPU + cpu * PERCPU_SIZE) }
}

// A processor's block (Blob.PERCPU + its number * PERCPU_SIZE; the
// kernel's GS base on it): the top of its trap stack (SYSCALL's entry
// takes it), a word for the user stack pointer, its arena, its number.
pub const PerCpu = struct {
    pub const TRAP_STACK: usize = 0x00
    pub const USER_RSP: usize = 0x08
    pub const ARENA_BASE: usize = 0x10
    pub const ARENA_END: usize = 0x18
    pub const INDEX: usize = 0x20
}

// The other processors' trampoline: copied to START (below 1 MiB, where a
// startup IPI's vector names it: START / 4096), real mode to long mode
// with the boot page tables; STARTED counts the processors that got there
// (each takes its number from it), then they go on in the blob's code64
// (Info.NEXT) and into the kernel's brix_ap.
pub const Ap = struct {
    pub const START: usize = 0x8000
    pub const SIZE: usize = 0x200
    pub const CODE16: usize = 0x000
    pub const CODE32: usize = 0x040
    pub const CODE64: usize = 0x0A0
    pub const GDT: usize = 0x100
    pub const GDTR: usize = 0x120
    pub const STARTED: usize = 0x130
}

// The boot info's fields (u64 each, at Blob.BOOT_INFO + these).
pub const Info = struct {
    pub const MBI: usize = 0x00
    pub const KERNEL_PHYS: usize = 0x08
    pub const KERNEL_SIZE: usize = 0x10
    pub const ARCHIVE_PHYS: usize = 0x18
    pub const ARCHIVE_SIZE: usize = 0x20
    pub const ARENA_BASE: usize = 0x28
    pub const ARENA_END: usize = 0x30
    pub const FREE_PHYS: usize = 0x38
    // Where the blob's code64 goes on in the higher half (the other
    // processors' trampoline jumps there).
    pub const NEXT: usize = 0x40
    // The display the EFI loader found (GOP): the framebuffer's physical
    // address (0: none; a Multiboot boot finds the Bochs adapter itself),
    // its width and height in pixels, the bytes a row takes, the format
    // (1: BGRX, 2: RGBX; 32 bits a pixel).
    pub const FB_ADDRESS: usize = 0x48
    pub const FB_WIDTH: usize = 0x50
    pub const FB_HEIGHT: usize = 0x58
    pub const FB_PITCH: usize = 0x60
    pub const FB_FORMAT: usize = 0x68
    // The ACPI tables' root (the RSDP's physical address) as the EFI
    // loader found it in the firmware's configuration table (0: none
    // given; a BIOS keeps it in its own area, where the kernel looks).
    pub const RSDP: usize = 0x70
    // What the monitor says its own mode is (its EDID's first timing, as
    // the EFI loader read it from the firmware; 0: it did not say): the
    // loader sets that mode when the firmware has it, and the kernel
    // says so when the picture is another.
    pub const MONITOR_WIDTH: usize = 0x78
    pub const MONITOR_HEIGHT: usize = 0x80
    // The mode the firmware was in when the EFI loader came, whose mode
    // the loader set instead (0: none, the firmware's stays; MODE_MONITOR:
    // the monitor's own; MODE_IMAGE: the one the image names), and how
    // many displays (Graphics Output Protocols) the firmware has.
    pub const FIRMWARE_WIDTH: usize = 0x88
    pub const FIRMWARE_HEIGHT: usize = 0x90
    pub const MODE_BY: usize = 0x98
    pub const DISPLAYS: usize = 0xA0
    pub const MODE_MONITOR: usize = 1
    pub const MODE_IMAGE: usize = 2
    // (The firmware lacks the mode wanted: the nearest below it that is a
    // larger picture than the firmware's.)
    pub const MODE_NEAR_MONITOR: usize = 3
    pub const MODE_NEAR_IMAGE: usize = 4
    // The firmware's modes with pixels the kernel can use: how many the
    // loader wrote down (MODE_ROOM at most), each a word (the width above
    // 32 bits, the height below); and the firmware's status when it
    // refused the mode the loader asked for (0: it did not).
    pub const MODES: usize = 0xA8
    pub const MODE_LIST: usize = 0xB0
    pub const MODE_ROOM: usize = 32
    pub const MODE_REFUSED: usize = 0x1B0
    // The mode the loader looked for (the one the image names, else the
    // monitor's own; 0: none): where the monitor does not say its own,
    // the screen has this one's shape.
    pub const WANTED_WIDTH: usize = 0x1B8
    pub const WANTED_HEIGHT: usize = 0x1C0
}

// Selectors (GDT: null, kernel code, kernel data, user code 32 (SYSRET's
// base), user data, user code 64, TSS).
pub const Selector = struct {
    pub const KERNEL_CODE: usize = 0x08
    pub const KERNEL_DATA: usize = 0x10
    pub const USER_DATA: usize = 0x23
    pub const USER_CODE: usize = 0x2B
    // Processor 0's TSS; processor k's is TSS + 16 * k.
    pub const TSS: usize = 0x30
}

pub const Vector = struct {
    // The vector of a trap frame made by the SYSCALL entry (a system call
    // from user mode).
    pub const SYSCALL: usize = 0x80
    // The local APIC's timer (the other processors' time slices), and
    // its spurious vector.
    pub const LAPIC_TIMER: usize = 0xF0
    // An idle processor woken (an IPI: there is a process to run).
    pub const WAKE: usize = 0xF1
    // The devices' message-signalled interrupts (above the PIC's vectors,
    // apart from SYSCALL's 0x80): the GPU's, the network device's, the
    // USB controllers' (all of them share one).
    pub const GPU: usize = 0x50
    pub const NET: usize = 0x51
    pub const USB: usize = 0x52
    pub const SPURIOUS: usize = 0xFF
}

// The kernel's operations by SYSCALL from ring 0 (the entry tells them by
// a return address in the higher half): number in rax, arguments in rdi,
// rsi.
pub const Op = struct {
    pub const OUTB: usize = 1
    pub const INB: usize = 2
    pub const WAIT: usize = 3
    pub const READ_CR2: usize = 4
    pub const WRITE_CR3: usize = 5
    pub const READ_CR3: usize = 6
    pub const INVLPG: usize = 7
    pub const WRMSR: usize = 8
    pub const ENTER_USER: usize = 9
    pub const OUTW: usize = 10
    pub const OUTL: usize = 11
    pub const INL: usize = 12
    pub const RDTSC: usize = 13
    pub const INW: usize = 14
    // The processor's number (its block's).
    pub const CPU_ID: usize = 15
    // User mode from a trap frame (rdi: its SSE area, the frame above):
    // the trap path's return.
    pub const RESUME: usize = 16
    // A model-specific register read (rdi: which; the result its 64 bits).
    pub const RDMSR: usize = 17
    // The processor's hint that it waits in a loop (PAUSE).
    pub const PAUSE: usize = 18
    pub const COUNT: usize = 18
}
