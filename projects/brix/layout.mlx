// brixOS's memory layout, shared by the kernel and brix-image (which lays
// the boot image out by it). Physical addresses unless the name says
// virtual; the kernel sees all of memory at Memory.KERNEL_VIRTUAL +
// physical (the first GiB by the boot tables, the rest mapped by the
// kernel at its start, in 2 MiB pages).

// Where things are in memory.
pub const Memory = struct {
    // Where the image is loaded (the Multiboot load address), where the
    // kernel's segments go, and the address mlx4 links programs at.
    pub const BLOB: usize = 0x100000
    pub const KERNEL: usize = 0x200000
    pub const LINK_BASE: usize = 0x400000
    pub const KERNEL_VIRTUAL: usize = 0xFFFF800000000000
    // The kernel and the boot archive have the memory up to the kernel's
    // aggregate arena (mlx4's r14/r15, at 80 MiB: the archive holds the
    // desktop and its apps); after it the frames the kernel hands out, to
    // the end of memory (144 MiB at least; at most
    // MAPPED_LIMIT: what the boot PDPT reaches with a u16 count a frame
    // in 32 MiB of counts).
    pub const ARENA: usize = 0x5000000
    pub const ARENA_SIZE: usize = 0x2000000
    pub const FREE: usize = 0x7000000
    pub const GIB: usize = 0x40000000
    pub const HUGE: usize = 0x200000
    pub const MAPPED_LIMIT: usize = 64 * GIB
    // The processors that run the kernel: every one the firmware lists,
    // up to what an MADT names (two large processors' threads; x2APIC ids
    // beyond 255 among them). What each one has is made for the
    // processors found at boot (smp.mlx), not for this many: the bound is
    // for the few small tables that are by number (a word or a flag each).
    pub const MAX_CPUS: usize = 256
    // The aggregate arena divided among the processors found: the first
    // one's share (ARENA_FIRST, from ARENA: the boot runs in it) as with
    // eight, and the rest of the region for the others, ARENA_MOST each at
    // most, ARENA_LEAST at least. Where the region holds fewer such shares
    // than there are others, the rest have ARENA_LEAST of the frames'
    // memory each (arenaShare, arenasInRegion). The arena is a bump that
    // every entry from user mode empties (trap.mlx): a system call takes a
    // few KiB of it (6.5 KiB at most in tools/check_brix.sh's and 2 KiB in
    // check_brix_desktop.sh's runs, measured), and one that runs out of
    // it stops the kernel.
    pub const ARENA_FIRST: usize = 0x400000
    pub const ARENA_MOST: usize = 0x400000
    pub const ARENA_LEAST: usize = 0x80000
    // (Shares are whole steps of this.)
    pub const ARENA_STEP: usize = 0x10000

    // The share of each processor but the first when `others` more than
    // it run the kernel.
    pub fn arenaShare(others: usize) -> usize {
        if others == 0 { return ARENA_MOST }
        const even = (ARENA_SIZE - ARENA_FIRST) / others / ARENA_STEP * ARENA_STEP
        if even > ARENA_MOST { return ARENA_MOST }
        if even < ARENA_LEAST { return ARENA_LEAST }
        return even
    }

    // How many of those others have their share in the region (the
    // first ones); the rest have theirs of the frames.
    pub fn arenasInRegion(others: usize) -> usize {
        const room = (ARENA_SIZE - ARENA_FIRST) / arenaShare(others)
        return if others < room { others } else { room }
    }

    // Processor `cpu`'s arena in the region (physical), for 1 <= cpu <=
    // arenasInRegion(others); the first processor's is at ARENA.
    pub fn arenaOf(cpu: usize, others: usize) -> usize {
        if cpu == 0 { return ARENA }
        return ARENA + ARENA_FIRST + (cpu - 1) * arenaShare(others)
    }

    // The kernel's view of physical memory (all of it, to MAPPED_LIMIT).
    pub fn virtual(physical: usize) -> usize { return KERNEL_VIRTUAL + physical }
}

// The blob's parts, as offsets from Memory.BLOB.
pub const Blob = struct {
    pub const HEADER: usize = 0x000
    pub const BOOT_INFO: usize = 0x040
    pub const GDTR32: usize = 0x260
    pub const GDTR64: usize = 0x270
    pub const IDTR: usize = 0x300
    pub const CODE32: usize = 0x400
    pub const CODE64: usize = 0x500
    pub const IDT: usize = 0x1000
    pub const STUBS: usize = 0x2000
    // The first processor's GDT (its own TSS's descriptor after the
    // segments), TSS (TSS_SIZE) and block (PerCpu, PERCPU_SIZE; the
    // kernel's GS base). The others' are made by the kernel when it
    // starts them, for as many as it found (smp.mlx): a GDT with a TSS
    // descriptor each (GDTR64 is pointed at it, the others load it), and
    // a TSS and block each in a page above its trap stack.
    pub const GDT: usize = 0x3000
    pub const TSS: usize = 0x3400
    pub const TSS_SIZE: usize = 0x80
    pub const PERCPU: usize = 0x5000
    pub const PERCPU_SIZE: usize = 0x40
    // The other processors' start (smp.mlx copies it to Ap.START).
    pub const AP: usize = 0x7000
    pub const PML4: usize = 0x8000
    pub const PDPT: usize = 0x9000
    pub const PD: usize = 0xA000
    // What the monitor says of itself, as the EFI loader got it from the
    // firmware (the EDID's base block and its first extension block;
    // Info.EDID_BYTES says how many bytes, the rest is zero): a page of
    // its own between the processors' blocks and their trampoline.
    pub const EDID: usize = 0x6000
    pub const EDID_ROOM: usize = 256
    // The firmware's further displays, as the EFI loader found them (the
    // first is in the boot info's FB_* fields, as ever): a page of its
    // own. A record each (More: DISPLAY_RECORD bytes, Info.MORE_DISPLAYS
    // of them, DISPLAY_ROOM at most), then each one's monitor's EDID
    // (EDID_ROOM bytes each, the record says how many are there). A
    // loader that knows nothing of them leaves the page and the count
    // zero, and a kernel that knows nothing of them does not look.
    pub const DISPLAYS: usize = 0x4000
    pub const DISPLAY_RECORD: usize = 0x80
    pub const DISPLAY_ROOM: usize = 7
    pub const DISPLAY_EDIDS: usize = 0x4400
    pub const BOOT_STACK_TOP: usize = 0x40000
    pub const TRAP_STACK_TOP: usize = 0x80000

    // Where a part of the blob is in the kernel's view.
    pub fn virtual(offset: usize) -> usize { return Memory.KERNEL_VIRTUAL + Memory.BLOB + offset }

    // The first processor's TSS and block, in the kernel's view.
    pub fn firstTss() -> usize { return virtual(TSS) }
    pub fn firstPerCpu() -> usize { return virtual(PERCPU) }
}

// A processor's block (the first one's at Blob.PERCPU, another's in the
// page above its trap stack; the kernel's GS base on it): the top of its
// trap stack (SYSCALL's entry takes it), a word for the user stack
// pointer, its arena, its number. Its TSS follows it in that page
// (TSS_AT), PERCPU_SIZE and TSS_SIZE as in the blob.
pub const PerCpu = struct {
    pub const TRAP_STACK: usize = 0x00
    pub const USER_RSP: usize = 0x08
    pub const ARENA_BASE: usize = 0x10
    pub const ARENA_END: usize = 0x18
    pub const INDEX: usize = 0x20
    pub const TSS_AT: usize = 0x40
}

// The other processors' trampoline: its code (SIZE bytes) copied to START
// (below 1 MiB, where a startup IPI's vector names it: START / 4096),
// real mode to long mode with the boot page tables. There each processor
// says its local APIC's id (CPUID), counts itself in STARTED (the old
// count + 1 is its number) unless the kernel closed the count (CLOSED:
// it waited long enough; one that comes after halts there for good) or
// its number is past ROOM (the blocks the kernel made), writes its id
// at IDS + 4 * its number, takes its block's address from BLOCKS + 8 *
// its number (rbp), and goes on in the blob's code64 (Info.NEXT) and
// into the kernel's brix_ap. The counter, the room and the two tables
// are in the same page, after the code; the kernel writes them before
// the first startup IPI.
pub const Ap = struct {
    pub const START: usize = 0x8000
    pub const SIZE: usize = 0x200
    pub const CODE16: usize = 0x000
    pub const CODE32: usize = 0x040
    pub const CODE64: usize = 0x0A0
    pub const GDT: usize = 0x180
    pub const GDTR: usize = 0x1A0
    pub const STARTED: usize = 0x1B0
    pub const ROOM: usize = 0x1B4
    pub const BLOCKS: usize = 0x200
    pub const IDS: usize = 0xA00
    pub const END: usize = 0xE00
    pub const CLOSED: usize = 0x80000000
}

// The boot info's fields (u64 each, at Blob.BOOT_INFO + these).
pub const Info = struct {
    pub const MBI: usize = 0x00
    pub const KERNEL_PHYS: usize = 0x08
    pub const KERNEL_SIZE: usize = 0x10
    pub const ARCHIVE_PHYS: usize = 0x18
    pub const ARCHIVE_SIZE: usize = 0x20
    pub const ARENA_BASE: usize = 0x28
    pub const ARENA_END: usize = 0x30
    pub const FREE_PHYS: usize = 0x38
    // Where the blob's code64 goes on in the higher half (the other
    // processors' trampoline jumps there).
    pub const NEXT: usize = 0x40
    // The display the EFI loader found (GOP): the framebuffer's physical
    // address (0: none; a Multiboot boot finds the Bochs adapter itself),
    // its width and height in pixels, the bytes a row takes, the format
    // (1: BGRX, 2: RGBX; 32 bits a pixel).
    pub const FB_ADDRESS: usize = 0x48
    pub const FB_WIDTH: usize = 0x50
    pub const FB_HEIGHT: usize = 0x58
    pub const FB_PITCH: usize = 0x60
    pub const FB_FORMAT: usize = 0x68
    // The ACPI tables' root (the RSDP's physical address) as the EFI
    // loader found it in the firmware's configuration table (0: none
    // given; a BIOS keeps it in its own area, where the kernel looks).
    pub const RSDP: usize = 0x70
    // What the monitor says its own mode is (its EDID's first timing, as
    // the EFI loader read it from the firmware; 0: it did not say): the
    // loader sets that mode when the firmware has it, and the kernel
    // says so when the picture is another.
    pub const MONITOR_WIDTH: usize = 0x78
    pub const MONITOR_HEIGHT: usize = 0x80
    // The mode the firmware was in when the EFI loader came, whose mode
    // the loader set instead (0: none, the firmware's stays; MODE_MONITOR:
    // the monitor's own; MODE_IMAGE: the one the image names), and how
    // many displays (Graphics Output Protocols) the firmware has.
    pub const FIRMWARE_WIDTH: usize = 0x88
    pub const FIRMWARE_HEIGHT: usize = 0x90
    pub const MODE_BY: usize = 0x98
    pub const DISPLAYS: usize = 0xA0
    pub const MODE_MONITOR: usize = 1
    pub const MODE_IMAGE: usize = 2
    // (The firmware lacks the mode wanted: the nearest below it that is a
    // larger picture than the firmware's.)
    pub const MODE_NEAR_MONITOR: usize = 3
    pub const MODE_NEAR_IMAGE: usize = 4
    // The firmware's modes with pixels the kernel can use: how many the
    // loader wrote down (MODE_ROOM at most), each a word (the width above
    // 32 bits, the height below); and the firmware's status when it
    // refused the mode the loader asked for (0: it did not).
    pub const MODES: usize = 0xA8
    pub const MODE_LIST: usize = 0xB0
    pub const MODE_ROOM: usize = 32
    pub const MODE_REFUSED: usize = 0x1B0
    // The mode the loader looked for (the one the image names, else the
    // monitor's own; 0: none): where the monitor does not say its own,
    // the screen has this one's shape.
    pub const WANTED_WIDTH: usize = 0x1B8
    pub const WANTED_HEIGHT: usize = 0x1C0
    // How many bytes of this display's monitor's EDID the loader put at
    // Blob.EDID (0: the firmware gave none; 128: the base block; 256: its
    // first extension block too): the kernel's GPU driver takes the
    // monitor's own timing from it.
    pub const EDID_BYTES: usize = 0x1C8
    // What the EFI loader found for the choice of what the GPU's driver
    // does with the display at this boot (display_choice.mlx's Word: the
    // key it took at this start, what the machine remembered, what the
    // firmware let it do). One word, the last the boot info has room
    // for before the blob's GDTR (the words from 0x1E8 to 0x210 are
    // spoken for: the graphics adapters'); 0 from a loader that knows
    // nothing of it, and under Multiboot.
    pub const CHOICE: usize = 0x218
    // What the EFI loader found for how far the GPU's driver brings the
    // card's engines at this boot (engine_choice.mlx's Word: the digit
    // taken at this start). The boot info has no room left before the
    // blob's GDTR (0x220 would be Blob.GDTR32 itself): the word lies past
    // the two GDTRs, the first free eight bytes before the IDTR (Blob
    // offset 0x280). 0 from a loader that knows nothing of it, and under
    // Multiboot (the blob has nothing there).
    pub const STAGE: usize = 0x240
    // The firmware's further displays (graphics outputs with a picture
    // of their own in memory the kernel can write: Blob.DISPLAYS has a
    // record each): how many the loader wrote down; how many graphics
    // outputs it passed over because their pixels are not the kernel's
    // to use (no framebuffer, or not 32 bits a pixel); and how many
    // displays more there were than records. All 0 from a loader that
    // looks at the first output alone.
    pub const MORE_DISPLAYS: usize = 0x1D0
    pub const OUTPUTS_UNUSABLE: usize = 0x1D8
    pub const DISPLAYS_BEYOND: usize = 0x1E0
}

// A further display's record (u64 each, at Blob.DISPLAYS + its number *
// Blob.DISPLAY_RECORD + these): what the boot info's fields of the same
// names say of the first display, and which of the firmware's graphics
// outputs it is (its place in the firmware's list, from 0).
pub const More = struct {
    pub const ADDRESS: usize = 0x00
    pub const WIDTH: usize = 0x08
    pub const HEIGHT: usize = 0x10
    pub const PITCH: usize = 0x18
    pub const FORMAT: usize = 0x20
    pub const MONITOR_WIDTH: usize = 0x28
    pub const MONITOR_HEIGHT: usize = 0x30
    pub const FIRMWARE_WIDTH: usize = 0x38
    pub const FIRMWARE_HEIGHT: usize = 0x40
    pub const MODE_BY: usize = 0x48
    pub const MODE_REFUSED: usize = 0x50
    pub const EDID_BYTES: usize = 0x58
    pub const OUTPUT: usize = 0x60
}

// Selectors (GDT: null, kernel code, kernel data, user code 32 (SYSRET's
// base), user data, user code 64, TSS).
pub const Selector = struct {
    pub const KERNEL_CODE: usize = 0x08
    pub const KERNEL_DATA: usize = 0x10
    pub const USER_DATA: usize = 0x23
    pub const USER_CODE: usize = 0x2B
    // Processor 0's TSS; processor k's is TSS + 16 * k.
    pub const TSS: usize = 0x30
}

pub const Vector = struct {
    // The vector of a trap frame made by the SYSCALL entry (a system call
    // from user mode).
    pub const SYSCALL: usize = 0x80
    // The local APIC's timer (the other processors' time slices), and
    // its spurious vector.
    pub const LAPIC_TIMER: usize = 0xF0
    // An idle processor woken (an IPI: there is a process to run).
    pub const WAKE: usize = 0xF1
    // A processor stopped for good (an IPI: the system ends, power.mlx).
    pub const STOP: usize = 0xF2
    // A processor held where it is until it is let go again (an IPI:
    // smp.holdOthers, for a display's mode set while the system runs).
    pub const HOLD: usize = 0xF3
    // The devices' message-signalled interrupts (above the PIC's vectors,
    // apart from SYSCALL's 0x80): the GPU's, the network device's, the
    // USB controllers' (all of them share one).
    pub const GPU: usize = 0x50
    pub const NET: usize = 0x51
    pub const USB: usize = 0x52
    pub const SPURIOUS: usize = 0xFF
}

// The kernel's operations by SYSCALL from ring 0 (the entry tells them by
// a return address in the higher half): number in rax, arguments in rdi,
// rsi.
pub const Op = struct {
    pub const OUTB: usize = 1
    pub const INB: usize = 2
    pub const WAIT: usize = 3
    pub const READ_CR2: usize = 4
    pub const WRITE_CR3: usize = 5
    pub const READ_CR3: usize = 6
    pub const INVLPG: usize = 7
    pub const WRMSR: usize = 8
    pub const ENTER_USER: usize = 9
    pub const OUTW: usize = 10
    pub const OUTL: usize = 11
    pub const INL: usize = 12
    pub const RDTSC: usize = 13
    pub const INW: usize = 14
    // The processor's number (its block's).
    pub const CPU_ID: usize = 15
    // User mode from a trap frame (rdi: its SSE area, the frame above):
    // the trap path's return.
    pub const RESUME: usize = 16
    // A model-specific register read (rdi: which; the result its 64 bits).
    pub const RDMSR: usize = 17
    // The processor's hint that it waits in a loop (PAUSE).
    pub const PAUSE: usize = 18
    // The processor stopped for good: interrupts off, halted (it does
    // not come back).
    pub const STOP: usize = 19
    // The processor reset by a fault it cannot take (no interrupt table,
    // then a trap: three faults deep, which resets a PC): the last way to
    // restart a machine.
    pub const TRIPLE_FAULT: usize = 20
    // What the processor says of itself (CPUID; rdi: the leaf, rsi: the
    // subleaf): its ECX in the result's upper half, its EBX in the lower;
    // CPUID_AD: its EDX in the upper half, its EAX in the lower.
    pub const CPUID: usize = 21
    // A word of the processor's random number generator (RDRAND) and of
    // the source behind it (RDSEED); 0 when it gave none this time. Only
    // on a processor whose CPUID says it has the instruction.
    pub const RDRAND: usize = 22
    pub const RDSEED: usize = 23
    pub const CPUID_AD: usize = 24
    pub const COUNT: usize = 24
}
