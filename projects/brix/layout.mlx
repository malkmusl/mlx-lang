// brixOS's memory layout, shared by the kernel and brix-image (which lays
// the boot image out by it). Physical addresses unless the name says
// virtual; the kernel sees all of the first GiB at KERNEL_VIRTUAL +
// physical.

// Where the image is loaded (the Multiboot load address), where the kernel's
// segments go, and the address mlx4 links programs at.
pub const BLOB_PHYS: usize = 0x100000
pub const KERNEL_PHYS: usize = 0x200000
pub const LINK_BASE: usize = 0x400000
pub const KERNEL_VIRTUAL: usize = 0xFFFF800000000000

// The kernel's aggregate arena (mlx4's r14/r15), then the frames the kernel
// hands out, to the end of the first GiB (or of memory).
pub const ARENA_PHYS: usize = 0x1000000
pub const ARENA_SIZE: usize = 0x2000000
pub const FREE_PHYS: usize = 0x3000000
pub const MAPPED_LIMIT: usize = 0x40000000

// The blob's parts, as offsets from BLOB_PHYS.
pub const HEADER: usize = 0x000
pub const BOOT_INFO: usize = 0x040
pub const GDT: usize = 0x200
pub const GDTR32: usize = 0x260
pub const GDTR64: usize = 0x270
pub const TSS: usize = 0x280
pub const IDTR: usize = 0x300
pub const CODE32: usize = 0x400
pub const CODE64: usize = 0x500
pub const IDT: usize = 0x1000
pub const STUBS: usize = 0x2000
pub const PML4: usize = 0x8000
pub const PDPT: usize = 0x9000
pub const PD: usize = 0xA000
pub const BOOT_STACK_TOP: usize = 0x40000
pub const TRAP_STACK_TOP: usize = 0x80000

// The boot info's fields (u64 each, at BOOT_INFO + these).
pub const INFO_MBI: usize = 0x00
pub const INFO_KERNEL_PHYS: usize = 0x08
pub const INFO_KERNEL_SIZE: usize = 0x10
pub const INFO_ARCHIVE_PHYS: usize = 0x18
pub const INFO_ARCHIVE_SIZE: usize = 0x20
pub const INFO_ARENA_BASE: usize = 0x28
pub const INFO_ARENA_END: usize = 0x30
pub const INFO_FREE_PHYS: usize = 0x38
pub const INFO_USER_RSP: usize = 0x40
pub const INFO_TRAP_STACK: usize = 0x48
pub const INFO_TSS: usize = 0x50

// Selectors (GDT: null, kernel code, kernel data, user code 32 (SYSRET's
// base), user data, user code 64, TSS).
pub const KERNEL_CODE: usize = 0x08
pub const KERNEL_DATA: usize = 0x10
pub const USER_DATA: usize = 0x23
pub const USER_CODE: usize = 0x2B
pub const TSS_SELECTOR: usize = 0x30

// The vector of a trap frame made by the SYSCALL entry (a system call
// from user mode).
pub const SYSCALL_VECTOR: usize = 0x80

// The kernel's operations by SYSCALL from ring 0 (the entry tells them by
// a return address in the higher half): number in rax, arguments in rdi,
// rsi.
pub const OP_OUTB: usize = 1
pub const OP_INB: usize = 2
pub const OP_WAIT: usize = 3
pub const OP_READ_CR2: usize = 4
pub const OP_WRITE_CR3: usize = 5
pub const OP_READ_CR3: usize = 6
pub const OP_INVLPG: usize = 7
pub const OP_WRMSR: usize = 8
pub const OP_ENTER_USER: usize = 9
pub const OP_OUTW: usize = 10
pub const OP_OUTL: usize = 11
pub const OP_INL: usize = 12
pub const OP_RDTSC: usize = 13
pub const OP_COUNT: usize = 13

pub fn blobVirtual(offset: usize) -> usize { return KERNEL_VIRTUAL + BLOB_PHYS + offset }
