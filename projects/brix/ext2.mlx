// ext2, the format brixOS exchanges disks with Linux in: what the kernel's
// reader (kernel/ext2.mlx) and the host's tool (tools/ext2) agree on.
// Little-endian; a superblock at byte 1024, block groups (each a block
// bitmap, an inode bitmap, an inode table and data), inodes with twelve
// direct block numbers, one indirect, one double, one triple.
pub const Ext2 = struct {
    pub const SUPERBLOCK: usize = 1024
    pub const MAGIC: usize = 0xEF53
    pub const ROOT_INODE: usize = 2
    // Revision 0: inodes of 128 bytes, the first one free 11.
    pub const GOOD_OLD_INODE_SIZE: usize = 128
    pub const GOOD_OLD_FIRST_INODE: usize = 11
    // A directory entry's file type (with INCOMPAT_FILETYPE).
    pub const INCOMPAT_FILETYPE: usize = 0x2
    // The superblock's fields (byte offsets).
    pub const S_INODES_COUNT: usize = 0
    pub const S_BLOCKS_COUNT: usize = 4
    pub const S_FREE_BLOCKS: usize = 12
    pub const S_FREE_INODES: usize = 16
    pub const S_FIRST_DATA_BLOCK: usize = 20
    pub const S_LOG_BLOCK_SIZE: usize = 24
    pub const S_LOG_FRAG_SIZE: usize = 28
    pub const S_BLOCKS_PER_GROUP: usize = 32
    pub const S_FRAGS_PER_GROUP: usize = 36
    pub const S_INODES_PER_GROUP: usize = 40
    pub const S_WTIME: usize = 48
    pub const S_MAX_MOUNT_COUNT: usize = 54
    pub const S_MAGIC: usize = 56
    pub const S_STATE: usize = 58
    pub const S_ERRORS: usize = 60
    pub const S_REV_LEVEL: usize = 76
    pub const S_INODE_SIZE: usize = 88
    pub const S_FEATURE_INCOMPAT: usize = 96
    // A group descriptor's (32 bytes).
    pub const DESCRIPTOR_SIZE: usize = 32
    pub const G_BLOCK_BITMAP: usize = 0
    pub const G_INODE_BITMAP: usize = 4
    pub const G_INODE_TABLE: usize = 8
    pub const G_FREE_BLOCKS: usize = 12
    pub const G_FREE_INODES: usize = 14
    pub const G_USED_DIRS: usize = 16
    // An inode's.
    pub const I_MODE: usize = 0
    pub const I_SIZE: usize = 4
    pub const I_ATIME: usize = 8
    pub const I_CTIME: usize = 12
    pub const I_MTIME: usize = 16
    pub const I_LINKS: usize = 26
    pub const I_BLOCKS: usize = 28
    pub const I_BLOCK: usize = 40
    pub const I_SIZE_HIGH: usize = 108
    pub const DIRECT: usize = 12
    // i_mode's kinds.
    pub const S_IFMT: usize = 0xF000
    pub const S_IFIFO: usize = 0x1000
    pub const S_IFDIR: usize = 0x4000
    pub const S_IFREG: usize = 0x8000
    pub const S_IFLNK: usize = 0xA000
    // A symlink this short keeps its target in i_block (a fast one).
    pub const FAST_LINK: usize = 60

    pub fn get(bytes: [*]const u8, at: usize, size: usize) -> usize {
        var value: usize = 0
        var k: usize = size
        while k > 0 {
            k -= 1
            value = (value << 8) | @intCast(usize, bytes[at + k])
        }
        return value
    }

    pub fn put(bytes: [*]u8, at: usize, size: usize, value: usize) -> void {
        var k: usize = 0
        while k < size {
            bytes[at + k] = @intCast(u8, (value >> @intCast(u6, 8 * k)) & 0xFF)
            k += 1
        }
    }
}
