// How far the GPU's driver brings the card's engines at a boot (the
// steps toward a card that takes commands: kernel/gpu_engines.mlx): a
// digit held while the machine starts, in the one image, never by
// building another image. A second question beside the display's choice
// (display_choice.mlx) and independent of it, but for one thing: a boot
// that keeps the firmware's picture (F) goes no further than stage 0.
//
// This is the pure part, shared by the three that go by it, as the
// display's choice is: brix-image writes the EFI loader's digits out of
// this file (image/efi.mlx's choice part), the kernel's driver works the
// stage out with it (kernel/gpu.mlx), and
// tests/493_gpu_engines_found_runtime.mlx holds it on the host.
//
// THE STAGES (the study's section 8.4; each includes the ones before it):
// 0  the card's engines read and described, nothing of them written;
// 1  the card's memory divided between the display and the driver, the
//    GART on (the card reaches the system's memory through it);
// 2  the interrupt ring;
// 3  the SMC's own firmware started, the engines' firmware loaded by it
//    (kernel/gpu_smc_sdma.mlx);
// 4  the two copy engines running their rings;
// 5  the graphics block's settings, its RLC, the compute processor with its
//    KIQ and compute ring 0, an indirect buffer with its fence and interrupt
//    (kernel/gpu_compute.mlx);
// 6  the graphics ring with its clear state, the display's two address
//    words where they differ (kernel/gpu_graphics.mlx);
// 7  an address space as a program will have it: pages of the system's and
//    of the card's memory written through it, a fault where nothing is
//    mapped, the ring going on (kernel/gpu_first_space.mlx, through
//    kernel/gpu_space.mlx).
//
// WHERE IT COMES FROM: a digit 0 to 7 the EFI loader saw while the
// machine started (the last one counts; a letter of the display's choice
// and a digit may both be held). It is never remembered: a stage that
// hangs the machine must not come back by itself at the next start. No
// digit: stage 0. The loader hands the digit over in a word of its own
// (layout.Info.STAGE: `Word` below); the kernel works the stage out here
// (`decide`). A loader from before this, and Multiboot, leave the word 0:
// stage 0.
const choice = @import("./display_choice.mlx")

// The digits, as the keyboard gives them.
pub const DIGITS = "01234567"

// The highest stage this kernel has.
pub const BUILT: usize = 7

// (No digit.)
pub const NONE: usize = 0xFFFFFFFFFFFFFFFF

// The word the loader hands over.
pub const Word = struct {
    // The digit taken at this start: its character (0: none).
    pub const KEY: usize = 0xFF
    // A loader that knows of the digits ran: the word is never 0 from one.
    pub const LOOKED: usize = 0x100

    pub fn of(digit: u8) -> usize { return @intCast(usize, digit) | LOOKED }
}

// The digit a character of the firmware's keyboard is (its character);
// 0 when it is none of ours.
pub fn digitOf(character: usize) -> u8 {
    var k: usize = 0
    while k < DIGITS.length {
        if character == @intCast(usize, DIGITS[k]) { return DIGITS[k] }
        k += 1
    }
    return 0
}

// What a stage brings up, in the log's words.
pub fn what(stage: usize) -> []const u8 {
    if stage == 0 { return "read and described" }
    if stage == 1 { return "the GART" }
    if stage == 2 { return "the interrupt ring" }
    if stage == 3 { return "the SMC's firmware and the engines' firmware" }
    if stage == 4 { return "the two copy engines" }
    if stage == 5 { return "a compute ring" }
    if stage == 6 { return "the graphics ring" }
    return "a program's address space"
}

// The stage of a boot and why.
pub const Decision = struct {
    // The highest stage this boot tries.
    stage: usize
    // The digit pressed at this start (NONE: none).
    digit: usize
    // A loader of ours that knows of the digits ran, and it had a
    // keyboard to read.
    looked: bool
    keyboard: bool
    // The digit asked for a stage this kernel does not have yet.
    beyond: bool
    // The display's choice keeps the firmware's picture: no stage beyond
    // 0 at this boot.
    firmware: bool
}

// The stage from the loader's word, the display's choice word as the
// loader handed it over (whether it had a keyboard) and the display's
// choice as display_choice.mlx works it out.
pub fn decide(word: usize, choiceWord: usize, display: choice.Choice) -> Decision {
    var d = Decision.{ .stage = 0, .digit = NONE, .looked = word & Word.LOOKED != 0, .keyboard = false, .beyond = false, .firmware = false }
    if !d.looked { return d }
    d.keyboard = choiceWord & choice.Word.LOOKED == 0 || choiceWord & choice.Word.NO_KEYBOARD == 0
    if !d.keyboard { return d }
    const taken = word & Word.KEY
    if taken == 0 || digitOf(taken) != @intCast(u8, taken) { return d }
    d.digit = taken - @intCast(usize, DIGITS[0])
    d.stage = d.digit
    if d.stage > BUILT {
        d.stage = BUILT
        d.beyond = true
    }
    if display == choice.Choice.firmware && d.stage != 0 {
        d.stage = 0
        d.firmware = true
    }
    return d
}

fn decimal(write: fn([]const u8) -> void, value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    write(digits[at..20])
}

// The stage said in the log, one line: how far the engines go at this
// boot and why ("gpu: this boot: the card's engines up to stage 2, the
// interrupt ring (2 was pressed at this start and holds for this boot
// only)"); `card`: there is a card of ours for the stages.
pub fn say(write: fn([]const u8) -> void, d: *const Decision, card: bool) -> void {
    if !card {
        write("gpu: there is no card of ours here: nothing of a card's engines is read or written (")
    } else if d.*.stage == 0 {
        write("gpu: this boot: the card's engines are only read, stage 0 (")
    } else {
        write("gpu: this boot: the card's engines up to stage ")
        decimal(write, d.*.stage)
        write(", ")
        write(what(d.*.stage))
        write(" (")
    }
    if !d.*.looked {
        write("no loader of ours read the keys")
    } else if !d.*.keyboard {
        write("the firmware gave the loader no keyboard to read: a digit is not seen on this machine")
    } else if d.*.digit == NONE {
        write("no digit was pressed; 1 to ")
        decimal(write, BUILT)
        write(" held while the machine starts goes further")
    } else {
        decimal(write, d.*.digit)
        write(" was pressed at this start")
        if d.*.firmware {
            write(", but this boot keeps the firmware's picture (F): no stage beyond 0")
        } else if d.*.beyond {
            write("; this kernel has the stages up to ")
            decimal(write, BUILT)
        } else {
            write(" and holds for this boot only")
        }
    }
    write(")\n")
}
