// brixfs, brixOS's disk format: copy on write. Nothing that is in use is
// written in place: a change writes new blocks for what changed (a file's
// data and pointer blocks, the blocks of the inode table that hold changed
// inodes, a new table root), then a superblock that names the new root.
// The two superblocks (blocks 0 and 1) take turns; the valid one with the
// higher generation is the volume, so a change either is there entirely
// or not at all. A snapshot is an old root kept (in the snapshot table);
// blocks are free when no root reaches them.
//
// Blocks of 4 KiB:
//
//   0, 1        superblocks (A and B)
//   the rest    table roots, inode blocks, pointer blocks, data blocks,
//               snapshot tables, wherever they were free
//
// The inode table: a root block of 512 block numbers of inode blocks, 16
// inodes of 256 bytes each (8192 inodes; inode 0 is none, 1 the root
// directory). A file's data: 12 direct block numbers, an indirect block
// (512), a double indirect one (512 × 512). A directory's data: entries of
// 64 bytes (the inode, the name's length, the name), inode 0 free.
//
// Shared by the kernel (projects/brix/kernel/volume.mlx) and the brixfs
// tool (projects/brix/tools/brixfs); no std, no kernel.

pub const Brixfs = struct {
    pub const BLOCK: usize = 4096
    pub const MAGIC: usize = 0x3130534658495242 // "BRIXFS01"
    pub const VERSION: usize = 1
    pub const SUPERBLOCKS: usize = 2
    pub const ROOT_INODE: usize = 1
    pub const INODE_SIZE: usize = 256
    pub const INODES_PER_BLOCK: usize = BLOCK / INODE_SIZE
    pub const POINTERS_PER_BLOCK: usize = BLOCK / 8
    pub const MAX_INODES: usize = POINTERS_PER_BLOCK * INODES_PER_BLOCK
    pub const DIRECT: usize = 12
    pub const ENTRY_SIZE: usize = 64
    pub const NAME_MAX: usize = 59
    pub const SNAPSHOT_SIZE: usize = 64
    pub const SNAPSHOT_NAME_MAX: usize = 47
    pub const MAX_SNAPSHOTS: usize = BLOCK / SNAPSHOT_SIZE

    // Inode kinds.
    pub const FREE: usize = 0
    pub const DIRECTORY: usize = 1
    pub const FILE: usize = 2
    // A symbolic link: its target as its data.
    pub const SYMLINK: usize = 3
    // A FIFO: no data.
    pub const FIFO: usize = 4

    // ---- little-endian fields ----

    pub fn get(bytes: [*]const u8, at: usize, size: usize) -> usize {
        var value: usize = 0
        var k = size
        while k > 0 {
            k -= 1
            value = (value << 8) | @intCast(usize, bytes[at + k])
        }
        return value
    }

    pub fn put(bytes: [*]u8, at: usize, size: usize, value: usize) -> void {
        var k: usize = 0
        while k < size {
            bytes[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 255)
            k += 1
        }
    }

    // FNV-1a over `length` bytes, with the 8 at `skip` read as zeros.
    pub fn checksum(bytes: [*]const u8, length: usize, skip: usize) -> usize {
        var hash: usize = 0xCBF29CE484222325
        var k: usize = 0
        while k < length {
            const byte = if k >= skip && k < skip + 8 { 0 } else { @intCast(usize, bytes[k]) }
            hash = (hash ^ byte) *% 0x100000001B3
            k += 1
        }
        return hash
    }
}

// A superblock: what the volume is at one generation.
pub const Superblock = struct {
    const AT_MAGIC: usize = 0
    const AT_VERSION: usize = 8
    const AT_BLOCKS: usize = 16
    const AT_GENERATION: usize = 24
    const AT_ROOT: usize = 32
    const AT_NEXT_INODE: usize = 40
    const AT_SNAPSHOTS: usize = 48
    const AT_CHECKSUM: usize = 56
    const SIZE: usize = 64

    blocks: usize
    generation: usize
    // The inode table's root block.
    root: usize
    // The next inode number never used.
    nextInode: usize
    // The snapshot table's block (0: none).
    snapshots: usize

    pub fn encode(self: *const Self, into: [*]u8) -> void {
        var k: usize = 0
        while k < Brixfs.BLOCK {
            into[k] = 0
            k += 1
        }
        Brixfs.put(into, AT_MAGIC, 8, Brixfs.MAGIC)
        Brixfs.put(into, AT_VERSION, 8, Brixfs.VERSION)
        Brixfs.put(into, AT_BLOCKS, 8, self.*.blocks)
        Brixfs.put(into, AT_GENERATION, 8, self.*.generation)
        Brixfs.put(into, AT_ROOT, 8, self.*.root)
        Brixfs.put(into, AT_NEXT_INODE, 8, self.*.nextInode)
        Brixfs.put(into, AT_SNAPSHOTS, 8, self.*.snapshots)
        Brixfs.put(into, AT_CHECKSUM, 8, Brixfs.checksum(into, SIZE, AT_CHECKSUM))
    }

    // Whether the block is a superblock of this version (its checksum
    // right); it is read into `self` when it is.
    pub fn decode(self: *Self, from: [*]const u8) -> bool {
        if Brixfs.get(from, AT_MAGIC, 8) != Brixfs.MAGIC || Brixfs.get(from, AT_VERSION, 8) != Brixfs.VERSION { return false }
        if Brixfs.get(from, AT_CHECKSUM, 8) != Brixfs.checksum(from, SIZE, AT_CHECKSUM) { return false }
        self.*.blocks = Brixfs.get(from, AT_BLOCKS, 8)
        self.*.generation = Brixfs.get(from, AT_GENERATION, 8)
        self.*.root = Brixfs.get(from, AT_ROOT, 8)
        self.*.nextInode = Brixfs.get(from, AT_NEXT_INODE, 8)
        self.*.snapshots = Brixfs.get(from, AT_SNAPSHOTS, 8)
        return true
    }
}

// An inode as it is on the disk.
pub const Inode = struct {
    const AT_KIND: usize = 0
    const AT_MODE: usize = 2
    const AT_LINKS: usize = 4
    const AT_SIZE: usize = 8
    const AT_ACCESSED: usize = 16
    const AT_MODIFIED: usize = 24
    const AT_CHANGED: usize = 32
    const AT_DIRECT: usize = 40
    const AT_INDIRECT: usize = 136
    const AT_DOUBLE: usize = 144

    kind: usize
    mode: usize
    links: usize
    size: usize
    accessed: usize
    modified: usize
    changed: usize
    direct: [Brixfs.DIRECT]usize
    indirect: usize
    doubleIndirect: usize

    pub fn clear(self: *Self) -> void {
        self.*.kind = Brixfs.FREE
        self.*.mode = 0
        self.*.links = 0
        self.*.size = 0
        self.*.accessed = 0
        self.*.modified = 0
        self.*.changed = 0
        var k: usize = 0
        while k < Brixfs.DIRECT {
            self.*.direct[k] = 0
            k += 1
        }
        self.*.indirect = 0
        self.*.doubleIndirect = 0
    }

    // Inode `number`'s place in its inode block.
    pub fn offsetIn(number: usize) -> usize { return (number % Brixfs.INODES_PER_BLOCK) * Brixfs.INODE_SIZE }

    pub fn encode(self: *const Self, into: [*]u8, at: usize) -> void {
        var k: usize = 0
        while k < Brixfs.INODE_SIZE {
            into[at + k] = 0
            k += 1
        }
        Brixfs.put(into, at + AT_KIND, 1, self.*.kind)
        Brixfs.put(into, at + AT_MODE, 2, self.*.mode)
        Brixfs.put(into, at + AT_LINKS, 4, self.*.links)
        Brixfs.put(into, at + AT_SIZE, 8, self.*.size)
        Brixfs.put(into, at + AT_ACCESSED, 8, self.*.accessed)
        Brixfs.put(into, at + AT_MODIFIED, 8, self.*.modified)
        Brixfs.put(into, at + AT_CHANGED, 8, self.*.changed)
        k = 0
        while k < Brixfs.DIRECT {
            Brixfs.put(into, at + AT_DIRECT + k * 8, 8, self.*.direct[k])
            k += 1
        }
        Brixfs.put(into, at + AT_INDIRECT, 8, self.*.indirect)
        Brixfs.put(into, at + AT_DOUBLE, 8, self.*.doubleIndirect)
    }

    pub fn decode(self: *Self, from: [*]const u8, at: usize) -> void {
        self.*.kind = Brixfs.get(from, at + AT_KIND, 1)
        self.*.mode = Brixfs.get(from, at + AT_MODE, 2)
        self.*.links = Brixfs.get(from, at + AT_LINKS, 4)
        self.*.size = Brixfs.get(from, at + AT_SIZE, 8)
        self.*.accessed = Brixfs.get(from, at + AT_ACCESSED, 8)
        self.*.modified = Brixfs.get(from, at + AT_MODIFIED, 8)
        self.*.changed = Brixfs.get(from, at + AT_CHANGED, 8)
        var k: usize = 0
        while k < Brixfs.DIRECT {
            self.*.direct[k] = Brixfs.get(from, at + AT_DIRECT + k * 8, 8)
            k += 1
        }
        self.*.indirect = Brixfs.get(from, at + AT_INDIRECT, 8)
        self.*.doubleIndirect = Brixfs.get(from, at + AT_DOUBLE, 8)
    }
}

// A directory entry (its layout is the kernel's in memory too: the kernel
// writes a directory's pages with the inode numbers in place of its own
// node numbers), and a snapshot table entry.
pub const Entry = struct {
    pub fn inode(block: [*]const u8, slot: usize) -> usize { return Brixfs.get(block, slot * Brixfs.ENTRY_SIZE, 4) }
    pub fn nameLength(block: [*]const u8, slot: usize) -> usize { return Brixfs.get(block, slot * Brixfs.ENTRY_SIZE + 4, 1) }
    pub fn nameAt(slot: usize) -> usize { return slot * Brixfs.ENTRY_SIZE + 5 }
}

pub const SnapshotEntry = struct {
    // A snapshot: its name (NUL padded, 47 bytes at most), its table root
    // and next inode; a free one has root 0.
    pub fn root(block: [*]const u8, slot: usize) -> usize { return Brixfs.get(block, slot * Brixfs.SNAPSHOT_SIZE + 48, 8) }
    pub fn nameAt(slot: usize) -> usize { return slot * Brixfs.SNAPSHOT_SIZE }

    pub fn nameLength(block: [*]const u8, slot: usize) -> usize {
        var length: usize = 0
        while length < Brixfs.SNAPSHOT_NAME_MAX && block[slot * Brixfs.SNAPSHOT_SIZE + length] != 0 { length += 1 }
        return length
    }

    pub fn write(block: [*]u8, slot: usize, name: [*]const u8, length: usize, root_block: usize) -> void {
        const at = slot * Brixfs.SNAPSHOT_SIZE
        var k: usize = 0
        while k < Brixfs.SNAPSHOT_SIZE {
            block[at + k] = 0
            k += 1
        }
        k = 0
        while k < length && k < Brixfs.SNAPSHOT_NAME_MAX {
            block[at + k] = name[k]
            k += 1
        }
        Brixfs.put(block, at + 48, 8, root_block)
    }
}
