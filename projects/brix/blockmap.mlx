// A volume's blocks in use: a bit a block, 64 to a word, with the count of
// the bits that are set, and runs of blocks (a first block, how many) in a
// page. What the kernel's store (projects/brix/kernel/volume.mlx) keeps of
// a brixfs volume and what the brixfs tool's check marks.
//
// The work is by words wherever a run covers them, so that it grows with
// the number of runs and not with the number of blocks: a 500 GB disk has
// 122 million blocks, and marking a 100 GiB file a block at a time, or
// stepping over it a bit at a time to find a free block, was a second and
// more for every commit. The count makes "how much is free" a subtraction
// instead of a walk over the whole map.
//
// No std, no kernel: the memory is the caller's.

pub const BlockMap = struct {
    // The words (`wordsFor(blocks)` of them): block b is bit b % 64 of
    // word b / 64. Bits past the last block are never set.
    words: [*]usize
    blocks: usize
    // How many bits are set.
    used: usize

    pub fn wordsFor(blocks: usize) -> usize { return (blocks + 63) / 64 }

    pub fn bytesFor(blocks: usize) -> usize { return wordsFor(blocks) * 8 }

    // An empty map of `blocks` blocks in `memory`: bytesFor(blocks) bytes
    // of zeros (fresh pages are; `clear` when they are not), aligned for
    // a word.
    pub fn init(self: *Self, memory: [*]usize, blocks: usize) -> void {
        self.*.words = memory
        self.*.blocks = blocks
        self.*.used = 0
    }

    pub fn clear(self: *Self) -> void {
        const count = wordsFor(self.*.blocks)
        var k: usize = 0
        while k < count {
            self.*.words[k] = 0
            k += 1
        }
        self.*.used = 0
    }

    // How many bits of a word are set.
    pub fn ones(word: usize) -> usize {
        var v = word
        v = v - ((v >> 1) & 0x5555555555555555)
        v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333)
        v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F
        return (v *% 0x0101010101010101) >> 56
    }

    // The bits `from` up to (not with) `to` of a word (to <= 64).
    fn mask(from: usize, to: usize) -> usize {
        const high: usize = if to >= 64 { ~@intCast(usize, 0) } else { (@intCast(usize, 1) << @intCast(u6, to)) - 1 }
        return high & ~((@intCast(usize, 1) << @intCast(u6, from)) - 1)
    }

    pub fn isSet(self: *const Self, block: usize) -> bool {
        if block >= self.*.blocks { return false }
        return self.*.words[block / 64] & (@intCast(usize, 1) << @intCast(u6, block % 64)) != 0
    }

    pub fn free(self: *const Self) -> usize { return self.*.blocks - self.*.used }

    // `length` blocks from `start` on marked (those past the last block
    // are not: a volume's records may name what is not there); how many
    // of them were not marked before.
    pub fn markRun(self: *Self, start: usize, length: usize) -> usize {
        if start >= self.*.blocks { return 0 }
        const end = if length > self.*.blocks - start { self.*.blocks } else { start + length }
        var fresh: usize = 0
        var at = start
        while at < end {
            const word = at / 64
            const upTo = if end - word * 64 > 64 { 64 } else { end - word * 64 }
            const bits = mask(at % 64, upTo)
            fresh += ones(bits & ~self.*.words[word])
            self.*.words[word] |= bits
            at = (word + 1) * 64
        }
        self.*.used += fresh
        return fresh
    }

    // `length` blocks from `start` on let go, but those `keep` holds
    // (another map of the same volume, when there is one); how many were
    // let go.
    pub fn releaseRun(self: *Self, start: usize, length: usize, keep: ?*const BlockMap) -> usize {
        if start >= self.*.blocks { return 0 }
        const end = if length > self.*.blocks - start { self.*.blocks } else { start + length }
        var gone: usize = 0
        var at = start
        while at < end {
            const word = at / 64
            const upTo = if end - word * 64 > 64 { 64 } else { end - word * 64 }
            var bits = mask(at % 64, upTo)
            if keep != null { bits &= ~keep.?.*.words[word] }
            gone += ones(bits & self.*.words[word])
            self.*.words[word] &= ~bits
            at = (word + 1) * 64
        }
        self.*.used -= gone
        return gone
    }

    // The first block at or after `from` that is not marked; `blocks`
    // when there is none. Words that are full are stepped over whole.
    pub fn firstFree(self: *const Self, from: usize) -> usize {
        var at = from
        while at < self.*.blocks {
            const word = at / 64
            // (The blocks before `at` in its word count as taken.)
            const taken = self.*.words[word] | ((@intCast(usize, 1) << @intCast(u6, at % 64)) - 1)
            if taken != ~@intCast(usize, 0) {
                var bit = at % 64
                while taken & (@intCast(usize, 1) << @intCast(u6, bit)) != 0 { bit += 1 }
                const found = word * 64 + bit
                return if found < self.*.blocks { found } else { self.*.blocks }
            }
            at = (word + 1) * 64
        }
        return self.*.blocks
    }

    // Every block `other` (of the same volume) holds, held here too.
    pub fn join(self: *Self, other: *const BlockMap) -> void {
        const count = wordsFor(self.*.blocks)
        var k: usize = 0
        while k < count {
            self.*.used += ones(other.*.words[k] & ~self.*.words[k])
            self.*.words[k] |= other.*.words[k]
            k += 1
        }
    }

    // How many blocks this map holds that `other` (of the same volume)
    // does not.
    pub fn notIn(self: *const Self, other: *const BlockMap) -> usize {
        const count = wordsFor(self.*.blocks)
        var total: usize = 0
        var k: usize = 0
        while k < count {
            total += ones(self.*.words[k] & ~other.*.words[k])
            k += 1
        }
        return total
    }
}

// Runs of blocks in a page of 4 KiB: its first word names the page after
// it (the caller's: an address, 0 for none), its second how many runs it
// holds, then the runs, two words each. A run that goes on from the last
// one added is joined to it.
pub const Runs = struct {
    pub const PER_PAGE: usize = 4096 / 16 - 1

    pub fn clear(page: [*]usize) -> void {
        page[0] = 0
        page[1] = 0
    }

    pub fn next(page: [*]const usize) -> usize { return page[0] }

    pub fn setNext(page: [*]usize, address: usize) -> void { page[0] = address }

    pub fn count(page: [*]const usize) -> usize { return page[1] }

    pub fn start(page: [*]const usize, k: usize) -> usize { return page[2 + 2 * k] }

    pub fn length(page: [*]const usize, k: usize) -> usize { return page[3 + 2 * k] }

    // One run more; false when the page is full (the caller takes
    // another).
    pub fn add(page: [*]usize, first: usize, many: usize) -> bool {
        if many == 0 { return true }
        const held = page[1]
        if held > 0 && page[2 * held] + page[2 * held + 1] == first {
            page[2 * held + 1] += many
            return true
        }
        if held == PER_PAGE { return false }
        page[2 + 2 * held] = first
        page[3 + 2 * held] = many
        page[1] = held + 1
        return true
    }
}
