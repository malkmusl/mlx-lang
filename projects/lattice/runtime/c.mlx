// The C library's functions the translated code calls, as Mlx on std
// (projects/webkit/LATTICE.md): what mlx-cc --emit-mlx writes imports this
// module as `c` and calls `c.malloc`, `c.memcpy`, `c.strlen` where the
// C++ called the C library, so the translation links nothing but std.
//
// Memory: a block of `malloc` carries a 16-byte header before the bytes
// handed out (the address std.heap gave and the size asked of it), so
// `free` knows both without a size, and `posix_memalign` can hand out an
// address aligned beyond the heap's 16 by placing the header right
// before it.
const std = @import("std")
const crash = @import("std.crash")
// (mlxlibc's printf engine, Mlx as well: patterns, exact doubles.)
const format = @import("../../../compiler/libc/format.mlx")

const HEADER: usize = 16

fn allocator() -> std.heap.Allocator { return std.heap.allocator() }

fn wordAt(address: usize) -> *usize {
    unsafe { return @ptrFromInt(*usize, address) }
}

// `bytes` bytes aligned to `alignment` (a power of two, 16 at least), or
// null.
fn allocate(bytes: usize, alignment: usize) -> ?[*]u8 {
    const total = bytes + alignment + HEADER
    const block = allocator().alloc(total, 16)
    if block == null { return null }
    const start = @intFromPtr(block.?)
    const data = (start + HEADER + alignment - 1) & ~(alignment - 1)
    wordAt(data - 16).* = start
    wordAt(data - 8).* = total
    unsafe { return @ptrFromInt([*]u8, data) }
}

pub fn malloc(size: u64) -> ?[*]u8 {
    return allocate(@intCast(usize, size), 16)
}

pub fn calloc(count: u64, size: u64) -> ?[*]u8 {
    const bytes = @intCast(usize, count * size)
    const block = allocate(bytes, 16)
    if block != null { std.mem.set(block.?, 0, bytes) }
    return block
}

pub fn free(memory: ?[*]u8) -> void {
    if memory == null { return }
    const data = @intFromPtr(memory.?)
    const start = wordAt(data - 16).*
    const total = wordAt(data - 8).*
    unsafe { allocator().free(@ptrFromInt([*]u8, start), total, 16) }
}

// The bytes a block of `malloc` holds (its size asked for, at least).
fn capacityOf(memory: [*]u8) -> usize {
    const data = @intFromPtr(memory)
    const start = wordAt(data - 16).*
    const total = wordAt(data - 8).*
    return start + total - data
}

pub fn realloc(memory: ?[*]u8, size: u64) -> ?[*]u8 {
    if memory == null { return malloc(size) }
    const wanted = @intCast(usize, size)
    const grown = allocate(wanted, 16)
    if grown == null { return null }
    const kept = capacityOf(memory.?)
    std.mem.copy(grown.?, memory.?, if kept < wanted { kept } else { wanted })
    free(memory)
    return grown
}

// posix_memalign(3): the block at *result, 0; EINVAL (22) for an alignment
// that is not a power of two or not a multiple of a pointer's size, ENOMEM
// (12) when memory is out.
pub fn posix_memalign(result: ?[*]?[*]u8, alignment: u64, size: u64) -> i32 {
    const wanted = @intCast(usize, alignment)
    if wanted < 8 || (wanted & (wanted - 1)) != 0 { return 22 }
    const block = allocate(@intCast(usize, size), if wanted < 16 { 16 } else { wanted })
    if block == null { return 12 }
    if result != null { result.?[0] = block }
    return 0
}

pub fn memcpy(destination: ?[*]u8, source: ?[*]const u8, count: u64) -> ?[*]u8 {
    if count > 0 { std.mem.copy(destination.?, source.?, @intCast(usize, count)) }
    return destination
}

pub fn memmove(destination: ?[*]u8, source: ?[*]const u8, count: u64) -> ?[*]u8 {
    if count == 0 { return destination }
    const n = @intCast(usize, count)
    if @intFromPtr(destination.?) > @intFromPtr(source.?) && @intFromPtr(destination.?) < @intFromPtr(source.?) + n {
        std.mem.copyBackwards(destination.?, source.?, n)
    } else {
        std.mem.copy(destination.?, source.?, n)
    }
    return destination
}

pub fn memset(destination: ?[*]u8, value: i32, count: u64) -> ?[*]u8 {
    if count > 0 { std.mem.set(destination.?, @intCast(u8, @bitCast(u32, value) & 255), @intCast(usize, count)) }
    return destination
}

pub fn memcmp(left: ?[*]const u8, right: ?[*]const u8, count: u64) -> i32 {
    var k: usize = 0
    const n = @intCast(usize, count)
    while k < n {
        const a = left.?[k]
        const b = right.?[k]
        if a != b { return if a < b { -1 } else { 1 } }
        k += 1
    }
    return 0
}

pub fn strlen(text: ?[*]const u8) -> u64 {
    var k: usize = 0
    while text.?[k] != 0 { k += 1 }
    return @intCast(u64, k)
}

pub fn strcmp(left: ?[*]const u8, right: ?[*]const u8) -> i32 {
    var k: usize = 0
    while true {
        const a = left.?[k]
        const b = right.?[k]
        if a != b { return if a < b { -1 } else { 1 } }
        if a == 0 { return 0 }
        k += 1
    }
    return 0
}

pub fn strncmp(left: ?[*]const u8, right: ?[*]const u8, count: u64) -> i32 {
    var k: usize = 0
    const n = @intCast(usize, count)
    while k < n {
        const a = left.?[k]
        const b = right.?[k]
        if a != b { return if a < b { -1 } else { 1 } }
        if a == 0 { return 0 }
        k += 1
    }
    return 0
}

pub fn strchr(text: ?[*]const u8, wanted: i32) -> ?[*]const u8 {
    const byte = @intCast(u8, @bitCast(u32, wanted) & 255)
    var k: usize = 0
    while true {
        if text.?[k] == byte { return text.? + k }
        if text.?[k] == 0 { return null }
        k += 1
    }
    return null
}

// abort(3): the crash report (std.crash), then the process ends.
pub fn abort() -> void {
    crash.fail("abort() called")
}

// ---------------------------------------------------------------------------
// stdio: the standard streams as opaque handles (1 stdout, 2 stderr, 0
// stdin), fputs, fputc and puts on std.io.

pub fn stdin() -> ?*anyopaque { unsafe { return @ptrFromInt(?*anyopaque, 16) } }
pub fn stdout() -> ?*anyopaque { unsafe { return @ptrFromInt(?*anyopaque, 17) } }
pub fn stderr() -> ?*anyopaque { unsafe { return @ptrFromInt(?*anyopaque, 18) } }

fn fileOf(stream: ?*anyopaque) -> std.io.File {
    if stream != null && @intFromPtr(stream.?) == 18 { return std.io.stderr() }
    return std.io.stdout()
}

pub fn fputs(text: ?[*]const u8, stream: ?*anyopaque) -> i32 {
    const length = @intCast(usize, strlen(text))
    _ = std.io.write(fileOf(stream), text.?[0..length])
    return 0
}

pub fn puts(text: ?[*]const u8) -> i32 {
    _ = fputs(text, stdout())
    _ = std.io.write(std.io.stdout(), "\n")
    return 0
}

pub fn fputc(byte: i32, stream: ?*anyopaque) -> i32 {
    var one: [1]u8 = [1]u8{ @intCast(u8, @bitCast(u32, byte) & 255) }
    _ = std.io.write(fileOf(stream), one[0..1])
    return byte
}

pub fn putc(byte: i32, stream: ?*anyopaque) -> i32 { return fputc(byte, stream) }

pub fn fflush(stream: ?*anyopaque) -> i32 {
    _ = stream
    return 0
}

// ---------------------------------------------------------------------------
// Variable arguments. A C function with `...` is written with a last
// parameter `va: []const u64`: the caller puts every argument after the
// named ones into a word (an integer extended to 64 bits, a pointer's
// address, a double's bits; a float is a double there, as C promotes
// it). A va_list is the System V record all the same, read by va_arg and
// by the v-functions: its two register offsets say "none left in the
// registers" and its overflow area is the words.

pub const VaList = extern struct {
    gp_offset: u32
    fp_offset: u32
    overflow_arg_area: ?[*]const u64
    reg_save_area: ?[*]u8
}

pub fn va_start(list: ?*VaList, arguments: []const u64) -> void {
    list.?.*.gp_offset = 48
    list.?.*.fp_offset = 176
    list.?.*.overflow_arg_area = arguments.pointer
    list.?.*.reg_save_area = null
}

// va_arg: the next word. (The translation makes the argument's type of
// it.)
pub fn va_arg(list: ?*VaList) -> u64 {
    const area = list.?.*.overflow_arg_area.?
    const word = area[0]
    list.?.*.overflow_arg_area = area + 1
    return word
}

// A bool as a word of the arguments (an int in C).
pub fn va_bool(value: bool) -> u64 { return if value { 1 } else { 0 } }

pub fn va_copy(target: ?*VaList, source: ?*VaList) -> void {
    target.?.* = source.?.*
}

// A va_list of the words, for the functions that take the arguments
// themselves (snprintf from vsnprintf).
fn listOf(arguments: []const u64) -> VaList {
    var list: VaList = undefined
    va_start(&list, arguments)
    return list
}

fn writeToFile(context: usize, bytes: usize, count: usize) -> void {
    const text = unsafe { @ptrFromInt([*]const u8, bytes) }
    _ = std.io.write(if context == 2 { std.io.stderr() } else { std.io.stdout() }, text[0..count])
}

pub fn vsnprintf(buffer: ?[*]u8, size: u64, pattern: ?[*]const u8, list: ?*VaList) -> i32 {
    var source = format.vaList(@intFromPtr(list.?))
    const limit = @intCast(usize, size)
    const target: usize = if buffer == null { 0 } else { @intFromPtr(buffer.?) }
    var sink = format.bufferSink(target, if limit == 0 { 0 } else { limit - 1 })
    format.format(&sink, @intFromPtr(pattern.?), &source)
    if limit > 0 { buffer.?[sink.length] = 0 }
    return @intCast(i32, sink.written)
}

pub fn vsprintf(buffer: ?[*]u8, pattern: ?[*]const u8, list: ?*VaList) -> i32 {
    return vsnprintf(buffer, 2147483647, pattern, list)
}

pub fn vfprintf(stream: ?*anyopaque, pattern: ?[*]const u8, list: ?*VaList) -> i32 {
    var source = format.vaList(@intFromPtr(list.?))
    var chunk: [512]u8 = undefined
    const which: usize = if stream != null && @intFromPtr(stream.?) == 18 { 2 } else { 1 }
    var sink = format.streamSink(@intFromPtr(writeToFile), which, @intFromPtr(&chunk), 512)
    format.format(&sink, @intFromPtr(pattern.?), &source)
    format.flush(&sink)
    return @intCast(i32, sink.written)
}

pub fn vprintf(pattern: ?[*]const u8, list: ?*VaList) -> i32 {
    return vfprintf(stdout(), pattern, list)
}

pub fn snprintf(buffer: ?[*]u8, size: u64, pattern: ?[*]const u8, va: []const u64) -> i32 {
    var list = listOf(va)
    return vsnprintf(buffer, size, pattern, &list)
}

pub fn sprintf(buffer: ?[*]u8, pattern: ?[*]const u8, va: []const u64) -> i32 {
    var list = listOf(va)
    return vsnprintf(buffer, 2147483647, pattern, &list)
}

pub fn fprintf(stream: ?*anyopaque, pattern: ?[*]const u8, va: []const u64) -> i32 {
    var list = listOf(va)
    return vfprintf(stream, pattern, &list)
}

pub fn printf(pattern: ?[*]const u8, va: []const u64) -> i32 {
    var list = listOf(va)
    return vfprintf(stdout(), pattern, &list)
}

// ---------------------------------------------------------------------------
// ctype

pub fn isdigit(byte: i32) -> i32 { return if byte >= 48 && byte <= 57 { 1 } else { 0 } }

pub fn toupper(byte: i32) -> i32 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }

pub fn tolower(byte: i32) -> i32 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// ---------------------------------------------------------------------------
// errno and the number parsers

var errnoValue: i32 = 0

pub fn __errno_location() -> ?[*]i32 {
    const p: *i32 = &errnoValue
    return p
}

fn digitValue(byte: u8) -> i32 {
    if byte >= 48 && byte <= 57 { return @intCast(i32, byte) - 48 }
    if byte >= 97 && byte <= 122 { return @intCast(i32, byte) - 97 + 10 }
    if byte >= 65 && byte <= 90 { return @intCast(i32, byte) - 65 + 10 }
    return 99
}

// strtoul(3): leading blanks, a sign, 0x for base 16 (and base 0: 0x
// hexadecimal, 0 octal, else decimal), the digits; *end the first byte
// not taken; ERANGE (34) and ULONG_MAX on overflow.
pub fn strtoul(text: ?[*]const u8, end: ?[*]?[*]u8, base: i32) -> u64 {
    var k: usize = 0
    while text.?[k] == 32 || (text.?[k] >= 9 && text.?[k] <= 13) { k += 1 }
    var negative = false
    if text.?[k] == 45 {
        negative = true
        k += 1
    } else if text.?[k] == 43 {
        k += 1
    }
    var radix = base
    if (radix == 0 || radix == 16) && text.?[k] == 48 && (text.?[k + 1] == 120 || text.?[k + 1] == 88) && digitValue(text.?[k + 2]) < 16 {
        radix = 16
        k += 2
    } else if radix == 0 {
        radix = if text.?[k] == 48 { 8 } else { 10 }
    }
    var value: u64 = 0
    var overflow = false
    var any = false
    while true {
        const digit = digitValue(text.?[k])
        if digit >= radix { break }
        any = true
        const limit = (18446744073709551615 - @intCast(u64, digit)) / @intCast(u64, radix)
        if value > limit { overflow = true }
        value = value * @intCast(u64, radix) + @intCast(u64, digit)
        k += 1
    }
    if end != null {
        const taken: [*]u8 = unsafe { @ptrCast([*]u8, text.?) }
        end.?[0] = if any { taken + k } else { taken }
    }
    if overflow {
        errnoValue = 34
        return 18446744073709551615
    }
    if negative { return 0 -% value }
    return value
}

pub fn strtol(text: ?[*]const u8, end: ?[*]?[*]u8, base: i32) -> i64 {
    return @bitCast(i64, strtoul(text, end, base))
}

// atoi(3): strtol in base 10, the low 32 bits.
pub fn atoi(text: ?[*]const u8) -> i32 {
    return @bitCast(i32, @intCast(u32, @bitCast(u64, strtol(text, null, 10)) & 4294967295))
}

fn lowerByte(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn matchesWord(text: [*]const u8, at: usize, word: []const u8) -> bool {
    var k: usize = 0
    while k < word.length {
        if lowerByte(text[at + k]) != word[k] { return false }
        k += 1
    }
    return true
}

// 10^exponent by squaring (exact up to 10^22; the rest rounded).
fn powerOfTen(exponent: i64) -> f64 {
    var result: f64 = 1.0
    var count: i64 = if exponent < 0 { 0 - exponent } else { exponent }
    var base: f64 = 10.0
    while count > 0 {
        if count & 1 == 1 { result = result * base }
        base = base * base
        count = count >> 1
    }
    if exponent < 0 { return 1.0 / result }
    return result
}

// mantissa * 10^exponent: exact when the mantissa has at most 53 bits
// and the power of ten is exact (|exponent| <= 22), one multiplication
// or division of two exact doubles correctly rounded; the rest scaled by
// repeated multiplication, which can be off by a unit in the last place
// (mlxlibc's stdlib.mlx has the exact big-number version).
fn scaleByTen(mantissa: u64, exponent: i64) -> f64 {
    if mantissa == 0 { return 0.0 }
    const m: f64 = @floatFromInt(f64, mantissa)
    if exponent == 0 { return m }
    if mantissa < 9007199254740992 && exponent >= -22 && exponent <= 22 {
        if exponent > 0 { return m * powerOfTen(exponent) }
        return m / powerOfTen(0 - exponent)
    }
    if exponent > 330 {
        errnoValue = 34
        return @bitCast(f64, @intCast(u64, 9218868437227405312))
    }
    if exponent < -360 {
        errnoValue = 34
        return 0.0
    }
    return m * powerOfTen(exponent)
}

// strtod(3): blanks, a sign, `inf`, `infinity` or `nan`, else decimal
// digits with a point and an exponent; *end the first byte not taken.
// Up to 19 significant digits are kept. Hexadecimal floats are not read.
pub fn strtod(text: ?[*]const u8, end: ?[*]?[*]u8) -> f64 {
    const bytes: [*]const u8 = text.?
    const start: [*]u8 = unsafe { @ptrCast([*]u8, text.?) }
    var k: usize = 0
    while bytes[k] == 32 || (bytes[k] >= 9 && bytes[k] <= 13) { k += 1 }
    var negative = false
    if bytes[k] == 45 || bytes[k] == 43 {
        negative = bytes[k] == 45
        k += 1
    }
    if matchesWord(bytes, k, "inf") {
        k += if matchesWord(bytes, k, "infinity") { 8 } else { 3 }
        if end != null { end.?[0] = start + k }
        const infinity: f64 = @bitCast(f64, @intCast(u64, 9218868437227405312))
        return if negative { -infinity } else { infinity }
    }
    if matchesWord(bytes, k, "nan") {
        k += 3
        if bytes[k] == 40 {
            var close = k + 1
            while bytes[close] != 0 && bytes[close] != 41 { close += 1 }
            if bytes[close] == 41 { k = close + 1 }
        }
        if end != null { end.?[0] = start + k }
        return @bitCast(f64, @intCast(u64, if negative { 18444492273895866368 } else { 9221120237041090560 }))
    }
    var mantissa: u64 = 0
    var exponent: i64 = 0
    var digits: usize = 0
    var any = false
    while bytes[k] >= 48 && bytes[k] <= 57 {
        any = true
        if digits < 19 {
            mantissa = mantissa * 10 + @intCast(u64, bytes[k] - 48)
            digits += 1
        } else {
            exponent += 1
        }
        k += 1
    }
    if bytes[k] == 46 {
        var after = k + 1
        var fraction = false
        while bytes[after] >= 48 && bytes[after] <= 57 {
            fraction = true
            if digits < 19 {
                mantissa = mantissa * 10 + @intCast(u64, bytes[after] - 48)
                digits += 1
                exponent -= 1
            }
            after += 1
        }
        if any || fraction {
            any = true
            k = after
        }
    }
    if !any {
        if end != null { end.?[0] = start }
        return 0.0
    }
    if bytes[k] == 101 || bytes[k] == 69 {
        var e = k + 1
        var exponentNegative = false
        if bytes[e] == 45 || bytes[e] == 43 {
            exponentNegative = bytes[e] == 45
            e += 1
        }
        if bytes[e] >= 48 && bytes[e] <= 57 {
            var value: i64 = 0
            while bytes[e] >= 48 && bytes[e] <= 57 {
                if value < 100000 { value = value * 10 + @intCast(i64, bytes[e] - 48) }
                e += 1
            }
            exponent += if exponentNegative { 0 - value } else { value }
            k = e
        }
    }
    if end != null { end.?[0] = start + k }
    const value = scaleByTen(mantissa, exponent)
    return if negative { -value } else { value }
}

pub fn atof(text: ?[*]const u8) -> f64 { return strtod(text, null) }

// A compare-exchange as C's `__atomic_compare_exchange_n` and
// std::atomic's `compare_exchange_strong` have it: the expected value
// through a pointer, which takes the value seen when the swap fails.
pub fn atomic_compare_exchange(comptime T: type, object: *T, expected: *T, desired: T) -> bool {
    const result = @cmpxchgStrong(T, object, expected.*, desired, seq_cst, seq_cst)
    if !result.0 { expected.* = result.1 }
    return result.0
}

// The bit builtins of C (`__builtin_clz`, `__builtin_ctz`,
// `__builtin_bswap32`, `__builtin_ffs`) on a value of `bits` bits, held
// in 64. (A zero's leading or trailing zeros, undefined in C: `bits`.)
pub fn clz(value: u64, bits: u64) -> i32 {
    if value == 0 { return @intCast(i32, bits) }
    var count: u64 = 0
    var width: u64 = bits
    var rest = value
    // (Halving: the upper half empty, the count grows by the half.)
    while width > 1 {
        const half = width / 2
        if (rest >> @intCast(u6, half)) == 0 {
            count += half
        } else {
            rest = rest >> @intCast(u6, half)
        }
        width = half
    }
    return @intCast(i32, count)
}

pub fn ctz(value: u64, bits: u64) -> i32 {
    if value == 0 { return @intCast(i32, bits) }
    var count: u64 = 0
    var rest = value
    while (rest & 1) == 0 {
        rest = rest >> 1
        count += 1
    }
    return @intCast(i32, count)
}

pub fn ffs(value: u64, bits: u64) -> i32 {
    if value == 0 { return 0 }
    return ctz(value, bits) + 1
}

pub fn bswap(value: u64, bits: u64) -> u64 {
    var result: u64 = 0
    var rest = value
    var k: u64 = 0
    while k < bits / 8 {
        result = (result << 8) | (rest & 255)
        rest = rest >> 8
        k += 1
    }
    return result
}

// `__builtin_add_overflow(x, y, p)`, `__builtin_sub_overflow` and
// `__builtin_mul_overflow` for one integer type of 4 or 8 bytes: the
// result as it wraps stored at `result`, true when the exact result does
// not fit the type.
pub fn add_overflow_u32(a: u32, b: u32, result: [*]u32) -> bool {
    result[0] = a +% b
    return result[0] < a
}

pub fn sub_overflow_u32(a: u32, b: u32, result: [*]u32) -> bool {
    result[0] = a -% b
    return a < b
}

pub fn mul_overflow_u32(a: u32, b: u32, result: [*]u32) -> bool {
    const wide = @intCast(u64, a) * @intCast(u64, b)
    result[0] = @intCast(u32, wide & 4294967295)
    return wide > 4294967295
}

pub fn add_overflow_u64(a: u64, b: u64, result: [*]u64) -> bool {
    result[0] = a +% b
    return result[0] < a
}

pub fn sub_overflow_u64(a: u64, b: u64, result: [*]u64) -> bool {
    result[0] = a -% b
    return a < b
}

pub fn mul_overflow_u64(a: u64, b: u64, result: [*]u64) -> bool {
    result[0] = a *% b
    if a == 0 { return false }
    return result[0] / a != b
}

pub fn add_overflow_i32(a: i32, b: i32, result: [*]i32) -> bool {
    const wide = @intCast(i64, a) + @intCast(i64, b)
    result[0] = @bitCast(i32, @intCast(u32, @bitCast(u64, wide) & 4294967295))
    return wide != @intCast(i64, result[0])
}

pub fn sub_overflow_i32(a: i32, b: i32, result: [*]i32) -> bool {
    const wide = @intCast(i64, a) - @intCast(i64, b)
    result[0] = @bitCast(i32, @intCast(u32, @bitCast(u64, wide) & 4294967295))
    return wide != @intCast(i64, result[0])
}

pub fn mul_overflow_i32(a: i32, b: i32, result: [*]i32) -> bool {
    const wide = @intCast(i64, a) * @intCast(i64, b)
    result[0] = @bitCast(i32, @intCast(u32, @bitCast(u64, wide) & 4294967295))
    return wide != @intCast(i64, result[0])
}

// (A signed sum overflows when both operands' signs differ from the
// sum's; a difference when the operands' signs differ and the result's
// is not the first's.)
pub fn add_overflow_i64(a: i64, b: i64, result: [*]i64) -> bool {
    const sum = @bitCast(i64, @bitCast(u64, a) +% @bitCast(u64, b))
    result[0] = sum
    return ((a ^ sum) & (b ^ sum)) < 0
}

pub fn sub_overflow_i64(a: i64, b: i64, result: [*]i64) -> bool {
    const difference = @bitCast(i64, @bitCast(u64, a) -% @bitCast(u64, b))
    result[0] = difference
    return ((a ^ b) & (a ^ difference)) < 0
}

// (The product as it wraps; it fits when dividing it back gives the
// operand, the lowest number times -1 aside.)
pub fn mul_overflow_i64(a: i64, b: i64, result: [*]i64) -> bool {
    const product = @bitCast(i64, @bitCast(u64, a) *% @bitCast(u64, b))
    result[0] = product
    if a == 0 || b == 0 { return false }
    const lowest: i64 = -9223372036854775807 - 1
    if (a == -1 && b == lowest) || (b == -1 && a == lowest) { return true }
    return product / b != a
}

// pthread's mutex (std::mutex under mlxlibcpp): the first word of its
// storage is 0 when it is free and 1 when it is held. A lock that finds
// it held tries again until it is free: no thread sleeps yet (the wait
// belongs on the system's own primitive once the translated code runs
// threads in earnest).
fn mutexWord(mutex: ?[*]u8) -> *u32 {
    unsafe { return @ptrCast(*u32, mutex.?) }
}

pub fn pthread_mutex_init(mutex: ?[*]u8, attributes: ?[*]u8) -> i32 {
    _ = attributes
    @atomicStore(u32, mutexWord(mutex), 0, seq_cst)
    return 0
}

pub fn pthread_mutex_destroy(mutex: ?[*]u8) -> i32 {
    _ = mutex
    return 0
}

pub fn pthread_mutex_trylock(mutex: ?[*]u8) -> i32 {
    const result = @cmpxchgStrong(u32, mutexWord(mutex), 0, 1, acquire, monotonic)
    // (16: EBUSY.)
    return if result.0 { 0 } else { 16 }
}

pub fn pthread_mutex_lock(mutex: ?[*]u8) -> i32 {
    while pthread_mutex_trylock(mutex) != 0 {
    }
    return 0
}

pub fn pthread_mutex_unlock(mutex: ?[*]u8) -> i32 {
    @atomicStore(u32, mutexWord(mutex), 0, release)
    return 0
}
