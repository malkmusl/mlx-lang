// The Mlx side of the casts2 test: casts2.cpp translated
// (casts2.mlx), its `run` called and the result printed, as
// casts2_ref.cpp prints the C++'s.
const std = @import("std")
const casts2 = @import("./casts2.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, casts2.casts2_run())))
    _ = std.io.print("\n")
    return 0
}
