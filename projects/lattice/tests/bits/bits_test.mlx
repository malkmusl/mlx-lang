// The Mlx side of the bit-fields test: bits.cpp translated (bits.mlx),
// its `run` called and the result printed, as bits_ref.cpp prints the
// C++'s.
const std = @import("std")
const bits = @import("./bits.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, bits.bits_run())))
    _ = std.io.print("\n")
    return 0
}
