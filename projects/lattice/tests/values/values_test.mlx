// The Mlx side of the values test: values.cpp translated (values.mlx),
// its `run` called and the result printed, as values_ref.cpp prints the
// C++'s.
const std = @import("std")
const values = @import("./values.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, values.values_run())))
    _ = std.io.print("\n")
    return 0
}
