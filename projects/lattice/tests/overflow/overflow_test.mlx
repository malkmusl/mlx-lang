// The Mlx side of the overflow test: overflow.cpp translated
// (overflow.mlx), its `run` called and the result printed, as
// overflow_ref.cpp prints the C++'s.
const std = @import("std")
const overflow = @import("./overflow.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, overflow.overflow_run())))
    _ = std.io.print("\n")
    return 0
}
