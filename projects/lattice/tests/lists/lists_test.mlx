// The Mlx side of the lists test: lists.cpp translated
// (lists.mlx), its `run` called and the result printed, as
// lists_ref.cpp prints the C++'s.
const std = @import("std")
const lists = @import("./lists.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, lists.lists_run())))
    _ = std.io.print("\n")
    return 0
}
