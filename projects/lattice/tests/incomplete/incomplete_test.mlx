// The Mlx side of the incomplete test: user.cpp and maker.cpp translated
// as one program (user.mlx, maker.mlx), `run` called and the result
// printed, as incomplete_ref.cpp prints the C++'s.
const std = @import("std")
const user = @import("./user.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, user.incomplete_run())))
    _ = std.io.print("\n")
    return 0
}
