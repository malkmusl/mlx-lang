// The Mlx side of the virtual-functions test: shapes.cpp translated
// (shapes.mlx), its `run` called and the result printed, as
// shapes_ref.cpp prints the C++'s.
const std = @import("std")
const shapes = @import("./shapes.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, shapes.run())))
    _ = std.io.print("\n")
    return 0
}
