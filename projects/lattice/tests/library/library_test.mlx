// The Mlx side of the library test: library.cpp translated
// (library.mlx), its `run` called and the result printed, as
// library_ref.cpp prints the C++'s.
const std = @import("std")
const library = @import("./library.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, library.library_run())))
    _ = std.io.print("\n")
    return 0
}
