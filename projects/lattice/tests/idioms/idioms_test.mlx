// The Mlx side of the idioms test: idioms.cpp translated (idioms.mlx),
// its `run` called and the result printed, as idioms_ref.cpp prints the
// C++'s.
const std = @import("std")
const idioms = @import("./idioms.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, idioms.idioms_run())))
    _ = std.io.print("\n")
    return 0
}
