// The Mlx side of the casts test: casts.cpp translated
// (casts.mlx), its `run` called and the result printed, as
// casts_ref.cpp prints the C++'s.
const std = @import("std")
const casts = @import("./casts.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, casts.casts_run())))
    _ = std.io.print("\n")
    return 0
}
