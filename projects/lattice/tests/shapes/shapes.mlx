fn shapes_made() -> u32 {
    var sum: u32 = undefined
    var tmp_1: ?[*]u32 = undefined
    var tmp_2: ?[*]u32 = undefined
    sum = 0
    sum = (shapes_kStart +% shapes_filled())
    tmp_1 = &sum
    tmp_1.?[0] = (tmp_1.?[0] +% @bitCast(u32, (if shapes_once() { 1 } else { 0 })))
    tmp_2 = &sum
    tmp_2.?[0] = (tmp_2.?[0] +% @bitCast(u32, (if shapes_once() { 1 } else { 0 })))
    return ((((sum *% @bitCast(u32, 10)) +% shapes_calls) *% @bitCast(u32, 1000)) +% shapes_rows())
}

// from projects/lattice/tests/shapes/shapes.cpp:358
// namespace shapes
pub fn shapes_run() -> u32 {
    var sum: u32 = undefined
    var tmp_1: ?[*]u32 = undefined
    var tmp_2: ?[*]u32 = undefined
    var tmp_3: ?[*]u32 = undefined
    var words: [3]?[*]const u8 = undefined
    var tmp_5: ?[*]u32 = undefined
    var tmp_6: ?[*]u32 = undefined
    var tmp_7: ?[*]u32 = undefined
    var tmp_8: ?[*]u32 = undefined
    var tmp_9: ?[*]u32 = undefined
    var tmp_10: ?[*]u32 = undefined
    var pixel: shapes_Pixel = undefined
    var tmp_12: ?[*]u32 = undefined
    var tmp_13: ?[*]u32 = undefined
    var tmp_14: ?[*]u32 = undefined
    var tmp_15: ?[*]u32 = undefined
    var tmp_16: ?[*]u32 = undefined
    var tmp_17: ?[*]u32 = undefined
    sum = 0
    sum = (shapes_more() +% shapes_made())
    tmp_1 = &sum
    tmp_1.?[0] = (tmp_1.?[0] +% shapes_blocks(@bitCast(u32, 10), @bitCast(u32, 4), @bitCast(u32, 2)))
    tmp_2 = &sum
    tmp_2.?[0] = (tmp_2.?[0] +% shapes_blocks(@bitCast(u32, 1), @bitCast(u32, 4), @bitCast(u32, 5)))
    tmp_3 = &sum
    tmp_3.?[0] = (tmp_3.?[0] +% shapes_blocks(@bitCast(u32, 8), @bitCast(u32, 0), @bitCast(u32, 1)))
    _ = c.memset(unsafe { @ptrCast(?[*]u8, &words) }, 0, @sizeOf([3]?[*]const u8))
    words[0] = "one".pointer
    words[1] = "three".pointer
    words[2] = "seven".pointer
    tmp_5 = &sum
    tmp_5.?[0] = (tmp_5.?[0] +% ((shapes_guarded(@bitCast(u32, 0)) +% (shapes_guarded(@bitCast(u32, 5)) *% @bitCast(u32, 10))) +% (shapes_guarded(@bitCast(u32, 2)) *% @bitCast(u32, 100))))
    tmp_6 = &sum
    tmp_6.?[0] = (tmp_6.?[0] +% shapes_labelled(@bitCast(u32, 11)))
    tmp_7 = &sum
    tmp_7.?[0] = (tmp_7.?[0] +% shapes_chosen(false, true))
    tmp_8 = &sum
    tmp_8.?[0] = (tmp_8.?[0] +% shapes_chosen(true, false))
    tmp_9 = &sum
    tmp_9.?[0] = (tmp_9.?[0] +% shapes_pushed(true))
    tmp_10 = &sum
    tmp_10.?[0] = (tmp_10.?[0] +% shapes_pushed(false))
    pixel.R = @intCast(u8, 10)
    pixel.G = @intCast(u8, 20)
    pixel.B = @intCast(u8, 30)
    pixel.A = @intCast(u8, 40)
    tmp_12 = &sum
    tmp_12.?[0] = (tmp_12.?[0] +% shapes_channels(&pixel))
    tmp_13 = &sum
    tmp_13.?[0] = (tmp_13.?[0] +% shapes_grid())
    tmp_14 = &sum
    tmp_14.?[0] = (tmp_14.?[0] +% shapes_names(&words, @bitCast(u32, 3)))
    tmp_15 = &sum
    tmp_15.?[0] = (tmp_15.?[0] +% shapes_bits(@intCast(u64, 4096)))
    tmp_16 = &sum
    tmp_16.?[0] = (tmp_16.?[0] +% shapes_converted(&pixel))
    tmp_17 = &sum
    tmp_17.?[0] = (tmp_17.?[0] +% shapes_fast())
    return sum
}

// The unit's global objects made, as C++ makes them before main: the
// program's start calls this once.
pub fn lattice_start() -> void {
    shapes_kStart = shapes_count()
}

