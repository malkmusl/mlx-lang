// The Mlx side of the shapes test: shapes.cpp translated
// (shapes.mlx), its `run` called and the result printed, as
// shapes_ref.cpp prints the C++'s.
const std = @import("std")
const shapes = @import("./shapes.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    // (The unit's global objects made, as C++ makes them before main.)
    shapes.lattice_start()
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, shapes.shapes_run())))
    _ = std.io.print("\n")
    return 0
}
