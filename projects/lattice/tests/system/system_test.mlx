// The Mlx side of the system test: system.cpp translated
// (system.mlx), its `run` called and the result printed, as
// system_ref.cpp prints the C++'s.
const std = @import("std")
const system = @import("./system.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, system.system_run())))
    _ = std.io.print("\n")
    return 0
}
