// The Mlx side of the program test: main.cpp and shapes.cpp translated as
// one program (main.mlx, shapes.mlx), `run` called and the result
// printed, as program_ref.cpp prints the C++'s.
const std = @import("std")
const main_unit = @import("./main.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, main_unit.program_run())))
    _ = std.io.print("\n")
    return 0
}
