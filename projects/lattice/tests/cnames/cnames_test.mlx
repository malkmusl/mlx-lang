// The Mlx side of the cnames test: cnames.cpp translated
// (cnames.mlx), its `run` called and the result printed, as
// cnames_ref.cpp prints the C++'s.
const std = @import("std")
const cnames = @import("./cnames.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, cnames.cnames_run())))
    _ = std.io.print("\n")
    return 0
}
