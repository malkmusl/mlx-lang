// The Mlx side of the twins test: first.cpp and second.cpp translated
// as one program (first.mlx, second.mlx), `run` called and the result
// printed, as twins_ref.cpp prints the C++'s.
const std = @import("std")
const first = @import("./first.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, first.twins_run())))
    _ = std.io.print("\n")
    return 0
}
