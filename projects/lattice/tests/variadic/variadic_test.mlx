// The Mlx side of the variadic test: variadic.cpp translated
// (variadic.mlx), its `run` called and the result printed, as
// variadic_ref.cpp prints the C++'s.
const std = @import("std")
const variadic = @import("./variadic.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, variadic.variadic_run())))
    _ = std.io.print("\n")
    return 0
}
