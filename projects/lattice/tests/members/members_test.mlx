// The Mlx side of the members test: members.cpp translated
// (members.mlx), its `run` called and the result printed, as
// members_ref.cpp prints the C++'s.
const std = @import("std")
const members = @import("./members.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, members.members_run())))
    _ = std.io.print("\n")
    return 0
}
