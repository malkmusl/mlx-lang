// The Mlx side of the hides test: hides.cpp translated
// (hides.mlx), its `run` called and the result printed, as
// hides_ref.cpp prints the C++'s.
const std = @import("std")
const hides = @import("./hides.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, hides.hides_run())))
    _ = std.io.print("\n")
    return 0
}
