// The Mlx side of the statics test: statics.cpp translated
// (statics.mlx), its `run` called and the result printed, as
// statics_ref.cpp prints the C++'s.
const std = @import("std")
const statics = @import("./statics.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    // (The unit's global objects made, as C++ makes them before main.)
    statics.lattice_start()
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, statics.statics_run())))
    _ = std.io.print("\n")
    return 0
}
