// The Mlx side of the jumps test: jumps.cpp translated
// (jumps.mlx), its `run` called and the result printed, as
// jumps_ref.cpp prints the C++'s.
const std = @import("std")
const jumps = @import("./jumps.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, jumps.jumps_run())))
    _ = std.io.print("\n")
    return 0
}
