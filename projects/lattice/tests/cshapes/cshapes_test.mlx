// The Mlx side of the cshapes test: cshapes.c translated
// (cshapes.mlx), its `run` called and the result printed, as
// cshapes_ref.c prints the C program's.
const std = @import("std")
const cshapes = @import("./cshapes.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(u64, @bitCast(u32, cshapes.cshapes_run())))
    _ = std.io.print("\n")
    return 0
}
