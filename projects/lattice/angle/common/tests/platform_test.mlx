// The Mlx side of the platform_helpers differential test: the platform
// predicates (every Windows version question, the word size), one line.
const std = @import("std")
const ph = @import("../platform_helpers.mlx")

fn flag(value: bool) -> void {
    _ = std.io.writeUnsigned(std.io.stdout(), if value { 1 } else { 0 })
    _ = std.io.print(" ")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    flag(ph.IsWindowsXP())
    flag(ph.IsWindowsVista())
    flag(ph.IsWindows7())
    flag(ph.IsWindows8())
    flag(ph.IsWindows10())
    flag(ph.IsWindows11())
    flag(ph.IsWindowsXPOrLater())
    flag(ph.IsWindowsVistaOrLater())
    flag(ph.IsWindows7OrLater())
    flag(ph.IsWindows8OrLater())
    flag(ph.IsWindows10OrLater())
    flag(ph.IsWindows11OrLater())
    flag(ph.Is64Bit())
    _ = std.io.print("\n")
    return 0
}
