// The Mlx side of the platform_helpers differential test: the platform
// predicates (every Windows version question, the word size), one line.
const std = @import("std")
const ph = @import("../platform_helpers.mlx")

fn flag(value: bool) -> void {
    _ = std.io.writeUnsigned(std.io.stdout(), if value { 1 } else { 0 })
    _ = std.io.print(" ")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    flag(ph.angle_IsWindowsXP())
    flag(ph.angle_IsWindowsVista())
    flag(ph.angle_IsWindows7())
    flag(ph.angle_IsWindows8())
    flag(ph.angle_IsWindows10())
    flag(ph.angle_IsWindows11())
    flag(ph.angle_IsWindowsXPOrLater())
    flag(ph.angle_IsWindowsVistaOrLater())
    flag(ph.angle_IsWindows7OrLater())
    flag(ph.angle_IsWindows8OrLater())
    flag(ph.angle_IsWindows10OrLater())
    flag(ph.angle_IsWindows11OrLater())
    flag(ph.angle_Is64Bit())
    _ = std.io.print("\n")
    return 0
}
