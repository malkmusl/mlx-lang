// The Mlx side of the utilities differential test: for every GL enum
// value of the type range, the pure functions of utilities.cpp on it, one
// line per value (utilities_ref.cpp prints the same from the C++).
const std = @import("std")
const u = @import("../utilities.mlx")

fn number(value: u64) -> void {
    _ = std.io.writeUnsigned(std.io.stdout(), value)
    _ = std.io.print(" ")
}

fn signed(value: i32) -> void { number(@intCast(u64, @bitCast(u32, value))) }
fn flag(value: bool) -> void { number(if value { 1 } else { 0 }) }

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    var v: u32 = 0x1400
    while v < 0x9400 {
        number(@intCast(u64, v))
        signed(u.VariableComponentCount(v))
        number(@intCast(u64, u.VariableComponentType(v)))
        number(u.VariableComponentSize(v))
        number(u.VariableInternalSize(v))
        number(u.VariableExternalSize(v))
        signed(u.VariableRowCount(v))
        signed(u.VariableColumnCount(v))
        flag(u.IsSamplerType(v))
        flag(u.IsSamplerCubeType(v))
        flag(u.IsSamplerYUVType(v))
        flag(u.IsImageType(v))
        flag(u.IsImage2DType(v))
        flag(u.IsAtomicCounterType(v))
        flag(u.IsOpaqueType(v))
        flag(u.IsMatrixType(v))
        flag(u.IsFloatScalarAndVectorType(v))
        flag(u.IsFloatVectorType(v))
        number(@intCast(u64, u.TransposeMatrixType(v)))
        signed(u.VariableRegisterCount(v))
        signed(u.VariableSortOrder(v))
        number(@intCast(u64, u.VariableBoolVectorType(v)))
        flag(u.IsIntegerFormat(v))
        number(@intCast(u64, u.ElementTypeSize(v)))
        flag(u.IsMipmapFiltered(v))
        flag(u.IsCubeMapTextureTarget(v))
        flag(u.IsTextureTarget(v))
        flag(u.IsRenderbufferTarget(v))
        flag(u.IsExternalImageTarget(v))
        if u.IsMatrixType(v) {
            signed(u.MatrixRegisterCount(v, true))
            signed(u.MatrixComponentCount(v, false))
        }
        _ = std.io.print("\n")
        v += 1
    }
    var mode: u32 = 0
    while mode < 16 {
        flag(u.IsTriangleMode(@intCast(u8, mode)))
        flag(u.IsPolygonMode(@intCast(u8, mode)))
        mode += 1
    }
    _ = std.io.print("\n")
    var index: u32 = 0
    while index < 3 {
        number(@intCast(u64, u.GetPrimitiveRestartIndex(@intCast(u64, index))))
        index += 1
    }
    _ = std.io.print("\n")
    return 0
}
