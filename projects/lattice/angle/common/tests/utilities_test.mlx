// The Mlx side of the utilities differential test: for every GL enum
// value of the type range, the pure functions of utilities.cpp on it, one
// line per value (utilities_ref.cpp prints the same from the C++).
const std = @import("std")
const u = @import("../utilities.mlx")

fn number(value: u64) -> void {
    _ = std.io.writeUnsigned(std.io.stdout(), value)
    _ = std.io.print(" ")
}

fn signed(value: i32) -> void { number(@intCast(u64, @bitCast(u32, value))) }
fn flag(value: bool) -> void { number(if value { 1 } else { 0 }) }

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    var v: u32 = 0x1400
    while v < 0x9400 {
        number(@intCast(u64, v))
        signed(u.gl_VariableComponentCount(v))
        number(@intCast(u64, u.gl_VariableComponentType(v)))
        number(u.gl_VariableComponentSize(v))
        number(u.gl_VariableInternalSize(v))
        number(u.gl_VariableExternalSize(v))
        signed(u.gl_VariableRowCount(v))
        signed(u.gl_VariableColumnCount(v))
        flag(u.gl_IsSamplerType(v))
        flag(u.gl_IsSamplerCubeType(v))
        flag(u.gl_IsSamplerYUVType(v))
        flag(u.gl_IsImageType(v))
        flag(u.gl_IsImage2DType(v))
        flag(u.gl_IsAtomicCounterType(v))
        flag(u.gl_IsOpaqueType(v))
        flag(u.gl_IsMatrixType(v))
        flag(u.gl_IsFloatScalarAndVectorType(v))
        flag(u.gl_IsFloatVectorType(v))
        number(@intCast(u64, u.gl_TransposeMatrixType(v)))
        signed(u.gl_VariableRegisterCount(v))
        signed(u.gl_VariableSortOrder(v))
        number(@intCast(u64, u.gl_VariableBoolVectorType(v)))
        flag(u.gl_IsIntegerFormat(v))
        number(@intCast(u64, u.gl_ElementTypeSize(v)))
        flag(u.gl_IsMipmapFiltered(v))
        flag(u.egl_IsCubeMapTextureTarget(v))
        flag(u.egl_IsTextureTarget(v))
        flag(u.egl_IsRenderbufferTarget(v))
        flag(u.egl_IsExternalImageTarget(v))
        if u.gl_IsMatrixType(v) {
            signed(u.gl_MatrixRegisterCount(v, true))
            signed(u.gl_MatrixComponentCount(v, false))
        }
        _ = std.io.print("\n")
        v += 1
    }
    var mode: u32 = 0
    while mode < 16 {
        flag(u.gl_IsTriangleMode(@intCast(u8, mode)))
        flag(u.gl_IsPolygonMode(@intCast(u8, mode)))
        mode += 1
    }
    _ = std.io.print("\n")
    var index: u32 = 0
    while index < 3 {
        number(@intCast(u64, u.gl_GetPrimitiveRestartIndex(@intCast(u64, index))))
        index += 1
    }
    _ = std.io.print("\n")
    return 0
}
