// The Mlx side of the Float16ToFloat32 differential test: every 16-bit
// pattern converted, the float's bits one per line (float16_ref.cpp
// prints the same from the C++).
const std = @import("std")
const f16 = @import("../Float16ToFloat32.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    const o = std.io.stdout()
    var h: u32 = 0
    while h < 65536 {
        const value = f16.float16ToFloat32(@intCast(u16, h))
        _ = std.io.writeUnsigned(o, @intCast(u64, @bitCast(u32, value)))
        _ = std.io.print("\n")
        h += 1
    }
    return 0
}
