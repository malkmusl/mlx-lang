// ANGLE's aligned_memory_unittest.cpp as Mlx, on the translated module.
const std = @import("std")
const am = @import("../aligned_memory.mlx")

fn check(alignment: u64) -> bool {
    const p = am.AlignedAlloc(8, alignment)
    if p == null { return false }
    const aligned = (@intFromPtr(p.?) & (alignment - 1)) == 0
    am.AlignedFree(p)
    return aligned
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    const alignments = [4]u64{ 8, 16, 256, 4096 }
    for alignment in alignments {
        if !check(alignment) {
            _ = std.io.print("FAIL\n")
            return 1
        }
    }
    _ = std.io.print("aligned_memory: 4 allocations aligned and freed\n")
    return 0
}
