// The Mlx side of the MemoryBuffer differential test (after ANGLE's
// MemoryBuffer_unittest.cpp): resizes, a reserve then a resize, clear,
// destroy, clearAndReserve and fill, the size and emptiness after each
// step and the bytes at the ends after a fill, one step a line
// (memorybuffer_ref.cpp prints the same).
const std = @import("std")
const mb = @import("../MemoryBuffer.mlx")

fn number(value: u64) -> void {
    _ = std.io.writeUnsigned(std.io.stdout(), value)
    _ = std.io.print(" ")
}

fn state(b: *const mb.MemoryBuffer) -> void {
    number(mb.MemoryBuffer_size(b))
    number(if mb.MemoryBuffer_empty(b) { 1 } else { 0 })
    _ = std.io.print("\n")
}

fn fresh(b: *mb.MemoryBuffer) -> void {
    b.*.mData = null
    b.*.mSize = 0
    b.*.mCapacity = 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    var b: mb.MemoryBuffer = undefined
    fresh(&b)
    state(&b)
    const sizes = [5]u64{ 128, 1024, 32, 0, 4096 }
    for size in sizes {
        number(if mb.MemoryBuffer_resize(&b, size) { 1 } else { 0 })
        state(&b)
    }
    mb.MemoryBuffer_destroy(&b)
    state(&b)
    number(if mb.MemoryBuffer_reserve(&b, 256) { 1 } else { 0 })
    state(&b)
    number(if mb.MemoryBuffer_resize(&b, 200) { 1 } else { 0 })
    state(&b)
    mb.MemoryBuffer_fill(&b, 0xAB)
    number(@intCast(u64, b.mData.?[0]))
    number(@intCast(u64, b.mData.?[199]))
    _ = std.io.print("\n")
    mb.MemoryBuffer_clear(&b)
    state(&b)
    number(if mb.MemoryBuffer_clearAndReserve(&b, 1000) { 1 } else { 0 })
    state(&b)
    mb.MemoryBuffer_setSizeToCapacity(&b)
    state(&b)
    mb.MemoryBuffer_setSize(&b, 10)
    state(&b)
    mb.MemoryBuffer_destroy(&b)
    state(&b)
    return 0
}
