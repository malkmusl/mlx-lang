// The Mlx side of the mathutil differential test: the same inputs as
// mathutil_ref.cpp, the same lines.
const std = @import("std")
const mu = @import("../mathutil.mlx")

fn line(value: u32, r: f32, g: f32, b: f32) -> void {
    const o = std.io.stdout()
    _ = std.io.writeUnsigned(o, @intCast(u64, value))
    _ = std.io.print(" ")
    _ = std.io.writeUnsigned(o, @intCast(u64, @bitCast(u32, r)))
    _ = std.io.print(" ")
    _ = std.io.writeUnsigned(o, @intCast(u64, @bitCast(u32, g)))
    _ = std.io.print(" ")
    _ = std.io.writeUnsigned(o, @intCast(u64, @bitCast(u32, b)))
    _ = std.io.print("\n")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    const inputs = [6][3]f32{ [3]f32{ 0.0, 0.0, 0.0 }, [3]f32{ 1.0, 0.5, 0.25 }, [3]f32{ 0.001, 0.002, 0.003 }, [3]f32{ 65408.0, 1.0, 2.0 }, [3]f32{ 100.0, 200.0, 300.0 }, [3]f32{ 0.75, 0.0, 12.5 } }
    for rgb in inputs {
        const value = mu.gl_convertRGBFloatsTo999E5(rgb[0], rgb[1], rgb[2])
        var r: [1]f32 = [1]f32{ 0.0 }
        var g: [1]f32 = [1]f32{ 0.0 }
        var b: [1]f32 = [1]f32{ 0.0 }
        mu.gl_convert999E5toRGBFloats(value, &r, &g, &b)
        line(value, r[0], g[0], b[0])
    }
    return 0
}
