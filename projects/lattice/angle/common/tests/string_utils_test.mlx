// The Mlx side of the string_utils differential test: the string
// functions of string_utils.cpp on a fixed set of inputs, through the
// std module (mlxlibcpp's string translated), one line per call
// (string_utils_ref.cpp prints the same from the C++).
const std = @import("std")
const crash = @import("std.crash")
const s = @import("../string_utils.mlx")
const libcpp = @import("../../../runtime/libcpp.mlx")

const String = libcpp.string
const View = libcpp.basic_string_view_c_N3std14char_traits_c_E_

fn text(value: *String) -> void {
    const bytes = libcpp.string_c_str(value).?
    var n = libcpp.string_size(value)
    _ = std.io.print("[")
    _ = std.io.write(std.io.stdout(), bytes[0..n])
    _ = std.io.print("]")
}

fn view(value: *View) -> void {
    _ = std.io.print("[")
    _ = std.io.write(std.io.stdout(), value.*._data.?[0..value.*._size])
    _ = std.io.print("]")
}

fn number(value: u64) -> void {
    _ = std.io.writeUnsigned(std.io.stdout(), value)
    _ = std.io.print(" ")
}

fn flag(value: bool) -> void { number(if value { 1 } else { 0 }) }
fn line() -> void { _ = std.io.print("\n") }

fn make(literal: []const u8) -> String {
    var value: String = undefined
    libcpp.string_init_____const_u8(&value, literal.pointer)
    return value
}

fn makeView(literal: []const u8) -> View {
    var value: View = undefined
    libcpp.basic_string_view_c_N3std14char_traits_c_E__init_____const_u8(&value, literal.pointer)
    return value
}

fn splits(input: []const u8, delimiters: []const u8) -> void {
    var given = make(input)
    var delims = makeView(delimiters)
    var whitespace: i32 = 0
    while whitespace < 2 {
        var want: i32 = 0
        while want < 2 {
            var parts = s.angle_SplitString(&given, &delims, whitespace, want)
            number(parts.count)
            var k: u64 = 0
            while k < parts.count {
                text(s.vector_N3std6stringE_N3std24allocator_N3std6stringE_E__at_u64(&parts, k))
                k += 1
            }
            line()
            s.vector_N3std6stringE_N3std24allocator_N3std6stringE_E__deinit(&parts)
            var inView = makeView(input)
            var views = s.angle_SplitStringView(&inView, &delims, whitespace, want)
            number(views.count)
            k = 0
            while k < views.count {
                view(s.vector_N3std43basic_string_view_c_N3std14char_traits_c_E_E_N3std62allocator_N3std43basic_string_view_c_N3std14char_traits_c_E_E_E__at_u64(&views, k))
                k += 1
            }
            line()
            s.vector_N3std43basic_string_view_c_N3std14char_traits_c_E_E_N3std62allocator_N3std43basic_string_view_c_N3std14char_traits_c_E_E_E__deinit(&views)
            want += 1
        }
        whitespace += 1
    }
    libcpp.string_deinit(&given)
}

fn trims(input: []const u8, chars: []const u8) -> void {
    var given = make(input)
    var trimChars = make(chars)
    var trimmed = s.angle_TrimString(&given, &trimChars)
    text(&trimmed)
    var inView = makeView(input)
    var trimmedView = s.angle_TrimStringView(&inView, &trimChars)
    view(&trimmedView)
    line()
    libcpp.string_deinit(&trimmed)
    libcpp.string_deinit(&trimChars)
    libcpp.string_deinit(&given)
}

fn prefixes(input: []const u8, offset: u64, delimiter: []const u8, byte: u8) -> void {
    var given = make(input)
    var a = s.angle_GetPrefix__const_string_u64_____const_u8(&given, offset, delimiter.pointer)
    var b = s.angle_GetPrefix__const_string_u64_u8(&given, offset, byte)
    text(&a)
    text(&b)
    line()
    libcpp.string_deinit(&a)
    libcpp.string_deinit(&b)
    libcpp.string_deinit(&given)
}

fn edges(str: []const u8, other: []const u8, length: u64) -> void {
    var a = make(str)
    var b = make(other)
    flag(s.angle_BeginsWith__const_string__const_string(&a, &b))
    flag(s.angle_BeginsWith__const_string_____const_u8(&a, other.pointer))
    flag(s.angle_BeginsWith_____const_u8_____const_u8(str.pointer, other.pointer))
    flag(s.angle_BeginsWith__const_string__const_string_u64(&a, &b, length))
    flag(s.angle_EndsWith__const_string__const_string(&a, &b))
    flag(s.angle_EndsWith__const_string_____const_u8(&a, other.pointer))
    flag(s.angle_EndsWith_____const_u8_____const_u8(str.pointer, other.pointer))
    line()
    libcpp.string_deinit(&a)
    libcpp.string_deinit(&b)
}

fn tokens(list: []const u8, delimiter: u8, token: []const u8) -> void {
    var a = make(list)
    var b = make(token)
    flag(s.angle_ContainsToken(&a, delimiter, &b))
    line()
    libcpp.string_deinit(&a)
    libcpp.string_deinit(&b)
}

fn cases(input: []const u8) -> void {
    var lower = make(input)
    var upper = make(input)
    var camel = make(input)
    s.angle_ToLower(&lower)
    s.angle_ToUpper(&upper)
    var camelCased = s.angle_ToCamelCase(&camel)
    text(&lower)
    text(&upper)
    text(&camelCased)
    line()
    libcpp.string_deinit(&camelCased)
    libcpp.string_deinit(&camel)
    libcpp.string_deinit(&upper)
    libcpp.string_deinit(&lower)
}

fn replacements(input: []const u8, from: []const u8, to: []const u8) -> void {
    var once = make(input)
    var all = make(input)
    var sub = make(from)
    var repl = make(to)
    flag(s.angle_ReplaceSubstring(&once, &sub, &repl))
    text(&once)
    number(@intCast(u64, @bitCast(u32, s.angle_ReplaceAllSubstrings(&all, &sub, &repl))))
    text(&all)
    line()
    libcpp.string_deinit(&repl)
    libcpp.string_deinit(&sub)
    libcpp.string_deinit(&all)
    libcpp.string_deinit(&once)
}

fn wildcards(glob: []const u8, name: []const u8) -> void {
    var g = makeView(glob)
    var n = makeView(name)
    flag(s.angle_NamesMatchWithWildcard(&g, &n))
    line()
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    _ = crash.install()
    splits("a,b,,c", ",")
    splits("  alpha beta\tgamma  ", " \t")
    splits("one;two; three ;;", "; ")
    splits("", ",")
    splits(",,,", ",")
    splits("no delimiters here", ",")
    trims("  padded  ", " ")
    trims("xxhelloxx", "x")
    trims("    ", " ")
    trims("", " ")
    trims("\t\n mixed \r\n", " \t\r\n")
    prefixes("GL_ARB_texture_float", 0, "_", 95)
    prefixes("GL_ARB_texture_float", 3, "_", 95)
    prefixes("GL_ARB_texture_float", 7, "zz", 122)
    prefixes("key=value;rest", 4, ";", 59)
    edges("prefix_body_suffix", "prefix", 3)
    edges("prefix_body_suffix", "suffix", 6)
    edges("short", "much longer than the string", 2)
    edges("same", "same", 4)
    edges("", "", 0)
    edges("abc", "", 0)
    tokens("GL_EXT_a GL_EXT_b GL_EXT_c", 32, "GL_EXT_b")
    tokens("GL_EXT_a GL_EXT_b GL_EXT_c", 32, "GL_EXT_bc")
    tokens("GL_EXT_a GL_EXT_b GL_EXT_c", 32, "GL_EXT_c")
    tokens("a,b,c", 44, "")
    tokens("a,b,c", 44, "a")
    tokens("abc", 44, "abc")
    cases("Mixed_Case_name_WITH_123")
    cases("already_camel")
    cases("__leading_and_trailing__")
    cases("")
    replacements("the cat sat on the mat", "the", "a")
    replacements("aaaa", "aa", "b")
    replacements("nothing to do", "xyz", "q")
    replacements("abab", "ab", "")
    wildcards("GL_*", "GL_ARB_texture")
    wildcards("GL_*", "EGL_KHR_image")
    wildcards("*", "")
    wildcards("GL_?_ext", "GL_A_ext")
    wildcards("exact", "exact")
    wildcards("exact", "exactly")
    wildcards("a*b*c", "axxbyyc")
    wildcards("a*b*c", "axxbyy")
    return 0
}
