// mlx-net: mlx-netd from the command line, over the system bus.
//
//   mlx-net [--bus PATH]                the links: name, kind, state,
//                                       address, gateway, Wi-Fi network,
//                                       name servers
//   mlx-net [--bus PATH] up NAME        switches a link on
//   mlx-net [--bus PATH] down NAME      switches it off
//   mlx-net [--bus PATH] reload         mlx-netd reads its configuration
//                                       again
//   mlx-net [--bus PATH] wifi           the Wi-Fi networks in sight
//   mlx-net [--bus PATH] scan           the cards scan now
//   mlx-net [--bus PATH] connect SSID [PASSPHRASE | -]
//                                       joins a network ("-": the
//                                       passphrase is the first line of
//                                       stdin, out of sight of ps)
//   mlx-net [--bus PATH] disconnect     leaves the Wi-Fi network
//   mlx-net [--bus PATH] forget SSID    forgets a saved network
//
// It says what failed (and fails) when mlx-netd is not there or refuses.
const std = @import("std")
const dbus = @import("std.dbus")
const system = @import("./system.mlx")

const NAME: []const u8 = "org.mlx.Network"
const PATH: []const u8 = "/org/mlx/Network"
const SIZE: usize = 16384

const Failure = error { Usage, NoMemory, NoBus, Refused }

fn fail(failure: Failure) -> Failure!void { return failure }

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn print(text: []const u8) -> void { const written = std.io.writeAll(std.io.stdout(), text) }

fn socketPath(environment: [*][*]const u8, given: []const u8) -> []const u8 {
    if given.length > 0 { return given }
    var index: usize = 0
    while @intFromPtr(environment[index]) != 0 {
        const text = cString(environment[index])
        if system.startsWith(text, "DBUS_SYSTEM_BUS_ADDRESS=unix:path=") {
            const rest = text[34..text.length]
            var stop: usize = 0
            while stop < rest.length && rest[stop] != 44 { stop += 1 }
            return rest[0..stop]
        }
        index += 1
    }
    return "/run/mlx/bus"
}

// Pads `text` to `width` columns (bytes; the names are ASCII).
fn column(text: []const u8, width: usize) -> void {
    print(text)
    var length = text.length
    while length < width {
        print(" ")
        length += 1
    }
}

fn number(value: u32) -> void {
    var text: [12]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = system.putNumber(bytes, 0, @intCast(u64, value))
    print(bytes[0..length])
}

// a(suussbb): SSID, signal, frequency, security, problem, saved,
// connected.
fn printNetworks(reading: *dbus.Reader) -> void {
    const length = dbus.readU32(reading)
    dbus.alignTo(reading, 8)
    const end = reading.*.position + @intCast(usize, length)
    while reading.*.position < end && !reading.*.failed {
        dbus.alignTo(reading, 8)
        const ssid = dbus.readString(reading)
        const signal = dbus.readU32(reading)
        const frequency = dbus.readU32(reading)
        const security = dbus.readString(reading)
        const problem = dbus.readString(reading)
        const saved = dbus.readBool(reading)
        const joined = dbus.readBool(reading)
        print(if joined { "* " } else { "  " })
        column(ssid, 33)
        number(signal)
        print("%  ")
        number(frequency)
        print(" MHz  ")
        column(security, 11)
        if saved { print("saved ") }
        if problem.length > 0 {
            print("(")
            print(problem)
            print(")")
        }
        print("\n")
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    var bus_path: []const u8 = ""
    var command: []const u8 = "status"
    var link: []const u8 = ""
    var extra: []const u8 = ""
    var index: usize = 1
    var positional: usize = 0
    while index < arguments.length {
        const argument = cString(arguments[index])
        if system.same(argument, "--bus") && index + 1 < arguments.length {
            index += 1
            bus_path = cString(arguments[index])
        } else if positional == 0 {
            command = argument
            positional = 1
        } else if positional == 1 {
            link = argument
            positional = 2
        } else if positional == 2 {
            extra = argument
            positional = 3
        }
        index += 1
    }
    const bare = system.same(command, "status") || system.same(command, "reload") || system.same(command, "wifi") || system.same(command, "scan") || system.same(command, "disconnect")
    const named = (system.same(command, "up") || system.same(command, "down") || system.same(command, "connect") || system.same(command, "forget")) && link.length > 0
    if !bare && !named {
        const said = std.io.writeAll(std.io.stderr(), "usage: mlx-net [--bus PATH] [status | up NAME | down NAME | reload | wifi | scan | connect SSID [PASSPHRASE | -] | disconnect | forget SSID]\n")
        return fail(Failure.Usage)
    }
    // "-": the passphrase from stdin's first line.
    var typed: [128]u8 = undefined
    var typed_bytes: [*]u8 = undefined
    unsafe { typed_bytes = @ptrCast([*]u8, &typed) }
    if system.same(extra, "-") {
        var length: usize = 0
        while length < 127 {
            const got = std.linux.syscall3(0, 0, @intFromPtr(typed_bytes) + length, 1)
            if got <= 0 || typed[length] == 10 { break }
            length += 1
        }
        extra = typed_bytes[0..length]
    }
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    const out = allocator.alloc(SIZE, 16)
    if memory == null || out == null { return fail(Failure.NoMemory) }
    var client: *dbus.Client = undefined
    unsafe { client = @ptrCast(*dbus.Client, memory.?) }
    if !dbus.connectClient(client, allocator, socketPath(environment, bus_path)) {
        const said = std.io.writeAll(std.io.stderr(), "mlx-net: no system bus\n")
        return fail(Failure.NoBus)
    }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, out.?, SIZE, false)
    var serial: u32 = 0
    if system.same(command, "status") {
        serial = dbus.call(client, NAME, PATH, NAME, "Devices", "", out.?, 0)
    } else if system.same(command, "reload") {
        serial = dbus.call(client, NAME, PATH, NAME, "Reload", "", out.?, 0)
    } else if system.same(command, "wifi") {
        serial = dbus.call(client, NAME, PATH, NAME, "Networks", "", out.?, 0)
    } else if system.same(command, "scan") {
        serial = dbus.call(client, NAME, PATH, NAME, "Scan", "", out.?, 0)
    } else if system.same(command, "disconnect") {
        serial = dbus.call(client, NAME, PATH, NAME, "Disconnect", "", out.?, 0)
    } else if system.same(command, "connect") {
        dbus.putString(&writing, link)
        dbus.putString(&writing, extra)
        serial = dbus.call(client, NAME, PATH, NAME, "Connect", "ss", out.?, writing.length)
        var wipe_at: usize = 0
        while wipe_at < 128 {
            typed[wipe_at] = 0
            wipe_at += 1
        }
    } else if system.same(command, "forget") {
        dbus.putString(&writing, link)
        serial = dbus.call(client, NAME, PATH, NAME, "Forget", "s", out.?, writing.length)
    } else {
        dbus.putString(&writing, link)
        serial = dbus.call(client, NAME, PATH, NAME, if system.same(command, "up") { "Up" } else { "Down" }, "s", out.?, writing.length)
    }
    var reply: dbus.Header = undefined
    if serial == 0 || !dbus.waitReply(client, serial, &reply, 10000) {
        const said = std.io.writeAll(std.io.stderr(), "mlx-net: mlx-netd did not answer\n")
        return fail(Failure.NoBus)
    }
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    if reply.kind == dbus.ERROR {
        const said = std.io.writeAll(std.io.stderr(), "mlx-net: ")
        const message = dbus.readString(&reading)
        const said_message = std.io.writeAll(std.io.stderr(), if reading.failed { reply.errorName } else { message })
        const said_end = std.io.writeAll(std.io.stderr(), "\n")
        return fail(Failure.Refused)
    }
    if system.same(command, "wifi") {
        printNetworks(&reading)
        return
    }
    if !system.same(command, "status") { return }
    // a(ssssssas): name, kind, state, address, gateway, Wi-Fi network,
    // name servers.
    const length = dbus.readU32(&reading)
    dbus.alignTo(&reading, 8)
    const end = reading.position + @intCast(usize, length)
    while reading.position < end && !reading.failed {
        dbus.alignTo(&reading, 8)
        column(dbus.readString(&reading), 10)
        column(dbus.readString(&reading), 10)
        column(dbus.readString(&reading), 12)
        const address = dbus.readString(&reading)
        const gateway = dbus.readString(&reading)
        column(if address.length > 0 { address } else { "-" }, 20)
        if gateway.length > 0 {
            print("via ")
            column(gateway, 16)
        }
        const network = dbus.readString(&reading)
        if network.length > 0 {
            print("on ")
            print(network)
            print(" ")
        }
        const servers = dbus.readU32(&reading)
        const servers_end = reading.position + @intCast(usize, servers)
        var first = true
        while reading.position < servers_end && !reading.failed {
            print(if first { "dns " } else { " " })
            print(dbus.readString(&reading))
            first = false
        }
        print("\n")
    }
}
