// Wi-Fi cards through nl80211 (generic netlink, std.netlink): scans and
// their results, connecting with the card doing the association (the
// CONNECT command, as wpa_supplicant's nl80211 driver uses it with
// SME-capable cards), the keys of the handshake (NEW_KEY), the port
// opened (SET_STATION authorized) and the events of the "scan" and "mlme"
// groups (scan done, connected, disconnected).
//
// Without cfg80211 in the kernel there is no nl80211 family: open() says
// so and mlx-netd goes on with the cables alone.
const netlink = @import("std.netlink")

// Commands.
const CMD_GET_INTERFACE: u8 = 5
const CMD_NEW_KEY: u8 = 11
const CMD_SET_STATION: u8 = 18
const CMD_GET_SCAN: u8 = 32
const CMD_TRIGGER_SCAN: u8 = 33
pub const CMD_NEW_SCAN_RESULTS: u8 = 34
pub const CMD_SCAN_ABORTED: u8 = 35
pub const CMD_CONNECT: u8 = 46
pub const CMD_DISCONNECT: u8 = 48

// Attributes.
const ATTR_IFINDEX: u16 = 3
const ATTR_IFTYPE: u16 = 5
const ATTR_MAC: u16 = 6
const ATTR_KEY_DATA: u16 = 7
const ATTR_KEY_IDX: u16 = 8
const ATTR_KEY_CIPHER: u16 = 9
const ATTR_KEY_SEQ: u16 = 10
const ATTR_WIPHY_FREQ: u16 = 38
const ATTR_IE: u16 = 42
const ATTR_SCAN_SSIDS: u16 = 45
const ATTR_BSS: u16 = 47
const ATTR_SSID: u16 = 52
const ATTR_AUTH_TYPE: u16 = 53
const ATTR_REASON_CODE: u16 = 54
const ATTR_KEY_TYPE: u16 = 55
const ATTR_TIMED_OUT: u16 = 65
const ATTR_STA_FLAGS2: u16 = 67
const ATTR_CONTROL_PORT: u16 = 68
const ATTR_PRIVACY: u16 = 70
const ATTR_DISCONNECTED_BY_AP: u16 = 71
const ATTR_STATUS_CODE: u16 = 72
const ATTR_CIPHER_SUITES_PAIRWISE: u16 = 73
const ATTR_CIPHER_SUITE_GROUP: u16 = 74
const ATTR_WPA_VERSIONS: u16 = 75
const ATTR_AKM_SUITES: u16 = 76

// What a BSS holds.
const BSS_BSSID: u16 = 1
const BSS_FREQUENCY: u16 = 2
const BSS_CAPABILITY: u16 = 5
const BSS_INFORMATION_ELEMENTS: u16 = 6
const BSS_SIGNAL_MBM: u16 = 7
const BSS_STATUS: u16 = 9
const BSS_BEACON_IES: u16 = 11
const BSS_STATUS_ASSOCIATED: u32 = 1

const IFTYPE_STATION: u32 = 2
const KEYTYPE_GROUP: u32 = 0
const KEYTYPE_PAIRWISE: u32 = 1
const STA_FLAG_AUTHORIZED: u32 = 1
const WPA_VERSION_2: u32 = 2
const CAPABILITY_PRIVACY: u16 = 16

// Cipher and AKM suite selectors (00-0F-AC:n) as nl80211 takes them.
pub const CIPHER_TKIP: u32 = 1027074
pub const CIPHER_CCMP: u32 = 1027076
const AKM_PSK: u32 = 1027074

// What a network asks of us.
pub const SECURITY_OPEN: u32 = 0
// WPA2-Personal (or WPA2/WPA3 transition): what wpa.mlx speaks.
pub const SECURITY_PSK: u32 = 1
// WPA3-Personal alone (SAE), or management frame protection required.
pub const SECURITY_SAE: u32 = 2
pub const SECURITY_ENTERPRISE: u32 = 3
// WEP or WPA1 only.
pub const SECURITY_OLD: u32 = 4

pub const NETWORKS: usize = 32
pub const ELEMENT_MOST: usize = 64

pub const Network = struct {
    ssid: [32]u8
    ssidLength: usize
    bssid: [6]u8
    frequency: u32
    // dBm.
    signal: i32
    security: u32
    // The group cipher's suite type (4 CCMP, 2 TKIP) for our element.
    groupCipher: u8
    // The RSN element as the beacon carries it (wpa.mlx compares it with
    // message 3's).
    rsn: [64]u8
    rsnLength: usize
    associated: bool
}

pub const Networks = struct {
    items: [32]Network
    count: usize
}

pub const Wifi = struct {
    // Requests and their answers; the events of the "scan" and "mlme"
    // groups.
    commands: netlink.Socket
    events: netlink.Socket
    family: u16
    ready: bool
    scratch: [*]u8
    capacity: usize
}

// What an event said.
pub const EVENT_NONE: u32 = 0
pub const EVENT_SCANNED: u32 = 1
pub const EVENT_SCAN_ABORTED: u32 = 2
pub const EVENT_CONNECTED: u32 = 3
pub const EVENT_CONNECT_FAILED: u32 = 4
pub const EVENT_DISCONNECTED: u32 = 5

pub const Event = struct {
    kind: u32
    index: u32
    // CONNECT: the access point; status (0: success).
    bssid: [6]u8
    status: u32
    // DISCONNECT: the reason (802.11 reason code), whether the access
    // point sent it.
    reason: u32
    byAccessPoint: bool
}

fn commandsOf(wifi: *Wifi) -> *netlink.Socket {
    unsafe { return @ptrCast(*netlink.Socket, &wifi.*.commands) }
}

fn eventsOf(wifi: *Wifi) -> *netlink.Socket {
    unsafe { return @ptrCast(*netlink.Socket, &wifi.*.events) }
}

pub fn at(networks: *Networks, index: usize) -> *Network {
    unsafe { return @ptrFromInt(*Network, @intFromPtr(networks) + @offsetOf(Networks, "items") + index * @sizeOf(Network)) }
}

pub fn ssidOf(network: *Network) -> []const u8 {
    const bytes: [*]const u8 = &network.*.ssid
    return bytes[0..network.*.ssidLength]
}

pub fn rsnOf(network: *Network) -> [*]u8 {
    const bytes: [*]u8 = &network.*.rsn
    return bytes
}

pub fn bssidOf(network: *Network) -> [*]u8 {
    const bytes: [*]u8 = &network.*.bssid
    return bytes
}

// A signal in dBm as 0..100 (-100 dBm and below 0, -50 and above 100).
pub fn quality(signal: i32) -> u32 {
    if signal <= -100 { return 0 }
    if signal >= -50 { return 100 }
    return @intCast(u32, 2 * (signal + 100))
}

// Finds nl80211 and joins its "scan" and "mlme" groups; false when the
// kernel has no nl80211 (no cfg80211).
pub fn open(wifi: *Wifi, scratch: [*]u8, capacity: usize) -> bool {
    wifi.*.ready = false
    wifi.*.scratch = scratch
    wifi.*.capacity = capacity
    wifi.*.events.descriptor = -1
    if !netlink.open(commandsOf(wifi), netlink.GENERIC, 0) { return false }
    var scan_group: u32 = 0
    var mlme_group: u32 = 0
    wifi.*.family = netlink.family(commandsOf(wifi), scratch, capacity, "nl80211", "scan", &scan_group)
    if wifi.*.family == 0 {
        netlink.close(commandsOf(wifi))
        return false
    }
    _ = netlink.family(commandsOf(wifi), scratch, capacity, "nl80211", "mlme", &mlme_group)
    if !netlink.open(eventsOf(wifi), netlink.GENERIC, 0) {
        netlink.close(commandsOf(wifi))
        return false
    }
    if scan_group != 0 { _ = netlink.join(eventsOf(wifi), scan_group) }
    if mlme_group != 0 { _ = netlink.join(eventsOf(wifi), mlme_group) }
    wifi.*.ready = true
    return true
}

pub fn descriptor(wifi: *Wifi) -> isize {
    return if wifi.*.ready { wifi.*.events.descriptor } else { -1 }
}

fn request(wifi: *Wifi, builder: *netlink.Builder, bytes: [*]u8, capacity: usize, command: u8, index: u32, flags: u16) -> void {
    netlink.begin(builder, commandsOf(wifi), bytes, capacity, wifi.*.family, flags)
    netlink.putCommand(builder, command, 0)
    netlink.attributeU32(builder, ATTR_IFINDEX, index)
}

// Whether link `index` is a Wi-Fi card in station mode.
pub fn isStation(wifi: *Wifi, index: u32) -> bool {
    if !wifi.*.ready { return false }
    var bytes: [64]u8 = undefined
    const view: [*]u8 = &bytes
    var builder: netlink.Builder = undefined
    request(wifi, &builder, view, 64, CMD_GET_INTERFACE, index, 0)
    const sequence = builder.sequence
    if !netlink.send(commandsOf(wifi), &builder) { return false }
    var waited = 0
    while waited < 8 {
        const count = netlink.receive(commandsOf(wifi), wifi.*.scratch, wifi.*.capacity, 250)
        if count < 0 { return false }
        if count == 0 {
            waited += 1
            continue
        }
        var offset: usize = 0
        var message: netlink.Message = undefined
        while netlink.nextMessage(wifi.*.scratch, @intCast(usize, count), &offset, &message) {
            if message.sequence != sequence { continue }
            if message.kind == netlink.NLMSG_ERROR { return false }
            var found: netlink.Attribute = undefined
            var at_attribute: usize = netlink.COMMAND_HEADER
            while netlink.nextAttribute(message.payload, message.length, &at_attribute, &found) {
                if found.kind == ATTR_IFTYPE { return netlink.u32Of(&found) == IFTYPE_STATION }
            }
            return false
        }
    }
    return false
}

// Asks the card for a scan of every network (the wildcard SSID); 0, or a
// negative errno (-16: one is running).
pub fn triggerScan(wifi: *Wifi, index: u32) -> i32 {
    var bytes: [64]u8 = undefined
    const view: [*]u8 = &bytes
    var builder: netlink.Builder = undefined
    request(wifi, &builder, view, 64, CMD_TRIGGER_SCAN, index, 0)
    const ssids = netlink.beginNest(&builder, ATTR_SCAN_SSIDS)
    netlink.attribute(&builder, 1, "")
    netlink.endNest(&builder, ssids)
    return netlink.transact(commandsOf(wifi), &builder, wifi.*.scratch, wifi.*.capacity)
}

// The elements of a BSS into `network`: the SSID, the RSN element and
// what it offers.
fn readElements(network: *Network, elements: [*]const u8, length: usize, privacy: bool) -> void {
    var at_element: usize = 0
    var has_rsn = false
    var has_wpa1 = false
    while at_element + 2 <= length {
        const kind = elements[at_element]
        const size = @intCast(usize, elements[at_element + 1])
        if at_element + 2 + size > length { break }
        if kind == 0 && size <= 32 && network.*.ssidLength == 0 {
            var index: usize = 0
            while index < size {
                network.*.ssid[index] = elements[at_element + 2 + index]
                index += 1
            }
            network.*.ssidLength = size
        }
        if kind == 48 && size + 2 <= ELEMENT_MOST && !has_rsn {
            has_rsn = true
            var index: usize = 0
            while index < size + 2 {
                network.*.rsn[index] = elements[at_element + index]
                index += 1
            }
            network.*.rsnLength = size + 2
        }
        if kind == 221 && size >= 4 && elements[at_element + 2] == 0 && elements[at_element + 3] == 80 && elements[at_element + 4] == 242 && elements[at_element + 5] == 1 { has_wpa1 = true }
        at_element += 2 + size
    }
    network.*.security = if has_rsn { securityOf(network) } else if has_wpa1 || privacy { SECURITY_OLD } else { SECURITY_OPEN }
}

// What the RSN element offers: PSK with CCMP, SAE alone, 802.1X or
// nothing we speak.
fn securityOf(network: *Network) -> u32 {
    const rsn = rsnOf(network)
    const length = network.*.rsnLength
    // 48, length, version (2), group (4), pairwise count (2) and suites,
    // AKM count (2) and suites, capabilities (2).
    if length < 8 { return SECURITY_OLD }
    network.*.groupCipher = rsn[7]
    var at_byte: usize = 8
    if at_byte + 2 > length { return SECURITY_OLD }
    const pairwise = @intCast(usize, rsn[at_byte]) | (@intCast(usize, rsn[at_byte + 1]) << 8)
    at_byte += 2
    var ccmp = false
    var index: usize = 0
    while index < pairwise && at_byte + 4 <= length {
        if rsn[at_byte] == 0 && rsn[at_byte + 1] == 15 && rsn[at_byte + 2] == 172 && rsn[at_byte + 3] == 4 { ccmp = true }
        at_byte += 4
        index += 1
    }
    if at_byte + 2 > length { return SECURITY_OLD }
    const akms = @intCast(usize, rsn[at_byte]) | (@intCast(usize, rsn[at_byte + 1]) << 8)
    at_byte += 2
    var psk = false
    var sae = false
    var enterprise = false
    index = 0
    while index < akms && at_byte + 4 <= length {
        if rsn[at_byte] == 0 && rsn[at_byte + 1] == 15 && rsn[at_byte + 2] == 172 {
            const suite = rsn[at_byte + 3]
            if suite == 2 { psk = true }
            if suite == 8 || suite == 24 { sae = true }
            if suite == 1 || suite == 3 || suite == 5 || suite == 11 || suite == 12 { enterprise = true }
        }
        at_byte += 4
        index += 1
    }
    // Capabilities: bit 6 MFP required.
    var pmf_required = false
    if at_byte + 2 <= length { pmf_required = (rsn[at_byte] & 64) != 0 }
    if psk && ccmp && !pmf_required && (network.*.groupCipher == 4 || network.*.groupCipher == 2) { return SECURITY_PSK }
    if sae || (psk && pmf_required) { return SECURITY_SAE }
    if enterprise { return SECURITY_ENTERPRISE }
    return SECURITY_OLD
}

// A signal in mBm (an s32 the attribute holds) as dBm. (Worked out on
// the unsigned value: a division after @bitCast(i32, ...) is still done
// unsigned by the compiler.)
fn dbmOf(raw: u32) -> i32 {
    if raw >= 2147483648 { return -@intCast(i32, (4294967296 - @intCast(u64, raw)) / 100) }
    return @intCast(i32, raw / 100)
}

// One BSS of a scan's results into `networks`: a network seen again keeps
// its strongest access point (the one joined, if one is).
fn takeBss(networks: *Networks, bss: *const netlink.Attribute) -> void {
    var network: Network = undefined
    network.ssidLength = 0
    network.rsnLength = 0
    network.groupCipher = 4
    network.signal = -100
    network.frequency = 0
    network.associated = false
    var privacy = false
    var elements: [*]const u8 = undefined
    var elements_length: usize = 0
    var beacon: [*]const u8 = undefined
    var beacon_length: usize = 0
    var has_bssid = false
    var offset: usize = 0
    var found: netlink.Attribute = undefined
    while netlink.nextAttribute(bss.*.data, bss.*.length, &offset, &found) {
        if found.kind == BSS_BSSID && found.length == 6 {
            var index: usize = 0
            while index < 6 {
                network.bssid[index] = found.data[index]
                index += 1
            }
            has_bssid = true
        }
        if found.kind == BSS_FREQUENCY { network.frequency = netlink.u32Of(&found) }
        if found.kind == BSS_SIGNAL_MBM { network.signal = dbmOf(netlink.u32Of(&found)) }
        if found.kind == BSS_CAPABILITY { privacy = (netlink.u16Of(&found) & CAPABILITY_PRIVACY) != 0 }
        if found.kind == BSS_INFORMATION_ELEMENTS {
            elements = found.data
            elements_length = found.length
        }
        if found.kind == BSS_BEACON_IES {
            beacon = found.data
            beacon_length = found.length
        }
        if found.kind == BSS_STATUS && netlink.u32Of(&found) == BSS_STATUS_ASSOCIATED { network.associated = true }
    }
    if !has_bssid { return }
    if elements_length > 0 { readElements(&network, elements, elements_length, privacy) } else if beacon_length > 0 { readElements(&network, beacon, beacon_length, privacy) } else { return }
    // A hidden network (no SSID) is not listed.
    if network.ssidLength == 0 { return }
    var slot: usize = 0
    while slot < networks.*.count {
        const known = at(networks, slot)
        if sameSsid(known, &network) {
            const better = (network.associated && !known.*.associated) || (network.associated == known.*.associated && network.signal > known.*.signal)
            if better { known.* = network }
            return
        }
        slot += 1
    }
    if networks.*.count >= NETWORKS { return }
    at(networks, networks.*.count).* = network
    networks.*.count += 1
}

fn sameSsid(first: *Network, second: *Network) -> bool {
    if first.*.ssidLength != second.*.ssidLength { return false }
    var index: usize = 0
    while index < first.*.ssidLength {
        if first.*.ssid[index] != second.*.ssid[index] { return false }
        index += 1
    }
    return true
}

// The networks in messages `bytes[0..length]` (a GET_SCAN dump's) into
// `networks`; true once the dump's end (NLMSG_DONE) was among them.
pub fn takeResults(networks: *Networks, bytes: [*]const u8, length: usize, sequence: u32) -> bool {
    var offset: usize = 0
    var message: netlink.Message = undefined
    while netlink.nextMessage(bytes, length, &offset, &message) {
        if message.sequence != sequence { continue }
        if message.kind == netlink.NLMSG_DONE || message.kind == netlink.NLMSG_ERROR { return true }
        var at_attribute: usize = netlink.COMMAND_HEADER
        var found: netlink.Attribute = undefined
        while netlink.nextAttribute(message.payload, message.length, &at_attribute, &found) {
            if found.kind == ATTR_BSS { takeBss(networks, &found) }
        }
    }
    return false
}

// The card's scan results into `networks` (emptied first).
pub fn results(wifi: *Wifi, index: u32, networks: *Networks) -> bool {
    networks.*.count = 0
    var bytes: [64]u8 = undefined
    const view: [*]u8 = &bytes
    var builder: netlink.Builder = undefined
    request(wifi, &builder, view, 64, CMD_GET_SCAN, index, netlink.F_DUMP)
    const sequence = builder.sequence
    if !netlink.send(commandsOf(wifi), &builder) { return false }
    var waited = 0
    while waited < 8 {
        const count = netlink.receive(commandsOf(wifi), wifi.*.scratch, wifi.*.capacity, 250)
        if count < 0 { return false }
        if count == 0 {
            waited += 1
            continue
        }
        if takeResults(networks, wifi.*.scratch, @intCast(usize, count), sequence) { return true }
    }
    return false
}

// Joins `network`: open, or WPA2-PSK with `element` (our RSN element) as
// the association request's; the card answers with a CONNECT event. 0, or
// a negative errno.
pub fn connect(wifi: *Wifi, index: u32, network: *Network, element: [*]const u8, element_length: usize) -> i32 {
    var bytes: [256]u8 = undefined
    const view: [*]u8 = &bytes
    var builder: netlink.Builder = undefined
    request(wifi, &builder, view, 256, CMD_CONNECT, index, 0)
    netlink.attribute(&builder, ATTR_SSID, ssidOf(network))
    netlink.attribute(&builder, ATTR_MAC, bssidOf(network)[0..6])
    if network.*.frequency != 0 { netlink.attributeU32(&builder, ATTR_WIPHY_FREQ, network.*.frequency) }
    netlink.attributeU32(&builder, ATTR_AUTH_TYPE, 0)
    if network.*.security == SECURITY_PSK {
        netlink.attribute(&builder, ATTR_IE, element[0..element_length])
        netlink.attributeFlag(&builder, ATTR_PRIVACY)
        netlink.attributeU32(&builder, ATTR_WPA_VERSIONS, WPA_VERSION_2)
        netlink.attributeU32(&builder, ATTR_CIPHER_SUITES_PAIRWISE, CIPHER_CCMP)
        netlink.attributeU32(&builder, ATTR_CIPHER_SUITE_GROUP, if network.*.groupCipher == 2 { CIPHER_TKIP } else { CIPHER_CCMP })
        netlink.attributeU32(&builder, ATTR_AKM_SUITES, AKM_PSK)
        // The card lets only EAPOL through until the port is authorized.
        netlink.attributeFlag(&builder, ATTR_CONTROL_PORT)
    }
    return netlink.transact(commandsOf(wifi), &builder, wifi.*.scratch, wifi.*.capacity)
}

pub fn disconnect(wifi: *Wifi, index: u32) -> i32 {
    var bytes: [64]u8 = undefined
    const view: [*]u8 = &bytes
    var builder: netlink.Builder = undefined
    request(wifi, &builder, view, 64, CMD_DISCONNECT, index, 0)
    // 3: deauthenticated because the station is leaving.
    netlink.attributeU16(&builder, ATTR_REASON_CODE, 3)
    return netlink.transact(commandsOf(wifi), &builder, wifi.*.scratch, wifi.*.capacity)
}

// Installs a key: the pairwise one for `peer` (6 bytes) when `pairwise`,
// else the group key `key_index`, with its receive sequence counter `rsc`
// (6 bytes). 0, or a negative errno.
pub fn newKey(wifi: *Wifi, index: u32, key: [*]const u8, key_length: usize, key_index: u8, cipher: u32, pairwise: bool, peer: [*]const u8, rsc: [*]const u8) -> i32 {
    var bytes: [160]u8 = undefined
    const view: [*]u8 = &bytes
    var builder: netlink.Builder = undefined
    request(wifi, &builder, view, 160, CMD_NEW_KEY, index, 0)
    netlink.attribute(&builder, ATTR_KEY_DATA, key[0..key_length])
    netlink.attributeU32(&builder, ATTR_KEY_CIPHER, cipher)
    netlink.attributeU8(&builder, ATTR_KEY_IDX, key_index)
    if pairwise {
        netlink.attribute(&builder, ATTR_MAC, peer[0..6])
        netlink.attributeU32(&builder, ATTR_KEY_TYPE, KEYTYPE_PAIRWISE)
    } else {
        netlink.attribute(&builder, ATTR_KEY_SEQ, rsc[0..6])
        netlink.attributeU32(&builder, ATTR_KEY_TYPE, KEYTYPE_GROUP)
    }
    const result = netlink.transact(commandsOf(wifi), &builder, wifi.*.scratch, wifi.*.capacity)
    var index_byte: usize = 0
    while index_byte < 160 {
        bytes[index_byte] = 0
        index_byte += 1
    }
    return result
}

// Opens the port to `peer` (the access point) for all frames.
pub fn authorize(wifi: *Wifi, index: u32, peer: [*]const u8) -> i32 {
    var bytes: [96]u8 = undefined
    const view: [*]u8 = &bytes
    var builder: netlink.Builder = undefined
    request(wifi, &builder, view, 96, CMD_SET_STATION, index, 0)
    netlink.attribute(&builder, ATTR_MAC, peer[0..6])
    // struct nl80211_sta_flag_update: mask, set.
    var update: [8]u8 = [8]u8{ 2, 0, 0, 0, 2, 0, 0, 0 }
    const update_view: [*]const u8 = &update
    netlink.attribute(&builder, ATTR_STA_FLAGS2, update_view[0..8])
    return netlink.transact(commandsOf(wifi), &builder, wifi.*.scratch, wifi.*.capacity)
}

// The event in `message` (from the events socket) into `event`.
pub fn eventOf(message: *const netlink.Message, event: *Event) -> void {
    event.*.kind = EVENT_NONE
    event.*.index = 0
    event.*.status = 0
    event.*.reason = 0
    event.*.byAccessPoint = false
    if message.*.length < netlink.COMMAND_HEADER { return }
    const command = message.*.payload[0]
    var timed_out = false
    var offset: usize = netlink.COMMAND_HEADER
    var found: netlink.Attribute = undefined
    while netlink.nextAttribute(message.*.payload, message.*.length, &offset, &found) {
        if found.kind == ATTR_IFINDEX { event.*.index = netlink.u32Of(&found) }
        if found.kind == ATTR_MAC && found.length == 6 {
            var index: usize = 0
            while index < 6 {
                event.*.bssid[index] = found.data[index]
                index += 1
            }
        }
        if found.kind == ATTR_STATUS_CODE { event.*.status = @intCast(u32, netlink.u16Of(&found)) }
        if found.kind == ATTR_REASON_CODE { event.*.reason = @intCast(u32, netlink.u16Of(&found)) }
        if found.kind == ATTR_DISCONNECTED_BY_AP { event.*.byAccessPoint = true }
        if found.kind == ATTR_TIMED_OUT { timed_out = true }
    }
    if command == CMD_NEW_SCAN_RESULTS { event.*.kind = EVENT_SCANNED }
    if command == CMD_SCAN_ABORTED { event.*.kind = EVENT_SCAN_ABORTED }
    if command == CMD_CONNECT { event.*.kind = if event.*.status == 0 && !timed_out { EVENT_CONNECTED } else { EVENT_CONNECT_FAILED } }
    if command == CMD_DISCONNECT { event.*.kind = EVENT_DISCONNECTED }
}
