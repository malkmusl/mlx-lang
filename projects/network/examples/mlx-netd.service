# mlx-netd under systemd, in place of NetworkManager (and
# systemd-networkd), on MLXIPC's system bus (mlx-ipcd.service):
# tools/install_network.sh installs both into /etc/systemd/system and,
# with --enable, enables them and masks those.
[Unit]
Description=MLX network daemon (cables and Wi-Fi)
Documentation=file://@DOCDIR@/README.md
Wants=network.target
Before=network.target
Requires=mlx-ipcd.service
After=mlx-ipcd.service
Conflicts=NetworkManager.service systemd-networkd.service wpa_supplicant.service

[Service]
ExecStart=@BINDIR@/mlx-netd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# It needs the network's and the raw sockets' capabilities only.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/etc /var/lib/mlx/network /run
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
