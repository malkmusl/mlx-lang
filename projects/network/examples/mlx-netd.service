# mlx-netd under systemd, in place of NetworkManager (and
# systemd-networkd): tools/install_network.sh installs it into
# /etc/systemd/system and, with --enable, enables it and masks those.
[Unit]
Description=MLX network daemon (cables and Wi-Fi)
Documentation=file:///usr/local/share/doc/mlx/network/README.md
Wants=network.target
Before=network.target
After=dbus.service
Conflicts=NetworkManager.service systemd-networkd.service wpa_supplicant.service

[Service]
ExecStart=@BINDIR@/mlx-netd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# It needs the network's and the raw sockets' capabilities only.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/etc /var/lib/mlx/network /run
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
Alias=dbus-org.freedesktop.NetworkManager.service
