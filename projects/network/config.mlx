// mlx-netd's configuration: /etc/mlx/network.conf (--config names
// another), "key = value" lines, '#' starts a comment. A key with a link's
// name before a dot is that link's, else it is for all:
//
//     hostname = laptop              said to DHCP servers (else
//                                    /etc/hostname)
//     ignore = docker* veth* virbr* br-*
//                                    links left alone (names; a trailing
//                                    '*' takes the rest; this is the
//                                    default)
//     eth0.method = dhcp             dhcp (the default), static, or off
//                                    (the link is left down)
//     eth0.address = 192.168.1.5/24  static: the address
//     eth0.gateway = 192.168.1.1     static: the default route
//     eth0.dns = 1.1.1.1 9.9.9.9     static: up to three name servers
//     eth0.metric = 100              the default route's metric (100 on a
//                                    cable, 600 on Wi-Fi by default)
const std = @import("std")
const conf = @import("std.conf")
const system = @import("./system.mlx")

pub const METHOD_DHCP: u32 = 0
pub const METHOD_STATIC: u32 = 1
pub const METHOD_OFF: u32 = 2

const CAPACITY: usize = 8192

pub const Config = struct {
    text: [8192]u8
    length: usize
    hostname: [64]u8
    hostnameLength: usize
}

fn textOf(config: *Config) -> []const u8 {
    const bytes: [*]const u8 = &config.*.text
    return bytes[0..config.*.length]
}

pub fn hostnameOf(config: *Config) -> []const u8 {
    const bytes: [*]const u8 = &config.*.hostname
    return bytes[0..config.*.hostnameLength]
}

// Reads the file (none: the defaults) and the hostname.
pub fn load(config: *Config, path: []const u8) -> void {
    const bytes: [*]u8 = &config.*.text
    config.*.length = system.readFile(path, bytes, CAPACITY)
    const hostname: [*]u8 = &config.*.hostname
    var name = value(config, "", "hostname")
    var from_file: [64]u8 = undefined
    if name.length == 0 {
        const view: [*]u8 = &from_file
        const length = system.readFile("/etc/hostname", view, 64)
        name = std.text.trimmed(view[0..length])
        var line: usize = 0
        while line < name.length && name[line] != 10 { line += 1 }
        name = name[0..line]
    }
    var length: usize = 0
    while length < name.length && length < 64 {
        hostname[length] = name[length]
        length += 1
    }
    config.*.hostnameLength = length
}

// The value of `key` for link `link` ("" for the general one): the
// link's own line, else the general line, else "".
pub fn value(config: *Config, link: []const u8, key: []const u8) -> []const u8 {
    const text = textOf(config)
    var general: []const u8 = text[0..0]
    var own: []const u8 = text[0..0]
    var found_own = false
    var lines = conf.lines(text)
    var entry: conf.Entry = undefined
    while conf.next(&lines, &entry) {
        const name = entry.key
        const given = entry.value
        if std.text.same(name, key) { general = given }
        if link.length > 0 && name.length == link.length + 1 + key.length && std.text.startsWith(name, link) && name[link.length] == 46 && std.text.same(name[link.length + 1..name.length], key) {
            own = given
            found_own = true
        }
    }
    return if found_own { own } else { general }
}

// The method for link `link`.
pub fn method(config: *Config, link: []const u8) -> u32 {
    const given = value(config, link, "method")
    if std.text.same(given, "static") { return METHOD_STATIC }
    if std.text.same(given, "off") { return METHOD_OFF }
    return METHOD_DHCP
}

// Whether link `link` is left alone (the ignore list, its default).
pub fn ignored(config: *Config, link: []const u8) -> bool {
    var list = value(config, "", "ignore")
    if list.length == 0 { list = "docker* veth* virbr* br-* vnet* tap* tun*" }
    var start: usize = 0
    while start < list.length {
        while start < list.length && list[start] == 32 { start += 1 }
        var end = start
        while end < list.length && list[end] != 32 { end += 1 }
        const pattern = list[start..end]
        start = end
        if pattern.length == 0 { continue }
        if pattern[pattern.length - 1] == 42 {
            if std.text.startsWith(link, pattern[0..pattern.length - 1]) { return true }
        } else if std.text.same(link, pattern) {
            return true
        }
    }
    return false
}

// The metric of link `link`'s default route (`fallback` unless set).
pub fn metric(config: *Config, link: []const u8, fallback: u32) -> u32 {
    const given = value(config, link, "metric")
    if given.length == 0 { return fallback }
    var result: u32 = 0
    for byte in given {
        if byte < 48 || byte > 57 { return fallback }
        result = result * 10 + @intCast(u32, byte - 48)
    }
    return result
}
