// The thread control block (TCB): what mlxlibc knows about a thread.
// Threads mlxlibc starts (pthread.mlx) get one at the top of their stack
// and as their thread pointer, so @threadPointer() finds it at once. A
// thread it did not start (the program's main thread, one a different C
// library made) has its own TCB elsewhere; such a thread gets a shadow
// block here, found by its thread pointer in a small table, so errno and
// the thread-specific keys work for it too.
const sys = @import("./sys.mlx")

pub const MAGIC0: u64 = 7881698906165293667   // "mlx libc" in little-endian bytes
pub const MAGIC1: u64 = 3544385890265608241
pub const KEY_COUNT: usize = 128
pub const SIZE: usize = 128 + KEY_COUNT * 8

// Word offsets.
pub const SELF: usize = 0
pub const MAGIC_LOW: usize = 8
pub const MAGIC_HIGH: usize = 16
pub const TID: usize = 24         // u32: set and cleared by the kernel (CLONE_CHILD_SETTID, CLONE_CHILD_CLEARTID)
pub const DETACHED: usize = 28    // u32
pub const START: usize = 32
pub const CANARY: usize = 40      // fs:0x28, where C code compiled with a stack protector reads its guard
pub const RESULT: usize = 48
pub const FINISHED: usize = 56    // u32
pub const ERRNO: usize = 60       // i32
pub const STACK: usize = 64       // the mapping's base
pub const STACK_SIZE: usize = 72  // and its length (the TCB included)
pub const NEXT: usize = 80        // registry link
pub const OWN: usize = 88         // u32: 1 for a thread mlxlibc started
pub const ARGUMENT: usize = 96
pub const TLS_MODULES: usize = 104 // how many TLS modules' images this thread's static TLS holds (loader.mlx)
pub const KEYS: usize = 128

pub fn isOurs(block: usize) -> bool {
    return block != 0 && sys.get64(block + MAGIC_LOW) == MAGIC0 && sys.get64(block + MAGIC_HIGH) == MAGIC1
}

pub fn initialize(block: usize) -> void {
    sys.fill(block, 0, SIZE)
    sys.putPointer(block + SELF, block)
    sys.put64(block + MAGIC_LOW, MAGIC0)
    sys.put64(block + MAGIC_HIGH, MAGIC1)
}

// The shadow blocks of foreign threads: a table keyed by thread pointer,
// never shrinking (a foreign thread's end is not seen here).
const SHADOW_SLOTS: usize = 256
var shadowLock: u32 = 0
var shadowPointers: [256]usize = undefined
var shadowBlocks: [256]usize = undefined
var shadowCount: usize = 0
var shadowPages: usize = 0
var shadowPageUsed: usize = 0

fn shadowFor(pointer: usize) -> usize {
    sys.lock(@ptrCast(*u32, &shadowLock))
    var index: usize = 0
    while index < shadowCount {
        if shadowPointers[index] == pointer {
            const found = shadowBlocks[index]
            sys.unlock(@ptrCast(*u32, &shadowLock))
            return found
        }
        index += 1
    }
    var block: usize = 0
    if shadowCount < SHADOW_SLOTS {
        if shadowPages == 0 || shadowPageUsed + SIZE > 16 * sys.PAGE {
            shadowPages = sys.mmap(16 * sys.PAGE, sys.PROT_READ | sys.PROT_WRITE, sys.MAP_PRIVATE | sys.MAP_ANONYMOUS)
            shadowPageUsed = 0
        }
        if shadowPages != sys.MAP_FAILED {
            block = shadowPages + shadowPageUsed
            shadowPageUsed += SIZE
            initialize(block)
            // A shadow's self word is the real thread pointer, so that
            // pthread_self() answers what the thread's own library does.
            sys.putPointer(block + SELF, pointer)
            shadowPointers[shadowCount] = pointer
            shadowBlocks[shadowCount] = block
            shadowCount += 1
        }
    }
    sys.unlock(@ptrCast(*u32, &shadowLock))
    return block
}

// The calling thread's block: its own when mlxlibc started it, a shadow
// otherwise (0 only when memory is gone).
pub fn current() -> usize {
    const pointer = @threadPointer()
    if isOurs(pointer) { return pointer }
    return shadowFor(pointer)
}

// The block of a thread by its pthread_t (its thread pointer): ours, or a
// shadow when one exists (0 for an unknown thread).
pub fn find(pointer: usize) -> usize {
    if isOurs(pointer) { return pointer }
    sys.lock(@ptrCast(*u32, &shadowLock))
    var index: usize = 0
    var found: usize = 0
    while index < shadowCount {
        if shadowPointers[index] == pointer { found = shadowBlocks[index] }
        index += 1
    }
    sys.unlock(@ptrCast(*u32, &shadowLock))
    return found
}
