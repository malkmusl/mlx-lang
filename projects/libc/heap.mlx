// malloc and its family on std's general-purpose allocator (one heap for
// the process, made on first use). Every block carries a 16-byte header
// just before the address handed out: the allocation's whole length and
// its base, so free and realloc need the pointer alone and an aligned
// block (posix_memalign) can start anywhere inside the allocation.
const bootstrap = @import("../../std/bootstrap/root.mlx")
const sys = @import("./sys.mlx")
const errno = @import("./errno.mlx")

const gpa = bootstrap.general_purpose_allocator
const Allocator = bootstrap.allocator.Allocator

const HEADER: usize = 16

var heap: gpa.Heap = undefined
var ready: u32 = 0
var readyLock: u32 = 0

pub fn allocator() -> Allocator {
    if @atomicLoad(u32, @ptrCast(*u32, &ready), acquire) == 0 {
        sys.lock(@ptrCast(*u32, &readyLock))
        if ready == 0 {
            heap = gpa.init(bootstrap.page_allocator.init())
            @atomicStore(u32, @ptrCast(*u32, &ready), 1, release)
        }
        sys.unlock(@ptrCast(*u32, &readyLock))
    }
    return gpa.interface(@ptrCast(*gpa.Heap, &heap))
}

fn roundUp(value: usize, alignment: usize) -> usize { return (value + alignment - 1) & ~(alignment - 1) }

// A block of `size` bytes aligned to `alignment` (a power of two, at least
// 16); 0 with errno ENOMEM when there is none.
pub fn allocate(size: usize, alignment: usize) -> usize {
    const wanted = if size == 0 { 1 } else { size }
    // (The limit as a typed constant: a usize compared against a literal
    // expression this large compares signed today.)
    const most: usize = 18446744073709551615
    const limit: usize = most - alignment - HEADER - 64
    if wanted > limit {
        errno.set(sys.ENOMEM)
        return 0
    }
    const total = if alignment <= 16 { roundUp(wanted + HEADER, 16) } else { roundUp(wanted + HEADER + alignment, 16) }
    const memory = allocator().alloc(total, 16)
    if memory == null {
        errno.set(sys.ENOMEM)
        return 0
    }
    const base = @intFromPtr(memory.?)
    const block = if alignment <= 16 { base + HEADER } else { roundUp(base + HEADER, alignment) }
    sys.putPointer(block - HEADER, total)
    sys.putPointer(block - HEADER + 8, base)
    return block
}

pub fn release(block: usize) -> void {
    if block == 0 { return }
    const total = sys.getPointer(block - HEADER)
    const base = sys.getPointer(block - HEADER + 8)
    unsafe { allocator().free(@ptrFromInt([*]u8, base), total, 16) }
}

// The bytes usable at `block`: from it to the allocation's end.
pub fn usable(block: usize) -> usize {
    if block == 0 { return 0 }
    const total = sys.getPointer(block - HEADER)
    const base = sys.getPointer(block - HEADER + 8)
    return base + total - block
}

pub export fn malloc(size: usize) -> usize { return allocate(size, 16) }

pub export fn free(block: usize) -> void { release(block) }

pub export fn calloc(count: usize, size: usize) -> usize {
    if count != 0 && size > 18446744073709551615 / count {
        errno.set(sys.ENOMEM)
        return 0
    }
    const block = allocate(count * size, 16)
    if block != 0 { sys.fill(block, 0, count * size) }
    return block
}

pub export fn realloc(block: usize, size: usize) -> usize {
    if block == 0 { return allocate(size, 16) }
    if size == 0 {
        release(block)
        return 0
    }
    const room = usable(block)
    if size <= room { return block }
    const moved = allocate(size, 16)
    if moved == 0 { return 0 }
    sys.copy(moved, block, room)
    release(block)
    return moved
}

pub export fn reallocarray(block: usize, count: usize, size: usize) -> usize {
    if count != 0 && size > 18446744073709551615 / count {
        errno.set(sys.ENOMEM)
        return 0
    }
    return realloc(block, count * size)
}

pub export fn posix_memalign(result: usize, alignment: usize, size: usize) -> i32 {
    if alignment == 0 || alignment & (alignment - 1) != 0 || alignment % 8 != 0 { return sys.EINVAL }
    const block = allocate(size, if alignment < 16 { 16 } else { alignment })
    if block == 0 { return sys.ENOMEM }
    sys.putPointer(result, block)
    return 0
}

pub export fn aligned_alloc(alignment: usize, size: usize) -> usize {
    if alignment == 0 || alignment & (alignment - 1) != 0 {
        errno.set(sys.EINVAL)
        return 0
    }
    return allocate(size, if alignment < 16 { 16 } else { alignment })
}

pub export fn memalign(alignment: usize, size: usize) -> usize { return aligned_alloc(alignment, size) }

pub export fn valloc(size: usize) -> usize { return allocate(size, sys.PAGE) }

pub export fn pvalloc(size: usize) -> usize { return allocate(roundUp(size, sys.PAGE), sys.PAGE) }

pub export fn malloc_usable_size(block: usize) -> usize { return usable(block) }

// glibc's tuning knobs: nothing to tune.
pub export fn mallopt(parameter: i32, value: i32) -> i32 { return 1 }

pub export fn malloc_trim(pad: usize) -> i32 { return 0 }
