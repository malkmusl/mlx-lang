// The x87 extended format (C's long double, 80 bits) for strtold: a
// 64-bit mantissa with its integer bit written out, a 15-bit exponent
// biased by 16383 and the sign in one 16-bit word. A value is made from
// its decimal digits times a power of ten in 256-bit integer arithmetic
// (kept to about 200 bits, then rounded to 64, half to even), or from a
// mantissa and a binary exponent (hexadecimal floats). The same
// arithmetic is projects/cc/extended.mlx's, which mlx-cc uses for its
// constants.
const BIAS: i64 = 16383
const TOP: u64 = 9223372036854775808

// A 256-bit unsigned integer as four limbs, the lowest first.
pub const Wide = struct {
    limb: [4]u64
}

// a b in 128 bits (high, low), from 32-bit halves.
fn mulWide(a: u64, b: u64) -> (u64, u64) {
    const al = a & 4294967295
    const ah = a >> 32
    const bl = b & 4294967295
    const bh = b >> 32
    const ll = al * bl
    const lh = al * bh
    const hl = ah * bl
    const hh = ah * bh
    const mid = (ll >> 32) + (lh & 4294967295) + (hl & 4294967295)
    const low = (mid << 32) | (ll & 4294967295)
    const high = hh + (lh >> 32) + (hl >> 32) + (mid >> 32)
    return -> (high, low)
}

fn multiply(w: *Wide, factor: u64) -> void {
    var carry: u64 = 0
    var index: usize = 0
    while index < 4 {
        const product = mulWide(w.*.limb[index], factor)
        const low = product.1 +% carry
        carry = product.0 + (if low < product.1 { 1 } else { 0 })
        w.*.limb[index] = low
        index += 1
    }
}

fn divide(w: *Wide, divisor: u64) -> void {
    var remainder: u64 = 0
    var index: usize = 4
    while index > 0 {
        index -= 1
        const limb = w.*.limb[index]
        const highCurrent = (remainder << 32) | (limb >> 32)
        const highQuotient = highCurrent / divisor
        remainder = highCurrent % divisor
        const lowCurrent = (remainder << 32) | (limb & 4294967295)
        const lowQuotient = lowCurrent / divisor
        remainder = lowCurrent % divisor
        w.*.limb[index] = (highQuotient << 32) | lowQuotient
    }
}

fn topBit(w: *Wide) -> i64 {
    var index: usize = 4
    while index > 0 {
        index -= 1
        var limb = w.*.limb[index]
        if limb != 0 {
            var bit: i64 = 0
            while limb > 1 {
                limb = limb >> 1
                bit += 1
            }
            return @intCast(i64, index) * 64 + bit
        }
    }
    return -1
}

fn shiftLeftOne(w: *Wide) -> void {
    var index: usize = 4
    while index > 0 {
        index -= 1
        var limb = w.*.limb[index] << 1
        if index > 0 && w.*.limb[index - 1] & TOP != 0 { limb = limb | 1 }
        w.*.limb[index] = limb
    }
}

fn shiftRightOne(w: *Wide) -> void {
    var index: usize = 0
    while index < 4 {
        var limb = w.*.limb[index] >> 1
        if index < 3 && w.*.limb[index + 1] & 1 != 0 { limb = limb | TOP }
        w.*.limb[index] = limb
        index += 1
    }
}

fn shiftRight(w: *Wide, count: i64) -> void {
    var left = count
    while left > 0 {
        shiftRightOne(w)
        left -= 1
    }
}

fn bitAt(w: *Wide, position: i64) -> bool {
    if position < 0 { return false }
    return (w.*.limb[@intCast(usize, position / 64)] >> @intCast(u6, position % 64)) & 1 != 0
}

fn anyBelow(w: *Wide, position: i64) -> bool {
    var bit: i64 = 0
    while bit < position {
        if bitAt(w, bit) { return true }
        bit += 1
    }
    return false
}

// `mantissa` 2^`exponent` (the top bit set) rounded into the format.
fn fromNormalized(mantissa: u64, exponent: i64, negative: bool) -> (u64, u16) {
    const sign: u16 = if negative { 32768 } else { 0 }
    const biased = exponent + 63 + BIAS
    if biased >= 32767 { return -> (TOP, sign | 32767) }
    if biased >= 1 { return -> (mantissa, sign | @intCast(u16, biased)) }
    const shift = 1 - biased
    if shift > 64 { return -> (0, sign) }
    var m = mantissa
    var roundUp = false
    if shift == 64 {
        roundUp = m & TOP != 0 && (m & (TOP - 1) != 0)
        m = 0
    } else {
        const half = @intCast(u64, 1) << @intCast(u6, shift - 1)
        const rest = m & (half + half - 1)
        m = m >> @intCast(u6, shift)
        roundUp = rest > half || (rest == half && m & 1 != 0)
    }
    if roundUp { m += 1 }
    if m & TOP != 0 { return -> (m, sign | 1) }
    return -> (m, sign)
}

// `mantissa` 2^`exponent` for any mantissa.
pub fn fromBinary(mantissa: u64, exponent: i64, negative: bool) -> (u64, u16) {
    if mantissa == 0 { return -> (0, if negative { 32768 } else { 0 }) }
    var m = mantissa
    var e = exponent
    while m & TOP == 0 {
        m = m << 1
        e -= 1
    }
    return fromNormalized(m, e, negative)
}

pub fn zero() -> Wide { return Wide.{ .limb = [4]u64{ 0, 0, 0, 0 } } }

// Whether another decimal digit fits (below 200 bits): the caller
// counts the digits it does not add into the exponent.
pub fn hasRoom(w: *Wide) -> bool { return topBit(w) < 200 }

pub fn pushDigit(w: *Wide, digit: u64) -> void { pushScaled(w, 10, digit) }
pub fn pushHex(w: *Wide, digit: u64) -> void { pushScaled(w, 16, digit) }

fn pushScaled(w: *Wide, scale: u64, digit: u64) -> void {
    multiply(w, scale)
    var carry = digit
    var index: usize = 0
    while index < 4 && carry != 0 {
        const sum = w.*.limb[index] +% carry
        carry = if sum < carry { 1 } else { 0 }
        w.*.limb[index] = sum
        index += 1
    }
}

// `digits` 10^`exponent` (the digits as an integer of 19 at most).
pub fn fromDecimal(digits: u64, exponent: i64, negative: bool) -> (u64, u16) {
    var w: Wide = Wide.{ .limb = [4]u64{ digits, 0, 0, 0 } }
    return fromDigits(&w, exponent, negative)
}

// The digits in `w` (below 200 bits) times 10^`exponent`.
pub fn fromDigits(w: *Wide, exponent: i64, negative: bool) -> (u64, u16) {
    if topBit(w) < 0 { return -> (0, if negative { 32768 } else { 0 }) }
    // Far outside the range the loops below would run for nothing.
    if exponent > 5000 { return -> (TOP, (if negative { 32768 } else { 0 }) | 32767) }
    if exponent < -5100 { return -> (0, if negative { 32768 } else { 0 }) }
    var e2: i64 = 0
    var steps = exponent
    while steps > 0 {
        const top = topBit(w)
        if top >= 250 {
            shiftRight(w, top - 200)
            e2 += top - 200
        }
        multiply(w, 10)
        steps -= 1
    }
    while steps < 0 {
        var top = topBit(w)
        while top < 200 {
            shiftLeftOne(w)
            e2 -= 1
            top += 1
        }
        divide(w, 10)
        steps += 1
    }
    return roundWide(w, e2, negative)
}

// The digits in `w` times 2^`exponent` (hexadecimal floats).
pub fn fromWideBinary(w: *Wide, exponent: i64, negative: bool) -> (u64, u16) {
    if topBit(w) < 0 { return -> (0, if negative { 32768 } else { 0 }) }
    return roundWide(w, exponent, negative)
}

// `w` 2^`e2` rounded to 64 bits, half to even.
fn roundWide(w: *Wide, exponent: i64, negative: bool) -> (u64, u16) {
    var e2 = exponent
    const top = topBit(w)
    if top <= 63 { return fromBinary(w.*.limb[0], e2, negative) }
    const shift = top - 63
    const roundBit = bitAt(w, shift - 1)
    const sticky = anyBelow(w, shift - 1)
    shiftRight(w, shift)
    var m = w.*.limb[0]
    e2 += shift
    if roundBit && (sticky || m & 1 != 0) {
        m +%= 1
        if m == 0 {
            m = TOP
            e2 += 1
        }
    }
    return fromNormalized(m, e2, negative)
}
