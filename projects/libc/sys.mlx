// Whether a system call's result is an error (-4095 .. -1).
pub fn failed(value: isize) -> bool { return value < 0 && value >= -4095 }

pub fn mmap(length: usize, prot: usize, flags: usize) -> usize {
    const mapped = syscall6(SYS_mmap, 0, length, prot, flags, MAP_FAILED, 0)
    if failed(mapped) { return MAP_FAILED }
    return @bitCast(usize, mapped)
}

pub fn munmap(address: usize, length: usize) -> isize { return syscall2(SYS_munmap, address, length) }

pub fn futexWait(word: usize, expected: u32, timeout: usize, private: bool) -> isize {
    return syscall6(SYS_futex, word, FUTEX_WAIT | (if private { FUTEX_PRIVATE } else { 0 }), @intCast(usize, expected), timeout, 0, 0)
}

pub fn futexWake(word: usize, count: u32, private: bool) -> isize {
    return syscall6(SYS_futex, word, FUTEX_WAKE | (if private { FUTEX_PRIVATE } else { 0 }), @intCast(usize, count), 0, 0, 0)
}

pub fn getTid() -> u32 { return @intCast(u32, syscall0(SYS_gettid)) }

pub fn getPid() -> u32 { return @intCast(u32, syscall0(SYS_getpid)) }

// A small lock (0 free, 1 taken, 2 taken with waiters) for the library's
// own tables; private futexes.
pub fn lock(word: *u32) -> void {
    const first = @cmpxchgStrong(u32, word, 0, 1, acquire, monotonic)
    if first.0 { return }
    var seen = first.1
    while true {
        var wait = seen == 2
        if !wait {
            const marked = @cmpxchgStrong(u32, word, 1, 2, acquire, monotonic)
            wait = marked.1 != 0
        }
        if wait { const waited = futexWait(@intFromPtr(word), 2, 0, true) }
        const again = @cmpxchgStrong(u32, word, 0, 2, acquire, monotonic)
        if again.0 { return }
        seen = again.1
    }
}

pub fn unlock(word: *u32) -> void {
    const previous = @atomicRmw(u32, word, xchg, 0, release)
    if previous == 2 { const woken = futexWake(@intFromPtr(word), 1, true) }
}

// Raw memory through addresses (C's view of it).
pub fn bytes(address: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, address) }
}

pub fn constBytes(address: usize) -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, address) }
}

pub fn get8(address: usize) -> u8 { return bytes(address)[0] }

pub fn put8(address: usize, value: u8) -> void { bytes(address)[0] = value }

pub fn get16(address: usize) -> u16 {
    unsafe { return @ptrFromInt(*u16, address).* }
}

pub fn put16(address: usize, value: u16) -> void {
    unsafe { @ptrFromInt(*u16, address).* = value }
}

pub fn get32(address: usize) -> u32 {
    unsafe { return @ptrFromInt(*u32, address).* }
}

pub fn put32(address: usize, value: u32) -> void {
    unsafe { @ptrFromInt(*u32, address).* = value }
}

pub fn getI32(address: usize) -> i32 {
    unsafe { return @ptrFromInt(*i32, address).* }
}

pub fn putI32(address: usize, value: i32) -> void {
    unsafe { @ptrFromInt(*i32, address).* = value }
}

pub fn get64(address: usize) -> u64 {
    unsafe { return @ptrFromInt(*u64, address).* }
}

pub fn put64(address: usize, value: u64) -> void {
    unsafe { @ptrFromInt(*u64, address).* = value }
}

pub fn getPointer(address: usize) -> usize {
    unsafe { return @ptrFromInt(*usize, address).* }
}

pub fn putPointer(address: usize, value: usize) -> void {
    unsafe { @ptrFromInt(*usize, address).* = value }
}

pub fn word(address: usize) -> *u32 {
    unsafe { return @ptrFromInt(*u32, address) }
}

// The length of a NUL-terminated string.
pub fn length(text: usize) -> usize {
    const data = constBytes(text)
    var count: usize = 0
    while data[count] != 0 { count += 1 }
    return count
}

// The bytes of a NUL-terminated string (without the NUL).
pub fn slice(text: usize) -> []const u8 {
    const data = constBytes(text)
    return data[0..length(text)]
}

// The address of a string literal's bytes (NUL-terminated in the image).
pub fn literal(text: []const u8) -> usize {
    unsafe { return @intFromPtr(@ptrCast([*]const u8, text)) }
}

pub fn copy(target: usize, source: usize, count: usize) -> void {
    const to = bytes(target)
    const from = constBytes(source)
    if target <= source || target >= source + count {
        var index: usize = 0
        while index < count {
            to[index] = from[index]
            index += 1
        }
        return
    }
    var back = count
    while back > 0 {
        back -= 1
        to[back] = from[back]
    }
}

pub fn fill(target: usize, value: u8, count: usize) -> void {
    const to = bytes(target)
    var index: usize = 0
    while index < count {
        to[index] = value
        index += 1
    }
}

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// C's int as a usize argument and back.
pub fn int(value: i32) -> usize { return @bitCast(usize, @intCast(isize, value)) }

pub fn toInt(value: usize) -> i32 { return @intCast(i32, @bitCast(isize, value)) }

// Calls through C function pointers (callbacks, comparators, thread
// starts, atexit handlers).
pub const Call0 = fn() -> void
pub const Call1 = fn(usize) -> void
pub const Call2 = fn(usize, usize) -> void
pub const Call1Result = fn(usize) -> usize
pub const Compare2 = fn(usize, usize) -> i32
pub const Compare3 = fn(usize, usize, usize) -> i32

pub fn call0(function: usize) -> void {
    if function == 0 { return }
    var target: Call0 = undefined
    unsafe { target = @ptrFromInt(Call0, function) }
    target()
}

pub fn call1(function: usize, a: usize) -> void {
    if function == 0 { return }
    var target: Call1 = undefined
    unsafe { target = @ptrFromInt(Call1, function) }
    target(a)
}

pub fn call2(function: usize, a: usize, b: usize) -> void {
    if function == 0 { return }
    var target: Call2 = undefined
    unsafe { target = @ptrFromInt(Call2, function) }
    target(a, b)
}

pub fn call1Result(function: usize, a: usize) -> usize {
    if function == 0 { return 0 }
    var target: Call1Result = undefined
    unsafe { target = @ptrFromInt(Call1Result, function) }
    return target(a)
}

pub fn compare2(function: usize, a: usize, b: usize) -> i32 {
    var target: Compare2 = undefined
    unsafe { target = @ptrFromInt(Compare2, function) }
    return target(a, b)
}

pub fn compare3(function: usize, a: usize, b: usize, c: usize) -> i32 {
    var target: Compare3 = undefined
    unsafe { target = @ptrFromInt(Compare3, function) }
    return target(a, b, c)
}
