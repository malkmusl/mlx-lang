// string.h and strings.h: memory and C string functions, and strerror's
// texts (glibc's words, so programs print what they printed).
const sys = @import("./sys.mlx")
const heap = @import("./heap.mlx")
const errno = @import("./errno.mlx")

pub export fn memcpy(target: usize, source: usize, count: usize) -> usize {
    sys.copy(target, source, count)
    return target
}

pub export fn memmove(target: usize, source: usize, count: usize) -> usize {
    sys.copy(target, source, count)
    return target
}

pub export fn memset(target: usize, value: i32, count: usize) -> usize {
    sys.fill(target, @intCast(u8, value & 255), count)
    return target
}

pub export fn memcmp(first: usize, second: usize, count: usize) -> i32 {
    const a = sys.constBytes(first)
    const b = sys.constBytes(second)
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return @intCast(i32, a[index]) - @intCast(i32, b[index]) }
        index += 1
    }
    return 0
}

pub export fn bcmp(first: usize, second: usize, count: usize) -> i32 { return memcmp(first, second, count) }

pub export fn bzero(target: usize, count: usize) -> void { sys.fill(target, 0, count) }

pub export fn explicit_bzero(target: usize, count: usize) -> void { sys.fill(target, 0, count) }

pub export fn memchr(source: usize, value: i32, count: usize) -> usize {
    const wanted = @intCast(u8, value & 255)
    const data = sys.constBytes(source)
    var index: usize = 0
    while index < count {
        if data[index] == wanted { return source + index }
        index += 1
    }
    return 0
}

pub export fn memrchr(source: usize, value: i32, count: usize) -> usize {
    const wanted = @intCast(u8, value & 255)
    const data = sys.constBytes(source)
    var index = count
    while index > 0 {
        index -= 1
        if data[index] == wanted { return source + index }
    }
    return 0
}

pub export fn rawmemchr(source: usize, value: i32) -> usize {
    const wanted = @intCast(u8, value & 255)
    const data = sys.constBytes(source)
    var index: usize = 0
    while data[index] != wanted { index += 1 }
    return source + index
}

pub export fn memccpy(target: usize, source: usize, value: i32, count: usize) -> usize {
    const wanted = @intCast(u8, value & 255)
    const to = sys.bytes(target)
    const from = sys.constBytes(source)
    var index: usize = 0
    while index < count {
        to[index] = from[index]
        if from[index] == wanted { return target + index + 1 }
        index += 1
    }
    return 0
}

pub export fn memmem(haystack: usize, haystack_length: usize, needle: usize, needle_length: usize) -> usize {
    if needle_length == 0 { return haystack }
    if needle_length > haystack_length { return 0 }
    var at: usize = 0
    while at + needle_length <= haystack_length {
        if memcmp(haystack + at, needle, needle_length) == 0 { return haystack + at }
        at += 1
    }
    return 0
}

pub export fn strlen(text: usize) -> usize { return sys.length(text) }

pub export fn strnlen(text: usize, limit: usize) -> usize {
    const data = sys.constBytes(text)
    var count: usize = 0
    while count < limit && data[count] != 0 { count += 1 }
    return count
}

pub export fn strcpy(target: usize, source: usize) -> usize {
    const count = sys.length(source)
    sys.copy(target, source, count + 1)
    return target
}

pub export fn stpcpy(target: usize, source: usize) -> usize {
    const count = sys.length(source)
    sys.copy(target, source, count + 1)
    return target + count
}

pub export fn strncpy(target: usize, source: usize, count: usize) -> usize {
    const to = sys.bytes(target)
    const from = sys.constBytes(source)
    var index: usize = 0
    while index < count && from[index] != 0 {
        to[index] = from[index]
        index += 1
    }
    while index < count {
        to[index] = 0
        index += 1
    }
    return target
}

pub export fn stpncpy(target: usize, source: usize, count: usize) -> usize {
    const copied = strnlen(source, count)
    const unused = strncpy(target, source, count)
    return target + copied
}

pub export fn strcat(target: usize, source: usize) -> usize {
    const unused = strcpy(target + sys.length(target), source)
    return target
}

pub export fn strncat(target: usize, source: usize, count: usize) -> usize {
    const end = target + sys.length(target)
    const copied = strnlen(source, count)
    sys.copy(end, source, copied)
    sys.put8(end + copied, 0)
    return target
}

// BSD's bounded copies (glibc 2.38 has them).
pub export fn strlcpy(target: usize, source: usize, size: usize) -> usize {
    const count = sys.length(source)
    if size > 0 {
        const copied = if count < size - 1 { count } else { size - 1 }
        sys.copy(target, source, copied)
        sys.put8(target + copied, 0)
    }
    return count
}

pub export fn strlcat(target: usize, source: usize, size: usize) -> usize {
    const used = strnlen(target, size)
    if used == size { return size + sys.length(source) }
    return used + strlcpy(target + used, source, size - used)
}

pub export fn strcmp(first: usize, second: usize) -> i32 {
    const a = sys.constBytes(first)
    const b = sys.constBytes(second)
    var index: usize = 0
    while a[index] != 0 && a[index] == b[index] { index += 1 }
    return @intCast(i32, a[index]) - @intCast(i32, b[index])
}

pub export fn strncmp(first: usize, second: usize, count: usize) -> i32 {
    const a = sys.constBytes(first)
    const b = sys.constBytes(second)
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return @intCast(i32, a[index]) - @intCast(i32, b[index]) }
        if a[index] == 0 { return 0 }
        index += 1
    }
    return 0
}

pub export fn strcoll(first: usize, second: usize) -> i32 { return strcmp(first, second) }

pub export fn strxfrm(target: usize, source: usize, count: usize) -> usize {
    const unused = strncpy(target, source, count)
    return sys.length(source)
}

fn lower(value: u8) -> u8 {
    if value >= 65 && value <= 90 { return value + 32 }
    return value
}

pub export fn strcasecmp(first: usize, second: usize) -> i32 {
    const a = sys.constBytes(first)
    const b = sys.constBytes(second)
    var index: usize = 0
    while a[index] != 0 && lower(a[index]) == lower(b[index]) { index += 1 }
    return @intCast(i32, lower(a[index])) - @intCast(i32, lower(b[index]))
}

pub export fn strncasecmp(first: usize, second: usize, count: usize) -> i32 {
    const a = sys.constBytes(first)
    const b = sys.constBytes(second)
    var index: usize = 0
    while index < count {
        const x = lower(a[index])
        const y = lower(b[index])
        if x != y { return @intCast(i32, x) - @intCast(i32, y) }
        if x == 0 { return 0 }
        index += 1
    }
    return 0
}

pub export fn strchr(text: usize, value: i32) -> usize {
    const wanted = @intCast(u8, value & 255)
    const data = sys.constBytes(text)
    var index: usize = 0
    while true {
        if data[index] == wanted { return text + index }
        if data[index] == 0 { return 0 }
        index += 1
    }
    return 0
}

pub export fn strchrnul(text: usize, value: i32) -> usize {
    const wanted = @intCast(u8, value & 255)
    const data = sys.constBytes(text)
    var index: usize = 0
    while data[index] != 0 && data[index] != wanted { index += 1 }
    return text + index
}

pub export fn strrchr(text: usize, value: i32) -> usize {
    const wanted = @intCast(u8, value & 255)
    const data = sys.constBytes(text)
    var found: usize = 0
    var index: usize = 0
    while true {
        if data[index] == wanted { found = text + index }
        if data[index] == 0 { return found }
        index += 1
    }
    return found
}

pub export fn strstr(haystack: usize, needle: usize) -> usize {
    const needle_length = sys.length(needle)
    if needle_length == 0 { return haystack }
    const hay = sys.constBytes(haystack)
    var at: usize = 0
    while hay[at] != 0 {
        if hay[at] == sys.get8(needle) && strncmp(haystack + at, needle, needle_length) == 0 { return haystack + at }
        at += 1
    }
    return 0
}

pub export fn strcasestr(haystack: usize, needle: usize) -> usize {
    const needle_length = sys.length(needle)
    if needle_length == 0 { return haystack }
    const hay = sys.constBytes(haystack)
    var at: usize = 0
    while hay[at] != 0 {
        if strncasecmp(haystack + at, needle, needle_length) == 0 { return haystack + at }
        at += 1
    }
    return 0
}

pub export fn strdup(text: usize) -> usize {
    const count = sys.length(text)
    const copy = heap.allocate(count + 1, 16)
    if copy == 0 { return 0 }
    sys.copy(copy, text, count + 1)
    return copy
}

pub export fn strndup(text: usize, limit: usize) -> usize {
    const count = strnlen(text, limit)
    const copy = heap.allocate(count + 1, 16)
    if copy == 0 { return 0 }
    sys.copy(copy, text, count)
    sys.put8(copy + count, 0)
    return copy
}

fn inSet(value: u8, set: usize) -> bool {
    const members = sys.constBytes(set)
    var index: usize = 0
    while members[index] != 0 {
        if members[index] == value { return true }
        index += 1
    }
    return false
}

pub export fn strspn(text: usize, accept: usize) -> usize {
    const data = sys.constBytes(text)
    var count: usize = 0
    while data[count] != 0 && inSet(data[count], accept) { count += 1 }
    return count
}

pub export fn strcspn(text: usize, reject: usize) -> usize {
    const data = sys.constBytes(text)
    var count: usize = 0
    while data[count] != 0 && !inSet(data[count], reject) { count += 1 }
    return count
}

pub export fn strpbrk(text: usize, accept: usize) -> usize {
    const data = sys.constBytes(text)
    var index: usize = 0
    while data[index] != 0 {
        if inSet(data[index], accept) { return text + index }
        index += 1
    }
    return 0
}

pub export fn strsep(cursor: usize, delimiters: usize) -> usize {
    const start = sys.getPointer(cursor)
    if start == 0 { return 0 }
    const end = start + strcspn(start, delimiters)
    if sys.get8(end) == 0 {
        sys.putPointer(cursor, 0)
    } else {
        sys.put8(end, 0)
        sys.putPointer(cursor, end + 1)
    }
    return start
}

pub export fn strtok_r(text: usize, delimiters: usize, cursor: usize) -> usize {
    var start = if text != 0 { text } else { sys.getPointer(cursor) }
    if start == 0 { return 0 }
    start += strspn(start, delimiters)
    if sys.get8(start) == 0 {
        sys.putPointer(cursor, 0)
        return 0
    }
    const end = start + strcspn(start, delimiters)
    if sys.get8(end) == 0 {
        sys.putPointer(cursor, 0)
    } else {
        sys.put8(end, 0)
        sys.putPointer(cursor, end + 1)
    }
    return start
}

var tokenCursor: usize = 0

pub export fn strtok(text: usize, delimiters: usize) -> usize { return strtok_r(text, delimiters, @intFromPtr(&tokenCursor)) }

pub export fn ffs(value: i32) -> i32 {
    if value == 0 { return 0 }
    var bits = @bitCast(u32, value)
    var position: i32 = 1
    while bits & 1 == 0 {
        bits >>= 1
        position += 1
    }
    return position
}

pub export fn ffsl(value: i64) -> i32 {
    if value == 0 { return 0 }
    var bits = @bitCast(u64, value)
    var position: i32 = 1
    while bits & 1 == 0 {
        bits >>= 1
        position += 1
    }
    return position
}

pub export fn ffsll(value: i64) -> i32 { return ffsl(value) }

// strerror: glibc's texts for the Linux errno values.
pub fn message(code: i32) -> []const u8 {
    match code {
        0 => { return "Success" },
        1 => { return "Operation not permitted" },
        2 => { return "No such file or directory" },
        3 => { return "No such process" },
        4 => { return "Interrupted system call" },
        5 => { return "Input/output error" },
        6 => { return "No such device or address" },
        7 => { return "Argument list too long" },
        8 => { return "Exec format error" },
        9 => { return "Bad file descriptor" },
        10 => { return "No child processes" },
        11 => { return "Resource temporarily unavailable" },
        12 => { return "Cannot allocate memory" },
        13 => { return "Permission denied" },
        14 => { return "Bad address" },
        15 => { return "Block device required" },
        16 => { return "Device or resource busy" },
        17 => { return "File exists" },
        18 => { return "Invalid cross-device link" },
        19 => { return "No such device" },
        20 => { return "Not a directory" },
        21 => { return "Is a directory" },
        22 => { return "Invalid argument" },
        23 => { return "Too many open files in system" },
        24 => { return "Too many open files" },
        25 => { return "Inappropriate ioctl for device" },
        26 => { return "Text file busy" },
        27 => { return "File too large" },
        28 => { return "No space left on device" },
        29 => { return "Illegal seek" },
        30 => { return "Read-only file system" },
        31 => { return "Too many links" },
        32 => { return "Broken pipe" },
        33 => { return "Numerical argument out of domain" },
        34 => { return "Numerical result out of range" },
        35 => { return "Resource deadlock avoided" },
        36 => { return "File name too long" },
        37 => { return "No locks available" },
        38 => { return "Function not implemented" },
        39 => { return "Directory not empty" },
        40 => { return "Too many levels of symbolic links" },
        42 => { return "No message of desired type" },
        43 => { return "Identifier removed" },
        44 => { return "Channel number out of range" },
        45 => { return "Level 2 not synchronized" },
        46 => { return "Level 3 halted" },
        47 => { return "Level 3 reset" },
        48 => { return "Link number out of range" },
        49 => { return "Protocol driver not attached" },
        50 => { return "No CSI structure available" },
        51 => { return "Level 2 halted" },
        52 => { return "Invalid exchange" },
        53 => { return "Invalid request descriptor" },
        54 => { return "Exchange full" },
        55 => { return "No anode" },
        56 => { return "Invalid request code" },
        57 => { return "Invalid slot" },
        59 => { return "Bad font file format" },
        60 => { return "Device not a stream" },
        61 => { return "No data available" },
        62 => { return "Timer expired" },
        63 => { return "Out of streams resources" },
        64 => { return "Machine is not on the network" },
        65 => { return "Package not installed" },
        66 => { return "Object is remote" },
        67 => { return "Link has been severed" },
        68 => { return "Advertise error" },
        69 => { return "Srmount error" },
        70 => { return "Communication error on send" },
        71 => { return "Protocol error" },
        72 => { return "Multihop attempted" },
        73 => { return "RFS specific error" },
        74 => { return "Bad message" },
        75 => { return "Value too large for defined data type" },
        76 => { return "Name not unique on network" },
        77 => { return "File descriptor in bad state" },
        78 => { return "Remote address changed" },
        79 => { return "Can not access a needed shared library" },
        80 => { return "Accessing a corrupted shared library" },
        81 => { return ".lib section in a.out corrupted" },
        82 => { return "Attempting to link in too many shared libraries" },
        83 => { return "Cannot exec a shared library directly" },
        84 => { return "Invalid or incomplete multibyte or wide character" },
        85 => { return "Interrupted system call should be restarted" },
        86 => { return "Streams pipe error" },
        87 => { return "Too many users" },
        88 => { return "Socket operation on non-socket" },
        89 => { return "Destination address required" },
        90 => { return "Message too long" },
        91 => { return "Protocol wrong type for socket" },
        92 => { return "Protocol not available" },
        93 => { return "Protocol not supported" },
        94 => { return "Socket type not supported" },
        95 => { return "Operation not supported" },
        96 => { return "Protocol family not supported" },
        97 => { return "Address family not supported by protocol" },
        98 => { return "Address already in use" },
        99 => { return "Cannot assign requested address" },
        100 => { return "Network is down" },
        101 => { return "Network is unreachable" },
        102 => { return "Network dropped connection on reset" },
        103 => { return "Software caused connection abort" },
        104 => { return "Connection reset by peer" },
        105 => { return "No buffer space available" },
        106 => { return "Transport endpoint is already connected" },
        107 => { return "Transport endpoint is not connected" },
        108 => { return "Cannot send after transport endpoint shutdown" },
        109 => { return "Too many references: cannot splice" },
        110 => { return "Connection timed out" },
        111 => { return "Connection refused" },
        112 => { return "Host is down" },
        113 => { return "No route to host" },
        114 => { return "Operation already in progress" },
        115 => { return "Operation now in progress" },
        116 => { return "Stale file handle" },
        117 => { return "Structure needs cleaning" },
        118 => { return "Not a XENIX named type file" },
        119 => { return "No XENIX semaphores available" },
        120 => { return "Is a named type file" },
        121 => { return "Remote I/O error" },
        122 => { return "Disk quota exceeded" },
        123 => { return "No medium found" },
        124 => { return "Wrong medium type" },
        125 => { return "Operation canceled" },
        126 => { return "Required key not available" },
        127 => { return "Key has expired" },
        128 => { return "Key has been revoked" },
        129 => { return "Key was rejected by service" },
        130 => { return "Owner died" },
        131 => { return "State not recoverable" },
        132 => { return "Operation not possible due to RF-kill" },
        133 => { return "Memory page has hardware error" },
        else => { return "" },
    }
}

var unknownMessage: [64]u8 = undefined

fn unknown(code: i32) -> usize {
    // "Unknown error N", as glibc words it.
    const prefix = "Unknown error "
    var at: usize = 0
    while at < prefix.length {
        unknownMessage[at] = prefix[at]
        at += 1
    }
    var magnitude: u64 = if code < 0 { @intCast(u64, 0 - @intCast(i64, code)) } else { @intCast(u64, code) }
    if code < 0 {
        unknownMessage[at] = 45
        at += 1
    }
    var digits: [24]u8 = undefined
    var count: usize = 0
    while true {
        digits[count] = @intCast(u8, 48 + magnitude % 10)
        count += 1
        magnitude /= 10
        if magnitude == 0 { break }
    }
    while count > 0 {
        count -= 1
        unknownMessage[at] = digits[count]
        at += 1
    }
    unknownMessage[at] = 0
    return @intFromPtr(&unknownMessage)
}

// A NUL-terminated copy of every message, made on demand (the slices above
// are the literal's bytes with a NUL after them already; the table keeps
// the addresses C may hold on to).
pub export fn strerror(code: i32) -> usize {
    const text = message(code)
    if text.length == 0 { return unknown(code) }
    return sys.literal(text)
}

// The XSI strerror_r (the symbol glibc's headers pick without _GNU_SOURCE):
// the text into the buffer, 0 or an error code.
pub export fn __xpg_strerror_r(code: i32, buffer: usize, size: usize) -> i32 {
    const text = message(code)
    if text.length == 0 {
        const copied = strlcpy(buffer, unknown(code), size)
        return sys.EINVAL
    }
    if size == 0 { return sys.ERANGE }
    const copied = if text.length < size - 1 { text.length } else { size - 1 }
    sys.copy(buffer, sys.literal(text), copied)
    sys.put8(buffer + copied, 0)
    return if copied < text.length { sys.ERANGE } else { 0 }
}

// glibc's own strerror_r (the symbol with _GNU_SOURCE) returns the text:
// the table's string, or the unknown-code text written into the buffer.
pub export fn strerror_r(code: i32, buffer: usize, size: usize) -> usize {
    const text = message(code)
    if text.length != 0 { return sys.literal(text) }
    const copied = strlcpy(buffer, unknown(code), size)
    return buffer
}

pub export fn __strerror_r(code: i32, buffer: usize, size: usize) -> usize { return strerror_r(code, buffer, size) }

pub export fn strsignal(number: i32) -> usize {
    match number {
        1 => { return sys.literal("Hangup") },
        2 => { return sys.literal("Interrupt") },
        3 => { return sys.literal("Quit") },
        4 => { return sys.literal("Illegal instruction") },
        5 => { return sys.literal("Trace/breakpoint trap") },
        6 => { return sys.literal("Aborted") },
        7 => { return sys.literal("Bus error") },
        8 => { return sys.literal("Floating point exception") },
        9 => { return sys.literal("Killed") },
        10 => { return sys.literal("User defined signal 1") },
        11 => { return sys.literal("Segmentation fault") },
        12 => { return sys.literal("User defined signal 2") },
        13 => { return sys.literal("Broken pipe") },
        14 => { return sys.literal("Alarm clock") },
        15 => { return sys.literal("Terminated") },
        17 => { return sys.literal("Child exited") },
        18 => { return sys.literal("Continued") },
        19 => { return sys.literal("Stopped (signal)") },
        20 => { return sys.literal("Stopped") },
        else => { return sys.literal("Unknown signal") },
    }
}
