// unistd.h, fcntl.h, sys/stat.h, sys/mman.h, sys/socket.h, poll.h,
// sys/epoll.h, dirent.h and the rest of the system-call surface: each
// function is its system call, with the result turned into C's -1 and
// errno. The structures (stat, dirent, sockaddr, pollfd, epoll_event,
// rlimit, rusage, utsname) are the kernel's own on x86_64, which glibc's
// headers describe the same way, so they pass through unchanged.
const sys = @import("./sys.mlx")
const errno = @import("./errno.mlx")
const heap = @import("./heap.mlx")
const string = @import("./string.mlx")
const stdlib = @import("./stdlib.mlx")

fn u(value: i32) -> usize { return sys.int(value) }

// --- descriptors ---------------------------------------------------------

pub export fn open(path: usize, flags: i32, mode: u32) -> i32 { return errno.checkInt(sys.syscall4(sys.SYS_openat, u(-100), path, u(flags), @intCast(usize, mode))) }
pub export fn open64(path: usize, flags: i32, mode: u32) -> i32 { return open(path, flags, mode) }
pub export fn __open_2(path: usize, flags: i32) -> i32 { return open(path, flags, 0) }
pub export fn openat(directory: i32, path: usize, flags: i32, mode: u32) -> i32 { return errno.checkInt(sys.syscall4(sys.SYS_openat, u(directory), path, u(flags), @intCast(usize, mode))) }
pub export fn openat64(directory: i32, path: usize, flags: i32, mode: u32) -> i32 { return openat(directory, path, flags, mode) }
pub export fn __openat_2(directory: i32, path: usize, flags: i32) -> i32 { return openat(directory, path, flags, 0) }
pub export fn creat(path: usize, mode: u32) -> i32 { return open(path, 1 | 64 | 512, mode) }
pub export fn creat64(path: usize, mode: u32) -> i32 { return creat(path, mode) }
pub export fn close(descriptor: i32) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_close, u(descriptor))) }
pub export fn close_range(first: u32, last: u32, flags: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_close_range, @intCast(usize, first), @intCast(usize, last), @intCast(usize, flags))) }
pub export fn read(descriptor: i32, buffer: usize, count: usize) -> isize { return errno.check(sys.syscall3(sys.SYS_read, u(descriptor), buffer, count)) }
pub export fn write(descriptor: i32, buffer: usize, count: usize) -> isize { return errno.check(sys.syscall3(sys.SYS_write, u(descriptor), buffer, count)) }
pub export fn pread(descriptor: i32, buffer: usize, count: usize, offset: i64) -> isize { return errno.check(sys.syscall4(sys.SYS_pread64, u(descriptor), buffer, count, @bitCast(usize, offset))) }
pub export fn pwrite(descriptor: i32, buffer: usize, count: usize, offset: i64) -> isize { return errno.check(sys.syscall4(sys.SYS_pwrite64, u(descriptor), buffer, count, @bitCast(usize, offset))) }
pub export fn pread64(descriptor: i32, buffer: usize, count: usize, offset: i64) -> isize { return pread(descriptor, buffer, count, offset) }
pub export fn pwrite64(descriptor: i32, buffer: usize, count: usize, offset: i64) -> isize { return pwrite(descriptor, buffer, count, offset) }
pub export fn readv(descriptor: i32, vectors: usize, count: i32) -> isize { return errno.check(sys.syscall3(sys.SYS_readv, u(descriptor), vectors, u(count))) }
pub export fn writev(descriptor: i32, vectors: usize, count: i32) -> isize { return errno.check(sys.syscall3(sys.SYS_writev, u(descriptor), vectors, u(count))) }
pub export fn preadv(descriptor: i32, vectors: usize, count: i32, offset: i64) -> isize { return errno.check(sys.syscall5(sys.SYS_preadv, u(descriptor), vectors, u(count), @bitCast(usize, offset) & 4294967295, @bitCast(usize, offset) >> 32)) }
pub export fn pwritev(descriptor: i32, vectors: usize, count: i32, offset: i64) -> isize { return errno.check(sys.syscall5(sys.SYS_pwritev, u(descriptor), vectors, u(count), @bitCast(usize, offset) & 4294967295, @bitCast(usize, offset) >> 32)) }
pub export fn lseek(descriptor: i32, offset: i64, whence: i32) -> i64 { return @intCast(i64, errno.check(sys.syscall3(sys.SYS_lseek, u(descriptor), @bitCast(usize, offset), u(whence)))) }
pub export fn lseek64(descriptor: i32, offset: i64, whence: i32) -> i64 { return lseek(descriptor, offset, whence) }
pub export fn dup(descriptor: i32) -> i32 { return errno.checkInt(sys.syscall1(sys.SYS_dup, u(descriptor))) }
pub export fn dup2(descriptor: i32, target: i32) -> i32 { return errno.checkInt(sys.syscall2(sys.SYS_dup2, u(descriptor), u(target))) }
pub export fn dup3(descriptor: i32, target: i32, flags: i32) -> i32 { return errno.checkInt(sys.syscall3(sys.SYS_dup3, u(descriptor), u(target), u(flags))) }
pub export fn pipe(descriptors: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_pipe2, descriptors, 0)) }
pub export fn pipe2(descriptors: usize, flags: i32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_pipe2, descriptors, u(flags))) }
pub export fn fcntl(descriptor: i32, command: i32, argument: usize) -> i32 { return errno.checkInt(sys.syscall3(sys.SYS_fcntl, u(descriptor), u(command), argument)) }
pub export fn fcntl64(descriptor: i32, command: i32, argument: usize) -> i32 { return fcntl(descriptor, command, argument) }
pub export fn ioctl(descriptor: i32, request: u64, argument: usize) -> i32 { return errno.checkInt(sys.syscall3(sys.SYS_ioctl, u(descriptor), @intCast(usize, request), argument)) }
pub export fn flock(descriptor: i32, operation: i32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_flock, u(descriptor), u(operation))) }
pub export fn fsync(descriptor: i32) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_fsync, u(descriptor))) }
pub export fn fdatasync(descriptor: i32) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_fdatasync, u(descriptor))) }
pub export fn sync() -> void { const synced = sys.syscall0(sys.SYS_sync) }
pub export fn syncfs(descriptor: i32) -> i32 { return errno.checkStatus(sys.syscall1(306, u(descriptor))) }
pub export fn ftruncate(descriptor: i32, length: i64) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_ftruncate, u(descriptor), @bitCast(usize, length))) }
pub export fn ftruncate64(descriptor: i32, length: i64) -> i32 { return ftruncate(descriptor, length) }
pub export fn truncate(path: usize, length: i64) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_truncate, path, @bitCast(usize, length))) }
pub export fn truncate64(path: usize, length: i64) -> i32 { return truncate(path, length) }
pub export fn fallocate(descriptor: i32, mode: i32, offset: i64, length: i64) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_fallocate, u(descriptor), u(mode), @bitCast(usize, offset), @bitCast(usize, length))) }
pub export fn posix_fallocate(descriptor: i32, offset: i64, length: i64) -> i32 { return errno.code(sys.syscall4(sys.SYS_fallocate, u(descriptor), 0, @bitCast(usize, offset), @bitCast(usize, length))) }
pub export fn posix_fadvise(descriptor: i32, offset: i64, length: i64, advice: i32) -> i32 { return errno.code(sys.syscall4(221, u(descriptor), @bitCast(usize, offset), @bitCast(usize, length), u(advice))) }
pub export fn sendfile(target: i32, source: i32, offset: usize, count: usize) -> isize { return errno.check(sys.syscall4(sys.SYS_sendfile, u(target), u(source), offset, count)) }
pub export fn copy_file_range(source: i32, source_offset: usize, target: i32, target_offset: usize, count: usize, flags: u32) -> isize { return errno.check(sys.syscall6(326, u(source), source_offset, u(target), target_offset, count, @intCast(usize, flags))) }
pub export fn splice(source: i32, source_offset: usize, target: i32, target_offset: usize, count: usize, flags: u32) -> isize { return errno.check(sys.syscall6(275, u(source), source_offset, u(target), target_offset, count, @intCast(usize, flags))) }

pub export fn isatty(descriptor: i32) -> i32 {
    var termios: [64]u8 = undefined
    const asked = sys.syscall3(sys.SYS_ioctl, u(descriptor), 21505, @intFromPtr(&termios))
    if sys.failed(asked) {
        errno.set(if asked == -25 { sys.ENOTTY } else { @intCast(i32, 0 - asked) })
        return 0
    }
    return 1
}

pub export fn ttyname_r(descriptor: i32, buffer: usize, size: usize) -> i32 {
    if isatty(descriptor) == 0 { return sys.ENOTTY }
    var path: [32]u8 = undefined
    const prefix = "/proc/self/fd/"
    var at: usize = 0
    while at < prefix.length {
        path[at] = prefix[at]
        at += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var value = @intCast(u32, descriptor)
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value /= 10
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        path[at] = digits[count]
        at += 1
    }
    path[at] = 0
    const got = sys.syscall3(sys.SYS_readlink, @intFromPtr(&path), buffer, size)
    if sys.failed(got) { return @intCast(i32, 0 - got) }
    if @bitCast(usize, got) >= size { return sys.ERANGE }
    sys.put8(buffer + @bitCast(usize, got), 0)
    return 0
}

var ttyNameBuffer: [128]u8 = undefined

pub export fn ttyname(descriptor: i32) -> usize {
    const status = ttyname_r(descriptor, @intFromPtr(&ttyNameBuffer), 128)
    if status != 0 {
        errno.set(status)
        return 0
    }
    return @intFromPtr(&ttyNameBuffer)
}

// --- files and directories -------------------------------------------------

pub export fn access(path: usize, mode: i32) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_faccessat, u(-100), path, u(mode), 0)) }
pub export fn faccessat(directory: i32, path: usize, mode: i32, flags: i32) -> i32 {
    if flags == 0 { return errno.checkStatus(sys.syscall3(sys.SYS_faccessat, u(directory), path, u(mode))) }
    return errno.checkStatus(sys.syscall4(sys.SYS_faccessat2, u(directory), path, u(mode), u(flags)))
}
pub export fn euidaccess(path: usize, mode: i32) -> i32 { return faccessat(-100, path, mode, 512) }
pub export fn eaccess(path: usize, mode: i32) -> i32 { return euidaccess(path, mode) }
pub export fn stat(path: usize, buffer: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_newfstatat, u(-100), path, buffer, 0)) }
pub export fn lstat(path: usize, buffer: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_newfstatat, u(-100), path, buffer, 256)) }
pub export fn fstat(descriptor: i32, buffer: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_fstat, u(descriptor), buffer)) }
pub export fn fstatat(directory: i32, path: usize, buffer: usize, flags: i32) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_newfstatat, u(directory), path, buffer, u(flags))) }
pub export fn stat64(path: usize, buffer: usize) -> i32 { return stat(path, buffer) }
pub export fn lstat64(path: usize, buffer: usize) -> i32 { return lstat(path, buffer) }
pub export fn fstat64(descriptor: i32, buffer: usize) -> i32 { return fstat(descriptor, buffer) }
pub export fn fstatat64(directory: i32, path: usize, buffer: usize, flags: i32) -> i32 { return fstatat(directory, path, buffer, flags) }
pub export fn __xstat(version: i32, path: usize, buffer: usize) -> i32 { return stat(path, buffer) }
pub export fn __lxstat(version: i32, path: usize, buffer: usize) -> i32 { return lstat(path, buffer) }
pub export fn __fxstat(version: i32, descriptor: i32, buffer: usize) -> i32 { return fstat(descriptor, buffer) }
pub export fn __fxstatat(version: i32, directory: i32, path: usize, buffer: usize, flags: i32) -> i32 { return fstatat(directory, path, buffer, flags) }
pub export fn __xstat64(version: i32, path: usize, buffer: usize) -> i32 { return stat(path, buffer) }
pub export fn __lxstat64(version: i32, path: usize, buffer: usize) -> i32 { return lstat(path, buffer) }
pub export fn __fxstat64(version: i32, descriptor: i32, buffer: usize) -> i32 { return fstat(descriptor, buffer) }
pub export fn __fxstatat64(version: i32, directory: i32, path: usize, buffer: usize, flags: i32) -> i32 { return fstatat(directory, path, buffer, flags) }
pub export fn statx(directory: i32, path: usize, flags: i32, mask: u32, buffer: usize) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_statx, u(directory), path, u(flags), @intCast(usize, mask), buffer)) }
pub export fn statfs(path: usize, buffer: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_statfs, path, buffer)) }
pub export fn fstatfs(descriptor: i32, buffer: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_fstatfs, u(descriptor), buffer)) }
pub export fn statfs64(path: usize, buffer: usize) -> i32 { return statfs(path, buffer) }
pub export fn fstatfs64(descriptor: i32, buffer: usize) -> i32 { return fstatfs(descriptor, buffer) }

// statvfs from statfs: the fields in POSIX's order.
fn convertStatvfs(from: usize, to: usize) -> void {
    const block_size = sys.get64(from + 8)
    const fragment = sys.get64(from + 88)
    sys.put64(to, block_size)
    sys.put64(to + 8, if fragment == 0 { block_size } else { fragment })
    sys.put64(to + 16, sys.get64(from + 16))
    sys.put64(to + 24, sys.get64(from + 24))
    sys.put64(to + 32, sys.get64(from + 32))
    sys.put64(to + 40, sys.get64(from + 40))
    sys.put64(to + 48, sys.get64(from + 48))
    sys.put64(to + 56, sys.get64(from + 48))
    sys.put64(to + 64, sys.get64(from + 56) & 4294967295)
    sys.put64(to + 72, sys.get64(from + 96))
    sys.put64(to + 80, sys.get64(from + 80))
    sys.fill(to + 88, 0, 24)
}

pub export fn statvfs(path: usize, buffer: usize) -> i32 {
    var raw: [120]u8 = undefined
    const status = statfs(path, @intFromPtr(&raw))
    if status == 0 { convertStatvfs(@intFromPtr(&raw), buffer) }
    return status
}

pub export fn fstatvfs(descriptor: i32, buffer: usize) -> i32 {
    var raw: [120]u8 = undefined
    const status = fstatfs(descriptor, @intFromPtr(&raw))
    if status == 0 { convertStatvfs(@intFromPtr(&raw), buffer) }
    return status
}

pub export fn statvfs64(path: usize, buffer: usize) -> i32 { return statvfs(path, buffer) }
pub export fn fstatvfs64(descriptor: i32, buffer: usize) -> i32 { return fstatvfs(descriptor, buffer) }

pub export fn chdir(path: usize) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_chdir, path)) }
pub export fn fchdir(descriptor: i32) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_fchdir, u(descriptor))) }
pub export fn chroot(path: usize) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_chroot, path)) }

pub export fn getcwd(buffer: usize, size: usize) -> usize {
    var target = buffer
    var room = size
    if target == 0 {
        room = if size == 0 { 4096 } else { size }
        target = heap.allocate(room, 16)
        if target == 0 { return 0 }
    } else if size == 0 {
        errno.set(sys.EINVAL)
        return 0
    }
    const got = sys.syscall2(sys.SYS_getcwd, target, room)
    if sys.failed(got) {
        if buffer == 0 { heap.release(target) }
        errno.set(@intCast(i32, 0 - got))
        return 0
    }
    return target
}

pub export fn get_current_dir_name() -> usize { return getcwd(0, 0) }
pub export fn getwd(buffer: usize) -> usize { return getcwd(buffer, 4096) }

pub export fn mkdir(path: usize, mode: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_mkdirat, u(-100), path, @intCast(usize, mode))) }
pub export fn mkdirat(directory: i32, path: usize, mode: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_mkdirat, u(directory), path, @intCast(usize, mode))) }
pub export fn rmdir(path: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_unlinkat, u(-100), path, 512)) }
pub export fn unlink(path: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_unlinkat, u(-100), path, 0)) }
pub export fn unlinkat(directory: i32, path: usize, flags: i32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_unlinkat, u(directory), path, u(flags))) }
pub export fn rename(from: usize, to: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_renameat, u(-100), from, u(-100), to)) }
pub export fn renameat(from_directory: i32, from: usize, to_directory: i32, to: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_renameat, u(from_directory), from, u(to_directory), to)) }
pub export fn renameat2(from_directory: i32, from: usize, to_directory: i32, to: usize, flags: u32) -> i32 { return errno.checkStatus(sys.syscall5(316, u(from_directory), from, u(to_directory), to, @intCast(usize, flags))) }
pub export fn link(from: usize, to: usize) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_linkat, u(-100), from, u(-100), to, 0)) }
pub export fn linkat(from_directory: i32, from: usize, to_directory: i32, to: usize, flags: i32) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_linkat, u(from_directory), from, u(to_directory), to, u(flags))) }
pub export fn symlink(target: usize, path: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_symlinkat, target, u(-100), path)) }
pub export fn symlinkat(target: usize, directory: i32, path: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_symlinkat, target, u(directory), path)) }
pub export fn readlink(path: usize, buffer: usize, size: usize) -> isize { return errno.check(sys.syscall4(sys.SYS_readlinkat, u(-100), path, buffer, size)) }
pub export fn readlinkat(directory: i32, path: usize, buffer: usize, size: usize) -> isize { return errno.check(sys.syscall4(sys.SYS_readlinkat, u(directory), path, buffer, size)) }
pub export fn chmod(path: usize, mode: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_fchmodat, u(-100), path, @intCast(usize, mode))) }
pub export fn fchmod(descriptor: i32, mode: u32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_fchmod, u(descriptor), @intCast(usize, mode))) }
pub export fn fchmodat(directory: i32, path: usize, mode: u32, flags: i32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_fchmodat, u(directory), path, @intCast(usize, mode))) }
pub export fn chown(path: usize, owner: u32, group: u32) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_fchownat, u(-100), path, @intCast(usize, owner), @intCast(usize, group), 0)) }
pub export fn lchown(path: usize, owner: u32, group: u32) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_fchownat, u(-100), path, @intCast(usize, owner), @intCast(usize, group), 256)) }
pub export fn fchown(descriptor: i32, owner: u32, group: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_fchown, u(descriptor), @intCast(usize, owner), @intCast(usize, group))) }
pub export fn fchownat(directory: i32, path: usize, owner: u32, group: u32, flags: i32) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_fchownat, u(directory), path, @intCast(usize, owner), @intCast(usize, group), u(flags))) }
pub export fn umask(mask: u32) -> u32 { return @intCast(u32, sys.syscall1(sys.SYS_umask, @intCast(usize, mask))) }
pub export fn mknod(path: usize, mode: u32, device: u64) -> i32 { return errno.checkStatus(sys.syscall4(259, u(-100), path, @intCast(usize, mode), @intCast(usize, device))) }
pub export fn mknodat(directory: i32, path: usize, mode: u32, device: u64) -> i32 { return errno.checkStatus(sys.syscall4(259, u(directory), path, @intCast(usize, mode), @intCast(usize, device))) }
pub export fn mkfifo(path: usize, mode: u32) -> i32 { return mknod(path, mode | 4096, 0) }
pub export fn mkfifoat(directory: i32, path: usize, mode: u32) -> i32 { return mknodat(directory, path, mode | 4096, 0) }
pub export fn utimensat(directory: i32, path: usize, times: usize, flags: i32) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_utimensat, u(directory), path, times, u(flags))) }
pub export fn futimens(descriptor: i32, times: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_utimensat, u(descriptor), 0, times, 0)) }
pub export fn utimes(path: usize, times: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_utimes, path, times)) }
pub export fn futimes(descriptor: i32, times: usize) -> i32 {
    if times == 0 { return futimens(descriptor, 0) }
    var spec: [4]i64 = [4]i64{ @bitCast(i64, sys.get64(times)), @bitCast(i64, sys.get64(times + 8)) * 1000, @bitCast(i64, sys.get64(times + 16)), @bitCast(i64, sys.get64(times + 24)) * 1000 }
    return futimens(descriptor, @intFromPtr(&spec))
}
pub export fn pathconf(path: usize, name: i32) -> i64 { return fpathconf(0, name) }
pub export fn fpathconf(descriptor: i32, name: i32) -> i64 {
    match name {
        0 => { return 127 },
        1 => { return 255 },
        2 => { return 255 },
        3 => { return 255 },
        4 => { return 4096 },
        5 => { return 4096 },
        6 => { return 1 },
        7 => { return 1 },
        8 => { return 0 },
        else => {
            errno.set(sys.EINVAL)
            return -1
        },
    }
}

// Directories: DIR is the descriptor, a 4 KiB buffer of getdents64 entries
// (struct dirent as the kernel writes it), and the position in it.
const DIR_FD: usize = 0
const DIR_POSITION: usize = 8
const DIR_LENGTH: usize = 16
const DIR_BUFFER: usize = 24
const DIR_BUFFER_SIZE: usize = 4096

pub export fn fdopendir(descriptor: i32) -> usize {
    const directory = heap.allocate(DIR_BUFFER + DIR_BUFFER_SIZE, 16)
    if directory == 0 { return 0 }
    sys.putI32(directory + DIR_FD, descriptor)
    sys.putPointer(directory + DIR_POSITION, 0)
    sys.putPointer(directory + DIR_LENGTH, 0)
    return directory
}

pub export fn opendir(path: usize) -> usize {
    // O_RDONLY | O_DIRECTORY | O_CLOEXEC
    const descriptor = open(path, 65536 | 524288, 0)
    if descriptor < 0 { return 0 }
    const directory = fdopendir(descriptor)
    if directory == 0 { const closed = close(descriptor) }
    return directory
}

pub export fn closedir(directory: usize) -> i32 {
    if directory == 0 { return errno.failWith(sys.EINVAL) }
    const descriptor = sys.getI32(directory + DIR_FD)
    heap.release(directory)
    return close(descriptor)
}

pub export fn dirfd(directory: usize) -> i32 { return sys.getI32(directory + DIR_FD) }

pub export fn readdir(directory: usize) -> usize {
    if directory == 0 { return 0 }
    var position = sys.getPointer(directory + DIR_POSITION)
    var length = sys.getPointer(directory + DIR_LENGTH)
    if position >= length {
        const got = sys.syscall3(sys.SYS_getdents64, u(sys.getI32(directory + DIR_FD)), directory + DIR_BUFFER, DIR_BUFFER_SIZE)
        if sys.failed(got) {
            errno.set(@intCast(i32, 0 - got))
            return 0
        }
        if got == 0 { return 0 }
        length = @bitCast(usize, got)
        position = 0
        sys.putPointer(directory + DIR_LENGTH, length)
    }
    const entry = directory + DIR_BUFFER + position
    // d_reclen at offset 16 of struct dirent.
    sys.putPointer(directory + DIR_POSITION, position + @intCast(usize, sys.get16(entry + 16)))
    return entry
}

pub export fn readdir64(directory: usize) -> usize { return readdir(directory) }

pub export fn readdir_r(directory: usize, entry: usize, result: usize) -> i32 {
    errno.set(0)
    const next = readdir(directory)
    if next == 0 {
        sys.putPointer(result, 0)
        return errno.get()
    }
    sys.copy(entry, next, @intCast(usize, sys.get16(next + 16)))
    sys.putPointer(result, entry)
    return 0
}

pub export fn rewinddir(directory: usize) -> void {
    const sought = sys.syscall3(sys.SYS_lseek, u(sys.getI32(directory + DIR_FD)), 0, 0)
    sys.putPointer(directory + DIR_POSITION, 0)
    sys.putPointer(directory + DIR_LENGTH, 0)
}

pub export fn telldir(directory: usize) -> i64 {
    const position = sys.getPointer(directory + DIR_POSITION)
    const length = sys.getPointer(directory + DIR_LENGTH)
    if position < length { return @bitCast(i64, sys.get64(directory + DIR_BUFFER + position + 8)) }
    return lseek(sys.getI32(directory + DIR_FD), 0, 1)
}

pub export fn seekdir(directory: usize, offset: i64) -> void {
    const sought = sys.syscall3(sys.SYS_lseek, u(sys.getI32(directory + DIR_FD)), @bitCast(usize, offset), 0)
    sys.putPointer(directory + DIR_POSITION, 0)
    sys.putPointer(directory + DIR_LENGTH, 0)
}

pub export fn alphasort(first: usize, second: usize) -> i32 { return string.strcoll(sys.getPointer(first) + 19, sys.getPointer(second) + 19) }

pub export fn scandir(path: usize, list: usize, filter: usize, compare: usize) -> i32 {
    const directory = opendir(path)
    if directory == 0 { return -1 }
    var entries: usize = 0
    var count: usize = 0
    var capacity: usize = 0
    while true {
        const entry = readdir(directory)
        if entry == 0 { break }
        if filter != 0 && sys.compare2(filter, entry, 0) == 0 { continue }
        const size = @intCast(usize, sys.get16(entry + 16))
        const copy = heap.allocate(size, 16)
        if copy == 0 { break }
        sys.copy(copy, entry, size)
        if count == capacity {
            const grown = heap.allocate((capacity * 2 + 16) * 8, 16)
            if grown == 0 { break }
            if entries != 0 {
                sys.copy(grown, entries, count * 8)
                heap.release(entries)
            }
            entries = grown
            capacity = capacity * 2 + 16
        }
        sys.putPointer(entries + count * 8, copy)
        count += 1
    }
    const closed = closedir(directory)
    if compare != 0 && entries != 0 { stdlib.qsort(entries, count, 8, compare) }
    sys.putPointer(list, entries)
    return @intCast(i32, count)
}

pub export fn getdents64(descriptor: i32, buffer: usize, count: usize) -> isize { return errno.check(sys.syscall3(sys.SYS_getdents64, u(descriptor), buffer, count)) }

// --- memory ------------------------------------------------------------------

pub export fn mmap(address: usize, length: usize, prot: i32, flags: i32, descriptor: i32, offset: i64) -> usize {
    const mapped = sys.syscall6(sys.SYS_mmap, address, length, u(prot), u(flags), u(descriptor), @bitCast(usize, offset))
    if sys.failed(mapped) {
        errno.set(@intCast(i32, 0 - mapped))
        return sys.MAP_FAILED
    }
    return @bitCast(usize, mapped)
}
pub export fn mmap64(address: usize, length: usize, prot: i32, flags: i32, descriptor: i32, offset: i64) -> usize { return mmap(address, length, prot, flags, descriptor, offset) }
pub export fn munmap(address: usize, length: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_munmap, address, length)) }
pub export fn mprotect(address: usize, length: usize, prot: i32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_mprotect, address, length, u(prot))) }
pub export fn msync(address: usize, length: usize, flags: i32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_msync, address, length, u(flags))) }
pub export fn madvise(address: usize, length: usize, advice: i32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_madvise, address, length, u(advice))) }
pub export fn posix_madvise(address: usize, length: usize, advice: i32) -> i32 { return errno.code(sys.syscall3(sys.SYS_madvise, address, length, u(advice))) }
pub export fn mremap(address: usize, old_length: usize, new_length: usize, flags: i32, new_address: usize) -> usize {
    const moved = sys.syscall5(sys.SYS_mremap, address, old_length, new_length, u(flags), new_address)
    if sys.failed(moved) {
        errno.set(@intCast(i32, 0 - moved))
        return sys.MAP_FAILED
    }
    return @bitCast(usize, moved)
}
pub export fn mlock(address: usize, length: usize) -> i32 { return errno.checkStatus(sys.syscall2(149, address, length)) }
pub export fn munlock(address: usize, length: usize) -> i32 { return errno.checkStatus(sys.syscall2(150, address, length)) }
pub export fn mlockall(flags: i32) -> i32 { return errno.checkStatus(sys.syscall1(151, u(flags))) }
pub export fn munlockall() -> i32 { return errno.checkStatus(sys.syscall0(152)) }
pub export fn memfd_create(name: usize, flags: u32) -> i32 { return errno.checkInt(sys.syscall2(sys.SYS_memfd_create, name, @intCast(usize, flags))) }
pub export fn getpagesize() -> i32 { return 4096 }

pub export fn brk(address: usize) -> i32 {
    const result = sys.syscall1(sys.SYS_brk, address)
    if @bitCast(usize, result) < address { return errno.failWith(sys.ENOMEM) }
    return 0
}

pub export fn sbrk(increment: isize) -> usize {
    const current = @bitCast(usize, sys.syscall1(sys.SYS_brk, 0))
    if increment == 0 { return current }
    const wanted = if increment < 0 { current - @bitCast(usize, 0 - increment) } else { current + @bitCast(usize, increment) }
    const result = @bitCast(usize, sys.syscall1(sys.SYS_brk, wanted))
    if result != wanted {
        errno.set(sys.ENOMEM)
        return sys.MAP_FAILED
    }
    return current
}

// --- processes ---------------------------------------------------------------

pub export fn getpid() -> i32 { return @intCast(i32, sys.syscall0(sys.SYS_getpid)) }
pub export fn getppid() -> i32 { return @intCast(i32, sys.syscall0(sys.SYS_getppid)) }
pub export fn gettid() -> i32 { return @intCast(i32, sys.syscall0(sys.SYS_gettid)) }
pub export fn getuid() -> u32 { return @intCast(u32, sys.syscall0(sys.SYS_getuid)) }
pub export fn geteuid() -> u32 { return @intCast(u32, sys.syscall0(sys.SYS_geteuid)) }
pub export fn getgid() -> u32 { return @intCast(u32, sys.syscall0(sys.SYS_getgid)) }
pub export fn getegid() -> u32 { return @intCast(u32, sys.syscall0(sys.SYS_getegid)) }
pub export fn setuid(identifier: u32) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_setuid, @intCast(usize, identifier))) }
pub export fn setgid(identifier: u32) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_setgid, @intCast(usize, identifier))) }
pub export fn seteuid(identifier: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_setresuid, 4294967295, @intCast(usize, identifier), 4294967295)) }
pub export fn setegid(identifier: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_setresgid, 4294967295, @intCast(usize, identifier), 4294967295)) }
pub export fn setreuid(real: u32, effective: u32) -> i32 { return errno.checkStatus(sys.syscall2(113, @intCast(usize, real), @intCast(usize, effective))) }
pub export fn setregid(real: u32, effective: u32) -> i32 { return errno.checkStatus(sys.syscall2(114, @intCast(usize, real), @intCast(usize, effective))) }
pub export fn setresuid(real: u32, effective: u32, saved: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_setresuid, @intCast(usize, real), @intCast(usize, effective), @intCast(usize, saved))) }
pub export fn setresgid(real: u32, effective: u32, saved: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_setresgid, @intCast(usize, real), @intCast(usize, effective), @intCast(usize, saved))) }
pub export fn getresuid(real: usize, effective: usize, saved: usize) -> i32 { return errno.checkStatus(sys.syscall3(118, real, effective, saved)) }
pub export fn getresgid(real: usize, effective: usize, saved: usize) -> i32 { return errno.checkStatus(sys.syscall3(120, real, effective, saved)) }
pub export fn getgroups(count: i32, list: usize) -> i32 { return errno.checkInt(sys.syscall2(sys.SYS_getgroups, u(count), list)) }
pub export fn setgroups(count: usize, list: usize) -> i32 { return errno.checkStatus(sys.syscall2(116, count, list)) }
pub export fn setpgid(process: i32, group: i32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_setpgid, u(process), u(group))) }
pub export fn getpgid(process: i32) -> i32 { return errno.checkInt(sys.syscall1(sys.SYS_getpgid, u(process))) }
pub export fn getpgrp() -> i32 { return @intCast(i32, sys.syscall0(sys.SYS_getpgrp)) }
pub export fn setpgrp() -> i32 { return setpgid(0, 0) }
pub export fn setsid() -> i32 { return errno.checkInt(sys.syscall0(sys.SYS_setsid)) }
pub export fn getsid(process: i32) -> i32 { return errno.checkInt(sys.syscall1(124, u(process))) }
pub export fn getpriority(which: i32, who: u32) -> i32 {
    const got = sys.syscall2(140, u(which), @intCast(usize, who))
    if sys.failed(got) { return errno.checkInt(got) }
    return 20 - @intCast(i32, got)
}
pub export fn setpriority(which: i32, who: u32, priority: i32) -> i32 { return errno.checkStatus(sys.syscall3(141, u(which), @intCast(usize, who), u(priority))) }
pub export fn nice(increment: i32) -> i32 {
    const current = getpriority(0, 0)
    if setpriority(0, 0, current + increment) != 0 { return -1 }
    return getpriority(0, 0)
}

pub export fn fork() -> i32 { return errno.checkInt(sys.syscall0(sys.SYS_fork)) }
pub export fn vfork() -> i32 { return fork() }
pub export fn _Fork() -> i32 { return fork() }
pub export fn execve(path: usize, arguments: usize, environment: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_execve, path, arguments, environment)) }
pub export fn fexecve(descriptor: i32, arguments: usize, environment: usize) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_execveat, u(descriptor), sys.literal(""), arguments, environment, 4096)) }
pub export fn execv(path: usize, arguments: usize) -> i32 { return execve(path, arguments, stdlib.environmentArray()) }

// execvp: the file as given when it has a slash, else along PATH.
pub export fn execvpe(file: usize, arguments: usize, environment: usize) -> i32 {
    if string.strchr(file, 47) != 0 || sys.get8(file) == 0 { return execve(file, arguments, environment) }
    var path = stdlib.getenv(sys.literal("PATH"))
    if path == 0 { path = sys.literal("/bin:/usr/bin") }
    const name = sys.slice(file)
    var candidate: [4096]u8 = undefined
    var seen_error: i32 = sys.ENOENT
    var at: usize = 0
    const directories = sys.constBytes(path)
    while true {
        var length: usize = 0
        while directories[at + length] != 0 && directories[at + length] != 58 { length += 1 }
        if length + 1 + name.length + 1 < 4096 {
            var out: usize = 0
            if length == 0 {
                candidate[0] = 46
                out = 1
            } else {
                sys.copy(@intFromPtr(&candidate), path + at, length)
                out = length
            }
            candidate[out] = 47
            out += 1
            sys.copy(@intFromPtr(&candidate) + out, file, name.length)
            candidate[out + name.length] = 0
            const tried = sys.syscall3(sys.SYS_execve, @intFromPtr(&candidate), arguments, environment)
            const code = @intCast(i32, 0 - tried)
            if code != sys.ENOENT && code != sys.ENOTDIR { seen_error = code }
        }
        at += length
        if directories[at] == 0 { break }
        at += 1
    }
    return errno.failWith(seen_error)
}

pub export fn execvp(file: usize, arguments: usize) -> i32 { return execvpe(file, arguments, stdlib.environmentArray()) }

// The list forms: the arguments as the call put them in the registers and
// on the stack, up to the NULL (sixteen at most here).
fn collectArguments(list: *[16]usize, a0: usize, a1: usize, a2: usize, a3: usize, a4: usize, s0: usize, s1: usize, s2: usize, s3: usize, s4: usize, s5: usize, s6: usize, s7: usize, s8: usize, s9: usize) -> usize {
    const values: [15]usize = [15]usize{ a0, a1, a2, a3, a4, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9 }
    var count: usize = 0
    while count < 15 {
        list.*[count] = values[count]
        if values[count] == 0 { return count }
        count += 1
    }
    list.*[15] = 0
    return 15
}

pub export fn execl(path: usize, a0: usize, a1: usize, a2: usize, a3: usize, a4: usize, s0: usize, s1: usize, s2: usize, s3: usize, s4: usize, s5: usize, s6: usize, s7: usize, s8: usize, s9: usize) -> i32 {
    var list: [16]usize = undefined
    const count = collectArguments(&list, a0, a1, a2, a3, a4, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9)
    return execve(path, @intFromPtr(&list), stdlib.environmentArray())
}

pub export fn execlp(file: usize, a0: usize, a1: usize, a2: usize, a3: usize, a4: usize, s0: usize, s1: usize, s2: usize, s3: usize, s4: usize, s5: usize, s6: usize, s7: usize, s8: usize, s9: usize) -> i32 {
    var list: [16]usize = undefined
    const count = collectArguments(&list, a0, a1, a2, a3, a4, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9)
    return execvp(file, @intFromPtr(&list))
}

pub export fn execle(path: usize, a0: usize, a1: usize, a2: usize, a3: usize, a4: usize, s0: usize, s1: usize, s2: usize, s3: usize, s4: usize, s5: usize, s6: usize, s7: usize, s8: usize, s9: usize) -> i32 {
    var list: [16]usize = undefined
    const count = collectArguments(&list, a0, a1, a2, a3, a4, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9)
    const values: [15]usize = [15]usize{ a0, a1, a2, a3, a4, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9 }
    const environment = if count + 1 < 15 { values[count + 1] } else { stdlib.environmentArray() }
    return execve(path, @intFromPtr(&list), environment)
}

pub export fn wait4(process: i32, status: usize, options: i32, usage: usize) -> i32 { return errno.checkInt(sys.syscall4(sys.SYS_wait4, u(process), status, u(options), usage)) }
pub export fn waitpid(process: i32, status: usize, options: i32) -> i32 { return wait4(process, status, options, 0) }
pub export fn wait(status: usize) -> i32 { return wait4(-1, status, 0, 0) }
pub export fn wait3(status: usize, options: i32, usage: usize) -> i32 { return wait4(-1, status, options, usage) }
pub export fn waitid(id_type: i32, identifier: u32, info: usize, options: i32) -> i32 { return errno.checkStatus(sys.syscall5(247, u(id_type), @intCast(usize, identifier), info, u(options), 0)) }
pub export fn kill(process: i32, signal: i32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_kill, u(process), u(signal))) }
pub export fn killpg(group: i32, signal: i32) -> i32 { return kill(0 - group, signal) }
pub export fn tgkill(group: i32, thread: i32, signal: i32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_tgkill, u(group), u(thread), u(signal))) }
pub export fn alarm(seconds: u32) -> u32 { return @intCast(u32, sys.syscall1(sys.SYS_alarm, @intCast(usize, seconds))) }
pub export fn pause() -> i32 { return errno.checkInt(sys.syscall0(sys.SYS_pause)) }
pub export fn setitimer(which: i32, value: usize, old: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_setitimer, u(which), value, old)) }
pub export fn getitimer(which: i32, value: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_getitimer, u(which), value)) }
pub export fn prctl(option: i32, a2: usize, a3: usize, a4: usize, a5: usize) -> i32 { return errno.checkInt(sys.syscall5(sys.SYS_prctl, u(option), a2, a3, a4, a5)) }
pub export fn sched_yield() -> i32 { return errno.checkStatus(sys.syscall0(sys.SYS_sched_yield)) }
pub export fn sched_getaffinity(process: i32, size: usize, mask: usize) -> i32 {
    const got = sys.syscall3(sys.SYS_sched_getaffinity, u(process), size, mask)
    if sys.failed(got) { return errno.checkInt(got) }
    // The kernel fills what it has; the rest of the caller's set is zero.
    if @bitCast(usize, got) < size { sys.fill(mask + @bitCast(usize, got), 0, size - @bitCast(usize, got)) }
    return 0
}
pub export fn sched_setaffinity(process: i32, size: usize, mask: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_sched_setaffinity, u(process), size, mask)) }
pub export fn sched_getcpu() -> i32 {
    var cpu: u32 = 0
    const got = sys.syscall3(309, @intFromPtr(&cpu), 0, 0)
    if sys.failed(got) { return errno.checkInt(got) }
    return @intCast(i32, cpu)
}
pub export fn getrlimit(resource: i32, limit: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_prlimit64, 0, u(resource), 0, limit)) }
pub export fn setrlimit(resource: i32, limit: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_prlimit64, 0, u(resource), limit, 0)) }
pub export fn getrlimit64(resource: i32, limit: usize) -> i32 { return getrlimit(resource, limit) }
pub export fn setrlimit64(resource: i32, limit: usize) -> i32 { return setrlimit(resource, limit) }
pub export fn prlimit(process: i32, resource: i32, new_limit: usize, old_limit: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_prlimit64, u(process), u(resource), new_limit, old_limit)) }
pub export fn prlimit64(process: i32, resource: i32, new_limit: usize, old_limit: usize) -> i32 { return prlimit(process, resource, new_limit, old_limit) }
pub export fn getrusage(who: i32, usage: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_getrusage, u(who), usage)) }
pub export fn times(buffer: usize) -> i64 { return @intCast(i64, errno.check(sys.syscall1(sys.SYS_times, buffer))) }
pub export fn sysinfo(info: usize) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_sysinfo, info)) }
pub export fn uname(buffer: usize) -> i32 { return errno.checkStatus(sys.syscall1(sys.SYS_uname, buffer)) }
pub export fn sethostname(name: usize, length: usize) -> i32 { return errno.checkStatus(sys.syscall2(170, name, length)) }

pub export fn gethostname(name: usize, length: usize) -> i32 {
    var buffer: [390]u8 = undefined
    if uname(@intFromPtr(&buffer)) != 0 { return -1 }
    // nodename is the second 65-byte field.
    const node = @intFromPtr(&buffer) + 65
    const count = sys.length(node)
    if count >= length {
        sys.copy(name, node, length)
        return errno.failWith(sys.ENAMETOOLONG)
    }
    sys.copy(name, node, count + 1)
    return 0
}

pub export fn getrandom(buffer: usize, length: usize, flags: u32) -> isize { return errno.check(sys.syscall3(sys.SYS_getrandom, buffer, length, @intCast(usize, flags))) }

pub export fn getentropy(buffer: usize, length: usize) -> i32 {
    if length > 256 { return errno.failWith(sys.EIO) }
    var done: usize = 0
    while done < length {
        const got = sys.syscall3(sys.SYS_getrandom, buffer + done, length - done, 0)
        if got == -4 { continue }
        if sys.failed(got) { return errno.checkStatus(got) }
        done += @bitCast(usize, got)
    }
    return 0
}

// The sysconf names programs ask for.
pub export fn sysconf(name: i32) -> i64 {
    match name {
        0 => { return 2097152 },
        1 => { return 65536 },
        2 => { return 100 },
        3 => { return 65536 },
        4 => {
            var limit: [2]u64 = [2]u64{ 0, 0 }
            if getrlimit(7, @intFromPtr(&limit)) != 0 { return 1024 }
            return @intCast(i64, limit[0])
        },
        28 => { return 32768 },
        29 => { return 200809 },
        30 => { return 4096 },
        34 => { return 32 },
        38 => { return 256 },
        43 => { return 2048 },
        60 => { return 1024 },
        69 => { return 1024 },
        70 => { return 1024 },
        71 => { return 256 },
        72 => { return 32 },
        75 => { return 16384 },
        83 => { return processorCount(false) },
        84 => { return processorCount(true) },
        85 => { return physicalPages(false) },
        86 => { return physicalPages(true) },
        149 => { return 200809 },
        173 => { return 40 },
        180 => { return 64 },
        else => {
            errno.set(sys.EINVAL)
            return -1
        },
    }
}

fn processorCount(online: bool) -> i64 {
    var mask: [128]u64 = undefined
    var index: usize = 0
    while index < 128 {
        mask[index] = 0
        index += 1
    }
    const got = sys.syscall3(sys.SYS_sched_getaffinity, 0, 1024, @intFromPtr(&mask))
    if sys.failed(got) { return 1 }
    var count: i64 = 0
    index = 0
    while index < 128 {
        count += @intCast(i64, @popCount(mask[index]))
        index += 1
    }
    return if count == 0 { 1 } else { count }
}

fn physicalPages(available: bool) -> i64 {
    var info: [112]u8 = undefined
    if sysinfo(@intFromPtr(&info)) != 0 { return -1 }
    const unit = sys.get32(@intFromPtr(&info) + 96)
    const bytes = sys.get64(@intFromPtr(&info) + (if available { 24 } else { 16 }))
    return @intCast(i64, bytes * @intCast(u64, if unit == 0 { 1 } else { unit }) / 4096)
}

// The generic system call.
pub export fn syscall(number: i64, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> i64 {
    return @intCast(i64, errno.check(sys.syscall6(@bitCast(usize, number), a1, a2, a3, a4, a5, a6)))
}

