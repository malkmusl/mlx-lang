pub export fn listen(descriptor: i32, backlog: i32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_listen, u(descriptor), u(backlog))) }
pub export fn accept(descriptor: i32, address: usize, length: usize) -> i32 { return errno.checkInt(sys.syscall3(sys.SYS_accept, u(descriptor), address, length)) }
pub export fn accept4(descriptor: i32, address: usize, length: usize, flags: i32) -> i32 { return errno.checkInt(sys.syscall4(sys.SYS_accept4, u(descriptor), address, length, u(flags))) }
pub export fn connect(descriptor: i32, address: usize, length: u32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_connect, u(descriptor), address, @intCast(usize, length))) }
pub export fn shutdown(descriptor: i32, how: i32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_shutdown, u(descriptor), u(how))) }
pub export fn send(descriptor: i32, buffer: usize, length: usize, flags: i32) -> isize { return errno.check(sys.syscall6(sys.SYS_sendto, u(descriptor), buffer, length, u(flags), 0, 0)) }
pub export fn sendto(descriptor: i32, buffer: usize, length: usize, flags: i32, address: usize, address_length: u32) -> isize { return errno.check(sys.syscall6(sys.SYS_sendto, u(descriptor), buffer, length, u(flags), address, @intCast(usize, address_length))) }
pub export fn sendmsg(descriptor: i32, message: usize, flags: i32) -> isize { return errno.check(sys.syscall3(sys.SYS_sendmsg, u(descriptor), message, u(flags))) }
pub export fn sendmmsg(descriptor: i32, messages: usize, count: u32, flags: i32) -> i32 { return errno.checkInt(sys.syscall4(sys.SYS_sendmmsg, u(descriptor), messages, @intCast(usize, count), u(flags))) }
pub export fn recv(descriptor: i32, buffer: usize, length: usize, flags: i32) -> isize { return errno.check(sys.syscall6(sys.SYS_recvfrom, u(descriptor), buffer, length, u(flags), 0, 0)) }
pub export fn recvfrom(descriptor: i32, buffer: usize, length: usize, flags: i32, address: usize, address_length: usize) -> isize { return errno.check(sys.syscall6(sys.SYS_recvfrom, u(descriptor), buffer, length, u(flags), address, address_length)) }
pub export fn recvmsg(descriptor: i32, message: usize, flags: i32) -> isize { return errno.check(sys.syscall3(sys.SYS_recvmsg, u(descriptor), message, u(flags))) }
pub export fn recvmmsg(descriptor: i32, messages: usize, count: u32, flags: i32, timeout: usize) -> i32 { return errno.checkInt(sys.syscall5(299, u(descriptor), messages, @intCast(usize, count), u(flags), timeout)) }
pub export fn setsockopt(descriptor: i32, level: i32, option: i32, value: usize, length: u32) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_setsockopt, u(descriptor), u(level), u(option), value, @intCast(usize, length))) }
pub export fn getsockopt(descriptor: i32, level: i32, option: i32, value: usize, length: usize) -> i32 { return errno.checkStatus(sys.syscall5(sys.SYS_getsockopt, u(descriptor), u(level), u(option), value, length)) }
pub export fn getsockname(descriptor: i32, address: usize, length: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_getsockname, u(descriptor), address, length)) }
pub export fn getpeername(descriptor: i32, address: usize, length: usize) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_getpeername, u(descriptor), address, length)) }

// --- waiting -------------------------------------------------------------------

pub export fn poll(descriptors: usize, count: u64, timeout: i32) -> i32 { return errno.checkInt(sys.syscall3(sys.SYS_poll, descriptors, @intCast(usize, count), u(timeout))) }
pub export fn ppoll(descriptors: usize, count: u64, timeout: usize, mask: usize) -> i32 { return errno.checkInt(sys.syscall5(sys.SYS_ppoll, descriptors, @intCast(usize, count), timeout, mask, 8)) }
pub export fn select(count: i32, readable: usize, writable: usize, exceptional: usize, timeout: usize) -> i32 { return errno.checkInt(sys.syscall5(sys.SYS_select, u(count), readable, writable, exceptional, timeout)) }
pub export fn pselect(count: i32, readable: usize, writable: usize, exceptional: usize, timeout: usize, mask: usize) -> i32 {
    var signal_argument: [2]usize = [2]usize{ mask, 8 }
    return errno.checkInt(sys.syscall6(sys.SYS_pselect6, u(count), readable, writable, exceptional, timeout, @intFromPtr(&signal_argument)))
}
pub export fn epoll_create(size: i32) -> i32 { return errno.checkInt(sys.syscall1(sys.SYS_epoll_create1, 0)) }
pub export fn epoll_create1(flags: i32) -> i32 { return errno.checkInt(sys.syscall1(sys.SYS_epoll_create1, u(flags))) }
pub export fn epoll_ctl(instance: i32, operation: i32, descriptor: i32, event: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_epoll_ctl, u(instance), u(operation), u(descriptor), event)) }
pub export fn epoll_wait(instance: i32, events: usize, count: i32, timeout: i32) -> i32 { return errno.checkInt(sys.syscall6(sys.SYS_epoll_pwait, u(instance), events, u(count), u(timeout), 0, 8)) }
pub export fn epoll_pwait(instance: i32, events: usize, count: i32, timeout: i32, mask: usize) -> i32 { return errno.checkInt(sys.syscall6(sys.SYS_epoll_pwait, u(instance), events, u(count), u(timeout), mask, 8)) }
pub export fn eventfd(initial: u32, flags: i32) -> i32 { return errno.checkInt(sys.syscall2(sys.SYS_eventfd2, @intCast(usize, initial), u(flags))) }
pub export fn eventfd_read(descriptor: i32, value: usize) -> i32 { return if read(descriptor, value, 8) == 8 { 0 } else { -1 } }
pub export fn eventfd_write(descriptor: i32, value: u64) -> i32 {
    var word = value
    return if write(descriptor, @intFromPtr(&word), 8) == 8 { 0 } else { -1 }
}
pub export fn timerfd_create(clock: i32, flags: i32) -> i32 { return errno.checkInt(sys.syscall2(sys.SYS_timerfd_create, u(clock), u(flags))) }
pub export fn timerfd_settime(descriptor: i32, flags: i32, value: usize, old: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_timerfd_settime, u(descriptor), u(flags), value, old)) }
pub export fn timerfd_gettime(descriptor: i32, value: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_timerfd_gettime, u(descriptor), value)) }
pub export fn signalfd(descriptor: i32, mask: usize, flags: i32) -> i32 { return errno.checkInt(sys.syscall4(sys.SYS_signalfd4, u(descriptor), mask, 8, u(flags))) }
pub export fn inotify_init() -> i32 { return errno.checkInt(sys.syscall1(sys.SYS_inotify_init1, 0)) }
pub export fn inotify_init1(flags: i32) -> i32 { return errno.checkInt(sys.syscall1(sys.SYS_inotify_init1, u(flags))) }
pub export fn inotify_add_watch(instance: i32, path: usize, mask: u32) -> i32 { return errno.checkInt(sys.syscall3(sys.SYS_inotify_add_watch, u(instance), path, @intCast(usize, mask))) }
pub export fn inotify_rm_watch(instance: i32, watch: i32) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_inotify_rm_watch, u(instance), u(watch))) }
pub export fn pidfd_open(process: i32, flags: u32) -> i32 { return errno.checkInt(sys.syscall2(sys.SYS_pidfd_open, u(process), @intCast(usize, flags))) }

// --- temporary files (mkstemp and its family) ----------------------------------

fn fillTemplate(template: usize) -> bool {
    const length = sys.length(template)
    if length < 6 { return false }
    var index: usize = 0
    while index < 6 {
        if sys.get8(template + length - 1 - index) != 88 { return false }
        index += 1
    }
    var random: [6]u8 = undefined
    const got = sys.syscall3(sys.SYS_getrandom, @intFromPtr(&random), 6, 0)
    const alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    index = 0
    while index < 6 {
        sys.put8(template + length - 6 + index, alphabet[@intCast(usize, random[index]) % alphabet.length])
        index += 1
    }
    return true
}

pub export fn mkostemps(template: usize, suffix_length: i32, flags: i32) -> i32 {
    const length = sys.length(template)
    if suffix_length < 0 || @intCast(usize, suffix_length) + 6 > length { return errno.failWith(sys.EINVAL) }
    const saved = sys.get8(template + length - @intCast(usize, suffix_length))
    var attempts: usize = 0
    while attempts < 100 {
        sys.put8(template + length - @intCast(usize, suffix_length), 0)
        if !fillTemplate(template) {
            sys.put8(template + length - @intCast(usize, suffix_length), saved)
            return errno.failWith(sys.EINVAL)
        }
        sys.put8(template + length - @intCast(usize, suffix_length), saved)
        const fd = open(template, 2 | 64 | 128 | flags, 384)
        if fd >= 0 { return fd }
        if errno.get() != sys.EEXIST { return -1 }
        attempts += 1
    }
    return errno.failWith(sys.EEXIST)
}

pub export fn mkstemp(template: usize) -> i32 { return mkostemps(template, 0, 0) }
pub export fn mkostemp(template: usize, flags: i32) -> i32 { return mkostemps(template, 0, flags) }
pub export fn mkstemps(template: usize, suffix_length: i32) -> i32 { return mkostemps(template, suffix_length, 0) }
pub export fn mkstemp64(template: usize) -> i32 { return mkstemp(template) }

pub export fn mkdtemp(template: usize) -> usize {
    var attempts: usize = 0
    while attempts < 100 {
        if !fillTemplate(template) {
            errno.set(sys.EINVAL)
            return 0
        }
        if mkdir(template, 448) == 0 { return template }
        if errno.get() != sys.EEXIST { return 0 }
        attempts += 1
    }
    return 0
}

pub export fn mktemp(template: usize) -> usize {
    if !fillTemplate(template) {
        errno.set(sys.EINVAL)
        sys.put8(template, 0)
    }
    return template
}
