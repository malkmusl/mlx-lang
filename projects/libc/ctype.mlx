// ctype.h in the C locale, as functions and as the three tables glibc's
// headers reach for (__ctype_b_loc and the case tables), indexed -128..255.
const sys = @import("./sys.mlx")

fn isUpperByte(c: i32) -> bool { return c >= 65 && c <= 90 }
fn isLowerByte(c: i32) -> bool { return c >= 97 && c <= 122 }
fn isDigitByte(c: i32) -> bool { return c >= 48 && c <= 57 }
fn isSpaceByte(c: i32) -> bool { return c == 32 || (c >= 9 && c <= 13) }
fn isPrintByte(c: i32) -> bool { return c >= 32 && c <= 126 }
fn isPunctByte(c: i32) -> bool { return isPrintByte(c) && c != 32 && !isUpperByte(c) && !isLowerByte(c) && !isDigitByte(c) }

fn flag(value: bool) -> i32 { return if value { 1 } else { 0 } }

pub export fn isalpha(c: i32) -> i32 { return flag(isUpperByte(c) || isLowerByte(c)) }
pub export fn isdigit(c: i32) -> i32 { return flag(isDigitByte(c)) }
pub export fn isalnum(c: i32) -> i32 { return flag(isUpperByte(c) || isLowerByte(c) || isDigitByte(c)) }
pub export fn isupper(c: i32) -> i32 { return flag(isUpperByte(c)) }
pub export fn islower(c: i32) -> i32 { return flag(isLowerByte(c)) }
pub export fn isspace(c: i32) -> i32 { return flag(isSpaceByte(c)) }
pub export fn isblank(c: i32) -> i32 { return flag(c == 32 || c == 9) }
pub export fn iscntrl(c: i32) -> i32 { return flag((c >= 0 && c < 32) || c == 127) }
pub export fn isprint(c: i32) -> i32 { return flag(isPrintByte(c)) }
pub export fn isgraph(c: i32) -> i32 { return flag(c > 32 && c <= 126) }
pub export fn ispunct(c: i32) -> i32 { return flag(isPunctByte(c)) }
pub export fn isxdigit(c: i32) -> i32 { return flag(isDigitByte(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)) }
pub export fn isascii(c: i32) -> i32 { return flag(c >= 0 && c < 128) }
pub export fn toascii(c: i32) -> i32 { return c & 127 }
pub export fn tolower(c: i32) -> i32 { return if isUpperByte(c) { c + 32 } else { c } }
pub export fn toupper(c: i32) -> i32 { return if isLowerByte(c) { c - 32 } else { c } }
pub export fn _tolower(c: i32) -> i32 { return tolower(c) }
pub export fn _toupper(c: i32) -> i32 { return toupper(c) }

// The locale-taking forms, in the one locale there is.
pub export fn isalpha_l(c: i32, locale: usize) -> i32 { return isalpha(c) }
pub export fn isdigit_l(c: i32, locale: usize) -> i32 { return isdigit(c) }
pub export fn isalnum_l(c: i32, locale: usize) -> i32 { return isalnum(c) }
pub export fn isspace_l(c: i32, locale: usize) -> i32 { return isspace(c) }
pub export fn isupper_l(c: i32, locale: usize) -> i32 { return isupper(c) }
pub export fn islower_l(c: i32, locale: usize) -> i32 { return islower(c) }
pub export fn isprint_l(c: i32, locale: usize) -> i32 { return isprint(c) }
pub export fn ispunct_l(c: i32, locale: usize) -> i32 { return ispunct(c) }
pub export fn isxdigit_l(c: i32, locale: usize) -> i32 { return isxdigit(c) }
pub export fn tolower_l(c: i32, locale: usize) -> i32 { return tolower(c) }
pub export fn toupper_l(c: i32, locale: usize) -> i32 { return toupper(c) }

// glibc's class bits (little-endian _ISbit): upper 0x100, lower 0x200,
// alpha 0x400, digit 0x800, xdigit 0x1000, space 0x2000, print 0x4000,
// graph 0x8000, blank 1, cntrl 2, punct 4, alnum 8.
fn classBits(c: i32) -> u16 {
    var bits: u16 = 0
    if isUpperByte(c) { bits |= 256 }
    if isLowerByte(c) { bits |= 512 }
    if isalpha(c) != 0 { bits |= 1024 }
    if isDigitByte(c) { bits |= 2048 }
    if isxdigit(c) != 0 { bits |= 4096 }
    if isSpaceByte(c) { bits |= 8192 }
    if isPrintByte(c) { bits |= 16384 }
    if isgraph(c) != 0 { bits |= 32768 }
    if isblank(c) != 0 { bits |= 1 }
    if iscntrl(c) != 0 { bits |= 2 }
    if isPunctByte(c) { bits |= 4 }
    if isalnum(c) != 0 { bits |= 8 }
    return bits
}

var classTable: [384]u16 = undefined
var lowerTable: [384]i32 = undefined
var upperTable: [384]i32 = undefined
var classPointer: usize = 0
var lowerPointer: usize = 0
var upperPointer: usize = 0
var tablesReady: u32 = 0
var tablesLock: u32 = 0

fn tables() -> void {
    if @atomicLoad(u32, @ptrCast(*u32, &tablesReady), acquire) == 1 { return }
    sys.lock(@ptrCast(*u32, &tablesLock))
    if tablesReady == 0 {
        // Index 0 stands for -128: the bytes 128..255 as signed chars and
        // -1 (EOF) share the high half's values, which are all plain.
        var index: usize = 0
        while index < 384 {
            const c: i32 = @intCast(i32, index) - 128
            const value: i32 = if c < 0 { c + 256 } else { c }
            classTable[index] = if c >= 0 && c < 256 { classBits(c) } else { 0 }
            // Below 0 the tables hold the byte's unsigned value (a signed
            // char indexes them), but -1 (EOF) stays -1.
            lowerTable[index] = if c >= 0 { tolower(c) } else { if c == -1 { c } else { c + 256 } }
            upperTable[index] = if c >= 0 { toupper(c) } else { if c == -1 { c } else { c + 256 } }
            index += 1
        }
        classPointer = @intFromPtr(&classTable) + 128 * 2
        lowerPointer = @intFromPtr(&lowerTable) + 128 * 4
        upperPointer = @intFromPtr(&upperTable) + 128 * 4
        @atomicStore(u32, @ptrCast(*u32, &tablesReady), 1, release)
    }
    sys.unlock(@ptrCast(*u32, &tablesLock))
}

pub export fn __ctype_b_loc() -> usize {
    tables()
    return @intFromPtr(&classPointer)
}

pub export fn __ctype_tolower_loc() -> usize {
    tables()
    return @intFromPtr(&lowerPointer)
}

pub export fn __ctype_toupper_loc() -> usize {
    tables()
    return @intFromPtr(&upperPointer)
}
