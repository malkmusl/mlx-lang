// time.h: clocks and sleeps on their system calls, the calendar (gmtime,
// localtime through std.timezone's reading of $TZ and /etc/localtime,
// mktime, timegm), strftime, and asctime's fixed shape.
const bootstrap = @import("../../std/bootstrap/root.mlx")
const tz = @import("../../std/src/timezone.mlx")
const sys = @import("./sys.mlx")
const errno = @import("./errno.mlx")
const heap = @import("./heap.mlx")
const stdlib = @import("./stdlib.mlx")
const format = @import("./format.mlx")

fn u(value: i32) -> usize { return sys.int(value) }

pub export fn clock_gettime(clock: i32, spec: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_clock_gettime, u(clock), spec)) }
pub export fn clock_getres(clock: i32, spec: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_clock_getres, u(clock), spec)) }
pub export fn clock_settime(clock: i32, spec: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_clock_settime, u(clock), spec)) }
pub export fn clock_nanosleep(clock: i32, flags: i32, request: usize, remaining: usize) -> i32 { return errno.code(sys.syscall4(sys.SYS_clock_nanosleep, u(clock), u(flags), request, remaining)) }
pub export fn nanosleep(request: usize, remaining: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_nanosleep, request, remaining)) }

fn realtimeNow() -> (i64, i64) {
    var spec: [2]i64 = [2]i64{ 0, 0 }
    const got = sys.syscall2(sys.SYS_clock_gettime, 0, @intFromPtr(&spec))
    return -> (spec[0], spec[1])
}

pub export fn gettimeofday(value: usize, zone: usize) -> i32 {
    if value != 0 {
        const now = realtimeNow()
        sys.put64(value, @bitCast(u64, now.0))
        sys.put64(value + 8, @bitCast(u64, now.1 / 1000))
    }
    if zone != 0 { sys.fill(zone, 0, 8) }
    return 0
}

pub export fn settimeofday(value: usize, zone: usize) -> i32 {
    if value == 0 { return 0 }
    var spec: [2]i64 = [2]i64{ @bitCast(i64, sys.get64(value)), @bitCast(i64, sys.get64(value + 8)) * 1000 }
    return clock_settime(0, @intFromPtr(&spec))
}

pub export fn time(target: usize) -> i64 {
    const now = realtimeNow()
    if target != 0 { sys.put64(target, @bitCast(u64, now.0)) }
    return now.0
}

pub export fn timespec_get(spec: usize, base: i32) -> i32 {
    if base != 1 { return 0 }
    const got = clock_gettime(0, spec)
    return if got == 0 { 1 } else { 0 }
}

// CLOCKS_PER_SEC is a million: the process's CPU time in microseconds.
pub export fn clock() -> i64 {
    var spec: [2]i64 = [2]i64{ 0, 0 }
    const got = sys.syscall2(sys.SYS_clock_gettime, 2, @intFromPtr(&spec))
    if sys.failed(got) { return -1 }
    return spec[0] * 1000000 + spec[1] / 1000
}

pub export fn sleep(seconds: u32) -> u32 {
    var request: [2]i64 = [2]i64{ @intCast(i64, seconds), 0 }
    var remaining: [2]i64 = [2]i64{ 0, 0 }
    const slept = sys.syscall2(sys.SYS_nanosleep, @intFromPtr(&request), @intFromPtr(&remaining))
    if slept == -4 { return @intCast(u32, remaining[0] + (if remaining[1] > 0 { 1 } else { 0 })) }
    return 0
}

pub export fn usleep(microseconds: u64) -> i32 {
    var request: [2]i64 = [2]i64{ @intCast(i64, microseconds / 1000000), @intCast(i64, (microseconds % 1000000) * 1000) }
    return errno.checkStatus(sys.syscall2(sys.SYS_nanosleep, @intFromPtr(&request), 0))
}

// struct tm: nine ints, then tm_gmtoff (long) and tm_zone (const char *).
const TM_SEC: usize = 0
const TM_MIN: usize = 4
const TM_HOUR: usize = 8
const TM_MDAY: usize = 12
const TM_MON: usize = 16
const TM_YEAR: usize = 20
const TM_WDAY: usize = 24
const TM_YDAY: usize = 28
const TM_ISDST: usize = 32
const TM_GMTOFF: usize = 40
const TM_ZONE: usize = 48

fn isLeap(year: i64) -> bool { return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 }

fn yearDay(year: i64, month: i64, day: i64) -> i64 {
    return tz.daysFromCivil(year, month, day) - tz.daysFromCivil(year, 1, 1)
}

fn fillTm(seconds: i64, offset: i64, dst: bool, zone_name: usize, tm: usize) -> void {
    const civil = tz.civil(seconds + offset)
    sys.putI32(tm + TM_SEC, @intCast(i32, civil.second))
    sys.putI32(tm + TM_MIN, @intCast(i32, civil.minute))
    sys.putI32(tm + TM_HOUR, @intCast(i32, civil.hour))
    sys.putI32(tm + TM_MDAY, @intCast(i32, civil.day))
    sys.putI32(tm + TM_MON, @intCast(i32, civil.month - 1))
    sys.putI32(tm + TM_YEAR, @intCast(i32, civil.year - 1900))
    sys.putI32(tm + TM_WDAY, @intCast(i32, civil.weekday))
    sys.putI32(tm + TM_YDAY, @intCast(i32, yearDay(civil.year, civil.month, civil.day)))
    sys.putI32(tm + TM_ISDST, if dst { 1 } else { 0 })
    sys.put64(tm + TM_GMTOFF, @bitCast(u64, offset))
    sys.putPointer(tm + TM_ZONE, zone_name)
}

var utcName: [4]u8 = [4]u8{ 85, 84, 67, 0 }
var gmtName: [4]u8 = [4]u8{ 71, 77, 84, 0 }
var staticTm: [56]u8 = undefined

pub export fn gmtime_r(source: usize, tm: usize) -> usize {
    fillTm(@bitCast(i64, sys.get64(source)), 0, false, @intFromPtr(&gmtName), tm)
    return tm
}

pub export fn gmtime(source: usize) -> usize { return gmtime_r(source, @intFromPtr(&staticTm)) }

// The local zone, read once from the environment.
var zone: tz.Zone = undefined
var zoneReady: u32 = 0
var zoneLock: u32 = 0
var zoneNames: [8][8]u8 = undefined
var zoneNameCount: usize = 0

fn ensureZone() -> void {
    if @atomicLoad(u32, @ptrCast(*u32, &zoneReady), acquire) == 1 { return }
    sys.lock(@ptrCast(*u32, &zoneLock))
    if zoneReady == 0 {
        var environment: [*][*]const u8 = undefined
        unsafe { environment = @ptrFromInt([*][*]const u8, stdlib.environmentArray()) }
        tz.load(@ptrCast(*tz.Zone, &zone), environment, heap.allocator())
        @atomicStore(u32, @ptrCast(*u32, &zoneReady), 1, release)
    }
    sys.unlock(@ptrCast(*u32, &zoneLock))
}

pub export fn tzset() -> void { ensureZone() }

// The name of an offset: "UTC" for none, "+hhmm" or "-hhmm" otherwise (the
// zone files' abbreviations are not kept).
fn zoneName(offset: i64) -> usize {
    if offset == 0 { return @intFromPtr(&utcName) }
    sys.lock(@ptrCast(*u32, &zoneLock))
    var slot: usize = 0
    var found = false
    var index: usize = 0
    while index < zoneNameCount && !found {
        if zoneNames[index][7] == @intCast(u8, (offset / 900) & 127) { found = true } else { index += 1 }
    }
    if !found {
        index = zoneNameCount % 8
        if zoneNameCount < 8 { zoneNameCount += 1 }
        var magnitude = if offset < 0 { 0 - offset } else { offset }
        zoneNames[index][0] = if offset < 0 { 45 } else { 43 }
        zoneNames[index][1] = @intCast(u8, 48 + magnitude / 36000)
        zoneNames[index][2] = @intCast(u8, 48 + (magnitude / 3600) % 10)
        zoneNames[index][3] = @intCast(u8, 48 + (magnitude % 3600) / 600)
        zoneNames[index][4] = @intCast(u8, 48 + ((magnitude % 3600) / 60) % 10)
        zoneNames[index][5] = 0
        zoneNames[index][7] = @intCast(u8, (offset / 900) & 127)
    }
    slot = @intFromPtr(&zoneNames) + index * 8
    sys.unlock(@ptrCast(*u32, &zoneLock))
    return slot
}

fn isDaylight(offset: i64) -> bool {
    return zone.hasRule && zone.hasDaylight && offset == zone.daylight && zone.daylight != zone.standard
}

pub export fn localtime_r(source: usize, tm: usize) -> usize {
    ensureZone()
    const seconds = @bitCast(i64, sys.get64(source))
    const offset = tz.offsetAt(@ptrCast(*const tz.Zone, &zone), seconds)
    fillTm(seconds, offset, isDaylight(offset), zoneName(offset), tm)
    return tm
}

pub export fn localtime(source: usize) -> usize { return localtime_r(source, @intFromPtr(&staticTm)) }

// Seconds since 1970 of a broken-down UTC time, the fields normalized.
fn fromFields(tm: usize) -> i64 {
    var year: i64 = @intCast(i64, sys.getI32(tm + TM_YEAR)) + 1900
    var month: i64 = @intCast(i64, sys.getI32(tm + TM_MON))
    year += if month >= 0 { month / 12 } else { (month - 11) / 12 }
    month = month % 12
    if month < 0 { month += 12 }
    const days = tz.daysFromCivil(year, month + 1, 1) + @intCast(i64, sys.getI32(tm + TM_MDAY)) - 1
    return days * 86400 + @intCast(i64, sys.getI32(tm + TM_HOUR)) * 3600 + @intCast(i64, sys.getI32(tm + TM_MIN)) * 60 + @intCast(i64, sys.getI32(tm + TM_SEC))
}

pub export fn timegm(tm: usize) -> i64 {
    const seconds = fromFields(tm)
    fillTm(seconds, 0, false, @intFromPtr(&gmtName), tm)
    return seconds
}

pub export fn mktime(tm: usize) -> i64 {
    ensureZone()
    const local = fromFields(tm)
    // The offset at the guessed instant, then at the corrected one.
    var offset = tz.offsetAt(@ptrCast(*const tz.Zone, &zone), local)
    var seconds = local - offset
    const again = tz.offsetAt(@ptrCast(*const tz.Zone, &zone), seconds)
    if again != offset {
        offset = again
        seconds = local - offset
    }
    fillTm(seconds, offset, isDaylight(offset), zoneName(offset), tm)
    return seconds
}

pub export fn timelocal(tm: usize) -> i64 { return mktime(tm) }

pub export fn difftime(later: i64, earlier: i64) -> f64 { return @floatFromInt(f64, later - earlier) }

fn dayName(weekday: i64) -> []const u8 {
    match weekday {
        0 => { return "Sunday" },
        1 => { return "Monday" },
        2 => { return "Tuesday" },
        3 => { return "Wednesday" },
        4 => { return "Thursday" },
        5 => { return "Friday" },
        else => { return "Saturday" },
    }
}

fn monthName(month: i64) -> []const u8 {
    match month {
        0 => { return "January" },
        1 => { return "February" },
        2 => { return "March" },
        3 => { return "April" },
        4 => { return "May" },
        5 => { return "June" },
        6 => { return "July" },
        7 => { return "August" },
        8 => { return "September" },
        9 => { return "October" },
        10 => { return "November" },
        else => { return "December" },
    }
}

fn putNumberPlain(sink: *format.Sink, value: i64, width: usize, pad: u8) -> void {
    var magnitude: u64 = @intCast(u64, if value < 0 { 0 - value } else { value })
    var digits: [24]u8 = undefined
    var count: usize = 0
    while true {
        digits[count] = @intCast(u8, 48 + magnitude % 10)
        count += 1
        magnitude /= 10
        if magnitude == 0 { break }
    }
    if value < 0 { format.put(sink, 45) }
    var padding = count
    while padding < width {
        format.put(sink, pad)
        padding += 1
    }
    while count > 0 {
        count -= 1
        format.put(sink, digits[count])
    }
}

fn isoWeek(year: i64, yday: i64, wday: i64) -> (i64, i64) {
    // ISO 8601: weeks start Monday; week 1 holds January 4th. `yday` counts
    // from 0 (tm_yday), so the ordinal day is yday + 1.
    const weekday = if wday == 0 { 7 } else { wday }
    var week = (yday - weekday + 11) / 7
    var iso_year = year
    if week < 1 {
        // The last week of the previous year.
        iso_year -= 1
        const previous_days: i64 = if isLeap(iso_year) { 366 } else { 365 }
        week = (yday + previous_days - weekday + 11) / 7
    } else if week == 53 {
        // Week 1 of the next year when December 31st falls before Thursday.
        const days: i64 = if isLeap(year) { 366 } else { 365 }
        const last_weekday = (weekday - 1 + (days - 1 - yday)) % 7 + 1
        if last_weekday < 4 {
            iso_year += 1
            week = 1
        }
    }
    return -> (iso_year, week)
}

fn formatTime(sink: *format.Sink, pattern: usize, tm: usize) -> void {
    const text = sys.constBytes(pattern)
    const sec: i64 = @intCast(i64, sys.getI32(tm + TM_SEC))
    const min: i64 = @intCast(i64, sys.getI32(tm + TM_MIN))
    const hour: i64 = @intCast(i64, sys.getI32(tm + TM_HOUR))
    const mday: i64 = @intCast(i64, sys.getI32(tm + TM_MDAY))
    const mon: i64 = @intCast(i64, sys.getI32(tm + TM_MON))
    const year: i64 = @intCast(i64, sys.getI32(tm + TM_YEAR)) + 1900
    const wday: i64 = @intCast(i64, sys.getI32(tm + TM_WDAY))
    const yday: i64 = @intCast(i64, sys.getI32(tm + TM_YDAY))
    var at: usize = 0
    while text[at] != 0 {
        const byte = text[at]
        at += 1
        if byte != 37 {
            format.put(sink, byte)
            continue
        }
        var code = text[at]
        if code == 69 || code == 79 {
            at += 1
            code = text[at]
        }
        if code == 0 { break }
        at += 1
        match code {
            97 => { format.putAll(sink, dayName(wday % 7)[0..3]) },
            65 => { format.putAll(sink, dayName(wday % 7)) },
            98 => { format.putAll(sink, monthName(mon % 12)[0..3]) },
            104 => { format.putAll(sink, monthName(mon % 12)[0..3]) },
            66 => { format.putAll(sink, monthName(mon % 12)) },
            99 => {
                formatTime(sink, sys.literal("%a %b %e %H:%M:%S %Y"), tm)
            },
            67 => { putNumberPlain(sink, year / 100, 2, 48) },
            100 => { putNumberPlain(sink, mday, 2, 48) },
            68 => { formatTime(sink, sys.literal("%m/%d/%y"), tm) },
            101 => { putNumberPlain(sink, mday, 2, 32) },
            70 => { formatTime(sink, sys.literal("%Y-%m-%d"), tm) },
            71 => { putNumberPlain(sink, isoWeek(year, yday, wday).0, 1, 48) },
            103 => { putNumberPlain(sink, isoWeek(year, yday, wday).0 % 100, 2, 48) },
            72 => { putNumberPlain(sink, hour, 2, 48) },
            73 => { putNumberPlain(sink, if hour % 12 == 0 { 12 } else { hour % 12 }, 2, 48) },
            106 => { putNumberPlain(sink, yday + 1, 3, 48) },
            107 => { putNumberPlain(sink, hour, 2, 32) },
            108 => { putNumberPlain(sink, if hour % 12 == 0 { 12 } else { hour % 12 }, 2, 32) },
            109 => { putNumberPlain(sink, mon + 1, 2, 48) },
            77 => { putNumberPlain(sink, min, 2, 48) },
            110 => { format.put(sink, 10) },
            112 => { format.putAll(sink, if hour < 12 { "AM" } else { "PM" }) },
            80 => { format.putAll(sink, if hour < 12 { "am" } else { "pm" }) },
            114 => { formatTime(sink, sys.literal("%I:%M:%S %p"), tm) },
            82 => { formatTime(sink, sys.literal("%H:%M"), tm) },
            115 => {
                var copy: [56]u8 = undefined
                sys.copy(@intFromPtr(&copy), tm, 56)
                putNumberPlain(sink, mktime(@intFromPtr(&copy)), 1, 48)
            },
            83 => { putNumberPlain(sink, sec, 2, 48) },
            116 => { format.put(sink, 9) },
            84 => { formatTime(sink, sys.literal("%H:%M:%S"), tm) },
            117 => { putNumberPlain(sink, if wday == 0 { 7 } else { wday }, 1, 48) },
            85 => { putNumberPlain(sink, (yday + 7 - wday) / 7, 2, 48) },
            86 => { putNumberPlain(sink, isoWeek(year, yday, wday).1, 2, 48) },
            119 => { putNumberPlain(sink, wday, 1, 48) },
            87 => { putNumberPlain(sink, (yday + 7 - (if wday == 0 { 6 } else { wday - 1 })) / 7, 2, 48) },
            120 => { formatTime(sink, sys.literal("%m/%d/%y"), tm) },
            88 => { formatTime(sink, sys.literal("%H:%M:%S"), tm) },
            121 => { putNumberPlain(sink, year % 100, 2, 48) },
            89 => { putNumberPlain(sink, year, 1, 48) },
            122 => {
                const offset = @bitCast(i64, sys.get64(tm + TM_GMTOFF))
                const magnitude = if offset < 0 { 0 - offset } else { offset }
                format.put(sink, if offset < 0 { 45 } else { 43 })
                putNumberPlain(sink, magnitude / 3600, 2, 48)
                putNumberPlain(sink, (magnitude % 3600) / 60, 2, 48)
            },
            90 => {
                const name = sys.getPointer(tm + TM_ZONE)
                if name != 0 { format.putAll(sink, sys.slice(name)) }
            },
            37 => { format.put(sink, 37) },
            else => {
                format.put(sink, 37)
                format.put(sink, code)
            },
        }
    }
}

pub export fn strftime(buffer: usize, size: usize, pattern: usize, tm: usize) -> usize {
    if size == 0 { return 0 }
    var sink = format.bufferSink(buffer, size - 1)
    formatTime(&sink, pattern, tm)
    if sink.written > size - 1 {
        sys.put8(buffer, 0)
        return 0
    }
    sys.put8(buffer + sink.length, 0)
    return sink.written
}

pub export fn strftime_l(buffer: usize, size: usize, pattern: usize, tm: usize, locale: usize) -> usize { return strftime(buffer, size, pattern, tm) }

var asctimeBuffer: [32]u8 = undefined

pub export fn asctime_r(tm: usize, buffer: usize) -> usize {
    var sink = format.bufferSink(buffer, 25)
    formatTime(&sink, sys.literal("%a %b %e %H:%M:%S %Y\n"), tm)
    sys.put8(buffer + sink.length, 0)
    return buffer
}

pub export fn asctime(tm: usize) -> usize { return asctime_r(tm, @intFromPtr(&asctimeBuffer)) }

pub export fn ctime_r(source: usize, buffer: usize) -> usize {
    var tm: [56]u8 = undefined
    const filled = localtime_r(source, @intFromPtr(&tm))
    return asctime_r(@intFromPtr(&tm), buffer)
}

pub export fn ctime(source: usize) -> usize { return ctime_r(source, @intFromPtr(&asctimeBuffer)) }

// The glibc globals tzset fills.
pub export var timezone: i64 = 0
pub export var daylight: i32 = 0
