// libm.so.6 in Mlx: the math functions of C (<math.h>) for the programs
// that run on mlxlibc, with no C library under them. The sine, cosine,
// e^x, the logarithms and the cube root are std.math's (fdlibm's
// algorithms); the rest is here: the arc tangent (fdlibm's polynomial),
// the other inverse and hyperbolic functions on it and on exp, powers
// with whole exponents exact, fmod exact by Sterbenz's lemma, the
// rounding functions, frexp and ldexp on the bits, and the float (`f`)
// variants through double. Built by tools/build_mlxlibc.sh as
// libm.so.6; a program mlx-cc links with -lm finds it in LD_LIBRARY_PATH
// or /lib/mlx under mlxlibc's loader.
//
// pow with a fractional exponent is e^(y ln x), whose error grows with
// the result (a few ulps up to about 2^50, tens beyond); whole exponents
// are exact to an ulp.
//
// Not here (yet): erf, erfc, lgamma, tgamma, the Bessel functions, errno
// (EDOM, ERANGE) on the domain and range errors, and the reduction of
// huge arguments to sin, cos and tan (std.math's three-part pi/2 keeps
// the digits up to about 2^20 pi; past 2^52 the result is 0).
const math = @import("../../std/src/math.mlx")

const SIGN_BIT: u64 = 9223372036854775808
const ABS_MASK: u64 = 9223372036854775807
const EXPONENT_MASK: u64 = 9218868437227405312
const MANTISSA_MASK: u64 = 4503599627370495
// 2^52: from there on a double is whole.
const WHOLE: f64 = 4503599627370496.0
const TWO_54: f64 = 18014398509481984.0

const PI: f64 = 3.141592653589793
const PI_LOW: f64 = 0.00000000000000012246467991473532
const PI_2: f64 = 1.5707963267948966
const PI_2_LOW: f64 = 0.00000000000000006123233995736766
const PI_4: f64 = 0.7853981633974483
const PI_4_LOW: f64 = 0.00000000000000003061616997868383
const LN2: f64 = 0.6931471805599453

inline fn bits(x: f64) -> u64 { return @bitCast(u64, x) }
inline fn fromBits(b: u64) -> f64 { return @bitCast(f64, b) }
// The sign flipped (0 - x would make -0.0 into 0.0).
inline fn negated(x: f64) -> f64 { return fromBits(bits(x) ^ SIGN_BIT) }
inline fn isNan(x: f64) -> bool { return x != x }
inline fn isInf(x: f64) -> bool { return bits(x) & ABS_MASK == EXPONENT_MASK }
inline fn infinity() -> f64 { return math.infinity() }
inline fn nanValue() -> f64 { return math.nan() }

// 2^k for -1022 <= k <= 1023.
inline fn twoTo(k: i64) -> f64 { return fromBits(@intCast(u64, k + 1023) << 52) }

// The unbiased exponent of a positive finite x (-1074 and up for the
// subnormals).
fn exponentOf(x: f64) -> i64 {
    const b = bits(x) & ABS_MASK
    const e = @intCast(i64, b >> 52)
    if e != 0 { return e - 1023 }
    // A subnormal: 2^54 times it is normal.
    const scaled = bits(x * TWO_54) & ABS_MASK
    return @intCast(i64, scaled >> 52) - 1023 - 54
}

// ---------------------------------------------------------------------------
// Signs, absolute values, the classification.

pub export fn fabs(x: f64) -> f64 { return fromBits(bits(x) & ABS_MASK) }

pub export fn copysign(x: f64, y: f64) -> f64 { return fromBits((bits(x) & ABS_MASK) | (bits(y) & SIGN_BIT)) }

pub export fn __signbit(x: f64) -> i32 { return if bits(x) & SIGN_BIT != 0 { 1 } else { 0 } }

pub export fn __signbitf(x: f32) -> i32 { return if @bitCast(u32, x) & 2147483648 != 0 { 1 } else { 0 } }

// FP_NAN 0, FP_INFINITE 1, FP_ZERO 2, FP_SUBNORMAL 3, FP_NORMAL 4 (as in
// projects/cc/include/math.h and glibc).
pub export fn __fpclassify(x: f64) -> i32 {
    const b = bits(x) & ABS_MASK
    if b == 0 { return 2 }
    if b < 4503599627370496 { return 3 }
    if b < EXPONENT_MASK { return 4 }
    if b == EXPONENT_MASK { return 1 }
    return 0
}

pub export fn __fpclassifyf(x: f32) -> i32 {
    const b = @bitCast(u32, x) & 2147483647
    if b == 0 { return 2 }
    if b < 8388608 { return 3 }
    if b < 2139095040 { return 4 }
    if b == 2139095040 { return 1 }
    return 0
}

pub export fn __finite(x: f64) -> i32 { return if bits(x) & EXPONENT_MASK == EXPONENT_MASK { 0 } else { 1 } }
pub export fn __isnan(x: f64) -> i32 { return if isNan(x) { 1 } else { 0 } }
pub export fn __isinf(x: f64) -> i32 {
    if !isInf(x) { return 0 }
    return if x > 0.0 { 1 } else { -1 }
}
pub export fn finite(x: f64) -> i32 { return __finite(x) }
pub export fn isnan(x: f64) -> i32 { return __isnan(x) }
pub export fn isinf(x: f64) -> i32 { return __isinf(x) }

pub export fn nan(tag: usize) -> f64 { return nanValue() }

pub export fn fmin(x: f64, y: f64) -> f64 {
    if isNan(x) { return y }
    if isNan(y) { return x }
    return if x < y { x } else { y }
}

pub export fn fmax(x: f64, y: f64) -> f64 {
    if isNan(x) { return y }
    if isNan(y) { return x }
    return if x > y { x } else { y }
}

pub export fn fdim(x: f64, y: f64) -> f64 {
    if isNan(x) || isNan(y) { return x + y }
    return if x > y { x - y } else { 0.0 }
}

pub export fn fma(x: f64, y: f64, z: f64) -> f64 { return x * y + z }

// ---------------------------------------------------------------------------
// Whole numbers.

pub export fn floor(x: f64) -> f64 { return @floor(x) }
pub export fn ceil(x: f64) -> f64 { return @ceil(x) }
pub export fn trunc(x: f64) -> f64 { return @trunc(x) }
pub export fn round(x: f64) -> f64 { return copysign(math.round(x), x) }

// To the nearest whole number, halves to the even one.
pub export fn rint(x: f64) -> f64 {
    if !(fabs(x) < WHOLE) { return x }
    const f = @floor(x)
    const d = x - f
    var r = f
    if d > 0.5 {
        r = f + 1.0
    } else if d == 0.5 && fmod(f, 2.0) != 0.0 {
        r = f + 1.0
    }
    return copysign(r, x)
}

pub export fn nearbyint(x: f64) -> f64 { return rint(x) }
pub export fn lround(x: f64) -> i64 { return @intFromFloat(i64, math.round(x)) }
pub export fn llround(x: f64) -> i64 { return @intFromFloat(i64, math.round(x)) }
pub export fn lrint(x: f64) -> i64 { return @intFromFloat(i64, rint(x)) }
pub export fn llrint(x: f64) -> i64 { return @intFromFloat(i64, rint(x)) }

// The whole part into `whole`; the fraction, with x's sign.
pub export fn modf(x: f64, whole: *f64) -> f64 {
    if isInf(x) {
        whole.* = x
        return copysign(0.0, x)
    }
    const t = @trunc(x)
    whole.* = t
    return copysign(x - t, x)
}

// ---------------------------------------------------------------------------
// Powers of two: frexp, ldexp, scalbn.

pub export fn frexp(x: f64, exponent: *i32) -> f64 {
    var b = bits(x)
    var e = @intCast(i32, (b >> 52) & 2047)
    if e == 2047 || x == 0.0 {
        exponent.* = 0
        return x
    }
    var adjust: i32 = 0
    if e == 0 {
        b = bits(x * TWO_54)
        e = @intCast(i32, (b >> 52) & 2047)
        adjust = -54
    }
    exponent.* = e - 1022 + adjust
    return fromBits((b & (SIGN_BIT | MANTISSA_MASK)) | (1022 << 52))
}

fn scaled(x: f64, n: i64) -> f64 {
    if x == 0.0 || isInf(x) || isNan(x) { return x }
    var result = x
    var power = n
    if power > 2100 { power = 2100 }
    if power < -2100 { power = -2100 }
    while power > 1023 {
        result = result * twoTo(1023)
        power -= 1023
    }
    while power < -1022 {
        result = result * twoTo(-1022)
        power += 1022
    }
    return result * twoTo(power)
}

pub export fn ldexp(x: f64, n: i32) -> f64 { return scaled(x, @intCast(i64, n)) }
pub export fn scalbn(x: f64, n: i32) -> f64 { return scaled(x, @intCast(i64, n)) }
pub export fn scalbln(x: f64, n: i64) -> f64 { return scaled(x, n) }
pub export fn logb(x: f64) -> f64 {
    if x == 0.0 { return -infinity() }
    if isInf(x) { return infinity() }
    if isNan(x) { return x }
    return @floatFromInt(f64, exponentOf(x))
}
pub export fn ilogb(x: f64) -> i32 {
    if x == 0.0 || isNan(x) { return -2147483648 }
    if isInf(x) { return 2147483647 }
    return @intCast(i32, exponentOf(x))
}

// ---------------------------------------------------------------------------
// Remainders. fmod takes from |x| the largest 2^k |y| not above it until
// |x| < |y|: each step is exact (Sterbenz: the two are within a factor
// of two), and halves what is left.

pub export fn fmod(x: f64, y: f64) -> f64 {
    if isNan(x) || isNan(y) || isInf(x) || y == 0.0 { return nanValue() }
    const ay = fabs(y)
    var r = fabs(x)
    if isInf(y) || r < ay { return x }
    while r >= ay {
        var d = scaled(ay, exponentOf(r) - exponentOf(ay))
        if d > r { d = d * 0.5 }
        r = r - d
    }
    return copysign(r, x)
}

// x - n y for the n nearest x / y (halves to the even n).
pub export fn remainder(x: f64, y: f64) -> f64 {
    if isNan(x) || isNan(y) || isInf(x) || y == 0.0 { return nanValue() }
    if isInf(y) { return x }
    const ay = fabs(y)
    const ax = fabs(x)
    var r = fmod(ax, ay)
    // r is in [0, ay); bring it to [-ay/2, ay/2].
    if r + r > ay {
        r = r - ay
    } else if r + r == ay {
        // A tie: the quotient so far is (|x| - r) / ay; even keeps r.
        const quotient = fmod((ax - r) / ay, 2.0)
        if quotient != 0.0 { r = r - ay }
    }
    return if bits(x) & SIGN_BIT != 0 { negated(r) } else { r }
}

pub export fn remquo(x: f64, y: f64, quotient: *i32) -> f64 {
    const r = remainder(x, y)
    var q: f64 = 0.0
    if !isNan(r) && !isInf(y) && y != 0.0 { q = rint((x - r) / y) }
    const whole = fmod(fabs(q), 2147483648.0)
    quotient.* = if (x < 0.0) != (y < 0.0) { -@intFromFloat(i32, whole) } else { @intFromFloat(i32, whole) }
    return r
}

// ---------------------------------------------------------------------------
// Roots and distances.

pub export fn sqrt(x: f64) -> f64 { return @sqrt(x) }
pub export fn cbrt(x: f64) -> f64 {
    // A tiny x is scaled up by 2^1020 first (its root by 2^-340): the
    // Newton steps would underflow on it.
    if fabs(x) < twoTo(-1000) && x != 0.0 { return math.cbrt(x * twoTo(1020)) * twoTo(-340) }
    return math.cbrt(x)
}

pub export fn hypot(x: f64, y: f64) -> f64 {
    if isInf(x) || isInf(y) { return infinity() }
    if isNan(x) || isNan(y) { return nanValue() }
    const ax = fabs(x)
    const ay = fabs(y)
    const big = if ax > ay { ax } else { ay }
    const small = if ax > ay { ay } else { ax }
    if big == 0.0 { return 0.0 }
    const ratio = small / big
    return big * @sqrt(1.0 + ratio * ratio)
}

// ---------------------------------------------------------------------------
// Exponentials and logarithms.

pub export fn exp(x: f64) -> f64 { return math.exp(x) }

// 2^x = 2^n 2^f for the nearest whole n: |f| <= 1/2 keeps e^(f ln 2)
// close.
pub export fn exp2(x: f64) -> f64 {
    if isNan(x) { return x }
    if x >= 1024.0 { return infinity() }
    if x < -1100.0 { return 0.0 }
    const n = rint(x)
    const f = x - n
    return scaled(math.exp(f * LN2), @intFromFloat(i64, n))
}

// e^x - 1 without the cancellation near 0 (Kahan): (u - 1) x / ln u for
// u = e^x, since ln u is x with u's rounding.
pub export fn expm1(x: f64) -> f64 {
    if isNan(x) { return x }
    if x > 709.0 { return infinity() }
    const u = math.exp(x)
    if u == 1.0 { return x }
    const um1 = u - 1.0
    if um1 == -1.0 { return -1.0 }
    return um1 * x / math.ln(u)
}

pub export fn log(x: f64) -> f64 { return math.ln(x) }
pub export fn log2(x: f64) -> f64 { return math.log2(x) }
pub export fn log10(x: f64) -> f64 { return math.log10(x) }

// ln(1 + x) without the cancellation near 0 (Kahan): ln u x / (u - 1) for
// u = 1 + x rounded.
pub export fn log1p(x: f64) -> f64 {
    if isNan(x) || x < -1.0 { return nanValue() }
    if x == -1.0 { return -infinity() }
    const u = 1.0 + x
    if u == 1.0 { return x }
    if isInf(u) { return u }
    return math.ln(u) * x / (u - 1.0)
}

// Double-double arithmetic (a value as the sum of two doubles) for the
// whole powers: Dekker's exact product from the halves of each factor.
const SPLITTER: f64 = 134217729.0

fn twoProduct(a: f64, b: f64) -> (f64, f64) {
    const p = a * b
    const ta = SPLITTER * a
    const ah = ta - (ta - a)
    const al = a - ah
    const tb = SPLITTER * b
    const bh = tb - (tb - b)
    const bl = b - bh
    const e = ((ah * bh - p) + ah * bl + al * bh) + al * bl
    return -> (p, e)
}

fn doubleMultiply(xh: f64, xl: f64, yh: f64, yl: f64) -> (f64, f64) {
    const product = twoProduct(xh, yh)
    // Past the doubles' range the low part is meaningless.
    if isInf(product.0) || product.0 == 0.0 || isNan(product.1) { return -> (product.0, 0.0) }
    const e = product.1 + (xh * yl + xl * yh)
    const s = product.0 + e
    return -> (s, e - (s - product.0))
}

// 1 / (h + l), as a double.
fn doubleReciprocal(h: f64, l: f64) -> f64 {
    const q = 1.0 / h
    if isInf(q) || q == 0.0 { return q }
    const product = twoProduct(q, h)
    const r = ((1.0 - product.0) - product.1) - q * l
    return q + r / h
}

// x^n by squaring in double-double: within an ulp while nothing
// overflows.
fn wholePower(x: f64, n: i64) -> f64 {
    var baseHigh = x
    var baseLow: f64 = 0.0
    var left = if n < 0 { -n } else { n }
    var high: f64 = 1.0
    var low: f64 = 0.0
    while left > 0 {
        if left & 1 == 1 {
            const product = doubleMultiply(high, low, baseHigh, baseLow)
            high = product.0
            low = product.1
        }
        left = left >> 1
        if left > 0 {
            const square = doubleMultiply(baseHigh, baseLow, baseHigh, baseLow)
            baseHigh = square.0
            baseLow = square.1
        }
    }
    if n < 0 {
        if high == 0.0 { return infinity() }
        if isInf(high) { return 0.0 }
        return doubleReciprocal(high, low)
    }
    return high + low
}

pub export fn pow(x: f64, y: f64) -> f64 {
    if y == 0.0 || x == 1.0 { return 1.0 }
    if isNan(x) || isNan(y) { return x + y }
    const ax = fabs(x)
    const yWhole = y == @trunc(y) && fabs(y) < 9007199254740992.0
    const yOdd = yWhole && fmod(y, 2.0) != 0.0
    if isInf(y) {
        if ax == 1.0 { return 1.0 }
        return if (ax > 1.0) == (y > 0.0) { infinity() } else { 0.0 }
    }
    if x == 0.0 {
        if y < 0.0 { return if yOdd { copysign(infinity(), x) } else { infinity() } }
        return if yOdd { x } else { 0.0 }
    }
    if isInf(x) {
        if x > 0.0 { return if y > 0.0 { infinity() } else { 0.0 } }
        if y > 0.0 { return if yOdd { -infinity() } else { infinity() } }
        return if yOdd { negated(0.0) } else { 0.0 }
    }
    if x < 0.0 && !yWhole { return nanValue() }
    if yWhole && fabs(y) <= 1024.0 { return wholePower(x, @intFromFloat(i64, y)) }
    const result = fractionalPower(ax, y)
    return if x < 0.0 && yOdd { negated(result) } else { result }
}

// a + b as a double-double (Knuth's two-sum).
fn twoSum(a: f64, b: f64) -> (f64, f64) {
    const s = a + b
    const bb = s - a
    return -> (s, (a - (s - bb)) + (b - bb))
}

// x^y for x > 0 as 2^(y log2 x): x = m 2^k with m near 1, y k exact as a
// double-double, y log2 m small, then 2^n e^(f ln 2) for the whole n and
// the fraction f of the sum. The error is y log2 m's rounding: an ulp
// or two for most, a few tens for |y| in the hundreds.
fn fractionalPower(ax: f64, y: f64) -> f64 {
    var exponent: i32 = 0
    var m = frexp(ax, &exponent)
    var k = @intCast(i64, exponent)
    // m in [1/2, 1): the half above sqrt(1/2) stays, the rest doubles.
    if m < 0.7071067811865476 {
        m = m * 2.0
        k -= 1
    }
    const l = math.log2(m)
    const yk = twoProduct(y, @floatFromInt(f64, k))
    const rest = yk.1 + y * l
    const t = twoSum(yk.0, rest)
    if t.0 >= 1024.0 { return infinity() }
    if t.0 < -1100.0 { return 0.0 }
    const n = rint(t.0)
    const f = (t.0 - n) + t.1
    return scaled(math.exp(f * LN2), @intFromFloat(i64, n))
}

// ---------------------------------------------------------------------------
// Trigonometry. The arc tangent: |x| above 1 is pi/2 - atan(1/x); below,
// atan(x) = atan(c) + atan((x - c) / (1 + x c)) for the nearest c in
// 0, 1/8, ..., 1, the second term a short series in |t| <= 1/16, the
// first from a table in two parts (tools/libm_check.py keeps it within
// 2 ulps of glibc's).

pub export fn sin(x: f64) -> f64 { return math.sin(x) }
pub export fn cos(x: f64) -> f64 { return math.cos(x) }
pub export fn tan(x: f64) -> f64 { return math.sin(x) / math.cos(x) }

// atan(k / 8), the double and what it leaves out.
fn atanTableHigh(k: i64) -> f64 {
    return match k {
        1 => 0.12435499454676144,
        2 => 0.24497866312686414,
        3 => 0.35877067027057225,
        4 => 0.4636476090008061,
        5 => 0.5585993153435624,
        6 => 0.6435011087932844,
        7 => 0.7188299996216245,
        8 => 0.7853981633974483,
        else => 0.0,
    }
}

fn atanTableLow(k: i64) -> f64 {
    return match k {
        1 => -0.0000000000000000031253241424539383,
        2 => 0.000000000000000010698755618734451,
        3 => -0.000000000000000024623815582638635,
        4 => 0.000000000000000022698777452961687,
        5 => -0.0000000000000000054556305485916264,
        6 => 0.000000000000000015834785051444286,
        7 => -0.000000000000000021478388444456983,
        8 => 0.00000000000000003061616997868383,
        else => 0.0,
    }
}

pub export fn atan(x: f64) -> f64 {
    if isNan(x) { return x }
    var a = fabs(x)
    // 2^66 and up: pi/2 to the last bit; below 2^-27 the series would
    // add nothing.
    if a >= 73786976294838206464.0 { return copysign(PI_2 + PI_2_LOW, x) }
    if a < 0.00000000745058059692382812 { return x }
    const inverted = a > 1.0
    if inverted { a = 1.0 / a }
    const k = @intFromFloat(i64, math.round(a * 8.0))
    const c = @floatFromInt(f64, k) * 0.125
    const t = (a - c) / (1.0 + a * c)
    const z = t * t
    const series = t * (1.0 - z * (0.3333333333333333 - z * (0.2 - z * (0.14285714285714285 - z * (0.1111111111111111 - z * (0.09090909090909091 - z * (0.07692307692307693 - z * (0.06666666666666667 - z * 0.058823529411764705))))))))
    var result = atanTableHigh(k) + (atanTableLow(k) + series)
    if inverted { result = (PI_2 + PI_2_LOW) - result }
    return copysign(result, x)
}

pub export fn atan2(y: f64, x: f64) -> f64 {
    if isNan(x) || isNan(y) { return x + y }
    if x == 1.0 { return atan(y) }
    const xNegative = bits(x) & SIGN_BIT != 0
    if y == 0.0 {
        if !xNegative { return y }
        return copysign(PI, y)
    }
    if x == 0.0 { return copysign(PI_2, y) }
    if isInf(x) {
        if isInf(y) {
            return if xNegative { copysign(3.0 * PI_4, y) } else { copysign(PI_4, y) }
        }
        return if xNegative { copysign(PI, y) } else { copysign(0.0, y) }
    }
    if isInf(y) { return copysign(PI_2, y) }
    const ratio = fabs(y / x)
    var z: f64 = 0.0
    if ratio > 1152921504606846976.0 {
        // |y/x| above 2^60: pi/2 within a rounding.
        z = PI_2 + 0.5 * PI_LOW
    } else if xNegative && ratio < 0.000000000000000000867361737988403547 {
        z = 0.0
    } else {
        z = atan(ratio)
    }
    if !xNegative { return copysign(z, y) }
    return copysign(PI - (z - PI_LOW), y)
}

pub export fn asin(x: f64) -> f64 {
    const a = fabs(x)
    if isNan(x) { return x }
    if a > 1.0 { return nanValue() }
    if a == 1.0 { return copysign(PI_2 + PI_2_LOW, x) }
    return atan2(x, @sqrt((1.0 - x) * (1.0 + x)))
}

pub export fn acos(x: f64) -> f64 {
    if isNan(x) { return x }
    if fabs(x) > 1.0 { return nanValue() }
    if x == 1.0 { return 0.0 }
    if x == -1.0 { return PI + PI_LOW }
    return atan2(@sqrt((1.0 - x) * (1.0 + x)), x)
}

// ---------------------------------------------------------------------------
// The hyperbolic functions, on e^x.

pub export fn sinh(x: f64) -> f64 {
    const a = fabs(x)
    if isNan(x) || isInf(x) { return x }
    // Below 2^-28 x itself is the answer; up to 22 the two exponentials.
    if a < 0.00000000372529029846191406 { return x }
    if a < 22.0 {
        const t = expm1(a)
        var half = 0.5 * t
        if a < 1.0 {
            half = 0.5 * (2.0 * t - t * t / (t + 1.0))
        } else {
            half = 0.5 * (t + t / (t + 1.0))
        }
        return copysign(half, x)
    }
    if a < 709.7822265625 { return copysign(0.5 * math.exp(a), x) }
    // e^a would overflow where the result need not: e^(a/2) squared.
    const w = math.exp(0.5 * a)
    return copysign(0.5 * w * w, x)
}

pub export fn cosh(x: f64) -> f64 {
    const a = fabs(x)
    if isNan(x) { return x }
    if isInf(x) { return infinity() }
    if a < 0.5 * LN2 {
        const t = expm1(a)
        const w = 1.0 + t
        if a < 0.0000000000000000555111512312578270 { return w }
        return 1.0 + (t * t) / (w + w)
    }
    if a < 22.0 {
        const t = math.exp(a)
        return 0.5 * t + 0.5 / t
    }
    if a < 709.7822265625 { return 0.5 * math.exp(a) }
    const w = math.exp(0.5 * a)
    return 0.5 * w * w
}

pub export fn tanh(x: f64) -> f64 {
    const a = fabs(x)
    if isNan(x) { return x }
    if isInf(x) { return copysign(1.0, x) }
    if a >= 22.0 { return copysign(1.0, x) }
    if a < 0.00000000372529029846191406 { return x }
    var z: f64 = 0.0
    if a >= 1.0 {
        const t = expm1(2.0 * a)
        z = 1.0 - 2.0 / (t + 2.0)
    } else {
        const t = expm1(-2.0 * a)
        z = -t / (t + 2.0)
    }
    return copysign(z, x)
}

pub export fn asinh(x: f64) -> f64 {
    const a = fabs(x)
    if isNan(x) || isInf(x) { return x }
    if a < 0.00000000372529029846191406 { return x }
    var w: f64 = 0.0
    if a > 268435456.0 {
        // 2^28 and up: ln(2a).
        w = math.ln(a) + LN2
    } else if a > 2.0 {
        w = math.ln(2.0 * a + 1.0 / (@sqrt(a * a + 1.0) + a))
    } else {
        const t = a * a
        w = log1p(a + t / (1.0 + @sqrt(1.0 + t)))
    }
    return copysign(w, x)
}

pub export fn acosh(x: f64) -> f64 {
    if isNan(x) { return x }
    if x < 1.0 { return nanValue() }
    if isInf(x) { return x }
    if x == 1.0 { return 0.0 }
    if x > 268435456.0 { return math.ln(x) + LN2 }
    if x > 2.0 { return math.ln(2.0 * x - 1.0 / (x + @sqrt(x * x - 1.0))) }
    const t = x - 1.0
    return log1p(t + @sqrt(2.0 * t + t * t))
}

pub export fn atanh(x: f64) -> f64 {
    const a = fabs(x)
    if isNan(x) { return x }
    if a > 1.0 { return nanValue() }
    if a == 1.0 { return copysign(infinity(), x) }
    if a < 0.00000000372529029846191406 { return x }
    var t: f64 = 0.0
    if a < 0.5 {
        const twice = a + a
        t = 0.5 * log1p(twice + twice * a / (1.0 - a))
    } else {
        t = 0.5 * log1p((a + a) / (1.0 - a))
    }
    return copysign(t, x)
}

// ---------------------------------------------------------------------------
// Neighbours.

pub export fn nextafter(x: f64, y: f64) -> f64 {
    if isNan(x) || isNan(y) { return x + y }
    if x == y { return y }
    if x == 0.0 { return copysign(fromBits(1), y) }
    var b = bits(x)
    if (y > x) == (x > 0.0) { b += 1 } else { b -= 1 }
    return fromBits(b)
}

pub export fn nexttoward(x: f64, y: f64) -> f64 { return nextafter(x, y) }

// ---------------------------------------------------------------------------
// The float variants: through double (a float's result rounded once
// more, from 53 bits to 24, which is what the extra bits leave unseen).

inline fn narrow(x: f64) -> f32 { return @floatCast(f32, x) }
inline fn widen(x: f32) -> f64 { return @floatCast(f64, x) }

pub export fn fabsf(x: f32) -> f32 { return @bitCast(f32, @bitCast(u32, x) & 2147483647) }
pub export fn copysignf(x: f32, y: f32) -> f32 { return @bitCast(f32, (@bitCast(u32, x) & 2147483647) | (@bitCast(u32, y) & 2147483648)) }
pub export fn floorf(x: f32) -> f32 { return narrow(@floor(widen(x))) }
pub export fn ceilf(x: f32) -> f32 { return narrow(@ceil(widen(x))) }
pub export fn truncf(x: f32) -> f32 { return narrow(@trunc(widen(x))) }
pub export fn roundf(x: f32) -> f32 { return narrow(round(widen(x))) }
pub export fn rintf(x: f32) -> f32 { return narrow(rint(widen(x))) }
pub export fn nearbyintf(x: f32) -> f32 { return narrow(rint(widen(x))) }
pub export fn lroundf(x: f32) -> i64 { return lround(widen(x)) }
pub export fn llroundf(x: f32) -> i64 { return lround(widen(x)) }
pub export fn lrintf(x: f32) -> i64 { return lrint(widen(x)) }
pub export fn llrintf(x: f32) -> i64 { return lrint(widen(x)) }
pub export fn sqrtf(x: f32) -> f32 { return narrow(@sqrt(widen(x))) }
pub export fn cbrtf(x: f32) -> f32 { return narrow(math.cbrt(widen(x))) }
pub export fn hypotf(x: f32, y: f32) -> f32 { return narrow(hypot(widen(x), widen(y))) }
pub export fn fmodf(x: f32, y: f32) -> f32 { return narrow(fmod(widen(x), widen(y))) }
pub export fn remainderf(x: f32, y: f32) -> f32 { return narrow(remainder(widen(x), widen(y))) }
pub export fn fminf(x: f32, y: f32) -> f32 { return narrow(fmin(widen(x), widen(y))) }
pub export fn fmaxf(x: f32, y: f32) -> f32 { return narrow(fmax(widen(x), widen(y))) }
pub export fn fdimf(x: f32, y: f32) -> f32 { return narrow(fdim(widen(x), widen(y))) }
pub export fn fmaf(x: f32, y: f32, z: f32) -> f32 { return narrow(widen(x) * widen(y) + widen(z)) }
pub export fn expf(x: f32) -> f32 { return narrow(math.exp(widen(x))) }
pub export fn exp2f(x: f32) -> f32 { return narrow(exp2(widen(x))) }
pub export fn expm1f(x: f32) -> f32 { return narrow(expm1(widen(x))) }
pub export fn logf(x: f32) -> f32 { return narrow(math.ln(widen(x))) }
pub export fn log2f(x: f32) -> f32 { return narrow(math.log2(widen(x))) }
pub export fn log10f(x: f32) -> f32 { return narrow(math.log10(widen(x))) }
pub export fn log1pf(x: f32) -> f32 { return narrow(log1p(widen(x))) }
pub export fn powf(x: f32, y: f32) -> f32 { return narrow(pow(widen(x), widen(y))) }
pub export fn sinf(x: f32) -> f32 { return narrow(math.sin(widen(x))) }
pub export fn cosf(x: f32) -> f32 { return narrow(math.cos(widen(x))) }
pub export fn tanf(x: f32) -> f32 { return narrow(tan(widen(x))) }
pub export fn asinf(x: f32) -> f32 { return narrow(asin(widen(x))) }
pub export fn acosf(x: f32) -> f32 { return narrow(acos(widen(x))) }
pub export fn atanf(x: f32) -> f32 { return narrow(atan(widen(x))) }
pub export fn atan2f(y: f32, x: f32) -> f32 { return narrow(atan2(widen(y), widen(x))) }
pub export fn sinhf(x: f32) -> f32 { return narrow(sinh(widen(x))) }
pub export fn coshf(x: f32) -> f32 { return narrow(cosh(widen(x))) }
pub export fn tanhf(x: f32) -> f32 { return narrow(tanh(widen(x))) }
pub export fn asinhf(x: f32) -> f32 { return narrow(asinh(widen(x))) }
pub export fn acoshf(x: f32) -> f32 { return narrow(acosh(widen(x))) }
pub export fn atanhf(x: f32) -> f32 { return narrow(atanh(widen(x))) }
pub export fn ldexpf(x: f32, n: i32) -> f32 { return narrow(scaled(widen(x), @intCast(i64, n))) }
pub export fn scalbnf(x: f32, n: i32) -> f32 { return narrow(scaled(widen(x), @intCast(i64, n))) }
pub export fn frexpf(x: f32, exponent: *i32) -> f32 { return narrow(frexp(widen(x), exponent)) }
pub export fn modff(x: f32, whole: *f32) -> f32 {
    var w: f64 = 0.0
    const fraction = modf(widen(x), &w)
    whole.* = narrow(w)
    return narrow(fraction)
}
pub export fn nanf(tag: usize) -> f32 { return narrow(nanValue()) }
pub export fn nextafterf(x: f32, y: f32) -> f32 {
    if x != x || y != y { return x + y }
    if x == y { return y }
    if x == 0.0 { return copysignf(@bitCast(f32, 1), y) }
    var b = @bitCast(u32, x)
    if (y > x) == (x > 0.0) { b += 1 } else { b -= 1 }
    return @bitCast(f32, b)
}
