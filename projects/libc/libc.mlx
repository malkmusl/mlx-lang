// mlxlibc: the C library in Mlx (projects/libc/README.md). A plugin
// without a C library under it (`mlx4 --plugin --stack-arena --no-libc`):
// everything here sits on system calls alone. Each module below exports a
// header's worth of functions under their C names.
const sys = @import("./sys.mlx")
const errno = @import("./errno.mlx")
const heap = @import("./heap.mlx")
const string = @import("./string.mlx")
const ctype = @import("./ctype.mlx")
const bignum = @import("./bignum.mlx")
const stdlib = @import("./stdlib.mlx")
const unistd = @import("./unistd.mlx")
const signal = @import("./signal.mlx")
const format = @import("./format.mlx")
const stdio = @import("./stdio.mlx")
const time = @import("./time.mlx")
const pthread = @import("./pthread.mlx")
const dl = @import("./dl.mlx")
const misc = @import("./misc.mlx")

// The library's own version, for programs that want to know what they run on.
pub export fn mlxlibc_version() -> usize { return sys.literal("mlxlibc 0.1") }
