// signal.h: sigaction and signal, the masks, raise and the signal sets.
// glibc's struct sigaction (handler, a 128-byte mask, flags, restorer) is
// translated to the kernel's (handler, flags, restorer, an 8-byte mask).
// The kernel asks x86_64 handlers to return through a restorer that makes
// the rt_sigreturn system call with the stack as the kernel left it, which
// no function with a frame can do: the two instructions are written into
// a page of their own, made executable, the first time a handler is set.
const sys = @import("./sys.mlx")
const errno = @import("./errno.mlx")
const string = @import("./string.mlx")

const SA_RESTORER: u64 = 67108864

var restorerPage: usize = 0
var restorerLock: u32 = 0

fn restorer() -> usize {
    if @atomicLoad(usize, @ptrCast(*usize, &restorerPage), acquire) != 0 { return restorerPage }
    sys.lock(@ptrCast(*u32, &restorerLock))
    if restorerPage == 0 {
        const page = sys.mmap(sys.PAGE, sys.PROT_READ | sys.PROT_WRITE, sys.MAP_PRIVATE | sys.MAP_ANONYMOUS)
        if page != sys.MAP_FAILED {
            // mov rax, 15 (48 C7 C0 0F 00 00 00); syscall (0F 05)
            const code: [9]u8 = [9]u8{ 72, 199, 192, 15, 0, 0, 0, 15, 5 }
            sys.copy(page, @intFromPtr(&code), 9)
            const protected = sys.syscall3(sys.SYS_mprotect, page, sys.PAGE, sys.PROT_READ | sys.PROT_EXEC)
            if !sys.failed(protected) { @atomicStore(usize, @ptrCast(*usize, &restorerPage), page, release) }
        }
    }
    sys.unlock(@ptrCast(*u32, &restorerLock))
    return restorerPage
}

pub export fn sigaction(number: i32, action: usize, old: usize) -> i32 {
    var kernel_action: [4]u64 = [4]u64{ 0, 0, 0, 0 }
    var kernel_old: [4]u64 = [4]u64{ 0, 0, 0, 0 }
    if action != 0 {
        kernel_action[0] = sys.get64(action)
        kernel_action[1] = @intCast(u64, sys.get32(action + 136))
        kernel_action[3] = sys.get64(action + 8)
        const handler = kernel_action[0]
        if handler != 0 && handler != 1 {
            const trampoline = restorer()
            if trampoline == 0 { return errno.failWith(sys.ENOMEM) }
            kernel_action[1] |= SA_RESTORER
            kernel_action[2] = @intCast(u64, trampoline)
        }
    }
    const status = sys.syscall4(sys.SYS_rt_sigaction, sys.int(number), if action != 0 { @intFromPtr(&kernel_action) } else { 0 }, if old != 0 { @intFromPtr(&kernel_old) } else { 0 }, 8)
    if sys.failed(status) { return errno.checkStatus(status) }
    if old != 0 {
        sys.put64(old, kernel_old[0])
        sys.fill(old + 8, 0, 128)
        sys.put64(old + 8, kernel_old[3])
        sys.put32(old + 136, @intCast(u32, kernel_old[1] & ~SA_RESTORER))
        sys.put64(old + 144, kernel_old[2])
    }
    return 0
}

pub export fn signal(number: i32, handler: usize) -> usize {
    var action: [19]u64 = undefined
    var index: usize = 0
    while index < 19 {
        action[index] = 0
        index += 1
    }
    action[0] = @intCast(u64, handler)
    // SA_RESTART, as glibc's BSD-style signal().
    action[17] = 268435456
    var old: [19]u64 = undefined
    if sigaction(number, @intFromPtr(&action), @intFromPtr(&old)) != 0 { return 18446744073709551615 }
    return @intCast(usize, old[0])
}

pub export fn bsd_signal(number: i32, handler: usize) -> usize { return signal(number, handler) }
pub export fn __sysv_signal(number: i32, handler: usize) -> usize { return signal(number, handler) }

pub export fn sigprocmask(how: i32, set: usize, old: usize) -> i32 { return errno.checkStatus(sys.syscall4(sys.SYS_rt_sigprocmask, sys.int(how), set, old, 8)) }
pub export fn pthread_sigmask(how: i32, set: usize, old: usize) -> i32 { return errno.code(sys.syscall4(sys.SYS_rt_sigprocmask, sys.int(how), set, old, 8)) }
pub export fn sigsuspend(mask: usize) -> i32 { return errno.checkInt(sys.syscall2(sys.SYS_rt_sigsuspend, mask, 8)) }
pub export fn sigpending(set: usize) -> i32 { return errno.checkStatus(sys.syscall2(127, set, 8)) }
pub export fn sigaltstack(stack: usize, old: usize) -> i32 { return errno.checkStatus(sys.syscall2(sys.SYS_sigaltstack, stack, old)) }
pub export fn sigwaitinfo(set: usize, info: usize) -> i32 { return errno.checkInt(sys.syscall4(128, set, info, 0, 8)) }
pub export fn sigtimedwait(set: usize, info: usize, timeout: usize) -> i32 { return errno.checkInt(sys.syscall4(128, set, info, timeout, 8)) }
pub export fn sigwait(set: usize, number: usize) -> i32 {
    const got = sys.syscall4(128, set, 0, 0, 8)
    if sys.failed(got) { return @intCast(i32, 0 - got) }
    sys.putI32(number, @intCast(i32, got))
    return 0
}
pub export fn sigqueue(process: i32, number: i32, value: usize) -> i32 {
    var info: [128]u8 = undefined
    sys.fill(@intFromPtr(&info), 0, 128)
    sys.putI32(@intFromPtr(&info), number)
    sys.putI32(@intFromPtr(&info) + 8, -1)
    sys.putI32(@intFromPtr(&info) + 16, @intCast(i32, sys.getPid()))
    sys.put32(@intFromPtr(&info) + 20, @intCast(u32, sys.syscall0(sys.SYS_getuid)))
    sys.putPointer(@intFromPtr(&info) + 24, value)
    return errno.checkStatus(sys.syscall3(129, sys.int(process), sys.int(number), @intFromPtr(&info)))
}

pub export fn raise(number: i32) -> i32 { return errno.checkStatus(sys.syscall3(sys.SYS_tgkill, @intCast(usize, sys.getPid()), @intCast(usize, sys.getTid()), sys.int(number))) }

pub export fn sigemptyset(set: usize) -> i32 {
    sys.fill(set, 0, 128)
    return 0
}

pub export fn sigfillset(set: usize) -> i32 {
    sys.fill(set, 255, 128)
    return 0
}

fn validSignal(number: i32) -> bool { return number >= 1 && number <= 64 }

pub export fn sigaddset(set: usize, number: i32) -> i32 {
    if !validSignal(number) { return errno.failWith(sys.EINVAL) }
    const bit = @intCast(usize, number - 1)
    sys.put64(set + (bit / 64) * 8, sys.get64(set + (bit / 64) * 8) | (@intCast(u64, 1) << @intCast(u6, bit % 64)))
    return 0
}

pub export fn sigdelset(set: usize, number: i32) -> i32 {
    if !validSignal(number) { return errno.failWith(sys.EINVAL) }
    const bit = @intCast(usize, number - 1)
    sys.put64(set + (bit / 64) * 8, sys.get64(set + (bit / 64) * 8) & ~(@intCast(u64, 1) << @intCast(u6, bit % 64)))
    return 0
}

pub export fn sigismember(set: usize, number: i32) -> i32 {
    if !validSignal(number) { return errno.failWith(sys.EINVAL) }
    const bit = @intCast(usize, number - 1)
    return if sys.get64(set + (bit / 64) * 8) & (@intCast(u64, 1) << @intCast(u6, bit % 64)) != 0 { 1 } else { 0 }
}

pub export fn sigisemptyset(set: usize) -> i32 { return if sys.get64(set) == 0 && sys.get64(set + 8) == 0 { 1 } else { 0 } }

pub export fn siginterrupt(number: i32, interrupt: i32) -> i32 {
    var action: [19]u64 = undefined
    if sigaction(number, 0, @intFromPtr(&action)) != 0 { return -1 }
    if interrupt != 0 { action[17] &= ~@intCast(u64, 268435456) } else { action[17] |= 268435456 }
    return sigaction(number, @intFromPtr(&action), 0)
}

pub export fn __libc_current_sigrtmin() -> i32 { return 34 }
pub export fn __libc_current_sigrtmax() -> i32 { return 64 }

pub export fn psignal(number: i32, prefix: usize) -> void {
    // "prefix: Name\n" on stderr, as perror's shape.
    const text = string.strsignal(number)
    if prefix != 0 && sys.get8(prefix) != 0 {
        const wrote_prefix = sys.syscall3(sys.SYS_write, 2, prefix, sys.length(prefix))
        const wrote_colon = sys.syscall3(sys.SYS_write, 2, sys.literal(": "), 2)
    }
    const wrote = sys.syscall3(sys.SYS_write, 2, text, sys.length(text))
    const wrote_newline = sys.syscall3(sys.SYS_write, 2, sys.literal("\n"), 1)
}

// The BSD mask calls: the low 32 signals.
pub export fn sigsetmask(mask: i32) -> i32 {
    var wanted: [2]u64 = [2]u64{ @intCast(u64, @bitCast(u32, mask)), 0 }
    var old: [2]u64 = [2]u64{ 0, 0 }
    const changed = sys.syscall4(sys.SYS_rt_sigprocmask, 2, @intFromPtr(&wanted), @intFromPtr(&old), 8)
    if sys.failed(changed) { return errno.failWith(@intCast(i32, 0 - changed)) }
    return @bitCast(i32, @intCast(u32, old[0] & 4294967295))
}

pub export fn siggetmask() -> i32 {
    var old: [2]u64 = [2]u64{ 0, 0 }
    const asked = sys.syscall4(sys.SYS_rt_sigprocmask, 0, 0, @intFromPtr(&old), 8)
    return @bitCast(i32, @intCast(u32, old[0] & 4294967295))
}
