// What the other headers leave: getopt, assert, paths (basename, dirname,
// realpath, mkstemp), the password and group files, the one locale,
// gettext as identity, the wide characters (UTF-8), err and warn, syslog,
// and the fortified copies of the memory and string functions.
const sys = @import("./sys.mlx")
const loader = @import("./loader.mlx")
const errno = @import("./errno.mlx")
const heap = @import("./heap.mlx")
const string = @import("./string.mlx")
const stdlib = @import("./stdlib.mlx")
const unistd = @import("./unistd.mlx")
const stdio = @import("./stdio.mlx")
const format = @import("./format.mlx")

// --- getopt ---------------------------------------------------------------------

pub export var optind: i32 = 1
pub export var opterr: i32 = 1
pub export var optopt: i32 = 63
pub export var optarg: usize = 0
var optionPosition: usize = 0

fn argumentAt(arguments: usize, index: i32) -> usize { return sys.getPointer(arguments + @intCast(usize, index) * 8) }

fn complain(program: usize, message: []const u8, option: usize, option_length: usize) -> void {
    if opterr == 0 { return }
    const err = stdio.standardErr()
    const name = if program != 0 { program } else { sys.literal("program") }
    const wrote_name = stdio.putBytes(err, name, sys.length(name))
    const wrote_colon = stdio.putBytes(err, sys.literal(": "), 2)
    const wrote_message = stdio.putBytes(err, sys.literal(message), message.length)
    const wrote_option = stdio.putBytes(err, option, option_length)
    const wrote_end = stdio.putBytes(err, sys.literal("'\n"), 2)
}

// getopt proper: the short options; a ':' after a letter means an
// argument, "::" an optional one; a leading ':' silences the messages and
// reports a missing argument as ':'.
pub export fn getopt(count: i32, arguments: usize, options: usize) -> i32 {
    optarg = 0
    if optind >= count { return -1 }
    const quiet = sys.get8(options) == 58
    const current = argumentAt(arguments, optind)
    if current == 0 { return -1 }
    if optionPosition == 0 {
        const first = sys.get8(current)
        if first != 45 || sys.get8(current + 1) == 0 { return -1 }
        if sys.get8(current + 1) == 45 && sys.get8(current + 2) == 0 {
            optind += 1
            return -1
        }
        optionPosition = 1
    }
    const letter = sys.get8(current + optionPosition)
    optionPosition += 1
    const found = string.strchr(options, @intCast(i32, letter))
    if found == 0 || letter == 58 {
        optopt = @intCast(i32, letter)
        if sys.get8(current + optionPosition) == 0 {
            optind += 1
            optionPosition = 0
        }
        complain(argumentAt(arguments, 0), "invalid option -- '", current + optionPosition - 1, 1)
        return 63
    }
    if sys.get8(found + 1) == 58 {
        // An argument: the rest of this word, or the next word.
        if sys.get8(current + optionPosition) != 0 {
            optarg = current + optionPosition
            optind += 1
            optionPosition = 0
            return @intCast(i32, letter)
        }
        optionPosition = 0
        if sys.get8(found + 2) == 58 {
            optind += 1
            return @intCast(i32, letter)
        }
        if optind + 1 >= count {
            optind += 1
            optopt = @intCast(i32, letter)
            if quiet { return 58 }
            complain(argumentAt(arguments, 0), "option requires an argument -- '", found, 1)
            return 63
        }
        optarg = argumentAt(arguments, optind + 1)
        optind += 2
        return @intCast(i32, letter)
    }
    if sys.get8(current + optionPosition) == 0 {
        optind += 1
        optionPosition = 0
    }
    return @intCast(i32, letter)
}

// struct option: name, has_arg (int), flag (int*), val (int); 32 bytes.
fn getoptLong(count: i32, arguments: usize, options: usize, longs: usize, index: usize, long_only: bool) -> i32 {
    optarg = 0
    if optind >= count { return -1 }
    const current = argumentAt(arguments, optind)
    if current == 0 { return -1 }
    const is_long = sys.get8(current) == 45 && sys.get8(current + 1) == 45 && sys.get8(current + 2) != 0
    if optionPosition == 0 && (is_long || (long_only && sys.get8(current) == 45 && sys.get8(current + 1) != 0 && string.strchr(options, @intCast(i32, sys.get8(current + 1))) == 0)) {
        const name_start = current + (if is_long { 2 } else { 1 })
        var name_length: usize = 0
        while sys.get8(name_start + name_length) != 0 && sys.get8(name_start + name_length) != 61 { name_length += 1 }
        var entry = longs
        var matched: usize = 0
        var matches: usize = 0
        var slot: usize = 0
        var at: usize = 0
        while sys.getPointer(entry) != 0 {
            const candidate = sys.getPointer(entry)
            if string.strncmp(candidate, name_start, name_length) == 0 {
                if sys.length(candidate) == name_length {
                    matched = entry
                    matches = 1
                    slot = at
                    break
                }
                if matches == 0 {
                    matched = entry
                    slot = at
                }
                matches += 1
            }
            entry += 32
            at += 1
        }
        optind += 1
        if matches != 1 {
            complain(argumentAt(arguments, 0), if matches == 0 { "unrecognized option '" } else { "option is ambiguous '" }, current, sys.length(current))
            optopt = 0
            return 63
        }
        const has_argument = sys.getI32(matched + 8)
        if sys.get8(name_start + name_length) == 61 {
            if has_argument == 0 {
                complain(argumentAt(arguments, 0), "option doesn't allow an argument -- '", current, sys.length(current))
                return 63
            }
            optarg = name_start + name_length + 1
        } else if has_argument == 1 {
            if optind >= count {
                complain(argumentAt(arguments, 0), "option requires an argument '", current, sys.length(current))
                return if sys.get8(options) == 58 { 58 } else { 63 }
            }
            optarg = argumentAt(arguments, optind)
            optind += 1
        }
        if index != 0 { sys.putI32(index, @intCast(i32, slot)) }
        const flag = sys.getPointer(matched + 16)
        const value = sys.getI32(matched + 24)
        if flag != 0 {
            sys.putI32(flag, value)
            return 0
        }
        return value
    }
    return getopt(count, arguments, options)
}

pub export fn getopt_long(count: i32, arguments: usize, options: usize, longs: usize, index: usize) -> i32 { return getoptLong(count, arguments, options, longs, index, false) }
pub export fn getopt_long_only(count: i32, arguments: usize, options: usize, longs: usize, index: usize) -> i32 { return getoptLong(count, arguments, options, longs, index, true) }

// --- assert and the stack protector ---------------------------------------------------

fn writeErr(text: usize) -> void { const wrote = sys.syscall3(sys.SYS_write, 2, text, sys.length(text)) }

pub export fn __assert_fail(assertion: usize, file: usize, line: u32, function: usize) -> void {
    var text: [1024]u8 = undefined
    var sink = format.bufferSink(@intFromPtr(&text), 1023)
    format.putAll(&sink, sys.slice(file))
    format.put(&sink, 58)
    var line_text: [12]u8 = undefined
    var count: usize = 0
    var value = line
    while true {
        line_text[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value /= 10
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        format.put(&sink, line_text[count])
    }
    format.putAll(&sink, ": ")
    if function != 0 {
        format.putAll(&sink, sys.slice(function))
        format.putAll(&sink, ": ")
    }
    format.putAll(&sink, "Assertion `")
    format.putAll(&sink, sys.slice(assertion))
    format.putAll(&sink, "' failed.\n")
    const wrote = sys.syscall3(sys.SYS_write, 2, @intFromPtr(&text), sink.length)
    stdlib.abort()
}

pub export fn __assert_perror_fail(code: i32, file: usize, line: u32, function: usize) -> void { __assert_fail(string.strerror(code), file, line, function) }
pub export fn __assert(assertion: usize, file: usize, line: i32) -> void { __assert_fail(assertion, file, @intCast(u32, line), 0) }

pub export fn __stack_chk_fail() -> void {
    writeErr(sys.literal("*** stack smashing detected ***: terminated\n"))
    stdlib.abort()
}

pub export fn __chk_fail() -> void {
    writeErr(sys.literal("*** buffer overflow detected ***: terminated\n"))
    stdlib.abort()
}

pub export fn __fortify_fail(message: usize) -> void {
    writeErr(sys.literal("*** "))
    writeErr(message)
    writeErr(sys.literal(" ***: terminated\n"))
    stdlib.abort()
}

// The fortified memory and string functions: the destination's known
// length is checked, then the plain function runs.
pub export fn __memcpy_chk(target: usize, source: usize, count: usize, room: usize) -> usize {
    if count > room { __chk_fail() }
    return string.memcpy(target, source, count)
}
pub export fn __memmove_chk(target: usize, source: usize, count: usize, room: usize) -> usize {
    if count > room { __chk_fail() }
    return string.memmove(target, source, count)
}
pub export fn __memset_chk(target: usize, value: i32, count: usize, room: usize) -> usize {
    if count > room { __chk_fail() }
    return string.memset(target, value, count)
}
pub export fn __strcpy_chk(target: usize, source: usize, room: usize) -> usize {
    if sys.length(source) + 1 > room { __chk_fail() }
    return string.strcpy(target, source)
}
pub export fn __stpcpy_chk(target: usize, source: usize, room: usize) -> usize {
    if sys.length(source) + 1 > room { __chk_fail() }
    return string.stpcpy(target, source)
}
pub export fn __strncpy_chk(target: usize, source: usize, count: usize, room: usize) -> usize {
    if count > room { __chk_fail() }
    return string.strncpy(target, source, count)
}
pub export fn __strcat_chk(target: usize, source: usize, room: usize) -> usize {
    if sys.length(target) + sys.length(source) + 1 > room { __chk_fail() }
    return string.strcat(target, source)
}
pub export fn __strncat_chk(target: usize, source: usize, count: usize, room: usize) -> usize {
    if sys.length(target) + string.strnlen(source, count) + 1 > room { __chk_fail() }
    return string.strncat(target, source, count)
}
pub export fn __read_chk(descriptor: i32, buffer: usize, count: usize, room: usize) -> isize {
    if count > room { __chk_fail() }
    return unistd.read(descriptor, buffer, count)
}
pub export fn __pread_chk(descriptor: i32, buffer: usize, count: usize, offset: i64, room: usize) -> isize {
    if count > room { __chk_fail() }
    return unistd.pread(descriptor, buffer, count, offset)
}
pub export fn __readlink_chk(path: usize, buffer: usize, size: usize, room: usize) -> isize {
    if size > room { __chk_fail() }
    return unistd.readlink(path, buffer, size)
}
pub export fn __getcwd_chk(buffer: usize, size: usize, room: usize) -> usize {
    if size > room { __chk_fail() }
    return unistd.getcwd(buffer, size)
}
pub export fn __realpath_chk(path: usize, resolved: usize, room: usize) -> usize {
    if room < 4096 { __chk_fail() }
    return realpath(path, resolved)
}
pub export fn __explicit_bzero_chk(target: usize, count: usize, room: usize) -> void {
    if count > room { __chk_fail() }
    sys.fill(target, 0, count)
}

// --- paths ------------------------------------------------------------------------

// The GNU basename: the text after the last slash, itself when there is
// none (the string is not changed).
pub export fn basename(path: usize) -> usize {
    const last = string.strrchr(path, 47)
    return if last == 0 { path } else { last + 1 }
}

// The POSIX basename and dirname (libgen.h): the path is edited.
pub export fn __xpg_basename(path: usize) -> usize {
    if path == 0 || sys.get8(path) == 0 { return sys.literal(".") }
    var end = sys.length(path)
    while end > 1 && sys.get8(path + end - 1) == 47 { end -= 1 }
    sys.put8(path + end, 0)
    if end == 1 && sys.get8(path) == 47 { return path }
    var start = end
    while start > 0 && sys.get8(path + start - 1) != 47 { start -= 1 }
    return path + start
}

pub export fn dirname(path: usize) -> usize {
    if path == 0 || sys.get8(path) == 0 { return sys.literal(".") }
    var end = sys.length(path)
    while end > 1 && sys.get8(path + end - 1) == 47 { end -= 1 }
    while end > 0 && sys.get8(path + end - 1) != 47 { end -= 1 }
    while end > 1 && sys.get8(path + end - 1) == 47 { end -= 1 }
    if end == 0 { return sys.literal(".") }
    sys.put8(path + end, 0)
    return path
}

// realpath: the path opened (O_PATH) and read back from /proc/self/fd.
pub export fn realpath(path: usize, resolved: usize) -> usize {
    if path == 0 || sys.get8(path) == 0 {
        errno.set(sys.EINVAL)
        return 0
    }
    const fd = unistd.open(path, 2097152 | 524288, 0)
    if fd < 0 { return 0 }
    var link: [32]u8 = undefined
    const prefix = "/proc/self/fd/"
    var at: usize = 0
    while at < prefix.length {
        link[at] = prefix[at]
        at += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var value = @intCast(u32, fd)
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value /= 10
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        link[at] = digits[count]
        at += 1
    }
    link[at] = 0
    var target = resolved
    if target == 0 {
        target = heap.allocate(4096, 16)
        if target == 0 {
            const closed = unistd.close(fd)
            return 0
        }
    }
    const got = sys.syscall3(sys.SYS_readlink, @intFromPtr(&link), target, 4095)
    const closed = unistd.close(fd)
    if sys.failed(got) {
        if resolved == 0 { heap.release(target) }
        errno.set(@intCast(i32, 0 - got))
        return 0
    }
    sys.put8(target + @bitCast(usize, got), 0)
    return target
}

pub export fn canonicalize_file_name(path: usize) -> usize { return realpath(path, 0) }

// --- the password and group files ---------------------------------------------------------
// struct passwd: name, passwd, uid, gid, gecos, dir, shell (48 bytes);
// struct group: name, passwd, gid, mem (32 bytes).

fn readFileInto(path: []const u8, buffer: usize, capacity: usize) -> usize {
    const fd = unistd.open(sys.literal(path), 0, 0)
    if fd < 0 { return 0 }
    var length: usize = 0
    while length < capacity - 1 {
        const got = sys.syscall3(sys.SYS_read, sys.int(fd), buffer + length, capacity - 1 - length)
        if got <= 0 { break }
        length += @bitCast(usize, got)
    }
    const closed = unistd.close(fd)
    sys.put8(buffer + length, 0)
    return length
}

// Splits the line at `start` (NUL-terminating the fields) into up to
// `count` fields; the number found.
fn splitFields(start: usize, end: usize, fields: *[16]usize, count: usize) -> usize {
    var found: usize = 0
    var at = start
    fields.*[0] = at
    found = 1
    while at < end && found < count {
        if sys.get8(at) == 58 {
            sys.put8(at, 0)
            fields.*[found] = at + 1
            found += 1
        }
        at += 1
    }
    sys.put8(end, 0)
    return found
}

fn parseUnsigned(text: usize) -> u32 { return @intCast(u32, stdlib.strtoul(text, 0, 10) & 4294967295) }

// The matching line of a file copied into `buffer`, its fields split.
fn findLine(path: []const u8, name: usize, identifier: u32, id_field: usize, buffer: usize, capacity: usize, fields: *[16]usize, field_count: usize) -> bool {
    var file: [65536]u8 = undefined
    const length = readFileInto(path, @intFromPtr(&file), 65536)
    var at: usize = 0
    while at < length {
        var end = at
        while end < length && file[end] != 10 { end += 1 }
        if end > at && end - at + 1 <= capacity {
            sys.copy(buffer, @intFromPtr(&file) + at, end - at)
            const found = splitFields(buffer, buffer + (end - at), fields, field_count)
            if found == field_count {
                const matches = if name != 0 { string.strcmp(fields.*[0], name) == 0 } else { parseUnsigned(fields.*[id_field]) == identifier }
                if matches { return true }
            }
        }
        at = end + 1
    }
    return false
}

fn fillPasswd(result: usize, fields: *[16]usize) -> void {
    sys.putPointer(result, fields.*[0])
    sys.putPointer(result + 8, fields.*[1])
    sys.put32(result + 16, parseUnsigned(fields.*[2]))
    sys.put32(result + 20, parseUnsigned(fields.*[3]))
    sys.putPointer(result + 24, fields.*[4])
    sys.putPointer(result + 32, fields.*[5])
    sys.putPointer(result + 40, fields.*[6])
}

fn passwdLookup(name: usize, identifier: u32, result: usize, buffer: usize, capacity: usize, out: usize) -> i32 {
    var fields: [16]usize = undefined
    if !findLine("/etc/passwd", name, identifier, 2, buffer, capacity, &fields, 7) {
        if out != 0 { sys.putPointer(out, 0) }
        return 0
    }
    fillPasswd(result, &fields)
    if out != 0 { sys.putPointer(out, result) }
    return 0
}

var passwdRecord: [48]u8 = undefined
var passwdBuffer: [1024]u8 = undefined
var groupRecord: [32]u8 = undefined
var groupBuffer: [1024]u8 = undefined
var groupMembers: [64]usize = undefined

pub export fn getpwnam_r(name: usize, result: usize, buffer: usize, capacity: usize, out: usize) -> i32 { return passwdLookup(name, 0, result, buffer, capacity, out) }
pub export fn getpwuid_r(identifier: u32, result: usize, buffer: usize, capacity: usize, out: usize) -> i32 { return passwdLookup(0, identifier, result, buffer, capacity, out) }

pub export fn getpwnam(name: usize) -> usize {
    var out: usize = 0
    const status = getpwnam_r(name, @intFromPtr(&passwdRecord), @intFromPtr(&passwdBuffer), 1024, @intFromPtr(&out))
    return out
}

pub export fn getpwuid(identifier: u32) -> usize {
    var out: usize = 0
    const status = getpwuid_r(identifier, @intFromPtr(&passwdRecord), @intFromPtr(&passwdBuffer), 1024, @intFromPtr(&out))
    return out
}

fn fillGroup(result: usize, fields: *[16]usize, members: usize) -> void {
    sys.putPointer(result, fields.*[0])
    sys.putPointer(result + 8, fields.*[1])
    sys.put32(result + 16, parseUnsigned(fields.*[2]))
    // The members: a list split at commas.
    var count: usize = 0
    var at = fields.*[3]
    if sys.get8(at) != 0 {
        sys.putPointer(members, at)
        count = 1
        while sys.get8(at) != 0 && count < 63 {
            if sys.get8(at) == 44 {
                sys.put8(at, 0)
                sys.putPointer(members + count * 8, at + 1)
                count += 1
            }
            at += 1
        }
    }
    sys.putPointer(members + count * 8, 0)
    sys.putPointer(result + 24, members)
}

fn groupLookup(name: usize, identifier: u32, result: usize, buffer: usize, capacity: usize, out: usize) -> i32 {
    var fields: [16]usize = undefined
    if capacity < 600 || !findLine("/etc/group", name, identifier, 2, buffer, capacity - 520, &fields, 4) {
        if out != 0 { sys.putPointer(out, 0) }
        return if capacity < 600 { sys.ERANGE } else { 0 }
    }
    // The member pointers live at the end of the caller's buffer.
    fillGroup(result, &fields, (buffer + capacity - 512) & ~@intCast(usize, 7))
    if out != 0 { sys.putPointer(out, result) }
    return 0
}

pub export fn getgrnam_r(name: usize, result: usize, buffer: usize, capacity: usize, out: usize) -> i32 { return groupLookup(name, 0, result, buffer, capacity, out) }
pub export fn getgrgid_r(identifier: u32, result: usize, buffer: usize, capacity: usize, out: usize) -> i32 { return groupLookup(0, identifier, result, buffer, capacity, out) }

pub export fn getgrnam(name: usize) -> usize {
    var out: usize = 0
    const status = getgrnam_r(name, @intFromPtr(&groupRecord), @intFromPtr(&groupBuffer), 1024, @intFromPtr(&out))
    return out
}

pub export fn getgrgid(identifier: u32) -> usize {
    var out: usize = 0
    const status = getgrgid_r(identifier, @intFromPtr(&groupRecord), @intFromPtr(&groupBuffer), 1024, @intFromPtr(&out))
    return out
}

pub export fn getlogin() -> usize {
    const entry = getpwuid(unistd.getuid())
    if entry == 0 { return 0 }
    return sys.getPointer(entry)
}

pub export fn getlogin_r(buffer: usize, size: usize) -> i32 {
    const name = getlogin()
    if name == 0 { return sys.ENOENT }
    if sys.length(name) + 1 > size { return sys.ERANGE }
    sys.copy(buffer, name, sys.length(name) + 1)
    return 0
}

// --- the locale: there is one, C -----------------------------------------------------------

var cName: [2]u8 = [2]u8{ 67, 0 }

pub export fn setlocale(category: i32, locale: usize) -> usize {
    if locale != 0 && sys.get8(locale) != 0 && string.strcmp(locale, sys.literal("C")) != 0 && string.strcmp(locale, sys.literal("POSIX")) != 0 && string.strcmp(locale, sys.literal("C.UTF-8")) != 0 { return 0 }
    return @intFromPtr(&cName)
}

pub export fn newlocale(mask: i32, locale: usize, base: usize) -> usize { return 1 }
pub export fn duplocale(locale: usize) -> usize { return locale }
pub export fn freelocale(locale: usize) -> void {}
pub export fn uselocale(locale: usize) -> usize { return 1 }

// struct lconv: the C locale's values.
var lconvRecord: [96]u8 = undefined
var lconvReady: bool = false
var emptyText: [1]u8 = [1]u8{ 0 }
var pointText: [2]u8 = [2]u8{ 46, 0 }

pub export fn localeconv() -> usize {
    if !lconvReady {
        sys.fill(@intFromPtr(&lconvRecord), 0, 96)
        sys.putPointer(@intFromPtr(&lconvRecord), @intFromPtr(&pointText))
        var index: usize = 1
        while index < 10 {
            sys.putPointer(@intFromPtr(&lconvRecord) + index * 8, @intFromPtr(&emptyText))
            index += 1
        }
        // The char fields are CHAR_MAX (127) in the C locale.
        sys.fill(@intFromPtr(&lconvRecord) + 80, 127, 14)
        lconvReady = true
    }
    return @intFromPtr(&lconvRecord)
}

pub export fn nl_langinfo(item: i32) -> usize {
    if item == 14 { return sys.literal("ANSI_X3.4-1968") }
    if item == 65536 + 49 { return sys.literal(".") }
    return sys.literal("")
}

pub export fn nl_langinfo_l(item: i32, locale: usize) -> usize { return nl_langinfo(item) }

// gettext: the messages as written.
pub export fn gettext(message: usize) -> usize { return message }
pub export fn dgettext(domain: usize, message: usize) -> usize { return message }
pub export fn dcgettext(domain: usize, message: usize, category: i32) -> usize { return message }
pub export fn ngettext(singular: usize, plural: usize, count: u64) -> usize { return if count == 1 { singular } else { plural } }
pub export fn dngettext(domain: usize, singular: usize, plural: usize, count: u64) -> usize { return ngettext(singular, plural, count) }
pub export fn dcngettext(domain: usize, singular: usize, plural: usize, count: u64, category: i32) -> usize { return ngettext(singular, plural, count) }
pub export fn textdomain(domain: usize) -> usize { return if domain != 0 { domain } else { sys.literal("messages") } }
pub export fn bindtextdomain(domain: usize, directory: usize) -> usize { return directory }
pub export fn bind_textdomain_codeset(domain: usize, codeset: usize) -> usize { return codeset }

// --- wide characters: UTF-8 -----------------------------------------------------------

// The code point at `text` (up to `limit` bytes): (code, bytes), bytes 0
// at a NUL, (0, -1) for an invalid or incomplete sequence (as 2^64-1).
fn decodeUtf8(text: usize, limit: usize) -> (u32, usize) {
    if limit == 0 { return -> (0, 18446744073709551614) }
    const first = sys.get8(text)
    if first < 128 { return -> (@intCast(u32, first), if first == 0 { 0 } else { 1 }) }
    var count: usize = 0
    var code: u32 = 0
    if first >= 194 && first < 224 {
        count = 2
        code = @intCast(u32, first & 31)
    } else if first >= 224 && first < 240 {
        count = 3
        code = @intCast(u32, first & 15)
    } else if first >= 240 && first < 245 {
        count = 4
        code = @intCast(u32, first & 7)
    } else {
        return -> (0, 18446744073709551615)
    }
    var index: usize = 1
    while index < count {
        if index >= limit { return -> (0, 18446744073709551614) }
        const byte = sys.get8(text + index)
        if byte & 192 != 128 { return -> (0, 18446744073709551615) }
        code = (code << 6) | @intCast(u32, byte & 63)
        index += 1
    }
    return -> (code, count)
}

fn encodeUtf8(code: u32, target: usize) -> usize {
    if code < 128 {
        sys.put8(target, @intCast(u8, code))
        return 1
    }
    if code < 2048 {
        sys.put8(target, @intCast(u8, 192 | (code >> 6)))
        sys.put8(target + 1, @intCast(u8, 128 | (code & 63)))
        return 2
    }
    if code < 65536 {
        sys.put8(target, @intCast(u8, 224 | (code >> 12)))
        sys.put8(target + 1, @intCast(u8, 128 | ((code >> 6) & 63)))
        sys.put8(target + 2, @intCast(u8, 128 | (code & 63)))
        return 3
    }
    sys.put8(target, @intCast(u8, 240 | (code >> 18)))
    sys.put8(target + 1, @intCast(u8, 128 | ((code >> 12) & 63)))
    sys.put8(target + 2, @intCast(u8, 128 | ((code >> 6) & 63)))
    sys.put8(target + 3, @intCast(u8, 128 | (code & 63)))
    return 4
}

pub export fn mbrtowc(target: usize, text: usize, limit: usize, state: usize) -> usize {
    if text == 0 { return 0 }
    const decoded = decodeUtf8(text, limit)
    if decoded.1 == 18446744073709551615 {
        errno.set(sys.EILSEQ)
        return 18446744073709551615
    }
    if decoded.1 == 18446744073709551614 { return 18446744073709551614 }
    if target != 0 { sys.put32(target, decoded.0) }
    return decoded.1
}

pub export fn mbtowc(target: usize, text: usize, limit: usize) -> i32 {
    if text == 0 { return 0 }
    const got = mbrtowc(target, text, limit, 0)
    if got == 18446744073709551615 || got == 18446744073709551614 { return -1 }
    return @intCast(i32, got)
}

pub export fn mbrlen(text: usize, limit: usize, state: usize) -> usize { return mbrtowc(0, text, limit, state) }
pub export fn mblen(text: usize, limit: usize) -> i32 { return mbtowc(0, text, limit) }
pub export fn mbsinit(state: usize) -> i32 { return 1 }

pub export fn wcrtomb(target: usize, code: u32, state: usize) -> usize {
    if target == 0 { return 1 }
    if code > 1114111 || (code >= 55296 && code < 57344) {
        errno.set(sys.EILSEQ)
        return 18446744073709551615
    }
    return encodeUtf8(code, target)
}

pub export fn wctomb(target: usize, code: u32) -> i32 {
    if target == 0 { return 0 }
    const got = wcrtomb(target, code, 0)
    if got == 18446744073709551615 { return -1 }
    return @intCast(i32, got)
}

pub export fn mbstowcs(target: usize, text: usize, limit: usize) -> usize {
    var at: usize = 0
    var count: usize = 0
    while target == 0 || count < limit {
        const decoded = decodeUtf8(text + at, 18446744073709551615)
        if decoded.1 >= 18446744073709551614 {
            errno.set(sys.EILSEQ)
            return 18446744073709551615
        }
        if decoded.1 == 0 {
            if target != 0 { sys.put32(target + count * 4, 0) }
            return count
        }
        if target != 0 { sys.put32(target + count * 4, decoded.0) }
        count += 1
        at += decoded.1
    }
    return count
}

pub export fn mbsrtowcs(target: usize, source: usize, limit: usize, state: usize) -> usize {
    const text = sys.getPointer(source)
    const count = mbstowcs(target, text, limit)
    if target != 0 && count != 18446744073709551615 {
        var at: usize = 0
        var seen: usize = 0
        while seen < count {
            at += decodeUtf8(text + at, 18446744073709551615).1
            seen += 1
        }
        sys.putPointer(source, if count < limit { 0 } else { text + at })
    }
    return count
}

pub export fn wcstombs(target: usize, codes: usize, limit: usize) -> usize {
    var count: usize = 0
    var index: usize = 0
    while true {
        const code = sys.get32(codes + index * 4)
        if code == 0 {
            if target != 0 && count < limit { sys.put8(target + count, 0) }
            return count
        }
        var scratch: [4]u8 = undefined
        const length = encodeUtf8(code, @intFromPtr(&scratch))
        if target != 0 {
            if count + length > limit { return count }
            sys.copy(target + count, @intFromPtr(&scratch), length)
        }
        count += length
        index += 1
    }
    return count
}

pub export fn wcsrtombs(target: usize, source: usize, limit: usize, state: usize) -> usize {
    const count = wcstombs(target, sys.getPointer(source), limit)
    if target != 0 && count < limit { sys.putPointer(source, 0) }
    return count
}

pub export fn btowc(value: i32) -> u32 { return if value >= 0 && value < 128 { @intCast(u32, value) } else { 4294967295 } }
pub export fn wctob(code: u32) -> i32 { return if code < 128 { @intCast(i32, code) } else { -1 } }

pub export fn wcslen(codes: usize) -> usize {
    var count: usize = 0
    while sys.get32(codes + count * 4) != 0 { count += 1 }
    return count
}

pub export fn wcsnlen(codes: usize, limit: usize) -> usize {
    var count: usize = 0
    while count < limit && sys.get32(codes + count * 4) != 0 { count += 1 }
    return count
}

pub export fn wcscmp(first: usize, second: usize) -> i32 {
    var index: usize = 0
    while true {
        const a = sys.get32(first + index * 4)
        const b = sys.get32(second + index * 4)
        if a != b { return if a < b { -1 } else { 1 } }
        if a == 0 { return 0 }
        index += 1
    }
    return 0
}

pub export fn wcsncmp(first: usize, second: usize, count: usize) -> i32 {
    var index: usize = 0
    while index < count {
        const a = sys.get32(first + index * 4)
        const b = sys.get32(second + index * 4)
        if a != b { return if a < b { -1 } else { 1 } }
        if a == 0 { return 0 }
        index += 1
    }
    return 0
}

pub export fn wcscpy(target: usize, source: usize) -> usize {
    const count = wcslen(source)
    sys.copy(target, source, (count + 1) * 4)
    return target
}

pub export fn wcsncpy(target: usize, source: usize, count: usize) -> usize {
    var index: usize = 0
    while index < count && sys.get32(source + index * 4) != 0 {
        sys.put32(target + index * 4, sys.get32(source + index * 4))
        index += 1
    }
    while index < count {
        sys.put32(target + index * 4, 0)
        index += 1
    }
    return target
}

pub export fn wcscat(target: usize, source: usize) -> usize {
    const unused = wcscpy(target + wcslen(target) * 4, source)
    return target
}

pub export fn wcschr(codes: usize, code: u32) -> usize {
    var index: usize = 0
    while true {
        const value = sys.get32(codes + index * 4)
        if value == code { return codes + index * 4 }
        if value == 0 { return 0 }
        index += 1
    }
    return 0
}

pub export fn wcsrchr(codes: usize, code: u32) -> usize {
    var found: usize = 0
    var index: usize = 0
    while true {
        const value = sys.get32(codes + index * 4)
        if value == code { found = codes + index * 4 }
        if value == 0 { return found }
        index += 1
    }
    return found
}

pub export fn wcsstr(haystack: usize, needle: usize) -> usize {
    const needle_length = wcslen(needle)
    if needle_length == 0 { return haystack }
    var at: usize = 0
    while sys.get32(haystack + at * 4) != 0 {
        if wcsncmp(haystack + at * 4, needle, needle_length) == 0 { return haystack + at * 4 }
        at += 1
    }
    return 0
}

pub export fn wcsdup(codes: usize) -> usize {
    const count = wcslen(codes)
    const copy = heap.allocate((count + 1) * 4, 16)
    if copy == 0 { return 0 }
    sys.copy(copy, codes, (count + 1) * 4)
    return copy
}

pub export fn wmemcpy(target: usize, source: usize, count: usize) -> usize {
    sys.copy(target, source, count * 4)
    return target
}

pub export fn wmemmove(target: usize, source: usize, count: usize) -> usize {
    sys.copy(target, source, count * 4)
    return target
}

pub export fn wmemset(target: usize, code: u32, count: usize) -> usize {
    var index: usize = 0
    while index < count {
        sys.put32(target + index * 4, code)
        index += 1
    }
    return target
}

pub export fn wmemcmp(first: usize, second: usize, count: usize) -> i32 {
    var index: usize = 0
    while index < count {
        const a = sys.get32(first + index * 4)
        const b = sys.get32(second + index * 4)
        if a != b { return if a < b { -1 } else { 1 } }
        index += 1
    }
    return 0
}

pub export fn wmemchr(codes: usize, code: u32, count: usize) -> usize {
    var index: usize = 0
    while index < count {
        if sys.get32(codes + index * 4) == code { return codes + index * 4 }
        index += 1
    }
    return 0
}

pub export fn wcwidth(code: u32) -> i32 {
    if code == 0 { return 0 }
    if code < 32 || (code >= 127 && code < 160) { return -1 }
    // Combining marks take no column; the East Asian wide ranges two.
    if (code >= 768 && code <= 879) || (code >= 8203 && code <= 8207) { return 0 }
    if (code >= 4352 && code <= 4447) || (code >= 11904 && code <= 42191) || (code >= 44032 && code <= 55203) || (code >= 63744 && code <= 64255) || (code >= 65040 && code <= 65049) || (code >= 65072 && code <= 65135) || (code >= 65280 && code <= 65376) || (code >= 65504 && code <= 65510) || (code >= 127744 && code <= 129791) || (code >= 131072 && code <= 196605) { return 2 }
    return 1
}

pub export fn wcswidth(codes: usize, count: usize) -> i32 {
    var total: i32 = 0
    var index: usize = 0
    while index < count && sys.get32(codes + index * 4) != 0 {
        const width = wcwidth(sys.get32(codes + index * 4))
        if width < 0 { return -1 }
        total += width
        index += 1
    }
    return total
}

pub export fn iswalpha(code: u32) -> i32 { return if (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code >= 192 { 1 } else { 0 } }
pub export fn iswdigit(code: u32) -> i32 { return if code >= 48 && code <= 57 { 1 } else { 0 } }
pub export fn iswspace(code: u32) -> i32 { return if code == 32 || (code >= 9 && code <= 13) || code == 133 || code == 160 || code == 8232 || code == 8233 { 1 } else { 0 } }
pub export fn iswupper(code: u32) -> i32 { return if code >= 65 && code <= 90 { 1 } else { 0 } }
pub export fn iswlower(code: u32) -> i32 { return if code >= 97 && code <= 122 { 1 } else { 0 } }
pub export fn iswalnum(code: u32) -> i32 { return if iswalpha(code) != 0 || iswdigit(code) != 0 { 1 } else { 0 } }
pub export fn iswprint(code: u32) -> i32 { return if (code >= 32 && code < 127) || code >= 160 { 1 } else { 0 } }
pub export fn iswpunct(code: u32) -> i32 { return if iswprint(code) != 0 && iswalnum(code) == 0 && code != 32 { 1 } else { 0 } }
pub export fn iswcntrl(code: u32) -> i32 { return if code < 32 || (code >= 127 && code < 160) { 1 } else { 0 } }
pub export fn iswblank(code: u32) -> i32 { return if code == 32 || code == 9 { 1 } else { 0 } }
pub export fn iswxdigit(code: u32) -> i32 { return if (code >= 48 && code <= 57) || (code >= 65 && code <= 70) || (code >= 97 && code <= 102) { 1 } else { 0 } }
pub export fn towlower(code: u32) -> u32 { return if code >= 65 && code <= 90 { code + 32 } else { code } }
pub export fn towupper(code: u32) -> u32 { return if code >= 97 && code <= 122 { code - 32 } else { code } }

// --- err.h and error -----------------------------------------------------------------

// The program's name as the loader saw it (start.mlx), else from
// /proc/self/cmdline when this library is loaded into some other program.
pub fn setProgramName(argv0: usize) -> void {
    if argv0 == 0 { return }
    program_invocation_name = argv0
    program_invocation_short_name = basename(argv0)
}

fn programName() -> usize {
    if program_invocation_short_name != 0 { return program_invocation_short_name }
    var buffer: [256]u8 = undefined
    const fd = unistd.open(sys.literal("/proc/self/cmdline"), 0, 0)
    if fd < 0 { return sys.literal("program") }
    const got = sys.syscall3(sys.SYS_read, sys.int(fd), @intFromPtr(&buffer), 255)
    const closed = unistd.close(fd)
    if got <= 0 { return sys.literal("program") }
    buffer[@bitCast(usize, got)] = 0
    const copy = string.strdup(@intFromPtr(&buffer))
    if copy == 0 { return sys.literal("program") }
    return basename(copy)
}

pub export var program_invocation_name: usize = 0
pub export var program_invocation_short_name: usize = 0

fn messageToErr(pattern: usize, source: *format.Source, with_error: bool, code: i32) -> void {
    const err = stdio.standardErr()
    const name = programName()
    var chunk: [512]u8 = undefined
    var sink = format.streamSink(@intFromPtr(writeChunk), err, @intFromPtr(&chunk), 512)
    format.putAll(&sink, sys.slice(name))
    format.putAll(&sink, ": ")
    if pattern != 0 { format.format(&sink, pattern, source) }
    if with_error {
        if pattern != 0 { format.putAll(&sink, ": ") }
        format.putAll(&sink, string.message(code))
    }
    format.put(&sink, 10)
    format.flush(&sink)
}

fn writeChunk(context: usize, bytes: usize, count: usize) -> void { const wrote = stdio.putBytes(context, bytes, count) }

pub export fn warn(pattern: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: format.CallList = undefined
    var words: [6]usize = [6]usize{ pattern, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    var source = format.callSource(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    messageToErr(pattern, &source, true, errno.get())
}

pub export fn warnx(pattern: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: format.CallList = undefined
    var words: [6]usize = [6]usize{ pattern, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    var source = format.callSource(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    messageToErr(pattern, &source, false, 0)
}

pub export fn err(status: i32, pattern: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: format.CallList = undefined
    var words: [6]usize = [6]usize{ sys.int(status), pattern, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    var source = format.callSource(&call, 2, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    messageToErr(pattern, &source, true, errno.get())
    stdlib.exit(status)
}

pub export fn errx(status: i32, pattern: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: format.CallList = undefined
    var words: [6]usize = [6]usize{ sys.int(status), pattern, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    var source = format.callSource(&call, 2, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    messageToErr(pattern, &source, false, 0)
    stdlib.exit(status)
}

// (glibc's error(): `error` is a keyword of Mlx, so the export waits for a
// way to name a symbol apart from its function.)

// --- syslog: datagrams to /dev/log -----------------------------------------------------------

var syslogIdentity: usize = 0
var syslogFacility: i32 = 8
var syslogOptions: i32 = 0
var syslogSocket: i32 = -1
var syslogLock: u32 = 0

pub export fn openlog(identity: usize, options: i32, facility: i32) -> void {
    syslogIdentity = identity
    syslogOptions = options
    if facility != 0 { syslogFacility = facility }
}

pub export fn closelog() -> void {
    if syslogSocket >= 0 { const closed = unistd.close(syslogSocket) }
    syslogSocket = -1
}

pub export fn setlogmask(mask: i32) -> i32 { return 255 }

pub export fn vsyslog(priority: i32, pattern: usize, list: usize) -> void {
    var text: [2048]u8 = undefined
    var sink = format.bufferSink(@intFromPtr(&text), 2047)
    format.put(&sink, 60)
    var level = priority
    if level & 1016 == 0 { level |= syslogFacility }
    var digits: [8]u8 = undefined
    var count: usize = 0
    var value = @intCast(u32, level)
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value /= 10
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        format.put(&sink, digits[count])
    }
    format.put(&sink, 62)
    if syslogIdentity != 0 { format.putAll(&sink, sys.slice(syslogIdentity)) } else { format.putAll(&sink, sys.slice(programName())) }
    if syslogOptions & 1 != 0 {
        format.put(&sink, 91)
        var pid_digits: [12]u8 = undefined
        var pid_count: usize = 0
        var pid = sys.getPid()
        while true {
            pid_digits[pid_count] = @intCast(u8, 48 + pid % 10)
            pid_count += 1
            pid /= 10
            if pid == 0 { break }
        }
        while pid_count > 0 {
            pid_count -= 1
            format.put(&sink, pid_digits[pid_count])
        }
        format.put(&sink, 93)
    }
    format.putAll(&sink, ": ")
    var source = format.vaList(list)
    format.format(&sink, pattern, &source)
    sys.lock(@ptrCast(*u32, &syslogLock))
    if syslogSocket < 0 {
        syslogSocket = unistd.socket(1, 2 | 524288, 0)
        if syslogSocket >= 0 {
            var address: [110]u8 = undefined
            sys.fill(@intFromPtr(&address), 0, 110)
            sys.put16(@intFromPtr(&address), 1)
            sys.copy(@intFromPtr(&address) + 2, sys.literal("/dev/log"), 9)
            if unistd.connect(syslogSocket, @intFromPtr(&address), 11) != 0 {
                const closed = unistd.close(syslogSocket)
                syslogSocket = -1
            }
        }
    }
    if syslogSocket >= 0 {
        const sent = unistd.send(syslogSocket, @intFromPtr(&text), sink.length, 16384)
    } else if syslogOptions & 32 != 0 {
        text[sink.length] = 10
        const wrote = sys.syscall3(sys.SYS_write, 2, @intFromPtr(&text), sink.length + 1)
    }
    sys.unlock(@ptrCast(*u32, &syslogLock))
}

pub export fn syslog(priority: i32, pattern: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: format.CallList = undefined
    var words: [6]usize = [6]usize{ sys.int(priority), pattern, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    var source = format.callSource(&call, 2, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    var text: [2048]u8 = undefined
    var sink = format.bufferSink(@intFromPtr(&text), 2047)
    format.format(&sink, pattern, &source)
    sys.put8(@intFromPtr(&text) + sink.length, 0)
    // The formatted text through vsyslog's path with no further conversions.
    var list: [4]u64 = [4]u64{ 48, 176, 0, 0 }
    var holder: [1]usize = [1]usize{ @intFromPtr(&text) }
    list[2] = @intCast(u64, @intFromPtr(&holder))
    vsyslog(priority, sys.literal("%s"), @intFromPtr(&list))
}

// --- odds and ends -----------------------------------------------------------------------

pub export var __libc_single_threaded: u8 = 0

pub export fn getauxval(kind: u64) -> u64 {
    if loader.active {
        const value = loader.auxValue(@intCast(usize, kind))
        if value == 0 { errno.set(sys.ENOENT) }
        return @intCast(u64, value)
    }
    // AT_PAGESZ is the one value asked for without a loader of our own.
    if kind == 6 { return 4096 }
    errno.set(sys.ENOENT)
    return 0
}

pub export fn confstr(name: i32, buffer: usize, size: usize) -> usize {
    const value = if name == 0 { "/bin:/usr/bin" } else { "" }
    if buffer != 0 && size > 0 {
        const copied = if value.length < size - 1 { value.length } else { size - 1 }
        sys.copy(buffer, sys.literal(value), copied)
        sys.put8(buffer + copied, 0)
    }
    return value.length + 1
}

pub export fn gethostid() -> i64 { return 0 }

pub export fn getpass(prompt: usize) -> usize {
    errno.set(sys.ENOSYS)
    return 0
}

pub export fn __isoc99_strtol(text: usize, end: usize, base: i32) -> i64 { return stdlib.strtol(text, end, base) }

// --- what glibc-linked programs ask for besides -----------------------------------

pub export fn __ctype_get_mb_cur_max() -> usize { return 1 }

pub export fn __mempcpy_chk(target: usize, source: usize, count: usize, capacity: usize) -> usize {
    if count > capacity { __chk_fail() }
    return string.mempcpy(target, source, count)
}

// char32_t is wchar_t's size here: the same decoding.
pub export fn mbrtoc32(target: usize, text: usize, limit: usize, state: usize) -> usize { return mbrtowc(target, text, limit, state) }

const TIOCGPGRP: u64 = 21519
const TIOCSPGRP: u64 = 21520

pub export fn tcgetpgrp(descriptor: i32) -> i32 {
    var group: i32 = 0
    if unistd.ioctl(descriptor, TIOCGPGRP, @intFromPtr(&group)) < 0 { return -1 }
    return group
}

pub export fn tcsetpgrp(descriptor: i32, group: i32) -> i32 {
    var value: i32 = group
    return unistd.ioctl(descriptor, TIOCSPGRP, @intFromPtr(&value))
}

// error(3) of glibc: `error` is a keyword of Mlx, so the function is
// exported as __mlx_error and the loader (loader.mlx) binds the name
// `error` to it.
pub export var error_message_count: u32 = 0
pub export var error_one_per_line: i32 = 0
pub export var error_print_progname: usize = 0

pub export fn __mlx_error(status: i32, errnum: i32, pattern: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: format.CallList = undefined
    var words: [6]usize = [6]usize{ sys.int(status), sys.int(errnum), pattern, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    var source = format.callSource(&call, 3, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    const flushed = stdio.fflush(stdio.standardOut())
    messageToErr(pattern, &source, errnum != 0, errnum)
    error_message_count += 1
    if status != 0 { stdlib.exit(status) }
}
