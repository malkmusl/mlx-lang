// dlfcn.h: nothing loads yet. Until mlxlibc has its own dynamic loader
// (the next step of the project), these answer failure with a message.
const sys = @import("./sys.mlx")

var lastError: usize = 0

pub export fn dlopen(path: usize, flags: i32) -> usize {
    lastError = sys.literal("mlxlibc: dlopen is not available yet (no dynamic loader)")
    return 0
}

pub export fn dlsym(handle: usize, name: usize) -> usize {
    lastError = sys.literal("mlxlibc: dlsym is not available yet (no dynamic loader)")
    return 0
}

pub export fn dlvsym(handle: usize, name: usize, version: usize) -> usize { return dlsym(handle, name) }

pub export fn dlclose(handle: usize) -> i32 {
    lastError = sys.literal("mlxlibc: dlclose is not available yet (no dynamic loader)")
    return -1
}

pub export fn dlerror() -> usize {
    const message = lastError
    lastError = 0
    return message
}

pub export fn dladdr(address: usize, info: usize) -> i32 { return 0 }
pub export fn dladdr1(address: usize, info: usize, extra: usize, flags: i32) -> i32 { return 0 }
pub export fn dlinfo(handle: usize, request: i32, info: usize) -> i32 { return -1 }
pub export fn dl_iterate_phdr(callback: usize, data: usize) -> i32 { return 0 }
