// dlfcn.h on loader.mlx: dlopen maps a library and what it needs into
// the process this library is the loader of, dlsym finds names in it,
// dladdr and dl_iterate_phdr describe what is loaded. In a process another
// loader started (glibc's ld.so loading this library as a plugin's libc)
// these answer failure with a message.
const sys = @import("./sys.mlx")
const loader = @import("./loader.mlx")

const RTLD_NEXT: usize = 18446744073709551615
const RTLD_DI_LINKMAP: i32 = 2

var lastError: usize = 0

fn notLoader() -> usize {
    lastError = sys.literal("mlxlibc: not this process's dynamic loader (the program was started by another)")
    return 0
}

pub export fn dlopen(path: usize, flags: i32) -> usize {
    if !loader.active { return notLoader() }
    if path == 0 { return loader.programModule }
    loader.lock()
    const module = loader.open(path)
    if module == 0 { lastError = if loader.failure != 0 { loader.failure } else { sys.literal("mlxlibc: dlopen failed") } }
    loader.unlock()
    return module
}

pub export fn dlsym(handle: usize, name: usize) -> usize {
    if !loader.active { return notLoader() }
    var address: usize = 0
    if handle == 0 {
        address = loader.symbolGlobal(name)
    } else if handle == RTLD_NEXT {
        // The caller: its return address is one word above this frame.
        address = loader.symbolAfter(sys.getPointer(@frameAddress() + 8), name)
    } else {
        address = loader.symbolIn(handle, name)
    }
    if address == 0 { lastError = sys.literal("mlxlibc: dlsym: undefined symbol") }
    return address
}

pub export fn dlvsym(handle: usize, name: usize, version: usize) -> usize { return dlsym(handle, name) }

pub export fn dlclose(handle: usize) -> i32 {
    if !loader.active {
        const ignored = notLoader()
        return -1
    }
    if handle != 0 && handle != loader.programModule { loader.release(handle) }
    return 0
}

pub export fn dlerror() -> usize {
    const message = lastError
    lastError = 0
    return message
}

// Dl_info: dli_fname, dli_fbase, dli_sname, dli_saddr.
pub export fn dladdr(address: usize, info: usize) -> i32 {
    if !loader.active { return 0 }
    const module = loader.moduleOf(address)
    if module == 0 { return 0 }
    sys.putPointer(info, sys.getPointer(module + loader.M_NAME))
    sys.putPointer(info + 8, sys.getPointer(module + loader.M_MAP_START))
    const nearest = loader.nearestSymbol(module, address)
    sys.putPointer(info + 16, nearest.0)
    sys.putPointer(info + 24, nearest.1)
    return 1
}

pub export fn dladdr1(address: usize, info: usize, extra: usize, flags: i32) -> i32 {
    if extra != 0 { sys.putPointer(extra, 0) }
    return dladdr(address, info)
}

pub export fn dlinfo(handle: usize, request: i32, info: usize) -> i32 {
    if !loader.active || handle == 0 { return -1 }
    if request == RTLD_DI_LINKMAP {
        sys.putPointer(info, handle)
        return 0
    }
    lastError = sys.literal("mlxlibc: dlinfo: unsupported request")
    return -1
}

// callback(struct dl_phdr_info*, size, data) for every module: addr,
// name, phdr, phnum, adds, subs, tls_modid, tls_data (64 bytes).
pub export fn dl_iterate_phdr(callback: usize, data: usize) -> i32 {
    if !loader.active { return 0 }
    var info: [8]u64 = [8]u64{ 0, 0, 0, 0, 0, 0, 0, 0 }
    var module = loader.first
    var result: i32 = 0
    while module != 0 && result == 0 {
        info[0] = @intCast(u64, sys.getPointer(module + loader.M_BASE))
        info[1] = @intCast(u64, sys.getPointer(module + loader.M_NAME))
        info[2] = @intCast(u64, sys.getPointer(module + loader.M_PHDR))
        info[3] = @intCast(u64, sys.getPointer(module + loader.M_PHNUM))
        info[4] = @intCast(u64, loader.count)
        info[5] = 0
        info[6] = @intCast(u64, sys.getPointer(module + loader.M_TLS_ID))
        info[7] = 0
        result = sys.compare3(callback, @intFromPtr(&info), 64, data)
        module = sys.getPointer(module + loader.M_NEXT)
    }
    return result
}
