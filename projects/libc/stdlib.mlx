// stdlib.h: number parsing, searching and sorting, the environment, the
// process's end (exit, atexit, abort), the random numbers glibc's
// generator makes, and system().
const sys = @import("./sys.mlx")
const errno = @import("./errno.mlx")
const heap = @import("./heap.mlx")
const string = @import("./string.mlx")
const ctype = @import("./ctype.mlx")
const bignum = @import("./bignum.mlx")

const MOST: u64 = 18446744073709551615
const LONG_MAX: u64 = 9223372036854775807

fn isSpace(value: u8) -> bool { return value == 32 || (value >= 9 && value <= 13) }

fn digitValue(value: u8) -> u32 {
    if value >= 48 && value <= 57 { return @intCast(u32, value - 48) }
    if value >= 97 && value <= 122 { return @intCast(u32, value - 97 + 10) }
    if value >= 65 && value <= 90 { return @intCast(u32, value - 65 + 10) }
    return 99
}

// The integer at `text` in `base` (0 for a prefix-chosen one): its sign,
// magnitude (saturated at 2^64-1 with `overflow`), and where it ended (the
// start when there were no digits). C23 (`binary`, the __isoc23_ names
// glibc 2.38's headers call) also takes a 0b prefix in base 0 and 2.
const Scan = struct { negative: bool, magnitude: u64, overflow: bool, end: usize }

fn scanInteger(text: usize, base: i32, binary: bool) -> Scan {
    const data = sys.constBytes(text)
    var at: usize = 0
    while isSpace(data[at]) { at += 1 }
    var negative = false
    if data[at] == 45 || data[at] == 43 {
        negative = data[at] == 45
        at += 1
    }
    var radix: u64 = if base <= 0 { 10 } else { @intCast(u64, base) }
    if (base == 0 || base == 16) && data[at] == 48 && (data[at + 1] == 120 || data[at + 1] == 88) && digitValue(data[at + 2]) < 16 {
        radix = 16
        at += 2
    } else if binary && (base == 0 || base == 2) && data[at] == 48 && (data[at + 1] == 98 || data[at + 1] == 66) && digitValue(data[at + 2]) < 2 {
        radix = 2
        at += 2
    } else if base == 0 && data[at] == 48 {
        radix = 8
    }
    var magnitude: u64 = 0
    var overflow = false
    var digits: usize = 0
    while true {
        const digit = digitValue(data[at])
        if @intCast(u64, digit) >= radix { break }
        if magnitude > (MOST - @intCast(u64, digit)) / radix {
            overflow = true
        } else {
            magnitude = magnitude * radix + @intCast(u64, digit)
        }
        at += 1
        digits += 1
    }
    if digits == 0 { return Scan.{ .negative = false, .magnitude = 0, .overflow = false, .end = text } }
    return Scan.{ .negative = negative, .magnitude = if overflow { MOST } else { magnitude }, .overflow = overflow, .end = text + at }
}

fn signedResult(scan: Scan, limit_positive: u64, end: usize) -> i64 {
    if end != 0 { sys.putPointer(end, scan.end) }
    const limit_negative = limit_positive + 1
    if scan.overflow || (!scan.negative && scan.magnitude > limit_positive) || (scan.negative && scan.magnitude > limit_negative) {
        errno.set(sys.ERANGE)
        if scan.negative { return @bitCast(i64, 0 -% limit_negative) }
        return @bitCast(i64, limit_positive)
    }
    if scan.negative { return @bitCast(i64, 0 -% scan.magnitude) }
    return @bitCast(i64, scan.magnitude)
}

fn unsignedResult(scan: Scan, limit: u64, end: usize) -> u64 {
    if end != 0 { sys.putPointer(end, scan.end) }
    if scan.overflow || scan.magnitude > limit {
        errno.set(sys.ERANGE)
        return limit
    }
    if scan.negative { return (0 -% scan.magnitude) & limit }
    return scan.magnitude
}

pub export fn strtol(text: usize, end: usize, base: i32) -> i64 { return signedResult(scanInteger(text, base, false), LONG_MAX, end) }
pub export fn strtoll(text: usize, end: usize, base: i32) -> i64 { return strtol(text, end, base) }
pub export fn strtoimax(text: usize, end: usize, base: i32) -> i64 { return strtol(text, end, base) }
pub export fn strtoul(text: usize, end: usize, base: i32) -> u64 { return unsignedResult(scanInteger(text, base, false), MOST, end) }
pub export fn strtoull(text: usize, end: usize, base: i32) -> u64 { return strtoul(text, end, base) }
pub export fn strtoumax(text: usize, end: usize, base: i32) -> u64 { return strtoul(text, end, base) }
pub export fn __isoc23_strtol(text: usize, end: usize, base: i32) -> i64 { return signedResult(scanInteger(text, base, true), LONG_MAX, end) }
pub export fn __isoc23_strtoll(text: usize, end: usize, base: i32) -> i64 { return __isoc23_strtol(text, end, base) }
pub export fn __isoc23_strtoimax(text: usize, end: usize, base: i32) -> i64 { return __isoc23_strtol(text, end, base) }
pub export fn __isoc23_strtoul(text: usize, end: usize, base: i32) -> u64 { return unsignedResult(scanInteger(text, base, true), MOST, end) }
pub export fn __isoc23_strtoull(text: usize, end: usize, base: i32) -> u64 { return __isoc23_strtoul(text, end, base) }
pub export fn __isoc23_strtoumax(text: usize, end: usize, base: i32) -> u64 { return __isoc23_strtoul(text, end, base) }

pub export fn atoi(text: usize) -> i32 { return @intCast(i32, @bitCast(i64, @bitCast(u64, strtol(text, 0, 10)) & 4294967295) << 32 >> 32) }
pub export fn atol(text: usize) -> i64 { return strtol(text, 0, 10) }
pub export fn atoll(text: usize) -> i64 { return strtol(text, 0, 10) }

pub export fn abs(value: i32) -> i32 { return if value < 0 { 0 - value } else { value } }
pub export fn labs(value: i64) -> i64 { return if value < 0 { 0 - value } else { value } }
pub export fn llabs(value: i64) -> i64 { return labs(value) }
pub export fn imaxabs(value: i64) -> i64 { return labs(value) }

// div_t is two ints in one word (quot low, rem high); ldiv_t two words.
pub export fn div(numerator: i32, denominator: i32) -> u64 {
    const quotient = numerator / denominator
    const remainder = numerator - quotient * denominator
    // (The masks: a widened bitcast of a negative int sign-extends today.)
    return (@intCast(u64, @bitCast(u32, quotient)) & 4294967295) | ((@intCast(u64, @bitCast(u32, remainder)) & 4294967295) << 32)
}

pub export fn ldiv(numerator: i64, denominator: i64) -> (i64, i64) {
    const quotient = numerator / denominator
    return -> (quotient, numerator - quotient * denominator)
}

pub export fn lldiv(numerator: i64, denominator: i64) -> (i64, i64) { return ldiv(numerator, denominator) }

// strtod: decimal and hexadecimal numbers, inf and nan. The value is the
// digits (up to 19 kept) scaled by a power of ten in double arithmetic:
// exact where one rounding happens (nineteen digits or fewer and an
// exponent within 10^22), within an ulp or two beyond that.
fn powerOfTen(exponent: i64) -> f64 {
    var result: f64 = 1.0
    var count = if exponent < 0 { 0 - exponent } else { exponent }
    var base: f64 = 10.0
    while count > 0 {
        if count & 1 == 1 { result = result * base }
        base = base * base
        count >>= 1
    }
    if exponent < 0 { return 1.0 / result }
    return result
}

fn lowerByte(value: u8) -> u8 { return if value >= 65 && value <= 90 { value + 32 } else { value } }

fn matchesWord(data: [*]const u8, at: usize, word: []const u8) -> bool {
    var index: usize = 0
    while index < word.length {
        if lowerByte(data[at + index]) != word[index] { return false }
        index += 1
    }
    return true
}

fn bitsToDouble(bits: u64) -> f64 { return @bitCast(f64, bits) }

pub export fn strtod(text: usize, end: usize) -> f64 {
    const data = sys.constBytes(text)
    var at: usize = 0
    while isSpace(data[at]) { at += 1 }
    var negative = false
    if data[at] == 45 || data[at] == 43 {
        negative = data[at] == 45
        at += 1
    }
    if matchesWord(data, at, "inf") {
        at += if matchesWord(data, at, "infinity") { 8 } else { 3 }
        if end != 0 { sys.putPointer(end, text + at) }
        return if negative { bitsToDouble(18442240474082181120) } else { bitsToDouble(9218868437227405312) }
    }
    if matchesWord(data, at, "nan") {
        at += 3
        if data[at] == 40 {
            var close = at + 1
            while data[close] != 0 && data[close] != 41 { close += 1 }
            if data[close] == 41 { at = close + 1 }
        }
        if end != 0 { sys.putPointer(end, text + at) }
        return bitsToDouble(if negative { 18444492273895866368 } else { 9221120237041090560 })
    }
    var mantissa: u64 = 0
    var exponent: i64 = 0
    var digits: usize = 0
    var any = false
    if data[at] == 48 && (data[at + 1] == 120 || data[at + 1] == 88) && (digitValue(data[at + 2]) < 16 || (data[at + 2] == 46 && digitValue(data[at + 3]) < 16)) {
        // Hexadecimal: digits, a point, a binary exponent after p.
        at += 2
        var binary_exponent: i64 = 0
        while digitValue(data[at]) < 16 {
            if digits < 15 {
                mantissa = mantissa * 16 + @intCast(u64, digitValue(data[at]))
                digits += 1
            } else { binary_exponent += 4 }
            at += 1
            any = true
        }
        if data[at] == 46 {
            at += 1
            while digitValue(data[at]) < 16 {
                if digits < 15 {
                    mantissa = mantissa * 16 + @intCast(u64, digitValue(data[at]))
                    digits += 1
                    binary_exponent -= 4
                }
                at += 1
                any = true
            }
        }
        if any && (data[at] == 112 || data[at] == 80) {
            var look = at + 1
            var exponent_negative = false
            if data[look] == 45 || data[look] == 43 {
                exponent_negative = data[look] == 45
                look += 1
            }
            if digitValue(data[look]) < 10 {
                var value: i64 = 0
                while digitValue(data[look]) < 10 {
                    if value < 100000 { value = value * 10 + @intCast(i64, digitValue(data[look])) }
                    look += 1
                }
                binary_exponent += if exponent_negative { 0 - value } else { value }
                at = look
            }
        }
        if !any {
            if end != 0 { sys.putPointer(end, text) }
            return 0.0
        }
        var result: f64 = @floatFromInt(f64, @intCast(i64, mantissa))
        var scale: f64 = 2.0
        var count = if binary_exponent < 0 { 0 - binary_exponent } else { binary_exponent }
        var factor: f64 = 1.0
        while count > 0 {
            if count & 1 == 1 { factor = factor * scale }
            scale = scale * scale
            count >>= 1
        }
        result = if binary_exponent < 0 { result / factor } else { result * factor }
        if end != 0 { sys.putPointer(end, text + at) }
        return if negative { 0.0 - result } else { result }
    }
    var sticky = false
    while digitValue(data[at]) < 10 {
        if digits < 19 {
            mantissa = mantissa * 10 + @intCast(u64, digitValue(data[at]))
            if mantissa != 0 { digits += 1 }
        } else {
            exponent += 1
            if data[at] != 48 { sticky = true }
        }
        at += 1
        any = true
    }
    if data[at] == 46 && (any || digitValue(data[at + 1]) < 10) {
        at += 1
        while digitValue(data[at]) < 10 {
            if digits < 19 {
                mantissa = mantissa * 10 + @intCast(u64, digitValue(data[at]))
                if mantissa != 0 { digits += 1 }
                exponent -= 1
            } else if data[at] != 48 { sticky = true }
            at += 1
            any = true
        }
    }
    if !any {
        if end != 0 { sys.putPointer(end, text) }
        return 0.0
    }
    if data[at] == 101 || data[at] == 69 {
        var look = at + 1
        var exponent_negative = false
        if data[look] == 45 || data[look] == 43 {
            exponent_negative = data[look] == 45
            look += 1
        }
        if digitValue(data[look]) < 10 {
            var value: i64 = 0
            while digitValue(data[look]) < 10 {
                if value < 100000 { value = value * 10 + @intCast(i64, digitValue(data[look])) }
                look += 1
            }
            exponent += if exponent_negative { 0 - value } else { value }
            at = look
        }
    }
    if end != 0 { sys.putPointer(end, text + at) }
    var out_of_range = false
    const result = decimalToDouble(mantissa, exponent, sticky, negative, &out_of_range)
    if out_of_range { errno.set(sys.ERANGE) }
    return result
}

// mantissa * 10^exponent as a double, correctly rounded: the product (or
// the quotient by 10^-exponent) is formed exactly in big integers and
// rounded once.
fn decimalToDouble(mantissa: u64, exponent: i64, sticky: bool, negative: bool, range: *bool) -> f64 {
    if mantissa == 0 { return bignum.makeDouble(0, 0, false, negative, range) }
    if exponent > 310 { return bignum.makeDouble(mantissa, 1100, false, negative, range) }
    if exponent < -400 {
        range.* = true
        return bignum.makeDouble(0, 0, false, negative, range)
    }
    if exponent >= 0 {
        var product = bignum.fromU64(mantissa)
        bignum.mulPow10(&product, @intCast(usize, exponent))
        const length = bignum.bitLength(&product)
        if length <= 64 {
            const top = bignum.topBits(&product, 0)
            return bignum.makeDouble(top.0, 0, sticky, negative, range)
        }
        const top = bignum.topBits(&product, length - 64)
        return bignum.makeDouble(top.0, @intCast(i64, length - 64), top.1 || sticky, negative, range)
    }
    // mantissa / 10^k: the numerator shifted so the quotient has 63 bits.
    const divisor = bignum.pow10(@intCast(usize, 0 - exponent))
    var numerator = bignum.fromU64(mantissa)
    const divisor_bits = bignum.bitLength(&divisor)
    const numerator_bits = bignum.bitLength(&numerator)
    var shift: usize = 0
    if divisor_bits + 63 > numerator_bits { shift = divisor_bits + 63 - numerator_bits }
    bignum.shiftLeft(&numerator, shift)
    const quotient = bignum.divide(&numerator, &divisor)
    return bignum.makeDouble(quotient.0, 0 - @intCast(i64, shift), quotient.1 || sticky, negative, range)
}

export fn strtof(text: usize, end: usize) -> f32 { return @floatCast(f32, strtod(text, end)) }

pub export fn atof(text: usize) -> f64 { return strtod(text, 0) }

// qsort: a heapsort over elements of any size, swapped byte by byte.
fn swapElements(first: usize, second: usize, size: usize) -> void {
    const a = sys.bytes(first)
    const b = sys.bytes(second)
    var index: usize = 0
    while index < size {
        const held = a[index]
        a[index] = b[index]
        b[index] = held
        index += 1
    }
}

fn compareElements(function: usize, first: usize, second: usize, argument: usize, with_argument: bool) -> i32 {
    if with_argument { return sys.compare3(function, first, second, argument) }
    return sys.compare2(function, first, second)
}

fn siftDown(base: usize, size: usize, start: usize, count: usize, function: usize, argument: usize, with_argument: bool) -> void {
    var root = start
    while root * 2 + 1 < count {
        var child = root * 2 + 1
        if child + 1 < count && compareElements(function, base + child * size, base + (child + 1) * size, argument, with_argument) < 0 { child += 1 }
        if compareElements(function, base + root * size, base + child * size, argument, with_argument) >= 0 { return }
        swapElements(base + root * size, base + child * size, size)
        root = child
    }
}

fn heapsort(base: usize, count: usize, size: usize, function: usize, argument: usize, with_argument: bool) -> void {
    if count < 2 || size == 0 { return }
    var start = count / 2
    while start > 0 {
        start -= 1
        siftDown(base, size, start, count, function, argument, with_argument)
    }
    var end = count
    while end > 1 {
        end -= 1
        swapElements(base, base + end * size, size)
        siftDown(base, size, 0, end, function, argument, with_argument)
    }
}

pub export fn qsort(base: usize, count: usize, size: usize, compare: usize) -> void { heapsort(base, count, size, compare, 0, false) }

pub export fn qsort_r(base: usize, count: usize, size: usize, compare: usize, argument: usize) -> void { heapsort(base, count, size, compare, argument, true) }

pub export fn bsearch(key: usize, base: usize, count: usize, size: usize, compare: usize) -> usize {
    var low: usize = 0
    var high = count
    while low < high {
        const middle = low + (high - low) / 2
        const element = base + middle * size
        const order = sys.compare2(compare, key, element)
        if order == 0 { return element }
        if order < 0 { high = middle } else { low = middle + 1 }
    }
    return 0
}

// The environment. `environ` is the program's array of "NAME=value"
// strings; a library loaded into a process that did not set it reads the
// process's from /proc/self/environ on first use.
pub export var environ: usize = 0
var environCapacity: usize = 0
var environOwned: usize = 0
var environLock: u32 = 0

// The array the loader (start.mlx) or __libc_start_main hands in: the
// process's own, grown into a copy when a change needs room.
pub fn setEnvironment(array: usize) -> void {
    environ = array
    environOwned = 0
    environCapacity = 0
}

fn countEntries(array: usize) -> usize {
    var count: usize = 0
    while sys.getPointer(array + count * 8) != 0 { count += 1 }
    return count
}

fn loadEnvironment() -> void {
    var path: [*]const u8 = undefined
    unsafe { path = @ptrCast([*]const u8, "/proc/self/environ") }
    const file = sys.syscall3(sys.SYS_open, @intFromPtr(path), 0, 0)
    var buffer: usize = 0
    var length: usize = 0
    var capacity: usize = 0
    if !sys.failed(file) {
        while true {
            if length == capacity {
                const grown = heap.allocate(capacity * 2 + 4096, 16)
                if grown == 0 { break }
                if buffer != 0 {
                    sys.copy(grown, buffer, length)
                    heap.release(buffer)
                }
                buffer = grown
                capacity = capacity * 2 + 4096
            }
            const got = sys.syscall3(sys.SYS_read, @bitCast(usize, file), buffer + length, capacity - length)
            if got <= 0 { break }
            length += @bitCast(usize, got)
        }
        const closed = sys.syscall1(sys.SYS_close, @bitCast(usize, file))
    }
    var count: usize = 0
    var at: usize = 0
    while at < length {
        if sys.get8(buffer + at) == 0 { count += 1 }
        at += 1
    }
    const array = heap.allocate((count + 16) * 8, 16)
    if array == 0 { return }
    var index: usize = 0
    at = 0
    while at < length && index < count {
        sys.putPointer(array + index * 8, buffer + at)
        while at < length && sys.get8(buffer + at) != 0 { at += 1 }
        at += 1
        index += 1
    }
    sys.putPointer(array + index * 8, 0)
    environ = array
    environOwned = array
    environCapacity = count + 16
}

// The array as one this library owns and may grow (a copy when the
// program set its own).
fn ownedEnvironment() -> bool {
    if environ == 0 { loadEnvironment() }
    if environ == 0 { return false }
    if environ == environOwned { return true }
    const count = countEntries(environ)
    const copy = heap.allocate((count + 16) * 8, 16)
    if copy == 0 { return false }
    sys.copy(copy, environ, (count + 1) * 8)
    environ = copy
    environOwned = copy
    environCapacity = count + 16
    return true
}

fn entryMatches(entry: usize, name: []const u8) -> bool {
    const text = sys.constBytes(entry)
    var index: usize = 0
    while index < name.length {
        if text[index] != name[index] { return false }
        index += 1
    }
    return text[index] == 61
}

fn findEntry(name: []const u8) -> usize {
    if environ == 0 { loadEnvironment() }
    if environ == 0 { return 18446744073709551615 }
    var index: usize = 0
    while true {
        const entry = sys.getPointer(environ + index * 8)
        if entry == 0 { return 18446744073709551615 }
        if entryMatches(entry, name) { return index }
        index += 1
    }
    return 18446744073709551615
}

pub export fn getenv(name: usize) -> usize {
    if name == 0 { return 0 }
    const wanted = sys.slice(name)
    if wanted.length == 0 { return 0 }
    sys.lock(@ptrCast(*u32, &environLock))
    const index = findEntry(wanted)
    var result: usize = 0
    if index != 18446744073709551615 { result = sys.getPointer(environ + index * 8) + wanted.length + 1 }
    sys.unlock(@ptrCast(*u32, &environLock))
    return result
}

pub export fn secure_getenv(name: usize) -> usize { return getenv(name) }

fn appendEntry(entry: usize) -> bool {
    if !ownedEnvironment() { return false }
    const count = countEntries(environ)
    if count + 2 > environCapacity {
        const grown = heap.allocate((environCapacity * 2 + 16) * 8, 16)
        if grown == 0 { return false }
        sys.copy(grown, environ, (count + 1) * 8)
        heap.release(environ)
        environ = grown
        environOwned = grown
        environCapacity = environCapacity * 2 + 16
    }
    sys.putPointer(environ + count * 8, entry)
    sys.putPointer(environ + (count + 1) * 8, 0)
    return true
}

pub export fn setenv(name: usize, value: usize, overwrite: i32) -> i32 {
    if name == 0 || sys.get8(name) == 0 || string.strchr(name, 61) != 0 { return errno.failWith(sys.EINVAL) }
    const wanted = sys.slice(name)
    sys.lock(@ptrCast(*u32, &environLock))
    const index = findEntry(wanted)
    if index != 18446744073709551615 && overwrite == 0 {
        sys.unlock(@ptrCast(*u32, &environLock))
        return 0
    }
    const value_length = sys.length(value)
    const entry = heap.allocate(wanted.length + 1 + value_length + 1, 16)
    if entry == 0 {
        sys.unlock(@ptrCast(*u32, &environLock))
        return -1
    }
    sys.copy(entry, name, wanted.length)
    sys.put8(entry + wanted.length, 61)
    sys.copy(entry + wanted.length + 1, value, value_length + 1)
    var ok = true
    if index != 18446744073709551615 {
        ok = ownedEnvironment()
        if ok { sys.putPointer(environ + index * 8, entry) }
    } else {
        ok = appendEntry(entry)
    }
    sys.unlock(@ptrCast(*u32, &environLock))
    if !ok { return errno.failWith(sys.ENOMEM) }
    return 0
}

pub export fn unsetenv(name: usize) -> i32 {
    if name == 0 || sys.get8(name) == 0 || string.strchr(name, 61) != 0 { return errno.failWith(sys.EINVAL) }
    const wanted = sys.slice(name)
    sys.lock(@ptrCast(*u32, &environLock))
    while true {
        const index = findEntry(wanted)
        if index == 18446744073709551615 { break }
        if !ownedEnvironment() { break }
        var at = index
        while true {
            const following = sys.getPointer(environ + (at + 1) * 8)
            sys.putPointer(environ + at * 8, following)
            if following == 0 { break }
            at += 1
        }
    }
    sys.unlock(@ptrCast(*u32, &environLock))
    return 0
}

pub export fn putenv(entry: usize) -> i32 {
    const equals = string.strchr(entry, 61)
    if equals == 0 { return unsetenv(entry) }
    const name = sys.constBytes(entry)[0..equals - entry]
    sys.lock(@ptrCast(*u32, &environLock))
    const index = findEntry(name)
    var ok = true
    if index != 18446744073709551615 {
        ok = ownedEnvironment()
        if ok { sys.putPointer(environ + index * 8, entry) }
    } else {
        ok = appendEntry(entry)
    }
    sys.unlock(@ptrCast(*u32, &environLock))
    if !ok { return errno.failWith(sys.ENOMEM) }
    return 0
}

pub export fn clearenv() -> i32 {
    sys.lock(@ptrCast(*u32, &environLock))
    if ownedEnvironment() { sys.putPointer(environ, 0) }
    sys.unlock(@ptrCast(*u32, &environLock))
    return 0
}

// The environment array for execve and the like.
pub fn environmentArray() -> usize {
    if environ == 0 { loadEnvironment() }
    return environ
}

// exit: the atexit handlers last registered first, then what the library
// has to flush (stdio registers itself), then the process ends.
const HANDLER_COUNT: usize = 128
var handlers: [128]usize = undefined
var handlerArguments: [128]usize = undefined
var handlerCount: usize = 0
var handlerLock: u32 = 0
var exitHook: usize = 0

pub fn setExitHook(hook: usize) -> void { exitHook = hook }
// What runs the loaded objects' destructors (loader.mlx, when this
// library is the process's loader).
var finiHook: usize = 0
pub fn setFiniHook(hook: usize) -> void { finiHook = hook }

fn registerHandler(function: usize, argument: usize, with_argument: bool) -> i32 {
    sys.lock(@ptrCast(*u32, &handlerLock))
    if handlerCount >= HANDLER_COUNT {
        sys.unlock(@ptrCast(*u32, &handlerLock))
        return -1
    }
    handlers[handlerCount] = function
    handlerArguments[handlerCount] = if with_argument { argument } else { 18446744073709551615 }
    handlerCount += 1
    sys.unlock(@ptrCast(*u32, &handlerLock))
    return 0
}

pub export fn atexit(function: usize) -> i32 { return registerHandler(function, 0, false) }

pub export fn __cxa_atexit(function: usize, argument: usize, dso: usize) -> i32 { return registerHandler(function, argument, true) }

fn runHandlers() -> void {
    while true {
        sys.lock(@ptrCast(*u32, &handlerLock))
        if handlerCount == 0 {
            sys.unlock(@ptrCast(*u32, &handlerLock))
            return
        }
        handlerCount -= 1
        const function = handlers[handlerCount]
        const argument = handlerArguments[handlerCount]
        sys.unlock(@ptrCast(*u32, &handlerLock))
        if argument == 18446744073709551615 { sys.call0(function) } else { sys.call1(function, argument) }
    }
}

pub export fn __cxa_finalize(dso: usize) -> void {
    if dso == 0 { runHandlers() }
}

pub export fn exit(status: i32) -> void {
    runHandlers()
    sys.call0(finiHook)
    sys.call0(exitHook)
    const ended = sys.syscall1(sys.SYS_exit_group, sys.int(status))
}

pub export fn _exit(status: i32) -> void { const ended = sys.syscall1(sys.SYS_exit_group, sys.int(status)) }

pub export fn _Exit(status: i32) -> void { _exit(status) }

pub export fn quick_exit(status: i32) -> void { _exit(status) }

pub export fn abort() -> void {
    // SIGABRT, unblocked and at its default if a handler returned.
    var mask: [2]u64 = [2]u64{ 32, 0 }
    const unblocked = sys.syscall4(sys.SYS_rt_sigprocmask, 1, @intFromPtr(&mask), 0, 8)
    const raised = sys.syscall3(sys.SYS_tgkill, @intCast(usize, sys.getPid()), @intCast(usize, sys.getTid()), 6)
    var action: [4]u64 = [4]u64{ 0, 0, 0, 0 }
    const reset = sys.syscall4(sys.SYS_rt_sigaction, 6, @intFromPtr(&action), 0, 8)
    const raised_again = sys.syscall3(sys.SYS_tgkill, @intCast(usize, sys.getPid()), @intCast(usize, sys.getTid()), 6)
    const ended = sys.syscall1(sys.SYS_exit_group, 127)
}

// rand and random: glibc's additive feedback generator (TYPE_3, degree 31),
// so a program seeded the same sees the same numbers.
var randomTable: [34]i32 = undefined
var randomFront: usize = 3
var randomRear: usize = 0
var randomReady: bool = false
var randomLock: u32 = 0

fn seedRandom(seed: u32) -> void {
    var word: i32 = @bitCast(i32, if seed == 0 { 1 } else { seed })
    randomTable[0] = word
    var index: usize = 1
    while index < 31 {
        // (16807 * word) % 2147483647 without overflow, as glibc does it.
        const high: i64 = @intCast(i64, word) / 127773
        const low: i64 = @intCast(i64, word) % 127773
        var next: i64 = 16807 * low - 2836 * high
        if next < 0 { next += 2147483647 }
        word = @intCast(i32, next)
        randomTable[index] = word
        index += 1
    }
    randomFront = 3
    randomRear = 0
    randomReady = true
    var discard: usize = 0
    while discard < 310 {
        const unused = nextRandom()
        discard += 1
    }
}

fn nextRandom() -> i32 {
    if !randomReady { seedRandom(1) }
    randomTable[randomFront] = @bitCast(i32, @bitCast(u32, randomTable[randomFront]) +% @bitCast(u32, randomTable[randomRear]))
    const result = @intCast(i32, (@bitCast(u32, randomTable[randomFront]) >> 1) & 2147483647)
    randomFront += 1
    randomRear += 1
    if randomFront >= 31 { randomFront = 0 } else if randomRear >= 31 { randomRear = 0 }
    return result
}

pub export fn srandom(seed: u32) -> void {
    sys.lock(@ptrCast(*u32, &randomLock))
    seedRandom(seed)
    sys.unlock(@ptrCast(*u32, &randomLock))
}

pub export fn srand(seed: u32) -> void { srandom(seed) }

pub export fn random() -> i64 {
    sys.lock(@ptrCast(*u32, &randomLock))
    const value = nextRandom()
    sys.unlock(@ptrCast(*u32, &randomLock))
    return @intCast(i64, value)
}

pub export fn rand() -> i32 { return @intCast(i32, random()) }

// rand_r: glibc's three-step congruential generator on the caller's word.
pub export fn rand_r(seed: usize) -> i32 {
    var next = sys.get32(seed)
    next = next *% 1103515245 +% 12345
    var result: u32 = (next / 65536) % 2048
    next = next *% 1103515245 +% 12345
    result = (result << 10) ^ ((next / 65536) % 1024)
    next = next *% 1103515245 +% 12345
    result = (result << 10) ^ ((next / 65536) % 1024)
    sys.put32(seed, next)
    return @intCast(i32, result)
}

// system: /bin/sh -c command, waited for.
pub export fn system(command: usize) -> i32 {
    var shell: [*]const u8 = undefined
    var dash_c: [*]const u8 = undefined
    var name: [*]const u8 = undefined
    unsafe {
        shell = @ptrCast([*]const u8, "/bin/sh")
        dash_c = @ptrCast([*]const u8, "-c")
        name = @ptrCast([*]const u8, "sh")
    }
    if command == 0 { return 1 }
    const forked = sys.syscall0(sys.SYS_fork)
    if sys.failed(forked) { return errno.checkInt(forked) }
    if forked == 0 {
        var arguments: [4]usize = [4]usize{ @intFromPtr(name), @intFromPtr(dash_c), command, 0 }
        const executed = sys.syscall3(sys.SYS_execve, @intFromPtr(shell), @intFromPtr(&arguments), environmentArray())
        const ended = sys.syscall1(sys.SYS_exit_group, 127)
    }
    var status: i32 = 0
    while true {
        const waited = sys.syscall4(sys.SYS_wait4, @bitCast(usize, forked), @intFromPtr(&status), 0, 0)
        if waited == -4 { continue }
        if sys.failed(waited) { return errno.checkInt(waited) }
        break
    }
    return status
}
