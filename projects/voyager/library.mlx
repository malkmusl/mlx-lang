// libvoyager.so: Voyager's window (voyager.mlx) with the C ABI the engine
// (engine.cpp) calls. ARGUMENTS: main's argc entries, a null, then the
// environment's entries and a null, as a process's stack has them. The
// result is the error union's tag (abi.md): 0 when the window was closed,
// another value when there was none or its connection failed.
const voyager = @import("./voyager.mlx")
const pages = @import("./pages.mlx")

export fn voyager_run(table: usize, count: i32, arguments: usize) -> !void { return voyager.run(table, @intCast(usize, count), arguments) }

// Voyager's internal page of URL (voyager:..., pages.mlx) for the engine's
// scheme handler: given to DELIVER(CONTEXT, status, bytes, length), with
// FACTS, COUNT pairs of C strings (label, value), on it.
export fn voyager_page(url: [*]const u8, facts: [*]const [*]const u8, count: usize, deliver: usize, context: usize) -> void { pages.page(url, facts, count, deliver, context) }

// PATH (a C string) opened with its application, or (SHOW) shown in its
// folder (voyager.mlx's openFile, std.xdg.open): 1 when something was
// started, else 0. For the engine's voyager://downloads.
export fn voyager_open_file(path: [*]const u8, show: u32) -> u32 {
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    return if voyager.openFile(path[0..length], show != 0) { 1 } else { 0 }
}
