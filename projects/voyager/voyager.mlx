// Voyager's window (PORT.md, M5): libvoyager.so, which the engine
// (projects/voyager/engine.cpp, WebCore in the same process) calls with
// voyager_run once the first tab is loading. A std.ui.host window on the
// compositor, drawn on the CPU into its wl_shm buffers: the engine's
// compositor thread composites the tab shown (PORT.md "Compositing") and
// wakes the window through a descriptor (ui.host.watchDescriptor), which
// copies the frame into the buffer's pixels (Skia's N32 words are the
// desktop's ARGB) and damages only what the frame changed. The window's
// events go to the
// engine: the pointer (motion, buttons; a link clicked loads its page, one
// clicked with the middle button or Ctrl opens in a tab behind), the wheel
// (scrolls), keys with what they type (into the focused text field) and
// the window's size; a tick runs WebCore's loop (loads, timers, the
// caret: every tab's, those behind keep running) and draws again what it
// changed. Ctrl+C copies the selection's text to the compositor's
// clipboard, Ctrl+V types the clipboard's text. The title follows the
// shown tab's; each new title and URL of it is written to standard error
// ("voyager: title ...", "voyager: url ..."), with VOYAGER_TRACE each tab's
// too and what happens to the tabs, which tools/check_voyager.sh reads.
//
// Above the page, a toolbar of std.ui's widgets (std.ui.view, laid out
// and drawn each frame): the sidebar's button, back and forward
// (std.ui.controls' chevron buttons; also Alt+Left and Alt+Right: the URLs
// this tab went to, each loaded again), reload, or stop while the page
// loads (std.ui.glyphs' marks on plain icon buttons), the address field
// (std.ui.field: its editing, selection and caret; any length, scrolled to
// the caret) showing the page's URL. A click in
// the field or Ctrl+L puts the keys there with all of it selected (typing
// replaces it; Ctrl+C, Ctrl+X and Ctrl+V with the compositor's clipboard),
// Enter loads what it says (an address without a scheme as http://;
// voyager://about, voyager://version and voyager:// are Voyager's own pages,
// about:about and about:version lead there),
// Escape gives the keys back to the page.
//
// Downloads (the engine's: what a page has saved, PORT.md "Downloads")
// go to the user's download folder (std.xdg: $XDG_DOWNLOAD_DIR,
// user-dirs.dirs, else ~/Downloads), as Safari shows them: once there is
// one, a downloads button at the toolbar's right end (std.ui.glyphs'
// download mark), a progress ring round it while anything is
// downloading, the mark dropping into it when a download starts. A click
// opens its popover (std.ui.popup, under the button): the downloads, the
// newest first, each its file's mark (by its type), its name, a progress
// bar and "12.3 MB of 45.6 MB — 20 s remaining" while it runs, its size
// and "Done" once done, Paused, Failed or Cancelled; a stop (×) while it
// runs, resume (↻) and cancel once paused, a magnifier once done that
// shows it in its folder (the desktop's Files, std.xdg.open), a double
// click on a finished one opening it with its application; Clear takes
// the finished ones off the list (their files stay). A click elsewhere
// or Escape closes it. voyager://downloads is the full list with the same
// actions. The list is the profile's: a restart finds it.
//
// A page's file chooser (<input type=file>) is std.ui.chooser over the
// page, in the folder Voyager last chose in (std.ui.chooser keeps it for
// the app), else the home folder, with its places and its path field:
// its keys and clicks go to it until a file is opened or it is cancelled
// (Escape); what is chosen goes to the page.
//
// Tabs: each its own WebCore Page in the engine. At the left, a sidebar
// (std.ui.sidebar: the desktop apps' translucent tint, its rows of
// std.ui.lists) lists them: each tab's title (or URL), a pulsing dot while
// it loads, its close button, the one shown chosen; a row for a new tab
// under them. It folds to a narrow strip of the tabs' initials (the
// toolbar's button, Ctrl+Shift+B), gliding there and back in 200 ms (as
// the desktop's scheme glides: smoothstep over the time). Ctrl+T opens a
// new tab (the address field takes the keys), Ctrl+W closes the shown
// one, Ctrl+Tab and Ctrl+Shift+Tab go to the next and the one before,
// Ctrl+1 to Ctrl+8 to that tab, Ctrl+9 to the last. A tab the page opens
// (window.open, a `target=_blank` link) is shown at once; one opened by a
// middle click or Ctrl+click stays behind. Closing the last tab closes
// the window (as other browsers do).
//
// The toolbar and the sidebar are drawn in std.ui.theme's look for the
// desktop's colour scheme (std.ui.appearance: the panel keeps its Watch,
// std.ui.host gives its lightness; MLX_COLOR_SCHEME=dark|light overrides),
// fading with it when it is switched; the pages get the scheme too (the
// engine's setDark: WebCore's dark appearance), at once, without a reload.
// There is no setting of Voyager's own for it: on a dark desktop the pages
// get `prefers-color-scheme: dark`, and one without a dark design of its
// own is always painted dark (the engine's forced dark mode); on a light
// one they are as they are.
//
//     ./mlx build webkit-mlx-voyager       mlx-out/webkit/mlx/bin/voyager (and libvoyager.so)
//     voyager [--font FILE]... [--size WIDTHxHEIGHT] FILE|URL
const std = @import("std")
const ui = @import("std.ui")
const app = @import("std.ui.app")
const host = @import("std.ui.host")
const keys = @import("std.ui.keys")
const view = @import("std.ui.view")
const controls = @import("std.ui.controls")
const field = @import("std.ui.field")
const glyphs = @import("std.ui.glyphs")
const lists = @import("std.ui.lists")
const sidebar = @import("std.ui.sidebar")
const theme_module = @import("std.ui.theme")
const appearance = @import("std.ui.appearance")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const chooser_module = @import("std.ui.chooser")
const popup = @import("std.ui.popup")
const xdg = @import("std.xdg")
const xdg_open = @import("std.xdg.open")
const list_module = @import("std.containers.array_list")

// Bytes that grow (a URL, a title, a C string for the engine), and the
// URLs gone to (each a block of std.heap).
const Bytes = list_module.ArrayList(u8)
const Places = list_module.ArrayList([]u8)

// The engine's functions (engine.cpp's VoyagerEngine, in its order).
const Table = struct {
    engine: usize
    open: usize
    close: usize
    select: usize
    opened: usize
    load: usize
    resize: usize
    cycle: usize
    paint: usize
    pointer: usize
    wheel: usize
    key: usize
    selectedText: usize
    insertText: usize
    title: usize
    url: usize
    release: usize
    reload: usize
    stop: usize
    loading: usize
    setDark: usize
    forcedDark: usize
    chooser: usize
    choose: usize
    setDownloads: usize
    downloadCount: usize
    download: usize
    downloadPath: usize
    downloadType: usize
    downloadAction: usize
    descriptor: usize
    wake: usize
    damage: usize
}

const OpenFn = fn(usize, [*]const u8) -> i32
const TabFn = fn(usize, i32) -> void
const OpenedFn = fn(usize, *i32) -> i32
const LoadFn = fn(usize, i32, [*]const u8) -> i32
const ResizeFn = fn(usize, i32, i32) -> void
const CycleFn = fn(usize) -> i32
const PaintFn = fn(usize, [*]u32, i32, i32, i32) -> void
const PointerFn = fn(usize, i32, i32, i32, i32, u32) -> void
const WheelFn = fn(usize, i32, i32, i32, i32) -> void
const KeyFn = fn(usize, i32, u32, [*]const u8, u32) -> void
const SelectedFn = fn(usize) -> usize
const InsertFn = fn(usize, [*]const u8) -> void
const TabTextFn = fn(usize, i32) -> usize
const ReleaseFn = fn(usize) -> void
const TabStateFn = fn(usize, i32) -> i32
const SwitchFn = fn(usize, i32) -> void
const ChooserFn = fn(usize, *i32) -> usize
const ChooseFn = fn(usize, usize) -> void
const SetDownloadsFn = fn(usize, [*]const u8) -> void
const CountFn = fn(usize) -> i32
const DownloadFn = fn(usize, i32, *DownloadFacts) -> usize
const DownloadTextFn = fn(usize, i32) -> usize
const DownloadActionFn = fn(usize, u32, i32) -> void
const DamageFn = fn(usize, [*]i32, i32) -> i32

const Failure = error { NoMemory }

fn noMemory() -> Failure!void { return Failure.NoMemory }

// Milliseconds between two turns of WebCore's loop.
const TICK: usize = 15
const TEXT_CAPACITY: usize = 64
// The toolbar's height above the page; its buttons' size and the gap
// around them (logical pixels).
const TOOLBAR: i32 = 40
const BUTTON: i32 = 28
const GAP: i32 = 6
// The sidebar's width open and folded (logical pixels), the glide between
// (milliseconds).
const SIDEBAR_OPEN: i32 = 220
const SIDEBAR_FOLDED: i32 = 48
const GLIDE: u64 = 200
// The window's size at first (logical pixels): the page 740 x 600 by the
// open sidebar.
const WINDOW_WIDTH: i32 = 960
const WINDOW_HEIGHT: i32 = 640
const HISTORY: usize = 64
// Linux's key codes of the letters and digits the shortcuts use.
const KEY_1: u32 = 2
const KEY_9: u32 = 10
const KEY_W: u32 = 17
const KEY_T: u32 = 20
const KEY_L: u32 = 38
const KEY_X: u32 = 45
const KEY_B: u32 = 48

// The toolbar's and the sidebar's widgets.
const ID_BACK: u64 = 1
const ID_FORWARD: u64 = 2
const ID_RELOAD: u64 = 3
const ID_ADDRESS: u64 = 4
const ID_SIDEBAR: u64 = 5
const ID_NEW_TAB: u64 = 6
const ID_DOWNLOADS: u64 = 7
const ID_POPOVER: u64 = 8
const ID_CLEAR: u64 = 9

// A tab: the engine's id, its title and URL as last read, the URLs it
// went to and which is shown, whether it loads.
const Tab = struct {
    id: i32
    title: Bytes
    url: Bytes
    history: Places
    historyIndex: usize
    goingThroughHistory: bool
    loading: bool
    // Whether it was painted in forced dark when last traced (-1: never).
    forced: i32
}

const Tabs = list_module.ArrayList(*Tab)

const State = struct {
    table: *const Table
    host: *host.Host
    environment: [*][*]const u8
    pointerX: i32
    pointerY: i32
    // The button held on the page (0: none), for motion with it
    // (selecting); whether the one held went down on the chrome (the
    // toolbar or the sidebar).
    button: u32
    chromeHeld: bool
    // The modifier keys held (std.ui.keys' bits), as their keys said.
    held: u32
    width: i32
    height: i32
    // What a key typed, as a C string for the engine.
    typed: [TEXT_CAPACITY]u8
    // The clipboard's text or a URL to load, as a C string for the engine.
    pasted: Bytes
    // The tabs in the sidebar's order, the one shown (its index).
    tabs: Tabs
    shown: usize
    // The shown tab's title and URL last written (a switch writes them).
    shownTitle: Bytes
    shownUrl: Bytes
    // The address field, and whether it had the keys when the button
    // went down on it (a first click selects all of it).
    address: field.Field
    addressFocusedAtPress: bool
    // The sidebar: open or folded; its glide (logical widths, its start in
    // milliseconds; 0: standing) and the width it has now.
    sidebarOpen: bool
    glideFrom: i32
    glideTo: i32
    glideStart: u64
    sidebarWidth: i32
    // The phase of the caret's blink and of the loading dots last drawn,
    // and the scheme the pages were given (-1: none yet).
    blink: u64
    dark: i32
    // The widgets' context and look.
    ui: view.Ui
    theme: theme_module.Theme
    text: text_module.Text
    // VOYAGER_TRACE in the environment: the address field's state when it
    // takes the keys, and the tabs' events, on standard error.
    trace: bool
    traced: usize
    // A page's file chooser shown (std.ui.chooser), and the folder it
    // starts in (the home folder, then the one last chosen in).
    chooser: chooser_module.Chooser
    choosing: bool
    chooserFolder: Bytes
    chooserTraced: Bytes
    // The downloads as last drawn (how many, their bytes and states
    // summed up): a change draws them again.
    downloadsSeen: u64
    // The downloads button: shown (there is a download), its place; the
    // popover open, where it was drawn; the drop's start (0: none), the
    // newest download seen and whether the first look was taken; the
    // last click on a row (a double click opens); the row state traced.
    buttonShown: bool
    buttonArea: ui.Rect
    popoverOpen: bool
    popoverShown: ui.Rect
    dropStart: u64
    newestSeen: u32
    downloadsStarted: bool
    lastClickRow: u64
    lastClickTime: u64
    tracedRow: u64
    // Whether the last frame had something over the page (the chooser,
    // the popover, the sidebar gliding): the frame after it is damaged
    // whole.
    overlaid: bool
}

fn stateOf(context: *anyopaque) -> *State { unsafe { return @ptrCast(*State, context) } }

fn uiOf(state: *State) -> *view.Ui { unsafe { return @ptrCast(*view.Ui, &state.*.ui) } }

fn addressOf(state: *State) -> *field.Field { unsafe { return @ptrCast(*field.Field, &state.*.address) } }

fn engineOf(state: *State) -> usize { return state.*.table.*.engine }

fn cLength(address: usize) -> usize {
    if address == 0 { return 0 }
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address) }
    var length: usize = 0
    while bytes[length] != 0 { length += 1 }
    return length
}

fn bytesAt(address: usize, length: usize) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address) }
    return bytes[0..length]
}

fn release(state: *State, address: usize) -> void {
    if address == 0 { return }
    const function: ReleaseFn = unsafe { @ptrFromInt(ReleaseFn, state.*.table.*.release) }
    function(address)
}

// TEXT as a C string in TO (cut to its capacity).
fn terminated(to: [*]u8, capacity: usize, text: []const u8) -> [*]const u8 {
    var length = if text.length < capacity - 1 { text.length } else { capacity - 1 }
    var index: usize = 0
    while index < length {
        to[index] = text[index]
        index += 1
    }
    to[length] = 0
    unsafe { return @ptrCast([*]const u8, to) }
}

// Whether TEXT is what SAVED holds; it holds TEXT after.
fn changed(saved: *Bytes, text: []const u8) -> bool {
    if std.text.same(saved.*.items(), text) { return false }
    saved.*.clearRetainingCapacity()
    _ = saved.*.appendSlice(text)
    return true
}

// TEXT as a C string in INTO (its memory, until it is used again).
fn cString(into: *Bytes, text: []const u8) -> [*]const u8 {
    into.*.clearRetainingCapacity()
    if !into.*.appendSlice(text) || !into.*.append(0) { return "".pointer }
    return into.*.items().pointer
}

fn say(prefix: []const u8, text: []const u8) -> void {
    _ = std.io.eprint(prefix)
    _ = std.io.eprintln(text)
}

// "voyager: tab N WHAT TEXT" (with VOYAGER_TRACE).
fn sayTab(state: *State, tab: *Tab, what: []const u8, text: []const u8) -> void {
    if !state.*.trace { return }
    _ = std.io.eprint("voyager: tab ")
    _ = std.io.writeUnsigned(std.io.stderr(), @intCast(usize, tab.*.id))
    _ = std.io.eprint(" ")
    _ = std.io.eprint(what)
    if text.length > 0 { _ = std.io.eprint(" ") }
    _ = std.io.eprintln(text)
}

fn addressFocused(state: *State) -> bool { return view.hasFocus(uiOf(state), ID_ADDRESS) }

// ---------------------------------------------------------------------------
// The tabs

fn tabCount(state: *State) -> usize { return state.*.tabs.count() }

fn tabAt(state: *State, index: usize) -> *Tab { return state.*.tabs.items()[index] }

fn shownTab(state: *State) -> ?*Tab {
    if state.*.shown >= tabCount(state) { return null }
    return tabAt(state, state.*.shown)
}

// A tab of the engine's (ID) in the sidebar, after the shown one: its
// index.
fn addTab(state: *State, id: i32) -> ?usize {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(Tab), 16)
    if memory == null { return null }
    const tab: *Tab = unsafe { @ptrCast(*Tab, memory.?) }
    tab.*.id = id
    tab.*.title = Bytes.init(allocator)
    tab.*.url = Bytes.init(allocator)
    tab.*.history = Places.init(allocator)
    tab.*.historyIndex = 0
    tab.*.goingThroughHistory = false
    tab.*.loading = false
    tab.*.forced = -1
    const at = if tabCount(state) == 0 { 0 } else { state.*.shown + 1 }
    if !state.*.tabs.insert(at, tab) {
        allocator.free(memory.?, @sizeOf(Tab), 16)
        return null
    }
    sayTab(state, tab, "opened", "")
    return at
}

// A URL gone to, given back.
fn forget(place: []u8) -> void {
    if place.length == 0 { return }
    const allocator = std.heap.allocator()
    allocator.free(place.pointer, place.length, 1)
}

fn freeTab(tab: *Tab) -> void {
    for place in tab.*.history.items() { forget(place) }
    tab.*.history.deinit()
    tab.*.title.deinit()
    tab.*.url.deinit()
    const allocator = std.heap.allocator()
    unsafe { allocator.free(@ptrCast([*]u8, tab), @sizeOf(Tab), 16) }
}

// The tab at INDEX shown: painted, given the events; the window's title
// and the address field its.
fn showTab(state: *State, index: usize) -> void {
    if index >= tabCount(state) { return }
    state.*.shown = index
    const tab = tabAt(state, index)
    const select: SwitchFn = unsafe { @ptrFromInt(SwitchFn, state.*.table.*.select) }
    select(engineOf(state), tab.*.id)
    sayTab(state, tab, "shown", "")
    if addressFocused(state) { view.setFocus(uiOf(state), view.NONE) }
    followShown(state)
    showUrl(state)
    host.redraw(state.*.host)
}

// A new tab (TARGET loaded in it; none: an empty one), shown.
fn newTab(state: *State, target: []const u8) -> void {
    const open: OpenFn = unsafe { @ptrFromInt(OpenFn, state.*.table.*.open) }
    const id = open(engineOf(state), cString(&state.*.pasted, target))
    if id == 0 { return }
    const at = addTab(state, id)
    if at != null { showTab(state, at.?) }
}

// The tab at INDEX closed; the last one closes the window.
fn closeTab(state: *State, index: usize) -> void {
    if index >= tabCount(state) { return }
    const tab = state.*.tabs.orderedRemove(index)
    sayTab(state, tab, "closed", "")
    const close: TabFn = unsafe { @ptrFromInt(TabFn, state.*.table.*.close) }
    close(engineOf(state), tab.*.id)
    freeTab(tab)
    if tabCount(state) == 0 {
        say("voyager: ", "the last tab was closed")
        host.quit(state.*.host)
        return
    }
    // The one after it shown (the one before when it was the last), or
    // the shown one kept where it is.
    if index < state.*.shown {
        state.*.shown -= 1
    } else if index == state.*.shown {
        showTab(state, if index < tabCount(state) { index } else { tabCount(state) - 1 })
    }
    host.redraw(state.*.host)
}

// The tabs the engine opened itself (the first one, window.open, a link's
// target, middle clicks): in the sidebar, shown when it says so.
fn takeOpened(state: *State) -> void {
    const opened: OpenedFn = unsafe { @ptrFromInt(OpenedFn, state.*.table.*.opened) }
    while true {
        var foreground: i32 = 0
        const id = opened(engineOf(state), &foreground)
        if id == 0 { return }
        const at = addTab(state, id)
        if at != null && (foreground != 0 || tabCount(state) == 1) { showTab(state, at.?) }
        host.redraw(state.*.host)
    }
}

// TEXT in a block of its own (null without memory, or when empty). (Not a
// Bytes made and handed over with toOwnedSlice: in libvoyager.so, mlx4
// crashes on that, "touching 0x0" in importIndex.)
fn remember(text: []const u8) -> ?[]u8 {
    if text.length == 0 { return null }
    const allocator = std.heap.allocator()
    const block = allocator.alloc(text.length, 1)
    if block == null { return null }
    const bytes: [*]u8 = block.?
    var index: usize = 0
    while index < text.length {
        bytes[index] = text[index]
        index += 1
    }
    return bytes[0..text.length]
}

// A tab's title, URL, loading and forced dark as the engine has them now;
// a new URL is a new place in its history (unless it went back or
// forward to it).
fn followTab(state: *State, tab: *Tab) -> void {
    const titleFn: TabTextFn = unsafe { @ptrFromInt(TabTextFn, state.*.table.*.title) }
    const title = titleFn(engineOf(state), tab.*.id)
    const titleText = bytesAt(title, cLength(title))
    if changed(&tab.*.title, titleText) {
        sayTab(state, tab, "title", titleText)
        host.redraw(state.*.host)
    }
    release(state, title)
    const urlFn: TabTextFn = unsafe { @ptrFromInt(TabTextFn, state.*.table.*.url) }
    const url = urlFn(engineOf(state), tab.*.id)
    const urlText = bytesAt(url, cLength(url))
    if urlText.length > 0 && changed(&tab.*.url, urlText) {
        sayTab(state, tab, "url", urlText)
        if tab.*.goingThroughHistory {
            tab.*.goingThroughHistory = false
        } else {
            // A new place: what was forward of the shown one is gone (the
            // oldest too, beyond HISTORY).
            const places = &tab.*.history
            if places.*.count() > 0 {
                while places.*.count() > tab.*.historyIndex + 1 { forget(places.*.pop().?) }
            }
            if places.*.count() == HISTORY { forget(places.*.orderedRemove(0)) }
            const copy = remember(urlText)
            if copy != null && places.*.append(copy.?) { tab.*.historyIndex = places.*.count() - 1 }
        }
        host.redraw(state.*.host)
    }
    release(state, url)
    const loadingFn: TabStateFn = unsafe { @ptrFromInt(TabStateFn, state.*.table.*.loading) }
    const loading = loadingFn(engineOf(state), tab.*.id) != 0
    if loading != tab.*.loading {
        tab.*.loading = loading
        host.redraw(state.*.host)
    }
    if state.*.trace {
        const forcedFn: TabStateFn = unsafe { @ptrFromInt(TabStateFn, state.*.table.*.forcedDark) }
        const forced = forcedFn(engineOf(state), tab.*.id)
        if forced != tab.*.forced {
            tab.*.forced = forced
            sayTab(state, tab, "forced dark", if forced != 0 { "yes" } else { "no" })
        }
    }
}

// The shown tab's title and URL: the window's title, the address field,
// and a line each when new.
fn followShown(state: *State) -> void {
    const shown = shownTab(state)
    if shown == null { return }
    const tab = shown.?
    if changed(&state.*.shownTitle, tab.*.title.items()) {
        say("voyager: title ", tab.*.title.items())
        host.setTitle(state.*.host, if tab.*.title.count() > 0 { tab.*.title.items() } else { "Voyager" })
    }
    if tab.*.url.count() > 0 && changed(&state.*.shownUrl, tab.*.url.items()) {
        say("voyager: url ", tab.*.url.items())
        if !addressFocused(state) { showUrl(state) }
    }
}

// The shown page's URL in the address field (none for an empty tab).
fn showUrl(state: *State) -> void {
    const shown = shownTab(state)
    if shown == null { return }
    const url = shown.?.*.url.items()
    field.set(addressOf(state), if std.text.same(url, "about:blank") { "" } else { url })
}

// Loads TEXT (an address typed, of any length) in the shown tab.
fn load(state: *State, text: []const u8) -> void {
    const shown = shownTab(state)
    if shown == null { return }
    const target = &state.*.pasted
    target.*.clearRetainingCapacity()
    // (No scheme: http. data: and about: have no slashes after theirs;
    // about:about and about:version are Voyager's pages, the engine's urlOf.)
    var hasScheme = text.length > 6 && std.text.same(text[0..6], "about:")
    var i: usize = 0
    while i + 2 < text.length {
        if text[i] == 58 && text[i + 1] == 47 { hasScheme = true }
        if text[i] == 47 || text[i] == 46 { break }
        i += 1
    }
    if !hasScheme && !(text.length > 5 && text[0] == 100 && text[4] == 58) { _ = target.*.appendSlice("http://") }
    if !target.*.appendSlice(text) || !target.*.append(0) { return }
    const loadFn: LoadFn = unsafe { @ptrFromInt(LoadFn, state.*.table.*.load) }
    _ = loadFn(engineOf(state), shown.?.*.id, target.*.items().pointer)
}

// One step back (STEP -1) or forward (1) through the URLs the shown tab
// went to.
fn goThroughHistory(state: *State, step: i32) -> void {
    const shown = shownTab(state)
    if shown == null { return }
    const tab = shown.?
    if step < 0 && tab.*.historyIndex == 0 { return }
    if step > 0 && tab.*.historyIndex + 1 >= tab.*.history.count() { return }
    tab.*.historyIndex = if step < 0 { tab.*.historyIndex - 1 } else { tab.*.historyIndex + 1 }
    tab.*.goingThroughHistory = true
    load(state, tab.*.history.items()[tab.*.historyIndex])
}

// Reload, or stop while the page loads.
fn reloadOrStop(state: *State) -> void {
    const shown = shownTab(state)
    if shown == null { return }
    const action: TabFn = unsafe { @ptrFromInt(TabFn, if shown.?.*.loading { state.*.table.*.stop } else { state.*.table.*.reload }) }
    action(engineOf(state), shown.?.*.id)
}

// ---------------------------------------------------------------------------
// The sidebar's glide

fn now() -> u64 { return @intCast(u64, std.time.milliseconds()) }

fn toggleSidebar(state: *State) -> void {
    state.*.sidebarOpen = !state.*.sidebarOpen
    state.*.glideFrom = state.*.sidebarWidth
    state.*.glideTo = if state.*.sidebarOpen { SIDEBAR_OPEN } else { SIDEBAR_FOLDED }
    state.*.glideStart = now()
    if state.*.trace { say("voyager: sidebar ", if state.*.sidebarOpen { "opens" } else { "folds" }) }
    host.redraw(state.*.host)
}

// The sidebar's width now (logical pixels): eased from where it was to
// where it goes; true while it moves.
fn glide(state: *State) -> bool {
    if state.*.glideStart == 0 { return false }
    const elapsed = now() - state.*.glideStart
    if elapsed >= GLIDE {
        state.*.sidebarWidth = state.*.glideTo
        state.*.glideStart = 0
        if state.*.trace {
            _ = std.io.eprint("voyager: sidebar width ")
            _ = std.io.writeUnsigned(std.io.stderr(), @intCast(usize, state.*.sidebarWidth))
            _ = std.io.eprintln("")
        }
        return false
    }
    // (smoothstep, in 1024ths.)
    const t = @intCast(i64, elapsed * 1024 / GLIDE)
    const eased = t * t * (3 * 1024 - 2 * t) / (1024 * 1024)
    state.*.sidebarWidth = state.*.glideFrom + @intCast(i32, @intCast(i64, state.*.glideTo - state.*.glideFrom) * eased / 1024)
    return true
}

// The page's place: right of the sidebar, under the toolbar (pixels).
fn pageLeft(state: *State) -> i32 { return state.*.sidebarWidth * state.*.theme.scale }

fn pageTop(state: *State) -> i32 { return TOOLBAR * state.*.theme.scale }

fn resizePage(state: *State) -> void {
    const width = state.*.width - pageLeft(state)
    const height = state.*.height - pageTop(state)
    const resize: ResizeFn = unsafe { @ptrFromInt(ResizeFn, state.*.table.*.resize) }
    resize(engineOf(state), if width > 1 { width } else { 1 }, if height > 1 { height } else { 1 })
}

// ---------------------------------------------------------------------------
// Drawing

// The pages get the desktop's scheme when it changes (dark when the look
// is more than half way to dark).
fn followScheme(state: *State, lightness: i32) -> void {
    const dark: i32 = if lightness < appearance.LIGHT / 2 { 1 } else { 0 }
    if dark == state.*.dark { return }
    state.*.dark = dark
    const setDark: SwitchFn = unsafe { @ptrFromInt(SwitchFn, state.*.table.*.setDark) }
    setDark(engineOf(state), dark)
}

// The sidebar's mark: a window with its left part set off.
fn drawSidebarMark(canvas: *app.Canvas, x: i32, y: i32, color: u32, s: i32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 16 * s, 13 * s, 2 * s, s + s / 2, color)
    canvas_module.fillRect(canvas, x + 5 * s, y, s + s / 2, 13 * s, color)
}

// The toolbar's widgets, laid out across `width` (on a layout canvas
// only named, the clicks taken).
fn drawToolbar(state: *State, canvas: *app.Canvas, width: i32) -> void {
    const context = uiOf(state)
    const theme = context.*.theme
    const s = theme.*.scale
    const height = TOOLBAR * s
    canvas_module.fillRect(canvas, 0, 0, width, height, theme.*.panel)
    canvas_module.fillRect(canvas, 0, height - s, width, s, theme.*.divider)
    const size = BUTTON * s
    const top = (height - size) / 2
    var x = GAP * s
    const tab = shownTab(state)
    if controls.iconButton(context, ID_SIDEBAR, ui.rect(x, top, size, size), controls.BUTTON_PLAIN) { toggleSidebar(state) }
    drawSidebarMark(canvas, x + (size - 16 * s) / 2, top + (size - 13 * s) / 2, theme.*.text, s)
    x += size + 4 * s
    const canBack = tab != null && tab.?.*.historyIndex > 0
    const canForward = tab != null && tab.?.*.historyIndex + 1 < tab.?.*.history.count()
    if controls.chevronButton(context, ID_BACK, ui.rect(x, top, size, size), true, canBack) { goThroughHistory(state, -1) }
    x += size + 4 * s
    if controls.chevronButton(context, ID_FORWARD, ui.rect(x, top, size, size), false, canForward) { goThroughHistory(state, 1) }
    x += size + 4 * s
    const reloadArea = ui.rect(x, top, size, size)
    const clicked = controls.iconButton(context, ID_RELOAD, reloadArea, controls.BUTTON_PLAIN)
    if tab != null && tab.?.*.loading {
        glyphs.crossScaled(canvas, x + (size - 9 * s) / 2, top + (size - 8 * s) / 2, theme.*.text, s)
    } else {
        glyphs.reloadScaled(canvas, x + (size - 14 * s) / 2, top + (size - 14 * s) / 2, theme.*.text, s)
    }
    if clicked { reloadOrStop(state) }
    x += size + GAP * s
    // The downloads button at the right end, once there is a download.
    var right = width - GAP * s
    if state.*.buttonShown {
        state.*.buttonArea = ui.rect(right - size, top, size, size)
        drawDownloadsButton(state, canvas, state.*.buttonArea, summary(state))
        right = state.*.buttonArea.x - GAP * s
    }
    const area = ui.rect(x, top, right - x, size)
    if field.textField(context, ID_ADDRESS, area, addressOf(state), "Address", false) && !state.*.addressFocusedAtPress {
        field.selectAll(addressOf(state))
    }
    if state.*.trace && canvas.*.width > 0 { traceAddress(state, area.width - 2 * theme.*.padding) }
}

// With VOYAGER_TRACE, once when the address field has the keys: its
// length, the caret, and whether its end is in view (the field scrolled
// to it, the caret within the WIDTH of its text).
fn traceAddress(state: *State, width: i32) -> void {
    const address = addressOf(state)
    const focused = addressFocused(state)
    const key: usize = if focused { field.text(address).length * 2 + 1 } else { 0 }
    if key == state.*.traced { return }
    state.*.traced = key
    if !focused { return }
    const whole = text_module.measure(uiOf(state).*.body, field.text(address))
    const shown = address.*.cursor == field.text(address).length && whole - address.*.scroll <= width && (whole <= width || address.*.scroll > 0)
    _ = std.io.eprint("voyager: address focused, ")
    _ = std.io.writeUnsigned(std.io.stderr(), field.text(address).length)
    _ = std.io.eprint(" bytes, ")
    _ = std.io.eprintln(if shown { "its end in view" } else { "its end not in view" })
}

// A tab's label: its title, else its URL, else "New tab".
fn labelOf(tab: *Tab) -> []const u8 {
    if tab.*.title.count() > 0 { return tab.*.title.items() }
    if tab.*.url.count() > 0 && !std.text.same(tab.*.url.items(), "about:blank") { return tab.*.url.items() }
    return "New tab"
}

// A tab's mark in the glyph's box: a pulsing dot in the accent while it
// loads, else its label's first letter on a small square.
fn drawTabMark(state: *State, canvas: *app.Canvas, tab: *Tab, x: i32, y: i32) -> void {
    const context = uiOf(state)
    const theme = context.*.theme
    const s = theme.*.scale
    const box = sidebar.GLYPH * s
    canvas_module.fillRoundedRect(canvas, x, y, box, box, theme.*.smallRadius, if tab.*.loading { theme.*.selected } else { theme.*.raised })
    if tab.*.loading {
        const phase = @intCast(i32, (now() / 120) % 4)
        const dot = 6 * s + phase * s
        glyphs.dot(canvas, x + (box - dot) / 2, y + (box - dot) / 2, dot, theme.*.accent)
        return
    }
    const label = labelOf(tab)
    var first: [4]u8 = undefined
    const firstBytes: [*]u8 = &first
    var length: usize = 0
    if label.length > 0 {
        length = 1
        while length < label.length && length < 4 && label[length] & 192 == 128 { length += 1 }
        var index: usize = 0
        while index < length {
            firstBytes[index] = if index == 0 && label[0] >= 97 && label[0] <= 122 { label[0] - 32 } else { label[index] }
            index += 1
        }
    }
    const letter = firstBytes[0..length]
    const letterWidth = text_module.measure(context.*.small, letter)
    controls.label(context, context.*.small, letter, x + (box - letterWidth) / 2, controls.textTop(context.*.small, y, box), theme.*.text, box)
}

// The sidebar (WIDTH pixels wide, under the toolbar): the tabs' rows, a
// new tab's row; folded, only their marks.
fn drawSidebar(state: *State, canvas: *app.Canvas, width: i32, height: i32) -> void {
    const context = uiOf(state)
    const theme = context.*.theme
    const s = theme.*.scale
    const area = ui.rect(0, TOOLBAR * s, width, height - TOOLBAR * s)
    if area.width <= 0 || area.height <= 0 { return }
    canvas_module.fillRect(canvas, area.x, area.y, area.width, area.height, theme.*.panel)
    sidebar.background(context, area)
    const labels = width >= 120 * s
    var y = area.y + 8 * s
    var index: usize = 0
    var closing: usize = tabCount(state)
    var choosing: usize = tabCount(state)
    while index < tabCount(state) {
        const tab = tabAt(state, index)
        const row = sidebar.rowArea(context, area, y)
        const rowId = view.idOf(view.id("tab"), index)
        const closeId = view.idOf(view.id("tab-close"), index)
        if sidebar.item(context, rowId, row, "", index == state.*.shown, false) { choosing = index }
        drawTabMark(state, canvas, tab, sidebar.glyphX(context, row), sidebar.glyphY(context, row))
        if labels {
            const close = ui.rect(ui.right(row) - 24 * s, row.y + (row.height - 20 * s) / 2, 20 * s, 20 * s)
            const left = row.x + 36 * s
            controls.label(context, context.*.body, labelOf(tab), left, controls.textTop(context.*.body, row.y, row.height), theme.*.text, close.x - left - 4 * s)
            if lists.part(context, closeId, close) { closing = index }
            const lit = view.isHover(context, closeId)
            if lit { canvas_module.fillRoundedRect(canvas, close.x, close.y, close.width, close.height, close.height / 2, theme.*.buttonHover) }
            if lit || index == state.*.shown || view.isHover(context, rowId) {
                glyphs.crossScaled(canvas, close.x + (close.width - 9 * s) / 2, close.y + (close.height - 8 * s) / 2, if lit { theme.*.text } else { theme.*.dim }, s)
            }
        }
        y += sidebar.ROW * s + 2 * s
        index += 1
    }
    // A new tab.
    const row = sidebar.rowArea(context, area, y + 4 * s)
    const wanted = sidebar.item(context, ID_NEW_TAB, row, if labels { "New tab" } else { "" }, false, labels)
    glyphs.plus(canvas, sidebar.glyphX(context, row) + 4 * s, sidebar.glyphY(context, row) + 4 * s, 12 * s, 2 * s, theme.*.dim)
    if wanted {
        newTab(state, "")
        focusAddress(state)
    } else if closing < tabCount(state) {
        closeTab(state, closing)
    } else if choosing < tabCount(state) && choosing != state.*.shown {
        showTab(state, choosing)
    }
}

// ---------------------------------------------------------------------------
// Downloads: the toolbar's button and its popover

// A download as the engine gives it (engine.cpp's VoyagerDownload).
const DownloadFacts = struct {
    received: u64
    expected: u64
    rate: u64
    id: u32
    state: i32
    resumable: i32
    reserved: i32
}

const DOWNLOAD_RUNNING: i32 = 0
const DOWNLOAD_DONE: i32 = 1
const DOWNLOAD_FAILED: i32 = 2
const DOWNLOAD_PAUSED: i32 = 3
const DOWNLOAD_CANCELLED: i32 = 4

// The engine's actions on a download.
const ACTION_PAUSE: i32 = 0
const ACTION_RESUME: i32 = 1
const ACTION_CANCEL: i32 = 2
const ACTION_CLEAR: i32 = 3

// The popover's size (logical pixels): its width, a row's height, the
// most rows it shows, its footer; the drop's length (milliseconds); the
// most time between the clicks of a double click.
const POPOVER_WIDTH: i32 = 380
const POPOVER_ROW: i32 = 58
const POPOVER_ROWS: i32 = 6
const POPOVER_FOOTER: i32 = 44
const DROP: u64 = 700
const DOUBLE_CLICK: u64 = 400

fn downloadCount(state: *State) -> i32 {
    const countFn: CountFn = unsafe { @ptrFromInt(CountFn, state.*.table.*.downloadCount) }
    return countFn(engineOf(state))
}

// Download INDEX's facts, its name into NAME; false when there is none.
fn downloadAt(state: *State, index: i32, facts: *DownloadFacts, name: *Bytes) -> bool {
    const downloadFn: DownloadFn = unsafe { @ptrFromInt(DownloadFn, state.*.table.*.download) }
    const text = downloadFn(engineOf(state), index, facts)
    if text == 0 { return false }
    name.*.clearRetainingCapacity()
    _ = name.*.appendSlice(bytesAt(text, cLength(text)))
    release(state, text)
    return true
}

// Download INDEX's path or MIME type into INTO.
fn downloadText(state: *State, index: i32, which: usize, into: *Bytes) -> void {
    const textFn: DownloadTextFn = unsafe { @ptrFromInt(DownloadTextFn, which) }
    into.*.clearRetainingCapacity()
    const text = textFn(engineOf(state), index)
    if text == 0 { return }
    _ = into.*.appendSlice(bytesAt(text, cLength(text)))
    release(state, text)
}

fn downloadAction(state: *State, id: u32, action: i32) -> void {
    const actionFn: DownloadActionFn = unsafe { @ptrFromInt(DownloadActionFn, state.*.table.*.downloadAction) }
    actionFn(engineOf(state), id, action)
}

// BYTES as "12.3 MB" (B, kB, MB, GB; one decimal under a hundred) after
// what INTO holds.
fn putSize(into: *Bytes, bytes: u64) -> void {
    var unit: []const u8 = " B"
    var scale: u64 = 1
    if bytes >= 1073741824 {
        unit = " GB"
        scale = 1073741824
    } else if bytes >= 1048576 {
        unit = " MB"
        scale = 1048576
    } else if bytes >= 1024 {
        unit = " kB"
        scale = 1024
    }
    const tenths = bytes * 10 / scale
    putNumber(into, tenths / 10)
    if scale > 1 && tenths < 1000 {
        _ = into.*.append(46)
        _ = into.*.append(@intCast(u8, 48 + tenths % 10))
    }
    _ = into.*.appendSlice(unit)
}

fn putNumber(into: *Bytes, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    _ = into.*.appendSlice(digits[24 - count..24])
}

// SECONDS as "20 s", "3 min", "2 h".
fn putDuration(into: *Bytes, seconds: u64) -> void {
    if seconds < 60 {
        putNumber(into, if seconds == 0 { 1 } else { seconds })
        _ = into.*.appendSlice(" s")
    } else if seconds < 3600 {
        putNumber(into, (seconds + 30) / 60)
        _ = into.*.appendSlice(" min")
    } else {
        putNumber(into, (seconds + 1800) / 3600)
        _ = into.*.appendSlice(" h")
    }
}

// What a download's row says under its name: "12.3 MB of 45.6 MB — 20 s
// remaining" while it runs, its size and "Done" once done, "Paused",
// "Failed", "Cancelled".
fn statusOf(facts: *const DownloadFacts, into: *Bytes) -> void {
    into.*.clearRetainingCapacity()
    const state = facts.*.state
    if state == DOWNLOAD_DONE {
        putSize(into, facts.*.received)
        _ = into.*.appendSlice(" \xe2\x80\x94 Done")
        return
    }
    if state == DOWNLOAD_FAILED {
        _ = into.*.appendSlice("Failed")
        return
    }
    if state == DOWNLOAD_CANCELLED {
        _ = into.*.appendSlice("Cancelled")
        return
    }
    putSize(into, facts.*.received)
    if facts.*.expected > 0 {
        _ = into.*.appendSlice(" of ")
        putSize(into, facts.*.expected)
    }
    if state == DOWNLOAD_PAUSED {
        _ = into.*.appendSlice(" \xe2\x80\x94 Paused")
        return
    }
    if facts.*.expected > facts.*.received && facts.*.rate > 0 {
        _ = into.*.appendSlice(" \xe2\x80\x94 ")
        putDuration(into, (facts.*.expected - facts.*.received + facts.*.rate - 1) / facts.*.rate)
        _ = into.*.appendSlice(" remaining")
    }
}

// The downloads as a whole: how many, how many run, their progress
// (thousandths of what is known; -1: none known), the newest one's id.
const Summary = struct {
    count: i32
    running: i32
    permille: i32
    newest: u32
}

fn summary(state: *State) -> Summary {
    var result = Summary.{ .count = downloadCount(state), .running = 0, .permille = -1, .newest = 0 }
    var received: u64 = 0
    var expected: u64 = 0
    var facts: DownloadFacts = undefined
    var name = Bytes.init(std.heap.allocator())
    defer name.deinit()
    var index: i32 = 0
    while index < result.count {
        if downloadAt(state, index, &facts, &name) {
            if facts.id > result.newest { result.newest = facts.id }
            if facts.state == DOWNLOAD_RUNNING {
                result.running += 1
                if facts.expected > 0 {
                    received += facts.received
                    expected += facts.expected
                }
            }
        }
        index += 1
    }
    if expected > 0 { result.permille = @intCast(i32, (if received > expected { expected } else { received }) * 1000 / expected) }
    return result
}

// The toolbar's downloads button at AREA: the download mark, a progress
// ring round it while anything runs, the drop of a download just started.
fn drawDownloadsButton(state: *State, canvas: *app.Canvas, area: ui.Rect, facts: Summary) -> void {
    const context = uiOf(state)
    const theme = context.*.theme
    const s = theme.*.scale
    if controls.iconButton(context, ID_DOWNLOADS, area, controls.BUTTON_PLAIN) { togglePopover(state) }
    const centerX = area.x + area.width / 2
    const centerY = area.y + area.height / 2
    const color = if state.*.popoverOpen { theme.*.accent } else { theme.*.text }
    // (The drop: the mark falls in from above, the ring flashes.)
    var dropping: u64 = 0
    if state.*.dropStart != 0 && context.*.time >= state.*.dropStart && context.*.time - state.*.dropStart < DROP { dropping = context.*.time - state.*.dropStart }
    if facts.running > 0 {
        const permille: u32 = if facts.permille >= 0 { @intCast(u32, facts.permille) } else { 0 }
        glyphs.ring(canvas, centerX, centerY, 12 * s, 2 * s, permille, theme.*.accent, theme.*.divider)
    }
    if dropping > 0 {
        // (Smoothstep in 1024ths: from 26 above to in place.)
        const t = @intCast(i64, dropping * 1024 / DROP)
        const eased = t * t * (3 * 1024 - 2 * t) / (1024 * 1024)
        const lift = @intCast(i32, (1024 - eased) * 26 / 1024) * s
        glyphs.downloadScaled(canvas, centerX - 8 * s, centerY - 8 * s - lift, theme.*.accent, s)
        host.redraw(state.*.host)
    } else {
        glyphs.downloadScaled(canvas, centerX - 8 * s, centerY - 8 * s, color, s)
    }
}

fn togglePopover(state: *State) -> void {
    state.*.popoverOpen = !state.*.popoverOpen
    if state.*.trace { say(if state.*.popoverOpen { "voyager: downloads popover open" } else { "voyager: downloads popover closed" }, "") }
}

// The popover's place under the button (pixels): right-aligned to it,
// inside the window, ROWS rows high.
fn popoverArea(state: *State, rows: i32) -> ui.Rect {
    const s = uiOf(state).*.theme.*.scale
    const width = POPOVER_WIDTH * s
    var right = ui.right(state.*.buttonArea) + 8 * s
    if right > state.*.width - 4 * s { right = state.*.width - 4 * s }
    var left = right - width
    if left < 4 * s { left = 4 * s }
    const shown = if rows < 1 { 1 } else if rows > POPOVER_ROWS { POPOVER_ROWS } else { rows }
    return ui.rect(left, ui.bottom(state.*.buttonArea) + 6 * s, right - left, shown * POPOVER_ROW * s + POPOVER_FOOTER * s + 8 * s)
}

// Whether the pointer is over the popover (shown).
fn overPopover(state: *State) -> bool {
    if !state.*.popoverOpen { return false }
    const area = state.*.popoverShown
    return state.*.pointerX >= area.x && state.*.pointerX < ui.right(area) && state.*.pointerY >= area.y && state.*.pointerY < ui.bottom(area)
}

// The popover: the downloads, the newest first (as many as fit), each its
// file's mark, its name, its progress and what it says, its button (stop
// while it runs, resume once paused, show in its folder once done); a
// double click on a finished one opens its file; Clear takes the finished
// ones off the list (their files stay).
fn drawPopover(state: *State, canvas: *app.Canvas) -> void {
    if !state.*.popoverOpen { return }
    const context = uiOf(state)
    const theme = context.*.theme
    const s = theme.*.scale
    const count = downloadCount(state)
    const area = popoverArea(state, count)
    state.*.popoverShown = area
    popup.frame(context, ID_POPOVER, area)
    var name = Bytes.init(std.heap.allocator())
    defer name.deinit()
    var status = Bytes.init(std.heap.allocator())
    defer status.deinit()
    var kind = Bytes.init(std.heap.allocator())
    defer kind.deinit()
    var facts: DownloadFacts = undefined
    var finished = false
    var top = area.y + 4 * s
    var index = count - 1
    var shown: i32 = 0
    while index >= 0 {
        if downloadAt(state, index, &facts, &name) {
            if facts.state == DOWNLOAD_DONE || facts.state == DOWNLOAD_FAILED || facts.state == DOWNLOAD_CANCELLED { finished = true }
        }
        if shown < POPOVER_ROWS && downloadAt(state, index, &facts, &name) {
            drawDownloadRow(state, canvas, ui.rect(area.x + 4 * s, top, area.width - 8 * s, POPOVER_ROW * s), index, &facts, name.items(), &status, &kind)
            top += POPOVER_ROW * s
            shown += 1
        }
        index -= 1
    }
    if count == 0 { controls.centeredLabel(context, context.*.body, "No downloads", ui.rect(area.x, area.y, area.width, POPOVER_ROW * s), theme.*.dim) }
    // The footer: Clear.
    const footerTop = ui.bottom(area) - POPOVER_FOOTER * s
    lists.divider(context, area.x, footerTop, area.width)
    const clearWidth = controls.buttonWidth(context, context.*.body, "Clear")
    const clear = ui.rect(ui.right(area) - 10 * s - clearWidth, footerTop + (POPOVER_FOOTER * s - 28 * s) / 2, clearWidth, 28 * s)
    if controls.button(context, ID_CLEAR, clear, "Clear", controls.BUTTON_NORMAL, finished) {
        downloadAction(state, 0, ACTION_CLEAR)
        if state.*.trace { say("voyager: downloads cleared", "") }
    }
    if count > 0 {
        status.clearRetainingCapacity()
        putNumber(&status, @intCast(u64, count))
        _ = status.appendSlice(if count == 1 { " download" } else { " downloads" })
        controls.label(context, context.*.small, status.items(), area.x + 12 * s, controls.textTop(context.*.small, clear.y, clear.height), theme.*.dim, clear.x - area.x - 20 * s)
    }
}

// One download's row of the popover at ROW.
fn drawDownloadRow(state: *State, canvas: *app.Canvas, row: ui.Rect, index: i32, facts: *DownloadFacts, name: []const u8, status: *Bytes, kind: *Bytes) -> void {
    const context = uiOf(state)
    const theme = context.*.theme
    const s = theme.*.scale
    const id = facts.*.id
    const rowId = view.idOf(view.id("download-row"), @intCast(usize, id))
    const buttonId = view.idOf(view.id("download-button"), @intCast(usize, id))
    const cancelId = view.idOf(view.id("download-cancel"), @intCast(usize, id))
    // The row: a double click on a finished one opens its file.
    if popup.row(context, rowId, row, false) {
        const time = context.*.time
        if state.*.lastClickRow == rowId && time - state.*.lastClickTime <= DOUBLE_CLICK && facts.*.state == DOWNLOAD_DONE {
            openDownload(state, index, false)
            state.*.lastClickRow = 0
        } else {
            state.*.lastClickRow = rowId
            state.*.lastClickTime = time
        }
    }
    // Its file's mark.
    downloadText(state, index, state.*.table.*.downloadType, kind)
    const fileKind = glyphs.fileKind(name, kind.items())
    const markColor = if facts.*.state == DOWNLOAD_FAILED || facts.*.state == DOWNLOAD_CANCELLED { theme.*.disabled } else { theme.*.dim }
    glyphs.fileScaled(canvas, row.x + 10 * s, row.y + (row.height - 30 * s) / 2, fileKind, markColor, theme.*.accent, s + s / 2)
    // Its button at the right: stop (running), resume and cancel
    // (paused), show in the folder (done).
    const size = 24 * s
    const button = ui.rect(ui.right(row) - 8 * s - size, row.y + (row.height - size) / 2, size, size)
    var textRight = button.x - 6 * s
    if facts.*.state == DOWNLOAD_RUNNING || facts.*.state == DOWNLOAD_PAUSED || facts.*.state == DOWNLOAD_DONE {
        if controls.iconButton(context, buttonId, button, controls.BUTTON_PLAIN) {
            if facts.*.state == DOWNLOAD_RUNNING {
                downloadAction(state, id, ACTION_PAUSE)
                if state.*.trace { say("voyager: download stopped ", name) }
            } else if facts.*.state == DOWNLOAD_PAUSED {
                downloadAction(state, id, ACTION_RESUME)
                if state.*.trace { say("voyager: download resumed ", name) }
            } else {
                openDownload(state, index, true)
            }
        }
        if facts.*.state == DOWNLOAD_RUNNING {
            glyphs.crossScaled(canvas, button.x + (size - 9 * s) / 2, button.y + (size - 8 * s) / 2, theme.*.dim, s)
        } else if facts.*.state == DOWNLOAD_PAUSED {
            glyphs.reloadScaled(canvas, button.x + (size - 14 * s) / 2, button.y + (size - 14 * s) / 2, theme.*.accent, s)
        } else {
            glyphs.magnifierScaled(canvas, button.x + (size - 14 * s) / 2, button.y + (size - 14 * s) / 2, theme.*.dim, s)
        }
    }
    if facts.*.state == DOWNLOAD_PAUSED {
        const cancel = ui.rect(button.x - 4 * s - size, button.y, size, size)
        if controls.iconButton(context, cancelId, cancel, controls.BUTTON_PLAIN) {
            downloadAction(state, id, ACTION_CANCEL)
            if state.*.trace { say("voyager: download cancelled ", name) }
        }
        glyphs.crossScaled(canvas, cancel.x + (size - 9 * s) / 2, cancel.y + (size - 8 * s) / 2, theme.*.dim, s)
        textRight = cancel.x - 6 * s
    }
    // Its name, its progress, what it says.
    const left = row.x + 44 * s
    controls.label(context, context.*.body, name, left, row.y + 8 * s, if facts.*.state == DOWNLOAD_FAILED || facts.*.state == DOWNLOAD_CANCELLED { theme.*.dim } else { theme.*.text }, textRight - left)
    statusOf(facts, status)
    var statusTop = row.y + row.height - 8 * s - context.*.small.*.ascent - 4 * s
    if (facts.*.state == DOWNLOAD_RUNNING || facts.*.state == DOWNLOAD_PAUSED) {
        var permille: u64 = 0
        if facts.*.expected > 0 { permille = (if facts.*.received > facts.*.expected { facts.*.expected } else { facts.*.received }) * 1000 / facts.*.expected }
        controls.progress(context, ui.rect(left, row.y + 30 * s, textRight - left, 4 * s), @intCast(u32, permille), if facts.*.state == DOWNLOAD_PAUSED { theme.*.dim } else { theme.*.accent })
        statusTop = row.y + 38 * s
    } else {
        statusTop = row.y + 32 * s
    }
    controls.label(context, context.*.small, status.*.items(), left, statusTop, if facts.*.state == DOWNLOAD_FAILED { theme.*.danger } else { theme.*.dim }, textRight - left)
    if state.*.trace { traceRow(state, id, name, facts.*.state, status.*.items()) }
}

// With VOYAGER_TRACE, a row's state each time it changes (and a running
// one's first "of" line): "voyager: download row NAME: STATUS".
fn traceRow(state: *State, id: u32, name: []const u8, downloadState: i32, status: []const u8) -> void {
    const key = (@intCast(u64, id) << 8) | @intCast(u64, downloadState)
    if key == state.*.tracedRow { return }
    state.*.tracedRow = key
    _ = std.io.eprint("voyager: download row ")
    _ = std.io.eprint(name)
    _ = std.io.eprint(": ")
    _ = std.io.eprintln(status)
}

// Download INDEX's file opened with its application, or (SHOW) its
// folder in the desktop's Files with the file selected.
fn openDownload(state: *State, index: i32, show: bool) -> void {
    var path = Bytes.init(std.heap.allocator())
    defer path.deinit()
    downloadText(state, index, state.*.table.*.downloadPath, &path)
    if path.count() == 0 { return }
    const opened = openFile(path.items(), show)
    if state.*.trace {
        say(if show { if opened { "voyager: shown in its folder " } else { "voyager: could not show in its folder " } } else { if opened { "voyager: opened " } else { "voyager: could not open " } }, path.items())
    }
}

// The environment run gave (for the applications started).
var environmentOfRun: usize = 0

// PATH opened with its application (std.xdg.open), or (SHOW) its folder
// in the desktop's Files (org.mlx.files.desktop, which selects a file it
// is given), else the folder with the application for folders.
pub fn openFile(path: []const u8, show: bool) -> bool {
    if environmentOfRun == 0 { return false }
    const environment: [*][*]const u8 = unsafe { @ptrFromInt([*][*]const u8, environmentOfRun) }
    if !show { return xdg_open.open(environment, path) }
    if xdg_open.openWith(environment, "org.mlx.files.desktop", path) { return true }
    var slash = path.length
    while slash > 1 && path[slash - 1] != 47 { slash -= 1 }
    return xdg_open.open(environment, path[0..if slash > 1 { slash - 1 } else { 1 }])
}

// The downloads, each tick: the button shown or hidden (traced), a new
// download's drop started; whether anything changed since last drawn.
fn followDownloads(state: *State) -> bool {
    const facts = summary(state)
    var changedNow = false
    const shownNow = facts.count > 0
    if shownNow != state.*.buttonShown {
        state.*.buttonShown = shownNow
        changedNow = true
        if !shownNow { state.*.popoverOpen = false }
        if state.*.trace { say(if shownNow { "voyager: downloads button shown" } else { "voyager: downloads button hidden" }, "") }
    }
    if facts.newest > state.*.newestSeen {
        // (Not those the profile listed at the start: no drop for them.)
        if state.*.newestSeen != 0 || state.*.downloadsStarted {
            state.*.dropStart = now()
            if state.*.trace { say("voyager: download dropped into the button", "") }
        }
        state.*.newestSeen = facts.newest
    }
    state.*.downloadsStarted = true
    // (Their bytes and states, summed up: a change draws them again.)
    var sum: u64 = @intCast(u64, facts.count) << 48
    var downloadFacts: DownloadFacts = undefined
    var name = Bytes.init(std.heap.allocator())
    defer name.deinit()
    var index: i32 = 0
    while index < facts.count {
        if downloadAt(state, index, &downloadFacts, &name) { sum = sum ^ (downloadFacts.received << 8) ^ (@intCast(u64, downloadFacts.state) << 40) ^ (@intCast(u64, index) << 32) ^ downloadFacts.rate }
        index += 1
    }
    if sum != state.*.downloadsSeen {
        state.*.downloadsSeen = sum
        changedNow = true
    }
    return changedNow
}

// ---------------------------------------------------------------------------
// The file chooser

// A page's chooser waiting: shown over the page.
fn takeChooser(state: *State) -> void {
    if state.*.choosing { return }
    const chooserFn: ChooserFn = unsafe { @ptrFromInt(ChooserFn, state.*.table.*.chooser) }
    var multiple: i32 = 0
    const accept = chooserFn(engineOf(state), &multiple)
    if accept == 0 { return }
    chooser_module.startFor(&state.*.chooser, state.*.environment, "org.mlx.voyager", state.*.chooserFolder.items(), multiple != 0, bytesAt(accept, cLength(accept)))
    release(state, accept)
    state.*.choosing = true
    if addressFocused(state) { leaveAddress(state) }
    say("voyager: file chooser in ", chooser_module.folder(&state.*.chooser))
    _ = changed(&state.*.chooserTraced, chooser_module.folder(&state.*.chooser))
    host.redraw(state.*.host)
}

// The chooser closed: what was chosen (none: cancelled) to the page.
fn closeChooser(state: *State, result: u8) -> void {
    state.*.choosing = false
    const chooseFn: ChooseFn = unsafe { @ptrFromInt(ChooseFn, state.*.table.*.choose) }
    if result == chooser_module.CHOSEN {
        var paths = Bytes.init(std.heap.allocator())
        defer paths.deinit()
        chooser_module.paths(&state.*.chooser, &paths)
        _ = paths.append(0)
        _ = changed(&state.*.chooserFolder, chooser_module.folder(&state.*.chooser))
        chooseFn(engineOf(state), @intFromPtr(paths.items().pointer))
    } else {
        chooseFn(engineOf(state), 0)
    }
    host.redraw(state.*.host)
}

// The chooser over the page (on a layout canvas only named, its clicks
// taken).
fn drawChooser(state: *State, width: i32, height: i32) -> void {
    if !state.*.choosing { return }
    const area = ui.rect(pageLeft(state), pageTop(state), width - pageLeft(state), height - pageTop(state))
    const result = chooser_module.draw(&state.*.chooser, uiOf(state), area)
    // (With VOYAGER_TRACE, each folder it goes to: a place, the path
    // field, a folder's row.)
    if state.*.trace && changed(&state.*.chooserTraced, chooser_module.folder(&state.*.chooser)) { say("voyager: chooser in ", chooser_module.folder(&state.*.chooser)) }
    if result != chooser_module.WAITING { closeChooser(state, result) }
}

// The widgets laid out as the state has them now (before a press, after
// a click: the click is taken).
fn layOut(state: *State) -> void {
    var nowhere = view.layoutCanvas()
    const context = uiOf(state)
    view.begin(context, &nowhere)
    drawToolbar(state, &nowhere, state.*.width)
    drawSidebar(state, &nowhere, pageLeft(state), state.*.height)
    drawChooser(state, state.*.width, state.*.height)
    drawPopover(state, &nowhere)
    _ = view.end(context)
}

// What this frame changed, for the compositor (std.ui.host's damage): the
// toolbar and the sidebar (drawn again each frame), and the page's damage
// (the engine's compositor's), from the page's origin; all of it while
// something is over the page, and the frame after.
fn damagePage(state: *State, canvas: *app.Canvas, left: i32, top: i32, moving: bool) -> void {
    const overlaid = moving || state.*.choosing || state.*.popoverOpen
    const whole = overlaid || state.*.overlaid
    state.*.overlaid = overlaid
    if whole { return }
    const width = @intCast(i32, canvas.*.width)
    const height = @intCast(i32, canvas.*.height)
    host.damage(state.*.host, 0, 0, width, top)
    host.damage(state.*.host, 0, top, left, height - top)
    var rects: [48]i32 = undefined
    const damage: DamageFn = unsafe { @ptrFromInt(DamageFn, state.*.table.*.damage) }
    const count = damage(engineOf(state), &rects, 12)
    var index: i32 = 0
    while index < count {
        const at = @intCast(usize, index * 4)
        host.damage(state.*.host, left + rects[at], top + rects[at + 1], rects[at + 2], rects[at + 3])
        index += 1
    }
}

fn draw(context: *anyopaque, canvas: *app.Canvas) -> void {
    const state = stateOf(context)
    if canvas.*.width == 0 || canvas.*.height == 0 { return }
    if canvas.*.device != 0 {
        // (The GPU's canvas has no pixels: Voyager asks for the CPU's.)
        canvas_module.clear(canvas, 0xFFFFFFFF)
        return
    }
    const lightness = host.lightness(state.*.host)
    state.*.theme = theme_module.scaled(theme_module.at(lightness), host.scale(state.*.host))
    followScheme(state, lightness)
    const moving = glide(state)
    resizePage(state)
    // The page first, then the widgets (the chooser over the page).
    const top = pageTop(state)
    const left = pageLeft(state)
    if canvas.*.height > @intCast(usize, top) && canvas.*.width > @intCast(usize, left) {
        const paint: PaintFn = unsafe { @ptrFromInt(PaintFn, state.*.table.*.paint) }
        const below: [*]u32 = unsafe { canvas.*.pixels + @intCast(usize, top) * canvas.*.stride + @intCast(usize, left) }
        paint(engineOf(state), below, @intCast(i32, canvas.*.width) - left, @intCast(i32, canvas.*.height) - top, @intCast(i32, canvas.*.stride))
        damagePage(state, canvas, left, top, moving)
    }
    const widgets = uiOf(state)
    widgets.*.time = now()
    view.begin(widgets, canvas)
    drawToolbar(state, canvas, @intCast(i32, canvas.*.width))
    drawSidebar(state, canvas, pageLeft(state), @intCast(i32, canvas.*.height))
    drawChooser(state, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height))
    drawPopover(state, canvas)
    if view.end(widgets) || moving { host.redraw(state.*.host) }
}

// ---------------------------------------------------------------------------
// Events

fn publish(state: *State, bytes: []const u8) -> void {
    host.beginClipboard(state.*.host)
    _ = host.addClipboard(state.*.host, "text/plain;charset=utf-8", bytes)
    _ = host.addClipboard(state.*.host, "text/plain", bytes)
    _ = host.addClipboard(state.*.host, "UTF8_STRING", bytes)
    _ = host.publishClipboard(state.*.host)
}

fn clipboardText(state: *State) -> []const u8 {
    var text = host.readClipboard(state.*.host, "text/plain;charset=utf-8")
    if text.length == 0 { text = host.readClipboard(state.*.host, "UTF8_STRING") }
    if text.length == 0 { text = host.readClipboard(state.*.host, "text/plain") }
    return text
}

fn copy(state: *State) -> void {
    const selected: SelectedFn = unsafe { @ptrFromInt(SelectedFn, state.*.table.*.selectedText) }
    const text = selected(engineOf(state))
    if text == 0 { return }
    publish(state, bytesAt(text, cLength(text)))
    release(state, text)
}

fn paste(state: *State) -> void {
    const text = clipboardText(state)
    if text.length == 0 { return }
    const insert: InsertFn = unsafe { @ptrFromInt(InsertFn, state.*.table.*.insertText) }
    insert(engineOf(state), cString(&state.*.pasted, text))
}

// The address field takes the keys, all of it selected.
fn focusAddress(state: *State) -> void {
    view.setFocus(uiOf(state), ID_ADDRESS)
    field.selectAll(addressOf(state))
}

// The keys back to the page; the field shows the page's URL again.
fn leaveAddress(state: *State) -> void {
    view.setFocus(uiOf(state), view.NONE)
    showUrl(state)
}

// A key (pressed or repeated) while the address field has the keys.
fn addressKey(state: *State, key: u32, modifiers: u32) -> void {
    const address = addressOf(state)
    if modifiers & keys.CONTROL != 0 && (key == keys.C || key == KEY_X) {
        if field.hasSelection(address) {
            publish(state, field.text(address)[field.selectionStart(address)..field.selectionEnd(address)])
            if key == KEY_X { _ = field.deleteSelection(address) }
        }
        return
    }
    if modifiers & keys.CONTROL != 0 && key == keys.V {
        // (One line: what is not a character stops it.)
        const text = clipboardText(state)
        var length: usize = 0
        while length < text.length && text[length] >= 32 { length += 1 }
        if length > 0 { field.insert(address, text[0..length]) }
        return
    }
    const result = field.fieldKey(address, key, modifiers, host.typed(state.*.host))
    if result == field.KEY_SUBMIT {
        view.setFocus(uiOf(state), view.NONE)
        load(state, field.text(address))
    } else if result == field.KEY_CANCEL {
        leaveAddress(state)
    }
}

// The window's shortcuts (a key pressed with Ctrl): true when KEY was one.
fn shortcut(state: *State, key: u32, modifiers: u32) -> bool {
    const shift = modifiers & keys.SHIFT != 0
    if key == KEY_T && !shift {
        newTab(state, "")
        focusAddress(state)
        return true
    }
    if key == KEY_W && !shift {
        closeTab(state, state.*.shown)
        return true
    }
    if key == keys.TAB {
        const count = tabCount(state)
        if count > 1 { showTab(state, if shift { (state.*.shown + count - 1) % count } else { (state.*.shown + 1) % count }) }
        return true
    }
    if key >= KEY_1 && key <= KEY_9 && !shift {
        const count = tabCount(state)
        if count == 0 { return true }
        const wanted = @intCast(usize, key - KEY_1)
        showTab(state, if key == KEY_9 || wanted >= count { count - 1 } else { wanted })
        return true
    }
    if key == KEY_B && shift {
        toggleSidebar(state)
        return true
    }
    if key == KEY_L && !shift {
        focusAddress(state)
        return true
    }
    return false
}

fn pagePointer(state: *State, kind: i32, button: i32, modifiers: u32) -> void {
    const pointer: PointerFn = unsafe { @ptrFromInt(PointerFn, state.*.table.*.pointer) }
    pointer(engineOf(state), kind, state.*.pointerX - pageLeft(state), state.*.pointerY - pageTop(state), button, modifiers)
}

// Whether the pointer is over the toolbar or the sidebar.
fn overChrome(state: *State) -> bool {
    return state.*.pointerY < pageTop(state) || state.*.pointerX < pageLeft(state) || overPopover(state)
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const state = stateOf(context)
    const engine = engineOf(state)
    // (The keys' own state as well: the compositor's modifiers event may
    // come after the next key.)
    if kind == app.EVENT_KEY {
        const bit: u32 = if a == 29 || a == 97 { keys.CONTROL } else if a == 42 || a == 54 { keys.SHIFT } else if a == 56 || a == 100 { keys.ALT } else { 0 }
        if bit != 0 { state.*.held = if b != 0 { state.*.held | bit } else { state.*.held & ~bit } }
    }
    const modifiers = host.modifiers(state.*.host) | state.*.held
    if kind == app.EVENT_MOTION || kind == app.EVENT_LEAVE {
        if kind == app.EVENT_MOTION {
            state.*.pointerX = @bitCast(i32, a)
            state.*.pointerY = b
        }
        if app.feed(uiOf(state), kind, a, b) != app.FEED_NONE { host.redraw(state.*.host) }
        if kind == app.EVENT_MOTION && !state.*.chromeHeld && !state.*.choosing && (!overChrome(state) || state.*.button != 0) {
            pagePointer(state, 0, @intCast(i32, state.*.button), modifiers)
            host.redraw(state.*.host)
        }
        return
    }
    // (A press outside the open popover and its button closes it, and
    // goes no further.)
    if kind == app.EVENT_BUTTON && b == 1 && state.*.popoverOpen && !overPopover(state) && view.hitAt(uiOf(state), state.*.pointerX, state.*.pointerY) != ID_DOWNLOADS {
        togglePopover(state)
        host.redraw(state.*.host)
        return
    }
    if kind == app.EVENT_BUTTON && (state.*.chromeHeld || (b == 1 && (overChrome(state) || state.*.choosing) && state.*.button == 0)) {
        // The toolbar's or the sidebar's: their widgets take it.
        state.*.chromeHeld = b == 1
        if b == 1 { state.*.addressFocusedAtPress = addressFocused(state) }
        if app.pressing(kind, a, b) { layOut(state) }
        if app.feed(uiOf(state), kind, a, b) == app.FEED_CLICK { layOut(state) }
        host.redraw(state.*.host)
        return
    }
    if kind == app.EVENT_BUTTON {
        state.*.button = if b == 1 { a } else { 0 }
        if b == 1 && addressFocused(state) { leaveAddress(state) }
        pagePointer(state, if b == 1 { 1 } else { 2 }, @intCast(i32, a), modifiers)
    } else if kind == app.EVENT_WHEEL && state.*.choosing {
        if app.feed(uiOf(state), kind, a, b) != app.FEED_NONE { layOut(state) }
    } else if kind == app.EVENT_KEY && state.*.choosing {
        // (The chooser has the keys while it is shown.)
        if b != 0 && chooser_module.keyTyped(&state.*.chooser, a, modifiers, host.typed(state.*.host)) { layOut(state) }
    } else if kind == app.EVENT_WHEEL {
        if overChrome(state) { return }
        var pixels = host.wheelPixels(state.*.host)
        if pixels == 0 { pixels = b * 40 }
        const wheel: WheelFn = unsafe { @ptrFromInt(WheelFn, state.*.table.*.wheel) }
        const x = state.*.pointerX - pageLeft(state)
        const y = state.*.pointerY - pageTop(state)
        if a == 0 { wheel(engine, x, y, 0, pixels) } else { wheel(engine, x, y, pixels, 0) }
    } else if kind == app.EVENT_KEY && b != 0 && state.*.popoverOpen && a == keys.ESCAPE {
        togglePopover(state)
    } else if kind == app.EVENT_KEY && b != 0 && modifiers & keys.CONTROL != 0 && shortcut(state, a, modifiers) {
        host.redraw(state.*.host)
    } else if kind == app.EVENT_KEY && b != 0 && modifiers & keys.ALT != 0 && (a == keys.LEFT || a == keys.RIGHT) {
        goThroughHistory(state, if a == keys.LEFT { -1 } else { 1 })
    } else if kind == app.EVENT_KEY && addressFocused(state) {
        if b != 0 { addressKey(state, a, modifiers) }
    } else if kind == app.EVENT_KEY {
        if b != 0 && modifiers & keys.CONTROL != 0 && (a == keys.C || a == keys.V) {
            if a == keys.C { copy(state) } else { paste(state) }
        } else {
            const text = if b != 0 { host.typed(state.*.host) } else { "" }
            const key: KeyFn = unsafe { @ptrFromInt(KeyFn, state.*.table.*.key) }
            key(engine, if b != 0 { 1 } else { 0 }, a, terminated(unsafe { @ptrCast([*]u8, &state.*.typed) }, TEXT_CAPACITY, text), modifiers)
        }
    } else if kind == app.EVENT_CONFIGURED {
        state.*.width = @bitCast(i32, a)
        state.*.height = b
        resizePage(state)
    } else if kind == app.EVENT_CLOSED {
        host.quit(state.*.host)
        return
    } else if kind == app.EVENT_WATCH {
        // The engine's descriptor: work for the main thread, or a frame of
        // the shown tab's compositor to show.
        const wake: CycleFn = unsafe { @ptrFromInt(CycleFn, state.*.table.*.wake) }
        if wake(engine) != 0 { host.redraw(state.*.host) }
        return
    } else if kind == app.EVENT_TICK {
        const cycle: CycleFn = unsafe { @ptrFromInt(CycleFn, state.*.table.*.cycle) }
        if cycle(engine) != 0 { host.redraw(state.*.host) }
        takeOpened(state)
        takeChooser(state)
        if followDownloads(state) { host.redraw(state.*.host) }
        var loading = false
        var index: usize = 0
        while index < tabCount(state) {
            const tab = tabAt(state, index)
            followTab(state, tab)
            loading = loading || tab.*.loading
            index += 1
        }
        followShown(state)
        // The address field's caret, the loading dots.
        const blink = now() / 120
        if (addressFocused(state) || loading) && blink != state.*.blink {
            state.*.blink = blink
            host.redraw(state.*.host)
        }
        return
    }
    host.redraw(state.*.host)
}

// The window, until it is closed: TABLE is the engine's, ARGUMENTS main's
// (followed by the environment, as a process's are). An error: no window
// (no compositor), or its connection failed.
pub fn run(table: usize, count: usize, arguments: usize) -> !void {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(State), 16)
    if memory == null { return noMemory() }
    const state: *State = unsafe { @ptrCast(*State, memory.?) }
    state.*.table = unsafe { @ptrFromInt(*const Table, table) }
    const list: [*][*]const u8 = unsafe { @ptrFromInt([*][*]const u8, arguments) }
    state.*.environment = unsafe { @ptrFromInt([*][*]const u8, arguments + (count + 1) * @sizeOf(usize)) }
    state.*.trace = std.process.environmentFrom(state.*.environment, "VOYAGER_TRACE") != null
    state.*.traced = 0
    state.*.pointerX = 0
    state.*.pointerY = 0
    state.*.button = 0
    state.*.chromeHeld = false
    state.*.held = 0
    state.*.width = WINDOW_WIDTH
    state.*.height = WINDOW_HEIGHT
    state.*.pasted = Bytes.init(allocator)
    state.*.tabs = Tabs.init(allocator)
    state.*.shown = 0
    state.*.shownTitle = Bytes.init(allocator)
    state.*.shownUrl = Bytes.init(allocator)
    field.init(addressOf(state))
    state.*.addressFocusedAtPress = false
    state.*.sidebarOpen = true
    state.*.glideFrom = SIDEBAR_OPEN
    state.*.glideTo = SIDEBAR_OPEN
    state.*.glideStart = 0
    state.*.sidebarWidth = SIDEBAR_OPEN
    state.*.blink = 0
    state.*.dark = -1
    state.*.chooser = chooser_module.Chooser.init()
    state.*.choosing = false
    state.*.chooserFolder = Bytes.init(allocator)
    state.*.chooserTraced = Bytes.init(allocator)
    _ = state.*.chooserFolder.appendSlice(xdg.absolute(state.*.environment, "HOME"))
    state.*.downloadsSeen = 0
    state.*.buttonShown = false
    state.*.buttonArea = ui.rect(0, 0, 0, 0)
    state.*.popoverOpen = false
    state.*.popoverShown = ui.rect(0, 0, 0, 0)
    state.*.dropStart = 0
    state.*.newestSeen = 0
    state.*.downloadsStarted = false
    state.*.lastClickRow = 0
    state.*.lastClickTime = 0
    state.*.tracedRow = 0
    state.*.overlaid = true
    environmentOfRun = @intFromPtr(state.*.environment)
    // Downloads go to the user's download folder.
    var folder: [4096]u8 = undefined
    const folderBytes: [*]u8 = &folder
    if xdg.userDirectory(state.*.environment, "DOWNLOAD", "/Downloads", folderBytes, 4096) > 0 {
        const setDownloads: SetDownloadsFn = unsafe { @ptrFromInt(SetDownloadsFn, state.*.table.*.setDownloads) }
        setDownloads(engineOf(state), folderBytes)
        if state.*.trace { say("voyager: downloads go to ", bytesAt(@intFromPtr(folderBytes), cLength(@intFromPtr(folderBytes)))) }
    }
    state.*.theme = theme_module.light()
    state.*.text.loaded = false
    _ = text_module.loadText(&state.*.text, 15, allocator)
    const text: *text_module.Text = unsafe { @ptrCast(*text_module.Text, &state.*.text) }
    view.init(uiOf(state), unsafe { @ptrCast(*theme_module.Theme, &state.*.theme) }, text, text, text)
    const options = host.Options.{ .title = "Voyager", .appId = "org.mlx.voyager", .width = @intCast(u32, WINDOW_WIDTH), .height = @intCast(u32, WINDOW_HEIGHT), .minWidth = 300, .minHeight = 150 }
    const created = host.create(options, state, draw, onEvent)
    if created == null { return noMemory() }
    state.*.host = created.?
    try host.open(state.*.host, list[0..count])
    // The engine's descriptor, watched (EVENT_WATCH).
    const descriptor: CycleFn = unsafe { @ptrFromInt(CycleFn, state.*.table.*.descriptor) }
    host.watchDescriptor(state.*.host, @intCast(isize, descriptor(engineOf(state))))
    // The first tab: the engine's.
    takeOpened(state)
    host.setTick(state.*.host, TICK)
    try host.run(state.*.host)
}
