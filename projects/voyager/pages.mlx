// Voyager's internal pages (PORT.md, "Internal pages"): the voyager: scheme,
// which the engine (engine.cpp) registers with the port's
// MlxSchemeHandler and answers through voyager_page (library.mlx). The
// engine gives the facts it knows (its version, the engine's, the user
// agent, the system's, the build's) as label and value pairs; the pages
// are made here, in std.ui.theme's colours, light and dark (the page's
// own `prefers-color-scheme: dark` design, so Voyager's forced dark mode
// leaves it as it is):
//
//   voyager://          the index: the pages there are
//   voyager://about     Voyager, its version and engine, in short
//   voyager://version   everything about this build, as chrome://version
//   anything else       a 404 page
//
// (voyager://about/icon.png, Voyager's icon, is the engine's: bytes it
// has built in.) about:about and about:version typed in the address bar
// are voyager://about and voyager://version (engine.cpp's urlOf).
const std = @import("std")
const theme_module = @import("std.ui.theme")
const unicode = @import("std.unicode")
const list_module = @import("std.containers.array_list")

const Bytes = list_module.ArrayList(u8)

// What a page is answered with: its status and its bytes (HTML), given to
// the engine's DELIVER while the page's memory lives.
const DeliverFn = fn(usize, u32, [*]const u8, usize) -> void

// A page being written: its bytes, and whether memory ran out.
const Writer = @noncopy(struct) {
    bytes: Bytes
    failed: bool

    pub fn deinit(self: *Self) -> void {
        self.*.bytes.deinit()
    }
}

fn put(w: *Writer, text: []const u8) -> void {
    if !w.*.bytes.appendSlice(text) { w.*.failed = true }
}

fn putByte(w: *Writer, byte: u8) -> void {
    if !w.*.bytes.append(byte) { w.*.failed = true }
}

// TEXT with &, <, > and " written as HTML's references.
fn putEscaped(w: *Writer, text: []const u8) -> void {
    for c in text {
        if c == 38 {
            put(w, "&amp;")
        } else if c == 60 {
            put(w, "&lt;")
        } else if c == 62 {
            put(w, "&gt;")
        } else if c == 34 {
            put(w, "&quot;")
        } else {
            putByte(w, c)
        }
    }
}

fn putDecimal(w: *Writer, value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        putByte(w, digits[count])
    }
}

// An opaque ARGB colour of std.ui.theme as CSS's #rrggbb.
fn putColor(w: *Writer, color: u32) -> void {
    const hex = "0123456789abcdef"
    putByte(w, 35)
    var divisor: usize = 1048576
    while divisor > 0 {
        putByte(w, hex[(@intCast(usize, color) / divisor) % 16])
        divisor = divisor / 16
    }
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && std.text.same(text[0..prefix.length], prefix)
}

fn cLength(text: [*]const u8) -> usize {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return length
}

// The engine's facts: COUNT pairs of C strings, label then value.
const Facts = struct {
    pairs: [*]const [*]const u8
    count: usize
}

fn labelAt(facts: Facts, index: usize) -> []const u8 {
    const text = facts.pairs[index * 2]
    return text[0..cLength(text)]
}

fn valueAt(facts: Facts, index: usize) -> []const u8 {
    const text = facts.pairs[index * 2 + 1]
    return text[0..cLength(text)]
}

// The value of the fact LABEL ("" when there is none).
fn fact(facts: Facts, label: []const u8) -> []const u8 {
    var index: usize = 0
    while index < facts.count {
        if std.text.same(labelAt(facts, index), label) { return valueAt(facts, index) }
        index += 1
    }
    return ""
}

// The colours of one scheme as CSS custom properties.
fn putScheme(w: *Writer, theme: theme_module.Theme) -> void {
    put(w, "--background: ")
    putColor(w, theme.background)
    put(w, "; --panel: ")
    putColor(w, theme.panel)
    put(w, "; --raised: ")
    putColor(w, theme.raised)
    put(w, "; --text: ")
    putColor(w, theme.text)
    put(w, "; --dim: ")
    putColor(w, theme.dim)
    put(w, "; --accent: ")
    putColor(w, theme.accent)
    put(w, "; --divider: ")
    putColor(w, theme.divider)
    put(w, "; --border: ")
    putColor(w, theme.border)
    put(w, ";")
}

// The head of a page: TITLE and the style every page shares.
fn putHead(w: *Writer, title: []const u8) -> void {
    put(w, "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>")
    putEscaped(w, title)
    put(w, "</title>\n<style>\n:root { color-scheme: light dark; ")
    putScheme(w, theme_module.light())
    put(w, " }\n@media (prefers-color-scheme: dark) { :root { ")
    putScheme(w, theme_module.dark())
    put(w, " } }\n")
    put(w, "* { box-sizing: border-box; }\n")
    put(w, "html { background: var(--background); color: var(--text); font-family: sans-serif; font-size: 15px; }\n")
    put(w, "body { margin: 0; padding: 40px 24px; }\n")
    put(w, "main { max-width: 760px; margin: 0 auto; }\n")
    put(w, "a { color: var(--accent); }\n")
    put(w, "h1 { font-size: 26px; font-weight: 600; margin: 0 0 4px; }\n")
    put(w, ".dim { color: var(--dim); }\n")
    put(w, ".card { background: var(--raised); border: 1px solid var(--divider); border-radius: 8px; padding: 24px; }\n")
    put(w, ".about { text-align: center; padding: 40px 24px; }\n")
    put(w, ".about img { width: 128px; height: 128px; }\n")
    put(w, ".about p { margin: 6px 0; }\n")
    put(w, "table { border-collapse: collapse; width: 100%; }\n")
    put(w, "th, td { text-align: left; vertical-align: top; padding: 7px 10px; border-bottom: 1px solid var(--divider); }\n")
    put(w, "th { width: 180px; font-weight: 600; color: var(--dim); white-space: nowrap; }\n")
    put(w, "td { overflow-wrap: anywhere; font-family: monospace; font-size: 13px; }\n")
    put(w, "tr:last-child th, tr:last-child td { border-bottom: none; }\n")
    put(w, "ul { margin: 0; padding-left: 20px; } li { margin: 6px 0; }\n")
    put(w, "</style>\n</head>\n<body>\n<main>\n")
}

fn putFoot(w: *Writer) -> void {
    put(w, "</main>\n</body>\n</html>\n")
}

// voyager://about: the icon, the name, the version, the engine, what it
// is, and where the rest is.
fn aboutPage(w: *Writer, facts: Facts) -> void {
    putHead(w, "About Voyager")
    put(w, "<div class=\"card about\">\n<img src=\"voyager://about/icon.png\" alt=\"\">\n<h1>Voyager</h1>\n<p>Version ")
    putEscaped(w, fact(facts, "Voyager"))
    put(w, "</p>\n<p class=\"dim\">")
    putEscaped(w, fact(facts, "Engine"))
    put(w, "</p>\n<p>The web browser of the Mlx desktop: WebKit's engine, built and run on Mlx's own toolchain and libraries.</p>\n")
    put(w, "<p><a href=\"voyager://version\">Version details</a></p>\n</div>\n")
    putFoot(w)
}

fn putRow(w: *Writer, label: []const u8, value: []const u8) -> void {
    put(w, "<tr><th>")
    putEscaped(w, label)
    put(w, "</th><td>")
    putEscaped(w, value)
    put(w, "</td></tr>\n")
}

// voyager://version: every fact, as a table, std's Unicode data among them.
fn versionPage(w: *Writer, facts: Facts) -> void {
    putHead(w, "Voyager Version")
    put(w, "<h1>Voyager ")
    putEscaped(w, fact(facts, "Voyager"))
    put(w, "</h1>\n<p class=\"dim\">This build, the libraries in it and where it runs. <a href=\"voyager://about\">About Voyager</a></p>\n<div class=\"card\">\n<table>\n")
    var index: usize = 0
    while index < facts.count {
        const label = labelAt(facts, index)
        putRow(w, label, valueAt(facts, index))
        // (std.unicode's data right after the ICU API it serves.)
        if startsWith(label, "mlx-unicode") {
            put(w, "<tr><th>Unicode data</th><td>Unicode ")
            putEscaped(w, unicode.UNICODE_VERSION)
            put(w, ", CLDR ")
            putEscaped(w, unicode.CLDR_VERSION)
            put(w, " (std.unicode)</td></tr>\n")
        }
        index += 1
    }
    put(w, "</table>\n</div>\n")
    putFoot(w)
}

// voyager://: the pages there are.
fn indexPage(w: *Writer) -> void {
    putHead(w, "Voyager Pages")
    put(w, "<h1>Voyager's pages</h1>\n<p class=\"dim\">Pages of Voyager's own, at voyager:// (about:about and about:version lead there too).</p>\n<div class=\"card\">\n<ul>\n")
    put(w, "<li><a href=\"voyager://about\">voyager://about</a> <span class=\"dim\">Voyager, its version and engine</span></li>\n")
    put(w, "<li><a href=\"voyager://version\">voyager://version</a> <span class=\"dim\">this build in detail: versions, libraries, the system</span></li>\n")
    put(w, "</ul>\n</div>\n")
    putFoot(w)
}

fn notFoundPage(w: *Writer, url: []const u8) -> void {
    putHead(w, "Not Found")
    put(w, "<div class=\"card\">\n<h1>Not found</h1>\n<p>Voyager has no page <code>")
    putEscaped(w, url)
    put(w, "</code>.</p>\n<p><a href=\"voyager://\">Voyager's pages</a></p>\n</div>\n")
    putFoot(w)
}

// The page of URL (voyager:..., a C string) given to DELIVER(CONTEXT,
// status, bytes, length); FACTS: COUNT pairs of C strings. Nothing
// is delivered when memory ran out (the engine answers that itself).
pub fn page(url: [*]const u8, pairs: [*]const [*]const u8, count: usize, deliver: usize, context: usize) -> void {
    const facts = Facts.{ .pairs = pairs, .count = count }
    const whole = url[0..cLength(url)]
    // The page's name: after "voyager:" and its slashes, up to a query,
    // a fragment or a trailing slash.
    var at: usize = 0
    while at < whole.length && whole[at] != 58 { at += 1 }
    at += 1
    while at < whole.length && whole[at] == 47 { at += 1 }
    var end = at
    while end < whole.length && whole[end] != 63 && whole[end] != 35 { end += 1 }
    while end > at && whole[end - 1] == 47 { end -= 1 }
    const name = if at <= end { whole[at..end] } else { "" }

    var w = Writer.{ .bytes = Bytes.init(std.heap.allocator()), .failed = false }
    var status: u32 = 200
    if name.length == 0 {
        indexPage(&w)
    } else if std.text.same(name, "about") {
        aboutPage(&w, facts)
    } else if std.text.same(name, "version") {
        versionPage(&w, facts)
    } else {
        status = 404
        notFoundPage(&w, whole)
    }
    if w.failed { return }
    const function: DeliverFn = unsafe { @ptrFromInt(DeliverFn, deliver) }
    const bytes = w.bytes.items()
    function(context, status, bytes.pointer, bytes.length)
}
