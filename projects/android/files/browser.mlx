// Platform-independent directory model for the Android file manager. The
// Android UI roots this browser at the app's private files directory, so `up`
// can never escape the app sandbox.
const std = @import("std")

pub const MAX_ENTRIES: usize = 256
pub const MAX_NAMES: usize = 32768
pub const MAX_PATH: usize = 1024

const O_CLOEXEC: usize = 524288

pub const Entry = struct {
    nameOffset: usize
    nameLength: usize
    size: isize
    directory: bool
    hidden: bool
}

pub const Browser = struct {
    pathBytes: [1024]u8
    pathLength: usize
    rootLength: usize
    entries: [256]Entry
    names: [32768]u8
    namesUsed: usize
    count: usize
    unreadable: bool
    truncated: bool
}

fn entryAt(browser: *Browser, index: usize) -> *Entry {
    unsafe { return @ptrFromInt(*Entry, @intFromPtr(browser) + @offsetOf(Browser, "entries") + index * @sizeOf(Entry)) }
}

pub fn entry(browser: *Browser, index: usize) -> *Entry { return entryAt(browser, index) }

fn nameOf(browser: *Browser, item: *const Entry) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(browser) + @offsetOf(Browser, "names") + item.*.nameOffset) }
    return bytes[0..item.*.nameLength]
}

pub fn name(browser: *Browser, index: usize) -> []const u8 { return nameOf(browser, entryAt(browser, index)) }

pub fn path(browser: *Browser) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(browser) + @offsetOf(Browser, "pathBytes")) }
    return bytes[0..browser.*.pathLength]
}

fn pathPointer(browser: *Browser) -> [*]const u8 {
    browser.*.pathBytes[browser.*.pathLength] = 0
    unsafe { return @ptrFromInt([*]const u8, @intFromPtr(browser) + @offsetOf(Browser, "pathBytes")) }
}

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }
fn digit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn textLength(text: []const u8) -> usize {
    var length: usize = 0
    for byte in text { length += 1 }
    return length
}

// Case-insensitive natural ordering, with the original bytes as a stable
// tiebreaker: "Project 2" comes before "Project 10".
fn compareNames(first: []const u8, second: []const u8) -> i32 {
    const firstLength = textLength(first)
    const secondLength = textLength(second)
    var i: usize = 0
    var j: usize = 0
    while i < firstLength && j < secondLength {
        if digit(first[i]) && digit(second[j]) {
            var end_i = i
            while end_i < firstLength && digit(first[end_i]) { end_i += 1 }
            var end_j = j
            while end_j < secondLength && digit(second[end_j]) { end_j += 1 }
            var start_i = i
            while start_i + 1 < end_i && first[start_i] == 48 { start_i += 1 }
            var start_j = j
            while start_j + 1 < end_j && second[start_j] == 48 { start_j += 1 }
            if end_i - start_i != end_j - start_j { return if end_i - start_i < end_j - start_j { -1 } else { 1 } }
            while start_i < end_i {
                if first[start_i] != second[start_j] { return if first[start_i] < second[start_j] { -1 } else { 1 } }
                start_i += 1
                start_j += 1
            }
            i = end_i
            j = end_j
        } else {
            const a = lower(first[i])
            const b = lower(second[j])
            if a != b { return if a < b { -1 } else { 1 } }
            i += 1
            j += 1
        }
    }
    const rest_i = firstLength - i
    const rest_j = secondLength - j
    if rest_i != rest_j { return if rest_i < rest_j { -1 } else { 1 } }
    var index: usize = 0
    while index < firstLength {
        if first[index] != second[index] { return if first[index] < second[index] { -1 } else { 1 } }
        index += 1
    }
    return 0
}

fn before(browser: *Browser, first: *const Entry, second: *const Entry) -> bool {
    if first.*.directory != second.*.directory { return first.*.directory }
    return compareNames(nameOf(browser, first), nameOf(browser, second)) < 0
}

fn sort(browser: *Browser) -> void {
    var index: usize = 1
    while index < browser.*.count {
        const moving = entryAt(browser, index).*
        var target = index
        while target > 0 && before(browser, &moving, entryAt(browser, target - 1)) {
            entryAt(browser, target).* = entryAt(browser, target - 1).*
            target -= 1
        }
        entryAt(browser, target).* = moving
        index += 1
    }
}

// Reads the current directory. A failed read leaves an empty model marked
// unreadable; a full fixed-size model keeps the entries that fit.
pub fn reload(browser: *Browser) -> bool {
    browser.*.count = 0
    browser.*.namesUsed = 0
    browser.*.unreadable = false
    browser.*.truncated = false
    const directory = std.fs.open(pathPointer(browser), std.fs.DIRECTORY | O_CLOEXEC, 0)
    if !std.fs.isValid(directory) {
        browser.*.unreadable = true
        return false
    }

    var buffer: [16384]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var full = false
    while !full {
        const amount = std.fs.readDirectory(directory, bytes, 16384)
        if amount <= 0 { break }
        const available = @bitCast(usize, amount)
        var offset: usize = 0
        while offset + 19 <= available {
            const recordLength = @intCast(usize, bytes[offset + 16]) | (@intCast(usize, bytes[offset + 17]) << 8)
            if recordLength < 19 || offset + recordLength > available { break }
            const kind = bytes[offset + 18]
            var itemName: [*]const u8 = undefined
            unsafe { itemName = @ptrFromInt([*]const u8, @intFromPtr(bytes) + offset + 19) }
            var length: usize = 0
            while length + 19 < recordLength && itemName[length] != 0 { length += 1 }
            const dots = (length == 1 && itemName[0] == 46) || (length == 2 && itemName[0] == 46 && itemName[1] == 46)
            if !dots && length > 0 {
                if browser.*.count >= MAX_ENTRIES || browser.*.namesUsed + length > MAX_NAMES {
                    browser.*.truncated = true
                    full = true
                } else {
                    const item = entryAt(browser, browser.*.count)
                    item.*.nameOffset = browser.*.namesUsed
                    item.*.nameLength = length
                    item.*.directory = kind == 4
                    item.*.hidden = itemName[0] == 46
                    item.*.size = 0
                    var byte: usize = 0
                    while byte < length {
                        browser.*.names[browser.*.namesUsed + byte] = itemName[byte]
                        byte += 1
                    }
                    browser.*.namesUsed += length
                    var status: std.fs.Stat = undefined
                    if std.fs.statusFrom(directory, itemName, &status, false) == 0 {
                        item.*.directory = status.mode & 61440 == 16384
                        item.*.size = status.size
                    }
                    browser.*.count += 1
                }
            }
            offset += recordLength
            if full { break }
        }
    }
    const closed = std.fs.close(directory)
    sort(browser)
    return true
}

// Starts at a zero-terminated root path and pins navigation to it.
pub fn init(browser: *Browser, root: [*]const u8) -> bool {
    browser.*.pathLength = 0
    while root[browser.*.pathLength] != 0 && browser.*.pathLength < MAX_PATH - 1 {
        browser.*.pathBytes[browser.*.pathLength] = root[browser.*.pathLength]
        browser.*.pathLength += 1
    }
    while browser.*.pathLength > 1 && browser.*.pathBytes[browser.*.pathLength - 1] == 47 { browser.*.pathLength -= 1 }
    if browser.*.pathLength == 0 || root[browser.*.pathLength] != 0 { return false }
    browser.*.rootLength = browser.*.pathLength
    return reload(browser)
}

// Opens a directory entry. Files deliberately remain selected/no-op in this
// first Android slice; opening files needs MIME intents in a later slice.
pub fn open(browser: *Browser, index: usize) -> bool {
    if index >= browser.*.count || !entryAt(browser, index).*.directory { return false }
    const selected = entryAt(browser, index).*
    const needed = browser.*.pathLength + (if browser.*.pathBytes[browser.*.pathLength - 1] == 47 { 0 } else { 1 }) + selected.nameLength
    if needed >= MAX_PATH { return false }
    const previous = browser.*.pathLength
    if browser.*.pathBytes[browser.*.pathLength - 1] != 47 {
        browser.*.pathBytes[browser.*.pathLength] = 47
        browser.*.pathLength += 1
    }
    const selectedName = nameOf(browser, &selected)
    var byte: usize = 0
    while byte < selected.nameLength {
        browser.*.pathBytes[browser.*.pathLength] = selectedName[byte]
        browser.*.pathLength += 1
        byte += 1
    }
    if reload(browser) { return true }
    browser.*.pathLength = previous
    const restored = reload(browser)
    return false
}

pub fn up(browser: *Browser) -> bool {
    if browser.*.pathLength <= browser.*.rootLength { return false }
    const previous = browser.*.pathLength
    var parent = browser.*.pathLength
    while parent > browser.*.rootLength && browser.*.pathBytes[parent - 1] != 47 { parent -= 1 }
    if parent > browser.*.rootLength { parent -= 1 }
    if parent < browser.*.rootLength { parent = browser.*.rootLength }
    browser.*.pathLength = parent
    if reload(browser) { return true }
    browser.*.pathLength = previous
    const restored = reload(browser)
    return false
}
