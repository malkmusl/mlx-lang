// A single-item pointer converts implicitly to `*anyopaque` (C's `void *`),
// as a Vulkan `pNext` chain needs: in assignments to fields and locals, as
// arguments, and to optional and const opaque pointers. The address is
// unchanged. Exits 13.
const Chain = struct {
    next: ?*const anyopaque
    value: u32
}

fn addressOf(pointer: *anyopaque) -> usize { return @intFromPtr(pointer) }

pub fn main() -> u8 {
    var first = Chain.{ .next = null, .value = 7 }
    var second = Chain.{ .next = null, .value = 9 }
    second.next = &first
    var number: u64 = 42
    var opaque: *anyopaque = &number
    if @intFromPtr(opaque) != @intFromPtr(&number) { return 1 }
    if addressOf(&number) != @intFromPtr(&number) { return 2 }
    var back: *const Chain = undefined
    unsafe { back = @ptrCast(*const Chain, second.next.?) }
    if back.*.value != 7 { return 3 }
    const constant: *const anyopaque = &first
    if @intFromPtr(constant) != @intFromPtr(&first) { return 4 }
    return 13
}
