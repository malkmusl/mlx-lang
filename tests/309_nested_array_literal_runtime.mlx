// An array literal whose elements are array literals, as a local and as a
// module-level variable: `[2][3]u16{ [3]u16{ ... }, ... }`. Older compilers
// parsed the element type `[3]u16` with the braces as its own literal, so
// the local crashed and the global was rejected. Exits 13 when every check
// holds, else the number of the first check that failed.
var global: [2][3]u16 = [2][3]u16{ [3]u16{ 1, 2, 3 }, [3]u16{ 4, 5, 6 } }

pub fn main() -> u8 {
    var local: [2][3]u16 = [2][3]u16{ [3]u16{ 1, 2, 3 }, [3]u16{ 4, 5, 6 } }
    if local[0][0] != 1 || local[0][2] != 3 || local[1][0] != 4 || local[1][2] != 6 { return 1 }
    if global[1][1] != 5 || global[0][1] != 2 { return 2 }
    global[1][1] = 50
    if global[1][1] != 50 || global[1][2] != 6 { return 3 }
    const cube = [2][2][2]u8{ [2][2]u8{ [2]u8{ 1, 2 }, [2]u8{ 3, 4 } }, [2][2]u8{ [2]u8{ 5, 6 }, [2]u8{ 7, 8 } } }
    if cube[1][0][1] != 6 || cube[0][1][0] != 3 { return 4 }
    return 13
}
