// The kernel's stage 6 toward a Radeon that takes commands, its one step
// (projects/brix/kernel/gpu_graphics.mlx's G5, through gpu_ring.mlx; built
// for the host), against the user's RX 580 as a table whose graphics ring
// runs its packets as Linux's code counts on (tests/support/mec_card.mlx),
// after stages 0 to 5 passed, with the study's steps
// (gpu-accel-kernel.verified.md 5.3, 5.6 to 5.8, 5.10, 5.11, 8.4 G5)
// written out here a second time, write for write and word for word:
// - G5 on the user's card: the temperature; the host path's
//   HDP_ADDR_CONFIG, then the display's DMIF_ADDR_CALC given the address
//   configuration 0x22011003 (gfx_v8_0_constants_init's order), each only
//   where it differs, the picture watched around those two writes alone;
//   the graphics ring's registers as gfx_v8_0_cp_gfx_resume writes them
//   (CP_RB0_CNTL 0x0041880a and with RB_RPTR_WR_ENA, the pointers'
//   addresses, the base, the doorbell 0x20 and its range), the three words
//   of gfx_v8_0_cp_gfx_start, PFP, ME and CE unhalted; the first
//   submission of 916 words (the preamble, the context control, the seven
//   runs of the clear state with their headers and first registers, the
//   raster configuration, the end, CLEAR_STATE, SET_BASE) padded to 1024;
//   Linux's ring test; CP_INT_CNTL_RING0's TIME_STAMP_INT_ENABLE; Linux's
//   indirect buffer test framed in 38 words (SURFACE_SYNC, COND_EXEC with
//   its count patched to 28, the host path's flush by the pre-fetch parser,
//   the buffer, the invalidate, the end of pipe twice, the first one below
//   the fence without an interrupt); the doorbells in order; fence 1; the
//   interrupt ring's entry of source 181 with ring id 0, its interrupt;
//   the line; the display's two words the only display-side writes;
// - the two words as found (no display-side write), one of them alone;
// - the picture minding the two words (the frames stop at DMIF_ADDR_CALC):
//   failed before the ring is touched, both words back; DMIF_ADDR_CALC
//   written alone and minded; a word that does not hold;
// - the ring's failures, each with every register as before and the
//   graphics processors halted: a ring that does not read, one that takes
//   the clear state and reads no further, no read pointer written back, no
//   end-of-pipe entry, no fence, no interrupt; the
//   refusals (no G4, the mark, a refused ring);
// - G3's second trial having started the ring: not started twice;
// - the way down: the ring said, its interrupt and doorbell off, then the
//   processors halted (stage 5's), the copy engines, the interrupt ring;
// - the stages of a boot: 5 without G5, 6 with G5 and without V1, 7 with
//   both, in order;
// - the watch: at the first mark the graphics ring takes no new work.
// With the argument `words` the first submission's 916 words are printed
// one a line (`words | python3 tools/check_gpu_clear_state.py` holds them
// against Linux's clearstate_vi.h and gfx_v8_0_cp_gfx_start); with any
// other argument the log of every case.
// Exits 13.
const std = @import("std")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const loaded = @import("../projects/brix/kernel/gpu_smc_sdma.mlx")
const compute = @import("../projects/brix/kernel/gpu_compute.mlx")
const graphics = @import("../projects/brix/kernel/gpu_graphics.mlx")
const spaces = @import("../projects/brix/kernel/gpu_space.mlx")
const first = @import("../projects/brix/kernel/gpu_first_space.mlx")
const ring = @import("../projects/brix/kernel/gpu_ring.mlx")
const clear = @import("../projects/brix/kernel/gpu_clear_state.mlx")
const card = @import("./support/engine_card.mlx")
const smc = @import("./support/smc_card.mlx")
const mec = @import("./support/mec_card.mlx")
const crash = @import("std.crash")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn hex(value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(text[0..2 + digits])
}

fn shown() -> void {
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
}

const N = card.NEVER
const GART: usize = 0xFF00000000
const NOP: usize = 0xFFFF1000
const CONFIG: usize = 0x22011003

var e: engines.Engines = undefined
var l: loaded.Loaded = undefined
var c: compute.Compute = undefined
var g: graphics.Graphics = undefined
var s: spaces.Spaces = undefined
var f: first.FirstSpace = undefined
var where: engines.Card = undefined

fn fresh(stage: usize) -> void {
    mec.reset()
    card.picture(0, 1280, 960, 1800, 1000)
    card.registers[loaded.SMC_RESP_0] = 1
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = mec.hands()
    engines.begin(&e, &hands, &where, stage)
    const more = mec.more()
    loaded.begin(&l, &more)
    compute.begin(&c)
    graphics.begin(&g)
    spaces.begin(&s)
    first.begin(&f)
}

// Stages 0 to 5 at a boot that goes to stage 6, as gpu_compute.mlx runs
// them.
fn upToG4() -> bool {
    fresh(6)
    engines.run(&e)
    compute.run(&e, &l, &c)
    return c.g4 == engines.Outcome.passed
}

// A boot of `stage` as gpu.mlx runs it (gpu_first_space.mlx's run).
fn boot(stage: usize) -> void {
    fresh(stage)
    engines.run(&e)
    first.run(&e, &l, &c, &g, &s, &f)
}

fn gart(physical: usize) -> usize { return GART + physical - card.DMA_BASE }

// ---- The writes a step is wanted to make.

const WANT: usize = 256
var wantNumber: [WANT]usize = undefined
var wantValue: [WANT]usize = undefined
var wanted: usize = 0

fn want(number: usize, value: usize) -> void {
    wantNumber[wanted] = number
    wantValue[wanted] = value
    wanted += 1
}

fn writesAre(from: usize, what: []const u8) -> bool {
    const at = card.writesFrom(from, wantNumber[0..wanted], wantValue[0..wanted])
    if at == N { return true }
    say("the writes of ")
    say(what)
    say(" differ from the study's at write ")
    hex(at)
    if at < wanted {
        say(": wanted register ")
        hex(wantNumber[at])
        say(" = ")
        hex(wantValue[at])
    }
    if from + at < card.written && from + at < card.WRITES {
        say(", written register ")
        hex(card.writtenTo[from + at])
        say(" = ")
        hex(card.writtenWith[from + at])
    }
    say("\n")
    return false
}

fn wantCool(index: usize) -> void {
    want(engines.SMC_IND_INDEX_11, engines.ixCG_MULT_THERMAL_STATUS)
    want(engines.SMC_IND_INDEX_11, index)
}

fn wantAlive(was: usize) -> void {
    want(engines.SCRATCH_REG0, engines.SCRATCH_TRIAL)
    want(engines.SCRATCH_REG0, was)
}

fn memoryWord(at: usize) -> usize { return @intCast(usize, card.memoryRead(at)) }

fn memoryIs(at: usize, words: []const usize) -> bool {
    var k: usize = 0
    while k < words.length {
        if memoryWord(at + 4 * k) != words[k] {
            say("the word at ")
            hex(at + 4 * k)
            say(" is ")
            hex(memoryWord(at + 4 * k))
            say(", not ")
            hex(words[k])
            say("\n")
            return false
        }
        k += 1
    }
    return true
}

fn nopsFrom(at: usize, from: usize, to: usize) -> bool {
    var k = from
    while k < to {
        if memoryWord(at + 4 * k) != NOP { return false }
        k += 1
    }
    return true
}

var before: [card.ROOM]usize = undefined

fn keep() -> void {
    var k: usize = 0
    while k < card.ROOM {
        before[k] = card.registers[k]
        k += 1
    }
}

// Every register written from `from` on as it was (but those the card
// moves itself and `but`).
fn asBefore(from: usize, but: []const usize) -> bool {
    var k = from
    while k < card.written && k < card.WRITES {
        const number = card.writtenTo[k]
        var spared = number == engines.SCRATCH_REG0 || number == engines.SMC_IND_INDEX_11 || number == engines.SRBM_GFX_CNTL || number == loaded.GRBM_GFX_INDEX || number == engines.IH_RB_RPTR || number == ring.CP_RB0_WPTR
        for b in but {
            if b == number { spared = true }
        }
        if !spared && card.registers[number] != before[number] {
            say("register ")
            hex(number)
            say(" is ")
            hex(card.registers[number])
            say(", was ")
            hex(before[number])
            say("\n")
            return false
        }
        k += 1
    }
    return true
}

// The display's writes from `from` on (the card's table counts DCE 11.2's
// registers; DMIF_ADDR_CALC is one, HDP_ADDR_CONFIG the host path's).
fn displayFrom(from: usize) -> usize { return card.displayWrites(from) }

// ---- The first submission (gfx_v8_0_cp_gfx_start, the study's 5.7).

// Its 916 words as the study gives them: the preamble's begin, the context
// control, the seven runs (their counts and first registers from the
// study's 5.7: 212 from 0xa000, 274 from 0xa0d6, 6 from 0xa1f5, 157 from
// 0xa200, 2 from 0xa2a0, 1 from 0xa2a3, 233 from 0xa2a5; their values
// clearstate_vi.h's, as gpu_clear_state.mlx holds them and
// tools/check_gpu_registers.py holds that table against the header), the
// raster configuration, the end, CLEAR_STATE, SET_BASE.
const RUNS = [_]usize{ 212, 0xA000, 274, 0xA0D6, 6, 0xA1F5, 157, 0xA200, 2, 0xA2A0, 1, 0xA2A3, 233, 0xA2A5 }

fn firstSubmissionHolds(at: usize) -> bool {
    const head = [_]usize{ 0xC0004A00, 0x20000000, 0xC0012800, 0x80000000, 0x80000000 }
    if !memoryIs(at, head[0..]) { return false }
    var k: usize = 5
    var value: usize = 0
    var run: usize = 0
    while run < 7 {
        const count = RUNS[2 * run]
        const header = [_]usize{ 0xC0006900 | (count << 16), RUNS[2 * run + 1] - 0xA000 }
        if !memoryIs(at + 4 * k, header[0..]) { return false }
        k += 2
        var n: usize = 0
        while n < count {
            if memoryWord(at + 4 * k) != @intCast(usize, clear.VALUES[value]) {
                say("a value of the clear state differs at word ")
                hex(k)
                say("\n")
                return false
            }
            k += 1
            value += 1
            n += 1
        }
        run += 1
    }
    const tail = [_]usize{ 0xC0026900, 0xD4, 0x16000012, 0x2A, 0xC0004A00, 0x30000000, 0xC0001200, 0, 0xC0021100, 3, 0x8000, 0x8000 }
    if !memoryIs(at + 4 * k, tail[0..]) { return false }
    return k + 12 == 916 && value == 885
}

// The words printed one a line, for tools/check_gpu_clear_state.py.
fn printWords() -> void {
    if !upToG4() { return }
    _ = graphics.graphicsRing(&e, &l, &c, &g)
    var k: usize = 0
    while k < 916 {
        hex(memoryWord(c.rings[2] + 4 * k))
        say("\n")
        k += 1
    }
}

// ---- G5.

fn theGraphicsRing() -> void {
    expect(upToG4(), "stages 0 to 5 at a boot of stage 6")
    keep()
    card.interruptsOn = true
    card.waitingMessage = false
    const taken = card.messages
    const from = card.written
    const bells = smc.bells
    const index = card.registers[engines.SMC_IND_INDEX_11]
    const entries = e.entries
    const pointer = e.readPointer
    const eops = mec.eopEntries
    const syncs = mec.syncs
    expect(before[engines.HDP_ADDR_CONFIG] == 0 && before[engines.DMIF_ADDR_CALC] == 0, "the user's card as S0 read it: the two words 0")
    expect(graphics.graphicsRing(&e, &l, &c, &g), "G5 on the user's card")
    shown()
    const r = &c.graphics
    const g0 = gart(c.rings[2])
    const rptr = gart(c.writeBack + 64)
    const wptr = gart(c.writeBack + 64 + 4)
    wanted = 0
    wantCool(index)
    want(engines.HDP_ADDR_CONFIG, CONFIG)
    want(engines.DMIF_ADDR_CALC, CONFIG)
    want(0x21C1, 0)
    want(0x3051, 0)
    want(0x3041, 0x0041880A)
    want(0x3041, 0x8041880A)
    want(0x3045, 0)
    want(0x3043, rptr & 0xFFFFFFFF)
    want(0x3044, (rptr >> 32) & 0xFF)
    want(0x3046, wptr & 0xFFFFFFFF)
    want(0x3047, wptr >> 32)
    want(0x3041, 0x0041880A)
    want(0x3040, (g0 >> 8) & 0xFFFFFFFF)
    want(0x30B1, g0 >> 40)
    want(0x3059, 0x40000080)
    want(0x305A, 0x80)
    want(0x305B, 0x7FFFFC)
    want(0x30AE, 7)
    want(0x3050, 0)
    want(0x304B, 1)
    want(0x21B6, 0)
    want(0xC040, 0xCAFEDEAD)
    want(0x306A, before[0x306A] | 0x4000000)
    want(engines.IH_RB_RPTR, (pointer + 16) & 0xFFFF)
    wantCool(index)
    wantAlive(card.registers[engines.SCRATCH_REG0])
    expect(writesAre(from, "G5"), "G5 write for write: the two words, cp_gfx_resume's registers, cp_gfx_start's three words and the unhalt, the scratch test's word, the end-of-pipe interrupt, the interrupt ring's read pointer")
    expect(firstSubmissionHolds(c.rings[2]) && nopsFrom(c.rings[2], 916, 1024), "the first submission: 916 words word for word (885 values of the clear state in seven runs), then NOPs to 1024")
    const scratchWords = [_]usize{ 0xC0017900, 0x40, 0xDEADBEEF }
    expect(memoryIs(c.rings[2] + 1024 * 4, scratchWords[0..]) && nopsFrom(c.rings[2], 1027, 1280), "the ring test word for word, padded to 1280")
    const slot = gart(c.writeBack + 288)
    const buffer = [_]usize{ 0xC0033700, 0x00100500, slot & 0xFFFFFFFF, slot >> 32, 0xDEADBEEF }
    expect(memoryIs(c.buffers + 256, buffer[0..]), "the indirect buffer's five words (gfx_v8_0_ring_test_ib)")
    const ib = gart(c.buffers + 256)
    const cond = gart(c.writeBack + 64 + 16)
    const back = gart(c.writeBack + 64 + 8)
    const frame = [_]usize{ 0xC0034300, 0x28C40000, 0xFFFFFFFF, 0, 0xA, 0xC0032200, cond & 0xFFFFFFFF, cond >> 32, 0, 28, 0xC0053C00, 0x143, 0x1537, 0x1538, 1, 1, 0x20, 0xC0023F00, ib & 0xFFFFFFFC, (ib >> 32) & 0xFFFF, 5, 0xC0033700, 0x40100000, 0xBCC, 0, 1, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x20000000, 0, 0, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x22000000, 1, 0 }
    expect(memoryIs(c.rings[2] + 1280 * 4, frame[0..]) && nopsFrom(c.rings[2], 1280 + 38, 1536), "the frame of 38 words (the study's 5.10), the conditional count patched to 28, then NOPs to 1536")
    expect(smc.bells == bells + 3 && smc.bellIndex[bells] == 0x20 && smc.bellValue[bells] == 1024 && smc.bellIndex[bells + 1] == 0x20 && smc.bellValue[bells + 1] == 1280 && smc.bellIndex[bells + 2] == 0x20 && smc.bellValue[bells + 2] == 1536, "the doorbell 0x20 with 1024, 1280, 1536")
    expect(memoryWord(c.writeBack + 288) == 0xDEADBEEF && memoryWord(c.writeBack + 64 + 8) == 1 && r.*.done == 1 && memoryWord(c.writeBack + 64 + 16) == 1, "the buffer's word written, fence 1, the conditional word 1")
    expect(e.entries == entries + 1 && mec.eopEntries == eops + 1, "one entry in the interrupt ring (the first end of pipe raises none)")
    const entry = e.ring + ((e.readPointer - 16) & 0xFFFF)
    expect(memoryWord(entry) == 181 && memoryWord(entry + 8) == 0, "the entry: source 181, ring id 0 (micro engine 0: the graphics ring)")
    expect(card.messages == taken + 1, "its interrupt")
    expect(mec.clearStates == 1 && mec.contextValues == 887 && mec.flushBits == 1 && mec.syncs == syncs + 1, "the clear state taken (885 values and the raster configuration's 2), the flush by bit CP0, the memory sync")
    expect(card.registers[0x306A] & 0x4000000 != 0 && card.registers[engines.CP_ME_CNTL] & 0x15000000 == 0 && r.*.up, "the end-of-pipe interrupt on, the processors running, the ring up")
    line("gpu: step G5: the graphics ring: started, its clear state taken (916 words), its scratch test after ")
    line(" us; an indirect buffer of 5 words ran: memory written, fence 1 (the end of pipe twice, the first below it without an interrupt), end-of-pipe entry (source 181, ring 0x0) after ")
    line(" us, interrupts taken: 1; HDP_ADDR_CONFIG 0x0 -> 0x22011003, DMIF_ADDR_CALC 0x0 -> 0x22011003: 2 display-side words written, the picture watched around them; 41 C before, 41 C after; picture ")
    expect(displayFrom(from) == 1 && card.displayWrites(0) == 1, "the display's own register written once in all the stages: DMIF_ADDR_CALC")
}

// The two words as found, then one of them alone.
fn theWordsAsFound() -> void {
    expect(upToG4(), "stages 0 to 5")
    card.registers[engines.HDP_ADDR_CONFIG] = CONFIG
    card.registers[engines.DMIF_ADDR_CALC] = CONFIG
    var from = card.written
    expect(graphics.graphicsRing(&e, &l, &c, &g) && g.displayWrites == 0, "G5 with the two words holding the configuration")
    shown()
    var k = from
    var touched = false
    while k < card.written {
        if card.writtenTo[k] == engines.HDP_ADDR_CONFIG || card.writtenTo[k] == engines.DMIF_ADDR_CALC { touched = true }
        k += 1
    }
    expect(!touched && displayFrom(from) == 0, "neither word written, nothing of the display's")
    line("; HDP_ADDR_CONFIG 0x22011003 as found, DMIF_ADDR_CALC 0x22011003 as found: no display-side word written; ")
    expect(upToG4(), "stages 0 to 5")
    card.registers[engines.HDP_ADDR_CONFIG] = CONFIG
    from = card.written
    expect(graphics.graphicsRing(&e, &l, &c, &g) && g.displayWrites == 1, "G5 with DMIF_ADDR_CALC alone to be written")
    shown()
    expect(card.writtenTo[from + 2] == engines.DMIF_ADDR_CALC && card.writtenWith[from + 2] == CONFIG && card.writtenTo[from + 3] == 0x21C1, "DMIF_ADDR_CALC alone, then the ring's registers")
    line("; HDP_ADDR_CONFIG 0x22011003 as found, DMIF_ADDR_CALC 0x0 -> 0x22011003: 1 display-side word written, the picture watched around it; ")
    // The display's word as found (the study's expectation for the user's
    // card): the host path's alone, nothing of the display's.
    expect(upToG4(), "stages 0 to 5")
    card.registers[engines.DMIF_ADDR_CALC] = CONFIG
    from = card.written
    expect(graphics.graphicsRing(&e, &l, &c, &g) && g.displayWrites == 1, "G5 with HDP_ADDR_CONFIG alone to be written")
    shown()
    expect(card.writtenTo[from + 2] == engines.HDP_ADDR_CONFIG && card.writtenTo[from + 3] == 0x21C1 && displayFrom(from) == 0, "HDP_ADDR_CONFIG alone, nothing of the display's")
    line("; HDP_ADDR_CONFIG 0x0 -> 0x22011003, DMIF_ADDR_CALC 0x22011003 as found: 1 display-side word written, the picture watched around it; ")
}

// The picture minding the two words, a word that does not hold: failed
// before the ring is touched, every register as before.
fn theTwoWordsWatched() -> void {
    expect(upToG4(), "stages 0 to 5")
    card.stopFramesAt = engines.DMIF_ADDR_CALC
    keep()
    var from = card.written
    expect(!graphics.graphicsRing(&e, &l, &c, &g) && g.g5 == engines.Outcome.failed, "G5 fails when the frames stop at DMIF_ADDR_CALC")
    shown()
    expect(card.registers[engines.HDP_ADDR_CONFIG] == 0 && card.registers[engines.DMIF_ADDR_CALC] == 0 && asBefore(from, [_]usize{ engines.CP_ME_CNTL }[0..]), "both words back, every register as before")
    var k = from
    var ringTouched = false
    while k < card.written {
        if card.writtenTo[k] == 0x3041 || card.writtenTo[k] == 0x3040 { ringTouched = true }
        k += 1
    }
    expect(!ringTouched && !c.graphics.up && mec.clearStates == 0, "the ring not touched")
    line("gpu: step G5 failed: the picture minded the display's two words: ")
    line("; the graphics processors halted (ME 0x15000000), the step's words as before it (2 registers, the display's 2 among them)")
    expect(displayFrom(from) == 2, "the display's register written twice: given, and back")
    // DMIF_ADDR_CALC written alone (the host path's word holds the
    // configuration) and the picture minding it: the display's word back,
    // the host path's untouched, the ring not touched.
    expect(upToG4(), "stages 0 to 5")
    card.registers[engines.HDP_ADDR_CONFIG] = CONFIG
    card.stopFramesAt = engines.DMIF_ADDR_CALC
    keep()
    from = card.written
    expect(!graphics.graphicsRing(&e, &l, &c, &g) && g.g5 == engines.Outcome.failed && g.displayWrites == 1, "G5 fails when the frames stop at DMIF_ADDR_CALC written alone")
    shown()
    expect(card.registers[engines.DMIF_ADDR_CALC] == 0 && card.registers[engines.HDP_ADDR_CONFIG] == CONFIG && asBefore(from, [_]usize{ engines.CP_ME_CNTL }[0..]) && !c.graphics.up && mec.clearStates == 0, "DMIF_ADDR_CALC back, HDP_ADDR_CONFIG untouched, the ring not started")
    line("gpu: step G5 failed: the picture minded the display's two words: ")
    line("(1 registers, the display's 1 among them)")
    expect(displayFrom(from) == 2, "the display's register written twice: given, and back")
    // A word that does not hold.
    expect(upToG4(), "stages 0 to 5")
    card.stuck = engines.HDP_ADDR_CONFIG
    keep()
    from = card.written
    expect(!graphics.graphicsRing(&e, &l, &c, &g) && g.g5 == engines.Outcome.failed, "G5 fails when HDP_ADDR_CONFIG does not take the word")
    shown()
    line("gpu: step G5 failed: the display's two words do not hold the address configuration written, 0x22011003")
    expect(card.registers[engines.DMIF_ADDR_CALC] == 0 && !c.graphics.up, "DMIF_ADDR_CALC back, the ring not started")
}

fn ringFailsWith(text: []const u8, what: []const u8) -> void {
    keep()
    const from = card.written
    const passed = graphics.graphicsRing(&e, &l, &c, &g)
    shown()
    expect(!passed && g.g5 == engines.Outcome.failed, what)
    expect(asBefore(from, [_]usize{ engines.CP_ME_CNTL }[0..]) && card.registers[engines.CP_ME_CNTL] & 0x15000000 == 0x15000000 && card.registers[0x306A] == before[0x306A], "every register G5 wrote as before, the graphics processors halted, the end-of-pipe interrupt as before")
    expect(card.registers[engines.HDP_ADDR_CONFIG] == 0 && card.registers[engines.DMIF_ADDR_CALC] == 0 && !c.graphics.up, "the two words back, the ring down")
    expect(c.compute.up && card.registers[engines.CP_MEC_CNTL] == 0, "compute ring 0 goes on")
    line(text)
    line("; the graphics processors halted (ME 0x15000000), the step's words as before it (")
    line(" registers, the display's 2 among them)")
}

fn theRingFailures() -> void {
    expect(upToG4(), "stages 0 to 5")
    mec.graphicsDeaf = true
    ringFailsWith("gpu: step G5 failed: the graphics ring did not write the scratch register within 100 ms (read pointer 0x0 (the card's own 0x0), write pointer 0x500", "a ring that does not read")
    expect(upToG4(), "stages 0 to 5")
    mec.noReadBack = true
    ringFailsWith("gpu: step G5 failed: the graphics ring's read pointer is not its write pointer (read pointer 0x0 (the card's own 0x500), write pointer 0x500", "no read pointer written back")
    expect(upToG4(), "stages 0 to 5")
    mec.noEntry = true
    ringFailsWith("gpu: step G5 failed: the graphics ring's indirect buffer test did not end: the fence came, its end-of-pipe entry did not, within 1000 ms; read pointer 0x600", "no end-of-pipe entry")
    expect(upToG4(), "stages 0 to 5")
    mec.noFenceWrite = true
    ringFailsWith("gpu: step G5 failed: the graphics ring's indirect buffer test did not end: the fence did not come within 1000 ms; read pointer 0x600", "no fence")
    expect(upToG4(), "stages 0 to 5")
    card.interruptsOn = true
    card.waitingMessage = false
    card.noMessage = true
    ringFailsWith("gpu: step G5 failed: the end-of-pipe entry came and its interrupt did not", "no interrupt")
    // A ring that takes the clear state (the first 1024 words) and reads no
    // further: the scratch test does not come.
    expect(upToG4(), "stages 0 to 5")
    mec.graphicsStallAt = 1024
    ringFailsWith("gpu: step G5 failed: the graphics ring did not write the scratch register within 100 ms (read pointer 0x400 (the card's own 0x400), write pointer 0x500", "a ring that takes the clear state and not the test")
    expect(mec.clearStates == 1 && mec.contextValues == 887, "the clear state was taken")
}

fn theRefusals() -> void {
    // Without G4.
    fresh(6)
    engines.run(&e)
    var at = card.written
    expect(!graphics.graphicsRing(&e, &l, &c, &g) && g.g5 == engines.Outcome.refused && card.written == at, "no G4: refused, nothing written")
    line("gpu: step G5 refused: the compute ring's end of pipe and its interrupt are not proved (step G4)\n")
    // At the mark.
    expect(upToG4(), "stages 0 to 5")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 86 << 9)
    at = card.written
    expect(!graphics.graphicsRing(&e, &l, &c, &g) && g.g5 == engines.Outcome.refused && card.displayWrites(at) == 0, "86 C: refused, nothing of the display's")
    line("gpu: step G5 refused: the card is at 86 C (no step begins at 85 C or more)\n")
    // A ring up (G3's second trial) that takes no new work.
    fresh(6)
    mec.mapNeedsGraphics = true
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(c.second && c.graphics.up, "G3's second trial started the graphics ring")
    c.graphics.refused = true
    at = card.written
    expect(!graphics.graphicsRing(&e, &l, &c, &g) && g.g5 == engines.Outcome.refused && card.written == at, "a refused ring: refused, nothing written")
    line("gpu: step G5 refused: the graphics ring takes no new work now (the temperature's mark, or it did not come to a fence)\n")
}

// G3's second trial started the ring: G5 does not start it again.
fn theRingStartedBefore() -> void {
    fresh(6)
    mec.mapNeedsGraphics = true
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(c.second && c.graphics.up && mec.clearStates == 1, "the graphics ring and its clear state at G3's second trial")
    const from = card.written
    expect(graphics.graphicsRing(&e, &l, &c, &g) && !g.started, "G5 on the ring as G3 left it")
    shown()
    var k = from
    var again = false
    while k < card.written {
        if card.writtenTo[k] == 0x3041 || card.writtenTo[k] == 0x3040 { again = true }
        k += 1
    }
    expect(!again && mec.clearStates == 1, "the ring's registers not written again, no second clear state")
    line("gpu: step G5: the graphics ring: started with its clear state by G3's second trial, its scratch test after ")
}

// The way down after a boot of stage 6.
fn theWayDown() -> void {
    boot(6)
    shown()
    expect(c.g4 == engines.Outcome.passed && g.g5 == engines.Outcome.passed && f.v1 == engines.Outcome.not_tried, "a boot of stage 6: G5, no V1")
    const from = card.written
    first.stop(&e, &l, &c, &g, &s, &f)
    shown()
    line("gpu: the graphics ring on the way down: read pointer 0x600 (the card's own 0x600), write pointer 0x600, fence 0x1 of 0x1")
    line("; its end-of-pipe interrupt and its doorbell off\n")
    expect(card.registers[0x306A] & 0x4000000 == 0 && card.registers[0x3059] & 0x40000000 == 0, "its end-of-pipe interrupt and its doorbell off")
    expect(card.registers[engines.CP_ME_CNTL] & 0x15000000 == 0x15000000 && card.registers[engines.CP_MEC_CNTL] == 0x50000000 && card.registers[engines.RLC_CNTL] & 1 == 0, "then the processors halted, the RLC off (stage 5's way down)")
    expect(card.after("the graphics ring on the way down", 0) < card.after("gpu: stopped for the way down:", 0) && card.after("gpu: stopped for the way down:", 0) < card.after("copy engines halted", 0), "the graphics ring first, then stage 5's, then the copy engines")
    expect(card.displayWrites(from) == 0, "nothing of the display's on the way down")
    noLine("gpu: the address spaces on the way down")
}

// The stages of a boot: 5 without G5, 6 with G5, 7 with V1 after it.
fn theStages() -> void {
    boot(5)
    expect(c.g4 == engines.Outcome.passed && g.g5 == engines.Outcome.not_tried && card.displayWrites(0) == 0, "stage 5: no G5, nothing of the display's")
    noLine("gpu: step G5")
    boot(7)
    shown()
    expect(g.g5 == engines.Outcome.passed && f.v1 == engines.Outcome.passed, "stage 7: G5, then V1")
    expect(card.after("gpu: step G4:", 0) < card.after("gpu: step G5:", 0) && card.after("gpu: step G5:", 0) < card.after("gpu: step V1:", 0), "G4, G5, V1 in order")
    // G5 failed: no V1.
    fresh(7)
    mec.graphicsDeaf = true
    engines.run(&e)
    first.run(&e, &l, &c, &g, &s, &f)
    expect(g.g5 == engines.Outcome.failed && f.v1 == engines.Outcome.not_tried, "G5 failed: V1 not tried")
}

// The watch: at the first mark the graphics ring takes no new work.
fn theWatch() -> void {
    boot(6)
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 86 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    line("gpu: the card is at 86 C, the first mark (85 C): no ring takes new work\n")
    expect(c.graphics.refused && ring.submit(&e, &l, &c.graphics, gart(c.buffers + 256), 5, 0) == ring.NONE, "86 C: the graphics ring takes nothing")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 96 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    expect(card.registers[engines.CP_ME_CNTL] & 0x15000000 == 0x15000000, "96 C: the graphics processors halted")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    _ = crash.install()
    if !card.makeRom(true) {
        say("the ROM could not be made\n")
        return 5
    }
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !card.load(name) {
            say("the firmware files could not be read (run from the repository's top)\n")
            return 6
        }
    }
    if count == 2 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("words")) {
        printWords()
        return 13
    }
    show = count == 2
    theGraphicsRing()
    theWordsAsFound()
    theTwoWordsWatched()
    theRingFailures()
    theRefusals()
    theRingStartedBefore()
    theWayDown()
    theStages()
    theWatch()
    if failed != 0 { return failed }
    return 13
}
