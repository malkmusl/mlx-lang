// The kernel's looking for the monitor on a Radeon's connectors
// (projects/brix/kernel/gpu_plug.mlx, built for the host), against a card
// that is a table and ROMs made here (tests/support/plug_card.mlx): the
// hot plug lines read, the detection, and the lines looked at again and
// again against a clock that is the test's.
//
// At boot: a board of four connectors (an HDMI on DIG 4 and hot plug
// line 2, a DisplayPort on DIG 0 and line 1, a DVI-D on DIG 3 and line 6,
// a second HDMI on DIG 1 and line 4), each connector's line said; the
// usual case (the firmware's picture goes out by the HDMI connector and
// its line is high); the firmware's output without a monitor; a monitor
// on an output the firmware did not start; two plugged; an adapter (a
// DisplayPort connector that sends TMDS) and a DisplayPort connector that
// sends DisplayPort; a firmware that started nothing here; two outputs;
// a ROM without connector records and no ROM at all. Each of the six
// lines read at its own block and with its own bit of the pins' word; a
// line whose block is off, whose pin is held as a plain pin, whose block
// does not answer, that is changing and rests, that never rests; a
// connector without a hot plug record and one whose pin is placed on no
// line. When the plan may be carried out (`emptyFor`): not on an output
// whose line says for certain that nothing is there, on every other.
// What serves a connector, at other blocks and controllers. And the plan
// itself (gpu_mode.mlx, on the card of tests/474: the user's machine as
// far as it is known): it is complete for an output whose line is low,
// and would have a mode set there; with the driver's rule nothing is
// written then, and the mode is set when the line is high or cannot be
// judged.
// Over time: an unplug said once, at the second look that agrees; a plug
// on an HDMI connector after the line was high for half a second, on a
// DisplayPort after two looks; a pulse shorter than two looks, a pulse a
// single look sees, a line that bounces, a plug shorter than the filter:
// nothing said; a line whose block goes off and comes back; the record
// after each. Looking writes nothing: the count of writes stays zero
// through all of it, and a tick without a look reads nothing.
// And: a line whose two sense bits differ for good (said once as one
// that cannot be read any more, and as what it is when they agree
// again); every kind of connector the ROM can name (which are asked over
// DDC, which of Linux's times a plug takes); what serves a connector
// read anew at a change; pins and DDC entries the ROM's tables do not
// place; an hour of ticks on a still card (36000 looks, no write, no
// word); all four lines toggled at random (every change given once, from
// the level recorded to the level the line has, none lost); pulses of
// every length around Linux's times at every phase against the looks.
// With an argument the log of every case is printed; with two, what a
// look and a tick cost here.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const ddc = @import("../projects/brix/kernel/gpu_ddc.mlx")
const plug = @import("../projects/brix/kernel/gpu_plug.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/plug_card.mlx")
const tmds = @import("./support/tmds_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn once(text: []const u8) -> void { expect(card.count(text) == 1, text) }

var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var watch: plug.Watch = undefined
var verdict: plug.Verdict = undefined

// The board of four: the connectors' objects, their encoders (UNIPHY E,
// A, D and B: DIG 4, 0, 3 and 1), the pins the ROM names their hot plug
// lines by and the bits those pins have in DC_GPIO_HPD_A (lines 2, 1, 6
// and 4), and the entries of their DDC lines in the ROM's table of
// lines, whose four entries are, in the table's order, the card's DDC3,
// DDC1, DDC2 and DDC6 (their clock pins' registers): so the HDMI
// connector's entry 2 is the card's line DDC2, the DisplayPort's entry 0
// DDC3, the DVI's entry 1 DDC1 and the second HDMI's entry 3 DDC6.
const CONNECTORS = [_]usize{ 0x310C, 0x3113, 0x3104, 0x320C }
const ENCODERS = [_]usize{ 0x2121, 0x211E, 0x2220, 0x221E }
const PINS = [_]usize{ 4, 1, 6, 3 }
const SHIFTS = [_]usize{ 8, 0, 28, 24 }
const ENTRIES = [_]usize{ 2, 0, 1, 3 }
const CLOCKS = [_]usize{ 0x4871, 0x4869, 0x486D, 0x487D }

fn open() -> void {
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readBoard(&machine, &board)
}

// The card anew with the board of four, every line's block on and its
// line low.
fn four() -> void {
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..], ENCODERS[0..], PINS[0..], ENTRIES[0..], PINS[0..], SHIFTS[0..], CLOCKS[0..])
    open()
    card.line(2, false)
    card.line(1, false)
    card.line(6, false)
    card.line(4, false)
}

// The card looked at as at a boot, and all of it said.
fn boot() -> void {
    const c = card.card()
    card.forget()
    plug.survey(&c, &machine, &board, &watch.ports)
    plug.sayPorts(&c, &watch.ports)
    plug.sayWords(&c, &watch.ports)
    plug.detect(&watch.ports, &verdict)
    plug.sayVerdict(&c, &watch.ports, &verdict)
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
    expect(card.written == 0, "looking at the connectors writes nothing")
}

fn atBoot() -> void {
    // The usual case.
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_DVI)
    boot()
    line("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): a monitor is plugged in; the firmware's picture goes out here\n")
    line("gpu: connector 1 (DisplayPort, DIG 0, hot plug line 1): nothing is plugged in\n")
    line("gpu: connector 2 (DVI-D (dual link), DIG 3, hot plug line 6): nothing is plugged in\n")
    line("gpu: connector 3 (HDMI, DIG 1, hot plug line 4): nothing is plugged in\n")
    line("gpu: hot plug line 2: status 0x12, control 0x10001000, filter 0xa00032 (its delay for a plug 50, for an unplug 10); its pin is the block's\n")
    once("gpu: the monitor is on the HDMI connector 0 (DIG 4, hot plug line 2): the TMDS path\n")
    noLine("does not bring it up yet")
    expect(verdict.what == plug.Case.there && verdict.output == 0 && verdict.outputs == 1 && verdict.plugged == 1 && verdict.other == plug.NONE && verdict.sends == plug.Sends.tmds, "the usual case's verdict")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "the plan for the firmware's output goes on when its line is high")
    expect(plug.servedBy(&watch.ports, 0) == 0 && plug.servedBy(&watch.ports, 1) == plug.NONE, "controller 0's picture goes out by connector 0, controller 1's by none")
    const first = &watch.ports.ports[0]
    expect(first.*.level == plug.Level.high && first.*.atBoot && first.*.firmware && first.*.controller == 0 && first.*.frontEnd == 4 && first.*.mode == scanout.MODE_DVI && first.*.line == 2, "the HDMI connector's record")
    expect(first.*.wire.line == 1 && watch.ports.ports[1].wire.line == 2 && watch.ports.ports[2].wire.line == 0 && watch.ports.ports[3].wire.line == 5, "each connector's DDC line from the ROM's table")
    expect(first.asks() && !watch.ports.ports[1].asks() && watch.ports.ports[2].asks() && watch.ports.ports[3].asks(), "the HDMI and DVI connectors' monitors are asked over DDC, the DisplayPort's is not")
    expect(watch.ports.found && watch.ports.count == 4, "four connectors in the record")
    // What serves the connectors read anew, after a mode set changed
    // what the output sends and another output was brought up.
    const again = card.card()
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.output(1, 3, 1, scanout.MODE_DVI)
    plug.serveAll(&again, &watch.ports)
    expect(first.*.mode == scanout.MODE_HDMI && first.*.firmware && watch.ports.ports[3].firmware && watch.ports.ports[3].controller == 1 && watch.ports.ports[3].frontEnd == 3 && !watch.ports.ports[1].firmware && card.written == 0, "what serves each connector read anew")

    // The firmware's output without a monitor.
    four()
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    line("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): nothing is plugged in, yet the firmware's picture goes out here\n")
    once("gpu: nothing is plugged into any connector of the card; the firmware's picture goes out by connector 0 (HDMI) all the same\n")
    expect(verdict.what == plug.Case.nothing && verdict.output == 0 && verdict.plugged == 0, "nothing plugged in anywhere")
    expect(plug.emptyFor(&watch.ports, 0) == 0, "no mode is set on an output whose line says nothing is plugged in")
    expect(!plug.askedAtBoot(&watch.ports.ports[0]), "nobody is asked on an output whose line says nothing is plugged in")
    expect(plug.emptyFor(&watch.ports, 1) == plug.NONE, "another controller's plan is not stopped by it")

    // A monitor on an output the firmware did not start.
    four()
    card.line(4, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    line("gpu: connector 3 (HDMI, DIG 1, hot plug line 4): something is plugged in; the firmware did not start this output\n")
    once("gpu: nothing is plugged into the HDMI connector 0 (DIG 4, hot plug line 2), where the firmware's picture goes out\n")
    once("gpu: something is plugged into connector 3 (HDMI), which the firmware did not start: this driver does not bring it up yet\n")
    noLine("the monitor is on")
    expect(verdict.what == plug.Case.elsewhere && verdict.output == 0 && verdict.other == 3 && verdict.plugged == 1, "the monitor is elsewhere")
    expect(plug.emptyFor(&watch.ports, 0) == 0, "no mode is set on the empty output while the monitor is elsewhere")

    // Two plugged.
    four()
    card.line(2, true)
    card.line(1, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    once("gpu: the monitor is on the HDMI connector 0 (DIG 4, hot plug line 2): the TMDS path\n")
    once("gpu: something is plugged into connector 1 (DisplayPort) too, which the firmware did not start: this driver does not bring it up yet\n")
    expect(verdict.what == plug.Case.there_and_more && verdict.plugged == 2 && verdict.other == 1, "two plugged")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "the plan goes on with two plugged")

    // An adapter: the DisplayPort connector's back end sends TMDS.
    four()
    card.line(1, true)
    card.output(2, 0, 0, scanout.MODE_HDMI)
    boot()
    line("gpu: connector 1 (DisplayPort, DIG 0, hot plug line 1): a monitor is plugged in; the firmware's picture goes out here\n")
    once("gpu: the monitor is on the DisplayPort connector 1 (DIG 0, hot plug line 1), which sends TMDS (an adapter is behind it): the TMDS path\n")
    expect(verdict.sends == plug.Sends.tmds && watch.ports.ports[1].asks(), "a DisplayPort connector that sends TMDS is on the TMDS path, and its monitor is asked over DDC")
    expect(watch.ports.ports[1].controller == 2 && watch.ports.ports[1].frontEnd == 0, "which controller and front end serve it")
    expect(plug.askedAtBoot(&watch.ports.ports[1]) && !plug.askedAtBoot(&watch.ports.ports[0]) && !plug.askedAtBoot(&watch.ports.ports[3]), "who is asked at boot: the adapter's monitor, no connector with a low line")
    // The same connector sending DisplayPort.
    four()
    card.line(1, true)
    card.output(2, 0, 0, scanout.MODE_DISPLAYPORT)
    boot()
    once("gpu: the monitor is on the DisplayPort connector 1 (DIG 0, hot plug line 1): the DisplayPort path\n")
    expect(verdict.sends == plug.Sends.displayport && !watch.ports.ports[1].asks() && !plug.askedAtBoot(&watch.ports.ports[1]), "a DisplayPort connector that sends DisplayPort: its monitor is not asked over DDC")
    // A back end that sends something else.
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_LVDS)
    boot()
    once("gpu: the monitor is on the HDMI connector 0 (DIG 4, hot plug line 2): a signal this driver has no path for\n")

    // The firmware started nothing here.
    four()
    card.line(4, true)
    boot()
    once("gpu: something is plugged into connector 3 (HDMI), which the firmware did not start: this driver does not bring it up yet\n")
    once("gpu: the firmware's picture goes out by none of the ROM's connectors: there is no output of this card to set a mode on\n")
    expect(verdict.what == plug.Case.not_started && verdict.output == plug.NONE && verdict.other == 3, "nothing started, something plugged in")
    expect(plug.askedAtBoot(&watch.ports.ports[3]) && !plug.askedAtBoot(&watch.ports.ports[0]), "the plugged HDMI connector's monitor is asked at boot")
    four()
    boot()
    once("gpu: nothing is plugged into any connector of the card, and the firmware's picture goes out by none of them\n")
    expect(verdict.what == plug.Case.nothing && verdict.output == plug.NONE, "nothing started, nothing plugged in")
    // A back end that is on while its controller is not, and one whose
    // enable bit is off: no picture goes out there.
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.store(scanout.OFFSETS[0] + scanout.CRTC_CONTROL, 0)
    boot()
    expect(!watch.ports.ports[0].firmware && verdict.what == plug.Case.not_started, "a back end whose controller does not run sends no picture")
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.store(scanout.DIG[4] + scanout.DIG_BE_EN_CNTL, 0)
    boot()
    expect(!watch.ports.ports[0].firmware, "a back end that is off sends no picture")
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.store(scanout.DIG[4] + scanout.DIG_BE_CNTL, 0xFFFFFFFF)
    boot()
    expect(!watch.ports.ports[0].firmware, "a back end that does not answer sends no picture")

    // Two outputs.
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.output(3, 2, 1, scanout.MODE_DVI)
    boot()
    once("gpu: the firmware's picture goes out by 2 connectors: connector 0 (HDMI), a monitor is plugged in; connector 3 (HDMI), nothing is plugged in; nobody chooses between them here\n")
    expect(verdict.what == plug.Case.several_outputs && verdict.outputs == 2, "two outputs")
    expect(watch.ports.ports[3].controller == 3 && watch.ports.ports[3].frontEnd == 2 && watch.ports.ports[3].mode == scanout.MODE_DVI, "the second output's controller, front end and mode")
    expect(plug.emptyFor(&watch.ports, 3) == 3 && plug.emptyFor(&watch.ports, 0) == plug.NONE, "each output's line counts for its own controller")
    // One controller sent out by two back ends: a monitor on either is
    // enough.
    four()
    card.line(4, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.output(0, 4, 1, scanout.MODE_HDMI)
    boot()
    expect(watch.ports.ports[0].firmware && watch.ports.ports[3].firmware && plug.emptyFor(&watch.ports, 0) == plug.NONE, "a controller sent out by two connectors is not empty while one of them has a monitor")

    // No records: a ROM whose object table names no connector, one
    // without the table, and no ROM.
    const c = card.card()
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..0], ENCODERS[0..0], PINS[0..0], ENTRIES[0..0], PINS[0..0], SHIFTS[0..0], CLOCKS[0..0])
    open()
    boot()
    once("gpu: the card's ROM names no connectors (or was not read): where the monitor is cannot be looked for\n")
    expect(verdict.what == plug.Case.no_records && !watch.ports.found && watch.ports.count == 0, "a ROM without connectors")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "without records the plan goes on as before")
    card.forget()
    plug.survey(&c, null, null, &watch.ports)
    plug.detect(&watch.ports, &verdict)
    plug.sayVerdict(&c, &watch.ports, &verdict)
    once("gpu: the card's ROM names no connectors (or was not read): where the monitor is cannot be looked for\n")
    expect(card.reads == 0 && card.written == 0, "without a ROM nothing of the card is read")
    board.found = false
    plug.survey(&c, &machine, &board, &watch.ports)
    expect(!watch.ports.found, "an object table that was not read gives no record")
}

// Each of the six lines at its own block and with its own bit of the
// pins' word (the numbers are dce_11_2_d.h's and dce_11_2_sh_mask.h's,
// written out here).
const STATUS = [_]usize{ 0x1898, 0x18A0, 0x18A8, 0x18B0, 0x18B8, 0x18C0 }
const CONTROL = [_]usize{ 0x189A, 0x18A2, 0x18AA, 0x18B2, 0x18BA, 0x18C2 }
const PIN_MASKS = [_]usize{ 0x1, 0x100, 0x10000, 0x100000, 0x1000000, 0x10000000 }
const A_SHIFTS = [_]usize{ 0, 8, 16, 24, 26, 28 }

fn sixLines() -> void {
    var n: usize = 1
    while n <= 6 {
        // One HDMI connector whose pin sits on line n.
        const pin = [_]usize{9}
        const shift = [_]usize{A_SHIFTS[n - 1]}
        card.reset()
        card.makeRom(&builder, CONNECTORS[0..1], ENCODERS[0..1], pin[0..], ENTRIES[1..2], pin[0..], shift[0..], CLOCKS[0..])
        open()
        expect(board.connectors[0].hotPlugLine == n, "the ROM's pin placed on the line")
        // Every block on and low but this line's, which is high.
        var k: usize = 0
        while k < 6 {
            card.store(CONTROL[k], 0x10000000)
            card.store(STATUS[k], if k + 1 == n { 0x12 } else { 0 })
            k += 1
        }
        boot()
        expect(watch.ports.ports[0].level == plug.Level.high && watch.ports.ports[0].line == n, "the line read at its own block")
        // Every other line high, this one low.
        k = 0
        while k < 6 {
            card.store(STATUS[k], if k + 1 == n { 0 } else { 0x12 })
            k += 1
        }
        boot()
        expect(watch.ports.ports[0].level == plug.Level.low, "no other line's block is taken for it")
        // Its own block off, the others on.
        card.store(STATUS[n - 1], 0x12)
        card.store(CONTROL[n - 1], 0x0FFFFFFF)
        boot()
        expect(watch.ports.ports[0].level == plug.Level.not_known && watch.ports.ports[0].why == plug.Why.block_off, "its own block's enable bit counts")
        card.store(CONTROL[n - 1], 0x10000000)
        // Every pin but its own held as a plain pin; then its own.
        card.store(0x488C, 0x11110101 & ~PIN_MASKS[n - 1])
        boot()
        expect(watch.ports.ports[0].level == plug.Level.high, "other lines' pins held as plain pins do not count")
        card.store(0x488C, PIN_MASKS[n - 1])
        boot()
        expect(watch.ports.ports[0].level == plug.Level.not_known && watch.ports.ports[0].why == plug.Why.pin_masked, "its own pin's bit in the pins' word counts")
        n += 1
    }
}

fn lineStates() -> void {
    // A line whose block is off, with the firmware's picture on it: the
    // plan goes on.
    four()
    card.line(2, true)
    card.store(0x18A2, 0x00001000)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    line("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): whether something is plugged in is not known: the line's block is off, and Linux's display core counts on the firmware having left it on; the firmware's picture goes out here\n")
    once("gpu: the firmware's picture goes out by the HDMI connector 0 (DIG 4, hot plug line 2), whose hot plug line does not say whether a monitor is there: the TMDS path, as the firmware left it\n")
    expect(verdict.what == plug.Case.unjudged, "a line that cannot be judged")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "the plan goes on when the line cannot be judged")
    expect(plug.askedAtBoot(&watch.ports.ports[0]), "the firmware's output is asked over DDC when its line cannot be judged")
    // The same with the line's bits low: still not judged.
    four()
    card.store(0x18A2, 0)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    expect(watch.ports.ports[0].level == plug.Level.not_known && plug.emptyFor(&watch.ports, 0) == plug.NONE, "a low line whose block is off stops nothing")
    // The pin held as a plain pin.
    four()
    card.line(2, true)
    card.store(0x488C, 0x100)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    line("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): whether something is plugged in is not known: the line's pin is held as a plain pin, and Linux's display core gives it to the hot plug block before it looks; the firmware's picture goes out here\n")
    line("gpu: hot plug line 2: status 0x12, control 0x10001000, filter 0xa00032 (its delay for a plug 50, for an unplug 10); its pin is held as a plain pin\n")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "the plan goes on when the pin is not the block's")
    // A block that does not answer.
    four()
    card.store(0x18A0, 0xFFFFFFFF)
    card.store(0x18A2, 0xFFFFFFFF)
    boot()
    line("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): whether something is plugged in is not known: the line's block does not answer\n")
    // A line that is changing and rests: the delayed bit follows 300 ms
    // later (the clock goes on 10 ms a look).
    four()
    card.sense(4, true, false)
    card.stride = 10000000
    card.later(card.clock + 300000000, 0x18B0, 0x12)
    boot()
    line("gpu: connector 3 (HDMI, DIG 1, hot plug line 4): something is plugged in; the firmware did not start this output\n")
    // One that never rests: left as changing after 600 ms, and nothing
    // is concluded from it.
    four()
    card.sense(2, false, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.stride = 10000000
    const before = card.clock
    boot()
    line("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): the line is changing: its two sense bits differ; the firmware's picture goes out here\n")
    expect(watch.ports.ports[0].level == plug.Level.changing && plug.emptyFor(&watch.ports, 0) == plug.NONE && verdict.what == plug.Case.unjudged, "a line that never rests is not judged")
    expect(card.clock - before >= plug.BOOT_SETTLE && card.clock - before < plug.BOOT_SETTLE + 400000000, "a changing line is looked at for the settling time and no longer")
    // And with a clock that stands still: a count of looks ends it.
    four()
    card.sense(2, true, false)
    boot()
    expect(watch.ports.ports[0].level == plug.Level.changing && card.reads < 3 * plug.BOOT_LOOKS + 100, "a changing line's looks are counted where the clock stands still")

    // A connector without a hot plug record, and one whose pin the ROM's
    // table of pins does not place.
    const pins = [_]usize{ 0xFF, 7, 6, 3 }
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..], ENCODERS[0..], pins[0..], ENTRIES[0..], PINS[0..], SHIFTS[0..], CLOCKS[0..])
    open()
    card.line(6, true)
    card.line(4, false)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    line("gpu: connector 0 (HDMI, DIG 4, no hot plug line): cannot be looked at: the ROM names no hot plug pin for it; the firmware's picture goes out here\n")
    line("gpu: connector 1 (DisplayPort, DIG 0, no hot plug line): cannot be looked at: its hot plug pin is none of the card's six lines\n")
    line("gpu: connector 2 (DVI-D (dual link), DIG 3, hot plug line 6): something is plugged in; the firmware did not start this output\n")
    once("gpu: the firmware's picture goes out by the HDMI connector 0 (DIG 4, no hot plug line), which has no hot plug line to say whether a monitor is there: the TMDS path, as the firmware left it\n")
    once("gpu: something is plugged into connector 2 (DVI-D (dual link)) too, which the firmware did not start: this driver does not bring it up yet\n")
    expect(watch.ports.ports[0].level == plug.Level.no_line && watch.ports.ports[0].why == plug.Why.no_record && watch.ports.ports[1].why == plug.Why.not_placed, "why a connector has no line")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "the plan goes on for an output without a hot plug line")
    // Nothing plugged in where a line can be read.
    card.line(6, false)
    card.store(scanout.OFFSETS[0] + scanout.CRTC_CONTROL, 0)
    boot()
    once("gpu: nothing is plugged into any connector whose hot plug line can be read, and the firmware's picture goes out by none of them\n")
}

// A tick every 10 ms from where the clock stands until `until` (the
// clock's nanoseconds), with no hands: nobody is asked.
fn ticks(until: usize) -> void {
    const c = card.card()
    while card.clock + 10000000 <= until {
        card.clock += 10000000
        const reads = card.reads
        const looks = watch.ports.looks
        plug.tick(&c, null, &watch)
        if watch.ports.looks == looks {
            expect(card.reads == reads, "a tick without a look reads nothing of the card")
        } else if watch.changes.count == 0 {
            expect(card.reads - reads == 9, "a look reads two words a line and one for all")
        }
    }
}

fn overTime() -> void {
    const c = card.card()
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    card.forget()
    const start = card.clock
    watch.begin(&c, 6, 100000)
    const ms: usize = 1000000

    // Unplugged at 250 ms: the looks at 300 and 400 ms see it, the
    // second says it.
    card.lineLater(start + 250 * ms, 2, false)
    ticks(start + 390 * ms)
    noLine("unplugged")
    expect(watch.ports.ports[0].level == plug.Level.high && watch.ports.ports[0].seen == plug.Level.low, "one look has seen the line low, the level stands")
    ticks(start + 400 * ms)
    once("gpu: the monitor was unplugged from connector 0 (HDMI): the picture still goes out there, to nothing\n")
    expect(watch.changes.count == 1 && watch.changes.list[0].port == 0 && watch.changes.list[0].was == plug.Level.high && watch.changes.list[0].now == plug.Level.low, "the change is given to the caller")
    expect(watch.ports.ports[0].level == plug.Level.low && !watch.ports.ports[0].atBoot && watch.ports.ports[0].since == start + 300 * ms, "the record: low since the first look that saw it")
    expect(plug.emptyFor(&watch.ports, 0) == 0, "the output is empty now")
    ticks(start + 1000 * ms)
    once("unplugged")
    expect(watch.changes.count == 0, "a change is given once")

    // Plugged again at 1050 ms: said when it has been high for 500 ms of
    // looks, at 1600 ms.
    card.lineLater(start + 1050 * ms, 2, true)
    ticks(start + 1590 * ms)
    noLine("was plugged into")
    ticks(start + 1600 * ms)
    once("gpu: something was plugged into connector 0 (HDMI), where the picture goes out\n")
    expect(watch.ports.ports[0].level == plug.Level.high && watch.ports.ports[0].since == start + 1100 * ms, "the record: high since the first look that saw it")
    ticks(start + 2000 * ms)

    // A pulse no look sees (60 ms between two looks), and one a single
    // look sees: nothing.
    card.lineLater(start + 2010 * ms, 2, false)
    card.lineLater(start + 2070 * ms, 2, true)
    card.lineLater(start + 2190 * ms, 2, false)
    card.lineLater(start + 2210 * ms, 2, true)
    ticks(start + 3000 * ms)
    once("unplugged")
    once("was plugged into")
    expect(watch.ports.ports[0].level == plug.Level.high && watch.ports.ports[0].since == start + 1100 * ms, "a short pulse changes nothing in the record")

    // A line that bounces between every two looks and comes to rest
    // high: nothing; then one that comes to rest low: said once.
    var k: usize = 0
    while k < 5 {
        card.lineLater(start + (3050 + 200 * k) * ms, 2, false)
        card.lineLater(start + (3150 + 200 * k) * ms, 2, true)
        k += 1
    }
    ticks(start + 4040 * ms)
    once("unplugged")
    k = 0
    while k < 4 {
        card.lineLater(start + (4050 + 200 * k) * ms, 2, false)
        card.lineLater(start + (4150 + 200 * k) * ms, 2, true)
        k += 1
    }
    card.lineLater(start + 4850 * ms, 2, false)
    ticks(start + 4990 * ms)
    once("unplugged")
    ticks(start + 5000 * ms)
    expect(card.count("gpu: the monitor was unplugged from connector 0 (HDMI)") == 2, "a line that comes to rest low is said, once")
    ticks(start + 5040 * ms)

    // A plug shorter than the filter on the second HDMI connector (300
    // ms): nothing.
    card.lineLater(start + 5050 * ms, 4, true)
    card.lineLater(start + 5350 * ms, 4, false)
    ticks(start + 6040 * ms)
    noLine("connector 3")

    // The DisplayPort connector: plugged at 6050 ms, said at the second
    // look (6200); unplugged at 6450, said at 6600.
    card.lineLater(start + 6050 * ms, 1, true)
    ticks(start + 6190 * ms)
    noLine("connector 1")
    ticks(start + 6200 * ms)
    once("gpu: something was plugged into connector 1 (DisplayPort)\n")
    card.lineLater(start + 6450 * ms, 1, false)
    ticks(start + 6590 * ms)
    noLine("unplugged from connector 1")
    ticks(start + 6600 * ms)
    once("gpu: what was plugged in was unplugged from connector 1 (DisplayPort)\n")

    // Something plugged into the second HDMI connector and left there.
    card.lineLater(start + 7050 * ms, 4, true)
    ticks(start + 7590 * ms)
    noLine("connector 3")
    ticks(start + 7600 * ms)
    once("gpu: something was plugged into connector 3 (HDMI)\n")
    expect(watch.ports.ports[3].level == plug.Level.high && !watch.ports.ports[3].firmware, "the second HDMI connector's record")
    plug.detect(&watch.ports, &verdict)
    expect(verdict.what == plug.Case.elsewhere && verdict.other == 3, "the detection again, any time: the monitor is elsewhere now")

    // The firmware's output's block goes off, and comes back with the
    // line high.
    card.later(start + 8050 * ms, 0x18A2, 0)
    ticks(start + 8190 * ms)
    noLine("cannot be read")
    ticks(start + 8200 * ms)
    once("gpu: connector 0 (HDMI): its hot plug line cannot be read any more: the line's block is off, and Linux's display core counts on the firmware having left it on\n")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "an output whose line cannot be read any more is not said to be empty")
    card.later(start + 8450 * ms, 0x18A2, 0x10000000)
    card.lineLater(start + 8450 * ms, 2, true)
    ticks(start + 8990 * ms)
    noLine("can be read now")
    ticks(start + 9000 * ms)
    once("gpu: connector 0 (HDMI): its hot plug line can be read now: something is plugged in\n")

    // A line whose two sense bits differ for a while (the second HDMI
    // connector's, 400 ms): no change is taken of it, and nothing said.
    const logged = card.logged
    card.later(start + 9050 * ms, 0x18B0, 0x02)
    card.later(start + 9450 * ms, 0x18B0, 0x12)
    ticks(start + 9500 * ms)
    expect(card.logged == logged && watch.ports.ports[3].level == plug.Level.high && watch.ports.ports[3].since == start + 7100 * ms, "a line that is changing is no change")

    expect(card.written == 0, "looking again and again writes nothing")
    expect(watch.ports.looks == 95, "a look every 100 ms")
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }

    // Without records a tick looks at nothing.
    card.forget()
    plug.survey(&c, null, null, &watch.ports)
    watch.begin(&c, 6, 0)
    ticks(card.clock + 1000 * ms)
    expect(card.reads == 0 && card.written == 0 && card.logged == 0, "without connector records a tick touches nothing")
}

// A line whose two sense bits differ for good while brixOS runs (the
// delayed one does not follow): as long as a filter of the block's own
// could run nothing is taken of it; after the settling time it is one
// that cannot be read any more, said once, and the record no longer
// says "high"; when the bits agree again that is said as what it is.
fn unreadable() -> void {
    const c = card.card()
    const ms: usize = 1000000
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    card.forget()
    const start = card.clock
    watch.begin(&c, 6, 100000)
    // The cable pulled at 50 ms: the line's sense is low at once, the
    // delayed one stays. Seen at 100 ms; 600 ms later it counts.
    card.later(start + 50 * ms, 0x18A0, 0x10)
    ticks(start + 690 * ms)
    expect(card.logged == 0 && watch.ports.ports[0].level == plug.Level.high && watch.ports.ports[0].seen == plug.Level.changing, "bits that differ for less than the settling time change nothing")
    ticks(start + 700 * ms)
    once("gpu: connector 0 (HDMI): its hot plug line cannot be read any more: its two sense bits differ\n")
    expect(watch.changes.count == 1 && watch.changes.list[0].was == plug.Level.high && watch.changes.list[0].now == plug.Level.changing, "the change to a line that cannot be read is given to the caller")
    expect(watch.ports.ports[0].level == plug.Level.changing && watch.ports.ports[0].since == start + 100 * ms && !watch.ports.ports[0].judged(), "the record no longer says the line is high")
    expect(plug.emptyFor(&watch.ports, 0) == plug.NONE, "a line that cannot be read stops no plan")
    ticks(start + 3000 * ms)
    expect(card.count("gpu:") == 1, "a line that cannot be read is said once, however long it lasts")
    // The delayed bit follows at last: low, said as what can be read
    // now, after an unplug's time.
    card.later(start + 3050 * ms, 0x18A0, 0)
    ticks(start + 3190 * ms)
    noLine("can be read now")
    ticks(start + 3200 * ms)
    once("gpu: connector 0 (HDMI): its hot plug line can be read now: nothing is plugged in\n")
    expect(watch.ports.ports[0].level == plug.Level.low && plug.emptyFor(&watch.ports, 0) == 0, "low again, for certain")
    // And high again after a plug's time, the two bits half a second
    // apart on the way (a filter of the block's own): one line.
    card.later(start + 4050 * ms, 0x18A0, 0x02)
    card.later(start + 4550 * ms, 0x18A0, 0x12)
    ticks(start + 6000 * ms)
    once("gpu: something was plugged into connector 0 (HDMI), where the picture goes out\n")
    expect(card.count("gpu:") == 3 && watch.ports.ports[0].level == plug.Level.high && watch.ports.ports[0].since == start + 4600 * ms, "bits half a second apart are a plug, not a line that cannot be read")
    expect(card.written == 0, "none of it writes")
    // A block whose own filter word holds a longer delay (200 counts:
    // two seconds by the longer of Linux's readings), the second HDMI
    // connector's: bits 1.5 s apart at a plug are a plug, said once; bits
    // that differ for good count after the filter's time and a look.
    four()
    card.store(0x18B4, 200 | (10 << 20))
    boot()
    card.forget()
    const again = card.clock
    watch.begin(&c, 6, 100000)
    card.later(again + 50 * ms, 0x18B0, 0x02)
    card.later(again + 1550 * ms, 0x18B0, 0x12)
    ticks(again + 3000 * ms)
    once("gpu: something was plugged into connector 3 (HDMI)\n")
    expect(card.count("gpu:") == 1 && watch.ports.ports[3].since == again + 1600 * ms, "bits apart for less than the block's own filter can hold them are a plug and nothing else")
    card.later(again + 3050 * ms, 0x18B0, 0x10)
    ticks(again + 5190 * ms)
    expect(card.count("gpu:") == 1, "bits that differ are not said before the filter's time and a look")
    ticks(again + 5200 * ms)
    once("gpu: connector 3 (HDMI): its hot plug line cannot be read any more: its two sense bits differ\n")
    expect(card.written == 0, "none of it writes")
}

// Ticks every 10 ms until a change is taken or `until` has come: the
// clock at that tick (0: none was taken).
fn changeBy(until: usize) -> usize {
    const c = card.card()
    while card.clock + 10000000 <= until {
        card.clock += 10000000
        plug.tick(&c, null, &watch)
        if watch.changes.count != 0 { return card.clock }
    }
    return 0
}

// Every kind of connector the ROM can name: a TMDS one (HDMI of either
// type, DVI of the four kinds) is asked over DDC and counts a plug after
// Linux's half second; every other one is not asked and counts it at the
// second look. An unplug counts at the second look on all of them.
const KINDS = [_]usize{ 0x0C, 0x0D, 0x01, 0x02, 0x03, 0x04, 0x13, 0x14, 0x05, 0x0E }
const KIND_NAMES = [_][]const u8{ "HDMI", "HDMI (type B)", "DVI-I (single link)", "DVI-I (dual link)", "DVI-D (single link)", "DVI-D (dual link)", "DisplayPort", "embedded DisplayPort", "VGA", "LVDS" }

fn everyKind() -> void {
    const c = card.card()
    const ms: usize = 1000000
    var k: usize = 0
    while k < KINDS.length {
        const tmds = k < 6
        const connectors = [_]usize{0x3100 | KINDS[k]}
        const pin = [_]usize{7}
        const shift = [_]usize{16}
        card.reset()
        card.makeRom(&builder, connectors[0..], ENCODERS[0..1], pin[0..], ENTRIES[1..2], pin[0..], shift[0..], CLOCKS[0..])
        open()
        card.line(3, false)
        boot()
        line("gpu: connector 0 (")
        line(KIND_NAMES[k])
        line(", DIG 4, hot plug line 3): nothing is plugged in\n")
        const port = &watch.ports.ports[0]
        expect(port.tmdsKind() == tmds && port.asks() == tmds && !plug.askedAtBoot(port), "which kinds of connector are asked over DDC")
        card.forget()
        const start = card.clock
        watch.begin(&c, 6, 100000)
        card.lineLater(start + 50 * ms, 3, true)
        expect(changeBy(start + 2000 * ms) == start + (if tmds { 600 * ms } else { 200 * ms }), "a plug counts after Linux's time for the connector's kind")
        expect(port.*.level == plug.Level.high && plug.askedAtBoot(port) == tmds, "plugged in")
        card.lineLater(start + 1050 * ms, 3, false)
        expect(changeBy(start + 3000 * ms) == start + 1200 * ms && port.*.level == plug.Level.low, "an unplug counts at the second look on every kind")
        expect(card.written == 0 && card.count("gpu:") == 2, "two changes said, nothing written")
        k += 1
    }
}

// What serves a connector is read anew when its line changes; of two
// connectors one controller's picture goes out by, both empty, the first
// is named; a DisplayPort connector that sends neither DisplayPort nor
// TMDS is not said to have an adapter; pins the ROM's table does not
// place on a line, and a DDC entry its table of lines does not have.
fn records() -> void {
    const c = card.card()
    const ms: usize = 1000000
    four()
    card.output(0, 4, 4, scanout.MODE_HDMI)
    boot()
    card.forget()
    const start = card.clock
    watch.begin(&c, 6, 100000)
    expect(!watch.ports.ports[3].firmware && watch.ports.ports[3].controller == plug.NONE, "the second HDMI connector is not served at boot")
    card.lineLater(start + 50 * ms, 4, true)
    ticks(start + 300 * ms)
    // (Controller 1's picture is sent out by DIG 1 meanwhile.)
    card.output(1, 3, 1, scanout.MODE_HDMI)
    ticks(start + 1000 * ms)
    once("gpu: something was plugged into connector 3 (HDMI), where the picture goes out\n")
    expect(watch.ports.ports[3].firmware && watch.ports.ports[3].controller == 1 && watch.ports.ports[3].frontEnd == 3 && watch.ports.ports[3].sends == plug.Sends.tmds, "what serves a connector is read anew when its line changes")

    four()
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.output(0, 4, 1, scanout.MODE_HDMI)
    boot()
    expect(watch.ports.ports[0].firmware && watch.ports.ports[3].firmware && plug.emptyFor(&watch.ports, 0) == 0, "of two empty connectors of one controller the first is named")

    four()
    card.line(1, true)
    card.output(2, 0, 0, scanout.MODE_LVDS)
    boot()
    once("gpu: the monitor is on the DisplayPort connector 1 (DIG 0, hot plug line 1): a signal this driver has no path for\n")
    noLine("an adapter is behind it")

    // Connector 0: a pin the table of pins does not have; 1: a pin on a
    // register that is not the hot plug pins'; 2: a pin at a bit that is
    // no line's; 3: no hot plug record. Their DDC entries: the first of
    // the table, one beyond it, none, and one whose clock pin is no
    // line's (the I2C pad's).
    const connectors = [_]usize{ 0x310C, 0x320C, 0x3113, 0x3213 }
    const pins = [_]usize{ 9, 5, 6, 0xFF }
    const entries = [_]usize{ 0, 7, 0xFF, 1 }
    const ids = [_]usize{ 5, 6, 3 }
    const registers = [_]usize{ 0x0183, 0x488D, 0x488D }
    const shifts = [_]usize{ 0, 4, 16 }
    const clocks = [_]usize{ 0x4869, 0x4899 }
    const end = [_]u8{0x5B}
    card.reset()
    builder.begin(81, 35)
    _ = builder.command(0, 0, 0, end[0..])
    _ = builder.firmware(100000, 6000, 200000, 16000, 600000, 625000, 0)
    _ = builder.objects(connectors[0..], ENCODERS[0..], pins[0..], entries[0..])
    _ = builder.pins(1, ids[0..], registers[0..], shifts[0..])
    _ = card.lines(&builder, 1, clocks[0..])
    builder.finish()
    open()
    var n: usize = 1
    while n <= 6 {
        card.line(n, true)
        n += 1
    }
    boot()
    var k: usize = 0
    while k < 4 {
        expect(watch.ports.ports[k].level == plug.Level.no_line && watch.ports.ports[k].line == 0 && !plug.askedAtBoot(&watch.ports.ports[k]), "a pin that is on none of the six lines gives no line, whatever the lines say")
        k += 1
    }
    expect(watch.ports.ports[0].why == plug.Why.not_placed && watch.ports.ports[1].why == plug.Why.not_placed && watch.ports.ports[2].why == plug.Why.not_placed && watch.ports.ports[3].why == plug.Why.no_record, "why each has no line")
    expect(watch.ports.ports[0].wire.why == ddc.Unwired.wired && watch.ports.ports[1].wire.why == ddc.Unwired.beyond_table && watch.ports.ports[2].wire.why == ddc.Unwired.no_record && watch.ports.ports[3].wire.why == ddc.Unwired.not_a_line, "each connector's DDC line, or why it has none")
    expect(verdict.plugged == 0 && verdict.what == plug.Case.nothing, "nothing is said to be plugged in where no line can be read")
    once("gpu: nothing is plugged into any connector whose hot plug line can be read, and the firmware's picture goes out by none of them\n")
    // A tick looks at nothing of such a board.
    card.forget()
    watch.begin(&c, 6, 100000)
    card.clock += 1000 * ms
    plug.tick(&c, null, &watch)
    expect(card.reads == 1 && card.written == 0 && card.logged == 0, "a look at a board without lines reads the pins' word and no more")
}

// An hour of ticks on a card that stands still, one of its lines' blocks
// off and one line's bits differing since boot: 36000 looks, not a
// write, not a word.
fn anHour() -> void {
    const c = card.card()
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.sense(1, true, false)
    card.store(0x18C2, 0)
    card.stride = 1000000
    boot()
    card.stride = 0
    card.forget()
    watch.begin(&c, 6, 100000)
    var t: usize = 0
    while t < 360000 {
        card.clock += 10000000
        plug.tick(&c, null, &watch)
        t += 1
    }
    expect(card.written == 0 && card.logged == 0, "an hour of ticks on a still card writes nothing and says nothing")
    expect(watch.ports.looks == 36000 && card.reads == 36000 * 9, "ten looks a second for an hour, nine words a look")
}

// A number of the test's own making (the same every run).
var seed: usize = 20261117

fn random() -> usize {
    seed = (seed * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
    return (seed >> 33) & 0x7FFFFFFF
}

const LINE_OF = [_]usize{ 2, 1, 6, 4 }
var actual: [4]bool = undefined
var recorded: [4]plug.Level = undefined

fn setLine(port: usize, high: bool) -> void {
    actual[port] = high
    card.sense(LINE_OF[port], high, high)
}

fn levelOf(high: bool) -> plug.Level { return if high { plug.Level.high } else { plug.Level.low } }

// All four lines toggled at times of chance for twenty seconds, then
// left alone for two: every change given is from the level the record
// had to the level the line has at that look, none is given twice, none
// is lost (after the rest the record says what the line says), and
// nothing is said at a tick without a change.
fn atRandom() -> void {
    const c = card.card()
    var round: usize = 0
    var taken: usize = 0
    while round < 60 {
        four()
        var k: usize = 0
        while k < 4 {
            setLine(k, random() % 2 == 0)
            k += 1
        }
        card.output(0, 4, 4, scanout.MODE_HDMI)
        plug.survey(&c, &machine, &board, &watch.ports)
        watch.begin(&c, 6, 100000)
        k = 0
        while k < 4 {
            recorded[k] = watch.ports.ports[k].level
            expect(recorded[k] == levelOf(actual[k]), "the survey takes each line as it is")
            k += 1
        }
        card.forget()
        var tick: usize = 0
        while tick < 2200 {
            if tick < 2000 {
                k = 0
                while k < 4 {
                    if random() % 23 == 0 { setLine(k, !actual[k]) }
                    k += 1
                }
            }
            card.clock += 10000000
            const said = card.logged
            plug.tick(&c, null, &watch)
            var n: usize = 0
            while n < watch.changes.count {
                const change = &watch.changes.list[n]
                expect(change.*.was == recorded[change.*.port] && change.*.now != change.*.was, "a change starts from the level the record had")
                expect(change.*.now == levelOf(actual[change.*.port]), "a change is to the level the line has at that look")
                recorded[change.*.port] = change.*.now
                taken += 1
                n += 1
            }
            if watch.changes.count == 0 { expect(card.logged == said, "nothing is said at a tick without a change") }
            tick += 1
        }
        k = 0
        while k < 4 {
            expect(watch.ports.ports[k].level == levelOf(actual[k]) && watch.ports.ports[k].level == recorded[k], "after two seconds of rest the record says what the line says: no change was lost")
            k += 1
        }
        expect(card.written == 0, "none of it writes")
        expect(card.count("gpu:") == taken, "every change is said once")
        taken = 0
        round += 1
    }
}

// A pulse of every length around Linux's times on the HDMI connector, at
// every tenth of the time between two looks: one shorter than the time
// is never said, one that two looks (an unplug) or six (a plug) see
// always, and whatever was said of its beginning is said of its end.
fn pulseOf(low: bool, length: usize, least: *usize, most: *usize) -> void {
    const c = card.card()
    const ms: usize = 1000000
    least.* = 99
    most.* = 0
    var phase: usize = 0
    while phase < 10 {
        four()
        card.line(2, low)
        card.output(0, 4, 4, scanout.MODE_HDMI)
        plug.survey(&c, &machine, &board, &watch.ports)
        watch.begin(&c, 6, 100000)
        card.forget()
        const start = card.clock
        card.lineLater(start + (305 + phase * 10) * ms, 2, !low)
        card.lineLater(start + (305 + phase * 10 + length) * ms, 2, low)
        var t: usize = 0
        while t < 300 {
            card.clock += 10000000
            plug.tick(&c, null, &watch)
            t += 1
        }
        const unplugs = card.count("was unplugged from")
        const plugs = card.count("was plugged into")
        expect(unplugs == plugs && plugs <= 1, "a pulse is said once at most, its end as its beginning")
        expect(watch.ports.ports[0].level == levelOf(low), "after a pulse the record is as before it")
        if plugs < least.* { least.* = plugs }
        if plugs > most.* { most.* = plugs }
        phase += 1
    }
}

fn pulses() -> void {
    const lows = [_]usize{ 10, 50, 90, 100, 110, 150, 190, 200, 210, 300 }
    const highs = [_]usize{ 100, 400, 490, 500, 510, 590, 600, 610, 700 }
    var least: usize = 0
    var most: usize = 0
    var k: usize = 0
    while k < lows.length {
        pulseOf(true, lows[k], &least, &most)
        if lows[k] <= 100 { expect(most == 0, "a low of Linux's 100 ms or less is never an unplug") }
        if lows[k] >= 200 { expect(least == 1, "a low that two looks see is always an unplug") }
        k += 1
    }
    k = 0
    while k < highs.length {
        pulseOf(false, highs[k], &least, &most)
        if highs[k] <= 500 { expect(most == 0, "a high of Linux's 500 ms or less is never a plug") }
        if highs[k] >= 600 { expect(least == 1, "a high of 600 ms and more is always a plug") }
        k += 1
    }
}

var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var result: set.Result = undefined
var memory: scanout.Memory = undefined
var information: videorom.Firmware = undefined

fn tmdsLog(text: []const u8) -> void {
    tmds.logWrite(text)
    if show { say(text) }
}

// The machine of tests/474 (controller 0's 1280x960 picture leaves by
// DIG 4 in DVI mode, the ROM puts an HDMI connector on hot plug line 2
// behind it; the monitor's own timing is 3840x1080 at 266.64 MHz and its
// EDID has the HDMI block) with hot plug line 2's control and status
// words and the pins' word as told: read out, the plan made and said,
// the connectors looked at. Whether the driver lets the plan be carried
// out: `emptyFor` names no connector for the plan's controller.
fn planned(control: usize, status: usize, pins: usize) -> bool {
    const out = scanout.Card.{ .read = tmds.read, .now = tmds.now, .write = tmdsLog }
    tmds.reset()
    tmds.firmware(0, 4, 4, false, 2, 107962)
    tmds.store(0x18A2, control)
    tmds.store(0x18A0, status)
    tmds.store(0x488C, pins)
    const monitor = edid.Monitor.{ .state = edid.State.found, .width = 3840, .height = 1080, .timing = edid.Timing.{ .clock = 266640, .width = 3840, .hTotal = 4000, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1111, .vFront = 3, .vSync = 10, .vPositive = false, .interlaced = false, .stereo = false }, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.cta }
    var offer = edid.nothing()
    offer.hdmi = true
    offer.extensions = 1
    offer.given = 1
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    scanout.report(&out, &memory, &readout)
    mode.makeFor(&out, &readout, &memory, &monitor, &offer, &facts, mode.Wish.own, &plan)
    mode.say(&out, &plan)
    mode.list(&out, &plan)
    tmds.forget()
    plug.survey(&out, &machine, &board, &watch.ports)
    plug.sayPorts(&out, &watch.ports)
    expect(tmds.written == 0 && tmds.runs == 0, "the plan is made and the connectors are looked at without a write")
    expect(plan.complete && plan.situation == mode.Situation.tmds && plan.controller == 0, "the plan for the HDMI output is complete, whatever its hot plug line says")
    const port = &watch.ports.ports[0]
    expect(port.*.firmware && port.*.controller == plan.controller && port.*.frontEnd == readout.controllers[0].encoder.frontEnd && port.*.rom.transmitter == readout.controllers[0].encoder.backEnd && port.*.mode == readout.controllers[0].encoder.mode, "what serves the connector is what the read-out found")
    return plug.emptyFor(&watch.ports, plan.controller) == plug.NONE
}

// The plan carried out, lent the card's tables.
fn carry() -> bool {
    const out = scanout.Card.{ .read = tmds.read, .now = tmds.now, .write = tmdsLog }
    const hands = set.Hands.{ .write = tmds.write, .clear = tmds.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = tmds.hands(), .aside = tmds.setAside }
    return set.attemptWith(&out, &hands, &lent, &plan, true, &result)
}

fn planAndGate() -> void {
    tmds.makeRom(&builder, tmds.NEVER, tmds.Ending.plain)
    open()
    videorom.readFirmware(&machine, &information)
    // The line high, its block on: the mode is set.
    expect(planned(0x10000000, 0x12, 0), "an output whose line is high has its mode set")
    expect(tmds.has("the line says a monitor is there") && tmds.has("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): a monitor is plugged in; the firmware's picture goes out here\n"), "the plan and the look agree that a monitor is there")
    expect(carry() && tmds.written != 0 && tmds.runs == 7, "the plan is carried out")
    // The line low for certain: the plan is complete all the same, and
    // would set the mode; the driver does not carry it out.
    expect(!planned(0x10000000, 0, 0), "an output whose line is low for certain gets no mode")
    expect(tmds.has("the line says no monitor is there") && tmds.has("gpu: connector 0 (HDMI, DIG 4, hot plug line 2): nothing is plugged in, yet the firmware's picture goes out here\n"), "the plan and the look agree that nothing is there")
    expect(plug.emptyFor(&watch.ports, plan.controller) == 0 && tmds.written == 0 && tmds.runs == 0, "nothing is written for an output with nothing plugged in")
    // What is less than certain stops nothing: the block off (as the
    // card of tests/474 has it), the pin held as a plain pin, the two
    // sense bits differing either way.
    expect(planned(0, 2, 0), "a line whose block is off stops nothing")
    expect(carry() && tmds.runs == 7, "the mode is set on an output whose line cannot be judged")
    expect(planned(0, 0, 0), "a low line whose block is off stops nothing")
    expect(planned(0x10000000, 0, 0x100), "a low line whose pin is not the block's stops nothing")
    expect(!planned(0x10000000, 0, 0x11110001), "other lines' pins do not count")
    expect(planned(0x10000000, 0x10, 0) && planned(0x10000000, 0x2, 0), "a line that is changing stops nothing")
}

// What a look and a tick cost here, on the table (the registers are an
// array: on the card each read is one of the aperture's).
fn cost() -> void {
    const c = card.card()
    four()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    var changes: plug.Changes = undefined
    const rounds: usize = 2000000
    var began = std.time.monotonicNanoseconds()
    var k: usize = 0
    while k < rounds {
        plug.look(&c, &watch.ports, &changes)
        k += 1
    }
    var took = std.time.monotonicNanoseconds() - began
    say("a look at four lines: ")
    sayNumber(took / rounds)
    say(" ns, ")
    sayNumber(card.reads / rounds)
    say(" register reads\n")
    began = std.time.monotonicNanoseconds()
    k = 0
    while k < rounds {
        plug.tick(&c, null, &watch)
        k += 1
    }
    took = std.time.monotonicNanoseconds() - began
    say("a tick between two looks: ")
    sayNumber(took / rounds)
    say(" ns\n")
}

fn sayNumber(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    if std.process.count(arguments) > 2 {
        cost()
        return 13
    }
    atBoot()
    sixLines()
    lineStates()
    overTime()
    unreadable()
    everyKind()
    records()
    anHour()
    atRandom()
    pulses()
    planAndGate()
    if failed != 0 { return failed }
    return 13
}
