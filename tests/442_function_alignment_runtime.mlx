// A function's address is a multiple of 16 on x86_64 (of 4 on aarch64):
// its low bits are free, and a word that is a function's address or an
// odd number tells the two apart (a C++ pointer to a member function in
// the translator's model). Functions of different lengths, one after the
// other; the address goes through an integer and back and is called.
// Exits 13.
fn one(x: u32) -> u32 { return x + 1 }
fn two(x: u32) -> u32 { return x * 3 + 7 }
fn three(x: u32) -> u32 {
    if x > 3 { return 1 }
    return x
}
fn four(x: u32) -> u32 {
    var total: u32 = 0
    var k: u32 = 0
    while k < x {
        total += k
        k += 1
    }
    return total
}
fn five() -> u32 { return 5 }

pub fn main() -> u8 {
    const addresses = [_]usize{ @intFromPtr(one), @intFromPtr(two), @intFromPtr(three), @intFromPtr(four), @intFromPtr(five), @intFromPtr(main) }
    var odd: u8 = 0
    for address in addresses {
        if address % 4 != 0 { odd += 1 }
    }
    if odd != 0 { return 20 + odd }
    const back = unsafe { @ptrFromInt(fn(u32) -> u32, addresses[1]) }
    return @intCast(u8, back(2))
}
