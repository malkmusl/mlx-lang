// @offsetOf is a compile-time constant for local types and for types from
// another module, as a call argument, a local and in a condition. Exits 13.
const layout = @import("./support/layout_types.mlx")

const Local = struct { a: u8, b: u64, c: u16 }

fn same(value: usize) -> usize { return value }

fn second(name: []const u8, value: usize, unused: usize) -> usize { return value }

pub fn main() -> u8 {
    if @offsetOf(Local, "b") != 8 || @offsetOf(Local, "c") != 16 { return 1 }
    const local = @offsetOf(Local, "c")
    if local != 16 { return 2 }
    if same(@offsetOf(layout.Extent, "depth")) != 8 { return 3 }
    if second("a slice before it", @offsetOf(layout.Tagged, "extent"), 0) != 16 { return 4 }
    const imported = @offsetOf(layout.Tagged, "flags")
    if imported != 28 { return 5 }
    if @sizeOf(layout.Tagged) != 32 { return 6 }
    return 13
}
