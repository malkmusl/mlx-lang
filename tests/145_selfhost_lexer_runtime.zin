const lexer = @import("../compiler/selfhost/lexer.zin")
const token = @import("../compiler/selfhost/token.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")
const Kind = token.Kind

fn firstIs(source: []const u8, expected: Kind, length: usize) -> bool {
    const current = lexer.next(source, 0)
    return current.kind == expected && current.length == length
}

pub fn main() -> u8 {
    if !firstIs("threadlocal", token.Kind.keyword_threadlocal, 11) { return 1 }
    if !firstIs("nonexhaustive", token.Kind.keyword_nonexhaustive, 13) { return 2 }
    if !firstIs("0..8", token.Kind.integer, 1) { return 3 }
    if !firstIs("1.25", token.Kind.float, 4) { return 4 }
    if !firstIs("1e-3", token.Kind.float, 4) { return 5 }
    if !firstIs("0x1.fp2", token.Kind.float, 7) { return 6 }
    if !firstIs("\"hello\"", token.Kind.string, 7) { return 7 }
    if !firstIs("b\"hello\"", token.Kind.byte_string, 8) { return 8 }
    if !firstIs("'a'", token.Kind.character, 3) { return 9 }

    if !firstIs("<<%|=", token.Kind.shift_left_percent_pipe_equal, 5) { return 10 }
    if !firstIs("+%<<=", token.Kind.plus_percent_shift_left_equal, 5) { return 11 }
    if !firstIs("-|>>=", token.Kind.minus_pipe_shift_right_equal, 5) { return 12 }
    if !firstIs("&<<=", token.Kind.ampersand_shift_left_equal, 4) { return 14 }
    if !firstIs(">>|=", token.Kind.shift_right_pipe_equal, 4) { return 15 }
    if !firstIs("->>=", token.Kind.minus_shift_right_equal, 4) { return 16 }
    if !firstIs("<<%=", token.Kind.shift_left_percent_equal, 4) { return 17 }
    if !firstIs("^>>", token.Kind.caret_shift_right, 3) { return 18 }
    if !firstIs("<<^", token.Kind.shift_left_caret, 3) { return 19 }
    if !firstIs("->", token.Kind.arrow, 2) { return 20 }
    if !firstIs("=>", token.Kind.arrow, 2) { return 21 }

    var nested = lexer.init("a /* outer /* nested */ end */ b")
    if lexer.scanNext(&nested).kind != token.Kind.identifier { return 22 }
    if lexer.scanNext(&nested).kind != token.Kind.identifier { return 23 }
    if lexer.scanNext(&nested).kind != token.Kind.end_of_file { return 24 }

    var lines = lexer.init("a +\nb\n(\nc\n)\n")
    if lexer.scanNext(&lines).kind != token.Kind.identifier { return 25 }
    if lexer.scanNext(&lines).kind != token.Kind.plus { return 26 }
    if lexer.scanNext(&lines).kind != token.Kind.identifier { return 27 }
    if lexer.scanNext(&lines).kind != token.Kind.statement_end { return 28 }
    if lexer.scanNext(&lines).kind != token.Kind.left_parenthesis { return 29 }
    if lexer.scanNext(&lines).kind != token.Kind.identifier { return 30 }
    if lexer.scanNext(&lines).kind != token.Kind.right_parenthesis { return 31 }
    if lexer.scanNext(&lines).kind != token.Kind.statement_end { return 32 }

    const source = "const value = @sizeOf(u32)\nreturn value\n"
    const tokens = lexer.scanAll(page_allocator.init(), source)
    if tokens.length < 12 { return 33 }
    if lexer.tokenAt(tokens, 0).kind != token.Kind.keyword_const { return 34 }
    if lexer.tokenAt(tokens, tokens.length - 1).kind != token.Kind.end_of_file { return 35 }
    lexer.deinit(tokens)
    return 13
}
