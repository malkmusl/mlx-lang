// std.tinypage_allocator under std.page_allocator: small blocks share
// pages as runs of 64-byte tiny pages, never overlap, come zeroed, a block
// squeezes into the hole another left, a free with a wrong length frees
// the block it names and a second free of it changes nothing, alignments
// are kept, large blocks and page alignments get pages of their own, and
// four threads taking and giving back blocks at once keep them apart.
// Exits 13 on success (another number: the step that failed).
const bootstrap = @import("../std/bootstrap/root.mlx")
const linux = bootstrap.linux
const thread = linux.thread
const tiny = bootstrap.tinypage_allocator

const COUNT: usize = 600
const WORKERS: usize = 4
const STACK_SIZE: usize = 262144

var addresses: [600]usize = undefined
var lengths: [600]usize = undefined
var tcb: [8]usize = undefined
var childTcbs: [32]usize = undefined
var childTids: [4]u32 = undefined
var parentTids: [4]u32 = undefined
var failures: [4]usize = undefined

fn bytesAt(address: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, address) }
}

fn fill(address: usize, length: usize, value: u8) -> void {
    const bytes = bytesAt(address)
    var at: usize = 0
    while at < length {
        bytes[at] = value
        at += 1
    }
}

fn holds(address: usize, length: usize, value: u8) -> bool {
    const bytes = bytesAt(address)
    var at: usize = 0
    while at < length {
        if bytes[at] != value { return false }
        at += 1
    }
    return true
}

fn inTiny(address: usize) -> bool { return address >= tiny.DATA && address < tiny.END }

// A small pseudo-random sequence (no clock: the test is the same each run).
fn next(seed: *usize) -> usize {
    seed.* = seed.* *% 6364136223846793005 +% 1442695040888963407
    return seed.* >> 33
}

// Each worker takes and gives back blocks, each filled with its own mark
// and checked before it goes; a block found changed is a failure.
fn worker(argument: usize) -> usize {
    const pages = bootstrap.page_allocator.init()
    var held: [64]usize = undefined
    var sizes: [64]usize = undefined
    var slot: usize = 0
    while slot < 64 {
        held[slot] = 0
        slot += 1
    }
    var seed = argument * 7919 + 1
    var round: usize = 0
    while round < 20000 {
        const at = next(&seed) % 64
        const mark = @intCast(u8, (argument * 64 + at) % 251 + 1)
        if held[at] != 0 {
            if !holds(held[at], sizes[at], mark) { failures[argument] += 1 }
            pages.free(bytesAt(held[at]), sizes[at], 8)
            held[at] = 0
        } else {
            const size = next(&seed) % 2000 + 1
            const block = pages.alloc(size, 8)
            if block == null {
                failures[argument] += 1
            } else {
                held[at] = @intFromPtr(block.?)
                sizes[at] = size
                if !holds(held[at], size, 0) { failures[argument] += 1 }
                fill(held[at], size, mark)
            }
        }
        round += 1
    }
    slot = 0
    while slot < 64 {
        if held[slot] != 0 { pages.free(bytesAt(held[slot]), sizes[slot], 8) }
        slot += 1
    }
    return 0
}

fn join(index: usize) -> void {
    while true {
        const seen = @atomicLoad(u32, @ptrCast(*u32, &childTids[index]), acquire)
        if seen == 0 { break }
        const waited = thread.futexWait(@ptrCast(*u32, &childTids[index]), seen, 0, false)
    }
}

pub fn main() -> u8 {
    const pages = bootstrap.page_allocator.init()
    // Many small blocks of every size: in the tiny pages, apart, zeroed.
    var seed: usize = 12345
    var index: usize = 0
    while index < COUNT {
        lengths[index] = next(&seed) % 2048 + 1
        const block = pages.alloc(lengths[index], 8)
        if block == null { return 1 }
        addresses[index] = @intFromPtr(block.?)
        if !inTiny(addresses[index]) { return 2 }
        if !holds(addresses[index], lengths[index], 0) { return 3 }
        fill(addresses[index], lengths[index], @intCast(u8, index % 251 + 1))
        index += 1
    }
    index = 0
    while index < COUNT {
        if !holds(addresses[index], lengths[index], @intCast(u8, index % 251 + 1)) { return 4 }
        index += 1
    }
    // Every other one freed, then taken again: zeroed, the others intact.
    index = 0
    while index < COUNT {
        pages.free(bytesAt(addresses[index]), lengths[index], 8)
        index += 2
    }
    index = 0
    while index < COUNT {
        const block = pages.alloc(lengths[index], 8)
        if block == null { return 5 }
        addresses[index] = @intFromPtr(block.?)
        if !holds(addresses[index], lengths[index], 0) { return 6 }
        fill(addresses[index], lengths[index], @intCast(u8, index % 251 + 1))
        index += 2
    }
    index = 0
    while index < COUNT {
        if !holds(addresses[index], lengths[index], @intCast(u8, index % 251 + 1)) { return 7 }
        pages.free(bytesAt(addresses[index]), lengths[index], 8)
        index += 1
    }
    // A hole squeezed into: three blocks, the middle one freed, a smaller
    // one takes its place.
    const first = @intFromPtr(pages.alloc(64, 8).?)
    const middle = @intFromPtr(pages.alloc(1024, 8).?)
    const last = @intFromPtr(pages.alloc(64, 8).?)
    if middle != first + 64 || last != middle + 1024 { return 8 }
    pages.free(bytesAt(middle), 1024, 8)
    const squeezed = @intFromPtr(pages.alloc(500, 8).?)
    if squeezed != middle { return 9 }
    // A wrong length frees the whole block; a second free changes nothing.
    pages.free(bytesAt(squeezed), 64, 8)
    pages.free(bytesAt(squeezed), 64, 8)
    const again = @intFromPtr(pages.alloc(1024, 8).?)
    if again != middle { return 10 }
    fill(again, 1024, 77)
    pages.free(bytesAt(first), 64, 8)
    pages.free(bytesAt(last), 64, 8)
    if !holds(again, 1024, 77) { return 11 }
    pages.free(bytesAt(again), 1024, 8)
    // Alignments kept; large blocks and page alignments get pages.
    const aligned = @intFromPtr(pages.alloc(100, 1024).?)
    if !inTiny(aligned) || aligned % 1024 != 0 { return 12 }
    const large = @intFromPtr(pages.alloc(5000, 8).?)
    if inTiny(large) || large % 4096 != 0 { return 14 }
    const paged = @intFromPtr(pages.alloc(100, 4096).?)
    if inTiny(paged) || paged % 4096 != 0 { return 15 }
    if bootstrap.page_allocator.footprint(aligned, 100) != 128 || bootstrap.page_allocator.footprint(large, 5000) != 8192 { return 16 }
    pages.free(bytesAt(aligned), 100, 1024)
    pages.free(bytesAt(large), 5000, 8)
    pages.free(bytesAt(paged), 100, 4096)
    // Everything given back: the tiny pages hold no block.
    var usage: tiny.Usage = undefined
    tiny.usage(&usage)
    if usage.blocks != 0 || usage.bytes != 0 { return 17 }
    // Four threads at once.
    tcb[0] = @intFromPtr(&tcb)
    if linux.syscall2(158, 4098, @intFromPtr(&tcb)) != 0 { return 18 }
    const flags = thread.CLONE_VM | thread.CLONE_FS | thread.CLONE_FILES | thread.CLONE_SIGHAND | thread.CLONE_THREAD | thread.CLONE_SYSVSEM | thread.CLONE_SETTLS | thread.CLONE_PARENT_SETTID | thread.CLONE_CHILD_CLEARTID | thread.CLONE_CHILD_SETTID
    var worker_index: usize = 0
    while worker_index < WORKERS {
        const stack = linux.syscall6(linux.SYS_mmap, 0, STACK_SIZE, 3, 34, 18446744073709551615, 0)
        if stack < 0 { return 19 }
        childTcbs[worker_index * 8] = @intFromPtr(&childTcbs) + worker_index * 64
        childTids[worker_index] = 1
        failures[worker_index] = 0
        const tid = @spawnThread(flags, @intCast(usize, stack) + STACK_SIZE, @intFromPtr(&parentTids[worker_index]), @intFromPtr(&childTids[worker_index]), @intFromPtr(&childTcbs) + worker_index * 64, worker, worker_index)
        if tid <= 0 { return 20 }
        worker_index += 1
    }
    worker_index = 0
    while worker_index < WORKERS {
        join(worker_index)
        if failures[worker_index] != 0 { return 21 }
        worker_index += 1
    }
    tiny.usage(&usage)
    if usage.blocks != 0 { return 22 }
    return 13
}
