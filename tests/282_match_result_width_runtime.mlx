// A match expression's arms store its value at the match's own width: a
// u32 match whose arms are literals and a u32 variable used to store the
// literals as eight bytes and the variable as four, then load eight, so
// the variable's arm came out with whatever the stack held above it
// (Caps Lock on a Unicode keysym typed garbage). Exits 13.
const std = @import("std")

// Leaves the stack below the caller full of `value`.
fn dirty(depth: usize, value: u64) -> u64 {
    const a = value | 1
    const b = value | 2
    const c = value | 3
    const d = value | 4
    if depth == 0 { return a ^ b ^ c ^ d }
    return dirty(depth - 1, value) ^ a ^ b ^ c ^ d
}

fn pick(code: u32) -> u32 {
    return match code { 1 => 2, 3 => 4, else => code }
}

fn pickByte(code: u8) -> u8 {
    return match code { 1 => 2, else => code }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const d = dirty(4000, 18446744069414584320)
    const wide: u64 = 16777216 | @intCast(u64, pick(649))
    if wide != 16777865 { return 1 }
    if pick(1) != 2 || pick(3) != 4 { return 2 }
    const e = dirty(4000, 18446744073709551360)
    const byte: u64 = 256 | @intCast(u64, pickByte(7))
    if byte != 263 { return 3 }
    return 13
}
