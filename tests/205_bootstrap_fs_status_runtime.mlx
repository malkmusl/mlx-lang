const std = @import("std")

pub fn main() -> u8 {
    if @sizeOf(std.fs.Stat) != 144 { return 1 }
    var current: std.fs.Stat = undefined
    var root: std.fs.Stat = undefined
    unsafe {
        if std.fs.status(@ptrCast([*]const u8, "."), &current) != 0 { return 2 }
        if std.fs.status(@ptrCast([*]const u8, "/"), &root) != 0 { return 3 }
    }
    if current.inode == 0 || root.inode == 0 { return 4 }

    const allocator = std.page_allocator.init()
    const allocation = allocator.alloc(4096, 8)
    if allocation == null { return 5 }
    const buffer = allocation.?
    const length = std.fs.getWorkingDirectory(buffer, 4096)
    if length <= 1 || buffer[0] != 47 { return 6 }
    allocator.free(buffer, 4096, 8)
    return 13
}
