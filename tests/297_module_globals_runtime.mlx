// Module-level `var` globals: slots of the image's data area. Scalars with
// their initial values (a negative signed one, a bool, a 64-bit pattern),
// aggregates starting as `undefined` (zeroed) or from a literal (an array,
// a struct, an array of structs, its bytes written into the image): an
// array, a struct, a slice over an array global, a pointer global pointing
// at another global; their addresses; and another module's `pub var`
// globals read and written as `module.name`. A static image: the data area
// is its `.data` segment. Exits 13 on success.
const globals = @import("./support/module_globals.mlx")

const Vec = struct { x: i64, y: i64, z: i64 }

var counter: u32 = 0
var flag: bool = true
var negative: i32 = -5
var pattern: u64 = 0x1122334455667788
var origin: Vec = undefined
var words: [3]u64 = undefined
var view: []const u64 = undefined
var owner: *Vec = undefined
var scratch: u8 = 0
var table: [4]u16 = [4]u16{ 10, 20, 30, 40 }
var unit: Vec = Vec.{ .x = 1, .y = -2, .z = 3 }
var corners: [2]Vec = [2]Vec{ Vec.{ .x = 1, .y = 1, .z = 1 }, Vec.{ .x = -1, .y = -1, .z = -1 } }

fn bump() -> u32 {
    counter += 1
    return counter
}

fn total(vec: *const Vec) -> i64 { return vec.*.x + vec.*.y + vec.*.z }

fn scalars() -> u8 {
    if bump() != 1 { return 1 }
    if bump() != 2 { return 2 }
    if counter != 2 { return 3 }
    if !flag { return 4 }
    flag = false
    if flag { return 5 }
    if negative != -5 { return 6 }
    negative += 10
    if negative != 5 { return 7 }
    if pattern != 0x1122334455667788 { return 8 }
    pattern >>= 32
    if pattern != 0x11223344 { return 9 }
    return 0
}

fn aggregates() -> u8 {
    // A struct global: field stores and loads, its address, a pointer
    // global pointing at it.
    if origin.x != 0 || origin.z != 0 { return 10 }
    origin.x = 1
    origin.y = 2
    origin.z = 3
    if origin.y != 2 { return 11 }
    if total(&origin) != 6 { return 12 }
    owner = &origin
    owner.*.z = 10
    if origin.z != 10 { return 13 }
    // An array global and a slice global over it.
    words[0] = 5
    words[1] = 6
    words[2] = 7
    view = words[0..3]
    if view.length != 3 { return 14 }
    if view[2] != 7 { return 15 }
    var sum: u64 = 0
    for word in view { sum += word }
    if sum != 18 { return 16 }
    words[2] = 8
    if view[2] != 8 { return 17 }
    return 0
}

fn initialized() -> u8 {
    // Literal initializers: the slots hold their bytes before any code ran.
    if table[0] != 10 || table[3] != 40 { return 30 }
    var sum: u32 = 0
    for value in table { sum += @intCast(u32, value) }
    if sum != 100 { return 31 }
    table[1] = 25
    if table[1] != 25 { return 32 }
    if unit.x != 1 || unit.y != -2 || unit.z != 3 { return 33 }
    if total(&unit) != 2 { return 34 }
    unit.y = 2
    if total(&unit) != 6 { return 35 }
    if corners[0].z != 1 || corners[1].y != -1 { return 36 }
    if total(&corners[1]) != -3 { return 37 }
    corners[1].x = 5
    if corners[1].x != 5 || corners[0].x != 1 { return 38 }
    if globals.limits[2] != 300 || globals.limits.length != 3 { return 39 }
    return 0
}

fn foreign() -> u8 {
    // Another module's globals, read and written here.
    if globals.count != 3 { return 20 }
    if globals.bump() != 4 { return 21 }
    globals.count = 40
    if globals.bump() != 41 { return 22 }
    globals.fill(10)
    if globals.buffer[7] != 17 { return 23 }
    globals.buffer[0] = 99
    if globals.buffer[0] != 99 { return 24 }
    globals.pair.first = 8
    globals.pair.second = 9
    if globals.pair.first + globals.pair.second != 17 { return 25 }
    globals.text = "hello"
    if globals.text.length != 5 { return 26 }
    if globals.text[1] != 101 { return 27 }
    globals.cursor = &scratch
    globals.cursor.* = 42
    if scratch != 42 { return 28 }
    const buffer = &globals.buffer
    if buffer.*[0] != 99 { return 29 }
    return 0
}

pub fn main() -> u8 {
    const first = scalars()
    if first != 0 { return first }
    const second = aggregates()
    if second != 0 { return second }
    const third = foreign()
    if third != 0 { return third }
    const fourth = initialized()
    if fourth != 0 { return fourth }
    return 13
}
