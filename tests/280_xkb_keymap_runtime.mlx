// std.xkb reads a keymap as a compositor sends it
// (tests/support/xkb/de-ru.xkb: `xkbcli compile-keymap --layout de,ru`)
// and std.xkb.state types with it as libxkbcommon does: Shift and AltGr
// levels, Caps Lock on a letter whose type uses it, Control making control
// characters (from the Latin group for a Cyrillic key), the keypad with and
// without Num Lock, the second group, which keys repeat; and std.xkb.keysym
// names, characters and cases. Exits 13.
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")
const xkb_state = @import("std.xkb.state")

fn types(state: *xkb_state.State, keycode: u32, expected: []const u8) -> bool {
    var out: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &out) }
    const length = xkb_state.keyUtf8(state, keycode, bytes, 16)
    return std.text.same(bytes[0..length], expected)
}

fn readFixture(allocator: std.allocator.Allocator) -> std.fs.ArrayList {
    const path = "tests/support/xkb/de-ru.xkb\0"
    var file: std.fs.File = undefined
    unsafe { file = std.fs.open(@ptrCast([*]const u8, path), std.fs.READ_ONLY, 0) }
    return std.fs.readToEndAlloc(file, allocator)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var names: keysym.Names = undefined
    if !keysym.init(&names, allocator) { return 1 }
    if keysym.fromName(&names, "adiaeresis") != 228 || keysym.fromName(&names, "Cyrillic_shorti") != 1738 { return 2 }
    if keysym.fromName(&names, "U20AC") != 16785580 || keysym.toUtf32(&names, 16785580) != 8364 { return 2 }
    var name: [32]u8 = undefined
    var name_bytes: [*]u8 = undefined
    unsafe { name_bytes = @ptrCast([*]u8, &name) }
    const name_length = keysym.nameOf(&names, 65365, name_bytes, 32)
    if !std.text.same(name_bytes[0..name_length], "Prior") { return 3 }
    if keysym.toUpper(&names, 1738) != 1770 || keysym.toLower(&names, 196) != 228 || !keysym.isKeypad(65463) { return 4 }

    const text = readFixture(allocator)
    if text.length == 0 { return 5 }
    const keymap = xkb.create(allocator, &names)
    if !xkb.parse(keymap, text.items[0..text.length]) { return 6 }
    if keymap.*.groupCount != 2 || xkb.keycodeOf(keymap, "AD01") != 24 { return 7 }
    var state: xkb_state.State = undefined
    xkb_state.init(&state, keymap)
    if xkb_state.modMask(keymap, "LevelThree") != xkb.MOD5 || xkb_state.modMask(keymap, "Alt") != xkb.MOD1 { return 8 }

    // q: Shift, AltGr, Shift+AltGr.
    if !types(&state, 24, "q") { return 20 }
    xkb_state.updateMask(&state, xkb.SHIFT, 0, 0, 0, 0, 0)
    if !types(&state, 24, "Q") || xkb_state.keyLevel(&state, 24, 0) != 1 { return 21 }
    xkb_state.updateMask(&state, xkb.MOD5, 0, 0, 0, 0, 0)
    if !types(&state, 24, "@") { return 22 }
    xkb_state.updateMask(&state, xkb.SHIFT | xkb.MOD5, 0, 0, 0, 0, 0)
    if !types(&state, 24, "Ω") { return 23 }
    // ä, Ä, Caps Lock (used by the key's type).
    xkb_state.updateMask(&state, 0, 0, 0, 0, 0, 0)
    if !types(&state, 48, "ä") { return 24 }
    xkb_state.updateMask(&state, 0, 0, xkb.LOCK, 0, 0, 0)
    if !types(&state, 48, "Ä") || xkb_state.consumedMods(&state, 48) & xkb.LOCK == 0 { return 25 }
    // Control: c is ^C, in the Russian group too (its Latin key).
    xkb_state.updateMask(&state, xkb.CONTROL, 0, 0, 0, 0, 0)
    var control_out: [4]u8 = undefined
    var control_bytes: [*]u8 = undefined
    unsafe { control_bytes = @ptrCast([*]u8, &control_out) }
    if xkb_state.keyUtf8(&state, 54, control_bytes, 4) != 1 || control_out[0] != 3 { return 26 }
    xkb_state.updateMask(&state, xkb.CONTROL, 0, 0, 0, 0, 1)
    if xkb_state.keyUtf8(&state, 54, control_bytes, 4) != 1 || control_out[0] != 3 { return 27 }
    // The second group: й.
    xkb_state.updateMask(&state, 0, 0, 0, 0, 0, 1)
    if !types(&state, 24, "й") || xkb_state.keyGroup(&state, 24) != 1 { return 28 }
    // The keypad: Home without Num Lock (no text), 7 with it.
    xkb_state.updateMask(&state, 0, 0, 0, 0, 0, 0)
    if !types(&state, 79, "") || xkb_state.keyOneSym(&state, 79) != 65429 { return 29 }
    xkb_state.updateMask(&state, 0, 0, xkb.MOD2, 0, 0, 0)
    if !types(&state, 79, "7") { return 30 }
    // Shift does not repeat; q does.
    if xkb_state.keyRepeats(keymap, 50) || !xkb_state.keyRepeats(keymap, 24) { return 31 }
    return 13
}
