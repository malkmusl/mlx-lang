// The kernel's stage 7 toward a Radeon that takes commands, its step V1
// (projects/brix/kernel/gpu_first_space.mlx) and the programs' address
// spaces as an interface (gpu_space.mlx, with the ring's submitIn and its
// faults in gpu_ring.mlx; built for the host), against the user's RX 580
// as a table whose memory controller translates a program's addresses as
// Linux's code counts on (tests/support/vm_card.mlx, under
// tests/support/mec_card.mlx's processors), after stages 0 to 6 passed,
// with the study's 2.3 to 2.6, 5.9 and 8.4 V1
// (gpu-accel-kernel.verified.md, and the source where the two differ:
// a page of the card's memory named by its offset in the card's memory)
// written out here a second time, write for write and bit for bit:
// - V1 on the user's card: address space 1 taken, its directory (128 KiB)
//   and one page table (8 KiB) in the pool from 2 MiB into the driver's
//   part; the directory entry (the table's card address | valid) and the
//   two table entries (the system page: its bus address | 0x77; the card
//   page: its offset in the card's memory | 0x71) bit for bit; the host
//   path flushed after each; the seven fault interrupts on in both control
//   words; three submissions on compute ring 0, each with the switch in
//   front word for word (the memory sync, the wait for the last fence, the
//   base register = the directory >> 12, VM_INVALIDATE_REQUEST 2, its wait,
//   the interrupt ring's number 0xffff for the first, the flush's fence),
//   the host path's flush, the buffer in address space 1, the invalidate,
//   the fence; the three buffers word for word; the two words written
//   through the space (one in the system's memory, one in the card's), the
//   fault at page 0x12345 (source 146, its entry with address space 1 and
//   the number, the status decoded: a write in address space 1), its words
//   cleared, the third buffer's word; then the space given back: the
//   entries 0, the tables back to the pool, the base register the GART's
//   table again, VM_INVALIDATE_REQUEST 2, the number as it was; the line;
//   no register of the display's;
// - V1's failures, each with the space given back and the fault
//   interrupts as before: no fault entry, a buffer passed over (no word), an
//   entry of the table that does not hold, the card gone; a processor that
//   stops at the fault (the ring hung, no new work): the space emptied and
//   kept, not given back, until the way down gives it back; the refusals
//   (no G5, a hung ring, no interrupt ring, the mark);
// - cards built to break V1: a flush that does nothing (its faults told to
//   the space before it goes, none to the next context that takes it), a
//   fault the ring took before the step (said first, not taken for the
//   step's), a status naming another space, a fault's entry 20 ms and
//   150 ms after its fence (the late one told to no context, not to the
//   context that holds the space by then);
// - the interface: open (not before the GART), take (1 to 7 in turn, the
//   eighth refused, a space given back taken again with its directory
//   cleared), every refusal of map and unmap, the entries bit for bit for
//   each kind of page and each right, a second table for another 4 MiB, the
//   directory entries, the pool given back whole; a context's pages mapped,
//   written through by a buffer, one unmapped and the buffer's write there
//   a fault told to that context and said; a fault of a space no context
//   holds; the graphics ring's frame for a program's buffer word for word
//   (the conditional executions and their counts, the pre-fetch parser's
//   sync, the double buffer switch, the vertex grouper's flush and the
//   context control of a context switch, the buffer switch after) and
//   without a context switch; every refusal of submitIn; the base
//   registers of spaces 1 to 15;
// - work in flight: a space not given back while a ring has not come to
//   its last fence there, not run on the graphics ring while compute ring
//   0 still has work in it, and, when its work cannot end, emptied and kept
//   until the way down; an entry without its valid bit (a fault told to
//   the context); a flood of 3000 faults (the wait ends, one line, the ring
//   goes on);
// - the way down: every space given back, the fault interrupts as found.
// With an argument the log of every case is printed.
// Exits 13.
const std = @import("std")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const loaded = @import("../projects/brix/kernel/gpu_smc_sdma.mlx")
const compute = @import("../projects/brix/kernel/gpu_compute.mlx")
const graphics = @import("../projects/brix/kernel/gpu_graphics.mlx")
const spaces = @import("../projects/brix/kernel/gpu_space.mlx")
const first = @import("../projects/brix/kernel/gpu_first_space.mlx")
const ring = @import("../projects/brix/kernel/gpu_ring.mlx")
const card = @import("./support/engine_card.mlx")
const smc = @import("./support/smc_card.mlx")
const mec = @import("./support/mec_card.mlx")
const vm = @import("./support/vm_card.mlx")
const crash = @import("std.crash")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn hex(value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(text[0..2 + digits])
}

fn shown() -> void {
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
}

const N = card.NEVER
const GART: usize = 0xFF00000000
const NOP: usize = 0xFFFF1000
const VRAM: usize = 0xF400000000
// The driver's part begins at 192 MiB of the aperture, the pool 2 MiB on.
const POOL: usize = 0xC200000
const FAULTS: usize = 0x249248

var e: engines.Engines = undefined
var l: loaded.Loaded = undefined
var c: compute.Compute = undefined
var g: graphics.Graphics = undefined
var s: spaces.Spaces = undefined
var f: first.FirstSpace = undefined
var where: engines.Card = undefined

fn fresh(stage: usize) -> void {
    mec.reset()
    card.picture(0, 1280, 960, 1800, 1000)
    card.registers[loaded.SMC_RESP_0] = 1
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = mec.hands()
    engines.begin(&e, &hands, &where, stage)
    const more = mec.more()
    loaded.begin(&l, &more)
    compute.begin(&c)
    graphics.begin(&g)
    spaces.begin(&s)
    first.begin(&f)
}

// Stages 0 to 6 at a boot that goes to stage 7.
fn upToG5() -> bool {
    fresh(7)
    engines.run(&e)
    compute.run(&e, &l, &c)
    return c.g4 == engines.Outcome.passed && graphics.graphicsRing(&e, &l, &c, &g)
}

fn boot(stage: usize) -> void {
    fresh(stage)
    engines.run(&e)
    first.run(&e, &l, &c, &g, &s, &f)
}

fn gart(physical: usize) -> usize { return GART + physical - card.DMA_BASE }

fn page() -> usize {
    const allocate = e.hands.dma
    return allocate(4096)
}

fn vramWord(at: usize) -> usize {
    const read = e.hands.vramRead
    return read(at)
}

fn setVram(at: usize, value: usize) -> void {
    const write = e.hands.vramWrite
    write(at, value)
}

// ---- The writes a step is wanted to make.

const WANT: usize = 256
var wantNumber: [WANT]usize = undefined
var wantValue: [WANT]usize = undefined
var wanted: usize = 0

fn want(number: usize, value: usize) -> void {
    wantNumber[wanted] = number
    wantValue[wanted] = value
    wanted += 1
}

fn writesAre(from: usize, what: []const u8) -> bool {
    const at = card.writesFrom(from, wantNumber[0..wanted], wantValue[0..wanted])
    if at == N { return true }
    say("the writes of ")
    say(what)
    say(" differ from the study's at write ")
    hex(at)
    if at < wanted {
        say(": wanted register ")
        hex(wantNumber[at])
        say(" = ")
        hex(wantValue[at])
    }
    if from + at < card.written && from + at < card.WRITES {
        say(", written register ")
        hex(card.writtenTo[from + at])
        say(" = ")
        hex(card.writtenWith[from + at])
    }
    say("\n")
    return false
}

fn wantCool(index: usize) -> void {
    want(engines.SMC_IND_INDEX_11, engines.ixCG_MULT_THERMAL_STATUS)
    want(engines.SMC_IND_INDEX_11, index)
}

fn wantAlive(was: usize) -> void {
    want(engines.SCRATCH_REG0, engines.SCRATCH_TRIAL)
    want(engines.SCRATCH_REG0, was)
}

fn memoryWord(at: usize) -> usize { return @intCast(usize, card.memoryRead(at)) }

fn memoryIs(at: usize, words: []const usize) -> bool {
    var k: usize = 0
    while k < words.length {
        if memoryWord(at + 4 * k) != words[k] {
            say("the word at ")
            hex(at + 4 * k)
            say(" is ")
            hex(memoryWord(at + 4 * k))
            say(", not ")
            hex(words[k])
            say("\n")
            return false
        }
        k += 1
    }
    return true
}

fn nopsFrom(at: usize, from: usize, to: usize) -> bool {
    var k = from
    while k < to {
        if memoryWord(at + 4 * k) != NOP { return false }
        k += 1
    }
    return true
}

fn writes(from: usize, number: usize) -> usize {
    var count: usize = 0
    var k = from
    while k < card.written && k < card.WRITES {
        if card.writtenTo[k] == number { count += 1 }
        k += 1
    }
    return count
}

// ---- A frame on compute ring 0 (amdgpu_ib_schedule with a job: the
// memory sync of the kernel's own buffer, amdgpu_vm_flush's part, the host
// path's flush, the buffer in its space, the invalidate, the fence).

var frame: [80]usize = undefined
var framed: usize = 0

fn put(word: usize) -> void {
    frame[framed] = word
    framed += 1
}

fn computeFrame(seq: usize, space: usize, directory: usize, pasid: usize, buffer: usize, length: usize) -> void {
    framed = 0
    const fence = gart(c.writeBack + 32 + 8)
    put(0xC0055800)
    put(0x28C40000)
    put(0xFFFFFFFF)
    put(0xFF)
    put(0)
    put(0)
    put(0xA)
    put(0xC0053C00)
    put(0x13)
    put(fence & 0xFFFFFFFC)
    put(fence >> 32)
    put(seq)
    put(0xFFFFFFFF)
    put(4)
    put(0xC0033700)
    put(0x100000)
    put(0x550 + space - 1)
    put(0)
    put(directory >> 12)
    put(0xC0033700)
    put(0x100000)
    put(0x51E)
    put(0)
    put(@intCast(usize, 1) << @intCast(u6, space))
    put(0xC0053C00)
    put(0)
    put(0x51E)
    put(0)
    put(0)
    put(0)
    put(0x20)
    if pasid != N {
        put(0xC0033700)
        put(0x100000)
        put(0xE00 + space)
        put(0)
        put(pasid)
    }
    put(0xC0054900)
    put(0x38514)
    put(0x22000000)
    put(fence & 0xFFFFFFFC)
    put(fence >> 32)
    put(seq + 1)
    put(0)
    put(0xC0053C00)
    put(0x43)
    put(0x1537)
    put(0x1538)
    put(4)
    put(4)
    put(0x20)
    put(0xC0023F00)
    put(buffer & 0xFFFFFFFC)
    put((buffer >> 32) & 0xFFFF)
    put(0x800000 | length | (space << 24))
    put(0xC0033700)
    put(0x100000)
    put(0xBCC)
    put(0)
    put(1)
    put(0xC0054900)
    put(0x38514)
    put(0x22000000)
    put(fence & 0xFFFFFFFC)
    put(fence >> 32)
    put(seq + 2)
    put(0)
}

// ---- V1.

fn theFirstSpace() -> void {
    expect(upToG5(), "stages 0 to 6 at a boot of stage 7")
    card.interruptsOn = true
    card.waitingMessage = false
    const from = card.written
    const index = card.registers[engines.SMC_IND_INDEX_11]
    const control0 = card.registers[engines.VM_CONTEXT0_CNTL]
    const control1 = card.registers[engines.VM_CONTEXT1_CNTL]
    const cntl2 = card.registers[engines.VM_CONTEXT1_CNTL2]
    const ring0 = card.registers[0x306A]
    const placeholder = card.registers[0x550]
    const pointer = e.readPointer
    const at = c.compute.wptr
    const ran = mec.spacesCount
    expect(placeholder == e.table >> 12 && control1 & FAULTS == 0, "address space 1's base register the GART's table (M2's placeholder), no fault interrupt on")
    expect(first.firstSpace(&e, &l, &c, &g, &s, &f), "V1 on the user's card")
    shown()
    const directory = VRAM + POOL
    const table = POOL + 0x20000
    const cardPage = POOL + 0x22000
    wanted = 0
    wantCool(index)
    want(0x1520, 1)
    want(0x1520, 1)
    want(engines.VM_CONTEXT0_CNTL, control0 | FAULTS)
    want(engines.VM_CONTEXT1_CNTL, control1 | FAULTS)
    want(0x306A, ring0 | 0xC00000)
    want(engines.IH_RB_RPTR, (pointer + 32) & 0xFFFF)
    want(engines.VM_CONTEXT1_CNTL2, cntl2 | 1)
    want(engines.IH_RB_RPTR, (pointer + 80) & 0xFFFF)
    want(engines.IH_RB_RPTR, (pointer + 112) & 0xFFFF)
    want(0x1520, 1)
    want(0x1520, 1)
    want(0x550, placeholder)
    want(0x51E, 2)
    want(0xE01, 0)
    wantCool(index)
    wantAlive(card.registers[engines.SCRATCH_REG0])
    expect(writesAre(from, "V1"), "V1 write for write: the host path flushed after each entry, the fault interrupts on, the interrupt ring's read pointer at each wait, the fault's words cleared, the entries unmapped, the base register back and flushed, the number back")
    // The tables (still in the card's memory where the pool gave them).
    expect(vramWord(POOL + 0x100 * 8) == (VRAM + table) | 1, "the directory entry 0x100 (0x40000000 >> 22): the table's card address | valid (amdgpu_gmc_get_pde_for_bo)")
    var k: usize = 0
    var others = false
    while k < 16384 {
        if k != 0x100 && vramWord(POOL + k * 8) != 0 { others = true }
        k += 1
    }
    expect(!others, "no other directory entry")
    expect(f.systemEntry == (f.system & 0xFFFFFFFFFF000) | 0x77 && f.cardEntry == cardPage | 0x71, "the two table entries bit for bit: the system page's bus address | valid, system, snooped, executable, readable, writeable; the card page's offset in the card's memory | valid, executable, readable, writeable (amdgpu_vm_update_range: vram_base_offset 0)")
    expect(vramWord(table) == 0 && vramWord(table + 8) == 0, "both entries 0 again (unmapped)")
    // The three submissions word for word.
    computeFrame(1, 1, directory, 0xFFFF, first.SYSTEM_AT, 10)
    expect(memoryIs(c.rings[1] + at * 4, frame[0..framed]) && framed == 66 && nopsFrom(c.rings[1], at + 66, at + 256), "the first submission: 66 words (the switch with the number 0xffff), then NOPs to 256")
    computeFrame(3, 1, directory, N, first.SYSTEM_AT + 0x100, 5)
    expect(memoryIs(c.rings[1] + (at + 256) * 4, frame[0..framed]) && framed == 61, "the second: 61 words (no number: told already)")
    computeFrame(5, 1, directory, N, first.SYSTEM_AT + 0x200, 5)
    expect(memoryIs(c.rings[1] + (at + 512) * 4, frame[0..framed]), "the third")
    // The buffers.
    const firstWords = [_]usize{ 0xC0033700, 0x00100500, 0x40000800, 0, 0x71770001, 0xC0033700, 0x00100500, 0x40001000, 0, 0x71770002 }
    const secondWords = [_]usize{ 0xC0033700, 0x00100500, 0x12345000, 0, 0x717700FF }
    const thirdWords = [_]usize{ 0xC0033700, 0x00100500, 0x40000804, 0, 0x71770003 }
    expect(memoryIs(f.system, firstWords[0..]) && memoryIs(f.system + 0x100, secondWords[0..]) && memoryIs(f.system + 0x200, thirdWords[0..]), "the three buffers word for word")
    expect(memoryWord(f.system + 0x800) == 0x71770001 && vramWord(cardPage) & 0xFFFFFFFF == 0x71770002 && memoryWord(f.system + 0x804) == 0x71770003, "the words written through address space 1: the system's page, the card's page, the third buffer's")
    expect(mec.spacesCount == ran + 3 && mec.spacesRun[ran] == 1 && mec.spacesRun[ran + 1] == 1 && mec.spacesRun[ran + 2] == 1, "three buffers run in address space 1")
    expect(vm.flushes[1] == 4 && vm.faults == 1 && vm.faultEntries == 1, "address space 1 flushed by each submission (and once more as it was given back), one fault, its entry")
    expect(f.faults == 1 && f.source == 146 && f.page == 0x12345 && f.status == 0x3042001 && spaces.faultSpace(f.status) == 1 && spaces.faultWrote(f.status) && spaces.faultClientId(f.status) == 0x42 && f.client == 0x43504320, "the fault: source 146, page 0x12345, status 0x3042001 (protections 0x1, client 0x42, a write, address space 1), client CPC")
    expect(card.registers[engines.VM_CONTEXT1_PROTECTION_FAULT_STATUS] == 0 && card.registers[engines.VM_CONTEXT1_PROTECTION_FAULT_ADDR] == 0, "its words cleared for the next")
    expect(c.compute.done == 7 && !c.compute.hung, "fences 2 to 7, the ring goes on")
    expect(card.registers[0x550] == placeholder && card.registers[0xE01] == 0 && !spaces.held(&s, 1) && spaces.poolTaken(&s) == 0, "the space given back: base register, number, pool")
    expect(card.registers[engines.VM_CONTEXT1_CNTL] & FAULTS == FAULTS && card.registers[engines.VM_CONTEXT0_CNTL] & FAULTS == FAULTS && card.registers[0x306A] & 0xC00000 == 0xC00000 && f.enabled, "the fault interrupts stay on, the graphics block's two (a privileged register or instruction) with them")
    line("gpu: a fault in address space 1 (the kernel's own): page 0x12345, a write, protections 0x1, client \"CPC \" (0x42); status 0x3042001; source 146 (no valid entry)\n")
    line("gpu: step V1: address space 1 (directory at 0xf40c200000, one page table): a page of the system's memory at 0x40000000 (entry ")
    line(") and one of the card's at 0x40001000 (entry 0xc222071) written through it on compute ring 0 (fence 3); an unmapped write faulted as it should (page 0x12345, a write, protections 0x1, client \"CPC \" (0x42); status 0x3042001; source 146 (no valid entry)); the ring went on (fence 7); the space given back, its base register the GART's table again; the fault interrupts stay on; 41 C before, 41 C after; picture ")
    expect(card.displayWrites(from) == 0, "nothing of the display's")
}

fn v1FailsWith(text: []const u8, what: []const u8) -> void {
    const control0 = card.registers[engines.VM_CONTEXT0_CNTL]
    const control1 = card.registers[engines.VM_CONTEXT1_CNTL]
    const ring0 = card.registers[0x306A]
    const placeholder = card.registers[0x550]
    const from = card.written
    const passed = first.firstSpace(&e, &l, &c, &g, &s, &f)
    shown()
    expect(!passed && f.v1 == engines.Outcome.failed, what)
    expect(card.registers[engines.VM_CONTEXT0_CNTL] == control0 && card.registers[engines.VM_CONTEXT1_CNTL] == control1 && card.registers[0x306A] == ring0 && !f.enabled, "the fault interrupts as before, the graphics block's too")
    expect(card.registers[0x550] == placeholder && !spaces.held(&s, 1) && spaces.poolTaken(&s) == 0, "the space given back, its base register the GART's table, the pool whole")
    line(text)
    line("; the address space given back, its base register the GART's table again, the fault interrupts as before (")
    expect(card.displayWrites(from) == 0, "nothing of the display's")
}

// V1 failed with its work not ended (a ring hung in the space): the space
// emptied and kept, not given back (its base register still its directory,
// the directory still naming its table, every table entry 0, its 35 pages
// out of the pool, nothing more mapped, run or handed out in it), its fault
// told to it, the fault interrupts as before; the way down gives it back.
fn v1Kept(text: []const u8, what: []const u8) -> void {
    const control0 = card.registers[engines.VM_CONTEXT0_CNTL]
    const control1 = card.registers[engines.VM_CONTEXT1_CNTL]
    const placeholder = card.registers[0x550]
    const from = card.written
    const passed = first.firstSpace(&e, &l, &c, &g, &s, &f)
    shown()
    expect(!passed && f.v1 == engines.Outcome.failed, what)
    expect(card.registers[engines.VM_CONTEXT0_CNTL] == control0 && card.registers[engines.VM_CONTEXT1_CNTL] == control1 && !f.enabled, "the fault interrupts as before")
    const table = POOL + 0x20000
    expect(spaces.held(&s, 1) && s.kept[1] && f.kept && card.registers[0x550] == (VRAM + POOL) >> 12 && vramWord(POOL + 0x100 * 8) == (VRAM + table) | 1 && vramWord(table) == 0 && vramWord(table + 8) == 0 && spaces.poolTaken(&s) == 35, "the space emptied and kept: its base register its directory, the directory naming its table, every table entry 0, its 35 pages out of the pool")
    expect(writes(from, 0x550) == 0 && writes(from, 0x51E) == 1, "its base register not written by the driver, the space flushed once by register (emptied)")
    expect(s.faults[1] == 1 && s.faultPage[1][0] == 0x12345 && c.compute.spaceFaults == 0, "its fault told to it, none left on the ring")
    expect(spaces.map(&e, &s, 1, 0x40002000, spaces.Memory.system, page(), spaces.READ) == spaces.Mapped.kept && spaces.unmap(&e, &s, 1, first.SYSTEM_AT) == spaces.Mapped.kept && spaces.submit(&e, &l, &s, &c.graphics, 1, first.SYSTEM_AT, 5, false) == spaces.NONE && spaces.give(&e, &s, 1) == spaces.NONE, "nothing more mapped, unmapped, run or given back in it")
    expect(spaces.take(&e, &s, 5) == 2, "it is handed to no context")
    line(text)
    line("; the address space emptied and kept until the way down (its work did not end), the fault interrupts as before (")
    line("gpu: a fault in address space 1 (the kernel's own): page 0x12345, a write")
    expect(card.displayWrites(from) == 0, "nothing of the display's")
    first.stop(&e, &l, &c, &g, &s, &f)
    shown()
    expect(!spaces.held(&s, 1) && !spaces.held(&s, 2) && card.registers[0x550] == placeholder && spaces.poolTaken(&s) == 0 && !f.kept, "the way down gives it back, the processors halted: its base register the GART's table, the pool whole")
    line("gpu: the address spaces on the way down: 2 given back, the fault interrupts as found\n")
}

// Cards built to break V1: a flush that does nothing, a fault the ring took
// before the step, a fault whose status names another address space.
fn theFirstSpaceCards() -> void {
    // The flush does nothing: the first buffer's words fault as it is read
    // (no directory yet), its fault told to the space before the space
    // goes, so that the next context to take space 1 is told nothing of
    // V1's.
    expect(upToG5(), "stages 0 to 6")
    vm.flushIgnored = true
    v1FailsWith("gpu: step V1 failed: the system's page was not written through the address space: its word reads 0xcafedead", "a flush that does nothing")
    line("gpu: a fault in address space 1 (the kernel's own): page 0x40000, a read, protections 0x1, client \"CPC \" (0x42); status 0x2042001; source 146 (no valid entry)\n")
    expect(c.compute.spaceFaults == 0, "no fault of V1's left on the ring")
    vm.flushIgnored = false
    expect(spaces.take(&e, &s, 5) == 1 && spaces.collect(&e, &s, &c.compute) == 0 && s.faults[1] == 0, "the context that takes space 1 next is told no fault of V1's")
    // A fault the ring took before the step: said first, not taken for the
    // step's.
    expect(upToG5(), "stages 0 to 6")
    c.compute.spacePage[0] = 0x777
    c.compute.spaceStatus[0] = 0x6000010
    c.compute.spaceClient[0] = vm.CLIENT
    c.compute.spaceSource[0] = 147
    c.compute.spaceFaults = 1
    expect(first.firstSpace(&e, &l, &c, &g, &s, &f) && f.page == 0x12345 && f.source == 146 && f.faults == 1, "V1 passes with its own fault, not the one the ring took before")
    shown()
    line("gpu: a fault in address space 3 (held by no context): page 0x777, a read, protections 0x10, client \"CPC \" (0x0); status 0x6000010; source 147 (not allowed)\n")
    expect(card.after("gpu: a fault in address space 3", 0) < card.after("gpu: a fault in address space 1", 0), "said before the step's own")
    // The status names address space 2: no fault of space 1's.
    expect(upToG5(), "stages 0 to 6")
    vm.statusSpace = 2
    v1FailsWith("gpu: step V1 failed: the fault's status does not say a write in the address space: 0x5042001", "a fault whose status names address space 2")
    line("gpu: a fault in address space 2 (held by no context): page 0x12345, a write, protections 0x1, client \"CPC \" (0x42); status 0x5042001; source 146 (no valid entry)\n")
    expect(s.stray == 1 && s.faults[1] == 0, "told to no context")
    // A fault's entry 20 ms after its buffer's fence: waited for.
    expect(upToG5(), "stages 0 to 6")
    vm.entryLate = 20000
    expect(first.firstSpace(&e, &l, &c, &g, &s, &f) && f.page == 0x12345 && f.faults == 1, "a fault's entry 20 ms after the fence: waited for")
    // 150 ms after: V1 fails, the space is given back and taken by context 5;
    // the entry comes then, with the kernel's number: told to no context,
    // not to context 5.
    expect(upToG5(), "stages 0 to 6")
    vm.entryLate = 150000
    v1FailsWith("gpu: step V1 failed: the write where nothing is mapped raised no fault within 100 ms after its fence", "a fault's entry 150 ms after the fence")
    const space = spaces.take(&e, &s, 5)
    card.clock += 100000000
    vm.tick()
    ring.entries(&e, &l, &c.compute)
    expect(space == 1 && spaces.collect(&e, &s, &c.compute) == 1 && s.faults[1] == 0 && s.stray == 1, "the late entry (V1's, its number the kernel's) told to no context, not to context 5 that holds space 1 now")
    line("gpu: a fault in address space 1 (not its holder's: the fault's number is 0xffff): page 0x12345, a write")
    // The base registers of the fifteen spaces (gmc_v8_0_emit_flush_gpu_tlb).
    expect(ring.baseRegister(1) == 0x550 && ring.baseRegister(7) == 0x556 && ring.baseRegister(8) == 0x50E && ring.baseRegister(15) == 0x515, "spaces 1 to 7 from VM_CONTEXT0_PAGE_TABLE_BASE_ADDR, 8 to 15 from VM_CONTEXT8_PAGE_TABLE_BASE_ADDR")
}

fn theFirstSpaceFailures() -> void {
    expect(upToG5(), "stages 0 to 6")
    vm.noFaultEntry = true
    v1FailsWith("gpu: step V1 failed: the write where nothing is mapped raised no fault within 100 ms after its fence", "no fault entry")
    expect(upToG5(), "stages 0 to 6")
    vm.faultHangs = true
    v1Kept("gpu: step V1 failed: the buffer that writes where nothing is mapped did not end: the ring is hung: its read pointer did not move in 1000 ms; read pointer", "a processor that stops at the fault")
    expect(c.compute.hung, "compute ring 0 takes no new work")
    line(" registers); compute ring 0 takes no new work")
    expect(upToG5(), "stages 0 to 6")
    mec.bufferSkipped = true
    v1FailsWith("gpu: step V1 failed: the system's page was not written through the address space: its word reads 0xcafedead", "a buffer passed over")
    expect(upToG5(), "stages 0 to 6")
    card.badWord = POOL + 0x20000
    v1FailsWith("gpu: step V1 failed: the system's page could not be mapped (a table entry does not hold what was written)", "a table entry that does not hold")
    expect(upToG5(), "stages 0 to 6")
    card.badWord = POOL + 0x100
    const at = card.written
    expect(!first.firstSpace(&e, &l, &c, &g, &s, &f), "a directory that does not clear")
    line("gpu: step V1 failed: no address space could be taken (none free, or its directory does not hold in the card's memory)")
    expect(writes(at, engines.VM_CONTEXT1_CNTL) == 0, "nothing turned on")
    // The card gone in the first wait.
    expect(upToG5(), "stages 0 to 6")
    card.goneAt = engines.VM_CONTEXT1_CNTL
    expect(!first.firstSpace(&e, &l, &c, &g, &s, &f) && f.v1 == engines.Outcome.failed, "the card gone")
    line("gpu: step V1 failed: the card no longer answers as it did")
    // The refusals.
    fresh(7)
    engines.run(&e)
    compute.run(&e, &l, &c)
    var written = card.written
    expect(!first.firstSpace(&e, &l, &c, &g, &s, &f) && f.v1 == engines.Outcome.refused && card.written == written, "no G5: refused, nothing written")
    line("gpu: step V1 refused: the graphics ring is not proved (step G5), or compute ring 0 does not run\n")
    expect(upToG5(), "stages 0 to 6")
    c.compute.hung = true
    written = card.written
    expect(!first.firstSpace(&e, &l, &c, &g, &s, &f) && f.v1 == engines.Outcome.refused && card.written == written, "a hung ring: refused")
    line("gpu: step V1 refused: compute ring 0 takes no new work now (the temperature's mark, or it did not come to a fence)\n")
    expect(upToG5(), "stages 0 to 6")
    e.ringUp = false
    expect(!first.firstSpace(&e, &l, &c, &g, &s, &f) && f.v1 == engines.Outcome.refused, "no interrupt ring: refused")
    line("gpu: step V1 refused: the interrupt ring does not run (a fault's entry could not come)\n")
    expect(upToG5(), "stages 0 to 6")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 87 << 9)
    expect(!first.firstSpace(&e, &l, &c, &g, &s, &f) && f.v1 == engines.Outcome.refused, "87 C: refused")
    line("gpu: step V1 refused: the card is at 87 C (no step begins at 85 C or more)\n")
}

// ---- The interface.

fn theInterface() -> void {
    // Not before the GART.
    fresh(0)
    engines.run(&e)
    expect(!spaces.open(&e, &s) && spaces.take(&e, &s, 3) == spaces.NONE, "stage 0: the interface does not open, nothing is taken")
    expect(spaces.map(&e, &s, 1, 0x40000000, spaces.Memory.system, card.DMA_BASE, spaces.READ) == spaces.Mapped.not_open, "map before open: not open")
    expect(upToG5(), "stages 0 to 6")
    expect(spaces.open(&e, &s) && s.pool == POOL && s.placeholder == e.table, "open: the pool at 2 MiB into the driver's part")
    expect(spaces.pasidOf(3) == 4 && spaces.pasidOf(spaces.KERNEL) == 0xFFFF, "the numbers of the faults: context + 1, the kernel's 0xffff")
    // Take 1 to 7 in turn, the eighth refused; give 3 back and take it again.
    setVram(POOL + 0x60000 + 8, 0x12345678)
    var n: usize = 1
    while n <= 7 {
        expect(spaces.take(&e, &s, 10 + n) == n, "spaces taken in turn")
        n += 1
    }
    expect(spaces.take(&e, &s, 20) == spaces.NONE, "the eighth refused (8 to 15 kept back)")
    expect(vramWord(POOL + 0x60000 + 8) == 0 && s.directory[4] == POOL + 0x60000, "a directory cleared as it is taken")
    expect(spaces.poolTaken(&s) == 7 * 32, "seven directories of 32 pages")
    _ = spaces.give(&e, &s, 3)
    expect(!spaces.held(&s, 3) && spaces.take(&e, &s, 21) == 3 && s.owner[3] == 21, "3 given back and taken again")
    n = 1
    while n <= 7 {
        _ = spaces.give(&e, &s, n)
        n += 1
    }
    expect(spaces.poolTaken(&s) == 0, "the pool whole again")
    // A context's space and its pages.
    const context: usize = 5
    const space = spaces.take(&e, &s, context)
    expect(space == 1, "context 5's space: 1")
    const sys = page()
    const sys2 = page()
    var from = card.written
    expect(spaces.map(&e, &s, space, 0x200000, spaces.Memory.system, sys, spaces.READ | spaces.WRITE) == spaces.Mapped.done, "a system page at 2 MiB, read and write")
    expect(writes(from, 0x1520) == 1, "the host path flushed")
    expect(spaces.entry(&e, &s, space, 0x200000) == (sys | 0x67) && s.tables[space] == 1, "its entry: bus address | valid, system, snooped, readable, writeable (0x67)")
    expect(spaces.directoryEntry(&e, &s, space, 0) == (VRAM + s.directory[space] + 0x20000) | 1, "directory entry 0: its table's card address | valid")
    expect(spaces.map(&e, &s, space, 0x201000, spaces.Memory.write_combined, sys2, spaces.READ) == spaces.Mapped.done && spaces.entry(&e, &s, space, 0x201000) == (sys2 | 0x23), "a write-combined page, read only: 0x23 (no snooped, no write)")
    expect(spaces.map(&e, &s, space, 0x202000, spaces.Memory.card, 0x7000000, spaces.READ | spaces.WRITE) == spaces.Mapped.done && spaces.entry(&e, &s, space, 0x202000) == (0x7000000 | 0x61), "a page of the card's memory, read and write: its offset in the card's memory | 0x61")
    expect(spaces.map(&e, &s, space, 0x203000, spaces.Memory.card, 0x7001000, spaces.EXECUTE) == spaces.Mapped.done && spaces.entry(&e, &s, space, 0x203000) == (0x7001000 | 0x11), "executable alone: 0x11")
    expect(spaces.map(&e, &s, space, 0xFFFFFF000, spaces.Memory.system, 0xFFFFFFF000, spaces.READ | spaces.WRITE | spaces.EXECUTE) == spaces.Mapped.done && spaces.entry(&e, &s, space, 0xFFFFFF000) == 0xFFFFFFF077 && s.tables[space] == 2, "the top page of the 64 GiB in a second table, the highest bus address of 40 bits: bits 39:12 of the address")
    expect(spaces.directoryEntry(&e, &s, space, 0x3FFF) == (VRAM + s.directory[space] + 0x22000) | 1, "directory entry 0x3fff for it")
    // Every refusal.
    expect(spaces.map(&e, &s, 2, 0x200000, spaces.Memory.system, sys, spaces.READ) == spaces.Mapped.not_taken, "a space nobody holds")
    expect(spaces.map(&e, &s, space, 0x200800, spaces.Memory.system, sys, spaces.READ) == spaces.Mapped.not_on_a_page && spaces.map(&e, &s, space, 0x204000, spaces.Memory.system, sys + 8, spaces.READ) == spaces.Mapped.not_on_a_page && spaces.map(&e, &s, space, 0x204000, spaces.Memory.system, sys, 8) == spaces.Mapped.not_on_a_page, "not on a page, flags beyond 7")
    expect(spaces.map(&e, &s, space, 0x1FF000, spaces.Memory.system, sys, spaces.READ) == spaces.Mapped.reserved, "the bottom 2 MiB")
    expect(spaces.map(&e, &s, space, 0x1000000000, spaces.Memory.system, sys, spaces.READ) == spaces.Mapped.beyond, "at 64 GiB: beyond")
    expect(spaces.map(&e, &s, space, 0x204000, spaces.Memory.system, 0x10000000000, spaces.READ) == spaces.Mapped.unreachable && spaces.map(&e, &s, space, 0x204000, spaces.Memory.card, 0x200000000, spaces.READ) == spaces.Mapped.unreachable, "a bus address of 41 bits, a page past the card's 8 GiB")
    expect(spaces.map(&e, &s, space, 0x204000, spaces.Memory.card, 0xC000000, spaces.READ) == spaces.Mapped.driver_part && spaces.map(&e, &s, space, 0x204000, spaces.Memory.card, POOL, spaces.READ) == spaces.Mapped.driver_part, "the driver's part (the GART's table, the pool) refused to a program")
    expect(spaces.map(&e, &s, space, 0x200000, spaces.Memory.system, sys2, spaces.READ) == spaces.Mapped.already, "mapped already")
    expect(spaces.unmap(&e, &s, space, 0x205000) == spaces.Mapped.nothing_there && spaces.unmap(&e, &s, space, 0x40000000) == spaces.Mapped.nothing_there, "nothing there (no entry; no table)")
    expect(std.string.eql(std.string.fromSlice(spaces.mappedWords(spaces.Mapped.driver_part)), std.string.fromSlice("the driver's part of the card's memory")), "a refusal in words")
    // A buffer of the context writes to its pages; one unmapped, the write
    // there is a fault told to the context.
    smc.memoryWrite(sys2, 0xC0033700)
    smc.memoryWrite(sys2 + 4, 0x00100500)
    smc.memoryWrite(sys2 + 8, 0x200010)
    smc.memoryWrite(sys2 + 12, 0)
    smc.memoryWrite(sys2 + 16, 0x5A5A0001)
    smc.memoryWrite(sys2 + 20, 0xC0033700)
    smc.memoryWrite(sys2 + 24, 0x00100500)
    smc.memoryWrite(sys2 + 28, 0x202010)
    smc.memoryWrite(sys2 + 32, 0)
    smc.memoryWrite(sys2 + 36, 0x5A5A0002)
    card.registers[engines.VM_CONTEXT1_CNTL] |= FAULTS
    var fence = spaces.submit(&e, &l, &s, &c.compute, space, 0x201000, 10, false)
    expect(fence != spaces.NONE && ring.wait(&e, &l, &c.compute, fence, true, 1000) == ring.Waited.done, "the context's buffer runs")
    expect(memoryWord(sys + 0x10) == 0x5A5A0001 && vramWord(0x7000010) & 0xFFFFFFFF == 0x5A5A0002 && c.compute.spaceFaults == 0, "both its words through the space, no fault")
    expect(card.registers[0xE01] == 6, "the interrupt ring's number for space 1: context 5's 6")
    expect(spaces.unmap(&e, &s, space, 0x202000) == spaces.Mapped.done && spaces.entry(&e, &s, space, 0x202000) == 0 && s.pages[space] == 4, "the card page unmapped: its entry 0")
    fence = spaces.submit(&e, &l, &s, &c.compute, space, 0x201000, 10, false)
    expect(fence != spaces.NONE && ring.wait(&e, &l, &c.compute, fence, true, 1000) == ring.Waited.done, "again: the ring goes on")
    expect(spaces.collect(&e, &s, &c.compute) == 1 && s.faults[space] == 1 && s.faultPage[space][0] == 0x202 && spaces.faultWrote(s.faultStatus[space][0]), "the write to the unmapped page a fault told to context 5's space")
    line("gpu: a fault in address space 1 (context 5): page 0x202, a write, protections 0x1, client \"CPC \" (0x42); status 0x3042001; source 146 (no valid entry)\n")
    // A fault of a space no context holds.
    c.compute.spacePage[0] = 0x777
    c.compute.spaceStatus[0] = 0x6000010
    c.compute.spaceClient[0] = 0x54435000
    c.compute.spaceSource[0] = 147
    c.compute.spaceFaults = 1
    expect(spaces.collect(&e, &s, &c.compute) == 1 && s.stray == 1, "a fault of address space 3, held by no context")
    line("gpu: a fault in address space 3 (held by no context): page 0x777, a read, protections 0x10, client \"TCP.\" (0x0); status 0x6000010; source 147 (not allowed)\n")
    // The context's space given back.
    const placeholder = e.table >> 12
    from = card.written
    expect(spaces.give(&e, &s, space) == 2 && card.registers[0x550] == placeholder && card.registers[0xE01] == 0 && spaces.poolTaken(&s) == 0, "given back: two tables, the base register, the number, the pool")
    expect(writes(from, 0x51E) == 1 && card.writtenWith[from + 1] == 2, "and the flush asked for space 1")
}

// The graphics ring's frame for a program's buffer.
fn theGraphicsFrame() -> void {
    expect(upToG5(), "stages 0 to 6")
    expect(spaces.open(&e, &s), "open")
    const space = spaces.take(&e, &s, 9)
    const sys = page()
    expect(spaces.map(&e, &s, space, 0x300000, spaces.Memory.system, sys, spaces.READ | spaces.WRITE | spaces.EXECUTE) == spaces.Mapped.done, "a page")
    smc.memoryWrite(sys, 0xC0033700)
    smc.memoryWrite(sys + 4, 0x00100500)
    smc.memoryWrite(sys + 8, 0x300100)
    smc.memoryWrite(sys + 12, 0)
    smc.memoryWrite(sys + 16, 0x6B6B0001)
    const r = &c.graphics
    const at = r.*.wptr
    const seq = r.*.sent
    var fence = spaces.submit(&e, &l, &s, r, space, 0x300000, 5, false)
    expect(fence == seq + 2 && ring.wait(&e, &l, r, fence, true, 1000) == ring.Waited.done && memoryWord(sys + 0x100) == 0x6B6B0001, "the program's buffer on the graphics ring")
    const cond = gart(c.writeBack + 64 + 16)
    const back = gart(c.writeBack + 64 + 8)
    const directory = VRAM + s.directory[space]
    const words = [_]usize{ 0xC0032200, cond & 0xFFFFFFFF, cond >> 32, 0, 43, 0xC0053C00, 0x113, back & 0xFFFFFFFC, back >> 32, seq, 0xFFFFFFFF, 4, 0xC0033700, 0x40100000, 0x550, 0, directory >> 12, 0xC0033700, 0x40100000, 0x51E, 0, 2, 0xC0053C00, 0, 0x51E, 0, 0, 0, 0x20, 0xC0004200, 0, 0xC0033700, 0x40100000, 0xE01, 0, 10, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x20000000, seq, 0, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x22000000, seq + 1, 0, 0xC0008B00, 0, 0xC0008B00, 0, 0xC0032200, cond & 0xFFFFFFFF, cond >> 32, 0, 35, 0xC0053C00, 0x143, 0x1537, 0x1538, 1, 1, 0x20, 0xC0004600, 0x40F, 0xC0004600, 0x24, 0xC0012800, 0x81018003, 0, 0xC0023F00, 0x300000, 0, 0x1000005, 0xC0033700, 0x40100000, 0xBCC, 0, 1, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x20000000, seq + 1, 0, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x22000000, seq + 2, 0, 0xC0008B00, 0 }
    expect(memoryIs(c.rings[2] + at * 4, words[0..]) && words.length == 94 && nopsFrom(c.rings[2], at + 94, at + 256), "the graphics ring's frame of 94 words word for word (a context switch: the vertex grouper's flush, CONTEXT_CONTROL 0x81018003), NOPs to 256")
    // The same context again: no context switch.
    const again = r.*.wptr
    fence = spaces.submit(&e, &l, &s, r, space, 0x300000, 5, false)
    expect(fence == seq + 4 && memoryWord(c.rings[2] + (again + 59) * 4) == 0xC0012800 && memoryWord(c.rings[2] + (again + 60) * 4) == 0x80000000 && memoryWord(c.rings[2] + (again + 31) * 4) == 0xC0044700, "the same context again: no vertex grouper's flush, CONTEXT_CONTROL 0x80000000, the number not told again")
    // The kernel's own buffer in between: the next is a context switch again.
    _ = ring.submit(&e, &l, r, gart(c.buffers + 256), 5, 0)
    expect(r.*.context == ring.NONE, "the kernel's own buffer: no context's")
    // submitIn's refusals.
    var sw = spaces.switchOf(&s, space, false)
    const before = r.*.wptr
    sw.space = 0
    expect(ring.submitIn(&e, &l, r, 0x300000, 5, &sw) == ring.NONE, "address space 0")
    sw.space = 16
    expect(ring.submitIn(&e, &l, r, 0x300000, 5, &sw) == ring.NONE, "address space 16")
    sw = spaces.switchOf(&s, space, false)
    sw.directory = directory + 8
    expect(ring.submitIn(&e, &l, r, 0x300000, 5, &sw) == ring.NONE, "a directory not on a page")
    sw.directory = 0x10000000000
    expect(ring.submitIn(&e, &l, r, 0x300000, 5, &sw) == ring.NONE, "a directory beyond 40 bits")
    sw = spaces.switchOf(&s, space, false)
    sw.pasid = 0x10000
    expect(ring.submitIn(&e, &l, r, 0x300000, 5, &sw) == ring.NONE, "a number beyond 16 bits")
    sw = spaces.switchOf(&s, space, false)
    expect(ring.submitIn(&e, &l, r, 0x300000, 0, &sw) == ring.NONE && ring.submitIn(&e, &l, r, 0x300000, 0x100000, &sw) == ring.NONE && ring.submitIn(&e, &l, r, 0x300002, 5, &sw) == ring.NONE && ring.submitIn(&e, &l, r, 0x1000000000000, 5, &sw) == ring.NONE, "no words, more than 20 bits of them, an address off 4 bytes or beyond 48 bits")
    expect(ring.submitIn(&e, &l, &c.kiq, 0x300000, 5, &sw) == ring.NONE, "the KIQ")
    r.*.refused = true
    expect(ring.submitIn(&e, &l, r, 0x300000, 5, &sw) == ring.NONE, "a refused ring")
    r.*.refused = false
    expect(r.*.wptr == before, "nothing written by any refusal")
    expect(spaces.submit(&e, &l, &s, r, 6, 0x300000, 5, false) == spaces.NONE, "a space nobody holds")
}

// One write of `value` to card address `to` of a space, as a buffer's five
// words at `at` of a page of the system's memory.
fn writeAt(at: usize, to: usize, value: usize) -> void {
    smc.memoryWrite(at, 0xC0033700)
    smc.memoryWrite(at + 4, 0x00100500)
    smc.memoryWrite(at + 8, @intCast(u32, to & 0xFFFFFFFF))
    smc.memoryWrite(at + 12, @intCast(u32, to >> 32))
    smc.memoryWrite(at + 16, @intCast(u32, value))
}

// A program's work in flight: a space is given back only once every ring
// has come to its last fence there, runs on one ring at a time (this card
// flushes no space another engine still uses), and when its work cannot end
// it is emptied and kept until the way down.
fn theWorkInFlight() -> void {
    expect(upToG5(), "stages 0 to 6")
    expect(spaces.open(&e, &s), "open")
    const space = spaces.take(&e, &s, 6)
    const sys = page()
    expect(spaces.map(&e, &s, space, 0x300000, spaces.Memory.system, sys, spaces.READ | spaces.WRITE | spaces.EXECUTE) == spaces.Mapped.done, "a page")
    writeAt(sys, 0x300100, 0x6B6B0001)
    mec.ringDeaf = true
    const fence = spaces.submit(&e, &l, &s, &c.compute, space, 0x300000, 5, false)
    expect(fence != spaces.NONE && !spaces.idle(&e, &s, space), "a buffer submitted and not yet run: the space is not idle")
    var from = card.written
    expect(spaces.give(&e, &s, space) == spaces.NONE && card.written == from && spaces.held(&s, space), "given back refused while the ring has not come to its fence, nothing written")
    const before = c.graphics.wptr
    expect(spaces.submit(&e, &l, &s, &c.graphics, space, 0x300000, 5, false) == spaces.NONE && c.graphics.wptr == before, "the graphics ring refused the space while compute ring 0 has work in it, nothing written")
    mec.ringDeaf = false
    ring.tell(&e, &l, &c.compute)
    expect(ring.wait(&e, &l, &c.compute, fence, true, 1000) == ring.Waited.done && spaces.idle(&e, &s, space) && memoryWord(sys + 0x100) == 0x6B6B0001, "the ring runs it: idle")
    const other = spaces.submit(&e, &l, &s, &c.graphics, space, 0x300000, 5, false)
    expect(other != spaces.NONE && ring.wait(&e, &l, &c.graphics, other, true, 1000) == ring.Waited.done, "then the graphics ring takes the space")
    expect(spaces.give(&e, &s, space) == 1 && card.registers[0x550] == e.table >> 12, "and it is given back")
    // Work that cannot end: emptied and kept.
    const stuck = spaces.take(&e, &s, 7)
    expect(spaces.map(&e, &s, stuck, 0x300000, spaces.Memory.system, sys, spaces.READ | spaces.WRITE | spaces.EXECUTE) == spaces.Mapped.done && spaces.map(&e, &s, stuck, 0x301000, spaces.Memory.card, 0x7000000, spaces.READ | spaces.WRITE) == spaces.Mapped.done, "two pages")
    mec.ringDeaf = true
    expect(spaces.submit(&e, &l, &s, &c.compute, stuck, 0x300000, 5, false) != spaces.NONE, "a buffer that does not run")
    from = card.written
    expect(spaces.empty(&e, &s, stuck) == 2 && spaces.entry(&e, &s, stuck, 0x300000) == 0 && spaces.entry(&e, &s, stuck, 0x301000) == 0 && spaces.directoryEntry(&e, &s, stuck, 0) & 1 == 1 && s.kept[stuck], "emptied: both entries 0, the directory still naming its table")
    expect(writes(from, 0x1520) == 1 && writes(from, 0x51E) == 1 && writes(from, ring.baseRegister(stuck)) == 0, "the host path flushed, the space flushed by register, its base register not written (the GART's table is not named as its directory)")
    expect(spaces.map(&e, &s, stuck, 0x302000, spaces.Memory.system, sys, spaces.READ) == spaces.Mapped.kept && spaces.submit(&e, &l, &s, &c.graphics, stuck, 0x300000, 5, false) == spaces.NONE && spaces.give(&e, &s, stuck) == spaces.NONE && spaces.take(&e, &s, 8) != stuck, "nothing more mapped, run or given back in it, and it is handed to no context")
    expect(std.string.eql(std.string.fromSlice(spaces.mappedWords(spaces.Mapped.kept)), std.string.fromSlice("the address space's work did not end: it is kept empty until the rings are stopped")), "the refusal in words")
    first.stop(&e, &l, &c, &g, &s, &f)
    expect(!spaces.held(&s, stuck) && spaces.poolTaken(&s) == 0 && card.registers[ring.baseRegister(stuck)] == e.table >> 12, "the way down gives it back once the processors are halted")
    mec.ringDeaf = false
}

// A table entry without its valid bit: the write through it does not land,
// it is a fault told to the context.
fn theEntryNotValid() -> void {
    expect(upToG5(), "stages 0 to 6")
    expect(spaces.open(&e, &s), "open")
    const space = spaces.take(&e, &s, 3)
    const code = page()
    const data = page()
    expect(spaces.map(&e, &s, space, 0x500000, spaces.Memory.system, code, spaces.READ | spaces.EXECUTE) == spaces.Mapped.done && spaces.map(&e, &s, space, 0x501000, spaces.Memory.system, data, spaces.READ | spaces.WRITE) == spaces.Mapped.done, "a buffer's page and a data page")
    const table = (spaces.directoryEntry(&e, &s, space, 1) & 0xFFFFFFFFFF000) - VRAM
    const place = table + 0x101 * 8
    expect(vramWord(place) == (data | 0x67), "the data page's entry")
    setVram(place, vramWord(place) & ~@intCast(usize, 1))
    writeAt(code, 0x501010, 0x4C4C0001)
    smc.memoryWrite(data + 0x10, 0x11111111)
    card.registers[engines.VM_CONTEXT1_CNTL] |= FAULTS
    const fence = spaces.submit(&e, &l, &s, &c.compute, space, 0x500000, 5, false)
    expect(fence != spaces.NONE && ring.wait(&e, &l, &c.compute, fence, true, 1000) == ring.Waited.done && memoryWord(data + 0x10) == 0x11111111, "the write through an entry without its valid bit does not land; the ring goes on")
    expect(spaces.collect(&e, &s, &c.compute) == 1 && s.faults[space] == 1 && s.faultPage[space][0] == 0x501 && spaces.faultWrote(s.faultStatus[space][0]) && s.faultSource[space][0] == 146, "a fault told to the context: page 0x501, a write, no valid entry")
    line("gpu: a fault in address space 1 (context 3): page 0x501, a write, protections 0x1, client \"CPC \" (0x42); status 0x3042001; source 146 (no valid entry)\n")
}

// A flood of faults: one buffer writes 3000 words where nothing is mapped,
// each a fault with its entry. The wait ends, the first fault is decoded and
// told, the entries that find the fault's words already taken tell nothing
// (as Linux has them), one line is said, and the ring goes on.
fn theFlood() -> void {
    expect(upToG5(), "stages 0 to 6")
    expect(spaces.open(&e, &s), "open")
    const space = spaces.take(&e, &s, 4)
    var pages: [3]usize = undefined
    var k: usize = 0
    while k < 3 {
        pages[k] = page()
        expect(spaces.map(&e, &s, space, 0x600000 + k * 0x1000, spaces.Memory.system, pages[k], spaces.READ | spaces.WRITE | spaces.EXECUTE) == spaces.Mapped.done, "the buffer's pages")
        k += 1
    }
    smc.memoryWrite(pages[0], @intCast(u32, ring.packet3(ring.PACKET3_WRITE_DATA, 3002)))
    smc.memoryWrite(pages[0] + 4, 0x00100500)
    smc.memoryWrite(pages[0] + 8, 0x700000)
    smc.memoryWrite(pages[0] + 12, 0)
    k = 4
    while k < 3004 {
        smc.memoryWrite(pages[k / 1024] + (k % 1024) * 4, @intCast(u32, k))
        k += 1
    }
    card.registers[engines.VM_CONTEXT1_CNTL] |= FAULTS
    const entries = e.entries
    const others = l.others
    const lines = card.logged
    const fence = spaces.submit(&e, &l, &s, &c.compute, space, 0x600000, 3004, false)
    expect(fence != spaces.NONE && ring.wait(&e, &l, &c.compute, fence, true, 1000) == ring.Waited.done && vm.faults == 3000, "the buffer of 3000 faulting writes ends")
    expect(e.entries - entries == 3002 && l.others - others == 2999 && c.compute.spaceFaults == 1, "3000 fault entries and the two ends of pipe (the flush's fence, the buffer's) taken; the first fault decoded, the 2999 that find its words taken counted and told nothing")
    expect(spaces.collect(&e, &s, &c.compute) == 1 && s.faults[space] == 1 && s.faultPage[space][0] == 0x700, "the first told to the context")
    var said: usize = 0
    k = lines
    while k < card.logged {
        if card.log[k] == 10 { said += 1 }
        k += 1
    }
    expect(said == 1, "one line said for the flood")
    writeAt(pages[1], 0x600800, 0x5E5E0001)
    const next = spaces.submit(&e, &l, &s, &c.compute, space, 0x601000, 5, false)
    expect(next != spaces.NONE && ring.wait(&e, &l, &c.compute, next, true, 1000) == ring.Waited.done && memoryWord(pages[0] + 0x800) == 0x5E5E0001, "the ring goes on")
}

// After V1 a program's buffer that uses a privileged register: the card
// sends its entry only with the graphics block's fault interrupt on, which
// V1 turned on, and the wait ends at once as a fault of the ring.
fn thePrivilegedFault() -> void {
    boot(7)
    expect(f.v1 == engines.Outcome.passed, "a boot of stage 7")
    mec.privNeedsEnable = true
    mec.privFault = true
    const space = spaces.take(&e, &s, 2)
    const sys = page()
    expect(spaces.map(&e, &s, space, 0x300000, spaces.Memory.system, sys, spaces.READ | spaces.WRITE | spaces.EXECUTE) == spaces.Mapped.done, "a page")
    writeAt(sys, 0x300100, 0x6B6B0001)
    const fence = spaces.submit(&e, &l, &s, &c.compute, space, 0x300000, 5, false)
    expect(fence != spaces.NONE && ring.wait(&e, &l, &c.compute, fence, true, 1000) == ring.Waited.faulted && c.compute.faults == 1 && c.compute.waited < 1000, "the privileged fault's entry comes and the wait ends at once")
    mec.privFault = false
}

// The way down after a boot of stage 7, with a context's space held.
fn theWayDown() -> void {
    boot(7)
    expect(f.v1 == engines.Outcome.passed, "a boot of stage 7")
    const space = spaces.take(&e, &s, 2)
    const sys = page()
    expect(spaces.map(&e, &s, space, 0x400000, spaces.Memory.system, sys, spaces.READ) == spaces.Mapped.done, "a context's page")
    first.stop(&e, &l, &c, &g, &s, &f)
    shown()
    expect(!spaces.held(&s, space) && spaces.poolTaken(&s) == 0, "every space given back")
    expect(card.registers[engines.VM_CONTEXT1_CNTL] & FAULTS == 0 && card.registers[engines.VM_CONTEXT0_CNTL] & FAULTS == 0 && card.registers[0x306A] & 0xC00000 == 0, "the fault interrupts as found (off), the graphics block's too")
    line("gpu: the address spaces on the way down: 1 given back, the fault interrupts as found\n")
    expect(card.after("gpu: stopped for the way down:", 0) < card.after("gpu: the address spaces on the way down", 0), "after the processors are halted")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    _ = crash.install()
    if !card.makeRom(true) {
        say("the ROM could not be made\n")
        return 5
    }
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !card.load(name) {
            say("the firmware files could not be read (run from the repository's top)\n")
            return 6
        }
    }
    theFirstSpace()
    theFirstSpaceFailures()
    theFirstSpaceCards()
    theInterface()
    theGraphicsFrame()
    theWorkInFlight()
    theEntryNotValid()
    theFlood()
    thePrivilegedFault()
    theWayDown()
    if failed != 0 { return failed }
    return 13
}
