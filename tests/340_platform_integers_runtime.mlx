// usize and u64, isize and i64 are one width on every target Mlx builds
// for, so each takes the other with no @intCast: in a declaration, an
// assignment, an argument, a return, a struct field and between operands
// (pointers to them stay distinct types). Exits 13.
const Entry = struct { size: u64, count: usize, offset: i64 }

fn take(value: u64) -> usize { return value }
fn signed(value: isize) -> i64 { return value }

pub fn main() -> u8 {
    var index: usize = 5
    var wide: u64 = index
    wide = index + 1
    const back: usize = wide
    const sum = index + wide
    const entry = Entry.{ .size = index, .count = wide, .offset = signed(-3) }
    var total: u64 = 0
    total += index
    if back != 6 || sum != 11 || take(index) != 5 { return 1 }
    if entry.size != 5 || entry.count != 6 || entry.offset != -3 || total != 5 { return 2 }
    if index >= wide { return 3 }
    return 13
}
