// brixfs's map of the blocks in use (projects/brix/blockmap.mlx: a bit a
// block, by words, with the count of the bits set) against a plain loop
// over single bits: runs marked and let go at chance (short ones, ones
// over many words, ones past the end, ones another map keeps), the first
// free block from every place, the counts after each step; what one map
// holds that another does not, two maps joined; the runs of a page (one
// that goes on from the last joined to it, the page full).
// Exits 13.
const std = @import("std")
const blockmap = @import("../projects/brix/blockmap.mlx")
const BlockMap = blockmap.BlockMap
const Runs = blockmap.Runs

// (Not a multiple of 64: the last word is partly past the end.)
const BLOCKS: usize = 5000
const WORDS: usize = (BLOCKS + 63) / 64

var seed: usize = 0x9E3779B97F4A7C15 // (per run)

fn chance(below: usize) -> usize {
    seed ^= seed << 13
    seed ^= seed >> 7
    seed ^= seed << 17
    return (seed >> 11) % below
}

// The plain one: a byte a block.
var plain: [BLOCKS]u8 = undefined // (per run)
var plainKept: [BLOCKS]u8 = undefined // (per run)
var mapWords: [WORDS]usize = undefined // (per run)
var keptWords: [WORDS]usize = undefined // (per run)

fn plainUsed(of: [*]const u8) -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < BLOCKS {
        if of[k] != 0 { count += 1 }
        k += 1
    }
    return count
}

fn plainFirstFree(from: usize) -> usize {
    var k = from
    while k < BLOCKS {
        if plain[k] == 0 { return k }
        k += 1
    }
    return BLOCKS
}

// Whether the map says of every block what the plain one says, and its
// count is the plain one's.
fn same(map: *const BlockMap, of: [*]const u8) -> bool {
    var k: usize = 0
    while k < BLOCKS {
        if map.isSet(k) != (of[k] != 0) { return false }
        k += 1
    }
    // (No bit past the last block.)
    if map.*.words[WORDS - 1] >> @intCast(u6, BLOCKS % 64) != 0 { return false }
    return map.*.used == plainUsed(of) && map.free() == BLOCKS - map.*.used
}

// A run at chance: mostly short, sometimes over many words, sometimes
// reaching past the end or starting there.
fn runStart() -> usize { return if chance(40) == 0 { BLOCKS - 1 + chance(70) } else { chance(BLOCKS) } }

fn runLength() -> usize {
    const kind = chance(10)
    if kind == 0 { return chance(900) }
    if kind == 1 { return 64 * (1 + chance(5)) }
    if kind == 2 { return 0 }
    return 1 + chance(70)
}

pub fn main() -> u8 {
    var k: usize = 0
    while k < BLOCKS {
        plain[k] = 0
        plainKept[k] = 0
        k += 1
    }
    k = 0
    while k < WORDS {
        mapWords[k] = ~@intCast(usize, 0)
        keptWords[k] = ~@intCast(usize, 0)
        k += 1
    }
    var map: BlockMap = undefined
    var kept: BlockMap = undefined
    map.init(&mapWords, BLOCKS)
    kept.init(&keptWords, BLOCKS)
    map.clear()
    kept.clear()
    if BlockMap.bytesFor(BLOCKS) != WORDS * 8 || BlockMap.bytesFor(64) != 8 || BlockMap.bytesFor(65) != 16 { return 1 }
    if BlockMap.ones(0) != 0 || BlockMap.ones(~@intCast(usize, 0)) != 64 || BlockMap.ones(0x8000000000000001) != 2 || BlockMap.ones(0x00FF00F00F000301) != 19 { return 2 }
    if !same(&map, &plain) || map.firstFree(0) != 0 || map.firstFree(BLOCKS) != BLOCKS || map.firstFree(BLOCKS + 9) != BLOCKS { return 3 }

    // What the snapshots keep: a few runs, in both.
    var n: usize = 0
    while n < 30 {
        const start = chance(BLOCKS)
        const length = 1 + chance(120)
        var fresh: usize = 0
        var b = start
        while b < start + length && b < BLOCKS {
            if plainKept[b] == 0 { fresh += 1 }
            plainKept[b] = 1
            b += 1
        }
        if kept.markRun(start, length) != fresh { return 4 }
        n += 1
    }
    if !same(&kept, &plainKept) { return 5 }

    // Runs marked and let go at chance, with and without the kept map.
    var step: usize = 0
    while step < 6000 {
        const start = runStart()
        const length = runLength()
        const what = chance(5)
        if what < 3 {
            var fresh: usize = 0
            var b = start
            while b < BLOCKS && b - start < length {
                if plain[b] == 0 { fresh += 1 }
                plain[b] = 1
                b += 1
            }
            if map.markRun(start, length) != fresh { return 6 }
        } else {
            const keeping = what == 4
            var gone: usize = 0
            var b = start
            while b < BLOCKS && b - start < length {
                if plain[b] != 0 && !(keeping && plainKept[b] != 0) {
                    gone += 1
                    plain[b] = 0
                }
                b += 1
            }
            var keep: ?*const BlockMap = null
            if keeping { keep = &kept }
            if map.releaseRun(start, length, keep) != gone { return 7 }
        }
        if map.used != plainUsed(&plain) { return 8 }
        const from = chance(BLOCKS + 3)
        if map.firstFree(from) != plainFirstFree(from) { return 9 }
        if step % 97 == 0 && !same(&map, &plain) { return 10 }
        step += 1
    }
    if !same(&map, &plain) || !same(&kept, &plainKept) { return 11 }

    // What one holds that the other does not; the two joined.
    var only: usize = 0
    var onlyKept: usize = 0
    var either: usize = 0
    k = 0
    while k < BLOCKS {
        if plain[k] != 0 && plainKept[k] == 0 { only += 1 }
        if plain[k] == 0 && plainKept[k] != 0 { onlyKept += 1 }
        if plain[k] != 0 || plainKept[k] != 0 {
            either += 1
            plain[k] = 1
        }
        k += 1
    }
    if map.notIn(&kept) != only || kept.notIn(&map) != onlyKept || only == 0 || onlyKept == 0 { return 12 }
    map.join(&kept)
    if map.used != either || !same(&map, &plain) || kept.notIn(&map) != 0 { return 14 }

    // A full map: no free block from anywhere; one let go is found from
    // below it, not from above.
    if map.markRun(0, BLOCKS + 500) != BLOCKS - either || map.free() != 0 || map.firstFree(0) != BLOCKS || map.firstFree(4999) != BLOCKS { return 15 }
    if map.releaseRun(4990, 1, null) != 1 || map.firstFree(0) != 4990 || map.firstFree(4990) != 4990 || map.firstFree(4991) != BLOCKS || map.free() != 1 { return 16 }
    if map.releaseRun(64, 64, null) != 64 || map.firstFree(0) != 64 || map.firstFree(100) != 100 || map.firstFree(128) != 4990 { return 17 }
    map.clear()
    if map.used != 0 || map.firstFree(7) != 7 || map.isSet(4990) || map.isSet(BLOCKS) { return 18 }

    // Runs in a page: one that goes on from the last is joined to it,
    // an empty one is none, a full page says so.
    var page: [512]usize = undefined
    k = 0
    while k < 512 {
        page[k] = 0xAAAA
        k += 1
    }
    Runs.clear(&page)
    if Runs.count(&page) != 0 || Runs.next(&page) != 0 { return 19 }
    if !Runs.add(&page, 10, 5) || !Runs.add(&page, 15, 3) || !Runs.add(&page, 40, 0) || !Runs.add(&page, 30, 2) || !Runs.add(&page, 18, 1) { return 20 }
    if Runs.count(&page) != 3 || Runs.start(&page, 0) != 10 || Runs.length(&page, 0) != 8 || Runs.start(&page, 1) != 30 || Runs.length(&page, 1) != 2 || Runs.start(&page, 2) != 18 || Runs.length(&page, 2) != 1 { return 21 }
    k = 3
    while k < Runs.PER_PAGE {
        if !Runs.add(&page, 1000 + 3 * k, 2) { return 22 }
        k += 1
    }
    if Runs.count(&page) != Runs.PER_PAGE || Runs.add(&page, 7, 1) || Runs.count(&page) != Runs.PER_PAGE { return 23 }
    // (The last run still grows where a run goes on from it.)
    if !Runs.add(&page, 1000 + 3 * (Runs.PER_PAGE - 1) + 2, 4) || Runs.length(&page, Runs.PER_PAGE - 1) != 6 { return 24 }
    Runs.setNext(&page, 0x1000)
    if Runs.next(&page) != 0x1000 || Runs.count(&page) != Runs.PER_PAGE || Runs.start(&page, 0) != 10 { return 25 }
    return 13
}
