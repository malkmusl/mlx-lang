// The picture brought to and from a DisplayPort output of a Radeon, its
// hot plug, and its mode changed there (projects/brix/kernel/
// gpu_dpwatch.mlx, gpu_switch.mlx, gpu_together.mlx, gpu_change.mlx and
// gpu_mode.mlx's "A MOVE WITH A DISPLAYPORT END" with gpu_set.mlx's
// carrying out, built for the host), on the user's whole card as a table
// with a DisplayPort monitor behind an AUX channel (tests/support/
// dpswitch_card.mlx). The kernel's side is put together as gpu.mlx and
// modes.mlx put it: the boot, the timer's tick, what it found due made on
// the trap's way back, a display's state of the modes.
// - At boot: the firmware's picture on the HDMI output and the monitor on
//   a DisplayPort one (the monitor asked over the AUX channel, its EDID
//   through the channel's I2C bridge, the picture brought there with the
//   monitor's own mode, the link trained, the DTO the clock); the
//   firmware's picture on a DisplayPort output and the monitor on HDMI,
//   and on the other DisplayPort output.
// - While brixOS runs: the cable from HDMI to DisplayPort, back to HDMI,
//   from one DisplayPort output to the other: each move's steps in the
//   order of the display core's, the tables told what they are told, and
//   every write to the two ends' registers, controller 0's and the
//   clocks'; the picture's memory as it was.
// - Every table's run of a move refused by the card in turn, a training
//   that fails, a DTO that does not come: each change's way back, and
//   what it left.
// - The hot plug line: a long pulse (unplugged, plugged in again), a short
//   pulse with the link holding and with it lost (trained again), the
//   lanes looked at every 2 s; each said in one line.
// - The display's mode changed on the DisplayPort output.
// - What the review added: a link that does not train again (the monitor
//   on another input), tried once and left until the monitor pulses its
//   line; another monitor of the picture's size on the DisplayPort output
//   (the timing kept, no plan of a TMDS output's); the monitor's own
//   timing beyond what the link carries (another of its size); a monitor
//   no link is trained to, and one whose AUX channel does not answer (not
//   driven).
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const plug = @import("../projects/brix/kernel/gpu_plug.mlx")
const ddc = @import("../projects/brix/kernel/gpu_ddc.mlx")
const aux = @import("../projects/brix/kernel/gpu_aux.mlx")
const dplink = @import("../projects/brix/kernel/gpu_link.mlx")
const rule = @import("../projects/brix/kernel/gpu_switch.mlx")
const changing = @import("../projects/brix/kernel/gpu_change.mlx")
const together = @import("../projects/brix/kernel/gpu_together.mlx")
const dpwatch = @import("../projects/brix/kernel/gpu_dpwatch.mlx")
const dm = @import("../projects/brix/kernel/display_modes.mlx")
const rom = @import("./support/atom_rom.mlx")
const display = @import("./support/tmds_card.mlx")
const lines = @import("./support/plug_card.mlx")
const sw = @import("./support/switch_card.mlx")
const sink = @import("./support/dp_monitor.mlx")
const card = @import("./support/dpswitch_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0
var name: []const u8 = undefined

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected (")
    say(name)
    say("): ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(display.has(text), text) }

fn once(text: []const u8) -> void { expect(display.count(text) == 1, text) }

fn noLine(text: []const u8) -> void {
    if !display.has(text) { return }
    say("said, but should not be (")
    say(name)
    say("): ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    display.logWrite(text)
    if show { say(text) }
}

const MS: usize = 1000000
const NEVER: usize = 0xFFFFFFFF

fn out() -> scanout.Card { return scanout.Card.{ .read = card.read, .now = sw.now, .write = logWrite } }

// ---- The ROM and what is read of it (the user's five connectors).
var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

fn open() -> void {
    sw.makeRom(&builder, sw.NEVER, display.Ending.plain)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
}

// ---- The monitor's EDID: the user's (3840x1080 at 270270 kHz, 4040 by
// 1115, its HDMI block in the extension; 1920x1080 and 1280x720 at 60 Hz
// among its standard timings).
var users: [256]u8 = undefined

fn resum(bytes: []u8, block: usize) -> void {
    var sum: usize = 0
    var k: usize = 0
    while k < 127 {
        sum += @intCast(usize, bytes[block * 128 + k])
        k += 1
    }
    bytes[block * 128 + 127] = @intCast(u8, (256 - (sum & 0xFF)) & 0xFF)
}

fn makeEdids() -> void {
    _ = lines.edid(users[0..], 2, true)
    const wide = [_]u8{ 0x93, 0x69, 0x00, 0xC8, 0xF0, 0x38, 0x23, 0x40, 48, 32, 0x35, 0x00 }
    var k: usize = 0
    while k < 12 {
        users[54 + k] = wide[k]
        k += 1
    }
    users[71] = 0x1A
    users[38] = 0xD1
    users[39] = 0xC0
    users[40] = 0x81
    users[41] = 0xC0
    resum(users[0..], 0)
}

// ---- The kernel's side, as gpu.mlx and modes.mlx put it together.
var watch: plug.Watch = undefined
var verdict: plug.Verdict = undefined
var follow: rule.Follow = undefined
var decided: rule.Decision = undefined
var bootReadout: scanout.Readout = undefined
var bootPlan: mode.Plan = undefined
var bootResult: set.Result = undefined
var memory: scanout.Memory = undefined
var seen: changing.Seen = undefined
var machinery: changing.Lent = undefined
var switchLent: rule.Lent = undefined
var lentHands: set.Hands = undefined
var lentTables: set.Tables = undefined
var facts: mode.Rom = undefined
var ddcHands: ddc.Hands = undefined
var driver: together.Driver = undefined
var watching = false
var state: dm.State = undefined
var stateDriver: dm.Driver = undefined
var sinks: dpwatch.Sinks = undefined
var auxCard: scanout.Card = undefined
const BASE: usize = 0xD0000000

var holds: usize = 0

fn hold() -> usize {
    holds += 1
    return 0
}

fn release() -> void {}

fn stateJudge(which: usize, asked: *dm.Mode) -> void { together.judge(&driver, asked) }

fn picture(result: dm.Set, into: *dm.Picture) -> dm.Set {
    if result != dm.Set.done { return result }
    into.*.address = BASE + seen.plan.offset
    into.*.width = seen.plan.width
    into.*.height = seen.plan.height
    into.*.pitch = seen.plan.pitch * 4
    return result
}

fn stateSet(which: usize, asked: *const dm.Mode, into: *dm.Picture) -> dm.Set {
    if !asked.*.timed { return dm.Set.refused }
    return picture(together.set(&driver, &asked.*.timing), into)
}

fn stateBack(which: usize, before: *const dm.Mode, into: *dm.Picture) -> dm.Set { return picture(together.back(&driver, before), into) }

fn lend() -> void {
    lentHands = set.Hands.{ .write = card.write, .clear = display.clear }
    lentTables = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = display.setAside }
    facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    ddcHands = ddc.Hands.{ .write = card.write }
    stateDriver = dm.Driver.{ .kind = dm.Kind.RADEON_TMDS, .which = 0, .timed = true, .anySize = false, .judge = stateJudge, .set = stateSet, .back = stateBack }
    auxCard = out()
}

fn named(title: []const u8) -> void {
    name = title
    if show {
        say("-- ")
        say(title)
        say("\n")
    }
}

// The user's card's clocks: the display clock 118032 kHz (the divider's
// number 0x5D) and the reference clock 600 MHz (0x18), its table rounding as the user's ROM does (the fastest at
// or below), the reference clock's table writing every DTO's modulo
// 600000000 as the user's ROM does, and those modulos so already.
fn asTheUsers() -> void {
    display.store(0x124, 0x1800005D)
    display.clockAtOrBelow = true
    display.referenceAsRom = true
    var c: usize = 0
    while c < 6 {
        display.store(0x142 + 4 * c, 600000000)
        c += 1
    }
}

// The machine as the user's (the firmware's 1280x960 out of the HDMI
// connector 2 on DIG 4 by DVI signalling, every line low), with the
// monitor on DisplayPort connector `dp` (NEVER: none) or on HDMI 2
// (`hdmi`); the case named `title` (none: named already).
fn usersWith(title: []const u8, dp: usize, hdmi: bool) -> void {
    if title.length != 0 { named(title) }
    card.reset()
    sw.users(107962, 0)
    card.pull()
    asTheUsers()
    if hdmi {
        sw.monitor(2, users[0..])
        sw.line(2, true, sw.NEVER)
    }
    if dp != NEVER { card.dpMonitor(dp, 0x12, 0x14, 4, users[0..], true) }
}

// The boot as gpu.mlx makes it: every connector looked at, the HDMI and
// DVI monitors asked over DDC, the DisplayPort ones over their AUX
// channels, the rule at boot, the plan (a move with the monitor's own mode
// when the rule decides one, else the monitor's own mode on the output
// the firmware runs) carried out, what serves each connector read anew,
// the record begun; then the one driver and the display's modes.
fn boot() -> void {
    const c = out()
    const h = ddc.Hands.{ .write = card.write }
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    plug.detect(&watch.ports, &verdict)
    plug.askAtBoot(&c, &h, sw.pause, 6, 100000, &watch.ports, &watch.reader)
    dpwatch.begin(&sinks, aux.Port.{ .card = &auxCard, .write = card.auxWrite }, card.ackWrite, true)
    rule.useSinks(&sinks)
    dpwatch.atBoot(&sinks, &watch.ports)
    decided = rule.atBoot(&c, &watch.ports, &verdict, &follow, rule.How.follows)
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    scanout.report(&c, &memory, &bootReadout)
    var s = verdict.output
    if decided.act == rule.Act.move {
        const target = rule.targetFor(&watch.ports, &follow, decided, false)
        s = decided.to
        mode.makeMove(&c, &bootReadout, &memory, &target, &watch.ports.ports[s].monitor, &watch.ports.ports[s].offer, &facts, sinkHeard(decided.to), sinkHeard(decided.from), &bootPlan)
        mode.say(&c, &bootPlan)
        mode.list(&c, &bootPlan)
        _ = set.attemptMove(&c, &lentHands, &lentTables, dpwatch.channelFor(&sinks, &watch.ports, decided.to), dpwatch.channelFor(&sinks, &watch.ports, decided.from), &bootPlan, true, &bootResult)
    } else if s < watch.ports.count && watch.ports.ports[s].heard.outcome == ddc.Outcome.read {
        mode.makeFor(&c, &bootReadout, &memory, &watch.ports.ports[s].monitor, &watch.ports.ports[s].offer, &facts, mode.Wish.own, &bootPlan)
        mode.say(&c, &bootPlan)
        _ = set.attemptWith(&c, &lentHands, &lentTables, &bootPlan, true, &bootResult)
    } else {
        bootResult.outcome = set.Outcome.untouched
        bootPlan.situation = mode.Situation.none
    }
    plug.serveAll(&c, &watch.ports)
    var controller: usize = 0
    if bootPlan.situation != mode.Situation.none { controller = bootPlan.controller }
    const showing = plug.servedBy(&watch.ports, controller)
    var bytes: []const u8 = users[0..0]
    if showing != plug.NONE && watch.ports.ports[showing].heard.outcome == ddc.Outcome.read { bytes = watch.ports.ports[showing].heard.data() }
    rule.begin(&follow, follow.how, &watch.ports, controller, memory.pictureWidth, memory.pictureHeight, bytes, 0, 0, 0)
    _ = rule.carried(&c, &follow, &watch.ports, &bootPlan, &bootResult, decided)
    if bootResult.outcome == set.Outcome.done && !bootPlan.move.keep {
        memory.pictureOffset = bootPlan.offset
        memory.pictureBytes = bootPlan.bytes
        memory.pictureWidth = bootPlan.width
        memory.pictureHeight = bootPlan.height
        memory.picturePitch = bootPlan.pitch
    }
    changing.begin(&seen)
    seen.memory = memory
    if showing != plug.NONE { seen.offer = watch.ports.ports[showing].offer }
    machinery = changing.Lent.{ .card = out(), .hands = lentHands, .tables = &lentTables, .rom = facts, .hold = hold, .release = release, .aside = display.setAside }
    display.setAside(true)
    changing.look(&machinery, &seen)
    display.setAside(false)
    switchLent = rule.Lent.{ .hands = &lentHands, .tables = &lentTables, .rom = &facts, .memory = &seen.memory, .readout = &seen.readout, .plan = &seen.plan, .result = &seen.result, .change = &machinery, .seen = &seen }
    watching = true
    driver.card = out()
    driver.watch = &watch
    driver.follow = &follow
    driver.lent = &switchLent
    driver.change = &machinery
    driver.seen = &seen
    driver.hands = &ddcHands
    driver.pause = sw.pause
    driver.watching = &watching
    together.begin(&driver)
    together.useSinks(&driver, &sinks)
    var listed: []const u8 = users[0..128]
    if together.modeEdid(&driver).length != 0 { listed = together.modeEdid(&driver) }
    stateDriver.kind = changing.kindOf(&seen)
    const p = dm.Picture.{ .address = BASE + memory.pictureOffset, .width = memory.pictureWidth, .height = memory.pictureHeight, .pitch = memory.picturePitch * 4 }
    state.begin(&stateDriver, listed, &p, changing.rate(&seen), null)
    listedMonitors = driver.monitors
    holds = 0
}

fn sinkHeard(k: usize) -> ?*const dplink.Heard {
    if k >= watch.ports.count || !dpwatch.usable(&watch.ports.ports[k]) { return null }
    return &watch.ports.ports[k].dp
}

// ---- The timer's ticks (10 ms apart) and what each found due.
var listedMonitors: usize = 0
var lastDue = together.Due.none
// How many of the switch's changes were made (the lanes' looks that come
// due after them are dues too).
var made: usize = 0

fn after() -> void {
    if state.pending && display.clock >= state.deadline { _ = state.tick(display.clock) }
    if together.isDue(&driver) {
        lastDue = together.carryDue(&driver, &state)
        if lastDue == together.Due.made {
            listedMonitors = driver.monitors
            made += 1
        }
    }
    if driver.monitors != listedMonitors {
        state.relist(together.modeEdid(&driver))
        listedMonitors = driver.monitors
    }
}

fn ticks(until: usize) -> void {
    while display.clock < until {
        sw.pass(10 * MS)
        together.tick(&driver)
        after()
    }
}

// What the card shows: the controller's clock from the DTO (and its
// phase), the back end `n` on and its mode.
fn onDto() -> bool { return display.raw(0x140) & 0x10 != 0 }

fn backOn(n: usize) -> bool { return display.raw(scanout.DIG[n] + scanout.DIG_BE_EN_CNTL) & 1 != 0 }

fn backMode(n: usize) -> usize { return (display.raw(scanout.DIG[n] + scanout.DIG_BE_CNTL) >> 16) & 7 }

fn streamOn(m: usize) -> bool { return display.raw(scanout.DIG[m] + scanout.DP_VID_STREAM_CNTL) & 1 != 0 }

fn locked(lanes: usize) -> bool {
    var k: usize = 0
    while k < lanes {
        if !sink.lockOf[k] { return false }
        k += 1
    }
    return true
}

// The table runs the card saw, in order, from write `from` on: each one's
// table and its first two words.
const RUNS: usize = 128
var runTable: [RUNS]usize = undefined
var runWord0: [RUNS]usize = undefined
var runWord1: [RUNS]usize = undefined
var runCount: usize = 0

fn collectRuns(from: usize) -> void {
    runCount = 0
    var w0: usize = 0
    var w1: usize = 0
    var k = from
    while k < display.written && k < display.WRITES {
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL { w0 = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL + 1 { w1 = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.GO && runCount < RUNS {
            runTable[runCount] = display.writtenWith[k]
            runWord0[runCount] = w0
            runWord1[runCount] = w1
            runCount += 1
        }
        k += 1
    }
}

// Where in the runs collected the first of table `table` with word 0
// `w0` (NEVER: any) and word 1 `w1` (NEVER: any) stands, from `from` on.
fn runAt(from: usize, table: usize, w0: usize, w1: usize) -> usize {
    var k = from
    while k < runCount {
        if runTable[k] == table && (w0 == NEVER || runWord0[k] == w0) && (w1 == NEVER || runWord1[k] == w1) { return k }
        k += 1
    }
    return NEVER
}

// Where the first run of table `table` stands whose word 0 has `value` in
// its bits `mask` and whose word 1 has `value1` in its bits `mask1`, from
// `from` on (NEVER: none).
fn runOf(from: usize, table: usize, mask: usize, value: usize, mask1: usize, value1: usize) -> usize {
    var k = from
    while k < runCount {
        if runTable[k] == table && runWord0[k] & mask == value && runWord1[k] & mask1 == value1 { return k }
        k += 1
    }
    return NEVER
}

// Whether the positions `a` to `e` of runs (NEVER: not among them) stand
// in that order (`e` may be NEVER: unused).
fn inOrder(a: usize, b: usize, c: usize, d: usize, e: usize) -> bool {
    if a == NEVER || b == NEVER || c == NEVER || d == NEVER { return false }
    if !(a < b && b < c && c < d) { return false }
    return e == NEVER || d < e
}

// The tables' numbers in the card's command table list (atom.mlx) and the
// transmitter's actions (its block's second byte).
const SET_PIXEL_CLOCK: usize = 12
const ENABLE_CRTC: usize = 35
const SET_CRTC_TIMING: usize = 49
const SET_DCE_CLOCK: usize = 46
const TRANSMITTER: usize = 76
const OFF: usize = 0
const ON: usize = 1
const INIT: usize = 7
// The pixel clock's table told the PLL of DIG 4 (its fifth byte: ATOM_
// COMBOPHY_PLL0 + 4, as gpu_blocks.mlx puts it; the DTO is 11).
const PLL: usize = 0x18

// The first run of the transmitter's table for transmitter `phy` and
// action `action`, from `from` on.
fn phyRun(from: usize, phy: usize, action: usize) -> usize { return runOf(from, TRANSMITTER, 0xFFFF, phy | (action << 8), 0, 0) }

// Whether every driver's write from `from` on is to a register of the
// two ends' blocks (front and back ends `a` and `b`), controller 0's, the
// clocks' words, the marks', the buffers', the scratch words or the AUX
// channels' (which go elsewhere): what a move may write.
fn writesStayed(from: usize, a: usize, b: usize) -> bool {
    var k = from
    while k < display.written && k < display.WRITES {
        if !display.writtenByTable[k] {
            const r = display.writtenTo[k]
            const inEnd = (r >= scanout.DIG[a] && r < scanout.DIG[a] + 0x100) || (r >= scanout.DIG[b] && r < scanout.DIG[b] + 0x100)
            const inController = r >= 0x1A00 && r < 0x1C00
            const clocks = (r >= 0x100 && r <= 0x147) || r == 0x124
            const other = r == 0x5CB || r == 0x5CF || r == 0x321 || r == sink.EVENT || r == 0x1B30 || r == 0x1B32 || r == 0x1B33
            if !inEnd && !inController && !clocks && !other {
                if show {
                    const o = scanout.Card.{ .read = card.read, .now = sw.now, .write = say }
                    o.fieldHex("a write elsewhere: ", r)
                    say("\n")
                }
                return false
            }
        }
        k += 1
    }
    return true
}

// ---- AT BOOT.

// How many table runs each move at boot made (the failures below refuse
// each in turn).
var hdmiToDpRuns: usize = 0
var dpToHdmiRuns: usize = 0
var dpToDpRuns: usize = 0

// The firmware's picture on HDMI, the monitor on DisplayPort connector 0:
// asked over its AUX channel and brought there with its own mode.
fn bootHdmiToDp() -> void {
    usersWith("at boot: HDMI to DisplayPort", 0, false)
    boot()
    expect(sinks.asked == 1 && watch.ports.ports[0].dp.state == dplink.Asked.heard && watch.ports.ports[0].heard.outcome == ddc.Outcome.read && watch.ports.ports[0].heard.blocks == 2, "the monitor asked over its AUX channel, its EDID read through the bridge")
    line("gpu: connector 0 (DisplayPort): the monitor says 3840x1080 at 60 Hz over its AUX channel 1 (DisplayPort 1.2, up to 5.40 Gbit/s on 4 lanes; EDID of 2 blocks)\n")
    expect(decided.act == rule.Act.move && decided.to == 0 && decided.from == 2, "the rule brings the picture to connector 0")
    line("gpu: the monitor is on connector 0 (DisplayPort), the firmware's picture goes out by connector 2 (HDMI), where nothing is plugged in: the picture is brought to the monitor\n")
    expect(bootPlan.complete && bootPlan.move.on && bootPlan.move.toDp && !bootPlan.move.fromDp && bootPlan.situation == mode.Situation.displayport, "a move from TMDS to DisplayPort")
    expect(bootPlan.dp.target.code == dplink.LINK_RATE_HIGH && bootPlan.dp.target.lanes == 4, "the link: 2.7 Gbit/s on 4 lanes (the ROM has no rate record for it)")
    line("gpu: plan (move, TMDS to DisplayPort): connector 2 (HDMI, DIG 4, PLL 4) to connector 0 (DisplayPort, DIG 2, front end 2), controller 0 stays: DisplayPort at 270270 kHz on a link of 2.70 Gbit/s on 4 lanes (now DVI at 107960 kHz), a picture of 3840x1080 at 0x500000 of the aperture, the scaler off: ")
    line("gpu: would run SetPixelClock with 6c 3d 29 00 0b 20 00 00 00 00 00 00 00 00 00 00 (the pixel clock from the DTO)\n")
    expect(bootResult.outcome == set.Outcome.done, "carried out")
    expect(onDto() && display.raw(0x141) == 270270000, "the controller's clock the DTO's, its phase 270270000 Hz")
    expect(backOn(2) && backMode(2) == scanout.MODE_DISPLAYPORT && !backOn(4), "DIG 2 on in DisplayPort mode, DIG 4 off")
    expect(sink.txOn && sink.txCode == dplink.LINK_RATE_HIGH && sink.txLanes == 4 && locked(4) && streamOn(2), "the link trained, its lanes locked, the stream on")
    expect((display.raw(scanout.CRTC_CONTROL) >> 20) & 7 == 4, "DisplayPort's early blanking for 4 lanes (3840 a multiple of 4)")
    expect(follow.showing == 0 && follow.width == 3840 && follow.height == 1080, "the record: connector 0 shows a picture of 3840x1080")
    line(": the picture goes out by the new output, on a link trained at 2.70 Gbit/s on 4 lanes (")
    // The display core's order: the display clock raised (and the DP
    // reference clock after it), the new transmitter made ready, the old
    // one off, the controller stopped, the old PLL down, the DTO told the
    // clock, the timing, the controller started, the new transmitter on
    // for the training.
    collectRuns(0)
    const raised = runOf(0, SET_DCE_CLOCK, 0xFFFFFFFF, 32635, 0xFF, 0)
    const reference = runOf(0, SET_DCE_CLOCK, 0, 0, 0xFF, 1)
    const ready = phyRun(0, 2, INIT)
    const oldOff = phyRun(0, 4, OFF)
    const stopped = runOf(0, ENABLE_CRTC, 0xFFFF, 0x0000, 0, 0)
    const pllDown = runOf(0, SET_PIXEL_CLOCK, 0xFFFFFFFF, 0, 0xFF, PLL)
    const dto = runOf(0, SET_PIXEL_CLOCK, 0xFFFFFFFF, 2702700, 0xFFFF, 0x200B)
    const timed = runOf(0, SET_CRTC_TIMING, 0, 0, 0, 0)
    const started = runOf(stopped + 1, ENABLE_CRTC, 0xFFFF, 0x0100, 0, 0)
    const on = phyRun(0, 2, ON)
    expect(inOrder(raised, reference, ready, oldOff, stopped) && inOrder(stopped, pllDown, dto, timed, started) && on != NEVER && started < on, "the tables in the display core's order")
    expect(runOf(pllDown + 1, SET_PIXEL_CLOCK, 0xFFFFFFFF, 0, 0, 0) == NEVER && runOf(dto + 1, SET_PIXEL_CLOCK, 0, 0, 0, 0) == NEVER, "the PLL powered down once, the DTO told once, no other pixel clock")
    hdmiToDpRuns = display.runs
}

// The firmware's picture on DisplayPort connector 0 (1280x960 on a link
// of 1.62 Gbit/s on 2 lanes, as the user's firmware runs it), its cable
// away, the monitor on HDMI 2: the picture brought there, the DisplayPort
// output's stream, link and transmitter turned off.
fn bootDpToHdmi() -> void {
    named("at boot: DisplayPort to HDMI")
    card.usersOnDp(0, 0x06, 2, 0, 0x12, 0x14, users[0..])
    asTheUsers()
    card.pull()
    sw.monitor(2, users[0..])
    sw.line(2, true, sw.NEVER)
    boot()
    expect(decided.act == rule.Act.move && decided.to == 2 && decided.from == 0, "the rule brings the picture to connector 2")
    expect(bootPlan.complete && bootPlan.move.on && bootPlan.move.fromDp && !bootPlan.move.toDp, "a move from DisplayPort to TMDS")
    expect(bootResult.outcome == set.Outcome.done, "carried out")
    expect(!onDto() && backOn(4) && !backOn(2) && !streamOn(2), "DIG 4 on, the DTO no longer the clock, DIG 2 and its stream off")
    expect(follow.showing == 2 && follow.width == 3840 && follow.height == 1080, "the record: connector 2 shows a picture of 3840x1080")
    line("gpu: on the way back would train the link at 1.62 Gbit/s on 2 lanes (the old output's link brought up and trained again)\n")
    // The display core's order: the display clock raised, the new
    // transmitter made ready, the old link down (its transmitter off by the
    // link's step), the controller stopped, the new PLL set, the timing,
    // the controller started, the new transmitter on.
    collectRuns(0)
    const raised = runOf(0, SET_DCE_CLOCK, 0xFFFFFFFF, 32635, 0xFF, 0)
    const ready = phyRun(0, 4, INIT)
    const oldOff = phyRun(0, 2, OFF)
    const stopped = runOf(0, ENABLE_CRTC, 0xFFFF, 0x0000, 0, 0)
    const pll = runOf(0, SET_PIXEL_CLOCK, 0xFFFFFFFF, 2702700, 0xFF, PLL)
    const timed = runOf(0, SET_CRTC_TIMING, 0, 0, 0, 0)
    const started = runOf(stopped + 1, ENABLE_CRTC, 0xFFFF, 0x0100, 0, 0)
    const on = phyRun(0, 4, ON)
    expect(inOrder(raised, ready, oldOff, stopped, pll) && inOrder(pll, timed, started, on, NEVER), "the tables in the display core's order")
    expect(runOf(0, SET_PIXEL_CLOCK, 0xFF00, 0x0000, 0xFF, 11) == NEVER, "the DTO not told")
    expect(display.raw(scanout.DIG[2] + scanout.DIG_BE_CNTL) & 0x400 == 0, "the old back end without its front end")
    dpToHdmiRuns = display.runs
}

// The firmware's picture on DisplayPort connector 0, the monitor on the
// other DisplayPort connector 1: the picture brought there, the link of
// connector 1 trained, the one of connector 0 turned off.
fn bootDpToDp() -> void {
    named("at boot: DisplayPort to DisplayPort")
    card.usersOnDp(0, 0x06, 2, 0, 0x12, 0x14, users[0..])
    asTheUsers()
    card.pull()
    card.dpMonitor(1, 0x12, 0x14, 4, users[0..], true)
    boot()
    expect(decided.act == rule.Act.move && decided.to == 1 && decided.from == 0, "the rule brings the picture to connector 1")
    expect(bootPlan.complete && bootPlan.move.on && bootPlan.move.fromDp && bootPlan.move.toDp, "a move from DisplayPort to DisplayPort")
    expect(bootResult.outcome == set.Outcome.done, "carried out")
    expect(onDto() && backOn(3) && backMode(3) == scanout.MODE_DISPLAYPORT && !backOn(2) && !streamOn(2) && streamOn(3), "DIG 3 on in DisplayPort mode, its stream on; DIG 2 and its stream off")
    expect(sink.txOn && sink.txLanes == 4 && locked(4), "the new link trained")
    expect(follow.showing == 1 && follow.width == 3840 && follow.height == 1080, "the record: connector 1 shows a picture of 3840x1080")
    // The display clock raised, the new transmitter made ready, the old
    // link down, the new one trained; the controller keeps running on the
    // DTO (its phase and timing written): no clock or controller table.
    collectRuns(0)
    const raised = runOf(0, SET_DCE_CLOCK, 0xFFFFFFFF, 32635, 0xFF, 0)
    const ready = phyRun(0, 3, INIT)
    const oldOff = phyRun(0, 2, OFF)
    const on = phyRun(0, 3, ON)
    expect(inOrder(raised, ready, oldOff, on, NEVER), "the tables in the display core's order")
    expect(runOf(0, SET_PIXEL_CLOCK, 0, 0, 0, 0) == NEVER && runOf(0, ENABLE_CRTC, 0, 0, 0, 0) == NEVER && runOf(0, SET_CRTC_TIMING, 0, 0, 0, 0) == NEVER, "no pixel clock, controller or timing table: the DTO's phase and the timing written")
    expect(display.raw(0x141) == 270270000 && display.raw(0x1B80) == 4039, "the DTO's phase and the timing the new mode's")
    dpToDpRuns = display.runs
}

// ---- WHAT FAILS AT BOOT, AND THE WAY BACK.

var nameRoom: [96]u8 = undefined

// A case's name with a number after it.
fn numbered(title: []const u8, n: usize) -> void {
    var k: usize = 0
    while k < title.length && k < 80 {
        nameRoom[k] = title[k]
        k += 1
    }
    nameRoom[k] = ' '
    k += 1
    if n >= 10 {
        nameRoom[k] = @intCast(u8, 48 + (n / 10) % 10)
        k += 1
    }
    nameRoom[k] = @intCast(u8, 48 + n % 10)
    k += 1
    named(nameRoom[0..k])
}

// What the firmware's picture left as it was after a failed move: the
// controller's 1280x960 timing (1800 by 1000) running, the picture's
// memory at the aperture's start, the display clock's divider 0x5D, and
// the new output's transmitter off.
fn firmwareAgain(newBack: usize) -> void {
    expect(display.raw(0x1B80) == 1799 && display.raw(0x1B87) == 999 && display.raw(0x1B9C) & 1 != 0, "the controller runs the firmware's timing again")
    expect(display.raw(0x1A04) == 0 && display.raw(0x1A06) == 1280, "the picture's memory as it was")
    expect(display.raw(0x124) & 0x7F == 0x5D, "the display clock's divider as it was (0x5D)")
    expect(!backOn(newBack), "the new output's transmitter off")
    expect(display.count("gpu: the state of before is ") == 1, "the way back said once")
}

// Each table run of the three moves at boot refused by the card in turn
// (it does not take it: the table has not done its work), then a link
// that does not train, then a DTO that does not take its clock: the move
// not made, the way back taken, the firmware's picture where it was.
fn refusedAtBoot() -> void {
    var r: usize = 0
    while r < hdmiToDpRuns {
        usersWith("", 0, false)
        numbered("at boot: HDMI to DisplayPort, the card refuses table run", r)
        display.refuseRun = r
        boot()
        expect(bootResult.outcome != set.Outcome.done && follow.showing == 2, "not carried out; the picture's output as it was")
        expect(backOn(4) && !onDto() && (display.pll[4] == 107960 || display.pll[4] == 107962), "DIG 4 on again, its PLL the clock: the firmware's 107962 kHz, or the 107960 kHz the way back asks")
        firmwareAgain(2)
        line("gpu: the state of before is back")
        r += 1
    }
    r = 0
    while r < dpToHdmiRuns {
        numbered("at boot: DisplayPort to HDMI, the card refuses table run", r)
        card.usersOnDp(0, 0x06, 2, 0, 0x12, 0x14, users[0..])
        asTheUsers()
        card.pull()
        sw.monitor(2, users[0..])
        sw.line(2, true, sw.NEVER)
        display.refuseRun = r
        boot()
        expect(bootResult.outcome != set.Outcome.done && follow.showing == 0, "not carried out; the picture's output as it was")
        expect(onDto() && display.raw(0x141) == 108000000 && backMode(2) == scanout.MODE_DISPLAYPORT, "the DTO the clock at 108000 kHz, DIG 2 in DisplayPort mode")
        expect(display.raw(scanout.DIG[2] + scanout.DP_VID_N) == 0x8000 && display.raw(scanout.DIG[2] + scanout.DP_VID_M) == 0x8000 * 108000 / 162000, "the stream's N and M as the firmware had them")
        firmwareAgain(4)
        r += 1
    }
    r = 0
    while r < dpToDpRuns {
        numbered("at boot: DisplayPort to DisplayPort, the card refuses table run", r)
        card.usersOnDp(0, 0x06, 2, 0, 0x12, 0x14, users[0..])
        asTheUsers()
        card.pull()
        card.dpMonitor(1, 0x12, 0x14, 4, users[0..], true)
        display.refuseRun = r
        boot()
        expect(bootResult.outcome != set.Outcome.done && follow.showing == 0, "not carried out; the picture's output as it was")
        expect(onDto() && display.raw(0x141) == 108000000 && !streamOn(3), "the DTO the clock at 108000 kHz, no stream on DIG 3")
        firmwareAgain(3)
        r += 1
    }

    usersWith("at boot: HDMI to DisplayPort, the link does not train", 0, false)
    sink.stubborn = true
    boot()
    expect(bootResult.outcome != set.Outcome.done && follow.showing == 2 && backOn(4) && !onDto(), "not carried out; DIG 4 on again, its PLL the clock")
    firmwareAgain(2)
    line("gpu: the state of before is back")
    sink.stubborn = false

    usersWith("at boot: HDMI to DisplayPort, the DTO does not take its clock", 0, false)
    display.dtoDeaf = true
    boot()
    expect(bootResult.outcome != set.Outcome.done && follow.showing == 2 && backOn(4) && !onDto(), "not carried out; DIG 4 on again, its PLL the clock")
    firmwareAgain(2)
    line("gpu: the state of before is back")
    display.dtoDeaf = false
}

// ---- WHILE BRIXOS RUNS.

// The monitor's cable pulled from HDMI 2 (its line low), in DisplayPort
// connector `k` `later` on (its line high): when it was pulled.
fn hdmiToDp(k: usize, later: usize) -> usize {
    const t0 = display.clock
    sw.unplug(2)
    sw.line(2, false, sw.NEVER)
    ticks(t0 + later)
    card.dpMonitor(k, 0x12, 0x14, 4, users[0..], true)
    return t0
}

// The cable pulled from the DisplayPort connector it is in, in HDMI 2
// `later` on.
fn dpToHdmi(later: usize) -> usize {
    const t0 = display.clock
    card.pull()
    ticks(t0 + later)
    sw.monitor(2, users[0..])
    sw.line(2, true, sw.NEVER)
    return t0
}

// The cable pulled from the DisplayPort connector it is in, in
// DisplayPort connector `k` `later` on.
fn dpToDp(k: usize, later: usize) -> usize {
    const t0 = display.clock
    card.pull()
    ticks(t0 + later)
    card.dpMonitor(k, 0x12, 0x14, 4, users[0..], true)
    return t0
}

// Booted with the monitor on HDMI 2 (its own mode set there); its cable
// moved to DisplayPort connector 0, then to HDMI 2 again, then from
// DisplayPort connector 0 to connector 1: each followed.
fn runningMoves() -> void {
    usersWith("while running: HDMI to DisplayPort", NEVER, true)
    boot()
    expect(bootResult.outcome == set.Outcome.done && follow.showing == 2 && follow.width == 3840, "at boot: the monitor's own mode on HDMI 2")
    made = 0
    const surface = display.raw(0x1A04)
    const cleared = display.cleared
    var first = display.written
    display.logged = 0
    const engineRuns = lines.runs
    var t0 = hdmiToDp(0, 300 * MS)
    ticks(t0 + 3000 * MS)
    expect(made == 1 && follow.showing == 0 && follow.width == 3840, "moved to connector 0")
    expect(lines.runs == engineRuns && watch.ports.ports[0].asked == 1, "the DisplayPort monitor asked over its AUX channel alone, not over the DDC lines' I2C engine")
    expect(state.driver.kind == dm.Kind.RADEON_DP, "the display's driver: the Radeon's, for DisplayPort")
    expect(onDto() && backOn(2) && backMode(2) == scanout.MODE_DISPLAYPORT && !backOn(4) && streamOn(2) && locked(4), "DIG 2 on, its link trained, the DTO the clock; DIG 4 off")
    expect(display.raw(0x1A04) == surface && display.cleared == cleared, "the picture's memory as it was")
    expect(writesStayed(first, 2, 4), "the move wrote the two ends, the controller and the clocks alone")

    named("while running: DisplayPort to HDMI")
    first = display.written
    display.logged = 0
    t0 = dpToHdmi(300 * MS)
    ticks(t0 + 3000 * MS)
    expect(made == 2 && follow.showing == 2 && follow.width == 3840, "moved to connector 2")
    expect(state.driver.kind == dm.Kind.RADEON_TMDS, "the display's driver: the Radeon's, for HDMI and DVI")
    expect(!onDto() && backOn(4) && !backOn(2) && !streamOn(2), "DIG 4 on, the PLL the clock; DIG 2 and its stream off")
    expect(display.raw(0x1A04) == surface && display.cleared == cleared, "the picture's memory as it was")
    expect(writesStayed(first, 2, 4), "the move wrote the two ends, the controller and the clocks alone")

    named("while running: DisplayPort to DisplayPort")
    t0 = hdmiToDp(0, 300 * MS)
    ticks(t0 + 3000 * MS)
    expect(follow.showing == 0, "on connector 0 again")
    first = display.written
    display.logged = 0
    t0 = dpToDp(1, 300 * MS)
    ticks(t0 + 3000 * MS)
    expect(made == 4 && follow.showing == 1 && follow.width == 3840, "moved to connector 1")
    expect(onDto() && backOn(3) && !backOn(2) && streamOn(3) && !streamOn(2) && locked(4), "DIG 3 on, its link trained; DIG 2 and its stream off")
    expect(writesStayed(first, 2, 3), "the move wrote the two ends, the controller and the clocks alone")
}

// A move while brixOS runs that the card refuses once (a table run of it
// not taken): the way back, and the move made at the switch's next try
// 5 s later; from HDMI to DisplayPort, then back.
fn refusedOnceWhileRunning() -> void {
    usersWith("while running: HDMI to DisplayPort, refused once, made at the next try", NEVER, true)
    boot()
    made = 0
    display.refuseRun = display.runs + 4
    var t0 = hdmiToDp(0, 300 * MS)
    ticks(t0 + 3000 * MS)
    expect(made == 0 && follow.showing == 2 && backOn(4) && !onDto() && !backOn(2), "the first try not made: the picture on HDMI 2 as before")
    line("gpu: once more in 5 s (try 1 of 3)\n")
    ticks(t0 + 9000 * MS)
    expect(made == 1 && follow.showing == 0 && onDto() && backOn(2) && !backOn(4) && streamOn(2) && locked(4), "made at the next try")

    named("while running: DisplayPort to HDMI, refused once, made at the next try")
    made = 0
    display.logged = 0
    display.refuseRun = display.runs + 4
    t0 = dpToHdmi(300 * MS)
    ticks(t0 + 3000 * MS)
    expect(made == 0 && follow.showing == 0 && onDto() && backOn(2), "the first try not made: the picture on DisplayPort 0 as before")
    line("gpu: once more in 5 s (try 1 of 3)\n")
    ticks(t0 + 9000 * MS)
    expect(made == 1 && follow.showing == 2 && backOn(4) && !onDto() && !backOn(2), "made at the next try")
}

// ---- THE HOT PLUG LINE.

// The monitor on DisplayPort connector `k` asks to be looked at: its
// line's short pulse latched (DC_HPD_INT_STATUS's RX_INT_STATUS).
fn latch(k: usize) -> void {
    const at = plug.DC_HPD_INT_STATUS + (card.DP_LINES[k] - 1) * plug.HPD_STEP
    lines.registers[at] = lines.registers[at] | 0x100
}

fn latched(k: usize) -> bool { return lines.registers[plug.DC_HPD_INT_STATUS + (card.DP_LINES[k] - 1) * plug.HPD_STEP] & 0x100 != 0 }

// The monitor's lanes lose their clock and lock (a monitor that was off
// for a moment, a cable that moved in its plug).
fn loseLock() -> void {
    var k: usize = 0
    while k < 4 {
        sink.clockOf[k] = false
        sink.lockOf[k] = false
        k += 1
    }
}

// The hot plug line of the DisplayPort output that shows the picture: a
// short pulse with the link holding, one with it lost (trained again), the
// lanes looked at every 2 s (a lost link found so, and nothing said while
// it holds), a long pulse (the cable out and in again: the link trained
// again when the monitor is back).
fn pulses() -> void {
    usersWith("hot plug: a short pulse, the link holding", 0, false)
    boot()
    expect(bootResult.outcome == set.Outcome.done && follow.showing == 0 && locked(4), "at boot on connector 0")
    const surface = display.raw(0x1A04)
    display.logged = 0
    ticks(display.clock + 4500 * MS)
    noLine("its lanes looked at")
    expect(sinks.lost == 0 && sinks.pulses == 0, "the lanes looked at twice, holding: nothing said")
    const acks = card.acks
    latch(0)
    ticks(display.clock + 100 * MS)
    once("gpu: connector 0 (DisplayPort): a short pulse of its hot plug line (the monitor asks to be looked at): sink count 1, lanes 7 7 7 7, aligned: the link holds\n")
    expect(card.acks == acks + 1 && !latched(0) && sinks.pulses == 1 && sinks.lost == 0, "the latch acknowledged once and cleared")

    named("hot plug: a short pulse, the link lost")
    display.logged = 0
    loseLock()
    latch(0)
    ticks(display.clock + 1000 * MS)
    once("gpu: connector 0 (DisplayPort): a short pulse of its hot plug line (the monitor asks to be looked at): sink count 1, lanes 0 0 0 0, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes it ran\n")
    expect(sinks.lost == 1 && sinks.trained == 1 && locked(4) && sink.txCode == dplink.LINK_RATE_HIGH && sink.txLanes == 4, "trained again at 2.70 Gbit/s on 4 lanes, the lanes locked")
    expect(follow.showing == 0 && onDto() && streamOn(2) && display.raw(0x1A04) == surface && display.raw(0x141) == 270270000, "the picture as it was")

    named("hot plug: a short pulse, the lanes locked but not aligned")
    display.logged = 0
    sink.unaligned = true
    latch(0)
    ticks(display.clock + 1000 * MS)
    once("gpu: connector 0 (DisplayPort): a short pulse of its hot plug line (the monitor asks to be looked at): sink count 1, lanes 7 7 7 7, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes it ran\n")
    expect(sinks.lost == 2 && sinks.trained == 2 && locked(4) && !sink.unaligned, "trained again, aligned")
    // (The lost count goes on below.)
    sinks.lost = 1
    sinks.trained = 1

    named("hot plug: the lanes looked at every 2 s")
    display.logged = 0
    loseLock()
    ticks(display.clock + 2500 * MS)
    once("gpu: connector 0 (DisplayPort): its lanes looked at: sink count 1, lanes 0 0 0 0, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes it ran\n")
    expect(sinks.lost == 2 && sinks.trained == 2 && locked(4), "trained again")

    named("hot plug: a long pulse, the cable out and in")
    display.logged = 0
    lines.line(card.DP_LINES[0], false)
    ticks(display.clock + 500 * MS)
    once("gpu: the monitor was unplugged from connector 0 (DisplayPort): the picture still goes out there, to nothing\n")
    noLine("its lanes looked at")
    card.dpMonitor(0, 0x12, 0x14, 4, users[0..], true)
    ticks(display.clock + 3000 * MS)
    once("gpu: connector 0 (DisplayPort): the monitor is back on its line: sink count 1, lanes 0 0 0 0, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes it ran\n")
    once("gpu: connector 0 (DisplayPort): the monitor is back after 500 ms with its line low; the output sent all along, its link looked at as the monitor came back (said above): nothing more is written\n")
    expect(sinks.trained == 3 && locked(4) && follow.showing == 0 && made == 0, "trained again, nothing moved")
}

// ---- THE MODE CHANGED ON THE DISPLAYPORT OUTPUT.

// A program's request, as modes.mlx's `request` makes it: the time to
// confirm counted from when the mode runs.
fn ask(width: usize, height: usize) -> dm.Answer {
    const answer = state.ask(width, height, 0, display.clock)
    if answer == dm.Answer.changed { state.deadline = display.clock + dm.CONFIRM_TIME }
    return answer
}

// Booted with the picture brought to DisplayPort connector 0: 1920x1080
// asked for and set there (the DTO at its clock, the link that runs kept
// when it has room), taken back; asked again and confirmed; the time to
// confirm let pass on a third.
fn modeOnDp() -> void {
    usersWith("a mode change on the DisplayPort output", 0, false)
    boot()
    expect(follow.showing == 0 && stateDriver.kind == dm.Kind.RADEON_DP && state.driver.kind == dm.Kind.RADEON_DP, "the display's driver: the Radeon's, for DisplayPort")
    expect(state.list.find(1920, 1080, 0) != dm.NONE && state.list.find(1280, 720, 0) != dm.NONE, "1920x1080 and 1280x720 listed")
    const surface = display.raw(0x1A04)
    var first = display.written
    display.logged = 0
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 asked for and set")
    expect(follow.showing == 0 && follow.width == 1920 && follow.height == 1080 && follow.clock == 148500, "the switch's record is the new mode's")
    expect(onDto() && display.raw(0x141) == 148500000 && streamOn(2) && locked(4) && sink.txLanes == 4 && sink.txCode == dplink.LINK_RATE_HIGH, "the DTO at 148500 kHz, the link as it ran")
    line("gpu: plan (b, DisplayPort): the monitor holds the same link with every lane locked: it is kept\n")
    expect(display.raw(0x1A04) == seen.plan.offset && seen.plan.offset != surface, "the new picture where the display's state is told")
    expect(writesStayed(first, 2, 2), "the change wrote its output, the controller and the clocks alone")
    expect(holds == 1, "everything else held for the change")
    first = display.written
    expect(state.takeBack() == dm.Answer.taken_back && follow.width == 3840 && follow.clock == 270270 && display.raw(0x141) == 270270000 && display.raw(0x1A04) == seen.plan.offset && seen.plan.offset != surface + 0x1000000, "taken back: 3840x1080, the DTO at 270270 kHz, the picture where the display's state is told")
    expect(streamOn(2) && locked(4), "the stream on, the lanes locked")

    named("a mode change on the DisplayPort output, confirmed")
    expect(ask(1280, 720) == dm.Answer.changed && state.confirm() == dm.Answer.confirmed, "1280x720 set and confirmed")
    expect(follow.width == 1280 && follow.clock == 74250 && display.raw(0x141) == 74250000 && state.runs.width == 1280, "1280x720 runs")

    named("a mode change on the DisplayPort output, not confirmed")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 set")
    ticks(display.clock + dm.CONFIRM_TIME + 100 * MS)
    expect(!state.pending && state.runs.width == 1280 && follow.width == 1280 && display.raw(0x141) == 74250000, "not confirmed: 1280x720 again")
}

// ---- WHAT THE REVIEW ADDED.

// Another monitor's EDID (its own 3840x1080 at 266640 kHz, one block),
// and the user's with a second timing of its size (3840x1080 at 30 Hz,
// 135140 kHz, where the user's has its name).
var other: [256]u8 = undefined
var twoRates: [256]u8 = undefined

fn makeMoreEdids() -> void {
    _ = lines.edid(other[0..], 1, false)
    var k: usize = 0
    while k < 256 {
        twoRates[k] = users[k]
        k += 1
    }
    k = 0
    while k < 18 {
        twoRates[72 + k] = users[54 + k]
        k += 1
    }
    twoRates[72] = 0xCA
    twoRates[73] = 0x34
    resum(twoRates[0..], 0)
}

// The link of the DisplayPort output that shows the picture lost and
// not training again (the monitor set to another input: its line high,
// its lanes unlocked): the look every 2 s trains it once, says so, and
// leaves it; nothing more for 20 s, every other processor held once; the
// monitor's short pulse when it is back on this input trains it again.
fn notTrainingAgain() -> void {
    usersWith("hot plug: a link that does not train again, the monitor on another input", 0, false)
    boot()
    expect(follow.showing == 0 && locked(4), "at boot on connector 0")
    display.logged = 0
    const before = holds
    loseLock()
    sink.stubborn = true
    ticks(display.clock + 20000 * MS)
    expect(holds == before + 1 && sinks.lost == 1 && sinks.trained == 0, "trained again once in 20 s, every other processor held once")
    once("gpu: connector 0 (DisplayPort): its lanes looked at: sink count 1, lanes 0 0 0 0, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes it ran\n")
    once("gpu: connector 0 (DisplayPort): its link did not train again: the looks every 2 s leave it now; it is trained again when the monitor pulses its hot plug line or comes back on it\n")
    sink.stubborn = false
    latch(0)
    ticks(display.clock + 1000 * MS)
    expect(sinks.lost == 2 && sinks.trained == 1 && locked(4) && holds == before + 2, "the monitor's short pulse: trained again")
    expect(follow.showing == 0 && onDto() && streamOn(2), "the picture on connector 0 as it was")
}

// Another monitor of the picture's size plugged into the DisplayPort
// output that shows the picture: its link looked at as it comes, the
// timing that runs kept, said once; no plan of a TMDS output's is made
// for it, and nothing is tried again.
fn anotherOnDp() -> void {
    usersWith("hot plug: another monitor of the picture's size on the DisplayPort output", 0, false)
    boot()
    expect(follow.showing == 0 && locked(4), "at boot on connector 0")
    made = 0
    display.logged = 0
    card.pull()
    ticks(display.clock + 500 * MS)
    card.dpMonitor(0, 0x12, 0x14, 4, other[0..], true)
    ticks(display.clock + 40000 * MS)
    once("gpu: connector 0 (DisplayPort): another monitor of the picture's size, after 500 ms with the line low: the timing that runs stays, its link looked at as the monitor came (said above); a timing of its own on this DisplayPort output is set at the next start, not while brixOS runs\n")
    noLine("plan (the same output, TMDS)")
    noLine("once more in")
    expect(made == 0 && follow.showing == 0 && locked(4) && streamOn(2) && display.raw(0x141) == 270270000, "the picture and its timing as they were, the link trained again")
}

// At boot, the monitor on DisplayPort connector 0 with a link of 2.70
// Gbit/s on 2 lanes at most (180 MHz at 24 bits): its own 270270 kHz is
// beyond it; its EDID's other timing of its size, 30 Hz at 135140 kHz,
// is taken, as the TMDS end of a move takes one.
fn ownBeyondLink() -> void {
    usersWith("at boot: HDMI to DisplayPort, the monitor's own timing beyond the link: another of its size", NEVER, false)
    card.dpMonitor(0, 0x12, 0x0A, 2, twoRates[0..], true)
    boot()
    expect(bootPlan.complete && bootPlan.move.toDp && bootPlan.timing.clock == 135140 && bootPlan.tmds.another, "the plan takes the 30 Hz timing")
    line("; the monitor's own timing at 270270 kHz needs more: another of its size; for 135140 kHz at 24 bits: 2.70 Gbit/s on 2 lanes")
    expect(bootResult.outcome == set.Outcome.done && follow.showing == 0 && follow.width == 3840 && follow.clock == 135140, "the picture on connector 0 at 30 Hz")
    expect(sink.txLanes == 2 && sink.txCode == dplink.LINK_RATE_HIGH && locked(2) && display.raw(0x141) == 135140000, "the link of 2.70 Gbit/s on 2 lanes trained, the DTO at 135140 kHz")
}

// A monitor on DisplayPort connector 0 whose registers are of revision
// 1.0, and one whose AUX channel does not answer at all: at boot and
// while brixOS runs, said and not driven; the firmware's picture where it
// was, nothing of the card written but the channel's words.
fn notDriven() -> void {
    usersWith("at boot: a DisplayPort monitor no link is trained to (revision 1.0)", NEVER, false)
    card.dpMonitor(0, 0x10, 0x0A, 4, users[0..], true)
    boot()
    expect(watch.ports.ports[0].dp.state == dplink.Asked.heard && watch.ports.ports[0].dp.refusal == dplink.Refusal.old, "the monitor answers, its revision refused")
    expect(decided.act != rule.Act.move && follow.showing == 2 && bootResult.outcome == set.Outcome.untouched, "not driven: the picture stays on connector 2")
    firmwareAgainUnsaid(2)

    usersWith("while running: a DisplayPort monitor no link is trained to (revision 1.0)", NEVER, true)
    boot()
    made = 0
    display.logged = 0
    sw.unplug(2)
    sw.line(2, false, sw.NEVER)
    ticks(display.clock + 300 * MS)
    card.dpMonitor(0, 0x10, 0x0A, 4, users[0..], true)
    ticks(display.clock + 10000 * MS)
    once("gpu: connector 0 (DisplayPort): its monitor answers on its AUX channel, and no link is trained to it (its registers are of a revision before 1.1): it is not driven\n")
    expect(made == 0 && follow.showing == 2 && backOn(4) && !backOn(2), "not driven: the picture stays on connector 2")

    usersWith("at boot: a DisplayPort monitor whose AUX channel does not answer", 0, false)
    sink.deadFrom = 0
    const first = display.written
    boot()
    line("gpu: connector 0 (DisplayPort): nothing answers on its AUX channel 1: no monitor that can be asked (one that is off, an adapter to HDMI or DVI, or none)\n")
    expect(decided.act != rule.Act.move && follow.showing == 2 && bootResult.outcome == set.Outcome.untouched, "not driven: the picture stays on connector 2")
    expect(writesStayed(first, 4, 4), "nothing of the card written but the channel's words")
    firmwareAgainUnsaid(2)
    sink.deadFrom = NEVER
}

// The firmware's picture as it was, with nothing said of a way back.
fn firmwareAgainUnsaid(newBack: usize) -> void {
    expect(display.raw(0x1B80) == 1799 && display.raw(0x1B87) == 999 && display.raw(0x1A04) == 0, "the controller runs the firmware's timing and picture")
    expect(display.raw(0x124) & 0x7F == 0x5D && !backOn(newBack), "the display clock's divider 0x5D, the other output's transmitter off")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    makeEdids()
    makeMoreEdids()
    open()
    lend()
    bootHdmiToDp()
    bootDpToHdmi()
    bootDpToDp()
    refusedAtBoot()
    runningMoves()
    refusedOnceWhileRunning()
    made = 0
    pulses()
    modeOnDp()
    notTrainingAgain()
    anotherOnDp()
    ownBeyondLink()
    notDriven()
    if failed != 0 { return failed }
    return 13
}
