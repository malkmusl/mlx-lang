// std.hash: wyhash (final version 4.3) against the reference
// implementation's values for the messages of its test_vector.cpp (seed =
// the message's index) and for lengths 17, 33, 47, 48, 49, 100 and 200
// bytes of a pattern; hashWord and combine; autoHash and autoEql over
// integers (signed ones alike at every width), bools, enums, floats,
// pointers, optionals, byte slices (by content), slices and arrays of
// other plain elements; the StringContext. (Structs, tuples and an
// optional holding 0: tests/391_hash_aggregates_runtime.mlx.) Exits 13
// on success (another number: the check that failed).
const std = @import("std")
const hash = @import("std.hash")

const Colour = enum(u8) { red, green, blue }

fn vector(message: []const u8, seed: u64, expected: u64) -> bool {
    return hash.wyhash(message, seed) == expected
}

fn main() -> u8 {
    // The reference's vectors (test_vector.cpp, final version 4.3).
    if !vector("", 0, 10602188539874428322) { return 1 }
    if !vector("a", 1, 14247915716899967940) { return 2 }
    if !vector("abc", 2, 12213532920276267796) { return 3 }
    if !vector("message digest", 3, 8677626270512586228) { return 4 }
    if !vector("abcdefghijklmnopqrstuvwxyz", 4, 15899298861388364935) { return 5 }
    if !vector("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", 5, 13395733826728079216) { return 6 }
    if !vector("12345678901234567890123456789012345678901234567890123456789012345678901234567890", 6, 7837928787916543511) { return 7 }
    // Every branch of the length: bytes i * 7 + 3.
    var pattern: [200]u8 = undefined
    var at: usize = 0
    while at < 200 {
        pattern[at] = @intCast(u8, (at * 7 + 3) & 255)
        at += 1
    }
    const bytes: [*]const u8 = &pattern
    if hash.wyhash(bytes[0..17], 0) != 11915455234655758108 { return 8 }
    if hash.wyhash(bytes[0..33], 0) != 3522582260314334054 { return 9 }
    if hash.wyhash(bytes[0..47], 0) != 7606109155270349622 { return 10 }
    if hash.wyhash(bytes[0..48], 0) != 2462206392380690721 { return 11 }
    if hash.wyhash(bytes[0..49], 0) != 6789773886396795242 { return 12 }
    if hash.wyhash(bytes[0..100], 0) != 8757693988890262260 { return 14 }
    if hash.wyhash(bytes[0..200], 0) != 5870970308133810715 { return 15 }
    if hash.hashBytes("abc") != hash.wyhash("abc", 0) { return 16 }

    // Words and combining: different words differ, order matters.
    if hash.hashWord(0) == hash.hashWord(1) { return 17 }
    if hash.hashWord(0) == 0 { return 18 }
    const ab = hash.combine(hash.combine(0, hash.hashWord(1)), hash.hashWord(2))
    const ba = hash.combine(hash.combine(0, hash.hashWord(2)), hash.hashWord(1))
    if ab == ba { return 19 }

    // Integers: the same value at every width, signed alike.
    if hash.autoHash(u8, 7) != hash.autoHash(u64, 7) { return 20 }
    const minus: i8 = -1
    const minus_wide: i64 = -1
    if hash.autoHash(i8, minus) != hash.autoHash(i64, minus_wide) { return 21 }
    if hash.autoHash(u32, 7) == hash.autoHash(u32, 8) { return 22 }
    if !hash.autoEql(u32, 7, 7) || hash.autoEql(u32, 7, 8) { return 23 }
    // Bools and enums.
    if hash.autoHash(bool, true) == hash.autoHash(bool, false) { return 24 }
    if hash.autoHash(Colour, Colour.red) == hash.autoHash(Colour, Colour.blue) { return 25 }
    if !hash.autoEql(Colour, Colour.green, Colour.green) || hash.autoEql(Colour, Colour.green, Colour.blue) { return 26 }
    // Floats by their bits.
    const one: f64 = 1.0
    const two: f64 = 2.0
    if hash.autoHash(f64, one) == hash.autoHash(f64, two) { return 27 }
    if !hash.autoEql(f64, one, one) { return 28 }
    const small: f32 = 1.5
    const small_bits = @bitCast(u32, small)
    if hash.autoHash(f32, small) != hash.hashWord(@intCast(u64, small_bits) & 4294967295) { return 29 }
    // Pointers by address.
    var words: [2]u32 = [2]u32{ 1, 1 }
    const first: *u32 = &words[0]
    const second: *u32 = &words[1]
    if hash.autoHash(*u32, first) == hash.autoHash(*u32, second) { return 30 }
    if hash.autoEql(*u32, first, second) || !hash.autoEql(*u32, first, first) { return 31 }
    // Optionals: null apart from any value (apart from 0 too:
    // tests/391_hash_aggregates_runtime.mlx).
    const none: ?u32 = null
    const zero: ?u32 = 9
    const seven: ?u32 = 7
    if hash.autoHash(@typeOf(none), none) == hash.autoHash(@typeOf(zero), zero) { return 32 }
    if hash.autoHash(@typeOf(seven), seven) == hash.autoHash(@typeOf(zero), zero) { return 33 }
    if hash.autoHash(@typeOf(seven), seven) != hash.autoHash(@typeOf(seven), seven) { return 34 }
    if !hash.autoEql(@typeOf(none), none, none) || hash.autoEql(@typeOf(none), none, zero) { return 35 }
    if !hash.autoEql(@typeOf(seven), seven, seven) || hash.autoEql(@typeOf(seven), seven, zero) { return 36 }
    // Byte slices by content: two copies hash alike, as wyhash does.
    var copy: [3]u8 = [3]u8{ 97, 98, 99 }
    const copy_bytes: [*]const u8 = &copy
    const copied: []const u8 = copy_bytes[0..3]
    if hash.autoHash([]const u8, copied) != hash.autoHash([]const u8, "abc") { return 37 }
    if hash.autoHash([]const u8, copied) != hash.wyhash("abc", 0) { return 38 }
    if !hash.autoEql([]const u8, copied, "abc") || hash.autoEql([]const u8, copied, "abd") { return 39 }
    // Slices and arrays of wider elements, element by element.
    var numbers: [3]u32 = [3]u32{ 1, 2, 3 }
    var others: [3]u32 = [3]u32{ 1, 2, 4 }
    const number_slice: []const u32 = numbers[0..3]
    const other_slice: []const u32 = others[0..3]
    if hash.autoHash([]const u32, number_slice) == hash.autoHash([]const u32, other_slice) { return 40 }
    if hash.autoHash([]const u32, number_slice) != hash.autoHash([]const u32, numbers[0..3]) { return 41 }
    if !hash.autoEql([]const u32, number_slice, numbers[0..3]) || hash.autoEql([]const u32, number_slice, other_slice) { return 42 }
    if hash.autoHash([3]u32, numbers) != hash.autoHash([]const u32, number_slice) { return 43 }
    if hash.autoHash([3]u32, numbers) == hash.autoHash([3]u32, others) { return 44 }
    if !hash.autoEql([3]u32, numbers, numbers) || hash.autoEql([3]u32, numbers, others) { return 45 }
    // (Structs and tuples: tests/391_hash_aggregates_runtime.mlx.)
    // The string context.
    const context = hash.StringContext.{}
    if hash.StringContext.hash(context, "abc") != hash.wyhash("abc", 0) { return 52 }
    if !hash.StringContext.eql(context, "abc", copied) || hash.StringContext.eql(context, "abc", "ab") { return 53 }
    return 13
}
