// std.md5 and std.blake2: the test suite of RFC 1321 (appendix A.5), one
// call and in pieces; BLAKE2b-512 of "abc" from RFC 7693 (appendix A), of
// nothing, as BLAKE2b-256, and keyed with the bytes 0 to 63 as the
// reference implementation's known answers have it (blake2b-kat.txt:
// messages of 0, 1 and 255 bytes, the last in pieces across blocks).
// Exits 13 when every check holds, else the number of the first check
// that failed.
const md5 = @import("std.md5")
const blake2 = @import("std.blake2")
const base64 = @import("std.base64")

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// Whether `digest` is `hex` written out.
fn digestIs(digest: [*]const u8, length: usize, hex: []const u8) -> bool {
    var text: [128]u8 = undefined
    const out: [*]u8 = &text
    const count = base64.hexEncode(digest[0..length], out)
    return same(out[0..count], hex)
}

fn md5Is(message: []const u8, hex: []const u8) -> bool {
    var digest: [16]u8 = undefined
    md5.md5(message, &digest)
    const bytes: [*]const u8 = &digest
    if !digestIs(bytes, 16, hex) { return false }
    // Seven bytes at a time.
    var hashing: md5.Md5 = undefined
    md5.md5Init(&hashing)
    var at: usize = 0
    while at < message.length {
        const end = if at + 7 < message.length { at + 7 } else { message.length }
        md5.md5Update(&hashing, message[at..end])
        at = end
    }
    var again: [16]u8 = undefined
    md5.md5Final(&hashing, &again)
    const againBytes: [*]const u8 = &again
    if !digestIs(againBytes, 16, hex) { return false }
    var text: [32]u8 = undefined
    md5.md5Hex(message, &text)
    const textBytes: [*]const u8 = &text
    return same(textBytes[0..32], hex)
}

pub fn main() -> u8 {
    if !md5Is("", "d41d8cd98f00b204e9800998ecf8427e") { return 1 }
    if !md5Is("a", "0cc175b9c0f1b6a831c399e269772661") { return 2 }
    if !md5Is("abc", "900150983cd24fb0d6963f7d28e17f72") { return 3 }
    if !md5Is("message digest", "f96b697d7cb7938d525a2f31aaf161d0") { return 4 }
    if !md5Is("abcdefghijklmnopqrstuvwxyz", "c3fcd3d76192e4007dfb496cca67e13b") { return 5 }
    if !md5Is("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", "d174ab98d277d9f5a5611c2c9f419d9f") { return 6 }
    if !md5Is("12345678901234567890123456789012345678901234567890123456789012345678901234567890", "57edf4a22be3c955ac49da2e2107b67a") { return 7 }

    var digest: [64]u8 = undefined
    const bytes: [*]u8 = &digest
    blake2.blake2b("abc", &digest)
    if !digestIs(bytes, 64, "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923") { return 8 }
    blake2.blake2b("", &digest)
    if !digestIs(bytes, 64, "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce") { return 9 }
    blake2.blake2bWith("abc", "", bytes, 32)
    if !digestIs(bytes, 32, "bddd813c634239723171ef3fee98579b94964e3bb1cb3e427262c8c068d52319") { return 10 }

    // The known answers: key 00 01 .. 3f, message 00 01 .. (n - 1).
    var counting: [255]u8 = undefined
    var index: usize = 0
    while index < 255 {
        counting[index] = @intCast(u8, index)
        index += 1
    }
    const sequence: [*]const u8 = &counting
    const key = sequence[0..64]
    blake2.blake2bWith(sequence[0..0], key, bytes, 64)
    if !digestIs(bytes, 64, "10ebb67700b1868efb4417987acf4690ae9d972fb7a590c2f02871799aaa4786b5e996e8f0f4eb981fc214b005f42d2ff4233499391653df7aefcbc13fc51568") { return 11 }
    blake2.blake2bWith(sequence[0..1], key, bytes, 64)
    if !digestIs(bytes, 64, "961f6dd1e4dd30f63901690c512e78e4b45e4742ed197c3c5e45c549fd25f2e4187b0bc9fe30492b16b0d0bc4ef9b0f34c7003fac09a5ef1532e69430234cebd") { return 12 }
    const long = "142709d62e28fcccd0af97fad0f8465b971e82201dc51070faa0372aa43e92484be1c1e73ba10906d5d1853db6a4106e0a7bf9800d373d6dee2d46d62ef2a461"
    blake2.blake2bWith(sequence[0..255], key, bytes, 64)
    if !digestIs(bytes, 64, long) { return 14 }
    // In pieces of 0, 128 (a block exactly), 1 and the rest.
    var hashing: blake2.Blake2b = undefined
    blake2.blake2bInit(&hashing, 64, key)
    blake2.blake2bUpdate(&hashing, sequence[0..0])
    blake2.blake2bUpdate(&hashing, sequence[0..128])
    blake2.blake2bUpdate(&hashing, sequence[128..129])
    blake2.blake2bUpdate(&hashing, sequence[129..255])
    blake2.blake2bFinal(&hashing, bytes)
    if !digestIs(bytes, 64, long) { return 15 }
    return 13
}
