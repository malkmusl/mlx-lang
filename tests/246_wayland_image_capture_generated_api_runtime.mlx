// The materialized std.wayland API includes the complete image-copy capture
// protocol family and its foreign-toplevel dependency. This checks interface
// versions, wire signatures, typed object references, destructor metadata,
// the options bitfield, and generated client/server types. Exits 13.
const wl = @import("std.wayland")

fn same(left: []const u8, right: []const u8) -> bool {
    var left_length: usize = 0
    for byte in left { left_length += 1 }
    var right_length: usize = 0
    for byte in right { right_length += 1 }
    if left_length != right_length { return false }
    var index: usize = 0
    for byte in left {
        if right[index] != byte { return false }
        index += 1
    }
    return true
}

pub fn main() -> u8 {
    // The three protocols add nine interfaces to the existing 44.
    if wl.interfaces.COUNT != 63 { return 1 }
    if wl.ext_foreign_toplevel_list_v1.VERSION != 1 || wl.ext_foreign_toplevel_handle_v1.VERSION != 1 { return 2 }
    if wl.ext_image_capture_source_v1.VERSION != 1 || wl.ext_output_image_capture_source_manager_v1.VERSION != 1 || wl.ext_foreign_toplevel_image_capture_source_manager_v1.VERSION != 1 { return 3 }
    if wl.ext_image_copy_capture_manager_v1.VERSION != 1 || wl.ext_image_copy_capture_session_v1.VERSION != 1 || wl.ext_image_copy_capture_frame_v1.VERSION != 1 || wl.ext_image_copy_capture_cursor_session_v1.VERSION != 1 { return 4 }

    // Declaration-order opcodes map to the exact libwayland signatures.
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_foreign_toplevel_list_v1, 0), "") || !same(wl.interfaces.requestSignature(wl.Interface.ext_foreign_toplevel_list_v1, 1), "") { return 5 }
    if !same(wl.interfaces.eventSignature(wl.Interface.ext_foreign_toplevel_list_v1, 0), "n") || !same(wl.interfaces.eventSignature(wl.Interface.ext_foreign_toplevel_list_v1, 1), "") { return 6 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_foreign_toplevel_handle_v1, 0), "") { return 7 }
    if !same(wl.interfaces.eventSignature(wl.Interface.ext_foreign_toplevel_handle_v1, 0), "") || !same(wl.interfaces.eventSignature(wl.Interface.ext_foreign_toplevel_handle_v1, 1), "") || !same(wl.interfaces.eventSignature(wl.Interface.ext_foreign_toplevel_handle_v1, 2), "s") || !same(wl.interfaces.eventSignature(wl.Interface.ext_foreign_toplevel_handle_v1, 3), "s") || !same(wl.interfaces.eventSignature(wl.Interface.ext_foreign_toplevel_handle_v1, 4), "s") { return 8 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_image_capture_source_v1, 0), "") { return 9 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_output_image_capture_source_manager_v1, 0), "no") || !same(wl.interfaces.requestSignature(wl.Interface.ext_output_image_capture_source_manager_v1, 1), "") { return 10 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 0), "no") || !same(wl.interfaces.requestSignature(wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 1), "") { return 11 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_manager_v1, 0), "nou") || !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_manager_v1, 1), "noo") || !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_manager_v1, 2), "") { return 12 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_session_v1, 0), "n") || !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_session_v1, 1), "") { return 14 }
    if !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_session_v1, 0), "uu") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_session_v1, 1), "u") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_session_v1, 2), "a") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_session_v1, 3), "ua") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_session_v1, 4), "") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_session_v1, 5), "") { return 15 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_frame_v1, 0), "") || !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_frame_v1, 1), "o") || !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_frame_v1, 2), "iiii") || !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_frame_v1, 3), "") { return 16 }
    if !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_frame_v1, 0), "u") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_frame_v1, 1), "iiii") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_frame_v1, 2), "uuu") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_frame_v1, 3), "") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_frame_v1, 4), "u") { return 17 }
    if !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_cursor_session_v1, 0), "") || !same(wl.interfaces.requestSignature(wl.Interface.ext_image_copy_capture_cursor_session_v1, 1), "n") { return 18 }
    if !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_cursor_session_v1, 0), "") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_cursor_session_v1, 1), "") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_cursor_session_v1, 2), "ii") || !same(wl.interfaces.eventSignature(wl.Interface.ext_image_copy_capture_cursor_session_v1, 3), "ii") { return 19 }

    // Cross-protocol and core object/new_id references stay typed.
    var target = wl.Interface.wl_display
    if !wl.interfaces.eventArgInterface(wl.Interface.ext_foreign_toplevel_list_v1, 0, 0, &target) || target != wl.Interface.ext_foreign_toplevel_handle_v1 { return 20 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_output_image_capture_source_manager_v1, 0, 0, &target) || target != wl.Interface.ext_image_capture_source_v1 { return 21 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_output_image_capture_source_manager_v1, 0, 1, &target) || target != wl.Interface.wl_output { return 22 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 0, 0, &target) || target != wl.Interface.ext_image_capture_source_v1 { return 23 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 0, 1, &target) || target != wl.Interface.ext_foreign_toplevel_handle_v1 { return 24 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_manager_v1, 0, 0, &target) || target != wl.Interface.ext_image_copy_capture_session_v1 { return 25 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_manager_v1, 0, 1, &target) || target != wl.Interface.ext_image_capture_source_v1 { return 26 }
    if wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_manager_v1, 0, 2, &target) { return 27 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_manager_v1, 1, 0, &target) || target != wl.Interface.ext_image_copy_capture_cursor_session_v1 { return 28 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_manager_v1, 1, 1, &target) || target != wl.Interface.ext_image_capture_source_v1 { return 29 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_manager_v1, 1, 2, &target) || target != wl.Interface.wl_pointer { return 30 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_session_v1, 0, 0, &target) || target != wl.Interface.ext_image_copy_capture_frame_v1 { return 31 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_frame_v1, 1, 0, &target) || target != wl.Interface.wl_buffer { return 32 }
    if !wl.interfaces.requestArgInterface(wl.Interface.ext_image_copy_capture_cursor_session_v1, 1, 0, &target) || target != wl.Interface.ext_image_copy_capture_session_v1 { return 33 }

    // Every XML destroy request is marked as a destructor, and no preceding
    // non-destroy request is accidentally marked as one.
    if wl.interfaces.requestDestructor(wl.Interface.ext_foreign_toplevel_list_v1, 0) || !wl.interfaces.requestDestructor(wl.Interface.ext_foreign_toplevel_list_v1, 1) { return 34 }
    if !wl.interfaces.requestDestructor(wl.Interface.ext_foreign_toplevel_handle_v1, 0) { return 35 }
    if !wl.interfaces.requestDestructor(wl.Interface.ext_image_capture_source_v1, 0) { return 36 }
    if wl.interfaces.requestDestructor(wl.Interface.ext_output_image_capture_source_manager_v1, 0) || !wl.interfaces.requestDestructor(wl.Interface.ext_output_image_capture_source_manager_v1, 1) { return 37 }
    if wl.interfaces.requestDestructor(wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 0) || !wl.interfaces.requestDestructor(wl.Interface.ext_foreign_toplevel_image_capture_source_manager_v1, 1) { return 38 }
    if wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_manager_v1, 0) || wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_manager_v1, 1) || !wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_manager_v1, 2) { return 39 }
    if wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_session_v1, 0) || !wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_session_v1, 1) { return 40 }
    if !wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_frame_v1, 0) || wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_frame_v1, 1) || wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_frame_v1, 2) || wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_frame_v1, 3) { return 41 }
    if !wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_cursor_session_v1, 0) || wl.interfaces.requestDestructor(wl.Interface.ext_image_copy_capture_cursor_session_v1, 1) { return 42 }

    if @intFromEnum(wl.ext_image_copy_capture_manager_v1.Options.paint_cursors) != 1 { return 43 }

    // Both generated sides are part of the public per-interface namespaces.
    if @sizeOf(wl.ext_foreign_toplevel_list_v1.Proxy) == 0 || @sizeOf(wl.ext_foreign_toplevel_list_v1.Resource) == 0 { return 44 }
    if @sizeOf(wl.ext_foreign_toplevel_handle_v1.Proxy) == 0 || @sizeOf(wl.ext_foreign_toplevel_handle_v1.Resource) == 0 { return 45 }
    if @sizeOf(wl.ext_image_capture_source_v1.Proxy) == 0 || @sizeOf(wl.ext_image_capture_source_v1.Resource) == 0 { return 46 }
    if @sizeOf(wl.ext_output_image_capture_source_manager_v1.Proxy) == 0 || @sizeOf(wl.ext_output_image_capture_source_manager_v1.Resource) == 0 { return 47 }
    if @sizeOf(wl.ext_foreign_toplevel_image_capture_source_manager_v1.Proxy) == 0 || @sizeOf(wl.ext_foreign_toplevel_image_capture_source_manager_v1.Resource) == 0 { return 48 }
    if @sizeOf(wl.ext_image_copy_capture_manager_v1.Proxy) == 0 || @sizeOf(wl.ext_image_copy_capture_manager_v1.Resource) == 0 { return 49 }
    if @sizeOf(wl.ext_image_copy_capture_session_v1.Proxy) == 0 || @sizeOf(wl.ext_image_copy_capture_session_v1.Resource) == 0 { return 50 }
    if @sizeOf(wl.ext_image_copy_capture_frame_v1.Proxy) == 0 || @sizeOf(wl.ext_image_copy_capture_frame_v1.Resource) == 0 { return 51 }
    if @sizeOf(wl.ext_image_copy_capture_cursor_session_v1.Proxy) == 0 || @sizeOf(wl.ext_image_copy_capture_cursor_session_v1.Resource) == 0 { return 52 }
    return 13
}
