// std.ArrayList(T): elements appended one by one, as a slice and n times,
// the items slice, growth through the allocator's resize, insert,
// orderedRemove and swapRemove, pop and last, resize, initCapacity,
// toOwnedSlice and fromOwnedSlice, clearRetainingCapacity and
// clearAndFree, a list of structs and one of strings, a list dropped
// where its scope ends, and 100 000 appends and pops under the leak check
// with every block given back. Exits 13 on success (another number: the
// check that failed).
const std = @import("std")
const leaks = @import("std.leaks")

const Pair = struct {
    key: u32
    value: u64
}

fn sumOf(values: []const u32) -> u64 {
    var total: u64 = 0
    for value in values { total += @intCast(u64, value) }
    return total
}

// A list made and filled in a scope of its own: dropped at its end.
fn fillAndDrop(allocator: std.allocator.Allocator) -> usize {
    var list = std.ArrayList(u64).init(allocator)
    var at: u64 = 0
    while at < 1000 {
        if !list.append(at) { return 0 }
        at += 1
    }
    return list.count()
}

fn main() -> u8 {
    leaks.watchAlways()
    const allocator = std.heap.allocator()
    const live_before = leaks.liveCount()
    {
        var numbers = std.ArrayList(u32).init(allocator)
        if numbers.count() != 0 || numbers.items().length != 0 || numbers.pop() != null || numbers.last() != null { return 1 }
        if !numbers.append(1) || !numbers.append(2) || !numbers.append(3) { return 2 }
        if numbers.count() != 3 || numbers.items().length != 3 { return 3 }
        if numbers.items()[0] != 1 || numbers.items()[2] != 3 { return 4 }
        if sumOf(numbers.items()) != 6 { return 5 }
        const more: [3]u32 = [3]u32{ 4, 5, 6 }
        if !numbers.appendSlice(more[0..3]) || numbers.count() != 6 || sumOf(numbers.items()) != 21 { return 6 }
        if !numbers.appendNTimes(7, 4) || numbers.count() != 10 || sumOf(numbers.items()) != 49 { return 7 }
        // Insert at the start, in the middle, at the end.
        if !numbers.insert(0, 100) || numbers.items()[0] != 100 || numbers.items()[1] != 1 || numbers.count() != 11 { return 8 }
        if !numbers.insert(5, 200) || numbers.items()[5] != 200 || numbers.items()[6] != 5 { return 9 }
        if !numbers.insert(12, 300) || numbers.items()[12] != 300 || numbers.count() != 13 { return 10 }
        if numbers.insert(20, 1) { return 11 }
        // Removed in order, and by swapping the last in.
        if numbers.orderedRemove(0) != 100 || numbers.items()[0] != 1 || numbers.count() != 12 { return 12 }
        if numbers.orderedRemove(4) != 200 || numbers.items()[4] != 5 || numbers.count() != 11 { return 14 }
        if numbers.swapRemove(0) != 1 || numbers.items()[0] != 300 || numbers.count() != 10 { return 15 }
        if numbers.swapRemove(9) != 7 || numbers.count() != 9 { return 16 }
        // Popped.
        const popped = numbers.pop()
        if popped == null || popped.? != 7 || numbers.count() != 8 { return 17 }
        const last = numbers.last()
        if last == null || last.? != 7 { return 18 }
        // Resized: cut, then grown (the new elements whatever they are).
        if !numbers.resize(3) || numbers.count() != 3 || numbers.items()[2] != 3 { return 19 }
        if !numbers.resize(50) || numbers.count() != 50 { return 20 }
        numbers.items()[49] = 49
        if numbers.items()[49] != 49 || numbers.items()[2] != 3 { return 21 }
        // Cleared with the memory kept, then given back.
        const room = numbers.capacity
        numbers.clearRetainingCapacity()
        if numbers.count() != 0 || numbers.capacity != room { return 22 }
        if !numbers.append(9) || numbers.items()[0] != 9 { return 23 }
        numbers.clearAndFree()
        if numbers.count() != 0 || numbers.capacity != 0 { return 24 }
        if !numbers.append(10) || numbers.items()[0] != 10 { return 25 }
    }
    // Room asked for ahead, and the block taken out and given back.
    {
        var list = std.ArrayList(u32).initCapacity(allocator, 100)
        if list.capacity < 100 || list.count() != 0 { return 26 }
        const room = list.capacity
        var at: u32 = 0
        while at < 100 {
            if !list.append(at) { return 27 }
            at += 1
        }
        if list.capacity != room { return 28 }
        const owned = list.toOwnedSlice()
        if owned.length != 100 || owned[99] != 99 || list.count() != 0 || list.capacity != 0 { return 29 }
        var again = std.ArrayList(u32).fromOwnedSlice(allocator, owned)
        if again.count() != 100 || again.capacity != 100 || again.items()[50] != 50 { return 30 }
        if !again.append(100) || again.count() != 101 || again.capacity <= 100 { return 31 }
        if !again.ensureTotalCapacity(1000) || again.capacity < 1000 { return 32 }
        if !again.ensureUnusedCapacity(5000) || again.capacity < 5101 { return 33 }
    }
    // Structs and strings as elements.
    {
        var pairs = std.ArrayList(Pair).init(allocator)
        if !pairs.append(Pair.{ .key = 1, .value = 10 }) || !pairs.append(Pair.{ .key = 2, .value = 20 }) { return 34 }
        if pairs.items()[1].value != 20 || pairs.count() != 2 { return 35 }
        pairs.items()[0].value = 11
        if pairs.items()[0].value != 11 { return 36 }
        var words = std.ArrayList([]const u8).init(allocator)
        if !words.append("one") || !words.append("two") { return 37 }
        if words.items()[1].length != 3 || words.items()[1][0] != 116 { return 38 }
        const taken = words.pop()
        if taken == null || taken.?.length != 3 || words.count() != 1 { return 39 }
    }
    // Dropped where its scope ends.
    if fillAndDrop(allocator) != 1000 { return 40 }
    if leaks.liveCount() != live_before { return 41 }
    // 100 000 appends and pops under the leak check.
    {
        var stress = std.ArrayList(u64).init(allocator)
        var seed: u64 = 7
        var round: usize = 0
        var expected: u64 = 0
        while round < 100000 {
            seed = seed *% 6364136223846793005 +% 1442695040888963407
            if stress.count() == 0 || (seed >> 33) % 3 != 0 {
                if !stress.append(@intCast(u64, round)) { return 42 }
            } else {
                _ = stress.pop()
            }
            round += 1
        }
        for value in stress.items() { expected += value }
        if stress.count() == 0 || expected == 0 { return 43 }
        leaks.writeNow()
        stress.deinit()
    }
    if leaks.liveCount() != live_before || leaks.problemCount() != 0 { return 44 }
    return 13
}
