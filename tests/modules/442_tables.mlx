// Tables for tests/442_constant_table_static_runtime.mlx: read from
// another module by its name (tests/443_constant_slices_runtime.mlx
// slices PRIMES).
pub const PRIMES = [8]u16{ 2, 3, 5, 7, 11, 13, 17, 19 }
pub const Corner = struct { x: i32, y: i32 }
pub const CORNERS = [3]Corner{ Corner.{ .x = -1, .y = 2 }, Corner.{ .x = 3, .y = -4 }, Corner.{ .x = 5, .y = 6 } }
pub const WIDTH: u8 = 4
pub const ROW = [4]u8{ 1, 2, 3, WIDTH }
// A `var` whose initializer names a constant of this module: its image is
// made the first time it is named, in whatever function that is.
const SWITCH = false
pub var switches = [2]bool{ SWITCH, true }
