// Tables for tests/523_constant_table_addresses_runtime.mlx: rows naming
// this module's functions, its strings and slices of its other tables,
// read from another module (as a registry of filters is).
pub const Param = struct {
    name: []const u8
    low: f64
    high: f64
}

pub const PARAMS = [3]Param{
    Param.{ .name = "Red", .low = 0.0, .high = 255.0 },
    Param.{ .name = "Grün", .low = -1.5, .high = 1.5 },
    Param.{ .name = "Blue", .low = 2.0, .high = 4.0 },
}

pub fn double(x: i64) -> i64 { return x * 2 }
pub fn square(x: i64) -> i64 { return x * x }

pub const Info = struct {
    key: []const u8
    params: []const Param
    render: fn(i64) -> i64
}

pub const INFOS = [2]Info{
    Info.{ .key = "double", .params = PARAMS[0..], .render = double },
    Info.{ .key = "square", .params = PARAMS[1..3], .render = square },
}

pub const GREETING = "hello"
