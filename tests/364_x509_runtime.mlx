// std.asn1 and std.x509 on a small PKI made by OpenSSL (through Python's
// cryptography): an RSA root, a P-256 intermediate it signed with
// RSA-PSS, a P-384 server certificate the intermediate signed with ECDSA
// (alternative names: DNS names, a wildcard, IPv4 and IPv6 addresses), a
// self-signed Ed25519 certificate and a client-only one. Their fields,
// names as OpenSSL prints them (RFC 2253), hostnames (RFC 6125), chains
// verified at times inside and outside their validity, without their
// intermediate, without an anchor, with a signature changed; and the
// system's CA bundle read whole, when there is one. Exits 13 when every
// check holds, else the number of the first check that failed.
const std = @import("std")
const base64 = @import("std.base64")
const asn1 = @import("std.asn1")
const x509 = @import("std.x509")

const ROOT = ""
const INTER = ""
const LEAF = ""
const ED = ""
const CLIENT = ""

// Inside every certificate's validity: 2026-06-01.
const MIDDLE: i64 = 1780272000
const LEAF_FROM: i64 = 1735689600
const LEAF_UNTIL: i64 = 1798761600

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn load(hex: []const u8, out: [*]u8, cert: *x509.Certificate) -> bool {
    if !base64.hexDecode(hex, out) { return false }
    return x509.parse(cert, out[0 .. hex.length / 2])
}

fn subjectIs(cert: *x509.Certificate, text: []const u8) -> bool {
    var buffer: [256]u8 = undefined
    const out: [*]u8 = &buffer
    const length = x509.nameText(cert, cert.*.subject, out, 256)
    return same(out[0..length], text)
}

fn issuerIs(cert: *x509.Certificate, text: []const u8) -> bool {
    var buffer: [256]u8 = undefined
    const out: [*]u8 = &buffer
    const length = x509.nameText(cert, cert.*.issuer, out, 256)
    return same(out[0..length], text)
}

// How many "-----BEGIN CERTIFICATE-----" lines the text has.
fn pemBlocks(text: []const u8) -> usize {
    const begin = "-----BEGIN CERTIFICATE-----"
    var count: usize = 0
    var at: usize = 0
    while at + begin.length <= text.length {
        if same(text[at .. at + begin.length], begin) { count += 1 }
        at += 1
    }
    return count
}

pub fn main() -> u8 {
    var root_der: [2048]u8 = undefined
    var inter_der: [2048]u8 = undefined
    var leaf_der: [2048]u8 = undefined
    var ed_der: [2048]u8 = undefined
    var client_der: [2048]u8 = undefined
    var chain: [3]x509.Certificate = undefined
    var root: x509.Certificate = undefined
    var ed: x509.Certificate = undefined
    var client: x509.Certificate = undefined
    if !load(ROOT, &root_der, &root) { return 1 }
    if !load(LEAF, &leaf_der, &chain[0]) { return 2 }
    if !load(INTER, &inter_der, &chain[1]) { return 3 }
    if !load(ED, &ed_der, &ed) { return 4 }
    if !load(CLIENT, &client_der, &client) { return 5 }
    const leaf: *x509.Certificate = &chain[0]
    const inter: *x509.Certificate = &chain[1]

    // Fields.
    if leaf.*.version != 3 || leaf.*.notBefore != LEAF_FROM || leaf.*.notAfter != LEAF_UNTIL { return 6 }
    if !same(x509.bytesOf(leaf, leaf.*.serial), "\x12\x34\x56\x78\x90\xab\xcd\xef") { return 7 }
    if leaf.*.keyType != x509.KeyType.p384 || leaf.*.signatureType != x509.SignatureType.ecdsa { return 8 }
    if !leaf.*.hasBasicConstraints || leaf.*.isCa || !leaf.*.hasExtendedKeyUsage || !leaf.*.serverAuth { return 9 }
    if inter.*.keyType != x509.KeyType.p256 || inter.*.signatureType != x509.SignatureType.rsaPss || inter.*.pssSalt != 32 { return 10 }
    if !inter.*.isCa || inter.*.pathLength != 0 || !inter.*.hasKeyUsage || (inter.*.keyUsage & x509.USAGE_KEY_CERT_SIGN) == 0 { return 11 }
    if root.keyType != x509.KeyType.rsa || root.signatureType != x509.SignatureType.rsaPkcs1 || root.pathLength != -1 { return 12 }
    if ed.keyType != x509.KeyType.ed25519 || ed.signatureType != x509.SignatureType.ed25519 { return 14 }

    // Names (as `openssl x509 -nameopt RFC2253` prints them).
    if !subjectIs(leaf, "CN=leaf.example.test,O=Mlx\\, \\\"Test\\\",C=DE") { return 15 }
    if !issuerIs(leaf, "CN=Mlx Test Intermediate,O=Mlx Test,C=DE") { return 16 }
    if !subjectIs(&root, "CN=Mlx Test Root,O=Mlx Test,C=DE") { return 17 }
    var common: [64]u8 = undefined
    const cn: [*]u8 = &common
    const cnLength = x509.commonName(leaf, cn, 64)
    if !same(cn[0..cnLength], "leaf.example.test") { return 18 }

    // Hostnames: the alternative names, not the common name.
    if !x509.matchesHostname(leaf, "example.test") || !x509.matchesHostname(leaf, "EXAMPLE.test.") { return 19 }
    if !x509.matchesHostname(leaf, "a.wild.example.test") { return 20 }
    if x509.matchesHostname(leaf, "wild.example.test") || x509.matchesHostname(leaf, "a.b.wild.example.test") { return 21 }
    if x509.matchesHostname(leaf, "leaf.example.test") || x509.matchesHostname(leaf, "other.test") { return 22 }
    if !x509.matchesHostname(leaf, "127.0.0.1") || !x509.matchesHostname(leaf, "::1") || !x509.matchesHostname(leaf, "0:0::0:1") { return 23 }
    if x509.matchesHostname(leaf, "127.0.0.2") || x509.matchesHostname(leaf, "::2") { return 24 }
    // Without alternative names, the common name.
    if !x509.matchesHostname(&ed, "ed25519.test") || x509.matchesHostname(&ed, "x.ed25519.test") { return 25 }
    if !x509.dnsNameMatches("*.a.b", "x.a.b") || x509.dnsNameMatches("*.b", "a.b") || x509.dnsNameMatches("a*.b.c", "ab.b.c") { return 26 }

    // Signatures: RSA-PSS, ECDSA, Ed25519, PKCS #1 v1.5.
    if !x509.verifySignedBy(inter, &root) || !x509.verifySignedBy(leaf, inter) { return 27 }
    if !x509.verifySignedBy(&ed, &ed) || !x509.verifySignedBy(&root, &root) { return 28 }
    if x509.verifySignedBy(leaf, &root) { return 29 }

    // Chains.
    var store: x509.TrustStore = undefined
    x509.storeInit(&store, std.page_allocator.init())
    const chainList: [*]x509.Certificate = &chain
    if x509.verifyChain(&store, chainList, 2, "example.test", MIDDLE) != x509.UNKNOWN_CA { return 30 }
    if !x509.storeAddDer(&store, x509.derOf(&root)) { return 31 }
    if x509.verifyChain(&store, chainList, 2, "example.test", MIDDLE) != 0 { return 32 }
    if x509.verifyChain(&store, chainList, 2, "", MIDDLE) != 0 { return 33 }
    if x509.verifyChain(&store, chainList, 2, "nope.test", MIDDLE) != x509.BAD_IDENTITY { return 34 }
    if x509.verifyChain(&store, chainList, 2, "example.test", LEAF_UNTIL + 1) != x509.EXPIRED { return 35 }
    if x509.verifyChain(&store, chainList, 2, "example.test", LEAF_FROM - 1) != x509.NOT_ACTIVATED { return 36 }
    if x509.verifyChain(&store, chainList, 1, "example.test", MIDDLE) != x509.UNKNOWN_CA { return 37 }
    // The intermediate as the anchor itself.
    var near: x509.TrustStore = undefined
    x509.storeInit(&near, std.page_allocator.init())
    if !x509.storeAddDer(&near, x509.derOf(inter)) { return 38 }
    if x509.verifyChain(&near, chainList, 1, "example.test", MIDDLE) != 0 { return 39 }
    x509.storeFree(&near)
    // A client certificate is no server's.
    chain[2] = client
    if (x509.verifyChain(&store, chainList + 2, 1, "client.test", MIDDLE) & x509.GENERIC_ERROR) == 0 { return 40 }
    // A signature changed.
    leaf_der[leaf.*.signature.start + 10] = leaf_der[leaf.*.signature.start + 10] ^ 1
    if x509.verifyChain(&store, chainList, 2, "example.test", MIDDLE) != x509.UNKNOWN_CA { return 41 }
    x509.storeFree(&store)

    // The system's bundle: every certificate in it is read.
    var bundle: x509.TrustStore = undefined
    x509.storeInit(&bundle, std.page_allocator.init())
    const allocator = std.page_allocator.init()
    const contents = std.fs.readFileAlloc("/etc/ssl/certs/ca-certificates.crt\x00".pointer, allocator)
    if contents != null {
        var list = contents.?
        const blocks = pemBlocks(list.items[0..list.length])
        const added = x509.storeAddPem(&bundle, list.items[0..list.length])
        if added != blocks || added < 10 { return 42 }
        list.deinit()
    }
    x509.storeFree(&bundle)

    // asn1's times and OIDs.
    var element: asn1.Element = undefined
    var seconds: i64 = 0
    if !asn1.read("\x18\x0f20491231235959Z", 0, &element) || !asn1.time("\x18\x0f20491231235959Z", &element, &seconds) || seconds != 2524607999 { return 43 }
    if !asn1.read("\x17\x0d500101000000Z", 0, &element) || !asn1.time("\x17\x0d500101000000Z", &element, &seconds) || seconds != -631152000 { return 44 }
    var dotted: [128]u8 = undefined
    const oid: [*]u8 = &dotted
    if !asn1.read("\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b", 0, &element) { return 45 }
    const oidLength = asn1.oidText("\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b", &element, oid)
    if !same(oid[0..oidLength], "1.2.840.113549.1.1.11") { return 46 }
    // Not DER: an indefinite length, a long form for a short length.
    if asn1.read("\x30\x80\x00\x00", 0, &element) || asn1.read("\x04\x81\x01\x00", 0, &element) { return 47 }
    return 13
}
