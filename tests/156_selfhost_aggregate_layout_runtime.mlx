const lexer = @import("../compiler/selfhost/lexer.zin")
const parser_module = @import("../compiler/selfhost/parser.zin")
const types = @import("../compiler/selfhost/types.zin")
const symbols = @import("../compiler/selfhost/symbols.zin")
const sema = @import("../compiler/selfhost/sema.zin")
const comptime_module = @import("../compiler/selfhost/comptime.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

pub fn main() -> u8 {
    const source = "const Structure = struct {\na: u8\nb: u32\nc: u16\n}\nconst Number = enum(u16) {\none\ntwo\n}\nconst Choice = union {\nsmall: u8\nwide: u64\n}\nconst Errors = error {\nMissing\nDenied\n}\nconst structureSize = @sizeOf(Structure)\nconst fieldCount = @fieldCount(Structure)\nconst fieldOffset = @offsetOf(Structure, \"b\")\nconst FieldType = @fieldType(Structure, \"c\")\nconst hasField = @hasField(Structure, \"a\")\nfn pair() -> (u8, u32) { return -> (1, 2) }\n"
    const allocator = page_allocator.init()
    const tokens = lexer.scanAll(allocator, source)
    var nodes = parser_module.initStore(allocator, tokens.length * 2)
    var parser = parser_module.init(source, tokens, &nodes)
    const root = parser_module.parse(&parser)
    if parser.errorCount != 0 { return 1 }
    var type_store = types.init(allocator)
    var symbol_store = symbols.initStore(allocator, 16)
    var root_scope = symbols.initRootScope(allocator, 8)
    if symbols.collectRoot(source, tokens, &nodes, root, &symbol_store, &root_scope) != 0 { return 2 }
    if sema.analyzeDeclarations(source, tokens, &nodes, root, &type_store, &symbol_store, &root_scope) != 0 { return 3 }

    const structure = symbols.symbolAt(&symbol_store, 0).*.valueTypeId
    if types.sizeOf(&type_store, structure) != 12 || types.alignOf(&type_store, structure) != 4 { return 4 }
    const structure_type = types.get(&type_store, structure)
    if structure_type.*.extraLength != 3 { return 5 }
    if types.fieldAt(&type_store, structure_type.*.extraStart).*.offset != 0 { return 6 }
    if types.fieldAt(&type_store, structure_type.*.extraStart + 1).*.offset != 4 { return 7 }
    if types.fieldAt(&type_store, structure_type.*.extraStart + 2).*.offset != 8 { return 8 }

    const enumeration = symbols.symbolAt(&symbol_store, 1).*.valueTypeId
    if types.sizeOf(&type_store, enumeration) != 2 || types.alignOf(&type_store, enumeration) != 2 { return 9 }
    const choice = symbols.symbolAt(&symbol_store, 2).*.valueTypeId
    if types.sizeOf(&type_store, choice) != 8 || types.alignOf(&type_store, choice) != 8 { return 10 }
    const errors = symbols.symbolAt(&symbol_store, 3).*.valueTypeId
    if types.sizeOf(&type_store, errors) != 2 || types.get(&type_store, errors).*.extraLength != 2 { return 11 }
    if symbols.symbolAt(&symbol_store, 4).*.comptimeTag != @intCast(u8, @intFromEnum(comptime_module.Kind.integer)) || symbols.symbolAt(&symbol_store, 4).*.comptimeInteger != 12 { return 12 }
    if symbols.symbolAt(&symbol_store, 5).*.comptimeInteger != 3 { return 15 }
    if symbols.symbolAt(&symbol_store, 6).*.comptimeInteger != 4 { return 16 }
    const reflected_type = symbols.symbolAt(&symbol_store, 7).*.valueTypeId
    if types.get(&type_store, reflected_type).*.kind != types.Kind.integer || types.get(&type_store, reflected_type).*.bits != 16 { return 17 }
    if symbols.symbolAt(&symbol_store, 8).*.comptimeInteger != 1 { return 18 }
    const function_type = types.get(&type_store, symbols.symbolAt(&symbol_store, 9).*.typeId)
    if types.sizeOf(&type_store, function_type.*.lhs) != 8 || types.alignOf(&type_store, function_type.*.lhs) != 4 { return 14 }

    symbols.deinitScope(&root_scope)
    symbols.deinitStore(&symbol_store)
    types.deinit(&type_store)
    parser_module.deinitStore(&nodes)
    lexer.deinit(tokens)
    return 13
}
