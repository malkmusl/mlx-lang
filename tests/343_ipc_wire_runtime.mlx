// std.ipc, MLXIPC's native wire format: values written and read back,
// signatures checked, messages framed, written and parsed (and malformed
// ones refused), the preamble, and messages carried to D-Bus marshalling
// and back without loss. Exits 13.
const ipc = @import("std.ipc")
const dbus = @import("std.dbus")

fn same(first: []const u8, second: []const u8) -> bool { return ipc.same(first, second) }

fn sameBytes(first: [*]const u8, second: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn nothing() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "") }
}

// Values of every kind, written and read back.
fn values() -> u8 {
    var memory: [512]u8 = undefined
    const bytes: [*]u8 = &memory
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, bytes, 512)
    ipc.putByte(&writing, 200)
    ipc.putBool(&writing, true)
    ipc.putU16(&writing, 65000)
    ipc.putU32(&writing, 4000000000)
    ipc.putU64(&writing, 1234567890123456789)
    ipc.putI32(&writing, -5)
    ipc.putI64(&writing, -6000000000)
    ipc.putString(&writing, "grüße")
    ipc.putSignature(&writing, "a{sv}")
    const at = ipc.beginArray(&writing)
    ipc.putString(&writing, "one")
    ipc.putString(&writing, "two")
    ipc.endArray(&writing, at, 2)
    ipc.putVariantU32(&writing, 42)
    if writing.failed { return 1 }
    // No padding anywhere: 1+1+2+4+8+4+8 + (4+7+1) + (1+5+1) + 4 + (4+3+1)+(4+3+1) + (1+1+1)+4
    if writing.length != 28 + 12 + 7 + 4 + 16 + 7 { return 2 }
    var reading = ipc.reader(bytes, writing.length)
    if ipc.readByte(&reading) != 200 { return 3 }
    if !ipc.readBool(&reading) { return 4 }
    if ipc.readU16(&reading) != 65000 { return 5 }
    if ipc.readU32(&reading) != 4000000000 { return 6 }
    if ipc.readU64(&reading) != 1234567890123456789 { return 7 }
    if ipc.readI32(&reading) != -5 { return 8 }
    if ipc.readI64(&reading) != -6000000000 { return 9 }
    if !same(ipc.readString(&reading), "grüße") { return 10 }
    if !same(ipc.readSignature(&reading), "a{sv}") { return 11 }
    if ipc.readArray(&reading) != 2 { return 12 }
    if !same(ipc.readString(&reading), "one") || !same(ipc.readString(&reading), "two") { return 13 }
    if !same(ipc.readSignature(&reading), "u") || ipc.readU32(&reading) != 42 { return 14 }
    if reading.failed || reading.position != writing.length { return 15 }
    // Reading past the end fails, and stays failed.
    _ = ipc.readByte(&reading)
    if !reading.failed { return 16 }
    // A boolean other than 0 or 1, a string without its NUL.
    memory[1] = 2
    reading = ipc.reader(bytes, writing.length)
    _ = ipc.readByte(&reading)
    _ = ipc.readBool(&reading)
    if !reading.failed { return 17 }
    memory[1] = 1
    memory[39] = 65
    reading = ipc.reader(bytes, writing.length)
    _ = ipc.skipValue(&reading, "ybqutxix", 0, 0)
    _ = ipc.skipValue(&reading, "b", 0, 0)
    _ = ipc.skipValue(&reading, "q", 0, 0)
    _ = ipc.skipValue(&reading, "u", 0, 0)
    _ = ipc.skipValue(&reading, "t", 0, 0)
    _ = ipc.skipValue(&reading, "i", 0, 0)
    _ = ipc.skipValue(&reading, "x", 0, 0)
    if reading.failed || reading.position != 28 { return 18 }
    if ipc.skipValue(&reading, "s", 0, 0) { return 19 }
    memory[39] = 0
    // skipValue walks arrays, variants and structs.
    reading = ipc.reader(bytes, writing.length)
    if !ipc.skipValue(&reading, "(ybqutixsg)", 0, 0) || reading.position != 47 { return 20 }
    if !ipc.skipValue(&reading, "as", 0, 0) || reading.position != 67 { return 21 }
    if !ipc.skipValue(&reading, "v", 0, 0) || reading.position != writing.length { return 22 }
    // A writer that is full fails and writes no more.
    ipc.begin(&writing, bytes, 6)
    ipc.putString(&writing, "abc")
    if !writing.failed || writing.length != 4 { return 23 }
    return 0
}

fn signatures() -> u8 {
    if !ipc.validSignature("") || !ipc.validSignature("ybnqiuxtdhsogv") { return 1 }
    if !ipc.validSignature("a{sv}a(sbu)aai(a{s(ii)}v)") { return 2 }
    if ipc.validSignature("a") || ipc.validSignature("()") || ipc.validSignature("(s") || ipc.validSignature("{ss}") { return 3 }
    if ipc.validSignature("a{vs}") || ipc.validSignature("a{sss}") || ipc.validSignature("a{s}") || ipc.validSignature("z") { return 4 }
    if !ipc.singleType("a{sv}") || ipc.singleType("ss") || ipc.singleType("") { return 5 }
    if ipc.typeEnd("a(sbu)x", 0, 0) != 6 || ipc.typeEnd("a(sbu)x", 6, 0) != 7 { return 6 }
    // Too deep.
    var deep: [80]u8 = undefined
    var index: usize = 0
    while index < 40 {
        deep[index] = 97
        index += 1
    }
    deep[40] = 117
    const deep_bytes: [*]const u8 = &deep
    if ipc.validSignature(deep_bytes[0..41]) { return 7 }
    if !ipc.validSignature(deep_bytes[10..41]) { return 8 }
    return 0
}

// A message written and parsed, framed as it arrives, and refused when
// malformed.
fn messages() -> u8 {
    var body_memory: [64]u8 = undefined
    const body: [*]u8 = &body_memory
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, body, 64)
    ipc.putString(&writing, "hallo")
    ipc.putU32(&writing, 9)
    const body_length = writing.length
    var message = ipc.newMessage(ipc.CALL, 77)
    message.flags = ipc.NO_AUTO_START
    message.path = "/org/mlx/Test"
    message.interface = "org.mlx.Test"
    message.member = "Echo"
    message.destination = "org.mlx.Service"
    message.signature = "su"
    message.descriptors = 2
    var memory: [256]u8 = undefined
    const bytes: [*]u8 = &memory
    ipc.begin(&writing, bytes, 256)
    ipc.write(&writing, &message, ":1.7", body, body_length)
    if writing.failed { return 1 }
    // 20 + fields (3 bytes each + text) + body
    const fields = 3 + 13 + 3 + 12 + 3 + 4 + 3 + 15 + 3 + 4 + 3 + 2
    if writing.length != ipc.HEADER + fields + body_length { return 2 }
    // Framing: nothing until four bytes are there, then the whole size.
    if ipc.messageSize(bytes, 3) != 0 || ipc.messageSize(bytes, 4) != writing.length || ipc.messageSize(bytes, writing.length) != writing.length { return 3 }
    var parsed: ipc.Message = undefined
    if !ipc.parse(bytes, writing.length, &parsed) { return 4 }
    if parsed.kind != ipc.CALL || parsed.flags != ipc.NO_AUTO_START || parsed.serial != 77 || parsed.replySerial != 0 || parsed.descriptors != 2 { return 5 }
    if !same(parsed.path, "/org/mlx/Test") || !same(parsed.interface, "org.mlx.Test") || !same(parsed.member, "Echo") || !same(parsed.destination, "org.mlx.Service") || !same(parsed.sender, ":1.7") || !same(parsed.signature, "su") || parsed.errorName.length != 0 { return 6 }
    if parsed.bodyStart != ipc.HEADER + fields || parsed.bodyLength != body_length || parsed.size != writing.length { return 7 }
    const parsed_body: [*]const u8 = bytes + parsed.bodyStart
    if !sameBytes(parsed_body, body, body_length) { return 8 }
    // Malformed: the size wrong, kind 0, serial 0, fields past the end, a
    // call without a member, a bad signature, a reply without its serial.
    if ipc.parse(bytes, writing.length - 1, &parsed) { return 9 }
    memory[4] = 0
    if ipc.parse(bytes, writing.length, &parsed) { return 10 }
    memory[4] = ipc.CALL
    ipc.store32(bytes, 8, 0)
    if ipc.parse(bytes, writing.length, &parsed) { return 11 }
    ipc.store32(bytes, 8, 77)
    const fields_length = ipc.load16(bytes, 16)
    ipc.store16(bytes, 16, 65535)
    if ipc.parse(bytes, writing.length, &parsed) { return 12 }
    ipc.store16(bytes, 16, fields_length)
    if !ipc.parse(bytes, writing.length, &parsed) { return 13 }
    memory[ipc.HEADER + 16 + 15] = 9
    if ipc.parse(bytes, writing.length, &parsed) { return 14 }
    memory[ipc.HEADER + 16 + 15] = ipc.FIELD_MEMBER
    memory[writing.length - body_length - 1] = 122
    if ipc.parse(bytes, writing.length, &parsed) { return 15 }
    memory[writing.length - body_length - 1] = 117
    memory[4] = ipc.REPLY
    if ipc.parse(bytes, writing.length, &parsed) { return 16 }
    ipc.store32(bytes, 12, 5)
    if !ipc.parse(bytes, writing.length, &parsed) || parsed.replySerial != 5 { return 17 }
    // A field a reader does not know is skipped.
    var odd: [64]u8 = undefined
    const odd_bytes: [*]u8 = &odd
    var signal = ipc.newMessage(ipc.SIGNAL, 3)
    signal.path = "/"
    signal.interface = "a.b"
    signal.member = "M"
    ipc.begin(&writing, odd_bytes, 64)
    ipc.write(&writing, &signal, "", nothing(), 0)
    const end = writing.length
    odd[end] = 200
    odd[end + 1] = 1
    odd[end + 2] = 0
    odd[end + 3] = 7
    ipc.store16(odd_bytes, 16, ipc.load16(odd_bytes, 16) + 4)
    ipc.store32(odd_bytes, 0, @intCast(u32, end + 4))
    if !ipc.parse(odd_bytes, end + 4, &parsed) || !same(parsed.member, "M") || parsed.bodyLength != 0 { return 18 }
    // Too small, too large.
    ipc.store32(odd_bytes, 0, 8)
    if ipc.messageSize(odd_bytes, 8) != ipc.MAX_MESSAGE + 1 { return 19 }
    ipc.store32(odd_bytes, 0, 70000)
    if ipc.messageSize(odd_bytes, 8) != ipc.MAX_MESSAGE + 1 { return 20 }
    return 0
}

fn preamble() -> u8 {
    var memory: [8]u8 = undefined
    const bytes: [*]u8 = &memory
    ipc.writePreamble(bytes, ipc.UNIX_FDS)
    if !ipc.startsPreamble(bytes, 8) { return 1 }
    var version: u8 = 0
    var flags: u8 = 0
    if ipc.readPreamble(bytes, 3, &version, &flags) != 0 { return 2 }
    if ipc.readPreamble(bytes, 8, &version, &flags) != 1 || version != ipc.VERSION || flags != ipc.UNIX_FDS { return 3 }
    memory[0] = 0
    if ipc.startsPreamble(bytes, 8) || ipc.readPreamble(bytes, 1, &version, &flags) != -1 { return 4 }
    return 0
}

// A D-Bus body of every kind of type: to native and back is the same
// bytes; the native form is what a native writer gives.
fn conversions() -> u8 {
    const signature = "a(sbu)a{sv}xdhynqi(aay)"
    var dbus_memory: [512]u8 = undefined
    const dbus_bytes: [*]u8 = &dbus_memory
    var d: dbus.Writer = undefined
    dbus.begin(&d, dbus_bytes, 512, false)
    var at = dbus.beginArray(&d, 8)
    dbus.pad(&d, 8)
    dbus.putString(&d, "first")
    dbus.putBool(&d, true)
    dbus.putU32(&d, 1)
    dbus.pad(&d, 8)
    dbus.putString(&d, "second")
    dbus.putBool(&d, false)
    dbus.putU32(&d, 2)
    dbus.endArray(&d, at, 8)
    at = dbus.beginArray(&d, 8)
    dbus.pad(&d, 8)
    dbus.putString(&d, "key")
    dbus.putVariantString(&d, "value")
    dbus.pad(&d, 8)
    dbus.putString(&d, "count")
    dbus.putVariantU32(&d, 12)
    dbus.endArray(&d, at, 8)
    dbus.pad(&d, 8)
    dbus.putU32(&d, 4294967295)
    dbus.putU32(&d, 4294967295)
    dbus.pad(&d, 8)
    dbus.putU32(&d, 0)
    dbus.putU32(&d, 1074266112)
    dbus.putU32(&d, 1)
    dbus.putByte(&d, 7)
    dbus.pad(&d, 2)
    dbus.putByte(&d, 1)
    dbus.putByte(&d, 128)
    dbus.putByte(&d, 2)
    dbus.putByte(&d, 0)
    dbus.putU32(&d, 3000000000)
    dbus.pad(&d, 8)
    at = dbus.beginArray(&d, 4)
    const inner = dbus.beginArray(&d, 1)
    dbus.putByte(&d, 10)
    dbus.putByte(&d, 11)
    dbus.endArray(&d, inner, 1)
    const inner2 = dbus.beginArray(&d, 1)
    dbus.endArray(&d, inner2, 1)
    dbus.endArray(&d, at, 4)
    if d.failed { return 1 }
    const dbus_length = d.length
    // To native.
    var native_memory: [512]u8 = undefined
    const native_bytes: [*]u8 = &native_memory
    var n: ipc.Writer = undefined
    ipc.begin(&n, native_bytes, 512)
    if !ipc.bodyToNative(signature, dbus_bytes, dbus_length, false, &n) { return 2 }
    // What a native writer writes for the same values.
    var wanted_memory: [512]u8 = undefined
    const wanted_bytes: [*]u8 = &wanted_memory
    var w: ipc.Writer = undefined
    ipc.begin(&w, wanted_bytes, 512)
    var count_at = ipc.beginArray(&w)
    ipc.putString(&w, "first")
    ipc.putBool(&w, true)
    ipc.putU32(&w, 1)
    ipc.putString(&w, "second")
    ipc.putBool(&w, false)
    ipc.putU32(&w, 2)
    ipc.endArray(&w, count_at, 2)
    count_at = ipc.beginArray(&w)
    ipc.putString(&w, "key")
    ipc.putVariantString(&w, "value")
    ipc.putString(&w, "count")
    ipc.putVariantU32(&w, 12)
    ipc.endArray(&w, count_at, 2)
    ipc.putI64(&w, -1)
    ipc.putU64(&w, 4614253070214989087 - 4614253070214989087 + (@intCast(u64, 1074266112) << 32))
    ipc.putU32(&w, 1)
    ipc.putByte(&w, 7)
    ipc.putU16(&w, 32769)
    ipc.putU16(&w, 2)
    ipc.putI32(&w, -1294967296)
    count_at = ipc.beginArray(&w)
    const inner_at = ipc.beginArray(&w)
    ipc.putByte(&w, 10)
    ipc.putByte(&w, 11)
    ipc.endArray(&w, inner_at, 2)
    const inner_at2 = ipc.beginArray(&w)
    ipc.endArray(&w, inner_at2, 0)
    ipc.endArray(&w, count_at, 2)
    if w.failed || w.length != n.length { return 3 }
    if !sameBytes(wanted_bytes, native_bytes, n.length) { return 4 }
    // And back: D-Bus marshalling is canonical, so the bytes are the same.
    var back_memory: [512]u8 = undefined
    const back_bytes: [*]u8 = &back_memory
    var b: dbus.Writer = undefined
    dbus.begin(&b, back_bytes, 512, false)
    if !ipc.bodyToDBus(signature, native_bytes, n.length, &b) { return 5 }
    if b.length != dbus_length || !sameBytes(back_bytes, dbus_bytes, dbus_length) { return 6 }
    // A body that does not match its signature is refused either way.
    if ipc.bodyToNative("u", dbus_bytes, 3, false, &n) { return 7 }
    ipc.begin(&n, native_bytes, 512)
    if ipc.bodyToNative("s", dbus_bytes, dbus_length, false, &n) { return 8 }
    dbus.begin(&b, back_bytes, 512, false)
    if ipc.bodyToDBus("as", native_bytes, 4, &b) { return 9 }
    // A big-endian D-Bus body comes out little-endian.
    var big_memory: [32]u8 = undefined
    const big_bytes: [*]u8 = &big_memory
    var g: dbus.Writer = undefined
    dbus.begin(&g, big_bytes, 32, true)
    dbus.putU32(&g, 258)
    dbus.putBool(&g, true)
    dbus.putString(&g, "x")
    ipc.begin(&n, native_bytes, 512)
    if !ipc.bodyToNative("ubs", big_bytes, g.length, true, &n) { return 10 }
    var reading = ipc.reader(native_bytes, n.length)
    if ipc.readU32(&reading) != 258 || !ipc.readBool(&reading) || !same(ipc.readString(&reading), "x") || reading.failed { return 11 }
    return 0
}

// A whole D-Bus message to native and back.
fn wholeMessages() -> u8 {
    var body_memory: [64]u8 = undefined
    const body: [*]u8 = &body_memory
    var d: dbus.Writer = undefined
    dbus.begin(&d, body, 64, false)
    dbus.putString(&d, "hello")
    dbus.putBool(&d, true)
    var header = dbus.newHeader(dbus.METHOD_RETURN, 31)
    header.replySerial = 9
    header.hasReplySerial = true
    header.destination = ":1.4"
    header.signature = "sb"
    header.bodyLength = d.length
    header.unixFds = 1
    var native_memory: [256]u8 = undefined
    const native_bytes: [*]u8 = &native_memory
    var n: ipc.Writer = undefined
    ipc.begin(&n, native_bytes, 256)
    if !ipc.fromDBus(&header, ":1.2", body, &n) { return 1 }
    var message: ipc.Message = undefined
    if ipc.messageSize(native_bytes, n.length) != n.length || !ipc.parse(native_bytes, n.length, &message) { return 2 }
    if message.kind != ipc.REPLY || message.serial != 31 || message.replySerial != 9 || message.descriptors != 1 || !same(message.destination, ":1.4") || !same(message.sender, ":1.2") || !same(message.signature, "sb") { return 3 }
    const native_body: [*]const u8 = native_bytes + message.bodyStart
    var reading = ipc.reader(native_body, message.bodyLength)
    if !same(ipc.readString(&reading), "hello") || !ipc.readBool(&reading) || reading.position != message.bodyLength { return 4 }
    // Back to D-Bus.
    var dbus_memory: [256]u8 = undefined
    const dbus_bytes: [*]u8 = &dbus_memory
    var scratch: [256]u8 = undefined
    const scratch_bytes: [*]u8 = &scratch
    var out: dbus.Writer = undefined
    dbus.begin(&out, dbus_bytes, 256, false)
    if !toDBusSmall(&message, native_body, scratch_bytes, &out) { return 5 }
    var parsed: dbus.Header = undefined
    if dbus.messageSize(dbus_bytes, out.length) != out.length || !dbus.parseHeader(dbus_bytes, out.length, &parsed) { return 6 }
    if parsed.kind != dbus.METHOD_RETURN || parsed.serial != 31 || !parsed.hasReplySerial || parsed.replySerial != 9 || parsed.unixFds != 1 || !same(parsed.destination, ":1.4") || !same(parsed.sender, ":1.2") || !same(parsed.signature, "sb") { return 7 }
    if parsed.bodyLength != header.bodyLength { return 8 }
    const parsed_body: [*]const u8 = dbus_bytes + parsed.bodyStart
    if !sameBytes(parsed_body, body, parsed.bodyLength) { return 9 }
    return 0
}

// toDBus with a small scratch area (the real one is MAX_MESSAGE bytes;
// the body here is far smaller).
fn toDBusSmall(message: *const ipc.Message, body: [*]const u8, scratch: [*]u8, writing: *dbus.Writer) -> bool {
    return ipc.toDBus(message, ":1.2", body, scratch, writing)
}

pub fn main() -> u8 {
    const a = values()
    if a != 0 { return a }
    const b = signatures()
    if b != 0 { return 30 + b }
    const c = messages()
    if c != 0 { return 40 + c }
    const d = preamble()
    if d != 0 { return 70 + d }
    const e = conversions()
    if e != 0 { return 80 + e }
    const f = wholeMessages()
    if f != 0 { return 100 + f }
    return 13
}
