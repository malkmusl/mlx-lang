// std.ipc, MLXIPC's native wire format: values written and read back,
// signatures checked, messages framed, written and parsed (and malformed
// ones refused), the preamble, messages carried to D-Bus marshalling and
// back without loss, what the validators refuse (std.dbus's rules for
// names, paths, strings and bodies, in both formats), and thousands of
// mutated messages of either format that must be parsed or refused
// without harm, the accepted ones carried over and back whole. Exits 13.
const ipc = @import("std.ipc")
const dbus = @import("std.dbus")

fn same(first: []const u8, second: []const u8) -> bool { return ipc.same(first, second) }

fn sameBytes(first: [*]const u8, second: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn nothing() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "") }
}

// Values of every kind, written and read back.
fn values() -> u8 {
    var memory: [512]u8 = undefined
    const bytes: [*]u8 = &memory
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, bytes, 512)
    ipc.putByte(&writing, 200)
    ipc.putBool(&writing, true)
    ipc.putU16(&writing, 65000)
    ipc.putU32(&writing, 4000000000)
    ipc.putU64(&writing, 1234567890123456789)
    ipc.putI32(&writing, -5)
    ipc.putI64(&writing, -6000000000)
    ipc.putString(&writing, "grüße")
    ipc.putSignature(&writing, "a{sv}")
    const at = ipc.beginArray(&writing)
    ipc.putString(&writing, "one")
    ipc.putString(&writing, "two")
    ipc.endArray(&writing, at, 2)
    ipc.putVariantU32(&writing, 42)
    if writing.failed { return 1 }
    // No padding anywhere: 1+1+2+4+8+4+8 + (4+7+1) + (1+5+1) + 4 + (4+3+1)+(4+3+1) + (1+1+1)+4
    if writing.length != 28 + 12 + 7 + 4 + 16 + 7 { return 2 }
    var reading = ipc.reader(bytes, writing.length)
    if ipc.readByte(&reading) != 200 { return 3 }
    if !ipc.readBool(&reading) { return 4 }
    if ipc.readU16(&reading) != 65000 { return 5 }
    if ipc.readU32(&reading) != 4000000000 { return 6 }
    if ipc.readU64(&reading) != 1234567890123456789 { return 7 }
    if ipc.readI32(&reading) != -5 { return 8 }
    if ipc.readI64(&reading) != -6000000000 { return 9 }
    if !same(ipc.readString(&reading), "grüße") { return 10 }
    if !same(ipc.readSignature(&reading), "a{sv}") { return 11 }
    if ipc.readArray(&reading) != 2 { return 12 }
    if !same(ipc.readString(&reading), "one") || !same(ipc.readString(&reading), "two") { return 13 }
    if !same(ipc.readSignature(&reading), "u") || ipc.readU32(&reading) != 42 { return 14 }
    if reading.failed || reading.position != writing.length { return 15 }
    // Reading past the end fails, and stays failed.
    _ = ipc.readByte(&reading)
    if !reading.failed { return 16 }
    // A boolean other than 0 or 1, a string without its NUL.
    memory[1] = 2
    reading = ipc.reader(bytes, writing.length)
    _ = ipc.readByte(&reading)
    _ = ipc.readBool(&reading)
    if !reading.failed { return 17 }
    memory[1] = 1
    memory[39] = 65
    reading = ipc.reader(bytes, writing.length)
    _ = ipc.skipValue(&reading, "ybqutxix", 0, 0)
    _ = ipc.skipValue(&reading, "b", 0, 0)
    _ = ipc.skipValue(&reading, "q", 0, 0)
    _ = ipc.skipValue(&reading, "u", 0, 0)
    _ = ipc.skipValue(&reading, "t", 0, 0)
    _ = ipc.skipValue(&reading, "i", 0, 0)
    _ = ipc.skipValue(&reading, "x", 0, 0)
    if reading.failed || reading.position != 28 { return 18 }
    if ipc.skipValue(&reading, "s", 0, 0) { return 19 }
    memory[39] = 0
    // skipValue walks arrays, variants and structs.
    reading = ipc.reader(bytes, writing.length)
    if !ipc.skipValue(&reading, "(ybqutixsg)", 0, 0) || reading.position != 47 { return 20 }
    if !ipc.skipValue(&reading, "as", 0, 0) || reading.position != 67 { return 21 }
    if !ipc.skipValue(&reading, "v", 0, 0) || reading.position != writing.length { return 22 }
    // A writer that is full fails and writes no more.
    ipc.begin(&writing, bytes, 6)
    ipc.putString(&writing, "abc")
    if !writing.failed || writing.length != 4 { return 23 }
    return 0
}

fn signatures() -> u8 {
    if !ipc.validSignature("") || !ipc.validSignature("ybnqiuxtdhsogv") { return 1 }
    if !ipc.validSignature("a{sv}a(sbu)aai(a{s(ii)}v)") { return 2 }
    if ipc.validSignature("a") || ipc.validSignature("()") || ipc.validSignature("(s") || ipc.validSignature("{ss}") { return 3 }
    if ipc.validSignature("a{vs}") || ipc.validSignature("a{sss}") || ipc.validSignature("a{s}") || ipc.validSignature("z") { return 4 }
    if !ipc.singleType("a{sv}") || ipc.singleType("ss") || ipc.singleType("") { return 5 }
    if ipc.typeEnd("a(sbu)x", 0, 0) != 6 || ipc.typeEnd("a(sbu)x", 6, 0) != 7 { return 6 }
    // Too deep.
    var deep: [80]u8 = undefined
    var index: usize = 0
    while index < 40 {
        deep[index] = 97
        index += 1
    }
    deep[40] = 117
    const deep_bytes: [*]const u8 = &deep
    if ipc.validSignature(deep_bytes[0..41]) { return 7 }
    if !ipc.validSignature(deep_bytes[10..41]) { return 8 }
    return 0
}

// A message written and parsed, framed as it arrives, and refused when
// malformed.
fn messages() -> u8 {
    var body_memory: [64]u8 = undefined
    const body: [*]u8 = &body_memory
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, body, 64)
    ipc.putString(&writing, "hallo")
    ipc.putU32(&writing, 9)
    const body_length = writing.length
    var message = ipc.newMessage(ipc.CALL, 77)
    message.flags = ipc.NO_AUTO_START
    message.path = "/org/mlx/Test"
    message.interface = "org.mlx.Test"
    message.member = "Echo"
    message.destination = "org.mlx.Service"
    message.signature = "su"
    message.descriptors = 2
    var memory: [256]u8 = undefined
    const bytes: [*]u8 = &memory
    ipc.begin(&writing, bytes, 256)
    ipc.write(&writing, &message, ":1.7", body, body_length)
    if writing.failed { return 1 }
    // 20 + fields (3 bytes each + text) + body
    const fields = 3 + 13 + 3 + 12 + 3 + 4 + 3 + 15 + 3 + 4 + 3 + 2
    if writing.length != ipc.HEADER + fields + body_length { return 2 }
    // Framing: nothing until four bytes are there, then the whole size.
    if ipc.messageSize(bytes, 3) != 0 || ipc.messageSize(bytes, 4) != writing.length || ipc.messageSize(bytes, writing.length) != writing.length { return 3 }
    var parsed: ipc.Message = undefined
    if !ipc.parse(bytes, writing.length, &parsed) { return 4 }
    if parsed.kind != ipc.CALL || parsed.flags != ipc.NO_AUTO_START || parsed.serial != 77 || parsed.replySerial != 0 || parsed.descriptors != 2 { return 5 }
    if !same(parsed.path, "/org/mlx/Test") || !same(parsed.interface, "org.mlx.Test") || !same(parsed.member, "Echo") || !same(parsed.destination, "org.mlx.Service") || !same(parsed.sender, ":1.7") || !same(parsed.signature, "su") || parsed.errorName.length != 0 { return 6 }
    if parsed.bodyStart != ipc.HEADER + fields || parsed.bodyLength != body_length || parsed.size != writing.length { return 7 }
    const parsed_body: [*]const u8 = bytes + parsed.bodyStart
    if !sameBytes(parsed_body, body, body_length) { return 8 }
    // Malformed: the size wrong, kind 0, serial 0, fields past the end, a
    // call without a member, a bad signature, a reply without its serial.
    if ipc.parse(bytes, writing.length - 1, &parsed) { return 9 }
    memory[4] = 0
    if ipc.parse(bytes, writing.length, &parsed) { return 10 }
    memory[4] = ipc.CALL
    ipc.store32(bytes, 8, 0)
    if ipc.parse(bytes, writing.length, &parsed) { return 11 }
    ipc.store32(bytes, 8, 77)
    const fields_length = ipc.load16(bytes, 16)
    ipc.store16(bytes, 16, 65535)
    if ipc.parse(bytes, writing.length, &parsed) { return 12 }
    ipc.store16(bytes, 16, fields_length)
    if !ipc.parse(bytes, writing.length, &parsed) { return 13 }
    memory[ipc.HEADER + 16 + 15] = 9
    if ipc.parse(bytes, writing.length, &parsed) { return 14 }
    memory[ipc.HEADER + 16 + 15] = ipc.FIELD_MEMBER
    memory[writing.length - body_length - 1] = 122
    if ipc.parse(bytes, writing.length, &parsed) { return 15 }
    memory[writing.length - body_length - 1] = 117
    memory[4] = ipc.REPLY
    if ipc.parse(bytes, writing.length, &parsed) { return 16 }
    ipc.store32(bytes, 12, 5)
    if !ipc.parse(bytes, writing.length, &parsed) || parsed.replySerial != 5 { return 17 }
    // A field a reader does not know is skipped.
    var odd: [64]u8 = undefined
    const odd_bytes: [*]u8 = &odd
    var signal = ipc.newMessage(ipc.SIGNAL, 3)
    signal.path = "/"
    signal.interface = "a.b"
    signal.member = "M"
    ipc.begin(&writing, odd_bytes, 64)
    ipc.write(&writing, &signal, "", nothing(), 0)
    const end = writing.length
    odd[end] = 200
    odd[end + 1] = 1
    odd[end + 2] = 0
    odd[end + 3] = 7
    ipc.store16(odd_bytes, 16, ipc.load16(odd_bytes, 16) + 4)
    ipc.store32(odd_bytes, 0, @intCast(u32, end + 4))
    if !ipc.parse(odd_bytes, end + 4, &parsed) || !same(parsed.member, "M") || parsed.bodyLength != 0 { return 18 }
    // Too small, too large.
    ipc.store32(odd_bytes, 0, 8)
    if ipc.messageSize(odd_bytes, 8) != ipc.MAX_MESSAGE + 1 { return 19 }
    ipc.store32(odd_bytes, 0, 70000)
    if ipc.messageSize(odd_bytes, 8) != ipc.MAX_MESSAGE + 1 { return 20 }
    return 0
}

fn preamble() -> u8 {
    var memory: [8]u8 = undefined
    const bytes: [*]u8 = &memory
    ipc.writePreamble(bytes, ipc.UNIX_FDS)
    if !ipc.startsPreamble(bytes, 8) { return 1 }
    var version: u8 = 0
    var flags: u8 = 0
    if ipc.readPreamble(bytes, 3, &version, &flags) != 0 { return 2 }
    if ipc.readPreamble(bytes, 8, &version, &flags) != 1 || version != ipc.VERSION || flags != ipc.UNIX_FDS { return 3 }
    memory[0] = 0
    if ipc.startsPreamble(bytes, 8) || ipc.readPreamble(bytes, 1, &version, &flags) != -1 { return 4 }
    return 0
}

// A D-Bus body of every kind of type: to native and back is the same
// bytes; the native form is what a native writer gives.
fn conversions() -> u8 {
    const signature = "a(sbu)a{sv}xdhynqi(aay)"
    var dbus_memory: [512]u8 = undefined
    const dbus_bytes: [*]u8 = &dbus_memory
    var d: dbus.Writer = undefined
    dbus.begin(&d, dbus_bytes, 512, false)
    var at = dbus.beginArray(&d, 8)
    dbus.pad(&d, 8)
    dbus.putString(&d, "first")
    dbus.putBool(&d, true)
    dbus.putU32(&d, 1)
    dbus.pad(&d, 8)
    dbus.putString(&d, "second")
    dbus.putBool(&d, false)
    dbus.putU32(&d, 2)
    dbus.endArray(&d, at, 8)
    at = dbus.beginArray(&d, 8)
    dbus.pad(&d, 8)
    dbus.putString(&d, "key")
    dbus.putVariantString(&d, "value")
    dbus.pad(&d, 8)
    dbus.putString(&d, "count")
    dbus.putVariantU32(&d, 12)
    dbus.endArray(&d, at, 8)
    dbus.pad(&d, 8)
    dbus.putU32(&d, 4294967295)
    dbus.putU32(&d, 4294967295)
    dbus.pad(&d, 8)
    dbus.putU32(&d, 0)
    dbus.putU32(&d, 1074266112)
    dbus.putU32(&d, 1)
    dbus.putByte(&d, 7)
    dbus.pad(&d, 2)
    dbus.putByte(&d, 1)
    dbus.putByte(&d, 128)
    dbus.putByte(&d, 2)
    dbus.putByte(&d, 0)
    dbus.putU32(&d, 3000000000)
    dbus.pad(&d, 8)
    at = dbus.beginArray(&d, 4)
    const inner = dbus.beginArray(&d, 1)
    dbus.putByte(&d, 10)
    dbus.putByte(&d, 11)
    dbus.endArray(&d, inner, 1)
    const inner2 = dbus.beginArray(&d, 1)
    dbus.endArray(&d, inner2, 1)
    dbus.endArray(&d, at, 4)
    if d.failed { return 1 }
    const dbus_length = d.length
    // To native.
    var native_memory: [512]u8 = undefined
    const native_bytes: [*]u8 = &native_memory
    var n: ipc.Writer = undefined
    ipc.begin(&n, native_bytes, 512)
    if !ipc.bodyToNative(signature, dbus_bytes, dbus_length, false, 2, &n) { return 2 }
    // What a native writer writes for the same values.
    var wanted_memory: [512]u8 = undefined
    const wanted_bytes: [*]u8 = &wanted_memory
    var w: ipc.Writer = undefined
    ipc.begin(&w, wanted_bytes, 512)
    var count_at = ipc.beginArray(&w)
    ipc.putString(&w, "first")
    ipc.putBool(&w, true)
    ipc.putU32(&w, 1)
    ipc.putString(&w, "second")
    ipc.putBool(&w, false)
    ipc.putU32(&w, 2)
    ipc.endArray(&w, count_at, 2)
    count_at = ipc.beginArray(&w)
    ipc.putString(&w, "key")
    ipc.putVariantString(&w, "value")
    ipc.putString(&w, "count")
    ipc.putVariantU32(&w, 12)
    ipc.endArray(&w, count_at, 2)
    ipc.putI64(&w, -1)
    ipc.putU64(&w, 4614253070214989087 - 4614253070214989087 + (@intCast(u64, 1074266112) << 32))
    ipc.putU32(&w, 1)
    ipc.putByte(&w, 7)
    ipc.putU16(&w, 32769)
    ipc.putU16(&w, 2)
    ipc.putI32(&w, -1294967296)
    count_at = ipc.beginArray(&w)
    const inner_at = ipc.beginArray(&w)
    ipc.putByte(&w, 10)
    ipc.putByte(&w, 11)
    ipc.endArray(&w, inner_at, 2)
    const inner_at2 = ipc.beginArray(&w)
    ipc.endArray(&w, inner_at2, 0)
    ipc.endArray(&w, count_at, 2)
    if w.failed || w.length != n.length { return 3 }
    if !sameBytes(wanted_bytes, native_bytes, n.length) { return 4 }
    // And back: D-Bus marshalling is canonical, so the bytes are the same.
    var back_memory: [512]u8 = undefined
    const back_bytes: [*]u8 = &back_memory
    var b: dbus.Writer = undefined
    dbus.begin(&b, back_bytes, 512, false)
    if !ipc.bodyToDBus(signature, native_bytes, n.length, 2, &b) { return 5 }
    if b.length != dbus_length || !sameBytes(back_bytes, dbus_bytes, dbus_length) { return 6 }
    // A body that does not match its signature is refused either way.
    if ipc.bodyToNative("u", dbus_bytes, 3, false, 0, &n) { return 7 }
    ipc.begin(&n, native_bytes, 512)
    if ipc.bodyToNative("s", dbus_bytes, dbus_length, false, 0, &n) { return 8 }
    dbus.begin(&b, back_bytes, 512, false)
    if ipc.bodyToDBus("as", native_bytes, 4, 0, &b) { return 9 }
    // A big-endian D-Bus body comes out little-endian.
    var big_memory: [32]u8 = undefined
    const big_bytes: [*]u8 = &big_memory
    var g: dbus.Writer = undefined
    dbus.begin(&g, big_bytes, 32, true)
    dbus.putU32(&g, 258)
    dbus.putBool(&g, true)
    dbus.putString(&g, "x")
    ipc.begin(&n, native_bytes, 512)
    if !ipc.bodyToNative("ubs", big_bytes, g.length, true, 0, &n) { return 10 }
    var reading = ipc.reader(native_bytes, n.length)
    if ipc.readU32(&reading) != 258 || !ipc.readBool(&reading) || !same(ipc.readString(&reading), "x") || reading.failed { return 11 }
    return 0
}

// A whole D-Bus message to native and back.
fn wholeMessages() -> u8 {
    var body_memory: [64]u8 = undefined
    const body: [*]u8 = &body_memory
    var d: dbus.Writer = undefined
    dbus.begin(&d, body, 64, false)
    dbus.putString(&d, "hello")
    dbus.putBool(&d, true)
    var header = dbus.newHeader(dbus.METHOD_RETURN, 31)
    header.replySerial = 9
    header.hasReplySerial = true
    header.destination = ":1.4"
    header.signature = "sb"
    header.bodyLength = d.length
    header.unixFds = 1
    var native_memory: [256]u8 = undefined
    const native_bytes: [*]u8 = &native_memory
    var n: ipc.Writer = undefined
    ipc.begin(&n, native_bytes, 256)
    if !ipc.fromDBus(&header, ":1.2", body, &n) { return 1 }
    var message: ipc.Message = undefined
    if ipc.messageSize(native_bytes, n.length) != n.length || !ipc.parse(native_bytes, n.length, &message) { return 2 }
    if message.kind != ipc.REPLY || message.serial != 31 || message.replySerial != 9 || message.descriptors != 1 || !same(message.destination, ":1.4") || !same(message.sender, ":1.2") || !same(message.signature, "sb") { return 3 }
    const native_body: [*]const u8 = native_bytes + message.bodyStart
    var reading = ipc.reader(native_body, message.bodyLength)
    if !same(ipc.readString(&reading), "hello") || !ipc.readBool(&reading) || reading.position != message.bodyLength { return 4 }
    // Back to D-Bus.
    var dbus_memory: [256]u8 = undefined
    const dbus_bytes: [*]u8 = &dbus_memory
    var scratch: [256]u8 = undefined
    const scratch_bytes: [*]u8 = &scratch
    var out: dbus.Writer = undefined
    dbus.begin(&out, dbus_bytes, 256, false)
    if !toDBusSmall(&message, native_body, scratch_bytes, &out) { return 5 }
    var parsed: dbus.Header = undefined
    if dbus.messageSize(dbus_bytes, out.length) != out.length || !dbus.parseHeader(dbus_bytes, out.length, &parsed) { return 6 }
    if parsed.kind != dbus.METHOD_RETURN || parsed.serial != 31 || !parsed.hasReplySerial || parsed.replySerial != 9 || parsed.unixFds != 1 || !same(parsed.destination, ":1.4") || !same(parsed.sender, ":1.2") || !same(parsed.signature, "sb") { return 7 }
    if parsed.bodyLength != header.bodyLength { return 8 }
    const parsed_body: [*]const u8 = dbus_bytes + parsed.bodyStart
    if !sameBytes(parsed_body, body, parsed.bodyLength) { return 9 }
    return 0
}

// toDBus with a small scratch area (the real one is MAX_MESSAGE bytes;
// the body here is far smaller).
fn toDBusSmall(message: *const ipc.Message, body: [*]const u8, scratch: [*]u8, writing: *dbus.Writer) -> bool {
    return ipc.toDBus(message, ":1.2", body, scratch, writing)
}

// std.dbus's validators, which both formats are checked by.
fn validators() -> u8 {
    if !dbus.validUtf8("") || !dbus.validUtf8("grüße €") || !dbus.validUtf8("\u{10FFFF}") { return 1 }
    var bad: [4]u8 = undefined
    const bad_bytes: [*]const u8 = &bad
    bad[0] = 0
    if dbus.validUtf8(bad_bytes[0..1]) { return 2 }
    bad[0] = 255
    bad[1] = 254
    if dbus.validUtf8(bad_bytes[0..2]) { return 3 }
    // An overlong "/" (C0 AF), a surrogate (ED A0 80), past U+10FFFF (F4 90 80 80), a cut sequence.
    bad[0] = 192
    bad[1] = 175
    if dbus.validUtf8(bad_bytes[0..2]) { return 4 }
    bad[0] = 237
    bad[1] = 160
    bad[2] = 128
    if dbus.validUtf8(bad_bytes[0..3]) { return 5 }
    bad[0] = 244
    bad[1] = 144
    bad[2] = 128
    bad[3] = 128
    if dbus.validUtf8(bad_bytes[0..4]) { return 6 }
    bad[0] = 226
    bad[1] = 130
    if dbus.validUtf8(bad_bytes[0..2]) { return 7 }
    if !dbus.validPath("/") || !dbus.validPath("/org/mlx/IPC_1") { return 8 }
    if dbus.validPath("") || dbus.validPath("org") || dbus.validPath("/org/") || dbus.validPath("//org") || dbus.validPath("/org-x") { return 9 }
    if !dbus.validMember("Echo") || !dbus.validMember("_x1") { return 10 }
    if dbus.validMember("") || dbus.validMember("1x") || dbus.validMember("Bad Name") || dbus.validMember("a.b") { return 11 }
    if !dbus.validInterface("org.mlx.Echo") || !dbus.validInterface("a.b") { return 12 }
    if dbus.validInterface("Echo") || dbus.validInterface("org..mlx") || dbus.validInterface(".org.mlx") || dbus.validInterface("org.mlx.") || dbus.validInterface("org.1mlx") || dbus.validInterface("org.m-lx") { return 13 }
    if !dbus.validBusName("org.freedesktop.DBus") || !dbus.validBusName(":1.42") || !dbus.validBusName("org.kde.StatusNotifierItem-12-1") { return 14 }
    if dbus.validBusName("") || dbus.validBusName(":") || dbus.validBusName(":1") || dbus.validBusName("1org.x") || dbus.validBusName("org") { return 15 }
    var long: [260]u8 = undefined
    var index: usize = 0
    while index < 260 {
        long[index] = 97
        index += 1
    }
    const long_bytes: [*]const u8 = &long
    if dbus.validMember(long_bytes[0..256]) || !dbus.validMember(long_bytes[0..255]) { return 16 }
    // Bodies, D-Bus: a boolean of 2, a descriptor past the message's, a
    // string with a NUL inside, a path value that is none.
    var memory: [64]u8 = undefined
    const bytes: [*]u8 = &memory
    var d: dbus.Writer = undefined
    dbus.begin(&d, bytes, 64, false)
    dbus.putU32(&d, 2)
    if dbus.validBody("b", bytes, 4, false, 0) || !dbus.validBody("u", bytes, 4, false, 0) || dbus.validBody("h", bytes, 4, false, 2) || !dbus.validBody("h", bytes, 4, false, 3) { return 17 }
    dbus.begin(&d, bytes, 64, false)
    dbus.putString(&d, "a\x00b")
    if dbus.validBody("s", bytes, d.length, false, 0) || dbus.validBody("o", bytes, d.length, false, 0) { return 18 }
    dbus.begin(&d, bytes, 64, false)
    dbus.putString(&d, "/a/b")
    if !dbus.validBody("o", bytes, d.length, false, 0) || !dbus.validBody("s", bytes, d.length, false, 0) || dbus.validBody("ss", bytes, d.length, false, 0) || dbus.validBody("", bytes, d.length, false, 0) { return 19 }
    // Bodies, native.
    var n: ipc.Writer = undefined
    ipc.begin(&n, bytes, 64)
    ipc.putByte(&n, 2)
    if ipc.validBody("b", bytes, 1, 0) || !ipc.validBody("y", bytes, 1, 0) { return 20 }
    ipc.begin(&n, bytes, 64)
    ipc.putU32(&n, 1)
    if ipc.validBody("h", bytes, 4, 1) || !ipc.validBody("h", bytes, 4, 2) { return 21 }
    ipc.begin(&n, bytes, 64)
    ipc.putString(&n, "a\x00b")
    if ipc.validBody("s", bytes, n.length, 0) { return 22 }
    ipc.begin(&n, bytes, 64)
    ipc.putSignature(&n, "ss")
    ipc.putString(&n, "a")
    ipc.putString(&n, "b")
    if ipc.validBody("v", bytes, n.length, 0) { return 23 }
    ipc.begin(&n, bytes, 64)
    ipc.putSignature(&n, "s")
    ipc.putString(&n, "a")
    if !ipc.validBody("v", bytes, n.length, 0) { return 24 }
    // Headers: parse refuses a bad member, path, interface, destination,
    // a field twice, an empty field, a reserved word that is not zero.
    var message = ipc.newMessage(ipc.CALL, 5)
    message.path = "/"
    message.member = "Echo"
    message.destination = "org.example.Echo"
    var head: [128]u8 = undefined
    const head_bytes: [*]u8 = &head
    ipc.begin(&n, head_bytes, 128)
    ipc.write(&n, &message, "", ipc.nothingBody(), 0)
    var parsed: ipc.Message = undefined
    if !ipc.parse(head_bytes, n.length, &parsed) { return 25 }
    head[ipc.HEADER + 3 + 1 + 3] = 32
    if ipc.parse(head_bytes, n.length, &parsed) { return 26 }
    head[ipc.HEADER + 3 + 1 + 3] = 69
    head[ipc.HEADER + 3] = 97
    if ipc.parse(head_bytes, n.length, &parsed) { return 27 }
    head[ipc.HEADER + 3] = 47
    head[18] = 1
    if ipc.parse(head_bytes, n.length, &parsed) { return 28 }
    head[18] = 0
    head[ipc.HEADER + 3 + 1] = ipc.FIELD_PATH
    if ipc.parse(head_bytes, n.length, &parsed) { return 29 }
    head[ipc.HEADER + 3 + 1] = ipc.FIELD_MEMBER
    message.destination = "1org.example"
    ipc.begin(&n, head_bytes, 128)
    ipc.write(&n, &message, "", ipc.nothingBody(), 0)
    if ipc.parse(head_bytes, n.length, &parsed) { return 30 }
    message.destination = "org.example.Echo"
    message.interface = "Echo"
    ipc.begin(&n, head_bytes, 128)
    ipc.write(&n, &message, "", ipc.nothingBody(), 0)
    if ipc.parse(head_bytes, n.length, &parsed) { return 31 }
    // The same header, D-Bus.
    var header = dbus.newHeader(dbus.METHOD_CALL, 5)
    header.path = "/"
    header.member = "Echo"
    header.destination = "org.example.Echo"
    if !dbus.validHeader(&header) { return 32 }
    header.member = "Bad Name"
    if dbus.validHeader(&header) { return 33 }
    header.member = "Echo"
    header.interface = "Echo"
    if dbus.validHeader(&header) { return 34 }
    header.interface = ""
    header.unixFds = 29
    if dbus.validHeader(&header) { return 35 }
    return 0
}

// xorshift64*: the same numbers on every run.
fn random(state: *u64) -> u64 {
    var x = state.*
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    state.* = x
    return x *% 2685821657736338717
}

fn randomBelow(state: *u64, limit: usize) -> usize { return @intCast(usize, random(state) % @intCast(u64, limit)) }

// A native message with a body of every kind of type, to mutate.
fn sampleNative(bytes: [*]u8, capacity: usize) -> usize {
    var body_memory: [256]u8 = undefined
    const body: [*]u8 = &body_memory
    var w: ipc.Writer = undefined
    ipc.begin(&w, body, 256)
    ipc.putString(&w, "hello")
    const at = ipc.beginArray(&w)
    ipc.putString(&w, "k")
    ipc.putVariantU32(&w, 7)
    ipc.putString(&w, "l")
    ipc.putVariantString(&w, "v")
    ipc.endArray(&w, at, 2)
    ipc.putBool(&w, true)
    ipc.putU32(&w, 0)
    ipc.putU64(&w, 99)
    ipc.putString(&w, "/o/p")
    var message = ipc.newMessage(ipc.CALL, 77)
    message.path = "/org/mlx/Test"
    message.interface = "org.mlx.Test"
    message.member = "Echo"
    message.destination = "org.mlx.Service"
    message.signature = "sa{sv}bhto"
    message.descriptors = 1
    var n: ipc.Writer = undefined
    ipc.begin(&n, bytes, capacity)
    ipc.write(&n, &message, ":1.7", body, w.length)
    return n.length
}

// Mutated native messages: parsed and checked or refused, never worse;
// the ones accepted carried to D-Bus and back whole.
fn fuzzNative() -> u8 {
    var sample: [512]u8 = undefined
    const sample_bytes: [*]u8 = &sample
    const sample_length = sampleNative(sample_bytes, 512)
    var work: [512]u8 = undefined
    const bytes: [*]u8 = &work
    var dbus_memory: [1024]u8 = undefined
    const dbus_bytes: [*]u8 = &dbus_memory
    var scratch: [1024]u8 = undefined
    const scratch_bytes: [*]u8 = &scratch
    var back_memory: [1024]u8 = undefined
    const back_bytes: [*]u8 = &back_memory
    var state: u64 = 88172645463325252
    var accepted: usize = 0
    var round: usize = 0
    while round < 6000 {
        var index: usize = 0
        while index < sample_length {
            work[index] = sample[index]
            index += 1
        }
        var changes = 1 + randomBelow(&state, 4)
        while changes > 0 {
            const at = randomBelow(&state, sample_length)
            const how = randomBelow(&state, 4)
            if how == 0 { work[at] = @intCast(u8, randomBelow(&state, 256)) } else if how == 1 { work[at] = 0 } else if how == 2 { work[at] = 255 } else { work[at] ^= @intCast(u8, 1 << randomBelow(&state, 8)) }
            changes -= 1
        }
        // What the bus does: wait for the size, parse, check.
        const size = ipc.messageSize(bytes, sample_length)
        if size > 0 && size <= sample_length {
            var message: ipc.Message = undefined
            if ipc.parse(bytes, size, &message) {
                const body: [*]const u8 = bytes + message.bodyStart
                if ipc.validMessage(&message, body) {
                    accepted += 1
                    var out: dbus.Writer = undefined
                    dbus.begin(&out, dbus_bytes, 1024, false)
                    if !ipc.toDBus(&message, ":1.7", body, scratch_bytes, &out) { return 1 }
                    var header: dbus.Header = undefined
                    if !dbus.parseHeader(dbus_bytes, out.length, &header) { return 2 }
                    const dbus_body: [*]const u8 = dbus_bytes + header.bodyStart
                    if !dbus.validMessage(&header, dbus_body) { return 3 }
                    var back: ipc.Writer = undefined
                    ipc.begin(&back, back_bytes, 1024)
                    if !ipc.fromDBus(&header, ":1.7", dbus_body, &back) { return 4 }
                    var again: ipc.Message = undefined
                    if !ipc.parse(back_bytes, back.length, &again) { return 5 }
                    if again.kind != message.kind || again.serial != message.serial || again.replySerial != message.replySerial || again.descriptors != message.descriptors { return 6 }
                    if !same(again.member, message.member) || !same(again.path, message.path) || !same(again.signature, message.signature) || !same(again.destination, message.destination) { return 7 }
                    if again.bodyLength != message.bodyLength || !sameBytes(back_bytes + again.bodyStart, body, message.bodyLength) { return 8 }
                } else {
                    // The header alone is still read whole.
                    if message.size != size { return 9 }
                }
            }
        }
        round += 1
    }
    // Most mutations break a message, some leave it whole.
    if accepted < 50 || accepted > 5000 { return 10 }
    return 0
}

// Mutated D-Bus messages: the same, the other way round.
fn fuzzDBus() -> u8 {
    var body_memory: [256]u8 = undefined
    const body: [*]u8 = &body_memory
    var d: dbus.Writer = undefined
    dbus.begin(&d, body, 256, false)
    dbus.putString(&d, "hello")
    const at = dbus.beginArray(&d, 8)
    dbus.pad(&d, 8)
    dbus.putString(&d, "k")
    dbus.putVariantU32(&d, 7)
    dbus.pad(&d, 8)
    dbus.putString(&d, "l")
    dbus.putVariantString(&d, "v")
    dbus.endArray(&d, at, 8)
    dbus.putBool(&d, true)
    dbus.putU32(&d, 0)
    dbus.pad(&d, 8)
    dbus.putU32(&d, 99)
    dbus.putU32(&d, 0)
    dbus.putString(&d, "/o/p")
    var header = dbus.newHeader(dbus.METHOD_CALL, 77)
    header.path = "/org/mlx/Test"
    header.interface = "org.mlx.Test"
    header.member = "Echo"
    header.destination = "org.mlx.Service"
    header.signature = "sa{sv}bhto"
    header.unixFds = 1
    header.bodyLength = d.length
    var sample: [512]u8 = undefined
    const sample_bytes: [*]u8 = &sample
    var s: dbus.Writer = undefined
    dbus.begin(&s, sample_bytes, 512, false)
    dbus.writeMessage(&s, &header, ":1.7", body)
    const sample_length = s.length
    var work: [512]u8 = undefined
    const bytes: [*]u8 = &work
    var native_memory: [1024]u8 = undefined
    const native_bytes: [*]u8 = &native_memory
    var scratch: [1024]u8 = undefined
    const scratch_bytes: [*]u8 = &scratch
    var back_memory: [1024]u8 = undefined
    const back_bytes: [*]u8 = &back_memory
    var state: u64 = 1181783497276652981
    var accepted: usize = 0
    var round: usize = 0
    while round < 6000 {
        var index: usize = 0
        while index < sample_length {
            work[index] = sample[index]
            index += 1
        }
        var changes = 1 + randomBelow(&state, 4)
        while changes > 0 {
            const where = randomBelow(&state, sample_length)
            const how = randomBelow(&state, 4)
            if how == 0 { work[where] = @intCast(u8, randomBelow(&state, 256)) } else if how == 1 { work[where] = 0 } else if how == 2 { work[where] = 255 } else { work[where] ^= @intCast(u8, 1 << randomBelow(&state, 8)) }
            changes -= 1
        }
        const size = dbus.messageSize(bytes, sample_length)
        if size > 0 && size <= sample_length {
            var parsed: dbus.Header = undefined
            if dbus.parseHeader(bytes, size, &parsed) {
                const parsed_body: [*]const u8 = bytes + parsed.bodyStart
                if dbus.validMessage(&parsed, parsed_body) {
                    accepted += 1
                    var n: ipc.Writer = undefined
                    ipc.begin(&n, native_bytes, 1024)
                    if !ipc.fromDBus(&parsed, ":1.7", parsed_body, &n) { return 1 }
                    var message: ipc.Message = undefined
                    if !ipc.parse(native_bytes, n.length, &message) { return 2 }
                    const native_body: [*]const u8 = native_bytes + message.bodyStart
                    if !ipc.validMessage(&message, native_body) { return 3 }
                    var out: dbus.Writer = undefined
                    dbus.begin(&out, back_bytes, 1024, false)
                    if !ipc.toDBus(&message, ":1.7", native_body, scratch_bytes, &out) { return 4 }
                    var again: dbus.Header = undefined
                    if !dbus.parseHeader(back_bytes, out.length, &again) { return 5 }
                    if again.kind != parsed.kind || again.serial != parsed.serial || again.unixFds != parsed.unixFds || !same(again.member, parsed.member) || !same(again.signature, parsed.signature) { return 6 }
                    // Little-endian in, the same bytes out.
                    if !parsed.big && (again.bodyLength != parsed.bodyLength || !sameBytes(back_bytes + again.bodyStart, parsed_body, parsed.bodyLength)) { return 7 }
                }
            }
        }
        round += 1
    }
    if accepted < 50 || accepted > 5000 { return 8 }
    return 0
}

pub fn main() -> u8 {
    const a = values()
    if a != 0 { return a }
    const b = signatures()
    if b != 0 { return 30 + b }
    const c = messages()
    if c != 0 { return 40 + c }
    const d = preamble()
    if d != 0 { return 70 + d }
    const e = conversions()
    if e != 0 { return 80 + e }
    const f = wholeMessages()
    if f != 0 { return 100 + f }
    const g = validators()
    if g != 0 { return 120 + g }
    const h = fuzzNative()
    if h != 0 { return 160 + h }
    const i = fuzzDBus()
    if i != 0 { return 180 + i }
    return 13
}
