// The address of a module-level constant. A constant has no storage of
// its own, so `&NAME` used to lower to no address at all (a read through
// it faulted). A table with an image (tests/442) gives the image's
// address, which is the address of its first element too; another struct
// or array gives its value where it is used; an integer, a boolean or a
// pointer gives a slot holding it. Of this module and of another. Exits
// 13.
const tables = @import("./modules/442_tables.mlx")

const BYTES = [6]u8{ 10, 20, 30, 40, 50, 60 }
const WORDS = [3]usize{ 7, 8, 9 }
const LIMIT: usize = 77
const SMALL: u8 = 200
const FLAG: bool = true
const Pair = struct { a: usize, b: usize }
const PAIR = Pair.{ .a = 3, .b = 4 }

fn readElement(p: *const [6]u8) -> u8 { return p.*[1] }
fn second(m: [*]const u8) -> u8 { return m[1] }
fn word(p: *const usize) -> usize { return p.* }
fn byte(p: *const u8) -> u8 { return p.* }
fn sumPair(p: *const Pair) -> usize { return p.*.a + p.*.b }
fn third(p: *const [8]u16) -> u16 { return p.*[2] }

pub fn main() -> u8 {
    // A pointer to the whole table, read through.
    const p = &BYTES
    if p.*[1] != 20 { return 1 }
    if readElement(&BYTES) != 20 { return 2 }
    // The table as a many-item pointer.
    const m: [*]const u8 = &BYTES
    if m[2] != 30 { return 3 }
    if second(&BYTES) != 20 { return 4 }
    // The table's address is its first element's.
    if @intFromPtr(&BYTES) != @intFromPtr(&BYTES[0]) { return 5 }
    const w = &WORDS
    if w.*[2] != 9 { return 6 }
    // A word, a byte and a boolean.
    if word(&LIMIT) != 77 { return 7 }
    if byte(&SMALL) != 200 { return 8 }
    const f = &FLAG
    if !f.* { return 9 }
    // A struct.
    if sumPair(&PAIR) != 7 { return 10 }
    // Another module's tables.
    const far = &tables.PRIMES
    if far.*[3] != 7 { return 11 }
    if third(&tables.PRIMES) != 5 { return 12 }
    if @intFromPtr(&tables.PRIMES) != @intFromPtr(&tables.PRIMES[0]) { return 14 }
    const corners = &tables.CORNERS
    if corners.*[1].y != -4 { return 15 }
    // In a loop the address stays the table's (nothing is built a turn).
    var total: usize = 0
    var turn: usize = 0
    while turn < 1000 {
        total += @intCast(usize, second(&BYTES))
        turn += 1
    }
    if total != 20000 { return 16 }
    return 13
}
