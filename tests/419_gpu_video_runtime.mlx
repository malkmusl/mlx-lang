// std.gpu.video without a video decoder (lavapipe, or no driver at all):
// a std.gpu context asked for one says it has none and the decoder is
// refused; the parts that need no GPU: the bitstream written for a
// picture's slices (start codes and offsets) and the NV12 to BGRA
// conversion (BT.601 and BT.709, limited and full range) against values
// computed from the matrices; the nv12 kernel's conversion of a picture
// on the device against the host's. With a device that decodes H.264
// (VK_KHR_video_decode_h264) the decoder is made and torn down.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const gpu = @import("std.gpu")
const gvideo = @import("std.gpu.video")
const h264 = @import("std.h264")
const loader = @import("std.vulkan.loader")
const vk = @import("std.vulkan")

const PICTURE_WIDTH: usize = 37
const PICTURE_HEIGHT: usize = 22

fn near(value: u8, expected: i32) -> bool {
    const difference = @intCast(i32, value) - expected
    return difference >= -2 && difference <= 2
}

// One pixel through `conversion`: the three channels of `out`.
fn convertOne(conversion: *const gvideo.Conversion, y: u8, cb: u8, cr: u8, out: [*]u8) -> void {
    var luma = [2]u8{y, y}
    var chroma = [2]u8{cb, cr}
    gvideo.convertNv12(conversion, &luma, 2, &chroma, 2, 1, 1, out, 4)
}

pub fn main(args: [][*]const u8) -> u8 {
    const allocator = std.heap.allocator()

    // The bitstream of a picture with two slices in a length-prefixed
    // access unit.
    var unit = [14]u8{0, 0, 0, 3, 0x65, 0x88, 0x84, 0, 0, 0, 2, 0x41, 0x9a, 0xff}
    var picture: h264.Picture = undefined
    picture.sliceCount = 2
    picture.sliceOffsets[0] = 4
    picture.sliceLengths[0] = 3
    picture.sliceOffsets[1] = 11
    picture.sliceLengths[1] = 2
    if gvideo.bitstreamSize(&picture) != 11 { return 1 }
    var out: [16]u8 = undefined
    var offsets: [2]u32 = undefined
    if gvideo.writeBitstream(&picture, &unit, &out, &offsets) != 11 { return 2 }
    if offsets[0] != 0 || offsets[1] != 6 { return 3 }
    if out[0] != 0 || out[1] != 0 || out[2] != 1 || out[3] != 0x65 || out[4] != 0x88 || out[5] != 0x84 { return 4 }
    if out[6] != 0 || out[7] != 0 || out[8] != 1 || out[9] != 0x41 || out[10] != 0x9a { return 5 }

    // Colour: grey levels, saturated red and blue, in each matrix.
    var conversion: gvideo.Conversion = undefined
    var pixel: [4]u8 = undefined
    gvideo.conversionFor(&conversion, gvideo.MATRIX_BT601, false)
    convertOne(&conversion, 16, 128, 128, &pixel)
    if pixel[0] != 0 || pixel[1] != 0 || pixel[2] != 0 || pixel[3] != 255 { return 6 }
    convertOne(&conversion, 235, 128, 128, &pixel)
    if !near(pixel[0], 255) || !near(pixel[1], 255) || !near(pixel[2], 255) { return 7 }
    convertOne(&conversion, 126, 128, 128, &pixel)
    if !near(pixel[0], 128) || !near(pixel[1], 128) || !near(pixel[2], 128) { return 8 }
    // BT.601 red (255, 0, 0): Y 81, Cb 90, Cr 240.
    convertOne(&conversion, 81, 90, 240, &pixel)
    if !near(pixel[2], 255) || !near(pixel[1], 0) || !near(pixel[0], 0) { return 9 }
    // BT.601 blue (0, 0, 255): Y 41, Cb 240, Cr 110.
    convertOne(&conversion, 41, 240, 110, &pixel)
    if !near(pixel[2], 0) || !near(pixel[1], 0) || !near(pixel[0], 255) { return 10 }
    gvideo.conversionFor(&conversion, gvideo.MATRIX_BT709, false)
    // BT.709 red: Y 63, Cb 102, Cr 240; green (0, 255, 0): Y 173, Cb 42, Cr 26.
    convertOne(&conversion, 63, 102, 240, &pixel)
    if !near(pixel[2], 255) || !near(pixel[1], 0) || !near(pixel[0], 0) { return 11 }
    convertOne(&conversion, 173, 42, 26, &pixel)
    if !near(pixel[2], 0) || !near(pixel[1], 255) || !near(pixel[0], 0) { return 12 }
    gvideo.conversionFor(&conversion, gvideo.MATRIX_BT601, true)
    // Full range: Y 0 is black, 255 white; red is Y 76, Cb 85, Cr 255.
    convertOne(&conversion, 0, 128, 128, &pixel)
    if pixel[0] != 0 || pixel[2] != 0 { return 13 }
    convertOne(&conversion, 255, 128, 128, &pixel)
    if pixel[0] != 255 || pixel[1] != 255 || pixel[2] != 255 { return 14 }
    convertOne(&conversion, 76, 85, 255, &pixel)
    if !near(pixel[2], 255) || !near(pixel[1], 0) || !near(pixel[0], 0) { return 15 }
    // Two rows share a chroma row; the second pixel of a pair its chroma
    // (full range: the grey levels as they are).
    var luma = [4]u8{235, 16, 126, 126}
    var chroma = [2]u8{128, 128}
    var pixels: [16]u8 = undefined
    gvideo.convertNv12(&conversion, &luma, 2, &chroma, 2, 2, 2, &pixels, 8)
    if pixels[0] != 235 || pixels[4] != 16 || pixels[8] != 126 || pixels[12] != 126 || pixels[15] != 255 { return 16 }

    // The device.
    var driver: loader.Driver = undefined
    if loader.openFirstDriver(&driver, args, allocator) != loader.Status.ok { return 13 }
    var context: gpu.Context = undefined
    var options = gpu.defaultOptions("419\x00".pointer)
    options.wantVideo = true
    if gpu.open(&context, driver, &options, allocator) != gpu.Status.ok { return 13 }
    // The nv12 kernel against the host: a 37x22 picture of ramps (luma
    // at an offset into the buffer, as a layer's would be), BT.709
    // limited range, converted into a readback buffer at an offset.
    var kernel: gpu.Kernel = undefined
    if !gvideo.createConverter(&context, allocator, &kernel) { return 21 }
    const lumaBytes = PICTURE_WIDTH * PICTURE_HEIGHT
    const frameBytes = lumaBytes * 3 / 2
    const base: usize = 256
    // (The kernel reads whole words: the buffer covers the last one.)
    var source: gpu.Buffer = undefined
    if !gpu.createBuffer(&context, &source, @intCast(u64, (base + frameBytes + 3) / 4 * 4), false) { return 22 }
    const nv12: [*]u8 = unsafe { @ptrFromInt([*]u8, source.address) }
    var at: usize = 0
    while at < lumaBytes {
        nv12[base + at] = @intCast(u8, (at * 7 + 16) & 255)
        at += 1
    }
    at = 0
    while at < lumaBytes / 2 {
        nv12[base + lumaBytes + at] = @intCast(u8, (at * 13 + 100) & 255)
        at += 1
    }
    var target: gpu.Buffer = undefined
    if !gpu.createReadbackBuffer(&context, &target, @intCast(u64, (PICTURE_WIDTH * PICTURE_HEIGHT + 8) * 4)) { return 23 }
    const targetWords: [*]u32 = unsafe { @ptrFromInt([*]u32, target.address) }
    at = 0
    while at < PICTURE_WIDTH * PICTURE_HEIGHT + 8 {
        targetWords[at] = 0
        at += 1
    }
    gvideo.conversionFor(&conversion, gvideo.MATRIX_BT709, false)
    if !gvideo.convertOnGpu(&context, &kernel, &conversion, source.buffer, base, PICTURE_WIDTH, base + lumaBytes, PICTURE_WIDTH, PICTURE_WIDTH, PICTURE_HEIGHT, target.buffer, 8, PICTURE_WIDTH) { return 24 }
    var expected: [PICTURE_WIDTH * PICTURE_HEIGHT * 4]u8 = undefined
    gvideo.convertNv12(&conversion, &nv12[base], PICTURE_WIDTH, &nv12[base + lumaBytes], PICTURE_WIDTH, PICTURE_WIDTH, PICTURE_HEIGHT, &expected, PICTURE_WIDTH * 4)
    const got: [*]const u8 = unsafe { @ptrFromInt([*]const u8, target.address + 32) }
    at = 0
    while at < PICTURE_WIDTH * PICTURE_HEIGHT * 4 {
        if got[at] != expected[at] { return 25 }
        at += 1
    }
    // The words before the offset untouched.
    const before: [*]const u32 = unsafe { @ptrFromInt([*]const u32, target.address) }
    if before[0] != 0 || before[7] != 0 { return 26 }
    gpu.destroyBuffer(&context, &source)
    gpu.destroyBuffer(&context, &target)

    const decoder = gvideo.create(&context, allocator)
    if gvideo.supported(&context) {
        if context.videoFamily == gpu.NONE_FAMILY || decoder == null { return 17 }
        // No picture: nothing to decode.
        const h = h264.create(allocator).?
        h.*.picture.sliceCount = 0
        if gvideo.decode(decoder.?, h, &unit) != gvideo.Status.corrupt { return 18 }
        if gvideo.readFrame(decoder.?, 0, &pixels, 8) { return 19 }
        h264.destroy(h)
        gvideo.destroy(decoder.?)
    } else {
        if context.videoFamily != gpu.NONE_FAMILY || decoder != null { return 20 }
    }
    gpu.close(&context)
    return 13
}
