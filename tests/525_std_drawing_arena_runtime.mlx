// What std's text, drawing and widgets run every frame takes none of the
// compiler's value arena (std.turns finds it and says how much of it is
// in use), and gives what it gave when it did. The arena is given back
// only where a loop turns (a window's frame), so each call that took some
// made every frame larger: std.ui.text's drawText and drawCells took 4128
// bytes a call (a row's coverage and the colour's mixes, now in the Text);
// std.text's appendUnsigned, appendSigned and appendHex 24 (an array of
// digits handed on as a slice, now written straight into the line);
// drawImageRect 6 KiB (three arrays of 512 columns, now 256: 1 KiB each,
// what the frame takes); view.region and view.pushClip 16 at every widget
// and ui.next 32 (a rectangle variable given a new value); a terminal's
// frame 20 KiB and a KiB a row drawn (std.ui.terminal, now in its
// View); the file chooser's rows 48 each; the look apps take every frame
// (std.ui.theme.at with the desktop's colours) 48, in std.ui.scheme.glass
// (a scheme variable given the current one, now each handed on as it
// is). Each is compared with the code it replaces (here as it was) on
// numbers, lines cut short, text and images on and off the canvas,
// colours at every lightness, and run in a window of the arena that must
// not grow. Without a font the text is not compared (said so); where the
// arena is not found (an emulator) only what is drawn is compared. Exits
// 13 (14 and 15 are the look's checks).
const std = @import("std")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const scheme_module = @import("std.ui.scheme")
const controls = @import("std.ui.controls")
const lists = @import("std.ui.lists")
const tabs = @import("std.ui.tabs")
const chooser_module = @import("std.ui.chooser")
const ui_terminal = @import("std.ui.terminal")
const terminal = @import("std.terminal")
const tt = @import("std.truetype")
const png = @import("std.png")

const Canvas = canvas_module.Canvas

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

// ---------------------------------------------------------------------------
// Chance

var seed: u64 = 88172645463325252 // (per run)

fn chance() -> u64 {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    return seed
}

fn below(limit: usize) -> usize { return @intCast(usize, chance() % @intCast(u64, limit)) }

fn between(low: i32, high: i32) -> i32 { return low + @intCast(i32, below(@intCast(usize, high - low + 1))) }

// ---------------------------------------------------------------------------
// The arena

var base: usize = 0 // (per run)

// The arena's bytes in use (0 where it is not found).
fn used() -> usize { return if base == 0 { 0 } else { turns.used(base) } }

// ---------------------------------------------------------------------------
// std.text's numbers as they were written: the digits into an array of
// their own (std.fmt's unsignedBase), then appended.

fn oldDigits(value: usize, radix: usize, destination: [*]u8) -> usize {
    if value == 0 {
        destination[0] = 48
        return 1
    }
    var remaining = value
    var length: usize = 0
    while remaining > 0 {
        const digit = remaining % radix
        destination[length] = if digit < 10 { 48 + @intCast(u8, digit) } else { 87 + @intCast(u8, digit) }
        remaining = remaining / radix
        length += 1
    }
    var left: usize = 0
    var right = length - 1
    while left < right {
        const kept = destination[left]
        destination[left] = destination[right]
        destination[right] = kept
        left += 1
        right -= 1
    }
    return length
}

fn oldNumber(into: [*]u8, at: usize, capacity: usize, value: usize, radix: usize) -> usize {
    if at >= capacity { return at }
    var digits: [24]u8 = undefined
    const digit_bytes: [*]u8 = &digits
    const count = oldDigits(value, radix, digit_bytes)
    return std.text.append(into, at, capacity, digit_bytes[0..count])
}

fn oldSigned(into: [*]u8, at: usize, capacity: usize, value: isize) -> usize {
    var length = at
    if value < 0 { length = std.text.appendByte(into, length, capacity, 45) }
    const magnitude = if value >= 0 { @intCast(usize, value) } else { @intCast(usize, -(value + 1)) + 1 }
    return oldNumber(into, length, capacity, magnitude, 10)
}

var old_line: [64]u8 = undefined // (per run)
var new_line: [64]u8 = undefined // (per run)

fn fillLines() -> void {
    var index: usize = 0
    while index < 64 {
        old_line[index] = 165
        new_line[index] = 165
        index += 1
    }
}

fn sameLines() -> bool {
    var index: usize = 0
    while index < 64 {
        if old_line[index] != new_line[index] { return false }
        index += 1
    }
    return true
}

// `value` appended both ways after `at` (0 or 3 bytes) with every capacity
// that cuts it and one that does not: the same bytes, nothing past the
// capacity, the same length. `kind`: 0 decimal, 1 hex, 2 signed.
fn sameNumber(value: usize, kind: u8) -> bool {
    var at: usize = 0
    while at <= 3 {
        var capacity = at
        while capacity <= at + 24 {
            const room = if capacity == at + 24 { 64 } else { capacity }
            fillLines()
            const old_into: [*]u8 = &old_line
            const new_into: [*]u8 = &new_line
            var old_length: usize = 0
            var new_length: usize = 0
            if kind == 0 {
                old_length = oldNumber(old_into, at, room, value, 10)
                new_length = std.text.appendUnsigned(new_into, at, room, value)
            } else if kind == 1 {
                old_length = oldNumber(old_into, at, room, value, 16)
                new_length = std.text.appendHex(new_into, at, room, value)
            } else {
                old_length = oldSigned(old_into, at, room, @bitCast(isize, value))
                new_length = std.text.appendSigned(new_into, at, room, @bitCast(isize, value))
            }
            if old_length != new_length || !sameLines() { return false }
            capacity += 1
        }
        at += 3
    }
    return true
}

// Numbers at every length, at each power of ten and sixteen and beside
// it, the ends of the range, and at chance.
fn numbers(kind: u8) -> bool {
    var power: usize = 1
    var step: usize = 0
    while step < 20 {
        if !sameNumber(power, kind) || !sameNumber(power - 1, kind) || !sameNumber(power + 1, kind) { return false }
        if step < 19 { power = power * 10 }
        step += 1
    }
    power = 1
    step = 0
    while step < 16 {
        if !sameNumber(power, kind) || !sameNumber(power - 1, kind) || !sameNumber(power + 1, kind) { return false }
        if step < 15 { power = power * 16 }
        step += 1
    }
    if !sameNumber(0, kind) || !sameNumber(18446744073709551615, kind) || !sameNumber(9223372036854775808, kind) || !sameNumber(9223372036854775807, kind) { return false }
    var round: usize = 0
    while round < 300 {
        // (Of every size: the high bits cut away at chance.)
        if !sameNumber(@intCast(usize, chance() >> @intCast(u6, below(64))), kind) { return false }
        round += 1
    }
    return true
}

// The three appends a thousand times each: the arena in use the same after.
fn numbersInArena() -> bool {
    const into: [*]u8 = &new_line
    const before = used()
    var round: usize = 0
    var length: usize = 0
    while round < 1000 {
        length = std.text.appendUnsigned(into, 0, 64, round * 7919)
        length = std.text.appendSigned(into, length, 64, -12345)
        length = std.text.appendHex(into, length, 64, round * 104729)
        round += 1
    }
    return used() == before
}

// ---------------------------------------------------------------------------
// Text as std.ui.text drew it: a row's coverage and the colour's mixes in
// the frame of each call.

fn atlasOf(text: *text_module.Text) -> *tt.Atlas {
    unsafe { return @ptrCast(*tt.Atlas, &text.*.atlas) }
}

fn runOf(text: *text_module.Text) -> *tt.Run {
    unsafe { return @ptrCast(*tt.Run, &text.*.run) }
}

fn oldDrawText(canvas: *Canvas, text: *text_module.Text, string: []const u8, x: i32, y: i32, given: u32, limit: i32) -> void {
    if !text.*.loaded { return }
    const color = canvas_module.faded(canvas, given)
    tt.layout(atlasOf(text), string, runOf(text))
    oldDrawRun(canvas, text, x, y + text.*.ascent, color, limit)
}

fn oldDrawCells(canvas: *Canvas, text: *text_module.Text, string: []const u8, x: i32, y: i32, given: u32, pitch: i32, top: i32, height: i32) -> void {
    if !text.*.loaded || pitch <= 0 || height <= 0 { return }
    const color = canvas_module.faded(canvas, given)
    const baseline = y + text.*.ascent
    const bytes: [*]const u8 = string.pointer
    tt.layoutCells(atlasOf(text), bytes, string.length, runOf(text), pitch, top - baseline, top + height - baseline)
    oldDrawRun(canvas, text, x, baseline, color, 0)
}

fn oldDrawRun(canvas: *Canvas, text: *text_module.Text, x: i32, baseline: i32, color: u32, limit: i32) -> void {
    const run = runOf(text)
    if run.*.count == 0 { return }
    var row = if baseline + run.*.top < 0 { 0 - baseline } else { run.*.top }
    const row_end = if baseline + run.*.bottom > @intCast(i32, canvas.*.height) { @intCast(i32, canvas.*.height) - baseline } else { run.*.bottom }
    const column_start = if x + run.*.left < 0 { 0 - x } else { run.*.left }
    const column_end = if x + run.*.right > @intCast(i32, canvas.*.width) { @intCast(i32, canvas.*.width) - x } else { run.*.right }
    var end = column_end
    if limit > 0 && limit < end { end = limit }
    if end <= column_start { return }
    const count = @intCast(usize, end - column_start)
    var buffer: [2048]u8 = undefined
    const coverage: [*]u8 = &buffer
    var mixes: canvas_module.Mixes = undefined
    canvas_module.beginMixes(&mixes)
    while row < row_end {
        const line = @intCast(usize, baseline + row) * canvas.*.stride + @intCast(usize, x + column_start)
        var piece: usize = 0
        while piece < count {
            const width = if count - piece > 2048 { 2048 } else { count - piece }
            tt.runRowCoverage(atlasOf(text), run, row, column_start + @intCast(i32, piece), width, coverage)
            canvas_module.coverSpan(canvas, line + piece, coverage, width, color, &mixes)
            piece += width
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// Two canvases of the same pixels (a wide one: a line of text longer than
// a row's 2048 pixels of coverage, an image wider than its parts)

const WIDE: usize = 2600
const HIGH: usize = 48
const STRIDE: usize = WIDE + 5

var first: [STRIDE * HIGH]u32 = undefined // (per run)
var second: [STRIDE * HIGH]u32 = undefined // (per run)

fn pair(one: *Canvas, other: *Canvas, width: usize, swap: bool, opacity: u32) -> void {
    one.* = Canvas.{ .pixels = &first, .width = width, .height = HIGH, .stride = STRIDE, .swapRedBlue = swap, .device = 0, .opacity = opacity }
    other.* = Canvas.{ .pixels = &second, .width = width, .height = HIGH, .stride = STRIDE, .swapRedBlue = swap, .device = 0, .opacity = opacity }
    // A background of a few colours side by side, some of them see-through.
    var pixel: u32 = 0
    var index: usize = 0
    while index < STRIDE * HIGH {
        if below(9) == 0 { pixel = canvas_module.color(@intCast(u32, if below(2) == 0 { 255 } else { below(256) }), @intCast(u32, below(256)), @intCast(u32, below(256)), @intCast(u32, below(256))) }
        first[index] = pixel
        second[index] = pixel
        index += 1
    }
}

fn sameCanvases() -> bool {
    var index: usize = 0
    while index < STRIDE * HIGH {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn colour() -> u32 {
    const pick = below(5)
    if pick == 0 { return 0 }
    const alpha: u32 = if pick < 3 { 255 } else { @intCast(u32, below(256)) }
    return canvas_module.color(alpha, @intCast(u32, below(256)), @intCast(u32, below(256)), @intCast(u32, below(256)))
}

const STRINGS: usize = 6

fn stringOf(index: usize) -> []const u8 {
    if index == 0 { return "Hello, world" }
    if index == 1 { return "AVAToj fi {W} gy|_^" }
    if index == 2 { return "Größe: 12 kB, \xe2\x80\x94 \xe2\x9c\x93" }
    if index == 3 { return "" }
    if index == 4 { return "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW" }
    return "mono 0123456789 () {}"
}

// Text on and off the canvas, at every edge, cut short or not, in every
// kind of colour, both byte orders, faded: the pixels the old drawing gave.
fn texts(text: *text_module.Text) -> bool {
    var one: Canvas = undefined
    var other: Canvas = undefined
    var round: usize = 0
    while round < 300 {
        const wide = below(6) == 0
        pair(&one, &other, if wide { WIDE } else { 1 + below(300) }, below(2) == 0, if below(4) == 0 { @intCast(u32, below(256)) } else { 255 })
        const string = stringOf(if wide { 4 } else { below(STRINGS) })
        const x = between(-40, @intCast(i32, one.width))
        const y = between(-20, @intCast(i32, HIGH))
        const color = colour()
        const limit: i32 = if below(3) == 0 { between(1, 200) } else { 0 }
        if round % 2 == 0 {
            text_module.drawText(&one, text, string, x, y, color, limit)
            oldDrawText(&other, text, string, x, y, color, limit)
        } else {
            const pitch = between(1, 16)
            const top = between(y - 4, y + 10)
            const height = between(1, 24)
            text_module.drawCells(&one, text, string, x, y, color, pitch, top, height)
            oldDrawCells(&other, text, string, x, y, color, pitch, top, height)
        }
        if !sameCanvases() { return false }
        round += 1
    }
    return true
}

// Text drawn a thousand times (in pieces too): the arena the same after.
fn textsInArena(text: *text_module.Text) -> bool {
    var canvas: Canvas = undefined
    var other: Canvas = undefined
    pair(&canvas, &other, WIDE, false, 255)
    const before = used()
    var round: usize = 0
    while round < 1000 {
        text_module.drawText(&canvas, text, "Hello, world", 10, 10, 4278190080, 0)
        text_module.drawCells(&canvas, text, "cells", 10, 20, 2155905152, 8, 20, 16)
        round += 1
    }
    text_module.drawText(&canvas, text, stringOf(4), -5, 5, 2155905152, 0)
    return used() == before
}

// ---------------------------------------------------------------------------
// drawImageRect as it was: 512 columns worked out at once.

const OLD_COLUMNS: usize = 512

fn smallerOf(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }

fn clampTo(value: i32, limit: i32) -> i32 {
    if value < 0 { return 0 }
    if value >= limit { return limit - 1 }
    return value
}

fn swapRedBlue(color: u32) -> u32 {
    return color & 4278255360 | (color & 16711680) >> 16 | (color & 255) << 16
}

fn blueRed(pixel: u32) -> u64 {
    const word = @intCast(u64, pixel)
    return (word & 0xFF) | ((word & 0xFF0000) << 16)
}

fn greenAlpha(pixel: u32) -> u64 {
    const word = @intCast(u64, pixel)
    return ((word >> 8) & 0xFF) | ((word >> 24) << 32)
}

fn oldImageRect(canvas: *Canvas, image: *const png.Image, x: i32, y: i32, width: i32, height: i32, given: u32) -> void {
    const opacity = given * (if canvas.*.opacity > 255 { 255 } else { canvas.*.opacity }) / 255
    if width <= 0 || height <= 0 || image.*.width == 0 { return }
    if opacity == 0 { return }
    const source_width = @intCast(i32, image.*.width)
    const source_height = @intCast(i32, image.*.height)
    var range: [4]i32 = undefined
    range[0] = if y < 0 { 0 - y } else { 0 }
    range[1] = smallerOf(height, @intCast(i32, canvas.*.height) - y)
    range[2] = if x < 0 { 0 - x } else { 0 }
    range[3] = smallerOf(width, @intCast(i32, canvas.*.width) - x)
    if range[3] <= range[2] || range[1] <= range[0] { return }
    const swap = canvas.*.swapRedBlue
    const pixels = canvas.*.pixels
    const source = image.*.pixels
    var left: [OLD_COLUMNS]u32 = undefined
    var right: [OLD_COLUMNS]u32 = undefined
    var along: [OLD_COLUMNS]u32 = undefined
    var part = range[2]
    while part < range[3] {
        const part_end = smallerOf(part + @intCast(i32, OLD_COLUMNS), range[3])
        const columns = @intCast(usize, part_end - part)
        var column: usize = 0
        while column < columns {
            const sx = (((part + @intCast(i32, column)) * 2 + 1) * source_width * 128) / width - 128
            const x0 = clampTo(if sx < 0 { 0 } else { sx / 256 }, source_width)
            left[column] = @intCast(u32, x0)
            right[column] = @intCast(u32, clampTo(x0 + 1, source_width))
            along[column] = @intCast(u32, if sx < 0 { 0 } else { sx % 256 })
            column += 1
        }
        var row = range[0]
        while row < range[1] {
            const sy = ((row * 2 + 1) * source_height * 128) / height - 128
            const y0 = clampTo(if sy < 0 { 0 } else { sy / 256 }, source_height)
            const top = @intCast(usize, y0 * source_width)
            const bottom = @intCast(usize, clampTo(y0 + 1, source_height) * source_width)
            const fy = @intCast(u64, if sy < 0 { 0 } else { sy % 256 })
            const line = @intCast(usize, y + row) * canvas.*.stride + @intCast(usize, x + part)
            column = 0
            while column < columns {
                const x0 = @intCast(usize, left[column])
                const x1 = @intCast(usize, right[column])
                const a = source[top + x0]
                const b = source[top + x1]
                const c = source[bottom + x0]
                const d = source[bottom + x1]
                var pixel = a
                if a != b || a != c || a != d {
                    const fx = @intCast(u64, along[column])
                    const low = ((blueRed(a) * (256 - fx) + blueRed(b) * fx) * (256 - fy) + (blueRed(c) * (256 - fx) + blueRed(d) * fx) * fy) >> 16
                    const high = ((greenAlpha(a) * (256 - fx) + greenAlpha(b) * fx) * (256 - fy) + (greenAlpha(c) * (256 - fx) + greenAlpha(d) * fx) * fy) >> 16
                    pixel = @intCast(u32, (low & 0xFF) | ((high & 0xFF) << 8) | (((low >> 32) & 0xFF) << 16) | (((high >> 32) & 0xFF) << 24))
                }
                if pixel != 0 {
                    const own = if swap { swapRedBlue(pixel) } else { pixel }
                    if opacity >= 255 && (pixel >> 24) == 255 {
                        pixels[line + column] = own
                    } else {
                        pixels[line + column] = canvas_module.over(pixels[line + column], own, opacity)
                    }
                }
                column += 1
            }
            row += 1
        }
        part = part_end
    }
}

var picture: [60 * 40]u32 = undefined // (per run)

// Images scaled to every width up to beyond both part sizes, on and off
// the canvas: the old pixels.
fn images() -> bool {
    var one: Canvas = undefined
    var other: Canvas = undefined
    var image = png.Image.{ .pixels = &picture, .width = 1, .height = 1, .allocator = std.heap.allocator() }
    var round: usize = 0
    while round < 200 {
        pair(&one, &other, 1 + below(WIDE), below(2) == 0, if below(4) == 0 { @intCast(u32, below(256)) } else { 255 })
        image.width = 1 + below(60)
        image.height = 1 + below(40)
        var index: usize = 0
        var pixel = colour()
        while index < image.width * image.height {
            if below(5) == 0 { pixel = colour() }
            picture[index] = pixel
            index += 1
        }
        const x = between(-300, @intCast(i32, one.width))
        const y = between(-10, @intCast(i32, HIGH))
        const width = between(1, 1400)
        const height = between(1, 60)
        const given: u32 = if below(3) == 0 { @intCast(u32, below(256)) } else { 255 }
        canvas_module.drawImageRect(&one, &image, x, y, width, height, given)
        oldImageRect(&other, &image, x, y, width, height, given)
        if !sameCanvases() { return false }
        round += 1
    }
    return true
}

fn imagesInArena() -> bool {
    var canvas: Canvas = undefined
    var other: Canvas = undefined
    pair(&canvas, &other, WIDE, false, 255)
    var image = png.Image.{ .pixels = &picture, .width = 60, .height = 40, .allocator = std.heap.allocator() }
    const before = used()
    var round: usize = 0
    while round < 200 {
        canvas_module.drawImageRect(&canvas, &image, -20, 2, 1300, 40, 200)
        canvas_module.drawImage(&canvas, &image, 30, 4, 32, 255)
        round += 1
    }
    return used() == before
}

// ---------------------------------------------------------------------------
// Widgets, a stack's layout, a terminal's frames and the file chooser

// ui.next as it was.
fn oldNext(line: *ui.Stack, child: ui.Size) -> ui.Rect {
    const area = line.*.area
    var used_ = line.*.used
    if line.*.count > 0 { used_ = used_ + line.*.spacing }
    var placed = ui.rect(0, 0, 0, 0)
    if line.*.axis == ui.Axis.horizontal {
        const height = if line.*.cross == ui.Align.fill { area.height } else { child.height }
        placed = ui.rect(area.x + used_, area.y + oldOffset(area.height, height, line.*.cross), child.width, height)
        used_ = used_ + child.width
    } else {
        const width = if line.*.cross == ui.Align.fill { area.width } else { child.width }
        placed = ui.rect(area.x + oldOffset(area.width, width, line.*.cross), area.y + used_, width, child.height)
        used_ = used_ + child.height
    }
    line.*.used = used_
    line.*.count = line.*.count + 1
    return placed
}

fn oldOffset(space: i32, length: i32, align_to: ui.Align) -> i32 {
    if align_to == ui.Align.center {
        const spare = space - length
        if spare < 0 { return -((1 - spare) / 2) }
        return spare / 2
    }
    if align_to == ui.Align.end { return space - length }
    return 0
}

fn alignOf(index: usize) -> ui.Align {
    if index == 0 { return ui.Align.start }
    if index == 1 { return ui.Align.center }
    if index == 2 { return ui.Align.end }
    return ui.Align.fill
}

fn sameRect(a: ui.Rect, b: ui.Rect) -> bool { return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height }

fn stacks() -> bool {
    var round: usize = 0
    while round < 200 {
        const area = ui.rect(between(-50, 50), between(-50, 50), between(0, 300), between(0, 300))
        const axis = if below(2) == 0 { ui.Axis.horizontal } else { ui.Axis.vertical }
        var one = ui.stack(area, axis, between(0, 12), alignOf(below(4)))
        var other = ui.stack(area, axis, one.spacing, one.cross)
        var child: usize = 0
        while child < 6 {
            const size = ui.size(between(0, 80), between(0, 400))
            if !sameRect(ui.next(&one, size), oldNext(&other, size)) { return false }
            child += 1
        }
        if one.used != other.used || one.count != other.count { return false }
        round += 1
    }
    return true
}

// A frame of widgets (with a clip, rows and tabs) and a stack laid out:
// the arena the same after.
fn widgetsInArena(context: *view.Ui, canvas: *Canvas) -> bool {
    const before = used()
    var round: usize = 0
    while round < 50 {
        view.begin(context, canvas)
        var line = ui.stack(ui.rect(0, 0, 300, 40), ui.Axis.horizontal, 4, ui.Align.center)
        const ok = controls.button(context, view.id("ok"), ui.next(&line, ui.size(80, 30)), "OK", controls.BUTTON_NORMAL, true)
        const check = controls.checkRow(context, view.id("check"), ui.next(&line, ui.size(120, 20)), "Shown", controls.CHECK_ON)
        view.pushClip(context, ui.rect(0, 40, 300, 100))
        var row: usize = 0
        while row < 8 {
            const chosen = lists.row(context, view.idOf(view.id("row"), row), ui.rect(0, 40 + @intCast(i32, row) * 20, 300, 20), "row", "note", row == 2, 0, 0)
            row += 1
        }
        view.popClip(context)
        const tab = tabs.tab(context, view.id("tab"), view.id("tab close"), ui.rect(10, 150, 120, 28), "file.mlx", true, true, context.*.theme.*.background)
        const again = view.end(context)
        round += 1
    }
    return used() == before
}

fn chooserInArena(context: *view.Ui, canvas: *Canvas) -> bool {
    var chooser = chooser_module.Chooser.init()
    defer chooser.deinit()
    chooser_module.start(&chooser, "/etc", true, "")
    const before = used()
    var round: usize = 0
    while round < 20 {
        view.begin(context, canvas)
        const result = chooser_module.draw(&chooser, context, ui.rect(0, 0, 600, 400))
        const again = view.end(context)
        round += 1
    }
    return used() == before
}

var screen_pixels: [600 * 300]u32 = undefined // (per run)

// A terminal drawn whole, then updated after typing, a line scrolled and
// nothing: the arena the same after.
fn terminalInArena(mono: *text_module.Text) -> bool {
    const allocator = std.heap.allocator()
    var screen: terminal.Screen = undefined
    if !terminal.init(&screen, allocator, 60, 16, 100) { return false }
    var terminal_view: ui_terminal.View = undefined
    ui_terminal.init(&terminal_view, &screen, mono, 13, 4)
    var canvas = Canvas.{ .pixels = &screen_pixels, .width = 600, .height = 300, .stride = 600, .swapRedBlue = false, .device = 0, .opacity = 255 }
    var row: usize = 0
    while row < 16 {
        terminal.feed(&screen, "a line of text, \x1b[31mred\x1b[0m, \x1b[7minverse\x1b[0m and more\r\n")
        row += 1
    }
    const area = ui.rect(0, 0, ui_terminal.pixelWidth(&terminal_view, 60), ui_terminal.pixelHeight(&terminal_view, 16))
    const before = used()
    var round: usize = 0
    var drawn = area
    while round < 20 {
        ui_terminal.draw(&terminal_view, &canvas, area)
        terminal.feed(&screen, "typed")
        drawn = ui_terminal.update(&terminal_view, &canvas, area, true)
        terminal.feed(&screen, " and a line\r\n")
        drawn = ui_terminal.update(&terminal_view, &canvas, area, true)
        drawn = ui_terminal.update(&terminal_view, &canvas, area, true)
        round += 1
    }
    return used() == before
}

var widget_pixels: [600 * 400]u32 = undefined // (per run)

// ---------------------------------------------------------------------------
// The desktop's look (std.ui.theme.at, which apps take every frame; with
// the desktop's colours it takes std.ui.scheme.glass)

// scheme.glass as it was: a scheme variable given the scheme set (here
// `set`, when `known`), 48 bytes of the arena a call.
fn oldGlass(set: *const scheme_module.Scheme, known: bool, lightness: i32) -> u32 {
    var scheme = scheme_module.fromSeed(scheme_module.DEFAULT_ACCENT)
    if known { scheme = set.* }
    const at = if lightness < 0 { 0 } else if lightness > 1024 { 1024 } else { lightness }
    const straight = scheme_module.mix(scheme_module.glassOf(&scheme, false, true), scheme_module.glassOf(&scheme, true, true), at)
    const alpha = scheme_module.glassAlpha()
    const red = ((straight >> 16) & 255) * alpha / 255
    const green = ((straight >> 8) & 255) * alpha / 255
    const blue = (straight & 255) * alpha / 255
    return (alpha << 24) | (red << 16) | (green << 8) | blue
}

// At every lightness (and past both ends), without a scheme and with
// schemes at chance (their glass's opacity too): the old glass, alone and
// in theme.at's look.
fn looks() -> bool {
    var set = scheme_module.fromSeed(scheme_module.DEFAULT_ACCENT)
    var round: usize = 0
    while round < 40 {
        const known = round > 0
        if known {
            set = scheme_module.fromSeed(@intCast(u32, chance() & 16777215) | 4278190080)
            if below(3) == 0 { set.glassAlpha = @intCast(u32, below(256)) }
            scheme_module.set(&set)
        }
        var lightness: i32 = -40
        while lightness <= 1070 {
            const old = oldGlass(&set, known, lightness)
            if scheme_module.glass(lightness) != old { return false }
            if known && theme_module.at(lightness).glass != old { return false }
            lightness += 9
        }
        round += 1
    }
    scheme_module.clear()
    return true
}

var look: theme_module.Theme = undefined // (per run)

// The look of a frame taken a thousand times, gliding, with the desktop's
// colours and without: the arena the same after.
fn looksInArena() -> bool {
    const seeded = scheme_module.fromSeed(4282549503)
    scheme_module.set(&seeded)
    const before = used()
    var round: usize = 0
    while round < 1000 {
        look = theme_module.scaled(theme_module.at(@intCast(i32, round)), 2)
        round += 1
    }
    scheme_module.clear()
    round = 0
    while round < 1000 {
        look = theme_module.at(@intCast(i32, round))
        look.glass = scheme_module.glass(@intCast(i32, round))
        round += 1
    }
    return used() == before
}

pub fn main() -> u8 {
    base = turns.locate()
    if base == 0 { say("(the arena is not found: only what is drawn is compared)\n") }
    if !numbers(0) {
        say("FAIL appendUnsigned does not give the old bytes and length\n")
        return 1
    }
    if !numbers(2) {
        say("FAIL appendSigned does not give the old bytes and length\n")
        return 2
    }
    if !numbers(1) {
        say("FAIL appendHex does not give the old bytes and length\n")
        return 3
    }
    if !numbersInArena() {
        say("FAIL appendUnsigned, appendSigned or appendHex takes the value arena's memory\n")
        return 4
    }
    if !images() {
        say("FAIL drawImageRect does not give the old pixels\n")
        return 5
    }
    if !imagesInArena() {
        say("FAIL drawImageRect takes the value arena's memory\n")
        return 6
    }
    if !stacks() {
        say("FAIL ui.next does not give the old rectangles\n")
        return 7
    }
    const allocator = std.heap.allocator()
    var font: text_module.Text = undefined
    var mono: text_module.Text = undefined
    const has_font = text_module.loadText(&font, 15, allocator)
    const has_mono = text_module.loadMonoText(&mono, 13, allocator)
    if has_font {
        if !texts(&font) {
            say("FAIL drawText or drawCells does not give the old pixels\n")
            return 8
        }
        if !textsInArena(&font) {
            say("FAIL drawText or drawCells takes the value arena's memory\n")
            return 9
        }
    } else {
        say("(no font found: text is not compared)\n")
        font.loaded = false
        font.ascent = 12
    }
    if !has_mono {
        mono.loaded = false
        mono.ascent = 10
    }
    var canvas = Canvas.{ .pixels = &widget_pixels, .width = 600, .height = 400, .stride = 600, .swapRedBlue = false, .device = 0, .opacity = 255 }
    var theme = theme_module.dark()
    var context: view.Ui = undefined
    view.init(&context, &theme, &font, &font, &mono)
    if !widgetsInArena(&context, &canvas) {
        say("FAIL a frame of widgets or a stack's layout takes the value arena's memory\n")
        return 10
    }
    if !terminalInArena(&mono) {
        say("FAIL a terminal's frame takes the value arena's memory\n")
        return 11
    }
    if !chooserInArena(&context, &canvas) {
        say("FAIL the file chooser's frame takes the value arena's memory\n")
        return 12
    }
    if !looks() {
        say("FAIL std.ui.scheme.glass or theme.at does not give the old colours\n")
        return 14
    }
    if !looksInArena() {
        say("FAIL theme.at or std.ui.scheme.glass takes the value arena's memory\n")
        return 15
    }
    return 13
}
