// std.tar: header blocks written and read back (a short name, one split
// into ustar's prefix and name, a directory's with its slash, a link's
// target, the checksum as tar computes it, a name that cannot be
// stored), and the files of an archive in memory. Exits 13 when every
// check holds, else the number of the first check that failed.
const tar = @import("std.tar")

fn same(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var k: usize = 0
    while k < left.length {
        if left[k] != right[k] { return false }
        k += 1
    }
    return true
}

// The checksum tar computes: the block's bytes with the checksum field
// as spaces.
fn checksum(block: [*]const u8) -> usize {
    var sum: usize = 0
    var k: usize = 0
    while k < tar.BLOCK {
        sum += if k >= 148 && k < 156 { 32 } else { @intCast(usize, block[k]) }
        k += 1
    }
    return sum
}

fn octal(block: [*]const u8, at: usize, width: usize) -> usize {
    var value: usize = 0
    var k: usize = 0
    while k < width && block[at + k] >= 48 && block[at + k] <= 55 {
        value = value * 8 + @intCast(usize, block[at + k] - 48)
        k += 1
    }
    return value
}

var archive: [8 * tar.BLOCK]u8 = undefined // (per run)
var longName: [200]u8 = undefined // (per run)

pub fn main() -> u8 {
    var block: [tar.BLOCK]u8 = undefined
    const b: [*]u8 = &block
    var header: tar.Header = undefined
    // 1. A short name, a file.
    if !tar.writeHeader(b, "a/b.txt", tar.FILE, 420, 5, 1700000000, "") { return 1 }
    if !tar.parseHeader(b, &header) { return 2 }
    if !same(tar.headerName(&header), "a/b.txt") || header.kind != tar.FILE || header.size != 5 || header.mode != 420 || header.modified != 1700000000 { return 3 }
    if octal(b, 148, 8) != checksum(b) || block[155] != 32 { return 4 }
    if block[257] != 117 || block[258] != 115 || block[262] != 0 || block[263] != 48 { return 5 }
    // 2. A long name: split around a slash into prefix and name.
    var k: usize = 0
    while k < 200 {
        longName[k] = if k % 40 == 39 { 47 } else { @intCast(u8, 97 + k % 26) }
        k += 1
    }
    const long: [*]const u8 = &longName
    if !tar.writeHeader(b, long[0..180], tar.FILE, 493, 1, 0, "") { return 6 }
    if block[0] == 0 || block[345] == 0 { return 7 }
    if !tar.parseHeader(b, &header) || !same(tar.headerName(&header), long[0..180]) || header.mode != 493 { return 8 }
    // 3. A directory's name ends in a slash: the split keeps a name.
    if !tar.writeHeader(b, long[0..160], tar.DIRECTORY, 493, 0, 0, "") { return 9 }
    if block[0] == 0 { return 10 }
    if !tar.parseHeader(b, &header) || !same(tar.headerName(&header), long[0..160]) || header.kind != tar.DIRECTORY || header.size != 0 { return 11 }
    // 4. A name with no slash to split at.
    var solid: [120]u8 = undefined
    k = 0
    while k < 120 {
        solid[k] = 120
        k += 1
    }
    const s: [*]const u8 = &solid
    if tar.writeHeader(b, s[0..120], tar.FILE, 420, 0, 0, "") { return 12 }
    // 5. A link's target.
    if !tar.writeHeader(b, "link", tar.SYMBOLIC_LINK, 511, 99, 0, "../target") { return 14 }
    if !tar.parseHeader(b, &header) || !same(tar.headerLink(&header), "../target") || header.size != 0 || header.kind != tar.SYMBOLIC_LINK { return 15 }
    // 6. An archive in memory: a directory, two files, the end.
    const a: [*]u8 = &archive
    k = 0
    while k < 8 * tar.BLOCK {
        archive[k] = 0
        k += 1
    }
    if !tar.writeHeader(a, "d/", tar.DIRECTORY, 493, 0, 0, "") { return 16 }
    if !tar.writeHeader(a + tar.BLOCK, "d/one", tar.FILE, 420, 3, 0, "") { return 17 }
    archive[2 * tar.BLOCK] = 111
    archive[2 * tar.BLOCK + 1] = 110
    archive[2 * tar.BLOCK + 2] = 101
    if !tar.writeHeader(a + 3 * tar.BLOCK, "d/two", tar.FILE, 420, 600, 0, "") { return 18 }
    k = 0
    while k < 600 {
        archive[4 * tar.BLOCK + k] = @intCast(u8, k % 251)
        k += 1
    }
    var reader = tar.reader(a, 8 * tar.BLOCK)
    var entry: tar.Entry = undefined
    if !tar.next(&reader, &entry) || !same(tar.name(&entry), "d/one") || entry.size != 3 || !same(entry.data[0..3], "one") { return 19 }
    if !tar.next(&reader, &entry) || !same(tar.name(&entry), "d/two") || entry.size != 600 || entry.data[599] != 599 % 251 { return 20 }
    if tar.next(&reader, &entry) { return 21 }
    if tar.dataBlocks(600) != 1024 || tar.dataBlocks(0) != 0 || tar.dataBlocks(512) != 512 { return 22 }
    // 7. A zero block is the end.
    if tar.parseHeader(a + 6 * tar.BLOCK, &header) { return 23 }
    return 13
}
