// What the kernel's network stack works out from its configuration alone
// (projects/brix/kernel/net/reach.mlx, built for the host): which four
// bytes are a netmask (one bits, then zero bits; not holes, not 0.0.0.0),
// which addresses are everyone's (255.255.255.255, a subnet's last; none
// on a subnet of one or two addresses) or a group's (224.0.0.0 and
// above: no one host's), and the way a packet takes from
// a machine as it is, or what stands in it: no device, the link down, no
// address, no gateway; the machine itself is reached without any of
// them.
// Exits 13.
const std = @import("std")
const reach = @import("../projects/brix/kernel/net/reach.mlx")
const Way = reach.Way

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var failed = false

fn expect(condition: bool, what: []const u8) -> void {
    if condition { return }
    failed = true
    say("FAIL ")
    say(what)
    say("\n")
}

fn ip(a: u8, b: u8, c: u8, d: u8) -> [4]u8 { return [4]u8{ a, b, c, d } }

fn mask(a: u8, b: u8, c: u8, d: u8) -> bool {
    const bytes = ip(a, b, c, d)
    return reach.maskValid(&bytes)
}

fn masks() -> void {
    expect(mask(255, 255, 255, 0), "255.255.255.0 is a netmask")
    expect(mask(255, 0, 0, 0), "255.0.0.0 is a netmask")
    expect(mask(255, 255, 254, 0), "255.255.254.0 is a netmask")
    expect(mask(255, 255, 255, 192), "255.255.255.192 is a netmask")
    expect(mask(128, 0, 0, 0), "128.0.0.0 is a netmask")
    expect(mask(255, 255, 255, 252), "255.255.255.252 is a netmask")
    expect(mask(255, 255, 255, 255), "255.255.255.255 is a netmask (the machine alone)")
    expect(!mask(0, 0, 0, 0), "0.0.0.0 is no netmask")
    expect(!mask(255, 0, 255, 0), "255.0.255.0 has a hole")
    expect(!mask(255, 255, 255, 1), "255.255.255.1 has a hole")
    expect(!mask(0, 255, 255, 255), "0.255.255.255 begins with zeros")
    expect(!mask(255, 255, 0, 255), "255.255.0.255 has a hole")
    expect(!mask(254, 255, 0, 0), "254.255.0.0 has a hole")
    expect(!mask(255, 255, 255, 250), "255.255.255.250 has a hole")
    expect(!mask(0, 0, 0, 1), "0.0.0.1 is no netmask")
    // Every netmask there is, and nothing between them.
    var bits: usize = 1
    var good: usize = 0
    const one: usize = 1
    while bits <= 32 {
        // (`bits` ones, then zeros.)
        const value = 0xFFFFFFFF - ((one << @intCast(u6, 32 - bits)) - 1)
        if mask(@intCast(u8, value >> 24), @intCast(u8, (value >> 16) & 255), @intCast(u8, (value >> 8) & 255), @intCast(u8, value & 255)) { good += 1 }
        bits += 1
    }
    expect(good == 32, "each of the 32 netmasks is one")
    var last: usize = 0
    var taken: usize = 0
    while last < 256 {
        if mask(255, 255, 255, @intCast(u8, last)) { taken += 1 }
        last += 1
    }
    expect(taken == 9, "of 255.255.255.x, nine are netmasks")
}

fn everyone() -> void {
    const address = ip(10, 10, 36, 50)
    const wide = ip(255, 255, 255, 0)
    var to = ip(255, 255, 255, 255)
    expect(reach.all(&to), "255.255.255.255 is everyone")
    to = ip(10, 10, 36, 255)
    expect(!reach.all(&to) && reach.subnetAll(&address, &wide, &to), "10.10.36.255 is everyone on 10.10.36.0/24")
    to = ip(10, 10, 36, 254)
    expect(!reach.subnetAll(&address, &wide, &to), "10.10.36.254 is a host")
    to = ip(10, 10, 37, 255)
    expect(!reach.subnetAll(&address, &wide, &to), "10.10.37.255 is another subnet's")
    to = ip(10, 10, 36, 0)
    expect(!reach.subnetAll(&address, &wide, &to), "10.10.36.0 is not everyone")
    // A subnet that is not a whole byte: 10.0.2.77/23 ends at 10.0.3.255.
    const odd = ip(10, 0, 2, 77)
    const narrow = ip(255, 255, 254, 0)
    to = ip(10, 0, 3, 255)
    expect(reach.subnetAll(&odd, &narrow, &to), "10.0.3.255 is everyone on 10.0.2.0/23")
    to = ip(10, 0, 2, 255)
    expect(!reach.subnetAll(&odd, &narrow, &to), "10.0.2.255 is a host on 10.0.2.0/23")
    const quarter = ip(192, 168, 76, 15)
    const sixtyfour = ip(255, 255, 255, 192)
    to = ip(192, 168, 76, 63)
    expect(reach.subnetAll(&quarter, &sixtyfour, &to), "192.168.76.63 is everyone on 192.168.76.0/26")
    to = ip(192, 168, 76, 127)
    expect(!reach.subnetAll(&quarter, &sixtyfour, &to), "192.168.76.127 is the next subnet's")
    // One address, or two: nobody is everyone there.
    const alone = ip(255, 255, 255, 255)
    to = ip(10, 10, 36, 50)
    expect(!reach.subnetAll(&address, &alone, &to), "a subnet of one address has no address for everyone")
    const pair = ip(255, 255, 255, 254)
    to = ip(10, 10, 36, 51)
    expect(!reach.subnetAll(&address, &pair, &to), "a subnet of two addresses has no address for everyone")
    to = ip(10, 10, 36, 51)
    const four = ip(255, 255, 255, 252)
    expect(reach.subnetAll(&address, &four, &to), "10.10.36.51 is everyone on 10.10.36.48/30")
    to = ip(10, 10, 99, 1)
    const big = ip(255, 255, 0, 0)
    expect(reach.local(&address, &big, &to), "10.10.99.1 is on 10.10.0.0/16")
    expect(!reach.local(&address, &wide, &to), "10.10.99.1 is not on 10.10.36.0/24")
    // A group's address, and what lies beyond the groups, is no one
    // host's (a stream is not opened to one); a host's is not one.
    to = ip(224, 0, 0, 1)
    expect(reach.group(&to), "224.0.0.1 is a group's")
    to = ip(239, 255, 255, 250)
    expect(reach.group(&to), "239.255.255.250 is a group's")
    to = ip(255, 255, 255, 255)
    expect(reach.group(&to), "255.255.255.255 is no one host's")
    to = ip(223, 255, 255, 254)
    expect(!reach.group(&to), "223.255.255.254 is a host's")
    to = ip(10, 10, 36, 255)
    expect(!reach.group(&to), "10.10.36.255 is no group's (the subnet says whose it is)")
}

fn ways() -> void {
    const address = ip(10, 10, 36, 50)
    const mask24 = ip(255, 255, 255, 0)
    const gateway = ip(10, 10, 36, 1)
    const none = ip(0, 0, 0, 0)
    const neighbour = ip(10, 10, 36, 2)
    const far = ip(192, 0, 2, 10)
    const home = ip(127, 0, 0, 1)
    const alsoHome = ip(127, 9, 9, 9)
    const all = ip(255, 255, 255, 255)
    const subnetAll = ip(10, 10, 36, 255)
    // A machine with everything.
    expect(reach.way(true, true, true, &address, &mask24, &gateway, &neighbour) == Way.open, "a neighbour is reached")
    expect(reach.way(true, true, true, &address, &mask24, &gateway, &far) == Way.open, "a host beyond the gateway is reached")
    expect(reach.way(true, true, true, &address, &mask24, &gateway, &all) == Way.open, "everyone is reached")
    expect(reach.way(true, true, true, &address, &mask24, &none, &subnetAll) == Way.open, "the subnet's everyone is reached without a gateway")
    expect(reach.way(true, true, true, &address, &mask24, &none, &all) == Way.open, "everyone is reached without a gateway")
    // No gateway: the own subnet, nothing beyond it.
    expect(reach.way(true, true, true, &address, &mask24, &none, &neighbour) == Way.open, "a neighbour needs no gateway")
    expect(reach.way(true, true, true, &address, &mask24, &none, &far) == Way.no_gateway, "a host beyond the subnet needs a gateway")
    // No address.
    expect(reach.way(true, true, false, &none, &none, &none, &neighbour) == Way.no_address, "without an address no host is reached")
    expect(reach.way(true, true, false, &none, &none, &none, &all) == Way.no_address, "without an address not everyone either")
    // The link down: said before the missing address.
    expect(reach.way(true, false, true, &address, &mask24, &gateway, &neighbour) == Way.link_down, "with the link down no neighbour is reached")
    expect(reach.way(true, false, true, &address, &mask24, &gateway, &far) == Way.link_down, "with the link down no host beyond the gateway")
    expect(reach.way(true, false, false, &none, &none, &none, &far) == Way.link_down, "the link down is said before the missing address")
    expect(reach.way(true, false, true, &address, &mask24, &none, &far) == Way.link_down, "the link down is said before the missing gateway")
    // No device: said first.
    expect(reach.way(false, false, false, &none, &none, &none, &far) == Way.no_device, "without a device no host is reached")
    expect(reach.way(false, true, true, &address, &mask24, &gateway, &far) == Way.no_device, "no device is said first")
    // The machine itself, whatever it lacks.
    expect(reach.way(false, false, false, &none, &none, &none, &home) == Way.open, "127.0.0.1 without a device")
    expect(reach.way(true, false, false, &none, &none, &none, &alsoHome) == Way.open, "127.9.9.9 without a link or an address")
    expect(reach.way(true, false, true, &address, &mask24, &none, &address) == Way.open, "the own address with the link down")
    expect(reach.way(true, true, false, &none, &none, &none, &none) == Way.no_address, "0.0.0.0 is not the own address of a machine without one")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    masks()
    everyone()
    ways()
    if failed { return 1 }
    return 13
}
