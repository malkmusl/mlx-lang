// Returning through @move transfers cleanup from callee storage to caller storage.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn create(counter: *u8) -> OwnedCounter {
    const local = OwnedCounter.{ .counter = counter }
    return @move(local)
}

fn main() -> u8 {
    var drops: u8 = 0
    {
        const received = create(&drops)
    }
    return drops
}
