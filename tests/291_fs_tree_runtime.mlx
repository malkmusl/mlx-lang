// std.fs on folders: a folder with a file, a nested folder and a symbolic
// link is copied (copyTree: bytes, kinds and the link's target), moved
// (moveTree), given a free name (freeName: "tree 2", "notes 2.txt") and
// removed with everything in it (removeTree). Exits 13.
const std = @import("std")

fn writeFile(path: [*]const u8, text: []const u8) -> bool {
    const file = std.fs.open(path, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.isValid(file) { return false }
    const written = std.fs.writeAllBytes(file, @ptrCast([*]const u8, text), text.length)
    const closed = std.fs.close(file)
    return written
}

fn readsAs(path: [*]const u8, text: []const u8) -> bool {
    const file = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return false }
    var buffer: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    const got = std.fs.read(file, bytes, 64)
    const closed = std.fs.close(file)
    return got == @intCast(isize, text.length) && std.text.same(bytes[0..text.length], text)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    unsafe {
        const base = @ptrCast([*]const u8, "/tmp/mlx-fs-tree-test")
        const gone = std.fs.removeTree(base)
        if !std.fs.makeDir(base, 448) { return 1 }
        if !std.fs.makeDir(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree"), 493) { return 2 }
        if !std.fs.makeDir(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree/inner"), 493) { return 3 }
        if !writeFile(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree/notes.txt"), "hello") { return 4 }
        if !writeFile(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree/inner/deep.txt"), "deeper") { return 5 }
        if !std.fs.symbolicLink(@ptrCast([*]const u8, "notes.txt"), @ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree/link")) { return 6 }

        // Copied whole; not over what is there; not into itself.
        if !std.fs.copyTree(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree"), @ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/copy")) { return 7 }
        if !readsAs(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/copy/notes.txt"), "hello") { return 8 }
        if !readsAs(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/copy/inner/deep.txt"), "deeper") { return 9 }
        if !readsAs(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/copy/link"), "hello") { return 10 }
        if std.fs.copyTree(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree"), @ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/copy")) { return 11 }
        if std.fs.copyTree(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree"), @ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree/inner/again")) { return 12 }

        // Free names.
        var name: [256]u8 = undefined
        const bytes = @ptrCast([*]u8, &name)
        const folder = std.fs.freeName("/tmp/mlx-fs-tree-test", "tree", bytes, 256)
        if !std.text.same(bytes[0..folder], "/tmp/mlx-fs-tree-test/tree 2") { return 14 }
        const file = std.fs.freeName("/tmp/mlx-fs-tree-test/tree", "notes.txt", bytes, 256)
        if !std.text.same(bytes[0..file], "/tmp/mlx-fs-tree-test/tree/notes 2.txt") { return 15 }

        // Moved; not over what is there.
        if !std.fs.moveTree(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/copy"), @ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/moved")) { return 16 }
        if std.fs.exists(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/copy")) { return 17 }
        if !readsAs(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/moved/inner/deep.txt"), "deeper") { return 18 }
        if std.fs.moveTree(@ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/moved"), @ptrCast([*]const u8, "/tmp/mlx-fs-tree-test/tree")) { return 19 }

        // Removed with everything in it.
        if !std.fs.removeTree(base) { return 20 }
        if std.fs.exists(base) { return 21 }
    }
    return 13
}
