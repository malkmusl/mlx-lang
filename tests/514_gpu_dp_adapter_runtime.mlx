// The clock source switched after the clock's table, a passive adapter
// from DisplayPort to HDMI or DVI, the short pulse's bytes and a move from
// DisplayPort to DisplayPort (projects/brix/kernel/gpu_mode.mlx's
// Kind.source and `source`, gpu_adapter.mlx, gpu_dpwatch.mlx's `irqData`
// and `lookForAdapter`), built for the host, on the user's whole card as a
// table with a DisplayPort monitor behind an AUX channel
// (tests/support/dp_world.mlx):
// - a move from TMDS to DisplayPort and back whose clock table leaves the
//   controller's source as it was: read after the table and switched as
//   Linux's dce_crtc_switch_to_clk_src switches it, said; with a table that
//   switches it, nothing more written, said too;
// - a passive adapter to HDMI on a DisplayPort connector the firmware did
//   not start, at boot and while brixOS runs: found over the connector's
//   DDC line as Linux's drm_dp_dual_mode_detect finds it, its EDID read
//   there, the connector driven as TMDS through its DIG (the connector's
//   kind in the transmitter's blocks) within the adapter's clock; one to
//   DVI that has no registers (the EDID decides), and an active converter
//   (said, not driven);
// - the short pulse's bytes read as Linux reads them: the event status
//   indicators from 2002h for a monitor of DisplayPort 1.4, 200h below;
// - a move from DisplayPort to DisplayPort while brixOS runs: the
//   controller reset as dce110_reset_hw_ctx_wrap resets it, the early
//   blanking written after the training and before the stream;
// - an adapter whose first read is not acknowledged, read again as the
//   display core reads it; its HDMI ID without its end mark, a clock
//   register of FFh; the firmware's own picture through an adapter (asked
//   at boot, the monitor's own mode by HDMI within its clock); a mode
//   taken back on an adapter's output, the adapter pulled and put back
//   there; a DisplayPort monitor that does not answer at first (taken for
//   a DVI adapter only if an EDID answers); a 1.4 monitor's lanes 2 and 3
//   lost, and its channel silent at a short pulse; a move from
//   DisplayPort to a type 1 adapter (165 MHz, the 30 Hz timing).
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const dplink = @import("../projects/brix/kernel/gpu_link.mlx")
const rule = @import("../projects/brix/kernel/gpu_switch.mlx")
const plug = @import("../projects/brix/kernel/gpu_plug.mlx")
const ddc = @import("../projects/brix/kernel/gpu_ddc.mlx")
const adapter = @import("../projects/brix/kernel/gpu_adapter.mlx")
const dm = @import("../projects/brix/kernel/display_modes.mlx")
const display = @import("./support/tmds_card.mlx")
const lines = @import("./support/plug_card.mlx")
const sw = @import("./support/switch_card.mlx")
const sink = @import("./support/dp_monitor.mlx")
const card = @import("./support/dpswitch_card.mlx")
const w = @import("./support/dp_world.mlx")

const MS = w.MS
const NEVER = w.NEVER
const HIGH = dplink.LINK_RATE_HIGH
// The DisplayPort connector the adapters are put into (DIG 3, hot plug
// line 5, DDC entry 3), the connector's kind in the ROM (13h).
const ADAPTER_CONNECTOR: usize = 1
const DISPLAYPORT_KIND: usize = 0x13
// The pixel clock's table told the PLL of DIG 4 (its fifth byte: ATOM_
// COMBOPHY_PLL0 + 4, as gpu_blocks.mlx puts it).
const PLL4: usize = 0x18

// The word the card's mailbox held at `slot` when the transmitter's table
// last ran for back end `phy` with action `action` (NEVER: never).
fn lastPhyWord(phy: usize, action: usize, slot: usize) -> usize {
    var found = NEVER
    var words: [4]usize = [_]usize{ 0, 0, 0, 0 }
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        if display.writtenByTable[k] && display.writtenTo[k] >= display.MAIL && display.writtenTo[k] < display.MAIL + 4 { words[display.writtenTo[k] - display.MAIL] = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.GO && display.writtenWith[k] == w.TRANSMITTER && words[0] & 0xFFFF == phy | (action << 8) { found = words[slot] }
        k += 1
    }
    return found
}

// The index of the card's list of writes at which table `table` ran for
// the first time from write `from` on with word 0 `value` in its bits
// `mask` and word 1 `value1` in its bits `mask1` (NEVER: none).
fn goAt(from: usize, table: usize, mask: usize, value: usize, mask1: usize, value1: usize) -> usize {
    var w0: usize = 0
    var w1: usize = 0
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL { w0 = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL + 1 { w1 = display.writtenWith[k] }
        if k >= from && display.writtenByTable[k] && display.writtenTo[k] == display.GO && display.writtenWith[k] == table && w0 & mask == value && w1 & mask1 == value1 { return k }
        k += 1
    }
    return NEVER
}

// How many of the driver's own writes went to `register` from `from` on.
fn writesTo(from: usize, register: usize) -> usize {
    var n: usize = 0
    var k = from
    while k < display.written && k < display.WRITES {
        if !display.writtenByTable[k] && display.writtenTo[k] == register { n += 1 }
        k += 1
    }
    return n
}

// ---- THE CLOCK SOURCE AFTER THE CLOCK'S TABLE.

// The firmware's picture on HDMI 2, the monitor on DisplayPort 0: the DTO's
// table switches the controller to the DTO itself (as the user's ROM
// does): read after it, said, nothing more written. Then a table that
// leaves the controller on the PLL: switched to the DTO
// (dce_crtc_switch_to_clk_src: DP_DTO0_ENABLE 1), said, between the
// table and the timing's.
fn toTheDto() -> void {
    w.usersWith("at boot: TMDS to DisplayPort, the DTO's table switches the clock", 0, false, 0x12, 0x14, 4, w.users[0..])
    w.boot()
    w.expect(w.bootPlan.move.toDp && w.bootResult.outcome == set.Outcome.done && w.onDto(), "moved to DisplayPort 0, on the DTO")
    w.line("gpu: after its table the controller's clock is the DTO's (0140 reads ")
    w.line("): the ROM switched it, nothing more is written\n")
    w.expect(writesTo(0, scanout.CRTC0_PIXEL_RATE_CNTL) == 0, "the driver did not write the controller's clock source")

    w.usersWith("at boot: TMDS to DisplayPort, the DTO's table leaves the PLL", 0, false, 0x12, 0x14, 4, w.users[0..])
    display.dtoLeavesSource = true
    w.boot()
    w.once("gpu: after its table the controller's clock is not the DTO's (0140 reads ")
    w.line("): switched to the DTO as dce_crtc_switch_to_clk_src does (DP_DTO0_ENABLE 1)\n")
    w.expect(w.bootResult.outcome == set.Outcome.done && w.onDto() && display.raw(0x141) == 270270000, "done, the DTO the clock at 270270000 Hz")
    w.expect(sink.txOn && w.locked(4) && w.streamOn(2), "the link trained, the stream on")
    const dto = goAt(0, w.SET_PIXEL_CLOCK, 0xFFFFFFFF, 2702700, 0xFFFF, 0x200B)
    const switched = w.firstWrite(0, scanout.CRTC0_PIXEL_RATE_CNTL)
    const timed = goAt(0, w.SET_CRTC_TIMING, 0, 0, 0, 0)
    w.expect(dto != NEVER && switched != NEVER && timed != NEVER && dto < switched && switched < timed, "the DTO's table, the switch, the timing's table: in that order")
    w.expect(writesTo(0, scanout.CRTC0_PIXEL_RATE_CNTL) == 1, "one write of the controller's clock source")
}

// The firmware's picture on DisplayPort 0, the monitor on HDMI 2: the PLL's
// table switches the controller off the DTO (as the user's ROM does), or
// it leaves it on the DTO: switched to back end 4's PLL (its source in
// CRTC0_PHYPLL_PIXEL_RATE_CNTL, the PLL source 0, DP_DTO0_ENABLE 0).
fn toThePll() -> void {
    w.named("at boot: DisplayPort to HDMI, the PLL's table switches the clock")
    card.usersOnDp(0, 0x06, 2, 0, 0x12, 0x14, w.users[0..])
    w.asTheUsers()
    card.pull()
    sw.monitor(2, w.users[0..])
    sw.line(2, true, sw.NEVER)
    w.boot()
    w.expect(w.bootPlan.move.fromDp && w.bootResult.outcome == set.Outcome.done && !w.onDto() && w.backOn(4), "moved to HDMI 2, off the DTO")
    w.line("gpu: after its table the controller's clock is back end 4's PLL's (0140 reads ")
    w.expect(writesTo(0, scanout.CRTC0_PIXEL_RATE_CNTL) == 0 && writesTo(0, scanout.CRTC0_PHYPLL_PIXEL_RATE_CNTL) == 0, "the driver did not write the clock source")

    w.named("at boot: DisplayPort to HDMI, the PLL's table leaves the DTO")
    card.usersOnDp(0, 0x06, 2, 0, 0x12, 0x14, w.users[0..])
    w.asTheUsers()
    card.pull()
    sw.monitor(2, w.users[0..])
    sw.line(2, true, sw.NEVER)
    display.pllLeavesDto = true
    // (The controller's PHY PLL word with PIXEL_RATE_PLL_SOURCE set: the
    // switch clears it, as dce_crtc_switch_to_clk_src does.)
    display.store(0x143, display.raw(0x143) | 0x10)
    w.boot()
    w.once("gpu: after its table the controller's clock is still the DTO's (0140 reads ")
    w.line("): switched to back end 4's PLL as dce_crtc_switch_to_clk_src does (its source in 0143, the PLL source 0; DP_DTO0_ENABLE 0)\n")
    w.expect(w.bootResult.outcome == set.Outcome.done && !w.onDto() && display.raw(0x143) & 0x17 == 4 && w.backOn(4), "done, the controller on PLL 4")
    const pll = goAt(0, w.SET_PIXEL_CLOCK, 0xFFFFFFFF, 2702700, 0xFF, PLL4)
    const source = w.firstWrite(0, scanout.CRTC0_PHYPLL_PIXEL_RATE_CNTL)
    const rate = w.firstWrite(0, scanout.CRTC0_PIXEL_RATE_CNTL)
    const timed = goAt(0, w.SET_CRTC_TIMING, 0, 0, 0, 0)
    w.expect(pll != NEVER && source != NEVER && rate != NEVER && timed != NEVER && pll < source && source < rate && rate < timed, "the PLL's table, its source, DP_DTO0_ENABLE 0, the timing's table: in that order")
}

// The way back of a move to DisplayPort whose training fails at every
// step (the monitor recovers no clock): the PLL's table leaves the
// controller on the DTO there too, and it is switched back to the PLL as
// on the way there.
fn theWayBack() -> void {
    w.usersWith("at boot: TMDS to DisplayPort not trained, the way back switches the clock", 0, false, 0x12, 0x14, 4, w.users[0..])
    display.dtoLeavesSource = true
    display.pllLeavesDto = true
    sink.stubborn = true
    w.boot()
    sink.stubborn = false
    w.line("switched to the DTO as dce_crtc_switch_to_clk_src does (DP_DTO0_ENABLE 1)\n")
    w.line("switched to back end 4's PLL as dce_crtc_switch_to_clk_src does")
    w.expect(w.bootResult.outcome != set.Outcome.done && !w.onDto() && display.raw(0x143) & 0x17 == 4 && w.backOn(4), "the way back: the controller on PLL 4 again, DIG 4 on")
}

// ---- A PASSIVE ADAPTER ON A DISPLAYPORT CONNECTOR.

// A type 2 adapter to HDMI's registers (drm_dp_dual_mode_helper.h): its
// HDMI ID, its ID 0xA0 at 10h, its highest clock at 1Dh in 2.5 MHz.
var adapterBytes: [32]u8 = undefined

fn makeAdapter(id: usize, clock: usize, hdmi: bool) -> void {
    var k: usize = 0
    while k < 32 {
        adapterBytes[k] = 0
        k += 1
    }
    k = 0
    while k < 16 {
        adapterBytes[k] = if hdmi { adapter.HDMI_ID[k] } else { 0 }
        k += 1
    }
    adapterBytes[0x10] = @intCast(u8, id)
    adapterBytes[0x1D] = @intCast(u8, clock)
}

// An adapter (its registers `bytes`, none: without) with the monitor of
// EDID `edid` behind it put into DisplayPort connector 1; its line high.
fn plugAdapter(bytes: []const u8, edid: []const u8) -> void {
    card.adapterOn = ADAPTER_CONNECTOR
    lines.adapterAt(sw.ENTRIES[ADAPTER_CONNECTOR], bytes)
    sw.monitor(ADAPTER_CONNECTOR, edid)
    sw.line(ADAPTER_CONNECTOR, true, sw.NEVER)
}

// The firmware's picture on HDMI 2 by DVI (nothing there), a type 2
// adapter to HDMI of 300 MHz on DisplayPort connector 1, which the
// firmware did not start, the user's monitor behind it: found, its EDID
// read over the DDC line, the picture brought there as HDMI through DIG 3
// at the monitor's own 270270 kHz.
fn adapterAtBoot() -> void {
    w.usersWith("at boot: a passive adapter to HDMI on a DisplayPort connector", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0xA0, 120, true)
    plugAdapter(adapterBytes[0..], w.users[0..])
    w.boot()
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel; on its DDC line a passive adapter to HDMI (DP dual mode, type 2) (its ID 0xa0, 300000 kHz at most): the connector is taken for one that sends TMDS (HDMI or DVI, by what the monitor's EDID says) through its DIG\n")
    w.expect(w.watch.ports.ports[1].rom.adapterClock == 300000 && w.watch.ports.ports[1].rom.adapterHdmi && w.watch.ports.ports[1].heard.outcome == ddc.Outcome.read, "the record: 300000 kHz, HDMI, the EDID read")
    w.expect(w.decided.act == rule.Act.move && w.decided.to == 1 && w.decided.from == 2, "the rule brings the picture to connector 1")
    w.expect(w.bootPlan.complete && !w.bootPlan.move.toDp && !w.bootPlan.move.fromDp && w.bootPlan.situation != mode.Situation.displayport, "a move from TMDS to TMDS")
    w.expect(w.bootResult.outcome == set.Outcome.done && w.backOn(3) && w.backMode(3) == scanout.MODE_HDMI && !w.backOn(4) && !w.onDto(), "DIG 3 on as HDMI, DIG 4 off, no DTO")
    w.expect(w.bootPlan.timing.clock == 270270, "the monitor's own timing, 270270 kHz")
    w.expect((lastPhyWord(3, w.ON, 2) >> 16) & 0xFF == DISPLAYPORT_KIND && (lastPhyWord(3, w.ON, 0) >> 16) & 0xFF == 3, "the transmitter on for DIG 3: the connector's kind 13h, HDMI")
    w.expect(w.follow.showing == 1 && w.follow.width == 3840, "the record: connector 1 shows 3840x1080")
    w.expect(sink.turnedOn == 0, "no link trained")

    // A type 1 adapter to HDMI (ID 00h): 165000 kHz at most. The user's
    // monitor with its timing of 30 Hz (135140 kHz) behind it: that one,
    // by the firmware's own DVI signalling (a TMDS move keeps it for a
    // clock a DVI link carries, as for an HDMI connector).
    w.usersWith("at boot: a type 1 adapter to HDMI, 165 MHz", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0x00, 0, true)
    plugAdapter(adapterBytes[0..], w.twoRates[0..])
    w.boot()
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel; on its DDC line a passive adapter to HDMI (DP dual mode, type 1) (its ID 0x0, 165000 kHz at most): the connector is taken for one that sends TMDS (HDMI or DVI, by what the monitor's EDID says) through its DIG\n")
    w.line("this output carries 165000 kHz at most (TMDS through a DisplayPort connector's adapter): taken instead, of the same size, 3840x1080 at 30.00 Hz: pixel clock 135140 kHz")
    w.expect(w.bootResult.outcome == set.Outcome.done && w.bootPlan.timing.clock == 135140 && w.backOn(3) && w.backMode(3) == scanout.MODE_DVI, "done at 135140 kHz, by DVI")

    // A type 2 adapter to DVI (ID A0h, no HDMI ID) of 300 MHz with the
    // user's monitor: no HDMI through it (decide_signal_from_strap_and_
    // dongle_type), so a DVI link's 165000 kHz at most, and the monitor's
    // 270270 kHz does not fit: said, the firmware's picture stays.
    w.usersWith("at boot: a type 2 adapter to DVI, the monitor's timing beyond it", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0xA0, 120, false)
    plugAdapter(adapterBytes[0..], w.users[0..])
    w.boot()
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel; on its DDC line a passive adapter to DVI (DP dual mode, type 2) (its ID 0xa0, 300000 kHz at most): the connector is taken for one that sends TMDS (DVI) through its DIG\n")
    w.expect(w.watch.ports.ports[1].rom.adapterClock == 300000 && !w.watch.ports.ports[1].rom.adapterHdmi, "the record: 300000 kHz, DVI alone")
    w.expect(!w.bootPlan.complete && w.bootPlan.missing == mode.Missing.no_timing_fits && w.bootPlan.tmds.limit == 165000, "no timing of the monitor's fits 165000 kHz")
    w.expect(w.bootResult.outcome != set.Outcome.done && w.backOn(4) && !w.backOn(3), "the firmware's picture stays")

    // A type 1 adapter to DVI without registers: nothing at 40h, its EDID
    // answers: DVI (no HDMI signalling through it, whatever the EDID says),
    // 165000 kHz at most.
    w.usersWith("at boot: a type 1 adapter to DVI without registers", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    plugAdapter(adapterBytes[0..0], w.twoRates[0..])
    w.boot()
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel, nothing at an adapter's address on its DDC line, and an EDID answers there: a passive adapter to DVI (DP dual mode, type 1) (165000 kHz at most): the connector is taken for one that sends TMDS (DVI) through its DIG\n")
    w.expect(w.bootResult.outcome == set.Outcome.done && w.bootPlan.timing.clock == 135140 && w.backOn(3) && w.backMode(3) == scanout.MODE_DVI, "done at 135140 kHz, as DVI")
    w.expect((lastPhyWord(3, w.ON, 0) >> 16) & 0xFF == 2, "the transmitter on as DVI")

    // An active converter (LSPCON): said, not driven; the firmware's
    // picture stays.
    w.usersWith("at boot: an active converter", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0xA8, 0, true)
    plugAdapter(adapterBytes[0..], w.users[0..])
    w.boot()
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel; on its DDC line an active converter (LSPCON): it is not driven (no path of this driver's leads through one)\n")
    w.expect(w.watch.ports.ports[1].rom.adapterClock == 0 && w.decided.act != rule.Act.move && !w.backOn(3) && w.backOn(4), "not driven, the firmware's picture stays")

    // Nothing behind the connector that answers (a line high, nothing on
    // the AUX channel, at 40h or at A0h).
    w.usersWith("at boot: a DisplayPort connector with nothing that answers", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    card.adapterOn = ADAPTER_CONNECTOR
    sw.line(ADAPTER_CONNECTOR, true, sw.NEVER)
    w.boot()
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel, nothing at an adapter's address on its DDC line, and no EDID there: no monitor that can be asked (one that is off, or none)\n")
    w.expect(w.decided.act != rule.Act.move && w.backOn(4), "nothing moved")
}

// Booted on HDMI 2 with the monitor there; its cable then moved into a
// type 2 adapter to HDMI on DisplayPort connector 1: the adapter found at
// the next tick, the EDID read by the plug item, the picture moved there
// as HDMI through DIG 3.
fn adapterWhileRunning() -> void {
    w.usersWith("while running: HDMI to a passive adapter on DisplayPort 1", NEVER, true, 0x12, 0x14, 4, w.users[0..])
    w.boot()
    w.expect(w.bootResult.outcome == set.Outcome.done && w.follow.showing == 2, "at boot on HDMI 2")
    w.made = 0
    display.logged = 0
    const t0 = display.clock
    sw.unplug(2)
    sw.line(2, false, sw.NEVER)
    w.ticks(t0 + 300 * MS)
    makeAdapter(0xA0, 120, true)
    plugAdapter(adapterBytes[0..], w.users[0..])
    w.ticks(t0 + 4000 * MS)
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel; on its DDC line a passive adapter to HDMI (DP dual mode, type 2) (its ID 0xa0, 300000 kHz at most): the connector is taken for one that sends TMDS (HDMI or DVI, by what the monitor's EDID says) through its DIG\n")
    w.expect(w.made == 1 && w.follow.showing == 1 && w.backOn(3) && w.backMode(3) == scanout.MODE_HDMI && !w.backOn(4) && !w.onDto(), "moved to connector 1 as HDMI through DIG 3")
    w.expect((lastPhyWord(3, w.ON, 2) >> 16) & 0xFF == DISPLAYPORT_KIND, "the transmitter's blocks name the DisplayPort connector")

    // Its cable back on HDMI 2, the adapter pulled: back there.
    w.named("while running: from the adapter back to HDMI 2")
    display.logged = 0
    const t1 = display.clock
    sw.unplug(ADAPTER_CONNECTOR)
    lines.adapterAt(sw.ENTRIES[ADAPTER_CONNECTOR], adapterBytes[0..0])
    sw.line(ADAPTER_CONNECTOR, false, sw.NEVER)
    w.ticks(t1 + 300 * MS)
    sw.monitor(2, w.users[0..])
    sw.line(2, true, sw.NEVER)
    w.ticks(t1 + 4000 * MS)
    w.expect(w.made == 2 && w.follow.showing == 2 && w.backOn(4) && !w.backOn(3), "moved back to HDMI 2")
    w.expect(w.watch.ports.ports[1].rom.adapterClock == 0, "the adapter forgotten")
}

// ---- THE SHORT PULSE'S BYTES.

fn latch(k: usize) -> void {
    const at = plug.DC_HPD_INT_STATUS + (card.DP_LINES[k] - 1) * plug.HPD_STEP
    lines.registers[at] = lines.registers[at] | 0x100
}

fn loseLock() -> void {
    var k: usize = 0
    while k < 4 {
        sink.clockOf[k] = false
        sink.lockOf[k] = false
        k += 1
    }
}

// A monitor of DisplayPort 1.4 (its registers' revision 14h): a short
// pulse read at the event status indicators (2002h, 14 bytes), not at
// 200h; the link holding, then lost and trained again. One of 1.2: at
// 200h.
fn shortPulses() -> void {
    w.usersWith("hot plug: a short pulse of a DisplayPort 1.4 monitor", 0, false, 0x14, 0x14, 4, w.users[0..])
    w.boot()
    w.expect(w.bootResult.outcome == set.Outcome.done && w.follow.showing == 0 && w.locked(4), "at boot on connector 0")
    w.ticks(display.clock + 100 * MS)
    display.logged = 0
    var esi = sink.esiReads
    var status = sink.statusReads
    latch(0)
    w.ticks(display.clock + 100 * MS)
    w.once("gpu: connector 0 (DisplayPort): a short pulse of its hot plug line (the monitor asks to be looked at): sink count 1, lanes 7 7 7 7, aligned: the link holds\n")
    w.expect(sink.esiReads == esi + 1 && sink.statusReads == status, "read at 2002h once, not at 200h")
    loseLock()
    esi = sink.esiReads
    latch(0)
    w.ticks(display.clock + 1000 * MS)
    w.once("gpu: connector 0 (DisplayPort): a short pulse of its hot plug line (the monitor asks to be looked at): sink count 1, lanes 0 0 0 0, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes it ran\n")
    w.expect(sink.esiReads >= esi + 1 && w.locked(4) && w.sinks.trained == 1, "read at 2002h, trained again")

    w.usersWith("hot plug: a short pulse of a DisplayPort 1.2 monitor", 0, false, 0x12, 0x14, 4, w.users[0..])
    w.boot()
    w.ticks(display.clock + 100 * MS)
    display.logged = 0
    esi = sink.esiReads
    status = sink.statusReads
    latch(0)
    w.ticks(display.clock + 100 * MS)
    w.once("gpu: connector 0 (DisplayPort): a short pulse of its hot plug line (the monitor asks to be looked at): sink count 1, lanes 7 7 7 7, aligned: the link holds\n")
    w.expect(sink.esiReads == esi && sink.statusReads == status + 1, "read at 200h once, not at 2002h")
}

// ---- FROM DISPLAYPORT TO DISPLAYPORT WHILE BRIXOS RUNS.

// Booted on DisplayPort 0 with the monitor's own mode; its cable moved to
// DisplayPort 1: the controller stopped, the DTO's table, the timing's,
// the controller started (dce110_reset_hw_ctx_wrap), the clock source read
// after the DTO's table; the new link trained, then the early blanking,
// then the stream (dce110_enable_stream before dce110_unblank_stream).
fn dpToDpWhileRunning() -> void {
    w.usersWith("while running: DisplayPort to DisplayPort", 0, false, 0x12, 0x14, 4, w.users[0..])
    w.boot()
    w.expect(w.bootResult.outcome == set.Outcome.done && w.follow.showing == 0, "at boot on connector 0")
    w.made = 0
    display.logged = 0
    const first = display.written
    const t0 = display.clock
    card.pull()
    w.ticks(t0 + 300 * MS)
    card.dpMonitor(1, 0x12, 0x14, 4, w.users[0..], true)
    w.ticks(t0 + 3000 * MS)
    w.expect(w.made == 1 && w.follow.showing == 1 && w.backOn(3) && !w.backOn(2) && w.streamOn(3) && !w.streamOn(2) && w.locked(4) && w.onDto(), "moved to connector 1, its link trained, the DTO the clock")
    const stopped = goAt(first, w.ENABLE_CRTC, 0xFFFF, 0x0000, 0, 0)
    const dto = goAt(first, w.SET_PIXEL_CLOCK, 0xFFFFFFFF, 2702700, 0xFF, 0x0B)
    const timed = goAt(first, w.SET_CRTC_TIMING, 0, 0, 0, 0)
    const started = goAt(first, w.ENABLE_CRTC, 0xFFFF, 0x0100, 0, 0)
    w.expect(stopped != NEVER && dto != NEVER && timed != NEVER && started != NEVER && stopped < dto && dto < timed && timed < started, "the controller stopped, the DTO's table, the timing's, the controller started")
    w.line("gpu: after its table the controller's clock is the DTO's (0140 reads ")
    const on = w.lastOnWrite(3, HIGH, 4)
    const blanking = w.lastWrite(scanout.CRTC_CONTROL)
    const m = w.lastWrite(scanout.DIG[3] + scanout.DP_VID_M)
    const stream = w.lastWrite(scanout.DIG[3] + scanout.DP_VID_STREAM_CNTL)
    w.expect(on != NEVER && blanking != NEVER && m != NEVER && stream != NEVER && on < blanking && blanking < m && m < stream, "the training, the early blanking, M, the stream: in Linux's order")
    w.expect(w.early() == 4, "the early blanking for 4 lanes")
}

// ---- THE REVIEW'S CASES.

// A type 2 adapter to HDMI whose first read of its HDMI ID is not
// acknowledged: read again, as Linux's display core reads it
// (query_dp_dual_mode_adaptor), and found for what it is; the user's
// monitor at its own 270270 kHz, not a DVI adapter of 165 MHz that no
// timing of the monitor's fits.
fn adapterAnswersLate() -> void {
    w.usersWith("at boot: an adapter whose first read is not acknowledged", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0xA0, 120, true)
    plugAdapter(adapterBytes[0..], w.users[0..])
    lines.nackFrom = lines.runs
    lines.nackRuns = 1
    lines.nackMessage = 0
    w.boot()
    w.once("gpu: connector 1 (DisplayPort): nothing answers on its AUX channel; on its DDC line a passive adapter to HDMI (DP dual mode, type 2) (its ID 0xa0, 300000 kHz at most): the connector is taken for one that sends TMDS (HDMI or DVI, by what the monitor's EDID says) through its DIG\n")
    w.expect(w.watch.ports.ports[1].rom.adapterClock == 300000 && w.watch.ports.ports[1].rom.adapterHdmi, "the record: 300000 kHz, HDMI")
    w.expect(w.bootResult.outcome == set.Outcome.done && w.bootPlan.timing.clock == 270270 && w.backMode(3) == scanout.MODE_HDMI, "done at 270270 kHz by HDMI through DIG 3")

    // One with no registers at all is asked three times, then taken by
    // its EDID for a DVI adapter.
    w.usersWith("at boot: an adapter without registers asked three times", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    plugAdapter(adapterBytes[0..0], w.twoRates[0..])
    const before = lines.runs
    w.boot()
    w.line("nothing at an adapter's address on its DDC line, and an EDID answers there: a passive adapter to DVI (DP dual mode, type 1) (165000 kHz at most)")
    w.expect(lines.runs >= before + adapter.ID_READS, "the HDMI ID asked three times")
}

// The adapter's registers read as drm_dp_dual_mode_detect and _max_tmds_
// clock read them: an HDMI ID without its end mark (04h) is no adapter to
// HDMI; a type 2 adapter's clock register of FFh gives 165 MHz.
fn adapterRegisters() -> void {
    w.usersWith("at boot: an adapter's HDMI ID without its end mark", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0xA0, 120, true)
    adapterBytes[15] = 0
    plugAdapter(adapterBytes[0..], w.users[0..])
    w.boot()
    w.line("on its DDC line a passive adapter to DVI (DP dual mode, type 2) (its ID 0xa0, 300000 kHz at most)")

    w.usersWith("at boot: a type 2 adapter whose clock register reads FFh", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0xA0, 0xFF, true)
    plugAdapter(adapterBytes[0..], w.users[0..])
    w.boot()
    w.line("on its DDC line a passive adapter to HDMI (DP dual mode, type 2) (its ID 0xa0, 165000 kHz at most)")
}

// The firmware's picture out of DisplayPort connector 0 (DIG 2) by DVI
// through a type 2 adapter to HDMI of 300 MHz, the user's monitor behind
// it: the adapter asked over the DDC line at boot (the output's monitor is
// the plug item's), and the monitor's own mode set there by HDMI at
// 270270 kHz, within the adapter's clock (not a DVI link's 165000 kHz).
fn firmwareThroughAdapter() -> void {
    w.usersWith("at boot: the firmware's picture through an adapter on DisplayPort 0", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    display.store(scanout.DIG[4] + scanout.DIG_BE_EN_CNTL, 0x100)
    display.firmware(0, 2, 2, false, 1, 107962)
    card.adapterOn = 0
    makeAdapter(0xA0, 120, true)
    lines.adapterAt(sw.ENTRIES[0], adapterBytes[0..])
    sw.monitor(0, w.users[0..])
    sw.line(0, true, sw.NEVER)
    w.boot()
    w.once("gpu: connector 0 (DisplayPort): the output sends TMDS; on its DDC line a passive adapter to HDMI (DP dual mode, type 2) (its ID 0xa0, 300000 kHz at most): the connector is taken for one that sends TMDS (HDMI or DVI, by what the monitor's EDID says) through its DIG\n")
    w.expect(w.board.connectors[0].adapterClock == 300000 && w.board.connectors[0].adapterHdmi, "the ROM's record the plans read: 300000 kHz, HDMI")
    w.expect(w.bootPlan.situation == mode.Situation.tmds && w.bootResult.outcome == set.Outcome.done && w.bootPlan.timing.clock == 270270 && w.backMode(2) == scanout.MODE_HDMI, "the monitor's own mode by HDMI through DIG 2")
}

// A mode changed on the adapter's output while brixOS runs and taken
// back: the mode before (the monitor's own, 270270 kHz) is planned within
// the adapter's clock again, as the move to it was.
fn modeThroughAdapter() -> void {
    w.usersWith("while running: a mode taken back through an adapter", NEVER, false, 0x12, 0x14, 4, w.users[0..])
    makeAdapter(0xA0, 120, true)
    plugAdapter(adapterBytes[0..], w.users[0..])
    w.boot()
    w.expect(w.bootResult.outcome == set.Outcome.done && w.follow.showing == 1 && w.follow.clock == 270270, "at boot on connector 1 at 270270 kHz")
    display.logged = 0
    w.expect(w.state.ask(1920, 1080, 0, display.clock) == dm.Answer.changed && w.follow.clock == 148500, "1920x1080 set")
    w.expect(w.state.takeBack() == dm.Answer.taken_back && w.follow.clock == 270270 && w.backMode(3) == scanout.MODE_HDMI, "taken back: 270270 kHz by HDMI")
    w.noLine("this output carries 165000 kHz at most")
    w.expect(w.state.ask(1920, 1080, 0, display.clock) == dm.Answer.changed && w.state.confirm() == dm.Answer.confirmed, "1920x1080 again, confirmed")
    w.expect(w.state.ask(3840, 1080, 0, display.clock) == dm.Answer.changed && w.follow.clock == 270270, "the monitor's own mode asked for again: set")

    // The adapter pulled and put back while it shows the picture: asked
    // again when its line comes back, the record its own again.
    w.named("while running: the adapter on the output that shows the picture pulled and put back")
    display.logged = 0
    const t0 = display.clock
    sw.line(ADAPTER_CONNECTOR, false, sw.NEVER)
    w.ticks(t0 + 300 * MS)
    w.expect(w.board.connectors[ADAPTER_CONNECTOR].adapterClock == 0, "forgotten while its line is low")
    sw.line(ADAPTER_CONNECTOR, true, sw.NEVER)
    w.ticks(t0 + 4000 * MS)
    w.once("gpu: connector 1 (DisplayPort): the output sends TMDS; on its DDC line a passive adapter to HDMI (DP dual mode, type 2) (its ID 0xa0, 300000 kHz at most): the connector is taken for one that sends TMDS (HDMI or DVI, by what the monitor's EDID says) through its DIG\n")
    w.expect(w.board.connectors[ADAPTER_CONNECTOR].adapterClock == 300000 && w.watch.ports.ports[ADAPTER_CONNECTOR].rom.adapterClock == 300000, "known again")
}

// A DisplayPort monitor whose AUX channel does not answer the first time
// it is asked while brixOS runs (one that wakes slowly): nothing at an
// adapter's address either, and no EDID over DDC. The line says what a
// DVI adapter would be taken for only if an EDID answers, and nothing is
// driven.
fn slowMonitor() -> void {
    w.usersWith("while running: a DisplayPort monitor that does not answer at first", NEVER, true, 0x12, 0x14, 4, w.users[0..])
    w.boot()
    w.made = 0
    display.logged = 0
    const t0 = display.clock
    sw.unplug(2)
    sw.line(2, false, sw.NEVER)
    w.ticks(t0 + 300 * MS)
    card.dpMonitor(0, 0x12, 0x14, 4, w.users[0..], true)
    sink.silentFrom = sink.transactions
    sink.silentUntil = sink.transactions + 400
    w.ticks(t0 + 6000 * MS)
    w.once("gpu: connector 0 (DisplayPort): nothing answers on its AUX channel, nothing at an adapter's address on its DDC line (a type 1 adapter to DVI need not answer there): if an EDID answers there, a passive adapter to DVI (DP dual mode, type 1) (165000 kHz at most): the connector is taken for one that sends TMDS (DVI) through its DIG\n")
    w.line("gpu: connector 0 (DisplayPort): something is plugged in and gives no EDID that holds: it is not driven\n")
    w.expect(w.made == 0, "nothing driven")
}

// A short pulse of a DisplayPort 1.4 monitor whose lanes 2 and 3 lost
// their clock: the event status indicators' lane bytes and their
// alignment byte read for what they stand for (200Ch to 200Eh), the link
// trained again; one whose channel does not answer then: said at 2002h.
fn shortPulseFourteen() -> void {
    w.usersWith("hot plug: a DisplayPort 1.4 monitor loses lanes 2 and 3", 0, false, 0x14, 0x14, 4, w.users[0..])
    w.boot()
    w.ticks(display.clock + 100 * MS)
    display.logged = 0
    sink.clockOf[2] = false
    sink.lockOf[2] = false
    sink.clockOf[3] = false
    sink.lockOf[3] = false
    latch(0)
    w.ticks(display.clock + 1000 * MS)
    w.once("gpu: connector 0 (DisplayPort): a short pulse of its hot plug line (the monitor asks to be looked at): sink count 1, lanes 7 7 0 0, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes it ran\n")
    w.expect(w.locked(4) && w.sinks.trained == 1, "trained again")

    w.named("hot plug: a DisplayPort 1.4 monitor that does not answer at its short pulse")
    display.logged = 0
    sink.deadFrom = sink.transactions
    sink.deadUntil = NEVER
    latch(0)
    w.ticks(display.clock + 1000 * MS)
    w.line("its monitor does not answer at 2002h: the link is not judged\n")
    sink.deadFrom = NEVER
}

// A move from DisplayPort 0 to a type 1 adapter to HDMI (165 MHz) on
// DisplayPort 1 while brixOS runs: the adapter's clock the limit of the
// move's TMDS end, the monitor's 30 Hz timing of its size.
fn dpToAdapter() -> void {
    w.usersWith("while running: DisplayPort 0 to a type 1 adapter on DisplayPort 1", 0, false, 0x12, 0x14, 4, w.twoRates[0..])
    w.boot()
    w.expect(w.bootResult.outcome == set.Outcome.done && w.follow.showing == 0, "at boot on connector 0")
    w.made = 0
    display.logged = 0
    const t0 = display.clock
    card.pull()
    w.ticks(t0 + 300 * MS)
    makeAdapter(0x00, 0, true)
    plugAdapter(adapterBytes[0..], w.twoRates[0..])
    w.ticks(t0 + 6000 * MS)
    w.line("this output carries 165000 kHz at most (TMDS through a DisplayPort connector's adapter)")
    w.expect(w.made == 1 && w.follow.showing == 1 && w.follow.clock == 135140 && w.backOn(3) && !w.onDto(), "moved to connector 1 at 135140 kHz, off the DTO")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    w.begin(arguments)
    toTheDto()
    toThePll()
    theWayBack()
    adapterAtBoot()
    adapterWhileRunning()
    shortPulses()
    dpToDpWhileRunning()
    adapterAnswersLate()
    adapterRegisters()
    firmwareThroughAdapter()
    modeThroughAdapter()
    slowMonitor()
    shortPulseFourteen()
    dpToAdapter()
    return if w.failed == 0 { 13 } else { w.failed }
}
