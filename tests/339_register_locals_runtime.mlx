// Locals kept in callee-saved registers (ir/registers.mlx) keep their
// values through calls, recursion that uses the same registers for its own
// locals, loops nested in loops, and a function whose locals are more than
// the registers; a local whose address is taken stays in the frame. Exits
// 13.
fn spin(depth: usize) -> usize {
    if depth == 0 { return 1 }
    var a: usize = depth
    var b: usize = 0
    var c: usize = 1
    while b < depth {
        c = c +% spin(depth - 1)
        b += 1
    }
    return a +% c
}

fn addTo(place: *usize, amount: usize) -> void { place.* = place.* + amount }

fn many() -> usize {
    var one: usize = 1
    var two: usize = 2
    var three: usize = 3
    var four: usize = 4
    var five: usize = 5
    var pass: usize = 0
    while pass < 10 {
        one += 1
        two += one
        three += two
        four += three
        five += four
        pass += 1
    }
    return one + two + three + four + five
}

pub fn main() -> u8 {
    var total: usize = 0
    var outer: usize = 0
    while outer < 50 {
        var inner: usize = 0
        while inner < 40 {
            total = total +% (outer * inner)
            inner += 1
        }
        outer += 1
    }
    if total != 955500 { return 1 }
    var kept: usize = 7
    addTo(&kept, 5)
    if kept != 12 { return 2 }
    if spin(4) != 129 { return 3 }
    if many() != 4822 { return 4 }
    return 13
}
