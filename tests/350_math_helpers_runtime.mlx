// std.math's helpers: min, max, clamp and absolute on doubles, minOf,
// maxOf, clampOf and absoluteOf on the integer types named, the square
// root that is 0 from 0 down (NaN stays NaN), and smoothstep's ends,
// middle and symmetry. Exits 13 when every check holds, else the number
// of the first check that failed.
const math = @import("std.math")

pub fn main() -> u8 {
    var x: f64 = 0.25
    if math.min(x, 0.5) != 0.25 || math.min(0.5, x) != 0.25 { return 1 }
    if math.max(x, -1.0) != 0.25 || math.max(-1.0, x) != 0.25 { return 2 }
    if math.clamp(x, 0.0, 1.0) * 4.0 != 1.0 { return 3 }
    x = -3.0
    if math.clamp(x, 0.0, 1.0) != 0.0 || math.clamp(x + 10.0, 0.0, 1.0) != 1.0 { return 4 }
    if math.absolute(x) != 3.0 || math.absolute(-x) != 3.0 || math.abs(x) != 3.0 { return 5 }

    const small: i32 = -12
    const large: i64 = -5000000000
    const unsigned: u32 = 70000
    if math.absoluteOf(i32, small) != 12 || math.absoluteOf(i64, large) != 5000000000 { return 6 }
    if math.minOf(u32, unsigned, 65535) != 65535 || math.maxOf(u32, unsigned, 65535) != 70000 { return 7 }
    if math.clampOf(i32, small, -5, 5) != -5 || math.clampOf(i64, large, -10, 10) != -10 || math.clampOf(u32, 7, 1, 9) != 7 { return 8 }

    if math.sqrt(16.0) != 4.0 || math.sqrt(2.0) != math.sqrt2 { return 9 }
    if math.sqrt(0.0) != 0.0 || math.sqrt(-4.0) != 0.0 { return 10 }
    if !math.isNan(math.sqrt(math.nan())) { return 11 }

    if math.smoothstep(1.0, 3.0, 0.0) != 0.0 || math.smoothstep(1.0, 3.0, 5.0) != 1.0 { return 12 }
    if math.smoothstep(1.0, 3.0, 2.0) != 0.5 { return 14 }
    // 3t^2 - 2t^3 at t = 0.25 is 0.15625, and at 0.75 one less that.
    if math.smoothstep(0.0, 4.0, 1.0) != 0.15625 || math.smoothstep(0.0, 4.0, 3.0) != 0.84375 { return 15 }
    // Falling the other way.
    if math.smoothstep(4.0, 0.0, 1.0) != 0.84375 { return 16 }
    return 13
}
