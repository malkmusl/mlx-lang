var outputs: usize = 0
var nextPoc: i32 = 0
var failed: u8 = 0

fn output(poc: i32) -> void {
    if poc != nextPoc && failed == 0 { failed = 30 }
    nextPoc = poc + 1
    outputs += 1
}

// Decodes stream[from..] access unit by access unit (each made of the
// NAL units up to the next picture's first slice segment or parameter
// sets); the pictures it started.
fn run(h: *h265.Decoder, au: [*]u8, from: usize) -> usize {
    var pictures: usize = 0
    var at = from
    var length: usize = 0
    var hasSlice = false
    var nal: h265.Nal = undefined
    var more = true
    var slot: usize = 0
    var poc: i32 = 0
    while more {
        more = h265.nextAnnexB(&stream, LENGTH, &at, &nal)
        var flush = !more
        if more && hasSlice {
            if nal.kind < 32 && stream[nal.offset + 2] & 0x80 != 0 { flush = true }
            if nal.kind >= 32 && nal.kind <= 34 { flush = true }
        }
        if flush && length > 0 {
            const status = h265.accessUnit(h, au, length, 0)
            if status == h265.Status.ok {
                pictures += 1
                const picture = &h.*.picture
                // The current lists name reference pictures with the POCs
                // the set says.
                var k: usize = 0
                while k < 8 {
                    const before = picture.*.info.RefPicSetStCurrBefore[k]
                    if before != h265.NO_SLOT {
                        const frame = &h.*.frames[@intCast(usize, before)]
                        if !frame.*.used || !frame.*.isReference || frame.*.poc >= picture.*.poc { if failed == 0 { failed = 31 } }
                    }
                    const after = picture.*.info.RefPicSetStCurrAfter[k]
                    if after != h265.NO_SLOT {
                        const frame = &h.*.frames[@intCast(usize, after)]
                        if !frame.*.used || !frame.*.isReference || frame.*.poc <= picture.*.poc { if failed == 0 { failed = 32 } }
                    }
                    k += 1
                }
                if picture.*.info.PicOrderCntVal != picture.*.poc || picture.*.sliceCount == 0 { if failed == 0 { failed = 33 } }
                h265.finishPicture(h)
                while h265.nextOutput(h, &slot, &poc) { output(poc) }
            } else if failed == 0 {
                failed = 34
            }
            length = 0
            hasSlice = false
        }
        if more {
            au[length] = 0
            au[length + 1] = 0
            au[length + 2] = 1
            var k: usize = 0
            while k < nal.length {
                au[length + 3 + k] = stream[nal.offset + k]
                k += 1
            }
            length += nal.length + 3
            if nal.kind < 32 { hasSlice = true }
        }
    }
    h265.flush(h)
    while h265.nextOutput(h, &slot, &poc) { output(poc) }
    return pictures
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const made = h265.create(allocator)
    if made == null { return 1 }
    const h = made.?
    const memory = allocator.alloc(LENGTH * 2, 16)
    if memory == null { return 2 }
    const au = memory.?

    // The whole stream.
    if run(h, au, 0) != 24 { return 3 }
    if failed != 0 { return failed }
    if outputs != 24 || nextPoc != 24 { return 4 }
    const sps = h265.spsAt(h, 0)
    if !sps.*.present || sps.*.width != 64 || sps.*.height != 64 || sps.*.std.chroma_format_idc != 1 { return 5 }
    if sps.*.tierLevel.general_profile_idc != video.STD_VIDEO_H265_PROFILE_IDC_MAIN || sps.*.std.pProfileTierLevel == null { return 6 }
    // (x265 sends every short-term set in the slice headers.)
    if sps.*.dpbPictures != 5 || sps.*.reorderPictures != 2 || sps.*.std.num_short_term_ref_pic_sets != 0 { return 7 }
    if !h265.vpsAt(h, 0).*.present || !h265.ppsAt(h, 0).*.present { return 8 }

    // From the CRA picture on, as after a seek.
    h265.destroy(h)
    const again = h265.create(allocator)
    if again == null { return 9 }
    outputs = 0
    nextPoc = 12
    if run(again.?, au, CRA_AT) != 12 { return 10 }
    if failed != 0 { return failed }
    if outputs != 12 || nextPoc != 24 { return 11 }

    // A cut SPS.
    if h265.parameterSet(again.?, &stream[SPS_AT], 12) == h265.Status.ok { return 12 }
    h265.destroy(again.?)
    allocator.free(au, LENGTH * 2, 16)
    return 13
}
