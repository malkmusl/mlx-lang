// Members of an enum with a signed backing type keep their (negative)
// value through struct fields, copies, parameters and @enumFromInt.
// Exits 13.
const Result = enum(i32, nonexhaustive) { success = 0, timeout = 2, errorDeviceLost = -4, errorUnknown = -13, }
const Small = enum(i8) { low = -128, zero = 0, high = 127, }

const Holder = struct {
    result: Result
    small: Small
    tail: u32
}

fn same(value: Result) -> Result { return value }

pub fn main() -> u8 {
    var holder = Holder.{ .result = Result.success, .small = Small.zero, .tail = 9 }
    holder.result = Result.errorDeviceLost
    holder.small = Small.low
    if holder.result != Result.errorDeviceLost { return 1 }
    if holder.small != Small.low { return 2 }
    const copy = holder
    if copy.result != Result.errorDeviceLost || copy.small != Small.low || copy.tail != 9 { return 3 }
    if same(holder.result) != Result.errorDeviceLost { return 4 }
    const raw: i32 = -13
    if @enumFromInt(Result, raw) != Result.errorUnknown { return 5 }
    if @intFromEnum(holder.result) != -4 { return 6 }
    if @intFromEnum(holder.small) != -128 { return 7 }
    // An unnamed value of a non-exhaustive enum survives the same way.
    const other = @enumFromInt(Result, -1000001004)
    holder.result = other
    if @intFromEnum(holder.result) != -1000001004 { return 8 }
    return 13
}
