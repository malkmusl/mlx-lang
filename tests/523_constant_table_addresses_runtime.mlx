// A module-level `const` table whose rows hold addresses known when the
// program is linked is one image too, as a table of numbers is
// (tests/442_constant_table_static_runtime.mlx): strings (`[]const u8`
// literals, and constants that are one), functions and optional ones,
// slices of other constant tables with bounds known at compile time
// (`A[0..]`, `B[1..3]`, `module.TABLE[0..]`), in nested structs and
// arrays, beside enums and numbers. The image is in the program's code,
// where nothing writes it, and the image writer puts the addresses into
// its words (docs/reference/abi.md, Globals). Before, such a table was
// built at every use: `ICONS[i].name` stored every row, in the frame or,
// over 1 KiB, in the value arena, which only grows (so did `ICONS.length`
// and `ICONS[3].paint(x)`), and `ROWS[0..]` put the rows and the tables
// they name into the arena at each slicing.
//
// Reading a row, a field, the length, slicing the table or walking it
// reads the image and takes nothing of the arena, measured as std.turns
// measures it; two slices of it are the same storage, and a row's slice
// of another table is that table's image. Handed by value or copied into
// a variable it is storage of its own, as before. Exits 13 when every
// check holds, else the number of the first check that failed.
const turns = @import("std.turns")
const lib = @import("./modules/483_tables.mlx")

const Glyph = struct {
    hits: u64
    last: u8
}

fn brush(g: *Glyph) -> void {
    g.*.hits += 1
    g.*.last = 1
}

fn eraser(g: *Glyph) -> void {
    g.*.hits += 10
    g.*.last = 2
}

fn line(g: *Glyph) -> void {
    g.*.hits += 100
    g.*.last = 3
}

const Icon = struct {
    name: []const u8
    paint: fn(*Glyph) -> void
}

// 48 rows of 24 bytes: more than a frame takes (1 KiB), so the value
// arena's when it is built.
const ICONS = [48]Icon{
    Icon.{ .name = "icon-00", .paint = brush },
    Icon.{ .name = "icon-01", .paint = eraser },
    Icon.{ .name = "icon-02", .paint = line },
    Icon.{ .name = "icon-03", .paint = brush },
    Icon.{ .name = "icon-04", .paint = eraser },
    Icon.{ .name = "icon-05", .paint = line },
    Icon.{ .name = "icon-06", .paint = brush },
    Icon.{ .name = "icon-07", .paint = eraser },
    Icon.{ .name = "icon-08", .paint = line },
    Icon.{ .name = "icon-09", .paint = brush },
    Icon.{ .name = "icon-10", .paint = eraser },
    Icon.{ .name = "icon-11", .paint = line },
    Icon.{ .name = "icon-12", .paint = brush },
    Icon.{ .name = "icon-13", .paint = eraser },
    Icon.{ .name = "icon-14", .paint = line },
    Icon.{ .name = "icon-15", .paint = brush },
    Icon.{ .name = "icon-16", .paint = eraser },
    Icon.{ .name = "icon-17", .paint = line },
    Icon.{ .name = "icon-18", .paint = brush },
    Icon.{ .name = "icon-19", .paint = eraser },
    Icon.{ .name = "icon-20", .paint = line },
    Icon.{ .name = "icon-21", .paint = brush },
    Icon.{ .name = "icon-22", .paint = eraser },
    Icon.{ .name = "icon-23", .paint = line },
    Icon.{ .name = "icon-24", .paint = brush },
    Icon.{ .name = "icon-25", .paint = eraser },
    Icon.{ .name = "icon-26", .paint = line },
    Icon.{ .name = "icon-27", .paint = brush },
    Icon.{ .name = "icon-28", .paint = eraser },
    Icon.{ .name = "icon-29", .paint = line },
    Icon.{ .name = "icon-30", .paint = brush },
    Icon.{ .name = "icon-31", .paint = eraser },
    Icon.{ .name = "icon-32", .paint = line },
    Icon.{ .name = "icon-33", .paint = brush },
    Icon.{ .name = "icon-34", .paint = eraser },
    Icon.{ .name = "icon-35", .paint = line },
    Icon.{ .name = "icon-36", .paint = brush },
    Icon.{ .name = "icon-37", .paint = eraser },
    Icon.{ .name = "icon-38", .paint = line },
    Icon.{ .name = "icon-39", .paint = brush },
    Icon.{ .name = "icon-40", .paint = eraser },
    Icon.{ .name = "icon-41", .paint = line },
    Icon.{ .name = "icon-42", .paint = brush },
    Icon.{ .name = "icon-43", .paint = eraser },
    Icon.{ .name = "icon-44", .paint = line },
    Icon.{ .name = "icon-45", .paint = brush },
    Icon.{ .name = "icon-46", .paint = eraser },
    Icon.{ .name = "icon-47", .paint = line },
}

const Row = struct {
    name: []const u8
    values: []const u32
}

const A = [3]u32{ 11, 12, 13 }
const B = [4]u32{ 21, 22, 23, 24 }
const SECOND = "second"
const ROWS = [3]Row{
    Row.{ .name = "first", .values = A[0..] },
    Row.{ .name = SECOND, .values = B[1..3] },
    Row.{ .name = "tab\there", .values = A[1..] },
}

const Kind = enum(u8) { plain, scaled }

const Inner = struct {
    scale: i64
    apply: fn(i64) -> i64
}

const Entry = struct {
    kind: Kind
    labels: [2][]const u8
    inner: Inner
    hook: ?fn(i64) -> i64
}

fn negate(x: i64) -> i64 { return -x }

const ENTRIES = [2]Entry{
    Entry.{ .kind = Kind.plain, .labels = [2][]const u8{ "p", "plain" }, .inner = Inner.{ .scale = 3, .apply = negate }, .hook = null },
    Entry.{ .kind = Kind.scaled, .labels = [2][]const u8{ "s", "scaled" }, .inner = Inner.{ .scale = -7, .apply = lib.square }, .hook = lib.double },
}

const WORDS = [4][]const u8{ "alpha", "beta", "gamma", "delta" }

// Another module's string, table and function.
const MINE = [1]lib.Info{
    lib.Info.{ .key = lib.GREETING, .params = lib.PARAMS[2..], .render = lib.square },
}

fn same(text: []const u8, expected: []const u8) -> bool {
    if text.length != expected.length { return false }
    var k: usize = 0
    while k < text.length {
        if text[k] != expected[k] { return false }
        k += 1
    }
    return true
}

// "icon-NN" for row `k`.
fn iconName(name: []const u8, k: usize) -> bool {
    if name.length != 7 || !same(name[0..5], "icon-") { return false }
    return name[5] == @intCast(u8, 48 + k / 10) && name[6] == @intCast(u8, 48 + k % 10)
}

fn used(base: usize) -> usize { return if base == 0 { 0 } else { turns.used(base) } }

// Bytes the arena grew by since `before` (0 where it is not found, as
// under an emulator: the values are checked all the same).
fn grown(base: usize, before: usize) -> usize { return if base == 0 { 0 } else { turns.used(base) - before } }

// The table by value: storage of the callee's, changed there.
fn renamed(rows: [3]Row) -> []const u8 {
    var copy = rows
    copy[0].name = "renamed"
    return copy[0].name
}

pub fn main() -> u8 {
    const base = turns.locate()

    // Every row's string and function, at an index known only now.
    var k: usize = 0
    var glyph = Glyph.{ .hits = 0, .last = 0 }
    while k < 48 {
        if !iconName(ICONS[k].name, k) { return 1 }
        ICONS[k].paint(&glyph)
        k += 1
    }
    if glyph.hits != 16 + 160 + 1600 { return 2 }
    ICONS[4].paint(&glyph)
    if glyph.last != 2 || ICONS.length != 48 { return 3 }

    // None of those reads takes anything of the arena: a row's field, the
    // length, a call through a row's function.
    var before = used(base)
    var total: usize = 0
    k = 0
    while k < 100 {
        total += ICONS[(k * 7) % 48].name.length + ICONS.length
        ICONS[k % 48].paint(&glyph)
        ICONS[3].paint(&glyph)
        k += 1
    }
    if grown(base, before) != 0 { return 4 }
    if total != 100 * (7 + 48) || glyph.last != 1 { return 5 }

    // A slice of the table is the image: twice the same storage, the
    // place of its rows; with bounds known only now too.
    before = used(base)
    const all = ICONS[0..]
    const again = ICONS[0..]
    var low: usize = 5
    var high: usize = 9
    const part = ICONS[low..high]
    if grown(base, before) != 0 { return 6 }
    if @intFromPtr(&all[0]) != @intFromPtr(&again[0]) || @intFromPtr(&all[0]) != @intFromPtr(&ICONS[0]) { return 7 }
    if @intFromPtr(&part[0]) != @intFromPtr(&ICONS[5]) || part.length != 4 || !iconName(part[3].name, 8) { return 8 }

    // Walking it, element by element or by a pointer to each.
    before = used(base)
    var letters: usize = 0
    for icon in ICONS { letters += icon.name.length }
    for *icon in ICONS { letters += icon.*.name.length }
    if grown(base, before) != 0 || letters != 2 * 48 * 7 { return 9 }

    // Rows that name other tables: the row's slice is that table's image,
    // with the bounds given; the strings are right, a constant's and one
    // with an escape too.
    before = used(base)
    const rows = ROWS[0..]
    if grown(base, before) != 0 { return 10 }
    if @intFromPtr(&rows[0].values[0]) != @intFromPtr(&A[0]) || @intFromPtr(&rows[1].values[0]) != @intFromPtr(&B[1]) { return 11 }
    if rows[0].values.length != 3 || rows[1].values.length != 2 || rows[2].values.length != 2 { return 12 }
    if rows[1].values[1] != 23 || rows[2].values[1] != 13 || ROWS[0].values[2] != 13 { return 14 }
    if !same(rows[0].name, "first") || !same(ROWS[1].name, "second") || ROWS[2].name.length != 8 || ROWS[2].name[3] != 9 { return 15 }

    // Nested structs and arrays, an enum, an optional function.
    var at: usize = 1
    if ENTRIES[at].kind != Kind.scaled || ENTRIES[0].kind != Kind.plain { return 16 }
    if !same(ENTRIES[at].labels[1], "scaled") || !same(ENTRIES[0].labels[at - 1], "p") { return 17 }
    if ENTRIES[0].inner.apply(ENTRIES[0].inner.scale) != -3 || ENTRIES[at].inner.apply(ENTRIES[at].inner.scale) != 49 { return 18 }
    if ENTRIES[0].hook != null { return 19 }
    const hook = ENTRIES[at].hook
    if hook == null || hook.?(21) != 42 { return 20 }

    // A table of strings.
    before = used(base)
    var lengths: usize = 0
    k = 0
    while k < 4 {
        lengths += WORDS[k].length
        k += 1
    }
    if grown(base, before) != 0 || lengths != 19 || !same(WORDS[at + 1], "gamma") { return 21 }

    // Another module's tables, and one here naming its string, table and
    // function.
    if !same(lib.INFOS[at].key, "square") || lib.INFOS[at].params.length != 2 || lib.INFOS[0].params.length != 3 { return 22 }
    if !same(lib.INFOS[at].params[0].name, "Grün") || lib.INFOS[at].params[0].name.length != 5 || lib.INFOS[at].params[1].high != 4.0 { return 23 }
    if lib.INFOS[0].render(lib.INFOS[at].render(3)) != 18 { return 24 }
    if @intFromPtr(&lib.INFOS[at].params[0]) != @intFromPtr(&lib.PARAMS[1]) { return 25 }
    if !same(MINE[0].key, "hello") || MINE[0].params.length != 1 || !same(MINE[0].params[0].name, "Blue") || MINE[0].render(5) != 25 { return 26 }

    // Its value is still a value: copied into a variable or handed to a
    // function, it is storage of its own, changed there and not in the
    // image.
    var copy = ROWS
    copy[0].name = "changed"
    copy[1].values = A[0..1]
    if @intFromPtr(&copy[0]) == @intFromPtr(&ROWS[0]) { return 27 }
    if !same(ROWS[0].name, "first") || ROWS[1].values.length != 2 || !same(copy[0].name, "changed") || copy[1].values.length != 1 { return 28 }
    if !same(renamed(ROWS), "renamed") || !same(ROWS[0].name, "first") { return 29 }
    return 13
}
