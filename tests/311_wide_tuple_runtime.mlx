// Tuples of more than three words (a slice among other parts) returned
// from a function and taken apart: every part comes back. Older compilers
// returned three words at most (the last part lost) and typed `pair.1` as
// nothing, so a slice taken out of a tuple kept one word and a later
// comparison on it crashed the compiler. Exits 13 when every check holds,
// else the number of the first check that failed.
fn three(text: []const u8) -> (u32, []const u8, u64) { return -> (7, text, 99) }

fn five(first: []const u8, second: []const u8, last: u8) -> ([]const u8, []const u8, u8) { return -> (first, second, last) }

pub fn main() -> u8 {
    const result = three("hello")
    const text = result.1
    if result.0 != 7 { return 1 }
    if text.length != 5 || text[0] != 104 { return 2 }
    if result.2 != 99 { return 3 }
    const parts = five("ab", "cde", 42)
    const first = parts.0
    const second = parts.1
    if first.length != 2 || second.length != 3 || second[2] != 101 { return 4 }
    if parts.2 != 42 { return 5 }
    const pair: (u32, []const u8) = .{ 7, "hello" }
    const word = pair.1
    if word.length != 5 || word[4] != 111 { return 6 }
    return 13
}
