const bootstrap = @import("../std/bootstrap/root.zin")

pub fn main() -> u8 {
    var code: [16]u8 = [16]u8{ 72, 199, 192, 60, 0, 0, 0, 72, 199, 199, 13, 0, 0, 0, 15, 5 }
    const allocator = bootstrap.page_allocator.init()
    const image = bootstrap.allocator.alloc(allocator, 136, 16).?
    unsafe {
        const length = bootstrap.elf.writeExecutableImage(
            image,
            @ptrCast([*]const u8, code[0..16]),
            16,
        )
        if length != 136 || image[0] != 127 || image[120] != 72 {
            return 1
        }
        if !bootstrap.elf.writeExecutableFile(
            @ptrCast([*]const u8, "/tmp/zin-bootstrap-emitted"),
            image[0..length],
        ) {
            return 2
        }
        bootstrap.allocator.free(allocator, image, 136, 16)
    }
    return 13
}
