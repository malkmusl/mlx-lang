// A DisplayPort training that fails falling back as Linux decides, and the
// link set from a new monitor's registers after a long pulse
// (projects/brix/kernel/gpu_link.mlx's `fallback`, `fallBack` and
// `remains`; gpu_mode.mlx's `Wish.anew`, the steps that follow the link
// the training ends at; gpu_set.mlx), built for the host, on the user's
// whole card as a table with a DisplayPort monitor behind an AUX channel
// (tests/support/dp_world.mlx):
// - Linux's rule (link_dp_capability.c's decide_fallback_link_setting)
//   for each kind of failure, its ceiling lowered as the rule lowers it;
// - a training that falls back to a setting that carries the timing: the
//   link from then on, the early blanking and M written for it (Linux's
//   cur_link_settings), write for write;
// - one that falls back to a setting that trains and does not carry the
//   timing: the link that remains, kept in the monitor's record, the plan
//   made again for it with another timing of the monitor's size;
// - a training that fails at every step: the rule's end, the way back,
//   every try in one line, the tries and the time bounded;
// - after a long pulse, another monitor on the DisplayPort output that
//   shows the picture: its link set from its own registers (not trained
//   again at the old rate and lanes); one of another size: the link set
//   for the timing that runs, and the picture's size kept, said as the
//   switch says it for HDMI;
// - the rule's longest way (23 settings from 8.1 Gbit/s on 4 lanes, 14
//   from 5.4) within the search's bound; a link set anew after a long
//   pulse that falls back.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const dplink = @import("../projects/brix/kernel/gpu_link.mlx")
const rule = @import("../projects/brix/kernel/gpu_switch.mlx")
const dpwatch = @import("../projects/brix/kernel/gpu_dpwatch.mlx")
const display = @import("./support/tmds_card.mlx")
const lines = @import("./support/plug_card.mlx")
const sw = @import("./support/switch_card.mlx")
const sink = @import("./support/dp_monitor.mlx")
const card = @import("./support/dpswitch_card.mlx")
const w = @import("./support/dp_world.mlx")

const MS = w.MS
const NEVER = w.NEVER
const HIGH = dplink.LINK_RATE_HIGH
const LOW = dplink.LINK_RATE_LOW

fn s(code: usize, lanes: usize) -> dplink.Setting { return dplink.Setting.{ .code = code, .lanes = lanes } }

fn is(a: dplink.Setting, code: usize, lanes: usize) -> bool { return a.code == code && a.lanes == lanes }

// ---- How long the rule can go on (the review's): the longest way from
// `max` and `cur` over every kind of failure at every step, each state
// (the ceiling's rate, the setting) worked out once. Linux bounds its
// search by the rule alone; the search here must reach the rule's end.
const KINDS = [_]dplink.End{ dplink.End.clock, dplink.End.clock, dplink.End.clock, dplink.End.equalise, dplink.End.clock_lost_some, dplink.End.clock_lost_all }
const LANES_OF = [_]usize{ 0, 1, 2, 4, 4, 4 }
var memo: [4 * 4 * 3]usize = undefined

fn rateIndex(code: usize) -> usize { return if code == LOW { 0 } else if code == HIGH { 1 } else if code == dplink.LINK_RATE_HIGH2 { 2 } else { 3 } }

fn laneIndex(lanes: usize) -> usize { return if lanes == 1 { 0 } else if lanes == 2 { 1 } else { 2 } }

fn chain(max: dplink.Setting, cur: dplink.Setting) -> usize {
    const at = (rateIndex(max.code) * 4 + rateIndex(cur.code)) * 3 + laneIndex(cur.lanes)
    if memo[at] != NEVER { return memo[at] }
    var best: usize = 0
    var k: usize = 0
    while k < KINDS[0..].length {
        // (Clock recovery's lane: 0, 1, or 2 standing for 2 and 3; only
        // a lane the setting has.)
        if k > 2 || LANES_OF[k] < cur.lanes {
            var m = max
            const next = dplink.fallback(&m, cur, KINDS[k], LANES_OF[k])
            if next.code != 0 {
                const n = 1 + chain(m, next)
                if n > best { best = n }
            }
        }
        k += 1
    }
    memo[at] = best
    return best
}

fn longestChain(code: usize, lanes: usize) -> usize {
    var k: usize = 0
    while k < memo[0..].length {
        memo[k] = NEVER
        k += 1
    }
    return chain(s(code, lanes), s(code, lanes))
}

fn theRulesEnd() -> void {
    w.named("the rule's longest way")
    const from81 = longestChain(dplink.LINK_RATE_HIGH3, 4)
    const from54 = longestChain(dplink.LINK_RATE_HIGH2, 4)
    w.expect(from81 == 23 && from54 == 14 && longestChain(HIGH, 4) == 7, "the rule goes on 23 settings at most from 8.1x4, 14 from 5.4x4, 7 from 2.7x4")
    w.expect(from81 <= dplink.FALLBACKS, "the search reaches the rule's end however the tries fail")
}

// ---- Linux's rule, case by case (decide_fallback_link_setting's own
// table: the study's 5.4, corrected).
fn theRule() -> void {
    w.named("the rule")
    const most = s(dplink.LINK_RATE_HIGH3, 4)
    var max = most
    // Clock recovery: one rate lower on the same lanes.
    w.expect(is(dplink.fallback(&max, s(dplink.LINK_RATE_HIGH3, 4), dplink.End.clock, 0), dplink.LINK_RATE_HIGH2, 4), "clock recovery at 8.1x4: 5.4x4")
    w.expect(is(dplink.fallback(&max, s(dplink.LINK_RATE_HIGH2, 4), dplink.End.clock, 3), HIGH, 4), "clock recovery at 5.4x4: 2.7x4")
    w.expect(is(dplink.fallback(&max, s(HIGH, 2), dplink.End.clock, 1), LOW, 2), "clock recovery at 2.7x2: 1.62x2")
    // At the lowest rate: the highest again, on 1 lane (lane 1 failed) or
    // 2 (lane 2 or 3), none for lane 0.
    w.expect(is(dplink.fallback(&max, s(LOW, 4), dplink.End.clock, 1), dplink.LINK_RATE_HIGH3, 1), "clock recovery on lane 1 at 1.62x4: 8.1x1")
    w.expect(is(dplink.fallback(&max, s(LOW, 4), dplink.End.clock, 2), dplink.LINK_RATE_HIGH3, 2), "clock recovery on lane 2 at 1.62x4: 8.1x2")
    w.expect(is(dplink.fallback(&max, s(LOW, 4), dplink.End.clock, 3), dplink.LINK_RATE_HIGH3, 2), "clock recovery on lane 3 at 1.62x4: 8.1x2")
    w.expect(dplink.fallback(&max, s(LOW, 4), dplink.End.clock, 0).code == 0, "clock recovery on lane 0 at the lowest rate: none")
    w.expect(dplink.fallback(&max, s(LOW, 1), dplink.End.clock, 0).code == 0, "clock recovery on 1 lane at the lowest rate: none")
    w.expect(max.code == dplink.LINK_RATE_HIGH3 && max.lanes == 4, "clock recovery does not lower the ceiling")
    // The equalisation: half the lanes; on 1 lane one rate lower on every
    // lane, and that rate the ceiling.
    w.expect(is(dplink.fallback(&max, s(dplink.LINK_RATE_HIGH2, 4), dplink.End.equalise, 4), dplink.LINK_RATE_HIGH2, 2), "the equalisation at 5.4x4: 5.4x2")
    w.expect(is(dplink.fallback(&max, s(dplink.LINK_RATE_HIGH2, 2), dplink.End.clock_lost_some, 4), dplink.LINK_RATE_HIGH2, 1), "clock lost on some lanes at 5.4x2: 5.4x1")
    w.expect(is(dplink.fallback(&max, s(dplink.LINK_RATE_HIGH2, 1), dplink.End.equalise, 4), HIGH, 4) && max.code == HIGH, "the equalisation at 5.4x1: 2.7x4, 2.7 the ceiling")
    w.expect(is(dplink.fallback(&max, s(LOW, 4), dplink.End.clock, 2), HIGH, 2), "clock recovery on lane 2 at 1.62x4 under the ceiling 2.7: 2.7x2")
    w.expect(dplink.fallback(&max, s(LOW, 1), dplink.End.equalise, 4).code == 0, "the equalisation at 1.62x1: none")
    // Clock recovery lost on every lane in the equalisation: one rate
    // lower on every lane, the ceiling with it.
    max = most
    w.expect(is(dplink.fallback(&max, s(dplink.LINK_RATE_HIGH3, 2), dplink.End.clock_lost_all, 4), dplink.LINK_RATE_HIGH2, 4) && max.code == dplink.LINK_RATE_HIGH2, "clock lost on all lanes at 8.1x2: 5.4x4, 5.4 the ceiling")
    w.expect(dplink.fallback(&max, s(LOW, 4), dplink.End.clock_lost_all, 4).code == 0, "clock lost on all lanes at the lowest rate: none")
    // What is no training's failure falls back to nothing.
    w.expect(dplink.fallback(&max, s(HIGH, 4), dplink.End.lost, 4).code == 0 && dplink.fallback(&max, s(HIGH, 4), dplink.End.silent, 4).code == 0 && dplink.fallback(&max, s(HIGH, 4), dplink.End.table, 4).code == 0, "a link that did not hold, a silent monitor, a table: none")
    w.expect(dplink.lowerRate(LOW) == 0 && dplink.fewerLanes(1) == 0, "below the lowest rate and one lane: none")
}

// ---- A fallback that carries the timing: 1920x1080 at 148500 kHz needs
// 1.62x4 (5.18 Gbit/s for 3.56). Clock
// recovery fails on lane 2 four times at 1.62x4 (lanes 2 and 3 never
// recover their clock), the rule takes the card's
// highest rate (2.7, the ROM has no rate record for it) on 2 lanes, which
// trains and carries the stream: the link from then on.
fn fallsToACarryingLink() -> void {
    w.usersWith("at boot: a fallback that carries the timing", 0, false, 0x12, 0x14, 4, w.small[0..])
    sink.needSwing[2] = 4
    sink.needSwing[3] = 4
    w.boot()
    w.expect(w.bootPlan.move.toDp && is(w.bootPlan.dp.target, LOW, 4), "the plan: 1.62x4 for 148500 kHz")
    w.expect(display.count("gpu: train 1.62x4: failed at clock recovery on lane 2") == 4, "four tries at 1.62x4, clock recovery failing on lane 2")
    w.once("gpu: train 1.62x4: falls back to 2.70 Gbit/s on 2 lanes as Linux decides (decide_fallback_link_setting: the highest rate again, on fewer lanes; it carries the stream)\n")
    w.line("gpu: train 2.70x2: trained in ")
    w.line("; holds after 5 ms (fallback 1, ")
    w.expect(w.bootResult.outcome == set.Outcome.done && is(w.bootResult.trained, HIGH, 2), "done, on the link it fell back to")
    w.line(": the picture goes out by the new output, on a link trained at 2.70 Gbit/s on 2 lanes (")
    w.expect(sink.txOn && sink.txCode == HIGH && sink.txLanes == 2 && w.locked(2), "the monitor holds 2.70x2, its lanes locked")
    // The steps after the training follow it (dce110_enable_stream,
    // dce110_unblank_stream with cur_link_settings): the early blanking for
    // 2 lanes (1920 a multiple of 2), M for 2.7 Gbit/s, the lanes' count.
    w.expect(w.early() == 2, "the early blanking for the 2 lanes trained")
    w.expect(display.raw(scanout.DIG[2] + scanout.DP_VID_M) == 0x8000 * 148500 / 270000, "M for 148500 kHz over 270 MHz")
    w.expect(display.raw(scanout.DIG[2] + scanout.DP_CONFIG) & 3 == 1, "the back end's lanes: 2")
    // In that order: the last transmitter's "on" at 2.7x2, then the early
    // blanking, then M.
    const on = w.lastOnWrite(2, HIGH, 2)
    const blanking = w.lastWrite(scanout.CRTC_CONTROL)
    const m = w.lastWrite(scanout.DIG[2] + scanout.DP_VID_M)
    w.expect(on != NEVER && blanking != NEVER && m != NEVER && on < blanking && blanking < m, "the training, the early blanking, M: in Linux's order")
    w.expect(w.replans == 0 && w.watch.ports.ports[0].dp.verified.code == 0, "no plan made again, no link that remains")
}

// ---- A fallback that trains and does not carry the timing: the user's
// monitor with its second timing of its size (3840x1080 at 30 Hz, 135140
// kHz); 270270 kHz needs 2.7x4; lanes 2 and 3 never recover. 2.7x4 fails,
// 1.62x4 (5.18 Gbit/s for 6.49) fails, 2.7x2 trains and does not carry it:
// the link that remains; the plan is made again for it: the monitor's
// timing of 30 Hz, on 2.7x2.
fn fallsToTheLinkThatRemains() -> void {
    w.usersWith("at boot: the link that remains, and the plan made again for it", 0, false, 0x12, 0x14, 4, w.twoRates[0..])
    sink.needSwing[2] = 4
    sink.needSwing[3] = 4
    w.boot()
    w.expect(display.count("gpu: train 2.70x4: failed at clock recovery on lane 2") == 4, "four tries at 2.70x4")
    w.once("gpu: train 2.70x4: falls back to 1.62 Gbit/s on 4 lanes as Linux decides (decide_fallback_link_setting: a lower rate; it does not carry the stream, and is tried for the link that remains)\n")
    w.once("gpu: train 1.62x4: falls back to 2.70 Gbit/s on 2 lanes as Linux decides (decide_fallback_link_setting: the highest rate again, on fewer lanes; it does not carry the stream, and is tried for the link that remains)\n")
    w.once("gpu: train 2.70x2: it holds, and does not carry 270270 kHz at 24 bits: it is the link that remains, and the change ends here\n")
    w.line("gpu: the state of before is back")
    w.once("gpu: the link that remains on this output is 2.70 Gbit/s on 2 lanes (it trained there): the plan is made again for it, with a timing it carries\n")
    w.expect(w.replans == 1 && is(w.watch.ports.ports[0].dp.verified, HIGH, 2), "made again once; the record keeps 2.70x2")
    w.line("gpu: the new output's link: the link that remained after a training fell back, up to 2.70 Gbit/s on 2 lanes (")
    w.line("; the monitor's own timing at 270270 kHz needs more: another of its size; for 135140 kHz at 24 bits: 2.70 Gbit/s on 2 lanes")
    w.expect(w.bootResult.outcome == set.Outcome.done && w.bootPlan.timing.clock == 135140 && is(w.bootPlan.dp.target, HIGH, 2), "done at 30 Hz on 2.70x2")
    w.expect(w.follow.showing == 0 && w.follow.width == 3840 && w.follow.height == 1080, "connector 0 shows the picture of 3840x1080")
    w.expect(w.early() == 2 && display.raw(scanout.DIG[2] + scanout.DP_VID_M) == 0x8000 * 135140 / 270000, "the early blanking and M for 2.70x2")
    // (A record of a lower link only: the plans made again end.)
    var record = w.watch.ports.ports[0].dp
    const c = w.out()
    w.expect(!dplink.remains(&c, &record, s(HIGH, 2)) && !dplink.remains(&c, &record, s(HIGH, 4)) && dplink.remains(&c, &record, s(LOW, 2)), "only a link below the one kept is taken")
}

// ---- A training that fails at every step: the monitor recovers no clock
// at any rate (it asks for the swing it has). 2.7x4 four times, the rule
// gives 1.62x4, which fails on lane 0 at the lowest rate: nothing is left.
// The way back; every try a line; the tries bounded.
fn failsAtEveryStep() -> void {
    w.usersWith("at boot: a training that fails at every step", 0, false, 0x12, 0x14, 4, w.users[0..])
    sink.stubborn = true
    w.boot()
    w.expect(display.count("gpu: train 2.70x4: failed at clock recovery on lane 0") == 4, "four tries at 2.70x4")
    w.once("gpu: train 2.70x4: falls back to 1.62 Gbit/s on 4 lanes as Linux decides (decide_fallback_link_setting: a lower rate; it does not carry the stream, and is tried for the link that remains)\n")
    w.once("gpu: train 1.62x4: failed at clock recovery on lane 0, which points to a lower rate (fallback 1; the last status 0 0 0 0, drive swing 0 pre 0)\n")
    w.once("gpu: train 1.62x4: nothing is left to fall back to (Linux's decide_fallback_link_setting after clock recovery)\n")
    w.expect(w.bootResult.outcome != set.Outcome.done && w.follow.showing == 2 && w.backOn(4) && !w.onDto(), "not carried out; the firmware's picture on HDMI 2 again")
    w.expect(sink.turnedOn == 5, "five tries in all: four and the fallback's")
    w.expect(w.replans == 0 && w.bootResult.remaining.code == 0, "no link remains, nothing made again")
    w.expect(w.bootResult.longest >= 4 * dplink.TRY_TIME + dplink.FALLBACKS * dplink.TRY_TIME, "the bound said before the first write counts the fallback's tries")
    w.expect(w.bootResult.longest >= w.bootResult.longestBack + dplink.longestFallingBack(0), "the bound: the way back's training and the fallback's tries beside it")
    sink.stubborn = false

    // Lane 1 recovers its clock at no rate: 2.7x4, 1.62x4, then the
    // highest rate on 1 lane, which trains and carries nothing of
    // 270270 kHz: the link that remains; the plan made again finds no
    // timing of the monitor's size for 2.7x1: not complete, said, and the
    // firmware's picture stays.
    w.usersWith("at boot: lane 1 never recovers", 0, false, 0x12, 0x14, 4, w.users[0..])
    sink.needSwing[1] = 4
    w.boot()
    w.once("gpu: train 1.62x4: falls back to 2.70 Gbit/s on 1 lane as Linux decides (decide_fallback_link_setting: the highest rate again, on fewer lanes; it does not carry the stream, and is tried for the link that remains)\n")
    w.once("gpu: the link that remains on this output is 2.70 Gbit/s on 1 lane (it trained there): the plan is made again for it, with a timing it carries\n")
    w.expect(w.replans == 1 && !w.bootPlan.complete && w.bootPlan.missing == mode.Missing.no_setting, "made again once: no rate and lanes carry a timing of the monitor's")
    w.expect(w.bootResult.outcome != set.Outcome.done && w.follow.showing == 2 && w.backOn(4), "the firmware's picture stays on HDMI 2")
    w.expect(sink.turnedOn <= 4 + dplink.FALLBACKS, "the tries bounded")
}

// ---- After a long pulse the link is set from the new monitor's
// registers. Booted with the 1920x1080 monitor on DisplayPort 0 (1.62x4);
// another one comes in its place that has 2 lanes (2.7 Gbit/s): the link
// is set at 2.7x2, the lowest that carries the 148500 kHz that run within
// what it says now, not trained again at 1.62x4.
fn theNewMonitorsLink() -> void {
    w.usersWith("while running: another monitor after a long pulse, its own link", 0, false, 0x12, 0x14, 4, w.small[0..])
    w.boot()
    w.expect(w.bootResult.outcome == set.Outcome.done && is(w.bootPlan.dp.target, LOW, 4) && w.follow.showing == 0, "at boot: 1920x1080 on 1.62x4")
    display.logged = 0
    w.made = 0
    lines.line(card.DP_LINES[0], false)
    w.ticks(display.clock + 500 * MS)
    card.dpMonitor(0, 0x12, HIGH, 2, w.small[0..], true)
    w.ticks(display.clock + 3000 * MS)
    w.once("gpu: connector 0 (DisplayPort): the monitor is back on its line: sink count 1, lanes 0 0 0 0, not aligned: the link is lost (the monitor is on): it is trained again at the rate and lanes the monitor's registers give now\n")
    w.line("gpu: in the lines that follow, \"the firmware's own link\" is the link that ran; the link is set from what the monitor says now\n")
    w.expect(sink.txCode == HIGH && sink.txLanes == 2 && w.locked(2), "trained at 2.70x2, its lanes locked")
    w.noLine("gpu: train 1.62x4")
    w.expect(w.sinks.trained == 1 && w.made == 0 && w.follow.showing == 0, "the link set anew, nothing moved")
    w.expect(w.early() == 2 && display.raw(scanout.DIG[2] + scanout.DP_VID_M) == 0x8000 * 148500 / 270000 && display.raw(scanout.DIG[2] + scanout.DP_CONFIG) & 3 == 1, "the early blanking, M and the lanes for 2.70x2")

    // A monitor of another size there (the user's 3840x1080, 2.7 Gbit/s on
    // 2 lanes): the link set for the 1920x1080 that runs (2.7x2 carries
    // it), and the switch says what it says for HDMI: the picture keeps its
    // size, a restart gives the monitor its own.
    w.named("while running: a monitor of another size after a long pulse")
    display.logged = 0
    lines.line(card.DP_LINES[0], false)
    w.ticks(display.clock + 500 * MS)
    card.dpMonitor(0, 0x12, HIGH, 2, w.users[0..], true)
    w.ticks(display.clock + 3000 * MS)
    w.line("it is trained again at the rate and lanes the monitor's registers give now\n")
    w.expect(sink.txCode == HIGH && sink.txLanes == 2 && w.locked(2) && w.sinks.trained == 2, "its link set at 2.70x2 for the timing that runs")
    w.once("gpu: connector 0 (DisplayPort): the monitor there is 3840x1080, the picture 1920x1080: a picture of another size would have to be told to the programs that draw on it, which is not done while brixOS runs; the picture stays where it goes out, and a restart gives the monitor its own mode\n")
    w.expect(w.made == 0 && w.follow.width == 1920, "nothing moved, the picture's size kept")

    // One whose link carries nothing of the timing that runs (1.62 Gbit/s
    // on 1 lane): not set, said, left to the monitor.
    w.named("while running: a monitor whose link cannot carry the timing that runs")
    display.logged = 0
    lines.line(card.DP_LINES[0], false)
    w.ticks(display.clock + 500 * MS)
    card.dpMonitor(0, 0x12, LOW, 1, w.small[0..], true)
    w.ticks(display.clock + 3000 * MS)
    w.line("gpu: plan (the firmware's own link trained again): nothing would be set: no rate and count of lanes that both ends have carries 148500 kHz at 24 bits: the most they have is 1.62 Gbit/s on 1 lane")
    w.line(": its link did not train again: the looks every 2 s leave it now; it is trained again when the monitor pulses its hot plug line or comes back on it\n")
    w.expect(w.sinks.left == 0 && w.sinks.trained == 2, "left to the monitor, not trained")
}

// ---- After a long pulse, a monitor whose lanes 2 and 3 never recover
// their clock (the review's): the link set anew at 1.62x4 for the 148500
// kHz that run fails, and falls back as at a mode set (2.7x2, which
// carries it): the stream's M and the early blanking for that link.
fn anewFallsBack() -> void {
    w.usersWith("while running: a long pulse, the new link falls back", 0, false, 0x12, 0x14, 4, w.small[0..])
    w.boot()
    w.expect(w.bootResult.outcome == set.Outcome.done && is(w.bootPlan.dp.target, LOW, 4), "at boot: 1920x1080 on 1.62x4")
    display.logged = 0
    w.made = 0
    lines.line(card.DP_LINES[0], false)
    w.ticks(display.clock + 500 * MS)
    card.dpMonitor(0, 0x12, 0x14, 4, w.small[0..], true)
    sink.needSwing[2] = 4
    sink.needSwing[3] = 4
    w.ticks(display.clock + 4000 * MS)
    w.once("gpu: train 1.62x4: falls back to 2.70 Gbit/s on 2 lanes as Linux decides (decide_fallback_link_setting: the highest rate again, on fewer lanes; it carries the stream)\n")
    w.expect(sink.txCode == HIGH && sink.txLanes == 2 && w.locked(2), "the link at 2.70x2, its lanes locked")
    w.expect(w.early() == 2 && display.raw(scanout.DIG[2] + scanout.DP_VID_M) == 0x8000 * 148500 / 270000, "the early blanking and M for 2.70x2")
    w.expect(w.made == 0 && w.follow.showing == 0, "nothing moved")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    w.begin(arguments)
    theRule()
    theRulesEnd()
    fallsToACarryingLink()
    fallsToTheLinkThatRemains()
    failsAtEveryStep()
    theNewMonitorsLink()
    anewFallsBack()
    return if w.failed == 0 { 13 } else { w.failed }
}
