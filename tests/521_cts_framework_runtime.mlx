// The Vulkan conformance suite's framework (projects/cts) built by our
// toolchain and its own self-tests run: tools/check_cts.sh --framework
// compiles delibs (debase, depool, dethread, deutil, decpp) and qphelper
// from the fetched sources (tools/fetch_cts.sh; CTS_SOURCES, else
// mlx-out/cts/sources) with mlx-cc, links them with projects/cts/port/
// framework_selftest.cpp by mlx-ld on mlxlibc and mlxlibcpp, and runs
// them. Every self-test of the list below must say ok and none FAIL, the
// count line must be the whole list's, the script must end with 0, and
// the program must be mlxlibc's (its loader the one it asks for) with no
// object of another compiler in it. Exits 13 when every check holds, else
// the number of the first that failed, with what the script said on the
// error output.
const std = @import("std")
const spawn = @import("std.spawn")

// The self-tests framework_selftest.cpp runs, in its order.
const TESTS = [33][]const u8{ "debase.int32", "debase.float16", "debase.math", "debase.sha1", "debase.memory", "depool.array", "depool.heap", "depool.hash", "depool.set", "depool.hash_set", "depool.hash_array", "depool.multi_set", "dethread.thread", "dethread.mutex", "dethread.semaphore", "dethread.atomic", "dethread.singleton", "deutil.command_line", "decpp.block_buffer", "decpp.file_path", "decpp.pool_array", "decpp.ring_buffer", "decpp.shared_ptr", "decpp.thread_safe_ring_buffer", "decpp.unique_ptr", "decpp.random", "decpp.commandline", "decpp.array_buffer", "decpp.string_util", "decpp.spin_barrier", "decpp.stl_util", "decpp.append_list", "qphelper.test_log" }

const PROGRAM: []const u8 = "mlx-out/cts/framework/framework-selftest"

// What the script said, when a check failed: on the error output, for
// the runner's log.
fn tell(output: []const u8, check: u8) -> u8 {
    _ = std.io.eprintln("521: what tools/check_cts.sh --framework said:")
    _ = std.io.eprint(output)
    _ = std.io.eprintln("")
    return check
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const environment = std.process.environmentEntries(arguments)
    var argv: [3][*]const u8 = undefined
    argv[0] = "tools/check_cts.sh".pointer
    argv[1] = "--framework".pointer
    argv[2] = unsafe { @ptrFromInt([*]const u8, 0) }
    var options = spawn.options("tools/check_cts.sh".pointer, unsafe { @ptrCast([*][*]const u8, &argv) }, environment)
    var captured: [16384]u8 = undefined
    const captured_bytes: [*]u8 = &captured
    var ending = spawn.Ending.lost()
    const length = spawn.capture(&options, true, captured_bytes, 16384, &ending)
    if length < 0 { return 1 }
    const output = captured_bytes[0..@intCast(usize, length)]
    if ending.status() != 0 { return tell(output, 2) }

    // Each self-test said ok, in its line.
    var line: [96]u8 = undefined
    const line_bytes: [*]u8 = &line
    for name in TESTS {
        var at = std.text.append(line_bytes, 0, 96, "ok   ")
        at = std.text.append(line_bytes, at, 96, name)
        at = std.text.appendByte(line_bytes, at, 96, 10)
        if !std.text.contains(output, line_bytes[0..at]) { return tell(output, 3) }
    }
    // None failed, and the count is the list's.
    if std.text.contains(output, "FAIL") { return tell(output, 4) }
    if !std.text.contains(output, "framework self-tests: 33 passed, 0 failed\n") { return tell(output, 5) }
    if !std.text.contains(output, "built by our toolchain") { return tell(output, 6) }

    // The program is mlxlibc's, and nothing in it is another compiler's
    // (GCC and clang name themselves in each object's .comment).
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const loaded = std.fs.readFileAlloc(PROGRAM.pointer, allocator)
    if loaded == null { return 7 }
    const program = loaded.?
    const bytes = program.items[0..program.length]
    if bytes.length < 64 || bytes[0] != 127 || bytes[1] != 69 { return 8 }
    if !std.text.contains(bytes, "/libc/libmlxc.so.1") { return 9 }
    if std.text.contains(bytes, "GCC: (") || std.text.contains(bytes, "clang version") { return 10 }
    std.fs.ArrayList.deinit(program)
    return 13
}
