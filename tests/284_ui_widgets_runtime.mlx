// std.ui's widgets on a CPU canvas, driven like a platform drives them:
// the pointer over a button lights it and a press and release there is a
// click (not one released elsewhere); a popup's frame takes the pointer
// from what is under it; check rows, switches and segments; a text field
// takes the focus by a click and edits by keys (typing, words, selection,
// Backspace); a scroll bar pages and is dragged; a tab's cross closes it;
// a row's parts (a check, a small button) take their clicks from the row;
// a split button's action and arrow are apart; a disabled back button
// takes no click, a crumb and a link do;
// regions are cut to a clip; text wraps. No fonts are needed (text is then
// not drawn). Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const field = @import("std.ui.field")
const scroll = @import("std.ui.scroll")
const tabs = @import("std.ui.tabs")
const popup = @import("std.ui.popup")
const lists = @import("std.ui.lists")
const keys = @import("std.ui.keys")

const WIDTH: usize = 400
const HEIGHT: usize = 300

const State = struct {
    on: bool
    choice: usize
    clicks: usize
    popup: bool
    popupHits: usize
    closed: usize
    rowHits: usize
    partHits: usize
    miniHits: usize
    split: u8
    backs: usize
    crumbs: usize
    links: usize
}

fn frame(context: *view.Ui, canvas: *canvas_module.Canvas, state: *State, search: *field.Field, list: *scroll.Scroll) -> bool {
    view.begin(context, canvas)
    canvas_module.clear(canvas, context.*.theme.*.background)
    if controls.button(context, view.id("ok"), ui.rect(10, 10, 80, 30), "OK", controls.BUTTON_NORMAL, true) { state.*.clicks += 1 }
    if controls.checkRow(context, view.id("check"), ui.rect(10, 50, 120, 20), "Shown", if state.*.on { controls.CHECK_ON } else { controls.CHECK_OFF }) { state.*.on = !state.*.on }
    if controls.switchToggle(context, view.id("switch"), 150, 50, state.*.on) { state.*.on = !state.*.on }
    var segment: usize = 0
    while segment < 2 {
        if controls.segment(context, view.idOf(view.id("segment"), segment), ui.rect(10 + @intCast(i32, segment) * 60, 80, 60, 24), "S", state.*.choice == segment, 0) { state.*.choice = segment }
        segment += 1
    }
    const clicked_field = field.textField(context, view.id("search"), ui.rect(10, 120, 200, 30), search, "Search", true)
    // A list of 40 rows of 20 in a 100 high view, cut to it.
    const area = ui.rect(220, 10, 150, 100)
    scroll.setSize(list, 40 * 20, area.height)
    const wheeled = scroll.wheelIn(context, list, area, 60)
    view.pushClip(context, area)
    var row = scroll.firstRow(list, 20)
    while row < scroll.endRow(list, 20, 40) {
        const chosen = lists.row(context, view.idOf(view.id("row"), row), ui.rect(area.x, scroll.rowTop(list, area, 20, row), area.width - scroll.BAR, 20), "row", "", false, 0, 0)
        row += 1
    }
    view.popClip(context)
    const moved = scroll.bar(context, view.id("bar"), scroll.barArea(area), list)
    if tabs.tab(context, view.id("tab"), view.id("tab close"), ui.rect(10, 170, 120, 28), "file.mlx", true, false, context.*.theme.*.background) == tabs.TAB_CLOSED { state.*.closed += 1 }
    // A row with parts: its check box and a small button take their own
    // clicks.
    if lists.rowBackground(context, view.id("parts"), ui.rect(10, 210, 200, 24), false, false) { state.*.rowHits += 1 }
    if lists.part(context, view.id("part"), ui.rect(10, 210, 24, 24)) { state.*.partHits += 1 }
    if controls.miniButton(context, view.id("mini"), ui.rect(186, 212, 20, 20)) { state.*.miniHits += 1 }
    const split = controls.splitButton(context, view.id("build"), view.id("build menu"), ui.rect(230, 210, 120, 28), 24, false, context.*.theme.*.button)
    if split != controls.SPLIT_NONE { state.*.split = split }
    if controls.chevronButton(context, view.id("back"), ui.rect(10, 250, 30, 28), true, false) { state.*.backs += 1 }
    if controls.crumb(context, view.id("crumb"), ui.rect(50, 250, 60, 20), context.*.small, "std", false) { state.*.crumbs += 1 }
    if controls.link(context, view.id("link"), ui.rect(120, 250, 60, 18), context.*.small, "2 uses", context.*.theme.*.dim) { state.*.links += 1 }
    if state.*.popup {
        popup.frame(context, view.id("popup"), ui.rect(0, 0, 120, 60))
        if popup.item(context, view.id("item"), ui.rect(4, 4, 112, 26), "Item", "Ctrl+I", true) { state.*.popupHits += 1 }
    }
    return view.end(context)
}

fn pixel(canvas: *canvas_module.Canvas, x: usize, y: usize) -> u32 { return canvas.*.pixels[y * WIDTH + x] }

// Moves, presses and lets go at (x, y), drawing in between as an app does.
fn click(context: *view.Ui, canvas: *canvas_module.Canvas, state: *State, search: *field.Field, list: *scroll.Scroll, x: i32, y: i32) -> u64 {
    const moved = view.pointerMove(context, x, y)
    var again = frame(context, canvas, state, search, list)
    const pressed = view.pointerButton(context, true)
    again = frame(context, canvas, state, search, list)
    const released = view.pointerButton(context, false)
    // Drawn again while a widget took what changed.
    var turns: usize = 0
    while frame(context, canvas, state, search, list) && turns < 4 { turns += 1 }
    return released
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var memory = allocator.alloc(WIDTH * HEIGHT * 4, 16).?
    var canvas: canvas_module.Canvas = undefined
    unsafe { canvas.pixels = @ptrCast([*]u32, memory) }
    canvas.width = WIDTH
    canvas.height = HEIGHT
    canvas.device = 0
    canvas.opacity = 255
    var theme = theme_module.dark()
    var font: text_module.Text = undefined
    font.loaded = false
    font.ascent = 12
    var context: view.Ui = undefined
    view.init(&context, &theme, &font, &font, &font)
    var state = State.{ .on = false, .choice = 0, .clicks = 0, .popup = false, .popupHits = 0, .closed = 0, .rowHits = 0, .partHits = 0, .miniHits = 0, .split = 0, .backs = 0, .crumbs = 0, .links = 0 }
    var search: field.Field = undefined
    field.clear(&search)
    var list: scroll.Scroll = undefined
    scroll.init(&list)
    var again = frame(&context, &canvas, &state, &search, &list)

    // The button: lit under the pointer; a click; a press let go elsewhere
    // is none.
    if pixel(&canvas, 50, 25) != theme.button { return 1 }
    if !view.pointerMove(&context, 50, 25) || context.hover != view.id("ok") { return 2 }
    again = frame(&context, &canvas, &state, &search, &list)
    if pixel(&canvas, 50, 25) != theme.buttonHover { return 3 }
    if click(&context, &canvas, &state, &search, &list, 50, 25) != view.id("ok") || state.clicks != 1 { return 4 }
    const pressed = view.pointerButton(&context, true)
    const moved = view.pointerMove(&context, 300, 290)
    if view.pointerButton(&context, false) != view.NONE { return 5 }
    again = frame(&context, &canvas, &state, &search, &list)
    if state.clicks != 1 { return 6 }

    // Check row and switch both flip the same setting; segments choose.
    const checked = click(&context, &canvas, &state, &search, &list, 60, 60)
    if !state.on { return 9 }
    if pixel(&canvas, 21, 64) != theme.accent { return 10 }
    const switched = click(&context, &canvas, &state, &search, &list, 170, 60)
    if state.on { return 11 }
    const second = click(&context, &canvas, &state, &search, &list, 100, 90)
    if state.choice != 1 { return 12 }

    // The text field: a click gives it the focus; typing, a word back,
    // Shift+Home selecting, Backspace.
    const into = click(&context, &canvas, &state, &search, &list, 100, 135)
    if !view.hasFocus(&context, view.id("search")) { return 20 }
    if field.fieldKey(&search, 30, 0, "hello") != field.KEY_EDITED { return 21 }
    var result = field.fieldKey(&search, 57, 0, " wörld")
    if !std.text.same(field.text(&search), "hello wörld") { return 22 }
    result = field.fieldKey(&search, keys.LEFT, keys.CONTROL, "")
    if search.cursor != 6 { return 23 }
    result = field.fieldKey(&search, keys.HOME, keys.SHIFT, "")
    if field.selectionStart(&search) != 0 || field.selectionEnd(&search) != 6 { return 24 }
    result = field.fieldKey(&search, keys.BACKSPACE, 0, "")
    if !std.text.same(field.text(&search), "wörld") { return 25 }
    result = field.fieldKey(&search, keys.END, 0, "")
    result = field.fieldKey(&search, keys.BACKSPACE, 0, "")
    result = field.fieldKey(&search, keys.BACKSPACE, 0, "")
    if !std.text.same(field.text(&search), "wör") { return 26 }
    result = field.fieldKey(&search, keys.BACKSPACE, 0, "")
    if !std.text.same(field.text(&search), "wö") { return 27 }
    result = field.fieldKey(&search, keys.BACKSPACE, 0, "")
    if !std.text.same(field.text(&search), "w") || field.fieldKey(&search, keys.ENTER, 0, "") != field.KEY_SUBMIT { return 28 }

    // The list: the wheel scrolls, rows under the clip are not hit, the bar
    // pages and drags.
    var hit = view.hitAt(&context, 260, 20)
    if hit != view.idOf(view.id("row"), 0) { return 30 }
    if view.hitAt(&context, 260, 120) != view.NONE { return 31 }
    const moved2 = view.pointerMove(&context, 260, 20)
    const wheeled = view.wheel(&context, 2)
    again = frame(&context, &canvas, &state, &search, &list)
    if list.offset != 120 { return 32 }
    if view.hitAt(&context, 260, 20) != view.idOf(view.id("row"), 6) { return 33 }
    const paged = click(&context, &canvas, &state, &search, &list, 365, 105)
    if list.offset != 220 { return 34 }
    const grab = view.pointerMove(&context, 365, 40)
    again = frame(&context, &canvas, &state, &search, &list)
    const down = view.pointerButton(&context, true)
    again = frame(&context, &canvas, &state, &search, &list)
    const drag = view.pointerMove(&context, 365, 50)
    again = frame(&context, &canvas, &state, &search, &list)
    const up = view.pointerButton(&context, false)
    if list.offset <= 220 { return 35 }

    // The tab's cross closes it.
    const closed = click(&context, &canvas, &state, &search, &list, 112, 184)
    if state.closed != 1 { return 40 }

    // The row's parts: the check box, the middle, the small button (lit
    // under the pointer).
    const on_part = click(&context, &canvas, &state, &search, &list, 20, 220)
    if state.partHits != 1 || state.rowHits != 0 { return 41 }
    const on_row = click(&context, &canvas, &state, &search, &list, 100, 220)
    if state.rowHits != 1 || pixel(&canvas, 100, 222) != theme.hover { return 42 }
    const on_mini = click(&context, &canvas, &state, &search, &list, 196, 222)
    if state.miniHits != 1 || state.rowHits != 1 || pixel(&canvas, 196, 222) != theme.buttonHover { return 43 }

    // The split button: its action, then its arrow.
    const on_main = click(&context, &canvas, &state, &search, &list, 260, 224)
    if state.split != controls.SPLIT_MAIN { return 44 }
    const on_menu = click(&context, &canvas, &state, &search, &list, 340, 224)
    if state.split != controls.SPLIT_MENU || pixel(&canvas, 340, 214) != theme.buttonHover { return 45 }

    // Back while there is nothing to go back to; a crumb; a link.
    const on_back = click(&context, &canvas, &state, &search, &list, 25, 264)
    if state.backs != 0 || view.hitAt(&context, 25, 264) != view.NONE { return 46 }
    const on_crumb = click(&context, &canvas, &state, &search, &list, 80, 260)
    if state.crumbs != 1 || pixel(&canvas, 80, 260) != theme.button { return 47 }
    const on_link = click(&context, &canvas, &state, &search, &list, 150, 259)
    if state.links != 1 { return 48 }

    // The popup lies over the button: a click there is the item's.
    state.popup = true
    again = frame(&context, &canvas, &state, &search, &list)
    if view.hitAt(&context, 50, 45) != view.id("popup") || view.hitAt(&context, 50, 25) != view.id("item") { return 50 }
    const item = click(&context, &canvas, &state, &search, &list, 50, 15)
    if state.popupHits != 1 || state.clicks != 1 { return 51 }

    // Wrapping: three words in a narrow box need three lines.
    var wide: text_module.Text = undefined
    if text_module.loadText(&wide, 14, allocator) {
        if popup.wrappedHeight(&wide, "one two three", text_module.measure(&wide, "three") + 2, 10, 9) != 30 { return 60 }
    }
    return 13
}
