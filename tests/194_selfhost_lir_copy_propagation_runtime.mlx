const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../compiler/selfhost/ir/optimize.mlx")

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    var ir = lir.init(allocator)
    const original = lir.addInst(&ir, lir.initInst(lir.Opcode.param, lir.NONE))
    var copy_inst = lir.initInst(lir.Opcode.copy, lir.NONE)
    copy_inst.arg0 = original
    const first_copy = lir.addInst(&ir, copy_inst)
    copy_inst.arg0 = first_copy
    const second_copy = lir.addInst(&ir, copy_inst)
    const returned = lir.addInst(&ir, lir.retInst(lir.NONE, second_copy))

    const result = optimize.run(&ir, allocator)
    if result.copiesPropagated != 2 { return 1 }
    if lir.getInst(&ir, returned).arg0 != original { return 2 }
    if lir.getInst(&ir, first_copy).opcode != lir.Opcode.dead { return 3 }
    if lir.getInst(&ir, second_copy).opcode != lir.Opcode.dead { return 4 }
    lir.deinit(&ir)
    return 13
}
