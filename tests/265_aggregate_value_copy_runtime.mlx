// Structs and arrays are values: a `var` or `const` made from another
// value, and a value assigned to a variable, are copies, so changing them,
// or changing what they were made from afterwards, leaves the other alone,
// whether it was a const or var local, a call result, a field reached
// through a pointer, or an array element. They used to share the
// original's storage. An array literal of structs holds the elements'
// bytes, not their addresses. Exits 13.
const P = struct { x: i32, y: i32 }
const S = struct { p: P, n: i32 }

fn make(x: i32) -> P { return P.{ .x = x, .y = 2 } }

// Returns the field itself (its storage), not a new value.
fn get(s: *S) -> P { return s.*.p }

// Takes a parameter by value and changes a copy of it.
fn bumped(p: P) -> i32 {
    var copy = p
    copy.x = copy.x + 1
    return copy.x
}

// Returns a copy of an element reached through a pointer, then clears the
// element: a `const` used to alias the element and read the cleared value.
fn takeAt(slots: *[2]P, index: usize) -> P {
    const copy = slots.*[index]
    slots.*[index] = P.{ .x = 0, .y = 0 }
    return copy
}

const R = struct { x: i32, y: i32, w: i32, h: i32 }
const Holder = struct { r: R, tag: i32 }

// The same through a field, with a struct of several fields.
fn takeRect(holder: *Holder) -> R {
    const r = holder.*.r
    holder.*.r = R.{ .x = 0, .y = 0, .w = 0, .h = 0 }
    return r
}

const Outer = struct { inner: P, n: i32 }

// A `const` copy lives in the callee's frame: handed back through a field
// path, through a call given the copy, or as a slice into it, the value is
// copied out first.
fn innerOf(o: *Outer) -> P {
    const copy = o.*
    return copy.inner
}

fn same(p: P) -> P { return p }

fn viaCall(o: *Outer) -> P {
    const copy = o.*.inner
    return same(copy)
}

fn firstTwo(list: *[3]P) -> []P {
    const copy = list.*
    return copy[0..2]
}

pub fn main() -> u8 {
    const a = make(5)
    var b = a
    b.x = 9
    if a.x != 5 || b.x != 9 { return 1 }
    const c = P.{ .x = 5, .y = 2 }
    var d = c
    d.x = 9
    if c.x != 5 { return 2 }
    var e = make(5)
    var f = e
    f.x = 9
    if e.x != 5 { return 3 }
    var s = S.{ .p = P.{ .x = 1, .y = 2 }, .n = 0 }
    var through = get(&s)
    through.y = 7
    if s.p.y != 2 { return 4 }
    var field = s.p
    field.x = 3
    if s.p.x != 1 { return 5 }
    // Assignment copies too, and later changes stay with the variable.
    var h = make(7)
    h = a
    h.x = 1
    if a.x != 5 || h.y != 2 { return 6 }
    var list: [3]P = undefined
    list[0] = make(1)
    list[1] = make(2)
    list[2] = make(3)
    var item = list[1]
    item.x = 0
    if list[1].x != 2 { return 7 }
    if bumped(a) != 6 || a.x != 5 { return 8 }
    // Arrays are values as well.
    var numbers: [3]u32 = [3]u32{ 1, 2, 3 }
    var others = numbers
    others[0] = 9
    if numbers[0] != 1 { return 9 }
    // A copy made in a loop is new each time.
    var total: i32 = 0
    var round: i32 = 0
    while round < 3 {
        var step = a
        step.x = step.x + round
        total = total + step.x
        round += 1
    }
    if total != 18 || a.x != 5 { return 10 }
    // A `const` made from an element or a field reached through a pointer
    // is a copy too, so a store to the source afterwards leaves it alone.
    var slots: [2]P = [2]P{ P.{ .x = 1, .y = 2 }, P.{ .x = 3, .y = 4 } }
    const taken = takeAt(&slots, 1)
    if taken.x != 3 || taken.y != 4 || slots[1].x != 0 || slots[1].y != 0 { return 11 }
    var holder = Holder.{ .r = R.{ .x = 1, .y = 2, .w = 3, .h = 4 }, .tag = 9 }
    const rect = takeRect(&holder)
    if rect.x != 1 || rect.w != 3 || rect.h != 4 || holder.r.w != 0 { return 12 }
    // ... and from a local variable changed afterwards.
    var single = make(7)
    const before = single
    single.x = 0
    single = P.{ .x = 0, .y = 0 }
    if before.x != 7 || before.y != 2 { return 14 }
    // A copy made in a loop reads the source as it is each time.
    var seen: i32 = 0
    var pass: i32 = 0
    while pass < 3 {
        const snapshot = slots[0]
        slots[0].x = slots[0].x + 1
        seen = seen + snapshot.x
        pass += 1
    }
    if seen != 6 || slots[0].x != 4 { return 15 }
    // Copies handed back out of the callee's frame.
    var outer = Outer.{ .inner = P.{ .x = 5, .y = 6 }, .n = 1 }
    const inner = innerOf(&outer)
    const called = viaCall(&outer)
    if inner.x != 5 || inner.y != 6 || called.x != 5 || called.y != 6 { return 16 }
    var three: [3]P = [3]P{ make(1), make(2), make(3) }
    const head = firstTwo(&three)
    if head[0].x != 1 || head[1].x != 2 || head[1].y != 2 { return 17 }
    // An array literal of structs holds the elements' bytes.
    if three[2].x != 3 || three[0].y != 2 { return 18 }
    return 13
}
