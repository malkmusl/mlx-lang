// Structs and arrays are values: a `var` made from another value, and a
// value assigned to a variable, are copies, so changing them leaves the
// original alone, whether it was a const or var local, a call result, a
// field reached through a pointer, or an array element. They used to share
// the original's storage. Exits 13.
const P = struct { x: i32, y: i32 }
const S = struct { p: P, n: i32 }

fn make(x: i32) -> P { return P.{ .x = x, .y = 2 } }

// Returns the field itself (its storage), not a new value.
fn get(s: *S) -> P { return s.*.p }

// Takes a parameter by value and changes a copy of it.
fn bumped(p: P) -> i32 {
    var copy = p
    copy.x = copy.x + 1
    return copy.x
}

pub fn main() -> u8 {
    const a = make(5)
    var b = a
    b.x = 9
    if a.x != 5 || b.x != 9 { return 1 }
    const c = P.{ .x = 5, .y = 2 }
    var d = c
    d.x = 9
    if c.x != 5 { return 2 }
    var e = make(5)
    var f = e
    f.x = 9
    if e.x != 5 { return 3 }
    var s = S.{ .p = P.{ .x = 1, .y = 2 }, .n = 0 }
    var through = get(&s)
    through.y = 7
    if s.p.y != 2 { return 4 }
    var field = s.p
    field.x = 3
    if s.p.x != 1 { return 5 }
    // Assignment copies too, and later changes stay with the variable.
    var h = make(7)
    h = a
    h.x = 1
    if a.x != 5 || h.y != 2 { return 6 }
    var list: [3]P = undefined
    list[0] = make(1)
    list[1] = make(2)
    list[2] = make(3)
    var item = list[1]
    item.x = 0
    if list[1].x != 2 { return 7 }
    if bumped(a) != 6 || a.x != 5 { return 8 }
    // Arrays are values as well.
    var numbers: [3]u32 = [3]u32{ 1, 2, 3 }
    var others = numbers
    others[0] = 9
    if numbers[0] != 1 { return 9 }
    // A copy made in a loop is new each time.
    var total: i32 = 0
    var round: i32 = 0
    while round < 3 {
        var step = a
        step.x = step.x + round
        total = total + step.x
        round += 1
    }
    if total != 18 || a.x != 5 { return 10 }
    return 13
}
