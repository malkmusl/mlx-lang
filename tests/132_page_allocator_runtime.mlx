const bootstrap = @import("../std/bootstrap/root.mlx")

pub fn main() -> u8 {
    const page_allocator = bootstrap.page_allocator.init()
    const allocation = page_allocator.alloc(4096, 8)
    if allocation == null {
        return 1
    }
    const memory = allocation.?
    memory[0] = 13
    const result = memory[0]
    page_allocator.free(memory, 4096, 8)
    return result
}
