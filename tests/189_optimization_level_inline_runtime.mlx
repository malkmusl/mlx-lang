fn combine(left: u8, right: u8) -> u8 {
    return left + right
}

fn combineSix(a: u8, b: u8, c: u8, d: u8, e: u8, f: u8) -> u8 {
    return a + b + c + d + e + f
}

noinline fn identity(value: u8) -> u8 {
    return value
}

pub fn main() u8 {
    return identity(combine(combineSix(1, 2, 3, 4, 1, 1), 1))
}
