// Module-level `var`s whose initializers hold floats and addresses: a
// struct of floats, a table of functions (a translated C++ vtable), a
// string's bytes in a struct and in an array, the address of another
// global's element, a pointer and a function alone, floats alone. The
// bytes are static data (one address wherever the global is named); the
// addresses are written before main. Exits 13.

const Point = extern struct {
    x: f32
    y: f64
}

const Name = extern struct {
    data: ?[*]const u8
    length: u64
}

fn one() -> u64 { return 1 }
fn two() -> u64 { return 2 }

var point: Point = Point.{ .x = 1.5, .y = -2.25, }
var name: Name = Name.{ .data = unsafe { @ptrCast(?[*]const u8, "webgl_".pointer) }, .length = 6, }
var numbers: [4]i32 = [4]i32{ 3, 6, 11, 16 }
var table: [4]?[*]u8 = [4]?[*]u8{
    unsafe { @ptrCast(?[*]u8, one) },
    unsafe { @ptrCast(?[*]u8, two) },
    unsafe { @ptrFromInt(?[*]u8, 77) },
    null,
}
var names: [2]?[*]const u8 = [2]?[*]const u8{ "ab".pointer, "cd".pointer, }
var third: ?[*]i32 = &numbers[2]
var chosen: ?fn() -> u64 = two
var scale: f32 = -0.5
var wide: f64 = 4.0

fn tableAddress() -> usize { return @intFromPtr(&table[0]) }

fn elsewhere() -> usize {
    var filler: [64]u64 = undefined
    var k: usize = 0
    while k < 64 {
        filler[k] = 12345
        k += 1
    }
    return @intFromPtr(&table[0]) + filler[3] - 12345
}

pub fn main() -> u8 {
    var total: u64 = 0
    if tableAddress() == elsewhere() { total += 1 }
    const first = unsafe { @ptrCast(fn() -> u64, table[0].?) }
    const second = unsafe { @ptrCast(fn() -> u64, table[1].?) }
    total += first() + second() * 2
    total += @intFromPtr(table[2].?)
    if table[3] == null { total += 3 }
    total += @intCast(u64, name.data.?[0]) + name.length
    total += @intCast(u64, names[1].?[1])
    total += @intCast(u64, third.?[0])
    total += chosen.?()
    total += @intFromFloat(u64, point.x * 2.0)
    total += @intFromFloat(u64, 0.0 - point.y * 4.0)
    total += @intFromFloat(u64, wide - @floatCast(f64, scale) * 2.0)
    return @intCast(u8, total - 328)
}
