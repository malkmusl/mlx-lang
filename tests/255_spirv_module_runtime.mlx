// std.spirv: a module built with std.spirv.builder decodes and validates
// with std.spirv.module; corrupted copies are rejected with the right error,
// and so are small modules that break a block rule (a merge instruction not
// right before its branch, an unterminated block, an instruction after a
// block's end, a function variable after other instructions).
// With a file argument, the module is also written there (run_vulkan.sh
// checks it with spirv-val); with "--validate FILE" a module from another
// tool is validated instead. Exits 13.
const std = @import("std")
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")
const module = @import("std.spirv.module")
const doubler = @import("./support/spirv/doubler.mlx")

fn check(words: [*]u32, count: usize, expected: module.Error) -> bool {
    var diagnostic: module.Diagnostic = undefined
    const result = module.validate(words, count, std.page_allocator.init(), &diagnostic)
    return result == expected && diagnostic.code == expected
}

// A small compute shader with an if and a function variable, validated;
// `mistake` breaks one block rule: 1 an instruction between OpSelectionMerge
// and its branch, 2 a block without a branch at its end, 3 an instruction
// after the last block's return, 4 a function variable after another
// instruction.
fn blocks(mistake: u32) -> module.Error {
    const allocator = std.page_allocator.init()
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    builder.capability(&b, spv.Capability.shader)
    builder.memoryModel(&b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    const void_type = builder.typeVoid(&b)
    const function_type = builder.typeFunction(&b, void_type, null, 0)
    const boolean = builder.typeBool(&b)
    const uint = builder.typeInt(&b, 32, false)
    const pointer = builder.typePointer(&b, spv.StorageClass.function, uint)
    const yes = builder.constantBool(&b, boolean, true)
    const main = builder.function(&b, void_type, spv.FUNCTION_CONTROL_NONE, function_type)
    const entry = builder.label(&b)
    if mistake == 4 { const early = builder.unary(&b, spv.Op.logicalNot, boolean, yes) }
    const counter = builder.localVariable(&b, pointer)
    const then = builder.newId(&b)
    const merge = builder.newId(&b)
    if mistake == 1 {
        builder.selectionMerge(&b, merge)
        const late = builder.unary(&b, spv.Op.logicalNot, boolean, yes)
        builder.branchConditional(&b, late, then, merge)
    } else {
        const condition = builder.unary(&b, spv.Op.logicalNot, boolean, yes)
        builder.selectionMerge(&b, merge)
        builder.branchConditional(&b, condition, then, merge)
    }
    const then_label = builder.labelWith(&b, then)
    if mistake != 2 { builder.branch(&b, merge) }
    const merge_label = builder.labelWith(&b, merge)
    builder.returnVoid(&b)
    if mistake == 3 { const after = builder.unary(&b, spv.Op.logicalNot, boolean, yes) }
    builder.functionEnd(&b)
    var interfaces: [1]u32 = [1]u32{ 0 }
    unsafe { builder.entryPoint(&b, spv.ExecutionModel.glCompute, main, "main", @ptrCast([*]const u32, &interfaces), 0) }
    builder.localSize(&b, main, 1, 1, 1)
    const count = builder.wordCount(&b)
    const memory = allocator.alloc(count * 4, 4)
    if memory == null { return module.Error.outOfMemory }
    var words: [*]u32 = undefined
    unsafe { words = @ptrCast([*]u32, memory.?) }
    builder.writeWords(&b, words)
    var diagnostic: module.Diagnostic = undefined
    return module.validate(words, count, allocator, &diagnostic)
}

fn validateFile(path: [*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return 40 }
    const contents = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    if contents.length % 4 != 0 { return 41 }
    var words: [*]u32 = undefined
    unsafe { words = @ptrCast([*]u32, contents.items) }
    var diagnostic: module.Diagnostic = undefined
    const result = module.validate(words, contents.length / 4, allocator, &diagnostic)
    if result != module.Error.none {
        const ignored = std.io.writeAll(std.io.stderr(), module.errorMessage(result))
        const newline = std.io.writeAll(std.io.stderr(), "\n")
        return 42
    }
    return 13
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    if std.process.count(arguments) > 2 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--validate")) {
        return validateFile(std.process.argument(arguments, 2).pointer)
    }
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    doubler.build(&b)
    const count = builder.wordCount(&b)
    const memory = allocator.alloc(count * 4, 4)
    if memory == null { return 1 }
    var words: [*]u32 = undefined
    unsafe { words = @ptrCast([*]u32, memory.?) }
    builder.writeWords(&b, words)
    if words[0] != 119734787 || words[1] != 66304 || words[4] != 0 { return 2 }

    var header: module.Header = undefined
    if module.readHeader(words, count, &header) != module.Error.none || header.bound != b.nextId { return 3 }
    // Walk the instructions: the first is OpCapability Shader.
    var position: usize = 5
    var instruction: module.Instruction = undefined
    var step = module.Error.none
    var instructions: usize = 0
    var saw_entry = false
    while module.nextInstruction(words, count, &position, &instruction, &step) {
        if instructions == 0 && (instruction.opcode != 17 || instruction.words[1] != 1) { return 4 }
        if instruction.opcode == @intCast(u32, @intFromEnum(spv.Op.entryPoint)) { saw_entry = true }
        instructions += 1
    }
    if step != module.Error.none || !saw_entry || instructions < 30 { return 5 }
    if !check(words, count, module.Error.none) { return 6 }

    // Write the module for spirv-val when asked.
    if std.process.count(arguments) > 1 {
        const file = std.fs.open(std.process.argument(arguments, 1).pointer, 577, 420)
        if !std.fs.isValid(file) { return 7 }
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrCast([*]const u8, words) }
        if !std.fs.writeAllBytes(file, bytes, count * 4) { return 8 }
        const closed = std.fs.close(file)
    }

    // Corruptions.
    words[0] = 50471687 // byte-swapped magic
    if !check(words, count, module.Error.badMagic) { return 20 }
    words[0] = spv.MAGIC_NUMBER
    words[1] = spv.version(1, 9)
    if !check(words, count, module.Error.unsupportedVersion) { return 21 }
    words[1] = spv.version(1, 3)
    words[3] = 0
    if !check(words, count, module.Error.badBound) { return 22 }
    words[3] = b.nextId
    // The last instruction (OpFunctionEnd) claiming two words runs past the end;
    // without it the function is unterminated.
    const last = words[count - 1]
    words[count - 1] = (2 << 16) | 56
    if !check(words, count, module.Error.truncatedInstruction) { return 23 }
    words[count - 1] = last
    if !check(words, count - 1, module.Error.unterminatedFunction) { return 31 }
    // The OpMemoryModel instruction (words 7..9) moved before OpCapability.
    const capability0 = words[5]
    const capability1 = words[6]
    words[5] = words[7]
    words[6] = words[8]
    words[7] = words[9]
    words[8] = capability0
    words[9] = capability1
    if !check(words, count, module.Error.layoutOrder) { return 24 }
    words[7] = words[6]
    words[6] = words[5]
    words[5] = capability0
    words[8] = words[6]
    words[9] = words[7]
    words[6] = capability1
    words[7] = (3 << 16) | 14
    if !check(words, count, module.Error.none) { return 25 }
    // OpCapability with an extra operand word swallows the next instruction.
    words[5] = (3 << 16) | 17
    if !check(words, count, module.Error.extraOperands) && !check(words, count, module.Error.unknownOpcode) { return 26 }
    words[5] = (2 << 16) | 17
    // An unknown opcode, and a zero word count.
    words[5] = (2 << 16) | 65000
    if !check(words, count, module.Error.unknownOpcode) { return 27 }
    words[5] = 17
    if !check(words, count, module.Error.zeroWordCount) { return 28 }
    words[5] = (2 << 16) | 17
    if !check(words, count, module.Error.none) { return 29 }
    // A result id at the bound.
    words[3] = 3
    if !check(words, count, module.Error.idOutOfBound) { return 30 }
    words[3] = b.nextId

    // Block rules.
    if blocks(0) != module.Error.none { return 32 }
    if blocks(1) != module.Error.mergeNotBeforeBranch { return 33 }
    if blocks(2) != module.Error.unterminatedBlock { return 34 }
    if blocks(3) != module.Error.instructionOutsideBlock { return 35 }
    if blocks(4) != module.Error.variableNotFirst { return 36 }
    return 13
}
