const lexer = @import("../compiler/selfhost/lexer.zin")
const parser_module = @import("../compiler/selfhost/parser.zin")
const types = @import("../compiler/selfhost/types.zin")
const symbols = @import("../compiler/selfhost/symbols.zin")
const sema = @import("../compiler/selfhost/sema.zin")
const comptime_module = @import("../compiler/selfhost/comptime.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

pub fn main() -> u8 {
    const source = "const base = 2 + 3 * 4\nconst selected = if base == 14 { 21 } else { 34 }\nconst bytes = @sizeOf([4]u16)\nconst predicate = @isInteger(u13)\nfn value() -> u8 { const local = base + 1\nreturn local }\n"
    const allocator = page_allocator.init()
    const tokens = lexer.scanAll(allocator, source)
    var nodes = parser_module.initStore(allocator, tokens.length * 2)
    var parser = parser_module.init(source, tokens, &nodes)
    const root = parser_module.parse(&parser)
    if parser.errorCount != 0 { return 1 }
    var type_store = types.init(allocator)
    var symbol_store = symbols.initStore(allocator, 16)
    var root_scope = symbols.initRootScope(allocator, 8)
    if symbols.collectRoot(source, tokens, &nodes, root, &symbol_store, &root_scope) != 0 { return 2 }
    if sema.analyzeDeclarations(source, tokens, &nodes, root, &type_store, &symbol_store, &root_scope) != 0 { return 3 }
    const first_declaration = parser_module.nodeAt(&nodes, root).lhs
    const first_initializer = parser_module.nodeAt(&nodes, first_declaration).rhs
    if comptime_module.isValid(comptime_module.evaluate(source, tokens, &nodes, &type_store, &symbol_store, &root_scope, first_initializer, 1)) { return 10 }
    const integer_tag = @intCast(u8, @intFromEnum(comptime_module.Kind.integer))
    const boolean_tag = @intCast(u8, @intFromEnum(comptime_module.Kind.boolean))
    if symbols.symbolAt(&symbol_store, 0).*.comptimeTag != integer_tag || symbols.symbolAt(&symbol_store, 0).*.comptimeInteger != 14 { return 4 }
    if symbols.symbolAt(&symbol_store, 1).*.comptimeInteger != 21 { return 5 }
    if symbols.symbolAt(&symbol_store, 2).*.comptimeInteger != 8 { return 6 }
    if symbols.symbolAt(&symbol_store, 3).*.comptimeTag != boolean_tag || symbols.symbolAt(&symbol_store, 3).*.comptimeInteger != 1 { return 7 }
    if sema.analyzeFunctionBodies(source, tokens, &nodes, root, &type_store, &symbol_store, &root_scope) != 0 { return 8 }
    const local = symbols.symbolAt(&symbol_store, symbol_store.length - 1)
    if local.*.comptimeTag != integer_tag || local.*.comptimeInteger != 15 { return 9 }
    symbols.deinitScope(&root_scope)
    symbols.deinitStore(&symbol_store)
    types.deinit(&type_store)
    parser_module.deinitStore(&nodes)
    lexer.deinit(tokens)
    return 13
}
