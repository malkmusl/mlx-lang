// std.timezone without zone files: the civil calendar both ways (1970,
// before it, 2000-03-01), and a POSIX rule from $TZ
// ("CET-1CEST,M3.5.0,M10.5.0/3", no file of that name): winter and summer
// offsets and the switch on the last Sunday of March 2026 at 01:00 UTC to
// the second. Exits 13.
const std = @import("std")
const timezone = @import("std.timezone")

pub fn main(arguments: [][*]const u8) -> u8 {
    const epoch = timezone.civil(0)
    if epoch.year != 1970 || epoch.month != 1 || epoch.day != 1 || epoch.weekday != 4 { return 1 }
    const before = timezone.civil(-1)
    if before.year != 1969 || before.month != 12 || before.day != 31 || before.weekday != 3 || before.hour != 23 || before.second != 59 { return 2 }
    if timezone.daysFromCivil(2000, 3, 1) != 11017 { return 3 }
    const leap = timezone.civil(timezone.daysFromCivil(2024, 2, 29) * 86400 + 3723)
    if leap.month != 2 || leap.day != 29 || leap.hour != 1 || leap.minute != 2 || leap.second != 3 { return 4 }

    var environment: [2][*]const u8 = undefined
    unsafe {
        environment[0] = @ptrCast([*]const u8, "TZ=CET-1CEST,M3.5.0,M10.5.0/3\0")
        environment[1] = @ptrFromInt([*]const u8, 0)
    }
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(timezone.Zone), 8)
    if memory == null { return 5 }
    var zone: *timezone.Zone = undefined
    var list: [*][*]const u8 = undefined
    unsafe {
        zone = @ptrCast(*timezone.Zone, memory.?)
        list = @ptrCast([*][*]const u8, &environment)
    }
    timezone.load(zone, list, allocator)
    const winter = timezone.daysFromCivil(2026, 1, 15) * 86400 + 43200
    if timezone.offsetAt(zone, winter) != 3600 { return 6 }
    const summer = timezone.daysFromCivil(2026, 7, 1) * 86400 + 43200
    if timezone.offsetAt(zone, summer) != 7200 { return 7 }
    const switch_at = timezone.daysFromCivil(2026, 3, 29) * 86400 + 3600
    if timezone.offsetAt(zone, switch_at - 1) != 3600 || timezone.offsetAt(zone, switch_at) != 7200 { return 8 }
    const local = timezone.civil(summer + timezone.offsetAt(zone, summer))
    if local.hour != 14 || local.weekday != 3 { return 9 }
    if timezone.now() < 1700000000 { return 10 }
    return 13
}
