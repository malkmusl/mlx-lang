// A struct declaring the same field name twice is rejected
// (MLX-E3002, duplicate field name); it used to compile, with both fields
// laid out and every access reaching one of them.
const Bar = struct {
    items: [12]u8,
    count: usize,
    items: u32
}

pub fn main() -> u8 {
    var bar: Bar = undefined
    bar.count = 0
    return 0
}
