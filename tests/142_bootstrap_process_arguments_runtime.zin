const process = @import("../std/bootstrap/process.zin")
const string = @import("../std/bootstrap/string.zin")

pub fn main(arguments: [][*]const u8) -> u8 {
    if process.count(arguments) != 3 { return 1 }
    if process.argument(arguments, 0).length == 0 { return 2 }
    if !string.eql(process.argument(arguments, 1), string.fromSlice("first")) { return 3 }
    if !string.eql(process.argument(arguments, 2), string.fromSlice("second")) { return 4 }
    if process.argument(arguments, 3).length != 0 { return 5 }
    return 13
}
