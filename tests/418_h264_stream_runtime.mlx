// std.h264: WebKit's test.mp4 (projects/webkit/upstream/Tools/
// TestWebKitAPI/Resources, 320x240 H.264 with B frames, 182 access
// units) read through std.mp4: the parameter sets into the Vulkan video
// registry's structures, every access unit's picture (its slot, the
// StdVideoDecodeH264PictureInfo, the reference slots, the slices), the
// DPB's output order against the file's presentation times (ctts),
// flushing; before that a 1280x720 High profile SPS/PPS alone, NAL
// units in Annex B framing and a cut SPS refused.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const mp4 = @import("std.mp4")
const h264 = @import("std.h264")
const video = @import("std.vulkan.video")
const fs = @import("../std/bootstrap/fs.mlx")


// The SPS and PPS of a 1280x720 High profile level 3.1 stream
// (Chromium's bear-1280x720.mp4): POC type 0, 4 reference frames, one
// frame of reordering by its VUI.
var sps = [25]u8{0x67, 0x64, 0x00, 0x1f, 0xac, 0x34, 0xe5, 0x01, 0x40, 0x16, 0xec, 0x04, 0x40, 0x00, 0x00, 0x19, 0x00, 0x00, 0x05, 0xda, 0xa3, 0xc6, 0x0c, 0x45, 0x80}
var pps = [5]u8{0x68, 0xee, 0xb2, 0xc8, 0xb0}
// The two as an Annex B stream with a slice NAL after them.
var annexB = [41]u8{0, 0, 0, 1, 0x67, 0x64, 0x00, 0x1f, 0xac, 0x34, 0xe5, 0x01, 0x40, 0x16, 0xec, 0x04, 0x40, 0x00, 0x00, 0x19, 0x00, 0x00, 0x05, 0xda, 0xa3, 0xc6, 0x0c, 0x45, 0x80, 0, 0, 1, 0x68, 0xee, 0xb2, 0xc8, 0xb0, 0, 0, 1, 0x65}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const decoder = h264.create(allocator)
    if decoder == null { return 1 }
    const h = decoder.?

    // The parameter sets alone.
    if h264.parameterSet(h, &sps, 25) != h264.Status.ok { return 2 }
    if h264.parameterSet(h, &pps, 5) != h264.Status.ok { return 3 }
    const bear = h264.spsAt(h, 0)
    if !bear.*.present || bear.*.std.profile_idc != 100 || bear.*.std.level_idc != video.STD_VIDEO_H264_LEVEL_IDC_3_1 { return 4 }
    if bear.*.width != 1280 || bear.*.height != 720 || bear.*.std.pic_order_cnt_type != 0 || bear.*.std.max_num_ref_frames != 4 { return 5 }
    if bear.*.dpbFrames != 4 || bear.*.reorderFrames != 1 || bear.*.vui.flags.bits0 & video.StdVideoH264SpsVuiFlags_bitstream_restriction_flag == 0 { return 6 }
    if !h264.ppsAt(h, 0).*.present || h264.ppsAt(h, 0).*.spsId != 0 { return 6 }
    // Annex B framing: three NAL units.
    var at: usize = 0
    var nal: h264.Nal = undefined
    if !h264.nextAnnexB(&annexB, 41, &at, &nal) || nal.kind != h264.NAL_SPS || nal.length != 25 { return 7 }
    if !h264.nextAnnexB(&annexB, 41, &at, &nal) || nal.kind != h264.NAL_PPS || nal.length != 5 { return 8 }
    if !h264.nextAnnexB(&annexB, 41, &at, &nal) || nal.kind != h264.NAL_SLICE_IDR || nal.length != 1 || nal.refIdc != 3 { return 9 }
    if h264.nextAnnexB(&annexB, 41, &at, &nal) { return 10 }
    // Damage: an SPS cut to its first bytes.
    if h264.parameterSet(h, &sps, 8) == h264.Status.ok { return 11 }

    // The file.
    const loaded = fs.readFileAlloc("projects/webkit/upstream/Tools/TestWebKitAPI/Resources/test.mp4\x00".pointer, allocator)
    if loaded == null { return 12 }
    const contents = loaded.?
    const data: [*]const u8 = unsafe { @ptrCast([*]const u8, contents.items) }
    var movie: mp4.Movie = undefined
    mp4.init(&movie, allocator)
    var samples: mp4.Samples = undefined
    mp4.initSamples(&samples, allocator)
    var used: usize = 0
    if mp4.parse(&movie, data, contents.length, &samples, &used) != mp4.Status.ok { return 14 }
    const index = mp4.trackOfKind(&movie, mp4.KIND_VIDEO)
    if index >= mp4.MAX_TRACKS { return 15 }
    const track = mp4.track(&movie, index)
    if track.*.codec != mp4.CODEC_H264 || track.*.nalLengthSize != 4 { return 16 }
    var set: []const u8 = undefined
    var sets: usize = 0
    while mp4.parameterSet(track, sets, &set) {
        if h264.parameterSet(h, &set[0], set.length) != h264.Status.ok { return 17 }
        sets += 1
    }
    if sets != 2 { return 18 }
    const main_ = h264.spsAt(h, 0)
    if main_.*.width != 320 || main_.*.height != 240 || main_.*.std.profile_idc != 77 { return 19 }
    if main_.*.dpbFrames != 7 || main_.*.reorderFrames != 7 || main_.*.std.max_num_ref_frames == 0 { return 20 }
    if main_.*.std.flags.bits0 & video.StdVideoH264SpsFlags_frame_mbs_only_flag == 0 { return 21 }
    const picturePps = h264.ppsAt(h, 0)
    // CAVLC, not CABAC.
    if picturePps.*.std.flags.bits0 & video.StdVideoH264PpsFlags_entropy_coding_mode_flag != 0 { return 22 }

    var slotPts: [h264.SLOTS]i64 = undefined
    var pictures: usize = 0
    var outputs: usize = 0
    var lastPts: i64 = -1
    var idrs: usize = 0
    var slot: usize = 0
    var poc: i32 = 0
    var sample: mp4.Sample = undefined
    while mp4.nextSample(&movie, index, &sample) {
        if h264.accessUnit(h, &data[sample.offset], sample.size, 4) != h264.Status.ok { return 23 }
        const picture = &h.*.picture
        if picture.*.slot >= h264.SLOTS || picture.*.sliceCount == 0 || picture.*.width != 320 || picture.*.height != 240 { return 24 }
        if picture.*.isIdr {
            idrs += 1
            if !sample.sync || picture.*.referenceCount != 0 || picture.*.info.flags.bits0 & video.StdVideoDecodeH264PictureInfoFlags_IdrPicFlag == 0 { return 25 }
        }
        if picture.*.referenceCount > 3 { return 26 }
        if picture.*.sliceOffsets[0] < 4 || picture.*.sliceLengths[0] == 0 || @intCast(usize, picture.*.sliceOffsets[0] + picture.*.sliceLengths[0]) > sample.size { return 27 }
        slotPts[picture.*.slot] = sample.pts
        pictures += 1
        h264.finishPicture(h)
        while h264.nextOutput(h, &slot, &poc) {
            if slotPts[slot] <= lastPts { return 28 }
            lastPts = slotPts[slot]
            outputs += 1
        }
    }
    h264.flush(h)
    while h264.nextOutput(h, &slot, &poc) {
        if slotPts[slot] <= lastPts { return 29 }
        lastPts = slotPts[slot]
        outputs += 1
    }
    if pictures != 182 || outputs != 182 || idrs == 0 { return 30 }
    if h.*.decoded != 182 { return 31 }
    fs.ArrayList.deinit(contents)
    mp4.deinitSamples(&samples)
    mp4.deinit(&movie)
    h264.destroy(h)
    return 13
}
