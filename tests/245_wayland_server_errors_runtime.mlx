// std.wayland.server protocol-error handling, driven by raw wire messages:
// a request to an unknown object, an unknown opcode, a bind above the
// global's version, and a malformed string each get wl_display.error with
// the libwayland error code, and the server then disconnects that client.
// A well-formed wl_display.sync is answered with callback.done and
// delete_id. Exits 13.
const std = @import("std")
const wl = @import("std.wayland")
const wire = @import("std.wayland.wire")
const transport = @import("std.wayland.transport.linux")
const linux = @import("std").linux

const SYS_fork: usize = 57
const SYS_wait4: usize = 61
const SYS_exit_group: usize = 231

fn exitProcess(code: usize) -> void {
    const ignored = linux.syscall1(SYS_exit_group, code)
}

fn ignoreBind(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {}

fn serve(handles: [*]const isize, count: usize) -> !void {
    const allocator = std.page_allocator.init()
    var display: wl.server.Display = undefined
    try wl.server.Display.init(&display, allocator)
    var context: *anyopaque = undefined
    unsafe { context = @ptrFromInt(*anyopaque, 1) }
    const name = display.createGlobal(wl.Interface.wl_output, 2, ignoreBind, context)
    var client: wl.server.Client = undefined
    var index: usize = 0
    while index < count {
        try display.addClient(wl.Handle.fromDescriptor(handles[index]), &client)
        index += 1
    }
    // Serve until every client has been disconnected (or 10 idle seconds).
    var idle: usize = 0
    while display.clientCount() > 0 && idle < 20 {
        try display.dispatch(500)
        idle += 1
    }
    display.deinit()
}

// Sends one message and reads the reply bytes into `reply`.
fn exchange(connection: *transport.Connection, writer: *wire.Writer) -> bool {
    if !wire.finish(writer) { return false }
    if transport.queue(connection, writer) != 0 { return false }
    if transport.flush(connection) != 0 { return false }
    var attempts: usize = 0
    while attempts < 50 {
        if transport.wait(connection.*.descriptor, false, 200) > 0 {
            const received = transport.receive(connection)
            if received > 0 { return true }
            if received == 0 { return false }
        }
        attempts += 1
    }
    return false
}

// Checks that the buffered input starts with wl_display.error(object, code)
// and that the server then closes the connection.
fn expectError(connection: *transport.Connection, object: u32, code: u32) -> bool {
    if transport.bufferedInput(connection) < 20 { return false }
    const bytes = transport.inputPointer(connection)
    if wire.headerObject(bytes) != 1 || wire.headerOpcode(bytes) != 0 { return false }
    if wire.load32(bytes, 8) != object || wire.load32(bytes, 12) != code { return false }
    transport.consume(connection, wire.headerSize(bytes), 0)
    var attempts: usize = 0
    while attempts < 50 {
        const received = transport.receive(connection)
        if received == 0 { return true }
        if received < 0 && received != transport.EAGAIN { return true }
        const waited = transport.wait(connection.*.descriptor, false, 200)
        attempts += 1
    }
    return false
}

fn connectionFor(descriptor: isize, connection: *transport.Connection) -> bool {
    return transport.init(connection, std.page_allocator.init(), descriptor)
}

fn runChecks(descriptors: [*]const isize) -> usize {
    var writer: wire.Writer = undefined
    var connection: transport.Connection = undefined

    // 1. Unknown object: invalid_object (0) reported on wl_display.
    if !connectionFor(descriptors[0], &connection) { return 1 }
    wire.begin(&writer, 77, 0)
    if !exchange(&connection, &writer) { return 2 }
    if !expectError(&connection, 1, 0) { return 3 }

    // 2. Unknown opcode on wl_display: invalid_method (1).
    if !connectionFor(descriptors[1], &connection) { return 4 }
    wire.begin(&writer, 1, 9)
    if !exchange(&connection, &writer) { return 5 }
    if !expectError(&connection, 1, 1) { return 6 }

    // 3. get_registry, then bind wl_output (version 2) at version 3.
    if !connectionFor(descriptors[2], &connection) { return 7 }
    wire.begin(&writer, 1, 1)
    wire.putNewId(&writer, 2)
    if !exchange(&connection, &writer) { return 8 }
    const global = transport.inputPointer(&connection)
    if wire.headerObject(global) != 2 || wire.headerOpcode(global) != 0 || wire.load32(global, 8) != 1 { return 9 }
    transport.consume(&connection, wire.headerSize(global), 0)
    wire.begin(&writer, 2, 0)
    wire.putUint(&writer, 1)
    wire.putString(&writer, "wl_output")
    wire.putUint(&writer, 3)
    wire.putNewId(&writer, 3)
    if !exchange(&connection, &writer) { return 10 }
    if !expectError(&connection, 3, 0) { return 11 }

    // 4. sync works; then a string without its NUL: invalid_method.
    if !connectionFor(descriptors[3], &connection) { return 12 }
    wire.begin(&writer, 1, 0)
    wire.putNewId(&writer, 2)
    if !exchange(&connection, &writer) { return 13 }
    while transport.bufferedInput(&connection) < 24 {
        if transport.wait(connection.descriptor, false, 1000) <= 0 { return 14 }
        const more = transport.receive(&connection)
    }
    const done = transport.inputPointer(&connection)
    if wire.headerObject(done) != 2 || wire.headerOpcode(done) != 0 { return 15 }
    transport.consume(&connection, 12, 0)
    const deleted = transport.inputPointer(&connection)
    if wire.headerObject(deleted) != 1 || wire.headerOpcode(deleted) != 1 || wire.load32(deleted, 8) != 2 { return 16 }
    transport.consume(&connection, 12, 0)
    wire.begin(&writer, 1, 1)
    wire.putNewId(&writer, 2)
    if !exchange(&connection, &writer) { return 17 }
    transport.consume(&connection, transport.bufferedInput(&connection), 0)
    wire.begin(&writer, 2, 0)
    wire.putUint(&writer, 1)
    wire.putUint(&writer, 4)
    wire.putUint(&writer, 1633771873)
    wire.putUint(&writer, 1)
    wire.putNewId(&writer, 3)
    if !exchange(&connection, &writer) { return 18 }
    if !expectError(&connection, 2, 1) { return 19 }
    return 13
}

pub fn main() -> !void {
    var server_ends: [4]isize = [4]isize{ -1, -1, -1, -1 }
    var client_ends: [4]isize = [4]isize{ -1, -1, -1, -1 }
    var index: usize = 0
    while index < 4 {
        var left: isize = -1
        var right: isize = -1
        if !transport.socketPair(&left, &right) { exitProcess(30) }
        server_ends[index] = left
        client_ends[index] = right
        index += 1
    }
    const child = linux.syscall0(SYS_fork)
    if child == 0 {
        index = 0
        while index < 4 {
            transport.close(client_ends[index])
            index += 1
        }
        unsafe { try serve(@ptrCast([*]const isize, &server_ends), 4) }
        exitProcess(13)
    }
    index = 0
    while index < 4 {
        transport.close(server_ends[index])
        index += 1
    }
    var result: usize = 0
    unsafe { result = runChecks(@ptrCast([*]const isize, &client_ends)) }
    var status: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    const waited = linux.syscall4(SYS_wait4, @bitCast(usize, child), @intFromPtr(&status), 0, 0)
    if result != 13 { exitProcess(40 + result) }
    if status[0] != 0 || status[1] != 13 { exitProcess(90) }
    exitProcess(13)
}
