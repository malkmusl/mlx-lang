// The display side's four open review items, each with a case that fails
// without its fix, built for the host (projects/brix/kernel/gpu_mode.mlx,
// gpu_set.mlx, display_modes.mlx; kernel/modes.mlx and native/
// displays.mlx take the last two from display_modes.mlx):
// 1. The HDMI way back tells the display clock its table puts back as the
//    clock and 10 kHz, as the DisplayPort way back does: the user's ROM
//    takes the fastest clock at or below what it is told, and told the
//    clock cut down (11803 tens of kHz for 118032 kHz) it gives the
//    divider after the firmware's (0x5E, 116129 kHz, not 0x5D). The card
//    here rounds as the ROM does (tests/support/tmds_card.mlx's
//    clockAtOrBelow).
// 2. The clock the display clock's table set is judged by its divider,
//    read back: 320000 kHz for 326350 asked (the user's ROM's answer) is
//    the fastest the divider has at or below it, and the change goes on;
//    a divider that did not move is refused, and the way back runs.
// 3. A confirmation that comes after the time to confirm, before the
//    timer's tick has taken the mode back, finds the mode before back and
//    answers not_found, as one after the tick does (it answered io_error).
// 4. What a boot says of a remembered mode it meant to forget goes by
//    where the file's write ended: "forgotten" only when it was written
//    (it said "it is forgotten" whatever came of the write).
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const dm = @import("../projects/brix/kernel/display_modes.mlx")
const Status = @import("../projects/brix/kernel/status.mlx").Status
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/tmds_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    card.logWrite(text)
    if show { say(text) }
}

// ---- 1 and 2: a TMDS change that raises the display clock.

var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined
var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var result: set.Result = undefined
var memory: scanout.Memory = undefined

// The user's monitor's own timing as the machine's log gives it
// (3840x1080 at 270270 kHz, h 3840 4040, front 48, sync 32 +; v 1080
// 1115, front 3, sync 5 -), and an EDID with the HDMI block.
fn users() -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = 3840, .height = 1080, .timing = edid.Timing.{ .clock = 270270, .width = 3840, .hTotal = 4040, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1115, .vFront = 3, .vSync = 5, .vPositive = false, .interlaced = false, .stereo = false }, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.cta }
}

fn hdmiMonitor() -> edid.Offer {
    var o = edid.nothing()
    o.hdmi = true
    o.extensions = 1
    o.given = 1
    return o
}

// The firmware's state with the user's display clock: the divider's
// number 0x5D (3600 MHz over 30.5: 118032 kHz), the card's clock table
// rounding as the user's ROM does; the plan for the user's monitor made
// and said.
fn machineAsUsers(name: []const u8) -> void {
    card.reset()
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, 0x0800005D)
    card.clockAtOrBelow = true
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    scanout.report(&out, &memory, &readout)
    const monitor = users()
    const offer = hdmiMonitor()
    mode.makeFor(&out, &readout, &memory, &monitor, &offer, &facts, mode.Wish.own, &plan)
    mode.say(&out, &plan)
    mode.list(&out, &plan)
    card.forget()
}

fn carry() -> bool {
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const hands = set.Hands.{ .write = card.write, .clear = card.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = card.setAside }
    return set.attemptWith(&out, &hands, &lent, &plan, true, &result)
}

// Whether the way back's step `at` is a run of SetDCEClock told `tens`
// (tens of kHz) for the display clock.
fn clockRun(at: usize, tens: usize) -> bool {
    const step = &plan.back[at]
    if step.*.kind != mode.Kind.table || step.*.block >= mode.BLOCKS { return false }
    const block = &plan.blocks[step.*.block]
    return block.*.table == videorom.Command.SetDCEClock && @intCast(usize, block.*.words[0]) == tens && @intCast(usize, block.*.words[1]) == 0x800
}

fn clockItems() -> void {
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)

    // The plan: the clock raised for the user's monitor (326350 kHz
    // needed, the ROM's own 625000 allows it), and on the way back told
    // 11804 tens of kHz: the clock and 10 kHz.
    machineAsUsers("the user's display clock raised, the way back's block")
    expect(plan.complete && plan.situation == mode.Situation.tmds && plan.tmds.engine == 118032 && plan.tmds.engineRaised && plan.tmds.engineAsked == 326350, "the plan raises the user's display clock")
    expect(clockRun(plan.backClock + 2, 11804), "1: the way back tells the clock and 10 kHz (11804, not 11803)")
    line("gpu: on the way back would run SetDCEClock with 1c 2e 00 00 00 08 00 00 (the display engine's clock as it was)\n")
    noLine("1b 2e 00 00 00 08 00 00")

    // 2: the user's ROM's answer to 326350 kHz is 320000 (the divider's
    // number 0x2D; 0x2C would give 327272): judged the fastest the divider
    // has at or below it, and the change comes through.
    expect(carry() && result.outcome == set.Outcome.done, "2: 320000 kHz for 326350 asked: the change comes through")
    expect(card.raw(0x124) & 0x7F == 0x2D, "2: the divider the table set")
    line("gpu: table SetDCEClock (the display engine's clock raised) ran to its end: 5 instructions, 1 reads, 3 writes (3 registers not written before), 0 us waited; it answers 320000 kHz\n")
    line("gpu: the display clock's divider reads 2d: 320000 kHz for 326350 kHz asked, the fastest the divider has at or below it\n")

    // 1: the change fails (the frames stand with the new picture), and the
    // way back puts the clock back: the firmware's divider 0x5D again
    // (told 11803 the ROM's rounding gives 0x5E, 116129 kHz).
    machineAsUsers("the user's display clock raised, and the frames stand")
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    {
        const done = carry()
        expect(!done && result.reason == set.Reason.frames && result.outcome == set.Outcome.back, "1: the change fails, the state of before is back")
        expect(card.raw(0x124) == 0x0800005D, "1: the display clock's divider the firmware's again (0x5D: 118032 kHz)")
        line("gpu: the display clock's divider reads 5d: 118032 kHz for 118040 kHz asked, the fastest the divider has at or below it\n")
    }

    // 2: the clock's table answers and leaves the divider as it is: the
    // change ends at it, the first table of all, and the way back runs the
    // clock's two tables again for the clock as it was.
    machineAsUsers("the display clock's divider does not move")
    card.dividerStays = true
    {
        const done = carry()
        expect(!done && result.reason == set.Reason.engine && result.outcome == set.Outcome.back, "2: a divider that did not move: refused, the state of before back")
        expect(result.runs == 1 && result.runsBack == 2 && card.raw(0x124) == 0x0800005D, "2: one run there, the clock's two back, nothing of the output")
        expect(card.raw(scanout.DIG[4] + scanout.DIG_BE_EN_CNTL) & 1 == 1 && card.raw(0x1B9C) & 1 == 1, "2: the output and the controller run as before")
        line("gpu: the display clock's divider reads 5d: 118032 kHz for 326350 kHz asked: not the clock the table was told\n")
        line("failed (the display clock its table set): ")
    }
}

// ---- 3: a confirmation after the time to confirm.

var bytes: [128]u8 = undefined
var sets: usize = 0
var backs: usize = 0
var pictureBefore: dm.Picture = undefined

fn judge(which: usize, m: *dm.Mode) -> void {}

fn setMode(which: usize, m: *const dm.Mode, picture: *dm.Picture) -> dm.Set {
    sets += 1
    pictureBefore = picture.*
    picture.*.address = 0x1000000
    picture.*.width = m.*.width
    picture.*.height = m.*.height
    picture.*.pitch = m.*.width * 4
    return dm.Set.done
}

fn backMode(which: usize, before: *const dm.Mode, picture: *dm.Picture) -> dm.Set {
    backs += 1
    picture.* = pictureBefore
    return dm.Set.done
}

// A base block (EDID 1.3, a digital input) with 1920x1080 at 60 Hz as its
// own timing (148.5 MHz) and 1024x768 at 60 Hz among the established
// ones.
fn monitorBlock() -> void {
    var k: usize = 0
    while k < 128 {
        bytes[k] = 0
        k += 1
    }
    k = 1
    while k < 7 {
        bytes[k] = 0xFF
        k += 1
    }
    bytes[8] = 0x4C
    bytes[9] = 0x2D
    bytes[18] = 1
    bytes[19] = 3
    bytes[20] = 0xA5
    bytes[36] = 0x08
    k = 38
    while k < 54 {
        bytes[k] = 1
        k += 1
    }
    // 148500 kHz, 1920 + 280, front 88, sync 44; 1080 + 45, front 4,
    // sync 5; both pulses high.
    bytes[54] = 0x02
    bytes[55] = 0x3A
    bytes[56] = 0x80
    bytes[57] = 0x18
    bytes[58] = 0x71
    bytes[59] = 0x38
    bytes[60] = 0x2D
    bytes[61] = 0x40
    bytes[62] = 0x58
    bytes[63] = 0x2C
    bytes[64] = 0x45
    bytes[65] = 0x00
    bytes[71] = 0x1E
    k = 1
    while k < 4 {
        bytes[54 + k * 18 + 3] = 0x10
        k += 1
    }
    var sum: usize = 0
    k = 0
    while k < 127 {
        sum += @intCast(usize, bytes[k])
        k += 1
    }
    bytes[127] = @intCast(u8, (256 - sum % 256) % 256)
}

const SECOND: usize = 1000000000
const MILLISECOND: usize = 1000000

fn confirmations() -> void {
    monitorBlock()
    const driver = dm.Driver.{ .kind = dm.Kind.RADEON_TMDS, .which = 0, .timed = true, .anySize = false, .judge = judge, .set = setMode, .back = backMode }
    var picture = dm.Picture.{ .address = 0x100000, .width = 1920, .height = 1080, .pitch = 7680 }
    var state: dm.State = undefined
    state.begin(&driver, bytes[0..128], &picture, 60000, null)
    expect(state.runs.width == 1920 && !state.pending, "3: the monitor's own mode runs")

    // In time: confirmed, 0.
    var answer = state.ask(1024, 768, 60003, 100 * SECOND)
    expect(answer == dm.Answer.changed && dm.callStatus(answer) == 0 && state.pending, "3: a mode asked for: pending, 0")
    answer = state.confirmAt(100 * SECOND + dm.CONFIRM_TIME - MILLISECOND)
    expect(answer == dm.Answer.confirmed && dm.callStatus(answer) == 0 && state.runs.width == 1024, "3: confirmed a millisecond before the time is over: it stays, 0")

    // Too late, 5 ms after the time to confirm, before the timer's tick
    // took it back: the mode before is back (last 5), and the call
    // answers not_found, as after the tick (io_error before).
    answer = state.ask(1920, 1080, 60000, 200 * SECOND)
    expect(answer == dm.Answer.changed && state.pending, "3: the monitor's own mode asked for again")
    answer = state.confirmAt(200 * SECOND + dm.CONFIRM_TIME + 5 * MILLISECOND)
    expect(answer == dm.Answer.timed_out && !state.pending && state.runs.width == 1024 && backs == 1, "3: too late: the kernel's own taking back, the mode before runs")
    expect(dm.callStatus(answer) == Status.not_found, "3: a confirmation too late answers not_found")
    // After the tick: the same.
    answer = state.ask(1920, 1080, 60000, 300 * SECOND)
    expect(state.tick(300 * SECOND + dm.CONFIRM_TIME) && state.last == dm.Answer.timed_out, "3: the tick takes the next one back")
    answer = state.confirmAt(300 * SECOND + dm.CONFIRM_TIME + 5 * MILLISECOND)
    expect(answer == dm.Answer.nothing_pending && dm.callStatus(answer) == Status.not_found, "3: a confirmation after the tick: not_found too")
    // The others as they were.
    expect(dm.callStatus(dm.Answer.already) == 0 && dm.callStatus(dm.Answer.taken_back) == 0 && dm.callStatus(dm.Answer.busy) == Status.busy && dm.callStatus(dm.Answer.not_listed) == Status.not_found && dm.callStatus(dm.Answer.refused) == Status.unsupported && dm.callStatus(dm.Answer.failed_back) == Status.io_error && dm.callStatus(dm.Answer.failed_lost) == Status.io_error, "3: every other answer's status as before")
}

// ---- 4: what is said of a remembered mode that is forgotten.

fn contains(text: []const u8, part: []const u8) -> bool {
    if part.length > text.length { return false }
    var at: usize = 0
    while at + part.length <= text.length {
        var k: usize = 0
        while k < part.length && text[at + k] == part[k] { k += 1 }
        if k == part.length { return true }
        at += 1
    }
    return false
}

fn forgetting() -> void {
    expect(contains(dm.forgetText(true, dm.Written.disk), "is forgotten, and its own mode is what the boots set again"), "4: N, the file written: forgotten")
    expect(contains(dm.forgetText(false, dm.Written.disk), "it is forgotten, and the next boots set the monitor's own mode"), "4: a mode that did not come, the file written: forgotten")
    expect(contains(dm.forgetText(true, dm.Written.memory), "this system does not run from a disk") && contains(dm.forgetText(false, dm.Written.memory), "this system does not run from a disk"), "4: in memory alone: said")
    const notByKey = dm.forgetText(true, dm.Written.not)
    const notTried = dm.forgetText(false, dm.Written.not)
    expect(!contains(notByKey, "is forgotten") && contains(notByKey, "is not forgotten") && contains(notByKey, "could not be written"), "4: N, the file not written: not said to be forgotten")
    expect(!contains(notTried, "it is forgotten") && contains(notTried, "it is not forgotten") && contains(notTried, "the next boots try it again"), "4: a mode that did not come, the file not written: not said to be forgotten")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    clockItems()
    confirmations()
    forgetting()
    if failed != 0 { return failed }
    return 13
}
