const Box = struct {
    value: usize
}

pub fn main() -> u8 {
    var box: Box = undefined
    box.value = 7
    if @intFromPtr(&box) == 0 || box.value != 7 { return 1 }

    var buffer: [65536]u8 = undefined
    buffer[0] = 11
    buffer[65535] = 13
    if @intFromPtr(&buffer) == 0 || buffer[0] != 11 || buffer[65535] != 13 { return 2 }
    return 13
}
