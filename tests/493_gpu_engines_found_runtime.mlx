// The kernel's first look at a Radeon's engines (projects/brix/kernel/
// gpu_engines.mlx's step S0, built for the host) and how far a boot goes
// (projects/brix/engine_choice.mlx), against a card that is a table
// (tests/support/engine_card.mlx: the user's RX 580 as the machine's logs
// show it, and as the study expects a card the firmware started to be
// where no log has shown it yet), with the rules written out here a
// second time:
// - the stage of a boot: of every character a keyboard gives, 0 to 7
//   alone are digits; no loader of ours, a loader without a keyboard, no
//   digit: stage 0; a digit is its stage, one above the stages this
//   kernel has goes as far as it has; the display's choice F holds every
//   stage back at 0 whatever the digit; the line said for each, word for
//   word; the aperture's part the display may use: all of it at stage 0,
//   the top 64 MiB less from stage 1 on;
// - the EFI loader's own part run here (efi.mlx's text, against the
//   firmware that is a table of tests/482): a digit alone, a digit and a
//   letter in either order, two digits (the last counts), a digit after
//   looks without one (the looking ends at it), characters that are no
//   digit: the stage word and the display's word it hands over, how often
//   it looked and waited; a boot without a key hands the stage word over
//   with no digit;
// - S0 on the user's card: the step's line and every line it says in the
//   log, word for word as far as they are fixed; the writes: only the
//   three index words (the SMC's, the memory controller's IO debug index,
//   the queue selector), each left as it was found; no register of the
//   display's; the GART's place by Linux's rule (0xff00000000 for this
//   card) and in its other branch;
// - what S0 reads and says otherwise: the SMC running its RAM firmware,
//   no AVFS, another list version, a firmware file missing and one cut
//   short, a soft-key card, a ROM without GFX_Info, no ROM, a host path
//   word that is not 0, memory columns of each kind;
// - a card left running by a start before this one: said and nothing
//   written at stage 0; at stage 1 halted by registers alone write for
//   write (the interrupt ring off, the copy engines halted, the two
//   queues dequeued, the processors halted, the doorbells off), the GART
//   and the SMC taken over; a queue that does not let go is said;
// - every refusal: a card the firmware has not started (no size, all
//   ones), a card that is no Polaris 10, memory that does not add up.
// With an argument the log of every case is printed.
// Exits 13.
const std = @import("std")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const stages = @import("../projects/brix/engine_choice.mlx")
const choice = @import("../projects/brix/display_choice.mlx")
const layout = @import("../projects/brix/layout.mlx")
const card = @import("./support/engine_card.mlx")
const firmware = @import("./support/choice_firmware.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

var written: [256]u8 = undefined
var writtenLength: usize = 0

fn collect(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && writtenLength < written.length {
        written[writtenLength] = text[k]
        writtenLength += 1
        k += 1
    }
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

// ---- The stage of a boot.

fn stageLine(d: *const stages.Decision, wanted: []const u8) -> void {
    writtenLength = 0
    stages.say(collect, d, true)
    if !same(written[0..writtenLength], wanted) {
        say("the stage's line: ")
        say(written[0..writtenLength])
        say("  wanted: ")
        say(wanted)
        if failed == 0 { failed = 3 }
    }
}

fn theStage() -> void {
    // The digits.
    var character: usize = 0
    while character < 0x10000 {
        const wanted: u8 = if character >= 48 && character <= 55 { @intCast(u8, character) } else { 0 }
        expect(stages.digitOf(character) == wanted, "of every character, 0 to 7 alone are digits")
        character += 1
    }
    const looked = choice.Word.LOOKED
    // Every word: no loader, a loader without a key, each digit, with
    // every display choice; with and without a keyboard.
    const displays = [_]choice.Choice{ choice.Choice.native, choice.Choice.firmware, choice.Choice.rehearsal, choice.Choice.ask }
    for display in displays {
        var d = stages.decide(0, 0, display)
        expect(d.stage == 0 && !d.looked && d.digit == stages.NONE, "no loader of ours: stage 0")
        d = stages.decide(stages.Word.LOOKED, looked, display)
        expect(d.stage == 0 && d.looked && d.keyboard && d.digit == stages.NONE, "no digit: stage 0")
        var digit: usize = 0
        while digit < 8 {
            d = stages.decide(stages.Word.of(@intCast(u8, 48 + digit)), looked, display)
            var wanted = if digit > stages.BUILT { stages.BUILT } else { digit }
            if display == choice.Choice.firmware { wanted = 0 }
            expect(d.stage == wanted && d.digit == digit, "a digit is its stage, as far as this kernel has, none under F")
            expect(d.beyond == (digit > stages.BUILT && display != choice.Choice.firmware) || (display == choice.Choice.firmware && d.firmware == (digit != 0)), "what held the stage back")
            // Without a keyboard the loader saw no digit.
            d = stages.decide(stages.Word.of(@intCast(u8, 48 + digit)), looked | choice.Word.NO_KEYBOARD, display)
            expect(d.stage == 0 && !d.keyboard && d.digit == stages.NONE, "no keyboard: no digit")
            digit += 1
        }
        // Characters that are no digit, in the word.
        const others = [_]u8{ 56, 57, 47, 70, 97, 255 }
        for other in others {
            d = stages.decide(stages.Word.of(other), looked, display)
            expect(d.stage == 0 && d.digit == stages.NONE, "a character that is no digit is none")
        }
    }
    // The lines.
    var d = stages.decide(0, 0, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines are only read, stage 0 (no loader of ours read the keys)\n")
    d = stages.decide(stages.Word.LOOKED, looked, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines are only read, stage 0 (no digit was pressed; 1 to 5 held while the machine starts goes further)\n")
    d = stages.decide(stages.Word.of(50), looked, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines up to stage 2, the interrupt ring (2 was pressed at this start and holds for this boot only)\n")
    d = stages.decide(stages.Word.of(49), looked, choice.Choice.rehearsal)
    stageLine(&d, "gpu: this boot: the card's engines up to stage 1, the GART (1 was pressed at this start and holds for this boot only)\n")
    d = stages.decide(stages.Word.of(48), looked, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines are only read, stage 0 (0 was pressed at this start and holds for this boot only)\n")
    d = stages.decide(stages.Word.of(53), looked, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines up to stage 5, a compute ring (5 was pressed at this start and holds for this boot only)\n")
    d = stages.decide(stages.Word.of(54), looked, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines up to stage 5, a compute ring (6 was pressed at this start; this kernel has the stages up to 5)\n")
    d = stages.decide(stages.Word.of(50), looked, choice.Choice.firmware)
    stageLine(&d, "gpu: this boot: the card's engines are only read, stage 0 (2 was pressed at this start, but this boot keeps the firmware's picture (F): no stage beyond 0)\n")
    d = stages.decide(stages.Word.of(50), looked | choice.Word.NO_KEYBOARD, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines are only read, stage 0 (the firmware gave the loader no keyboard to read: a digit is not seen on this machine)\n")
    writtenLength = 0
    d = stages.decide(0, 0, choice.Choice.native)
    stages.say(collect, &d, false)
    expect(same(written[0..writtenLength], "gpu: there is no card of ours here: nothing of a card's engines is read or written (no loader of ours read the keys)\n"), "the line without a card")
    // The display's part of the aperture.
    const view: usize = 256 * 1024 * 1024
    expect(engines.displayLimit(view, 0) == view, "stage 0: the display keeps the whole aperture")
    expect(engines.displayLimit(view, 1) == 192 * 1024 * 1024 && engines.displayLimit(view, 2) == 192 * 1024 * 1024, "from stage 1 the display's part ends 64 MiB below the top")
    expect(engines.displayLimit(127 * 1024 * 1024, 1) == 0 && engines.displayLimit(128 * 1024 * 1024, 1) == 64 * 1024 * 1024, "an aperture too small to divide")
    // The word's place: past the blob's two GDTRs, before the IDTR.
    expect(layout.Blob.BOOT_INFO + layout.Info.STAGE >= layout.Blob.GDTR64 + 10 && layout.Blob.BOOT_INFO + layout.Info.STAGE + 8 <= layout.Blob.IDTR, "the stage word lies in the blob's free bytes")
}

// ---- The loader's part.

var list: [firmware.KEYS]firmware.Key = undefined
var listed: usize = 0

fn key(character: usize) -> void {
    list[listed] = firmware.Key.of(character)
    listed += 1
}

fn noKeyYet() -> void {
    list[listed] = firmware.Key.notYet()
    listed += 1
}

fn theLoader() -> void {
    if !firmware.make() {
        say("the loader's part could not be run here: ")
        say(firmware.problem())
        say("\n")
        if failed == 0 { failed = 4 }
        return
    }
    const all = firmware.Has.all()
    const slices = choice.WAIT / choice.SLICE
    // A boot without a key: the whole wait, no digit.
    listed = 0
    var left = firmware.start(list[0..0], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    expect(firmware.stageWord() == stages.Word.LOOKED && left.stalls == slices && left.word & choice.Word.KEY == 0, "no key: no digit, the whole wait")
    // Each digit alone, at once: no waiting.
    var digit: usize = 0
    while digit < 8 {
        listed = 0
        key(48 + digit)
        left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
        expect(firmware.stageWord() == stages.Word.of(@intCast(u8, 48 + digit)) && left.stalls == 0 && left.reads == 2 && left.word & choice.Word.KEY == 0 && left.says == 0 && left.sets == 0, "a digit alone is handed over, ends the looking, writes and says nothing")
        digit += 1
    }
    // A digit and a letter, each order; two digits; a digit among others.
    listed = 0
    key(51)
    key(70)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    expect(firmware.stageWord() == stages.Word.of(51) && left.word & choice.Word.KEY == 70 && left.sets == 1, "a digit, then F: both")
    listed = 0
    key(114)
    key(50)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    expect(firmware.stageWord() == stages.Word.of(50) && left.word & choice.Word.KEY == 82, "r, then a digit: both")
    listed = 0
    key(49)
    key(55)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    expect(firmware.stageWord() == stages.Word.of(55), "two digits: the last counts")
    listed = 0
    key(56)
    key(57)
    key(32)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    expect(firmware.stageWord() == stages.Word.LOOKED && left.stalls == slices, "8, 9 and a blank are no digits: the looking goes on")
    // A digit after looks without one: taken, the looking ends there.
    var looks: usize = 1
    while looks <= 10 {
        listed = 0
        while listed < looks { noKeyYet() }
        key(50)
        left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
        expect(firmware.stageWord() == stages.Word.of(50) && left.stalls == looks, "a digit after looks without one ends the looking")
        looks += 1
    }
    // No keyboard: the word says the loader looked, and nothing else.
    var has = firmware.Has.all()
    has.input = false
    listed = 0
    key(50)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &has)
    expect(firmware.stageWord() == stages.Word.LOOKED, "no keyboard: no digit")
    const d = stages.decide(firmware.stageWord(), left.word, choice.decide(left.word, "").choice)
    expect(d.stage == 0 && !d.keyboard, "what the kernel makes of a loader without a keyboard")
    // The words as the kernel takes them: a digit and F at once.
    listed = 0
    key(50)
    key(102)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    const both = stages.decide(firmware.stageWord(), left.word, choice.decide(left.word, "").choice)
    expect(both.stage == 0 && both.firmware && both.digit == 2, "2 and F at once: F holds the stage at 0")
    listed = 0
    key(50)
    key(110)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    const native = stages.decide(firmware.stageWord(), left.word, choice.decide(left.word, "").choice)
    expect(native.stage == 2 && native.digit == 2, "2 and N at once: stage 2")
}

// ---- S0 on the card.

var e: engines.Engines = undefined

fn place() -> engines.Card {
    return engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = card.pictureOffset, .pictureBytes = card.pictureWidth * card.pictureHeight * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
}

// S0 on the card as it stands, at `stage`; whether a stage may follow.
fn s0(stage: usize, where: *const engines.Card) -> bool {
    const hands = card.hands()
    engines.begin(&e, &hands, where, stage)
    const result = engines.found(&e)
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
    return result
}

fn loadFiles() -> bool {
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !card.load(name) { return false }
    }
    return true
}

// The index words S0 may write, each written and left as found.
fn onlyIndexWords(smc: usize, debug: usize, selector: usize) -> void {
    var k: usize = 0
    var others: usize = 0
    while k < card.written {
        const n = card.writtenTo[k]
        if n != engines.SMC_IND_INDEX_11 && n != engines.MC_SEQ_IO_DEBUG_INDEX && n != engines.SRBM_GFX_CNTL { others += 1 }
        k += 1
    }
    expect(others == 0, "S0 writes no register but the three index words")
    expect(card.registers[engines.SMC_IND_INDEX_11] == smc && card.registers[engines.MC_SEQ_IO_DEBUG_INDEX] == debug && card.registers[engines.SRBM_GFX_CNTL] == selector, "each index word as it was found")
    expect(card.displayWrites(0) == 0, "no register of the display's is written")
}

fn theCard() -> void {
    card.reset()
    expect(card.makeRom(true), "the ROM made here opens")
    card.registers[engines.SMC_IND_INDEX_11] = 0xE0003088
    card.registers[engines.MC_SEQ_IO_DEBUG_INDEX] = 0x12
    var where = place()
    expect(s0(0, &where), "S0 on the user's card lets a stage follow")
    expect(e.s0 == engines.Outcome.passed, "S0 passed")
    onlyIndexWords(0xE0003088, 0x12, 0)
    expect(card.asides == 1 && !card.aside, "the details kept off the screen, the step's line on it")
    // The step's line, and the details.
    line("gpu: step S0: card as found: SMC clock on, program counter 0x1a40 (its ROM; firmware not running), protected mode 1, key 1 -> polaris10_k_smc.bin; memory controller 0x1 runs, GART off; engines halted (ME 0x15000000, MEC 0x50000000, SDMA 0x1 0x1); 4 shader engines, 36 compute units by the ROM; 41 C; nine firmware files in order (")
    line("gpu: the card's ROM: 4 shader engines, 1 shader array each, 9 compute units an array (36), 2 render back ends an engine, 8 tile pipes, 8 texture channel caches (graphics IP 8.1); default clocks: core 300.00 MHz, memory 300.00 MHz\n")
    line("gpu: SMC: clock control 0x0 (clock on), program counter 0x1a2c then 0x1a40 (its ROM: no firmware of a driver's runs), reset 0x0, status 0x0, firmware word 0x30000 (protected mode 1, key 1: its file is polaris10_k_smc.bin), events 0x80, firmware flags 0x0\n")
    line("gpu: SMC: AVFS fuse 0x1 (word 0x1): Linux would write its default levels before loading the engines' firmware; this driver does not yet\n")
    line("gpu: memory: 8192 MiB at 0xf400000000..0xf5ffffffff of the card's addresses (location 0xf5fff400, size word 0x2000); system aperture 0xf400000..0xf5fffff default 0xf400000; AGP base 0x0 top 0x0 bottom 0x0; aperture access 0x3; scratch 7 0x200 (started by the firmware)\n")
    line("gpu: memory controller: sequencer 0x1 (runs), kind 0x50000080 (GDDR5), training 0xc0000000 (trained), register list version 0x3b4dc40; the firmware's microcode is kept (Linux would load 0x3b4dc40: the same)\n")
    line("gpu: memory columns field 2: address configuration 0x22011003 (the graphics block has 0x22011003, the host path 0x0; DMIF_ADDR_CALC 0x0, the display's, is not written by these stages)\n")
    line("gpu: GART: L1 TLB control 0x0, L2 0x0 0x0 0x0 0x0, address space 0 0x0, 1 0x0 (off); faults: 0 status 0x0 address 0x0, 1 status 0x0 address 0x0; arbiter's read group 0 0x0; host path flush 0x0, its control 0x0\n")
    line("gpu: the host path's 160 surface words are all 0\n")
    line("gpu: interrupt ring control 0x0 (off), interrupt control 0x0, its doorbell 0x0; PCI command 0x406 (bus mastering on)\n")
    line("gpu: engines: ME 0x15000000, MEC 0x50000000, RLC 0x0 status 0x0, GRBM status 0x3028 and 0x0, copy engines 0x1 0x1 status 0x0 0x0 rings 0x0 0x0; queues: KIQ 0x0 compute 0 0x0; doorbells 0x0, queue status 0x0; SPM VMID 0x0, schedulers 0x0\n")
    line("gpu: the VGA words: VGA_HDP_CONTROL 0x0, VGA_RENDER_CONTROL 0x0 (Linux would lock the VGA aperture out: these stages write no register of the display's)\n")
    line("gpu: golden words as found, memory: 0x9e1=0x0 0x52c=0x0 0x52d=0x0 0x52e=0x0 0x52f=0x0\n")
    line("gpu: golden words as found, graphics: 0xcd4=0x0 ")
    line(" CG_ACLK_CNTL=0x0\n")
    line("gpu: golden words as found, copy engines: 0x3405=0x0 ")
    line("gpu: 41 C; fan mode 5, duty 51 of 255, period 0x0; thermal limits: CTF 0x0, high 0x0, low 0x0, control 0x0\n")
    line("gpu: firmware: polaris10_pfp_2.bin 0xfe polaris10_me_2.bin 0xa7 polaris10_ce_2.bin 0x8c polaris10_mec_2.bin 0x2da polaris10_rlc.bin 0x11e polaris10_sdma.bin 0x3a polaris10_sdma1.bin 0x3a polaris10_k_smc.bin 0x171100: the nine files hold\n")
    line("gpu: GART by Linux's rule: 256 MiB at 0xff00000000..0xff0fffffff, beside the card's memory\n")
    noLine("left running")
    expect(e.found.gartStart == 0xFF00000000 && e.found.gartEnd == 0xFF0FFFFFFF, "the GART at 0xff00000000 for this card")
    expect(e.found.addressConfig == 0x22011003 && e.found.smcFile.length == 19, "the address configuration, the SMC's file")
    // The GART's place in its other branch, and for VRAM at the top.
    expect(engines.gartPlace(0x0, 0x1FFFFFFFF) == 0xFF00000000, "VRAM at 0: the GART at the top")
    expect(engines.gartPlace(0x400000000, 0xFFFFFFFFFF) == 0, "VRAM to the top: the GART at 0")
    expect(engines.gartPlace(0x100000000, 0x2FFFFFFFF) == 0, "room below, less than above: the GART at 0")
    expect(engines.gartPlace(0x8000000000, 0x80FFFFFFFF) == 0xFF00000000, "more room below than above: the GART at the top")
    // (The review's: as much room below as above: Linux's rule asks for
    // less below, so the GART goes to the top.)
    expect(engines.gartPlace(0x7F00000000, 0x80FFFFFFFF) == 0xFF00000000, "as much room below as above: the GART at the top")
    // The same at stage 1: nothing more is written by S0.
    card.reset()
    where = place()
    expect(s0(1, &where), "S0 at stage 1")
    onlyIndexWords(0, 0, 0)
}

fn otherwise() -> void {
    // The SMC running firmware of a driver's (a start before this one).
    card.reset()
    card.smcSet(engines.ixSMC_PC_C, 0x20C00)
    card.smcSet(engines.ixSMU_EFUSE_0 + engines.AVFS_FUSE_WORD * 4, 0)
    card.listVersion = 0x05B4DC40
    card.registers[engines.MC_ARB_RAMCFG] = 0
    var where = place()
    expect(s0(0, &where), "S0 with the SMC running")
    line("(firmware in its RAM runs)")
    line("(firmware running)")
    line("): the card has no AVFS\n")
    line("register list version 0x5b4dc40; the firmware's microcode is kept (Linux would load 0x3b4dc40)\n")
    line("gpu: memory columns field 0: address configuration 0x2011003")
    line("gpu: the card was left running by a start before this one: SMC firmware running; nothing is halted at stage 0: 1 or 2 held while the machine starts halts it first\n")
    expect(card.written == 0 || card.displayWrites(0) == 0, "nothing of the display's")
    onlyIndexWords(0, 0, 0)
    // (The review's: a program counter in the SMC's RAM with the SMC's
    // clock off is not firmware running: smu7_is_smc_ram_running asks
    // both.)
    card.reset()
    card.smcSet(engines.ixSMC_PC_C, 0x20C00)
    card.smcSet(engines.ixSMC_SYSCON_CLOCK_CNTL_0, engines.SMC_SYSCON_CLOCK_CNTL_0__ck_disable)
    where = place()
    _ = s0(0, &where)
    line("gpu: step S0: card as found: SMC clock off, program counter 0x20c14 (its ROM; firmware not running)")
    noLine("SMC firmware running")
    // Memory columns 1: rows of 2 KiB.
    card.reset()
    card.registers[engines.MC_ARB_RAMCFG] = 0x40
    where = place()
    _ = s0(0, &where)
    line("gpu: memory columns field 1: address configuration 0x12011003")
    // The soft key: the other SMC file; a card that is no kicker.
    card.reset()
    card.smcSet(engines.ixSMU_FIRMWARE, engines.SMU_FIRMWARE__SMU_MODE)
    where = place()
    _ = s0(0, &where)
    line("key 0 -> polaris10_smc_sk.bin")
    line("polaris10_smc_sk.bin 0x171100: the nine files hold\n")
    card.reset()
    where = place()
    where.revision = 0xC7
    _ = s0(0, &where)
    line("key 1 -> polaris10_smc.bin")
    line("gpu: firmware: polaris10_smc.bin is not in the boot archive\n")
    line("; FIRMWARE FILES MISSING OR DAMAGED (the lines above) (")
    expect(!e.found.filesHold, "a file not there does not hold")
    // A file missing, one cut short.
    card.reset()
    card.fileMissing = 3
    card.fileShort = 7
    where = place()
    expect(s0(0, &where), "files that do not hold stop nothing of stages 0 to 2")
    line("gpu: firmware: polaris10_mec_2.bin is not in the boot archive\n")
    line("gpu: firmware: polaris10_k_smc.bin is not as long as its header says\n")
    // The checks of a file on their own.
    card.reset()
    const mec = card.file("polaris10_mec_2.bin")
    expect(engines.checkFile("x", mec, 1, 0, true, false).holds == engines.Holds.yes, "MEC's jump table ends its payload")
    expect(engines.checkFile("x", mec, 2, 0, true, false).holds == engines.Holds.header, "a header of another version")
    expect(engines.checkFile("x", card.file("polaris10_pfp_2.bin"), 1, 0, true, false).holds == engines.Holds.jump_table, "PFP's jump table is inside its payload")
    expect(engines.checkFile("x", card.file("polaris10_mec_2.bin"), 1, 0, false, true).holds == engines.Holds.smc_size, "MEC's payload does not fit the SMC's RAM")
    expect(engines.checkFile("x", card.file("polaris10_k_smc.bin"), 1, 0, false, true).holds == engines.Holds.yes, "the SMC's image fits its RAM")
    // No GFX_Info, no ROM.
    card.reset()
    expect(card.makeRom(false), "a ROM without GFX_Info")
    where = place()
    _ = s0(0, &where)
    line("gpu: the card's ROM has no GFX_Info: the graphics block's numbers are not known; default clocks: core 300.00 MHz, memory 300.00 MHz\n")
    noLine("compute units by the ROM")
    card.reset()
    where = place()
    where.rom = null
    _ = s0(0, &where)
    line("gpu: the card's ROM has no GFX_Info: the graphics block's numbers are not known\n")
    expect(card.makeRom(true), "the ROM again")
    // A host path word that is not 0.
    card.reset()
    card.registers[0xB0B] = 0x1234
    where = place()
    _ = s0(0, &where)
    line("gpu: the host path's surface words: 1 are not 0, the first 0xb0b is 0x1234: left alone, step M2 is refused\n")
    // The VGA words as Linux leaves them.
    card.reset()
    card.registers[engines.VGA_HDP_CONTROL] = engines.VGA_HDP_CONTROL__VGA_MEMORY_DISABLE
    where = place()
    _ = s0(0, &where)
    line("gpu: the VGA words: VGA_HDP_CONTROL 0x10, VGA_RENDER_CONTROL 0x0 (as Linux leaves them)\n")
}

// A card left running: said at stage 0 with nothing written; halted at
// stage 1, write for write.
fn running() -> void {
    card.reset()
    card.registers[engines.IH_RB_CNTL] = 0x8022011D
    card.registers[engines.SDMA1_F32_CNTL] = 0
    card.registers[engines.SDMA0_GFX_RB_CNTL] = 0x1017
    card.registers[engines.SDMA0_CNTL] = 0x40002
    card.registers[engines.SDMA0_GFX_IB_CNTL] = 0x101
    card.registers[engines.CP_MEC_CNTL] = 0
    card.registers[engines.CP_ME_CNTL] = 0
    card.registers[engines.RLC_CNTL] = 1
    card.registers[engines.BIF_DOORBELL_APER_EN] = 1
    card.registers[engines.VM_CONTEXT0_CNTL] = 0x11
    card.queueActive[2 * 32 + 1 * 8 + 0] = 1
    card.queueActive[1 * 32] = 1
    var where = place()
    expect(s0(0, &where), "a card left running: S0 at stage 0")
    line("gpu: the card was left running by a start before this one: interrupt ring on (0x22011d), copy engines running, compute queues active, processors running, RLC running, doorbells on, GART on; nothing is halted at stage 0: 1 or 2 held while the machine starts halts it first\n")
    line("engines NOT HALTED")
    onlyIndexWords(0, 0, 0)
    // Stage 1: halted.
    const from = card.written
    expect(s0(1, &where), "a card left running: S0 at stage 1")
    expect(e.quieted, "halted")
    const N = card.NEVER
    // The writes after S0's reads (its index words come first).
    var k = from
    while k < card.written && (card.writtenTo[k] == engines.SMC_IND_INDEX_11 || card.writtenTo[k] == engines.MC_SEQ_IO_DEBUG_INDEX || card.writtenTo[k] == engines.SRBM_GFX_CNTL) { k += 1 }
    const numbers = [_]usize{ engines.IH_RB_CNTL, engines.IH_RB_RPTR, engines.IH_RB_WPTR, engines.SDMA0_CNTL, engines.SDMA0_GFX_RB_CNTL, engines.SDMA0_GFX_IB_CNTL, engines.SDMA0_F32_CNTL, engines.SDMA1_CNTL, engines.SDMA1_GFX_RB_CNTL, engines.SDMA1_GFX_IB_CNTL, engines.SDMA1_F32_CNTL, engines.SRBM_GFX_CNTL, engines.CP_HQD_DEQUEUE_REQUEST, engines.CP_HQD_DEQUEUE_REQUEST, engines.CP_HQD_PQ_RPTR, engines.CP_HQD_PQ_WPTR, engines.SRBM_GFX_CNTL, engines.CP_HQD_DEQUEUE_REQUEST, engines.CP_HQD_DEQUEUE_REQUEST, engines.CP_HQD_PQ_RPTR, engines.CP_HQD_PQ_WPTR, engines.SRBM_GFX_CNTL, engines.CP_MEC_CNTL, engines.CP_ME_CNTL, engines.BIF_DOORBELL_APER_EN }
    const values = [_]usize{ 0x8022011C & ~engines.IH_RB_CNTL__ENABLE_INTR & 0x7FFFFFFF, 0, 0, 0x2, 0x1016, 0x100, 1, 0, 0, 0, 1, engines.queue(2, 1, 0), 2, 0, 0, 0, engines.queue(1, 0, 0), 2, 0, 0, 0, 0, 0x50000000, 0x15000000, 0 }
    const differs = card.writesFrom(k, numbers[0..], values[0..])
    expect(differs == N, "a card left running halted write for write")
    if differs != N && show {
        say("the writes from ")
        say(if differs < numbers.length { "a difference\n" } else { "the end\n" })
    }
    expect(card.queueActive[2 * 32 + 8] == 0 && card.queueActive[32] == 0, "the queues let go")
    line("gpu: step S0: the card was left running by a start before this one: interrupt ring on (0x22011d), copy engines running, compute queues active, processors running, RLC running, doorbells on, GART on: all halted now (interrupt ring 0x20011c, copy engines 0x1 0x1, ME 0x15000000, MEC 0x50000000, doorbells 0x0), the GART and the SMC are taken over as they are\n")
    expect(card.displayWrites(0) == 0, "halting writes nothing of the display's")
    // (The review's: a ring left with its interrupt on alone is a ring
    // left on, and turned off at stage 1.)
    card.reset()
    card.registers[engines.IH_RB_CNTL] = engines.IH_RB_CNTL__ENABLE_INTR
    where = place()
    _ = s0(1, &where)
    line("gpu: step S0: the card was left running by a start before this one: interrupt ring on (0x20000): all halted now (interrupt ring 0x0,")
    // A queue that does not let go: said, after Linux's 100 ms.
    card.reset()
    card.queueActive[32] = 1
    card.queueHolds = true
    where = place()
    _ = s0(1, &where)
    line("; a queue did not let go in 100 ms")
}

fn refusals() -> void {
    card.reset()
    card.registers[engines.CONFIG_MEMSIZE] = 0
    var where = place()
    expect(!s0(2, &where) && e.s0 == engines.Outcome.refused, "a card not started: refused")
    line("gpu: the card's engines are left alone: the firmware has not started the card\n")
    expect(card.written == 0, "nothing written to a card not started")
    card.reset()
    card.registers[engines.CONFIG_MEMSIZE] = 0xFFFFFFFF
    where = place()
    expect(!s0(2, &where), "a card that answers all ones: refused")
    line("gpu: the card's engines are left alone: the firmware has not started the card\n")
    card.reset()
    where = place()
    where.device = 0x67EF
    expect(!s0(2, &where) && card.written == 0, "a Polaris 11: refused, nothing written")
    line("gpu: the card's engines are not read: this driver knows their registers for a Polaris 10 (RX 470, 480, 570, 580) alone\n")
    card.reset()
    card.registers[engines.MC_VM_FB_LOCATION] = 0xF5FFF300
    where = place()
    expect(!s0(2, &where) && e.s0 == engines.Outcome.refused, "memory that does not add up: refused")
    line("gpu: step S0: the card's memory does not add up (location 0xf5fff300, size word 0x2000): no stage beyond 0 runs\n")
    line("): THEY DO NOT ADD UP;")
    card.reset()
    card.registers[engines.CONFIG_MEMSIZE] = 0x00012000
    where = place()
    expect(s0(2, &where), "a size word with garbage in both halves: Linux's rule keeps the low half: 8 GiB")
    expect(e.found.vramBytes == 0x2000 * 1024 * 1024, "the low half kept")
    expect(engines.polaris10(0x67DF) && engines.polaris10(0x67C0) && engines.polaris10(0x6FDF) && !engines.polaris10(0x67EF) && !engines.polaris10(0x699F), "which cards are a Polaris 10")
    expect(engines.kickerP20(0x67DF, 0xE7) && !engines.kickerP20(0x67DF, 0xC7) && engines.kickerP30(0x67DF, 0xE1), "Linux's kickers")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    if !loadFiles() {
        say("the firmware files could not be read (run from the repository's top)\n")
        return 5
    }
    theStage()
    theLoader()
    theCard()
    otherwise()
    running()
    refusals()
    if failed != 0 { return failed }
    return 13
}
