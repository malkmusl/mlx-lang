const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const encoder = @import("../compiler/selfhost/backend/x86_64/encoder.mlx")
const target = @import("../compiler/selfhost/backend/x86_64/target.mlx")

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    var value = encoder.init(allocator)
    encoder.emitMovRegImm64(&value, target.Register.rax, 42)
    if encoder.pos(&value) != 5 || value.buf.*.items[0] != 184 || value.buf.*.items[1] != 42 { return 1 }
    encoder.emitMovRegImm64(&value, target.Register.r8, 4294967295)
    if encoder.pos(&value) != 11 || value.buf.*.items[5] != 65 || value.buf.*.items[6] != 184 || value.buf.*.items[10] != 255 { return 2 }
    encoder.emitMovRegImm64(&value, target.Register.rax, 4294967296)
    if encoder.pos(&value) != 21 || value.buf.*.items[11] != 72 || value.buf.*.items[12] != 184 || value.buf.*.items[17] != 1 { return 3 }
    encoder.emitAluImm(&value, target.Register.rax, 7, 0, 5)
    if encoder.pos(&value) != 25 || value.buf.*.items[21] != 72 || value.buf.*.items[22] != 131 || value.buf.*.items[23] != 192 || value.buf.*.items[24] != 7 { return 4 }
    encoder.emitAluImm(&value, target.Register.rax, -129, 7, 61)
    if encoder.pos(&value) != 31 || value.buf.*.items[25] != 72 || value.buf.*.items[26] != 61 || value.buf.*.items[27] != 127 || value.buf.*.items[30] != 255 { return 5 }
    encoder.emitIMulImm(&value, target.Register.rcx, target.Register.rcx, 8)
    if encoder.pos(&value) != 35 || value.buf.*.items[31] != 72 || value.buf.*.items[32] != 107 || value.buf.*.items[33] != 201 || value.buf.*.items[34] != 8 { return 6 }
    encoder.deinit(&value)
    return 13
}
