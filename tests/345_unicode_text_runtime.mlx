// std.unicode's text parts through their native API: the properties of
// code points (categories, scripts, numeric values, simple case,
// terminal widths), full case mapping with a language's rules,
// normalization, grapheme clusters and words, collation by a locale's
// tailoring and by rules, IDNA (UTS #46) both ways and its errors seen
// as unicode.Error, charset detection, the single-byte charsets, the
// bidirectional algorithm, string search by collation, converters between
// charsets. None of it needs cldr.dat.
// Exits 13.
const std = @import("std")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")
const properties = @import("std.unicode.properties")
const casing = @import("std.unicode.casing")
const normalize = @import("std.unicode.normalize")
const breaks = @import("std.unicode.breaks")
const collation = @import("std.unicode.collation")
const idna = @import("std.unicode.idna")
const charsets = @import("std.unicode.charsets")
const charmaps = @import("std.unicode.charmaps")
const bidi = @import("std.unicode.bidi")
const search = @import("std.unicode.search")
const converters = @import("std.unicode.converters")

fn same(allocator: utf.Allocator, made: []const u8, expected: []const u8) -> bool {
    const equal = std.text.same(made, expected)
    utf.free8(allocator, made)
    return equal
}

fn properties_() -> u8 {
    if properties.generalCategory(65) != properties.GeneralCategory.uppercaseLetter { return 1 }
    if properties.generalCategory(1633) != properties.GeneralCategory.decimalNumber || properties.decimalValue(1633).? != 1 { return 1 }
    if properties.numericValue(189).? != 0.5 || properties.numericValue(65) != null { return 1 }
    if !properties.isAlphabetic(19968) || properties.isAlphabetic(48) || !properties.isWhiteSpace(12288) { return 1 }
    if properties.toUpper(223) != 223 || properties.toUpper(255) != 376 || properties.foldCase(7838) != 223 { return 1 }
    if properties.scriptOf(1488) != properties.SCRIPT_HEBREW || !std.text.same(properties.scriptCodeName(properties.SCRIPT_CYRILLIC), "Cyrl") { return 1 }
    if properties.scriptNamed("old italic").? != 30 || !properties.usesScript(1600, properties.SCRIPT_ARABIC) { return 1 }
    if properties.columnWidth(65) != 1 || properties.columnWidth(769) != 0 || properties.columnWidth(12354) != 2 || properties.columnWidth(128512) != 2 || properties.columnWidth(4449) != 0 { return 1 }
    if properties.textWidth("日本語 ok") != 9 { return 1 }
    if properties.eastAsianWidthOf(65377) != properties.EastAsianWidth.halfwidth { return 1 }
    return 0
}

fn run() -> !u8 {
    if properties_() != 0 { return 1 }
    const allocator = std.page_allocator.init()
    if !same(allocator, try casing.toUpper(allocator, "straße", ""), "STRASSE") { return 2 }
    if !same(allocator, try casing.toUpper(allocator, "istanbul", "tr"), "İSTANBUL") { return 2 }
    if !same(allocator, try casing.toLower(allocator, "ΌΣΟΣ", ""), "όσος") { return 2 }
    if !same(allocator, try casing.fold(allocator, "Maße", false), "masse") { return 2 }

    if !same(allocator, try normalize.normalizeText(allocator, normalize.Form.nfc, "e\u{301}\u{323}"), "\u{1eb9}\u{301}") { return 3 }
    if !same(allocator, try normalize.normalizeText(allocator, normalize.Form.nfkd, "ﬁ①"), "fi1") { return 3 }
    if try normalize.isNormalized(allocator, normalize.Form.nfd, "é") { return 3 }

    if (try breaks.count(allocator, breaks.Kind.grapheme, "e\u{301}👍🏽🇩🇪👨‍👩‍👧")) != 4 { return 4 }
    var words = try breaks.open(allocator, breaks.Kind.word, "Hello, wörld!", "")
    var ends: [8]usize = undefined
    var found: usize = 0
    while found < 8 {
        const end = breaks.next(&words)
        if end == null { break }
        ends[found] = end.?
        found += 1
    }
    breaks.close(&words)
    // "Hello" "," " " "wörld" "!": byte offsets, ö taking two.
    if found != 5 || ends[0] != 5 || ends[1] != 6 || ends[2] != 7 || ends[3] != 13 || ends[4] != 14 { return 4 }

    var swedish = try collation.openCollator("sv")
    if collation.compareText(&swedish, "z", "ö") != collation.Order.less { return 5 }
    collation.closeCollator(&swedish)
    var german = try collation.openCollator("de")
    if collation.compareText(&german, "z", "ö") != collation.Order.greater { return 5 }
    collation.setStrength(&german, collation.Strength.primary)
    if collation.compareText(&german, "Äpfel", "apfel") != collation.Order.equal { return 5 }
    collation.closeCollator(&german)
    var numeric = try collation.openCollator("en-u-kn")
    if collation.compareText(&numeric, "item 9", "item 10") != collation.Order.less { return 5 }
    collation.closeCollator(&numeric)
    var ruled = try collation.openRules(allocator, "&a < c < b")
    if collation.compareText(&ruled, "b", "c") != collation.Order.greater { return 5 }
    collation.closeCollator(&ruled)

    if !same(allocator, try idna.toAscii(allocator, "Bücher.example"), "xn--bcher-kva.example") { return 6 }
    if !same(allocator, try idna.toUnicode(allocator, "xn--fsq.jp"), "例.jp") { return 6 }

    const detected = charsets.detect("\xef\xbb\xbfplain text")
    if detected == null || !std.text.same(detected.?.name, "UTF-8") { return 7 }

    var map: charmaps.Charmap = undefined
    if !charmaps.find("Latin-2", &map) || !std.text.same(charmaps.nameOf(map), "ISO-8859-2") { return 8 }
    if charmaps.decode(map, 161) != 260 || charmaps.encode(map, 260) != 161 || charmaps.decode(map, 0) != 0 { return 8 }
    if charmaps.encode(map, 8364) != charmaps.NONE { return 8 }
    if !charmaps.find("cp866", &map) || charmaps.decode(map, 128) != 1040 { return 8 }
    // ISO-8859-9 is windows-1254 with the C1 controls.
    if !charmaps.find("iso_8859-9", &map) || charmaps.decode(map, 128) != 128 || charmaps.encode(map, 8364) != charmaps.NONE || charmaps.encode(map, 286) != 208 { return 8 }
    if !charmaps.find("windows-1254", &map) || charmaps.decode(map, 128) != 8364 { return 8 }
    if charmaps.find("ISO-8859-1", &map) || charmaps.find("Shift_JIS", &map) { return 8 }

    if bidi.baseDirection("123 \u{5e9}\u{5dc}") != bidi.Direction.rtl || bidi.baseDirection("12") != bidi.Direction.neutral { return 9 }
    // "abc ABC" with ABC Hebrew: the Hebrew at level 1, shown reversed.
    const levels = try bidi.resolveLevels(allocator, "abc \u{5d0}\u{5d1}\u{5d2}", bidi.DEFAULT_LTR)
    if levels.length != 7 || levels[0] != 0 || levels[3] != 0 || levels[4] != 1 || levels[6] != 1 { return 9 }
    const order = try bidi.visualOrder(allocator, levels)
    if order[3] != 3 || order[4] != 6 || order[6] != 4 { return 9 }
    // In an RTL paragraph the Latin is at level 2, after the Hebrew.
    const rtl = try bidi.resolveLevels(allocator, "\u{5d0} abc 12", bidi.DEFAULT_LTR)
    if rtl[0] != 1 || rtl[2] != 2 || rtl[6] != 2 { return 9 }

    // "resume" in "My Résumé" at the primary level; not at the tertiary,
    // but there with the pattern's base letters wildcards.
    var english = try collation.openCollator("en")
    collation.setStrength(&english, collation.Strength.primary)
    var hit: search.Match = undefined
    const primary = try search.find(allocator, &english, "resume", "My R\u{e9}sum\u{e9}", 0, false, &hit)
    if !primary || hit.start != 3 || hit.end != 11 { return 10 }
    collation.setStrength(&english, collation.Strength.tertiary)
    const tertiary = try search.find(allocator, &english, "resume", "My R\u{e9}sum\u{e9}", 0, false, &hit)
    if tertiary { return 10 }
    collation.setStrength(&english, collation.Strength.secondary)
    const wildcard = try search.find(allocator, &english, "resume", "R\u{e9}sum\u{e9} and resume", 0, true, &hit)
    if !wildcard || hit.start != 0 { return 10 }
    const last = try search.findLast(allocator, &english, "resume", "R\u{e9}sum\u{e9} and resume", 30, true, &hit)
    if !last || hit.start != 13 || hit.end != 19 { return 10 }
    collation.closeCollator(&english)

    // Converters: KOI8-R and UTF-16LE both ways, an illegal UTF-8 byte
    // read as U+FFFD, a character Latin-1 has not written as 0x1A.
    const russian = try converters.decode(allocator, "koi8-r", "\xf2\xd5\xd3\xd8")
    if !same(allocator, russian, "\u{420}\u{443}\u{441}\u{44c}") { return 11 }
    const koi = try converters.encode(allocator, "KOI8-R", "\u{420}\u{443}\u{441}\u{44c}")
    if !same(allocator, koi, "\xf2\xd5\xd3\xd8") { return 11 }
    const wide = try converters.encode(allocator, "UTF-16LE", "a\u{1f600}")
    if !same(allocator, wide, "a\x00\x3d\xd8\x00\xde") { return 11 }
    const narrow = try converters.decode(allocator, "utf-16le", "a\x00\x3d\xd8\x00\xde")
    if !same(allocator, narrow, "a\u{1f600}") { return 11 }
    const broken = try converters.decode(allocator, "UTF-8", "a\xffb")
    if !same(allocator, broken, "a\u{fffd}b") { return 11 }
    const latin = try converters.encode(allocator, "latin1", "\u{e9}\u{20ac}")
    if !same(allocator, latin, "\xe9\x1a") { return 11 }
    return 13
}

pub fn main() -> !void {
    const code = try run()
    _ = std.linux.syscall1(231, @intCast(usize, code))
}
