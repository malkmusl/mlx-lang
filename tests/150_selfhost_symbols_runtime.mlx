const lexer = @import("../compiler/selfhost/lexer.zin")
const parser_module = @import("../compiler/selfhost/parser.zin")
const symbols = @import("../compiler/selfhost/symbols.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

pub fn main() -> u8 {
    const source = "pub const alpha: u8 = 1\nvar beta: u8 = 2\nfn run() -> void { return }\nconst alpha: u16 = 3\n"
    const allocator = page_allocator.init()
    const tokens = lexer.scanAll(allocator, source)
    var nodes = parser_module.initStore(allocator, tokens.length * 2)
    var parser = parser_module.init(source, tokens, &nodes)
    const root = parser_module.parse(&parser)
    if parser.errorCount != 0 { return 1 }

    var store = symbols.initStore(allocator, 4)
    var root_scope = symbols.initRootScope(allocator, 4)
    if symbols.collectRoot(source, tokens, &nodes, root, &store, &root_scope) != 1 { return 2 }
    if store.length != 3 || root_scope.length != 3 { return 3 }

    const alpha = symbols.symbolAt(&store, 0)
    if alpha.*.nameLength != 5 || alpha.*.flags & symbols.FLAG_CONSTANT == 0 || alpha.*.flags & symbols.FLAG_PUBLIC == 0 { return 4 }
    const alpha_lookup = symbols.lookup(&root_scope, alpha.*.namePointer, alpha.*.nameLength)
    if !alpha_lookup.0 || alpha_lookup.1 != 0 { return 5 }

    const run = symbols.symbolAt(&store, 2)
    if run.*.flags & symbols.FLAG_FUNCTION == 0 || run.*.flags & symbols.FLAG_CONSTANT == 0 { return 6 }
    alpha.*.state = symbols.State.initialized
    if !symbols.markMoved(alpha) { return 7 }
    if alpha.*.state != symbols.State.moved { return 8 }

    var child = symbols.initChildScope(allocator, &root_scope, 2)
    const beta = symbols.symbolAt(&store, 1)
    const inherited = symbols.lookup(&child, beta.*.namePointer, beta.*.nameLength)
    if !inherited.0 || inherited.1 != 1 { return 9 }
    if !symbols.define(&child, alpha.*.namePointer, alpha.*.nameLength, 99) { return 10 }
    const shadow = symbols.lookup(&child, alpha.*.namePointer, alpha.*.nameLength)
    if !shadow.0 || shadow.1 != 99 { return 11 }

    symbols.deinitScope(&child)
    symbols.deinitScope(&root_scope)
    symbols.deinitStore(&store)
    parser_module.deinitStore(&nodes)
    lexer.deinit(tokens)
    return 13
}
