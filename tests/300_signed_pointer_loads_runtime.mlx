// A narrow signed value read through a pointer (`pointer.*`, with the
// pointer typed or made by @ptrFromInt) is sign-extended like any other
// load of its type: -1 read back as i8, i16 or i32 compares below zero and
// equal to -1, through a store as well. And @frameAddress(): the frame
// pointer, with the caller's stack arguments two words above it. Exits 13
// on success.
fn loadI32(address: usize) -> i32 {
    unsafe { return @ptrFromInt(*i32, address).* }
}

fn loadI16(address: usize) -> i16 {
    unsafe { return @ptrFromInt(*i16, address).* }
}

fn loadI8(pointer: *const i8) -> i8 { return pointer.* }

fn storeI32(pointer: *i32, value: i32) -> void { pointer.* = value }

// The seventh and eighth integer arguments arrive on the stack, at the
// frame's third and fourth words.
fn eighth(a: usize, b: usize, c: usize, d: usize, e: usize, f: usize, g: usize, h: usize) -> usize {
    const frame = @frameAddress()
    var seventh: usize = 0
    var last: usize = 0
    unsafe {
        seventh = @ptrFromInt(*usize, frame + 16).*
        last = @ptrFromInt(*usize, frame + 24).*
    }
    if seventh != g || last != h { return 0 }
    return a + b + c + d + e + f + g + h
}

pub fn main() -> u8 {
    var wide: i32 = -1
    var half: i16 = -2
    var small: i8 = -3
    if loadI32(@intFromPtr(&wide)) >= 0 { return 1 }
    if loadI32(@intFromPtr(&wide)) != -1 { return 2 }
    if loadI16(@intFromPtr(&half)) >= 0 { return 3 }
    if loadI16(@intFromPtr(&half)) != -2 { return 4 }
    if loadI8(&small) >= 0 { return 5 }
    if loadI8(&small) != -3 { return 6 }
    const pointer: *i32 = &wide
    if pointer.* >= 0 || pointer.* != -1 { return 7 }
    storeI32(pointer, -200000)
    if pointer.* != -200000 || wide != -200000 { return 8 }
    const widened: i64 = @intCast(i64, pointer.*)
    if widened != -200000 { return 9 }
    if eighth(1, 2, 3, 4, 5, 6, 700, 8000) != 8721 { return 10 }
    var local: u64 = 0
    if @frameAddress() <= @intFromPtr(&local) { return 11 }
    return 13
}
