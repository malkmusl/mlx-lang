// Our Vulkan driver's stage (b), compute (projects/brix/vulkan: memory.mlx,
// pipeline.mlx, commands.mlx, queue.mlx, selftest.mlx over driver.mlx),
// built for the host, reached through std.vulkan.loader's native path over
// the host card (card_host.mlx), whose submits are executed (tests/508):
// - every command of the stage against what the registry (std/registry/
//   vulkan/vk.xml) says of it: each result one of its success or error
//   codes; memory of every type, a heap that is full, a type that the
//   processor does not map, a mapping asked twice; a buffer's needs and
//   its binding at an offset that is not aligned; a shader module that is
//   no SPIR-V; a pipeline whose shader the compiler does not take (OpFRem)
//   or whose layout lacks the binding: VK_ERROR_UNKNOWN; a pool that is
//   full: VK_ERROR_OUT_OF_POOL_MEMORY and no set left made, and after its
//   reset the same addresses again; fences made signalled, reset, never
//   given (VK_TIMEOUT, VK_NOT_READY), given; the queue and the device idle;
// - the words the commands write, as the study's 4.3 has them: a dispatch's
//   pipeline (15 words, COMPUTE_RESOURCE_LIMITS by the record), set 0's and
//   the push block's 64-bit addresses in user data 2..5 (code below 4 GiB,
//   the rest above), DISPATCH_DIRECT 0x45; std.gpu's barrier as
//   CS_PARTIAL_FLUSH and ACQUIRE_MEM 0x08C40000 before the next dispatch;
// - the six silent needs of the second reading, each: (1) division by a
//   variable on the first frame (the divider at the edges through std.gpu,
//   and with the card's reciprocal a unit or two low it holds, a unit high
//   it does not); (2) the invalidation at every submit (std.gpu's second
//   frame reads stale descriptors without the preamble's scalar cache
//   action: the device is lost, with it it runs); (3) the five wait states
//   (a program without them is refused by the card and loses the device,
//   with s_nop 4 it runs) and s_waitcnt before s_endpgm (refused without);
//   (4) the compute units and shader engines from the record (no counts:
//   vkCreateDevice refused; 9 an engine: FORCE_SIMD_DIST; 8: none); (5) the
//   pointers in even pairs (above); (6) the copy engine's rules: 5 MiB
//   copied in packets of at most 2 097 120 bytes, a fill's last packet and
//   a stream's end with CP_SYNC, words equal;
// - std.gpu's nine kernels (tests/497's own cases: pattern, nv12, text,
//   paint, blit, both blurs, warp, shrink) run through std.gpu over our
//   driver, every word equal to the processor's;
// - the existing tests that pick a driver through the loader run over our
//   driver (253: a fill and a copy; 254: the doubler; 263: text against
//   std.truetype.drawRun);
// - the self-test at vkCreateDevice: passing, and failing with the
//   compiler's output made wrong (the doubler's add turned into a
//   subtraction): VK_ERROR_INITIALIZATION_FAILED, the first wrong word 1;
//   its division (the review's) refusing a card whose reciprocal is a
//   unit high, passing one two units low;
// - the review's further: a copy, a barrier from the transfers, the
//   doubler over what was copied (the barrier's zero-byte CP_SYNC); a
//   shader that writes s15 runs (RSRC1 gives 32: VCC's two beyond 16);
//   the preamble not written by a submit;
// - a lost device: every later submit and wait says so.
// Run from the repository root. With an argument, each failing check is
// printed.
// Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const gpu = @import("std.gpu")
const shaders = @import("std.gpu.shaders")
const builder = @import("std.spirv.builder")
const compute = @import("std.spirv.compute")
const spv = @import("std.spirv.core")
const gpucard = @import("std.gpucard")
const host = @import("../projects/brix/vulkan/card_host.mlx")
const run = @import("../projects/brix/vulkan/card_run.mlx")
const cache = @import("../projects/brix/vulkan/card_cache.mlx")
const driver = @import("../projects/brix/vulkan/driver.mlx")
const commands = @import("../projects/brix/vulkan/commands.mlx")
const pipeline = @import("../projects/brix/vulkan/pipeline.mlx")
const queue = @import("../projects/brix/vulkan/queue.mlx")
const selftest = @import("../projects/brix/vulkan/selftest.mlx")
const packets = @import("../projects/brix/vulkan/packets.mlx")
const shader = @import("../projects/brix/vulkan/shader.mlx")
const code_module = @import("../projects/brix/vulkan/shader_code.mlx")
const encode = @import("../projects/brix/vulkan/encode.mlx")
const decode = @import("../projects/brix/vulkan/decode.mlx")
const isa = @import("../projects/brix/vulkan/isa.mlx")
const wave = @import("../projects/brix/vulkan/wave.mlx")
const ir = @import("../projects/brix/vulkan/shader_ir.mlx")
const memory_module = @import("../projects/brix/vulkan/memory.mlx")
const doubler = @import("./support/spirv/doubler.mlx")
const kernels = @import("./497_gcn_compiler_runtime.mlx")
const t253 = @import("./253_vulkan_loader_runtime.mlx")
const t254 = @import("./254_spirv_compute_runtime.mlx")
const t263 = @import("./263_vulkan_text_runtime.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }
fn sayNumber(value: u64) -> void { _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, value)) }

var failed: u8 = 0
var show = false

fn check(number: u8, holds: bool) -> void {
    if holds { return }
    if failed == 0 { failed = number }
    if show {
        say("check ")
        sayNumber(@intCast(u64, number))
        say(" fails")
        const r = host.report()
        if r.*.failure != run.Failure.none {
            say(" (host card: ")
            say(run.failureText(r.*.failure))
            say(", stream ")
            sayNumber(@intCast(u64, r.*.stream))
            say(" word ")
            sayNumber(@intCast(u64, r.*.word))
            say(")")
        }
        say("\n")
    }
}

fn equal(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// The registry's codes of a command (its <command> tag)

var registry: [*]const u8 = undefined
var registryLength: usize = 0

fn readRegistry() -> bool {
    const loaded = std.fs.readFileAlloc("std/registry/vulkan/vk.xml".pointer, std.heap.allocator())
    if loaded == null { return false }
    registry = loaded.?.items
    registryLength = loaded.?.length
    return true
}

fn at(offset: usize, text: []const u8) -> bool {
    if offset + text.length > registryLength { return false }
    var k: usize = 0
    while k < text.length {
        if registry[offset + k] != text[k] { return false }
        k += 1
    }
    return true
}

// The registry's text of the tag that begins the command `name` (the
// first: the "vulkan" one comes before vulkansc's), or an empty slice.
fn tagOf(name: []const u8) -> []const u8 {
    var k: usize = 0
    while k + name.length + 13 < registryLength {
        if at(k, "<name>") && at(k + 6, name) && at(k + 6 + name.length, "</name></proto>") {
            var start = k
            while start > 0 && !at(start, "<command") { start -= 1 }
            var end = start
            while end < k && registry[end] != 62 { end += 1 }
            return registry[start..end]
        }
        k += 1
    }
    return registry[0..0]
}

// Whether `code` is in the attribute `attribute` of `tag`.
fn listed(tag: []const u8, attribute: []const u8, code: []const u8) -> bool {
    var k: usize = 0
    while k + attribute.length < tag.length {
        if equal(tag[k..k + attribute.length], attribute) {
            var start = k + attribute.length
            while start < tag.length && tag[start] != 34 {
                var end = start
                while end < tag.length && tag[end] != 44 && tag[end] != 34 { end += 1 }
                if equal(tag[start..end], code) { return true }
                start = if end < tag.length && tag[end] == 44 { end + 1 } else { end }
            }
            return false
        }
        k += 1
    }
    return false
}

fn resultName(result: vk.Result) -> []const u8 {
    if result == vk.Result.success { return "VK_SUCCESS" }
    if result == vk.Result.notReady { return "VK_NOT_READY" }
    if result == vk.Result.timeout { return "VK_TIMEOUT" }
    if result == vk.Result.errorOutOfHostMemory { return "VK_ERROR_OUT_OF_HOST_MEMORY" }
    if result == vk.Result.errorOutOfDeviceMemory { return "VK_ERROR_OUT_OF_DEVICE_MEMORY" }
    if result == vk.Result.errorInitializationFailed { return "VK_ERROR_INITIALIZATION_FAILED" }
    if result == vk.Result.errorDeviceLost { return "VK_ERROR_DEVICE_LOST" }
    if result == vk.Result.errorMemoryMapFailed { return "VK_ERROR_MEMORY_MAP_FAILED" }
    if result == vk.Result.errorOutOfPoolMemory { return "VK_ERROR_OUT_OF_POOL_MEMORY" }
    if result == vk.Result.errorFragmentedPool { return "VK_ERROR_FRAGMENTED_POOL" }
    if result == vk.Result.errorUnknown { return "VK_ERROR_UNKNOWN" }
    return "?"
}

// `result` of `command` is one the registry gives it.
fn gave(number: u8, command: []const u8, result: vk.Result) -> void {
    const tag = tagOf(command)
    const name = resultName(result)
    check(number, tag.length > 0 && (listed(tag, "successcodes=\"", name) || listed(tag, "errorcodes=\"", name)))
}

// ---------------------------------------------------------------------------
// The driver over the host card, through the loader

var global: vk.GlobalCommands = undefined
var instanceCommands: vk.InstanceCommands = undefined
var deviceCommands: vk.DeviceCommands = undefined
var opened: loader.Driver = undefined
var instance: vk.Instance = 0
var physical: vk.PhysicalDevice = 0
var device: vk.Device = 0
var memoryProperties: vk.PhysicalDeviceMemoryProperties = undefined

// An argument list whose environment names no manifest of the host's.
var block: [3][*]const u8 = undefined

fn noManifests() -> [][*]const u8 {
    block[0] = unsafe { @ptrFromInt([*]const u8, 0) }
    block[1] = "VK_DRIVER_FILES=/nonexistent/none.json".pointer
    block[2] = unsafe { @ptrFromInt([*]const u8, 0) }
    return block[0..0]
}

// A card (the user's RX 580 with a compute ring, its GART on when
// `system`), the driver offered and opened through the loader.
fn card(system: bool) -> void {
    host.reset()
    var facts = host.rx580(1)
    if system { facts.flags |= gpucard.Flag.SYSTEM_MEMORY }
    _ = host.add(&facts)
    _ = driver.offer(host.interface())
    var manifests: loader.Manifests = undefined
    _ = loader.findDrivers(&manifests, noManifests(), std.heap.allocator())
    _ = loader.openDriver(&opened, loader.manifestAt(&manifests, 0), std.heap.allocator())
}

fn makeDevice() -> vk.Result {
    var application = vk.ApplicationInfo.init()
    application.apiVersion = vk.API_VERSION_1_1
    var info = vk.InstanceCreateInfo.init()
    info.pApplicationInfo = &application
    instance = 0
    _ = vk.createInstance(opened.global, &info, null, &instance)
    vk.loadInstanceCommands(&instanceCommands, instance, opened.getInstanceProcAddr)
    var count: u32 = 1
    physical = 0
    _ = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, unsafe { @ptrCast([*]vk.PhysicalDevice, &physical) })
    vk.getPhysicalDeviceMemoryProperties(&instanceCommands, physical, &memoryProperties)
    var queueInfo = vk.DeviceQueueCreateInfo.init()
    queueInfo.queueFamilyIndex = 0
    queueInfo.queueCount = 1
    var priority: u32 = 1065353216
    queueInfo.pQueuePriorities = unsafe { @ptrCast([*]const f32, &priority) }
    var deviceInfo = vk.DeviceCreateInfo.init()
    deviceInfo.queueCreateInfoCount = 1
    deviceInfo.pQueueCreateInfos = unsafe { @ptrCast([*]const vk.DeviceQueueCreateInfo, &queueInfo) }
    device = 0
    const made = vk.createDevice(&instanceCommands, physical, &deviceInfo, null, &device)
    if made == vk.Result.success { vk.loadDeviceCommands(&deviceCommands, device, instanceCommands.vkGetDeviceProcAddr) }
    return made
}

fn dropDevice() -> void {
    if device != 0 { vk.destroyDevice(&deviceCommands, device, null) }
    device = 0
    if instance != 0 { vk.destroyInstance(&instanceCommands, instance, null) }
    instance = 0
}

// The first memory type with `flags` (all of them).
fn typeWith(flags: u32) -> u32 {
    var k: u32 = 0
    while k < memoryProperties.memoryTypeCount {
        if (memoryProperties.memoryTypes[k].propertyFlags & flags) == flags { return k }
        k += 1
    }
    return 0xFFFFFFFF
}

// A buffer of `bytes` in memory of type `kind`, bound (and mapped at
// `mapped` when not null).
fn makeBuffer(bytes: u64, kind: u32, buffer: *vk.Buffer, memory: *vk.DeviceMemory, mapped: ?*usize) -> bool {
    var info = vk.BufferCreateInfo.init()
    info.size = bytes
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    if vk.createBuffer(&deviceCommands, device, &info, null, buffer) != vk.Result.success { return false }
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(&deviceCommands, device, buffer.*, &requirements)
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.allocationSize = requirements.size
    allocation.memoryTypeIndex = kind
    if vk.allocateMemory(&deviceCommands, device, &allocation, null, memory) != vk.Result.success { return false }
    if vk.bindBufferMemory(&deviceCommands, device, buffer.*, memory.*, 0) != vk.Result.success { return false }
    if mapped != null {
        var address: ?*anyopaque = null
        if vk.mapMemory(&deviceCommands, device, memory.*, 0, vk.WHOLE_SIZE, 0, &address) != vk.Result.success { return false }
        mapped.?.* = @intFromPtr(address.?)
    }
    return true
}

// ---------------------------------------------------------------------------
// The commands, each against the registry

fn testMemory() -> void {
    card(true)
    check(1, makeDevice() == vk.Result.success && device != 0)
    // (No device: nothing more of this part can run.)
    if device == 0 { return }
    // The three types of 7.2 (and the reachable part of the card's
    // memory): device local; host visible and coherent; and cached.
    const local = typeWith(vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
    const visible = typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT)
    const cached = typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_CACHED_BIT)
    check(2, local != 0xFFFFFFFF && visible != 0xFFFFFFFF && cached != 0xFFFFFFFF)
    var kind: u32 = 0
    while kind < memoryProperties.memoryTypeCount {
        var allocation = vk.MemoryAllocateInfo.init()
        allocation.allocationSize = 100000
        allocation.memoryTypeIndex = kind
        var memory: vk.DeviceMemory = 0
        var result = vk.allocateMemory(&deviceCommands, device, &allocation, null, &memory)
        gave(3, "vkAllocateMemory", result)
        check(4, result == vk.Result.success && memory != 0)
        var mapped: ?*anyopaque = null
        result = vk.mapMemory(&deviceCommands, device, memory, 4, vk.WHOLE_SIZE, 0, &mapped)
        gave(5, "vkMapMemory", result)
        const host_visible = (memoryProperties.memoryTypes[kind].propertyFlags & vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT) != 0
        check(6, (result == vk.Result.success) == host_visible && (result == vk.Result.errorMemoryMapFailed) != host_visible)
        if host_visible {
            // Zeroed; asked twice: refused; unmapped and asked again: the
            // same bytes.
            const bytes: [*]u8 = unsafe { @ptrCast([*]u8, mapped.?) }
            check(7, bytes[0] == 0 && bytes[99995] == 0)
            var again: ?*anyopaque = null
            check(8, vk.mapMemory(&deviceCommands, device, memory, 0, vk.WHOLE_SIZE, 0, &again) == vk.Result.errorMemoryMapFailed)
            vk.unmapMemory(&deviceCommands, device, memory)
            check(9, vk.mapMemory(&deviceCommands, device, memory, 0, vk.WHOLE_SIZE, 0, &again) == vk.Result.success && @intFromPtr(again.?) + 4 == @intFromPtr(mapped.?))
        }
        vk.freeMemory(&deviceCommands, device, memory, null)
        kind += 1
    }
    // A heap's bytes, all taken: the next allocation is refused.
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.memoryTypeIndex = cached
    allocation.allocationSize = memoryProperties.memoryHeaps[memoryProperties.memoryTypes[cached].heapIndex].size + 4096
    var memory: vk.DeviceMemory = 7
    var result = vk.allocateMemory(&deviceCommands, device, &allocation, null, &memory)
    gave(10, "vkAllocateMemory", result)
    check(11, result == vk.Result.errorOutOfDeviceMemory && memory == 0)
    allocation.memoryTypeIndex = memoryProperties.memoryTypeCount
    allocation.allocationSize = 4096
    check(12, vk.allocateMemory(&deviceCommands, device, &allocation, null, &memory) == vk.Result.errorOutOfDeviceMemory)
    // A buffer: its needs, its binding.
    var buffer: vk.Buffer = 0
    var info = vk.BufferCreateInfo.init()
    info.size = 1001
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT
    result = vk.createBuffer(&deviceCommands, device, &info, null, &buffer)
    gave(13, "vkCreateBuffer", result)
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(&deviceCommands, device, buffer, &requirements)
    check(14, requirements.size >= 1001 && requirements.size % requirements.alignment == 0 && requirements.alignment % 4 == 0 && requirements.memoryTypeBits == (@intCast(u32, 1) << @intCast(u5, memoryProperties.memoryTypeCount)) - 1)
    allocation.memoryTypeIndex = visible
    allocation.allocationSize = requirements.size * 2
    check(15, vk.allocateMemory(&deviceCommands, device, &allocation, null, &memory) == vk.Result.success)
    result = vk.bindBufferMemory(&deviceCommands, device, buffer, memory, 4)
    gave(16, "vkBindBufferMemory", result)
    check(17, result != vk.Result.success && vk.bindBufferMemory(&deviceCommands, device, buffer, memory, requirements.alignment) == vk.Result.success)
    vk.destroyBuffer(&deviceCommands, device, buffer, null)
    vk.freeMemory(&deviceCommands, device, memory, null)
    dropDevice()
    check(18, host.living() == 0 && host.memoryObjects() == 0 && host.mappings() == 0 && host.fences() == 0)
}

// A storage buffer kernel of `common` with one binding, no push words:
// the shader module of a kernel built here.
var spirvWords: [8192]u32 = undefined

fn moduleOf(words: []const u32, into: *vk.ShaderModule) -> vk.Result {
    var info = vk.ShaderModuleCreateInfo.init()
    info.codeSize = words.length * 4
    info.pCode = words.pointer
    return vk.createShaderModule(&deviceCommands, device, &info, null, into)
}

fn doublerWords() -> []const u32 {
    const allocator = std.page_allocator.init()
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    doubler.build(&b)
    const count = builder.wordCount(&b)
    builder.writeWords(&b, unsafe { @ptrCast([*]u32, &spirvWords[0]) })
    return spirvWords[0..count]
}

// A kernel with a float (the compiler of this stage takes integers alone).
fn floatWords() -> []const u32 {
    const allocator = std.page_allocator.init()
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    var common: compute.Kernel = undefined
    compute.declare(&b, &common, 1, 1, true)
    const main = builder.function(&b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    _ = builder.label(&b)
    const id = builder.load(&b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(&b, common.uint, id, 0)
    const asFloat = builder.unary(&b, spv.Op.convertUToF, common.float, x)
    const rest = builder.binary(&b, spv.Op.fRem, common.float, asFloat, asFloat)
    builder.store(&b, compute.element(&b, &common, common.buffers[0], x), builder.unary(&b, spv.Op.convertFToU, common.uint, rest))
    builder.returnVoid(&b)
    builder.functionEnd(&b)
    compute.finish(&b, &common, main, 64, 1)
    const count = builder.wordCount(&b)
    builder.writeWords(&b, unsafe { @ptrCast([*]u32, &spirvWords[0]) })
    return spirvWords[0..count]
}

var setLayout: vk.DescriptorSetLayout = 0
var layout: vk.PipelineLayout = 0

fn makeLayouts(bindings: u32, pushBytes: u32) -> void {
    var binding: [2]vk.DescriptorSetLayoutBinding = undefined
    var k: u32 = 0
    while k < 2 {
        binding[k] = vk.DescriptorSetLayoutBinding.init()
        binding[k].binding = k
        binding[k].descriptorType = vk.DescriptorType.storageBuffer
        binding[k].descriptorCount = 1
        binding[k].stageFlags = vk.SHADER_STAGE_COMPUTE_BIT
        k += 1
    }
    var setInfo = vk.DescriptorSetLayoutCreateInfo.init()
    setInfo.bindingCount = bindings
    setInfo.pBindings = &binding
    gave(30, "vkCreateDescriptorSetLayout", vk.createDescriptorSetLayout(&deviceCommands, device, &setInfo, null, &setLayout))
    var range = vk.PushConstantRange.init()
    range.stageFlags = vk.SHADER_STAGE_COMPUTE_BIT
    range.size = pushBytes
    var layoutInfo = vk.PipelineLayoutCreateInfo.init()
    layoutInfo.setLayoutCount = 1
    layoutInfo.pSetLayouts = &setLayout
    layoutInfo.pushConstantRangeCount = if pushBytes > 0 { @intCast(u32, 1) } else { 0 }
    layoutInfo.pPushConstantRanges = &range
    gave(31, "vkCreatePipelineLayout", vk.createPipelineLayout(&deviceCommands, device, &layoutInfo, null, &layout))
}

fn makePipeline(module: vk.ShaderModule, into: *vk.Pipeline) -> vk.Result {
    var info = vk.ComputePipelineCreateInfo.init()
    info.stage = vk.PipelineShaderStageCreateInfo.init()
    info.stage.stage = vk.SHADER_STAGE_COMPUTE_BIT
    info.stage.module = module
    info.stage.pName = "main".pointer
    info.layout = layout
    return vk.createComputePipelines(&deviceCommands, device, 0, 1, &info, null, into)
}

fn testPipelines() -> void {
    card(false)
    check(32, makeDevice() == vk.Result.success)
    // (No device: nothing more of this part can run.)
    if device == 0 { return }
    // No SPIR-V.
    var module: vk.ShaderModule = 0
    const nothing = [4]u32{ 1, 2, 3, 4 }
    var result = moduleOf(nothing[0..], &module)
    gave(33, "vkCreateShaderModule", result)
    check(34, result == vk.Result.errorUnknown && module == 0)
    // The doubler: made; its 15 words as 4.3 A.
    result = moduleOf(doublerWords(), &module)
    gave(35, "vkCreateShaderModule", result)
    makeLayouts(1, 0)
    var made: vk.Pipeline = 0
    result = makePipeline(module, &made)
    gave(36, "vkCreateComputePipelines", result)
    check(37, result == vk.Result.success && made != 0)
    const p = pipeline.pipelineOf(made)
    check(38, p.*.words[0] == 0xC0017600 && p.*.words[1] == 0x20C && p.*.words[2] == @intCast(u32, p.*.code.address >> 8) && p.*.code.address < 0x100000000 && p.*.code.address % 256 == 0)
    check(39, p.*.words[3] == 0xC0027600 && p.*.words[4] == 0x212 && p.*.words[7] == 0xC0017600 && p.*.words[8] == 0x215 && p.*.words[9] == 0x00800000 && p.*.words[10] == 0xC0037600 && p.*.words[11] == 0x207 && p.*.words[12] == 64 && p.*.words[13] == 1 && p.*.words[14] == 1)
    // RSRC1: f32 denormals flushed, DX10 clamp; RSRC2: six user words, the
    // group ids, the local ids.
    check(40, packets.get(p.*.words[5], packets.COMPUTE_PGM_RSRC1__FLOAT_MODE) == 192 && (p.*.words[5] & packets.COMPUTE_PGM_RSRC1__DX10_CLAMP) != 0 && packets.get(p.*.words[6], packets.COMPUTE_PGM_RSRC2__USER_SGPR) == 6)
    // A layout without the doubler's binding: refused.
    makeLayouts(0, 0)
    var refused: vk.Pipeline = 5
    result = makePipeline(module, &refused)
    gave(41, "vkCreateComputePipelines", result)
    check(42, result == vk.Result.errorUnknown && refused == 0)
    // A float operation the compiler does not have yet (OpFRem; floats
    // themselves compile since stage (c)): refused, and it says so.
    var floats: vk.ShaderModule = 0
    _ = moduleOf(floatWords(), &floats)
    makeLayouts(1, 0)
    result = makePipeline(floats, &refused)
    gave(43, "vkCreateComputePipelines", result)
    check(44, result == vk.Result.errorUnknown && pipeline.lastFailure.kind != ir.Failure.none)
    vk.destroyPipeline(&deviceCommands, device, made, null)
    vk.destroyShaderModule(&deviceCommands, device, module, null)
    vk.destroyShaderModule(&deviceCommands, device, floats, null)
    vk.destroyPipelineLayout(&deviceCommands, device, layout, null)
    vk.destroyDescriptorSetLayout(&deviceCommands, device, setLayout, null)
    // A pool of two sets: the third refused, nothing of that call left;
    // after the reset the same addresses again.
    makeLayouts(2, 0)
    var size = vk.DescriptorPoolSize.init()
    size.type_ = vk.DescriptorType.storageBuffer
    size.descriptorCount = 4
    var poolInfo = vk.DescriptorPoolCreateInfo.init()
    poolInfo.maxSets = 2
    poolInfo.poolSizeCount = 1
    poolInfo.pPoolSizes = &size
    var pool: vk.DescriptorPool = 0
    gave(45, "vkCreateDescriptorPool", vk.createDescriptorPool(&deviceCommands, device, &poolInfo, null, &pool))
    var layouts = [2]vk.DescriptorSetLayout{ setLayout, setLayout }
    var allocate = vk.DescriptorSetAllocateInfo.init()
    allocate.descriptorPool = pool
    allocate.descriptorSetCount = 2
    allocate.pSetLayouts = &layouts
    var sets = [2]vk.DescriptorSet{ 0, 0 }
    result = vk.allocateDescriptorSets(&deviceCommands, device, &allocate, &sets)
    gave(46, "vkAllocateDescriptorSets", result)
    check(47, result == vk.Result.success && sets[0] != 0 && sets[1] != 0 && pipeline.setOf(sets[0]).*.address >= 0x100000000)
    const first = pipeline.setOf(sets[0]).*.address
    var more = [2]vk.DescriptorSet{ 9, 9 }
    allocate.descriptorSetCount = 1
    result = vk.allocateDescriptorSets(&deviceCommands, device, &allocate, &more)
    gave(48, "vkAllocateDescriptorSets", result)
    check(49, result == vk.Result.errorOutOfPoolMemory && more[0] == 0)
    gave(50, "vkResetDescriptorPool", vk.resetDescriptorPool(&deviceCommands, device, pool, 0))
    check(51, vk.allocateDescriptorSets(&deviceCommands, device, &allocate, &more) == vk.Result.success && pipeline.setOf(more[0]).*.address == first)
    // A buffer's descriptor (4.5): its address, BASE_ADDRESS_HI, the range
    // rounded up to 4, word 3.
    var buffer: vk.Buffer = 0
    var memory: vk.DeviceMemory = 0
    check(52, makeBuffer(1002, typeWith(vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT), &buffer, &memory, null))
    var range = vk.DescriptorBufferInfo.init()
    range.buffer = buffer
    range.offset = 0
    range.range = 1001
    var write = vk.WriteDescriptorSet.init()
    write.dstSet = more[0]
    write.dstBinding = 1
    write.descriptorCount = 1
    write.descriptorType = vk.DescriptorType.storageBuffer
    write.pBufferInfo = &range
    vk.updateDescriptorSets(&deviceCommands, device, 1, &write, 0, null)
    const words: [*]u32 = unsafe { @ptrFromInt([*]u32, pipeline.setOf(more[0]).*.bytes) }
    const address = memory_module.bufferOf(buffer).*.address
    check(53, words[4] == @intCast(u32, address & 0xFFFFFFFF) && words[5] == @intCast(u32, address >> 32) && words[5] != 0 && words[6] == 1004 && words[7] == 0x27FAC && words[0] == 0)
    vk.destroyDescriptorPool(&deviceCommands, device, pool, null)
    vk.destroyBuffer(&deviceCommands, device, buffer, null)
    vk.freeMemory(&deviceCommands, device, memory, null)
    dropDevice()
}

// ---------------------------------------------------------------------------
// Command buffers and their words

var commandPool: vk.CommandPool = 0
var cb: vk.CommandBuffer = 0

fn makeCommands() -> void {
    var info = vk.CommandPoolCreateInfo.init()
    info.flags = vk.COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
    gave(60, "vkCreateCommandPool", vk.createCommandPool(&deviceCommands, device, &info, null, &commandPool))
    var allocation = vk.CommandBufferAllocateInfo.init()
    allocation.commandPool = commandPool
    allocation.level = vk.CommandBufferLevel.primary
    allocation.commandBufferCount = 1
    gave(61, "vkAllocateCommandBuffers", vk.allocateCommandBuffers(&deviceCommands, device, &allocation, unsafe { @ptrCast([*]vk.CommandBuffer, &cb) }))
}

fn begin() -> void {
    var info = vk.CommandBufferBeginInfo.init()
    info.flags = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
    gave(62, "vkBeginCommandBuffer", vk.beginCommandBuffer(&deviceCommands, cb, &info))
}

// The command buffer submitted with a fence and waited for: the wait's
// answer.
fn submitAndWait() -> vk.Result {
    var fenceInfo = vk.FenceCreateInfo.init()
    var fence: vk.Fence = 0
    gave(63, "vkCreateFence", vk.createFence(&deviceCommands, device, &fenceInfo, null, &fence))
    var submit = vk.SubmitInfo.init()
    submit.commandBufferCount = 1
    submit.pCommandBuffers = unsafe { @ptrCast([*]const vk.CommandBuffer, &cb) }
    var queueHandle: vk.Queue = 0
    vk.getDeviceQueue(&deviceCommands, device, 0, 0, &queueHandle)
    const submitted = vk.queueSubmit(&deviceCommands, queueHandle, 1, &submit, fence)
    gave(64, "vkQueueSubmit", submitted)
    var waited = submitted
    if submitted == vk.Result.success {
        waited = vk.waitForFences(&deviceCommands, device, 1, &fence, vk.TRUE, 1000000000)
        gave(65, "vkWaitForFences", waited)
    }
    vk.destroyFence(&deviceCommands, device, fence, null)
    return waited
}

// The stream's words of the command buffer's first chunk.
fn streamWords() -> [*]const u32 {
    return unsafe { @ptrFromInt([*]const u32, commands.bufferOf(cb).*.chunks[0].bytes) }
}

fn testDispatchWords() -> void {
    card(false)
    check(70, makeDevice() == vk.Result.success)
    // (No device: nothing more of this part can run.)
    if device == 0 { return }
    var module: vk.ShaderModule = 0
    _ = moduleOf(doublerWords(), &module)
    makeLayouts(1, 16)
    var made: vk.Pipeline = 0
    check(71, makePipeline(module, &made) == vk.Result.success)
    var size = vk.DescriptorPoolSize.init()
    size.type_ = vk.DescriptorType.storageBuffer
    size.descriptorCount = 1
    var poolInfo = vk.DescriptorPoolCreateInfo.init()
    poolInfo.maxSets = 1
    poolInfo.poolSizeCount = 1
    poolInfo.pPoolSizes = &size
    var pool: vk.DescriptorPool = 0
    _ = vk.createDescriptorPool(&deviceCommands, device, &poolInfo, null, &pool)
    var allocate = vk.DescriptorSetAllocateInfo.init()
    allocate.descriptorPool = pool
    allocate.descriptorSetCount = 1
    allocate.pSetLayouts = &setLayout
    var set: vk.DescriptorSet = 0
    _ = vk.allocateDescriptorSets(&deviceCommands, device, &allocate, unsafe { @ptrCast([*]vk.DescriptorSet, &set) })
    var buffer: vk.Buffer = 0
    var memory: vk.DeviceMemory = 0
    var mapped: usize = 0
    check(72, makeBuffer(1024, typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT), &buffer, &memory, &mapped))
    var range = vk.DescriptorBufferInfo.init()
    range.buffer = buffer
    range.range = vk.WHOLE_SIZE
    var write = vk.WriteDescriptorSet.init()
    write.dstSet = set
    write.descriptorCount = 1
    write.descriptorType = vk.DescriptorType.storageBuffer
    write.pBufferInfo = &range
    vk.updateDescriptorSets(&deviceCommands, device, 1, &write, 0, null)
    const values: [*]u32 = unsafe { @ptrFromInt([*]u32, mapped) }
    var k: usize = 0
    while k < 256 {
        values[k] = @intCast(u32, k) + 7
        k += 1
    }
    makeCommands()
    begin()
    vk.cmdBindPipeline(&deviceCommands, cb, vk.PipelineBindPoint.compute, made)
    vk.cmdBindDescriptorSets(&deviceCommands, cb, vk.PipelineBindPoint.compute, layout, 0, 1, unsafe { @ptrCast([*]const vk.DescriptorSet, &set) }, 0, null)
    const push = [4]u32{ 1, 2, 3, 4 }
    vk.cmdPushConstants(&deviceCommands, cb, layout, vk.SHADER_STAGE_COMPUTE_BIT, 0, 16, &push)
    vk.cmdDispatch(&deviceCommands, cb, 2, 1, 1)
    // std.gpu's barrier after every dispatch, and a second dispatch.
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_SHADER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_SHADER_READ_BIT | vk.ACCESS_SHADER_WRITE_BIT | vk.ACCESS_HOST_READ_BIT | vk.ACCESS_TRANSFER_READ_BIT
    vk.cmdPipelineBarrier(&deviceCommands, cb, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT | vk.PIPELINE_STAGE_HOST_BIT | vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, null, 0, null)
    vk.cmdDispatch(&deviceCommands, cb, 2, 1, 1)
    vk.cmdPipelineBarrier(&deviceCommands, cb, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT | vk.PIPELINE_STAGE_HOST_BIT | vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, null, 0, null)
    gave(73, "vkEndCommandBuffer", vk.endCommandBuffer(&deviceCommands, cb))
    const w = streamWords()
    const p = pipeline.pipelineOf(made)
    // The first dispatch: the pipeline's 15 words, set 0 in user data 2
    // and 3, the push block in 4 and 5 (above 4 GiB both), the dispatch.
    var same = true
    k = 0
    while k < 15 {
        if w[k] != p.*.words[k] { same = false }
        k += 1
    }
    const setAddress = pipeline.setOf(set).*.address
    check(74, same && w[15] == 0xC0027600 && w[16] == 0x242 && w[17] == @intCast(u32, setAddress & 0xFFFFFFFF) && w[18] == @intCast(u32, setAddress >> 32) && w[18] != 0)
    check(75, w[19] == 0xC0027600 && w[20] == 0x244 && w[22] != 0 && w[23] == 0xC0031502 && w[24] == 2 && w[25] == 1 && w[26] == 1 && w[27] == 0x45)
    // The second: no pipeline words, the barrier's flush first (4.3 B:
    // 0x08C40000, no instruction cache action), then its user data.
    check(76, w[28] == 0xC0004600 && w[29] == 0x407 && w[30] == 0xC0055802 && w[31] == 0x08C40000 && w[32] == 0xFFFFFFFF && w[33] == 0xFF && w[36] == 0xA && w[37] == 0xC0027600 && w[45] == 0xC0031502)
    // The end: the last barrier's flush, padded to 8.
    const cbObject = commands.bufferOf(cb)
    check(77, w[50] == 0xC0004600 && w[53] == 0x08C40000 && cbObject.*.lengths[0] % 8 == 0 && cbObject.*.lengths[0] == 64)
    check(78, submitAndWait() == vk.Result.success)
    k = 0
    var right = true
    while k < 128 {
        // Twice doubled, the index added each time.
        if values[k] != ((@intCast(u32, k) + 7) * 2 + @intCast(u32, k)) * 2 + @intCast(u32, k) { right = false }
        k += 1
    }
    check(79, right && values[128] == 135)
    // Fences: made signalled, waited at once; reset: not ready, the wait
    // times out; the queue and the device idle.
    var fenceInfo = vk.FenceCreateInfo.init()
    fenceInfo.flags = vk.FENCE_CREATE_SIGNALED_BIT
    var fence: vk.Fence = 0
    _ = vk.createFence(&deviceCommands, device, &fenceInfo, null, &fence)
    check(80, vk.waitForFences(&deviceCommands, device, 1, &fence, vk.TRUE, 0) == vk.Result.success && vk.getFenceStatus(&deviceCommands, device, fence) == vk.Result.success)
    gave(81, "vkResetFences", vk.resetFences(&deviceCommands, device, 1, &fence))
    var result = vk.getFenceStatus(&deviceCommands, device, fence)
    gave(82, "vkGetFenceStatus", result)
    check(83, result == vk.Result.notReady && vk.waitForFences(&deviceCommands, device, 1, &fence, vk.TRUE, 1000) == vk.Result.timeout)
    vk.destroyFence(&deviceCommands, device, fence, null)
    var queueHandle: vk.Queue = 0
    vk.getDeviceQueue(&deviceCommands, device, 0, 0, &queueHandle)
    result = vk.queueWaitIdle(&deviceCommands, queueHandle)
    gave(84, "vkQueueWaitIdle", result)
    result = vk.deviceWaitIdle(&deviceCommands, device)
    gave(85, "vkDeviceWaitIdle", result)
    check(86, result == vk.Result.success)
    // Reset: the stream starts again; freed.
    gave(87, "vkResetCommandBuffer", vk.resetCommandBuffer(&deviceCommands, cb, 0))
    check(88, commands.bufferOf(cb).*.at == 0 && commands.bufferOf(cb).*.state == commands.Recording.INITIAL)
    vk.freeCommandBuffers(&deviceCommands, device, commandPool, 1, unsafe { @ptrCast([*]const vk.CommandBuffer, &cb) })
    vk.destroyCommandPool(&deviceCommands, device, commandPool, null)
    vk.destroyDescriptorPool(&deviceCommands, device, pool, null)
    vk.destroyPipeline(&deviceCommands, device, made, null)
    vk.destroyShaderModule(&deviceCommands, device, module, null)
    vk.destroyPipelineLayout(&deviceCommands, device, layout, null)
    vk.destroyDescriptorSetLayout(&deviceCommands, device, setLayout, null)
    vk.destroyBuffer(&deviceCommands, device, buffer, null)
    vk.freeMemory(&deviceCommands, device, memory, null)
    dropDevice()
    check(89, host.memoryObjects() == 0 && host.mappings() == 0 && host.living() == 0)
}

// The copy engine's rules (silent need 6).
fn testCopies() -> void {
    card(true)
    check(90, makeDevice() == vk.Result.success)
    // (No device: nothing more of this part can run.)
    if device == 0 { return }
    const bytes: u64 = 5 * 1024 * 1024 + 12
    var source: vk.Buffer = 0
    var target: vk.Buffer = 0
    var sourceMemory: vk.DeviceMemory = 0
    var targetMemory: vk.DeviceMemory = 0
    var from: usize = 0
    var to: usize = 0
    const visible = typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT)
    check(91, makeBuffer(bytes, visible, &source, &sourceMemory, &from) && makeBuffer(bytes, visible, &target, &targetMemory, &to))
    const a: [*]u32 = unsafe { @ptrFromInt([*]u32, from) }
    const b: [*]u32 = unsafe { @ptrFromInt([*]u32, to) }
    var k: usize = 0
    while k < @intCast(usize, bytes / 4) {
        a[k] = @intCast(u32, k) *% 2654435761
        k += 1
    }
    makeCommands()
    begin()
    vk.cmdFillBuffer(&deviceCommands, cb, target, 0, vk.WHOLE_SIZE, 0x11223344)
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT
    vk.cmdPipelineBarrier(&deviceCommands, cb, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, null, 0, null)
    var region = vk.BufferCopy.init()
    region.srcOffset = 4
    region.dstOffset = 8
    region.size = bytes - 8
    vk.cmdCopyBuffer(&deviceCommands, cb, source, target, 1, &region)
    _ = vk.endCommandBuffer(&deviceCommands, cb)
    // The fill: three packets, the last with CP_SYNC; then the barrier's
    // flush; the copy in three packets (2 097 120, 2 097 120, the rest),
    // the first with RAW_WAIT; the end's zero-byte CP_SYNC.
    const w = streamWords()
    check(92, w[0] == 0xC0055000 && w[1] == 0x40000000 && w[2] == 0x11223344 && w[3] == 0 && w[6] == 2097120 && w[8] == 0x40000000 && w[13] == 2097120 && w[15] == 0xC0000000)
    check(93, w[20] == @intCast(u32, bytes - 2 * 2097120) && w[21] == 0xC0004600 && w[23] == 0xC0055802 && w[24] == 0x00C40000 && (w[36] & packets.DMA_DATA__RAW_WAIT) != 0)
    var packetsSeen: usize = 0
    var largest: u32 = 0
    var syncs: usize = 0
    var rawWaits: usize = 0
    k = 0
    const length = commands.bufferOf(cb).*.lengths[0]
    while k < length {
        if w[k] == packets.NOP_PAD {
            k += 1
            continue
        }
        if packets.opcodeOf(w[k]) == packets.PKT3_DMA_DATA {
            packetsSeen += 1
            const count = w[k + 6] & packets.DMA_DATA__BYTE_COUNT
            if count > largest { largest = count }
            if (w[k + 1] & packets.DMA_DATA__CP_SYNC) != 0 { syncs += 1 }
            if (w[k + 6] & packets.DMA_DATA__RAW_WAIT) != 0 { rawWaits += 1 }
        }
        k += @intCast(usize, packets.countOf(w[k])) + 2
    }
    check(94, packetsSeen == 7 && largest == 2097120 && syncs == 2 && rawWaits == 1)
    check(95, submitAndWait() == vk.Result.success)
    var right = b[0] == 0x11223344 && b[1] == 0x11223344
    k = 2
    while k < @intCast(usize, bytes / 4) {
        if b[k] != a[k - 1] { right = false }
        k += 1
    }
    check(96, right)
    // A copy, then a barrier from the transfers to the shaders, then the
    // doubler over what was copied: the barrier waits for the copy engine
    // (radv_cp_dma_wait_for_stages: a zero-byte CP_SYNC where it stands),
    // else the dispatch races the copy.
    var module: vk.ShaderModule = 0
    _ = moduleOf(doublerWords(), &module)
    makeLayouts(1, 0)
    var doubling: vk.Pipeline = 0
    _ = makePipeline(module, &doubling)
    var size = vk.DescriptorPoolSize.init()
    size.type_ = vk.DescriptorType.storageBuffer
    size.descriptorCount = 1
    var poolInfo = vk.DescriptorPoolCreateInfo.init()
    poolInfo.maxSets = 1
    poolInfo.poolSizeCount = 1
    poolInfo.pPoolSizes = &size
    var pool: vk.DescriptorPool = 0
    _ = vk.createDescriptorPool(&deviceCommands, device, &poolInfo, null, &pool)
    var allocate = vk.DescriptorSetAllocateInfo.init()
    allocate.descriptorPool = pool
    allocate.descriptorSetCount = 1
    allocate.pSetLayouts = &setLayout
    var set: vk.DescriptorSet = 0
    _ = vk.allocateDescriptorSets(&deviceCommands, device, &allocate, unsafe { @ptrCast([*]vk.DescriptorSet, &set) })
    var range = vk.DescriptorBufferInfo.init()
    range.buffer = target
    range.range = 1024
    var write = vk.WriteDescriptorSet.init()
    write.dstSet = set
    write.descriptorCount = 1
    write.descriptorType = vk.DescriptorType.storageBuffer
    write.pBufferInfo = &range
    vk.updateDescriptorSets(&deviceCommands, device, 1, &write, 0, null)
    _ = vk.resetCommandBuffer(&deviceCommands, cb, 0)
    begin()
    region.srcOffset = 0
    region.dstOffset = 0
    region.size = 1024
    vk.cmdCopyBuffer(&deviceCommands, cb, source, target, 1, &region)
    barrier.srcAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_SHADER_READ_BIT | vk.ACCESS_SHADER_WRITE_BIT
    vk.cmdPipelineBarrier(&deviceCommands, cb, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &barrier, 0, null, 0, null)
    vk.cmdBindPipeline(&deviceCommands, cb, vk.PipelineBindPoint.compute, doubling)
    vk.cmdBindDescriptorSets(&deviceCommands, cb, vk.PipelineBindPoint.compute, layout, 0, 1, unsafe { @ptrCast([*]const vk.DescriptorSet, &set) }, 0, null)
    vk.cmdDispatch(&deviceCommands, cb, 4, 1, 1)
    barrier.srcAccessMask = vk.ACCESS_SHADER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_HOST_READ_BIT
    vk.cmdPipelineBarrier(&deviceCommands, cb, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, vk.PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, null, 0, null)
    _ = vk.endCommandBuffer(&deviceCommands, cb)
    // The wait at the barrier: the copy's packet, then a zero-byte CP_SYNC.
    check(97, w[0] == 0xC0055000 && w[6] == 1024 && w[7] == 0xC0055000 && w[8] == packets.DMA_DATA__CP_SYNC && w[13] == 0)
    right = submitAndWait() == vk.Result.success
    k = 0
    while k < 256 {
        if b[k] != a[k] *% 2 +% @intCast(u32, k) { right = false }
        k += 1
    }
    check(98, right)
    vk.destroyDescriptorPool(&deviceCommands, device, pool, null)
    vk.destroyPipeline(&deviceCommands, device, doubling, null)
    vk.destroyShaderModule(&deviceCommands, device, module, null)
    vk.destroyPipelineLayout(&deviceCommands, device, layout, null)
    vk.destroyDescriptorSetLayout(&deviceCommands, device, setLayout, null)
    vk.destroyCommandPool(&deviceCommands, device, commandPool, null)
    vk.destroyBuffer(&deviceCommands, device, source, null)
    vk.destroyBuffer(&deviceCommands, device, target, null)
    vk.freeMemory(&deviceCommands, device, sourceMemory, null)
    vk.freeMemory(&deviceCommands, device, targetMemory, null)
    dropDevice()
}

// ---------------------------------------------------------------------------
// std.gpu's kernels through std.gpu over our driver (tests/497's cases)

var context: gpu.Context = undefined
var kernel: gpu.Kernel = undefined
var gpuBuffers: [4]gpu.Buffer = undefined
var handles: [4]vk.Buffer = undefined
var frames: usize = 0

fn openGpu() -> bool {
    var options = gpu.defaultOptions("509".pointer)
    context.device = 0
    if gpu.open(&context, opened, &options, std.page_allocator.init()) != gpu.Status.ok { return false }
    // (std.gpu's report of a lost device goes to the user's crashes.log;
    // the losses here are on purpose.)
    context.diagnostics = 0
    var k: usize = 0
    while k < 4 {
        if !gpu.createBuffer(&context, &gpuBuffers[k], @intCast(u64, kernels.WORDS * 4), false) { return false }
        handles[k] = gpuBuffers[k].buffer
        k += 1
    }
    frames = 0
    return true
}

fn compileThrough(words: []const u32) -> bool {
    // What the kernel binds and pushes: its facts by our compiler (the
    // driver compiles it again at the pipeline).
    var facts: shader.Facts = undefined
    var failure: shader.Failure = undefined
    var room: [16384]u32 = undefined
    if !shader.compile(words, std.page_allocator.init(), room[0..], &facts, &failure) { return false }
    var bindings: u32 = 0
    while bindings < 32 && (facts.bindings >> @intCast(u5, bindings)) != 0 { bindings += 1 }
    return gpu.createKernel(&context, &kernel, words.pointer, words.length, bindings, facts.pushWords)
}

fn dispatchThrough(push: []const u32, bufferCount: usize, groupsX: u32, groupsY: u32) -> bool {
    var b: usize = 0
    while b < 4 {
        const into: [*]u32 = unsafe { @ptrFromInt([*]u32, gpuBuffers[b].address) }
        var k: usize = 0
        while k < kernels.WORDS {
            into[k] = kernels.buffers[b][k]
            k += 1
        }
        b += 1
    }
    var words: [32]u32 = undefined
    var k: usize = 0
    while k < 32 {
        words[k] = if k < push.length { push[k] } else { 0 }
        k += 1
    }
    if !gpu.begin(&context) { return false }
    if !gpu.dispatch(&context, &kernel, &handles, &words, groupsX, groupsY) { return false }
    if !gpu.submit(&context) { return false }
    frames += 1
    b = 0
    while b < 4 {
        const from: [*]const u32 = unsafe { @ptrFromInt([*]const u32, gpuBuffers[b].address) }
        k = 0
        while k < kernels.WORDS {
            kernels.buffers[b][k] = from[k]
            k += 1
        }
        b += 1
    }
    return true
}

fn testKernels() -> void {
    card(true)
    check(100, openGpu())
    if context.device == 0 { return }
    kernels.show = show
    kernels.runner = kernels.Runner.{ .compile = compileThrough, .dispatch = dispatchThrough }
    kernels.runnerSet = true
    // (1) Division by a variable on the first frame: the divider over the
    // edges.
    var count: usize = 0
    for n in kernels.EDGES {
        for d in kernels.EDGES {
            if d != 0 && count < 320 {
                kernels.buffers[0][count * 2] = n
                kernels.buffers[0][count * 2 + 1] = d
                count += 1
            }
        }
    }
    check(101, kernels.compileDivider() && kernels.divisions(count) && frames == 1)
    // The card's reciprocal a unit and two low: it holds; a unit high: not.
    host.setReciprocalError(-1)
    check(102, kernels.divisions(count))
    host.setReciprocalError(-2)
    check(103, kernels.divisions(count))
    host.setReciprocalError(1)
    check(104, !kernels.divisions(count) && failedLost())
    host.setReciprocalError(0)
    // (The context is lost: the card refused what it ran.)
    gpu.close(&context)
    card(true)
    check(106, openGpu())
    if context.device == 0 { return }
    // The nine kernels, every word against the processor's.
    kernels.testPattern()
    kernels.testNv12()
    kernels.testText()
    kernels.testPaint()
    kernels.testBlit()
    kernels.testBlur()
    kernels.testWarp()
    kernels.testShrink()
    check(105, kernels.failed == 0 && frames > 20 && host.report().*.failure == run.Failure.none)
    kernels.runnerSet = false
    gpu.close(&context)
}

fn failedLost() -> bool { return host.report().*.failure != run.Failure.none }

// (2) The invalidation at every submit: std.gpu resets its pool every
// frame, so frame two's descriptors are at frame one's addresses.
fn twoFrames() -> bool {
    kernels.runner = kernels.Runner.{ .compile = compileThrough, .dispatch = dispatchThrough }
    kernels.runnerSet = true
    var k: usize = 0
    while k < 128 {
        kernels.buffers[0][k * 2] = @intCast(u32, k) * 7 + 3
        kernels.buffers[0][k * 2 + 1] = @intCast(u32, k) + 1
        k += 1
    }
    if !kernels.compileDivider() || !kernels.divisions(128) { return false }
    // Frame two, its buffers swapped: set 0 names other memory at the
    // same address.
    const first = handles[0]
    handles[0] = handles[2]
    handles[2] = first
    const firstBuffer = gpuBuffers[0]
    gpuBuffers[0] = gpuBuffers[2]
    gpuBuffers[2] = firstBuffer
    const passed = kernels.divisions(128)
    kernels.runnerSet = false
    return passed
}

// The doubler over buffer `buffer` in a frame of its own: the pool reset,
// its one set made again (at the same address) and pointed at `buffer`,
// the command buffer recorded again (a dispatch, no barrier after it) and
// submitted: the wait's answer.
var framePool: vk.DescriptorPool = 0
var framePipeline: vk.Pipeline = 0

fn frame(buffer: vk.Buffer, set: *u64) -> vk.Result {
    _ = vk.resetDescriptorPool(&deviceCommands, device, framePool, 0)
    var allocate = vk.DescriptorSetAllocateInfo.init()
    allocate.descriptorPool = framePool
    allocate.descriptorSetCount = 1
    allocate.pSetLayouts = &setLayout
    var made: vk.DescriptorSet = 0
    _ = vk.allocateDescriptorSets(&deviceCommands, device, &allocate, unsafe { @ptrCast([*]vk.DescriptorSet, &made) })
    set.* = pipeline.setOf(made).*.address
    var range = vk.DescriptorBufferInfo.init()
    range.buffer = buffer
    range.range = vk.WHOLE_SIZE
    var write = vk.WriteDescriptorSet.init()
    write.dstSet = made
    write.descriptorCount = 1
    write.descriptorType = vk.DescriptorType.storageBuffer
    write.pBufferInfo = &range
    vk.updateDescriptorSets(&deviceCommands, device, 1, &write, 0, null)
    _ = vk.resetCommandBuffer(&deviceCommands, cb, 0)
    begin()
    vk.cmdBindPipeline(&deviceCommands, cb, vk.PipelineBindPoint.compute, framePipeline)
    vk.cmdBindDescriptorSets(&deviceCommands, cb, vk.PipelineBindPoint.compute, layout, 0, 1, unsafe { @ptrCast([*]const vk.DescriptorSet, &made) }, 0, null)
    vk.cmdDispatch(&deviceCommands, cb, 4, 1, 1)
    _ = vk.endCommandBuffer(&deviceCommands, cb)
    return submitAndWait()
}

// Two frames, the second's set at the first's address naming another
// buffer: whether both ran, and the words doubled.
fn twoSubmits(lost: *bool) -> bool {
    var module: vk.ShaderModule = 0
    _ = moduleOf(doublerWords(), &module)
    makeLayouts(1, 0)
    if makePipeline(module, &framePipeline) != vk.Result.success { return false }
    var size = vk.DescriptorPoolSize.init()
    size.type_ = vk.DescriptorType.storageBuffer
    size.descriptorCount = 1
    var poolInfo = vk.DescriptorPoolCreateInfo.init()
    poolInfo.maxSets = 1
    poolInfo.poolSizeCount = 1
    poolInfo.pPoolSizes = &size
    _ = vk.createDescriptorPool(&deviceCommands, device, &poolInfo, null, &framePool)
    var first: vk.Buffer = 0
    var second: vk.Buffer = 0
    var firstMemory: vk.DeviceMemory = 0
    var secondMemory: vk.DeviceMemory = 0
    var a: usize = 0
    var b: usize = 0
    const visible = typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT)
    if !makeBuffer(1024, visible, &first, &firstMemory, &a) || !makeBuffer(1024, visible, &second, &secondMemory, &b) { return false }
    const one: [*]u32 = unsafe { @ptrFromInt([*]u32, a) }
    const two: [*]u32 = unsafe { @ptrFromInt([*]u32, b) }
    var k: usize = 0
    while k < 256 {
        one[k] = @intCast(u32, k)
        two[k] = 1000 + @intCast(u32, k)
        k += 1
    }
    makeCommands()
    var firstSet: u64 = 0
    var secondSet: u64 = 1
    const ran = frame(first, &firstSet) == vk.Result.success && frame(second, &secondSet) == vk.Result.success
    lost.* = !ran
    k = 0
    var right = firstSet == secondSet
    while k < 256 {
        if one[k] != 3 * @intCast(u32, k) || two[k] != 2000 + 3 * @intCast(u32, k) { right = false }
        k += 1
    }
    return ran && right
}

fn testInvalidation() -> void {
    // std.gpu's frames: two, the second's set at the first's address.
    card(true)
    check(110, openGpu() && twoFrames())
    // (std.gpu's close of a context its open refused stops the program.)
    if context.device != 0 { gpu.close(&context) }
    // Without the preamble's invalidation std.gpu's frames still hold:
    // each dispatch's barrier (a shader read after it) invalidates the
    // scalar cache at the frame's end (radv_dst_access_flush, ACO's SMEM
    // loads), before the processor writes the next frame's sets.
    card(true)
    queue.preambleActions = queue.PREAMBLE_ACTIONS & ~packets.CP_COHER_CNTL__SH_KCACHE_ACTION_ENA
    check(111, openGpu() && twoFrames())
    if context.device != 0 { gpu.close(&context) }
    // A frame that ends without such a barrier: with the preamble's
    // invalidation the second frame sees its set...
    queue.preambleActions = 0xFFFFFFFF
    card(false)
    var lost = false
    check(112, makeDevice() == vk.Result.success && twoSubmits(&lost) && !lost)
    // The preamble is the device's from its making: a submit writes
    // nothing into it (the processor never rewrites a stream the card may
    // still be running), whatever the test's hook says by then.
    queue.preambleActions = 0
    var queueHandle: vk.Queue = 0
    vk.getDeviceQueue(&deviceCommands, device, 0, 0, &queueHandle)
    var none = vk.SubmitInfo.init()
    const owner: *driver.DeviceObject = unsafe { @ptrFromInt(*driver.DeviceObject, device) }
    const preambleWords: [*]const u32 = unsafe { @ptrFromInt([*]const u32, owner.*.preamble.bytes) }
    check(115, vk.queueSubmit(&deviceCommands, queueHandle, 0, &none, 0) == vk.Result.success && vk.queueWaitIdle(&deviceCommands, queueHandle) == vk.Result.success && preambleWords[19] == queue.PREAMBLE_ACTIONS)
    queue.preambleActions = 0xFFFFFFFF
    dropDevice()
    // ...and without it the scalar cache's old descriptor is stale: the
    // card would read the last frame's buffer; the device is lost.
    card(false)
    queue.preambleActions = queue.PREAMBLE_ACTIONS & ~packets.CP_COHER_CNTL__SH_KCACHE_ACTION_ENA
    check(113, makeDevice() == vk.Result.success && !twoSubmits(&lost) && lost && host.report().*.failure == run.Failure.memory && host.report().*.cacheFailure == cache.Failure.stale && host.report().*.where == cache.Where.scalar)
    queue.preambleActions = 0xFFFFFFFF
    // Every later submit and wait says so.
    check(114, submitAndWait() == vk.Result.errorDeviceLost && vk.deviceWaitIdle(&deviceCommands, device) == vk.Result.errorDeviceLost)
    dropDevice()
}

// ---------------------------------------------------------------------------
// (3) The wait states, (4) the record's counts, the self-test

var hazardLines: [16]code_module.Line = undefined
var paddedLines: [32]code_module.Line = undefined
var padHazards = false
var dropWait = false

fn line(inst: encode.Inst) -> code_module.Line { return code_module.Line.{ .kind = code_module.LineKind.inst, .inst = inst, .label = 0 } }

// The program the hook puts in place of the compiled one: a VALU writes
// s16, a buffer store reads it as its offset at once (the first rule: five
// wait states owed), or with s_nop 4 between when `padHazards`.
fn hazardProgram(words: []u32, facts: *shader.Facts) -> void {
    var count: usize = 0
    var i = encode.blank(isa.S_LOAD_DWORDX4)
    i.dst = 12
    i.src0 = 2
    i.flags = encode.IMM
    hazardLines[count] = line(i)
    count += 1
    i = encode.blank(isa.S_WAITCNT)
    i.imm = encode.waitWord(encode.WAIT_VM_MASK, encode.WAIT_EXP_MASK, 0)
    hazardLines[count] = line(i)
    count += 1
    i = encode.blank(isa.V_LSHLREV_B32)
    i.dst = encode.VGPR + 3
    i.src0 = encode.constant(2)
    i.src1 = encode.VGPR + 0
    hazardLines[count] = line(i)
    count += 1
    i = encode.blank(isa.V_READFIRSTLANE_B32)
    i.dst = 16
    i.src0 = encode.VGPR + 3
    hazardLines[count] = line(i)
    count += 1
    i = encode.blank(isa.BUFFER_STORE_DWORD)
    i.dst = encode.VGPR + 0
    i.src0 = encode.VGPR + 3
    i.src1 = 12
    i.src2 = 16
    i.flags = encode.OFFEN
    hazardLines[count] = line(i)
    count += 1
    i = encode.blank(isa.S_WAITCNT)
    i.imm = 0
    hazardLines[count] = line(i)
    count += 1
    hazardLines[count] = line(encode.blank(isa.S_ENDPGM))
    count += 1
    if padHazards {
        const padded = code_module.padHazards(hazardLines[0..count], paddedLines[0..])
        facts.*.words = code_module.assemble(paddedLines[0..padded], words)
    } else {
        facts.*.words = code_module.assemble(hazardLines[0..count], words)
    }
    facts.*.vgprs = 4
    facts.*.sgprs = 20
}

// A program that writes s15 and ends: the 16th scalar register, so RSRC1
// must give 32 (16 and VCC's two, 16 at a time: get_sgpr_alloc).
fn topProgram(words: []u32, facts: *shader.Facts) -> void {
    var lines: [2]code_module.Line = undefined
    var i = encode.blank(isa.S_MOV_B32)
    i.dst = 15
    i.src0 = encode.constant(0)
    lines[0] = line(i)
    lines[1] = line(encode.blank(isa.S_ENDPGM))
    facts.*.words = code_module.assemble(lines[0..2], words)
    facts.*.vgprs = 4
    facts.*.sgprs = 16
}

// The doubler with its last s_waitcnt (before s_endpgm) made an s_nop.
fn noLastWait(words: []u32, facts: *shader.Facts) -> void {
    var at: usize = 0
    while at < facts.*.words {
        var inst: encode.Inst = undefined
        const length = decode.decode(words[0..facts.*.words], at, &inst)
        if length == 0 { return }
        if inst.op.format == isa.Format.sopp && inst.op.number == isa.S_WAITCNT.number && at + 1 < facts.*.words && words[at + 1] == 0xBF810000 { words[at] = 0xBF800000 }
        at += length
    }
}

// The doubler's last v_add_co_u32 (the index added) made a subtraction:
// a wrong compiler output, the first wrong word 1.
fn wrongDoubler(words: []u32, facts: *shader.Facts) -> void {
    var last: usize = facts.*.words
    var at: usize = 0
    while at < facts.*.words {
        var inst: encode.Inst = undefined
        const length = decode.decode(words[0..facts.*.words], at, &inst)
        if length == 0 { return }
        if inst.op.format == isa.V_ADD_CO_U32.format && inst.op.number == isa.V_ADD_CO_U32.number && encode.isVgpr(inst.src0) { last = at }
        at += length
    }
    if last == facts.*.words { return }
    var inst: encode.Inst = undefined
    _ = decode.decode(words[0..facts.*.words], last, &inst)
    inst.op = isa.V_SUB_CO_U32
    _ = encode.encode(&inst, words[last..facts.*.words])
}

// The doubler dispatched once over our driver with a pipeline made under
// `hook` (0: none): the wait's answer.
fn doublerWith(hook: usize) -> vk.Result {
    var module: vk.ShaderModule = 0
    _ = moduleOf(doublerWords(), &module)
    makeLayouts(1, 0)
    pipeline.alterCode = hook
    var made: vk.Pipeline = 0
    const result = makePipeline(module, &made)
    pipeline.alterCode = 0
    if result != vk.Result.success { return result }
    var size = vk.DescriptorPoolSize.init()
    size.type_ = vk.DescriptorType.storageBuffer
    size.descriptorCount = 1
    var poolInfo = vk.DescriptorPoolCreateInfo.init()
    poolInfo.maxSets = 1
    poolInfo.poolSizeCount = 1
    poolInfo.pPoolSizes = &size
    var pool: vk.DescriptorPool = 0
    _ = vk.createDescriptorPool(&deviceCommands, device, &poolInfo, null, &pool)
    var allocate = vk.DescriptorSetAllocateInfo.init()
    allocate.descriptorPool = pool
    allocate.descriptorSetCount = 1
    allocate.pSetLayouts = &setLayout
    var set: vk.DescriptorSet = 0
    _ = vk.allocateDescriptorSets(&deviceCommands, device, &allocate, unsafe { @ptrCast([*]vk.DescriptorSet, &set) })
    var buffer: vk.Buffer = 0
    var memory: vk.DeviceMemory = 0
    var mapped: usize = 0
    _ = makeBuffer(1024, typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT), &buffer, &memory, &mapped)
    var range = vk.DescriptorBufferInfo.init()
    range.buffer = buffer
    range.range = vk.WHOLE_SIZE
    var write = vk.WriteDescriptorSet.init()
    write.dstSet = set
    write.descriptorCount = 1
    write.descriptorType = vk.DescriptorType.storageBuffer
    write.pBufferInfo = &range
    vk.updateDescriptorSets(&deviceCommands, device, 1, &write, 0, null)
    makeCommands()
    begin()
    vk.cmdBindPipeline(&deviceCommands, cb, vk.PipelineBindPoint.compute, made)
    vk.cmdBindDescriptorSets(&deviceCommands, cb, vk.PipelineBindPoint.compute, layout, 0, 1, unsafe { @ptrCast([*]const vk.DescriptorSet, &set) }, 0, null)
    vk.cmdDispatch(&deviceCommands, cb, 4, 1, 1)
    _ = vk.endCommandBuffer(&deviceCommands, cb)
    return submitAndWait()
}

fn testWaitStates() -> void {
    card(false)
    check(120, makeDevice() == vk.Result.success)
    // (No device: nothing more of this part can run.)
    if device == 0 { return }
    padHazards = false
    check(121, doublerWith(@intFromPtr(hazardProgram)) == vk.Result.errorDeviceLost && host.report().*.failure == run.Failure.wave && host.report().*.stop == wave.Stop.hazard)
    dropDevice()
    card(false)
    check(122, makeDevice() == vk.Result.success)
    // (No device: nothing more of this part can run.)
    if device == 0 { return }
    padHazards = true
    check(123, doublerWith(@intFromPtr(hazardProgram)) == vk.Result.success)
    // A shader whose 16 scalar registers leave no room for VCC in an
    // allocation of 16: RSRC1 gives 32, the host card lets it run.
    check(126, doublerWith(@intFromPtr(topProgram)) == vk.Result.success)
    // Without the s_waitcnt before s_endpgm: refused (a store outstanding).
    check(124, doublerWith(@intFromPtr(noLastWait)) == vk.Result.errorDeviceLost && host.report().*.stop == wave.Stop.wait)
    // The device is lost from then on.
    check(125, doublerWith(0) == vk.Result.errorDeviceLost)
    dropDevice()
}

fn testRecordAndSelfTest() -> void {
    // (4) No counts in the record: refused, no context left.
    host.reset()
    var facts = host.rx580(1)
    facts.shaderEngines = 0
    _ = host.add(&facts)
    _ = driver.offer(host.interface())
    var manifests: loader.Manifests = undefined
    _ = loader.findDrivers(&manifests, noManifests(), std.heap.allocator())
    _ = loader.openDriver(&opened, loader.manifestAt(&manifests, 0), std.heap.allocator())
    var result = makeDevice()
    gave(130, "vkCreateDevice", result)
    check(131, result == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.NO_COUNTS && host.living() == 0)
    dropDevice()
    // 8 compute units an engine: no FORCE_SIMD_DIST.
    host.reset()
    facts = host.rx580(1)
    facts.computeUnitsPerArray = 8
    _ = host.add(&facts)
    _ = driver.offer(host.interface())
    _ = loader.findDrivers(&manifests, noManifests(), std.heap.allocator())
    _ = loader.openDriver(&opened, loader.manifestAt(&manifests, 0), std.heap.allocator())
    check(132, makeDevice() == vk.Result.success)
    // (No device: nothing more of this part can run.)
    if device == 0 { return }
    var module: vk.ShaderModule = 0
    _ = moduleOf(doublerWords(), &module)
    makeLayouts(1, 0)
    var made: vk.Pipeline = 0
    check(133, makePipeline(module, &made) == vk.Result.success && pipeline.pipelineOf(made).*.words[9] == 0)
    dropDevice()
    // The self-test failing with a wrong compiler output: the device is
    // refused, the first wrong word said, nothing left on the card.
    card(false)
    pipeline.alterCode = @intFromPtr(wrongDoubler)
    result = makeDevice()
    pipeline.alterCode = 0
    check(134, result == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.SELF_TEST && selftest.last.outcome == selftest.Outcome.wrong && selftest.last.word == 1)
    check(135, selftest.last.wanted == selftest.last.got +% 2 && host.living() == 0 && host.memoryObjects() == 0 && host.mappings() == 0)
    check(136, equal(driver.refusalText(driver.refusal()), "the self-test's doubler gave a wrong word"))
    dropDevice()
    // And passing again.
    card(false)
    check(137, makeDevice() == vk.Result.success && selftest.last.outcome == selftest.Outcome.passed)
    dropDevice()
    // The self-test's division (the silent need 1, the study's 11.14): a
    // card whose reciprocal is a unit high gives wrong quotients: the
    // device is refused at the first wrong quotient or remainder; two
    // units low it is made.
    card(false)
    host.setReciprocalError(1)
    result = makeDevice()
    check(138, result == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.SELF_TEST && selftest.last.outcome == selftest.Outcome.wrong && selftest.last.division && selftest.last.word % 4 >= 2 && host.living() == 0)
    check(139, equal(driver.refusalText(driver.refusal()), "the self-test's division gave a wrong word"))
    dropDevice()
    card(false)
    host.setReciprocalError(-2)
    check(143, makeDevice() == vk.Result.success && selftest.last.outcome == selftest.Outcome.passed)
    host.setReciprocalError(0)
    dropDevice()
}

// ---------------------------------------------------------------------------
// The existing tests that pick a driver through the loader

fn testExisting(arguments: [][*]const u8) -> void {
    card(false)
    check(140, t253.main(arguments) == 13)
    card(false)
    check(141, t254.main(arguments) == 13)
    card(false)
    check(142, t263.main(arguments) == 13)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = arguments.length > 1
    check(150, readRegistry())
    testMemory()
    testPipelines()
    testDispatchWords()
    testCopies()
    testKernels()
    testInvalidation()
    testWaitStates()
    testRecordAndSelfTest()
    testExisting(noManifests())
    if failed != 0 { return failed }
    return 13
}
