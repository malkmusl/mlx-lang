// std.ui.flow and std.ui.widgets on a CPU canvas, driven as a platform
// drives them: rows run down the area in logical pixels times the scale,
// with the gap between them; ids come from labels within scopes; a toggle
// flips its bool on a click, a segment sets the choice, a slider moves
// its value, a radio row chooses; a card is drawn as tall as it was in
// the last frame (the first frame asks to be drawn again); a soft shadow
// is densest under its box and fades out beyond it, leaving pixels past
// its reach alone; the hairline of light lies along a raised surface's
// top edge. No fonts are needed (text is then not drawn). Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")
const flow = @import("std.ui.flow")
const widgets = @import("std.ui.widgets")
const surface = @import("std.ui.surface")

const WIDTH: usize = 400
const HEIGHT: usize = 400

const State = struct {
    dark: bool
    names: bool
    choice: usize
    level: usize
    volume: u32
    clicks: usize
    cardHeight: i32
}

fn pixel(canvas: *canvas_module.Canvas, x: usize, y: usize) -> u32 { return canvas.*.pixels[y * WIDTH + x] }

// How light a colour is (its channels added up).
fn light(color: u32) -> u32 { return ((color >> 16) & 255) + ((color >> 8) & 255) + (color & 255) }

fn frame(context: *view.Ui, canvas: *canvas_module.Canvas, state: *State) -> bool {
    view.begin(context, canvas)
    canvas_module.clear(canvas, context.*.theme.*.background)
    var page = flow.begin(context, ui.rect(20, 20, 300, 360), 1)
    widgets.cardBegin(&page, "card")
    _ = widgets.toggle(&page, "Dark", "A note", &state.*.dark)
    _ = widgets.check(&page, "Names", &state.*.names)
    var choice = widgets.segments(&page, 3)
    _ = widgets.segment(&page, &choice, "A", &state.*.choice)
    _ = widgets.segment(&page, &choice, "B", &state.*.choice)
    _ = widgets.segment(&page, &choice, "C", &state.*.choice)
    widgets.cardEnd(&page)
    state.*.cardHeight = view.measured(context, view.idOf(view.id("flow"), @intCast(usize, view.id("card") & 1073741823)))
    _ = widgets.slider(&page, "Volume", &state.*.volume, 100)
    _ = widgets.radio(&page, "Low", &state.*.level, 0)
    _ = widgets.radio(&page, "High", &state.*.level, 1)
    if widgets.button(&page, "OK", controls.BUTTON_NORMAL) { state.*.clicks += 1 }
    return view.end(context)
}

// Moves, presses and lets go at (x, y), drawing in between as an app does.
fn click(context: *view.Ui, canvas: *canvas_module.Canvas, state: *State, x: i32, y: i32) -> void {
    _ = view.pointerMove(context, x, y)
    _ = frame(context, canvas, state)
    _ = view.pointerButton(context, true)
    _ = frame(context, canvas, state)
    _ = view.pointerButton(context, false)
    var turns: usize = 0
    while frame(context, canvas, state) && turns < 4 { turns += 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var memory = allocator.alloc(WIDTH * HEIGHT * 4, 16).?
    var canvas: canvas_module.Canvas = undefined
    unsafe { canvas.pixels = @ptrCast([*]u32, memory) }
    canvas.width = WIDTH
    canvas.height = HEIGHT
    canvas.device = 0
    canvas.stride = WIDTH
    canvas.swapRedBlue = false
    canvas.opacity = 255
    var theme = theme_module.dark()
    var font: text_module.Text = undefined
    font.loaded = false
    font.ascent = 12
    var context: view.Ui = undefined
    view.init(&context, &theme, &font, &font, &font)

    // Rows: logical pixels times the scale, the gap between them, a
    // card's inset; what is used so far.
    var page = flow.begin(&context, ui.rect(10, 10, 200, 300), 2)
    const first = flow.row(&page, 30)
    if first.x != 10 || first.y != 10 || first.width != 200 || first.height != 60 { return 1 }
    const second = flow.row(&page, 10)
    if second.y != 10 + 60 + 12 || second.height != 20 { return 2 }
    if flow.used(&page) != 60 + 12 + 20 { return 3 }
    flow.space(&page, 5)
    const third = flow.rowPixels(&page, 7)
    if third.y != 10 + 60 + 12 + 20 + 12 + 10 || third.height != 7 { return 4 }
    if !flow.shows(&page, 10, ui.rect(0, 0, 400, 400)) || flow.shows(&page, 10, ui.rect(0, 0, 400, 100)) { return 5 }

    // Ids: the same label gives the same id, another label another one,
    // the same label in another scope (a list's rows) another one again;
    // an id set for the next widget is taken once.
    const save = flow.idFor(&page, "save")
    if save != flow.idFor(&page, "save") || save == flow.idFor(&page, "open") || save == view.NONE { return 6 }
    flow.pushIndex(&page, 1)
    const first_save = flow.idFor(&page, "save")
    flow.popScope(&page)
    flow.pushIndex(&page, 2)
    const second_save = flow.idFor(&page, "save")
    flow.popScope(&page)
    if first_save == save || first_save == second_save { return 7 }
    flow.pushScope(&page, "list")
    flow.pushIndex(&page, 1)
    if flow.idFor(&page, "save") == first_save { return 8 }
    flow.popScope(&page)
    flow.popScope(&page)
    flow.id(&page, 77)
    if flow.idFor(&page, "save") != 77 || flow.idFor(&page, "save") != save { return 9 }

    // The widgets. The first frame draws the card as nothing is measured
    // yet and asks to be drawn again; the second has it.
    var state = State.{ .dark = false, .names = true, .choice = 0, .level = 0, .volume = 50, .clicks = 0, .cardHeight = 0 }
    if !frame(&context, &canvas, &state) { return 20 }
    // Rows: the card's padding 8, a toggle with a note 48, the gap 6, a
    // check row 36, the gap, segments 36, then the padding: 8 + 48 + 6 +
    // 36 + 6 + 36 + 8 = 148.
    if state.cardHeight != 148 { return 21 }
    if frame(&context, &canvas, &state) { return 22 }
    // The card's background is drawn now, under the rows (the toggle
    // row's left edge is at 28; at x 24 the card alone).
    if pixel(&canvas, 24, 60) != theme.card || theme.card == theme.background { return 23 }
    // Outside the card's shadow's reach (10 pixels) the background is
    // untouched; just outside the card it is darker.
    if pixel(&canvas, 5, 60) != theme.background { return 24 }
    if pixel(&canvas, 18, 100) == theme.background { return 25 }

    // A click on the toggle row (at y 28 + 24) flips the bool, one on the
    // check row flips its bool, one on the third segment chooses it.
    click(&context, &canvas, &state, 100, 52)
    if !state.dark { return 30 }
    click(&context, &canvas, &state, 100, 52)
    if state.dark { return 31 }
    click(&context, &canvas, &state, 100, 100)
    if state.names { return 32 }
    // The segments row: y 20 + 8 + 48 + 6 + 36 + 6 = 124 .. 160; three
    // segments across 28 .. 312 less 2: the third from 218.
    click(&context, &canvas, &state, 280, 142)
    if state.choice != 2 { return 33 }
    click(&context, &canvas, &state, 280, 142)
    if state.choice != 2 { return 34 }
    // The slider row after the card (at y 20 + 148 + 12 = 180 .. 216): a
    // click near the track's right end raises the value; the radio rows
    // under it choose.
    click(&context, &canvas, &state, 250, 198)
    if state.volume <= 50 { return 35 }
    click(&context, &canvas, &state, 100, 240)
    if state.level != 0 { return 36 }
    click(&context, &canvas, &state, 100, 282)
    if state.level != 1 { return 37 }
    // The button at the row's left (y 300 .. 334).
    click(&context, &canvas, &state, 40, 317)
    if state.clicks != 1 { return 38 }

    // A soft shadow (on white, where even its faintest layer shows):
    // densest under its box, fainter further out, nothing past its reach;
    // a plain fill when the blur is 0.
    const white: u32 = 4294967295
    canvas_module.clear(&canvas, white)
    const dark_shadow = canvas_module.color(200, 0, 0, 0)
    canvas_module.shadow(&canvas, 100, 100, 100, 100, 8, 10, dark_shadow)
    const under = light(pixel(&canvas, 150, 150))
    const at_edge = light(pixel(&canvas, 150, 102))
    const near = light(pixel(&canvas, 150, 96))
    const far = light(pixel(&canvas, 150, 91))
    const beyond = pixel(&canvas, 150, 89)
    if under != at_edge || under >= near || near >= far || far >= light(white) { return 40 }
    if beyond != white { return 41 }
    canvas_module.shadow(&canvas, 300, 100, 50, 50, 4, 0, dark_shadow)
    if pixel(&canvas, 325, 125) != canvas_module.over(white, dark_shadow, 255) { return 42 }
    if pixel(&canvas, 299, 125) != white { return 43 }
    // A raised surface: its fill, the hairline along the top (not in the
    // corners), its shadow below it.
    canvas_module.clear(&canvas, theme.background)
    surface.raised(&context, ui.rect(100, 200, 100, 40), 10, theme.raised, 6)
    if pixel(&canvas, 150, 220) != theme.raised { return 44 }
    if pixel(&canvas, 150, 200) != canvas_module.over(theme.raised, theme.highlight, 255) { return 45 }
    if pixel(&canvas, 102, 200) == canvas_module.over(theme.raised, theme.highlight, 255) { return 46 }
    if pixel(&canvas, 150, 243) == theme.background || pixel(&canvas, 150, 260) != theme.background { return 47 }
    // A shadow cast below an edge fades out over its reach.
    canvas_module.clear(&canvas, white)
    canvas_module.shadowBelow(&canvas, 0, 300, 400, 8, dark_shadow)
    if light(pixel(&canvas, 10, 300)) >= light(pixel(&canvas, 10, 304)) || light(pixel(&canvas, 10, 307)) >= light(white) || pixel(&canvas, 10, 308) != white { return 48 }
    return 13
}
