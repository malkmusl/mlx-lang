const bootstrap = @import("../std/bootstrap/root.mlx")

pub fn main() -> u8 {
    var destination: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    unsafe {
        const path = @ptrCast([*]const u8, "/tmp/mlx-bootstrap-io-read")
        const file = bootstrap.fs.open(
            path,
            bootstrap.fs.READ_WRITE | bootstrap.fs.CREATE | bootstrap.fs.TRUNCATE,
            384,
        )
        if !bootstrap.fs.isValid(file) { return 1 }
        if !bootstrap.io.writeAll(file, "read") { return 2 }
        if bootstrap.fs.seek(file, 0, bootstrap.fs.SEEK_START) != 0 { return 3 }
        if bootstrap.io.read(file, destination[0..4]) != 4 { return 4 }
        if !bootstrap.fs.close(file) { return 5 }
        if !bootstrap.fs.delete(path) { return 6 }
    }
    if destination[0] != 114 || destination[1] != 101 || destination[2] != 97 || destination[3] != 100 {
        return 7
    }
    return 13
}
