// What the compositor's CPU renderer takes of a client's buffer on a commit
// (projects/desktop/compositor/buffers.mlx, takePixels): where the client
// said what changed and the buffer is the size of the one before, only
// that part is copied, and the surface must then hold pixel for pixel
// what a copy of the whole buffer gives, with the same answer to whether
// it is opaque.
//
// A client draws a random sequence of frames (rectangles of opaque and of
// translucent pixels, single translucent pixels, new sizes, ARGB and XRGB
// buffers, rows with gaps after them, buffers at odd addresses) and
// commits each twice: to one surface with the rectangle as its damage, to
// another whole and without damage. For the first the buffer holds the
// frame only inside the damage; everywhere else it holds other pixels
// (the client is drawing its next frame there), which must never show.
// A commit that cannot be taken in part (the first, a new size, damage
// that names everything or nothing, a copy that is not whole) is given
// the whole frame and must be taken whole. Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const state = @import("../projects/desktop/compositor/state.mlx")
const buffers = @import("../projects/desktop/compositor/buffers.mlx")

const Compositor = state.Compositor
const Surface = state.Surface

const MAX_WIDTH: usize = 72
const MAX_HEIGHT: usize = 48
const STEPS: usize = 6000

// xorshift64.
fn random(seed: *u64, limit: u64) -> u64 {
    var value = seed.*
    value = value ^ (value << 13)
    value = value ^ (value >> 7)
    value = value ^ (value << 17)
    seed.* = value
    return value % limit
}

fn randomInt(seed: *u64, low: i32, high: i32) -> i32 {
    return low + @intCast(i32, random(seed, @intCast(u64, high - low + 1)))
}

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn fail(step: usize, what: []const u8) -> u8 {
    say("step ")
    _ = std.io.writeUnsigned(std.io.stdout(), step)
    say(": ")
    say(what)
    say("\n")
    return 1
}

fn newSurface(compositor: *Compositor) -> *Surface {
    const memory = state.allocate(compositor, @sizeOf(Surface))
    var index: usize = 0
    while index < @sizeOf(Surface) {
        memory[index] = 0
        index += 1
    }
    const surface: *Surface = unsafe { @ptrCast(*Surface, memory) }
    surface.*.compositor = compositor
    buffers.initSurface(surface)
    return surface
}

// A pixel of a buffer whose rows are `stride` bytes apart, at any address.
fn store(base: usize, stride: usize, x: usize, y: usize, pixel: u32) -> void {
    const bytes: [*]u8 = unsafe { @ptrFromInt([*]u8, base + y * stride + x * 4) }
    bytes[0] = @intCast(u8, pixel & 255)
    bytes[1] = @intCast(u8, (pixel >> 8) & 255)
    bytes[2] = @intCast(u8, (pixel >> 16) & 255)
    bytes[3] = @intCast(u8, pixel >> 24)
}

pub fn main() -> u8 {
    var generator: u64 = 88172645463325252
    const seed = &generator
    var compositor: Compositor = undefined
    compositor.allocator = std.heap.allocator()
    // Two surfaces: commits in part where the damage allows, and whole.
    const parted = newSurface(&compositor)
    const whole = newSurface(&compositor)
    // The client's frame as it means it, and the buffer it hands over (rows
    // with up to 19 bytes after them, starting up to 7 bytes in).
    const frame_memory = state.allocate(&compositor, MAX_WIDTH * MAX_HEIGHT * 4)
    const frame: [*]u32 = unsafe { @ptrCast([*]u32, frame_memory) }
    const buffer_memory = state.allocate(&compositor, (MAX_WIDTH * 4 + 19) * MAX_HEIGHT + 8)
    var width: usize = 0
    var height: usize = 0
    var xrgb = false
    var partial_commits: usize = 0
    var turned_opaque: usize = 0
    var step: usize = 0
    while step < STEPS {
        // A new size at times (and at first): a frame of its own.
        var fresh = false
        if step == 0 || random(seed, 25) == 0 {
            width = @intCast(usize, randomInt(seed, 1, @intCast(i32, MAX_WIDTH)))
            height = @intCast(usize, randomInt(seed, 1, @intCast(i32, MAX_HEIGHT)))
            xrgb = random(seed, 4) == 0
            const color = 4278190080 | @intCast(u32, random(seed, 16777216))
            var index: usize = 0
            while index < width * height {
                frame[index] = color
                index += 1
            }
            fresh = true
        }
        // What the client draws: a rectangle (often reaching outside), a
        // single pixel, or all of it; opaque, or translucent (in an XRGB
        // buffer the fourth byte means nothing and may be anything).
        var drawn = ui.rect(randomInt(seed, -8, @intCast(i32, width)), randomInt(seed, -8, @intCast(i32, height)), randomInt(seed, 1, @intCast(i32, width) + 8), randomInt(seed, 1, @intCast(i32, height) + 8))
        const kind = random(seed, 10)
        if kind == 0 { drawn = ui.rect(randomInt(seed, 0, @intCast(i32, width) - 1), randomInt(seed, 0, @intCast(i32, height) - 1), 1, 1) }
        if kind == 1 { drawn = ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)) }
        if kind == 2 { drawn = ui.rect(-5, -5, 1 << 20, 1 << 20) }
        const translucent = kind == 0 || random(seed, 4) == 0
        const alpha: u32 = if translucent { @intCast(u32, random(seed, 255)) } else { 255 }
        const color = (alpha << 24) | @intCast(u32, random(seed, 16777216))
        const inside = ui.intersect(drawn, ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
        var y = inside.y
        while y < ui.bottom(inside) {
            var x = inside.x
            while x < ui.right(inside) {
                frame[@intCast(usize, y) * width + @intCast(usize, x)] = color
                x += 1
            }
            y += 1
        }
        // The damage it names: what it drew; at times none.
        const damage = if random(seed, 12) == 0 { ui.rect(0, 0, 0, 0) } else { drawn }
        // At times the surface's copy is not one a part can be put into.
        const spoiled = random(seed, 40)
        if spoiled == 0 { parted.*.copied = false }
        if spoiled == 1 { parted.*.scaledCopy = true }
        if spoiled == 2 { parted.*.hasContent = false }
        const named = ui.intersect(damage, ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
        const expect_partial = !fresh && spoiled > 2 && !ui.isEmpty(named) && (named.width < @intCast(i32, width) || named.height < @intCast(i32, height))
        // The buffer: the frame inside the damage, other pixels (not
        // opaque, none of the frame's) around it when only the damage may
        // be read; else the frame.
        const gap = @intCast(usize, random(seed, 20))
        const stride = width * 4 + gap
        const base = @intFromPtr(buffer_memory) + @intCast(usize, random(seed, 8))
        var row: usize = 0
        while row < height {
            var column: usize = 0
            while column < width {
                const in_damage = ui.contains(named, @intCast(i32, column), @intCast(i32, row))
                var pixel = frame[row * width + column]
                if expect_partial && !in_damage { pixel = 1431655765 ^ @intCast(u32, row * 131 + column) }
                store(base, stride, column, row, pixel)
                column += 1
            }
            row += 1
        }
        var part: ui.Rect = undefined
        const partial = buffers.takePixels(parted, base, width, height, stride, xrgb, damage, &part)
        if partial != expect_partial { return fail(step, if partial { "a commit was taken in part that had to be taken whole" } else { "a commit with damage of a part was taken whole" }) }
        const expected_part = if partial { named } else { ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)) }
        if part.x != expected_part.x || part.y != expected_part.y || part.width != expected_part.width || part.height != expected_part.height { return fail(step, "the part said to be replaced is not the damage") }
        if partial { partial_commits += 1 }
        // The same frame, whole.
        var all: ui.Rect = undefined
        const was_opaque = whole.*.opaque
        if buffers.takePixels(whole, @intFromPtr(frame_memory), width, height, width * 4, xrgb, ui.rect(0, 0, 0, 0), &all) { return fail(step, "a commit without damage was taken in part") }
        // What a whole copy holds is the frame (opaque throughout for XRGB),
        // and it is opaque when every pixel is.
        var opaque = true
        const held: [*]const u32 = unsafe { @ptrCast([*]const u32, whole.*.pixels) }
        var index: usize = 0
        while index < width * height {
            const wanted = if xrgb { frame[index] | 4278190080 } else { frame[index] }
            if held[index] != wanted { return fail(step, "a whole copy is not the client's frame") }
            if wanted >> 24 != 255 { opaque = false }
            index += 1
        }
        if whole.*.opaque != opaque { return fail(step, "a whole copy's opacity is wrong") }
        // The surface brought up to date in part holds the same, and says
        // the same about its opacity.
        if parted.*.pixelWidth != width || parted.*.pixelHeight != height || !parted.*.hasContent { return fail(step, "the surface's size is not the buffer's") }
        const kept: [*]const u32 = unsafe { @ptrCast([*]const u32, parted.*.pixels) }
        index = 0
        while index < width * height {
            if kept[index] != held[index] {
                return fail(step, if partial { "a commit in part differs from the whole copy (pixels from outside the damage, or stale ones)" } else { "a commit taken whole differs from the whole copy" })
            }
            index += 1
        }
        if parted.*.opaque != whole.*.opaque {
            return fail(step, if parted.*.opaque { "a commit in part left the surface opaque though a pixel is not" } else { "a commit in part left the surface translucent though every pixel is opaque" })
        }
        if partial && opaque && !was_opaque { turned_opaque += 1 }
        step += 1
    }
    // The sequence must have had what it is for: commits in part, among
    // them ones that made a translucent surface opaque.
    if partial_commits < STEPS / 4 { return fail(STEPS, "too few commits were taken in part") }
    if turned_opaque < 20 { return fail(STEPS, "too few commits in part made a translucent surface opaque") }
    return 13
}
