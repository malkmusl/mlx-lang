// Where the aggregate arena stands: a block too large for the frame is
// taken from it, so two calls differ by what was taken between them plus
// the block itself.
fn mark() -> usize {
    var block: [2048]u8 = undefined
    block[0] = 1
    return @intFromPtr(&block)
}

fn sum(values: [6]u8) -> usize {
    var total: usize = 0
    var k: usize = 0
    while k < 6 {
        total += @intCast(usize, values[k])
        k += 1
    }
    return total
}

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

fn whole() -> [6]u8 { return BYTES }

pub fn main() -> u8 {
    // Elements at an index known only when the program runs, of each kind.
    var at: usize = 0
    var total: usize = 0
    while at < 6 {
        total += @intCast(usize, BYTES[at])
        at += 1
    }
    if total != 210 { return 1 }
    at = 2
    if SIGNED[at] != -32768 || SIGNED[at + 1] != 32767 || SIGNED[0] != -3 { return 2 }
    if WIDE[at] != 0x0123456789ABCDEF || WIDE[1] != 0xFFFFFFFFFFFFFFFF { return 3 }
    if !FLAGS[at + 1] || FLAGS[at] { return 4 }
    if HALVES[at] != 2.25 || HALVES[1] != -1.5 { return 5 }
    if GRID[1][at] != 6 || GRID[0][0] != 1 { return 6 }
    // A struct's fields, an array in it, the lengths.
    if LIMITS.high - LIMITS.low != 13 || LIMITS.steps[at] != 9 { return 7 }
    if BYTES.length != 6 || GRID.length != 2 || BIG.length != 2048 { return 8 }
    // Another module's, one of whose elements is a constant by name.
    if lib.PRIMES[at + 5] != 19 || lib.CORNERS[1].y != -4 || lib.CORNERS[at].x != 5 { return 9 }
    if lib.ROW[3] != 4 || lib.PRIMES.length != 8 { return 10 }
    // A local named like the constant an element is given by does not
    // stand in for it.
    const WIDTH: usize = 77
    if lib.ROW[at + 1] != 4 || WIDTH != 77 { return 11 }

    // The value is a value: a copy changed, a slice written through, the
    // result of a function changed, leave the table as it is.
    var copy = BYTES
    copy[1] = 9
    if BYTES[1] != 20 || copy[1] != 9 { return 12 }
    const part = BYTES[0..4]
    part[1] = 9
    if BYTES[1] != 20 { return 14 }
    fill(BYTES[0..6])
    if BYTES[at] != 30 || sum(BYTES) != 210 { return 15 }
    var returned = whole()
    returned[0] = 0
    if BYTES[0] != 10 || whole()[0] != 10 { return 16 }
    for *element in BYTES { element.* = 0 }
    if BYTES[5] != 60 { return 17 }
    var seen: usize = 0
    for element in BYTES { seen += @intCast(usize, element) }
    if seen != 210 { return 18 }

    // Reading the large table takes nothing from the arena: not an
    // element, not its length.
    const first = mark()
    const second = mark()
    const step = second - first
    var k: usize = 0
    var bytes: usize = 0
    while k < 100 {
        bytes += @intCast(usize, BIG[(k * 37) % 2048])
        bytes += BIG.length
        k += 1
    }
    const third = mark()
    if third - second != step { return 19 }
    if bytes == 0 || BIG[2047] != 16 || BIG[17] != 2 { return 20 }
    if THIRD != 30 { return 21 }
    // A module's `var` first named here, where a local has the name of the
    // constant its initializer uses: the module's constant is meant.
    const SWITCH = true
    if lib.switches[0] || !lib.switches[1] || !SWITCH { return 22 }
    return 13
}
