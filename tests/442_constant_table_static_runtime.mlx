// A module-level `const` that is a table (an array or struct literal of
// values known at compile time) is read from one image in the data area:
// an element, a field or its length does not build the whole table where
// it is asked for. Before, each `TABLE[i]` stored every element first, and
// a table over what a frame takes came from the aggregate arena each
// time, which is never freed (brixOS's console drew its font so and
// stopped the kernel after 173 characters).
//
// Its value stays a value: handed to a function, sliced or copied into a
// variable it is storage of its own, and nothing written there shows in
// the table. (Beside it: a constant given by an element of another, and a
// module's `var` whose image is made inside a function with a local named
// like a constant of its initializer.) Exits 13 when every check holds,
// else the number of the first check that failed.
const lib = @import("./modules/442_tables.mlx")

const BYTES = [6]u8{ 10, 20, 30, 40, 50, 60 }
const SIGNED = [4]i16{ -3, 7, -32768, 32767 }
const WIDE = [3]u64{ 1, 0xFFFFFFFFFFFFFFFF, 0x0123456789ABCDEF }
const FLAGS = [4]bool{ true, false, false, true }
const HALVES = [3]f64{ 0.5, -1.5, 2.25 }
const GRID = [2][3]u8{ [3]u8{ 1, 2, 3 }, [3]u8{ 4, 5, 6 } }
const Limits = struct { low: i32, high: i32, steps: [3]u8 }
const LIMITS = Limits.{ .low = -4, .high = 9, .steps = [3]u8{ 7, 8, 9 } }
// A constant given by an element of another.
const THIRD = BYTES[2]
// Larger than a frame takes (1 KiB): the arena's, when it is built.
