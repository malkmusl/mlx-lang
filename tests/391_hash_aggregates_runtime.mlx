// std.hash's autoHash and autoEql over aggregates: structs field by field
// (a string field by content, a changed field changes the hash), tuples,
// an optional holding 0 (apart from null), slices of structs element by
// element. What tests/386_hash_runtime.mlx leaves to the compiler that
// instantiates a generic with a computed type argument (the field's
// @typeOf, a slice's @childType) and keeps an optional 0 apart from null.
// Exits 13 on success (another number: the check that failed).
const std = @import("std")
const hash = @import("std.hash")

const Point = struct {
    x: u32
    y: i16
    name: []const u8
}

fn main() -> u8 {
    var copy: [3]u8 = [3]u8{ 97, 98, 99 }
    const copy_bytes: [*]const u8 = &copy
    const copied: []const u8 = copy_bytes[0..3]
    // An optional holding 0 is not null.
    const none: ?u32 = null
    const zero: ?u32 = 0
    if hash.autoHash(@typeOf(none), none) == hash.autoHash(@typeOf(zero), zero) { return 1 }
    if hash.autoEql(@typeOf(none), none, zero) || !hash.autoEql(@typeOf(zero), zero, zero) { return 2 }
    // Structs field by field (a string field by content), tuples too.
    const point = Point.{ .x = 1, .y = -2, .name = "home" }
    const same = Point.{ .x = 1, .y = -2, .name = copied[0..0] }
    const named = Point.{ .x = 1, .y = -2, .name = "home" }
    const moved = Point.{ .x = 2, .y = -2, .name = "home" }
    if hash.autoHash(Point, point) != hash.autoHash(Point, named) { return 3 }
    if hash.autoHash(Point, point) == hash.autoHash(Point, moved) { return 4 }
    if hash.autoHash(Point, point) == hash.autoHash(Point, same) { return 5 }
    if !hash.autoEql(Point, point, named) || hash.autoEql(Point, point, moved) || hash.autoEql(Point, point, same) { return 6 }
    const pair = .{ @intCast(u8, 1), true }
    const other_pair = .{ @intCast(u8, 1), false }
    if hash.autoHash(@typeOf(pair), pair) == hash.autoHash(@typeOf(other_pair), other_pair) { return 7 }
    if !hash.autoEql(@typeOf(pair), pair, pair) || hash.autoEql(@typeOf(pair), pair, other_pair) { return 8 }
    // Slices of structs, element by element.
    var points: [2]Point = [2]Point{ point, moved }
    var others: [2]Point = [2]Point{ point, named }
    const point_slice: []const Point = points[0..2]
    const other_slice: []const Point = others[0..2]
    if hash.autoHash([]const Point, point_slice) == hash.autoHash([]const Point, other_slice) { return 9 }
    if hash.autoHash([]const Point, point_slice) != hash.autoHash([]const Point, points[0..2]) { return 10 }
    if !hash.autoEql([]const Point, point_slice, points[0..2]) || hash.autoEql([]const Point, point_slice, other_slice) { return 11 }
    return 13
}
