// A Radeon's display while brixOS runs as one driver
// (projects/brix/kernel/gpu_together.mlx, with gpu_change.mlx,
// gpu_switch.mlx, gpu_plug.mlx, gpu_ddc.mlx, display_modes.mlx and the
// plan and its carrying out, built for the host), on the user's whole
// card as a table (tests/support/switch_card.mlx: five connectors, the
// card's tables as programs that write down what they were told, an I2C
// engine with an EDID memory behind each DDC line, the hot plug lines by
// a script), after a boot that set the monitor's own mode (3840x1080 at
// 270270 kHz, HDMI) on the HDMI connector 2. The kernel's side is put
// together as gpu.mlx and modes.mlx put it: the timer's tick (in its
// interrupt), what it found due made on the trap's way back, a display's
// state of the modes whose driver is this one.
// - A mode change, then the monitor moved to the other HDMI output: the
//   switch's record is the new mode's, and the same monitor is followed
//   with the timing that runs (not refused for its own size). A move,
//   then a change: the change is planned for the new output. A move to a
//   monitor of another EDID: the list of modes, what runs and what the
//   EDID says of HDMI are the new monitor's. The monitor-back rule after
//   a change: the same monitor back writes nothing; another monitor of
//   the picture's size whose timing is the one sent writes nothing and
//   its modes are listed. A mode set for a monitor that came in place of
//   the first (nothing set for it before): the switch's record has its
//   EDID, so it is the same monitor when it comes back and when its cable
//   is moved. A change whose way back is not known to have come back:
//   the monitor is not followed any more at this boot.
// - A mode pending while the monitor is moved: the mode before is taken
//   back first (by the kernel, said), then the switch decides anew and
//   brings that picture over; while a second monitor is plugged in, the
//   monitor is switched off and on, or pulled with none elsewhere, the
//   pending mode stays; another monitor of the pending picture's size
//   with another timing: taken back first, then judged by the mode before
//   (another size: not followed). The time to confirm over at the very
//   tick that decides a move: taken back first, and the move, decided by
//   the pending picture, not made with the picture of before.
// - At every write of a mode change, a tick: it looks at nothing and
//   reads nothing; and a move that was due: it waits. At every write of a
//   move, and of one that fails and goes back, a program's request: busy,
//   nothing written. After every piece of an EDID's reading, a mode
//   change: the reading is let end before the first write of the change,
//   kept as a tick keeps it. A hot plug line that changes at every moment
//   of a change, and of a move: taken after it. No move is due while a
//   reading is under way.
// - The time everything stood still: the move's writing alone, the
//   read-out before it not made again when nothing wrote the card since.
// - A confirmation after the time to confirm, before the tick: the mode
//   before; a remembered mode that failed is forgotten; the file of
//   remembered modes keeps its newest lines in its room; a new picture is
//   never where the one before lay.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const plug = @import("../projects/brix/kernel/gpu_plug.mlx")
const ddc = @import("../projects/brix/kernel/gpu_ddc.mlx")
const rule = @import("../projects/brix/kernel/gpu_switch.mlx")
const changing = @import("../projects/brix/kernel/gpu_change.mlx")
const together = @import("../projects/brix/kernel/gpu_together.mlx")
const dm = @import("../projects/brix/kernel/display_modes.mlx")
const rom = @import("./support/atom_rom.mlx")
const display = @import("./support/tmds_card.mlx")
const lines = @import("./support/plug_card.mlx")
const card = @import("./support/switch_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0
var name: []const u8 = undefined

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected (")
    say(name)
    say("): ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(display.has(text), text) }

fn once(text: []const u8) -> void { expect(display.count(text) == 1, text) }

fn noLine(text: []const u8) -> void {
    if !display.has(text) { return }
    say("said, but should not be (")
    say(name)
    say("): ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    display.logWrite(text)
    if show { say(text) }
}

const MS: usize = 1000000
const NEVER: usize = 0xFFFFFFFF

fn out() -> scanout.Card { return scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite } }

// ---- The ROM and what is read of it.
var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

fn open() -> void {
    card.makeRom(&builder, card.NEVER, display.Ending.plain)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
}

// ---- The monitors' EDIDs: the user's (3840x1080 at 270270 kHz, its HDMI
// block in the extension, and two standard timings: 1920x1080 and
// 1280x720 at 60 Hz, VESA's rows); a DVI monitor of 1920x1080 at 60 Hz
// (148500 kHz on 2200 by 1125, VESA's row: one block); the same size at
// 50 Hz (148500 kHz on 2640 by 1125); another HDMI monitor of 3840x1080
// (plug_card's own timing, 266640 kHz).
var users: [256]u8 = undefined
var small: [128]u8 = undefined
var small50: [128]u8 = undefined
var other: [256]u8 = undefined
// Another DVI monitor of 1920x1080 at 60 Hz that names 1280x720 at 60 Hz
// too (a standard timing), its serial number another.
var smallMore: [128]u8 = undefined

fn resum(bytes: []u8, block: usize) -> void {
    var sum: usize = 0
    var k: usize = 0
    while k < 127 {
        sum += @intCast(usize, bytes[block * 128 + k])
        k += 1
    }
    bytes[block * 128 + 127] = @intCast(u8, (256 - (sum & 0xFF)) & 0xFF)
}

fn timing(bytes: []u8, words: []const u8) -> void {
    var k: usize = 0
    while k < 12 {
        bytes[54 + k] = words[k]
        k += 1
    }
    bytes[71] = 0x1A
}

fn makeEdids() -> void {
    _ = lines.edid(users[0..], 2, true)
    const wide = [_]u8{ 0x93, 0x69, 0x00, 0xC8, 0xF0, 0x38, 0x23, 0x40, 48, 32, 0x35, 0x00 }
    timing(users[0..], wide[0..])
    // (Standard timings: 1920 across, 16:9, 60 Hz; 1280 across, 16:9, 60
    // Hz.)
    users[38] = 0xD1
    users[39] = 0xC0
    users[40] = 0x81
    users[41] = 0xC0
    resum(users[0..], 0)
    _ = lines.edid(small[0..], 1, false)
    const full = [_]u8{ 0x02, 0x3A, 0x80, 0x18, 0x71, 0x38, 0x2D, 0x40, 0x58, 0x2C, 0x45, 0x00 }
    timing(small[0..], full[0..])
    small[71] = 0x1E
    resum(small[0..], 0)
    _ = lines.edid(small50[0..], 1, false)
    const fifty = [_]u8{ 0x02, 0x3A, 0x80, 0xD0, 0x72, 0x38, 0x2D, 0x40, 0x10, 0x2C, 0x45, 0x80 }
    timing(small50[0..], fifty[0..])
    small50[71] = 0x1E
    small50[17] = 50
    resum(small50[0..], 0)
    _ = lines.edid(other[0..], 2, true)
    var k: usize = 0
    while k < 128 {
        smallMore[k] = small[k]
        k += 1
    }
    smallMore[38] = 0x81
    smallMore[39] = 0xC0
    smallMore[12] = 0x42
    resum(smallMore[0..], 0)
}

// ---- The kernel's side, as gpu.mlx and modes.mlx put it together.
var watch: plug.Watch = undefined
var verdict: plug.Verdict = undefined
var follow: rule.Follow = undefined
var decided: rule.Decision = undefined
var bootReadout: scanout.Readout = undefined
var bootPlan: mode.Plan = undefined
var bootResult: set.Result = undefined
var memory: scanout.Memory = undefined
var seen: changing.Seen = undefined
var machinery: changing.Lent = undefined
var switchLent: rule.Lent = undefined
var lentHands: set.Hands = undefined
var lentTables: set.Tables = undefined
var facts: mode.Rom = undefined
var ddcHands: ddc.Hands = undefined
var driver: together.Driver = undefined
var watching = false
var state: dm.State = undefined
var stateDriver: dm.Driver = undefined
// The physical address of the card's memory as the display's record
// has it.
const BASE: usize = 0xD0000000

// Everything else held and let go, counted (and when, by the card's
// clock).
var holds: usize = 0
var releases: usize = 0
var heldAt: usize = 0
var releasedAt: usize = 0

fn hold() -> usize {
    holds += 1
    heldAt = display.clock
    return 0
}

fn release() -> void {
    releases += 1
    releasedAt = display.clock
}

// ---- Every write the driver makes through what is lent here, the
// display's, its tables' and the I2C engine's, in one count; at the
// write `injectAt` (counted from 1), before it is made, `injected` is
// called: something else that comes in the middle.
var writes: usize = 0
var injectAt: usize = NEVER
var injected: fn() -> void = nothing
var firstDisplay: usize = 0
var lastI2c: usize = 0
var tableWriteOf: fn(usize, u32) -> bool = undefined

fn nothing() -> void {}

fn stepped() -> void {
    writes += 1
    if writes == injectAt {
        injectAt = NEVER
        const f = injected
        f()
    }
}

fn displayWrite(number: usize, value: u32) -> void {
    stepped()
    if firstDisplay == 0 { firstDisplay = writes }
    card.write(number, value)
}

fn tableWrite(number: usize, value: u32) -> bool {
    stepped()
    if firstDisplay == 0 { firstDisplay = writes }
    const f = tableWriteOf
    return f(number, value)
}

fn ddcWrite(number: usize, value: u32) -> void {
    stepped()
    lastI2c = writes
    card.write(number, value)
}

fn counting() -> void {
    writes = 0
    firstDisplay = 0
    lastI2c = 0
    injectAt = NEVER
}

// The display's state of the modes, its driver this one (gpu.mlx's
// modeJudge, modeSetTo, modeBack).
fn stateJudge(which: usize, asked: *dm.Mode) -> void { together.judge(&driver, asked) }

fn picture(result: dm.Set, into: *dm.Picture) -> dm.Set {
    if result != dm.Set.done { return result }
    into.*.address = BASE + seen.plan.offset
    into.*.width = seen.plan.width
    into.*.height = seen.plan.height
    into.*.pitch = seen.plan.pitch * 4
    return result
}

fn stateSet(which: usize, asked: *const dm.Mode, into: *dm.Picture) -> dm.Set {
    if !asked.*.timed { return dm.Set.refused }
    return picture(together.set(&driver, &asked.*.timing), into)
}

fn stateBack(which: usize, before: *const dm.Mode, into: *dm.Picture) -> dm.Set { return picture(together.back(&driver, before), into) }

fn lend() -> void {
    lentHands = set.Hands.{ .write = displayWrite, .clear = display.clear }
    var tableHands = display.hands()
    tableWriteOf = tableHands.write
    tableHands.write = tableWrite
    lentTables = set.Tables.{ .machine = &machine, .hands = tableHands, .aside = display.setAside }
    facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    ddcHands = ddc.Hands.{ .write = ddcWrite }
    stateDriver = dm.Driver.{ .kind = dm.Kind.RADEON_TMDS, .which = 0, .timed = true, .anySize = false, .judge = stateJudge, .set = stateSet, .back = stateBack }
}

// The machine made anew: the firmware's 1280x960 out of connector 2 on
// DIG 4 by DVI signalling, the lines high whose bits `high` has, the
// monitors as `on` says (0 none, 1 the user's, 2 the DVI one).
fn machineWith(title: []const u8, high: usize, on: [5]usize) -> void {
    name = title
    if show {
        say("-- ")
        say(title)
        say("\n")
    }
    card.users(107962, high)
    var k: usize = 0
    while k < 5 {
        if on[k] == 1 { card.monitor(k, users[0..]) }
        if on[k] == 2 { card.monitor(k, small[0..]) }
        k += 1
    }
}

// The boot as gpu.mlx makes it (every connector looked at, the monitors
// asked, the rule at boot, the plan for the monitor's own mode carried
// out, what serves each connector read anew, the record begun), then the
// one driver as gpu.mlx's `joinUp` begins it and the display's modes as
// modes.mlx's `bind` lists them, from the EDID the driver read.
fn boot() -> void {
    const c = out()
    const h = ddc.Hands.{ .write = card.write }
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    plug.detect(&watch.ports, &verdict)
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    decided = rule.atBoot(&c, &watch.ports, &verdict, &follow, rule.How.follows)
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    scanout.report(&c, &memory, &bootReadout)
    const s = verdict.output
    mode.makeFor(&c, &bootReadout, &memory, &watch.ports.ports[s].monitor, &watch.ports.ports[s].offer, &facts, mode.Wish.own, &bootPlan)
    _ = set.attemptWith(&c, &lentHands, &lentTables, &bootPlan, true, &bootResult)
    plug.serveAll(&c, &watch.ports)
    rule.begin(&follow, follow.how, &watch.ports, bootPlan.controller, memory.pictureWidth, memory.pictureHeight, watch.ports.ports[s].heard.data(), 0, 0, 0)
    _ = rule.carried(&c, &follow, &watch.ports, &bootPlan, &bootResult, decided)
    memory.pictureOffset = bootPlan.offset
    memory.pictureBytes = bootPlan.bytes
    memory.pictureWidth = bootPlan.width
    memory.pictureHeight = bootPlan.height
    memory.picturePitch = bootPlan.pitch
    // gpu.mlx's `joinUp`.
    changing.begin(&seen)
    seen.memory = memory
    seen.offer = watch.ports.ports[s].offer
    machinery = changing.Lent.{ .card = out(), .hands = lentHands, .tables = &lentTables, .rom = facts, .hold = hold, .release = release, .aside = display.setAside }
    display.setAside(true)
    changing.look(&machinery, &seen)
    display.setAside(false)
    switchLent = rule.Lent.{ .hands = &lentHands, .tables = &lentTables, .rom = &facts, .memory = &seen.memory, .readout = &seen.readout, .plan = &seen.plan, .result = &seen.result, .change = &machinery, .seen = &seen }
    watching = true
    driver.card = out()
    driver.watch = &watch
    driver.follow = &follow
    driver.lent = &switchLent
    driver.change = &machinery
    driver.seen = &seen
    driver.hands = &ddcHands
    driver.pause = card.pause
    driver.watching = &watching
    together.begin(&driver)
    // modes.mlx's `bind`.
    var bytes: []const u8 = users[0..128]
    if together.modeEdid(&driver).length != 0 { bytes = together.modeEdid(&driver) }
    const p = dm.Picture.{ .address = BASE + memory.pictureOffset, .width = memory.pictureWidth, .height = memory.pictureHeight, .pitch = memory.picturePitch * 4 }
    state.begin(&stateDriver, bytes, &p, changing.rate(&seen), null)
    listedMonitors = driver.monitors
    holds = 0
    releases = 0
    counting()
}

fn bootedOn2(title: []const u8) -> void {
    machineWith(title, 1 << 6, [_]usize{ 0, 0, 1, 0, 0 })
    boot()
    expect(bootResult.outcome == set.Outcome.done && follow.showing == 2 && follow.width == 3840 && follow.clock == 270270 && follow.timed, "the boot set the monitor's own mode on connector 2")
    expect(seen.fresh && seen.readout.controllers[0].width == 3840 && state.runs.width == 3840 && state.list.count >= 3, "the mode change's record and the modes as the boot left them")
    expect(together.modeEdid(&driver).length == 256 && driver.monitors == 1, "the modes are listed from the EDID read over DDC, both blocks")
    display.forget()
    display.logged = 0
}

// ---- The timer's ticks (10 ms apart) and what each found due, made on
// the trap's way back as modes.mlx's `due` makes it.
var listedMonitors: usize = 0
var lastDue = together.Due.none
var dues: usize = 0

fn after() -> void {
    if state.pending && display.clock >= state.deadline { _ = state.tick(display.clock) }
    if together.isDue(&driver) {
        lastDue = together.carryDue(&driver, &state)
        dues += 1
        // (A move made: the display's state has the new monitor's modes
        // from carryDue itself, and modes.mlx does not list them again.)
        if lastDue == together.Due.made { listedMonitors = driver.monitors }
    }
    if driver.monitors != listedMonitors {
        state.relist(together.modeEdid(&driver))
        listedMonitors = driver.monitors
    }
}

fn tick() -> void {
    together.tick(&driver)
    after()
}

fn ticks(until: usize) -> void {
    while display.clock < until {
        card.pass(10 * MS)
        tick()
    }
}

// A program's request, as modes.mlx's `request` makes it: the time to
// confirm counted from when the mode runs.
fn ask(width: usize, height: usize) -> dm.Answer {
    const answer = state.ask(width, height, 0, display.clock)
    if answer == dm.Answer.changed { state.deadline = display.clock + dm.CONFIRM_TIME }
    return answer
}

// The cable moved from connector `from` to connector `to`: pulled now,
// in the other one `after` later.
fn moveCable(from: usize, to: usize, later: usize, bytes: []const u8) -> usize {
    const t0 = display.clock
    card.unplug(from)
    card.line(from, false, card.NEVER)
    ticks(t0 + later)
    card.monitor(to, bytes)
    card.line(to, true, card.NEVER)
    return t0
}

fn writtenIn(from: usize, first: usize, last: usize) -> bool {
    var k = from
    while k < display.written && k < display.WRITES {
        if display.writtenTo[k] >= first && display.writtenTo[k] <= last { return true }
        k += 1
    }
    return false
}

// With an argument: how many times a case was made.
fn counted(what: []const u8, count: usize) -> void {
    if !show { return }
    const o = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
    o.field(what, count)
    say(" times\n")
}

// ---- THE RECORDS.

// A mode change, then the monitor moved to the other HDMI output: the
// switch's record is the new mode's (its size, the timing sent, the
// clock); the same monitor is followed with that timing (its own size is
// another), and the picture's memory stays.
fn changeThenMove() -> void {
    bootedOn2("a mode change, then the monitor moved to the other HDMI output")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 asked for and set")
    expect(follow.width == 1920 && follow.height == 1080 && follow.clock == 148500 && follow.hTotal == 2200 && follow.vTotal == 1125 && follow.timed && follow.timing.hFront == 88, "the switch's record is the new mode's")
    expect(follow.showing == 2 && follow.edidCount == 256, "the output and the monitor's EDID stay")
    expect(holds == 1 && releases == 1, "everything else held for the change")
    expect(state.confirm() == dm.Answer.confirmed, "confirmed")
    const surface = display.registers[0x1A04]
    const cleared = display.cleared
    display.logged = 0
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    once("gpu: the monitor is on connector 3 (HDMI) now, and nothing is plugged into connector 2 (HDMI): the picture is brought there (every other processor stands still while the card is written; the picture's memory stays as it is)\n")
    once("gpu: every other processor stood still for the move, ")
    noLine("a picture of another size would have to be told")
    expect(lastDue == together.Due.made && follow.showing == 3 && follow.width == 1920 && follow.clock == 148500, "the same monitor followed with the timing that runs")
    expect(seen.plan.timing.clock == 148500 && seen.plan.timing.hTotal == 2200 && seen.plan.move.on && seen.plan.move.keep, "the move's plan: the picture kept, the record's timing")
    expect(display.registers[0x1A04] == surface && display.cleared == cleared && display.pll[5] == 148500, "the picture's memory as it was; the new PLL at the timing that runs")
    expect(seen.fresh && seen.readout.controllers[0].encoder.backEnd == 5 && seen.readout.controllers[0].width == 1920, "the mode change's record read anew: the new output")
    expect(state.runs.width == 1920 && !state.pending && state.hasKept && state.kept.width == 1920, "what runs and what is kept as they were")
    expect(holds == releases && holds == 2, "held for the move as for the change")
}

// A move, then a change: the change is planned for the output the
// picture goes out by now, and taken back there.
fn moveThenChange() -> void {
    bootedOn2("the monitor moved, then a mode change")
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    expect(lastDue == together.Due.made && follow.showing == 3 && follow.width == 3840, "moved to connector 3 at the monitor's own mode")
    const first = display.written
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 asked for and set")
    expect(seen.plan.tmds.backEnd == 5 && display.pll[5] == 148500, "the change planned for DIG 5, on PLL 5")
    expect(!writtenIn(first, scanout.DIG[4], scanout.DIG[4] + 0xFF), "nothing of DIG 4 written")
    expect(follow.showing == 3 && follow.width == 1920 && follow.clock == 148500, "the switch's record is the new mode's")
    expect(state.takeBack() == dm.Answer.taken_back && state.runs.width == 3840 && follow.width == 3840 && follow.clock == 270270 && display.pll[5] == 270270, "taken back on connector 3: the record is the mode before's")
}

// The monitor moved to the DVI connector and another monitor there of
// the picture's size: the list of modes, what runs and what the EDID says
// of HDMI are the new monitor's.
fn moveToAnotherMonitor() -> void {
    bootedOn2("the picture brought to another monitor of its size")
    expect(ask(1920, 1080) == dm.Answer.changed && state.confirm() == dm.Answer.confirmed, "1920x1080 set and confirmed")
    const monitors = driver.monitors
    const t0 = moveCable(2, 4, 300 * MS, small[0..])
    ticks(t0 + 3000 * MS)
    expect(lastDue == together.Due.made && follow.showing == 4 && follow.width == 1920, "brought to the DVI connector")
    expect(driver.monitors == monitors + 1 && together.modeEdid(&driver).length == 128 && together.modeEdid(&driver)[54] == small[54], "the list's EDID is the new monitor's")
    expect(!seen.offer.hdmi && seen.readout.controllers[0].encoder.backEnd == 0, "what the new EDID says of HDMI; the read-out: DIG 0")
    expect(state.runs.width == 1920 && state.runs.millihertz > 59900 && state.runs.millihertz < 60100 && state.list.find(3840, 1080, 0) == dm.NONE, "the list is the DVI monitor's; 1920x1080 at 60 Hz runs")
}

// After a change the monitor switched off and on: the same EDID, nothing
// written. Then another monitor of the picture's size whose timing is the
// one sent: nothing written, its modes listed.
fn backAfterChange() -> void {
    bootedOn2("after a change: the same monitor back, then another of the picture's size")
    expect(ask(1920, 1080) == dm.Answer.changed && state.confirm() == dm.Answer.confirmed, "1920x1080 set and confirmed")
    const first = display.written
    var t0 = display.clock
    card.line(2, false, card.NEVER)
    ticks(t0 + 500 * MS)
    card.line(2, true, card.NEVER)
    ticks(t0 + 3000 * MS)
    line("gpu: connector 2 (HDMI): the monitor is back after ")
    expect(display.written == first && follow.width == 1920 && state.runs.width == 1920, "nothing written")
    const monitors = driver.monitors
    t0 = display.clock
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(t0 + 500 * MS)
    card.monitor(2, small[0..])
    card.line(2, true, card.NEVER)
    ticks(t0 + 3000 * MS)
    expect(display.written == first && follow.width == 1920, "another monitor taking the timing sent: nothing written")
    expect(driver.monitors == monitors + 1 && state.list.find(3840, 1080, 0) == dm.NONE && state.runs.width == 1920, "its modes listed")
}

// Another monitor on the output that shows the picture, of another size,
// for which nothing is set; then a mode of its list set for it: the
// switch's record names that monitor's EDID (the mode was set for it).
// It is switched off and on: the same monitor back, nothing written. Its
// cable moved to the other HDMI output: followed with the mode that runs.
fn changeForAnotherMonitor() -> void {
    bootedOn2("a mode set for a monitor that came in place of the first, then its cable moved")
    var t0 = display.clock
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(t0 + 400 * MS)
    card.monitor(2, smallMore[0..])
    card.line(2, true, card.NEVER)
    ticks(t0 + 3000 * MS)
    once("gpu: connector 2 (HDMI): the monitor there is 1920x1080, the picture 3840x1080")
    expect(state.list.find(1280, 720, 0) != dm.NONE && state.list.find(1920, 1080, 0) != dm.NONE, "the new monitor's modes listed")
    expect(ask(1280, 720) == dm.Answer.changed && state.confirm() == dm.Answer.confirmed, "1280x720 set for it and confirmed")
    var at: usize = 0
    expect(follow.width == 1280 && plug.against(&watch.ports.ports[2].heard, follow.edid[0..follow.edidCount], &at) == plug.Against.same, "the switch's record: the picture and the EDID of the monitor it was set for")
    display.logged = 0
    const first = display.written
    t0 = display.clock
    card.line(2, false, card.NEVER)
    ticks(t0 + 400 * MS)
    card.line(2, true, card.NEVER)
    ticks(t0 + 3000 * MS)
    line("gpu: connector 2 (HDMI): the monitor is back after ")
    noLine("the monitor there is 1920x1080, the picture 1280x720")
    expect(display.written == first, "the same monitor back: nothing written")
    display.logged = 0
    t0 = moveCable(2, 3, 300 * MS, smallMore[0..])
    ticks(t0 + 3000 * MS)
    noLine("the monitor there is 1920x1080, the picture 1280x720")
    expect(lastDue == together.Due.made && follow.showing == 3 && follow.width == 1280 && follow.clock == 74250, "its cable moved: followed with the mode that runs")
}

// A mode change whose way back does not end in the state of before (a
// PLL that takes the new clock and not the old one again, a transmitter
// that does not answer): the monitor is not followed any more at this
// boot, said; its cable moved later is not followed. On a card whose
// lines the tick does not look at, a change leaves it so.
fn changeLost() -> void {
    bootedOn2("a mode change whose way back is not known to have come back")
    display.clockRuns = 0
    display.clockDeafFrom = 1
    display.transmitterDeaf = true
    expect(ask(1920, 1080) == dm.Answer.failed_lost, "the change and its way back failed")
    display.clockDeafFrom = display.NEVER
    display.transmitterDeaf = false
    once("gpu: the monitor is not followed any more at this boot: the way back did not end in the state of before")
    expect(follow.how == rule.How.off, "the following stops")
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    expect(follow.showing == 2 && !together.isDue(&driver), "the cable moved: not followed")
    bootedOn2("a mode change on a card whose lines are not looked at")
    watching = false
    expect(ask(1920, 1080) == dm.Answer.changed && !watching, "the tick still does not look")
    watching = true
}

// ---- A MODE PENDING WHILE A MONITOR COMES OR GOES.

// The monitor moved while the mode asked for waits to be confirmed: the
// mode before is taken back first, by the kernel; then the switch
// decides anew and brings that picture over.
fn pendingMoved() -> void {
    bootedOn2("a mode pending, the monitor moved to the other HDMI output")
    expect(ask(1920, 1080) == dm.Answer.changed && state.pending, "1920x1080 pending")
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    once("gpu: the picture is to be brought to connector 3 (HDMI) while a mode asked for waits to be confirmed: the mode before is put back first\n")
    expect(!state.pending && state.last == dm.Answer.timed_out && state.runs.width == 3840, "the pending mode taken back by the kernel")
    expect(follow.showing == 3 && follow.width == 3840 && follow.clock == 270270 && display.pll[5] == 270270, "then the picture of the mode before brought to connector 3")
    expect(holds == 3 && releases == 3, "held for the change, its taking back and the move")
}

// A second monitor, the monitor switched off and on, and the monitor
// pulled with none elsewhere: nothing is written, the pending mode stays.
fn pendingStays() -> void {
    bootedOn2("a mode pending, a second monitor plugged in")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 pending")
    var first = display.written
    card.monitor(3, small[0..])
    card.line(3, true, card.NEVER)
    ticks(display.clock + 2000 * MS)
    once("gpu: a second monitor on connector 3 (HDMI), 1920x1080: it is not driven (one picture, on connector 2 (HDMI))\n")
    expect(display.written == first && state.pending && state.confirm() == dm.Answer.confirmed, "nothing written; the mode still waits, and is confirmed")
    bootedOn2("a mode pending, the monitor switched off and on")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 pending")
    first = display.written
    const t0 = display.clock
    card.line(2, false, card.NEVER)
    ticks(t0 + 400 * MS)
    card.line(2, true, card.NEVER)
    ticks(t0 + 2000 * MS)
    expect(display.written == first && state.pending, "nothing written; the mode still waits")
    ticks(t0 + dm.CONFIRM_TIME + 100 * MS)
    expect(!state.pending && state.last == dm.Answer.timed_out && state.runs.width == 3840 && follow.width == 3840, "at the end of the time to confirm, taken back")
    bootedOn2("a mode pending, the monitor pulled with none elsewhere")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 pending")
    first = display.written
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(display.clock + 2000 * MS)
    once("gpu: connector 2 (HDMI): the monitor has left and no other connector has one: the output is kept as it is (nothing is taken down)\n")
    expect(display.written == first && state.pending, "nothing written; the mode still waits")
    ticks(display.clock + dm.CONFIRM_TIME)
    expect(!state.pending && state.runs.width == 3840 && follow.width == 3840 && follow.showing == 2, "taken back on the empty output when its time is over")
}

// Another monitor of the pending picture's size, of another timing (a
// DVI monitor at 50 Hz): the mode before is to be taken back first, and
// cannot be sent to this monitor (3840x1080 at 270270 kHz over DVI
// signalling): nothing is written for it, the mode asked for waits no
// more (the monitor it was asked on is gone), and the switch decides
// anew: the new monitor's own timing of the picture's size, its modes
// listed.
fn pendingOther() -> void {
    bootedOn2("a mode pending, another monitor of its size on the same output")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 pending")
    const t0 = display.clock
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(t0 + 400 * MS)
    card.monitor(2, small50[0..])
    card.line(2, true, card.NEVER)
    ticks(t0 + 3000 * MS)
    once("gpu: connector 2 (HDMI): its mode is to be set while a mode asked for waits to be confirmed: the mode before is put back first\n")
    line("gpu: the mode asked for is not set, the mode that runs stays: no timing of the monitor's size fits the link: the monitor's own needs 270270 kHz, this output carries 165000 kHz at most")
    expect(!state.pending && state.last == dm.Answer.failed_back, "the mode before not set; the mode asked for waits no more")
    once("gpu: connector 2 (HDMI): another monitor of the picture's size: its own timing is set")
    expect(follow.width == 1920 && follow.clock == 148500 && follow.hTotal == 2640 && display.pll[4] == 148500, "the new monitor's own timing set at the picture's size")
    expect(state.runs.width == 1920 && state.runs.millihertz > 49900 && state.runs.millihertz < 50100 && state.list.find(3840, 1080, 0) == dm.NONE, "the new monitor's modes, 1920x1080 at 50 Hz runs")
}

// The time to confirm ends at the very tick that decides a move (the
// monitor pulled, a DVI monitor of the pending picture's size elsewhere):
// modes.mlx's `due` takes the mode back first, and the move, decided by
// the pending picture's size, is not made with the picture of before
// (nothing tried, no try counted); the switch decides anew: another size,
// said.
fn deadlineMeetsMove() -> void {
    bootedOn2("the time to confirm over at the tick that decides a move")
    card.monitor(4, small[0..])
    card.line(4, true, card.NEVER)
    ticks(display.clock + 2000 * MS)
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 pending")
    card.unplug(2)
    card.line(2, false, card.NEVER)
    var guard: usize = 0
    while guard < 400 && !together.isDue(&driver) {
        card.pass(10 * MS)
        together.tick(&driver)
        if !together.isDue(&driver) { after() }
        guard += 1
    }
    expect(together.isDue(&driver) && state.pending, "a move due while the mode waits")
    display.logged = 0
    // (The time to confirm ends at this tick.)
    state.deadline = display.clock
    after()
    expect(!state.pending && state.runs.width == 3840 && follow.showing == 2 && follow.width == 3840, "taken back by the time")
    noLine("the picture is brought there")
    noLine("once more in")
    expect(follow.tries == 0 && !together.isDue(&driver), "no move tried with the picture of before")
    ticks(display.clock + 1000 * MS)
    once("gpu: connector 4 (DVI-D (dual link)): the monitor there is 1920x1080, the picture 3840x1080")
    expect(follow.showing == 2, "the picture stays")
}

// ---- ONE USER OF THE CARD'S DISPLAY AT A TIME.

// What an injected tick saw.
var looksBefore: usize = 0
var i2cBefore: usize = 0
var skippedBefore: usize = 0
var tickSkipped = 0
var tickLooked = 0

fn tickInside() -> void {
    looksBefore = watch.ports.looks
    i2cBefore = lines.written
    skippedBefore = driver.skipped
    card.pass(10 * MS)
    tick()
    if driver.skipped == skippedBefore + 1 && watch.ports.looks == looksBefore && lines.written == i2cBefore && driver.user == together.User.changing && !watching { tickSkipped += 1 } else { tickLooked += 1 }
}

// The writes of a change made without anything in between: how many, and
// the list to hold the others against.
var cleanCount: usize = 0
var cleanTo: [display.WRITES]usize = undefined
var cleanWith: [display.WRITES]usize = undefined

fn keepClean() -> void {
    cleanCount = display.written
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        cleanTo[k] = display.writtenTo[k]
        cleanWith[k] = display.writtenWith[k]
        k += 1
    }
}

fn sameAsClean() -> bool {
    if display.written != cleanCount { return false }
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        if display.writtenTo[k] != cleanTo[k] || display.writtenWith[k] != cleanWith[k] { return false }
        k += 1
    }
    return true
}

// At every write of a mode change, a tick of the timer: it looks at
// nothing and reads nothing (a monitor plugged in meanwhile is taken
// after the change), and the change's writes are those of a change
// without it.
fn tickDuringChange() -> void {
    bootedOn2("a mode change without anything in between")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 set")
    keepClean()
    const count = writes
    expect(count > 50, "the change writes")
    var k: usize = 1
    tickSkipped = 0
    tickLooked = 0
    var wrong: usize = 0
    while k <= count {
        bootedOn2("a tick at a write of a mode change")
        // (A monitor plugged into connector 3 a moment before: a look would
        // take it.)
        card.monitor(3, small[0..])
        card.line(3, true, card.NEVER)
        injected = tickInside
        injectAt = k
        const answer = ask(1920, 1080)
        if answer != dm.Answer.changed || !sameAsClean() || !watching || driver.user != together.User.nobody { wrong += 1 }
        // (What comes after, at the first, a middle and the last write.)
        if k == 1 || k == count / 2 || k == count {
            ticks(display.clock + 2000 * MS)
            if display.count("gpu: a second monitor on connector 3 (HDMI), 1920x1080: it is not driven") != 1 { wrong += 1 }
        }
        k += 1
    }
    counted("a tick at every write of a mode change: ", count)
    expect(tickSkipped == count && tickLooked == 0, "at every write the tick looked at nothing and read nothing")
    expect(wrong == 0, "every change the same as without the tick, the monitor plugged in taken after it")
}

// What an injected move saw.
var movesWaited: usize = 0
var movesMade: usize = 0

fn carryInside() -> void {
    const before = writes
    if together.carryDue(&driver, &state) == together.Due.waits && writes == before { movesWaited += 1 } else { movesMade += 1 }
}

// A move due when a mode change begins (the tick decided it, the change
// came before it was made: possible only on a machine where the two meet,
// shown here for the record): at every write of the change, the move is
// tried: it waits, writes nothing, and is decided anew afterwards.
fn moveDuringChange() -> void {
    bootedOn2("a move due during a mode change")
    var t0 = moveCable(2, 3, 300 * MS, users[0..])
    while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
        card.pass(10 * MS)
        together.tick(&driver)
    }
    expect(together.isDue(&driver), "a move is due")
    counting()
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 set")
    const count = writes
    var k: usize = 1
    movesWaited = 0
    movesMade = 0
    var wrong: usize = 0
    while k <= count {
        bootedOn2("a move due at a write of a mode change")
        t0 = moveCable(2, 3, 300 * MS, users[0..])
        while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
            card.pass(10 * MS)
            together.tick(&driver)
        }
        counting()
        injected = carryInside
        injectAt = k
        if ask(1920, 1080) != dm.Answer.changed || seen.plan.tmds.backEnd != 4 || together.isDue(&driver) { wrong += 1 }
        // (Decided anew, at the first, a middle and the last write: the
        // mode asked for is taken back first, the picture of the mode
        // before is brought over.)
        if k == 1 || k == count / 2 || k == count {
            ticks(display.clock + 3000 * MS)
            if follow.showing != 3 || follow.width != 3840 || state.pending || state.runs.width != 3840 { wrong += 1 }
        }
        k += 1
    }
    counted("a move due at every write of a mode change: ", count)
    expect(movesWaited == count && movesMade == 0, "at every write of the change the move waited and wrote nothing")
    expect(wrong == 0, "the change made as asked, the move decided anew after it")
}

// What an injected request saw.
var requestsBusy: usize = 0
var requestsOther: usize = 0

fn requestInside() -> void {
    const before = writes
    const answer = state.ask(1280, 720, 0, display.clock)
    if answer == dm.Answer.busy && writes == before && !state.pending && driver.user == together.User.moving { requestsBusy += 1 } else { requestsOther += 1 }
}

// At every write of a move, a program's request: busy, nothing written,
// nothing pending; the move as without it.
fn requestDuringMove() -> void {
    bootedOn2("a move without anything in between")
    var t0 = moveCable(2, 3, 300 * MS, users[0..])
    while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
        card.pass(10 * MS)
        together.tick(&driver)
    }
    counting()
    after()
    expect(lastDue == together.Due.made, "moved")
    const count = writes
    expect(count > 50, "the move writes")
    requestsBusy = 0
    requestsOther = 0
    var wrong: usize = 0
    var k: usize = 1
    while k <= count {
        bootedOn2("a request at a write of a move")
        t0 = moveCable(2, 3, 300 * MS, users[0..])
        while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
            card.pass(10 * MS)
            together.tick(&driver)
        }
        counting()
        injected = requestInside
        injectAt = k
        after()
        if lastDue != together.Due.made || writes != count || follow.showing != 3 { wrong += 1 }
        k += 1
    }
    counted("a request at every write of a move: ", count)
    expect(requestsBusy == count && requestsOther == 0, "at every write of the move a request is busy and writes nothing")
    expect(wrong == 0 && driver.busy != 0, "every move made as without it")
    expect(ask(1280, 720) == dm.Answer.changed, "asked again after the move: set")
}

// A move that fails at its sixth table run and goes back: at every write
// of it, its way back's included, a program's request is busy and writes
// nothing; the move is said to be tried once more, and nothing waits.
fn requestDuringFailedMove() -> void {
    bootedOn2("a move that fails, without anything in between")
    var t0 = moveCable(2, 3, 300 * MS, users[0..])
    while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
        card.pass(10 * MS)
        together.tick(&driver)
    }
    counting()
    display.refuseRun = display.runs + 5
    after()
    display.refuseRun = display.NEVER
    expect(lastDue == together.Due.failed && follow.showing == 2 && follow.tries == 1, "the move failed and went back")
    line("gpu: once more in 5 s (try 1 of 3)")
    const count = writes
    requestsBusy = 0
    requestsOther = 0
    var wrong: usize = 0
    var k: usize = 1
    while k <= count {
        bootedOn2("a request at a write of a move that fails")
        t0 = moveCable(2, 3, 300 * MS, users[0..])
        while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
            card.pass(10 * MS)
            together.tick(&driver)
        }
        counting()
        display.refuseRun = display.runs + 5
        injected = requestInside
        injectAt = k
        after()
        display.refuseRun = display.NEVER
        if lastDue != together.Due.failed || writes != count || follow.showing != 2 || state.pending || driver.user != together.User.nobody || !watching { wrong += 1 }
        k += 1
    }
    counted("a request at every write of a move that fails and goes back: ", count)
    expect(requestsBusy == count && requestsOther == 0, "at every write of the move and its way back a request is busy and writes nothing")
    expect(wrong == 0, "every failed move as without it, the card given back")
}

// After every piece of an EDID's reading (a monitor plugged into
// connector 3, read a piece at a tick), a mode change: the reading is let
// end before the first write of the change and kept as a tick keeps it;
// the change's writes are those of a change without it.
fn changeDuringReading() -> void {
    bootedOn2("a mode change without a reading")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 set")
    keepClean()
    var piece: usize = 0
    var wrong: usize = 0
    var read: usize = 0
    while piece < 40 {
        bootedOn2("a mode change after a piece of a reading")
        card.monitor(3, small[0..])
        card.line(3, true, card.NEVER)
        // (Until the reading has begun, then `piece` ticks more.)
        var guard: usize = 0
        while watch.reading == plug.NONE && guard < 300 {
            card.pass(10 * MS)
            tick()
            guard += 1
        }
        var n: usize = 0
        while n < piece && watch.reading != plug.NONE {
            card.pass(10 * MS)
            tick()
            n += 1
        }
        if watch.reading == plug.NONE { break }
        counting()
        if ask(1920, 1080) != dm.Answer.changed || !sameAsClean() { wrong += 1 }
        const port = &watch.ports.ports[3]
        if watch.reading != plug.NONE || port.*.heard.outcome != ddc.Outcome.read || port.*.monitor.width != 1920 || !port.*.heard.restored || driver.finished != 1 { wrong += 1 }
        if lastI2c == 0 || lastI2c >= firstDisplay { wrong += 1 }
        if display.count("gpu: connector 3 (HDMI): the reading of its EDID that is under way is let end before the card is written\n") != 1 { wrong += 1 }
        read += 1
        piece += 1
    }
    counted("a mode change after every piece of a reading: ", read)
    expect(read > 1, "the reading took several ticks")
    expect(wrong == 0, "after every piece the reading ended before the first write, kept; the change as without it")
}

// A hot plug line that changes at every moment of a mode change (a
// monitor plugged into connector 3): nothing of it is looked at during
// the change, and it is taken after it, once.
fn plugDuringChange() -> void {
    bootedOn2("a mode change, its span")
    const began = display.clock
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 set")
    const span = display.clock - began
    var at: usize = 0
    var wrong: usize = 0
    while at <= 20 {
        bootedOn2("a line that changes during a mode change")
        card.monitor(3, small[0..])
        lines.lineLater(display.clock + span * at / 20, card.LINES[3], true)
        const looks = watch.ports.looks
        if ask(1920, 1080) != dm.Answer.changed || watch.ports.looks != looks { wrong += 1 }
        ticks(display.clock + 2000 * MS)
        if display.count("gpu: something was plugged into connector 3 (HDMI)\n") != 1 || watch.ports.ports[3].monitor.width != 1920 { wrong += 1 }
        at += 1
    }
    expect(wrong == 0, "at every moment the plug was taken after the change, once")
}

// A monitor plugged into the DVI connector at every moment of a move:
// nothing of it is looked at during the move; after it, it is a second
// monitor, said once, and nothing more is written.
fn plugDuringMove() -> void {
    bootedOn2("a move, its span")
    var t0 = moveCable(2, 3, 300 * MS, users[0..])
    while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
        card.pass(10 * MS)
        together.tick(&driver)
    }
    const began = display.clock
    after()
    const span = display.clock - began
    var at: usize = 0
    var wrong: usize = 0
    while at <= 10 {
        bootedOn2("a monitor plugged in during a move")
        t0 = moveCable(2, 3, 300 * MS, users[0..])
        while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
            card.pass(10 * MS)
            together.tick(&driver)
        }
        card.monitor(4, small[0..])
        lines.lineLater(display.clock + span * at / 10, card.LINES[4], true)
        const looks = watch.ports.looks
        after()
        if lastDue != together.Due.made || watch.ports.looks != looks || follow.showing != 3 { wrong += 1 }
        const written = display.written
        ticks(display.clock + 2000 * MS)
        if display.count("gpu: a second monitor on connector 4 (DVI-D (dual link)), 1920x1080: it is not driven (one picture, on connector 3 (HDMI))\n") != 1 || display.written != written { wrong += 1 }
        at += 1
    }
    expect(wrong == 0, "at every moment of the move the plug was taken after it, once, a second monitor")
}

// No move is decided while an EDID is being read (the I2C engine is the
// reading's): the monitor moved while a second monitor's EDID is read on
// the DVI connector; at no tick is a move due while a reading is under
// way, and the move is made once it has ended.
fn moveWaitsForReading() -> void {
    // (When the move is due without the second monitor.)
    bootedOn2("a move, when it is due")
    var t0 = display.clock
    card.unplug(2)
    card.line(2, false, card.NEVER)
    card.monitor(3, users[0..])
    lines.lineLater(t0 + 300 * MS, card.LINES[3], true)
    while !together.isDue(&driver) && display.clock < t0 + 4000 * MS {
        card.pass(10 * MS)
        together.tick(&driver)
    }
    const dueAfter = display.clock - t0
    var start: usize = 0
    var wrong: usize = 0
    var waited: usize = 0
    while start < 16 {
        bootedOn2("a move and a reading at once")
        t0 = display.clock
        card.unplug(2)
        card.line(2, false, card.NEVER)
        card.monitor(3, users[0..])
        lines.lineLater(t0 + 300 * MS, card.LINES[3], true)
        card.monitor(4, small[0..])
        lines.lineLater(t0 + dueAfter - 700 * MS + start * 20 * MS, card.LINES[4], true)
        while display.clock < t0 + 4000 * MS {
            card.pass(10 * MS)
            together.tick(&driver)
            if together.isDue(&driver) && watch.reading != plug.NONE { wrong += 1 }
            if watch.reading != plug.NONE && follow.showing == 2 && display.clock >= t0 + dueAfter { waited += 1 }
            after()
        }
        if follow.showing != 3 { wrong += 1 }
        start += 1
    }
    expect(wrong == 0, "no move due while a reading is under way; the move made after it")
    expect(waited != 0, "a move waited for a reading")
}

// ---- HOW LONG EVERYTHING STANDS STILL.
// The move: the read-out before it not made again (the record is the
// card's: nothing wrote it since the boot's read-out), every other
// processor held for the writing alone; the read-out after it holds
// nobody.
fn stoodStill() -> void {
    bootedOn2("how long everything stands still for a move")
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    while !together.isDue(&driver) && display.clock < t0 + 3000 * MS {
        card.pass(10 * MS)
        together.tick(&driver)
    }
    const began = display.clock
    after()
    const ended = display.clock
    expect(lastDue == together.Due.made, "moved")
    const before = heldAt - began
    const held = releasedAt - heldAt
    const afterwards = ended - releasedAt
    expect(seen.stood / MS == held / MS && before < 50 * MS, "held at once: no read-out before the move")
    expect(afterwards > 0 && seen.fresh, "the read-out after it, with nobody held")
    if show {
        const o = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
        o.field("the move on the table card: before the hold ", before / 1000)
        o.field(" us, held ", held / 1000)
        o.field(" us, the read-out after it ", afterwards / 1000)
        say(" us\n")
    }
    // (A change that failed leaves the record not the card's: the next
    // move reads the card first.)
    seen.fresh = false
    const t1 = moveCable(3, 2, 300 * MS, users[0..])
    while !together.isDue(&driver) && display.clock < t1 + 3000 * MS {
        card.pass(10 * MS)
        together.tick(&driver)
    }
    const began2 = display.clock
    after()
    expect(lastDue == together.Due.made && heldAt - began2 > before, "the card read first when the record is not fresh")
}

// ---- WHAT THE MODE CHANGE'S REVIEW LEFT OPEN.

// A confirmation after the time to confirm, before the tick: the mode
// before comes back, as the tick would have brought it.
fn lateConfirmation() -> void {
    bootedOn2("a confirmation after the time to confirm")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 pending")
    card.pass(dm.CONFIRM_TIME + 5 * MS)
    expect(state.pending && state.confirmAt(display.clock) == dm.Answer.timed_out && !state.pending && state.runs.width == 3840 && !state.hasKept, "too late: the mode before, nothing kept")
    expect(follow.width == 3840, "the switch's record the mode before's")
    bootedOn2("a confirmation in time")
    expect(ask(1920, 1080) == dm.Answer.changed, "1920x1080 pending")
    card.pass(dm.CONFIRM_TIME - 5 * MS)
    expect(state.confirmAt(display.clock) == dm.Answer.confirmed && state.runs.width == 1920 && state.hasKept, "in time: kept")
}

// The rule for a remembered mode that a boot tried.
fn forgotten() -> void {
    name = "a remembered mode that failed"
    expect(dm.forgottenAfter(dm.Answer.failed_back) && dm.forgottenAfter(dm.Answer.failed_lost), "written and failed: forgotten")
    expect(!dm.forgottenAfter(dm.Answer.confirmed) && !dm.forgottenAfter(dm.Answer.already) && !dm.forgottenAfter(dm.Answer.refused) && !dm.forgottenAfter(dm.Answer.not_listed), "set, running, or nothing written: kept")
}

// The file of remembered modes in its room: the lines confirmed longest
// ago are left out, the new one is at the end.
var fileText: [4096]u8 = undefined
var fileNew: [2048]u8 = undefined

fn room() -> void {
    name = "the remembered modes' room"
    var length: usize = 0
    var m: usize = 0
    while m < 60 {
        const kept = dm.Kept.{ .width = 1920, .height = 1080, .millihertz = 60000 }
        var one: [128]u8 = undefined
        const n = dm.remember(fileText[0..0], 0x1002, 0x67DF, m + 1, &kept, one[0..])
        var k: usize = 0
        while k < n {
            fileText[length + k] = one[k]
            k += 1
        }
        length += n
        m += 1
    }
    expect(length > 2048, "sixty monitors' lines are more than 2 KiB")
    const kept = dm.Kept.{ .width = 3840, .height = 1080, .millihertz = 59990 }
    const n = dm.remember(fileText[0..length], 0x1002, 0x67DF, 0x77, &kept, fileNew[0..])
    expect(n <= 2048, "the new text fits")
    var found: dm.Kept = undefined
    expect(dm.remembered(fileNew[0..n], 0x1002, 0x67DF, 0x77, &found) && found.width == 3840, "the new line is there")
    expect(!dm.remembered(fileNew[0..n], 0x1002, 0x67DF, 1, &found) && dm.remembered(fileNew[0..n], 0x1002, 0x67DF, 60, &found), "the oldest left out, the newest kept")
    const small1 = dm.remember(fileText[0..200], 0x1002, 0x67DF, 0x77, &kept, fileNew[0..])
    expect(small1 < 300 && dm.remembered(fileNew[0..small1], 0x1002, 0x67DF, 1, &found), "a text that fits keeps every line")
}

// A new picture is never where the one before lay: changes and moves in
// turn, each new picture beside the last.
fn neverOver() -> void {
    bootedOn2("a new picture never where the one before lay")
    var wrong: usize = 0
    const sizes = [_]usize{ 1920, 1280, 3840, 1920, 3840, 1280, 1920 }
    var k: usize = 0
    while k < sizes.length {
        const was = seen.memory
        const height: usize = if sizes[k] == 1280 { 720 } else { 1080 }
        if ask(sizes[k], height) != dm.Answer.changed || state.confirm() != dm.Answer.confirmed { wrong += 1 }
        const now = seen.memory
        if now.pictureOffset < was.pictureOffset + was.pictureBytes && was.pictureOffset < now.pictureOffset + now.pictureBytes { wrong += 1 }
        if k == 2 {
            const t0 = moveCable(2, 3, 300 * MS, users[0..])
            ticks(t0 + 3000 * MS)
            if follow.showing != 3 || seen.memory.pictureOffset != now.pictureOffset { wrong += 1 }
        }
        k += 1
    }
    expect(wrong == 0, "every new picture beside the one before; a move keeps the picture where it is")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    name = "the ROM"
    makeEdids()
    card.reset()
    open()
    lend()
    expect(board.found && board.count == 5, "the user's connectors")
    changeThenMove()
    moveThenChange()
    moveToAnotherMonitor()
    backAfterChange()
    changeForAnotherMonitor()
    changeLost()
    pendingMoved()
    pendingStays()
    pendingOther()
    deadlineMeetsMove()
    stoodStill()
    lateConfirmation()
    forgotten()
    room()
    neverOver()
    tickDuringChange()
    moveDuringChange()
    requestDuringMove()
    requestDuringFailedMove()
    changeDuringReading()
    plugDuringChange()
    plugDuringMove()
    moveWaitsForReading()
    if failed != 0 { return failed }
    return 13
}
