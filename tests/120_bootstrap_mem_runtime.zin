const bootstrap = @import("../std/bootstrap/root.zin")

fn main() -> u8 {
    var source: [3]u8 = [3]u8{ 3, 4, 5 }
    var destination: [3]u8 = [3]u8{ 0, 0, 0 }
    unsafe {
        bootstrap.mem.copy(
            @ptrCast([*]u8, &destination),
            @ptrCast([*]const u8, &source),
            3,
        )
    }
    return destination[0] + destination[1] + destination[2]
}
