const Header = struct {
    byte: u8
    word: u32
}

const Owned = @nocopy(struct) {
    handle: usize
}

pub fn main() {
    const layout = @fieldCount(Header) + @offsetOf(Header, "word") + @sizeOf(Header) + @sizeOf(@fieldType(Header, "word"))
    const traits = @hasField(Header, "byte") + @isStruct(Header) + @isCopyable(Header) + @isCopyable(Owned)
    return layout + traits
}
