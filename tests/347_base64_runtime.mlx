// std.base64: the test vectors of RFC 4648 section 10 for base64, base32,
// base32hex and base16 (one-shot, then a byte at a time through an
// Encoder and a Decoder), base64url's two symbols, garbage skipped or
// refused, and lower-case hex. Exits 13 when every check holds, else the
// number of the first check that failed.
const base64 = @import("std.base64")

const Encoding = base64.Encoding

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// "foobar" cut to `length` bytes.
fn prefix(length: usize) -> []const u8 {
    const text: []const u8 = "foobar"
    return text[0..length]
}

// `input` encoded one-shot and a byte at a time, both `expected`; and
// `expected` decoded back to `input`, one-shot and a byte at a time.
fn roundTrip(encoding: Encoding, input: []const u8, expected: []const u8) -> bool {
    var out: [32]u8 = undefined
    const bytes: [*]u8 = &out
    const count = base64.encode(encoding, input, bytes, true)
    if !same(bytes[0..count], expected) { return false }
    if base64.encodedLength(encoding, input.length, true) != expected.length { return false }

    var encoder: base64.Encoder = undefined
    base64.encoderInit(&encoder, encoding)
    var written: usize = 0
    var index: usize = 0
    while index < input.length {
        const rest: [*]u8 = unsafe { bytes + written }
        written += base64.encodeUpdate(&encoder, input[index .. index + 1], rest)
        index += 1
    }
    const tail: [*]u8 = unsafe { bytes + written }
    written += base64.encodeFinal(&encoder, tail, true)
    if !same(bytes[0..written], expected) { return false }

    var decoded: [32]u8 = undefined
    const plain: [*]u8 = &decoded
    const result = base64.decode(encoding, expected, plain, false)
    if !result.ok || !same(plain[0..result.length], input) { return false }

    var decoder: base64.Decoder = undefined
    base64.decoderInit(&decoder, encoding, false)
    var length: usize = 0
    index = 0
    while index < expected.length {
        const rest: [*]u8 = unsafe { plain + length }
        const step = base64.decodeUpdate(&decoder, expected[index .. index + 1], rest)
        if !step.ok { return false }
        length += step.length
        index += 1
    }
    return same(plain[0..length], input)
}

pub fn main() -> u8 {
    if !roundTrip(Encoding.base64, prefix(0), "") { return 1 }
    if !roundTrip(Encoding.base64, prefix(1), "Zg==") { return 2 }
    if !roundTrip(Encoding.base64, prefix(2), "Zm8=") { return 3 }
    if !roundTrip(Encoding.base64, prefix(3), "Zm9v") { return 4 }
    if !roundTrip(Encoding.base64, prefix(4), "Zm9vYg==") { return 5 }
    if !roundTrip(Encoding.base64, prefix(5), "Zm9vYmE=") { return 6 }
    if !roundTrip(Encoding.base64, prefix(6), "Zm9vYmFy") { return 7 }

    if !roundTrip(Encoding.base32, prefix(0), "") { return 8 }
    if !roundTrip(Encoding.base32, prefix(1), "MY======") { return 9 }
    if !roundTrip(Encoding.base32, prefix(2), "MZXQ====") { return 10 }
    if !roundTrip(Encoding.base32, prefix(3), "MZXW6===") { return 11 }
    if !roundTrip(Encoding.base32, prefix(4), "MZXW6YQ=") { return 12 }
    if !roundTrip(Encoding.base32, prefix(5), "MZXW6YTB") { return 39 }
    if !roundTrip(Encoding.base32, prefix(6), "MZXW6YTBOI======") { return 14 }

    if !roundTrip(Encoding.base32hex, prefix(0), "") { return 15 }
    if !roundTrip(Encoding.base32hex, prefix(1), "CO======") { return 16 }
    if !roundTrip(Encoding.base32hex, prefix(2), "CPNG====") { return 17 }
    if !roundTrip(Encoding.base32hex, prefix(3), "CPNMU===") { return 18 }
    if !roundTrip(Encoding.base32hex, prefix(4), "CPNMUOG=") { return 19 }
    if !roundTrip(Encoding.base32hex, prefix(5), "CPNMUOJ1") { return 20 }
    if !roundTrip(Encoding.base32hex, prefix(6), "CPNMUOJ1E8======") { return 21 }

    if !roundTrip(Encoding.base16, prefix(0), "") { return 22 }
    if !roundTrip(Encoding.base16, prefix(1), "66") { return 23 }
    if !roundTrip(Encoding.base16, prefix(2), "666F") { return 24 }
    if !roundTrip(Encoding.base16, prefix(3), "666F6F") { return 25 }
    if !roundTrip(Encoding.base16, prefix(4), "666F6F62") { return 26 }
    if !roundTrip(Encoding.base16, prefix(5), "666F6F6261") { return 27 }
    if !roundTrip(Encoding.base16, prefix(6), "666F6F626172") { return 28 }

    // 0xfb 0xff: the two symbols that differ between base64 and base64url.
    var high: [2]u8 = [2]u8{ 251, 255 }
    const highBytes: [*]const u8 = &high
    if !roundTrip(Encoding.base64, highBytes[0..2], "+/8=") { return 29 }
    if !roundTrip(Encoding.base64url, highBytes[0..2], "-_8=") { return 30 }

    var out: [16]u8 = undefined
    const bytes: [*]u8 = &out
    // Unpadded.
    if base64.encode(Encoding.base64url, prefix(4), bytes, false) != 6 || !same(bytes[0..6], "Zm9vYg") { return 31 }
    // Line breaks are skipped, garbage refused or skipped.
    var result = base64.decode(Encoding.base64, "Zm9v\nYmFy\n", bytes, false)
    if !result.ok || !same(bytes[0..result.length], "foobar") { return 32 }
    result = base64.decode(Encoding.base64, "Zm9v*YmFy", bytes, false)
    if result.ok || result.length != 3 { return 33 }
    result = base64.decode(Encoding.base64, "Zm9v*YmFy", bytes, true)
    if !result.ok || !same(bytes[0..result.length], "foobar") { return 34 }
    // Nothing after the padding.
    result = base64.decode(Encoding.base64, "Zg==Zm9v", bytes, false)
    if !result.ok || !same(bytes[0..result.length], "f") { return 35 }

    // Hex, lower-case out, either case in.
    var digest: [4]u8 = [4]u8{ 0, 171, 205, 255 }
    const digestBytes: [*]const u8 = &digest
    if base64.hexEncode(digestBytes[0..4], bytes) != 8 || !same(bytes[0..8], "00abcdff") { return 36 }
    if !base64.hexDecode("00ABcdfF", bytes) || bytes[1] != 171 || bytes[3] != 255 { return 37 }
    if base64.hexDecode("0g", bytes) || base64.hexDecode("abc", bytes) { return 38 }
    return 13
}
