// std.net and std.net.dns: addresses read and written (IPv4, IPv6 with
// its zero runs and an IPv4 tail), socket addresses both ways, a TCP
// connection on the loopback (listen, connect, accept, send, receive, the
// port the system picked), DNS queries written and answers read (names
// with compression pointers, a CNAME followed, AAAA records), and the
// names answered without a server (literals, localhost). Exits 13 when
// every check holds, else the number of the first check that failed.
const std = @import("std")
const net = @import("std.net")
const dns = @import("std.net.dns")

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn addressIs(address: *const net.Address, expected: []const u8) -> bool {
    var text: [64]u8 = undefined
    const n = net.writeAddress(address, text[0..64])
    return same(text[0..n], expected)
}

pub fn main() -> u8 {
    var address: net.Address = undefined
    // Literals.
    if !net.parseAddress("192.0.2.1", 80, &address) || address.family != net.Family.ipv4 || address.bytes[0] != 192 || address.bytes[3] != 1 || address.port != 80 || !addressIs(&address, "192.0.2.1") { return 1 }
    if net.parseAddress("192.0.2", 80, &address) || net.parseAddress("256.0.0.1", 80, &address) || net.parseAddress("example.com", 80, &address) || net.parseAddress("1.2.3.4.5", 80, &address) { return 2 }
    if !net.parseAddress("2001:db8::1", 443, &address) || address.family != net.Family.ipv6 || address.bytes[0] != 0x20 || address.bytes[1] != 1 || address.bytes[2] != 0x0d || address.bytes[3] != 0xb8 || address.bytes[15] != 1 || address.bytes[4] != 0 || !addressIs(&address, "2001:db8::1") { return 3 }
    if !net.parseAddress("::1", 1, &address) || !addressIs(&address, "::1") || !net.parseAddress("[::1]", 1, &address) || !addressIs(&address, "::1") { return 4 }
    if !net.parseAddress("::", 1, &address) || !addressIs(&address, "::") || !net.parseAddress("1::", 1, &address) || !addressIs(&address, "1::") { return 5 }
    if !net.parseAddress("::ffff:192.0.2.1", 1, &address) || address.bytes[10] != 255 || address.bytes[11] != 255 || address.bytes[12] != 192 || address.bytes[15] != 1 || !addressIs(&address, "::ffff:c000:201") { return 6 }
    if !net.parseAddress("1:2:3:4:5:6:7:8", 1, &address) || !addressIs(&address, "1:2:3:4:5:6:7:8") || !net.parseAddress("1:0:0:2:0:0:0:3", 1, &address) || !addressIs(&address, "1:0:0:2::3") { return 7 }
    if !net.parseAddress("fe80::1%3", 1, &address) || address.scope != 3 { return 8 }
    if net.parseAddress("1::2::3", 1, &address) || net.parseAddress(":1", 1, &address) || net.parseAddress("1:2:3:4:5:6:7:8:9", 1, &address) || net.parseAddress("12345::", 1, &address) || net.parseAddress("1:", 1, &address) { return 9 }
    // Socket addresses both ways.
    var raw: [28]u8 = undefined
    const bytes: [*]u8 = &raw
    address = net.ipv4(10, 0, 0, 1, 8080)
    if net.sockaddr(&address, bytes) != 16 || raw[0] != 2 || raw[2] != 0x1f || raw[3] != 0x90 || raw[4] != 10 || raw[7] != 1 { return 10 }
    var back: net.Address = undefined
    if !net.fromSockaddr(bytes, 16, &back) || back.family != net.Family.ipv4 || back.port != 8080 || !addressIs(&back, "10.0.0.1") { return 11 }
    if !net.parseAddress("2001:db8::7", 53, &address) || net.sockaddr(&address, bytes) != 28 || raw[0] != 10 || raw[3] != 53 || raw[8] != 0x20 || raw[23] != 7 { return 12 }
    if !net.fromSockaddr(bytes, 28, &back) || back.family != net.Family.ipv6 || back.port != 53 || !addressIs(&back, "2001:db8::7") { return 14 }

    // A connection on the loopback.
    const loop = net.ipv4(127, 0, 0, 1, 0)
    const listener = net.listen(&loop, 4)
    if listener < 0 { return 15 }
    var bound: net.Address = undefined
    if !net.localAddress(listener, &bound) || bound.port == 0 || !addressIs(&bound, "127.0.0.1") { return 16 }
    const client = net.connect(&bound, 2000)
    if client < 0 { return 17 }
    var peer: net.Address = undefined
    const server = net.accept(listener, &peer)
    if server < 0 || !addressIs(&peer, "127.0.0.1") { return 18 }
    if !net.send(client, "hello server") { return 19 }
    var buffer: [64]u8 = undefined
    const into: [*]u8 = &buffer
    if !net.readable(server, 2000) { return 20 }
    var got = net.receive(server, into, 64)
    if got != 12 || !same(buffer[0..12], "hello server") { return 21 }
    if !net.send(server, "hello client") { return 22 }
    got = net.receive(client, into, 64)
    if got != 12 || !same(buffer[0..12], "hello client") { return 23 }
    net.shutdownWrite(server)
    got = net.receive(client, into, 64)
    if got != 0 { return 24 }
    net.close(server)
    net.close(client)
    net.close(listener)
    // Nothing listens there any more: refused.
    const refused = net.connect(&bound, 2000)
    if refused >= 0 { return 25 }

    // DNS messages.
    var query: [512]u8 = undefined
    const n = dns.writeQuery("www.example.com", 1, 0x1234, &query)
    if n != 33 || query[0] != 0x12 || query[1] != 0x34 || query[2] != 1 || query[5] != 1 || query[12] != 3 || !same(query[13..16], "www") || query[16] != 7 || query[28] != 0 || query[30] != 1 || query[32] != 1 { return 26 }
    if dns.writeQuery("", 1, 1, &query) != 0 || dns.writeQuery("a..b", 1, 1, &query) != 0 { return 27 }
    // An answer: the question, a CNAME to "web.example.com" (its name a
    // pointer to the question's), an A record of the alias, an AAAA
    // record of the alias, an A record of some other name.
    const answer = "\x12\x34\x81\x80\x00\x01\x00\x04\x00\x00\x00\x00\x03www\x07example\x03com\x00\x00\x01\x00\x01\xc0\x0c\x00\x05\x00\x01\x00\x00\x0e\x10\x00\x06\x03web\xc0\x10\xc0\x2d\x00\x01\x00\x01\x00\x00\x0e\x10\x00\x04\xc0\x00\x02\x01\xc0\x2d\x00\x1c\x00\x01\x00\x00\x0e\x10\x00\x10\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x05other\xc0\x10\x00\x01\x00\x01\x00\x00\x0e\x10\x00\x04\xc0\x00\x02\x02"
    var found: [8]net.Address = undefined
    const foundPointer: [*]net.Address = &found
    var count: usize = 0
    var rcode: u32 = 0
    if dns.readAnswer(answer, "www.example.com", 80, foundPointer, &count, 8, &rcode) != 2 || count != 2 || rcode != 0 { return 28 }
    if !addressIs(&found[0], "192.0.2.1") || found[0].port != 80 || !addressIs(&found[1], "2001:db8::1") { return 29 }
    count = 0
    if dns.readAnswer(answer, "other.example.com", 80, foundPointer, &count, 8, &rcode) != 1 || !addressIs(&found[0], "192.0.2.2") { return 30 }
    count = 0
    if dns.readAnswer("\x12\x34\x81\x83\x00\x00\x00\x00\x00\x00\x00\x00", "x", 80, foundPointer, &count, 8, &rcode) != 0 || rcode != 3 { return 31 }
    // Names answered without a server.
    count = net.resolve("192.0.2.9", 80, foundPointer, 8, 100)
    if count != 1 || !addressIs(&found[0], "192.0.2.9") || found[0].port != 80 { return 32 }
    count = net.resolve("localhost", 22, foundPointer, 8, 100)
    if count < 1 || !addressIs(&found[0], "127.0.0.1") || found[0].port != 22 { return 33 }
    count = net.resolve("::1", 22, foundPointer, 1, 100)
    if count != 1 || found[0].family != net.Family.ipv6 { return 34 }
    return 13
}
