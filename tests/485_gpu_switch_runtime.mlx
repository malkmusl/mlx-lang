// The monitor followed from one output of a Radeon to another
// (projects/brix/kernel/gpu_switch.mlx, with gpu_plug.mlx, gpu_ddc.mlx,
// gpu_mode.mlx and gpu_set.mlx, built for the host), on the user's whole
// card as a table (tests/support/switch_card.mlx: five connectors, the
// firmware's 1280x960 out of the HDMI connector 2 on DIG 4 in DVI mode at
// 107962 kHz, the card's tables as programs that write down what they
// were told, an I2C engine with an EDID memory behind each DDC line, the
// hot plug lines by a script), the boot and the timer's ticks driven as
// gpu.mlx drives them.
// At boot: the monitor on the firmware's output (the rule decides
// nothing, and the change is the plain plan's, write for write); on the
// other HDMI output (the picture brought there, every table run in the
// study's order with its block); on none; on a DisplayPort output (said,
// not followed); under the choice "firmware" (said what would be, nothing
// written); the firmware's output's line not judged and nothing answering
// there, and the same with its monitor answering (the picture stays); a
// card whose firmware started no output.
// While brixOS runs: the cable moved from the HDMI output to the other one
// and back, and from an HDMI output to the DVI one (the transmitter made
// ready once, the old PLL powered down, the picture where it was, nothing
// cleared, every write and table run in order); the monitor switched off
// and on, and to another input and back (the same EDID: nothing written);
// a second monitor (said, not driven); the monitor pulled with none
// elsewhere (kept, said once) and plugged in again; another monitor of
// another size (said, not followed); the output found not sending when
// its monitor is back (a mode set again tried, refused: there is no
// running output to start from; tried again after 5 s and 30 s as the
// log says, then left); a move whose way back does not come to its end
// (not tried again, the monitor not followed any more at this boot);
// another monitor of the picture's size on the same output (its own
// timing set, the picture kept); a monitor plugged into the firmware's
// output after a boot with nothing there and no EDID passed on (counted
// as another monitor: of another size, said); monitors on the other HDMI
// and the DVI connector at once (HDMI first); a monitor that answers only
// when it is asked a second time; a move that waits while another
// connector's EDID is read; something that gives no EDID; a monitor on a
// DisplayPort connector (said, not followed, also when the picture's
// monitor is pulled); a move under
// "ask" (said only); the transmitter's init disturbing the output that
// shows the picture (taken off, its frames stopped, its frames at another
// rate: the change ends before anything is taken down); the transmitter's
// table doing nothing for "init", as the user's ROM's does (the move goes
// on, at boot and while brixOS runs); a failure at every write and every
// table run of the move, and the way back from each (the state of before,
// the move tried again later); a move given up after three tries.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const plug = @import("../projects/brix/kernel/gpu_plug.mlx")
const ddc = @import("../projects/brix/kernel/gpu_ddc.mlx")
const rule = @import("../projects/brix/kernel/gpu_switch.mlx")
const rom = @import("./support/atom_rom.mlx")
const display = @import("./support/tmds_card.mlx")
const lines = @import("./support/plug_card.mlx")
const card = @import("./support/switch_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0
var name: []const u8 = undefined

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected (")
    say(name)
    say("): ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(display.has(text), text) }

fn once(text: []const u8) -> void { expect(display.count(text) == 1, text) }

fn noLine(text: []const u8) -> void {
    if !display.has(text) { return }
    say("said, but should not be (")
    say(name)
    say("): ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    display.logWrite(text)
    if show { say(text) }
}

const MS: usize = 1000000

fn out() -> scanout.Card { return scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite } }

// The ROM and what is read of it.
var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

fn open(odd: usize, ending: display.Ending) -> void {
    card.makeRom(&builder, odd, ending)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
}

// The EDIDs: the user's monitor (3840x1080 at 270270 kHz, its HDMI block
// in the extension), a DVI monitor of 1920x1080 at 148500 kHz (one
// block), and one of 2560x1440.
var users: [256]u8 = undefined
var small: [128]u8 = undefined
var large: [128]u8 = undefined
// (And another HDMI monitor of 3840x1080, at 266640 kHz on 4000 by 1111:
// plug_card's own timing; and one like the user's at 50 Hz, 225230 kHz on
// the same 4040 by 1115.)
var other: [256]u8 = undefined
var slower: [256]u8 = undefined

fn resum(bytes: []u8, block: usize) -> void {
    var sum: usize = 0
    var k: usize = 0
    while k < 127 {
        sum += @intCast(usize, bytes[block * 128 + k])
        k += 1
    }
    bytes[block * 128 + 127] = @intCast(u8, (256 - (sum & 0xFF)) & 0xFF)
}

fn timing(bytes: []u8, words: []const u8) -> void {
    var k: usize = 0
    while k < 12 {
        bytes[54 + k] = words[k]
        k += 1
    }
    bytes[71] = 0x1A
}

fn makeEdids() -> void {
    _ = lines.edid(users[0..], 2, true)
    const wide = [_]u8{ 0x93, 0x69, 0x00, 0xC8, 0xF0, 0x38, 0x23, 0x40, 48, 32, 0x35, 0x00 }
    timing(users[0..], wide[0..])
    resum(users[0..], 0)
    _ = lines.edid(small[0..], 1, false)
    const full = [_]u8{ 0x02, 0x3A, 0x80, 0x18, 0x71, 0x38, 0x2D, 0x40, 0x58, 0x2C, 0x45, 0x00 }
    timing(small[0..], full[0..])
    small[71] = 0x1E
    resum(small[0..], 0)
    _ = lines.edid(large[0..], 1, false)
    // 2560x1440 at 241500 kHz: 2720 by 1481.
    const big = [_]u8{ 0x56, 0x5E, 0x00, 0xA0, 0xA0, 0xA0, 0x29, 0x50, 48, 32, 0x35, 0x00 }
    timing(large[0..], big[0..])
    resum(large[0..], 0)
    _ = lines.edid(other[0..], 2, true)
    var k: usize = 0
    while k < 256 {
        slower[k] = users[k]
        k += 1
    }
    slower[54] = 0xFB
    slower[55] = 0x57
    resum(slower[0..], 0)
}

// The kernel's side, as gpu.mlx has it.
var watch: plug.Watch = undefined
var verdict: plug.Verdict = undefined
var follow: rule.Follow = undefined
var decided: rule.Decision = undefined
var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var result: set.Result = undefined
var memory: scanout.Memory = undefined
var lentHands: set.Hands = undefined
var lentTables: set.Tables = undefined
var facts: mode.Rom = undefined
var lent: rule.Lent = undefined
var how = rule.How.follows

fn lend() -> void {
    lentHands = set.Hands.{ .write = card.write, .clear = display.clear }
    lentTables = set.Tables.{ .machine = &machine, .hands = display.hands(), .aside = display.setAside }
    facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    lent = rule.Lent.{ .hands = &lentHands, .tables = &lentTables, .rom = &facts, .memory = &memory, .readout = &readout, .plan = &plan, .result = &result }
}

// The machine made anew (the firmware's state; the lines high whose bits
// `high` has, by line; each connector's monitor as `on` says: 0 none, 1
// the user's, 2 the small one, 3 the large one) with the ROM made here.
fn machineWith(title: []const u8, high: usize, on: [5]usize) -> void {
    name = title
    if show {
        say("-- ")
        say(title)
        say("\n")
    }
    card.users(107962, high)
    var k: usize = 0
    while k < 5 {
        if on[k] == 1 { card.monitor(k, users[0..]) }
        if on[k] == 2 { card.monitor(k, small[0..]) }
        if on[k] == 3 { card.monitor(k, large[0..]) }
        k += 1
    }
}

// The boot as gpu.mlx makes it: every connector looked at and said, the
// monitors asked (not under "firmware"), the rule at boot, the plan (for
// the connector the rule names, or the plain one) said and listed, carried
// out unless the choice keeps the firmware's picture or its output has
// nothing for certain, what serves each connector read anew and the record
// begun. The picture the kernel knows then is the new one when there is
// one. The loader passed the first block of the user's EDID on.
fn boot() -> void {
    const c = out()
    const h = card.hands()
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    plug.sayPorts(&c, &watch.ports)
    plug.detect(&watch.ports, &verdict)
    plug.sayVerdict(&c, &watch.ports, &verdict)
    if how != rule.How.quiet { plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader) }
    decided = rule.atBoot(&c, &watch.ports, &verdict, &follow, how)
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    scanout.report(&c, &memory, &readout)
    // (The plan's monitor: the one the rule brings the picture to, else
    // the firmware's output's as read there, else the loader's block.)
    var monitor = edid.read(users[0..128])
    var offer = edid.offer(users[0..128])
    const s = verdict.output
    if decided.act == rule.Act.move && how == rule.How.follows {
        monitor = watch.ports.ports[decided.to].monitor
        offer = watch.ports.ports[decided.to].offer
    } else if s != plug.NONE && watch.ports.ports[s].heard.outcome == ddc.Outcome.read {
        monitor = watch.ports.ports[s].monitor
        offer = watch.ports.ports[s].offer
    }
    if decided.act == rule.Act.move && how == rule.How.follows {
        const target = rule.targetFor(&watch.ports, &follow, decided, false)
        mode.makeTo(&c, &readout, &memory, &target, &monitor, &offer, &facts, &plan)
    } else {
        mode.makeFor(&c, &readout, &memory, &monitor, &offer, &facts, mode.Wish.own, &plan)
    }
    mode.say(&c, &plan)
    mode.list(&c, &plan)
    display.forget()
    lines.written = 0
    result.outcome = set.Outcome.untouched
    if how == rule.How.follows && plan.complete && (plan.move.on || plug.emptyFor(&watch.ports, plan.controller) == plug.NONE) {
        _ = set.attemptWith(&c, &lentHands, &lentTables, &plan, true, &result)
    }
    plug.serveAll(&c, &watch.ports)
    var bytes = users[0..128]
    const now = plug.servedBy(&watch.ports, plan.controller)
    if now != plug.NONE && watch.ports.ports[now].heard.outcome == ddc.Outcome.read { bytes = watch.ports.ports[now].heard.bytes[0..watch.ports.ports[now].heard.count] }
    rule.begin(&follow, follow.how, &watch.ports, plan.controller, memory.pictureWidth, memory.pictureHeight, bytes, 0, 0, 0)
    _ = rule.carried(&c, &follow, &watch.ports, &plan, &result, decided)
    if result.outcome == set.Outcome.done && !plan.move.keep {
        memory.pictureOffset = plan.offset
        memory.pictureBytes = plan.bytes
        memory.pictureWidth = plan.width
        memory.pictureHeight = plan.height
        memory.picturePitch = plan.pitch
    }
}

// The timer's ticks until the clock is at `until` (10 ms apart): the
// plug item's, then the rule's.
fn ticks(until: usize) -> void {
    const c = out()
    const h = card.hands()
    while display.clock < until {
        card.pass(10 * MS)
        if how == rule.How.quiet {
            plug.tick(&c, null, &watch)
        } else {
            plug.tick(&c, &h, &watch)
        }
        rule.tick(&c, &lent, &follow, &watch)
    }
}

// The registers as they were before a change.
var before: [display.ROOM]usize = undefined
var beforeMarks: [24]usize = undefined

fn remember() -> void {
    var k: usize = 0
    while k < display.ROOM {
        before[k] = display.registers[k]
        k += 1
    }
    k = 0
    while k < 24 {
        beforeMarks[k] = display.marks[k]
        k += 1
    }
}

// Whether every register of the display holds what it held (but the
// tables' mail and the card's own answers).
fn asBefore() -> bool {
    var k: usize = 0
    while k < display.ROOM {
        var answers: usize = 0
        if k >= 0x321 && k < 0x327 { answers = 0x10 }
        if k == 0x1A11 || k == 0x1C11 || k == 0x1E11 { answers = 0x4 }
        if (display.registers[k] ^ before[k]) & ~answers != 0 && (k < display.MAIL || k > display.ANSWER) {
            if show {
                const o = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
                say("differs: ")
                o.hexDigits(k, 4)
                say(" ")
                o.hexDigits(display.registers[k], 8)
                say(" was ")
                o.hexDigits(before[k], 8)
                say("\n")
            }
            return false
        }
        k += 1
    }
    k = 0
    while k < 24 {
        if display.marks[k] != beforeMarks[k] { return false }
        k += 1
    }
    return true
}

// The table runs from write `from` on, in order: each its table's place
// in the ROM's list and the first two words of its block.
const Run = struct {
    table: usize
    w0: usize
    w1: usize
}

var found: [32]Run = undefined
var runsFound: usize = 0

fn runsFrom(from: usize) -> void {
    runsFound = 0
    var k = from
    var w0: usize = 0
    var w1: usize = 0
    while k < display.written && k < display.WRITES {
        const to = display.writtenTo[k]
        if to == display.MAIL { w0 = display.writtenWith[k] }
        if to == display.MAIL + 1 { w1 = display.writtenWith[k] }
        if to == display.GO && runsFound < 32 {
            found[runsFound] = Run.{ .table = display.writtenWith[k], .w0 = w0, .w1 = w1 }
            runsFound += 1
            w0 = 0
            w1 = 0
        }
        k += 1
    }
}

fn sameRuns(what: []const u8, expected: []const usize) -> void {
    var k: usize = 0
    while k * 3 + 2 < expected.length {
        if k >= runsFound || found[k].table != expected[k * 3] || found[k].w0 != expected[k * 3 + 1] || found[k].w1 != expected[k * 3 + 2] {
            const o = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
            say("not as expected (")
            say(name)
            say("): ")
            say(what)
            o.field(": run ", k + 1)
            if k < runsFound {
                o.field(" is table ", found[k].table)
                o.fieldHex(" ", found[k].w0)
                o.fieldHex(" ", found[k].w1)
            } else {
                say(" is not there")
            }
            o.field(", worked out table ", expected[k * 3])
            o.fieldHex(" ", expected[k * 3 + 1])
            o.fieldHex(" ", expected[k * 3 + 2])
            say("\n")
            if failed == 0 { failed = 3 }
            return
        }
        k += 1
    }
    expect(runsFound == expected.length / 3, what)
}

// Where in the list of writes register `register` was written with
// `value` under `mask` first from `from` on (NEVER: not).
fn writeAt(from: usize, register: usize, mask: usize, value: usize) -> usize {
    var k = from
    while k < display.written && k < display.WRITES {
        if display.writtenTo[k] == register && display.writtenWith[k] & mask == value { return k }
        k += 1
    }
    return card.NEVER
}

// Whether any write from `from` on went into a block of registers
// (`first` to `last`).
fn writtenIn(from: usize, first: usize, last: usize) -> bool {
    var k = from
    while k < display.written && k < display.WRITES {
        if display.writtenTo[k] >= first && display.writtenTo[k] <= last { return true }
        k += 1
    }
    return false
}

// THE MOVE FROM THE HDMI CONNECTOR 2 TO THE HDMI CONNECTOR 3 while brixOS
// runs, the picture 3840x1080 at 270270 kHz in HDMI kept: the study's 4.5
// row "TMDS -> TMDS", table run for table run, each by its place in the
// ROM's list and its block's first two words (gpu-autoswitch 3.4, 3.5,
// 4.2, 4.6).
const MOVE_RUNS = [_]usize{
    // B3: UNIPHYTransmitterControl, INIT: 05 | 07 | 02 | 04 | 00000000 |
    // 04 | 00 | 0c (UNIPHY F, hot plug line 4, HDMI).
    76, 0x04020705, 0x00000000,
    // D3: the old transmitter (UNIPHY E) off, told the mode it has (HDMI,
    // 3) and its line 6: 04 | 00 | 03 | 00 | 0 | 06 | 00 | 0c.
    76, 0x00030004, 0x00000000,
    // D5: EnableCRTC, controller 0 stopped.
    35, 0x00000000, 0,
    // X1: PLL 4 powered down: 00000000 | 18 | 00 | 0f | 01 | ff.
    12, 0x00000000, 0x010F0018,
    // C1: SetPixelClock 2702700 hundreds of Hz on PLL 25 (0x19), encoder
    // object 0x21, HDMI, controller 0.
    12, 0x00293D6C, 0x00032119,
    // C3: the timing (3840 with 200 of blanking, 1080 with 35).
    49, 0x00C80F00, 0x00230438,
    // C5: EnableCRTC, controller 0 started.
    35, 0x00000100, 0,
    // U2: DIGxEncoderControl, stream setup on front end 5: 05 | 0f | 03 |
    // 04 | 2702700 / 100.
    4, 0x04030F05, 0x00006993,
    // U5: the new transmitter on: 05 | 01 | 03 | 04 | 27027 | 04 | 00 |
    // 0c.
    76, 0x04030105, 0x00006993,
}

// The way back to connector 3's state of before (HDMI 3840x1080 at
// 270270 kHz on DIG 4) from connector 3: the same row with the ends
// exchanged; DIG 4's transmitter was the firmware's, so no INIT.
const BACK_RUNS = [_]usize{
    76, 0x00030005, 0x00000000,
    35, 0x00000000, 0,
    12, 0x00000000, 0x010F0019,
    12, 0x00293D6C, 0x00032118,
    49, 0x00C80F00, 0x00230438,
    35, 0x00000100, 0,
    4, 0x04030F04, 0x00006993,
    76, 0x04030104, 0x00006993,
}

// The user's machine after a boot that set the monitor's own mode on the
// HDMI connector 2 (3840x1080 at 270270 kHz, HDMI).
fn bootedOn2(title: []const u8) -> void {
    machineWith(title, 1 << 6, [_]usize{ 0, 0, 1, 0, 0 })
    how = rule.How.follows
    boot()
    expect(result.outcome == set.Outcome.done && follow.showing == 2 && follow.width == 3840 && follow.clock == 270270, "the boot set the monitor's own mode on connector 2")
}

// The cable moved from connector `from` to connector `to`: pulled now,
// in the other one `after` later.
fn moveCable(from: usize, to: usize, after: usize, bytes: []const u8) -> usize {
    const t0 = display.clock
    card.unplug(from)
    card.line(from, false, card.NEVER)
    ticks(t0 + after)
    card.monitor(to, bytes)
    card.line(to, true, card.NEVER)
    return t0
}

fn movedTo3() -> void {
    bootedOn2("moved from HDMI 2 to HDMI 3 while brixOS runs")
    remember()
    const first = display.written
    const cleared = display.cleared
    const surface = display.registers[0x1A04]
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 900 * MS)
    expect(follow.showing == 2 && display.written == first, "nothing is moved before the line has been low for a second")
    ticks(t0 + 3000 * MS)
    once("gpu: the monitor was unplugged from connector 2 (HDMI): the picture still goes out there, to nothing\n")
    once("gpu: something was plugged into connector 3 (HDMI)\n")
    once("gpu: connector 3 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 2 blocks over DDC line 2, the card's DDC3)\n")
    once("gpu: the monitor is on connector 3 (HDMI) now, and nothing is plugged into connector 2 (HDMI): the picture is brought there (the card's display is this driver's alone meanwhile: no other processor enters the kernel, programs go on drawing)\n")
    once("gpu: plan (move, TMDS): connector 2 (HDMI, DIG 4, PLL 4) to connector 3 (HDMI, DIG 5, front end 5, PLL 5), controller 0 stays: HDMI signalling at 270270 kHz (now HDMI at 270270 kHz), the picture of 3840x1080 stays where it is: 9 table runs and ")
    line("gpu: bringing the picture to the other output: carrying out the plan's 9 table runs and ")
    line(" writes; the screen is dark meanwhile, ")
    line(" s more at most if the state of before has to be put back)\n")
    line(" frames a second: the picture goes out by the new output (9 table runs, ")
    once("gpu: the picture goes out by connector 3 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
    once("gpu: connector 2 (HDMI): the monitor has left and no other connector has one: the output is kept as it is (nothing is taken down)\n")
    line("gpu: controller 0 takes its pixel clock from PHY PLL 4; the way back would ask for 270270 kHz (as this driver set it) and the timing 3840x1080 of 4040x1115")
    noLine("gives no EDID that holds")
    expect(result.outcome == set.Outcome.done && follow.showing == 3 && follow.moves == 2 && follow.ready[5], "the picture goes out by connector 3, DIG 5's transmitter made ready")
    expect(watch.ports.ports[3].firmware && !watch.ports.ports[2].firmware && watch.ports.ports[3].frontEnd == 5 && watch.ports.ports[3].controller == 0, "connector 3 serves controller 0 by front end 5")
    expect(display.cleared == cleared && display.registers[0x1A04] == surface && display.registers[0x1A06] == 3840 && display.registers[0x1A0D] == 3840 && display.registers[0x1A0E] == 1080, "the picture's memory is where it was, nothing cleared")
    expect(display.pll[4] == 0 && display.pll[5] == 270270 && display.registers[0x143] & 7 == 5, "PLL 4 powered down, controller 0 on PLL 5")
    expect(display.registers[scanout.DIG[5] + scanout.DIG_BE_EN_CNTL] & 1 == 1 && display.registers[scanout.DIG[4] + scanout.DIG_BE_EN_CNTL] & 1 == 0, "DIG 5 on, DIG 4 off")
    expect(display.registers[scanout.DIG[5] + scanout.DIG_BE_CNTL] & 0x70072000 == 0x30032000, "DIG 5: hot plug line 4, HDMI, front end 5")
    expect(display.registers[scanout.DIG[5] + scanout.DIG_FE_CNTL] & 7 == 0, "front end 5 takes controller 0")
    runsFrom(first)
    sameRuns("the move's table runs", MOVE_RUNS[0..])
    // B3 before B1 before D2 (the study's 4.2, corrected); X1 after D6 and
    // before C1 (4.6).
    const init = writeAt(first, display.GO, 0xFFFFFFFF, 76)
    const select = writeAt(first, scanout.DIG[5] + scanout.DIG_BE_CNTL, 0x70000000, 0x30000000)
    const off = writeAt(first, scanout.DIG[4] + scanout.DIG_BE_CNTL, 0x1000, 0)
    const buffers = writeAt(first, 0x321, 7, 0)
    const down = writeAt(buffers, display.MAIL + 1, 0xFFFFFFFF, 0x010F0018)
    const clock = writeAt(first, display.MAIL + 1, 0xFFFFFFFF, 0x00032119)
    expect(init < select && select < off && buffers < down && down < clock && clock != card.NEVER, "INIT, then the hot plug select, then the old output down; the old PLL off after the buffers, before the new clock")
    // (The old output, which sends HDMI, muted before it is taken down.)
    const muted = writeAt(first, scanout.DIG[4] + mode.HDMI_GC, 1, 1)
    expect(muted != card.NEVER && select < muted && muted < off, "the old output muted before its front end is taken off")
    expect(!writtenIn(first, scanout.DIG[0], scanout.DIG[0] + 0xFF) && !writtenIn(first, scanout.DIG[2], scanout.DIG[3] + 0xFF) && !writtenIn(first, 0x1C00, 0x27FF), "nothing of another back end or controller is written")
    expect(lines.written != 0 && follow.tries == 0, "the EDID was read by the engine")
}

fn movedBack() -> void {
    movedTo3()
    name = "moved back from HDMI 3 to HDMI 2"
    display.logged = 0
    const first = display.written
    const t0 = moveCable(3, 2, 200 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    once("gpu: plan (move, TMDS): connector 3 (HDMI, DIG 5, PLL 5) to connector 2 (HDMI, DIG 4, front end 4, PLL 4), controller 0 stays: ")
    once("gpu: the picture goes out by connector 2 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
    expect(result.outcome == set.Outcome.done && follow.showing == 2 && display.pll[5] == 0 && display.pll[4] == 270270, "back on connector 2, PLL 5 powered down")
    runsFrom(first)
    sameRuns("the move back's table runs (no INIT: DIG 4 is the firmware's)", BACK_RUNS[0..])
}

// ---- AT BOOT.

// The writes of a change, kept to be held against another's.
var keptTo: [display.WRITES]usize = undefined
var keptWith: [display.WRITES]usize = undefined
var keptCount: usize = 0

fn keepWrites() -> void {
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        keptTo[k] = display.writtenTo[k]
        keptWith[k] = display.writtenWith[k]
        k += 1
    }
    keptCount = display.written
}

fn sameAsKept() -> bool {
    if display.written != keptCount { return false }
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        if display.writtenTo[k] != keptTo[k] || display.writtenWith[k] != keptWith[k] { return false }
        k += 1
    }
    return true
}

// The monitor on the firmware's output: the rule decides nothing, and the
// change is the plain plan's, write for write, as a boot without the rule
// makes it (the plan made by `makeFor`, carried out alike).
fn bootThere() -> void {
    bootedOn2("at boot: the monitor on the firmware's output")
    once("gpu: the picture stays on connector 2 (HDMI), where the monitor is\n")
    line("gpu: plan (b, TMDS): HDMI signalling at 270270 kHz (now DVI at 107960 kHz), ")
    expect(decided.act == rule.Act.stay && !plan.move.asked, "nothing decided, the plain plan")
    keepWrites()
    // The same boot without the rule.
    machineWith("at boot: the same without the rule", 1 << 6, [_]usize{ 0, 0, 1, 0, 0 })
    const c = out()
    const h = card.hands()
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    scanout.report(&c, &memory, &readout)
    mode.makeFor(&c, &readout, &memory, &watch.ports.ports[2].monitor, &watch.ports.ports[2].offer, &facts, mode.Wish.own, &plan)
    display.forget()
    _ = set.attemptWith(&c, &lentHands, &lentTables, &plan, true, &result)
    expect(result.outcome == set.Outcome.done && sameAsKept(), "the same writes, in the same order, as without the rule")
}

// The monitor on the other HDMI output, nothing on the firmware's: the
// picture brought there at boot, a new one of the monitor's size.
fn bootOn3() -> void {
    machineWith("at boot: the monitor on the other HDMI output", 1 << 4, [_]usize{ 0, 0, 0, 1, 0 })
    how = rule.How.follows
    boot()
    once("gpu: nothing is plugged into the HDMI connector 2 (DIG 4, hot plug line 6), where the firmware's picture goes out\n")
    once("gpu: something is plugged into connector 3 (HDMI), which the firmware did not start\n")
    once("gpu: the monitor is on connector 3 (HDMI), the firmware's picture goes out by connector 2 (HDMI), where nothing is plugged in: the picture is brought to the monitor\n")
    once("gpu: plan (move, TMDS): connector 2 (HDMI, DIG 4, PLL 4) to connector 3 (HDMI, DIG 5, front end 5, PLL 5), controller 0 stays: HDMI signalling at 270270 kHz (now DVI at 107960 kHz), a picture of 3840x1080 at 0x500000 of the aperture, the scaler off: 9 table runs and ")
    line(" frames a second: the picture goes out by the new output (9 table runs, ")
    expect(decided.act == rule.Act.move && decided.to == 3 && result.outcome == set.Outcome.done, "the picture brought to connector 3 at boot")
    expect(follow.showing == 3 && follow.width == 3840 && follow.ready[5] && display.pll[4] == 0 && display.pll[5] == 270270, "connector 3 shows the new picture; PLL 4 powered down")
    expect(display.cleared == 1 && display.clearedAt == 0x500000 && display.registers[0x1A04] == 0x500000, "the new picture cleared and shown")
    runsFrom(0)
    expect(runsFound == 9 && found[0].table == 76 && found[0].w0 == 0x04020705 && found[3].table == 12 && found[3].w1 == 0x010F0018 && found[4].w1 == 0x00032119, "INIT of UNIPHY F first, PLL 4 powered down, PLL 25 set")
}

// Nothing plugged in anywhere: the picture stays, nothing is written.
fn bootNone() -> void {
    machineWith("at boot: nothing plugged in", 0, [_]usize{ 0, 0, 0, 0, 0 })
    how = rule.How.follows
    boot()
    once("gpu: the picture stays on connector 2 (HDMI): there is no monitor it can be brought to\n")
    expect(decided.act == rule.Act.stay && result.outcome == set.Outcome.untouched && display.written == 0, "nothing written")
}

// A monitor on a DisplayPort connector alone: said, not followed.
fn bootDisplayPort() -> void {
    machineWith("at boot: a monitor on a DisplayPort connector", 1 << 1, [_]usize{ 1, 0, 0, 0, 0 })
    how = rule.How.follows
    boot()
    once("gpu: something is plugged into connector 0 (DisplayPort): a monitor on a DisplayPort connector is not followed yet\n")
    once("gpu: the picture stays on connector 2 (HDMI): there is no monitor it can be brought to\n")
    noLine("gives no EDID that holds")
    expect(decided.act == rule.Act.stay && display.written == 0, "nothing written")
}

// The firmware's output's line not judged and its monitor answering there,
// a monitor on the other HDMI output too: the picture stays (the study's
// F: its monitor counts as there), the other is a second one.
fn bootUnjudgedThere() -> void {
    machineWith("at boot: the firmware's output's line not judged, its monitor answers", 1 << 4, [_]usize{ 0, 0, 1, 1, 0 })
    lines.registers[plug.DC_HPD_CONTROL + 5 * plug.HPD_STEP] = 0
    how = rule.How.follows
    boot()
    once("gpu: the picture stays on connector 2 (HDMI): its monitor counts as there\n")
    once("gpu: a second monitor on connector 3 (HDMI), 3840x1080: it is not driven (one picture, on connector 2 (HDMI))\n")
    expect(decided.act == rule.Act.stay && follow.showing == 2 && result.outcome == set.Outcome.done, "the picture stays, its mode set there")
}

// A monitor plugged into a DisplayPort connector while brixOS runs: said,
// and still not followed when the picture's monitor is pulled.
fn displayPortWhileRunning() -> void {
    bootedOn2("a monitor plugged into a DisplayPort connector while it runs")
    display.forget()
    display.logged = 0
    card.monitor(1, users[0..])
    card.line(1, true, card.NEVER)
    ticks(display.clock + 2000 * MS)
    once("gpu: something is plugged into connector 1 (DisplayPort): a monitor on a DisplayPort connector is not followed yet\n")
    display.logged = 0
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(display.clock + 3000 * MS)
    noLine("gives no EDID that holds")
    noLine("the picture is brought there")
    expect(display.written == 0 && follow.showing == 2, "nothing written")
}

// Under "firmware": nobody asked, nothing written, what would be done said.
fn bootQuiet() -> void {
    machineWith("at boot under \"firmware\": the monitor on the other HDMI output", 1 << 4, [_]usize{ 0, 0, 0, 1, 0 })
    how = rule.How.quiet
    boot()
    once("gpu: the monitor is on connector 3 (HDMI), the firmware's picture goes out by connector 2 (HDMI), where nothing is plugged in: this boot writes nothing, so the picture stays (a boot of the monitor's own mode would bring it there, if its EDID holds)\n")
    expect(display.written == 0 && lines.written == 0 && lines.runs == 0, "nothing written, nobody asked")
    // (What the boot said is not said again from the ticks.)
    display.logged = 0
    ticks(display.clock + 3000 * MS)
    noLine("the monitor is on connector 3 (HDMI)")
    // Moved while it runs: said what would be done, once, nothing written.
    display.logged = 0
    const t0 = moveCable(3, 4, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    once("gpu: the monitor is on connector 4 (DVI-D (dual link)) now, and nothing is plugged into connector 2 (HDMI): a boot of the monitor's own mode would bring the picture there; this one writes nothing to the display\n")
    noLine("the monitor is on connector 3 (HDMI) now")
    expect(display.written == 0 && lines.written == 0, "nothing written while it runs")
    how = rule.How.follows
}

// The firmware's output's line not judged (its block off) and nothing
// answering on its DDC line, a monitor on the other HDMI output: brought
// there (the study's F, at boot only).
fn bootUnjudged() -> void {
    machineWith("at boot: the firmware's output's line not judged, nothing answers there", 1 << 4, [_]usize{ 0, 0, 0, 1, 0 })
    display.store(0, 0)
    lines.registers[plug.DC_HPD_CONTROL + 5 * plug.HPD_STEP] = 0
    how = rule.How.follows
    boot()
    line("gpu: connector 2 (HDMI): nothing answers on DDC line 0, the card's DDC1: no EDID (a monitor that is off, or none)\n")
    once("gpu: the monitor is on connector 3 (HDMI), the firmware's picture goes out by connector 2 (HDMI), where nothing answers: the picture is brought to the monitor\n")
    expect(decided.act == rule.Act.move && result.outcome == set.Outcome.done && follow.showing == 3, "brought to connector 3")
    // While it runs nothing is moved away from such an output.
    machineWith("while it runs: the showing output's line not judged", 1 << 6, [_]usize{ 0, 0, 1, 0, 0 })
    lines.registers[plug.DC_HPD_CONTROL + 5 * plug.HPD_STEP] = 0
    boot()
    display.forget()
    display.logged = 0
    card.monitor(3, users[0..])
    card.line(3, true, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: a second monitor on connector 3 (HDMI), 3840x1080: it is not driven (one picture, on connector 2 (HDMI))\n")
    expect(display.written == 0 && follow.showing == 2, "nothing moved")
}

// No output of the card started by the firmware: nothing brought up.
fn bootNoneStarted() -> void {
    machineWith("at boot: the firmware started no output of this card", 1 << 4, [_]usize{ 0, 0, 0, 1, 0 })
    display.store(scanout.DIG[4] + scanout.DIG_BE_EN_CNTL, 0x100)
    display.store(0x1B9C, 0)
    how = rule.How.follows
    boot()
    once("gpu: the firmware started no output of this card, so none of its controllers runs a picture: the monitor on connector 3 (HDMI) is not given one (a controller started from nothing takes words from one that runs; this driver does not do that)\n")
    expect(decided.act == rule.Act.none_started && display.written == 0, "nothing written")
}

// ---- WHILE brixOS RUNS.

// Switched off and on (the line low three seconds), to another input and
// back (low 400 ms), and a line that never moves: the same EDID, nothing
// written.
fn offAndOn() -> void {
    bootedOn2("switched off and on, to another input and back")
    display.forget()
    display.logged = 0
    const t0 = display.clock
    card.line(2, false, t0 + 50 * MS)
    card.line(2, true, t0 + 3050 * MS)
    ticks(t0 + 5000 * MS)
    once("gpu: the monitor was unplugged from connector 2 (HDMI): the picture still goes out there, to nothing\n")
    once("gpu: connector 2 (HDMI): the monitor has left and no other connector has one: the output is kept as it is (nothing is taken down)\n")
    once("gpu: something was plugged into connector 2 (HDMI), where the picture goes out\n")
    once("gpu: connector 2 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 2 blocks over DDC line 0, the card's DDC1)\n")
    once("gpu: connector 2 (HDMI): the monitor is back after 3000 ms with its line low; the output sent all along: nothing is written\n")
    expect(display.written == 0 && follow.showing == 2, "nothing written")
    // Another input and back.
    display.logged = 0
    const t1 = display.clock
    card.line(2, false, t1 + 50 * MS)
    card.line(2, true, t1 + 450 * MS)
    ticks(t1 + 2000 * MS)
    once("gpu: connector 2 (HDMI): the monitor is back after 400 ms with its line low; the output sent all along: nothing is written\n")
    expect(display.written == 0, "nothing written")
    // A line that drops for less than two looks: nothing is seen.
    display.logged = 0
    const t2 = display.clock
    card.line(2, false, t2 + 55 * MS)
    card.line(2, true, t2 + 105 * MS)
    ticks(t2 + 2000 * MS)
    expect(display.logged == 0 && display.written == 0, "a short drop is not seen")
}

// Another monitor of the picture's size on the same output, with a timing
// of its own: that timing set while brixOS runs, the picture kept where it
// is, nothing cleared.
fn otherMonitor() -> void {
    bootedOn2("another monitor of the picture's size on the same output")
    const surface = display.registers[0x1A04]
    display.forget()
    display.logged = 0
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(display.clock + 1000 * MS)
    card.monitor(2, other[0..])
    card.line(2, true, card.NEVER)
    ticks(display.clock + 4000 * MS)
    once("gpu: connector 2 (HDMI): another monitor of the picture's size: its own timing is set (")
    once("gpu: plan (the same output, TMDS): HDMI signalling at 266640 kHz (now HDMI at 270270 kHz), the picture of 3840x1080 stays where it is: ")
    line("gpu: setting the output's mode again: carrying out the plan's ")
    once("gpu: the picture goes out by connector 2 (HDMI) again; its memory, size and pitch are as they were\n")
    expect(result.outcome == set.Outcome.done && follow.showing == 2 && follow.clock == 266640 && follow.hTotal == 4000 && follow.vTotal == 1111, "the other monitor's timing set")
    expect(display.cleared == 0 && display.registers[0x1A04] == surface && display.registers[scanout.DIG[4] + scanout.DIG_BE_EN_CNTL] & 1 == 1, "the picture where it was, nothing cleared, the output on")
    // Switched off and on: it is the monitor the timing was set for now.
    display.logged = 0
    card.line(2, false, card.NEVER)
    ticks(display.clock + 1000 * MS)
    card.line(2, true, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: connector 2 (HDMI): the monitor is back after ")
    noLine("its own timing is set")
    // One with the same totals at another clock (50 Hz): its timing is
    // not the one sent, so it is set.
    bootedOn2("another monitor of the picture's size and totals, at 50 Hz")
    display.forget()
    display.logged = 0
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(display.clock + 1000 * MS)
    card.monitor(2, slower[0..])
    card.line(2, true, card.NEVER)
    ticks(display.clock + 4000 * MS)
    once("gpu: connector 2 (HDMI): another monitor of the picture's size: its own timing is set (")
    expect(result.outcome == set.Outcome.done && follow.clock == 225230 && follow.hTotal == 4040, "the 50 Hz timing set")
}

// Nothing plugged in at boot and no EDID passed on by the loader, the
// monitor plugged into the firmware's output later: it is not taken for
// a monitor that came back (the picture was set for none), and as it is
// of another size than the picture, that is said.
fn pluggedAfterBoot() -> void {
    machineWith("nothing at boot, the monitor plugged in later", 0, [_]usize{ 0, 0, 0, 0, 0 })
    how = rule.How.follows
    boot()
    // (The loader passed no EDID on: there was no monitor.)
    rule.begin(&follow, follow.how, &watch.ports, plan.controller, memory.pictureWidth, memory.pictureHeight, users[0..0], 0, 0, 0)
    display.forget()
    display.logged = 0
    card.monitor(2, users[0..])
    card.line(2, true, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: connector 2 (HDMI): the monitor there is 3840x1080, the picture 1280x960: a picture of another size would have to be told to the programs that draw on it, which is not done while brixOS runs; the picture stays where it goes out, and a restart gives the monitor its own mode\n")
    noLine("the output sent all along")
    expect(display.written == 0, "nothing written")
}

// The output stopped sending meanwhile (something took its transmitter
// off): its mode is set again on the same output, the picture kept.
fn lostMeanwhile() -> void {
    bootedOn2("the monitor back, the output not sending any more")
    display.forget()
    display.logged = 0
    const t0 = display.clock
    card.line(2, false, t0 + 50 * MS)
    ticks(t0 + 1000 * MS)
    display.store(scanout.DIG[4] + scanout.DIG_BE_EN_CNTL, 0x100)
    card.line(2, true, t0 + 1050 * MS)
    ticks(t0 + 4000 * MS)
    once("gpu: connector 2 (HDMI): the monitor is back, and the output does not send any more: its mode is set again (")
    // (A plan starts from the output that runs: with its back end off
    // there is none, and that is said; nothing is written.)
    once("gpu: the output's mode is not set again, the picture stays as it is: the encoder the picture goes out by was not found\n")
    once("gpu: once more in 5 s (try 1 of 3)\n")
    expect(display.written == 0, "nothing written")
    // What was said is done: tried once more after 5 s and after 30 s,
    // then left, said once.
    ticks(t0 + 45000 * MS)
    expect(display.count("gpu: connector 2 (HDMI): the monitor is back, and the output does not send any more: its mode is set again (") == 3, "three tries")
    once("gpu: once more in 30 s (try 2 of 3)\n")
    once("gpu: connector 2 (HDMI): the output's mode was not set again in 3 tries: it is left until a line or an EDID changes\n")
    expect(display.written == 0 && follow.tries == 3 && !follow.returning, "nothing written, left")
}

// A move whose way back does not come to its end (a table of the
// controller's that stops on the card, there and back): the output is left
// as that left it until a restart, and nothing is tried again at this
// boot.
fn wayBackLost() -> void {
    bootedOn2("a move whose way back does not come to its end")
    open(35, display.Ending.broken)
    display.forget()
    display.logged = 0
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    expect(result.outcome == set.Outcome.lost && follow.how == rule.How.off, "lost; not followed any more")
    once("gpu: the monitor is not followed any more at this boot: the way back did not end in the state of before (a restart starts from the firmware's picture again)\n")
    noLine("gpu: once more in ")
    ticks(t0 + 45000 * MS)
    expect(display.count("gpu: bringing the picture to the other output: ") == 1, "not tried again")
    open(card.NEVER, display.Ending.plain)
    // The same when the way back comes to its end but a register does not
    // take its value of before again ("astray").
    bootedOn2("a move whose way back leaves a register astray")
    display.forget()
    display.logged = 0
    display.deafRegister = scanout.DIG[5] + scanout.DIG_BE_CNTL
    display.deafAfter = 1
    const t1 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t1 + 45000 * MS)
    expect(result.outcome == set.Outcome.astray && follow.how == rule.How.off, "astray; not followed any more")
    once("gpu: the monitor is not followed any more at this boot: the way back did not end in the state of before (a restart starts from the firmware's picture again)\n")
    noLine("gpu: once more in ")
    display.deafRegister = card.NEVER
}

// A second monitor while the first shows the picture: said, not driven.
fn secondMonitor() -> void {
    bootedOn2("a second monitor")
    display.forget()
    display.logged = 0
    card.monitor(3, small[0..])
    card.line(3, true, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: a second monitor on connector 3 (HDMI), 1920x1080: it is not driven (one picture, on connector 2 (HDMI))\n")
    expect(display.written == 0 && follow.showing == 2, "nothing written")
    // Unplugged and plugged in again: said anew.
    display.logged = 0
    card.unplug(3)
    card.line(3, false, card.NEVER)
    ticks(display.clock + 1000 * MS)
    card.monitor(3, small[0..])
    card.line(3, true, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: a second monitor on connector 3 (HDMI), 1920x1080: it is not driven (one picture, on connector 2 (HDMI))\n")
    // The first one pulled then: the second has another size: said, and
    // the picture stays.
    display.logged = 0
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: connector 3 (HDMI): the monitor there is 1920x1080, the picture 3840x1080: a picture of another size would have to be told to the programs that draw on it, which is not done while brixOS runs; the picture stays where it goes out, and a restart gives the monitor its own mode\n")
    expect(display.written == 0 && follow.showing == 2, "nothing written")
}

// The monitor pulled with none elsewhere, and plugged in again.
fn pulledAndBack() -> void {
    bootedOn2("pulled with none elsewhere, plugged in again")
    display.forget()
    display.logged = 0
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(display.clock + 5000 * MS)
    once("gpu: connector 2 (HDMI): the monitor has left and no other connector has one: the output is kept as it is (nothing is taken down)\n")
    expect(display.written == 0 && display.registers[scanout.DIG[4] + scanout.DIG_BE_EN_CNTL] & 1 == 1, "nothing taken down")
    card.monitor(2, users[0..])
    card.line(2, true, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: connector 2 (HDMI): the monitor is back after ")
    expect(display.written == 0, "nothing written")
    // Another monitor, of another size, on the same output: said, not
    // followed.
    display.logged = 0
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(display.clock + 2000 * MS)
    card.monitor(2, small[0..])
    card.line(2, true, card.NEVER)
    ticks(display.clock + 3000 * MS)
    once("gpu: connector 2 (HDMI): the monitor there is 1920x1080, the picture 3840x1080: a picture of another size would have to be told to the programs that draw on it, which is not done while brixOS runs; the picture stays where it goes out, and a restart gives the monitor its own mode\n")
    expect(display.written == 0, "nothing written")
}

// Monitors on the other HDMI connector and on the DVI one when the
// picture's monitor is pulled: HDMI first.
fn twoElsewhere() -> void {
    bootedOn2("two monitors elsewhere: HDMI first")
    display.forget()
    display.logged = 0
    card.monitor(4, users[0..])
    card.line(4, true, card.NEVER)
    ticks(display.clock + 1500 * MS)
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    once("gpu: the picture goes out by connector 3 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
    expect(follow.showing == 3, "connector 3, not the DVI one")
}

// A monitor that answers only when it is asked the second time (the
// plug item asks once more a second later): nothing is said of it nor
// done meanwhile, and the picture follows it then.
fn askedTwice() -> void {
    bootedOn2("a monitor that answers the second time it is asked")
    display.forget()
    display.logged = 0
    const t0 = display.clock
    card.unplug(2)
    card.line(2, false, card.NEVER)
    ticks(t0 + 300 * MS)
    lines.nackFrom = lines.runs
    lines.nackRuns = 5
    card.monitor(3, users[0..])
    card.line(3, true, card.NEVER)
    ticks(t0 + 1500 * MS)
    expect(follow.showing == 2 && lines.runs - lines.nackFrom >= 5, "the first asking found nothing")
    ticks(t0 + 4000 * MS)
    noLine("gives no EDID that holds")
    once("gpu: the picture goes out by connector 3 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
    lines.nackFrom = card.NEVER
}

// A monitor on the other HDMI connector and one on the DVI connector
// plugged in together as the picture's monitor is pulled: the DVI one's
// EDID takes long to read (the engine stays busy three times): the move
// to the HDMI one waits until no reading is under way (one user of the
// card's display at a time).
fn waitsForReading() -> void {
    bootedOn2("the move waits while another EDID is read")
    display.forget()
    display.logged = 0
    const t0 = display.clock
    const base = lines.runs
    // (Connector 3's reading takes three runs, a look and two blocks; the
    // DVI one's blocks then stay busy three times.)
    lines.busyRuns = @intCast(usize, 0x7) << @intCast(u6, base + 4)
    card.unplug(2)
    card.line(2, false, card.NEVER)
    card.monitor(3, users[0..])
    card.monitor(4, users[0..])
    card.line(3, true, card.NEVER)
    card.line(4, true, card.NEVER)
    ticks(t0 + 1300 * MS)
    expect(watch.reading == 4 && follow.showing == 2 && watch.ports.ports[3].heard.outcome == ddc.Outcome.read, "connector 3 heard, connector 4 being read, nothing moved")
    ticks(t0 + 5000 * MS)
    once("gpu: the picture goes out by connector 3 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
    lines.busyRuns = 0
}

// Something plugged in where nothing answers on the DDC line: not driven.
fn noAnswer() -> void {
    bootedOn2("something that gives no EDID")
    display.forget()
    display.logged = 0
    card.unplug(2)
    card.line(2, false, card.NEVER)
    card.line(3, true, card.NEVER)
    ticks(display.clock + 5000 * MS)
    once("gpu: connector 3 (HDMI): something is plugged in and gives no EDID that holds: it is not driven\n")
    expect(display.written == 0 && follow.showing == 2, "nothing written")
}

// From the HDMI output to the DVI one and back, with a monitor of
// 1920x1080 at 148500 kHz that takes DVI.
fn toDvi() -> void {
    machineWith("from HDMI to DVI and back", 1 << 6, [_]usize{ 0, 0, 2, 0, 0 })
    how = rule.How.follows
    boot()
    expect(result.outcome == set.Outcome.done && follow.width == 1920 && follow.clock == 148500, "the boot set 1920x1080 at 148500 kHz")
    display.forget()
    display.logged = 0
    const t0 = moveCable(2, 4, 300 * MS, small[0..])
    ticks(t0 + 3000 * MS)
    once("gpu: plan (move, TMDS): connector 2 (HDMI, DIG 4, PLL 4) to connector 4 (DVI-D (dual link), DIG 0, front end 0, PLL 0), controller 0 stays: DVI signalling at 148500 kHz (now DVI at 148500 kHz), the picture of 1920x1080 stays where it is: 9 table runs and ")
    once("gpu: the picture goes out by connector 4 (DVI-D (dual link)) now; its memory, size and pitch are as they were: no program is told\n")
    runsFrom(0)
    expect(runsFound == 9 && found[0].w0 == 0x04020700 && found[0].w1 == 0 && found[4].w1 == 0x00021E14 && found[7].w0 == 0x04020F00 && found[8].w0 == 0x04020100, "INIT of UNIPHY A (line 3, DVI-D), PLL 20, front end 0, DVI")
    expect(display.registers[scanout.DIG[0] + scanout.DIG_BE_CNTL] & 0x70070100 == 0x20020100 && display.pll[0] == 148500 && display.pll[4] == 0, "DIG 0: line 3, DVI, front end 0; PLL 0 runs, PLL 4 off")
    display.forget()
    display.logged = 0
    const t1 = moveCable(4, 2, 300 * MS, small[0..])
    ticks(t1 + 3000 * MS)
    once("gpu: the picture goes out by connector 2 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
    runsFrom(0)
    expect(runsFound == 8 && follow.showing == 2 && display.pll[0] == 0 && display.pll[4] == 148500, "back on connector 2 without INIT, PLL 0 powered down")
}

// Under "ask": monitors asked, nothing written, what would be done said.
fn underAsk() -> void {
    machineWith("moved under \"ask\"", 1 << 6, [_]usize{ 0, 0, 1, 0, 0 })
    how = rule.How.says
    boot()
    display.forget()
    display.logged = 0
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    once("gpu: the monitor is on connector 3 (HDMI) now, and nothing is plugged into connector 2 (HDMI): a boot of the monitor's own mode would bring the picture there; this one writes nothing to the display\n")
    expect(display.written == 0 && lines.runs != 0, "asked, nothing written")
    how = rule.How.follows
}

// Each write of the move's plan: the bits it is read back by.
var moveMasks: [256]usize = undefined

// A failure at every write of the move and at every table run: the way
// back to the output of before (the state of before), said; tried again
// 5 s later. `writes` and `runs`: the move's as it went through.
fn failures(writes: usize, runs: usize) -> void {
    var k: usize = 0
    var backs: usize = 0
    var unsure: usize = 0
    while k < writes + runs {
        bootedOn2(if k < writes { "a write of the move does not hold" } else { "a table run of the move is stopped" })
        remember()
        display.forget()
        display.logged = 0
        if k < writes {
            display.spoilAt = k
            display.spoilBit = moveMasks[k] & (~moveMasks[k] + 1)
        } else {
            display.refuseRun = k - writes
        }
        const t0 = moveCable(2, 3, 300 * MS, users[0..])
        ticks(t0 + 2500 * MS)
        expect(result.outcome != set.Outcome.done && result.outcome != set.Outcome.untouched, "the move fails")
        if result.outcome == set.Outcome.back { backs += 1 }
        if result.outcome == set.Outcome.unsure { unsure += 1 }
        expect((result.outcome == set.Outcome.back || result.outcome == set.Outcome.unsure) && asBefore(), "every register as before")
        line("gpu: putting the state of before back")
        once("gpu: back on connector 2 (HDMI), where no monitor is; the monitor on connector 3 (HDMI) is not shown\n")
        once("gpu: once more in 5 s (try 1 of 3)\n")
        expect(follow.showing == 2 && follow.tries == 1, "the record: still connector 2, one try")
        // (Mended, it comes about at the next try.)
        if k == 0 || k == writes {
            display.spoilAt = card.NEVER
            display.refuseRun = card.NEVER
            ticks(display.clock + 6000 * MS)
            once("gpu: the picture goes out by connector 3 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
            expect(follow.showing == 3 && follow.tries == 0, "brought there at the second try")
        }
        k += 1
    }
    expect(backs + unsure == writes + runs, "every failure came back")
}

// A card that fails every move: three tries, then left, said once.
fn givenUp() -> void {
    bootedOn2("a move given up")
    display.forget()
    display.logged = 0
    display.clockDeafFrom = display.clockRuns
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    expect(follow.tries == 1, "one try, and not at once again")
    // (The second 5 s after the first, the third 30 s after the second.)
    ticks(t0 + 20000 * MS)
    expect(follow.tries == 2, "the second try, and the third not yet")
    ticks(t0 + 50000 * MS)
    once("gpu: once more in 5 s (try 1 of 3)\n")
    once("gpu: once more in 30 s (try 2 of 3)\n")
    once("gpu: connector 3 (HDMI): the picture was not brought there in 3 tries: it is left until a line or an EDID changes\n")
    // (The first try's way back left PLL 4 without its clock: the next two
    // plans find no frames to hold a change against and are not carried
    // out; each counts as a try.)
    expect(display.count("gpu: the monitor is on connector 3 (HDMI) now, and nothing is plugged into connector 2 (HDMI): the picture is brought there") == 3 && display.count("gpu: bringing the picture to the other output: ") == 1 && follow.tries == 3 && follow.showing == 2, "three tries")
    // A line that changes lets it be tried again.
    display.clockDeafFrom = card.NEVER
    display.logged = 0
    card.line(4, true, card.NEVER)
    ticks(display.clock + 1000 * MS)
    expect(follow.tries != 3, "tried again after a line changed")
}

// The transmitter's "init" disturbs the output that shows the picture:
// the old output found off after it, or the controller counting no
// frames after it. The change ends there, before anything is taken down,
// and the state of before comes back.
fn initDisturbs() -> void {
    var which: usize = 0
    while which < 3 {
        bootedOn2(if which == 0 { "the init takes the running output off" } else if which == 1 { "the controller stands after the init" } else { "the controller counts other frames after the init" })
        remember()
        display.forget()
        display.logged = 0
        if which == 0 {
            display.heldRegister = scanout.DIG[4] + scanout.DIG_BE_EN_CNTL
            display.heldMask = 1
            display.heldValue = 0
            display.heldFrom = 1
            display.heldUntil = 2
        } else if which == 1 {
            // (From the init's run until the next table's.)
            display.freezeRegister = display.MAIL
            display.freezeValue = 0x04020705
        } else {
            display.initSlows = 4
        }
        const t0 = moveCable(2, 3, 300 * MS, users[0..])
        ticks(t0 + 2500 * MS)
        expect((result.outcome == set.Outcome.back || result.outcome == set.Outcome.unsure) && asBefore() && follow.showing == 2, "the state of before")
        expect(result.step <= plan.move.initAt + 4, "it ended at the checks after the init")
        line(if which == 0 { "look for 4e48 & 00000001 = 00000001 (the output that shows the picture is still on), read 00000100\n" } else if which == 1 { "gpu: controller 0 counts no frames any more after the new output's transmitter was made ready\n" } else { " frames a second after the new output's transmitter was made ready, which is not the rate of before\n" })
        once("gpu: back on connector 2 (HDMI), where no monitor is; the monitor on connector 3 (HDMI) is not shown\n")
        which += 1
    }
}

// The transmitter's table as the user's ROM has it: for the action "init"
// it ends at once and does nothing to the card (tools/check_atom_
// reference.sh with that ROM, both interpreters: no register read or
// written, for every transmitter). The move goes on all the same, at boot
// and while brixOS runs; the checks after the "init" are what judge it.
fn initIdle() -> void {
    open(76, display.Ending.init_idle)
    bootedOn2("the transmitter's init does nothing, as on the user's ROM")
    display.forget()
    display.logged = 0
    const t0 = moveCable(2, 3, 300 * MS, users[0..])
    ticks(t0 + 3000 * MS)
    line("gpu: table UNIPHYTransmitterControl (the new output's transmitter made ready) ran to its end: ")
    line(" 0 reads, 0 writes (0 registers not written before), 0 us waited\n")
    once("gpu: the picture goes out by connector 3 (HDMI) now; its memory, size and pitch are as they were: no program is told\n")
    expect(result.outcome == set.Outcome.done && follow.showing == 3 && follow.ready[5] && follow.tries == 0, "brought to connector 3 at the first try")
    // (The init's run writes nothing: the eight others are the move's.)
    runsFrom(0)
    sameRuns("the move's table runs but the init", MOVE_RUNS[3..])
    machineWith("at boot: the monitor on the other HDMI output, the init doing nothing", 1 << 4, [_]usize{ 0, 0, 0, 1, 0 })
    how = rule.How.follows
    boot()
    expect(decided.act == rule.Act.move && result.outcome == set.Outcome.done && follow.showing == 3 && follow.ready[5], "brought to connector 3 at boot")
    open(card.NEVER, display.Ending.plain)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    name = "the ROM"
    makeEdids()
    card.reset()
    open(card.NEVER, display.Ending.plain)
    lend()
    expect(board.found && board.count == 5 && board.connectors[3].hotPlugLine == 4 && board.connectors[3].transmitter == 5 && board.connectors[3].fastHdmi, "the user's connectors")
    bootThere()
    bootOn3()
    bootNone()
    bootDisplayPort()
    bootQuiet()
    bootUnjudged()
    bootUnjudgedThere()
    bootNoneStarted()
    movedTo3()
    const writes = result.writes
    const runs = result.runs
    var k: usize = 0
    var w: usize = 0
    while k < plan.count && w < 256 {
        if plan.steps[k].kind == mode.Kind.write {
            moveMasks[w] = plan.steps[k].mask
            w += 1
        }
        k += 1
    }
    expect(writes == 67 && runs == 9, "the move: 67 writes and 9 table runs")
    movedBack()
    offAndOn()
    otherMonitor()
    pluggedAfterBoot()
    lostMeanwhile()
    secondMonitor()
    pulledAndBack()
    twoElsewhere()
    askedTwice()
    waitsForReading()
    noAnswer()
    displayPortWhileRunning()
    toDvi()
    underAsk()
    givenUp()
    initDisturbs()
    initIdle()
    wayBackLost()
    failures(writes, runs)
    if failed != 0 { return failed }
    return 13
}
