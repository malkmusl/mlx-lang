// A local of several words (a slice, an optional slice) whose address is
// taken: a store through that address changes what the local reads back,
// every word of it (the length too), whether the store happens in another
// function, through a local pointer, or into an optional. Exits 13 when
// every check holds, else the number of the first check that failed.
const std = @import("std")

fn store(into: *[]const u8, text: []const u8) -> void { into.* = text }

fn storeOptional(into: *?[]const u8, text: []const u8) -> void { into.* = text }

fn clear(into: *?[]const u8) -> void { into.* = null }

fn lengthOf(text: []const u8) -> usize { return text.length }

fn storeTail(into: *[]const u8) -> void { into.* = into.*[2..into.*.length] }

pub fn main() -> u8 {
    var value: []const u8 = "initial"
    store(&value, "seven77")
    if value.length != 7 || value[0] != 115 || lengthOf(value) != 7 { return 1 }
    // Through a pointer held in a local.
    var local: []const u8 = "abc"
    const pointer: *[]const u8 = &local
    pointer.* = "twelve-chars"
    if local.length != 12 || local[0] != 116 { return 2 }
    // The callee reads the old words through the pointer too.
    storeTail(&local)
    if local.length != 10 || local[0] != 101 { return 3 }
    // An optional slice: set, then null again.
    var maybe: ?[]const u8 = null
    storeOptional(&maybe, "four")
    if maybe == null || maybe.?.length != 4 { return 4 }
    clear(&maybe)
    if maybe != null { return 5 }
    // A parameter whose address is taken.
    if !parameterCase("parameter9") { return 6 }
    // A loop that stores through the address each round.
    var text: []const u8 = ""
    var round: usize = 0
    while round < 3 {
        store(&text, if round == 2 { "third" } else { "x" })
        round += 1
    }
    if text.length != 5 { return 7 }
    return 13
}

fn parameterCase(text: []const u8) -> bool {
    var copy = text
    store(&copy, "pp")
    return copy.length == 2 && text.length == 10
}
