// Statements that failed their function with only "semantic analysis
// failed in function", each said at its place: a deferred expression that
// does not type, an `errdefer` where no error union is returned, a name
// declared twice in one scope, `break` outside a loop and a match pattern
// that does not fit.
const Shade = enum(u8) { light, dark }

fn noop(value: u8) -> void { }

fn pick(shade: Shade) -> u8 {
    match shade {
        Shade.light => { return 1 }
        Shade.blue => { return 2 }
        else => { return 3 }
    }
}

pub fn main() -> u8 {
    defer noop(missing_value)
    errdefer noop(1)
    const value: u8 = 1
    const value: u8 = 2
    break
    return value + pick(Shade.dark)
}
