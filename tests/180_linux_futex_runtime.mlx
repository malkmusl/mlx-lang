const thread = @import("../std/bootstrap/os/linux/thread.mlx")

pub fn main() -> u8 {
    if thread.getTid() <= 0 { return 1 }
    if thread.yield() != 0 { return 2 }

    var value: u32 = 7
    const mismatch = thread.futexWait(&value, 8, 0, true)
    if mismatch != -11 { return 3 }
    if thread.futexWake(&value, 1, true) != 0 { return 4 }
    return 13
}
