// std.fs.entries: reading tests/support/import_cycle (lib.mlx, part.mlx,
// user.mlx) with a buffer too small for all its records at once finds
// ".", ".." (isDotName, directories) and the three files (regular files,
// nonzero inodes), each once. Exits 13.
const std = @import("std")

fn named(name: std.string.String, expected: []const u8) -> bool {
    return std.string.eql(name, std.string.fromSlice(expected))
}

fn openDirectory() -> std.fs.File {
    const path = "tests/support/import_cycle\0"
    unsafe { return std.fs.open(@ptrCast([*]const u8, path), std.fs.READ_ONLY | std.fs.DIRECTORY, 0) }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const directory = openDirectory()
    if !std.fs.isValid(directory) { return 1 }
    // Room for about two records: the reader reads again as it goes.
    var buffer: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var reader = std.fs.entries(directory, bytes, 64)
    var entry: std.fs.Entry = undefined
    var dots: usize = 0
    var seen: [3]usize = [3]usize{ 0, 0, 0 }
    while std.fs.nextEntry(&reader, &entry) {
        if std.fs.isDotName(entry.name) {
            if entry.kind != std.fs.ENTRY_DIRECTORY { return 2 }
            dots += 1
            continue
        }
        if entry.kind != std.fs.ENTRY_FILE || entry.inode == 0 { return 3 }
        if named(entry.name, "lib.mlx") {
            seen[0] += 1
        } else if named(entry.name, "part.mlx") {
            seen[1] += 1
        } else if named(entry.name, "user.mlx") {
            seen[2] += 1
        } else {
            return 4
        }
    }
    const closed = std.fs.close(directory)
    if reader.failed { return 5 }
    if dots != 2 { return 6 }
    if seen[0] != 1 || seen[1] != 1 || seen[2] != 1 { return 7 }
    // A buffer too small for any record fails instead of looping.
    const again = openDirectory()
    var tiny = std.fs.entries(again, bytes, 8)
    if std.fs.nextEntry(&tiny, &entry) || !tiny.failed { return 8 }
    const closed_again = std.fs.close(again)
    return 13
}
