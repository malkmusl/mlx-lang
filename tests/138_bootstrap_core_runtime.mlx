const bootstrap = @import("../std/bootstrap/root.zin")

pub fn main() -> u8 {
    const allocator = bootstrap.page_allocator.init()

    var list = bootstrap.array_list.init(allocator, 1)
    list = bootstrap.array_list.appendSlice(list, "abc")
    list = bootstrap.array_list.resize(list, 5, 120)
    if list.capacity < 5 || list.length != 5 || bootstrap.array_list.last(list) != 120 {
        return 1
    }
    list = bootstrap.array_list.pop(list)
    if list.length != 4 { return 2 }

    var bytes: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    unsafe {
        const pointer = @ptrCast([*]u8, bytes[0..8])
        bootstrap.mem.writeU64Little(pointer, 0, 72623859790382856)
        if bootstrap.mem.readU64Little(@ptrCast([*]const u8, bytes[0..8]), 0) != 72623859790382856 {
            return 3
        }
    }

    const word = bootstrap.string.fromSlice("bootstrap")
    const suffix = bootstrap.string.fromSlice("strap")
    const piece = bootstrap.string.slice(word, 4, 9)
    if piece.length != 5 { return 6 }
    if piece.pointer[0] != 115 { return 7 }
    if !bootstrap.string.endsWith(word, suffix) || !bootstrap.string.eql(piece, suffix) {
        return 4
    }

    var map = bootstrap.hash_map.init(allocator, 8)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("a"), 1)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("b"), 2)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("c"), 3)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("d"), 4)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("e"), 5)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("f"), 6)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("g"), 7)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("h"), 8)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("i"), 9)
    map = bootstrap.hash_map.put(map, bootstrap.string.fromSlice("j"), 10)
    const found = bootstrap.hash_map.get(map, bootstrap.string.fromSlice("j"))
    if map.capacity < 32 || map.length != 10 || !found.0 || found.1 != 10 {
        return 5
    }

    bootstrap.hash_map.deinit(map)
    bootstrap.array_list.deinit(list)
    return 13
}
