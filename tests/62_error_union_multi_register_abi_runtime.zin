// Tests error-union ABI transport for a two-element aggregate returned in multiple registers; sum is 13.
fn source() ![2]u64 {
    return [_]u64{6, 7}
}

fn forward() ![2]u64 {
    return source()
}

pub fn main() !void {
    const values = try forward()
    var sum: u8 = 0
    for value in values {
        sum = sum + value
    }
    while sum != 13 {}
}
