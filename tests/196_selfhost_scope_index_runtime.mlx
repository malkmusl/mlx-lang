const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const symbols = @import("../compiler/selfhost/symbols.mlx")

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()
    var root = symbols.initRootScope(allocator, 2)
    const names = "abcdefghijklmnopqrst"
    var index: usize = 0
    while index < 20 {
        var pointer: [*]const u8 = undefined
        unsafe { pointer = @ptrFromInt([*]const u8, @intFromPtr(names) + index) }
        if !symbols.define(&root, pointer, 1, index + 10) { return 1 }
        index += 1
    }
    index = 0
    while index < 20 {
        var pointer: [*]const u8 = undefined
        unsafe { pointer = @ptrFromInt([*]const u8, @intFromPtr(names) + index) }
        const found = symbols.lookup(&root, pointer, 1)
        if !found.0 || found.1 != index + 10 { return 2 }
        index += 1
    }
    var child = symbols.initChildScope(allocator, &root, 2)
    var inherited_pointer: [*]const u8 = undefined
    unsafe { inherited_pointer = @ptrFromInt([*]const u8, @intFromPtr(names) + 12) }
    const inherited = symbols.lookup(&child, inherited_pointer, 1)
    if !inherited.0 || inherited.1 != 22 { return 3 }
    symbols.deinitScope(&child)
    symbols.deinitScope(&root)
    return 13
}
