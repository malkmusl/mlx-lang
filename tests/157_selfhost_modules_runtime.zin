const modules = @import("../compiler/selfhost/modules.zin")
const types = @import("../compiler/selfhost/types.zin")
const symbols = @import("../compiler/selfhost/symbols.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

const OwnedPath = modules.OwnedPath

fn same(path: OwnedPath, expected: []const u8) -> bool {
    var length: usize = 0
    for byte in expected { length += 1 }
    if path.length != length { return false }
    var index: usize = 0
    while index < length {
        if path.pointer[index] != expected[index] { return false }
        index += 1
    }
    return true
}

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    unsafe {
        if modules.classify(@ptrCast([*]const u8, "./child.zin"), 11) != modules.ImportKind.relative { return 1 }
        if modules.classify(@ptrCast([*]const u8, "std.mem"), 7) != modules.ImportKind.standard { return 2 }
        if modules.classify(@ptrCast([*]const u8, "builtin"), 7) != modules.ImportKind.builtin { return 3 }
        if modules.classify(@ptrCast([*]const u8, "example"), 7) != modules.ImportKind.package { return 4 }

        const normalized = modules.normalize(allocator, @ptrCast([*]const u8, "work/./compiler/../main.zin"), 27)
        if !normalized.valid || !same(normalized, "work/main.zin") { return 5 }
        modules.deinitPath(normalized)
        const relative = modules.resolveRelative(allocator, @ptrCast([*]const u8, "work/compiler/main.zin"), 22, @ptrCast([*]const u8, "../shared.zin"), 13)
        if !relative.valid || !same(relative, "work/shared.zin") { return 6 }
        modules.deinitPath(relative)
        const standard = modules.resolveStandard(allocator, @ptrCast([*]const u8, "std/src"), 7, @ptrCast([*]const u8, "std.mem.Allocator"), 17)
        if !standard.valid || !same(standard, "std/src/mem/Allocator.zin") { return 7 }
        modules.deinitPath(standard)
        const parents = modules.normalize(allocator, @ptrCast([*]const u8, "../../shared.zin"), 16)
        if !parents.valid || !same(parents, "../../shared.zin") { return 20 }
        modules.deinitPath(parents)
    }

    unsafe {
        const package_map = modules.initPackages(allocator, 2)
        if !modules.putPackage(package_map, @ptrCast([*]const u8, "example"), 7, @ptrCast([*]const u8, "tests/modules/157_package.zin"), 29) { return 21 }
        const loader = modules.initLoader(allocator, @ptrCast([*]const u8, "tests/modules/157_std"), 21, package_map)
        if modules.moduleCount(loader) != 0 { return 16 }
        const root = modules.loadRoot(loader, @ptrCast([*]const u8, "tests/modules/157_root.zin"), 26)
        if root == modules.NONE { return 8 }
        if modules.moduleCount(loader) == 1 && modules.moduleAt(loader, root).*.state == modules.State.failed { return 18 }
        if modules.moduleCount(loader) == 1 { return 19 }
        if modules.totalErrors(loader) != 0 { return 17 }
        if modules.moduleCount(loader) != 7 || modules.importCount(loader) != 8 { return 9 }
        var type_store = types.init(allocator)
        var symbol_store = symbols.initStore(allocator, 32)
        if modules.prepare(loader, &type_store, &symbol_store) != 0 { return 10 }
        if modules.analyzeDeclarations(loader, &type_store, &symbol_store) != 0 { return 11 }
        if modules.analyzeFunctionBodies(loader, &type_store, &symbol_store) != 0 { return 12 }
        const import_symbol = symbols.symbolAt(&symbol_store, modules.moduleAt(loader, root).*.symbolStart)
        if types.get(&type_store, import_symbol.*.typeId).*.kind != types.Kind.module { return 14 }
        symbols.deinitStore(&symbol_store)
        types.deinit(&type_store)
        modules.deinitLoader(loader)
        modules.deinitPackages(package_map)
        return 13
    }
    return 15
}
