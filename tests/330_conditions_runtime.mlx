// Conditions: chains of `x == A || x == B || ...` give the same answers
// as the comparisons one by one (values below 64, between 64 and 127 and
// above, narrow integers, enum members, a field and a value behind a
// pointer, and chains that do not qualify: too short, two subjects, a
// signed value), and `&&`, `||` and `!` in `if` and `while` evaluate their
// right side only when it decides, left to right. Exits 13.
const Color = enum(u8) {
    c0, c1, c2, c3, c4, c5, c6, c7, c8, c9,
    c10, c11, c12, c13, c14, c15, c16, c17, c18, c19,
    c20, c21, c22, c23, c24, c25, c26, c27, c28, c29,
    c30, c31, c32, c33, c34, c35, c36, c37, c38, c39,
    c40, c41, c42, c43, c44, c45, c46, c47, c48, c49,
    c50, c51, c52, c53, c54, c55, c56, c57, c58, c59,
    c60, c61, c62, c63, c64, c65, c66, c67, c68, c69,
    c70, c71
}

const Holder = struct { color: Color, code: u16 }

fn warm(color: Color) -> bool {
    return color == Color.c1 || color == Color.c3 || color == Color.c63 || color == Color.c64 || color == Color.c70
}

fn digits(code: u16) -> bool { return code == 48 || code == 49 || code == 50 || code == 127 }

fn big(code: u64) -> bool { return code == 3 || code == 5 || code == 7 }

fn signed(value: i32) -> bool { return value == 1 || value == 2 || value == 3 }

fn short(code: u16) -> bool { return code == 1 || code == 2 }

fn mixed(a: u16, b: u16) -> bool { return a == 1 || b == 2 || a == 3 }

var calls: u64 = 0
var order: u64 = 0

// Records that it ran (and in which order) and answers `value`.
fn touch(value: bool, mark: u64) -> bool {
    calls += 1
    order = order * 10 + mark
    return value
}

fn field(holder: *Holder) -> bool { return holder.*.color == Color.c2 || holder.*.color == Color.c65 || holder.*.color == Color.c71 }

pub fn main() -> u8 {
    var hits: u64 = 0
    var index: u8 = 0
    while index < 72 {
        const color = @enumFromInt(Color, index)
        if warm(color) { hits += @intCast(u64, index) }
        index += 1
    }
    // 1 + 3 + 63 + 64 + 70
    if hits != 201 { return 1 }
    var code: u16 = 0
    var count: u64 = 0
    while code < 300 {
        if digits(code) { count += 1 }
        code += 1
    }
    if count != 4 { return 2 }
    if !big(5) || big(64 + 5) || big(128 + 3) || big(18446744073709551615) { return 3 }
    if !signed(2) || signed(-1) || signed(0) { return 4 }
    if !short(2) || short(3) { return 5 }
    if !mixed(5, 2) || mixed(5, 3) || !mixed(3, 0) { return 6 }
    var holder = Holder.{ .color = Color.c65, .code = 0 }
    if !field(&holder) { return 7 }
    holder.color = Color.c64
    if field(&holder) { return 8 }
    holder.color = Color.c71
    if !field(&holder) { return 9 }
    calls = 0
    if touch(false, 1) && touch(true, 2) { return 20 }
    if calls != 1 { return 21 }
    if !(touch(true, 3) || touch(false, 4)) { return 22 }
    if calls != 2 { return 23 }
    order = 0
    if touch(false, 1) || touch(true, 2) && touch(true, 3) {} else { return 24 }
    if order != 123 { return 25 }
    order = 0
    if (touch(false, 1) || touch(false, 2)) && touch(true, 3) { return 26 }
    if order != 12 { return 27 }
    if !(!touch(true, 5) && touch(true, 6)) {} else { return 28 }
    // A loop that stops on either side of an `&&` or an `||`.
    var steps: u64 = 0
    var at: u64 = 0
    while at < 20 && !(at == 7 || at == 9 || at == 11) {
        steps += 1
        at += 1
    }
    if steps != 7 { return 29 }
    // The same conditions as values.
    const both = touch(true, 1) && touch(false, 2)
    const either = touch(false, 1) || touch(true, 2)
    if both || !either { return 30 }
    return 13
}
