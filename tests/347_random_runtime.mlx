// std.random: xoshiro256** from the state 1, 2, 3, 4 gives what the
// authors' reference code gives (11520, 0, 1509978240,
// 1215971899390074240); splitmix64 from 0 gives its reference numbers;
// xorshift64* from the splash's seed its sequence; below stays below its
// bound and reaches every value; unit stays in [0, 1); and the kernel's
// bytes come (two 16-byte draws that differ). Exits 13 when every check
// holds, else the number of the first check that failed.
const random = @import("std.random")

pub fn main() -> u8 {
    var generator = random.Xoshiro256.{ .s = [4]u64{ 1, 2, 3, 4 } }
    if random.next(&generator) != 11520 { return 1 }
    if random.next(&generator) != 0 { return 2 }
    if random.next(&generator) != 1509978240 { return 3 }
    if random.next(&generator) != 1215971899390074240 { return 4 }

    var state: u64 = 0
    if random.splitmix64(&state) != 16294208416658607535 { return 5 }
    if random.splitmix64(&state) != 7960286522194355700 { return 6 }
    if random.splitmix64(&state) != 487617019471545679 { return 7 }

    var stars = random.Xorshift64Star.{ .state = 9112539781371292431 }
    if random.xorshift64StarNext(&stars) != 4184193960396669041 { return 8 }
    if random.xorshift64StarNext(&stars) != 11590094870521835125 { return 9 }
    if random.xorshift64StarNext(&stars) != 13870651151832892582 { return 10 }

    // The same seed, the same numbers.
    var first: random.Xoshiro256 = undefined
    var second: random.Xoshiro256 = undefined
    random.seed(&first, 42)
    random.seed(&second, 42)
    var index: usize = 0
    while index < 100 {
        if random.next(&first) != random.next(&second) { return 11 }
        index += 1
    }

    // below(6): only 0 to 5, each of them seen.
    var seen: [6]bool = [6]bool{ false, false, false, false, false, false }
    index = 0
    while index < 600 {
        const roll = random.below(&first, 6)
        if roll >= 6 { return 12 }
        seen[@intCast(usize, roll)] = true
        index += 1
    }
    for hit in seen {
        if !hit { return 14 }
    }
    // A bound of 1 is always 0; one past 2^63 still in range.
    if random.below(&first, 1) != 0 { return 15 }
    if random.below(&first, 9223372036854775809) >= 9223372036854775809 { return 16 }

    index = 0
    while index < 1000 {
        const value = random.unit(&first)
        if value < 0.0 || value >= 1.0 { return 17 }
        const star = random.xorshift64StarUnit(&stars)
        if star < 0.0 || star >= 1.0 { return 18 }
        index += 1
    }

    var a: [16]u8 = undefined
    var b: [16]u8 = undefined
    if !random.fill(&a, 16) || !random.fill(&b, 16) { return 19 }
    var same = true
    index = 0
    while index < 16 {
        if a[index] != b[index] { same = false }
        index += 1
    }
    if same { return 20 }
    if random.random64() == random.random64() { return 21 }
    return 13
}
