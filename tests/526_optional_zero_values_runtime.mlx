// An optional holding its payload's zero is not null, whatever the
// payload: `?u8` 0, `?i64` 0, `?bool` false, `?f32` 0.0, `?f64` 0.0 and
// -0.0, a struct whose fields are all zero, a `[]const u8` of length 0;
// and an absent one is null. For each of them, present and absent, `==
// null`, `!= null`, `if x != null` and `.?` (the payload's bits: -0.0
// keeps its sign) through a returned value, a parameter (and passed
// back), an inline function's result, a local assigned, the value of an
// `if` and of a `match`, a pointer to the local and a callee storing
// through one, a struct's field (also through a pointer to the struct),
// an array's elements (the array passed by value) and a generic
// function's `?T`. What was wrong:
// - an optional float was its payload alone, null being the word 0, so
//   `fn give() -> ?f64 { return 0.0 }` compared equal to null; it is
//   tagged now as the integers are (tests/404_optional_zero_runtime.mlx):
//   the payload and then a tag, a word after it in registers and the byte
//   after its bytes in memory (`@sizeOf(?f64)` is 9; a present 0.0 is
//   eight zero bytes and a 1; zeroed memory is null);
// - an inline function's `return 0` as a `?u8` was not made one: the
//   caller read a tag word it did not have;
// - `if c { value } else { maybe }` was typed as its first branch, `T`:
//   the `?T`'s tag was dropped and its null read as present (a `match`
//   too, whose arms were not made optionals either);
// - a local `?u8` whose address is taken kept its tag 8 bytes after the
//   payload, a store through the pointer the byte after it; and `&local`
//   of an optional struct was the slot holding its address (`at.*` read
//   past it, `at.* = null` overwrote the frame);
// - `null` passed for a generic `?T` after `T` took `T`'s place in the
//   instance's parameter types and was passed as one word.
// Module-level optionals given a float or a struct are tests/489's.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const SIGN: u64 = 9223372036854775808

const Zero = struct {
    count: u32
    ratio: f64
    on: bool
}

// One field of each (a `?f32` takes 5 bytes, a `?f64` 9: the fields after
// them sit where those sizes put them).
const Holder = struct {
    byte: ?u8
    long: ?i64
    flag: ?bool
    single: ?f32
    double: ?f64
    negative: ?f64
    zero: ?Zero
    text: ?[]const u8
}

fn zeroHolder() -> Holder {
    return Holder.{ .byte = 0, .long = 0, .flag = false, .single = 0.0, .double = 0.0, .negative = -0.0, .zero = Zero.{ .count = 0, .ratio = 0.0, .on = false }, .text = "" }
}

fn emptyHolder() -> Holder {
    return Holder.{ .byte = null, .long = null, .flag = null, .single = null, .double = null, .negative = null, .zero = null, .text = null }
}

fn which(seen: bool) -> u8 {
    if seen { return 1 }
    return 0
}

// The report: an optional float holding zero compared equal to null.
fn give() -> ?f64 { return 0.0 }

// `?u8` holding 0.
fn byteOf(present: bool) -> ?u8 {
    if present { return 0 }
    return null
}

fn byteThrough(value: ?u8) -> ?u8 { return value }

fn byteAbsent(value: ?u8) -> bool { return value == null }

inline fn byteInlineZero() -> ?u8 { return 0 }

inline fn byteInlineNone() -> ?u8 { return null }

fn bytePut(place: *?u8, present: bool) -> void {
    if present {
        place.* = 0
    } else {
        place.* = null
    }
}

fn byteCount(values: [3]?u8) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < 3 {
        if values[index] != null { count += 1 }
        index += 1
    }
    return count
}

fn bytes() -> u8 {
    // Returned.
    const present = byteOf(true)
    if present == null { return 20 }
    if present != null && !(present.? == 0) { return 21 }
    if byteOf(false) != null { return 22 }
    // Passed, and passed back.
    if byteAbsent(0) || !byteAbsent(null) { return 23 }
    const through = byteThrough(0)
    if through == null || !(through.? == 0) || byteThrough(null) != null { return 24 }
    // From an inline function.
    const inlined = byteInlineZero()
    if inlined == null || !(inlined.? == 0) || byteInlineNone() != null { return 25 }
    // A local, assigned, and as the value of an if.
    var local: ?u8 = 0
    if local == null { return 26 }
    local = null
    if local != null { return 27 }
    local = 0
    var seen = false
    if local != null { seen = local.? == 0 }
    if !seen { return 28 }
    const bare: u8 = 0
    const nothing: ?u8 = null
    const chosen: ?u8 = if seen { bare } else { nothing }
    const missing: ?u8 = if !seen { bare } else { nothing }
    if chosen == null || !(chosen.? == 0) || missing != null { return 29 }
    // As the value of a match (an arm of `T` first, or of `?T`).
    const matched: ?u8 = match which(seen) { 1 => bare, else => nothing }
    const unmatched: ?u8 = match which(seen) { 0 => bare, else => nothing }
    const later: ?u8 = match which(seen) { 0 => nothing, else => bare }
    if matched == null || !(matched.? == 0) || unmatched != null || later == null || !(later.? == 0) { return 30 }
    // Through a pointer, and set by a callee.
    const at = &local
    at.* = null
    if at.* != null || local != null { return 31 }
    bytePut(&local, true)
    if at.* == null || !(at.*.? == 0) { return 32 }
    at.* = 7
    if local == null || !(local.? == 7) { return 33 }
    // Fields, of a struct value and through a pointer to it.
    var holder = zeroHolder()
    if holder.byte == null || !(holder.byte.? == 0) { return 34 }
    if emptyHolder().byte != null { return 35 }
    const holder_at = &holder
    holder_at.*.byte = null
    if holder.byte != null { return 36 }
    holder_at.*.byte = 0
    if holder_at.*.byte == null || !(holder_at.*.byte.? == 0) { return 37 }
    bytePut(&holder.byte, false)
    if holder.byte != null { return 38 }
    // Array elements, the array passed by value.
    var values = [3]?u8{ 0, null, 0 }
    if values[0] == null || values[1] != null || !(values[2].? == 0) { return 39 }
    if byteCount(values) != 2 { return 40 }
    values[1] = 0
    if values[1] == null || byteCount(values) != 3 { return 41 }
    bytePut(&values[0], false)
    if values[0] != null || values[1] == null || byteCount(values) != 2 { return 42 }
    return 0
}

