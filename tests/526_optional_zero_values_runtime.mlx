    if holder.negative != null { return 161 }
    holder_at.*.negative = -0.0
    if holder_at.*.negative == null || !(@bitCast(u64, holder_at.*.negative.?) == SIGN) { return 162 }
    negativePut(&holder.negative, false)
    if holder.negative != null { return 163 }
    // Array elements, the array passed by value.
    var values = [3]?f64{ -0.0, null, -0.0 }
    if values[0] == null || values[1] != null || !(@bitCast(u64, values[2].?) == SIGN) { return 164 }
    if negativeCount(values) != 2 { return 165 }
    values[1] = -0.0
    if values[1] == null || negativeCount(values) != 3 { return 166 }
    negativePut(&values[0], false)
    if values[0] != null || values[1] == null || negativeCount(values) != 2 { return 167 }
    return 0
}

// `?Zero`, a struct whose fields are all zero.
fn zeroOf(present: bool) -> ?Zero {
    if present { return Zero.{ .count = 0, .ratio = 0.0, .on = false } }
    return null
}

fn zeroThrough(value: ?Zero) -> ?Zero { return value }

fn zeroAbsent(value: ?Zero) -> bool { return value == null }

inline fn zeroInlineZero() -> ?Zero { return Zero.{ .count = 0, .ratio = 0.0, .on = false } }

inline fn zeroInlineNone() -> ?Zero { return null }

fn zeroPut(place: *?Zero, present: bool) -> void {
    if present {
        place.* = Zero.{ .count = 0, .ratio = 0.0, .on = false }
    } else {
        place.* = null
    }
}

fn zeroCount(values: [3]?Zero) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < 3 {
        if values[index] != null { count += 1 }
        index += 1
    }
    return count
}

fn zeros() -> u8 {
    // Returned.
    const present = zeroOf(true)
    if present == null { return 170 }
    if present != null && !(present.?.count == 0 && @bitCast(u64, present.?.ratio) == 0 && !present.?.on) { return 171 }
    if zeroOf(false) != null { return 172 }
    // Passed, and passed back.
    if zeroAbsent(Zero.{ .count = 0, .ratio = 0.0, .on = false }) || !zeroAbsent(null) { return 173 }
    const through = zeroThrough(Zero.{ .count = 0, .ratio = 0.0, .on = false })
    if through == null || !(through.?.count == 0 && @bitCast(u64, through.?.ratio) == 0 && !through.?.on) || zeroThrough(null) != null { return 174 }
    // From an inline function.
    const inlined = zeroInlineZero()
    if inlined == null || !(inlined.?.count == 0 && @bitCast(u64, inlined.?.ratio) == 0 && !inlined.?.on) || zeroInlineNone() != null { return 175 }
    // A local, assigned, and as the value of an if.
    var local: ?Zero = Zero.{ .count = 0, .ratio = 0.0, .on = false }
    if local == null { return 176 }
    local = null
    if local != null { return 177 }
    local = Zero.{ .count = 0, .ratio = 0.0, .on = false }
    var seen = false
    if local != null { seen = local.?.count == 0 && @bitCast(u64, local.?.ratio) == 0 && !local.?.on }
    if !seen { return 178 }
    const bare: Zero = Zero.{ .count = 0, .ratio = 0.0, .on = false }
    const nothing: ?Zero = null
    const chosen: ?Zero = if seen { bare } else { nothing }
    const missing: ?Zero = if !seen { bare } else { nothing }
    if chosen == null || !(chosen.?.count == 0 && @bitCast(u64, chosen.?.ratio) == 0 && !chosen.?.on) || missing != null { return 179 }
    // As the value of a match (an arm of `T` first, or of `?T`).
    const matched: ?Zero = match which(seen) { 1 => bare, else => nothing }
    const unmatched: ?Zero = match which(seen) { 0 => bare, else => nothing }
    const later: ?Zero = match which(seen) { 0 => nothing, else => bare }
    if matched == null || !(matched.?.count == 0 && @bitCast(u64, matched.?.ratio) == 0 && !matched.?.on) || unmatched != null || later == null || !(later.?.count == 0 && @bitCast(u64, later.?.ratio) == 0 && !later.?.on) { return 180 }
    // Through a pointer, and set by a callee.
    const at = &local
    at.* = null
    if at.* != null || local != null { return 181 }
    zeroPut(&local, true)
    if at.* == null || !(at.*.?.count == 0 && @bitCast(u64, at.*.?.ratio) == 0 && !at.*.?.on) { return 182 }
    at.* = Zero.{ .count = 3, .ratio = 0.5, .on = true }
    if local == null || !(local.?.count == 3 && local.?.ratio == 0.5 && local.?.on) { return 183 }
    // Fields, of a struct value and through a pointer to it.
    var holder = zeroHolder()
    if holder.zero == null || !(holder.zero.?.count == 0 && @bitCast(u64, holder.zero.?.ratio) == 0 && !holder.zero.?.on) { return 184 }
    if emptyHolder().zero != null { return 185 }
    const holder_at = &holder
    holder_at.*.zero = null
    if holder.zero != null { return 186 }
    holder_at.*.zero = Zero.{ .count = 0, .ratio = 0.0, .on = false }
    if holder_at.*.zero == null || !(holder_at.*.zero.?.count == 0 && @bitCast(u64, holder_at.*.zero.?.ratio) == 0 && !holder_at.*.zero.?.on) { return 187 }
    zeroPut(&holder.zero, false)
    if holder.zero != null { return 188 }
    // Array elements, the array passed by value.
    var values = [3]?Zero{ Zero.{ .count = 0, .ratio = 0.0, .on = false }, null, Zero.{ .count = 0, .ratio = 0.0, .on = false } }
    if values[0] == null || values[1] != null || !(values[2].?.count == 0 && @bitCast(u64, values[2].?.ratio) == 0 && !values[2].?.on) { return 189 }
    if zeroCount(values) != 2 { return 190 }
    values[1] = Zero.{ .count = 0, .ratio = 0.0, .on = false }
    if values[1] == null || zeroCount(values) != 3 { return 191 }
    zeroPut(&values[0], false)
    if values[0] != null || values[1] == null || zeroCount(values) != 2 { return 192 }
    return 0
}

// `?[]const u8` of length 0 (a slice that points somewhere).
fn textOf(present: bool) -> ?[]const u8 {
    if present { return "" }
    return null
}

fn textThrough(value: ?[]const u8) -> ?[]const u8 { return value }

fn textAbsent(value: ?[]const u8) -> bool { return value == null }

inline fn textInlineZero() -> ?[]const u8 { return "" }

inline fn textInlineNone() -> ?[]const u8 { return null }

fn textPut(place: *?[]const u8, present: bool) -> void {
    if present {
        place.* = ""
    } else {
        place.* = null
    }
}

fn textCount(values: [3]?[]const u8) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < 3 {
        if values[index] != null { count += 1 }
        index += 1
    }
    return count
}

fn texts() -> u8 {
    // Returned.
    const present = textOf(true)
    if present == null { return 195 }
    if present != null && !(present.?.length == 0) { return 196 }
    if textOf(false) != null { return 197 }
    // Passed, and passed back.
    if textAbsent("") || !textAbsent(null) { return 198 }
    const through = textThrough("")
    if through == null || !(through.?.length == 0) || textThrough(null) != null { return 199 }
    // From an inline function.
    const inlined = textInlineZero()
    if inlined == null || !(inlined.?.length == 0) || textInlineNone() != null { return 200 }
    // A local, assigned, and as the value of an if.
    var local: ?[]const u8 = ""
    if local == null { return 201 }
    local = null
    if local != null { return 202 }
    local = ""
    var seen = false
    if local != null { seen = local.?.length == 0 }
    if !seen { return 203 }
    const bare: []const u8 = ""
    const nothing: ?[]const u8 = null
    const chosen: ?[]const u8 = if seen { bare } else { nothing }
    const missing: ?[]const u8 = if !seen { bare } else { nothing }
    if chosen == null || !(chosen.?.length == 0) || missing != null { return 204 }
    // As the value of a match (an arm of `T` first, or of `?T`).
    const matched: ?[]const u8 = match which(seen) { 1 => bare, else => nothing }
    const unmatched: ?[]const u8 = match which(seen) { 0 => bare, else => nothing }
    const later: ?[]const u8 = match which(seen) { 0 => nothing, else => bare }
    if matched == null || !(matched.?.length == 0) || unmatched != null || later == null || !(later.?.length == 0) { return 205 }
    // Through a pointer, and set by a callee.
    const at = &local
    at.* = null
    if at.* != null || local != null { return 206 }
    textPut(&local, true)
    if at.* == null || !(at.*.?.length == 0) { return 207 }
    at.* = "ab"
    if local == null || !(local.?.length == 2 && local.?[1] == 'b') { return 208 }
    // Fields, of a struct value and through a pointer to it.
    var holder = zeroHolder()
    if holder.text == null || !(holder.text.?.length == 0) { return 209 }
    if emptyHolder().text != null { return 210 }
    const holder_at = &holder
    holder_at.*.text = null
    if holder.text != null { return 211 }
    holder_at.*.text = ""
    if holder_at.*.text == null || !(holder_at.*.text.?.length == 0) { return 212 }
    textPut(&holder.text, false)
    if holder.text != null { return 213 }
    // Array elements, the array passed by value.
    var values = [3]?[]const u8{ "", null, "" }
    if values[0] == null || values[1] != null || !(values[2].?.length == 0) { return 214 }
    if textCount(values) != 2 { return 215 }
    values[1] = ""
    if values[1] == null || textCount(values) != 3 { return 216 }
    textPut(&values[0], false)
    if values[0] != null || values[1] == null || textCount(values) != 2 { return 217 }
    return 0
}


// A generic function's `?T`.
fn genericThrough(comptime T: type, value: ?T) -> ?T { return value }

fn genericAbsent(comptime T: type, value: ?T) -> bool { return value == null }

fn generics() -> u8 {
    if genericAbsent(f64, 0.0) || !genericAbsent(f64, null) { return 220 }
    const double = genericThrough(f64, 0.0)
    if double == null || @bitCast(u64, double.?) != 0 { return 221 }
    const single = genericThrough(f32, 0.0)
    if genericAbsent(f32, 0.0) || single == null || @bitCast(u32, single.?) != 0 { return 222 }
    if genericAbsent(u8, 0) || genericAbsent(i64, 0) || genericAbsent(bool, false) { return 223 }
    if genericThrough(f64, null) != null || genericThrough(u8, null) != null { return 224 }
    return 0
}

// Slices of length 0 that point into an array: present (an optional
// slice is null when its pointer is 0).
fn emptySlices() -> u8 {
    var buffer = [4]u8{ 1, 2, 3, 4 }
    const middle: ?[]const u8 = buffer[2..2]
    const past: ?[]u8 = buffer[4..4]
    if middle == null || middle.?.length != 0 || past == null || past.?.length != 0 { return 225 }
    var held: ?[]const u8 = null
    held = buffer[0..0]
    if held == null || textAbsent(buffer[1..1]) { return 226 }
    return 0
}

fn main() -> u8 {
    if give() == null { return 1 }
    const given = give()
    if given == null || @bitCast(u64, given.?) != 0 { return 2 }
    // The memory: the payload's bytes, then the tag.
    if @sizeOf(?f64) != 9 || @sizeOf(?f32) != 5 || @sizeOf(?u8) != 2 { return 3 }
    var stored: ?f64 = 0.0
    var zeroed = [9]u8{ 0, 0, 0, 0, 0, 0, 0, 0, 0 }
    unsafe {
        const view = @ptrCast([*]u8, &stored)
        if view[0] != 0 || view[7] != 0 || view[8] != 1 { return 4 }
        stored = null
        if view[8] != 0 { return 5 }
        if @ptrCast(*?f64, &zeroed).* != null { return 6 }
        zeroed[8] = 1
        if @ptrCast(*?f64, &zeroed).* == null { return 7 }
    }
    var failed = bytes()
    if failed == 0 { failed = longs() }
    if failed == 0 { failed = flags() }
    if failed == 0 { failed = singles() }
    if failed == 0 { failed = doubles() }
    if failed == 0 { failed = negatives() }
    if failed == 0 { failed = zeros() }
    if failed == 0 { failed = texts() }
    if failed == 0 { failed = generics() }
    if failed == 0 { failed = emptySlices() }
    if failed != 0 { return failed }
    return 13
}
