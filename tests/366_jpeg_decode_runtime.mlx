// std.jpeg's decoder (std.jpeg.read and std.jpeg.output under it): small
// images of the kinds it must take, each with the 8-bit RGBA the
// system's libjpeg-turbo decodes it to: baseline 4:2:0 at a size that is
// no multiple of the blocks, progressive 4:2:2, grey, Adobe CMYK (made
// RGB as browsers make it), 4:4:4 with a restart marker every two MCUs,
// and one with an EXIF orientation of 8. Then damaged data: not a JPEG,
// a header cut short, a scan cut in half (decoded, the rest grey), a
// lossless frame (refused as unsupported). Exits 13 when every check
// holds, else the number of the first check that failed.
const std = @import("std")
const jpeg = @import("std.jpeg")

fn same(a: [*]const u8, b: [*]const u8, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// Decodes FILE (LENGTH bytes); true when it is WIDTH x HEIGHT with the
// pixels EXPECTED and orientation ORIENTATION.
fn decodes(file: [*]const u8, length: usize, width: usize, height: usize, expected: [*]const u8, orientation: u32) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var picture: jpeg.Picture = undefined
    if jpeg.decodeRgba(&picture, file, length, allocator) != jpeg.Status.ok { return false }
    const good = picture.width == width && picture.height == height && picture.orientation == orientation && same(picture.pixels, expected, width * height * 4)
    jpeg.deinitPicture(&picture)
    return good
}

fn status(file: [*]const u8, length: usize) -> jpeg.Status {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var picture: jpeg.Picture = undefined
    const result = jpeg.decodeRgba(&picture, file, length, allocator)
    if result == jpeg.Status.ok { jpeg.deinitPicture(&picture) }
    return result
}

pub fn main() -> u8 {
    if !decodes(&baseline420File, 726, 13, 11, &baseline420Pixels, 1) { return 1 }
    if !decodes(&progressive422File, 637, 11, 9, &progressive422Pixels, 1) { return 2 }
    if !decodes(&grayFile, 390, 9, 6, &grayPixels, 1) { return 3 }
    if !decodes(&cmykFile, 472, 7, 5, &cmykPixels, 1) { return 4 }
    if !decodes(&restart444File, 973, 17, 10, &restart444Pixels, 1) { return 5 }
    if !decodes(&exif8File, 711, 6, 6, &exif8Pixels, 8) { return 6 }

    // Damaged data.
    var copy: [1000]u8 = undefined
    var index: usize = 0
    while index < 726 {
        copy[index] = baseline420File[index]
        index += 1
    }
    const view: [*]const u8 = &copy
    copy[1] = 0xd9
    if status(view, 726) != jpeg.Status.notJpeg { return 7 }
    copy[1] = 0xd8
    if status(view, 726) != jpeg.Status.ok { return 8 }
    if status(view, 40) != jpeg.Status.corrupt { return 9 }
    if status(view, 690) != jpeg.Status.ok { return 10 }
    // The frame header made a lossless one (SOF3).
    index = 2
    while index + 1 < 726 {
        if copy[index] == 0xff && copy[index + 1] == 0xc0 { break }
        index += 1
    }
    copy[index + 1] = 0xc3
    if status(view, 726) != jpeg.Status.unsupported { return 11 }
    return 13
}

