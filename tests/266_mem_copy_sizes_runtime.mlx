// Copying struct and array values of sizes that are not a multiple of 8
// (1, 3, 12, 13, 20 and 33 bytes): every byte arrives, and the bytes next
// to the copy stay as they were. Values are copied with one mem_copy (a
// runtime routine on aarch64, rep movsb on x86_64) since the copies became
// that small. Exits 13.
const Three = struct { a: u8, b: u8, c: u8 }
const Twelve = struct { a: u32, b: u32, c: u32 }
const Twenty = struct { a: u64, b: u64, c: u32 }

fn fill(bytes: [*]u8, count: usize, seed: u8) -> void {
    var index: usize = 0
    while index < count {
        bytes[index] = seed +% @intCast(u8, index * 7)
        index += 1
    }
}

fn same(a: [*]const u8, b: [*]const u8, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

pub fn main() -> u8 {
    var one: [1]u8 = [1]u8{ 9 }
    var one_copy = one
    if one_copy[0] != 9 { return 1 }

    var three = Three.{ .a = 1, .b = 2, .c = 3 }
    var three_copy = three
    three_copy.b = 7
    if three.b != 2 || three_copy.a != 1 || three_copy.c != 3 { return 2 }

    const twelve = Twelve.{ .a = 4000000000, .b = 5, .c = 6 }
    var twelve_copy = twelve
    if twelve_copy.a != 4000000000 || twelve_copy.b != 5 || twelve_copy.c != 6 { return 3 }

    var twenty = Twenty.{ .a = 1, .b = 18446744073709551615, .c = 7 }
    var twenty_copy = twenty
    twenty_copy.b = 2
    if twenty.b != 18446744073709551615 || twenty_copy.c != 7 { return 4 }

    // 13 and 33 bytes between guard bytes: the copies land exactly.
    var source13: [13]u8 = undefined
    var source33: [33]u8 = undefined
    unsafe {
        fill(@ptrCast([*]u8, &source13), 13, 11)
        fill(@ptrCast([*]u8, &source33), 33, 50)
    }
    var box: [3][13]u8 = undefined
    unsafe { fill(@ptrCast([*]u8, &box), 39, 200) }
    var before: [39]u8 = undefined
    unsafe { fill(@ptrCast([*]u8, &before), 39, 200) }
    box[1] = source13
    unsafe {
        const all = @ptrCast([*]const u8, &box)
        const expected = @ptrCast([*]const u8, &before)
        if !same(all, expected, 13) { return 5 }
        if !same(@ptrFromInt([*]const u8, @intFromPtr(all) + 13), @ptrCast([*]const u8, &source13), 13) { return 6 }
        if !same(@ptrFromInt([*]const u8, @intFromPtr(all) + 26), @ptrFromInt([*]const u8, @intFromPtr(expected) + 26), 13) { return 7 }
    }
    var copy33 = source33
    copy33[32] = 0
    unsafe {
        if !same(@ptrCast([*]const u8, &copy33), @ptrCast([*]const u8, &source33), 32) { return 8 }
    }
    if source33[32] == 0 { return 9 }
    return 13
}
