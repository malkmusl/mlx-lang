// Aggregates whose address stays in their function live in its frame
// (ir/escape.mlx) instead of the aggregate arena, which only grows: a
// struct literal handed to a function that only reads it, a `var` made
// on every pass of a loop, a buffer declared undefined (zeroed, as the
// arena's memory is). What does leave the function stays in the arena:
// a value stored into a global and a cell an older pass's pointer still
// reads; a value returned goes where its caller wants it, here into
// main's frame. Exits 13.
const turns = @import("std.turns")

const Point = struct { x: i64, y: i64 }
const Cell = struct { value: u64, pad: u64 }

var kept: *Point = undefined

fn sum(p: *const Point) -> i64 { return p.*.x + p.*.y }
fn sumValue(p: Point) -> i64 { return p.x + p.y }
fn keep(p: *Point) -> void { kept = p }
fn made(x: i64) -> Point { return Point.{ .x = x, .y = x } }

fn literals(count: i64) -> i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < count {
        total += sumValue(Point.{ .x = i, .y = 1 })
        i += 1
    }
    return total
}

fn copies(count: i64) -> i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < count {
        var p = Point.{ .x = i, .y = 2 }
        p.y += 1
        total += sum(&p)
        i += 1
    }
    return total
}

fn zeroed() -> u64 {
    var words: [4]u64 = undefined
    return words[0] + words[1] + words[2] + words[3]
}

fn older(count: u64) -> u64 {
    var total: u64 = 0
    var last: *Cell = undefined
    var i: u64 = 0
    while i < count {
        var cell = Cell.{ .value = i, .pad = 0 }
        const previous = last
        last = &cell
        if i > 0 { total += previous.*.value * 10 }
        total += cell.value
        i += 1
    }
    return total
}

// Bytes the aggregate arena grew by since `before` (0 where the arena is
// not found, as under an emulator: the values are checked all the same).
fn grown(base: usize, before: usize) -> usize {
    if base == 0 { return 0 }
    return turns.used(base) - before
}

fn used(base: usize) -> usize { return if base == 0 { 0 } else { turns.used(base) } }

pub fn main() -> u8 {
    const base = turns.locate()
    // 0 + 1 + ... + 99 and 100 ones.
    var before = used(base)
    if literals(100) != 5050 { return 2 }
    if grown(base, before) != 0 { return 3 }
    before = used(base)
    if copies(100) != 5250 { return 4 }
    if grown(base, before) != 0 { return 5 }
    if zeroed() != 0 { return 6 }
    // 0 + 1 + 2 + 3, and 10 times the three older ones.
    if older(4) != 36 { return 7 }
    // A point stored into a global keeps its own storage.
    before = used(base)
    var global = Point.{ .x = 5, .y = 6 }
    keep(&global)
    if base != 0 && grown(base, before) == 0 { return 8 }
    if sum(kept) != 11 { return 9 }
    // A returned point is written into storage main provides, in its
    // frame.
    before = used(base)
    const point = made(7)
    if grown(base, before) != 0 { return 10 }
    if point.x + point.y != 14 { return 11 }
    return 13
}
