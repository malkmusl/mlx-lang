// Negating a float keeps it a float wherever its type comes from context:
// inside @intFromFloat (whose destination is an integer) and when a
// function taking f64 is inlined with a negative literal argument. Both
// used to negate the literal's bits as an integer. Exits 13.
fn truncate(value: f64) -> i64 {
    const whole: i64 = @intFromFloat(i64, value)
    return whole
}

fn floor(value: f64) -> f64 {
    const whole: i64 = @intFromFloat(i64, value)
    const truncated: f64 = @floatFromInt(f64, whole)
    if truncated > value { return truncated - 1.0 }
    return truncated
}

pub fn main() -> u8 {
    const direct: i64 = @intFromFloat(i64, -2.25)
    if direct != -2 { return 1 }
    if truncate(-7.9) != -7 { return 2 }
    if floor(-2.25) != -3.0 || floor(2.75) != 2.0 { return 3 }
    const value: f64 = 1.5
    const negated = -value
    if negated != -1.5 { return 4 }
    if -negated != 1.5 { return 5 }
    return 13
}
