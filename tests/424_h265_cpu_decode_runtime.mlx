const PICTURE_BYTES: usize = 64 * 64 * 3
// The CRC-32 of the reference decoding: every picture's planes, the first
// picture's and the last's.
const ALL: u32 = 0x3ec47aa8
const FIRST: u32 = 0x73eb987e
const LAST: u32 = 0x2187ddb0

var total: u32 = 0
var outputs: usize = 0
var failed: u8 = 0

fn output(planes: decode.Planes) -> void {
    if planes.width != 64 || planes.height != 64 || planes.bitDepth != 10 {
        if failed == 0 { failed = 30 }
        return
    }
    var own: u32 = 0
    unsafe {
        own = crc.crc32(0, @ptrCast([*]const u8, planes.y), 64 * 64 * 2)
        own = crc.crc32(own, @ptrCast([*]const u8, planes.cb), 32 * 32 * 2)
        own = crc.crc32(own, @ptrCast([*]const u8, planes.cr), 32 * 32 * 2)
        total = crc.crc32(total, @ptrCast([*]const u8, planes.y), 64 * 64 * 2)
        total = crc.crc32(total, @ptrCast([*]const u8, planes.cb), 32 * 32 * 2)
        total = crc.crc32(total, @ptrCast([*]const u8, planes.cr), 32 * 32 * 2)
    }
    if outputs == 0 && own != FIRST && failed == 0 { failed = 31 }
    if outputs == 9 && own != LAST && failed == 0 { failed = 32 }
    outputs += 1
}

// The stream's access units (each the NAL units up to the next picture's
// first slice segment or parameter sets), each decoded on `d`, or
// submitted to `pool` when it is not null.
fn run(h: *h265.Decoder, d: ?*decode.Decoder, pool: ?*decode.Pool, au: [*]u8) -> usize {
    var pictures: usize = 0
    var at: usize = 0
    var length: usize = 0
    var hasSlice = false
    var nal: h265.Nal = undefined
    var more = true
    var slot: usize = 0
    var poc: i32 = 0
    while more {
        more = h265.nextAnnexB(&stream, LENGTH, &at, &nal)
        var flush = !more
        if more && hasSlice {
            if nal.kind < 32 && stream[nal.offset + 2] & 0x80 != 0 { flush = true }
            if nal.kind >= 32 && nal.kind <= 34 { flush = true }
        }
        if flush && length > 0 {
            if h265.accessUnit(h, au, length, 0) != h265.Status.ok {
                if failed == 0 { failed = 33 }
            } else {
                pictures += 1
                if pool == null {
                    if decode.decodePicture(d.?, h, au) != h265.Status.ok && failed == 0 { failed = 34 }
                    h265.finishPicture(h)
                    while h265.nextOutput(h, &slot, &poc) { output(decode.planes(d.?, slot)) }
                } else {
                    if decode.submit(pool.?, h, au) != h265.Status.ok && failed == 0 { failed = 35 }
                    h265.finishPicture(h)
                    while decode.nextReady(pool.?, h, &slot, &poc) { output(decode.poolPlanes(pool.?, slot)) }
                }
            }
            length = 0
            hasSlice = false
        }
        if more {
            au[length] = 0
            au[length + 1] = 0
            au[length + 2] = 1
            var k: usize = 0
            while k < nal.length {
                au[length + 3 + k] = stream[nal.offset + k]
                k += 1
            }
            length += nal.length + 3
            if nal.kind < 32 { hasSlice = true }
        }
    }
    h265.flush(h)
    if pool == null {
        while h265.nextOutput(h, &slot, &poc) { output(decode.planes(d.?, slot)) }
    } else {
        while decode.nextReady(pool.?, h, &slot, &poc) { output(decode.poolPlanes(pool.?, slot)) }
    }
    return pictures
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const memory = allocator.alloc(LENGTH * 2, 16)
    if memory == null { return 1 }
    const au = memory.?
    const made = h265.create(allocator)
    const cpu = decode.create(allocator)
    if made == null || cpu == null { return 2 }
    const h = made.?
    const d = cpu.?
    if run(h, d, null, au) != 10 { return 3 }
    if failed != 0 { return failed }
    if outputs != 10 { return 4 }
    if total != ALL { return 5 }
    // The 8-bit planes: each sample (v + 2) >> 2.
    var y: [*]const u8 = undefined
    var cb: [*]const u8 = undefined
    var cr: [*]const u8 = undefined
    var slot: usize = 0
    while slot < h265.SLOTS && !(d.*.frames[slot].allocated && d.*.frames[slot].poc == 0) { slot += 1 }
    if slot == h265.SLOTS || !decode.planes8(d, slot, &y, &cb, &cr) { return 6 }
    const wide = decode.planes(d, slot)
    var k: usize = 0
    while k < 64 * 64 {
        var rounded = (@intCast(u32, wide.y[k]) + 2) >> 2
        if rounded > 255 { rounded = 255 }
        if @intCast(u32, y[k]) != rounded { return 7 }
        k += 1
    }

    // On threads.
    const second = h265.create(allocator)
    const made2 = decode.createPool(allocator, 3)
    if second == null || made2 == null { return 40 }
    const pool = made2.?
    total = 0
    outputs = 0
    if run(second.?, null, pool, au) != 10 { return 41 }
    if failed != 0 { return failed }
    if outputs != 10 { return 42 }
    if total != ALL { return 43 }
    decode.destroyPool(pool)
    h265.destroy(second.?)
    decode.destroy(d)
    h265.destroy(h)
    allocator.free(au, LENGTH * 2, 16)
    return 13
}
