// std.flate and std.crc: the check values of known strings (CRC-32,
// Adler-32, POSIX cksum, a joined CRC); a short text compressed at levels
// 1, 6 and 9 as a zlib stream and as a gzip member gives zlib's own bytes
// (what zlib 1.3 writes for it); 64 KiB of patterned data round trips in
// every format at levels 0, 1, 6 and 9, all at once and in pieces of 7
// bytes in and 5 bytes out (the same bytes but for level 0's stored
// blocks); decompressAlloc detects gzip and zlib, gunzip and the earlier
// inflate still work; damaged and truncated streams are refused. Exits
// 13.
const std = @import("std")
const flate = @import("std.flate")
const crc = @import("std.crc")

const Allocator = std.allocator.Allocator

const TEXT: []const u8 = "hello hello hello hello, std.flate says hello"

fn same(first: [*]const u8, second: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn offset(base: [*]u8, by: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, @intFromPtr(base) + by) } }

// Compresses DATA in pieces (7 bytes in, 5 out at a time) into OUTPUT:
// the bytes written, 0 on failure.
fn deflatePieces(allocator: Allocator, data: [*]const u8, length: usize, output: [*]u8, capacity: usize, level: i32, format: flate.Format) -> usize {
    var deflater: flate.Deflater = undefined
    if flate.deflaterInit(&deflater, allocator, flate.options(level, format)) != flate.Status.ok { return 0 }
    var consumed: usize = 0
    var produced: usize = 0
    var rounds: usize = 0
    while true {
        var rest = length - consumed
        if rest > 7 { rest = 7 }
        var room = capacity - produced
        if room > 5 { room = 5 }
        const flush = if consumed + rest == length { flate.Flush.finish } else { flate.Flush.none }
        var progress: flate.Progress = undefined
        const from: [*]const u8 = unsafe { @ptrFromInt([*]const u8, @intFromPtr(data) + consumed) }
        const status = flate.deflaterRun(&deflater, from, rest, offset(output, produced), room, flush, &progress)
        consumed += progress.consumed
        produced += progress.produced
        if status == flate.Status.done { break }
        if status != flate.Status.ok && status != flate.Status.stuck { return 0 }
        rounds += 1
        if rounds > 1000000 { return 0 }
    }
    flate.deflaterEnd(&deflater)
    return produced
}

fn inflatePieces(allocator: Allocator, data: [*]const u8, length: usize, output: [*]u8, capacity: usize, format: flate.Format) -> usize {
    var inflater: flate.Inflater = undefined
    if flate.inflaterInit(&inflater, allocator, format) != flate.Status.ok { return 0 }
    var consumed: usize = 0
    var produced: usize = 0
    var rounds: usize = 0
    while true {
        var rest = length - consumed
        if rest > 7 { rest = 7 }
        var room = capacity - produced
        if room > 5 { room = 5 }
        var progress: flate.Progress = undefined
        const from: [*]const u8 = unsafe { @ptrFromInt([*]const u8, @intFromPtr(data) + consumed) }
        const status = flate.inflaterRun(&inflater, from, rest, offset(output, produced), room, &progress)
        consumed += progress.consumed
        produced += progress.produced
        if status == flate.Status.done { break }
        if status != flate.Status.ok && status != flate.Status.stuck { return 0 }
        rounds += 1
        if rounds > 1000000 { return 0 }
    }
    flate.inflaterEnd(&inflater)
    return produced
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    // The check values.
    if crc.crc32(0, "123456789".pointer, 9) != 0xcbf43926 { return 1 }
    if crc.adler32(1, "Wikipedia".pointer, 9) != 0x11e60398 { return 2 }
    if crc.cksum("123456789".pointer, 9) != 930766865 { return 3 }
    const left = crc.crc32(0, "12345".pointer, 5)
    const right = crc.crc32(0, "6789".pointer, 4)
    if crc.crc32Join(left, right, 4) != 0xcbf43926 { return 4 }
    if crc.crc32(left, "6789".pointer, 4) != 0xcbf43926 { return 5 }
    if flate.crc32(0, "123456789".pointer, 9) != 0xcbf43926 { return 6 }

    // zlib's bytes.
    const expected_1 = [34]u8{ 120, 1, 203, 72, 205, 201, 201, 87, 200, 64, 39, 117, 20, 138, 75, 82, 244, 210, 114, 18, 75, 82, 21, 138, 19, 43, 139, 33, 42, 0, 125, 27, 16, 150 }
    const expected_6 = [34]u8{ 120, 156, 203, 72, 205, 201, 201, 87, 200, 64, 39, 117, 20, 138, 75, 82, 244, 210, 114, 18, 75, 82, 21, 138, 19, 43, 139, 33, 162, 0, 125, 27, 16, 150 }
    const expected_9 = [34]u8{ 120, 218, 203, 72, 205, 201, 201, 87, 200, 64, 39, 117, 20, 138, 75, 82, 244, 210, 114, 18, 75, 82, 21, 138, 19, 43, 139, 33, 162, 0, 125, 27, 16, 150 }
    const expected_gzip = [46]u8{ 31, 139, 8, 0, 0, 0, 0, 0, 0, 3, 203, 72, 205, 201, 201, 87, 200, 64, 39, 117, 20, 138, 75, 82, 244, 210, 114, 18, 75, 82, 21, 138, 19, 43, 139, 33, 162, 0, 57, 179, 241, 42, 45, 0, 0, 0 }
    var small: [128]u8 = undefined
    const room = flate.compressBound(TEXT.length, flate.Format.gzip)
    if room > 128 { return 7 }
    if flate.compress(TEXT.pointer, TEXT.length, &small, room, 1, flate.Format.zlib, allocator) != 34 || !same(&small, &expected_1, 34) { return 8 }
    if flate.compress(TEXT.pointer, TEXT.length, &small, room, 6, flate.Format.zlib, allocator) != 34 || !same(&small, &expected_6, 34) { return 9 }
    if flate.compress(TEXT.pointer, TEXT.length, &small, room, 9, flate.Format.zlib, allocator) != 34 || !same(&small, &expected_9, 34) { return 10 }
    if flate.compress(TEXT.pointer, TEXT.length, &small, room, -1, flate.Format.gzip, allocator) != 46 || !same(&small, &expected_gzip, 46) { return 11 }
    // Too little room.
    if flate.compress(TEXT.pointer, TEXT.length, &small, 20, 6, flate.Format.zlib, allocator) != 0 { return 12 }
    var back: [64]u8 = undefined
    if flate.gzipSize(&expected_gzip, 46) != TEXT.length { return 13 }
    if flate.gunzip(&expected_gzip, 46, &back, 64) != TEXT.length || !same(&back, TEXT.pointer, TEXT.length) { return 14 }
    // The raw data inside the zlib stream, with the earlier inflate.
    const raw: [*]const u8 = unsafe { @ptrFromInt([*]const u8, @intFromPtr(&expected_6) + 2) }
    if flate.inflate(raw, 32, &back, 64) != TEXT.length || !same(&back, TEXT.pointer, TEXT.length) { return 15 }
    // Not enough room, damaged, a wrong check value.
    if flate.decompress(&expected_6, 34, &back, 10, flate.Format.zlib) != 0 { return 16 }
    var damaged: [34]u8 = expected_6
    damaged[33] = 0
    if flate.decompress(&damaged, 34, &back, 64, flate.Format.zlib) != 0 { return 17 }
    damaged = expected_6
    damaged[0] = 121
    if flate.decompress(&damaged, 34, &back, 64, flate.Format.zlib) != 0 { return 18 }

    // 64 KiB round trips.
    const SIZE: usize = 65536
    const data = allocator.alloc(SIZE, 16).?
    var index: usize = 0
    while index < SIZE {
        data[index] = @intCast(u8, ((index * 7) ^ (index >> 5)) & 255)
        if (index / 1000) % 3 == 0 { data[index] = @intCast(u8, (index % 26) + 97) }
        index += 1
    }
    const capacity = flate.compressBound(SIZE, flate.Format.gzip)
    const squeezed = allocator.alloc(capacity, 16).?
    const pieces = allocator.alloc(capacity, 16).?
    const unpacked = allocator.alloc(SIZE, 16).?
    const formats = [3]flate.Format{ flate.Format.raw, flate.Format.zlib, flate.Format.gzip }
    const levels = [4]i32{ 0, 1, 6, 9 }
    for format in formats {
        for level in levels {
            const made = flate.compress(data, SIZE, squeezed, capacity, level, format, allocator)
            if made == 0 { return 20 }
            // In pieces: the same bytes (stored blocks, level 0, are cut
            // to the room there is, as zlib cuts them).
            const madePieces = deflatePieces(allocator, data, SIZE, pieces, capacity, level, format)
            if level != 0 && (madePieces != made || !same(pieces, squeezed, made)) { return 21 }
            if flate.decompress(pieces, madePieces, unpacked, SIZE, format) != SIZE || !same(unpacked, data, SIZE) { return 19 }
            if flate.decompress(squeezed, made, unpacked, SIZE, format) != SIZE || !same(unpacked, data, SIZE) { return 22 }
            if inflatePieces(allocator, squeezed, made, unpacked, SIZE, format) != SIZE || !same(unpacked, data, SIZE) { return 23 }
            if format != flate.Format.raw {
                var result: flate.Buffer = undefined
                if flate.decompressAlloc(allocator, squeezed, made, flate.Format.detect, &result) != flate.Status.done { return 24 }
                if result.length != SIZE || !same(result.bytes, data, SIZE) { return 25 }
                flate.freeBuffer(allocator, &result)
                // Truncated.
                if flate.decompressAlloc(allocator, squeezed, made - 9, flate.Format.detect, &result) != flate.Status.damaged { return 26 }
            }
        }
    }
    var result: flate.Buffer = undefined
    if flate.compressAlloc(allocator, data, SIZE, 6, flate.Format.zlib, &result) != flate.Status.done { return 27 }
    if flate.decompress(result.bytes, result.length, unpacked, SIZE, flate.Format.zlib) != SIZE || !same(unpacked, data, SIZE) { return 28 }
    flate.freeBuffer(allocator, &result)
    // The message of a damaged stream.
    var inflater: flate.Inflater = undefined
    if flate.inflaterInit(&inflater, allocator, flate.Format.zlib) != flate.Status.ok { return 29 }
    var progress: flate.Progress = undefined
    if flate.inflaterRun(&inflater, &damaged, 34, unpacked, SIZE, &progress) != flate.Status.damaged { return 30 }
    if !std.text.same(flate.message(&inflater.stream), "incorrect header check") { return 31 }
    flate.inflaterEnd(&inflater)
    return 13
}
