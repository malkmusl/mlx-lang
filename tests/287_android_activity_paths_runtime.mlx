const android = @import("std.android")

// The leading fields of ANativeActivity on 64-bit Android. Keeping this test
// as a struct makes the fake object naturally pointer-aligned.
const FakeActivity = struct {
    callbacks: usize
    vm: usize
    env: usize
    clazz: usize
    internalDataPath: usize
    externalDataPath: usize
    sdkVersion: i32
    padding: u32
    instance: usize
    assetManager: usize
    obbPath: usize
}

pub fn main() -> u8 {
    var fake = FakeActivity.{
        .callbacks = 0,
        .vm = 0,
        .env = 0,
        .clazz = 0,
        .internalDataPath = 4660,
        .externalDataPath = 22136,
        .sdkVersion = 35,
        .padding = 0,
        .instance = 0,
        .assetManager = 0,
        .obbPath = 0,
    }
    if @intFromPtr(android.internalDataPath(@intFromPtr(&fake))) != 4660 { return 1 }
    if @intFromPtr(android.externalDataPath(@intFromPtr(&fake))) != 22136 { return 2 }
    return 13
}
