// The kernel's table of TCP connections asked of a listener and not made
// yet (projects/brix/kernel/net/halfopen.mlx, built for the host), on a
// clock of the test's: a SYN takes a record and finds it again; the
// SYN+ACK goes again after one second and after three, and after seven
// the record is over; the same SYN once more changes nothing, another
// from the same port begins anew; with every record taken the one that
// waited longest gives way, never the newcomer; a hundred peers that ask
// and never answer leave the newest sixty-four, and a peer that answers
// within its second still has its record; a listener that closes takes
// its own with it.
// Exits 13.
const std = @import("std")
const halfopen = @import("../projects/brix/kernel/net/halfopen.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var failed = false

fn expect(condition: bool, what: []const u8) -> void {
    if condition { return }
    failed = true
    say("FAIL ")
    say(what)
    say("\n")
}

const SECOND: usize = halfopen.SECOND
const MAX: usize = halfopen.MAX
const Step = halfopen.Step

var table: halfopen.Table = undefined

// Peer number `n` (an address and a port of its own).
fn peer(n: usize) -> [4]u8 { return [4]u8{ 10, 10, @intCast(u8, 36 + n / 250), @intCast(u8, 1 + n % 250) } }
fn portOf(n: usize) -> usize { return 20000 + n }

fn ask(n: usize, port: usize, now: usize) -> usize {
    const from = peer(n)
    return table.begin(port, &from, portOf(n), 1000 + n, 5000 + n, 1460, 65535, now)
}

fn has(n: usize, port: usize) -> bool {
    const from = peer(n)
    return table.find(port, &from, portOf(n)) != MAX
}

// What the clock does to every record at `now`: (SYN+ACKs that go
// again, records that end).
fn tick(now: usize) -> (usize, usize) {
    var again: usize = 0
    var gone: usize = 0
    var k: usize = 0
    while k < MAX {
        const step = table.due(k, now)
        if step == Step.again { again += 1 }
        if step == Step.gone { gone += 1 }
        k += 1
    }
    return -> (again, gone)
}

fn one() -> void {
    table.init()
    expect(table.count == 0 && !has(1, 8080), "an empty table has no record")
    const t0 = 100 * SECOND
    const index = ask(1, 8080, t0)
    const h = table.at(index)
    expect(table.count == 1 && has(1, 8080), "a SYN takes a record")
    expect(h.*.port == 8080 && h.*.remotePort == portOf(1) && h.*.iss == 1001 && h.*.theirs == 5001 && h.*.mss == 1460 && h.*.window == 65535, "the record has what the SYN said and our number")
    expect(!has(1, 8081) && !has(2, 8080), "another port or another peer is another record")
    // The SYN+ACK again after 1 s and after 3 s, the end after 7 s.
    var steps = tick(t0 + SECOND - 1)
    expect(steps.0 == 0 && steps.1 == 0, "nothing before the first second is over")
    steps = tick(t0 + SECOND)
    expect(steps.0 == 1 && steps.1 == 0, "the SYN+ACK again after one second")
    steps = tick(t0 + 2 * SECOND)
    expect(steps.0 == 0 && steps.1 == 0, "nothing after two seconds")
    steps = tick(t0 + 3 * SECOND)
    expect(steps.0 == 1 && steps.1 == 0, "the SYN+ACK again after three seconds")
    steps = tick(t0 + 6 * SECOND)
    expect(steps.0 == 0 && steps.1 == 0 && has(1, 8080), "the record still there after six seconds")
    steps = tick(t0 + 7 * SECOND)
    expect(steps.0 == 0 && steps.1 == 1 && !has(1, 8080) && table.count == 0, "the record is over after seven seconds")
    steps = tick(t0 + 60 * SECOND)
    expect(steps.0 == 0 && steps.1 == 0, "nothing more of it later")
}

fn again() -> void {
    table.init()
    const t0 = 10 * SECOND
    const first = ask(1, 8080, t0)
    // The same SYN once more, half a second later: the same record, its
    // number and its clock as they were.
    const from = peer(1)
    const second = table.begin(8080, &from, portOf(1), 7777, 5001, 536, 100, t0 + SECOND / 2)
    expect(second == first && table.count == 1, "the same SYN again finds its record")
    expect(table.at(first).*.iss == 1001 && table.at(first).*.since == t0 && table.at(first).*.mss == 1460, "and changes nothing of it")
    var steps = tick(t0 + SECOND)
    expect(steps.0 == 1, "its SYN+ACK goes again by the first SYN's clock")
    // Another SYN from the same port (another number of the peer's): the
    // record begins anew.
    const third = table.begin(8080, &from, portOf(1), 8888, 9001, 536, 100, t0 + 2 * SECOND)
    expect(third == first && table.count == 1, "another SYN from the same port takes the same place")
    expect(table.at(first).*.iss == 8888 && table.at(first).*.theirs == 9001 && table.at(first).*.since == t0 + 2 * SECOND && table.at(first).*.mss == 536, "and is a record of its own")
    steps = tick(t0 + 3 * SECOND)
    expect(steps.0 == 1 && steps.1 == 0, "with a clock of its own")
    // Dropped (the connection was made, or the peer took it back).
    table.drop(first)
    expect(table.count == 0 && !has(1, 8080), "a record dropped is gone")
    table.drop(first)
    expect(table.count == 0, "dropped twice, counted once")
}

fn full() -> void {
    table.init()
    const t0 = 1000 * SECOND
    // As many peers as there are records, a millisecond apart.
    var n: usize = 0
    while n < MAX {
        _ = ask(n, 8080, t0 + n * 1000000)
        n += 1
    }
    expect(table.count == MAX, "every record taken")
    // One more: the one that waited longest gives way, the newcomer has
    // its record.
    _ = ask(MAX, 8080, t0 + MAX * 1000000)
    expect(table.count == MAX && has(MAX, 8080), "with the table full the newcomer still gets a record")
    expect(!has(0, 8080), "the one that waited longest gave way")
    expect(has(1, 8080) && has(MAX - 1, 8080), "the others are still there")
    // A hundred that ask and never answer, then one that does within a
    // tenth of a second: its record is still there for its answer.
    table.init()
    n = 0
    while n < 100 {
        _ = ask(n, 8080, t0 + n * 2000000)
        n += 1
    }
    expect(table.count == MAX, "a hundred silent peers take every record and no more")
    var kept: usize = 0
    n = 100 - MAX
    while n < 100 {
        if has(n, 8080) { kept += 1 }
        n += 1
    }
    expect(kept == MAX && !has(0, 8080) && !has(100 - MAX - 1, 8080), "the newest of them have the records")
    const real = ask(500, 8080, t0 + SECOND / 2)
    n = 0
    while n < 20 {
        _ = ask(200 + n, 8080, t0 + SECOND / 2 + (n + 1) * 2000000)
        n += 1
    }
    expect(has(500, 8080) && table.at(real).*.iss == 1500, "a peer that answers a moment later finds its record, twenty more SYNs after its own")
    // Nobody answers any of them: each sends its SYN+ACK twice more, and
    // is over (the clock looked at only now and then: a step a look).
    var steps = tick(t0 + 2 * SECOND)
    expect(steps.0 == MAX && steps.1 == 0, "every record's SYN+ACK goes again")
    steps = tick(t0 + 5 * SECOND)
    expect(steps.0 == MAX && steps.1 == 0, "and once more")
    steps = tick(t0 + 8 * SECOND)
    expect(steps.0 == 0 && steps.1 == 0 && table.count == MAX, "four seconds after that they are still there")
    steps = tick(t0 + 9 * SECOND)
    expect(steps.1 == MAX && table.count == 0, "then all are over")
}

fn listeners() -> void {
    table.init()
    const t0 = 5 * SECOND
    _ = ask(1, 8080, t0)
    _ = ask(2, 8080, t0)
    _ = ask(3, 8081, t0)
    _ = ask(1, 8081, t0)
    expect(table.count == 4, "two listeners' records")
    table.dropPort(8080)
    expect(table.count == 2 && !has(1, 8080) && !has(2, 8080) && has(3, 8081) && has(1, 8081), "a listener that closes takes its own records with it, no other's")
    // A place that was let go is taken first.
    const place = table.place()
    expect(!table.at(place).*.used, "a free place before anyone gives way")
    _ = ask(9, 8081, t0 + SECOND)
    expect(table.count == 3 && has(3, 8081) && has(1, 8081), "nobody gave way for it")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    one()
    again()
    full()
    listeners()
    if failed { return 1 }
    return 13
}
