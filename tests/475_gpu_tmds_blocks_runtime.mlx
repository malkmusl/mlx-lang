// What the kernel's mode set on a Radeon's TMDS output tells the card's
// firmware tables, and when it plans nothing (projects/brix/kernel/
// gpu_blocks.mlx, gpu_mode.mlx, edid.mlx and gpu_rom.mlx, built for the
// host; the card and the ROM are tests/support/tmds_card.mlx's).
//
// The parameter blocks, byte for byte against the bytes the document of
// the sequence works out from Linux 6.6's atombios.h and command_table.c:
// SetPixelClock, the transmitter's table on and off, the encoder's
// stream setup, EnableCRTC, SetCRTC_UsingDTDTiming, SetDCEClock and the
// reference clock's call; for every back end its PHY, PLL and encoder
// object; the polarity bits; the AVI info frame and its checksum; the
// timing's words.
// What a monitor's EDID offers: every timing of its own size, the HDMI
// vendor's block with the highest clock, the HDMI Forum's block, more
// extension blocks than were passed on.
// The timing and the signalling chosen: the monitor's own timing when
// the link carries it; another of its size when not, by the rule; none;
// DVI for a clock a DVI link carries when the firmware sends DVI, HDMI
// above; the limits (165 MHz, below 300 MHz, below 340 MHz with the
// ROM's word for it, the monitor's own, a DisplayPort connector's
// adapter).
// Every refusal, each with its line and no write when the image asks:
// no ROM; each table missing or of another revision; an output that is
// not TMDS, sends two links, has no PLL of its own; no connector behind
// it in the ROM, or one whose own source is another encoder, or of
// another kind; a hot plug pin the board's table of pins does not place;
// a clock that is another PLL's or a DTO's; no frames counted; a
// firmware timing or clock there is no way back to; a timing without a
// front porch; a formatter that does not send RGB; a display engine's
// clock that cannot be trusted or cannot be raised far enough; nothing
// to rehearse.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const blocks = @import("../projects/brix/kernel/gpu_blocks.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/tmds_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    card.logWrite(text)
    if show { say(text) }
}

// A block's bytes against bytes worked out by hand.
fn sameBlock(name: []const u8, block: *const blocks.Block, table: usize, bytes: []const u8) -> void {
    var same = block.*.table == table && block.*.bytes == bytes.length
    var k: usize = 0
    while same && k < bytes.length {
        if block.byte(k) != @intCast(usize, bytes[k]) { same = false }
        k += 1
    }
    // (And nothing behind the structure.)
    k = bytes.length
    while same && k < blocks.WORDS * 4 {
        if block.byte(k) != 0 { same = false }
        k += 1
    }
    expect(same, name)
}

// The monitor's own timing of the document's examples: 3840x1080 at 60
// Hz (266.64 MHz, 4000 by 1111, porches 48 and 3, pulses 32 high and 10
// low).
fn example() -> edid.Timing {
    return edid.Timing.{ .clock = 266640, .width = 3840, .hTotal = 4000, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1111, .vFront = 3, .vSync = 10, .vPositive = false, .interlaced = false, .stereo = false }
}

fn wide() -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = 3840, .height = 1080, .timing = example(), .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.cta }
}

// The same size at another clock (the totals as they are: only the rate
// differs).
fn atClock(clock: usize) -> edid.Timing {
    var t = example()
    t.clock = clock
    return t
}

fn hdmiMonitor() -> edid.Offer {
    var o = edid.nothing()
    o.hdmi = true
    o.extensions = 1
    o.given = 1
    return o
}

var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

fn read() -> void {
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
}

// The usual ROM made and opened.
fn open() -> void {
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    read()
}

var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var result: set.Result = undefined
var memory: scanout.Memory = undefined

// Whether the picture the kernel draws on is another adapter's (a machine
// with a board's own adapter beside the card: none of it is in this
// card's memory).
var elsewhere = false

fn make(monitor: *const edid.Monitor, offer: *const edid.Offer, wish: mode.Wish) -> void {
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    if elsewhere { memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 0, .pictureWidth = 0, .pictureHeight = 0, .picturePitch = 0 } }
    // (The log begins anew with each plan.)
    card.logged = 0
    scanout.report(&out, &memory, &readout)
    mode.makeFor(&out, &readout, &memory, monitor, offer, &facts, wish, &plan)
    mode.say(&out, &plan)
    mode.list(&out, &plan)
    card.forget()
}

// The user's machine with nothing wrong (DIG 4 in DVI mode at 107962
// kHz), before the plan is made.
fn begin(name: []const u8) -> void {
    card.reset()
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
    card.firmware(0, 4, 4, false, 2, 107962)
}

// The plan for the wide monitor with the HDMI block.
fn usual() -> void {
    const monitor = wide()
    const offer = hdmiMonitor()
    make(&monitor, &offer, mode.Wish.own)
}

// A plan that is not complete: why, said so, and nothing written or run
// when the image asks.
fn refused(name: []const u8, missing: mode.Missing, text: []const u8) -> void {
    expect(plan.situation == mode.Situation.tmds && !plan.complete && plan.missing == missing, name)
    line(text)
    noLine("gpu: would ")
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const hands = set.Hands.{ .write = card.write, .clear = card.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = card.setAside }
    expect(!set.attemptWith(&out, &hands, &lent, &plan, true, &result) && card.written == 0 && card.runs == 0 && card.cleared == 0 && result.outcome == set.Outcome.untouched, name)
    line("gpu: the image asks for the monitor's own mode (settings/gpu), but the plan is not complete: nothing is written to the card\n")
}

// An EDID's blocks, written here from the standard's layout.
// The same for a card there is nothing to plan for at all, whatever its
// output is (`wish`: also when the firmware's own mode is asked to be
// set again): no situation, the reason said, and with the setting on no
// write, no table run, nothing cleared.
fn nothingFor(name: []const u8, wish: mode.Wish, missing: mode.Missing, text: []const u8) -> void {
    const monitor = wide()
    const offer = hdmiMonitor()
    make(&monitor, &offer, wish)
    expect(plan.situation == mode.Situation.none && !plan.complete && plan.missing == missing && plan.count == 0 && plan.runs == 0, name)
    line(text)
    noLine("gpu: would ")
    noLine("gpu: on the way back would ")
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const hands = set.Hands.{ .write = card.write, .clear = card.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = card.setAside }
    expect(!set.attemptWith(&out, &hands, &lent, &plan, true, &result) && card.written == 0 && card.runs == 0 && card.cleared == 0 && result.outcome == set.Outcome.untouched, name)
    line(if wish == mode.Wish.rehearsal { "gpu: the image asks for the firmware's own mode to be set again by the card's tables (settings/gpu), but the plan is not complete: nothing is written to the card\n" } else { "gpu: the image asks for the monitor's own mode (settings/gpu), but the plan is not complete: nothing is written to the card\n" })
}

var blob: [384]u8 = undefined

fn sum(block: usize) -> void {
    var total: usize = 0
    var k: usize = 0
    while k < 127 {
        total += @intCast(usize, blob[block * 128 + k])
        k += 1
    }
    blob[block * 128 + 127] = @intCast(u8, (256 - (total & 0xFF)) & 0xFF)
}

// A detailed timing's eighteen bytes at `at`: the clock in 10 kHz, twelve
// bits each for the sizes and blankings, ten for a line's porch and
// pulse, six for a frame's, separate sync with both polarities.
fn detailed(at: usize, t: *const edid.Timing) -> void {
    const hBlank = t.*.hTotal - t.*.width
    const vBlank = t.*.vTotal - t.*.height
    blob[at] = @intCast(u8, (t.*.clock / 10) & 0xFF)
    blob[at + 1] = @intCast(u8, (t.*.clock / 10) >> 8)
    blob[at + 2] = @intCast(u8, t.*.width & 0xFF)
    blob[at + 3] = @intCast(u8, hBlank & 0xFF)
    blob[at + 4] = @intCast(u8, ((t.*.width >> 8) << 4) | (hBlank >> 8))
    blob[at + 5] = @intCast(u8, t.*.height & 0xFF)
    blob[at + 6] = @intCast(u8, vBlank & 0xFF)
    blob[at + 7] = @intCast(u8, ((t.*.height >> 8) << 4) | (vBlank >> 8))
    blob[at + 8] = @intCast(u8, t.*.hFront & 0xFF)
    blob[at + 9] = @intCast(u8, t.*.hSync & 0xFF)
    blob[at + 10] = @intCast(u8, ((t.*.vFront & 0xF) << 4) | (t.*.vSync & 0xF))
    blob[at + 11] = @intCast(u8, ((t.*.hFront >> 8) << 6) | ((t.*.hSync >> 8) << 4) | ((t.*.vFront >> 4) << 2) | (t.*.vSync >> 4))
    blob[at + 17] = @intCast(u8, 0x18 | (if t.*.vPositive { 4 } else { 0 }) | (if t.*.hPositive { 2 } else { 0 }))
}

// A base block with the example timing as its one detailed timing, and
// `extensions` in its count of extension blocks.
fn baseBlock(extensions: usize) -> void {
    var k: usize = 0
    while k < 384 {
        blob[k] = 0
        k += 1
    }
    k = 1
    while k < 7 {
        blob[k] = 0xFF
        k += 1
    }
    const t = example()
    detailed(54, &t)
    blob[126] = @intCast(u8, extensions)
    sum(0)
}

// A CTA extension block at block `block` (revision 3, `flags` in its
// byte 3) with these data blocks' bytes and then detailed timings.
fn ctaBlock(block: usize, flags: usize, data: []const u8, timings: []const edid.Timing) -> void {
    const at = block * 128
    blob[at] = 0x02
    blob[at + 1] = 3
    blob[at + 2] = @intCast(u8, 4 + data.length)
    blob[at + 3] = @intCast(u8, flags)
    var k: usize = 0
    while k < data.length {
        blob[at + 4 + k] = data[k]
        k += 1
    }
    k = 0
    while k < timings.length {
        detailed(at + 4 + data.length + k * 18, &timings[k])
        k += 1
    }
    sum(block)
}

// The word `from` of the ROM's object table changed to `to` wherever it
// stands, and the ROM's bytes made to add up again.
fn objectWord(from: usize, to: usize) -> void {
    const start = builder.peek16(rom.DATA + 4 + 2 * 22)
    const length = builder.peek16(start)
    var at = start + 4
    while at + 2 <= start + length {
        if builder.peek16(at) == from { builder.poke16(at, to) }
        at += 1
    }
    builder.resum()
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1

    // ---- The parameter blocks, byte for byte.
    // SetPixelClock (PIXEL_CLOCK_PARAMETERS_V7), the document's 4.1: the
    // example timing by HDMI on back end 4, controller 0; and the way
    // back's (107960 kHz, DVI).
    {
        const block = blocks.pixelClock(266640, 4, true, 0)
        const bytes = [_]u8{ 0xA0, 0xAF, 0x28, 0x00, 0x18, 0x21, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }
        sameBlock("SetPixelClock for 266640 kHz by HDMI", &block, 12, bytes[0..])
        const back = blocks.pixelClock(107960, 4, false, 0)
        const backBytes = [_]u8{ 0x30, 0x79, 0x10, 0x00, 0x18, 0x21, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }
        sameBlock("SetPixelClock for 107960 kHz by DVI", &back, 12, backBytes[0..])
    }
    // Every back end: its PLL (20 and on) and its encoder object's low
    // byte (the document's 2.3), and the controller as its number.
    {
        const encoders = [_]usize{ 0x1E, 0x1E, 0x20, 0x20, 0x21, 0x21 }
        var n: usize = 0
        while n < 6 {
            const block = blocks.pixelClock(148500, n, false, 5 - n)
            expect(block.byte(4) == 20 + n && block.byte(5) == encoders[n] && block.byte(8) == 5 - n && block.byte(0) == 0xC8 && block.byte(1) == 0xA8 && block.byte(2) == 0x16 && block.byte(6) == 2 && block.byte(7) == 0 && block.byte(9) == 0, "SetPixelClock for each back end")
            const on = blocks.transmitter(n, true, false, 148500, n + 1, 0x04)
            expect(on.byte(0) == n && on.byte(8) == n + 1 && on.byte(10) == 0x04 && on.byte(4) == 0x02 && on.byte(5) == 0x3A, "the transmitter's table for each back end")
            n += 1
        }
    }
    // The transmitter's table (DIG_TRANSMITTER_CONTROL_PARAMETERS_V1_6),
    // 4.2: on for the example clock by HDMI on hot plug line 2, and off
    // from the firmware's DVI state.
    {
        const on = blocks.transmitter(4, true, true, 266640, 2, 0x0C)
        const onBytes = [_]u8{ 0x04, 0x01, 0x03, 0x04, 0x28, 0x68, 0x00, 0x00, 0x02, 0x00, 0x0C, 0x00, 0x00, 0x00, 0x00, 0x00 }
        sameBlock("the transmitter on", &on, 76, onBytes[0..])
        const off = blocks.transmitter(4, false, false, 266640, 2, 0x0C)
        const offBytes = [_]u8{ 0x04, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x0C, 0x00, 0x00, 0x00, 0x00, 0x00 }
        sameBlock("the transmitter off: no lanes, no clock", &off, 76, offBytes[0..])
        // No hot plug line: 0.
        const none = blocks.transmitter(1, true, false, 65000, 0, 0x03)
        const noneBytes = [_]u8{ 0x01, 0x01, 0x02, 0x04, 0x64, 0x19, 0x00, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00 }
        sameBlock("the transmitter on without a hot plug line", &none, 76, noneBytes[0..])
    }
    // DIGxEncoderControl's stream setup (ENCODER_STREAM_SETUP_PARAMETERS_
    // V5), 4.3: HDMI names eight bits a colour, DVI no depth.
    {
        const hdmi = blocks.stream(4, true, 266640)
        const hdmiBytes = [_]u8{ 0x04, 0x0F, 0x03, 0x04, 0x28, 0x68, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00 }
        sameBlock("the stream by HDMI", &hdmi, 4, hdmiBytes[0..])
        const dvi = blocks.stream(2, false, 107960)
        const dviBytes = [_]u8{ 0x02, 0x0F, 0x02, 0x04, 0x2C, 0x2A, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }
        sameBlock("the stream by DVI", &dvi, 4, dviBytes[0..])
    }
    // EnableCRTC (ENABLE_CRTC_PARAMETERS), 4.4.
    {
        const on = blocks.controller(0, true)
        const onBytes = [_]u8{ 0x00, 0x01, 0x00, 0x00 }
        sameBlock("the controller started", &on, 35, onBytes[0..])
        const off = blocks.controller(3, false)
        const offBytes = [_]u8{ 0x03, 0x00, 0x00, 0x00 }
        sameBlock("controller 3 stopped", &off, 35, offBytes[0..])
    }
    // SetCRTC_UsingDTDTiming (SET_CRTC_USING_DTD_TIMING_PARAMETERS), 4.5:
    // the example; the polarity bits; a front porch as the timing has it.
    {
        var t = example()
        const block = blocks.timing(&t, 0)
        const bytes = [_]u8{ 0x00, 0x0F, 0xA0, 0x00, 0x38, 0x04, 0x1F, 0x00, 0x30, 0x00, 0x20, 0x00, 0x03, 0x00, 0x0A, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }
        sameBlock("the timing", &block, 49, bytes[0..])
        t.hPositive = false
        t.vPositive = false
        t.vFront = 1
        const low = blocks.timing(&t, 5)
        expect(low.byte(16) == 0x06 && low.byte(17) == 0 && low.byte(12) == 1 && low.byte(13) == 0 && low.byte(20) == 5, "both pulses the low ones, a porch of one line, controller 5")
        t.hPositive = true
        t.vPositive = true
        const high = blocks.timing(&t, 0)
        expect(high.byte(16) == 0 && high.byte(17) == 0, "both pulses the high ones")
        t.vPositive = true
        t.hPositive = false
        const mixed = blocks.timing(&t, 0)
        expect(mixed.byte(16) == 0x02, "a line's pulse the low one")
        // A timing without a front porch is told as it is (the plan
        // refuses it before; the block is not what changes it).
        t.vFront = 0
        const none = blocks.timing(&t, 0)
        expect(none.byte(12) == 0 && none.byte(13) == 0, "a front porch of no line is told as none")
        t.vFront = 1
        expect(blocks.timingFits(&t), "the example fits the block's fields")
        t.hTotal = t.width + 0x10000
        expect(!blocks.timingFits(&t), "a blanking of 65536 pixels does not fit")
    }
    // SetDCEClock (SET_DCE_CLOCK_PARAMETERS_V2_1), 4.6: the display clock
    // from the card's own divider, and the reference clock's call after
    // it.
    {
        const engine = blocks.engineClock(321967)
        const engineBytes = [_]u8{ 0xC4, 0x7D, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00 }
        sameBlock("the display engine's clock", &engine, 46, engineBytes[0..])
        const reference = blocks.referenceClock()
        const referenceBytes = [_]u8{ 0x00, 0x00, 0x00, 0x00, 0x01, 0x08, 0x00, 0x00 }
        sameBlock("the DisplayPort reference clock's call", &reference, 46, referenceBytes[0..])
    }
    // The revisions blocks are filled for: the content revision alone is
    // looked at, as Linux's display core does.
    expect(blocks.filled(12, 0x107) && !blocks.filled(12, 0x106) && !blocks.filled(12, 0x105) && blocks.filled(12, 0x207), "SetPixelClock: content revision 7")
    expect(blocks.filled(76, 0x106) && !blocks.filled(76, 0x105) && blocks.filled(4, 0x105) && !blocks.filled(4, 0x104), "the transmitter's 6, the encoder's 5")
    expect(blocks.filled(35, 0x101) && !blocks.filled(35, 0x102) && blocks.filled(49, 0x103) && !blocks.filled(49, 0x101) && !blocks.filled(49, 0x104), "the controller's 1, the timing's 3")
    expect(blocks.filled(46, 0x201) && !blocks.filled(46, 0x202) && !blocks.filled(13, 0x201) && !blocks.filled(12, 0), "the display engine's clock's 1; no other table")

    // The AVI info frame for the example (the document's U3): bd 1e 08
    // 80 | 00 00 00 00 | 58 04 00 00 | a1 0f 00 00, the bytes adding up
    // with the type 0x82, the version 2 and the length 13 to 0.
    {
        const t = example()
        const words = mode.aviFrame(&t)
        expect(words[0] == 0x80081EBD && words[1] == 0 && words[2] == 0x00000458 && words[3] == 0x00000FA1, "the AVI info frame's words")
        var total: usize = 0x82 + 2 + 13
        var k: usize = 0
        while k < 16 {
            total += (words[k / 4] >> @intCast(u6, (k % 4) * 8)) & 0xFF
            k += 1
        }
        expect(total & 0xFF == 0, "the AVI info frame adds up")
        const was = edid.Timing.{ .clock = 107960, .width = 1280, .hTotal = 1800, .hFront = 96, .hSync = 112, .hPositive = true, .height = 960, .vTotal = 1000, .vFront = 1, .vSync = 3, .vPositive = true, .interlaced = false, .stereo = false }
        const other = mode.aviFrame(&was)
        // (1001 lines is 0x3e9, 1801 pixels 0x709: the sum of bytes 1 to
        // 13 with the head's three is 0x91 + 0x1e + 0x08 + 0x80 + 0xe9 +
        // 0x03 + 0x09 + 0x07 = 0x233: the first byte is 0xcd.)
        expect(other[0] == 0x80081ECD && other[2] == 0x000003E9 && other[3] == 0x00000709, "the AVI info frame for 1800 by 1000")
    }
    // The timing's words (the document's C3): 3999 and 1110, a line's
    // blanking from 3952 to 112, a frame's from 1108 to 28, pulses from 0
    // to 32 (high) and to 10 (low).
    {
        const t = example()
        const words = mode.timingWords(&t)
        expect(words.register[0] == 0x1B80 && words.value[0] == 3999 && words.register[4] == 0x1B87 && words.value[4] == 1110, "the totals less one")
        expect(words.register[1] == 0x1B81 && words.value[1] == ((112 << 16) | 3952) && words.register[5] == 0x1B8D && words.value[5] == ((28 << 16) | 1108), "the blankings")
        expect(words.register[2] == 0x1B82 && words.value[2] == (32 << 16) && words.register[6] == 0x1B8E && words.value[6] == (10 << 16) && words.register[3] == 0x1B83 && words.value[3] == 0 && words.register[7] == 0x1B8F && words.value[7] == 1, "the pulses")
    }

    // ---- What an EDID offers.
    // A base block and a CTA extension with the HDMI vendor's block
    // (address 1.0.0.0, deep colour of 30 and 36 bits, 300 MHz), the HDMI
    // Forum's block (600 MHz, the status and control channel), YCbCr
    // 4:4:4, and two more timings of the monitor's size (120 Hz at
    // 533.28 MHz, 30 Hz at 133.32 MHz).
    {
        baseBlock(1)
        const data = [_]u8{ 0x67, 0x03, 0x0C, 0x00, 0x10, 0x00, 0x30, 0x3C, 0x67, 0xD8, 0x5D, 0xC4, 0x01, 0x78, 0x80, 0x00 }
        const more = [_]edid.Timing{ atClock(533280), atClock(133320) }
        ctaBlock(1, 0x20, data[0..], more[0..])
        const monitor = edid.read(blob[0..256])
        const offer = edid.offer(blob[0..256])
        expect(monitor.state == edid.State.found && monitor.width == 3840 && monitor.ofOwnSize == 3 && monitor.timing.clock == 266640, "the EDID's own timing: the least demanding of three")
        expect(offer.count == 3 && offer.timings[0].clock == 266640 && offer.timings[1].clock == 533280 && offer.timings[2].clock == 133320, "every timing of the own size")
        expect(offer.hdmi && offer.limit == 300000 && offer.deep && offer.ycbcr && offer.forumLimit == 600000 && offer.scdc && offer.extensions == 1 && offer.given == 1, "what the data blocks say of HDMI")
        card.reset()
        edid.sayOffer(logWrite, &monitor, &offer)
        line("gpu: the monitor says it is an HDMI one, up to 300 MHz (600 MHz with scrambling, which is not built here); it offers YCbCr 4:4:4 and more than 8 bits a colour and is sent RGB at 8 bits\n")
        // The base block alone: nothing of HDMI is known, and one block
        // was not passed on.
        const alone = edid.offer(blob[0..128])
        expect(!alone.hdmi && alone.count == 1 && alone.extensions == 1 && alone.given == 0, "the base block alone")
        card.reset()
        edid.sayOffer(logWrite, &monitor, &alone)
        line("gpu: the monitor's EDID has no HDMI block: DVI signalling, 165 MHz at most\n")
        line("gpu: the monitor's EDID has 1 extension block, the loader passed on 0: what the others say is not known\n")
        // A vendor's block of another vendor, and an HDMI block too short
        // to be one (four bytes): no HDMI. An HDMI block of five bytes:
        // HDMI, no clock named.
        const other = [_]u8{ 0x65, 0x04, 0x0C, 0x00, 0x10, 0x00, 0x64, 0x03, 0x0C, 0x00, 0x10 }
        const nothing = [_]edid.Timing{}
        ctaBlock(1, 0, other[0..], nothing[0..])
        const none = edid.offer(blob[0..256])
        expect(!none.hdmi && none.limit == 0 && !none.ycbcr && none.count == 1, "no HDMI block: another vendor's, and one too short")
        const short = [_]u8{ 0x65, 0x03, 0x0C, 0x00, 0x10, 0x00 }
        ctaBlock(1, 0, short[0..], nothing[0..])
        const plain = edid.offer(blob[0..256])
        expect(plain.hdmi && plain.limit == 0 && !plain.deep, "an HDMI block of five bytes")
        card.reset()
        edid.sayOffer(logWrite, &monitor, &plain)
        line("gpu: the monitor says it is an HDMI one and names no highest clock\n")
        // A data block that says it is longer than the room the data
        // blocks have (the HDMI block's five bytes, three of them there):
        // nothing is read beyond that room.
        const cut = [_]u8{ 0x65, 0x03, 0x0C, 0x00 }
        ctaBlock(1, 0, cut[0..], nothing[0..])
        expect(!edid.offer(blob[0..256]).hdmi, "a data block cut off by the end of the data blocks")
        // A CTA extension of revision 2 has no data blocks to read; one
        // whose bytes do not add up is left out.
        ctaBlock(1, 0, data[0..], nothing[0..])
        blob[128 + 1] = 2
        sum(1)
        expect(!edid.offer(blob[0..256]).hdmi, "a CTA extension of revision 2")
        blob[128 + 1] = 3
        expect(!edid.offer(blob[0..256]).hdmi, "an extension block that does not add up")
        // Two extension blocks, the HDMI block in the second: read when
        // both are there.
        baseBlock(2)
        ctaBlock(1, 0, other[0..0], more[0..1])
        ctaBlock(2, 0, data[0..], more[1..2])
        const both = edid.offer(blob[0..384])
        expect(both.hdmi && both.limit == 300000 && both.count == 3 && both.extensions == 2 && both.given == 2, "two extension blocks")
        const first = edid.offer(blob[0..256])
        expect(!first.hdmi && first.count == 2 && first.extensions == 2 && first.given == 1, "two extension blocks, one passed on")
        expect(edid.read(blob[0..384]).ofOwnSize == 3 && edid.read(blob[0..256]).ofOwnSize == 2, "the timings of both extension blocks")
    }

    // ---- The ROM's facts a plan rests on.
    open()
    expect(board.connectors[0].hotPlug == 4 && board.connectors[0].hotPlugLine == 2 && !board.connectors[0].fastHdmi && information.generator == 3600000, "the hot plug line by the board's table of pins; no capability record")
    // A capability record that allows HDMI at 300 MHz and more for the
    // first encoder (bit 2 of its word), and one that does not.
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    builder.capability(0, 0x0006)
    builder.capability(1, 0x0003)
    builder.finish()
    read()
    expect(board.connectors[0].fastHdmi && !board.connectors[1].fastHdmi && !board.connectors[2].fastHdmi, "the encoder's capability record")
    // The table of pins in another content revision than Linux's display
    // core reads; a pin on another register; a bit that is none of the
    // six; a pin the table does not have: the line is not known.
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    {
        const ids = [_]usize{ 4, 1, 6 }
        const registers = [_]usize{ 0x488D, 0x488E, 0x488D }
        const shifts = [_]usize{ 8, 0, 4 }
        _ = builder.pins(1, ids[0..2], registers[0..2], shifts[0..2])
        builder.finish()
        read()
        expect(board.connectors[0].hotPlugLine == 2 && board.connectors[1].hotPlugLine == videorom.NONE && board.connectors[2].hotPlugLine == videorom.NONE, "a pin on another register, a pin not in the table")
        _ = builder.pins(1, ids[0..], registers[0..], shifts[0..])
        builder.finish()
        read()
        expect(board.connectors[2].hotPlugLine == videorom.NONE, "a bit that is none of the six lines'")
        _ = builder.pins(2, ids[0..], registers[0..], shifts[0..])
        builder.finish()
        read()
        expect(board.connectors[0].hotPlugLine == videorom.NONE, "the table of pins in content revision 2")
    }
    expect(videorom.lineOf(&machine, 4) == videorom.NONE, "the line asked for by itself")

    // ---- The timing and the signalling chosen (the usual ROM).
    open()
    // The usual case: 266640 kHz is more than a DVI link carries: HDMI.
    begin("the monitor's own timing by HDMI")
    usual()
    expect(plan.complete && plan.tmds.hdmi && !plan.tmds.another && plan.timing.clock == 266640 && plan.tmds.limit == 299999 && plan.tmds.limitKind == mode.Limit.slow && plan.tmds.strapsAllow, "266640 kHz: HDMI below 300 MHz")
    // A clock a DVI link carries, the firmware sends DVI: DVI is kept,
    // HDMI monitor or not; 165 MHz is such a clock, 165010 kHz is not.
    begin("a clock a DVI link carries")
    {
        var monitor = wide()
        monitor.timing = atClock(148500)
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && !plan.tmds.hdmi && plan.timing.clock == 148500, "148500 kHz with the firmware in DVI mode: DVI")
        line("gpu: plan (b, TMDS): DVI signalling at 148500 kHz (now DVI at 107960 kHz), ")
        noLine("the AVI info frame")
        monitor.timing = atClock(165000)
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && !plan.tmds.hdmi, "165000 kHz: DVI")
        monitor.timing = atClock(165010)
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.hdmi, "165010 kHz: HDMI")
        // A frame's pulse and front porch of three lines together: the
        // rows are asked for three lines early, without the prefetch
        // (enable_advanced_request); four lines: four early, with it.
        monitor.timing = atClock(148500)
        monitor.timing.vFront = 1
        monitor.timing.vSync = 2
        make(&monitor, &offer, mode.Wish.own)
        line("gpu: would set 1bb3 & 000ff107 = 00003003 (when the rows are asked for)\n")
        monitor.timing.vSync = 3
        make(&monitor, &offer, mode.Wish.own)
        line("gpu: would set 1bb3 & 000ff107 = 00004007 (when the rows are asked for)\n")
    }
    // The clock the way back asks for is the measured one in whole 10
    // kHz, the nearest: 107968 kHz is asked for as 107970.
    card.reset()
    card.firmware(0, 4, 4, false, 2, 107968)
    usual()
    expect(plan.complete && plan.tmds.clockBack == 107970, "the way back's clock: the nearest whole 10 kHz")
    line("gpu: on the way back would run SetPixelClock with 94 79 10 00 18 21 02 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set for the firmware's clock)\n")
    // The same when the firmware sends HDMI and the monitor is an HDMI
    // one: HDMI; and DVI when its EDID has no HDMI block (Linux's "HDMI-
    // DVI dongle").
    card.reset()
    card.firmware(0, 4, 4, true, 2, 107962)
    {
        var monitor = wide()
        monitor.timing = atClock(148500)
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.hdmi && plan.tmds.hdmiNow, "148500 kHz with the firmware in HDMI mode: HDMI")
        const none = edid.nothing()
        make(&monitor, &none, mode.Wish.own)
        expect(plan.complete && !plan.tmds.hdmi && plan.tmds.hdmiNow && plan.tmds.limit == 165000, "no HDMI block: DVI, though the firmware sends HDMI")
        line("gpu: plan (b, TMDS): DVI signalling at 148500 kHz (now HDMI at 107960 kHz), ")
    }
    // The monitor's own timing is more than the link carries (120 Hz at
    // 533280 kHz): of its other timings of that size the lowest rate of
    // 50 Hz or more that fits; when none of 50 Hz fits, the highest that
    // does.
    begin("another timing of the monitor's size")
    {
        var monitor = wide()
        monitor.timing = atClock(533280)
        var offer = hdmiMonitor()
        offer.count = 4
        offer.timings[0] = atClock(533280)
        offer.timings[1] = atClock(133320)
        offer.timings[2] = atClock(288860)
        offer.timings[3] = atClock(266640)
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.another && plan.timing.clock == 266640 && plan.tmds.ownClock == 533280 && plan.millihertz == 60000, "the lowest rate of 50 Hz or more that fits: 60 Hz")
        line("gpu: plan (b, TMDS): the monitor's own timing needs 533280 kHz, this output carries 299999 kHz at most (HDMI below 300 MHz: the card's ROM does not say more for this output): taken instead, of the same size, 3840x1080 at 60.00 Hz: pixel clock 266640 kHz, h 3840 4000 (front 48 sync 32 +), v 1080 1111 (front 3 sync 10 -)\n")
        line("gpu: would run SetPixelClock with a0 af 28 00 18 21 03 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
        offer.count = 3
        offer.timings[2] = atClock(88880)
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.another && plan.timing.clock == 133320 && plan.millihertz == 30000 && !plan.tmds.hdmi, "none of 50 Hz fits: the highest rate that does, by DVI")
        // None fits at all.
        offer.count = 1
        make(&monitor, &offer, mode.Wish.own)
        refused("no timing fits the link", mode.Missing.no_timing_fits, "gpu: plan (b, TMDS): nothing would be set: no timing of the monitor's size fits the link: the monitor's own needs 533280 kHz, this output carries 299999 kHz at most (HDMI below 300 MHz: the card's ROM does not say more for this output)\n")
    }
    // Without the HDMI block a DVI link's 165 MHz is the limit; so it is
    // when the card's straps do not allow HDMI (the HDMI strap set; the
    // audio pins' bit clear).
    begin("no HDMI block")
    {
        const monitor = wide()
        const none = edid.nothing()
        make(&monitor, &none, mode.Wish.own)
        refused("266640 kHz by DVI", mode.Missing.no_timing_fits, "this output carries 165000 kHz at most (DVI signalling on one link)\n")
    }
    begin("the HDMI strap")
    card.store(0x4819, 0x40)
    usual()
    refused("the HDMI strap set", mode.Missing.no_timing_fits, "this output carries 165000 kHz at most (DVI signalling on one link)\n")
    expect(!plan.tmds.strapsAllow, "the straps do not allow HDMI")
    line("gpu: this output carries 165000 kHz at most (DVI signalling on one link; the card's straps do not allow HDMI)\n")
    begin("the audio pins")
    card.store(0x4818, 0x4000)
    usual()
    expect(!plan.complete && plan.missing == mode.Missing.no_timing_fits && !plan.tmds.strapsAllow, "the audio pins' bit clear: no HDMI")
    // The monitor's own highest clock is a limit too (ours).
    begin("the monitor's own limit")
    {
        const monitor = wide()
        var offer = hdmiMonitor()
        offer.limit = 225000
        make(&monitor, &offer, mode.Wish.own)
        refused("above the monitor's own highest clock", mode.Missing.no_timing_fits, "this output carries 225000 kHz at most (the highest clock the monitor names for itself)\n")
        offer.limit = 300000
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.limit == 299999 && plan.tmds.limitKind == mode.Limit.slow, "a monitor that names 300 MHz: the ROM's limit is the lower")
        // (A clock that is the monitor's highest is one it takes.)
        offer.limit = 266640
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.limit == 266640 && plan.tmds.limitKind == mode.Limit.monitor, "the monitor's highest clock itself")
    }
    // 300 MHz and more only when the ROM's capability record says so, and
    // never 340 MHz (scrambling).
    begin("HDMI at 300 MHz and more")
    {
        var monitor = wide()
        monitor.timing = atClock(310000)
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
        expect(!plan.complete && plan.missing == mode.Missing.no_timing_fits && plan.detail[1] == 299999, "310 MHz without the ROM's word")
        card.makeRom(&builder, card.NEVER, card.Ending.plain)
        builder.capability(0, 0x0004)
        builder.finish()
        read()
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.hdmi && plan.tmds.limit == 339999 && plan.tmds.limitKind == mode.Limit.scrambling, "310 MHz with the ROM's word")
        // (310 MHz needs a display clock of 374325 kHz: the firmware's
        // 600 MHz is enough.)
        monitor.timing = atClock(339990)
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete, "339990 kHz: the last clock without scrambling")
        monitor.timing = atClock(340000)
        make(&monitor, &offer, mode.Wish.own)
        refused("340 MHz", mode.Missing.no_timing_fits, "this output carries 339999 kHz at most (HDMI below 340 MHz: from there on the signal is scrambled, which is not built)\n")
        monitor.timing = atClock(24990)
        make(&monitor, &offer, mode.Wish.own)
        expect(!plan.complete && plan.missing == mode.Missing.no_timing_fits, "below 25 MHz")
        open()
    }
    // A DVI connector sends DVI signalling whatever the monitor says of
    // HDMI (Linux gives such a connector no HDMI signal): 165 MHz at
    // most, so the wide monitor's 266640 kHz is not planned there.
    card.reset()
    if show { say("-- a DVI connector, an HDMI monitor\n") }
    card.firmware(2, 1, 3, false, 6, 108000)
    card.store(0x18C0, 2)
    usual()
    refused("a DVI connector, an HDMI monitor", mode.Missing.no_timing_fits, "this output carries 165000 kHz at most (DVI signalling on one link)\n")
    line("gpu: DIG 3 is UNIPHY D; the ROM puts a connector of the kind \"DVI-D (dual link)\" behind it, hot plug line 6 (the back end's own word names line 6; the line says a monitor is there)\n")
    // A DisplayPort connector that sends TMDS (an adapter): 165 MHz at
    // most, HDMI monitor or not.
    card.reset()
    card.firmware(0, 0, 0, false, 1, 107962)
    card.store(0x1898, 2)
    usual()
    refused("a DisplayPort connector's adapter", mode.Missing.no_timing_fits, "this output carries 165000 kHz at most (TMDS through a DisplayPort connector's adapter)\n")
    line("gpu: DIG 0 is UNIPHY A; the ROM puts a connector of the kind \"DisplayPort\" behind it, hot plug line 1 (the back end's own word names line 1; the line says a monitor is there)\n")
    {
        var monitor = wide()
        monitor.timing = atClock(148500)
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && !plan.tmds.hdmi && plan.tmds.limitKind == mode.Limit.adapter, "a DisplayPort connector's adapter: 148500 kHz by DVI")
        line("gpu: would run SetPixelClock with c8 a8 16 00 14 1e 02 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
        line("gpu: would run UNIPHYTransmitterControl with 00 01 02 04 02 3a 00 00 01 00 13 00 00 00 00 00 (the transmitter on)\n")
    }

    // ---- Every refusal.
    // No ROM.
    begin("no ROM")
    {
        const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
        const monitor = wide()
        const offer = hdmiMonitor()
        const none = mode.Rom.{ .machine = null, .board = null, .firmware = null }
        memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
        scanout.report(&out, &memory, &readout)
        mode.makeFor(&out, &readout, &memory, &monitor, &offer, &none, mode.Wish.own, &plan)
        mode.say(&out, &plan)
        mode.list(&out, &plan)
        card.forget()
        refused("no ROM", mode.Missing.no_rom, "gpu: plan (b, TMDS): nothing would be set: the card's video BIOS was not read or does not hold: its tables cannot be run\n")
    }
    // Each of the five tables missing; each in a revision no block is
    // filled for.
    {
        const names = [_][]const u8{ "UNIPHYTransmitterControl", "SetPixelClock", "DIGxEncoderControl", "EnableCRTC", "SetCRTC_UsingDTDTiming" }
        var k: usize = 0
        while k < 5 {
            const table = card.TABLES[k]
            card.makeRom(&builder, card.NEVER, card.Ending.plain)
            builder.poke16(rom.COMMANDS + 4 + 2 * table, 0)
            builder.resum()
            read()
            begin("a table that is not in the ROM")
            usual()
            refused("a table missing", mode.Missing.no_table, " is not in the card's ROM\n")
            expect(plan.detail[0] == table, "which table is missing")
            line(names[k])
            card.makeRom(&builder, card.NEVER, card.Ending.plain)
            builder.revise(table, 1, 2)
            builder.resum()
            read()
            begin("a table of another revision")
            usual()
            refused("a table of another revision", mode.Missing.table_revision, " is revision 1.2 in this ROM: what it is told is known here for content revision ")
            expect(plan.detail[0] == table && plan.detail[1] == 0x102, "which table and revision")
            k += 1
        }
        line("gpu: plan (b, TMDS): nothing would be set: table SetCRTC_UsingDTDTiming is revision 1.2 in this ROM: what it is told is known here for content revision 3 only\n")
    }
    // The display engine's clock's table is looked at only when the
    // clock has to be raised.
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    builder.revise(46, 2, 2)
    builder.resum()
    read()
    begin("SetDCEClock of another revision, not needed")
    usual()
    expect(plan.complete, "SetDCEClock of another revision: not needed, the plan is complete")
    begin("SetDCEClock of another revision, needed")
    card.store(0x124, 0x40)
    usual()
    refused("SetDCEClock of another revision, needed", mode.Missing.table_revision, "gpu: plan (b, TMDS): nothing would be set: table SetDCEClock is revision 2.2 in this ROM: what it is told is known here for content revision 1 only\n")
    open()

    // The back end's mode is neither DVI nor HDMI (LVDS); it sends two
    // links.
    begin("an LVDS output")
    card.store(0x4E47, 0x10011000)
    usual()
    refused("an LVDS output", mode.Missing.not_tmds, "gpu: plan (b, TMDS): nothing would be set: the back end's mode is 1: neither DVI nor HDMI signalling\n")
    begin("two links")
    card.store(0x4E47, 0x10021001)
    usual()
    refused("two DVI links", mode.Missing.two_links, "gpu: plan (b, TMDS): nothing would be set: the output runs two DVI links: one link only for now\n")
    // Back end 6 (UNIPHY G) has no PLL of its own.
    card.reset()
    card.firmware(0, 4, 6, false, 2, 107962)
    card.store(0x143, 4)
    card.pll[4] = 107962
    usual()
    refused("back end 6", mode.Missing.no_pll, "gpu: plan (b, TMDS): nothing would be set: DIG 6 has no PLL of its own for a TMDS clock\n")
    // No connector behind the back end in the ROM (UNIPHY C).
    card.reset()
    card.firmware(0, 4, 2, false, 2, 107962)
    usual()
    refused("no connector behind the back end", mode.Missing.no_connector, "gpu: plan (b, TMDS): nothing would be set: the ROM's object table names no one connector behind DIG 2\n")
    // The connector's own source is another encoder than its display
    // path's (the path's encoder changed to UNIPHY F's: the connector's
    // own source list still names E).
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    {
        const start = builder.peek16(rom.DATA + 4 + 2 * 22)
        const paths = start + builder.peek16(start + 14)
        builder.poke16(paths + 4 + 8, 0x2221)
        builder.resum()
    }
    read()
    card.reset()
    card.firmware(0, 4, 5, false, 2, 107962)
    usual()
    refused("a connector whose own source is another encoder", mode.Missing.no_connector, "the ROM's object table names no one connector behind DIG 5\n")
    // A connector of a kind no TMDS change is planned for (VGA).
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    objectWord(0x310C, 0x3105)
    read()
    begin("a VGA connector")
    usual()
    refused("a VGA connector", mode.Missing.connector_kind, "gpu: plan (b, TMDS): nothing would be set: the ROM puts a connector of the kind \"VGA\" behind DIG 4: no TMDS change is planned for that\n")
    // A hot plug pin the board's table of pins does not place.
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    {
        const ids = [_]usize{ 4 }
        const registers = [_]usize{ 0x488D }
        const shifts = [_]usize{ 12 }
        _ = builder.pins(1, ids[0..], registers[0..], shifts[0..])
        builder.finish()
    }
    read()
    begin("a hot plug pin that is none of the six lines")
    usual()
    refused("a hot plug pin not placed", mode.Missing.hot_plug_pin, "gpu: plan (b, TMDS): nothing would be set: the hot plug pin 4 the ROM names for this connector is none of the card's six lines\n")
    // A connector without a hot plug record at all: planned, the
    // transmitter told no line.
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    {
        // (The connector's first record is its hot plug record: its type
        // made one that is not looked for.)
        const start = builder.peek16(rom.DATA + 4 + 2 * 22)
        const connectors = start + builder.peek16(start + 6)
        const records = start + builder.peek16(connectors + 4 + 4)
        expect(builder.peek(records) == 2, "the connector's first record is its hot plug record")
        builder.poke(records, 9)
        builder.resum()
    }
    read()
    begin("no hot plug record")
    usual()
    expect(plan.complete && plan.tmds.line == 0, "no hot plug record: planned")
    line("gpu: DIG 4 is UNIPHY E; the ROM puts a connector of the kind \"HDMI\" behind it, without a hot plug line\n")
    line("gpu: would run UNIPHYTransmitterControl with 04 01 03 04 28 68 00 00 00 00 0c 00 00 00 00 00 (the transmitter on)\n")
    open()

    // The controller's clock is a DTO's; is another PLL's.
    begin("the clock is a DTO's")
    card.store(0x140, 0x10)
    usual()
    refused("the clock is a DTO's", mode.Missing.clock_source, "gpu: plan (b, TMDS): nothing would be set: the controller's pixel clock is not PLL 4's (words 0x10 0x4)\n")
    begin("the clock is another PLL's")
    card.store(0x143, 3)
    card.pll[3] = 107962
    usual()
    refused("the clock is another PLL's", mode.Missing.clock_source, "the controller's pixel clock is not PLL 4's (words 0x0 0x3)\n")
    begin("the clock is the other kind of PLL's")
    card.store(0x143, 0x14)
    usual()
    refused("the clock is the other kind of PLL's", mode.Missing.clock_source, "the controller's pixel clock is not PLL 4's (words 0x0 0x14)\n")
    // No frames counted: there would be no clock for the way back.
    begin("no frames counted")
    card.pll[4] = 0
    usual()
    refused("no frames counted", mode.Missing.no_frames, "gpu: plan (b, TMDS): nothing would be set: no frames were counted: there is nothing to hold a change against\n")
    // The firmware's pulses do not begin its counters; its blanking goes
    // around the counter's end; its timing has no line of front porch;
    // its clock is more than a DVI link carries.
    begin("the firmware's pulse elsewhere")
    card.store(0x1B82, (160 << 16) | 48)
    usual()
    refused("the firmware's pulse elsewhere", mode.Missing.sync_elsewhere, "the firmware's sync pulses do not begin the controller's counters: the timing's words would be guesses\n")
    begin("the firmware's blanking around the counter's end")
    card.store(0x1B81, (1380 << 16) | 860)
    usual()
    refused("a blanking around the counter's end", mode.Missing.no_way_back, "gpu: plan (b, TMDS): nothing would be set: the firmware's own timing or clock is not one the card's tables can be told: there would be no way back\n")
    // (And one that begins beyond the line's end: no timing to go back
    // to can be worked out, so there is no plan.)
    begin("the firmware's blanking beyond the line's end")
    card.store(0x1B81, (424 << 16) | 1900)
    usual()
    expect(!plan.complete && plan.count == 0 && plan.runs == 0, "a blanking that begins beyond the line's end: no plan")
    noLine("gpu: would ")
    begin("the firmware's timing without a front porch")
    card.store(0x1B8D, (40 << 16) | 1000)
    usual()
    refused("the firmware's timing without a front porch", mode.Missing.no_front_porch, "gpu: plan (b, TMDS): nothing would be set: a timing without a line of front porch: the table and the controller's own rule do not agree on it\n")
    card.reset()
    card.firmware(0, 4, 4, false, 2, 170000)
    usual()
    refused("a firmware clock no DVI link carries", mode.Missing.no_way_back, "there would be no way back\n")
    // The monitor's timing has no line of front porch; a line longer than
    // the controller counts.
    begin("a timing without a front porch")
    {
        var monitor = wide()
        monitor.timing.vFront = 0
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
        refused("a timing without a front porch", mode.Missing.no_front_porch, "a timing without a line of front porch")
        monitor = wide()
        monitor.timing.hTotal = 0x4001
        make(&monitor, &offer, mode.Wish.own)
        refused("a line of 16385 pixels", mode.Missing.too_large, "gpu: plan (b, TMDS): nothing would be set: the size is more than the controller's words hold\n")
    }
    // The formatter does not send RGB.
    begin("the formatter sends YCbCr")
    card.store(0x1BEE, 0x10000)
    usual()
    refused("a formatter that does not send RGB", mode.Missing.not_rgb, "gpu: plan (b, TMDS): nothing would be set: the formatter does not send RGB (control 0x10000)\n")
    // The display engine's clock: a divider's number that gives more
    // than the ROM's own figure (0x10: 3600 MHz over 4, 900 MHz), or
    // less than Linux ever sets (0x7f: over 128); too low, and what is
    // needed is more than the ROM's figure (339990 kHz needs 410537 kHz:
    // a ROM that says 400 MHz).
    begin("a display clock above the ROM's figure")
    card.store(0x124, 0x10)
    usual()
    refused("a display clock above the ROM's figure", mode.Missing.engine_clock_unknown, "gpu: plan (b, TMDS): nothing would be set: the display clock is not read with trust (the divider's word 0x10 gives 900000 kHz; the ROM's figures are 3600000 and 625000 kHz)\n")
    // (The firmware's own mode set again asks nothing new of the display
    // clock, which runs that mode now: planned whatever the divider
    // reads.)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.rehearsal)
        expect(plan.complete && plan.rehearsal && !plan.tmds.engineRaised && plan.runs == 7, "a rehearsal with a display clock that is not trusted")
    }
    // What the display clock has to be, in Linux's whole numbers: 1.05
    // times the pixel clock, cut, then 1.15 times that, cut (100010 kHz:
    // 105010, then 120761; in one step it would be 120762).
    begin("the display clock needed, in whole numbers")
    {
        var monitor = wide()
        monitor.timing = atClock(100010)
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.engineNeeded == 120761 && !plan.tmds.engineRaised, "1.05 times, then 1.15 times, each cut")
    }
    begin("a display clock below what Linux ever sets")
    card.store(0x124, 0x7F)
    usual()
    refused("a display clock of 28 MHz", mode.Missing.engine_clock_unknown, "(the divider's word 0x7f gives 28125 kHz; ")
    // (The numbers of the divider's four runs: 0x3f is 63 quarters, 0x40
    // 64, 0x5f 126, 0x60 128, 0x7d 244, 0x7e 248: 3600 MHz times four
    // over each.)
    {
        const numbers = [_]usize{ 0x3F, 0x40, 0x5F, 0x60, 0x7D, 0x7E, 0x08, 0x00 }
        const clocks = [_]usize{ 228571, 225000, 114285, 112500, 59016, 58064, 1800000, 1800000 }
        var k: usize = 0
        while k < 8 {
            begin("the divider's numbers")
            card.store(0x124, numbers[k])
            usual()
            expect(plan.tmds.engine == clocks[k], "a divider's number")
            k += 1
        }
    }
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    {
        const start = builder.peek16(rom.DATA + 4 + 2 * 4)
        builder.poke32(start + 40, 40000)
        builder.capability(0, 0x0004)
        builder.finish()
    }
    read()
    begin("a display clock that cannot be raised far enough")
    card.store(0x124, 0x40)
    {
        var monitor = wide()
        monitor.timing = atClock(339990)
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
        refused("a display clock that cannot be raised far enough", mode.Missing.engine_clock_low, "gpu: plan (b, TMDS): nothing would be set: the display clock would have to be 410537 kHz, more than the ROM's own figure of 400000 kHz\n")
        // The usual timing's 321967 kHz may be asked for.
        monitor = wide()
        make(&monitor, &offer, mode.Wish.own)
        expect(plan.complete && plan.tmds.engineRaised && plan.tmds.engineAsked == 321967, "a display clock that may be raised")
    }
    // A display clock that is the ROM's own figure exactly is trusted
    // (a ROM that says 600 MHz).
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    {
        const start = builder.peek16(rom.DATA + 4 + 2 * 4)
        builder.poke32(start + 40, 60000)
        builder.resum()
    }
    read()
    begin("a display clock that is the ROM's figure")
    usual()
    expect(plan.complete && plan.tmds.engine == 600000 && plan.tmds.engineDefault == 600000 && !plan.tmds.engineRaised, "a display clock that is the ROM's own figure")
    // A ROM that does not say what its clock generator gives: Linux's
    // 3600 MHz is taken.
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    builder.generator(0)
    builder.resum()
    read()
    begin("no clock generator's figure in the ROM")
    usual()
    expect(plan.complete && plan.tmds.generator == 3600000 && plan.tmds.engine == 600000, "the generator's 3600 MHz when the ROM does not say")
    open()

    // Nothing to rehearse on a DisplayPort output; and a rehearsal needs
    // the ROM like any plan of the tables'.
    begin("a rehearsal on DisplayPort")
    card.store(0x4E47, 0x10001000)
    card.store(0x4EA3, 3)
    card.store(0x4EA0, 0x10)
    card.store(0x4EA4, 0x10001)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.rehearsal)
        expect(plan.situation == mode.Situation.none && !plan.complete && plan.missing == mode.Missing.no_rehearsal && plan.rehearsal, "nothing to rehearse on DisplayPort")
        line("gpu: plan: nothing to set (there is nothing to rehearse: the picture does not leave by a TMDS output)\n")
    }
    // A rehearsal is planned whatever the monitor says of itself (it is
    // sent what it is sent now).
    begin("a rehearsal without an EDID")
    {
        var monitor = wide()
        monitor.state = edid.State.none
        monitor.width = 0
        monitor.height = 0
        const none = edid.nothing()
        make(&monitor, &none, mode.Wish.rehearsal)
        expect(plan.complete && plan.rehearsal && !plan.tmds.hdmi && plan.timing.clock == 107960 && plan.timing.width == 1280 && plan.millihertz == plan.tmds.wasMillihertz, "a rehearsal without an EDID")
        // And without one the monitor's own mode is nothing to plan.
        make(&monitor, &none, mode.Wish.own)
        expect(plan.situation == mode.Situation.none && plan.missing == mode.Missing.no_monitor, "no EDID: nothing to go to")
    }

    // A machine with two adapters. The firmware's picture is the other
    // adapter's (the board's own, say) while this card's HDMI output runs
    // all the same: there is no picture of the kernel's here to replace
    // and no monitor whose timing is known to be this output's, so
    // nothing is planned, the rehearsal neither.
    begin("the picture is another adapter's")
    elsewhere = true
    nothingFor("another adapter's picture", mode.Wish.own, mode.Missing.elsewhere, "gpu: plan: nothing to set (the picture the kernel draws on is not this card's)\n")
    nothingFor("another adapter's picture, the rehearsal", mode.Wish.rehearsal, mode.Missing.elsewhere, "gpu: plan: nothing to set (the picture the kernel draws on is not this card's)\n")
    elsewhere = false
    // And a card the firmware has not started (no controller runs, every
    // word of the display reads nothing; the picture is the other
    // adapter's then, or there is none): the read-out says that every
    // controller is off, and nothing is planned, the rehearsal neither.
    card.reset()
    if show { say("-- a card the firmware has not started\n") }
    elsewhere = true
    nothingFor("a card that is not started", mode.Wish.own, mode.Missing.elsewhere, "gpu: plan: nothing to set (the picture the kernel draws on is not this card's)\n")
    line("gpu: controllers off: 0 1 2 3 4 5\n")
    nothingFor("a card that is not started, the rehearsal", mode.Wish.rehearsal, mode.Missing.elsewhere, "gpu: plan: nothing to set (the picture the kernel draws on is not this card's)\n")
    elsewhere = false
    // (Were the kernel's picture said to be in the memory of a card on
    // which no controller runs, the two would not fit together: no plan
    // either.)
    nothingFor("no controller on, yet a picture here", mode.Wish.own, mode.Missing.not_plausible, "gpu: plan: nothing to set (the read-out is not plausible)\n")
    nothingFor("no controller on, yet a picture here, the rehearsal", mode.Wish.rehearsal, mode.Missing.not_plausible, "gpu: plan: nothing to set (the read-out is not plausible)\n")

    if failed != 0 { return failed }
    return 13
}
