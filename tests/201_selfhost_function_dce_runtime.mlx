const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../compiler/selfhost/ir/optimize.mlx")

fn addReturn(ir: *lir.Lir, value: usize) -> usize {
    const constant = lir.addInst(ir, lir.constI(lir.NONE, value))
    return lir.addInst(ir, lir.retInst(lir.NONE, constant))
}

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    var ir = lir.init(allocator)
    var main_pointer: [*]const u8 = undefined
    var direct_pointer: [*]const u8 = undefined
    var callback_pointer: [*]const u8 = undefined
    var unused_pointer: [*]const u8 = undefined
    unsafe {
        main_pointer = @ptrCast([*]const u8, "main")
        direct_pointer = @ptrCast([*]const u8, "direct")
        callback_pointer = @ptrCast([*]const u8, "callback")
        unused_pointer = @ptrCast([*]const u8, "unused")
    }
    const main_symbol = lir.addSymbol(&ir, main_pointer, 4)
    const direct_symbol = lir.addSymbol(&ir, direct_pointer, 6)
    const callback_symbol = lir.addSymbol(&ir, callback_pointer, 8)
    const unused_symbol = lir.addSymbol(&ir, unused_pointer, 6)

    const main_label = lir.addInst(&ir, lir.labelInst(lir.NONE, main_symbol))
    const callback_value = lir.addInst(&ir, lir.initInst(lir.Opcode.func_sym, lir.NONE))
    var callback = lir.getInst(&ir, callback_value)
    callback.arg0 = callback_symbol
    lir.setInst(&ir, callback_value, callback)
    const called = lir.addInst(&ir, lir.directCallInst(lir.NONE, direct_symbol, 0, 0))
    const main_return = lir.addInst(&ir, lir.retInst(lir.NONE, called))

    const direct_label = lir.addInst(&ir, lir.labelInst(lir.NONE, direct_symbol))
    const direct_return = addReturn(&ir, 13)
    const callback_label = lir.addInst(&ir, lir.labelInst(lir.NONE, callback_symbol))
    const callback_return = addReturn(&ir, 21)
    const unused_label = lir.addInst(&ir, lir.labelInst(lir.NONE, unused_symbol))
    const unused_return = addReturn(&ir, 99)

    const result = optimize.run(&ir, allocator)
    if result.functionsEliminated != 1 || result.functionInstructionsEliminated != 3 { return 1 }
    if lir.getInst(&ir, main_label).opcode == lir.Opcode.dead || lir.getInst(&ir, main_return).opcode == lir.Opcode.dead { return 2 }
    if lir.getInst(&ir, direct_label).opcode == lir.Opcode.dead || lir.getInst(&ir, direct_return).opcode == lir.Opcode.dead { return 3 }
    if lir.getInst(&ir, callback_label).opcode == lir.Opcode.dead || lir.getInst(&ir, callback_return).opcode == lir.Opcode.dead { return 4 }
    if lir.getInst(&ir, unused_label).opcode != lir.Opcode.dead || lir.getInst(&ir, unused_return).opcode != lir.Opcode.dead { return 5 }
    lir.deinit(&ir)
    return 13
}
