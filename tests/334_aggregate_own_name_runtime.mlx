// A struct or enum named by its binding inside its own body: a field
// pointing to another of its kind, methods taking and returning it by that
// name, as by `Self`. Before, the body's signatures did not resolve and the
// compile failed with only "declaration type could not be resolved" at the
// top of the file. Exits 13.
const Counter = struct {
    total: usize
    next: ?*Counter

    pub fn make(start: usize) -> Counter {
        return Counter.{ .total = start, .next = null }
    }

    pub fn add(self: *Counter, amount: usize) -> void {
        self.*.total += amount
    }

    pub fn chain(self: *Counter, other: *Counter) -> usize {
        self.*.next = other
        return self.*.total + other.*.total
    }
}

const Color = enum(u8) {
    red, green

    pub fn flip(self: Color) -> Color {
        if self == Color.red { return Color.green }
        return Color.red
    }
}

pub fn main() -> u8 {
    var first = Counter.make(3)
    var second = Counter.make(4)
    first.add(1)
    if first.chain(&second) != 8 { return 1 }
    if first.next.?.*.total != 4 { return 2 }
    if Color.red.flip() != Color.green { return 3 }
    return 13
}
