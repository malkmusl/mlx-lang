// The Files UI has one responsive layout contract for Wayland and Android:
// wide desktops keep an expandable sidebar/icon rail, compact and phone
// layouts expose it as an overlay drawer, and every mode keeps Search and a
// sidebar toggle reachable. Android density scales sizes without changing
// the logical breakpoint. Safe insets and list/grid placement are shared.
// Exits 13.
const ui = @import("std.ui")
const files_ui = @import("../projects/filemanager-shared/ui.mlx")

fn same(area: ui.Rect, x: i32, y: i32, width: i32, height: i32) -> bool {
    return area.x == x && area.y == y && area.width == width && area.height == height
}

pub fn main() -> u8 {
    const wide = files_ui.layout(940, 580, ui.uniform(0), true, 1)
    if wide.mode != files_ui.Mode.wide { return 1 }
    if !same(wide.sidebar, 0, 0, 200, 580) { return 2 }
    if !same(wide.toolbar, 200, 0, 740, 52) || !same(wide.listHeader, 200, 52, 740, 28) { return 3 }
    if !same(wide.content, 200, 80, 740, 470) || !same(wide.status, 200, 550, 740, 30) { return 4 }
    if !same(wide.backButton, 212, 11, 30, 30) || !same(wide.forwardButton, 246, 11, 30, 30) { return 5 }
    if !same(wide.search, 736, 11, 190, 30) || !same(wide.sidebarButton, 156, 11, 30, 30) { return 6 }
    if !same(wide.gridButton, 664, 11, 30, 30) || !same(wide.listButton, 694, 11, 30, 30) { return 20 }
    if files_ui.columns(&wide) != 6 || files_ui.cellWidth(&wide) != 118 { return 7 }

    const rail = files_ui.layoutWithSidebar(940, 580, ui.uniform(0), true, 1, false, false)
    if rail.mode != files_ui.Mode.wide || rail.sidebarOpen || rail.sidebarOverlay { return 21 }
    if !same(rail.sidebar, 0, 0, 56, 580) || !same(rail.sidebarButton, 12, 11, 30, 30) || !same(rail.content, 56, 80, 884, 470) { return 22 }

    const compact = files_ui.layout(560, 340, ui.uniform(0), true, 1)
    if compact.mode != files_ui.Mode.compact || !ui.isEmpty(compact.sidebar) { return 8 }
    if !same(compact.toolbar, 0, 0, 560, 52) || !same(compact.listHeader, 0, 52, 560, 28) { return 9 }
    if !same(compact.content, 0, 80, 560, 230) || !same(compact.status, 0, 310, 560, 30) { return 10 }
    if !same(compact.sidebarButton, 12, 11, 30, 30) || !same(compact.backButton, 46, 11, 30, 30) || !same(compact.forwardButton, 80, 11, 30, 30) { return 23 }

    const compact_drawer = files_ui.layoutWithSidebar(560, 340, ui.uniform(0), true, 1, true, true)
    if !compact_drawer.sidebarOpen || !compact_drawer.sidebarOverlay { return 24 }
    if !same(compact_drawer.sidebar, 0, 0, 280, 340) || !same(compact_drawer.sidebarButton, 236, 11, 30, 30) || !same(compact_drawer.content, compact.content.x, compact.content.y, compact.content.width, compact.content.height) { return 25 }

    const safe = ui.insets(24, 16, 30, 16)
    const phone = files_ui.layout(360, 640, safe, true, 1)
    if phone.mode != files_ui.Mode.phone || !ui.isEmpty(phone.sidebar) || !ui.isEmpty(phone.listHeader) { return 11 }
    if !same(phone.toolbar, 16, 24, 328, 104) || !same(phone.content, 16, 128, 328, 446) || !same(phone.status, 16, 574, 328, 36) { return 12 }
    if !same(phone.search, 28, 84, 304, 40) || !same(phone.sidebarButton, 26, 32, 40, 40) { return 26 }
    if !same(phone.backButton, 70, 32, 40, 40) || !same(phone.forwardButton, 114, 32, 40, 40) { return 29 }
    if !same(files_ui.itemRect(&phone, 2, 10, true), 16, 222, 328, 52) { return 14 }
    if files_ui.columns(&phone) != 2 || !same(files_ui.itemRect(&phone, 3, 10, false), 180, 246, 152, 116) { return 15 }

    const phone_drawer = files_ui.layoutWithSidebar(360, 640, safe, true, 1, true, true)
    if !phone_drawer.sidebarOpen || !phone_drawer.sidebarOverlay { return 27 }
    if !same(phone_drawer.sidebar, 16, 24, 264, 586) || !same(phone_drawer.sidebarButton, 228, 32, 40, 40) || !same(phone_drawer.content, phone.content.x, phone.content.y, phone.content.width, phone.content.height) { return 28 }

    // A 2x-density phone keeps the phone breakpoint in logical pixels while
    // all touch and content metrics are doubled.
    const dense = files_ui.layout(720, 1280, ui.insets(48, 0, 60, 0), true, 2)
    if dense.mode != files_ui.Mode.phone || dense.toolbar.height != 208 || dense.rowHeight != 104 || dense.buttonSize != 80 { return 16 }
    if !same(dense.search, 24, 168, 672, 80) || !same(dense.content, 0, 256, 720, 892) || !same(dense.status, 0, 1148, 720, 72) { return 17 }

    // Even the tiny framebuffer used by the Android runtime harness must
    // yield clipped, non-negative regions instead of overlapping arithmetic.
    const tiny = files_ui.layout(48, 32, ui.insets(2, 2, 2, 2), true, 1)
    if tiny.content.width < 0 || tiny.content.height < 0 || tiny.toolbar.width < 0 || tiny.status.height < 0 { return 18 }
    if files_ui.density(1080, 2400) != 3 || files_ui.density(720, 1280) != 2 || files_ui.density(360, 640) != 1 { return 19 }
    return 13
}
