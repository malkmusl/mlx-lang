// The shared desktop canvas can target Android's padded RGBA_8888 buffers:
// rows use the supplied stride and logical ARGB colours swap red/blue only at
// the framebuffer edge. Padding must never be overwritten. Exits 13.
const canvas_module = @import("../examples/desktop-shared/canvas.mlx")

pub fn main() -> u8 {
    const untouched: u32 = 287454020
    var pixels: [6]u32 = [6]u32{ untouched, untouched, untouched, untouched, untouched, untouched }
    var address: [*]u32 = undefined
    unsafe { address = @ptrCast([*]u32, &pixels) }
    var canvas = canvas_module.Canvas.{
        .pixels = address,
        .width = 2,
        .height = 2,
        .stride = 3,
        .swapRedBlue = true,
        .device = 0,
    }

    canvas_module.clear(&canvas, 4294901760) // logical opaque red
    if pixels[0] != 4278190335 || pixels[1] != 4278190335 { return 1 } // RGBA memory word
    if pixels[3] != 4278190335 || pixels[4] != 4278190335 { return 2 }
    if pixels[2] != untouched || pixels[5] != untouched { return 3 }

    canvas_module.fillRect(&canvas, 1, 1, 1, 1, 4278190335) // logical opaque blue
    if pixels[4] != 4294901760 { return 4 }
    if pixels[0] != 4278190335 || pixels[2] != untouched || pixels[5] != untouched { return 5 }
    return 13
}
