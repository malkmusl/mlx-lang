// Module-level optionals given a value in their declarations: the payload's
// bytes and then the tag byte, 1, written into the program's data (a null
// or `undefined` one stays zeroed: absent). A `?f64` or a `?f32` holding
// 0.0 or -0.0, an optional struct whose fields are zero, and such
// optionals as array elements and struct fields, beside the integers and
// bools (which were written this way before). The float and struct ones
// had no lowering and were refused (MLX-E9001); an optional float is
// tagged now (tests/488_optional_zero_values_runtime.mlx), so its zero is
// not its null. Read, compared with null, unwrapped, assigned null and
// zero again. Exits 13 when every check holds, else the number of the
// first check that failed.
const SIGN: u64 = 9223372036854775808

const Zero = struct {
    count: u32
    ratio: f64
    on: bool
}

const Holder = struct {
    single: ?f32
    double: ?f64
    zero: ?Zero
    byte: ?u8
}

var double: ?f64 = 0.0
var negative: ?f64 = -0.0
var single: ?f32 = 0.0
var half: ?f32 = 0.5
var none: ?f64 = null
var unset: ?f32 = undefined
var zero: ?Zero = Zero.{ .count = 0, .ratio = 0.0, .on = false }
var no_zero: ?Zero = null
var byte: ?u8 = 0
var flag: ?bool = false
var doubles = [3]?f64{ 0.0, null, -0.0 }
var holder = Holder.{ .single = 0.0, .double = null, .zero = Zero.{ .count = 0, .ratio = 0.0, .on = false }, .byte = 0 }

fn absent(value: ?f64) -> bool { return value == null }

fn main() -> u8 {
    if double == null || @bitCast(u64, double.?) != 0 { return 1 }
    if negative == null || @bitCast(u64, negative.?) != SIGN { return 2 }
    if single == null || @bitCast(u32, single.?) != 0 { return 3 }
    if half == null || half.? != 0.5 { return 4 }
    if none != null || !absent(none) || absent(double) { return 5 }
    if zero == null || zero.?.count != 0 || @bitCast(u64, zero.?.ratio) != 0 || zero.?.on { return 6 }
    if no_zero != null { return 7 }
    if byte == null || byte.? != 0 || flag == null || flag.? { return 8 }
    if doubles[0] == null || doubles[1] != null || doubles[2] == null || @bitCast(u64, doubles[2].?) != SIGN { return 9 }
    if holder.single == null || holder.double != null || holder.zero == null || holder.zero.?.count != 0 || holder.byte == null { return 10 }
    // The bytes: eight zero bytes, then the tag.
    unsafe {
        const view = @ptrCast([*]u8, &double)
        if view[0] != 0 || view[7] != 0 || view[8] != 1 { return 11 }
        const sign = @ptrCast([*]u8, &negative)
        if sign[7] != 128 || sign[8] != 1 { return 12 }
        const none_view = @ptrCast([*]u8, &none)
        if none_view[8] != 0 { return 14 }
    }
    // Assigned null and zero again.
    double = null
    none = 0.0
    if double != null || none == null || @bitCast(u64, none.?) != 0 { return 15 }
    single = null
    unset = 0.0
    if single != null || unset == null || @bitCast(u32, unset.?) != 0 { return 16 }
    zero = null
    no_zero = Zero.{ .count = 0, .ratio = 0.0, .on = false }
    if zero != null || no_zero == null || no_zero.?.count != 0 { return 17 }
    doubles[1] = 0.0
    doubles[0] = null
    if doubles[0] != null || doubles[1] == null || @bitCast(u64, doubles[1].?) != 0 { return 18 }
    holder.double = -0.0
    holder.single = null
    if holder.double == null || @bitCast(u64, holder.double.?) != SIGN || holder.single != null { return 19 }
    return 13
}
