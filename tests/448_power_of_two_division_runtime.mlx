    return true
}

fn checkUsize() -> bool {
    var n: usize = 0
    while n < 64 {
        const d = @intCast(usize, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(usize, edge(e, n, 64))
            const written = constantUsize(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x || written.1 >= d { return false }
            e += 1
        }
        n += 1
    }
    return true
}

// (The remainder is 0 or has the dividend's sign, and is nearer to 0 than
// the divisor.)
fn checkI8() -> bool {
    var n: usize = 0
    while n < 7 {
        const d = @intCast(i8, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i8, @intCast(u8, edge(e, n, 8)))
            const written = constantI8(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x { return false }
            if x >= 0 && (written.1 < 0 || written.1 >= d) { return false }
            if x < 0 && (written.1 > 0 || written.1 <= 0 - d) { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkI16() -> bool {
    var n: usize = 0
    while n < 15 {
        const d = @intCast(i16, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i16, @intCast(u16, edge(e, n, 16)))
            const written = constantI16(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x { return false }
            if x >= 0 && (written.1 < 0 || written.1 >= d) { return false }
            if x < 0 && (written.1 > 0 || written.1 <= 0 - d) { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkI32() -> bool {
    var n: usize = 0
    while n < 31 {
        const d = @intCast(i32, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i32, @intCast(u32, edge(e, n, 32)))
            const written = constantI32(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x { return false }
            if x >= 0 && (written.1 < 0 || written.1 >= d) { return false }
            if x < 0 && (written.1 > 0 || written.1 <= 0 - d) { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkI64() -> bool {
    var n: usize = 0
    while n < 63 {
        const d = @intCast(i64, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i64, @intCast(u64, edge(e, n, 64)))
            const written = constantI64(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x { return false }
            if x >= 0 && (written.1 < 0 || written.1 >= d) { return false }
            if x < 0 && (written.1 > 0 || written.1 <= 0 - d) { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkIsize() -> bool {
    var n: usize = 0
    while n < 63 {
        const d = @intCast(isize, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(isize, @intCast(usize, edge(e, n, 64)))
            const written = constantIsize(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x { return false }
            if x >= 0 && (written.1 < 0 || written.1 >= d) { return false }
            if x < 0 && (written.1 > 0 || written.1 <= 0 - d) { return false }
            e += 1
        }
        n += 1
    }
    return true
}

// Signed quotients and remainders by their values: toward zero, the
// remainder with the dividend's sign.
var seven: i32 = 7 // (per run)
// The lowest i64 has the bits of 2^63 and is no power of two: a division by
// it stays one.
const LOWEST: i64 = -9223372036854775807 - 1

fn signedValues() -> bool {
    const minus = 0 - seven
    const lowest = @bitCast(i64, power(63))
    if minus / 2 != -3 || minus % 2 != -1 { return false }
    if minus / 4 != -1 || minus % 4 != -3 { return false }
    if minus / 8 != 0 || minus % 8 != -7 { return false }
    if seven / 2 != 3 || seven % 2 != 1 { return false }
    if (minus - 1) / 8 != -1 || (minus - 1) % 8 != 0 { return false }
    if (minus - 2) / 8 != -1 || (minus - 2) % 8 != -1 { return false }
    if minus / 1 != -7 || minus % 1 != 0 { return false }
    const byte: i8 = @intCast(i8, minus) - 121
    if byte / 64 != -2 || byte % 64 != 0 || byte / 2 != -64 || (byte + 1) / 2 != -63 || (byte + 1) % 2 != -1 { return false }
    if lowest / 2 != -4611686018427387904 || lowest % 2 != 0 { return false }
    if lowest / 0x4000000000000000 != -2 || lowest % 0x4000000000000000 != 0 { return false }
    if (lowest + 1) / 0x4000000000000000 != -1 || (lowest + 1) % 0x4000000000000000 != -4611686018427387903 { return false }
    if lowest / LOWEST != 1 || lowest % LOWEST != 0 || (lowest + 1) / LOWEST != 0 || (lowest + 1) % LOWEST != lowest + 1 { return false }
    if @intCast(i64, minus) / LOWEST != 0 || @intCast(i64, minus) % LOWEST != -7 || @intCast(i64, seven) % LOWEST != 7 { return false }
    return true
}

// The forms the divisions are written in.
const PAGE: usize = 4096
const SECTOR: u32 = 512

fn pagesOf(bytes: usize) -> usize { return (bytes + PAGE - 1) / PAGE }

fn forms() -> bool {
    // A loop's bound, divided on every turn.
    const length = @intCast(usize, power(10)) + 5
    var k: usize = 0
    var turns: usize = 0
    while k < length / 8 {
        turns += 1
        k += 1
    }
    if turns != 128 { return false }
    // Compound assignments, a local's in its register.
    var value: u32 = @intCast(u32, power(20)) + 4097
    value /= 4096
    if value != 257 { return false }
    value %= 16
    if value != 1 { return false }
    var signed: i32 = 0 - @intCast(i32, power(12)) - 3
    signed /= 4
    if signed != -1024 { return false }
    signed %= 1024
    if signed != 0 { return false }
    var sum: usize = 0
    var i: usize = 0
    while i < 100 {
        sum += (i * 37) / 16 + (i * 37) % 16
        i += 1
    }
    if sum != 12150 { return false }
    // Named constants, pages and offsets.
    const address = @intCast(usize, power(40)) + 0x1234
    if address / PAGE * PAGE + address % PAGE != address { return false }
    if address % PAGE != 0x234 || pagesOf(address) != @intCast(usize, power(28)) + 2 { return false }
    const block = @intCast(u32, power(31)) + 1023
    if block / SECTOR != 4194305 || block % SECTOR != 511 { return false }
    // The dividend of two operands, the quotient an operand in turn.
    const a = @intCast(u64, power(33))
    const b = @intCast(u64, power(5))
    if (a + b) / 32 - (a - b) / 32 != 2 || ((a | b) % 64) / 32 != 1 { return false }
    if (a + b) % 0x100000000 != 32 || (a + a + b) % 0x200000000 != 32 || (a - 1) % 0x100000000 != 0xFFFFFFFF { return false }
    return true
}

pub fn main() -> u8 {
    var n: usize = 0
    while n < 64 {
        powers[n] = one << @intCast(u6, n)
        n += 1
    }

    if !checkU8() { return 1 }
    if !checkU16() { return 2 }
    if !checkU32() { return 3 }
    if !checkU64() { return 4 }
    if !checkUsize() { return 5 }
    if !checkI8() { return 6 }
    if !checkI16() { return 7 }
    if !checkI32() { return 8 }
    if !checkI64() { return 9 }
    if !checkIsize() { return 10 }
    if !signedValues() { return 11 }
    if !forms() { return 12 }
    return 13
}
