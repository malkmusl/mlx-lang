// A division by a constant power of two and its remainder are compiled to
// shifts and masks (the x86_64 backend's emitPowerOfTwoDivision) and must
// stay what the processor's divide gives: for every integer type and
// every divisor 2^n the type has, with the dividends at the edges (0, 1,
// 2^n - 1, 2^n, 2^n + 1, the largest multiple of 2^n and its neighbours,
// the type's largest value and its top bit; for the signed types these bit
// patterns are also -1, -2, -2^n - 1, -2^n, -2^n + 1 and the lowest
// value), the quotient and the remainder with the divisor written out are
// those with the same divisor read at run time, which the processor
// divides by. A signed division rounds toward zero and its remainder has
// the dividend's sign. Then the forms such divisions are written in: a
// loop's bound, a compound assignment, a named constant, pages and
// offsets. Exits 13 when every check holds, else the number of the first
// check that failed.

// The divisors as the program finds them when it runs: 2^n shifted from a
// module-level variable, where the compiler sees no constant.
var one: u64 = 1 // (per run)
var powers: [64]u64 = undefined

fn power(n: usize) -> u64 { return powers[n] }

const EDGES: usize = 17

// Dividend `e` for the divisor 2^n of a type of `bits` bits, as the bits
// of an unsigned word (a signed type reads them as its own: all ones as
// -1, the top bit as its lowest value).
fn edge(e: usize, n: usize, bits: usize) -> u64 {
    const top = power(bits - 1)
    const largest = top + (top - 1)
    const d = power(n)
    if e == 0 { return 0 }
    if e == 1 { return 1 }
    if e == 2 { return d - 1 }
    if e == 3 { return d }
    if e == 4 { return (d + 1) & largest }
    if e == 5 { return (d +% d -% 1) & largest }
    if e == 6 { return (d *% 3) & largest }
    if e == 7 { return largest }
    if e == 8 { return largest - 1 }
    if e == 9 { return largest - d }
    if e == 10 { return largest - d + 1 }
    if e == 11 { return (largest - d +% 2) & largest }
    if e == 12 { return top }
    if e == 13 { return top - 1 }
    if e == 14 { return (top + 1) & largest }
    if e == 15 { return 0x5555555555555555 & largest }
    return 0xAAAAAAAAAAAAAAAA & largest
}

// The quotient and the remainder by 2^n with the divisor written out.
fn constantU8(x: u8, n: usize) -> (u8, u8) {
    if n == 0 { return -> (x / 1, x % 1) }
    if n == 1 { return -> (x / 2, x % 2) }
    if n == 2 { return -> (x / 4, x % 4) }
    if n == 3 { return -> (x / 8, x % 8) }
    if n == 4 { return -> (x / 16, x % 16) }
    if n == 5 { return -> (x / 32, x % 32) }
    if n == 6 { return -> (x / 64, x % 64) }
    return -> (x / 128, x % 128)
}

fn constantU16(x: u16, n: usize) -> (u16, u16) {
    if n == 0 { return -> (x / 1, x % 1) }
    if n == 1 { return -> (x / 2, x % 2) }
    if n == 2 { return -> (x / 4, x % 4) }
    if n == 3 { return -> (x / 8, x % 8) }
    if n == 4 { return -> (x / 16, x % 16) }
    if n == 5 { return -> (x / 32, x % 32) }
    if n == 6 { return -> (x / 64, x % 64) }
    if n == 7 { return -> (x / 128, x % 128) }
    if n == 8 { return -> (x / 256, x % 256) }
    if n == 9 { return -> (x / 512, x % 512) }
    if n == 10 { return -> (x / 0x400, x % 0x400) }
    if n == 11 { return -> (x / 0x800, x % 0x800) }
    if n == 12 { return -> (x / 0x1000, x % 0x1000) }
    if n == 13 { return -> (x / 0x2000, x % 0x2000) }
    if n == 14 { return -> (x / 0x4000, x % 0x4000) }
    return -> (x / 0x8000, x % 0x8000)
}

