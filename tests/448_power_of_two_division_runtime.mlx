    if n == 55 { return -> (x / 0x80000000000000, x % 0x80000000000000) }
    if n == 56 { return -> (x / 0x100000000000000, x % 0x100000000000000) }
    if n == 57 { return -> (x / 0x200000000000000, x % 0x200000000000000) }
    if n == 58 { return -> (x / 0x400000000000000, x % 0x400000000000000) }
    if n == 59 { return -> (x / 0x800000000000000, x % 0x800000000000000) }
    if n == 60 { return -> (x / 0x1000000000000000, x % 0x1000000000000000) }
    if n == 61 { return -> (x / 0x2000000000000000, x % 0x2000000000000000) }
    return -> (x / 0x4000000000000000, x % 0x4000000000000000)
}

fn constantIsize(x: isize, n: usize) -> (isize, isize) {
    if n == 0 { return -> (x / 1, x % 1) }
    if n == 1 { return -> (x / 2, x % 2) }
    if n == 2 { return -> (x / 4, x % 4) }
    if n == 3 { return -> (x / 8, x % 8) }
    if n == 4 { return -> (x / 16, x % 16) }
    if n == 5 { return -> (x / 32, x % 32) }
    if n == 6 { return -> (x / 64, x % 64) }
    if n == 7 { return -> (x / 128, x % 128) }
    if n == 8 { return -> (x / 256, x % 256) }
    if n == 9 { return -> (x / 512, x % 512) }
    if n == 10 { return -> (x / 0x400, x % 0x400) }
    if n == 11 { return -> (x / 0x800, x % 0x800) }
    if n == 12 { return -> (x / 0x1000, x % 0x1000) }
    if n == 13 { return -> (x / 0x2000, x % 0x2000) }
    if n == 14 { return -> (x / 0x4000, x % 0x4000) }
    if n == 15 { return -> (x / 0x8000, x % 0x8000) }
    if n == 16 { return -> (x / 0x10000, x % 0x10000) }
    if n == 17 { return -> (x / 0x20000, x % 0x20000) }
    if n == 18 { return -> (x / 0x40000, x % 0x40000) }
    if n == 19 { return -> (x / 0x80000, x % 0x80000) }
    if n == 20 { return -> (x / 0x100000, x % 0x100000) }
    if n == 21 { return -> (x / 0x200000, x % 0x200000) }
    if n == 22 { return -> (x / 0x400000, x % 0x400000) }
    if n == 23 { return -> (x / 0x800000, x % 0x800000) }
    if n == 24 { return -> (x / 0x1000000, x % 0x1000000) }
    if n == 25 { return -> (x / 0x2000000, x % 0x2000000) }
    if n == 26 { return -> (x / 0x4000000, x % 0x4000000) }
    if n == 27 { return -> (x / 0x8000000, x % 0x8000000) }
    if n == 28 { return -> (x / 0x10000000, x % 0x10000000) }
    if n == 29 { return -> (x / 0x20000000, x % 0x20000000) }
    if n == 30 { return -> (x / 0x40000000, x % 0x40000000) }
    if n == 31 { return -> (x / 0x80000000, x % 0x80000000) }
    if n == 32 { return -> (x / 0x100000000, x % 0x100000000) }
    if n == 33 { return -> (x / 0x200000000, x % 0x200000000) }
    if n == 34 { return -> (x / 0x400000000, x % 0x400000000) }
    if n == 35 { return -> (x / 0x800000000, x % 0x800000000) }
    if n == 36 { return -> (x / 0x1000000000, x % 0x1000000000) }
    if n == 37 { return -> (x / 0x2000000000, x % 0x2000000000) }
    if n == 38 { return -> (x / 0x4000000000, x % 0x4000000000) }
    if n == 39 { return -> (x / 0x8000000000, x % 0x8000000000) }
    if n == 40 { return -> (x / 0x10000000000, x % 0x10000000000) }
    if n == 41 { return -> (x / 0x20000000000, x % 0x20000000000) }
    if n == 42 { return -> (x / 0x40000000000, x % 0x40000000000) }
    if n == 43 { return -> (x / 0x80000000000, x % 0x80000000000) }
    if n == 44 { return -> (x / 0x100000000000, x % 0x100000000000) }
    if n == 45 { return -> (x / 0x200000000000, x % 0x200000000000) }
    if n == 46 { return -> (x / 0x400000000000, x % 0x400000000000) }
    if n == 47 { return -> (x / 0x800000000000, x % 0x800000000000) }
    if n == 48 { return -> (x / 0x1000000000000, x % 0x1000000000000) }
    if n == 49 { return -> (x / 0x2000000000000, x % 0x2000000000000) }
    if n == 50 { return -> (x / 0x4000000000000, x % 0x4000000000000) }
    if n == 51 { return -> (x / 0x8000000000000, x % 0x8000000000000) }
    if n == 52 { return -> (x / 0x10000000000000, x % 0x10000000000000) }
    if n == 53 { return -> (x / 0x20000000000000, x % 0x20000000000000) }
    if n == 54 { return -> (x / 0x40000000000000, x % 0x40000000000000) }
    if n == 55 { return -> (x / 0x80000000000000, x % 0x80000000000000) }
    if n == 56 { return -> (x / 0x100000000000000, x % 0x100000000000000) }
    if n == 57 { return -> (x / 0x200000000000000, x % 0x200000000000000) }
    if n == 58 { return -> (x / 0x400000000000000, x % 0x400000000000000) }
    if n == 59 { return -> (x / 0x800000000000000, x % 0x800000000000000) }
    if n == 60 { return -> (x / 0x1000000000000000, x % 0x1000000000000000) }
    if n == 61 { return -> (x / 0x2000000000000000, x % 0x2000000000000000) }
    return -> (x / 0x4000000000000000, x % 0x4000000000000000)
}

// Every divisor and dividend of a type: the divisor written out against
// the divisor read at run time.
fn checkU8() -> bool {
    var n: usize = 0
    while n < 8 {
        const d = @intCast(u8, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u8, edge(e, n, 8))
            const written = constantU8(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x || written.1 >= d { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkU16() -> bool {
    var n: usize = 0
    while n < 16 {
        const d = @intCast(u16, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u16, edge(e, n, 16))
            const written = constantU16(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x || written.1 >= d { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkU32() -> bool {
    var n: usize = 0
    while n < 32 {
        const d = @intCast(u32, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u32, edge(e, n, 32))
            const written = constantU32(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x || written.1 >= d { return false }
            e += 1
