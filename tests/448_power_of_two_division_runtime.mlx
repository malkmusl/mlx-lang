        n += 1
    }
    return true
}

fn checkU64() -> bool {
    var n: usize = 0
    while n < 64 {
        const d = @intCast(u64, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u64, edge(e, n, 64))
            const written = constantU64(x, n)
            if written.0 != x / d || written.1 != x % d { return false }
            if written.0 *% d +% written.1 != x || written.1 >= d { return false }
            e += 1
