// Module-level constants holding slices: a string, an array of strings
// and an array of structs with a string field, read from functions, copied
// and indexed. These once lowered to references nothing defined, and arrays
// of slices were thought miscompiled (the Android experiment still worked
// around both). Exits 13.
const NAMES = [3][]const u8{ "red", "green", "blue" }
const GREETING: []const u8 = "hello"

const Entry = struct { name: []const u8, value: u32 }
const ENTRIES = [2]Entry{ Entry.{ .name = "one", .value = 1 }, Entry.{ .name = GREETING, .value = 5 } }

fn longest() -> usize {
    var best: usize = 0
    for name in NAMES {
        if name.length > best { best = name.length }
    }
    return best
}

pub fn main() -> u8 {
    if longest() != 5 { return 1 }
    if NAMES[1][0] != 103 || NAMES[2].length != 4 { return 2 }
    if ENTRIES[1].name.length != 5 || ENTRIES[1].name[4] != 111 || ENTRIES[0].value != 1 { return 3 }
    var copy = NAMES
    copy[0] = GREETING[1..3]
    if copy[0].length != 2 || copy[0][1] != 108 || NAMES[0].length != 3 { return 4 }
    return 13
}
