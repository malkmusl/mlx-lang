// @import("builtin") is the target the compiler builds for (here the
// default, x86_64-linux): a `comptime` condition on it picks a branch and
// the other is never analyzed (it may name what this target lacks, or
// stop the build with @compileError). Exits 13.
const builtin = @import("builtin")

fn systemName() -> []const u8 {
    if comptime builtin.os == builtin.Os.brixos {
        return brix.systemName()
    } else if comptime builtin.os == builtin.Os.windows {
        @compileError("windows is not a target")
    }
    return "linux"
}

pub fn main() -> u8 {
    if builtin.os != builtin.Os.linux || builtin.arch != builtin.Arch.x86_64 { return 1 }
    if builtin.pointer_bits != 64 || builtin.endian != builtin.Endian.little { return 2 }
    if systemName().length != 5 { return 3 }
    if builtin.optimization_level > 3 { return 4 }
    return 13
}
