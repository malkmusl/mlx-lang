// std.debug_allocator (Zig's DebugAllocator): over a child it keeps each
// block with the functions that asked for it and says what goes wrong:
// a double free (and does not free again), an invalid free, a block freed
// with another length, the leaks at deinit (with how many). Freed memory
// is poisoned; a resize in place is followed. Watching the page allocator
// it sees every page block of the program the same way; a block kept on
// purpose (keep) is left out. The reports go to
// stderr, the functions named by std.crash (tests/run_debug_allocator.sh
// reads them). Exits 13 on success.
const std = @import("std")
const crash = @import("std.crash")

const debug = std.debug_allocator
const gpa = std.general_purpose_allocator

var checked: debug.DebugAllocator = undefined
var watched: debug.DebugAllocator = undefined

// The allocations live in functions of their own, so the reports name
// them.
fn leakOne(allocator: std.allocator.Allocator) -> usize {
    const block = allocator.alloc(48, 16)
    return @intFromPtr(block.?)
}

fn freeTwice(allocator: std.allocator.Allocator) -> void {
    const block = allocator.alloc(64, 16).?
    allocator.free(block, 64, 16)
    allocator.free(block, 64, 16)
}

fn freeShort(allocator: std.allocator.Allocator) -> void {
    const block = allocator.alloc(200, 16).?
    allocator.free(block, 100, 16)
}

fn leakPage() -> usize {
    const pages = std.page_allocator.init()
    const block = pages.alloc(8192, 4096)
    return @intFromPtr(block.?)
}

fn freePageTwice() -> void {
    const pages = std.page_allocator.init()
    const block = pages.alloc(4096, 4096).?
    pages.free(block, 4096, 4096)
    pages.free(block, 4096, 4096)
}

pub fn main() -> u8 {
    // Over the general-purpose heap, so freed blocks stay mapped and their
    // poison can be seen.
    var heap = gpa.init(std.page_allocator.init())
    debug.init(&checked, gpa.interface(&heap))
    checked.describe = crash.describeReturn
    const allocator = debug.interface(&checked)

    // Freed and poisoned (past the free list's link word).
    const kept = allocator.alloc(256, 16).?
    kept[100] = 7
    allocator.free(kept, 256, 16)
    if kept[100] != 170 { return 1 }

    // A resize in place is followed (100 to 120 bytes stays in the class).
    const grown = allocator.alloc(100, 16).?
    if !allocator.rawResize(grown, 100, 16, 120) { return 2 }
    allocator.free(grown, 120, 16)
    if debug.problemCount(&checked) != 0 { return 3 }

    freeTwice(allocator)
    if debug.problemCount(&checked) != 1 { return 4 }
    freeShort(allocator)
    if debug.problemCount(&checked) != 2 { return 5 }
    // An address it never handed out goes nowhere.
    var local: [16]u8 = undefined
    allocator.free(unsafe { @ptrCast([*]u8, &local) }, 16, 16)
    if debug.problemCount(&checked) != 3 { return 6 }

    const leaked = leakOne(allocator)
    if debug.liveCount(&checked) != 1 { return 7 }
    if debug.deinit(&checked) != 1 { return 8 }

    // Watching the page allocator: every page block of the program.
    debug.init(&watched, std.page_allocator.init())
    watched.describe = crash.describeReturn
    debug.watchPages(&watched)
    debug.mark(&watched)
    freePageTwice()
    if debug.problemCount(&watched) != 1 { return 9 }
    const page = leakPage()
    if debug.liveCount(&watched) != 1 { return 10 }
    // A block kept on purpose (a cache's) is left out.
    debug.keep(&watched, leakPage())
    if debug.liveCount(&watched) != 1 { return 14 }
    debug.unwatchPages()
    if debug.report(&watched) != 1 { return 11 }
    // The watch ended: what the page allocator does now is not seen.
    const later = std.page_allocator.init().alloc(4096, 4096)
    if debug.liveCount(&watched) != 1 { return 12 }
    return 13
}
